Функция ПолучитьЗначенияДопСвойств(Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|   ДополнительныеСведения.Свойство,
	|   ЕСТЬNULL(ДополнительныеСведения.Значение, """") КАК Значение
	|ИЗ
	|   РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|   ДополнительныеСведения.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Объект);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьРазмерВознаграждения(ДоговорДУ, Дата, Базис, ЗначениеПараметраДоговораДУ = Неопределено)
    
    СоотВознаграждений = Новый Соответствие;
    
    ФиксСумма = Ложь;
	
	ВалютаРегламентированногоУчета = ОбщегоНазначенияДУ.ВалютаРеглУчета(ДоговорДУ);
    КурсКратностьРегл = МодульВалютногоУчета.ПолучитьКурсВалютыПоПортфелю(ДоговорДУ, ВалютаРегламентированногоУчета, Дата);
    
    МассивПараметровДоговораДУ = Новый Массив;
    МассивПараметровДоговораДУ.Добавить(ПланыВидовХарактеристик.ПараметрыДоговораДУ.ВеличинаВознагражденияУК);
    
    Для каждого СтрокаМассива из МассивПараметровДоговораДУ Цикл
        СоотВознаграждений.Вставить(СтрокаМассива, 0);
    КонецЦикла;
    
    Для каждого СтрокаМассива из МассивПараметровДоговораДУ Цикл
        Если ЗначениеПараметраДоговораДУ = Неопределено Тогда
            Значение = УправлениеПараметрамиДоговораДУ.ПолучитьПараметрДоговораДУ(ДоговорДУ, СтрокаМассива, Дата);
        Иначе
            Значение = ЗначениеПараметраДоговораДУ;
        КонецЕсли;
        
        // может у нас от старых доков просто число пришло
        Если ТипЗнч(Значение) = Тип("Число") Тогда
            СоотВознаграждений.Вставить(СтрокаМассива,Число(Значение));
            Продолжить;
        КонецЕсли;
        
        МассивИзСтрокЛесенки = УправлениеПараметрамиДоговораДУ.РазобратьЗначениеВознаграждения(Значение);
        
        Для каждого СтрокаЛесенки из МассивИзСтрокЛесенки Цикл
            
            Добавляем = Ложь;
            Прерываем = Ложь;
            
            Если СтрокаЛесенки.ТипСравнения = "<" Тогда
                Если Базис < СтрокаЛесенки.Значение Тогда
                    Добавляем = Истина;
                    Прерываем = Истина;										
                КонецЕсли;
            ИначеЕсли СтрокаЛесенки.ТипСравнения = ">=" Тогда
                Если Базис >= СтрокаЛесенки.Значение Тогда
                    Добавляем = Истина;
                    Прерываем = Ложь;		
                КонецЕсли;
            Иначе
                Если Базис > СтрокаЛесенки.Значение Тогда
                    Добавляем = Истина;
                    Прерываем = Ложь;		
                КонецЕсли;
            КонецЕсли;
            
            Если Добавляем Тогда
                Если СтрокаЛесенки.Суммой Тогда
                    
                    Если СтрокаЛесенки.Свойство("Валюта") и СтрокаЛесенки.Валюта <> Справочники.Валюты.RUB Тогда
                        КурсКратность = МодульВалютногоУчета.ПолучитьКурсВалютыПоПортфелю(ДоговорДУ, СтрокаЛесенки.Валюта, Дата);
                        
                        СуммаВознаграждения = Окр(МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(СтрокаЛесенки.РазмерВознаграждения,
                        СтрокаЛесенки.Валюта, Справочники.Валюты.RUB, 
                        КурсКратность.Курс, КурсКратностьРегл.Курс,
                        КурсКратность.Кратность, КурсКратностьРегл.Кратность), 2);
                    Иначе
                        СуммаВознаграждения = СтрокаЛесенки.РазмерВознаграждения;
                    КонецЕсли;
                    
                    СоотВознаграждений.Вставить(СтрокаМассива, Новый Структура("РазмерВознаграждения",СуммаВознаграждения));
                    
                Иначе
                    СоотВознаграждений.Вставить(СтрокаМассива, СтрокаЛесенки.РазмерВознаграждения);
                КонецЕсли;
            КонецЕсли;
            
            Если Прерываем Тогда
                Прервать;
            КонецЕсли;
            
        КонецЦикла;
        
    КонецЦикла;
    
    Возврат СоотВознаграждений;
    
КонецФункции 

Процедура СформироватьИОтправитьПисьмо(ВидРассылки = "Перевод", ОписаниеОшибки, ПутьКФайлу = "") Экспорт
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам НДФЛ'"),
		 	УровеньЖурналаРегистрации.Информация,
			Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
			Метаданные().Имя,
			"Начато выполнение фонового задания НДФЛ Шаг 3.3");

	ТаблицаСтрок = ДанныеДляРассылки(ВидРассылки);
	Если ТаблицаСтрок.Количество() = 0 Тогда
		ОписаниеОшибки = ОписаниеОшибки + " Рассылка - " + ВидРассылки + ": не найдены данные для рассылки";
		Возврат;
	КонецЕсли;

	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность, Вложения");
	
	Макет = "ШаблонРассылки";
	ПараметрИтог = "СуммаИтого";
    КолонкаИтог  = "СуммаПоручения";
	ПериодФормат = Формат(Период,"ДФ=dd.MM.yyyy");
	
	Если ВидРассылки = "Перевод" Тогда
		ТемаПисьма = "Перевод с брокерского счета.Розничное ДУ";
	ИначеЕсли ВидРассылки = "Блокировка" Тогда
		Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
			ТемаПисьма = СтрШаблон("Коллеги, %1 произведена блокировка ДС по брокерским счетам договоров РДУ для оплаты вознаграждения НДФЛ",ПериодФормат);
		Иначе 
			ТемаПисьма = СтрШаблон("Коллеги, %1 произведена блокировка ДС по брокерским счетам договоров РДУ для оплаты вознаграждения УК");
		КонецЕсли;   
	Иначе	
		Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
			ТемаПисьма = СтрШаблон("Начисление НДФЛ Шаблон %1 от .",ПериодФормат);
		Иначе 
			ТемаПисьма = СтрШаблон("Оплата вознаграждения договоров розничного ДУ на собственный счет УК");
		КонецЕсли;   
	КонецЕсли;
	
	НомерРассылки = "0";
	
	ТелоПисьма = "";
	Вложения = Новый Структура;
	ФайлыКУдалению = Новый Массив;

	Если ТаблицаСтрок.Количество() > 0 И ВидРассылки = "Перевод" Тогда
		ТелоПисьма = СтрШаблон("Прошу подать поручение на перевод с брокерского счета 13W6XW на расчетный счет сумму в размере %1 рублей.", СуммаОбязательства);
	ИначеЕсли  ВидРассылки = "Блокировка" Тогда
		Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
			ТелоПисьма = СтрШаблон("Коллеги, %1 произведена блокировка ДС по брокерским счетам договоров РДУ для оплаты вознаграждения НДФЛ",ПериодФормат);
		Иначе 
			ТелоПисьма = СтрШаблон("Коллеги, %1 произведена блокировка ДС по брокерским счетам договоров РДУ для оплаты вознаграждения УК");
		КонецЕсли;   	
	Иначе
		
		Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
			ТелоПисьма = СтрШаблон("Прошу сформировать платежное поручение следующего образца для оплаты единого налогового платежа розничного ДУ на сумму %1 руб.", СуммаОбязательства);
		Иначе 
			ТелоПисьма = СтрШаблон("Прошу сформировать платежное поручение следующего образца для оплаты вознаграждения розничного ДУ на собственный счет УК на сумму %1 руб.", СуммаОбязательства);	 
		КонецЕсли;
		Вложения.Вставить("Отчет", ПутьКФайлу);
		ФайлыКУдалению.Добавить(ПутьКФайлу); 
	КонецЕсли;
	
	Задержка(10);

	ПараметрыПисьма.Вложения = Вложения;
	
	Кому = Новый Массив;
	ОтборКонтактов = ОтборКонтактов(ВидРассылки);
	Для каждого ТекЯщик из СписокРассылки Цикл
		Если ТекЯщик.Мидлофис И ТекЯщик.Отправлять И (ВидРассылки = "Перевод" ИЛИ ВидРассылки = "Блокировка") Тогда
			Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление)); 
		ИначеЕсли ТекЯщик.Сеттелмент И НЕ ВидРассылки = "Перевод" И ТекЯщик.Отправлять Тогда 	
			Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление)); 
		КонецЕсли;
	КонецЦикла;
	
	ФлагРезультатаВТеме = "{OK} ";
	
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ФлагРезультатаВТеме + " Аванкор ДУ: "+ ТемаПисьма + ПропискаРассылки(НомерРассылки);
	ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
	ПараметрыПисьма.Тело = ТелоПисьма;
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
	
	Задержка(10);
	
	Попытка 
		РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам НДФЛ'"),
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
		Метаданные().Имя,
		"Ошибка отправки писем");
	КонецПопытки; 
	
	Если НЕ ВидРассылки = "Перевод" Тогда
		РассылкаОтправлена = Истина;
	КонецЕсли;  
	
	Для каждого ФайлКУдалению Из ФайлыКУдалению Цикл
		УдалитьФайлы(ФайлКУдалению);
	КонецЦикла;

КонецПроцедуры

Функция ДанныеДляРассылки(ВидРассылки)

	ДанныеДляРассылки = Новый ТаблицаЗначений;
	ДанныеДляРассылки.Колонки.Добавить("ДоговорДУ");
	ДанныеДляРассылки.Колонки.Добавить("СуммаПоручения");
	ДанныеДляРассылки.Колонки.Добавить("ПоручениеПоДС");
	
	Если ВидРассылки = "Перевод" И СуммаПоручений = 0 ИЛИ СуммаОбязательства = 0 Тогда 
		Возврат ДанныеДляРассылки;
	ИначеЕсли ВидРассылки = "Блокировка" И СуммаБлокировки = 0 Тогда
		Возврат ДанныеДляРассылки;
	КонецЕсли;
	
	ПоручениеДляРассылки = ДанныеДляРассылки.Добавить();
	ПоручениеДляРассылки.ДоговорДУ = ВидДокументаОснования;
	ПоручениеДляРассылки.ПоручениеПоДС 	= СуммаПоручений;
	ПоручениеДляРассылки.СуммаПоручения = СуммаПоручений;
	
	Возврат ДанныеДляРассылки;
	
КонецФункции

Функция ОтборКонтактов(ВидРассылки)

	ВидыРассылки = Новый Соответствие;
	ВидыРассылки.Вставить("ПереводСКомпенсацией", "Мидлофис");
	ВидыРассылки.Вставить("ПереводБезКомпенсации", "Мидлофис");
	ВидыРассылки.Вставить("Перевод", "Мидлофис");
	ВидыРассылки.Вставить("ВыводСКомпенсацией", "Сеттелмент");
	ВидыРассылки.Вставить("ВыводБезКомпенсации", "Сеттелмент");
	ВидыРассылки.Вставить("Вывод", "Сеттелмент");
	ВидыРассылки.Вставить("Ввод", "Сеттелмент");
	ВидыРассылки.Вставить("МатВыгода", "Финансы");
	ВидыРассылки.Вставить("Доход", "Финансы");
	
	Ключ = ВидыРассылки.Получить(ВидРассылки);
	ОтборКонтактов = Новый Структура(Ключ, Истина);
	
	Возврат ОтборКонтактов;

КонецФункции   

Функция ТелоПисьма(Заголовок, ТаблицаСтрок, ИмяМакета, КолонкаИтог, ПараметрИтог, ПутьКФайлуXLS)

	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет(ИмяМакета);
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	
	ОбластьШапка.Параметры.Заголовок = Заголовок;
	ТабДок.Вывести(ОбластьШапка);
	
	Для каждого СтрокаТаблицы Из ТаблицаСтрок Цикл
	
		ОбластьСтрока.Параметры.Заполнить(СтрокаТаблицы);
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ОбластьИтог.Параметры[ПараметрИтог] = ТаблицаСтрок.Итог(КолонкаИтог);
	ТабДок.Вывести(ОбластьИтог);
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла(".html");
	
	ТабДок.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.HTML);
	
	ТабДок.Записать(ПутьКФайлуXLS, ТипФайлаТабличногоДокумента.XLS);
	
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу);
	СтрHTML = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	УдалитьФайлы(ПутьКФайлу);
	
	Возврат СтрHTML;

КонецФункции

Функция ПропискаРассылки(Знач НомерРассылки) 
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции     

Процедура Пауза(Секунд) Экспорт 
	
	ПолноеИмяФайла = КаталогВременныхФайлов() + "sleep.vbs";
	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку("wscript.sleep wscript.arguments(0)");
