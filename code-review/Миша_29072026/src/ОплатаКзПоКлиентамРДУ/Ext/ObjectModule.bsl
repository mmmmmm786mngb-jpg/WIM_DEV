Функция ПолучитьТекстЗапроса()
	
	ТекстЗапроса = 
	
	"ВЫБРАТЬ
	|	АналитическиеСчета.ДоговорДУ КАК ДоговорДУ,
	|	АналитическиеСчета.Ссылка КАК АналитическийСчетИсточник,
	|	0 КАК АналитическийСчетПриемник,
	|	БанковскиеСчета.Ссылка КАК БанковскийСчет,
	|	АналитическиеСчета.ДоговорКонтрагента КАК ДоговорИсточник,
	|	0 КАК ДоговорПриемник
	|ПОМЕСТИТЬ Вт_АналитическиеСчета
	|ИЗ
	|	Справочник.АналитическиеСчета КАК АналитическиеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	|		ПО АналитическиеСчета.МестоХранения = БанковскиеСчета.Ссылка
	|ГДЕ
	|	АналитическиеСчета.ДоговорДУ В(&ДоговорДУ)
	|	И БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Брокерский)
	|	И БанковскиеСчета.ТранзитныйСчет = ЛОЖЬ
	|	И (БанковскиеСчета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ БанковскиеСчета.ДатаЗакрытия <> ДАТАВРЕМЯ(1, 1, 1)
	|				И БанковскиеСчета.ДатаЗакрытия >= &НачалоПериода)
	|	И АналитическиеСчета.ОткрытНаБирже
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АналитическиеСчета.ДоговорДУ,
	|	0,
	|	АналитическиеСчета.Ссылка,
	|	БанковскиеСчета.Ссылка,
	|	0,
	|	АналитическиеСчета.ДоговорКонтрагента
	|ИЗ
	|	Справочник.АналитическиеСчета КАК АналитическиеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	|		ПО АналитическиеСчета.МестоХранения = БанковскиеСчета.Ссылка
	|ГДЕ
	|	АналитическиеСчета.ДоговорДУ В(&ДоговорДУ)
	|	И БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный)
	|	И БанковскиеСчета.ТранзитныйСчет = ЛОЖЬ
	|	И (БанковскиеСчета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ БанковскиеСчета.ДатаЗакрытия <> ДАТАВРЕМЯ(1, 1, 1)
	|				И БанковскиеСчета.ДатаЗакрытия >= &НачалоПериода)
	|	И НЕ АналитическиеСчета.ОткрытНаБирже
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт_АналитическиеСчета.ДоговорДУ КАК ДоговорДУ,
	|	МАКСИМУМ(Вт_АналитическиеСчета.АналитическийСчетИсточник) КАК АналитическийСчетИсточник,
	|	МАКСИМУМ(Вт_АналитическиеСчета.АналитическийСчетПриемник) КАК АналитическийСчетПриемник,
	|	МАКСИМУМ(Вт_АналитическиеСчета.ДоговорПриемник) КАК ДоговорПриемник,
	|	МАКСИМУМ(Вт_АналитическиеСчета.ДоговорИсточник) КАК ДоговорИсточник
	|ПОМЕСТИТЬ ВТ_АналитическиеСчетаГруппировка
	|ИЗ
	|	Вт_АналитическиеСчета КАК Вт_АналитическиеСчета
	|
	|СГРУППИРОВАТЬ ПО
	|	Вт_АналитическиеСчета.ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияСтатусовОбъектовСрезПоследних.Объект КАК Объект
	|ПОМЕСТИТЬ ВТ_НовыйВознаграждения
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовОбъектов.СрезПоследних(
	|			&КонецПериода,
	|			ЕСТЬNULL(Статус, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.Новый)
	|				И ТИПЗНАЧЕНИЯ(Объект) = ТИП(Документ.НачислениеВознаграждения)
	|				И ВЫБОР
	|					КОГДА НЕ &НачислениеНДФЛ = ИСТИНА
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|				И ВЫРАЗИТЬ(Объект КАК Документ.НачислениеВознаграждения).ДоговорДУ В (&ДоговорДУ)) КАК ИсторияСтатусовОбъектовСрезПоследних
	|ГДЕ
	|	ИсторияСтатусовОбъектовСрезПоследних.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИсторияСтатусовОбъектовСрезПоследних.Объект
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовОбъектов.СрезПоследних(
	|			&КонецПериода,
	|			ЕСТЬNULL(Статус, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.Новый)
	|				И ТИПЗНАЧЕНИЯ(Объект) = ТИП(Документ.НачислениеЗадолженности)
	|				И ВЫБОР
	|					КОГДА &НачислениеНДФЛ = ИСТИНА
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|				И Объект.НалоговыйПериод = &НалоговыйПериод
	|				И ВЫРАЗИТЬ(Объект КАК Документ.НачислениеЗадолженности).ДоговорДУ В (&ДоговорДУ)) КАК ИсторияСтатусовОбъектовСрезПоследних
	|ГДЕ
	|	ИсторияСтатусовОбъектовСрезПоследних.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтПлановаяПозиция.МестоХранения КАК МестоХранения,
	|	ВтПлановаяПозиция.РублевыйЭквивалент КАК РублевыйЭквивалент,
	|	ЕСТЬNULL(ВтПлановаяПозиция.Остаток, 0) КАК Остаток,
	|	ВтПлановаяПозиция.РублевыйЭквивалентПлан КАК РублевыйЭквивалентПлан,
	|	ВтПлановаяПозиция.ПлановаяПозицияДС КАК ПлановаяПозицияДС,
	|	ВтПлановаяПозиция.Инструмент КАК Инструмент,
	|	ВтПлановаяПозиция.ДоговорДУ КАК ДоговорДУ,
	|	ЕСТЬNULL(ВтПлановаяПозиция.СуммаРасчетныйСчет, 0) КАК СуммаРасчетныйСчет,
	|	ЕСТЬNULL(ВтПлановаяПозиция.СуммаБрокерскийСчет, 0) КАК СуммаБрокерскийСчет,
	|	ЕСТЬNULL(ВтОбязательства.СуммаОбязательства, 0) КАК СуммаОбязательства,
	|	ВтОбязательства.ВидДокументаОснования КАК ВидДокументаОснования,
	|	ВтОбязательства.Основание КАК Основание,
	|	ВтОбязательства.Контрагент КАК Контрагент,
	|	ВтОбязательства.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВтОбязательства.СтавкаНДФЛ КАК СтавкаНДФЛ,
	|	ВтОбязательства.СчетКонтрагента КАК СчетКонтрагента,
	|	ВтОбязательства.НалоговыйПериод КАК НалоговыйПериод,
	|	ВтОбязательства.ДатаОснования КАК ДатаОснования,
	|	ЕСТЬNULL(ВтПлановаяПозиция.СуммаТребования, 0) КАК СуммаТребования
	|ПОМЕСТИТЬ втСекция2
	|ИЗ
	|	(ВЫБРАТЬ
	|		ХозрасчетныйОстаткиИОбороты.ДоговорДУ КАК ДоговорДУ,
	|		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстаток * -1 КАК СуммаОбязательства,
	|		""Начисление НДФЛ"" КАК ВидДокументаОснования,
	|		ХозрасчетныйОстаткиИОбороты.Регистратор КАК Основание,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеЗадолженности).ДоговорКонтрагента КАК ДоговорКонтрагента,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеЗадолженности).Контрагент КАК Контрагент,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеЗадолженности).СтавкаНДФЛ КАК СтавкаНДФЛ,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеЗадолженности).СчетКонтрагента КАК СчетКонтрагента,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеЗадолженности).НалоговыйПериод КАК НалоговыйПериод,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеЗадолженности).Дата КАК ДатаОснования
	|	ИЗ
	|		ВТ_НовыйВознаграждения КАК ВТ_НовыйВознаграждения
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НДФЛ), , ДоговорДУ В (&ДоговорДУ)) КАК ХозрасчетныйОстаткиИОбороты
	|			ПО ВТ_НовыйВознаграждения.Объект = ХозрасчетныйОстаткиИОбороты.Регистратор
	|	ГДЕ
	|		ВЫБОР
	|				КОГДА &НачислениеНДФЛ = ИСТИНА
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|		И ТИПЗНАЧЕНИЯ(ХозрасчетныйОстаткиИОбороты.Регистратор) = ТИП(Документ.НачислениеЗадолженности)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ХозрасчетныйОстаткиИОбороты.ДоговорДУ,
	|		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстаток * -1,
	|		""Начисление Вознаграждения"",
	|		ХозрасчетныйОстаткиИОбороты.Регистратор,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеВознаграждения).ДоговорКонтрагента,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеВознаграждения).Контрагент,
	|		0,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеВознаграждения).СчетКонтрагента,
	|		0,
	|		ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Регистратор КАК Документ.НачислениеВознаграждения).Дата
	|	ИЗ
	|		ВТ_НовыйВознаграждения КАК ВТ_НовыйВознаграждения
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетВознаграждениеУКЗаУправление), , ДоговорДУ В (&ДоговорДУ)) КАК ХозрасчетныйОстаткиИОбороты
	|			ПО ВТ_НовыйВознаграждения.Объект = ХозрасчетныйОстаткиИОбороты.Регистратор
	|	ГДЕ
	|		ВЫБОР
	|				КОГДА НЕ &НачислениеНДФЛ = ИСТИНА
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|		И ТИПЗНАЧЕНИЯ(ХозрасчетныйОстаткиИОбороты.Регистратор) = ТИП(Документ.НачислениеВознаграждения)) КАК ВтОбязательства
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			т.АналитическийСчет КАК МестоХранения,
	|			0 КАК РублевыйЭквивалент,
	|			0 КАК Остаток,
	|			0 КАК РублевыйЭквивалентПлан,
	|			0 КАК ПлановаяПозицияДС,
	|			т.Валюта КАК Инструмент,
	|			т.ДоговорДУ КАК ДоговорДУ,
	|			ВЫБОР
	|				КОГДА НЕ т.АналитическийСчет.ОткрытНаБирже
	|					ТОГДА т.ВалютнаяСуммаОстаток
	|				ИНАЧЕ 0
	|			КОНЕЦ КАК СуммаРасчетныйСчет,
	|			ВЫБОР
	|				КОГДА т.АналитическийСчет.ОткрытНаБирже
	|					ТОГДА т.ВалютнаяСуммаОстаток
	|				ИНАЧЕ 0
	|			КОНЕЦ КАК СуммаБрокерскийСчет,
	|			0 КАК СуммаТребования
	|		ИЗ
	|			РегистрНакопления.ДенежныеСредстваУправленческий.Остатки(&КонецПериода, ДоговорДУ В (&ДоговорДУ)) КАК т
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(
	|						&КонецПериода,
	|						БазоваяВалюта = ЗНАЧЕНИЕ(Справочник.Валюты.RUB)
	|							И ИнформационнаяПлощадка = ЗНАЧЕНИЕ(Справочник.ИнформационныеПлощадки.ЦБРФ)) КАК Курсы
	|				ПО т.Валюта = Курсы.Валюта
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			т.АналитическийСчет,
	|			0,
	|			0,
	|			0,
	|			0,
	|			т.Валюта,
	|			т.ДоговорДУ,
	|			0,
	|			0,
	|			т.ВалютнаяСуммаОстаток
	|		ИЗ
	|			РегистрНакопления.ТребованияПоДС.Остатки(&НачДата, ДоговорДУ В (&ДоговорДУ)) КАК т
	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(
	|						&КонецПериода,
	|						БазоваяВалюта = ЗНАЧЕНИЕ(Справочник.Валюты.RUB)
	|							И ИнформационнаяПлощадка = ЗНАЧЕНИЕ(Справочник.ИнформационныеПлощадки.ЦБРФ)) КАК Курсы
	|				ПО т.Валюта = Курсы.Валюта) КАК ВтПлановаяПозиция
	|		ПО ВтОбязательства.ДоговорДУ = ВтПлановаяПозиция.ДоговорДУ
	|;
