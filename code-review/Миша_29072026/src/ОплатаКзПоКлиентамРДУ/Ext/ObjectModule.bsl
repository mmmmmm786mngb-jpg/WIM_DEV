КонецПроцедуры

Функция СформироватьШаблон() Экспорт
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам НДФЛ'"),
		 	УровеньЖурналаРегистрации.Информация,
			Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
			Метаданные().Имя,
			"Начато выполнение фонового задания НДФЛ Шаг 2.2");

	ТабДок = Новый ТабличныйДокумент;
	ПериодФормат = Формат(Период,"ДФ=dd.MM.yyyy");
	Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
		Шаблон = ПолучитьМакет("ШаблонНДФЛ");
		ТемаПисьма = СтрШаблон("Начисление НДФЛ Шаблон от %1 ",ПериодФормат);
	Иначе 
		Шаблон = ПолучитьМакет("ШаблонВУК");
		ТемаПисьма = СтрШаблон("Начисление ВУК Шаблон от %1 ",ПериодФормат);
	КонецЕсли;    
	
	ИмяФайла = КаталогВременныхФайлов() + ТемаПисьма + ".docx";
	//ИмяФайла = ПолучитьИмяВременногоФайла(".docx");
	Шаблон.Записать(ИмяФайла);	
	
	ОбъектВорд = Новый COMОбъект("Word.Application");  
	ОбъектВорд.Documents.add(ИмяФайла); 

	ДокументВорд = ОбъектВорд.Application.Documents(1);
	ДокументВорд.Activate();
	
	СуммаОбязательстваСтрокой = Строка(СуммаОбязательства);
	СуммаОбязательстваСтрокой = СтрЗаменить(СуммаОбязательстваСтрокой,",","-");

	Если СтрНайти(СуммаОбязательстваСтрокой,"-") = 0 Тогда
		СуммаОбязательстваСтрокой = СуммаОбязательстваСтрокой + "-00"; 
	Иначе 
		ДлинаСтроки 		= СтрДлина(СуммаОбязательстваСтрокой); 
		СимволРазделения 	= СтрНайти(СуммаОбязательстваСтрокой,"-");
		Если ДлинаСтроки - СимволРазделения = 1 Тогда
			СуммаОбязательстваСтрокой = СуммаОбязательстваСтрокой + "0";
		КонецЕсли;
	КонецЕсли;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПараметрСумма", ?(ВидДокументаОснования = "НачислениеЗадолженности",СуммаОбязательстваСтрокой,СуммаОбязательства));
	СтруктураПараметров.Вставить("ПараметрСуммы", УстановитьСуммуПрописью(СуммаОбязательства));
    СтруктураПараметров.Вставить("ПараметрДата", ПериодФормат);

	Для Каждого Параметр Из СтруктураПараметров Цикл  
	    ДокументВорд.Content.Find.Execute(Параметр.Ключ,,,,,,,,,Параметр.Значение,2);
	КонецЦИкла;
	
	//Вынужденные паузы чтобы не было ошибки совместного доступа
	ДокументВорд.SaveAs(ИмяФайла);  
	Задержка(10);

	ОбъектВорд.Application.Quit(); 
	
	ОписаниеОшибки = "";
	
	СформироватьИОтправитьПисьмо("ОтправкаШаблона", ОписаниеОшибки, ИмяФайла); 
	
	ИзменитьСтатусВознагражденияПриИзмененииСтатусаПлатежногоПоручения();
			
	Возврат Неопределено;      
	
КонецФункции

Функция ВыполнитьЗамену(знач Object,Параметр,Значение)
	СтрокаПоиска = "["+Параметр+"]";
	СтрокаЗамены = Строка(Значение);
	Object.Select();
	Selection = Object.Application.Selection;
	FindObject = Selection.Find;
	FindObject.ClearFormatting();
	Пока  FindObject.Execute(строкапоиска) Цикл 
		Если ПустаяСтрока(СтрокаЗамены) Тогда
			selection.Delete();
		Иначе                  
			Selection.TypeText(СтрокаЗамены);
		КонецЕсли;	
	КонецЦИкла;	               
	Selection.Collapse();
КонецФункции

Функция УстановитьСуммуПрописью(Сумма)
	
	ВыводитьСуммуБезКопеек = Ложь;
	
	Валюта = Справочники.Валюты.RUB;
	Результат     = Сумма;
	ЦелаяЧасть    = Цел(Сумма);
	ФорматСтрока  = "Л=ru_RU; ДП=Ложь";
	ПарамПредмета = Валюта.ПараметрыПрописиНаРусском;
	
	Если Результат = ЦелаяЧасть Тогда
		Если ВыводитьСуммуБезКопеек Тогда
			Результат = ЧислоПрописью(Результат, ФорматСтрока, ПарамПредмета);
			Результат = Лев(Результат, Найти(Результат, "0") - 1);
		Иначе
			Результат = ЧислоПрописью(Результат, ФорматСтрока, ПарамПредмета);
		КонецЕсли;
	Иначе
		Результат = ЧислоПрописью(Результат, ФорматСтрока, ПарамПредмета);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Процедура ИзменитьСтатусВознагражденияПриИзмененииСтатусаПлатежногоПоручения(Отказ = Ложь) Экспорт
	
	Если Отказ Тогда Возврат; КонецЕсли;
	
	МассивИзмененныхДокументов = Новый Массив;
	Для Каждого Строка Из ДокументыКВыгрузке Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.ПорученияВМидл) Тогда
			 Продолжить;
		КонецЕсли;
		
		ДокументОснование = Строка.Основание;	
		
		Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
			Возврат;
		КонецЕсли; 
		
		Если ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.КонвертацияВалюты") 
			И ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.НачислениеВознаграждения") 
			И ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.НачислениеПроцентовОтСреднейСЧА") // ASP-80600
			И ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.НачислениеЗадолженности") 
			И ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.Поручение") Тогда
			Возврат;
		КонецЕсли; 
		
		ТекущийСтатус = РегистрыСведений.ИсторияСтатусовОбъектов.ПолучитьАктуальныйСтатусОбъекта(ДокументОснование);
		
		НовыйСтатус = Перечисления.СтатусыОбъектов.СформированоПлатежноеПоручение;
		
		Если НовыйСтатус <> ТекущийСтатус Тогда
			
			Попытка
				РегистрыСведений.ИсторияСтатусовОбъектов.СохранитьТекущийСтатусОбъекта(ДокументОснование, НовыйСтатус);	
				Если ТипЗнч(МассивИзмененныхДокументов) = Тип("Массив") Тогда
					МассивИзмененныхДокументов.Добавить(ДокументОснование);
				КонецЕсли;
			Исключение
				ТекстОтказа = НСтр("ru = 'Не удалось изменить статус документа %1 по причине: %2'");
				ТекстОтказа = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОтказа, ДокументОснование, ОписаниеОшибки()); 
				Отказ = Истина;
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам'"),
					?(Отказ, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация),
					Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
					Метаданные().Имя,
					ТекстОтказа);
				ОшибкиВыполнения = Истина;	
			КонецПопытки;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

Функция НалоговыеПериоды(ТекПериод)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Периоды.Ссылка КАК Период
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	ГОД(Периоды.ДатаНачала) = ГОД(&Период)";
	
	Запрос.УстановитьПараметр("Период", ТекПериод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Период;	
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура Задержка(Секунды)
	
	КонДата = ТекущаяДатаСеанса() + Секунды;
	
	Пока ТекущаяДатаСеанса() < КонДата Цикл 
	КонецЦикла;

КонецПроцедуры

#Область ФормированиеДокументов

Процедура СформироватьБлокировкуДенежныхСредств() Экспорт
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам НДФЛ'"),
		 	УровеньЖурналаРегистрации.Информация,
			Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
			Метаданные().Имя,
			"Начато выполнение фонового задания НДФЛ Шаг 1.1");
	
	ДатаСеанса = ОбщегоНазначения.ДатаСеанса(); 
	ДатаДок = НачалоДня(НачалоДня(Период) - 1) + 60*60*9; 
	
	RUB 							= ПредопределенноеЗначение("Справочник.Валюты.RUB");
	ВидОперации 					= Перечисления.ВидыОперацийБлокировкаДС.Блокировка;

	Для каждого Строка Из ДокументыКВыгрузке Цикл
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам НДФЛ'"),
		 	УровеньЖурналаРегистрации.Информация,
			Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
			Метаданные().Имя,
			"Начато выполнение фонового задания НДФЛ Шаг 1.2");
	
		ТекстОтказа = "";
		Отказ = Ложь;
		Если ЗначениеЗаполнено(Строка.Основание) И НЕ ЗначениеЗаполнено(Строка.ДокументБлокировки) Тогда
			
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам НДФЛ'"),
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
			Метаданные().Имя,
			"Начато выполнение фонового задания НДФЛ Шаг 1.3");

			// Создание платежного поручения
			РеквизитыПП = Новый Структура();
			РеквизитыПП.Вставить("Основание",					 Строка.Основание);
			РеквизитыПП.Вставить("ДоговорДУ",  					 Строка.ДоговорДУ);
			РеквизитыПП.Вставить("АналитическийСчет",  			 Строка.АналитическийСчетИсточник);
			РеквизитыПП.Вставить("Валюта",  			 		 RUB);	
			РеквизитыПП.Вставить("ВидОперации",  			 	 ВидОперации);   
			РеквизитыПП.Вставить("ВалютнаяСумма",  			 	 Строка.СуммаБлокировки);
			РеквизитыПП.Вставить("Дата",  			 	 		 ДатаДок);

			Если  ТипЗнч(РеквизитыПП.Основание) = Тип("ДокументСсылка.НачислениеВознаграждения") Тогда
				РеквизитыПП.Вставить("ОбъектБлокировка",  Справочники.ОбъектыБлокировки.Вознаграждение); 
			ИначеЕсли ТипЗнч(РеквизитыПП.Основание) = Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
				РеквизитыПП.Вставить("ОбъектБлокировка",  Справочники.ОбъектыБлокировки.НДФЛ); 
			Иначе
				РеквизитыПП.Вставить("ОбъектБлокировка",  Справочники.ОбъектыБлокировки.ПустаяСсылка()); 
			КонецЕсли;	
			
			ДокументБлокировки = БлокировкаДенежныхСредствСоздатьЗаполнить(РеквизитыПП, Отказ, ТекстОтказа);
			           
			Если Не Отказ Тогда
				Строка.ДокументБлокировки = ДокументБлокировки;
				Строка.СуммаЗаблокированныхСредств = Строка.СуммаБлокировки;
			Иначе
				Строка.Комментарий = ТекстОтказа;
			КонецЕсли;
		Иначе
			Строка.Комментарий = Строка.Комментарий +"; Не создан документ блокировки";	
		КонецЕсли;
	
	КонецЦикла;
	
	СуммаБлокировки = ДокументыКВыгрузке.Итог("СуммаЗаблокированныхСредств");

КонецПроцедуры

Функция БлокировкаДенежныхСредствСоздатьЗаполнить(РеквизитыПП, Отказ, ТекстОтказа)
	
	Основание = РеквизитыПП.Основание;
	ОбъектБлокировкаРазблокировкаДС = Документы.БлокировкаРазблокировкаДС.ПустаяСсылка();
	
	Если Основание.Проведен = Ложь Тогда
		Отказ = Истина;
		ТекстОтказа = НСтр("ru = 'Документ основание: %1 не проведен. Поступленин на расчетный счет можно создать только на основании проведенного документа основания.'");
		ТекстОтказа = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОтказа, Основание);
	КонецЕсли;
	
	БлокировкаРазблокировкаДС = Документы.БлокировкаРазблокировкаДС.СоздатьДокумент();
	
	БлокировкаРазблокировкаДС.Основание 			= РеквизитыПП.Основание; 
	БлокировкаРазблокировкаДС.ДоговорДУ		    	= РеквизитыПП.ДоговорДУ;
	БлокировкаРазблокировкаДС.АналитическийСчет 	= РеквизитыПП.АналитическийСчет;
	БлокировкаРазблокировкаДС.Валюта 				= РеквизитыПП.Валюта;
	БлокировкаРазблокировкаДС.ВидОперации 			= РеквизитыПП.ВидОперации;
	БлокировкаРазблокировкаДС.ОбъектБлокировка 		= РеквизитыПП.ОбъектБлокировка; 
	БлокировкаРазблокировкаДС.Ответственный 		= Пользователи.ТекущийПользователь();	
	БлокировкаРазблокировкаДС.Дата 					= РеквизитыПП.Дата;
	БлокировкаРазблокировкаДС.ВалютнаяСумма 		= РеквизитыПП.ВалютнаяСумма;
	
 	Попытка
		БлокировкаРазблокировкаДС.Записать(РежимЗаписиДокумента.Проведение);
		ОбъектБлокировкаРазблокировкаДС = БлокировкаРазблокировкаДС.Ссылка;  
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам НДФЛ'"),
		 	УровеньЖурналаРегистрации.Информация,
			Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
			Метаданные().Имя,
			"Начато выполнение фонового задания НДФЛ Шаг 1.4.1");

	Исключение
		Отказ = Истина;
		ТекстОтказа =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось записать Блокировка разблокировка д/с на основание ""%2"" по причине ""%1""'"),ОписаниеОшибки(),Основание); 
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам'"),
		                         ?(Отказ, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация),
									Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
									Метаданные().Имя,
									ТекстОтказа);
		ОшибкиВыполнения = Истина;
	КонецПопытки;
	
	Возврат ОбъектБлокировкаРазблокировкаДС;

	
КонецФункции

Процедура СформироватьПлатежноеПоручение()Экспорт
	
	ДатаПП = ОбщегоНазначения.ДатаСеанса();
	RUB = ПредопределенноеЗначение("Справочник.Валюты.RUB");
	USD = ПредопределенноеЗначение("Справочник.Валюты.USD");
	EUR = ПредопределенноеЗначение("Справочник.Валюты.EUR");
	
	Для каждого Строка Из ДокументыКВыгрузке Цикл
		
		Если Не ЗначениеЗаполнено(Строка.ПорученияВМидл) Тогда  
					
			Если Строка.СуммаОбязательства = 0 ИЛИ СравниватьСБрокерскимиСуммами = "БрокерскимСчетом" 
													И (Строка.СуммаБрокерскийСчет < Строка.СуммаОбязательства ИЛИ Строка.СуммаТребования <= 0) Тогда
				Продолжить;	
			ИначеЕсли Строка.СуммаОбязательства = 0 ИЛИ СравниватьСБрокерскимиСуммами = "РасчетнымСчетом" 
													И (Строка.СуммаРасчетныйСчет < Строка.СуммаОбязательства ИЛИ Строка.СуммаТребования <> 0) Тогда 
				Продолжить;
			КонецЕсли;
			
			Отказ = Ложь;
			ТекстОтказа = "";
			
			РеквизитыПП = Новый Структура();
			РеквизитыПП.Вставить("ДокументОснование",	Строка.Основание);
			РеквизитыПП.Вставить("ВидДокумента",		Строка.ВидДокументаОснования);
			РеквизитыПП.Вставить("Статус",				ПредопределенноеЗначение("Перечисление.СтатусыОбъектов.Новый"));
			РеквизитыПП.Вставить("НеЗаполненоНазначениеПлатежа",Ложь);
			РеквизитыПП.Вставить("ДатаПлатежногоПоручения", 	НачалоДня(Период) + 60*60*9);
			РеквизитыПП.Вставить("СуммаОбязательства",  		Строка.СуммаОбязательства);
			РеквизитыПП.Вставить("ДоговорДУ",  					Строка.ДоговорДУ); 
			РеквизитыПП.Вставить("ДоговорКонтрагента",  		Строка.ДоговорПриемник);
			РеквизитыПП.Вставить("АналитическийСчетПриемник",  	Строка.АналитическийСчетПриемник);
			РеквизитыПП.Вставить("АналитическийСчетИсточник",  	Строка.АналитическийСчетИсточник);
			РеквизитыПП.Вставить("Контрагент",  				Строка.Контрагент);
			РеквизитыПП.Вставить("ЕРС",  						Строка.БанковскийСчет);
			
			Поручение = СоздатьПлатежноеПоручение(РеквизитыПП, Отказ, ТекстОтказа);
			
			Если Не Отказ Тогда
				Строка.ПорученияВМидл 			    = Поручение;
				Строка.Статус 						= РеквизитыПП.Статус;
				Строка.СуммаПоручений 				= Строка.СуммаОбязательства;
			Иначе
				Строка.Комментарий = ТекстОтказа;
			КонецЕсли; 
	 
		КонецЕсли;	
	КонецЦикла;
	
	СуммаПоручений = ДокументыКВыгрузке.Итог("СуммаПоручений");
	
КонецПроцедуры

Функция СоздатьПлатежноеПоручение(РеквизитыПП, Отказ, ТекстОтказа)
	
	Основание = РеквизитыПП.ДокументОснование;
	ПлатежноеПоручение = Документы.Поручение.ПустаяСсылка();
	
	Если Основание.Проведен = Ложь Тогда
		Отказ = Истина;
		ТекстОтказа = НСтр("ru = 'Документ основание: %1 не проведен. Платежное поручение можно создать только на основании проведенного документа основания.'");
		ТекстОтказа = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОтказа, Основание);
	КонецЕсли;
	
	ДокПоручение = Документы.Поручение.СоздатьДокумент();
	
	//Заполнение_по_документу_НАЧИСЛЕНИЕ_ЗАДОЛЖЕННОСТИ
	ЗаполнитьЗначенияСвойств(ДокПоручение, Основание);
	//
	ДокПоручение.Номер = "";
	Если ЗначениеЗаполнено(РеквизитыПП.ДатаПлатежногоПоручения) Тогда
		ДокПоручение.Дата = РеквизитыПП.ДатаПлатежногоПоручения;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ДокПоручение.Дата) Тогда
		ДокПоручение.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ДокПоручение.ВидОперации   			= Перечисления.ВидыОперацийПоручение.Перевод; 
	ДокПоручение.ДоговорДУ              = РеквизитыПП.ДоговорДУ;
	ДокПоручение.КлиентДУ               = РеквизитыПП.Контрагент;
	ДокПоручение.СчетКонтрагента        = РеквизитыПП.ЕРС;
	ДокПоручение.ДоговорКонтрагента     = РеквизитыПП.ДоговорКонтрагента;
	ДокПоручение.СуммаДС			    = РеквизитыПП.СуммаОбязательства;
	
	ДокПоручение.АналитическийСчетИсточник	= РеквизитыПП.АналитическийСчетИсточник;
	ДокПоручение.АналитическийСчетПриемник	= РеквизитыПП.АналитическийСчетПриемник;
	ДокПоручение.Комментарий				= ?(ВидДокументаОснования = "НачислениеЗадолженности", "Оплата НДФЛ", "Оплата ВУК"); 
	
	ДокПоручение.КурсВзаиморасчетов			= 1;
	ДокПоручение.КратностьВзаиморасчетов	= 1;

	Если НЕ ДокПоручение.ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		ТекстОтказа = НСтр("ru = 'Невозможно создать платежное поручение т.к не заполнены обязательные реквизиты:'");
		// Выводим сообщения о незаполненных реквизитах.
		СообщенияПользователю = ПолучитьСообщенияПользователю();
		Для каждого ТекСообщение Из СообщенияПользователю Цикл
			ТекстОтказа = ТекстОтказа + Символы.ПС + " - " + ТекСообщение.Текст;
		КонецЦикла;
		Возврат ДокПоручение.Ссылка;
	КонецЕсли;
	
	ДокПоручение.Ответственный 	= Пользователи.ТекущийПользователь();	
	
	Попытка  
		
		ДокПоручение.Записать(РежимЗаписиДокумента.Проведение);
		ПлатежноеПоручение = ДокПоручение.Ссылка;   
		
	Исключение
		
		Отказ = Истина;
		ТекстОтказа =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось записать платежное поручение на основании ""%1"" по причине ""%2""'"), Основание,ОписаниеОшибки());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Фоновое выполнение оплаты КЗ по клиентам'"),
			?(Отказ, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация),
			Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
			Метаданные().Имя,
			ТекстОтказа);
        ОшибкиВыполнения = Истина;

	КонецПопытки;
	
	Возврат ПлатежноеПоручение;
	
КонецФункции

#КонецОбласти
ОшибкиВыполнения = Ложь;

#КонецОбласти
