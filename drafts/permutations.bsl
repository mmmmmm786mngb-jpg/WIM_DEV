// Черновик: генерация и вывод всех перестановок набора элементов.
// Набор, текущая перестановка, признаки использования и результат хранятся в структурах.
// Ключ структуры задает порядок: свойства обходятся в порядке вставки.
// Алгоритм: рекурсивный перебор с возвратом.
// На каждом шаге в текущую перестановку добавляется еще не использованный элемент,
// затем выбор отменяется и перебирается следующий.
// Для N различных элементов получается N! перестановок.
// При N > 10 объем результата растет слишком быстро для интерактивного вывода.

// Описание: Выводит в окно сообщений все перестановки переданного набора
//
// Параметры:
// Элементы - Структура - исходный набор. Ключ задает позицию, значение является элементом
//
// Пример:
// Элементы = Новый Структура;
// Элементы.Вставить("Э1", 1);
// Элементы.Вставить("Э2", 2);
// Элементы.Вставить("Э3", 3);
// ВывестиПерестановки(Элементы);
//
Процедура ВывестиПерестановки(Элементы) Экспорт

    ПроверитьИсходныйНабор(Элементы);

    Перестановки = ПолучитьПерестановки(Элементы);
    Номер = 0;

    Для Каждого КлючИЗначение Из Перестановки Цикл
        Номер = Номер + 1;
        Сообщить(Формат(Номер, "ЧГ=0") + ". " + ПредставлениеПерестановки(КлючИЗначение.Значение));
    КонецЦикла;

    Сообщить("Всего перестановок: " + Формат(Перестановки.Количество(), "ЧГ=0"));

КонецПроцедуры

// Описание: Выводит все перестановки символов строки. Повтор символа дает повтор строки
//
// Параметры:
// СтрокаЭлементов - Строка - символы, из которых строятся перестановки
//
// Пример:
// ВывестиПерестановкиСтроки("АБВ");
//
Процедура ВывестиПерестановкиСтроки(СтрокаЭлементов) Экспорт

    ВывестиПерестановки(СтруктураСимволов(СтрокаЭлементов));

КонецПроцедуры

// Описание: Возвращает все перестановки элементов исходной структуры.
// Каждая перестановка является отдельной структурой со свойствами П1, П2 и далее.
// Пустой набор дает один результат: пустую перестановку (0! = 1).
//
// Параметры:
// Элементы - Структура - исходный набор значений произвольного типа
//
// Возвращаемое значение:
// Структура - свойства Р1, Р2 и далее. Значение каждого свойства имеет тип Структура
//
// Пример:
// Перестановки = ПолучитьПерестановки(Элементы); // для трех элементов вернет 6 свойств
//
Функция ПолучитьПерестановки(Элементы) Экспорт

    ПроверитьИсходныйНабор(Элементы);

    Результат = Новый Структура;
    ТекущаяПерестановка = Новый Структура;
    Использованные = СтруктураПризнаков(Элементы, Ложь);

    СобратьПерестановки(Элементы, ТекущаяПерестановка, Использованные, Результат);

    Возврат Результат;

КонецФункции

// Описание: Демонстрационный вызов для набора 1, 2, 3
//
// Пример:
// ПримерВыводаПерестановок();
//
Процедура ПримерВыводаПерестановок() Экспорт

    Элементы = Новый Структура;
    Элементы.Вставить("Э1", 1);
    Элементы.Вставить("Э2", 2);
    Элементы.Вставить("Э3", 3);

    ВывестиПерестановки(Элементы);

КонецПроцедуры

// Описание: Рекурсивно достраивает текущую перестановку и складывает готовые варианты в результат.
// Признак использования снимается после возврата из рекурсии, чтобы элемент
// можно было поставить на другую позицию.
//
// Параметры:
// Элементы - Структура - исходный набор
// ТекущаяПерестановка - Структура - уже выбранный префикс, свойства П1, П2 и далее
// Использованные - Структура - те же ключи, что у исходного набора; значение Булево
// Результат - Структура - накопитель готовых перестановок, свойства Р1, Р2 и далее
//
Процедура СобратьПерестановки(Элементы, ТекущаяПерестановка, Использованные, Результат)

    Если ТекущаяПерестановка.Количество() = Элементы.Количество() Тогда
        // ТекущаяПерестановка дальше изменяется, поэтому в результат кладется копия.
        НомерПерестановки = Результат.Количество() + 1;
        Результат.Вставить(КлючПоНомеру("Р", НомерПерестановки), СкопироватьСтруктуру(ТекущаяПерестановка));
        Возврат;
    КонецЕсли;

    Для Каждого КлючИЗначение Из Элементы Цикл

        Использовано = Ложь;
        Использованные.Свойство(КлючИЗначение.Ключ, Использовано);
        Если Использовано Тогда
            Продолжить;
        КонецЕсли;

        Использованные.Вставить(КлючИЗначение.Ключ, Истина);
        КлючПозиции = КлючПоНомеру("П", ТекущаяПерестановка.Количество() + 1);
        ТекущаяПерестановка.Вставить(КлючПозиции, КлючИЗначение.Значение);

        СобратьПерестановки(Элементы, ТекущаяПерестановка, Использованные, Результат);

        ТекущаяПерестановка.Удалить(КлючПозиции);
        Использованные.Вставить(КлючИЗначение.Ключ, Ложь);

    КонецЦикла;

КонецПроцедуры

// Описание: Проверяет, что на входе передана структура
//
// Параметры:
// Элементы - Произвольный - проверяемое значение
//
Процедура ПроверитьИсходныйНабор(Элементы)

    Если ТипЗнч(Элементы) <> Тип("Структура") Тогда
        ВызватьИсключение "Параметр Элементы должен иметь тип Структура";
    КонецЕсли;

КонецПроцедуры

// Описание: Создает структуру с теми же ключами, что у источника, и одним значением у всех свойств
//
// Параметры:
// Элементы - Структура - источник ключей
// Значение - Произвольный - значение каждого свойства
//
// Возвращаемое значение:
// Структура - копия ключей источника
//
Функция СтруктураПризнаков(Элементы, Значение)

    Признаки = Новый Структура;

    Для Каждого КлючИЗначение Из Элементы Цикл
        Признаки.Вставить(КлючИЗначение.Ключ, Значение);
    КонецЦикла;

    Возврат Признаки;

КонецФункции

// Описание: Возвращает новую структуру с теми же ключами и значениями в том же порядке
//
// Параметры:
// Источник - Структура - копируемая структура
//
// Возвращаемое значение:
// Структура - поверхностная копия источника
//
Функция СкопироватьСтруктуру(Источник)

    Копия = Новый Структура;

    Для Каждого КлючИЗначение Из Источник Цикл
        Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;

    Возврат Копия;

КонецФункции

// Описание: Разбивает строку на структуру отдельных символов
//
// Параметры:
// СтрокаЭлементов - Строка - исходная строка
//
// Возвращаемое значение:
// Структура - свойства С1, С2 и далее, значение каждого свойства является символом
//
Функция СтруктураСимволов(СтрокаЭлементов)

    Символы = Новый Структура;

    Для Позиция = 1 По СтрДлина(СтрокаЭлементов) Цикл
        Символы.Вставить(КлючПоНомеру("С", Позиция), Сред(СтрокаЭлементов, Позиция, 1));
    КонецЦикла;

    Возврат Символы;

КонецФункции

// Описание: Собирает строковое представление одной перестановки
//
// Параметры:
// Перестановка - Структура - элементы одной перестановки в порядке свойств
//
// Возвращаемое значение:
// Строка - значения свойств через запятую
//
Функция ПредставлениеПерестановки(Перестановка)

    Текст = "";
    ПервыйЭлемент = Истина;

    Для Каждого КлючИЗначение Из Перестановка Цикл

        Если Не ПервыйЭлемент Тогда
            Текст = Текст + ", ";
        КонецЕсли;

        Текст = Текст + Строка(КлючИЗначение.Значение);
        ПервыйЭлемент = Ложь;

    КонецЦикла;

    Возврат Текст;

КонецФункции

// Описание: Собирает ключ структуры из префикса и номера без разделителя групп разрядов.
// Строка(1000) может вернуть "1 000", а такой ключ структура не примет.
//
// Параметры:
// Префикс - Строка - начало имени свойства
// Номер - Число - порядковый номер, начиная с 1
//
// Возвращаемое значение:
// Строка - допустимое имя свойства, например П3 или Р12
//
Функция КлючПоНомеру(Префикс, Номер)

    Возврат Префикс + Формат(Номер, "ЧГ=0");

КонецФункции
