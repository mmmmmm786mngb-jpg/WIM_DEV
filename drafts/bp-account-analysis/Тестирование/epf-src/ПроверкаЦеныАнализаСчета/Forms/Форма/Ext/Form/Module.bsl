#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ВыполнитьПроверку();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

    ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьПроверку()

    ИмяФайла = "c:\1c\Cursor_1c\WIM_DEV\drafts\bp-account-analysis\Тестирование\enterprise_result.txt";
    Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
    Попытка
        ЗаписатьОжидаемыеЦены(Запись);
        ПроверитьСчет(Запись, "41.01", "GOODS");
        ПроверитьСчет(Запись, "51", "CASH");
        Запись.ЗаписатьСтроку("finished");
    Исключение
        Запись.ЗаписатьСтроку("fatal " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Запись.Закрыть();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьОжидаемыеЦены(Запись)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 8
    |    ПРЕДСТАВЛЕНИЕ(Остатки.Субконто1) КАК Номенклатура,
    |    Остатки.КоличествоКонечныйОстаток КАК Количество,
    |    Остатки.СуммаКонечныйОстаток КАК Сумма,
    |    ВЫБОР
    |        КОГДА Остатки.КоличествоКонечныйОстаток = 0
    |            ТОГДА 0
    |        ИНАЧЕ Остатки.СуммаКонечныйОстаток / Остатки.КоличествоКонечныйОстаток
    |    КОНЕЦ КАК Цена
    |ИЗ
    |    РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
    |        ДАТАВРЕМЯ(2020, 1, 1),
    |        ДАТАВРЕМЯ(2026, 10, 4),
    |        ,
    |        ,
    |        Счет = &Счет,
    |        ,
    |        Организация = &Организация) КАК Остатки
    |ГДЕ
    |    Остатки.КоличествоКонечныйОстаток <> 0
    |    ИЛИ Остатки.СуммаКонечныйОстаток <> 0";
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01"));
    Запрос.УстановитьПараметр("Организация", Справочники.Организации.НайтиПоНаименованию("Конфетпром ООО", Истина));
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Запись.ЗаписатьСтроку("expected " + Выборка.Номенклатура
            + " qty=" + Выборка.Количество
            + " sum=" + Выборка.Сумма
            + " price=" + Выборка.Цена);
    КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПроверитьСчет(Запись, КодСчета, Метка)

    ПараметрыОтчета = Отчеты.АнализСчета.ПустыеПараметрыКомпоновкиОтчета();
    ПараметрыОтчета.Организация = Справочники.Организации.НайтиПоНаименованию("Конфетпром ООО", Истина);
    ПараметрыОтчета.НачалоПериода = Дата(2020, 1, 1);
    ПараметрыОтчета.КонецПериода = Дата(2026, 10, 4);
    ПараметрыОтчета.Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодСчета);
    ПараметрыОтчета.ПоказательБУ = Истина;
    ПараметрыОтчета.ПоказательКоличество = Истина;
    ПараметрыОтчета.ПоказательНУ = Ложь;
    ПараметрыОтчета.ПоказательПР = Ложь;
    ПараметрыОтчета.ПоказательВР = Ложь;
    ПараметрыОтчета.ПоказательКонтроль = Ложь;
    ПараметрыОтчета.ПоказательВалютнаяСумма = Ложь;
    ПараметрыОтчета.ПоказательСверкаНУ = Ложь;
    ПараметрыОтчета.ВыводитьЗаголовок = Истина;
    ПараметрыОтчета.Вставить("ВыводитьПодвал", Ложь);

    СтрокаГруппировки = ПараметрыОтчета.Группировка.Добавить();
    СтрокаГруппировки.Использование = Истина;
    СтрокаГруппировки.Поле = "Субконто1";
    СтрокаГруппировки.Представление = "Номенклатура";
    СтрокаГруппировки.ТипГруппировки = 0;

    ИмяСхемы = БухгалтерскиеОтчеты.ИмяСхемыКомпоновкиДанныхОтчета(
        Отчеты.АнализСчета.Создать(), "АнализСчета");
    Схема = Отчеты.АнализСчета.ПолучитьМакет(ИмяСхемы);
    Отчеты.АнализСчета.НастроитьСхемуКомпоновкиДанных(Схема, ПараметрыОтчета.Счет);
    Вариант = Схема.ВариантыНастроек.Найти("АнализСчета");
    Если Вариант = Неопределено Тогда
        Настройки = Схема.НастройкиПоУмолчанию;
    Иначе
        Настройки = Вариант.Настройки;
    КонецЕсли;
    ПараметрыОтчета.Вставить("СхемаКомпоновкиДанных", Схема);
    ПараметрыОтчета.Вставить("НастройкиКомпоновкиДанных", Настройки);
    ПараметрыОтчета.Вставить("ДанныеРасшифровки", "");

    РезультатФормирования = БухгалтерскиеОтчетыВызовСервера.ПодготовитьОтчет(ПараметрыОтчета);
    Запись.ЗаписатьСтроку(Метка + " done=" + РезультатФормирования.Выполнено
        + " control=" + РезультатФормирования.КонтрольноеСоотношениеИтоговВыполняется);
    Если Не РезультатФормирования.Выполнено Тогда
        Запись.ЗаписатьСтроку(Метка + " error=" + РезультатФормирования.ПодробноеПредставлениеОшибки);
        Возврат;
    КонецЕсли;

    Документ = РезультатФормирования.Результат;
    ЦветЦены = Новый Цвет(255, 224, 130);
    ЧислоСтрокЦены = 0;
    ЧислоЦветных = 0;
    Для НомерСтроки = 1 По Документ.ВысотаТаблицы Цикл
        Тексты = Новый Массив;
        ЕстьЦена = Ложь;
        СтрокаЦветная = Ложь;
        Для НомерКолонки = 1 По Документ.ШиринаТаблицы Цикл
            Область = Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
            ТекстЯчейки = СокрЛП(Область.Текст);
            Если ЗначениеЗаполнено(ТекстЯчейки) Тогда
                Тексты.Добавить(ТекстЯчейки);
            КонецЕсли;
            Если ТекстЯчейки = "Цена" Тогда
                ЕстьЦена = Истина;
            КонецЕсли;
            Если Область.ЦветФона = ЦветЦены Тогда
                СтрокаЦветная = Истина;
            КонецЕсли;
        КонецЦикла;
        Если ЕстьЦена Тогда
            ЧислоСтрокЦены = ЧислоСтрокЦены + 1;
        КонецЕсли;
        Если СтрокаЦветная Тогда
            ЧислоЦветных = ЧислоЦветных + 1;
        КонецЕсли;
        СтрокаТекста = СтрСоединить(Тексты, " | ");
        Если ЕстьЦена Или СтрНайти(СтрокаТекста, "Кол.") > 0 Или СтрНачинаетсяС(СтрокаТекста, "БУ") Тогда
            Отметка = ?(СтрокаЦветная, " [COLOR]", "");
            Запись.ЗаписатьСтроку(Метка + " r" + Формат(НомерСтроки, "ЧГ=0") + Отметка + ": " + СтрокаТекста);
        КонецЕсли;
    КонецЦикла;
    Запись.ЗаписатьСтроку(Метка + " price_rows=" + Формат(ЧислоСтрокЦены, "ЧГ=0")
        + " colored_rows=" + Формат(ЧислоЦветных, "ЧГ=0")
        + " size=" + Формат(Документ.ВысотаТаблицы, "ЧГ=0") + "x" + Формат(Документ.ШиринаТаблицы, "ЧГ=0"));

    Если Метка = "GOODS" Тогда
        Документ.Записать("c:\1c\Cursor_1c\WIM_DEV\drafts\bp-account-analysis\Тестирование\account_analysis_41_01.mxl");
    КонецЕсли;

КонецПроцедуры

#КонецОбласти
