#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

// Описание: Включает показатель "Цена" для товарных счетов до сборки макета отчета.
// Цена считается как сумма бухгалтерского учета, деленная на количество.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета Анализ счета
//  Схема - СхемаКомпоновкиДанных - схема, по которой строится отчет
//  КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - настройки компоновки
//
&Перед("ПередКомпоновкойМакета")
Процедура ЦАС_ПередКомпоновкойМакета(ПараметрыОтчета, Схема, КомпоновщикНастроек)

    Если Не ЦАС_НужнаЦена(ПараметрыОтчета) Тогда
        Возврат;
    КонецЕсли;

    ЦАС_ДобавитьПоляЦеныВСхему(Схема);

    Если ПараметрыОтчета.НаборПоказателей.Найти("Цена") = Неопределено Тогда
        ПараметрыОтчета.НаборПоказателей.Добавить("Цена");
    КонецЕсли;
    ПараметрыОтчета.Вставить("ПоказательЦена", Истина);

КонецПроцедуры

// Описание: Добавляет в вывод числовые поля цены сразу после количества и красит строку цены.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета Анализ счета
//  Схема - СхемаКомпоновкиДанных - схема, по которой строится отчет
//  КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - настройки компоновки
//
&После("ПередКомпоновкойМакета")
Процедура ЦАС_ПослеПередКомпоновкойМакета(ПараметрыОтчета, Схема, КомпоновщикНастроек)

    ВыводитьЦену = Ложь;
    Если Не ПараметрыОтчета.Свойство("ПоказательЦена", ВыводитьЦену) Или ВыводитьЦену <> Истина Тогда
        Возврат;
    КонецЕсли;

    ЦАС_ВставитьПоляЦеныВВыбор(КомпоновщикНастроек.Настройки.Выбор);
    ЦАС_ОформитьСтрокуЦены(КомпоновщикНастроек);
    // Без детализации по корсчетам секции остаются колонками: начальное сальдо, обороты, конечное сальдо.
    // Типовой макет иначе складывает эти секции строками под каждой номенклатурой.
    Если Не ЦАС_ЕстьГруппировкаКорСчетов(ПараметрыОтчета) Тогда
        ЦАС_РазложитьСекцииПоКолонкам(КомпоновщикНастроек.Настройки.Выбор);
        ЦАС_ПоставитьГруппировкиВНачале(КомпоновщикНастроек.Настройки.Структура);
    КонецЕсли;

    // Поля цены добавлены в схему уже после первой инициализации компоновщика.
    // Повторная инициализация оставляет их в доступных полях к моменту Восстановить().
    Настройки = КомпоновщикНастроек.ПолучитьНастройки();
    КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
    КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);

КонецПроцедуры

// Описание: Определяет, нужно ли выводить цену для текущего счета.
// Цена выводится для счетов с кодом 41*, если в отчете включено количество.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета
//
// Возвращаемое значение:
//  Булево - Истина, если счет товарный и количество выводится
//
Функция ЦАС_НужнаЦена(ПараметрыОтчета)

    ПоказательКоличество = Ложь;
    Если Не ПараметрыОтчета.Свойство("ПоказательКоличество", ПоказательКоличество) Или ПоказательКоличество <> Истина Тогда
        Возврат Ложь;
    КонецЕсли;

    Счет = Неопределено;
    Если Не ПараметрыОтчета.Свойство("Счет", Счет) Или Не ЗначениеЗаполнено(Счет) Тогда
        Возврат Ложь;
    КонецЕсли;

    КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Код");
    Возврат СтрНачинаетсяС(СокрЛП(КодСчета), "41");

КонецФункции

// Описание: Добавляет в схему вычисляемые поля и ресурсы цены, если их еще нет.
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - схема отчета Анализ счета
//
Процедура ЦАС_ДобавитьПоляЦеныВСхему(Схема)

    ОписаниеПолей = ЦАС_ОписаниеПолейЦены();
    Для Каждого ОписаниеПоля Из ОписаниеПолей Цикл
        ЦАС_ДобавитьВычисляемоеПолеЦены(Схема, ОписаниеПоля);
        ЦАС_ДобавитьРесурсЦены(Схема, ОписаниеПоля);
    КонецЦикла;

КонецПроцедуры

// Описание: Возвращает описание полей цены: путь, признак подписи и пути суммы и количества.
//
// Возвращаемое значение:
//  Массив из Структура - описание полей
//
Функция ЦАС_ОписаниеПолейЦены()

    ОписаниеПолей = Новый Массив;

    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "СальдоНаНачалоПериода.ЦенаНачальныйОстатокДт",
        "СальдоНаНачалоПериода.БУНачальныйОстатокДт",
        "СальдоНаНачалоПериода.КоличествоНачальныйОстатокДт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "СальдоНаНачалоПериода.ЦенаНачальныйОстатокКт",
        "СальдоНаНачалоПериода.БУНачальныйОстатокКт",
        "СальдоНаНачалоПериода.КоличествоНачальныйОстатокКт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "ОборотыЗаПериод.ЦенаОборотДт",
        "ОборотыЗаПериод.БУОборотДт",
        "ОборотыЗаПериод.КоличествоОборотДт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "ОборотыЗаПериод.ЦенаОборотКт",
        "ОборотыЗаПериод.БУОборотКт",
        "ОборотыЗаПериод.КоличествоОборотКт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "СальдоНаКонецПериода.ЦенаКонечныйОстатокДт",
        "СальдоНаКонецПериода.БУКонечныйОстатокДт",
        "СальдоНаКонецПериода.КоличествоКонечныйОстатокДт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "СальдоНаКонецПериода.ЦенаКонечныйОстатокКт",
        "СальдоНаКонецПериода.БУКонечныйОстатокКт",
        "СальдоНаКонецПериода.КоличествоКонечныйОстатокКт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(ОписаниеПолей, "Показатели.ЦенаНачальныйОстаток", "", "", Истина);
    ЦАС_ДобавитьОписаниеПоляЦены(ОписаниеПолей, "Показатели.ЦенаОборот", "", "", Истина);
    ЦАС_ДобавитьОписаниеПоляЦены(ОписаниеПолей, "Показатели.ЦенаКонечныйОстаток", "", "", Истина);

    Возврат ОписаниеПолей;

КонецФункции

// Описание: Добавляет одно описание поля цены в массив.
//
// Параметры:
//  ОписаниеПолей - Массив из Структура - приемник описаний
//  ПутьКДанным - Строка - путь поля в схеме
//  ПутьСуммы - Строка - путь суммы бухгалтерского учета
//  ПутьКоличества - Строка - путь количества
//  ЭтоПодпись - Булево - Истина для текстовой подписи строки "Цена"
//
Процедура ЦАС_ДобавитьОписаниеПоляЦены(ОписаниеПолей, ПутьКДанным, ПутьСуммы, ПутьКоличества, ЭтоПодпись)

    ОписаниеПоля = Новый Структура;
    ОписаниеПоля.Вставить("ПутьКДанным", ПутьКДанным);
    ОписаниеПоля.Вставить("ПутьСуммы", ПутьСуммы);
    ОписаниеПоля.Вставить("ПутьКоличества", ПутьКоличества);
    ОписаниеПоля.Вставить("ЭтоПодпись", ЭтоПодпись);
    ОписаниеПолей.Добавить(ОписаниеПоля);

КонецПроцедуры

// Описание: Создает вычисляемое поле цены, если поля с таким путем еще нет.
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - схема отчета
//  ОписаниеПоля - Структура - описание поля, см. ЦАС_ОписаниеПолейЦены()
//
Процедура ЦАС_ДобавитьВычисляемоеПолеЦены(Схема, ОписаниеПоля)

    Если ЦАС_ПолеУжеЕсть(Схема.ВычисляемыеПоля, ОписаниеПоля.ПутьКДанным) Тогда
        Возврат;
    КонецЕсли;

    Поле = Схема.ВычисляемыеПоля.Добавить();
    Поле.ПутьКДанным = ОписаниеПоля.ПутьКДанным;
    Поле.Заголовок = "Цена";

    Если ОписаниеПоля.ЭтоПодпись Тогда
        Поле.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10));
        Поле.Выражение = """Цена""";
    Иначе
        Поле.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
        Поле.Выражение = ЦАС_ВыражениеЦены(ОписаниеПоля.ПутьСуммы, ОписаниеПоля.ПутьКоличества, Ложь);
    КонецЕсли;

КонецПроцедуры

// Описание: Создает ресурс цены с формулой сумма / количество по группировкам.
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - схема отчета
//  ОписаниеПоля - Структура - описание поля, см. ЦАС_ОписаниеПолейЦены()
//
Процедура ЦАС_ДобавитьРесурсЦены(Схема, ОписаниеПоля)

    Если ЦАС_ПолеУжеЕсть(Схема.ПоляИтога, ОписаниеПоля.ПутьКДанным) Тогда
        Возврат;
    КонецЕсли;

    Ресурс = Схема.ПоляИтога.Добавить();
    Ресурс.ПутьКДанным = ОписаниеПоля.ПутьКДанным;
    Если ОписаниеПоля.ЭтоПодпись Тогда
        Ресурс.Выражение = "Максимум(" + ОписаниеПоля.ПутьКДанным + ")";
    Иначе
        Ресурс.Выражение = ЦАС_ВыражениеЦены(ОписаниеПоля.ПутьСуммы, ОписаниеПоля.ПутьКоличества, Истина);
    КонецЕсли;

КонецПроцедуры

// Описание: Собирает выражение цены. Для итога сумма и количество агрегируются.
//
// Параметры:
//  ПутьСуммы - Строка - путь суммы
//  ПутьКоличества - Строка - путь количества
//  ДляИтога - Булево - Истина, если выражение ресурса
//
// Возвращаемое значение:
//  Строка - выражение компоновки данных
//
Функция ЦАС_ВыражениеЦены(ПутьСуммы, ПутьКоличества, ДляИтога)

    Если ДляИтога Тогда
        ВыражениеСуммы = "Сумма(" + ПутьСуммы + ")";
        ВыражениеКоличества = "Сумма(" + ПутьКоличества + ")";
    Иначе
        ВыражениеСуммы = ПутьСуммы;
        ВыражениеКоличества = ПутьКоличества;
    КонецЕсли;

    Возврат "ВЫБОР КОГДА ЕстьNull(" + ВыражениеКоличества + ", 0) = 0 ТОГДА 0 ИНАЧЕ ЕстьNull("
        + ВыражениеСуммы + ", 0) / " + ВыражениеКоличества + " КОНЕЦ";

КонецФункции

// Описание: Проверяет, есть ли в коллекции схемы поле с указанным путем.
//
// Параметры:
//  КоллекцияПолей - ВычисляемыеПоляСхемыКомпоновкиДанных, ПоляИтогаСхемыКомпоновкиДанных - коллекция полей
//  ПутьКДанным - Строка - искомый путь
//
// Возвращаемое значение:
//  Булево - Истина, если поле уже добавлено
//
Функция ЦАС_ПолеУжеЕсть(КоллекцияПолей, ПутьКДанным)

    Индекс = 0;
    Пока Индекс < КоллекцияПолей.Количество() Цикл
        Если КоллекцияПолей.Получить(Индекс).ПутьКДанным = ПутьКДанным Тогда
            Возврат Истина;
        КонецЕсли;
        Индекс = Индекс + 1;
    КонецЦикла;

    Возврат Ложь;

КонецФункции

// Описание: Оставляет начальное сальдо, обороты и конечное сальдо колонками, а показатели строками.
// Типовая сборка кладет все три секции в две вертикальные группы Дебет и Кредит,
// из-за этого под номенклатурой появляются строки "Начальное сальдо", "Оборот" и "Конечное сальдо".
//
// Параметры:
//  Выбор - ВыбранныеПоляКомпоновкиДанных - выбранные поля отчета
//
Процедура ЦАС_РазложитьСекцииПоКолонкам(Выбор)

    ГруппаПоказателей = Неопределено;
    ГруппаДебета = Неопределено;
    ГруппаКредита = Неопределено;

    Индекс = 0;
    Пока Индекс < Выбор.Элементы.Количество() Цикл
        Элемент = Выбор.Элементы.Получить(Индекс);
        Если ТипЗнч(Элемент) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
            ВидГруппы = ЦАС_ВидГруппыПоказателей(Элемент);
            Если ВидГруппы = "Показатели" Тогда
                ГруппаПоказателей = Элемент;
            ИначеЕсли ВидГруппы = "Дебет" Тогда
                ГруппаДебета = Элемент;
            ИначеЕсли ВидГруппы = "Кредит" Тогда
                ГруппаКредита = Элемент;
            КонецЕсли;
        КонецЕсли;
        Индекс = Индекс + 1;
    КонецЦикла;

    Если ГруппаДебета = Неопределено Или ГруппаКредита = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ПутиДебета = ЦАС_ПутиПолейГруппы(ГруппаДебета);
    ПутиКредита = ЦАС_ПутиПолейГруппы(ГруппаКредита);

    Если ГруппаПоказателей <> Неопределено Тогда
        ЦАС_ОставитьПодписиОднойСекции(ГруппаПоказателей);
    КонецЕсли;

    Выбор.Элементы.Удалить(ГруппаДебета);
    Выбор.Элементы.Удалить(ГруппаКредита);

    ЦАС_ДобавитьКолонкуСекции(Выбор, "Сальдо на начало периода", "СальдоНаНачалоПериода.", ПутиДебета, ПутиКредита);
    ЦАС_ДобавитьКолонкуСекции(Выбор, "Обороты за период", "ОборотыЗаПериод.", ПутиДебета, ПутиКредита);
    ЦАС_ДобавитьКолонкуСекции(Выбор, "Сальдо на конец периода", "СальдоНаКонецПериода.", ПутиДебета, ПутиКредита);

КонецПроцедуры

// Описание: Определяет вид вертикальной группы выбранных полей.
//
// Параметры:
//  Группа - ГруппаВыбранныхПолейКомпоновкиДанных - группа полей
//
// Возвращаемое значение:
//  Строка - Показатели, Дебет, Кредит или пустая строка
//
Функция ЦАС_ВидГруппыПоказателей(Группа)

    Индекс = 0;
    Пока Индекс < Группа.Элементы.Количество() Цикл
        Элемент = Группа.Элементы.Получить(Индекс);
        Если ТипЗнч(Элемент) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
            ИмяПоля = Строка(Элемент.Поле);
            Если СтрНачинаетсяС(ИмяПоля, "Показатели.") Тогда
                Возврат "Показатели";
            ИначеЕсли СтрЗаканчиваетсяНа(ИмяПоля, "Дт") Тогда
                Возврат "Дебет";
            ИначеЕсли СтрЗаканчиваетсяНа(ИмяПоля, "Кт") Тогда
                Возврат "Кредит";
            КонецЕсли;
        КонецЕсли;
        Индекс = Индекс + 1;
    КонецЦикла;

    Возврат "";

КонецФункции

// Описание: Собирает пути выбранных полей группы в исходном порядке.
//
// Параметры:
//  Группа - ГруппаВыбранныхПолейКомпоновкиДанных - группа полей
//
// Возвращаемое значение:
//  Массив из Строка - пути полей
//
Функция ЦАС_ПутиПолейГруппы(Группа)

    ПутиПолей = Новый Массив;
    Индекс = 0;
    Пока Индекс < Группа.Элементы.Количество() Цикл
        Элемент = Группа.Элементы.Получить(Индекс);
        Если ТипЗнч(Элемент) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
            ПутиПолей.Добавить(Строка(Элемент.Поле));
        КонецЕсли;
        Индекс = Индекс + 1;
    КонецЦикла;

    Возврат ПутиПолей;

КонецФункции

// Описание: Удаляет подписи оборота и конечного сальдо. Для колонок достаточно одного ряда подписей.
//
// Параметры:
//  Группа - ГруппаВыбранныхПолейКомпоновкиДанных - группа подписей показателей
//
Процедура ЦАС_ОставитьПодписиОднойСекции(Группа)

    Индекс = Группа.Элементы.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Элемент = Группа.Элементы.Получить(Индекс);
        Если ТипЗнч(Элемент) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
            ИмяПоля = Строка(Элемент.Поле);
            Если СтрНайти(ИмяПоля, "НачальныйОстаток") = 0 Тогда
                Группа.Элементы.Удалить(Элемент);
            КонецЕсли;
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;

КонецПроцедуры

// Описание: Добавляет колонку секции с вертикальными показателями по дебету и кредиту.
//
// Параметры:
//  Выбор - ВыбранныеПоляКомпоновкиДанных - выбранные поля отчета
//  ЗаголовокСекции - Строка - заголовок колонки
//  ПрефиксПоля - Строка - начало пути полей этой секции
//  ПутиДебета - Массив из Строка - пути полей дебета
//  ПутиКредита - Массив из Строка - пути полей кредита
//
Процедура ЦАС_ДобавитьКолонкуСекции(Выбор, ЗаголовокСекции, ПрефиксПоля, ПутиДебета, ПутиКредита)

    ГруппаСекции = Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
    ГруппаСекции.Заголовок = ЗаголовокСекции;
    ГруппаСекции.Использование = Истина;
    ГруппаСекции.Расположение = РасположениеПоляКомпоновкиДанных.Горизонтально;

    ЦАС_ДобавитьВертикальнуюГруппуПолей(ГруппаСекции, "Дебет", ПрефиксПоля, ПутиДебета);
    ЦАС_ДобавитьВертикальнуюГруппуПолей(ГруппаСекции, "Кредит", ПрефиксПоля, ПутиКредита);

КонецПроцедуры

// Описание: Добавляет вертикальную группу дебета или кредита внутри колонки секции.
//
// Параметры:
//  ГруппаСекции - ГруппаВыбранныхПолейКомпоновкиДанных - колонка секции
//  Заголовок - Строка - Дебет или Кредит
//  ПрефиксПоля - Строка - начало пути полей секции
//  ПутиПолей - Массив из Строка - пути полей одной стороны
//
Процедура ЦАС_ДобавитьВертикальнуюГруппуПолей(ГруппаСекции, Заголовок, ПрефиксПоля, ПутиПолей)

    ГруппаСтороны = ГруппаСекции.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
    ГруппаСтороны.Заголовок = Заголовок;
    ГруппаСтороны.Использование = Истина;
    ГруппаСтороны.Расположение = РасположениеПоляКомпоновкиДанных.Вертикально;

    Для Каждого ПутьПоля Из ПутиПолей Цикл
        Если Не СтрНачинаетсяС(ПутьПоля, ПрефиксПоля) Тогда
            Продолжить;
        КонецЕсли;
        Поле = ГруппаСтороны.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
        Поле.Поле = Новый ПолеКомпоновкиДанных(ПутьПоля);
        Поле.Использование = Истина;
    КонецЦикла;

КонецПроцедуры

// Описание: Проверяет, включена ли детализация по корреспондирующим счетам.
// Для такой детализации остается типовое расположение секций строками.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета
//
// Возвращаемое значение:
//  Булево - Истина, если есть используемая группировка корсчетов
//
Функция ЦАС_ЕстьГруппировкаКорСчетов(ПараметрыОтчета)

    ГруппировкаКор = Неопределено;
    Если Не ПараметрыОтчета.Свойство("ГруппировкаКор", ГруппировкаКор) Или ГруппировкаКор = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат ГруппировкаКор.НайтиСтроки(Новый Структура("Использование", Истина)).Количество() > 0;

КонецФункции

// Описание: Для колонок цены не дает типовой обработке снова разложить секции по строкам.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета
//  МакетКомпоновки - МакетКомпоновкиДанных - описание выводимых данных
//
&Вместо("ПослеКомпоновкиМакета")
Процедура ЦАС_ПослеКомпоновкиМакета(ПараметрыОтчета, МакетКомпоновки)

    Если Не ЦАС_ВыводитьЦену(ПараметрыОтчета) Или ЦАС_ЕстьГруппировкаКорСчетов(ПараметрыОтчета) Тогда
        ПродолжитьВызов(ПараметрыОтчета, МакетКомпоновки);
        Возврат;
    КонецЕсли;

    ПараметрыОтчета.Вставить("ВысотаШапки", 3);
    БухгалтерскиеОтчеты.ОтключитьИгнорированиеNull(МакетКомпоновки.НаборыДанных.ОсновнойНаборДанных.Поля);

КонецПроцедуры

// Описание: Не проверяет итоги по строкам секций, когда секции выведены колонками.
// Типовая проверка ищет начальное сальдо, оборот и конечное сальдо отдельными строками.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета
//  Результат - ТабличныйДокумент - результат отчета
//
&Вместо("ПроверитьКорректностьИтогов")
Процедура ЦАС_ПроверитьКорректностьИтогов(ПараметрыОтчета, Результат)

    Если ЦАС_ВыводитьЦену(ПараметрыОтчета) И Не ЦАС_ЕстьГруппировкаКорСчетов(ПараметрыОтчета) Тогда
        Если ПараметрыОтчета.Свойство("НастройкиКомпоновкиДанных") Тогда
            ПараметрыОтчета.НастройкиКомпоновкиДанных.ДополнительныеСвойства.Вставить(
                "КонтрольноеСоотношениеИтоговВыполняется", Истина);
        КонецЕсли;
        Возврат;
    КонецЕсли;

    ПродолжитьВызов(ПараметрыОтчета, Результат);

КонецПроцедуры

// Описание: Возвращает признак вывода строки цены.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета
//
// Возвращаемое значение:
//  Булево - Истина, если для отчета включена цена
//
// Описание: Ставит группировки в начало, чтобы колонки секций не повторялись подвалом.
//
// Параметры:
//  ЭлементыСтруктуры - КоллекцияЭлементовСтруктурыНастроекКомпоновкиДанных - уровень структуры
//
Процедура ЦАС_ПоставитьГруппировкиВНачале(ЭлементыСтруктуры)

    Индекс = 0;
    Пока Индекс < ЭлементыСтруктуры.Количество() Цикл
        Элемент = ЭлементыСтруктуры.Получить(Индекс);
        Если ТипЗнч(Элемент) = Тип("ГруппировкаКомпоновкиДанных") Тогда
            БухгалтерскиеОтчетыКлиентСервер.УстановитьПараметрВывода(
                Элемент,
                "РасположениеГруппировки",
                РасположениеГруппировкиКомпоновкиДанных.Начало);
            ЦАС_ПоставитьГруппировкиВНачале(Элемент.Структура);
        КонецЕсли;
        Индекс = Индекс + 1;
    КонецЦикла;

КонецПроцедуры

// Описание: Убирает из шапки служебные подписи полей, которые компоновка ставит над колонками.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета
//  Результат - ТабличныйДокумент - сформированный отчет
//
&После("ПослеВыводаРезультата")
Процедура ЦАС_ПослеВыводаРезультата(ПараметрыОтчета, Результат)

    Если Не ЦАС_ВыводитьЦену(ПараметрыОтчета) Или ЦАС_ЕстьГруппировкаКорСчетов(ПараметрыОтчета) Тогда
        Возврат;
    КонецЕсли;

    НомерСтроки = Результат.ВысотаТаблицы;
    Пока НомерСтроки >= 1 Цикл
        Если ЦАС_ЭтоСтрокаПодписейПолей(Результат, НомерСтроки) Тогда
            Результат.УдалитьОбласть(
                Результат.Область(НомерСтроки, , НомерСтроки),
                ТипСмещенияТабличногоДокумента.ПоВертикали);
        Иначе
            ЦАС_ОчиститьБуВШапкеКолонок(Результат, НомерСтроки);
        КонецЕсли;
        НомерСтроки = НомерСтроки - 1;
    КонецЦикла;

КонецПроцедуры

// Описание: Определяет служебную строку шапки с именами ресурсов, а не строку данных.
//
// Параметры:
//  Документ - ТабличныйДокумент - результат отчета
//  НомерСтроки - Число - проверяемая строка
//
// Возвращаемое значение:
//  Булево - Истина, если строку нужно удалить
//
Функция ЦАС_ЭтоСтрокаПодписейПолей(Документ, НомерСтроки)

    ЕстьПодписьРесурса = Ложь;
    ЕстьЧисло = Ложь;
    ЧислоПодписейЦены = 0;
    НомерКолонки = 1;
    Пока НомерКолонки <= Документ.ШиринаТаблицы Цикл
        ТекстЯчейки = СокрЛП(Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
        Если СтрНайти(ТекстЯчейки, "(нач. сальдо)") > 0
            Или СтрНайти(ТекстЯчейки, "(кон. сальдо)") > 0
            Или СтрНайти(ТекстЯчейки, "(оборот)") > 0 Тогда
            ЕстьПодписьРесурса = Истина;
        КонецЕсли;
        Если ТекстЯчейки = "Цена" Тогда
            ЧислоПодписейЦены = ЧислоПодписейЦены + 1;
        КонецЕсли;
        Если СтрНайти(ТекстЯчейки, ",") > 0
            И СтрНайти(ТекстЯчейки, "сальдо") = 0
            И СтрНайти(ТекстЯчейки, "оборот") = 0 Тогда
            ЕстьЧисло = Истина;
        КонецЕсли;
        НомерКолонки = НомерКолонки + 1;
    КонецЦикла;

    Возврат Не ЕстьЧисло И (ЕстьПодписьРесурса Или ЧислоПодписейЦены >= 3);

КонецФункции

// Описание: Убирает подпись БУ из строки шапки, где уже стоят заголовки Дебет и Кредит.
//
// Параметры:
//  Документ - ТабличныйДокумент - результат отчета
//  НомерСтроки - Число - строка шапки
//
Процедура ЦАС_ОчиститьБуВШапкеКолонок(Документ, НомерСтроки)

    ЕстьДебет = Ложь;
    НомерКолонкиБу = 0;
    НомерКолонки = 1;
    Пока НомерКолонки <= Документ.ШиринаТаблицы Цикл
        ТекстЯчейки = СокрЛП(Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
        Если ТекстЯчейки = "Дебет" Тогда
            ЕстьДебет = Истина;
        ИначеЕсли ТекстЯчейки = "БУ" И НомерКолонкиБу = 0 Тогда
            НомерКолонкиБу = НомерКолонки;
        КонецЕсли;
        НомерКолонки = НомерКолонки + 1;
    КонецЦикла;

    Если ЕстьДебет И НомерКолонкиБу > 0 Тогда
        Документ.Область(НомерСтроки, НомерКолонкиБу, НомерСтроки, НомерКолонкиБу).Текст = "";
    КонецЕсли;

КонецПроцедуры

Функция ЦАС_ВыводитьЦену(ПараметрыОтчета)

    ВыводитьЦену = Ложь;
    Возврат ПараметрыОтчета.Свойство("ПоказательЦена", ВыводитьЦену) И ВыводитьЦену = Истина;

КонецФункции

// Описание: Вставляет числовые поля цены сразу после соответствующих полей количества.
// Подписи "Цена" уже добавляет типовой цикл показателей.
//
// Параметры:
//  Выбор - ВыбранныеПоляКомпоновкиДанных, ГруппаВыбранныхПолейКомпоновкиДанных - узел выбора
//
Процедура ЦАС_ВставитьПоляЦеныВВыбор(Выбор)

    Индекс = Выбор.Элементы.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Элемент = Выбор.Элементы.Получить(Индекс);
        Если ТипЗнч(Элемент) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
            ЦАС_ВставитьПоляЦеныВВыбор(Элемент);
        ИначеЕсли ТипЗнч(Элемент) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
            ИмяПоля = Строка(Элемент.Поле);
            Если СтрНайти(ИмяПоля, "Количество") > 0 И Не СтрНачинаетсяС(ИмяПоля, "Показатели.") Тогда
                НовоеПоле = Выбор.Элементы.Вставить(Индекс + 1, Тип("ВыбранноеПолеКомпоновкиДанных"));
                НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(СтрЗаменить(ИмяПоля, "Количество", "Цена"));
                НовоеПоле.Использование = Истина;
            КонецЕсли;
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;

КонецПроцедуры

// Описание: Красит строку цены: янтарный фон и коричневый текст, числа с двумя знаками.
//
// Параметры:
//  КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - настройки компоновки
//
Процедура ЦАС_ОформитьСтрокуЦены(КомпоновщикНастроек)

    ЦветФонаЦены = Новый Цвет(255, 224, 130);
    ЦветТекстаЦены = Новый Цвет(102, 60, 0);
    ПутиПолей = ЦАС_ПутиПолейЦены();

    ОформлениеЦены = КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы.Добавить();
    ОформлениеЦены.Использование = Истина;
    ОформлениеЦены.Представление = "Строка цены товарного счета";
    Для Каждого ПутьПоля Из ПутиПолей Цикл
        ПолеОформления = ОформлениеЦены.Поля.Элементы.Добавить();
        ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ПутьПоля);
        ПолеОформления.Использование = Истина;
    КонецЦикла;
    ОформлениеЦены.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФонаЦены);
    ОформлениеЦены.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекстаЦены);

    ОформлениеФормата = КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы.Добавить();
    ОформлениеФормата.Использование = Истина;
    ОформлениеФормата.Представление = "Формат цены товарного счета";
    Для Каждого ПутьПоля Из ПутиПолей Цикл
        Если СтрНачинаетсяС(ПутьПоля, "Показатели.") Тогда
            Продолжить;
        КонецЕсли;
        ПолеОформления = ОформлениеФормата.Поля.Элементы.Добавить();
        ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ПутьПоля);
        ПолеОформления.Использование = Истина;
    КонецЦикла;
    ОформлениеФормата.Оформление.УстановитьЗначениеПараметра("Формат", "ЧДЦ=2");

КонецПроцедуры

// Описание: Возвращает пути всех полей цены, которые нужно выделить цветом.
//
// Возвращаемое значение:
//  Массив из Строка - пути полей
//
Функция ЦАС_ПутиПолейЦены()

    ПутиПолей = Новый Массив;
    Для Каждого ОписаниеПоля Из ЦАС_ОписаниеПолейЦены() Цикл
        ПутиПолей.Добавить(ОписаниеПоля.ПутьКДанным);
    КонецЦикла;
    Возврат ПутиПолей;

КонецФункции

#КонецОбласти

#КонецЕсли
