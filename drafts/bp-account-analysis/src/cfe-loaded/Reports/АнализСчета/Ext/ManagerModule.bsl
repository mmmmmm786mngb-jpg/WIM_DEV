#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

// Описание: Включает показатель "Цена" для товарных счетов до сборки макета отчета.
// Цена считается как сумма бухгалтерского учета, деленная на количество.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета Анализ счета
//  Схема - СхемаКомпоновкиДанных - схема, по которой строится отчет
//  КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - настройки компоновки
//
&Перед("ПередКомпоновкойМакета")
Процедура ЦАС_ПередКомпоновкойМакета(ПараметрыОтчета, Схема, КомпоновщикНастроек)

    ЦАС_ЗаписатьСлед("before needed=" + XMLСтрока(ЦАС_НужнаЦена(ПараметрыОтчета)));

    Если Не ЦАС_НужнаЦена(ПараметрыОтчета) Тогда
        Возврат;
    КонецЕсли;

    ЦАС_ДобавитьПоляЦеныВСхему(Схема);

    Если ПараметрыОтчета.НаборПоказателей.Найти("Цена") = Неопределено Тогда
        ПараметрыОтчета.НаборПоказателей.Добавить("Цена");
    КонецЕсли;
    ПараметрыОтчета.Вставить("ПоказательЦена", Истина);

КонецПроцедуры

// Описание: Добавляет в вывод числовые поля цены сразу после количества и красит строку цены.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета Анализ счета
//  Схема - СхемаКомпоновкиДанных - схема, по которой строится отчет
//  КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - настройки компоновки
//
&После("ПередКомпоновкойМакета")
Процедура ЦАС_ПослеПередКомпоновкойМакета(ПараметрыОтчета, Схема, КомпоновщикНастроек)

    ВыводитьЦену = Ложь;
    Если Не ПараметрыОтчета.Свойство("ПоказательЦена", ВыводитьЦену) Или ВыводитьЦену <> Истина Тогда
        Возврат;
    КонецЕсли;

    ЦАС_ВставитьПоляЦеныВВыбор(КомпоновщикНастроек.Настройки.Выбор);
    ЦАС_ОформитьСтрокуЦены(КомпоновщикНастроек);

    // Поля цены добавлены в схему уже после первой инициализации компоновщика.
    // Повторная инициализация оставляет их в доступных полях к моменту Восстановить().
    Настройки = КомпоновщикНастроек.ПолучитьНастройки();
    КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
    КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);

КонецПроцедуры

// Описание: Определяет, нужно ли выводить цену для текущего счета.
// Цена выводится для счетов с кодом 41*, если в отчете включено количество.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры компоновки отчета
//
// Возвращаемое значение:
//  Булево - Истина, если счет товарный и количество выводится
//
Функция ЦАС_НужнаЦена(ПараметрыОтчета)

    ПоказательКоличество = Ложь;
    Если Не ПараметрыОтчета.Свойство("ПоказательКоличество", ПоказательКоличество) Или ПоказательКоличество <> Истина Тогда
        Возврат Ложь;
    КонецЕсли;

    Счет = Неопределено;
    Если Не ПараметрыОтчета.Свойство("Счет", Счет) Или Не ЗначениеЗаполнено(Счет) Тогда
        Возврат Ложь;
    КонецЕсли;

    КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Код");
    Возврат СтрНачинаетсяС(СокрЛП(КодСчета), "41");

КонецФункции

// Описание: Добавляет в схему вычисляемые поля и ресурсы цены, если их еще нет.
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - схема отчета Анализ счета
//
Процедура ЦАС_ДобавитьПоляЦеныВСхему(Схема)

    ОписаниеПолей = ЦАС_ОписаниеПолейЦены();
    Для Каждого ОписаниеПоля Из ОписаниеПолей Цикл
        ЦАС_ДобавитьВычисляемоеПолеЦены(Схема, ОписаниеПоля);
        ЦАС_ДобавитьРесурсЦены(Схема, ОписаниеПоля);
    КонецЦикла;

КонецПроцедуры

// Описание: Возвращает описание полей цены: путь, признак подписи и пути суммы и количества.
//
// Возвращаемое значение:
//  Массив из Структура - описание полей
//
Функция ЦАС_ОписаниеПолейЦены()

    ОписаниеПолей = Новый Массив;

    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "СальдоНаНачалоПериода.ЦенаНачальныйОстатокДт",
        "СальдоНаНачалоПериода.БУНачальныйОстатокДт",
        "СальдоНаНачалоПериода.КоличествоНачальныйОстатокДт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "СальдоНаНачалоПериода.ЦенаНачальныйОстатокКт",
        "СальдоНаНачалоПериода.БУНачальныйОстатокКт",
        "СальдоНаНачалоПериода.КоличествоНачальныйОстатокКт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "ОборотыЗаПериод.ЦенаОборотДт",
        "ОборотыЗаПериод.БУОборотДт",
        "ОборотыЗаПериод.КоличествоОборотДт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "ОборотыЗаПериод.ЦенаОборотКт",
        "ОборотыЗаПериод.БУОборотКт",
        "ОборотыЗаПериод.КоличествоОборотКт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "СальдоНаКонецПериода.ЦенаКонечныйОстатокДт",
        "СальдоНаКонецПериода.БУКонечныйОстатокДт",
        "СальдоНаКонецПериода.КоличествоКонечныйОстатокДт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(
        ОписаниеПолей,
        "СальдоНаКонецПериода.ЦенаКонечныйОстатокКт",
        "СальдоНаКонецПериода.БУКонечныйОстатокКт",
        "СальдоНаКонецПериода.КоличествоКонечныйОстатокКт",
        Ложь);
    ЦАС_ДобавитьОписаниеПоляЦены(ОписаниеПолей, "Показатели.ЦенаНачальныйОстаток", "", "", Истина);
    ЦАС_ДобавитьОписаниеПоляЦены(ОписаниеПолей, "Показатели.ЦенаОборот", "", "", Истина);
    ЦАС_ДобавитьОписаниеПоляЦены(ОписаниеПолей, "Показатели.ЦенаКонечныйОстаток", "", "", Истина);

    Возврат ОписаниеПолей;

КонецФункции

// Описание: Добавляет одно описание поля цены в массив.
//
// Параметры:
//  ОписаниеПолей - Массив из Структура - приемник описаний
//  ПутьКДанным - Строка - путь поля в схеме
//  ПутьСуммы - Строка - путь суммы бухгалтерского учета
//  ПутьКоличества - Строка - путь количества
//  ЭтоПодпись - Булево - Истина для текстовой подписи строки "Цена"
//
Процедура ЦАС_ДобавитьОписаниеПоляЦены(ОписаниеПолей, ПутьКДанным, ПутьСуммы, ПутьКоличества, ЭтоПодпись)

    ОписаниеПоля = Новый Структура;
    ОписаниеПоля.Вставить("ПутьКДанным", ПутьКДанным);
    ОписаниеПоля.Вставить("ПутьСуммы", ПутьСуммы);
    ОписаниеПоля.Вставить("ПутьКоличества", ПутьКоличества);
    ОписаниеПоля.Вставить("ЭтоПодпись", ЭтоПодпись);
    ОписаниеПолей.Добавить(ОписаниеПоля);

КонецПроцедуры

// Описание: Создает вычисляемое поле цены, если поля с таким путем еще нет.
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - схема отчета
//  ОписаниеПоля - Структура - описание поля, см. ЦАС_ОписаниеПолейЦены()
//
Процедура ЦАС_ДобавитьВычисляемоеПолеЦены(Схема, ОписаниеПоля)

    Если ЦАС_ПолеУжеЕсть(Схема.ВычисляемыеПоля, ОписаниеПоля.ПутьКДанным) Тогда
        Возврат;
    КонецЕсли;

    Поле = Схема.ВычисляемыеПоля.Добавить();
    Поле.ПутьКДанным = ОписаниеПоля.ПутьКДанным;
    Поле.Заголовок = "Цена";

    Если ОписаниеПоля.ЭтоПодпись Тогда
        Поле.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10));
        Поле.Выражение = """Цена""";
    Иначе
        Поле.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
        Поле.Выражение = ЦАС_ВыражениеЦены(ОписаниеПоля.ПутьСуммы, ОписаниеПоля.ПутьКоличества, Ложь);
    КонецЕсли;

КонецПроцедуры

// Описание: Создает ресурс цены с формулой сумма / количество по группировкам.
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - схема отчета
//  ОписаниеПоля - Структура - описание поля, см. ЦАС_ОписаниеПолейЦены()
//
Процедура ЦАС_ДобавитьРесурсЦены(Схема, ОписаниеПоля)

    Если ЦАС_ПолеУжеЕсть(Схема.ПоляИтога, ОписаниеПоля.ПутьКДанным) Тогда
        Возврат;
    КонецЕсли;

    Ресурс = Схема.ПоляИтога.Добавить();
    Ресурс.ПутьКДанным = ОписаниеПоля.ПутьКДанным;
    Если ОписаниеПоля.ЭтоПодпись Тогда
        Ресурс.Выражение = "Максимум(" + ОписаниеПоля.ПутьКДанным + ")";
    Иначе
        Ресурс.Выражение = ЦАС_ВыражениеЦены(ОписаниеПоля.ПутьСуммы, ОписаниеПоля.ПутьКоличества, Истина);
    КонецЕсли;

КонецПроцедуры

// Описание: Собирает выражение цены. Для итога сумма и количество агрегируются.
//
// Параметры:
//  ПутьСуммы - Строка - путь суммы
//  ПутьКоличества - Строка - путь количества
//  ДляИтога - Булево - Истина, если выражение ресурса
//
// Возвращаемое значение:
//  Строка - выражение компоновки данных
//
Функция ЦАС_ВыражениеЦены(ПутьСуммы, ПутьКоличества, ДляИтога)

    Если ДляИтога Тогда
        ВыражениеСуммы = "Сумма(" + ПутьСуммы + ")";
        ВыражениеКоличества = "Сумма(" + ПутьКоличества + ")";
    Иначе
        ВыражениеСуммы = ПутьСуммы;
        ВыражениеКоличества = ПутьКоличества;
    КонецЕсли;

    Возврат "ВЫБОР КОГДА ЕстьNull(" + ВыражениеКоличества + ", 0) = 0 ТОГДА 0 ИНАЧЕ ЕстьNull("
        + ВыражениеСуммы + ", 0) / " + ВыражениеКоличества + " КОНЕЦ";

КонецФункции

// Описание: Проверяет, есть ли в коллекции схемы поле с указанным путем.
//
// Параметры:
//  КоллекцияПолей - ВычисляемыеПоляСхемыКомпоновкиДанных, ПоляИтогаСхемыКомпоновкиДанных - коллекция полей
//  ПутьКДанным - Строка - искомый путь
//
// Возвращаемое значение:
//  Булево - Истина, если поле уже добавлено
//
Функция ЦАС_ПолеУжеЕсть(КоллекцияПолей, ПутьКДанным)

    Индекс = 0;
    Пока Индекс < КоллекцияПолей.Количество() Цикл
        Если КоллекцияПолей.Получить(Индекс).ПутьКДанным = ПутьКДанным Тогда
            Возврат Истина;
        КонецЕсли;
        Индекс = Индекс + 1;
    КонецЦикла;

    Возврат Ложь;

КонецФункции

// Описание: Вставляет числовые поля цены сразу после соответствующих полей количества.
// Подписи "Цена" уже добавляет типовой цикл показателей.
//
// Параметры:
//  Выбор - ВыбранныеПоляКомпоновкиДанных, ГруппаВыбранныхПолейКомпоновкиДанных - узел выбора
//
Процедура ЦАС_ВставитьПоляЦеныВВыбор(Выбор)

    Индекс = Выбор.Элементы.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Элемент = Выбор.Элементы.Получить(Индекс);
        Если ТипЗнч(Элемент) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
            ЦАС_ВставитьПоляЦеныВВыбор(Элемент);
        ИначеЕсли ТипЗнч(Элемент) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
            ИмяПоля = Строка(Элемент.Поле);
            Если СтрНайти(ИмяПоля, "Количество") > 0 И Не СтрНачинаетсяС(ИмяПоля, "Показатели.") Тогда
                НовоеПоле = Выбор.Элементы.Вставить(Индекс + 1, Тип("ВыбранноеПолеКомпоновкиДанных"));
                НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(СтрЗаменить(ИмяПоля, "Количество", "Цена"));
                НовоеПоле.Использование = Истина;
            КонецЕсли;
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;

КонецПроцедуры

// Описание: Красит строку цены: янтарный фон и коричневый текст, числа с двумя знаками.
//
// Параметры:
//  КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - настройки компоновки
//
Процедура ЦАС_ОформитьСтрокуЦены(КомпоновщикНастроек)

    ЦветФонаЦены = Новый Цвет(255, 224, 130);
    ЦветТекстаЦены = Новый Цвет(102, 60, 0);
    ПутиПолей = ЦАС_ПутиПолейЦены();

    ОформлениеЦены = КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы.Добавить();
    ОформлениеЦены.Использование = Истина;
    ОформлениеЦены.Представление = "Строка цены товарного счета";
    Для Каждого ПутьПоля Из ПутиПолей Цикл
        ПолеОформления = ОформлениеЦены.Поля.Элементы.Добавить();
        ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ПутьПоля);
        ПолеОформления.Использование = Истина;
    КонецЦикла;
    ОформлениеЦены.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФонаЦены);
    ОформлениеЦены.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекстаЦены);

    ОформлениеФормата = КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы.Добавить();
    ОформлениеФормата.Использование = Истина;
    ОформлениеФормата.Представление = "Формат цены товарного счета";
    Для Каждого ПутьПоля Из ПутиПолей Цикл
        Если СтрНачинаетсяС(ПутьПоля, "Показатели.") Тогда
            Продолжить;
        КонецЕсли;
        ПолеОформления = ОформлениеФормата.Поля.Элементы.Добавить();
        ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ПутьПоля);
        ПолеОформления.Использование = Истина;
    КонецЦикла;
    ОформлениеФормата.Оформление.УстановитьЗначениеПараметра("Формат", "ЧДЦ=2");

КонецПроцедуры

// Описание: Возвращает пути всех полей цены, которые нужно выделить цветом.
//
// Возвращаемое значение:
//  Массив из Строка - пути полей
//
Процедура ЦАС_ЗаписатьСлед(Текст)

    Запись = Новый ЗаписьТекста(
        "c:\1c\Cursor_1c\WIM_DEV\drafts\bp-account-analysis\Тестирование\ext_trace.txt",
        КодировкаТекста.UTF8,
        ,
        Истина);
    Запись.ЗаписатьСтроку(Текст);
    Запись.Закрыть();

КонецПроцедуры

Функция ЦАС_ПутиПолейЦены()

    ПутиПолей = Новый Массив;
    Для Каждого ОписаниеПоля Из ЦАС_ОписаниеПолейЦены() Цикл
        ПутиПолей.Добавить(ОписаниеПоля.ПутьКДанным);
    КонецЦикла;
    Возврат ПутиПолей;

КонецФункции

#КонецОбласти

#КонецЕсли
