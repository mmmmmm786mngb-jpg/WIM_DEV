Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");   //ЗаполнениеОбъекта
	ПараметрыРегистрации.Вставить("Назначение", Неопределено); // МассивСтрокИмен
	ПараметрыРегистрации.Вставить("Наименование", "Проверка реестра обратного выкупа");
	ПараметрыРегистрации.Вставить("Версия", "1.00");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "Проверка реестра обратного выкупа");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд,
		"Проверка реестра обратного выкупа",
		"ОткрытьФорму",
		"ОткрытиеФормы");
		
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьСсылкуНаОбработку() Экспорт
	
	ИмяОбработки = СведенияОВнешнейОбработке().Наименование;
	ДопОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(ИмяОбработки, Истина);
	
	Возврат ДопОбработкаСсылка;
	
КонецФункции

Процедура ПрочитатьФайл(АдресФайлаНаСервере) Экспорт
	
	УникальноеИмяФайла = Новый УникальныйИдентификатор;
	ИмяФайлаНаСервере = КаталогВременныхФайлов() + УникальноеИмяФайла + ".xlsx";
	
	ФайлДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаНаСервере);
	ФайлДвоичныеДанные.Записать(ИмяФайлаНаСервере);
	
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(ИмяФайлаНаСервере, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		ВызватьИсключение "Невозможно прочитать файл на сервере: " + ОписаниеОшибки();
	КонецПопытки;
	
	Попытка
		УдалитьФайлы(ИмяФайлаНаСервере);
	Исключение
	КонецПопытки;
	
	ПрочитатьДанные(ТабДок);
	
КонецПроцедуры

Функция ВыполнитьПроверку() Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("РезультатПроверки");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрокаФайл = Макет.ПолучитьОбласть("СтрокаФайл");
	ОбластьИтогФайл = Макет.ПолучитьОбласть("ИтогФайл");
	ОбластьИтогБаза = Макет.ПолучитьОбласть("ИтогБаза");
	
	ТабДок.Вывести(ОбластьШапка);
	
	т = Новый ТаблицаЗначений;
	КвалификаторыСтроки = Новый КвалификаторыСтроки(50);
	т.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	т.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , , , КвалификаторыСтроки));
	т.Колонки.Добавить("НомерИДатаДоговораЗайма", Новый ОписаниеТипов("Строка", , , , КвалификаторыСтроки));
	
	Для каждого ТекСтрока Из ДанныеФайла Цикл
		МассивСтрок = СтрРазделить(ТекСтрока.НомерИДатаДоговораЗайма, "от");
		
		НоваяСтрока = т.Добавить();
		НоваяСтрока.Дата = ?(МассивСтрок.Количество() >= 2, МассивСтрок.Получить(1), Дата(1, 1, 1));
		НоваяСтрока.Номер = СокрЛП(?(МассивСтрок.Количество() >= 1, МассивСтрок.Получить(0), ""));
		НоваяСтрока.НомерИДатаДоговораЗайма = ТекСтрока.НомерИДатаДоговораЗайма;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("ВидАктива", ПланыВидовХарактеристик.ВидыАктивов.ДенежныеТребования);
	Запрос.УстановитьПараметр("ВидДенежногоТребования", Перечисления.ВидыДенежныхТребований.Займ);
	Запрос.УстановитьПараметр("т", т);
	Запрос.УстановитьПараметр("ДатаПроверки", КонецДня(ДатаПроверки));
	Запрос.УстановитьПараметр("Счет76_13_2", ПланыСчетов.Управленческий.РасчетыПоДенежнымТребованиямОД);
	Запрос.УстановитьПараметр("Счет76_13_3", ПланыСчетов.Управленческий.РасчетыПоДенежнымТребованиямПроценты);
	Запрос.УстановитьПараметр("ПИФ", Фонд);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ИтогоОбщаяСуммаУступкиТребованийБаза = 0;
	
	Для каждого ТекСтрока Из ДанныеФайла Цикл
		ОбластьСтрокаФайл.Параметры.Заполнить(ТекСтрока);
		ТабДок.Вывести(ОбластьСтрокаФайл);
		
		УсловияПоиска = Новый Структура;
		УсловияПоиска.Вставить("НомерИДатаДоговораЗайма", ТекСтрока.НомерИДатаДоговораЗайма);
		
		ОбластьСтрокаБаза = Макет.ПолучитьОбласть("СтрокаБаза");
		Если Выборка.НайтиСледующий(УсловияПоиска) Тогда
			
			ОбластьСтрокаБаза.Параметры.Заполнить(Выборка);
			
			Если ТекСтрока.НаименованиеЗаемщика_ИНН_ <> Выборка.НаименованиеЗаемщика_ИНН_ Тогда
				ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 2, 1, 2);
				ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
			КонецЕсли;
			
			Если ТекСтрока.СуммаЗайма_Руб_ <> Выборка.СуммаЗайма_Руб_ Тогда
				ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 3, 1, 3);
				ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
			КонецЕсли;
			
			ОбластьСтрокаБаза.Параметры.ОстатокЗадолженностиПоОсновномуДолгу_Руб_ = Выборка.СуммаЗайма_Руб_
				- Выборка.СуммаВсехПогашенийЗаемщиком - Выборка.amount_paid_before;
			Если ТекСтрока.ОстатокЗадолженностиПоОсновномуДолгу_Руб_ <> ОбластьСтрокаБаза.Параметры.ОстатокЗадолженностиПоОсновномуДолгу_Руб_ Тогда
				ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 4, 1, 4);
				ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
			КонецЕсли;
			
			ОбластьСтрокаБаза.Параметры.ОстатокЗадолженностиПоПроцентам_Руб_ = Выборка.ОстатокЗадолженностиПоПроцентам_Руб_;
			Если ТекСтрока.ОстатокЗадолженностиПоПроцентам_Руб_ <> Выборка.ОстатокЗадолженностиПоПроцентам_Руб_ Тогда
				ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 5, 1, 5);
				ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
			КонецЕсли;
			
			Если ТекСтрока.ПросроченнаяЗадолженностьПоОсновномуДолгу_Руб_ <> Выборка.ПросроченнаяЗадолженностьПоОсновномуДолгу_Руб_ Тогда
				ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 6, 1, 6);
				ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
			КонецЕсли;
			
			Если ТекСтрока.ПросроченнаяЗадолженностьПоПроцентам_Руб_ <> Выборка.ПросроченнаяЗадолженностьПоПроцентам_Руб_ Тогда
				ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 7, 1, 7);
				ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
			КонецЕсли;
			
			ОбластьСтрокаБаза.Параметры.КоличествоДнейПросрочки_ = Выборка.КоличествоДнейПросрочки_;
			Если ТекСтрока.КоличествоДнейПросрочки_ <> Выборка.КоличествоДнейПросрочки_ Тогда
				ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 8, 1, 8);
				ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
			КонецЕсли;
			
			ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 9, 1, 9);
			ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
			
			ОбластьСтрокаБаза.Параметры.ЦенаУступки_Руб_ = ОбластьСтрокаБаза.Параметры.ОстатокЗадолженностиПоОсновномуДолгу_Руб_
				+ Выборка.ОстатокЗадолженностиПоПроцентам_Руб_;
			Если ТекСтрока.ЦенаУступки_Руб_ <> ОбластьСтрокаБаза.Параметры.ЦенаУступки_Руб_ Тогда
				ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 10, 1, 10);
				ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
			КонецЕсли;
			ИтогоОбщаяСуммаУступкиТребованийБаза = ИтогоОбщаяСуммаУступкиТребованийБаза + ОбластьСтрокаБаза.Параметры.ЦенаУступки_Руб_;
		Иначе
			ОбластьСтроки = ОбластьСтрокаБаза.Область(1, 1, 1, 10);
			ОбластьСтроки.ЦветФона = WebЦвета.Лосось;
		КонецЕсли;
		ТабДок.Вывести(ОбластьСтрокаБаза);
		
		Выборка.Сбросить();
	КонецЦикла;
	
	ОбластьИтогФайл.Параметры.ЦенаУступки_Руб_ = ИтогоОбщаяСуммаУступкиТребований;
	ТабДок.Вывести(ОбластьИтогФайл);
	
	ОбластьИтогБаза.Параметры.ЦенаУступки_Руб_ = ИтогоОбщаяСуммаУступкиТребованийБаза;
	Если ИтогоОбщаяСуммаУступкиТребований <> ИтогоОбщаяСуммаУступкиТребованийБаза Тогда
		ОбластьИтог = ОбластьИтогБаза.Область(1, 10, 1, 10);
		ОбластьИтог.ЦветФона = WebЦвета.Лосось;
	КонецЕсли;
	ТабДок.Вывести(ОбластьИтогБаза);
	
	Возврат ТабДок;
	
КонецФункции

