Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

Функция НайтиДопСвойство(НазначениеСвойства, Наименование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СвойстваОбъектов.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектов
		|ГДЕ
		|	СвойстваОбъектов.НазначениеСвойства = &НазначениеСвойства
		|	И СвойстваОбъектов.Наименование = &Наименование
		|	И НЕ СвойстваОбъектов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("НазначениеСвойства", НазначениеСвойства);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Сообщить("Ошибка! Обратитесь к администратору. Не найдено свойство: " + Наименование);
	Возврат Неопределено;
	
КонецФункции

Процедура ПрочитатьДанные(ТабДок)
	
	ДанныеФайла.Очистить();
	
	ОбластьШапкаТаблицы = ТабДок.НайтиТекст("Номер и дата договора займа",,, Ложь);
	
	Если ОбластьШапкаТаблицы = Неопределено Тогда
		Сообщить("Не найдена таблица данных в файле");
		Возврат;
	КонецЕсли;
	
	Поз = Найти(ОбластьШапкаТаблицы.Имя, "C");
	НомерСтрокиШапкиТаблицы = Число(Сред(ОбластьШапкаТаблицы.Имя, 2, Поз - 2));
	
	ОбластьЯчеек = ТабДок.Область(НомерСтрокиШапкиТаблицы, 1, ТабДок.ВысотаТаблицы, ТабДок.ШиринаТаблицы);
	ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьЯчеек);
	ПостроительОтчета = Новый ПостроительОтчета;
	ПостроительОтчета.ИсточникДанных = ИсточникДанных;
	ПостроительОтчета.Выполнить();
	ТЗ = ПостроительОтчета.Результат.Выгрузить();
	
	Для Каждого текСтрока Из ТЗ Цикл
		Если текСтрока.НомерИДатаДоговораЗайма = "Итого общая сумма  уступки требований" Тогда
			ИтогоОбщаяСуммаУступкиТребований = текСтрока.ЦенаУступки_Руб_;
			
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = ДанныеФайла.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, текСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса()
	
	Возврат
	"ВЫБРАТЬ
	|	т.Дата КАК Дата,
	|	т.Номер КАК Номер,
	|	т.НомерИДатаДоговораЗайма КАК НомерИДатаДоговораЗайма
	|ПОМЕСТИТЬ т
	|ИЗ
	|	&т КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.НомерИДатаДоговораЗайма КАК НомерИДатаДоговораЗайма,
	|	ДенежныеТребования.Заемщик КАК Заемщик,
	|	ДенежныеТребования.Ссылка КАК ДенежноеТребование,
	|	ДенежныеТребования.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДенежныеТребования.Заемщик.Наименование КАК НаименованиеЗаемщика_ИНН_,
	|	ДенежныеТребования.ДатаВыдачиКредита КАК ДатаВыдачиКредита,
	|	ДенежныеТребования.ДатаОкончанияДоговора КАК ДатаОкончанияДоговора,
	|	ДенежныеТребования.Процент КАК Процент
	|ПОМЕСТИТЬ тДенежныеТребования
	|ИЗ
	|	т КАК т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДенежныеТребования КАК ДенежныеТребования
	|		ПО т.Дата = ДенежныеТребования.ДатаВыдачиЗакладной
	|			И т.Номер = ДенежныеТребования.НомерКредитногоДоговора
	|			И (ДенежныеТребования.ВидАктива = &ВидАктива)
	|			И (ДенежныеТребования.ВидДенежногоТребования = &ВидДенежногоТребования)
	|			И (НЕ ДенежныеТребования.ПометкаУдаления)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УстановкаГрафикаПлатежейТаблицаПлатежей.Ссылка.Закладная КАК Закладная,
	|	МАКСИМУМ(УстановкаГрафикаПлатежейТаблицаПлатежей.ДатаПлатежа) КАК ДатаПлатежа
	|ПОМЕСТИТЬ тДатыПоследнегоПлатежа
	|ИЗ
	|	Документ.УстановкаГрафикаПлатежей.ТаблицаПлатежей КАК УстановкаГрафикаПлатежейТаблицаПлатежей
	|ГДЕ
	|	УстановкаГрафикаПлатежейТаблицаПлатежей.Ссылка.Проведен
	|	И НЕ УстановкаГрафикаПлатежейТаблицаПлатежей.Ссылка.ПометкаУдаления
	|	И УстановкаГрафикаПлатежейТаблицаПлатежей.Ссылка.Закладная В
	|			(ВЫБРАТЬ
	|				тДенежныеТребования.ДенежноеТребование КАК ДенежноеТребование
	|			ИЗ
	|				тДенежныеТребования КАК тДенежныеТребования)
	|
	|СГРУППИРОВАТЬ ПО
	|	УстановкаГрафикаПлатежейТаблицаПлатежей.Ссылка.Закладная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
