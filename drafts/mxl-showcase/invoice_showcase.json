{
  "columns": 10,
  "page": "A4-portrait",
  "columnWidths": {
    "1": "1.2x",
    "2": "2.5x",
    "3": "1.8x",
    "4": "1.5x",
    "5": "1.2x",
    "6": "1.5x",
    "7": "1.5x",
    "8": "1.8x",
    "9": "1.5x",
    "10": "1.5x"
  },
  "fonts": {
    "title": { "face": "Arial", "size": 16, "bold": true },
    "h2": { "face": "Arial", "size": 11, "bold": true },
    "normal": { "face": "Arial", "size": 9 },
    "small": { "face": "Arial", "size": 8 },
    "bold": { "face": "Arial", "size": 9, "bold": true },
    "total": { "face": "Arial", "size": 10, "bold": true },
    "footer": { "face": "Arial", "size": 7, "italic": true }
  },
  "styles": {
    "brand": {
      "font": "title",
      "horizontalAlignment": "Left",
      "verticalAlignment": "Center",
      "textColor": "#1A365D",
      "backColor": "#E8F1FB"
    },
    "brandSub": {
      "font": "small",
      "horizontalAlignment": "Left",
      "verticalAlignment": "Center",
      "textColor": "#4A5568",
      "backColor": "#E8F1FB"
    },
    "docTitle": {
      "font": "h2",
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "textColor": "#1A365D"
    },
    "label": {
      "font": "small",
      "horizontalAlignment": "Left",
      "verticalAlignment": "Center",
      "textColor": "#718096"
    },
    "value": {
      "font": "normal",
      "horizontalAlignment": "Left",
      "verticalAlignment": "Center",
      "bottomBorder": { "style": "Dotted", "width": 1 },
      "borderColor": "#A0AEC0"
    },
    "box": {
      "font": "normal",
      "border": "Solid",
      "borderColor": "#2B6CB0",
      "verticalAlignment": "Top",
      "textPlacement": "Wrap"
    },
    "boxHead": {
      "font": "bold",
      "backColor": "#2B6CB0",
      "textColor": "#FFFFFF",
      "horizontalAlignment": "Center",
      "border": "Solid",
      "borderColor": "#2B6CB0"
    },
    "th": {
      "font": "bold",
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "backColor": "#2B6CB0",
      "textColor": "#FFFFFF",
      "border": "Solid",
      "borderColor": "#1A365D",
      "textPlacement": "Wrap"
    },
    "td": {
      "font": "normal",
      "border": "Solid",
      "borderColor": "#CBD5E0",
      "verticalAlignment": "Center",
      "textPlacement": "Wrap"
    },
    "tdNum": {
      "font": "normal",
      "border": "Solid",
      "borderColor": "#CBD5E0",
      "horizontalAlignment": "Right",
      "verticalAlignment": "Center",
      "format": "ЧЦ=15; ЧДЦ=2"
    },
    "tdCenter": {
      "font": "normal",
      "border": "Solid",
      "borderColor": "#CBD5E0",
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center"
    },
    "alt": {
      "font": "normal",
      "border": "Solid",
      "borderColor": "#CBD5E0",
      "backColor": "#F7FAFC",
      "verticalAlignment": "Center",
      "textPlacement": "Wrap"
    },
    "altNum": {
      "font": "normal",
      "border": "Solid",
      "borderColor": "#CBD5E0",
      "backColor": "#F7FAFC",
      "horizontalAlignment": "Right",
      "verticalAlignment": "Center",
      "format": "ЧЦ=15; ЧДЦ=2"
    },
    "sumLabel": {
      "font": "bold",
      "horizontalAlignment": "Right",
      "verticalAlignment": "Center",
      "textColor": "#2D3748"
    },
    "sumValue": {
      "font": "total",
      "horizontalAlignment": "Right",
      "verticalAlignment": "Center",
      "border": "Solid",
      "borderColor": "#2B6CB0",
      "backColor": "#EBF8FF",
      "format": "ЧЦ=15; ЧДЦ=2"
    },
    "grand": {
      "font": "total",
      "horizontalAlignment": "Right",
      "verticalAlignment": "Center",
      "border": { "style": "Solid", "width": 2 },
      "borderColor": "#1A365D",
      "backColor": "#BEE3F8",
      "format": "ЧЦ=15; ЧДЦ=2"
    },
    "sign": {
      "font": "small",
      "horizontalAlignment": "Center",
      "topBorder": "Solid",
      "borderColor": "#718096"
    },
    "note": {
      "font": "small",
      "textColor": "#718096",
      "textPlacement": "Wrap"
    },
    "badge": {
      "font": "bold",
      "horizontalAlignment": "Center",
      "verticalAlignment": "Center",
      "backColor": "#38A169",
      "textColor": "#FFFFFF",
      "border": "Solid",
      "borderColor": "#276749"
    }
  },
  "drawings": [
    {
      "type": "Rectangle",
      "name": "BrandBar",
      "style": "brand",
      "line": { "style": "Solid", "width": 1 },
      "begin": { "row": 1, "col": 1 },
      "end": { "row": 3, "col": 10 }
    },
    {
      "type": "Text",
      "name": "BrandMark",
      "text": { "ru": "WIM", "en": "WIM" },
      "style": "brand",
      "begin": { "row": 1, "col": 1, "dx": 8, "dy": 4 },
      "end": { "row": 2, "col": 2, "dx": 40, "dy": 8 }
    }
  ],
  "areas": [
    {
      "name": "ШапкаБренд",
      "rows": [
        {
          "height": 18,
          "cells": [
            { "col": 1, "span": 7, "style": "brand", "text": "WIM DEV · Showcase Print Form" },
            { "col": 8, "span": 3, "style": "badge", "param": "СтатусДокумента" }
          ]
        },
        {
          "height": 14,
          "cells": [
            { "col": 1, "span": 10, "style": "brandSub", "template": "ИНН [ИНН]  ·  КПП [КПП]  ·  [АдресОрганизации]" }
          ]
        },
        { "empty": 1 }
      ]
    },
    {
      "name": "Заголовок",
      "rows": [
        {
          "height": 22,
          "cells": [
            { "col": 1, "span": 10, "style": "docTitle", "template": "СЧЁТ-ОФЕРТА № [НомерДокумента] от [ДатаДокумента]" }
          ]
        },
        { "empty": 1 }
      ]
    },
    {
      "name": "Реквизиты",
      "rows": [
        {
          "height": 14,
          "cells": [
            { "col": 1, "span": 2, "style": "label", "text": "Поставщик" },
            { "col": 3, "span": 3, "style": "value", "param": "Поставщик" },
            { "col": 6, "span": 2, "style": "label", "text": "Покупатель" },
            { "col": 8, "span": 3, "style": "value", "param": "Покупатель" }
          ]
        },
        {
          "height": 14,
          "cells": [
            { "col": 1, "span": 2, "style": "label", "text": "Договор" },
            { "col": 3, "span": 3, "style": "value", "param": "Договор" },
            { "col": 6, "span": 2, "style": "label", "text": "Срок оплаты" },
            { "col": 8, "span": 3, "style": "value", "param": "СрокОплаты" }
          ]
        },
        {
          "height": 14,
          "cells": [
            { "col": 1, "span": 2, "style": "label", "text": "Валюта" },
            { "col": 3, "span": 3, "style": "value", "param": "Валюта" },
            { "col": 6, "span": 2, "style": "label", "text": "Менеджер" },
            { "col": 8, "span": 3, "style": "value", "param": "Менеджер", "detail": "МенеджерСсылка" }
          ]
        },
        { "empty": 1 }
      ]
    },
    {
      "name": "БлокиСторон",
      "rows": [
        {
          "height": 16,
          "cells": [
            { "col": 1, "span": 5, "style": "boxHead", "text": "Реквизиты поставщика" },
            { "col": 6, "span": 5, "style": "boxHead", "text": "Реквизиты покупателя" }
          ]
        },
        {
          "height": 48,
          "cells": [
            { "col": 1, "span": 5, "style": "box", "param": "РеквизитыПоставщика" },
            { "col": 6, "span": 5, "style": "box", "param": "РеквизитыПокупателя" }
          ]
        },
        { "empty": 1 }
      ]
    },
    {
      "name": "ШапкаТаблицы",
      "rows": [
        {
          "height": 28,
          "cells": [
            { "col": 1, "style": "th", "text": "№" },
            { "col": 2, "span": 2, "style": "th", "text": "Номенклатура / услуга" },
            { "col": 4, "style": "th", "text": "Ед." },
            { "col": 5, "style": "th", "text": "Кол-во" },
            { "col": 6, "style": "th", "text": "Цена" },
            { "col": 7, "style": "th", "text": "Скидка %" },
            { "col": 8, "span": 2, "style": "th", "text": "Сумма без НДС" },
            { "col": 10, "style": "th", "text": "НДС" }
          ]
        }
      ]
    },
    {
      "name": "Строка",
      "rows": [
        {
          "height": 18,
          "cells": [
            { "col": 1, "style": "tdCenter", "param": "НомерСтроки" },
            { "col": 2, "span": 2, "style": "td", "param": "Номенклатура", "detail": "НоменклатураСсылка" },
            { "col": 4, "style": "tdCenter", "param": "Единица" },
            { "col": 5, "style": "tdNum", "param": "Количество" },
            { "col": 6, "style": "tdNum", "param": "Цена" },
            { "col": 7, "style": "tdCenter", "param": "Скидка" },
            { "col": 8, "span": 2, "style": "tdNum", "param": "Сумма" },
            { "col": 10, "style": "tdNum", "param": "СуммаНДС" }
          ]
        }
      ]
    },
    {
      "name": "СтрокаАльт",
      "rows": [
        {
          "height": 18,
          "cells": [
            { "col": 1, "style": "tdCenter", "param": "НомерСтроки" },
            { "col": 2, "span": 2, "style": "alt", "param": "Номенклатура", "detail": "НоменклатураСсылка" },
            { "col": 4, "style": "tdCenter", "param": "Единица" },
            { "col": 5, "style": "altNum", "param": "Количество" },
            { "col": 6, "style": "altNum", "param": "Цена" },
            { "col": 7, "style": "tdCenter", "param": "Скидка" },
            { "col": 8, "span": 2, "style": "altNum", "param": "Сумма" },
            { "col": 10, "style": "altNum", "param": "СуммаНДС" }
          ]
        }
      ]
    },
    {
      "name": "Итоги",
      "rows": [
        { "empty": 1 },
        {
          "height": 16,
          "cells": [
            { "col": 6, "span": 2, "style": "sumLabel", "text": "Итого без НДС:" },
            { "col": 8, "span": 3, "style": "sumValue", "param": "ИтогоБезНДС" }
          ]
        },
        {
          "height": 16,
          "cells": [
            { "col": 6, "span": 2, "style": "sumLabel", "text": "НДС 20%:" },
            { "col": 8, "span": 3, "style": "sumValue", "param": "ИтогоНДС" }
          ]
        },
        {
          "height": 18,
          "cells": [
            { "col": 6, "span": 2, "style": "sumLabel", "text": "Всего к оплате:" },
            { "col": 8, "span": 3, "style": "grand", "param": "ВсегоКОплате" }
          ]
        },
        {
          "height": 16,
          "cells": [
            { "col": 1, "span": 10, "style": "note", "template": "Сумма прописью: [СуммаПрописью]" }
          ]
        },
        { "empty": 1 }
      ]
    },
    {
      "name": "Подписи",
      "rows": [
        {
          "height": 36,
          "cells": [
            { "col": 1, "span": 4, "style": "note", "text": "" },
            { "col": 6, "span": 4, "style": "note", "text": "" }
          ]
        },
        {
          "height": 14,
          "cells": [
            { "col": 1, "span": 4, "style": "sign", "text": "Руководитель / подпись" },
            { "col": 6, "span": 4, "style": "sign", "text": "Главный бухгалтер / подпись" }
          ]
        },
        { "empty": 1 },
        {
          "height": 28,
          "cells": [
            {
              "col": 1,
              "span": 10,
              "style": "note",
              "text": "Демонстрационный макет скиллов mxl-compile: области, параметры, шаблоны, расшифровка, стили, объединения, рисунки, чередование строк."
            }
          ]
        }
      ]
    }
  ],
  "header": {
    "font": "footer",
    "verticalAlignment": "Bottom",
    "left": "WIM DEV · MXL Showcase",
    "center": "Стр. [&НомерСтраницы] из [&СтраницВсего]",
    "right": { "ru": "Конфиденциально", "en": "Confidential" }
  },
  "footer": {
    "font": "footer",
    "center": { "formatted": "<i>Сгенерировано через mxl-compile DSL</>" }
  },
  "printSettings": {
    "pageOrientation": "Portrait",
    "topMargin": 800,
    "leftMargin": 800,
    "bottomMargin": 800,
    "rightMargin": 800,
    "fitToPage": true
  },
  "rowGroups": [
    { "rows": "12-13", "name": "Табличная часть", "titleLocation": "begin" }
  ]
}
