// Описание: Проверяет, бьет ли указанная сторона клетку
//
// Параметры:
// ДоскаПартии - Массив - 64 кодов фигур, белые положительные, черные отрицательные
// Клетка - Число - индекс клетки 0..63
// СторонаАтакующего - Число - 1 белые, -1 черные
//
// Возвращаемое значение:
// Булево - Истина, если клетка под боем
//
&НаСервереБезКонтекста
Функция КлеткаПодБоем(ДоскаПартии, Клетка, СторонаАтакующего)

    Если Клетка < 0 Тогда
        Возврат Ложь;
    КонецЕсли;

    Файл = ФайлКлетки(Клетка);
    Ранг = РангКлетки(Клетка);
    РангПешки = Ранг - СторонаАтакующего;
    Если РангПешки >= 0 И РангПешки <= 7 Тогда
        Если Файл > 0 И ДоскаПартии[ИндексКлетки(Файл - 1, РангПешки)] = СторонаАтакующего Тогда
            Возврат Истина;
        КонецЕсли;
        Если Файл < 7 И ДоскаПартии[ИндексКлетки(Файл + 1, РангПешки)] = СторонаАтакующего Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЕсли;

    Если БьетКонем(ДоскаПартии, Файл, Ранг, 2 * СторонаАтакующего) Тогда
        Возврат Истина;
    КонецЕсли;
    Если БьетКоролем(ДоскаПартии, Файл, Ранг, 6 * СторонаАтакующего) Тогда
        Возврат Истина;
    КонецЕсли;

    КодЛадьи = 4 * СторонаАтакующего;
    КодСлона = 3 * СторонаАтакующего;
    КодФерзя = 5 * СторонаАтакующего;
    Если ЛучБьет(ДоскаПартии, Файл, Ранг, 1, 0, КодЛадьи, КодФерзя) Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЛучБьет(ДоскаПартии, Файл, Ранг, -1, 0, КодЛадьи, КодФерзя) Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЛучБьет(ДоскаПартии, Файл, Ранг, 0, 1, КодЛадьи, КодФерзя) Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЛучБьет(ДоскаПартии, Файл, Ранг, 0, -1, КодЛадьи, КодФерзя) Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЛучБьет(ДоскаПартии, Файл, Ранг, 1, 1, КодСлона, КодФерзя) Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЛучБьет(ДоскаПартии, Файл, Ранг, 1, -1, КодСлона, КодФерзя) Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЛучБьет(ДоскаПартии, Файл, Ранг, -1, 1, КодСлона, КодФерзя) Тогда
        Возврат Истина;
    КонецЕсли;
    Если ЛучБьет(ДоскаПартии, Файл, Ранг, -1, -1, КодСлона, КодФерзя) Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция ЛучБьет(ДоскаПартии, Файл, Ранг, ШагФайла, ШагРанга, ПерваяФигура, ВтораяФигура)

    ТекущийФайл = Файл + ШагФайла;
    ТекущийРанг = Ранг + ШагРанга;
    Пока ТекущийФайл >= 0 И ТекущийФайл <= 7 И ТекущийРанг >= 0 И ТекущийРанг <= 7 Цикл
        Фигура = ДоскаПартии[ИндексКлетки(ТекущийФайл, ТекущийРанг)];
        Если Фигура <> 0 Тогда
            Возврат Фигура = ПерваяФигура Или Фигура = ВтораяФигура;
        КонецЕсли;
        ТекущийФайл = ТекущийФайл + ШагФайла;
        ТекущийРанг = ТекущийРанг + ШагРанга;
    КонецЦикла;
    Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция БьетКонем(ДоскаПартии, Файл, Ранг, КодКоня)

    Если КлеткаСодержит(ДоскаПартии, Файл + 1, Ранг + 2, КодКоня) Тогда
        Возврат Истина;
    КонецЕсли;
    Если КлеткаСодержит(ДоскаПартии, Файл + 2, Ранг + 1, КодКоня) Тогда
        Возврат Истина;
    КонецЕсли;
    Если КлеткаСодержит(ДоскаПартии, Файл - 1, Ранг + 2, КодКоня) Тогда
        Возврат Истина;
    КонецЕсли;
    Если КлеткаСодержит(ДоскаПартии, Файл - 2, Ранг + 1, КодКоня) Тогда
        Возврат Истина;
    КонецЕсли;
    Если КлеткаСодержит(ДоскаПартии, Файл + 1, Ранг - 2, КодКоня) Тогда
        Возврат Истина;
    КонецЕсли;
    Если КлеткаСодержит(ДоскаПартии, Файл + 2, Ранг - 1, КодКоня) Тогда
        Возврат Истина;
    КонецЕсли;
    Если КлеткаСодержит(ДоскаПартии, Файл - 1, Ранг - 2, КодКоня) Тогда
        Возврат Истина;
    КонецЕсли;
    Если КлеткаСодержит(ДоскаПартии, Файл - 2, Ранг - 1, КодКоня) Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция БьетКоролем(ДоскаПартии, Файл, Ранг, КодКороля)

    Для ШагФайла = -1 По 1 Цикл
        Для ШагРанга = -1 По 1 Цикл
            Если ШагФайла = 0 И ШагРанга = 0 Тогда
                Продолжить;
            КонецЕсли;
            Если КлеткаСодержит(ДоскаПартии, Файл + ШагФайла, Ранг + ШагРанга, КодКороля) Тогда
                Возврат Истина;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция КлеткаСодержит(ДоскаПартии, Файл, Ранг, КодФигуры)

    Если Файл < 0 Или Файл > 7 Или Ранг < 0 Или Ранг > 7 Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат ДоскаПартии[ИндексКлетки(Файл, Ранг)] = КодФигуры;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиКороля(ДоскаПартии, Сторона)

    Искомый = 6 * Сторона;
    Для Клетка = 0 По 63 Цикл
        Если ДоскаПартии[Клетка] = Искомый Тогда
            Возврат Клетка;
        КонецЕсли;
    КонецЦикла;
    Возврат -1;

КонецФункции

// Описание: Возвращает ходы, после которых свой король не остается под боем
//
// Параметры:
// Поз - Структура - позиция
//
// Возвращаемое значение:
// Массив из Число - упакованные легальные ходы
//
&НаСервереБезКонтекста
Функция ЛегальныеХоды(Поз)

    Псевдо = Псевдоходы(Поз);
    Легальные = Новый Массив;
    СторонаХодившего = Поз.Сторона;
    Для Каждого ТекущийХод Из Псевдо Цикл
        Отмена = ВыполнитьХод(Поз, ТекущийХод);
        Король = НайтиКороля(Поз.Доска, СторонаХодившего);
        Если Король >= 0 И Не КлеткаПодБоем(Поз.Доска, Король, Поз.Сторона) Тогда
            Легальные.Добавить(ТекущийХод);
        КонецЕсли;
        ОткатитьХод(Поз, Отмена);
    КонецЦикла;
    Возврат Легальные;

КонецФункции

&НаСервереБезКонтекста
Функция Псевдоходы(Поз)

    Ходы = Новый Массив;
    Сторона = Поз.Сторона;
    Для Клетка = 0 По 63 Цикл
        Фигура = Поз.Доска[Клетка];
        Если Не ФигурыОднойСтороны(Фигура, Сторона) Тогда
            Продолжить;
        КонецЕсли;

        Тип = ?(Фигура > 0, Фигура, -Фигура);
        Если Тип = 1 Тогда
            ДобавитьХодыПешки(Поз, Ходы, Клетка);
        ИначеЕсли Тип = 2 Тогда
            ДобавитьСмещение(Поз, Ходы, Клетка, 1, 2, Сторона);
            ДобавитьСмещение(Поз, Ходы, Клетка, 2, 1, Сторона);
            ДобавитьСмещение(Поз, Ходы, Клетка, -1, 2, Сторона);
            ДобавитьСмещение(Поз, Ходы, Клетка, -2, 1, Сторона);
            ДобавитьСмещение(Поз, Ходы, Клетка, 1, -2, Сторона);
            ДобавитьСмещение(Поз, Ходы, Клетка, 2, -1, Сторона);
            ДобавитьСмещение(Поз, Ходы, Клетка, -1, -2, Сторона);
            ДобавитьСмещение(Поз, Ходы, Клетка, -2, -1, Сторона);
        ИначеЕсли Тип = 3 Тогда
            ДобавитьЛуч(Поз, Ходы, Клетка, 1, 1, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, 1, -1, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, -1, 1, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, -1, -1, Сторона);
        ИначеЕсли Тип = 4 Тогда
            ДобавитьЛуч(Поз, Ходы, Клетка, 1, 0, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, -1, 0, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, 0, 1, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, 0, -1, Сторона);
        ИначеЕсли Тип = 5 Тогда
            ДобавитьЛуч(Поз, Ходы, Клетка, 1, 0, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, -1, 0, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, 0, 1, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, 0, -1, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, 1, 1, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, 1, -1, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, -1, 1, Сторона);
            ДобавитьЛуч(Поз, Ходы, Клетка, -1, -1, Сторона);
        ИначеЕсли Тип = 6 Тогда
            Для ШагФайла = -1 По 1 Цикл
                Для ШагРанга = -1 По 1 Цикл
                    Если ШагФайла <> 0 Или ШагРанга <> 0 Тогда
                        ДобавитьСмещение(Поз, Ходы, Клетка, ШагФайла, ШагРанга, Сторона);
                    КонецЕсли;
                КонецЦикла;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;

    ДобавитьРокировки(Поз, Ходы);
    Возврат Ходы;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСмещение(Поз, Ходы, Откуда, ШагФайла, ШагРанга, Сторона)

    Файл = ФайлКлетки(Откуда) + ШагФайла;
    Ранг = РангКлетки(Откуда) + ШагРанга;
    Если Файл < 0 Или Файл > 7 Или Ранг < 0 Или Ранг > 7 Тогда
        Возврат;
    КонецЕсли;

    Куда = ИндексКлетки(Файл, Ранг);
    Цель = Поз.Доска[Куда];
    Если Цель = 0 Или Не ФигурыОднойСтороны(Цель, Сторона) Тогда
        Ходы.Добавить(СобратьХод(Откуда, Куда, 0, 0, 0));
    КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьЛуч(Поз, Ходы, Откуда, ШагФайла, ШагРанга, Сторона)

    Файл = ФайлКлетки(Откуда) + ШагФайла;
    Ранг = РангКлетки(Откуда) + ШагРанга;
    Пока Файл >= 0 И Файл <= 7 И Ранг >= 0 И Ранг <= 7 Цикл
        Куда = ИндексКлетки(Файл, Ранг);
        Цель = Поз.Доска[Куда];
        Если Цель = 0 Тогда
            Ходы.Добавить(СобратьХод(Откуда, Куда, 0, 0, 0));
        Иначе
            Если Не ФигурыОднойСтороны(Цель, Сторона) Тогда
                Ходы.Добавить(СобратьХод(Откуда, Куда, 0, 0, 0));
            КонецЕсли;
            Возврат;
        КонецЕсли;
        Файл = Файл + ШагФайла;
        Ранг = Ранг + ШагРанга;
    КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьХодыПешки(Поз, Ходы, Откуда)

    Сторона = Поз.Сторона;
    Файл = ФайлКлетки(Откуда);
    Ранг = РангКлетки(Откуда);
    Если Сторона > 0 Тогда
        Старт = 1;
        РангПревращения = 7;
    Иначе
        Старт = 6;
        РангПревращения = 0;
    КонецЕсли;

    НовыйРанг = Ранг + Сторона;
    Если НовыйРанг < 0 Или НовыйРанг > 7 Тогда
        Возврат;
    КонецЕсли;

    Куда = ИндексКлетки(Файл, НовыйРанг);
    Если Поз.Доска[Куда] = 0 Тогда
        ДобавитьХодПешки(Ходы, Откуда, Куда, НовыйРанг = РангПревращения);
        Если Ранг = Старт Тогда
            КудаДвойной = ИндексКлетки(Файл, Ранг + 2 * Сторона);
            Если Поз.Доска[КудаДвойной] = 0 Тогда
                Ходы.Добавить(СобратьХод(Откуда, КудаДвойной, 0, 0, 0));
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    Для СмещениеФайла = -1 По 1 Цикл
        Если СмещениеФайла = 0 Тогда
            Продолжить;
        КонецЕсли;
        НовыйФайл = Файл + СмещениеФайла;
        Если НовыйФайл < 0 Или НовыйФайл > 7 Тогда
            Продолжить;
        КонецЕсли;
        КудаВзятия = ИндексКлетки(НовыйФайл, НовыйРанг);
        Цель = Поз.Доска[КудаВзятия];
        Если Цель <> 0 И Не ФигурыОднойСтороны(Цель, Сторона) Тогда
            ДобавитьХодПешки(Ходы, Откуда, КудаВзятия, НовыйРанг = РангПревращения);
        ИначеЕсли КудаВзятия = Поз.Проход Тогда
            Ходы.Добавить(СобратьХод(Откуда, КудаВзятия, 0, 0, 1));
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьХодПешки(Ходы, Откуда, Куда, ЭтоПревращение)

    Если ЭтоПревращение Тогда
        Ходы.Добавить(СобратьХод(Откуда, Куда, 5, 0, 0));
        Ходы.Добавить(СобратьХод(Откуда, Куда, 4, 0, 0));
        Ходы.Добавить(СобратьХод(Откуда, Куда, 3, 0, 0));
        Ходы.Добавить(СобратьХод(Откуда, Куда, 2, 0, 0));
    Иначе
        Ходы.Добавить(СобратьХод(Откуда, Куда, 0, 0, 0));
    КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьРокировки(Поз, Ходы)

    Если Поз.Сторона > 0 Тогда
        Если Поз.БелаяКороткая И Поз.Доска[4] = 6 И Поз.Доска[7] = 4 И Поз.Доска[5] = 0 И Поз.Доска[6] = 0 Тогда
            Если Не КлеткаПодБоем(Поз.Доска, 4, -1)
                И Не КлеткаПодБоем(Поз.Доска, 5, -1)
                И Не КлеткаПодБоем(Поз.Доска, 6, -1) Тогда
                Ходы.Добавить(СобратьХод(4, 6, 0, 1, 0));
            КонецЕсли;
        КонецЕсли;
        Если Поз.БелаяДлинная И Поз.Доска[4] = 6 И Поз.Доска[0] = 4
            И Поз.Доска[1] = 0 И Поз.Доска[2] = 0 И Поз.Доска[3] = 0 Тогда
            Если Не КлеткаПодБоем(Поз.Доска, 4, -1)
                И Не КлеткаПодБоем(Поз.Доска, 3, -1)
                И Не КлеткаПодБоем(Поз.Доска, 2, -1) Тогда
                Ходы.Добавить(СобратьХод(4, 2, 0, 2, 0));
            КонецЕсли;
        КонецЕсли;
    Иначе
        Если Поз.ЧернаяКороткая И Поз.Доска[60] = -6 И Поз.Доска[63] = -4 И Поз.Доска[61] = 0 И Поз.Доска[62] = 0 Тогда
            Если Не КлеткаПодБоем(Поз.Доска, 60, 1)
                И Не КлеткаПодБоем(Поз.Доска, 61, 1)
                И Не КлеткаПодБоем(Поз.Доска, 62, 1) Тогда
                Ходы.Добавить(СобратьХод(60, 62, 0, 1, 0));
            КонецЕсли;
        КонецЕсли;
        Если Поз.ЧернаяДлинная И Поз.Доска[60] = -6 И Поз.Доска[56] = -4
            И Поз.Доска[57] = 0 И Поз.Доска[58] = 0 И Поз.Доска[59] = 0 Тогда
            Если Не КлеткаПодБоем(Поз.Доска, 60, 1)
                И Не КлеткаПодБоем(Поз.Доска, 59, 1)
                И Не КлеткаПодБоем(Поз.Доска, 58, 1) Тогда
                Ходы.Добавить(СобратьХод(60, 58, 0, 2, 0));
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

// Описание: Делает ход на доске и возвращает данные для отката
//
// Параметры:
// Поз - Структура - позиция, изменяется на месте
// ТекущийХод - Число - упакованный ход
//
// Возвращаемое значение:
// Структура - снимок для ОткатитьХод
//
&НаСервереБезКонтекста
Функция ВыполнитьХод(Поз, ТекущийХод)

    Откуда = ОткудаХода(ТекущийХод);
    Куда = КудаХода(ТекущийХод);
    Превращение = ПревращениеХода(ТекущийХод);
    Рокировка = РокировкаХода(ТекущийХод);
    НаПроходе = НаПроходеХода(ТекущийХод);
    Фигура = Поз.Доска[Откуда];
    Взятие = Поз.Доска[Куда];
    Жертва = -1;
    ЛадьяОткуда = -1;
    ЛадьяКуда = -1;
    ЛадьяФигура = 0;

    Если НаПроходе = 1 Тогда
        Если Фигура > 0 Тогда
            Жертва = Куда - 8;
        Иначе
            Жертва = Куда + 8;
        КонецЕсли;
        Взятие = Поз.Доска[Жертва];
        Поз.Доска[Жертва] = 0;
    КонецЕсли;

    Если Рокировка = 1 Тогда
        Если Фигура > 0 Тогда
            ЛадьяОткуда = 7;
            ЛадьяКуда = 5;
        Иначе
            ЛадьяОткуда = 63;
            ЛадьяКуда = 61;
        КонецЕсли;
    ИначеЕсли Рокировка = 2 Тогда
        Если Фигура > 0 Тогда
            ЛадьяОткуда = 0;
            ЛадьяКуда = 3;
        Иначе
            ЛадьяОткуда = 56;
            ЛадьяКуда = 59;
        КонецЕсли;
    КонецЕсли;

    Если ЛадьяОткуда >= 0 Тогда
        ЛадьяФигура = Поз.Доска[ЛадьяОткуда];
        Поз.Доска[ЛадьяКуда] = ЛадьяФигура;
        Поз.Доска[ЛадьяОткуда] = 0;
    КонецЕсли;

    Поз.Доска[Откуда] = 0;
    Если Превращение > 0 Тогда
        Если Фигура > 0 Тогда
            Поз.Доска[Куда] = Превращение;
        Иначе
            Поз.Доска[Куда] = -Превращение;
        КонецЕсли;
    Иначе
        Поз.Доска[Куда] = Фигура;
    КонецЕсли;

    Отмена = Новый Структура;
    Отмена.Вставить("Откуда", Откуда);
    Отмена.Вставить("Куда", Куда);
    Отмена.Вставить("Фигура", Фигура);
    Отмена.Вставить("Взятие", Взятие);
    Отмена.Вставить("НаПроходе", НаПроходе);
    Отмена.Вставить("Жертва", Жертва);
    Отмена.Вставить("ЛадьяОткуда", ЛадьяОткуда);
    Отмена.Вставить("ЛадьяКуда", ЛадьяКуда);
    Отмена.Вставить("ЛадьяФигура", ЛадьяФигура);
    Отмена.Вставить("БелаяКороткая", Поз.БелаяКороткая);
    Отмена.Вставить("БелаяДлинная", Поз.БелаяДлинная);
    Отмена.Вставить("ЧернаяКороткая", Поз.ЧернаяКороткая);
    Отмена.Вставить("ЧернаяДлинная", Поз.ЧернаяДлинная);
    Отмена.Вставить("Проход", Поз.Проход);
    Отмена.Вставить("Сторона", Поз.Сторона);
    Отмена.Вставить("Полуход", Поз.Полуход);
    Отмена.Вставить("НомерХода", Поз.НомерХода);

    СнятьРокировку(Поз, Откуда, Куда, Фигура);

    Тип = ?(Фигура > 0, Фигура, -Фигура);
    Если Тип = 1 Тогда
        Разница = Куда - Откуда;
        Если Разница < 0 Тогда
            Разница = -Разница;
        КонецЕсли;
        Если Разница = 16 Тогда
            Если Куда > Откуда Тогда
                Поз.Проход = Откуда + 8;
            Иначе
                Поз.Проход = Откуда - 8;
            КонецЕсли;
        Иначе
            Поз.Проход = -1;
        КонецЕсли;
    Иначе
        Поз.Проход = -1;
    КонецЕсли;

    Если Тип = 1 Или Взятие <> 0 Тогда
        Поз.Полуход = 0;
    Иначе
        Поз.Полуход = Поз.Полуход + 1;
    КонецЕсли;
    Если Поз.Сторона < 0 Тогда
        Поз.НомерХода = Поз.НомерХода + 1;
    КонецЕсли;
    Поз.Сторона = -Поз.Сторона;
    Возврат Отмена;

КонецФункции

&НаСервереБезКонтекста
Процедура СнятьРокировку(Поз, Откуда, Куда, Фигура)

    Если Фигура = 6 Или Откуда = 4 Тогда
        Поз.БелаяКороткая = Ложь;
        Поз.БелаяДлинная = Ложь;
    КонецЕсли;
    Если Фигура = -6 Или Откуда = 60 Тогда
        Поз.ЧернаяКороткая = Ложь;
        Поз.ЧернаяДлинная = Ложь;
    КонецЕсли;
    Если Откуда = 7 Или Куда = 7 Тогда
        Поз.БелаяКороткая = Ложь;
    КонецЕсли;
    Если Откуда = 0 Или Куда = 0 Тогда
        Поз.БелаяДлинная = Ложь;
    КонецЕсли;
    Если Откуда = 63 Или Куда = 63 Тогда
        Поз.ЧернаяКороткая = Ложь;
    КонецЕсли;
    Если Откуда = 56 Или Куда = 56 Тогда
        Поз.ЧернаяДлинная = Ложь;
    КонецЕсли;

КонецПроцедуры

// Описание: Возвращает позицию к состоянию до ВыполнитьХод
//
// Параметры:
// Поз - Структура - позиция после хода
// Отмена - Структура - снимок, который вернул ВыполнитьХод
//
&НаСервереБезКонтекста
Процедура ОткатитьХод(Поз, Отмена)

    Если Отмена.НаПроходе = 1 Тогда
        Поз.Доска[Отмена.Куда] = 0;
        Поз.Доска[Отмена.Жертва] = Отмена.Взятие;
    Иначе
        Поз.Доска[Отмена.Куда] = Отмена.Взятие;
    КонецЕсли;
    Поз.Доска[Отмена.Откуда] = Отмена.Фигура;
    Если Отмена.ЛадьяОткуда >= 0 Тогда
        Поз.Доска[Отмена.ЛадьяКуда] = 0;
        Поз.Доска[Отмена.ЛадьяОткуда] = Отмена.ЛадьяФигура;
    КонецЕсли;

    Поз.БелаяКороткая = Отмена.БелаяКороткая;
    Поз.БелаяДлинная = Отмена.БелаяДлинная;
    Поз.ЧернаяКороткая = Отмена.ЧернаяКороткая;
    Поз.ЧернаяДлинная = Отмена.ЧернаяДлинная;
    Поз.Проход = Отмена.Проход;
    Поз.Сторона = Отмена.Сторона;
    Поз.Полуход = Отмена.Полуход;
    Поз.НомерХода = Отмена.НомерХода;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиХодМежду(Ходы, Откуда, Куда)

    Запасной = -1;
    Для Каждого ТекущийХод Из Ходы Цикл
        Если ОткудаХода(ТекущийХод) <> Откуда Или КудаХода(ТекущийХод) <> Куда Тогда
            Продолжить;
        КонецЕсли;
        Превращение = ПревращениеХода(ТекущийХод);
        Если Превращение = 0 Или Превращение = 5 Тогда
            Возврат ТекущийХод;
        КонецЕсли;
        Если Запасной < 0 Тогда
            Запасной = ТекущийХод;
        КонецЕсли;
    КонецЦикла;
    Возврат Запасной;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстХода(Поз, ТекущийХод)

    Откуда = ОткудаХода(ТекущийХод);
    Куда = КудаХода(ТекущийХод);
    Если РокировкаХода(ТекущийХод) = 1 Тогда
        Возврат "O-O";
    ИначеЕсли РокировкаХода(ТекущийХод) = 2 Тогда
        Возврат "O-O-O";
    КонецЕсли;

    Фигура = Поз.Доска[Откуда];
    ЕстьВзятие = Поз.Доска[Куда] <> 0 Или НаПроходеХода(ТекущийХод) = 1;
    Если ЕстьВзятие Тогда
        ЗнакХода = "x";
    Иначе
        ЗнакХода = "-";
    КонецЕсли;
    Текст = БукваФигуры(Фигура) + ИмяКлетки(Откуда) + ЗнакХода + ИмяКлетки(Куда);
    Превращение = ПревращениеХода(ТекущийХод);
    Если Превращение > 0 Тогда
        Текст = Текст + "=" + БукваФигуры(Превращение);
    КонецЕсли;
    Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция СуффиксШах(Поз)

    Король = НайтиКороля(Поз.Доска, Поз.Сторона);
    Если Король < 0 Или Не КлеткаПодБоем(Поз.Доска, Король, -Поз.Сторона) Тогда
        Возврат "";
    КонецЕсли;
    Если ЛегальныеХоды(Поз).Количество() = 0 Тогда
        Возврат "#";
    КонецЕсли;
    Возврат "+";

КонецФункции

&НаСервереБезКонтекста
Функция НедостаточноФигур(ДоскаПартии)

    БелыеЛегкие = 0;
    ЧерныеЛегкие = 0;
    ЕстьТяжелые = Ложь;
    Для Клетка = 0 По 63 Цикл
        Фигура = ДоскаПартии[Клетка];
        Если Фигура = 0 Тогда
            Продолжить;
        КонецЕсли;
        Тип = ?(Фигура > 0, Фигура, -Фигура);
        Если Тип = 1 Или Тип = 4 Или Тип = 5 Тогда
            ЕстьТяжелые = Истина;
        ИначеЕсли Тип = 2 Или Тип = 3 Тогда
            Если Фигура > 0 Тогда
                БелыеЛегкие = БелыеЛегкие + 1;
            Иначе
                ЧерныеЛегкие = ЧерныеЛегкие + 1;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Если ЕстьТяжелые Тогда
        Возврат Ложь;
    КонецЕсли;
    Если БелыеЛегкие = 0 И ЧерныеЛегкие = 0 Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат БелыеЛегкие + ЧерныеЛегкие = 1;

КонецФункции

// Описание: Выбирает ход компьютера перебором с отсечением
//
// Параметры:
// Поз - Структура - позиция, в которой ходит компьютер
// ГлубинаПоиска - Число - 1, 2 или 3 полухода
//
// Возвращаемое значение:
// Число - упакованный ход либо -1, если ходов нет
//
&НаСервереБезКонтекста
Функция ЛучшийХод(Поз, ГлубинаПоиска)

    Ходы = ЛегальныеХоды(Поз);
    Если Ходы.Количество() = 0 Тогда
        Возврат -1;
    КонецЕсли;
    Если ГлубинаПоиска < 1 Тогда
        ГлубинаПоиска = 1;
    КонецЕсли;

    УпорядочитьХоды(Поз.Доска, Ходы);
    Лучший = Ходы[0];
    ЛучшаяОценка = -999999;
    Альфа = -999999;
    Бета = 999999;
    Для Каждого ТекущийХод Из Ходы Цикл
        Отмена = ВыполнитьХод(Поз, ТекущийХод);
        ОценкаХода = -Негамакс(Поз, ГлубинаПоиска - 1, -Бета, -Альфа, 1);
        ОткатитьХод(Поз, Отмена);
        Если ОценкаХода > ЛучшаяОценка Тогда
            ЛучшаяОценка = ОценкаХода;
            Лучший = ТекущийХод;
        КонецЕсли;
        Если ОценкаХода > Альфа Тогда
            Альфа = ОценкаХода;
        КонецЕсли;
    КонецЦикла;
    Возврат Лучший;

КонецФункции

&НаСервереБезКонтекста
Функция Негамакс(Поз, ГлубинаПоиска, Альфа, Бета, Пройдено)

    Если ГлубинаПоиска <= 0 Тогда
        Возврат ОценкаПозиции(Поз);
    КонецЕсли;

    Ходы = ЛегальныеХоды(Поз);
    Если Ходы.Количество() = 0 Тогда
        Король = НайтиКороля(Поз.Доска, Поз.Сторона);
        Если Король >= 0 И КлеткаПодБоем(Поз.Доска, Король, -Поз.Сторона) Тогда
            Возврат -100000 + Пройдено;
        КонецЕсли;
        Возврат 0;
    КонецЕсли;

    УпорядочитьХоды(Поз.Доска, Ходы);
    Для Каждого ТекущийХод Из Ходы Цикл
        Отмена = ВыполнитьХод(Поз, ТекущийХод);
        ОценкаХода = -Негамакс(Поз, ГлубинаПоиска - 1, -Бета, -Альфа, Пройдено + 1);
        ОткатитьХод(Поз, Отмена);
        Если ОценкаХода >= Бета Тогда
            Возврат Бета;
        КонецЕсли;
        Если ОценкаХода > Альфа Тогда
            Альфа = ОценкаХода;
        КонецЕсли;
    КонецЦикла;
    Возврат Альфа;

КонецФункции

&НаСервереБезКонтекста
Процедура УпорядочитьХоды(ДоскаПартии, Ходы)

    Индекс = 1;
    Пока Индекс < Ходы.Количество() Цикл
        Текущий = Ходы[Индекс];
        ОценкаТекущего = ОценкаСортировки(ДоскаПартии, Текущий);
        ПозицияВставки = Индекс;
        Пока ПозицияВставки > 0 Цикл
            Предыдущий = Ходы[ПозицияВставки - 1];
            Если ОценкаСортировки(ДоскаПартии, Предыдущий) >= ОценкаТекущего Тогда
                Прервать;
            КонецЕсли;
            Ходы[ПозицияВставки] = Предыдущий;
            ПозицияВставки = ПозицияВставки - 1;
        КонецЦикла;
        Ходы[ПозицияВставки] = Текущий;
        Индекс = Индекс + 1;
    КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОценкаСортировки(ДоскаПартии, ТекущийХод)

    Куда = КудаХода(ТекущийХод);
    Взятие = ДоскаПартии[Куда];
    Если НаПроходеХода(ТекущийХод) = 1 Тогда
        Взятие = 1;
    КонецЕсли;
    Если Взятие = 0 Тогда
        Возврат 0;
    КонецЕсли;

    ТипЖертвы = ?(Взятие > 0, Взятие, -Взятие);
    Фигура = ДоскаПартии[ОткудаХода(ТекущийХод)];
    ТипАтакующего = ?(Фигура > 0, Фигура, -Фигура);
    Возврат ВесТипа(ТипЖертвы) * 10 - ВесТипа(ТипАтакующего);

КонецФункции

&НаСервереБезКонтекста
Функция ОценкаПозиции(Поз)

    Счет = 0;
    Для Клетка = 0 По 63 Цикл
        Фигура = Поз.Доска[Клетка];
        Если Фигура = 0 Тогда
            Продолжить;
        КонецЕсли;
        Если Фигура > 0 Тогда
            ЗнакФигуры = 1;
        Иначе
            ЗнакФигуры = -1;
        КонецЕсли;
        Тип = Фигура * ЗнакФигуры;
        Счет = Счет + ЗнакФигуры * (ВесТипа(Тип) + ПозиционныйВес(Тип, Клетка, ЗнакФигуры));
    КонецЦикла;
    Возврат Счет * Поз.Сторона;

КонецФункции

&НаСервереБезКонтекста
Функция ВесТипа(Тип)

    Если Тип = 1 Тогда
        Возврат 100;
    ИначеЕсли Тип = 2 Тогда
        Возврат 320;
    ИначеЕсли Тип = 3 Тогда
        Возврат 330;
    ИначеЕсли Тип = 4 Тогда
        Возврат 500;
    ИначеЕсли Тип = 5 Тогда
        Возврат 900;
    КонецЕсли;
    Возврат 0;

КонецФункции

&НаСервереБезКонтекста
Функция ПозиционныйВес(Тип, Клетка, ЗнакФигуры)

    Файл = ФайлКлетки(Клетка);
    Ранг = РангКлетки(Клетка);
    Если ЗнакФигуры < 0 Тогда
        Ранг = 7 - Ранг;
    КонецЕсли;
    Если Файл < 4 Тогда
        ЦентрФайла = Файл;
    Иначе
        ЦентрФайла = 7 - Файл;
    КонецЕсли;

    Если Тип = 1 Тогда
        Возврат Ранг * 8 + ЦентрФайла;
    ИначеЕсли Тип = 2 Тогда
        Надбавка = 0;
        Если Ранг >= 2 И Ранг <= 4 Тогда
            Надбавка = 6;
        КонецЕсли;
        Возврат ЦентрФайла * 4 + Надбавка;
    ИначеЕсли Тип = 3 Тогда
        Возврат ЦентрФайла * 3;
    ИначеЕсли Тип = 4 Или Тип = 5 Тогда
        Возврат ЦентрФайла;
    КонецЕсли;

    Если Ранг = 0 И (Файл = 6 Или Файл = 2) Тогда
        Возврат 25;
    ИначеЕсли Ранг = 0 И Файл = 4 Тогда
        Возврат 5;
    КонецЕсли;
    Возврат -20;

КонецФункции

#КонецОбласти
