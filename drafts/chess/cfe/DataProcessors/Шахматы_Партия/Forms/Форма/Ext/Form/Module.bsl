// Описание: Рисует доску по текущей позиции и подсвечивает выбранный ход
//
&НаСервере
Процедура ОтрисоватьДоску()

    Поз = РазобратьПозицию(Позиция);
    Цели = Новый Соответствие;
    Если ВыбраннаяКлетка >= 0 И Не ПартияОкончена И Поз.Сторона = СторонаИгрока Тогда
        Для Каждого ТекущийХод Из ЛегальныеХоды(Поз) Цикл
            Если ОткудаХода(ТекущийХод) = ВыбраннаяКлетка Тогда
                Цели.Вставить(КудаХода(ТекущийХод), Истина);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    КорольШах = -1;
    Король = НайтиКороля(Поз.Доска, Поз.Сторона);
    Если Король >= 0 И КлеткаПодБоем(Поз.Доска, Король, -Поз.Сторона) Тогда
        КорольШах = Король;
    КонецЕсли;

    Документ = Новый ТабличныйДокумент;
    ЦветСветлый = Новый Цвет(240, 217, 181);
    ЦветТемный = Новый Цвет(181, 136, 99);
    ЦветВыбора = Новый Цвет(246, 226, 110);
    ЦветХода = Новый Цвет(146, 196, 125);
    ЦветПоследнего = Новый Цвет(214, 214, 140);
    ЦветШах = Новый Цвет(224, 112, 102);
    ЦветПлюса = Новый Цвет(20, 90, 30);
    ЦветКоординат = Новый Цвет(70, 70, 70);
    ЦветПоляКоординат = Новый Цвет(245, 245, 245);

    Для НомерСтроки = 1 По 8 Цикл
        Документ.Область(НомерСтроки, 1, НомерСтроки, 1).ВысотаСтроки = 48;
    КонецЦикла;
    Документ.Область(9, 1, 9, 1).ВысотаСтроки = 18;
    Документ.Область(1, 1, 1, 1).ШиринаКолонки = 4;
    Для НомерКолонки = 2 По 9 Цикл
        Документ.Область(1, НомерКолонки, 1, НомерКолонки).ШиринаКолонки = 8;
    КонецЦикла;

    Для НомерСтроки = 1 По 8 Цикл
        ЗаполнитьЯчейку(Документ, НомерСтроки, 1, Формат(9 - НомерСтроки, "ЧГ=0"), ЦветПоляКоординат, ЦветКоординат, 11, Ложь);
    КонецЦикла;
    Для Файл = 0 По 7 Цикл
        ЗаполнитьЯчейку(Документ, 9, Файл + 2, Символ(КодСимвола("a") + Файл), ЦветПоляКоординат, ЦветКоординат, 11, Ложь);
    КонецЦикла;

    Для Клетка = 0 По 63 Цикл
        Файл = ФайлКлетки(Клетка);
        Ранг = РангКлетки(Клетка);
        НомерСтроки = 8 - Ранг;
        НомерКолонки = Файл + 2;
        Светлая = Остаток(Файл + Ранг, 2) = 0;
        Если Светлая Тогда
            ЦветФона = ЦветТемный;
        Иначе
            ЦветФона = ЦветСветлый;
        КонецЕсли;

        Если Клетка = ВыбраннаяКлетка Тогда
            ЦветФона = ЦветВыбора;
        ИначеЕсли Цели.Получить(Клетка) = Истина Тогда
            ЦветФона = ЦветХода;
        ИначеЕсли Клетка = КорольШах Тогда
            ЦветФона = ЦветШах;
        ИначеЕсли Клетка = ПоследнийОткуда Или Клетка = ПоследнийКуда Тогда
            ЦветФона = ЦветПоследнего;
        КонецЕсли;

        Фигура = Поз.Доска[Клетка];
        Картинка = КартинкаФигуры(Фигура);
        Текст = "";
        ЦветТекста = ЦветКоординат;
        Если ТипЗнч(Картинка) = Тип("Неопределено") И Цели.Получить(Клетка) = Истина Тогда
            Текст = "+";
            ЦветТекста = ЦветПлюса;
        КонецЕсли;
        ЗаполнитьЯчейку(Документ, НомерСтроки, НомерКолонки, Текст, ЦветФона, ЦветТекста, 16, Истина, Картинка);
    КонецЦикла;

    Доска = Документ;
    Элементы.Доска.ТекущаяОбласть = Доска.Область(9, 2, 9, 2);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЯчейку(Документ, НомерСтроки, НомерКолонки, Текст, ЦветФона, ЦветТекста, РазмерШрифта, Жирный, Картинка = Неопределено)

    Ячейка = Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
    Ячейка.Текст = Текст;
    Ячейка.ЦветФона = ЦветФона;
    Ячейка.ЦветТекста = ЦветТекста;
    Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
    Ячейка.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
    Ячейка.Шрифт = Новый Шрифт(, РазмерШрифта, Жирный);
    Если ТипЗнч(Картинка) <> Тип("Неопределено") Тогда
        Ячейка.Картинка = Картинка;
        Ячейка.РазмерКартинки = РазмерКартинки.Пропорционально;
        Ячейка.ГоризонтальноеПоложениеКартинки = ГоризонтальноеПоложение.Центр;
        Ячейка.ВертикальноеПоложениеКартинки = ВертикальноеПоложение.Центр;
    КонецЕсли;

КонецПроцедуры

