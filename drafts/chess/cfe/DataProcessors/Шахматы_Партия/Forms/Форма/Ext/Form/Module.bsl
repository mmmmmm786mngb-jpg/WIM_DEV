Функция КоличествоПовторов()

    Строки = СтрокиСписка(СписокПозиций);
    Если Строки.Количество() = 0 Тогда
        Возврат 0;
    КонецЕсли;

    ПоследнийКлюч = КлючПозицииИзЗаписи(Строки[Строки.Количество() - 1]);
    Счетчик = 0;
    Для Каждого СтрокаЗаписи Из Строки Цикл
        Если КлючПозицииИзЗаписи(СтрокаЗаписи) = ПоследнийКлюч Тогда
            Счетчик = Счетчик + 1;
        КонецЕсли;
    КонецЦикла;
    Возврат Счетчик;

