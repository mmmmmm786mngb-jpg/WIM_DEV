        СтрокаХода = Формат(Номер, "ЧГ=0") + ". " + Строки[Индекс];
        Если Индекс + 1 < Строки.Количество() Тогда
            СтрокаХода = СтрокаХода + "  " + Строки[Индекс + 1];
        КонецЕсли;
        Части.Добавить(СтрокаХода);
        Индекс = Индекс + 2;
        Номер = Номер + 1;
    КонецЦикла;
    Возврат СтрСоединить(Части, Символы.ПС);

