#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ИграюБелыми = Истина;
    Глубина = 3;
    ИдетРасчет = Ложь;
    ЭхоКлетка = -1;
    ВыбраннаяКлетка = -1;
    ПоследнийОткуда = -1;
    ПоследнийКуда = -1;
    ПартияОкончена = Ложь;
    ХодовИгрока = 0;
    НоваяПартияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

    ЭхоКлетка = -1;
    ПродолжитьРасчет();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДоскаПриАктивизации(Элемент)

    Если ПартияОкончена Или ИдетРасчет Тогда
        Возврат;
    КонецЕсли;

    Область = Элемент.ТекущаяОбласть;
    Если Область = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Если Область.Верх <> Область.Низ Или Область.Лево <> Область.Право Тогда
        Возврат;
    КонецЕсли;

    Клетка = КлеткаПоСтрокеКолонке(Область.Верх, Область.Лево);
    Если Клетка < 0 Тогда
        Возврат;
    КонецЕсли;
    Если Клетка = ЭхоКлетка Тогда
        ЭхоКлетка = -1;
        Возврат;
    КонецЕсли;

    ЭхоКлетка = Клетка;
    Если ОбработатьКлеткуНаСервере(Клетка) Тогда
        ПродолжитьРасчет();
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НоваяПартия(Команда)

    Если ИдетРасчет Тогда
        Возврат;
    КонецЕсли;

    ЭхоКлетка = -1;
    НоваяПартияНаСервере();
    ПродолжитьРасчет();

КонецПроцедуры

&НаКлиенте
Процедура ХодНазад(Команда)

    Если ИдетРасчет Тогда
        Возврат;
    КонецЕсли;

    ЭхоКлетка = -1;
    ХодНазадНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СделатьХод(Команда)

    Если ИдетРасчет Тогда
        Возврат;
    КонецЕсли;

    ЭхоКлетка = -1;
    Если СделатьХодНаСервере() Тогда
        ПродолжитьРасчет();
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция КлеткаПоСтрокеКолонке(НомерСтроки, НомерКолонки)

    // Доска занимает строки 1-8 и колонки 2-9. a1 - правый нижний угол для белых.
    Если НомерКолонки < 2 Или НомерКолонки > 9 Или НомерСтроки < 1 Или НомерСтроки > 8 Тогда
        Возврат -1;
    КонецЕсли;

    Файл = НомерКолонки - 2;
    Ранг = 8 - НомерСтроки;
    Возврат Файл + Ранг * 8;

КонецФункции

&НаКлиенте
Процедура ПродолжитьРасчет()

    Если Не ИдетРасчет Тогда
        Возврат;
    КонецЕсли;

    ПодключитьОбработчикОжидания("ШагРасчетаКлиент", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ШагРасчетаКлиент()

    Если Не ИдетРасчет Тогда
        Возврат;
    КонецЕсли;

    Если ШагРасчетаНаСервере() Тогда
        ПродолжитьРасчет();
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НоваяПартияНаСервере()

    Если ИграюБелыми Тогда
        СторонаИгрока = 1;
    Иначе
        СторонаИгрока = -1;
    КонецЕсли;

    Глубина = ГлубинаРасчета();
    Поз = РазобратьПозицию(СтартоваяПозиция());
    СписокПозиций = "";
    Нотации = "";
    История = "";
    ХодовИгрока = 0;
    ВыбраннаяКлетка = -1;
    ПоследнийОткуда = -1;
    ПоследнийКуда = -1;
    ПартияОкончена = Ложь;
    ОткудаТекст = "";
    КудаТекст = "";
    ДобавитьПозициюВСписок(Поз);
    Позиция = ЗаписатьПозицию(Поз);
    ИдетРасчет = Ложь;

    Если СторонаИгрока < 0 Тогда
        Статус = "Компьютер играет белыми и выбирает первый ход.";
        ОтрисоватьДоску();
        НачатьРасчетКомпьютера();
    Иначе
        Статус = "Ваш ход белыми. Кликните свою фигуру, затем клетку хода.";
        УстановитьДоступностьПартии(Истина);
        ОтрисоватьДоску();
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ХодНазадНаСервере()

    Если ХодовИгрока <= 0 Тогда
        Статус = "Отменять пока нечего.";
        Возврат;
    КонецЕсли;

    СтрокиПозиций = СтрокиСписка(СписокПозиций);
    СтрокиНотаций = СтрокиСписка(Нотации);
    Если СтрокиПозиций.Количество() <= 1 Тогда
        Статус = "Отменять пока нечего.";
        Возврат;
    КонецЕсли;

    ТекущаяСторона = СторонаИзЗаписи(СтрокиПозиций[СтрокиПозиций.Количество() - 1]);
    СколькоУдалить = 1;
    Если ТекущаяСторона = СторонаИгрока Тогда
        Если СтрокиПозиций.Количество() <= 2 И СторонаИзЗаписи(СтрокиПозиций[0]) <> СторонаИгрока Тогда
            Статус = "Отменять пока нечего.";
            Возврат;
        КонецЕсли;
        СколькоУдалить = 2;
    КонецЕсли;

    СтрокиПозиций = ОставитьНачало(СтрокиПозиций, СтрокиПозиций.Количество() - СколькоУдалить, 1);
    СтрокиНотаций = ОставитьНачало(СтрокиНотаций, СтрокиНотаций.Количество() - СколькоУдалить, 0);
    СписокПозиций = СтрСоединить(СтрокиПозиций, Символы.ПС);
    Нотации = СтрСоединить(СтрокиНотаций, Символы.ПС);
    История = ТекстИстории(Нотации);
    Позиция = СтрокиПозиций[СтрокиПозиций.Количество() - 1];
    ХодовИгрока = ХодовИгрока - 1;
    ВыбраннаяКлетка = -1;
    ПоследнийОткуда = -1;
    ПоследнийКуда = -1;
    ПартияОкончена = Ложь;

    Поз = РазобратьПозицию(Позиция);
    Итог = ИтогПартии(Поз);
    Если Итог.Окончена Тогда
        ПартияОкончена = Истина;
        Статус = Итог.Текст;
    ИначеЕсли Итог.Шах Тогда
        Статус = "Ход отменен. Шах. Ваш ход.";
    Иначе
        Статус = "Ход отменен. Ваш ход.";
    КонецЕсли;
    ОтрисоватьДоску();

КонецПроцедуры

&НаСервере
Функция СделатьХодНаСервере()

    Если ПартияОкончена Тогда
        Статус = "Партия уже закончена. Начните новую.";
        Возврат Ложь;
    КонецЕсли;

    Откуда = КлеткаИзИмени(НормализоватьИмяКлетки(ОткудаТекст));
    Куда = КлеткаИзИмени(НормализоватьИмяКлетки(КудаТекст));
    Если Откуда < 0 Или Куда < 0 Тогда
        Статус = "Укажите клетки латиницей, например e2 и e4.";
        Возврат Ложь;
    КонецЕсли;

    Поз = РазобратьПозицию(Позиция);
    Если Поз.Сторона <> СторонаИгрока Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Не ФигурыОднойСтороны(Поз.Доска[Откуда], СторонаИгрока) Тогда
        Статус = "На клетке " + ИмяКлетки(Откуда) + " нет вашей фигуры.";
        Возврат Ложь;
    КонецЕсли;

    ТекущийХод = НайтиХодМежду(ЛегальныеХоды(Поз), Откуда, Куда);
    Если ТекущийХод < 0 Тогда
        Статус = "Так ходить нельзя.";
        Возврат Ложь;
    КонецЕсли;

    ОткудаТекст = "";
    КудаТекст = "";
    Возврат ЗавершитьХодИгрока(Поз, ТекущийХод);

КонецФункции

&НаСервере
Функция ОбработатьКлеткуНаСервере(Клетка)

    Если ПартияОкончена Тогда
        Возврат Ложь;
    КонецЕсли;

    Поз = РазобратьПозицию(Позиция);
    Если Поз.Сторона <> СторонаИгрока Тогда
        Возврат Ложь;
    КонецЕсли;

    Если ФигурыОднойСтороны(Поз.Доска[Клетка], СторонаИгрока) Тогда
        ВыбраннаяКлетка = Клетка;
        Статус = "Выбрано " + ИмяКлетки(Клетка) + ". Кликните зеленую клетку.";
        ОтрисоватьДоску();
        Возврат Ложь;
    КонецЕсли;

    Если ВыбраннаяКлетка < 0 Тогда
        Статус = "Сначала выберите свою фигуру.";
        Возврат Ложь;
    КонецЕсли;

    ТекущийХод = НайтиХодМежду(ЛегальныеХоды(Поз), ВыбраннаяКлетка, Клетка);
    Если ТекущийХод < 0 Тогда
        Статус = "Так ходить нельзя.";
        Возврат Ложь;
    КонецЕсли;

    Возврат ЗавершитьХодИгрока(Поз, ТекущийХод);

КонецФункции

// Описание: Применяет ход игрока и запускает пошаговый расчет ответа компьютера
//
// Параметры:
// Поз - Структура - текущая позиция, сторона хода совпадает со стороной игрока
// ТекущийХод - Число - упакованный ход
//
// Возвращаемое значение:
// Булево - Истина, если компьютер начал выбирать ход
//
&НаСервере
Функция ЗавершитьХодИгрока(Поз, ТекущийХод)

    ТекстИгрока = ТекстХода(Поз, ТекущийХод);
    ВыполнитьХод(Поз, ТекущийХод);
    ТекстИгрока = ТекстИгрока + СуффиксШах(Поз);
    ДобавитьНотацию(ТекстИгрока);
    ДобавитьПозициюВСписок(Поз);
    ХодовИгрока = ХодовИгрока + 1;
    ВыбраннаяКлетка = -1;
    ЗапомнитьПоследнийХод(ТекущийХод);
    Позиция = ЗаписатьПозицию(Поз);

    Итог = ИтогПартии(Поз);
    Если Итог.Окончена Тогда
        ЗавершитьПартию(Поз, Итог.Текст);
        Возврат Ложь;
    КонецЕсли;

    ОтрисоватьДоску();
    Возврат НачатьРасчетКомпьютера();

КонецФункции

// Описание: Готовит список ходов компьютера. Сам перебор идет отдельными шагами, чтобы форма обновляла полоску
//
// Возвращаемое значение:
// Булево - Истина, если расчет запущен
//
&НаСервере
Функция НачатьРасчетКомпьютера()

    Поз = РазобратьПозицию(Позиция);
    Ходы = ЛегальныеХоды(Поз);
    Если Ходы.Количество() = 0 Тогда
        Итог = ИтогПартии(Поз);
        ЗавершитьПартию(Поз, Итог.Текст);
        Возврат Ложь;
    КонецЕсли;

    УпорядочитьХоды(Поз.Доска, Ходы);
    ХодыРасчета = УпаковатьСписокХодов(Ходы);
    ИндексРасчета = 0;
    ЛучшийХодРасчета = Ходы[0];
    ЛучшаяОценкаРасчета = -999999;
    АльфаРасчета = -999999;
    ПрогрессРасчета = 0;
    ИдетРасчет = Истина;
    Статус = "Компьютер думает: 0 из " + Формат(Ходы.Количество(), "ЧГ=0");
    УстановитьДоступностьПартии(Ложь);
    Возврат Истина;

КонецФункции

// Описание: Проверяет один ход компьютера и сдвигает полоску расчета
//
// Возвращаемое значение:
// Булево - Истина, если остались непроверенные ходы
//
&НаСервере
Функция ШагРасчетаНаСервере()

    Если Не ИдетРасчет Тогда
        Возврат Ложь;
    КонецЕсли;

    Ходы = РаспаковатьСписокХодов(ХодыРасчета);
    Если ИндексРасчета >= Ходы.Количество() Тогда
        ЗакончитьРасчетКомпьютера();
        Возврат Ложь;
    КонецЕсли;

    Поз = РазобратьПозицию(Позиция);
    ТекущийХод = Ходы[ИндексРасчета];
    Отмена = ВыполнитьХод(Поз, ТекущийХод);
    ОценкаХода = -Негамакс(Поз, ГлубинаРасчета() - 1, -999999, -АльфаРасчета, 1);
    ОткатитьХод(Поз, Отмена);

    Если ОценкаХода > ЛучшаяОценкаРасчета Тогда
        ЛучшаяОценкаРасчета = ОценкаХода;
        ЛучшийХодРасчета = ТекущийХод;
    КонецЕсли;
    Если ОценкаХода > АльфаРасчета Тогда
        АльфаРасчета = ОценкаХода;
    КонецЕсли;

    ИндексРасчета = ИндексРасчета + 1;
    ПрогрессРасчета = Цел(ИндексРасчета * 100 / Ходы.Количество());
    Статус = "Компьютер думает: " + Формат(ИндексРасчета, "ЧГ=0")
        + " из " + Формат(Ходы.Количество(), "ЧГ=0");

    Если ИндексРасчета >= Ходы.Количество() Тогда
        ЗакончитьРасчетКомпьютера();
        Возврат Ложь;
    КонецЕсли;

    Возврат Истина;

КонецФункции

&НаСервере
Процедура ЗакончитьРасчетКомпьютера()

    ИдетРасчет = Ложь;
    Поз = РазобратьПозицию(Позиция);
    ХодКомпьютера = ЛучшийХодРасчета;
    Если ХодКомпьютера < 0 Тогда
        Итог = ИтогПартии(Поз);
        ЗавершитьПартию(Поз, Итог.Текст);
        УстановитьДоступностьПартии(Истина);
        Возврат;
    КонецЕсли;

    ТекстОтвета = ТекстХода(Поз, ХодКомпьютера);
    ВыполнитьХод(Поз, ХодКомпьютера);
    ТекстОтвета = ТекстОтвета + СуффиксШах(Поз);
    ДобавитьНотацию(ТекстОтвета);
    ДобавитьПозициюВСписок(Поз);
    ЗапомнитьПоследнийХод(ХодКомпьютера);

    Итог = ИтогПартии(Поз);
    Позиция = ЗаписатьПозицию(Поз);
    Если Итог.Окончена Тогда
        ПартияОкончена = Истина;
        Статус = Итог.Текст + " Последний ход: " + ТекстОтвета;
    ИначеЕсли Итог.Шах Тогда
        Статус = "Шах. Ваш ход. Компьютер: " + ТекстОтвета;
    Иначе
        Статус = "Ваш ход. Компьютер: " + ТекстОтвета;
    КонецЕсли;
    УстановитьДоступностьПартии(Истина);
    ОтрисоватьДоску();

КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПартии(Доступно)

    Элементы.Доска.Доступность = Доступно;
    Элементы.НоваяПартия.Доступность = Доступно;
    Элементы.ХодНазад.Доступность = Доступно;
    Элементы.СделатьХодКнопка.Доступность = Доступно;
    Элементы.ОткудаТекст.Доступность = Доступно;
    Элементы.КудаТекст.Доступность = Доступно;
    Элементы.Глубина.Доступность = Доступно;
    Элементы.ИграюБелыми.Доступность = Доступно;
    Элементы.ИндикаторРасчета.Видимость = Не Доступно;

КонецПроцедуры

&НаСервере
Функция УпаковатьСписокХодов(Ходы)

    Части = Новый Массив;
    Для Каждого ТекущийХод Из Ходы Цикл
        Части.Добавить(Формат(ТекущийХод, "ЧГ=0"));
    КонецЦикла;
    Возврат СтрСоединить(Части, ",");

КонецФункции

&НаСервере
Функция РаспаковатьСписокХодов(Текст)

    Результат = Новый Массив;
    Если Не ЗначениеЗаполнено(Текст) Тогда
        Возврат Результат;
    КонецЕсли;

    Части = СтрРазделить(Текст, ",", Ложь);
    Для Каждого Часть Из Части Цикл
        Результат.Добавить(Число(СокрЛП(Часть)));
    КонецЦикла;
    Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗавершитьПартию(Поз, Текст)

    ПартияОкончена = Истина;
    ВыбраннаяКлетка = -1;
    Позиция = ЗаписатьПозицию(Поз);
    Статус = Текст;
    ОтрисоватьДоску();

КонецПроцедуры

&НаСервере
Процедура ЗапомнитьПоследнийХод(ТекущийХод)

    ПоследнийОткуда = ОткудаХода(ТекущийХод);
    ПоследнийКуда = КудаХода(ТекущийХод);

КонецПроцедуры

&НаСервере
Процедура ДобавитьНотацию(Текст)

    Если Не ЗначениеЗаполнено(Нотации) Тогда
        Нотации = Текст;
    Иначе
        Нотации = Нотации + Символы.ПС + Текст;
    КонецЕсли;
    История = ТекстИстории(Нотации);

КонецПроцедуры

&НаСервере
Процедура ДобавитьПозициюВСписок(Поз)

    Запись = ЗаписатьПозицию(Поз);
    Позиция = Запись;
    Если Не ЗначениеЗаполнено(СписокПозиций) Тогда
        СписокПозиций = Запись;
    Иначе
        СписокПозиций = СписокПозиций + Символы.ПС + Запись;
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ГлубинаРасчета()

    Значение = Глубина;
    Если Не ЗначениеЗаполнено(Значение) Тогда
        Возврат 3;
    КонецЕсли;

    Значение = Цел(Значение);
    Если Значение < 1 Тогда
        Возврат 1;
    ИначеЕсли Значение > 3 Тогда
        Возврат 3;
    КонецЕсли;
    Возврат Значение;

КонецФункции

&НаСервере
Функция ИтогПартии(Поз)

    Итог = Новый Структура;
    Итог.Вставить("Окончена", Ложь);
    Итог.Вставить("Шах", Ложь);
    Итог.Вставить("Текст", "");

    Если Поз.Полуход >= 100 Тогда
        Итог.Окончена = Истина;
        Итог.Текст = "Ничья: 50 ходов без взятий и ходов пешек.";
        Возврат Итог;
    КонецЕсли;
    Если НедостаточноФигур(Поз.Доска) Тогда
        Итог.Окончена = Истина;
        Итог.Текст = "Ничья: недостаточно фигур для мата.";
        Возврат Итог;
    КонецЕсли;
    Если КоличествоПовторов() >= 3 Тогда
        Итог.Окончена = Истина;
        Итог.Текст = "Ничья: троекратное повторение позиции.";
        Возврат Итог;
    КонецЕсли;

    Ходы = ЛегальныеХоды(Поз);
    Король = НайтиКороля(Поз.Доска, Поз.Сторона);
    ПодШахом = Король >= 0 И КлеткаПодБоем(Поз.Доска, Король, -Поз.Сторона);
    Если Ходы.Количество() = 0 Тогда
        Итог.Окончена = Истина;
        Если ПодШахом Тогда
            Если Поз.Сторона > 0 Тогда
                Итог.Текст = "Мат. Победили черные.";
            Иначе
                Итог.Текст = "Мат. Победили белые.";
            КонецЕсли;
        Иначе
            Итог.Текст = "Пат. Ничья.";
        КонецЕсли;
        Возврат Итог;
    КонецЕсли;

    Итог.Шах = ПодШахом;
    Если ПодШахом Тогда
        Итог.Текст = "Шах.";
    КонецЕсли;
    Возврат Итог;

КонецФункции

