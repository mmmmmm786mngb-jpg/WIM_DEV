&НаСервере
Функция СтрокиСписка(Текст)

    Результат = Новый Массив;
    Если Не ЗначениеЗаполнено(Текст) Тогда
        Возврат Результат;
    КонецЕсли;

    Части = СтрРазделить(Текст, Символы.ПС, Ложь);
    Для Каждого Часть Из Части Цикл
        Если ЗначениеЗаполнено(СокрЛП(Часть)) Тогда
            Результат.Добавить(СокрЛП(Часть));
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;

КонецФункции

&НаСервере
Функция ОставитьНачало(Строки, КоличествоЭлементов, Минимум)

    Если КоличествоЭлементов < Минимум Тогда
        КоличествоЭлементов = Минимум;
    КонецЕсли;
    Если КоличествоЭлементов > Строки.Количество() Тогда
        КоличествоЭлементов = Строки.Количество();
    КонецЕсли;

    Результат = Новый Массив;
    Индекс = 0;
    Пока Индекс < КоличествоЭлементов Цикл
        Результат.Добавить(Строки[Индекс]);
        Индекс = Индекс + 1;
    КонецЦикла;
    Возврат Результат;

КонецФункции

