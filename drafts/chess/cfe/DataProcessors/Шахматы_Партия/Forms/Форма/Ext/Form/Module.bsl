// Описание: Разбирает запись FEN в структуру позиции
//
// Параметры:
// СтрокаПозиции - Строка - запись FEN
//
// Возвращаемое значение:
// Структура - доска из 64 чисел, сторона хода, рокировки, проходное поле и счетчики
//
&НаСервереБезКонтекста
Функция РазобратьПозицию(СтрокаПозиции)

    Поз = НоваяПозиция();
    Части = СтрРазделить(СокрЛП(СтрокаПозиции), " ", Ложь);
    Если Части.Количество() < 4 Тогда
        Возврат Поз;
    КонецЕсли;

    Ряды = СтрРазделить(Части[0], "/", Ложь);
    КлеткаРанга = 56;
    Для Каждого Ряд Из Ряды Цикл
        Указатель = КлеткаРанга;
        Длина = СтрДлина(Ряд);
        Для Номер = 1 По Длина Цикл
            СимволФигуры = Сред(Ряд, Номер, 1);
            Код = КодСимвола(СимволФигуры);
            Если Код >= КодСимвола("1") И Код <= КодСимвола("8") Тогда
                Указатель = Указатель + (Код - КодСимвола("0"));
            Иначе
                Поз.Доска[Указатель] = КодФигурыИзСимвола(СимволФигуры);
                Указатель = Указатель + 1;
            КонецЕсли;
        КонецЦикла;
        КлеткаРанга = КлеткаРанга - 8;
    КонецЦикла;

    Если Части[1] = "b" Тогда
        Поз.Сторона = -1;
    Иначе
        Поз.Сторона = 1;
    КонецЕсли;

    Права = Части[2];
    Поз.БелаяКороткая = СтрНайти(Права, "K") > 0;
    Поз.БелаяДлинная = СтрНайти(Права, "Q") > 0;
    Поз.ЧернаяКороткая = СтрНайти(Права, "k") > 0;
    Поз.ЧернаяДлинная = СтрНайти(Права, "q") > 0;
    Поз.Проход = КлеткаИзИмени(Части[3]);
    Если Части.Количество() > 4 Тогда
        Поз.Полуход = Число(Части[4]);
    КонецЕсли;
    Если Части.Количество() > 5 Тогда
        Поз.НомерХода = Число(Части[5]);
    КонецЕсли;
    Возврат Поз;

КонецФункции

// Описание: Записывает позицию в FEN
//
// Параметры:
// Поз - Структура - позиция партии
//
// Возвращаемое значение:
// Строка - запись FEN
//
&НаСервереБезКонтекста
Функция ЗаписатьПозицию(Поз)

    Ряды = Новый Массив;
    Для НомерРяда = 0 По 7 Цикл
        Ранг = 7 - НомерРяда;
        Пустых = 0;
        ТекстРяда = "";
        Для Файл = 0 По 7 Цикл
            Фигура = Поз.Доска[ИндексКлетки(Файл, Ранг)];
            Если Фигура = 0 Тогда
                Пустых = Пустых + 1;
            Иначе
                Если Пустых > 0 Тогда
                    ТекстРяда = ТекстРяда + Формат(Пустых, "ЧГ=0");
                    Пустых = 0;
                КонецЕсли;
                ТекстРяда = ТекстРяда + СимволФигуры(Фигура);
            КонецЕсли;
        КонецЦикла;
        Если Пустых > 0 Тогда
            ТекстРяда = ТекстРяда + Формат(Пустых, "ЧГ=0");
        КонецЕсли;
        Ряды.Добавить(ТекстРяда);
    КонецЦикла;

    Права = "";
    Если Поз.БелаяКороткая Тогда
        Права = Права + "K";
    КонецЕсли;
    Если Поз.БелаяДлинная Тогда
        Права = Права + "Q";
    КонецЕсли;
    Если Поз.ЧернаяКороткая Тогда
        Права = Права + "k";
    КонецЕсли;
    Если Поз.ЧернаяДлинная Тогда
        Права = Права + "q";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Права) Тогда
        Права = "-";
    КонецЕсли;

    Если Поз.Проход < 0 Тогда
        ТекстПрохода = "-";
    Иначе
        ТекстПрохода = ИмяКлетки(Поз.Проход);
    КонецЕсли;
    Если Поз.Сторона > 0 Тогда
        ТекстСтороны = "w";
    Иначе
        ТекстСтороны = "b";
    КонецЕсли;

    Возврат СтрСоединить(Ряды, "/") + " " + ТекстСтороны + " " + Права + " " + ТекстПрохода
        + " " + Формат(Поз.Полуход, "ЧГ=0") + " " + Формат(Поз.НомерХода, "ЧГ=0");

КонецФункции

&НаСервереБезКонтекста
Функция НоваяПозиция()

    ДоскаПартии = Новый Массив(64);
    Для Индекс = 0 По 63 Цикл
        ДоскаПартии[Индекс] = 0;
    КонецЦикла;

    Поз = Новый Структура;
    Поз.Вставить("Доска", ДоскаПартии);
    Поз.Вставить("Сторона", 1);
    Поз.Вставить("БелаяКороткая", Ложь);
    Поз.Вставить("БелаяДлинная", Ложь);
    Поз.Вставить("ЧернаяКороткая", Ложь);
    Поз.Вставить("ЧернаяДлинная", Ложь);
    Поз.Вставить("Проход", -1);
    Поз.Вставить("Полуход", 0);
    Поз.Вставить("НомерХода", 1);
    Возврат Поз;

КонецФункции

&НаСервереБезКонтекста
Функция КодФигурыИзСимвола(СимволФигуры)

    Если СимволФигуры = "P" Тогда
        Возврат 1;
    ИначеЕсли СимволФигуры = "N" Тогда
        Возврат 2;
    ИначеЕсли СимволФигуры = "B" Тогда
        Возврат 3;
    ИначеЕсли СимволФигуры = "R" Тогда
        Возврат 4;
    ИначеЕсли СимволФигуры = "Q" Тогда
        Возврат 5;
    ИначеЕсли СимволФигуры = "K" Тогда
        Возврат 6;
    ИначеЕсли СимволФигуры = "p" Тогда
        Возврат -1;
    ИначеЕсли СимволФигуры = "n" Тогда
        Возврат -2;
    ИначеЕсли СимволФигуры = "b" Тогда
        Возврат -3;
    ИначеЕсли СимволФигуры = "r" Тогда
        Возврат -4;
    ИначеЕсли СимволФигуры = "q" Тогда
        Возврат -5;
    ИначеЕсли СимволФигуры = "k" Тогда
        Возврат -6;
    КонецЕсли;
    Возврат 0;

КонецФункции

&НаСервереБезКонтекста
Функция СимволФигуры(Фигура)

    Тип = ?(Фигура > 0, Фигура, -Фигура);
    Если Тип = 1 Тогда
        Буква = "P";
    ИначеЕсли Тип = 2 Тогда
        Буква = "N";
    ИначеЕсли Тип = 3 Тогда
        Буква = "B";
    ИначеЕсли Тип = 4 Тогда
        Буква = "R";
