{
  "title": "Шахматы",
  "properties": {
    "autoTitle": false,
    "width": 102
  },
  "events": {
    "OnCreateAtServer": "ПриСозданииНаСервере",
    "OnOpen": "ПриОткрытии"
  },
  "elements": [
    {
      "autoCmdBar": "ФормаКоманднаяПанель",
      "children": [
        { "button": "НоваяПартия", "command": "НоваяПартия" },
        { "button": "ХодНазад", "command": "ХодНазад" },
        { "button": "Закрыть", "stdCommand": "Close" }
      ]
    },
    {
      "group": "alwaysHorizontal",
      "name": "ГруппаОсновная",
      "horizontalStretch": true,
      "verticalStretch": true,
      "children": [
        {
          "spreadsheet": "Доска",
          "path": "Доска",
          "titleLocation": "none",
          "readOnly": true,
          "protection": false,
          "showGrid": false,
          "showHeaders": false,
          "output": "Disable",
          "selectionShowMode": "DontShow",
          "width": 54,
          "height": 16,
          "horizontalStretch": true,
          "verticalStretch": true,
          "events": { "OnActivate": "ДоскаПриАктивизации" }
        },
        {
          "group": "vertical",
          "name": "ГруппаПартия",
          "title": "Партия",
          "width": 38,
          "verticalStretch": true,
          "children": [
            {
              "input": "Статус",
              "path": "Статус",
              "titleLocation": "none",
              "readOnly": true,
              "multiLine": true,
              "height": 3,
              "horizontalStretch": true
            },
            { "check": "ИграюБелыми", "path": "ИграюБелыми", "title": "Я играю белыми" },
            { "input": "Глубина", "path": "Глубина", "title": "Глубина расчета", "width": 6 },
            {
              "label": "ПодсказкаГлубины",
              "title": "2 отвечает быстро. 3 играет сильнее и думает дольше.",
              "maxWidth": 36
            },
            {
              "group": "alwaysHorizontal",
              "name": "ГруппаХодВручную",
              "title": "Ход с клавиатуры",
              "children": [
                { "input": "ОткудаТекст", "path": "ОткудаТекст", "title": "Откуда", "width": 4 },
                { "input": "КудаТекст", "path": "КудаТекст", "title": "Куда", "width": 4 },
                { "button": "СделатьХодКнопка", "command": "СделатьХод", "title": "Ходить" }
              ]
            },
            {
              "label": "ЛегендаФигур",
              "title": "Белые: Кр Ф Л С К П. Черные: кр ф л с к п. Желтая клетка - выбранная фигура, зеленая - возможный ход.",
              "maxWidth": 36,
              "height": 3
            },
            {
              "input": "История",
              "path": "История",
              "title": "Запись партии",
              "readOnly": true,
              "multiLine": true,
              "height": 12,
              "horizontalStretch": true,
              "verticalStretch": true
            }
          ]
        }
      ]
    }
  ],
  "attributes": [
    { "name": "Объект", "type": "ExternalDataProcessorObject.Шахматы", "main": true },
    { "name": "Доска", "type": "mxl:SpreadsheetDocument" },
    { "name": "Статус", "type": "string", "title": "Статус" },
    { "name": "История", "type": "string", "title": "Запись партии" },
    { "name": "ИграюБелыми", "type": "boolean", "title": "Я играю белыми" },
    { "name": "Глубина", "type": "decimal(2,0)", "title": "Глубина расчета" },
    { "name": "ОткудаТекст", "type": "string(2)", "title": "Откуда" },
    { "name": "КудаТекст", "type": "string(2)", "title": "Куда" },
    { "name": "Позиция", "type": "string" },
    { "name": "СписокПозиций", "type": "string" },
    { "name": "Нотации", "type": "string" },
    { "name": "ВыбраннаяКлетка", "type": "decimal(10,0)" },
    { "name": "ПоследнийОткуда", "type": "decimal(10,0)" },
    { "name": "ПоследнийКуда", "type": "decimal(10,0)" },
    { "name": "ПартияОкончена", "type": "boolean" },
    { "name": "СторонаИгрока", "type": "decimal(2,0)" },
    { "name": "ХодовИгрока", "type": "decimal(10,0)" },
    { "name": "ЭхоКлетка", "type": "decimal(10,0)" }
  ],
  "commands": [
    { "name": "НоваяПартия", "action": "НоваяПартия", "title": "Новая партия", "shortcut": "F5" },
    { "name": "ХодНазад", "action": "ХодНазад", "title": "Ход назад" },
    { "name": "СделатьХод", "action": "СделатьХод", "title": "Ходить" }
  ]
}
