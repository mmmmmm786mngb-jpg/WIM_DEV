    Возврат "МестаРождения";
КонецФункции

Функция КлючНастройки()
    Возврат "Таблица";
КонецФункции

Функция ИмяОбщейНастройки()
    Возврат "Общие";
КонецФункции

Функция НовыеДанные()

    ДанныеНастроек = Новый Структура;
    ДанныеНастроек.Вставить("Регионы", ТаблицаРегионов());
    ДанныеНастроек.Вставить("Места", ТаблицаПримеров());
    Возврат ДанныеНастроек;

КонецФункции

Функция СтрокаМеста(Идентификатор)

    Если Не ЗначениеЗаполнено(Идентификатор) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат СтрокаМестаВТаблице(Данные().Места, Идентификатор);

КонецФункции

Функция СтрокаРегиона(Регионы, КодРегиона)

    Если Не ЗначениеЗаполнено(КодРегиона) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Найденные = Регионы.НайтиСтроки(Новый Структура("Код", КодРегиона));
    Если Найденные.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Найденные[0];

КонецФункции

Функция СтрокаМестаВТаблице(Места, Идентификатор)

    Если Не ЗначениеЗаполнено(Идентификатор) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Найденные = Места.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
    Если Найденные.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Найденные[0];

КонецФункции

