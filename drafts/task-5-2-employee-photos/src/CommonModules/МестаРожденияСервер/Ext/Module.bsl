// Таблица мест рождения и субъектов России.
// Это не справочник: обе таблицы лежат одной структурой в хранилище общих настроек.
// У сотрудника хранится только идентификатор строки.

#Область ПрограммныйИнтерфейс

// Описание: Готовит таблицы мест и регионов и возвращает их из хранилища настроек.
// При первом обращении записывает субъекты России и несколько городов.
//
// Возвращаемое значение:
// Структура - ключи Места и Регионы, в каждом таблица значений.
//
Функция Данные() Экспорт

    ДанныеНастроек = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта(), КлючНастройки(), , ИмяОбщейНастройки());
    Если ТипЗнч(ДанныеНастроек) <> Тип("Структура")
        Или Не ДанныеНастроек.Свойство("Места")
        Или Не ДанныеНастроек.Свойство("Регионы") Тогда
        ДанныеНастроек = НовыеДанные();
        СохранитьДанные(ДанныеНастроек);
    КонецЕсли;

    Возврат ДанныеНастроек;

КонецФункции

// Описание: Записывает структуру с таблицами мест и регионов в общее хранилище настроек.
//
// Параметры:
// ДанныеНастроек - Структура - ключи Места и Регионы.
//
Процедура СохранитьДанные(ДанныеНастроек) Экспорт

    ХранилищеОбщихНастроек.Сохранить(
        КлючОбъекта(),
        КлючНастройки(),
        ДанныеНастроек,
        "Места рождения",
        ИмяОбщейНастройки());

КонецПроцедуры

// Описание: Возвращает наименование места по идентификатору строки.
//
// Параметры:
// Идентификатор - Строка - идентификатор места рождения.
//
// Возвращаемое значение:
// Строка - наименование. Пустая строка, если строки уже нет.
//
Функция ПредставлениеМеста(Идентификатор) Экспорт

    СтрокаМеста = СтрокаМеста(Идентификатор);
    Если СтрокаМеста = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Возврат СтрокаМеста.Наименование;

КонецФункции

// Описание: Возвращает карточку места рождения.
//
// Параметры:
// Идентификатор - Строка - идентификатор места рождения.
//
// Возвращаемое значение:
// Структура, Неопределено - наименование, код региона, название региона и округ.
//
Функция КарточкаМеста(Идентификатор) Экспорт

    ДанныеНастроек = Данные();
    СтрокаМеста = СтрокаМестаВТаблице(ДанныеНастроек.Места, Идентификатор);
    Если СтрокаМеста = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    НазваниеРегиона = "";
    Округ = "";
    НайденныйРегион = СтрокаРегиона(ДанныеНастроек.Регионы, СтрокаМеста.КодРегиона);
    Если НайденныйРегион <> Неопределено Тогда
        НазваниеРегиона = НайденныйРегион.Наименование;
        Округ = НайденныйРегион.Округ;
    КонецЕсли;

    Карточка = Новый Структура;
    Карточка.Вставить("Идентификатор", СтрокаМеста.Идентификатор);
    Карточка.Вставить("Наименование", СтрокаМеста.Наименование);
    Карточка.Вставить("КодРегиона", СтрокаМеста.КодРегиона);
    Карточка.Вставить("Регион", НазваниеРегиона);
    Карточка.Вставить("Округ", Округ);
    Возврат Карточка;

КонецФункции

// Описание: Возвращает карточку субъекта России.
//
// Параметры:
// КодРегиона - Строка - код субъекта.
//
// Возвращаемое значение:
// Структура, Неопределено - код, наименование и федеральный округ.
//
Функция КарточкаРегиона(КодРегиона) Экспорт

    Если Не ЗначениеЗаполнено(КодРегиона) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Найденные = Данные().Регионы.НайтиСтроки(Новый Структура("Код", КодРегиона));
    Если Найденные.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;

    Карточка = Новый Структура;
    Карточка.Вставить("Код", Найденные[0].Код);
    Карточка.Вставить("Наименование", Найденные[0].Наименование);
    Карточка.Вставить("Округ", Найденные[0].Округ);
    Возврат Карточка;

КонецФункции

// Описание: Список субъектов для поля выбора на карточке места.
//
// Возвращаемое значение:
// ТаблицаЗначений - колонки Код и Наименование.
//
Функция СписокРегионов() Экспорт

    Возврат Данные().Регионы.Скопировать(, "Код, Наименование");

КонецФункции

// Описание: Список мест для формы, с названием региона в отдельной колонке.
//
// Возвращаемое значение:
// ТаблицаЗначений - идентификатор, наименование, код региона и название региона.
//
Функция ТаблицаМест() Экспорт

    ДанныеНастроек = Данные();
    Таблица = НоваяТаблицаМестДляСписка();
    Для Каждого СтрокаМеста Из ДанныеНастроек.Места Цикл
        НоваяСтрока = Таблица.Добавить();
        НоваяСтрока.Идентификатор = СтрокаМеста.Идентификатор;
        НоваяСтрока.Наименование = СтрокаМеста.Наименование;
        НоваяСтрока.КодРегиона = СтрокаМеста.КодРегиона;
        НайденныйРегион = СтрокаРегиона(ДанныеНастроек.Регионы, СтрокаМеста.КодРегиона);
        Если НайденныйРегион <> Неопределено Тогда
            НоваяСтрока.Регион = НайденныйРегион.Наименование;
        КонецЕсли;
    КонецЦикла;

    Таблица.Сортировать("Наименование");
    Возврат Таблица;

КонецФункции

// Описание: Записывает место рождения в таблицу настроек.
// Пустой идентификатор означает новую строку.
//
// Параметры:
// Идентификатор - Строка - идентификатор строки, может быть пустым.
// Наименование - Строка - как место показывается в списке.
// КодРегиона - Строка - код субъекта России.
//
// Возвращаемое значение:
// Строка - идентификатор записанной строки.
//
Функция ЗаписатьМесто(Идентификатор, Наименование, КодРегиона) Экспорт

    ДанныеНастроек = Данные();
    СтрокаМеста = СтрокаМестаВТаблице(ДанныеНастроек.Места, Идентификатор);
    Если СтрокаМеста = Неопределено Тогда
        СтрокаМеста = ДанныеНастроек.Места.Добавить();
        СтрокаМеста.Идентификатор = Строка(Новый УникальныйИдентификатор);
    КонецЕсли;

    СтрокаМеста.Наименование = СокрЛП(Наименование);
    СтрокаМеста.КодРегиона = СокрЛП(КодРегиона);
    СохранитьДанные(ДанныеНастроек);
    Возврат СтрокаМеста.Идентификатор;

КонецФункции

// Описание: Удаляет место рождения из таблицы настроек.
//
// Параметры:
// Идентификатор - Строка - идентификатор строки.
//
Процедура УдалитьМесто(Идентификатор) Экспорт

    ДанныеНастроек = Данные();
    СтрокаМеста = СтрокаМестаВТаблице(ДанныеНастроек.Места, Идентификатор);
    Если СтрокаМеста = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ДанныеНастроек.Места.Удалить(СтрокаМеста);
    СохранитьДанные(ДанныеНастроек);

КонецПроцедуры

// Описание: Проверяет, указано ли место хотя бы у одного сотрудника.
//
// Параметры:
// Идентификатор - Строка - идентификатор места рождения.
//
// Возвращаемое значение:
// Булево - Истина, если ссылка на строку есть в справочнике сотрудников.
//
Функция МестоУказаноУСотрудника(Идентификатор) Экспорт

    Если Не ЗначениеЗаполнено(Идентификатор) Тогда
        Возврат Ложь;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Сотрудники.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.Сотрудники КАК Сотрудники
    |ГДЕ
    |    Сотрудники.ИдентификаторМестаРождения = &Идентификатор";
    Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
    Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

