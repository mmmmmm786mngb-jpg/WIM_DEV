Функция ТаблицаРегионов()

    Таблица = НоваяТаблицаРегионов();
    Для Каждого СтрокаРегиона Из СтрРазделить(ТекстРегионов(), Символы.ПС, Ложь) Цикл
        Части = СтрРазделить(СокрЛП(СтрокаРегиона), ";");
        Если Части.Количество() < 3 Тогда
            Продолжить;
        КонецЕсли;
        НоваяСтрока = Таблица.Добавить();
        НоваяСтрока.Код = СокрЛП(Части[0]);
        НоваяСтрока.Наименование = СокрЛП(Части[1]);
        НоваяСтрока.Округ = СокрЛП(Части[2]);
    КонецЦикла;

    Таблица.Сортировать("Наименование");
    Возврат Таблица;

КонецФункции

