    Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
    Таблица.Колонки.Добавить("КодРегиона", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3)));
    Возврат Таблица;

