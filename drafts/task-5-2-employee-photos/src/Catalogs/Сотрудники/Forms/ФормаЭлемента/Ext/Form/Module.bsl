// Форма элемента справочника Сотрудники.
// Фотография хранится либо в реквизите Фотография (ХранилищеЗначения),
// либо файлом в каталоге константы КаталогФотографийСотрудников.
// На форме картинка живет по адресу временного хранилища и в объект попадает при записи.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Объект.Ссылка.Пустая()
        И Не ЗначениеЗаполнено(Объект.СпособХраненияФотографии) Тогда
        Объект.СпособХраненияФотографии = Перечисления.СпособыХраненияФотографий.ВИнформационнойБазе;
    КонецЕсли;

    Если Объект.Ссылка.Пустая() Тогда
        ИсходныйСпособХранения = Объект.СпособХраненияФотографии;
    КонецЕсли;

    КаталогФотографий = Константы.КаталогФотографийСотрудников.Получить();
    Если Объект.Ссылка.Пустая() Тогда
        АдресФотографии = АдресТекущейФотографии();
    КонецЕсли;
    УстановитьВидимостьХранения();
    МестоРожденияПредставление = МестаРожденияСервер.ПредставлениеМеста(Объект.ИдентификаторМестаРождения);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

    // Снимок состояния до правок пользователя: по нему решаем, перекладывать ли фото при записи.
    ИсходныйСпособХранения = ТекущийОбъект.СпособХраненияФотографии;
    ИмяФайлаПриЧтении = ТекущийОбъект.ИмяФайлаФотографии;
    РасширениеФайла = РасширениеИзИмениФайла(ТекущийОбъект.ИмяФайлаФотографии);
    ФотографияИзменена = Ложь;
    Если ТекущийОбъект.СпособХраненияФотографии = Перечисления.СпособыХраненияФотографий.ВКаталогеНаДиске Тогда
        АдресФотографии = АдресФотографииИзФайла(ТекущийОбъект.ИмяФайлаФотографии);
    Иначе
        АдресФотографии = АдресФотографииИзХранилища(ТекущийОбъект.Фотография);
    КонецЕсли;

КонецПроцедуры

// Описание: Перекладывает фотографию в выбранное место сохранения.
// В базу пишется хранилище значения, на диск - файл в каталоге константы.
// Прежний файл удаляется уже после успешной записи объекта.
//
// Параметры:
// Отказ - Булево - признак отказа от записи
// ТекущийОбъект - СправочникОбъект.Сотрудники - записываемый объект
// ПараметрыЗаписи - Структура - параметры записи; сюда кладется имя файла к удалению
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

    Если Отказ Тогда
        Возврат;
    КонецЕсли;

    Способ = ТекущийОбъект.СпособХраненияФотографии;
    Если Не ЗначениеЗаполнено(Способ) Тогда
        Способ = Перечисления.СпособыХраненияФотографий.ВИнформационнойБазе;
        ТекущийОбъект.СпособХраненияФотографии = Способ;
    КонецЕсли;

    СпособИзменился = Способ <> ИсходныйСпособХранения;
    Если Не ФотографияИзменена И Не СпособИзменился Тогда
        Возврат;
    КонецЕсли;

    ДанныеФото = ДвоичныеДанныеТекущейФотографии();
    ХранениеВФайле = Способ = Перечисления.СпособыХраненияФотографий.ВКаталогеНаДиске;

    Если ТипЗнч(ДанныеФото) <> Тип("ДвоичныеДанные") Тогда
        ТекущийОбъект.Фотография = ПустоеХранилище();
        ТекущийОбъект.ИмяФайлаФотографии = "";
        ЗапланироватьУдалениеФайла(ПараметрыЗаписи, ИмяФайлаПриЧтении);
        Возврат;
    КонецЕсли;

    Если ХранениеВФайле Тогда
        Если Не ЗаписатьФотографиюВФайл(ТекущийОбъект, ДанныеФото, ПараметрыЗаписи) Тогда
            Отказ = Истина;
        КонецЕсли;
        Возврат;
    КонецЕсли;

    ТекущийОбъект.Фотография = Новый ХранилищеЗначения(ДанныеФото, Новый СжатиеДанных(9));
    ТекущийОбъект.ИмяФайлаФотографии = "";
    ЗапланироватьУдалениеФайла(ПараметрыЗаписи, ИмяФайлаПриЧтении);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

    ИмяКУдалению = "";
    Если ПараметрыЗаписи.Свойство("ИмяФайлаКУдалению", ИмяКУдалению) Тогда
        УдалитьФайлФотографии(ИмяКУдалению);
    КонецЕсли;

    ИмяФайлаПриЧтении = ТекущийОбъект.ИмяФайлаФотографии;
    ИсходныйСпособХранения = ТекущийОбъект.СпособХраненияФотографии;
    РасширениеФайла = РасширениеИзИмениФайла(ТекущийОбъект.ИмяФайлаФотографии);
    ФотографияИзменена = Ложь;
    КаталогФотографий = Константы.КаталогФотографийСотрудников.Получить();
    УстановитьВидимостьХранения();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СпособХраненияФотографииПриИзменении(Элемент)
    СпособХраненияФотографииПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура МестоРожденияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    Оповещение = Новый ОписаниеОповещения("МестоРожденияВыборЗавершение", ЭтотОбъект);
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("РежимВыбора", Истина);
    ПараметрыФормы.Вставить("ТекущийИдентификатор", Объект.ИдентификаторМестаРождения);
    ОткрытьФорму(
        "ОбщаяФорма.СписокМестРождения",
        ПараметрыФормы,
        ЭтотОбъект,
        ,
        ,
        ,
        Оповещение,
        РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура МестоРожденияОчистка(Элемент, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    Объект.ИдентификаторМестаРождения = "";
    МестоРожденияПредставление = "";
    Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ФотографияНажатие(Элемент, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    НачатьВыборФайлаФотографии();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьФотографию(Команда)
    НачатьВыборФайлаФотографии();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьМестоРождения(Команда)

    Если Не ЗначениеЗаполнено(Объект.ИдентификаторМестаРождения) Тогда
        ПоказатьПредупреждение(, "Сначала выберите место рождения.");
        Возврат;
    КонецЕсли;

    ПараметрыФормы = Новый Структура("Идентификатор", Объект.ИдентификаторМестаРождения);
    Оповещение = Новый ОписаниеОповещения("МестоРожденияПослеКарточки", ЭтотОбъект);
    ОткрытьФорму(
        "ОбщаяФорма.МестоРождения",
        ПараметрыФормы,
        ЭтотОбъект,
        ,
        ,
        ,
        Оповещение,
        РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФотографию(Команда)

    АдресФотографии = "";
    РасширениеФайла = "";
    ФотографияИзменена = Истина;
    Модифицированность = Истина;

КонецПроцедуры

// Описание: Принимает файл, выбранный в диалоге, и показывает его в поле фотографии.
// Запись в базу или на диск выполняется позже, при сохранении сотрудника.
//
// Параметры:
// ОписаниеПомещенногоФайла - ОписаниеПомещенногоФайла, Неопределено - результат помещения файла
// ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура ЗагрузитьФотографиюЗавершение(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт

    Если ТипЗнч(ОписаниеПомещенногоФайла) <> Тип("ОписаниеПомещенногоФайла") Тогда
        Возврат;
    КонецЕсли;

    Если ОписаниеПомещенногоФайла.ПомещениеФайлаОтменено
        Или Не ЗначениеЗаполнено(ОписаниеПомещенногоФайла.Адрес) Тогда
        Возврат;
    КонецЕсли;

    АдресФотографии = ОписаниеПомещенногоФайла.Адрес;
    РасширениеФайла = НормализоватьРасширение(ОписаниеПомещенногоФайла.СсылкаНаФайл.Расширение);
    ФотографияИзменена = Истина;
    Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Записывает выбранное место рождения в реквизит сотрудника.
// Платформенной ссылки нет: в объект попадает идентификатор строки хранилища настроек.
//
// Параметры:
// Результат - Структура, Неопределено - идентификатор и наименование выбранной строки
// ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура МестоРожденияВыборЗавершение(Результат, ДополнительныеПараметры) Экспорт

    Если ТипЗнч(Результат) <> Тип("Структура") Тогда
        Возврат;
    КонецЕсли;

    Объект.ИдентификаторМестаРождения = Результат.Идентификатор;
    МестоРожденияПредставление = Результат.Наименование;
    Модифицированность = Истина;

КонецПроцедуры

// Описание: Обновляет наименование места, если его переименовали в карточке.
//
// Параметры:
// Результат - Структура, Неопределено - карточка после записи
// ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура МестоРожденияПослеКарточки(Результат, ДополнительныеПараметры) Экспорт

    Если ТипЗнч(Результат) <> Тип("Структура") Тогда
        МестоРожденияПредставление = ПредставлениеМестаРождения(Объект.ИдентификаторМестаРождения);
        Возврат;
    КонецЕсли;

    Объект.ИдентификаторМестаРождения = Результат.Идентификатор;
    МестоРожденияПредставление = Результат.Наименование;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеМестаРождения(Идентификатор)
    Возврат МестаРожденияСервер.ПредставлениеМеста(Идентификатор);
КонецФункции

&НаКлиенте
Процедура НачатьВыборФайлаФотографии()

    ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
    ПараметрыДиалога.Заголовок = "Выберите фотографию";
    ПараметрыДиалога.Фильтр = "Изображения (*.jpg;*.jpeg;*.png;*.gif;*.bmp)|*.jpg;*.jpeg;*.png;*.gif;*.bmp";
    ПараметрыДиалога.МножественныйВыбор = Ложь;

    Оповещение = Новый ОписаниеОповещения("ЗагрузитьФотографиюЗавершение", ЭтотОбъект);
    НачатьПомещениеФайлаНаСервер(Оповещение, , , , ПараметрыДиалога, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура СпособХраненияФотографииПриИзмененииНаСервере()

    КаталогФотографий = Константы.КаталогФотографийСотрудников.Получить();
    УстановитьВидимостьХранения();

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьХранения()

    ХранениеВФайле = Объект.СпособХраненияФотографии
        = Перечисления.СпособыХраненияФотографий.ВКаталогеНаДиске;
    Элементы.ГруппаФайл.Видимость = ХранениеВФайле;
    Элементы.ДекорацияКаталогНеЗадан.Видимость = ХранениеВФайле
        И Не ЗначениеЗаполнено(КаталогФотографий);

КонецПроцедуры

// Описание: Готовит адрес временного хранилища для поля картинки.
//
// Возвращаемое значение:
// Строка - адрес двоичных данных фотографии или пустая строка, если фото нет
//
&НаСервере
Функция АдресТекущейФотографии()

    Если Объект.СпособХраненияФотографии = Перечисления.СпособыХраненияФотографий.ВКаталогеНаДиске Тогда
        Возврат АдресФотографииИзФайла(Объект.ИмяФайлаФотографии);
    КонецЕсли;

    Возврат АдресФотографииИзХранилища(Объект.Фотография);

КонецФункции

&НаСервере
Функция АдресФотографииИзХранилища(Хранилище)

    Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
        Возврат "";
    КонецЕсли;

    Данные = Хранилище.Получить();
    Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
        Возврат "";
    КонецЕсли;
    Если Данные.Размер() = 0 Тогда
        Возврат "";
    КонецЕсли;

    Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Функция АдресФотографииИзФайла(ИмяФайла)

    Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
        Возврат "";
    КонецЕсли;

    Каталог = СокрЛП(Константы.КаталогФотографийСотрудников.Получить());
    Если Не ЗначениеЗаполнено(Каталог) Тогда
        СообщитьОшибку(
            "Файл фотографии не показан: не заполнена константа «Каталог фотографий сотрудников».",
            "ИмяФайлаФотографии");
        Возврат "";
    КонецЕсли;

    ПолныйПуть = ПолныйПутьФайла(Каталог, ИмяФайла);
    ФайлКартинки = Новый Файл(ПолныйПуть);
    Если Не ФайлКартинки.Существует() Или ФайлКартинки.ЭтоКаталог() Тогда
        СообщитьОшибку("Файл фотографии не найден: " + ПолныйПуть, "ИмяФайлаФотографии");
        Возврат "";
    КонецЕсли;

    Попытка
        Данные = Новый ДвоичныеДанные(ПолныйПуть);
    Исключение
        СообщитьОшибку(
            "Не удалось прочитать файл фотографии: " + ОписаниеОшибки(),
            "ИмяФайлаФотографии");
        Возврат "";
    КонецПопытки;

    Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Функция ДвоичныеДанныеТекущейФотографии()

    Если Не ЗначениеЗаполнено(АдресФотографии)
        Или Не ЭтоАдресВременногоХранилища(АдресФотографии) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Данные = ПолучитьИзВременногоХранилища(АдресФотографии);
    Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Данные.Размер() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Данные;

КонецФункции

// Описание: Записывает фотографию в каталог константы и очищает хранилище в объекте.
//
// Параметры:
// ТекущийОбъект - СправочникОбъект.Сотрудники - записываемый сотрудник
// ДанныеФото - ДвоичныеДанные - содержимое изображения
// ПараметрыЗаписи - Структура - параметры записи формы
//
// Возвращаемое значение:
// Булево - Истина, если файл записан
//
&НаСервере
Функция ЗаписатьФотографиюВФайл(ТекущийОбъект, ДанныеФото, ПараметрыЗаписи)

    Каталог = СокрЛП(Константы.КаталогФотографийСотрудников.Получить());
    Если Не ЗначениеЗаполнено(Каталог) Тогда
        СообщитьОшибку(
            "Укажите каталог фотографий в константе «Каталог фотографий сотрудников».",
            "СпособХраненияФотографии");
        Возврат Ложь;
    КонецЕсли;

    Если Не ОбеспечитьКаталог(Каталог, ТекущийОбъект.Ссылка) Тогда
        Возврат Ложь;
    КонецЕсли;

    // У снимка из базы нет исходного расширения: определяем его по содержимому.
    Если Не ЗначениеЗаполнено(РасширениеФайла) Тогда
        РасширениеФайла = РасширениеПоСодержимому(ДанныеФото);
    КонецЕсли;

    ИмяФайла = ИмяФайлаДляЗаписи();
    Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
        СообщитьОшибку("Не удалось сформировать имя файла фотографии.", "ИмяФайлаФотографии");
        Возврат Ложь;
    КонецЕсли;

    ПолныйПуть = ПолныйПутьФайла(Каталог, ИмяФайла);
    Попытка
        ДанныеФото.Записать(ПолныйПуть);
    Исключение
        ТекстОшибки = "Не удалось записать файл фотографии: " + ОписаниеОшибки();
        ЗаписьЖурналаРегистрации(
            "Сотрудники.Фотография",
            УровеньЖурналаРегистрации.Ошибка,
            Метаданные.Справочники.Сотрудники,
            ТекущийОбъект.Ссылка,
            ТекстОшибки);
        СообщитьОшибку(ТекстОшибки, "СпособХраненияФотографии");
        Возврат Ложь;
    КонецПопытки;

    ТекущийОбъект.ИмяФайлаФотографии = ИмяФайла;
    ТекущийОбъект.Фотография = ПустоеХранилище();

    Если ЗначениеЗаполнено(ИмяФайлаПриЧтении) И ИмяФайлаПриЧтении <> ИмяФайла Тогда
        ЗапланироватьУдалениеФайла(ПараметрыЗаписи, ИмяФайлаПриЧтении);
    КонецЕсли;

    Возврат Истина;

КонецФункции

&НаСервере
Функция ОбеспечитьКаталог(Каталог, СсылкаСотрудника)

    ФайлКаталога = Новый Файл(Каталог);
    Если ФайлКаталога.Существует() Тогда
        Если ФайлКаталога.ЭтоКаталог() Тогда
            Возврат Истина;
        КонецЕсли;
        СообщитьОшибку(
            "Путь в константе «Каталог фотографий сотрудников» указывает на файл, а не на каталог.",
            "СпособХраненияФотографии");
        Возврат Ложь;
    КонецЕсли;

    Попытка
        СоздатьКаталог(Каталог);
    Исключение
        ТекстОшибки = "Не удалось создать каталог фотографий: " + ОписаниеОшибки();
        ЗаписьЖурналаРегистрации(
            "Сотрудники.Фотография",
            УровеньЖурналаРегистрации.Ошибка,
            Метаданные.Справочники.Сотрудники,
            СсылкаСотрудника,
            ТекстОшибки);
        СообщитьОшибку(ТекстОшибки, "СпособХраненияФотографии");
        Возврат Ложь;
    КонецПопытки;

    Возврат Истина;

КонецФункции

&НаСервере
Функция ИмяФайлаДляЗаписи()

    Если Не ФотографияИзменена Тогда
        ПрежнееИмя = БезопасноеИмяФайла(ИмяФайлаПриЧтении);
        Если ЗначениеЗаполнено(ПрежнееИмя) Тогда
            Возврат ПрежнееИмя;
        КонецЕсли;
    КонецЕсли;

    Возврат Строка(Новый УникальныйИдентификатор()) + НормализоватьРасширение(РасширениеФайла);

КонецФункции

&НаСервере
Процедура УдалитьФайлФотографии(ИмяФайла)

    Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
        Возврат;
    КонецЕсли;

    Каталог = СокрЛП(Константы.КаталогФотографийСотрудников.Получить());
    Если Не ЗначениеЗаполнено(Каталог) Тогда
        Возврат;
    КонецЕсли;

    ПолныйПуть = ПолныйПутьФайла(Каталог, ИмяФайла);
    Если Не ЗначениеЗаполнено(ПолныйПуть) Тогда
        Возврат;
    КонецЕсли;

    ФайлКартинки = Новый Файл(ПолныйПуть);
    Если Не ФайлКартинки.Существует() Или ФайлКартинки.ЭтоКаталог() Тогда
        Возврат;
    КонецЕсли;

    Попытка
        УдалитьФайлы(ПолныйПуть);
    Исключение
        ТекстОшибки = "Не удалось удалить прежний файл фотографии: " + ОписаниеОшибки();
        ЗаписьЖурналаРегистрации(
            "Сотрудники.Фотография",
            УровеньЖурналаРегистрации.Предупреждение,
            Метаданные.Справочники.Сотрудники,
            Неопределено,
            ТекстОшибки);
    КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗапланироватьУдалениеФайла(ПараметрыЗаписи, ИмяФайла)

    Если ЗначениеЗаполнено(ИмяФайла) Тогда
        ПараметрыЗаписи.Вставить("ИмяФайлаКУдалению", ИмяФайла);
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СообщитьОшибку(Текст, ИмяРеквизита)

    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Текст;
    Сообщение.ПутьКДанным = "Объект";
    Сообщение.Поле = ИмяРеквизита;
    Сообщение.Сообщить();

КонецПроцедуры

&НаСервере
Функция ПустоеХранилище()
    Возврат Новый ХранилищеЗначения(Неопределено);
КонецФункции

&НаСервереБезКонтекста
Функция РасширениеПоСодержимому(ДанныеФото)

    Если ТипЗнч(ДанныеФото) <> Тип("ДвоичныеДанные") Тогда
        Возврат ".jpg";
    КонецЕсли;
    Если ДанныеФото.Размер() < 4 Тогда
        Возврат ".jpg";
    КонецЕсли;

    Поток = ДанныеФото.ОткрытьПотокДляЧтения();
    Буфер = Новый БуферДвоичныхДанных(8);
    Поток.Прочитать(Буфер, 0, 8);
    Поток.Закрыть();

    Если Буфер.Получить(0) = 137
        И Буфер.Получить(1) = 80
        И Буфер.Получить(2) = 78
        И Буфер.Получить(3) = 71 Тогда
        Возврат ".png";
    КонецЕсли;

    Если Буфер.Получить(0) = 255 И Буфер.Получить(1) = 216 Тогда
        Возврат ".jpg";
    КонецЕсли;

    Если Буфер.Получить(0) = 71
        И Буфер.Получить(1) = 73
        И Буфер.Получить(2) = 70 Тогда
        Возврат ".gif";
    КонецЕсли;

    Если Буфер.Получить(0) = 66 И Буфер.Получить(1) = 77 Тогда
        Возврат ".bmp";
    КонецЕсли;

    Возврат ".jpg";

КонецФункции

&НаСервереБезКонтекста
Функция НормализоватьРасширение(Расширение)

    Текст = НРег(СокрЛП(Расширение));
    Если Не СтрНачинаетсяС(Текст, ".") И ЗначениеЗаполнено(Текст) Тогда
        Текст = "." + Текст;
    КонецЕсли;

    Если Текст = ".jpg"
        Или Текст = ".jpeg"
        Или Текст = ".png"
        Или Текст = ".gif"
        Или Текст = ".bmp" Тогда
        Возврат Текст;
    КонецЕсли;

    Возврат ".jpg";

КонецФункции

&НаСервереБезКонтекста
Функция РасширениеИзИмениФайла(ИмяФайла)

    Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
        Возврат "";
    КонецЕсли;

    ПозицияТочки = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
    Если ПозицияТочки = 0 Тогда
        Возврат "";
    КонецЕсли;

    Возврат НормализоватьРасширение(Сред(ИмяФайла, ПозицияТочки));

КонецФункции

&НаСервереБезКонтекста
Функция БезопасноеИмяФайла(ИмяФайла)

    Имя = СокрЛП(ИмяФайла);
    Имя = СтрЗаменить(Имя, "\", "");
    Имя = СтрЗаменить(Имя, "/", "");
    Имя = СтрЗаменить(Имя, ":", "");
    Имя = СтрЗаменить(Имя, "..", "");
    Возврат Имя;

КонецФункции

&НаСервереБезКонтекста
Функция ПолныйПутьФайла(Каталог, ИмяФайла)

    Имя = БезопасноеИмяФайла(ИмяФайла);
    КаталогНорм = СокрЛП(Каталог);
    Если Не ЗначениеЗаполнено(КаталогНорм) Или Не ЗначениеЗаполнено(Имя) Тогда
        Возврат "";
    КонецЕсли;

    Пока СтрЗаканчиваетсяНа(КаталогНорм, "\") Или СтрЗаканчиваетсяНа(КаталогНорм, "/") Цикл
        КаталогНорм = Лев(КаталогНорм, СтрДлина(КаталогНорм) - 1);
    КонецЦикла;

    Возврат КаталогНорм + ПолучитьРазделительПутиСервера() + Имя;

КонецФункции

#КонецОбласти
