
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    РежимВыбора = Параметры.РежимВыбора;
    Элементы.Выбрать.Видимость = РежимВыбора;
    Элементы.Выбрать.КнопкаПоУмолчанию = РежимВыбора;
    ЗаполнитьТаблицу();
    УстановитьТекущуюСтроку(Параметры.ТекущийИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура МестаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    Если РежимВыбора Тогда
        ВыбратьТекущее();
    Иначе
        ОткрытьТекущее();
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
    ВыбратьТекущее();
КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)
    ОткрытьКарточку("");
КонецПроцедуры

&НаКлиенте
Процедура Изменить(Команда)
    ОткрытьТекущее();
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)

    ТекущиеДанные = Элементы.Места.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ТекстВопроса = "Удалить место рождения """ + ТекущиеДанные.Наименование + """?";
    Если МестоУказаноУСотрудника(ТекущиеДанные.Идентификатор) Тогда
        ТекстВопроса = ТекстВопроса + " Оно указано у сотрудника. В карточке сотрудника поле останется пустым по смыслу.";
    КонецЕсли;

    Оповещение = Новый ОписаниеОповещения("УдалениеЗавершение", ЭтотОбъект, ТекущиеДанные.Идентификатор);
    ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьТекущее()

    ТекущиеДанные = Элементы.Места.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("Идентификатор", ТекущиеДанные.Идентификатор);
    Результат.Вставить("Наименование", ТекущиеДанные.Наименование);
    Закрыть(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьТекущее()

    ТекущиеДанные = Элементы.Места.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ОткрытьКарточку(ТекущиеДанные.Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточку(Идентификатор)

    ПараметрыФормы = Новый Структура("Идентификатор", Идентификатор);
    Оповещение = Новый ОписаниеОповещения("ПослеКарточкиМеста", ЭтотОбъект);
    ОткрытьФорму(
        "ОбщаяФорма.МестоРождения",
        ПараметрыФормы,
        ЭтотОбъект,
        ,
        ,
        ,
        Оповещение,
        РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Описание: Обновляет список после закрытия карточки места.
//
// Параметры:
// Результат - Структура, Неопределено - карточка, если ее записали
// ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура ПослеКарточкиМеста(Результат, ДополнительныеПараметры) Экспорт
    ЗаполнитьТаблицу();
КонецПроцедуры

// Описание: Удаляет место, если пользователь подтвердил вопрос.
//
// Параметры:
// Ответ - КодВозвратаДиалога - ответ на вопрос
// Идентификатор - Строка - строка, которую удаляем
//
&НаКлиенте
Процедура УдалениеЗавершение(Ответ, Идентификатор) Экспорт

    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    УдалитьМестоНаСервере(Идентификатор);
    ЗаполнитьТаблицу();

КонецПроцедуры

// Описание: Ставит курсор списка на место, которое уже выбрано у сотрудника.
//
// Параметры:
// Идентификатор - Строка - идентификатор места рождения
//
&НаСервере
Процедура УстановитьТекущуюСтроку(Идентификатор)

    Если Не ЗначениеЗаполнено(Идентификатор) Тогда
        Возврат;
    КонецЕсли;

    НайденныеСтроки = Места.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
    Если НайденныеСтроки.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Элементы.Места.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицу()

    Места.Очистить();
    Для Каждого СтрокаМеста Из МестаРожденияСервер.ТаблицаМест() Цикл
        НоваяСтрока = Места.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМеста);
    КонецЦикла;

КонецПроцедуры

&НаСервере
Функция МестоУказаноУСотрудника(Идентификатор)
    Возврат МестаРожденияСервер.МестоУказаноУСотрудника(Идентификатор);
КонецФункции

&НаСервере
Процедура УдалитьМестоНаСервере(Идентификатор)
    МестаРожденияСервер.УдалитьМесто(Идентификатор);
КонецПроцедуры

#КонецОбласти
