
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Для Каждого СтрокаРегиона Из МестаРожденияСервер.СписокРегионов() Цикл
        Элементы.КодРегиона.СписокВыбора.Добавить(СтрокаРегиона.Код, СтрокаРегиона.Наименование);
    КонецЦикла;

    Идентификатор = Параметры.Идентификатор;
    Если Не ЗначениеЗаполнено(Идентификатор) Тогда
        Возврат;
    КонецЕсли;

    Карточка = МестаРожденияСервер.КарточкаМеста(Идентификатор);
    Если ТипЗнч(Карточка) <> Тип("Структура") Тогда
        Идентификатор = "";
        Возврат;
    КонецЕсли;

    Наименование = Карточка.Наименование;
    КодРегиона = Карточка.КодРегиона;
    Округ = Карточка.Округ;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КодРегионаПриИзменении(Элемент)
    Округ = ОкругРегиона(КодРегиона);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
    ЗаписатьМестоНаКлиенте(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
    ЗаписатьМестоНаКлиенте(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРегион(Команда)

    Если Не ЗначениеЗаполнено(КодРегиона) Тогда
        ПоказатьПредупреждение(, "Сначала выберите регион России.");
        Возврат;
    КонецЕсли;

    ОткрытьФорму(
        "ОбщаяФорма.РегионРоссии",
        Новый Структура("Код", КодРегиона),
        ЭтотОбъект,
        ,
        ,
        ,
        ,
        РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьМестоНаКлиенте(ЗакрытьПослеЗаписи)

    Если Не ЗначениеЗаполнено(СокрЛП(Наименование)) Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Укажите, как называется место рождения.";
        Сообщение.Поле = "Наименование";
        Сообщение.Сообщить();
        Возврат;
    КонецЕсли;

    Идентификатор = ЗаписатьМестоНаСервере();
    Модифицированность = Ложь;
    Если ЗакрытьПослеЗаписи Тогда
        Результат = Новый Структура;
        Результат.Вставить("Идентификатор", Идентификатор);
        Результат.Вставить("Наименование", СокрЛП(Наименование));
        Закрыть(Результат);
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаписатьМестоНаСервере()

    Возврат МестаРожденияСервер.ЗаписатьМесто(Идентификатор, Наименование, КодРегиона);

КонецФункции

&НаСервереБезКонтекста
Функция ОкругРегиона(КодРегиона)

    Карточка = МестаРожденияСервер.КарточкаРегиона(КодРегиона);
    Если ТипЗнч(Карточка) <> Тип("Структура") Тогда
        Возврат "";
    КонецЕсли;

    Возврат Карточка.Округ;

КонецФункции

#КонецОбласти
