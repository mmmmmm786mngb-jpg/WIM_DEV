
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Карточка = МестаРожденияСервер.КарточкаРегиона(Параметры.Код);
    Если ТипЗнч(Карточка) <> Тип("Структура") Тогда
        Наименование = "Регион не найден";
        Код = Параметры.Код;
        Возврат;
    КонецЕсли;

    Наименование = Карточка.Наименование;
    Код = Карточка.Код;
    Округ = Карточка.Округ;

КонецПроцедуры

#КонецОбласти
