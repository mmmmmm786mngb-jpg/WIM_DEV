#Область ПрограммныйИнтерфейс

// Описание: Формирует отчет и убирает пустые строки между остановками
// Платформа вставляет между вложенными таблицами служебные строки уровня группировки
// высотой 10. Настройками схемы их не отключить, поэтому пустые строки удаляются после вывода
//
// Параметры:
// ДокументРезультат - ТабличныйДокумент - документ, в который выводится отчет
// ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных - расшифровка ячеек
// СтандартнаяОбработка - Булево - признак стандартного вывода, отключается здесь
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;

    Настройки = КомпоновщикНастроек.ПолучитьНастройки();
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);

    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);

    СжатьПустыеСтроки(ДокументРезультат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Удаляет пустые строки и сужает колонки, чтобы треугольник из 25 остановок помещался на экран
// Служебные строки уровня группировки стоят между остановками и не содержат текста
//
// Параметры:
// ДокументРезультат - ТабличныйДокумент - сформированный отчет
//
Процедура СжатьПустыеСтроки(ДокументРезультат)

    Ширина = ДокументРезультат.ШиринаТаблицы;
    Если Ширина = 0 Тогда
        Возврат;
    КонецЕсли;

    НомерСтроки = ДокументРезультат.ВысотаТаблицы;
    Пока НомерСтроки >= 1 Цикл

        СтрокаПуста = Истина;
        Для НомерКолонки = 1 По Ширина Цикл
            Если ЗначениеЗаполнено(ДокументРезультат.Область(НомерСтроки, НомерКолонки).Текст) Тогда
                СтрокаПуста = Ложь;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если СтрокаПуста Тогда
            ДокументРезультат.УдалитьОбласть(
                ДокументРезультат.Область(НомерСтроки, , НомерСтроки),
                ТипСмещенияТабличногоДокумента.ПоВертикали);
        КонецЕсли;

        НомерСтроки = НомерСтроки - 1;

    КонецЦикла;

    Для НомерКолонки = 1 По Ширина Цикл
        Колонка = ДокументРезультат.Область(, НомерКолонки, , НомерКолонки);
        Колонка.ШиринаКолонки = 7.5;
    КонецЦикла;

КонецПроцедуры

#КонецОбласти
