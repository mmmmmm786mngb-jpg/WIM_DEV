// Описание: Подключает внешний отчет и открывает его стандартную форму.
//
// Параметры:
// Отказ - Булево - признак отказа от открытия формы-загрузчика
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

    ИмяОтчета = ПодключитьОтчетНаСервере();
    Если Не ЗначениеЗаполнено(ИмяОтчета) Тогда
        Возврат;
    КонецЕсли;

    ОткрытьФорму("ВнешнийОтчет." + ИмяОтчета + ".Форма");
    Отказ = Истина;

КонецПроцедуры

