
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.НастройкиОтбора)= Тип("Структура") тогда
		
		Объект.ИмяНастройки 				= Параметры.НастройкиОтбора.ИмяНастройки;
		Объект.ПараметрыОтбораБанковскихСчетов = Параметры.НастройкиОтбора.ПараметрыОтбораБанковскихСчетов;
		
		Настройки = Новый Соответствие;
		Настройки.Вставить("Отбор",Объект.ПараметрыОтбораБанковскихСчетов); 
        //ОбщегоНазначенияДУ.УстановитьПользовательскиеНастройки(СписокСчетов, Настройки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Установить(Команда)
    
	УстановитьНастройкиСписка();
	
	СтруктураВозврата = Новый Структура("ИмяНастройки, ПараметрыОтбораБанковскихСчетов, СписокСчетов", Объект.ИмяНастройки, Объект.ПараметрыОтбораБанковскихСчетов, Объект.СписокСчетов);
	Закрыть(СтруктураВозврата);
    
КонецПроцедуры

&НаСервере
Функция УстановитьНастройкиСписка()
	
//	IMAPPS-949
	СписокСчетовЕстьОтбор = Ложь;
	
	//Настройки = ОбщегоНазначенияДУ.ПодготовитьПользовательскиеНастройки(СписокСчетов, Новый Соответствие);
    //Объект.ПараметрыОтбораБанковскихСчетов = Настройки.Получить("Отбор");
    
    ТекОбъект = РеквизитФормыВЗначение("Объект");
	СКД = ТекОбъект.ПолучитьМакет("БанковскиеСчета");

    ТаблицаЗначений = Новый ТаблицаЗначений;
	

	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД)); 
	
	НастройкиПоУмолчанию = СКД.НастройкиПоУмолчанию;
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиПоУмолчанию);			
	
	НастройкиКомпоновщика = КомпоновщикНастроек.ПолучитьНастройки();	
	НастройкиКомпоновщика.Отбор.Элементы.Очистить();
	
	Для каждого ТекЭлемент Из СписокСчетов.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл

        Если ТипЗнч(ТекЭлемент) = Тип("ОтборКомпоновкиДанных") Тогда
			Для Каждого ЭлементОтбора из ТекЭлемент.Элементы Цикл  
				Если Не ЭлементОтбора.Использование Тогда Продолжить; КонецЕсли;
				ДобавитьЭлементОтбора(НастройкиКомпоновщика.Отбор.Элементы, ЭлементОтбора);
				СписокСчетовЕстьОтбор = Истина;
			КонецЦикла;
			Прервать;
		 КонецЕсли;

	КонецЦикла;
	
	Если СписокСчетовЕстьОтбор Тогда
	
		КомпоновщикМакета   = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновкиДанных  = КомпоновщикМакета.Выполнить(СКД, НастройкиКомпоновщика, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных);
	
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(ТаблицаЗначений);
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
		МассивСчетов = ТаблицаЗначений.ВыгрузитьКолонку("Ссылка");
		Объект.СписокСчетов.ЗагрузитьЗначения(МассивСчетов); 
	
	Иначе 
		Объект.СписокСчетов.Очистить();
	КонецЕсли;
	
КонецФункции



/////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Процедура ДобавитьЭлементОтбора(КоллекцияОтбора, ЭлементОтбора)
	
	Если ТипЗНЧ(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") тогда
		ТекОтбор = КоллекцияОтбора.добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(ТекОтбор, ЭлементОтбора);
		Для каждого ПодчиненныйОтбор из ЭлементОтбора.Элементы Цикл
			ДобавитьЭлементОтбора(ТекОтбор.Элементы, ПодчиненныйОтбор);
		Конеццикла
	Иначе
		ТекОтбор = КоллекцияОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(ТекОтбор, ЭлементОтбора); 	
	КонецЕсли
	
КонецПроцедуры
