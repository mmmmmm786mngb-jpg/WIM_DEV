// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
&НаСервере
Функция ДополнениеКомментарияУдельныйВесРаспределениеДоходов(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Формирует имя ключевой операции БСП для замера распределения доходов по ЦБ (РДУ).
//
// Параметры:
// ЭтапЗамера - Строка - этап замера (например, СозданиеОпераций)
//
// Возвращаемое значение:
// Строка - имя ключевой операции в формате ДУ.РаспределениеДоходов.<Этап>.внРаспределениеДоходовПоЦеннымБумагам
//
&НаСервере
Функция ПолучитьИмяКлючевойОперацииЗамераРаспределениеДоходов(Знач ЭтапЗамера)
	
	Возврат "ДУ.РаспределениеДоходов." + ЭтапЗамера + ".внРаспределениеДоходовПоЦеннымБумагам";
	
КонецФункции

// Описание: Подсчитывает отмеченные строки по вкладкам - вес и детализация комментария замера
//
// Параметры:
// ТекОбъект - ВнешняяОбработкаОбъект - объект обработки
//
// Возвращаемое значение:
// Структура - НКД, Погашение, Дивиденды, Всего (Число)
//
&НаСервере
Функция КоличествоОтмеченныхСтрокРаспределения(ТекОбъект)
	
	Количества = Новый Структура("НКД, Погашение, Дивиденды, Всего", 0, 0, 0, 0);
	
	Для Каждого Стр Из ТекОбъект.Купон Цикл
		Если Стр.Отм Тогда
			Количества.НКД = Количества.НКД + 1;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из ТекОбъект.Погашение Цикл
		Если Стр.Отм Тогда
			Количества.Погашение = Количества.Погашение + 1;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из ТекОбъект.Дивиденды Цикл
		Если Стр.Отм Тогда
			Количества.Дивиденды = Количества.Дивиденды + 1;
		КонецЕсли;
	КонецЦикла;
	
	Количества.Всего = Количества.НКД + Количества.Погашение + Количества.Дивиденды;
	
	Возврат Количества;
	
КонецФункции

// Описание: Записывает замер производительности создания операций
// Общий для последовательного и параллельного режимов создания
//
// Параметры:
// ТекОбъект - ВнешняяОбработкаОбъект - объект обработки (реквизиты шапки для комментария)
// ВремяНачала - Число - метка начала замера
// ОтмеченныеСтроки - Структура - результат КоличествоОтмеченныхСтрокРаспределения
// КоличествоУспехов - Число - количество созданных операций
// КоличествоОшибок - Число - количество ошибок создания
// РежимСоздания - Строка - "Последовательно" или "Параллельно"
//
&НаСервере
Процедура ЗаписатьЗамерСозданияОперацийРаспределениеДоходов(ТекОбъект, ВремяНачала,
	ОтмеченныеСтроки, КоличествоУспехов, КоличествоОшибок, РежимСоздания)
	
	Если ВремяНачала <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВесЗамераФинальный = ?(ОтмеченныеСтроки.Всего > 0, ОтмеченныеСтроки.Всего, 1);
	ОтказЗамера = КоличествоОшибок > 0;
	
	КомментарийЗамера = "Пул=" + ТекОбъект.Пул
		+ "; Период=" + Формат(ТекОбъект.Период, "ДФ=dd.MM.yyyy")
		+ "; Режим=" + РежимСоздания
		+ "; ОтмНКД=" + ОтмеченныеСтроки.НКД
		+ "; ОтмПогашение=" + ОтмеченныеСтроки.Погашение
		+ "; ОтмДивиденды=" + ОтмеченныеСтроки.Дивиденды
		+ "; Успехов=" + КоличествоУспехов
		+ "; Ошибок=" + КоличествоОшибок
		+ "; Отказ=" + ?(ОтказЗамера, "Да", "Нет")
		+ ДополнениеКомментарияУдельныйВесРаспределениеДоходов(ВесЗамераФинальный, ВремяНачала);
	
	ОценкаПроизводительности.ЗакончитьЗамерВремени(
		ПолучитьИмяКлючевойОперацииЗамераРаспределениеДоходов("СозданиеОпераций"),
		ВремяНачала,
		ВесЗамераФинальный,
		КомментарийЗамера,
		ОтказЗамера);
	
КонецПроцедуры

#КонецОбласти


