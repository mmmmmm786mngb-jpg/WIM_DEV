	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.ЗаполнитьТаблицуНКД();
	ТекОбъект.ЗаполнитьТаблицуПогашение();
	ТекОбъект.ЗаполнитьТаблицуДивиденды();	
	ЗначениеВРеквизитФормы(ТекОбъект,"Объект");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВсе(Команда)
	
	ЗаполнитьВсеНаСервере();
	
	Сообщить("Заполнение завершено");
	
КонецПроцедуры

// Описание: Последовательное создание операций по всем отмеченным строкам
//
// Параметры:
//  МассивСообщений - Массив - накопитель сообщений о создании/ошибках
//  ВремяНачалаЗамера - Число - если передан замер, начатый при клике, новый не стартует
//
&НаСервере
Процедура СоздатьВсеНаСервере(МассивСообщений, ВремяНачалаЗамера = 0)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамера <= 0 Тогда
		ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	КонецЕсли;
	ОтмеченныеСтроки = КоличествоОтмеченныхСтрокРаспределения(ТекОбъект);
	// IMDEV-8927 --
	
	ТекОбъект.СоздатьОперацииПоНКД(МассивСообщений);
	ТекОбъект.СоздатьОперацииПоПогашение(МассивСообщений);
	ТекОбъект.СоздатьОперацииПоДивидендам(МассивСообщений);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
	// IMDEV-8927 ++
	КоличествоОшибок = 0;
	КоличествоУспехов = 0;
	Для Каждого СообщениеЗамера Из МассивСообщений Цикл
		Если СтрНачинаетсяС(СообщениеЗамера, "Создана операция") Тогда
			КоличествоУспехов = КоличествоУспехов + 1;
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
	КонецЦикла;
	ЗаписатьЗамерСозданияОперацийРаспределениеДоходов(ТекОбъект, ВремяНачалаЗамера,
		ОтмеченныеСтроки, КоличествоУспехов, КоличествоОшибок, "Последовательно");
	// IMDEV-8927 --

КонецПроцедуры

// Описание: Создает операции по всем отмеченным строкам трех вкладок (IMDEV-9302)
// Основной режим - параллельный: строки разбиваются на пачки и обрабатываются фоновыми заданиями,
// ход работы показывается стандартным окном ожидания БСП с процентом выполнения.
// Если параллельный режим недоступен, создание выполняется последовательно, как раньше.
//
&НаКлиенте
Процедура СоздатьВсе(Команда) 
	
	МоментНачала = ТекущаяДата();
	Сообщить("Создание операций начато: " + Формат(МоментНачала, "ДЛФ=DT"), СтатусСообщения.Важное);
	
	РезультатЗапуска = ЗапуститьСоздатьВсеВФонеНаСервере();
	
	Если Не РезультатЗапуска.Параллельно Тогда
		Если ЗначениеЗаполнено(РезультатЗапуска.ПричинаПоследовательного) Тогда
			Сообщить("Параллельное создание не используется: " + РезультатЗапуска.ПричинаПоследовательного);
		КонецЕсли;
		МассивСообщений = Новый Массив;
		СоздатьВсеНаСервере(МассивСообщений, РезультатЗапуска.ВремяНачалаЗамера);
		Для Каждого Элемент Из МассивСообщений Цикл
			Сообщить(Элемент, СтатусСообщения.Важное);
		КонецЦикла;
		ВывестиИтогСозданияОпераций(МассивСообщений, МоментНачала, "Последовательно");
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ТекстСообщения = "Создание операций по счету брокера, строк: "
		+ Формат(РезультатЗапуска.Всего, "ЧН=0; ЧГ=' '");
	
	Оповещение = Новый ОписаниеОповещения("СоздатьВсеПараллельноЗавершение", ЭтотОбъект,
		Новый Структура("ВремяНачалаЗамера, МоментНачала",
			РезультатЗапуска.ВремяНачалаЗамера, МоментНачала));
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗапуска.ДлительнаяОперация,
		Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

// Описание: Обработчик завершения фонового создания операций
//
// Параметры:
//  Результат - Структура, Неопределено - результат длительной операции БСП
//  ДополнительныеПараметры - Структура - ВремяНачалаЗамера, МоментНачала
//
&НаКлиенте
Процедура СоздатьВсеПараллельноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Сообщить("Создание операций отменено", СтатусСообщения.Важное);
		ВывестиИтогСозданияОпераций(Новый Массив, ДополнительныеПараметры.МоментНачала, "Параллельно (отменено)");
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Отменено" Тогда
		Сообщить("Создание операций отменено", СтатусСообщения.Важное);
		ВывестиИтогСозданияОпераций(Новый Массив, ДополнительныеПараметры.МоментНачала, "Параллельно (отменено)");
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "неизвестная ошибка фонового задания";
		КонецЕсли;
		Сообщить("Ошибка фонового создания операций: " + ТекстОшибки, СтатусСообщения.Важное);
		ВывестиИтогСозданияОпераций(Новый Массив, ДополнительныеПараметры.МоментНачала, "Параллельно (ошибка)");
		Возврат;
	КонецЕсли;
	
	МассивСообщений = ЗавершитьСоздатьВсеПараллельноНаСервере(Результат.АдресРезультата,
		ДополнительныеПараметры.ВремяНачалаЗамера);
	
	Для Каждого Элемент Из МассивСообщений Цикл
		Сообщить(Элемент, СтатусСообщения.Важное);
	КонецЦикла;
	
	ВывестиИтогСозданияОпераций(МассивСообщений, ДополнительныеПараметры.МоментНачала, "Параллельно");
	
КонецПроцедуры

// Описание: Выводит в окно сообщений итог создания: окончание, количество, скорость, длительность
//
// Параметры:
//  МассивСообщений - Массив из Строка - сообщения по строкам
//  МоментНачала - Дата - время старта создания на клиенте
//  РежимСоздания - Строка - подпись режима для итога
//
&НаКлиенте
Процедура ВывестиИтогСозданияОпераций(МассивСообщений, МоментНачала, РежимСоздания)
	
	МоментОкончания = ТекущаяДата();
	ДлительностьСек = МоментОкончания - МоментНачала;
	Если ДлительностьСек < 0 Тогда
		ДлительностьСек = 0;
	КонецЕсли;
	
	КоличествоУспехов = 0;
	КоличествоОшибок = 0;
	Для Каждого СообщениеИзМассива Из МассивСообщений Цикл
		Если СтрНачинаетсяС(СообщениеИзМассива, "Создана операция") Тогда
			КоличествоУспехов = КоличествоУспехов + 1;
		ИначеЕсли ЗначениеЗаполнено(СообщениеИзМассива) Тогда
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	СкоростьВМинуту = ?(ДлительностьСек > 0, КоличествоУспехов * 60 / ДлительностьСек, 0);
	СкоростьВСекунду = ?(ДлительностьСек > 0, КоличествоУспехов / ДлительностьСек, 0);
	
	Часы = Цел(ДлительностьСек / 3600);
	Минуты = Цел((ДлительностьСек - Часы * 3600) / 60);
	Секунды = ДлительностьСек - Часы * 3600 - Минуты * 60;
	
	Сообщить("Создание операций завершено: " + Формат(МоментОкончания, "ДЛФ=DT"), СтатусСообщения.Важное);
	Сообщить("Режим: " + РежимСоздания
		+ "; создано документов: " + Формат(КоличествоУспехов, "ЧН=0; ЧГ=0")
		+ "; ошибок: " + Формат(КоличествоОшибок, "ЧН=0; ЧГ=0"), СтатусСообщения.Важное);
	Сообщить("Общее время: " + Формат(Часы, "ЧН=0; ЧГ=0") + " ч "
		+ Прав("0" + Формат(Минуты, "ЧГ=0"), 2) + " мин "
		+ Прав("0" + Формат(Секунды, "ЧГ=0"), 2) + " сек"
		+ "; скорость: " + Формат(СкоростьВМинуту, "ЧДЦ=1; ЧН=0") + " док/мин"
		+ " (" + Формат(СкоростьВСекунду, "ЧДЦ=2; ЧН=0") + " док/сек)", СтатусСообщения.Важное);
	
КонецПроцедуры

// Описание: Запускает фоновое создание операций и стартует замер производительности
//
// Возвращаемое значение:
//  Структура - Параллельно, ДлительнаяОперация, Всего, ПричинаПоследовательного, ВремяНачалаЗамера
//
&НаСервере
Функция ЗапуститьСоздатьВсеВФонеНаСервере()
	
	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	РезультатЗапуска = ТекОбъект.ЗапуститьСоздатьВсеВФоне(УникальныйИдентификатор);
	РезультатЗапуска.Вставить("ВремяНачалаЗамера", ВремяНачалаЗамера);
	
	Возврат РезультатЗапуска;
	
КонецФункции

// Описание: Переносит результат фонового создания в табличные части и записывает замер IMDEV-8927
//
// Параметры:
//  АдресРезультата - Строка - адрес результата фонового задания во временном хранилище
//  ВремяНачалаЗамера - Число - метка начала замера, полученная при запуске
//
// Возвращаемое значение:
//  Массив из Строка - сообщения по строкам распределения
//
&НаСервере
Функция ЗавершитьСоздатьВсеПараллельноНаСервере(АдресРезультата, ВремяНачалаЗамера)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ОтмеченныеСтроки = КоличествоОтмеченныхСтрокРаспределения(ТекОбъект);
	
	Итог = ТекОбъект.ПрименитьРезультатПараллельногоСоздания(АдресРезультата);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
	ЗаписатьЗамерСозданияОперацийРаспределениеДоходов(ТекОбъект, ВремяНачалаЗамера,
		ОтмеченныеСтроки, Итог.Успехов, Итог.Ошибок, "Параллельно");
	
	Возврат Итог.Сообщения;
	
КонецФункции


