Процедура ЗаполнитьТаблицуПогашение() Экспорт

	Погашение.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорДУ.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_ДУ
	               |ИЗ
	               |	Справочник.ДоговорДУ КАК ДоговорДУ
	               |ГДЕ
	               |	НЕ ДоговорДУ.ПометкаУдаления
	               |	И ДоговорДУ.Пул = &Пул
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ХозрасчетныйОбороты.Счет КАК Счет,
	               |	ХозрасчетныйОбороты.КорСчет КАК КорСчет,
	               |	ХозрасчетныйОбороты.ДоговорДУ КАК ДоговорДУ,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОбороты.Субконто1 КАК Справочник.Облигации).Эмитент КАК Эмитент,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОбороты.Субконто1 КАК Справочник.Облигации) КАК Облигация,
	               |	ХозрасчетныйОбороты.Валюта КАК Валюта,
	               |	ХозрасчетныйОбороты.ВалютнаяСуммаОборотКт КАК ВалютнаяСуммаОборотКт,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОбороты.Субконто2 КАК Документ.Сделка) КАК Субконто2,
