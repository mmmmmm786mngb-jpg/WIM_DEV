#Область ОбщееСозданиеОпераций

// Описание: Возвращает счета и статьи учета, которыми отличаются вкладки распределения доходов
// Значения кэшируются на время жизни объекта: в рамках одного запуска ссылки не меняются,
// а поиск по наименованию иначе выполнялся бы для каждой строки таблицы
//
// Параметры:
//  ВидТаблицы - Строка - "Купон", "Погашение" или "Дивиденды"
//
// Возвращаемое значение:
//  Структура - СтатьяДвиженияДенежныхСредств, СтатьяЗатрат, КоррСчет,
//              СтатьяЗатратКорреспондента (Неопределено, если реквизит не заполняется),
//              ЗаполнятьКупонныйПериод (Булево)
//
// Пример:
//  Настройки = НастройкиВидаТаблицы("Купон");
//
Функция НастройкиВидаТаблицы(ВидТаблицы)
	
	Если КэшНастроекОпераций = Неопределено Тогда
		КэшНастроекОпераций = Новый Соответствие;
	КонецЕсли;
	
	Настройки = КэшНастроекОпераций.Получить(ВидТаблицы);
	Если Настройки <> Неопределено Тогда
		Возврат Настройки;
	КонецЕсли;
	
	Настройки = Новый Структура;
	Настройки.Вставить("СтатьяДвиженияДенежныхСредств");
	Настройки.Вставить("СтатьяЗатрат");
	Настройки.Вставить("КоррСчет");
	Настройки.Вставить("СтатьяЗатратКорреспондента");
	Настройки.Вставить("ЗаполнятьКупонныйПериод", Ложь);
	
	Если ВидТаблицы = "Купон" Тогда
		
		Настройки.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Расчеты по НКД - ФЛ/ЮЛ");
		Настройки.СтатьяЗатрат = Справочники.СтатьиДоходовИРасходов.НачислениеНКД;
		Настройки.КоррСчет = ПланыСчетов.Хозрасчетный.РасчетыПоОблигациям;
		Настройки.СтатьяЗатратКорреспондента = Справочники.СтатьиДоходовИРасходов.НачислениеНКД;
		Настройки.ЗаполнятьКупонныйПериод = Истина;
		
	ИначеЕсли ВидТаблицы = "Погашение" Тогда
		
		Настройки.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Амортизация - ФЛ/ЮЛ");
		Настройки.СтатьяЗатрат = Справочники.СтатьиДоходовИРасходов.НайтиПоНаименованию("Амортизация");
		Настройки.КоррСчет = ПланыСчетов.Хозрасчетный.РасчетыПоОблигациям_ПогашениеТела;
		Настройки.СтатьяЗатратКорреспондента = Справочники.СтатьиДоходовИРасходов.НайтиПоНаименованию("Амортизация");
		
	ИначеЕсли ВидТаблицы = "Дивиденды" Тогда
		
		Настройки.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Дивиденды - ФЛ/ЮЛ");
		Настройки.СтатьяЗатрат = Справочники.СтатьиДоходовИРасходов.НачислениеДивидендов;
		Настройки.КоррСчет = ПланыСчетов.Хозрасчетный.РасчетыПоДивидендам;
		// Статья затрат корреспондента для дивидендов не заполняется
		
	Иначе
		
		ВызватьИсключение "Неизвестный вид таблицы распределения доходов: " + ВидТаблицы;
		
	КонецЕсли;
	
	КэшНастроекОпераций.Вставить(ВидТаблицы, Настройки);
	
	Возврат Настройки;
	
КонецФункции

// Описание: Создает или обновляет документ "Операция по счету брокера" по одной строке распределения дохода
// Общее ядро вкладок НКД, Погашение и Дивиденды: строка может быть как строкой табличной части,
// так и структурой с теми же полями (используется при обработке пачки в фоновом задании)
//
// Параметры:
//  ВидТаблицы - Строка - "Купон", "Погашение" или "Дивиденды"
//  Стр - ТабличнаяЧастьСтрока, Структура - строка распределения с полями ОперацияПоСчетуБрокера,
//        ДоговорДУ, АналитическийСчетДС, Эмитент, Актив, Валюта, Сумма, Документ;
//        для вида "Купон" дополнительно КупонныйПериод
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Ссылка (ДокументСсылка.ОперацияПоСчетуБрокера), Сообщение (Строка)
//
// Пример:
//  ИтогСтроки = СоздатьОднуОперациюПоСтроке("Купон", Стр);
//
Функция СоздатьОднуОперациюПоСтроке(ВидТаблицы, Стр)
	
	Результат = Новый Структура("Успех, Ссылка, Сообщение",
		Ложь, Документы.ОперацияПоСчетуБрокера.ПустаяСсылка(), "");
	
	Настройки = НастройкиВидаТаблицы(ВидТаблицы);
	
	Если ЗначениеЗаполнено(Стр.ОперацияПоСчетуБрокера) Тогда
		ОбОперация = Стр.ОперацияПоСчетуБрокера.ПолучитьОбъект();
	Иначе
		ОбОперация = Документы.ОперацияПоСчетуБрокера.СоздатьДокумент();
	КонецЕсли;
	
	ОбОперация.Дата = НачалоДня(ДатаСоздания) + 10 * 3600;
	ОбОперация.ДоговорДУ = Стр.ДоговорДУ;
	ОбОперация.Контрагент = Брокер;
	ОбОперация.ДоговорКонтрагента = Стр.АналитическийСчетДС.ДоговорКонтрагента;
	ОбОперация.АналитическийСчетБрокера = Стр.АналитическийСчетДС;
	ОбОперация.СтатьяДвиженияДенежныхСредств = Настройки.СтатьяДвиженияДенежныхСредств;
	ОбОперация.СтатьяЗатрат = Настройки.СтатьяЗатрат;
	
	ОбОперация.ВидОперации = Перечисления.ВидыОперацийПоСчетуБрокера.Зачисление;
	ОбОперация.СтрокаРазмешенияБрокерскогоСчета = "ОРЦБ";
	ОбОперация.ВалютаДокумента = Стр.Валюта;
	КурсКратность = МодульВалютногоУчета.ПолучитьКурсВалюты(Справочники.Валюты.RUB, Стр.Валюта, Период); // TM-3342
	ОбОперация.КурсВзаиморасчетов = КурсКратность.Курс;
	ОбОперация.КратностьВзаиморасчетов = КурсКратность.Кратность;
	ОбОперация.СуммаДокумента = Стр.Сумма;
	ОбОперация.СуммаДокументаРуб = Стр.Сумма * (ОбОперация.КурсВзаиморасчетов / ОбОперация.КратностьВзаиморасчетов);
	
	ОбОперация.БУ = Истина;
	ОбОперация.ВУ = Истина;
	ОбОперация.УУ = Истина;
	
	ОбОперация.КоррСчет = Настройки.КоррСчет;
	ОбОперация.Корреспондент = Стр.Эмитент;
	Если Настройки.СтатьяЗатратКорреспондента <> Неопределено Тогда
		ОбОперация.СтатьяЗатратКорреспондента = Настройки.СтатьяЗатратКорреспондента;
	КонецЕсли;
	
	ОбОперация.СубконтоКоррСчета1 = Стр.Эмитент;
	ОбОперация.СубконтоКоррСчета2 = Стр.Актив;
	Если Настройки.ЗаполнятьКупонныйПериод Тогда
		ОбОперация.СубконтоКоррСчета3 = Стр.КупонныйПериод;
	КонецЕсли;
	
	ОбОперация.ВалютаКорреспондента = Стр.Валюта;
	ОбОперация.КурсКорреспондента = КурсКратность.Курс;
	ОбОперация.КратностьКорреспондента = КурсКратность.Кратность;
	ОбОперация.СуммаКорреспондента = Стр.Сумма;
	
	ОбОперация.ДокументОснование = Стр.Документ;
	
	ОбОперация.Комментарий = "Создано автоматически обработкой ""Распределение доходов по ценным бумагам"" " + Формат(ТекущаяДата(), "ДЛФ=DT");
	
	Попытка
		
		ОбОперация.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Успех = Истина;
		Результат.Ссылка = ОбОперация.Ссылка;
		Результат.Сообщение = "Создана операция по счету брокеру " + ОбОперация.Ссылка;
		
	Исключение
		
		Результат.Сообщение = ОписаниеОшибки();
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область ПараллельноеСоздание

// Описание: Запускает создание всех отмеченных операций фоновым заданием-дирижером (IMDEV-9302)
// Если параллельный режим недоступен, создание выполняет вызывающий код в текущем сеансе
//
// Параметры:
//  ИдентификаторФормы - УникальныйИдентификатор - якорь временного хранилища БСП
//
// Возвращаемое значение:
//  Структура - Параллельно (Булево), ДлительнаяОперация (Структура, Неопределено),
//              Всего (Число), ПричинаПоследовательного (Строка)
//
Функция ЗапуститьСоздатьВсеВФоне(ИдентификаторФормы) Экспорт
	
	Результат = Новый Структура("Параллельно, ДлительнаяОперация, Всего, ПричинаПоследовательного",
		Ложь, Неопределено, 0, "");
	
	СтрокиКСозданию = СобратьОтмеченныеСтрокиДляПараллели();
	Результат.Всего = СтрокиКСозданию.Количество();
	
	Если Результат.Всего = 0 Тогда
		Результат.ПричинаПоследовательного = "Нет отмеченных строк";
		Возврат Результат;
	КонецЕсли;
	
	Если Не ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены() Тогда
		Результат.ПричинаПоследовательного = "Фоновые задания запрещены";
		Возврат Результат;
	КонецЕсли;
	
	ЛимитПотоков = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
	Если ЛимитПотоков <= 1 Тогда
		Результат.ПричинаПоследовательного = "Лимит параллельных потоков не больше одного";
		Возврат Результат;
	КонецЕсли;
	
	ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту(
		"ИмяОбъекта", ЭтотОбъект.Метаданные().Имя);
	Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		Результат.ПричинаПоследовательного = "Обработка не зарегистрирована в дополнительных отчетах и обработках";
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыДирижера = Новый Структура;
	ПараметрыДирижера.Вставить("НастройкиШапки",
		Новый Структура("Брокер, Период, ДатаСоздания, Пул", Брокер, Период, ДатаСоздания, Пул));
	ПараметрыДирижера.Вставить("Строки", СтрокиКСозданию);
	ПараметрыДирижера.Вставить("ЛимитПотоков", ЛимитПотоков);
	ПараметрыДирижера.Вставить("РазмерПачки", 100);
	ПараметрыДирижера.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ИмяМетода", "СоздатьВсеПараллельноФоновое");
	ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Истина);
	ПараметрыМетода.Вставить("ИмяОбработки", "");
	ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
	ПараметрыМетода.Вставить("ПараметрыВыполнения", XMLСтрока(Новый ХранилищеЗначения(ПараметрыДирижера)));
	
	ПараметрыФона = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
	ПараметрыФона.ЗапуститьВФоне = Истина;
	ПараметрыФона.ОжидатьЗавершение = 0;
	ПараметрыФона.НаименованиеФоновогоЗадания = "IMDEV-9302 Распределение доходов по ЦБ: создание операций";
	
	Попытка
		ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
			"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			ПараметрыМетода,
			ПараметрыФона);
	Исключение
		Результат.ПричинаПоследовательного = "Не удалось запустить фоновое задание: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Если ДлительнаяОперация = Неопределено Или ДлительнаяОперация.Статус = "Ошибка" Тогда
		Результат.ПричинаПоследовательного = "Фоновое задание не запущено"
			+ ?(ДлительнаяОперация = Неопределено, "", ": " + ДлительнаяОперация.КраткоеПредставлениеОшибки);
		Возврат Результат;
	КонецЕсли;
	
	Результат.ДлительнаяОперация = ДлительнаяОперация;
	Результат.Параллельно = Истина;
	
	Возврат Результат;
	
КонецФункции

// Описание: Дирижер параллельного создания операций (выполняется в фоновом задании)
//
// Параметры:
//  ПараметрыВыполнения - Строка, Структура - XML хранилища или структура параметров
//  АдресХранилища - Строка - адрес результата во временном хранилище
//
Процедура СоздатьВсеПараллельноФоновое(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Строка") Тогда
		ПараметрыВыполнения = XMLЗначение(Тип("ХранилищеЗначения"), ПараметрыВыполнения).Получить();
	КонецЕсли;
	
	Результат = Новый Структура("Строки, Сообщения, Успехов, Ошибок, ТекстОшибки",
		Новый Массив, Новый Массив, 0, 0, "");
	
	Попытка
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыВыполнения.НастройкиШапки);
		
		СтрокиКСозданию = ПараметрыВыполнения.Строки;
		Всего = СтрокиКСозданию.Количество();
		ЛимитПотоков = ПараметрыВыполнения.ЛимитПотоков;
		РазмерПачки = ПараметрыВыполнения.РазмерПачки;
		ИдентификаторХранилищаПачек = Новый УникальныйИдентификатор;
		
		Активные = Новый Массив;
		НомерПачки = 0;
		Индекс = 0;
		
		ДлительныеОперации.СообщитьПрогресс(0,
			"Создано 0 из " + Формат(Всего, "ЧН=0; ЧГ=' '"));
		
		Пока Индекс < Всего Или Активные.Количество() > 0 Цикл
			
			Пока Активные.Количество() < ЛимитПотоков И Индекс < Всего Цикл
				
				РазмерТекущейПачки = Мин(РазмерПачки, Всего - Индекс);
				СтрокиПачки = Новый Массив;
				Для Смещение = 0 По РазмерТекущейПачки - 1 Цикл
					СтрокиПачки.Добавить(СтрокиКСозданию[Индекс + Смещение]);
				КонецЦикла;
				Индекс = Индекс + РазмерТекущейПачки;
				НомерПачки = НомерПачки + 1;
				
				ПараметрыПачки = Новый Структура("НастройкиШапки, Строки, НомерПачки",
					ПараметрыВыполнения.НастройкиШапки, СтрокиПачки, НомерПачки);
				
				ПараметрыМетода = Новый Структура;
				ПараметрыМетода.Вставить("ИмяМетода", "ОбработатьПачкуСтрокРаспределения");
				ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Истина);
				ПараметрыМетода.Вставить("ИмяОбработки", "");
				ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка",
					ПараметрыВыполнения.ДополнительнаяОбработкаСсылка);
				ПараметрыМетода.Вставить("ПараметрыВыполнения",
					XMLСтрока(Новый ХранилищеЗначения(ПараметрыПачки)));
				
				ПараметрыФона = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторХранилищаПачек);
				ПараметрыФона.ЗапуститьВФоне = Истина;
				ПараметрыФона.ОжидатьЗавершение = 0;
				ПараметрыФона.НаименованиеФоновогоЗадания =
					"IMDEV-9302 Создание операций, пачка " + Формат(НомерПачки, "ЧГ=0");
				
				Контекст = ДлительныеОперации.ВыполнитьВФоне(
					"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
					ПараметрыМетода,
					ПараметрыФона);
				
				Активные.Добавить(Новый Структура("Контекст, НомерПачки, КоличествоСтрок",
					Контекст, НомерПачки, СтрокиПачки.Количество()));
				
			КонецЦикла;
			
			Если Активные.Количество() > 0
				И ЗначениеЗаполнено(Активные[0].Контекст.ИдентификаторЗадания) Тогда
				Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
					Активные[0].Контекст.ИдентификаторЗадания);
				Если Задание <> Неопределено Тогда
					Попытка
						Задание.ОжидатьЗавершения(0.5);
					Исключение
						// Состояние задания определяется ниже через ОперацияВыполнена
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
			
			СобратьЗавершенныеПачкиРаспределения(Активные, Результат);
			
			ОбработаноСтрок = Результат.Успехов + Результат.Ошибок;
			ДлительныеОперации.СообщитьПрогресс(
				?(Всего > 0, Мин(Цел(ОбработаноСтрок * 100 / Всего), 100), 100),
				"Создано " + Формат(ОбработаноСтрок, "ЧН=0; ЧГ=' '")
					+ " из " + Формат(Всего, "ЧН=0; ЧГ=' '"));
			
		КонецЦикла;
		
	Исключение
		
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("IMDEV-9302.СоздатьВсеПараллельно",
			УровеньЖурналаРегистрации.Ошибка, , , Результат.ТекстОшибки);
		
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(XMLСтрока(Новый ХранилищеЗначения(Результат)), АдресХранилища);
	
КонецПроцедуры

// Описание: Фоновая обработка одной пачки строк распределения доходов
//
// Параметры:
//  ПараметрыВыполнения - Строка, Структура - XML хранилища или структура (НастройкиШапки, Строки, НомерПачки)
//  АдресХранилища - Строка - адрес результата во временном хранилище
//
Процедура ОбработатьПачкуСтрокРаспределения(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Строка") Тогда
		ПараметрыВыполнения = XMLЗначение(Тип("ХранилищеЗначения"), ПараметрыВыполнения).Получить();
	КонецЕсли;
	
	Результат = Новый Структура("НомерПачки, Строки, ТекстОшибки",
		ПараметрыВыполнения.НомерПачки, Новый Массив, "");
	
	Попытка
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыВыполнения.НастройкиШапки);
		
		Для Каждого СтрокаПачки Из ПараметрыВыполнения.Строки Цикл
			
			ИтогСтроки = СоздатьОднуОперациюПоСтроке(СтрокаПачки.ВидТаблицы, СтрокаПачки);
			
			Результат.Строки.Добавить(Новый Структура(
				"ВидТаблицы, ИсходныйИндекс, Успех, Ссылка, Сообщение",
				СтрокаПачки.ВидТаблицы,
				СтрокаПачки.ИсходныйИндекс,
				ИтогСтроки.Успех,
				ИтогСтроки.Ссылка,
				ИтогСтроки.Сообщение));
			
		КонецЦикла;
		
	Исключение
		
		Результат.ТекстОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("IMDEV-9302.ПачкаСозданияОпераций",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Пачка " + Формат(Результат.НомерПачки, "ЧГ=0") + ": " + Результат.ТекстОшибки);
		
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(XMLСтрока(Новый ХранилищеЗначения(Результат)), АдресХранилища);
	
КонецПроцедуры

// Описание: Переносит в табличные части обработки ссылки на документы, созданные в фоновых заданиях
//
// Параметры:
//  АдресРезультата - Строка - адрес результата дирижера во временном хранилище
//
// Возвращаемое значение:
//  Структура - Сообщения (Массив из Строка), Успехов (Число), Ошибок (Число)
//
Функция ПрименитьРезультатПараллельногоСоздания(АдресРезультата) Экспорт
	
	Итог = Новый Структура("Сообщения, Успехов, Ошибок", Новый Массив, 0, 0);
	
	РезультатДирижера = ПрочитатьРезультатФоновогоЗадания(АдресРезультата);
	
	Если ТипЗнч(РезультатДирижера) <> Тип("Структура") Тогда
		Итог.Сообщения.Добавить("Не удалось получить результат фонового создания операций");
		Итог.Ошибок = 1;
		Возврат Итог;
	КонецЕсли;
	
	Для Каждого СтрокаИтога Из РезультатДирижера.Строки Цикл
		
		Если Не СтрокаИтога.Успех Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаИтога.ВидТаблицы = "Купон" Тогда
			ТаблицаВкладки = Купон;
		ИначеЕсли СтрокаИтога.ВидТаблицы = "Погашение" Тогда
			ТаблицаВкладки = Погашение;
		ИначеЕсли СтрокаИтога.ВидТаблицы = "Дивиденды" Тогда
			ТаблицаВкладки = Дивиденды;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если СтрокаИтога.ИсходныйИндекс > ТаблицаВкладки.Количество() - 1 Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаВкладки[СтрокаИтога.ИсходныйИндекс].ОперацияПоСчетуБрокера = СтрокаИтога.Ссылка;
		
	КонецЦикла;
	
	Итог.Сообщения = РезультатДирижера.Сообщения;
	Итог.Успехов = РезультатДирижера.Успехов;
	Итог.Ошибок = РезультатДирижера.Ошибок;
	
	Если Не ПустаяСтрока(РезультатДирижера.ТекстОшибки) Тогда
		Итог.Сообщения.Добавить("Ошибка фонового создания операций: " + РезультатДирижера.ТекстОшибки);
		Итог.Ошибок = Итог.Ошибок + 1;
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

Функция СобратьОтмеченныеСтрокиДляПараллели()
	
	Строки = Новый Массив;
	
	ИсходныйИндекс = -1;
