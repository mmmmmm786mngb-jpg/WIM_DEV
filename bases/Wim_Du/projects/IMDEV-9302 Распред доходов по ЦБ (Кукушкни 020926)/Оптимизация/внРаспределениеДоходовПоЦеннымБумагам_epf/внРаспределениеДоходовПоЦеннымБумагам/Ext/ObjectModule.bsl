// IMDEV-9302: кэш ссылок на счета и статьи учета по видам таблиц (заполняется при первом обращении).
Перем КэшНастроекОпераций;

Функция СведенияОВнешнейОбработке() Экспорт
		
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид","ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение",Неопределено);   //  МассивСтрокИмен
	ПараметрыРегистрации.Вставить("Наименование", "Распределение доходов по ценным бумагам");
	ПараметрыРегистрации.Вставить("Версия", "1.04");
	ПараметрыРегистрации.Вставить("БезопасныйРежим",Ложь);
	ПараметрыРегистрации.Вставить("Информация","Распределение доходов по ценным бумагам");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд, 
	"Распределение доходов по ценным бумагам",
	"внРаспределениеДоходовПоЦеннымБумагам",
	"ОткрытиеФормы");    
			
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры 

#Область НКД

Процедура ЗаполнитьТаблицуНКД() Экспорт

	Купон.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорДУ.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_ДУ
	               |ИЗ
	               |	Справочник.ДоговорДУ КАК ДоговорДУ
	               |ГДЕ
	               |	НЕ ДоговорДУ.ПометкаУдаления
	               |	И ДоговорДУ.Пул = &Пул
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ХозрасчетныйОбороты.Счет КАК Счет,
	               |	ХозрасчетныйОбороты.КорСчет КАК КорСчет,
	               |	ХозрасчетныйОбороты.ДоговорДУ КАК ДоговорДУ,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОбороты.Субконто1 КАК Справочник.Контрагенты) КАК Эмитент,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОбороты.Субконто2 КАК Справочник.Облигации) КАК Облигация,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОбороты.Субконто3 КАК Справочник.КупонныеПериоды) КАК КупонныйПериод,
	               |	ХозрасчетныйОбороты.Валюта КАК Валюта,
	               |	ХозрасчетныйОбороты.ВалютнаяСуммаОборотДт КАК ВалютнаяСуммаОборотДт,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОбороты.КорСубконто3 КАК Документ.Сделка) КАК КорСубконто3,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОбороты.КорСубконто3 КАК Документ.Сделка).АналитическийСчетДС КАК АналитическийСчетДС,
	               |	ХозрасчетныйОбороты.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ ВТ_Начисление
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.Обороты(
	               |			&Дата1,
	               |			&Дата2,
	               |			Регистратор,
	               |			Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоОблигациям),
	               |			,
	               |			ДоговорДУ В
	               |				(ВЫБРАТЬ
	               |					ВТ_ДУ.Ссылка КАК Ссылка
	               |				ИЗ
	               |					ВТ_ДУ КАК ВТ_ДУ),
	               |			КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НачисленныйНКД),
	               |			) КАК ХозрасчетныйОбороты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Начисление.Счет КАК Счет,
	               |	ВТ_Начисление.КорСчет КАК КорСчет,
	               |	ВТ_Начисление.ДоговорДУ КАК ДоговорДУ,
	               |	ВТ_Начисление.Облигация КАК Облигация,
	               |	ВТ_Начисление.КупонныйПериод КАК КупонныйПериод,
	               |	ВТ_Начисление.Валюта КАК Валюта,
	               |	СУММА(ВТ_Начисление.ВалютнаяСуммаОборотДт) КАК ВалютнаяСуммаОборотДт,
	               |	ВТ_Начисление.АналитическийСчетДС КАК АналитическийСчетДС,
	               |	ВТ_Начисление.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ ВТ_НачисленияСвернутые
	               |ИЗ
	               |	ВТ_Начисление КАК ВТ_Начисление
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Начисление.КупонныйПериод,
	               |	ВТ_Начисление.КорСчет,
	               |	ВТ_Начисление.ДоговорДУ,
	               |	ВТ_Начисление.Облигация,
	               |	ВТ_Начисление.Счет,
	               |	ВТ_Начисление.Валюта,
	               |	ВТ_Начисление.АналитическийСчетДС,
	               |	ВТ_Начисление.Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ХозрасчетныйОстатки.ДоговорДУ КАК ДоговорДУ,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.Контрагенты) КАК Эмитент,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто2 КАК Справочник.Облигации) КАК Облигация,
	               |	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто3 КАК Справочник.КупонныеПериоды) КАК КупонныйПериод,
	               |	ХозрасчетныйОстатки.Валюта КАК Валюта,
	               |	ХозрасчетныйОстатки.СуммаОстаток КАК СуммаОстаток
	               |ПОМЕСТИТЬ ВТ_Остаток
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.Остатки(
	               |			&Дата2,
	               |			Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоОблигациям),
	               |			,
	               |			ДоговорДУ В
	               |				(ВЫБРАТЬ
	               |					ВТ_ДУ.Ссылка КАК Ссылка
	               |				ИЗ
	               |					ВТ_ДУ КАК ВТ_ДУ)) КАК ХозрасчетныйОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОперацияПоСчетуБрокера.Ссылка КАК Ссылка,
	               |	ОперацияПоСчетуБрокера.ДоговорДУ КАК ДоговорДУ,
	               |	ОперацияПоСчетуБрокера.СубконтоКоррСчета2 КАК СубконтоКоррСчета2,
	               |	ОперацияПоСчетуБрокера.СубконтоКоррСчета3 КАК СубконтоКоррСчета3,
	               |	ОперацияПоСчетуБрокера.СуммаДокументаРуб КАК СуммаДокументаРуб,
	               |	ОперацияПоСчетуБрокера.АналитическийСчетБрокера КАК АналитическийСчетБрокера,
	               |	ОперацияПоСчетуБрокера.ДокументОснование КАК ДокументОснование
	               |ПОМЕСТИТЬ ВТ_Операции
	               |ИЗ
	               |	Документ.ОперацияПоСчетуБрокера КАК ОперацияПоСчетуБрокера
	               |ГДЕ
	               |	НЕ ОперацияПоСчетуБрокера.ПометкаУдаления
	               |	И (ОперацияПоСчетуБрокера.ДоговорДУ, ОперацияПоСчетуБрокера.СубконтоКоррСчета2, ОперацияПоСчетуБрокера.СубконтоКоррСчета3, ОперацияПоСчетуБрокера.СуммаДокументаРуб, ОперацияПоСчетуБрокера.АналитическийСчетБрокера, ОперацияПоСчетуБрокера.ДокументОснование) В
	               |			(ВЫБРАТЬ
	               |				ВТ_НачисленияСвернутые.ДоговорДУ КАК ДоговорДУ,
	               |				ВТ_НачисленияСвернутые.Облигация КАК Облигация,
	               |				ВТ_НачисленияСвернутые.КупонныйПериод КАК КупонныйПериод,
	               |				ВТ_НачисленияСвернутые.ВалютнаяСуммаОборотДт КАК ВалютнаяСуммаОборотДт,
	               |				ВТ_НачисленияСвернутые.АналитическийСчетДС КАК АналитическийСчетДС,
	               |				ВТ_НачисленияСвернутые.Регистратор КАК Регистратор
	               |			ИЗ
	               |				ВТ_НачисленияСвернутые КАК ВТ_НачисленияСвернутые)
	               |	И ОперацияПоСчетуБрокера.Дата МЕЖДУ &Дата1 И &Дата2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИСТИНА КАК Отм,
	               |	ВТ_НачисленияСвернутые.Регистратор КАК Документ,
	               |	ВТ_Остаток.ДоговорДУ КАК ДоговорДУ,
	               |	ВТ_Остаток.Эмитент КАК Эмитент,
	               |	ВТ_Остаток.Облигация КАК Актив,
	               |	ВТ_Остаток.КупонныйПериод КАК КупонныйПериод,
	               |	ВТ_Остаток.Валюта КАК Валюта,
	               |	ВТ_Остаток.СуммаОстаток КАК Сумма,
	               |	ВТ_НачисленияСвернутые.АналитическийСчетДС КАК АналитическийСчетДС,
	               |	ВТ_Операции.Ссылка КАК ОперацияПоСчетуБрокера
	               |ИЗ
	               |	ВТ_Остаток КАК ВТ_Остаток
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НачисленияСвернутые КАК ВТ_НачисленияСвернутые
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Операции КАК ВТ_Операции
	               |			ПО ВТ_НачисленияСвернутые.ДоговорДУ = ВТ_Операции.ДоговорДУ
	               |				И ВТ_НачисленияСвернутые.Облигация = ВТ_Операции.СубконтоКоррСчета2
	               |				И ВТ_НачисленияСвернутые.КупонныйПериод = ВТ_Операции.СубконтоКоррСчета3
	               |				И ВТ_НачисленияСвернутые.ВалютнаяСуммаОборотДт = ВТ_Операции.СуммаДокументаРуб
	               |				И ВТ_НачисленияСвернутые.АналитическийСчетДС = ВТ_Операции.АналитическийСчетБрокера
	               |				И ВТ_НачисленияСвернутые.Регистратор = ВТ_Операции.ДокументОснование
	               |		ПО ВТ_Остаток.ДоговорДУ = ВТ_НачисленияСвернутые.ДоговорДУ
	               |			И ВТ_Остаток.Облигация = ВТ_НачисленияСвернутые.Облигация
	               |			И ВТ_Остаток.КупонныйПериод = ВТ_НачисленияСвернутые.КупонныйПериод
	               |			И ВТ_Остаток.Валюта = ВТ_НачисленияСвернутые.Валюта
	               |ГДЕ
	               |	ВТ_Остаток.ДоговорДУ В
	               |			(ВЫБРАТЬ
	               |				ВТ_ДУ.Ссылка КАК Ссылка
	               |			ИЗ
	               |				ВТ_ДУ КАК ВТ_ДУ)";
	Запрос.УстановитьПараметр("Пул", Пул);
	Запрос.УстановитьПараметр("Дата1", Период);
	Запрос.УстановитьПараметр("Дата2", КонецДня(Период));
	
	Данные = Запрос.Выполнить().Выгрузить();
	Купон.Загрузить(Данные);	
	
КонецПроцедуры  

Процедура СоздатьОперацииПоНКД(МассивСообщений) Экспорт
	
	Для Каждого Стр Из Купон Цикл
		
		Если НЕ Стр.Отм Тогда
			Продолжить;
		КонецЕсли;
		
		ИтогСтроки = СоздатьОднуОперациюПоСтроке("Купон", Стр);
		МассивСообщений.Добавить(ИтогСтроки.Сообщение);
		
		Если ИтогСтроки.Успех Тогда
			Стр.ОперацияПоСчетуБрокера = ИтогСтроки.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

