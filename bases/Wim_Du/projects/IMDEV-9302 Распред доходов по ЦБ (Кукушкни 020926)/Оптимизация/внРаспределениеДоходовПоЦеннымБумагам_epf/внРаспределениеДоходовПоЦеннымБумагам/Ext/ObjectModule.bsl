КонецФункции

Процедура СобратьЗавершенныеПачкиРаспределения(Активные, Результат)
	
	Индекс = Активные.ВГраница();
	
	Пока Индекс >= 0 Цикл
		
		ОписаниеПачки = Активные[Индекс];
		Контекст = ОписаниеПачки.Контекст;
		
		ТекстОшибкиЗадания = "";
		Если ЗначениеЗаполнено(Контекст.ИдентификаторЗадания) Тогда
			СтатусЗадания = ДлительныеОперации.ОперацияВыполнена(Контекст.ИдентификаторЗадания, Ложь);
			Если СтатусЗадания.Статус = "Выполняется" Тогда
				Индекс = Индекс - 1;
				Продолжить;
			КонецЕсли;
			ТекстОшибкиЗадания = СтатусЗадания.КраткоеПредставлениеОшибки;
		Иначе
			ТекстОшибкиЗадания = Контекст.КраткоеПредставлениеОшибки;
		КонецЕсли;
		
		ИтогПачки = ПрочитатьРезультатФоновогоЗадания(Контекст.АдресРезультата);
		
		Если ТипЗнч(ИтогПачки) = Тип("Структура") Тогда
			
			Для Каждого СтрокаИтога Из ИтогПачки.Строки Цикл
				
				Результат.Строки.Добавить(СтрокаИтога);
				Результат.Сообщения.Добавить(СтрокаИтога.Сообщение);
				
				Если СтрокаИтога.Успех Тогда
					Результат.Успехов = Результат.Успехов + 1;
				Иначе
					Результат.Ошибок = Результат.Ошибок + 1;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ПустаяСтрока(ИтогПачки.ТекстОшибки) Тогда
				НеучтенныхСтрок = ОписаниеПачки.КоличествоСтрок - ИтогПачки.Строки.Количество();
				Если НеучтенныхСтрок > 0 Тогда
					Результат.Ошибок = Результат.Ошибок + НеучтенныхСтрок;
				Иначе
					Результат.Ошибок = Результат.Ошибок + 1;
				КонецЕсли;
				Результат.Сообщения.Добавить("Пачка " + Формат(ОписаниеПачки.НомерПачки, "ЧГ=0")
					+ ": " + ИтогПачки.ТекстОшибки);
			КонецЕсли;
			
		Иначе
			
			Результат.Ошибок = Результат.Ошибок + ОписаниеПачки.КоличествоСтрок;
			Результат.Сообщения.Добавить("Пачка " + Формат(ОписаниеПачки.НомерПачки, "ЧГ=0") + ": "
				+ ?(ЗначениеЗаполнено(ТекстОшибкиЗадания), ТекстОшибкиЗадания,
					"результат не получен из временного хранилища"));
			
		КонецЕсли;
		
		Активные.Удалить(Индекс);
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПрочитатьРезультатФоновогоЗадания(АдресРезультата)
	
	Если Не ЗначениеЗаполнено(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначениеРезультата = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если ТипЗнч(ЗначениеРезультата) = Тип("Структура") Тогда
		Возврат ЗначениеРезультата;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеРезультата) <> Тип("Строка") Или ПустаяСтрока(ЗначениеРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат XMLЗначение(Тип("ХранилищеЗначения"), ЗначениеРезультата).Получить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти
