#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТолькоАвтоОбработка = Истина;
	Период = НачалоДня(ТекущаяДатаСеанса());
	ВремяВыполненияСек = 0;

	Если Не ЗначениеЗаполнено(Пул) Тогда
		Пул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтметитьНачалоСоздания(Команда)

	МеткаНачалаЗамера = ТекущаяДата();
	ВремяВыполненияСек = 0;
	ТекстОтчёта = "Замер начат: " + Формат(МеткаНачалаЗамера, "ДЛФ=DT")
		+ Символы.ПС + "Теперь выполните «Создать всё» в обработке распределения, затем нажмите «Стоп замера».";

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьКонецСоздания(Команда)

	Если Не ЗначениеЗаполнено(МеткаНачалаЗамера) Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Старт замера» (перед Создать всё).");
		Возврат;
	КонецЕсли;

	КонецЗамера = ТекущаяДата();
	ВремяВыполненияСек = КонецЗамера - МеткаНачалаЗамера;
	Если ВремяВыполненияСек < 0 Тогда
		ВремяВыполненияСек = 0;
	КонецЕсли;

	ТекстОтчёта = "Замер окончен."
		+ Символы.ПС + "Начало: " + Формат(МеткаНачалаЗамера, "ДЛФ=DT")
		+ Символы.ПС + "Конец:  " + Формат(КонецЗамера, "ДЛФ=DT")
		+ Символы.ПС + "Длительность «Создать всё»: "
		+ Формат(ВремяВыполненияСек, "ЧРД=.; ЧН=0; ЧГ=0") + " сек."
		+ Символы.ПС + "Можно выгружать снимок в JSON — время попадёт в файл.";

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлВыгрузки(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "JSON (*.json)|*.json";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПолноеИмяФайла = ?(ЗначениеЗаполнено(ПутьФайлаВыгрузки), ПутьФайлаВыгрузки, "snapshot_before.json");
	Если Диалог.Выбрать() Тогда
		ПутьФайлаВыгрузки = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлСтарый(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "JSON (*.json)|*.json";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПолноеИмяФайла = ?(ЗначениеЗаполнено(ПутьФайлаСтарый), ПутьФайлаСтарый, "snapshot_before.json");
	Если Диалог.Выбрать() Тогда
		ПутьФайлаСтарый = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлНовый(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "JSON (*.json)|*.json";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПолноеИмяФайла = ?(ЗначениеЗаполнено(ПутьФайлаНовый), ПутьФайлаНовый, "snapshot_after.json");
	Если Диалог.Выбрать() Тогда
		ПутьФайлаНовый = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлОтчёта(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "Текст (*.txt)|*.txt";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПолноеИмяФайла = ?(ЗначениеЗаполнено(ПутьОтчётаСравнения), ПутьОтчётаСравнения, "compare_report.txt");
	Если Диалог.Выбрать() Тогда
		ПутьОтчётаСравнения = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьРезультат(Команда)

	Если Не ЗначениеЗаполнено(ПутьФайлаВыгрузки) Тогда
		ПоказатьПредупреждение(, "Укажите файл выгрузки (JSON).");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВремяВыполненияСек) Или ВремяВыполненияСек <= 0 Тогда
		ПоказатьПредупреждение(,
			"Укажите время «Создать всё» в секундах (кнопки Старт/Стоп замера или вручную), иначе сравнение времени будет недоступно.");
		// Не блокируем выгрузку — регресс данных всё равно полезен.
	КонецЕсли;

	ТекстJSON = "";
	ТекстСводки = "";
	ВыгрузитьРезультатНаСервере(ТекстJSON, ТекстСводки);

	Запись = Новый ЗаписьТекста(ПутьФайлаВыгрузки, КодировкаТекста.UTF8);
	Запись.Записать(ТекстJSON);
	Запись.Закрыть();

	ТекстОтчёта = ТекстСводки + Символы.ПС + "Файл записан: " + ПутьФайлаВыгрузки;
	ПоказатьПредупреждение(, ТекстСводки);

КонецПроцедуры

&НаКлиенте
Процедура СравнитьФайлы(Команда)

	Если Не ЗначениеЗаполнено(ПутьФайлаСтарый) Или Не ЗначениеЗаполнено(ПутьФайлаНовый) Тогда
		ПоказатьПредупреждение(, "Укажите оба файла: ДО и ПОСЛЕ.");
		Возврат;
	КонецЕсли;

	ЧтениеСтарый = Новый ЧтениеТекста(ПутьФайлаСтарый, КодировкаТекста.UTF8);
	JSONСтарый = ЧтениеСтарый.Прочитать();
	ЧтениеСтарый.Закрыть();

	ЧтениеНовый = Новый ЧтениеТекста(ПутьФайлаНовый, КодировкаТекста.UTF8);
	JSONНовый = ЧтениеНовый.Прочитать();
	ЧтениеНовый.Закрыть();

	ТекстСравнения = "";
	УспехРегресса = Ложь;
	ВремяСравнено = Ложь;
	СравнитьФайлыНаСервере(JSONСтарый, JSONНовый, ТекстСравнения, УспехРегресса, ВремяСравнено);
	ТекстОтчёта = ТекстСравнения;

	Если ЗначениеЗаполнено(ПутьОтчётаСравнения) Тогда
		Запись = Новый ЗаписьТекста(ПутьОтчётаСравнения, КодировкаТекста.UTF8);
		Запись.Записать(ТекстСравнения);
		Запись.Закрыть();
	КонецЕсли;

	Если УспехРегресса И ВремяСравнено Тогда
		ПоказатьПредупреждение(, "Регресс OK. Время сравнено — см. шапку отчёта.");
	ИначеЕсли УспехРегресса Тогда
		ПоказатьПредупреждение(, "Регресс OK. Время не сравнено (нет замеров в снимках).");
	Иначе
		ПоказатьПредупреждение(, "Регресс НЕ пройден. Подробности в отчёте на форме.");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыгрузитьРезультатНаСервере(ТекстJSON, ТекстСводки)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Снимок = ОбработкаОбъект.СобратьСнимокРезультата(Период, Пул, ТолькоАвтоОбработка, ВремяВыполненияСек);
	ТекстJSON = ОбработкаОбъект.СнимокВJSON(Снимок);
	ТекстСводки = Снимок.ТекстСводки;

КонецПроцедуры

&НаСервере
Процедура СравнитьФайлыНаСервере(JSONСтарый, JSONНовый, ТекстСравнения, УспехРегресса, ВремяСравнено)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.СравнитьСнимкиJSON(JSONСтарый, JSONНовый);
	ТекстСравнения = Результат.ТекстОтчёта;
	УспехРегресса = Результат.Успех;
	ВремяСравнено = Результат.ВремяСравнено;

КонецПроцедуры

#КонецОбласти
