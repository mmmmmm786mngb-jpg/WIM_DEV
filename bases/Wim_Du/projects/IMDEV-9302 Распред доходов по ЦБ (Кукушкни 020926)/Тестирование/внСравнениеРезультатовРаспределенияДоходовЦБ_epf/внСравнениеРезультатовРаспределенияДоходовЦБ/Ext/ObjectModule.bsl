Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", "Сравнение результатов распределения доходов по ЦБ");
	ПараметрыРегистрации.Вставить("Версия", "1.01");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Выгрузка результата ОперацияПоСчетуБрокера после распределения доходов по ЦБ, фиксация времени «Создать всё» и сравнение двух JSON (регресс + время).");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	Команда = Команды.Добавить();
	Команда.Представление = "Сравнение результатов распределения доходов по ЦБ";
	Команда.Идентификатор = "внСравнениеРезультатовРаспределенияДоходовЦБ";
	Команда.Использование = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Ложь;

	ПараметрыРегистрации.Вставить("Команды", Команды);
	Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Собирает снимок операций по счету брокера за день и пул для регресс-сравнения.
//
// Параметры:
// Период - Дата - день документов (с начала по конец дня)
// Пул - СправочникСсылка.Пул - отбор договоров ДУ
// ТолькоАвтоОбработка - Булево - только документы с комментарием автообработки распределения
// ВремяВыполненияСек - Число - длительность «Создать всё» в секундах (пишется в Мета снимка)
//
// Возвращаемое значение:
// Структура - Мета, Строки (массив структур с бизнес-ключами), ТекстСводки
//
Функция СобратьСнимокРезультата(Период, Пул, ТолькоАвтоОбработка = Истина, ВремяВыполненияСек = 0) Экспорт

	Результат = Новый Структура("Мета, Строки, ТекстСводки", Новый Структура, Новый Массив, "");

	Если Не ЗначениеЗаполнено(Период) Тогда
		ВызватьИсключение "Не заполнен период (день операций).";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пул) Тогда
		ВызватьИсключение "Не заполнен пул.";
	КонецЕсли;

	Дата1 = НачалоДня(Период);
	Дата2 = КонецДня(Период);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Операция.Ссылка КАК Ссылка,
	|	Операция.Номер КАК Номер,
	|	Операция.Дата КАК Дата,
	|	Операция.ДоговорДУ КАК ДоговорДУ,
	|	Операция.ДоговорДУ.Код КАК ДоговорДУКод,
	|	Операция.ДоговорДУ.Наименование КАК ДоговорДУНаименование,
	|	Операция.Контрагент КАК Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Операция.Контрагент) КАК КонтрагентПредставление,
	|	Операция.АналитическийСчетБрокера КАК АналитическийСчетБрокера,
	|	ПРЕДСТАВЛЕНИЕ(Операция.АналитическийСчетБрокера) КАК АналитическийСчетБрокераПредставление,
	|	Операция.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
	|	ПРЕДСТАВЛЕНИЕ(Операция.СтатьяДвиженияДенежныхСредств) КАК СтатьяДДСПредставление,
	|	Операция.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ПРЕДСТАВЛЕНИЕ(Операция.СтатьяЗатрат) КАК СтатьяЗатратПредставление,
	|	Операция.ВидОперации КАК ВидОперации,
	|	ПРЕДСТАВЛЕНИЕ(Операция.ВидОперации) КАК ВидОперацииПредставление,
	|	Операция.СтрокаРазмешенияБрокерскогоСчета КАК СтрокаРазмешения,
	|	Операция.ВалютаДокумента КАК Валюта,
	|	ПРЕДСТАВЛЕНИЕ(Операция.ВалютаДокумента) КАК ВалютаПредставление,
	|	Операция.СуммаДокумента КАК СуммаДокумента,
	|	Операция.СуммаДокументаРуб КАК СуммаДокументаРуб,
	|	Операция.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	Операция.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	Операция.КоррСчет КАК КоррСчет,
	|	Операция.КоррСчет.Код КАК КоррСчетКод,
	|	ПРЕДСТАВЛЕНИЕ(Операция.КоррСчет) КАК КоррСчетПредставление,
	|	Операция.Корреспондент КАК Корреспондент,
	|	ПРЕДСТАВЛЕНИЕ(Операция.Корреспондент) КАК КорреспондентПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Операция.СубконтоКоррСчета1) КАК Субконто1,
	|	ПРЕДСТАВЛЕНИЕ(Операция.СубконтоКоррСчета2) КАК Субконто2,
	|	ПРЕДСТАВЛЕНИЕ(Операция.СубконтоКоррСчета3) КАК Субконто3,
	|	Операция.ДокументОснование КАК ДокументОснование,
	|	ПРЕДСТАВЛЕНИЕ(Операция.ДокументОснование) КАК ДокументОснованиеПредставление,
	|	Операция.Комментарий КАК Комментарий,
	|	Операция.Проведен КАК Проведен
	|ИЗ
	|	Документ.ОперацияПоСчетуБрокера КАК Операция
	|ГДЕ
	|	Операция.Дата МЕЖДУ &Дата1 И &Дата2
	|	И НЕ Операция.ПометкаУдаления
	|	И Операция.Проведен
	|	И Операция.ДоговорДУ.Пул = &Пул
	|	И Операция.КоррСчет В (
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоОблигациям),
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоОблигациям_ПогашениеТела),
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоДивидендам))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорДУКод,
	|	КоррСчетКод,
	|	Операция.СубконтоКоррСчета2,
	|	Операция.СубконтоКоррСчета3,
	|	СуммаДокумента";

	Запрос.УстановитьПараметр("Дата1", Дата1);
	Запрос.УстановитьПараметр("Дата2", Дата2);
	Запрос.УстановитьПараметр("Пул", Пул);

	Выборка = Запрос.Выполнить().Выбрать();
	МаркерКомментария = "Распределение доходов по ценным бумагам";
	Счетчики = Новый Соответствие;
	Счетчики.Вставить("НКД", 0);
	Счетчики.Вставить("Погашение", 0);
	Счетчики.Вставить("Дивиденды", 0);
	Счетчики.Вставить("Прочее", 0);

	Пока Выборка.Следующий() Цикл

		Если ТолькоАвтоОбработка Тогда
			Если СтрНайти(Строка(Выборка.Комментарий), МаркерКомментария) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		ВидДохода = ОпределитьВидДоходаПоКоррСчету(Выборка.КоррСчет);
		Счетчики[ВидДохода] = Счетчики[ВидДохода] + 1;

		Ключ = СформироватьБизнесКлюч(
			Выборка.ДоговорДУКод,
			ВидДохода,
			Выборка.КоррСчетКод,
			Выборка.КорреспондентПредставление,
			Выборка.Субконто2,
			Выборка.Субконто3,
			Выборка.ВалютаПредставление,
			Выборка.СуммаДокумента,
			Выборка.АналитическийСчетБрокераПредставление,
			Выборка.ДокументОснованиеПредставление);

		СтрокаСнимка = Новый Структура;
		СтрокаСнимка.Вставить("Ключ", Ключ);
		СтрокаСнимка.Вставить("ВидДохода", ВидДохода);
		СтрокаСнимка.Вставить("ДоговорДУКод", Строка(Выборка.ДоговорДУКод));
		СтрокаСнимка.Вставить("ДоговорДУ", Строка(Выборка.ДоговорДУНаименование));
		СтрокаСнимка.Вставить("Дата", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		СтрокаСнимка.Вставить("Контрагент", Строка(Выборка.КонтрагентПредставление));
		СтрокаСнимка.Вставить("АналитическийСчетБрокера", Строка(Выборка.АналитическийСчетБрокераПредставление));
		СтрокаСнимка.Вставить("СтатьяДДС", Строка(Выборка.СтатьяДДСПредставление));
		СтрокаСнимка.Вставить("СтатьяЗатрат", Строка(Выборка.СтатьяЗатратПредставление));
		СтрокаСнимка.Вставить("ВидОперации", Строка(Выборка.ВидОперацииПредставление));
		СтрокаСнимка.Вставить("СтрокаРазмешения", Строка(Выборка.СтрокаРазмешения));
		СтрокаСнимка.Вставить("Валюта", Строка(Выборка.ВалютаПредставление));
		СтрокаСнимка.Вставить("СуммаДокумента", Выборка.СуммаДокумента);
		СтрокаСнимка.Вставить("СуммаДокументаРуб", Выборка.СуммаДокументаРуб);
		СтрокаСнимка.Вставить("Курс", Выборка.КурсВзаиморасчетов);
		СтрокаСнимка.Вставить("Кратность", Выборка.КратностьВзаиморасчетов);
		СтрокаСнимка.Вставить("КоррСчетКод", Строка(Выборка.КоррСчетКод));
		СтрокаСнимка.Вставить("КоррСчет", Строка(Выборка.КоррСчетПредставление));
		СтрокаСнимка.Вставить("Корреспондент", Строка(Выборка.КорреспондентПредставление));
		СтрокаСнимка.Вставить("Субконто1", Строка(Выборка.Субконто1));
		СтрокаСнимка.Вставить("Субконто2", Строка(Выборка.Субконто2));
		СтрокаСнимка.Вставить("Субконто3", Строка(Выборка.Субконто3));
		СтрокаСнимка.Вставить("ДокументОснование", Строка(Выборка.ДокументОснованиеПредставление));
		// Номер/ссылка новой операции намеренно не входят в ключ сравнения (на чистой базе другие).

		Результат.Строки.Добавить(СтрокаСнимка);

	КонецЦикла;

	Результат.Мета.Вставить("ВерсияФормата", "1.1");
	Результат.Мета.Вставить("Источник", "ОперацияПоСчетуБрокера");
	Результат.Мета.Вставить("Обработка", "Распределение доходов по ценным бумагам");
	Результат.Мета.Вставить("Период", Формат(Дата1, "ДФ=yyyy-MM-dd"));
	Результат.Мета.Вставить("Пул", Строка(Пул));
	Результат.Мета.Вставить("ТолькоАвтоОбработка", ТолькоАвтоОбработка);
	Результат.Мета.Вставить("ДатаСнимка", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Результат.Мета.Вставить("Количество", Результат.Строки.Количество());
	Результат.Мета.Вставить("КоличествоНКД", Счетчики["НКД"]);
	Результат.Мета.Вставить("КоличествоПогашение", Счетчики["Погашение"]);
	Результат.Мета.Вставить("КоличествоДивиденды", Счетчики["Дивиденды"]);
	Результат.Мета.Вставить("ВремяВыполненияСек", ВремяВыполненияСек);
	Результат.Мета.Вставить("ВремяЗамерено", ВремяВыполненияСек > 0);
	Результат.Мета.Вставить("ВремяВыполненияПредставление", ПредставлениеИнтервалаСек(ВремяВыполненияСек));

	Результат.ТекстСводки =
		"Снимок: " + Результат.Мета.Количество + " операций"
		+ " (НКД=" + Счетчики["НКД"]
		+ ", Погашение=" + Счетчики["Погашение"]
		+ ", Дивиденды=" + Счетчики["Дивиденды"] + ")"
		+ "; пул=" + Строка(Пул)
		+ "; период=" + Формат(Дата1, "ДФ=dd.MM.yyyy");
	Если ВремяВыполненияСек > 0 Тогда
		Результат.ТекстСводки = Результат.ТекстСводки
			+ "; время Создать всё=" + ПредставлениеИнтервалаСек(ВремяВыполненияСек)
			+ " (" + Формат(ВремяВыполненияСек, "ЧРД=.; ЧН=0; ЧГ=0") + " сек)";
	Иначе
		Результат.ТекстСводки = Результат.ТекстСводки + "; время Создать всё=не замерялось";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Описание: Сериализует снимок в JSON-строку UTF-8 (без BOM-специфики платформы).
//
Функция СнимокВJSON(Снимок) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Windows, " "));
	ЗаписатьJSON(Запись, Снимок);
	Возврат Запись.Закрыть();

КонецФункции

// Описание: Сравнивает два JSON-снимка по бизнес-ключу. UUID/номера новых операций не участвуют.
//
// Параметры:
// JSONСтарый - Строка - содержимое файла ДО
// JSONНовый - Строка - содержимое файла ПОСЛЕ
//
// Возвращаемое значение:
// Структура - Успех (регресс данных), ТекстОтчёта, счётчики расхождений, поля сравнения времени
//
Функция СравнитьСнимкиJSON(JSONСтарый, JSONНовый) Экспорт

	Результат = Новый Структура(
		"Успех, ТекстОтчёта, КоличествоТолькоВСтаром, КоличествоТолькоВНовом, КоличествоРасхожденийПолей,"
		+ "ВремяДоСек, ВремяПослеСек, ДельтаСек, УскорениеПроцент, ВремяСравнено",
		Ложь, "", 0, 0, 0, 0, 0, 0, 0, Ложь);

	СнимокСтарый = ПрочитатьСнимокИзJSON(JSONСтарый);
	СнимокНовый = ПрочитатьСнимокИзJSON(JSONНовый);

	КартаСтарый = КартаСтрокПоКлючу(СнимокСтарый.Строки);
	КартаНовый = КартаСтрокПоКлючу(СнимокНовый.Строки);

	ТолькоВСтаром = Новый Массив;
	ТолькоВНовом = Новый Массив;
	РасхожденияПолей = Новый Массив;

	Для Каждого Элемент Из КартаСтарый Цикл
		Если КартаНовый.Получить(Элемент.Ключ) = Неопределено Тогда
			ТолькоВСтаром.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из КартаНовый Цикл
		Если КартаСтарый.Получить(Элемент.Ключ) = Неопределено Тогда
			ТолькоВНовом.Добавить(Элемент.Ключ);
		Иначе
			ТекстПолей = СравнитьПоляСтрок(КартаСтарый[Элемент.Ключ], Элемент.Значение);
			Если Не ПустаяСтрока(ТекстПолей) Тогда
				РасхожденияПолей.Добавить(Элемент.Ключ + Символы.ПС + ТекстПолей);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Результат.КоличествоТолькоВСтаром = ТолькоВСтаром.Количество();
	Результат.КоличествоТолькоВНовом = ТолькоВНовом.Количество();
	Результат.КоличествоРасхожденийПолей = РасхожденияПолей.Количество();
	Результат.Успех = (Результат.КоличествоТолькоВСтаром = 0)
		И (Результат.КоличествоТолькоВНовом = 0)
		И (Результат.КоличествоРасхожденийПолей = 0);

	Результат.ВремяДоСек = ЧислоИзМета(СнимокСтарый.Мета, "ВремяВыполненияСек");
	Результат.ВремяПослеСек = ЧислоИзМета(СнимокНовый.Мета, "ВремяВыполненияСек");
	Результат.ВремяСравнено = (Результат.ВремяДоСек > 0) И (Результат.ВремяПослеСек > 0);
	Если Результат.ВремяСравнено Тогда
		Результат.ДельтаСек = Результат.ВремяПослеСек - Результат.ВремяДоСек;
		Результат.УскорениеПроцент = -100 * Результат.ДельтаСек / Результат.ВремяДоСек;
	КонецЕсли;

	СтрокиОтчёта = Новый Массив;
	СтрокиОтчёта.Добавить("=== Сравнение: ВРЕМЯ + РЕГРЕСС ===");
	СтрокиОтчёта.Добавить("Дата отчёта: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	СтрокиОтчёта.Добавить("");
	СтрокиОтчёта.Добавить("--- ШАПКА: ВРЕМЯ «Создать всё» ---");
	Если Результат.ВремяСравнено Тогда
		СтрокиОтчёта.Добавить("ДО (старая обработка):    "
			+ ПредставлениеИнтервалаСек(Результат.ВремяДоСек)
			+ " (" + Формат(Результат.ВремяДоСек, "ЧРД=.; ЧН=0; ЧГ=0") + " сек)");
		СтрокиОтчёта.Добавить("ПОСЛЕ (новая обработка): "
			+ ПредставлениеИнтервалаСек(Результат.ВремяПослеСек)
			+ " (" + Формат(Результат.ВремяПослеСек, "ЧРД=.; ЧН=0; ЧГ=0") + " сек)");
		СтрокиОтчёта.Добавить("Дельта (ПОСЛЕ - ДО):     "
			+ Формат(Результат.ДельтаСек, "ЧРД=.; ЧН=0; ЧГ=0") + " сек");
		СтрокиОтчёта.Добавить("Изменение скорости:      "
			+ Формат(Результат.УскорениеПроцент, "ЧРД=.; ЧН=0; ЧГ=0")
			+ "% (плюс = быстрее, минус = медленнее)");
		Если Результат.ДельтаСек < 0 Тогда
			СтрокиОтчёта.Добавить("ИТОГ ПО ВРЕМЕНИ: ускорение на "
				+ Формат(-Результат.ДельтаСек, "ЧРД=.; ЧН=0; ЧГ=0") + " сек.");
		ИначеЕсли Результат.ДельтаСек > 0 Тогда
			СтрокиОтчёта.Добавить("ИТОГ ПО ВРЕМЕНИ: замедление на "
				+ Формат(Результат.ДельтаСек, "ЧРД=.; ЧН=0; ЧГ=0") + " сек.");
		Иначе
			СтрокиОтчёта.Добавить("ИТОГ ПО ВРЕМЕНИ: время одинаковое.");
		КонецЕсли;
	Иначе
		СтрокиОтчёта.Добавить("Время ДО: "
			+ ?(Результат.ВремяДоСек > 0, ПредставлениеИнтервалаСек(Результат.ВремяДоСек), "не замерялось"));
		СтрокиОтчёта.Добавить("Время ПОСЛЕ: "
			+ ?(Результат.ВремяПослеСек > 0, ПредставлениеИнтервалаСек(Результат.ВремяПослеСек), "не замерялось"));
		СтрокиОтчёта.Добавить("ИТОГ ПО ВРЕМЕНИ: не сравнивалось (в одном или обоих снимках время не замерялось). Регресс данных ниже — отдельно.");
	КонецЕсли;

	СтрокиОтчёта.Добавить("");
	СтрокиОтчёта.Добавить("--- ШАПКА: РЕГРЕСС ДАННЫХ ---");
	СтрокиОтчёта.Добавить("Строк в ДО: " + Формат(СнимокСтарый.Строки.Количество(), "ЧН=0; ЧГ=0"));
	СтрокиОтчёта.Добавить("Строк в ПОСЛЕ: " + Формат(СнимокНовый.Строки.Количество(), "ЧН=0; ЧГ=0"));
	СтрокиОтчёта.Добавить("Только в ДО (нет в ПОСЛЕ): " + Формат(Результат.КоличествоТолькоВСтаром, "ЧН=0; ЧГ=0"));
	СтрокиОтчёта.Добавить("Только в ПОСЛЕ (нет в ДО): " + Формат(Результат.КоличествоТолькоВНовом, "ЧН=0; ЧГ=0"));
	СтрокиОтчёта.Добавить("Расхождения полей при том же ключе: " + Формат(Результат.КоличествоРасхожденийПолей, "ЧН=0; ЧГ=0"));
	Если Результат.Успех Тогда
		СтрокиОтчёта.Добавить("ИТОГ ПО РЕГРЕССУ: ПРОЙДЕН. Расхождений нет.");
	Иначе
		СтрокиОтчёта.Добавить("ИТОГ ПО РЕГРЕССУ: НЕ ПРОЙДЕН. Есть расхождения.");
	КонецЕсли;

	СтрокиОтчёта.Добавить("");
	Если Результат.Успех И Результат.ВремяСравнено Тогда
		СтрокиОтчёта.Добавить("ОБЩИЙ ИТОГ: регресс OK; время см. шапку выше.");
	ИначеЕсли Результат.Успех Тогда
		СтрокиОтчёта.Добавить("ОБЩИЙ ИТОГ: регресс OK; время не замерялось (сравнение времени пропущено).");
	Иначе
		СтрокиОтчёта.Добавить("ОБЩИЙ ИТОГ: регресс НЕ пройден (см. детали ниже).");
	КонецЕсли;

	СтрокиОтчёта.Добавить("");
	СтрокиОтчёта.Добавить("--- Мета ДО ---");
	СтрокиОтчёта.Добавить(МетаВТекст(СнимокСтарый.Мета));
	СтрокиОтчёта.Добавить("--- Мета ПОСЛЕ ---");
	СтрокиОтчёта.Добавить(МетаВТекст(СнимокНовый.Мета));

	ДобавитьБлокКлючей(СтрокиОтчёта, "Ключи только в ДО (первые 50)", ТолькоВСтаром);
	ДобавитьБлокКлючей(СтрокиОтчёта, "Ключи только в ПОСЛЕ (первые 50)", ТолькоВНовом);
	ДобавитьБлокКлючей(СтрокиОтчёта, "Расхождения полей (первые 30)", РасхожденияПолей, 30);

	Результат.ТекстОтчёта = СтрСоединить(СтрокиОтчёта, Символы.ПС);
	Возврат Результат;

КонецФункции

Функция ОпределитьВидДоходаПоКоррСчету(КоррСчет)

	Если КоррСчет = ПланыСчетов.Хозрасчетный.РасчетыПоОблигациям Тогда
		Возврат "НКД";
	ИначеЕсли КоррСчет = ПланыСчетов.Хозрасчетный.РасчетыПоОблигациям_ПогашениеТела Тогда
		Возврат "Погашение";
	ИначеЕсли КоррСчет = ПланыСчетов.Хозрасчетный.РасчетыПоДивидендам Тогда
		Возврат "Дивиденды";
	Иначе
		Возврат "Прочее";
	КонецЕсли;

КонецФункции

Функция СформироватьБизнесКлюч(ДоговорКод, ВидДохода, КоррСчетКод, КорреспондентКод, Субконто2, Субконто3,
	ВалютаКод, Сумма, АналитическийСчет, Основание)

	Части = Новый Массив;
	Части.Добавить(СокрЛП(Строка(ДоговорКод)));
	Части.Добавить(СокрЛП(Строка(ВидДохода)));
	Части.Добавить(СокрЛП(Строка(КоррСчетКод)));
	Части.Добавить(СокрЛП(Строка(КорреспондентКод)));
	Части.Добавить(СокрЛП(Строка(Субконто2)));
	Части.Добавить(СокрЛП(Строка(Субконто3)));
	Части.Добавить(СокрЛП(Строка(ВалютаКод)));
	Части.Добавить(Формат(Сумма, "ЧРД=.; ЧН=0; ЧГ=0"));
	Части.Добавить(СокрЛП(Строка(АналитическийСчет)));
	Части.Добавить(СокрЛП(Строка(Основание)));
	Возврат СтрСоединить(Части, "|");

КонецФункции

Функция ПрочитатьСнимокИзJSON(СтрокаJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "JSON снимка должен быть объектом с полями Мета и Строки.";
	КонецЕсли;

	Снимок = Новый Структура("Мета, Строки", Новый Структура, Новый Массив);
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство("Мета") Тогда
			Снимок.Мета = Данные.Мета;
		КонецЕсли;
		Если Данные.Свойство("Строки") Тогда
			Снимок.Строки = Данные.Строки;
		КонецЕсли;
	Иначе
		Если Данные.Получить("Мета") <> Неопределено Тогда
			Снимок.Мета = Данные["Мета"];
		КонецЕсли;
		Если Данные.Получить("Строки") <> Неопределено Тогда
			Снимок.Строки = Данные["Строки"];
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(Снимок.Строки) <> Тип("Массив") Тогда
		ВызватьИсключение "В снимке отсутствует массив Строки.";
	КонецЕсли;

	Возврат Снимок;

КонецФункции

Функция КартаСтрокПоКлючу(Строки)

	Карта = Новый Соответствие;
	НомерБезКлюча = 0;

	Для Каждого СтрокаСнимка Из Строки Цикл
		Ключ = "";
		Если ТипЗнч(СтрокаСнимка) = Тип("Структура") Тогда
			Если СтрокаСнимка.Свойство("Ключ") Тогда
				Ключ = Строка(СтрокаСнимка.Ключ);
			КонецЕсли;
		ИначеЕсли ТипЗнч(СтрокаСнимка) = Тип("Соответствие") Тогда
			Если СтрокаСнимка.Получить("Ключ") <> Неопределено Тогда
				Ключ = Строка(СтрокаСнимка["Ключ"]);
			КонецЕсли;
		КонецЕсли;

		Если ПустаяСтрока(Ключ) Тогда
			НомерБезКлюча = НомерБезКлюча + 1;
			Ключ = "#NOKEY#" + Формат(НомерБезКлюча, "ЧГ=0");
		КонецЕсли;

		Карта.Вставить(Ключ, СтрокаСнимка);
	КонецЦикла;

	Возврат Карта;

КонецФункции

Функция СравнитьПоляСтрок(СтрокаСтарая, СтрокаНовая)

	Поля = "ВидДохода,ДоговорДУКод,СтатьяДДС,СтатьяЗатрат,ВидОперации,СтрокаРазмешения,Валюта,"
		+ "СуммаДокумента,СуммаДокументаРуб,Курс,Кратность,КоррСчетКод,Корреспондент,"
		+ "Субконто1,Субконто2,Субконто3,АналитическийСчетБрокера,ДокументОснование";
	Имена = СтрРазделить(Поля, ",", Ложь);
	Отличия = Новый Массив;

	Для Каждого ИмяПоля Из Имена Цикл
		ЗначениеСтарое = ЗначениеПоляСтроки(СтрокаСтарая, ИмяПоля);
		ЗначениеНовое = ЗначениеПоляСтроки(СтрокаНовая, ИмяПоля);
		Если НормализоватьДляСравнения(ЗначениеСтарое) <> НормализоватьДляСравнения(ЗначениеНовое) Тогда
			Отличия.Добавить("  " + ИмяПоля + ": [" + Строка(ЗначениеСтарое) + "] -> [" + Строка(ЗначениеНовое) + "]");
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Отличия, Символы.ПС);

КонецФункции

Функция ЗначениеПоляСтроки(СтрокаСнимка, ИмяПоля)

	Если ТипЗнч(СтрокаСнимка) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если СтрокаСнимка.Свойство(ИмяПоля, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(СтрокаСнимка) = Тип("Соответствие") Тогда
		Возврат СтрокаСнимка.Получить(ИмяПоля);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НормализоватьДляСравнения(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=0");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция МетаВТекст(Мета)

	Если Мета = Неопределено Тогда
		Возврат "(нет)";
	КонецЕсли;

	Строки = Новый Массив;
	Если ТипЗнч(Мета) = Тип("Структура") Тогда
		Для Каждого Элемент Из Мета Цикл
			Строки.Добавить(Элемент.Ключ + "=" + Строка(Элемент.Значение));
		КонецЦикла;
	ИначеЕсли ТипЗнч(Мета) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Мета Цикл
			Строки.Добавить(Строка(Элемент.Ключ) + "=" + Строка(Элемент.Значение));
		КонецЦикла;
	Иначе
		Строки.Добавить(Строка(Мета));
	КонецЕсли;

	Возврат СтрСоединить(Строки, "; ");

КонецФункции

Процедура ДобавитьБлокКлючей(СтрокиОтчёта, Заголовок, МассивКлючей, Лимит = 50)

	СтрокиОтчёта.Добавить("");
	СтрокиОтчёта.Добавить("--- " + Заголовок + " ---");
	Если МассивКлючей.Количество() = 0 Тогда
		СтрокиОтчёта.Добавить("(нет)");
		Возврат;
	КонецЕсли;

	Граница = Мин(МассивКлючей.Количество(), Лимит) - 1;
	Для Индекс = 0 По Граница Цикл
		СтрокиОтчёта.Добавить(Строка(МассивКлючей[Индекс]));
	КонецЦикла;
	Если МассивКлючей.Количество() > Лимит Тогда
		СтрокиОтчёта.Добавить("... ещё " + Формат(МассивКлючей.Количество() - Лимит, "ЧГ=0"));
	КонецЕсли;

КонецПроцедуры

Функция ЧислоИзМета(Мета, ИмяПоля)

	Если Мета = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Значение = Неопределено;
	Если ТипЗнч(Мета) = Тип("Структура") Тогда
		Если Не Мета.Свойство(ИмяПоля, Значение) Тогда
			Возврат 0;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Мета) = Тип("Соответствие") Тогда
		Значение = Мета.Получить(ИмяПоля);
	Иначе
		Возврат 0;
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(СтрЗаменить(Строка(Значение), ",", "."));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция ПредставлениеИнтервалаСек(Секунды)

	Если Секунды = Неопределено Или Секунды <= 0 Тогда
		Возврат "не замерялось";
	КонецЕсли;

	ВсегоСек = Цел(Секунды);
	Дробь = Секунды - ВсегоСек;
	Часы = Цел(ВсегоСек / 3600);
	Минуты = Цел((ВсегоСек - Часы * 3600) / 60);
	СекЦел = ВсегоСек - Часы * 3600 - Минуты * 60;
	СекСДробью = СекЦел + Дробь;

	Если Часы > 0 Тогда
		Возврат Формат(Часы, "ЧН=0; ЧГ=0") + " ч "
			+ Прав("0" + Формат(Минуты, "ЧГ=0"), 2) + " мин "
			+ Прав("0" + Формат(СекЦел, "ЧГ=0"), 2) + " сек";
	ИначеЕсли Минуты > 0 Тогда
		Возврат Формат(Минуты, "ЧН=0; ЧГ=0") + " мин "
			+ Формат(СекСДробью, "ЧРД=.; ЧН=0; ЧГ=0") + " сек";
	Иначе
		Возврат Формат(Секунды, "ЧРД=.; ЧН=0; ЧГ=0") + " сек";
	КонецЕсли;

КонецФункции
