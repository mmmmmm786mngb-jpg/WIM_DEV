
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаНачала = Дата(2026, 3, 18);
	ДатаОкончания = Дата(2026, 3, 18);
	КоличествоКУдалению = 10;
	ТолькоАвтоОбработка = Истина;
	ТекстРезультата = "Период и N заданы по умолчанию для тестовой базы."
		+ Символы.ПС + "Сначала нажмите «Посчитать найденные», затем «Удалить операции».";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПосчитатьНайденные(Команда)
	
	ТекстРезультата = ПосчитатьНайденныеНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОперации(Команда)
	
	Оповещение = Новый ОписаниеОповещения("УдалитьОперацииПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Удалить до " + Формат(КоличествоКУдалению, "ЧН=0; ЧГ=0")
			+ " документов ОперацияПоСчетуБрокера за период "
			+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - "
			+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy") + "?",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОперацииПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекстРезультата = УдалитьОперацииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПосчитатьНайденныеНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Количество = ОбработкаОбъект.КоличествоОперацийКУдалению(
		ДатаНачала, ДатаОкончания, ТолькоАвтоОбработка);
	
	Возврат "Найдено документов: " + Формат(Количество, "ЧН=0; ЧГ=0")
		+ Символы.ПС + "Период: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ Символы.ПС + "Фильтр по комментарию обработки: "
		+ ?(ТолькоАвтоОбработка, "да", "нет")
		+ Символы.ПС + "Лимит N на удаление: " + Формат(КоличествоКУдалению, "ЧН=0; ЧГ=0");
	
КонецФункции

&НаСервере
Функция УдалитьОперацииНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.УдалитьОперацииРаспределения(
		ДатаНачала, ДатаОкончания, КоличествоКУдалению, ТолькоАвтоОбработка);
	
	Возврат Результат.Текст;
	
КонецФункции

#КонецОбласти
