// Описание: Считает документы ОперацияПоСчетуБрокера за период по условиям отбора
//
Функция КоличествоОперацийКУдалению(ДатаНачала, ДатаОкончания, ТолькоАвтоОбработка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Операция.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ОперацияПоСчетуБрокера КАК Операция
	|ГДЕ
	|	Операция.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И НЕ Операция.ПометкаУдаления
	|	И (&БезФильтраКомментария
	|		ИЛИ Операция.Комментарий ПОДОБНО &Комментарий)";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("БезФильтраКомментария", Не ТолькоАвтоОбработка);
	Запрос.УстановитьПараметр("Комментарий", "%Распределение доходов по ценным бумагам%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Описание: Удаляет до N документов ОперацияПоСчетуБрокера за период
// Быстрый режим: отмена проведения, затем Удалить с ОбменДанными.Загрузка
// При доступности ФЗ и лимите потоков > 1 - удаление пачками параллельно
//
Функция УдалитьОперацииРаспределения(ДатаНачала, ДатаОкончания, КоличествоКУдалению, ТолькоАвтоОбработка) Экспорт
	
	Результат = Новый Структура("Удалено, Ошибок, НайденоВсего, Текст, Режим", 0, 0, 0, "", "");
	ВремяНачалаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Результат.Текст = "Укажите период удаления.";
		Возврат Результат;
	КонецЕсли;
	
	Если КоличествоКУдалению <= 0 Тогда
		Результат.Текст = "Количество к удалению (N) должно быть больше нуля.";
		Возврат Результат;
	КонецЕсли;
	
	СсылкиКУдалению = ПолучитьСсылкиОперацийКУдалению(ДатаНачала, ДатаОкончания,
		КоличествоКУдалению, ТолькоАвтоОбработка);
	Результат.НайденоВсего = КоличествоОперацийКУдалению(ДатаНачала, ДатаОкончания, ТолькоАвтоОбработка);
	
	Если СсылкиКУдалению.Количество() = 0 Тогда
		Результат.Текст = "Документов к удалению не найдено.";
		Возврат Результат;
	КонецЕсли;
	
	ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту(
		"ИмяОбъекта", ЭтотОбъект.Метаданные().Имя);
	ЛимитПотоков = 0;
	Если ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка)
		И ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены() Тогда
		ЛимитПотоков = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
	КонецЕсли;
	
	Если ЛимитПотоков > 1 Тогда
		Результат.Режим = "Параллельно, потоков=" + Формат(ЛимитПотоков, "ЧГ=0");
		ИтогПараллели = УдалитьСсылкиПараллельно(СсылкиКУдалению, ДополнительнаяОбработкаСсылка, ЛимитПотоков);
		Результат.Удалено = ИтогПараллели.Удалено;
		Результат.Ошибок = ИтогПараллели.Ошибок;
		ТекстОшибок = ИтогПараллели.ТекстОшибок;
	Иначе
		Результат.Режим = "Последовательно (быстрый)";
		ИтогПоследовательно = УдалитьСсылкиПоследовательно(СсылкиКУдалению);
		Результат.Удалено = ИтогПоследовательно.Удалено;
		Результат.Ошибок = ИтогПоследовательно.Ошибок;
		ТекстОшибок = ИтогПоследовательно.ТекстОшибок;
	КонецЕсли;
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс) / 1000;
	Скорость = ?(ДлительностьСек > 0, Результат.Удалено / ДлительностьСек, 0);
	
	СтрокиЛога = Новый Массив;
	СтрокиЛога.Добавить("Период: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));
	СтрокиЛога.Добавить("Найдено всего: " + Формат(Результат.НайденоВсего, "ЧН=0; ЧГ=0")
		+ "; к удалению по N: " + Формат(СсылкиКУдалению.Количество(), "ЧН=0; ЧГ=0"));
	СтрокиЛога.Добавить("Режим: " + Результат.Режим);
	СтрокиЛога.Добавить("Удалено: " + Формат(Результат.Удалено, "ЧН=0; ЧГ=0")
		+ "; ошибок: " + Формат(Результат.Ошибок, "ЧН=0; ЧГ=0"));
	СтрокиЛога.Добавить("Время: " + Формат(ДлительностьСек, "ЧДЦ=1; ЧН=0") + " сек; скорость: "
		+ Формат(Скорость, "ЧДЦ=1; ЧН=0") + " док/сек");
	Если Не ПустаяСтрока(ТекстОшибок) Тогда
		СтрокиЛога.Добавить("");
		СтрокиЛога.Добавить("Ошибки (первые):");
		СтрокиЛога.Добавить(ТекстОшибок);
	КонецЕсли;
	
	Результат.Текст = СтрСоединить(СтрокиЛога, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

// Описание: Фоновая обработка пачки ссылок на удаление
//
Процедура УдалитьПачкуОперацийВФоне(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	Если ТипЗнч(ПараметрыВыполнения) = Тип("Строка") Тогда
		ПараметрыВыполнения = XMLЗначение(Тип("ХранилищеЗначения"), ПараметрыВыполнения).Получить();
	КонецЕсли;
	
	Итог = УдалитьСсылкиПоследовательно(ПараметрыВыполнения.Ссылки);
	ПоместитьВоВременноеХранилище(XMLСтрока(Новый ХранилищеЗначения(Итог)), АдресХранилища);
	
КонецПроцедуры

Функция ПолучитьСсылкиОперацийКУдалению(ДатаНачала, ДатаОкончания, КоличествоКУдалению, ТолькоАвтоОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операция.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОперацияПоСчетуБрокера КАК Операция
	|ГДЕ
	|	Операция.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И НЕ Операция.ПометкаУдаления
	|	И (&БезФильтраКомментария
	|		ИЛИ Операция.Комментарий ПОДОБНО &Комментарий)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Операция.Дата УБЫВ,
	|	Операция.Номер УБЫВ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1",
		"ПЕРВЫЕ " + Формат(КоличествоКУдалению, "ЧГ=0"));
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("БезФильтраКомментария", Не ТолькоАвтоОбработка);
	Запрос.УстановитьПараметр("Комментарий", "%Распределение доходов по ценным бумагам%");
	
	Ссылки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Ссылки;
	
КонецФункции

Функция УдалитьСсылкиПоследовательно(Ссылки)
	
	Итог = Новый Структура("Удалено, Ошибок, ТекстОшибок", 0, 0, "");
	СтрокиОшибок = Новый Массив;
	
	Для Каждого СсылкаДокумента Из Ссылки Цикл
		
		Попытка
			УдалитьОднуОперациюБыстро(СсылкаДокумента);
			Итог.Удалено = Итог.Удалено + 1;
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			Если СтрокиОшибок.Количество() < 20 Тогда
				СтрокиОшибок.Добавить(Строка(СсылкаДокумента) + ": " + ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
	Итог.ТекстОшибок = СтрСоединить(СтрокиОшибок, Символы.ПС);
	
	Возврат Итог;
	
КонецФункции

// Описание: Отмена проведения (обычно), затем физическое удаление с ОбменДанными.Загрузка
//
Процедура УдалитьОднуОперациюБыстро(СсылкаДокумента)
	
	ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
	Если ОбъектДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбъектДокумента.Проведен Тогда
		ОбъектДокумента.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	ОбъектДокумента.ОбменДанными.Загрузка = Истина;
	ОбъектДокумента.Удалить();
	
КонецПроцедуры

Функция УдалитьСсылкиПараллельно(Ссылки, ДополнительнаяОбработкаСсылка, ЛимитПотоков)
	
	Итог = Новый Структура("Удалено, Ошибок, ТекстОшибок", 0, 0, "");
	СтрокиОшибок = Новый Массив;
	
	РазмерПачки = 50;
	Всего = Ссылки.Количество();
	Активные = Новый Массив;
	НомерПачки = 0;
	Индекс = 0;
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	
	Пока Индекс < Всего Или Активные.Количество() > 0 Цикл
		
		Пока Активные.Количество() < ЛимитПотоков И Индекс < Всего Цикл
			
			РазмерТекущейПачки = Мин(РазмерПачки, Всего - Индекс);
			СсылкиПачки = Новый Массив;
			Для Смещение = 0 По РазмерТекущейПачки - 1 Цикл
				СсылкиПачки.Добавить(Ссылки[Индекс + Смещение]);
			КонецЦикла;
			Индекс = Индекс + РазмерТекущейПачки;
			НомерПачки = НомерПачки + 1;
			
			ПараметрыПачки = Новый Структура("Ссылки, НомерПачки", СсылкиПачки, НомерПачки);
			
			ПараметрыМетода = Новый Структура;
			ПараметрыМетода.Вставить("ИмяМетода", "УдалитьПачкуОперацийВФоне");
			ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Истина);
			ПараметрыМетода.Вставить("ИмяОбработки", "");
			ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
			ПараметрыМетода.Вставить("ПараметрыВыполнения", XMLСтрока(Новый ХранилищеЗначения(ПараметрыПачки)));
			
			ПараметрыФона = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
			ПараметрыФона.ЗапуститьВФоне = Истина;
			ПараметрыФона.ОжидатьЗавершение = 0;
			ПараметрыФона.НаименованиеФоновогоЗадания =
				"Удаление операций ЦБ, пачка " + Формат(НомерПачки, "ЧГ=0");
			
			Контекст = ДлительныеОперации.ВыполнитьВФоне(
				"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
				ПараметрыМетода,
				ПараметрыФона);
			
			Активные.Добавить(Новый Структура("Контекст, Количество", Контекст, СсылкиПачки.Количество()));
			
		КонецЦикла;
		
		Если Активные.Количество() > 0
			И ЗначениеЗаполнено(Активные[0].Контекст.ИдентификаторЗадания) Тогда
			Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
				Активные[0].Контекст.ИдентификаторЗадания);
			Если Задание <> Неопределено Тогда
				Попытка
					Задание.ОжидатьЗавершения(0.5);
				Исключение
					// Статус ниже через ОперацияВыполнена
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		ИндексАктивных = Активные.ВГраница();
		Пока ИндексАктивных >= 0 Цикл
			
			Описание = Активные[ИндексАктивных];
			Контекст = Описание.Контекст;
			
			Если ЗначениеЗаполнено(Контекст.ИдентификаторЗадания) Тогда
				СтатусЗадания = ДлительныеОперации.ОперацияВыполнена(Контекст.ИдентификаторЗадания, Ложь);
				Если СтатусЗадания.Статус = "Выполняется" Тогда
					ИндексАктивных = ИндексАктивных - 1;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ИтогПачки = Неопределено;
			Если ЗначениеЗаполнено(Контекст.АдресРезультата) Тогда
				ЗначениеРезультата = ПолучитьИзВременногоХранилища(Контекст.АдресРезультата);
				Если ТипЗнч(ЗначениеРезультата) = Тип("Строка") И Не ПустаяСтрока(ЗначениеРезультата) Тогда
					Попытка
						ИтогПачки = XMLЗначение(Тип("ХранилищеЗначения"), ЗначениеРезультата).Получить();
					Исключение
						ИтогПачки = Неопределено;
					КонецПопытки;
				ИначеЕсли ТипЗнч(ЗначениеРезультата) = Тип("Структура") Тогда
					ИтогПачки = ЗначениеРезультата;
				КонецЕсли;
			КонецЕсли;
			
			Если ТипЗнч(ИтогПачки) = Тип("Структура") Тогда
				Итог.Удалено = Итог.Удалено + ИтогПачки.Удалено;
				Итог.Ошибок = Итог.Ошибок + ИтогПачки.Ошибок;
				Если Не ПустаяСтрока(ИтогПачки.ТекстОшибок) И СтрокиОшибок.Количество() < 20 Тогда
					СтрокиОшибок.Добавить(ИтогПачки.ТекстОшибок);
				КонецЕсли;
			Иначе
				Итог.Ошибок = Итог.Ошибок + Описание.Количество;
			КонецЕсли;
			
			Активные.Удалить(ИндексАктивных);
			ИндексАктивных = ИндексАктивных - 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Итог.ТекстОшибок = СтрСоединить(СтрокиОшибок, Символы.ПС);
	
	Возврат Итог;
	
КонецФункции
