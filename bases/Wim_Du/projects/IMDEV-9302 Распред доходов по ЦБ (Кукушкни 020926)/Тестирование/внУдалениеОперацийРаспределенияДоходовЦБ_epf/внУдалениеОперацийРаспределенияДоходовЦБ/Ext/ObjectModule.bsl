КонецФункции

// Описание: Считает документы ОперацияПоСчетуБрокера за период по условиям отбора
//
// Параметры:
//  ДатаНачала - Дата - начало периода
//  ДатаОкончания - Дата - конец периода
//  ТолькоАвтоОбработка - Булево - отбирать по комментарию обработки распределения
//
// Возвращаемое значение:
//  Число - количество найденных документов без пометки удаления
//
Функция КоличествоОперацийКУдалению(ДатаНачала, ДатаОкончания, ТолькоАвтоОбработка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Операция.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ОперацияПоСчетуБрокера КАК Операция
	|ГДЕ
	|	Операция.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И НЕ Операция.ПометкаУдаления
	|	И (&БезФильтраКомментария
	|		ИЛИ Операция.Комментарий ПОДОБНО &Комментарий)";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("БезФильтраКомментария", Не ТолькоАвтоОбработка);
	Запрос.УстановитьПараметр("Комментарий", "%Распределение доходов по ценным бумагам%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Описание: Удаляет до N документов ОперацияПоСчетуБрокера за период
// Сначала отменяет проведение, затем удаляет физически
//
// Параметры:
//  ДатаНачала - Дата - начало периода
//  ДатаОкончания - Дата - конец периода
//  КоличествоКУдалению - Число - максимум документов к удалению
//  ТолькоАвтоОбработка - Булево - отбирать по комментарию обработки распределения
//
// Возвращаемое значение:
//  Структура - Удалено, Ошибок, НайденоВсего, Текст (Строка с логом)
//
Функция УдалитьОперацииРаспределения(ДатаНачала, ДатаОкончания, КоличествоКУдалению, ТолькоАвтоОбработка) Экспорт
	
	Результат = Новый Структура("Удалено, Ошибок, НайденоВсего, Текст", 0, 0, 0, "");
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Результат.Текст = "Укажите период удаления.";
		Возврат Результат;
	КонецЕсли;
	
	Если КоличествоКУдалению <= 0 Тогда
		Результат.Текст = "Количество к удалению (N) должно быть больше нуля.";
		Возврат Результат;
	КонецЕсли;
	
	Результат.НайденоВсего = КоличествоОперацийКУдалению(ДатаНачала, ДатаОкончания, ТолькоАвтоОбработка);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операция.Ссылка КАК Ссылка,
	|	Операция.Номер КАК Номер,
	|	Операция.Дата КАК Дата
	|ИЗ
	|	Документ.ОперацияПоСчетуБрокера КАК Операция
	|ГДЕ
	|	Операция.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И НЕ Операция.ПометкаУдаления
	|	И (&БезФильтраКомментария
	|		ИЛИ Операция.Комментарий ПОДОБНО &Комментарий)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Операция.Дата УБЫВ,
	|	Операция.Номер УБЫВ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1",
		"ПЕРВЫЕ " + Формат(КоличествоКУдалению, "ЧГ=0"));
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("БезФильтраКомментария", Не ТолькоАвтоОбработка);
	Запрос.УстановитьПараметр("Комментарий", "%Распределение доходов по ценным бумагам%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	СтрокиЛога = Новый Массив;
	СтрокиЛога.Добавить("Период: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));
	СтрокиЛога.Добавить("Найдено всего (без лимита N): " + Формат(Результат.НайденоВсего, "ЧН=0; ЧГ=0"));
	СтрокиЛога.Добавить("Лимит N: " + Формат(КоличествоКУдалению, "ЧН=0; ЧГ=0"));
	СтрокиЛога.Добавить("");
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ОбъектДокумента = Выборка.Ссылка.ПолучитьОбъект();
			
			Если ОбъектДокумента.Проведен Тогда
				ОбъектДокумента.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			
			ОбъектДокумента.Удалить();
			Результат.Удалено = Результат.Удалено + 1;
			СтрокиЛога.Добавить("Удален: " + Строка(Выборка.Ссылка));
			
		Исключение
			
			Результат.Ошибок = Результат.Ошибок + 1;
			СтрокиЛога.Добавить("Ошибка: " + Строка(Выборка.Ссылка) + " - " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
	СтрокиЛога.Добавить("");
	СтрокиЛога.Добавить("Итого удалено: " + Формат(Результат.Удалено, "ЧН=0; ЧГ=0")
		+ "; ошибок: " + Формат(Результат.Ошибок, "ЧН=0; ЧГ=0"));
	
	Результат.Текст = СтрСоединить(СтрокиЛога, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции
