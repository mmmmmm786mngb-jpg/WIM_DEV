// IMDEV-9314: оптимизация запросов зафиксированных котировок БУ и УУ.
// База сравнения: типовая 1.5.29.7. Перехват &Вместо: полная замена тела функций.

// Описание: Собирает таблицу значений активов из списка ЦБ для параметра запроса.
// Один параметр &ТаблицаАктивов вместо IN (&СписокЦБ), чтобы не упираться в лимит параметров SQL.
//
// Параметры:
// СписокЦБ - Массив, СписокЗначений - ссылки на справочник Активы
//
// Возвращаемое значение:
// ТаблицаЗначений - колонка Актив (СправочникСсылка.Активы)
//
Функция IM9314_ТаблицаАктивовИзСпискаЦБ(СписокЦБ) // IMDEV-9314
	
	ТаблицаАктивов = Новый ТаблицаЗначений;
	ТаблицаАктивов.Колонки.Добавить("Актив", Новый ОписаниеТипов("СправочникСсылка.Активы"));
	
	Если Не ЗначениеЗаполнено(СписокЦБ) Тогда
		Возврат ТаблицаАктивов;
	КонецЕсли;
	
	Для Каждого ТекАктив Из СписокЦБ Цикл
		СтрокаТЗ = ТаблицаАктивов.Добавить();
		Если ТипЗнч(ТекАктив) = Тип("ЭлементСпискаЗначений") Тогда
			СтрокаТЗ.Актив = ТекАктив.Значение;
		Иначе
			СтрокаТЗ.Актив = ТекАктив;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаАктивов;
	
КонецФункции

&Вместо("ЗафиксированныеКотировкиБУ")
Функция IM9314_ЗафиксированныеКотировкиБУ(СписокЦБ, СписокБирж) // IMDEV-9314
	
	МенеджерВТ 	= Новый МенеджерВременныхТаблиц;
	Запрос 		= Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	// IMDEV-9314++
	ТаблицаАктивов = IM9314_ТаблицаАктивовИзСпискаЦБ(СписокЦБ);
	// IMDEV-9314--
	
	Запрос.УстановитьПараметр("Дата",		НачалоДня(Дата));
	Запрос.УстановитьПараметр("ДоговорДУ",	ДоговорДУ);
	// IMDEV-9314++
	Запрос.УстановитьПараметр("ТаблицаАктивов", ТаблицаАктивов);
	// IMDEV-9314--
	Запрос.УстановитьПараметр("СписокБирж", СписокБирж);
	Запрос.УстановитьПараметр("ПустаяДата",	'00010101');
	
	// IMDEV-9314++
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаАктивов.Актив КАК Актив
	|ПОМЕСТИТЬ втАктивы
	|ИЗ
	|	&ТаблицаАктивов КАК ТаблицаАктивов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Актив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КотировкиЦБНаБиржеСрезПоследних.Актив КАК Актив,
	|	КотировкиЦБНаБиржеСрезПоследних.Валюта КАК Валюта,
	|	МАКСИМУМ(КотировкиЦБНаБиржеСрезПоследних.МинимальнаяЦена) КАК МинимальнаяЦена,
	|	МАКСИМУМ(КотировкиЦБНаБиржеСрезПоследних.МаксимальнаяЦена) КАК МаксимальнаяЦена
	|ПОМЕСТИТЬ ВТ_КотировкиЦБ
	|ИЗ
	|	РегистрСведений.КотировкиЦБНаБирже.СрезПоследних(
	|			&Дата,
	|			Биржа В (&СписокБирж)) КАК КотировкиЦБНаБиржеСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втАктивы КАК втАктивы
	|		ПО КотировкиЦБНаБиржеСрезПоследних.Актив = втАктивы.Актив
	|
	|СГРУППИРОВАТЬ ПО
	|	КотировкиЦБНаБиржеСрезПоследних.Актив,
	|	КотировкиЦБНаБиржеСрезПоследних.Валюта
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КотировкиЦБНаБиржеСрезПоследних.Актив,
	|	КотировкиЦБНаБиржеСрезПоследних.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Котировки.Актив,
	|	Котировки.Валюта,
	|	Котировки.Котировка,
	|	Котировки.Расчетная,
	|	Котировки.МинимальнаяЦена,
	|	Котировки.МаксимальнаяЦена,
	|	Котировки.Биржа,
	|	ВЫБОР
	|		КОГДА Котировки.ДатаОпределения = &ПустаяДата
	|			ТОГДА Котировки.Период
	|		ИНАЧЕ Котировки.ДатаОпределения
	|	КОНЕЦ КАК ДатаОпределения
	|ПОМЕСТИТЬ втСрезЗафиксированных
	|ИЗ
	|	РегистрСведений.ЗафиксированныеКотировкиЦБ_БУ.СрезПоследних(
	|			&Дата,
	|			ДоговорДУ = &ДоговорДУ
	|				И Расчетная = ЛОЖЬ) КАК Котировки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Актив,
	|	Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Котировки.Актив,
	|	Котировки.Валюта,
	|	Котировки.Котировка,
	|	Котировки.Расчетная,
	|	ЕСТЬNULL(ВТ_КотировкиЦБ.МинимальнаяЦена, Котировки.МинимальнаяЦена) КАК МинимальнаяЦена,
	|	ЕСТЬNULL(ВТ_КотировкиЦБ.МаксимальнаяЦена, Котировки.МаксимальнаяЦена) КАК МаксимальнаяЦена,
	|	Котировки.Биржа,
	|	Котировки.ДатаОпределения
	|ПОМЕСТИТЬ АктуальныеКотировки
	|ИЗ
	|	втСрезЗафиксированных КАК Котировки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втАктивы КАК втАктивы
	|		ПО Котировки.Актив = втАктивы.Актив
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КотировкиЦБ КАК ВТ_КотировкиЦБ
	|		ПО Котировки.Актив = ВТ_КотировкиЦБ.Актив
	|			И Котировки.Валюта = ВТ_КотировкиЦБ.Валюта
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Котировки.Актив,
	|	ДатаОпределения";
	// IMDEV-9314--
	
	Запрос.Выполнить();
	
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "Документ.УстановкаКотировок.ЗафиксированныеКотировкиБУ()");
	
	Возврат МенеджерВТ;
	
КонецФункции

