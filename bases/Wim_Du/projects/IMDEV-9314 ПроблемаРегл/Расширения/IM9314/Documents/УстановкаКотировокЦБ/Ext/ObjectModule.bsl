	|	ДатаОпределения";
	// IMDEV-9314--
	
	Запрос.Выполнить();
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "Документ.УстановкаКотировок.ЗафиксированныеКотировкиУУ()");
	
	Возврат МенеджерВТ;
	
