			ТекстОшибки = ОписаниеОшибки();
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Ошибка записи суммы вывода ДС. %1'"), ТекстОшибки);
			ЗаписьЖурналаРегистрации("Розничное ДУ: Расторжение в период охлаждения .", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		КонецПопытки;
	КонецЕсли;

