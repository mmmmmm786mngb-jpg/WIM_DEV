		|	ВТ_ДокументыПлатежейДоговорДУ КАК ВТ_ДокументыПлатежейДоговорДУ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДокументыПлатежейДоговорДУ.НачислениеВознаграждения
		|ИЗ
		|	ВТ_ДокументыПлатежейДоговорДУ КАК ВТ_ДокументыПлатежейДоговорДУ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДокументыПлатежейДоговорДУ.НачислениеКомиссииДосрочныйВывод
		|ИЗ
		|	ВТ_ДокументыПлатежейДоговорДУ КАК ВТ_ДокументыПлатежейДоговорДУ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДокументыПлатежейДоговорДУ.НачислениеВознагражденияРегулярное
		|ИЗ
		|	ВТ_ДокументыПлатежейДоговорДУ КАК ВТ_ДокументыПлатежейДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИсторияСтатусовОбъектовСрезПоследних.Объект КАК ДокументСтатуса,
		|	ИсторияСтатусовОбъектовСрезПоследних.Статус КАК Статус
		|ПОМЕСТИТЬ ВТ_СтатусыДокументов
		|ИЗ
		|	РегистрСведений.ИсторияСтатусовОбъектов.СрезПоследних(
		|			,
		|			Объект В
		|				(ВЫБРАТЬ
		|					ДокументыДляСтатусов.ДокументДляСтатуса
		|				ИЗ
		|					ВТ_ДокументыДляСтатусов КАК ДокументыДляСтатусов)) КАК ИсторияСтатусовОбъектовСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДокументСтатуса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорыДУ.ДоговорДУ КАК ДоговорДУ,
		|	ДоговорыДУ.РасторжениеВПериодОхлаждения КАК РасторжениеВПериодОхлаждения,
		|	ДоговорыДУ.АналитическийСчетДС КАК АналитическийСчет,
		|	ДоговорыДУ.ДатаРасторжения КАК ДатаРасторжения,
		|	ОстатокБумагДоговорДУ.ОстатокБумаг = 0
		|		И ЕСТЬNULL(ОстатокДС.СуммаРасчетыПоСделкам, 0) = 0
		|		И ЕСТЬNULL(ОстатокДС.СуммаРасчетыПоКупону, 0) = 0
		|		И ЕСТЬNULL(ОстатокДС.СуммаРасчетыПоПогашениюЦБ, 0) = 0 КАК БумагиПроданы,
		|	ОстатокБумагДоговорДУ.ОстатокБумаг = 0 КАК БумагиБезОборот,
		|	ЕСТЬNULL(ВводДоговорДУ.Сумма, 0) КАК СуммаВводаДС,
		|	СпрДоговорДУ.Код КАК НомерДУ,
		|	ДокументыПлатежейДоговорДУ.ПоручениеПоДСНаВывод КАК ПоручениеПоДСНаВывод,
		|	ДокументыПлатежейДоговорДУ.ПлатежноеПоручениеНаВывод КАК ПлатежноеПоручениеНаВывод,
		|	ДокументыПлатежейДоговорДУ.ПоручениеПоДСПеревод КАК ПоручениеПоДСНаПеревод,
		|	ДокументыПлатежейДоговорДУ.ПлатежноеПоручениеНаПеревод КАК ПлатежноеПоручениеНаПеревод,
		|	ДокументыПлатежейДоговорДУ.ПоручениеПоДСНаВвод КАК ПоручениеПоДСНаВвод,
		|	ДокументыПлатежейДоговорДУ.ПоручениеПоДСНаБиржу КАК ПоручениеПоДСНаБиржу,
		|	ДокументыПлатежейДоговорДУ.ПоступлениеКомпенсации КАК ПоступлениеКомпенсации,
		|	ДокументыПлатежейДоговорДУ.СуммаКомпенсации КАК СуммаКомпенсации,
		|	ДокументыПлатежейДоговорДУ.СписаниеДС КАК СписаниеДС,
		|	ДокументыПлатежейДоговорДУ.СуммаПеревода КАК СуммаПеревода,
		|	ДокументыПлатежейДоговорДУ.СуммаСписанияДС КАК СуммаСписанияДС,
		|	ДокументыПлатежейДоговорДУ.НачислениеВознаграждения КАК НачислениеВознаграждения,
		|	ДокументыПлатежейДоговорДУ.НачислениеКомиссииДосрочныйВывод КАК НачислениеКомиссииДосрочныйВывод,
		|	ДокументыПлатежейДоговорДУ.НачислениеВознагражденияРегулярное КАК НачислениеВознагражденияРегулярное,
		|	ДокументыПлатежейДоговорДУ.ПлатежноеПоручениеВознаграждение КАК ПлатежноеПоручениеВознаграждение,
		|	ДокументыПлатежейДоговорДУ.ПлатежноеПоручениеВознаграждениеРегулярное КАК ПлатежноеПоручениеВознаграждениеРегулярное,
		|	ДокументыПлатежейДоговорДУ.ПлатежноеПоручениеКомиссииДосрочныйВывод КАК ПлатежноеПоручениеКомиссииДосрочныйВывод,
		|	ДокументыПлатежейДоговорДУ.НДФЛНачислен КАК НДФЛНачислен,
		|	ДокументыПлатежейДоговорДУ.НачислениеЗадолженностиНДФЛ КАК НачислениеЗадолженностиНДФЛ,
		|	ДокументыПлатежейДоговорДУ.ПлатежноеПоручениеНДФЛ КАК ПлатежноеПоручениеНДФЛ,
		|	ДокументыПлатежейДоговорДУ.СуммаНДФЛ КАК СуммаНДФЛ,
		|	ДокументыПлатежейДоговорДУ.ПлатежныеПорученияНДФЛ КАК ПлатежныеПорученияНДФЛ,
		|	ЕСТЬNULL(СтатусыПорученияНаБиржу.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.ПустаяСсылка)) КАК СтатусПорученияНаБиржу,
		|	ЕСТЬNULL(СтатусыПорученияНаВывод.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.ПустаяСсылка)) КАК СтатусПорученияНаВывод,
		|	ЕСТЬNULL(СтатусыПорученияПеревод.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.ПустаяСсылка)) КАК СтатусПорученияПеревод,
		|	ЕСТЬNULL(ДополнительныеСведения.Значение, ЛОЖЬ) КАК ПереводДСВыполнен,
		|	ЕСТЬNULL(СтатусыПоручениеПоДСНаВвод.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.ПустаяСсылка)) КАК СтатусПорученияНаВвод,
		|	ЕСТЬNULL(СтатусыНачислениеНДФЛ.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.ПустаяСсылка)) КАК СтатусНачислениеНДФЛ,
		|	ЕСТЬNULL(СтатусыНачислениеВознаграждения.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.ПустаяСсылка)) КАК СтатусНачислениеВознаграждения,
		|	ЕСТЬNULL(СтатусыНачислениеКомиссииДосрочныйВывод.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.ПустаяСсылка)) КАК СтатусНачислениеКомиссииДосрочныйВывод,
		|	ЕСТЬNULL(СтатусыНачислениеВознагражденияРегулярные.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.ПустаяСсылка)) КАК СтатусНачислениеВознагражденияРегулярное,
		|	ЕСТЬNULL(ОстатокДС.СуммаНаРС, 0) КАК СуммаНаРС,
		|	ЕСТЬNULL(ОстатокДС.СуммаНаБрС, 0) КАК СуммаНаБрС,
		|	ЕСТЬNULL(ОстатокДС.СуммаРасчетыПоСделкам, 0) КАК СуммаРасчетыПоСделкам,
		|	ЕСТЬNULL(ОстатокДС.СуммаРасчетыПоКупону, 0) КАК СуммаРасчетыПоКупону,
		|	ЕСТЬNULL(ОстатокДС.СуммаРасчетыПоПогашениюЦБ, 0) КАК СуммаРасчетыПоПогашениюЦБ,
		|	ОстатокБумагДоговорДУ.ОстатокБумаг КАК ОстатокБумаг,
		|	ДокументыПлатежейДоговорДУ.СуммаВознаграждения КАК СуммаВознаграждения,
		|	ДокументыПлатежейДоговорДУ.СуммаКомиссияДосочныйВывод КАК СуммаКомиссияДосочныйВывод,
		|	ДокументыПлатежейДоговорДУ.СуммаВознагражденияРегулярное КАК СуммаВознагражденияРегулярное
		|ИЗ
		|	ВТ_ДоговорыДУ КАК ДоговорыДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВводДоговорДУ КАК ВводДоговорДУ
		|		ПО ДоговорыДУ.ДоговорДУ = ВводДоговорДУ.ДоговорДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорДУ КАК СпрДоговорДУ
		|		ПО ДоговорыДУ.ДоговорДУ = СпрДоговорДУ.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДокументыПлатежейДоговорДУ КАК ДокументыПлатежейДоговорДУ
		|		ПО ДоговорыДУ.ДоговорДУ = ДокументыПлатежейДоговорДУ.ДоговорДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|		ПО (ДокументыПлатежейДоговорДУ.ПоручениеПоДСПеревод = ДополнительныеСведения.Объект)
		|			И (ДополнительныеСведения.Свойство = &ПризнакПереводаДС)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстатокБумагДоговорДУ КАК ОстатокБумагДоговорДУ
		|		ПО ДоговорыДУ.ДоговорДУ = ОстатокБумагДоговорДУ.ДоговорДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыДокументов КАК СтатусыПорученияНаБиржу
		|		ПО (ДокументыПлатежейДоговорДУ.ПоручениеПоДСНаБиржу = СтатусыПорученияНаБиржу.ДокументСтатуса)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыДокументов КАК СтатусыПорученияНаВывод
		|		ПО (ДокументыПлатежейДоговорДУ.ПоручениеПоДСНаВывод = СтатусыПорученияНаВывод.ДокументСтатуса)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыДокументов КАК СтатусыПорученияПеревод
		|		ПО (ДокументыПлатежейДоговорДУ.ПоручениеПоДСПеревод = СтатусыПорученияПеревод.ДокументСтатуса)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыДокументов КАК СтатусыПоручениеПоДСНаВвод
		|		ПО (ДокументыПлатежейДоговорДУ.ПоручениеПоДСНаВвод = СтатусыПоручениеПоДСНаВвод.ДокументСтатуса)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыДокументов КАК СтатусыНачислениеНДФЛ
		|		ПО (ДокументыПлатежейДоговорДУ.НачислениеЗадолженностиНДФЛ = СтатусыНачислениеНДФЛ.ДокументСтатуса)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыДокументов КАК СтатусыНачислениеВознаграждения
		|		ПО (ДокументыПлатежейДоговорДУ.НачислениеВознаграждения = СтатусыНачислениеВознаграждения.ДокументСтатуса)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыДокументов КАК СтатусыНачислениеКомиссииДосрочныйВывод
		|		ПО (ДокументыПлатежейДоговорДУ.НачислениеКомиссииДосрочныйВывод = СтатусыНачислениеКомиссииДосрочныйВывод.ДокументСтатуса)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыДокументов КАК СтатусыНачислениеВознагражденияРегулярные
		|		ПО (ДокументыПлатежейДоговорДУ.НачислениеВознагражденияРегулярное = СтатусыНачислениеВознагражденияРегулярные.ДокументСтатуса)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстатокДС КАК ОстатокДС
		|		ПО ДоговорыДУ.ДоговорДУ = ОстатокДС.ДоговорДУ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаРасторжения";
	
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("ДатаМинВводДС", МинимальнаяДатаВводаДС);
	Запрос.УстановитьПараметр("Пул", Пул);
	Запрос.УстановитьПараметр("ТестовыйРежим", ТестовыйРежим);
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ_тест);
	Запрос.УстановитьПараметр("ВыборДоговораДУ", ЗначениеЗаполнено(ДоговорДУ_тест));
	Запрос.УстановитьПараметр("ПризнакПереводаДС", ПризнакПереводаДС);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;

КонецФункции

Функция ЗакрытьДОУведомлениеРасторжения(Сервис, НомерДУ, ДатаОкончания)

	Результат = Сервис.SetRetailAgreementClosed(НомерДУ, ДатаОкончания);
	СтруктураJSON = ПолучитьСтруктураJSON(Результат);
	
	Возврат СтруктураJSON.Статус;

КонецФункции

Функция ПолучитьСервис(АдресВеб, Логин, Пароль)
	
	Попытка
	
		Определения = Новый WSОпределения(АдресВеб, Логин, Пароль,, 600);
		URIПространстваИмен = Определения.Сервисы[0].URIПространстваИмен;
		ИмяСервиса = Определения.Сервисы[0].Имя;
		ТочкаПодключения = Определения.Сервисы[0].ТочкиПодключения[1].Имя;
		Прокси = Новый WSПрокси(Определения, URIПространстваИмен, ИмяСервиса, ТочкаПодключения, 600);
		Прокси.Пользователь = Логин;
		Прокси.Пароль = Пароль;
	
	Исключение
		
		
	КонецПопытки;

	Возврат Прокси;

КонецФункции

Функция  ПолучитьСтруктураJSON(СтрокаJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Значение = ПрочитатьJSON(ЧтениеJSON,,, ФорматДатыJSON.ISO);
	ЧтениеJSON.Закрыть();
	
	Возврат Значение;

КонецФункции

Функция ДоговорПоНомеру(НомерДУ)
	
	ДоговорДУ = Справочники.ДоговорДУ.НайтиПоКоду(НомерДУ);
	ДоговорДУ = ?(ДоговорДУ = Неопределено, Справочники.ДоговорДУ.ПустаяСсылка(), ДоговорДУ);
	Возврат ДоговорДУ;

КонецФункции

Процедура УстановитьДатуРасторжения(ДоговорДУ, ДатаРасторжения)

	ДоговорДУОбъект = ДоговорДУ.ПолучитьОбъект();
	ДоговорДУОбъект.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДатаРасторжения;
	ДоговорДУОбъект.Записать();

КонецПроцедуры

Функция СтатусыДокументов(ВыборкаДетальныеЗаписи)

	СтатусыДокументов = Новый Массив;
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусНачислениеНДФЛ);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусПорученияНаВывод);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусПорученияПеревод);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусПорученияНаБиржу);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусПорученияНаВвод);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусНачислениеВознаграждения);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусНачислениеКомиссииДосрочныйВывод);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусНачислениеВознагражденияРегулярное);
	
	Возврат СтатусыДокументов;

КонецФункции

Функция ЗакрытьДоговор(ДоговорДУ, СервисДО, СтатусыДокументов, СуммаСЧА, НомерДУ)

	ДоговорДУЗакрыт = СуммаСЧА = 0;
	Для каждого СтатусДокумента Из СтатусыДокументов Цикл
		
		ДоговорДУЗакрыт = СтатусДокумента = Перечисления.СтатусыОбъектов.Исполнено 
						Или СтатусДокумента = Перечисления.СтатусыОбъектов.ПустаяСсылка();
		
		Если ДоговорДУЗакрыт = Ложь Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДоговорДУЗакрыт Тогда
		ДатаОкончания = ?(ДатаЗакрытияПредыдущийРабочийДень, БлижайшийРабочийДень(ДатаРасчета, Истина), ДатаРасчета);
		УстановитьДатуЗакрытия(ДоговорДУ, ДатаОкончания);
		Если СервисДО <> Неопределено Тогда
			ЗакрытьДОУведомлениеРасторжения(СервисДО, НомерДУ, ДатаОкончания);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДоговорДУЗакрыт;

КонецФункции

Процедура УстановитьДатуЗакрытия(ДоговорДУ, ДатаОкончания)

	ДоговорДУОбъект = ДоговорДУ.ПолучитьОбъект();
	ДоговорДУОбъект.ДатаОкончания = ДатаОкончания;
	ДоговорДУОбъект.Записать();

КонецПроцедуры

Функция ПорученияДС(Данные)
	
	ПоручениеПоДС = ПоручениеПоДС(Данные.ДоговорДУ, Данные.Контрагент, Данные.ВидОперации, Данные.Комментарий);
	
	СтатусПоручениеПоДС = ?(ПоручениеПоДС.Ссылка = Документы.Поручение.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
				ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ПоручениеПоДС.Ссылка));
	
	Если СтатусПоручениеПоДС = Перечисления.СтатусыОбъектов.Исполнено Тогда
		Возврат ПоручениеПоДС;
	КонецЕсли;
	
	ВалютаВыплаты = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	
	ПоручениеПоДС.Дата = БлижайшийРабочийДень(Данные.ДатаПоручения) + 32400;
	ПоручениеПоДС.ВходящийНомер = Данные.НомерРасторжения;
	ПоручениеПоДС.ВходящаяДата = Данные.ДатаРасторжения;
	ПоручениеПоДС.Комментарий = Данные.Комментарий;
	ПоручениеПоДС.ДоговорДУ = Данные.ДоговорДУ;
	
	ПоручениеПоДС.АналитическийСчетИсточник = Данные.АналитическийСчетИсточник;
	ПоручениеПоДС.АналитическийСчетПриемник = Данные.АналитическийСчетПриемник;
	
	ПоручениеПоДС.ВидОперации = Данные.ВидОперации;
	ПоручениеПоДС.СпособПодачиПоручения = Данные.СпособПодачи;
	ПоручениеПоДС.Контрагент = Данные.Контрагент;
	ПоручениеПоДС.СчетКонтрагента = Данные.РасчетныйСчет;
	ПоручениеПоДС.ДоговорКонтрагента = Данные.ДоговорКонтрагента;
	ПоручениеПоДС.СуммаДС = Данные.СуммаДС;
	ПоручениеПоДС.ВалютаДокумента = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	ПоручениеПоДС.КурсВзаиморасчетов = 1;
	ПоручениеПоДС.КратностьВзаиморасчетов = 1;
	ПоручениеПоДС.Ответственный = ОбщегоНазначения.ТекущийПользователь();
	ПоручениеПоДС.ДокументЗарегистрировал = "Не применимо";
	
	Попытка 
		ПоручениеПоДС.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		ПоручениеВозврат = ПоручениеПоДС.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Сообщить("Расторжение в период охлаждения. Ошибка при записи Поручения по Д/С. " + ТекстОшибки);
		ПоручениеВозврат = Документы.Поручение.ПустаяСсылка();
	КонецПопытки;
	
	Возврат ПоручениеВозврат;
	
КонецФункции

Функция ПлатежноеПоручение(ПоручениеПоДС, ВидОплаты)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлатежноеПоручение.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
		|ГДЕ
		|	ПлатежноеПоручение.ДокументОснование = &ПоручениеПоДС
		|	И НЕ ПлатежноеПоручение.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПоручениеПоДС", ПоручениеПоДС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ПлатежноПоручение = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	Иначе
		ПлатежноПоручение = Документы.ПлатежноеПоручение.СоздатьДокумент();
	КонецЕсли;
	
	ПлатежноПоручение.Дата = БлижайшийРабочийДень(ДатаРасчета) + 32400;
	ПлатежноПоручение.Заполнить(ПоручениеПоДС);

	Если Не ЗначениеЗаполнено(ПлатежноПоручение.Ссылка)
		И ЗначениеЗаполнено(ПлатежноПоручение.ДокументОснование)
		И (ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеЗадолженности") 
			ИЛИ ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеВознаграждения")) Тогда
		
		СуммаПП = ПлатежноПоручение.СуммаДокумента;
		СтруктураПлатежнойПозиции = БанковскийСчетПоПлатежнойПозиции(ПлатежноПоручение.ДоговорДУ, ПлатежноПоручение.ВалютаДокумента, СуммаПП);
		
		Если СтруктураПлатежнойПозиции.Свойство("БанковскийСчет") Тогда
			ПлатежноПоручение.ТекстПлательщика = СтруктураПлатежнойПозиции.ТекстКорреспондента;
			ПлатежноПоручение.СчетДоговораДУ = СтруктураПлатежнойПозиции.БанковскийСчет;
			Если ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеВознаграждения") Тогда
				ПлатежноПоручение.КПППлательщика = ПлатежноПоручение.Контрагент.КПП;
			ИначеЕсли ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
				ПлатежноПоручение.КПППлательщика = "0";
			КонецЕсли;
			ДокОснование = ПлатежноПоручение.ДокументОснование.Метаданные().Имя;
			ЗаполнитьНазначениеПлатежаПоПодобранномуБанковскомуСчету(ПлатежноПоручение, ДокОснование, ВидОплаты);
		КонецЕсли;
	КонецЕсли;
		
	Попытка 
		ПлатежноПоручение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		ПоручениеВозврат = ПлатежноПоручение.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Сообщить("Расторжение в период охлаждения. Ошибка при записи Платежного Поручения. " + ТекстОшибки);
		ПоручениеВозврат = Документы.ПлатежноеПоручение.ПустаяСсылка();
	КонецПопытки;
	
	Возврат ПоручениеВозврат;

КонецФункции

Функция ДостаточноДенегНаСчету(ПоручениеПоДСНаВывод, ОписаниеОшибки = "")

	АналитическийСчетИсточник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоручениеПоДСНаВывод, "АналитическийСчетИсточник");
	МестоХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АналитическийСчетИсточник, "МестоХранения");
	СуммаПоручения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоручениеПоДСНаВывод, "СуммаДС");
	ДоговорДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоручениеПоДСНаВывод, "ДоговорДУ");
	
	НаДату = КонецДня(БлижайшийРабочийДень(ДатаРасчета));
	СтруктураПлатежнойПозиции = Документы.ПлатежноеПоручение.ПервыйЭтапПроверкиДостаточностиДС(МестоХранения, ДоговорДУ, ПоручениеПоДСНаВывод, НаДату);
	
	ПлатежнаяПозиция = СтруктураПлатежнойПозиции.ПлатежнаяПозиция;
	ПлатежнаяПозиция = ПлатежнаяПозиция - СуммаПоручения;
	
	Если СуммаПоручения = 0 Тогда
		ОписаниеОшибки = ОписаниеОшибки + "  " +" Сумма поручения по ДС на дату " + Формат(НаДату, "ДЛФ=DT") + ": 0";
		Возврат Ложь;
	ИначеЕсли ПлатежнаяПозиция < 0 Тогда
		ОписаниеОшибки = ОписаниеОшибки + "  " +" Недостаточно денег на счету на дату " + Формат(НаДату, "ДЛФ=DT") + ": Сумма поручения - " 
						+ СуммаПоручения + "; Платежная позиция - " + СтруктураПлатежнойПозиции.ПлатежнаяПозиция;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция ОстатокНаСчету(ДоговорДУ, МестоХранения, НаДату)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	т.СуммаОстаток КАК ОстатокНаСчету
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВУДС),
		|			,
		|			ДоговорДУ = &ДоговорДУ
		|				И Субконто1 = &МестоХранения) КАК т";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	Запрос.УстановитьПараметр("МестоХранения", МестоХранения);
	Запрос.УстановитьПараметр("Период", НаДату);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ОстатокНаСчету;
	КонецЕсли;
	
	Возврат 0;

КонецФункции

Функция БанковскийСчетПоПлатежнойПозиции(ДоговорДУ, Валюта, Сумма)

	// IMDEV-9104-P2 ++
	Если КэшПлатежныхПозицийПакет <> Неопределено
		И Валюта = ВалютаКэшаПлатежныхПозиций Тогда
		СтрокиПозиций = КэшПлатежныхПозицийПакет.Получить(ДоговорДУ);
		Если СтрокиПозиций = Неопределено Тогда
			Возврат Новый Структура();
		КонецЕсли;
		Возврат ВыбратьСчетПоСуммеИзСтрокПозиций(СтрокиПозиций, Сумма);
	КонецЕсли;
	// IMDEV-9104-P2 --
	
	ТЗ_ПлатежныхПозицийПоПодходящимСчетам = Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС(ДоговорДУ, Валюта);
	// IMDEV-9104-P2 ++
	// Было: цикл отбора в этой функции. Стало: общий ВыбратьСчетПоСуммеИзСтрокПозиций.
	Возврат ВыбратьСчетПоСуммеИзСтрокПозиций(ТЗ_ПлатежныхПозицийПоПодходящимСчетам, Сумма);
	// IMDEV-9104-P2 --

КонецФункции

// IMDEV-9104-P2 ++
#Область IMDEV_9104_P2

// Описание: Уникальные договоры ДУ из результата ДанныеПоРасторжению (СуммаВводаДС <> 0)
// для пакетного кэша платежных позиций. Повторный Выбрать() основного цикла остаётся ниже.
//
Функция СписокДоговоровДляКэшаПлатежныхПозиций(ДанныеПоРасторжению)
	
	СписокДоговоров = Новый Массив;
	УжеДобавленные = Новый Соответствие;
	
	Выборка = ДанныеПоРасторжению.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СуммаВводаДС = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если УжеДобавленные.Получить(Выборка.ДоговорДУ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УжеДобавленные.Вставить(Выборка.ДоговорДУ, Истина);
		СписокДоговоров.Добавить(Выборка.ДоговорДУ);
		
	КонецЦикла;
	
	Возврат СписокДоговоров;
	
КонецФункции

// Описание: Один пакетный вызов ПлатежныеПозицииПоСчетамДС(Список) -> кэш по договорам
//
Функция ПодготовитьКэшПлатежныхПозицийПоСчетамДС(СписокДоговоров, Валюта)
	
	Кэш = Новый Соответствие;
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		Кэш.Вставить(ДоговорДУ, Новый Массив);
	КонецЦикла;
	
	Если СписокДоговоров.Количество() = 0 Тогда
		Возврат Кэш;
	КонецЕсли;
	
	ТЗПакет = Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС(СписокДоговоров, Валюта);
	Если ТЗПакет = Неопределено Тогда
		Возврат Кэш;
	КонецЕсли;
	
	ЕстьДоговор = (ТЗПакет.Колонки.Найти("ДоговорДУ") <> Неопределено);
	ЕстьБС = (ТЗПакет.Колонки.Найти("БанковскийСчет") <> Неопределено);
	ЕстьАС = (ТЗПакет.Колонки.Найти("АналитическийСчет") <> Неопределено);
	ЕстьПозиция = (ТЗПакет.Колонки.Найти("ПлатежнаяПозиция") <> Неопределено);
	ЕстьВалюта = (ТЗПакет.Колонки.Найти("ВалютаБанковскогоСчета") <> Неопределено);
	
	Для Каждого СтрокаПП Из ТЗПакет Цикл
		
		ДоговорДУ = ?(ЕстьДоговор, СтрокаПП.ДоговорДУ, Неопределено);
		Если Не ЗначениеЗаполнено(ДоговорДУ) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиДоговора = Кэш.Получить(ДоговорДУ);
		Если СтрокиДоговора = Неопределено Тогда
			СтрокиДоговора = Новый Массив;
			Кэш.Вставить(ДоговорДУ, СтрокиДоговора);
		КонецЕсли;
		
		СтрокаКэша = Новый Структура;
		СтрокаКэша.Вставить("БанковскийСчет", ?(ЕстьБС, СтрокаПП.БанковскийСчет, Неопределено));
		СтрокаКэша.Вставить("АналитическийСчет", ?(ЕстьАС, СтрокаПП.АналитическийСчет, Неопределено));
		СтрокаКэша.Вставить("ПлатежнаяПозиция", ?(ЕстьПозиция, СтрокаПП.ПлатежнаяПозиция, 0));
		СтрокаКэша.Вставить("ВалютаБанковскогоСчета", ?(ЕстьВалюта, СтрокаПП.ВалютаБанковскогоСчета, Неопределено));
		СтрокиДоговора.Добавить(СтрокаКэша);
		
	КонецЦикла;
	
	Возврат Кэш;
	
КонецФункции

// Описание: Отбор первой строки с ПлатежнаяПозиция >= Сумма (ТЗ или массив структур)
//
Функция ВыбратьСчетПоСуммеИзСтрокПозиций(СтрокиПозиций, Сумма)
	
	СтруктураПлатежнойПозиции = Новый Структура();
	Если СтрокиПозиций = Неопределено Тогда
		Возврат СтруктураПлатежнойПозиции;
	КонецЕсли;
	
	Для Каждого СтрокаПП Из СтрокиПозиций Цикл
		
		Если СтрокаПП.ПлатежнаяПозиция >= Сумма Тогда
			СтруктураПлатежнойПозиции.Вставить("ТекстКорреспондента"
				, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПП.БанковскийСчет, "ТекстКорреспондента"));
			СтруктураПлатежнойПозиции.Вставить("БанковскийСчет", СтрокаПП.БанковскийСчет);
			СтруктураПлатежнойПозиции.Вставить("АналитическийСчет", СтрокаПП.АналитическийСчет);
			СтруктураПлатежнойПозиции.Вставить("ПлатежнаяПозиция", СтрокаПП.ПлатежнаяПозиция);
			СтруктураПлатежнойПозиции.Вставить("ВозвратДепозита", 0);
			СтруктураПлатежнойПозиции.Вставить("ВалютаБанковскогоСчета", СтрокаПП.ВалютаБанковскогоСчета);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураПлатежнойПозиции;
	
КонецФункции

#КонецОбласти
// IMDEV-9104-P2 --

Процедура ЗаполнитьНазначениеПлатежаПоПодобранномуБанковскомуСчету(ПлатежноеПоручение, ДокОснование, ВидОплаты)

	Если ДокОснование = "НачислениеЗадолженности" Или ДокОснование = "НачислениеВознаграждения" Тогда
		ШаблонПлатежногоПоручения = ПолучитьШаблон(ВидОплаты);
		ПлатежноеПоручение.ЗаполнитьНазначениеПлатежа(ШаблонПлатежногоПоручения);
		Если ДокОснование = "НачислениеЗадолженности" Тогда
			ПлатежноеПоручение.НазначениеПлатежа = СтрЗаменить(ПлатежноеПоручение.НазначениеПлатежа, "[ДатаГод]", ГодНачисления(ПлатежноеПоручение.ДокументОснование));
		КонецЕсли;
	Иначе
		ПлатежноеПоручение.СчетКонтрагента = ЦентральныеСчетУК;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьШаблон(ВидОплаты)

	Если ВидОплаты = "Вознаграждение" Тогда
		Возврат ШаблонППВознаграждения;
	ИначеЕсли ВидОплаты = "Комиссия" Тогда
		Возврат ШаблонППКомиссии;
	ИначеЕсли ВидОплаты = "НДФЛ" Тогда
		Возврат ШаблонППНДФЛ;
	КонецЕсли;
	
	Возврат Справочники.ШаблоныПлатежныхПоручений.ПустаяСсылка();

КонецФункции

Функция ГодНачисления(НачислениеЗадолженности)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Периоды.Наименование КАК Наименование
		|ИЗ
		|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Периоды КАК Периоды
		|		ПО НачислениеЗадолженности.НалоговыйПериод = Периоды.Ссылка
		|ГДЕ
		|	НачислениеЗадолженности.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", НачислениеЗадолженности);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Наименование;
	КонецЕсли;
	
	Возврат "";

КонецФункции

Функция ОтправитьМатВыгодуФИН(Сервис, ВхПараметры)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ВхПараметры);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ОтветJSON = Сервис.createMatBenefits(СтрокаJSON);
	
	Возврат ОтветJSON;

КонецФункции

Функция ОтветJSON(ОтветJSON)

	СтруктураJSON = ПолучитьСтруктураJSON(ОтветJSON);

КонецФункции

Процедура ИнициироватьВознаграждение(ДоговорКРасторжению, СуммаВводаДС)

	Если ЗначениеЗаполнено(ОбработкаНачисленияВознаграждения) Тогда
		ДоговорДУПослеОхлаждения = Новый Структура("ДоговорДУ, СтрокаДоговорДУ", ДоговорКРасторжению.ДоговорДУ, ДоговорКРасторжению);
		ДоговорыДУПослеОхлаждения.Добавить(ДоговорДУПослеОхлаждения);
	Иначе
		Комментарий = "Вознаграждение за управление при расторжении";
		ДоговорКРасторжению.НачислениеВознаграждения
							= НачислениеВознаграждения(ДоговорКРасторжению.ДоговорДУ, Ложь,, Комментарий);
		Комментарий = "Дополнительное вознаграждение";
		ДоговорКРасторжению.НачислениеКомиссииДосрочныйВывод
							= НачислениеВознаграждения(ДоговорКРасторжению.ДоговорДУ, Истина, СуммаВводаДС, Комментарий);
	КонецЕсли;

КонецПроцедуры

Процедура НачислитьВознаграждение()

	Если ДоговорыДУПослеОхлаждения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Начисление = ДополнительныеОтчетыИОбработки.ПолучитьОбъектВнешнейОбработки(ОбработкаНачисленияВознаграждения);
	
	НастройкиОбработки = Справочники.ДополнительныеОтчетыИОбработки.НастройкиОбработки(ОбработкаНачисленияВознаграждения);
	Если ЗначениеЗаполнено(НастройкиОбработки) Тогда
		Начисление.УстановитьПользовательскиеНастройки(НастройкиОбработки);
	КонецЕсли;
	
	Для каждого ДоговорДУПослеОхлаждения Из ДоговорыДУПослеОхлаждения Цикл
		Начисление.ДоговорыДУ.Очистить();
		Начисление.ДоговорыДУ.Добавить(ДоговорДУПослеОхлаждения.ДоговорДУ);
		
		Начисление.ДатаНачисления = ДатаРасчета;
		Начисление.РежимРасторжения = Истина;
		Начисление.Пул = Пул;
		Начисление.КаталогСохранения = КаталогСохранения;
		Начисление.КаталогСохраненияКабинетаДУ = КаталогСохраненияКабинетаДУ;
		Начисление.ДоговорыКНачислению();
		Начисление.СоздатьНачисления();
	
		ДоговорыДУКНачислению = Начисление.ДоговорыДУКНачислению.Найти(ДоговорДУПослеОхлаждения.ДоговорДУ, "ДоговорДУ");
		Если ДоговорыДУКНачислению <> Неопределено Тогда
			ДоговорДУПослеОхлаждения.СтрокаДоговорДУ.Вознаграждение = Истина;
			ДоговорДУПослеОхлаждения.СтрокаДоговорДУ.НачислениеВознаграждения = ДоговорыДУКНачислению.НачислениеВознаграждения;
			ДоговорДУПослеОхлаждения.СтрокаДоговорДУ.НачислениеКомиссииДосрочныйВывод 
								= ДоговорыДУКНачислению.НачислениеУдержанияПриРасторжении;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДанныеНДФЛИзФИН()

	Если ТестовыйРежим Тогда
		Возврат;
	КонецЕсли;
	
	Если ДоговорыКРасторжениюИзДО.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПолучениеНДФЛ = ДополнительныеОтчетыИОбработки.ПолучитьОбъектВнешнейОбработки(НДФЛИзFinance);
	
	Для каждого ДоговорКРасторжениюИзДО Из ДоговорыКРасторжениюИзДО Цикл
		ПолучениеНДФЛ.ДоговорыДУ.Добавить(ДоговорКРасторжениюИзДО.ДоговорДУ);
	КонецЦикла;
	
	ПолучениеНДФЛ.ДатаНачала = БлижайшийРабочийДень(ДатаРасчета, Истина) - 172800;
	ПолучениеНДФЛ.ДатаОкончания = КонецДня(ДатаРасчета) - 86400;
	ПолучениеНДФЛ.ДатаСозданиязЗадолженности = НачалоДня(ДатаРасчета) + 32400;
	ПолучениеНДФЛ.КонтрагентИФНС = КонтрагентИФНС;
	ПолучениеНДФЛ.ДоговорИФНС = ДоговорИФНС;
	ПолучениеНДФЛ.СчетИНФС = СчетИНФС;
	ПолучениеНДФЛ.Пул = Пул;
	ПолучениеНДФЛ.НачислениеНДФЛпоПортфелю = Истина;
	
	ПолучениеНДФЛ.ПрочитатьДокументыНачисленияНДФЛ();
	Для каждого ДокументыНачисленияНДФЛ Из ПолучениеНДФЛ.ДокументыНачисленияНДФЛ Цикл
		ДокументыНачисленияНДФЛ.Флаг = Истина;
	КонецЦикла;
	ПолучениеНДФЛ.СоздатьДокументы();
	
КонецПроцедуры

Функция НачислениеВознаграждения(ДоговорДУ, КомиссияДосрочноеРасторжение, СуммаВвода = 0, Комментарий)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеВознаграждения.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.НачислениеВознаграждения КАК НачислениеВознаграждения
		|ГДЕ
		|	НачислениеВознаграждения.ДоговорДУ = &ДоговорДУ
		|	И НачислениеВознаграждения.Комментарий = &Комментарий";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	Запрос.УстановитьПараметр("Комментарий", Комментарий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Документ = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			
		Если Документ.ПометкаУдаления Тогда
			Документ.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
	Иначе
		Документ = Документы["НачислениеВознаграждения"].СоздатьДокумент();
	КонецЕсли;
	
	ДатаСоВременем = БлижайшийРабочийДень(ДатаРасчета);
	ПВХ = ПланыВидовХарактеристик.ПараметрыДоговораДУ;
	ПС = ПланыСчетов.Хозрасчетный;
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПВХ.ДоговорВознагражденияЗаУспех);
	МассивПараметров.Добавить(ПВХ.СчетВознагражденияЗаУспех);
	МассивПараметров.Добавить(ПВХ.СчетКонтрагентаУК);
	ЗначенияПараметров = РегистрыСведений.ЗначенияПараметровДоговораДУ.ЗначенияПараметровДоговораДУ(ДоговорДУ, МассивПараметров, ДатаСоВременем);
	
	Документ.Дата = ДатаСоВременем;
	Документ.ДоговорДУ = ДоговорДУ;
	Документ.Комментарий = Комментарий;
	
	Документ.ВидКонтрагента = Перечисления.ВидыОбязательныхКонтрагентов.УправляющаяКомпания;
	Документ.Контрагент = ДоговорДУ.УправляющаяКомпания;
	Документ.ДоговорКонтрагента = ЗначенияПараметров.Получить(ПВХ.ДоговорВознагражденияЗаУспех);
	Документ.СчетКонтрагента = ЗначенияПараметров.Получить(ПВХ.СчетКонтрагентаУК);
	
	СчетЗаУспех = ПС.РасчетВознаграждениеУКЗаУспех;
	
	Документ.СчетУчетаРасчетовСКонтрагентом = СчетЗаУспех;
	
	Если КомиссияДосрочноеРасторжение Тогда
		Документ.СпособНачисленияВознаграждения = Перечисления.СпособНачисленияВознаграждения.ФиксированнаяСумма;
		Документ.СуммаВознаграждения = СуммаКомиссииПриРасторжении(ДоговорДУ, СуммаВвода);
	Иначе
		Документ.СпособНачисленияВознаграждения = Перечисления.СпособНачисленияВознаграждения.ПоАлгоритму;
	КонецЕсли;
	
	//Проверка заполненности
	ТекстОтказа="";
	Если Не ЗначениеЗаполнено(Документ.Контрагент) Тогда
		ТекстОтказа = ТекстОтказа + Символы.ПС + "В документе не удалось заполнить контрагента.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Документ.ДоговорКонтрагента) Тогда
		ТекстОтказа = ТекстОтказа + Символы.ПС + "В документе не удалось заполнить договор контрагента. Проверьте существование и заполненность документа 'Настройки вознаграждения'.";
	КонецЕсли;
	
	Если НЕ ТекстОтказа = "" Тогда
		ТекстОтказа = "Не удалось выполнить регл. операцию 'Начисление вознаграждения' по договору ДУ: "+ ДоговорДУ +" по причине: "+ Символы.ПС + ТекстОтказа;
	КонецЕсли;
	
	Если ТекстОтказа = "" Тогда
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Документ.Записать(РежимЗаписиДокумента.Запись);
			Отказ = Истина;	
			ТекстОтказа = "Не удалось провести документ " + Строка(Документ);
		КонецПопытки;
	КонецЕсли;
	
	Возврат Документ.Ссылка;

КонецФункции

Функция СуммаКомиссииПриРасторжении(ДоговорДУ, СуммаВвода)

	СуммаКомиссии = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОКР(РАЗНОСТЬДАТ(ДоговорДУ.ДатаВводаСредствВДУ, ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ, ДЕНЬ) / 365, 2) КАК КолЛет
		|ИЗ
		|	Справочник.ДоговорДУ КАК ДоговорДУ
		|ГДЕ
		|	ДоговорДУ.Ссылка = &ДоговорДУ";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		КоличествоЛет = Цел(ВыборкаДетальныеЗаписи.КолЛет);
		Если КоличествоЛет < 1 Тогда
			СуммаКомиссии = СуммаВвода * 0.03;
		ИначеЕсли КоличествоЛет < 2 Тогда
			СуммаКомиссии = СуммаВвода * 0.02;
		Иначе
			СуммаКомиссии = СуммаВвода * 0.01;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СуммаКомиссии;

КонецФункции

Функция ПоручениеПоДС(ДоговорДУ, Контрагент, ВидОперации, Комментарий)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Поручение.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Поручение КАК Поручение
		|ГДЕ
		|	Поручение.ДоговорДУ = &ДоговорДУ
		|	И Поручение.ВидОперации = &ВидОперации
		|	И Поручение.Комментарий ПОДОБНО &Комментарий
		|	И НЕ Поручение.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.УстановитьПараметр("Комментарий", Комментарий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Поручение = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Возврат Поручение;
	Иначе
		Возврат Документы.Поручение.СоздатьДокумент();
	КонецЕсли;
	
КонецФункции

Функция АналитическийСчет(ДоговорДУ, ЕРС = Неопределено)

	Если ЕРС = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТорговыеКоды.АналитическийСчетДС КАК АналитическийСчетДС
			|ИЗ
			|	Справочник.ТорговыеКоды КАК ТорговыеКоды
			|ГДЕ
			|	ТорговыеКоды.ДоговорДУ = &ДоговорДУ";
		
		Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Возврат ВыборкаДетальныеЗаписи.АналитическийСчетДС;
		КонецЕсли;
		
		Возврат Справочники.АналитическиеСчета.ПустаяСсылка();
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	АналитическиеСчета.Ссылка КАК АналитическийСчетДС
			|ИЗ
			|	Справочник.АналитическиеСчета КАК АналитическиеСчета
			|ГДЕ
			|	АналитическиеСчета.ДоговорДУ = &ДоговорДУ
			|	И АналитическиеСчета.МестоХранения = &МестоХранения";
		
		Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
		Запрос.УстановитьПараметр("МестоХранения", ЕРС);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Возврат ВыборкаДетальныеЗаписи.АналитическийСчетДС;
		КонецЕсли;
		
		Возврат Справочники.АналитическиеСчета.ПустаяСсылка();
	КонецЕсли;

	
КонецФункции

Функция ДоговорКонтрагента(ДоговорДУ, РольДоговора)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.ДоговорДУ = &ДоговорДУ
	|	И ДоговорыКонтрагентов.РольДоговора = &РольДоговора";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	Запрос.УстановитьПараметр("РольДоговора", РольДоговора);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 1 Тогда
		ДоговорКонтрагента = Результат[0].Ссылка;
	Иначе	
		ДоговорКонтрагента = Неопределено;
	КонецЕсли;
	
	Возврат ДоговорКонтрагента;
	
КонецФункции

Функция БанковскийСчетКлиента(ДоговорДУ, Контрагент, БИК, НомерСчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Владелец = &Контрагент
		|	И БанковскиеСчета.НомерСчета = &НомерСчета";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		БанковскийСчет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	КонецЕсли;
	
	БанковскийСчет.Наименование = "Счет " + НомерСчета;
	БанковскийСчет.Банк = Справочники.Банки.СсылкаНаБанк(БИК);
	БанковскийСчет.ВалютаДенежныхСредств = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	БанковскийСчет.НомерСчета = НомерСчета;
	БанковскийСчет.ВидСчета = Перечисления.ВидБанковскогоСчета.Расчетный;
	БанковскийСчет.ТипСчета = Перечисления.ТипРасчетногоСчета.Индивидуальный;
	БанковскийСчет.Владелец = Контрагент;
	БанковскийСчет.Комментарий = "Указан при расторжении";
	
	Попытка 
		БанковскийСчет.Записать();
		БанковскийСчетВозврат = БанковскийСчет.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Ошибка при сознании расчетного счета. %1'"), ТекстОшибки);
		ЗаписьЖурналаРегистрации("Розничное ДУ: Расторжение в период охлаждения .", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		БанковскийСчетВозврат = Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецПопытки;
	
	Возврат БанковскийСчетВозврат;

КонецФункции

Процедура УчестьНДФЛПриРасторжении(ДанныеУчетНДФЛ)

	Если ДанныеУчетНДФЛ.ПоручениеПоДСНаВывод <> Документы.Поручение.ПустаяСсылка() Тогда
	
		ПоручениеРасторжение = ДанныеУчетНДФЛ.ПоручениеПоДСНаВывод.ПолучитьОбъект();
		ПоручениеРасторжение.СуммаДС = ДанныеУчетНДФЛ.СуммаКВыводу;
		
		Попытка
			ПоручениеРасторжение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
