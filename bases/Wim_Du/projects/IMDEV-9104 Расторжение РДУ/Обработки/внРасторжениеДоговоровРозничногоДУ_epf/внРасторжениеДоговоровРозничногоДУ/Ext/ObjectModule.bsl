			ПоручениеДляРассылки.ПоручениеПоДС = СтрокаДоговора.ПоручениеПоДСНаВвод;
			ПоручениеДляРассылки.ПлатежноеПоручение = СтрокаДоговора.ПлатежноеПоручениеНаВвод;
			ПоручениеДляРассылки.ДатаРасторжения = СтрокаДоговора.ДатаРасторжения;
			ПоручениеДляРассылки.МатВыгода = СтрокаДоговора.МатВыгода;
			ПоручениеДляРассылки.Доход = " - ";
			ПоручениеДляРассылки.НомерДУ = СтрокаДоговора.НомерДУ;
		КонецЦикла;
	КонецЕсли;
	
	Если СтрНайти(ВидРассылки, "Доход") > 0 Тогда
	
		Отбор = Новый Структура("НДФЛНачислен, БумагиПроданы", Ложь, Истина);
		
		Для каждого СтрокаДоговора Из ДоговорыКРасторжению.НайтиСтроки(Отбор) Цикл
			ПоручениеДляРассылки = ДанныеДляРассылки.Добавить();
			ПоручениеДляРассылки.ДоговорДУ = СтрокаДоговора.ДоговорДУ;
			ПоручениеДляРассылки.ПоручениеПоДС = СтрокаДоговора.ПоручениеПоДСНаВывод;
			ПоручениеДляРассылки.ПлатежноеПоручение = СтрокаДоговора.ПлатежноеПоручениеНаВывод;
			ПоручениеДляРассылки.ДатаРасторжения = СтрокаДоговора.ДатаРасторжения;
			ПоручениеДляРассылки.МатВыгода = " - ";
			ПоручениеДляРассылки.Доход = СтрокаДоговора.СуммаСЧА - СтрокаДоговора.СуммаВводаДС;
			ПоручениеДляРассылки.НомерДУ = СтрокаДоговора.НомерДУ;
		КонецЦикла;
	
		Для каждого СтрокаДоговора Из ДоговорыКРасторжениюПослеОхлаждения.НайтиСтроки(Отбор) Цикл
			ПоручениеДляРассылки = ДанныеДляРассылки.Добавить();
			ПоручениеДляРассылки.ДоговорДУ = СтрокаДоговора.ДоговорДУ;
			ПоручениеДляРассылки.ПоручениеПоДС = СтрокаДоговора.ПоручениеПоДСНаПеревод;
			ПоручениеДляРассылки.ПлатежноеПоручение = СтрокаДоговора.ПлатежноеПоручениеНаПеревод;
			ПоручениеДляРассылки.ДатаРасторжения = СтрокаДоговора.ДатаРасторжения;
			ПоручениеДляРассылки.МатВыгода = " - ";
			ПоручениеДляРассылки.Доход = СтрокаДоговора.СуммаСЧА - СтрокаДоговора.СуммаВводаДС;
			ПоручениеДляРассылки.НомерДУ = СтрокаДоговора.НомерДУ;
		КонецЦикла;
		
	КонецЕсли;
	
	ДанныеДляРассылки.Сортировать("ПлатежноеПоручение");
	
	Возврат ДанныеДляРассылки;

КонецФункции

Функция ОтборКонтактов(ВидРассылки)

	ВидыРассылки = Новый Соответствие;
	ВидыРассылки.Вставить("Перевод", "Мидлофис");
	ВидыРассылки.Вставить("Вывод", "Сеттелмент");
	ВидыРассылки.Вставить("Ввод", "Сеттелмент");
	ВидыРассылки.Вставить("МатВыгода", "Финансы");
	ВидыРассылки.Вставить("Доход", "Финансы");
	
	Ключ = ВидыРассылки.Получить(ВидРассылки);
	ОтборКонтактов = Новый Структура;
	ОтборКонтактов.Вставить("Отправлять", Истина);
	ОтборКонтактов.Вставить(Ключ, Истина);
	
	Возврат ОтборКонтактов;

КонецФункции

Функция ТелоПисьма(Заголовок, ТаблицаСтрок, ИмяМакета, КолонкаИтог, ПараметрИтог, ПутьКФайлуXLS)

	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет(ИмяМакета);
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	
	ОбластьШапка.Параметры.Заголовок = Заголовок;
	ТабДок.Вывести(ОбластьШапка);
	
	Для каждого СтрокаТаблицы Из ТаблицаСтрок Цикл
	
		ОбластьСтрока.Параметры.Заполнить(СтрокаТаблицы);
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ОбластьИтог.Параметры[ПараметрИтог] = ТаблицаСтрок.Итог(КолонкаИтог);
	ТабДок.Вывести(ОбластьИтог);
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла(".html");
	
	ТабДок.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.HTML);
	
	ТабДок.Записать(ПутьКФайлуXLS, ТипФайлаТабличногоДокумента.XLS);
	
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу);
	СтрHTML = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	УдалитьФайлы(ПутьКФайлу);
	
	Возврат СтрHTML;

КонецФункции

Функция ПропискаРассылки(Знач НомерРассылки) 
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции

Процедура СоздатьАвтоматическийВыводДСпоРасторжениямДляРДУ(ДУ)

	Если УниверсальнаяОбработкаВыводовРозничногоДУ = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;
	
	НаименованиеЗадания = "Автоматический вывод ДС по расторжениям для РДУ";
	//ссылка на доп. обработку, подключенную к базе. В данном примере ищем по наименованию, указанному в Сведениях о внешней обработке
	Наименование  = УниверсальнаяОбработкаВыводовРозничногоДУ.Наименование;
	ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(Наименование, Истина);
	//запуск фоновой процедуры происходит через метод "ВыполнитьПроцедуруМодуляОбъектаОбработки", куда мы передаем данные об обработке и о процедуре, которую необходимо запустить
	ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки";
	ПараметрыЗадания = Новый Структура;
	//имя внешней обработки
	ПараметрыЗадания.Вставить("ИмяОбработки", "ВнешнийОтчет.внОтчетУправляющегоДУсогласно482П_v15");
	//имя экспортной серверной процедуры обработки
	ПараметрыЗадания.Вставить("ИмяМетода", "СоздатьАвтоматическийВыводДСпоРасторжениямДляРДУ");
	//входящие параметры процедуры 
	ПараметрыВыполнения = Новый Структура("ТестовыйРежим, ТаблицаДанных, АдресWS", ТестовыйРежим, ДУ, АдресВебФO);
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	//признак внешней обработки
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
	//ссылка на доп. обработку в базе
	ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
	//получаем пустую структуру параметров выполнения фонового задания и заполняем ее необходимыми данными
	НовыйУникальныйИдентификатор = Новый УникальныйИдентификатор;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(НовыйУникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ИдентификаторФормы = НовыйУникальныйИдентификатор;
	ПараметрыВыполнения.КлючФоновогоЗадания = НовыйУникальныйИдентификатор;
	//запускаем выполнение фонового задания
	СтруктураФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения);

КонецПроцедуры

