Функция СведенияОВнешнейОбработке() Экспорт

	Структура = Новый Структура;
	Структура.Вставить("Вид", "ЗаполнениеОбъекта");
	Структура.Вставить("Наименование", "MF. Расчет вознаграждения за управление: Розничное ДУ");
	Структура.Вставить("Версия", "1.01"); // IMDEV-9104-3: убран лишний запрос в РазмерВознагражденияПриРасторжении
	Структура.Вставить("БезопасныйРежим", Истина);
	Структура.Вставить("Информация", "");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Идентификатор");
	Команды.Колонки.Добавить("Представление");
	Команды.Колонки.Добавить("Модификатор");
	Команды.Колонки.Добавить("ПоказыватьОповещение");
	Команды.Колонки.Добавить("Использование");

	Структура.Вставить("Команды", Команды);

	Назначение = Новый Массив;
	Назначение.Добавить("Документ.НачислениеВознаграждения");

	Структура.Вставить("Назначение", Назначение);

	Возврат Структура;

КонецФункции

Функция РезультатРасчета(ПользовательскиеНастройки, СтруктураПараметров) Экспорт
	
	Если ПользовательскиеНастройки = Неопределено Тогда
		ОбщегоНазначенияДУКлиентСервер.СообщитьОбОшибке("Отсутствуют настройки алгоритма");
		Возврат Неопределено;
	КонецЕсли;
	
	ПоказателиСправки = ПоказателиСправки();
	
	СтруктураПараметровДУ = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(СтруктураПараметров.ДоговорДУ, "Код, ДатаВводаСредствВДУ, ДатаНачала, ДатаОкончания, Код, ДатаПриостановкиУправления, ДатаВозобновленияУправления");
	
	ПВХ = ПланыВидовХарактеристик.ПараметрыДоговораДУ;
	
	СтавкаВознаграждения = ПользовательскиеНастройки.Значения.СтавкаВознаграждения;
	//Определение границ периода
	СтруктураПараметровПериода = Новый Структура;
	СтруктураПараметровПериода.Вставить("ДатаДокумента", СтруктураПараметров.Дата); 
	СтруктураПараметровПериода.Вставить("СтруктураДоговораДУ", СтруктураПараметровДУ);
	СтруктураПараметровПериода.Вставить("НастройкиАлгоритма", ПользовательскиеНастройки.Значения);
	
	СтруктураВозврата = Новый Структура("СуммаВознаграждения, Отказ, СправкаРасчет, СтавкаВознаграждения");
	Если СтруктураПараметровПериода.СтруктураДоговораДУ.ДатаПриостановкиУправления = Дата(1,1,1) Тогда
		
		ПоказателиСправки.ДоговорДУ = СтруктураПараметров.ДоговорДУ;
		ПоказателиСправки.ДатаНомерДоговораДУ = "№ " + СтруктураПараметровДУ.Код + " от " 
									+ Формат(СтруктураПараметровДУ.ДатаНачала, "ДФ='dd MMMM yyyy'") + "г.";
		
		ПоказателиСправки.ПериодРасчета = "с " + Формат(НачалоКвартала(СтруктураПараметров.Дата), "ДФ='dd MMMM yyyy'") + "г."
				+ " по " + Формат(СтруктураПараметров.Дата, "ДФ='dd MMMM yyyy'") + "г.";
				
		ПоказателиСправки.НачалоРасчета = НачалоКвартала(СтруктураПараметров.Дата);
		ПоказателиСправки.ОкончаниеРасчета = СтруктураПараметров.Дата;
		
		ПоказателиСправки.СтавкаВознаграждения = СтавкаВознаграждения;
		
		РезультирующаяСумма = ПолучитьРазмерВознаграждения(СтруктураПараметров.ДоговорДУ, СтруктураПараметров.Дата, ПоказателиСправки);
		
		СтруктураВозврата["СуммаВознаграждения"] = РезультирующаяСумма;
		СтруктураВозврата["Отказ"] = РезультирующаяСумма = 0;
		СтруктураВозврата["СправкаРасчет"] = СправкаРасчет(ПоказателиСправки);
		СтруктураВозврата["СтавкаВознаграждения"] = СтавкаВознаграждения;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоказателиСправки()

	ПоказателиСправки = Новый Структура;
	ПоказателиСправки.Вставить("ДоговорДУ", "");
	ПоказателиСправки.Вставить("ДатаНомерДоговораДУ", "");
	ПоказателиСправки.Вставить("ПериодРасчета", "");
	ПоказателиСправки.Вставить("НачалоРасчета", "");
	ПоказателиСправки.Вставить("ОкончаниеРасчета", "");
	ПоказателиСправки.Вставить("СуммаИнвестиций", "");
	
	ПоказателиСправки.Вставить("СрокДоговора", "");
	ПоказателиСправки.Вставить("СтавкаВознаграждения", 0);
	ПоказателиСправки.Вставить("СуммаВознагражденияВесьСрок", 0);
	
	ПоказателиСправки.Вставить("СуммаВознаграждения", 0);
	ПоказателиСправки.Вставить("СуммаУдержанногоВознаграждения", 0);
	ПоказателиСправки.Вставить("СуммаПоледующегоВознаграждения", 0);
	
	Возврат ПоказателиСправки;

КонецФункции 

Функция ПолучитьРазмерВознаграждения(ДоговорДУ, ДатаРасчета, ПоказателиСправки)
	
	ДатаПолученияУведомленияОРасторженииДоговораДУ = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДоговорДУ, "ДатаПолученияУведомленияОРасторженииДоговораДУ");
	
	Если ДатаПолученияУведомленияОРасторженииДоговораДУ = Дата(1, 1, 1) Тогда
		СуммаВознаграждения = РазмерВознагражденияПриРасторжении(ДоговорДУ, ДатаРасчета, ПоказателиСправки);
	Иначе
		СуммаВознаграждения = РазмерВознаграждения(ДоговорДУ, ДатаРасчета, ПоказателиСправки);
	КонецЕсли;
	
	Возврат СуммаВознаграждения;
	
КонецФункции

Функция РазмерВознаграждения(ДоговорДУ, ДатаРасчета, ПоказателиСправки)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СпрДоговорДУ.СрокДействия КАК СрокДоговора,
		|	ВводыВыводыДУ.Сумма КАК СуммаИнвестиций,
		|	ВводыВыводыДУ.Период КАК ДатаВвода
		|ПОМЕСТИТЬ ВТ_ДоговорыДУКРасчету
		|ИЗ
		|	Справочник.ДоговорДУ КАК СпрДоговорДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыДУ КАК ВводыВыводыДУ
		|		ПО (ВводыВыводыДУ.ДоговорДУ = СпрДоговорДУ.Ссылка)
		|ГДЕ
		|	СпрДоговорДУ.Ссылка = &ДоговорДУ
		|	И (СпрДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СпрДоговорДУ.ДатаОкончания > &ДатаРасчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбязательстваПоДСОстатки.ВалютнаяСуммаОстаток КАК СуммаВознаграждения,
		|	ВТ_ДоговорыДУКРасчету.СрокДоговора КАК СрокДоговора,
		|	ВТ_ДоговорыДУКРасчету.СуммаИнвестиций КАК СуммаИнвестиций,
		|	ВТ_ДоговорыДУКРасчету.ДатаВвода КАК ДатаВвода
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС.Остатки(
		|			&ДатаРасчета,
		|			ДоговорДУ = &ДоговорДУ
		|				И Основание.Ссылка ЕСТЬ NULL) КАК ОбязательстваПоДСОстатки,
		|	ВТ_ДоговорыДУКРасчету КАК ВТ_ДоговорыДУКРасчету";
	
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	СуммаВознаграждения = 0;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
	
		ПоказателиСправки.СуммаИнвестиций = ВыборкаДетальныеЗаписи.СуммаИнвестиций;
		
		СуммаВознагражденияВесьСрок = (ВыборкаДетальныеЗаписи.СуммаИнвестиций / 100)
							* СтавкаВознаграждения * ВыборкаДетальныеЗаписи.СрокДоговора;
		ПоказателиСправки.СуммаВознагражденияВесьСрок = СуммаВознагражденияВесьСрок;
		
		СрокДоговора = "" + ВыборкаДетальныеЗаписи.СрокДоговора + СловоЛет(ВыборкаДетальныеЗаписи.СрокДоговора);
		ПоказателиСправки.СрокДоговора = СрокДоговора;
		
		СуммаВознаграждения = ВыборкаДетальныеЗаписи.СуммаВознаграждения;
		ПоказателиСправки.СуммаВознаграждения = СуммаВознаграждения;
		
		УдалитьОбязательствоДС(ДоговорДУ);
	
	КонецЕсли;
	
	Возврат СуммаВознаграждения;

КонецФункции

Функция РазмерВознагражденияПриРасторжении(ДоговорДУ, ДатаРасчета, ПоказателиСправки)

	// IMDEV-9104-3 ++
