// IMDEV-9104-1 ++
// Единственное отличие «стало»: заранее заполнить КэшПлатежныхПозицийПакет.
// ПлатежноеПоручение / БанковскийСчетПоПлатежнойПозиции те же.

// Описание: Один пакетный ПлатежныеПозицииПоСчетамДС(Список) -> кэш по договорам
//
Функция ПодготовитьКэшПлатежныхПозицийПоСчетамДС(СписокДоговоров, Валюта)
	
	Кэш = Новый Соответствие;
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		Кэш.Вставить(ДоговорДУ, Новый Массив);
	КонецЦикла;
	
	Если СписокДоговоров.Количество() = 0 Тогда
		Возврат Кэш;
	КонецЕсли;
	
	ТЗПакет = Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС(СписокДоговоров, Валюта);
	Если ТЗПакет = Неопределено Тогда
		Возврат Кэш;
	КонецЕсли;
	
	ЕстьДоговор = (ТЗПакет.Колонки.Найти("ДоговорДУ") <> Неопределено);
	ЕстьБС = (ТЗПакет.Колонки.Найти("БанковскийСчет") <> Неопределено);
	ЕстьАС = (ТЗПакет.Колонки.Найти("АналитическийСчет") <> Неопределено);
	ЕстьПозиция = (ТЗПакет.Колонки.Найти("ПлатежнаяПозиция") <> Неопределено);
	ЕстьВалюта = (ТЗПакет.Колонки.Найти("ВалютаБанковскогоСчета") <> Неопределено);
	
	Для Каждого СтрокаПП Из ТЗПакет Цикл
		
		ДоговорДУ = ?(ЕстьДоговор, СтрокаПП.ДоговорДУ, Неопределено);
		Если Не ЗначениеЗаполнено(ДоговорДУ) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиДоговора = Кэш.Получить(ДоговорДУ);
		Если СтрокиДоговора = Неопределено Тогда
			СтрокиДоговора = Новый Массив;
			Кэш.Вставить(ДоговорДУ, СтрокиДоговора);
		КонецЕсли;
		
		СтрокаКэша = Новый Структура;
		СтрокаКэша.Вставить("БанковскийСчет", ?(ЕстьБС, СтрокаПП.БанковскийСчет, Неопределено));
		СтрокаКэша.Вставить("АналитическийСчет", ?(ЕстьАС, СтрокаПП.АналитическийСчет, Неопределено));
		СтрокаКэша.Вставить("ПлатежнаяПозиция", ?(ЕстьПозиция, СтрокаПП.ПлатежнаяПозиция, 0));
		СтрокаКэша.Вставить("ВалютаБанковскогоСчета", ?(ЕстьВалюта, СтрокаПП.ВалютаБанковскогоСчета, Неопределено));
		СтрокиДоговора.Добавить(СтрокаКэша);
		
	КонецЦикла;
	
	Возврат Кэш;
	
КонецФункции
// IMDEV-9104-1 --

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Подготовка объекта ПП до Записать (для снимка/замера без записи в БД)
//
Функция ПодготовитьОбъектПлатежногоПоручения(ПоручениеПоДС, ВидОплаты)
	
	Если ВсегдаНовыйОбъектПП = Истина Тогда
		ПлатежноПоручение = Документы.ПлатежноеПоручение.СоздатьДокумент();
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ПлатежноеПоручение.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
			|ГДЕ
			|	ПлатежноеПоручение.ДокументОснование = &ПоручениеПоДС
			|	И НЕ ПлатежноеПоручение.ПометкаУдаления";
		Запрос.УстановитьПараметр("ПоручениеПоДС", ПоручениеПоДС);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ПлатежноПоручение = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Иначе
			ПлатежноПоручение = Документы.ПлатежноеПоручение.СоздатьДокумент();
		КонецЕсли;
	КонецЕсли;
	
	ПлатежноПоручение.Дата = БлижайшийРабочийДень(ДатаРасчета) + 32400;
	ПлатежноПоручение.Заполнить(ПоручениеПоДС);

	Если Не ЗначениеЗаполнено(ПлатежноПоручение.Ссылка)
		И ЗначениеЗаполнено(ПлатежноПоручение.ДокументОснование)
		И (ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеЗадолженности")
			Или ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеВознаграждения")) Тогда
		
		СуммаПП = ПлатежноПоручение.СуммаДокумента;
		СтруктураПлатежнойПозиции = БанковскийСчетПоПлатежнойПозиции(
			ПлатежноПоручение.ДоговорДУ, ПлатежноПоручение.ВалютаДокумента, СуммаПП);
		
		Если СтруктураПлатежнойПозиции.Свойство("БанковскийСчет") Тогда
			ПлатежноПоручение.ТекстПлательщика = СтруктураПлатежнойПозиции.ТекстКорреспондента;
			ПлатежноПоручение.СчетДоговораДУ = СтруктураПлатежнойПозиции.БанковскийСчет;
			Если ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеВознаграждения") Тогда
				ПлатежноПоручение.КПППлательщика = ПлатежноПоручение.Контрагент.КПП;
			ИначеЕсли ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
				ПлатежноПоручение.КПППлательщика = "0";
			КонецЕсли;
			ДокОснование = ПлатежноПоручение.ДокументОснование.Метаданные().Имя;
			ЗаполнитьНазначениеПлатежаПоПодобранномуБанковскомуСчету(ПлатежноПоручение, ДокОснование, ВидОплаты);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПлатежноПоручение;
	
КонецФункции

Процедура ВыполнитьСравнениеПлатежноеПоручение(Результат)
	
	Если КоличествоДоговоров <= 0 Тогда
		КоличествоДоговоров = 50;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пул) Тогда
		Пул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	КонецЕсли;
	
	ДатаРасчета = КонецДня(ТекущаяДатаСеанса());
	ВсегдаНовыйОбъектПП = Истина;
	
	ТаблицаОснований = ПолучитьОснованияДляСравнения();
	Результат.КоличествоОснований = ТаблицаОснований.Количество();
	Результат.КоличествоДоговоров = УникальныеДоговоры(ТаблицаОснований).Количество();
	
	Если Результат.КоличествоОснований = 0 Тогда
		Результат.Отказ = Истина;
		Результат.ТекстОшибки =
			"Не найдены основания (НачислениеЗадолженности / НачислениеВознаграждения) по пулу для сравнения.";
		Возврат;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.СравнениеПП",
		УровеньЖурналаРегистрации.Информация,,,
		"Старт сравнения ПлатежноеПоручение: оснований="
			+ Формат(Результат.КоличествоОснований, "ЧГ=0")
			+ "; договоров=" + Формат(Результат.КоличествоДоговоров, "ЧГ=0"));
	
	КартаПоСтарому = Новый Соответствие;
	КартаПоНовому = Новый Соответствие;
	
	// --- БЫЛО: кэш выключен ---
	КэшПлатежныхПозицийПакет = Неопределено;
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Каждого СтрокаОсн Из ТаблицаОснований Цикл
		ОбъектПП = ПодготовитьОбъектПлатежногоПоручения(СтрокаОсн.Основание, СтрокаОсн.ВидОплаты);
		КартаПоСтарому.Вставить(КлючОснования(СтрокаОсн), СнимокПолейПлатежногоПоручения(ОбъектПП, СтрокаОсн));
	КонецЦикла;
	Результат.МсПоСтарому = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
	
	// --- СТАЛО IMDEV-9104-1: тот же код + пакетный кэш ---
	СписокДоговоров = УникальныеДоговоры(ТаблицаОснований);
	Валюта = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КэшПлатежныхПозицийПакет = ПодготовитьКэшПлатежныхПозицийПоСчетамДС(СписокДоговоров, Валюта);
	Для Каждого СтрокаОсн Из ТаблицаОснований Цикл
		ОбъектПП = ПодготовитьОбъектПлатежногоПоручения(СтрокаОсн.Основание, СтрокаОсн.ВидОплаты);
		КартаПоНовому.Вставить(КлючОснования(СтрокаОсн), СнимокПолейПлатежногоПоручения(ОбъектПП, СтрокаОсн));
	КонецЦикла;
	Результат.МсПоНовому = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
	КэшПлатежныхПозицийПакет = Неопределено;
	
	Различия = СравнитьСнимкиПлатежныхПоручений(КартаПоСтарому, КартаПоНовому, ТаблицаОснований);
	Результат.Различий = Различия.Количество();
	Результат.РезультатыСовпадают = (Результат.Различий = 0);
	ЗамерыСравнения = Различия;
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.СравнениеПП",
		УровеньЖурналаРегистрации.Информация,,,
		"Готово: мсСтарый=" + Формат(Результат.МсПоСтарому, "ЧГ=0")
			+ "; мсНовый=" + Формат(Результат.МсПоНовому, "ЧГ=0")
			+ "; различий=" + Формат(Результат.Различий, "ЧГ=0"));
	
КонецПроцедуры

Функция ПолучитьОснованияДляСравнения()
	
	ТаблицаОснований = Новый ТаблицаЗначений;
	ТаблицаОснований.Колонки.Добавить("Основание");
	ТаблицаОснований.Колонки.Добавить("ДоговорДУ");
	ТаблицаОснований.Колонки.Добавить("ВидОплаты", Новый ОписаниеТипов("Строка"));
	ТаблицаОснований.Колонки.Добавить("ТипОснования", Новый ОписаниеТипов("Строка"));
	
	Лимит = КоличествоДоговоров;
	
	ДобавитьОснованияНачислений(ТаблицаОснований, Ложь, Лимит); // НачислениеЗадолженности -> НДФЛ
	Если ТаблицаОснований.Количество() < Лимит Тогда
		ДобавитьОснованияНачислений(ТаблицаОснований, Истина, Лимит); // НачислениеВознаграждения
	КонецЕсли;
	
	Возврат ТаблицаОснований;
	
КонецФункции

Процедура ДобавитьОснованияНачислений(ТаблицаОснований, ЭтоВознаграждение, Лимит)
	
	Запрос = Новый Запрос;
	Если ЭтоВознаграждение Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500
		|	НачислениеВознаграждения.Ссылка КАК Основание,
		|	НачислениеВознаграждения.ДоговорДУ КАК ДоговорДУ
		|ИЗ
		|	Документ.НачислениеВознаграждения КАК НачислениеВознаграждения
		|ГДЕ
		|	НачислениеВознаграждения.ДоговорДУ.Пул = &Пул
		|	И НЕ НачислениеВознаграждения.ПометкаУдаления
		|	И НачислениеВознаграждения.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	НачислениеВознаграждения.Дата УБЫВ";
		ВидОплаты = "Вознаграждение";
		ТипОснования = "НачислениеВознаграждения";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 500
		|	НачислениеЗадолженности.Ссылка КАК Основание,
		|	НачислениеЗадолженности.ДоговорДУ КАК ДоговорДУ
		|ИЗ
		|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|ГДЕ
		|	НачислениеЗадолженности.ДоговорДУ.Пул = &Пул
		|	И НЕ НачислениеЗадолженности.ПометкаУдаления
		|	И НачислениеЗадолженности.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	НачислениеЗадолженности.Дата УБЫВ";
		ВидОплаты = "НДФЛ";
		ТипОснования = "НачислениеЗадолженности";
	КонецЕсли;
	Запрос.УстановитьПараметр("Пул", Пул);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТаблицаОснований.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Стр = ТаблицаОснований.Добавить();
		Стр.Основание = Выборка.Основание;
		Стр.ДоговорДУ = Выборка.ДоговорДУ;
		Стр.ВидОплаты = ВидОплаты;
		Стр.ТипОснования = ТипОснования;
	КонецЦикла;
	
КонецПроцедуры

Функция УникальныеДоговоры(ТаблицаОснований)
	
	Список = Новый Массив;
	УжеЕсть = Новый Соответствие;
	Для Каждого Стр Из ТаблицаОснований Цикл
		Если УжеЕсть.Получить(Стр.ДоговорДУ) = Неопределено Тогда
			УжеЕсть.Вставить(Стр.ДоговорДУ, Истина);
			Список.Добавить(Стр.ДоговорДУ);
		КонецЕсли;
	КонецЦикла;
	Возврат Список;
	
КонецФункции

Функция КлючОснования(СтрокаОсн)
	
	Возврат Строка(СтрокаОсн.Основание.УникальныйИдентификатор());
	
КонецФункции

// Описание: Фиксирует поля объекта ПП для регресса (до записи)
//
Функция СнимокПолейПлатежногоПоручения(ПлатежноПоручение, СтрокаОсн)
	
	Снимок = Новый Структура;
	Снимок.Вставить("Основание", СтрокаОсн.Основание);
	Снимок.Вставить("ДоговорДУ", СтрокаОсн.ДоговорДУ);
	Снимок.Вставить("ВидОплаты", СтрокаОсн.ВидОплаты);
	Снимок.Вставить("СчетДоговораДУ", ПлатежноПоручение.СчетДоговораДУ);
	Снимок.Вставить("ТекстПлательщика", ПлатежноПоручение.ТекстПлательщика);
	Снимок.Вставить("КПППлательщика", ПлатежноПоручение.КПППлательщика);
	Снимок.Вставить("СуммаДокумента", ПлатежноПоручение.СуммаДокумента);
	Снимок.Вставить("ВалютаДокумента", ПлатежноПоручение.ВалютаДокумента);
	Снимок.Вставить("ДоговорДУДок", ПлатежноПоручение.ДоговорДУ);
	Снимок.Вставить("НазначениеПлатежа", ПлатежноПоручение.НазначениеПлатежа);
	Снимок.Вставить("СчетКонтрагента", ПлатежноПоручение.СчетКонтрагента);
	Снимок.Вставить("КлючРегресса", КлючСнимкаДляСравнения(ПлатежноПоручение));
	
	Возврат Снимок;
	
КонецФункции

Функция КлючСнимкаДляСравнения(ПлатежноПоручение)
	
	СчетДУ = "";
	Если ЗначениеЗаполнено(ПлатежноПоручение.СчетДоговораДУ) Тогда
		СчетДУ = Строка(ПлатежноПоручение.СчетДоговораДУ.УникальныйИдентификатор());
	КонецЕсли;
	
	СчетКонтр = "";
	Если ЗначениеЗаполнено(ПлатежноПоручение.СчетКонтрагента) Тогда
		СчетКонтр = Строка(ПлатежноПоручение.СчетКонтрагента.УникальныйИдентификатор());
	КонецЕсли;
	
	Возврат "СчетДУ=" + СчетДУ
		+ "|Текст=" + Строка(ПлатежноПоручение.ТекстПлательщика)
		+ "|КПП=" + Строка(ПлатежноПоручение.КПППлательщика)
		+ "|Сумма=" + Формат(ПлатежноПоручение.СуммаДокумента, "ЧРД=.; ЧН=0; ЧГ=0")
		+ "|Валюта=" + Строка(ПлатежноПоручение.ВалютаДокумента)
		+ "|СчетКонтр=" + СчетКонтр
		+ "|Назн=" + Строка(ПлатежноПоручение.НазначениеПлатежа);
	
КонецФункции

Функция СравнитьСнимкиПлатежныхПоручений(КартаПоСтарому, КартаПоНовому, ТаблицаОснований)
	
	Различия = Новый ТаблицаЗначений;
	Различия.Колонки.Добавить("ОснованиеПредставление", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("КлючСтарый", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("КлючНовый", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	
	Для Каждого СтрокаОсн Из ТаблицаОснований Цикл
		Ключ = КлючОснования(СтрокаОсн);
		СнимокСтарый = КартаПоСтарому.Получить(Ключ);
		СнимокНовый = КартаПоНовому.Получить(Ключ);
		
		КлючСтарый = ?(СнимокСтарый = Неопределено, "НЕТ", СнимокСтарый.КлючРегресса);
		КлючНовый = ?(СнимокНовый = Неопределено, "НЕТ", СнимокНовый.КлючРегресса);
		
		Если КлючСтарый <> КлючНовый Тогда
			Стр = Различия.Добавить();
			Стр.ОснованиеПредставление = Строка(СтрокаОсн.Основание);
			Стр.КлючСтарый = КлючСтарый;
			Стр.КлючНовый = КлючНовый;
			Стр.Описание = ОписатьРазличиеСнимков(СнимокСтарый, СнимокНовый);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Различия;
	
КонецФункции

Функция ОписатьРазличиеСнимков(СнимокСтарый, СнимокНовый)
	
	Если СнимокСтарый = Неопределено Или СнимокНовый = Неопределено Тогда
		Возврат "нет одного из снимков";
	КонецЕсли;
	
	Части = Новый Массив;
	Если СнимокСтарый.СчетДоговораДУ <> СнимокНовый.СчетДоговораДУ Тогда
		Части.Добавить("СчетДоговораДУ");
	КонецЕсли;
	Если Строка(СнимокСтарый.ТекстПлательщика) <> Строка(СнимокНовый.ТекстПлательщика) Тогда
		Части.Добавить("ТекстПлательщика");
	КонецЕсли;
	Если Строка(СнимокСтарый.КПППлательщика) <> Строка(СнимокНовый.КПППлательщика) Тогда
		Части.Добавить("КПППлательщика");
	КонецЕсли;
	Если СнимокСтарый.СуммаДокумента <> СнимокНовый.СуммаДокумента Тогда
		Части.Добавить("СуммаДокумента");
	КонецЕсли;
	Если Строка(СнимокСтарый.НазначениеПлатежа) <> Строка(СнимокНовый.НазначениеПлатежа) Тогда
		Части.Добавить("НазначениеПлатежа");
	КонецЕсли;
	
	Если Части.Количество() = 0 Тогда
		Возврат "отличие в ключе регресса";
	КонецЕсли;
	
	РезультатСтрока = "";
	Для Каждого Часть Из Части Цикл
		РезультатСтрока = РезультатСтрока + ?(РезультатСтрока = "", "", ", ") + Часть;
	КонецЦикла;
	Возврат РезультатСтрока;
	
КонецФункции

Функция ПостроитьТабличныйДокументСравнения(Результат)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ТолькоПросмотр = Ложь;
	ТабДок.Защита = Ложь;
	
	ОбластьЗаголовок = ТабДок.Область(1, 1, 1, 5);
	ОбластьЗаголовок.Объединить();
	ОбластьЗаголовок.Текст =
		"IMDEV-9104: ПлатежноеПоручение старая vs IMDEV-9104-1 пакетная | v. "
		+ СведенияОВнешнейОбработке().Версия;
	ОбластьЗаголовок.Шрифт = Новый Шрифт(, 12, Истина);
	
	ТабДок.Область(2, 1).Текст = "Успех";
	ТабДок.Область(2, 2).Текст = ?(Результат.Успех, "Да", "Нет");
	ТабДок.Область(3, 1).Текст = "Дата";
	ТабДок.Область(3, 2).Текст = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	ТабДок.Область(4, 1).Текст = "N оснований";
	ТабДок.Область(4, 2).Текст = Формат(Результат.КоличествоОснований, "ЧГ=0");
	ТабДок.Область(5, 1).Текст = "N договоров (уник.)";
	ТабДок.Область(5, 2).Текст = Формат(Результат.КоличествоДоговоров, "ЧГ=0");
	ТабДок.Область(6, 1).Текст = "Пул";
	ТабДок.Область(6, 2).Текст = Строка(Пул);
	ТабДок.Область(7, 1).Текст = "Режим";
	ТабДок.Область(7, 2).Текст =
		"снимок полей до Записать; всегда новый объект ПП (блок подбора счета активен)";
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ТабДок.Область(8, 1).Текст = "Ошибка";
		ТабДок.Область(8, 2).Текст = Результат.ТекстОшибки;
	КонецЕсли;
	
	Стр = 10;
	ТабДок.Область(Стр, 1).Текст = "1. РЕГРЕСС ПОЛЕЙ ПП (СчетДоговораДУ, ТекстПлательщика, ...)";
	ТабДок.Область(Стр, 1).Шрифт = Новый Шрифт(, 10, Истина);
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Результаты совпадают";
	ТабДок.Область(Стр, 2).Текст = ?(Результат.РезультатыСовпадают, "ДА", "НЕТ");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Оснований с различиями";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.Различий, "ЧГ=0");
	
	Стр = Стр + 2;
	ТабДок.Область(Стр, 1).Текст = "Основание";
	ТабДок.Область(Стр, 2).Текст = "Ключ старый";
	ТабДок.Область(Стр, 3).Текст = "Ключ новый";
	ТабДок.Область(Стр, 4).Текст = "Поля-отличия";
	ТабДок.Область(Стр, 1, Стр, 4).Шрифт = Новый Шрифт(, , Истина);
	
	Если ТипЗнч(ЗамерыСравнения) = Тип("ТаблицаЗначений") Тогда
		Лимит = 30;
		Показано = 0;
		Для Каждого СтрРазл Из ЗамерыСравнения Цикл
			Стр = Стр + 1;
			ТабДок.Область(Стр, 1).Текст = СтрРазл.ОснованиеПредставление;
			ТабДок.Область(Стр, 2).Текст = Лев(СтрРазл.КлючСтарый, 90);
			ТабДок.Область(Стр, 3).Текст = Лев(СтрРазл.КлючНовый, 90);
			ТабДок.Область(Стр, 4).Текст = СтрРазл.Описание;
			Показано = Показано + 1;
			Если Показано >= Лимит Тогда
				Стр = Стр + 1;
				ТабДок.Область(Стр, 1).Текст = "... показано первых "
					+ Формат(Лимит, "ЧГ=0") + " из " + Формат(Результат.Различий, "ЧГ=0");
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Результат.Различий = 0 Тогда
			Стр = Стр + 1;
			ТабДок.Область(Стр, 1).Текст = "(различий нет)";
		КонецЕсли;
	КонецЕсли;
	
	Стр = Стр + 3;
