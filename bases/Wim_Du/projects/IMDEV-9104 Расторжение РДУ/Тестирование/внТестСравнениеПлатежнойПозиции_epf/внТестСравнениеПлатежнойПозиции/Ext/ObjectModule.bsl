// Описание: Сведения для регистрации дополнительной обработки в БСП
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование",
		"IMDEV-9104 сравнение ПлатежноеПоручение (было/стало)");
	ПараметрыРегистрации.Вставить("Версия", "1.3");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"P2: одна ПлатежноеПоручение; было=без кэша, стало=кэш IMDEV-9104-1. "
		+ "Регресс полей (СчетДоговораДУ, ТекстПлательщика) + скорость.");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Сравнить ПлатежноеПоручение (было/стало)";
	НоваяКоманда.Идентификатор = "СравнитьПлатежноеПоручение";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Описание: Запускает сравнение старой и пакетной ПлатежноеПоручение
//
Функция СформироватьОтчетЗамеровТеста() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ТабДокумент", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоДоговоров", 0);
	Результат.Вставить("КоличествоОснований", 0);
	Результат.Вставить("РезультатыСовпадают", Ложь);
	Результат.Вставить("Различий", 0);
	Результат.Вставить("МсПоСтарому", 0);
	Результат.Вставить("МсПоНовому", 0);
	
	Попытка
		ВыполнитьСравнениеПлатежноеПоручение(Результат);
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Отказ = Истина;
		Результат.Успех = Ложь;
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.СравнениеПП",
			УровеньЖурналаРегистрации.Ошибка,,,
			Результат.ТекстОшибки);
		Результат.ТабДокумент = ПостроитьТабличныйДокументСравнения(Результат);
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = (Результат.Отказ <> Истина);
	Результат.ТабДокумент = ПостроитьТабличныйДокументСравнения(Результат);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Алгоритм_ПлатежноеПоручение

// Описание: Боевая ПлатежноеПоручение (логика заполнения как в расторжении 1.18).
// Подбор счета: БанковскийСчетПоПлатежнойПозиции — если заполнен КэшПлатежныхПозицийПакет
// (IMDEV-9104-1), читает из кэша, иначе запрос по одному договору.
//
Функция ПлатежноеПоручение(ПоручениеПоДС, ВидОплаты)
	
	ПлатежноПоручение = ПодготовитьОбъектПлатежногоПоручения(ПоручениеПоДС, ВидОплаты);
	
	Попытка
		ПлатежноПоручение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		ПоручениеВозврат = ПлатежноПоручение.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Сообщить("Расторжение в период охлаждения. Ошибка при записи Платежного Поручения. " + ТекстОшибки);
		ПоручениеВозврат = Документы.ПлатежноеПоручение.ПустаяСсылка();
	КонецПопытки;
	
	Возврат ПоручениеВозврат;
	
КонецФункции

// Описание: Подбор счета УК по платежной позиции.
// Без кэша — как в оригинале (запрос на 1 договор). С кэшем IMDEV-9104-1 — из пакета.
//
Функция БанковскийСчетПоПлатежнойПозиции(ДоговорДУ, Валюта, Сумма)
	
	Если КэшПлатежныхПозицийПакет <> Неопределено Тогда
		СтрокиПозиций = КэшПлатежныхПозицийПакет.Получить(ДоговорДУ);
		Если СтрокиПозиций = Неопределено Тогда
			Возврат Новый Структура();
		КонецЕсли;
		Возврат ВыбратьСчетПоСуммеИзСтрокПозиций(СтрокиПозиций, Сумма);
	КонецЕсли;
	
	ТЗ_ПлатежныхПозицийПоПодходящимСчетам =
		Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС(ДоговорДУ, Валюта);
	Возврат ВыбратьСчетПоСуммеИзСтрокПозиций(ТЗ_ПлатежныхПозицийПоПодходящимСчетам, Сумма);
	
КонецФункции

// Описание: Общий отбор первой строки с ПлатежнаяПозиция >= Сумма (ТЗ или массив структур)
//
Функция ВыбратьСчетПоСуммеИзСтрокПозиций(СтрокиПозиций, Сумма)
	
	СтруктураПлатежнойПозиции = Новый Структура();
	Если СтрокиПозиций = Неопределено Тогда
		Возврат СтруктураПлатежнойПозиции;
	КонецЕсли;
	
	Для Каждого СтрокаПП Из СтрокиПозиций Цикл
		
		Если СтрокаПП.ПлатежнаяПозиция >= Сумма Тогда
			СтруктураПлатежнойПозиции.Вставить("ТекстКорреспондента"
				, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПП.БанковскийСчет, "ТекстКорреспондента"));
			СтруктураПлатежнойПозиции.Вставить("БанковскийСчет", СтрокаПП.БанковскийСчет);
			СтруктураПлатежнойПозиции.Вставить("АналитическийСчет", СтрокаПП.АналитическийСчет);
			СтруктураПлатежнойПозиции.Вставить("ПлатежнаяПозиция", СтрокаПП.ПлатежнаяПозиция);
			СтруктураПлатежнойПозиции.Вставить("ВозвратДепозита", 0);
			СтруктураПлатежнойПозиции.Вставить("ВалютаБанковскогоСчета", СтрокаПП.ВалютаБанковскогоСчета);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураПлатежнойПозиции;
	
КонецФункции

Процедура ЗаполнитьНазначениеПлатежаПоПодобранномуБанковскомуСчету(ПлатежноеПоручение, ДокОснование, ВидОплаты)
	
	Если ДокОснование = "НачислениеЗадолженности" Или ДокОснование = "НачислениеВознаграждения" Тогда
		ШаблонПлатежногоПоручения = ПолучитьШаблон(ВидОплаты);
		ПлатежноеПоручение.ЗаполнитьНазначениеПлатежа(ШаблонПлатежногоПоручения);
		Если ДокОснование = "НачислениеЗадолженности" Тогда
			ПлатежноеПоручение.НазначениеПлатежа = СтрЗаменить(ПлатежноеПоручение.НазначениеПлатежа, "[ДатаГод]", ГодНачисления(ПлатежноеПоручение.ДокументОснование));
		КонецЕсли;
	Иначе
		ПлатежноеПоручение.СчетКонтрагента = ЦентральныеСчетУК;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьШаблон(ВидОплаты)

	Если ВидОплаты = "Вознаграждение" Тогда
		Возврат ШаблонППВознаграждения;
	ИначеЕсли ВидОплаты = "Комиссия" Тогда
		Возврат ШаблонППКомиссии;
	ИначеЕсли ВидОплаты = "НДФЛ" Тогда
		Возврат ШаблонППНДФЛ;
	КонецЕсли;
	
	Возврат Справочники.ШаблоныПлатежныхПоручений.ПустаяСсылка();

КонецФункции

Функция ГодНачисления(НачислениеЗадолженности)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Периоды.Наименование КАК Наименование
		|ИЗ
		|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Периоды КАК Периоды
		|		ПО НачислениеЗадолженности.НалоговыйПериод = Периоды.Ссылка
		|ГДЕ
		|	НачислениеЗадолженности.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", НачислениеЗадолженности);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Наименование;
	КонецЕсли;
	
	Возврат "";

КонецФункции

Функция БлижайшийРабочийДень(ДатаДня, Предыдущий = Ложь)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	" + ?(Предыдущий, "МАКСИМУМ", "МИНИМУМ") + "(КалендарныеГрафики.ДатаГрафика) КАК ДатаГрафика
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
		|ГДЕ
		|	КалендарныеГрафики.ДатаГрафика " + ?(Предыдущий, "<", ">=") + " НАЧАЛОПЕРИОДА(&ДатаДня, ДЕНЬ)
		|	И КалендарныеГрафики.ДеньВключенВГрафик
		|	И КалендарныеГрафики.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.РегламентированныйКалендарь)";
	
	Запрос.УстановитьПараметр("ДатаДня", ДатаДня);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ДатаГрафика;
	КонецЕсли;
	
	Возврат ДатаДня;
	
КонецФункции

#КонецОбласти

