// Описание: Сведения для регистрации дополнительной обработки в БСП
//
// Возвращаемое значение:
// Структура - параметры регистрации внешней обработки
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование",
		"IMDEV-9104 сравнение БанковскийСчетПоПлатежнойПозиции (было/стало)");
	ПараметрыРегистрации.Вставить("Версия", "1.1");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"P2: старый алгоритм БанковскийСчетПоПлатежнойПозиции vs пакет IMDEV-9104-1. "
		+ "Замеры: регресс результата и скорость.");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Сравнить БанковскийСчетПоПлатежнойПозиции";
	НоваяКоманда.Идентификатор = "СравнитьПлатежнуюПозициюПП";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Описание: Запускает сравнение старого и пакетного алгоритма и строит отчет
//
// Возвращаемое значение:
// Структура - Успех, Отказ, ТабДокумент, ТекстОшибки, КоличествоДоговоров, ...
//
Функция СформироватьОтчетЗамеровТеста() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ТабДокумент", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоДоговоров", 0);
	Результат.Вставить("СуммаДляПодбора", 0);
	Результат.Вставить("РезультатыСовпадают", Ложь);
	Результат.Вставить("Различий", 0);
	Результат.Вставить("МсПоСтарому", 0);
	Результат.Вставить("МсПоНовому", 0);
	
	Попытка
		ВыполнитьСравнениеБанковскийСчетПоПлатежнойПозиции(Результат);
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Отказ = Истина;
		Результат.Успех = Ложь;
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.СравнениеПП",
			УровеньЖурналаРегистрации.Ошибка,,,
			Результат.ТекстОшибки);
		Результат.ТабДокумент = ПостроитьТабличныйДокументСравнения(Результат);
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = (Результат.Отказ <> Истина);
	Результат.ТабДокумент = ПостроитьТабличныйДокументСравнения(Результат);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СтарыйАлгоритм_БанковскийСчетПоПлатежнойПозиции

// Описание: Боевой алгоритм из внРасторжениеДоговоровРозничногоДУ (Оригинал 1.18).
// Без изменений логики. Используется как эталон ПО-СТАРОМУ.
//
Функция БанковскийСчетПоПлатежнойПозиции(ДоговорДУ, Валюта, Сумма)

	СтруктураПлатежнойПозиции = Новый Структура();
	
	ТЗ_ПлатежныхПозицийПоПодходящимСчетам = Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС(ДоговорДУ, Валюта);
	Для Каждого СтрокаПП Из ТЗ_ПлатежныхПозицийПоПодходящимСчетам Цикл
		
		Если СтрокаПП.ПлатежнаяПозиция >= Сумма Тогда
			СтруктураПлатежнойПозиции.Вставить("ТекстКорреспондента"
				, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПП.БанковскийСчет, "ТекстКорреспондента"));
			СтруктураПлатежнойПозиции.Вставить("БанковскийСчет", СтрокаПП.БанковскийСчет);
			СтруктураПлатежнойПозиции.Вставить("АналитическийСчет", СтрокаПП.АналитическийСчет);
			СтруктураПлатежнойПозиции.Вставить("ПлатежнаяПозиция", СтрокаПП.ПлатежнаяПозиция);
			СтруктураПлатежнойПозиции.Вставить("ВозвратДепозита", 0);
			СтруктураПлатежнойПозиции.Вставить("ВалютаБанковскогоСчета",СтрокаПП.ВалютаБанковскогоСчета);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;

	Возврат СтруктураПлатежнойПозиции;

КонецФункции

#КонецОбласти

#Область IMDEV_9104_1

// IMDEV-9104-1 ++
// Пакетная оптимизация: один вызов ПлатежныеПозицииПоСчетамДС(Список),
// далее подбор счета из кэша с той же логикой, что у старого алгоритма.

// Описание: Готовит кэш строк платежных позиций по договорам (один пакетный запрос).
//
// Параметры:
// СписокДоговоров - Массив - ссылки ДоговорДУ
// Валюта - СправочникСсылка.Валюты - валюта отбора
//
// Возвращаемое значение:
// Соответствие - ключ ДоговорДУ, значение Массив структур строк позиций
//
Функция ПодготовитьКэшПлатежныхПозицийПоСчетамДС(СписокДоговоров, Валюта)
	
	Кэш = Новый Соответствие;
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		Кэш.Вставить(ДоговорДУ, Новый Массив);
	КонецЦикла;
	
	ТЗПакет = Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС(СписокДоговоров, Валюта);
	Если ТЗПакет = Неопределено Тогда
		Возврат Кэш;
	КонецЕсли;
	
	ЕстьДоговор = (ТЗПакет.Колонки.Найти("ДоговорДУ") <> Неопределено);
	ЕстьБС = (ТЗПакет.Колонки.Найти("БанковскийСчет") <> Неопределено);
	ЕстьАС = (ТЗПакет.Колонки.Найти("АналитическийСчет") <> Неопределено);
	ЕстьПозиция = (ТЗПакет.Колонки.Найти("ПлатежнаяПозиция") <> Неопределено);
	ЕстьВалюта = (ТЗПакет.Колонки.Найти("ВалютаБанковскогоСчета") <> Неопределено);
	
	Для Каждого СтрокаПП Из ТЗПакет Цикл
		
		ДоговорДУ = ?(ЕстьДоговор, СтрокаПП.ДоговорДУ, Неопределено);
		Если Не ЗначениеЗаполнено(ДоговорДУ) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиДоговора = Кэш.Получить(ДоговорДУ);
		Если СтрокиДоговора = Неопределено Тогда
			СтрокиДоговора = Новый Массив;
			Кэш.Вставить(ДоговорДУ, СтрокиДоговора);
		КонецЕсли;
		
		СтрокаКэша = Новый Структура;
		СтрокаКэша.Вставить("БанковскийСчет", ?(ЕстьБС, СтрокаПП.БанковскийСчет, Неопределено));
		СтрокаКэша.Вставить("АналитическийСчет", ?(ЕстьАС, СтрокаПП.АналитическийСчет, Неопределено));
		СтрокаКэша.Вставить("ПлатежнаяПозиция", ?(ЕстьПозиция, СтрокаПП.ПлатежнаяПозиция, 0));
		СтрокаКэша.Вставить("ВалютаБанковскогоСчета", ?(ЕстьВалюта, СтрокаПП.ВалютаБанковскогоСчета, Неопределено));
		СтрокиДоговора.Добавить(СтрокаКэша);
		
	КонецЦикла;
	
	Возврат Кэш;
	
КонецФункции

// Описание: Пакетный аналог БанковскийСчетПоПлатежнойПозиции (подбор из кэша).
// Логика отбора первой строки с ПлатежнаяПозиция >= Сумма - как в оригинале.
//
// Параметры:
// ДоговорДУ - СправочникСсылка.ДоговорДУ
// Валюта - СправочникСсылка.Валюты - для совместимости сигнатуры (кэш уже по валюте)
// Сумма - Число - порог платежной позиции
// КэшПозицийПоДоговорам - Соответствие - результат ПодготовитьКэшПлатежныхПозицийПоСчетамДС
//
// Возвращаемое значение:
// Структура - как у БанковскийСчетПоПлатежнойПозиции
//
Функция БанковскийСчетПоПлатежнойПозицииПакетно(ДоговорДУ, Валюта, Сумма, КэшПозицийПоДоговорам)
	
	СтруктураПлатежнойПозиции = Новый Структура();
	
	СтрокиДоговора = КэшПозицийПоДоговорам.Получить(ДоговорДУ);
	Если СтрокиДоговора = Неопределено Тогда
		Возврат СтруктураПлатежнойПозиции;
	КонецЕсли;
	
	Для Каждого СтрокаПП Из СтрокиДоговора Цикл
		
		Если СтрокаПП.ПлатежнаяПозиция >= Сумма Тогда
			СтруктураПлатежнойПозиции.Вставить("ТекстКорреспондента"
				, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПП.БанковскийСчет, "ТекстКорреспондента"));
			СтруктураПлатежнойПозиции.Вставить("БанковскийСчет", СтрокаПП.БанковскийСчет);
			СтруктураПлатежнойПозиции.Вставить("АналитическийСчет", СтрокаПП.АналитическийСчет);
			СтруктураПлатежнойПозиции.Вставить("ПлатежнаяПозиция", СтрокаПП.ПлатежнаяПозиция);
			СтруктураПлатежнойПозиции.Вставить("ВозвратДепозита", 0);
			СтруктураПлатежнойПозиции.Вставить("ВалютаБанковскогоСчета", СтрокаПП.ВалютаБанковскогоСчета);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураПлатежнойПозиции;
	
КонецФункции
// IMDEV-9104-1 --

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьСравнениеБанковскийСчетПоПлатежнойПозиции(Результат)
	
	Если КоличествоДоговоров <= 0 Тогда
		КоличествоДоговоров = 50;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пул) Тогда
		Пул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	КонецЕсли;
	
	// Порог как СуммаПП в боевом вызове; 0 = любой счет с позицией >= 0 (максимум совпадений для регресса)
	СуммаДляПодбора = 0;
	Результат.СуммаДляПодбора = СуммаДляПодбора;
	
	СписокДоговоров = ПолучитьСписокДоговоровДляСравнения();
	Результат.КоличествоДоговоров = СписокДоговоров.Количество();
	
	Если Результат.КоличествоДоговоров = 0 Тогда
		Результат.Отказ = Истина;
		Результат.ТекстОшибки = "Не найдены договоры ДУ в выбранном пуле.";
		Возврат;
	КонецЕсли;
	
	Валюта = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.СравнениеПП",
		УровеньЖурналаРегистрации.Информация,,,
		"Старт сравнения БанковскийСчетПоПлатежнойПозиции: N="
			+ Формат(Результат.КоличествоДоговоров, "ЧГ=0")
			+ "; Валюта=" + Строка(Валюта)
			+ "; Сумма=" + Формат(СуммаДляПодбора, "ЧРД=.; ЧН=0; ЧГ=0"));
	
	КартаПоСтарому = Новый Соответствие;
	КартаПоНовому = Новый Соответствие;
	
	// --- ПО-СТАРОМУ: N вызовов боевой БанковскийСчетПоПлатежнойПозиции ---
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		СтруктураСтарая = БанковскийСчетПоПлатежнойПозиции(ДоговорДУ, Валюта, СуммаДляПодбора);
		КартаПоСтарому.Вставить(ДоговорДУ, СтруктураСтарая);
	КонецЦикла;
	Результат.МсПоСтарому = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
	
	// --- ПО-НОВОМУ (IMDEV-9104-1): 1 пакетный запрос + N подборов из кэша ---
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КэшПозиций = ПодготовитьКэшПлатежныхПозицийПоСчетамДС(СписокДоговоров, Валюта);
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		СтруктураНовая = БанковскийСчетПоПлатежнойПозицииПакетно(
			ДоговорДУ, Валюта, СуммаДляПодбора, КэшПозиций);
		КартаПоНовому.Вставить(ДоговорДУ, СтруктураНовая);
	КонецЦикла;
	Результат.МсПоНовому = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
	
	Различия = СравнитьСтруктурыПодбора(КартаПоСтарому, КартаПоНовому, СписокДоговоров);
	Результат.Различий = Различия.Количество();
	Результат.РезультатыСовпадают = (Результат.Различий = 0);
	ЗамерыСравнения = Различия;
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.СравнениеПП",
		УровеньЖурналаРегистрации.Информация,,,
		"Готово: мсСтарый=" + Формат(Результат.МсПоСтарому, "ЧГ=0")
			+ "; мсНовый=" + Формат(Результат.МсПоНовому, "ЧГ=0")
			+ "; различий=" + Формат(Результат.Различий, "ЧГ=0"));
	
КонецПроцедуры

Функция ПолучитьСписокДоговоровДляСравнения()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	ДоговорыДУ.Ссылка КАК ДоговорДУ
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорыДУ
	|ГДЕ
	|	ДоговорыДУ.Пул = &Пул
	|	И НЕ ДоговорыДУ.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорыДУ.Код";
	Запрос.УстановитьПараметр("Пул", Пул);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.ДоговорДУ);
		Если Список.Количество() >= КоличествоДоговоров Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции

// Описание: Сравнивает структуры подбора счета по договорам (регресс)
//
Функция СравнитьСтруктурыПодбора(КартаПоСтарому, КартаПоНовому, СписокДоговоров)
	
	Различия = Новый ТаблицаЗначений;
	Различия.Колонки.Добавить("ДоговорДУ");
	Различия.Колонки.Добавить("КодДоговора", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("КлючСтарый", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("КлючНовый", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		
		СтруктураСтарая = КартаПоСтарому.Получить(ДоговорДУ);
		СтруктураНовая = КартаПоНовому.Получить(ДоговорДУ);
		КлючСтарый = КлючСтруктурыПодбора(СтруктураСтарая);
		КлючНовый = КлючСтруктурыПодбора(СтруктураНовая);
		
		Если КлючСтарый <> КлючНовый Тогда
			Стр = Различия.Добавить();
			Стр.ДоговорДУ = ДоговорДУ;
			Стр.КодДоговора = Строка(ДоговорДУ);
			Стр.КлючСтарый = КлючСтарый;
			Стр.КлючНовый = КлючНовый;
			Стр.Описание = "старый=[" + КлючСтарый + "]; новый=[" + КлючНовый + "]";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Различия;
	
КонецФункции

Функция КлючСтруктурыПодбора(СтруктураПлатежнойПозиции)
	
	Если СтруктураПлатежнойПозиции = Неопределено Тогда
		Возврат "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	Если Не СтруктураПлатежнойПозиции.Свойство("БанковскийСчет")
		Или Не ЗначениеЗаполнено(СтруктураПлатежнойПозиции.БанковскийСчет) Тогда
		Возврат "ПУСТО";
	КонецЕсли;
	
	БС = Строка(СтруктураПлатежнойПозиции.БанковскийСчет.УникальныйИдентификатор());
	АС = "";
	Если СтруктураПлатежнойПозиции.Свойство("АналитическийСчет")
		И ЗначениеЗаполнено(СтруктураПлатежнойПозиции.АналитическийСчет) Тогда
		АС = Строка(СтруктураПлатежнойПозиции.АналитическийСчет.УникальныйИдентификатор());
	КонецЕсли;
	
	Позиция = 0;
	Если СтруктураПлатежнойПозиции.Свойство("ПлатежнаяПозиция") Тогда
		Позиция = СтруктураПлатежнойПозиции.ПлатежнаяПозиция;
	КонецЕсли;
	
	ВалютаСчета = "";
	Если СтруктураПлатежнойПозиции.Свойство("ВалютаБанковскогоСчета") Тогда
		ВалютаСчета = Строка(СтруктураПлатежнойПозиции.ВалютаБанковскогоСчета);
	КонецЕсли;
	
	ТекстКорр = "";
	Если СтруктураПлатежнойПозиции.Свойство("ТекстКорреспондента") Тогда
		ТекстКоррд = Строка(СтруктураПлатежнойПозиции.ТекстКорреспондента);
	КонецЕсли;
	
	ВозвратДепозита = 0;
	Если СтруктураПлатежнойПозиции.Свойство("ВозвратДепозита") Тогда
		ВозвратДепозита = СтруктураПлатежнойПозиции.ВозвратДепозита;
	КонецЕсли;
	
	Возврат БС
		+ "|" + АС
		+ "|" + Формат(Позиция, "ЧРД=.; ЧН=0; ЧГ=0")
		+ "|" + ВалютаСчета
		+ "|" + Формат(ВозвратДепозита, "ЧРД=.; ЧН=0; ЧГ=0")
		+ "|" + ТекстКоррд;
	
КонецФункции

Функция ПостроитьТабличныйДокументСравнения(Результат)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ТолькоПросмотр = Ложь;
	ТабДок.Защита = Ложь;
	
	ОбластьЗаголовок = ТабДок.Область(1, 1, 1, 5);
	ОбластьЗаголовок.Объединить();
	ОбластьЗаголовок.Текст =
		"IMDEV-9104: БанковскийСчетПоПлатежнойПозиции старый vs IMDEV-9104-1 пакет | v. "
		+ СведенияОВнешнейОбработке().Версия;
	ОбластьЗаголовок.Шрифт = Новый Шрифт(, 12, Истина);
	
	ТабДок.Область(2, 1).Текст = "Успех";
	ТабДок.Область(2, 2).Текст = ?(Результат.Успех, "Да", "Нет");
	ТабДок.Область(3, 1).Текст = "Дата";
	ТабДок.Область(3, 2).Текст = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	ТабДок.Область(4, 1).Текст = "N договоров";
	ТабДок.Область(4, 2).Текст = Формат(Результат.КоличествоДоговоров, "ЧГ=0");
	ТабДок.Область(5, 1).Текст = "Пул";
	ТабДок.Область(5, 2).Текст = Строка(Пул);
	ТабДок.Область(6, 1).Текст = "Сумма для подбора";
	ТабДок.Область(6, 2).Текст = Формат(Результат.СуммаДляПодбора, "ЧРД=.; ЧН=0; ЧГ=0");
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ТабДок.Область(7, 1).Текст = "Ошибка";
		ТабДок.Область(7, 2).Текст = Результат.ТекстОшибки;
	КонецЕсли;
	
	Стр = 9;
	ТабДок.Область(Стр, 1).Текст = "1. РЕГРЕСС РЕЗУЛЬТАТА (старый vs IMDEV-9104-1)";
	ТабДок.Область(Стр, 1).Шрифт = Новый Шрифт(, 10, Истина);
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Результаты совпадают";
	ТабДок.Область(Стр, 2).Текст = ?(Результат.РезультатыСовпадают, "ДА", "НЕТ");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Договоров с различиями";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.Различий, "ЧГ=0");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Критерий";
	ТабДок.Область(Стр, 2).Текст =
		"БанковскийСчет + АналитическийСчет + ПлатежнаяПозиция + Валюта + ВозвратДепозита + ТекстКорреспондента";
	
	Стр = Стр + 2;
	ТабДок.Область(Стр, 1).Текст = "Договор";
	ТабДок.Область(Стр, 2).Текст = "Ключ старый";
	ТабДок.Область(Стр, 3).Текст = "Ключ новый";
	ТабДок.Область(Стр, 4).Текст = "Описание";
	ТабДок.Область(Стр, 1, Стр, 4).Шрифт = Новый Шрифт(, , Истина);
	
	Если ТипЗнч(ЗамерыСравнения) = Тип("ТаблицаЗначений") Тогда
		Лимит = 30;
		Показано = 0;
		Для Каждого СтрРазл Из ЗамерыСравнения Цикл
			Стр = Стр + 1;
			ТабДок.Область(Стр, 1).Текст = СтрРазл.КодДоговора;
			ТабДок.Область(Стр, 2).Текст = Лев(СтрРазл.КлючСтарый, 80);
			ТабДок.Область(Стр, 3).Текст = Лев(СтрРазл.КлючНовый, 80);
			ТабДок.Область(Стр, 4).Текст = СтрРазл.Описание;
			Показано = Показано + 1;
			Если Показано >= Лимит Тогда
				Стр = Стр + 1;
				ТабДок.Область(Стр, 1).Текст = "... показано первых "
					+ Формат(Лимит, "ЧГ=0") + " из " + Формат(Результат.Различий, "ЧГ=0");
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Результат.Различий = 0 Тогда
			Стр = Стр + 1;
			ТабДок.Область(Стр, 1).Текст = "(различий нет)";
		КонецЕсли;
	КонецЕсли;
	
	Стр = Стр + 3;
	ТабДок.Область(Стр, 1).Текст = "2. СКОРОСТЬ (БЫЛО vs СТАЛО)";
	ТабДок.Область(Стр, 1).Шрифт = Новый Шрифт(, 10, Истина);
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Показатель";
	ТабДок.Область(Стр, 2).Текст = "Время, мс";
	ТабДок.Область(Стр, 3).Текст = "Комментарий";
	ТабДок.Область(Стр, 1, Стр, 3).Шрифт = Новый Шрифт(, , Истина);
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "ПО-СТАРОМУ БанковскийСчетПоПлатежнойПозиции";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.МсПоСтарому, "ЧГ=0");
	ТабДок.Область(Стр, 3).Текст = "N вызовов = " + Формат(Результат.КоличествоДоговоров, "ЧГ=0")
		+ " (каждый со своим ПлатежныеПозицииПоСчетамДС)";
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "ПО-НОВОМУ IMDEV-9104-1 пакет";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.МсПоНовому, "ЧГ=0");
	ТабДок.Область(Стр, 3).Текст =
		"1x ПлатежныеПозицииПоСчетамДС(Список) + N подборов из кэша";
	
	Ускорение = 0;
	Если Результат.МсПоНовому > 0 Тогда
		Ускорение = Результат.МсПоСтарому / Результат.МсПоНовому;
	КонецЕсли;
	Экономия = Результат.МсПоСтарому - Результат.МсПоНовому;
	ДоляЭкономии = 0;
	Если Результат.МсПоСтарому > 0 Тогда
		ДоляЭкономии = 100 * Экономия / Результат.МсПоСтарому;
	КонецЕсли;
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Ускорение (раз)";
	ТабДок.Область(Стр, 2).Текст = Формат(Ускорение, "ЧДЦ=2; ЧН=0; ЧГ=0");
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Экономия, мс";
	ТабДок.Область(Стр, 2).Текст = Формат(Экономия, "ЧГ=0");
	ТабДок.Область(Стр, 3).Текст = Формат(ДоляЭкономии, "ЧДЦ=1; ЧН=0; ЧГ=0") + "% от БЫЛО";
	
	Стр = Стр + 2;
	ТабДок.Область(Стр, 1).Текст =
		"Старый алгоритм = копия из внРасторжениеДоговоровРозничногоДУ. "
		+ "Новый = область IMDEV-9104-1 (пакетный кэш + тот же отбор ПлатежнаяПозиция >= Сумма).";
	ТабДок.Область(Стр, 1, Стр, 5).Объединить();
	
	ТабДок.Область(1, 1, Стр, 5).ШиринаКолонки = 18;
	ТабДок.Область(, 1).ШиринаКолонки = 48;
	ТабДок.Область(, 2).ШиринаКолонки = 20;
	ТабДок.Область(, 3).ШиринаКолонки = 20;
	ТабДок.Область(, 4).ШиринаКолонки = 40;
	
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти

