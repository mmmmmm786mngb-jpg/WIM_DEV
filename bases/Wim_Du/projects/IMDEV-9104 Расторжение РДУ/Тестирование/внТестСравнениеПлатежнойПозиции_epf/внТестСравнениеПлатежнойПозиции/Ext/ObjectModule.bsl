// Описание: Сведения для регистрации дополнительной обработки в БСП
//
// Возвращаемое значение:
// Структура - параметры регистрации внешней обработки
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование",
		"IMDEV-9104 сравнение платежной позиции ПП (было/стало)");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"P2: сравнение ПлатежныеПозицииПоСчетамДС по-старому (цикл) и по-новому (пакет). "
		+ "Два замера: равенство результатов и скорость.");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Сравнить платежную позицию (было/стало)";
	НоваяКоманда.Идентификатор = "СравнитьПлатежнуюПозициюПП";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Описание: Запускает сравнение ПО-СТАРОМУ / ПО-НОВОМУ и строит отчет
//
// Возвращаемое значение:
// Структура - Успех, Отказ, ТабДокумент, ТекстОшибки, КоличествоДоговоров, ...
//
Функция СформироватьОтчетЗамеровТеста() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ТабДокумент", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоДоговоров", 0);
	Результат.Вставить("РезультатыСовпадают", Ложь);
	Результат.Вставить("Различий", 0);
	Результат.Вставить("МсПоСтарому", 0);
	Результат.Вставить("МсПоНовому", 0);
	
	Попытка
		ВыполнитьСравнениеПлатежнойПозиции(Результат);
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Отказ = Истина;
		Результат.Успех = Ложь;
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.СравнениеПП",
			УровеньЖурналаРегистрации.Ошибка,,,
			Результат.ТекстОшибки);
		Результат.ТабДокумент = ПостроитьТабличныйДокументСравнения(Результат);
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = (Результат.Отказ <> Истина);
	Результат.ТабДокумент = ПостроитьТабличныйДокументСравнения(Результат);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьСравнениеПлатежнойПозиции(Результат)
	
	Если КоличествоДоговоров <= 0 Тогда
		КоличествоДоговоров = 50;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пул) Тогда
		Пул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	КонецЕсли;
	
	СписокДоговоров = ПолучитьСписокДоговоровДляСравнения();
	Результат.КоличествоДоговоров = СписокДоговоров.Количество();
	
	Если Результат.КоличествоДоговоров = 0 Тогда
		Результат.Отказ = Истина;
		Результат.ТекстОшибки = "Не найдены договоры ДУ в выбранном пуле.";
		Возврат;
	КонецЕсли;
	
	Валюта = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.СравнениеПП",
		УровеньЖурналаРегистрации.Информация,,,
		"Старт сравнения P2: N=" + Формат(Результат.КоличествоДоговоров, "ЧГ=0")
			+ "; Валюта=" + Строка(Валюта));
	
	// --- ПО-СТАРОМУ: цикл вызовов по одному договору (как в расторжении сейчас) ---
	КартаПоСтарому = Новый Соответствие;
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		ТЗ = Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС(ДоговорДУ, Валюта);
		КартаПоСтарому.Вставить(ДоговорДУ, НормализоватьТаблицуПозиций(ТЗ, ДоговорДУ));
	КонецЦикла;
	Результат.МсПоСтарому = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
	
	// --- ПО-НОВОМУ: один пакетный вызов по списку договоров ---
	КартаПоНовому = Новый Соответствие;
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТЗПакет = Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС(СписокДоговоров, Валюта);
	КартаПоНовому = РазложитьПакетнуюТаблицуПоДоговорам(ТЗПакет, СписокДоговоров);
	Результат.МсПоНовому = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
	
	// --- Сравнение результатов ---
	Различия = СравнитьКартыПозиций(КартаПоСтарому, КартаПоНовому, СписокДоговоров);
	Результат.Различий = Различия.Количество();
	Результат.РезультатыСовпадают = (Результат.Различий = 0);
	ЗамерыСравнения = Различия;
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.СравнениеПП",
		УровеньЖурналаРегистрации.Информация,,,
		"Готово: мсСтарый=" + Формат(Результат.МсПоСтарому, "ЧГ=0")
			+ "; мсНовый=" + Формат(Результат.МсПоНовому, "ЧГ=0")
			+ "; различий=" + Формат(Результат.Различий, "ЧГ=0"));
	
КонецПроцедуры

Функция ПолучитьСписокДоговоровДляСравнения()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	ДоговорыДУ.Ссылка КАК ДоговорДУ
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорыДУ
	|ГДЕ
	|	ДоговорыДУ.Пул = &Пул
	|	И НЕ ДоговорыДУ.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорыДУ.Код";
	Запрос.УстановитьПараметр("Пул", Пул);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.ДоговорДУ);
		Если Список.Количество() >= КоличествоДоговоров Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции

// Описание: Приводит таблицу позиций к сортированному массиву ключей для сравнения
//
Функция НормализоватьТаблицуПозиций(ТЗ, ДоговорДУПоУмолчанию = Неопределено)
	
	Ключи = Новый Массив;
	Если ТЗ = Неопределено Тогда
		Возврат Ключи;
	КонецЕсли;
	
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		ДоговорКлюч = Неопределено;
		Если ТЗ.Колонки.Найти("ДоговорДУ") <> Неопределено Тогда
			ДоговорКлюч = СтрокаТЗ.ДоговорДУ;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДоговорКлюч) Тогда
			ДоговорКлюч = ДоговорДУПоУмолчанию;
		КонецЕсли;
		
		БС = "";
		Если ТЗ.Колонки.Найти("БанковскийСчет") <> Неопределено Тогда
			БС = Строка(СтрокаТЗ.БанковскийСчет.УникальныйИдентификатор());
		КонецЕсли;
		
		АС = "";
		Если ТЗ.Колонки.Найти("АналитическийСчет") <> Неопределено Тогда
			АС = Строка(СтрокаТЗ.АналитическийСчет.УникальныйИдентификатор());
		КонецЕсли;
		
		ВалютаСчета = "";
		Если ТЗ.Колонки.Найти("ВалютаБанковскогоСчета") <> Неопределено Тогда
			ВалютаСчета = Строка(СтрокаТЗ.ВалютаБанковскогоСчета);
		КонецЕсли;
		
		Позиция = 0;
		Если ТЗ.Колонки.Найти("ПлатежнаяПозиция") <> Неопределено Тогда
			Позиция = СтрокаТЗ.ПлатежнаяПозиция;
		КонецЕсли;
		
		Ключ = Строка(ДоговорКлюч.УникальныйИдентификатор())
			+ "|" + БС
			+ "|" + АС
			+ "|" + ВалютаСчета
			+ "|" + Формат(Позиция, "ЧРД=.; ЧН=0; ЧГ=0");
		Ключи.Добавить(Ключ);
	КонецЦикла;
	
	СортироватьМассивСтрок(Ключи);
	Возврат Ключи;
	
КонецФункции

Функция РазложитьПакетнуюТаблицуПоДоговорам(ТЗПакет, СписокДоговоров)
	
	Карта = Новый Соответствие;
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		Карта.Вставить(ДоговорДУ, Новый Массив);
	КонецЦикла;
	
	Если ТЗПакет = Неопределено Тогда
		Возврат Карта;
	КонецЕсли;
	
	ЕстьКолонкаДоговор = (ТЗПакет.Колонки.Найти("ДоговорДУ") <> Неопределено);
	ЕстьБС = (ТЗПакет.Колонки.Найти("БанковскийСчет") <> Неопределено);
	ЕстьАС = (ТЗПакет.Колонки.Найти("АналитическийСчет") <> Неопределено);
	ЕстьВалюта = (ТЗПакет.Колонки.Найти("ВалютаБанковскогоСчета") <> Неопределено);
	ЕстьПозиция = (ТЗПакет.Колонки.Найти("ПлатежнаяПозиция") <> Неопределено);
	
	Для Каждого СтрокаТЗ Из ТЗПакет Цикл
		ДоговорДУ = ?(ЕстьКолонкаДоговор, СтрокаТЗ.ДоговорДУ, Неопределено);
		Если Не ЗначениеЗаполнено(ДоговорДУ) Тогда
			Продолжить;
		КонецЕсли;
		
		Ключи = Карта.Получить(ДоговорДУ);
		Если Ключи = Неопределено Тогда
			Ключи = Новый Массив;
			Карта.Вставить(ДоговорДУ, Ключи);
		КонецЕсли;
		
		БС = ?(ЕстьБС, Строка(СтрокаТЗ.БанковскийСчет.УникальныйИдентификатор()), "");
		АС = ?(ЕстьАС, Строка(СтрокаТЗ.АналитическийСчет.УникальныйИдентификатор()), "");
		ВалютаСчета = ?(ЕстьВалюта, Строка(СтрокаТЗ.ВалютаБанковскогоСчета), "");
		Позиция = ?(ЕстьПозиция, СтрокаТЗ.ПлатежнаяПозиция, 0);
		
		Ключ = Строка(ДоговорДУ.УникальныйИдентификатор())
			+ "|" + БС
			+ "|" + АС
			+ "|" + ВалютаСчета
			+ "|" + Формат(Позиция, "ЧРД=.; ЧН=0; ЧГ=0");
		Ключи.Добавить(Ключ);
	КонецЦикла;
	
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		Ключи = Карта.Получить(ДоговорДУ);
		Если Ключи <> Неопределено Тогда
			СортироватьМассивСтрок(Ключи);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Карта;
	
КонецФункции

Функция СравнитьКартыПозиций(КартаПоСтарому, КартаПоНовому, СписокДоговоров)
	
	Различия = Новый ТаблицаЗначений;
	Различия.Колонки.Добавить("ДоговорДУ");
	Различия.Колонки.Добавить("КодДоговора", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("СтрокСтарый", Новый ОписаниеТипов("Число"));
	Различия.Колонки.Добавить("СтрокНовый", Новый ОписаниеТипов("Число"));
	Различия.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		КлючиСтарый = КартаПоСтарому.Получить(ДоговорДУ);
		КлючиНовый = КартаПоНовому.Получить(ДоговорДУ);
		Если КлючиСтарый = Неопределено Тогда
			КлючиСтарый = Новый Массив;
		КонецЕсли;
		Если КлючиНовый = Неопределено Тогда
			КлючиНовый = Новый Массив;
		КонецЕсли;
		
		Если Не МассивыСтрокРавны(КлючиСтарый, КлючиНовый) Тогда
			Стр = Различия.Добавить();
			Стр.ДоговорДУ = ДоговорДУ;
			Стр.КодДоговора = Строка(ДоговорДУ);
			Стр.СтрокСтарый = КлючиСтарый.Количество();
			Стр.СтрокНовый = КлючиНовый.Количество();
			Стр.Описание = ОписатьРазличиеКлючей(КлючиСтарый, КлючиНовый);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Различия;
	
КонецФункции

Функция МассивыСтрокРавны(А, Б)
	
	Если А.Количество() <> Б.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 0 По А.Количество() - 1 Цикл
		Если А[Индекс] <> Б[Индекс] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция ОписатьРазличиеКлючей(КлючиСтарый, КлючиНовый)
	
	ТолькоСтарый = 0;
	ТолькоНовый = 0;
	СетНовый = Новый Соответствие;
	Для Каждого К Из КлючиНовый Цикл
		СетНовый.Вставить(К, Истина);
	КонецЦикла;
	СетСтарый = Новый Соответствие;
	Для Каждого К Из КлючиСтарый Цикл
		СетСтарый.Вставить(К, Истина);
		Если СетНовый.Получить(К) = Неопределено Тогда
			ТолькоСтарый = ТолькоСтарый + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого К Из КлючиНовый Цикл
		Если СетСтарый.Получить(К) = Неопределено Тогда
			ТолькоНовый = ТолькоНовый + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "только в старом=" + Формат(ТолькоСтарый, "ЧГ=0")
		+ "; только в новом=" + Формат(ТолькоНовый, "ЧГ=0");
	
КонецФункции

Процедура СортироватьМассивСтрок(МассивСтрок)
	
	СписокЗн = Новый СписокЗначений;
	Для Каждого Элемент Из МассивСтрок Цикл
		СписокЗн.Добавить(Элемент);
	КонецЦикла;
	СписокЗн.СортироватьПоЗначению();
	МассивСтрок.Очистить();
	Для Каждого ЭлементСписка Из СписокЗн Цикл
		МассивСтрок.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция ПостроитьТабличныйДокументСравнения(Результат)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ТолькоПросмотр = Ложь;
	ТабДок.Защита = Ложь;
	
	ОбластьЗаголовок = ТабДок.Область(1, 1, 1, 5);
	ОбластьЗаголовок.Объединить();
	ОбластьЗаголовок.Текст = "IMDEV-9104: сравнение ПлатежныеПозицииПоСчетамДС (P2) | v. "
		+ СведенияОВнешнейОбработке().Версия;
	ОбластьЗаголовок.Шрифт = Новый Шрифт(, 12, Истина);
	
	ТабДок.Область(2, 1).Текст = "Успех";
	ТабДок.Область(2, 2).Текст = ?(Результат.Успех, "Да", "Нет");
	ТабДок.Область(3, 1).Текст = "Дата";
	ТабДок.Область(3, 2).Текст = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	ТабДок.Область(4, 1).Текст = "N договоров";
	ТабДок.Область(4, 2).Текст = Формат(Результат.КоличествоДоговоров, "ЧГ=0");
	ТабДок.Область(5, 1).Текст = "Пул";
	ТабДок.Область(5, 2).Текст = Строка(Пул);
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ТабДок.Область(6, 1).Текст = "Ошибка";
		ТабДок.Область(6, 2).Текст = Результат.ТекстОшибки;
	КонецЕсли;
	
	// --- Блок 1: равенство результатов ---
	Стр = 8;
	ТабДок.Область(Стр, 1).Текст = "1. СРАВНЕНИЕ РЕЗУЛЬТАТОВ (ПО-СТАРОМУ vs ПО-НОВОМУ)";
	ТабДок.Область(Стр, 1).Шрифт = Новый Шрифт(, 10, Истина);
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Результаты совпадают";
	ТабДок.Область(Стр, 2).Текст = ?(Результат.РезультатыСовпадают, "ДА", "НЕТ");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Договоров с различиями";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.Различий, "ЧГ=0");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Критерий";
	ТабДок.Область(Стр, 2).Текст =
		"Набор строк: ДоговорДУ + БанковскийСчет + АналитическийСчет + Валюта + ПлатежнаяПозиция";
	
	Стр = Стр + 2;
	ТабДок.Область(Стр, 1).Текст = "Договор";
	ТабДок.Область(Стр, 2).Текст = "Строк старый";
	ТабДок.Область(Стр, 3).Текст = "Строк новый";
	ТабДок.Область(Стр, 4).Текст = "Описание различия";
	ТабДок.Область(Стр, 1, Стр, 4).Шрифт = Новый Шрифт(, , Истина);
	
	Если ТипЗнч(ЗамерыСравнения) = Тип("ТаблицаЗначений") Тогда
		Лимит = 30;
		Показано = 0;
		Для Каждого СтрРазл Из ЗамерыСравнения Цикл
			Стр = Стр + 1;
			ТабДок.Область(Стр, 1).Текст = СтрРазл.КодДоговора;
			ТабДок.Область(Стр, 2).Текст = Формат(СтрРазл.СтрокСтарый, "ЧГ=0");
			ТабДок.Область(Стр, 3).Текст = Формат(СтрРазл.СтрокНовый, "ЧГ=0");
			ТабДок.Область(Стр, 4).Текст = СтрРазл.Описание;
			Показано = Показано + 1;
			Если Показано >= Лимит Тогда
				Стр = Стр + 1;
				ТабДок.Область(Стр, 1).Текст = "... показано первых "
					+ Формат(Лимит, "ЧГ=0") + " из " + Формат(Результат.Различий, "ЧГ=0");
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Результат.Различий = 0 Тогда
			Стр = Стр + 1;
			ТабДок.Область(Стр, 1).Текст = "(различий нет)";
		КонецЕсли;
	КонецЕсли;
	
	// --- Блок 2: скорость ---
	Стр = Стр + 3;
	ТабДок.Область(Стр, 1).Текст = "2. СРАВНЕНИЕ СКОРОСТИ (БЫЛО vs СТАЛО)";
	ТабДок.Область(Стр, 1).Шрифт = Новый Шрифт(, 10, Истина);
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Показатель";
	ТабДок.Область(Стр, 2).Текст = "Время, мс";
	ТабДок.Область(Стр, 3).Текст = "Комментарий";
	ТабДок.Область(Стр, 1, Стр, 3).Шрифт = Новый Шрифт(, , Истина);
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "ПО-СТАРОМУ (цикл по 1 договору)";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.МсПоСтарому, "ЧГ=0");
	ТабДок.Область(Стр, 3).Текст = "N вызовов ПлатежныеПозицииПоСчетамДС = "
		+ Формат(Результат.КоличествоДоговоров, "ЧГ=0");
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "ПО-НОВОМУ (один пакетный вызов)";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.МсПоНовому, "ЧГ=0");
	ТабДок.Область(Стр, 3).Текст = "1 вызов ПлатежныеПозицииПоСчетамДС(Список)";
	
	Ускорение = 0;
	Если Результат.МсПоНовому > 0 Тогда
		Ускорение = Результат.МсПоСтарому / Результат.МсПоНовому;
	КонецЕсли;
	Экономия = Результат.МсПоСтарому - Результат.МсПоНовому;
	ДоляЭкономии = 0;
	Если Результат.МсПоСтарому > 0 Тогда
		ДоляЭкономии = 100 * Экономия / Результат.МсПоСтарому;
	КонецЕсли;
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Ускорение (раз)";
	ТабДок.Область(Стр, 2).Текст = Формат(Ускорение, "ЧДЦ=2; ЧН=0; ЧГ=0");
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Экономия, мс";
	ТабДок.Область(Стр, 2).Текст = Формат(Экономия, "ЧГ=0");
	ТабДок.Область(Стр, 3).Текст = Формат(ДоляЭкономии, "ЧДЦ=1; ЧН=0; ЧГ=0") + "% от БЫЛО";
	
	Стр = Стр + 2;
	ТабДок.Область(Стр, 1).Текст =
		"Доработка только P2: Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС. "
		+ "ПО-СТАРОМУ = как в расторжении сейчас; ПО-НОВОМУ = пакет по списку (API уже есть).";
	ТабДок.Область(Стр, 1, Стр, 5).Объединить();
	
	ТабДок.Область(1, 1, Стр, 5).ШиринаКолонки = 18;
	ТабДок.Область(, 1).ШиринаКолонки = 42;
	ТабДок.Область(, 2).ШиринаКолонки = 16;
	ТабДок.Область(, 3).ШиринаКолонки = 18;
	ТабДок.Область(, 4).ШиринаКолонки = 40;
	
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти

#Область Инициализация
КоличествоДоговоров = 50;
#КонецОбласти

