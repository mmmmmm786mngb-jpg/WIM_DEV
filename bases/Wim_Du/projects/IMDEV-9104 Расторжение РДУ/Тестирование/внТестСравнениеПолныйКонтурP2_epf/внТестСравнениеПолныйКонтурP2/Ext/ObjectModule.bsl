КонецФункции

// IMDEV-9104-P2 ++
#Область IMDEV_9104_P2

// Описание: Уникальные договоры ДУ из ДанныеПоРасторжению для пакетного кэша
//
Функция СписокДоговоровДляКэшаПлатежныхПозиций(ДанныеПоРасторжению)
	
	СписокДоговоров = Новый Массив;
	УжеДобавленные = Новый Соответствие;
	
	Выборка = ДанныеПоРасторжению.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СуммаВводаДС = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если УжеДобавленные.Получить(Выборка.ДоговорДУ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УжеДобавленные.Вставить(Выборка.ДоговорДУ, Истина);
		СписокДоговоров.Добавить(Выборка.ДоговорДУ);
		
	КонецЦикла;
	
	Возврат СписокДоговоров;
	
КонецФункции

// Описание: Один пакетный ПлатежныеПозицииПоСчетамДС(Список) -> кэш по договорам
//
Функция ПодготовитьКэшПлатежныхПозицийПоСчетамДС(СписокДоговоров, Валюта)
	
	Кэш = Новый Соответствие;
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		Кэш.Вставить(ДоговорДУ, Новый Массив);
	КонецЦикла;
	
	Если СписокДоговоров.Количество() = 0 Тогда
		Возврат Кэш;
	КонецЕсли;
	
	ТЗПакет = Документы.ПлатежноеПоручение.ПлатежныеПозицииПоСчетамДС(СписокДоговоров, Валюта);
	Если ТЗПакет = Неопределено Тогда
		Возврат Кэш;
	КонецЕсли;
	
	ЕстьДоговор = (ТЗПакет.Колонки.Найти("ДоговорДУ") <> Неопределено);
	ЕстьБС = (ТЗПакет.Колонки.Найти("БанковскийСчет") <> Неопределено);
	ЕстьАС = (ТЗПакет.Колонки.Найти("АналитическийСчет") <> Неопределено);
	ЕстьПозиция = (ТЗПакет.Колонки.Найти("ПлатежнаяПозиция") <> Неопределено);
	ЕстьВалюта = (ТЗПакет.Колонки.Найти("ВалютаБанковскогоСчета") <> Неопределено);
	
	Для Каждого СтрокаПП Из ТЗПакет Цикл
		
		ДоговорДУ = ?(ЕстьДоговор, СтрокаПП.ДоговорДУ, Неопределено);
		Если Не ЗначениеЗаполнено(ДоговорДУ) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиДоговора = Кэш.Получить(ДоговорДУ);
		Если СтрокиДоговора = Неопределено Тогда
			СтрокиДоговора = Новый Массив;
			Кэш.Вставить(ДоговорДУ, СтрокиДоговора);
		КонецЕсли;
		
		СтрокаКэша = Новый Структура;
		СтрокаКэша.Вставить("БанковскийСчет", ?(ЕстьБС, СтрокаПП.БанковскийСчет, Неопределено));
		СтрокаКэша.Вставить("АналитическийСчет", ?(ЕстьАС, СтрокаПП.АналитическийСчет, Неопределено));
		СтрокаКэша.Вставить("ПлатежнаяПозиция", ?(ЕстьПозиция, СтрокаПП.ПлатежнаяПозиция, 0));
		СтрокаКэша.Вставить("ВалютаБанковскогоСчета", ?(ЕстьВалюта, СтрокаПП.ВалютаБанковскогоСчета, Неопределено));
		СтрокиДоговора.Добавить(СтрокаКэша);
		
	КонецЦикла;
	
	Возврат Кэш;
	
КонецФункции

// Описание: Отбор первой строки с ПлатежнаяПозиция >= Сумма
//
Функция ВыбратьСчетПоСуммеИзСтрокПозиций(СтрокиПозиций, Сумма)
	
	СтруктураПлатежнойПозиции = Новый Структура();
	Если СтрокиПозиций = Неопределено Тогда
		Возврат СтруктураПлатежнойПозиции;
	КонецЕсли;
	
	Для Каждого СтрокаПП Из СтрокиПозиций Цикл
		
		Если СтрокаПП.ПлатежнаяПозиция >= Сумма Тогда
			СтруктураПлатежнойПозиции.Вставить("ТекстКорреспондента"
				, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПП.БанковскийСчет, "ТекстКорреспондента"));
			СтруктураПлатежнойПозиции.Вставить("БанковскийСчет", СтрокаПП.БанковскийСчет);
			СтруктураПлатежнойПозиции.Вставить("АналитическийСчет", СтрокаПП.АналитическийСчет);
			СтруктураПлатежнойПозиции.Вставить("ПлатежнаяПозиция", СтрокаПП.ПлатежнаяПозиция);
			СтруктураПлатежнойПозиции.Вставить("ВозвратДепозита", 0);
			СтруктураПлатежнойПозиции.Вставить("ВалютаБанковскогоСчета", СтрокаПП.ВалютаБанковскогоСчета);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураПлатежнойПозиции;
	
КонецФункции

