Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура();
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", "IMDEV-9104 сравнение полный контур P2");
	ПараметрыРегистрации.Вставить("Версия", "1.3");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Полный контур x2: P2 выкл vs вкл. Откат. Регресс ТЧ+ПП + скорость. v1.3: fix ключи ТЧ без .Колонки.");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(
		ТаблицаКоманд,
		"Сравнить полный контур P2 (было/стало)",
		"ТестПолныйКонтурРасторженияРДУ",
		"ОткрытиеФормы"
	);
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
	
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки.Значения);
		Если Настройки.Значения.Свойство("СписокРассылки") тогда
			СписокРассылки.Загрузить(XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки).Получить());
		КонецЕсли;
	КонецЕсли;
	
	Если ТестовыйРежим И ОтключитьВнешниеСистемы <> Истина Тогда
		АдресВебФO = "http://smsk02mg138u/AVC_PP_RETAIL_FO/ws/avancore_ws.1cws?wsdl";
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды <> "ФоновоеДоговорыИзДОКРасторжению" 
		И ИдентификаторКоманды <> "ФоновоеРасчетМатериальнойВыгодыПриРасторженииРозничногоДУ" Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	УведомлениеИзДООРасторжении = ИдентификаторКоманды = "ФоновоеДоговорыИзДОКРасторжению";
	
	//ДатаРасчета = КонецДня(ДатаРасчета);
	ДатаРасчета = КонецДня(ТекущаяДатаСеанса()); // IMAPPS-35558
	
	Если УведомлениеИзДООРасторжении Тогда
		ДОДоговорыДУКРасторжению();
	КонецЕсли;
	
	ОписаниеОшибки = "";
	СформироватьИОтправитьПисьмо("Перевод", ОписаниеОшибки);
	СформироватьИОтправитьПисьмо("Вывод", ОписаниеОшибки);
	СформироватьИОтправитьПисьмо("Ввод", ОписаниеОшибки);
	СформироватьИОтправитьПисьмо("МатВыгода", ОписаниеОшибки);
	
КонецПроцедуры

#КонецОбласти



#Область IMDEV9104_СравнениеПолныйКонтурP2

// Описание: Два прогона полного контура (P2 выкл / P2 вкл), откат, регресс ТЧ+ПП + скорость
//
Функция СформироватьОтчетЗамеровТеста() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ТабДокумент", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоДоговоров", 0);
	Результат.Вставить("МсПоСтарому", 0);
	Результат.Вставить("МсПоНовому", 0);
	Результат.Вставить("РезультатыСовпадают", Ложь);
	Результат.Вставить("РазличийТЧ", 0);
	Результат.Вставить("РазличийПП", 0);
	Результат.Вставить("ОшибкаБыло", "");
	Результат.Вставить("ОшибкаСтало", "");
	
	Попытка
		ВыполнитьСравнениеПолныйКонтурP2(Результат);
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Отказ = Истина;
		Результат.Успех = Ложь;
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.СравнениеПолныйP2",
			УровеньЖурналаРегистрации.Ошибка,,,
			Результат.ТекстОшибки);
		Результат.ТабДокумент = ПостроитьТабличныйДокументСравненияP2(Результат);
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = (Результат.Отказ <> Истина);
	Результат.ТабДокумент = ПостроитьТабличныйДокументСравненияP2(Результат);
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьСравнениеПолныйКонтурP2(Результат)
	
	ОтключитьВнешниеСистемы = Истина;
	ТестовыйРежим = Истина;
	ОткатыватьТранзакцию = Истина;
	
	Если КоличествоДоговоров <= 0 Тогда
		КоличествоДоговоров = 50;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пул) Тогда
		Пул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	КонецЕсли;
	ДатаРасчета = КонецДня(ТекущаяДатаСеанса());
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.СравнениеПолныйP2",
		УровеньЖурналаРегистрации.Информация,,,
		"Старт сравнения полного контура P2: N=" + Формат(КоличествоДоговоров, "ЧГ=0"));
	
	// --- БЫЛО: без пакетного кэша (как ОРИГИНАЛ до P2) ---
	ИспользоватьПакетныйКэшP2 = Ложь;
	СнимокСтарый = ВыполнитьОдинПрогонПолныйКонтурP2("БЫЛО");
	Результат.МсПоСтарому = СнимокСтарый.МсИтого;
	Результат.ОшибкаБыло = СнимокСтарый.ТекстОшибки;
	
	// Пауза между прогонами: дать другим сеансам отпустить управляемые блокировки
	Если СнимокСтарый.Успех Тогда
		// нет доп. паузы при успехе
	Иначе
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.СравнениеПолныйP2",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"Прогон БЫЛО с ошибкой, продолжаем СТАЛО. " + СнимокСтарый.ТекстОшибки);
	КонецЕсли;
	
	// --- СТАЛО: с пакетным кэшем P2 ---
	ИспользоватьПакетныйКэшP2 = Истина;
	СнимокНовый = ВыполнитьОдинПрогонПолныйКонтурP2("СТАЛО");
	Результат.МсПоНовому = СнимокНовый.МсИтого;
	Результат.ОшибкаСтало = СнимокНовый.ТекстОшибки;
	
	ИспользоватьПакетныйКэшP2 = Ложь;
	КэшПлатежныхПозицийПакет = Неопределено;
	
	Результат.КоличествоДоговоров = Макс(СнимокСтарый.КоличествоИзДО, СнимокНовый.КоличествоИзДО);
	РазличияТЧ = СравнитьСнимкиТЧ(СнимокСтарый, СнимокНовый);
	РазличияПП = СравнитьСнимкиПП(СнимокСтарый, СнимокНовый);
	Результат.РазличийТЧ = РазличияТЧ.Количество();
	Результат.РазличийПП = РазличияПП.Количество();
	
	ОбаУспешны = (СнимокСтарый.Успех И СнимокНовый.Успех);
	Результат.РезультатыСовпадают = ОбаУспешны
		И (Результат.РазличийТЧ = 0)
		И (Результат.РазличийПП = 0);
	Если Не ОбаУспешны Тогда
		Результат.Отказ = Истина;
		ЧастиОшибки = Новый Массив;
		Если Не ПустаяСтрока(СнимокСтарый.ТекстОшибки) Тогда
			ЧастиОшибки.Добавить("БЫЛО: " + СнимокСтарый.ТекстОшибки);
		КонецЕсли;
		Если Не ПустаяСтрока(СнимокНовый.ТекстОшибки) Тогда
			ЧастиОшибки.Добавить("СТАЛО: " + СнимокНовый.ТекстОшибки);
		КонецЕсли;
		Результат.ТекстОшибки = СтрСоединить(ЧастиОшибки, Символы.ПС);
	КонецЕсли;
	
	ЗамерыСравненияТЧ = РазличияТЧ;
	ЗамерыСравненияПП = РазличияПП;
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.СравнениеПолныйP2",
		УровеньЖурналаРегистрации.Информация,,,
		"Готово: мсСтарый=" + Формат(Результат.МсПоСтарому, "ЧГ=0")
			+ "; мсНовый=" + Формат(Результат.МсПоНовому, "ЧГ=0")
			+ "; разлТЧ=" + Формат(Результат.РазличийТЧ, "ЧГ=0")
			+ "; разлПП=" + Формат(Результат.РазличийПП, "ЧГ=0")
			+ "; обаУспешны=" + Строка(ОбаУспешны));
	
КонецПроцедуры

// Описание: Один полный контур (РЗ + обработка + рассылки) в транзакции с откатом; снимок ТЧ+ПП
// Параметры:
//  ИмяПрогона - Строка - метка для журнала (БЫЛО / СТАЛО)
//
Функция ВыполнитьОдинПрогонПолныйКонтурP2(ИмяПрогона = "")
	
	Снимок = Новый Структура;
	Снимок.Вставить("КоличествоИзДО", 0);
	Снимок.Вставить("КлючиТЧ", Новый Массив);
	Снимок.Вставить("КлючиПП", Новый Массив);
	Снимок.Вставить("МсИтого", 0);
	Снимок.Вставить("Успех", Ложь);
	Снимок.Вставить("ТекстОшибки", "");
	
	ОчиститьТабличныеЧастиКонтура();
	КэшПлатежныхПозицийПакет = Неопределено;
	ВалютаКэшаПлатежныхПозиций = Неопределено;
	КонтурПрерванИзЗаСбросаТранзакции = Ложь;
	ТекстПоследнегоСбросаТранзакции = "";
	
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
	
	НачатьТранзакцию();
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Попытка
		
		ДОДоговорыДУКРасторжению();
		Если КонтурПрерванИзЗаСбросаТранзакции <> Истина Тогда
			ОбработкаДоговоровКРасторжению(Ложь);
		КонецЕсли;
		Если КонтурПрерванИзЗаСбросаТранзакции <> Истина Тогда
			Для Каждого ВидРассылки Из СтрРазделить("Перевод,Вывод,Ввод,МатВыгода", ",") Цикл
				ДанныеДляРассылки(СокрЛП(ВидРассылки));
			КонецЦикла;
		КонецЕсли;
		
		Снимок.МсИтого = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
		Снимок.КоличествоИзДО = ДоговорыКРасторжениюИзДО.Количество();
		Снимок.КлючиТЧ = СобратьКлючиТЧКонтура();
		Снимок.КлючиПП = СобратьКлючиППКонтура();
		
		Если КонтурПрерванИзЗаСбросаТранзакции = Истина Тогда
			Снимок.Успех = Ложь;
			Снимок.ТекстОшибки = "Контур прерван после сброса транзакции отката (ссылки документов недействительны). "
				+ ТекстПоследнегоСбросаТранзакции;
		Иначе
			Снимок.Успех = Истина;
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
	Исключение
		Снимок.МсИтого = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
		Снимок.КоличествоИзДО = ДоговорыКРасторжениюИзДО.Количество();
		Снимок.ТекстОшибки = ОписаниеОшибки();
		Снимок.Успех = Ложь;
		Попытка
			Снимок.КлючиТЧ = СобратьКлючиТЧКонтура();
			Снимок.КлючиПП = СобратьКлючиППКонтура();
		Исключение
			// снимок частичный
		КонецПопытки;
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.СравнениеПолныйP2",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Прогон " + ИмяПрогона + " остановлен: " + Снимок.ТекстОшибки
				+ "; мс=" + Формат(Снимок.МсИтого, "ЧГ=0"));
	КонецПопытки;
	
	ОчиститьТабличныеЧастиКонтура();
	КэшПлатежныхПозицийПакет = Неопределено;
	
	Возврат Снимок;
	
КонецФункции

Процедура ОчиститьТабличныеЧастиКонтура()
	
	ДоговорыКРасторжениюИзДО.Очистить();
	ДоговорыКРасторжению.Очистить();
	ДоговорыКРасторжениюМатВыгода.Очистить();
	ДоговорыКРасторжениюПослеОхлаждения.Очистить();
	ДоговорыДУПослеОхлаждения = Новый Массив;
	
КонецПроцедуры

Функция СобратьКлючиТЧКонтура()
	
	Ключи = Новый Массив;
	ДобавитьКлючиТЧ(Ключи, "ИзДО", ДоговорыКРасторжениюИзДО);
	ДобавитьКлючиТЧ(Ключи, "Охлаждение", ДоговорыКРасторжению);
	ДобавитьКлючиТЧ(Ключи, "МатВыгода", ДоговорыКРасторжениюМатВыгода);
	ДобавитьКлючиТЧ(Ключи, "ПослеОхлаждения", ДоговорыКРасторжениюПослеОхлаждения);
	
	Список = Новый СписокЗначений;
	Для Каждого К Из Ключи Цикл
		Список.Добавить(К);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Результат = Новый Массив;
	Для Каждого Э Из Список Цикл
		Результат.Добавить(Э.Значение);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Описание: Есть ли реквизит у строки ТЧ обработки / ТаблицаЗначений.
// У табличной части объекта нет свойства Колонки (оно только у ТаблицаЗначений).
//
Функция ЕстьРеквизитСтрокиТЧ(СтрокаТЧ, ИмяРеквизита)
	
	Попытка
		Значение = СтрокаТЧ[ИмяРеквизита];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Процедура ДобавитьКлючиТЧ(Ключи, ИмяТЧ, Таблица)
	
	Для Каждого Стр Из Таблица Цикл
		ДоговорКлюч = "";
		Если ЕстьРеквизитСтрокиТЧ(Стр, "ДоговорДУ") И ЗначениеЗаполнено(Стр.ДоговорДУ) Тогда
			ДоговорКлюч = Строка(Стр.ДоговорДУ.УникальныйИдентификатор());
		КонецЕсли;
		
		Части = Новый Массив;
		Части.Добавить(ИмяТЧ);
		Части.Добавить(ДоговорКлюч);
		
		ИменаПолей = СтрРазделить(
			"СуммаСЧА,СуммаКВыводу,СуммаПеревода,СуммаВводаДС,МатВыгода,СтатусПорученияНаВывод,"
			+ "СтатусНачислениеНДФЛ,СтатусПорученияПеревод,СтатусНачислениеВознаграждения,"
			+ "СтатусНачислениеКомиссииДосрочныйВывод,СтатусНачислениеВознагражденияРегулярное,"
			+ "ЕстьПП_НДФЛ,ЕстьПП_Вывод,ЕстьПП_Вознаграждение,ЕстьПП_Комиссия,ЕстьПП_ВознаграждениеРег,ЕстьПП_Перевод",
			",");
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			ИмяПоля = СокрЛП(ИмяПоля);
			Если СтрНачинаетсяС(ИмяПоля, "ЕстьПП_") Тогда
				ИмяРеквизитаПП = Сред(ИмяПоля, 8);
				КартаИмен = Новый Соответствие;
				КартаИмен.Вставить("НДФЛ", "ПлатежноеПоручениеНДФЛ");
				КартаИмен.Вставить("Вывод", "ПлатежноеПоручениеНаВывод");
				КартаИмен.Вставить("Вознаграждение", "ПлатежноеПоручениеВознаграждение");
				КартаИмен.Вставить("Комиссия", "ПлатежноеПоручениеКомиссииДосрочныйВывод");
				КартаИмен.Вставить("ВознаграждениеРег", "ПлатежноеПоручениеВознаграждениеРегулярное");
				КартаИмен.Вставить("Перевод", "ПлатежноеПоручениеНаПеревод");
				ИмяКолонкиПП = КартаИмен.Получить(ИмяРеквизитаПП);
				Если ИмяКолонкиПП = Неопределено Или Не ЕстьРеквизитСтрокиТЧ(Стр, ИмяКолонкиПП) Тогда
					Продолжить;
				КонецЕсли;
				Части.Добавить(ИмяПоля + "=" + ?(ЗначениеЗаполнено(Стр[ИмяКолонкиПП]), "1", "0"));
				Продолжить;
			КонецЕсли;
			Если Не ЕстьРеквизитСтрокиТЧ(Стр, ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			ЗначениеПоля = Стр[ИмяПоля];
			Если ТипЗнч(ЗначениеПоля) = Тип("Число") Тогда
				Части.Добавить(ИмяПоля + "=" + Формат(ЗначениеПоля, "ЧРД=.; ЧН=0; ЧГ=0"));
			Иначе
				Части.Добавить(ИмяПоля + "=" + Строка(ЗначениеПоля));
			КонецЕсли;
		КонецЦикла;
		
		КлючСтроки = "";
		Для Каждого Ч Из Части Цикл
			КлючСтроки = КлючСтроки + ?(КлючСтроки = "", "", "|") + Ч;
		КонецЦикла;
		Ключи.Добавить(КлючСтроки);
	КонецЦикла;
	
КонецПроцедуры

Функция СобратьКлючиППКонтура()
	
	Ключи = Новый Массив;
	Уже = Новый Соответствие;
	СобратьППИзТЧ(Ключи, Уже, ДоговорыКРасторжению);
	СобратьППИзТЧ(Ключи, Уже, ДоговорыКРасторжениюМатВыгода);
	СобратьППИзТЧ(Ключи, Уже, ДоговорыКРасторжениюПослеОхлаждения);
	
	Список = Новый СписокЗначений;
	Для Каждого К Из Ключи Цикл
		Список.Добавить(К);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Результат = Новый Массив;
	Для Каждого Э Из Список Цикл
		Результат.Добавить(Э.Значение);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура СобратьППИзТЧ(Ключи, Уже, Таблица)
	
	ИменаПП = СтрРазделить(
		"ПлатежноеПоручениеНДФЛ,ПлатежноеПоручениеНаВывод,ПлатежноеПоручениеВознаграждение,"
		+ "ПлатежноеПоручениеКомиссииДосрочныйВывод,ПлатежноеПоручениеВознаграждениеРегулярное,"
		+ "ПлатежноеПоручениеНаПеревод",
		",");
	
	Для Каждого Стр Из Таблица Цикл
		ДоговорКлюч = "";
		Если ЕстьРеквизитСтрокиТЧ(Стр, "ДоговорДУ") И ЗначениеЗаполнено(Стр.ДоговорДУ) Тогда
			ДоговорКлюч = Строка(Стр.ДоговорДУ.УникальныйИдентификатор());
		КонецЕсли;
		
		Для Каждого ИмяПоля Из ИменаПП Цикл
			ИмяПоля = СокрЛП(ИмяПоля);
			Если Не ЕстьРеквизитСтрокиТЧ(Стр, ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			СсылкаПП = Стр[ИмяПоля];
			Если Не ЗначениеЗаполнено(СсылкаПП) Тогда
				Продолжить;
			КонецЕсли;
			
			КлючСтаб = ДоговорКлюч + "|" + ИмяПоля;
			Если Уже.Получить(КлючСтаб) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уже.Вставить(КлючСтаб, Истина);
			
			Попытка
				ОбъектПП = СсылкаПП.ПолучитьОбъект();
				СчетДУ = "";
				Если ЗначениеЗаполнено(ОбъектПП.СчетДоговораДУ) Тогда
					СчетДУ = Строка(ОбъектПП.СчетДоговораДУ.УникальныйИдентификатор());
				КонецЕсли;
				Ключи.Добавить(
					"ПП|" + КлючСтаб
					+ "|СчетДУ=" + СчетДУ
					+ "|Текст=" + Строка(ОбъектПП.ТекстПлательщика)
					+ "|КПП=" + Строка(ОбъектПП.КПППлательщика)
					+ "|Сумма=" + Формат(ОбъектПП.СуммаДокумента, "ЧРД=.; ЧН=0; ЧГ=0")
					+ "|Валюта=" + Строка(ОбъектПП.ВалютаДокумента)
					+ "|Назн=" + Строка(ОбъектПП.НазначениеПлатежа));
			Исключение
				Ключи.Добавить("ПП|" + КлючСтаб + "|ОШИБКА=" + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция СравнитьСнимкиТЧ(СнимокСтарый, СнимокНовый)
	
	Возврат СравнитьМассивыКлючей(СнимокСтарый.КлючиТЧ, СнимокНовый.КлючиТЧ, "ТЧ");
	
КонецФункции

Функция СравнитьСнимкиПП(СнимокСтарый, СнимокНовый)
	
	Возврат СравнитьМассивыКлючей(СнимокСтарый.КлючиПП, СнимокНовый.КлючиПП, "ПП");
	
КонецФункции

Функция СравнитьМассивыКлючей(КлючиСтарый, КлючиНовый, ТипСравнения)
	
	Различия = Новый ТаблицаЗначений;
	Различия.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("КлючСтарый", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("КлючНовый", Новый ОписаниеТипов("Строка"));
	Различия.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	
	СетНовый = Новый Соответствие;
	Для Каждого К Из КлючиНовый Цикл
		СетНовый.Вставить(К, Истина);
	КонецЦикла;
	СетСтарый = Новый Соответствие;
	Для Каждого К Из КлючиСтарый Цикл
		СетСтарый.Вставить(К, Истина);
		Если СетНовый.Получить(К) = Неопределено Тогда
			Стр = Различия.Добавить();
			Стр.Тип = ТипСравнения;
			Стр.КлючСтарый = К;
			Стр.КлючНовый = "";
			Стр.Описание = "только в БЫЛО";
		КонецЕсли;
	КонецЦикла;
	Для Каждого К Из КлючиНовый Цикл
		Если СетСтарый.Получить(К) = Неопределено Тогда
			Стр = Различия.Добавить();
			Стр.Тип = ТипСравнения;
			Стр.КлючСтарый = "";
			Стр.КлючНовый = К;
			Стр.Описание = "только в СТАЛО";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Различия;
	
КонецФункции

Функция ПостроитьТабличныйДокументСравненияP2(Результат)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ТолькоПросмотр = Ложь;
	ТабДок.Защита = Ложь;
	
	Область = ТабДок.Область(1, 1, 1, 5);
	Область.Объединить();
	Область.Текст = "IMDEV-9104: полный контур P2 было/стало | v. "
		+ СведенияОВнешнейОбработке().Версия;
	Область.Шрифт = Новый Шрифт(, 12, Истина);
	
	ТабДок.Область(2, 1).Текст = "Успех";
	ТабДок.Область(2, 2).Текст = ?(Результат.Успех, "Да", "Нет");
	ТабДок.Область(3, 1).Текст = "Дата";
	ТабДок.Область(3, 2).Текст = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	ТабДок.Область(4, 1).Текст = "N из ДО (имитация)";
	ТабДок.Область(4, 2).Текст = Формат(Результат.КоличествоДоговоров, "ЧГ=0");
	ТабДок.Область(5, 1).Текст = "Пул";
	ТабДок.Область(5, 2).Текст = Строка(Пул);
	ТабДок.Область(6, 1).Текст = "Режим";
	ТабДок.Область(6, 2).Текст = "полный контур x2; откат; внешние ОТКЛ; P2 выкл vs вкл";
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ТабДок.Область(7, 1).Текст = "Ошибка";
		ТабДок.Область(7, 2).Текст = Результат.ТекстОшибки;
	КонецЕсли;
	Если Результат.Свойство("ОшибкаБыло") И ЗначениеЗаполнено(Результат.ОшибкаБыло) Тогда
		ТабДок.Область(8, 1).Текст = "Ошибка БЫЛО";
		ТабДок.Область(8, 2).Текст = Результат.ОшибкаБыло;
	КонецЕсли;
	Если Результат.Свойство("ОшибкаСтало") И ЗначениеЗаполнено(Результат.ОшибкаСтало) Тогда
		ТабДок.Область(8, 1).Текст = ?(ЗначениеЗаполнено(ТабДок.Область(8, 1).Текст), "Ошибки прогонов", "Ошибка СТАЛО");
		Если ЗначениеЗаполнено(Результат.ОшибкаБыло) Тогда
			ТабДок.Область(8, 2).Текст = "БЫЛО: " + Результат.ОшибкаБыло
				+ Символы.ПС + "СТАЛО: " + Результат.ОшибкаСтало;
		Иначе
			ТабДок.Область(8, 2).Текст = Результат.ОшибкаСтало;
		КонецЕсли;
	КонецЕсли;
	
	Стр = 9;
	ТабДок.Область(Стр, 1).Текст = "1. РЕГРЕСС ТЧ + ПОЛЯ ПП";
	ТабДок.Область(Стр, 1).Шрифт = Новый Шрифт(, 10, Истина);
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Результаты совпадают";
	ТабДок.Область(Стр, 2).Текст = ?(Результат.РезультатыСовпадают, "ДА", "НЕТ");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Различий ТЧ";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.РазличийТЧ, "ЧГ=0");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Различий ПП";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.РазличийПП, "ЧГ=0");
	
	Стр = Стр + 2;
	ТабДок.Область(Стр, 1).Текст = "Тип";
	ТабДок.Область(Стр, 2).Текст = "Ключ старый";
	ТабДок.Область(Стр, 3).Текст = "Ключ новый";
	ТабДок.Область(Стр, 4).Текст = "Описание";
	ТабДок.Область(Стр, 1, Стр, 4).Шрифт = Новый Шрифт(, , Истина);
	
	Показано = 0;
	Лимит = 40;
	Для Каждого ИмяПерем Из СтрРазделить("ЗамерыСравненияТЧ,ЗамерыСравненияПП", ",") Цикл
		Табл = Неопределено;
		Если ИмяПерем = "ЗамерыСравненияТЧ" Тогда
			Табл = ЗамерыСравненияТЧ;
		Иначе
			Табл = ЗамерыСравненияПП;
		КонецЕсли;
		Если ТипЗнч(Табл) <> Тип("ТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрРазл Из Табл Цикл
			Стр = Стр + 1;
			ТабДок.Область(Стр, 1).Текст = СтрРазл.Тип;
			ТабДок.Область(Стр, 2).Текст = Лев(СтрРазл.КлючСтарый, 100);
			ТабДок.Область(Стр, 3).Текст = Лев(СтрРазл.КлючНовый, 100);
			ТабДок.Область(Стр, 4).Текст = СтрРазл.Описание;
			Показано = Показано + 1;
			Если Показано >= Лимит Тогда
				Стр = Стр + 1;
				ТабДок.Область(Стр, 1).Текст = "... обрезано";
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Показано >= Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Результат.РазличийТЧ = 0 И Результат.РазличийПП = 0 Тогда
		Стр = Стр + 1;
		ТабДок.Область(Стр, 1).Текст = "(различий нет)";
	КонецЕсли;
	
	Стр = Стр + 3;
	ТабДок.Область(Стр, 1).Текст = "2. СКОРОСТЬ ПОЛНОГО КОНТУРА";
	ТабДок.Область(Стр, 1).Шрифт = Новый Шрифт(, 10, Истина);
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "ПО-СТАРОМУ (P2 выкл)";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.МсПоСтарому, "ЧГ=0");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "ПО-НОВОМУ (P2 вкл)";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.МсПоНовому, "ЧГ=0");
	
	Ускорение = 0;
	Если Результат.МсПоНовому > 0 Тогда
		Ускорение = Результат.МсПоСтарому / Результат.МсПоНовому;
	КонецЕсли;
	Экономия = Результат.МсПоСтарому - Результат.МсПоНовому;
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Ускорение (раз)";
	ТабДок.Область(Стр, 2).Текст = Формат(Ускорение, "ЧДЦ=2; ЧН=0; ЧГ=0");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Экономия, мс";
	ТабДок.Область(Стр, 2).Текст = Формат(Экономия, "ЧГ=0");
	
	Стр = Стр + 2;
	ТабДок.Область(Стр, 1).Текст =
		"Было = полный контур без кэша P2. Стало = тот же контур с ИспользоватьПакетныйКэшP2. "
		+ "Оба прогона с откатом транзакции.";
	ТабДок.Область(Стр, 1, Стр, 5).Объединить();
	
	ТабДок.Область(, 1).ШиринаКолонки = 36;
	ТабДок.Область(, 2).ШиринаКолонки = 28;
	ТабДок.Область(, 3).ШиринаКолонки = 28;
	ТабДок.Область(, 4).ШиринаКолонки = 20;
	
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти


#Область IMDEV9104_ЗамерПолныйКонтур

// Описание: Точка входа тестового полного контура с замерами (без внешних систем)
//
// Возвращаемое значение:
// Структура - Успех, Отказ, ТабДокумент, ТекстОшибки, КоличествоДоговоров, ЗамерыБлоков
//
Функция СформироватьОтчетЗамеровТеста_СтарыйПолныйКонтур() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ТабДокумент", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоДоговоров", 0);
	Результат.Вставить("ЗамерыБлоков", Неопределено);
	
	Отказ = Ложь;
	
	Попытка
		ВыполнитьТестПолныйКонтур(Отказ);
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Отказ = Истина;
		Результат.Успех = Ложь;
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.ЗамерПолный",
			УровеньЖурналаРегистрации.Ошибка,,,
			Результат.ТекстОшибки);
		Возврат Результат;
	КонецПопытки;
	
	Результат.Отказ = (Отказ = Истина);
	Результат.Успех = (Результат.Отказ <> Истина);
	Результат.ЗамерыБлоков = ?(ЗамерыБлоковТеста = Неопределено, Неопределено, ЗамерыБлоковТеста.Скопировать());
	
	Если Результат.ЗамерыБлоков <> Неопределено Тогда
		Для Каждого СтрокаЗамера Из Результат.ЗамерыБлоков Цикл
			Если СтрНачинаетсяС(СтрокаЗамера.Блок, "1.") Тогда
				Результат.КоличествоДоговоров = СтрокаЗамера.СтрокОбработано;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат.ТабДокумент = ПостроитьТабличныйДокументЗамеровПолный(Результат);
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьТестПолныйКонтур(Отказ = Ложь)
	
	ОтключитьВнешниеСистемы = Истина;
	ТестовыйРежим = Истина;
	
	ИнициализироватьЗамерыБлоковПолный();
	
	Если КоличествоДоговоров <= 0 Тогда
		КоличествоДоговоров = 50;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пул) Тогда
		Пул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	КонецЕсли;
	ДатаРасчета = КонецДня(ТекущаяДатаСеанса());
	
	ВремяНачалаОбщее = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.ЗамерПолный",
		УровеньЖурналаРегистрации.Информация,,,
		"Старт полного контура: N=" + Формат(КоличествоДоговоров, "ЧГ=0")
			+ "; Откат=" + Строка(ОткатыватьТранзакцию)
			+ "; ВнешниеСистемы=ОТКЛ");
	
	НужнаТранзакция = (ОткатыватьТранзакцию = Истина);
	Если НужнаТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	
	Попытка
		
		// --- 1. РЗ ---
		СброситьМсДетализациюРЗ();
		ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ДОДоговорыДУКРасторжению();
		МсРодитель = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаБлока;
		ЗаписатьЗамерБлокаПолный(
			"1. ДОДоговорыДУКРасторжению (РЗ)",
			0,
			ДоговорыКРасторжениюИзДО.Количество(),
			"Строк ТЧ=" + Формат(ДоговорыКРасторжениюИзДО.Количество(), "ЧГ=0"),
			МсРодитель);
		ЗаписатьЗамерБлокаПолный("1.0 Имитация GetClosing (из ДУ)", 0, МсДетализация.СтрокВхода,
			"N=" + Формат(МсДетализация.СтрокВхода, "ЧГ=0"), МсДетализация.МсИмитацияВхода);
		ЗаписатьЗамерБлокаПолный("1.1 ДоговорПоНомеру", 0, МсДетализация.СтрокЦиклаРЗ,
			"Сумма мс", МсДетализация.МсДоговорПоНомеру);
		ЗаписатьЗамерБлокаПолный("1.2 АналитическийСчет", 0, МсДетализация.СтрокЦиклаРЗ,
			"Сумма мс", МсДетализация.МсАналитическийСчет);
		ЗаписатьЗамерБлокаПолный("1.3 УстановитьДатуРасторжения", 0, МсДетализация.СтрокЦиклаРЗ,
			"Сумма мс", МсДетализация.МсЗаписьДаты);
		ЗаписатьЗамерБлокаПолный("1.4 БанковскийСчетКлиента", 0, МсДетализация.СтрокЦиклаРЗ,
			"Сумма мс (поиск+создание)", МсДетализация.МсБанковскийСчет);
		ЗаписатьЗамерБлокаПолный("1.5 ДоговорКонтрагента (брокер)", 0, МсДетализация.СтрокЦиклаРЗ,
			"Сумма мс", МсДетализация.МсДоговорКонтрагента);
		ЗаписатьЗамерБлокаПолный("1.6 ПорученияДС (вывод)", 0, МсДетализация.СтрокЦиклаРЗ,
			"Сумма мс (полный боевой ПорученияДС)", МсДетализация.МсПорученияДС);
		
		// --- 2. Форма / полное закрытие ---
		СброситьМсДетализациюОбработки();
		ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ОбработкаДоговоровКРасторжению(Ложь);
		МсРодитель = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаБлока;
		КолОбработки = ДоговорыКРасторжению.Количество()
			+ ДоговорыКРасторжениюМатВыгода.Количество()
			+ ДоговорыКРасторжениюПослеОхлаждения.Количество();
		ЗаписатьЗамерБлокаПолный(
			"2. ОбработкаДоговоровКРасторжению",
			0,
			КолОбработки,
			"ТЧ охлаждение=" + Формат(ДоговорыКРасторжению.Количество(), "ЧГ=0")
				+ "; матвыгода=" + Формат(ДоговорыКРасторжениюМатВыгода.Количество(), "ЧГ=0")
				+ "; после=" + Формат(ДоговорыКРасторжениюПослеОхлаждения.Количество(), "ЧГ=0"),
			МсРодитель);
		ЗаписатьЗамерБлокаПолный("2.1 ДанныеНДФЛИзФИН", 0, 0,
			"отключено (заглушка)", МсДетализация.МсНДФЛИзФИН);
		ЗаписатьЗамерБлокаПолный("2.2 ДанныеПоРасторжению (полный запрос)", 0, МсДетализация.СтрокВыборки,
			"Строк выборки=" + Формат(МсДетализация.СтрокВыборки, "ЧГ=0"), МсДетализация.МсДанныеПоРасторжению);
		ЗаписатьЗамерБлокаПолный("2.3 Цикл: ПолучитьСуммыРСА_СЧА", 0, МсДетализация.СтрокЦиклаОбработки,
			"Вызовов=" + Формат(МсДетализация.ВызововСЧА, "ЧГ=0"), МсДетализация.МсСЧА);
		ЗаписатьЗамерБлокаПолный("2.4 Цикл: УдалитьПереводНаБиржу", 0, МсДетализация.ВызововУдалитьПеревод,
			"Вызовов=" + Формат(МсДетализация.ВызововУдалитьПеревод, "ЧГ=0"), МсДетализация.МсУдалитьПеревод);
		ЗаписатьЗамерБлокаПолный("2.5 Цикл: ЗакрытьДоговор (+дата в ДУ)", 0, МсДетализация.СтрокЦиклаОбработки,
			"Закрыто=" + Формат(МсДетализация.ЗакрытоДоговоров, "ЧГ=0"), МсДетализация.МсЗакрытьДоговор);
		ЗаписатьЗамерБлокаПолный("2.6 Цикл: прочая логика (вознагр./поручения/ПП)", 0, МсДетализация.СтрокЦиклаОбработки,
			"Тело цикла без СЧА/удаления/закрытия", МсДетализация.МсПрочаяЛогикаЦикла);
		ЗаписатьЗамерБлокаПолный("2.7 НачислитьВознаграждение", 0, 0,
			"", МсДетализация.МсНачислитьВознаграждение);
		
		// --- 3. Рассылки (только чтение) ---
		ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КолРассылки = 0;
		МсПоВидам = Новый Массив;
		НомерВида = 0;
		Для Каждого ВидРассылки Из СтрРазделить("Перевод,Вывод,Ввод,МатВыгода", ",") Цикл
			НомерВида = НомерВида + 1;
			Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ТаблицаСтрок = ДанныеДляРассылки(СокрЛП(ВидРассылки));
			МсВид = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
			КолРассылки = КолРассылки + ТаблицаСтрок.Количество();
			МсПоВидам.Добавить(Новый Структура("Номер,Вид,Мс,Строк",
				НомерВида, СокрЛП(ВидРассылки), МсВид, ТаблицаСтрок.Количество()));
		КонецЦикла;
		ЗаписатьЗамерБлокаПолный(
			"3. ДанныеДляРассылки x4 (без почты/FO)",
			ВремяНачалаБлока,
			КолРассылки,
			"Строк суммарно=" + Формат(КолРассылки, "ЧГ=0"));
		Для Каждого СтрВид Из МсПоВидам Цикл
			ЗаписатьЗамерБлокаПолный(
				"3." + Формат(СтрВид.Номер, "ЧГ=0") + " ДанныеДляРассылки." + СтрВид.Вид,
				0,
				СтрВид.Строк,
				"Строк=" + Формат(СтрВид.Строк, "ЧГ=0"),
				СтрВид.Мс);
		КонецЦикла;
		
		ЗаписатьЗамерБлокаПолный(
			"0. ИТОГО",
			ВремяНачалаОбщее,
			ДоговорыКРасторжениюИзДО.Количество(),
			"ВнешниеСистемы=ОТКЛ; Откат=" + Строка(ОткатыватьТранзакцию));
		
		Если НужнаТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
	Исключение
		ТекстОшибкиТеста = ОписаниеОшибки();
		Если НужнаТранзакция И ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Отказ = Истина;
		ЗаписатьЗамерБлокаПолный("0. ИТОГО", ВремяНачалаОбщее, 0, ТекстОшибкиТеста);
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.ЗамерПолный",
			УровеньЖурналаРегистрации.Ошибка,,,
			"Тест остановлен: " + ТекстОшибкиТеста);
		// Без ВызватьИсключение: таблица замеров должна остаться на форме.
	КонецПопытки;
	
	РассчитатьДолиЗамеровПолный();
	
КонецПроцедуры

// Описание: После ошибки записи/удаления в режиме отката транзакция портится.
// Без Отменить+Начать дальше любой Записать падает с "уже происходили ошибки".
//
Процедура СброситьИспорченнуюТранзакциюОтката(КонтекстОшибки = "", ПрерыватьКонтур = Истина)
	
	Если ОткатыватьТранзакцию <> Истина Тогда
		Возврат;
	КонецЕсли;
	Если Не ТранзакцияАктивна() Тогда
		НачатьТранзакцию();
		Возврат;
	КонецЕсли;
	
	ОтменитьТранзакцию();
	НачатьТранзакцию();
	
	Если ПрерыватьКонтур = Истина Тогда
		КонтурПрерванИзЗаСбросаТранзакции = Истина;
		ТекстПоследнегоСбросаТранзакции = КонтекстОшибки;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.СравнениеПолныйP2",
		УровеньЖурналаРегистрации.Предупреждение,,,
		"Транзакция отката перезапущена"
			+ ?(ПрерыватьКонтур = Истина, "; контур будет прерван", " (без прерывания контура)")
			+ ?(ПустаяСтрока(КонтекстОшибки), "", ": " + КонтекстОшибки));
	
КонецПроцедуры

Функция ИмитацияGetClosingRetailAgreementsИзДУ()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	ДоговорыДУ.Ссылка КАК ДоговорДУ,
	|	ДоговорыДУ.Код КАК НомерДУ,
	|	ДоговорыДУ.Клиент КАК Контрагент,
	|	ЕСТЬNULL(БанковскиеСчета.Банк.Код, """") КАК Бик,
	|	ЕСТЬNULL(БанковскиеСчета.НомерСчета, """") КАК НомерСчета
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорыДУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	|		ПО ДоговорыДУ.Клиент = БанковскиеСчета.Владелец
	|			И (БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный))
	|			И (НЕ БанковскиеСчета.ПометкаУдаления)
	|ГДЕ
	|	ДоговорыДУ.Пул = &Пул
	|	И НЕ ДоговорыДУ.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорыДУ.Код";
	
	Если КоличествоДоговоров > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 500", "ПЕРВЫЕ " + Формат(КоличествоДоговоров, "ЧГ=0"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Пул", Пул);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	Номер = 0;
	Пока Выборка.Следующий() Цикл
		Номер = Номер + 1;
		Элемент = Новый Структура;
		Элемент.Вставить("НомерДУ", Выборка.НомерДУ);
		Элемент.Вставить("НомерРасторжения", "T9104-" + Формат(Номер, "ЧГ=0"));
		Элемент.Вставить("ДатаРасторжения", НачалоДня(ДатаРасчета));
		Элемент.Вставить("Бик", Выборка.Бик);
		Элемент.Вставить("НомерСчета", Выборка.НомерСчета);
		Элемент.Вставить("НетПоручениеВывод", Истина);
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ИнициализироватьЗамерыБлоковПолный()
	
	ЗамерыБлоковТеста = Новый ТаблицаЗначений;
	ЗамерыБлоковТеста.Колонки.Добавить("Блок", Новый ОписаниеТипов("Строка"));
	ЗамерыБлоковТеста.Колонки.Добавить("ВремяМс", Новый ОписаниеТипов("Число"));
	ЗамерыБлоковТеста.Колонки.Добавить("ДоляПроц", Новый ОписаниеТипов("Число"));
	ЗамерыБлоковТеста.Колонки.Добавить("СтрокОбработано", Новый ОписаниеТипов("Число"));
	ЗамерыБлоковТеста.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	
КонецПроцедуры

Процедура ЗаписатьЗамерБлокаПолный(ИмяБлока, ВремяНачала, СтрокОбработано, Комментарий = "", ВремяМсЗадан = -1)
	
	Если ВремяМсЗадан >= 0 Тогда
		ВремяМс = ВремяМсЗадан;
	Иначе
		ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	КонецЕсли;
	
	СтрокаЗамера = ЗамерыБлоковТеста.Добавить();
	СтрокаЗамера.Блок = ИмяБлока;
	СтрокаЗамера.ВремяМс = ВремяМс;
	СтрокаЗамера.СтрокОбработано = СтрокОбработано;
	СтрокаЗамера.Комментарий = Комментарий;
	
КонецПроцедуры

Процедура РассчитатьДолиЗамеровПолный()
	
	Если ЗамерыБлоковТеста = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИтогоМс = 0;
	Для Каждого СтрокаЗамера Из ЗамерыБлоковТеста Цикл
		Если СтрНачинаетсяС(СтрокаЗамера.Блок, "0.") Тогда
			ИтогоМс = СтрокаЗамера.ВремяМс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ИтогоМс <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаЗамера Из ЗамерыБлоковТеста Цикл
		СтрокаЗамера.ДоляПроц = Окр(100 * СтрокаЗамера.ВремяМс / ИтогоМс, 2);
	КонецЦикла;
	
	// Дерево: не сортируем по времени (сохраняем иерархию 0/1/1.x/2/2.x/3/3.x)
	
КонецПроцедуры

Процедура СброситьМсДетализациюРЗ()
	
	МсДетализация = Новый Структура;
	МсДетализация.Вставить("МсИмитацияВхода", 0);
	МсДетализация.Вставить("МсДоговорПоНомеру", 0);
	МсДетализация.Вставить("МсАналитическийСчет", 0);
	МсДетализация.Вставить("МсЗаписьДаты", 0);
	МсДетализация.Вставить("МсБанковскийСчет", 0);
	МсДетализация.Вставить("МсДоговорКонтрагента", 0);
	МсДетализация.Вставить("МсПорученияДС", 0);
	МсДетализация.Вставить("СтрокВхода", 0);
	МсДетализация.Вставить("СтрокЦиклаРЗ", 0);
	
КонецПроцедуры

Процедура СброситьМсДетализациюОбработки()
	
	Если ТипЗнч(МсДетализация) <> Тип("Структура") Тогда
		МсДетализация = Новый Структура;
	КонецЕсли;
	
	МсДетализация.Вставить("МсНДФЛИзФИН", 0);
	МсДетализация.Вставить("МсДанныеПоРасторжению", 0);
	МсДетализация.Вставить("МсСЧА", 0);
	МсДетализация.Вставить("МсУдалитьПеревод", 0);
	МсДетализация.Вставить("МсЗакрытьДоговор", 0);
	МсДетализация.Вставить("МсПрочаяЛогикаЦикла", 0);
	МсДетализация.Вставить("МсНачислитьВознаграждение", 0);
	МсДетализация.Вставить("СтрокВыборки", 0);
	МсДетализация.Вставить("СтрокЦиклаОбработки", 0);
	МсДетализация.Вставить("ВызововСЧА", 0);
	МсДетализация.Вставить("ВызововУдалитьПеревод", 0);
	МсДетализация.Вставить("ЗакрытоДоговоров", 0);
	
КонецПроцедуры

Функция ПостроитьТабличныйДокументЗамеровПолный(РезультатТеста)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Защита = Ложь;
	ТабДок.ТолькоПросмотр = Ложь;
	
	Область = ТабДок.Область(1, 1, 1, 5);
	Область.Объединить();
	Область.Текст = "IMDEV-9104: ПОЛНЫЙ контур расторжения РДУ (внешние системы ОТКЛ) — дерево замеров";
	Область.Шрифт = Новый Шрифт(, 12, Истина);
	
	ТабДок.Область(2, 1).Текст = "Успех: " + ?(РезультатТеста.Успех, "Да", "Нет");
	ТабДок.Область(3, 1).Текст = "Дата: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	ТабДок.Область(4, 1).Текст =
		"N=" + Формат(КоличествоДоговоров, "ЧГ=0")
		+ "; Пул=" + Строка(Пул)
		+ "; Откат=" + Строка(ОткатыватьТранзакцию)
		+ "; ДО/ФИН/FO/почта=НЕТ";
	
	Если ЗначениеЗаполнено(РезультатТеста.ТекстОшибки) Тогда
		ТабДок.Область(5, 1).Текст = "Ошибка: " + РезультатТеста.ТекстОшибки;
	КонецЕсли;
	
	Ном = 7;
	ТабДок.Область(Ном, 1).Текст = "Блок (дерево)";
	ТабДок.Область(Ном, 2).Текст = "Время, мс";
	ТабДок.Область(Ном, 3).Текст = "Доля, %";
	ТабДок.Область(Ном, 4).Текст = "Строк";
	ТабДок.Область(Ном, 5).Текст = "Комментарий";
	ТабДок.Область(Ном, 1, Ном, 5).Шрифт = Новый Шрифт(, , Истина);
	
	Если РезультатТеста.ЗамерыБлоков <> Неопределено Тогда
		// Печать деревом: 0 -> 1/1.x -> 2/2.x -> 3/3.x
		ПорядокКорней = СтрРазделить("0.,1. ДО,2. Обр,3. Данн", ",");
		Для Каждого ПрефиксКорня Из ПорядокКорней Цикл
			Для Каждого СтрокаЗамера Из РезультатТеста.ЗамерыБлоков Цикл
				Если Не СтрНачинаетсяС(СтрокаЗамера.Блок, СокрЛП(ПрефиксКорня)) Тогда
					Продолжить;
				КонецЕсли;
				Если СтрНайти(СтрокаЗамера.Блок, ".") > 0
					И Не СтрНачинаетсяС(СтрокаЗамера.Блок, "0.")
					И Сред(СтрокаЗамера.Блок, 2, 1) = "."
					И СтрДлина(СтрокаЗамера.Блок) > 3
					И Сред(СтрокаЗамера.Блок, 3, 1) >= "0"
					И Сред(СтрокаЗамера.Блок, 3, 1) <= "9" Тогда
					// лист 1.0 / 2.3 — печатаем после корня в отдельном проходе
					Продолжить;
				КонецЕсли;
				Ном = Ном + 1;
				ТабДок.Область(Ном, 1).Текст = СтрокаЗамера.Блок;
				ТабДок.Область(Ном, 2).Текст = Формат(СтрокаЗамера.ВремяМс, "ЧГ=0");
				ТабДок.Область(Ном, 3).Текст = Формат(СтрокаЗамера.ДоляПроц, "ЧДЦ=2; ЧН=0");
				ТабДок.Область(Ном, 4).Текст = Формат(СтрокаЗамера.СтрокОбработано, "ЧГ=0");
				ТабДок.Область(Ном, 5).Текст = СтрокаЗамера.Комментарий;
				ТабДок.Область(Ном, 1, Ном, 5).Шрифт = Новый Шрифт(, , Истина);
				
				НомерКорня = Лев(СтрокаЗамера.Блок, 1);
				Для Каждого СтрокаЛист Из РезультатТеста.ЗамерыБлоков Цикл
					Если Не СтрНачинаетсяС(СтрокаЛист.Блок, НомерКорня + ".") Тогда
						Продолжить;
					КонецЕсли;
					Если СтрНачинаетсяС(СтрокаЛист.Блок, СтрокаЗамера.Блок) Тогда
						Продолжить; // сам корень
					КонецЕсли;
					// только "N.digit ..."
					Если СтрДлина(СтрокаЛист.Блок) < 3 Или Сред(СтрокаЛист.Блок, 3, 1) < "0" Или Сред(СтрокаЛист.Блок, 3, 1) > "9" Тогда
						Продолжить;
					КонецЕсли;
					Ном = Ном + 1;
					ТабДок.Область(Ном, 1).Текст = "    " + СтрокаЛист.Блок;
					ТабДок.Область(Ном, 2).Текст = Формат(СтрокаЛист.ВремяМс, "ЧГ=0");
					ТабДок.Область(Ном, 3).Текст = Формат(СтрокаЛист.ДоляПроц, "ЧДЦ=2; ЧН=0");
					ТабДок.Область(Ном, 4).Текст = Формат(СтрокаЛист.СтрокОбработано, "ЧГ=0");
					ТабДок.Область(Ном, 5).Текст = СтрокаЛист.Комментарий;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ТабДок.Область(Ном + 2, 1).Текст =
		"Дерево: 1.x = шаги РЗ; 2.x = шаги формы (в т.ч. полный ДанныеПоРасторжению и СЧА); 3.x = рассылки без почты.";
	
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ДОДоговорыДУКРасторжению() Экспорт

	// IMDEV-9104: вход из ДО отключен - имитация из ДУ
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если ОтключитьВнешниеСистемы = Истина Тогда
		СтруктураJSON = ИмитацияGetClosingRetailAgreementsИзДУ();
	ИначеЕсли ТестовыйРежим Тогда
		СтруктураJSON = ТестовыеРасторжения();
	Иначе
		Сервис = ПолучитьСервис(АдресВебДО, ПользовательДО, ПарольДО);
		Результат = Сервис.GetClosingRetailAgreements();
		СтруктураJSON = ПолучитьСтруктураJSON(Результат);
	КонецЕсли;
	Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
		МсДетализация.МсИмитацияВхода = МсДетализация.МсИмитацияВхода
			+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
		МсДетализация.СтрокВхода = СтруктураJSON.Количество();
	КонецЕсли;
	
	ДоговорыКРасторжениюИзДО.Очистить();
	
	Для Каждого ДанныеРасторжения Из СтруктураJSON Цикл
	
		Если ТестовыйРежим Тогда
			ДатаРасторжения = ДанныеРасторжения.ДатаРасторжения;
		Иначе
			ДатаРасторжения = ПрочитатьДатуJSON(ДанныеРасторжения.ДатаРасторжения, ФорматДатыJSON.ISO);
		КонецЕсли;
		
		Если ДатаРасторжения <= ДатаРасчета Тогда
		
			Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ДоговорДУ = ДоговорПоНомеру(ДанныеРасторжения.НомерДУ);
			Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
				МсДетализация.МсДоговорПоНомеру = МсДетализация.МсДоговорПоНомеру
					+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
			КонецЕсли;
			
			ДоговорКРасторжению = ДоговорыКРасторжениюИзДО.Добавить();
			ДоговорКРасторжению.ДанныеДО = 
				"НомерДУ - " + ДанныеРасторжения.НомерДУ + 
				";Номер расторжения - " + ДанныеРасторжения.НомерРасторжения +
				"; Дата расторжения - " + Формат(ДатаРасторжения, "ДФ=dd.MM.yyyy") +
				"; БИК - " + ДанныеРасторжения.Бик +
				"; Номер счета - " + ДанныеРасторжения.НомерСчета;
			
			ДоговорКРасторжению.НомерРасторжения = ДанныеРасторжения.НомерРасторжения;
			ДоговорКРасторжению.ДатаРасторжения = ДатаРасторжения;
			ДоговорКРасторжению.ДоговорДУ = ДоговорДУ;
			
			МинимальнаяДатаВводаДС(ДоговорДУ);
			
			РасторжениеПериодОхлаждения = (НачалоДня(ДатаРасторжения) - НачалоДня(ДоговорДУ.ДатаВводаСредствВДУ))/(24*60*60) <= 14;
			
			Если ДоговорДУ <> Справочники.ДоговорДУ.ПустаяСсылка() Тогда
			
				Если НЕ (ТестовыйРежим И ДанныеРасторжения.НетПоручениеВывод) Тогда
					Если ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <> Дата(1,1,1) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
					МсДетализация.СтрокЦиклаРЗ = МсДетализация.СтрокЦиклаРЗ + 1;
				КонецЕсли;
				
				ДоговорКРасторжению.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорДУ, "Клиент");
				
				Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
				ДоговорКРасторжению.АналитическийСчет = АналитическийСчет(ДоговорДУ, ЕРС);
				Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
					МсДетализация.МсАналитическийСчет = МсДетализация.МсАналитическийСчет
						+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
				КонецЕсли;
				
				Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
				УстановитьДатуРасторжения(ДоговорДУ, ДатаРасторжения);
				Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
					МсДетализация.МсЗаписьДаты = МсДетализация.МсЗаписьДаты
						+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
				КонецЕсли;
				
				Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
				СчетКонтрагента = БанковскийСчетКлиента(ДоговорДУ, ДоговорКРасторжению.Контрагент, ДанныеРасторжения.Бик, ДанныеРасторжения.НомерСчета);
				Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
					МсДетализация.МсБанковскийСчет = МсДетализация.МсБанковскийСчет
						+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
				КонецЕсли;
				Если СчетКонтрагента = Справочники.БанковскиеСчета.ПустаяСсылка() Тогда
					ДоговорКРасторжению.РезультатОтменыУведомленияРасторженияДО = "некорректно указан расчтеный счет для вывод ДС";
				КонецЕсли;
				ДоговорКРасторжению.СчетКонтрагента = СчетКонтрагента;
				
				Роль = Перечисления.РолиДоговоровКонтрагента.Брокерский;
				Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
				ДоговорКонтрагента = ДоговорКонтрагента(ДоговорКРасторжению.ДоговорДУ, Роль);
				Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
					МсДетализация.МсДоговорКонтрагента = МсДетализация.МсДоговорКонтрагента
						+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
				КонецЕсли;
				
				Параметры = Новый Структура;
				Параметры.Вставить("ДоговорДУ" , ДоговорКРасторжению.ДоговорДУ);
				Параметры.Вставить("АналитическийСчетИсточник", ДоговорКРасторжению.АналитическийСчет);
				Параметры.Вставить("АналитическийСчетПриемник", Справочники.АналитическиеСчета.ПустаяСсылка());
				Параметры.Вставить("Контрагент", ДоговорКРасторжению.Контрагент);
				Параметры.Вставить("ДоговорКонтрагента", ДоговорКонтрагента); 
				Параметры.Вставить("НомерРасторжения", ДоговорКРасторжению.НомерРасторжения);
				Параметры.Вставить("ДатаРасторжения", ДатаРасторжения);
				Параметры.Вставить("ДатаПоручения", ДатаРасторжения); 
				Параметры.Вставить("РасчетныйСчет", СчетКонтрагента);
				Параметры.Вставить("ВидОперации", Перечисления.ВидыОперацийПоручение.ВыводИзДУ);
				Параметры.Вставить("СпособПодачи", Перечисления.СпособыПодачиПоручения.ЭлектронныйДокумент);
				Параметры.Вставить("СуммаДС", 0);
				Параметры.Вставить("Комментарий", ?(РасторжениеПериодОхлаждения, "Расторжение в период охлаждения", 
																				"Расторжение после периода охлаждения"));
				
				Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
				ДоговорКРасторжению.ПоручениеПоДСНаВывод = ПорученияДС(Параметры);
				Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
					МсДетализация.МсПорученияДС = МсДетализация.МсПорученияДС
						+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
				КонецЕсли;
			
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаДоговоровКРасторжению(ФоновоеВыполнение = Ложь) Экспорт

	ДоговорыКРасторжению.Очистить();
	ДоговорыКРасторжениюМатВыгода.Очистить();
	ДоговорыКРасторжениюПослеОхлаждения.Очистить();
	
	// IMDEV-9104: внешние сервисы всегда отключены в этом контуре
	СервисФИН = Неопределено;
	СервисДО = Неопределено;
	Если ОтключитьВнешниеСистемы <> Истина И Не ТестовыйРежим Тогда
		СервисФИН = ПолучитьСервис(АдресВебФИН, ПользовательФИН, ПарольФИН);
		СервисДО = ПолучитьСервис(АдресВебДО, ПользовательДО, ПарольДО);
	КонецЕсли;
	
	Т0НДФЛ = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДанныеНДФЛИзФИН();
	Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
		МсДетализация.МсНДФЛИзФИН = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0НДФЛ;
	КонецЕсли;
	
	ДоговорыДУПослеОхлаждения = Новый Массив();
	
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДанныеПоРасторжению = ДанныеПоРасторжению();
	Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
		МсДетализация.МсДанныеПоРасторжению = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
	КонецЕсли;
	
	// IMDEV-9104-P2 ++
	Если ИспользоватьПакетныйКэшP2 = Истина Тогда
		ВалютаКэшаПлатежныхПозиций = ОбщегоНазначенияДУ.ВалютаРеглУчета();
		КэшПлатежныхПозицийПакет = ПодготовитьКэшПлатежныхПозицийПоСчетамДС(
			СписокДоговоровДляКэшаПлатежныхПозиций(ДанныеПоРасторжению),
			ВалютаКэшаПлатежныхПозиций);
	Иначе
		КэшПлатежныхПозицийПакет = Неопределено;
		ВалютаКэшаПлатежныхПозиций = Неопределено;
	КонецЕсли;
	// IMDEV-9104-P2 --
	
	ВыборкаДетальныеЗаписи = ДанныеПоРасторжению.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если КонтурПрерванИзЗаСбросаТранзакции = Истина Тогда
			Прервать;
		КонецЕсли;
		
		Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
			МсДетализация.СтрокВыборки = МсДетализация.СтрокВыборки + 1;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.СуммаВводаДС = 0 Тогда
			//Если у начитанного обработкой договора ДУ по регистру Ввод /вывод УУ, не было движения-договор игнорируется
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
			МсДетализация.СтрокЦиклаОбработки = МсДетализация.СтрокЦиклаОбработки + 1;
		КонецЕсли;
		
		МатВыгода = 0;
		СуммаРСА = 0;
		СуммаСЧА = 0;
		Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Документы.РасчетСЧА_РСА.ПолучитьСуммыРСА_СЧА(ВыборкаДетальныеЗаписи.ДоговорДУ, КонецДня(ДатаРасчета), Ложь, Истина, СуммаРСА, СуммаСЧА);
		Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
			МсДетализация.МсСЧА = МсДетализация.МсСЧА + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
			МсДетализация.ВызововСЧА = МсДетализация.ВызововСЧА + 1;
		КонецЕсли;
		
		Т0Прочее = ТекущаяУниверсальнаяДатаВМиллисекундах();
		МсУдалИтер = 0;
		МсЗакрИтер = 0;
		
		СуммаВводаДС = ВыборкаДетальныеЗаписи.СуммаВводаДС + КомиссияСтороннийБанк(ВыборкаДетальныеЗаписи);
		Если ВыборкаДетальныеЗаписи.РасторжениеВПериодОхлаждения Тогда
			Если ВыборкаДетальныеЗаписи.БумагиПроданы 
				И ВыборкаДетальныеЗаписи.НДФЛНачислен Тогда
				Если ВыборкаДетальныеЗаписи.ПоручениеПоДСНаВвод = Документы.Поручение.ПустаяСсылка() Тогда
					Если СуммаСЧА = 0 Тогда
						МатВыгода = 0;
					Иначе
						МатВыгода = ?(СуммаСЧА < СуммаВводаДС, СуммаВводаДС - СуммаСЧА, 0);
					КонецЕсли;
				Иначе
					Если ВыборкаДетальныеЗаписи.ПлатежныеПорученияНДФЛ Или СуммаСЧА = СуммаВводаДС Или СуммаСЧА = 0 Тогда
						МатВыгода = ВыборкаДетальныеЗаписи.СуммаКомпенсации;
					Иначе
						МатВыгода = ?(СуммаСЧА < СуммаВводаДС, СуммаВводаДС - СуммаСЧА, 0);
					КонецЕсли;
				КонецЕсли;
			Иначе
				МатВыгода = ?(СуммаСЧА < СуммаВводаДС, СуммаВводаДС - СуммаСЧА, 0);
			КонецЕсли;
		КонецЕсли;

		Если ВыборкаДетальныеЗаписи.СтатусПорученияНаБиржу = Перечисления.СтатусыОбъектов.Новый
			И ВыборкаДетальныеЗаписи.БумагиБезОборот Тогда
			Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
			УдалитьПереводНаБиржу(ВыборкаДетальныеЗаписи.ДоговорДУ);
			МсУдалИтер = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
			Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
				МсДетализация.МсУдалитьПеревод = МсДетализация.МсУдалитьПеревод + МсУдалИтер;
				МсДетализация.ВызововУдалитьПеревод = МсДетализация.ВызововУдалитьПеревод + 1;
			КонецЕсли;
		КонецЕсли;
		
		СтатусыДокументов = СтатусыДокументов(ВыборкаДетальныеЗаписи);
		
		Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ДоговорЗакрытСейчас = ЗакрытьДоговор(ВыборкаДетальныеЗаписи.ДоговорДУ, СервисДО,
							СтатусыДокументов, СуммаСЧА, ВыборкаДетальныеЗаписи.НомерДУ);
		МсЗакрИтер = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
		Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
			МсДетализация.МсЗакрытьДоговор = МсДетализация.МсЗакрытьДоговор + МсЗакрИтер;
			Если ДоговорЗакрытСейчас Тогда
				МсДетализация.ЗакрытоДоговоров = МсДетализация.ЗакрытоДоговоров + 1;
			КонецЕсли;
		КонецЕсли;
		
		Если ДоговорЗакрытСейчас Тогда
			Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
				МсДетализация.МсПрочаяЛогикаЦикла = МсДетализация.МсПрочаяЛогикаЦикла
					+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0Прочее - МсУдалИтер - МсЗакрИтер);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.РасторжениеВПериодОхлаждения Тогда
			Если МатВыгода > 0 Тогда
				ДоговорКРасторжению = ДоговорыКРасторжениюМатВыгода.Добавить();
				ДоговорКРасторжению.МатВыгода = МатВыгода;
			Иначе
				ДоговорКРасторжению = ДоговорыКРасторжению.Добавить();
			КонецЕсли;
		Иначе
			ДоговорКРасторжению = ДоговорыКРасторжениюПослеОхлаждения.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДоговорКРасторжению, ВыборкаДетальныеЗаписи);
		ДоговорКРасторжению.СуммаСЧА = СуммаСЧА;
		
		ДоговорКРасторжению.СЧАРавноСуммаВвода = СуммаСЧА = СуммаВводаДС;
		
		Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаДетальныеЗаписи.ДоговорДУ, "Клиент");
		АналитическийСчет = АналитическийСчет(ВыборкаДетальныеЗаписи.ДоговорДУ);
		ДоговорКРасторжению.АналитическийСчет = АналитическийСчет;
		ДоговорКРасторжению.Контрагент = Контрагент;
		
		Если МатВыгода > 0 И ВыборкаДетальныеЗаписи.РасторжениеВПериодОхлаждения Тогда
			ДоговорКРасторжению.СуммаКВыводу = ВыборкаДетальныеЗаписи.СуммаВводаДС;
		Иначе
			ДоговорКРасторжению.СуммаКВыводу = ДоговорКРасторжению.СуммаСЧА - КомиссияСтороннийБанк(ДоговорКРасторжению);
		КонецЕсли;
		
		Если Не ВыборкаДетальныеЗаписи.РасторжениеВПериодОхлаждения Тогда
		
			ДоговорКРасторжению.Вознаграждение = Не ДоговорКРасторжению.НачислениеКомиссииДосрочныйВывод.Пустая();
			Если не ДоговорКРасторжению.Вознаграждение Тогда
				ИнициироватьВознаграждение(ДоговорКРасторжению, ВыборкаДетальныеЗаписи.СуммаВводаДС);
			КонецЕсли;
		
		КонецЕсли;
		
		Если ДоговорКРасторжению.СтатусПорученияНаВывод <> Перечисления.СтатусыОбъектов.Исполнено Тогда
			УчестьНДФЛПриРасторжении(ДоговорКРасторжению);
		КонецЕсли;
		
		Если ДоговорКРасторжению.БумагиПроданы 
			И ВыборкаДетальныеЗаписи.СуммаНаБрС > 0 Тогда 
			
			Если ДоговорКРасторжению.ПоручениеПоДСНаПеревод = Документы.Поручение.ПустаяСсылка() Тогда
			
				ПоручениеДСНаПеревод(ДоговорКРасторжению, ВыборкаДетальныеЗаписи.СуммаНаБрС);
				ДоговорКРасторжению.СтатусПорученияПеревод = 
					?(ДоговорКРасторжению.ПоручениеПоДСНаПеревод = Документы.Поручение.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
					ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.ПоручениеПоДСНаПеревод));
			КонецЕсли;

		КонецЕсли;
		
		Если ДоговорКРасторжению.БумагиПроданы Тогда
			
			Если МатВыгода > 0 И ВыборкаДетальныеЗаписи.РасторжениеВПериодОхлаждения Тогда
				Если (ДоговорКРасторжению.ПоручениеПоДСНаВвод = Документы.Поручение.ПустаяСсылка()
					ИЛИ ДоговорКРасторжению.СтатусПорученияНаВвод = Перечисления.СтатусыОбъектов.Новый) Тогда
					
					ПоручениеДСНаВводКомпенсации(ДоговорКРасторжению);
					ДоговорКРасторжению.СтатусПорученияНаВвод = 
						?(ДоговорКРасторжению.ПоручениеПоДСНаВвод = Документы.Поручение.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
						ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.ПоручениеПоДСНаВвод));
				КонецЕсли;
				
				//Если Не ВыборкаДетальныеЗаписи.НДФЛНачислен И Не ТестовыйРежим Тогда
				//	Комментарий = "";
				//	ВхПараметры = Новый Структура;
				//	ВхПараметры.Вставить("НомерДУ", ДоговорКРасторжению.НомерДУ);
				//	ВхПараметры.Вставить("Дата", ДатаРасчета);
				//	ВхПараметры.Вставить("Сумма", ДоговорКРасторжению.МатВыгода);
				//	ВхПараметры.Вставить("Комментарий", Комментарий);
				//
				//	ОтветJSON = ОтправитьМатВыгодуФИН(СервисФИН, ВхПараметры);
				//	ДоговорКРасторжению.ОписаниеОшибки = ОтветJSON(ОтветJSON);
				//КонецЕсли;
				
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.НДФЛНачислен Тогда
				Если ДоговорКРасторжению.СтатусПорученияПеревод = Перечисления.СтатусыОбъектов.Исполнено Тогда
					Если МатВыгода > 0 Тогда
						Если ДоговорКРасторжению.СЧАРавноСуммаВвода Тогда
							Если ДоговорКРасторжению.СтатусПорученияНаВывод = Перечисления.СтатусыОбъектов.Новый Тогда
								Если ДостаточноДенегНаСчету(ДоговорКРасторжению.ПоручениеПоДСНаВывод) Тогда
									ДоговорКРасторжению.ПлатежноеПоручениеНаВывод  = ПлатежноеПоручение(ДоговорКРасторжению.ПоручениеПоДСНаВывод, "Вывод");
								КонецЕсли;
									
								ДоговорКРасторжению.СтатусПорученияНаВывод = 
									?(ДоговорКРасторжению.ПоручениеПоДСНаВывод = Документы.Поручение.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
									ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.ПоручениеПоДСНаВывод));
							КонецЕсли;
							
							Если ДоговорКРасторжению.СтатусНачислениеНДФЛ = Перечисления.СтатусыОбъектов.Новый Тогда
								ДоговорКРасторжению.ПлатежноеПоручениеНДФЛ = ПлатежноеПоручение(ДоговорКРасторжению.НачислениеЗадолженностиНДФЛ, "НДФЛ");
								
								ДоговорКРасторжению.СтатусНачислениеНДФЛ = 
									?(ДоговорКРасторжению.НачислениеЗадолженностиНДФЛ = Документы.НачислениеЗадолженности.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
									ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.НачислениеЗадолженностиНДФЛ));
							КонецЕсли;
						КонецЕсли;
					Иначе
						Если ДоговорКРасторжению.СтатусПорученияНаВывод = Перечисления.СтатусыОбъектов.Новый Тогда
							Если ДостаточноДенегНаСчету(ДоговорКРасторжению.ПоручениеПоДСНаВывод) Тогда
								ДоговорКРасторжению.ПлатежноеПоручениеНаВывод  = ПлатежноеПоручение(ДоговорКРасторжению.ПоручениеПоДСНаВывод, "Вывод");
							КонецЕсли;
							
							ДоговорКРасторжению.СтатусПорученияНаВывод = 
								?(ДоговорКРасторжению.ПоручениеПоДСНаВывод = Документы.Поручение.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
								ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.ПоручениеПоДСНаВывод));
						КонецЕсли;
						
						Если ДоговорКРасторжению.СтатусНачислениеНДФЛ = Перечисления.СтатусыОбъектов.Новый Тогда
							ДоговорКРасторжению.ПлатежноеПоручениеНДФЛ = ПлатежноеПоручение(ДоговорКРасторжению.НачислениеЗадолженностиНДФЛ, "НДФЛ");
								
							ДоговорКРасторжению.СтатусНачислениеНДФЛ = 
								?(ДоговорКРасторжению.НачислениеЗадолженностиНДФЛ = Документы.НачислениеЗадолженности.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
								ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.НачислениеЗадолженностиНДФЛ));
						КонецЕсли;
						
						Если Не ВыборкаДетальныеЗаписи.РасторжениеВПериодОхлаждения Тогда
							Если ДоговорКРасторжению.СтатусНачислениеВознаграждения = Перечисления.СтатусыОбъектов.Новый Тогда
								ДоговорКРасторжению.ПлатежноеПоручениеВознаграждение = ПлатежноеПоручение(ДоговорКРасторжению.НачислениеВознаграждения, "Вознаграждение");
									
								ДоговорКРасторжению.СтатусНачислениеВознаграждения = 
									?(ДоговорКРасторжению.НачислениеВознаграждения = Документы.НачислениеВознаграждения.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
									ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.НачислениеВознаграждения));
							КонецЕсли;
							
							Если ДоговорКРасторжению.СтатусНачислениеКомиссииДосрочныйВывод = Перечисления.СтатусыОбъектов.Новый Тогда
								ДоговорКРасторжению.ПлатежноеПоручениеКомиссииДосрочныйВывод = ПлатежноеПоручение(ДоговорКРасторжению.НачислениеКомиссииДосрочныйВывод, "Комиссия");
									
								ДоговорКРасторжению.СтатусНачислениеКомиссииДосрочныйВывод = 
									?(ДоговорКРасторжению.НачислениеКомиссииДосрочныйВывод = Документы.НачислениеВознаграждения.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
									ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.НачислениеКомиссииДосрочныйВывод));
							КонецЕсли;
							
							Если ДоговорКРасторжению.СтатусНачислениеВознагражденияРегулярное = Перечисления.СтатусыОбъектов.Новый Тогда
								ДоговорКРасторжению.ПлатежноеПоручениеВознаграждениеРегулярное = ПлатежноеПоручение(ДоговорКРасторжению.НачислениеВознагражденияРегулярное, "Вознаграждение");
									
								ДоговорКРасторжению.СтатусНачислениеВознагражденияРегулярное = 
									?(ДоговорКРасторжению.НачислениеВознагражденияРегулярное = Документы.НачислениеВознаграждения.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
									ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.НачислениеВознагражденияРегулярное));
							КонецЕсли;
						
						КонецЕсли;
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ДоговорКРасторжению.БумагиБезОборот 
			И ДоговорКРасторжению.СтатусПорученияНаБиржу = Перечисления.СтатусыОбъектов.Новый
			И ДоговорКРасторжению.СуммаВводаДС > 0 Тогда
			Если ДостаточноДенегНаСчету(ДоговорКРасторжению.ПоручениеПоДСНаВывод) Тогда
				ДоговорКРасторжению.ПлатежноеПоручениеНаВывод  = ПлатежноеПоручение(ДоговорКРасторжению.ПоручениеПоДСНаВывод, "Вывод");
			КонецЕсли;
			
			ДоговорКРасторжению.СтатусПорученияНаВывод = 
								?(ДоговорКРасторжению.ПоручениеПоДСНаВывод = Документы.Поручение.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
								ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ДоговорКРасторжению.ПоручениеПоДСНаВывод));
		КонецЕсли;
		
		Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
			МсДетализация.МсПрочаяЛогикаЦикла = МсДетализация.МсПрочаяЛогикаЦикла
				+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0Прочее - МсУдалИтер - МсЗакрИтер);
		КонецЕсли;
	КонецЦикла;
	
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НачислитьВознаграждение();
	Если ТипЗнч(МсДетализация) = Тип("Структура") Тогда
		МсДетализация.МсНачислитьВознаграждение = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
	КонецЕсли;
	
	// IMDEV-9104-P2 ++
	КэшПлатежныхПозицийПакет = Неопределено;
	ВалютаКэшаПлатежныхПозиций = Неопределено;
	// IMDEV-9104-P2 --

КонецПроцедуры

Процедура ПоручениеДСНаПеревод(ДоговорКРасторжению, СуммаПеревода)

	АналитическийСчетПриемник = АналитическийСчет(ДоговорКРасторжению.ДоговорДУ, ЕРС);
	ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод;
	СчетКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКРасторжению.АналитическийСчет, "МестоХранения");
	Роль = Перечисления.РолиДоговоровКонтрагента.Брокерский;
	ДоговорКонтрагента = ДоговорКонтрагента(ДоговорКРасторжению.ДоговорДУ, Роль);
	Комментарий = "";
	Параметры = Новый Структура;
	Параметры.Вставить("ДоговорДУ", ДоговорКРасторжению.ДоговорДУ);
	Параметры.Вставить("АналитическийСчетИсточник", ДоговорКРасторжению.АналитическийСчет);
	Параметры.Вставить("АналитическийСчетПриемник", АналитическийСчетПриемник);
	Параметры.Вставить("Контрагент", ДоговорКРасторжению.Контрагент);
	Параметры.Вставить("ДоговорКонтрагента", ДоговорКонтрагента);
	Параметры.Вставить("НомерРасторжения", "");
	Параметры.Вставить("ДатаРасторжения", Дата(1, 1, 1));
	Параметры.Вставить("ДатаПоручения", ДатаРасчета); 
	Параметры.Вставить("РасчетныйСчет", СчетКонтрагента);
	Параметры.Вставить("ВидОперации", Перечисления.ВидыОперацийПоручение.Перевод);
	Параметры.Вставить("СпособПодачи", Перечисления.СпособыПодачиПоручения.ЭлектронныйДокумент);
	Параметры.Вставить("СуммаДС", СуммаПеревода);
	Параметры.Вставить("Комментарий", "Перевод ДС при расторжении");
	
	ДоговорКРасторжению.ПоручениеПоДСНаПеревод = ПорученияДС(Параметры);
	ДоговорКРасторжению.СуммаПеревода = СуммаПеревода;

КонецПроцедуры

Процедура ПоручениеДСНаВводКомпенсации(ДоговорКРасторжению)

	Роль = Перечисления.РолиДоговоровКонтрагента.Брокерский;
	ДоговорКонтрагента = ДоговорКонтрагента(ДоговорКРасторжению.ДоговорДУ, Роль);
	
	Параметры = Новый Структура;
	Параметры.Вставить("ДоговорДУ" , ДоговорКРасторжению.ДоговорДУ);
	Параметры.Вставить("АналитическийСчетИсточник", Справочники.АналитическиеСчета.ПустаяСсылка());
	АналитическийСчет = АналитическийСчет(ДоговорКРасторжению.ДоговорДУ, ЕРС);
	Параметры.Вставить("АналитическийСчетПриемник", АналитическийСчет);
	Параметры.Вставить("Контрагент", Организация);
	Параметры.Вставить("ДоговорКонтрагента", ДоговорКонтрагента);
	Параметры.Вставить("НомерРасторжения", "");
	Параметры.Вставить("ДатаРасторжения", Дата(1, 1, 1));
	Параметры.Вставить("ДатаПоручения", ДатаРасчета);
	Параметры.Вставить("РасчетныйСчет", ЦентральныеСчетУК);
	Параметры.Вставить("ВидОперации", Перечисления.ВидыОперацийПоручение.ВводВДУ);
	Параметры.Вставить("СпособПодачи", Перечисления.СпособыПодачиПоручения.ЭлектронныйДокумент);
	Параметры.Вставить("СуммаДС", ДоговорКРасторжению.МатВыгода);
	Параметры.Вставить("Комментарий", "Ввод материальной выгоды");
	
	ДоговорКРасторжению.ПоручениеПоДСНаВвод = ПорученияДС(Параметры);

КонецПроцедуры

Процедура СформироватьИОтправитьПисьмо(ВидРассылки, ОписаниеОшибки) Экспорт
	
	Если ОтключитьВнешниеСистемы = Истина Тогда
		// Почта / FO не вызываются. ДанныеДляРассылки меряются отдельно в тесте.
		Возврат;
	КонецЕсли;
	
	ТаблицаСтрок = ДанныеДляРассылки(ВидРассылки);
	Если ВидРассылки = "Вывод" Тогда
		ТаблицаСтрокНалог = ДанныеДляРассылки("Налог");
		ТаблицаСтрокВознаграждение = ДанныеДляРассылки("Вознаграждение");
		Если ТаблицаСтрок.Количество() = 0 И ТаблицаСтрокНалог.Количество() = 0 Тогда
			ОписаниеОшибки = ОписаниеОшибки + " Рассылка - " + ВидРассылки + ": не найдены данные для рассылки";
			Возврат;
		КонецЕсли;
	Иначе
		Если ТаблицаСтрок.Количество() = 0 Тогда
			ОписаниеОшибки = ОписаниеОшибки + " Рассылка - " + ВидРассылки + ": не найдены данные для рассылки";
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность, Вложения");
	
	Макет = "ДоговорыКРасторжению";
	КолонкаИтог = "СуммаПоручения";
	ПараметрИтог = "СуммаИтого";
	Если ВидРассылки = "Перевод" Тогда
		Макет = "ДоговорыКРасторжениюПеревод";
		ТемаПисьма = "Поручения на перевод при расторжении";
		НомерРассылки = "289.1";
	ИначеЕсли ВидРассылки = "Вывод" Тогда
		ТемаПисьма = "Поручения на вывод при расторжении";
		НомерРассылки = "289.2";
	ИначеЕсли ВидРассылки = "Ввод" Тогда
		ТемаПисьма = "Поручения на компенсацию при расторжении";
		НомерРассылки = "289.3";
	ИначеЕсли ВидРассылки = "МатВыгода" Тогда
		Макет = "РасчетМатериальнойВыгоды";
		КолонкаИтог = "МатВыгода";
		ПараметрИтог = "МатВыгодаИтого";
		ТемаПисьма = "Уведомление финансы о расчете НДФЛ на компенсацию при расторжении";
		НомерРассылки = "289.4";
	ИначеЕсли ВидРассылки = "Доход" Тогда
		Макет = "РасчетДоход";
		КолонкаИтог = "Доход";
		ПараметрИтог = "ДоходИтого";
		ТемаПисьма = "Уведомление финансы о расчете НДФЛ на доход при расторжении";
		НомерРассылки = "289.5";
	КонецЕсли;
	
	ТелоПисьма = "";
	Вложения = Новый Структура;
	ФайлыКУдалению = Новый Массив;
	
	Если ТаблицаСтрок.Количество() > 0 Тогда
		ПутьКФайлуXLS = КаталогВременныхФайлов() + ТемаПисьма + ".xls";
		ТелоПисьма = ТелоПисьма(ТемаПисьма, ТаблицаСтрок, Макет, КолонкаИтог, ПараметрИтог, ПутьКФайлуXLS);
		
		Вложения.Вставить("Отчет", ПутьКФайлуXLS);
		ФайлыКУдалению.Добавить(ПутьКФайлуXLS);
	КонецЕсли;
	
	Если ВидРассылки = "Вывод" Тогда
		Если ТаблицаСтрокНалог.Количество() > 0 Тогда
			ТемаПисьмаНалог = "Поручения на оплату НДФЛ при расторжении";
			НалогПутьКФайлуXLS = КаталогВременныхФайлов() + ТемаПисьмаНалог + ".xls";
			ТелоПисьмаНалог = ТелоПисьма(ТемаПисьмаНалог, ТаблицаСтрокНалог, Макет, КолонкаИтог, ПараметрИтог, НалогПутьКФайлуXLS);
			
			ТелоПисьма = ТелоПисьма + Символы.ПС + ТелоПисьмаНалог;
			
			Вложения.Вставить("НДФЛ", НалогПутьКФайлуXLS);
			ФайлыКУдалению.Добавить(НалогПутьКФайлуXLS);
		КонецЕсли;
		
		Если ТаблицаСтрокВознаграждение.Количество() > 0 Тогда
			ТемаПисьмаВознаграждение = "Поручения на оплату вознаграждения при расторжении";
			ВознаграждениеПутьКФайлуXLS = КаталогВременныхФайлов() + ТемаПисьмаВознаграждение + ".xls";
			ТелоПисьмаВознаграждение = ТелоПисьма(ТемаПисьмаВознаграждение, ТаблицаСтрокВознаграждение, Макет, КолонкаИтог, ПараметрИтог, ВознаграждениеПутьКФайлуXLS);
			
			ТелоПисьма = ТелоПисьма + Символы.ПС + ТелоПисьмаВознаграждение;
			
			Вложения.Вставить("Вознаграждение", ВознаграждениеПутьКФайлуXLS);
			ФайлыКУдалению.Добавить(ВознаграждениеПутьКФайлуXLS);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыПисьма.Вложения = Вложения;
	
	Кому = Новый Массив;
	ОтборКонтактов = ОтборКонтактов(ВидРассылки);
	КонтактыРассылки = СписокРассылки.НайтиСтроки(ОтборКонтактов);
	Для каждого ТекЯщик из КонтактыРассылки Цикл
		Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
	КонецЦикла;
	
	ФлагРезультатаВТеме = "{OK} ";
	
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ФлагРезультатаВТеме + " Аванкор ДУ: "+ ТемаПисьма + ПропискаРассылки(НомерРассылки);
	ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
	ПараметрыПисьма.Тело = ТелоПисьма;
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
	
	РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
	
	Для каждого ФайлКУдалению Из ФайлыКУдалению Цикл
		УдалитьФайлы(ФайлКУдалению);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТестовыеРасторжения()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыДУ.Ссылка КАК ДоговорДУ,
		|	ДоговорыДУ.Код КАК НомерДоговорДУ,
		|	ДоговорыДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ КАК ДатаРасторжения,
		|	БанковскиеСчета.Банк.Код КАК Бик,
		|	БанковскиеСчета.НомерСчета КАК НомерСчета
		|ПОМЕСТИТЬ ВТ_ДоговорыДУКРасторжению
		|ИЗ
		|	Справочник.ДоговорДУ КАК ДоговорыДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПО ДоговорыДУ.Клиент = БанковскиеСчета.Владелец
		|			И (БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный))
		|ГДЕ
		|	ДоговорыДУ.Пул = &Пул
		|	И ДоговорыДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <> ДАТАВРЕМЯ(1, 1, 1)
		|	И ДоговорыДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <= &ДатаРасчета
		|	И (ДоговорыДУ.ДатаОкончания > &ДатаРасчета
		|			ИЛИ ДоговорыДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДоговорыДУКРасторжению.ДоговорДУ КАК ДоговорДУ,
		|	ВТ_ДоговорыДУКРасторжению.НомерДоговорДУ КАК НомерДУ,
		|	ВТ_ДоговорыДУКРасторжению.ДатаРасторжения КАК ДатаРасторжения,
		|	ВЫБОР
		|		КОГДА ПоручениеВывод.Ссылка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НетПоручениеВывод,
		|	ВТ_ДоговорыДУКРасторжению.Бик КАК Бик,
		|	ВТ_ДоговорыДУКРасторжению.НомерСчета КАК НомерСчета
		|ИЗ
		|	ВТ_ДоговорыДУКРасторжению КАК ВТ_ДоговорыДУКРасторжению
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Поручение КАК ПоручениеВывод
		|		ПО ВТ_ДоговорыДУКРасторжению.ДоговорДУ = ПоручениеВывод.ДоговорДУ
		|			И (ПоручениеВывод.Комментарий = ""Расторжение в период охлаждения"")";
	
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("Пул", Пул);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ДоговорыДУКрасторжению = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДоговорДУКрасторжению = Новый Структура("ДатаРасторжения, НомерДУ, НомерРасторжения, Бик, НомерСчета, РасторжениеВПериодОхлаждения, НетПоручениеВывод");
		ЗаполнитьЗначенияСвойств(ДоговорДУКрасторжению, ВыборкаДетальныеЗаписи);
		ДоговорыДУКрасторжению.Добавить(ДоговорДУКрасторжению);
	КонецЦикла;
	
	Возврат ДоговорыДУКрасторжению;

КонецФункции

Процедура МинимальнаяДатаВводаДС(ДоговорДУ)
	Если МинимальнаяДатаВводаДС = Неопределено Или ДоговорДУ.ДатаВводаСредствВДУ < МинимальнаяДатаВводаДС Тогда
		МинимальнаяДатаВводаДС = ДоговорДУ.ДатаВводаСредствВДУ;
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьПереводНаБиржу(ДоговорДУ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыДУ.Ссылка КАК ДоговорДУ,
		|	ЕСТЬNULL(Поручение.Ссылка, ""Нет"") КАК ПоручениеДС,
		|	ЕСТЬNULL(ПлатежноеПоручение.Ссылка, ""Нет"") КАК ПлатежноеПоручение
		|ИЗ
		|	Справочник.ДоговорДУ КАК ДоговорыДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Поручение КАК Поручение
		|		ПО (Поручение.ДоговорДУ = ДоговорыДУ.Ссылка)
		|			И (Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.Перевод))
		|			И (Поручение.Комментарий = ""13W6XW, субпозиция 13W6XW/"" + ДоговорыДУ.Код)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
		|		ПО (Поручение.Ссылка = ПлатежноеПоручение.ДокументОснование)
		|ГДЕ
		|	ДоговорыДУ.Ссылка = &ДоговорДУ";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.ПоручениеДС <> "Нет" Тогда
			Попытка
				ДокПоручениеДС = ВыборкаДетальныеЗаписи.ПоручениеДС.ПолучитьОбъект();
				ДокПоручениеДС.Удалить();
			Исключение
				СброситьИспорченнуюТранзакциюОтката("УдалитьПереводНаБиржу/Поручение: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		Если ВыборкаДетальныеЗаписи.ПлатежноеПоручение <> "Нет" Тогда
			Попытка
				ДокПлатежноеПоручение = ВыборкаДетальныеЗаписи.ПлатежноеПоручение.ПолучитьОбъект();
				ДокПлатежноеПоручение.Удалить();
			Исключение
				СброситьИспорченнуюТранзакциюОтката("УдалитьПереводНаБиржу/ПП: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ДанныеПоРасторжению()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорДУ.Ссылка КАК ДоговорДУ,
		|	ДоговорДУ.Код КАК НомерДоговорДУ,
		|	ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ КАК ДатаРасторжения,
		|	ДОБАВИТЬКДАТЕ(ДоговорДУ.ДатаВводаСредствВДУ, ДЕНЬ, 14) >= ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ КАК РасторжениеВПериодОхлаждения
		|ПОМЕСТИТЬ ВТ_ДоговорыДУКРасторжению
		|ИЗ
		|	Справочник.ДоговорДУ КАК ДоговорДУ
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ТестовыйРежим
		|					И &ВыборДоговораДУ
		|				ТОГДА ДоговорДУ.Ссылка = &ДоговорДУ
		|			ИНАЧЕ ДоговорДУ.Пул = &Пул
		|		КОНЕЦ
		|	И ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <> ДАТАВРЕМЯ(1, 1, 1)
		|	И ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <= &ДатаРасчета
		|	И (ДоговорДУ.ДатаОкончания > &ДатаРасчета
		|			ИЛИ ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорыДУ.ДоговорДУ КАК ДоговорДУ,
		|	ДоговорыДУ.НомерДоговорДУ КАК НомерДоговорДУ,
		|	ДоговорыДУ.ДатаРасторжения КАК ДатаРасторжения,
		|	ДоговорыДУ.РасторжениеВПериодОхлаждения КАК РасторжениеВПериодОхлаждения,
		|	ТорговыеКоды.АналитическийСчетДС КАК АналитическийСчетДС
		|ПОМЕСТИТЬ ВТ_ДоговорыДУ
		|ИЗ
		|	ВТ_ДоговорыДУКРасторжению КАК ДоговорыДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТорговыеКоды КАК ТорговыеКоды
		|		ПО ДоговорыДУ.ДоговорДУ = ТорговыеКоды.ДоговорДУ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВводыВыводыДУ.ДоговорДУ КАК ДоговорДУ,
		|	СУММА(ВводыВыводыДУ.Сумма) КАК Сумма
		|ПОМЕСТИТЬ ВТ_ВводДоговорДУ
		|ИЗ
		|	РегистрНакопления.ВводыВыводыДУ КАК ВводыВыводыДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДоговорыДУ КАК ВТ_ДоговорыДУ
		|		ПО ВводыВыводыДУ.ДоговорДУ = ВТ_ДоговорыДУ.ДоговорДУ
		|ГДЕ
		|	ВводыВыводыДУ.Сумма > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ВводыВыводыДУ.ДоговорДУ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	т.ДоговорДУ КАК ДоговорДУ,
		|	СУММА(т.СуммаНаРС) КАК СуммаНаРС,
		|	СУММА(т.СуммаНаБрС) КАК СуммаНаБрС,
		|	СУММА(т.СуммаРасчетыПоСделкам) КАК СуммаРасчетыПоСделкам,
		|	СУММА(т.СуммаРасчетыПоКупону) КАК СуммаРасчетыПоКупону,
		|	СУММА(т.СуммаРасчетыПоПогашениюЦБ) КАК СуммаРасчетыПоПогашениюЦБ
		|ПОМЕСТИТЬ ВТ_ОстатокДС
		|ИЗ
		|	(ВЫБРАТЬ
		|		т.ДоговорДУ КАК ДоговорДУ,
		|		ВЫБОР
		|			КОГДА т.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета)
		|				ТОГДА т.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК СуммаНаРС,
		|		ВЫБОР
		|			КОГДА т.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыБрокераПоСделкам55)
		|				ТОГДА т.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК СуммаНаБрС,
		|		ВЫБОР
		|			КОГДА т.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыЦБПродажа)
		|				ТОГДА т.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК СуммаРасчетыПоСделкам,
		|		ВЫБОР
		|			КОГДА т.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоОблигациям)
		|				ТОГДА т.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК СуммаРасчетыПоКупону,
		|		ВЫБОР
		|			КОГДА т.Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоОблигациям_ПогашениеТела)
		|				ТОГДА т.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК СуммаРасчетыПоПогашениюЦБ
		|	ИЗ
