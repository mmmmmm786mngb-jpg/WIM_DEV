Функция БанковскийСчетКлиента(ДоговорДУ, Контрагент, БИК, НомерСчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Владелец = &Контрагент
		|	И БанковскиеСчета.НомерСчета = &НомерСчета";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		БанковскийСчет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	КонецЕсли;
	
	БанковскийСчет.Наименование = "Счет " + НомерСчета;
	БанковскийСчет.Банк = Справочники.Банки.СсылкаНаБанк(БИК);
	БанковскийСчет.ВалютаДенежныхСредств = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	БанковскийСчет.НомерСчета = НомерСчета;
	БанковскийСчет.ВидСчета = Перечисления.ВидБанковскогоСчета.Расчетный;
	БанковскийСчет.ТипСчета = Перечисления.ТипРасчетногоСчета.Индивидуальный;
	БанковскийСчет.Владелец = Контрагент;
	БанковскийСчет.Комментарий = "Указан при расторжении";
	
	Попытка 
		БанковскийСчет.Записать();
		БанковскийСчетВозврат = БанковскийСчет.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Ошибка при сознании расчетного счета. %1'"), ТекстОшибки);
		ЗаписьЖурналаРегистрации("Розничное ДУ: Расторжение в период охлаждения .", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		СброситьИспорченнуюТранзакциюОтката("БанковскийСчет: " + ТекстОшибки, Ложь);
		БанковскийСчетВозврат = Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецПопытки;
	
	Возврат БанковскийСчетВозврат;

КонецФункции

Процедура УчестьНДФЛПриРасторжении(ДанныеУчетНДФЛ)

	Если КонтурПрерванИзЗаСбросаТранзакции = Истина Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаПоручения = ДанныеУчетНДФЛ.ПоручениеПоДСНаВывод;
	Если Не ЗначениеЗаполнено(СсылкаПоручения) Тогда
		Возврат;
	КонецЕсли;
	
	// После сброса транзакции отката ПолучитьОбъект может вернуть Неопределено
	ПоручениеРасторжение = Неопределено;
	Попытка
		Если ТипЗнч(СсылкаПоручения) = Тип("ДокументОбъект.Поручение") Тогда
			ПоручениеРасторжение = СсылкаПоручения;
		Иначе
			ПоручениеРасторжение = СсылкаПоручения.ПолучитьОбъект();
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.СравнениеПолныйP2",
			УровеньЖурналаРегистрации.Предупреждение,,,
			"УчестьНДФЛ: не удалось получить объект поручения: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если ПоручениеРасторжение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоручениеРасторжение.СуммаДС = ДанныеУчетНДФЛ.СуммаКВыводу;
	
	Попытка
		ПоручениеРасторжение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Ошибка записи суммы вывода ДС. %1'"), ТекстОшибки);
		ЗаписьЖурналаРегистрации("Розничное ДУ: Расторжение в период охлаждения .", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		СброситьИспорченнуюТранзакциюОтката("УчестьНДФЛПриРасторжении: " + ТекстОшибки);
	КонецПопытки;

КонецПроцедуры

Функция КомиссияСтороннийБанк(ДанныеУчетНДФЛ)

	КомиссияПрименяется = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(Поручение.СчетКонтрагента.Банк) КАК Банк
		|ИЗ
		|	Документ.Поручение КАК Поручение
		|ГДЕ
		|	Поручение.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеУчетНДФЛ.ПоручениеПоДСНаВывод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		БанкНаим = ВРег(ВыборкаДетальныеЗаписи.Банк);
		КомиссияПрименяется = (СтрНайти(БанкНаим, "ВТБ") = 0 И СтрНайти(БанкНаим, "VTB") = 0);
	КонецЕсли;
	
	Если КомиссияПрименяется Тогда
		Возврат КомиссияВыводСтороннийБанк;
	Иначе
		Возврат 0;
	КонецЕсли;
	
