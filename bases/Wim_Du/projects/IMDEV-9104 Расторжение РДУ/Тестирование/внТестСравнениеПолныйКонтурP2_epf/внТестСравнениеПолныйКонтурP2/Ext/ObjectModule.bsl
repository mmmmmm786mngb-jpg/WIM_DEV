		|	ДатаРасторжения";
	
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("ДатаМинВводДС", МинимальнаяДатаВводаДС);
	Запрос.УстановитьПараметр("Пул", Пул);
	Запрос.УстановитьПараметр("ТестовыйРежим", ТестовыйРежим);
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ_тест);
	Запрос.УстановитьПараметр("ВыборДоговораДУ", ЗначениеЗаполнено(ДоговорДУ_тест));
	Запрос.УстановитьПараметр("ПризнакПереводаДС", ПризнакПереводаДС);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;

КонецФункции

Функция ЗакрытьДОУведомлениеРасторжения(Сервис, НомерДУ, ДатаОкончания)

	Если ОтключитьВнешниеСистемы = Истина Или Сервис = Неопределено Тогда
		Возврат "SKIP_EXTERNAL";
	КонецЕсли;
	
	Результат = Сервис.SetRetailAgreementClosed(НомерДУ, ДатаОкончания);
	СтруктураJSON = ПолучитьСтруктураJSON(Результат);
	
	Возврат СтруктураJSON.Статус;

КонецФункции

Функция ПолучитьСервис(АдресВеб, Логин, Пароль)
	
	Если ОтключитьВнешниеСистемы = Истина Тогда
		ВызватьИсключение "IMDEV-9104: вызов внешнего WS запрещен (ОтключитьВнешниеСистемы)";
	КонецЕсли;
	
	Попытка
	
		Определения = Новый WSОпределения(АдресВеб, Логин, Пароль,, 600);
		URIПространстваИмен = Определения.Сервисы[0].URIПространстваИмен;
		ИмяСервиса = Определения.Сервисы[0].Имя;
		ТочкаПодключения = Определения.Сервисы[0].ТочкиПодключения[1].Имя;
		Прокси = Новый WSПрокси(Определения, URIПространстваИмен, ИмяСервиса, ТочкаПодключения, 600);
		Прокси.Пользователь = Логин;
		Прокси.Пароль = Пароль;
	
	Исключение
		
		
	КонецПопытки;

	Возврат Прокси;

КонецФункции

Функция  ПолучитьСтруктураJSON(СтрокаJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Значение = ПрочитатьJSON(ЧтениеJSON,,, ФорматДатыJSON.ISO);
	ЧтениеJSON.Закрыть();
	
	Возврат Значение;

КонецФункции

Функция ДоговорПоНомеру(НомерДУ)
	
	ДоговорДУ = Справочники.ДоговорДУ.НайтиПоКоду(НомерДУ);
	ДоговорДУ = ?(ДоговорДУ = Неопределено, Справочники.ДоговорДУ.ПустаяСсылка(), ДоговорДУ);
	Возврат ДоговорДУ;

КонецФункции

Процедура УстановитьДатуРасторжения(ДоговорДУ, ДатаРасторжения)

	// Без лишней записи, если дата уже стоит (меньше управляемых блокировок)
	Если ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДатаРасторжения Тогда
		Возврат;
	КонецЕсли;
	
	МаксПопыток = 3;
	ТекстОшибкиЗаписи = "";
	Для НомерПопытки = 1 По МаксПопыток Цикл
		
		Попытка
			ДоговорДУОбъект = ДоговорДУ.ПолучитьОбъект();
			ДоговорДУОбъект.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДатаРасторжения;
			ДоговорДУОбъект.Записать();
			Возврат;
		Исключение
			ТекстОшибкиЗаписи = ОписаниеОшибки();
			Если ОткатыватьТранзакцию = Истина Тогда
				// После ошибки Записать транзакция "испорчена" - без сброса дальше любой Записать падает
				// ПрерыватьКонтур=Ложь: retry в РЗ, иначе весь Обработка будет пропущен
				СброситьИспорченнуюТранзакциюОтката(
					"УстановитьДатуРасторжения/" + Формат(НомерПопытки, "ЧГ=0") + ": " + ТекстОшибкиЗаписи,
					Ложь);
			КонецЕсли;
			Если НомерПопытки >= МаксПопыток Тогда
				Прервать;
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
	ВызватьИсключение "УстановитьДатуРасторжения: " + ТекстОшибкиЗаписи;

КонецПроцедуры

Функция СтатусыДокументов(ВыборкаДетальныеЗаписи)

	СтатусыДокументов = Новый Массив;
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусНачислениеНДФЛ);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусПорученияНаВывод);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусПорученияПеревод);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусПорученияНаБиржу);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусПорученияНаВвод);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусНачислениеВознаграждения);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусНачислениеКомиссииДосрочныйВывод);
	СтатусыДокументов.Добавить(ВыборкаДетальныеЗаписи.СтатусНачислениеВознагражденияРегулярное);
	
	Возврат СтатусыДокументов;

КонецФункции

Функция ЗакрытьДоговор(ДоговорДУ, СервисДО, СтатусыДокументов, СуммаСЧА, НомерДУ)

	ДоговорДУЗакрыт = СуммаСЧА = 0;
	Для каждого СтатусДокумента Из СтатусыДокументов Цикл
		
		ДоговорДУЗакрыт = СтатусДокумента = Перечисления.СтатусыОбъектов.Исполнено 
						Или СтатусДокумента = Перечисления.СтатусыОбъектов.ПустаяСсылка();
		
		Если ДоговорДУЗакрыт = Ложь Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДоговорДУЗакрыт Тогда
		ДатаОкончания = ?(ДатаЗакрытияПредыдущийРабочийДень, БлижайшийРабочийДень(ДатаРасчета, Истина), ДатаРасчета);
		УстановитьДатуЗакрытия(ДоговорДУ, ДатаОкончания);
		Если СервисДО <> Неопределено Тогда
			ЗакрытьДОУведомлениеРасторжения(СервисДО, НомерДУ, ДатаОкончания);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДоговорДУЗакрыт;

КонецФункции

Процедура УстановитьДатуЗакрытия(ДоговорДУ, ДатаОкончания)

	МаксПопыток = 3;
	ТекстОшибкиЗаписи = "";
	Для НомерПопытки = 1 По МаксПопыток Цикл
		Попытка
			ДоговорДУОбъект = ДоговорДУ.ПолучитьОбъект();
			ДоговорДУОбъект.ДатаОкончания = ДатаОкончания;
			ДоговорДУОбъект.Записать();
			Возврат;
		Исключение
			ТекстОшибкиЗаписи = ОписаниеОшибки();
			Если ОткатыватьТранзакцию = Истина Тогда
				СброситьИспорченнуюТранзакциюОтката(
					"УстановитьДатуЗакрытия/" + Формат(НомерПопытки, "ЧГ=0") + ": " + ТекстОшибкиЗаписи,
					Истина);
			КонецЕсли;
			Если НомерПопытки >= МаксПопыток Тогда
				Прервать;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	
	ВызватьИсключение "УстановитьДатуЗакрытия: " + ТекстОшибкиЗаписи;

КонецПроцедуры

Функция ПорученияДС(Данные)
	
	ПоручениеПоДС = ПоручениеПоДС(Данные.ДоговорДУ, Данные.Контрагент, Данные.ВидОперации, Данные.Комментарий);
	
	СтатусПоручениеПоДС = ?(ПоручениеПоДС.Ссылка = Документы.Поручение.ПустаяСсылка(), Перечисления.СтатусыОбъектов.ПустаяСсылка(),
				ОбщегоНазначенияДУ.ПолучитьАктуальныйСтатусОбъекта(ПоручениеПоДС.Ссылка));
	
	Если СтатусПоручениеПоДС = Перечисления.СтатусыОбъектов.Исполнено Тогда
		// Всегда ссылка: иначе УчестьНДФЛ/.ПолучитьОбъект ломается на объекте
		Возврат ПоручениеПоДС.Ссылка;
	КонецЕсли;
	
	ВалютаВыплаты = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	
	ПоручениеПоДС.Дата = БлижайшийРабочийДень(Данные.ДатаПоручения) + 32400;
	ПоручениеПоДС.ВходящийНомер = Данные.НомерРасторжения;
	ПоручениеПоДС.ВходящаяДата = Данные.ДатаРасторжения;
	ПоручениеПоДС.Комментарий = Данные.Комментарий;
	ПоручениеПоДС.ДоговорДУ = Данные.ДоговорДУ;
	
	ПоручениеПоДС.АналитическийСчетИсточник = Данные.АналитическийСчетИсточник;
	ПоручениеПоДС.АналитическийСчетПриемник = Данные.АналитическийСчетПриемник;
	
	ПоручениеПоДС.ВидОперации = Данные.ВидОперации;
	ПоручениеПоДС.СпособПодачиПоручения = Данные.СпособПодачи;
	ПоручениеПоДС.Контрагент = Данные.Контрагент;
	ПоручениеПоДС.СчетКонтрагента = Данные.РасчетныйСчет;
	ПоручениеПоДС.ДоговорКонтрагента = Данные.ДоговорКонтрагента;
	ПоручениеПоДС.СуммаДС = Данные.СуммаДС;
	ПоручениеПоДС.ВалютаДокумента = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	ПоручениеПоДС.КурсВзаиморасчетов = 1;
	ПоручениеПоДС.КратностьВзаиморасчетов = 1;
	ПоручениеПоДС.Ответственный = ОбщегоНазначения.ТекущийПользователь();
	ПоручениеПоДС.ДокументЗарегистрировал = "Не применимо";
	
	Попытка 
		ПоручениеПоДС.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		ПоручениеВозврат = ПоручениеПоДС.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Сообщить("Расторжение в период охлаждения. Ошибка при записи Поручения по Д/С. " + ТекстОшибки);
		СброситьИспорченнуюТранзакциюОтката("ПоручениеПоДС: " + ТекстОшибки, Ложь);
		ПоручениеВозврат = Документы.Поручение.ПустаяСсылка();
	КонецПопытки;
	
	Возврат ПоручениеВозврат;
	
КонецФункции

Функция ПлатежноеПоручение(ПоручениеПоДС, ВидОплаты)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлатежноеПоручение.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
		|ГДЕ
		|	ПлатежноеПоручение.ДокументОснование = &ПоручениеПоДС
		|	И НЕ ПлатежноеПоручение.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПоручениеПоДС", ПоручениеПоДС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ПлатежноПоручение = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	Иначе
		ПлатежноПоручение = Документы.ПлатежноеПоручение.СоздатьДокумент();
	КонецЕсли;
	
	ПлатежноПоручение.Дата = БлижайшийРабочийДень(ДатаРасчета) + 32400;
	ПлатежноПоручение.Заполнить(ПоручениеПоДС);

	Если Не ЗначениеЗаполнено(ПлатежноПоручение.Ссылка)
		И ЗначениеЗаполнено(ПлатежноПоручение.ДокументОснование)
		И (ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеЗадолженности") 
			ИЛИ ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеВознаграждения")) Тогда
		
		СуммаПП = ПлатежноПоручение.СуммаДокумента;
		СтруктураПлатежнойПозиции = БанковскийСчетПоПлатежнойПозиции(ПлатежноПоручение.ДоговорДУ, ПлатежноПоручение.ВалютаДокумента, СуммаПП);
		
		Если СтруктураПлатежнойПозиции.Свойство("БанковскийСчет") Тогда
			ПлатежноПоручение.ТекстПлательщика = СтруктураПлатежнойПозиции.ТекстКорреспондента;
			ПлатежноПоручение.СчетДоговораДУ = СтруктураПлатежнойПозиции.БанковскийСчет;
			Если ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеВознаграждения") Тогда
				ПлатежноПоручение.КПППлательщика = ПлатежноПоручение.Контрагент.КПП;
			ИначеЕсли ТипЗнч(ПлатежноПоручение.ДокументОснование)= Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
				ПлатежноПоручение.КПППлательщика = "0";
			КонецЕсли;
			ДокОснование = ПлатежноПоручение.ДокументОснование.Метаданные().Имя;
			ЗаполнитьНазначениеПлатежаПоПодобранномуБанковскомуСчету(ПлатежноПоручение, ДокОснование, ВидОплаты);
		КонецЕсли;
	КонецЕсли;
		
	Попытка 
		ПлатежноПоручение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		ПоручениеВозврат = ПлатежноПоручение.Ссылка;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Сообщить("Расторжение в период охлаждения. Ошибка при записи Платежного Поручения. " + ТекстОшибки);
		СброситьИспорченнуюТранзакциюОтката("ПлатежноеПоручение: " + ТекстОшибки);
		ПоручениеВозврат = Документы.ПлатежноеПоручение.ПустаяСсылка();
	КонецПопытки;
	
	Возврат ПоручениеВозврат;

КонецФункции

Функция ДостаточноДенегНаСчету(ПоручениеПоДСНаВывод, ОписаниеОшибки = "")

	АналитическийСчетИсточник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоручениеПоДСНаВывод, "АналитическийСчетИсточник");
	МестоХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АналитическийСчетИсточник, "МестоХранения");
	СуммаПоручения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоручениеПоДСНаВывод, "СуммаДС");
	ДоговорДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоручениеПоДСНаВывод, "ДоговорДУ");
	
	НаДату = КонецДня(БлижайшийРабочийДень(ДатаРасчета));
	СтруктураПлатежнойПозиции = Документы.ПлатежноеПоручение.ПервыйЭтапПроверкиДостаточностиДС(МестоХранения, ДоговорДУ, ПоручениеПоДСНаВывод, НаДату);
	
	ПлатежнаяПозиция = СтруктураПлатежнойПозиции.ПлатежнаяПозиция;
	ПлатежнаяПозиция = ПлатежнаяПозиция - СуммаПоручения;
	
	Если СуммаПоручения = 0 Тогда
		ОписаниеОшибки = ОписаниеОшибки + "  " +" Сумма поручения по ДС на дату " + Формат(НаДату, "ДЛФ=DT") + ": 0";
		Возврат Ложь;
	ИначеЕсли ПлатежнаяПозиция < 0 Тогда
		ОписаниеОшибки = ОписаниеОшибки + "  " +" Недостаточно денег на счету на дату " + Формат(НаДату, "ДЛФ=DT") + ": Сумма поручения - " 
						+ СуммаПоручения + "; Платежная позиция - " + СтруктураПлатежнойПозиции.ПлатежнаяПозиция;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция ОстатокНаСчету(ДоговорДУ, МестоХранения, НаДату)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	т.СуммаОстаток КАК ОстатокНаСчету
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВУДС),
		|			,
		|			ДоговорДУ = &ДоговорДУ
		|				И Субконто1 = &МестоХранения) КАК т";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	Запрос.УстановитьПараметр("МестоХранения", МестоХранения);
	Запрос.УстановитьПараметр("Период", НаДату);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ОстатокНаСчету;
	КонецЕсли;
	
	Возврат 0;

КонецФункции

Функция БанковскийСчетПоПлатежнойПозиции(ДоговорДУ, Валюта, Сумма)

	// IMDEV-9104-P2 ++
