Функция ВремяТекущее()

	ТекВремя = ТекущаяДатаСеанса();
	Часы = Час(ТекВремя);
	Часы = ?(Часы > 20, 20, Часы);
	Минуты = ?(Часы = 20, 0, Минута(ТекВремя));
	Секунды = ?(Часы = 20, 0, Секунда(ТекВремя));
	
	Возврат Часы * 3600 + Минуты * 60 + Секунды

