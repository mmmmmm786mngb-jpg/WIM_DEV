			ПоручениеДляРассылки.ПлатежноеПоручение = СтрокаДоговора.ПлатежноеПоручениеНаВывод;
			ПоручениеДляРассылки.ДатаРасторжения = СтрокаДоговора.ДатаРасторжения;
			ПоручениеДляРассылки.СуммаПоручения = СтрокаДоговора.СуммаКВыводу;
