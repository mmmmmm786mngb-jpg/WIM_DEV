		КонецЦикла;
		
		Для каждого СтрокаДоговора Из ДоговорыКРасторжениюМатВыгода.НайтиСтроки(Отбор) Цикл
			Если Не СтрокаДоговора.ПереводДСВыполнен Тогда
				ПоручениеДляРассылки = ДанныеДляРассылки.Добавить();
				ПоручениеДляРассылки.ДоговорДУ = СтрокаДоговора.ДоговорДУ;
				ПоручениеДляРассылки.ПоручениеПоДС = СтрокаДоговора.ПоручениеПоДСНаПеревод;
				ПоручениеДляРассылки.ПлатежноеПоручение = СтрокаДоговора.ПлатежноеПоручениеНаПеревод;
				ПоручениеДляРассылки.ДатаРасторжения = СтрокаДоговора.ДатаРасторжения;
				ПоручениеДляРассылки.СуммаПоручения = СтрокаДоговора.СуммаПеревода;
			
				НовыйДУ = ДУ.Добавить();
				НовыйДУ.ДоговорДУ = СтрокаДоговора.ДоговорДУ;
				НовыйДУ.ПоручениеПоДС = СтрокаДоговора.ПоручениеПоДСНаПеревод;
				НовыйДУ.СуммаПеревода = СтрокаДоговора.СуммаПеревода;
				
				СтрокаДоговора.ПереводДСВыполнен = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого СтрокаДоговора Из ДоговорыКРасторжениюПослеОхлаждения.НайтиСтроки(Отбор) Цикл
			Если Не СтрокаДоговора.ПереводДСВыполнен Тогда
