				ПоручениеДляРассылки.ПлатежноеПоручение = СтрокаДоговора.ПлатежноеПоручениеНаПеревод;
				ПоручениеДляРассылки.ДатаРасторжения = СтрокаДоговора.ДатаРасторжения;
				ПоручениеДляРассылки.СуммаПоручения = СтрокаДоговора.СуммаПеревода;
			
