Функция ДанныеДляРассылки(ВидРассылки)

	ДанныеДляРассылки = Новый ТаблицаЗначений;
	ДанныеДляРассылки.Колонки.Добавить("ДоговорДУ");
	ДанныеДляРассылки.Колонки.Добавить("ПоручениеПоДС");
	ДанныеДляРассылки.Колонки.Добавить("ПлатежноеПоручение");
	ДанныеДляРассылки.Колонки.Добавить("ДатаРасторжения");
	ДанныеДляРассылки.Колонки.Добавить("СуммаПоручения");
	ДанныеДляРассылки.Колонки.Добавить("МатВыгода");
	ДанныеДляРассылки.Колонки.Добавить("Доход");
	ДанныеДляРассылки.Колонки.Добавить("НомерДУ");
	
	Если СтрНайти(ВидРассылки, "Перевод") > 0 Тогда
	
		ДУ = Новый ТаблицаЗначений;
		ДУ.Колонки.Добавить("ДоговорДУ");
		ДУ.Колонки.Добавить("ПоручениеПоДС");
		ДУ.Колонки.Добавить("СуммаПеревода");
	
