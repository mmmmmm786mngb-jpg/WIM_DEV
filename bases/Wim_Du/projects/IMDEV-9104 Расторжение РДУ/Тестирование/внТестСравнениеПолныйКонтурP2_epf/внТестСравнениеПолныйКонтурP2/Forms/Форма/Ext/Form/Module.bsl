#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Заголовок = "IMDEV-9104 сравнение полный контур P2 | v. "
		+ ТекОбъект.СведенияОВнешнейОбработке().Версия;
	
	Если ТекОбъект.КоличествоДоговоров <= 0 Тогда
		ТекОбъект.КоличествоДоговоров = 20;
	КонецЕсли;
	
	ТекОбъект.ОткатыватьТранзакцию = Истина;
	ТекОбъект.ТестовыйРежим = Истина;
	
	Если Не ЗначениеЗаполнено(ТекОбъект.Пул) Тогда
		ТекОбъект.Пул = ПолучитьПулРозничноеДУНаСервере();
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьТест(Команда)
	
	ЗапуститьТестНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗапуститьТестНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	
	Если ТекОбъект.КоличествоДоговоров <= 0 Тогда
		ТекОбъект.КоличествоДоговоров = 20;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекОбъект.Пул) Тогда
		ТекОбъект.Пул = ПолучитьПулРозничноеДУНаСервере();
	КонецЕсли;
	
	Результат = ТекОбъект.СформироватьОтчетЗамеровТеста();
	
	РезультатЗамеров = Новый ТабличныйДокумент;
	Если Результат.ТабДокумент <> Неопределено Тогда
		РезультатЗамеров.Вывести(Результат.ТабДокумент);
	КонецЕсли;
	РезультатЗамеров.Защита = Ложь;
	РезультатЗамеров.ТолькоПросмотр = Ложь;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
	Если Результат.Успех Тогда
		Сообщить("Сравнение P2 завершено. Совпадают="
			+ ?(Результат.РезультатыСовпадают, "ДА", "НЕТ")
			+ "; было мс=" + Формат(Результат.МсПоСтарому, "ЧГ=0")
			+ "; стало мс=" + Формат(Результат.МсПоНовому, "ЧГ=0")
			+ "; N=" + Формат(Результат.КоличествоДоговоров, "ЧГ=0"),
			СтатусСообщения.Информация);
	Иначе
		ТекстОшибки = Результат.ТекстОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Сравнение завершено с ошибками. См. табличный документ и журнал IMDEV-9104.СравнениеПолныйP2";
		КонецЕсли;
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьПулРозничноеДУНаСервере()
	
	НайденныйПул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	Если ЗначениеЗаполнено(НайденныйПул) Тогда
		Возврат НайденныйПул;
	КонецЕсли;
	
	ПулПоUID = Справочники.Пул.ПолучитьСсылку(Новый УникальныйИдентификатор("686be652-ff24-11ef-b2be-0050569f27c0"));
	Если ОбщегоНазначения.СсылкаСуществует(ПулПоUID) Тогда
		Возврат ПулПоUID;
	КонецЕсли;
	
	Возврат Справочники.Пул.ПустаяСсылка();
	
КонецФункции

#КонецОбласти
