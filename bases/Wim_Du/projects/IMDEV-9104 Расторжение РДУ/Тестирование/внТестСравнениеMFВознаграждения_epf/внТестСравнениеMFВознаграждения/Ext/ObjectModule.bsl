// Описание: Сведения для регистрации дополнительной обработки в БСП
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование",
		"IMDEV-9104-3 сравнение MF вознаграждения (было/стало)");
	ПараметрыРегистрации.Вставить("Версия", "1.1");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"P3: РазмерВознагражденияПриРасторжении. Было = MAX-запрос + сумма, "
		+ "стало = только сумма. Регресс Договор/Сумма + скорость. Без удаления обязательств.");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Сравнить MF вознаграждение (было/стало)";
	НоваяКоманда.Идентификатор = "СравнитьMFВознаграждение";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Описание: Сравнивает старую и новую РазмерВознагражденияПриРасторжении по пулу
// Формирует табличный документ и HTML-отчет (регресс сумм + скорость)
//
// Возвращаемое значение:
// Структура - Успех, ТабДокумент, ПутьHTML, метрики сравнения
//
Функция СформироватьОтчетЗамеровТеста() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ТабДокумент", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ПутьHTML", "");
	Результат.Вставить("КоличествоДоговоров", 0);
	Результат.Вставить("Различий", 0);
	Результат.Вставить("РезультатыСовпадают", Ложь);
	Результат.Вставить("МсПоСтарому", 0);
	Результат.Вставить("МсПоНовому", 0);
	
	Попытка
		ВыполнитьСравнение(Результат);
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Отказ = Истина;
		Результат.Успех = Ложь;
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.СравнениеMF",
			УровеньЖурналаРегистрации.Ошибка,,,
			Результат.ТекстОшибки);
		Результат.ПутьHTML = ЗаписатьHTMLОтчет(Результат);
		Результат.ТабДокумент = ПостроитьТабличныйДокументСравнения(Результат);
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = (Результат.Отказ <> Истина);
	Результат.ПутьHTML = ЗаписатьHTMLОтчет(Результат);
	Результат.ТабДокумент = ПостроитьТабличныйДокументСравнения(Результат);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьСравнение(Результат)
	
	Если Не ЗначениеЗаполнено(Пул) Тогда
		Пул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Пул) Тогда
		ВызватьИсключение "Не найден пул ""Розничное ДУ""";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаРасчета) Тогда
		ДатаРасчета = КонецДня(ТекущаяДатаСеанса());
	Иначе
		ДатаРасчета = КонецДня(ДатаРасчета);
	КонецЕсли;
	
	СписокДоговоров = СписокДоговоровПула();
	Результат.КоличествоДоговоров = СписокДоговоров.Количество();
	
	ТаблицаСравнения = НовыйТаблицаСравнения();
	
	// --- ПО-СТАРОМУ: MAX-запрос + сумма (как до IMDEV-9104-3) ---
	НачалоСтарый = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		СуммаСтарая = РазмерВознагражденияПриРасторженииСтарый(ДоговорДУ, ДатаРасчета);
		СтрокаТЗ = ТаблицаСравнения.Добавить();
		СтрокаТЗ.ДоговорДУ = ДоговорДУ;
		СтрокаТЗ.Код = Строка(ДоговорДУ);
		СтрокаТЗ.СуммаСтарая = СуммаСтарая;
	КонецЦикла;
	Результат.МсПоСтарому = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСтарый;
	
	// --- ПО-НОВОМУ: только сумма (IMDEV-9104-3) ---
	НачалоНовый = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Индекс = 0;
	Для Каждого ДоговорДУ Из СписокДоговоров Цикл
		СуммаНовая = РазмерВознагражденияПриРасторженииНовый(ДоговорДУ, ДатаРасчета);
		СтрокаТЗ = ТаблицаСравнения[Индекс];
		СтрокаТЗ.СуммаНовая = СуммаНовая;
		СтрокаТЗ.Совпадает = (СтрокаТЗ.СуммаСтарая = СуммаНовая);
		Если Не СтрокаТЗ.Совпадает Тогда
			Результат.Различий = Результат.Различий + 1;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Результат.МсПоНовому = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоНовый;
	
	Результат.РезультатыСовпадают = (Результат.Различий = 0);
	
КонецПроцедуры

Функция СписокДоговоровПула()
	
	Запрос = Новый Запрос;
	Если КоличествоДоговоров > 0 Тогда
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ " + Формат(КоличествоДоговоров, "ЧГ=0") + "
			|	ДоговорДУ.Ссылка КАК ДоговорДУ
			|ИЗ
			|	Справочник.ДоговорДУ КАК ДоговорДУ
			|ГДЕ
			|	ДоговорДУ.Пул = &Пул
			|	И НЕ ДоговорДУ.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДоговорДУ.Код";
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ДоговорДУ.Ссылка КАК ДоговорДУ
			|ИЗ
			|	Справочник.ДоговорДУ КАК ДоговорДУ
			|ГДЕ
			|	ДоговорДУ.Пул = &Пул
			|	И НЕ ДоговорДУ.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДоговорДУ.Код";
	КонецЕсли;
	Запрос.УстановитьПараметр("Пул", Пул);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДоговорДУ");
	
КонецФункции

Функция НовыйТаблицаСравнения()
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ДоговорДУ");
	ТЗ.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("СуммаСтарая", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(22, 2)));
	ТЗ.Колонки.Добавить("СуммаНовая", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(22, 2)));
	ТЗ.Колонки.Добавить("Совпадает", Новый ОписаниеТипов("Булево"));
	Возврат ТЗ;
	
КонецФункции

// Описание: Старая РазмерВознагражденияПриРасторжении (до IMDEV-9104-3):
// MAX(Период) по приходам без основания, затем сумма. Без УдалитьОбязательствоДС.
//
Функция РазмерВознагражденияПриРасторженииСтарый(ДоговорДУ, ДатаРасчетаПараметр)
	
	ЗапросДатаВсехВознаграждений = Новый Запрос;
	ЗапросДатаВсехВознаграждений.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(ОбязательстваПоДС.Период) КАК ДатаВсехВознаграждений
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС КАК ОбязательстваПоДС
		|ГДЕ
		|	ОбязательстваПоДС.ДоговорДУ = &ДоговорДУ
		|	И ОбязательстваПоДС.Основание.Ссылка ЕСТЬ NULL
		|	И ОбязательстваПоДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)";
	ЗапросДатаВсехВознаграждений.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	
	РезультатЗапроса = ЗапросДатаВсехВознаграждений.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СуммаВознаграждения = 0;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		// ДатаВсехВознаграждений не использовалась — как в оригинале
		СуммаВознаграждения = СуммаВознагражденияПоОстатку(ДоговорДУ, ДатаРасчетаПараметр);
	КонецЕсли;
	
	Возврат СуммаВознаграждения;
	
КонецФункции

// Описание: Новая РазмерВознагражденияПриРасторжении (IMDEV-9104-3): сразу сумма
//
Функция РазмерВознагражденияПриРасторженииНовый(ДоговорДУ, ДатаРасчетаПараметр)
	
	Возврат СуммаВознагражденияПоОстатку(ДоговорДУ, ДатаРасчетаПараметр);
	
КонецФункции

// Описание: Read-only копия логики суммы из РазмерВознаграждения (без УдалитьОбязательствоДС)
//
Функция СуммаВознагражденияПоОстатку(ДоговорДУ, ДатаРасчетаПараметр)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СпрДоговорДУ.СрокДействия КАК СрокДоговора,
		|	ВводыВыводыДУ.Сумма КАК СуммаИнвестиций,
		|	ВводыВыводыДУ.Период КАК ДатаВвода
		|ПОМЕСТИТЬ ВТ_ДоговорыДУКРасчету
		|ИЗ
		|	Справочник.ДоговорДУ КАК СпрДоговорДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыДУ КАК ВводыВыводыДУ
		|		ПО (ВводыВыводыДУ.ДоговорДУ = СпрДоговорДУ.Ссылка)
		|ГДЕ
		|	СпрДоговорДУ.Ссылка = &ДоговорДУ
		|	И (СпрДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СпрДоговорДУ.ДатаОкончания > &ДатаРасчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбязательстваПоДСОстатки.ВалютнаяСуммаОстаток КАК СуммаВознаграждения
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС.Остатки(
		|			&ДатаРасчета,
		|			ДоговорДУ = &ДоговорДУ
		|				И Основание.Ссылка ЕСТЬ NULL) КАК ОбязательстваПоДСОстатки,
		|	ВТ_ДоговорыДУКРасчету КАК ВТ_ДоговорыДУКРасчету";
	
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчетаПараметр);
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.СуммаВознаграждения;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПостроитьТабличныйДокументСравнения(Результат)
	
	ТабДок = Новый ТабличныйДокумент;
	
	ТабДок.Область(1, 1).Текст = "IMDEV-9104-3: сравнение MF РазмерВознагражденияПриРасторжении";
	ТабДок.Область(1, 1).Шрифт = Новый Шрифт(, 12, Истина);
	
	ТабДок.Область(3, 1).Текст = "Дата расчета";
	ТабДок.Область(3, 2).Текст = Формат(ДатаРасчета, "ДЛФ=DT");
	ТабДок.Область(4, 1).Текст = "Пул";
	ТабДок.Область(4, 2).Текст = Строка(Пул);
	ТабДок.Область(5, 1).Текст = "Договоров в сравнении";
	ТабДок.Область(5, 2).Текст = Формат(Результат.КоличествоДоговоров, "ЧГ=0");
	ТабДок.Область(6, 1).Текст = "Лимит (0=все)";
	ТабДок.Область(6, 2).Текст = Формат(КоличествоДоговоров, "ЧН=0; ЧГ=0");
	ТабДок.Область(7, 1).Текст = "Режим";
	ТабДок.Область(7, 2).Текст =
		"только чтение (без УдалитьОбязательствоДС); "
		+ ?(КоличествоДоговоров > 0,
			"ПЕРВЫЕ " + Формат(КоличествоДоговоров, "ЧГ=0"),
			"все договоры пула");
	
	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ТабДок.Область(8, 1).Текст = "Ошибка";
		ТабДок.Область(8, 2).Текст = Результат.ТекстОшибки;
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат.ПутьHTML) Тогда
		ТабДок.Область(9, 1).Текст = "HTML";
		ТабДок.Область(9, 2).Текст = Результат.ПутьHTML;
	КонецЕсли;
	
	Стр = 11;
	ТабДок.Область(Стр, 1).Текст = "1. РЕГРЕСС: Договор - СуммаВознаграждения";
	ТабДок.Область(Стр, 1).Шрифт = Новый Шрифт(, 10, Истина);
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Результаты совпадают";
	ТабДок.Область(Стр, 2).Текст = ?(Результат.РезультатыСовпадают, "ДА", "НЕТ");
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Различий";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.Различий, "ЧГ=0");
	
	Стр = Стр + 2;
	ТабДок.Область(Стр, 1).Текст = "ДоговорДУ";
	ТабДок.Область(Стр, 2).Текст = "Сумма старая";
	ТабДок.Область(Стр, 3).Текст = "Сумма новая";
	ТабДок.Область(Стр, 4).Текст = "Совпадает";
	ТабДок.Область(Стр, 1, Стр, 4).Шрифт = Новый Шрифт(, , Истина);
	
	Если ТипЗнч(ТаблицаСравнения) = Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаТЗ Из ТаблицаСравнения Цикл
			Стр = Стр + 1;
			ТабДок.Область(Стр, 1).Текст = СтрокаТЗ.Код;
			ТабДок.Область(Стр, 2).Текст = Формат(СтрокаТЗ.СуммаСтарая, "ЧДЦ=2; ЧН=0; ЧГ=0");
			ТабДок.Область(Стр, 3).Текст = Формат(СтрокаТЗ.СуммаНовая, "ЧДЦ=2; ЧН=0; ЧГ=0");
			ТабДок.Область(Стр, 4).Текст = ?(СтрокаТЗ.Совпадает, "ДА", "НЕТ");
		КонецЦикла;
		Если ТаблицаСравнения.Количество() = 0 Тогда
			Стр = Стр + 1;
			ТабДок.Область(Стр, 1).Текст = "(нет договоров пула)";
		КонецЕсли;
	КонецЕсли;
	
	Стр = Стр + 3;
	ТабДок.Область(Стр, 1).Текст = "2. СКОРОСТЬ (все договоры пула)";
	ТабДок.Область(Стр, 1).Шрифт = Новый Шрифт(, 10, Истина);
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Показатель";
	ТабДок.Область(Стр, 2).Текст = "Время, мс";
	ТабДок.Область(Стр, 3).Текст = "Комментарий";
	ТабДок.Область(Стр, 1, Стр, 3).Шрифт = Новый Шрифт(, , Истина);
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "ПО-СТАРОМУ";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.МсПоСтарому, "ЧГ=0");
	ТабДок.Область(Стр, 3).Текст = "MAX(Период) + сумма по остатку на каждый договор";
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "ПО-НОВОМУ (IMDEV-9104-3)";
	ТабДок.Область(Стр, 2).Текст = Формат(Результат.МсПоНовому, "ЧГ=0");
	ТабДок.Область(Стр, 3).Текст = "только сумма по остатку";
	
	Ускорение = 0;
	Если Результат.МсПоНовому > 0 Тогда
		Ускорение = Результат.МсПоСтарому / Результат.МсПоНовому;
	КонецЕсли;
	Экономия = Результат.МсПоСтарому - Результат.МсПоНовому;
	ДоляЭкономии = 0;
	Если Результат.МсПоСтарому > 0 Тогда
		ДоляЭкономии = 100 * Экономия / Результат.МсПоСтарому;
	КонецЕсли;
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Ускорение (раз)";
	ТабДок.Область(Стр, 2).Текст = Формат(Ускорение, "ЧДЦ=2; ЧН=0; ЧГ=0");
	
	Стр = Стр + 1;
	ТабДок.Область(Стр, 1).Текст = "Экономия, мс";
	ТабДок.Область(Стр, 2).Текст = Формат(Экономия, "ЧГ=0");
	ТабДок.Область(Стр, 3).Текст = Формат(ДоляЭкономии, "ЧДЦ=1; ЧН=0; ЧГ=0") + "% от БЫЛО";
	
	ТабДок.Область(, 1).ШиринаКолонки = 48;
	ТабДок.Область(, 2).ШиринаКолонки = 18;
	ТабДок.Область(, 3).ШиринаКолонки = 18;
	ТабДок.Область(, 4).ШиринаКолонки = 12;
	
	Возврат ТабДок;
	
