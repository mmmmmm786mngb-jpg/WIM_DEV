		+ Символы.ПС + "// = РазмерВознаграждения без УдалитьОбязательствоДС");
	Части.Добавить("</pre></div>");
	
	Части.Добавить("<div class=""card""><h2>3. Статистика скорости</h2><div class=""kpi"">");
