	Части.Добавить("</div>");
	Части.Добавить("<table><tr><th>Показатель</th><th class=""num"">Время, мс</th><th>Комментарий</th></tr>");
	Части.Добавить("<tr><td>ПО-СТАРОМУ</td><td class=""num"">" + Формат(Результат.МсПоСтарому, "ЧГ=0")
