		+ "<th class=""num"">Сумма старая</th><th class=""num"">Сумма новая</th><th>Совпадает</th></tr>");
	
	Номер = 0;
	Если ТипЗнч(ТаблицаСравнения) = Тип("ТаблицаЗначений") Тогда
