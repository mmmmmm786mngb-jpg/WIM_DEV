
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Заголовок = "IMDEV-9104-3 MF вознаграждение | v. "
		+ ТекОбъект.СведенияОВнешнейОбработке().Версия;
	
	Если Не ЗначениеЗаполнено(ТекОбъект.Пул) Тогда
		ТекОбъект.Пул = ПолучитьПулРозничноеДУНаСервере();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекОбъект.ДатаРасчета) Тогда
		ТекОбъект.ДатаРасчета = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если ТекОбъект.КоличествоДоговоров < 0 Тогда
		ТекОбъект.КоличествоДоговоров = 10;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(Объект.ПутьHTML) Тогда
		Объект.ПутьHTML = КаталогДокументов() + "imdev9104_p3_mf_reward_compare.html";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьТест(Команда)
	
	Результат = ЗапуститьТестНаСервере();
	
	ПутьФайла = Объект.ПутьHTML;
	Если ЗначениеЗаполнено(Результат.ТекстHTML) И ЗначениеЗаполнено(ПутьФайла) Тогда
		Попытка
			СохранитьHTMLНаКлиенте(ПутьФайла, Результат.ТекстHTML);
		Исключение
			Сообщить(
				"Сравнение выполнено, но не удалось сохранить HTML на клиенте: "
					+ ОписаниеОшибки()
					+ Символы.ПС + "Укажите существующий каталог (кнопка выбора пути).",
				СтатусСообщения.Важное);
		КонецПопытки;
	КонецЕсли;
	
	Если Результат.Успех Тогда
		Текст = "Сравнение завершено. Договоров: "
			+ Формат(Результат.КоличествоДоговоров, "ЧГ=0")
			+ "; совпадают=" + ?(Результат.РезультатыСовпадают, "ДА", "НЕТ")
			+ "; было мс=" + Формат(Результат.МсПоСтарому, "ЧГ=0")
			+ "; стало мс=" + Формат(Результат.МсПоНовому, "ЧГ=0")
			+ "; HTML=" + ПутьФайла;
		Сообщить(Текст, СтатусСообщения.Информация);
	Иначе
		ТекстОшибки = Результат.ТекстОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Сравнение завершено с ошибками. См. табличный документ.";
		КонецЕсли;
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьHTMLНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбора.Заголовок = "Куда сохранить HTML-отчет (на этом компьютере)";
	ДиалогВыбора.ПолноеИмяФайла = Объект.ПутьHTML;
	ДиалогВыбора.Фильтр = "HTML (*.html)|*.html|Все файлы (*.*)|*.*";
	ДиалогВыбора.Расширение = "html";
	ДиалогВыбора.ИндексФильтра = 0;
	ДиалогВыбора.ПроверятьСуществованиеФайла = Ложь;
	
	Если ДиалогВыбора.Выбрать() Тогда
		Объект.ПутьHTML = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьТестНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	
	Если Не ЗначениеЗаполнено(ТекОбъект.Пул) Тогда
		ТекОбъект.Пул = ПолучитьПулРозничноеДУНаСервере();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекОбъект.ДатаРасчета) Тогда
		ТекОбъект.ДатаРасчета = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Результат = ТекОбъект.СформироватьОтчетЗамеровТеста();
	
	РезультатЗамеров = Новый ТабличныйДокумент;
	Если Результат.ТабДокумент <> Неопределено Тогда
		РезультатЗамеров.Вывести(Результат.ТабДокумент);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
	// На клиент передаём только лёгкие поля + ТекстHTML (без ТабДокумент).
	Ответ = Новый Структура;
	Ответ.Вставить("Успех", Результат.Успех);
	Ответ.Вставить("ТекстОшибки", Результат.ТекстОшибки);
	Ответ.Вставить("ТекстHTML", Результат.ТекстHTML);
	Ответ.Вставить("КоличествоДоговоров", Результат.КоличествоДоговоров);
	Ответ.Вставить("Различий", Результат.Различий);
	Ответ.Вставить("РезультатыСовпадают", Результат.РезультатыСовпадают);
	Ответ.Вставить("МсПоСтарому", Результат.МсПоСтарому);
	Ответ.Вставить("МсПоНовому", Результат.МсПоНовому);
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СохранитьHTMLНаКлиенте(ПутьФайла, ТекстHTML)
	
	ФайлПути = Новый Файл(ПутьФайла);
	КаталогПути = ФайлПути.Путь;
	Если ЗначениеЗаполнено(КаталогПути) Тогда
		КаталогПроверка = Новый Файл(КаталогПути);
		Если Не КаталогПроверка.Существует() Тогда
			СоздатьКаталог(КаталогПути);
		КонецЕсли;
	КонецЕсли;
	
	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Запись.Записать(ТекстHTML);
	Запись.Закрыть();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПулРозничноеДУНаСервере()
	
	НайденныйПул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	Если ЗначениеЗаполнено(НайденныйПул) Тогда
		Возврат НайденныйПул;
	КонецЕсли;
	
	Возврат Справочники.Пул.ПустаяСсылка();
	
КонецФункции

#КонецОбласти
