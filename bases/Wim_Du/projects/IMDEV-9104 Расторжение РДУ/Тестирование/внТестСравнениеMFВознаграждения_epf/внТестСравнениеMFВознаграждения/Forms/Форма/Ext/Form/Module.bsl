
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Заголовок = "IMDEV-9104-3 MF вознаграждение | v. "
		+ ТекОбъект.СведенияОВнешнейОбработке().Версия;
	
	Если Не ЗначениеЗаполнено(ТекОбъект.Пул) Тогда
		ТекОбъект.Пул = ПолучитьПулРозничноеДУНаСервере();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекОбъект.ДатаРасчета) Тогда
		ТекОбъект.ДатаРасчета = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если ТекОбъект.КоличествоДоговоров < 0 Тогда
		ТекОбъект.КоличествоДоговоров = 10;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекОбъект.ПутьHTML) Тогда
		ТекОбъект.ПутьHTML = ПутьHTMLПоУмолчаниюНаСервере();
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьТест(Команда)
	
	ЗапуститьТестНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗапуститьТестНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	
	Если Не ЗначениеЗаполнено(ТекОбъект.Пул) Тогда
		ТекОбъект.Пул = ПолучитьПулРозничноеДУНаСервере();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекОбъект.ДатаРасчета) Тогда
		ТекОбъект.ДатаРасчета = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекОбъект.ПутьHTML) Тогда
		ТекОбъект.ПутьHTML = ПутьHTMLПоУмолчаниюНаСервере();
	КонецЕсли;
	
	Результат = ТекОбъект.СформироватьОтчетЗамеровТеста();
	
	РезультатЗамеров = Новый ТабличныйДокумент;
	Если Результат.ТабДокумент <> Неопределено Тогда
		РезультатЗамеров.Вывести(Результат.ТабДокумент);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
	Если Результат.Успех Тогда
		Текст = "Сравнение завершено. Договоров: "
			+ Формат(Результат.КоличествоДоговоров, "ЧГ=0")
			+ "; совпадают=" + ?(Результат.РезультатыСовпадают, "ДА", "НЕТ")
			+ "; было мс=" + Формат(Результат.МсПоСтарому, "ЧГ=0")
			+ "; стало мс=" + Формат(Результат.МсПоНовому, "ЧГ=0")
			+ "; HTML=" + Результат.ПутьHTML;
		Сообщить(Текст, СтатусСообщения.Информация);
	Иначе
		ТекстОшибки = Результат.ТекстОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Сравнение завершено с ошибками. См. табличный документ.";
		КонецЕсли;
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьПулРозничноеДУНаСервере()
	
	НайденныйПул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	Если ЗначениеЗаполнено(НайденныйПул) Тогда
		Возврат НайденныйПул;
	КонецЕсли;
	
	Возврат Справочники.Пул.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция ПутьHTMLПоУмолчаниюНаСервере()
	
	Возврат "C:\1c\Cursor_1c\WIM_DEV\bases\Wim_Du\projects\IMDEV-9104 Расторжение РДУ\Тестирование\reports\imdev9104_p3_mf_reward_compare.html";
	
КонецФункции

#КонецОбласти
