#Область ОписаниеПеременных

Перем ЗамерыБлоковТеста;
Перем ЛогСтрокТеста;
Перем ДатаРасчетаТеста;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Описание: Сведения для регистрации дополнительной обработки в БСП
//
// Возвращаемое значение:
// Структура - параметры регистрации внешней обработки
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", "Тест расторжения договоров РДУ (без ДО)");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"IMDEV-9104: имитация получения данных о расторжении существующих Розничное ДУ без вызовов ДО/ФИН/FO. Замеры основных операций.");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Тест расторжения РДУ (замеры, без ДО)";
	НоваяКоманда.Идентификатор = "ТестРасторжениеРДУ";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Описание: Запускает тестовый прогон и возвращает табличный документ с замерами
//
// Возвращаемое значение:
// Структура - Успех, Отказ, ТабДокумент, ТекстОшибки, КоличествоДоговоров, ЗамерыБлоков
//
Функция СформироватьОтчетЗамеровТеста() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ТабДокумент", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоДоговоров", 0);
	Результат.Вставить("ЗамерыБлоков", Неопределено);
	
	Отказ = Ложь;
	
	Попытка
		ВыполнитьТестРасторженияРДУ(Отказ);
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Отказ = Истина;
		Результат.Успех = Ложь;
		ЗаписьЖурналаРегистрации(
			"IMDEV-9104.Замер",
			УровеньЖурналаРегистрации.Ошибка,,,
			Результат.ТекстОшибки);
		Возврат Результат;
	КонецПопытки;
	
	Результат.Отказ = (Отказ = Истина);
	Результат.Успех = (Результат.Отказ <> Истина);
	Результат.ЗамерыБлоков = ?(ЗамерыБлоковТеста = Неопределено, Неопределено, ЗамерыБлоковТеста.Скопировать());
	
	Если Результат.ЗамерыБлоков <> Неопределено Тогда
		Для Каждого СтрокаЗамера Из Результат.ЗамерыБлоков Цикл
			Если СтрНачинаетсяС(СтрокаЗамера.Блок, "1. Имитация") Тогда
				Результат.КоличествоДоговоров = СтрокаЗамера.СтрокОбработано;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат.ТабДокумент = ПостроитьТабличныйДокументЗамеров(Результат);
	
	Если Результат.Отказ И Не ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		Результат.ТекстОшибки = "Тест завершен с ошибкой. См. замеры и журнал IMDEV-9104.Замер";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Основной тестовый прогон IMDEV-9104 без внешних систем
//
// Параметры:
// Отказ - Булево - признак ошибки
//
Процедура ВыполнитьТестРасторженияРДУ(Отказ = Ложь)
	
	ИнициализироватьЗамерыБлоковТеста();
	ИнициализироватьЛогСтрокТеста();
	
	ДатаРасчетаТеста = КонецДня(ТекущаяДатаСеанса());
	ЗаполнитьПараметрыПоУмолчанию();
	
	ВремяНачалаОбщее = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.Замер",
		УровеньЖурналаРегистрации.Информация,,,
		"Старт теста: N=" + Формат(КоличествоДоговоров, "ЧГ=0")
			+ "; ТолькоЧтение=" + Строка(ТолькоЧтение)
			+ "; Откат=" + Строка(ОткатыватьТранзакцию));
	
	// --- 1. Имитация GetClosingRetailAgreements ---
	ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДанныеИзДОИмитация = Неопределено;
	Попытка
		ДанныеИзДОИмитация = СформироватьИмитациюРасторженийИзДУ();
	Исключение
		Отказ = Истина;
		ТекстОшибки = ОписаниеОшибки();
		ЗаписатьЗамерБлока("1. Имитация GetClosingRetailAgreements", ВремяНачалаБлока, 0, ТекстОшибки);
		ЗаписатьЗамерБлока("0. ИТОГО", ВремяНачалаОбщее, 0, "Ошибка на шаге 1");
		РассчитатьДолиЗамеровБлоковТеста();
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	КоличествоВыборки = ДанныеИзДОИмитация.Количество();
	ЗаписатьЗамерБлока(
		"1. Имитация GetClosingRetailAgreements",
		ВремяНачалаБлока,
		КоличествоВыборки,
		"Отобрано договоров=" + Формат(КоличествоВыборки, "ЧГ=0"));
	
	Если КоличествоВыборки = 0 Тогда
		Отказ = Истина;
		ЗаписатьЗамерБлока("0. ИТОГО", ВремяНачалаОбщее, 0, "Нет договоров для прогона");
		РассчитатьДолиЗамеровБлоковТеста();
		Возврат;
	КонецЕсли;
	
	МассивДоговоров = Новый Массив;
	Для Каждого СтрокаДанных Из ДанныеИзДОИмитация Цикл
		МассивДоговоров.Добавить(СтрокаДанных.ДоговорДУ);
	КонецЦикла;
	
	НужнаТранзакция = (ТолькоЧтение <> Истина);
	Если НужнаТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	
	Попытка
		
		// --- 2. Цикл шагов РЗ ДОДоговорыДУКРасторжению (без WS ДО) ---
		ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ИтогиЦикла = ВыполнитьЦиклРасторженияСЗамерами(ДанныеИзДОИмитация);
		ЗаписатьЗамерБлока(
			"2. Цикл РЗ (поиск/аналитика/счет/брокер" + ?(ТолькоЧтение, "", "/запись") + ")",
			ВремяНачалаБлока,
			ИтогиЦикла.Обработано,
			"Ошибок=" + Формат(ИтогиЦикла.Ошибок, "ЧГ=0")
				+ "; ДоговорПоНомеру=" + Формат(ИтогиЦикла.МсДоговорПоНомеру, "ЧГ=0") + " мс"
				+ "; АналитическийСчет=" + Формат(ИтогиЦикла.МсАналитическийСчет, "ЧГ=0") + " мс"
				+ "; БанковскийСчет=" + Формат(ИтогиЦикла.МсБанковскийСчет, "ЧГ=0") + " мс"
				+ "; ДоговорКонтрагента=" + Формат(ИтогиЦикла.МсДоговорКонтрагента, "ЧГ=0") + " мс"
				+ "; ЗаписьДаты=" + Формат(ИтогиЦикла.МсЗаписьДаты, "ЧГ=0") + " мс"
				+ "; ПоручениеВывод=" + Формат(ИтогиЦикла.МсПоручениеВывод, "ЧГ=0") + " мс");
		
		// Детализация подблоков цикла отдельными строками (для сортировки «что медленнее»)
		ЗаписатьЗамерБлока("2.1 ДоговорПоНомеру", 0, ИтогиЦикла.Обработано,
			"Сумма мс=" + Формат(ИтогиЦикла.МсДоговорПоНомеру, "ЧГ=0"), ИтогиЦикла.МсДоговорПоНомеру);
		ЗаписатьЗамерБлока("2.2 АналитическийСчет", 0, ИтогиЦикла.Обработано,
			"Сумма мс=" + Формат(ИтогиЦикла.МсАналитическийСчет, "ЧГ=0"), ИтогиЦикла.МсАналитическийСчет);
		ЗаписатьЗамерБлока("2.3 БанковскийСчетКлиента (поиск)", 0, ИтогиЦикла.Обработано,
			"Сумма мс=" + Формат(ИтогиЦикла.МсБанковскийСчет, "ЧГ=0"), ИтогиЦикла.МсБанковскийСчет);
		ЗаписатьЗамерБлока("2.4 ДоговорКонтрагента", 0, ИтогиЦикла.Обработано,
			"Сумма мс=" + Формат(ИтогиЦикла.МсДоговорКонтрагента, "ЧГ=0"), ИтогиЦикла.МсДоговорКонтрагента);
		Если ТолькоЧтение <> Истина Тогда
			ЗаписатьЗамерБлока("2.5 УстановитьДатуРасторжения", 0, ИтогиЦикла.Обработано,
				"Сумма мс=" + Формат(ИтогиЦикла.МсЗаписьДаты, "ЧГ=0"), ИтогиЦикла.МсЗаписьДаты);
			ЗаписатьЗамерБлока("2.6 ПорученияДС (вывод)", 0, ИтогиЦикла.Обработано,
				"Сумма мс=" + Формат(ИтогиЦикла.МсПоручениеВывод, "ЧГ=0"), ИтогиЦикла.МсПоручениеВывод);
		КонецЕсли;
		
		// --- 3. Тяжелый запрос ДанныеПоРасторжению (только чтение) ---
		Если МеритьДанныеПоРасторжению Тогда
			ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
			КоличествоСтрокЗапроса = ВыполнитьЗапросДанныеПоРасторжениюПоСписку(МассивДоговоров);
			ЗаписатьЗамерБлока(
				"3. ДанныеПоРасторжению (запрос)",
				ВремяНачалаБлока,
				КоличествоСтрокЗапроса,
				"Строк выборки=" + Формат(КоличествоСтрокЗапроса, "ЧГ=0"));
		КонецЕсли;
		
		// --- 4. Расчет СЧА по договорам (только чтение) ---
		Если МеритьСЧА Тогда
			ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
			КоличествоСЧА = ВыполнитьЗамерСЧА(МассивДоговоров);
			ЗаписатьЗамерБлока(
				"4. РасчетСЧА_РСА.ПолучитьСуммыРСА_СЧА",
				ВремяНачалаБлока,
				КоличествоСЧА,
				"Договоров=" + Формат(КоличествоСЧА, "ЧГ=0"));
		КонецЕсли;
		
		Если НужнаТранзакция И ТранзакцияАктивна() Тогда
			Если Отказ Или ОткатыватьТранзакцию Или ТолькоЧтение Тогда
				ОтменитьТранзакцию();
			Иначе
				// Преднамеренно не фиксируем - защита от случайной записи
				ОтменитьТранзакцию();
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		Если НужнаТранзакция И ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Отказ = Истина;
		ТекстОшибки = ОписаниеОшибки();
		ЗаписатьЗамерБлока("0. ИТОГО", ВремяНачалаОбщее, КоличествоВыборки, ТекстОшибки);
		РассчитатьДолиЗамеровБлоковТеста();
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	ЗаписатьЗамерБлока(
		"0. ИТОГО",
		ВремяНачалаОбщее,
		КоличествоВыборки,
		"ТолькоЧтение=" + Строка(ТолькоЧтение)
			+ "; Внешние системы=НЕТ (ДО/ФИН/FO/почта)");
	
	РассчитатьДолиЗамеровБлоковТеста();
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.Замер",
		УровеньЖурналаРегистрации.Информация,,,
		"Конец теста. Договоров=" + Формат(КоличествоВыборки, "ЧГ=0"));
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПоУмолчанию()
	
	Если КоличествоДоговоров <= 0 Тогда
		КоличествоДоговоров = 50;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Пул) Тогда
		Пул = ПолучитьПулРозничноеДУ();
	КонецЕсли;
	
КонецПроцедуры

// Описание: Возвращает ссылку на пул «Розничное ДУ»
//
// Возвращаемое значение:
// СправочникСсылка.Пул - пул или пустая ссылка
//
Функция ПолучитьПулРозничноеДУ()
	
	НайденныйПул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	Если ЗначениеЗаполнено(НайденныйПул) Тогда
		Возврат НайденныйПул;
	КонецЕсли;
	
	ПулПоUID = Справочники.Пул.ПолучитьСсылку(Новый УникальныйИдентификатор("686be652-ff24-11ef-b2be-0050569f27c0"));
	Если ОбщегоНазначения.СсылкаСуществует(ПулПоUID) Тогда
		Возврат ПулПоUID;
	КонецЕсли;
	
	Возврат Справочники.Пул.ПустаяСсылка();
	
КонецФункции

// Описание: Отбирает N существующих договоров РДУ и формирует структуру «как из ДО»
//
// Возвращаемое значение:
// Массив из Структура - поля как у GetClosingRetailAgreements / ТестовыеРасторжения
//
Функция СформироватьИмитациюРасторженийИзДУ()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	ДоговорыДУ.Ссылка КАК ДоговорДУ,
	|	ДоговорыДУ.Код КАК НомерДУ,
	|	ДоговорыДУ.Клиент КАК Контрагент,
	|	ДоговорыДУ.ДатаВводаСредствВДУ КАК ДатаВводаСредствВДУ,
	|	ДоговорыДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ КАК ДатаУведомленияФакт,
	|	ЕСТЬNULL(БанковскиеСчета.Банк.Код, """") КАК Бик,
	|	ЕСТЬNULL(БанковскиеСчета.НомерСчета, """") КАК НомерСчета
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорыДУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	|		ПО ДоговорыДУ.Клиент = БанковскиеСчета.Владелец
	|			И (БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный))
	|			И (НЕ БанковскиеСчета.ПометкаУдаления)
	|ГДЕ
	|	ДоговорыДУ.Пул = &Пул
	|	И НЕ ДоговорыДУ.ПометкаУдаления
	|	И (ДоговорыДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДоговорыДУ.ДатаОкончания > &ДатаРасчета)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорыДУ.Код";
	
	// ПЕРВЫЕ N подставляем динамически (параметр платформы для ПЕРВЫЕ недоступен в части платформ)
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000", "ПЕРВЫЕ " + Формат(КоличествоДоговоров, "ЧГ=0"));
	
	Запрос.УстановитьПараметр("Пул", Пул);
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчетаТеста);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	Счетчик = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Счетчик = Счетчик + 1;
		
		ДатаРасторжения = ДатаРасчетаТеста;
		Если ЗначениеЗаполнено(Выборка.ДатаУведомленияФакт) Тогда
			ДатаРасторжения = Выборка.ДатаУведомленияФакт;
		КонецЕсли;
		
		Данные = Новый Структура;
		Данные.Вставить("ДоговорДУ", Выборка.ДоговорДУ);
		Данные.Вставить("НомерДУ", Выборка.НомерДУ);
		Данные.Вставить("Контрагент", Выборка.Контрагент);
		Данные.Вставить("ДатаВводаСредствВДУ", Выборка.ДатаВводаСредствВДУ);
		Данные.Вставить("ДатаРасторжения", ДатаРасторжения);
		Данные.Вставить("НомерРасторжения", "T9104-" + Формат(Счетчик, "ЧГ=0"));
		Данные.Вставить("Бик", Выборка.Бик);
		Данные.Вставить("НомерСчета", Выборка.НомерСчета);
		Данные.Вставить("НетПоручениеВывод", Истина);
		
		Результат.Добавить(Данные);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Проходит цикл как ДОДоговорыДУКРасторжению с детальными замерами подблоков
//
Функция ВыполнитьЦиклРасторженияСЗамерами(ДанныеИзДОИмитация)
	
	Итоги = Новый Структура;
	Итоги.Вставить("Обработано", 0);
	Итоги.Вставить("Ошибок", 0);
	Итоги.Вставить("МсДоговорПоНомеру", 0);
	Итоги.Вставить("МсАналитическийСчет", 0);
	Итоги.Вставить("МсБанковскийСчет", 0);
	Итоги.Вставить("МсДоговорКонтрагента", 0);
	Итоги.Вставить("МсЗаписьДаты", 0);
	Итоги.Вставить("МсПоручениеВывод", 0);
	
	Для Каждого ДанныеРасторжения Из ДанныеИзДОИмитация Цикл
		
		ТекстСтрокиЛога = ДанныеРасторжения.НомерДУ;
		
		Попытка
			
			Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ДоговорДУ = ДоговорПоНомеру(ДанныеРасторжения.НомерДУ);
			Итоги.МсДоговорПоНомеру = Итоги.МсДоговорПоНомеру
				+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
			
			Если Не ЗначениеЗаполнено(ДоговорДУ) Тогда
				Итоги.Ошибок = Итоги.Ошибок + 1;
				ДобавитьСтрокуЛога(ДанныеРасторжения.НомерДУ, "Договор не найден", 0);
				Продолжить;
			КонецЕсли;
			
			Контрагент = ДанныеРасторжения.Контрагент;
			Если Не ЗначениеЗаполнено(Контрагент) Тогда
				Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорДУ, "Клиент");
			КонецЕсли;
			
			Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
			АналитическийСчетДС = АналитическийСчет(ДоговорДУ);
			Итоги.МсАналитическийСчет = Итоги.МсАналитическийСчет
				+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
			
			Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
			СчетКонтрагента = НайтиБанковскийСчетКлиента(
				Контрагент,
				ДанныеРасторжения.Бик,
				ДанныеРасторжения.НомерСчета);
			Итоги.МсБанковскийСчет = Итоги.МсБанковскийСчет
				+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
			
			Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ДоговорБрокера = ДоговорКонтрагентаБрокерский(ДоговорДУ);
			Итоги.МсДоговорКонтрагента = Итоги.МсДоговорКонтрагента
				+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
			
			Если ТолькоЧтение <> Истина Тогда
				
				Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
				УстановитьДатуРасторженияЛокально(ДоговорДУ, ДанныеРасторжения.ДатаРасторжения);
				Итоги.МсЗаписьДаты = Итоги.МсЗаписьДаты
					+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
				
				Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
				СоздатьПоручениеНаВыводЛокально(
					ДоговорДУ,
					Контрагент,
					АналитическийСчетДС,
					ДоговорБрокера,
					СчетКонтрагента,
					ДанныеРасторжения);
				Итоги.МсПоручениеВывод = Итоги.МсПоручениеВывод
					+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0);
				
			КонецЕсли;
			
			Итоги.Обработано = Итоги.Обработано + 1;
			ДобавитьСтрокуЛога(
				ДанныеРасторжения.НомерДУ,
				"OK; АналитСчет=" + ЗначениеЗаполнено(АналитическийСчетДС)
					+ "; Счет=" + ЗначениеЗаполнено(СчетКонтрагента)
					+ "; Брокер=" + ЗначениеЗаполнено(ДоговорБрокера),
				0);
			
		Исключение
			Итоги.Ошибок = Итоги.Ошибок + 1;
			ДобавитьСтрокуЛога(ТекстСтрокиЛога, ОписаниеОшибки(), 0);
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Итоги;
	
КонецФункции

Функция ДоговорПоНомеру(НомерДУ)
	
	ДоговорДУ = Справочники.ДоговорДУ.НайтиПоКоду(НомерДУ);
	Если ДоговорДУ = Неопределено Тогда
		Возврат Справочники.ДоговорДУ.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ДоговорДУ;
	
КонецФункции

Функция АналитическийСчет(ДоговорДУ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТорговыеКоды.АналитическийСчетДС КАК АналитическийСчетДС
	|ИЗ
	|	Справочник.ТорговыеКоды КАК ТорговыеКоды
	|ГДЕ
	|	ТорговыеКоды.ДоговорДУ = &ДоговорДУ";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.АналитическийСчетДС;
	КонецЕсли;
	
	Возврат Справочники.АналитическиеСчета.ПустаяСсылка();
	
КонецФункции

// Описание: Только поиск счета (без создания) - безопасный режим замера
//
Функция НайтиБанковскийСчетКлиента(Контрагент, БИК, НомерСчета)
	
	Если Не ЗначениеЗаполнено(Контрагент) Или Не ЗначениеЗаполнено(НомерСчета) Тогда
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	БанковскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Контрагент
	|	И БанковскиеСчета.НомерСчета = &НомерСчета";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	
КонецФункции

Функция ДоговорКонтрагентаБрокерский(ДоговорДУ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.ДоговорДУ = &ДоговорДУ
	|	И ДоговорыКонтрагентов.РольДоговора = ЗНАЧЕНИЕ(Перечисление.РолиДоговоровКонтрагента.Брокерский)";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура УстановитьДатуРасторженияЛокально(ДоговорДУ, ДатаРасторжения)
	
	ДоговорДУОбъект = ДоговорДУ.ПолучитьОбъект();
	ДоговорДУОбъект.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДатаРасторжения;
	ДоговорДУОбъект.Записать();
	
КонецПроцедуры

Процедура СоздатьПоручениеНаВыводЛокально(ДоговорДУ, Контрагент, АналитическийСчетИсточник,
	ДоговорКонтрагента, РасчетныйСчет, ДанныеРасторжения)
	
	// Поиск существующего поручения на вывод с тем же комментарием
	Комментарий = "Расторжение после периода охлаждения";
	ДатаВвода = ДанныеРасторжения.ДатаВводаСредствВДУ;
	Если ЗначениеЗаполнено(ДатаВвода) Тогда
		ДнейСВвода = (НачалоДня(ДанныеРасторжения.ДатаРасторжения) - НачалоДня(ДатаВвода)) / (24 * 60 * 60);
		Если ДнейСВвода <= 14 Тогда
			Комментарий = "Расторжение в период охлаждения";
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Поручение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Поручение КАК Поручение
	|ГДЕ
	|	Поручение.ДоговорДУ = &ДоговорДУ
	|	И Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.ВыводИзДУ)
	|	И Поручение.Комментарий = &Комментарий
	|	И НЕ Поручение.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	Запрос.УстановитьПараметр("Комментарий", Комментарий);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	ПоручениеПоДС = Документы.Поручение.СоздатьДокумент();
	ПоручениеПоДС.Дата = ДанныеРасторжения.ДатаРасторжения + 32400;
	ПоручениеПоДС.ВходящийНомер = ДанныеРасторжения.НомерРасторжения;
	ПоручениеПоДС.ВходящаяДата = ДанныеРасторжения.ДатаРасторжения;
	ПоручениеПоДС.Комментарий = Комментарий;
	ПоручениеПоДС.ДоговорДУ = ДоговорДУ;
	ПоручениеПоДС.АналитическийСчетИсточник = АналитическийСчетИсточник;
	ПоручениеПоДС.ВидОперации = Перечисления.ВидыОперацийПоручение.ВыводИзДУ;
	ПоручениеПоДС.СпособПодачиПоручения = Перечисления.СпособыПодачиПоручения.ЭлектронныйДокумент;
	ПоручениеПоДС.Контрагент = Контрагент;
	ПоручениеПоДС.СчетКонтрагента = РасчетныйСчет;
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		ПоручениеПоДС.ДоговорКонтрагента = ДоговорКонтрагента;
	КонецЕсли;
	ПоручениеПоДС.СуммаДС = 0;
	ПоручениеПоДС.ВалютаДокумента = ОбщегоНазначенияДУ.ВалютаРеглУчета();
	ПоручениеПоДС.КурсВзаиморасчетов = 1;
	ПоручениеПоДС.КратностьВзаиморасчетов = 1;
	ПоручениеПоДС.Ответственный = ОбщегоНазначения.ТекущийПользователь();
	ПоручениеПоДС.ДокументЗарегистрировал = "IMDEV-9104 тест";
	
	ПоручениеПоДС.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

// Описание: Упрощенный/укороченный аналог ДанныеПоРасторжению по списку договоров (только чтение)
//
Функция ВыполнитьЗапросДанныеПоРасторжениюПоСписку(МассивДоговоров)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорДУ.Ссылка КАК ДоговорДУ,
	|	ДоговорДУ.Код КАК НомерДоговорДУ,
	|	ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ КАК ДатаРасторжения,
	|	ДОБАВИТЬКДАТЕ(ДоговорДУ.ДатаВводаСредствВДУ, ДЕНЬ, 14) >= ЕСТЬNULL(ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ, &ДатаРасчета) КАК РасторжениеВПериодОхлаждения
	|ПОМЕСТИТЬ ВТ_ДоговорыДУКРасторжению
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорДУ
	|ГДЕ
	|	ДоговорДУ.Ссылка В (&МассивДоговоров)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыДУ.ДоговорДУ КАК ДоговорДУ,
	|	ДоговорыДУ.НомерДоговорДУ КАК НомерДоговорДУ,
	|	ДоговорыДУ.ДатаРасторжения КАК ДатаРасторжения,
	|	ДоговорыДУ.РасторжениеВПериодОхлаждения КАК РасторжениеВПериодОхлаждения,
	|	ТорговыеКоды.АналитическийСчетДС КАК АналитическийСчетДС
	|ПОМЕСТИТЬ ВТ_ДоговорыДУ
	|ИЗ
	|	ВТ_ДоговорыДУКРасторжению КАК ДоговорыДУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТорговыеКоды КАК ТорговыеКоды
	|		ПО ДоговорыДУ.ДоговорДУ = ТорговыеКоды.ДоговорДУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВводыВыводыДУ.ДоговорДУ КАК ДоговорДУ,
	|	СУММА(ВводыВыводыДУ.Сумма) КАК СуммаВводаДС
	|ПОМЕСТИТЬ ВТ_ВводДоговорДУ
	|ИЗ
	|	РегистрНакопления.ВводыВыводыДУ КАК ВводыВыводыДУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДоговорыДУ КАК ВТ_ДоговорыДУ
	|		ПО ВводыВыводыДУ.ДоговорДУ = ВТ_ДоговорыДУ.ДоговорДУ
	|ГДЕ
	|	ВводыВыводыДУ.Сумма > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВводыВыводыДУ.ДоговорДУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДоговорыДУ.ДоговорДУ КАК ДоговорДУ,
	|	ВТ_ДоговорыДУ.НомерДоговорДУ КАК НомерДоговорДУ,
	|	ВТ_ДоговорыДУ.ДатаРасторжения КАК ДатаРасторжения,
	|	ВТ_ДоговорыДУ.РасторжениеВПериодОхлаждения КАК РасторжениеВПериодОхлаждения,
	|	ВТ_ДоговорыДУ.АналитическийСчетДС КАК АналитическийСчетДС,
	|	ЕСТЬNULL(ВТ_ВводДоговорДУ.СуммаВводаДС, 0) КАК СуммаВводаДС,
	|	ЕСТЬNULL(ПоручениеВывод.Ссылка, ЗНАЧЕНИЕ(Документ.Поручение.ПустаяСсылка)) КАК ПоручениеПоДСНаВывод
	|ИЗ
	|	ВТ_ДоговорыДУ КАК ВТ_ДоговорыДУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВводДоговорДУ КАК ВТ_ВводДоговорДУ
	|		ПО ВТ_ДоговорыДУ.ДоговорДУ = ВТ_ВводДоговорДУ.ДоговорДУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Поручение КАК ПоручениеВывод
	|		ПО ВТ_ДоговорыДУ.ДоговорДУ = ПоручениеВывод.ДоговорДУ
	|			И (ПоручениеВывод.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.ВыводИзДУ))
	|			И (ПоручениеВывод.Комментарий В (""Расторжение в период охлаждения"", ""Расторжение после периода охлаждения""))
	|			И (НЕ ПоручениеВывод.ПометкаУдаления)";
	
	Запрос.УстановитьПараметр("МассивДоговоров", МассивДоговоров);
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчетаТеста);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Возврат Таблица.Количество();
	
КонецФункции

Функция ВыполнитьЗамерСЧА(МассивДоговоров)
	
	Обработано = 0;
	Для Каждого ДоговорДУ Из МассивДоговоров Цикл
		СуммаРСА = 0;
		СуммаСЧА = 0;
		Документы.РасчетСЧА_РСА.ПолучитьСуммыРСА_СЧА(ДоговорДУ, ДатаРасчетаТеста, Ложь, Истина, СуммаРСА, СуммаСЧА);
		Обработано = Обработано + 1;
	КонецЦикла;
	
	Возврат Обработано;
	
КонецФункции

#Область ЗамерыИОтчет

Процедура ИнициализироватьЗамерыБлоковТеста()
	
	ЗамерыБлоковТеста = Новый ТаблицаЗначений;
	ЗамерыБлоковТеста.Колонки.Добавить("Блок", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	ЗамерыБлоковТеста.Колонки.Добавить("ВремяМс", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0)));
	ЗамерыБлоковТеста.Колонки.Добавить("СтрокОбработано", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0)));
	ЗамерыБлоковТеста.Колонки.Добавить("ДоляПроцента", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2)));
	ЗамерыБлоковТеста.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0)));
	
КонецПроцедуры

Процедура ИнициализироватьЛогСтрокТеста()
	
	ЛогСтрокТеста = Новый ТаблицаЗначений;
	ЛогСтрокТеста.Колонки.Добавить("НомерДУ", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ЛогСтрокТеста.Колонки.Добавить("Результат", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0)));
	ЛогСтрокТеста.Колонки.Добавить("ВремяМс", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0)));
	
КонецПроцедуры

Процедура ДобавитьСтрокуЛога(НомерДУ, Результат, ВремяМс)
	
	Если ЛогСтрокТеста = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЛога = ЛогСтрокТеста.Добавить();
	СтрокаЛога.НомерДУ = НомерДУ;
	СтрокаЛога.Результат = Результат;
	СтрокаЛога.ВремяМс = ВремяМс;
	
КонецПроцедуры

// Описание: Пишет замер блока. Если ВремяМсЗадан >= 0 - использует его вместо вычисления от ВремяНачала
//
Процедура ЗаписатьЗамерБлока(ИмяБлока, ВремяНачала, СтрокОбработано, Комментарий = "", ВремяМсЗадан = -1)
	
	Если ВремяМсЗадан >= 0 Тогда
		ДлительностьМс = ВремяМсЗадан;
	Иначе
		ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	КонецЕсли;
	
	СтрокаЗамера = ЗамерыБлоковТеста.Добавить();
	СтрокаЗамера.Блок = ИмяБлока;
	СтрокаЗамера.ВремяМс = ДлительностьМс;
	СтрокаЗамера.СтрокОбработано = СтрокОбработано;
	СтрокаЗамера.Комментарий = Комментарий;
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9104.Замер",
		УровеньЖурналаРегистрации.Информация,,,
		ИмяБлока + ": " + Формат(ДлительностьМс, "ЧГ=0") + " мс; " + Комментарий);
	
КонецПроцедуры

Процедура РассчитатьДолиЗамеровБлоковТеста()
	
	Если ЗамерыБлоковТеста = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбщееВремяМс = 0;
	Для Каждого СтрокаЗамера Из ЗамерыБлоковТеста Цикл
		Если СтрНачинаетсяС(СтрокаЗамера.Блок, "0. ИТОГО") Тогда
			ОбщееВремяМс = СтрокаЗамера.ВремяМс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаЗамера Из ЗамерыБлоковТеста Цикл
		Если ОбщееВремяМс > 0 И Не СтрНачинаетсяС(СтрокаЗамера.Блок, "0. ИТОГО") Тогда
			СтрокаЗамера.ДоляПроцента = Окр(СтрокаЗамера.ВремяМс / ОбщееВремяМс * 100, 2);
		ИначеЕсли СтрНачинаетсяС(СтрокаЗамера.Блок, "0. ИТОГО") Тогда
			СтрокаЗамера.ДоляПроцента = 100;
		Иначе
			СтрокаЗамера.ДоляПроцента = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПостроитьТабличныйДокументЗамеров(РезультатТеста)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб = Истина;
	
	Строка = 1;
	
	Область = ТабДок.Область(Строка, 1, Строка, 6);
	Область.Объединить();
	Область.Текст = "IMDEV-9104: тест расторжения РДУ (имитация ДО, без внешних систем)";
	Область.Шрифт = Новый Шрифт(, 12, Истина);
	Строка = Строка + 2;
	
	ТабДок.Область(Строка, 1).Текст = "Дата/время прогона:";
	ТабДок.Область(Строка, 2).Текст = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Успех:";
	ТабДок.Область(Строка, 2).Текст = ?(РезультатТеста.Успех = Истина, "Да", "Нет");
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Количество договоров:";
	ТабДок.Область(Строка, 2).Текст = Формат(РезультатТеста.КоличествоДоговоров, "ЧГ=0");
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Пул:";
	ТабДок.Область(Строка, 2).Текст = Строка(Пул);
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Только чтение:";
	ТабДок.Область(Строка, 2).Текст = ?(ТолькоЧтение, "Да (без записи в ДУ)", "Нет (запись + откат)");
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Откат транзакции:";
	ТабДок.Область(Строка, 2).Текст = ?(ОткатыватьТранзакцию, "Да", "Нет");
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Внешние вызовы:";
	ТабДок.Область(Строка, 2).Текст = "НЕТ (ДО / ФИН / FO / почта отключены)";
	Строка = Строка + 2;
	
	Если ЗначениеЗаполнено(РезультатТеста.ТекстОшибки) Тогда
		ТабДок.Область(Строка, 1, Строка, 6).Объединить();
		ТабДок.Область(Строка, 1).Текст = "Ошибка: " + РезультатТеста.ТекстОшибки;
		Строка = Строка + 2;
	КонецЕсли;
	
	ТабДок.Область(Строка, 1, Строка, 5).Объединить();
	ТабДок.Область(Строка, 1).Текст = "Замеры блоков (что медленнее - смотрите долю % и Время мс)";
	ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, 11, Истина);
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Блок";
	ТабДок.Область(Строка, 2).Текст = "Время, мс";
	ТабДок.Область(Строка, 3).Текст = "Доля, %";
	ТабДок.Область(Строка, 4).Текст = "Строк";
	ТабДок.Область(Строка, 5).Текст = "Комментарий";
	ТабДок.Область(Строка, 1, Строка, 5).Шрифт = Новый Шрифт(, , Истина);
	Строка = Строка + 1;
	
	Если РезультатТеста.ЗамерыБлоков <> Неопределено Тогда
		
		// Копия для сортировки по убыванию времени (кроме ИТОГО - в конце)
		ТаблицаСорт = РезультатТеста.ЗамерыБлоков.Скопировать();
		ТаблицаСорт.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
		Для Каждого СтрЗам Из ТаблицаСорт Цикл
			Если СтрНачинаетсяС(СтрЗам.Блок, "0. ИТОГО") Тогда
				СтрЗам.Порядок = 9999;
			Иначе
				СтрЗам.Порядок = 0;
			КонецЕсли;
		КонецЦикла;
		ТаблицаСорт.Сортировать("Порядок Возр, ВремяМс Убыв");
		
		Для Каждого СтрокаЗамера Из ТаблицаСорт Цикл
			ТабДок.Область(Строка, 1).Текст = СтрокаЗамера.Блок;
			ТабДок.Область(Строка, 2).Текст = Формат(СтрокаЗамера.ВремяМс, "ЧГ=0");
			ТабДок.Область(Строка, 3).Текст = Формат(СтрокаЗамера.ДоляПроцента, "ЧЦ=10; ЧДЦ=2");
			ТабДок.Область(Строка, 4).Текст = Формат(СтрокаЗамера.СтрокОбработано, "ЧГ=0");
			ТабДок.Область(Строка, 5).Текст = СтрокаЗамера.Комментарий;
			Если СтрНачинаетсяС(СтрокаЗамера.Блок, "0. ИТОГО") Тогда
				ТабДок.Область(Строка, 1, Строка, 5).Шрифт = Новый Шрифт(, , Истина);
			КонецЕсли;
			Строка = Строка + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	Строка = Строка + 2;
	ТабДок.Область(Строка, 1, Строка, 3).Объединить();
	ТабДок.Область(Строка, 1).Текст = "Лог по договорам (первые 200)";
	ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, 11, Истина);
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Номер ДУ";
	ТабДок.Область(Строка, 2).Текст = "Результат";
	ТабДок.Область(Строка, 1, Строка, 2).Шрифт = Новый Шрифт(, , Истина);
	Строка = Строка + 1;
	
	Если ЛогСтрокТеста <> Неопределено Тогда
		Сч = 0;
		Для Каждого СтрокаЛога Из ЛогСтрокТеста Цикл
			Сч = Сч + 1;
			Если Сч > 200 Тогда
				ТабДок.Область(Строка, 1).Текст = "...";
				ТабДок.Область(Строка, 2).Текст = "еще " + Формат(ЛогСтрокТеста.Количество() - 200, "ЧГ=0");
				Прервать;
			КонецЕсли;
			ТабДок.Область(Строка, 1).Текст = СтрокаЛога.НомерДУ;
			ТабДок.Область(Строка, 2).Текст = СтрокаЛога.Результат;
			Строка = Строка + 1;
		КонецЦикла;
	КонецЕсли;
	
	ТабДок.Область(1, 1, Строка, 5).ШиринаКолонки = 18;
	ТабДок.Область(, 1).ШиринаКолонки = 45;
	ТабДок.Область(, 5).ШиринаКолонки = 60;
	
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
