#Область IMDEV_9434

#Область ОписаниеПеременных

&НаКлиенте
Перем ПродолжитьПерезаполнениеПослеПодтверждения;

#КонецОбласти

&НаКлиенте
&ИзменениеИКонтроль("Перезаполнить")
Процедура IM9434_Перезаполнить(Команда)
	
	ОчиститьСообщения();
	
#Вставка
	Если ПродолжитьПерезаполнениеПослеПодтверждения <> Истина Тогда
		
		ОписаниеОтбора = ОписаниеОтбораДляПодтвержденияПерезаполнения();
		Если Не ОписаниеОтбора.ПериодЗадан Тогда
			ПоказатьПредупреждение(, ОписаниеОтбора.ТекстОшибкиПериода);
			Возврат;
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПерезаполнения", ЭтотОбъект);
		ПоказатьВопрос(
			Оповещение,
			ОписаниеОтбора.ТекстВопроса,
			РежимДиалогаВопрос.ДаНет,
			0,
			КодВозвратаДиалога.Нет,
			НСтр("ru='Подтверждение перезаполнения'"));
		Возврат;
		
	КонецЕсли;
	
	ПродолжитьПерезаполнениеПослеПодтверждения = Ложь;
#КонецВставки
	//Инициализация документов для перезаполнения
	Если Объект.ВидДокумента = "Расчет СЧА/РСА" Тогда
		Макет = "РасчетСЧА_РСА";
		ПроцедураЗаполнения = "ПолучитьСуммыРСАСЧА()";
		
	ИначеЕсли Объект.ВидДокумента = "Начисление %% по банковским счетам" Тогда
		Макет = "НачислениеПроцентовПоБанковскимСчетам";
		ПроцедураЗаполнения = "ЗаполнитьТЧ()";
		
	ИначеЕсли Объект.ВидДокумента = "Погашение облигаций" Тогда
		Макет = "ПогашениеОблигаций";
		ПроцедураЗаполнения = "ЗаполнитьСписокОблигаций(Истина, Истина)";
		
	ИначеЕсли Объект.ВидДокумента = "Реформация баланса" Тогда
		Макет = "РеформацияБаланса";
		ПроцедураЗаполнения = "ЗаполнитьОборотыПоСчетам()";
		
	ИначеЕсли Объект.ВидДокумента = "Погашение НКД" Тогда
		Макет = "ПереводНКДВЗадолженностьЭмитента";
		ПроцедураЗаполнения = "ЗаполнитьКупоннымиПериодами()";
		
	ИначеЕсли Объект.ВидДокумента = "Начисление купонного дохода" Тогда 
		Макет = "НачислениеКупонногоДохода";
		ПроцедураЗаполнения = "ЗаполнитьКупоннымиПериодами()";
		
	ИначеЕсли Объект.ВидДокумента = "Переоценка активов" Тогда
		Макет = "ПереоценкаАктивов";
		ПроцедураЗаполнения = "ЗаполнитьТЧ()";
		
	ИначеЕсли Объект.ВидДокумента = "Переоценка взаиморасчетов" Тогда
		Макет = "ПереоценкаВзаиморасчетов";
		ПроцедураЗаполнения = "ЗаполнитьВзаиморасчеты()";
		
	ИначеЕсли Объект.ВидДокумента = "Переоценка денежных средств" Тогда
		Макет = "ПереоценкаДенежныхСредств";
		ПроцедураЗаполнения = "ЗаполнитьТабличнуюЧастьАктивами()";
		
	ИначеЕсли Объект.ВидДокумента = "Установка котировок ц/б" Тогда
		Макет = "УстановкаКотировокЦБ";
		ПроцедураЗаполнения = "ЗаполнитьКотировки()";
		
	ИначеЕсли Объект.ВидДокумента = "Установка котировок ц/б (по пулам)" Тогда
		Макет = "УстановкаКотировокЦБПоПулам";
		ПроцедураЗаполнения = "ЗаполнитьКотировки()"; 
		
	КонецЕсли;
	
#Вставка
	Если Объект.ВидДокумента <> "Установка котировок ц/б (по пулам)" Тогда
		
		РезультатЗадания = ЗапуститьПерезаполнениеНаСервере();
		Если РезультатЗадания = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ОбработатьЗавершениеПерезаполнения", ЭтотОбъект);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ТекстСообщения = НСтр("ru='Групповое перезаполнение документов...'");
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
		ПараметрыОжидания.ВыводитьСообщения = Истина;
		ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, Оповещение, ПараметрыОжидания);
		Возврат;
		
	КонецЕсли;
#КонецВставки
	МассивДокументовДляПерепроведения = ПолучитьМассивДокументовДляПерепроведения(Макет);
	Если ТипЗнч(МассивДокументовДляПерепроведения) <> Тип("Массив") Тогда Возврат; КонецЕсли;
	
#Вставка
	ОписаниеЗамера = НачатьЗамерПерезаполненияНаСервере();
#КонецВставки
	КартинкаИндикатора = БиблиотекаКартинок.ДлительнаяОперация48;
	
	Обработано = 0;
	МаксимальноеЗначение = МассивДокументовДляПерепроведения.Количество();
	Для каждого Ссылка Из МассивДокументовДляПерепроведения Цикл
		ТекстСостояния = НСтр("ru = 'Групповое перезаполнение документов'");
		Состояние(ТекстСостояния, Окр(100*Обработано/МаксимальноеЗначение), Ссылка, КартинкаИндикатора);
		ПереполнитьДокументы(Ссылка, ПроцедураЗаполнения);
		Обработано = Обработано + 1;
	КонецЦикла; 
	
	// ASP-139357 {
	Если Объект.ВидДокумента = "Расчет СЧА/РСА" И Объект.ПерезаполнятьКонтрольДопустимогоУровняРиска Тогда
		
		Макет = "КонтрольДопустимогоУровняРиска";
		ПроцедураЗаполнения = "РасчитатьУменьшениеСтоимостиПортфеля()";
		
		МассивДокументовДляПерепроведения = ПолучитьМассивДокументовДляПерепроведения(Макет);
		Если ТипЗнч(МассивДокументовДляПерепроведения) = Тип("Массив") Тогда 
			МаксимальноеЗначение = МассивДокументовДляПерепроведения.Количество();
			Для каждого Ссылка Из МассивДокументовДляПерепроведения Цикл
				ТекстСостояния = НСтр("ru = 'Групповое перезаполнение документов'");
				Состояние(ТекстСостояния, Окр(100*Обработано/МаксимальноеЗначение), Ссылка, КартинкаИндикатора);
				ПереполнитьДокументы(Ссылка, ПроцедураЗаполнения);
				Обработано = Обработано + 1;
			КонецЦикла;
		КонецЕсли;

	КонецЕсли; // }
	
	ТекстСостояния = НСтр("ru = 'Групповое перезаполнение документов'");
	Состояние(ТекстСостояния, 100, , КартинкаИндикатора);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = НСтр("ru = 'Перезаполнение документов завершено. Обработано: '") + Обработано + НСтр("ru = ' док.'");
	Сообщение.Сообщить();
	
#Вставка
	КомментарийЗамера = СтрШаблон(
		НСтр("ru='Вид=%1; Договоров=0; Документов=%2; Риск=Нет; Потоков=1; Успешно=%2; Ошибок=0; Порция=1'"),
		Объект.ВидДокумента,
		Формат(Обработано, "ЧН=0; ЧГ="));
	ЗакончитьЗамерПерезаполненияНаСервере(ОписаниеЗамера, Обработано, КомментарийЗамера);
#КонецВставки
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияПерезаполнения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьПерезаполнениеПослеПодтверждения = Истина;
	Перезаполнить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗавершениеПерезаполнения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Групповое перезаполнение отменено.'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Ошибка группового перезаполнения: '")
			+ Результат.КраткоеПредставлениеОшибки;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьПерезаполнениеНаСервере()
	
	Макет = "";
	ПроцедураЗаполнения = "";
	ИмяДокументаМетаданных = "";
	
	Если Объект.ВидДокумента = "Расчет СЧА/РСА" Тогда
		Макет = "РасчетСЧА_РСА";
		ПроцедураЗаполнения = "ПолучитьСуммыРСАСЧА()";
		ИмяДокументаМетаданных = "РасчетСЧА_РСА";
		
	ИначеЕсли Объект.ВидДокумента = "Начисление %% по банковским счетам" Тогда
		Макет = "НачислениеПроцентовПоБанковскимСчетам";
		ПроцедураЗаполнения = "ЗаполнитьТЧ()";
		ИмяДокументаМетаданных = "НачислениеПроцентовПоБанковскимСчетам";
		
	ИначеЕсли Объект.ВидДокумента = "Погашение облигаций" Тогда
		Макет = "ПогашениеОблигаций";
		ПроцедураЗаполнения = "ЗаполнитьСписокОблигаций(Истина, Истина)";
		ИмяДокументаМетаданных = "ПогашениеОблигаций";
		
	ИначеЕсли Объект.ВидДокумента = "Реформация баланса" Тогда
		Макет = "РеформацияБаланса";
		ПроцедураЗаполнения = "ЗаполнитьОборотыПоСчетам()";
		ИмяДокументаМетаданных = "РеформацияБаланса";
		
	ИначеЕсли Объект.ВидДокумента = "Погашение НКД" Тогда
		Макет = "ПереводНКДВЗадолженностьЭмитента";
		ПроцедураЗаполнения = "ЗаполнитьКупоннымиПериодами()";
		ИмяДокументаМетаданных = "ПереводНКДВЗадолженностьЭмитента";
		
	ИначеЕсли Объект.ВидДокумента = "Начисление купонного дохода" Тогда
		Макет = "НачислениеКупонногоДохода";
		ПроцедураЗаполнения = "ЗаполнитьКупоннымиПериодами()";
		ИмяДокументаМетаданных = "НачислениеКупонногоДохода";
		
	ИначеЕсли Объект.ВидДокумента = "Переоценка активов" Тогда
		Макет = "ПереоценкаАктивов";
		ПроцедураЗаполнения = "ЗаполнитьТЧ()";
		ИмяДокументаМетаданных = "ПереоценкаАктивов";
		
	ИначеЕсли Объект.ВидДокумента = "Переоценка взаиморасчетов" Тогда
		Макет = "ПереоценкаВзаиморасчетов";
		ПроцедураЗаполнения = "ЗаполнитьВзаиморасчеты()";
		ИмяДокументаМетаданных = "ПереоценкаВзаиморасчетов";
		
	ИначеЕсли Объект.ВидДокумента = "Переоценка денежных средств" Тогда
		Макет = "ПереоценкаДенежныхСредств";
		ПроцедураЗаполнения = "ЗаполнитьТабличнуюЧастьАктивами()";
		ИмяДокументаМетаданных = "ПереоценкаДенежныхСредств";
		
	ИначеЕсли Объект.ВидДокумента = "Установка котировок ц/б" Тогда
		Макет = "УстановкаКотировокЦБ";
		ПроцедураЗаполнения = "ЗаполнитьКотировки()";
		ИмяДокументаМетаданных = "УстановкаКотировокЦБ";
		
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не выбран вид документа для перезаполнения.'");
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	
	МассивДокументов = ПолучитьМассивДокументовДляПерепроведения(Макет);
	Если ТипЗнч(МассивДокументов) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("Ссылка");
	ТаблицаДокументов.Колонки.Добавить("ДоговорДУ");
	
	Если МассивДокументов.Количество() > 0 И ЗначениеЗаполнено(ИмяДокументаМетаданных) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка,
		|	Док.ДоговорДУ КАК ДоговорДУ
		|ИЗ
		|	Документ." + ИмяДокументаМетаданных + " КАК Док
		|ГДЕ
		|	Док.Ссылка В (&Ссылки)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата,
		|	Док.Ссылка";
		Запрос.УстановитьПараметр("Ссылки", МассивДокументов);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ТаблицаДокументов.Найти(Выборка.Ссылка, "Ссылка") <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТаблицы = ТаблицаДокументов.Добавить();
			СтрокаТаблицы.Ссылка = Выборка.Ссылка;
			СтрокаТаблицы.ДоговорДУ = Выборка.ДоговорДУ;
		КонецЦикла;
	КонецЕсли;
	
	ФлагРиска = Объект.ВидДокумента = "Расчет СЧА/РСА"
		И Объект.ПерезаполнятьКонтрольДопустимогоУровняРиска;
	
	ТаблицаРиска = Новый ТаблицаЗначений;
	ТаблицаРиска.Колонки.Добавить("Ссылка");
	ТаблицаРиска.Колонки.Добавить("ДоговорДУ");
	
	Если ФлагРиска Тогда
		
		// Отбор списка относится к СЧА/РСА (Ссылка, Номер, период списка).
		// Тот же отбор на макете риска часто даёт пусто: даты СЧА и риска
		// отличаются секундами (12 и 13), поле Ссылка другого типа.
		// Риск берём по договорам и календарному дню отобранных СЧА.
		Если МассивДокументов.Количество() > 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	Риск.Ссылка КАК Ссылка,
			|	Риск.ДоговорДУ КАК ДоговорДУ
			|ИЗ
			|	Документ.КонтрольДопустимогоУровняРиска КАК Риск
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасчетСЧА_РСА КАК ДокРасчет
			|		ПО Риск.ДоговорДУ = ДокРасчет.ДоговорДУ
			|			И НАЧАЛОПЕРИОДА(Риск.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(ДокРасчет.Дата, ДЕНЬ)
			|ГДЕ
			|	ДокРасчет.Ссылка В (&СсылкиСЧА)
			|	И НЕ Риск.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	Риск.Дата,
			|	Риск.Ссылка";
			Запрос.УстановитьПараметр("СсылкиСЧА", МассивДокументов);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрокаТаблицы = ТаблицаРиска.Добавить();
				СтрокаТаблицы.Ссылка = Выборка.Ссылка;
				СтрокаТаблицы.ДоговорДУ = Выборка.ДоговорДУ;
			КонецЦикла;
		КонецЕсли;
		
		МассивРиска = ПолучитьМассивДокументовДляПерепроведения("КонтрольДопустимогоУровняРиска");
		Если ТипЗнч(МассивРиска) = Тип("Массив") И МассивРиска.Количество() > 0 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	Док.Ссылка КАК Ссылка,
			|	Док.ДоговорДУ КАК ДоговорДУ
			|ИЗ
			|	Документ.КонтрольДопустимогоУровняРиска КАК Док
			|ГДЕ
			|	Док.Ссылка В (&Ссылки)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Док.Дата,
			|	Док.Ссылка";
			Запрос.УстановитьПараметр("Ссылки", МассивРиска);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ТаблицаРиска.Найти(Выборка.Ссылка, "Ссылка") <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				СтрокаТаблицы = ТаблицаРиска.Добавить();
				СтрокаТаблицы.Ссылка = Выборка.Ссылка;
				СтрокаТаблицы.ДоговорДУ = Выборка.ДоговорДУ;
			КонецЦикла;
		КонецЕсли;
		
		Если ТаблицаРиска.Количество() = 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Документы контроля допустимого уровня риска по отобранным СЧА/РСА не найдены.'");
			Сообщение.Сообщить();
		КонецЕсли;
		
	КонецЕсли;
	
	КоличествоПотоков = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
	РазмерПорции = ОбщегоНазначенияДУ.ПолучитьЧисловуюКонстанту("МаксимальныйРазмерПорцииДоговоровВПотокеРегл", 50);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ВидДокумента", Объект.ВидДокумента);
	ПараметрыПроцедуры.Вставить("ТаблицаДокументов", ТаблицаДокументов);
	ПараметрыПроцедуры.Вставить("ТаблицаРиска", ТаблицаРиска);
	ПараметрыПроцедуры.Вставить("ПроцедураЗаполнения", ПроцедураЗаполнения);
	ПараметрыПроцедуры.Вставить("ПроцедураЗаполненияРиска", "РасчитатьУменьшениеСтоимостиПортфеля()");
	ПараметрыПроцедуры.Вставить("ФлагРиска", ФлагРиска);
	ПараметрыПроцедуры.Вставить("КоличествоПотоков", КоличествоПотоков);
	ПараметрыПроцедуры.Вставить("РазмерПорции", РазмерПорции);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Групповое перезаполнение документов'");
	ПараметрыВыполнения.КлючФоновогоЗадания = "IM9434_ГрупповоеПерезаполнение";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.ГрупповоеПерезаполнениеДокументов.ВыполнитьГрупповоеПерезаполнение",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Функция НачатьЗамерПерезаполненияНаСервере()
	
	Возврат ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
		"ДУ.ГрупповоеПерезаполнениеДокументов");
	
КонецФункции

&НаСервере
Процедура ЗакончитьЗамерПерезаполненияНаСервере(ОписаниеЗамера, КоличествоДанных, Комментарий)
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(
		ОписаниеЗамера,
		КоличествоДанных,
		"",
		Комментарий);
	
КонецПроцедуры

// Описание: Собирает описание отбора списка и проверяет оба края периода по полю Дата.
//
// Возвращаемое значение:
// Структура - ПериодЗадан, ТекстОшибкиПериода, ТекстВопроса
//
&НаСервере
Функция ОписаниеОтбораДляПодтвержденияПерезаполнения()
	
	Результат = Новый Структура;
	Результат.Вставить("ПериодЗадан", Ложь);
	Результат.Вставить("ТекстОшибкиПериода",
		НСтр("ru='Не задан период отбора документов. В настройке списка укажите дату начала и дату окончания (оба края) и повторите перезаполнение.'"));
	Результат.Вставить("ТекстВопроса", "");
	
	Если Объект.ВидДокумента = "Установка котировок ц/б (по пулам)" Тогда
		ОбрабатываемыйСписок = СписокУстановкаКотировокЦБПоПулам;
	Иначе
		ОбрабатываемыйСписок = СписокДокументов;
	КонецЕсли;
	
	СтрокиОтбора = Новый Массив;
	ЕстьДатаНачала = Ложь;
	ЕстьДатаКонца = Ложь;
	ДатаНачала = Дата(1, 1, 1);
	ДатаКонца = Дата(1, 1, 1);
	ФорматДатыОтбора = "ДФ='dd.MM.yyyy ЧЧ:мм:сс'";
	
	// ПользовательскиеНастройки.Элементы - обёртки без ЛевоеЗначение. Берём применённый отбор.
	ОчередьОтбора = Новый Массив;
	НастройкиСписка = ОбрабатываемыйСписок.КомпоновщикНастроек.ПолучитьНастройки();
	Для Каждого ТекЭлемент Из НастройкиСписка.Отбор.Элементы Цикл
		ОчередьОтбора.Добавить(ТекЭлемент);
	КонецЦикла;
	
	ИндексОчереди = 0;
	Пока ИндексОчереди < ОчередьОтбора.Количество() Цикл
		
		ЭлементОтбора = ОчередьОтбора[ИндексОчереди];
		ИндексОчереди = ИндексОчереди + 1;
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ОтборКомпоновкиДанных")
			Или ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")
				И Не ЭлементОтбора.Использование Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого ПодчиненныйЭлемент Из ЭлементОтбора.Элементы Цикл
				ОчередьОтбора.Добавить(ПодчиненныйЭлемент);
			КонецЦикла;
			Продолжить;
			
		КонецЕсли;
		
		Если ТипЗнч(ЭлементОтбора) <> Тип("ЭлементОтбораКомпоновкиДанных")
			Или Не ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = СокрЛП(Строка(ЭлементОтбора.ЛевоеЗначение));
		Если ИмяПоля = "Проведен" Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоляВРег = ВРег(ИмяПоля);
		ЭтоПолеДаты = ИмяПоляВРег = "ДАТА"
			Или ИмяПоляВРег = "DATE"
			Или Прав(ИмяПоляВРег, 5) = ".ДАТА"
			Или Прав(ИмяПоляВРег, 5) = ".DATE";
		
		ПравоеЗначение = ЭлементОтбора.ПравоеЗначение;
		ДатаЗначения = Дата(1, 1, 1);
		Если ТипЗнч(ПравоеЗначение) = Тип("Дата") Тогда
			ДатаЗначения = ПравоеЗначение;
		ИначеЕсли ТипЗнч(ПравоеЗначение) = Тип("СтандартнаяДатаНачала") Тогда
			ДатаЗначения = ПравоеЗначение.Дата;
		КонецЕсли;
		
		Если ЭтоПолеДаты Тогда
			
			ВидСравненияОтбора = ЭлементОтбора.ВидСравнения;
			Если ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Больше
				Или ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
				
				Если ЗначениеЗаполнено(ДатаЗначения) Тогда
					ЕстьДатаНачала = Истина;
					ДатаНачала = ДатаЗначения;
				КонецЕсли;
				
			ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Меньше
				Или ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
				
				Если ЗначениеЗаполнено(ДатаЗначения) Тогда
					ЕстьДатаКонца = Истина;
					ДатаКонца = ДатаЗначения;
				КонецЕсли;
				
			ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Равно Тогда
				
				Если ЗначениеЗаполнено(ДатаЗначения) Тогда
					ЕстьДатаНачала = Истина;
					ЕстьДатаКонца = Истина;
					ДатаНачала = ДатаЗначения;
					ДатаКонца = ДатаЗначения;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ПравоеЗначение) = Тип("СтандартныйПериод") Тогда
				
				Если ЗначениеЗаполнено(ПравоеЗначение.ДатаНачала) Тогда
					ЕстьДатаНачала = Истина;
					ДатаНачала = ПравоеЗначение.ДатаНачала;
				КонецЕсли;
				Если ЗначениеЗаполнено(ПравоеЗначение.ДатаОкончания) Тогда
					ЕстьДатаКонца = Истина;
					ДатаКонца = ПравоеЗначение.ДатаОкончания;
				КонецЕсли;
				
			Иначе
				
				ДатыИнтервала = Новый Массив;
				Если ТипЗнч(ПравоеЗначение) = Тип("Массив") Тогда
					Для Каждого ЭлементЗначения Из ПравоеЗначение Цикл
						ДатыИнтервала.Добавить(ЭлементЗначения);
					КонецЦикла;
				ИначеЕсли ТипЗнч(ПравоеЗначение) = Тип("СписокЗначений") Тогда
					Для Каждого ЭлементСписка Из ПравоеЗначение Цикл
						ДатыИнтервала.Добавить(ЭлементСписка.Значение);
					КонецЦикла;
				КонецЕсли;
				
				Если ДатыИнтервала.Количество() > 0 Тогда
					ПерваяДата = ДатыИнтервала[0];
					Если ТипЗнч(ПерваяДата) = Тип("СтандартнаяДатаНачала") Тогда
						ПерваяДата = ПерваяДата.Дата;
					КонецЕсли;
					Если ТипЗнч(ПерваяДата) = Тип("Дата") И ЗначениеЗаполнено(ПерваяДата) Тогда
						ЕстьДатаНачала = Истина;
						ДатаНачала = ПерваяДата;
					КонецЕсли;
				КонецЕсли;
				
				Если ДатыИнтервала.Количество() > 1 Тогда
					ВтораяДата = ДатыИнтервала[1];
					Если ТипЗнч(ВтораяДата) = Тип("СтандартнаяДатаНачала") Тогда
						ВтораяДата = ВтораяДата.Дата;
					КонецЕсли;
					Если ТипЗнч(ВтораяДата) = Тип("Дата") И ЗначениеЗаполнено(ВтораяДата) Тогда
						ЕстьДатаКонца = Истина;
						ДатаКонца = ВтораяДата;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		ВидСравненияОтбора = ЭлементОтбора.ВидСравнения;
		Если ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Равно Тогда
			ТекстВидаСравнения = "=";
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.НеРавно Тогда
			ТекстВидаСравнения = "<>";
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Больше Тогда
			ТекстВидаСравнения = ">";
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
			ТекстВидаСравнения = ">=";
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Меньше Тогда
			ТекстВидаСравнения = "<";
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
			ТекстВидаСравнения = "<=";
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.ВСписке Тогда
			ТекстВидаСравнения = НСтр("ru='в списке'");
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
			ТекстВидаСравнения = НСтр("ru='не в списке'");
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Содержит Тогда
			ТекстВидаСравнения = НСтр("ru='содержит'");
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
			ТекстВидаСравнения = НСтр("ru='не содержит'");
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Заполнено Тогда
			ТекстВидаСравнения = НСтр("ru='заполнено'");
		ИначеЕсли ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
			ТекстВидаСравнения = НСтр("ru='не заполнено'");
		Иначе
			ТекстВидаСравнения = Строка(ВидСравненияОтбора);
		КонецЕсли;
		
		Если ТипЗнч(ПравоеЗначение) = Тип("Дата") Тогда
			Если ЗначениеЗаполнено(ПравоеЗначение) Тогда
				ТекстЗначения = Формат(ПравоеЗначение, ФорматДатыОтбора);
			Иначе
				ТекстЗначения = НСтр("ru='(пусто)'");
			КонецЕсли;
		ИначеЕсли ТипЗнч(ПравоеЗначение) = Тип("СтандартнаяДатаНачала") Тогда
			Если ЗначениеЗаполнено(ПравоеЗначение.Дата) Тогда
				ТекстЗначения = Формат(ПравоеЗначение.Дата, ФорматДатыОтбора);
			Иначе
				ТекстЗначения = НСтр("ru='(пусто)'");
			КонецЕсли;
		ИначеЕсли ТипЗнч(ПравоеЗначение) = Тип("СтандартныйПериод") Тогда
			ТекстЗначения = Формат(ПравоеЗначение.ДатаНачала, ФорматДатыОтбора)
				+ " - " + Формат(ПравоеЗначение.ДатаОкончания, ФорматДатыОтбора);
		ИначеЕсли ТипЗнч(ПравоеЗначение) = Тип("СписокЗначений") Тогда
			ЧастиСписка = Новый Массив;
			Для Каждого ЭлементСписка Из ПравоеЗначение Цикл
				ЗначениеЭлемента = ЭлементСписка.Значение;
				Если ТипЗнч(ЗначениеЭлемента) = Тип("Дата") Тогда
					Если ЗначениеЗаполнено(ЗначениеЭлемента) Тогда
						ЧастиСписка.Добавить(Формат(ЗначениеЭлемента, ФорматДатыОтбора));
					Иначе
						ЧастиСписка.Добавить(НСтр("ru='(пусто)'"));
					КонецЕсли;
				Иначе
					ЧастиСписка.Добавить(Строка(ЗначениеЭлемента));
				КонецЕсли;
			КонецЦикла;
			ТекстЗначения = СтрСоединить(ЧастиСписка, ", ");
		ИначеЕсли ТипЗнч(ПравоеЗначение) = Тип("Массив") Тогда
			ЧастиСписка = Новый Массив;
			Для Каждого ЭлементМассива Из ПравоеЗначение Цикл
				Если ТипЗнч(ЭлементМассива) = Тип("Дата") Тогда
					Если ЗначениеЗаполнено(ЭлементМассива) Тогда
						ЧастиСписка.Добавить(Формат(ЭлементМассива, ФорматДатыОтбора));
					Иначе
						ЧастиСписка.Добавить(НСтр("ru='(пусто)'"));
					КонецЕсли;
				Иначе
					ЧастиСписка.Добавить(Строка(ЭлементМассива));
				КонецЕсли;
			КонецЦикла;
			ТекстЗначения = СтрСоединить(ЧастиСписка, ", ");
		Иначе
			ТекстЗначения = Строка(ПравоеЗначение);
		КонецЕсли;
		
		СтрокиОтбора.Добавить(ИмяПоля + " " + ТекстВидаСравнения + " " + ТекстЗначения);
		
	КонецЦикла;
	
	Результат.ПериодЗадан = ЕстьДатаНачала И ЕстьДатаКонца;
	
	ЧастиВопроса = Новый Массив;
	ЧастиВопроса.Добавить(НСтр("ru='Будет выполнено групповое перезаполнение.'"));
	ЧастиВопроса.Добавить("");
	ЧастиВопроса.Добавить(НСтр("ru='Вид: '") + Строка(Объект.ВидДокумента));
	
	Если Результат.ПериодЗадан Тогда
		ЧастиВопроса.Добавить(НСтр("ru='Период: '")
			+ Формат(ДатаНачала, ФорматДатыОтбора) + " - " + Формат(ДатаКонца, ФорматДатыОтбора));
	КонецЕсли;
	
	Если Объект.ВидДокумента = "Расчет СЧА/РСА" Тогда
		Если Объект.ПерезаполнятьКонтрольДопустимогоУровняРиска Тогда
			ЧастиВопроса.Добавить(НСтр("ru='Контроль допустимого уровня риска: да'"));
		Иначе
			ЧастиВопроса.Добавить(НСтр("ru='Контроль допустимого уровня риска: нет'"));
		КонецЕсли;
	КонецЕсли;
	
	ЧастиВопроса.Добавить("");
	Если СтрокиОтбора.Количество() > 0 Тогда
		ЧастиВопроса.Добавить(НСтр("ru='Прочие отборы:'"));
		Для Каждого СтрокаОтбора Из СтрокиОтбора Цикл
			ЧастиВопроса.Добавить("  " + СтрокаОтбора);
		КонецЦикла;
		ЧастиВопроса.Добавить("");
	КонецЕсли;
	ЧастиВопроса.Добавить(НСтр("ru='Продолжить перезаполнение?'"));
	
	Результат.ТекстВопроса = СтрСоединить(ЧастиВопроса, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
