#Область IMDEV_9434

#Область СлужебныеПроцедурыИФункции

// IMDEV-9434. Групповое перезаполнение СЧА с контролем допустимого уровня риска.
//
// При включенном флаге контроля риска отбор списка применяется только к расчетам СЧА/РСА.
// Макет "КонтрольДопустимогоУровняРиска" не вызывается: документы контроля берутся по договорам
// и дням уже отобранных расчетов (ТаблицаРискаПоДокументамСЧА модуля менеджера обработки).
//
// Параметры:
//  Макет - Строка - имя макета СКД обработки
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - документы для перезаполнения
//
&НаСервере
&ИзменениеИКонтроль("ПолучитьМассивДокументовДляПерепроведения")
Функция IM9434Риск_ПолучитьМассивДокументовДляПерепроведения(Макет)
	
	МассивДокументовДляПерепроведения = Новый Массив;
#Вставка
	Если Макет = "КонтрольДопустимогоУровняРиска" Тогда
		Возврат МассивДокументовДляПерепроведения;
	КонецЕсли;
#КонецВставки
	
	//Выгрузим результат отчета СКД в Таблицу Значений
	Обработка = РеквизитФормыВЗначение("Объект");
	СхемаКомпоновкиДанных = Обработка.ПолучитьМакет(Макет);
	НастройкиКомпоновщика = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;

    Если Объект.ВидДокумента = "Установка котировок ц/б (по пулам)" Тогда
		ОбрабатываемыйСписок = СписокУстановкаКотировокЦБПоПулам;
	Иначе	
	    ОбрабатываемыйСписок = СписокДокументов;
	КонецЕсли;
	
	Для каждого ТекЭлемент Из ОбрабатываемыйСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл

		 Если ТипЗнч(ТекЭлемент) = Тип("ОтборКомпоновкиДанных") Тогда
			 
			Для каждого ЭлементОтбора из ТекЭлемент.Элементы Цикл  
				Если не ЭлементОтбора.Использование тогда Продолжить; КонецЕсли;
				ДобавитьЭлементОтбора(НастройкиКомпоновщика.Отбор.Элементы, ЭлементОтбора);
			КонецЦикла;
		    Прервать;
		 КонецЕсли;

	КонецЦикла;
	
	//Для каждого ТекОтбор Из СписокДокументов.Отбор.Элементы Цикл
	//	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//	ЗаполнитьЗначенияСвойств(Отбор, ТекОтбор);
	//КонецЦикла;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновщика, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных; 
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ДанныеТЗ = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ДанныеТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Если ДанныеТЗ.Количество() > 0 Тогда
		МассивДокументовДляПерепроведения = ДанныеТЗ.ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат  МассивДокументовДляПерепроведения;
	
КонецФункции

#Область ПроверкаПолейОтбора

// Описание: Проверяет, есть ли у элемента отбора поле, которого нет в доступных полях текущего списка.
// Для группы проверяются все подчиненные элементы.
//
// Параметры:
//  ЭлементОтбора - ЭлементОтбораКомпоновкиДанных, ГруппаЭлементовОтбораКомпоновкиДанных - элемент отбора
//  ДоступныеПоля - ДоступныеПоляКомпоновкиДанных - доступные поля отбора текущего списка
//
// Возвращаемое значение:
//  Булево - Истина, если поле элемента или подчиненного элемента не найдено
//
&НаСервереБезКонтекста
Функция ЕстьНедоступноеПолеОтбора(ЭлементОтбора, ДоступныеПоля)

	Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
		Для Каждого ПодчиненныйЭлемент Из ЭлементОтбора.Элементы Цикл
			Если ЕстьНедоступноеПолеОтбора(ПодчиненныйЭлемент, ДоступныеПоля) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(ЭлементОтбора.ЛевоеЗначение) <> Тип("ПолеКомпоновкиДанных") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ДоступныеПоля.НайтиПоле(ЭлементОтбора.ЛевоеЗначение) = Неопределено;

КонецФункции

// Описание: Удаляет из коллекции элементы отбора с полями, которых нет в доступных полях текущего списка.
// Группа удаляется целиком, если в ней есть такое поле: условие группы без части строк меняет смысл.
//
// Параметры:
//  ЭлементыОтбора - КоллекцияЭлементовОтбораКомпоновкиДанных - элементы отбора загружаемой копии настроек
//  ДоступныеПоля - ДоступныеПоляКомпоновкиДанных - доступные поля отбора текущего списка
//
&НаСервереБезКонтекста
Процедура УдалитьНедоступныеЭлементыОтбора(ЭлементыОтбора, ДоступныеПоля)

	Удаляемые = Новый Массив;
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если ЕстьНедоступноеПолеОтбора(ЭлементОтбора, ДоступныеПоля) Тогда
			Удаляемые.Добавить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементОтбора Из Удаляемые Цикл
		ЭлементыОтбора.Удалить(ЭлементОтбора);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОтборПоВидуДокумента

// Описание: Выключает автосохранение настроек списка: платформа писала бы одну общую запись для всех видов
// документа, и открытие на "Погашение облигаций" затирало бы отбор "Расчет СЧА/РСА". Отбор хранится по видам.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
&Перед("ПриСозданииНаСервере")
Процедура IM9434Риск_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СписокДокументов.АвтоматическоеСохранениеПользовательскихНастроек = Ложь;

КонецПроцедуры

// Описание: Подставляет в список сохраненный отбор вида документа, с которым открывается форма.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
&После("ПриСозданииНаСервере")
Процедура IM9434Риск_ПослеСозданияНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьОтборСпискаПоВидуДокумента("", Объект.ВидДокумента);

КонецПроцедуры

// Описание: Записывает отбор текущего вида документа до того, как типовой код сменит основную таблицу списка.
//
// Параметры:
//  ВыбранноеЗначение - Строка - выбранный вид документа
//
&НаСервере
&Перед("ВидДокументаОбработкаВыбораНаСервере")
Процедура IM9434Риск_ПередВыборомВида(ВыбранноеЗначение)

	УстановитьОтборСпискаПоВидуДокумента(Объект.ВидДокумента, "");

КонецПроцедуры

// Описание: Подставляет сохраненный отбор выбранного вида документа после смены основной таблицы списка.
//
// Параметры:
//  ВыбранноеЗначение - Строка - выбранный вид документа
//
&НаСервере
&После("ВидДокументаОбработкаВыбораНаСервере")
Процедура IM9434Риск_ПослеВыбораВида(ВыбранноеЗначение)

	УстановитьОтборСпискаПоВидуДокумента("", ВыбранноеЗначение);

КонецПроцедуры

// Описание: Записывает отбор при закрытии формы. При завершении всего сеанса сервер не вызывается.
//
// Параметры:
//  ЗавершениеРаботы - Булево - Истина, если закрывается приложение
//
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	УстановитьОтборСпискаПоВидуДокумента(Объект.ВидДокумента, "");

КонецПроцедуры

// Описание: Хранит отбор списка отдельно по виду документа.
// Пустой ВидСохранить или ВидЗагрузить пропускает соответствующую часть.
// Если своей записи вида еще нет, один раз берется прежний общий отбор списка.
// Строки с полем чужого документа не подставляются (иначе платформа пишет "поле не найдено"),
// остальные строки отбора подставляются.
//
// Параметры:
//  ВидСохранить - Строка - вид, чей текущий отбор записать
//  ВидЗагрузить - Строка - вид, чей отбор подставить в список
//
&НаСервере
Процедура УстановитьОтборСпискаПоВидуДокумента(ВидСохранить, ВидЗагрузить)

	КлючОбъекта = ИмяФормы + ".СписокДокументов/IM9434РискОтборПоВиду";

	Если ЗначениеЗаполнено(ВидСохранить) Тогда
		ОбщегоНазначения.ХранилищеСистемныхНастроекСохранить(
			КлючОбъекта,
			КлючВидаДокумента(ВидСохранить),
			СписокДокументов.КомпоновщикНастроек.ПользовательскиеНастройки);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВидЗагрузить) Тогда
		Возврат;
	КонецЕсли;

	КлючВида = КлючВидаДокумента(ВидЗагрузить);
	СохраненныйОтбор = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(КлючОбъекта, КлючВида);
	Если ТипЗнч(СохраненныйОтбор) <> Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		СохраненныйОтбор = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(
			ИмяФормы + ".СписокДокументов/ТекущиеПользовательскиеНастройки");
		Если ТипЗнч(СохраненныйОтбор) <> Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
			Возврат;
		КонецЕсли;
		ОбщегоНазначения.ХранилищеСистемныхНастроекСохранить(КлючОбъекта, КлючВида, СохраненныйОтбор);
	КонецЕсли;

	// Строки с полями, которых нет у текущего списка, убираются только из загружаемой копии:
	// остальной отбор подставляется, запись в хранилище не меняется.
	ДоступныеПоля = СписокДокументов.КомпоновщикНастроек.Настройки.ДоступныеПоляОтбора;
	Для Каждого ТекЭлемент Из СохраненныйОтбор.Элементы Цикл
		Если ТипЗнч(ТекЭлемент) = Тип("ОтборКомпоновкиДанных") Тогда
			УдалитьНедоступныеЭлементыОтбора(ТекЭлемент.Элементы, ДоступныеПоля);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	СписокДокументов.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(СохраненныйОтбор);

КонецПроцедуры

// Описание: Строит ключ настроек вида документа для хранилища: без пробелов, "/" заменен на "_".
//
// Параметры:
//  ВидДокумента - Строка - значение реквизита ВидДокумента обработки, например "Расчет СЧА/РСА"
//
// Возвращаемое значение:
//  Строка - ключ настроек, например "РасчетСЧА_РСА"
//
&НаСервереБезКонтекста
Функция КлючВидаДокумента(ВидДокумента)

	Возврат СтрЗаменить(СтрЗаменить(ВидДокумента, "/", "_"), " ", "");

КонецФункции

#КонецОбласти
#КонецОбласти

#КонецОбласти
