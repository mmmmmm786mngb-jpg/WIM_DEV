#Область IMDEV_9434

#Область СлужебныеПроцедурыИФункции

// IMDEV-9434. Групповое перезаполнение СЧА с контролем допустимого уровня риска.
//
// Не передает в макет "КонтрольДопустимогоУровняРиска" отбор списка, в котором есть поля, отсутствующие
// у документа контроля риска (например Ссылка.РасчетСЧА.Показатель - отбор по бумаге в табличной части СЧА).
// Типовая функция в этом случае падает с ошибкой "Поле не найдено". Вставка в начале функции возвращает пустой массив:
// документы риска фоновое задание берет по договорам и дням отобранных расчетов СЧА/РСА
// (ТаблицаРискаПоДокументамСЧА модуля менеджера обработки). Для остальных макетов и для отбора только
// по общим полям (дата, договор и его реквизиты) выполняется типовая функция без изменений.
//
// Параметры:
//  Макет - Строка - имя макета СКД обработки
//
// Возвращаемое значение:
//  Массив из ДокументСсылка - документы для перезаполнения
//
&НаСервере
&ИзменениеИКонтроль("ПолучитьМассивДокументовДляПерепроведения")
Функция IM9434Риск_ПолучитьМассивДокументовДляПерепроведения(Макет)
	
	МассивДокументовДляПерепроведения = Новый Массив;
#Вставка
	Если Макет = "КонтрольДопустимогоУровняРиска" И ЕстьПоляОтбораНедоступныеВМакете(Макет) Тогда
		Возврат МассивДокументовДляПерепроведения;
	КонецЕсли;
#КонецВставки
	
	//Выгрузим результат отчета СКД в Таблицу Значений
	Обработка = РеквизитФормыВЗначение("Объект");
	СхемаКомпоновкиДанных = Обработка.ПолучитьМакет(Макет);
	НастройкиКомпоновщика = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;

    Если Объект.ВидДокумента = "Установка котировок ц/б (по пулам)" Тогда
		ОбрабатываемыйСписок = СписокУстановкаКотировокЦБПоПулам;
	Иначе	
	    ОбрабатываемыйСписок = СписокДокументов;
	КонецЕсли;
	
	Для каждого ТекЭлемент Из ОбрабатываемыйСписок.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл

		 Если ТипЗнч(ТекЭлемент) = Тип("ОтборКомпоновкиДанных") Тогда
			 
			Для каждого ЭлементОтбора из ТекЭлемент.Элементы Цикл  
				Если не ЭлементОтбора.Использование тогда Продолжить; КонецЕсли;
				ДобавитьЭлементОтбора(НастройкиКомпоновщика.Отбор.Элементы, ЭлементОтбора);
			КонецЦикла;
		    Прервать;
		 КонецЕсли;

	КонецЦикла;
	
	//Для каждого ТекОтбор Из СписокДокументов.Отбор.Элементы Цикл
	//	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//	ЗаполнитьЗначенияСвойств(Отбор, ТекОтбор);
	//КонецЦикла;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновщика, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных; 
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ДанныеТЗ = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ДанныеТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Если ДанныеТЗ.Количество() > 0 Тогда
		МассивДокументовДляПерепроведения = ДанныеТЗ.ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат  МассивДокументовДляПерепроведения;
	
КонецФункции

#Область ПроверкаОтбораДляМакетаРиска

// Проверяет, все ли поля отбора списка документов, которые типовая функция перенесет в макет, есть среди
// доступных полей отбора этого макета. Обход повторяет перенос в ПолучитьМассивДокументовДляПерепроведения:
// включенные элементы верхнего уровня пользовательского отбора, группы целиком. Макет риска вызывается
// только для вида "Расчет СЧА/РСА", поэтому проверяется список СписокДокументов.
//
// Параметры:
//  Макет - Строка - имя макета СКД обработки
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы одного поля отбора в макете нет
//
&НаСервере
Функция ЕстьПоляОтбораНедоступныеВМакете(Макет)

	СхемаКомпоновкиДанных = Обработки.ГрупповоеПерезаполнениеДокументов.ПолучитьМакет(Макет);
	КомпоновщикНастроекМакета = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроекМакета.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	ДоступныеПоля = КомпоновщикНастроекМакета.Настройки.ДоступныеПоляОтбора;

	Для Каждого ТекЭлемент Из СписокДокументов.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл

		Если ТипЗнч(ТекЭлемент) <> Тип("ОтборКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ЭлементОтбора Из ТекЭлемент.Элементы Цикл
			Если ЭлементОтбора.Использование И ЕстьНедоступноеПолеОтбора(ЭлементОтбора, ДоступныеПоля) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;

		Прервать;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет элемент отбора и, для группы, все подчиненные элементы: типовая ДобавитьЭлементОтбора
// переносит группу в макет целиком, вместе с выключенными элементами.
//
// Параметры:
//  ЭлементОтбора - ЭлементОтбораКомпоновкиДанных, ГруппаЭлементовОтбораКомпоновкиДанных - элемент отбора
//  ДоступныеПоля - ДоступныеПоляКомпоновкиДанных - доступные поля отбора макета
//
// Возвращаемое значение:
//  Булево - Истина, если поле элемента или подчиненного элемента в макете не найдено
//
&НаСервереБезКонтекста
Функция ЕстьНедоступноеПолеОтбора(ЭлементОтбора, ДоступныеПоля)

	Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
		Для Каждого ПодчиненныйЭлемент Из ЭлементОтбора.Элементы Цикл
			Если ЕстьНедоступноеПолеОтбора(ПодчиненныйЭлемент, ДоступныеПоля) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(ЭлементОтбора.ЛевоеЗначение) <> Тип("ПолеКомпоновкиДанных") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ДоступныеПоля.НайтиПоле(ЭлементОтбора.ЛевоеЗначение) = Неопределено;

КонецФункции

#КонецОбласти

#Область ОтборПоВидуДокумента

// Отключает общую запись отбора списка и один раз копирует ее в отдельные записи по видам документов.
//
&НаСервере
&Перед("ПриСозданииНаСервере")
Процедура IM9434Риск_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СписокДокументов.АвтоматическоеСохранениеПользовательскихНастроек = Ложь;
	IM9434Риск_ПеренестиОбщийОтборВОтборыПоВидам();

КонецПроцедуры

// После типового открытия подставляет отбор вида, на котором форма создается.
//
&НаСервере
&После("ПриСозданииНаСервере")
Процедура IM9434Риск_ПослеСозданияНаСервере(Отказ, СтандартнаяОбработка)

	IM9434Риск_ЗагрузитьОтборВида(Объект.ВидДокумента);

КонецПроцедуры

// Перед сменой вида записывает отбор текущего списка в его собственную запись.
//
&НаСервере
&Перед("ВидДокументаОбработкаВыбораНаСервере")
Процедура IM9434Риск_ПередВыборомВида(ВыбранноеЗначение)

	IM9434Риск_СохранитьОтборВида(Объект.ВидДокумента);

КонецПроцедуры

// После смены основной таблицы списка читает отбор уже выбранного вида.
//
&НаСервере
&После("ВидДокументаОбработкаВыбораНаСервере")
Процедура IM9434Риск_ПослеВыбораВида(ВыбранноеЗначение)

	IM9434Риск_ЗагрузитьОтборВида(ВыбранноеЗначение);

КонецПроцедуры

// Описание: Записывает отбор текущего вида при закрытии формы пользователем.
// При завершении работы сеанса серверный вызов не выполняется.
//
// Параметры:
//  ЗавершениеРаботы - Булево - Истина, если закрывается все приложение
//
&НаКлиенте
Процедура IM9434Риск_ПриЗакрытии(ЗавершениеРаботы)

	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	IM9434Риск_СохранитьОтборВида(Объект.ВидДокумента);

КонецПроцедуры

// Описание: Копирует сохраненный общий отбор списка в запись каждого вида документа.
// Повторно не выполняется. Общая запись платформы не удаляется.
//
&НаСервере
Процедура IM9434Риск_ПеренестиОбщийОтборВОтборыПоВидам()

	Если ХранилищеСистемныхНастроек.Загрузить(IM9434Риск_КлючОтборовПоВидам(), "ПереносВыполнен") = Истина Тогда
		Возврат;
	КонецЕсли;

	ОбщийОтбор = IM9434Риск_ПрочитатьОбщийОтборСписка();
	Если ТипЗнч(ОбщийОтбор) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		Для Каждого ВидДокумента Из IM9434Риск_ВидыДокументовОтбора() Цикл
			ХранилищеСистемныхНастроек.Сохранить(
				IM9434Риск_КлючОтборовПоВидам(),
				IM9434Риск_ИдентификаторВида(ВидДокумента),
				ОбщийОтбор);
		КонецЦикла;
	КонецЕсли;

	ХранилищеСистемныхНастроек.Сохранить(IM9434Риск_КлючОтборовПоВидам(), "ПереносВыполнен", Истина);

КонецПроцедуры

// Описание: Записывает текущий пользовательский отбор списка под указанный вид документа.
//
// Параметры:
//  ВидДокумента - Строка - значение поля "Вид документа" на форме
//
&НаСервере
Процедура IM9434Риск_СохранитьОтборВида(ВидДокумента)

	Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
		Возврат;
	КонецЕсли;

	ХранилищеСистемныхНастроек.Сохранить(
		IM9434Риск_КлючОтборовПоВидам(),
		IM9434Риск_ИдентификаторВида(ВидДокумента),
		СписокДокументов.КомпоновщикНастроек.ПользовательскиеНастройки);

КонецПроцедуры

// Описание: Подставляет в список ранее записанный отбор вида документа.
//
// Параметры:
//  ВидДокумента - Строка - значение поля "Вид документа" на форме
//
&НаСервере
Процедура IM9434Риск_ЗагрузитьОтборВида(ВидДокумента)

	Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
		Возврат;
	КонецЕсли;

	СохраненныйОтбор = ХранилищеСистемныхНастроек.Загрузить(
		IM9434Риск_КлючОтборовПоВидам(),
		IM9434Риск_ИдентификаторВида(ВидДокумента));
	Если ТипЗнч(СохраненныйОтбор) <> Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;

	// Загрузка отбора с полем чужого документа показывает диалог "поле не найдено" и не меняет список.
	// Такой отбор остается в записи своего вида и подставляется после переключения на него.
	Если IM9434Риск_ОтборНедоступенВТекущемСписке(СохраненныйОтбор) Тогда
		Возврат;
	КонецЕсли;

	СписокДокументов.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(СохраненныйОтбор);

КонецПроцедуры

// Описание: Проверяет, есть ли в сохраненном отборе поле, которого нет у текущего списка.
//
// Параметры:
//  ПользовательскиеНастройки - ПользовательскиеНастройкиКомпоновкиДанных - отбор выбранного вида
//
// Возвращаемое значение:
//  Булево - Истина, если отбор нельзя подставить в текущий список
//
&НаСервере
Функция IM9434Риск_ОтборНедоступенВТекущемСписке(ПользовательскиеНастройки)

	ДоступныеПоля = СписокДокументов.КомпоновщикНастроек.Настройки.ДоступныеПоляОтбора;

	Для Каждого ТекЭлемент Из ПользовательскиеНастройки.Элементы Цикл

		Если ТипЗнч(ТекЭлемент) <> Тип("ОтборКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ЭлементОтбора Из ТекЭлемент.Элементы Цикл
			Если ЕстьНедоступноеПолеОтбора(ЭлементОтбора, ДоступныеПоля) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;

		Прервать;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Описание: Читает общий отбор списка, который платформа хранит одной записью на все виды.
//
// Возвращаемое значение:
//  ПользовательскиеНастройкиКомпоновкиДанных, Неопределено - найденный отбор или пусто
//
&НаСервере
Функция IM9434Риск_ПрочитатьОбщийОтборСписка()

	КлючФормы = ИмяФормы + ".СписокДокументов/ТекущиеПользовательскиеНастройки";
	ОбщийОтбор = ХранилищеСистемныхНастроек.Загрузить(КлючФормы);
	Если ТипЗнч(ОбщийОтбор) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		Возврат ОбщийОтбор;
	КонецЕсли;

	ОбщийОтбор = ХранилищеСистемныхНастроек.Загрузить(
		ИмяФормы + ".СписокДокументов",
		"ТекущиеПользовательскиеНастройки");
	Если ТипЗнч(ОбщийОтбор) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		Возврат ОбщийОтбор;
	КонецЕсли;

	Выборка = ХранилищеСистемныхНастроек.Выбрать(Новый Структура("Пользователь", ИмяПользователя()));
	Пока Выборка.Следующий() Цикл
		Если СтрНайти(Выборка.КлючОбъекта, "ГрупповоеПерезаполнениеДокументов") = 0
			Или СтрНайти(Выборка.КлючОбъекта, "ТекущиеПользовательскиеНастройки") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Выборка.Настройки) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
			Возврат Выборка.Настройки;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Описание: Возвращает виды документов, для которых у списка хранится свой отбор.
//
// Возвращаемое значение:
//  Массив из Строка - те же значения, что в списке выбора формы
//
&НаСервере
Функция IM9434Риск_ВидыДокументовОтбора()

	Виды = Новый Массив;
	Виды.Добавить("Начисление %% по банковским счетам");
	Виды.Добавить("Начисление купонного дохода");
	Виды.Добавить("Погашение облигаций");
	Виды.Добавить("Погашение НКД");
	Виды.Добавить("Переоценка активов");
	Виды.Добавить("Переоценка взаиморасчетов");
	Виды.Добавить("Переоценка денежных средств");
	Виды.Добавить("Расчет СЧА/РСА");
	Виды.Добавить("Реформация баланса");
	Виды.Добавить("Установка котировок ц/б");
	Виды.Добавить("Установка котировок ц/б (по пулам)");
	Возврат Виды;

КонецФункции

// Описание: Ключ хранилища, под которым лежат отборы по видам. Общая запись платформы не используется.
//
// Возвращаемое значение:
//  Строка - ключ объекта системных настроек
//
&НаСервере
Функция IM9434Риск_КлючОтборовПоВидам()

	Возврат ИмяФормы + ".СписокДокументов/IM9434РискОтборПоВиду";

КонецФункции

// Описание: Превращает подпись вида документа в ключ настройки без символа "/".
//
// Параметры:
//  ВидДокумента - Строка - подпись вида на форме
//
// Возвращаемое значение:
//  Строка - ключ настройки хранилища
//
&НаСервере
Функция IM9434Риск_ИдентификаторВида(ВидДокумента)

	Возврат СтрЗаменить(СтрЗаменить(ВидДокумента, "/", "_"), " ", "");

КонецФункции

#КонецОбласти
#КонецОбласти

#КонецОбласти
