{
  "title": "Просмотр сохраненных настроек списков",
  "events": { "OnCreateAtServer": "ПриСозданииНаСервере" },
  "elements": [
    { "autoCmdBar": "ФормаКоманднаяПанель", "children": [
      { "button": "Показать", "command": "Показать", "defaultButton": true }
    ]},
    { "group": "horizontalIfPossible", "name": "ГруппаОтбор", "children": [
      { "input": "ПользовательИБ", "path": "ПользовательИБ", "title": "Пользователь ИБ",
        "dropListButton": true, "width": 30, "inputHint": "Имя пользователя информационной базы" },
      { "input": "ПодстрокаКлюча", "path": "ПодстрокаКлюча", "title": "Ключ объекта содержит",
        "width": 40, "clearButton": true, "inputHint": "Пусто - все ключи" }
    ]},
    { "group": "horizontalIfPossible", "name": "ГруппаФлаги", "children": [
      { "check": "ВсеПользователи", "path": "ВсеПользователи",
        "title": "Все пользователи (только по подстроке ключа)" },
      { "check": "ПоказыватьСодержимое", "path": "ПоказыватьСодержимое",
        "title": "Показывать содержимое настроек" }
    ]},
    { "pages": "Страницы", "pagesRepresentation": "TabsOnTop", "children": [
      { "page": "СтраницаСводка", "title": "Сводка", "group": "vertical", "children": [
        { "spreadsheet": "Результат", "path": "Результат", "titleLocation": "none",
          "output": "Enable", "protection": false, "edit": false,
          "horizontalStretch": true, "verticalStretch": true }
      ]},
      { "page": "СтраницаТекст", "title": "Полный текст (XML)", "group": "vertical", "children": [
        { "input": "ПолныйТекст", "path": "ПолныйТекст", "titleLocation": "none", "multiLine": true,
          "horizontalStretch": true, "verticalStretch": true, "autoMaxWidth": false }
      ]}
    ]}
  ],
  "attributes": [
    { "name": "Объект", "type": "ExternalDataProcessorObject.ПросмотрНастроекСписков", "main": true },
    { "name": "ПользовательИБ", "type": "string(100)" },
    { "name": "ПодстрокаКлюча", "type": "string(200)" },
    { "name": "ВсеПользователи", "type": "boolean" },
    { "name": "ПоказыватьСодержимое", "type": "boolean" },
    { "name": "Результат", "type": "mxl:SpreadsheetDocument" },
    { "name": "ПолныйТекст", "type": "string" }
  ],
  "commands": [
    { "name": "Показать", "action": "ПоказатьВыполнить", "title": "Показать настройки", "shortcut": "Ctrl+Enter" }
  ]
}
