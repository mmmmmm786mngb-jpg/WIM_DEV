// Обработка только читает стандартные хранилища настроек и ничего в них не записывает.

#Область ОбработчикиСобытийФормы

// Заполняет значения отбора по умолчанию и список пользователей информационной базы.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПодстрокаКлюча       = "ГрупповоеПерезаполнениеДокументов";
	ПоказыватьСодержимое = Истина;
	ПользовательИБ       = ИмяПользователя();

	ЗаполнитьСписокПользователей();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Проверяет отбор и выводит найденные записи хранилищ настроек.
//
// Параметры:
//  Команда - КомандаФормы - команда "Показать"
//
&НаКлиенте
Процедура ПоказатьВыполнить(Команда)

	Если Не ВсеПользователи И Не ЗначениеЗаполнено(ПользовательИБ) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите пользователя ИБ или включите флажок ""Все пользователи"".'"));
		Возврат;
	КонецЕсли;

	Если ВсеПользователи И Не ЗначениеЗаполнено(ПодстрокаКлюча) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для всех пользователей укажите подстроку ключа объекта.'"));
		Возврат;
	КонецЕсли;

	ПоказатьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список выбора поля "Пользователь ИБ" именами пользователей информационной базы.
// Без права "Администрирование" список пользователей недоступен, в список попадает только текущий пользователь.
//
&НаСервере
Процедура ЗаполнитьСписокПользователей()

	СписокВыбораПользователей = Элементы.ПользовательИБ.СписокВыбора;
	СписокВыбораПользователей.Очистить();

	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		СписокВыбораПользователей.Добавить(ИмяПользователя());
		Возврат;
	КонецЕсли;

	Для Каждого ОписаниеПользователя Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Представление = ОписаниеПользователя.Имя;
		Если ЗначениеЗаполнено(ОписаниеПользователя.ПолноеИмя)
			И ОписаниеПользователя.ПолноеИмя <> ОписаниеПользователя.Имя Тогда
			Представление = Представление + " (" + ОписаниеПользователя.ПолноеИмя + ")";
		КонецЕсли;
		СписокВыбораПользователей.Добавить(ОписаниеПользователя.Имя, Представление);
	КонецЦикла;

	СписокВыбораПользователей.СортироватьПоПредставлению();

КонецПроцедуры

// Собирает записи всех стандартных хранилищ настроек по отбору формы и выводит их
// в табличный документ "Результат" и в текст "ПолныйТекст".
//
&НаСервере
Процедура ПоказатьНаСервере()

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПользовательИБ",       СокрЛП(ПользовательИБ));
	ПараметрыОтбора.Вставить("ВсеПользователи",      ВсеПользователи);
	ПараметрыОтбора.Вставить("ПодстрокаКлюча",       СокрЛП(ПодстрокаКлюча));
	ПараметрыОтбора.Вставить("ПоказыватьСодержимое", ПоказыватьСодержимое);

	Записи = НоваяТаблицаЗаписей();
	Для Каждого ОписаниеХранилища Из ОписанияХранилищ() Цикл
		ДобавитьЗаписиХранилища(Записи, ОписаниеХранилища, ПараметрыОтбора);
	КонецЦикла;
	Записи.Сортировать("Хранилище, Пользователь, КлючОбъекта, КлючНастроек");

	ВывестиРезультат(Записи, ПараметрыОтбора);

КонецПроцедуры

// Описывает стандартные хранилища настроек, которые просматривает обработка.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя      - Строка - представление хранилища в отчете
//   * Менеджер - СтандартноеХранилищеНастроекМенеджер, ХранилищеНастроекМенеджер - менеджер хранилища
//
&НаСервереБезКонтекста
Функция ОписанияХранилищ()

	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("Имя, Менеджер",
		"Настройки динамических списков", ХранилищеПользовательскихНастроекДинамическихСписков));
	Результат.Добавить(Новый Структура("Имя, Менеджер", "Системные настройки", ХранилищеСистемныхНастроек));
	Результат.Добавить(Новый Структура("Имя, Менеджер", "Настройки данных форм", ХранилищеНастроекДанныхФорм));
	Результат.Добавить(Новый Структура("Имя, Менеджер", "Общие настройки", ХранилищеОбщихНастроек));
	Результат.Добавить(Новый Структура("Имя, Менеджер",
		"Пользовательские настройки отчетов", ХранилищеПользовательскихНастроекОтчетов));
	Возврат Результат;

КонецФункции

// Создает пустую таблицу найденных записей хранилищ.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Хранилище, Пользователь, КлючОбъекта, КлючНастроек, Представление,
//                    ДатаИзменения, ТипНастроек, Расшифровка, XML
//
&НаСервереБезКонтекста
Функция НоваяТаблицаЗаписей()

	ТипСтрока = Новый ОписаниеТипов("Строка");

	Записи = Новый ТаблицаЗначений;
	Записи.Колонки.Добавить("Хранилище",     ТипСтрока);
	Записи.Колонки.Добавить("Пользователь",  ТипСтрока);
	Записи.Колонки.Добавить("КлючОбъекта",   ТипСтрока);
	Записи.Колонки.Добавить("КлючНастроек",  ТипСтрока);
	Записи.Колонки.Добавить("Представление", ТипСтрока);
	Записи.Колонки.Добавить("ДатаИзменения");
	Записи.Колонки.Добавить("ТипНастроек",   ТипСтрока);
	Записи.Колонки.Добавить("Расшифровка",   ТипСтрока);
	Записи.Колонки.Добавить("XML",           ТипСтрока);
	Возврат Записи;

КонецФункции

// Добавляет в таблицу записи одного хранилища, подходящие под отбор. Хранилище только читается.
//
// Параметры:
//  Записи - ТаблицаЗначений - см. НоваяТаблицаЗаписей
//  ОписаниеХранилища - Структура - элемент массива из ОписанияХранилищ
//  ПараметрыОтбора - Структура - ПользовательИБ, ВсеПользователи, ПодстрокаКлюча, ПоказыватьСодержимое
//
&НаСервереБезКонтекста
Процедура ДобавитьЗаписиХранилища(Записи, ОписаниеХранилища, ПараметрыОтбора)

	Если ТипЗнч(ОписаниеХранилища.Менеджер) <> Тип("СтандартноеХранилищеНастроекМенеджер") Тогда
		НоваяЗапись = Записи.Добавить();
		НоваяЗапись.Хранилище   = ОписаниеХранилища.Имя;
		НоваяЗапись.Расшифровка = НСтр("ru = 'В конфигурации задано свое хранилище, обработка его не просматривает: '")
			+ Строка(ТипЗнч(ОписаниеХранилища.Менеджер));
		Возврат;
	КонецЕсли;

	Отбор = Новый Структура;
	Если Не ПараметрыОтбора.ВсеПользователи Тогда
		Отбор.Вставить("Пользователь", ПараметрыОтбора.ПользовательИБ);
	КонецЕсли;
	ПодстрокаВРег = ВРег(ПараметрыОтбора.ПодстрокаКлюча);

	Выборка = ОписаниеХранилища.Менеджер.Выбрать(Отбор);
	Пока Выборка.Следующий() Цикл

		Если ЗначениеЗаполнено(ПодстрокаВРег)
			И СтрНайти(ВРег(Выборка.КлючОбъекта + " " + Выборка.КлючНастроек), ПодстрокаВРег) = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяЗапись = Записи.Добавить();
		НоваяЗапись.Хранилище     = ОписаниеХранилища.Имя;
		НоваяЗапись.Пользователь  = Выборка.Пользователь;
		НоваяЗапись.КлючОбъекта   = Выборка.КлючОбъекта;
		НоваяЗапись.КлючНастроек  = Выборка.КлючНастроек;
		НоваяЗапись.Представление = Выборка.Представление;
		НоваяЗапись.ДатаИзменения = Выборка.ДатаИзменения;

		Если ПараметрыОтбора.ПоказыватьСодержимое Тогда
			ЗаполнитьСодержимоеЗаписи(НоваяЗапись, Выборка);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Заполняет тип, читаемую расшифровку и XML сохраненного значения настроек.
//
// Параметры:
//  Запись - СтрокаТаблицыЗначений - строка таблицы НоваяТаблицаЗаписей
//  Выборка - СтандартноеХранилищеНастроекВыборка - текущая запись хранилища
//
&НаСервереБезКонтекста
Процедура ЗаполнитьСодержимоеЗаписи(Запись, Выборка)

	// Значение может содержать типы, которых в текущей конфигурации нет (например объекты
	// отключенного расширения). Тогда платформа не читает его, а запись выводится с текстом ошибки.
	Попытка
		Значение = Выборка.Настройки;
	Исключение
		Запись.ТипНастроек = НСтр("ru = 'Ошибка чтения'");
		Запись.Расшифровка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Запись.ТипНастроек = Строка(ТипЗнч(Значение));

	Строки = Новый Массив;
	ДобавитьОписаниеЗначения(Строки, Значение, "");
	Запись.Расшифровка = СтрСоединить(Строки, Символы.ПС);
	Запись.XML         = ЗначениеВXML(Значение);

КонецПроцедуры

// Добавляет читаемое описание значения настроек: отборы, порядок, вложенные структуры.
//
// Параметры:
//  Строки - Массив из Строка - дополняется строками описания
//  Значение - Произвольный - значение настроек или его часть
//  Отступ - Строка - отступ строк текущего уровня
//
&НаСервереБезКонтекста
Процедура ДобавитьОписаниеЗначения(Строки, Значение, Отступ)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
		Для Каждого ЭлементНастроек Из Значение.Элементы Цикл
			ДобавитьОписаниеЭлементаНастроек(Строки, ЭлементНастроек, Отступ);
		КонецЦикла;

	ИначеЕсли ТипЗначения = Тип("НастройкиКомпоновкиДанных") Тогда
		Строки.Добавить(Отступ + НСтр("ru = 'Отбор:'"));
		ДобавитьОписаниеОтбора(Строки, Значение.Отбор.Элементы, Отступ + "  ");

	ИначеЕсли ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура")
		Или ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого КлючИЗначение Из Значение Цикл
			Строки.Добавить(Отступ + ПредставлениеЗначения(КлючИЗначение.Ключ) + ": "
				+ ПредставлениеЗначения(КлючИЗначение.Значение));
			Если ЭтоСоставноеЗначение(КлючИЗначение.Значение) Тогда
				ДобавитьОписаниеЗначения(Строки, КлючИЗначение.Значение, Отступ + "  ");
			КонецЕсли;
		КонецЦикла;

	Иначе
		Строки.Добавить(Отступ + ПредставлениеЗначения(Значение));
	КонецЕсли;

КонецПроцедуры

// Добавляет описание одного элемента пользовательских настроек компоновки данных.
//
// Параметры:
//  Строки - Массив из Строка - дополняется строками описания
//  ЭлементНастроек - Произвольный - элемент коллекции ПользовательскиеНастройкиКомпоновкиДанных.Элементы
//  Отступ - Строка - отступ строк текущего уровня
//
&НаСервереБезКонтекста
Процедура ДобавитьОписаниеЭлементаНастроек(Строки, ЭлементНастроек, Отступ)

	ТипЭлемента = ТипЗнч(ЭлементНастроек);
	Строки.Добавить(Отступ + Строка(ТипЭлемента) + ", ИД "
		+ ЭлементНастроек.ИдентификаторПользовательскойНастройки);

	Если ТипЭлемента = Тип("ОтборКомпоновкиДанных") Тогда
		ДобавитьОписаниеОтбора(Строки, ЭлементНастроек.Элементы, Отступ + "  ");

	ИначеЕсли ТипЭлемента = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
		Строки.Добавить(Отступ + "  " + ОписаниеЭлементаОтбора(ЭлементНастроек));

	ИначеЕсли ТипЭлемента = Тип("ПорядокКомпоновкиДанных") Тогда
		Для Каждого ЭлементПорядка Из ЭлементНастроек.Элементы Цикл
			Если ТипЗнч(ЭлементПорядка) = Тип("ЭлементПорядкаКомпоновкиДанных") Тогда
				Строки.Добавить(Отступ + "  " + ПометкаИспользования(ЭлементПорядка.Использование)
					+ Строка(ЭлементПорядка.Поле) + " " + Строка(ЭлементПорядка.ТипУпорядочивания));
			Иначе
				Строки.Добавить(Отступ + "  " + Строка(ТипЗнч(ЭлементПорядка)));
			КонецЕсли;
		КонецЦикла;

	Иначе
		Строки.Добавить(Отступ + "  " + НСтр("ru = '(содержимое на закладке ""Полный текст (XML)"")'"));
	КонецЕсли;

КонецПроцедуры

// Добавляет описание элементов отбора с учетом вложенных групп.
//
// Параметры:
//  Строки - Массив из Строка - дополняется строками описания
//  ЭлементыОтбора - КоллекцияЭлементовОтбораКомпоновкиДанных - элементы отбора или группы
//  Отступ - Строка - отступ строк текущего уровня
//
&НаСервереБезКонтекста
Процедура ДобавитьОписаниеОтбора(Строки, ЭлементыОтбора, Отступ)

	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Строки.Добавить(Отступ + ПометкаИспользования(ЭлементОтбора.Использование)
				+ НСтр("ru = 'Группа '") + Строка(ЭлементОтбора.ТипГруппы));
			ДобавитьОписаниеОтбора(Строки, ЭлементОтбора.Элементы, Отступ + "  ");
		Иначе
			Строки.Добавить(Отступ + ОписаниеЭлементаОтбора(ЭлементОтбора));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает строку вида "[x] Поле ВидСравнения Значение" для элемента отбора.
//
// Параметры:
//  ЭлементОтбора - ЭлементОтбораКомпоновкиДанных - элемент отбора
//
// Возвращаемое значение:
//  Строка - описание элемента
//
&НаСервереБезКонтекста
Функция ОписаниеЭлементаОтбора(ЭлементОтбора)

	// У элемента пользовательских настроек, вынесенного из основных настроек списка, часть свойств
	// недоступна (ЛевоеЗначение, иногда ВидСравнения): платформа выбрасывает исключение при обращении.
	// Поле такого элемента задано в основных настройках формы, в выводе остается его идентификатор.
	Попытка
		ИмяПоля = Строка(ЭлементОтбора.ЛевоеЗначение);
	Исключение
		ИмяПоля = НСтр("ru = '(поле из основных настроек списка)'");
	КонецПопытки;

	Попытка
		ТекстВидаСравнения = Строка(ЭлементОтбора.ВидСравнения);
	Исключение
		ТекстВидаСравнения = "?";
	КонецПопытки;

	Описание = ПометкаИспользования(ЭлементОтбора.Использование) + ИмяПоля + " " + ТекстВидаСравнения + " "
		+ ПредставлениеЗначения(ЭлементОтбора.ПравоеЗначение);
	Если ЗначениеЗаполнено(ЭлементОтбора.ИдентификаторПользовательскойНастройки) Тогда
		Описание = Описание + " (ИД " + ЭлементОтбора.ИдентификаторПользовательскойНастройки + ")";
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Возвращает пометку использования элемента настроек.
//
// Параметры:
//  Использование - Булево - признак использования элемента
//
// Возвращаемое значение:
//  Строка - "[x] " или "[ ] "
//
&НаСервереБезКонтекста
Функция ПометкаИспользования(Использование)

	Если Использование Тогда
		Возврат "[x] ";
	КонецЕсли;
	Возврат "[ ] ";

КонецФункции

// Возвращает представление значения с типом; списки значений раскрываются через запятую.
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Строка - представление, не длиннее 500 символов
//
&НаСервереБезКонтекста
Функция ПредставлениеЗначения(Значение)

	Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Части = Новый Массив;
		Для Каждого ЭлементСписка Из Значение Цикл
			Части.Добавить(Строка(ЭлементСписка.Значение));
		КонецЦикла;
		Текст = "[" + СтрСоединить(Части, "; ") + "]";
	ИначеЕсли ЭтоСоставноеЗначение(Значение) Тогда
		Текст = "<" + Строка(ТипЗнч(Значение)) + ">";
	Иначе
		// В хранилищах лежат значения любых типов; часть из них (например ДвоичныеДанные)
		// к строке не приводится. Тогда выводится только тип, содержимое есть в XML.
		Попытка
			ТекстЗначения = Строка(Значение);
		Исключение
			ТекстЗначения = "";
		КонецПопытки;
		Текст = ТекстЗначения + " <" + Строка(ТипЗнч(Значение)) + ">";
	КонецЕсли;

	Возврат Лев(Текст, 500);

КонецФункции

// Проверяет, раскрывает ли ДобавитьОписаниеЗначения значение этого типа по частям.
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Булево - Истина для настроек компоновки, структур и соответствий
//
&НаСервереБезКонтекста
Функция ЭтоСоставноеЗначение(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("ПользовательскиеНастройкиКомпоновкиДанных")
		Или ТипЗначения = Тип("НастройкиКомпоновкиДанных")
		Или ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура")
		Или ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("ФиксированноеСоответствие");

КонецФункции

// Сериализует значение настроек в XML для полного просмотра, включая идентификаторы настроек.
//
// Параметры:
//  Значение - Произвольный - значение настроек
//
// Возвращаемое значение:
//  Строка - XML или текст о том, что значение не сериализуется
//
&НаСервереБезКонтекста
Функция ЗначениеВXML(Значение)

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();

	// Не каждое значение хранилища имеет XDTO-представление. Такая запись помечается в выводе,
	// просмотр остальных записей продолжается.
	Попытка
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Значение);
	Исключение
		Возврат НСтр("ru = 'Значение не сериализуется в XML: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат ЗаписьXML.Закрыть();

КонецФункции

// Выводит найденные записи в табличный документ "Результат" и полный текст в "ПолныйТекст".
//
// Параметры:
//  Записи - ТаблицаЗначений - см. НоваяТаблицаЗаписей
//  ПараметрыОтбора - Структура - параметры отбора, выводятся в шапку
//
&НаСервере
Процедура ВывестиРезультат(Записи, ПараметрыОтбора)

	Документ = Новый ТабличныйДокумент;
	НомерСтроки = 1;

	Если ПараметрыОтбора.ВсеПользователи Тогда
		ТекстПользователя = НСтр("ru = 'все пользователи'");
	Иначе
		ТекстПользователя = ПараметрыОтбора.ПользовательИБ;
	КонецЕсли;

	Шапка = Новый Массив;
	Шапка.Добавить(НСтр("ru = 'Пользователь ИБ: '") + ТекстПользователя);
	Шапка.Добавить(НСтр("ru = 'Ключ содержит: '") + ПараметрыОтбора.ПодстрокаКлюча);
	Шапка.Добавить(НСтр("ru = 'Конфигурация: '") + Метаданные.Имя + " " + Метаданные.Версия
		+ НСтр("ru = ', режим совместимости '") + Строка(Метаданные.РежимСовместимости));
	Шапка.Добавить(НСтр("ru = 'База: '") + СтрокаСоединенияИнформационнойБазы());
	Шапка.Добавить(НСтр("ru = 'Сформировано: '") + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT")
		+ НСтр("ru = ', записей: '") + Формат(Записи.Количество(), "ЧН=0; ЧГ="));
	Для Каждого ТекстШапки Из Шапка Цикл
		ВывестиЯчейку(Документ, НомерСтроки, 1, ТекстШапки, Истина);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	Заголовки = СтрРазделить("N,Хранилище,Пользователь,Дата изменения,Ключ объекта,Ключ настроек,Представление,Тип", ",");
	Ширины    = СтрРазделить("5,28,20,20,60,40,30,40", ",");
	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		ВывестиЯчейку(Документ, НомерСтроки, Индекс + 1, Заголовки[Индекс], Истина);
		Документ.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = Число(Ширины[Индекс]);
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	Части = Новый Массив;
	Номер = 0;
	Для Каждого Запись Из Записи Цикл

		Номер = Номер + 1;
		ТекстДаты = ПредставлениеДатыИзменения(Запись.ДатаИзменения);

		Значения = Новый Массив;
		Значения.Добавить(Формат(Номер, "ЧГ="));
		Значения.Добавить(Запись.Хранилище);
		Значения.Добавить(Запись.Пользователь);
		Значения.Добавить(ТекстДаты);
		Значения.Добавить(Запись.КлючОбъекта);
		Значения.Добавить(Запись.КлючНастроек);
		Значения.Добавить(Запись.Представление);
		Значения.Добавить(Запись.ТипНастроек);
		Для Индекс = 0 По Значения.ВГраница() Цикл
			ВывестиЯчейку(Документ, НомерСтроки, Индекс + 1, Значения[Индекс]);
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;

		Если ЗначениеЗаполнено(Запись.Расшифровка) Тогда
			Для Каждого СтрокаРасшифровки Из СтрРазделить(Запись.Расшифровка, Символы.ПС) Цикл
				ВывестиЯчейку(Документ, НомерСтроки, 2, "    " + СтрокаРасшифровки);
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
		КонецЕсли;

		Части.Добавить(СтрШаблон("=== %1. %2 | %3 | %4 | %5 | %6", Номер, Запись.Хранилище, Запись.Пользователь,
			ТекстДаты, Запись.КлючОбъекта, Запись.КлючНастроек));
		Части.Добавить(Запись.Расшифровка);
		Части.Добавить(Запись.XML);
		Части.Добавить("");

	КонецЦикла;

	Если Записи.Количество() = 0 Тогда
		ВывестиЯчейку(Документ, НомерСтроки, 1, НСтр("ru = 'Записей по отбору нет.'"));
	КонецЕсли;

	Результат   = Документ;
	ПолныйТекст = СтрСоединить(Шапка, Символы.ПС) + Символы.ПС + Символы.ПС + СтрСоединить(Части, Символы.ПС);

КонецПроцедуры

// Возвращает представление даты изменения записи хранилища.
// В режиме совместимости 8.3.18 и ниже платформа не записывает дату, свойство содержит Неопределено.
//
// Параметры:
//  ДатаИзменения - Дата, Неопределено - дата изменения из выборки хранилища
//
// Возвращаемое значение:
//  Строка - дата и время или пометка об отсутствии даты
//
&НаСервереБезКонтекста
Функция ПредставлениеДатыИзменения(ДатаИзменения)

	Если ТипЗнч(ДатаИзменения) = Тип("Дата") И ЗначениеЗаполнено(ДатаИзменения) Тогда
		Возврат Формат(ДатаИзменения, "ДФ='dd.MM.yyyy HH:mm:ss'");
	КонецЕсли;
	Возврат НСтр("ru = '(нет даты)'");

КонецФункции

// Выводит текст в ячейку табличного документа.
//
// Параметры:
//  Документ - ТабличныйДокумент - документ вывода
//  НомерСтроки - Число - номер строки
//  НомерКолонки - Число - номер колонки
//  Текст - Строка - выводимый текст
//  Жирный - Булево - выделить шрифт
//
&НаСервереБезКонтекста
Процедура ВывестиЯчейку(Документ, НомерСтроки, НомерКолонки, Текст, Жирный = Ложь)

	Область = Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Область.Текст = Текст;
	Если Жирный Тогда
		Область.Шрифт = Новый Шрифт(, , Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
