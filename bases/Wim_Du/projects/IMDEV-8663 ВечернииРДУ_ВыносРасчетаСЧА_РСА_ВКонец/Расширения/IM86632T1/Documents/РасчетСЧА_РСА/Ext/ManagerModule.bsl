        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	ЗадолженностьЭмитентаПоДивидендамУУОстатки.Актив,
        |	""Задолженность эмитента по дивидендам (УУ)"",
        |	ЗадолженностьЭмитентаПоДивидендамУУОстатки.СуммаОстаток,
        |	ЗадолженностьЭмитентаПоДивидендамУУОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.ЗадолженностьЭмитентаПоДивидендамУУ.Остатки(
        |			&ДатаОстатков,
        |			&ОбособленныйУчетЗадолженностиПоДивидендам_УУ = ИСТИНА
        |				И ДоговорДУ = &ДоговорДУ) КАК ЗадолженностьЭмитентаПоДивидендамУУОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	ДенежныеСредстваУправленческийОстатки.АналитическийСчет,
        |	""Денежные средства (УУ)"",
        |	ДенежныеСредстваУправленческийОстатки.СуммаОстаток,
        |	ДенежныеСредстваУправленческийОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.ДенежныеСредстваУправленческий.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК ДенежныеСредстваУправленческийОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	ОпционныеПремииОстатки.Опцион,
        |	""Опционные премии"",
        |	ОпционныеПремииОстатки.СуммаОстаток,
        |	ОпционныеПремииОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.ОпционныеПремии.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК ОпционныеПремииОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	СтоимостьАктивовПоСделкамРЕПОУправленческийОстатки.Актив,
        |	""Стоимость ц/б по сделкам РЕПО (УУ)"",
        |	СтоимостьАктивовПоСделкамРЕПОУправленческийОстатки.СуммаОстаток,
        |	СтоимостьАктивовПоСделкамРЕПОУправленческийОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.СтоимостьАктивовПоСделкамРЕПОУправленческий.Остатки(
        |			&ДатаОстатков,
        |			ДоговорДУ = &ДоговорДУ
        |				И ВЫБОР
        |					КОГДА СделкаРЕПО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО)
        |							И &ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО = ИСТИНА
        |						ТОГДА ЛОЖЬ
        |					ИНАЧЕ &УчетЗадолженности = ЛОЖЬ
        |				КОНЕЦ) КАК СтоимостьАктивовПоСделкамРЕПОУправленческийОстатки
        |ГДЕ
        |	СтоимостьАктивовПоСделкамРЕПОУправленческийОстатки.КоличествоОстаток <> 0
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	НачисленныеПроцентыПоРЕПОУправленческийОстатки.СделкаРЕПО,
        |	""Начисленные проценты по РЕПО (УУ)"",
        |	НачисленныеПроцентыПоРЕПОУправленческийОстатки.СуммаОстаток,
        |	НачисленныеПроцентыПоРЕПОУправленческийОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.НачисленныеПроцентыПоРЕПОУправленческий.Остатки(
        |			&ДатаОстатков,
        |			&УчетЗадолженности = ЛОЖЬ
        |				И ДоговорДУ = &ДоговорДУ) КАК НачисленныеПроцентыПоРЕПОУправленческийОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	НачисленныйКупонныйДоходПоСделкамРЕПОУправленческийОстатки.Облигация,
        |	""Начисленный купонный доход по сделкам РЕПО (УУ)"",
        |	НачисленныйКупонныйДоходПоСделкамРЕПОУправленческийОстатки.СуммаОстаток,
        |	НачисленныйКупонныйДоходПоСделкамРЕПОУправленческийОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.НачисленныйКупонныйДоходПоСделкамРЕПОУправленческий.Остатки(
        |			&ДатаОстатков,
        |			ДоговорДУ = &ДоговорДУ
        |				И ВЫБОР
        |					КОГДА СделкаРЕПО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО)
        |							И &ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО = ИСТИНА
        |						ТОГДА ЛОЖЬ
        |					ИНАЧЕ &УчетЗадолженности = ЛОЖЬ
        |				КОНЕЦ) КАК НачисленныйКупонныйДоходПоСделкамРЕПОУправленческийОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	РасчетыРЕПОДебиторскаяЗадолженностьПоТелуОстатки.БизнесПроцесс,
        |	""Расчеты РЕПО, дебиторская задолженность по телу (УУ)"",
        |	РасчетыРЕПОДебиторскаяЗадолженностьПоТелуОстатки.СуммаОстаток,
        |	РасчетыРЕПОДебиторскаяЗадолженностьПоТелуОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.РасчетыРЕПОДебиторскаяЗадолженностьПоТелу.Остатки(
        |			&ДатаОстатков,
        |			ДоговорДУ = &ДоговорДУ
        |				И (&УчетЗадолженности = ИСТИНА
        |					ИЛИ &ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО = ИСТИНА)) КАК РасчетыРЕПОДебиторскаяЗадолженностьПоТелуОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	РасчетыРЕПОДебиторскаяЗадолженностьПоКупонуОстатки.Контрагент,
        |	""Расчеты РЕПО, дебиторская задолженность по купону (УУ)"",
        |	РасчетыРЕПОДебиторскаяЗадолженностьПоКупонуОстатки.СуммаОстаток,
        |	РасчетыРЕПОДебиторскаяЗадолженностьПоКупонуОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.РасчетыРЕПОДебиторскаяЗадолженностьПоКупону.Остатки(
        |			&ДатаОстатков,
        |			&УчетЗадолженности = ИСТИНА
        |				И ДоговорДУ = &ДоговорДУ) КАК РасчетыРЕПОДебиторскаяЗадолженностьПоКупонуОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	РасчетыРЕПОКредиторскаяЗадолженностьПоТелуОстатки.БизнесПроцесс,
        |	""Расчеты РЕПО, кредиторская задолженность по телу (УУ)"",
        |	0,
        |	-1 * РасчетыРЕПОКредиторскаяЗадолженностьПоТелуОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.РасчетыРЕПОКредиторскаяЗадолженностьПоТелу.Остатки(
        |			&ДатаОстатков,
        |			ДоговорДУ = &ДоговорДУ
        |				И (&УчетЗадолженности = ИСТИНА
        |					ИЛИ &ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО = ИСТИНА)) КАК РасчетыРЕПОКредиторскаяЗадолженностьПоТелуОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	РасчетыРЕПОКредиторскаяЗадолженностьПоКупонуОстатки.Контрагент,
        |	""Расчеты РЕПО, кредиторская задолженность по купону (УУ)"",
        |	0,
        |	-1 * РасчетыРЕПОКредиторскаяЗадолженностьПоКупонуОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.РасчетыРЕПОКредиторскаяЗадолженностьПоКупону.Остатки(
        |			&ДатаОстатков,
        |			&УчетЗадолженности = ИСТИНА
        |				И ДоговорДУ = &ДоговорДУ) КАК РасчетыРЕПОКредиторскаяЗадолженностьПоКупонуОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	СформированныеРезервыОстатки.Аналитика,
        |	""Сформированные резервы"",
        |	СформированныеРезервыОстатки.СуммаОстаток * -1,
        |	СформированныеРезервыОстатки.СуммаОстаток * -1
        |ИЗ
        |	РегистрНакопления.СформированныеРезервы.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК СформированныеРезервыОстатки
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |	ВТ_ПромежуточнаяТаблица.Показатель КАК Показатель,
        |	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя КАК ИсточникПоказателя,
        |	СУММА(ВТ_ПромежуточнаяТаблица.СуммаДляРСА) КАК СуммаДляРСА,
        |	СУММА(ВТ_ПромежуточнаяТаблица.СуммаДляСЧА) КАК СуммаДляСЧА
        |ИЗ
        |	ВТ_ПромежуточнаяТаблица КАК ВТ_ПромежуточнаяТаблица
        |
        |СГРУППИРОВАТЬ ПО
        |	ВТ_ПромежуточнаяТаблица.Показатель,
        |	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя
        |
        |УПОРЯДОЧИТЬ ПО
        |	ИсточникПоказателя,
        |	Показатель
        |АВТОУПОРЯДОЧИВАНИЕ";

КонецФункции

// Описание: Возвращает текст запроса УУ для расчета РСА/СЧА.
//
// Параметры:
//  Пакетно - Булево - Истина: отбор В (&ДоговорыГруппы) и группировка по ДоговорДУ
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаУУ(Пакетно)

    // IMDEV-8663.2 этап 4
    ТекстЗапроса = ТекстЗапросаОднодоговорныйУУ();

    Если Не Пакетно Тогда
        Возврат ТекстЗапроса;
    КонецЕсли;

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДоговорДУ = &ДоговорДУ", "ДоговорДУ В (&ДоговорыГруппы)");

    МаркерыПервыхПолей = Новый Массив;
    МаркерыПервыхПолей.Добавить("СтоимостьАктивовУправленческийОстатки.Актив КАК Показатель,");
    МаркерыПервыхПолей.Добавить("НачисленныйКупонныйДоходУправленческийОстатки.Облигация,");
    МаркерыПервыхПолей.Добавить("УУ_ЦенныеБумагиHTMОстатки.Партия,");
    МаркерыПервыхПолей.Добавить("УУ_НКДПоЦеннымБумагамHTMОстатки.Партия,");
    МаркерыПервыхПолей.Добавить("КорректировкиПоЭСПОблигации.Партия,");
    МаркерыПервыхПолей.Добавить("НачисленныеПроцентыПоБанковскимСчетамУправленческийОстатки.АналитическийСчет,");
    МаркерыПервыхПолей.Добавить("ЗадолженностьЭмитентаПоОблигациямУУОстатки.Актив,");
    МаркерыПервыхПолей.Добавить("ЗадолженностьЭмитентаПоКупонномуДоходуУУОстатки.Облигация,");
    МаркерыПервыхПолей.Добавить("ЗадолженностьЭмитентаПоДивидендамУУОстатки.Актив,");
    МаркерыПервыхПолей.Добавить("ДенежныеСредстваУправленческийОстатки.АналитическийСчет,");
    МаркерыПервыхПолей.Добавить("ОпционныеПремииОстатки.Опцион,");
    МаркерыПервыхПолей.Добавить("СтоимостьАктивовПоСделкамРЕПОУправленческийОстатки.Актив,");
    МаркерыПервыхПолей.Добавить("НачисленныеПроцентыПоРЕПОУправленческийОстатки.СделкаРЕПО,");
    МаркерыПервыхПолей.Добавить("НачисленныйКупонныйДоходПоСделкамРЕПОУправленческийОстатки.Облигация,");
    МаркерыПервыхПолей.Добавить("РасчетыРЕПОДебиторскаяЗадолженностьПоТелуОстатки.БизнесПроцесс,");
    МаркерыПервыхПолей.Добавить("РасчетыРЕПОДебиторскаяЗадолженностьПоКупонуОстатки.Контрагент,");
    МаркерыПервыхПолей.Добавить("РасчетыРЕПОКредиторскаяЗадолженностьПоТелуОстатки.БизнесПроцесс,");
    МаркерыПервыхПолей.Добавить("РасчетыРЕПОКредиторскаяЗадолженностьПоКупонуОстатки.Контрагент,");
    МаркерыПервыхПолей.Добавить("СформированныеРезервыОстатки.Аналитика,");

    ЭтоПерваяВыборка = Истина;
    Для Каждого МаркерПоля Из МаркерыПервыхПолей Цикл
        ИмяТаблицы = Лев(МаркерПоля, СтрНайти(МаркерПоля, ".") - 1);
        ТекстЗапроса = ВставитьПолеДоговорДУПеред(ТекстЗапроса, МаркерПоля, ИмяТаблицы, ЭтоПерваяВыборка);
        ЭтоПерваяВыборка = Ложь;
    КонецЦикла;

    ТекстЗапроса = ВставитьПолеДоговорДУПеред(
        ТекстЗапроса,
        "ВТ_ПромежуточнаяТаблица.Показатель КАК Показатель,",
        "ВТ_ПромежуточнаяТаблица",
        Истина);

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
        "СГРУППИРОВАТЬ ПО
        |	ВТ_ПромежуточнаяТаблица.Показатель,
        |	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя",
        "СГРУППИРОВАТЬ ПО
        |	ВТ_ПромежуточнаяТаблица.ДоговорДУ,
        |	ВТ_ПромежуточнаяТаблица.Показатель,
        |	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя");

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
        "УПОРЯДОЧИТЬ ПО
        |	ИсточникПоказателя,
        |	Показатель",
        "УПОРЯДОЧИТЬ ПО
        |	ДоговорДУ,
        |	ИсточникПоказателя,
        |	Показатель");

    Возврат ТекстЗапроса;

КонецФункции

// Описание: Возвращает однодоговорной текст запроса СС незавершенных сделок (ПолучитьСуммыРСА_СЧА). Параметр периода в запросе называется Период, не ДатаОстатков.
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаОднодоговорныйСС()

    // IMDEV-8663.2 этап 4
    Возврат
        "ВЫБРАТЬ
        |	СправедливаяСтоимостьСделокTn.ПлановаяПозиция,
        |	СправедливаяСтоимостьСделокTn.ПлановаяПозиция.ВидОперации КАК ВидОперации,
        |	СправедливаяСтоимостьСделокTn.ПлановаяПозиция.Актив КАК Актив,
        |	ВЫБОР
        |		КОГДА СправедливаяСтоимостьСделокTn.ПлановаяПозиция.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление)
        |				И СправедливаяСтоимостьСделокTn.СправедливаяСтоимостьОстаток > 0
        |			ТОГДА СправедливаяСтоимостьСделокTn.СправедливаяСтоимостьОстаток
        |		КОГДА СправедливаяСтоимостьСделокTn.ПлановаяПозиция.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа)
        |				И СправедливаяСтоимостьСделокTn.СправедливаяСтоимостьОстаток < 0
        |			ТОГДА -1 * СправедливаяСтоимостьСделокTn.СправедливаяСтоимостьОстаток
        |		ИНАЧЕ 0
        |	КОНЕЦ КАК Дебиторка,
        |	ВЫБОР
        |		КОГДА СправедливаяСтоимостьСделокTn.ПлановаяПозиция.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление)
        |				И СправедливаяСтоимостьСделокTn.СправедливаяСтоимостьОстаток < 0
        |			ТОГДА -1 * СправедливаяСтоимостьСделокTn.СправедливаяСтоимостьОстаток
        |		КОГДА СправедливаяСтоимостьСделокTn.ПлановаяПозиция.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа)
        |				И СправедливаяСтоимостьСделокTn.СправедливаяСтоимостьОстаток > 0
        |			ТОГДА СправедливаяСтоимостьСделокTn.СправедливаяСтоимостьОстаток
        |		ИНАЧЕ 0
        |	КОНЕЦ КАК Кредиторка,
        |	ВЫБОР
        |		КОГДА &НеПереоцениватьНезавершенныеСделкиПокупкиПоСС
        |				И СправедливаяСтоимостьСделокTn.ПлановаяПозиция.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление)
        |			ТОГДА ЛОЖЬ
        |		КОГДА &НеПереоцениватьНезавершенныеСделкиПродажиПоСС
        |				И СправедливаяСтоимостьСделокTn.ПлановаяПозиция.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа)
        |			ТОГДА ЛОЖЬ
        |		ИНАЧЕ ИСТИНА
        |	КОНЕЦ КАК Переоценивается
        |ПОМЕСТИТЬ ВТ_ССПоНезавершеннымСделкам
        |ИЗ
        |	РегистрНакопления.СправедливаяСтоимостьСделокTn.Остатки(&Период, ДоговорДУ = &ДоговорДУ) КАК СправедливаяСтоимостьСделокTn
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |	ВТ_ССПоНезавершеннымСделкам.Актив,
        |	СУММА(ВТ_ССПоНезавершеннымСделкам.Дебиторка) КАК Дебиторка,
        |	СУММА(ВТ_ССПоНезавершеннымСделкам.Кредиторка) КАК Кредиторка
        |ИЗ
        |	ВТ_ССПоНезавершеннымСделкам КАК ВТ_ССПоНезавершеннымСделкам
        |ГДЕ
        |	ВТ_ССПоНезавершеннымСделкам.Переоценивается = ИСТИНА
        |
        |СГРУППИРОВАТЬ ПО
        |	ВТ_ССПоНезавершеннымСделкам.Актив";

КонецФункции

// Описание: Возвращает текст запроса справедливой стоимости незавершенных сделок.
//
// Параметры:
//  Пакетно - Булево - Истина: отбор В (&ДоговорыГруппы) и группировка по ДоговорДУ
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаСС(Пакетно)

    // IMDEV-8663.2 этап 4
    ТекстЗапроса = ТекстЗапросаОднодоговорныйСС();

    Если Не Пакетно Тогда
        Возврат ТекстЗапроса;
    КонецЕсли;

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДоговорДУ = &ДоговорДУ", "ДоговорДУ В (&ДоговорыГруппы)");

    ТекстЗапроса = ВставитьПолеДоговорДУПеред(
        ТекстЗапроса,
        "СправедливаяСтоимостьСделокTn.ПлановаяПозиция,",
        "СправедливаяСтоимостьСделокTn",
        Истина);

    ТекстЗапроса = ВставитьПолеДоговорДУПеред(
        ТекстЗапроса,
        "ВТ_ССПоНезавершеннымСделкам.Актив,",
        "ВТ_ССПоНезавершеннымСделкам",
        Истина);

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
        "СГРУППИРОВАТЬ ПО
        |	ВТ_ССПоНезавершеннымСделкам.Актив",
        "СГРУППИРОВАТЬ ПО
        |	ВТ_ССПоНезавершеннымСделкам.ДоговорДУ,
        |	ВТ_ССПоНезавершеннымСделкам.Актив");

    Возврат ТекстЗапроса;

КонецФункции

// Описание: Формирует наборы счетов БУ для расчета РСА/СЧА по признакам договора.
// Логика один в один со стр. 65-133 ПолучитьСуммыРСА_СЧА. В пакетном режиме
// РасчетРСА и РасчетСЧА всегда Истина (АР-6).
//
// Параметры:
//  Признаки  - Структура - признаки расчета, поле ТипКлиентаДУ обязательно
//  РасчетРСА - Булево - заполнять счета РСА (по умолчанию Истина)
//  РасчетСЧА - Булево - заполнять счета СЧА (по умолчанию Истина)
//
// Возвращаемое значение:
//  Структура - СчетаДляРСА_Дт, СчетаИсключенияДляРСА, СчетаДляСЧА,
//              СчетаИсключенияДляСЧА, СчетаДляВычитанияИзСЧА, СчетаДФО
//
Функция НаборыСчетовПоПризнакам(Признаки, РасчетРСА = Истина, РасчетСЧА = Истина)

    // IMDEV-8663.2 этап 4
    ПС = ПланыСчетов.Хозрасчетный;

    СчетаДляРСА_Дт        = Новый Массив;
    СчетаИсключенияДляРСА = Новый Массив;
    СчетаДляСЧА           = Новый Массив;
    СчетаИсключенияДляСЧА = Новый Массив;
    СчетаДляВычитанияИзСЧА = Новый Массив;

    Если РасчетРСА Тогда
        СчетаДляРСА_Дт.Добавить(ПС.РасчетыСРазнымиДебиторамиИКредиторами); //76
        СчетаИсключенияДляРСА.Добавить(ПС.РасчетыБрокера);           // 76.01
        СчетаИсключенияДляРСА.Добавить(ПС.НКД);                      // 76.05
        СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоБанковскимСчетам); // 76.04.4
        Если Признаки.ОбособленныйУчетЗадолженностиЭмитента_УУ Тогда
            СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоОблигациям);              // 76.04.2.1
            СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоОблигациям_ПогашениеТела); // 76.04.2.2
        КонецЕсли;
        Если Признаки.ОбособленныйУчетЗадолженностиПоДивидендам_УУ Тогда
            СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоДивидендам); // 76.04.1
            СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоПаямПИФ);    // 76.04.9
        КонецЕсли;
    КонецЕсли;

    Если РасчетСЧА Тогда
        СчетаДляСЧА.Добавить(ПС.РасчетыСБюджетом);                         // 68
        СчетаДляСЧА.Добавить(ПС.РасчетыСРазнымиДебиторамиИКредиторами);    // 76
        СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыБрокера); // 76.01
        СчетаИсключенияДляСЧА.Добавить(ПС.НКД);            // 76.05
        Если Признаки.ОбособленныйУчетЗадолженностиПоДивидендам_УУ Тогда
            СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыПоДивидендам); // 76.04.1
            СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыПоПаямПИФ);    // 76.04.9
        КонецЕсли;
        Если Признаки.ОбособленныйУчетЗадолженностиЭмитента_УУ Тогда
            СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыПоОблигациям);              // 76.04.2.1
            СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыПоОблигациям_ПогашениеТела); // 76.04.2.2
        КонецЕсли;
        Если Признаки.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеЧерезНПФ
            Или Признаки.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ПенсионныеРезервыНПФ Тогда
            СчетаДляВычитанияИзСЧА.Добавить(ПС.СредстваНаправляемыеВНПФДляОУД); //79.04
        ИначеЕсли Признаки.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеПФР Тогда
            СчетаДляВычитанияИзСЧА.Добавить(ПС.РасчетыСФондом); // 79.05
        КонецЕсли;
    КонецЕсли;

    СчетаДФО = Новый Массив;
    СчетаДФО.Добавить(ПС.ДефолтПоТелу);
    СчетаДФО.Добавить(ПС.ДефолтПоКупону);

    Наборы = Новый Структура;
    Наборы.Вставить("СчетаДляРСА_Дт",         СчетаДляРСА_Дт);
    Наборы.Вставить("СчетаИсключенияДляРСА",  СчетаИсключенияДляРСА);
    Наборы.Вставить("СчетаДляСЧА",            СчетаДляСЧА);
    Наборы.Вставить("СчетаИсключенияДляСЧА",  СчетаИсключенияДляСЧА);
    Наборы.Вставить("СчетаДляВычитанияИзСЧА", СчетаДляВычитанияИзСЧА);
    Наборы.Вставить("СчетаДФО",               СчетаДФО);

    Возврат Наборы;

КонецФункции

// Описание: Собирает структуру признаков расчета из соответствия значений параметров договора.
//
// Параметры:
//  ЗначенияПараметров - Соответствие - параметр ПВХ -> значение (может быть Неопределено)
//  ТипКлиентаДУ       - ПеречислениеСсылка.ТипыКлиентовДУ, Неопределено
//
// Возвращаемое значение:
//  Структура - 9 булевых признаков + ТипКлиентаДУ
//
Функция ПризнакиИзЗначенийПараметров(ЗначенияПараметров, ТипКлиентаДУ)

    // IMDEV-8663.2 этап 4
    Если ЗначенияПараметров = Неопределено Тогда
        ЗначенияПараметров = Новый Соответствие;
    КонецЕсли;

    ПВХ_Параметры = ПланыВидовХарактеристик.ПараметрыДоговораДУ;

    Признаки = Новый Структура;
    Признаки.Вставить("ОбособленныйУчетЗадолженностиЭмитента_УУ",
        ЗначенияПараметров.Получить(ПВХ_Параметры.ОбособленныйУчетЗадолженностиЭмитента_УУ) = Истина);
    Признаки.Вставить("ОбособленныйУчетЗадолженностиПоДивидендам_УУ",
        ЗначенияПараметров.Получить(ПВХ_Параметры.ОбособленныйУчетЗадолженностиПоДивидендам_УУ) = Истина);
    Признаки.Вставить("УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ",
        ЗначенияПараметров.Получить(ПВХ_Параметры.УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ) = Истина);
    Признаки.Вставить("ОценкаНезавершенныхСделокПоСС",
        ЗначенияПараметров.Получить(ПВХ_Параметры.ОценкаНезавершенныхСделокПоСС) = Истина);
    Признаки.Вставить("НеПереоцениватьНезавершенныеСделкиПокупкиПоСС",
        ЗначенияПараметров.Получить(ПВХ_Параметры.НеПереоцениватьНезавершенныеСделкиПокупкиПоСС) = Истина);
    Признаки.Вставить("НеПереоцениватьНезавершенныеСделкиПродажиПоСС",
        ЗначенияПараметров.Получить(ПВХ_Параметры.НеПереоцениватьНезавершенныеСделкиПродажиПоСС) = Истина);
    Признаки.Вставить("ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО",
        ЗначенияПараметров.Получить(ПВХ_Параметры.ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО) = Истина);
    Признаки.Вставить("ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО",
        ЗначенияПараметров.Получить(ПВХ_Параметры.ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО) = Истина);
    Признаки.Вставить("НеПереоцениватьНКДВОбратномРЕПО",
        ЗначенияПараметров.Получить(ПВХ_Параметры.НеПереоцениватьНКДВОбратномРЕПО) = Истина);
    Признаки.Вставить("ТипКлиентаДУ", ТипКлиентаДУ);

    Возврат Признаки;

КонецФункции

#КонецОбласти

#Область IMDEV_8663_2_ПакетныйРасчет

// Описание: Пакетно рассчитывает данные РСА и СЧА сразу по массиву договоров ДУ.
// Договоры группируются по сигнатуре параметров расчета: договоры с одинаковой сигнатурой
// дают одинаковый текст запроса и обрабатываются одним запросом вместо N запросов.
// Методика расчета полностью повторяет Документы.РасчетСЧА_РСА.ПолучитьСуммыРСА_СЧА:
// используются те же тексты запросов (см. ТекстЗапросаБУ / УУ / СС).
//
// В пакетном режиме ВСЕГДА рассчитываются и РСА, и СЧА: флаги расчета зависят от состава
// операций конкретного договора и иначе дробили бы группы. Отбор по флагам выполняется
// при заполнении табличных частей документа - результат не меняется.
//
// Параметры:
//  МассивДоговоров - Массив - элементы СправочникСсылка.ДоговорДУ
//  Дата            - Дата   - дата расчета (дата периода со временем окончания рабочего дня)
//  ТаблицаБУ       - ТаблицаЗначений - возвращаемое значение: колонки
//                    ДоговорДУ, ИсточникПоказателя, Показатель, СуммаДляСЧА, СуммаДляРСА
//  ТаблицаУУ       - ТаблицаЗначений - возвращаемое значение: та же структура колонок
//
// Пример:
//  ТаблицаБУ = Неопределено; ТаблицаУУ = Неопределено;
//  Документы.РасчетСЧА_РСА.ПолучитьСуммыРСА_СЧА_Пакетно(Договоры, ДатаРасчета, ТаблицаБУ, ТаблицаУУ);
//
Процедура ПолучитьСуммыРСА_СЧА_Пакетно(МассивДоговоров, Дата, ТаблицаБУ, ТаблицаУУ) Экспорт

    // IMDEV-8663.2 этап 4
    ТаблицаБУ = СоздатьТаблицуПоказателей();
    ТаблицаУУ = СоздатьТаблицуПоказателей();

    Если МассивДоговоров = Неопределено Или МассивДоговоров.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ДатаОстатков = Новый Граница(КонецДня(Дата), ВидГраницы.Включая);

    // ОВ-2: не вызывать ВалютаРеглУчета / ИнформационнаяПлощадка / КурсыВалютПоДатеПоПортфелю -
    // в ПолучитьСуммыРСА_СЧА (стр. 26-30) это мертвый код, на суммы не влияет.

    ГруппыДоговоров = ПодготовитьГруппыДоговоровПоСигнатуре(МассивДоговоров, Дата);

    Для Каждого КлючИЗначение Из ГруппыДоговоров Цикл
        ГруппаДоговоров = КлючИЗначение.Значение;
        ДобавитьДанныеБУПоГруппе(ТаблицаБУ, ГруппаДоговоров, ДатаОстатков);
        ДобавитьДанныеУУПоГруппе(ТаблицаУУ, ГруппаДоговоров, ДатаОстатков);
    КонецЦикла;

    ОбщегоНазначенияДУ.ДобавитьИндекс(ТаблицаБУ, "ДоговорДУ");
    ОбщегоНазначенияДУ.ДобавитьИндекс(ТаблицаУУ, "ДоговорДУ");

КонецПроцедуры

// Описание: Создает пустую таблицу показателей расчета РСА/СЧА.
// Структура колонок Показатель / ИсточникПоказателя берется из табличной части документа,
// поэтому составные типы значений полностью совпадают с однодоговорным расчетом.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ДоговорДУ, ИсточникПоказателя, Показатель, СуммаДляСЧА, СуммаДляРСА
//
Функция СоздатьТаблицуПоказателей()

    // IMDEV-8663.2 этап 4
    Таблица = Документы.РасчетСЧА_РСА.СоздатьДокумент().РасчетСЧА.Выгрузить(, "ИсточникПоказателя, Показатель");

    Таблица.Колонки.Добавить("ДоговорДУ",   Новый ОписаниеТипов("СправочникСсылка.ДоговорДУ"));
    Таблица.Колонки.Добавить("СуммаДляСЧА", ОбщегоНазначенияДУКлиентСервер.ПолучитьОписаниеТиповЧисла(20, 2));
    Таблица.Колонки.Добавить("СуммаДляРСА", ОбщегоНазначенияДУКлиентСервер.ПолучитьОписаниеТиповЧисла(20, 2));

    Возврат Таблица;

КонецФункции

// Описание: Группирует договоры по сигнатуре параметров расчета РСА/СЧА.
// Сигнатура включает 9 параметров договора (ПВХ ПараметрыДоговораДУ) и тип клиента ДУ,
// так как от них зависят наборы счетов и ветки запросов. Значения параметров читаются
// одним срезом последних на все договоры сразу.
//
// Параметры:
//  МассивДоговоров - Массив - элементы СправочникСсылка.ДоговорДУ
//  Дата            - Дата   - дата среза параметров
//
// Возвращаемое значение:
//  Соответствие - Ключ: Строка (сигнатура); Значение: Структура
//    * Признаки - Структура - булевы признаки расчета и ТипКлиентаДУ
//    * Договоры - Массив    - договоры с этой сигнатурой
//
Функция ПодготовитьГруппыДоговоровПоСигнатуре(МассивДоговоров, Дата)

    // IMDEV-8663.2 этап 4
    ПВХ_Параметры = ПланыВидовХарактеристик.ПараметрыДоговораДУ;

    МассивПараметров = Новый Массив;
    МассивПараметров.Добавить(ПВХ_Параметры.ОбособленныйУчетЗадолженностиЭмитента_УУ);
    МассивПараметров.Добавить(ПВХ_Параметры.ОбособленныйУчетЗадолженностиПоДивидендам_УУ);
    МассивПараметров.Добавить(ПВХ_Параметры.УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ);
    МассивПараметров.Добавить(ПВХ_Параметры.ОценкаНезавершенныхСделокПоСС);
    МассивПараметров.Добавить(ПВХ_Параметры.НеПереоцениватьНезавершенныеСделкиПокупкиПоСС);
    МассивПараметров.Добавить(ПВХ_Параметры.НеПереоцениватьНезавершенныеСделкиПродажиПоСС);
    МассивПараметров.Добавить(ПВХ_Параметры.ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО);
    МассивПараметров.Добавить(ПВХ_Параметры.ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО);
    МассивПараметров.Добавить(ПВХ_Параметры.НеПереоцениватьНКДВОбратномРЕПО);

    ЗначенияПоДоговорам = РегистрыСведений.ЗначенияПараметровДоговораДУ.ЗначенияПараметровДоговоровДУПакетно(
        МассивДоговоров, МассивПараметров, Дата);

    ТипыКлиентов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивДоговоров, "ТипКлиентаДУ");

    Группы = Новый Соответствие;

    Для Каждого ДоговорДУ Из МассивДоговоров Цикл

        РеквизитыДоговора = ТипыКлиентов.Получить(ДоговорДУ);
        ТипКлиентаДУ = ?(РеквизитыДоговора = Неопределено, Неопределено, РеквизитыДоговора.ТипКлиентаДУ);

        Признаки = ПризнакиИзЗначенийПараметров(ЗначенияПоДоговорам.Получить(ДоговорДУ), ТипКлиентаДУ);
        Сигнатура = СигнатураПризнаков(Признаки);

        ГруппаДоговоров = Группы.Получить(Сигнатура);
        Если ГруппаДоговоров = Неопределено Тогда
            ГруппаДоговоров = Новый Структура("Признаки, Договоры", Признаки, Новый Массив);
            Группы.Вставить(Сигнатура, ГруппаДоговоров);
        КонецЕсли;

        ГруппаДоговоров.Договоры.Добавить(ДоговорДУ);

    КонецЦикла;

    Возврат Группы;

КонецФункции

// Описание: Строит строковый ключ сигнатуры по структуре признаков расчета.
//
// Параметры:
//  Признаки - Структура - признаки расчета РСА/СЧА по договору
//
// Возвращаемое значение:
//  Строка - ключ группировки
//
Функция СигнатураПризнаков(Признаки)

    // IMDEV-8663.2 этап 4
    // Ключи вставляются в фиксированном порядке в ПризнакиИзЗначенийПараметров.
    // Обход структуры в 8.3 сохраняет порядок вставки. XMLСтрока(Неопределено) падает.
    ЧастиКлюча = Новый Массив;

    Для Каждого КлючИЗначение Из Признаки Цикл
        ЗначениеКлюча = КлючИЗначение.Значение;
        Если ТипЗнч(ЗначениеКлюча) = Тип("Неопределено") Тогда
            ПредставлениеЗначения = "";
        Иначе
            ПредставлениеЗначения = XMLСтрока(ЗначениеКлюча);
        КонецЕсли;
        ЧастиКлюча.Добавить(КлючИЗначение.Ключ + "=" + ПредставлениеЗначения);
    КонецЦикла;

    Возврат СтрСоединить(ЧастиКлюча, "|");

КонецФункции

// Описание: Выполняет пакетный запрос по данным БУ для группы договоров с одинаковой
// сигнатурой и добавляет результат в накопительную таблицу.
//
// Параметры:
//  ТаблицаБУ       - ТаблицаЗначений - накопительная таблица (дополняется)
//  ГруппаДоговоров - Структура       - Признаки, Договоры
//  ДатаОстатков    - Граница         - граница остатков (КонецДня, Включая)
//
Процедура ДобавитьДанныеБУПоГруппе(ТаблицаБУ, ГруппаДоговоров, ДатаОстатков)

    // IMDEV-8663.2 этап 4
    НаборыСчетов = НаборыСчетовПоПризнакам(ГруппаДоговоров.Признаки);

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапросаБУ(Истина);

    Запрос.УстановитьПараметр("ДоговорыГруппы",          ГруппаДоговоров.Договоры);
    Запрос.УстановитьПараметр("ДатаОстатков",            ДатаОстатков);
    Запрос.УстановитьПараметр("СчетаДляРСА_Дт",          НаборыСчетов.СчетаДляРСА_Дт);
    Запрос.УстановитьПараметр("СчетаИсключенияДляРСА",   НаборыСчетов.СчетаИсключенияДляРСА);
    Запрос.УстановитьПараметр("СчетаИсключенияДляСЧА",   НаборыСчетов.СчетаИсключенияДляСЧА);
    Запрос.УстановитьПараметр("СчетаДляСЧА",             НаборыСчетов.СчетаДляСЧА);
    Запрос.УстановитьПараметр("СчетаДФО",                НаборыСчетов.СчетаДФО);
    Запрос.УстановитьПараметр("СчетаДляВычитанияИзСЧА",  НаборыСчетов.СчетаДляВычитанияИзСЧА);

    ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос,
        "Документ.РасчетСЧА_РСА.МодульМенеджера.ПолучитьСуммыРСА_СЧА_Пакетно(); (БУ)");

    Результат = Запрос.Выполнить().Выгрузить();

    Для Каждого ТекСтрока Из Результат Цикл
        НоваяСтрока = ТаблицаБУ.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
    КонецЦикла;

КонецПроцедуры

// Описание: Выполняет пакетный запрос по данным УУ для группы договоров с одинаковой
// сигнатурой и добавляет результат в накопительную таблицу. При ОценкаНезавершенныхСделокПоСС
// дополнительно вызывается ДобавитьДанныеССПоГруппе.
//
// Параметры:
//  ТаблицаУУ       - ТаблицаЗначений - накопительная таблица (дополняется)
//  ГруппаДоговоров - Структура       - Признаки, Договоры
//  ДатаОстатков    - Граница         - граница остатков (КонецДня, Включая)
//
Процедура ДобавитьДанныеУУПоГруппе(ТаблицаУУ, ГруппаДоговоров, ДатаОстатков)

    // IMDEV-8663.2 этап 4
    Признаки = ГруппаДоговоров.Признаки;

    ЗапросУУ = Новый Запрос;
    ЗапросУУ.Текст = ТекстЗапросаУУ(Истина);

    ЗапросУУ.УстановитьПараметр("ДоговорыГруппы", ГруппаДоговоров.Договоры);
    ЗапросУУ.УстановитьПараметр("ДатаОстатков",   ДатаОстатков);
    ЗапросУУ.УстановитьПараметр("ОбособленныйУчетЗадолженностиЭмитента_УУ",
        Признаки.ОбособленныйУчетЗадолженностиЭмитента_УУ);
    ЗапросУУ.УстановитьПараметр("ОбособленныйУчетЗадолженностиПоДивидендам_УУ",
        Признаки.ОбособленныйУчетЗадолженностиПоДивидендам_УУ);
    // Имя параметра в тексте запроса - УчетЗадолженности, не имя ПВХ.
    ЗапросУУ.УстановитьПараметр("УчетЗадолженности",
        Признаки.УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ);
    ЗапросУУ.УстановитьПараметр("ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО",
        Признаки.ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО);
    ЗапросУУ.УстановитьПараметр("ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО",
        Признаки.ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО);
    // НеПереоцениватьНКДВОбратномРЕПО в исходном запросе УУ не используется.
    // В сигнатуре оставляем, чтобы не смешать договоры при будущем изменении методики.

    ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(ЗапросУУ,
        "Документ.РасчетСЧА_РСА.МодульМенеджера.ПолучитьСуммыРСА_СЧА_Пакетно(); (УУ)");

    РезультатУУ = ЗапросУУ.Выполнить().Выгрузить();
    Для Каждого ТекСтрока Из РезультатУУ Цикл
        НоваяСтрока = ТаблицаУУ.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
    КонецЦикла;

    Если Признаки.ОценкаНезавершенныхСделокПоСС Тогда
        ДобавитьДанныеССПоГруппе(ТаблицаУУ, ГруппаДоговоров, ДатаОстатков);
    КонецЕсли;

КонецПроцедуры

// Описание: Добавляет в таблицу УУ дебиторку и кредиторку по справедливой стоимости
// незавершенных сделок (ASP-29010). Для кредиторки СуммаДляРСА не заполняется (ASP-34313).
//
// Параметры:
//  ТаблицаУУ       - ТаблицаЗначений - накопительная таблица УУ
//  ГруппаДоговоров - Структура       - Признаки, Договоры
//  ДатаОстатков    - Граница         - та же граница, что для УУ; параметр запроса называется Период
//
Процедура ДобавитьДанныеССПоГруппе(ТаблицаУУ, ГруппаДоговоров, ДатаОстатков)

    // IMDEV-8663.2 этап 4
    Признаки = ГруппаДоговоров.Признаки;

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапросаСС(Истина);
    Запрос.УстановитьПараметр("Период",         ДатаОстатков);
    Запрос.УстановитьПараметр("ДоговорыГруппы", ГруппаДоговоров.Договоры);
    Запрос.УстановитьПараметр("НеПереоцениватьНезавершенныеСделкиПокупкиПоСС",
        Признаки.НеПереоцениватьНезавершенныеСделкиПокупкиПоСС);
    Запрос.УстановитьПараметр("НеПереоцениватьНезавершенныеСделкиПродажиПоСС",
        Признаки.НеПереоцениватьНезавершенныеСделкиПродажиПоСС);

    ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос,
        "Документ.РасчетСЧА_РСА.МодульМенеджера.ПолучитьСуммыРСА_СЧА_Пакетно() - СС незавершенных сделок");

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл

        Если Выборка.Дебиторка <> 0 Тогда
            НоваяСтрока = ТаблицаУУ.Добавить();
            НоваяСтрока.ДоговорДУ          = Выборка.ДоговорДУ;
            НоваяСтрока.Показатель         = Выборка.Актив;
            НоваяСтрока.ИсточникПоказателя = "Справедливая стоимость сделок Т+ (дебиторская задолженность)";
            НоваяСтрока.СуммаДляСЧА        = Выборка.Дебиторка;
            НоваяСтрока.СуммаДляРСА        = Выборка.Дебиторка;
        КонецЕсли;

        Если Выборка.Кредиторка <> 0 Тогда
            НоваяСтрока = ТаблицаУУ.Добавить();
            НоваяСтрока.ДоговорДУ          = Выборка.ДоговорДУ;
            НоваяСтрока.Показатель         = Выборка.Актив;
            НоваяСтрока.ИсточникПоказателя = "Справедливая стоимость сделок Т+ (кредиторская задолженность)";
            НоваяСтрока.СуммаДляСЧА        = -1 * Выборка.Кредиторка;
            // СуммаДляРСА не заполняем - закомментировано по ASP-34313 в однодоговорном расчете.
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
