#Область ПрограммныйИнтерфейс

#Область IMDEV_8663_2_Перехваты

	// IMDEV-8663.2 этап 4
	&ИзменениеИКонтроль("ПолучитьСуммыРСА_СЧА")
	Процедура IM86632_ПолучитьСуммыРСА_СЧА(ДоговорДУ, Дата, РасчетРСА, РасчетСЧА, СуммаРСА, СуммаСЧА, ТЗДанныеПоБУ = Неопределено, ТЗДанныеПоУУ = Неопределено, Отказ = Неопределено, ТекстОтказа = "", Ссылка = Неопределено) Экспорт
		
		ПС = ПланыСчетов.Хозрасчетный;
		ПВХ_Параметры = ПланыВидовХарактеристик.ПараметрыДоговораДУ;
		ВалютаРегл = ОбщегоНазначенияДУ.ВалютаРеглУчета(ДоговорДУ);
		
		// TM-3363 {
		ИнформационнаяПлощадка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорДУ, "ИнформационнаяПлощадка");
		КурсыВалют = МодульВалютногоУчета.КурсыВалютПоДатеПоПортфелю(ДоговорДУ, Дата);
		// TM-3363 }
		
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(ПВХ_Параметры.ОбособленныйУчетЗадолженностиЭмитента_УУ);
		МассивПараметров.Добавить(ПВХ_Параметры.ОбособленныйУчетЗадолженностиПоДивидендам_УУ);	
		МассивПараметров.Добавить(ПВХ_Параметры.УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ);
		МассивПараметров.Добавить(ПВХ_Параметры.ОценкаНезавершенныхСделокПоСС);
		МассивПараметров.Добавить(ПВХ_Параметры.НеПереоцениватьНезавершенныеСделкиПокупкиПоСС);  // ASP-80278
		МассивПараметров.Добавить(ПВХ_Параметры.НеПереоцениватьНезавершенныеСделкиПродажиПоСС);  // ASP-80278
		МассивПараметров.Добавить(ПВХ_Параметры.ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО); // ASP-60168
		МассивПараметров.Добавить(ПВХ_Параметры.ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО); // ASP-61305
		МассивПараметров.Добавить(ПВХ_Параметры.НеПереоцениватьНКДВОбратномРЕПО); // ASP-61305
		
		ЗначенияПараметров = РегистрыСведений.ЗначенияПараметровДоговораДУ.ЗначенияПараметровДоговораДУ(ДоговорДУ, МассивПараметров, Дата);
		
		ОбособленныйУчетЗадолженностиЭмитента_УУ 		= ЗначенияПараметров.Получить(ПВХ_Параметры.ОбособленныйУчетЗадолженностиЭмитента_УУ) = Истина;
		ОбособленныйУчетЗадолженностиПоДивидендам_УУ 	= ЗначенияПараметров.Получить(ПВХ_Параметры.ОбособленныйУчетЗадолженностиПоДивидендам_УУ) = Истина;	
		УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ 			= ЗначенияПараметров.Получить(ПВХ_Параметры.УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ) = Истина;
		ОценкаНезавершенныхСделокПоСС 					= ЗначенияПараметров.Получить(ПВХ_Параметры.ОценкаНезавершенныхСделокПоСС) = Истина;
		НеПереоцениватьНезавершенныеСделкиПокупкиПоСС 	= ЗначенияПараметров.Получить(ПВХ_Параметры.НеПереоцениватьНезавершенныеСделкиПокупкиПоСС) = Истина; // ASP-80278
		НеПереоцениватьНезавершенныеСделкиПродажиПоСС 	= ЗначенияПараметров.Получить(ПВХ_Параметры.НеПереоцениватьНезавершенныеСделкиПродажиПоСС) = Истина; // ASP-80278
		ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО  = ЗначенияПараметров.Получить(ПВХ_Параметры.ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО) = Истина; // ASP-60168
		ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО = ЗначенияПараметров.Получить(ПВХ_Параметры.ОтражатьДебиторскуюЗадолженностьПоОбратномуРЕПО) = Истина; // ASP-61305
		НеПереоцениватьНКДВОбратномРЕПО 				= ЗначенияПараметров.Получить(ПВХ_Параметры.НеПереоцениватьНКДВОбратномРЕПО) = Истина; // ASP-61305
		
		
		// Создаем ТЗ для заполнения
		ТЗДанныеПоУУ = Документы.РасчетСЧА_РСА.СоздатьДокумент().РасчетСЧА.Выгрузить(,"ИсточникПоказателя, Показатель");
		ТЗДанныеПоУУ.Колонки.Добавить("СуммаДляСЧА", ОбщегоНазначенияДУКлиентСервер.ПолучитьОписаниеТиповЧисла(20,2));
		ТЗДанныеПоУУ.Колонки.Добавить("СуммаДляРСА", ОбщегоНазначенияДУКлиентСервер.ПолучитьОписаниеТиповЧисла(20,2));
		
		///////////////////////////////////////////////////////////////////////
		// Дебиторская и кредиторская задолженность (БУ)
		
		#Область ИНИЦИАЛИЗАЦИЯ_ПОКАЗАТЕЛЕЙ
		
		// РСА
		СчетаДляРСА           = Новый Массив;
		СчетаДляРСА_Дт        = Новый Массив;
		СчетаИсключенияДляРСА = Новый Массив;
		
		Если РасчетРСА Тогда		
			
			// Счета для расчета РСА
			СчетаДляРСА_Дт.Добавить(ПС.РасчетыСРазнымиДебиторамиИКредиторами); //76
			
			// Счета исключения РСА
			СчетаИсключенияДляРСА.Добавить(ПС.РасчетыБрокера); 	// 76.01
			СчетаИсключенияДляРСА.Добавить(ПС.НКД); 			// 76.05
			СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоБанковскимСчетам); // 76.04.4
			
			Если ОбособленныйУчетЗадолженностиЭмитента_УУ = Истина Тогда
				СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоОблигациям); // 76.04.2.1
				СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоОблигациям_ПогашениеТела);// 76.04.2.2
			КонецЕсли;
			
			Если ОбособленныйУчетЗадолженностиПоДивидендам_УУ = Истина Тогда // TM-3427
				СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоДивидендам); // 76.04.1
				СчетаИсключенияДляРСА.Добавить(ПС.РасчетыПоПаямПИФ); // 76.04.9
			КонецЕсли;
			
		КонецЕсли;
		
		// СЧА
		СчетаДляСЧА = Новый Массив;
		СчетаИсключенияДляСЧА = Новый Массив;
		СчетаДляВычитанияИзСЧА = Новый Массив;  // TM-1880
		
		Если РасчетСЧА Тогда	    
			
			// Счета для расчета СЧА
			СчетаДляСЧА.Добавить(ПС.РасчетыСБюджетом); // 68
			СчетаДляСЧА.Добавить(ПС.РасчетыСРазнымиДебиторамиИКредиторами);	// 76	
			
			//Счета исключения
			СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыБрокера); 	// 76.01
			СчетаИсключенияДляСЧА.Добавить(ПС.НКД); 			// 76.05
			
			Если ОбособленныйУчетЗадолженностиПоДивидендам_УУ = Истина Тогда // TM-3427
				СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыПоДивидендам); // 76.04.1
				СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыПоПаямПИФ); 	// 76.04.9
			КонецЕсли;
			
			Если ОбособленныйУчетЗадолженностиЭмитента_УУ = Истина Тогда
				СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыПоОблигациям); // 76.04.2.1
				СчетаИсключенияДляСЧА.Добавить(ПС.РасчетыПоОблигациям_ПогашениеТела); // 76.04.2.2
			КонецЕсли;
			
			// Счета вычитания из СЧА
			Если ДоговорДУ.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеЧерезНПФ
				ИЛИ ДоговорДУ.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ПенсионныеРезервыНПФ Тогда
				СчетаДляВычитанияИзСЧА.Добавить(ПС.СредстваНаправляемыеВНПФДляОУД); //79.04
			ИначеЕсли ДоговорДУ.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеПФР Тогда
				СчетаДляВычитанияИзСЧА.Добавить(ПС.РасчетыСФондом); // 79.05
			КонецЕсли;
			
		КонецЕсли;	
		
		// Дефолтные счета
		СчетаДФО = Новый Массив;
		СчетаДФО.Добавить(ПС.ДефолтПоТелу);
		СчетаДФО.Добавить(ПС.ДефолтПоКупону);
		
		ДатаОстатков = Новый Граница(КонецДня(Дата), ВидГраницы.Включая);
		
		#КонецОбласти	
		
		СуммаРСА = 0;
		СуммаСЧА = 0;
		
		Запрос = Новый Запрос;
		
		#Область ТЕКСТ_ЗАПРОСА
		
		#Удаление
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ХозрасчетныйОстатки.Счет КАК ИсточникПоказателя,
		|	ХозрасчетныйОстатки.Субконто1 КАК Показатель,
		|	ВЫБОР
		|		КОГДА ХозрасчетныйОстатки.Счет В (&СчетаДФО)
		|			ТОГДА -1 * ХозрасчетныйОстатки.СуммаОстатокДт
		|		КОГДА ХозрасчетныйОстатки.Счет В ИЕРАРХИИ (&СчетаДляРСА_Дт)
		|				И НЕ ХозрасчетныйОстатки.Счет В ИЕРАРХИИ (&СчетаИсключенияДляРСА)
		|			ТОГДА ХозрасчетныйОстатки.СуммаРазвернутыйОстатокДт
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаДляРСА,
		|	ВЫБОР
		|		КОГДА ХозрасчетныйОстатки.Счет В (&СчетаДФО)
		|			ТОГДА -1 * ХозрасчетныйОстатки.СуммаОстатокДт
		|		КОГДА ХозрасчетныйОстатки.Счет В ИЕРАРХИИ (&СчетаДляСЧА)
		|				И НЕ ХозрасчетныйОстатки.Счет В ИЕРАРХИИ (&СчетаИсключенияДляСЧА)
		|			ТОГДА ВЫБОР
		|					КОГДА ХозрасчетныйОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоБанковскимСчетам))
		|						ТОГДА ВЫБОР
		|								КОГДА ХозрасчетныйОстатки.СуммаОстатокКт > 0
		|									ТОГДА ХозрасчетныйОстатки.СуммаОстаток
		|								ИНАЧЕ 0
		|							КОНЕЦ
		|					ИНАЧЕ ХозрасчетныйОстатки.СуммаОстаток
		|				КОНЕЦ
		|		КОГДА ХозрасчетныйОстатки.Счет В (&СчетаДляВычитанияИзСЧА)
		|			ТОГДА -1 * ХозрасчетныйОстатки.СуммаОстатокКт
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаДляСЧА
		|ПОМЕСТИТЬ ВТ_ПромежуточнаяТаблица
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&ДатаОстатков,
		|			Счет В ИЕРАРХИИ (&СчетаДляРСА_Дт)
		|					И НЕ Счет В ИЕРАРХИИ (&СчетаИсключенияДляРСА)
		|				ИЛИ Счет В ИЕРАРХИИ (&СчетаДляСЧА)
		|					И НЕ Счет В ИЕРАРХИИ (&СчетаИсключенияДляСЧА)
		|				ИЛИ Счет В (&СчетаДФО)
		|				ИЛИ Счет В (&СчетаДляВычитанияИзСЧА),
		|			,
		|			ДоговорДУ = &ДоговорДУ) КАК ХозрасчетныйОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя КАК ИсточникПоказателя,
		|	ВТ_ПромежуточнаяТаблица.Показатель КАК Показатель,
		|	СУММА(ВТ_ПромежуточнаяТаблица.СуммаДляСЧА) КАК СуммаДляСЧА,
		|	СУММА(ВТ_ПромежуточнаяТаблица.СуммаДляРСА) КАК СуммаДляРСА
		|ИЗ
		|	ВТ_ПромежуточнаяТаблица КАК ВТ_ПромежуточнаяТаблица
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя,
		|	ВТ_ПромежуточнаяТаблица.Показатель
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИсточникПоказателя,
		|	Показатель
		|АВТОУПОРЯДОЧИВАНИЕ";	
		#КонецУдаления
		#Вставка
		// IMDEV-8663.2 этап 4: те же конструкторы, что и пакетный путь (АР-4)
		Запрос.Текст = ТекстЗапросаБУ(Ложь);
		#КонецВставки
		
		#КонецОбласти
		
		Запрос.УстановитьПараметр("ДоговорДУ"   		  , ДоговорДУ);
		Запрос.УстановитьПараметр("ДатаОстатков"		  , ДатаОстатков);
		Запрос.УстановитьПараметр("СчетаДляРСА_Дт"        , СчетаДляРСА_Дт);
		Запрос.УстановитьПараметр("СчетаИсключенияДляРСА" , СчетаИсключенияДляРСА);
		Запрос.УстановитьПараметр("СчетаИсключенияДляСЧА" , СчетаИсключенияДляСЧА);
		Запрос.УстановитьПараметр("СчетаДляСЧА"           , СчетаДляСЧА);
		Запрос.УстановитьПараметр("СчетаДФО"          	  , СчетаДФО);
		Запрос.УстановитьПараметр("СчетаДляВычитанияИзСЧА", СчетаДляВычитанияИзСЧА);
		
		Результат = Запрос.Выполнить();		                       
		ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "Документ.РасчетСЧА_РСА.МодульМенеджера.ПолучитьСуммыРСА_СЧА(); (БУ)");
		
		ТЗДанныеПоБУ = Результат.Выгрузить();
		Для каждого ТекСтрока Из ТЗДанныеПоБУ Цикл
			
			Если РасчетСЧА Тогда
				СуммаСЧА = СуммаСЧА + ТекСтрока.СуммаДляСЧА;
			КонецЕсли;
			
			Если РасчетРСА Тогда
				СуммаРСА = СуммаРСА + ТекСтрока.СуммаДляРСА;
			КонецЕсли;	
			
		КонецЦикла;
		
		
		////////////////////////////////////////////////////////////
		// Данные с регистров УУ
		
		ЗапросУУ = Новый Запрос;
		
		#Область ТЕКСТ_ЗАПРОСА
		
		#Удаление
		ЗапросУУ.Текст = 
		"ВЫБРАТЬ
		|	СтоимостьАктивовУправленческийОстатки.Актив КАК Показатель,
		|	""Стоимость активов (УУ)"" КАК ИсточникПоказателя,
		|	СтоимостьАктивовУправленческийОстатки.СуммаОстаток КАК СуммаДляРСА,
		|	СтоимостьАктивовУправленческийОстатки.СуммаОстаток КАК СуммаДляСЧА
		|ПОМЕСТИТЬ ВТ_ПромежуточнаяТаблица
		|ИЗ
		|	РегистрНакопления.СтоимостьАктивовУправленческий.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК СтоимостьАктивовУправленческийОстатки
		|ГДЕ
		|	СтоимостьАктивовУправленческийОстатки.КоличествоОстаток <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачисленныйКупонныйДоходУправленческийОстатки.Облигация,
		|	""Начисленный купонный доход (УУ)"",
		|	НачисленныйКупонныйДоходУправленческийОстатки.СуммаОстаток,
		|	НачисленныйКупонныйДоходУправленческийОстатки.СуммаОстаток
		|ИЗ
		|	РегистрНакопления.НачисленныйКупонныйДоходУправленческий.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК НачисленныйКупонныйДоходУправленческийОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УУ_ЦенныеБумагиHTMОстатки.Партия,
		|	""Ценные бумаги HTM (УУ)"",
		|	УУ_ЦенныеБумагиHTMОстатки.СуммаОстаток,
		|	УУ_ЦенныеБумагиHTMОстатки.СуммаОстаток
		|ИЗ
		|	РегистрНакопления.УУ_ЦенныеБумагиHTM.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК УУ_ЦенныеБумагиHTMОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УУ_НКДПоЦеннымБумагамHTMОстатки.Партия,
		|	""НКД по ценным бумагам HTM (УУ)"",
		|	УУ_НКДПоЦеннымБумагамHTMОстатки.СуммаОстаток,
		|	УУ_НКДПоЦеннымБумагамHTMОстатки.СуммаОстаток
		|ИЗ
		|	РегистрНакопления.УУ_НКДПоЦеннымБумагамHTM.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК УУ_НКДПоЦеннымБумагамHTMОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КорректировкиПоЭСПОблигации.Партия,
		|	""Корректировки по ЭСП (облигации)"",
		|	КорректировкиПоЭСПОблигации.СуммаОстаток,
		|	КорректировкиПоЭСПОблигации.СуммаОстаток
		|ИЗ
