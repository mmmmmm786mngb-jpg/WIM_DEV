        |	УУ_НКДПоЦеннымБумагамHTMОстатки.Партия,
        |	""НКД по ценным бумагам HTM (УУ)"",
        |	УУ_НКДПоЦеннымБумагамHTMОстатки.СуммаОстаток,
        |	УУ_НКДПоЦеннымБумагамHTMОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.УУ_НКДПоЦеннымБумагамHTM.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК УУ_НКДПоЦеннымБумагамHTMОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	КорректировкиПоЭСПОблигации.Партия,
        |	""Корректировки по ЭСП (облигации)"",
        |	КорректировкиПоЭСПОблигации.СуммаОстаток,
        |	КорректировкиПоЭСПОблигации.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.КорректировкиПоЭСПОблигации.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК КорректировкиПоЭСПОблигации
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	НачисленныеПроцентыПоБанковскимСчетамУправленческийОстатки.АналитическийСчет,
        |	""Начисленные проценты по банковским счетам (УУ)"",
        |	НачисленныеПроцентыПоБанковскимСчетамУправленческийОстатки.СуммаОстаток,
        |	НачисленныеПроцентыПоБанковскимСчетамУправленческийОстатки.СуммаОстаток
        |ИЗ
        |	РегистрНакопления.НачисленныеПроцентыПоБанковскимСчетамУправленческий.Остатки(&ДатаОстатков, ДоговорДУ = &ДоговорДУ) КАК НачисленныеПроцентыПоБанковскимСчетамУправленческийОстатки
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |	ЗадолженностьЭмитентаПоОблигациямУУОстатки.Актив,
        |	""Задолженность эмитента по облигациям (УУ)"",
        |	ЗадолженностьЭмитентаПоОблигациямУУОстатки.СуммаОстаток,
        |	ЗадолженностьЭмитентаПоОблигациямУУОстатки.СуммаОстаток
        |ИЗ
