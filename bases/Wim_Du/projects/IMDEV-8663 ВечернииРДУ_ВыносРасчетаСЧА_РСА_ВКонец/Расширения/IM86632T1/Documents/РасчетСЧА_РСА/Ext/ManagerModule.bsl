// Описание: Вставляет поле ДоговорДУ первой колонкой выборки перед указанным маркером поля.
// Маркер - фрагмент текста запроса БЕЗ символа "|" (это синтаксис многострочной строки 1С,
// в значении ТекстЗапроса его нет). Строки запроса в литерале начинаются с табуляции после "|".
//
// Параметры:
//  ТекстЗапроса   - Строка - исходный текст запроса
//  МаркерПоля     - Строка - уникальный фрагмент первой колонки выборки, включая запятую
//  ИмяТаблицы     - Строка - псевдоним таблицы, у которой есть измерение ДоговорДУ
//  СПсевдонимом   - Булево - Истина для первой выборки пакета/объединения (нужен КАК ДоговорДУ)
//
// Возвращаемое значение:
//  Строка - текст запроса с добавленным полем
//
Функция ВставитьПолеДоговорДУПеред(ТекстЗапроса, МаркерПоля, ИмяТаблицы, СПсевдонимом)

    // IMDEV-8663.2 этап 4
    НовоеПоле = ИмяТаблицы + ".ДоговорДУ";
    Если СПсевдонимом Тогда
        НовоеПоле = НовоеПоле + " КАК ДоговорДУ";
    КонецЕсли;

    Возврат СтрЗаменить(
        ТекстЗапроса,
        МаркерПоля,
        НовоеПоле + "," + Символы.ПС + Символы.Таб + МаркерПоля);

КонецФункции

// Описание: Возвращает однодоговорной текст запроса БУ (копия области ТЕКСТ_ЗАПРОСА, ПолучитьСуммыРСА_СЧА). Единственный источник методики БУ.
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаОднодоговорныйБУ()

    // IMDEV-8663.2 этап 4
    Возврат
        "ВЫБРАТЬ
        |	ХозрасчетныйОстатки.Счет КАК ИсточникПоказателя,
        |	ХозрасчетныйОстатки.Субконто1 КАК Показатель,
        |	ВЫБОР
        |		КОГДА ХозрасчетныйОстатки.Счет В (&СчетаДФО)
        |			ТОГДА -1 * ХозрасчетныйОстатки.СуммаОстатокДт
        |		КОГДА ХозрасчетныйОстатки.Счет В ИЕРАРХИИ (&СчетаДляРСА_Дт)
        |				И НЕ ХозрасчетныйОстатки.Счет В ИЕРАРХИИ (&СчетаИсключенияДляРСА)
        |			ТОГДА ХозрасчетныйОстатки.СуммаРазвернутыйОстатокДт
        |		ИНАЧЕ 0
        |	КОНЕЦ КАК СуммаДляРСА,
        |	ВЫБОР
        |		КОГДА ХозрасчетныйОстатки.Счет В (&СчетаДФО)
        |			ТОГДА -1 * ХозрасчетныйОстатки.СуммаОстатокДт
        |		КОГДА ХозрасчетныйОстатки.Счет В ИЕРАРХИИ (&СчетаДляСЧА)
        |				И НЕ ХозрасчетныйОстатки.Счет В ИЕРАРХИИ (&СчетаИсключенияДляСЧА)
        |			ТОГДА ВЫБОР
        |					КОГДА ХозрасчетныйОстатки.Счет В (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоБанковскимСчетам))
        |						ТОГДА ВЫБОР
        |								КОГДА ХозрасчетныйОстатки.СуммаОстатокКт > 0
        |									ТОГДА ХозрасчетныйОстатки.СуммаОстаток
        |								ИНАЧЕ 0
        |							КОНЕЦ
        |					ИНАЧЕ ХозрасчетныйОстатки.СуммаОстаток
        |				КОНЕЦ
        |		КОГДА ХозрасчетныйОстатки.Счет В (&СчетаДляВычитанияИзСЧА)
        |			ТОГДА -1 * ХозрасчетныйОстатки.СуммаОстатокКт
        |		ИНАЧЕ 0
        |	КОНЕЦ КАК СуммаДляСЧА
        |ПОМЕСТИТЬ ВТ_ПромежуточнаяТаблица
        |ИЗ
        |	РегистрБухгалтерии.Хозрасчетный.Остатки(
        |			&ДатаОстатков,
        |			Счет В ИЕРАРХИИ (&СчетаДляРСА_Дт)
        |					И НЕ Счет В ИЕРАРХИИ (&СчетаИсключенияДляРСА)
        |				ИЛИ Счет В ИЕРАРХИИ (&СчетаДляСЧА)
        |					И НЕ Счет В ИЕРАРХИИ (&СчетаИсключенияДляСЧА)
        |				ИЛИ Счет В (&СчетаДФО)
        |				ИЛИ Счет В (&СчетаДляВычитанияИзСЧА),
        |			,
        |			ДоговорДУ = &ДоговорДУ) КАК ХозрасчетныйОстатки
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя КАК ИсточникПоказателя,
        |	ВТ_ПромежуточнаяТаблица.Показатель КАК Показатель,
        |	СУММА(ВТ_ПромежуточнаяТаблица.СуммаДляСЧА) КАК СуммаДляСЧА,
        |	СУММА(ВТ_ПромежуточнаяТаблица.СуммаДляРСА) КАК СуммаДляРСА
        |ИЗ
        |	ВТ_ПромежуточнаяТаблица КАК ВТ_ПромежуточнаяТаблица
        |
        |СГРУППИРОВАТЬ ПО
        |	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя,
        |	ВТ_ПромежуточнаяТаблица.Показатель
        |
        |УПОРЯДОЧИТЬ ПО
        |	ИсточникПоказателя,
        |	Показатель
        |АВТОУПОРЯДОЧИВАНИЕ";

КонецФункции

// Описание: Возвращает текст запроса БУ для расчета РСА/СЧА.
// Пакетный режим отличается ТОЛЬКО отбором, колонкой ДоговорДУ и группировкой.
//
// Параметры:
//  Пакетно - Булево - Истина: отбор В (&ДоговорыГруппы) и группировка по ДоговорДУ
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаБУ(Пакетно)

    // IMDEV-8663.2 этап 4
    ТекстЗапроса = ТекстЗапросаОднодоговорныйБУ();

    Если Не Пакетно Тогда
        Возврат ТекстЗапроса;
    КонецЕсли;

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДоговорДУ = &ДоговорДУ", "ДоговорДУ В (&ДоговорыГруппы)");

    ТекстЗапроса = ВставитьПолеДоговорДУПеред(
        ТекстЗапроса,
        "ХозрасчетныйОстатки.Счет КАК ИсточникПоказателя,",
        "ХозрасчетныйОстатки",
        Истина);

    ТекстЗапроса = ВставитьПолеДоговорДУПеред(
        ТекстЗапроса,
        "ВТ_ПромежуточнаяТаблица.ИсточникПоказателя КАК ИсточникПоказателя,",
        "ВТ_ПромежуточнаяТаблица",
        Истина);

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
        "СГРУППИРОВАТЬ ПО
        |	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя,
        |	ВТ_ПромежуточнаяТаблица.Показатель",
        "СГРУППИРОВАТЬ ПО
        |	ВТ_ПромежуточнаяТаблица.ДоговорДУ,
        |	ВТ_ПромежуточнаяТаблица.ИсточникПоказателя,
        |	ВТ_ПромежуточнаяТаблица.Показатель");

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
        "УПОРЯДОЧИТЬ ПО
        |	ИсточникПоказателя,
        |	Показатель",
        "УПОРЯДОЧИТЬ ПО
        |	ДоговорДУ,
        |	ИсточникПоказателя,
        |	Показатель");

    Возврат ТекстЗапроса;

КонецФункции

// Описание: Возвращает однодоговорной текст запроса УУ (копия области ТЕКСТ_ЗАПРОСА, ПолучитьСуммыРСА_СЧА). Единственный источник методики УУ.
