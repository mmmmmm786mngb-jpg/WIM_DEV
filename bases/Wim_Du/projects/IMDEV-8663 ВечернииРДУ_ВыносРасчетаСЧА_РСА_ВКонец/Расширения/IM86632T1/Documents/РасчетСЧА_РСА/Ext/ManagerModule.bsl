			//	НоваяСтрока.ИсточникПоказателя 	= "Справедливая стоимость сделок Т+";
			//	НоваяСтрока.СуммаДляСЧА 		= ССНезавершенныхСделок.Дебиторка;
			//	НоваяСтрока.СуммаДляРСА 		= ССНезавершенныхСделок.Дебиторка;
			//КонецЕсли;
			//
