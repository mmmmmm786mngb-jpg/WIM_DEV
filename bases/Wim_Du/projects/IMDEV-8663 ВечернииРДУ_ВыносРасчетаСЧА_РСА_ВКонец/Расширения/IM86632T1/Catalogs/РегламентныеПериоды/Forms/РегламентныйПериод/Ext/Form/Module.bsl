// Расширение IM86632: разделение запуска вечерних операций и расчета СЧА/РСА (этап 2).
// Пакетный расчет операции 1000 на этом этапе не включается.
// Префикс IM86632_ только у перехватов типовых методов.
// Новые процедуры, реквизиты формы, константа и роль - без префикса
// (вендор перенесет их в базовую конфигурацию).

#Область ПрограммныйИнтерфейс

&НаКлиенте
&ИзменениеИКонтроль("СформироватьРегламентныеОперации")
Процедура IM86632_СформироватьРегламентныеОперации(УчитыватьВыполненные = Ложь) // ASP-196537
	
	// Подготовка параметров для запуска фонового задания
	НаименованиеФоновогоЗадания = "ФоновоеЗадание:" + ЭтаФорма.УникальныйИдентификатор;
	СписокДоговоровДУ = ПолучитьДоговораДУпоДинамическомуСписку(УчитыватьВыполненные);
	
	#Вставка
	// IMDEV-8663.2: запоминаем код группы, не ссылку.
	// Реквизит кэша в расширении без заимствования ВидыОперацийЗакрытияПериода
	// на форме становится строкой (представление), сравнение со ссылкой всегда Ложь.
	Если ПодготовитьЗапускРегламентаНаСервере(УчитыватьВыполненные, СписокДоговоровДУ) Тогда
		
		Оповещение = Новый ОписаниеОповещения(
			"ПослеПредупрежденияОПересчетеСЧА",
			ЭтотОбъект,
			УчитыватьВыполненные);
		ПоказатьВопрос(
			Оповещение,
			НСтр("ru='Вечерние операции будут пересчитаны.
				|Документы расчета СЧА/РСА за этот день станут неактуальными.
				|Их нужно будет пересчитать отдельно - запустите группу «3. Расчет СЧА/РСА».
				|Продолжить?'"),
			РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	#КонецВставки
	
	// Валидация данных формы
	Если РеглПериод.Пустая() Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru='Период: %1 не существует'"),
			ДатаПериода);
		ОбщегоНазначенияДУКлиентСервер.СообщитьОбОшибке(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоАдресВременногоХранилища(АдресВременногоХранилища) Тогда
		ТекстОшибки = НСтр("ru='Ошибка подготовки данных для проведения регламентных операций'");
		ОбщегоНазначенияДУКлиентСервер.СообщитьОбОшибке(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	РезультатЗадания = СформироватьРегламентныеОперацииНаСервере(
		ДатаПериода,
		СписокДоговоровДУ,
		УчитыватьВыполненные,
		НаименованиеФоновогоЗадания);
	
	// Обработка результата запуска задания
	Если РезультатЗадания.Статус = "Выполняется" Тогда
		// Задание запущено в фоне - начинаем отслеживание прогресса
		НачатьОтслеживаниеЗадания(РезультатЗадания);
	ИначеЕсли РезультатЗадания.Статус = "Ошибка" Тогда
		// Ошибка при запуске задания
		ПоказатьПредупреждениеОбОшибке(РезультатЗадания.ПодробноеПредставлениеОшибки);
	ИначеЕсли РезультатЗадания.Статус = "Выполнено" Тогда
		// Задание завершилось синхронно (например, в режиме отладки)
		ОбработатьРезультатЗадания(РезультатЗадания, Неопределено);
	КонецЕсли;
  	
КонецПроцедуры // СформироватьРегламентныеОперации()

&НаКлиенте
&ИзменениеИКонтроль("ОбработатьРезультатЗадания")
Процедура IM86632_ОбработатьРезультатЗадания(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Состояние(НСтр("ru='Задание отменено пользователем'"));
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		// Проверка наличия адреса результата
		Если Не ЭтоАдресВременногоХранилища(Результат.АдресРезультата) Тогда
			ПоказатьПредупреждениеОбОшибке(НСтр("ru='Результат не получен (пустое хранилище)'"));
			Возврат;
		КонецЕсли;
		
		// Извлечение результата из временного хранилища
		Данные = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		
		Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("Успешно") Тогда
			
			Если Данные.Успешно Тогда
				// Успешное завершение - обновление интерфейса
				Состояние(
					НСтр("ru='Регламентные операции успешно сформированы'"),
					100,
					,
					БиблиотекаКартинок.ЗапуститьОтдельныйСеансДляВыполненияРегламентныхЗаданий);
				
				ЗавершитьОбработкуПослеУспехаНаКлиенте();
				
				#Вставка
				// IMDEV-8663.2: цепочка группы 3 или сообщение ОВ-3.
				// АдресВременногоХранилища уже очищен - это нормально:
				// второй вызов СформироватьРегламентныеОперации снова заполнит его
				// внутри ПолучитьДоговораДУпоДинамическомуСписку.
				ПослеУспешногоЗавершенияГруппы();
				#КонецВставки
			Иначе
				// Ошибка в процессе выполнения
				ТекстОшибки = ?(Данные.Свойство("Сообщение"), Данные.Сообщение, НСтр("ru='Ошибка в результате выполнения'"));
				ПоказатьПредупреждениеОбОшибке(ТекстОшибки);
			КонецЕсли;
			
		Иначе
			ПоказатьПредупреждениеОбОшибке(НСтр("ru='Некорректный формат результата задания'"));
		КонецЕсли;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждениеОбОшибке(Результат.ПодробноеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Отменено" Тогда
		Состояние(НСтр("ru='Задание отменено'"));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область IMDEV_8663_2_ЗапускГруппыСЧА

&НаСервере
&После("ПриСозданииНаСервере")
Процедура IM86632_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    НастроитьФормуСЧАНаСервере(Истина);

КонецПроцедуры

&НаКлиенте
&После("ГруппаРегламентныхОперацийПриИзменении")
Процедура IM86632_ГруппаРегламентныхОперацийПриИзменении(Элемент)

    НастроитьФормуСЧАНаСервере();

КонецПроцедуры

// Описание: Продолжает запуск вечерних после подтверждения предупреждения ОВ-3.
//
// Параметры:
//  РезультатВопроса - КодВозвратаДиалога - ответ пользователя
//  УчитыватьВыполненные - Булево - признак запуска с учетом выполненных
//
&НаКлиенте
Процедура ПослеПредупрежденияОПересчетеСЧА(РезультатВопроса, УчитыватьВыполненные) Экспорт

    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ПропуститьПредупреждениеСЧА = Истина;
    СформироватьРегламентныеОперации(УчитыватьВыполненные);
    ПропуститьПредупреждениеСЧА = Ложь;

КонецПроцедуры

// Описание: После успешного завершения группы 2 запускает группу 3 или напоминает пересчитать СЧА/РСА.
//
&НаКлиенте
Процедура ПослеУспешногоЗавершенияГруппы()

    Если ГруппаЗапуска <> КодВечернейГруппы Тогда
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(КодГруппыСЧА) Тогда
        Возврат;
    КонецЕсли;

    Если ЗапускатьРасчетСЧАПослеВечерних Тогда

        // Как вручную: сменить группу, обновить дерево, Заполнить (План -> Факт), Создать.
        // Без обновления дерева ПолучитьДоговораДУпоДинамическомуСписку соберет
        // операции группы 2. Без Заполнить у несчитанных операций Факт = 0, вторая ДО ничего не создаст.
        // Группу 3 ставим ссылкой через НайтиПоКоду, не строкой из кэша.
        // Видимость флажка зависит только от выбранной группы, поэтому её можно обновить
        // сразу при подстановке группы 3, до обновления дерева.
        НастроитьФормуСЧАНаСервере(Ложь, Истина);
        ОбновитьРеглОперацииНаСервере();
        ЗаполнитьРеглОперацииНаСервере();
        РазвернутьДерево("ДеревоРеглОпераций");
        СформироватьРегламентныеОперации(УчитыватьВыполненныеЗапуска);

    Иначе
        ПоказатьОповещениеПользователя(
            НСтр("ru='Расчет СЧА/РСА не запускался'"),
            ,
            НСтр("ru='Пересчитайте группу «3. Расчет СЧА/РСА».'"));
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапускатьРасчетСЧАПослеВечернихПриИзменении(Элемент)

    СохранитьФлагАвтозапускаНаСервере();

КонецПроцедуры

// Описание: Запоминает код запускаемой группы и признак "с учетом выполненных".
// Возвращает Истина, если перед стартом вечерних нужно показать предупреждение ОВ-3.
//
// Параметры:
//  УчитыватьВыполненные - Булево - признак запуска с учетом выполненных
//  СписокДоговоровДУ - Массив - отобранные договоры ДУ
//
// Возвращаемое значение:
//  Булево - Истина, если нужно показать вопрос о пересчете СЧА/РСА
//
&НаСервере
Функция ПодготовитьЗапускРегламентаНаСервере(УчитыватьВыполненные, СписокДоговоровДУ)

    Если ЗначениеЗаполнено(ГруппаРегламентныхОпераций) Тогда
        ГруппаЗапуска = ГруппаРегламентныхОпераций.Код;
    Иначе
        ГруппаЗапуска = "";
    КонецЕсли;
    УчитыватьВыполненныеЗапуска = УчитыватьВыполненные;

    Если ПропуститьПредупреждениеСЧА Тогда
        Возврат Ложь;
    КонецЕсли;

    Если ГруппаЗапуска <> КодВечернейГруппы Тогда
        Возврат Ложь;
    КонецЕсли;

    Если ЗапускатьРасчетСЧАПослеВечерних Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат Справочники.РегламентныеПериоды.ЕстьПланыГруппыСЧА(ДатаПериода, СписокДоговоровДУ);

КонецФункции

// Описание: Записывает флаг автозапуска группы 3 в хранилище общих настроек пользователя.
//
&НаСервере
Процедура СохранитьФлагАвтозапускаНаСервере()

    ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
        "IM86632_РегламентныйПериод",
        "ЗапускатьРасчетСЧАПослеВечерних",
        ЗапускатьРасчетСЧАПослеВечерних);

КонецПроцедуры

// Описание: Настраивает реквизиты и видимость флажка автозапуска группы 3 на форме периода.
//
// Параметры:
//  ЗаполнитьРеквизиты - Булево - заполнить коды групп и прочитать флаг из хранилища
//  УстановитьГруппуСЧА - Булево - подставить группу 3 в ГруппаРегламентныхОпераций
//
&НаСервере
Процедура НастроитьФормуСЧАНаСервере(ЗаполнитьРеквизиты = Ложь, УстановитьГруппуСЧА = Ложь)

    Если ЗаполнитьРеквизиты Тогда
        КодВечернейГруппы = Справочники.РегламентныеПериоды.КодВечернейГруппыОпераций();
        КодСЧА = Справочники.РегламентныеПериоды.КодГруппыРасчетаСЧА_РСА();
        НайденнаяГруппаСЧА = Справочники.ВидыОперацийЗакрытияПериода.НайтиПоКоду(КодСЧА);
        Если НайденнаяГруппаСЧА.Пустая() Тогда
            КодГруппыСЧА = "";
        Иначе
            КодГруппыСЧА = КодСЧА;
        КонецЕсли;
        Сохраненное = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
            "IM86632_РегламентныйПериод",
            "ЗапускатьРасчетСЧАПослеВечерних");
        Если Сохраненное = Неопределено Тогда
            ЗапускатьРасчетСЧАПослеВечерних = Истина;
        Иначе
            ЗапускатьРасчетСЧАПослеВечерних = (Сохраненное = Истина);
        КонецЕсли;
        ПропуститьПредупреждениеСЧА = Ложь;
    КонецЕсли;

    Если УстановитьГруппуСЧА Тогда
        ГруппаРегламентныхОпераций = Справочники.ВидыОперацийЗакрытияПериода.НайтиПоКоду(КодГруппыСЧА);
    КонецЕсли;

    КодТекущейГруппы = "";
    Если ЗначениеЗаполнено(ГруппаРегламентныхОпераций) Тогда
        КодТекущейГруппы = ГруппаРегламентныхОпераций.Код;
    КонецЕсли;

    ФлагДоступен = (КодТекущейГруппы = КодВечернейГруппы)
        И ЗначениеЗаполнено(КодГруппыСЧА);
    Если Элементы.Найти("ЗапускатьРасчетСЧАПослеВечерних") <> Неопределено Тогда
        Элементы.ЗапускатьРасчетСЧАПослеВечерних.Видимость = ФлагДоступен;
    КонецЕсли;

КонецПроцедуры

#КонецОбласти
