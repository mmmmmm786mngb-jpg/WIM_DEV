#Область IMDEV_8663_2_Перехваты

// Описание: Заполняет табличные части документа данными расчета РСА/СЧА.
//
// Параметры:
//  Отказ         - Булево    - признак отказа
//  ТекстОтказа   - Строка    - текст отказа
//  ГотовыеДанные - Структура - IMDEV-8663.2 этап 3, необязательный. Предрассчитанные пакетно данные:
//                  * ТаблицаБУ - ТаблицаЗначений - строки по данным БУ для этого договора
//                  * ТаблицаУУ - ТаблицаЗначений - строки по данным УУ для этого договора
//                  Если не передан - расчет выполняется обычным (однодоговорным) способом.
//
// IMDEV-8663.2 этап 3
&ИзменениеИКонтроль("ПолучитьСуммыРСАСЧА")
Процедура IM86632_ПолучитьСуммыРСАСЧА(Отказ = Неопределено, ТекстОтказа = "", ГотовыеДанные = Неопределено) Экспорт
	
	СуммаРСА = 0;
	СуммаСЧА = 0;
	ТЗДанныеПоБУ = Неопределено;
	ТЗДанныеПоУУ = Неопределено;
	
	#Удаление
	Документы.РасчетСЧА_РСА.ПолучитьСуммыРСА_СЧА(ДоговорДУ, ПолучитьДатуСВременемОкончанияРабочегоДня(Дата), РСА, СЧА, СуммаРСА, СуммаСЧА,  ТЗДанныеПоБУ, ТЗДанныеПоУУ, Отказ, ТекстОтказа, Ссылка);
	#КонецУдаления
	#Вставка
	// IMDEV-8663.2 этап 3: используем пакетно рассчитанные данные, если они переданы и корректны
	ИспользоватьГотовыеДанные = ТипЗнч(ГотовыеДанные) = Тип("Структура")
		И ГотовыеДанные.Свойство("ТаблицаБУ")
		И ГотовыеДанные.Свойство("ТаблицаУУ")
		И ТипЗнч(ГотовыеДанные.ТаблицаБУ) = Тип("ТаблицаЗначений")
		И ТипЗнч(ГотовыеДанные.ТаблицаУУ) = Тип("ТаблицаЗначений");
	// Пустая ТЗ - валидный пакетный результат (нулевые остатки), не повод для fallback.
	
	Если ИспользоватьГотовыеДанные Тогда
		ТЗДанныеПоБУ = ГотовыеДанные.ТаблицаБУ;
		ТЗДанныеПоУУ = ГотовыеДанные.ТаблицаУУ;
	Иначе
		Документы.РасчетСЧА_РСА.ПолучитьСуммыРСА_СЧА(ДоговорДУ, ПолучитьДатуСВременемОкончанияРабочегоДня(Дата), РСА, СЧА, СуммаРСА, СуммаСЧА, ТЗДанныеПоБУ, ТЗДанныеПоУУ, Отказ, ТекстОтказа, Ссылка);
	КонецЕсли;
	#КонецВставки
	
	Если РСА Тогда
		РасчетРСА.Очистить();
		СуммаРСА = СуммаРСА;
	КонецЕсли;
	Если СЧА Тогда
		РасчетСЧА.Очистить();		
		СуммаСЧА = СуммаСЧА;
	КонецЕсли;
	
	// Обрабатываем данные по БУ
	Для каждого ТекСтрока Из ТЗДанныеПоБУ Цикл
		
		Если СЧА И ТекСтрока.СуммаДляСЧА <> 0 Тогда
			НоваяСтрокаСЧА = РасчетСЧА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСЧА, ТекСтрока);
			НоваяСтрокаСЧА.Сумма      = ТекСтрока.СуммаДляСЧА;
		КонецЕсли;			
		
		Если РСА И ТекСтрока.СуммаДляРСА <> 0 Тогда
			НоваяСтрокаРСА = РасчетРСА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРСА, ТекСтрока);
			НоваяСтрокаРСА.Сумма      = ТекСтрока.СуммаДляРСА;
		КонецЕсли;		
		
	КонецЦикла;
	
	// Обрабатываем данные по УУ
	Для каждого ТекСтрока Из ТЗДанныеПоУУ Цикл
		
		Если СЧА И ТекСтрока.СуммаДляСЧА <> 0 Тогда
			НоваяСтрокаСЧА = РасчетСЧА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСЧА, ТекСтрока);
			НоваяСтрокаСЧА.Сумма      = ТекСтрока.СуммаДляСЧА;		
		КонецЕсли;
		
		Если РСА И ТекСтрока.СуммаДляРСА <> 0 Тогда			
			НоваяСтрокаРСА = РасчетРСА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРСА, ТекСтрока);
			НоваяСтрокаРСА.Сумма      = ТекСтрока.СуммаДляРСА;			
		КонецЕсли;
		
	КонецЦикла;
	
	
	//РасчетСЧА.Сортировать("Показатель");
	//РасчетРСА.Сортировать("Показатель");
	
КонецПроцедуры

#КонецОбласти
