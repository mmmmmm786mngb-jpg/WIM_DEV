#Область IMDEV_8663_2_СвязьГрупп

&НаСервере
&После("ПриЧтенииНаСервере")
Процедура IM86632_ПриЧтенииНаСервере(ТекущийОбъект)

    ЗаполнитьПланВечернихОперацийНаФорме();

КонецПроцедуры

// Описание: Заполняет реквизит формы ПланВечернихОпераций из плана-основания.
// ДокументОснование - составной тип, без проверки типа значение не читается.
//
&НаСервере
Процедура ЗаполнитьПланВечернихОперацийНаФорме()

    ПланВечернихОпераций = Неопределено;
    Если ТипЗнч(Объект.ДокументОснование) <> Тип("ДокументСсылка.ПланРегламентныхОперацийДУ") Тогда
        Возврат;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
        Возврат;
    КонецЕсли;

    ПланВечернихОпераций = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
        Объект.ДокументОснование, "ПланВечернихОпераций");

КонецПроцедуры

#КонецОбласти
