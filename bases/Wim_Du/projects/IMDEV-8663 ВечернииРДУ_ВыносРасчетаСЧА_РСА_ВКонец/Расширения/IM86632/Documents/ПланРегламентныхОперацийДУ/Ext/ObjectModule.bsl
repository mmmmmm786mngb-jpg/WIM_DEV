#Область IMDEV_8663_2_СвязьГрупп

// Описание: При ручной записи плана группы 3 заполняет ПланВечернихОпераций.
// Если реквизит уже заполнен (массовый контур), запрос не выполняется.
//
// Параметры:
//  Отказ - Булево - признак отказа записи
//  РежимЗаписи - РежимЗаписиДокумента - режим записи
//  РежимПроведения - РежимПроведенияДокумента - режим проведения
//
&После("ПередЗаписью")
Процедура IM86632_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если ОбменДанными.Загрузка Или Отказ Или ПометкаУдаления Тогда
        Возврат;
    КонецЕсли;
    Если ЗначениеЗаполнено(ПланВечернихОпераций) Тогда
        Возврат;
    КонецЕсли;

    ГруппаСЧА = Справочники.ВидыОперацийЗакрытияПериода.НайтиПоКоду(
        Справочники.РегламентныеПериоды.КодГруппыРасчетаСЧА_РСА());
    Если ГруппаСЧА.Пустая() Или ГруппаОперацийПользователя <> ГруппаСЧА Тогда
        Возврат;
    КонецЕсли;

    ПланВечернихОпераций = Справочники.РегламентныеПериоды.НайтиПроведенныйВечернийПлан(
        Дата, ДоговорДУ);
    Если Не ЗначениеЗаполнено(ПланВечернихОпераций) Тогда
        ТекстСообщения = НСтр("ru='Нет проведенного плана вечерних операций за эту дату по договору ДУ.
            |Документ расчета СЧА/РСА не записан.'");
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , , Отказ);
    КонецЕсли;

КонецПроцедуры

#КонецОбласти
