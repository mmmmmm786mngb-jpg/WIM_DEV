//  КодГруппы = Справочники.РегламентныеПериоды.КодВечернейГруппыОпераций();
//
Функция КодВечернейГруппыОпераций() Экспорт

    Возврат "2. ""Вечерние"" операции";

КонецФункции

// Описание: Возвращает код группы справочника ВидыОперацийЗакрытияПериода "3. Расчет СЧА/РСА".
//
// Возвращаемое значение:
//  Строка - код группы расчета СЧА/РСА
//
// Пример:
//  КодГруппы = Справочники.РегламентныеПериоды.КодГруппыРасчетаСЧА_РСА();
//
Функция КодГруппыРасчетаСЧА_РСА() Экспорт

    Возврат "3. ""Расчет СЧА/РСА""";

КонецФункции

#КонецОбласти

#Область IMDEV_8663_2_ПроверкаПлановГруппыСЧА

// Описание: Возвращает Истина, если по договорам за дату есть планы группы "3. Расчет СЧА/РСА"
// без пометки удаления (текущий расчет СЧА/РСА станет неактуальным после пересчета вечерних).
//
// Параметры:
//  ДатаПериода - Дата - дата регламентного периода
//  СписокДоговоровДУ - Массив - отобранные договоры ДУ
//
// Возвращаемое значение:
//  Булево - Истина, если найден хотя бы один план группы 3 без пометки удаления
//
// Пример:
//  ЕстьПланы = Справочники.РегламентныеПериоды.ЕстьПланыГруппыСЧА(ДатаПериода, СписокДоговоровДУ);
//
Функция ЕстьПланыГруппыСЧА(ДатаПериода, СписокДоговоровДУ) Экспорт

    Если СписокДоговоровДУ = Неопределено Или СписокДоговоровДУ.Количество() = 0 Тогда
        Возврат Ложь;
    КонецЕсли;

    ГруппаСЧА = Справочники.ВидыОперацийЗакрытияПериода.НайтиПоКоду(КодГруппыРасчетаСЧА_РСА());
    Если ГруппаСЧА.Пустая() Тогда
        Возврат Ложь;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ПланРегламентныхОперацийДУ.Ссылка
    |ИЗ
    |    Документ.ПланРегламентныхОперацийДУ КАК ПланРегламентныхОперацийДУ
    |ГДЕ
    |    ПланРегламентныхОперацийДУ.ДоговорДУ В (&СписокДоговоровДУ)
    |    И ПланРегламентныхОперацийДУ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
    |    И ПланРегламентныхОперацийДУ.ГруппаОперацийПользователя = &ГруппаСЧА
    |    И НЕ ПланРегламентныхОперацийДУ.ПометкаУдаления";

    Запрос.УстановитьПараметр("СписокДоговоровДУ", СписокДоговоровДУ);
    Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаПериода));
    Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПериода));
    Запрос.УстановитьПараметр("ГруппаСЧА", ГруппаСЧА);

    Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#Область IMDEV_8663_2_Предподготовка

// Описание: Выполняет пакетный расчет данных РСА/СЧА сразу по пачке договоров и раскладывает
// результат по договорам в структуру ПараметрыСохранения.
// Вызывается один раз на пачку договоров перед формированием планов регламентных операций
// группы "3. Расчет СЧА/РСА". При любой ошибке расчета ключи не заполняются, и каждый договор
// будет посчитан обычным (однодоговорным) способом - это штатный откат, а не отказ операции.
//
// Параметры:
//  ПараметрыСохранения - Структура - структура параметров формирования регламентных операций;
//                        пополняется ключами СоответствиеДоговорТаблицаБУ_СЧА_РСА и
//                        СоответствиеДоговорТаблицаУУ_СЧА_РСА (Соответствие: ДоговорДУ -> ТаблицаЗначений)
//  СписокДоговоровДУ   - Массив - договоры текущей пачки (СправочникСсылка.ДоговорДУ)
//  ДатаПериода         - Дата   - дата регламентного периода (без времени)
//
Процедура ЗаполнитьПараметрыСохраненияПакетнымиДаннымиГруппыСЧА(ПараметрыСохранения, СписокДоговоровДУ, ДатаПериода) Экспорт

    // IMDEV-8663.2 этап 3
    ПараметрыСохранения.Удалить("СоответствиеДоговорТаблицаБУ_СЧА_РСА");
    ПараметрыСохранения.Удалить("СоответствиеДоговорТаблицаУУ_СЧА_РСА");

    Если СписокДоговоровДУ = Неопределено Или СписокДоговоровДУ.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ДатаРасчета = ДатаРасчетаСЧА_РСА(ДатаПериода);

    ТаблицаБУ = Неопределено;
    ТаблицаУУ = Неопределено;

    // Пакетный расчет может упасть на некорректных данных одного договора - в этом случае
    // не срываем всю пачку, а возвращаемся к обычному расчету по каждому договору.
    Попытка
        Документы.РасчетСЧА_РСА.ПолучитьСуммыРСА_СЧА_Пакетно(
            СписокДоговоровДУ,
            ДатаРасчета,
            ТаблицаБУ,
            ТаблицаУУ);
    Исключение
        ЗаписьЖурналаРегистрации(
            "IMDEV-8663.2",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            СтрШаблон(
                НСтр("ru='Пакетный расчет СЧА/РСА не выполнен, договоров в пачке: %1. %2'"),
                СписокДоговоровДУ.Количество(),
                ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
        Возврат;
    КонецПопытки;

    Если ТаблицаБУ = Неопределено Или ТаблицаУУ = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ПараметрыСохранения.Вставить(
        "СоответствиеДоговорТаблицаБУ_СЧА_РСА",
        ОбщегоНазначенияДУ.СоответствиеТаблицПоДоговорамДУ(ТаблицаБУ, СписокДоговоровДУ));

    ПараметрыСохранения.Вставить(
        "СоответствиеДоговорТаблицаУУ_СЧА_РСА",
        ОбщегоНазначенияДУ.СоответствиеТаблицПоДоговорамДУ(ТаблицаУУ, СписокДоговоровДУ));

КонецПроцедуры

// Описание: Возвращает дату-время расчета СЧА/РСА для указанного регламентного периода.
// Формула ПОВТОРЯЕТ функцию ПолучитьДатуСВременемОкончанияРабочегоДня модуля объекта
// документа РасчетСЧА_РСА. Дублирование намеренное: функция модуля объекта не экспортная,
// а любое расхождение формулы приведет к другому срезу параметров договора и другим суммам.
//
// Параметры:
//  ДатаПериода - Дата - дата регламентного периода
//
// Возвращаемое значение:
//  Дата - дата периода со временем окончания рабочего дня
//
Функция ДатаРасчетаСЧА_РСА(ДатаПериода)

    // IMDEV-8663.2 этап 3
    ОкончаниеРабочегоДня = Константы.ОкончаниеРабочегоДня.Получить();
    ОкончаниеРабочегоДня = ?(ЗначениеЗаполнено(ОкончаниеРабочегоДня), ОкончаниеРабочегоДня, Дата("00010101235959"));

    НоваяДатаСтрока = Формат(ДатаПериода, "ДФ=yyyyMMdd") + СтрЗаменить(Формат(ОкончаниеРабочегоДня, "ДЛФ=T"), ":", "");

    Возврат Дата(НоваяДатаСтрока);

КонецФункции

#КонецОбласти

#Область IMDEV_8663_2_Перехваты

	// IMDEV-8663.2 этап 3
	&ИзменениеИКонтроль("СформироватьРегламентныеОперации")
	Процедура IM86632_СформироватьРегламентныеОперации(ПараметрыПроцедуры, АдресХранилищаРезультат) Экспорт // ASP-196537
		
		// ASP-207844 IMDEV-8927: описание длительного замера производительности (БСП ОценкаПроизводительности)
		ОписаниеЗамераПроизводительности = Неопределено;
		
		// Инициализация результата по умолчанию (неуспешное завершение)
		Результат = Новый Структура("Успешно, Сообщение", Ложь, НСтр("ru='Формирование регламентных операций не выполнено'"));
		
		Попытка
			
			// Валидация входных параметров
			Если Не ЗначениеЗаполнено(ПараметрыПроцедуры) Или ТипЗнч(ПараметрыПроцедуры) <> Тип("Структура") Тогда
				Результат.Сообщение = НСтр("ru='Не переданы параметры процедуры'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(АдресХранилищаРезультат) Тогда
				Результат.Сообщение = НСтр("ru='Не указан адрес хранилища результата'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			// Извлечение параметров с безопасной проверкой наличия свойств
			ДатаПериода                   = Неопределено;
			СписокДоговоровДУ             = Неопределено;
			УчитыватьВыполненные          = Ложь;
			НаименованиеФоновогоЗадания   = "";
			ПараметрыСохранения           = Неопределено;
			
			ПараметрыПроцедуры.Свойство("ДатаПериода",                 ДатаПериода);
			ПараметрыПроцедуры.Свойство("СписокДоговоровДУ",           СписокДоговоровДУ);
			ПараметрыПроцедуры.Свойство("УчитыватьВыполненные",        УчитыватьВыполненные);
			ПараметрыПроцедуры.Свойство("НаименованиеФоновогоЗадания", НаименованиеФоновогоЗадания);
			ПараметрыПроцедуры.Свойство("ПараметрыСохранения",         ПараметрыСохранения);
			
			// Проверка минимально необходимых данных
			Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
				Результат.Сообщение = НСтр("ru='Не указана дата регламентного периода'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			Если СписокДоговоровДУ = Неопределено Или ТипЗнч(СписокДоговоровДУ) <> Тип("Массив") Тогда
				Результат.Сообщение = НСтр("ru='Список договоров не передан или имеет неверный тип'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			Если СписокДоговоровДУ.Количество() = 0 Тогда
				Результат.Сообщение = НСтр("ru='Список договоров пуст'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			Если ПараметрыСохранения = Неопределено Или ТипЗнч(ПараметрыСохранения) <> Тип("Структура") Тогда
				Результат.Сообщение = НСтр("ru='Отсутствуют или некорректны параметры сохранения'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			ФоновыеЗаданияДоступны = ПараметрыСохранения.КоличествоПотоков > 0
				И ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены();
				
			ПараметрыСохранения.Вставить("ФоновыеЗаданияДоступны", ФоновыеЗаданияДоступны);
			ПараметрыСохранения.Вставить("УспешныхЗаданий", 0);
			ПараметрыСохранения.Вставить("ОшибокЗаданий", 0);
			ПараметрыСохранения.Вставить("ПроблемныеДоговоры", Новый Массив);
			ПараметрыСохранения.Вставить("РазмерЧанкаПоУИД", Новый Соответствие);
			ПараметрыСохранения.Вставить("IM8663_НачалоРасчетаМС",ТекущаяУниверсальнаяДатаВМиллисекундах());

			РазмерЧанка = ОбщегоНазначенияДУ.ПолучитьЧисловуюКонстанту(
				"МаксимальныйРазмерПорцииДоговоровВПотокеРегл", 50);
			Если РазмерЧанка < 1 Тогда
				РазмерЧанка = 1;
			КонецЕсли;
			ПараметрыСохранения.Вставить("РазмерЧанка", РазмерЧанка);	
				
			
			// ASP-206799 IMDEV-8926++ Начало: разбивка списка договоров на пачки
			КоличествоДоговоров = СписокДоговоровДУ.Количество();
			ТекущийНомер        = 0;
			
			РазмерПачки = ОбщегоНазначенияДУ.ПолучитьЧисловуюКонстанту(
				"МаксимальныйРазмерПачкиДоговоровДляПредварительногоЗапросаРегл", 3000);
			Если РазмерПачки < 1 Тогда
				РазмерПачки = 1;
			КонецЕсли;

			
			// Переиспользуемая структура для передачи прогресса
			Прогресс = Новый Структура("Процент, Текст", 0, "");
			
			// ASP-197909 IMAPPS-35037++ Начало: подготовка параметров пакетной загрузки
			МассивРодителей = Неопределено;
			ПараметрыСохранения.Свойство("МассивРодителей", МассивРодителей);
			
			ВыполнятьПакетнуюЗагрузку = Ложь;
			ГруппаОперацийПользователя = Неопределено;
			ДатаПроведения = Неопределено;
			
			Если ЗначениеЗаполнено(МассивРодителей)
				И ТипЗнч(МассивРодителей) = Тип("Массив")
				И МассивРодителей.Количество() = 1 Тогда
				
				ГруппаОперацийПользователя = МассивРодителей[0];
				
				Если ЗначениеЗаполнено(ГруппаОперацийПользователя) Тогда
					ДатаПроведения = Дата(Формат(ДатаПериода, "ДФ=""ггггММдд""") + Формат(ГруппаОперацийПользователя.ВремяРеглОпераций, "ДФ=""ЧЧммсс"""));
				Иначе
					ДатаПроведения = Дата(Формат(ДатаПериода, "ДФ=""ггггММдд""") + Формат(ПолныеПрава.ОкончаниеРабочегоДня(), "ДФ=""ЧЧммсс"""));
				КонецЕсли;
				
				ВыполнятьПакетнуюЗагрузку = Истина;
			КонецЕсли;
			// ASP-197909 IMAPPS-35037++ Конец: подготовка параметров пакетной загрузки
			
			// ASP-207844 IMDEV-8927: старт длительного замера. Имя ключевой операции зависит от
			// ГруппаОперацийПользователя.Код (утренние / вечерние / прочие операции).
			ИмяКлючевойОперацииЗамера = ИмяКлючевойОперацииЗамераПоГруппе(ГруппаОперацийПользователя);
			ОписаниеЗамераПроизводительности = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(ИмяКлючевойОперацииЗамера);
			
			// ASP-206799 IMDEV-8926: цикл по пачкам договоров
			Для ИндексПачки = 0 По Цел((КоличествоДоговоров - 1) / РазмерПачки) Цикл // IMDEV-8926
				
				НачалоПачки = ИндексПачки * РазмерПачки; // IMDEV-8926
				РазмерТекущейПачки = Мин(РазмерПачки, КоличествоДоговоров - НачалоПачки); // IMDEV-8926
				
				Если РазмерТекущейПачки <= 0 Тогда // IMDEV-8926
					Прервать;
				КонецЕсли;
				
				СписокПачки = Новый Массив; // IMDEV-8926
				Для i = 0 По РазмерТекущейПачки - 1 Цикл // IMDEV-8926
					СписокПачки.Добавить(СписокДоговоровДУ[НачалоПачки + i]); // IMDEV-8926
				КонецЦикла;
				
				// IMDEV-8926: очищаем пакетные данные предыдущей пачки (освобождаем память)
				ОчиститьПакетныеДанныеПараметрыСохранения(ПараметрыСохранения); // IMDEV-8926
				
				// IMDEV-8926: пакетная предподготовка только для текущей пачки (Утренние / Вечерние)
				Если ВыполнятьПакетнуюЗагрузку Тогда
					
					Если ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПредварительныеЗапросыДляУтреннихРегламентов") = Истина Тогда
						Если ЗначениеЗаполнено(ГруппаОперацийПользователя) И ГруппаОперацийПользователя.Код = "1. ""Утренние"" операции" Тогда
							// IMDEV-8926: СписокПачки вместо СписокДоговоровДУ
							ЗаполнитьПараметрыСохраненияПакетнымиДаннымиУтреннихОпераций(ПараметрыСохранения, СписокПачки, ДатаПроведения);
						КонецЕсли;
					КонецЕсли;
					
					// IMAPPS-35039++ Пакетная загрузка кэша котировок УУ для вечерних операций (операция 0110)
					Если ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПредварительныеЗапросыДляВечернихРегламентов") = Истина Тогда
						Если ЗначениеЗаполнено(ГруппаОперацийПользователя) И ГруппаОперацийПользователя.Код = "2. ""Вечерние"" операции" Тогда
							// IMDEV-8926: СписокПачки вместо СписокДоговоровДУ
							ЗаполнитьПараметрыСохраненияПакетнымиДаннымиВечернихОпераций(ПараметрыСохранения, СписокПачки, ДатаПроведения);
						КонецЕсли;
					КонецЕсли;
					// IMAPPS-35039--
					#Вставка
