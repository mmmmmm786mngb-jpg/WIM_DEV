		СоответствиеДоговорТаблицаУУ_СЧА_РСА = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаБУ_СЧА_РСА", СоответствиеДоговорТаблицаБУ_СЧА_РСА);
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаУУ_СЧА_РСА", СоответствиеДоговорТаблицаУУ_СЧА_РСА);
		
