#Область IMDEV_8663_2_Перехваты

// IMDEV-8663.2 этап 3: добавлен необязательный 7-й параметр ДополнительныеДанные.
// Механизм передачи - штатный (IMAPPS-35037): ВыполнитьИсполняемуюПроцедуруЗакрытияПериода
// передает 7-й параметр, если в СоответствиеОперацияТаблица есть ключ с именем этой процедуры.
//
// IMDEV-8663.2 этап 3
&ИзменениеИКонтроль("Операция_1000_РасчетРСА_СЧА")
Процедура IM86632_Операция_1000_РасчетРСА_СЧА(ЗакрытиеПериода, Дата, ДоговорДУ, СписокОпераций, Отказ, ТекстОтказа, ДополнительныеДанные = Неопределено) Экспорт
	
	//TM-733+
	ДокументРасчетСЧА_РСА = ПолучитьПодчиненныйДокумент("РасчетСЧА_РСА", ЗакрытиеПериода);
	
	ДокументРасчетСЧА_РСА.Дата 					= ПолучитьДатуСВременемОкончанияРабочегоДня(Дата,12);
	ДокументРасчетСЧА_РСА.ДоговорДУ 			= ДоговорДУ;
	ДокументРасчетСЧА_РСА.ДокументОснование 	= ЗакрытиеПериода;
	//ДокументРасчетСЧА_РСА.Комментарий 		= "Регламентная операция";
	
	//Определеяем виды учета
	ДокументРасчетСЧА_РСА.РСА = СписокОпераций.Найти(Справочники.ВидыОперацийЗакрытияПериода.РасчетРСА_БУ) <> Неопределено;
	ДокументРасчетСЧА_РСА.СЧА = СписокОпераций.Найти(Справочники.ВидыОперацийЗакрытияПериода.РасчетСЧА_БУ) <> Неопределено;
	
	#Удаление
	ДокументРасчетСЧА_РСА.ПолучитьСуммыРСАСЧА(Отказ, ТекстОтказа);
	#КонецУдаления
	#Вставка
	// IMDEV-8663.2 этап 3: передаем пакетные данные операции 1000, если они есть
	ДокументРасчетСЧА_РСА.ПолучитьСуммыРСАСЧА(Отказ, ТекстОтказа, ДополнительныеДанные);
	#КонецВставки
	
	// TM-3363 {
	ИспользоватьТолькоАктуальныеКурсыВалют = ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьТолькоАктуальныеКурсыВалют"); 
	Если ИспользоватьТолькоАктуальныеКурсыВалют И Отказ Тогда
		// ASP-209118 IMDEV-8899 этап2 п.5+1
		Документы.РасчетСЧА_РСА.ЗаписатьСОбработкойКоллизииНомера(ДокументРасчетСЧА_РСА, РежимЗаписиДокумента.Запись);
        //ДокументРасчетСЧА_РСА.Записать(РежимЗаписиДокумента.Запись);
		Возврат;
	КонецЕсли;
	// TM-3363 }
	
	// ASP-209118 IMDEV-8899 этап2 п.5+1
	Попытка
		Документы.РасчетСЧА_РСА.ЗаписатьСОбработкойКоллизииНомера(ДокументРасчетСЧА_РСА, РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибкиПроведения = ОписаниеОшибки();
		Документы.РасчетСЧА_РСА.ЗаписатьСОбработкойКоллизииНомера(ДокументРасчетСЧА_РСА, РежимЗаписиДокумента.Запись);
		Отказ = Истина;
		ТекстОтказа = "Не удалось провести документ " + Строка(ДокументРасчетСЧА_РСА) + ". " + ТекстОшибкиПроведения;
	КонецПопытки;
	//TM-733+
	
КонецПроцедуры

#КонецОбласти
