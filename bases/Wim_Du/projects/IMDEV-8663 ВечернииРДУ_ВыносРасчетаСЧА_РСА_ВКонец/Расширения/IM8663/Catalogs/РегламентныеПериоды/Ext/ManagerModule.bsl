// IMDEV-8663.1 фоновые задания регламентных операций

	#Область IMDEV_8663_1_A

	&ИзменениеИКонтроль("СформироватьРегламентныеОперации")
	Процедура IM8663_СформироватьРегламентныеОперации(ПараметрыПроцедуры, АдресХранилищаРезультат) Экспорт // ASP-196537
		
		// ASP-207844 IMDEV-8927: описание длительного замера производительности (БСП ОценкаПроизводительности)
		ОписаниеЗамераПроизводительности = Неопределено;
		
		// Инициализация результата по умолчанию (неуспешное завершение)
		Результат = Новый Структура("Успешно, Сообщение", Ложь, НСтр("ru='Формирование регламентных операций не выполнено'"));
		
		Попытка
			
			// Валидация входных параметров
			Если Не ЗначениеЗаполнено(ПараметрыПроцедуры) Или ТипЗнч(ПараметрыПроцедуры) <> Тип("Структура") Тогда
				Результат.Сообщение = НСтр("ru='Не переданы параметры процедуры'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(АдресХранилищаРезультат) Тогда
				Результат.Сообщение = НСтр("ru='Не указан адрес хранилища результата'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			// Извлечение параметров с безопасной проверкой наличия свойств
			ДатаПериода                   = Неопределено;
			СписокДоговоровДУ             = Неопределено;
			УчитыватьВыполненные          = Ложь;
			НаименованиеФоновогоЗадания   = "";
			ПараметрыСохранения           = Неопределено;
			
			ПараметрыПроцедуры.Свойство("ДатаПериода",                 ДатаПериода);
			ПараметрыПроцедуры.Свойство("СписокДоговоровДУ",           СписокДоговоровДУ);
			ПараметрыПроцедуры.Свойство("УчитыватьВыполненные",        УчитыватьВыполненные);
			ПараметрыПроцедуры.Свойство("НаименованиеФоновогоЗадания", НаименованиеФоновогоЗадания);
			ПараметрыПроцедуры.Свойство("ПараметрыСохранения",         ПараметрыСохранения);
			
			// Проверка минимально необходимых данных
			Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
				Результат.Сообщение = НСтр("ru='Не указана дата регламентного периода'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			Если СписокДоговоровДУ = Неопределено Или ТипЗнч(СписокДоговоровДУ) <> Тип("Массив") Тогда
				Результат.Сообщение = НСтр("ru='Список договоров не передан или имеет неверный тип'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			Если СписокДоговоровДУ.Количество() = 0 Тогда
				Результат.Сообщение = НСтр("ru='Список договоров пуст'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;
			
			Если ПараметрыСохранения = Неопределено Или ТипЗнч(ПараметрыСохранения) <> Тип("Структура") Тогда
				Результат.Сообщение = НСтр("ru='Отсутствуют или некорректны параметры сохранения'");
				ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
				Возврат;
			КонецЕсли;

			#Вставка
			// IMDEV-8663.1.A
			ФоновыеЗаданияДоступны = ПараметрыСохранения.КоличествоПотоков > 0
				И ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены();
			ПараметрыСохранения.Вставить("ФоновыеЗаданияДоступны", ФоновыеЗаданияДоступны);
			ПараметрыСохранения.Вставить("УспешныхЗаданий", 0);
			ПараметрыСохранения.Вставить("ОшибокЗаданий", 0);
			ПараметрыСохранения.Вставить("ПроблемныеДоговоры", Новый Массив);
			ПараметрыСохранения.Вставить("РазмерЧанкаПоУИД", Новый Соответствие);
			ПараметрыСохранения.Вставить("IM8663_НачалоРасчетаМС",
				ТекущаяУниверсальнаяДатаВМиллисекундах());
			// IMDEV-8663.1.B
			РазмерЧанка = 50;
			ПараметрыСохранения.Вставить("РазмерЧанка", РазмерЧанка);
			#КонецВставки
			
			// ASP-206799 IMDEV-8926++ Начало: разбивка списка договоров на пачки
			КоличествоДоговоров = СписокДоговоровДУ.Количество();
			ТекущийНомер        = 0;
			РазмерПачки         = 3000; // IMDEV-8926
			
			// Переиспользуемая структура для передачи прогресса
			Прогресс = Новый Структура("Процент, Текст", 0, "");
			
			// ASP-197909 IMAPPS-35037++ Начало: подготовка параметров пакетной загрузки
			МассивРодителей = Неопределено;
			ПараметрыСохранения.Свойство("МассивРодителей", МассивРодителей);
			
			ВыполнятьПакетнуюЗагрузку = Ложь;
			ГруппаОперацийПользователя = Неопределено;
			ДатаПроведения = Неопределено;
			
			Если ЗначениеЗаполнено(МассивРодителей)
				И ТипЗнч(МассивРодителей) = Тип("Массив")
				И МассивРодителей.Количество() = 1 Тогда
				
				ГруппаОперацийПользователя = МассивРодителей[0];
				
				Если ЗначениеЗаполнено(ГруппаОперацийПользователя) Тогда
					ДатаПроведения = Дата(Формат(ДатаПериода, "ДФ=""ггггММдд""") + Формат(ГруппаОперацийПользователя.ВремяРеглОпераций, "ДФ=""ЧЧммсс"""));
				Иначе
					ДатаПроведения = Дата(Формат(ДатаПериода, "ДФ=""ггггММдд""") + Формат(ПолныеПрава.ОкончаниеРабочегоДня(), "ДФ=""ЧЧммсс"""));
				КонецЕсли;
				
				ВыполнятьПакетнуюЗагрузку = Истина;
			КонецЕсли;
			// ASP-197909 IMAPPS-35037++ Конец: подготовка параметров пакетной загрузки
			
			// ASP-207844 IMDEV-8927: старт длительного замера. Имя ключевой операции зависит от
			// ГруппаОперацийПользователя.Код (утренние / вечерние / прочие операции).
			ИмяКлючевойОперацииЗамера = ИмяКлючевойОперацииЗамераПоГруппе(ГруппаОперацийПользователя);
			ОписаниеЗамераПроизводительности = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(ИмяКлючевойОперацииЗамера);
			
			// ASP-206799 IMDEV-8926: цикл по пачкам договоров
			Для ИндексПачки = 0 По Цел((КоличествоДоговоров - 1) / РазмерПачки) Цикл // IMDEV-8926
				
				НачалоПачки = ИндексПачки * РазмерПачки; // IMDEV-8926
				РазмерТекущейПачки = Мин(РазмерПачки, КоличествоДоговоров - НачалоПачки); // IMDEV-8926
				
				Если РазмерТекущейПачки <= 0 Тогда // IMDEV-8926
					Прервать;
				КонецЕсли;
				
				СписокПачки = Новый Массив; // IMDEV-8926
				Для i = 0 По РазмерТекущейПачки - 1 Цикл // IMDEV-8926
					СписокПачки.Добавить(СписокДоговоровДУ[НачалоПачки + i]); // IMDEV-8926
				КонецЦикла;
				
				// IMDEV-8926: очищаем пакетные данные предыдущей пачки (освобождаем память)
				ОчиститьПакетныеДанныеПараметрыСохранения(ПараметрыСохранения); // IMDEV-8926
				
				// IMDEV-8926: пакетная предподготовка только для текущей пачки (Утренние / Вечерние)
				Если ВыполнятьПакетнуюЗагрузку Тогда
					
					Если ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПредварительныеЗапросыДляУтреннихРегламентов") = Истина Тогда
						Если ЗначениеЗаполнено(ГруппаОперацийПользователя) И ГруппаОперацийПользователя.Код = "1. ""Утренние"" операции" Тогда
							// IMDEV-8926: СписокПачки вместо СписокДоговоровДУ
							ЗаполнитьПараметрыСохраненияПакетнымиДаннымиУтреннихОпераций(ПараметрыСохранения, СписокПачки, ДатаПроведения);
						КонецЕсли;
					КонецЕсли;
					
					// IMAPPS-35039++ Пакетная загрузка кэша котировок УУ для вечерних операций (операция 0110)
					Если ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПредварительныеЗапросыДляВечернихРегламентов") = Истина Тогда
						Если ЗначениеЗаполнено(ГруппаОперацийПользователя) И ГруппаОперацийПользователя.Код = "2. ""Вечерние"" операции" Тогда
							// IMDEV-8926: СписокПачки вместо СписокДоговоровДУ
							ЗаполнитьПараметрыСохраненияПакетнымиДаннымиВечернихОпераций(ПараметрыСохранения, СписокПачки, ДатаПроведения);
						КонецЕсли;
					КонецЕсли;
					// IMAPPS-35039--
					
				КонецЕсли;
				
				#Удаление
				// ASP-206799 IMDEV-8926: цикл по договорам текущей пачки (в типовой - по всему СписокДоговоровДУ)
				Для Каждого ТекДоговор Из СписокПачки Цикл // IMDEV-8926
					
					ТекущийНомер = ТекущийНомер + 1;
					
					// Расчёт процента завершения (защита от деления на 0)
					Прогресс.Процент = ?(КоличествоДоговоров > 0,
					Окр(100 * (ТекущийНомер - 1) / КоличествоДоговоров),
					0);
					
					// Формирование понятного текста прогресса
					Прогресс.Текст = СтрШаблон(
					НСтр("ru='Обработка договора %1 из %2: %3'"),
					ТекущийНомер,
					КоличествоДоговоров,
					ТекДоговор);
					
					// Передача текущего прогресса в механизм длительных операций
					ДлительныеОперации.СообщитьПрогресс(Прогресс.Процент, Прогресс.Текст);
					
					// Вызов формирования документов по текущему договору
					СформироватьДокументыЗакрытияПериода(
					ДатаПериода,
					ТекДоговор,
					УчитыватьВыполненные,
					НаименованиеФоновогоЗадания,
					ТекущийНомер,
					КоличествоДоговоров,
					ПараметрыСохранения);
					
				КонецЦикла; // IMDEV-8926: конец цикла по договорам пачки
				#КонецУдаления
				#Вставка
				// IMDEV-8663.1.B
				Если ПараметрыСохранения.ФоновыеЗаданияДоступны Тогда
					IM8663_ОбработатьПачкуДиспетчером(
						ДатаПериода,
						СписокПачки,
						УчитыватьВыполненные,
						НаименованиеФоновогоЗадания,
						ПараметрыСохранения,
						ТекущийНомер,
						КоличествоДоговоров,
						ИндексПачки);
				Иначе
					// ASP-206799 IMDEV-8926: цикл по договорам текущей пачки (в типовой - по всему СписокДоговоровДУ)
					Для Каждого ТекДоговор Из СписокПачки Цикл // IMDEV-8926
					
						ТекущийНомер = ТекущийНомер + 1;
					
						// Расчёт процента завершения (защита от деления на 0)
						Прогресс.Процент = ?(КоличествоДоговоров > 0,
						Окр(100 * (ТекущийНомер - 1) / КоличествоДоговоров),
						0);
					
						// Формирование понятного текста прогресса
						Прогресс.Текст = СтрШаблон(
						НСтр("ru='Обработка договора %1 из %2: %3'"),
						ТекущийНомер,
						КоличествоДоговоров,
						ТекДоговор);
					
						// Передача текущего прогресса в механизм длительных операций
						ДлительныеОперации.СообщитьПрогресс(Прогресс.Процент, Прогресс.Текст);
					
						// Вызов формирования документов по текущему договору
						СформироватьДокументыЗакрытияПериода(
						ДатаПериода,
						ТекДоговор,
						УчитыватьВыполненные,
						НаименованиеФоновогоЗадания,
						ТекущийНомер,
						КоличествоДоговоров,
						ПараметрыСохранения);
					
					КонецЦикла; // IMDEV-8926: конец цикла по договорам пачки
				КонецЕсли;
				// IMDEV-8663.1.A
				IM8663_ЗавершитьФоновыеЗаданияПорции(ПараметрыСохранения);
				#КонецВставки
				
				// ASP-207844 IMDEV-8927: пошаговая фиксация замера по обработанной пачке договоров.
				// Вес шага = число договоров в пачке (для расчёта удельного времени на 1 договор).
				ОценкаПроизводительности.ЗафиксироватьЗамерДлительнойОперации(
				ОписаниеЗамераПроизводительности,
				РазмерТекущейПачки,
				"ОбработкаПачкиДоговоров",
				СтрШаблон(НСтр("ru='Пачка %1, договоров: %2'"), ИндексПачки + 1, РазмерТекущейПачки));
				
			КонецЦикла; // IMDEV-8926: конец цикла по пачкам
			
			// IMDEV-8926-- Конец: разбивка списка договоров на пачки
			
			// ASP-207844 IMDEV-8927: завершение длительного замера.
			// Вес уже накоплен в ЗафиксироватьЗамерДлительнойОперации по пачкам -
			// в Закончить передаем 0, чтобы не дублировать количество договоров.
			ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(
			ОписаниеЗамераПроизводительности,
			0,
			"",
			СтрШаблон(
			НСтр("ru='Обработано договоров: %1; Потоков: %2'"),
			ТекущийНомер,
			Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить()));
			
			#Вставка
			// IMDEV-8663.1.A
			IM8663_ЗавершитьФоновыеЗаданияПорции(ПараметрыСохранения);
			НачалоРасчетаМС = 0;
			ПараметрыСохранения.Свойство("IM8663_НачалоРасчетаМС", НачалоРасчетаМС);
			ДлительностьСек = 0;
			Если НачалоРасчетаМС > 0 Тогда
				ДлительностьСек = Цел(
					(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоРасчетаМС) / 1000);
			КонецЕсли;
			МинутРасчета = Цел(ДлительностьСек / 60);
			СекундРасчета = ДлительностьСек - МинутРасчета * 60;
			ТекстВремени = СтрШаблон(
				НСтр("ru='%1 мин %2 сек'"),
				Формат(МинутРасчета, "ЧН=0; ЧГ="),
				Формат(СекундРасчета, "ЧН=0; ЧГ="));
			Если ПараметрыСохранения.ФоновыеЗаданияДоступны Тогда
				ТекстСводки = СтрШаблон(
					НСтр("ru='Обработано договоров: %1. Успешных заданий: %2, с ошибкой: %3. Затрачено: %4'"),
					КоличествоДоговоров,
					ПараметрыСохранения.УспешныхЗаданий,
					ПараметрыСохранения.ОшибокЗаданий,
					ТекстВремени);
			Иначе
				ТекстСводки = СтрШаблон(
					НСтр("ru='Обработано договоров: %1. Режим: последовательно, без фоновых. Затрачено: %2'"),
					КоличествоДоговоров,
					ТекстВремени);
			КонецЕсли;
			Если ПараметрыСохранения.ПроблемныеДоговоры.Количество() > 0 Тогда
				ТекстСводки = ТекстСводки + ". " + СтрСоединить(ПараметрыСохранения.ПроблемныеДоговоры, "; ");
			КонецЕсли;
			Сообщить(ТекстСводки);
			#КонецВставки
			// Финальное сообщение о завершении и фиксация успешного результата
			ДлительныеОперации.СообщитьПрогресс(
			100,
			НСтр("ru='Формирование регламентных операций завершено'"));
			
			Результат.Успешно   = Истина;
			#Удаление
			Результат.Сообщение = "";
			#КонецУдаления
			#Вставка
			// IMDEV-8663.1.A
			Результат.Сообщение = ТекстСводки;
			#КонецВставки
			
		Исключение
			
			#Вставка
			// IMDEV-8663.1.A
			IM8663_ОтменитьАктивныеЗадания(ПараметрыСохранения);
			#КонецВставки
			
			// ASP-207844 IMDEV-8927: завершение замера при ошибке (вес не дублируем)
			Если ЗначениеЗаполнено(ОписаниеЗамераПроизводительности) Тогда
				ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(
				ОписаниеЗамераПроизводительности,
				0,
				"",
				ОписаниеОшибки());
			КонецЕсли;
			
			// Обработка ошибок выполнения
			ТекстОшибки = СтрШаблон(
			НСтр("ru='Ошибка при формировании регламентных операций: %1'"),
			ОписаниеОшибки());
			
			Результат.Сообщение = ТекстОшибки;
			
			// Логирование ошибки
			ЗаписьЖурналаРегистрации(
			"РегламентныеОперации",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
			
		КонецПопытки;
		
		// Сохранение результата во временное хранилище
		ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
		
	КонецПроцедуры

	&ИзменениеИКонтроль("СформироватьДокументыЗакрытияПериода")
	Процедура IM8663_СформироватьДокументыЗакрытияПериода(ДатаПериода, ДоговорДУ, УчитыватьВыполненные, НаименованиеФоновогоЗадания, ТекЗначение, МаксимальноеЗначение, ПараметрыСохранения) 
		
		Если ТипЗнч(ПараметрыСохранения) <> Тип("Структура") Тогда Возврат  КонецЕсли;
		СписокОпераций 			= ПараметрыСохранения.СписокОпераций;
		ДокументыПоДоговорам 	= ПараметрыСохранения.ДокументыПоДоговорам;
		КоличествоПотоков		= ПараметрыСохранения.КоличествоПотоков;
		МассивРодителей         = ПараметрыСохранения.МассивРодителей;
		
		// ASP-197909 IMAPPS-35037++ Начало: Извлечение соответствия договор -> таблица взаиморасчетов
		СоответствиеДоговорТаблицаВзаиморасчетов = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаВзаиморасчетов", СоответствиеДоговорТаблицаВзаиморасчетов);
		
		// Получаем таблицу взаиморасчетов для текущего договора
		ТаблицаВзаиморасчетовПоДоговору = Неопределено;
		Если СоответствиеДоговорТаблицаВзаиморасчетов <> Неопределено Тогда
			ТаблицаВзаиморасчетовПоДоговору = СоответствиеДоговорТаблицаВзаиморасчетов.Получить(ДоговорДУ);
		КонецЕсли;
		
		// ASP-197909 IMAPPS-35037++ Извлечение соответствия договор -> таблица купонных периодов
		СоответствиеДоговорТаблицаКупонныхПериодов = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаКупонныхПериодов", СоответствиеДоговорТаблицаКупонныхПериодов);
		ТаблицаКупонныхПериодовПоДоговору = Неопределено;
		Если СоответствиеДоговорТаблицаКупонныхПериодов <> Неопределено Тогда
			ТаблицаКупонныхПериодовПоДоговору = СоответствиеДоговорТаблицаКупонныхПериодов.Получить(ДоговорДУ);
		КонецЕсли;
		
		// ASP-197909 IMAPPS-35037++ Извлечение соответствия договор -> таблица остатков НКД УУ (строка 2004)
		СоответствиеДоговорТаблицаОстатковНКД_УУ = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаОстатковНКД_УУ", СоответствиеДоговорТаблицаОстатковНКД_УУ);
		ТаблицаОстатковНКД_УУПоДоговору = Неопределено;
		Если СоответствиеДоговорТаблицаОстатковНКД_УУ <> Неопределено Тогда
			ТаблицаОстатковНКД_УУПоДоговору = СоответствиеДоговорТаблицаОстатковНКД_УУ.Получить(ДоговорДУ);
		КонецЕсли;
		
		// ASP-197909 IMAPPS-35037++ Извлечение соответствия договор -> таблица остатков (строка 795)
		СоответствиеДоговорТаблицаОстатков = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаОстатков", СоответствиеДоговорТаблицаОстатков);
		ТаблицаОстатковПоДоговору = Неопределено;
		Если СоответствиеДоговорТаблицаОстатков <> Неопределено Тогда
			ТаблицаОстатковПоДоговору = СоответствиеДоговорТаблицаОстатков.Получить(ДоговорДУ);
		КонецЕсли;
		
		// ASP-197909 IMAPPS-35037++ Извлечение соответствия договор -> таблица активов облигаций (операция 0055)
		СоответствиеДоговорТаблицаАктивовОблигаций = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаАктивовОблигаций", СоответствиеДоговорТаблицаАктивовОблигаций);
		ТаблицаАктивовОблигацийПоДоговору = Неопределено;
		Если СоответствиеДоговорТаблицаАктивовОблигаций <> Неопределено Тогда
			ТаблицаАктивовОблигацийПоДоговору = СоответствиеДоговорТаблицаАктивовОблигаций.Получить(ДоговорДУ);
		КонецЕсли;
		
		// ASP-197909 IMAPPS-35037++ Извлечение соответствия договор -> таблица остатков по банковским счетам (операция 0030)
		СоответствиеДоговорТаблицаОстатковПоБанковскимСчетам = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаОстатковПоБанковскимСчетам", СоответствиеДоговорТаблицаОстатковПоБанковскимСчетам);
		ТаблицаОстатковПоБанковскимСчетамПоДоговору = Неопределено;
		Если СоответствиеДоговорТаблицаОстатковПоБанковскимСчетам <> Неопределено Тогда
			ТаблицаОстатковПоБанковскимСчетамПоДоговору = СоответствиеДоговорТаблицаОстатковПоБанковскимСчетам.Получить(ДоговорДУ);
		КонецЕсли;
		
		// IMAPPS-35039++ Извлечение таблицы ЦБ по договору для операции 0010 (Установка котировок ЦБ)
		СоответствиеДоговорТаблицаЦБ = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаЦБ", СоответствиеДоговорТаблицаЦБ);
		ТаблицаЦБПоДоговору = Неопределено;
		Если СоответствиеДоговорТаблицаЦБ <> Неопределено Тогда
			ТаблицаЦБПоДоговору = СоответствиеДоговорТаблицаЦБ.Получить(ДоговорДУ);
		КонецЕсли;
		
		// IMAPPS-35039++ Извлечение таблицы остатков облигаций по договору для операции 0040 (Начисление КД)
		СоответствиеДоговорТаблицаОстатковОблигаций = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаОстатковОблигаций", СоответствиеДоговорТаблицаОстатковОблигаций);
		ТаблицаОстатковОблигацийПоДоговору = Неопределено;
		Если СоответствиеДоговорТаблицаОстатковОблигаций <> Неопределено Тогда
			ТаблицаОстатковОблигацийПоДоговору = СоответствиеДоговорТаблицаОстатковОблигаций.Получить(ДоговорДУ);
		КонецЕсли;
		// IMAPPS-35039--
		
		// ASP-209118 IMDEV-8899 3.1
		СоответствиеПропускРЕПОВетки = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеПропускРЕПОВетки", СоответствиеПропускРЕПОВетки);
		
		// IMAPPS-35039++ Извлечение кэша котировок УУ для операции 0110 (переоценка активов)
		СоответствиеДоговорТаблицаОстатковУУ   = Неопределено;
		СоответствиеДоговорТаблицаКотировокБУ   = Неопределено;
		СоответствиеДоговорТаблицаКотировокУУ   = Неопределено;
		ТаблицаДефолтныеСобытияКотировокУУ      = Неопределено;
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаОстатковУУ",   СоответствиеДоговорТаблицаОстатковУУ);
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаКотировокБУ", СоответствиеДоговорТаблицаКотировокБУ);
		ПараметрыСохранения.Свойство("СоответствиеДоговорТаблицаКотировокУУ", СоответствиеДоговорТаблицаКотировокУУ);
		ПараметрыСохранения.Свойство("ТаблицаДефолтныеСобытияКотировокУУ",    ТаблицаДефолтныеСобытияКотировокУУ);
		КэшПоДоговоруКотировокУУ = Неопределено;
		Если СоответствиеДоговорТаблицаОстатковУУ <> Неопределено И СоответствиеДоговорТаблицаКотировокБУ <> Неопределено И СоответствиеДоговорТаблицаКотировокУУ <> Неопределено Тогда
			ТаблицаОстатковУУПоДоговору   = СоответствиеДоговорТаблицаОстатковУУ.Получить(ДоговорДУ);
			ТаблицаКотировокБУПоДоговору  = СоответствиеДоговорТаблицаКотировокБУ.Получить(ДоговорДУ);
			ТаблицаКотировокУУПоДоговору  = СоответствиеДоговорТаблицаКотировокУУ.Получить(ДоговорДУ);
			КэшПоДоговоруКотировокУУ = Новый Соответствие;
			КэшПоДоговоруКотировокУУ.Вставить("ОстаткиУУ",        ТаблицаОстатковУУПоДоговору);
			КэшПоДоговоруКотировокУУ.Вставить("КотировкиБУ",      ТаблицаКотировокБУПоДоговору);
			КэшПоДоговоруКотировокУУ.Вставить("КотировкиУУ",     ТаблицаКотировокУУПоДоговору);
			КэшПоДоговоруКотировокУУ.Вставить("ДефолтныеСобытия", ТаблицаДефолтныеСобытияКотировокУУ);
		КонецЕсли;
		// IMAPPS-35039--
		
		// ASP-197909 IMAPPS-35037++ Создаем соответствие операция -> таблица (или структура) для передачи дальше
		// Ключ соответствия - имя процедуры операции. Для 0050 - структура (ТаблицаКупонныхПериодов, ОстаткиНКД_УУ, ТаблицаОстатков)
		СоответствиеОперацияТаблица = Новый Соответствие;
		Если ТаблицаВзаиморасчетовПоДоговору <> Неопределено Тогда
			СоответствиеОперацияТаблица.Вставить("ИсполняемыеПроцедурыЗакрытияПериода.Операция_0200_ПереоценкаВзаиморасчетов",
			ТаблицаВзаиморасчетовПоДоговору);
		КонецЕсли;
		Если ТаблицаКупонныхПериодовПоДоговору <> Неопределено ИЛИ ТаблицаОстатковНКД_УУПоДоговору <> Неопределено ИЛИ ТаблицаОстатковПоДоговору <> Неопределено Тогда
			СтруктураТаблиц = Новый Структура;
			СтруктураТаблиц.Вставить("ТаблицаКупонныхПериодов", ТаблицаКупонныхПериодовПоДоговору);
			СтруктураТаблиц.Вставить("ОстаткиНКД_УУ", ТаблицаОстатковНКД_УУПоДоговору);
			СтруктураТаблиц.Вставить("ТаблицаОстатков", ТаблицаОстатковПоДоговору);
			СоответствиеОперацияТаблица.Вставить("ИсполняемыеПроцедурыЗакрытияПериода.Операция_0050_ПереводНКДВЗадолженностьЭмитента", СтруктураТаблиц);
		КонецЕсли;
		Если ТаблицаАктивовОблигацийПоДоговору <> Неопределено Тогда
			СоответствиеОперацияТаблица.Вставить("ИсполняемыеПроцедурыЗакрытияПериода.Операция_0055_ПогашениеОблигаций", ТаблицаАктивовОблигацийПоДоговору);
		КонецЕсли;
		Если ТаблицаОстатковПоБанковскимСчетамПоДоговору <> Неопределено Тогда
			СоответствиеОперацияТаблица.Вставить("ИсполняемыеПроцедурыЗакрытияПериода.Операция_0030_НачислениеПроцентовПоБанковскимСчетам", ТаблицаОстатковПоБанковскимСчетамПоДоговору);
		КонецЕсли; 
		// IMAPPS-35039++ Операция 0010 — Установка котировок ЦБ: передаём таблицу ЦБ по договору
		Если ТаблицаЦБПоДоговору <> Неопределено Тогда
			СоответствиеОперацияТаблица.Вставить("ИсполняемыеПроцедурыЗакрытияПериода.Операция_0010_УстановкаКотировок", ТаблицаЦБПоДоговору);
		КонецЕсли;
		// IMAPPS-35039++ Операция 0040 — Начисление КД: передаём таблицу остатков облигаций по договору
		Если ТаблицаОстатковОблигацийПоДоговору <> Неопределено Тогда
			СоответствиеОперацияТаблица.Вставить("ИсполняемыеПроцедурыЗакрытияПериода.Операция_0040_НачислениеКД", ТаблицаОстатковОблигацийПоДоговору);
		КонецЕсли;
		// ASP-209118 IMAPPS-35039++ Операция 0110 — переоценка активов: кэш котировок УУ и соответствие ПропускРЕПОВетки
		// IMDEV-8899 3.1
		Если КэшПоДоговоруКотировокУУ <> Неопределено Или СоответствиеПропускРЕПОВетки <> Неопределено Тогда
			ДополнительныеДанныеОперации0110 = Новый Структура;
			Если КэшПоДоговоруКотировокУУ <> Неопределено Тогда
				ДополнительныеДанныеОперации0110.Вставить("КэшКотировокУУ", КэшПоДоговоруКотировокУУ);
			КонецЕсли;
			Если СоответствиеПропускРЕПОВетки <> Неопределено Тогда
				ДополнительныеДанныеОперации0110.Вставить("СоответствиеПропускРЕПОВетки", СоответствиеПропускРЕПОВетки);
			КонецЕсли;
			СоответствиеОперацияТаблица.Вставить(
				"ИсполняемыеПроцедурыЗакрытияПериода.Операция_0110_ПереоценкаАктивов",
				ДополнительныеДанныеОперации0110);
		КонецЕсли;
		// IMAPPS-35039--
		
		// ASP-197909 IMAPPS-35037++ Конец: Извлечение соответствия договор -> таблица взаиморасчетов
		
		Для каждого ТекГруппаОперацийПользователя Из МассивРодителей Цикл
			
			// Ищем документы ПланРегламентныхОперацийДУ
			ТекПлан = Неопределено;
			ПараметрыПоиска = Новый Структура("ДоговорДУ, ГруппаОперацийПользователя", ДоговорДУ, ТекГруппаОперацийПользователя);
			НайденныеСтроки = ДокументыПоДоговорам.НайтиСтроки(ПараметрыПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ТекПлан = НайденныеСтроки[0].Ссылка;
			КонецЕсли;
			
			ТаблицаОпераций = Новый ТаблицаЗначений;
			ТаблицаОпераций.Колонки.Добавить("ВидОперации", Новый ОписаниеТипов("СправочникСсылка.ВидыОперацийЗакрытияПериода"));
			ТаблицаОпераций.Колонки.Добавить("Выполнять", Новый ОписаниеТипов("Булево"));
			
			ПараметрыПоиска = Новый Структура("ДоговорДУ, ГруппаОперацийПользователя", ДоговорДУ, ТекГруппаОперацийПользователя);
			НайденныеСтроки = СписокОпераций.НайтиСтроки(ПараметрыПоиска);
			МассивОперацийДоговора = Новый Массив;
			
			Для каждого ТекСтрока из НайденныеСтроки Цикл
				НоваяСтрока = ТаблицаОпераций.Добавить();
				НоваяСтрока.ВидОперации 	= ТекСтрока.ВидОперации;
				НоваяСтрока.Выполнять 		= ТекСтрока.Выполнять;
				
				МассивОперацийДоговора.Добавить(ТекСтрока.ВидОперации);
			КонецЦикла;
			
			Если  НЕ ЗначениеЗаполнено(ТекГруппаОперацийПользователя) Тогда //TM-1439 Отсекаем пользовательские папки
				//Дополним видами операций для всех
				ПараметрыПоиска = Новый Структура("ДоговорДУ", Справочники.ДоговорДУ.ПустаяСсылка());
				НайденныеСтроки = СписокОпераций.НайтиСтроки(ПараметрыПоиска);
				
				Для каждого ТекСтрока из НайденныеСтроки Цикл
					
					Если текСтрока.Выполнять = Ложь Тогда Продолжить; КонецЕсли;
					
					Если МассивОперацийДоговора.Найти(ТекСтрока.ВидОперации)<>Неопределено тогда Продолжить; КонецЕсли;
					
					НоваяСтрока = ТаблицаОпераций.Добавить();
					НоваяСтрока.ВидОперации 	= ТекСтрока.ВидОперации;
					НоваяСтрока.Выполнять 		= ТекСтрока.Выполнять;
					
				КонецЦикла;
			КонецЕсли;
			
			// Создание документа План регламентных операций ДУ
			Если ТаблицаОпераций.Количество() > 0 Тогда
				
				#Удаление
				Если КоличествоПотоков > 0 И ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены() Тогда  				
					
					МассивПараметров = Новый Массив;
					МассивПараметров.Добавить(ДатаПериода); 
					МассивПараметров.Добавить(ДоговорДУ);
					МассивПараметров.Добавить(ТаблицаОпераций);
					МассивПараметров.Добавить(ТекПлан);
					МассивПараметров.Добавить(ТекГруппаОперацийПользователя);
					МассивПараметров.Добавить(УчитыватьВыполненные);
					// ASP-197909 IMAPPS-35037++ Добавление СоответствиеОперацияТаблица в массив параметров для фонового задания
					МассивПараметров.Добавить(СоответствиеОперацияТаблица);
					
					ТекФоновоеЗадание = ФоновыеЗадания.Выполнить("ФоновыеЗаданияСервер.СоздатьПланРегламентныхОперацийДУ", МассивПараметров,,НаименованиеФоновогоЗадания);
					ПараметрыСохранения.СписокФоновыхЗаданий.Добавить(ТекФоновоеЗадание, СтрШаблон("по договору ДУ ""%1""", ДоговорДУ));
					Если ПараметрыСохранения.СписокФоновыхЗаданий.Количество() = КоличествоПотоков ИЛИ ТекЗначение = МаксимальноеЗначение Тогда
						
						МассивФоновыхЗаданий = ПараметрыСохранения.СписокФоновыхЗаданий.ВыгрузитьЗначения();
						РезультатЗавершенияФоновых = ОжидатьЗавершенияТекущихФоновых(МассивФоновыхЗаданий); 
						
						Для Каждого ТекЗадание Из МассивФоновыхЗаданий Цикл
							
							МассивСообщений = ТекЗадание.ПолучитьСообщенияПользователю(Истина);
							
							Если МассивСообщений <> Неопределено Тогда  
								Для Каждого ТекСообщение Из МассивСообщений Цикл
									ТекСообщение.Сообщить();
								КонецЦикла;
							КонецЕсли;  
							
							// Обрабатываем аварийно завершенные задания
							Если ТекЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда          
								
								ИнформацияПоДоговору = "";
								Для Каждого ТекИнфПоЗаданию Из ПараметрыСохранения.СписокФоновыхЗаданий Цикл
									Если ТекИнфПоЗаданию.Значение.УникальныйИдентификатор = ТекЗадание.УникальныйИдентификатор Тогда
										ИнформацияПоДоговору = ТекИнфПоЗаданию.Представление;	
									КонецЕсли;	
								КонецЦикла;
									
								ТекстОшибки = СтрШаблон("Не удалось выполнить фоновое задание %1. Техническая информация: %2", 
								ИнформацияПоДоговору, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ТекЗадание.ИнформацияОбОшибке));
								Сообщить(ТекстОшибки);
								
							КонецЕсли;	
							
						КонецЦикла;
						
						ПараметрыСохранения.СписокФоновыхЗаданий.Очистить();
						
					КонецЕсли;
					
				Иначе
					
					ФоновыеЗаданияСервер.СоздатьПланРегламентныхОперацийДУ(
					ДатаПериода,
					ДоговорДУ,
					ТаблицаОпераций,
					ТекПлан,
					ТекГруппаОперацийПользователя,
					УчитыватьВыполненные,
					СоответствиеОперацияТаблица); // ASP-197909 IMAPPS-35037++ Добавлен параметр СоответствиеОперацияТаблица
					
				КонецЕсли;
				#КонецУдаления
				#Вставка
				// IMDEV-8663.1.A
				// Удалена неиспользуемая ветка "один договор = одно фоновое задание":
				// запуск ФоновыеЗадания.Выполнить(СоздатьПланРегламентныхОперацийДУ)
				// и ожидание порции внутри этой процедуры. Сюда больше не заходят:
				// диспетчер вызывает процедуру с КоличествоПотоков = 0 и
				// ФоновыеЗаданияДоступны = Ложь; последовательный путь родителя уже
				// идёт при ФоновыеЗаданияДоступны = Ложь. Параллельность только у
				// диспетчера чанков. Остаётся синхронный вызов, как в Иначе типовой.
				ФоновыеЗаданияСервер.СоздатьПланРегламентныхОперацийДУ(
				ДатаПериода,
				ДоговорДУ,
				ТаблицаОпераций,
				ТекПлан,
				ТекГруппаОперацийПользователя,
				УчитыватьВыполненные,
				СоответствиеОперацияТаблица); // ASP-197909 IMAPPS-35037++ Добавлен параметр СоответствиеОперацияТаблица
				#КонецВставки
				
			КонецЕсли; 
			
		КонецЦикла;//Цикл по ПериодамРеглОпераций
		
	КонецПроцедуры

	// Описание: Ожидает завершение фоновых заданий порции, разбирает актуальный снимок
	// платформы, пишет журнал и копит сводку.
	//
	// Параметры:
	// ПараметрыСохранения - Структура - список заданий, счётчики, представления
	// ЖдатьВсех - Булево - Истина: барьер до пустого списка; Ложь: один шаг ожидания
	//
	Процедура IM8663_ЗавершитьФоновыеЗаданияПорции(ПараметрыСохранения, ЖдатьВсех = Истина)
		
		// IMDEV-8663.1.A
		Если ТипЗнч(ПараметрыСохранения) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ПараметрыСохранения.Свойство("СписокФоновыхЗаданий")
			Или ПараметрыСохранения.СписокФоновыхЗаданий.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ПараметрыСохранения.Свойство("УспешныхЗаданий") Тогда
			ПараметрыСохранения.Вставить("УспешныхЗаданий", 0);
		КонецЕсли;
		Если Не ПараметрыСохранения.Свойство("ОшибокЗаданий") Тогда
			ПараметрыСохранения.Вставить("ОшибокЗаданий", 0);
		КонецЕсли;
		Если Не ПараметрыСохранения.Свойство("ПроблемныеДоговоры") Тогда
			ПараметрыСохранения.Вставить("ПроблемныеДоговоры", Новый Массив);
		КонецЕсли;
		
		СоответствиеПредставлений = Новый Соответствие;
		Для Каждого ЭлементСписка Из ПараметрыСохранения.СписокФоновыхЗаданий Цикл
			СоответствиеПредставлений.Вставить(ЭлементСписка.Значение.УникальныйИдентификатор, ЭлементСписка.Представление);
		КонецЦикла;
		
		Задания = ПараметрыСохранения.СписокФоновыхЗаданий.ВыгрузитьЗначения();
		
		Если ЖдатьВсех Тогда
			Пока Истина Цикл
				Задания = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(Задания, 5);
				Если ВсеЗаданияЗавершены(Задания) Тогда
					Прервать;
				КонецЕсли;
				
				// IMDEV-8663.1.A: тот же формат прогресса, что у диспетчера (не затирать
				// "Обработано N из M" служебным "Ожидание фоновых заданий").
				АктивныхПорций = 0;
				ДоговоровВЗавершенных = 0;
				Для Каждого ТекЗадание Из Задания Цикл
					Если ТекЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
						АктивныхПорций = АктивныхПорций + 1;
					ИначеЕсли ПараметрыСохранения.Свойство("РазмерЧанкаПоУИД") Тогда
						РазмерЗавершенной = ПараметрыСохранения.РазмерЧанкаПоУИД.Получить(
							ТекЗадание.УникальныйИдентификатор);
						Если РазмерЗавершенной <> Неопределено Тогда
							ДоговоровВЗавершенных = ДоговоровВЗавершенных + РазмерЗавершенной;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				НомерНачалаПачки = 0;
				КоличествоДоговоровВсего = 0;
				РазмерПорции = 50;
				ОбработаноВПачке = 0;
				ПараметрыСохранения.Свойство("IM8663_ПрогрессНомерНачала", НомерНачалаПачки);
				ПараметрыСохранения.Свойство("IM8663_ПрогрессКоличествоДоговоров", КоличествоДоговоровВсего);
				ПараметрыСохранения.Свойство("РазмерЧанка", РазмерПорции);
				ПараметрыСохранения.Свойство("ОбработаноВПачке", ОбработаноВПачке);
				НомерПрогресса = НомерНачалаПачки + ОбработаноВПачке + ДоговоровВЗавершенных;
				
				ДлительныеОперации.СообщитьПрогресс(
					?(КоличествоДоговоровВсего > 0, Окр(100 * НомерПрогресса / КоличествоДоговоровВсего), 0),
					СтрШаблон(
						НСтр("ru='Обработано %1 из %2, активно порций %3, осталось %4. В порции до %5 договоров'"),
						НомерПрогресса,
						КоличествоДоговоровВсего,
						АктивныхПорций,
						АктивныхПорций,
						РазмерПорции));
			КонецЦикла;
		Иначе
			Задания = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(Задания, 5);
		КонецЕсли;
		
		ЗавершенныеУИД = Новый Соответствие;
		
		Для Каждого ТекЗадание Из Задания Цикл
			
			Если Не ЖдатьВсех И ТекЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				Продолжить;
			КонецЕсли;
			
			ЗавершенныеУИД.Вставить(ТекЗадание.УникальныйИдентификатор, Истина);
			
			МассивСообщений = ТекЗадание.ПолучитьСообщенияПользователю(Истина);
			Если МассивСообщений <> Неопределено Тогда
				Для Каждого ТекСообщение Из МассивСообщений Цикл
					ТекСообщение.Сообщить();
				КонецЦикла;
			КонецЕсли;
			
			ПредставлениеЗадания = СоответствиеПредставлений.Получить(ТекЗадание.УникальныйИдентификатор);
			Если Не ЗначениеЗаполнено(ПредставлениеЗадания) Тогда
				ПредставлениеЗадания = Строка(ТекЗадание.УникальныйИдентификатор);
			КонецЕсли;
			
			Если ТекЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
				ТекстОшибки = СтрШаблон(
					НСтр("ru='Не удалось выполнить фоновое задание %1. Техническая информация: %2'"),
					ПредставлениеЗадания,
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ТекЗадание.ИнформацияОбОшибке));
				Сообщить(ТекстОшибки);
				ЗаписьЖурналаРегистрации(
					"РегламентныеОперации",
					УровеньЖурналаРегистрации.Ошибка,
					,
					,
					ТекстОшибки);
				ПараметрыСохранения.ОшибокЗаданий = ПараметрыСохранения.ОшибокЗаданий + 1;
				ПараметрыСохранения.ПроблемныеДоговоры.Добавить(ПредставлениеЗадания);
			Иначе
				ПараметрыСохранения.УспешныхЗаданий = ПараметрыСохранения.УспешныхЗаданий + 1;
			КонецЕсли;
			
			Если ПараметрыСохранения.Свойство("РазмерЧанкаПоУИД") Тогда
				РазмерЧанкаЗадания = ПараметрыСохранения.РазмерЧанкаПоУИД.Получить(ТекЗадание.УникальныйИдентификатор);
				Если РазмерЧанкаЗадания <> Неопределено Тогда
					Если Не ПараметрыСохранения.Свойство("ОбработаноВПачке") Тогда
						ПараметрыСохранения.Вставить("ОбработаноВПачке", 0);
					КонецЕсли;
					ПараметрыСохранения.ОбработаноВПачке = ПараметрыСохранения.ОбработаноВПачке + РазмерЧанкаЗадания;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЖдатьВсех Тогда
			ПараметрыСохранения.СписокФоновыхЗаданий.Очистить();
		Иначе
			Индекс = ПараметрыСохранения.СписокФоновыхЗаданий.Количество() - 1;
			Пока Индекс >= 0 Цикл
				УИД = ПараметрыСохранения.СписокФоновыхЗаданий[Индекс].Значение.УникальныйИдентификатор;
				Если ЗавершенныеУИД.Получить(УИД) <> Неопределено Тогда
					ПараметрыСохранения.СписокФоновыхЗаданий.Удалить(Индекс);
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;
		КонецЕсли;
		
	КонецПроцедуры
	
	// Описание: Снимает ещё активные дочерние фоновые задания диспетчера.
	//
	// Параметры:
	// ПараметрыСохранения - Структура - содержит СписокФоновыхЗаданий
	//
	Процедура IM8663_ОтменитьАктивныеЗадания(ПараметрыСохранения)
		
		// IMDEV-8663.1.A
		Если ТипЗнч(ПараметрыСохранения) <> Тип("Структура")
			Или Не ПараметрыСохранения.Свойство("СписокФоновыхЗаданий") Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого ЭлементСписка Из ПараметрыСохранения.СписокФоновыхЗаданий Цикл
			
			Задание = ЭлементСписка.Значение;
			АктуальноеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Задание.УникальныйИдентификатор);
			Если АктуальноеЗадание <> Неопределено Тогда
				Задание = АктуальноеЗадание;
			КонецЕсли;
			
			Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				Задание.Отменить();
			КонецЕсли;
			
		КонецЦикла;
		
	КонецПроцедуры
	
#КонецОбласти

#Область IMDEV_8663_1_B
	
	// Описание: Нарезает пачку договоров на чанки одной группы, запускает скользящее окно
	// фоновых заданий и разбирает завершённые.
	//
	// Параметры:
	// ДатаПериода - Дата - дата регламентного периода
	// СписокПачки - Массив - договоры текущей пачки предподготовки
	// УчитыватьВыполненные - Булево - признак учёта уже выполненных операций
	// НаименованиеФоновогоЗадания - Строка - базовое имя задания
	// ПараметрыСохранения - Структура - кэш предподготовки, список заданий, счётчики
	// ТекущийНомер - Число - счётчик прогресса (изменяется)
	// КоличествоДоговоров - Число - размер всего отбора
	// ИндексПачки - Число - номер пачки с нуля
	//
	Процедура IM8663_ОбработатьПачкуДиспетчером(ДатаПериода, СписокПачки, УчитыватьВыполненные, НаименованиеФоновогоЗадания, ПараметрыСохранения, ТекущийНомер, КоличествоДоговоров, ИндексПачки)
		
		// IMDEV-8663.1.B
		РазмерЧанка = 50;
		Если ПараметрыСохранения.Свойство("РазмерЧанка") Тогда
			РазмерЧанка = ПараметрыСохранения.РазмерЧанка;
		КонецЕсли;
		Если РазмерЧанка < 1 Тогда
			РазмерЧанка = 1;
		КонецЕсли;
		Если СписокПачки.Количество() > 0 Тогда
			РазмерЧанка = Мин(РазмерЧанка, СписокПачки.Количество());
		КонецЕсли;
		
		КоличествоПотоков = ПараметрыСохранения.КоличествоПотоков;
		МассивРодителей = ПараметрыСохранения.МассивРодителей;
		СписокОпераций = ПараметрыСохранения.СписокОпераций;
		
		ОчередьЧанков = Новый Массив;
		НомерЧанка = 0;
		
		Для Каждого ТекГруппаОперацийПользователя Из МассивРодителей Цикл
			
			ДоговорыГруппы = Новый Массив;
			Для Каждого ТекДоговор Из СписокПачки Цикл
				
				ПараметрыПоиска = Новый Структура("ДоговорДУ, ГруппаОперацийПользователя", ТекДоговор, ТекГруппаОперацийПользователя);
				Если СписокОпераций.НайтиСтроки(ПараметрыПоиска).Количество() > 0 Тогда
					ДоговорыГруппы.Добавить(ТекДоговор);
					Продолжить;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(ТекГруппаОперацийПользователя) Тогда
					ПараметрыПоиска = Новый Структура("ДоговорДУ", Справочники.ДоговорДУ.ПустаяСсылка());
					НайденныеСтроки = СписокОпераций.НайтиСтроки(ПараметрыПоиска);
					Для Каждого ТекСтрока Из НайденныеСтроки Цикл
						Если ТекСтрока.Выполнять Тогда
							ДоговорыГруппы.Добавить(ТекДоговор);
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
			КонецЦикла;
			
			ИндексДоговора = 0;
			Пока ИндексДоговора < ДоговорыГруппы.Количество() Цикл
				
				ДоговорыЧанка = Новый Массив;
				Граница = Мин(ИндексДоговора + РазмерЧанка, ДоговорыГруппы.Количество());
				Пока ИндексДоговора < Граница Цикл
					ДоговорыЧанка.Добавить(ДоговорыГруппы[ИндексДоговора]);
					ИндексДоговора = ИндексДоговора + 1;
				КонецЦикла;
				
				НомерЧанка = НомерЧанка + 1;
				Чанк = Новый Структура;
				Чанк.Вставить("Номер", НомерЧанка);
				Чанк.Вставить("ГруппаОперацийПользователя", ТекГруппаОперацийПользователя);
				Чанк.Вставить("Договоры", ДоговорыЧанка);
				Чанк.Вставить("Представление", СтрШаблон(
					НСтр("ru='порция %1, договоров %2'"),
					НомерЧанка,
					ДоговорыЧанка.Количество()));
				ОчередьЧанков.Добавить(Чанк);
				
			КонецЦикла;
			
		КонецЦикла;
		
		ИндексОчереди = 0;
		НомерНачалаПачки = ТекущийНомер;
		ПараметрыСохранения.Вставить("ОбработаноВПачке", 0);
		ПараметрыСохранения.Вставить("IM8663_ПрогрессНомерНачала", НомерНачалаПачки);
		ПараметрыСохранения.Вставить("IM8663_ПрогрессКоличествоДоговоров", КоличествоДоговоров);
		
		Пока ИндексОчереди < ОчередьЧанков.Количество()
			Или ПараметрыСохранения.СписокФоновыхЗаданий.Количество() > 0 Цикл
			
			Пока ПараметрыСохранения.СписокФоновыхЗаданий.Количество() < КоличествоПотоков
				И ИндексОчереди < ОчередьЧанков.Количество() Цикл
				
				Чанк = ОчередьЧанков[ИндексОчереди];
				ИндексОчереди = ИндексОчереди + 1;
				
				МассивГруппы = Новый Массив;
				МассивГруппы.Добавить(Чанк.ГруппаОперацийПользователя);
				
				СрезПараметров = Новый Структура;
				СрезПараметров.Вставить("СписокОпераций", ПараметрыСохранения.СписокОпераций);
				СрезПараметров.Вставить("ДокументыПоДоговорам", ПараметрыСохранения.ДокументыПоДоговорам);
				СрезПараметров.Вставить("КоличествоПотоков", 0);
				СрезПараметров.Вставить("ФоновыеЗаданияДоступны", Ложь);
				СрезПараметров.Вставить("МассивРодителей", МассивГруппы);
				СрезПараметров.Вставить("СписокФоновыхЗаданий", Новый СписокЗначений);
				
				КлючиСоответствий = Новый Массив;
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаВзаиморасчетов");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаКупонныхПериодов");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаОстатковНКД_УУ");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаОстатков");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаАктивовОблигаций");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаОстатковПоБанковскимСчетам");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаЦБ");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаОстатковОблигаций");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаОстатковУУ");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаКотировокБУ");
				КлючиСоответствий.Добавить("СоответствиеДоговорТаблицаКотировокУУ");
				
				Для Каждого ИмяКлюча Из КлючиСоответствий Цикл
					ИсходноеСоответствие = Неопределено;
					Если ПараметрыСохранения.Свойство(ИмяКлюча, ИсходноеСоответствие)
						И ТипЗнч(ИсходноеСоответствие) = Тип("Соответствие") Тогда
						СрезСоответствия = Новый Соответствие;
						Для Каждого ТекДоговор Из Чанк.Договоры Цикл
							ЗначениеПоДоговору = ИсходноеСоответствие.Получить(ТекДоговор);
							Если ЗначениеПоДоговору <> Неопределено Тогда
								СрезСоответствия.Вставить(ТекДоговор, ЗначениеПоДоговору);
							КонецЕсли;
						КонецЦикла;
						СрезПараметров.Вставить(ИмяКлюча, СрезСоответствия);
					КонецЕсли;
				КонецЦикла;
				
				ЗначениеКакЕсть = Неопределено;
				Если ПараметрыСохранения.Свойство("ТаблицаДефолтныеСобытияКотировокУУ", ЗначениеКакЕсть) Тогда
					СрезПараметров.Вставить("ТаблицаДефолтныеСобытияКотировокУУ", ЗначениеКакЕсть);
				КонецЕсли;
				Если ПараметрыСохранения.Свойство("СоответствиеПропускРЕПОВетки", ЗначениеКакЕсть) Тогда
					СрезПараметров.Вставить("СоответствиеПропускРЕПОВетки", ЗначениеКакЕсть);
				КонецЕсли;
				
				ПараметрыЧанка = Новый Структура;
				ПараметрыЧанка.Вставить("ДатаПериода", ДатаПериода);
				ПараметрыЧанка.Вставить("УчитыватьВыполненные", УчитыватьВыполненные);
				ПараметрыЧанка.Вставить("НаименованиеФоновогоЗадания", НаименованиеФоновогоЗадания);
				ПараметрыЧанка.Вставить("Договоры", Чанк.Договоры);
				ПараметрыЧанка.Вставить("ПараметрыСохранения", СрезПараметров);
				
				МассивПараметров = Новый Массив;
				МассивПараметров.Добавить(ПараметрыЧанка);
				
				// IMDEV-8663.1.B: ключ уникален в разрезе имени метода. Имя метода теперь общее
				// для конфигурации (обёртка), поэтому ключ префиксуется идентификатором доработки.
				КлючЗадания = СтрШаблон(
					"IM8663_%1_%2_%3_%4",
					Формат(ДатаПериода, "ДФ=yyyyMMdd"),
					ИндексПачки,
					Чанк.Номер,
					XMLСтрока(Чанк.ГруппаОперацийПользователя));
				НаименованиеЧанка = СтрШаблон(
					"%1, %2",
					НаименованиеФоновогоЗадания,
					Чанк.Представление);
				
				// IMDEV-8663.1.B: платформа принимает в ФоновыеЗадания.Выполнить только методы общих
				// модулей, поэтому запуск идёт через типовую обёртку ОбщегоНазначения.ВыполнитьБПБезопасно,
				// которая вызывает метод модуля менеджера оператором Выполнить.
				ПараметрыЗадания = Новый Массив;
				ПараметрыЗадания.Добавить("Справочники.РегламентныеПериоды.IM8663_СоздатьПланыРегламентныхОперацийПоЧанку");
				ПараметрыЗадания.Добавить(МассивПараметров);
				ПараметрыЗадания.Добавить(Неопределено);
				
				ТекФоновоеЗадание = ФоновыеЗадания.Выполнить(
					"ОбщегоНазначения.ВыполнитьБПБезопасно",
					ПараметрыЗадания,
					КлючЗадания,
					НаименованиеЧанка);
				
				ПараметрыСохранения.СписокФоновыхЗаданий.Добавить(ТекФоновоеЗадание, Чанк.Представление);
				ПараметрыСохранения.РазмерЧанкаПоУИД.Вставить(
					ТекФоновоеЗадание.УникальныйИдентификатор,
					Чанк.Договоры.Количество());
				
			КонецЦикла;
			
			Если ПараметрыСохранения.СписокФоновыхЗаданий.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если ИндексОчереди >= ОчередьЧанков.Количество() Тогда
				IM8663_ЗавершитьФоновыеЗаданияПорции(ПараметрыСохранения, Истина);
			Иначе
				IM8663_ЗавершитьФоновыеЗаданияПорции(ПараметрыСохранения, Ложь);
			КонецЕсли;
			
			НомерПрогресса = НомерНачалаПачки + ПараметрыСохранения.ОбработаноВПачке;
			ОсталосьПорций = ОчередьЧанков.Количество() - ИндексОчереди
				+ ПараметрыСохранения.СписокФоновыхЗаданий.Количество();
			ДлительныеОперации.СообщитьПрогресс(
				?(КоличествоДоговоров > 0, Окр(100 * НомерПрогресса / КоличествоДоговоров), 0),
				СтрШаблон(
					НСтр("ru='Обработано %1 из %2, активно порций %3, осталось %4. В порции до %5 договоров'"),
					НомерПрогресса,
					КоличествоДоговоров,
					ПараметрыСохранения.СписокФоновыхЗаданий.Количество(),
					ОсталосьПорций,
					РазмерЧанка));
			
		КонецЦикла;
		
		ТекущийНомер = НомерНачалаПачки + СписокПачки.Количество();
		
	КонецПроцедуры
	
	// Описание: Метод дочернего задания: по каждому договору чанка вызывает
	// существующую СформироватьДокументыЗакрытияПериода в синхронном режиме.
	//
	// Параметры:
	// ПараметрыЧанка - Структура - ДатаПериода, УчитыватьВыполненные, Договоры, ПараметрыСохранения
	//
	Процедура IM8663_СоздатьПланыРегламентныхОперацийПоЧанку(ПараметрыЧанка) Экспорт
		
		// IMDEV-8663.1.B
		ДатаПериода = ПараметрыЧанка.ДатаПериода;
		УчитыватьВыполненные = ПараметрыЧанка.УчитыватьВыполненные;
		НаименованиеФоновогоЗадания = ПараметрыЧанка.НаименованиеФоновогоЗадания;
		ПараметрыСохраненияЧанка = ПараметрыЧанка.ПараметрыСохранения;
		
		Для Каждого ТекДоговор Из ПараметрыЧанка.Договоры Цикл
			
			Попытка
				СформироватьДокументыЗакрытияПериода(
					ДатаПериода,
					ТекДоговор,
					УчитыватьВыполненные,
					НаименованиеФоновогоЗадания,
					0,
					0,
					ПараметрыСохраненияЧанка);
			Исключение
				ТекстОшибки = СтрШаблон(
					НСтр("ru='Ошибка обработки договора %1 в порции: %2'"),
					ТекДоговор,
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				Сообщить(ТекстОшибки);
				ЗаписьЖурналаРегистрации(
					"РегламентныеОперации",
					УровеньЖурналаРегистрации.Ошибка,
					,
					ТекДоговор,
					ТекстОшибки);
			КонецПопытки;
			
		КонецЦикла;
		
	КонецПроцедуры
	
#КонецОбласти
