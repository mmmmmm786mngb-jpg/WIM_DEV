#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ЗаполнитьПланНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проверить(Команда)

    ЗаполнитьПланНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПеренос(Команда)

    ЗаполнитьПланНаСервере();

    Если Не МожноПеренести Тогда
        Если КоличествоКПереносу = 0 И Не СоздатьГруппу И Не ВыровнятьВремя Тогда
            ПоказатьПредупреждение(, НСтр("ru = 'Перенос уже выполнен. Запись не требуется.'"));
        Иначе
            ПоказатьПредупреждение(, НСтр("ru = 'Перенос недоступен. Исправьте ошибки по результатам проверки.'"));
        КонецЕсли;
        Возврат;
    КонецЕсли;

    ТекстВопроса = СформироватьТекстВопросаПереноса();
    Оповещение = Новый ОписаниеОповещения("ВыполнитьПереносПослеПодтверждения", ЭтотОбъект);
    ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ВернутьВВечерние(Команда)

    ЗаполнитьПланНаСервере();

    Если Не МожноВернуть Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Возврат недоступен: нет операций в группе 3 либо нет группы вечерних.'"));
        Возврат;
    КонецЕсли;

    ТекстВопроса = СформироватьТекстВопросаВозврата();
    Оповещение = Новый ОписаниеОповещения("ВернутьВВечерниеПослеПодтверждения", ЭтотОбъект);
    ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьПереносПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт

    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ВыполнитьПереносНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВернутьВВечерниеПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт

    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ВыполнитьВозвратНаСервере();

КонецПроцедуры

&НаКлиенте
Функция СформироватьТекстВопросаПереноса()

    Части = Новый Массив;
    Части.Добавить(НСтр("ru = 'Выполнить перенос операций СЧА/РСА в группу 3?'"));

    Если СоздатьГруппу Тогда
        Части.Добавить(НСтр("ru = 'Будет создана группа ""3. Расчет СЧА/РСА"".'"));
    КонецЕсли;

    Если ВыровнятьВремя Тогда
        Части.Добавить(НСтр("ru = 'Время группы 3 будет выровнено по группе 2.'"));
    КонецЕсли;

    Части.Добавить(СтрШаблон(НСтр("ru = 'Будет перенесено операций: %1.'"), Формат(КоличествоКПереносу, "ЧН=0; ЧГ=0")));

    Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

&НаКлиенте
Функция СформироватьТекстВопросаВозврата()

    Части = Новый Массив;
    Части.Добавить(НСтр("ru = 'Вернуть операции СЧА/РСА в группу ""2. Вечерние""?'"));
    Части.Добавить(СтрШаблон(НСтр("ru = 'Будет возвращено операций: %1.'"), Формат(КоличествоКВозврату, "ЧН=0; ЧГ=0")));
    Части.Добавить(НСтр("ru = 'Группа 3 не удаляется.'"));

    Если КоличествоПлановГруппы3 > 0 Тогда
        Части.Добавить(СтрШаблон(
            НСтр("ru = 'Найдены планы группы 3 без пометки удаления: %1.'"),
            Формат(КоличествоПлановГруппы3, "ЧГ=0")));
    КонецЕсли;

    Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

&НаСервере
Процедура ЗаполнитьПланНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Результат = ОбработкаОбъект.ПолучитьПланПереноса();

    ПланДействий.Очистить();
    Для Каждого СтрокаПлана Из Результат.ТаблицаПлана Цикл
        НоваяСтрока = ПланДействий.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлана);
    КонецЦикла;

    Протокол = Результат.Протокол;
    МожноПеренести = Результат.МожноПеренести;
    МожноВернуть = Результат.МожноВернуть;
    КоличествоКПереносу = Результат.КоличествоКПереносу;
    КоличествоКВозврату = Результат.КоличествоКВозврату;
    СоздатьГруппу = Результат.СоздатьГруппу;
    ВыровнятьВремя = Результат.ВыровнятьВремя;
    КоличествоПлановГруппы3 = Результат.КоличествоПлановГруппы3;

    ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаСервере
Процедура ВыполнитьПереносНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ТекстВыполнения = ОбработкаОбъект.ВыполнитьПеренос();
    ЗаполнитьПланНаСервере();
    Протокол = ТекстВыполнения + Символы.ПС + Символы.ПС
        + НСтр("ru = 'Состояние после записи:'") + Символы.ПС + Протокол;

КонецПроцедуры

&НаСервере
Процедура ВыполнитьВозвратНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ТекстВыполнения = ОбработкаОбъект.ВыполнитьВозврат();
    ЗаполнитьПланНаСервере();
    Протокол = ТекстВыполнения + Символы.ПС + Символы.ПС
        + НСтр("ru = 'Состояние после записи:'") + Символы.ПС + Протокол;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКоманд()

    Элементы.ВыполнитьПеренос.Доступность = МожноПеренести;
    Элементы.ВернутьВВечерние.Доступность = МожноВернуть;

    СостояниеКнопок = СтрШаблон(
        НСтр("ru = 'К переносу в группу 3: %1. К возврату в вечерние: %2.'"),
        Формат(КоличествоКПереносу, "ЧН=0; ЧГ=0"),
        Формат(КоличествоКВозврату, "ЧН=0; ЧГ=0"));

КонецПроцедуры

#КонецОбласти
