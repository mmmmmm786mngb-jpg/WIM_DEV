#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Описание: Возвращает сведения для подключения обработки в подсистеме
// БСП "Дополнительные отчеты и обработки".
//
// Возвращаемое значение:
//  Структура - параметры регистрации внешней обработки
//
Функция СведенияОВнешнейОбработке() Экспорт

    МетаданныеОбработки = Метаданные();

    ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
    ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
    ПараметрыРегистрации.Версия = "1.0.0.1";
    ПараметрыРегистрации.БезопасныйРежим = Ложь;
    ПараметрыРегистрации.Информация = НСтр(
        "ru = 'Создание группы ""3. Расчет СЧА/РСА"" и перенос пяти операций.
        |Есть возврат операций в группу ""2. Вечерние"".'");

    НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
    НоваяКоманда.Представление = МетаданныеОбработки.Представление();
    НоваяКоманда.Идентификатор = МетаданныеОбработки.Имя;
    НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
    НоваяКоманда.ПоказыватьОповещение = Ложь;

    Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Строит план переноса пяти операций СЧА/РСА без записи в базу.
// Показывает текущие группы, что сделает перенос в группу 3 и что сделает возврат.
//
// Возвращаемое значение:
//  Структура - поля:
//   ТаблицаПлана - ТаблицаЗначений - колонки Объект, ТекущаяГруппа, ЦелеваяГруппа, Действие
//   Протокол - Строка - текст проверки
//   ЕстьОшибки - Булево
//   МожноПеренести - Булево - доступен перенос в группу 3
//   МожноВернуть - Булево - доступен возврат в вечерние
//   КоличествоКПереносу - Число
//   КоличествоКВозврату - Число
//   СоздатьГруппу - Булево
//   ВыровнятьВремя - Булево
//   КоличествоПлановГруппы3 - Число - планы без пометки удаления (предупреждение)
//
Функция ПолучитьПланПереноса() Экспорт

    УстановитьПривилегированныйРежим(Истина);

    Результат = НовыйПустойРезультатПлана();
    Контекст = КонтекстПереноса();

    Если Контекст.ГруппаВечерние.Пустая() Тогда
        ДобавитьСтрокуПлана(Результат.ТаблицаПлана,
            НСтр("ru = 'Группа ""2. Вечерние"" операции'"),
            НСтр("ru = '(не найдена)'"),
            "",
            НСтр("ru = 'Ошибка: не найдено'"));
        Результат.ЕстьОшибки = Истина;
        Результат.Протокол = НСтр("ru = 'Не найдена группа ""2. Вечерние операции"". Перенос и возврат недоступны.'");
        Возврат Результат;
    КонецЕсли;

    ИмяВечерних = ПредставлениеСсылки(Контекст.ГруппаВечерние);
    ИмяГруппы3 = Контекст.НаименованиеГруппы3;

    Если Контекст.ГруппаСЧА.Пустая() Тогда
        ДобавитьСтрокуПлана(Результат.ТаблицаПлана,
            ИмяГруппы3,
            НСтр("ru = '(нет)'"),
            ИмяГруппы3,
            НСтр("ru = 'Создать группу'"));
        Результат.СоздатьГруппу = Истина;
    Иначе
        Если Контекст.ГруппаСЧА.ВремяРеглОпераций <> Контекст.ГруппаВечерние.ВремяРеглОпераций Тогда
            ДобавитьСтрокуПлана(Результат.ТаблицаПлана,
                ПредставлениеСсылки(Контекст.ГруппаСЧА),
                ПредставлениеСсылки(Контекст.ГруппаСЧА),
                ИмяГруппы3,
                НСтр("ru = 'Выровнять время группы'"));
            Результат.ВыровнятьВремя = Истина;
        Иначе
            ДобавитьСтрокуПлана(Результат.ТаблицаПлана,
                ПредставлениеСсылки(Контекст.ГруппаСЧА),
                ПредставлениеСсылки(Контекст.ГруппаСЧА),
                ИмяГруппы3,
                НСтр("ru = 'Группа уже существует'"));
        КонецЕсли;
        Результат.КоличествоПлановГруппы3 = КоличествоПлановГруппы(Контекст.ГруппаСЧА);
        Если Результат.КоличествоПлановГруппы3 > 0 Тогда
            ДобавитьСтрокуПлана(Результат.ТаблицаПлана,
                НСтр("ru = 'Планы регламентных операций группы 3'"),
                ИмяГруппы3,
                "",
                СтрШаблон(НСтр("ru = 'Предупреждение: есть планы группы 3 (%1 шт.), группа не удаляется'"),
                    Формат(Результат.КоличествоПлановГруппы3, "ЧГ=0")));
        КонецЕсли;
    КонецЕсли;

    Индекс = 0;
    Для Каждого ВидОперации Из Контекст.ВидыОпераций Цикл

        ИмяОперации = Контекст.ИменаВидовОпераций[Индекс];
        Индекс = Индекс + 1;

        Если Не ЗначениеЗаполнено(ВидОперации) Тогда
            ДобавитьСтрокуПлана(Результат.ТаблицаПлана,
                ИмяОперации,
                НСтр("ru = '(не найдено)'"),
                ИмяГруппы3,
                НСтр("ru = 'Ошибка: не найдено'"));
            Результат.ЕстьОшибки = Истина;
            Продолжить;
        КонецЕсли;

        ТекущаяГруппа = ПредставлениеРодителя(ВидОперации.Родитель);

        Если Не Контекст.ГруппаСЧА.Пустая() И ВидОперации.Родитель = Контекст.ГруппаСЧА Тогда
            ДобавитьСтрокуПлана(Результат.ТаблицаПлана,
                Строка(ВидОперации),
                ТекущаяГруппа,
                ИмяВечерних,
                НСтр("ru = 'Уже в группе 3'"));
            Результат.КоличествоКВозврату = Результат.КоличествоКВозврату + 1;
        Иначе
            ДобавитьСтрокуПлана(Результат.ТаблицаПлана,
                Строка(ВидОперации),
                ТекущаяГруппа,
                ИмяГруппы3,
                НСтр("ru = 'Перенести в группу 3'"));
            Результат.КоличествоКПереносу = Результат.КоличествоКПереносу + 1;
        КонецЕсли;

    КонецЦикла;

    Результат.МожноПеренести = Не Результат.ЕстьОшибки
        И (Результат.СоздатьГруппу Или Результат.ВыровнятьВремя Или Результат.КоличествоКПереносу > 0);
    Результат.МожноВернуть = Не Результат.ЕстьОшибки
        И Не Контекст.ГруппаСЧА.Пустая()
        И Результат.КоличествоКВозврату > 0;

    Результат.Протокол = СобратьПротоколПроверки(Результат);

    Возврат Результат;

КонецФункции

// Описание: Создает группу "3. Расчет СЧА/РСА" при необходимости и переносит
// в неё пять операций СЧА/РСА. Идемпотентна: уже перенесенные элементы не меняет.
//
// Возвращаемое значение:
//  Строка - протокол выполнения
//
Функция ВыполнитьПеренос() Экспорт

    УстановитьПривилегированныйРежим(Истина);

    План = ПолучитьПланПереноса();
    Если План.ЕстьОшибки Тогда
        ТекстОшибки = НСтр("ru = 'Перенос не выполнен: в плане есть ошибки. Сначала нажмите ""Проверить"".'");
        ЗаписатьВЖурнал(ТекстОшибки + Символы.ПС + План.Протокол, Истина);
        Возврат ТекстОшибки + Символы.ПС + План.Протокол;
    КонецЕсли;

    Если Не План.МожноПеренести Тогда
        Текст = НСтр("ru = 'Перенос уже выполнен. Запись не требуется.'");
        Возврат Текст + Символы.ПС + План.Протокол;
    КонецЕсли;

    Контекст = КонтекстПереноса();
    Протокол = "";

    ГруппаСЧА = ОбеспечитьГруппуСЧА(Контекст, Протокол);
    Если Не ЗначениеЗаполнено(ГруппаСЧА) Тогда
        ЗаписатьВЖурнал(Протокол, Истина);
        Возврат Протокол;
    КонецЕсли;

    Для Каждого ВидОперации Из Контекст.ВидыОпераций Цикл

        Если Не ЗначениеЗаполнено(ВидОперации) Тогда
            Продолжить;
        КонецЕсли;

        Если ВидОперации.Родитель = ГруппаСЧА Тогда
            Протокол = Протокол + СтрШаблон(НСтр("ru = 'Пропущено (уже в группе 3): %1'"), ВидОперации) + Символы.ПС;
            Продолжить;
        КонецЕсли;

        Попытка
            ОбъектОперации = ВидОперации.ПолучитьОбъект();
            СтарыйРодитель = ОбъектОперации.Родитель;
            ОбъектОперации.Родитель = ГруппаСЧА;
            ОбъектОперации.Записать();
            Протокол = Протокол + СтрШаблон(
                НСтр("ru = 'Перенесено: %1 (было: %2)'"),
                ВидОперации,
                ПредставлениеРодителя(СтарыйРодитель)) + Символы.ПС;
        Исключение
            ТекстОшибки = СтрШаблон(
                НСтр("ru = 'Ошибка переноса %1: %2'"),
                ВидОперации,
                ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
            Протокол = Протокол + ТекстОшибки + Символы.ПС;
            ЗаписатьВЖурнал(ТекстОшибки, Истина);
        КонецПопытки;

    КонецЦикла;

    ЗаписатьВЖурнал(Протокол, Ложь);
    Возврат Протокол;

КонецФункции

// Описание: Возвращает пять операций СЧА/РСА из группы 3 в группу "2. Вечерние".
// Группу 3 не удаляет. Идемпотентна: операции, которые уже не в группе 3, пропускает.
//
// Возвращаемое значение:
//  Строка - протокол выполнения
//
Функция ВыполнитьВозврат() Экспорт

    УстановитьПривилегированныйРежим(Истина);

    План = ПолучитьПланПереноса();
    Если План.ЕстьОшибки Тогда
        ТекстОшибки = НСтр("ru = 'Возврат не выполнен: в плане есть ошибки. Сначала нажмите ""Проверить"".'");
        ЗаписатьВЖурнал(ТекстОшибки + Символы.ПС + План.Протокол, Истина);
        Возврат ТекстОшибки + Символы.ПС + План.Протокол;
    КонецЕсли;

    Если Не План.МожноВернуть Тогда
        Текст = НСтр("ru = 'Возврат недоступен: нет операций в группе 3, либо нет группы вечерних.'");
        Возврат Текст + Символы.ПС + План.Протокол;
    КонецЕсли;

    Контекст = КонтекстПереноса();
    Протокол = "";

    Если План.КоличествоПлановГруппы3 > 0 Тогда
        Протокол = Протокол + СтрШаблон(
            НСтр("ru = 'Предупреждение: найдены планы группы 3 (%1 шт.). Группа 3 не удаляется.'"),
            Формат(План.КоличествоПлановГруппы3, "ЧГ=0")) + Символы.ПС;
    КонецЕсли;

    Для Каждого ВидОперации Из Контекст.ВидыОпераций Цикл

        Если Не ЗначениеЗаполнено(ВидОперации) Тогда
            Продолжить;
        КонецЕсли;

        Если ВидОперации.Родитель <> Контекст.ГруппаСЧА Тогда
            Протокол = Протокол + СтрШаблон(
                НСтр("ru = 'Пропущено (не в группе 3): %1'"),
                ВидОперации) + Символы.ПС;
            Продолжить;
        КонецЕсли;

        Попытка
            ОбъектОперации = ВидОперации.ПолучитьОбъект();
            ОбъектОперации.Родитель = Контекст.ГруппаВечерние;
            ОбъектОперации.Записать();
            Протокол = Протокол + СтрШаблон(
                НСтр("ru = 'Возвращено в вечерние: %1'"),
                ВидОперации) + Символы.ПС;
        Исключение
            ТекстОшибки = СтрШаблон(
                НСтр("ru = 'Ошибка возврата %1: %2'"),
                ВидОперации,
                ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
            Протокол = Протокол + ТекстОшибки + Символы.ПС;
            ЗаписатьВЖурнал(ТекстОшибки, Истина);
        КонецПопытки;

    КонецЦикла;

    ЗаписатьВЖурнал(Протокол, Ложь);
    Возврат Протокол;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонтекстПереноса()

    Контекст = Новый Структура;
    Контекст.Вставить("КодГруппы3", "3. ""Расчет СЧА/РСА""");
    Контекст.Вставить("КодВечерних", "2. ""Вечерние"" операции");
    Контекст.Вставить("НаименованиеГруппы3", "3. Расчет СЧА/РСА");
    Контекст.Вставить("ГруппаВечерние", Справочники.ВидыОперацийЗакрытияПериода.НайтиПоКоду(Контекст.КодВечерних));
    Контекст.Вставить("ГруппаСЧА", Справочники.ВидыОперацийЗакрытияПериода.НайтиПоКоду(Контекст.КодГруппы3));

    ИменаВидовОпераций = Новый Массив;
    ИменаВидовОпераций.Добавить("РасчетРСА_БУ");
    ИменаВидовОпераций.Добавить("РасчетСЧА_БУ");
    ИменаВидовОпераций.Добавить("РасчетДоходностиПортфеля_БУ");
    ИменаВидовОпераций.Добавить("КонтрольУменьшенияСтоимостиПортфеля_УУ");
    ИменаВидовОпераций.Добавить("КонтрольПревышенияУровняРисков_УУ");
    Контекст.Вставить("ИменаВидовОпераций", ИменаВидовОпераций);

    ВидыОпераций = Новый Массив;
    ВидыОпераций.Добавить(Справочники.ВидыОперацийЗакрытияПериода.РасчетРСА_БУ);
    ВидыОпераций.Добавить(Справочники.ВидыОперацийЗакрытияПериода.РасчетСЧА_БУ);
    ВидыОпераций.Добавить(Справочники.ВидыОперацийЗакрытияПериода.РасчетДоходностиПортфеля_БУ);
    ВидыОпераций.Добавить(Справочники.ВидыОперацийЗакрытияПериода.КонтрольУменьшенияСтоимостиПортфеля_УУ);
    ВидыОпераций.Добавить(Справочники.ВидыОперацийЗакрытияПериода.КонтрольПревышенияУровняРисков_УУ);
    Контекст.Вставить("ВидыОпераций", ВидыОпераций);

    Возврат Контекст;

КонецФункции

Функция НовыйПустойРезультатПлана()

    Результат = Новый Структура;
    Результат.Вставить("ТаблицаПлана", НоваяТаблицаПлана());
    Результат.Вставить("Протокол", "");
    Результат.Вставить("ЕстьОшибки", Ложь);
    Результат.Вставить("МожноПеренести", Ложь);
    Результат.Вставить("МожноВернуть", Ложь);
    Результат.Вставить("КоличествоКПереносу", 0);
    Результат.Вставить("КоличествоКВозврату", 0);
    Результат.Вставить("СоздатьГруппу", Ложь);
    Результат.Вставить("ВыровнятьВремя", Ложь);
    Результат.Вставить("КоличествоПлановГруппы3", 0);

    Возврат Результат;

КонецФункции

Функция НоваяТаблицаПлана()

    ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200));
    ТаблицаПлана = Новый ТаблицаЗначений;
    ТаблицаПлана.Колонки.Добавить("Объект", ТипСтрока);
    ТаблицаПлана.Колонки.Добавить("ТекущаяГруппа", ТипСтрока);
    ТаблицаПлана.Колонки.Добавить("ЦелеваяГруппа", ТипСтрока);
    ТаблицаПлана.Колонки.Добавить("Действие", ТипСтрока);

    Возврат ТаблицаПлана;

КонецФункции

Процедура ДобавитьСтрокуПлана(ТаблицаПлана, Объект, ТекущаяГруппа, ЦелеваяГруппа, Действие)

    СтрокаПлана = ТаблицаПлана.Добавить();
    СтрокаПлана.Объект = Объект;
    СтрокаПлана.ТекущаяГруппа = ТекущаяГруппа;
    СтрокаПлана.ЦелеваяГруппа = ЦелеваяГруппа;
    СтрокаПлана.Действие = Действие;

КонецПроцедуры

Функция ПредставлениеСсылки(Ссылка)

    Если Не ЗначениеЗаполнено(Ссылка) Тогда
        Возврат НСтр("ru = '(не найдено)'");
    КонецЕсли;

    Возврат Строка(Ссылка);

КонецФункции

Функция ПредставлениеРодителя(Родитель)

    Если Не ЗначениеЗаполнено(Родитель) Тогда
        Возврат НСтр("ru = '(не заполнен)'");
    КонецЕсли;

    Возврат Строка(Родитель);

КонецФункции

Функция КоличествоПлановГруппы(ГруппаОпераций)

    Если Не ЗначениеЗаполнено(ГруппаОпераций) Тогда
        Возврат 0;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    КОЛИЧЕСТВО(ПланРегламентныхОперацийДУ.Ссылка) КАК Количество
    |ИЗ
    |    Документ.ПланРегламентныхОперацийДУ КАК ПланРегламентныхОперацийДУ
    |ГДЕ
    |    ПланРегламентныхОперацийДУ.ГруппаОперацийПользователя = &Группа
    |    И ПланРегламентныхОперацийДУ.ПометкаУдаления = ЛОЖЬ";
    Запрос.УстановитьПараметр("Группа", ГруппаОпераций);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Количество;
    КонецЕсли;

    Возврат 0;

КонецФункции

Функция СобратьПротоколПроверки(Результат)

    Части = Новый Массив;

    Если Результат.ЕстьОшибки Тогда
        Части.Добавить(НСтр("ru = 'Проверка: есть ошибки. Запись заблокирована.'"));
    Иначе
        Части.Добавить(НСтр("ru = 'Проверка выполнена, ошибок нет.'"));
    КонецЕсли;

    Если Результат.СоздатьГруппу Тогда
        Части.Добавить(НСтр("ru = 'Будет создана группа ""3. Расчет СЧА/РСА"".'"));
    КонецЕсли;

    Если Результат.ВыровнятьВремя Тогда
        Части.Добавить(НСтр("ru = 'Время группы 3 будет выровнено по группе 2.'"));
    КонецЕсли;

    Части.Добавить(СтрШаблон(НСтр("ru = 'К переносу в группу 3: %1.'"), Формат(Результат.КоличествоКПереносу, "ЧН=0; ЧГ=0")));
    Части.Добавить(СтрШаблон(НСтр("ru = 'К возврату в вечерние: %1.'"), Формат(Результат.КоличествоКВозврату, "ЧН=0; ЧГ=0")));

    Если Результат.КоличествоПлановГруппы3 > 0 Тогда
        Части.Добавить(СтрШаблон(
            НСтр("ru = 'Найдены планы группы 3 без пометки удаления: %1. При возврате группа 3 не удаляется.'"),
            Формат(Результат.КоличествоПлановГруппы3, "ЧГ=0")));
    КонецЕсли;

    Если Не Результат.МожноПеренести Тогда
        Части.Добавить(НСтр("ru = 'Кнопка ""Выполнить перенос"" недоступна.'"));
    КонецЕсли;

    Если Не Результат.МожноВернуть Тогда
        Части.Добавить(НСтр("ru = 'Кнопка ""Вернуть в вечерние"" недоступна.'"));
    КонецЕсли;

    Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Функция ОбеспечитьГруппуСЧА(Контекст, Протокол)

    ГруппаСЧА = Контекст.ГруппаСЧА;

    Если ГруппаСЧА.Пустая() Тогда

        Попытка
            ГруппаОбъект = Справочники.ВидыОперацийЗакрытияПериода.СоздатьГруппу();
            ГруппаОбъект.Код = Контекст.КодГруппы3;
            ГруппаОбъект.Наименование = Контекст.НаименованиеГруппы3;
            ГруппаОбъект.Родитель = Контекст.ГруппаВечерние.Родитель;
            ГруппаОбъект.ВремяРеглОпераций = Контекст.ГруппаВечерние.ВремяРеглОпераций;
            ГруппаОбъект.Записать();
            ГруппаСЧА = ГруппаОбъект.Ссылка;
            Протокол = Протокол + СтрШаблон(НСтр("ru = 'Создана группа: %1'"), Контекст.КодГруппы3) + Символы.ПС;
        Исключение
            Протокол = Протокол + СтрШаблон(
                НСтр("ru = 'Ошибка создания группы 3: %1'"),
                ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
            Возврат Неопределено;
        КонецПопытки;

    Иначе

        ГруппаОбъект = ГруппаСЧА.ПолучитьОбъект();
        Если ГруппаОбъект.ВремяРеглОпераций <> Контекст.ГруппаВечерние.ВремяРеглОпераций Тогда
            Попытка
                ГруппаОбъект.ВремяРеглОпераций = Контекст.ГруппаВечерние.ВремяРеглОпераций;
                ГруппаОбъект.Записать();
                Протокол = Протокол + НСтр("ru = 'Обновлено ВремяРеглОпераций группы 3 по группе 2'") + Символы.ПС;
            Исключение
                Протокол = Протокол + СтрШаблон(
                    НСтр("ru = 'Ошибка выравнивания времени группы 3: %1'"),
                    ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())) + Символы.ПС;
            КонецПопытки;
        Иначе
            Протокол = Протокол + СтрШаблон(НСтр("ru = 'Группа уже существует: %1'"), Контекст.КодГруппы3) + Символы.ПС;
        КонецЕсли;

    КонецЕсли;

    Возврат ГруппаСЧА;

КонецФункции

Процедура ЗаписатьВЖурнал(Текст, ЭтоОшибка)

    Если Не ЗначениеЗаполнено(Текст) Тогда
        Возврат;
    КонецЕсли;

    Если ЭтоОшибка Тогда
        Уровень = УровеньЖурналаРегистрации.Ошибка;
    Иначе
        Уровень = УровеньЖурналаРегистрации.Информация;
    КонецЕсли;

    ЗаписьЖурналаРегистрации(
        "IMDEV-8663.2",
        Уровень,
        Метаданные.Справочники.ВидыОперацийЗакрытияПериода,
        ,
        Текст);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
