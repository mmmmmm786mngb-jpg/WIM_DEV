{
  "title": "Сверка документов операций СЧА/РСА",
  "properties": {
    "autoTitle": false,
    "width": 96,
    "height": 36
  },
  "events": {
    "OnCreateAtServer": "ПриСозданииНаСервере"
  },
  "elements": [
    { "autoCmdBar": "ФормаКоманднаяПанель", "autofill": true },
    {
      "label": "Пояснение",
      "title": "Снимок шапок и табличных частей документов по операциям СЧА/РСА без номеров документов и номеров строк. Ключ строки сверки: тип документа + договор ДУ. Пометку планов в ФЗ запускать только после загрузки обработки в справочник дополнительных отчетов и обработок."
    },
    {
      "group": "alwaysHorizontal",
      "name": "ГруппаШапка",
      "children": [
        { "input": "ДатаПериода", "path": "ДатаПериода", "title": "День расчета" },
        { "input": "МеткаСнимка", "path": "МеткаСнимка", "title": "Метка снимка" },
        { "labelField": "КоличествоПотоков", "path": "КоличествоПотоков", "title": "Потоков пометки планов" },
        { "labelField": "ДополнительнаяОбработкаСсылка", "path": "ДополнительнаяОбработкаСсылка", "title": "Регистрация в доп. обработках" }
      ]
    },
    {
      "cmdBar": "ПанельДействий",
      "autofill": false,
      "children": [
        { "button": "СохранитьСнимок", "command": "СохранитьСнимок", "defaultButton": true },
        { "button": "ПометитьПланы", "command": "ПометитьПланы" },
        { "button": "ВыбратьФайлЭталона", "command": "ВыбратьФайлЭталона" },
        { "button": "ВыбратьФайлПосле", "command": "ВыбратьФайлПосле" },
        { "button": "СверитьФайлы", "command": "СверитьФайлы" }
      ]
    },
    {
      "group": "vertical",
      "name": "ГруппаФайлы",
      "children": [
        { "input": "ИмяФайлаЭталона", "path": "ИмяФайлаЭталона", "title": "Файл эталона (до)", "readOnly": true },
        { "input": "ИмяФайлаПосле", "path": "ИмяФайлаПосле", "title": "Файл после доработки", "readOnly": true }
      ]
    },
    { "input": "СводкаСверки", "path": "СводкаСверки", "title": "Сводка сверки", "readOnly": true },
    {
      "table": "РезультатСверки",
      "path": "РезультатСверки",
      "title": "Расхождения",
      "height": 10,
      "changeRowSet": false,
      "changeRowOrder": false,
      "commandBarLocation": "None",
      "columns": [
        { "input": "ВидОтклонения", "path": "РезультатСверки.ВидОтклонения", "title": "Вид", "readOnly": true },
        { "input": "ТипДокумента", "path": "РезультатСверки.ТипДокумента", "title": "Документ", "readOnly": true },
        { "input": "ДоговорДУ", "path": "РезультатСверки.ДоговорДУ", "title": "Договор ДУ", "readOnly": true },
        { "input": "Поле", "path": "РезультатСверки.Поле", "title": "Поле / строка ТЧ", "readOnly": true },
        { "input": "Эталон", "path": "РезультатСверки.Эталон", "title": "Эталон", "readOnly": true },
        { "input": "После", "path": "РезультатСверки.После", "title": "После", "readOnly": true }
      ]
    },
    {
      "input": "Протокол",
      "path": "Протокол",
      "title": "Протокол",
      "multiLine": true,
      "readOnly": true,
      "height": 7
    }
  ],
  "attributes": [
    { "name": "Объект", "type": "ExternalDataProcessorObject.СверкаДокументовОперацийСЧА_РСА", "main": true },
    { "name": "ДополнительнаяОбработкаСсылка", "type": "CatalogRef.ДополнительныеОтчетыИОбработки" },
    { "name": "ДатаПериода", "type": "date" },
    { "name": "МеткаСнимка", "type": "string(100)" },
    { "name": "КоличествоПотоков", "type": "decimal(10,0)" },
    { "name": "ИмяФайлаЭталона", "type": "string" },
    { "name": "ИмяФайлаПосле", "type": "string" },
    { "name": "СводкаСверки", "type": "string" },
    { "name": "Протокол", "type": "string" },
    {
      "name": "РезультатСверки",
      "type": "ValueTable",
      "columns": [
        { "name": "ВидОтклонения", "type": "string(80)" },
        { "name": "ТипДокумента", "type": "string(80)" },
        { "name": "ДоговорДУ", "type": "string(120)" },
        { "name": "Поле", "type": "string(250)" },
        { "name": "Эталон", "type": "string" },
        { "name": "После", "type": "string" }
      ]
    }
  ],
  "commands": [
    { "name": "СохранитьСнимок", "action": "СохранитьСнимок", "title": "Сохранить снимок в файл" },
    { "name": "ПометитьПланы", "action": "ПометитьПланы", "title": "Пометить планы за день" },
    { "name": "ВыбратьФайлЭталона", "action": "ВыбратьФайлЭталона", "title": "Файл эталона" },
    { "name": "ВыбратьФайлПосле", "action": "ВыбратьФайлПосле", "title": "Файл после" },
    { "name": "СверитьФайлы", "action": "СверитьФайлы", "title": "Сверить два файла" }
  ]
}
