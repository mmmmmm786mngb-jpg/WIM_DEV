#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
        ДатаПериода = НачалоДня(ТекущаяДатаСеанса());
    КонецЕсли;

    Если Не ЗначениеЗаполнено(МеткаСнимка) Тогда
        МеткаСнимка = "etalon";
    КонецЕсли;

    КоличествоПотоков = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
    Если КоличествоПотоков < 1 Тогда
        КоличествоПотоков = 1;
    КонецЕсли;

    ЗаполнитьСсылкуДополнительнойОбработки();
    Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
        Протокол = НСтр(
            "ru = 'Обработка не зарегистрирована в справочнике ""Дополнительные отчеты и обработки"".
            |Загрузите EPF туда (публикация ""Используется"") и откройте команду из дополнительных обработок.
            |Снимок и сверка файлов работают и без регистрации, пометка планов в ФЗ - нет.'");
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьСнимок(Команда)

    Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Укажите день расчета.'"));
        Возврат;
    КонецЕсли;

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Фильтр = НСтр("ru = 'JSON (*.json)|*.json|Все файлы (*.*)|*.*'");
    Диалог.Расширение = "json";
    Диалог.ПолноеИмяФайла = ПредлагаемоеИмяФайлаСнимка();
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Заголовок = НСтр("ru = 'Куда сохранить снимок документов'");

    Оповещение = Новый ОписаниеОповещения("СохранитьСнимокПослеВыбора", ЭтотОбъект);
    Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПометитьПланы(Команда)

    Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Укажите день расчета.'"));
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
        ПоказатьПредупреждение(, НСтр(
            "ru = 'Обработка не зарегистрирована в справочнике ""Дополнительные отчеты и обработки"".
            |Загрузите EPF в этот справочник и откройте команду оттуда, иначе фоновые задания не запустятся.'"));
        Возврат;
    КонецЕсли;

    Оповещение = Новый ОписаниеОповещения("ПометитьПланыПослеПодтверждения", ЭтотОбъект);
    ПоказатьВопрос(
        Оповещение,
        СтрШаблон(
            НСтр("ru = 'Пометить на удаление ВСЕ планы регл. операций за %1 (и подчиненные документы)? Отбор по договорам не используется.'"),
            Формат(ДатаПериода, "ДЛФ=D")),
        РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлЭталона(Команда)

    ВыбратьФайлСнимка(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлПосле(Команда)

    ВыбратьФайлСнимка(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура СверитьФайлы(Команда)

    Если Не ЗначениеЗаполнено(ИмяФайлаЭталона) Или Не ЗначениеЗаполнено(ИмяФайлаПосле) Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Укажите оба файла снимка (эталон и после доработки).'"));
        Возврат;
    КонецЕсли;

    ТекстЭталона = ПрочитатьТекстФайла(ИмяФайлаЭталона);
    ТекстПосле = ПрочитатьТекстФайла(ИмяФайлаПосле);
    Если ТекстЭталона = Неопределено Или ТекстПосле = Неопределено Тогда
        Возврат;
    КонецЕсли;

    СверитьФайлыНаСервере(ТекстЭталона, ТекстПосле);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СохранитьСнимокПослеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ИмяФайла = ВыбранныеФайлы[0];
    Результат = СобратьСнимокНаСервере();
    Если Не ЗначениеЗаполнено(Результат.ТекстJSON) Тогда
        Протокол = Результат.Протокол;
        Возврат;
    КонецЕсли;

    Попытка
        ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
        ЗаписьТекста.Записать(Результат.ТекстJSON);
        ЗаписьТекста.Закрыть();
    Исключение
        ПоказатьПредупреждение(,
            НСтр("ru = 'Не удалось записать файл: '")
            + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат;
    КонецПопытки;

    Протокол = Результат.Протокол + Символы.ПС
        + СтрШаблон(НСтр("ru = 'Файл: %1'"), ИмяФайла);

    Если СтрНайти(НРег(МеткаСнимка), "after") > 0
        Или СтрНайти(НРег(МеткаСнимка), "после") > 0 Тогда
        ИмяФайлаПосле = ИмяФайла;
    Иначе
        ИмяФайлаЭталона = ИмяФайла;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПометитьПланыПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт

    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    Протокол = ВыполнитьПометкуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлСнимка(ЭтоЭталон)

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = НСтр("ru = 'JSON (*.json)|*.json|Все файлы (*.*)|*.*'");
    Диалог.МножественныйВыбор = Ложь;
    Если ЭтоЭталон Тогда
        Диалог.Заголовок = НСтр("ru = 'Файл эталона (до доработки)'");
    Иначе
        Диалог.Заголовок = НСтр("ru = 'Файл после доработки'");
    КонецЕсли;

    Оповещение = Новый ОписаниеОповещения("ВыбратьФайлСнимкаПослеВыбора", ЭтотОбъект, ЭтоЭталон);
    Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлСнимкаПослеВыбора(ВыбранныеФайлы, ЭтоЭталон) Экспорт

    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Если ЭтоЭталон Тогда
        ИмяФайлаЭталона = ВыбранныеФайлы[0];
    Иначе
        ИмяФайлаПосле = ВыбранныеФайлы[0];
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПредлагаемоеИмяФайлаСнимка()

    Метка = СокрЛП(МеткаСнимка);
    Если Не ЗначениеЗаполнено(Метка) Тогда
        Метка = "snapshot";
    КонецЕсли;

    Возврат СтрШаблон("scha_rsa_%1_%2.json", Формат(ДатаПериода, "ДФ=yyyyMMdd"), Метка);

КонецФункции

&НаКлиенте
Функция ПрочитатьТекстФайла(ИмяФайла)

    Попытка
        ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
        Текст = ЧтениеТекста.Прочитать();
        ЧтениеТекста.Закрыть();
    Исключение
        ПоказатьПредупреждение(,
            СтрШаблон(НСтр("ru = 'Не удалось прочитать файл %1: %2'"),
                ИмяФайла,
                ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
        Возврат Неопределено;
    КонецПопытки;

    Возврат Текст;

КонецФункции

&НаСервере
Функция СобратьСнимокНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Возврат ОбработкаОбъект.СобратьСнимокЗаДень(ДатаПериода, МеткаСнимка);

КонецФункции

&НаСервере
Процедура СверитьФайлыНаСервере(ТекстЭталона, ТекстПосле)

    РезультатСверки.Очистить();
    СводкаСверки = "";

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Результат = ОбработкаОбъект.СверитьСнимки(ТекстЭталона, ТекстПосле);
    СводкаСверки = Результат.Сводка;
    Протокол = Результат.Протокол;

    Для Каждого СтрокаТаблицы Из Результат.ТаблицаРасхождений Цикл
        НоваяСтрока = РезультатСверки.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
    КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСсылкуДополнительнойОбработки()

    СсылкаИзПараметров = Неопределено;
    Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", СсылкаИзПараметров) Тогда
        ДополнительнаяОбработкаСсылка = СсылкаИзПараметров;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
        ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
        ДополнительнаяОбработкаСсылка = ОбработкаОбъект.СсылкаДополнительнойОбработки();
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВыполнитьПометкуНаСервере()

    КоличествоПотоков = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
    Если КоличествоПотоков < 1 Тогда
        КоличествоПотоков = 1;
    КонецЕсли;

    ЗаполнитьСсылкуДополнительнойОбработки();

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

    Попытка
        ТекстПротокола = ОбработкаОбъект.ВыполнитьПометкуПлановЗаДень(ДатаПериода, ДополнительнаяОбработкаСсылка);
    Исключение
        ТекстПротокола = НСтр("ru = 'Ошибка выполнения: '")
            + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    Возврат ТекстПротокола;

КонецФункции

#КонецОбласти
