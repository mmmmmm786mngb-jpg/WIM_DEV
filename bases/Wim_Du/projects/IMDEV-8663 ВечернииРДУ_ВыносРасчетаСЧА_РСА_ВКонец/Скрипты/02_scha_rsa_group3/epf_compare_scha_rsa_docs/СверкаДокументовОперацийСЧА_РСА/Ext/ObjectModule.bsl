#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем КэшПолныхИменТипов;

#Область ПрограммныйИнтерфейс

// Описание: Возвращает сведения для подключения обработки в подсистеме
// БСП "Дополнительные отчеты и обработки".
//
// Возвращаемое значение:
//  Структура - параметры регистрации внешней обработки
//
Функция СведенияОВнешнейОбработке() Экспорт

    МетаданныеОбработки = Метаданные();

    ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
    ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
    ПараметрыРегистрации.Наименование = МетаданныеОбработки.Представление();
    ПараметрыРегистрации.Версия = "1.0.0.4";
    ПараметрыРегистрации.БезопасныйРежим = Ложь;
    ПараметрыРегистрации.Информация = НСтр(
        "ru = 'Снимок документов операций СЧА/РСА за день, пометка планов регл. в ФЗ и сверка двух файлов.
        |Для фоновых заданий обработку нужно загрузить в справочник ""Дополнительные отчеты и обработки"".'");

    НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
    НоваяКоманда.Представление = МетаданныеОбработки.Представление();
    НоваяКоманда.Идентификатор = МетаданныеОбработки.Имя;
    НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
    НоваяКоманда.ПоказыватьОповещение = Ложь;

    Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Собирает снимок шапок и ТЧ документов операций СЧА/РСА за день
// без номеров документов, ссылок-оснований и номеров строк.
//
// Параметры:
//  ДатаПериода - Дата - день расчета
//  МеткаСнимка - Строка - произвольная метка (эталон / после)
//
// Возвращаемое значение:
//  Структура - ТекстJSON, КоличествоДокументов, Протокол
//
Функция СобратьСнимокЗаДень(ДатаПериода, МеткаСнимка) Экспорт

    УстановитьПривилегированныйРежим(Истина);
    КэшПолныхИменТипов = Новый Соответствие;
    МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

    Результат = Новый Структура("ТекстJSON, КоличествоДокументов, Протокол", "", 0, "");

    Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
        Результат.Протокол = НСтр("ru = 'Не указана дата периода.'");
        Возврат Результат;
    КонецЕсли;

    ЭлементыСнимка = Новый Массив;
    ДобавитьДокументыРасчетСЧА_РСА(ЭлементыСнимка, ДатаПериода);
    ДобавитьДокументыРасчетДоходности(ЭлементыСнимка, ДатаПериода);
    ДобавитьДокументыКонтрольУменьшения(ЭлементыСнимка, ДатаПериода);
    ДобавитьДокументыКонтрольРиска(ЭлементыСнимка, ДатаПериода);

    НазначитьКлючиДублей(ЭлементыСнимка);
    СортироватьМассивСтруктур(ЭлементыСнимка, "Ключ");
    УдалитьСлужебныеПоляЭлементов(ЭлементыСнимка);

    Снимок = Новый Структура;
    Снимок.Вставить("version", 1);
    Снимок.Вставить("date", Формат(НачалоДня(ДатаПериода), "ДФ=yyyyMMdd"));
    Снимок.Вставить("label", Строка(МеткаСнимка));
    Снимок.Вставить("items", ЭлементыСнимка);

    Результат.ТекстJSON = ЗаписатьСнимокВJSON(Снимок);
    Результат.КоличествоДокументов = ЭлементыСнимка.Количество();
    ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала) / 1000;
    Результат.Протокол = СтрШаблон(
        НСтр("ru = 'День: %1. Документов в снимке: %2. Номера документов и номера строк не сохранялись. Сбор: %3 с.'"),
        Формат(ДатаПериода, "ДЛФ=D"),
        Результат.КоличествоДокументов,
        Формат(ДлительностьСек, "ЧДЦ=1; ЧН=0; ЧГ=0"));

    Возврат Результат;

КонецФункции

// Описание: Сверяет два JSON-снимка. Возвращает таблицу расхождений.
//
// Параметры:
//  ТекстЭталона - Строка - JSON эталона
//  ТекстПосле - Строка - JSON после доработки
//
// Возвращаемое значение:
//  Структура - ТаблицаРасхождений, Сводка, Протокол
//
Функция СверитьСнимки(ТекстЭталона, ТекстПосле) Экспорт

    Результат = Новый Структура("ТаблицаРасхождений, Сводка, Протокол");
    Результат.ТаблицаРасхождений = НоваяТаблицаРасхождений();

    Если Не ЗначениеЗаполнено(ТекстЭталона) Или Не ЗначениеЗаполнено(ТекстПосле) Тогда
        Результат.Протокол = НСтр("ru = 'Нужны оба файла снимка.'");
        Результат.Сводка = Результат.Протокол;
        Возврат Результат;
    КонецЕсли;

    СнимокЭталон = ПрочитатьСнимокИзJSON(ТекстЭталона);
    СнимокПосле = ПрочитатьСнимокИзJSON(ТекстПосле);

    Если СнимокЭталон = Неопределено Или СнимокПосле = Неопределено Тогда
        Результат.Протокол = НСтр("ru = 'Не удалось прочитать JSON. Проверьте, что файлы созданы этой обработкой.'");
        Результат.Сводка = Результат.Протокол;
        Возврат Результат;
    КонецЕсли;

    ДатаЭталон = Строка(ЗначениеСвойства(СнимокЭталон, "date"));
    ДатаПосле = Строка(ЗначениеСвойства(СнимокПосле, "date"));
    Если ДатаЭталон <> ДатаПосле Тогда
        ДобавитьРасхождение(Результат.ТаблицаРасхождений, "День снимка", "", "", "date",
            ДатаЭталон, ДатаПосле);
    КонецЕсли;

    ЭлементыЭталон = ЗначениеСвойства(СнимокЭталон, "items");
    ЭлементыПосле = ЗначениеСвойства(СнимокПосле, "items");
    Если ТипЗнч(ЭлементыЭталон) <> Тип("Массив") Тогда
        ЭлементыЭталон = Новый Массив;
    КонецЕсли;
    Если ТипЗнч(ЭлементыПосле) <> Тип("Массив") Тогда
        ЭлементыПосле = Новый Массив;
    КонецЕсли;

    ИндексЭталон = ИндексПоКлючу(ЭлементыЭталон);
    ИндексПосле = ИндексПоКлючу(ЭлементыПосле);

    Для Каждого Пара Из ИндексЭталон Цикл
        Если ИндексПосле.Получить(Пара.Ключ) = Неопределено Тогда
            ДобавитьРасхождение(Результат.ТаблицаРасхождений, "Только в эталоне",
                Строка(ЗначениеСвойства(Пара.Значение, "docType")), ПредставлениеДоговора(Пара.Значение), "",
                "есть", "");
        КонецЕсли;
    КонецЦикла;

    Для Каждого Пара Из ИндексПосле Цикл
        Если ИндексЭталон.Получить(Пара.Ключ) = Неопределено Тогда
            ДобавитьРасхождение(Результат.ТаблицаРасхождений, "Только после доработки",
                Строка(ЗначениеСвойства(Пара.Значение, "docType")), ПредставлениеДоговора(Пара.Значение), "",
                "", "есть");
        КонецЕсли;
    КонецЦикла;

    Для Каждого Пара Из ИндексЭталон Цикл
        ЭлементПосле = ИндексПосле.Получить(Пара.Ключ);
        Если ЭлементПосле = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        СверитьЭлементы(Результат.ТаблицаРасхождений, Пара.Значение, ЭлементПосле);
    КонецЦикла;

    КоличествоРасхождений = Результат.ТаблицаРасхождений.Количество();
    Результат.Сводка = СтрШаблон(
        НСтр("ru = 'Эталон: %1 док. После: %2 док. Расхождений: %3.'"),
        ЭлементыЭталон.Количество(),
        ЭлементыПосле.Количество(),
        КоличествоРасхождений);
    Если КоличествоРасхождений = 0 Тогда
        Результат.Сводка = Результат.Сводка + " " + НСтр("ru = 'Расхождений нет.'");
    КонецЕсли;
    Результат.Протокол = Результат.Сводка;

    Возврат Результат;

КонецФункции

// Описание: Помечает на удаление порцию документов ПланРегламентныхОперацийДУ.
// Вызывается из фоновых заданий.
//
// Параметры:
//  ПараметрыВыполнения - Структура - ключ МассивСсылок
//  АдресХранилища - Строка - адрес результата
//
Процедура ПометитьПорциюПлановНаУдаление(ПараметрыВыполнения, АдресХранилища) Экспорт

    Успешно = 0;
    Ошибок = 0;
    Пропущенных = 0;
    ТекстОшибок = "";

    МассивСсылок = Неопределено;
    ПараметрыВыполнения.Свойство("МассивСсылок", МассивСсылок);
    Если ТипЗнч(МассивСсылок) <> Тип("Массив") Тогда
        РезультатОшибки = Новый Структура("Успешно, Ошибок, Пропущенных, ТекстОшибок",
            0, 1, 0, НСтр("ru = 'Не передан МассивСсылок'"));
        ПоместитьВоВременноеХранилище(РезультатОшибки, АдресХранилища);
        Возврат;
    КонецЕсли;

    Для Каждого СсылкаПлана Из МассивСсылок Цикл

        Попытка
            ОбъектПлана = СсылкаПлана.ПолучитьОбъект();
            Если ОбъектПлана = Неопределено Тогда
                Пропущенных = Пропущенных + 1;
                Продолжить;
            КонецЕсли;
            Если ОбъектПлана.ПометкаУдаления Тогда
                Пропущенных = Пропущенных + 1;
                Продолжить;
            КонецЕсли;
            ОбъектПлана.УстановитьПометкуУдаления(Истина);
            Успешно = Успешно + 1;
        Исключение
            Ошибок = Ошибок + 1;
            ТекстОшибок = ТекстОшибок
                + Строка(СсылкаПлана) + ": "
                + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
                + Символы.ПС;
        КонецПопытки;

    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("Успешно", Успешно);
    Результат.Вставить("Ошибок", Ошибок);
    Результат.Вставить("Пропущенных", Пропущенных);
    Результат.Вставить("ТекстОшибок", ТекстОшибок);
    ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

// Описание: Возвращает ссылку этой обработки в справочнике
// "Дополнительные отчеты и обработки" (по параметру открытия формы или по ИмяОбъекта).
// Без этой ссылки фоновые задания не создают объект внешней обработки.
//
// Параметры:
//  ПредпочтительнаяСсылка - СправочникСсылка.ДополнительныеОтчетыИОбработки - ссылка из параметров формы
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки
//
Функция СсылкаДополнительнойОбработки(ПредпочтительнаяСсылка = Неопределено) Экспорт

    Если ЗначениеЗаполнено(ПредпочтительнаяСсылка) Тогда
        Возврат ПредпочтительнаяСсылка;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
    |ГДЕ
    |    ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта
    |    И ДополнительныеОтчетыИОбработки.ПометкаУдаления = ЛОЖЬ
    |
    |УПОРЯДОЧИТЬ ПО
    |    ВЫБОР
    |        КОГДА ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)
    |            ТОГДА 0
    |        КОГДА ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.РежимОтладки)
    |            ТОГДА 1
    |        ИНАЧЕ 2
    |    КОНЕЦ";
    Запрос.УстановитьПараметр("ИмяОбъекта", Метаданные().Имя);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();

КонецФункции

// Описание: Помечает на удаление все планы регл. операций за день
// в параллельных фоновых заданиях. Объект обработки в ФЗ берется
// из справочника дополнительных отчетов и обработок.
//
// Параметры:
//  ДатаПериода - Дата - день
//  ДополнительнаяОбработкаСсылка - СправочникСсылка.ДополнительныеОтчетыИОбработки - регистрация в БСП
//
// Возвращаемое значение:
//  Строка - протокол
//
Функция ВыполнитьПометкуПлановЗаДень(ДатаПериода, ДополнительнаяОбработкаСсылка = Неопределено) Экспорт

    Протокол = "";

    Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
        Возврат НСтр("ru = 'Не указана дата периода.'");
    КонецЕсли;

    СсылкаДляФона = СсылкаДополнительнойОбработки(ДополнительнаяОбработкаСсылка);
    Если Не ЗначениеЗаполнено(СсылкаДляФона) Тогда
        Возврат НСтр(
            "ru = 'Обработка не найдена в справочнике ""Дополнительные отчеты и обработки"".
            |Загрузите EPF в этот справочник, публикация ""Используется"", и откройте команду оттуда.
            |Иначе фоновые задания не смогут создать объект обработки.'");
    КонецЕсли;

    Протокол = Протокол + СтрШаблон(
        НСтр("ru = 'ФЗ через справочник доп. обработок: %1'"),
        Строка(СсылкаДляФона)) + Символы.ПС;

    МассивПланов = ПолучитьПланыЗаДень(ДатаПериода);
    Всего = МассивПланов.Количество();

    Протокол = Протокол + СтрШаблон(
        НСтр("ru = 'Дата: %1. Найдено планов без пометки удаления: %2'"),
        Формат(ДатаПериода, "ДЛФ=D"),
        Всего) + Символы.ПС;

    Если Всего = 0 Тогда
        Протокол = Протокол + НСтр("ru = 'Нечего помечать.'");
        Возврат Протокол;
    КонецЕсли;

    КоличествоПотоков = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
    Если КоличествоПотоков < 1 Тогда
        КоличествоПотоков = 1;
    КонецЕсли;

    Протокол = Протокол + СтрШаблон(НСтр("ru = 'Потоков: %1'"), КоличествоПотоков) + Символы.ПС;

    Порции = РазбитьНаПорции(МассивПланов, КоличествоПотоков);
    СписокЗаданий = Новый СписокЗначений;
    АдресаРезультатов = Новый Соответствие;

    НомерПорции = 0;
    Для Каждого Порция Из Порции Цикл

        НомерПорции = НомерПорции + 1;
        Если Порция.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;

        ПараметрыВыполненияМетода = Новый Структура("МассивСсылок", Порция);
        ПараметрыПроцедуры = Новый Структура;
        ПараметрыПроцедуры.Вставить("ИмяМетода", "ПометитьПорциюПлановНаУдаление");
        ПараметрыПроцедуры.Вставить("ПараметрыВыполнения", ПараметрыВыполненияМетода);
        ПараметрыПроцедуры.Вставить("ЭтоВнешняяОбработка", Истина);
        ПараметрыПроцедуры.Вставить("ИмяОбработки", "");
        ПараметрыПроцедуры.Вставить("ДополнительнаяОбработкаСсылка", СсылкаДляФона);

        АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
        ПараметрыЗадания = Новый Массив;
        ПараметрыЗадания.Добавить(ПараметрыПроцедуры);
        ПараметрыЗадания.Добавить(АдресРезультата);

        КлючЗадания = СтрШаблон("MarkPlansCompare_%1_%2", Формат(ДатаПериода, "ДФ=yyyyMMdd"), НомерПорции);
        НаименованиеЗадания = СтрШаблон(
            НСтр("ru = 'Пометка планов регл. за %1, порция %2 (%3 шт.)'"),
            Формат(ДатаПериода, "ДЛФ=D"),
            НомерПорции,
            Порция.Количество());

        Задание = ФоновыеЗадания.Выполнить(
            "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
            ПараметрыЗадания,
            КлючЗадания,
            НаименованиеЗадания);

        СписокЗаданий.Добавить(Задание, НаименованиеЗадания);
        АдресаРезультатов.Вставить(Задание.УникальныйИдентификатор, АдресРезультата);

        Протокол = Протокол + СтрШаблон(
            НСтр("ru = 'Запущено ФЗ порции %1: %2 планов'"),
            НомерПорции,
            Порция.Количество()) + Символы.ПС;

    КонецЦикла;

    Если СписокЗаданий.Количество() = 0 Тогда
        Протокол = Протокол + НСтр("ru = 'Фоновые задания не запускались.'");
        Возврат Протокол;
    КонецЕсли;

    Задания = СписокЗаданий.ВыгрузитьЗначения();
    Пока Истина Цикл
        Задания = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(Задания, 5);
        Если ВсеФоновыеЗаданияЗавершены(Задания) Тогда
            Прервать;
        КонецЕсли;
    КонецЦикла;

    ИтогоУспешно = 0;
    ИтогоОшибок = 0;
    ИтогоПропущенных = 0;

    Для Каждого ТекЗадание Из Задания Цикл

        Представление = "";
        Для Каждого ЭлементСписка Из СписокЗаданий Цикл
            Если ЭлементСписка.Значение.УникальныйИдентификатор = ТекЗадание.УникальныйИдентификатор Тогда
                Представление = ЭлементСписка.Представление;
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если ТекЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
            ИтогоОшибок = ИтогоОшибок + 1;
            Протокол = Протокол + СтрШаблон(
                НСтр("ru = 'ОШИБКА ФЗ %1: %2'"),
                Представление,
                ОбработкаОшибок.ПодробноеПредставлениеОшибки(ТекЗадание.ИнформацияОбОшибке))
                + Символы.ПС;
            Продолжить;
        КонецЕсли;

        АдресРезультата = АдресаРезультатов.Получить(ТекЗадание.УникальныйИдентификатор);
        Если Не ЗначениеЗаполнено(АдресРезультата) Тогда
            Продолжить;
        КонецЕсли;

        РезультатПорции = ПолучитьИзВременногоХранилища(АдресРезультата);
        Если ТипЗнч(РезультатПорции) <> Тип("Структура") Тогда
            Продолжить;
        КонецЕсли;

        УспешноПорции = 0;
        ОшибокПорции = 0;
        ПропущенныхПорции = 0;
        ТекстОшибокПорции = "";
        РезультатПорции.Свойство("Успешно", УспешноПорции);
        РезультатПорции.Свойство("Ошибок", ОшибокПорции);
        РезультатПорции.Свойство("Пропущенных", ПропущенныхПорции);
        РезультатПорции.Свойство("ТекстОшибок", ТекстОшибокПорции);

        ИтогоУспешно = ИтогоУспешно + УспешноПорции;
        ИтогоОшибок = ИтогоОшибок + ОшибокПорции;
        ИтогоПропущенных = ИтогоПропущенных + ПропущенныхПорции;

        Если ЗначениеЗаполнено(ТекстОшибокПорции) Тогда
            Протокол = Протокол + ТекстОшибокПорции;
        КонецЕсли;

    КонецЦикла;

    Протокол = Протокол + Символы.ПС + СтрШаблон(
        НСтр("ru = 'Итого: помечено %1, пропущено %2, ошибок %3'"),
        ИтогоУспешно,
        ИтогоПропущенных,
        ИтогоОшибок);

    Возврат Протокол;

КонецФункции

#КонецОбласти

