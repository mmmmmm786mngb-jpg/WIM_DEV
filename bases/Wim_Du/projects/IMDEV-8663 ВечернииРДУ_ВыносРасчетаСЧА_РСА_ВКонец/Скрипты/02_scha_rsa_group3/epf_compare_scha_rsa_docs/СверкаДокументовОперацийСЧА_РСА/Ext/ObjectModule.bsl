Функция НовыйЭлементСнимка(ТипДокумента, ДоговорДУ, КодДоговора)

    Элемент = Новый Структура;
    Элемент.Вставить("docType", ТипДокумента);
    Элемент.Вставить("contractUid", ИдентификаторСсылки(ДоговорДУ));
    Элемент.Вставить("contractCode", Строка(КодДоговора));
    Элемент.Вставить("header", Новый Структура);
    Элемент.Вставить("tables", Новый Структура);
    Элемент.Вставить("Ключ", ТипДокумента + "|" + Элемент.contractUid);
    Возврат Элемент;

КонецФункции

Процедура НазначитьКлючиДублей(ЭлементыСнимка)

    Группы = Новый Соответствие;
    Для Каждого Элемент Из ЭлементыСнимка Цикл
        БазовыйКлюч = Элемент.docType + "|" + Элемент.contractUid;
        Группа = Группы.Получить(БазовыйКлюч);
        Если Группа = Неопределено Тогда
            Группа = Новый Массив;
            Группы.Вставить(БазовыйКлюч, Группа);
        КонецЕсли;
        Группа.Добавить(Элемент);
    КонецЦикла;

    Для Каждого ПараГруппы Из Группы Цикл
        Группа = ПараГруппы.Значение;
        Если Группа.Количество() = 1 Тогда
            Элемент = Группа[0];
            Элемент.Ключ = ПараГруппы.Ключ;
            Элемент.Вставить("key", Элемент.Ключ);
            Продолжить;
        КонецЕсли;

        Для Каждого Элемент Из Группа Цикл
            Элемент.Вставить("Содержание", ТекстСодержимого(Элемент));
        КонецЦикла;
        СортироватьМассивСтруктур(Группа, "Содержание");
        Номер = 0;
        Для Каждого Элемент Из Группа Цикл
            Номер = Номер + 1;
            Элемент.Ключ = ПараГруппы.Ключ + "|#" + Формат(Номер, "ЧГ=0");
            Элемент.Вставить("key", Элемент.Ключ);
            Элемент.Удалить("Содержание");
        КонецЦикла;
    КонецЦикла;

КонецПроцедуры

Процедура УдалитьСлужебныеПоляЭлементов(ЭлементыСнимка)

    Для Каждого Элемент Из ЭлементыСнимка Цикл
        Если Элемент.Свойство("Ключ") Тогда
            Элемент.Удалить("Ключ");
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Функция ТекстСодержимого(Элемент)

    Фрагмент = Новый Структура("header, tables", Элемент.header, Элемент.tables);
    Возврат ЗаписатьСнимокВJSON(Фрагмент);

КонецФункции

Функция СтрокиТЧПоказателей(МассивСтрок)

    Результат = Новый Массив;
    Если МассивСтрок = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;

    Для Каждого СтрокаТЧ Из МассивСтрок Цикл
        СтрокаСнимка = Новый Структура;
        СтрокаСнимка.Вставить("ИсточникПоказателя", КанонЗначения(СтрокаТЧ.ИсточникПоказателя));
        СтрокаСнимка.Вставить("Показатель", КанонЗначения(СтрокаТЧ.Показатель));
        СтрокаСнимка.Вставить("Сумма", КанонЗначения(СтрокаТЧ.Сумма));
        СтрокаСнимка.Вставить("sort", СтрокаСнимка.ИсточникПоказателя + "|" + СтрокаСнимка.Показатель + "|" + СтрокаСнимка.Сумма);
        Результат.Добавить(СтрокаСнимка);
    КонецЦикла;

    СортироватьМассивСтруктур(Результат, "sort");
    Для Каждого СтрокаСнимка Из Результат Цикл
        СтрокаСнимка.Удалить("sort");
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ИндексСтрокПоСсылке(Таблица)

    Индекс = Новый Соответствие;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        МассивСтрок = Индекс.Получить(СтрокаТаблицы.Ссылка);
        Если МассивСтрок = Неопределено Тогда
            МассивСтрок = Новый Массив;
            Индекс.Вставить(СтрокаТаблицы.Ссылка, МассивСтрок);
        КонецЕсли;
        МассивСтрок.Добавить(СтрокаТаблицы);
    КонецЦикла;
    Возврат Индекс;

КонецФункции

Процедура УстановитьДатыЗапроса(Запрос, ДатаПериода)

    Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаПериода));
    Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПериода));

КонецПроцедуры

Функция КанонЗначения(Значение)

    Если ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат XMLСтрока(Значение);
    КонецЕсли;

    Если ТипЗнч(Значение) = Тип("Число") Тогда
        Возврат XMLСтрока(Значение);
    КонецЕсли;

    Если ТипЗнч(Значение) = Тип("Дата") Тогда
        Если Не ЗначениеЗаполнено(Значение) Тогда
            Возврат "";
        КонецЕсли;
        Возврат Формат(Значение, "ДФ=yyyyMMddHHmmss");
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Значение) Тогда
        Возврат "";
    КонецЕсли;

    Если ТипЗнч(Значение) = Тип("Строка") Тогда
        Возврат Значение;
    КонецЕсли;

    ТипЗначения = ТипЗнч(Значение);
    Если КэшПолныхИменТипов = Неопределено Тогда
        КэшПолныхИменТипов = Новый Соответствие;
    КонецЕсли;

    СпособКанона = КэшПолныхИменТипов.Получить(ТипЗначения);
    Если СпособКанона = Ложь Тогда
        Возврат XMLСтрока(Значение);
    ИначеЕсли СпособКанона <> Неопределено Тогда
        Возврат СпособКанона + ":" + Строка(Значение.УникальныйИдентификатор());
    КонецЕсли;

    Попытка
        ПолноеИмя = Значение.Метаданные().ПолноеИмя();
        Идентификатор = Строка(Значение.УникальныйИдентификатор());
    Исключение
        КэшПолныхИменТипов.Вставить(ТипЗначения, Ложь);
        Возврат XMLСтрока(Значение);
    КонецПопытки;

    КэшПолныхИменТипов.Вставить(ТипЗначения, ПолноеИмя);
    Возврат ПолноеИмя + ":" + Идентификатор;

КонецФункции

Функция ИдентификаторСсылки(Ссылка)

    Если Не ЗначениеЗаполнено(Ссылка) Тогда
        Возврат "";
    КонецЕсли;

    Возврат Строка(Ссылка.УникальныйИдентификатор());

КонецФункции

Функция ЗаписатьСнимокВJSON(Снимок)

    ЗаписьJSON = Новый ЗаписьJSON;
    ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
    ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
    ЗаписатьJSON(ЗаписьJSON, Снимок);
    Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция ПрочитатьСнимокИзJSON(ТекстJSON)

    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТекстJSON);
        Данные = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если ЗначениеСвойства(Данные, "items") = Неопределено
        Или ЗначениеСвойства(Данные, "date") = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Данные;

КонецФункции

Функция ИндексПоКлючу(Элементы)

    Индекс = Новый Соответствие;
    Если Элементы = Неопределено Тогда
        Возврат Индекс;
    КонецЕсли;

    Для Каждого Элемент Из Элементы Цикл
        Ключ = Строка(ЗначениеСвойства(Элемент, "key"));
        Если Не ЗначениеЗаполнено(Ключ) Тогда
            Ключ = Строка(ЗначениеСвойства(Элемент, "Ключ"));
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Ключ) Тогда
            Ключ = Строка(ЗначениеСвойства(Элемент, "docType"))
                + "|" + Строка(ЗначениеСвойства(Элемент, "contractUid"));
        КонецЕсли;
        Индекс.Вставить(Ключ, Элемент);
    КонецЦикла;

    Возврат Индекс;

КонецФункции

Процедура СверитьЭлементы(ТаблицаРасхождений, Эталон, После)

    ШапкаЭталон = ЗначениеСвойства(Эталон, "header");
    ШапкаПосле = ЗначениеСвойства(После, "header");
    СверитьСтруктурыПолей(ТаблицаРасхождений, Эталон, "Шапка", ШапкаЭталон, ШапкаПосле);

    ТаблицыЭталон = ЗначениеСвойства(Эталон, "tables");
    ТаблицыПосле = ЗначениеСвойства(После, "tables");
    ИменаТаблиц = Новый Соответствие;
    ДобавитьИменаСтруктуры(ИменаТаблиц, ТаблицыЭталон);
    ДобавитьИменаСтруктуры(ИменаТаблиц, ТаблицыПосле);

    Для Каждого ПараИмени Из ИменаТаблиц Цикл
        ИмяТЧ = ПараИмени.Ключ;
        СтрокиЭталон = ЗначениеСвойства(ТаблицыЭталон, ИмяТЧ);
        СтрокиПосле = ЗначениеСвойства(ТаблицыПосле, ИмяТЧ);
        СверитьТабличныеЧасти(ТаблицаРасхождений, Эталон, ИмяТЧ, СтрокиЭталон, СтрокиПосле);
    КонецЦикла;

КонецПроцедуры

Процедура СверитьСтруктурыПолей(ТаблицаРасхождений, Элемент, Префикс, Эталон, После)

    Имена = Новый Соответствие;
    ДобавитьИменаСтруктуры(Имена, Эталон);
    ДобавитьИменаСтруктуры(Имена, После);

    Для Каждого ПараИмени Из Имена Цикл
        ИмяПоля = ПараИмени.Ключ;
        Если ИмяПоля = "Ключ" Или ИмяПоля = "key" Или ИмяПоля = "sort" Тогда
            Продолжить;
        КонецЕсли;
        ЗначениеЭталон = ЗначениеПоляСтруктуры(Эталон, ИмяПоля);
        ЗначениеПосле = ЗначениеПоляСтруктуры(После, ИмяПоля);
        Если ЗначениеЭталон <> ЗначениеПосле Тогда
            ДобавитьРасхождение(ТаблицаРасхождений, "Отличается поле",
                Строка(ЗначениеСвойства(Элемент, "docType")), ПредставлениеДоговора(Элемент),
                Префикс + "." + ИмяПоля, ЗначениеЭталон, ЗначениеПосле);
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Процедура СверитьТабличныеЧасти(ТаблицаРасхождений, Элемент, ИмяТЧ, СтрокиЭталон, СтрокиПосле)

    Если СтрокиЭталон = Неопределено Тогда
        СтрокиЭталон = Новый Массив;
    КонецЕсли;
    Если СтрокиПосле = Неопределено Тогда
        СтрокиПосле = Новый Массив;
    КонецЕсли;

    ИндексЭталон = ИндексСтрокТЧ(СтрокиЭталон);
    ИндексПосле = ИндексСтрокТЧ(СтрокиПосле);

    Для Каждого Пара Из ИндексЭталон Цикл
        Если ИндексПосле.Получить(Пара.Ключ) = Неопределено Тогда
            ДобавитьРасхождение(ТаблицаРасхождений, "Строка только в эталоне",
                Строка(ЗначениеСвойства(Элемент, "docType")), ПредставлениеДоговора(Элемент),
                ИмяТЧ + ": " + Пара.Ключ, "есть", "");
        КонецЕсли;
    КонецЦикла;

    Для Каждого Пара Из ИндексПосле Цикл
        Если ИндексЭталон.Получить(Пара.Ключ) = Неопределено Тогда
            ДобавитьРасхождение(ТаблицаРасхождений, "Строка только после доработки",
                Строка(ЗначениеСвойства(Элемент, "docType")), ПредставлениеДоговора(Элемент),
                ИмяТЧ + ": " + Пара.Ключ, "", "есть");
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Функция ИндексСтрокТЧ(Строки)

    Индекс = Новый Соответствие;
    Если ТипЗнч(Строки) <> Тип("Массив") Тогда
        Возврат Индекс;
    КонецЕсли;

    Для Каждого СтрокаТЧ Из Строки Цикл
        КлючСтроки = КлючСтрокиТЧ(СтрокаТЧ);
        Счетчик = Индекс.Получить(КлючСтроки);
        Если Счетчик = Неопределено Тогда
            Индекс.Вставить(КлючСтроки, 1);
        Иначе
            Индекс.Вставить(КлючСтроки + "|#" + Строка(Счетчик + 1), 1);
            Индекс.Вставить(КлючСтроки, Счетчик + 1);
        КонецЕсли;
    КонецЦикла;

    Возврат Индекс;

КонецФункции

Функция КлючСтрокиТЧ(СтрокаТЧ)

    Если ТипЗнч(СтрокаТЧ) <> Тип("Структура") Тогда
        Возврат Строка(СтрокаТЧ);
    КонецЕсли;

    Источник = ЗначениеПоляСтруктуры(СтрокаТЧ, "ИсточникПоказателя");
    Показатель = ЗначениеПоляСтруктуры(СтрокаТЧ, "Показатель");
    Сумма = ЗначениеПоляСтруктуры(СтрокаТЧ, "Сумма");
    Возврат Источник + " / " + Показатель + " / " + Сумма;

КонецФункции

Процедура ДобавитьИменаСтруктуры(Имена, СтруктураДанных)

    Если ТипЗнч(СтруктураДанных) <> Тип("Структура")
        И ТипЗнч(СтруктураДанных) <> Тип("Соответствие") Тогда
        Возврат;
    КонецЕсли;

    Для Каждого КлючИЗначение Из СтруктураДанных Цикл
        Имена.Вставить(КлючИЗначение.Ключ, Истина);
    КонецЦикла;

КонецПроцедуры

Функция ЗначениеСвойства(СтруктураДанных, Имя)

    Если ТипЗнч(СтруктураДанных) = Тип("Структура") Тогда
        Значение = Неопределено;
        СтруктураДанных.Свойство(Имя, Значение);
        Возврат Значение;
    ИначеЕсли ТипЗнч(СтруктураДанных) = Тип("Соответствие") Тогда
        Возврат СтруктураДанных.Получить(Имя);
    КонецЕсли;

    Возврат Неопределено;

КонецФункции

Функция ЗначениеПоляСтруктуры(СтруктураДанных, ИмяПоля)

    Значение = ЗначениеСвойства(СтруктураДанных, ИмяПоля);
    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Возврат Строка(Значение);

КонецФункции

Функция ПредставлениеДоговора(Элемент)

    Код = ЗначениеСвойства(Элемент, "contractCode");
    Если Не ЗначениеЗаполнено(Код) Тогда
        Возврат НСтр("ru = '(без договора)'");
    КонецЕсли;
    Возврат Код;

КонецФункции

Функция НоваяТаблицаРасхождений()

    ТаблицаРасхождений = Новый ТаблицаЗначений;
    ТаблицаРасхождений.Колонки.Добавить("ВидОтклонения", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(80)));
    ТаблицаРасхождений.Колонки.Добавить("ТипДокумента", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(80)));
    ТаблицаРасхождений.Колонки.Добавить("ДоговорДУ", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(120)));
    ТаблицаРасхождений.Колонки.Добавить("Поле", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
    ТаблицаРасхождений.Колонки.Добавить("Эталон", Новый ОписаниеТипов("Строка"));
    ТаблицаРасхождений.Колонки.Добавить("После", Новый ОписаниеТипов("Строка"));
    Возврат ТаблицаРасхождений;

КонецФункции

Процедура ДобавитьРасхождение(ТаблицаРасхождений, ВидОтклонения, ТипДокумента, ДоговорДУ, Поле, Эталон, После)

    СтрокаТаблицы = ТаблицаРасхождений.Добавить();
    СтрокаТаблицы.ВидОтклонения = ВидОтклонения;
    СтрокаТаблицы.ТипДокумента = ТипДокумента;
    СтрокаТаблицы.ДоговорДУ = ДоговорДУ;
    СтрокаТаблицы.Поле = Поле;
    СтрокаТаблицы.Эталон = Эталон;
    СтрокаТаблицы.После = После;

КонецПроцедуры

Процедура СортироватьМассивСтруктур(МассивСтруктур, ИмяПоля)

    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("КлючСортировки");
    Таблица.Колонки.Добавить("Значение");
    Для Каждого Элемент Из МассивСтруктур Цикл
        СтрокаТаблицы = Таблица.Добавить();
        СтрокаТаблицы.КлючСортировки = Элемент[ИмяПоля];
        СтрокаТаблицы.Значение = Элемент;
    КонецЦикла;
    Таблица.Сортировать("КлючСортировки");
    МассивСтруктур.Очистить();
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        МассивСтруктур.Добавить(СтрокаТаблицы.Значение);
    КонецЦикла;

КонецПроцедуры

Функция ПолучитьПланыЗаДень(ДатаПериода)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ПланРегламентныхОперацийДУ.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.ПланРегламентныхОперацийДУ КАК ПланРегламентныхОперацийДУ
    |ГДЕ
    |    ПланРегламентныхОперацийДУ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
    |    И ПланРегламентныхОперацийДУ.ПометкаУдаления = ЛОЖЬ
    |
    |УПОРЯДОЧИТЬ ПО
    |    ПланРегламентныхОперацийДУ.ДоговорДУ,
    |    ПланРегламентныхОперацийДУ.ГруппаОперацийПользователя";
    УстановитьДатыЗапроса(Запрос, ДатаПериода);
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

