Процедура ДобавитьДокументыРасчетСЧА_РСА(ЭлементыСнимка, ДатаПериода)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Док.Ссылка КАК Ссылка,
    |    Док.ДоговорДУ КАК ДоговорДУ,
    |    Док.ДоговорДУ.Код КАК КодДоговора,
    |    Док.Проведен КАК Проведен,
    |    Док.СуммаСЧА КАК СуммаСЧА,
    |    Док.СуммаРСА КАК СуммаРСА,
    |    Док.СЧА КАК СЧА,
    |    Док.РСА КАК РСА
    |ИЗ
    |    Документ.РасчетСЧА_РСА КАК Док
    |ГДЕ
    |    Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
    |    И Док.ПометкаУдаления = ЛОЖЬ
    |
    |УПОРЯДОЧИТЬ ПО
    |    КодДоговора";
    УстановитьДатыЗапроса(Запрос, ДатаПериода);
    Шапка = Запрос.Выполнить().Выгрузить();
    Если Шапка.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Запрос.УстановитьПараметр("Ссылки", Шапка.ВыгрузитьКолонку("Ссылка"));
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ТЧ.Ссылка КАК Ссылка,
    |    ТЧ.ИсточникПоказателя КАК ИсточникПоказателя,
    |    ТЧ.Показатель КАК Показатель,
    |    ТЧ.Сумма КАК Сумма
    |ИЗ
    |    Документ.РасчетСЧА_РСА.РасчетСЧА КАК ТЧ
    |ГДЕ
    |    ТЧ.Ссылка В (&Ссылки)";
    ТаблицаСЧА = Запрос.Выполнить().Выгрузить();

    Запрос.Текст =
    "ВЫБРАТЬ
    |    ТЧ.Ссылка КАК Ссылка,
    |    ТЧ.ИсточникПоказателя КАК ИсточникПоказателя,
    |    ТЧ.Показатель КАК Показатель,
    |    ТЧ.Сумма КАК Сумма
    |ИЗ
    |    Документ.РасчетСЧА_РСА.РасчетРСА КАК ТЧ
    |ГДЕ
    |    ТЧ.Ссылка В (&Ссылки)";
    ТаблицаРСА = Запрос.Выполнить().Выгрузить();

    СтрокиСЧА = ИндексСтрокПоСсылке(ТаблицаСЧА);
    СтрокиРСА = ИндексСтрокПоСсылке(ТаблицаРСА);

    Для Каждого СтрокаШапки Из Шапка Цикл
        Элемент = НовыйЭлементСнимка("РасчетСЧА_РСА", СтрокаШапки.ДоговорДУ, СтрокаШапки.КодДоговора);
        Элемент.header.Вставить("Проведен", КанонЗначения(СтрокаШапки.Проведен));
        Элемент.header.Вставить("СуммаСЧА", КанонЗначения(СтрокаШапки.СуммаСЧА));
        Элемент.header.Вставить("СуммаРСА", КанонЗначения(СтрокаШапки.СуммаРСА));
        Элемент.header.Вставить("СЧА", КанонЗначения(СтрокаШапки.СЧА));
        Элемент.header.Вставить("РСА", КанонЗначения(СтрокаШапки.РСА));
        Элемент.tables.Вставить("РасчетСЧА", СтрокиТЧПоказателей(СтрокиСЧА.Получить(СтрокаШапки.Ссылка)));
        Элемент.tables.Вставить("РасчетРСА", СтрокиТЧПоказателей(СтрокиРСА.Получить(СтрокаШапки.Ссылка)));
        ЭлементыСнимка.Добавить(Элемент);
    КонецЦикла;

КонецПроцедуры

