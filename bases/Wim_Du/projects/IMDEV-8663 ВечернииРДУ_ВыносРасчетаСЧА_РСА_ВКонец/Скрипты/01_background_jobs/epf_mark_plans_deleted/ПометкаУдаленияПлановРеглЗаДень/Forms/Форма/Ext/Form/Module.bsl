#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
		ДатаПериода = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	КоличествоПотоков = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
	Если КоличествоПотоков < 1 Тогда
		КоличествоПотоков = 1;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПометку(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Укажите дату периода.'"));
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПометкуПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(
		Оповещение,
		СтрШаблон(
			НСтр("ru='Пометить на удаление все планы регл. операций за %1 (и подчиненные документы)? Отбор по договорам не используется.'"),
			Формат(ДатаПериода, "ДЛФ=D")),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПометкуПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	АдресФайлаОбработки = Неопределено;
	ИмяФайлаНаКлиенте = ИмяФайлаОбработкиНаСервере();
	
	Если ЗначениеЗаполнено(ИмяФайлаНаКлиенте) Тогда
		Попытка
			ДанныеФайла = Новый ДвоичныеДанные(ИмяФайлаНаКлиенте);
			АдресФайлаОбработки = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);
		Исключение
			АдресФайлаОбработки = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Протокол = ВыполнитьПометкуНаСервере(АдресФайлаОбработки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ИмяФайлаОбработкиНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ИспользуемоеИмяФайла;
	
КонецФункции

&НаСервере
Функция ВыполнитьПометкуНаСервере(АдресФайлаОбработки)
	
	КоличествоПотоков = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
	Если КоличествоПотоков < 1 Тогда
		КоличествоПотоков = 1;
	КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ПланРегламентныхОперацийДУ.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ПланРегламентныхОперацийДУ КАК ПланРегламентныхОперацийДУ
	|ГДЕ
	|	ПланРегламентныхОперацийДУ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ПланРегламентныхОперацийДУ.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПериода));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КоличествоПланов = Выборка.Количество;
	Иначе
		КоличествоПланов = 0;
	КонецЕсли;
	
	ИмяВременногоФайла = "";
	ИмяПодключения = ПодключитьВнешнююОбработкуДляФона(АдресФайлаОбработки, ОбработкаОбъект, ИмяВременногоФайла);
	
	Попытка
		ТекстПротокола = ОбработкаОбъект.ВыполнитьПометкуПлановЗаДень(ДатаПериода, ИмяПодключения);
	Исключение
		ТекстПротокола = НСтр("ru='Ошибка выполнения: '")
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
			// файл может быть занят до завершения ФЗ на некоторых ОС — не критично
		КонецПопытки;
	КонецЕсли;
	
	Возврат ТекстПротокола;
	
КонецФункции

&НаСервере
Функция ПодключитьВнешнююОбработкуДляФона(АдресФайлаОбработки, ОбработкаОбъект, ИмяВременногоФайла)
	
	ИмяВременногоФайла = "";
	
	Если ЭтоАдресВременногоХранилища(АдресФайлаОбработки) Тогда
		
		ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаОбработки);
		Если ТипЗнч(ДанныеФайла) = Тип("ДвоичныеДанные") Тогда
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("epf");
			ДанныеФайла.Записать(ИмяВременногоФайла);
			Возврат ВнешниеОбработки.Подключить(ИмяВременногоФайла, "ПометкаУдаленияПлановРеглЗаДень", Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
	ИмяФайла = ОбработкаОбъект.ИспользуемоеИмяФайла;
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат ВнешниеОбработки.Подключить(ИмяФайла, "ПометкаУдаленияПлановРеглЗаДень", Ложь);
	КонецЕсли;
	
	ВызватьИсключение НСтр(
		"ru='Не удалось получить файл внешней обработки для запуска фоновых заданий.
		|Откройте обработку из файла (Файл - Открыть) и повторите.'");
	
КонецФункции

#КонецОбласти
