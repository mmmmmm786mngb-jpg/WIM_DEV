#Область IMDEV_8663_2_КонструкторыЗапросов

// Описание: Вставляет поле ДоговорДУ первой колонкой выборки перед указанным маркером поля.
// Маркер - фрагмент текста запроса БЕЗ символа "|" (это синтаксис многострочной строки 1С,
// в значении ТекстЗапроса его нет). Строки запроса в литерале начинаются с табуляции после "|".
//
// Параметры:
//  ТекстЗапроса   - Строка - исходный текст запроса
//  МаркерПоля     - Строка - уникальный фрагмент первой колонки выборки, включая запятую
//  ИмяТаблицы     - Строка - псевдоним таблицы, у которой есть измерение ДоговорДУ
//  СПсевдонимом   - Булево - Истина для первой выборки пакета/объединения (нужен КАК ДоговорДУ)
//
// Возвращаемое значение:
//  Строка - текст запроса с добавленным полем
//
Функция ВставитьПолеДоговорДУПеред(ТекстЗапроса, МаркерПоля, ИмяТаблицы, СПсевдонимом)

    // IMDEV-8663.2 этап 4
    НовоеПоле = ИмяТаблицы + ".ДоговорДУ";
    Если СПсевдонимом Тогда
        НовоеПоле = НовоеПоле + " КАК ДоговорДУ";
    КонецЕсли;

    Возврат СтрЗаменить(
        ТекстЗапроса,
        МаркерПоля,
        НовоеПоле + "," + Символы.ПС + Символы.Таб + МаркерПоля);

КонецФункции

<<<QUERY_BU_FUNC>>>

// Описание: Возвращает текст запроса БУ для расчета РСА/СЧА.
// Пакетный режим отличается ТОЛЬКО отбором, колонкой ДоговорДУ и группировкой.
//
// Параметры:
//  Пакетно - Булево - Истина: отбор В (&ДоговорыГруппы) и группировка по ДоговорДУ
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаБУ(Пакетно)

    // IMDEV-8663.2 этап 4
    ТекстЗапроса = ТекстЗапросаОднодоговорныйБУ();

    Если Не Пакетно Тогда
        Возврат ТекстЗапроса;
    КонецЕсли;

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДоговорДУ = &ДоговорДУ", "ДоговорДУ В (&ДоговорыГруппы)");

    ТекстЗапроса = ВставитьПолеДоговорДУПеред(
        ТекстЗапроса,
        "ХозрасчетныйОстатки.Счет КАК ИсточникПоказателя,",
        "ХозрасчетныйОстатки",
        Истина);

    ТекстЗапроса = ВставитьПолеДоговорДУПеред(
        ТекстЗапроса,
        "ВТ_ПромежуточнаяТаблица.ИсточникПоказателя КАК ИсточникПоказателя,",
        "ВТ_ПромежуточнаяТаблица",
        Истина);

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
        "СГРУППИРОВАТЬ ПО
        |TAB|ВТ_ПромежуточнаяТаблица.ИсточникПоказателя,
        |TAB|ВТ_ПромежуточнаяТаблица.Показатель",
        "СГРУППИРОВАТЬ ПО
        |TAB|ВТ_ПромежуточнаяТаблица.ДоговорДУ,
        |TAB|ВТ_ПромежуточнаяТаблица.ИсточникПоказателя,
        |TAB|ВТ_ПромежуточнаяТаблица.Показатель");

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
        "УПОРЯДОЧИТЬ ПО
        |TAB|ИсточникПоказателя,
        |TAB|Показатель",
        "УПОРЯДОЧИТЬ ПО
        |TAB|ДоговорДУ,
        |TAB|ИсточникПоказателя,
        |TAB|Показатель");

    Возврат ТекстЗапроса;

КонецФункции

<<<QUERY_UU_FUNC>>>

// Описание: Возвращает текст запроса УУ для расчета РСА/СЧА.
//
// Параметры:
//  Пакетно - Булево - Истина: отбор В (&ДоговорыГруппы) и группировка по ДоговорДУ
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаУУ(Пакетно)

    // IMDEV-8663.2 этап 4
    ТекстЗапроса = ТекстЗапросаОднодоговорныйУУ();

    Если Не Пакетно Тогда
        Возврат ТекстЗапроса;
    КонецЕсли;

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДоговорДУ = &ДоговорДУ", "ДоговорДУ В (&ДоговорыГруппы)");

    МаркерыПервыхПолей = Новый Массив;
    МаркерыПервыхПолей.Добавить("СтоимостьАктивовУправленческийОстатки.Актив КАК Показатель,");
    МаркерыПервыхПолей.Добавить("НачисленныйКупонныйДоходУправленческийОстатки.Облигация,");
    МаркерыПервыхПолей.Добавить("УУ_ЦенныеБумагиHTMОстатки.Партия,");
    МаркерыПервыхПолей.Добавить("УУ_НКДПоЦеннымБумагамHTMОстатки.Партия,");
    МаркерыПервыхПолей.Добавить("КорректировкиПоЭСПОблигации.Партия,");
    МаркерыПервыхПолей.Добавить("НачисленныеПроцентыПоБанковскимСчетамУправленческийОстатки.АналитическийСчет,");
    МаркерыПервыхПолей.Добавить("ЗадолженностьЭмитентаПоОблигациямУУОстатки.Актив,");
    МаркерыПервыхПолей.Добавить("ЗадолженностьЭмитентаПоКупонномуДоходуУУОстатки.Облигация,");
    МаркерыПервыхПолей.Добавить("ЗадолженностьЭмитентаПоДивидендамУУОстатки.Актив,");
    МаркерыПервыхПолей.Добавить("ДенежныеСредстваУправленческийОстатки.АналитическийСчет,");
    МаркерыПервыхПолей.Добавить("ОпционныеПремииОстатки.Опцион,");
    МаркерыПервыхПолей.Добавить("СтоимостьАктивовПоСделкамРЕПОУправленческийОстатки.Актив,");
    МаркерыПервыхПолей.Добавить("НачисленныеПроцентыПоРЕПОУправленческийОстатки.СделкаРЕПО,");
    МаркерыПервыхПолей.Добавить("НачисленныйКупонныйДоходПоСделкамРЕПОУправленческийОстатки.Облигация,");
    МаркерыПервыхПолей.Добавить("РасчетыРЕПОДебиторскаяЗадолженностьПоТелуОстатки.БизнесПроцесс,");
    МаркерыПервыхПолей.Добавить("РасчетыРЕПОДебиторскаяЗадолженностьПоКупонуОстатки.Контрагент,");
    МаркерыПервыхПолей.Добавить("РасчетыРЕПОКредиторскаяЗадолженностьПоТелуОстатки.БизнесПроцесс,");
    МаркерыПервыхПолей.Добавить("РасчетыРЕПОКредиторскаяЗадолженностьПоКупонуОстатки.Контрагент,");
    МаркерыПервыхПолей.Добавить("СформированныеРезервыОстатки.Аналитика,");

    ЭтоПерваяВыборка = Истина;
    Для Каждого МаркерПоля Из МаркерыПервыхПолей Цикл
        ИмяТаблицы = Лев(МаркерПоля, СтрНайти(МаркерПоля, ".") - 1);
        ТекстЗапроса = ВставитьПолеДоговорДУПеред(ТекстЗапроса, МаркерПоля, ИмяТаблицы, ЭтоПерваяВыборка);
        ЭтоПерваяВыборка = Ложь;
    КонецЦикла;

    ТекстЗапроса = ВставитьПолеДоговорДУПеред(
        ТекстЗапроса,
        "ВТ_ПромежуточнаяТаблица.Показатель КАК Показатель,",
        "ВТ_ПромежуточнаяТаблица",
        Истина);

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
        "СГРУППИРОВАТЬ ПО
        |TAB|ВТ_ПромежуточнаяТаблица.Показатель,
        |TAB|ВТ_ПромежуточнаяТаблица.ИсточникПоказателя",
        "СГРУППИРОВАТЬ ПО
        |TAB|ВТ_ПромежуточнаяТаблица.ДоговорДУ,
        |TAB|ВТ_ПромежуточнаяТаблица.Показатель,
        |TAB|ВТ_ПромежуточнаяТаблица.ИсточникПоказателя");

    ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
        "УПОРЯДОЧИТЬ ПО
        |TAB|ИсточникПоказателя,
        |TAB|Показатель",
        "УПОРЯДОЧИТЬ ПО
        |TAB|ДоговорДУ,
        |TAB|ИсточникПоказателя,
        |TAB|Показатель");

    Возврат ТекстЗапроса;

КонецФункции

