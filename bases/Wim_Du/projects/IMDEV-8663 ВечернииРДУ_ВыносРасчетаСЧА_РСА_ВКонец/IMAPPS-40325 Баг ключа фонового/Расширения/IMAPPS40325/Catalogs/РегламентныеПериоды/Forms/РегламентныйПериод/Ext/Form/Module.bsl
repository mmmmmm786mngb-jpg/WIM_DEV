#Область ОбработчикиКомандФормы

#Область РаботаСДлительнымиОперациями

&НаСервере
&ИзменениеИКонтроль("СформироватьРегламентныеОперацииНаСервере")
Функция IM40325_СформироватьРегламентныеОперацииНаСервере(ДатаПериода, СписокДоговоровДУ, УчитыватьВыполненные, НаименованиеФоновогоЗадания)
	
	Результат = Новый Структура("Статус, ИдентификаторЗадания, АдресРезультата, КраткоеПредставлениеОшибки, ПодробноеПредставлениеОшибки", "Ошибка");
	
	Попытка
		
		// Валидация входных данных
		Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
			Результат.КраткоеПредставлениеОшибки   = НСтр("ru='Не указана дата периода'");
			Результат.ПодробноеПредставлениеОшибки = Результат.КраткоеПредставлениеОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если СписокДоговоровДУ = Неопределено Или ТипЗнч(СписокДоговоровДУ) <> Тип("Массив") Тогда
			Результат.КраткоеПредставлениеОшибки   = НСтр("ru='Список договоров не передан или имеет неверный тип'");
			Результат.ПодробноеПредставлениеОшибки = Результат.КраткоеПредставлениеОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Если СписокДоговоровДУ.Количество() = 0 Тогда
			Результат.КраткоеПредставлениеОшибки   = НСтр("ru='Нет договоров для обработки'");
			Результат.ПодробноеПредставлениеОшибки = Результат.КраткоеПредставлениеОшибки;
			Возврат Результат;
		КонецЕсли;
		
		ПараметрыСохранения = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
		Если ТипЗнч(ПараметрыСохранения) <> Тип("Структура") Тогда
			Результат.КраткоеПредставлениеОшибки   = НСтр("ru='Некорректные сохранённые параметры'");
			Результат.ПодробноеПредставлениеОшибки = Результат.КраткоеПредставлениеОшибки;
			Возврат Результат;
		КонецЕсли;
#Вставка
		// IMAPPS-40325: у каждого запуска свой идентификатор - он входит в ключ порций,
		// по нему же ожидание после отмены ищет порции только этого запуска
		IM40325_ИдентификаторЗапускаПорций = Строка(Новый УникальныйИдентификатор);
		ПараметрыСохранения.Вставить("ИдентификаторЗапуска", IM40325_ИдентификаторЗапускаПорций);
#КонецВставки

		// Подготовка параметров процедуры для длительной операции
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("ДатаПериода",          ДатаПериода);
		ПараметрыПроцедуры.Вставить("СписокДоговоровДУ",    СписокДоговоровДУ);
		ПараметрыПроцедуры.Вставить("УчитыватьВыполненные", УчитыватьВыполненные);
		ПараметрыПроцедуры.Вставить("ПараметрыСохранения",  ПараметрыСохранения);
		ПараметрыПроцедуры.Вставить("НаименованиеФоновогоЗадания", НаименованиеФоновогоЗадания);
		
		// Параметры выполнения длительной операции
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Формирование регламентных операций'");
		ПараметрыВыполнения.КлючФоновогоЗадания         = Строка(Новый УникальныйИдентификатор); // защита от дублей
		ПараметрыВыполнения.ОжидатьЗавершение           = 0; // не блокировать выполнение
		
		АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		ПараметрыВыполнения.АдресРезультата = АдресРезультата;
		
		// Запуск длительной операции в фоне
		// Примечание: В режиме отладки или файловой ИБ с активными заданиями может выполниться синхронно
		Результат = ДлительныеОперации.ВыполнитьВФоне(
			"Справочники.РегламентныеПериоды.СформироватьРегламентныеОперации",
			ПараметрыПроцедуры,
			ПараметрыВыполнения);
		
	Исключение
		
		// Обработка ошибок при подготовке и запуске длительной операции
		ТекстОшибки = СтрШаблон(
			НСтр("ru='Ошибка при запуске формирования регламентных операций: %1'"),
			ОписаниеОшибки());
		
		Результат.КраткоеПредставлениеОшибки   = ТекстОшибки;
		Результат.ПодробноеПредставлениеОшибки = ТекстОшибки;
		
		// Логирование ошибки
		ЗаписьЖурналаРегистрации(
			"РегламентныеОперации",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ASP_215902_IMDEV_8663_2_ОтменаПорций

&НаСервере
&ИзменениеИКонтроль("ЗапуститьОжиданиеПорцийНаСервере")
Функция IM40325_ЗапуститьОжиданиеПорцийНаСервере()

#Удаление
    Если Не Справочники.РегламентныеПериоды.ЕстьАктивныеПорцииРегламентаЗаДату(ДатаПериода) Тогда
#КонецУдаления
#Вставка
    Если Не Справочники.РегламентныеПериоды.ЕстьАктивныеПорцииЗапуска(
        ДатаПериода,
        IM40325_ИдентификаторЗапускаПорций) Тогда
#КонецВставки
        РезультатБезОжидания = Новый Структура;
        РезультатБезОжидания.Вставить("Статус", "Выполнено");
        Возврат РезультатБезОжидания;
    КонецЕсли;

    ПараметрыПроцедуры = Новый Структура("ДатаПериода", ДатаПериода);
#Вставка
    ПараметрыПроцедуры.Вставить("ИдентификаторЗапуска", IM40325_ИдентификаторЗапускаПорций);
#КонецВставки
    ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
    ПараметрыВыполнения.НаименованиеФоновогоЗадания =
        НСтр("ru='Ожидание завершения порций регламентных операций'");
    ПараметрыВыполнения.КлючФоновогоЗадания = "IM86632_Wait_" + Строка(Новый УникальныйИдентификатор);
    ПараметрыВыполнения.ОжидатьЗавершение = 0;
    ПараметрыВыполнения.ЗапуститьВФоне = Истина;

    Возврат ДлительныеОперации.ВыполнитьВФоне(
        "Справочники.РегламентныеПериоды.ОжидатьЗавершенияПорцийРегламентаЗаДату",
        ПараметрыПроцедуры,
        ПараметрыВыполнения);

КонецФункции

#КонецОбласти

#КонецОбласти
