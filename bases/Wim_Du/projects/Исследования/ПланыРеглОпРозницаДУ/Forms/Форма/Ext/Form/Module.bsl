////////////////////////////////////////////////////////////////////////////////
// Внешняя обработка "Планы регл. операций Розница ДУ (диаграмма)"
//
// Назначение:
//   Исследовательский отчет для базы Wim_Du (конфигурация ДУ): по выбранному
//   периоду показывает столбчатую диаграмму - сколько различных договоров ДУ
//   участвовало в регламентном закрытии каждый день.
//
// Источник данных:
//   Документ.ПланРегламентныхОперацийДУ (синоним: "Регламентные операции (ДУ)").
//   В шапке документа - реквизит ДоговорДУ; отбор по ДоговорДУ.Пул.
//
// Методика расчета:
//   - Группировка по календарным дням (НАЧАЛОПЕРИОДА(Дата, ДЕНЬ)).
//   - КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДоговорДУ) - один договор в день учитывается один раз,
//     даже если за день создано несколько планов (разные группы операций).
//   - Документы с пометкой удаления не учитываются.
//
// Реквизиты формы (Объект):
//   ДатаНачала     - начало периода (по умолчанию: начало текущего месяца)
//   ДатаОкончания  - окончание периода (по умолчанию: текущая дата)
//   ПулРозницаДУ   - элемент справочника Пул (по умолчанию: "Розничное ДУ")
//   Диаграмма      - гистограмма с линейной линией тренда (Серия.ЛинииТренда)
//   ТекстСтатистики - показатели и темп прироста (реквизит формы)
//
// Порядок работы:
//   1. Открыть обработку в базе Wim_Du (Файл - Открыть - ПланыРеглОпРозницаДУ.epf).
//   2. При необходимости скорректировать период и пул.
//   3. Нажать "Построить диаграмму".
//
// Связанные материалы:
//   Текст запроса для консоли: Исследования/plan_regl_ops_roznica_du_contracts_by_day.txt
//
// Примечание:
//   Заголовок диаграммы задается у элемента формы (Элементы.Диаграмма.Заголовок),
//   а не у объекта Диаграмма - особенность платформы 1С.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

// Описание: Устанавливает период по умолчанию и подставляет пул "Розничное ДУ".
//
// Параметры:
//   Отказ                - Булево - признак отказа от создания формы
//   СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		Объект.ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Объект.ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ПулРозницаДУ) Тогда
		Объект.ПулРозницаДУ = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Описание: Запускает запрос и обновляет столбчатую диаграмму на форме.
//
// Параметры:
//   Команда - КомандаФормы - команда "Построить диаграмму"
//
&НаКлиенте
Процедура ПостроитьДиаграмму(Команда)

	Если Не ПроверитьЗаполнениеПараметров() Тогда
		Возврат;
	КонецЕсли;

	ПостроитьДиаграммуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Проверяет заполнение периода и пула перед построением диаграммы.
//
// Возвращаемое значение:
//   Булево - Истина, если параметры корректны
//
&НаКлиенте
Функция ПроверитьЗаполнениеПараметров()

	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		ПоказатьПредупреждение(, "Укажите дату начала периода.");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите дату окончания периода.");
		Возврат Ложь;
	КонецЕсли;

	Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
		ПоказатьПредупреждение(, "Дата начала не может быть больше даты окончания.");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ПулРозницаДУ) Тогда
		ПоказатьПредупреждение(, "Укажите пул договоров (например, ""Розничное ДУ"").");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Описание: Выполняет запрос и записывает диаграмму в реквизит обработки.
//
&НаСервере
Процедура ПостроитьДиаграммуНаСервере()

	ТаблицаДанных = ПолучитьДанныеПоДнямНаСервере(
		Объект.ДатаНачала,
		Объект.ДатаОкончания,
		Объект.ПулРозницаДУ);

	Объект.Диаграмма = СформироватьДиаграммуПоТаблице(ТаблицаДанных);

	ТекстСтатистики = СформироватьТекстСтатистики(
		ТаблицаДанных,
		Объект.ДатаНачала,
		Объект.ДатаОкончания,
		Объект.ПулРозницаДУ);

	Элементы.Диаграмма.Заголовок = ТекстЗаголовкаДиаграммы(
		Объект.ДатаНачала,
		Объект.ДатаОкончания,
		Объект.ПулРозницаДУ);

КонецПроцедуры

// Описание: Формирует столбчатую диаграмму с линейной линией тренда по таблице данных.
//
// Параметры:
//   ТаблицаДанных - ТаблицаЗначений - агрегаты по дням
//
// Возвращаемое значение:
//   Диаграмма - гистограмма с линией тренда
//
&НаСервере
Функция СформироватьДиаграммуПоТаблице(ТаблицаДанных)

	Диаграмма = Новый Диаграмма;
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.Гистограмма;
	Диаграмма.ОбластьПостроения.ШкалаЗначений.ТекстЗаголовка = "Количество различных договоров ДУ";

	Серия = Диаграмма.Серии.Добавить("Договоров ДУ");

	Если ТаблицаДанных.Количество() > 1 Тогда

		ЛинияТренда = Серия.ЛинииТренда.Добавить();
		ЛинияТренда.ТипАппроксимации = ТипАппроксимацииЛинииТрендаДиаграммы.Линейный;
		ЛинияТренда.ОтображатьВЛегенде = Истина;

	КонецЕсли;

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

		ПодписьДня = Формат(СтрокаДанных.День, "ДФ=dd.MM.yy");
		Точка = Диаграмма.Точки.Добавить(ПодписьДня);
		Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаДанных.КоличествоРазличныхДоговоровДУ);

	КонецЦикла;

	Диаграмма.Обновление = Истина;

	Возврат Диаграмма;

КонецФункции

// Описание: Формирует столбчатую диаграмму по данным планов регламентных операций ДУ.
//
// Параметры:
//   ДатаНачала     - Дата - начало периода (включительно)
//   ДатаОкончания  - Дата - окончание периода (включительно)
//   ПулРозницаДУ   - СправочникСсылка.Пул - пул договоров
//
// Возвращаемое значение:
//   Диаграмма - диаграмма с количеством различных договоров ДУ по дням
//
&НаСервере
Функция СформироватьДиаграммуНаСервере(ДатаНачала, ДатаОкончания, ПулРозницаДУ)

	ТаблицаДанных = ПолучитьДанныеПоДнямНаСервере(ДатаНачала, ДатаОкончания, ПулРозницаДУ);
	Возврат СформироватьДиаграммуПоТаблице(ТаблицаДанных);

КонецФункции

// Описание: Возвращает таблицу с количеством различных договоров ДУ по дням.
//
// Параметры:
//   ДатаНачала     - Дата - начало периода
//   ДатаОкончания  - Дата - окончание периода
//   ПулРозницаДУ   - СправочникСсылка.Пул - пул договоров
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: День, КоличествоРазличныхДоговоровДУ, КоличествоПланов
//
&НаСервере
Функция ПолучитьДанныеПоДнямНаСервере(ДатаНачала, ДатаОкончания, ПулРозницаДУ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(План.Дата, ДЕНЬ) КАК День,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ План.ДоговорДУ) КАК КоличествоРазличныхДоговоровДУ,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ План.Ссылка) КАК КоличествоПланов
	|ИЗ
	|	Документ.ПланРегламентныхОперацийДУ КАК План
	|ГДЕ
	|	План.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И План.ДоговорДУ.Пул = &ПулРозницаДУ
	|	И НЕ План.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(План.Дата, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	День";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ПулРозницаДУ", ПулРозницаДУ);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Описание: Формирует заголовок поля диаграммы на форме.
//
// Параметры:
//   ДатаНачала     - Дата - начало периода
//   ДатаОкончания  - Дата - окончание периода
//   ПулРозницаДУ   - СправочникСсылка.Пул - пул договоров
//
// Возвращаемое значение:
//   Строка - текст заголовка
//
&НаСервере
Функция ТекстЗаголовкаДиаграммы(ДатаНачала, ДатаОкончания, ПулРозницаДУ)

	Возврат СтрШаблон(
		"Планы регл. операций, пул %1: %2 - %3",
		ПулРозницаДУ,
		Формат(ДатаНачала, "ДЛФ=D"),
		Формат(ДатаОкончания, "ДЛФ=D"));

КонецФункции

// Описание: Формирует текстовый блок со сводной статистикой и параметрами линейного тренда.
//
// Параметры:
//   ТаблицаДанных   - ТаблицаЗначений - агрегаты по дням
//   ДатаНачала      - Дата - начало периода
//   ДатаОкончания   - Дата - окончание периода
//   ПулРозницаДУ    - СправочникСсылка.Пул - пул договоров
//
// Возвращаемое значение:
//   Строка - многострочный отчет для поля ТекстСтатистики
//
&НаСервере
Функция СформироватьТекстСтатистики(ТаблицаДанных, ДатаНачала, ДатаОкончания, ПулРозницаДУ)

	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат "За выбранный период нет документов ПланРегламентныхОперацийДУ" + Символы.ПС
			+ "для пула """ + ПулРозницаДУ + """.";
	КонецЕсли;

	КалендарныхДней = Цел((НачалоДня(ДатаОкончания) - НачалоДня(ДатаНачала)) / 86400) + 1;
	ПараметрыТренда = РассчитатьЛинейныйТренд(ТаблицаДанных, ДатаНачала);

	СуммаДоговоров = 0;
	СуммаПланов = 0;
	МинимумДоговоров = Неопределено;
	МаксимумДоговоров = Неопределено;
	МассивЗначений = Новый Массив;

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

		ЗначениеДня = СтрокаДанных.КоличествоРазличныхДоговоровДУ;
		СуммаДоговоров = СуммаДоговоров + ЗначениеДня;
		СуммаПланов = СуммаПланов + СтрокаДанных.КоличествоПланов;
		МассивЗначений.Добавить(ЗначениеДня);

		Если МинимумДоговоров = Неопределено Или ЗначениеДня < МинимумДоговоров Тогда
			МинимумДоговоров = ЗначениеДня;
		КонецЕсли;

		Если МаксимумДоговоров = Неопределено Или ЗначениеДня > МаксимумДоговоров Тогда
			МаксимумДоговоров = ЗначениеДня;
		КонецЕсли;

	КонецЦикла;

	КоличествоДнейСДанными = ТаблицаДанных.Количество();
	СреднееДоговоров = СуммаДоговоров / КоличествоДнейСДанными;
	МедианаДоговоров = РассчитатьМедиану(МассивЗначений);
	СреднееПланов = СуммаПланов / КоличествоДнейСДанными;

	НаклонВДень = ПараметрыТренда.Наклон;
	НаклонВНеделю = НаклонВДень * 7;
	ДнейТренда = Макс(ПараметрыТренда.МаксимальныйИндексДня, 1);
	ПриростЗаПериодПоТренду = НаклонВДень * ДнейТренда;

	ПерваяСтрока = ТаблицаДанных[0];
	ПоследняяСтрока = ТаблицаДанных[КоличествоДнейСДанными - 1];
	ТрендНаПервыйДень = ПараметрыТренда.СвободныйЧлен;
	ТрендНаПоследнийДень = ПараметрыТренда.СвободныйЧлен + НаклонВДень * ПараметрыТренда.МаксимальныйИндексДня;

	Строки = Новый Массив;
	Строки.Добавить("СТАТИСТИКА ПО ПУЛУ: " + ПулРозницаДУ);
	Строки.Добавить("Период: " + Формат(ДатаНачала, "ДЛФ=D") + " - " + Формат(ДатаОкончания, "ДЛФ=D")
		+ " (" + Формат(КалендарныхДней, "ЧН=0; ЧГ=") + " календ. дн.)");
	Строки.Добавить("Дней с данными: " + Формат(КоличествоДнейСДанными, "ЧН=0; ЧГ=")
		+ " (" + ФорматВещественногоЧисла(100 * КоличествоДнейСДанными / КалендарныхДней, 1) + "% периода)");
	Строки.Добавить("");
	Строки.Добавить("Различных договоров ДУ в день (по факту):");
	Строки.Добавить("  Минимум:  " + Формат(МинимумДоговоров, "ЧН=0; ЧГ="));
	Строки.Добавить("  Максимум: " + Формат(МаксимумДоговоров, "ЧН=0; ЧГ="));
	Строки.Добавить("  Среднее:  " + ФорматВещественногоЧисла(СреднееДоговоров, 1));
	Строки.Добавить("  Медиана:  " + ФорматВещественногоЧисла(МедианаДоговоров, 1));
	Строки.Добавить("  Первый день (" + Формат(ПерваяСтрока.День, "ДЛФ=D") + "): "
		+ Формат(ПерваяСтрока.КоличествоРазличныхДоговоровДУ, "ЧН=0; ЧГ="));
	Строки.Добавить("  Последний день (" + Формат(ПоследняяСтрока.День, "ДЛФ=D") + "): "
		+ Формат(ПоследняяСтрока.КоличествоРазличныхДоговоровДУ, "ЧН=0; ЧГ="));
	Строки.Добавить("  Изменение факт (последний - первый): "
		+ Формат(ПоследняяСтрока.КоличествоРазличныхДоговоровДУ - ПерваяСтрока.КоличествоРазличныхДоговоровДУ, "ЧН=0; ЧГ="));
	Строки.Добавить("");
	Строки.Добавить("Документов ПланРегламентныхОперацийДУ:");
	Строки.Добавить("  Всего за период: " + Формат(СуммаПланов, "ЧН=0; ЧГ="));
	Строки.Добавить("  В среднем в день с данными: " + ФорматВещественногоЧисла(СреднееПланов, 1));
	Строки.Добавить("");
	Строки.Добавить("ЛИНЕЙНЫЙ ТРЕНД (аппроксимация по дням с данными):");
	Строки.Добавить("  Темп прироста: " + ФорматВещественногоЧисла(НаклонВДень, 1) + " дог./день");
	Строки.Добавить("  Темп прироста: " + ФорматВещественногоЧисла(НаклонВНеделю, 1) + " дог./неделю");
	Строки.Добавить("  Оценка R2: " + ФорматВещественногоЧисла(ПараметрыТренда.R2, 1));
	Строки.Добавить("  Уровень тренда на " + Формат(ПерваяСтрока.День, "ДЛФ=D") + ": "
		+ ФорматВещественногоЧисла(ТрендНаПервыйДень, 1));
	Строки.Добавить("  Уровень тренда на " + Формат(ПоследняяСтрока.День, "ДЛФ=D") + ": "
		+ ФорматВещественногоЧисла(ТрендНаПоследнийДень, 1));
	Строки.Добавить("  Прирост по тренду за охват данных: "
		+ ФорматВещественногоЧисла(ПриростЗаПериодПоТренду, 1) + " дог.");

	Если КалендарныхДней >= 7 Тогда
		Строки.Добавить("  Средний темп на календарную неделю периода: "
			+ ФорматВещественногоЧисла(ПриростЗаПериодПоТренду / (КалендарныхДней / 7), 1) + " дог./нед.");
	КонецЕсли;

	ДобавитьСтрокиПрогнозаПоКварталамИГоду(
		Строки,
		ДатаНачала,
		ДатаОкончания,
		ПараметрыТренда,
		ПоследняяСтрока.День);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Описание: Добавляет в отчет прогноз числа договоров на конец кварталов и годов.
//
// Параметры:
//   Строки              - Массив - накопитель строк отчета
//   ДатаНачала          - Дата - начало периода анализа (база для тренда)
//   ДатаОкончания       - Дата - окончание периода анализа
//   ПараметрыТренда     - Структура - коэффициенты линейного тренда
//   ПоследнийДеньСДанными - Дата - последний день, в который есть факт
//
&НаСервере
Процедура ДобавитьСтрокиПрогнозаПоКварталамИГоду(Строки, ДатаНачала, ДатаОкончания, ПараметрыТренда, ПоследнийДеньСДанными)

	Строки.Добавить("");
	Строки.Добавить("ПРОГНОЗ (договоров ДУ на конец дня, линейный тренд):");

	ГодНачала = Год(ДатаНачала);
	ГодОкончания = Год(ДатаОкончания);
	НачалоПериода = НачалоДня(ДатаНачала);
	ПоследнийДеньФакта = НачалоДня(ПоследнийДеньСДанными);

	Для НомерГода = ГодНачала По ГодОкончания Цикл

		Строки.Добавить("  --- " + Формат(НомерГода, "ЧГ=0") + " ---");

		Для НомерКвартала = 1 По 4 Цикл

			МесяцСерединыКвартала = НомерКвартала * 3 - 1;
			ДатаКонцаКвартала = КонецКвартала(Дата(НомерГода, МесяцСерединыКвартала, 15));

			Если ДатаКонцаКвартала < НачалоПериода Тогда
				Продолжить;
			КонецЕсли;

			ПрогнозЗначение = ПрогнозДоговоровПоТренду(ДатаКонцаКвартала, ДатаНачала, ПараметрыТренда);
			ПометкаДаты = ПометкаПрогнозаНаДату(ДатаКонцаКвартала, ПоследнийДеньФакта);

			Строки.Добавить("    Q" + Формат(НомерКвартала, "ЧГ=") + " ("
				+ Формат(ДатаКонцаКвартала, "ДЛФ=D") + "): "
				+ ФорматЦелогоЧисла(ПрогнозЗначение) + " - " + ПометкаДаты);

		КонецЦикла;

		ДатаКонцаГода = КонецГода(Дата(НомерГода, 1, 1));

		Если ДатаКонцаГода >= НачалоПериода Тогда

			ПрогнозНаГод = ПрогнозДоговоровПоТренду(ДатаКонцаГода, ДатаНачала, ПараметрыТренда);
			ПометкаДаты = ПометкаПрогнозаНаДату(ДатаКонцаГода, ПоследнийДеньФакта);

			Строки.Добавить("    Конец года (" + Формат(ДатаКонцаГода, "ДЛФ=D") + "): "
				+ ФорматЦелогоЧисла(ПрогнозНаГод) + " - " + ПометкаДаты);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Описание: Рассчитывает прогноз числа договоров на указанную дату по линейному тренду.
//
// Параметры:
//   ДатаПрогноза        - Дата - дата, на которую строится прогноз
//   ДатаНачалаПериода   - Дата - начало периода (нулевой день t = 0)
//   ПараметрыТренда     - Структура - Наклон, СвободныйЧлен
//
// Возвращаемое значение:
//   Число - прогнозное количество (не меньше 0)
//
&НаСервере
Функция ПрогнозДоговоровПоТренду(ДатаПрогноза, ДатаНачалаПериода, ПараметрыТренда)

	ИндексДня = (НачалоДня(ДатаПрогноза) - НачалоДня(ДатаНачалаПериода)) / 86400;
	ЗначениеПрогноза = ПараметрыТренда.СвободныйЧлен + ПараметрыТренда.Наклон * ИндексДня;

	Если ЗначениеПрогноза < 0 Тогда
		ЗначениеПрогноза = 0;
	КонецЕсли;

	Возврат ЗначениеПрогноза;

КонецФункции

// Описание: Возвращает пометку для строки прогноза - оценка по тренду или экстраполяция вперед.
//
&НаСервере
Функция ПометкаПрогнозаНаДату(ДатаПрогноза, ПоследнийДеньФакта)

	Если НачалоДня(ДатаПрогноза) > ПоследнийДеньФакта Тогда
		Возврат "прогноз";
	КонецЕсли;

	Возврат "оценка тренда";

КонецФункции

// Описание: Рассчитывает коэффициенты линейной регрессии y = a + b * x.
// x - номер календарного дня от начала периода, y - количество договоров в день.
//
// Параметры:
//   ТаблицаДанных - ТаблицаЗначений - агрегаты по дням
//   ДатаНачала    - Дата - начало периода
//
// Возвращаемое значение:
//   Структура - Наклон, СвободныйЧлен, R2, МаксимальныйИндексДня
//
&НаСервере
Функция РассчитатьЛинейныйТренд(ТаблицаДанных, ДатаНачала)

	Результат = Новый Структура("Наклон, СвободныйЧлен, R2, МаксимальныйИндексДня", 0, 0, 0, 0);

	КоличествоТочек = ТаблицаДанных.Количество();
	Если КоличествоТочек = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	НачалоПериода = НачалоДня(ДатаНачала);
	СуммаX = 0;
	СуммаY = 0;
	СуммаXY = 0;
	СуммаX2 = 0;
	МаксимальныйИндексДня = 0;

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

		ИндексДня = (НачалоДня(СтрокаДанных.День) - НачалоПериода) / 86400;
		ЗначениеY = СтрокаДанных.КоличествоРазличныхДоговоровДУ;

		СуммаX = СуммаX + ИндексДня;
		СуммаY = СуммаY + ЗначениеY;
		СуммаXY = СуммаXY + ИндексДня * ЗначениеY;
		СуммаX2 = СуммаX2 + ИндексДня * ИндексДня;

		Если ИндексДня > МаксимальныйИндексДня Тогда
			МаксимальныйИндексДня = ИндексДня;
		КонецЕсли;

	КонецЦикла;

	Если КоличествоТочек = 1 Тогда
		Результат.СвободныйЧлен = СуммаY;
		Результат.МаксимальныйИндексДня = МаксимальныйИндексДня;
		Результат.R2 = 1;
		Возврат Результат;
	КонецЕсли;

	Знаменатель = КоличествоТочек * СуммаX2 - СуммаX * СуммаX;
	Если Знаменатель <> 0 Тогда
		Результат.Наклон = (КоличествоТочек * СуммаXY - СуммаX * СуммаY) / Знаменатель;
	КонецЕсли;

	Результат.СвободныйЧлен = (СуммаY - Результат.Наклон * СуммаX) / КоличествоТочек;
	Результат.МаксимальныйИндексДня = МаксимальныйИндексДня;
	Результат.R2 = РассчитатьR2(ТаблицаДанных, ДатаНачала, Результат.Наклон, Результат.СвободныйЧлен);

	Возврат Результат;

КонецФункции

// Описание: Рассчитывает коэффициент детерминации R2 для линейного тренда.
//
&НаСервере
Функция РассчитатьR2(ТаблицаДанных, ДатаНачала, Наклон, СвободныйЧлен)

	КоличествоТочек = ТаблицаДанных.Количество();
	Если КоличествоТочек < 2 Тогда
		Возврат 1;
	КонецЕсли;

	НачалоПериода = НачалоДня(ДатаНачала);
	СуммаY = 0;

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		СуммаY = СуммаY + СтрокаДанных.КоличествоРазличныхДоговоровДУ;
	КонецЦикла;

	СреднееY = СуммаY / КоличествоТочек;
	СуммаКвадратовОбщая = 0;
	СуммаКвадратовОстатков = 0;

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

		ИндексДня = (НачалоДня(СтрокаДанных.День) - НачалоПериода) / 86400;
		ЗначениеY = СтрокаДанных.КоличествоРазличныхДоговоровДУ;
		ЗначениеТренда = СвободныйЧлен + Наклон * ИндексДня;

		СуммаКвадратовОбщая = СуммаКвадратовОбщая + (ЗначениеY - СреднееY) * (ЗначениеY - СреднееY);
		СуммаКвадратовОстатков = СуммаКвадратовОстатков + (ЗначениеY - ЗначениеТренда) * (ЗначениеY - ЗначениеТренда);

	КонецЦикла;

	Если СуммаКвадратовОбщая = 0 Тогда
		Возврат 1;
	КонецЕсли;

	Возврат 1 - СуммаКвадратовОстатков / СуммаКвадратовОбщая;

КонецФункции

// Описание: Возвращает медиану числового массива.
//
&НаСервере
Функция РассчитатьМедиану(МассивЗначений)

	Если МассивЗначений.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Копия = Новый Массив;
	Для Каждого Значение Из МассивЗначений Цикл
		Копия.Добавить(Значение);
	КонецЦикла;

	Для Индекс1 = 0 По Копия.ВГраница() - 1 Цикл
		Для Индекс2 = Индекс1 + 1 По Копия.ВГраница() Цикл
			Если Копия[Индекс2] < Копия[Индекс1] Тогда
				Временное = Копия[Индекс1];
				Копия[Индекс1] = Копия[Индекс2];
				Копия[Индекс2] = Временное;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Середина = Цел(Копия.ВГраница() / 2);
	Если Копия.Количество() % 2 = 0 Тогда
		Возврат (Копия[Середина] + Копия[Середина - 1]) / 2;
	КонецЕсли;

	Возврат Копия[Середина];

КонецФункции

// Описание: Форматирует вещественное число без обрезки целой части.
//
// Параметры:
//   Значение        - Число - значение для вывода
//   ЗнаковПослеЗапятой - Число - количество знаков после запятой
//
// Возвращаемое значение:
//   Строка - отформатированное число
//
&НаСервере
Функция ФорматВещественногоЧисла(Значение, ЗнаковПослеЗапятой)

	Возврат Формат(Значение, "ЧН=0; ЧДЦ=" + Строка(ЗнаковПослеЗапятой) + "; ЧГ=");

КонецФункции

// Описание: Форматирует число как целое с округлением до ближайшего целого.
//
// Параметры:
//   Значение - Число - значение для вывода
//
// Возвращаемое значение:
//   Строка - целое число без дробной части
//
&НаСервере
Функция ФорматЦелогоЧисла(Значение)

	Возврат Формат(Окр(Значение, 0), "ЧН=0; ЧГ=");

КонецФункции

#КонецОбласти
