#Область ОбработчикиКомандФормы

// Заполняет регистр: при непустом регистре спрашивает подтверждение очистки, затем читает версии
// порциями с показом прогресса и в конце очищает регистр и записывает новые записи.
//
// Параметры:
//  Команда - КомандаФормы - команда Заполнить.
//
&НаКлиенте
Асинх Процедура Заполнить(Команда)

	ЗаписейВРегистре = КоличествоЗаписейВРегистреНаСервере();
	Если ЗаписейВРегистре > 0 Тогда
		ТекстВопроса = СтрШаблон(НСтр("ru = 'В регистре ""История статуса ЦБ для квал. инвестора"" записей: %1.
			|Регистр будет полностью очищен и заполнен заново. Продолжить?'"), ЗаписейВРегистре);
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НачатьНаСервере();
	ПоказатьПрогресс(НачалоМс);

	// Серверный вызов в цикле намеренно: каждая порция бумаг - отдельный вызов, между ними
	// обновляется прогресс.
	Пока Не ОбработатьПорциюНаСервере() Цикл
		ПоказатьПрогресс(НачалоМс);
	КонецЦикла;

	Состояние(НСтр("ru = 'Запись в регистр...'"), 95);
	ЗавершитьНаСервере();
	Состояние(НСтр("ru = 'Заполнение регистра завершено'"), 100);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает число записей в регистре; проверяет права и наличие регистра.
//
// Возвращаемое значение:
//  Число - записей в регистре.
//
&НаСервере
Функция КоличествоЗаписейВРегистреНаСервере()

	Возврат РеквизитФормыВЗначение("Объект").КоличествоЗаписейВРегистре();

КонецФункции

// Создает состояние заполнения и помещает его во временное хранилище формы.
//
&НаСервере
Процедура НачатьНаСервере()

	Итог = "";
	СостояниеЗаполнения = РеквизитФормыВЗначение("Объект").НовоеСостояние();
	ВсегоБумаг = СостояниеЗаполнения.Бумаги.Количество();
	ОбработаноБумаг = 0;
	АдресСостояния = ПоместитьВоВременноеХранилище(СостояниеЗаполнения, УникальныйИдентификатор);

КонецПроцедуры

// Обрабатывает очередную порцию бумаг.
//
// Возвращаемое значение:
//  Булево - Истина, если все бумаги обработаны.
//
&НаСервере
Функция ОбработатьПорциюНаСервере()

	СостояниеЗаполнения = ПолучитьИзВременногоХранилища(АдресСостояния);
	Готово = РеквизитФормыВЗначение("Объект").ОбработатьПорцию(СостояниеЗаполнения);
	ОбработаноБумаг = СостояниеЗаполнения.Позиция;
	ПоместитьВоВременноеХранилище(СостояниеЗаполнения, АдресСостояния);

	Возврат Готово;

КонецФункции

// Очищает регистр, записывает новые записи и выводит итог.
//
&НаСервере
Процедура ЗавершитьНаСервере()

	СостояниеЗаполнения = ПолучитьИзВременногоХранилища(АдресСостояния);
	Результат = РеквизитФормыВЗначение("Объект").Завершить(СостояниеЗаполнения, СверитьСПрежним);
	Итог = Результат.Текст;

	УдалитьИзВременногоХранилища(АдресСостояния);
	АдресСостояния = "";

КонецПроцедуры

// Показывает процент обработанных бумаг и оценку оставшегося времени чтения версий.
//
// Параметры:
//  НачалоМс - Число - момент начала заполнения, мс.
//
&НаКлиенте
Процедура ПоказатьПрогресс(НачалоМс)

	ПрошлоСекунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс) / 1000);
	Процент = 0;
	ТекстОстатка = НСтр("ru = 'оценивается'");
	Если ВсегоБумаг > 0 И ОбработаноБумаг > 0 Тогда
		Процент = ОбработаноБумаг / ВсегоБумаг * 90;
		ОсталосьСекунд = Окр(ПрошлоСекунд / ОбработаноБумаг * (ВсегоБумаг - ОбработаноБумаг));
		ТекстОстатка = ФорматВремени(ОсталосьСекунд);
	КонецЕсли;

	Состояние(СтрШаблон(НСтр("ru = 'Чтение версий: %1 из %2 бумаг'"), ОбработаноБумаг, ВсегоБумаг), Процент,
		СтрШаблон(НСтр("ru = 'Прошло %1, осталось примерно %2, затем запись в регистр'"),
			ФорматВремени(ПрошлоСекунд), ТекстОстатка));

КонецПроцедуры

// Форматирует секунды как мм:сс.
//
// Параметры:
//  Секунды - Число - длительность.
//
// Возвращаемое значение:
//  Строка - время мм:сс.
//
&НаКлиенте
Функция ФорматВремени(Секунды)

	Возврат Формат(Цел(Секунды / 60), "ЧН=0; ЧГ=0") + ":" + Формат(Секунды % 60, "ЧЦ=2; ЧВН=; ЧН=00");

КонецФункции

#КонецОбласти
