#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Заполнение РегистрСведений.ИсторияСтатусаЦБДляКвалИнвестора по версиям объектов вместо обработчика
// обновления ОбновлениеИнформационнойБазыПереопределяемый.ОбновитьДо1_5_30_0. Результат совпадает
// с результатом обработчика на пустом регистре. Регистр перед записью очищается полностью; по флагу
// сверки прежнее содержимое читается до очистки и сравнивается с новым.

#Область ПрограммныйИнтерфейс

// Возвращает число записей в регистре ИсторияСтатусаЦБДляКвалИнвестора, чтобы перед очисткой
// задать вопрос пользователю. Проверяет права и наличие регистра.
//
// Возвращаемое значение:
//  Число - записей в регистре.
//
Функция КоличествоЗаписейВРегистре() Экспорт

	ПроверитьВозможностьЗаполнения();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ИсторияСтатусаЦБДляКвалИнвестора КАК ИсторияСтатуса";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

// Проверяет права и наличие регистра, выбирает бумаги для заполнения.
//
// Возвращаемое значение:
//  Структура - состояние заполнения:
//   * НачалоМс      - Число - момент начала, мс.
//   * Бумаги        - Массив из СправочникСсылка - бумаги с признаком и версиями, в порядке обработки.
//   * Позиция       - Число - сколько бумаг уже обработано.
//   * ДатыПоАктивам - Соответствие - ключ СправочникСсылка.Активы, значение Массив из Дата - периоды
//                     записей, которые записал бы обработчик обновления.
//   * МинДни        - Соответствие - ключ СправочникСсылка.Активы, значение Дата - самый ранний день
//                     среди записей актива.
//   * Версий        - Число - обработано строк версий.
//   * Мс            - Структура - время этапов, мс: СоставБумаг, ЗапросВерсий, Распаковка,
//                     ЧтениеПризнака, ЧтениеРегистра, Сверка, Очистка, Запись.
//
Функция НовоеСостояние() Экспорт

	ПроверитьВозможностьЗаполнения();

	Этапы = "СоставБумаг, ЗапросВерсий, Распаковка, ЧтениеПризнака, ЧтениеРегистра, Сверка, Очистка, Запись";
	Мс = Новый Структура(Этапы, 0, 0, 0, 0, 0, 0, 0, 0);

	Состояние = Новый Структура;
	Состояние.Вставить("НачалоМс",      ТекущаяУниверсальнаяДатаВМиллисекундах());
	Состояние.Вставить("Позиция",       0);
	Состояние.Вставить("ДатыПоАктивам", Новый Соответствие);
	Состояние.Вставить("МинДни",        Новый Соответствие);
	Состояние.Вставить("Версий",        0);
	Состояние.Вставить("Мс",            Мс);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Состояние.Вставить("Бумаги", БумагиСВерсиями());
	Мс.СоставБумаг = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Возврат Состояние;

КонецФункции

// Читает версии очередной порции бумаг и собирает записи по активам в памяти. В базу не пишет.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние, изменяется.
//  РазмерПорции - Число - сколько бумаг обработать за вызов.
//
// Возвращаемое значение:
//  Булево - Истина, если все бумаги обработаны.
//
Функция ОбработатьПорцию(Состояние, Знач РазмерПорции = 100) Экспорт

	Всего = Состояние.Бумаги.Количество();
	Если Состояние.Позиция >= Всего Тогда
		Возврат Истина;
	КонецЕсли;

	Порция = Новый Массив;
	Пока Состояние.Позиция < Всего И Порция.Количество() < РазмерПорции Цикл
		Порция.Добавить(Состояние.Бумаги[Состояние.Позиция]);
		Состояние.Позиция = Состояние.Позиция + 1;
	КонецЦикла;

	СобратьЗаписи(Состояние, Порция);

	Возврат Состояние.Позиция >= Всего;

КонецФункции

// Записывает собранные записи: в одной транзакции полностью очищает регистр и пишет записи набором
// по каждому активу. По флагу сверки до очистки читает прежнее содержимое и сравнивает его с новым.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние, все порции обработаны.
//  СверитьСПрежним - Булево - Истина: прочитать регистр до очистки и сравнить с новыми записями.
//
// Возвращаемое значение:
//  Структура - итог:
//   * Текст         - Строка - итог для формы.
//   * Бумаг         - Число - обработано бумаг.
//   * Версий        - Число - обработано строк версий.
//   * Активов       - Число - активов с записями.
//   * Записей       - Число - записано записей.
//   * Сверка        - Структура, Неопределено - см. СверкаСПрежним; Неопределено без флага сверки.
//   * МсВсего       - Число - общее время, мс.
//
Функция Завершить(Состояние, Знач СверитьСПрежним) Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Бумаг",   Состояние.Бумаги.Количество());
	Итог.Вставить("Версий",  Состояние.Версий);
	Итог.Вставить("Активов", Состояние.ДатыПоАктивам.Количество());
	Итог.Вставить("Записей", 0);
	Итог.Вставить("Сверка",  Неопределено);
	Для Каждого КлючИЗначение Из Состояние.ДатыПоАктивам Цикл
		Итог.Записей = Итог.Записей + КлючИЗначение.Значение.Количество();
	КонецЦикла;

	Если СверитьСПрежним Тогда
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Прежние = СодержимоеРегистра();
		Состояние.Мс.ЧтениеРегистра = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Итог.Сверка = СверкаСПрежним(Состояние, Прежние);
		Состояние.Мс.Сверка = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	КонецЕсли;

	ЗаписатьРегистр(Состояние);

	Итог.Вставить("МсВсего", ТекущаяУниверсальнаяДатаВМиллисекундах() - Состояние.НачалоМс);
	Итог.Вставить("Текст", ТекстИтога(Состояние, Итог));

	ЗаписьЖурналаРегистрации("ЗаполнениеИсторииСтатусаЦБДляКвалИнвестора", УровеньЖурналаРегистрации.Информация,
		Метаданные.РегистрыСведений.Найти("ИсторияСтатусаЦБДляКвалИнвестора"), , Итог.Текст);

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Подготовка

// Проверяет, что регистр есть в конфигурации и что пользователь полноправный: запросы читают
// все бумаги без ограничения доступа, неполные права дали бы неполный регистр.
//
Процедура ПроверитьВозможностьЗаполнения()

	Если Метаданные.РегистрыСведений.Найти("ИсторияСтатусаЦБДляКвалИнвестора") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В конфигурации нет регистра сведений ИсторияСтатусаЦБДляКвалИнвестора
			|(он появился в версии 1.5.30.0).'");
	КонецЕсли;

	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Заполнение регистра доступно только пользователю с полными правами.'");
	КонецЕсли;

КонецПроцедуры

// Выбирает бумаги, которые обрабатывал бы обработчик обновления: признак ЦБДляКвалИнвестора, без
// пометки удаления, есть версии и актив.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка - бумаги.
//
Функция БумагиСВерсиями()

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЦБДляКвал() +
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВерсииОбъектов.Объект КАК Объект
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
		|		ПО ВерсииОбъектов.Объект = Активы.Объект
		|ГДЕ
		|	ВерсииОбъектов.Объект В
		|			(ВЫБРАТЬ
		|				ВТ_ЦБДляКвал.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТ_ЦБДляКвал КАК ВТ_ЦБДляКвал)";
	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Объект");

КонецФункции

// Возвращает первый пакет запроса: временная таблица ВТ_ЦБДляКвал со ссылками бумаг по условию
// обработчика обновления (признак ЦБДляКвалИнвестора, без пометки удаления). Текст заканчивается
// разделителем пакетов.
//
// Возвращаемое значение:
//  Строка - текст пакета запроса.
//
Функция ТекстЗапросаЦБДляКвал()

	Возврат
		"ВЫБРАТЬ
		|	СпрОблигации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ЦБДляКвал
		|ИЗ
		|	Справочник.Облигации КАК СпрОблигации
		|ГДЕ
		|	СпрОблигации.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрОблигации.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрАкции.Ссылка
		|ИЗ
		|	Справочник.Акции КАК СпрАкции
		|ГДЕ
		|	СпрАкции.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрАкции.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрВекселя.Ссылка
		|ИЗ
		|	Справочник.Векселя КАК СпрВекселя
		|ГДЕ
		|	СпрВекселя.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрВекселя.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрИСУ.Ссылка
		|ИЗ
		|	Справочник.ИпотечныеСертификатыУчастия КАК СпрИСУ
		|ГДЕ
		|	СпрИСУ.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрИСУ.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрПаиПИФ.Ссылка
		|ИЗ
		|	Справочник.ПаиПИФ КАК СпрПаиПИФ
		|ГДЕ
		|	СпрПаиПИФ.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрПаиПИФ.ПометкаУдаления = ЛОЖЬ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";

КонецФункции

#КонецОбласти

#Область ЧтениеВерсий

// Читает версии бумаг порции по убыванию номера версии и для каждой версии с признаком
// ЦБДляКвалИнвестора = Истина повторяет решение обработчика обновления на пустом регистре: запись
// Истина добавляется, если у актива еще нет записи на день версии или более ранний день (срез
// последних на дату версии пуст). Все записи - Истина, поэтому достаточно помнить самый ранний день.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние, дополняются ДатыПоАктивам, МинДни, Версий, Мс.
//  Порция - Массив из СправочникСсылка - бумаги.
//
Процедура СобратьЗаписи(Состояние, Порция)

	Мс = Состояние.Мс;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВерсииОбъектов.Объект КАК Объект,
		|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии,
		|	ВерсииОбъектов.ВерсияОбъекта КАК ВерсияОбъекта,
		|	ВерсииОбъектов.ДатаВерсии КАК ДатаВерсии,
		|	Активы.Ссылка КАК Актив
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
		|		ПО ВерсииОбъектов.Объект = Активы.Объект
		|ГДЕ
		|	ВерсииОбъектов.Объект В(&Бумаги)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Объект,
		|	НомерВерсии УБЫВ";
	Запрос.УстановитьПараметр("Бумаги", Порция);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Мс.ЗапросВерсий = Мс.ЗапросВерсий + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Пока Выборка.Следующий() Цикл

		Состояние.Версий = Состояние.Версий + 1;

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Данные = Выборка.ВерсияОбъекта.Получить();
		Мс.Распаковка = Мс.Распаковка + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Продолжить;
		КонецЕсли;

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Признак = ПризнакКвалИзВерсии(Данные);
		Мс.ЧтениеПризнака = Мс.ЧтениеПризнака + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		Если Признак <> Истина Или Не ЗначениеЗаполнено(Выборка.Актив) Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьЗапись(Состояние, Выборка.Актив, Выборка.ДатаВерсии);

	КонецЦикла;

КонецПроцедуры

// Добавляет запись актива на дату версии, если срез последних на эту дату пуст.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние, дополняются ДатыПоАктивам, МинДни.
//  Актив - СправочникСсылка.Активы - актив бумаги.
//  ДатаВерсии - Дата - дата версии, становится периодом записи.
//
Процедура ДобавитьЗапись(Состояние, Актив, ДатаВерсии)

	ДеньВерсии = НачалоДня(ДатаВерсии);
	МинДень = Состояние.МинДни[Актив];
	Если МинДень <> Неопределено И МинДень <= ДеньВерсии Тогда
		Возврат;
	КонецЕсли;

	ДатыАктива = Состояние.ДатыПоАктивам[Актив];
	Если ДатыАктива = Неопределено Тогда
		ДатыАктива = Новый Массив;
		Состояние.ДатыПоАктивам.Вставить(Актив, ДатыАктива);
	КонецЕсли;
	ДатыАктива.Добавить(ДатаВерсии);
	Состояние.МинДни.Вставить(Актив, ДеньВерсии);

КонецПроцедуры

// Читает значение реквизита ЦБДляКвалИнвестора из версии объекта (ЗаписатьXML в FastInfoset).
// Чтение прекращается на найденном элементе второго уровня, табличные части после него не читаются.
//
// Параметры:
//  Данные - ДвоичныеДанные - версия объекта из РегистрСведений.ВерсииОбъектов.
//
// Возвращаемое значение:
//  Булево, Неопределено - значение признака; Неопределено, если элемента нет.
//
Функция ПризнакКвалИзВерсии(Данные)

	Чтение = Новый ЧтениеFastInfoset;
	Чтение.УстановитьДвоичныеДанные(Данные);

	Признак = Неопределено;
	Уровень = 0;
	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Уровень = Уровень - 1;
			Продолжить;
		ИначеЕсли Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;

		Уровень = Уровень + 1;
		Если Уровень = 2 И Чтение.Имя = "ЦБДляКвалИнвестора" Тогда
			Если Чтение.Прочитать() И Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Признак = Чтение.Значение = "true" Или Чтение.Значение = "1";
			КонецЕсли;
			Прервать;
		КонецЕсли;

	КонецЦикла;
	Чтение.Закрыть();

	Возврат Признак;

КонецФункции

#КонецОбласти

#Область СверкаИЗапись

// Читает все записи регистра ИсторияСтатусаЦБДляКвалИнвестора.
//
// Возвращаемое значение:
//  Структура:
//   * Записи     - Соответствие - актив -> Соответствие (начало дня периода -> значение ЦБДляКвалИнвестора).
//   * Количество - Число - записей.
//
Функция СодержимоеРегистра()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИсторияСтатуса.Актив КАК Актив,
		|	ИсторияСтатуса.Период КАК Период,
		|	ИсторияСтатуса.ЦБДляКвалИнвестора КАК ЦБДляКвалИнвестора
		|ИЗ
		|	РегистрСведений.ИсторияСтатусаЦБДляКвалИнвестора КАК ИсторияСтатуса";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Записи = Новый Соответствие;
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		ДниАктива = Записи[Выборка.Актив];
		Если ДниАктива = Неопределено Тогда
			ДниАктива = Новый Соответствие;
			Записи.Вставить(Выборка.Актив, ДниАктива);
		КонецЕсли;
		ДниАктива.Вставить(НачалоДня(Выборка.Период), Выборка.ЦБДляКвалИнвестора);
		Количество = Количество + 1;
	КонецЦикла;

	Возврат Новый Структура("Записи, Количество", Записи, Количество);

КонецФункции

// Сравнивает новые записи с прежним содержимым регистра по ключу актив + день и по значению.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние.
//  Прежние - Структура - см. СодержимоеРегистра.
//
// Возвращаемое значение:
//  Структура:
//   * Прежних       - Число - записей в регистре до очистки.
//   * Совпало       - Число - записей, совпавших по активу, дню и значению.
//   * ТолькоНовые   - Число - новых записей, которых не было в регистре (или было другое значение).
//   * ТолькоПрежние - Число - прежних записей, которых нет среди новых (или было другое значение).
//   * Примеры       - Массив из Строка - до 20 расхождений.
//
Функция СверкаСПрежним(Состояние, Прежние)

	Сверка = Новый Структура("Прежних, Совпало, ТолькоНовые, ТолькоПрежние, Примеры",
		Прежние.Количество, 0, 0, 0, Новый Массив);
	НовыеДни = Новый Соответствие;

	Для Каждого КлючИЗначение Из Состояние.ДатыПоАктивам Цикл
		ДниАктива = Новый Соответствие;
		НовыеДни.Вставить(КлючИЗначение.Ключ, ДниАктива);
		ПрежниеДни = Прежние.Записи[КлючИЗначение.Ключ];
		Для Каждого ДатаВерсии Из КлючИЗначение.Значение Цикл
			ДниАктива.Вставить(НачалоДня(ДатаВерсии), Истина);
			Если ПрежнееЗначение(ПрежниеДни, ДатаВерсии) = Истина Тогда
				Сверка.Совпало = Сверка.Совпало + 1;
			Иначе
				Сверка.ТолькоНовые = Сверка.ТолькоНовые + 1;
				ДобавитьПример(Сверка, НСтр("ru = 'нет в прежнем'"), КлючИЗначение.Ключ, ДатаВерсии);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого КлючИЗначение Из Прежние.Записи Цикл
		ДниАктива = НовыеДни[КлючИЗначение.Ключ];
		Для Каждого ПрежняяЗапись Из КлючИЗначение.Значение Цикл
			Если ПрежняяЗапись.Значение = Истина И ПрежнееЗначение(ДниАктива, ПрежняяЗапись.Ключ) = Истина Тогда
				Продолжить;
			КонецЕсли;
			Сверка.ТолькоПрежние = Сверка.ТолькоПрежние + 1;
			ДобавитьПример(Сверка, СтрШаблон(НСтр("ru = 'нет в новом, значение %1'"), ПрежняяЗапись.Значение),
				КлючИЗначение.Ключ, ПрежняяЗапись.Ключ);
		КонецЦикла;
	КонецЦикла;

	Возврат Сверка;

КонецФункции

// Возвращает значение записи на день даты из соответствия дней актива.
//
// Параметры:
//  ДниАктива - Соответствие, Неопределено - начало дня -> значение; Неопределено, если записей нет.
//  Дата - Дата - дата, день которой ищется.
//
// Возвращаемое значение:
//  Булево, Неопределено - значение или Неопределено, если записи на этот день нет.
//
Функция ПрежнееЗначение(ДниАктива, Дата)

	Если ДниАктива = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДниАктива[НачалоДня(Дата)];

КонецФункции

// Добавляет пример расхождения в итог сверки, не больше 20.
//
// Параметры:
//  Сверка - Структура - см. СверкаСПрежним.
//  Вид - Строка - описание расхождения.
//  Актив - СправочникСсылка.Активы - актив.
//  Период - Дата - период записи.
//
Процедура ДобавитьПример(Сверка, Вид, Актив, Период)

	Если Сверка.Примеры.Количество() < 20 Тогда
		Сверка.Примеры.Добавить(СтрШаблон("%1, %2: %3", Актив, Формат(Период, "ДФ=dd.MM.yyyy"), Вид));
	КонецЕсли;

КонецПроцедуры

// В одной транзакции полностью очищает регистр и записывает новые записи набором по каждому активу.
// Замещение набора с отбором только по активу допустимо: регистр перед этим очищен целиком.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние, заполняются Мс.Очистка и Мс.Запись.
//
Процедура ЗаписатьРегистр(Состояние)

	НачатьТранзакцию();

	Попытка

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ИсторияСтатусаЦБДляКвалИнвестора");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		НаборЗаписей = РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.СоздатьНаборЗаписей();
		НаборЗаписей.Записать();
		Состояние.Мс.Очистка = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Для Каждого КлючИЗначение Из Состояние.ДатыПоАктивам Цикл
			НаборЗаписей = РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Актив.Установить(КлючИЗначение.Ключ);
			Для Каждого ДатаВерсии Из КлючИЗначение.Значение Цикл
				Запись = НаборЗаписей.Добавить();
				Запись.Период             = ДатаВерсии;
				Запись.Актив              = КлючИЗначение.Ключ;
				Запись.ЦБДляКвалИнвестора = Истина;
			КонецЦикла;
			НаборЗаписей.Записать();
		КонецЦикла;
		Состояние.Мс.Запись = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ЗаполнениеИсторииСтатусаЦБДляКвалИнвестора", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.Найти("ИсторияСтатусаЦБДляКвалИнвестора"), ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Итог

// Формирует текст итога: объем, сверка с прежним регистром (если была), время по этапам с долей.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние.
//  Итог - Структура - см. Завершить.
//
// Возвращаемое значение:
//  Строка - многострочный итог.
//
Функция ТекстИтога(Состояние, Итог)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Регистр очищен и заполнен заново: %1 записей по %2 активам.'"),
		Итог.Записей, Итог.Активов));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Обработано бумаг: %1, версий: %2.'"), Итог.Бумаг, Итог.Версий));

	Если Итог.Сверка <> Неопределено Тогда
		Сверка = Итог.Сверка;
		Строки.Добавить("");
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Сверка с прежним содержимым регистра (%1 записей):
			|совпало %2, нет в прежнем %3, нет в новом %4.'"),
			Сверка.Прежних, Сверка.Совпало, Сверка.ТолькоНовые, Сверка.ТолькоПрежние));
		Для Каждого Пример Из Сверка.Примеры Цикл
			Строки.Добавить("  " + Пример);
		КонецЦикла;
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Время всего: %1 сек.'"), ФорматСекунд(Итог.МсВсего)));
	МсЭтапов = 0;
	Для Каждого Этап Из Состояние.Мс Цикл
		МсЭтапов = МсЭтапов + Этап.Значение;
		Если Этап.Значение > 0 Тогда
			Строки.Добавить(СтрокаЭтапа(Этап.Ключ, Этап.Значение, Итог.МсВсего));
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить(СтрокаЭтапа(НСтр("ru = 'Прочее (порции, передача состояния)'"),
		Макс(Итог.МсВсего - МсЭтапов, 0), Итог.МсВсего));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Формирует строку итога по этапу: время и доля от общего времени.
//
// Параметры:
//  Этап - Строка - имя этапа.
//  Миллисекунды - Число - время этапа.
//  МсВсего - Число - общее время.
//
// Возвращаемое значение:
//  Строка - строка итога.
//
Функция СтрокаЭтапа(Этап, Миллисекунды, МсВсего)

	Доля = Окр(Миллисекунды / Макс(МсВсего, 1) * 100);
	Возврат СтрШаблон("  %1: %2 сек. (%3 %4)", Этап, ФорматСекунд(Миллисекунды), Доля, "%");

КонецФункции

// Форматирует миллисекунды как секунды с одним знаком после запятой.
//
// Параметры:
//  Миллисекунды - Число - длительность.
//
// Возвращаемое значение:
//  Строка - секунды.
//
Функция ФорматСекунд(Миллисекунды)

	Возврат Формат(Миллисекунды / 1000, "ЧДЦ=1; ЧН=0");

КонецФункции

