#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Замер обработчика обновления ОбновлениеИнформационнойБазыПереопределяемый.ОбновитьДо1_5_30_0
// (заполнение РегистрСведений.ИсторияСтатусаЦБДляКвалИнвестора по версиям объектов) и быстрого
// варианта того же заполнения. В базу ничего не пишется: записи регистра имитируются в памяти
// по правилам ОбработатьИзменениеСтатусаЦБДляКвалИнвестора (периодичность День, запись при отличии
// от среза последних).

#Область ПрограммныйИнтерфейс

// Готовит состояние замера: окружение, состав бумаг, случайный порядок выборки.
//
// Параметры:
//  ПараметрыЗамера - Структура - параметры с формы:
//   * ЛимитБумаг      - Число  - сколько бумаг обработать не больше.
//   * ЛимитСекунд     - Число  - сколько секунд работать не дольше.
//   * Зерно           - Число  - зерно случайной выборки.
//   * ЗамерятьВендор  - Булево - выполнять алгоритм обработчика обновления.
//   * ЗамерятьБыстрый - Булево - выполнять быстрый алгоритм.
//
// Возвращаемое значение:
//  Структура - состояние замера для ВыполнитьПорцию и ДанныеОтчета:
//   * Параметры        - Структура - ПараметрыЗамера.
//   * НачалоМс         - Число - момент начала замера, мс.
//   * ДатаЗамера       - Дата - дата сеанса на начало замера.
//   * Окружение        - Структура - см. ОписаниеОкружения.
//   * МсЗапросСостава  - Число - время запроса состава бумаг, мс.
//   * Объекты          - ТаблицаЗначений - см. СоставБумаг.
//   * Порядок          - Массив из Число - индексы строк Объекты в порядке обработки.
//   * Позиция          - Число - сколько бумаг из Порядок уже обработано.
//   * Объем            - Соответствие - см. ОбъемПоВидам.
//   * Итоги            - Соответствие - ключ вид бумаги, значение см. ИтогиВида.
//   * Детали           - Массив из Структура - показатели по каждой обработанной бумаге.
//   * Расхождения      - Массив из Структура - бумаги, где записи алгоритмов не совпали (до 20).
//   * Ошибки           - Массив из Структура - тексты ошибок (до 20).
//   * ПричинаОстановки - Строка - заполняется при завершении.
//   * Готово           - Булево - замер завершен.
//
Функция НовоеСостояние(Знач ПараметрыЗамера) Экспорт

	Состояние = Новый Структура;
	Состояние.Вставить("Параметры",  ПараметрыЗамера);
	Состояние.Вставить("НачалоМс",   ТекущаяУниверсальнаяДатаВМиллисекундах());
	Состояние.Вставить("ДатаЗамера", ТекущаяДатаСеанса());
	Состояние.Вставить("Окружение",  ОписаниеОкружения());

	НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Объекты = СоставБумаг();
	Состояние.Вставить("МсЗапросСостава", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса);

	Состояние.Вставить("Объекты",          Объекты);
	Состояние.Вставить("Порядок",          СлучайныйПорядок(Объекты.Количество(), ПараметрыЗамера.Зерно));
	Состояние.Вставить("Позиция",          0);
	Состояние.Вставить("Объем",            ОбъемПоВидам(Объекты));
	Состояние.Вставить("Итоги",            Новый Соответствие);
	Состояние.Вставить("Детали",           Новый Массив);
	Состояние.Вставить("Расхождения",      Новый Массив);
	Состояние.Вставить("Ошибки",           Новый Массив);
	Состояние.Вставить("ПричинаОстановки", "");
	Состояние.Вставить("Готово",           Ложь);

	Возврат Состояние;

КонецФункции

// Обрабатывает бумаги из выборки, пока не истечет длительность порции или не сработает лимит
// бумаг или времени. Порции нужны, чтобы клиент показывал прогресс между вызовами сервера.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние, изменяется.
//  ДлительностьПорцииМс - Число - сколько миллисекунд работать в этом вызове.
//
// Возвращаемое значение:
//  Булево - Истина, если замер завершен.
//
Функция ВыполнитьПорцию(Состояние, Знач ДлительностьПорцииМс = 5000) Экспорт

	ПараметрыЗамера = Состояние.Параметры;
	НачалоПорции = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока Не Состояние.Готово Цикл

		Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если Состояние.Позиция >= Состояние.Порядок.Количество() Тогда
			ЗавершитьЗамер(Состояние, "Обработаны все бумаги");
		ИначеЕсли Состояние.Позиция >= ПараметрыЗамера.ЛимитБумаг Тогда
			ЗавершитьЗамер(Состояние, "Достигнут лимит бумаг");
		ИначеЕсли Сейчас - Состояние.НачалоМс >= ПараметрыЗамера.ЛимитСекунд * 1000 Тогда
			ЗавершитьЗамер(Состояние, "Достигнут лимит времени");
		ИначеЕсли Сейчас - НачалоПорции >= ДлительностьПорцииМс Тогда
			Прервать;
		Иначе
			СтрокаОбъекта = Состояние.Объекты[Состояние.Порядок[Состояние.Позиция]];
			Состояние.Позиция = Состояние.Позиция + 1;
			ЗамеритьБумагу(Состояние, СтрокаОбъекта);
		КонецЕсли;

	КонецЦикла;

	Возврат Состояние.Готово;

КонецФункции

// Формирует данные отчета о замере.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние.
//
// Возвращаемое значение:
//  Структура - отчет:
//   * Данные - Структура - окружение, объем, итоги по видам, прогноз, расхождения, ошибки, детали (для JSON).
//   * Текст  - Строка - итог для формы, см. ТекстИтога.
//
Функция ДанныеОтчета(Состояние) Экспорт

	Прогноз = ПрогнозПоВидам(Состояние);

	Данные = Новый Структура;
	Данные.Вставить("Формат",           "zamer_kval_1");
	Данные.Вставить("ДатаЗамера",       XMLСтрока(Состояние.ДатаЗамера));
	Данные.Вставить("МсВсего",          ТекущаяУниверсальнаяДатаВМиллисекундах() - Состояние.НачалоМс);
	Данные.Вставить("ПричинаОстановки", Состояние.ПричинаОстановки);
	Данные.Вставить("Параметры",        Состояние.Параметры);
	Данные.Вставить("Окружение",        Состояние.Окружение);
	Данные.Вставить("МсЗапросСостава",  Состояние.МсЗапросСостава);
	Данные.Вставить("Объем",            Состояние.Объем);
	Данные.Вставить("Итоги",            Состояние.Итоги);
	Данные.Вставить("Прогноз",          Прогноз);
	Данные.Вставить("Расхождения",      Состояние.Расхождения);
	Данные.Вставить("Ошибки",           Состояние.Ошибки);
	Данные.Вставить("Детали",           Состояние.Детали);

	Возврат Новый Структура("Данные, Текст", Данные, ТекстИтога(Состояние, Прогноз));

КонецФункции

// Сериализует данные отчета в строку JSON.
//
// Параметры:
//  Значение - Структура - см. ДанныеОтчета, поле Данные. Содержит только строки, числа, булево,
//             Неопределено, структуры, соответствия со строковыми ключами и массивы.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция ТекстДанныхОтчета(Значение) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Подготовка

// Собирает сведения о базе замера для отчета.
//
// Возвращаемое значение:
//  Структура - сведения:
//   * Конфигурация             - Строка - имя конфигурации.
//   * ВерсияКонфигурации       - Строка - версия конфигурации.
//   * ВерсияПлатформы          - Строка - версия приложения на сервере.
//   * ФайловаяБаза             - Булево - Истина для файловой базы.
//   * КомпьютерСервера         - Строка - имя компьютера, где выполняется серверный код.
//   * ВерсияБСП                - Строка - версия БСП или "не определена".
//   * ПолноправныйПользователь - Булево, Неопределено - полноправность пользователя замера.
//   * РегистрЕсть              - Булево - есть ли в конфигурации регистр ИсторияСтатусаЦБДляКвалИнвестора.
//   * ЗаписейВРегистре         - Число, Неопределено - число записей регистра, если он есть.
//
Функция ОписаниеОкружения()

	ИнформацияОСистеме = Новый СистемнаяИнформация;
	
	Окружение = Новый Структура;
	Окружение.Вставить("Конфигурация",             Метаданные.Имя);
	Окружение.Вставить("ВерсияКонфигурации",       Метаданные.Версия);
	Окружение.Вставить("ВерсияПлатформы",          ИнформацияОСистеме.ВерсияПриложения);
	Окружение.Вставить("ФайловаяБаза",             СтрНайти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1);
	Окружение.Вставить("КомпьютерСервера",         ИмяКомпьютера());
	Окружение.Вставить("ВерсияБСП",                "не определена");
	Окружение.Вставить("ПолноправныйПользователь", Неопределено);
	Окружение.Вставить("РегистрЕсть",
		Метаданные.РегистрыСведений.Найти("ИсторияСтатусаЦБДляКвалИнвестора") <> Неопределено);
	Окружение.Вставить("ЗаписейВРегистре",         Неопределено);

	// Сведения справочные: их отсутствие в старом релизе не должно прерывать замер.
	Попытка
		Окружение.ВерсияБСП = СтандартныеПодсистемыСервер.ВерсияБиблиотеки();
		Окружение.ПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();
	Исключение
		ЗаписьЖурналаРегистрации("ЗамерЗаполненияИсторииКвал", УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Окружение.РегистрЕсть Тогда
		// Регистр появился в 1.5.30.0: на базе со старым релизом его нет, текст запроса к нему
		// компилируется только после проверки наличия.
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	РегистрСведений.ИсторияСтатусаЦБДляКвалИнвестора КАК ИсторияСтатуса";
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Окружение.ЗаписейВРегистре = Выборка.Количество;
		КонецЕсли;
	КонецЕсли;

	Возврат Окружение;

КонецФункции

// Выбирает бумаги с признаком для квал. инвестора без пометки удаления (отбор как в ОбновитьДо1_5_30_0),
// у которых есть версии. Строк - число строк соединения версий с активами: столько строк перебирает
// обработчик обновления. Порядок строк фиксирован, чтобы при одном зерне выборка повторялась.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Объект     - СправочникСсылка - бумага.
//   * Строк      - Число - строк версий (с учетом соединения с активами).
//   * Байт       - Число - сумма ВерсииОбъектов.РазмерДанных по этим строкам.
//   * ВидОбъекта - Строка - имя справочника бумаги.
//
Функция СоставБумаг()

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЦБДляКвал() +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВерсииОбъектов.Объект КАК Объект,
		|	КОЛИЧЕСТВО(ВерсииОбъектов.НомерВерсии) КАК Строк,
		|	СУММА(ВерсииОбъектов.РазмерДанных) КАК Байт
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
		|		ПО ВерсииОбъектов.Объект = Активы.Объект
		|ГДЕ
		|	ВерсииОбъектов.Объект В
		|			(ВЫБРАТЬ
		|				ВТ_ЦБДляКвал.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТ_ЦБДляКвал КАК ВТ_ЦБДляКвал)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВерсииОбъектов.Объект";

	РезультатЗапроса = Запрос.Выполнить();
	Объекты = РезультатЗапроса.Выгрузить();
	Объекты.Колонки.Добавить("ВидОбъекта", Новый ОписаниеТипов("Строка"));
	Для Каждого СтрокаОбъекта Из Объекты Цикл
		СтрокаОбъекта.ВидОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(СтрокаОбъекта.Объект)).Имя;
	КонецЦикла;
	Объекты.Сортировать("ВидОбъекта, Байт, Строк");

	Возврат Объекты;

КонецФункции

// Возвращает первый пакет запроса: временная таблица ВТ_ЦБДляКвал со ссылками бумаг по условию
// обработчика обновления. Текст заканчивается разделителем пакетов.
//
// Возвращаемое значение:
//  Строка - текст пакета запроса.
//
Функция ТекстЗапросаЦБДляКвал()

	Возврат
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СпрОблигации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ЦБДляКвал
		|ИЗ
		|	Справочник.Облигации КАК СпрОблигации
		|ГДЕ
		|	СпрОблигации.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрОблигации.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрАкции.Ссылка
		|ИЗ
		|	Справочник.Акции КАК СпрАкции
		|ГДЕ
		|	СпрАкции.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрАкции.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрВекселя.Ссылка
		|ИЗ
		|	Справочник.Векселя КАК СпрВекселя
		|ГДЕ
		|	СпрВекселя.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрВекселя.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрИСУ.Ссылка
		|ИЗ
		|	Справочник.ИпотечныеСертификатыУчастия КАК СпрИСУ
		|ГДЕ
		|	СпрИСУ.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрИСУ.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрПаиПИФ.Ссылка
		|ИЗ
		|	Справочник.ПаиПИФ КАК СпрПаиПИФ
		|ГДЕ
		|	СпрПаиПИФ.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрПаиПИФ.ПометкаУдаления = ЛОЖЬ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";

КонецФункции

// Суммирует объем работы обработчика обновления по видам бумаг.
//
// Параметры:
//  Объекты - ТаблицаЗначений - см. СоставБумаг.
//
// Возвращаемое значение:
//  Соответствие - ключ ВидОбъекта, значение Структура с полями Бумаг, Строк, Байт.
//
Функция ОбъемПоВидам(Объекты)

	Объем = Новый Соответствие;
	Для Каждого СтрокаОбъекта Из Объекты Цикл
		ОбъемВида = Объем[СтрокаОбъекта.ВидОбъекта];
		Если ОбъемВида = Неопределено Тогда
			ОбъемВида = Новый Структура("Бумаг, Строк, Байт", 0, 0, 0);
			Объем.Вставить(СтрокаОбъекта.ВидОбъекта, ОбъемВида);
		КонецЕсли;
		ОбъемВида.Бумаг = ОбъемВида.Бумаг + 1;
		ОбъемВида.Строк = ОбъемВида.Строк + СтрокаОбъекта.Строк;
		ОбъемВида.Байт  = ОбъемВида.Байт + СтрокаОбъекта.Байт;
	КонецЦикла;

	Возврат Объем;

КонецФункции

// Возвращает случайную перестановку индексов 0..Количество-1 (тасование Фишера-Йетса).
// При одинаковом зерне перестановка повторяется.
//
// Параметры:
//  Количество - Число - число индексов.
//  Зерно - Число - начальное значение генератора случайных чисел.
//
// Возвращаемое значение:
//  Массив из Число - индексы строк в порядке обработки.
//
Функция СлучайныйПорядок(Количество, Зерно)

	Порядок = Новый Массив;
	Для Индекс = 0 По Количество - 1 Цикл
		Порядок.Добавить(Индекс);
	КонецЦикла;

	Генератор = Новый ГенераторСлучайныхЧисел(Зерно);
	Для Индекс = 0 По Количество - 2 Цикл
		Обмен = Генератор.СлучайноеЧисло(Индекс, Количество - 1);
		Значение = Порядок[Индекс];
		Порядок[Индекс] = Порядок[Обмен];
		Порядок[Обмен] = Значение;
	КонецЦикла;

	Возврат Порядок;

КонецФункции

#КонецОбласти

#Область ЗамерБумаги

// Читает версии одной бумаги и выполняет по ним выбранные алгоритмы, накапливает время и число
// записей в итогах вида, сверяет записи алгоритмов между собой. В базу не пишет.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние, изменяются Итоги, Детали, Расхождения, Ошибки.
//  СтрокаОбъекта - СтрокаТаблицыЗначений - строка таблицы, см. СоставБумаг.
//
Процедура ЗамеритьБумагу(Состояние, СтрокаОбъекта)

	ПараметрыЗамера = Состояние.Параметры;
	Итоги = ИтогиВида(Состояние, СтрокаОбъекта.ВидОбъекта);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Версии = ВерсииБумаги(СтрокаОбъекта.Объект);
	МсВыборка = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Деталь = Новый Структура;
	Деталь.Вставить("Вид",            СтрокаОбъекта.ВидОбъекта);
	Деталь.Вставить("Строк",          Версии.Количество());
	Деталь.Вставить("Байт",           Версии.Итог("РазмерДанных"));
	Деталь.Вставить("МсВыборка",      МсВыборка);
	Деталь.Вставить("МсВендор",       Неопределено);
	Деталь.Вставить("МсБыстрый",      Неопределено);
	Деталь.Вставить("ЗаписейВендор",  Неопределено);
	Деталь.Вставить("ЗаписейБыстрый", Неопределено);
	Деталь.Вставить("Совпало",        Неопределено);

	Итоги.Бумаг     = Итоги.Бумаг + 1;
	Итоги.Строк     = Итоги.Строк + Деталь.Строк;
	Итоги.Байт      = Итоги.Байт + Деталь.Байт;
	Итоги.МсВыборка = Итоги.МсВыборка + МсВыборка;

	ЗаписиВендор = Неопределено;
	Если ПараметрыЗамера.ЗамерятьВендор Тогда
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписиВендор = АлгоритмОбновления(Версии, Итоги, Состояние);
		Деталь.МсВендор      = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		Деталь.ЗаписейВендор = ЗаписиВендор.Количество();
		Итоги.МсВендор       = Итоги.МсВендор + Деталь.МсВендор;
		Итоги.ЗаписейВендор  = Итоги.ЗаписейВендор + Деталь.ЗаписейВендор;
	КонецЕсли;

	ЗаписиБыстрый = Неопределено;
	Если ПараметрыЗамера.ЗамерятьБыстрый Тогда
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписиБыстрый = БыстрыйАлгоритм(Версии, Итоги, Состояние);
		Деталь.МсБыстрый      = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		Деталь.ЗаписейБыстрый = ЗаписиБыстрый.Количество();
		Итоги.МсБыстрый       = Итоги.МсБыстрый + Деталь.МсБыстрый;
		Итоги.ЗаписейБыстрый  = Итоги.ЗаписейБыстрый + Деталь.ЗаписейБыстрый;
	КонецЕсли;

	Если ЗаписиВендор <> Неопределено И ЗаписиБыстрый <> Неопределено Тогда
		СверитьЗаписи(Состояние, Итоги, Деталь, СтрокаОбъекта.Объект, ЗаписиВендор, ЗаписиБыстрый);
	КонецЕсли;

	Состояние.Детали.Добавить(Деталь);

КонецПроцедуры

// Сравнивает записи регистра, полученные двумя алгоритмами по одной бумаге, и учитывает результат.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние, при расхождении дополняется Расхождения (до 20).
//  Итоги - Структура - см. ИтогиВида, увеличивается Совпало или Расхождений.
//  Деталь - Структура - показатели бумаги, заполняется Совпало.
//  Объект - СправочникСсылка - бумага.
//  ЗаписиВендор - ТаблицаЗначений - результат АлгоритмОбновления.
//  ЗаписиБыстрый - ТаблицаЗначений - результат БыстрыйАлгоритм.
//
Процедура СверитьЗаписи(Состояние, Итоги, Деталь, Объект, ЗаписиВендор, ЗаписиБыстрый)

	КлючВендор = КлючЗаписей(ЗаписиВендор);
	КлючБыстрый = КлючЗаписей(ЗаписиБыстрый);
	Деталь.Совпало = КлючВендор = КлючБыстрый;

	Если Деталь.Совпало Тогда
		Итоги.Совпало = Итоги.Совпало + 1;
		Возврат;
	КонецЕсли;

	Итоги.Расхождений = Итоги.Расхождений + 1;
	Если Состояние.Расхождения.Количество() < 20 Тогда
		Расхождение = Новый Структура;
		Расхождение.Вставить("Объект",        Строка(Объект));
		Расхождение.Вставить("Идентификатор", Строка(Объект.УникальныйИдентификатор()));
		Расхождение.Вставить("ЗаписиВендор",  КлючВендор);
		Расхождение.Вставить("ЗаписиБыстрый", КлючБыстрый);
		Состояние.Расхождения.Добавить(Расхождение);
	КонецЕсли;

КонецПроцедуры

// Выбирает версии бумаги в порядке обработчика обновления: соединение с активами по Активы.Объект,
// номер версии по убыванию. Запрос выполняется на каждую бумагу намеренно: так замеряется время
// чтения версий порциями, как будет в рабочем заполнении.
//
// Параметры:
//  Объект - СправочникСсылка.Облигации, СправочникСсылка.Акции, СправочникСсылка.Векселя,
//           СправочникСсылка.ИпотечныеСертификатыУчастия, СправочникСсылка.ПаиПИФ - бумага.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Объект, НомерВерсии, ВерсияОбъекта, ДатаВерсии, РазмерДанных, Актив.
//
Функция ВерсииБумаги(Объект)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВерсииОбъектов.Объект КАК Объект,
		|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии,
		|	ВерсииОбъектов.ВерсияОбъекта КАК ВерсияОбъекта,
		|	ВерсииОбъектов.ДатаВерсии КАК ДатаВерсии,
		|	ВерсииОбъектов.РазмерДанных КАК РазмерДанных,
		|	Активы.Ссылка КАК Актив
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
		|		ПО ВерсииОбъектов.Объект = Активы.Объект
		|ГДЕ
		|	ВерсииОбъектов.Объект = &Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерВерсии УБЫВ";
	Запрос.УстановитьПараметр("Объект", Объект);

	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

// Возвращает структуру счетчиков вида бумаг, при первом обращении создает ее с нулями.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние.
//  ВидОбъекта - Строка - имя справочника бумаги.
//
// Возвращаемое значение:
//  Структура - счетчики времени (мс), строк, байт, вызовов среза, записей, ошибок и совпадений.
//
Функция ИтогиВида(Состояние, ВидОбъекта)

	Итоги = Состояние.Итоги[ВидОбъекта];
	Если Итоги <> Неопределено Тогда
		Возврат Итоги;
	КонецЕсли;

	ИменаСчетчиков =
		"Бумаг,Строк,Байт,МсВыборка,ВерсийБезДанных,"
		+ "МсВендор,МсВендорПолучить,МсВендорРазбор,МсВендорРазборВерсии,МсВендорСрез,"
		+ "ВызововСрезаВендор,ЗаписейВендор,ОшибокВендор,"
		+ "МсБыстрый,МсБыстрыйПолучить,МсБыстрыйЧтение,МсБыстрыйСрез,"
		+ "ВызововСрезаБыстрый,ЗаписейБыстрый,ОшибокБыстрый,"
		+ "Совпало,Расхождений";

	Итоги = Новый Структура;
	Для Каждого ИмяСчетчика Из СтрРазделить(ИменаСчетчиков, ",") Цикл
		Итоги.Вставить(ИмяСчетчика, 0);
	КонецЦикла;
	Состояние.Итоги.Вставить(ВидОбъекта, Итоги);

	Возврат Итоги;

КонецФункции

#КонецОбласти

#Область Алгоритмы

// Повторяет ОбновлениеИнформационнойБазыПереопределяемый.ОбновитьДо1_5_30_0 для одной бумаги:
// распаковка версии, полный разбор, повторный разбор через РазборВерсии ради даты, проверка признака.
// Вместо записи в регистр - запись в таблицу в памяти. Попытка охватывает все версии бумаги, как
// в обработчике: при ошибке остальные версии бумаги пропускаются, ошибка попадает в отчет.
//
// Параметры:
//  Версии - ТаблицаЗначений - см. ВерсииБумаги.
//  Итоги - Структура - см. ИтогиВида, накапливаются поля МсВендор*.
//  Состояние - Структура - см. НовоеСостояние.
//
// Возвращаемое значение:
//  ТаблицаЗначений - записи регистра, см. НоваяТаблицаЗаписей.
//
Функция АлгоритмОбновления(Версии, Итоги, Состояние)

	Записи = НоваяТаблицаЗаписей();
	РегистрЕсть = Состояние.Окружение.РегистрЕсть;

	Попытка

		Для Каждого СтрокаВерсии Из Версии Цикл

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ВерсияОбъекта = СтрокаВерсии.ВерсияОбъекта.Получить();
			Итоги.МсВендорПолучить = Итоги.МсВендорПолучить + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			Если ТипЗнч(ВерсияОбъекта) <> Тип("ДвоичныеДанные") Тогда
				Продолжить;
			КонецЕсли;

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Результат = ВерсионированиеОбъектов.РазборПредставленияОбъектаXML(ВерсияОбъекта, СтрокаВерсии.Объект);
			Итоги.МсВендорРазбор = Итоги.МсВендорРазбор + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ВерсияОбъекта = ВерсионированиеОбъектов.РазборВерсии(СтрокаВерсии.Объект, СтрокаВерсии.НомерВерсии);
			Итоги.МсВендорРазборВерсии = Итоги.МсВендорРазборВерсии + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			// Сравнение с Истина как в обработчике: при неразобранном типе значение остается строкой.
			СтрокаПризнака = Результат.Реквизиты.Найти("ЦБДляКвалИнвестора", "НаименованиеРеквизита");
			Если СтрокаПризнака = Неопределено Или СтрокаПризнака.ЗначениеРеквизита <> Истина Тогда
				Продолжить;
			КонецЕсли;

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ИмитироватьИзменениеСтатуса(Записи, СтрокаВерсии.Актив, Истина, ВерсияОбъекта.ДатаИзменения, РегистрЕсть);
			Итоги.МсВендорСрез = Итоги.МсВендорСрез + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
			Итоги.ВызововСрезаВендор = Итоги.ВызововСрезаВендор + 1;

		КонецЦикла;

	Исключение
		Итоги.ОшибокВендор = Итоги.ОшибокВендор + 1;
		ДобавитьОшибку(Состояние, "Алгоритм обновления", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Записи;

КонецФункции

// Быстрый вариант того же заполнения: одна распаковка версии, чтение до реквизита
// ЦБДляКвалИнвестора, дата из ВерсииОбъектов.ДатаВерсии. Повторный вызов для уже записанного дня
// актива пропускается: срез последних вернул бы ту же запись с Истина, и записи бы не было.
//
// Параметры:
//  Версии - ТаблицаЗначений - см. ВерсииБумаги.
//  Итоги - Структура - см. ИтогиВида, накапливаются поля МсБыстрый*.
//  Состояние - Структура - см. НовоеСостояние.
//
// Возвращаемое значение:
//  ТаблицаЗначений - записи регистра, см. НоваяТаблицаЗаписей.
//
Функция БыстрыйАлгоритм(Версии, Итоги, Состояние)

	Записи = НоваяТаблицаЗаписей();
	РегистрЕсть = Состояние.Окружение.РегистрЕсть;

	Попытка

		Для Каждого СтрокаВерсии Из Версии Цикл

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Данные = СтрокаВерсии.ВерсияОбъекта.Получить();
			Итоги.МсБыстрыйПолучить = Итоги.МсБыстрыйПолучить + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
				Итоги.ВерсийБезДанных = Итоги.ВерсийБезДанных + 1;
				Продолжить;
			КонецЕсли;

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Признак = ПризнакКвалИзВерсии(Данные);
			Итоги.МсБыстрыйЧтение = Итоги.МсБыстрыйЧтение + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			Если Признак <> Истина Тогда
				Продолжить;
			КонецЕсли;

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Отбор = Новый Структура("Актив, Период", СтрокаВерсии.Актив, НачалоДня(СтрокаВерсии.ДатаВерсии));
			Если Не ЗначениеЗаполнено(Записи.НайтиСтроки(Отбор)) Тогда
				ИмитироватьИзменениеСтатуса(Записи, СтрокаВерсии.Актив, Истина, СтрокаВерсии.ДатаВерсии, РегистрЕсть);
				Итоги.ВызововСрезаБыстрый = Итоги.ВызововСрезаБыстрый + 1;
			КонецЕсли;
			Итоги.МсБыстрыйСрез = Итоги.МсБыстрыйСрез + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		КонецЦикла;

	Исключение
		Итоги.ОшибокБыстрый = Итоги.ОшибокБыстрый + 1;
		ДобавитьОшибку(Состояние, "Быстрый алгоритм", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Записи;

КонецФункции

// Читает значение реквизита ЦБДляКвалИнвестора из версии объекта (ЗаписатьXML в FastInfoset).
// Чтение прекращается на найденном элементе второго уровня, табличные части после него не читаются.
//
// Параметры:
//  Данные - ДвоичныеДанные - версия объекта из РегистрСведений.ВерсииОбъектов.
//
// Возвращаемое значение:
//  Булево, Неопределено - значение признака; Неопределено, если элемента нет или значение не разобрано.
//
Функция ПризнакКвалИзВерсии(Данные)

	Чтение = Новый ЧтениеFastInfoset;
	Чтение.УстановитьДвоичныеДанные(Данные);

	Признак = Неопределено;
	Уровень = 0;
	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Уровень = Уровень - 1;
			Продолжить;
		ИначеЕсли Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;

		Уровень = Уровень + 1;
		Если Уровень = 2 И Чтение.Имя = "ЦБДляКвалИнвестора" Тогда
			Признак = ЗначениеПризнака(Чтение);
			Прервать;
		КонецЕсли;

	КонецЦикла;
	Чтение.Закрыть();

	Возврат Признак;

КонецФункции

// Читает текст текущего элемента и приводит его к Булево.
//
// Параметры:
//  Чтение - ЧтениеFastInfoset - позиционировано на начале элемента ЦБДляКвалИнвестора.
//
// Возвращаемое значение:
//  Булево, Неопределено - значение; Неопределено, если текста нет или он не булево XML.
//
Функция ЗначениеПризнака(Чтение)

	Если Не Чтение.Прочитать() Или Чтение.ТипУзла <> ТипУзлаXML.Текст Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Чтение.Значение = "true" Или Чтение.Значение = "1" Тогда
		Возврат Истина;
	ИначеЕсли Чтение.Значение = "false" Или Чтение.Значение = "0" Тогда
		Возврат Ложь;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Повторяет РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.ОбработатьИзменениеСтатусаЦБДляКвалИнвестора
// на таблице в памяти: срез последних на дату, запись при отличии значения, период усекается до дня
// (периодичность регистра День). Если регистр есть в базе, срез последних по нему выполняется только
// ради замера времени, решение принимается по таблице в памяти.
//
// Параметры:
//  Записи - ТаблицаЗначений - см. НоваяТаблицаЗаписей, дополняется.
//  Актив - СправочникСсылка.Активы - актив бумаги.
//  ЦБДляКвалИнвестора - Булево - новое значение статуса.
//  ДатаИзменения - Дата - дата версии.
//  РегистрЕсть - Булево - есть ли регистр в конфигурации базы замера.
//
Процедура ИмитироватьИзменениеСтатуса(Записи, Актив, ЦБДляКвалИнвестора, ДатаИзменения, РегистрЕсть)

	Если Не ЗначениеЗаполнено(Актив) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаИзменения) Тогда
		Период = ДатаИзменения;
	Иначе
		Период = ТекущаяДатаСеанса();
	КонецЕсли;

	Если РегистрЕсть Тогда
		РегистрыСведений["ИсторияСтатусаЦБДляКвалИнвестора"].СрезПоследних(Период, Новый Структура("Актив", Актив));
	КонецЕсли;

	СтароеЗначение = Ложь;
	ПериодСреза = Неопределено;
	Для Каждого Запись Из Записи.НайтиСтроки(Новый Структура("Актив", Актив)) Цикл
		Если Запись.Период <= Период И (ПериодСреза = Неопределено Или Запись.Период > ПериодСреза) Тогда
			ПериодСреза = Запись.Период;
			СтароеЗначение = Запись.ЦБДляКвалИнвестора;
		КонецЕсли;
	КонецЦикла;

	Если СтароеЗначение = ЦБДляКвалИнвестора Тогда
		Возврат;
	КонецЕсли;

	ДеньПериода = НачалоДня(Период);
	Найденные = Записи.НайтиСтроки(Новый Структура("Актив, Период", Актив, ДеньПериода));
	Если ЗначениеЗаполнено(Найденные) Тогда
		Запись = Найденные[0];
	Иначе
		Запись = Записи.Добавить();
		Запись.Актив  = Актив;
		Запись.Период = ДеньПериода;
	КонецЕсли;
	Запись.ЦБДляКвалИнвестора = ЦБДляКвалИнвестора;

КонецПроцедуры

// Создает пустую таблицу записей регистра в памяти.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Актив, Период (начало дня), ЦБДляКвалИнвестора.
//
Функция НоваяТаблицаЗаписей()

	Записи = Новый ТаблицаЗначений;
	Записи.Колонки.Добавить("Актив");
	Записи.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	Записи.Колонки.Добавить("ЦБДляКвалИнвестора", Новый ОписаниеТипов("Булево"));
	Возврат Записи;

КонецФункции

// Строит строковое представление набора записей для сравнения результатов двух алгоритмов:
// отсортированные строки "идентификатор актива|день|значение" через точку с запятой.
//
// Параметры:
//  Записи - ТаблицаЗначений - см. НоваяТаблицаЗаписей.
//
// Возвращаемое значение:
//  Строка - представление набора.
//
Функция КлючЗаписей(Записи)

	Список = Новый СписокЗначений;
	Для Каждого Запись Из Записи Цикл
		Список.Добавить(Строка(Запись.Актив.УникальныйИдентификатор()) + "|"
			+ Формат(Запись.Период, "ДФ=yyyyMMdd") + "|" + Формат(Запись.ЦБДляКвалИнвестора, "БЛ=0; БИ=1"));
	КонецЦикла;
	Список.СортироватьПоЗначению();

	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), ";");

КонецФункции

// Добавляет текст ошибки в отчет, не больше 20 ошибок.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние.
//  Алгоритм - Строка - какой алгоритм выдал ошибку.
//  Текст - Строка - подробное представление ошибки.
//
Процедура ДобавитьОшибку(Состояние, Алгоритм, Текст)

	Если Состояние.Ошибки.Количество() < 20 Тогда
		Состояние.Ошибки.Добавить(Новый Структура("Алгоритм, Текст", Алгоритм, Лев(Текст, 2000)));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Отчет

// Отмечает замер завершенным.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние.
//  Причина - Строка - причина остановки для отчета.
//
Процедура ЗавершитьЗамер(Состояние, Причина)

	Состояние.Готово = Истина;
	Состояние.ПричинаОстановки = Причина;

КонецПроцедуры

// Считает прогноз полного времени в один поток: время выборки и алгоритма на строку версии в замере,
// умноженное на число строк вида. Для вида без строк в замере берется среднее по всем видам.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние.
//
// Возвращаемое значение:
//  Соответствие - ключ ВидОбъекта или "ИТОГО", значение Структура с показателями прогноза.
//
Функция ПрогнозПоВидам(Состояние)

	ВсегоЗамер = Новый Структура("Строк, МсВыборка, МсВендор, МсБыстрый", 0, 0, 0, 0);
	Для Каждого КлючИЗначение Из Состояние.Итоги Цикл
		ВсегоЗамер.Строк     = ВсегоЗамер.Строк + КлючИЗначение.Значение.Строк;
		ВсегоЗамер.МсВыборка = ВсегоЗамер.МсВыборка + КлючИЗначение.Значение.МсВыборка;
		ВсегоЗамер.МсВендор  = ВсегоЗамер.МсВендор + КлючИЗначение.Значение.МсВендор;
		ВсегоЗамер.МсБыстрый = ВсегоЗамер.МсБыстрый + КлючИЗначение.Значение.МсБыстрый;
	КонецЦикла;

	Прогноз = Новый Соответствие;
	ИтогВендорСек = 0;
	ИтогБыстрыйСек = 0;

	Для Каждого КлючИЗначение Из Состояние.Объем Цикл

		Итоги = Состояние.Итоги[КлючИЗначение.Ключ];
		Если Итоги <> Неопределено И Итоги.Строк > 0 Тогда
			Основа = Итоги;
			Источник = "вид";
		Иначе
			Основа = ВсегоЗамер;
			Источник = "все виды";
		КонецЕсли;

		ПрогнозВида = ПрогнозВида(Основа, КлючИЗначение.Значение.Строк);
		ПрогнозВида.Вставить("Источник", Источник);

		ИтогВендорСек = ИтогВендорСек + ПрогнозВида.СекВендор;
		ИтогБыстрыйСек = ИтогБыстрыйСек + ПрогнозВида.СекБыстрый;
		Прогноз.Вставить(КлючИЗначение.Ключ, ПрогнозВида);

	КонецЦикла;

	Прогноз.Вставить("ИТОГО", Новый Структура("СекВендор, СекБыстрый", ИтогВендорСек, ИтогБыстрыйСек));

	Возврат Прогноз;

КонецФункции

// Пересчитывает время замера на полный объем вида.
//
// Параметры:
//  Основа - Структура - замеренные Строк, МсВыборка, МсВендор, МсБыстрый.
//  СтрокВсего - Число - строк версий вида в базе.
//
// Возвращаемое значение:
//  Структура - СтрокЗамер, СтрокВсего, МсНаСтроку* (мс на строку версии), СекВендор, СекБыстрый.
//
Функция ПрогнозВида(Основа, СтрокВсего)

	ПрогнозВида = Новый Структура;
	ПрогнозВида.Вставить("СтрокЗамер",         Основа.Строк);
	ПрогнозВида.Вставить("СтрокВсего",         СтрокВсего);
	ПрогнозВида.Вставить("МсНаСтрокуВыборка",  0);
	ПрогнозВида.Вставить("МсНаСтрокуВендор",   0);
	ПрогнозВида.Вставить("МсНаСтрокуБыстрый",  0);
	ПрогнозВида.Вставить("СекВендор",          0);
	ПрогнозВида.Вставить("СекБыстрый",         0);

	Если Основа.Строк = 0 Тогда
		Возврат ПрогнозВида;
	КонецЕсли;

	ПрогнозВида.МсНаСтрокуВыборка = Окр(Основа.МсВыборка / Основа.Строк, 3);
	ПрогнозВида.МсНаСтрокуВендор  = Окр(Основа.МсВендор / Основа.Строк, 3);
	ПрогнозВида.МсНаСтрокуБыстрый = Окр(Основа.МсБыстрый / Основа.Строк, 3);
	ПрогнозВида.СекВендор         = Окр((Основа.МсВыборка + Основа.МсВендор) * СтрокВсего / Основа.Строк / 1000);
	ПрогнозВида.СекБыстрый        = Окр((Основа.МсВыборка + Основа.МсБыстрый) * СтрокВсего / Основа.Строк / 1000);

	Возврат ПрогнозВида;

КонецФункции

// Формирует текст итога замера для формы.
//
// Параметры:
//  Состояние - Структура - см. НовоеСостояние.
//  Прогноз - Соответствие - см. ПрогнозПоВидам.
//
// Возвращаемое значение:
//  Строка - многострочный итог.
//
Функция ТекстИтога(Состояние, Прогноз)

	ПараметрыЗамера = Состояние.Параметры;

	Всего = Новый Структура("Бумаг, Строк", 0, 0);
	Для Каждого КлючИЗначение Из Состояние.Объем Цикл
		Всего.Бумаг = Всего.Бумаг + КлючИЗначение.Значение.Бумаг;
		Всего.Строк = Всего.Строк + КлючИЗначение.Значение.Строк;
	КонецЦикла;

	Замер = Новый Структура("Бумаг, Строк, Совпало, Расхождений, Ошибок", 0, 0, 0, 0, 0);
	Для Каждого КлючИЗначение Из Состояние.Итоги Цикл
		Итоги = КлючИЗначение.Значение;
		Замер.Бумаг       = Замер.Бумаг + Итоги.Бумаг;
		Замер.Строк       = Замер.Строк + Итоги.Строк;
		Замер.Совпало     = Замер.Совпало + Итоги.Совпало;
		Замер.Расхождений = Замер.Расхождений + Итоги.Расхождений;
		Замер.Ошибок      = Замер.Ошибок + Итоги.ОшибокВендор + Итоги.ОшибокБыстрый;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Остановка: %1. Длительность замера: %2 сек.", Состояние.ПричинаОстановки,
		Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - Состояние.НачалоМс) / 1000, "ЧДЦ=0; ЧН=0")));
	Строки.Добавить(СтрШаблон("Бумаг: %1 из %2, строк версий: %3 из %4.",
		Замер.Бумаг, Всего.Бумаг, Замер.Строк, Всего.Строк));
	Строки.Добавить("");
	Строки.Добавить("Вид: строк в замере / всего; мс на строку: выборка, обновление, быстрый;"
		+ " прогноз, мин: обновление, быстрый");

	Для Каждого КлючИЗначение Из Прогноз Цикл
		Если КлючИЗначение.Ключ = "ИТОГО" Тогда
			Продолжить;
		КонецЕсли;
		ПрогнозВида = КлючИЗначение.Значение;
		Строки.Добавить(СтрШаблон("%1: %2 / %3; %4, %5, %6; %7, %8", КлючИЗначение.Ключ,
			ПрогнозВида.СтрокЗамер, ПрогнозВида.СтрокВсего,
			ПрогнозВида.МсНаСтрокуВыборка, ПрогнозВида.МсНаСтрокуВендор, ПрогнозВида.МсНаСтрокуБыстрый,
			ФорматМинут(ПрогнозВида.СекВендор), ФорматМинут(ПрогнозВида.СекБыстрый)));
	КонецЦикла;

	Строки.Добавить("");
	Итог = Прогноз["ИТОГО"];
	Если ПараметрыЗамера.ЗамерятьВендор Тогда
		Строки.Добавить("Прогноз в один поток, алгоритм обновления: " + ФорматМинут(Итог.СекВендор) + " мин.");
	КонецЕсли;
	Если ПараметрыЗамера.ЗамерятьБыстрый Тогда
		Строки.Добавить("Прогноз в один поток, быстрый алгоритм: " + ФорматМинут(Итог.СекБыстрый) + " мин.");
	КонецЕсли;
	Если ПараметрыЗамера.ЗамерятьВендор И ПараметрыЗамера.ЗамерятьБыстрый Тогда
		Строки.Добавить(СтрШаблон("Записи регистра совпали по %1 бумагам, расхождений: %2.",
			Замер.Совпало, Замер.Расхождений));
	КонецЕсли;
	Если Замер.Ошибок > 0 Тогда
		Строки.Добавить(СтрШаблон("Ошибок при разборе: %1 (подробности в JSON).", Замер.Ошибок));
	КонецЕсли;
	Если Не Состояние.Окружение.РегистрЕсть Тогда
		Строки.Добавить("Регистра ИсторияСтатусаЦБДляКвалИнвестора в базе нет:"
			+ " время среза последних в прогноз не входит.");
	КонецЕсли;
	Строки.Добавить("Время записи в регистр не замерялось: обработка не пишет в базу.");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Форматирует секунды как минуты с одним знаком после запятой.
//
// Параметры:
//  Секунды - Число - длительность.
//
// Возвращаемое значение:
//  Строка - минуты.
//
Функция ФорматМинут(Секунды)

	Возврат Формат(Секунды / 60, "ЧДЦ=1; ЧН=0");

КонецФункции

