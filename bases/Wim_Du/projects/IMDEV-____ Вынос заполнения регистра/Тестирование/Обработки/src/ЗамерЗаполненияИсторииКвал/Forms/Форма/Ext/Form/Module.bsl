#Область ОбработчикиСобытийФормы

// Заполняет параметры замера значениями по умолчанию.
//
// Параметры:
//  Отказ - Булево - не используется.
//  СтандартнаяОбработка - Булево - не используется.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЛимитБумаг      = 300;
	ЛимитСекунд     = 300;
	Зерно           = 1;
	ЗамерятьВендор  = Истина;
	ЗамерятьБыстрый = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Выполняет замер порциями по 5 секунд на сервере, между порциями показывает прогресс.
// В базу ничего не пишет.
//
// Параметры:
//  Команда - КомандаФормы - команда ВыполнитьЗамер.
//
&НаКлиенте
Процедура ВыполнитьЗамер(Команда)

	Если Не ЗамерятьВендор И Не ЗамерятьБыстрый Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте хотя бы один алгоритм.'"));
		Возврат;
	КонецЕсли;

	НачатьЗамерНаСервере();
	Состояние(ТекстПрогресса, ПроцентПрогресса);

	// Серверный вызов в цикле намеренно: одна порция ограничена 5 секундами, чтобы показывать прогресс.
	Пока Не ВыполнитьПорциюНаСервере() Цикл
		Состояние(ТекстПрогресса, ПроцентПрогресса);
	КонецЦикла;

	Состояние(НСтр("ru = 'Замер завершен'"));

КонецПроцедуры

// Передает результат замера в файл JSON на компьютере пользователя.
//
// Параметры:
//  Команда - КомандаФормы - команда СохранитьJSON.
//
&НаКлиенте
Асинх Процедура СохранитьJSON(Команда)

	Если ПустаяСтрока(РезультатJSON) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала выполните замер.'"));
		Возврат;
	КонецЕсли;

	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Сохранение результата замера'");
	Ждать ПолучитьФайлССервераАсинх(АдресФайлаJSON(), ИмяФайлаJSON, ПараметрыДиалога);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает состояние замера и помещает его во временное хранилище формы.
// Очищает прежний результат.
//
&НаСервере
Процедура НачатьЗамерНаСервере()

	ПараметрыЗамера = Новый Структура;
	ПараметрыЗамера.Вставить("ЛимитБумаг",      ЛимитБумаг);
	ПараметрыЗамера.Вставить("ЛимитСекунд",     ЛимитСекунд);
	ПараметрыЗамера.Вставить("Зерно",           Зерно);
	ПараметрыЗамера.Вставить("ЗамерятьВендор",  ЗамерятьВендор);
	ПараметрыЗамера.Вставить("ЗамерятьБыстрый", ЗамерятьБыстрый);

	Итог          = "";
	РезультатJSON = "";
	ИмяФайлаJSON  = "";

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СостояниеЗамера = ОбработкаОбъект.НовоеСостояние(ПараметрыЗамера);
	АдресСостояния = ПоместитьВоВременноеХранилище(СостояниеЗамера, УникальныйИдентификатор);

	ОбновитьПрогресс(СостояниеЗамера);

КонецПроцедуры

// Выполняет одну порцию замера. По завершении формирует итог и JSON.
//
// Возвращаемое значение:
//  Булево - Истина, если замер завершен.
//
&НаСервере
Функция ВыполнитьПорциюНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СостояниеЗамера = ПолучитьИзВременногоХранилища(АдресСостояния);

	Готово = ОбработкаОбъект.ВыполнитьПорцию(СостояниеЗамера);
	ОбновитьПрогресс(СостояниеЗамера);

	Если Не Готово Тогда
		ПоместитьВоВременноеХранилище(СостояниеЗамера, АдресСостояния);
		Возврат Ложь;
	КонецЕсли;

	Отчет = ОбработкаОбъект.ДанныеОтчета(СостояниеЗамера);
	Итог          = Отчет.Текст;
	РезультатJSON = ОбработкаОбъект.ТекстДанныхОтчета(Отчет.Данные);
	ИмяФайлаJSON  = "zamer_kval_" + Формат(СостояниеЗамера.ДатаЗамера, "ДФ=yyyyMMdd_HHmmss") + ".json";

	УдалитьИзВременногоХранилища(АдресСостояния);
	АдресСостояния = "";

	Возврат Истина;

КонецФункции

// Заполняет текст и процент прогресса по состоянию замера.
//
// Параметры:
//  СостояниеЗамера - Структура - состояние замера обработки (Позиция, Порядок, Параметры, НачалоМс).
//
&НаСервере
Процедура ОбновитьПрогресс(СостояниеЗамера)

	ВсегоБумаг = Мин(СостояниеЗамера.Порядок.Количество(), СостояниеЗамера.Параметры.ЛимитБумаг);
	Секунд = Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - СостояниеЗамера.НачалоМс) / 1000);

	ПроцентПоБумагам = 0;
	Если ВсегоБумаг > 0 Тогда
		ПроцентПоБумагам = СостояниеЗамера.Позиция / ВсегоБумаг * 100;
	КонецЕсли;
	ПроцентПоВремени = 0;
	Если СостояниеЗамера.Параметры.ЛимитСекунд > 0 Тогда
		ПроцентПоВремени = Секунд / СостояниеЗамера.Параметры.ЛимитСекунд * 100;
	КонецЕсли;

	ПроцентПрогресса = Мин(100, Окр(Макс(ПроцентПоБумагам, ПроцентПоВремени)));
	ТекстПрогресса = СтрШаблон(НСтр("ru = 'Замер: бумаг %1 из %2, прошло %3 сек.'"),
		СостояниеЗамера.Позиция, ВсегоБумаг, Секунд);

КонецПроцедуры

// Помещает текст JSON во временное хранилище как двоичные данные UTF-8.
//
// Возвращаемое значение:
//  Строка - адрес во временном хранилище.
//
&НаСервере
Функция АдресФайлаJSON()

	ДанныеФайла = ПолучитьДвоичныеДанныеИзСтроки(РезультатJSON, КодировкаТекста.UTF8);
	Возврат ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
