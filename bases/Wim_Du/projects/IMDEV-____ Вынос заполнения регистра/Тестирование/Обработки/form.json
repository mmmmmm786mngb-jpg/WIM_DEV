{
  "title": "Замер заполнения истории статуса ЦБ для квал. инвестора",
  "events": { "OnCreateAtServer": "ПриСозданииНаСервере" },
  "elements": [
    { "autoCmdBar": "ФормаКоманднаяПанель", "children": [
      { "button": "ФормаВыполнитьЗамер", "command": "ВыполнитьЗамер", "defaultButton": true },
      { "button": "ФормаСохранитьJSON", "command": "СохранитьJSON" }
    ]},
    { "label": "Пояснение", "title": "Обработка не пишет в базу. По случайной выборке бумаг она выполняет алгоритм обработчика обновления 1.5.30.0 и быстрый алгоритм, сравнивает результаты в памяти и считает прогноз полного времени.", "autoMaxWidth": false },
    { "group": "horizontalIfPossible", "name": "ГруппаЛимиты", "children": [
      { "input": "ЛимитБумаг", "path": "ЛимитБумаг", "title": "Не больше бумаг" },
      { "input": "ЛимитСекунд", "path": "ЛимитСекунд", "title": "Не дольше, сек" },
      { "input": "Зерно", "path": "Зерно", "title": "Зерно выборки" }
    ]},
    { "group": "horizontalIfPossible", "name": "ГруппаАлгоритмы", "children": [
      { "check": "ЗамерятьВендор", "path": "ЗамерятьВендор", "title": "Алгоритм обновления 1.5.30.0" },
      { "check": "ЗамерятьБыстрый", "path": "ЗамерятьБыстрый", "title": "Быстрый алгоритм" }
    ]},
    { "input": "Итог", "path": "Итог", "title": "Итог", "titleLocation": "top", "multiLine": true, "height": 14, "readOnly": true, "autoMaxWidth": false },
    { "input": "РезультатJSON", "path": "РезультатJSON", "title": "JSON", "titleLocation": "top", "multiLine": true, "height": 4, "readOnly": true, "autoMaxWidth": false }
  ],
  "attributes": [
    { "name": "Объект", "type": "ExternalDataProcessorObject.ЗамерЗаполненияИсторииКвал", "main": true },
    { "name": "ЛимитБумаг", "type": "decimal(10,0,nonneg)" },
    { "name": "ЛимитСекунд", "type": "decimal(10,0,nonneg)" },
    { "name": "Зерно", "type": "decimal(10,0,nonneg)" },
    { "name": "ЗамерятьВендор", "type": "boolean" },
    { "name": "ЗамерятьБыстрый", "type": "boolean" },
    { "name": "Итог", "type": "string" },
    { "name": "РезультатJSON", "type": "string" },
    { "name": "ИмяФайлаJSON", "type": "string" },
    { "name": "АдресСостояния", "type": "string" },
    { "name": "ТекстПрогресса", "type": "string" },
    { "name": "ПроцентПрогресса", "type": "decimal(5,0)" }
  ],
  "commands": [
    { "name": "ВыполнитьЗамер", "action": "ВыполнитьЗамер", "title": "Выполнить замер" },
    { "name": "СохранитьJSON", "action": "СохранитьJSON", "title": "Сохранить JSON" }
  ]
}
