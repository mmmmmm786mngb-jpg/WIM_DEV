#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Стенд проверки заполнения РегистрСведений.ИсторияСтатусаЦБДляКвалИнвестора на разработческой базе:
// генерация тестовых бумаг с версиями, прогон обработчика обновления ОбновитьДо1_5_30_0 как есть,
// его копии с замером этапов и нового алгоритма, снимок регистра для сверки.
// Тестовые объекты помечаются префиксом наименования ПрефиксСтенда().

#Область ПрограммныйИнтерфейс

// Создает тестовые бумаги, их активы и версии в РегистрСведений.ВерсииОбъектов. Версия - сериализация
// объекта, как в ВерсионированиеОбъектов.СериализоватьОбъект. Объекты пишутся в режиме загрузки.
//
// Параметры:
//  ПараметрыДанных - Структура:
//   * Облигаций - Число - число облигаций.
//   * Акций     - Число - число акций.
//   * Паев      - Число - число паев.
//   * Зерно     - Число - зерно генератора, при одном зерне данные повторяются.
//
// Возвращаемое значение:
//  Структура - Бумаг, Версий, Байт (сумма РазмерДанных), Мс.
//
Функция СоздатьДанные(Знач ПараметрыДанных) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Генератор = Новый ГенераторСлучайныхЧисел(ПараметрыДанных.Зерно);
	Итог = Новый Структура("Бумаг, Версий, Байт, Мс", 0, 0, 0, 0);

	Виды = Новый Массив;
	Виды.Добавить(Новый Структура("Вид, Количество, МаксВерсий, МаксКупонов", "Облигации", ПараметрыДанных.Облигаций, 85, 30));
	Виды.Добавить(Новый Структура("Вид, Количество, МаксВерсий, МаксКупонов", "Акции", ПараметрыДанных.Акций, 9, 0));
	Виды.Добавить(Новый Структура("Вид, Количество, МаксВерсий, МаксКупонов", "ПаиПИФ", ПараметрыДанных.Паев, 7, 0));

	Для Каждого ОписаниеВида Из Виды Цикл
		Для Номер = 1 По ОписаниеВида.Количество Цикл
			СоздатьБумагу(ОписаниеВида, Номер, Генератор, Итог);
		КонецЦикла;
	КонецЦикла;

	Итог.Мс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Возврат Итог;

КонецФункции

// Считает бумаги, которые обработает обработчик обновления (отбор как в ОбновитьДо1_5_30_0), всего
// и среди тестовых.
//
// Возвращаемое значение:
//  Структура - Всего, Тестовых, Версий (строк соединения версий с активами), Байт.
//
Функция СоставПрогона() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЦБДляКвал() +
		"ВЫБРАТЬ
		|	ВерсииОбъектов.Объект КАК Объект,
		|	ВерсииОбъектов.РазмерДанных КАК РазмерДанных,
		|	Активы.Наименование КАК Наименование
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
		|		ПО ВерсииОбъектов.Объект = Активы.Объект
		|ГДЕ
		|	ВерсииОбъектов.Объект В
		|			(ВЫБРАТЬ
		|				ВТ_ЦБДляКвал.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТ_ЦБДляКвал КАК ВТ_ЦБДляКвал)";
	РезультатЗапроса = Запрос.Выполнить();
	Строки = РезультатЗапроса.Выгрузить();

	Итог = Новый Структура("Всего, Тестовых, Версий, Байт", 0, 0, Строки.Количество(), Строки.Итог("РазмерДанных"));
	Бумаги = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Если Бумаги[Строка.Объект] = Неопределено Тогда
			Бумаги.Вставить(Строка.Объект, Истина);
			Итог.Всего = Итог.Всего + 1;
			Если СтрНачинаетсяС(Строка.Наименование, ПрефиксСтенда()) Тогда
				Итог.Тестовых = Итог.Тестовых + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Удаляет все записи регистра ИсторияСтатусаЦБДляКвалИнвестора по активам тестовых бумаг.
//
// Возвращаемое значение:
//  Число - сколько записей было удалено.
//
Функция ОчиститьРегистр() Экспорт

	Удалено = 0;
	Для Каждого Актив Из ТестовыеАктивы() Цикл
		НаборЗаписей = РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Актив.Установить(Актив);
		НаборЗаписей.Прочитать();
		Удалено = Удалено + НаборЗаписей.Количество();
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЦикла;

	Возврат Удалено;

КонецФункции

// Выполняет обработчик обновления ОбновлениеИнформационнойБазыПереопределяемый.ОбновитьДо1_5_30_0 как есть.
//
// Возвращаемое значение:
//  Число - длительность, мс.
//
Функция ПрогонОбработчика() Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбновлениеИнформационнойБазыПереопределяемый.ОбновитьДо1_5_30_0();
	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

КонецФункции

// Выполняет копию обработчика ОбновитьДо1_5_30_0 с записью в регистр и замером каждого этапа.
// Запрос, распаковка, разборы и вызов регистра повторяют обработчик; вызов
// ОбработатьИзменениеСтатусаЦБДляКвалИнвестора развернут на срез и запись, чтобы замерить их отдельно.
//
// Возвращаемое значение:
//  Структура - см. НовыеЗамеры.
//
Функция ПрогонСтарогоПоЭтапам() Экспорт

	Замеры = НовыеЗамеры();
	НачалоВсего = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаОбработчика();
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаПоОбъектам = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Замеры.Запрос = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Пока ВыборкаПоОбъектам.Следующий() Цикл

		Попытка

			ВыборкаПоВерсиям = ВыборкаПоОбъектам.Выбрать();
			Пока ВыборкаПоВерсиям.Следующий() Цикл

				Замеры.Версий = Замеры.Версий + 1;
				Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
				ВерсияОбъекта = ВыборкаПоВерсиям.ВерсияОбъекта.Получить();
				Замеры.Распаковка = Замеры.Распаковка + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

				Если ТипЗнч(ВерсияОбъекта) <> Тип("ДвоичныеДанные") Тогда
					Продолжить;
				КонецЕсли;

				Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
				Результат = ВерсионированиеОбъектов.РазборПредставленияОбъектаXML(ВерсияОбъекта, ВыборкаПоВерсиям.Объект);
				Замеры.Разбор = Замеры.Разбор + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

				Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
				ВерсияОбъекта = ВерсионированиеОбъектов.РазборВерсии(ВыборкаПоВерсиям.Объект, ВыборкаПоВерсиям.НомерВерсии);
				Замеры.РазборВерсии = Замеры.РазборВерсии + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

				// Сравнение с Истина как в обработчике: при неразобранном типе значение остается строкой.
				СтрокаПризнака = Результат.Реквизиты.Найти("ЦБДляКвалИнвестора", "НаименованиеРеквизита");
				Если СтрокаПризнака = Неопределено Или СтрокаПризнака.ЗначениеРеквизита <> Истина Тогда
					Продолжить;
				КонецЕсли;

				ЗаписатьСтатус(ВыборкаПоВерсиям.Актив, ВерсияОбъекта.ДатаИзменения, Замеры);

			КонецЦикла;

		Исключение
			Замеры.Ошибок = Замеры.Ошибок + 1;
			ЗаписьЖурналаРегистрации("СтендКвал", УровеньЖурналаРегистрации.Ошибка, , ,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Замеры.Всего = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВсего;
	Возврат Замеры;

КонецФункции

// Выполняет новый алгоритм заполнения с записью в регистр: один запрос с датой версии, одна
// распаковка версии, чтение до реквизита ЦБДляКвалИнвестора, пропуск повторного вызова для уже
// записанного дня актива.
//
// Параметры:
//  ПоЭтапам - Булево - Истина: вызов регистра развернут на срез и запись с замером каждого;
//             Ложь: вызывается РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.ОбработатьИзменениеСтатусаЦБДляКвалИнвестора,
//             как будет в рабочем коде.
//
// Возвращаемое значение:
//  Структура - см. НовыеЗамеры.
//
Функция ПрогонНового(ПоЭтапам) Экспорт

	Замеры = НовыеЗамеры();
	НачалоВсего = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаНового();
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Замеры.Запрос = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	ЗаписанныеДни = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		Замеры.Версий = Замеры.Версий + 1;
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Данные = Выборка.ВерсияОбъекта.Получить();
		Замеры.Распаковка = Замеры.Распаковка + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Продолжить;
		КонецЕсли;

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Признак = ПризнакКвалИзВерсии(Данные);
		Замеры.Разбор = Замеры.Разбор + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

		Если Признак <> Истина Или Не ЗначениеЗаполнено(Выборка.Актив) Тогда
			Продолжить;
		КонецЕсли;

		ДниАктива = ЗаписанныеДни[Выборка.Актив];
		Если ДниАктива = Неопределено Тогда
			ДниАктива = Новый Соответствие;
			ЗаписанныеДни.Вставить(Выборка.Актив, ДниАктива);
		КонецЕсли;
		ДеньВерсии = НачалоДня(Выборка.ДатаВерсии);
		Если ДниАктива[ДеньВерсии] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДниАктива.Вставить(ДеньВерсии, Истина);

		Если ПоЭтапам Тогда
			ЗаписатьСтатус(Выборка.Актив, Выборка.ДатаВерсии, Замеры);
		Иначе
			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.ОбработатьИзменениеСтатусаЦБДляКвалИнвестора(
				Выборка.Актив, Истина, Выборка.ДатаВерсии);
			Замеры.Регистр = Замеры.Регистр + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
			Замеры.ВызововРегистра = Замеры.ВызововРегистра + 1;
		КонецЕсли;

	КонецЦикла;

	Замеры.Всего = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВсего;
	Возврат Замеры;

КонецФункции

// Выполняет новый алгоритм с записью набором: дни с признаком собираются по активу в памяти, затем
// по каждому активу без записей в регистре все его записи пишутся одним набором. Для такого актива
// результат совпадает с поштучными вызовами ОбработатьИзменениеСтатусаЦБДляКвалИнвестора: при обходе
// версий по убыванию срез до каждого нового дня пуст, и запись Истина ложится на каждый день с признаком.
// Для актива, у которого в регистре уже есть записи, остается поштучный вызов метода регистра.
//
// Возвращаемое значение:
//  Структура - см. НовыеЗамеры; Срез - время запроса проверки наличия записей, Запись - время записи
//              наборов, Регистр - время поштучных вызовов для активов с записями.
//
Функция ПрогонНовогоНабором() Экспорт
	
	Замеры = НовыеЗамеры();
	НачалоВсего = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаНового();
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Замеры.Запрос = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	
	// Актив -> Массив из Дата (дата первой встреченной версии дня, порядок - по убыванию номера версии).
	ДатыПоАктивам = Новый Соответствие;
	ДниПоАктивам = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Замеры.Версий = Замеры.Версий + 1;
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Данные = Выборка.ВерсияОбъекта.Получить();
		Замеры.Распаковка = Замеры.Распаковка + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		
		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Продолжить;
		КонецЕсли;
		
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Признак = ПризнакКвалИзВерсии(Данные);
		Замеры.Разбор = Замеры.Разбор + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		
		Если Признак <> Истина Или Не ЗначениеЗаполнено(Выборка.Актив) Тогда
			Продолжить;
		КонецЕсли;
		
		ДниАктива = ДниПоАктивам[Выборка.Актив];
		Если ДниАктива = Неопределено Тогда
			ДниАктива = Новый Соответствие;
			ДниПоАктивам.Вставить(Выборка.Актив, ДниАктива);
			ДатыПоАктивам.Вставить(Выборка.Актив, Новый Массив);
		КонецЕсли;
		ДеньВерсии = НачалоДня(Выборка.ДатаВерсии);
		Если ДниАктива[ДеньВерсии] = Неопределено Тогда
			ДниАктива.Вставить(ДеньВерсии, Истина);
			ДатыПоАктивам[Выборка.Актив].Добавить(Выборка.ДатаВерсии);
		КонецЕсли;
		
	КонецЦикла;
	
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	АктивыСЗаписями = АктивыСЗаписямиВРегистре(ДатыПоАктивам);
	Замеры.Срез = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	
	Для Каждого КлючИЗначение Из ДатыПоАктивам Цикл
		
		Актив = КлючИЗначение.Ключ;
		Если АктивыСЗаписями[Актив] <> Неопределено Тогда
			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Для Каждого ДатаВерсии Из КлючИЗначение.Значение Цикл
				РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.ОбработатьИзменениеСтатусаЦБДляКвалИнвестора(
					Актив, Истина, ДатаВерсии);
				Замеры.ВызововРегистра = Замеры.ВызововРегистра + 1;
			КонецЦикла;
			Замеры.Регистр = Замеры.Регистр + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
			Продолжить;
		КонецЕсли;
		
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		// Замещение по отбору только по активу допустимо: записей по активу в регистре нет (проверено выше).
		НаборЗаписей = РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Актив.Установить(Актив);
		Для Каждого ДатаВерсии Из КлючИЗначение.Значение Цикл
			Запись = НаборЗаписей.Добавить();
			Запись.Период             = ДатаВерсии;
			Запись.Актив              = Актив;
			Запись.ЦБДляКвалИнвестора = Истина;
		КонецЦикла;
		НаборЗаписей.Записать();
		Замеры.Запись = Замеры.Запись + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		Замеры.Записей = Замеры.Записей + НаборЗаписей.Количество();
		Замеры.ВызововРегистра = Замеры.ВызововРегистра + 1;
		
	КонецЦикла;
	
	Замеры.Всего = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВсего;
	Возврат Замеры;
	
КонецФункции

// Возвращает содержимое регистра по активам тестовых бумаг для сверки прогонов.
//
// Возвращаемое значение:
//  Структура:
//   * ЧислоЗаписей - Число - записей.
//   * Записи     - Строка - отсортированные строки "идентификатор актива|день|значение" через перевод строки.
//
Функция СнимокРегистра() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ИсторияСтатуса.Актив КАК Актив,
		|	ИсторияСтатуса.Период КАК Период,
		|	ИсторияСтатуса.ЦБДляКвалИнвестора КАК ЦБДляКвалИнвестора
		|ИЗ
		|	РегистрСведений.ИсторияСтатусаЦБДляКвалИнвестора КАК ИсторияСтатуса
		|ГДЕ
		|	ИсторияСтатуса.Актив В(&Активы)";
	Запрос.УстановитьПараметр("Активы", ТестовыеАктивы());
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Список = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Строка(Выборка.Актив.УникальныйИдентификатор()) + "|"
			+ Формат(Выборка.Период, "ДФ=yyyyMMdd") + "|" + Формат(Выборка.ЦБДляКвалИнвестора, "БЛ=0; БИ=1"));
	КонецЦикла;
	Список.СортироватьПоЗначению();

	Возврат Новый Структура("ЧислоЗаписей, Записи", Список.Количество(), СтрСоединить(Список.ВыгрузитьЗначения(), Символы.ПС));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Данные

// Создает одну бумагу, ее актив и версии.
//
// Параметры:
//  ОписаниеВида - Структура - Вид (имя справочника), МаксВерсий, МаксКупонов.
//  Номер - Число - номер бумаги для наименования.
//  Генератор - ГенераторСлучайныхЧисел - источник случайных значений.
//  Итог - Структура - счетчики Бумаг, Версий, Байт, увеличиваются.
//
Процедура СоздатьБумагу(ОписаниеВида, Номер, Генератор, Итог)

	Наименование = СтрШаблон("%1 %2 %3", ПрефиксСтенда(), ОписаниеВида.Вид, Формат(Номер, "ЧЦ=4; ЧВН=; ЧГ=0"));

	Бумага = Справочники[ОписаниеВида.Вид].СоздатьЭлемент();
	Бумага.Наименование = Наименование;
	Бумага.ЦБДляКвалИнвестора = Истина;
	Если ОписаниеВида.МаксКупонов > 0 Тогда
		ДобавитьКупоны(Бумага, Генератор.СлучайноеЧисло(0, ОписаниеВида.МаксКупонов));
	КонецЕсли;
	Бумага.ОбменДанными.Загрузка = Истина;
	Бумага.Записать();

	Актив = Справочники.Активы.СоздатьЭлемент();
	Актив.Наименование = Наименование;
	Актив.Объект = Бумага.Ссылка;
	Актив.ОбменДанными.Загрузка = Истина;
	Актив.Записать();

	ЧислоВерсий = Генератор.СлучайноеЧисло(1, ОписаниеВида.МаксВерсий);
	НомерВключения = Генератор.СлучайноеЧисло(1, Макс(1, Окр(ЧислоВерсий * 0.35)));
	ДатаВерсии = Дата(2024, 1, 1) + Генератор.СлучайноеЧисло(0, 300) * 86400 + 10 * 3600;

	НаборЗаписей = РегистрыСведений.ВерсииОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Бумага.Ссылка);

	Для НомерВерсии = 1 По ЧислоВерсий Цикл

		Если НомерВерсии > 1 Тогда
			ДатаВерсии = СледующаяДатаВерсии(ДатаВерсии, Генератор);
		КонецЕсли;
		Бумага.ЦБДляКвалИнвестора = НомерВерсии >= НомерВключения И Генератор.СлучайноеЧисло(1, 100) > 3;
		Если ОписаниеВида.МаксКупонов > 0 И Генератор.СлучайноеЧисло(1, 100) <= 10 Тогда
			ДобавитьКупоны(Бумага, 1);
		КонецЕсли;

		ДанныеВерсии = ВерсионированиеОбъектов.СериализоватьОбъект(Бумага);

		Запись = НаборЗаписей.Добавить();
		Запись.Объект           = Бумага.Ссылка;
		Запись.НомерВерсии      = НомерВерсии;
		Запись.ДатаВерсии       = ДатаВерсии;
		Запись.ВерсияОбъекта    = Новый ХранилищеЗначения(ДанныеВерсии, Новый СжатиеДанных(9));
		Запись.РазмерДанных     = ДанныеВерсии.Размер();
		Запись.ЕстьДанныеВерсии = Истина;

		Итог.Версий = Итог.Версий + 1;
		Итог.Байт = Итог.Байт + Запись.РазмерДанных;

	КонецЦикла;

	НаборЗаписей.Записать();
	Итог.Бумаг = Итог.Бумаг + 1;

КонецПроцедуры

// Возвращает дату следующей версии: в 28% случаев тот же день (так в выборке тестовой базы
// повторялись дни у версий с признаком), иначе через 1-15 дней.
//
// Параметры:
//  ДатаВерсии - Дата - дата предыдущей версии.
//  Генератор - ГенераторСлучайныхЧисел - источник случайных значений.
//
// Возвращаемое значение:
//  Дата - дата следующей версии.
//
Функция СледующаяДатаВерсии(ДатаВерсии, Генератор)

	Если Генератор.СлучайноеЧисло(1, 100) <= 28 Тогда
		Возврат ДатаВерсии + Генератор.СлучайноеЧисло(1, 30) * 60;
	КонецЕсли;

	Возврат НачалоДня(ДатаВерсии) + Генератор.СлучайноеЧисло(1, 15) * 86400 + Генератор.СлучайноеЧисло(9, 18) * 3600;

КонецФункции

// Добавляет строки купонов облигации, чтобы размер версии был близок к рабочему.
//
// Параметры:
//  Бумага - СправочникОбъект.Облигации - облигация.
//  Количество - Число - сколько строк добавить.
//
Процедура ДобавитьКупоны(Бумага, Количество)

	Для Индекс = 1 По Количество Цикл
		НомерКупона = Бумага.Купоны.Количество() + 1;
		НачалоПериода = Дата(2022, 1, 1) + (НомерКупона - 1) * 182 * 86400;

		Купон = Бумага.Купоны.Добавить();
		Купон.ДатаНачалаКупонногоПериода      = НачалоПериода;
		Купон.ДатаОкончанияКупонногоПериода   = НачалоПериода + 182 * 86400;
		Купон.КолДнейВКупонномПериоде         = 182;
		Купон.РазмерДоходаВПроцентах          = 8.5 + НомерКупона / 100;
		Купон.РазмерДоходаВРублях             = 42.38 + НомерКупона / 100;
		Купон.ДатаФиксацииРеестраВладельцевЦБ = НачалоПериода + 181 * 86400;
		Купон.ДатаВыплатыКупонногоДохода      = НачалоПериода + 182 * 86400;
		Купон.НомерКупонногоПериода           = НомерКупона;
		Купон.ХэшСтроки                       = Строка(Новый УникальныйИдентификатор);
		Купон.РасчетКупонаОтПроцента          = Истина;
		Купон.ДатаОбъявления                  = НачалоПериода;
		Купон.СуммаДоходаВВалютеПогашения     = 42.38 + НомерКупона / 100;
	КонецЦикла;

КонецПроцедуры

// Возвращает активы тестовых бумаг.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Активы - активы с наименованием, начинающимся с префикса стенда.
//
Функция ТестовыеАктивы()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Активы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Активы КАК Активы
		|ГДЕ
		|	Активы.Наименование ПОДОБНО &Шаблон";
	Запрос.УстановитьПараметр("Шаблон", ПрефиксСтенда() + " %");
	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Возвращает префикс наименования тестовых объектов стенда.
//
// Возвращаемое значение:
//  Строка - префикс.
//
Функция ПрефиксСтенда()

	Возврат "T_KVAL";

КонецФункции

#КонецОбласти

#Область Алгоритмы

// Повторяет РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.ОбработатьИзменениеСтатусаЦБДляКвалИнвестора
// для значения Истина, замеряя срез последних и запись отдельно.
//
// Параметры:
//  Актив - СправочникСсылка.Активы - актив бумаги.
//  ДатаИзменения - Дата - дата версии.
//  Замеры - Структура - см. НовыеЗамеры, увеличиваются Срез, Запись, ВызововРегистра, Записей.
//
Процедура ЗаписатьСтатус(Актив, ДатаИзменения, Замеры)

	Если Не ЗначениеЗаполнено(Актив) Тогда
		Возврат;
	КонецЕсли;
	Замеры.ВызововРегистра = Замеры.ВызововРегистра + 1;

	Если ЗначениеЗаполнено(ДатаИзменения) Тогда
		Период = ДатаИзменения;
	Иначе
		Период = ТекущаяДатаСеанса();
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СрезИстории = РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.СрезПоследних(Период, Новый Структура("Актив", Актив));
	Если СрезИстории.Количество() > 0 Тогда
		СтароеЦБДляКвалИнвестора = СрезИстории[0].ЦБДляКвалИнвестора;
	Иначе
		СтароеЦБДляКвалИнвестора = Ложь;
	КонецЕсли;
	Замеры.Срез = Замеры.Срез + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Если СтароеЦБДляКвалИнвестора = Истина Тогда
		Возврат;
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РегистрИстории = РегистрыСведений.ИсторияСтатусаЦБДляКвалИнвестора.СоздатьМенеджерЗаписи();
	РегистрИстории.Период             = Период;
	РегистрИстории.Актив              = Актив;
	РегистрИстории.ЦБДляКвалИнвестора = Истина;
	РегистрИстории.Записать();
	Замеры.Запись = Замеры.Запись + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Замеры.Записей = Замеры.Записей + 1;

КонецПроцедуры

// Выбирает активы, по которым в регистре ИсторияСтатусаЦБДляКвалИнвестора уже есть записи.
//
// Параметры:
//  ДатыПоАктивам - Соответствие - ключи - СправочникСсылка.Активы.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.Активы, значение Истина.
//
Функция АктивыСЗаписямиВРегистре(ДатыПоАктивам)
	
	Активы = Новый Массив;
	Для Каждого КлючИЗначение Из ДатыПоАктивам Цикл
		Активы.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИсторияСтатуса.Актив КАК Актив
		|ИЗ
		|	РегистрСведений.ИсторияСтатусаЦБДляКвалИнвестора КАК ИсторияСтатуса
		|ГДЕ
		|	ИсторияСтатуса.Актив В(&Активы)";
	Запрос.УстановитьПараметр("Активы", Активы);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	АктивыСЗаписями = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		АктивыСЗаписями.Вставить(Выборка.Актив, Истина);
	КонецЦикла;
	
	Возврат АктивыСЗаписями;
	
КонецФункции

// Читает значение реквизита ЦБДляКвалИнвестора из версии объекта (ЗаписатьXML в FastInfoset).
// Чтение прекращается на найденном элементе второго уровня, табличные части после него не читаются.
//
// Параметры:
//  Данные - ДвоичныеДанные - версия объекта из РегистрСведений.ВерсииОбъектов.
//
// Возвращаемое значение:
//  Булево, Неопределено - значение признака; Неопределено, если элемента нет или значение не разобрано.
//
Функция ПризнакКвалИзВерсии(Данные)

	Чтение = Новый ЧтениеFastInfoset;
	Чтение.УстановитьДвоичныеДанные(Данные);

	Признак = Неопределено;
	Уровень = 0;
	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Уровень = Уровень - 1;
			Продолжить;
		ИначеЕсли Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;

		Уровень = Уровень + 1;
		Если Уровень = 2 И Чтение.Имя = "ЦБДляКвалИнвестора" Тогда
			Если Чтение.Прочитать() И Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Признак = Чтение.Значение = "true" Или Чтение.Значение = "1";
			КонецЕсли;
			Прервать;
		КонецЕсли;

	КонецЦикла;
	Чтение.Закрыть();

	Возврат Признак;

КонецФункции

// Создает структуру замеров прогона, все значения в миллисекундах или штуках.
//
// Возвращаемое значение:
//  Структура - Всего, Запрос, Распаковка, Разбор, РазборВерсии, Срез, Запись, Регистр (вызов метода
//              регистра целиком), Версий, ВызововРегистра, Записей, Ошибок.
//
Функция НовыеЗамеры()

	Замеры = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Всего,Запрос,Распаковка,Разбор,РазборВерсии,Срез,Запись,Регистр,Версий,ВызововРегистра,Записей,Ошибок", ",") Цикл
		Замеры.Вставить(Имя, 0);
	КонецЦикла;
	Возврат Замеры;

КонецФункции

// Возвращает текст запроса обработчика ОбновитьДо1_5_30_0 без изменений.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаОбработчика()

	Возврат
		"ВЫБРАТЬ
		|	Акции.Ссылка КАК Ссылка,
		|	Акции.ЦБДляКвалИнвестора КАК ЦБДляКвалИнвестора
		|ПОМЕСТИТЬ ВТ_ЦБСоСтатусомЦБДляКвалИнвестора
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.ПометкаУдаления = ЛОЖЬ
		|	И Акции.ЦБДляКвалИнвестора = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Векселя.Ссылка,
		|	Векселя.ЦБДляКвалИнвестора
		|ИЗ
		|	Справочник.Векселя КАК Векселя
		|ГДЕ
		|	Векселя.ПометкаУдаления = ЛОЖЬ
		|	И Векселя.ЦБДляКвалИнвестора = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИпотечныеСертификатыУчастия.Ссылка,
		|	ИпотечныеСертификатыУчастия.ЦБДляКвалИнвестора
		|ИЗ
		|	Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|ГДЕ
		|	ИпотечныеСертификатыУчастия.ПометкаУдаления = ЛОЖЬ
		|	И ИпотечныеСертификатыУчастия.ЦБДляКвалИнвестора = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Облигации.Ссылка,
		|	Облигации.ЦБДляКвалИнвестора
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|ГДЕ
		|	Облигации.ПометкаУдаления = ЛОЖЬ
		|	И Облигации.ЦБДляКвалИнвестора = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПаиПИФ.Ссылка,
		|	ПаиПИФ.ЦБДляКвалИнвестора
		|ИЗ
		|	Справочник.ПаиПИФ КАК ПаиПИФ
		|ГДЕ
		|	ПаиПИФ.ПометкаУдаления = ЛОЖЬ
		|	И ПаиПИФ.ЦБДляКвалИнвестора = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВерсииОбъектов.Объект КАК Объект,
		|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии,
		|	ВерсииОбъектов.ВерсияОбъекта КАК ВерсияОбъекта,
		|	Активы.Ссылка КАК Актив
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
		|		ПО ВерсииОбъектов.Объект = Активы.Объект
		|ГДЕ
		|	ВерсииОбъектов.Объект В
		|			(ВЫБРАТЬ
		|				ВТ_ЦБСоСтатусомЦБДляКвалИнвестора.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТ_ЦБСоСтатусомЦБДляКвалИнвестора КАК ВТ_ЦБСоСтатусомЦБДляКвалИнвестора)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Объект,
		|	НомерВерсии УБЫВ
		|ИТОГИ ПО
		|	Объект";

КонецФункции

// Возвращает текст запроса нового алгоритма: тот же отбор бумаг, дата версии из регистра версий,
// без итогов.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаНового()

	Возврат ТекстЗапросаЦБДляКвал() +
		"ВЫБРАТЬ
		|	ВерсииОбъектов.Объект КАК Объект,
		|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии,
		|	ВерсииОбъектов.ВерсияОбъекта КАК ВерсияОбъекта,
		|	ВерсииОбъектов.ДатаВерсии КАК ДатаВерсии,
		|	Активы.Ссылка КАК Актив
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
		|		ПО ВерсииОбъектов.Объект = Активы.Объект
		|ГДЕ
		|	ВерсииОбъектов.Объект В
		|			(ВЫБРАТЬ
		|				ВТ_ЦБДляКвал.Ссылка КАК Ссылка
		|			ИЗ
		|				ВТ_ЦБДляКвал КАК ВТ_ЦБДляКвал)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Объект,
		|	НомерВерсии УБЫВ";

КонецФункции

// Возвращает первый пакет запроса: временная таблица ВТ_ЦБДляКвал со ссылками бумаг по условию
// обработчика обновления. Текст заканчивается разделителем пакетов.
//
// Возвращаемое значение:
//  Строка - текст пакета запроса.
//
Функция ТекстЗапросаЦБДляКвал()

	Возврат
		"ВЫБРАТЬ
		|	СпрОблигации.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ЦБДляКвал
		|ИЗ
		|	Справочник.Облигации КАК СпрОблигации
		|ГДЕ
		|	СпрОблигации.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрОблигации.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрАкции.Ссылка
		|ИЗ
		|	Справочник.Акции КАК СпрАкции
		|ГДЕ
		|	СпрАкции.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрАкции.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрВекселя.Ссылка
		|ИЗ
		|	Справочник.Векселя КАК СпрВекселя
		|ГДЕ
		|	СпрВекселя.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрВекселя.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрИСУ.Ссылка
		|ИЗ
		|	Справочник.ИпотечныеСертификатыУчастия КАК СпрИСУ
		|ГДЕ
		|	СпрИСУ.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрИСУ.ПометкаУдаления = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СпрПаиПИФ.Ссылка
		|ИЗ
		|	Справочник.ПаиПИФ КАК СпрПаиПИФ
		|ГДЕ
		|	СпрПаиПИФ.ЦБДляКвалИнвестора = ИСТИНА
		|	И СпрПаиПИФ.ПометкаУдаления = ЛОЖЬ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";

КонецФункции

#КонецОбласти

#КонецОбласти

