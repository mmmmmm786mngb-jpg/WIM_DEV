				<Property name="Строки">
					<Value xsi:type="Array">
						<Value xsi:type="Structure">
							<Property name="Имя">
								<Value xsi:type="xs:string">Котировки_олд</Value>
							</Property>
							<Property name="ТекстЗапроса">
								<Value xsi:type="xs:string">ВЫБРАТЬ РАЗРЕШЕННЫЕ  // ИКФ (2026-08-07): IMAPPS-38656
		СпрАктивы.Ссылка как Актив
	ПОМЕСТИТЬ втАктивы
	ИЗ Справочник.Активы как СпрАктивы
	ГДЕ СпрАктивы.Ссылка В (&amp;СписокЦБ)
	ИНДЕКСИРОВАТЬ ПО
		Актив
	;
	
	ВЫБРАТЬ
		КотировкиЦБНаБиржеСрезПоследних.Актив КАК Актив,
		КотировкиЦБНаБиржеСрезПоследних.Валюта КАК Валюта,
		МАКСИМУМ(КотировкиЦБНаБиржеСрезПоследних.МинимальнаяЦена) КАК МинимальнаяЦена,
		МАКСИМУМ(КотировкиЦБНаБиржеСрезПоследних.МаксимальнаяЦена) КАК МаксимальнаяЦена
	ПОМЕСТИТЬ ВТ_КотировкиЦБ
	ИЗ
		РегистрСведений.КотировкиЦБНаБирже.СрезПоследних(
				&amp;Дата,
				Актив В (ВЫБРАТЬ Актив ИЗ втАктивы)  //Актив В (&amp;СписокЦБ)  // ИКФ (2026-08-07): IMAPPS-38656
					И Биржа В (&amp;СписокБирж)) КАК КотировкиЦБНаБиржеСрезПоследних
	
	СГРУППИРОВАТЬ ПО
		КотировкиЦБНаБиржеСрезПоследних.Актив,
		КотировкиЦБНаБиржеСрезПоследних.Валюта
	
	ИНДЕКСИРОВАТЬ ПО
		Актив,
		Валюта
	;
	
	////////////////////////////////////////////////////////////////////////////////
	ВЫБРАТЬ
		Котировки.Актив,
		Котировки.Валюта,
		Котировки.Котировка,
		Котировки.Расчетная,
		Котировки.СредневзвешеннаяЦена,
		ЕСТЬNULL(ВТ_КотировкиЦБ.МинимальнаяЦена, Котировки.МинимальнаяЦена) КАК МинимальнаяЦена,
		ЕСТЬNULL(ВТ_КотировкиЦБ.МаксимальнаяЦена, Котировки.МаксимальнаяЦена) КАК МаксимальнаяЦена,
		Котировки.ЦенаЗакрытия,
		Котировки.ЭкспертнаяЦена,
		Котировки.ЦенаСпроса,
		Котировки.Биржа,
		Котировки.ОбъемТоргов,
		Котировки.УровеньКотировальногоЛиста,
		ВЫБОР
			КОГДА Котировки.ДатаОпределения = &amp;ПустаяДата
				ТОГДА Котировки.Период
			ИНАЧЕ Котировки.ДатаОпределения
		КОНЕЦ КАК ДатаОпределения
	ПОМЕСТИТЬ АктуальныеКотировки
	ИЗ
		РегистрСведений.ЗафиксированныеКотировкиЦБ.СрезПоследних(
				&amp;Дата,
				Актив В (ВЫБРАТЬ Актив ИЗ втАктивы)  //Актив В (&amp;СписокЦБ)  // ИКФ (2026-08-07): IMAPPS-38656
					И ДоговорДУ = &amp;ДоговорДУ
					И Расчетная = ЛОЖЬ) КАК Котировки
			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КотировкиЦБ КАК ВТ_КотировкиЦБ
			ПО Котировки.Актив = ВТ_КотировкиЦБ.Актив
				И Котировки.Валюта = ВТ_КотировкиЦБ.Валюта
	
	ИНДЕКСИРОВАТЬ ПО
		Котировки.Актив,
		ДатаОпределения;
		
	ВЫБРАТЬ
		Котировки.Актив,
		Котировки.Валюта,
		Котировки.Котировка,
		Котировки.Расчетная,
		ЕСТЬNULL(ВТ_КотировкиЦБ.МинимальнаяЦена, Котировки.МинимальнаяЦена) КАК МинимальнаяЦена,
		ЕСТЬNULL(ВТ_КотировкиЦБ.МаксимальнаяЦена, Котировки.МаксимальнаяЦена) КАК МаксимальнаяЦена,
		Котировки.Биржа,
		ВЫБОР
			КОГДА Котировки.ДатаОпределения = &amp;ПустаяДата
				ТОГДА Котировки.Период
			ИНАЧЕ Котировки.ДатаОпределения
		КОНЕЦ КАК ДатаОпределения
	ПОМЕСТИТЬ АктуальныеКотировки_БУ
	ИЗ
		РегистрСведений.ЗафиксированныеКотировкиЦБ_БУ.СрезПоследних(
