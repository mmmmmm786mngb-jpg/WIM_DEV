												<Value xmlns:d13p1="http://v8.1c.ru/8.1/data/enterprise/current-config" xsi:type="d13p1:EnumRef.ВидыОперацийПоручение">Перевод</Value>
											</Property>
											<Property name="ТипКонтейнера">
												<Value xsi:type="xs:decimal">0</Value>
											</Property>
											<Property name="Контейнер">
												<Value xmlns:d13p1="http://v8.1c.ru/8.1/data/enterprise/current-config" xsi:type="d13p1:EnumRef.ВидыОперацийПоручение">Перевод</Value>
											</Property>
											<Property name="Использовать">
												<Value xsi:type="xs:boolean">true</Value>
