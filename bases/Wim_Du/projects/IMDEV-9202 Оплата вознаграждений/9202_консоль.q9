					ДоговорДУ = &amp;ДоговорДУ
					И Расчетная = ЛОЖЬ) КАК Котировки
			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КотировкиЦБ КАК ВТ_КотировкиЦБ
			ПО Котировки.Актив = ВТ_КотировкиЦБ.Актив
				И Котировки.Валюта = ВТ_КотировкиЦБ.Валюта
	внутреннее соединение втАктивы КАК втАктивы ПО Котировки.Актив = втАктивы.Актив
	ИНДЕКСИРОВАТЬ ПО
		Котировки.Актив,
		ДатаОпределения;
		
	ВЫБРАТЬ
		Котировки.Актив,
		Котировки.Валюта,
		Котировки.Котировка,
		Котировки.Расчетная,
