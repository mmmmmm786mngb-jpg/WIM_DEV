        СтрокаДокумента.Вставить("ДатаПоступления", Формат(Выборка.ДатаПоступления, "ДФ=yyyy-MM-ddTHH:mm:ss"));
        СтрокаДокумента.Вставить("НомерВходящий", СокрЛП(Строка(Выборка.НомерВходящий)));
        СтрокаДокумента.Вставить("ДатаВходящая", Формат(Выборка.ДатаВходящая, "ДФ=yyyy-MM-dd"));
        СтрокаДокумента.Вставить("Сумма", Выборка.Сумма);
        СтрокаДокумента.Вставить("Проведен", Выборка.Проведен);
        СтрокаДокумента.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
        СтрокаДокумента.Вставить("ВидОперации", Строка(Выборка.ВидОперации));
        СтрокаДокумента.Вставить("ДоговорДУКод", СокрЛП(Строка(Выборка.ДоговорДУКод)));
        СтрокаДокумента.Вставить("ДоговорДУ", СокрЛП(Строка(Выборка.ДоговорДУНаименование)));
        СтрокаДокумента.Вставить("ПоручениеНомер", СокрЛП(Строка(Выборка.ПоручениеНомер)));
        СтрокаДокумента.Вставить("ПоручениеДата", Формат(Выборка.ПоручениеДата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
        СтрокаДокумента.Вставить("ПоручениеВидОперации", Строка(Выборка.ПоручениеВидОперации));
        СтрокаДокумента.Вставить("СтатусПоручения", Строка(
            РегистрыСведений.ИсторияСтатусовОбъектов.ПолучитьАктуальныйСтатусОбъекта(Выборка.Поручение)));
        СтрокаДокумента.Вставить("Контрагент", СокрЛП(Строка(Выборка.Контрагент)));
        СтрокаДокумента.Вставить("СчетКонтрагента", СокрЛП(Строка(Выборка.СчетКонтрагента)));
        СтрокаДокумента.Вставить("ДоговорКонтрагента", СокрЛП(Строка(Выборка.ДоговорКонтрагента)));
        СтрокаДокумента.Вставить("АналитическийСчетКод", СокрЛП(Строка(Выборка.АналитическийСчетКод)));
        СтрокаДокумента.Вставить("АналитическийСчетПлательщикКод", СокрЛП(Строка(Выборка.АналитическийСчетПлательщикКод)));
        СтрокаДокумента.Вставить("СтатьяДДС", СокрЛП(Строка(Выборка.СтатьяДДС)));
        СтрокаДокумента.Вставить("НазначениеПлатежа", СокрЛП(Строка(Выборка.НазначениеПлатежа)));
        СтрокаДокумента.Вставить("СчетДоговораДУ", СокрЛП(Строка(Выборка.СчетДоговораДУ)));

        Результат.Документы.Добавить(СтрокаДокумента);

    КонецЦикла;

    Результат.Количество = Результат.Документы.Количество();

    Возврат Результат;

КонецФункции

Функция УдалитьСсылкиПоследовательно(Ссылки)

    Итог = Новый Структура("Удалено, Ошибок, ТекстОшибок", 0, 0, "");
    СтрокиОшибок = Новый Массив;

    Для Каждого СсылкаДокумента Из Ссылки Цикл

        Попытка
            УдалитьОдноПоступлениеИВернутьСтатусПоручения(СсылкаДокумента);
            Итог.Удалено = Итог.Удалено + 1;
        Исключение
            Итог.Ошибок = Итог.Ошибок + 1;
            Если СтрокиОшибок.Количество() < 20 Тогда
                СтрокиОшибок.Добавить(Строка(СсылкаДокумента) + ": " + ОписаниеОшибки());
            КонецЕсли;
        КонецПопытки;

    КонецЦикла;

    Итог.ТекстОшибок = СтрСоединить(СтрокиОшибок, Символы.ПС);

    Возврат Итог;

КонецФункции

// IMDEV-9202: Отмена проведения, удаление поступления, статус поручения-основания = Новый.
// Отмена проведения без ОбменДанными.Загрузка: платформа запрещает проведение/отмену в режиме загрузки.
// При отмене TM-3440 ставит поручению ОтклоненаВыписка — сразу после отмены и после удаления
// явно возвращаем статус Новый. Удаление с Загрузка=Истина, чтобы не повторить каскад статусов.
// После отмены проведения ПриЗаписи/подписки меняют DataVersion в базе, поэтому объект
// читается заново — иначе Удалить() падает с "данные объекта модифицированы".
//
Процедура УдалитьОдноПоступлениеИВернутьСтатусПоручения(СсылкаДокумента)

    ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
    Если ОбъектДокумента = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ПоручениеОснование = Неопределено;
    Если ТипЗнч(ОбъектДокумента.ПлановаяПозиция) = Тип("ДокументСсылка.Поручение") Тогда
        ПоручениеОснование = ОбъектДокумента.ПлановаяПозиция;
    ИначеЕсли ТипЗнч(ОбъектДокумента.ДокументОснование) = Тип("ДокументСсылка.Поручение") Тогда
        ПоручениеОснование = ОбъектДокумента.ДокументОснование;
    КонецЕсли;

    Если ОбъектДокумента.Проведен Тогда
        ОбъектДокумента.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        ВернутьСтатусПорученияНовый(ПоручениеОснование);
        ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
        Если ОбъектДокумента = Неопределено Тогда
            ВернутьСтатусПорученияНовый(ПоручениеОснование);
            Возврат;
        КонецЕсли;
    КонецЕсли;

    ОбъектДокумента.ОбменДанными.Загрузка = Истина;
    ОбъектДокумента.Удалить();

    ВернутьСтатусПорученияНовый(ПоручениеОснование);

КонецПроцедуры

// Описание: Пишет в историю статусов значение Новый для поручения-основания.
//
// Параметры:
// ПоручениеОснование - ДокументСсылка.Поручение - поручение, статус которого нужно сбросить
//
Процедура ВернутьСтатусПорученияНовый(ПоручениеОснование)

    Если Не ЗначениеЗаполнено(ПоручениеОснование) Тогда
        Возврат;
    КонецЕсли;

    РегистрыСведений.ИсторияСтатусовОбъектов.СохранитьТекущийСтатусОбъекта(
        ПоручениеОснование,
        Перечисления.СтатусыОбъектов.Новый);

КонецПроцедуры

Функция УдалитьСсылкиПараллельно(Ссылки, ДополнительнаяОбработкаСсылка, КоличествоПотоков, РазмерЧанка)

    Итог = Новый Структура("Удалено, Ошибок, ТекстОшибок", 0, 0, "");
    СтрокиОшибок = Новый Массив;

    Всего = Ссылки.Количество();
    Активные = Новый Массив;
    НомерПачки = 0;
    Индекс = 0;
    ИдентификаторФормы = Новый УникальныйИдентификатор;

    Пока Индекс < Всего Или Активные.Количество() > 0 Цикл

        Пока Активные.Количество() < КоличествоПотоков И Индекс < Всего Цикл

            РазмерТекущейПачки = Мин(РазмерЧанка, Всего - Индекс);
            СсылкиПачки = Новый Массив;
            Для Смещение = 0 По РазмерТекущейПачки - 1 Цикл
                СсылкиПачки.Добавить(Ссылки[Индекс + Смещение]);
            КонецЦикла;
            Индекс = Индекс + РазмерТекущейПачки;
            НомерПачки = НомерПачки + 1;

            ПараметрыПачки = Новый Структура("Ссылки, НомерПачки", СсылкиПачки, НомерПачки);

            ПараметрыМетода = Новый Структура;
            ПараметрыМетода.Вставить("ИмяМетода", "УдалитьПачкуПоступленийВФоне");
            ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Истина);
            ПараметрыМетода.Вставить("ИмяОбработки", "");
            ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
            ПараметрыМетода.Вставить("ПараметрыВыполнения", XMLСтрока(Новый ХранилищеЗначения(ПараметрыПачки)));

            ПараметрыФона = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
            ПараметрыФона.ЗапуститьВФоне = Истина;
            ПараметрыФона.ОжидатьЗавершение = 0;
            ПараметрыФона.НаименованиеФоновогоЗадания =
                "IMDEV-9202 удаление поступлений, пачка " + Формат(НомерПачки, "ЧГ=0");

            Контекст = ДлительныеОперации.ВыполнитьВФоне(
                "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
                ПараметрыМетода,
                ПараметрыФона);

            Активные.Добавить(Новый Структура("Контекст, Количество", Контекст, СсылкиПачки.Количество()));

        КонецЦикла;

        Если Активные.Количество() > 0
            И ЗначениеЗаполнено(Активные[0].Контекст.ИдентификаторЗадания) Тогда
            Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
                Активные[0].Контекст.ИдентификаторЗадания);
            Если Задание <> Неопределено Тогда
                Попытка
                    Задание.ОжидатьЗавершения(0.5);
                Исключение
                    // Статус ниже через ОперацияВыполнена
                КонецПопытки;
            КонецЕсли;
        КонецЕсли;

        ИндексАктивных = Активные.ВГраница();
        Пока ИндексАктивных >= 0 Цикл

            Описание = Активные[ИндексАктивных];
            Контекст = Описание.Контекст;

            Если ЗначениеЗаполнено(Контекст.ИдентификаторЗадания) Тогда
                СтатусЗадания = ДлительныеОперации.ОперацияВыполнена(Контекст.ИдентификаторЗадания, Ложь);
                Если СтатусЗадания.Статус = "Выполняется" Тогда
                    ИндексАктивных = ИндексАктивных - 1;
                    Продолжить;
                КонецЕсли;
            КонецЕсли;

            ИтогПачки = Неопределено;
            Если ЗначениеЗаполнено(Контекст.АдресРезультата) Тогда
                ЗначениеРезультата = ПолучитьИзВременногоХранилища(Контекст.АдресРезультата);
                Если ТипЗнч(ЗначениеРезультата) = Тип("Строка") И Не ПустаяСтрока(ЗначениеРезультата) Тогда
                    Попытка
                        ИтогПачки = XMLЗначение(Тип("ХранилищеЗначения"), ЗначениеРезультата).Получить();
                    Исключение
                        ИтогПачки = Неопределено;
                    КонецПопытки;
                ИначеЕсли ТипЗнч(ЗначениеРезультата) = Тип("Структура") Тогда
                    ИтогПачки = ЗначениеРезультата;
                КонецЕсли;
            КонецЕсли;

            Если ТипЗнч(ИтогПачки) = Тип("Структура") Тогда
                Итог.Удалено = Итог.Удалено + ИтогПачки.Удалено;
                Итог.Ошибок = Итог.Ошибок + ИтогПачки.Ошибок;
                Если Не ПустаяСтрока(ИтогПачки.ТекстОшибок) И СтрокиОшибок.Количество() < 20 Тогда
                    СтрокиОшибок.Добавить(ИтогПачки.ТекстОшибок);
                КонецЕсли;
            Иначе
                Итог.Ошибок = Итог.Ошибок + Описание.Количество;
            КонецЕсли;

            Активные.Удалить(ИндексАктивных);
            ИндексАктивных = ИндексАктивных - 1;

        КонецЦикла;

    КонецЦикла;

    Итог.ТекстОшибок = СтрСоединить(СтрокиОшибок, Символы.ПС);

    Возврат Итог;

КонецФункции

Функция НоваяТаблицаРасхождений()

    ТаблицаРасхождений = Новый ТаблицаЗначений;
    ТаблицаРасхождений.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(80)));
