#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Описание: Сведения для подключения в справочник дополнительных отчетов и обработок.
// Безопасный режим выключен: обработка снимает проведение и удаляет документы.
//
// Возвращаемое значение:
// Структура - вид, версия, команды
//
Функция СведенияОВнешнейОбработке() Экспорт

    Структура = Новый Структура;
    Структура.Вставить("Вид", ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка());
    Структура.Вставить("Наименование", "IMDEV-9202 тест: сброс поступлений РДУ");
    Структура.Вставить("Версия", "1.16");
    Структура.Вставить("БезопасныйРежим", Ложь);
    Структура.Вставить("Информация",
        "Подсчет, снимок и удаление поступлений, созданных обработкой ПоступленияНаРасчетныйСчет_РозничноеДУ."
        + " Отбор: пул Розничное ДУ, основание=плановая позиция, дата=входящая+9ч."
        + " После удаления статус поручения-основания устанавливается в Новый.");

    Команды = Новый ТаблицаЗначений;
    Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
    Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
    Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
    Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
    Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

    НоваяКоманда = Команды.Добавить();
    НоваяКоманда.Представление = "IMDEV-9202 тест: сброс поступлений РДУ";
    НоваяКоманда.Идентификатор = "внТестСбросПоступленийРДУ";
    НоваяКоманда.Использование = "ОткрытиеФормы";
    НоваяКоманда.ПоказыватьОповещение = Ложь;

    Структура.Вставить("Команды", Команды);

    Возврат Структура;

КонецФункции

// Описание: Статистика поступлений РДУ по дням периода (все дни, включая нули).
// Дополнительно: уникальные комментарии поручений-оснований и число расхождений ДоговорКонтрагента.
//
// Параметры:
// ДатаНачала - Дата - начало периода
// ДатаОкончания - Дата - конец периода
// ТолькоПеревод - Булево - Истина: только вид СписаниеСБрокерскогоСчета и поручение Перевод
// Пул - СправочникСсылка.Пул - пул договоров; если не заполнен, ищется Розничное ДУ
// ЕРС - СправочникСсылка.БанковскиеСчета - счет из настроек обработки РДУ; пустая ссылка = не отбирать
//
// Возвращаемое значение:
// ТаблицаЗначений - Дата, Количество, КоличествоПроведенных, Сумма,
//   КомментарииПоручений, РасхожденийДоговорКонтрагента
//
Функция ПолучитьСтатистикуПоДням(ДатаНачала, ДатаОкончания, ТолькоПеревод, Пул = Неопределено, ЕРС = Неопределено) Экспорт

    ТаблицаДней = Новый ТаблицаЗначений;
    ТаблицаДней.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
    ТаблицаДней.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
    ТаблицаДней.Колонки.Добавить("КоличествоПроведенных", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
    ТаблицаДней.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
    ТаблицаДней.Колонки.Добавить("КомментарииПоручений", Новый ОписаниеТипов("Строка"));
    ТаблицаДней.Колонки.Добавить("РасхожденийДоговорКонтрагента",
        Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));

    Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
        Возврат ТаблицаДней;
    КонецЕсли;

    Отбор = ПолучитьОтборПоступленийРДУ(Пул, ЕРС);
    Если Не ЗначениеЗаполнено(Отбор.Пул) Тогда
        Возврат ТаблицаДней;
    КонецЕсли;

    НачалоПериода = НачалоДня(ДатаНачала);
    КонецПериода = КонецДня(ДатаОкончания);
    Если НачалоПериода > КонецПериода Тогда
        Возврат ТаблицаДней;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	НАЧАЛОПЕРИОДА(Поступление.Дата, ДЕНЬ) КАК Дата,
    |	КОЛИЧЕСТВО(Поступление.Ссылка) КАК Количество,
    |	СУММА(ВЫБОР
    |			КОГДА Поступление.Проведен
    |				ТОГДА 1
    |			ИНАЧЕ 0
    |		КОНЕЦ) КАК КоличествоПроведенных,
    |	СУММА(ВЫБОР
    |			КОГДА Поступление.Проведен
    |				ТОГДА Поступление.СуммаДокумента
    |			ИНАЧЕ 0
    |		КОНЕЦ) КАК Сумма,
    |	СУММА(ВЫБОР
    |			КОГДА Поступление.ДоговорКонтрагента
    |					<> ВЫРАЗИТЬ(Поступление.ПлановаяПозиция КАК Документ.Поручение).ДоговорКонтрагента
    |				ТОГДА 1
    |			ИНАЧЕ 0
    |		КОНЕЦ) КАК РасхожденийДоговорКонтрагента
    |ИЗ
    |	Документ.ПоступлениеНаРасчетныйСчет КАК Поступление
    |ГДЕ
    |	" + ТекстУсловияОтбораПоступлений() + "
    |
    |СГРУППИРОВАТЬ ПО
    |	НАЧАЛОПЕРИОДА(Поступление.Дата, ДЕНЬ)
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	НАЧАЛОПЕРИОДА(Поступление.Дата, ДЕНЬ) КАК Дата,
    |	ВЫРАЗИТЬ(Поступление.ПлановаяПозиция КАК Документ.Поручение).Комментарий КАК Комментарий,
    |	КОЛИЧЕСТВО(Поступление.Ссылка) КАК Количество
    |ИЗ
    |	Документ.ПоступлениеНаРасчетныйСчет КАК Поступление
    |ГДЕ
    |	" + ТекстУсловияОтбораПоступлений() + "
    |
    |СГРУППИРОВАТЬ ПО
    |	НАЧАЛОПЕРИОДА(Поступление.Дата, ДЕНЬ),
    |	ВЫРАЗИТЬ(Поступление.ПлановаяПозиция КАК Документ.Поручение).Комментарий
    |
    |УПОРЯДОЧИТЬ ПО
    |	Дата,
    |	Количество УБЫВ,
    |	Комментарий";

    УстановитьПараметрыОтбораПоступлений(Запрос, НачалоПериода, КонецПериода, ТолькоПеревод, Отбор);

    Пакет = Запрос.ВыполнитьПакет();

    СоответствиеДней = Новый Соответствие;
    Выборка = Пакет[0].Выбрать();
    Пока Выборка.Следующий() Цикл
        ДанныеДня = Новый Структура(
            "Количество, КоличествоПроведенных, Сумма, РасхожденийДоговорКонтрагента, КомментарииПоручений",
            Выборка.Количество,
            Выборка.КоличествоПроведенных,
            Выборка.Сумма,
            Выборка.РасхожденийДоговорКонтрагента,
            "");
        СоответствиеДней.Вставить(НачалоДня(Выборка.Дата), ДанныеДня);
    КонецЦикла;

    // Сборка строк вида: "Оплата ВУК - 123; Перевод ДС при расторжении - 8001"
    ФрагментыКомментариев = Новый Соответствие;
    ВыборкаКомментариев = Пакет[1].Выбрать();
    Пока ВыборкаКомментариев.Следующий() Цикл
        ДеньКлюч = НачалоДня(ВыборкаКомментариев.Дата);
        ТекстКомментария = СокрЛП(Строка(ВыборкаКомментариев.Комментарий));
        Если Не ЗначениеЗаполнено(ТекстКомментария) Тогда
            ТекстКомментария = "(пусто)";
        КонецЕсли;
        Фрагмент = ТекстКомментария + " - " + Формат(ВыборкаКомментариев.Количество, "ЧН=0; ЧГ=0");
        Было = ФрагментыКомментариев.Получить(ДеньКлюч);
        Если Было = Неопределено Тогда
            ФрагментыКомментариев.Вставить(ДеньКлюч, Фрагмент);
        Иначе
            ФрагментыКомментариев.Вставить(ДеньКлюч, Было + "; " + Фрагмент);
        КонецЕсли;
    КонецЦикла;

    Для Каждого КлючИЗначение Из ФрагментыКомментариев Цикл
        ДанныеДня = СоответствиеДней.Получить(КлючИЗначение.Ключ);
        Если ДанныеДня = Неопределено Тогда
            ДанныеДня = Новый Структура(
                "Количество, КоличествоПроведенных, Сумма, РасхожденийДоговорКонтрагента, КомментарииПоручений",
                0, 0, 0, 0, "");
        КонецЕсли;
        ДанныеДня.КомментарииПоручений = КлючИЗначение.Значение;
        СоответствиеДней.Вставить(КлючИЗначение.Ключ, ДанныеДня);
    КонецЦикла;

    ТекущийДень = НачалоПериода;
    Пока ТекущийДень <= НачалоДня(КонецПериода) Цикл
        СтрокаДня = ТаблицаДней.Добавить();
        СтрокаДня.Дата = ТекущийДень;
        ДанныеДня = СоответствиеДней.Получить(ТекущийДень);
        Если ДанныеДня <> Неопределено Тогда
            СтрокаДня.Количество = ДанныеДня.Количество;
            СтрокаДня.КоличествоПроведенных = ДанныеДня.КоличествоПроведенных;
            СтрокаДня.Сумма = ДанныеДня.Сумма;
            СтрокаДня.КомментарииПоручений = ДанныеДня.КомментарииПоручений;
            СтрокаДня.РасхожденийДоговорКонтрагента = ДанныеДня.РасхожденийДоговорКонтрагента;
        КонецЕсли;
        ТекущийДень = ТекущийДень + 86400;
    КонецЦикла;

    Возврат ТаблицаДней;

КонецФункции

// Описание: Удаляет поступления РДУ за календарный день и ставит поручениям статус Новый.
// Параллельность: 12 фоновых заданий, порция 50 документов. Нужна регистрация в доп. обработках.
//
// Параметры:
// ДатаОперации - Дата - день удаления
// ТолькоПеревод - Булево - отбор как в статистике
// Пул - СправочникСсылка.Пул - пул договоров; если не заполнен, ищется Розничное ДУ
// ЕРС - СправочникСсылка.БанковскиеСчета - счет из настроек обработки РДУ; пустая ссылка = не отбирать
//
// Возвращаемое значение:
// Структура - Удалено, Ошибок, НайденоВсего, Текст, Режим
//
Функция УдалитьПоступленияЗаДень(ДатаОперации, ТолькоПеревод, Пул = Неопределено, ЕРС = Неопределено) Экспорт

    Результат = Новый Структура("Удалено, Ошибок, НайденоВсего, Текст, Режим", 0, 0, 0, "", "");
    ВремяНачалаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
        Результат.Текст = "Укажите дату операции.";
        Возврат Результат;
    КонецЕсли;

    Отбор = ПолучитьОтборПоступленийРДУ(Пул, ЕРС);
    Если Не ЗначениеЗаполнено(Отбор.Пул) Тогда
        Результат.Текст = Отбор.ТекстОшибки;
        Возврат Результат;
    КонецЕсли;

    СсылкиКУдалению = ПолучитьСсылкиПоступленийЗаДень(ДатаОперации, ТолькоПеревод, Отбор);
    Результат.НайденоВсего = СсылкиКУдалению.Количество();

    Если СсылкиКУдалению.Количество() = 0 Тогда
        Результат.Текст = "Поступлений РДУ за " + Формат(ДатаОперации, "ДФ=dd.MM.yyyy") + " не найдено.";
        Возврат Результат;
    КонецЕсли;

    КоличествоПотоков = 12;
    РазмерЧанка = 50;

    ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту(
        "ИмяОбъекта", ЭтотОбъект.Метаданные().Имя);

    МожноПараллелить = ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка)
        И ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены()
        И СсылкиКУдалению.Количество() > РазмерЧанка;

    Если МожноПараллелить Тогда
        Результат.Режим = "Параллельно, потоков=" + Формат(КоличествоПотоков, "ЧГ=0")
            + ", чанк=" + Формат(РазмерЧанка, "ЧГ=0");
        ИтогПараллели = УдалитьСсылкиПараллельно(
            СсылкиКУдалению, ДополнительнаяОбработкаСсылка, КоличествоПотоков, РазмерЧанка);
        Результат.Удалено = ИтогПараллели.Удалено;
        Результат.Ошибок = ИтогПараллели.Ошибок;
        ТекстОшибок = ИтогПараллели.ТекстОшибок;
    Иначе
        Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
            Результат.Режим = "Последовательно (обработка не зарегистрирована в доп. обработках)";
        Иначе
            Результат.Режим = "Последовательно";
        КонецЕсли;
        ИтогПоследовательно = УдалитьСсылкиПоследовательно(СсылкиКУдалению);
        Результат.Удалено = ИтогПоследовательно.Удалено;
        Результат.Ошибок = ИтогПоследовательно.Ошибок;
        ТекстОшибок = ИтогПоследовательно.ТекстОшибок;
    КонецЕсли;

    ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс) / 1000;
    Скорость = ?(ДлительностьСек > 0, Результат.Удалено / ДлительностьСек, 0);

    СтрокиЛога = Новый Массив;
    СтрокиЛога.Добавить("Дата: " + Формат(ДатаОперации, "ДФ=dd.MM.yyyy"));
    СтрокиЛога.Добавить("Найдено: " + Формат(Результат.НайденоВсего, "ЧН=0; ЧГ=0"));
    СтрокиЛога.Добавить("Режим: " + Результат.Режим);
    СтрокиЛога.Добавить("Удалено: " + Формат(Результат.Удалено, "ЧН=0; ЧГ=0")
        + "; ошибок: " + Формат(Результат.Ошибок, "ЧН=0; ЧГ=0"));
    СтрокиЛога.Добавить("Время: " + Формат(ДлительностьСек, "ЧДЦ=1; ЧН=0") + " сек; скорость: "
        + Формат(Скорость, "ЧДЦ=1; ЧН=0") + " док/сек");
    Если Не ПустаяСтрока(ТекстОшибок) Тогда
        СтрокиЛога.Добавить("");
        СтрокиЛога.Добавить("Ошибки (первые):");
        СтрокиЛога.Добавить(ТекстОшибок);
    КонецЕсли;

    Результат.Текст = СтрСоединить(СтрокиЛога, Символы.ПС);

    Возврат Результат;

КонецФункции

// Описание: Фоновый воркер: удаляет порцию поступлений и ставит поручениям статус Новый.
// Точка входа для ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки.
//
// Параметры:
// ПараметрыВыполнения - Строка, Структура - XML хранилища или структура с ключом Ссылки
// АдресХранилища - Строка - адрес результата
//
Процедура УдалитьПачкуПоступленийВФоне(ПараметрыВыполнения, АдресХранилища) Экспорт

    Если ТипЗнч(ПараметрыВыполнения) = Тип("Строка") Тогда
        ПараметрыВыполнения = XMLЗначение(Тип("ХранилищеЗначения"), ПараметрыВыполнения).Получить();
    КонецЕсли;

    Итог = УдалитьСсылкиПоследовательно(ПараметрыВыполнения.Ссылки);
    ПоместитьВоВременноеХранилище(XMLСтрока(Новый ХранилищеЗначения(Итог)), АдресХранилища);

КонецПроцедуры

// Описание: Собирает ключевые реквизиты поступлений РДУ за день в JSON (UTF-8) для регресса.
//
// Параметры:
// ДатаОперации - Дата - день снимка
// ТолькоПеревод - Булево - отбор как в статистике
//
// Возвращаемое значение:
// ДвоичныеДанные - содержимое JSON-файла
//
Функция СформироватьСнимокДвоичныеДанные(ДатаОперации, ТолькоПеревод, Пул = Неопределено, ЕРС = Неопределено) Экспорт

    ДанныеСнимка = СформироватьДанныеСнимка(ДатаОперации, ТолькоПеревод, Пул, ЕРС);

    ИмяВременногоФайла = ПолучитьИмяВременногоФайла("json");
    ЗаписьJSON = Новый ЗаписьJSON;
    ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(, Символы.Таб);
    ЗаписьJSON.ОткрытьФайл(ИмяВременногоФайла, "UTF-8", , ПараметрыЗаписи);
    ЗаписатьJSON(ЗаписьJSON, ДанныеСнимка);
    ЗаписьJSON.Закрыть();

    ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
    УдалитьФайлы(ИмяВременногоФайла);

    Возврат ДвоичныеДанные;

КонецФункции

// Описание: Сверяет два JSON-снимка поступлений РДУ. Ключ строки: договор ДУ + номер поручения + дата поручения.
// Номер поступления не сравнивается: после пересоздания он другой.
//
// Параметры:
// ТекстЭталон - Строка - JSON эталона (до удаления)
// ТекстНовый - Строка - JSON после повторного создания
//
// Возвращаемое значение:
// Структура - Успех, ТекстОтчета, Расхождения (таблица: Тип, Ключ, Поле, ЗначениеЭталон, ЗначениеНовый)
//
Функция СравнитьСнимкиПоТексту(ТекстЭталон, ТекстНовый) Экспорт

    Результат = Новый Структура("Успех, ТекстОтчета, Расхождения", Ложь, "", Неопределено);
    Результат.Расхождения = НоваяТаблицаРасхождений();

    ДанныеЭталон = ПрочитатьСнимокИзСтрокиJSON(ТекстЭталон);
    ДанныеНовый = ПрочитатьСнимокИзСтрокиJSON(ТекстНовый);

    Если ДанныеЭталон = Неопределено Тогда
        Результат.ТекстОтчета = "Не удалось прочитать JSON эталона. Ожидается файл снимка этой обработки.";
        Возврат Результат;
    КонецЕсли;
    Если ДанныеНовый = Неопределено Тогда
        Результат.ТекстОтчета = "Не удалось прочитать JSON нового снимка. Ожидается файл снимка этой обработки.";
        Возврат Результат;
    КонецЕсли;

    ДокументыЭталон = ДокументыСнимка(ДанныеЭталон);
    ДокументыНовый = ДокументыСнимка(ДанныеНовый);

    ИндексЭталон = ИндексДокументовСнимка(ДокументыЭталон, Результат.Расхождения, "Эталон");
    ИндексНовый = ИндексДокументовСнимка(ДокументыНовый, Результат.Расхождения, "Новый");

    ПоляСравнения = ПоляРегрессСравнения();
    Совпало = 0;
    ОтличаетсяПолей = 0;

    Для Каждого КлючИЗначение Из ИндексЭталон Цикл

        Ключ = КлючИЗначение.Ключ;
        СтрокаЭталон = КлючИЗначение.Значение;
        СтрокаНовый = ИндексНовый.Получить(Ключ);

        Если СтрокаНовый = Неопределено Тогда
            ДобавитьРасхождение(Результат.Расхождения, "Только в эталоне", Ключ, "",
                ПредставлениеКлючевыхПолей(СтрокаЭталон), "");
            Продолжить;
        КонецЕсли;

        ЕстьОтличиеПолей = Ложь;
        Для Каждого ИмяПоля Из ПоляСравнения Цикл
            ЗначениеЭталон = НормализоватьЗначениеСнимка(ЗначениеПоляСнимка(СтрокаЭталон, ИмяПоля));
            ЗначениеНовый = НормализоватьЗначениеСнимка(ЗначениеПоляСнимка(СтрокаНовый, ИмяПоля));
            Если ЗначениеЭталон <> ЗначениеНовый Тогда
                ЕстьОтличиеПолей = Истина;
                ОтличаетсяПолей = ОтличаетсяПолей + 1;
                ДобавитьРасхождение(Результат.Расхождения, "Отличается поле", Ключ, ИмяПоля,
                    ЗначениеЭталон, ЗначениеНовый);
            КонецЕсли;
        КонецЦикла;

        Если Не ЕстьОтличиеПолей Тогда
            Совпало = Совпало + 1;
        КонецЕсли;

    КонецЦикла;

    ТолькоВНовом = 0;
    Для Каждого КлючИЗначение Из ИндексНовый Цикл
        Если ИндексЭталон.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
            ТолькоВНовом = ТолькоВНовом + 1;
            ДобавитьРасхождение(Результат.Расхождения, "Только в новом", КлючИЗначение.Ключ, "",
                "", ПредставлениеКлючевыхПолей(КлючИЗначение.Значение));
        КонецЕсли;
    КонецЦикла;

    ТолькоВЭталоне = 0;
    Для Каждого СтрокаРасхождения Из Результат.Расхождения Цикл
        Если СтрокаРасхождения.Тип = "Только в эталоне" Тогда
            ТолькоВЭталоне = ТолькоВЭталоне + 1;
        КонецЕсли;
    КонецЦикла;

    СуммаЭталон = СуммаДокументовСнимка(ДокументыЭталон);
    СуммаНовый = СуммаДокументовСнимка(ДокументыНовый);

    Результат.Успех = (Результат.Расхождения.Количество() = 0);

    СтрокиОтчета = Новый Массив;
    СтрокиОтчета.Добавить("Регресс IMDEV-9202: сравнение снимков поступлений РДУ");
    СтрокиОтчета.Добавить("Эталон: документов " + Формат(ДокументыЭталон.Количество(), "ЧН=0; ЧГ=0")
        + ", сумма " + Формат(СуммаЭталон, "ЧДЦ=2; ЧН=0; ЧГ=0"));
    СтрокиОтчета.Добавить("Новый: документов " + Формат(ДокументыНовый.Количество(), "ЧН=0; ЧГ=0")
        + ", сумма " + Формат(СуммаНовый, "ЧДЦ=2; ЧН=0; ЧГ=0"));
    СтрокиОтчета.Добавить("Ключ сопоставления: ДоговорДУКод + ПоручениеНомер + ПоручениеДата");
    СтрокиОтчета.Добавить("Номер поступления не сравнивается (после пересоздания другой).");
    СтрокиОтчета.Добавить("");
    СтрокиОтчета.Добавить("Совпало полностью: " + Формат(Совпало, "ЧН=0; ЧГ=0"));
    СтрокиОтчета.Добавить("Только в эталоне: " + Формат(ТолькоВЭталоне, "ЧН=0; ЧГ=0"));
    СтрокиОтчета.Добавить("Только в новом: " + Формат(ТолькоВНовом, "ЧН=0; ЧГ=0"));
    СтрокиОтчета.Добавить("Отличающихся полей: " + Формат(ОтличаетсяПолей, "ЧН=0; ЧГ=0"));
    СтрокиОтчета.Добавить("Итого строк расхождений: " + Формат(Результат.Расхождения.Количество(), "ЧН=0; ЧГ=0"));
    СтрокиОтчета.Добавить("");
    Если Результат.Успех Тогда
        СтрокиОтчета.Добавить("Итог: РАСХОЖДЕНИЙ НЕТ. Регресс пройден.");
    Иначе
        СтрокиОтчета.Добавить("Итог: ЕСТЬ РАСХОЖДЕНИЯ. См. таблицу на форме.");
    КонецЕсли;

    Результат.ТекстОтчета = СтрСоединить(СтрокиОтчета, Символы.ПС);

    Возврат Результат;

КонецФункции

// Описание: Анализирует поступления РДУ и по отпечаткам реквизитов предлагает гипотезу пути создания.
//
// Параметры:
// ДатаНачала - Дата - начало периода
// ДатаОкончания - Дата - конец периода
// ТолькоСтрогийОтборРДУ - Булево - Истина: только отпечаток ПоступленияНаРасчетныйСчет_РозничноеДУ
// Пул - СправочникСсылка.Пул - пул договоров; пустая ссылка = Розничное ДУ
// ЕРС - СправочникСсылка.БанковскиеСчета - для строгого отбора
//
// Возвращаемое значение:
// Структура - ТаблицаАнализа, ТекстОтчета, СводкаПутей (соответствие путь -> количество)
//
Функция АнализПутейСозданияПоступлений(ДатаНачала, ДатаОкончания, ТолькоСтрогийОтборРДУ = Ложь,
    Пул = Неопределено, ЕРС = Неопределено) Экспорт

    Результат = Новый Структура("ТаблицаАнализа, ТекстОтчета, СводкаПутей, ТаблицаЦепочки, ТаблицаТаймлайн");
    Результат.ТаблицаАнализа = НоваяТаблицаАнализаПутей();
    Результат.ТаблицаЦепочки = НоваяТаблицаЦепочкиОплатаВУК();
    Результат.ТаблицаТаймлайн = НоваяТаблицаТаймлайнСоздания();
    Результат.СводкаПутей = Новый Соответствие;

    Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
        Результат.ТекстОтчета = "Укажите период анализа.";
        Возврат Результат;
    КонецЕсли;

    Отбор = ПолучитьОтборПоступленийРДУ(Пул, ЕРС);
    Если Не ЗначениеЗаполнено(Отбор.Пул) Тогда
        Результат.ТекстОтчета = Отбор.ТекстОшибки;
        Возврат Результат;
    КонецЕсли;

    НачалоПериода = НачалоДня(ДатаНачала);
    КонецПериода = КонецДня(ДатаОкончания);
    Если НачалоПериода > КонецПериода Тогда
        Результат.ТекстОтчета = "Некорректный период: дата начала позже даты окончания.";
        Возврат Результат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапросаАнализаПутей(ТолькоСтрогийОтборРДУ);
    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
    Запрос.УстановитьПараметр("Пул", Отбор.Пул);
    Запрос.УстановитьПараметр("ЕРС", Отбор.ЕРС);
    Запрос.УстановитьПараметр("ОтбиратьПоЕРС", ЗначениеЗаполнено(Отбор.ЕРС));

    ДанныеДляЦепочкиВУК = Новый Массив;

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл

        Гипотеза = ОпределитьГипотезуПутиСоздания(Выборка);
        СтрокаАнализа = Результат.ТаблицаАнализа.Добавить();
        СтрокаАнализа.Поступление = Выборка.Поступление;
        СтрокаАнализа.Поручение = Выборка.ПоручениеОснование;
        СтрокаАнализа.НомерПоступления = СокрЛП(Выборка.НомерПоступления);
        СтрокаАнализа.ДатаПоступления = Выборка.ДатаПоступления;
        СтрокаАнализа.Сумма = Выборка.Сумма;
        СтрокаАнализа.ДоговорДУКод = СокрЛП(Строка(Выборка.ДоговорДУКод));
        СтрокаАнализа.ПоручениеНомер = СокрЛП(Строка(Выборка.ПоручениеНомер));
        СтрокаАнализа.ПоручениеКомментарий = СокрЛП(Строка(Выборка.ПоручениеКомментарий));
        СтрокаАнализа.ТипОснования = СокрЛП(Строка(Выборка.ТипОснования));
        СтрокаАнализа.ОснованиеСовпадаетСПлановой = Выборка.ОснованиеСовпадаетСПлановой;
        СтрокаАнализа.ОтпечатокРДУ = Выборка.ОтпечатокРДУ;
        СтрокаАнализа.ДоговорКонтрагента = СокрЛП(Строка(Выборка.ДоговорКонтрагента));
        СтрокаАнализа.ДоговорПоручения = СокрЛП(Строка(Выборка.ДоговорПоручения));
        СтрокаАнализа.СчетКонтрагента = СокрЛП(Строка(Выборка.СчетКонтрагента));
        СтрокаАнализа.НазначениеПлатежа = СокрЛП(Строка(Выборка.НазначениеПлатежа));
        СтрокаАнализа.НомерВходящий = СокрЛП(Строка(Выборка.НомерВходящий));
        СтрокаАнализа.Ответственный = СокрЛП(Строка(Выборка.Ответственный));
        СтрокаАнализа.ГипотезаПути = Гипотеза.Путь;
        СтрокаАнализа.Уверенность = Гипотеза.Уверенность;
        СтрокаАнализа.Пояснение = Гипотеза.Пояснение;

        КоличествоПути = Результат.СводкаПутей.Получить(Гипотеза.Путь);
        Если КоличествоПути = Неопределено Тогда
            КоличествоПути = 0;
        КонецЕсли;
        Результат.СводкаПутей.Вставить(Гипотеза.Путь, КоличествоПути + 1);

        Если ЗначениеЗаполнено(Выборка.ПоручениеВУК) И Не Выборка.ЕстьПоРаспоряжениюОт Тогда
            ДанныеЦепочки = Новый Структура;
            ДанныеЦепочки.Вставить("Поступление", Выборка.Поступление);
            ДанныеЦепочки.Вставить("ПоручениеВУК", Выборка.ПоручениеВУК);
            ДанныеЦепочки.Вставить("Сумма", Выборка.Сумма);
            ДанныеЦепочки.Вставить("ДоговорДУ", Выборка.ДоговорДУ);
            ДанныеЦепочки.Вставить("НомерПоступления", СокрЛП(Выборка.НомерПоступления));
            ДанныеЦепочки.Вставить("ДоговорДУКод", СокрЛП(Строка(Выборка.ДоговорДУКод)));
            ДанныеДляЦепочкиВУК.Добавить(ДанныеЦепочки);
        КонецЕсли;

    КонецЦикла;

    Результат.ТаблицаЦепочки = ПостроитьЦепочкиОплатаВУК(ДанныеДляЦепочкиВУК);

    ОбогатитьАнализДаннымиПервыхВерсий(Результат.ТаблицаАнализа);
    Результат.ТаблицаТаймлайн = ПостроитьТаблицуТаймлайнСоздания(Результат.ТаблицаАнализа);

    Результат.ТекстОтчета = СформироватьТекстОтчетаАнализаПутей(
        Результат.ТаблицаАнализа, Результат.СводкаПутей, НачалоПериода, КонецПериода, ТолькоСтрогийОтборРДУ);
    Результат.ТекстОтчета = Результат.ТекстОтчета
        + СформироватьТекстСравненияВремениСоздания(
            Результат.ТаблицаТаймлайн, Результат.ТаблицаАнализа)
        + СформироватьТекстОтчетаЦепочкиОплатаВУК(Результат.ТаблицаЦепочки);

    Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Собирает пул и ЕРС для отбора поступлений обработки РДУ.
// Пул обязателен: без него поиск и удаление не выполняются.
//
// Параметры:
// ПулСФормы - СправочникСсылка.Пул, Неопределено - значение с формы, если заполнено
// ЕРССформы - СправочникСсылка.БанковскиеСчета, Неопределено - значение с формы, если заполнено
//
// Возвращаемое значение:
// Структура - Пул, ЕРС, ТекстОшибки
//
Функция ПолучитьОтборПоступленийРДУ(ПулСФормы = Неопределено, ЕРССформы = Неопределено) Экспорт

    Отбор = Новый Структура("Пул, ЕРС, ТекстОшибки");
    Отбор.Пул = Справочники.Пул.ПустаяСсылка();
    Отбор.ЕРС = Справочники.БанковскиеСчета.ПустаяСсылка();
    Отбор.ТекстОшибки = "";

    НастройкиРДУ = ПолучитьНастройкиОбработкиРДУ();

    Если ЗначениеЗаполнено(ПулСФормы) Тогда
        Отбор.Пул = ПулСФормы;
    ИначеЕсли НастройкиРДУ <> Неопределено
        И НастройкиРДУ.Свойство("Пул")
        И ЗначениеЗаполнено(НастройкиРДУ.Пул) Тогда
        Отбор.Пул = НастройкиРДУ.Пул;
    Иначе
        Отбор.Пул = НайтиПулРозничноеДУ();
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Отбор.Пул) Тогда
        Отбор.ТекстОшибки =
            "Не найден пул Розничное ДУ. Поиск и удаление отменены, чтобы не затронуть чужие поступления."
            + " Укажите пул на форме вручную.";
        Возврат Отбор;
    КонецЕсли;

    Если ЗначениеЗаполнено(ЕРССформы) Тогда
        Отбор.ЕРС = ЕРССформы;
    ИначеЕсли НастройкиРДУ <> Неопределено
        И НастройкиРДУ.Свойство("ЕРС")
        И ЗначениеЗаполнено(НастройкиРДУ.ЕРС) Тогда
        Отбор.ЕРС = НастройкиРДУ.ЕРС;
    КонецЕсли;

    Возврат Отбор;

КонецФункции

Функция ТекстУсловияОтбораПоступлений()

    Возврат
    "Поступление.Дата МЕЖДУ &НачалоПериода И &КонецПериода
    |	И НЕ Поступление.ПометкаУдаления
    |	И Поступление.ДоговорДУ.Пул = &Пул
    |	И Поступление.ПлановаяПозиция ССЫЛКА Документ.Поручение
    |	И Поступление.ДокументОснование = Поступление.ПлановаяПозиция
    |	И Поступление.Дата = ДОБАВИТЬКДАТЕ(Поступление.ДатаВходящегоДокумента, ЧАС, 9)
    |	И Поступление.БУ
    |	И Поступление.ВУ
    |	И Поступление.УУ
    |	И Поступление.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.RUB)
    |	И Поступление.СчетБанк = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета)
    |	И (НЕ &ОтбиратьПоЕРС ИЛИ Поступление.СчетДоговораДУ = &ЕРС)
    |	И (&ТолькоПеревод
    |				И Поступление.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.СписаниеСБрокерскогоСчета)
    |				И ВЫРАЗИТЬ(Поступление.ПлановаяПозиция КАК Документ.Поручение).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.Перевод)
    |			ИЛИ НЕ &ТолькоПеревод
    |				И Поступление.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.СписаниеСБрокерскогоСчета), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.ПрочееПоступление))
    |				И ВЫРАЗИТЬ(Поступление.ПлановаяПозиция КАК Документ.Поручение).ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.Перевод), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.ВводВДУ)))";

КонецФункции

