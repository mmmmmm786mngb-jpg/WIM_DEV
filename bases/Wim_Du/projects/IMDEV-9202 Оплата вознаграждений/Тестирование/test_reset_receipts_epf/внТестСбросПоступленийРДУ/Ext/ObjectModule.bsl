Функция ИндексДокументовСнимка(ДокументыСнимка, ТаблицаРасхождений, ИмяНабора)

    Индекс = Новый Соответствие;

    Для Каждого СтрокаДокумента Из ДокументыСнимка Цикл
        Ключ = КлючДокументаСнимка(СтрокаДокумента);
        Если Индекс.Получить(Ключ) <> Неопределено Тогда
            ДобавитьРасхождение(ТаблицаРасхождений, "Дубль ключа в " + ИмяНабора, Ключ, "",
                ПредставлениеКлючевыхПолей(Индекс.Получить(Ключ)),
                ПредставлениеКлючевыхПолей(СтрокаДокумента));
            Продолжить;
        КонецЕсли;
        Индекс.Вставить(Ключ, СтрокаДокумента);
    КонецЦикла;

    Возврат Индекс;

КонецФункции

