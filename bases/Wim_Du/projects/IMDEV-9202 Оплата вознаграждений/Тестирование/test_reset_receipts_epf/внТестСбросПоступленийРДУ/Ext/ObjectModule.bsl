    УстановитьПараметрыОтбораПоступлений(
        Запрос, НачалоДня(ДатаОперации), КонецДня(ДатаОперации), ТолькоПеревод, Отбор);

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл

