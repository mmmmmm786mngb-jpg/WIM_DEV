    Таблица.Колонки.Добавить("НомерПоступления", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("ДоговорДУКод", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("ПоручениеКомментарий", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("Ответственный", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("АвторСоздания", Новый ОписаниеТипов("Строка"));
