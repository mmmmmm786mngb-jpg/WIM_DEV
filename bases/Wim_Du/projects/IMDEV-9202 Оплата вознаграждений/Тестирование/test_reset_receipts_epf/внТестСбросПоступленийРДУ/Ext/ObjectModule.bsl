        СтрокаТаймлайн.АвторСоздания = СтрокаАнализа.АвторСозданияВерсии;
        СтрокаТаймлайн.КомментарийВерсии = СтрокаАнализа.КомментарийВерсии;
        СтрокаТаймлайн.ПоручениеНомер = СтрокаАнализа.ПоручениеНомер;
