    Результат.Вставить("Пул", "");
    Результат.Вставить("ЕРС", "");
    Результат.Вставить("Количество", 0);
    Результат.Вставить("Документы", Новый Массив);

    Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
        Возврат Результат;
    КонецЕсли;

    Отбор = ПолучитьОтборПоступленийРДУ(Пул, ЕРС);
