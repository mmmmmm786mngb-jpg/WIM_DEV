КонецФункции

// Описание: Дополняет таблицу анализа временем создания поступлений и поручений-оснований.
// Источники: ВерсииОбъектов (приоритет), при отсутствии - первый период ИсторияСтатусовОбъектов.
//
Процедура ОбогатитьАнализДаннымиПервыхВерсий(ТаблицаАнализа)

    Если ТаблицаАнализа.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ОбъектыДляЗагрузки = Новый Массив;
    Для Каждого СтрокаАнализа Из ТаблицаАнализа Цикл
        Если ЗначениеЗаполнено(СтрокаАнализа.Поступление) Тогда
            ОбъектыДляЗагрузки.Добавить(СтрокаАнализа.Поступление);
        КонецЕсли;
        Если ЗначениеЗаполнено(СтрокаАнализа.Поручение) Тогда
            ОбъектыДляЗагрузки.Добавить(СтрокаАнализа.Поручение);
        КонецЕсли;
    КонецЦикла;

    ПервыеВерсии = ЗагрузитьДанныеПервыхВерсийОбъектов(ОбъектыДляЗагрузки);
    ПервыеСтатусы = ЗагрузитьПервыеПериодыИсторииСтатусов(ОбъектыДляЗагрузки);

    Для Каждого СтрокаАнализа Из ТаблицаАнализа Цикл

        СтрокаАнализа.ГруппаСравнения = ОпределитьГруппуСравненияПоступления(СтрокаАнализа);

        МоментПоступления = ПолучитьМоментСозданияОбъекта(
            СтрокаАнализа.Поступление, ПервыеВерсии, ПервыеСтатусы);
        СтрокаАнализа.ВремяСозданияВерсии = МоментПоступления.Время;
        СтрокаАнализа.АвторСозданияВерсии = МоментПоступления.Автор;
        СтрокаАнализа.КомментарийВерсии = МоментПоступления.Комментарий;
        СтрокаАнализа.ИсточникВремениПоступления = МоментПоступления.Источник;

        МоментПоручения = ПолучитьМоментСозданияОбъекта(
            СтрокаАнализа.Поручение, ПервыеВерсии, ПервыеСтатусы);
        СтрокаАнализа.ВремяСозданияПоручения = МоментПоручения.Время;
        СтрокаАнализа.АвторСозданияПоручения = МоментПоручения.Автор;
        СтрокаАнализа.КомментарийВерсииПоручения = МоментПоручения.Комментарий;
        СтрокаАнализа.ИсточникВремениПоручения = МоментПоручения.Источник;

    КонецЦикла;

КонецПроцедуры

Функция ПолучитьМоментСозданияОбъекта(Ссылка, ПервыеВерсии, ПервыеСтатусы)

    Результат = Новый Структура("Время, Автор, Комментарий, Источник",
        '00010101', "", "", "не найдено");

    Если Не ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Результат;
    КонецЕсли;

    ДанныеВерсии = ПервыеВерсии.Получить(Ссылка);
    Если ДанныеВерсии <> Неопределено Тогда
        Результат.Время = ДанныеВерсии.ДатаВерсии;
        Результат.Автор = ДанныеВерсии.АвторВерсии;
        Результат.Комментарий = ДанныеВерсии.Комментарий;
        Результат.Источник = "ВерсииОбъектов";
        Возврат Результат;
    КонецЕсли;

    ДанныеСтатуса = ПервыеСтатусы.Получить(Ссылка);
    Если ДанныеСтатуса <> Неопределено Тогда
        Результат.Время = ДанныеСтатуса.Период;
        Результат.Комментарий = СокрЛП(Строка(ДанныеСтатуса.Статус));
        Результат.Источник = "ИсторияСтатусов: " + Результат.Комментарий;
        Возврат Результат;
    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция ЭффективноеВремяДляСравнения(ВремяПоручения, ВремяПоступления)

    Если ЗначениеЗаполнено(ВремяПоручения) Тогда
        Возврат ВремяПоручения;
    КонецЕсли;

    Возврат ВремяПоступления;

КонецФункции

Функция ОпределитьГруппуСравненияПоступления(СтрокаАнализа)

    Если СокрЛП(СтрокаАнализа.ПоручениеКомментарий) = "Оплата ВУК" Тогда
        Возврат "Оплата ВУК";
    КонецЕсли;

    КомментарийПоручения = НРег(СокрЛП(СтрокаАнализа.ПоручениеКомментарий));
    Если СтрНайти(КомментарийПоручения, "расторжен") > 0
        Или СтрНайти(КомментарийПоручения, "перевод дс") > 0 Тогда
        Возврат "Расторжение / РДУ выписка";
    КонецЕсли;

    Если СтрНайти(СтрокаАнализа.НазначениеПлатежа, "по распоряжению от") > 0
        Или СтрНайти(СтрокаАнализа.ГипотезаПути, "Зачисления") > 0 Тогда
        Возврат "Расторжение / РДУ выписка";
    КонецЕсли;

    Если СтрНайти(СтрокаАнализа.ГипотезаПути, "ОплатаКЗ") > 0 Тогда
        Возврат "ОплатаКЗ (прочее)";
    КонецЕсли;

    Возврат "Прочее / не определено";

КонецФункции

Функция ЗагрузитьДанныеПервыхВерсийОбъектов(Объекты)

    Результат = Новый Соответствие;

    Если Объекты.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	Версии.Объект КАК Объект,
    |	МИНИМУМ(Версии.НомерВерсии) КАК НомерВерсии
    |ПОМЕСТИТЬ ВТ_ПервыеНомера
    |ИЗ
    |	РегистрСведений.ВерсииОбъектов КАК Версии
    |ГДЕ
    |	Версии.Объект В (&Объекты)
    |
    |СГРУППИРОВАТЬ ПО
    |	Версии.Объект
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	Версии.Объект КАК Объект,
    |	Версии.ДатаВерсии КАК ДатаВерсии,
    |	Версии.АвторВерсии.Наименование КАК АвторВерсии,
    |	Версии.Комментарий КАК Комментарий,
    |	Версии.ТипВерсииОбъекта КАК ТипВерсииОбъекта
    |ИЗ
    |	РегистрСведений.ВерсииОбъектов КАК Версии
    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПервыеНомера КАК ВТ_ПервыеНомера
    |		ПО Версии.Объект = ВТ_ПервыеНомера.Объект
    |			И Версии.НомерВерсии = ВТ_ПервыеНомера.НомерВерсии";

    Запрос.УстановитьПараметр("Объекты", Объекты);

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Данные = Новый Структура;
        Данные.Вставить("ДатаВерсии", Выборка.ДатаВерсии);
        Данные.Вставить("АвторВерсии", СокрЛП(Выборка.АвторВерсии));
        Данные.Вставить("Комментарий", СокрЛП(Строка(Выборка.Комментарий)));
        Данные.Вставить("ТипВерсии", СокрЛП(Строка(Выборка.ТипВерсииОбъекта)));
        Результат.Вставить(Выборка.Объект, Данные);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ЗагрузитьПервыеПериодыИсторииСтатусов(Объекты)

    Результат = Новый Соответствие;

    Если Объекты.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	История.Объект КАК Объект,
    |	МИНИМУМ(История.Период) КАК Период
    |ПОМЕСТИТЬ ВТ_ПервыеПериоды
    |ИЗ
    |	РегистрСведений.ИсторияСтатусовОбъектов КАК История
    |ГДЕ
    |	История.Объект В (&Объекты)
    |
    |СГРУППИРОВАТЬ ПО
    |	История.Объект
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	История.Объект КАК Объект,
    |	История.Период КАК Период,
    |	История.Статус КАК Статус
    |ИЗ
    |	РегистрСведений.ИсторияСтатусовОбъектов КАК История
    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПервыеПериоды КАК ВТ_ПервыеПериоды
    |		ПО История.Объект = ВТ_ПервыеПериоды.Объект
    |			И История.Период = ВТ_ПервыеПериоды.Период";

    Запрос.УстановитьПараметр("Объекты", Объекты);

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Данные = Новый Структура;
        Данные.Вставить("Период", Выборка.Период);
        Данные.Вставить("Статус", Выборка.Статус);
        Результат.Вставить(Выборка.Объект, Данные);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ПостроитьТаблицуТаймлайнСоздания(ТаблицаАнализа)

