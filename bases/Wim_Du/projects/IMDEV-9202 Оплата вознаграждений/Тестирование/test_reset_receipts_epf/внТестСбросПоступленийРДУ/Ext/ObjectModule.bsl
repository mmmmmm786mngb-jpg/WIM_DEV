Функция ПрочитатьСнимокИзСтрокиJSON(ТекстJSON)

    Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
        Возврат Неопределено;
    КонецЕсли;

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстJSON);

    Попытка
        Данные = ПрочитатьJSON(ЧтениеJSON);
    Исключение
        ЧтениеJSON.Закрыть();
        Возврат Неопределено;
    КонецПопытки;

    ЧтениеJSON.Закрыть();

    Возврат Данные;

КонецФункции

Функция ДокументыСнимка(ДанныеСнимка)

    Если ТипЗнч(ДанныеСнимка) = Тип("Соответствие") Тогда
        ДокументыСнимка = ДанныеСнимка.Получить("Документы");
    ИначеЕсли ТипЗнч(ДанныеСнимка) = Тип("Структура") Тогда
        ДокументыСнимка = Неопределено;
        ДанныеСнимка.Свойство("Документы", ДокументыСнимка);
    Иначе
        ДокументыСнимка = Неопределено;
    КонецЕсли;

    Если ТипЗнч(ДокументыСнимка) <> Тип("Массив") Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Возврат ДокументыСнимка;

КонецФункции

Функция ЗначениеПоляСнимка(СтрокаДокумента, ИмяПоля)

    Если ТипЗнч(СтрокаДокумента) = Тип("Соответствие") Тогда
        Возврат СтрокаДокумента.Получить(ИмяПоля);
    ИначеЕсли ТипЗнч(СтрокаДокумента) = Тип("Структура") Тогда
        Значение = Неопределено;
        СтрокаДокумента.Свойство(ИмяПоля, Значение);
        Возврат Значение;
    КонецЕсли;

    Возврат Неопределено;

КонецФункции

Функция КлючДокументаСнимка(СтрокаДокумента)

    Возврат НормализоватьЗначениеСнимка(ЗначениеПоляСнимка(СтрокаДокумента, "ДоговорДУКод"))
        + " | "
        + НормализоватьЗначениеСнимка(ЗначениеПоляСнимка(СтрокаДокумента, "ПоручениеНомер"))
        + " | "
        + НормализоватьЗначениеСнимка(ЗначениеПоляСнимка(СтрокаДокумента, "ПоручениеДата"));

КонецФункции

Функция НормализоватьЗначениеСнимка(Значение)

    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Если ТипЗнч(Значение) = Тип("Число") Тогда
        Возврат Формат(Значение, "ЧН=0; ЧГ=0");
    КонецЕсли;

    Если ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
    КонецЕсли;

    Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ПредставлениеКлючевыхПолей(СтрокаДокумента)

    Возврат "Сумма=" + НормализоватьЗначениеСнимка(ЗначениеПоляСнимка(СтрокаДокумента, "Сумма"))
        + "; входящий=" + НормализоватьЗначениеСнимка(ЗначениеПоляСнимка(СтрокаДокумента, "НомерВходящий"));

КонецФункции

Функция СуммаДокументовСнимка(ДокументыСнимка)

    ИтогСумма = 0;
    Для Каждого СтрокаДокумента Из ДокументыСнимка Цикл
        ЗначениеСуммы = ЗначениеПоляСнимка(СтрокаДокумента, "Сумма");
        Если ТипЗнч(ЗначениеСуммы) = Тип("Число") Тогда
            ИтогСумма = ИтогСумма + ЗначениеСуммы;
        КонецЕсли;
    КонецЦикла;

    Возврат ИтогСумма;

КонецФункции

Функция ИндексДокументовСнимка(ДокументыСнимка, ТаблицаРасхождений, ИмяНабора)

    Индекс = Новый Соответствие;

    Для Каждого СтрокаДокумента Из ДокументыСнимка Цикл
        Ключ = КлючДокументаСнимка(СтрокаДокумента);
        Если Индекс.Получить(Ключ) <> Неопределено Тогда
            ДобавитьРасхождение(ТаблицаРасхождений, "Дубль ключа в " + ИмяНабора, Ключ, "",
                ПредставлениеКлючевыхПолей(Индекс.Получить(Ключ)),
                ПредставлениеКлючевыхПолей(СтрокаДокумента));
            Продолжить;
        КонецЕсли;
        Индекс.Вставить(Ключ, СтрокаДокумента);
    КонецЦикла;

    Возврат Индекс;

КонецФункции

Процедура ДобавитьРасхождение(ТаблицаРасхождений, ТипРасхождения, Ключ, Поле, ЗначениеЭталон, ЗначениеНовый)

    СтрокаРасхождения = ТаблицаРасхождений.Добавить();
    СтрокаРасхождения.Тип = ТипРасхождения;
    СтрокаРасхождения.Ключ = Ключ;
    СтрокаРасхождения.Поле = Поле;
    СтрокаРасхождения.ЗначениеЭталон = ЗначениеЭталон;
    СтрокаРасхождения.ЗначениеНовый = ЗначениеНовый;

