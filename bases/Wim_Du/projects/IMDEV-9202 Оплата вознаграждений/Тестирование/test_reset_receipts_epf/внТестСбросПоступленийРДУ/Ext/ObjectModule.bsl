Функция ОпределитьГипотезуПутиСоздания(ДанныеСтроки)

    Результат = Новый Структура("Путь, Уверенность, Пояснение", "", "Низкая", "");

    Если ДанныеСтроки.ОснованиеНачисление Тогда
        Результат.Путь = "ОплатаКЗ (внОплатаКЗПоКлиентамРДУ)";
        Результат.Уверенность = "Высокая";
        Результат.Пояснение = "ДокументОснование = НачислениеЗадолженности или НачислениеВознаграждения.";
        Возврат Результат;
    КонецЕсли;

    Если ДанныеСтроки.ОснованиеСовпадаетСПлановой
        И ДанныеСтроки.ОтпечатокРДУ
        И ДанныеСтроки.ЕстьПоРаспоряжениюОт Тогда
        Результат.Путь = "РДУ: Зачисления из выписки (внПоступленияНаРасчетныйСчет_РозничноеДУ)";
        Результат.Уверенность = "Высокая";
        Результат.Пояснение = "Основание=ПлановаяПозиция=Поручение, отпечаток РДУ, в назначении ""по распоряжению от"".";
        Возврат Результат;
    КонецЕсли;

    Если ДанныеСтроки.ОснованиеСовпадаетСПлановой
        И ДанныеСтроки.ОтпечатокРДУ
        И ДанныеСтроки.ДоговорЕРС
        И Не ДанныеСтроки.СчетКонтрагентаЗаполнен Тогда
        Результат.Путь = "РДУ: Зачисления из выписки (ERS, без счета контрагента)";
        Результат.Уверенность = "Средняя";
        Результат.Пояснение = "Отпечаток массовой обработки РДУ; ДоговорКонтрагента=ERS, счет контрагента пуст.";
        Возврат Результат;
    КонецЕсли;

    Если ДанныеСтроки.ЕстьШаблонБрокерскогоСчета
        И Не ДанныеСтроки.ЕстьПоРаспоряжениюОт
        И ДанныеСтроки.ДоговорЕБС
        И ДанныеСтроки.СчетКонтрагентаЗаполнен Тогда
        Результат.Путь = "ОплатаКЗ (отпечаток: EBS + брокерский счет + шаблон назначения)";
        Результат.Уверенность = "Высокая";
        Результат.Пояснение = "Назначение без ""по распоряжению от"", EBS, счет контрагента заполнен.";
        Возврат Результат;
    КонецЕсли;

    Если ДанныеСтроки.ОснованиеСовпадаетСПлановой И ДанныеСтроки.ОтпечатокРДУ Тогда
        Результат.Путь = "РДУ: вероятно Зачисления из выписки (неполный отпечаток)";
        Результат.Уверенность = "Средняя";
        Результат.Пояснение = "Совпадает отпечаток РДУ, но назначение/договор не типичны.";
        Возврат Результат;
    КонецЕсли;

    Если ДанныеСтроки.ДоговорЕБС И ДанныеСтроки.ЕстьПоРаспоряжениюОт Тогда
        Результат.Путь = "Смешанный: EBS + текст выписки (проверить вручную)";
        Результат.Уверенность = "Низкая";
        Результат.Пояснение = "Договор EBS, но назначение содержит ""по распоряжению от"" - не типично для ОплатаКЗ.";
        Возврат Результат;
    КонецЕсли;

    Результат.Путь = "Не определен (ручное / КлиентБанк / другой путь)";
    Результат.Уверенность = "Низкая";
    Результат.Пояснение = "Отпечатки ОплатаКЗ и РДУ не совпали. Проверить журнал и ответственного.";

    Возврат Результат;

КонецФункции

Функция СформироватьТекстОтчетаАнализаПутей(ТаблицаАнализа, СводкаПутей, НачалоПериода, КонецПериода, ТолькоСтрогийОтборРДУ)

    Строки = Новый Массив;
    Строки.Добавить("Анализ путей создания поступлений РДУ (IMDEV-9202)");
    Строки.Добавить("Период: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy")
        + " - " + Формат(НачалоДня(КонецПериода), "ДФ=dd.MM.yyyy"));
    Строки.Добавить("Отбор: " + ?(ТолькоСтрогийОтборРДУ,
        "строгий (только отпечаток ПоступленияНаРасчетныйСчет_РозничноеДУ)",
        "расширенный (все списания с брокерского счета пула)"));
    Строки.Добавить("Документов: " + Формат(ТаблицаАнализа.Количество(), "ЧН=0; ЧГ=0"));
    Строки.Добавить("");
    Строки.Добавить("Сводка по гипотезам:");
    Для Каждого КлючИЗначение Из СводкаПутей Цикл
        Строки.Добавить("  " + КлючИЗначение.Ключ + " - " + Формат(КлючИЗначение.Значение, "ЧН=0; ЧГ=0"));
    КонецЦикла;
    Строки.Добавить("");
    Строки.Добавить("Легенда:");
    Строки.Добавить("  ОплатаКЗ - основание Начисление или EBS+брокерский счет, без ""по распоряжению от""");
    Строки.Добавить("  РДУ Зачисления - основание=поручение, дата=вх.дата+9ч, часто ""по распоряжению от"" в назначении");
    Строки.Добавить("");
    Строки.Добавить("Детали - на вкладке ""Анализ путей"" или в таблице результата.");

    Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#КонецЕсли
