    |	Поступление.Ссылка КАК Поступление,
    |	Поступление.Номер КАК НомерПоступления,
    |	Поступление.Дата КАК ДатаПоступления,
    |	Поступление.СуммаДокумента КАК Сумма,
    |	Поступление.ДоговорДУ.Код КАК ДоговорДУКод,
    |	ВЫРАЗИТЬ(Поступление.ПлановаяПозиция КАК Документ.Поручение).Номер КАК ПоручениеНомер,
    |	ВЫРАЗИТЬ(Поступление.ПлановаяПозиция КАК Документ.Поручение).Комментарий КАК ПоручениеКомментарий,
    |	ВЫРАЗИТЬ(Поступление.ПлановаяПозиция КАК Документ.Поручение).ДоговорКонтрагента.Наименование КАК ДоговорПоручения,
    |	ТИПЗНАЧЕНИЯ(Поступление.ДокументОснование) КАК ТипОснования,
    |	Поступление.ДокументОснование = Поступление.ПлановаяПозиция КАК ОснованиеСовпадаетСПлановой,
    |	Поступление.Дата = ДОБАВИТЬКДАТЕ(Поступление.ДатаВходящегоДокумента, ЧАС, 9)
    |		И Поступление.БУ
    |		И Поступление.ВУ
    |		И Поступление.УУ
    |		И Поступление.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.RUB)
    |		И Поступление.СчетБанк = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета) КАК ОтпечатокРДУ,
    |	Поступление.ДоговорКонтрагента.Наименование КАК ДоговорКонтрагента,
    |	Поступление.СчетКонтрагента.Наименование КАК СчетКонтрагента,
    |	Поступление.НазначениеПлатежа КАК НазначениеПлатежа,
    |	Поступление.НомерВходящегоДокумента КАК НомерВходящий,
    |	Поступление.Ответственный.Наименование КАК Ответственный,
    |	ВЫБОР
    |		КОГДА Поступление.ДокументОснование ССЫЛКА Документ.НачислениеЗадолженности
    |				ИЛИ Поступление.ДокументОснование ССЫЛКА Документ.НачислениеВознаграждения
    |			ТОГДА ИСТИНА
    |		ИНАЧЕ ЛОЖЬ
    |	КОНЕЦ КАК ОснованиеНачисление,
    |	ВЫБОР
    |		КОГДА Поступление.НазначениеПлатежа ПОДОБНО ""*по распоряжению от*""
    |			ТОГДА ИСТИНА
    |		ИНАЧЕ ЛОЖЬ
    |	КОНЕЦ КАК ЕстьПоРаспоряжениюОт,
    |	ВЫБОР
    |		КОГДА Поступление.НазначениеПлатежа ПОДОБНО ""*30601810100012100828*""
    |			ТОГДА ИСТИНА
    |		ИНАЧЕ ЛОЖЬ
    |	КОНЕЦ КАК ЕстьШаблонБрокерскогоСчета,
    |	ВЫБОР
    |		КОГДА Поступление.СчетКонтрагента <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
    |			ТОГДА ИСТИНА
    |		ИНАЧЕ ЛОЖЬ
    |	КОНЕЦ КАК СчетКонтрагентаЗаполнен,
    |	ВЫБОР
    |		КОГДА ПОДСТРОКА(Поступление.ДоговорКонтрагента.Наименование, 1, 3) = ""ЕБС""
    |			ТОГДА ИСТИНА
    |		ИНАЧЕ ЛОЖЬ
    |	КОНЕЦ КАК ДоговорЕБС,
    |	ВЫБОР
    |		КОГДА ПОДСТРОКА(Поступление.ДоговорКонтрагента.Наименование, 1, 3) = ""ЕРС""
    |			ТОГДА ИСТИНА
    |		ИНАЧЕ ЛОЖЬ
    |	КОНЕЦ КАК ДоговорЕРС
    |ИЗ
    |	Документ.ПоступлениеНаРасчетныйСчет КАК Поступление
    |ГДЕ
    |	" + УсловиеОтбора + "
    |
    |УПОРЯДОЧИТЬ ПО
    |	ДоговорДУКод,
