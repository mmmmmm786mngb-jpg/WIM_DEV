КонецФункции

// Описание: Собирает цепочку документов Оплата ВУК (ОплатаКЗ, не из выписки).
// Порядок шагов: Начисление -> Списание -> Поручение -> Поступление.
//
// Параметры:
// ДанныеЦепочек - Массив - структуры с полями Поступление, ПоручениеВУК, Сумма, ДоговорДУ, ...
//
// Возвращаемое значение:
// ТаблицаЗначений - строки цепочки с версиями и историей статусов
//
Функция ПостроитьЦепочкиОплатаВУК(ДанныеЦепочек)

    Таблица = НоваяТаблицаЦепочкиОплатаВУК();

    Если ДанныеЦепочек.Количество() = 0 Тогда
        Возврат Таблица;
    КонецЕсли;

    ВсеОбъекты = Новый Массив;

    Для Каждого ДанныеЦепочки Из ДанныеЦепочек Цикл

        КлючПоступления = ДанныеЦепочки.ДоговорДУКод + " | "
            + ДанныеЦепочки.НомерПоступления;

        ПоручениеВУК = ДанныеЦепочки.ПоручениеВУК;
        Начисление = НайтиНачислениеДляЦепочкиВУК(
            ПоручениеВУК, ДанныеЦепочки.ДоговорДУ, ДанныеЦепочки.Сумма);
        Списание = НайтиСписаниеДляЦепочкиВУК(
            ПоручениеВУК, Начисление, ДанныеЦепочки.ДоговорДУ, ДанныеЦепочки.Сумма);

        Если ЗначениеЗаполнено(Начисление) Тогда
            ВсеОбъекты.Добавить(Начисление);
        КонецЕсли;
        Если ЗначениеЗаполнено(Списание) Тогда
            ВсеОбъекты.Добавить(Списание);
        КонецЕсли;
        Если ЗначениеЗаполнено(ПоручениеВУК) Тогда
            ВсеОбъекты.Добавить(ПоручениеВУК);
        КонецЕсли;
        Если ЗначениеЗаполнено(ДанныеЦепочки.Поступление) Тогда
            ВсеОбъекты.Добавить(ДанныеЦепочки.Поступление);
        КонецЕсли;

        СвязьНачисление = ?(ЗначениеЗаполнено(Начисление),
            "эвристика: договор ДУ + сумма + дата поручения",
            "не найдено");

        СвязьСписание = "";
        Если ЗначениеЗаполнено(Списание) Тогда
            РеквизитыСписания = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
                Списание, "ДокументОснование, ПлановаяПозиция");
            Если ЗначениеЗаполнено(РеквизитыСписания.ДокументОснование)
                И РеквизитыСписания.ДокументОснование = Начисление Тогда
                СвязьСписание = "ДокументОснование = Начисление";
            ИначеЕсли ЗначениеЗаполнено(РеквизитыСписания.ПлановаяПозиция)
                И РеквизитыСписания.ПлановаяПозиция = ПоручениеВУК Тогда
                СвязьСписание = "ПлановаяПозиция = Поручение";
            Иначе
                СвязьСписание = "эвристика: договор ДУ + сумма + дата";
            КонецЕсли;
        Иначе
            СвязьСписание = "не найдено";
        КонецЕсли;

        СвязьПоручение = "создано в ОплатаКЗ (Поручение в Мидл), комментарий ""Оплата ВУК""";
        СвязьПоступление = "ДокументОснование = Поручение (кнопка поступления в ОплатаКЗ)";

        // Шаги цепочки заполняются после загрузки версий - временно сохраним в массив
        Шаги = Новый Массив;
        Шаги.Добавить(Новый Структура("Шаг, Ссылка, СвязьС",
            1, Начисление, СвязьНачисление));
        Шаги.Добавить(Новый Структура("Шаг, Ссылка, СвязьС",
            2, Списание, СвязьСписание));
        Шаги.Добавить(Новый Структура("Шаг, Ссылка, СвязьС",
            3, ПоручениеВУК, СвязьПоручение));
        Шаги.Добавить(Новый Структура("Шаг, Ссылка, СвязьС",
            4, ДанныеЦепочки.Поступление, СвязьПоступление));

        ДанныеЦепочки.Вставить("КлючПоступления", КлючПоступления);
        ДанныеЦепочки.Вставить("Шаги", Шаги);

    КонецЦикла;

    СводкаВерсий = ЗагрузитьСводкуВерсийОбъектов(ВсеОбъекты);
    СводкаСтатусов = ЗагрузитьТекстИсторииСтатусовОбъектов(ВсеОбъекты);

    Для Каждого ДанныеЦепочки Из ДанныеЦепочек Цикл
        Для Каждого Шаг Из ДанныеЦепочки.Шаги Цикл
            ДобавитьСтрокуЦепочкиОплатаВУК(
                Таблица,
                ДанныеЦепочки.КлючПоступления,
                Шаг.Шаг,
                Шаг.Ссылка,
                Шаг.СвязьС,
                СводкаВерсий,
                СводкаСтатусов);
        КонецЦикла;
    КонецЦикла;

    Возврат Таблица;

КонецФункции

Процедура ДобавитьСтрокуЦепочкиОплатаВУК(
    Таблица, КлючПоступления, НомерШага, СсылкаДокумента, СвязьС, СводкаВерсий, СводкаСтатусов)

    СтрокаЦепочки = Таблица.Добавить();
    СтрокаЦепочки.КлючПоступления = КлючПоступления;
    СтрокаЦепочки.Шаг = НомерШага;
    СтрокаЦепочки.СвязьС = СвязьС;

    Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
        СтрокаЦепочки.ТипДокумента = "не найден";
        СтрокаЦепочки.Номер = "";
        СтрокаЦепочки.Статус = "";
        СтрокаЦепочки.ВерсияСоздания = "";
        СтрокаЦепочки.ВерсияПоследняя = "";
        СтрокаЦепочки.ИсторияСтатусов = "";
        Возврат;
    КонецЕсли;

    СтрокаЦепочки.ТипДокумента = СсылкаДокумента.Метаданные().Синоним;

    РеквизитыЦепочки = ПолучитьРеквизитыДокументаЦепочки(СсылкаДокумента);

    СтрокаЦепочки.Номер = РеквизитыЦепочки.Номер;
    СтрокаЦепочки.Дата = РеквизитыЦепочки.Дата;
    СтрокаЦепочки.Сумма = РеквизитыЦепочки.Сумма;
    СтрокаЦепочки.Ответственный = РеквизитыЦепочки.Ответственный;
    СтрокаЦепочки.Проведен = РеквизитыЦепочки.Проведен;

    Если РеквизитыЦепочки.ПометкаУдаления Тогда
        СтрокаЦепочки.Статус = "пометка удаления";
    Иначе
        СтрокаЦепочки.Статус = СокрЛП(Строка(
            РегистрыСведений.ИсторияСтатусовОбъектов.ПолучитьАктуальныйСтатусОбъекта(СсылкаДокумента)));
    КонецЕсли;

    СводкаВерсии = СводкаВерсий.Получить(СсылкаДокумента);
    Если СводкаВерсии <> Неопределено Тогда
        СтрокаЦепочки.ВерсияСоздания = СводкаВерсии.ТекстПервой;
        СтрокаЦепочки.ВерсияПоследняя = СводкаВерсии.ТекстПоследней;
        СтрокаЦепочки.КоличествоВерсий = СводкаВерсии.Количество;
    КонецЕсли;

    ТекстСтатусов = СводкаСтатусов.Получить(СсылкаДокумента);
    Если ТекстСтатусов <> Неопределено Тогда
        СтрокаЦепочки.ИсторияСтатусов = ТекстСтатусов;
    КонецЕсли;

КонецПроцедуры

// Описание: Читает общие реквизиты документа цепочки с учетом разных имен поля суммы.
//
// Параметры:
// СсылкаДокумента - ДокументСсылка - документ цепочки
//
// Возвращаемое значение:
// Структура - Номер, Дата, Сумма, Ответственный, Проведен, ПометкаУдаления
//
Функция ПолучитьРеквизитыДокументаЦепочки(СсылкаДокумента)

    Результат = Новый Структура("Номер, Дата, Сумма, Ответственный, Проведен, ПометкаУдаления",
        "", '00010101', 0, "", Ложь, Ложь);

    ТипДокумента = ТипЗнч(СсылкаДокумента);

    Если ТипДокумента = Тип("ДокументСсылка.Поручение") Тогда
        Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
            СсылкаДокумента, "Номер, Дата, СуммаДС, Ответственный, Проведен, ПометкаУдаления");
        Результат.Сумма = Реквизиты.СуммаДС;
    Иначе
        Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
            СсылкаДокумента, "Номер, Дата, СуммаДокумента, Ответственный, Проведен, ПометкаУдаления");
        Результат.Сумма = Реквизиты.СуммаДокумента;
    КонецЕсли;

    Результат.Номер = СокрЛП(Строка(Реквизиты.Номер));
    Результат.Дата = Реквизиты.Дата;
    Результат.Ответственный = СокрЛП(Строка(Реквизиты.Ответственный));
    Результат.Проведен = Реквизиты.Проведен;
    Результат.ПометкаУдаления = Реквизиты.ПометкаУдаления;

    Возврат Результат;

КонецФункции

Функция НайтиНачислениеДляЦепочкиВУК(ПоручениеВУК, ДоговорДУ, Сумма)

    ДатаПоручения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоручениеВУК, "Дата");

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |	Начисление.Ссылка КАК Ссылка
    |ИЗ
    |	Документ.НачислениеВознаграждения КАК Начисление
    |ГДЕ
    |	Начисление.ДоговорДУ = &ДоговорДУ
    |	И НЕ Начисление.ПометкаУдаления
    |	И НАЧАЛОПЕРИОДА(Начисление.Дата, ДЕНЬ) <= НАЧАЛОПЕРИОДА(&ДатаПоручения, ДЕНЬ)
    |	И (Начисление.СуммаДокумента = &Сумма
    |		ИЛИ Начисление.СуммаВознаграждения = &Сумма)
    |
    |УПОРЯДОЧИТЬ ПО
    |	Начисление.Дата УБЫВ";

    Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
    Запрос.УстановитьПараметр("ДатаПоручения", ДатаПоручения);
    Запрос.УстановитьПараметр("Сумма", Сумма);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Возврат Документы.НачислениеВознаграждения.ПустаяСсылка();

КонецФункции

Функция НайтиСписаниеДляЦепочкиВУК(ПоручениеВУК, Начисление, ДоговорДУ, Сумма)

    Если ЗначениеЗаполнено(Начисление) Тогда
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |	Списание.Ссылка КАК Ссылка
        |ИЗ
        |	Документ.СписаниеСРасчетногоСчета КАК Списание
        |ГДЕ
        |	НЕ Списание.ПометкаУдаления
        |	И Списание.ДокументОснование = &Начисление
        |
        |УПОРЯДОЧИТЬ ПО
        |	Списание.Дата УБЫВ";
        Запрос.УстановитьПараметр("Начисление", Начисление);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Ссылка;
        КонецЕсли;
    КонецЕсли;

    ДатаПоручения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоручениеВУК, "Дата");

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |	Списание.Ссылка КАК Ссылка
    |ИЗ
    |	Документ.СписаниеСРасчетногоСчета КАК Списание
    |ГДЕ
    |	НЕ Списание.ПометкаУдаления
    |	И Списание.ДоговорДУ = &ДоговорДУ
    |	И НАЧАЛОПЕРИОДА(Списание.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаПоручения, ДЕНЬ)
    |	И Списание.СуммаДокумента = &Сумма
    |
    |УПОРЯДОЧИТЬ ПО
    |	Списание.Дата УБЫВ";

    Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
    Запрос.УстановитьПараметр("ДатаПоручения", ДатаПоручения);
    Запрос.УстановитьПараметр("Сумма", Сумма);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Возврат Документы.СписаниеСРасчетногоСчета.ПустаяСсылка();

КонецФункции

Функция ЗагрузитьСводкуВерсийОбъектов(Объекты)

    Результат = Новый Соответствие;

    Если Объекты.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	Версии.Объект КАК Объект,
    |	Версии.НомерВерсии КАК НомерВерсии,
    |	Версии.ДатаВерсии КАК ДатаВерсии,
    |	Версии.АвторВерсии.Наименование КАК АвторВерсии,
    |	Версии.ТипВерсииОбъекта КАК ТипВерсииОбъекта
    |ИЗ
    |	РегистрСведений.ВерсииОбъектов КАК Версии
    |ГДЕ
    |	Версии.Объект В (&Объекты)
    |
    |УПОРЯДОЧИТЬ ПО
    |	Версии.Объект,
    |	Версии.НомерВерсии";

    Запрос.УстановитьПараметр("Объекты", Объекты);

    Выборка = Запрос.Выполнить().Выбрать();

    ТекущийОбъект = Неопределено;
    Сводка = Неопределено;

    Пока Выборка.Следующий() Цикл

        Если ТекущийОбъект <> Выборка.Объект Тогда
            Если Сводка <> Неопределено Тогда
                Результат.Вставить(ТекущийОбъект, Сводка);
            КонецЕсли;
            ТекущийОбъект = Выборка.Объект;
            Сводка = Новый Структура("Количество, ТекстПервой, ТекстПоследней", 0, "", "");
        КонецЕсли;

        Сводка.Количество = Сводка.Количество + 1;

        ТекстВерсии = "v" + Формат(Выборка.НомерВерсии, "ЧН=0; ЧГ=0")
            + " " + Формат(Выборка.ДатаВерсии, "ДФ=dd.MM.yyyy HH:mm:ss")
            + " " + СокрЛП(Выборка.АвторВерсии)
            + " (" + СокрЛП(Строка(Выборка.ТипВерсииОбъекта)) + ")";

        Если Сводка.Количество = 1 Тогда
            Сводка.ТекстПервой = ТекстВерсии;
        КонецЕсли;
        Сводка.ТекстПоследней = ТекстВерсии;

    КонецЦикла;

    Если Сводка <> Неопределено Тогда
        Результат.Вставить(ТекущийОбъект, Сводка);
    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция ЗагрузитьТекстИсторииСтатусовОбъектов(Объекты)

    Результат = Новый Соответствие;

    Если Объекты.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	История.Объект КАК Объект,
    |	История.Период КАК Период,
    |	История.Статус КАК Статус
    |ИЗ
    |	РегистрСведений.ИсторияСтатусовОбъектов КАК История
    |ГДЕ
    |	История.Объект В (&Объекты)
    |
    |УПОРЯДОЧИТЬ ПО
    |	История.Объект,
    |	История.Период";

    Запрос.УстановитьПараметр("Объекты", Объекты);

    Выборка = Запрос.Выполнить().Выбрать();

    ТекущийОбъект = Неопределено;
    СтрокиСтатусов = Новый Массив;
    Счетчик = 0;

    Пока Выборка.Следующий() Цикл

        Если ТекущийОбъект <> Выборка.Объект Тогда
            Если ТекущийОбъект <> Неопределено Тогда
                Результат.Вставить(ТекущийОбъект, СтрСоединить(СтрокиСтатусов, "; "));
            КонецЕсли;
            ТекущийОбъект = Выборка.Объект;
            СтрокиСтатусов = Новый Массив;
            Счетчик = 0;
        КонецЕсли;

        Счетчик = Счетчик + 1;
        Если Счетчик <= 8 Тогда
            СтрокиСтатусов.Добавить(
                Формат(Выборка.Период, "ДФ=dd.MM.yyyy HH:mm:ss")
                + " -> " + СокрЛП(Строка(Выборка.Статус)));
        КонецЕсли;

    КонецЦикла;

    Если ТекущийОбъект <> Неопределено Тогда
        Результат.Вставить(ТекущийОбъект, СтрСоединить(СтрокиСтатусов, "; "));
    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция СформироватьТекстОтчетаЦепочкиОплатаВУК(ТаблицаЦепочки)

    Строки = Новый Массив;
    Строки.Добавить("");
    Строки.Добавить("=== Цепочка Оплата ВУК (ОплатаКЗ, не из выписки) ===");
    Строки.Добавить("Шаги: 1 НачислениеВознаграждения -> 2 Списание -> 3 Поручение -> 4 Поступление");
    Строки.Добавить("Строк цепочки: " + Формат(ТаблицаЦепочки.Количество(), "ЧН=0; ЧГ=0"));
    Строки.Добавить("");

    Если ТаблицаЦепочки.Количество() = 0 Тогда
        Строки.Добавить("Нет поступлений с поручением ""Оплата ВУК"" без ""по распоряжению от"" в периоде.");
        Возврат СтрСоединить(Строки, Символы.ПС);
    КонецЕсли;

    ТекущийКлюч = "";
    Для Каждого СтрокаЦепочки Из ТаблицаЦепочки Цикл

        Если СтрокаЦепочки.КлючПоступления <> ТекущийКлюч Тогда
            ТекущийКлюч = СтрокаЦепочки.КлючПоступления;
            Строки.Добавить("--- " + ТекущийКлюч + " ---");
        КонецЕсли;

        Строки.Добавить(
            "  [" + Формат(СтрокаЦепочки.Шаг, "ЧН=0; ЧГ=0") + "] "
            + СтрокаЦепочки.ТипДокумента
            + " " + СтрокаЦепочки.Номер
            + " " + Формат(СтрокаЦепочки.Дата, "ДФ=dd.MM.yyyy HH:mm:ss")
            + " сумма=" + Формат(СтрокаЦепочки.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=0")
            + " отв=" + СтрокаЦепочки.Ответственный
            + ?(СтрокаЦепочки.Проведен, " проведен", " не проведен"));
        Строки.Добавить("      связь: " + СтрокаЦепочки.СвязьС);
        Если ЗначениеЗаполнено(СтрокаЦепочки.Статус) Тогда
            Строки.Добавить("      статус: " + СтрокаЦепочки.Статус);
        КонецЕсли;
        Если ЗначениеЗаполнено(СтрокаЦепочки.ВерсияСоздания) Тогда
            Строки.Добавить("      версия созд: " + СтрокаЦепочки.ВерсияСоздания);
        КонецЕсли;
        Если СтрокаЦепочки.КоличествоВерсий > 1 Тогда
            Строки.Добавить("      версия посл: " + СтрокаЦепочки.ВерсияПоследняя
                + " (всего " + Формат(СтрокаЦепочки.КоличествоВерсий, "ЧН=0; ЧГ=0") + ")");
        КонецЕсли;
        Если ЗначениеЗаполнено(СтрокаЦепочки.ИсторияСтатусов) Тогда
            Строки.Добавить("      история статусов: " + СтрокаЦепочки.ИсторияСтатусов);
        КонецЕсли;

    КонецЦикла;

    Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#КонецЕсли
