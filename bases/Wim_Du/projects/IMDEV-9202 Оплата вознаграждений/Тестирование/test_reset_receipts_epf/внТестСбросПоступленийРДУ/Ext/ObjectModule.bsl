Функция ПолучитьНастройкиОбработкиРДУ()

    ИменаОбъекта = Новый Массив;
    ИменаОбъекта.Добавить("ПоступленияНаРасчетныйСчет_РозничноеДУ");
    ИменаОбъекта.Добавить("внПоступленияНаРасчетныйСчет_РозничноеДУ");

    СсылкаОбработки = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
    Для Каждого ИмяОбъекта Из ИменаОбъекта Цикл
        СсылкаОбработки = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбъекта);
        Если ЗначениеЗаполнено(СсылкаОбработки) Тогда
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Если Не ЗначениеЗаполнено(СсылкаОбработки) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Настройки = СсылкаОбработки.ХранилищеНастроек.Получить();
    Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
        Возврат Неопределено;
    КонецЕсли;

    Значения = Неопределено;
    Если Настройки.Свойство("Значения", Значения) И ТипЗнч(Значения) = Тип("Структура") Тогда
        Возврат Значения;
    КонецЕсли;

    Возврат Настройки;

