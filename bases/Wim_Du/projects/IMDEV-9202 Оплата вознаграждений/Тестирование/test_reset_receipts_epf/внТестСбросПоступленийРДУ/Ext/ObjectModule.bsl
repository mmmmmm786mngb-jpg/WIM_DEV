КонецФункции

Функция СформироватьТекстСравненияВремениСоздания(ТаблицаТаймлайн, ТаблицаАнализа)

    Строки = Новый Массив;
    Строки.Добавить("");
    Строки.Добавить("=== Сравнение времени создания (поступления + поручения-основания) ===");
    Строки.Добавить("Источники: ВерсииОбъектов (приоритет), при отсутствии - ИсторияСтатусовОбъектов.");
    Строки.Добавить("Для сравнения групп используется время поручения, если версия поступления не найдена.");
    Строки.Добавить("");

    Если ТаблицаТаймлайн.Количество() = 0 Тогда
        Строки.Добавить("Нет данных для сравнения.");
        Возврат СтрСоединить(Строки, Символы.ПС);
    КонецЕсли;

    ТекущийДень = Дата(1, 1, 1);
    Для Каждого СтрокаТаймлайн Из ТаблицаТаймлайн Цикл

        Если СтрокаТаймлайн.ДатаДня <> ТекущийДень Тогда
            ТекущийДень = СтрокаТаймлайн.ДатаДня;
            Строки.Добавить("--- День " + Формат(ТекущийДень, "ДФ=dd.MM.yyyy") + " ---");
            ДобавитьСводкуГруппДняВТекст(Строки, ТаблицаТаймлайн, ТекущийДень);
            Строки.Добавить("");
        КонецЕсли;

        ВремяПостТекст = ФорматВремяИсточник(
            СтрокаТаймлайн.ВремяСоздания, СтрокаТаймлайн.ИсточникПоступления);
        ВремяПорТекст = ФорматВремяИсточник(
            СтрокаТаймлайн.ВремяПоручения, СтрокаТаймлайн.ИсточникПоручения);

        Строки.Добавить(
            "  пост " + ВремяПостТекст
            + " | поруч " + ВремяПорТекст
            + " | " + СтрокаТаймлайн.ГруппаСравнения
            + " | пост. " + СтрокаТаймлайн.НомерПоступления
            + " | поруч. " + СтрокаТаймлайн.ПоручениеНомер
            + " | """ + СтрокаТаймлайн.ПоручениеКомментарий + """"
            + " | отв. " + СтрокаТаймлайн.Ответственный
            + " | автор пост. " + СтрокаТаймлайн.АвторСоздания
            + " | автор поруч. " + СтрокаТаймлайн.АвторПоручения);

        Если ЗначениеЗаполнено(СтрокаТаймлайн.КомментарийВерсии) Тогда
            Строки.Добавить("      комментарий версии пост.: " + СтрокаТаймлайн.КомментарийВерсии);
        КонецЕсли;

    КонецЦикла;

    Строки.Добавить(СформироватьТекстТаймлайнПоручений(ТаблицаАнализа));

    Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ФорматВремяИсточник(Время, Источник)

    ВремяТекст = ?(ЗначениеЗаполнено(Время),
        Формат(Время, "ДФ=dd.MM.yyyy HH:mm:ss"),
        "не найдено");

    Если ЗначениеЗаполнено(Источник) И Источник <> "не найдено" Тогда
        Возврат ВремяТекст + " (" + Источник + ")";
    КонецЕсли;

    Возврат ВремяТекст;

КонецФункции

Функция СформироватьТекстТаймлайнПоручений(ТаблицаАнализа)

    Строки = Новый Массив;
    Строки.Добавить("");
    Строки.Добавить("=== Таймлайн поручений-оснований (все уникальные, по времени создания) ===");

    Если ТаблицаАнализа.Количество() = 0 Тогда
        Строки.Добавить("Нет данных.");
        Возврат СтрСоединить(Строки, Символы.ПС);
    КонецЕсли;

    УникальныеПоручения = Новый Соответствие;

    Для Каждого СтрокаАнализа Из ТаблицаАнализа Цикл

        Если Не ЗначениеЗаполнено(СтрокаАнализа.Поручение) Тогда
            Продолжить;
        КонецЕсли;

        Если УникальныеПоручения.Получить(СтрокаАнализа.Поручение) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        ДанныеПоручения = Новый Структура;
        ДанныеПоручения.Вставить("Время", ЭффективноеВремяДляСравнения(
            СтрокаАнализа.ВремяСозданияПоручения, СтрокаАнализа.ВремяСозданияВерсии));
        ДанныеПоручения.Вставить("ВремяПоручения", СтрокаАнализа.ВремяСозданияПоручения);
        ДанныеПоручения.Вставить("Автор", СтрокаАнализа.АвторСозданияПоручения);
        ДанныеПоручения.Вставить("Источник", СтрокаАнализа.ИсточникВремениПоручения);
        ДанныеПоручения.Вставить("Номер", СтрокаАнализа.ПоручениеНомер);
        ДанныеПоручения.Вставить("Комментарий", СтрокаАнализа.ПоручениеКомментарий);
        ДанныеПоручения.Вставить("Группа", СтрокаАнализа.ГруппаСравнения);
        ДанныеПоручения.Вставить("НомерПоступления", СтрокаАнализа.НомерПоступления);
        УникальныеПоручения.Вставить(СтрокаАнализа.Поручение, ДанныеПоручения);

    КонецЦикла;

    Если УникальныеПоручения.Количество() = 0 Тогда
        Строки.Добавить("Поручения-основания не найдены.");
        Возврат СтрСоединить(Строки, Символы.ПС);
    КонецЕсли;

    ТаблицаСортировки = Новый ТаблицаЗначений;
    ТаблицаСортировки.Колонки.Добавить("Время", Новый ОписаниеТипов("Дата"));
    ТаблицаСортировки.Колонки.Добавить("Данные");

    Для Каждого КлючИЗначение Из УникальныеПоручения Цикл
        СтрокаСортировки = ТаблицаСортировки.Добавить();
        СтрокаСортировки.Время = КлючИЗначение.Значение.Время;
        СтрокаСортировки.Данные = КлючИЗначение.Значение;
    КонецЦикла;

    ТаблицаСортировки.Сортировать("Время");

    Для Каждого СтрокаСортировки Из ТаблицаСортировки Цикл

        ДанныеПоручения = СтрокаСортировки.Данные;
        ВремяТекст = ФорматВремяИсточник(ДанныеПоручения.ВремяПоручения, ДанныеПоручения.Источник);

        Строки.Добавить(
            "  " + ВремяТекст
            + " | " + ДанныеПоручения.Группа
            + " | поруч. " + ДанныеПоручения.Номер
            + " | """ + ДанныеПоручения.Комментарий + """"
            + " | автор " + ДанныеПоручения.Автор
            + " | пост. " + ДанныеПоручения.НомерПоступления);

    КонецЦикла;

    Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ДобавитьСводкуГруппДняВТекст(Строки, ТаблицаТаймлайн, ДатаДня)

    Группы = Новый Соответствие;

    Для Каждого СтрокаТаймлайн Из ТаблицаТаймлайн Цикл
        Если СтрокаТаймлайн.ДатаДня <> ДатаДня Тогда
            Продолжить;
        КонецЕсли;

        СводкаГруппы = Группы.Получить(СтрокаТаймлайн.ГруппаСравнения);
        Если СводкаГруппы = Неопределено Тогда
            СводкаГруппы = Новый Структура("Количество, МинВремя, МаксВремя, Авторы", 0,
                Неопределено, Неопределено, Новый Соответствие);
            Группы.Вставить(СтрокаТаймлайн.ГруппаСравнения, СводкаГруппы);
        КонецЕсли;

        СводкаГруппы.Количество = СводкаГруппы.Количество + 1;

        ЭффективноеВремя = ЭффективноеВремяДляСравнения(
            СтрокаТаймлайн.ВремяПоручения, СтрокаТаймлайн.ВремяСоздания);

        Если ЗначениеЗаполнено(ЭффективноеВремя) Тогда
            Если СводкаГруппы.МинВремя = Неопределено
                Или ЭффективноеВремя < СводкаГруппы.МинВремя Тогда
                СводкаГруппы.МинВремя = ЭффективноеВремя;
            КонецЕсли;
            Если СводкаГруппы.МаксВремя = Неопределено
                Или ЭффективноеВремя > СводкаГруппы.МаксВремя Тогда
                СводкаГруппы.МаксВремя = ЭффективноеВремя;
            КонецЕсли;
        КонецЕсли;

        Если ЗначениеЗаполнено(СтрокаТаймлайн.АвторСоздания) Тогда
            СводкаГруппы.Авторы.Вставить(СтрокаТаймлайн.АвторСоздания, Истина);
        КонецЕсли;
        Если ЗначениеЗаполнено(СтрокаТаймлайн.АвторПоручения) Тогда
            СводкаГруппы.Авторы.Вставить("поруч:" + СтрокаТаймлайн.АвторПоручения, Истина);
        КонецЕсли;
        Если ЗначениеЗаполнено(СтрокаТаймлайн.Ответственный) Тогда
            СводкаГруппы.Авторы.Вставить("отв:" + СтрокаТаймлайн.Ответственный, Истина);
        КонецЕсли;

    КонецЦикла;

    Строки.Добавить("  Сводка по группам:");
    Для Каждого КлючИЗначение Из Группы Цикл
        СводкаГруппы = КлючИЗначение.Значение;
        ТекстВремени = "";
        Если СводкаГруппы.МинВремя <> Неопределено Тогда
            ТекстВремени = Формат(СводкаГруппы.МинВремя, "ДФ=HH:mm:ss")
                + " - " + Формат(СводкаГруппы.МаксВремя, "ДФ=HH:mm:ss");
        Иначе
            ТекстВремени = "время не определено";
        КонецЕсли;

        СписокАвторов = Новый Массив;
        Для Каждого Автор Из СводкаГруппы.Авторы Цикл
            СписокАвторов.Добавить(Автор.Ключ);
        КонецЦикла;

        Строки.Добавить("    " + КлючИЗначение.Ключ
            + ": " + Формат(СводкаГруппы.Количество, "ЧН=0; ЧГ=0") + " док., окно " + ТекстВремени
            + ", участники: " + СтрСоединить(СписокАвторов, ", "));
    КонецЦикла;

    // Разница между Оплата ВУК и Расторжение в этот день
    СводкаВУК = Группы.Получить("Оплата ВУК");
    СводкаРДУ = Группы.Получить("Расторжение / РДУ выписка");
    Если СводкаВУК <> Неопределено И СводкаРДУ <> Неопределено
        И СводкаВУК.МинВремя <> Неопределено И СводкаРДУ.МинВремя <> Неопределено Тогда

        РазницаСек = (СводкаРДУ.МинВремя - СводкаВУК.МинВремя);
        Если РазницаСек <> 0 Тогда
            Строки.Добавить("  >>> Разные окна создания: первый ВУК "
                + Формат(СводкаВУК.МинВремя, "ДФ=HH:mm:ss")
                + ", первый РДУ/расторжение "
                + Формат(СводкаРДУ.МинВремя, "ДФ=HH:mm:ss")
                + " (дельта " + Формат(РазницаСек / 60, "ЧДЦ=1; ЧН=0; ЧГ=0") + " мин)");
        Иначе
            Строки.Добавить("  >>> ВУК и РДУ/расторжение: совпало эффективное время (проверить вручную).");
        КонецЕсли;

    КонецЕсли;

КонецПроцедуры

