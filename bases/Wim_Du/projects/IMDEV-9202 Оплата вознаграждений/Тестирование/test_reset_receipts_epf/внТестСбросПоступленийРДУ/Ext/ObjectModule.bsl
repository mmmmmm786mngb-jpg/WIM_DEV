        |	И Поступление.УУ
        |	И Поступление.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.RUB)
        |	И Поступление.СчетБанк = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета)
        |	И (НЕ &ОтбиратьПоЕРС ИЛИ Поступление.СчетДоговораДУ = &ЕРС)
        |	И Поступление.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.СписаниеСБрокерскогоСчета)
        |	И ВЫРАЗИТЬ(Поступление.ПлановаяПозиция КАК Документ.Поручение).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.Перевод)";
    Иначе
        УсловиеОтбора =
        "Поступление.Дата МЕЖДУ &НачалоПериода И &КонецПериода
        |	И НЕ Поступление.ПометкаУдаления
        |	И Поступление.ДоговорДУ.Пул = &Пул
        |	И Поступление.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.СписаниеСБрокерскогоСчета)
        |	И (Поступление.ПлановаяПозиция ССЫЛКА Документ.Поручение
        |			ИЛИ Поступление.ДокументОснование ССЫЛКА Документ.Поручение
        |			ИЛИ Поступление.ДокументОснование ССЫЛКА Документ.НачислениеЗадолженности
        |			ИЛИ Поступление.ДокументОснование ССЫЛКА Документ.НачислениеВознаграждения)";
