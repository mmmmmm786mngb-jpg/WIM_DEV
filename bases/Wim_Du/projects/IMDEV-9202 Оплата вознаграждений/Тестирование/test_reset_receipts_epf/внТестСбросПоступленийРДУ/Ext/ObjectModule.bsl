    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("ДатаДня", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
    Таблица.Колонки.Добавить("ГруппаСравнения", Новый ОписаниеТипов("Строка"));
