#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ТекОбъект = РеквизитФормыВЗначение("Объект");
    Заголовок = "IMDEV-9202 тест: сброс поступлений РДУ | v. "
        + ТекОбъект.СведенияОВнешнейОбработке().Версия;

    ТолькоПеревод = Истина;
    ТолькоСтрогийОтборРДУ = Ложь;
    ДатаОкончания = НачалоДня(ТекущаяДатаСеанса());
    ДатаНачала = ДобавитьМесяц(ДатаОкончания, -1);
    ДатаОперации = ДатаОкончания;

    Отбор = ТекОбъект.ПолучитьОтборПоступленийРДУ(Пул, ЕРС);
    Пул = Отбор.Пул;
    ЕРС = Отбор.ЕРС;
    Если ЗначениеЗаполнено(Отбор.ТекстОшибки) Тогда
        Лог = Отбор.ТекстОшибки;
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

    Если Не ЗначениеЗаполнено(ДатаОперации) И ЗначениеЗаполнено(ДатаОкончания) Тогда
        ДатаОперации = ДатаОкончания;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПутьСнимкаЭталонНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ВыбратьФайлСнимка("ПутьСнимкаЭталон");

КонецПроцедуры

&НаКлиенте
Процедура ПутьСнимкаНовыйНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ВыбратьФайлСнимка("ПутьСнимкаНовый");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСтатистика

&НаКлиенте
Процедура СтатистикаПриАктивизацииСтроки(Элемент)

    ТекущиеДанные = Элементы.Статистика.ТекущиеДанные;
    Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Дата) Тогда
        ДатаОперации = ТекущиеДанные.Дата;
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьСтатистику(Команда)

    ЗаполнитьСтатистикуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьСнимок(Команда)

    Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
        ПоказатьПредупреждение(, "Укажите дату операции (или выберите строку статистики).");
        Возврат;
    КонецЕсли;

    АдресФайла = СформироватьСнимокНаСервере();
    Если Не ЗначениеЗаполнено(АдресФайла) Тогда
        ПоказатьПредупреждение(, "Нет данных для снимка за указанный день.");
        Возврат;
    КонецЕсли;

    ИмяФайла = "IM9202_receipts_" + Формат(ДатаОперации, "ДФ=yyyy-MM-dd") + ".json";
    ПолучитьФайл(АдресФайла, ИмяФайла, Истина);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьДокументы(Команда)

    Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
        ПоказатьПредупреждение(, "Укажите дату операции (или выберите строку статистики).");
        Возврат;
    КонецЕсли;

    КоличествоКУдалению = КоличествоПоступленийЗаДеньНаСервере();
    Если КоличествоКУдалению = 0 Тогда
        ПоказатьПредупреждение(, "Поступлений РДУ за " + Формат(ДатаОперации, "ДФ=dd.MM.yyyy") + " не найдено.");
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Пул) Тогда
        ПоказатьПредупреждение(, "Не указан пул. Удаление отменено.");
        Возврат;
    КонецЕсли;

    ТекстВопроса = "Удалить " + Формат(КоличествоКУдалению, "ЧГ=0")
        + " документов ПоступлениеНаРасчетныйСчет за "
        + Формат(ДатаОперации, "ДФ=dd.MM.yyyy")
        + " (пул """ + Строка(Пул) + """)"
        + " и вернуть поручениям статус Новый?"
        + Символы.ПС + "Действие необратимо. Сначала сохраните снимок, если нужен регресс.";

    ПоказатьВопрос(
        Новый ОписаниеОповещения("УдалитьДокументыПослеВопроса", ЭтотОбъект),
        ТекстВопроса,
        РежимДиалогаВопрос.ДаНет,
        ,
        КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьДокументыПослеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт

    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    Состояние("Удаление поступлений РДУ...");
    УдалитьДокументыНаСервере();
    ЗаполнитьСтатистикуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СравнитьСнимки(Команда)

    Если ПустаяСтрока(ПутьСнимкаЭталон) Или ПустаяСтрока(ПутьСнимкаНовый) Тогда
        ПоказатьПредупреждение(, "Укажите оба файла снимка: эталон и после оптимизации.");
        Возврат;
    КонецЕсли;

    ПомещаемыеФайлы = Новый Массив;
    ПомещаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьСнимкаЭталон));
    ПомещаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьСнимкаНовый));

    НачатьПомещениеФайлов(
        Новый ОписаниеОповещения("СравнитьСнимкиПослеПомещения", ЭтотОбъект),
        ПомещаемыеФайлы,
        ,
        Ложь,
        УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура СравнитьСнимкиПослеПомещения(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

    Если ПомещенныеФайлы = Неопределено Или ПомещенныеФайлы.Количество() < 2 Тогда
        ПоказатьПредупреждение(, "Не удалось передать файлы снимков на сервер.");
        Возврат;
    КонецЕсли;

    АдресЭталон = "";
    АдресНовый = "";
    Для Каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
        Если ПомещенныйФайл.Имя = ПутьСнимкаЭталон Тогда
            АдресЭталон = ПомещенныйФайл.Хранение;
        ИначеЕсли ПомещенныйФайл.Имя = ПутьСнимкаНовый Тогда
            АдресНовый = ПомещенныйФайл.Хранение;
        КонецЕсли;
    КонецЦикла;

    Если Не ЗначениеЗаполнено(АдресЭталон) Тогда
        АдресЭталон = ПомещенныеФайлы[0].Хранение;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(АдресНовый) Тогда
        АдресНовый = ПомещенныеФайлы[1].Хранение;
    КонецЕсли;

    СравнитьСнимкиНаСервере(АдресЭталон, АдресНовый);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтчетСравнения(Команда)

    Если ПустаяСтрока(Лог) Тогда
        ПоказатьПредупреждение(, "Сначала выполните сравнение снимков.");
        Возврат;
    КонецЕсли;

    АдресФайла = ПоместитьОтчетСравненияНаСервере();
    ИмяФайла = "IM9202_regress_" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + ".txt";
    ПолучитьФайл(АдресФайла, ИмяФайла, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСтатистикуНаСервере()

    ТекОбъект = РеквизитФормыВЗначение("Объект");
    Если Не ЗначениеЗаполнено(Пул) Тогда
        Отбор = ТекОбъект.ПолучитьОтборПоступленийРДУ(Пул, ЕРС);
        Пул = Отбор.Пул;
        ЕРС = Отбор.ЕРС;
        Если Не ЗначениеЗаполнено(Пул) Тогда
            Лог = Отбор.ТекстОшибки;
            Возврат;
        КонецЕсли;
    КонецЕсли;

    ТаблицаСтатистики = ТекОбъект.ПолучитьСтатистикуПоДням(ДатаНачала, ДатаОкончания, ТолькоПеревод, Пул, ЕРС);
    ЗначениеВРеквизитФормы(ТаблицаСтатистики, "Статистика");

КонецПроцедуры

&НаСервере
Функция КоличествоПоступленийЗаДеньНаСервере()

    Для Каждого СтрокаСтатистики Из Статистика Цикл
        Если СтрокаСтатистики.Дата = НачалоДня(ДатаОперации) Тогда
            Возврат СтрокаСтатистики.Количество;
        КонецЕсли;
    КонецЦикла;

    ТекОбъект = РеквизитФормыВЗначение("Объект");
    ТаблицаСтатистики = ТекОбъект.ПолучитьСтатистикуПоДням(ДатаОперации, ДатаОперации, ТолькоПеревод, Пул, ЕРС);
    Если ТаблицаСтатистики.Количество() = 0 Тогда
        Возврат 0;
    КонецЕсли;

    Возврат ТаблицаСтатистики[0].Количество;

КонецФункции

&НаСервере
Процедура УдалитьДокументыНаСервере()

    ТекОбъект = РеквизитФормыВЗначение("Объект");
    Результат = ТекОбъект.УдалитьПоступленияЗаДень(ДатаОперации, ТолькоПеревод, Пул, ЕРС);
    Лог = Результат.Текст;

КонецПроцедуры

&НаКлиенте
Процедура АнализПутей(Команда)

    АнализПутейНаСервере();

КонецПроцедуры

&НаСервере
Процедура АнализПутейНаСервере()

    ТекОбъект = РеквизитФормыВЗначение("Объект");
    РезультатАнализа = ТекОбъект.АнализПутейСозданияПоступлений(
        ДатаНачала, ДатаОкончания, ТолькоСтрогийОтборРДУ, Пул, ЕРС);

    Лог = РезультатАнализа.ТекстОтчета;
    ЗначениеВРеквизитФормы(РезультатАнализа.ТаблицаАнализа, "АнализПутей");
    ЗначениеВРеквизитФормы(РезультатАнализа.ТаблицаЦепочки, "ЦепочкаОплатаВУК");
    ЗначениеВРеквизитФормы(РезультатАнализа.ТаблицаТаймлайн, "ТаймлайнСоздания");

КонецПроцедуры

&НаСервере
Функция СформироватьСнимокНаСервере()

    ТекОбъект = РеквизитФормыВЗначение("Объект");
    ДвоичныеДанные = ТекОбъект.СформироватьСнимокДвоичныеДанные(ДатаОперации, ТолькоПеревод, Пул, ЕРС);
    Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
        Возврат "";
    КонецЕсли;

    Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Процедура ВыбратьФайлСнимка(ИмяРеквизита)

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Снимок JSON (*.json)|*.json|Все файлы (*.*)|*.*";
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Заголовок = "Выберите файл снимка поступлений";

    Диалог.Показать(Новый ОписаниеОповещения("ВыбратьФайлСнимкаЗавершение", ЭтотОбъект, ИмяРеквизита));

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлСнимкаЗавершение(ВыбранныеФайлы, ИмяРеквизита) Экспорт

    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ЭтотОбъект[ИмяРеквизита] = ВыбранныеФайлы[0];

КонецПроцедуры

&НаСервере
Процедура СравнитьСнимкиНаСервере(АдресЭталон, АдресНовый)

    ТекстЭталон = ТекстJSONИзАдреса(АдресЭталон);
    ТекстНовый = ТекстJSONИзАдреса(АдресНовый);

    ТекОбъект = РеквизитФормыВЗначение("Объект");
    Результат = ТекОбъект.СравнитьСнимкиПоТексту(ТекстЭталон, ТекстНовый);

    Лог = Результат.ТекстОтчета;
    ЗначениеВРеквизитФормы(Результат.Расхождения, "Расхождения");

КонецПроцедуры

&НаСервере
Функция ТекстJSONИзАдреса(АдресФайла)

    ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
    Если ДвоичныеДанные = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);

КонецФункции

&НаСервере
Функция ПоместитьОтчетСравненияНаСервере()

    СтрокиОтчета = Новый Массив;
    СтрокиОтчета.Добавить(Лог);
    СтрокиОтчета.Добавить("");
    СтрокиОтчета.Добавить("Детали расхождений:");
    СтрокиОтчета.Добавить("Тип" + Символы.Таб + "Ключ" + Символы.Таб + "Поле"
        + Символы.Таб + "Эталон" + Символы.Таб + "Новый");

    Для Каждого СтрокаРасхождения Из Расхождения Цикл
        СтрокиОтчета.Добавить(
            СтрокаРасхождения.Тип + Символы.Таб
            + СтрокаРасхождения.Ключ + Символы.Таб
            + СтрокаРасхождения.Поле + Символы.Таб
            + СтрокаРасхождения.ЗначениеЭталон + Символы.Таб
            + СтрокаРасхождения.ЗначениеНовый);
    КонецЦикла;

    ТекстОтчета = СтрСоединить(СтрокиОтчета, Символы.ПС);
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");
    ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
    ЗаписьТекста.Записать(ТекстОтчета);
    ЗаписьТекста.Закрыть();

    ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
    УдалитьФайлы(ИмяВременногоФайла);

    Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
