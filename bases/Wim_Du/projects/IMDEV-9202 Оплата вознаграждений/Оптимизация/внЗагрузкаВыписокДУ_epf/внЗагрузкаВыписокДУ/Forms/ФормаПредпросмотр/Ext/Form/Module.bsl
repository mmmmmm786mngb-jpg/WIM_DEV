
&НаКлиенте
Процедура СохранитьИОтправить(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	//Если ГруппировкаДокументовПоБанку Тогда
		ТекстВопроса = "Выгрузить данные в папку шлюза НРД?";
	//Иначе
	//	ТекстВопроса = "Выгрузить отмеченные документы в папку для счета """+текБанковскийСчет+""" в формате НРД?";
	//КонецЕсли;
	
	Ответ = Вопрос(ТекстВопроса, Режим, 0);
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли; 
	
	ОповеститьОВыборе(Новый Структура("ИмяСобятия,АдресДанных,КаталогВыгрузки","Сохранить_ПП_НРД",АдресДанных,КаталогВыгрузки));
	//СохранитьИОтправитьНаСервере(); 
	
КонецПроцедуры

&НаСервере
Процедура СохранитьИОтправитьНаСервере()
	
	Если АдресДанных = "" Тогда
		Возврат;
	Иначе
		МассивФайлов = ПолучитьИзВременногоХранилища(АдресДанных);
	КонецЕсли;
	
	Для каждого Файл Из МассивФайлов Цикл
		Сч = Сч+1;
		//Файл.ИмяФайла =  КаталогВыгрузки + Файл.ИмяФайла;
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(Файл.АдресВремХранилища);
		
		Попытка
			ОбФайл = новый Файл(Файл.ИмяФайла);
			КаталогКорень = КаталогВыгрузки+?(Прав(КаталогВыгрузки,1) = "\", "", "\");
			КаталогФайла = "PM"+Формат(ТекущаяДата(), "ДФ=ггггММддЧЧммсс")+Прав("000"+Сч, 3);
			
			//Сообщить("Каталог: "+КаталогКорень+КаталогФайла);
			СоздатьКаталог(КаталогКорень+КаталогФайла);
			
			ИмяФайлаВыгрузки = КаталогКорень+КаталогФайла+"\"+ОбФайл.Имя;
			//ИмяФайлаВыгрузки = КаталогКорень+ОбФайл.Имя;
			ДвоичныеДанные.Записать(ИмяФайлаВыгрузки);
			
			//ДокОбъект = Файл.ДокСсылка.ПолучитьОбъект();
			//ДокОбъект.Выгружено = ИСТИНА;
			//ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			//УстановитьСтатусВыгружено(Файл.ДокСсылка);
			
		Исключение
			Сообщить("Файл: "+ИмяФайлаВыгрузки);
			Сообщить(Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + " ошибка записи: "+ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресДанных", АдресДанных) Тогда
		Параметры.Свойство("КаталогВыгрузки", КаталогВыгрузки);
		Элементы.ДекорациКаталогВыгрузки.Заголовок = КаталогВыгрузки;
		ВидДок = "";
		Если Параметры.Свойство("ВидДок", ВидДок) Тогда
			Если ВидДок = "ПП" Тогда
				ВывестиПП();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиПП()
	
	цТемный = новый Цвет(10,39,149);
	цБелый  = новый Цвет(255,255,255);
	цСветлый= новый Цвет(219,231,244);
	
	МассивФайлов = ПолучитьИзВременногоХранилища(АдресДанных);
	ТабДок.Очистить();
	
	Модуль = РеквизитФормыВЗначение("Объект"); 
	Макет = Модуль.ПолучитьМакет("ПП_НРД");
	
	ОбластьДанных = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(ОбластьДанных);
	
	ОбластьДанных = Макет.ПолучитьОбласть("Строка");
	
	флБелый = Истина;
	Для каждого Файл Из МассивФайлов Цикл
		//НомерПП,ИмяФайлСообщения,СтрокаXML;
		ЧтениеXML = новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Файл.СтрокаXML);
		стрДанных = новый Структура("Дата,Номер,НомерСообщения,СуммаСписания,СуммаЗачисления,СчетПлательщика,Плательщик1,Плательщик2,БанкПлательщика1,БанкПлательщика2,БанкПосредник,НазначениеПлатежа,ВалютаСписания,ВалютаЗачисления,СчетПолучателя,Получатель1,Получатель2,БанкПолучателя1,БанкПолучателя2,КорСчет",
									"","","","","","","","","","","","","","","","","","","","");
		
		Пакет = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		обДок = Пакет.Document;
		
		стрДанных.Дата = обДок.CstmrCdtTrfInitn.PmtInf.ReqdExctnDt.Dt;
		стрДанных.Номер = Файл.НомерПП;
		стрДанных.НомерСообщения = обДок.CstmrCdtTrfInitn.PmtInf.PmtInfId;
		
		Если Пакет.AppHdr.BizSvc = "PI013" или Пакет.AppHdr.BizSvc = "PI014" Тогда
			стрДанных.СуммаЗачисления = обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf.Amt.InstdAmt.Последовательность().ПолучитьТекст(0);
			стрДанных.ВалютаЗачисления = обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf.Amt.InstdAmt.Ccy;
		Иначе
			стрДанных.СуммаСписания = обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf.Amt.InstdAmt.Последовательность().ПолучитьТекст(0);
			стрДанных.ВалютаСписания = обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf.Amt.InstdAmt.Ccy;
		КонецЕсли;
		
		стрДанных.СчетПлательщика = обДок.CstmrCdtTrfInitn.PmtInf.DbtrAcct.Id.Othr.Id;
		
		стрДанных.Плательщик1 = ПолучитьКонтрагента(СвойствоXDTO(обДок.CstmrCdtTrfInitn.PmtInf, "Dbtr"));
		стрДанных.БанкПлательщика1 = ПолучитьБанк(СвойствоXDTO(обДок.CstmrCdtTrfInitn.PmtInf, "DbtrAgt"));
		
		стрДанных.СчетПолучателя = обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf.CdtrAcct.Id.Othr.Id;
		
		стрДанных.Получатель1 = ПолучитьКонтрагента(СвойствоXDTO(обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf, "Cdtr"));
		стрДанных.БанкПолучателя1 = ПолучитьБанк(СвойствоXDTO(обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf, "CdtrAgt"));
		
		стрДанных.БанкПосредник = ПолучитьБанк(СвойствоXDTO(обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf, "IntrmyAgt1"));
		
		знчXTDO = СвойствоXDTO(обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf, "CdtrAgtAcct");
		Если знчXTDO <> Неопределено  Тогда
			стрДанных.КорСчет = знчXTDO.Id.Othr.Id;
		КонецЕсли;
		
		ПолучилиНП = Ложь;
		
		Если ТипЗнч(обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf.RmtInf.Ustrd) = Тип("ОбъектXDTO")
			ИЛИ ТипЗнч(обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf.RmtInf.Ustrd) = Тип("Строка") Тогда
			Попытка
				стрДанных.НазначениеПлатежа = обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf.RmtInf.Ustrd;
				ПолучилиНП = Истина;
			Исключение
				ПолучилиНП = Ложь;
			КонецПопытки;
		КонецЕсли;
		
		Если не ПолучилиНП Тогда
			Попытка
				Для каждого СтрокаНП Из обДок.CstmrCdtTrfInitn.PmtInf.CdtTrfTxInf.RmtInf.Ustrd Цикл
					стрДанных.НазначениеПлатежа = стрДанных.НазначениеПлатежа + СтрокаНП;
				КонецЦикла;
				ПолучилиНП = Истина;
			Исключение
				ПолучилиНП = Ложь;
			КонецПопытки;
		КонецЕсли;
		
		стрДанных.НазначениеПлатежа = СтрЗаменить(стрДанных.НазначениеПлатежа,"#BNF#","");
		
		ОбластьДанных.Параметры.Заполнить(стрДанных);
		Если флБелый Тогда
			ОбластьДанных.Область(1, 1, 2, 11).ЦветФона = цБелый;
		Иначе
			ОбластьДанных.Область(1, 1, 2, 11).ЦветФона = цСветлый;
		КонецЕсли;
		ТабДок.Вывести(ОбластьДанных);
		флБелый = не флБелый;
	КонецЦикла; 
	
КонецПроцедуры

Функция СвойствоXDTO(об, имя)
	
	Если об = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	св = об.Свойства().Получить(имя);
	
	Если св = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат об.Получить(имя);
КонецФункции

Функция ПолучитьКонтрагента(xdtoКонтрагент)
	
	стрКонтрагент = "";
	
	Если xdtoКонтрагент = Неопределено Тогда
		Возврат стрКонтрагент;
	КонецЕсли;
	
	знчXTDO = СвойствоXDTO(xdtoКонтрагент, "Nm");
	Если знчXTDO <> Неопределено  Тогда
		стрКонтрагент = стрКонтрагент + ?(стрКонтрагент="", "", Символы.ПС) + знчXTDO;
	КонецЕсли;
	
	xdtoАдрес = СвойствоXDTO(xdtoКонтрагент, "PstlAdr");
	Если знчXTDO <> xdtoАдрес  Тогда
		знчXTDO = СвойствоXDTO(xdtoАдрес, "TwnNm");
		Если знчXTDO <> Неопределено  Тогда
			стрКонтрагент = стрКонтрагент + ?(стрКонтрагент="", "", Символы.ПС) + знчXTDO;
		КонецЕсли;
		знчXTDO = СвойствоXDTO(xdtoАдрес, "AdrLine");
		Если знчXTDO <> Неопределено  Тогда
			стрКонтрагент = стрКонтрагент + ?(стрКонтрагент="", "", Символы.ПС) + знчXTDO;
		КонецЕсли;
	КонецЕсли;
		
	xdtoId = СвойствоXDTO(xdtoКонтрагент, "Id");
	Если xdtoId <> Неопределено  Тогда
		xdtoOrgId = СвойствоXDTO(xdtoId, "OrgId");
		Если xdtoOrgId <> Неопределено  Тогда
			xdtoOthr = СвойствоXDTO(xdtoOrgId, "Othr");
			Если xdtoOthr <> Неопределено  Тогда
				знчXTDO = СвойствоXDTO(xdtoOthr, "Id");
				Если знчXTDO <> Неопределено  Тогда
					стрКонтрагент = стрКонтрагент + ?(стрКонтрагент="", "", Символы.ПС) + знчXTDO;
				КонецЕсли;
				знчXTDO = СвойствоXDTO(xdtoOthr, "Issr");
				Если знчXTDO <> Неопределено  Тогда
					стрКонтрагент = стрКонтрагент + ?(стрКонтрагент="", "", Символы.ПС) + знчXTDO;
				КонецЕсли;
				xdtoSchmeNm = СвойствоXDTO(xdtoOthr, "SchmeNm");
				Если xdtoSchmeNm <> Неопределено  Тогда
					xdtoSchmeNm = СвойствоXDTO(xdtoSchmeNm, "Cd");
					Если знчXTDO <> Неопределено  Тогда
						стрКонтрагент = стрКонтрагент + ?(стрКонтрагент="", "", Символы.ПС) + знчXTDO;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат стрКонтрагент;
КонецФункции

Функция ПолучитьБанк(xdtoБанк)
	
	стрБанк = "";
	
	Если xdtoБанк = Неопределено Тогда
		Возврат стрБанк;
	КонецЕсли;
	
	xdtoБанк = СвойствоXDTO(xdtoБанк, "FinInstnId");
	знчXTDO = СвойствоXDTO(xdtoБанк, "BICFI");
	Если знчXTDO <> Неопределено  Тогда
		стрБанк = стрБанк + ?(стрБанк="", "", Символы.ПС) + знчXTDO;
	КонецЕсли;
	
	знчXTDO = СвойствоXDTO(xdtoБанк, "Nm");
	Если знчXTDO <> Неопределено  Тогда
		стрБанк = стрБанк + ?(стрБанк="", "", Символы.ПС) + знчXTDO;
	КонецЕсли;
	
	xdtoАдрес = СвойствоXDTO(xdtoБанк, "PstlAdr");
	Если xdtoАдрес <> Неопределено  Тогда
		знчXTDO = СвойствоXDTO(xdtoАдрес,"TwnNm");
		Если знчXTDO <> Неопределено  Тогда
			стрБанк = стрБанк + ?(стрБанк="", "", Символы.ПС) + знчXTDO;
		КонецЕсли;
		знчXTDO = СвойствоXDTO(xdtoАдрес, "AdrLine");
		Если знчXTDO <> Неопределено  Тогда
			стрБанк = стрБанк + ?(стрБанк="", "", Символы.ПС) + знчXTDO;
		КонецЕсли;
	КонецЕсли;
		
	Возврат стрБанк;
КонецФункции


