// IMDEV-9096 OPT-05: ПолучитьПлатежныеПорученияОкна
// Описание: Таблица платежных поручений в окне [-5; +1] день от даты платежа с ленивым кэшем.
//
// Параметры:
//   БанковскийСчет - СправочникСсылка.БанковскиеСчета
//   Дата           - Дата
//   КэшПП          - Соответствие - необязательно
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки ДоговорДУ, Номер, Валюта, Валюта_Наименование
//
Функция ПолучитьПлатежныеПорученияОкна(БанковскийСчет, Знач Дата, КэшПП = Неопределено)
	НачалоДняДаты = НачалоДня(Дата);
	
	Если КэшПП <> Неопределено Тогда
		КлючКэша = Строка(БанковскийСчет.УникальныйИдентификатор()) + "|" + Формат(НачалоДняДаты, "ДФ=yyyyMMdd");
		ТаблицаИзКэша = КэшПП.Получить(КлючКэша);
		Если ТаблицаИзКэша <> Неопределено Тогда
			Возврат ТаблицаИзКэша;
		КонецЕсли;
	КонецЕсли;
	
	Начало = НачалоДняДаты - 5 * 86400;
	Конец  = НачалоДняДаты + 2 * 86400;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПлатежноеПоручение.ДоговорДУ,
	               |	ПлатежноеПоручение.Номер,
	               |	ВЫБОР
	               |		КОГДА ПлатежноеПоручение.СчетДоговораДУ = &БанковскийСчет
	               |			ТОГДА ПлатежноеПоручение.СчетКонтрагента.ВалютаДенежныхСредств
	               |		ИНАЧЕ ПлатежноеПоручение.СчетДоговораДУ.ВалютаДенежныхСредств
	               |	КОНЕЦ КАК Валюта,
	               |	ЕСТЬNULL(ВЫБОР
	               |		КОГДА ПлатежноеПоручение.СчетДоговораДУ = &БанковскийСчет
	               |			ТОГДА ПлатежноеПоручение.СчетКонтрагента.ВалютаДенежныхСредств.Наименование
	               |		ИНАЧЕ ПлатежноеПоручение.СчетДоговораДУ.ВалютаДенежныхСредств.Наименование
	               |	КОНЕЦ,""<NULL> !!!"") КАК Валюта_Наименование
	               |ИЗ
	               |	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	               |ГДЕ
	               |	ПлатежноеПоручение.Дата >= &Начало
	               |	И ПлатежноеПоручение.Дата < &Конец
	               |	И (ПлатежноеПоручение.СчетДоговораДУ = &БанковскийСчет
	               |			ИЛИ ПлатежноеПоручение.СчетКонтрагента = &БанковскийСчет)
	               |	И НЕ ПлатежноеПоручение.ПометкаУдаления";
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Если КэшПП <> Неопределено Тогда
		КэшПП.Вставить(КлючКэша, Таблица);
	КонецЕсли;
	
	Возврат Таблица;
КонецФункции

#КонецОбласти

