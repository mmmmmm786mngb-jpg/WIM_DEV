Функция СтруктураДокументов(НомерВыписки) Экспорт
	
	Строки = ПлатежныеДокументы.НайтиСтроки(Новый Структура("КлючВыписки", НомерВыписки));
	
	
	ТЗ = Новый ТаблицаЗначений;
	Для каждого ТекКолонка из Метаданные().ТабличныеЧасти.ПлатежныеДокументы.Реквизиты Цикл
		НоваяКолонка =  Тз.Колонки.Добавить();
		НоваяКолонка.Имя = ТекКолонка.Имя;
	Конеццикла;
	
	Для каждого ТекСтрока из Строки Цикл
		НовыПП = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НовыПП,ТекСтрока);
	Конеццикла;
	
	Выписка = Новый Структура;
	СтрокаВыписки = Выписки.Найти(НомерВыписки,"КлючВыписки" );
	Для каждого ТекКолонка из Метаданные().ТабличныеЧасти.Выписки.Реквизиты Цикл
		выписка.Вставить(ТекКолонка.Имя, СтрокаВыписки[ТекКолонка.Имя]);
	Конеццикла;
	
	СтруктураПлатежек = Новый Структура("Выписка, ПлатежныеДокументы",Выписка,ТЗ);
	
	Адрес = ПоместитьВоВременноеХранилище(СтруктураПлатежек);
	Возврат Адрес;
	
Конецфункции


//ПРОЦЕДУРЫ ФУНКЦИИ ДОПОЛНИТЕЛЬНЫХ ОТЧЕТОВ И ОБРАБОТОК//

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	ЗначенияНастроек = НастройкиВыполнения;
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек,ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") тогда
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) тогда
			ПочтовыйЛогин = Почта;
			
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки);
			СписокРассылки.Загрузить(Ящики.Получить());
			
		КонецЕсли;
		ПредставлениеНастроек = "Настройки установлены";
		
		СерверМО = Настройки.Значения.СерверМО;
		БазаМО = Настройки.Значения.БазаМО;
		ЛогинМО = Настройки.Значения.ЛогинМО;
		ПарольМО = Настройки.Значения.ПарольМО;
		
		Настройки.Значения.Свойство("УполномоченноеЛицоФИО", УполномоченноеЛицоФИО);
		Настройки.Значения.Свойство("УполномоченноеЛицоФИОru", УполномоченноеЛицоФИОru);
		Настройки.Значения.Свойство("УполномоченноеЛицоТелефон", УполномоченноеЛицоТелефон);
		// IMDEV-9096 OPT-13 ++ параллельность фоновой массовой загрузки из пользовательских настроек
		Настройки.Значения.Свойство("МаксПараллельныхГрупп", МаксПараллельныхГрупп);
		// IMDEV-9096 OPT-13 --
	КонецЕсли;	
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	УстановитьНастройки(ПараметрыВыполненияКоманды);
	Сообщить(СерверМО);
КонецПроцедуры

