	ПлатежныеДокументы_РДУ.Загрузить(ПлатежкиРДУ);
		
КонецПроцедуры 

Процедура ПрочитатьРеестры(Дата1, Дата2) Экспорт
	
	Реестры.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеестрПлатежейОтАгентаПлатежи.Ссылка КАК Ссылка,
	               |	РеестрПлатежейОтАгентаПлатежи.НомерСтроки КАК НомерСтроки,
	               |	РеестрПлатежейОтАгентаПлатежи.ДатаОперации КАК ДатаОперации,
	               |	РеестрПлатежейОтАгентаПлатежи.Ссылка.Дата КАК ДатаРеестра,
	               |	РеестрПлатежейОтАгентаПлатежи.НомерПлатежа КАК НомерПлатежа,
	               |	РеестрПлатежейОтАгентаПлатежи.НазначениеПлатежа КАК НазначениеПлатежа,
	               |	РеестрПлатежейОтАгентаПлатежи.НомерДоговора КАК НомерДоговора,
	               |	РеестрПлатежейОтАгентаПлатежи.ДатаДоговора КАК ДатаДоговора,
	               |	РеестрПлатежейОтАгентаПлатежи.Плательщик КАК Плательщик,
	               |	РеестрПлатежейОтАгентаПлатежи.Сумма КАК Сумма,
	               |	РеестрПлатежейОтАгентаПлатежи.Клиент КАК Клиент,
	               |	РеестрПлатежейОтАгентаПлатежи.ДоговорДУ КАК ДоговорДУ
	               |ПОМЕСТИТЬ ВТ_Данные
	               |ИЗ
	               |	Документ.РеестрПлатежейОтАгента.Платежи КАК РеестрПлатежейОтАгентаПлатежи
	               |ГДЕ
	               |	НЕ РеестрПлатежейОтАгентаПлатежи.Ссылка.ПометкаУдаления
	               |	И РеестрПлатежейОтАгентаПлатежи.Ссылка.Дата МЕЖДУ &Дата1 И &Дата2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	АналитическиеСчета.ДоговорДУ КАК ДоговорДУ,
	               |	АналитическиеСчета.Ссылка КАК Ссылка,
	               |	АналитическиеСчета.МестоХранения КАК МестоХранения
	               |ПОМЕСТИТЬ ВТ_Счета
	               |ИЗ
	               |	Справочник.АналитическиеСчета КАК АналитическиеСчета
	               |ГДЕ
	               |	НЕ АналитическиеСчета.ПометкаУдаления
	               |	И АналитическиеСчета.ДоговорДУ В
	               |			(ВЫБРАТЬ
	               |				ВТ_Данные.ДоговорДУ КАК ДоговорДУ
	               |			ИЗ
	               |				ВТ_Данные КАК ВТ_Данные)
	               |	И АналитическиеСчета.ВидАналитическогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыАналитическогоСчета.ДенежныеСредства)
	               |	И АналитическиеСчета.МестоХранения ССЫЛКА Справочник.БанковскиеСчета
	               |	И АналитическиеСчета.МестоХранения.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипРасчетногоСчета.Единый)
	               |	И АналитическиеСчета.МестоХранения.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеНаРасчетныйСчет.Ссылка КАК Ссылка,
	               |	ПоступлениеНаРасчетныйСчет.Дата КАК Дата,
	               |	ПоступлениеНаРасчетныйСчет.ДоговорДУ КАК ДоговорДУ,
	               |	ПоступлениеНаРасчетныйСчет.СуммаДокумента КАК СуммаДокумента,
	               |	ПоступлениеНаРасчетныйСчет.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	               |	ПоступлениеНаРасчетныйСчет.НомерВходящегоДокумента КАК НомерВходящегоДокумента
	               |ПОМЕСТИТЬ ВТ_Поступления
	               |ИЗ
	               |	Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
	               |ГДЕ
	               |	НЕ ПоступлениеНаРасчетныйСчет.ПометкаУдаления
	               |	И ПоступлениеНаРасчетныйСчет.Дата МЕЖДУ &Дата1 И &Дата2
	               |	И ПоступлениеНаРасчетныйСчет.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.ВводДенежныхСредствВДУ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеНаРасчетныйСчет.ДоговорДУ КАК ДоговорДУ,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПоступлениеНаРасчетныйСчет.Ссылка) КАК Количество
	               |ПОМЕСТИТЬ ВТ_ПоступленияВсе
	               |ИЗ
	               |	Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
	               |ГДЕ
	               |	НЕ ПоступлениеНаРасчетныйСчет.ПометкаУдаления
	               |	И ПоступлениеНаРасчетныйСчет.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.ВводДенежныхСредствВДУ)
	               |	И НЕ ПоступлениеНаРасчетныйСчет.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ВТ_Поступления.Ссылка КАК Ссылка
	               |				ИЗ
	               |					ВТ_Поступления КАК ВТ_Поступления)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоступлениеНаРасчетныйСчет.ДоговорДУ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Данные.Ссылка КАК Ссылка,
	               |	ВТ_Данные.НомерСтроки КАК НомерСтроки,
	               |	ВТ_Данные.ДатаОперации КАК ДатаОперации,
	               |	ВТ_Данные.ДатаРеестра КАК ДатаРеестра,
	               |	ВТ_Данные.НомерПлатежа КАК НомерПлатежа,
	               |	ВТ_Данные.НазначениеПлатежа КАК НазначениеПлатежа,
	               |	ВТ_Данные.НомерДоговора КАК НомерДоговора,
	               |	ВТ_Данные.ДатаДоговора КАК ДатаДоговора,
	               |	ВТ_Данные.Плательщик КАК Плательщик,
	               |	ВТ_Данные.Сумма КАК Сумма,
	               |	ВТ_Данные.Клиент КАК Клиент,
	               |	ВТ_Данные.ДоговорДУ КАК ДоговорДУ,
	               |	ВТ_Счета.Ссылка КАК АналитическийСчет,
	               |	ВТ_Счета.МестоХранения КАК МестоХранения
	               |ПОМЕСТИТЬ ВТ_Итоговая
	               |ИЗ
	               |	ВТ_Данные КАК ВТ_Данные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Счета КАК ВТ_Счета
	               |		ПО ВТ_Данные.ДоговорДУ = ВТ_Счета.ДоговорДУ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Итоговая.Ссылка КАК Ссылка,
	               |	ВТ_Итоговая.НомерСтроки КАК НомерСтроки,
	               |	ВТ_Итоговая.ДатаОперации КАК ДатаОперации,
	               |	ВТ_Итоговая.ДатаРеестра КАК ДатаРеестра,
	               |	ВТ_Итоговая.НомерПлатежа КАК НомерПлатежа,
	               |	ВТ_Итоговая.НазначениеПлатежа КАК НазначениеПлатежа,
	               |	ВТ_Итоговая.НомерДоговора КАК НомерДоговора,
	               |	ВТ_Итоговая.ДатаДоговора КАК ДатаДоговора,
	               |	ВТ_Итоговая.Плательщик КАК Плательщик,
	               |	ВТ_Итоговая.Сумма КАК Сумма,
	               |	ВТ_Итоговая.Клиент КАК Клиент,
	               |	ВТ_Итоговая.ДоговорДУ КАК ДоговорДУ,
	               |	ВТ_Итоговая.АналитическийСчет КАК АналитическийСчет,
	               |	ВТ_Итоговая.МестоХранения КАК МестоХранения,
	               |	ЕСТЬNULL(ВТ_Поступления.Ссылка, ЗНАЧЕНИЕ(Документ.ПоступлениеНаРасчетныйСчет.ПустаяСсылка)) КАК ПоступлениеНаРС,
	               |	ЕСТЬNULL(ВТ_ПоступленияВсе.Количество, 0) КАК КоличествоПоступлений
	               |ИЗ
	               |	ВТ_Итоговая КАК ВТ_Итоговая
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Поступления КАК ВТ_Поступления
	               |		ПО ВТ_Итоговая.ДоговорДУ = ВТ_Поступления.ДоговорДУ
	               |			И ВТ_Итоговая.Сумма = ВТ_Поступления.СуммаДокумента
	               |			И ВТ_Итоговая.НомерПлатежа = ВТ_Поступления.НомерВходящегоДокумента
	               |			И ВТ_Итоговая.ДатаОперации = ВТ_Поступления.ДатаВходящегоДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоступленияВсе КАК ВТ_ПоступленияВсе
	               |		ПО ВТ_Итоговая.ДоговорДУ = ВТ_ПоступленияВсе.ДоговорДУ";
	Запрос.УстановитьПараметр("Дата1", Дата1);
	Запрос.УстановитьПараметр("Дата2", КонецДня(Дата2));
		
	Данные = Запрос.Выполнить().Выгрузить();
	МассивКлиентов = Данные.ВыгрузитьКолонку("Клиент");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	БанковскиеСчета.Ссылка КАК Ссылка,
	               |	БанковскиеСчета.Владелец КАК Владелец
	               |ИЗ
	               |	Справочник.БанковскиеСчета КАК БанковскиеСчета
	               |ГДЕ
	               |	НЕ БанковскиеСчета.ПометкаУдаления
	               |	И БанковскиеСчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипРасчетногоСчета.Индивидуальный)
	               |	И БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный)
	               |	И БанковскиеСчета.ВалютаДенежныхСредств = ЗНАЧЕНИЕ(Справочник.Валюты.RUB)
	               |	И БанковскиеСчета.Владелец В(&Владелец)";
	Запрос.УстановитьПараметр("Владелец", МассивКлиентов);
	БанковскиеСчета = Запрос.Выполнить().Выгрузить();
	БанковскиеСчета.Индексы.Добавить("Владелец");
		
	Для Каждого Выборка ИЗ Данные Цикл
		
		СтрокаТЧ = Реестры.Добавить();
		СтрокаТЧ.Отм = Истина;
		СтрокаТЧ.РеестрПлатежейАгента = Выборка.Ссылка;
		СтрокаТЧ.ПоступлениеНаРасчетныйСчет = Выборка.ПоступлениеНаРС;
		СтрокаТЧ.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ВводДенежныхСредствВДУ;
		СтрокаТЧ.НомерВходящегоДокумента = Выборка.НомерПлатежа;
		СтрокаТЧ.ДатаВходящегоДокумента = Выборка.ДатаОперации;
		СтрокаТЧ.Дата = Выборка.ДатаРеестра;
		СтрокаТЧ.ДоговорДУ = Выборка.ДоговорДУ;
		СтрокаТЧ.СчетДоговораДУ = Выборка.МестоХранения;
		СтрокаТЧ.АналитическийСчет = Выборка.АналитическийСчет;
		СтрокаТЧ.СчетБанк =  ПланыСчетов.Хозрасчетный.РасчетныеСчета;
		СтрокаТЧ.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Ввод/Вывод активов из ДУ-ЮЛ/ФЛ");
		СтрокаТЧ.СтатьяЗатрат = Справочники.СтатьиДоходовИРасходов.НайтиПоНаименованию("Ввод активов"); 
		СтрокаТЧ.Контрагент = Выборка.Клиент;
		СтрокаТЧ.СчетКонтрагента = Справочники.БанковскиеСчета.ПустаяСсылка();
		СтрокаТЧ.СуммаДокумента = Выборка.Сумма;
		СтрокаТЧ.НазначениеПлатежа = "Перечисление денежных средств в соответствии с Договором доверительного управления  № " + СокрЛП(Выборка.НомерДоговора) + "  от " + Формат(Выборка.ДатаДоговора, "ДФ=dd.MM.yyyy") + ". НДС не облагается. ";
		СтрокаТЧ.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.ВводВыводАктивовВИзДУ;
		
		Если Выборка.КоличествоПоступлений > 0 Тогда
			
			Сообщить("По договору " + Строка(СтрокаТЧ.ДоговорДУ) + " есть прошлые начисления!", СтатусСообщения.Важное);
			
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Владелец", Выборка.Клиент);
		
		МассивБС = БанковскиеСчета.НайтиСтроки(Отбор);
		Если МассивБС.Количество() Тогда
			СтрокаТЧ.СчетКонтрагента = МассивБС.Получить(0).Ссылка;		
		КонецЕсли;   
		
	КонецЦикла;
		
КонецПроцедуры 

Процедура СоздатьДокументыПоступления() Экспорт

	Для Каждого СтрокаТЧ из Реестры Цикл
		
		если НЕ СтрокаТЧ.Отм Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ СтрокаТЧ.ПоступлениеНаРасчетныйСчет.Пустая() Тогда
			ДокОбъект = СтрокаТЧ.ПоступлениеНаРасчетныйСчет.ПолучитьОбъект();
		Иначе	
			ДокОбъект = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
		КонецЕсли;
		
		ДокОбъект.ВидОперации = СтрокаТЧ.ВидОперации;
		ДокОбъект.НомерВходящегоДокумента = СтрокаТЧ.НомерВходящегоДокумента;
		ДокОбъект.ДатаВходящегоДокумента = СтрокаТЧ.ДатаВходящегоДокумента;
		ДокОбъект.Дата = СтрокаТЧ.Дата + 9 * 3600;
		ДокОбъект.ДоговорДУ = СтрокаТЧ.ДоговорДУ;
		ДокОбъект.СчетДоговораДУ = СтрокаТЧ.СчетДоговораДУ;
		ДокОбъект.АналитическийСчет = СтрокаТЧ.АналитическийСчет;
		ДокОбъект.СчетБанк = СтрокаТЧ.СчетБанк;
		ДокОбъект.СтатьяДвиженияДенежныхСредств = СтрокаТЧ.СтатьяДвиженияДенежныхСредств;
		ДокОбъект.СтатьяЗатрат = СтрокаТЧ.СтатьяЗатрат; 
		ДокОбъект.Контрагент = СтрокаТЧ.Контрагент;
		ДокОбъект.Контрагент = СтрокаТЧ.Контрагент;
		ДокОбъект.СуммаДокумента = СтрокаТЧ.СуммаДокумента;
		ДокОбъект.СчетКонтрагента = СтрокаТЧ.СчетКонтрагента;      
		ДокОбъект.НазначениеПлатежа = СтрокаТЧ.НазначениеПлатежа;
		ДокОбъект.СчетУчетаРасчетовСКонтрагентом = СтрокаТЧ.СчетУчетаРасчетовСКонтрагентом;
		
		ДокОбъект.БУ = Истина;
		ДокОбъект.УУ = Истина;
		ДокОбъект.ВУ = Истина;
		ДокОбъект.ВалютаДокумента = Справочники.Валюты.RUB;	
		
		ДокОбъект.Комментарий = "Создано автоматически обработкой ""Загрузить выписки через web-service ВТБ"" " + Формат(ТекущаяДата(), "ДЛФ=DT"); 
		
		ДокОбъект.Ответственный = Пользователи.ТекущийПользователь();
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			ДатаВводДС(СтрокаТЧ.ДоговорДУ, СтрокаТЧ.Дата);
			
			Сообщить("Создано реестровое поступление: " + Строка(СтрокаТЧ.ДоговорДУ) + " сумма " + Формат(строкаТЧ.СуммаДокумента, "ЧДЦ=2"));
		Исключение
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			
			ОписаниеОшибки = ОписаниеОшибки();
			Сообщить("Ошибка создания реестровое поступление: " + Строка(СтрокаТЧ.ДоговорДУ) + " сумма " + Формат(строкаТЧ.СуммаДокумента, "ЧДЦ=2") + ". Ошибка: " + ОписаниеОшибки);
		КонецПопытки;
		
		// заполнить ввод/выод
		СсылкаДок = ДокОбъект.Ссылка;
		ДокОбъект.СубконтоКт1 = СсылкаДок;
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;		
		
		СтрокаТЧ.ПоступлениеНаРасчетныйСчет = ДокОбъект.Ссылка;
					
	КонецЦикла;
	
КонецПроцедуры

Процедура ДатаВводДС(ДоговорДУ, ДатаВводаДС)

	ДоговорДУОбъект = ДоговорДУ.ПолучитьОбъект();
	ДоговорДУОбъект.ДатаВводаСредствВДУ = ДатаВводаДС;
	ДоговорДУОбъект.Записать();
	

	

КонецПроцедуры

//ASP-195703
Функция ЗачисленияНаРСРозничногоДУ() Экспорт  
	
	Результат = Новый Структура("ИмяОбработки, Параметры");
	ТекстСообщения = "";
	
	
	Параметры = Новый Структура("ДатаПоступления, ВхНомер, ВхНомерВвод, НазначениеПлатежа, НазначениеПлатежаВвод, ЕРС, Пул, СтатьяДДС, СтатьяЗатрат, СтатьяЗатратВвод, СчетРасчетов, СчетРасчетовВвод, СтатьяДДСВвод");
	СтрокиПлатежей = Новый Массив;
	
	НазначениеПлатежа = "Вывод денежных средств с брокерского счета 30601810100012100828, субсчет 13W6XW";
	Отбор = Новый Структура;
	Отбор.Вставить("ПлательщикСчет", "30601810100012100828");
	Отбор.Вставить("ПолучательСчет", "40701810000030000413"); 
	
	НайденнаяСтрока = НайтиСТрокуВТЧ_ПлатежныеДокументы(Отбор, НазначениеПлатежа, ТекстСообщения);
	Если НайденнаяСтрока <> Неопределено Тогда
		СтрокаПлатежа = Новый Структура();
		СтрокаПлатежа.Вставить("СтрокаПлатежа", НайденнаяСтрока);
		СтрокаПлатежа.Вставить("ВидОперации", Перечисления.ВидыОперацийПоручение.Перевод);
		СтрокиПлатежей.Добавить(СтрокаПлатежа);
	КонецЕсли;
	
	НазначениеПлатежа = "Перевод средств компенсации по договорам ДУ. НДС не облагается";
	Отбор = Новый Структура;
	Отбор.Вставить("ПлательщикСчет", "40702810116000014928");
	Отбор.Вставить("ПолучательСчет", "40701810000030000413"); 
	
	НайденнаяСтрока = НайтиСТрокуВТЧ_ПлатежныеДокументы(Отбор, НазначениеПлатежа, ТекстСообщения);
	Если НайденнаяСтрока <> Неопределено Тогда
		СтрокаПлатежа = Новый Структура();
		СтрокаПлатежа.Вставить("СтрокаПлатежа", НайденнаяСтрока);
		СтрокаПлатежа.Вставить("ВидОперации", Перечисления.ВидыОперацийПоручение.ВводВДУ);
		СтрокиПлатежей.Добавить(СтрокаПлатежа);
	КонецЕсли;
	
	ПорученияПоДС_РДУ.Очистить();
	
	Параметры.Вставить("ЭтоЗачисленияНаРСРозничногоДУ", Истина);
	
	ВнешняяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта","ПоступленияНаРасчетныйСчет_РозничноеДУ");
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ДвоичныеДанные = ВнешняяОбработкаСсылка.ХранилищеОбработки.Получить();
	ДвоичныеДанные.Записать(ИмяФайла);
	// IMDEV-9202: при старте из выписки фоновый режим наследует безопасный режим
	НоваяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
	Результат.ИмяОбработки =  ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(ВнешняяОбработкаСсылка);
	Настройки = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ВнешняяОбработкаСсылка,"ХранилищеНастроек").Получить();
	ЗаполнитьЗначенияСвойств(НоваяОбработка, Настройки.Значения);
	
	ЕРС = Справочники.БанковскиеСчета.НайтиПоРеквизиту("НомерСчета", СтрокаПлатежа.СтрокаПлатежа.ПолучательСчет);
	НоваяОбработка.ЕРС = ЕРС;
	
	Если ЗначениеЗаполнено(ЕРС) Тогда
		Для каждого СтрокаПлатежа Из СтрокиПлатежей Цикл
			СоздатьДокументы_РозничноеДУ(СтрокаПлатежа.СтрокаПлатежа, СтрокаПлатежа.ВидОперации, НоваяОбработка, ТекстСообщения);
		КонецЦикла;
	Иначе
		ТекстСообщения = ТекстСообщения + СтрШаблон("Не удалось найти ЕРС по номеру счета: %1", СтрокаПлатежа.СтрокаПлатежа.ПлательщикСчет);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Параметры, НоваяОбработка);
	
	Результат.Параметры = Параметры;
	Результат.Вставить("ТекстСообщения", ТекстСообщения);
	
	Возврат Результат;
	
КонецФункции

#Область ЗачисленийНаРСПоДоговорамРозничногоДУ 

Функция НайтиСТрокуВТЧ_ПлатежныеДокументы(Отбор, НазначениеПлатежа, ТекстСообщения, Сумма = Неопределено)
	
	НаденнаяСтрока = Неопределено;
		
	Если Сумма <> Неопределено Тогда
		Отбор.Вставить("Сумма", СтрЗаменить(Сумма, Символы.НПП, ""));
	КонецЕсли;

	ТЗ_Зачисления = ПлатежныеДокументы.Выгрузить(Отбор);  
	
	Для Каждого ТекСтрока ИЗ ТЗ_Зачисления Цикл
		Если Найти(ВРег(ТекСтрока.НазначениеПлатежа), ВРег(НазначениеПлатежа)) <> 0 Тогда
			НаденнаяСтрока = ТекСтрока;
		КонецЕсли;
	КонецЦикла;
	
	Если НаденнаяСтрока = Неопределено Тогда 
		ТекстСообщения = ТекстСообщения + СтрШаблон("Не удалось найти строку: ПлательщикСчет%1; ПолучательСчет:%2; %3", Отбор.ПлательщикСчет,
		Отбор.ПолучательСчет, НазначениеПлатежа);
	КонецЕсли;
	
	Возврат НаденнаяСтрока;
	
КонецФункции  

Процедура СоздатьДокументы_РозничноеДУ(НайденнаяСтрока, ВидОперации, НоваяОбработка, ТекстСообщения)

	ПодстрокаРасторжения = "Перевод ДС при расторжении";
	НоваяОбработка.ПорученияПоДС(ВидОперации);

	Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
		Сумма = Число(НайденнаяСтрока.Сумма);
		СуммаДоОтбора = Окр(НоваяОбработка.ПорученияПоДС.Итог("СуммаДС"), 2);
		КоличествоДоОтбора = НоваяОбработка.ПорученияПоДС.Количество();
		ДиагностикаДоОтбора = СобратьДиагностикуКомментариевПоручений(
			НоваяОбработка.ПорученияПоДС, ПодстрокаРасторжения);
		ОтборСработал = Неопределено;
		Если СуммаДоОтбора <> Сумма Тогда
			ОтборСработал = ОтобратьПорученияПодСуммуПлатежки(
				НоваяОбработка.ПорученияПоДС, Сумма, ПодстрокаРасторжения);
		КонецЕсли;
		СуммаДС = НоваяОбработка.ПорученияПоДС.Итог("СуммаДС");
	Иначе
		СуммаДС = НоваяОбработка.ПорученияПоДСВвод.Итог("СуммаДС");
		Сумма = Число(НайденнаяСтрока.Сумма);
		СуммаДоОтбора = СуммаДС;
		КоличествоДоОтбора = НоваяОбработка.ПорученияПоДСВвод.Количество();
		ОтборСработал = Неопределено;
		ДиагностикаДоОтбора = Неопределено;
	КонецЕсли;

	Если СуммаДС = Сумма И Сумма <> 0 Тогда

		НоваяОбработка.ДатаПоступления = НайденнаяСтрока.ДатаПоступления;
		Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
			НоваяОбработка.ВхНомер = НайденнаяСтрока.Номер;
		Иначе
			НоваяОбработка.ВхНомерВвод = НайденнаяСтрока.Номер;
		КонецЕсли;

		НоваяОбработка.НазначениеПлатежа = НайденнаяСтрока.НазначениеПлатежа;

		НоваяОбработка.СоздатьПоступленияДС(ВидОперации);
		Для Каждого НоваяОбработкаПорученияПоДС Из НоваяОбработка.ПорученияПоДС Цикл

			Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
				ПоручениеПоДС_РДУ = ПорученияПоДС_РДУ.Добавить();
			Иначе
				ПоручениеПоДС_РДУ = ПорученияПоДСВвод_РДУ.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ПоручениеПоДС_РДУ, НоваяОбработкаПорученияПоДС);

		КонецЦикла;

		Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
			СоздатьОстатокПереводаПоВторойПлатежке(НайденнаяСтрока, НоваяОбработка, ТекстСообщения);
		КонецЕсли;
	Иначе
		ТекстСообщения = ТекстСообщения + ТекстДиагностикиНесовпаденияСуммРДУ(
			НайденнаяСтрока,
			ВидОперации,
			НоваяОбработка,
			Сумма,
			СуммаДС,
			СуммаДоОтбора,
			КоличествоДоОтбора,
			ОтборСработал,
			ПодстрокаРасторжения,
			ДиагностикаДоОтбора);
	КонецЕсли;

КонецПроцедуры

// Описание: Отбирает в ТЧ поручения под сумму платежки по подстроке комментария.
// Если сумма группы с подстрокой = платежке — оставляет группу.
// Если (итог - группа) = платежке — оставляет остальные.
// Иначе ТЧ не меняет.
//
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть - ПорученияПоДС
//  СуммаПлатежки - Число - сумма строки выписки
//  ПодстрокаКомментария - Строка - например «Перевод ДС при расторжении»
//
// Возвращаемое значение:
//  Булево - Истина, если отбор применился; Ложь, если суммы не сошлись или ТЧ пуста
//
Функция ОтобратьПорученияПодСуммуПлатежки(ТабличнаяЧасть, СуммаПлатежки, ПодстрокаКомментария)

	Если ТабличнаяЧасть.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Диагностика = СобратьДиагностикуКомментариевПоручений(ТабличнаяЧасть, ПодстрокаКомментария);
	СуммаГруппы = Диагностика.СуммаГруппы;
	СуммаВсех = Диагностика.СуммаВсех;
	СуммаПлатежки = Окр(СуммаПлатежки, 2);
	Комментарии = Диагностика.Комментарии;

	ОставитьСКомментарием = Неопределено;
	Если СуммаГруппы = СуммаПлатежки Тогда
		ОставитьСКомментарием = Истина;
	ИначеЕсли Окр(СуммаВсех - СуммаГруппы, 2) = СуммаПлатежки Тогда
		ОставитьСКомментарием = Ложь;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Индекс = ТабличнаяЧасть.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Комментарий = Комментарии.Получить(ТабличнаяЧасть[Индекс].ПоручениеПоДС);
		ЕстьКомментарий = Комментарий <> Неопределено
			И Найти(ВРег(Комментарий), ВРег(ПодстрокаКомментария)) > 0;
		Если ЕстьКомментарий <> ОставитьСКомментарием Тогда
			ТабличнаяЧасть.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура СоздатьОстатокПереводаПоВторойПлатежке(ПерваяСтрока, НоваяОбработка, ТекстСообщения)

	НоваяОбработка.ПорученияПоДС(Перечисления.ВидыОперацийПоручение.Перевод);
	СуммаОстатка = Окр(НоваяОбработка.ПорученияПоДС.Итог("СуммаДС"), 2);
	Если СуммаОстатка = 0 Тогда
		Возврат;
	КонецЕсли;

	ВтораяСтрока = Неопределено;
	Кандидаты = Новый Массив;
	Отбор = Новый Структура;
	Отбор.Вставить("ПолучательСчет", ПерваяСтрока.ПолучательСчет);
	Для Каждого ТекСтрока Из ПлатежныеДокументы.Выгрузить(Отбор) Цикл
		Если СокрЛП(Строка(ТекСтрока.Номер)) = СокрЛП(Строка(ПерваяСтрока.Номер)) Тогда
			Продолжить;
		КонецЕсли;
		СуммаКандидата = 0;
		Попытка
			СуммаКандидата = Окр(Число(ТекСтрока.Сумма), 2);
		Исключение
			СуммаКандидата = 0;
		КонецПопытки;
		Кандидаты.Добавить(Новый Структура(
			"Номер, Сумма, ПлательщикСчет, НазначениеПлатежа",
			СокрЛП(Строка(ТекСтрока.Номер)),
			СуммаКандидата,
			СокрЛП(Строка(ТекСтрока.ПлательщикСчет)),
			СокрЛП(Строка(ТекСтрока.НазначениеПлатежа))));
		Если СуммаКандидата = СуммаОстатка Тогда
			ВтораяСтрока = ТекСтрока;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ВтораяСтрока = Неопределено Тогда
		Строки = Новый Массив;
		Строки.Добавить(Символы.ПС);
		Строки.Добавить("IMDEV-9202. Не найдена вторая платежка Перевод под остаток поручений.");
		Строки.Добавить("Первая платежка (уже обработана): № " + СокрЛП(Строка(ПерваяСтрока.Номер))
			+ "; сумма " + Формат(Число(ПерваяСтрока.Сумма), "ЧДЦ=2; ЧН=0; ЧГ=0")
			+ "; ПолучательСчет " + СокрЛП(Строка(ПерваяСтрока.ПолучательСчет)) + ".");
		Строки.Добавить("Остаток поручений Перевод после первой пачки: "
			+ Формат(СуммаОстатка, "ЧДЦ=2; ЧН=0; ЧГ=0")
			+ "; строк в ТЧ: " + Формат(НоваяОбработка.ПорученияПоДС.Количество(), "ЧГ=0") + ".");
		Строки.Добавить("Искали другую входящую на тот же ПолучательСчет с суммой = остатку.");
		Если Кандидаты.Количество() = 0 Тогда
			Строки.Добавить("Других строк выписки на этот ПолучательСчет нет.");
		Иначе
			Строки.Добавить("Кандидаты в выписке на этот ПолучательСчет (кроме первой):");
			Для Каждого Кандидат Из Кандидаты Цикл
				Разница = Окр(Кандидат.Сумма - СуммаОстатка, 2);
				Строки.Добавить("  - № " + Кандидат.Номер
					+ "; сумма " + Формат(Кандидат.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=0")
					+ "; разница с остатком " + Формат(Разница, "ЧДЦ=2; ЧН=0; ЧГ=0")
					+ "; ПлательщикСчет " + Кандидат.ПлательщикСчет
					+ "; назначение: " + Лев(Кандидат.НазначениеПлатежа, 120));
			КонецЦикла;
		КонецЕсли;
		ТекстСообщения = ТекстСообщения + СтрСоединить(Строки, Символы.ПС);
		Возврат;
	КонецЕсли;

	НоваяОбработка.ВхНомер = ВтораяСтрока.Номер;
	НоваяОбработка.НазначениеПлатежа = ВтораяСтрока.НазначениеПлатежа;
	НоваяОбработка.СоздатьПоступленияДС(Перечисления.ВидыОперацийПоручение.Перевод);
	Для Каждого НоваяОбработкаПорученияПоДС Из НоваяОбработка.ПорученияПоДС Цикл
		ЗаполнитьЗначенияСвойств(ПорученияПоДС_РДУ.Добавить(), НоваяОбработкаПорученияПоДС);
	КонецЦикла;

КонецПроцедуры

// Описание: Собирает суммы и количество поручений с/без подстроки комментария.
// Важно: запрос по Документ.Поручение возвращает уникальные ссылки.
// В ТЧ ПорученияПоДС строк может быть больше из-за дублей одной ссылки
// (типично JOIN с НачислениеЗадолженности при начитке) или пустой ссылки.
//
Функция СобратьДиагностикуКомментариевПоручений(ТабличнаяЧасть, ПодстрокаКомментария)

	Результат = Новый Структура(
		"Комментарии, СуммаГруппы, КоличествоГруппы, СуммаБезГруппы, КоличествоБезГруппы, СуммаВсех, КоличествоВсех,"
		+ "КоличествоУникальныхВЗапросе, КоличествоПустыхСсылок, КоличествоСтрокСДублями,"
		+ "ТекстРасхожденияСсылок, ПримерыДублей",
		Новый Соответствие, 0, 0, 0, 0, 0, 0, 0, 0, 0, "", Новый Массив);

	Если ТабличнаяЧасть.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Ссылки = Новый Массив;
	СчетчикСсылок = Новый Соответствие;
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		СсылкаПоручения = СтрокаТЧ.ПоручениеПоДС;
		Если Не ЗначениеЗаполнено(СсылкаПоручения) Тогда
			Результат.КоличествоПустыхСсылок = Результат.КоличествоПустыхСсылок + 1;
		Иначе
			Ссылки.Добавить(СсылкаПоручения);
			Счетчик = СчетчикСсылок.Получить(СсылкаПоручения);
			Если Счетчик = Неопределено Тогда
				СчетчикСсылок.Вставить(СсылкаПоручения, 1);
			Иначе
				СчетчикСсылок.Вставить(СсылкаПоручения, Счетчик + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если Ссылки.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Поручение.Ссылка КАК Ссылка,
		|	Поручение.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.Поручение КАК Поручение
		|ГДЕ
		|	Поручение.Ссылка В (&Ссылки)";
		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Комментарии.Вставить(Выборка.Ссылка, Строка(Выборка.Комментарий));
			Результат.КоличествоУникальныхВЗапросе = Результат.КоличествоУникальныхВЗапросе + 1;
		КонецЦикла;
	КонецЕсли;

	Для Каждого КлючИЗначение Из СчетчикСсылок Цикл
		Если КлючИЗначение.Значение > 1 Тогда
			Результат.КоличествоСтрокСДублями = Результат.КоличествоСтрокСДублями + КлючИЗначение.Значение;
			Если Результат.ПримерыДублей.Количество() < 5 Тогда
				Результат.ПримерыДублей.Добавить(Строка(КлючИЗначение.Ключ)
					+ " x" + Формат(КлючИЗначение.Значение, "ЧГ=0"));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.ПоручениеПоДС) Тогда
			Результат.СуммаБезГруппы = Результат.СуммаБезГруппы + СтрокаТЧ.СуммаДС;
			Результат.КоличествоБезГруппы = Результат.КоличествоБезГруппы + 1;
			Продолжить;
		КонецЕсли;
		Комментарий = Результат.Комментарии.Получить(СтрокаТЧ.ПоручениеПоДС);
		ЕстьКомментарий = Комментарий <> Неопределено
			И Найти(ВРег(Комментарий), ВРег(ПодстрокаКомментария)) > 0;
		Если ЕстьКомментарий Тогда
			Результат.СуммаГруппы = Результат.СуммаГруппы + СтрокаТЧ.СуммаДС;
			Результат.КоличествоГруппы = Результат.КоличествоГруппы + 1;
		Иначе
			Результат.СуммаБезГруппы = Результат.СуммаБезГруппы + СтрокаТЧ.СуммаДС;
			Результат.КоличествоБезГруппы = Результат.КоличествоБезГруппы + 1;
		КонецЕсли;
	КонецЦикла;

	Результат.СуммаГруппы = Окр(Результат.СуммаГруппы, 2);
	Результат.СуммаБезГруппы = Окр(Результат.СуммаБезГруппы, 2);
	Результат.СуммаВсех = Окр(ТабличнаяЧасть.Итог("СуммаДС"), 2);
	Результат.КоличествоВсех = ТабличнаяЧасть.Количество();

	РазницаСтрок = Результат.КоличествоВсех - Результат.КоличествоУникальныхВЗапросе
		- Результат.КоличествоПустыхСсылок;
	Если РазницаСтрок <> 0 Или Результат.КоличествоПустыхСсылок > 0
		Или Результат.КоличествоСтрокСДублями > 0 Тогда
		Части = Новый Массив;
		Части.Добавить("ТЧ ПорученияПоДС: " + Формат(Результат.КоличествоВсех, "ЧГ=0")
			+ " стр.; запрос комментариев: "
			+ Формат(Результат.КоличествоУникальныхВЗапросе, "ЧГ=0")
			+ " уник. док.");
		Если Результат.КоличествоПустыхСсылок > 0 Тогда
			Части.Добавить("пустых ссылок ПоручениеПоДС: "
				+ Формат(Результат.КоличествоПустыхСсылок, "ЧГ=0"));
		КонецЕсли;
		Если Результат.КоличествоСтрокСДублями > 0 Тогда
			Части.Добавить("строк с дублями одной ссылки: "
				+ Формат(Результат.КоличествоСтрокСДублями, "ЧГ=0")
				+ " (примеры: " + СтрСоединить(Результат.ПримерыДублей, "; ") + ")");
			Части.Добавить("суммы по таким строкам считаются повторно — это раздувает Итог(СуммаДС)");
		КонецЕсли;
		Если РазницаСтрок > 0 И Результат.КоличествоСтрокСДублями = 0
			И Результат.КоличествоПустыхСсылок = 0 Тогда
			Части.Добавить("разница ТЧ-запрос=" + Формат(РазницаСтрок, "ЧГ=0")
				+ " (ссылка есть в ТЧ, но документ не найден запросом)");
		КонецЕсли;
		Результат.ТекстРасхожденияСсылок = СтрСоединить(Части, "; ");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Описание: Подробный текст, почему сумма поручений не совпала с суммой платежки выписки.
Функция ТекстДиагностикиНесовпаденияСуммРДУ(НайденнаяСтрока, ВидОперации, НоваяОбработка,
	СуммаПлатежки, СуммаДСПосле, СуммаДоОтбора, КоличествоДоОтбора, ОтборСработал,
	ПодстрокаКомментария, ДиагностикаДоОтбора)

	Строки = Новый Массив;
	Строки.Добавить(Символы.ПС);
	Строки.Добавить("IMDEV-9202. Сумма поручений по ДС не совпадает с суммой платежки выписки.");
	Строки.Добавить("Вид операции: " + Строка(ВидОперации) + ".");
	Строки.Добавить("Платежка выписки:");
	Строки.Добавить("  Номер: " + СокрЛП(Строка(НайденнаяСтрока.Номер))
		+ "; дата поступления: " + Формат(НайденнаяСтрока.ДатаПоступления, "ДФ=dd.MM.yyyy; ДП=-")
		+ "; сумма: " + Формат(СуммаПлатежки, "ЧДЦ=2; ЧН=0; ЧГ=0") + ".");
	Строки.Добавить("  ПлательщикСчет: " + СокрЛП(Строка(НайденнаяСтрока.ПлательщикСчет))
		+ "; ПолучательСчет: " + СокрЛП(Строка(НайденнаяСтрока.ПолучательСчет)) + ".");
	Назначение = СокрЛП(Строка(НайденнаяСтрока.НазначениеПлатежа));
	Если СтрДлина(Назначение) > 200 Тогда
		Назначение = Лев(Назначение, 200) + "...";
	КонецЕсли;
	Строки.Добавить("  Назначение: " + Назначение);

	Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
		ТЧ = НоваяОбработка.ПорученияПоДС;
	Иначе
		ТЧ = НоваяОбработка.ПорученияПоДСВвод;
	КонецЕсли;

	Строки.Добавить("Поручения:");
	Строки.Добавить("  После начитки: сумма " + Формат(СуммаДоОтбора, "ЧДЦ=2; ЧН=0; ЧГ=0")
		+ "; строк " + Формат(КоличествоДоОтбора, "ЧГ=0") + ".");
	Строки.Добавить("  После попытки отбора: сумма " + Формат(Окр(СуммаДСПосле, 2), "ЧДЦ=2; ЧН=0; ЧГ=0")
		+ "; строк " + Формат(ТЧ.Количество(), "ЧГ=0") + ".");
	Строки.Добавить("  Разница (поручения после отбора - платежка): "
		+ Формат(Окр(СуммаДСПосле - СуммаПлатежки, 2), "ЧДЦ=2; ЧН=0; ЧГ=0") + ".");

	Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
		Если ОтборСработал = Истина Тогда
			Строки.Добавить("  Отбор по комментарию «" + ПодстрокаКомментария
				+ "»: сработал, но после отбора сумма всё равно не равна платежке.");
		ИначеЕсли ОтборСработал = Ложь Тогда
			Строки.Добавить("  Отбор по комментарию «" + ПодстрокаКомментария
				+ "»: НЕ сработал (ни группа, ни остаток не равны сумме платежки).");
		Иначе
			Строки.Добавить("  Отбор по комментарию не вызывался.");
		КонецЕсли;

		Если ДиагностикаДоОтбора <> Неопределено Тогда
			Строки.Добавить("  Разрез по комментарию «" + ПодстрокаКомментария + "» (начитка ДО отбора):");
			Строки.Добавить("    С комментарием: сумма "
				+ Формат(ДиагностикаДоОтбора.СуммаГруппы, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ "; строк " + Формат(ДиагностикаДоОтбора.КоличествоГруппы, "ЧГ=0")
				+ "; равно платежке: "
				+ ?(ДиагностикаДоОтбора.СуммаГруппы = Окр(СуммаПлатежки, 2), "да", "нет") + ".");
			Строки.Добавить("    Без комментария: сумма "
				+ Формат(ДиагностикаДоОтбора.СуммаБезГруппы, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ "; строк " + Формат(ДиагностикаДоОтбора.КоличествоБезГруппы, "ЧГ=0")
				+ "; равно платежке: "
				+ ?(ДиагностикаДоОтбора.СуммаБезГруппы = Окр(СуммаПлатежки, 2), "да", "нет") + ".");
			Строки.Добавить("    Всего: сумма " + Формат(ДиагностикаДоОтбора.СуммаВсех, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ "; строк " + Формат(ДиагностикаДоОтбора.КоличествоВсех, "ЧГ=0") + ".");
			Если ЗначениеЗаполнено(ДиагностикаДоОтбора.ТекстРасхожденияСсылок) Тогда
				Строки.Добавить("  ВНИМАНИЕ, расхождение ТЧ и запроса комментариев:");
				Строки.Добавить("    " + ДиагностикаДоОтбора.ТекстРасхожденияСсылок);
			КонецЕсли;
		КонецЕсли;

		Строки.Добавить("Другие строки выписки на тот же ПолучательСчет (подсказка для второй платежки):");
		Отбор = Новый Структура("ПолучательСчет", НайденнаяСтрока.ПолучательСчет);
		ЕстьКандидаты = Ложь;
		Для Каждого ТекСтрока Из ПлатежныеДокументы.Выгрузить(Отбор) Цикл
			Если СокрЛП(Строка(ТекСтрока.Номер)) = СокрЛП(Строка(НайденнаяСтрока.Номер)) Тогда
				Продолжить;
			КонецЕсли;
			ЕстьКандидаты = Истина;
			СуммаКандидата = 0;
			Попытка
				СуммаКандидата = Окр(Число(ТекСтрока.Сумма), 2);
			Исключение
				СуммаКандидата = 0;
			КонецПопытки;
			Строки.Добавить("  - № " + СокрЛП(Строка(ТекСтрока.Номер))
				+ "; сумма " + Формат(СуммаКандидата, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ "; ПлательщикСчет " + СокрЛП(Строка(ТекСтрока.ПлательщикСчет))
				+ "; назначение: " + Лев(СокрЛП(Строка(ТекСтрока.НазначениеПлатежа)), 100));
		КонецЦикла;
		Если Не ЕстьКандидаты Тогда
			Строки.Добавить("  (других строк нет)");
		КонецЕсли;
	КонецЕсли;

	Если СуммаПлатежки = 0 Тогда
		Строки.Добавить("Дополнительно: сумма платежки = 0 — создание не выполняется по условию Сумма <> 0.");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область IMDEV_9096_ФоноваяМассоваяЗагрузка

// IMDEV-9096 OPT-13: Загрузка одной группы отмеченных выписок (один БанковскийСчет + один ДоговорДУ)
//   в фоновом задании. Точка входа для ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки.
//   Обрабатывает выписки группы последовательно; на каждую выписку создаётся свой объект КлиентБанк -
//   логика и формируемые документы идентичны синхронному режиму формы (МассоваяЗагрузкаНаСервере).
//
// Параметры:
//   ПараметрыВыполнения - Строка - XML (ХранилищеЗначения) с пакетом группы. Структура пакета:
//       * БанковскийСчет - СправочникСсылка.БанковскиеСчета
//       * ДоговорДУ      - СправочникСсылка.ДоговорДУ
//       * ВыпискиГруппы  - Массив структур выписок:
//           КлючВыписки, ДатаСоздания, БанковскийСчетКод,
//           НачальныйОстаток, ВсегоПоступило, ВсегоСписано, КонечныйОстаток,
//           Платежи - ТаблицаЗначений (копия строк ТЧ ПлатежныеДокументы выписки)
//   АдресРезультата     - Строка - адрес временного хранилища, куда помещается XML результата группы.
//       Структура результата: Успех (Булево), ТекстОшибки (Строка),
//       Выписки (Массив: КлючВыписки, Загружена, Лог), Платежи (Массив: КлючВыписки, КлючДокумента, Загружен)
//
Процедура ЗагрузитьГруппуВыписокВФоне(ПараметрыВыполнения, АдресРезультата) Экспорт
	
	ПакетГруппы = XMLЗначение(Тип("ХранилищеЗначения"), ПараметрыВыполнения).Получить();
	
	РезультатГруппы = Новый Структура("Успех, ТекстОшибки, Выписки, Платежи", Истина, "", Новый Массив, Новый Массив);
	
	Попытка
		
		Для Каждого ДанныеВыписки Из ПакетГруппы.ВыпискиГруппы Цикл
			
			// Таблица расчётных счетов для КлиентБанк.Загрузить (как в синхронном режиме формы)
			Импорт_РасчетныеСчета = Новый ТаблицаЗначений;
			Для Каждого ИмяКолонки Из СтрРазделить("РасчСчет,ДатаНачала,ДатаКонца,НачальныйОстаток,ВсегоПоступило,ВсегоСписано,КонечныйОстаток,Начало,Конец,РасчетныйСчет,НачальнаяСумма,Поступило,Списано,КонечнаяСумма", ",") Цикл
				Импорт_РасчетныеСчета.Колонки.Добавить(ИмяКолонки);
			КонецЦикла;
			
			ОбработкаКлиентБанк = Обработки.КлиентБанк.Создать();
			ОбработкаКлиентБанк.БанковскийСчет = ПакетГруппы.БанковскийСчет;
			ОбработкаКлиентБанк.ДоговорДУ      = ПакетГруппы.ДоговорДУ;
			ЗаполнитьЗначенияСвойств(ОбработкаКлиентБанк, ДанныеВыписки, "НачальныйОстаток, ВсегоПоступило, ВсегоСписано, КонечныйОстаток");
			ОбработкаКлиентБанк.НачПериода = ДанныеВыписки.ДатаСоздания;
			ОбработкаКлиентБанк.КонПериода = ДанныеВыписки.ДатаСоздания;
			
			Для Каждого СтрокаПлатежки Из ДанныеВыписки.Платежи Цикл
				НоваяСтрока_ДокументыКИмпорту = ОбработкаКлиентБанк.ДокументыКИмпорту.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока_ДокументыКИмпорту, СтрокаПлатежки, , "Лог,Загружен");
				НоваяСтрока_ПлатежныеДокументы = ОбработкаКлиентБанк.ПлатежныеДокументы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока_ПлатежныеДокументы, СтрокаПлатежки);
			КонецЦикла;
			
			Обработки.КлиентБанк.РазобратьДанныеИмпорта(ОбработкаКлиентБанк.ДоговорДУ, ОбработкаКлиентБанк.БанковскийСчет, ОбработкаКлиентБанк.ДокументыКИмпорту, Неопределено);
			Обработки.КлиентБанк.ПроверитьЗаполнениеТаблицыДокументов(ОбработкаКлиентБанк, ОбработкаКлиентБанк.ПлатежныеДокументы);
			Обработки.КлиентБанк.Загрузить(ОбработкаКлиентБанк.ДокументыКИмпорту, Неопределено, Неопределено, ОбработкаКлиентБанк.ДоговорДУ, Импорт_РасчетныеСчета,
				ОбработкаКлиентБанк.ИспользоватьГраницуОбработки, ОбработкаКлиентБанк.ДатаГраницыОбработки, ОбработкаКлиентБанк.БанковскийСчет);
			Обработки.КлиентБанк.ПослеЗагрузкиВыписки(ОбработкаКлиентБанк);
			
			ВсеПлатежкиЗагружены = Истина;
			ОбщийЛогПоВыписке = "";
			Для Каждого СтрокаПлатежки Из ДанныеВыписки.Платежи Цикл
				НайденнаяСтрока = ОбработкаКлиентБанк.ДокументыКИмпорту.Найти(СтрокаПлатежки.КлючДокумента, "КлючДокумента");
				Загружен = Ложь;
				Если НайденнаяСтрока <> Неопределено Тогда
					Загружен = НайденнаяСтрока.Загружен;
					// Представление ПП - тот же формат, что в форме (ПредставлениеПП)
					ОбщийЛогПоВыписке = ОбщийЛогПоВыписке + Символы.ПС
						+ НайденнаяСтрока.Номер + " " + Формат(НайденнаяСтрока.Дата, "ДФ=dd.MM.yyyy") + " Сумма: " + НайденнаяСтрока.Сумма
						+ " Плательщик:" + НайденнаяСтрока.Плательщик + " Получатель:" + НайденнаяСтрока.Получатель + " Назначение платежа:" + НайденнаяСтрока.НазначениеПлатежа
						+ Символы.ПС + СокрЛП(НайденнаяСтрока.Лог);
				КонецЕсли;
				Если Не Загружен Тогда
					ВсеПлатежкиЗагружены = Ложь;
				КонецЕсли;
				РезультатГруппы.Платежи.Добавить(Новый Структура("КлючВыписки, КлючДокумента, Загружен", ДанныеВыписки.КлючВыписки, СтрокаПлатежки.КлючДокумента, Загружен));
			КонецЦикла;
			
			ЛогВыписки = "";
			Если ВсеПлатежкиЗагружены Тогда
				// Представление выписки - тот же формат, что в форме (ПредставлениеВыписки)
				ЛогВыписки = "Выписка: " + ДанныеВыписки.ДатаСоздания + Символы.Таб + ПакетГруппы.ДоговорДУ + Символы.Таб + ДанныеВыписки.БанковскийСчетКод
					+ Символы.ПС + СокрЛП(ОбщийЛогПоВыписке);
			КонецЕсли;
			РезультатГруппы.Выписки.Добавить(Новый Структура("КлючВыписки, Загружена, Лог", ДанныеВыписки.КлючВыписки, ВсеПлатежкиЗагружены, ЛогВыписки));
			
		КонецЦикла;
		
	Исключение
		РезультатГруппы.Успех = Ложь;
		РезультатГруппы.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(XMLСтрока(Новый ХранилищеЗначения(РезультатГруппы)), АдресРезультата);
	
КонецПроцедуры

#КонецОбласти
