	// IMDEV-8927 --
	
	ОсновноеПространствоИмен = "http://www.avancore.ru/bank_statements"; 
	ПолноеИмяФайлаWSDL = ПолучитьИмяВременногоФайла("wsdl");
	
	ФайлWSDL = ПолучитьМакет("WSDL");
	ФайлWSDL.Записать(ПолноеИмяФайлаWSDL);
	
	Попытка 
		Определение = Новый WSОпределения(ПолноеИмяФайлаWSDL);
		
		Фабрика = Определение.ФабрикаXDTO;
		
		Корень_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "Корень");
		Условия_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "Условия");
		Корень 		= Фабрика.Создать(Корень_ТИП);
		Условия 	= Фабрика.Создать(Условия_ТИП);
		
//		IMAPPS-949
//		ОтборУстановлен = Ложь;
//		СписокСчетов = СписокБанковскихСчетовПоОтбору(ОтборУстановлен);
		ОтборУстановлен = СписокСчетов.Количество()>0;
		
//		IMAPPS-508
		Если ОтборУстановлен Тогда
			ТекстСчетов = "";
			Для Каждого ТекСчет Из СписокСчетов Цикл
				Если ТекСчет.Значение.ПометкаУдаления Тогда
					Продолжить;
				КонецЕсли;
				Если СтрДлина(ТекСчет.Значение.НомерСчета) <> 20 Тогда
					Сообщить("Длина счета не равна 20: " + ТекСчет.Значение.НомерСчета + ". Счет проигнорирован.");
					Продолжить;	
				КонецЕсли;
				ТекстСчетов = ТекстСчетов + ТекСчет.Значение.НомерСчета + ";";
			КонецЦикла;
			Условия.Счета = ТекстСчетов;
		КонецЕсли;
//		Сообщить(СтрДлина(Условия.Счета));		
//		Сообщить(Условия.Счета);		
		Если СтрДлина(ТекстСчетов) > 8000 Тогда
			Сообщить("Выбрано слишком много счетов = " + Строка(СтрДлина(ТекстСчетов)/21) + ". Загрузка выписок невозможна! Максимально возможное число счетов = 380.");
			// IMDEV-8927 ++
			КоличествоСчетовЗамера = КоличествоСчетовОтбораЗамера();
			КлючеваяОперацияПолучение = ПолучитьИмяКлючевойОперацииЗамера("ПолучениеWEB_VTB");
			ВремяНачалаЗамераПолучение = НачатьЗамерОперации();
			КомментарийЗамераПолучение = "Слишком много счетов"
				+ "; Счетов=" + КоличествоСчетовЗамера
				+ ДополнениеКомментарияПериодЗагрузки(ТестовыйРежим)
				+ "; Отказ=Да"
				+ ДополнениеКомментарияУдельныйВес(1, ВремяНачалаЗамераПолучение);
			ЗакончитьЗамерОперации(
				КлючеваяОперацияПолучение,
				ВремяНачалаЗамераПолучение,
				1,
				КомментарийЗамераПолучение,
				Истина);
			ВремяНачалаЗамераПолучение = 0;
			// IMDEV-8927 --
			Возврат;
		КонецЕсли;
		
		Условия.ДатаС 	 = ДатаНачала;
		Условия.ДатаПо	 = ДатаОкончания;
		Условия.ТипСчета = ТипСчетов;
		Корень.Условия = Условия;
		
		// IMDEV-8927 ++
		КоличествоСчетовЗамера = КоличествоСчетовОтбораЗамера();
		КлючеваяОперацияПолучение = ПолучитьИмяКлючевойОперацииЗамера("ПолучениеWEB_VTB");
		ВремяНачалаЗамераПолучение = НачатьЗамерОперации();
		// IMDEV-8927 --
		
		Если ТестовыйРежим тогда
			Ответ = ТестовыеДанные(Фабрика, Корень_ТИП);
		Иначе
			Ответ = ДанныеЧерезСервис(Определение, Корень);
		КонецЕсли;
		
		// IMDEV-8927 ++
		Если ВремяНачалаЗамераПолучение > 0 Тогда
			КоличествоВыписокВОтвете = Ответ.Выписки.Количество();
			ВесЗамераПолучение = ?(КоличествоВыписокВОтвете > 0, КоличествоВыписокВОтвете, 1);
			КомментарийЗамераПолучение = "ВыписокВОтвете=" + КоличествоВыписокВОтвете
				+ "; Счетов=" + КоличествоСчетовЗамера
				+ ДополнениеКомментарияПериодЗагрузки(ТестовыйРежим)
				+ "; Отказ=Нет"
				+ ДополнениеКомментарияУдельныйВес(ВесЗамераПолучение, ВремяНачалаЗамераПолучение);
			ЗакончитьЗамерОперации(
				КлючеваяОперацияПолучение,
				ВремяНачалаЗамераПолучение,
				ВесЗамераПолучение,
				КомментарийЗамераПолучение,
				Ложь);
			ВремяНачалаЗамераПолучение = 0;
		КонецЕсли;
		// IMDEV-8927 --
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		Отказ = Истина;
		
		// IMDEV-8927 ++
		Если ВремяНачалаЗамераПолучение > 0 Тогда
			КомментарийЗамераПолучение = "Ошибка WS: " + ОписаниеОшибки()
				+ "; Счетов=" + КоличествоСчетовЗамера
				+ ДополнениеКомментарияПериодЗагрузки(ТестовыйРежим)
				+ "; Отказ=Да"
				+ ДополнениеКомментарияУдельныйВес(1, ВремяНачалаЗамераПолучение);
			ЗакончитьЗамерОперации(
				КлючеваяОперацияПолучение,
				ВремяНачалаЗамераПолучение,
				1,
				КомментарийЗамераПолучение,
				Истина);
			ВремяНачалаЗамераПолучение = 0;
		КонецЕсли;
		// IMDEV-8927 --
		
	КонецПопытки;
	
	Если Отказ=Истина тогда возврат; КонецЕсли;
	
	// IMDEV-8927 ++
	КлючеваяОперацияРазбор = ПолучитьИмяКлючевойОперацииЗамера("РазборВыписок");
	ВремяНачалаЗамераРазбор = НачатьЗамерОперации();
	// IMDEV-8927 --
	
	ПрочитатьОбъекты(Ответ);
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераРазбор > 0 Тогда
		КоличествоВыписокЗамера = Выписки.Количество();
		КоличествоПлатежейЗамера = ПлатежныеДокументы.Количество();
		КоличествоДоговоровЗамера = КоличествоУникальныхДоговоровВыписки();
		ВесЗамераРазбор = ?(КоличествоПлатежейЗамера > 0, КоличествоПлатежейЗамера, 1);
		КомментарийЗамераРазбор = "Выписок=" + КоличествоВыписокЗамера
			+ "; Платежей=" + КоличествоПлатежейЗамера
			+ "; Договоров=" + КоличествоДоговоровЗамера
			+ ДополнениеКомментарияПериодЗагрузки(ТестовыйРежим)
			+ "; Отказ=Нет"
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераРазбор, ВремяНачалаЗамераРазбор);
		ЗакончитьЗамерОперации(
			КлючеваяОперацияРазбор,
			ВремяНачалаЗамераРазбор,
			ВесЗамераРазбор,
			КомментарийЗамераРазбор,
			Ложь);
	КонецЕсли;
	// IMDEV-8927 --
	
КонецПроцедуры

