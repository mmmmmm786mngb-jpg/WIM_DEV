Функция ВТБ_ЗаполнитьШаблон(стрШаблон, СтрокаПлатежа)
	
	стрОтвет = СокрЛП(стрШаблон);
	дл = СтрДлина(стрОтвет);
	поз =  0;
	стрПараметр = "";
	масПараметры = новый Массив;
	Пока поз < дл Цикл
		поз = поз+1;
		сс = Сред(стрОтвет, поз, 1);
		Если сс = "[" Тогда
			стрПараметр = "";
			Пока Истина Цикл
				поз = поз+1;
				Если поз > дл Тогда
					Прервать;
				КонецЕсли;
				сс = Сред(стрОтвет, поз, 1);
				Если сс = "]" Тогда 
					масПараметры.Добавить(стрПараметр);
					Прервать;
				КонецЕсли;
				стрПараметр = стрПараметр+сс;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого стрПараметр Из масПараметры Цикл
		// Сообщить("стр параметр: "+стрПараметр);
		Попытка
			обТекст = новый ТекстовыйДокумент;
			обТекст.УстановитьТекст(СтрЗаменить(стрПараметр, ".", Символы.ПС));
			стрОбъект = обТекст.ПолучитьСтроку(1);
			стрСвойство = обТекст.ПолучитьСтроку(2);
			знчСвойство = СтрокаПлатежа[стрОбъект][стрСвойство];
			Если ТипЗнч(знчСвойство) = Тип("Дата") Тогда
				знчСвойство = Формат(знчСвойство, "ДФ=dd.MM.yyyy");
			КонецЕсли;
			стрОтвет = СтрЗаменить(стрОтвет, "["+стрПараметр+"]", знчСвойство);
		Исключение
			Сообщить("Ошибка в параметре: "+стрПараметр+". "+ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	Возврат стрОтвет;
КонецФункции

Функция ЕРС_ДоговорДУ_ВнебиржеваяСделкаПоTRN(НазначениеПлатежа)
	
	ПозицияНач = Найти(НазначениеПлатежа, "TRN");
	
	Если ПозицияНач <> 0 Тогда
		Подстрока = Сред(НазначениеПлатежа, ПозицияНач + 4, СтрДлина(НазначениеПлатежа) - ПозицияНач - 3);
		ПозицияКон = Найти(Подстрока, " ");
		Если ПозицияКон <> 0 Тогда
			НомерTRN = Лев(Подстрока, ПозицияКон - 1);
		Иначе
			НомерTRN = Подстрока;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВнебиржеваяСделка.Ссылка КАК БП
			|ИЗ
			|	БизнесПроцесс.ВнебиржеваяСделка КАК ВнебиржеваяСделка
			|ГДЕ
			|	НЕ ВнебиржеваяСделка.ПометкаУдаления
			|	И ВнебиржеваяСделка.ДоговорКонтрагента.НомерДоговора = &Номер";

		Запрос.УстановитьПараметр("Номер", НомерTRN);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			БП = Выборка.БП;
		Иначе
			Возврат Справочники.ДоговорДУ.ПустаяСсылка();	
		КонецЕсли;

		Возврат БП.ДоговорДУ;
	Иначе
		Возврат Справочники.ДоговорДУ.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

