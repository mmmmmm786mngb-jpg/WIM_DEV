Функция _ДепозитарныйКод(ссКонтрагент, ссКонтрагентБанк, Отказ)
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ссКонтрагент", ссКонтрагент);
	Запрос.УстановитьПараметр("ссДепозитарий", ссКонтрагентБанк);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Код
	|ИЗ
	|	Справочник.Контрагенты.ИдентификаторВДепозитарии КАК т
	|ГДЕ
	|	т.Контрагент = &ссДепозитарий
	|	И т.Ссылка = &ссКонтрагент";
	
	Ответ = "-";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ответ = СокрЛП(Выборка.Код);
	Иначе
		Сообщить("Для контрагента: "+ссКонтрагент+" не найден депозитарный код.");
		Отказ = Истина;
	КонецЕсли;
	
	Возврат Ответ;
КонецФункции

Функция _ПривестиСтроку(СтруктураПП, вхСтрока, флТранскрипт, ОписаниеПоля, МинРазмерПоля, МаксРазмерПоля, Отказ)
	
	Ответ = СокрЛП(вхСтрока);
	
	Если Ответ = "" и МинРазмерПоля > 0 Тогда
		Сообщить("В документе №"+СтруктураПП.ПП_Номер+" не указан "+ОписаниеПоля);
		Ответ = "-";
		Отказ = Истина;
	КонецЕсли;
	
	Если флТранскрипт Тогда
		Ответ = Транскрипт(Ответ);
		Ответ = СтрЗаменить(Ответ, "№", "N");
	КонецЕсли;
	
	Если МаксРазмерПоля <> 0 и СтрДлина(Ответ) > МаксРазмерПоля Тогда
		Сообщить("В документе №"+СтруктураПП.ПП_Номер+" строка превышает "+МаксРазмерПоля+" символов: "+Ответ);
		Ответ = Лев(Ответ, МаксРазмерПоля);
		Отказ = Истина;
	КонецЕсли;
	
	Возврат Ответ;
КонецФункции

Функция НовЗапДок(Парам, стрТип) Экспорт
	ПространствоИменДокумент = "urn:iso:std:iso:20022:tech:xsd:pain.001.001.08";
	Об = Парам.ФабрикаXSD.Создать(Парам.ФабрикаXSD.Тип(Парам.ПространствоИмен, стрТип));
	Возврат Об;
КонецФункции

Функция НормИНН(вхИНН)
	
	выхИНН = СокрЛП(вхИНН);
	Если выхИНН = "" Тогда
		выхИНН = "0";
	//IMAPPS-9793	
	//ИначеЕсли  вхИНН = "000000000000" Тогда
		//выхИНН = "0";
	//IMAPPS-9793
	КонецЕсли;
	
	Возврат выхИНН;
КонецФункции

