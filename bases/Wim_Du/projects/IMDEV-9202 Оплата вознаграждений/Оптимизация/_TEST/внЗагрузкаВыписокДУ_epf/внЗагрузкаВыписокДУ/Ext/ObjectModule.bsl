		обOthr.SchmeNm = НовЗапДок(ПарамД, "OrganisationIdentificationSchemeName1Choice");
		обOthr.SchmeNm.Cd = "TXID";
		обДокумент.CstmrCdtTrfInitn.PmtInf.Dbtr.Id.OrgId.Othr.Добавить(обOthr);
	Иначе
		обДокумент.CstmrCdtTrfInitn.PmtInf.Dbtr.Id.PrvtId = НовЗапДок(ПарамД, "PersonIdentification5");
