Функция ОставитьТолькоЦифры(ВхСтрока) Экспорт
	
	Результат = "";
	ВремСтрока = СтрЗаменить(ВхСтрока, "Москва", "Moscow");
	
	Для лСч = 1 По СтрДлина(ВремСтрока) Цикл	
		ТекЛитера = Сред(ВремСтрока, лСч, 1);
		Если Найти("1234567890", ТекЛитера) > 0 Тогда
			Результат = Результат + ТекЛитера;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция УдалитьНедопустимыеСимволы(ВхСтрока, СтрокаНедопустимыхСимволов) Экспорт
	
	Результат = СокрЛП(ВхСтрока);
	
	Для лСч = 1 По СтрДлина(СтрокаНедопустимыхСимволов) Цикл	
		ТекЛитера = Сред(СтрокаНедопустимыхСимволов, лСч, 1);
		Результат = СтрЗаменить(Результат, ТекЛитера, "");
	КонецЦикла;
	
	Результат = СтрЗаменить(Результат, "  ", " ");
	Результат = СтрЗаменить(Результат, "  ", " ");
	Результат = СтрЗаменить(Результат, "  ", " ");
	Результат = СтрЗаменить(Результат, "  ", " ");
	
	Возврат Результат;
КонецФункции

Функция ЕРС_ДоговорДУ_ПоПолучательСчет(ПолучательСчет)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |			БанковскиеСчета.ДоговорДУ,
	               |			БанковскиеСчета.Ссылка
	               |		ИЗ
	               |			Справочник.БанковскиеСчета КАК БанковскиеСчета
	               |		ГДЕ
	               |			БанковскиеСчета.НомерСчета = &ПолучательСчет
	               |			И БанковскиеСчета.ДоговорДУ <> &ПустойДоговорДУ
				   |			И БанковскиеСчета.ВидСчета = &Депозитный
				   |			И НЕ БанковскиеСчета.ПометкаУдаления";
	Запрос.УстановитьПараметр("ПолучательСчет", ПолучательСчет);
	Запрос.УстановитьПараметр("ПустойДоговорДУ", Справочники.ДоговорДУ.ПустаяСсылка());
	Запрос.УстановитьПараметр("Депозитный", Перечисления.ВидБанковскогоСчета.Депозитный);
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ДоговорДУ;
	КонецЦикла;

		
//	Сообщить("ЕРС. Для счета и НАЗНАЧЕНИЯ ПЛАТЕЖА :"+ НомерСчета + " не определен ДоговорДУ");
	Возврат	Справочники.ДоговорДУ.ПустаяСсылка();
КонецФункции	

