Функция БанкXDTO(Банк)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", Банк.БИК);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Банки.Ссылка
	               |ИЗ
	               |	Справочник.Банки КАК Банки
	               |ГДЕ
	               |	Банки.Код = &Код
				   // VTB-Borisov  - 12.12.2016 {
				   |	И НЕ Банки.ПометкаУдаления
				   // VTB-Borisov  - 12.12.2016 }
				   |";

	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() тогда
		//Создаем банк

		РезультатЗапроса = Справочники.Банки.ПолучитьРезультатЗапросаПоКлассификатору(Банк.БИК,);
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Справочники.Банки.ПустаяСсылка();
		Иначе
			БанкПоКлассификатору = РезультатЗапроса.Выгрузить()[0];
			НовыйБанк = Справочники.Банки.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НовыйБанк,БанкПоКлассификатору);
			
			Попытка
				НовыйБанк.Код = БанкПоКлассификатору.БИК;
				НовыйБанк.Записать();
				Возврат НовыйБанк.Ссылка;
			Исключение
				Сообщить("Не найдена запись по БИК в справочнике Банки для БИК = "+ Банк.БИК);
				Возврат Справочники.Банки.ПустаяСсылка();
			КонецПопытки;

			
		КонецЕсли;
		
	КонецЕсли;
			
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	
КонецФункции

#Область OPT_02

// IMDEV-9096 OPT-02: СобратьУникальныеНомераСчетовДляКэшаДоговоровДУ
// Описание: Собирает номера счетов из XDTO-ответа сервиса до основного цикла ПрочитатьОбъекты.
// ВсеСчета - для пакетного SQL (выписки + плательщики платежей).
// СчетаВыписок - только счета выписок (для предупреждений при предзагрузке кэша).
//
// Параметры:
// Объекты - ОбъектXDTO - корень ответа с коллекцией Выписки
//
// Возвращаемое значение:
// Структура - СчетаВыписок (Массив), ВсеСчета (Массив)
//
Функция СобратьУникальныеНомераСчетовДляКэшаДоговоровДУ(Объекты)

	СчетаВыписок = Новый Соответствие;
	ВсеСчета = Новый Соответствие;

	Для Каждого ВыпискаXDTO Из Объекты.Выписки Цикл

		НомерСчетаВыписки = СокрЛП(ВыпискаXDTO.БанковскийСчет.НомерСчета);
		Если ЗначениеЗаполнено(НомерСчетаВыписки) Тогда
			СчетаВыписок.Вставить(НомерСчетаВыписки, Истина);
			ВсеСчета.Вставить(НомерСчетаВыписки, Истина);
		КонецЕсли;

		Для Каждого ПлатежXDTO Из ВыпискаXDTO.ПлатежныеДокументы Цикл

			Если ПлатежXDTO.ПлательщикСчет <> Неопределено Тогда
				НомерПлательщика = СокрЛП(ПлатежXDTO.ПлательщикСчет.НомерСчета);
				Если ЗначениеЗаполнено(НомерПлательщика) Тогда
					ВсеСчета.Вставить(НомерПлательщика, Истина);
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	МассивСчетовВыписок = Новый Массив;
	Для Каждого ЭлементМножества Из СчетаВыписок Цикл
		МассивСчетовВыписок.Добавить(ЭлементМножества.Ключ);
	КонецЦикла;

	МассивВсехСчетов = Новый Массив;
	Для Каждого ЭлементМножества Из ВсеСчета Цикл
		МассивВсехСчетов.Добавить(ЭлементМножества.Ключ);
	КонецЦикла;

	Возврат Новый Структура(
		"СчетаВыписок, ВсеСчета",
		МассивСчетовВыписок,
		МассивВсехСчетов);

КонецФункции

// IMDEV-9096 OPT-02: ЗаполнитьКэшДоговоровДУПоСчетам
// Описание: Один пакетный SQL вместо N вызовов ДоговорДУПоСчету в цикле ПрочитатьОбъекты.
// Для каждого запрошенного номера счета в кэше будет значение (даже если договор не найден).
//
// Алгоритм группировки - O(N): результат запроса (РАЗЛИЧНЫЕ пары НомерСчета+ДоговорДУ)
// раскладывается по Соответствию НомерСчета -> Структура(Договор, Неоднозначно).
// Дедупликация массивом не нужна - запрос уже возвращает уникальные пары, поэтому
// вторая строка по одному счету означает второй договор, то есть неоднозначность.
//
// Параметры:
// МассивНомеровСчетов - Массив - список нормализованных номеров счетов для SQL
// СчетаВыписокДляПредупреждений - Массив - необязательно; предупреждение только для этих счетов
// СчетаБезДоговораДУ - Соответствие - выходной; заполняется счетами с 0 строк (реально не найдены)
//
// Возвращаемое значение:
// Соответствие - ключ: НомерСчета (Строка), значение: СправочникСсылка.ДоговорДУ
//
Функция ЗаполнитьКэшДоговоровДУПоСчетам(МассивНомеровСчетов, СчетаВыписокДляПредупреждений = Неопределено, СчетаБезДоговораДУ = Неопределено)

	КэшДоговоровДУ = Новый Соответствие;

	// IMDEV-9096: множество счетов с 0 строк (точный аналог Результат.Пустой() в исходной ДоговорДУПоСчету).
	// Используется для вывода предупреждений только по реально не найденным счетам.
	Если СчетаБезДоговораДУ = Неопределено Тогда
		СчетаБезДоговораДУ = Новый Соответствие;
	КонецЕсли;

	Если МассивНомеровСчетов.Количество() = 0 Тогда
		Возврат КэшДоговоровДУ;
	КонецЕсли;

	МножествоДляПредупреждений = Новый Соответствие;
	Если СчетаВыписокДляПредупреждений = Неопределено Тогда
		Для Каждого НомерСчета Из МассивНомеровСчетов Цикл
			МножествоДляПредупреждений.Вставить(НомерСчета, Истина);
		КонецЦикла;
	Иначе
		Для Каждого НомерСчета Из СчетаВыписокДляПредупреждений Цикл
			МножествоДляПредупреждений.Вставить(НомерСчета, Истина);
		КонецЦикла;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВложенныйЗапрос.НомерСчета КАК НомерСчета,
	|	ВложенныйЗапрос.ДоговорДУ КАК ДоговорДУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		АналитическиеСчета.МестоХранения.НомерСчета КАК НомерСчета,
	|		АналитическиеСчета.ДоговорДУ КАК ДоговорДУ
	|	ИЗ
	|		Справочник.АналитическиеСчета КАК АналитическиеСчета
	|	ГДЕ
	|		АналитическиеСчета.МестоХранения.НомерСчета В (&СписокНомеровСчетов)
	|		И НЕ АналитическиеСчета.ПометкаУдаления
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		БанковскиеСчета.НомерСчета,
	|		БанковскиеСчета.ДоговорДУ
	|	ИЗ
	|		Справочник.БанковскиеСчета КАК БанковскиеСчета
	|	ГДЕ
	|		БанковскиеСчета.НомерСчета В (&СписокНомеровСчетов)
	|		И НЕ БанковскиеСчета.ПометкаУдаления) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСчета,
	|	ДоговорДУ УБЫВ";
	Запрос.УстановитьПараметр("СписокНомеровСчетов", МассивНомеровСчетов);

	// IMDEV-9096 OPT-02: единственный пакетный Запрос.Выполнить вместо ~255 одиночных
	Выборка = Запрос.Выполнить().Выбрать();

	// IMDEV-9096 OPT-02: группировка по счету за O(N) через Соответствие
	ДанныеПоСчету = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		НомерСчетаСтроки = СокрЛП(Выборка.НомерСчета);
		ДанныеСчета = ДанныеПоСчету.Получить(НомерСчетаСтроки);

		Если ДанныеСчета = Неопределено Тогда
			ДанныеСчета = Новый Структура("Договор, Неоднозначно", Выборка.ДоговорДУ, Ложь);
			ДанныеПоСчету.Вставить(НомерСчетаСтроки, ДанныеСчета);
		Иначе
			// IMDEV-9096 OPT-02: второй договор по счету = неоднозначность (как в исходной логике >1)
			ДанныеСчета.Неоднозначно = Истина;
		КонецЕсли;

	КонецЦикла;

	// IMDEV-9096 OPT-02: 0 строк - пустая ссылка + сообщение; 1 - договор; >1 - пустая ссылка
	ПустаяСсылкаДоговора = Справочники.ДоговорДУ.ПустаяСсылка();

	Для Каждого НомерСчета Из МассивНомеровСчетов Цикл

		ДанныеСчета = ДанныеПоСчету.Получить(НомерСчета);

		Если ДанныеСчета = Неопределено Тогда
			// IMDEV-9096: 0 строк = счет реально не найден (как Результат.Пустой() в оригинале)
			СчетаБезДоговораДУ.Вставить(НомерСчета, Истина);
			Если МножествоДляПредупреждений.Получить(НомерСчета) = Истина Тогда
				Сообщить("Для счета: " + НомерСчета + " не определен ДоговорДУ");
			КонецЕсли;
			КэшДоговоровДУ.Вставить(НомерСчета, ПустаяСсылкаДоговора);
		ИначеЕсли ДанныеСчета.Неоднозначно Тогда
			КэшДоговоровДУ.Вставить(НомерСчета, ПустаяСсылкаДоговора);
		Иначе
			КэшДоговоровДУ.Вставить(НомерСчета, ДанныеСчета.Договор);
		КонецЕсли;

	КонецЦикла;

	Возврат КэшДоговоровДУ;

КонецФункции

// IMDEV-9096 OPT-02: ДоговорДУПоСчетуОднимЗапросом (исходная логика IMAPPS-6760, fallback без кэша)
// Описание: Одиночный SQL-запрос договора по счету (исходная логика до оптимизации).
// Используется как fallback, если кэш не передан или счет отсутствует в кэше.
//
// Параметры:
// НомерСчета - Строка - номер счета
//
// Возвращаемое значение:
// СправочникСсылка.ДоговорДУ
//
Функция ДоговорДУПоСчетуОднимЗапросом(НомерСчета)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВложенныйЗапрос.ДоговорДУ КАК ДоговорДУ
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		АналитическиеСчета.ДоговорДУ КАК ДоговорДУ,
	               |		АналитическиеСчета.Ссылка КАК Ссылка
	               |	ИЗ
	               |		Справочник.АналитическиеСчета КАК АналитическиеСчета
	               |	ГДЕ
	               |		АналитическиеСчета.МестоХранения.НомерСчета = &НомерСчета
				   // VTB-Borisov  - 12.12.2016 {
				   |		И НЕ АналитическиеСчета.ПометкаУдаления
				   // VTB-Borisov  - 12.12.2016 }
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		БанковскиеСчета.ДоговорДУ,
	               |		БанковскиеСчета.Ссылка
	               |	ИЗ
	               |		Справочник.БанковскиеСчета КАК БанковскиеСчета
	               |	ГДЕ
	               |		БанковскиеСчета.НомерСчета = &НомерСчета
   				   // VTB-Borisov  - 12.12.2016 {
				   |		И НЕ БанковскиеСчета.ПометкаУдаления
				   // VTB-Borisov  - 12.12.2016 }
				   |	) КАК ВложенныйЗапрос
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДоговорДУ УБЫВ";
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Результат = Запрос.Выполнить();

	НайденныеДоговоры = Новый Массив;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НайденныеДоговоры.Добавить(Выборка.ДоговорДУ);
	КонецЦикла;

	КоличествоДоговоров = НайденныеДоговоры.Количество();
	Если КоличествоДоговоров = 0 Тогда
		Сообщить("Для счета: " + НомерСчета + " не определен ДоговорДУ");
		Возврат Справочники.ДоговорДУ.ПустаяСсылка();
	КонецЕсли;
	Если КоличествоДоговоров > 1 Тогда
		Возврат Справочники.ДоговорДУ.ПустаяСсылка();
	КонецЕсли;

	Возврат НайденныеДоговоры[0];

КонецФункции

// IMDEV-9096 OPT-02: ДоговорДУПоСчету (изменена - КэшДоговоровДУ, ВыводитьПредупреждение)
// Описание: Возвращает договор ДУ по номеру счета. При переданном кэше - без SQL (lookup в Соответствие).
//
// Параметры:
// НомерСчета - Строка - номер счета
// КэшДоговоровДУ - Соответствие - необязательно; результат ЗаполнитьКэшДоговоровДУПоСчетам
//
// Возвращаемое значение:
// СправочникСсылка.ДоговорДУ
//
Функция ДоговорДУПоСчету(НомерСчета, КэшДоговоровДУ = Неопределено, ВыводитьПредупреждение = Ложь)

	НомерСчетаНорм = СокрЛП(НомерСчета);

	Если Не ЗначениеЗаполнено(НомерСчетаНорм) Тогда
		Возврат Справочники.ДоговорДУ.ПустаяСсылка();
	КонецЕсли;

	Если КэшДоговоровДУ <> Неопределено Тогда

		// IMDEV-9096 OPT-02: чтение из предзагруженного кэша, без SQL
		ДоговорИзКэша = КэшДоговоровДУ.Получить(НомерСчетаНорм);

		Если ДоговорИзКэша <> Неопределено Тогда
			Если ВыводитьПредупреждение И Не ЗначениеЗаполнено(ДоговорИзКэша) Тогда
				Сообщить("Для счета: " + НомерСчетаНорм + " не определен ДоговорДУ");
			КонецЕсли;
			Возврат ДоговорИзКэша;
		КонецЕсли;

	КонецЕсли;

	// IMDEV-9096 OPT-02: fallback - счет не попал в предзагрузку кэша
	Возврат ДоговорДУПоСчетуОднимЗапросом(НомерСчетаНорм);

КонецФункции

#КонецОбласти

#Область OPT_18

// IMDEV-9096 OPT-18: ПостроитьКартуПрефиксовЕРС
// Описание: Строит карту префиксов договоров ДУ для быстрого поиска по назначению платежа.
//
// Параметры:
//   Данные - ТаблицаЗначений - результат ЕРС_ДоговорДУ_Отбор_ПоСчетуИНазначению
//
// Возвращаемое значение:
//   Соответствие - ключ: Префикс; значение: Структура("ДоговорДУ, Индекс")
//
Функция ПостроитьКартуПрефиксовЕРС(Знач Данные)
	Карта = Новый Соответствие;
	
	Если Данные = Неопределено Тогда
		Возврат Карта;
	КонецЕсли;
	
	Индекс = 0;
	Для Каждого Выборка Из Данные Цикл
		Если Карта.Получить(Выборка.Префикс) = Неопределено Тогда
			ДанныеПрефикса = Новый Структура("ДоговорДУ, Индекс", Выборка.ДоговорДУ, Индекс);
			Карта.Вставить(Выборка.Префикс, ДанныеПрефикса);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Карта;
КонецФункции

// IMDEV-9096 OPT-18: НайтиДоговорПоКартеПрефиксов
// Описание: Ищет договор ДУ по карте префиксов в нормализованном назначении платежа.
//
// Параметры:
//   ГдеИскать - Строка - назначение (ВРег, F->Ф, без пробелов и дефисов)
//   Карта     - Соответствие - результат ПостроитьКартуПрефиксовЕРС
//
// Возвращаемое значение:
//   СправочникСсылка.ДоговорДУ или Неопределено
//
Функция НайтиДоговорПоКартеПрефиксов(Знач ГдеИскать, Знач Карта)
	ЛучшийИндекс = -1;
	ЛучшийДоговор = Неопределено;
	
	Окончания = Новый Массив;
	Окончания.Добавить("ОТ");
	Окончания.Добавить("OT");
	
	ПозицияФ = СтрНайти(ГдеИскать, "Ф");
	Пока ПозицияФ > 0 Цикл
		НачалоКандидата = ПозицияФ + 1;
		
		Для Каждого Окончание Из Окончания Цикл
			ПозицияОкончания = СтрНайти(ГдеИскать, Окончание, НаправлениеПоиска.СНачала, НачалоКандидата);
			Пока ПозицияОкончания > 0 Цикл
				ДлинаКандидата = ПозицияОкончания - НачалоКандидата;
				Если ДлинаКандидата >= 0 Тогда
					Кандидат = Сред(ГдеИскать, НачалоКандидата, ДлинаКандидата);
					ДанныеПрефикса = Карта.Получить(Кандидат);
					Если ДанныеПрефикса <> Неопределено
						И (ЛучшийИндекс = -1 Или ДанныеПрефикса.Индекс < ЛучшийИндекс) Тогда
						ЛучшийИндекс = ДанныеПрефикса.Индекс;
						ЛучшийДоговор = ДанныеПрефикса.ДоговорДУ;
					КонецЕсли;
				КонецЕсли;
				ПозицияОкончания = СтрНайти(ГдеИскать, Окончание, НаправлениеПоиска.СНачала, ПозицияОкончания + 1);
			КонецЦикла;
		КонецЦикла;
		
		ПозицияФ = СтрНайти(ГдеИскать, "Ф", НаправлениеПоиска.СНачала, ПозицияФ + 1);
	КонецЦикла;
	
	Возврат ЛучшийДоговор;
КонецФункции

#КонецОбласти

