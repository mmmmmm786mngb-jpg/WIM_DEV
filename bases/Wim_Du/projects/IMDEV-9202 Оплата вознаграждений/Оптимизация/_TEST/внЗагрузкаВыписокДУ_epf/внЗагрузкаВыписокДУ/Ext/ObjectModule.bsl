Функция ПодготовитьТаблицуПлатежейСИТИ(ПлатежныеДокументы, Кодировка) Экспорт
	ПотокВыгрузки = Новый ТекстовыйДокумент();
	Для Каждого ТекПлатеж Из ПлатежныеДокументы Цикл
		СтрокаПотока = "";
		Для лСч = 1 По 92 Цикл
			Параметр = СокрЛП(ТекПлатеж[лСч - 1]);
			
			// Сумма в формате 34234.34
			Если лСч = 10 Тогда
				Параметр = СтрЗаменить(Параметр, ",", ".");	
				Если Найти(Параметр, ".") = 0 И СтрДлина(Параметр) > 0 Тогда
					Параметр = Параметр + ".00";
				КонецЕсли;
			КонецЕсли;
			
			// Номер платежки без пробелов
			// DDneprovsky 01.08.2018 IMAPPS-6747
			Если лСч = 25 Тогда
				Параметр = УдалитьЛидирующиеНули(СокрЛП(Параметр));
			КонецЕсли;
			
			// Дробление и транслитерация наименования получателя
			Если лСч = 45 Тогда
				Параметр = Транслитерировать(Параметр);
				Если СтрДлина(Параметр) > 35 Тогда
					Остаток = Сред(Параметр, 36);
					Параметр = Лев(Параметр, 35);
					ТекПлатеж[47 - 1] = Лев(Остаток, 35); Остаток = Сред(Остаток, 36);
					ТекПлатеж[48 - 1] = Лев(Остаток, 35); Остаток = Сред(Остаток, 36);
					ТекПлатеж[49 - 1] = Лев(Остаток, 35);
				КонецЕсли;
			КонецЕсли;
			
			Если лСч = 55 Тогда
				Параметр = Транслитерировать(Параметр);
				Параметр = УдалитьСпецСимволы(Параметр);
			КонецЕсли;
			
			// Сумма НДС в формате 34234.34
			Если лСч = 56 Тогда
				Параметр = СтрЗаменить(Параметр, ",", ".");	
				Если Найти(Параметр, ".") = 0  И СтрДлина(Параметр) > 0 Тогда
					Параметр = Параметр + ".00";
				КонецЕсли;
			КонецЕсли;
			
			// Дробление и транслитерация назначения платежа
			Если лСч = 72 Тогда
				Параметр = Транслитерировать(Параметр);
				Если СтрДлина(Параметр) > 35 Тогда
					Остаток = Сред(Параметр, 36);
					Параметр = Лев(Параметр, 35);
					ТекПлатеж[73 - 1] = Лев(Остаток, 35); Остаток = Сред(Остаток, 36);
					ТекПлатеж[74 - 1] = Лев(Остаток, 35); Остаток = Сред(Остаток, 36);
					ТекПлатеж[75 - 1] = Лев(Остаток, 35);
				КонецЕсли;
			КонецЕсли;
			
			СтрокаПотока = СтрокаПотока + СтрЗаменить(Параметр, Символ(160), "") + "#";
		КонецЦикла;
		ПотокВыгрузки.ДобавитьСтроку(СтрокаПотока);
	КонецЦикла;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");

	Если Кодировка = "DOS" Тогда
		ПотокВыгрузки.Записать(ИмяВременногоФайла, КодировкаТекста.OEM);
	Иначе
		ПотокВыгрузки.Записать(ИмяВременногоФайла, "windows-1251"); //КодировкаТекста.ANSI
	КонецЕсли;
	
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла)); 
	
	Возврат Адрес;
КонецФункции

Функция ЗаполнитьДокументыНаЭкспортВТБ(МассивДокументов) Экспорт
	СписокДокументов = Новый СписокЗначений();
	СписокДокументов.ЗагрузитьЗначения(МассивДокументов);
	
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	Запрос.УстановитьПараметр("УполномоченноеЛицоФИО", СокрЛП(УполномоченноеЛицоФИО));
	Запрос.УстановитьПараметр("УполномоченноеЛицоТелефон", СокрЛП(УполномоченноеЛицоТелефон));
	Запрос.УстановитьПараметр("ТаблицаДокументов", СписокДокументов);
	Запрос.УстановитьПараметр("ДатаВыгрузки", ТекущаяДата());
	Запрос.УстановитьПараметр("ДатаТр1", ДобавитьМесяц(ДатаНачала, -1));
	Запрос.УстановитьПараметр("ДатаТр2", КонецДня(ДатаОкончания));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПлатежноеПоручение.Ссылка КАК ПлатежноеПоручение
	|ПОМЕСТИТЬ втТаблицаДокументов
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	|ГДЕ
	|	ПлатежноеПоручение.Ссылка В(&ТаблицаДокументов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тПП.ПлатежноеПоручение,
	|	МАКСИМУМ(т.БанкПосредник) КАК БанкПосредник,
	|	МАКСИМУМ(т.НомерСчета) КАК БанкПосредникНомерСчета
	|ПОМЕСТИТЬ втДокументы
	|ИЗ
	|	втТаблицаДокументов КАК тПП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанкиПосредники.СписокБанковПосредников КАК т
	|		ПО (т.Ссылка.Владелец = тПП.ПлатежноеПоручение.СчетКонтрагента.Банк)
	|			И (т.Ссылка.Валюта = тПП.ПлатежноеПоручение.СчетКонтрагента.ВалютаДенежныхСредств)
	|			И (т.Ссылка.ДействующаяЦепочка = ИСТИНА)
	|
	|СГРУППИРОВАТЬ ПО
	|	тПП.ПлатежноеПоручение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДокументы.ПлатежноеПоручение КАК ДокСсылка,
	|	втДокументы.ПлатежноеПоручение.Дата КАК ПП_Дата,
	|	втДокументы.ПлатежноеПоручение.Номер КАК ПП_Номер,
	|	втДокументы.ПлатежноеПоручение.ДоговорДУ.Код КАК ДДУ_Номер,
	|	втДокументы.ПлатежноеПоручение.ДоговорДУ.ДатаНачала КАК ДДУ_Дата,
	|	втДокументы.ПлатежноеПоручение.ВалютаДокумента.Код КАК ПП_ВалютаДок,
	|	втДокументы.ПлатежноеПоручение.СчетДоговораДУ.Банк.Код КАК ПортфельБИК,
	|	втДокументы.ПлатежноеПоручение.ПеречислениеВБюджет КАК ПеречислениеВБюджет,
	|	втДокументы.ПлатежноеПоручение.СчетДоговораДУ.НомерСчета КАК ПортфельНомерСчета,
	|	втДокументы.ПлатежноеПоручение.СчетДоговораДУ.IBAN КАК ПортфельIBANСчета,
	|	втДокументы.ПлатежноеПоручение.СчетДоговораДУ.ВалютаДенежныхСредств КАК ВалютаПлательщика,
	|	втДокументы.ПлатежноеПоручение.СчетДоговораДУ.ВалютаДенежныхСредств.Код КАК ВалютаСписанияКод,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.Банк.СВИФТБИК КАК КонтрагентБанкКод,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.Банк.Код КАК КонтрагентБанкБИК,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.Банк.Наименование КАК КонтрагентБанкНаименование,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.Банк.КоррСчет КАК КонтрагентБанкКоррСчет,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.Банк.Адрес КАК КонтрагентБанкАдрес,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.Банк.Город КАК КонтрагентБанкГород,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.Банк.Страна.Код КАК КонтрагентБанкСтрана,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.НомерСчета КАК КонтрагентНомерСчета,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.IBAN КАК КонтрагентIBANСчета,
	|	втДокументы.ПлатежноеПоручение.Контрагент.НаименованиеПолное КАК КонтрагентНаименование,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(тДопНаименованиеАнгл.Значение, """") КАК СТРОКА(500)) КАК _КонтрагентНаименованиеАнгл_,
	|	втДокументы.ПлатежноеПоручение.Контрагент.ИНН КАК КонтрагентИНН,
	|	втДокументы.ПлатежноеПоручение.Контрагент КАК КонтрагентПолучатель,
	|	ки.Представление КАК КонтрагентАдрес,
	|	ВЫБОР
	|		КОГДА ки.Город = """"
	|			ТОГДА ВЫБОР
	|					КОГДА ки.Регион = """"
	|						ТОГДА ""-""
	|					ИНАЧЕ ки.Регион
	|				КОНЕЦ
	|		ИНАЧЕ ки.Город
	|	КОНЕЦ КАК КонтрагентГород,
	|	ВЫБОР
	|		КОГДА втДокументы.ПлатежноеПоручение.Контрагент.НеРезидент
	|			ТОГДА втДокументы.ПлатежноеПоручение.Контрагент.Страна.Код
	|		ИНАЧЕ ""643""
	|	КОНЕЦ КАК КонтрагентСтрана,
	|	втДокументы.ПлатежноеПоручение.СуммаДокумента КАК СуммаДокумента,
	|	втДокументы.ПлатежноеПоручение.НазначениеПлатежа КАК НазначениеПлатежа,
	|	""3"" КАК ДокОснТип,
	|	втДокументы.ПлатежноеПоручение.Комментарий КАК ДокОснНомер,
	|	втДокументы.ПлатежноеПоручение.ДоговорДУ.ДатаВводаСредствВДУ КАК ДокОснДата,
	|	ЕСТЬNULL(тДопКомментарий.Значение, """") КАК Примечание,
	|	втДокументы.ПлатежноеПоручение.ВалютаДокумента.Наименование КАК Валюта_ISO4217,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.ВалютаДенежныхСредств.Наименование КАК ВалютаЗачисления_ISO4217,
	|	втДокументы.ПлатежноеПоручение.ВалютаДокумента.Код КАК ВалютаДокумента,
	|	втДокументы.ПлатежноеПоручение.СтатьяДвиженияДенежныхСредств.ВидОперацииВал.Код КАК ВидОперацииКод,
	|	втДокументы.ПлатежноеПоручение.СчетДоговораДУ КАК СчетДоговораДУ,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента КАК СчетКонтрагента,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.Банк КАК БанкПолучателя,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.ВалютаДенежныхСредств КАК ВалютаПолучателя,
	|	втДокументы.ПлатежноеПоручение.СчетКонтрагента.ВалютаДенежныхСредств.Код КАК ВалютаПолучателяКод,
	|	ВЫБОР
	|		КОГДА втДокументы.БанкПосредник ЕСТЬ NULL
	|			ТОГДА ""0""
	|		ИНАЧЕ ""1""
	|	КОНЕЦ КАК ЕстьБанкПосредник,
	|	втДокументы.БанкПосредник.СВИФТБИК КАК БанкПосредникКод,
	|	втДокументы.БанкПосредник.Наименование КАК БанкПосредникНаименование,
	|	втДокументы.БанкПосредник.Адрес КАК БанкПосредникАдрес,
	|	втДокументы.БанкПосредник.Город КАК БанкПосредникГород,
	|	втДокументы.БанкПосредник.Страна.Код КАК БанкПосредникСтрана,
	|	втДокументы.БанкПосредникНомерСчета КАК БанкПосредникНомерСчета,
	|	табПоступлНаТС.НомерВходящегоДокумента КАК ОперТС_Номер,
	|	табПоступлНаТС.ДатаВходящегоДокумента КАК ОперТС_Дата,
	|	втДокументы.ПлатежноеПоручение.ДоговорДУ КАК ДоговорДУ,
	|	втДокументы.ПлатежноеПоручение.БизнесПроцесс КАК БП,
	|	втДокументы.ПлатежноеПоручение.ДокументОснование КАК ДО,
	|	втДокументы.ПлатежноеПоручение.ДоговорКонтрагента КАК Договор,
	|	втДокументы.ПлатежноеПоручение.ИННПлательщика КАК ИННПлательщика,
	|	втДокументы.ПлатежноеПоручение.КПППлательщика КАК КПППлательщика,
	|	втДокументы.ПлатежноеПоручение.ТекстПлательщика КАК ТекстПлательщика,
	|	втДокументы.ПлатежноеПоручение.ИННПолучателя КАК ИННПолучателя,
	|	втДокументы.ПлатежноеПоручение.КПППолучателя КАК КПППолучателя,
	|	втДокументы.ПлатежноеПоручение.ТекстПолучателя КАК ТекстПолучателя,
	|	втДокументы.ПлатежноеПоручение.ОчередностьПлатежа КАК ОчередностьПлатежа
	|ИЗ
	|	втДокументы КАК втДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			т.Ссылка КАК Ссылка,
	|			т.ДоговорДУ КАК ДоговорДУ,
	|			т.СчетДоговораДУ КАК СчетДоговораДУ,
	|			т.СуммаДокумента КАК СуммаДокумента,
	|			т.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|			т.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента
	|		ИЗ
	|			Документ.ПоступлениеНаРасчетныйСчет КАК т
	|		ГДЕ
	|			т.СчетДоговораДУ.ТранзитныйСчет
	|			И т.Дата МЕЖДУ &ДатаТр1 И &ДатаТр2) КАК табПоступлНаТС
	|		ПО втДокументы.ПлатежноеПоручение.ДоговорДУ = табПоступлНаТС.ДоговорДУ
	|			И втДокументы.ПлатежноеПоручение.СчетДоговораДУ = табПоступлНаТС.СчетДоговораДУ
	|			И втДокументы.ПлатежноеПоручение.СуммаДокумента = табПоступлНаТС.СуммаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.ДополнительныеРеквизиты КАК тДопКомментарий
	|		ПО втДокументы.ПлатежноеПоручение.Контрагент = тДопКомментарий.Ссылка
	|			И (тДопКомментарий.Свойство.Наименование ПОДОБНО ""Комментарий для п/п по сделке%"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.ДополнительныеРеквизиты КАК тДопНаименованиеАнгл
	|		ПО втДокументы.ПлатежноеПоручение.Контрагент = тДопНаименованиеАнгл.Ссылка
	|			И (тДопНаименованиеАнгл.Свойство.Наименование = ""АнглийскоеНаименование"")
	|			И (НЕ тДопНаименованиеАнгл.Свойство.ЭтоДополнительноеСведение)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК ки
	|		ПО втДокументы.ПлатежноеПоручение.Контрагент = ки.Ссылка
	|			И (ки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (ки.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента))";
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	//725-55-40 66237     Sopolnova
	Возврат ТЗ;	
КонецФункции

Функция ПодготовитьТаблицуПлатежейВТБ(Знач ПлатежныеДокументыВТБ, Знач Кодировка) Экспорт
	// IMAPPS-25144 ++
	//Перем ПлатежныеИдентификаторы, КлючПоиска;
	// IMAPPS-25144 --
	
	ПотокВыгрузки = Новый ТекстовыйДокумент();
	НомерДок = 1;
	
	соотвБИКфВТБ = новый Соответствие;
	соотвБИКфВТБ.Вставить("040349758", "VTB BANK (PJSC) Branch N 2351 in Krasnodar  ");
	соотвБИКфВТБ.Вставить("040813713", "VTB BANK (PJSC) Branch N 2754 in Khabarovsk  ");
	соотвБИКфВТБ.Вставить("042007855", "VTB BANK (PJSC) Branch N 3652 in Voronezh ");
	соотвБИКфВТБ.Вставить("045004719", "VTB BANK (PJSC) Branch N 5440 in Novosibirsk  ");
	соотвБИКфВТБ.Вставить("043601968", "VTB BANK (PJSC) Branch N 6318 in Samara  ");
	соотвБИКфВТБ.Вставить("046577501", "VTB BANK (PJSC) Branch N 6602 in Ekaterinburg  ");
	соотвБИКфВТБ.Вставить("044525745", "VTB BANK (PJSC) Branch N 7701 in Moscow  ");
	соотвБИКфВТБ.Вставить("044525745", "VTB BANK (PJSC) Branch N 7777 in Moscow   ");
	соотвБИКфВТБ.Вставить("044030707", "VTB BANK (PJSC) Branch N 7806 in Saint-Petersburg  ");
	соотвБИКфВТБ.Вставить("044525411", "VTB BANK (PJSC) Tsentralnyi Branch Moscow    ");
	соотвБИКфВТБ.Вставить("044525187", "VTB BANK (PJSC) YUZHNYI BRANCH, ROSTOV-ON-DON   ");
	соотвБИКфВТБ.Вставить("044525187", "VTB BANK (PJSC), NIZHNIY NOVGOROD BRANCH ");
	
	ПравилаВалютныйПеревод = ВТБ_ПравилаВалютныйПеревод();
	ПравилаПереводТранзитныйРасчетный = ВТБ_ПравилаПереводТранзитныйРасчетный();
	ПравилаКонвертация = ВТБ_ПравилаКонвертация();
	ПравилаПокупка = ВТБ_ПравилаПокупка();
	ПравилаПродажа = ВТБ_ПравилаПродажа();
	
	// IMAPPS-25144 ++
	//ПлатежныеИдентификаторы = ПолучитьПлатежныеИдентификаторыИзКлиентБанкаВТБ(
	//	ПлатежныеДокументыВТБ,
	//	"BSSClient_VTBAM",
	//	"BSCLIENTAM\DBMIM02",
	//	"svc_bcdata_feeds",
	//	"N4wV6sZ3mK6e"
	//);  // IMAPPS-5076: в коде, конечно, не правильно писать пароль/логин!
	// IMAPPS-25144 --
	
	ТипПлатПоручение = Тип("ДокументСсылка.Поручение");
	
	Для Каждого ТекПлатеж Из ПлатежныеДокументыВТБ Цикл
		СтрокаПотока = "";
		
		// DDneprovsky 01.08.2018 IMAPPS-6747 Необходимо удалить лидирующие нули при выгрузке в клиент банк
		ТекПлатеж.ПП_Номер = УдалитьЛидирующиеНули(ТекПлатеж.ПП_Номер);
		// DDneprovsky 01.08.2018 IMAPPS-6747 Необходимо удалить лидирующие нули при выгрузке в клиент банк

		Если не ЗначениеЗаполнено( ТекПлатеж.ВидОперацииКод) Тогда
			Сообщить("Для п/п № "+ТекПлатеж.ПП_Номер+" от "+Формат(ТекПлатеж.ПП_Дата, "ДФ=dd.MM.yyyy")+" не указан код операции. Документ не выгружен!");
			Продолжить;
		КонецЕсли;
		
		// MPazhukov IMAPPS-12672
		ЭтоПереводСПБ = Ложь;
		ЭтоПереводСПБ = ЭтоПереводСПБ(ТекПлатеж.СчетКонтрагента, ТекПлатеж.НазначениеПлатежа);
		
		ПолучательСПБ = ТекПлатеж.ТекстПолучателя + ", INN " + ТекПлатеж.ИННПолучателя;
		// MPazhukov IMAPPS-12672
		
		Если не ЗначениеЗаполнено(ТекПлатеж.БанкПосредникНомерСчета) ИЛИ соотвБИКфВТБ[ТекПлатеж.КонтрагентБанкБИК] <> Неопределено Тогда
			// если номер счета не заполнен для банка посредника, то не указываем банк посредник
			// если банк получателя филиал втб - не указываем посредника  KonA 30/11/2019
			ТекПлатеж.БанкПосредникНомерСчета	= "";
			ТекПлатеж.БанкПосредникКод 			= "";
			ТекПлатеж.БанкПосредникНаименование = "";
			ТекПлатеж.БанкПосредникАдрес 		= "";
			ТекПлатеж.БанкПосредникГород 		= "";
			ТекПлатеж.БанкПосредникСтрана 		= "";
		КонецЕсли;
		
		Если Найти("52215#52210#51215#57020#57015#080150#", ТекПлатеж.ВидОперацииКод) > 0 Тогда 
			//Валютный перевод 
			флПарситьПримечание = Истина;
			Если не ЗначениеЗаполнено(ТекПлатеж.Примечание) Тогда
				// если примечание не заполнено: "[Договор.Номер] от [Договор.ДатаДоговора] договор купли-продажи"
				// "Приложение 1 от [БП.Дата сделки] к договору купли-продажи от 24.05.2013"
				ТекПлатеж.Примечание = "[Договор.НомерДоговора] от [Договор.ДатаДоговора] договор купли-продажи";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекПлатеж.ДО) и ТипЗнч(ТекПлатеж.ДО) = ТипПлатПоручение Тогда
				Если ТекПлатеж.ДО.ВидОперации = Перечисления.ВидыОперацийПоручение.ВыводИзДУ тогда
					ТекПлатеж.Примечание = "Договор доверительного управления № [ДоговорДУ.Код] от [ДоговорДУ.ДатаНачала]";
					ТекПлатеж.ДокОснДата = ТекПлатеж.ДоговорДУ.ДатаНачала;
					ТекПлатеж.ДокОснНомер  = ТекПлатеж.ДоговорДУ.Код;
					флПарситьПримечание = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			ТекПлатеж.Примечание = ВТБ_ЗаполнитьШаблон(ТекПлатеж.Примечание, ТекПлатеж);
			
			//	Дату ДокОснДата и ДокОснНомер извлекаем из комментария документа	"Примечание" //"Приложение 1 от 00.00.2017 к договору купли-продажи от 10.04.2015"
			Если флПарситьПримечание Тогда
				стрКоммент = СтрЗаменить(ТекПлатеж.Примечание, "  ", " ");
				Поз = Найти(стрКоммент, " от ");
				Если Поз > 0 Тогда
					стрНомер = СокрЛП(Лев(стрКоммент, Поз-1));
					Если НРег(Лев(стрНомер, 7)) = "договор" Тогда
						Пн = Найти(стрНомер, "№");
						Если Пн > 0 Тогда
							стрНомер = СокрЛП(Сред(стрНомер, Пн+1));
						КонецЕсли;
					КонецЕсли;
					ТекПлатеж.ДокОснНомер  = стрНомер;
					стрДата = Сред(стрКоммент, Поз+4, 10);
					Попытка
						ТекПлатеж.ДокОснДата = Дата(Сред(стрДата, 7, 4)+Сред(стрДата, 4, 2)+Сред(стрДата, 1, 2));
					Исключение
						Сообщить("ошибка преобр даты: "+ стрДата);
						ТекПлатеж.ДокОснДата = Дата(2000,1,1);
					КонецПопытки;
				Иначе
					ТекПлатеж.ДокОснДата = Дата(2000,1,1);
					ТекПлатеж.ДокОснНомер  = "";
				КонецЕсли;
			КонецЕсли;
			
			
			ТекПравила = ПравилаВалютныйПеревод;
			ТекПлатеж.ДокОснТип = "3"; //3-Договор, 1-Паспорт сделки
			
		ИначеЕсли Найти("57010#", ТекПлатеж.ВидОперацииКод) > 0 Тогда
			//Перевод с транзитного на расчетный счет- 57010
			ТекПравила = ПравилаПереводТранзитныйРасчетный;
			ТекПлатеж.ДокОснТип = "3"; //3-Договор, 1-Паспорт сделки
			
		ИначеЕсли Найти("01010#", ТекПлатеж.ВидОперацииКод) > 0 Тогда
			//Продажа – 01010 
			ТекПравила = ПравилаПродажа;
			
		ИначеЕсли Найти("01030#", ТекПлатеж.ВидОперацииКод) > 0 Тогда
			//Покупка -01030  
			ТекПравила = ПравилаПокупка;
			
		ИначеЕсли Найти("01040#", ТекПлатеж.ВидОперацииКод) > 0 Тогда
			//Конвертация- 01040
			ТекПравила = ПравилаКонвертация;
		// MPazhukov IMAPPS-12672
		ИначеЕсли Найти("58030#", ТекПлатеж.ВидОперацииКод) > 0 Тогда
			
			ТекПравила = ПравилаВалютныйПеревод;
			ТекПлатеж.ДокОснТип = "3"; //3-Договор, 1-Паспорт сделки
			
			ТекПлатеж.ДокОснНомер = ЭтоПереводСПБ.НомерДоговораСПБ;
			ТекПлатеж.ДокОснДата = ЭтоПереводСПБ.ДатаДоговораСПБ;
			
		// MPazhukov IMAPPS-12672
		Иначе
			Сообщить("Для п/п № "+ТекПлатеж.ПП_Номер+" от "+Формат(ТекПлатеж.ПП_Дата, "ДФ=dd.MM.yyyy")+" неизвестный код операции: "+ТекПлатеж.ВидОперацииКод+". Документ не выгружен!");
			Продолжить;
		КонецЕсли;
		
		// IMAPPS-25144 ++
		//КлючПоиска = СокрП(ТекПлатеж.ПортфельНомерСчета) + "_" + СокрП(ТекПлатеж.ПортфельБИК);
		// IMAPPS-25144 --
		
		Для каждого Правило Из ТекПравила Цикл
			СтрокаПотока = "";
			
			// IMAPPS-25144 ++
			//Если Правило.ИмяПоля = "ПолеUClId" Тогда
			//	СтрокаПотока = ПлатежныеИдентификаторы[КлючПоиска].UserClientId;
			//КонецЕсли;
			//
			//Если Правило.ИмяПоля = "ПолеUCustId" Тогда
			//	СтрокаПотока = ПлатежныеИдентификаторы[КлючПоиска].UserCustId;
			//КонецЕсли;
			// IMAPPS-25144 --
			
			Если Правило.ИмяИсточник <> "" Тогда
				СтрокаПотока = ?(Правило.стрФормат = "", ТекПлатеж[Правило.ИмяИсточник], Формат(ТекПлатеж[Правило.ИмяИсточник], Правило.стрФормат));
				
				Если Правило.ИмяИсточник = "ПортфельНомерСчета" и ВТБ_НомерСчетаПустой(ТекПлатеж[Правило.ИмяИсточник]) Тогда
					СтрокаПотока = ?(Правило.стрФормат = "", ТекПлатеж["ПортфельIBANСчета"], Формат(ТекПлатеж["ПортфельIBANСчета"], Правило.стрФормат));
					
				ИначеЕсли Правило.ИмяИсточник = "КонтрагентНомерСчета" и ВТБ_НомерСчетаПустой(ТекПлатеж[Правило.ИмяИсточник]) Тогда
					СтрокаПотока = ?(Правило.стрФормат = "", ТекПлатеж["КонтрагентIBANСчета"], Формат("КонтрагентIBANСчета", Правило.стрФормат));
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаПотока) Тогда
				СтрокаПотока = Правило.ЗначениеПоУмолчанию;
			КонецЕсли;
			
			Если Правило.ИмяПоля = "Поле1" Тогда
				СтрокаПотока = СтрЗаменить(СтрокаПотока, "ПП", Формат(НомерДок, "ЧГ=0"));
				НомерДок = НомерДок + 1;
			КонецЕсли;
			
			Если Правило.Транслит Тогда
				флЕстьЛатиницей = Ложь;
				// MPazhukov IMAPPS-12672
				//Если ТекПлатеж.ВидОперацииКод = "57015" И Правило.ИмяПоля = "Поле15" Тогда 
				Если (ТекПлатеж.ВидОперацииКод = "57015" ИЛИ ТекПлатеж.ВидОперацииКод = "58030") И Правило.ИмяПоля = "Поле15" Тогда  // IMAPPS-6385: ВРЕМЕННО только для кода 57015	
				// MPazhukov IMAPPS-12672	
					СтрокаПотокаВр = СокрЛП(ТекПлатеж["_КонтрагентНаименованиеАнгл_"]);
					
					// MPazhukov IMAPPS-12672
					Если ТекПлатеж.ВидОперацииКод = "58030" Тогда
						СтрокаПотокаВр = ПолучательСПБ;	
					КонецЕсли;	
					// MPazhukov IMAPPS-12672
					
					Если ЗначениеЗаполнено(СтрокаПотокаВр) Тогда
						СтрокаПотока = СтрокаПотокаВр;
						флЕстьЛатиницей = Истина;
					КонецЕсли;				
				КонецЕсли;
				
				// MPazhukov IMAPPS-12672
				Если  ТекПлатеж.ВидОперацииКод = "58030" И Правило.ИмяПоля = "Поле18" Тогда
					СтрокаПотока = "MOSCOW";	
				КонецЕсли;	
				// MPazhukov IMAPPS-12672					
								
				Если НЕ флЕстьЛатиницей Тогда
					СтрокаПотока = Транскрипт(СтрокаПотока);
				КонецЕсли;
			КонецЕсли;
						
			Если Правило.стрУдСимв <> "" Тогда
				СтрокаПотока = УдалитьНедопустимыеСимволы(СтрокаПотока, Правило.стрУдСимв);
			КонецЕсли;
			
			СтрокаПотока = СтрЗаменить(СтрокаПотока, Символ(160), "");
			СтрокаПотока = СтрЗаменить(СтрокаПотока, Символы.ПС, "");
			
			ПотокВыгрузки.ДобавитьСтроку(СтрокаПотока);
		КонецЦикла;
	КонецЦикла;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");

	Если Кодировка = "DOS" Тогда
		ПотокВыгрузки.Записать(ИмяВременногоФайла, КодировкаТекста.OEM);
	Иначе
		ПотокВыгрузки.Записать(ИмяВременногоФайла, "windows-1251"); //КодировкаТекста.ANSI
	КонецЕсли;
	
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла)); 
	
	Возврат Адрес;
КонецФункции

Функция ПолучитьОписаниеСервисаНРД(ИмяМакетаСхемыДок)
	
	масСхемы = новый Массив;
	масСхемы.Добавить(ПолучитьИмяВременногоФайла());
	масСхемы.Добавить(ПолучитьИмяВременногоФайла());
	масСхемы.Добавить(ПолучитьИмяВременногоФайла());
	
	тхт_мес = ПолучитьМакет("PaymentMessages");
	стр_мес = тхт_мес.ПолучитьТекст();
	стр_мес = СтрЗаменить(стр_мес, "#Document", ИмяМакетаСхемыДок+":Document");
	
	Если ИмяМакетаСхемыДок = "camt055_V06" Тогда
		стр_мес = СтрЗаменить(стр_мес, "#xsd-name", "camt.055.001.06");
	ИначеЕсли ИмяМакетаСхемыДок = "camt060_V03" Тогда
		стр_мес = СтрЗаменить(стр_мес, "#xsd-name", "camt.060.001.03");
	ИначеЕсли ИмяМакетаСхемыДок = "pain001_V08" Тогда
		стр_мес = СтрЗаменить(стр_мес, "#xsd-name", "pain.001.001.08");
	КонецЕсли;
	
	тхт_мес.УстановитьТекст(стр_мес);
	тхт_мес.Записать(масСхемы[0], КодировкаТекста.UTF8);
	
	ПолучитьМакет("head001_V01").Записать(масСхемы[1], КодировкаТекста.UTF8);
	ПолучитьМакет(ИмяМакетаСхемыДок).Записать(масСхемы[2], КодировкаТекста.UTF8);
	
	//ПолучитьМакет("pain001_V08").Записать(масСхемы[2], КодировкаТекста.UTF8);
	//ПолучитьМакет("camt055_V06").Записать(масСхемы[3], КодировкаТекста.UTF8);
	//ПолучитьМакет("camt060_V03").Записать(масСхемы[4], КодировкаТекста.UTF8);
	
	ФабрикаXSD 	= СоздатьФабрикуXDTO(масСхемы);		

	Ответ = новый Структура();
	Ответ.Вставить("PaymentMessages", "paymentmessages");
	Ответ.Вставить("head001_V01", "urn:iso:std:iso:20022:tech:xsd:head.001.001.01");
	Ответ.Вставить("pain001_V08", "urn:iso:std:iso:20022:tech:xsd:pain.001.001.08");
	Ответ.Вставить("camt055_V06", "urn:iso:std:iso:20022:tech:xsd:camt.055.001.06");
	Ответ.Вставить("camt060_V03", "urn:iso:std:iso:20022:tech:xsd:camt.060.001.03");
	Ответ.Вставить("ФабрикаXSD", ФабрикаXSD);
	
	Возврат Ответ;
КонецФункции

Функция ПодготовитьТаблицуПлатежейНРД(СписокПлатежныеДокументы) Экспорт
	
	ОписаниеСервиса = ПолучитьОписаниеСервисаНРД("pain001_V08");
	
	ФабрикаXSD 	= ОписаниеСервиса.ФабрикаXSD;		
	
	ПарамЗ = новый Структура("ФабрикаXSD,ПространствоИмен", ФабрикаXSD, ОписаниеСервиса.head001_V01);
	ПарамД = новый Структура("ФабрикаXSD,ПространствоИмен", ФабрикаXSD, ОписаниеСервиса.pain001_V08);
	
	НПП = 0;
	МассивФайлов = новый Массив;
	Попытка
	Для Каждого ТекПлатеж Из СписокПлатежныеДокументы Цикл

		//PI011	Платежное поручение в рублях 
		//PI012	Заявление на перевод в иностранной валюте (межбанковский перевод). Если у клиента есть SWIFT BIC
		//PI016	Заявление на перевод в иностранной валюте (клиентский перевод)
		//PI013	Конверсионное поручение 
		//PI014	Распоряжение на перевод с конверсией
		//PI015	Платежное поручение на перечисление налоговых и иных обязательных платежей
		
		Если не ЗначениеЗаполнено(ТекПлатеж.БанкПосредникНомерСчета) Тогда
			//если номер счета не заполнен для банка посредника, то не указываем банк посредник
			ТекПлатеж.БанкПосредникКод 			= "";
			ТекПлатеж.БанкПосредникНаименование = "";
			ТекПлатеж.БанкПосредникАдрес 		= "";
			ТекПлатеж.БанкПосредникГород 		= "";
			ТекПлатеж.БанкПосредникСтрана 		= "";
		КонецЕсли;
		
		Если ТекПлатеж.ПеречислениеВБюджет Тогда 
			КодТипСообщения = "PI015";
		Иначе
			Если ТекПлатеж.ВалютаПлательщика = Справочники.Валюты.RUB Тогда
				//Перевод рубли
				КодТипСообщения = "PI011";
				Если ТекПлатеж.ВалютаПолучателя <> ТекПлатеж.ВалютаПлательщика Тогда
					// Покупка продажа валюты
					КодТипСообщения = "PI013";
					Если ТекПлатеж.СчетДоговораДУ.Банк <> ТекПлатеж.СчетКонтрагента.Банк Тогда 
						//PI014	Распоряжение на перевод с конверсией
						КодТипСообщения = "PI014";
					КонецЕсли;
				КонецЕсли;
			Иначе
				//Валютный перевод 
				КодТипСообщения = "PI016"; //
				Если ТекПлатеж.ВалютаПолучателя <> ТекПлатеж.ВалютаПлательщика Тогда
					// Покупка продажа валюты
					КодТипСообщения = "PI013"; //"PI013"
					Если ТекПлатеж.ДоговорДУ.УправляющаяКомпания <> ТекПлатеж.КонтрагентПолучатель Тогда
						КодТипСообщения = "PI014";  //PI014	Распоряжение на перевод с конверсией
					КонецЕсли;
				Иначе
					Если ТекПлатеж.СчетДоговораДУ.Банк <> ТекПлатеж.СчетКонтрагента.Банк Тогда
						КодТипСообщения = "PI012";  //PI012	Заявление на перевод в иностранной валюте (межбанковский перевод). Если у клиента есть SWIFT BIC
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		НПП = НПП+1;
		Отказ = Ложь;
		
		ТекПлатеж.НазначениеПлатежа = СтрЗаменить(ТекПлатеж.НазначениеПлатежа, Символы.НПП, " ");
		ТекПлатеж.НазначениеПлатежа = СтрЗаменить(ТекПлатеж.НазначениеПлатежа, "  ", " ");
		
		// vtb Kudryashov IMAPPS-10307
		Если КодТипСообщения = "PI013" Тогда
			ТекПлатеж.НазначениеПлатежа = "#BNF#" + ТекПлатеж.НазначениеПлатежа;
		КонецЕсли;
		// vtb Kudryashov IMAPPS-10307
		
		СтруктураС = новый Структура;
		//СтруктураС.Вставить("РеференсСообщения", СокрЛП(УдалитьЛидирующиеНули(ТекПлатеж.ПП_Номер))+"/"+Формат(ТекущаяДата(), "ДФ=MMddHHmm"));
		СтруктураС.Вставить("РеференсСообщения", СокрЛП(УдалитьЛидирующиеНули(ТекПлатеж.ПП_Номер))); // КонА: убрал суфикс, т.к. его потом не угадать при формировании реестра валютных платежей
		СтруктураС.Вставить("ДатаВремяСоздания", Формат(ТекПлатеж.ПП_Дата, "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		СтруктураС.Вставить("ДепозитарныйКод", _ДепозитарныйКод(ТекПлатеж.ДоговорДУ.УправляющаяКомпания, ТекПлатеж.СчетДоговораДУ.Владелец, Отказ)); //TRVTBUUK0032
		//СтруктураС.Вставить("ДепозитарныйКод", "TRVTBUUK0032"); //TRVTBUUK0032
		
		Если СтрДлина(СтруктураС.РеференсСообщения) > 16 Тогда
			СтруктураС.РеференсСообщения = Лев(СтруктураС.РеференсСообщения, 16);
		КонецЕсли;
		
		//ИмяВремФайла = ПолучитьИмяВременногоФайла();
		XML = Новый ЗаписьXML; 
		//XML.ОткрытьФайл(ИмяВремФайла, Новый ПараметрыЗаписиXML("windows-1251", "1.0", , Истина)); 
		XML.УстановитьСтроку("windows-1251");
		XML.ЗаписатьОбъявлениеXML(); 
		
		обПакет 	= ФабрикаXSD.Создать(ФабрикаXSD.Тип(ОписаниеСервиса.PaymentMessages, "PaymentMessages"));
		обЗаголовок = ФабрикаXSD.Создать(ФабрикаXSD.Тип(ПарамЗ.ПространствоИмен, "BusinessApplicationHeaderV01"));
		обДокумент 	= ФабрикаXSD.Создать(ФабрикаXSD.Тип(ПарамД.ПространствоИмен, "Document_CstmrCdtTrfInitn"));
		
		обЗаголовок.Fr = НовЗапДок(ПарамЗ, "Party9Choice");
		обЗаголовок.Fr.OrgId = НовЗапДок(ПарамЗ, "PartyIdentification42");
		обЗаголовок.Fr.OrgId.Id = НовЗапДок(ПарамЗ, "Party10Choice");
		обЗаголовок.Fr.OrgId.Id.OrgId = НовЗапДок(ПарамЗ, "OrganisationIdentification7");
		обOthr = НовЗапДок(ПарамЗ, "GenericOrganisationIdentification1");
		обOthr.Id = СтруктураС.ДепозитарныйКод;
		обOthr.SchmeNm = НовЗапДок(ПарамЗ, "OrganisationIdentificationSchemeName1Choice");
		обOthr.SchmeNm.Cd = "NSDR";
		обOthr.Issr = "NSDR";
		обЗаголовок.Fr.OrgId.Id.OrgId.Othr.Добавить(обOthr);
		
		обЗаголовок.To = НовЗапДок(ПарамЗ, "Party9Choice");
		обЗаголовок.To.OrgId = НовЗапДок(ПарамЗ, "PartyIdentification42");
		обЗаголовок.To.OrgId.Id = НовЗапДок(ПарамЗ, "Party10Choice");
		обЗаголовок.To.OrgId.Id.OrgId = НовЗапДок(ПарамЗ, "OrganisationIdentification7");
		обOthr = НовЗапДок(ПарамЗ, "GenericOrganisationIdentification1");
		обOthr.Id = "NDC000000000";
		обOthr.SchmeNm = НовЗапДок(ПарамЗ, "OrganisationIdentificationSchemeName1Choice");
		обOthr.SchmeNm.Cd = "NSDR";
		обOthr.Issr = "NSDR";
		обЗаголовок.To.OrgId.Id.OrgId.Othr.Добавить(обOthr);
		
		обЗаголовок.BizMsgIdr 	= СтруктураС.РеференсСообщения;
		обЗаголовок.MsgDefIdr 	= "pain.001.001.08";
		обЗаголовок.BizSvc 		= КодТипСообщения;
		обЗаголовок.CreDt 		= СтруктураС.ДатаВремяСоздания;
		Отказ = Ложь;
		Если КодТипСообщения = "PI011" Тогда
			//PI011	Платежное поручение в рублях 
			НРД_ПП_Рубли(ПарамД, обДокумент, ТекПлатеж, СтруктураС, Отказ);
		ИначеЕсли КодТипСообщения = "PI012" Тогда
			//PI012	Заявление на перевод в иностранной валюте (межбанковский перевод) 
			НРД_ЗаявлениеПеревод_ИнВал_Код_SWIFT_BIC(ПарамД, обДокумент, ТекПлатеж, СтруктураС, Отказ);
		ИначеЕсли КодТипСообщения = "PI016" Тогда
			//PI016	Заявление на перевод в иностранной валюте (клиентский перевод)
			НРД_ЗаявлениеПеревод_ИнВал_Клиент(ПарамД, обДокумент, ТекПлатеж, СтруктураС, Отказ);
		ИначеЕсли КодТипСообщения = "PI013" Тогда
			//PI013	Конверсионное поручение 
			НРД_ПП_ПокупкаПродажаВалюты(ПарамД, обДокумент, ТекПлатеж, СтруктураС, Отказ);
		ИначеЕсли КодТипСообщения = "PI014" Тогда
			//PI014	Распоряжение на перевод с конверсией
			НРД_ПП_ПокупкаПродажаВалюты(ПарамД, обДокумент, ТекПлатеж, СтруктураС, Отказ);
		ИначеЕсли КодТипСообщения = "PI015" Тогда
			//PI015	Платежное поручение на перечисление налоговых и иных обязательных платежей
			НРД_ПП_Налог(ПарамД, обДокумент, ТекПлатеж, СтруктураС, Отказ);
		КонецЕсли;
		
		обПакет.AppHdr = обЗаголовок;
		обПакет.Document = обДокумент;
		
		Если Отказ Тогда
			Сообщить("Документе №"+ТекПлатеж.ПП_Номер+" не выгружен!", СтатусСообщения.ОченьВажное);
		Иначе
			ФабрикаXSD.ЗаписатьXML(XML, обПакет, "PaymentMessages", ОписаниеСервиса.PaymentMessages); 
		КонецЕсли;
		СтрокаXML = XML.Закрыть(); 	
		
		ИмяФайлСообщения = "PM_"+СтрЗаменить(СтруктураС.РеференсСообщения, "/", "_")+"_"+КодТипСообщения+"_"+Формат(НПП, "ЧЦ=4; ЧВН=; ЧГ=0")+".xml"; 
		//Сообщить("Выгружен документ: "+ИмяФайлСообщения);
		//АдресВремХранилища = ПоместитьВоВременноеХранилище(Новый Структура("ИмяФайлСообщения,СтрокаXML", ИмяФайлСообщения, СтрокаXML), Новый УникальныйИдентификатор);
		//МассивФайлов.Добавить(Новый Структура("ИмяФайла, АдресВремХранилища", ИмяФайлСообщения, АдресВремХранилища));
		Если не Отказ Тогда
			МассивФайлов.Добавить(Новый Структура("НомерПП,Ссылка,ИмяФайлСообщения,СтрокаXML", СокрЛП(ТекПлатеж.ПП_Номер), ТекПлатеж.ДокСсылка, ИмяФайлСообщения, СтрокаXML));
		КонецЕсли;
	
	КонецЦикла;
	Исключение
		Сообщить("Ошибка формирования ПП: "+ОписаниеОшибки());
	КонецПопытки;
	
	АдресВремХранилища = ПоместитьВоВременноеХранилище(МассивФайлов, Новый УникальныйИдентификатор);
	Возврат АдресВремХранилища;
КонецФункции

Функция ПодготовитьЗапросОтменаПлатежаНРД(СписокПлатежей) Экспорт
	
	МассивФайлов = новый Массив;

	ОписаниеСервиса = ПолучитьОписаниеСервисаНРД("camt055_V06");
	ФабрикаXSD 	= ОписаниеСервиса.ФабрикаXSD;		
	ПарамЗ = новый Структура("ФабрикаXSD,ПространствоИмен", ФабрикаXSD, ОписаниеСервиса.head001_V01);
	ПарамД = новый Структура("ФабрикаXSD,ПространствоИмен", ФабрикаXSD, ОписаниеСервиса.camt055_V06);
	
	НПП = 0;
	Для каждого ТекПлатеж Из СписокПлатежей Цикл
		НПП = НПП+1;
		
		СтруктураС = новый Структура;
		СтруктураС.Вставить("РеференсСообщения", "CANC"+СокрЛП(ТекПлатеж.Номер));
		СтруктураС.Вставить("ДатаВремяСоздания", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		СтруктураС.Вставить("ДепозитарныйКод", "TRVTBUUK0032");
		
		ИмяВремФайла = ПолучитьИмяВременногоФайла();
		XML = Новый ЗаписьXML; 
