КонецФункции

// Описание: Возвращает число счетов отбора, участвующих в запросе к web-service.
//
// Возвращаемое значение:
// Число - количество счетов с номером длиной 20 символов без пометки удаления
//
Функция КоличествоСчетовОтбораЗамера()
	
	Количество = 0;
	
	Для Каждого ТекСчет Из СписокСчетов Цикл
		Если ТекСчет.Значение.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДлина(ТекСчет.Значение.НомерСчета) <> 20 Тогда
			Продолжить;
		КонецЕсли;
		Количество = Количество + 1;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

// Описание: Считает уникальные заполненные договоры ДУ в табличной части Выписки.
//
// Возвращаемое значение:
// Число - количество уникальных договоров ДУ
//
Функция КоличествоУникальныхДоговоровВыписки()
	
	УникальныеДоговоры = Новый Соответствие;
	
	Для Каждого СтрокаВыписки Из Выписки Цикл
		Если ЗначениеЗаполнено(СтрокаВыписки.ДоговорДУ) Тогда
			УникальныеДоговоры.Вставить(Строка(СтрокаВыписки.ДоговорДУ.УникальныйИдентификатор()), Истина);
		КонецЕсли;
	КонецЦикла;
	
	Возврат УникальныеДоговоры.Количество();
	
КонецФункции

// Описание: Формирует фрагмент комментария замера с периодом загрузки и режимом теста.
//
// Параметры:
// ТестовыйРежим - Булево - признак тестового режима загрузки
//
// Возвращаемое значение:
// Строка - фрагмент комментария с периодом и режимом
//
Функция ДополнениеКомментарияПериодЗагрузки(ТестовыйРежим) Экспорт
	
	Возврат "; Период="
		+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ "-"
		+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ "; Тест="
		+ ?(ТестовыйРежим, "Да", "Нет");
	
КонецФункции
