Функция Транскрипт(ВхСтрока) Экспорт
	
	соотв = новый Соответствие;
	соотв.Вставить("а", "a");
	соотв.Вставить("б", "b");
	соотв.Вставить("в", "v");
	соотв.Вставить("г", "g");
	соотв.Вставить("д", "d");
	соотв.Вставить("е", "e");
