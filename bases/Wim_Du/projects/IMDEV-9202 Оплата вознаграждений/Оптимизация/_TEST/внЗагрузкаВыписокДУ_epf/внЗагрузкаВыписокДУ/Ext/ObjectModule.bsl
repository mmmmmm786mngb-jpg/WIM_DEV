// IMDEV-9096 OPT-17: ПолучитьДанныеДепоПоСчету
// Описание: SQL-данные (договоры ДУ + счета депо) по номеру счета с ленивым кэшем.
//
// Параметры:
//  НомерСчета     - Строка
//  КэшДепоПоСчету  - Соответствие - необязательно
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ДоговорДУ, СчетДепо
//
Функция ПолучитьДанныеДепоПоСчету(НомерСчета, КэшДепоПоСчету = Неопределено)

	НомерСчетаНорм = СокрЛП(НомерСчета);

	Если КэшДепоПоСчету <> Неопределено Тогда
		ДанныеИзКэша = КэшДепоПоСчету.Получить(НомерСчетаНорм);
		Если ДанныеИзКэша <> Неопределено Тогда
			Возврат ДанныеИзКэша;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВложенныйЗапрос.ДоговорДУ КАК ДоговорДУ,
	               |	СчетаДепо.НомерСчета КАК СчетДепо
	               |ИЗ
	               |	Справочник.СчетаДепо КАК СчетаДепо
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			АналитическиеСчета.ДоговорДУ КАК ДоговорДУ,
	               |			АналитическиеСчета.Ссылка КАК Ссылка
	               |		ИЗ
	               |			Справочник.АналитическиеСчета КАК АналитическиеСчета
	               |		ГДЕ
	               |			АналитическиеСчета.МестоХранения.НомерСчета = &НомерСчета
				   // VTB-Borisov  - 12.12.2016 {
				   |			И НЕ АналитическиеСчета.ПометкаУдаления
				   // VTB-Borisov  - 12.12.2016 }
	               |			И АналитическиеСчета.ДоговорДУ <> &ПустойДоговорДУ
	               |		
	               |		ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |		ВЫБРАТЬ
	               |			БанковскиеСчета.ДоговорДУ,
	               |			БанковскиеСчета.Ссылка
	               |		ИЗ
	               |			Справочник.БанковскиеСчета КАК БанковскиеСчета
	               |		ГДЕ
	               |			БанковскиеСчета.НомерСчета = &НомерСчета
   				   // VTB-Borisov  - 12.12.2016 {
				   |			И НЕ БанковскиеСчета.ПометкаУдаления
				   // VTB-Borisov  - 12.12.2016 }
	               |			И БанковскиеСчета.ДоговорДУ <> &ПустойДоговорДУ) КАК ВложенныйЗапрос
	               |		ПО (ВложенныйЗапрос.ДоговорДУ = СчетаДепо.ДоговорДУ)
	               |ГДЕ
	               |	НЕ СчетаДепо.ПометкаУдаления
	               |	И ЕСТЬNULL(СчетаДепо.НомерСчета, """") <> """"
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДоговорДУ УБЫВ";
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Запрос.УстановитьПараметр("ПустойДоговорДУ", Справочники.ДоговорДУ.ПустаяСсылка());

	ДанныеДепо = Запрос.Выполнить().Выгрузить();

	Если КэшДепоПоСчету <> Неопределено Тогда
		КэшДепоПоСчету.Вставить(НомерСчетаНорм, ДанныеДепо);
	КонецЕсли;

	Возврат ДанныеДепо;

КонецФункции

// IMDEV-9096 OPT-17: НайтиДоговорВДанныхДепо
// Описание: Сопоставление договора ДУ по назначению платежа в данных депо (без SQL).
//
// Параметры:
//  ДанныеДепо        - ТаблицаЗначений
//  НазначениеПлатежа - Строка
//
// Возвращаемое значение:
//  СправочникСсылка.ДоговорДУ
//
Функция НайтиДоговорВДанныхДепо(ДанныеДепо, НазначениеПлатежа)

	// IMAPPS-31545++
	КодСчетаДепо = "";
	КлючевоеСлово = "KUP/PROC. DOH. PO OBL.";
	НачалоСтроки = Найти(НазначениеПлатежа, КлючевоеСлово);
	Если НачалоСтроки Тогда
		НачалоСтроки = НачалоСтроки + СтрДлина(КлючевоеСлово) + 1;
		ДлинаСтроки = СтрДлина(НазначениеПлатежа) - НачалоСтроки;
		мНазначениеПлатежа = Сред(НазначениеПлатежа, НачалоСтроки, ДлинаСтроки);
		МассивСтрокНазначения = СтрРазделить(мНазначениеПлатежа, ".", Истина);
		Если МассивСтрокНазначения.Количество() >= 7 Тогда
			КодСчетаДепо = ВРег(СокрЛП(МассивСтрокНазначения.Получить(2)));
			Если НЕ (
					СтрДлина(КодСчетаДепо) = 10
					И Сред(КодСчетаДепо, 1, 1) = "B"
					И Сред(КодСчетаДепо, 4, 2) = "DU"
				    ) Тогда
					
				КодСчетаДепо = "";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// IMAPPS-31545--
	
	Для Каждого Выборка Из ДанныеДепо Цикл
		МассивКлючевыхСловДляПоискаАккаунта = Новый Массив;
		МассивКлючевыхСловДляПоискаАккаунта.Добавить("ACC ");
		МассивКлючевыхСловДляПоискаАккаунта.Добавить(", ACC");
		НайденноеКлючевоеСлово = "";
		//
		Если Найти(НазначениеПлатежа," No.DU") > 0 И Лев(ВРег(Выборка.СчетДепо), 2) = "ДУ" Тогда
			Если Найти(НазначениеПлатежа, " No.DU" + СтрЗаменить(ВРег(Выборка.СчетДепо), "ДУ", "")) > 0 Тогда
				Возврат Выборка.ДоговорДУ;
			КонецЕсли;
		ИначеЕсли ВНазначенииПлатежаЕстьНомерАккаунта(НазначениеПлатежа, МассивКлючевыхСловДляПоискаАккаунта, НайденноеКлючевоеСлово) Тогда
			Если Найти(Врег(НазначениеПлатежа), НайденноеКлючевоеСлово + Прав("000" + ВРег(Выборка.СчетДепо), 5)) > 0 Тогда
				Возврат Выборка.ДоговорДУ;
			КонецЕсли;
		ИначеЕсли Найти(НазначениеПлатежа,"№ ") > 0 Тогда
			Если Найти(НазначениеПлатежа,"№ " + ВРег(Выборка.СчетДепо)) > 0 Тогда
				Возврат Выборка.ДоговорДУ;
			КонецЕсли;
		ИначеЕсли Найти(НазначениеПлатежа," N ") > 0 Тогда
			Если Найти(НазначениеПлатежа," N " + ВРег(Выборка.СчетДепо)) > 0 Тогда
				Возврат Выборка.ДоговорДУ;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(КодСчетаДепо) И ВРег(Выборка.СчетДепо) = КодСчетаДепо Тогда
			Возврат Выборка.ДоговорДУ;
		КонецЕсли;
		
	КонецЦикла;

	Возврат Справочники.ДоговорДУ.ПустаяСсылка();

КонецФункции

#КонецОбласти

