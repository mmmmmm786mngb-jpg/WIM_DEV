Функция ДанныеЧерезСервис(Определение, Корень)
	
	Прокси = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
	
	Прокси.GetStatementOfAccount(Корень);
	
	Возврат Корень;
КонецФункции

Функция ТестовыеДанные(Фабрика, Корень_ТИП)
	
	ФайлПример = ПолучитьИмяВременногоФайла("xml");
	
	Пример = ПолучитьМакет("ПримерОтвета");
	Пример.Записать(ФайлПример,КодировкаТекста.UTF8 );
	
	Чтение	= Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлПример);
	
	Корень = Фабрика.ПрочитатьXML(Чтение, Корень_ТИП);
	
	Возврат Корень;
	
КонецФункции

Процедура ПрочитатьОбъекты(Объекты, Отказ = Ложь)
	
	// IMDEV-9096: инициализация кэшей OPT-02, OPT-05, OPT-17, OPT-18 (см. области OPT_xx ниже по модулю)
	
	Если Отказ Тогда Возврат; КонецЕсли;
	
	Выписки.Очистить();
	ПлатежныеДокументы.Очистить();
	
	Если Объекты.Выписки.Количество()=0 Тогда
		Сообщить("Выписок не обнаружено");
	КонецЕсли;

	// IMDEV-9096 OPT-02: предзагрузка кэша ДоговорДУ (1 SQL вместо ~255 в цикле)
	ДанныеСчетовДляКэша = СобратьУникальныеНомераСчетовДляКэшаДоговоровДУ(Объекты);
	СчетаБезДоговораДУ = Новый Соответствие;
	КэшДоговоровДУ = ЗаполнитьКэшДоговоровДУПоСчетам(
		ДанныеСчетовДляКэша.ВсеСчета,
		ДанныеСчетовДляКэша.СчетаВыписок,
		СчетаБезДоговораДУ);

	// IMDEV-9096 OPT-17: ленивый кэш данных депо (1 SQL на уникальный счет)
	КэшДепоПоСчету = Новый Соответствие;

	// IMDEV-9096 OPT-18: кэш карт префиксов ЕРС (1 карта на счет)
	КэшКартПрефиксов = Новый Соответствие;

	// IMDEV-9096 OPT-05: кэш платежных поручений по (счет, день)
	КэшПП = Новый Соответствие;
	
	сч = 0;
	Для Каждого ВыпискаXDTO из Объекты.Выписки Цикл
		сч = сч+1;
		ПервыйПлатеж = Истина;
		
		НоваяВыписка = Выписки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяВыписка, ВыпискаXDTO);
		
		НомерСчета						 = ВыпискаXDTO.БанковскийСчет.НомерСчета;
		НоваяВыписка.БанковскийСчетКод	 = НомерСчета;
		НоваяВыписка.БанковскийСчет		 = БанковскийСчетXDTO(ВыпискаXDTO.БанковскийСчет);
		// IMDEV-9096 OPT-02: передача кэша в ДоговорДУПоСчету
		НоваяВыписка.ДоговорДУ			 = ДоговорДУПоСчету(НомерСчета, КэшДоговоровДУ);
		ДанныеДляЕРС					 = Неопределено;
		
		Если Не ЗначениеЗаполнено(НоваяВыписка.ДоговорДУ) И ЗначениеЗаполнено(НоваяВыписка.БанковскийСчет)  Тогда
			ЭтоЕРС = Истина;
			НоваяВыписка.ДоговорДУ = Справочники.ДоговорДУ.ПустаяСсылка();
			
			ДанныеДляЕРС = ЕРС_ДоговорДУ_Отбор_ПоСчетуИНазначению(НомерСчета);
		Иначе
			ЭтоЕРС = Ложь;
			Если ТолькоЕРС Тогда 
				ИндексНоваяВыписка = Выписки.Индекс(НоваяВыписка);
				Выписки.Удалить(ИндексНоваяВыписка);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Год 	= Год(НоваяВыписка.ДатаСоздания);
		Месяц 	= Месяц(НоваяВыписка.ДатаСоздания);
		День 	= День(НоваяВыписка.ДатаСоздания);
		Час		= Час(ВыпискаXDTO.ВремяСоздания);
		Минута	= Минута(ВыпискаXDTO.ВремяСоздания);
		Секунда = Секунда(ВыпискаXDTO.ВремяСоздания);
		
		НоваяВыписка.ДатаСоздания = Дата(Год,Месяц, День, Час, Минута, Секунда);
		НоваяВыписка.КлючВыписки = Новый УникальныйИдентификатор;
		
		Для Каждого ПлатежXDTO из ВыпискаXDTO.ПлатежныеДокументы Цикл
			// IMAPPS-19850 ++
			//// +Artur Mingalev 12.07.2021 IMAPPS-13983
			//Если (НЕ ПлатежXDTO.ВидОплаты = "09" и Найти(ПлатежXDTO.НазначениеПлатежа,"Перечисление без осуществления продажи на р/счет") = 0)  
			//// -Artur Mingalev 12.07.2021 IMAPPS-13983
			//// IMAPPS-19507 ++
			//или (ПлатежXDTO.ВидОплаты = "09" и (Найти(ПлатежXDTO.НазначениеПлатежа,"дох. по обл.") > 0 или Найти(ПлатежXDTO.НазначениеПлатежа,"погаш. номин.") > 0)) 
			//// IMAPPS-19507 -- 
			//или (ПлатежXDTO.ВидОплаты = "09" и Найти(ПлатежXDTO.НазначениеПлатежа,"Дивиденды по ценным бумагам") > 0 ) //IMAPPS-19744
			
			НазначениеПлатежа = СтрЗаменить(ПлатежXDTO.НазначениеПлатежа, " ", "");
			ВидОплаты = ПлатежXDTO.ВидОплаты;
			
			Если (НЕ ВидОплаты = "09" и Найти(НазначениеПлатежа,"Перечислениебезосуществленияпродажинар/счет") = 0)  
				или (ВидОплаты = "09" и (Найти(НазначениеПлатежа,"дох.пообл") > 0 или Найти(НазначениеПлатежа,"погаш.номин.") > 0)) 
				или (ВидОплаты = "09" и Найти(НазначениеПлатежа,"Дивиденды") > 0 ) //IMAPPS-22888 или (ВидОплаты = "09" и Найти(НазначениеПлатежа,"Дивидендыпоценнымбумагам") > 0 ) 
				// IMAPPS-19850 --
				или (ВидОплаты = "09" и Найти(НазначениеПлатежа,"Доходпопаям") > 0 ) //IMAPPS-23215
				Тогда
				
				НовыйПлатеж = ПлатежныеДокументы.Добавить();
				ЗаполнитьЗначенияСвойств(НовыйПлатеж, ПлатежXDTO);
				
				НовыйПлатеж.ПлательщикСчет = ПлатежXDTO.ПлательщикСчет.НомерСчета;
				НовыйПлатеж.ПолучательСчет = ПлатежXDTO.ПолучательСчет.НомерСчета;
				
				НовыйПлатеж.ПлательщикБанк = БанкXDTO(ПлатежXDTO.ПлательщикБанк);
				НовыйПлатеж.ПлательщикБИК  = НовыйПлатеж.ПлательщикБанк.Код;
				
				НовыйПлатеж.ПолучательБанк = БанкXDTO(ПлатежXDTO.ПолучательБанк);
				НовыйПлатеж.ПолучательБИК  = НовыйПлатеж.ПолучательБанк.Код;
				
				Исходящий = (НовыйПлатеж.ПлательщикСчет = НоваяВыписка.БанковскийСчетКод);
				НовыйПлатеж.Исходящий = Исходящий;
				
				ПлатежДата = Формат(ПлатежXDTO.Дата, "ДФ=dd.MM.yyyy");
				
				Если Исходящий тогда
					НовыйПлатеж.ДатаСписано = ПлатежДата;
				Иначе
					НовыйПлатеж.ДатаПоступило = ПлатежДата;
				КонецЕсли;
				
				НовыйПлатеж.Сумма		= Формат(ПлатежXDTO.Сумма,"ЧГ=");
				
				НовыйПлатеж.КлючВыписки 		= НоваяВыписка.КлючВыписки;
				НовыйПлатеж.КлючДокумента 	= Новый УникальныйИдентификатор;
				
				Если ЭтоЕРС Тогда
					ЕРС_ДогДУ = Справочники.ДоговорДУ.ПустаяСсылка();
					
					Если Не ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда
						// IMDEV-9096 OPT-18: передача КэшКартПрефиксов
						ЕРС_ДогДУ = ЕРС_ДоговорДУ_ПоСчетуИНазначению(ДанныеДляЕРС, НомерСчета, НовыйПлатеж.НазначениеПлатежа, КэшКартПрефиксов);
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда
						ЕРС_ДогДУ = ЕРС_ДоговорДУ_ПоСчетуИПоступлениюНаРС1(НомерСчета, НовыйПлатеж.НазначениеПлатежа);
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда 
						НоваяТЗ = ЕРС_ДоговорДУ_ПоСчетуИПоступлениюСписаниюРС2(НомерСчета,НовыйПлатеж.НазначениеПлатежа, ПлатежныеДокументы,ПлатежДата);
						
						Если НоваяТЗ[0].ДокументСсылка = Неопределено Тогда
							ЕРС_ДогДУ = Справочники.ДоговорДУ.ПустаяСсылка();
						Иначе
							ЕРС_ДогДУ = НоваяТЗ[0].ДокументСсылка.ДоговорДУ;
							
							Если НоваяТЗ[0].НомерДокумента = 1 Тогда
								НовыйПлатеж.ДокументСсылка1 = НоваяТЗ[0].ДокументСсылка;
							Иначе
								НовыйПлатеж.ДокументСсылка2 = НоваяТЗ[0].ДокументСсылка;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда
						// IMDEV-9096 OPT-05: передача КэшПП
						ЕРС_ДогДУ = ЕРС_ДоговорДУ_ПоПлатежномуПоручению(НоваяВыписка.БанковскийСчет,НовыйПлатеж.НазначениеПлатежа,НовыйПлатеж.Номер,НовыйПлатеж.Дата, КэшПП);
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(ЕРС_ДогДУ) 
						//IMAPPS-5899
						И Найти(ВРег(НовыйПлатеж.НазначениеПлатежа), "СОГЛАСНО ПОРУЧЕНИЯ N") = 0 
						И Найти(ВРег(НовыйПлатеж.НазначениеПлатежа), "{VO99090}") = 0 
						И Найти(ВРег(НовыйПлатеж.НазначениеПлатежа), "Заявлению на перевод N ") = 0 Тогда 
						
						// IMDEV-9096 OPT-17: передача КэшДепоПоСчету
						ЕРС_ДогДУ = ЕРС_ДоговорДУ_ПоСчетуИСчетуДепо(НомерСчета,НовыйПлатеж.НазначениеПлатежа, КэшДепоПоСчету); 
					КонецЕсли;
					
					// DDneprovsky IMAPS-6587 {
					Если НЕ ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда 
						ЕРС_ДогДу = ЕРС_ДоговорДУ_ПоНомеруСчетаДепо(ВычленитьНомерСчетаДепоИзНазначенияПлатежа(НовыйПлатеж.НазначениеПлатежа));
					КонецЕсли;
					// } DDneprovsky IMAPS-6587
					
					// MPazhukov IMAPPS-9368 21.10.2019
					Если НЕ ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда 
						ЕРС_ДогДу = ЕРС_ДоговорДУ_ПоНомеруСчетаДепо(ВычленитьНомерСчетаДепоИзНазначенияПлатежаНРД(НовыйПлатеж.НазначениеПлатежа));
					КонецЕсли;
					// MPazhukov IMAPPS-9368 21.10.2019
					
					// MPazhukov IMAPPS-12673 
					Если НЕ ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда 
						ЕРС_ДогДу = ЕРС_ДоговорДУ_ПоАналитическомуСчетуСПБ(НовыйПлатеж.НазначениеПлатежа);
					КонецЕсли;
					// MPazhukov IMAPPS-12673
					
					// IMAPPS-36270++
					Если НЕ ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда 
						ЕРС_ДогДу = ЕРС_ДоговорДУ_ПоАналитическомуСчетуИзНазначения(НовыйПлатеж.НазначениеПлатежа);
					КонецЕсли;
					// IMAPPS-36270--
					
					//VTBC SadykovNiyaz 31.03.2022 (IMAPPS-16531) {
					Если НЕ ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда
						// IMDEV-9096: предупреждение только если счет реально не найден (0 строк), как в оригинале;
						// неоднозначные счета и счета с пустым договором при наличии записей - молча (как Результат.Пустой() = Ложь)
						ВыводитьПредупреждениеЕРС = (СчетаБезДоговораДУ.Получить(СокрЛП(НовыйПлатеж.ПлательщикСчет)) = Истина);
						ЕРС_ДогДу = ДоговорДУПоСчету(НовыйПлатеж.ПлательщикСчет, КэшДоговоровДУ, ВыводитьПредупреждениеЕРС);
					КонецЕсли;
					//VTBC SadykovNiyaz 31.03.2022 (IMAPPS-16531) }
					
					Если Не ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда
						ЕРС_ДогДУ = ЕРС_ДоговорДУ_ВнебиржеваяСделкаПоTRN(НовыйПлатеж.НазначениеПлатежа);
					КонецЕсли;
					
					// IMAPPS-32060 ++
					Если НЕ ЗначениеЗаполнено(ЕРС_ДогДУ) Тогда 
						ЕРС_ДогДу = ЕРС_ДоговорДУ_ПоТорговомуКоду(ВычленитьТорговыйКодИзНазначенияПлатежа(НовыйПлатеж.НазначениеПлатежа));
					КонецЕсли;					
					// IMAPPS-32060 --
					
					Если ПервыйПлатеж Тогда
						НоваяВыписка.ДоговорДУ = ЕРС_ДогДУ;
					КонецЕсли;
					
					Если НоваяВыписка.ДоговорДУ <> ЕРС_ДогДУ Тогда 
						ЕРС_НоваяВыписка = Выписки.Добавить();
						ЗаполнитьЗначенияСвойств(ЕРС_НоваяВыписка,НоваяВыписка);
						ЕРС_НоваяВыписка.ДоговорДУ = ЕРС_ДогДУ; 
						ЕРС_НоваяВыписка.КлючВыписки = Новый УникальныйИдентификатор;
						НовыйПлатеж.КлючВыписки = ЕРС_НоваяВыписка.КлючВыписки;
					КонецЕсли;
					
				КонецЕсли;
				
				ПервыйПлатеж = Ложь;
			КонецЕсли; 
			
		КонецЦикла;
		// -Artur Mingalev 12.07.2021 IMAPPS-13983
		// Удалить пустые выписки
		Если ПлатежныеДокументы.НайтиСтроки(Новый Структура("КлючВыписки",НоваяВыписка.КлючВыписки)).Количество()=0 Тогда 
			Попытка
				Выписки.Удалить(Выписки.Найти(НоваяВыписка.КлючВыписки,"КлючВыписки")); 
			Исключение
			КонецПопытки;
		КонецЕсли;
		// -Artur Mingalev 12.07.2021 IMAPPS-13983
		
	КонецЦикла;
	
	ИдентифицироватьПлатежи();
	
КонецПроцедуры 

Процедура ИдентифицироватьПлатежи()	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДанных", ПлатежныеДокументы);
	Запрос.УстановитьПараметр("ТаблицаВыписок", Выписки);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаДанных.Номер КАК Номер,
	               |	ТаблицаДанных.Дата КАК Дата,
	               |	ТаблицаДанных.КлючДокумента,
	               |	ТаблицаДанных.КлючВыписки,
				   
				   ///IMAPPS-5200 aberdinskikh 21/11/2017
				   |	ТаблицаДанных.ПлательщикСчет,
				   |	ТаблицаДанных.ПолучательСчет
				   ///IMAPPS-5200 aberdinskikh 21/11/2017
				   
	               |ПОМЕСТИТЬ ТаблицаДанных
	               |ИЗ
	               |	&ТаблицаДанных КАК ТаблицаДанных
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номер,
	               |	Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаВыписок.КлючВыписки КАК КлючВыписки,
	               |	ТаблицаВыписок.БанковскийСчет,
	               |	ТаблицаВыписок.ДоговорДУ
	               |ПОМЕСТИТЬ ТаблицаВыписок
	               |ИЗ
	               |	&ТаблицаВыписок КАК ТаблицаВыписок
				   //|ГДЕ
				   //|	НЕ ТаблицаВыписок.БанковскийСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
				   //|	И НЕ ТаблицаВыписок.ДоговорДУ = ЗНАЧЕНИЕ(Справочник.ДоговорДУ.ПустаяСсылка)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	КлючВыписки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	НАЧАЛОПЕРИОДА(ТаблицаДанных.Дата, ДЕНЬ) КАК Дата,
	               |	ТаблицаВыписок.БанковскийСчет КАК БанковскийСчет,
	               |	ТаблицаВыписок.ДоговорДУ КАК ДоговорДУ,
	               |	ТаблицаВыписок.КлючВыписки
	               |ПОМЕСТИТЬ ДатыВыписок
	               |ИЗ
	               |	ТаблицаДанных КАК ТаблицаДанных
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаВыписок КАК ТаблицаВыписок
	               |		ПО ТаблицаДанных.КлючВыписки = ТаблицаВыписок.КлючВыписки
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Дата,
	               |	БанковскийСчет,
	               |	ДоговорДУ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПлатежныеДокументы.Ссылка КАК Документ,
	               |	ПлатежныеДокументы.КлючВыписки КАК КлючВыписки,
	               |	ПлатежныеДокументы.НомерВходящегоДокумента КАК Номер,
	               |	ПлатежныеДокументы.Дата,
	               |	ПлатежныеДокументы.ДоговорДУ,
				   
				   //IMAPPS-5200 aberdinskikh 21/11/2017
				   |	ПлатежныеДокументы.СчетКонтрагента
				   
	               |ПОМЕСТИТЬ Документы
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СписаниеСРасчетногоСчета.Ссылка КАК Ссылка,
	               |		ДатыВыписок.КлючВыписки КАК КлючВыписки,
	               |		СписаниеСРасчетногоСчета.Дата КАК Дата,
	               |		СписаниеСРасчетногоСчета.ДоговорДУ КАК ДоговорДУ,
	               |		СписаниеСРасчетногоСчета.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
				   
				   //IMAPPS-5200 aberdinskikh 21/11/2017
				   |		СписаниеСРасчетногоСчета.СчетКонтрагента КАК СчетКонтрагента
				   
				   |	ИЗ
	               |		ДатыВыписок КАК ДатыВыписок
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета
	               |			ПО (ДатыВыписок.Дата = НАЧАЛОПЕРИОДА(СписаниеСРасчетногоСчета.ДатаВходящегоДокумента, ДЕНЬ))
	               |				И ДатыВыписок.БанковскийСчет = СписаниеСРасчетногоСчета.СчетДоговораДУ
	               |				И ДатыВыписок.ДоговорДУ = СписаниеСРасчетногоСчета.ДоговорДУ
	               |	ГДЕ
	               |		СписаниеСРасчетногоСчета.Проведен
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ПоступлениеНаРасчетныйСчет.Ссылка,
	               |		ДатыВыписок.КлючВыписки,
	               |		ПоступлениеНаРасчетныйСчет.Дата,
	               |		ПоступлениеНаРасчетныйСчет.ДоговорДУ,
	               |		ПоступлениеНаРасчетныйСчет.НомерВходящегоДокумента,
				   
				   //IMAPPS-5200 aberdinskikh 21/11/2017
				   |		ПоступлениеНаРасчетныйСчет.СчетКонтрагента
				   
				   |	ИЗ
	               |		ДатыВыписок КАК ДатыВыписок
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
	               |			ПО (ДатыВыписок.Дата = НАЧАЛОПЕРИОДА(ПоступлениеНаРасчетныйСчет.ДатаВходящегоДокумента, ДЕНЬ))
	               |				И ДатыВыписок.БанковскийСчет = ПоступлениеНаРасчетныйСчет.СчетДоговораДУ
	               |				И ДатыВыписок.ДоговорДУ = ПоступлениеНаРасчетныйСчет.ДоговорДУ
	               |	ГДЕ
	               |		ПоступлениеНаРасчетныйСчет.Проведен) КАК ПлатежныеДокументы
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	КлючВыписки,
	               |	Номер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ТаблицаДанных.КлючВыписки ЕСТЬ NULL 
	               |			ТОГДА Документы.КлючВыписки
	               |		ИНАЧЕ ТаблицаДанных.КлючВыписки
	               |	КОНЕЦ КАК КлючВыписки,
	               |	ТаблицаДанных.КлючДокумента,
	               |	ТаблицаДанных.Номер КАК НомерВх,
	               |	ТаблицаДанных.Дата КАК ДатаВх,
	               |	Документы.Документ,
	               |	Документы.Дата,
	               |	Документы.ДоговорДУ,
	               |	ВЫБОР
	               |		КОГДА ТаблицаДанных.КлючДокумента ЕСТЬ NULL 
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ОтсутствуютВИсточнике,
	               |	ВЫБОР
	               |		КОГДА Документы.Документ ЕСТЬ NULL 
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ОтсутствуютВБазе
	               |ИЗ
	               |	ТаблицаДанных КАК ТаблицаДанных
				   
				   //IMAPPS-5200 aberdinskikh 21/11/2017
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаВыписок КАК ТаблицаВыписок
				   |		ПО ТаблицаДанных.КлючВыписки = ТаблицаВыписок.КлючВыписки
				   //IMAPPS-5200 aberdinskikh 21/11/2017
				   
				   |		ПОЛНОЕ СОЕДИНЕНИЕ Документы КАК Документы
	               |		ПО ТаблицаДанных.КлючВыписки = Документы.КлючВыписки
	               |			И ТаблицаДанных.Номер = Документы.Номер
				   
				   //IMAPPS-5200 aberdinskikh 21/11/2017
				   |			И (ЕСТЬNULL(ТаблицаДанных.ПолучательСчет, Документы.СчетКонтрагента.НомерСчета) = Документы.СчетКонтрагента.НомерСчета
				   |				ИЛИ ЕСТЬNULL(ТаблицаДанных.ПлательщикСчет, Документы.СчетКонтрагента.НомерСчета) = Документы.СчетКонтрагента.НомерСчета
				   |				ИЛИ ТаблицаВыписок.БанковскийСчет.Банк.Код = ""044525202""
				   |				ИЛИ (ТаблицаДанных.ПолучательСчет ПОДОБНО ""70601%"" И Документы.СчетКонтрагента.НомерСчета ПОДОБНО ""70601%""))
				   //IMAPPS-5200 aberdinskikh 21/11/2017
				   
				   |ИТОГИ
	               |	СУММА(ОтсутствуютВИсточнике),
	               |	СУММА(ОтсутствуютВБазе)
	               |ПО
	               |	КлючВыписки";
				   
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		КлючВыписки = Выборка.КлючВыписки;
		СтрокиВыписки = Выписки.НайтиСтроки(Новый Структура("КлючВыписки",КлючВыписки));
		Если СтрокиВыписки.Количество()=0 тогда Продолжить; КонецЕсли;
		
		ЕстьОтсутствующиеВбазе 	= Выборка.ОтсутствуютВБазе > 0;
		ЕстьЛишниеВБазе 		= Выборка.ОтсутствуютВИсточнике > 0;
		
		
		Детали = Выборка.Выбрать();
		ВсеНовые = Истина;
		Пока Детали.Следующий() Цикл
			
			СтрокиПП = ПлатежныеДокументы.НайтиСтроки(Новый Структура("КлючДокумента", Детали.КлючДокумента));
			Если СтрокиПП.Количество()=0 Тогда Продолжить; КонецЕсли;
			
			СтрокаПП = СтрокиПП[0];
			СтрокаПП.Документ = Детали.Документ;
			СтрокаПП.Загружен = детали.ОтсутствуютВБазе=0;
			
			Если СтрокаПП.Загружен тогда
				ВсеНовые = Ложь;
			КонецЕсли; 	
			
		Конеццикла;
		
		СтрокаВыписки = СтрокиВыписки[0];
		СтрокаВыписки.Загружать = ЕстьОтсутствующиеВбазе;
		
		Если ЕстьОтсутствующиеВбазе и ВсеНовые тогда
			СтрокаВыписки.Загружена  = 0;	
		ИначеЕсли ЕстьОтсутствующиеВбазе тогда
			СтрокаВыписки.Загружена  = -1;	
		Иначе
			СтрокаВыписки.Загружена  = 1;	
		КонецЕсли;
		
	Конеццикла;
	
	
				 
 КонецПроцедуры


