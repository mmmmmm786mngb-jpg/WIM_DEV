	               |	И АналитическиеСчета.НомерСчета <> """"";
	запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЕРС_ДоговорДУ = Выборка.ДоговорДУ;
