Функция ЕРС_ДоговорДУ_Отбор_ПоСчетуИНазначению(Знач НомерСчета)
	Перем Запрос, Данные;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Запрос.УстановитьПараметр("ПустойДоговорДУ", Справочники.ДоговорДУ.ПустаяСсылка());
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВложенныйЗапрос.ДоговорДУ КАК ДоговорДУ,
	|	СОКРЛП(ВРЕГ(ВложенныйЗапрос.ДоговорДУ.Префикс)) КАК Префикс
	|ИЗ
	|	(ВЫБРАТЬ
	|		АналитическиеСчета.ДоговорДУ КАК ДоговорДУ,
	|		АналитическиеСчета.Ссылка КАК Ссылка
	|	ИЗ
	|		Справочник.АналитическиеСчета КАК АналитическиеСчета
	|	ГДЕ
	|		АналитическиеСчета.МестоХранения.НомерСчета = &НомерСчета
	|		И АналитическиеСчета.ДоговорДУ <> &ПустойДоговорДУ
	|		И НЕ АналитическиеСчета.ПометкаУдаления
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		БанковскиеСчета.ДоговорДУ,
	|		БанковскиеСчета.Ссылка
	|	ИЗ
	|		Справочник.БанковскиеСчета КАК БанковскиеСчета
	|	ГДЕ
	|		БанковскиеСчета.НомерСчета = &НомерСчета
	|		И НЕ БанковскиеСчета.ПометкаУдаления
	|		И БанковскиеСчета.ДоговорДУ <> &ПустойДоговорДУ) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорДУ УБЫВ";
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	Возврат Данные;
КонецФункции // ЕРС_ДоговорДУ_Отбор_ПоСчетуИНазначению()

// IMDEV-9096 OPT-18: ЕРС_ДоговорДУ_ПоСчетуИНазначению (изменена - добавлен необязательный КэшКартПрефиксов)
Функция ЕРС_ДоговорДУ_ПоСчетуИНазначению(Знач Данные, Знач НомерСчета, Знач НазначениеПлатежа, КэшКартПрефиксов = Неопределено)
	Перем ГдеИскать;
	
	Если Данные = Неопределено Тогда
		Возврат Справочники.ДоговорДУ.ПустаяСсылка();
	КонецЕсли;
	
	// IMDEV-9096 OPT-18: карта префиксов строится один раз на счет и переиспользуется
	Карта = Неопределено;
	Если КэшКартПрефиксов <> Неопределено Тогда
		Карта = КэшКартПрефиксов.Получить(НомерСчета);
	КонецЕсли;
	Если Карта = Неопределено Тогда
		Карта = ПостроитьКартуПрефиксовЕРС(Данные);
		Если КэшКартПрефиксов <> Неопределено Тогда
			КэшКартПрефиксов.Вставить(НомерСчета, Карта);
		КонецЕсли;
	КонецЕсли;
	
	ГдеИскать = СтрЗаменить(ВРег(НазначениеПлатежа), "F", "Ф");
	ГдеИскать = СтрЗаменить(ГдеИскать, " ", "");
	ГдеИскать = СтрЗаменить(ГдеИскать, "-", "");
	
	Договор = НайтиДоговорПоКартеПрефиксов(ГдеИскать, Карта);
	Если Договор <> Неопределено Тогда
		Возврат Договор;
	КонецЕсли;
	
	// Сообщить("ЕРС. Для счета и НАЗНАЧЕНИЯ ПЛАТЕЖА :"+ НомерСчета + " не определен ДоговорДУ");
	Возврат Справочники.ДоговорДУ.ПустаяСсылка();
КонецФункции // ЕРС_ДоговорДУ_ПоСчетуИНазначению()

Функция ЕРС_ДоговорДУ_ПоСчетуИПоступлениюНаРС1(НомерСчета,НазначениеПлатежа)
	
	С = СокрЛП(ВРег(НазначениеПлатежа));
	Х = Найти(С,"УВЕДОМЛЕНИЕ N");
	Если Х = 0 Тогда Возврат Справочники.ДоговорДУ.ПустаяСсылка(); КонецЕсли;
	С = Сред(С,Х+14,СтрДлина(С)-Х-14);
	С = СокрЛП(С);
	Х = Найти(С," ");
	Если Х = 0 Тогда Возврат Справочники.ДоговорДУ.ПустаяСсылка(); КонецЕсли;
	ВхНомер = Лев(С,Х-1);
	С = Сред(С,Х+1,СтрДлина(С)-Х-1);
	С = СокрЛП(С);
	Если Лев(С,2) = "ОТ" Тогда С = Сред(С,3,СтрДлина(С)-3); КонецЕсли;
	С = СокрЛП(С);
	Попытка
		ВхДата = Дата(Сред(С,7,4),Сред(С,4,2),Сред(С,1,2));
	Исключение
		Справочники.ДоговорДУ.ПустаяСсылка();
	КонецПопытки;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеНаРасчетныйСчет.ДоговорДУ
		|ИЗ
		|	Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
		|ГДЕ
		|	(ПоступлениеНаРасчетныйСчет.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|			ИЛИ ПоступлениеНаРасчетныйСчет.НомерВходящегоДокумента = ""N"" + &НомерВходящегоДокумента)
		|	И ПоступлениеНаРасчетныйСчет.ДатаВходящегоДокумента = &ДатаВходящегоДокумента
		|	И ПоступлениеНаРасчетныйСчет.Проведен";
	Запрос.УстановитьПараметр("НомерВходящегоДокумента", ВхНомер);
	Запрос.УстановитьПараметр("ДатаВходящегоДокумента", ВхДата);
	
	РезультатЗапроса = Запрос.Выполнить();
