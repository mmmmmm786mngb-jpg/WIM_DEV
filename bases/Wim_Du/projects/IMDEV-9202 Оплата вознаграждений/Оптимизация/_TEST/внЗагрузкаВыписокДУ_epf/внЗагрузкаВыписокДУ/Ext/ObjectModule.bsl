Функция СписокБанковскихСчетовПоОтбору(ОтборУстановлен = Ложь) Экспорт
	
	СКД = ПолучитьМакет("БанковскиеСчета");
	СписокАктивов = Новый ТаблицаЗначений;
	
	СписокСчетов = Новый Массив;
	
	Настройки = СКД.НастройкиПоУмолчанию;

	Если НЕ ПараметрыОтбораБанковскихСчетов = "<Отборы/>" Тогда    //НЕ ПараметрыОтбораБанковскихСчетов = "" ИЛИ
		
		ПользовательскиеНастройки = Новый Соответствие;
		ПользовательскиеНастройки.Вставить("Отбор", ПараметрыОтбораБанковскихСчетов);
		
		ПользовательскиеОтборы = Новый ПользовательскиеНастройкиКомпоновкиДанных;
		Отбор = ПользовательскиеОтборы.Элементы.Добавить(тип("ОтборКомпоновкиДанных"));
		НастройкиСКД = Новый Структура("Отбор",Отбор);
		
		ОбщегоНазначенияДУ.УстановитьПользовательскиеНастройки(НастройкиСКД,ПользовательскиеНастройки);
		
		УстановитьОтбор(НастройкиСКД.Отбор,Настройки.Отбор);
		
		ОтборУстановлен = НастройкиСКД.Отбор.Элементы.Количество()>0;
		
        //Если НЕ ОтборУстановлен тогда
        //	Возврат СписокСчетов;
        //КонецЕсли;
		
    //Иначе
    //	Возврат СписокСчетов;
	КонецЕсли;

	КомпоновщикМакета   = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных  = КомпоновщикМакета.Выполнить(СКД, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(СписокАктивов);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	СписокСчетов = СписокАктивов.ВыгрузитьКолонку("Ссылка");
	Возврат СписокСчетов;
	
КонецФункции

Процедура УстановитьОтбор(ОтборИсточник, ОтборПриемник)
	
	Для каждого ТекОтбор из ОтборИсточник.Элементы Цикл
		НовыйОтбор = ОтборПриемник.Элементы.Добавить(ТипЗнч(ТекОтбор));
		ЗаполнитьЗначенияСвойств(НовыйОтбор, ТекОтбор);
		
		Если ТипЗнч(ТекОтбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") тогда
			  УстановитьОтбор(ТекОтбор, НовыйОтбор);
		КонецЕсли;
	Конеццикла;
	
КонецПроцедуры

