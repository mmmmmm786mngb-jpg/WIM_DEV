
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	Структура = Новый Структура;
	Структура.Вставить("Вид", ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка());
	Структура.Вставить("Наименование", "Поступления на расчетный счет: Розничное ДУ");
	Структура.Вставить("Версия", "1.08"); // IMDEV-9202
	Структура.Вставить("БезопасныйРежим", Ложь);
	Структура.Вставить("Информация", "");

	Команды = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(
		Команды, 
		"Поступления на расчетный счет: Розничное ДУ",
		"ПоступленияНаРасчетныйСчет_РозничноеДУ",
		"ОткрытиеФормы"
	);

	Структура.Вставить("Команды", Команды);

	Возврат Структура;

КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
	
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки.Значения);
		ВхНомер = "";
		ВхНомерВвод = "";
		//Если Настройки.Значения.Свойство("СписокРассылки") тогда
		//	СписокРассылки.Загрузить(XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки).Получить());
		//КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьНастройки(Настройки) Экспорт

	ДопОбработка = ДополнительнаяОбработка.ПолучитьОбъект();
	ДопОбработка.ХранилищеНастроек = Новый ХранилищеЗначения(Настройки);
	ДопОбработка.Записать();

КонецПроцедуры

Функция СтруктураНастрок() Экспорт
	
	Значения = Новый Структура;
	Для каждого РеквизитОбработки Из ЭтотОбъект.Метаданные().Реквизиты Цикл
		Если РеквизитОбработки.Имя <> "ВхНомерВвод" И РеквизитОбработки.Имя <> "ВхНомер" Тогда
			Значения.Вставить(РеквизитОбработки.Имя, ЭтотОбъект[РеквизитОбработки.Имя]);
		КонецЕсли;
	КонецЦикла;

	Возврат Значения;
	
Конецфункции

Процедура ПорученияПоДС(ВидОперации) Экспорт

	Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
		ПорученияПоДС.Очистить();
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийПоручение.ВводВДУ Тогда
		ПорученияПоДСВвод.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Поручение.Ссылка КАК ПоручениеПоДС,
		|	Поручение.ДоговорДУ КАК ДоговорДУ,
		|	Поручение.СуммаДС КАК СуммаДС,
		|	Поручение.ВидОперации КАК ВидОперации,
		|	АналитическиеСчета.Ссылка КАК АналитическийСчет,
		|	ВЫБОР
		|		КОГДА Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.ВводВДУ)
		|			ТОГДА АналитическиеСчета.ДоговорКонтрагента
		|		ИНАЧЕ Поручение.ДоговорКонтрагента
		|	КОНЕЦ КАК ДоговорКонтрагента,
		|	ВЫБОР
		|		КОГДА Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.ВводВДУ)
		|			ТОГДА Поручение.Контрагент
		|		ИНАЧЕ АналитическиеСчета.СубъектМестаХранения
		|	КОНЕЦ КАК Контрагент,
		|	Поручение.СчетКонтрагента КАК СчетКонтрагента,
		|	ВЫБОР
		|		КОГДА Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.ВводВДУ)
		|			ТОГДА ТорговыеКоды.АналитическийСчетЦБ
		|		ИНАЧЕ ТорговыеКоды.АналитическийСчетДС
		|	КОНЕЦ КАК АналитическийСчетПлательщик,
		|	ДоговорыДУ.Код КАК НомерДУ,
		|	НачислениеЗадолженности.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ПорученияПоДС
		|ИЗ
		|	Документ.Поручение КАК Поручение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорДУ КАК ДоговорыДУ
		|		ПО Поручение.ДоговорДУ = ДоговорыДУ.Ссылка
		|			И (ДоговорыДУ.Пул = &Пул)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
		|		ПО Поручение.Ссылка = ПоступлениеНаРасчетныйСчет.ПлановаяПозиция
		|			И (ПоступлениеНаРасчетныйСчет.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ПО Поручение.ДоговорДУ = НачислениеЗадолженности.ДоговорДУ
		|			И (НачислениеЗадолженности.Контрагент = &КонтрагентНДФЛ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АналитическиеСчета КАК АналитическиеСчета
		|		ПО Поручение.АналитическийСчетПриемник = АналитическиеСчета.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТорговыеКоды КАК ТорговыеКоды
		|		ПО Поручение.ДоговорДУ = ТорговыеКоды.ДоговорДУ
		|ГДЕ
		|	Поручение.ВидОперации = &ВидОперации
		|	И ПоступлениеНаРасчетныйСчет.Ссылка ЕСТЬ NULL
		|	И ВЫБОР
		|			КОГДА Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.Перевод)
		|				ТОГДА Поручение.АналитическийСчетИсточник = ТорговыеКоды.АналитическийСчетДС
		|						И Поручение.АналитическийСчетПриемник.МестоХранения = &ЕРС
		|			ИНАЧЕ НЕ &НаличиеНачисленияНДФЛ
		|					ИЛИ НЕ НачислениеЗадолженности.Ссылка ЕСТЬ NULL
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИсторияСтатусовОбъектовСрезПоследних.Объект КАК ПоручениеПоДС,
		|	ИсторияСтатусовОбъектовСрезПоследних.Статус КАК Статус
		|ПОМЕСТИТЬ ВТ_СтатусПорученийПоДС
		|ИЗ
		|	РегистрСведений.ИсторияСтатусовОбъектов.СрезПоследних(
		|			,
		|			Объект В
		|				(ВЫБРАТЬ
		|					ПорученияПоДС.ПоручениеПоДС
		|				ИЗ
		|					ВТ_ПорученияПоДС КАК ПорученияПоДС)) КАК ИсторияСтатусовОбъектовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПорученияПоДС.ПоручениеПоДС КАК ПоручениеПоДС,
		|	ПорученияПоДС.ДоговорДУ КАК ДоговорДУ,
		|	ПорученияПоДС.СуммаДС КАК СуммаДС,
		|	ПорученияПоДС.ВидОперации КАК ВидОперации,
		|	ПорученияПоДС.АналитическийСчет КАК АналитическийСчет,
		|	ПорученияПоДС.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ПорученияПоДС.Контрагент КАК Контрагент,
		|	ПорученияПоДС.СчетКонтрагента КАК СчетКонтрагента,
		|	ПорученияПоДС.АналитическийСчетПлательщик КАК АналитическийСчетПлательщик,
		|	ПорученияПоДС.НомерДУ КАК НомерДУ
		|ИЗ
		|	ВТ_ПорученияПоДС КАК ПорученияПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СтатусПорученийПоДС КАК СтатусПорученийПоДС
		|		ПО ПорученияПоДС.ПоручениеПоДС = СтатусПорученийПоДС.ПоручениеПоДС
		|			И (СтатусПорученийПоДС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.Новый))";
	
	Запрос.УстановитьПараметр("Пул", Пул);
	Запрос.УстановитьПараметр("ЕРС", ЕРС);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.УстановитьПараметр("НаличиеНачисленияНДФЛ", НаличиеНачисленияНДФЛ);
	Запрос.УстановитьПараметр("КонтрагентНДФЛ", КонтрагентНДФЛ);
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "ПоступленияНаРасчетныйСчет_РозничноеДУ.ПорученияПоДС");

	// IMDEV-9202: замер поиска поручений (запрос и заполнение ТЧ).
	КлючеваяОперацияЗамера = "ДУ.ПоступленияНаРасчетныйСчетРДУ.ПорученияПоДС";
	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	ВремяНачалаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
			ПоручениПоДС = ПорученияПоДС.Добавить();
		КонецЕсли;

		Если ВидОперации = Перечисления.ВидыОперацийПоручение.ВводВДУ Тогда
			ПоручениПоДС = ПорученияПоДСВвод.Добавить();
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(ПоручениПоДС, ВыборкаДетальныеЗаписи);

	КонецЦикла;

	Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
		КоличествоСтрок = ПорученияПоДС.Количество();
	Иначе
		КоличествоСтрок = ПорученияПоДСВвод.Количество();
	КонецЕсли;

	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс) / 1000;
	ВесЗамера = ?(КоличествоСтрок > 0, КоличествоСтрок, 1);
	Скорость = ?(ДлительностьСек > 0, КоличествоСтрок / ДлительностьСек, 0);
	КомментарийЗамера = "IMDEV-9202"
		+ "; ВидОперации=" + Строка(ВидОперации)
		+ "; Документов=" + Формат(КоличествоСтрок, "ЧН=0; ЧГ=0")
		+ "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " стр/с";
	ОценкаПроизводительности.ЗакончитьЗамерВремени(
		КлючеваяОперацияЗамера,
		ВремяНачалаЗамера,
		ВесЗамера,
		КомментарийЗамера,
		Ложь);

КонецПроцедуры

// IMDEV-9202: Создает документы Поступление по выбранному виду операции.
// Диспетчер: при объеме больше 50 строк запускает параллельные порции, иначе последовательный цикл.
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийПоручение - Перевод или ВводВДУ
//
Процедура СоздатьПоступленияДС(ВидОперации) Экспорт

	Если ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
		СоздатьПоступленияПоТабличнойЧасти(ПорученияПоДС, Настройки(Перечисления.ВидыОперацийПоручение.Перевод));
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПоручение.ВводВДУ Тогда
		СоздатьПоступленияПоТабличнойЧасти(ПорученияПоДСВвод, Настройки(Перечисления.ВидыОперацийПоручение.ВводВДУ));
	КонецЕсли;

КонецПроцедуры

// IMDEV-9202: Фоновый воркер: создает порцию документов Поступление.
// Точка входа для ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки.
//
// Параметры:
//  ПараметрыВыполнения - Строка, Структура - XML хранилища или структура пачки
//      (ДатаПоступления, ЕРС, Настройки, ТаблицаПачки, НомерПачки)
//  АдресХранилища - Строка - адрес результата во временном хранилище
//
// Пример:
//  ОбработатьПачкуПоступлений(ПараметрыПачки, АдресРезультата);
//
Процедура ОбработатьПачкуПоступлений(ПараметрыВыполнения, АдресХранилища) Экспорт

	Если ТипЗнч(ПараметрыВыполнения) = Тип("Строка") Тогда
		ПараметрыВыполнения = XMLЗначение(Тип("ХранилищеЗначения"), ПараметрыВыполнения).Получить();
	КонецЕсли;

	Результат = Новый Структура("НомерПачки, Создано, Ошибок, ТекстОшибок, Строки, ДлительностьСек",
		ПараметрыВыполнения.НомерПачки, 0, 0, "", Новый Массив, 0);

	КлючеваяОперацияЗамера = "ДУ.ПоступленияНаРасчетныйСчетРДУ.Пачка";
	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	ВремяНачалаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СтрокиОшибок = Новый Массив;
	КоличествоСтрокПачки = ПараметрыВыполнения.ТаблицаПачки.Количество();

	Попытка
		ДатаПоступления = ПараметрыВыполнения.ДатаПоступления;
		ЕРС = ПараметрыВыполнения.ЕРС;
		Настройки = ПараметрыВыполнения.Настройки;

		Для каждого СтрокаПачки Из ПараметрыВыполнения.ТаблицаПачки Цикл
			СсылкаПоступления = Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка();
			Если СтрокаПачки.ПоступлениеНаРасчетныйСчет = Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка() Тогда
				СсылкаПоступления = Поступление(СтрокаПачки, Настройки);
			Иначе
				СсылкаПоступления = СтрокаПачки.ПоступлениеНаРасчетныйСчет;
			КонецЕсли;

			Если ЗначениеЗаполнено(СсылкаПоступления) Тогда
				Результат.Создано = Результат.Создано + 1;
			Иначе
				Результат.Ошибок = Результат.Ошибок + 1;
				СтрокиОшибок.Добавить("Поручение " + Строка(СтрокаПачки.ПоручениеПоДС));
			КонецЕсли;

			Результат.Строки.Добавить(Новый Структура(
				"ПоручениеПоДС, ПоступлениеНаРасчетныйСчет",
				СтрокаПачки.ПоручениеПоДС,
				СсылкаПоступления));
		КонецЦикла;
	Исключение
		Результат.Ошибок = Результат.Ошибок + 1;
		СтрокиОшибок.Добавить(ОписаниеОшибки());
		ЗаписьЖурналаРегистрации(
			"IMDEV-9202.ПоступленияНаРасчетныйСчетРДУ",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Порция " + Формат(Результат.НомерПачки, "ЧГ=0") + ": " + ОписаниеОшибки());
	КонецПопытки;

	Результат.ТекстОшибок = СтрСоединить(СтрокиОшибок, Символы.ПС);
	Результат.ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс) / 1000;

	ВесЗамера = ?(КоличествоСтрокПачки > 0, КоличествоСтрокПачки, 1);
	Скорость = ?(Результат.ДлительностьСек > 0, Результат.Создано / Результат.ДлительностьСек, 0);
	КомментарийЗамера = "IMDEV-9202"
		+ "; Порция=" + Формат(Результат.НомерПачки, "ЧН=0; ЧГ=0")
		+ "; Документов=" + Формат(КоличествоСтрокПачки, "ЧН=0; ЧГ=0")
		+ "; Создано=" + Формат(Результат.Создано, "ЧН=0; ЧГ=0")
		+ "; Ошибок=" + Формат(Результат.Ошибок, "ЧН=0; ЧГ=0")
		+ "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " док/с";
	ОценкаПроизводительности.ЗакончитьЗамерВремени(
		КлючеваяОперацияЗамера,
		ВремяНачалаЗамера,
		ВесЗамера,
		КомментарийЗамера,
		Результат.Ошибок > 0);

	ПоместитьВоВременноеХранилище(XMLСтрока(Новый ХранилищеЗначения(Результат)), АдресХранилища);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// IMDEV-9202: Диспетчер создания поступлений по табличной части.
// Параллельный режим включается только если строк к созданию больше 50.
// При ошибке старта фона порция создается последовательно, остальные порции фон больше не запускают.
//
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть - ПорученияПоДС или ПорученияПоДСВвод
//  Настройки - Структура - настройки заполнения документа из функции Настройки()
//
Процедура СоздатьПоступленияПоТабличнойЧасти(ТабличнаяЧасть, Настройки)

	РазмерПачки = 50;
	ТаймаутОжиданияСек = 2;
	КоличествоПотоковРабочее = КоличествоПотоков;
	Если КоличествоПотоковРабочее < 1 Тогда
		КоличествоПотоковРабочее = 5;
	КонецЕсли;

	КлючеваяОперацияЗамера = "ДУ.ПоступленияНаРасчетныйСчетРДУ.Создать";
	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	ВремяНачалаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	КСозданию = 0;
	Для каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Если СтрокаТЧ.ПоступлениеНаРасчетныйСчет = Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка() Тогда
			КСозданию = КСозданию + 1;
		КонецЕсли;
	КонецЦикла;

	ДополнительнаяОбработкаСсылка = ДополнительнаяОбработка;
	Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту(
			"ИмяОбъекта", ЭтотОбъект.Метаданные().Имя);
	КонецЕсли;

	МожноПараллелить = КСозданию > РазмерПачки
		И КоличествоПотоковРабочее > 1
		И ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка)
		И ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены();

	Создано = 0;
	Ошибок = 0;
	Режим = "Последовательно";
	Порций = 0;
	ТекстОшибок = "";
	ПризнакБезопасногоРежима = (БезопасныйРежим() <> Ложь);

	Если МожноПараллелить Тогда

		Режим = "Параллельно";
		ТаблицаКСозданию = ТабличнаяЧасть.Выгрузить();
		ИндексСтроки = ТаблицаКСозданию.Количество() - 1;
		Пока ИндексСтроки >= 0 Цикл
			Если ТаблицаКСозданию[ИндексСтроки].ПоступлениеНаРасчетныйСчет
				<> Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка() Тогда
				ТаблицаКСозданию.Удалить(ИндексСтроки);
			КонецЕсли;
			ИндексСтроки = ИндексСтроки - 1;
		КонецЦикла;

		Всего = ТаблицаКСозданию.Количество();
		Активные = Новый Массив;
		НомерПачки = 0;
		Индекс = 0;
		ИдентификаторФормы = Новый УникальныйИдентификатор;
		СтрокиОшибок = Новый Массив;
		ФонНедоступен = Ложь;
		СозданоПараллельно = 0;

		Пока Индекс < Всего Или Активные.Количество() > 0 Цикл

			Пока Не ФонНедоступен
				И Активные.Количество() < КоличествоПотоковРабочее
				И Индекс < Всего Цикл

				РазмерТекущейПачки = Мин(РазмерПачки, Всего - Индекс);
				ТаблицаПачки = ТаблицаКСозданию.СкопироватьКолонки();
				Для Смещение = 0 По РазмерТекущейПачки - 1 Цикл
					ЗаполнитьЗначенияСвойств(ТаблицаПачки.Добавить(), ТаблицаКСозданию[Индекс + Смещение]);
				КонецЦикла;
				Индекс = Индекс + РазмерТекущейПачки;
				НомерПачки = НомерПачки + 1;

				ПараметрыПачки = Новый Структура;
				ПараметрыПачки.Вставить("ДатаПоступления", ДатаПоступления);
				ПараметрыПачки.Вставить("ЕРС", ЕРС);
				ПараметрыПачки.Вставить("Настройки", Настройки);
				ПараметрыПачки.Вставить("ТаблицаПачки", ТаблицаПачки);
				ПараметрыПачки.Вставить("НомерПачки", НомерПачки);

				ПараметрыМетода = Новый Структура;
				ПараметрыМетода.Вставить("ИмяМетода", "ОбработатьПачкуПоступлений");
				ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Истина);
				ПараметрыМетода.Вставить("ИмяОбработки", "");
				ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
				ПараметрыМетода.Вставить("ПараметрыВыполнения", XMLСтрока(Новый ХранилищеЗначения(ПараметрыПачки)));

				ПараметрыФона = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
				ПараметрыФона.ЗапуститьВФоне = Истина;
				// IMDEV-9202: 0, чтобы не блокировать старт соседних порций ожиданием внутри ВыполнитьВФоне.
				ПараметрыФона.ОжидатьЗавершение = 0;
				ПараметрыФона.НаименованиеФоновогоЗадания =
					"IMDEV-9202 создание поступлений, порция " + Формат(НомерПачки, "ЧГ=0");

				Контекст = ДлительныеОперации.ВыполнитьВФоне(
					"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
					ПараметрыМетода,
					ПараметрыФона);

				СтатусСтарта = "";
				Если ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("Статус") Тогда
					СтатусСтарта = Строка(Контекст.Статус);
				КонецЕсли;

				Если Не ЗначениеЗаполнено(Контекст.ИдентификаторЗадания)
					Или СтатусСтарта = "Ошибка"
					Или СтатусСтарта = "Отменено" Тогда

					ТекстОшибкиФона = ТекстОшибкиДлительнойОперации(
						Контекст,
						"Порция не стартовала в фоне.");
					ЗафиксироватьОшибкуПорции(НомерПачки, ТекстОшибкиФона, СтрокиОшибок);
					СоздатьПачкуПоследовательно(ТабличнаяЧасть, ТаблицаПачки, Настройки, Создано, Ошибок);
					ФонНедоступен = Истина;
				Иначе
					Активные.Добавить(Новый Структура(
						"Контекст, ТаблицаПачки, НомерПачки",
						Контекст,
						ТаблицаПачки,
						НомерПачки));
				КонецЕсли;

			КонецЦикла;

			Если Активные.Количество() > 0
				И ЗначениеЗаполнено(Активные[0].Контекст.ИдентификаторЗадания) Тогда
				Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
					Активные[0].Контекст.ИдентификаторЗадания);
				Если Задание <> Неопределено Тогда
					Попытка
						Задание.ОжидатьЗавершения(ТаймаутОжиданияСек);
					Исключение
						// Статус ниже через ОперацияВыполнена
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;

			ИндексАктивных = Активные.ВГраница();
			Пока ИндексАктивных >= 0 Цикл

				Описание = Активные[ИндексАктивных];
				Контекст = Описание.Контекст;
				СтатусЗадания = Неопределено;

				Если ЗначениеЗаполнено(Контекст.ИдентификаторЗадания) Тогда
					СтатусЗадания = ДлительныеОперации.ОперацияВыполнена(Контекст.ИдентификаторЗадания, Ложь);
					Если СтатусЗадания.Статус = "Выполняется" Тогда
						ИндексАктивных = ИндексАктивных - 1;
						Продолжить;
					КонецЕсли;
				КонецЕсли;

				СтатусФона = "";
				Если ТипЗнч(СтатусЗадания) = Тип("Структура") И СтатусЗадания.Свойство("Статус") Тогда
					СтатусФона = Строка(СтатусЗадания.Статус);
				КонецЕсли;

				Если Не ЗначениеЗаполнено(Контекст.ИдентификаторЗадания)
					Или СтатусФона = "Ошибка"
					Или СтатусФона = "Отменено" Тогда

					ТекстОшибкиФона = ТекстОшибкиДлительнойОперации(
						?(ТипЗнч(СтатусЗадания) = Тип("Структура"), СтатусЗадания, Контекст),
						"Порция завершилась ошибкой фона.");
					ЗафиксироватьОшибкуПорции(Описание.НомерПачки, ТекстОшибкиФона, СтрокиОшибок);
					СоздатьПачкуПоследовательно(
						ТабличнаяЧасть,
						Описание.ТаблицаПачки,
						Настройки,
						Создано,
						Ошибок);
					ФонНедоступен = Истина;
					Активные.Удалить(ИндексАктивных);
					ИндексАктивных = ИндексАктивных - 1;
					Продолжить;
				КонецЕсли;

				ИтогПачки = Неопределено;
				Если ЗначениеЗаполнено(Контекст.АдресРезультата) Тогда
					ЗначениеРезультата = ПолучитьИзВременногоХранилища(Контекст.АдресРезультата);
					Если ТипЗнч(ЗначениеРезультата) = Тип("Строка") И Не ПустаяСтрока(ЗначениеРезультата) Тогда
						Попытка
							ИтогПачки = XMLЗначение(Тип("ХранилищеЗначения"), ЗначениеРезультата).Получить();
						Исключение
							ИтогПачки = Неопределено;
						КонецПопытки;
					ИначеЕсли ТипЗнч(ЗначениеРезультата) = Тип("Структура") Тогда
						ИтогПачки = ЗначениеРезультата;
					КонецЕсли;
				КонецЕсли;

				Если ТипЗнч(ИтогПачки) = Тип("Структура") Тогда
					Создано = Создано + ИтогПачки.Создано;
					СозданоПараллельно = СозданоПараллельно + ИтогПачки.Создано;
					Ошибок = Ошибок + ИтогПачки.Ошибок;
					Если Не ПустаяСтрока(ИтогПачки.ТекстОшибок) И СтрокиОшибок.Количество() < 20 Тогда
						СтрокиОшибок.Добавить(ИтогПачки.ТекстОшибок);
					КонецЕсли;
					Если ТипЗнч(ИтогПачки.Строки) = Тип("Массив") Тогда
						Для каждого СтрокаРезультата Из ИтогПачки.Строки Цикл
							Найденные = ТабличнаяЧасть.НайтиСтроки(
								Новый Структура("ПоручениеПоДС", СтрокаРезультата.ПоручениеПоДС));
							Если Найденные.Количество() > 0 Тогда
								Найденные[0].ПоступлениеНаРасчетныйСчет = СтрокаРезультата.ПоступлениеНаРасчетныйСчет;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				Иначе
					ТекстОшибкиФона = "Порция не вернула результат.";
					ЗафиксироватьОшибкуПорции(Описание.НомерПачки, ТекстОшибкиФона, СтрокиОшибок);
					Ошибок = Ошибок + Описание.ТаблицаПачки.Количество();
				КонецЕсли;

				Активные.Удалить(ИндексАктивных);
				ИндексАктивных = ИндексАктивных - 1;

			КонецЦикла;

			Если ФонНедоступен И Индекс < Всего И Активные.Количество() = 0 Тогда
				Пока Индекс < Всего Цикл
					РазмерТекущейПачки = Мин(РазмерПачки, Всего - Индекс);
					ТаблицаПачки = ТаблицаКСозданию.СкопироватьКолонки();
					Для Смещение = 0 По РазмерТекущейПачки - 1 Цикл
						ЗаполнитьЗначенияСвойств(ТаблицаПачки.Добавить(), ТаблицаКСозданию[Индекс + Смещение]);
					КонецЦикла;
					Индекс = Индекс + РазмерТекущейПачки;
					НомерПачки = НомерПачки + 1;
					СоздатьПачкуПоследовательно(ТабличнаяЧасть, ТаблицаПачки, Настройки, Создано, Ошибок);
				КонецЦикла;
			КонецЕсли;

		КонецЦикла;

		Порций = НомерПачки;
		ТекстОшибок = СтрСоединить(СтрокиОшибок, Символы.ПС);
		Если ФонНедоступен Тогда
			ПричинаФона = ?(ПризнакБезопасногоРежима,
				"безопасный режим, фон недоступен",
				"фон недоступен");
			Если СозданоПараллельно = 0 Тогда
				Режим = "Последовательно (" + ПричинаФона + ")";
			Иначе
				Режим = "Смешанный (" + ПричинаФона + ")";
			КонецЕсли;
		Иначе
			Режим = Режим + ", потоков=" + Формат(КоличествоПотоковРабочее, "ЧГ=0")
				+ ", порция=" + Формат(РазмерПачки, "ЧГ=0");
		КонецЕсли;

	Иначе

		Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
			Режим = "Последовательно (обработка не зарегистрирована в доп. обработках)";
		ИначеЕсли КСозданию > РазмерПачки И ПризнакБезопасногоРежима Тогда
			Режим = "Последовательно (безопасный режим, фон недоступен)";
		КонецЕсли;

		Для каждого ПоручениеПоДС Из ТабличнаяЧасть Цикл
			Если ПоручениеПоДС.ПоступлениеНаРасчетныйСчет = Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка() Тогда
				ПоручениеПоДС.ПоступлениеНаРасчетныйСчет = Поступление(ПоручениеПоДС, Настройки);
				Если ЗначениеЗаполнено(ПоручениеПоДС.ПоступлениеНаРасчетныйСчет) Тогда
					Создано = Создано + 1;
				Иначе
					Ошибок = Ошибок + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс) / 1000;
	ВесЗамера = ?(КСозданию > 0, КСозданию, 1);
	Скорость = ?(ДлительностьСек > 0, Создано / ДлительностьСек, 0);
	КомментарийЗамера = "IMDEV-9202"
		+ "; Режим=" + Режим
		+ "; БезопасныйРежим=" + Строка(БезопасныйРежим())
		+ "; Потоков=" + Формат(КоличествоПотоковРабочее, "ЧН=0; ЧГ=0")
		+ "; Порций=" + Формат(Порций, "ЧН=0; ЧГ=0")
		+ "; Документов=" + Формат(КСозданию, "ЧН=0; ЧГ=0")
		+ "; Создано=" + Формат(Создано, "ЧН=0; ЧГ=0")
		+ "; Ошибок=" + Формат(Ошибок, "ЧН=0; ЧГ=0")
		+ "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " док/с";

	ОценкаПроизводительности.ЗакончитьЗамерВремени(
		КлючеваяОперацияЗамера,
		ВремяНачалаЗамера,
		ВесЗамера,
		КомментарийЗамера,
		Ошибок > 0);

	ТекстСводки = "IMDEV-9202 Создать: " + КомментарийЗамера
		+ "; Время=" + Формат(ДлительностьСек, "ЧДЦ=1; ЧН=0") + " сек";
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСводки);
	Если Не ПустаяСтрока(ТекстОшибок) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибок);
	КонецЕсли;

КонецПроцедуры

// IMDEV-9202: Создает документы только по строкам конкретной порции, если фон не отработал.
// Уже заполненные ссылки не трогает, чтобы не получить дубли документов.
//
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть - ПорученияПоДС или ПорученияПоДСВвод
//  ТаблицаПачки - ТаблицаЗначений - строки только этой порции
//  Настройки - Структура - настройки заполнения документа из функции Настройки()
//  Создано - Число - накопитель успешно созданных документов
//  Ошибок - Число - накопитель ошибок создания
//
Процедура СоздатьПачкуПоследовательно(ТабличнаяЧасть, ТаблицаПачки, Настройки, Создано, Ошибок)

	Для каждого СтрокаПачки Из ТаблицаПачки Цикл
		Найденные = ТабличнаяЧасть.НайтиСтроки(Новый Структура("ПоручениеПоДС", СтрокаПачки.ПоручениеПоДС));
		Если Найденные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТЧ = Найденные[0];
		Если СтрокаТЧ.ПоступлениеНаРасчетныйСчет <> Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТЧ.ПоступлениеНаРасчетныйСчет = Поступление(СтрокаТЧ, Настройки);
		Если ЗначениеЗаполнено(СтрокаТЧ.ПоступлениеНаРасчетныйСчет) Тогда
			Создано = Создано + 1;
		Иначе
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// IMDEV-9202: Пишет ошибку порции в журнал регистрации и в массив сообщений пользователю.
//
// Параметры:
//  НомерПачки - Число - номер порции
//  ТекстОшибки - Строка - краткое представление ошибки БСП или запасной текст
//  СтрокиОшибок - Массив - накопитель текстов для окна сообщений
//
Процедура ЗафиксироватьОшибкуПорции(НомерПачки, ТекстОшибки, СтрокиОшибок)

	ТекстЖурнала = "Порция " + Формат(НомерПачки, "ЧГ=0") + ": " + ТекстОшибки;
	ЗаписьЖурналаРегистрации(
		"IMDEV-9202.ПоступленияНаРасчетныйСчетРДУ",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстЖурнала);

	Если СтрокиОшибок.Количество() < 20 Тогда
		СтрокиОшибок.Добавить(ТекстЖурнала);
	КонецЕсли;

КонецПроцедуры

// IMDEV-9202: Достает КраткоеПредставлениеОшибки из ответа ДлительныеОперации.
//
// Параметры:
//  КонтекстОперации - Структура - результат ВыполнитьВФоне или ОперацияВыполнена
//  ТекстПоУмолчанию - Строка - текст, если БСП не вернула описание
//
// Возвращаемое значение:
//  Строка - текст ошибки для журнала и пользователя
//
Функция ТекстОшибкиДлительнойОперации(КонтекстОперации, ТекстПоУмолчанию)

	Если ТипЗнч(КонтекстОперации) = Тип("Структура")
		И КонтекстОперации.Свойство("КраткоеПредставлениеОшибки")
		И ЗначениеЗаполнено(КонтекстОперации.КраткоеПредставлениеОшибки) Тогда
		Возврат Строка(КонтекстОперации.КраткоеПредставлениеОшибки);
	КонецЕсли;

	Возврат ТекстПоУмолчанию;

КонецФункции

Функция Поступление(ПоручениеПоДС, Настройки)

	Поступление = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
	Поступление.Дата = ДатаПоступления + 9*3600;
	Поступление.ДатаВходящегоДокумента = ДатаПоступления;
	Поступление.ДоговорДУ = ПоручениеПоДС.ДоговорДУ;
	
	Поступление.УстановитьНовыйНомер();
	Поступление.БУ = Истина;
	Поступление.ВУ = Истина;
	Поступление.УУ = Истина;
	
	Поступление.НомерВходящегоДокумента = Настройки.ВхНомер;
	Поступление.ВидОперации = Настройки.ВидОперации;
	Поступление.ПлановаяПозиция = ПоручениеПоДС.ПоручениеПоДС;
	Поступление.ДокументОснование = ПоручениеПоДС.ПоручениеПоДС;
	Поступление.СчетДоговораДУ = ЕРС;
	Поступление.АналитическийСчет = ПоручениеПоДС.АналитическийСчет;
	Поступление.СтатьяДвиженияДенежныхСредств = Настройки.СтатьяДДС;
	Поступление.СтатьяЗатрат = Настройки.СтатьяЗатрат;
	Поступление.СчетБанк = ПланыСчетов.Хозрасчетный.РасчетныеСчета;
	
	Поступление.ВалютаДокумента = Справочники.Валюты.RUB;
	Поступление.КурсВзаиморасчетов = 1;
	Поступление.КратностьВзаиморасчетов = 1;
	Поступление.СуммаДокумента = ПоручениеПоДС.СуммаДС;
	
	// Данные корреспондента
	Поступление.Контрагент = ПоручениеПоДС.Контрагент;
	Поступление.СчетКонтрагента = ПоручениеПоДС.СчетКонтрагента;
	Поступление.ДоговорКонтрагента = ПоручениеПоДС.ДоговорКонтрагента;
	Поступление.СчетУчетаРасчетовСКонтрагентом = Настройки.СчетРасчетов;
	Поступление.АналитическийСчетПлательщик = ПоручениеПоДС.АналитическийСчетПлательщик;
	
	Поступление.НазначениеПлатежа = Настройки.НазначениеПлатежа + " " + ПоручениеПоДС.НомерДУ;
	
	// Проверка заполнения
	Если НЕ Поступление.ПроверитьЗаполнение() Тогда
		Описание = НСтр("ru = 'В документе %1 с видом операции: %2 не удалось пройти тест на заполненность обязательных реквизитов.'");
		Описание = СтрШаблон(Описание, Поступление, Поступление.ВидОперации);
		Отказ = Истина;
	КонецЕсли;
	
	// Проведение документа
	Попытка 
		Поступление.Записать(РежимЗаписиДокумента.Проведение);
		ПоступлениеВозврат = Поступление.Ссылка;
	Исключение
		Описание = ОписаниеОшибки();
		ОбщегоНазначенияДУКлиентСервер.СообщитьОбОшибке(Описание);
		ПоступлениеВозврат = Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка();
	КонецПопытки;
	
	Возврат ПоступлениеВозврат;

КонецФункции

Функция Настройки(ВидОперации)

	Настройки = Новый Структура;
	Если ВидОперации = Перечисления.ВидыОперацийПоручение.ВводВДУ Тогда
		Настройки.Вставить("ВхНомер", ВхНомерВвод);
		Настройки.Вставить("СтатьяДДС", СтатьяДДСВвод);
		Настройки.Вставить("СтатьяЗатрат", СтатьяЗатратВвод);
		Настройки.Вставить("СчетРасчетов", СчетРасчетовВвод);
		Настройки.Вставить("НазначениеПлатежа", НазначениеПлатежаВвод);
		Настройки.Вставить("ВидОперации", Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ПрочееПоступление);
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод Тогда
		Настройки.Вставить("ВхНомер", ВхНомер);
		Настройки.Вставить("СтатьяДДС", СтатьяДДС);
		Настройки.Вставить("СтатьяЗатрат", СтатьяЗатрат);
		Настройки.Вставить("СчетРасчетов", СчетРасчетов);
		Настройки.Вставить("НазначениеПлатежа", НазначениеПлатежа);
		Настройки.Вставить("ВидОперации", Перечисления.ВидыОперацийПоступлениеДенежныхСредств.СписаниеСБрокерскогоСчета);
	КонецЕсли;
	
	Возврат Настройки;

КонецФункции

