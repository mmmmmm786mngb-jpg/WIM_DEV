#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДополнительнаяОбработка = ОбработкаОбъект.ДополнительнаяОбработка;
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработка) Тогда
		Если ДополнительнаяОбработка = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда
			ИмяОбработки = ОбработкаОбъект.Метаданные().Имя;
			ДополнительнаяОбработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбработки);
		КонецЕсли;
	Иначе
		ИмяОбработки = ОбработкаОбъект.Метаданные().Имя;
		ДополнительнаяОбработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбработки);
	КонецЕсли;
	
	Если ДополнительнаяОбработка <> Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда
		Настройки = ДополнительнаяОбработка.ХранилищеНастроек.Получить();
		ОбработкаОбъект.УстановитьПользовательскиеНастройки(Настройки);
		
		ОбработкаОбъект.ДополнительнаяОбработка = ДополнительнаяОбработка;
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	КонецЕсли;
	
	Объект.ДатаПоступления = ТекущаяДатаСеанса();

	// IMDEV-9202: дефолт числа потоков, если в хранилище настроек ещё нет значения.
	Если Объект.КоличествоПотоков < 1 Тогда
		Объект.КоличествоПотоков = 3;
	КонецЕсли;

	Если ТипЗнч(Параметры) = Тип("ДанныеФормыСтруктура") Тогда
		Если Параметры.Свойство("ЭтоЗачисленияНаРСРозничногоДУ") = Истина Тогда
			Объект.ДатаПоступления = Параметры.ДатаПоступления;
			Объект.ВхНомер = Параметры.ВхНомер;
			Объект.НазначениеПлатежа = Параметры.НазначениеПлатежа;
			Элементы.ФормаНачислить.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	СохранитьНастройки();
КонецПроцедуры

#КонецОбласти


