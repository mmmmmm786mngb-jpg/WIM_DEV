#Область ОбработчикиКомандФормы

&НаСервере
Процедура ДоговорыКНачислениюНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПорученияПоДС(Перечисления.ВидыОперацийПоручение.Перевод);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ДоговорыКНачислению(Команда)
	ДоговорыКНачислениюНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.СоздатьПоступленияДС(Перечисления.ВидыОперацийПоручение.Перевод);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)
	Если Не ЗначениеЗаполнено(Объект.ВхНомер) Тогда
		ПоказатьПредупреждение(, "Не указан входящий номер.");
		Возврат;
	КонецЕсли;
	
	СоздатьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыбратьВводНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ПорученияПоДС(Перечисления.ВидыОперацийПоручение.ВводВДУ);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВвод(Команда)
	ВыбратьВводНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьВводНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.СоздатьПоступленияДС(Перечисления.ВидыОперацийПоручение.ВводВДУ);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура СоздатьВвод(Команда)
	Если Не ЗначениеЗаполнено(Объект.ВхНомерВвод) Тогда
		ПоказатьПредупреждение(, "Не указан входящий номер.");
		Возврат;
	КонецЕсли;
	
	СоздатьВводНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьНастройкиНаСервер()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Заголовок = "Настройки поступлений на расчетный счет: розничное ДУ";
	ЗначениеВыбора = Новый Структура;
	ЗначениеВыбора.Вставить("Значения", ОбработкаОбъект.СтруктураНастрок());
	ЗначениеВыбора.Вставить("ЗаголовокНастроек", Заголовок);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.СохранитьНастройки(ЗначениеВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки()
	СохранитьНастройкиНаСервер();
КонецПроцедуры


#КонецОбласти