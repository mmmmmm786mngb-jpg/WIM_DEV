#Область ПрограммныйИнтерфейс

// Описание: Сверка алгоритмов РасчетTWR: БЫЛО (НайтиСтроки) vs СТАЛО (block23 IMDEV-9005)
//
// Параметры:
//  МассивМандатов - Массив - ссылки на справочник Мандаты
//  ВремяВыполненияСек - Число - длительность, сек (возвращается по ссылке)
//
// Возвращаемое значение:
//  Структура - ключи: Итоги, ДанныеБыло, ДанныеСтало, ТаблицаСравнения, Расхождения
//
Функция ВыполнитьСверку(МассивМандатов, ВремяВыполненияСек = 0) Экспорт
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ОтчетМО = СоздатьОтчетМО(МассивМандатов);
	ДанныеTWRМО = ОтчетМО.TWR();
	
	Если ДанныеTWRМО.Количество() = 0 Тогда
		ВызватьИсключение "Нет данных TWR за указанный период и отбор мандатов";
	КонецЕсли;
	
	MV = ИзвлечьБазовуюMV(ДанныеTWRМО);
	ВводыВыводы = ВосстановитьВводыВыводы(ДанныеTWRМО);
	
	ДанныеБыло = РасчетTWR_Было(MV.Скопировать(), ВводыВыводы.Скопировать());
	ДанныеСтало = РасчетTWR_Стало(MV.Скопировать(), ВводыВыводы.Скопировать());
	
	РезультатСравнения = СравнитьТаблицыTWR(ДанныеБыло, ДанныеСтало);
	
	ВремяВыполненияСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	
	Результат = Новый Структура;
	Результат.Вставить("Итоги", РезультатСравнения.Итоги);
	Результат.Вставить("ДанныеБыло", ДанныеБыло);
	Результат.Вставить("ДанныеСтало", ДанныеСтало);
	Результат.Вставить("ТаблицаСравнения", РезультатСравнения.ТаблицаСравнения);
	Результат.Вставить("Расхождения", РезультатСравнения.Расхождения);
	Результат.Вставить("Период", Новый Структура("ДатаНачала, ДатаОкончания", ДатаНачала, ДатаОкончания));
	Результат.Вставить("Группировка", Группировка);
	Результат.Вставить("КоличествоМандатов", МассивМандатов.Количество());
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-9005.TWR.Сверка",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон("Сверка TWR %1: строк=%2, расхождений=%3, всеСовпадает=%4, сек=%5",
			Группировка,
			ДанныеБыло.Количество(),
			РезультатСравнения.Итоги.КоличествоРасхождений,
			РезультатСравнения.Итоги.ВсеСовпадает,
			Формат(ВремяВыполненияСек, "ЧДЦ=3")));
	
	Возврат Результат;
	
КонецФункции

// Описание: Формирует табличный документ сверки со всеми колонками таблицы TWR
//
// Параметры:
//  ДанныеСверки - Структура - результат ВыполнитьСверку
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция СформироватьТабличныйДокумент(ДанныеСверки) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	НомерСтроки = 1;
	
	Итоги = ДанныеСверки.Итоги;
	Период = ДанныеСверки.Период;
	
	НомерСтроки = ВывестиСтрокуТабДока(ТабДок, НомерСтроки, "Сверка математики РасчетTWR (IMDEV-9005 block23 vs оригинал MO)");
	НомерСтроки = ВывестиСтрокуТабДока(ТабДок, НомерСтроки,
		СтрШаблон("Период: %1 - %2 | Группировка: %3 | Мандатов: %4",
			Формат(Период.ДатаНачала, "ДЛФ=D"),
			Формат(Период.ДатаОкончания, "ДЛФ=D"),
			ДанныеСверки.Группировка,
			ДанныеСверки.КоличествоМандатов));
	НомерСтроки = ВывестиСтрокуТабДока(ТабДок, НомерСтроки,
		СтрШаблон("Строк TWR: %1 | Колонок: %2 | Расхождений ячеек: %3",
			Итоги.КоличествоСтрок,
			Итоги.КоличествоКолонок,
			Итоги.КоличествоРасхождений));
	
	Если Итоги.ВсеСовпадает Тогда
		ОбластьИтог = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1);
		ОбластьИтог.Текст = "ИТОГ: все строки и все колонки совпадают (БЫЛО = СТАЛО)";
		ОбластьИтог.ЦветФона = WebЦвета.СветлоЗеленый;
	Иначе
		ОбластьИтог = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1);
		ОбластьИтог.Текст = "ИТОГ: обнаружены расхождения между алгоритмами БЫЛО и СТАЛО";
		ОбластьИтог.ЦветФона = WebЦвета.Желтый;
	КонецЕсли;
	НомерСтроки = НомерСтроки + 2;
	
	НомерСтроки = ВывестиСтрокуТабДока(ТабДок, НомерСтроки, "Детальное сравнение (все колонки: Было / Стало / Совпадает)");
	НомерСтроки = ВывестиТаблицуЗначенийВТабДок(ТабДок, НомерСтроки, ДанныеСверки.ТаблицаСравнения, Истина);
	НомерСтроки = НомерСтроки + 1;
	
	Если ДанныеСверки.Расхождения.Количество() > 0 Тогда
		НомерСтроки = ВывестиСтрокуТабДока(ТабДок, НомерСтроки, "Список расхождений");
		НомерСтроки = ВывестиТаблицуЗначенийВТабДок(ТабДок, НомерСтроки, ДанныеСверки.Расхождения, Ложь);
		НомерСтроки = НомерСтроки + 1;
	КонецЕсли;
	
	НомерСтроки = ВывестиСтрокуТабДока(ТабДок, НомерСтроки, "Полная таблица TWR - алгоритм БЫЛО (оригинал MO, НайтиСтроки)");
	НомерСтроки = ВывестиТаблицуЗначенийВТабДок(ТабДок, НомерСтроки, ДанныеСверки.ДанныеБыло, Истина);
	НомерСтроки = НомерСтроки + 1;
	
	НомерСтроки = ВывестиСтрокуТабДока(ТабДок, НомерСтроки, "Полная таблица TWR - алгоритм СТАЛО (IMDEV-9005 block23)");
	НомерСтроки = ВывестиТаблицуЗначенийВТабДок(ТабДок, НомерСтроки, ДанныеСверки.ДанныеСтало, Истина);
	
	Возврат ТабДок;
	
КонецФункции

Процедура НастройкиПоУмолчанию() Экспорт
	
	План = Истина;
	ВознаграждениеКакПассив = Истина;
	КоммисияКакПассив = Ложь;
	НДФЛКакПассив = Истина;
	Группировка = "MANDATE_STRATEGY";
	Валюта = Справочники.Валюты.RUB;
	
КонецПроцедуры

Функция ЗагрузитьМандаты() Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ВызватьИсключение "Укажите дату окончания периода";
	КонецЕсли;
	
	ДанныеПоСтратегиям = ПолучитьДанныеПоСтратегиям(ДатаОкончания);
	
	ТаблицаМандатов = Новый ТаблицаЗначений;
	ТаблицаМандатов.Колонки.Добавить("Мандат", Новый ОписаниеТипов("СправочникСсылка.Мандаты"));
	ТаблицаМандатов.Колонки.Добавить("КодМандата", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
	ТаблицаМандатов.Колонки.Добавить("ИдентификаторСтратегии", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
	ТаблицаМандатов.Колонки.Добавить("НаименованиеСтратегии", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(150)));
	
	МандатыДобавлены = Новый Соответствие;
	
	Для Каждого СтрокаДанных Из ДанныеПоСтратегиям Цикл
		
		Если Группировка = "MANDATE_STRATEGY" Тогда
			
			Если СтрокаДанных.ИдентификаторСтратегии = "IS-001" Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаДанных.СтратегияЗакрыта И СтрокаДанных.ОтображатьНулевуюДоходность Тогда
				Продолжить;
			КонецЕсли;
			
			КлючУникальности = СтрокаДанных.КодМандата;
			
		Иначе
			КлючУникальности = Строка(СтрокаДанных.Мандат.УникальныйИдентификатор())
				+ "|" + СтрокаДанных.ИдентификаторСтратегии;
		КонецЕсли;
		
		Если МандатыДобавлены.Получить(КлючУникальности) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаМандатов.Добавить();
		НоваяСтрока.Мандат = СтрокаДанных.Мандат;
		НоваяСтрока.КодМандата = СтрокаДанных.КодМандата;
		НоваяСтрока.ИдентификаторСтратегии = СтрокаДанных.ИдентификаторСтратегии;
		НоваяСтрока.НаименованиеСтратегии = СтрокаДанных.НаименованиеСтратегии;
		
		МандатыДобавлены.Вставить(КлючУникальности, Истина);
		
	КонецЦикла;
	
	Возврат ТаблицаМандатов;
	
КонецФункции

#КонецОбласти

#Область РасчетTWR

// Описание: Оригинальный алгоритм MO до IMDEV-9005 block23 (НайтиСтроки по разделителям)
//
Функция РасчетTWR_Было(MV, ВводыВыводы)
	
	MV.Колонки.Добавить("IO", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("SUM_IO", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("Rn", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("Rn_Бенчмарк", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("Доходность", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("TWR_Бенчмарк", Новый ОписаниеТипов("Число"));
	
	Разделители = Новый Соответствие;
	Для Каждого ТекMV Из MV Цикл
		Разделители.Вставить(ТекMV.Разделитель);
		
		IO = 0;
		SUM_IO = 0;
		ПоискВводовВыводов = Новый Структура("Разделитель, Период", ТекMV.Разделитель, ТекMV.Период);
		СтрокиВводовВыводов = ВводыВыводы.НайтиСтроки(ПоискВводовВыводов);
		Если СтрокиВводовВыводов.Количество() > 0 Тогда
			IO = СтрокиВводовВыводов[0].Сумма;
			SUM_IO = СтрокиВводовВыводов[0].СуммаНакопительная;
		КонецЕсли;
		
		ТекMV.IO = IO;
		ТекMV.SUM_IO = SUM_IO;
		
		Rn = 1;
		Rn_Бенчмарк = 1;
		
		Если ТекMV.MVn_1 <> 0 Тогда
			Rn = (ТекMV.MVn - ТекMV.IO) / ТекMV.MVn_1;
			Rn_Бенчмарк = ТекMV.MVn / ТекMV.MVn_1;
		КонецЕсли;
		
		Если ТекMV.MVn_1 = 0 И ТекMV.IO <> 0 Тогда
			Rn = ТекMV.MVn / ТекMV.IO;
			Rn_Бенчмарк = ТекMV.MVn / ТекMV.IO;
		КонецЕсли;
		
		Если Rn > 2 Тогда
			Rn = 1;
		КонецЕсли;
		
		ТекMV.Rn = Rn;
		ТекMV.Rn_Бенчмарк = Rn_Бенчмарк;
		
	КонецЦикла;
	
	//MV.Сортировать("Разделитель, Период");  // ИКФ 2019-03-22 - закомментировано в MO
	MV.Индексы.Добавить("Разделитель, Период");
	
	Для Каждого ТекРазделитель Из Разделители Цикл
		
		ПараметрыПоискаСтрок = Новый Структура("Разделитель", ТекРазделитель.Ключ);
		СтрокиРазделителя = MV.НайтиСтроки(ПараметрыПоискаСтрок);
		
		Rn_Накопленный = 1;
		Rn_НакопленныйБенчмарк = 1;
		
		Для Каждого ТекСтрока Из СтрокиРазделителя Цикл
			
			Rn_Накопленный = Rn_Накопленный * ТекСтрока.Rn;
			Rn_НакопленныйБенчмарк = Rn_НакопленныйБенчмарк * ТекСтрока.Rn;
			
			ТекСтрока.Доходность = Rn_Накопленный - 1;
			ТекСтрока.TWR_Бенчмарк = Rn_НакопленныйБенчмарк - 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат MV;
	
КонецФункции

// Описание: Оптимизированный алгоритм IMDEV-9005 block23 (сортировка + один проход)
//
Функция РасчетTWR_Стало(MV, ВводыВыводы)
	
	MV.Колонки.Добавить("IO", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("SUM_IO", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("Rn", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("Rn_Бенчмарк", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("Доходность", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("TWR_Бенчмарк", Новый ОписаниеТипов("Число"));
	
	Разделители = Новый Соответствие;
	Для Каждого ТекMV Из MV Цикл
		Разделители.Вставить(ТекMV.Разделитель);
		
		IO = 0;
		SUM_IO = 0;
		ПоискВводовВыводов = Новый Структура("Разделитель, Период", ТекMV.Разделитель, ТекMV.Период);
		СтрокиВводовВыводов = ВводыВыводы.НайтиСтроки(ПоискВводовВыводов);
		Если СтрокиВводовВыводов.Количество() > 0 Тогда
			IO = СтрокиВводовВыводов[0].Сумма;
			SUM_IO = СтрокиВводовВыводов[0].СуммаНакопительная;
		КонецЕсли;
		
		ТекMV.IO = IO;
		ТекMV.SUM_IO = SUM_IO;
		
		Rn = 1;
		Rn_Бенчмарк = 1;
		
		Если ТекMV.MVn_1 <> 0 Тогда
			Rn = (ТекMV.MVn - ТекMV.IO) / ТекMV.MVn_1;
			Rn_Бенчмарк = ТекMV.MVn / ТекMV.MVn_1;
		КонецЕсли;
		
		Если ТекMV.MVn_1 = 0 И ТекMV.IO <> 0 Тогда
			Rn = ТекMV.MVn / ТекMV.IO;
			Rn_Бенчмарк = ТекMV.MVn / ТекMV.IO;
		КонецЕсли;
		
		Если Rn > 2 Тогда
			Rn = 1;
		КонецЕсли;
		
		ТекMV.Rn = Rn;
		ТекMV.Rn_Бенчмарк = Rn_Бенчмарк;
		
	КонецЦикла;
	
	MV.Сортировать("Разделитель, Период");
	
	ТекущийРазделитель = "";
	Rn_Накопленный = 1;
	Rn_НакопленныйБенчмарк = 1;
	
	Для Каждого ТекСтрока Из MV Цикл
		
		Если ТекСтрока.Разделитель <> ТекущийРазделитель Тогда
			ТекущийРазделитель = ТекСтрока.Разделитель;
			Rn_Накопленный = 1;
			Rn_НакопленныйБенчмарк = 1;
		КонецЕсли;
		
		Rn_Накопленный = Rn_Накопленный * ТекСтрока.Rn;
		Rn_НакопленныйБенчмарк = Rn_НакопленныйБенчмарк * ТекСтрока.Rn;
		
		ТекСтрока.Доходность = Rn_Накопленный - 1;
		ТекСтрока.TWR_Бенчмарк = Rn_НакопленныйБенчмарк - 1;
		
	КонецЦикла;
	
	Возврат MV;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьОтчетМО(МассивМандатов)
	
	ВалютаОтчета = ?(ЗначениеЗаполнено(Валюта), Валюта, Справочники.Валюты.RUB);
	
	Отчет = Отчеты.VTBAM_MWR_TWR.Создать();
	Отчет.ВалютаПересчета = ВалютаОтчета;
	Отчет.ВознаграждениеКакПассив = ВознаграждениеКакПассив;
	Отчет.ДатаНачала = ДатаНачала;
	Отчет.ДатаОкончания = ДатаОкончания;
	Отчет.План = План;
	Отчет.Группировка = Группировка;
	Отчет.КомиссииКакПассив = КоммисияКакПассив;
	Отчет.НДФЛКакПассив = НДФЛКакПассив;
	
	ОтборОтчета = Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы;
	
	Если МассивМандатов.Количество() > 0 Тогда
		ОтборМандата = ОтборОтчета.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборМандата.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Мандат");
		ОтборМандата.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ОтборМандата.ПравоеЗначение = МассивМандатов;
	КонецЕсли;
	
	Возврат Отчет;
	
КонецФункции

Функция ИзвлечьБазовуюMV(Источник)
	
	Результат = Новый ТаблицаЗначений;
	Для Каждого Колонка Из Источник.Колонки Цикл
		Если Колонка.Имя = "Период"
			Или Колонка.Имя = "Разделитель"
			Или Колонка.Имя = "MVn"
			Или Колонка.Имя = "MVn_1" Тогда
			Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаИсточника Из Источник Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточника);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВосстановитьВводыВыводы(Источник)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Разделитель", Источник.Колонки.Разделитель.ТипЗначения);
	Результат.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СуммаНакопительная", Новый ОписаниеТипов("Число"));
	
	Ключи = Новый Соответствие;
	
	Для Каждого СтрокаИсточника Из Источник Цикл
		
		Если СтрокаИсточника.IO = 0 И СтрокаИсточника.SUM_IO = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = КлючСтрокиTWR(СтрокаИсточника.Разделитель, СтрокаИсточника.Период);
		Если Ключи.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Разделитель = СтрокаИсточника.Разделитель;
		НоваяСтрока.Период = СтрокаИсточника.Период;
		НоваяСтрока.Сумма = СтрокаИсточника.IO;
		НоваяСтрока.СуммаНакопительная = СтрокаИсточника.SUM_IO;
		Ключи.Вставить(Ключ, Истина);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СравнитьТаблицыTWR(ДанныеБыло, ДанныеСтало)
	
	ИндексСтало = Новый Соответствие;
	Для Каждого СтрокаСтало Из ДанныеСтало Цикл
		ИндексСтало.Вставить(КлючСтрокиTWR(СтрокаСтало.Разделитель, СтрокаСтало.Период), СтрокаСтало);
	КонецЦикла;
	
	ТаблицаСравнения = Новый ТаблицаЗначений;
	ТаблицаСравнения.Колонки.Добавить("Разделитель");
	ТаблицаСравнения.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ТаблицаСравнения.Колонки.Добавить("СтрокаСовпадает", Новый ОписаниеТипов("Булево"));
	
	Для Каждого Колонка Из ДанныеБыло.Колонки Цикл
		ТаблицаСравнения.Колонки.Добавить(Колонка.Имя + "_Было");
		ТаблицаСравнения.Колонки.Добавить(Колонка.Имя + "_Стало");
		ТаблицаСравнения.Колонки.Добавить(Колонка.Имя + "_Совпадает", Новый ОписаниеТипов("Булево"));
	КонецЦикла;
	
	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("Разделитель");
	Расхождения.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	Расхождения.Колонки.Добавить("Колонка", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(100)));
	Расхождения.Колонки.Добавить("ЗначениеБыло");
	Расхождения.Колонки.Добавить("ЗначениеСтало");
	
	КоличествоРасхождений = 0;
	КоличествоСтрокСовпало = 0;
	
	Для Каждого СтрокаБыло Из ДанныеБыло Цикл
		
		Ключ = КлючСтрокиTWR(СтрокаБыло.Разделитель, СтрокаБыло.Период);
		СтрокаСтало = ИндексСтало.Получить(Ключ);
		
		СтрокаСравнения = ТаблицаСравнения.Добавить();
		СтрокаСравнения.Разделитель = СтрокаБыло.Разделитель;
		СтрокаСравнения.Период = СтрокаБыло.Период;
		
		СтрокаСовпадает = Истина;
		
		Если СтрокаСтало = Неопределено Тогда
			СтрокаСовпадает = Ложь;
			КоличествоРасхождений = КоличествоРасхождений + 1;
			НовРасх = Расхождения.Добавить();
			НовРасх.Разделитель = СтрокаБыло.Разделитель;
			НовРасх.Период = СтрокаБыло.Период;
			НовРасх.Колонка = "<строка отсутствует в СТАЛО>";
			НовРасх.ЗначениеБыло = "<есть>";
			НовРасх.ЗначениеСтало = "<нет>";
		Иначе
			
			Для Каждого Колонка Из ДанныеБыло.Колонки Цикл
				
				ИмяКолонки = Колонка.Имя;
				ЗначБыло = СтрокаБыло[ИмяКолонки];
				ЗначСтало = СтрокаСтало[ИмяКолонки];
				Совпадает = ЗначенияTWRСовпадают(ЗначБыло, ЗначСтало);
				
				СтрокаСравнения[ИмяКолонки + "_Было"] = ЗначБыло;
				СтрокаСравнения[ИмяКолонки + "_Стало"] = ЗначСтало;
				СтрокаСравнения[ИмяКолонки + "_Совпадает"] = Совпадает;
				
				Если НЕ Совпадает Тогда
					СтрокаСовпадает = Ложь;
					КоличествоРасхождений = КоличествоРасхождений + 1;
					НовРасх = Расхождения.Добавить();
					НовРасх.Разделитель = СтрокаБыло.Разделитель;
					НовРасх.Период = СтрокаБыло.Период;
					НовРасх.Колонка = ИмяКолонки;
					НовРасх.ЗначениеБыло = ПредставлениеЗначенияTWR(ЗначБыло);
					НовРасх.ЗначениеСтало = ПредставлениеЗначенияTWR(ЗначСтало);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		СтрокаСравнения.СтрокаСовпадает = СтрокаСовпадает;
		Если СтрокаСовпадает Тогда
			КоличествоСтрокСовпало = КоличествоСтрокСовпало + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	// Строки, которые есть только в СТАЛО
	ИндексБыло = Новый Соответствие;
	Для Каждого СтрокаБыло Из ДанныеБыло Цикл
		ИндексБыло.Вставить(КлючСтрокиTWR(СтрокаБыло.Разделитель, СтрокаБыло.Период), Истина);
	КонецЦикла;
	
	Для Каждого СтрокаСтало Из ДанныеСтало Цикл
		Ключ = КлючСтрокиTWR(СтрокаСтало.Разделитель, СтрокаСтало.Период);
		Если ИндексБыло.Получить(Ключ) = Неопределено Тогда
			КоличествоРасхождений = КоличествоРасхождений + 1;
			НовРасх = Расхождения.Добавить();
			НовРасх.Разделитель = СтрокаСтало.Разделитель;
			НовРасх.Период = СтрокаСтало.Период;
			НовРасх.Колонка = "<строка отсутствует в БЫЛО>";
			НовРасх.ЗначениеБыло = "<нет>";
			НовРасх.ЗначениеСтало = "<есть>";
		КонецЕсли;
	КонецЦикла;
	
	Итоги = Новый Структура;
	Итоги.Вставить("КоличествоСтрок", ДанныеБыло.Количество());
	Итоги.Вставить("КоличествоКолонок", ДанныеБыло.Колонки.Количество());
	Итоги.Вставить("КоличествоСтрокСовпало", КоличествоСтрокСовпало);
	Итоги.Вставить("КоличествоРасхождений", КоличествоРасхождений);
	Итоги.Вставить("ВсеСовпадает", КоличествоРасхождений = 0
		И ДанныеБыло.Количество() = ДанныеСтало.Количество());
	
	Результат = Новый Структура;
	Результат.Вставить("Итоги", Итоги);
	Результат.Вставить("ТаблицаСравнения", ТаблицаСравнения);
	Результат.Вставить("Расхождения", Расхождения);
	
	Возврат Результат;
	
КонецФункции

Функция КлючСтрокиTWR(Разделитель, Период)
	Возврат Строка(Разделитель) + "|" + XMLСтрока(Период);
КонецФункции

Функция ЗначенияTWRСовпадают(Знач1, Знач2)
	
	Если НЕ ЗначениеЗаполнено(Знач1) И НЕ ЗначениеЗаполнено(Знач2) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Знач1) = Тип("Число") Или ТипЗнч(Знач2) = Тип("Число") Тогда
		Ч1 = ?(ТипЗнч(Знач1) = Тип("Число"), Знач1, 0);
		Ч2 = ?(ТипЗнч(Знач2) = Тип("Число"), Знач2, 0);
		Разность = Ч1 - Ч2;
		Возврат Окр(Разность, 10) = 0 Или ?(Разность < 0, -Разность, Разность) <= 0.000001;
	КонецЕсли;
	
	Возврат Знач1 = Знач2;
	
КонецФункции

Функция ПредставлениеЗначенияTWR(Значение)
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧДЦ=10; ЧРД=.; ЧГ=");
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=DT");
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

Функция ВывестиСтрокуТабДока(ТабДок, НомерСтроки, Текст)
	ТабДок.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = Текст;
	Возврат НомерСтроки + 1;
КонецФункции

Функция ВывестиТаблицуЗначенийВТабДок(ТабДок, НомерСтроки, Таблица, ВыделятьЗаголовок)
	
	Если Таблица.Количество() = 0 Тогда
		Возврат ВывестиСтрокуТабДока(ТабДок, НомерСтроки, "<нет данных>");
	КонецЕсли;
	
	КоличествоКолонок = Таблица.Колонки.Количество();
	
	Если ВыделятьЗаголовок Тогда
		ОбластьШапки = ТабДок.Область(НомерСтроки, 1, НомерСтроки, КоличествоКолонок);
		ОбластьШапки.ЦветФона = WebЦвета.СветлоСерый;
		НомерКолонки = 1;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст = Колонка.Имя;
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НомерКолонки = 1;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ТекстЯчейки = ПредставлениеЗначенияTWR(СтрокаТаблицы[Колонка.Имя]);
			Если ТипЗнч(СтрокаТаблицы[Колонка.Имя]) = Тип("Булево") Тогда
				ТекстЯчейки = ?(СтрокаТаблицы[Колонка.Имя], "Да", "Нет");
			КонецЕсли;
			ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст = ТекстЯчейки;
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат НомерСтроки;
	
КонецФункции

// --- загрузка мандатов (как в внVTBAM_TWR_MANDATE_STRATEGY) ---

Функция ПолучитьДанныеПоСтратегиям(КонецПериода)
	
	НомераДоговоров = ПолучитьНомераДействующихДоговоров(КонецПериода);
	
	Если НомераДоговоров.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДанныеПоСтратегиям();
	Запрос.УстановитьПараметр("НомераДоговоров", НомераДоговоров);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьНомераДействующихДоговоров(КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Мандаты.НомерДоговора КАК НомерДоговора
	|ИЗ
	|	Справочник.Мандаты КАК Мандаты
	|ГДЕ
	|	Мандаты.НомерДоговора <> """"
	|	И НЕ Мандаты.Ссылка В
	|			(ВЫБРАТЬ
	|				ЗакрытыеПериоды.Мандат
	|			ИЗ
	|				РегистрСведений.ЗакрытыеПериоды КАК ЗакрытыеПериоды
	|			ГДЕ
	|				ЗакрытыеПериоды.РегламентныйПериод.ДатаПериода = &КонецПериода)";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерДоговора");
	
КонецФункции

Функция ТекстЗапросаДанныеПоСтратегиям()
	
	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Мандаты.Ссылка КАК Мандат,
	|	Мандаты.НомерДоговора КАК НомерДоговора,
	|	Мандаты.КодМандата КАК КодМандата,
	|	ДействующиеФинПланыСрезПоследних.ФинансовыйПлан КАК ФинансовыйПлан
	|ПОМЕСТИТЬ ВТ_ФинПлатыМандатов
	|ИЗ
	|	Справочник.Мандаты КАК Мандаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеФинПланы.СрезПоследних(&КонецПериода, Мандат.НомерДоговора В (&НомераДоговоров)) КАК ДействующиеФинПланыСрезПоследних
	|		ПО ДействующиеФинПланыСрезПоследних.Мандат = Мандаты.Ссылка
	|ГДЕ
	|	Мандаты.НомерДоговора В(&НомераДоговоров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,
	|	ВТ_ФинПлатыМандатов.НомерДоговора КАК НомерДоговора,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|		КОНЕЦ) КАК Стратегия
	|ПОМЕСТИТЬ ВТ_ИндивидуальныеСтратегииМандатов
	|ИЗ
	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий
	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ФинПлатыМандатов.НомерДоговора,
	|	ВТ_ФинПлатыМандатов.Мандат
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|		КОНЕЦ) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,
	|	ВТ_ФинПлатыМандатов.НомерДоговора КАК НомерДоговора,
	|	ВТ_ФинПлатыМандатов.КодМандата КАК КодМандата,
	|	ВЫБОР
	|		КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|			ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|		ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|	КОНЕЦ КАК Стратегия,
	|	ЕСТЬNULL(Стратегии.Наименование, """") КАК Наименование,
	|	ЕСТЬNULL(Стратегии.НаименованиеАнгл, """") КАК НаименованиеАнгл,
	|	ЕСТЬNULL(Стратегии.ВременнойГоризонт, 0) КАК ВременнойГоризонт,
	|	ЕСТЬNULL(Стратегии.Закрыта, ЛОЖЬ) КАК СтратегияЗакрыта,
	|	ЕСТЬNULL(Стратегии.ОтображатьНулевуюДоходность, ЛОЖЬ) КАК ОтображатьНулевуюДоходность
	|ПОМЕСТИТЬ ВТ_ОбщиеСтратегииМандатов
	|ИЗ
	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Стратегии КАК Стратегии
	|			ПО ФинансовыеПланыСоставСтратегий.Стратегия = Стратегии.Ссылка
	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка
	|ГДЕ
	|	НЕ ВТ_ФинПлатыМандатов.НомерДоговора В
	|				(ВЫБРАТЬ
	|					ВТ.НомерДоговора
	|				ИЗ
	|					ВТ_ИндивидуальныеСтратегииМандатов КАК ВТ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОбщиеСтратегииМандатов.Мандат КАК Мандат,
	|	ВТ_ОбщиеСтратегииМандатов.НомерДоговора КАК НомерДоговора,
	|	ВТ_ОбщиеСтратегииМандатов.КодМандата КАК КодМандата,
	|	ВТ_ОбщиеСтратегииМандатов.Стратегия.КодСтратегии КАК ИдентификаторСтратегии,
	|	ВЫБОР
