// =============================================================================
// IMDEV-9005: патч РасчетTWR — только блоки 2 и 3 (накопление TWR)
// =============================================================================
//
// Куда вносить:
//   Отчет.VTBAM_MWR_TWR
//   Модуль объекта (Ext/ObjectModule.bsl)
//   Функция: РасчетTWR(MV, ВводыВыводы)
//
// Исходник конфигурации МО (только для справки):
//   Wim_Mo/SRC/CF/Reports/VTBAM_MWR_TWR/Ext/ObjectModule.bsl
//   строки оригинала: ~2212-2302
//
// Отличие от полного патча (IMDEV-9005_RaschetTWR_patch_VTBAM_MWR_TWR.bsl):
//   Блок 1 (IO, SUM_IO, Rn) — БЕЗ ИЗМЕНЕНИЙ, штатный НайтиСтроки по ВводыВыводы.
//   Блок 2 — сортировка MV вместо индекса.
//   Блок 3 — один проход по MV вместо цикла Разделители + НайтиСтроки (~77% TWR).
//
// Примечание: Разделители по-прежнему наполняется в блоке 1 (как в оригинале),
//   но на шаге 2 не используется.
//
// =============================================================================

Функция РасчетTWR(MV, ВводыВыводы)

	MV.Колонки.Добавить("IO", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("SUM_IO", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("Rn", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("Rn_Бенчмарк", Новый ОписаниеТипов("Число"));

	MV.Колонки.Добавить("Доходность", Новый ОписаниеТипов("Число"));
	MV.Колонки.Добавить("TWR_Бенчмарк", Новый ОписаниеТипов("Число"));

	// ----- блок 1: без изменений (оригинал MO) -----

	Разделители = Новый Соответствие;
	Для Каждого ТекMV Из MV Цикл
		Разделители.Вставить(ТекMV.Разделитель);

		IO = 0;
		SUM_IO = 0;
		ПоискВводовВыводов = Новый Структура("Разделитель, Период", ТекMV.Разделитель, ТекMV.Период);
		СтрокиВводовВыводов = ВводыВыводы.НайтиСтроки(ПоискВводовВыводов);
		Если СтрокиВводовВыводов.Количество() > 0 Тогда
			IO = СтрокиВводовВыводов[0].Сумма;
			SUM_IO = СтрокиВводовВыводов[0].СуммаНакопительная;
		КонецЕсли;

		ТекMV.IO = IO;
		ТекMV.SUM_IO = SUM_IO;

		Rn = 1;
		Rn_Бенчмарк = 1;

		Если ТекMV.MVn_1 <> 0 Тогда
			Rn = (ТекMV.MVn - ТекMV.IO) / ТекMV.MVn_1;
			Rn_Бенчмарк = ТекMV.MVn / ТекMV.MVn_1;
		КонецЕсли;

		// <-- A.Sakhartsev 2016-04-06
		Если ТекMV.MVn_1 = 0 И ТекMV.IO <> 0 Тогда
			Rn = ТекMV.MVn / ТекMV.IO;
			Rn_Бенчмарк = ТекMV.MVn / ТекMV.IO;
		КонецЕсли;
		// >-- A.Sakhartsev 2016-04-06

		Если Rn > 2 Тогда // A.Sakhartsev 2015-08-27
			Rn = 1;
		КонецЕсли;

		ТекMV.Rn = Rn;
		ТекMV.Rn_Бенчмарк = Rn_Бенчмарк;

	КонецЦикла;

	// ----- IMDEV-9005 блок 2 УДАЛЕНО: индекс MV -----
	// MV.Сортировать("Разделитель, Период");  // было закомментировано ИКФ 2019-03-22
	// MV.Индексы.Добавить("Разделитель, Период");  // ИКФ 2019-03-22
	// MV.Индексы.Добавить("Разделитель");  // IMDEV-9005 минимальный фикс в MO
	// ----- конец УДАЛЕНО -----

	// ----- IMDEV-9005 блок 2 ДОБАВЛЕНО -----
	MV.Сортировать("Разделитель, Период");
	// ----- конец ДОБАВЛЕНО -----

	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(MV, "Расчет доходности TWR: MV с вводами/выводами");

	// ----- IMDEV-9005 блок 3 УДАЛЕНО: цикл по Разделители + MV.НайтиСтроки -----
	// //Расчет TWR
	// Для каждого ТекРазделитель из Разделители Цикл
	//     ПараметрыПоискаСтрок = Новый Структура("Разделитель", ТекРазделитель.Ключ);
	//     СтрокиРазделителя = MV.НайтиСтроки(ПараметрыПоискаСтрок);
	//     Rn_Накопленный = 1;
	//     Rn_НакопленныйБенчмарк = 1;
	//     Для каждого ТекСтрока из СтрокиРазделителя Цикл
	//         Rn_Накопленный = Rn_Накопленный * ТекСтрока.Rn;
	//         Rn_НакопленныйБенчмарк = Rn_НакопленныйБенчмарк * ТекСтрока.Rn;
	//         ТекСтрока.Доходность = Rn_Накопленный - 1;
	//         ТекСтрока.TWR_Бенчмарк = Rn_НакопленныйБенчмарк - 1;
	//     КонецЦикла;
	// КонецЦикла;
	// ----- конец УДАЛЕНО -----

	// ----- IMDEV-9005 блок 3 ДОБАВЛЕНО: один проход по отсортированной MV -----
	ТекущийРазделитель = "";
	Rn_Накопленный = 1;
	Rn_НакопленныйБенчмарк = 1;

	Для Каждого ТекСтрока Из MV Цикл

		Если ТекСтрока.Разделитель <> ТекущийРазделитель Тогда
			ТекущийРазделитель = ТекСтрока.Разделитель;
			Rn_Накопленный = 1;
			Rn_НакопленныйБенчмарк = 1;
		КонецЕсли;

		Rn_Накопленный = Rn_Накопленный * ТекСтрока.Rn;
		Rn_НакопленныйБенчмарк = Rn_НакопленныйБенчмарк * ТекСтрока.Rn;

		ТекСтрока.Доходность = Rn_Накопленный - 1;
		ТекСтрока.TWR_Бенчмарк = Rn_НакопленныйБенчмарк - 1;

	КонецЦикла;
	// ----- конец ДОБАВЛЕНО -----

	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(MV, "Расчет доходности TWR: TWR");

	Возврат MV;

КонецФункции
