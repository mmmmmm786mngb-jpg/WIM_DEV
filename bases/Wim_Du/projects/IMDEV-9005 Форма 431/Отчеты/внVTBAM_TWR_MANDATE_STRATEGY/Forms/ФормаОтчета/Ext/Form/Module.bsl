
&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	СинхронизироватьПериодВОбъект();
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	МассивМандатов = ПолучитьМассивМандатовИзТаблицы();
	ВремяСек = 0;
	
	ДанныеДоходности = ТекОбъект.ВыполнитьTWR(МассивМандатов, ВремяСек);
	
	Результат.Очистить();
	Результат.Вывести(ТекОбъект.СформироватьТабличныйДокумент(ДанныеДоходности));
	
	ВремяВыполнения = СтрШаблон("Время TWR: %1 сек, мандатов: %2, строк: %3",
		Формат(ВремяСек, "ЧДЦ=3"),
		МассивМандатов.Количество(),
		ДанныеДоходности.Количество());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМандаты(Команда)
	ЗагрузитьМандатыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьМандатыНаСервере()
	
	СинхронизироватьПериодВОбъект();
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ВызватьИсключение "Укажите дату окончания периода перед загрузкой мандатов";
	КонецЕсли;
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаЗагруженных = ТекОбъект.ЗагрузитьМандаты();
	
	Мандаты.Очистить();
	ИнициализироватьТаблицуМандатов();
	
	Для Каждого СтрокаЗагрузки Из ТаблицаЗагруженных Цикл
		ЗаполнитьЗначенияСвойств(Мандаты.Добавить(), СтрокаЗагрузки);
	КонецЦикла;
	
	ВремяВыполнения = СтрШаблон("Загружено мандатов: %1 (группировка %2, период до %3)",
		Мандаты.Количество(),
		Объект.Группировка,
		Формат(Объект.ДатаОкончания, "ДЛФ=D"));
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиПоУмолчанию(Команда)
	НастройкиПоУмолчаниюНаСервере();
КонецПроцедуры

&НаСервере
Процедура НастройкиПоУмолчаниюНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.НастройкиПоУмолчанию();
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	ОбновитьПериодНаФорме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодОтчетаПриИзменении(Элемент)
	Объект.ДатаНачала = ПериодОтчета.ДатаНачала;
	Объект.ДатаОкончания = ПериодОтчета.ДатаОкончания;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Если НЕ ЗначениеЗаполнено(ТекОбъект.Группировка) Тогда
		ТекОбъект.НастройкиПоУмолчанию();
		ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	КонецЕсли;
	
	ИнициализироватьТаблицуМандатов();
	ОбновитьПериодНаФорме();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьТаблицуМандатов()
	
	Если Мандаты.Колонки.Количество() = 0 Тогда
		Мандаты.Колонки.Добавить("Мандат", Новый ОписаниеТипов("СправочникСсылка.Мандаты"));
		Мандаты.Колонки.Добавить("КодМандата", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
		Мандаты.Колонки.Добавить("ИдентификаторСтратегии", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
		Мандаты.Колонки.Добавить("НаименованиеСтратегии", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(150)));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивМандатовИзТаблицы()
	
	МассивМандатов = Новый Массив;
	
	Для Каждого СтрокаМандата Из Мандаты Цикл
		Если ЗначениеЗаполнено(СтрокаМандата.Мандат) Тогда
			МассивМандатов.Добавить(СтрокаМандата.Мандат);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивМандатов;
	
КонецФункции

&НаСервере
Процедура ОбновитьПериодНаФорме()
	
	ПериодОтчета.ДатаНачала = Объект.ДатаНачала;
	ПериодОтчета.ДатаОкончания = Объект.ДатаОкончания;
	
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьПериодВОбъект()
	
	Объект.ДатаНачала = ПериодОтчета.ДатаНачала;
	Объект.ДатаОкончания = ПериодОтчета.ДатаОкончания;
	
КонецПроцедуры
