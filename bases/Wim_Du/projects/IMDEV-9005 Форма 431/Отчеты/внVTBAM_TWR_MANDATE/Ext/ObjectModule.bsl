#Область ПрограммныйИнтерфейс



// Описание: Выполняет TWR в цикле по стратегиям (режим MANDATE) как в обработке 0420431 NEW_Оптимизация

// Один вызов TWR на стратегию: МассивМандатов стратегии + ТекущаяСтрока.Стратегия + "MANDATE"

//

// Параметры:

//  ЗамерыПоСтратегиям - ТаблицаЗначений - детализация по стратегиям (заполняется процедурой)

//  ВремяВыполненияСек - Число - суммарное время всех вызовов TWR в секундах

//  КоличествоВызовов - Число - число выполненных вызовов TWR

//  ДанныеДоходностиДляОтчета - ТаблицаЗначений - результат последнего вызова для печатной формы

//

// Возвращаемое значение:

//  ТаблицаЗначений - ЗамерыПоСтратегиям (та же ссылка)

//

Функция ВыполнитьTWRПоСтратегиям(ЗамерыПоСтратегиям, ВремяВыполненияСек = 0, КоличествоВызовов = 0,

	ДанныеДоходностиДляОтчета = Неопределено) Экспорт

	

	ЗамерыПоСтратегиям.Очистить();

	ВремяВыполненияСек = 0;

	КоличествоВызовов = 0;

	ДанныеДоходностиДляОтчета = Неопределено;

	

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда

		ВызватьИсключение "Укажите дату окончания периода";

	КонецЕсли;

	

	ДанныеПоСтратегиям = ПолучитьДанныеПоСтратегиям(ДатаОкончания);

	ДанныеПоСтратегиямМ = ДанныеПоСтратегиям.Скопировать();

	ДанныеПоСтратегиямМ.Свернуть("Стратегия, ИдентификаторСтратегии, НаименованиеСтратегии");

	

	НачалоПериодаTWR = НачалоДня(НачалоГода(ДатаНачала) - 1);

	ВалютаОтчета = ?(ЗначениеЗаполнено(Валюта), Валюта, Справочники.Валюты.RUB);

	ВремяНачалаОбщее = ТекущаяУниверсальнаяДатаВМиллисекундах();

	

	Для Каждого ТекущаяСтрока Из ДанныеПоСтратегиямМ Цикл

		

		МассивМандатов = Новый Массив;

		Отбор = Новый Структура("Стратегия", ТекущаяСтрока.Стратегия);

		СтрокиМандатов = ДанныеПоСтратегиям.НайтиСтроки(Отбор);

		

		Для Каждого ТекСтрока Из СтрокиМандатов Цикл

			Если ТекСтрока.СтратегияЗакрыта И ТекСтрока.ОтображатьНулевуюДоходность Тогда

				Продолжить;

			КонецЕсли;

			МассивМандатов.Добавить(ТекСтрока.Мандат);

		КонецЦикла;

		

		Если МассивМандатов.Количество() = 0 Тогда

			Продолжить;

		КонецЕсли;

		

		ВремяНачалаВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();

		

		ДанныеДоходности = ВТБ_РасчетДоходностиСервер.TWR(

			НачалоПериодаTWR,

			ДатаОкончания,

			ВалютаОтчета,

			ВознаграждениеКакПассив,

			План,

			МассивМандатов,

			ТекущаяСтрока.Стратегия,

			"MANDATE",

			КоммисияКакПассив,

			НДФЛКакПассив);

		

		ВремяВызоваСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаВызова) / 1000;

		КоличествоВызовов = КоличествоВызовов + 1;

		ДанныеДоходностиДляОтчета = ДанныеДоходности;

		

		СтрокаЗамера = ЗамерыПоСтратегиям.Добавить();

		СтрокаЗамера.Стратегия = ТекущаяСтрока.Стратегия;

		СтрокаЗамера.ИдентификаторСтратегии = ТекущаяСтрока.ИдентификаторСтратегии;

		СтрокаЗамера.НаименованиеСтратегии = ТекущаяСтрока.НаименованиеСтратегии;

		СтрокаЗамера.Мандатов = МассивМандатов.Количество();

		СтрокаЗамера.ВремяСек = ВремяВызоваСек;

		СтрокаЗамера.СтрокРезультата = ДанныеДоходности.Количество();

		

	КонецЦикла;

	

	ВремяВыполненияСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаОбщее) / 1000;

	

	ЗаписьЖурналаРегистрации(

		"IMDEV-9005.TWR",

		УровеньЖурналаРегистрации.Информация,

		,

		,

		СтрШаблон("TWR MANDATE per-strategy: вызовов=%1, сек=%2",

			КоличествоВызовов,

			Формат(ВремяВыполненияСек, "ЧДЦ=3")));

	

	Возврат ЗамерыПоСтратегиям;

	

КонецФункции



// Описание: Формирует табличный документ по результату TWR через отчет VTBAM_MWR_TWR

//

// Параметры:

//  ДанныеДоходности - ТаблицаЗначений - результат расчета TWR

//

// Возвращаемое значение:

//  ТабличныйДокумент - печатная форма доходности

//

Функция СформироватьТабличныйДокумент(ДанныеДоходности) Экспорт

	

	ОтчетМО = Отчеты.VTBAM_MWR_TWR.Создать();

	Возврат ОтчетМО.ОтчетПоДоходности(ДанныеДоходности);

	

КонецФункции



// Описание: Создает пустую таблицу замеров по стратегиям

//

// Возвращаемое значение:

//  ТаблицаЗначений - колонки для детализации вызовов TWR

//

Функция НоваяТаблицаЗамеровПоСтратегиям() Экспорт

	

	ТаблицаЗамеров = Новый ТаблицаЗначений;

	ТаблицаЗамеров.Колонки.Добавить("Стратегия", Новый ОписаниеТипов("СправочникСсылка.Стратегии"));

	ТаблицаЗамеров.Колонки.Добавить("ИдентификаторСтратегии", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));

	ТаблицаЗамеров.Колонки.Добавить("НаименованиеСтратегии", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(150)));

	ТаблицаЗамеров.Колонки.Добавить("Мандатов", Новый ОписаниеТипов("Число"));

	ТаблицаЗамеров.Колонки.Добавить("ВремяСек", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(15, 3)));

	ТаблицаЗамеров.Колонки.Добавить("СтрокРезультата", Новый ОписаниеТипов("Число"));

	

	Возврат ТаблицаЗамеров;

	

КонецФункции



// Описание: Устанавливает параметры по умолчанию как в обработке заполнения 0420431 (режим MANDATE)

//

Процедура НастройкиПоУмолчанию() Экспорт

	

	План = Истина;

	ВознаграждениеКакПассив = Истина;

	КоммисияКакПассив = Ложь;

	НДФЛКакПассив = Истина;

	Валюта = Справочники.Валюты.RUB;

	

КонецПроцедуры



// Описание: Загружает мандаты для расчета TWR по логике обработки 0420431 (все стратегии, режим MANDATE)

//

// Возвращаемое значение:

//  ТаблицаЗначений - колонки Мандат, КодМандата, Стратегия, ИдентификаторСтратегии, НаименованиеСтратегии

//

Функция ЗагрузитьМандаты() Экспорт

	

	Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда

		ВызватьИсключение "Укажите дату окончания периода";

	КонецЕсли;

	

	ДанныеПоСтратегиям = ПолучитьДанныеПоСтратегиям(ДатаОкончания);

	

	ТаблицаМандатов = Новый ТаблицаЗначений;

	ТаблицаМандатов.Колонки.Добавить("Мандат", Новый ОписаниеТипов("СправочникСсылка.Мандаты"));

	ТаблицаМандатов.Колонки.Добавить("КодМандата", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));

	ТаблицаМандатов.Колонки.Добавить("Стратегия", Новый ОписаниеТипов("СправочникСсылка.Стратегии"));

	ТаблицаМандатов.Колонки.Добавить("ИдентификаторСтратегии", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));

	ТаблицаМандатов.Колонки.Добавить("НаименованиеСтратегии", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(150)));

	

	Для Каждого СтрокаДанных Из ДанныеПоСтратегиям Цикл

		

		Если СтрокаДанных.СтратегияЗакрыта И СтрокаДанных.ОтображатьНулевуюДоходность Тогда

			Продолжить;

		КонецЕсли;

		

		НоваяСтрока = ТаблицаМандатов.Добавить();

		НоваяСтрока.Мандат = СтрокаДанных.Мандат;

		НоваяСтрока.КодМандата = СтрокаДанных.КодМандата;

		НоваяСтрока.Стратегия = СтрокаДанных.Стратегия;

		НоваяСтрока.ИдентификаторСтратегии = СтрокаДанных.ИдентификаторСтратегии;

		НоваяСтрока.НаименованиеСтратегии = СтрокаДанных.НаименованиеСтратегии;

		

	КонецЦикла;

	

	Возврат ТаблицаМандатов;

	

КонецФункции



#КонецОбласти



#Область СлужебныеПроцедурыИФункции



Функция ПолучитьДанныеПоСтратегиям(КонецПериода)

	

	НомераДоговоров = ПолучитьНомераДействующихДоговоров(КонецПериода);

	

	Если НомераДоговоров.Количество() = 0 Тогда

		Возврат Новый ТаблицаЗначений;

	КонецЕсли;

	

	Запрос = Новый Запрос;

	Запрос.Текст = ТекстЗапросаДанныеПоСтратегиям();

	Запрос.УстановитьПараметр("НомераДоговоров", НомераДоговоров);

	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));

	

	Возврат Запрос.Выполнить().Выгрузить();

	

КонецФункции



Функция ПолучитьНомераДействующихДоговоров(КонецПериода)

	

	Запрос = Новый Запрос;

	Запрос.Текст =

	"ВЫБРАТЬ РАЗЛИЧНЫЕ

	|	Мандаты.НомерДоговора КАК НомерДоговора

	|ИЗ

	|	Справочник.Мандаты КАК Мандаты

	|ГДЕ

	|	Мандаты.НомерДоговора <> """"

	|	И НЕ Мандаты.Ссылка В

	|			(ВЫБРАТЬ

	|				ЗакрытыеПериоды.Мандат

	|			ИЗ

	|				РегистрСведений.ЗакрытыеПериоды КАК ЗакрытыеПериоды

	|			ГДЕ

	|				ЗакрытыеПериоды.РегламентныйПериод.ДатаПериода = &КонецПериода)";

	

	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));

	

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерДоговора");

	

КонецФункции



Функция ТекстЗапросаДанныеПоСтратегиям()

	

	Возврат

	"ВЫБРАТЬ РАЗЛИЧНЫЕ

	|	Мандаты.Ссылка КАК Мандат,

	|	Мандаты.НомерДоговора КАК НомерДоговора,

	|	Мандаты.КодМандата КАК КодМандата,

	|	ДействующиеФинПланыСрезПоследних.ФинансовыйПлан КАК ФинансовыйПлан

	|ПОМЕСТИТЬ ВТ_ФинПлатыМандатов

	|ИЗ

	|	Справочник.Мандаты КАК Мандаты

	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеФинПланы.СрезПоследних(&КонецПериода, Мандат.НомерДоговора В (&НомераДоговоров)) КАК ДействующиеФинПланыСрезПоследних

	|		ПО ДействующиеФинПланыСрезПоследних.Мандат = Мандаты.Ссылка

	|ГДЕ

	|	Мандаты.НомерДоговора В(&НомераДоговоров)

	|;

	|

	|////////////////////////////////////////////////////////////////////////////////

	|ВЫБРАТЬ

	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,

	|	ВТ_ФинПлатыМандатов.НомерДоговора КАК НомерДоговора,

	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР

	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)

	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель

	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия

	|		КОНЕЦ) КАК Стратегия

	|ПОМЕСТИТЬ ВТ_ИндивидуальныеСтратегииМандатов

	|ИЗ

	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов

	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий

	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка

	|

	|СГРУППИРОВАТЬ ПО

	|	ВТ_ФинПлатыМандатов.НомерДоговора,

	|	ВТ_ФинПлатыМандатов.Мандат

	|

	|ИМЕЮЩИЕ

	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР

	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)

	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель

	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия

	|		КОНЕЦ) > 1

	|;

	|

	|////////////////////////////////////////////////////////////////////////////////

	|ВЫБРАТЬ

	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,

	|	ВТ_ФинПлатыМандатов.НомерДоговора КАК НомерДоговора,

	|	ВТ_ФинПлатыМандатов.КодМандата КАК КодМандата,

	|	ВЫБОР

	|		КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)

	|			ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель

	|		ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия

	|	КОНЕЦ КАК Стратегия,

	|	ЕСТЬNULL(Стратегии.Наименование, """") КАК Наименование,

	|	ЕСТЬNULL(Стратегии.НаименованиеАнгл, """") КАК НаименованиеАнгл,

	|	ЕСТЬNULL(Стратегии.ВременнойГоризонт, 0) КАК ВременнойГоризонт,

	|	ЕСТЬNULL(Стратегии.Закрыта, ЛОЖЬ) КАК СтратегияЗакрыта,

	|	ЕСТЬNULL(Стратегии.ОтображатьНулевуюДоходность, ЛОЖЬ) КАК ОтображатьНулевуюДоходность

	|ПОМЕСТИТЬ ВТ_ОбщиеСтратегииМандатов

	|ИЗ

	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов

	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий

	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Стратегии КАК Стратегии

	|			ПО ФинансовыеПланыСоставСтратегий.Стратегия = Стратегии.Ссылка

	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка

	|ГДЕ

	|	НЕ ВТ_ФинПлатыМандатов.НомерДоговора В

	|				(ВЫБРАТЬ

	|					ВТ.НомерДоговора

	|				ИЗ

	|					ВТ_ИндивидуальныеСтратегииМандатов КАК ВТ)

	|;

	|

	|////////////////////////////////////////////////////////////////////////////////

	|ВЫБРАТЬ

	|	ВТ_ОбщиеСтратегииМандатов.Мандат КАК Мандат,

	|	ВТ_ОбщиеСтратегииМандатов.НомерДоговора КАК НомерДоговора,

	|	ВТ_ОбщиеСтратегииМандатов.КодМандата КАК КодМандата,

	|	ВТ_ОбщиеСтратегииМандатов.Стратегия.КодСтратегии КАК ИдентификаторСтратегии,

	|	ВЫБОР

	|		КОГДА ВТ_ОбщиеСтратегииМандатов.НаименованиеАнгл = """"

	|			ТОГДА ВТ_ОбщиеСтратегииМандатов.Наименование

	|		ИНАЧЕ ВТ_ОбщиеСтратегииМандатов.НаименованиеАнгл

	|	КОНЕЦ КАК НаименованиеСтратегии,

	|	ВТ_ОбщиеСтратегииМандатов.Стратегия КАК Стратегия,

	|	ВТ_ОбщиеСтратегииМандатов.ВременнойГоризонт КАК ВременнойГоризонт,

	|	ВТ_ОбщиеСтратегииМандатов.СтратегияЗакрыта КАК СтратегияЗакрыта,

	|	ВТ_ОбщиеСтратегииМандатов.ОтображатьНулевуюДоходность КАК ОтображатьНулевуюДоходность

	|ИЗ

	|	ВТ_ОбщиеСтратегииМандатов КАК ВТ_ОбщиеСтратегииМандатов

	|

	|ОБЪЕДИНИТЬ ВСЕ

	|

	|ВЫБРАТЬ

	|	ВТ_ИндивидуальныеСтратегииМандатов.Мандат,

	|	ВТ_ИндивидуальныеСтратегииМандатов.НомерДоговора,

	|	ВТ_ИндивидуальныеСтратегииМандатов.Мандат.КодМандата,

	|	""IS-001"",

	|	""Индивидуальная стратегия"",

	|	ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка),

	|	730,

	|	ЛОЖЬ,

	|	ЛОЖЬ

	|ИЗ

	|	ВТ_ИндивидуальныеСтратегииМандатов КАК ВТ_ИндивидуальныеСтратегииМандатов";

	

КонецФункции



#КонецОбласти


