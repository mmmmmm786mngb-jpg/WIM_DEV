
&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	СинхронизироватьПериодВОбъект();
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Замеры = ТекОбъект.НоваяТаблицаЗамеровПоСтратегиям();
	ВремяСек = 0;
	КоличествоВызовов = 0;
	ДанныеДоходности = Неопределено;
	
	ТекОбъект.ВыполнитьTWRПоСтратегиям(Замеры, ВремяСек, КоличествоВызовов, ДанныеДоходности);
	
	ЗначениеВРеквизитФормы(Замеры, "ЗамерыПоСтратегиям");
	
	Результат.Очистить();
	Если ДанныеДоходности <> Неопределено Тогда
		Результат.Вывести(ТекОбъект.СформироватьТабличныйДокумент(ДанныеДоходности));
	КонецЕсли;
	
	СуммаМандатов = 0;
	Для Каждого СтрокаЗамера Из Замеры Цикл
		СуммаМандатов = СуммаМандатов + СтрокаЗамера.Мандатов;
	КонецЦикла;
	
	ВремяВыполнения = СтрШаблон("TWR MANDATE: вызовов=%1, сек=%2, мандатов (сумма)=%3",
		КоличествоВызовов,
		Формат(ВремяСек, "ЧДЦ=3"),
		СуммаМандатов);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМандаты(Команда)
	ЗагрузитьМандатыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьМандатыНаСервере()
	
	СинхронизироватьПериодВОбъект();
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ВызватьИсключение "Укажите дату окончания периода перед загрузкой мандатов";
	КонецЕсли;
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаЗагруженных = ТекОбъект.ЗагрузитьМандаты();
	
	ЗначениеВРеквизитФормы(ТаблицаЗагруженных, "Мандаты");
	
	ВремяВыполнения = СтрШаблон("Загружено мандатов: %1 (MANDATE, все стратегии, период до %2)",
		ТаблицаЗагруженных.Количество(),
		Формат(Объект.ДатаОкончания, "ДЛФ=D"));
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиПоУмолчанию(Команда)
	НастройкиПоУмолчаниюНаСервере();
КонецПроцедуры

&НаСервере
Процедура НастройкиПоУмолчаниюНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.НастройкиПоУмолчанию();
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	ОбновитьПериодНаФорме();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодОтчетаПриИзменении(Элемент)
	Объект.ДатаНачала = ПериодОтчета.ДатаНачала;
	Объект.ДатаОкончания = ПериодОтчета.ДатаОкончания;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Если НЕ ЗначениеЗаполнено(ТекОбъект.ДатаОкончания) Тогда
		ТекОбъект.НастройкиПоУмолчанию();
		ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	КонецЕсли;
	
	ОбновитьПериодНаФорме();
	РежимTWR = "MANDATE (per-strategy)";
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПериодНаФорме()
	
	ПериодОтчета.ДатаНачала = Объект.ДатаНачала;
	ПериодОтчета.ДатаОкончания = Объект.ДатаОкончания;
	
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьПериодВОбъект()
	
	Объект.ДатаНачала = ПериодОтчета.ДатаНачала;
	Объект.ДатаОкончания = ПериодОтчета.ДатаОкончания;
	
КонецПроцедуры
