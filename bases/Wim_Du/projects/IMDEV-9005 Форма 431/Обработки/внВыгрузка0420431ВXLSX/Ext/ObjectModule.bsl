#Область ПрограммныйИнтерфейс

// Описание: Сведения для подсистемы БСП "Дополнительные отчеты и обработки"
// Важно: БезопасныйРежим = Ложь - иначе запрещены Новый Файл / запись XLSX на сервере
//
// Возвращаемое значение:
// Структура - параметры регистрации внешней обработки
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", "Выгрузка документа 0420431 в XLSX");
	ПараметрыРегистрации.Вставить("Версия", ВерсияОбработки());
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Выгрузка регл. отчета 0420431 в книгу Excel (лист Шапка и все табличные части)."
		+ " Источник: документ 1С или файл XML/XTDD стандартной выгрузки.");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(
		ТаблицаКоманд,
		"Выгрузка 0420431 в XLSX",
		"внВыгрузка0420431ВXLSX",
		"ОткрытиеФормы");
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Описание: Возвращает номер версии внешней обработки (менять при каждом изменении)
//
// Возвращаемое значение:
// Строка - номер версии
//
Функция ВерсияОбработки() Экспорт
	
	Возврат "1.0.16";
	
КонецФункции

// Описание: Точка входа для фонового задания БСП (ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки)
// При возможности пересоздает обработку без безопасного режима (ВнешниеОбработки.Создать(..., Ложь)),
// чтобы запись XLSX во временный файл и чтение двоичных данных не блокировались
//
// Параметры:
// ПараметрыВыполнения - Структура - поля Документ / ПутьXML, ИсточникДанных, ПутьEPF (необязательно)
// АдресХранилища - Строка - адрес результата во временном хранилище
//
Процедура СформироватьФайлXLSXВФоне(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	Результат = Неопределено;
	ПутьEPF = "";
	Если ПараметрыВыполнения.Свойство("ПутьEPF") Тогда
		ПутьEPF = ПараметрыВыполнения.ПутьEPF;
	КонецЕсли;
	
	ИсточникДанных = "Документ";
	Если ПараметрыВыполнения.Свойство("ИсточникДанных")
		И ЗначениеЗаполнено(ПараметрыВыполнения.ИсточникДанных) Тогда
		ИсточникДанных = ПараметрыВыполнения.ИсточникДанных;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПутьEPF) Тогда
		Попытка
			ОбработкаБезОграничений = ВнешниеОбработки.Создать(ПутьEPF, Ложь);
			Если ИсточникДанных = "ФайлXML" Тогда
				Результат = ОбработкаБезОграничений.СформироватьФайлXLSXИзXML(ПараметрыВыполнения.ПутьXML);
			Иначе
				Результат = ОбработкаБезОграничений.СформироватьФайлXLSX(ПараметрыВыполнения.Документ);
			КонецЕсли;
		Исключение
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Если ИсточникДанных = "ФайлXML" Тогда
			Результат = СформироватьФайлXLSXИзXML(ПараметрыВыполнения.ПутьXML);
		Иначе
			Результат = СформироватьФайлXLSX(ПараметрыВыполнения.Документ);
		КонецЕсли;
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
	
КонецПроцедуры

// Описание: Формирует двоичные данные XLSX: лист "Шапка" и по листу на каждую ТЧ документа 0420431.
// Если в конфигурации есть РегистрСведений.ДанныеРегламентныхОтчетов - крупные разделы
// (например Раздел4) читаются из регистра; иначе - только из табличных частей документа.
// В фоне сообщает прогресс через ДлительныеОперации.СообщитьПрогресс (процент и оценка остатка)
//
// Параметры:
// Документ - ДокументСсылка.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У - документ отчета
//
// Возвращаемое значение:
// Структура - поля: Успех (Булево), ДвоичныеДанные (ДвоичныеДанные), Описание (Строка), ИмяФайла (Строка)
//
Функция СформироватьФайлXLSX(Документ) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ДвоичныеДанные", Неопределено);
	Результат.Вставить("Описание", "");
	Результат.Вставить("ИмяФайла", "");
	
	// Фон через ВнешниеОбработки.Создать() часто идет в безопасном режиме.
	// При File->Открыть синхронный вызов с формы безопасный режим обычно выключен.
	Попытка
		УстановитьБезопасныйРежим(Ложь);
	Исключение
		// если режим жестко запрещен платформой - продолжаем как есть
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Результат.Описание = "Не выбран документ 0420431.";
		Возврат Результат;
	КонецЕсли;
	
	ВремяНачалаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МетаданныеДокумента = Метаданные.Документы.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У;
	КоличествоТЧ = МетаданныеДокумента.ТабличныеЧасти.Количество();
	// этапы: чтение документа, шапка, N разделов, запись XLSX
	ВсегоЭтапов = 2 + КоличествоТЧ + 1;
	НомерЭтапа = 0;
	
	НомерЭтапа = НомерЭтапа + 1;
	СообщитьПрогрессВыгрузки(НомерЭтапа, ВсегоЭтапов, "Чтение документа 0420431", ВремяНачалаМс);
	ДокументОбъект = Документ.ПолучитьОбъект();
	
	// Кэш наличия регистра + имена ТЧ в регистре (без распаковки ХранилищеЗначения).
	// Восстановление ТЧ из регистра - один раз; повторно регистр по каждой ТЧ не читаем.
	РегистрДоступен = РегистрДанныеРегламентныхОтчетовДоступен();
	ИменаТЧВРегистре = Новый Соответствие;
	Если РегистрДоступен Тогда
		ИменаТЧВРегистре = ПолучитьИменаТабЧастейВРегистре(Документ);
		ВосстановитьТабличныеЧастиИзРегистраЕслиДоступно(ДокументОбъект, РегистрДоступен);
	КонецЕсли;
	
	Пакет = Новый ПакетОтображаемыхДокументов;
	ОписанияЛистов = Новый Массив;
	
	НомерЭтапа = НомерЭтапа + 1;
	СообщитьПрогрессВыгрузки(НомерЭтапа, ВсегоЭтапов, "Формирование листа ""Шапка""", ВремяНачалаМс);
	ТабДокШапка = СформироватьТабличныйДокументШапки(ДокументОбъект, МетаданныеДокумента);
	ДобавитьЛистВПакет(Пакет, "Шапка", ТабДокШапка);
	ОписанияЛистов.Добавить("Шапка");
	
	ИндексРаздела = 0;
	Для Каждого ОписаниеТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		
		ИндексРаздела = ИндексРаздела + 1;
		НомерЭтапа = НомерЭтапа + 1;
		
		ИмяЛиста = ИмяЛистаExcel(ОписаниеТЧ.Имя);
		СообщитьПрогрессВыгрузки(
			НомерЭтапа,
			ВсегоЭтапов,
			СтрШаблон("Лист %1 (%2 из %3)", ИмяЛиста, ИндексРаздела, КоличествоТЧ),
			ВремяНачалаМс);
		
		РезультатЧтенияТЧ = ПолучитьТаблицуРазделаДляВыгрузки(
			ДокументОбъект,
			ОписаниеТЧ.Имя,
			РегистрДоступен,
			ИменаТЧВРегистре);
		ТаблицаРаздела = РезультатЧтенияТЧ.Таблица;
		УдалитьСлужебныеКолонки(ТаблицаРаздела);
		
		КонтекстПрогресса = Новый Структура;
		КонтекстПрогресса.Вставить("НомерЭтапа", НомерЭтапа);
		КонтекстПрогресса.Вставить("ВсегоЭтапов", ВсегоЭтапов);
		КонтекстПрогресса.Вставить("ИмяЛиста", ИмяЛиста);
		КонтекстПрогресса.Вставить("ВремяНачалаМс", ВремяНачалаМс);
		КонтекстПрогресса.Вставить("ВсегоСтрок", ТаблицаРаздела.Количество());
		
		ТабДокРаздела = СформироватьТабличныйДокументИзТаблицы(ТаблицаРаздела, ОписаниеТЧ.Синоним, КонтекстПрогресса);
		ДобавитьЛистВПакет(Пакет, ИмяЛиста, ТабДокРаздела);
		
		ИсточникДанных = ?(РезультатЧтенияТЧ.ИзРегистра, "регистр", "ТЧ");
		ОписанияЛистов.Добавить(СтрШаблон(
			"%1 (%2 строк, %3)",
			ИмяЛиста,
			Формат(ТаблицаРаздела.Количество(), "ЧГ=0"),
			ИсточникДанных));
		
	КонецЦикла;
	
	НомерЭтапа = НомерЭтапа + 1;
	СообщитьПрогрессВыгрузки(НомерЭтапа, ВсегоЭтапов, "Запись файла XLSX", ВремяНачалаМс);
	
	Попытка
		ДвоичныеДанныеФайла = ЗаписатьПакетВДвоичныеДанные(Пакет);
		Если ДвоичныеДанныеФайла = Неопределено Или ДвоичныеДанныеФайла.Размер() = 0 Тогда
			Результат.Описание = "Ошибка записи XLSX: получен пустой файл.";
			Возврат Результат;
		КонецЕсли;
		
		Результат.ДвоичныеДанные = ДвоичныеДанныеФайла;
		Результат.Успех = Истина;
		Результат.ИмяФайла = ИмяФайлаПоУмолчанию(ДокументОбъект);
		Результат.Описание = СтрШаблон(
			"внВыгрузка0420431ВXLSX v%1%2Выгружено листов: %3.%2%4",
			ВерсияОбработки(),
			Символы.ПС,
			Формат(ОписанияЛистов.Количество(), "ЧГ=0"),
			СтрСоединить(ОписанияЛистов, Символы.ПС));
		ДлительныеОперации.СообщитьПрогресс(100, "Готово");
	Исключение
		Результат.Описание = "Ошибка записи XLSX: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Описание: Формирует двоичные данные XLSX из файла стандартной выгрузки ОКУД0420431 (XML/XTDD).
// Структура листов совпадает с выгрузкой из документа: Шапка + все ТЧ метаданных документа.
//
// Параметры:
// ПутьКФайлуXML - Строка - полный путь к файлу .xml / .xtdd на сервере
//
// Возвращаемое значение:
// Структура - поля: Успех, ДвоичныеДанные, Описание, ИмяФайла
//
Функция СформироватьФайлXLSXИзXML(ПутьКФайлуXML) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ДвоичныеДанные", Неопределено);
	Результат.Вставить("Описание", "");
	Результат.Вставить("ИмяФайла", "");
	
	Попытка
		УстановитьБезопасныйРежим(Ложь);
	Исключение
		// если режим жестко запрещен платформой - продолжаем как есть
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ПутьКФайлуXML) Тогда
		Результат.Описание = "Не указан файл XML/XTDD.";
		Возврат Результат;
	КонецЕсли;
	
	ФайлXML = Новый Файл(ПутьКФайлуXML);
	Если Не ФайлXML.Существует() Тогда
		Результат.Описание = "Файл XML/XTDD не найден: " + ПутьКФайлуXML;
		Возврат Результат;
	КонецЕсли;
	
	ВремяНачалаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МетаданныеДокумента = Метаданные.Документы.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У;
	КоличествоТЧ = МетаданныеДокумента.ТабличныеЧасти.Количество();
	ВсегоЭтапов = 2 + КоличествоТЧ + 1;
	НомерЭтапа = 0;
	
	НомерЭтапа = НомерЭтапа + 1;
	СообщитьПрогрессВыгрузки(НомерЭтапа, ВсегоЭтапов, "Чтение файла XML/XTDD", ВремяНачалаМс);
	
	Попытка
		ДанныеXML = ПрочитатьДанныеОтчетаИзXML(ПутьКФайлуXML);
	Исключение
		Результат.Описание = "Ошибка чтения XML/XTDD: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Если ДанныеXML.Разделы.Количество() = 0 И ДанныеXML.Шапка.Количество() = 0 Тогда
		Результат.Описание = "В файле XML/XTDD не найдены данные отчета ОКУД0420431.";
		Возврат Результат;
	КонецЕсли;
	
	Пакет = Новый ПакетОтображаемыхДокументов;
	ОписанияЛистов = Новый Массив;
	
	НомерЭтапа = НомерЭтапа + 1;
	СообщитьПрогрессВыгрузки(НомерЭтапа, ВсегоЭтапов, "Формирование листа ""Шапка""", ВремяНачалаМс);
	ТабДокШапка = СформироватьТабличныйДокументШапкиИзXML(ДанныеXML, ФайлXML.Имя);
	ДобавитьЛистВПакет(Пакет, "Шапка", ТабДокШапка);
	ОписанияЛистов.Добавить("Шапка");
	
	ИндексРаздела = 0;
	Для Каждого ОписаниеТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		
		ИндексРаздела = ИндексРаздела + 1;
		НомерЭтапа = НомерЭтапа + 1;
		
		ИмяЛиста = ИмяЛистаExcel(ОписаниеТЧ.Имя);
		СообщитьПрогрессВыгрузки(
			НомерЭтапа,
			ВсегоЭтапов,
			СтрШаблон("Лист %1 (%2 из %3)", ИмяЛиста, ИндексРаздела, КоличествоТЧ),
			ВремяНачалаМс);
		
		ТаблицаСырая = ДанныеXML.Разделы.Получить(ОписаниеТЧ.Имя);
		Если ТаблицаСырая = Неопределено Тогда
			ТаблицаСырая = Новый ТаблицаЗначений;
		КонецЕсли;
		
		ТаблицаРаздела = ПривестиТаблицуКРеквизитамТЧ(ТаблицаСырая, ОписаниеТЧ);
		УдалитьСлужебныеКолонки(ТаблицаРаздела);
		
		КонтекстПрогресса = Новый Структура;
		КонтекстПрогресса.Вставить("НомерЭтапа", НомерЭтапа);
		КонтекстПрогресса.Вставить("ВсегоЭтапов", ВсегоЭтапов);
		КонтекстПрогресса.Вставить("ИмяЛиста", ИмяЛиста);
		КонтекстПрогресса.Вставить("ВремяНачалаМс", ВремяНачалаМс);
		КонтекстПрогресса.Вставить("ВсегоСтрок", ТаблицаРаздела.Количество());
		
		ТабДокРаздела = СформироватьТабличныйДокументИзТаблицы(ТаблицаРаздела, ОписаниеТЧ.Синоним, КонтекстПрогресса);
		ДобавитьЛистВПакет(Пакет, ИмяЛиста, ТабДокРаздела);
		
		ОписанияЛистов.Добавить(СтрШаблон(
			"%1 (%2 строк, XML)",
			ИмяЛиста,
			Формат(ТаблицаРаздела.Количество(), "ЧГ=0")));
		
	КонецЦикла;
	
	НомерЭтапа = НомерЭтапа + 1;
	СообщитьПрогрессВыгрузки(НомерЭтапа, ВсегоЭтапов, "Запись файла XLSX", ВремяНачалаМс);
	
	Попытка
		ДвоичныеДанныеФайла = ЗаписатьПакетВДвоичныеДанные(Пакет);
		Если ДвоичныеДанныеФайла = Неопределено Или ДвоичныеДанныеФайла.Размер() = 0 Тогда
			Результат.Описание = "Ошибка записи XLSX: получен пустой файл.";
			Возврат Результат;
		КонецЕсли;
		
		Результат.ДвоичныеДанные = ДвоичныеДанныеФайла;
		Результат.Успех = Истина;
		Результат.ИмяФайла = ИмяФайлаПоУмолчаниюИзXML(ДанныеXML);
		Результат.Описание = СтрШаблон(
			"внВыгрузка0420431ВXLSX v%1%2Источник: XML/XTDD (%3).%2Выгружено листов: %4.%2%5",
			ВерсияОбработки(),
			Символы.ПС,
			ФайлXML.Имя,
			Формат(ОписанияЛистов.Количество(), "ЧГ=0"),
			СтрСоединить(ОписанияЛистов, Символы.ПС));
		ДлительныеОперации.СообщитьПрогресс(100, "Готово");
	Исключение
		Результат.Описание = "Ошибка записи XLSX: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Имя регистра сведений для хранения больших ТЧ регл. отчетов (ASP-208357)
//
Функция ИмяРегистраДанныеРегламентныхОтчетов()
	
	Возврат "ДанныеРегламентныхОтчетов";
	
КонецФункции

// Описание: Проверяет наличие регистра ДанныеРегламентныхОтчетов в метаданных конфигурации.
// При любой ошибке проверки возвращает Ложь (считаем, что данных в регистре нет).
//
Функция РегистрДанныеРегламентныхОтчетовДоступен()
	
	Попытка
		Возврат Метаданные.РегистрыСведений.Найти(ИмяРегистраДанныеРегламентныхОтчетов()) <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Описание: Восстанавливает ТЧ документа из регистра ДанныеРегламентныхОтчетов (ЗагрузитьДанныеТабЧастей).
// Если регистра нет или загрузка не удалась - молча продолжаем (выгрузка из ТЧ документа).
//
// Параметры:
// ДокументОбъект - ДокументОбъект - объект регл. отчета
 // РегистрДоступен - Булево - кэш проверки метаданных (чтобы не вызывать Найти повторно)
 //
Процедура ВосстановитьТабличныеЧастиИзРегистраЕслиДоступно(ДокументОбъект, РегистрДоступен = Неопределено)
	
	Попытка
		
		Если РегистрДоступен = Неопределено Тогда
			РегистрДоступен = РегистрДанныеРегламентныхОтчетовДоступен();
		КонецЕсли;
		
		Если Не РегистрДоступен Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
			Возврат;
		КонецЕсли;
		
		МенеджерРегистра = РегистрыСведений[ИмяРегистраДанныеРегламентныхОтчетов()];
		ОтказЗагрузки = Ложь;
		МенеджерРегистра.ЗагрузитьДанныеТабЧастей(ДокументОбъект, ОтказЗагрузки);
		
	Исключение
		// регистр отсутствует / недоступен / ошибка API - данные берем из ТЧ документа
	КонецПопытки;
	
КонецПроцедуры

// Описание: Легкий запрос - только имена ТЧ в регистре (без чтения ХранилищеЗначения)
//
Функция ПолучитьИменаТабЧастейВРегистре(ДокументСсылка)
	
	Результат = Новый Соответствие;
	
	Попытка
		
		Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
			Возврат Результат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеРегламентныхОтчетов.ИмяТабЧасти КАК ИмяТабЧасти
		|ИЗ
		|	РегистрСведений.ДанныеРегламентныхОтчетов КАК ДанныеРегламентныхОтчетов
		|ГДЕ
		|	ДанныеРегламентныхОтчетов.РеглОтчет = &РеглОтчет";
		Запрос.УстановитьПараметр("РеглОтчет", ДокументСсылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.ИмяТабЧасти, Истина);
		КонецЦикла;
		
	Исключение
		Возврат Новый Соответствие;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Описание: Возвращает таблицу раздела для Excel.
 // После однократного восстановления из регистра берем ТЧ объекта (Выгрузить).
 // Повторно регистр читаем только если ТЧ пустая, а имя есть в регистре (сбой восстановления).
 //
Функция ПолучитьТаблицуРазделаДляВыгрузки(ДокументОбъект, ИмяТабличнойЧасти, РегистрДоступен = Ложь, ИменаТЧВРегистре = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Таблица", Новый ТаблицаЗначений);
	Результат.Вставить("ИзРегистра", Ложь);
	
	ТЧВРегистре = Ложь;
	Если ИменаТЧВРегистре <> Неопределено Тогда
		ТЧВРегистре = ИменаТЧВРегистре.Получить(ИмяТабличнойЧасти) = Истина;
	КонецЕсли;
	
	ТаблицаИзОбъекта = ДокументОбъект[ИмяТабличнойЧасти].Выгрузить();
	
	Если ТаблицаИзОбъекта.Количество() > 0 Тогда
		Результат.Таблица = ТаблицаИзОбъекта;
		Результат.ИзРегистра = ТЧВРегистре;
		Возврат Результат;
	КонецЕсли;
	
	// ТЧ пустая: при необходимости один раз дочитать из регистра (fallback)
	Если РегистрДоступен И ТЧВРегистре Тогда
		Попытка
			ТаблицаИзРегистра = ПрочитатьТабличнуюЧастьИзРегистра(ДокументОбъект.Ссылка, ИмяТабличнойЧасти, Ложь);
			Если ТипЗнч(ТаблицаИзРегистра) = Тип("ТаблицаЗначений") Тогда
				Результат.Таблица = ТаблицаИзРегистра;
				Результат.ИзРегистра = Истина;
				Возврат Результат;
			КонецЕсли;
		Исключение
			// оставляем пустую ТЧ
		КонецПопытки;
	КонецЕсли;
	
	Результат.Таблица = ТаблицаИзОбъекта;
	Результат.ИзРегистра = Ложь;
	Возврат Результат;
	
КонецФункции

// Описание: Читает ТЗ раздела из РегистрСведений.ДанныеРегламентныхОтчетов
 // Если регистра нет / записи нет / ошибка - возвращает Неопределено (без исключения наружу).
 //
Функция ПрочитатьТабличнуюЧастьИзРегистра(ДокументСсылка, ИмяТабличнойЧасти, ПроверятьМетаданные = Истина)
	
	Попытка
		
		Если ПроверятьМетаданные И Не РегистрДанныеРегламентныхОтчетовДоступен() Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДокументСсылка) Или Не ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеРегламентныхОтчетов.ДанныеТабЧасти КАК ДанныеТабЧасти
		|ИЗ
		|	РегистрСведений.ДанныеРегламентныхОтчетов КАК ДанныеРегламентныхОтчетов
		|ГДЕ
		|	ДанныеРегламентныхОтчетов.РеглОтчет = &РеглОтчет
		|	И ДанныеРегламентныхОтчетов.ИмяТабЧасти = &ИмяТабЧасти";
		Запрос.УстановитьПараметр("РеглОтчет", ДокументСсылка);
		Запрос.УстановитьПараметр("ИмяТабЧасти", ИмяТабличнойЧасти);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ТаблицаДанных = Выборка.ДанныеТабЧасти.Получить();
		Если ТипЗнч(ТаблицаДанных) = Тип("ТаблицаЗначений") Тогда
			Возврат ТаблицаДанных;
		КонецЕсли;
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

// Описание: Пишет пакет отображаемых документов в двоичные данные XLSX
// Сначала во временный файл (как в рабочих обработках ДУ) - запись в ПотокВПамяти здесь дает пустой файл.
// Затем читает файл: Новый ДвоичныеДанные или через ЧтениеДанных (обход запрета в безопасном режиме)
//
Функция ЗаписатьПакетВДвоичныеДанные(Пакет)
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	Попытка
		Пакет.Записать(ИмяФайла, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
		
		ФайлНаДиске = Новый Файл(ИмяФайла);
		Если Не ФайлНаДиске.Существует() Или ФайлНаДиске.Размер() = 0 Тогда
			ВызватьИсключение "ПакетОтображаемыхДокументов.Записать вернул пустой файл.";
		КонецЕсли;
		
		ДвоичныеДанные = Неопределено;
		Попытка
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
		Исключение
			ДвоичныеДанные = ПрочитатьФайлВДвоичныеДанныеЧерезПоток(ИмяФайла);
		КонецПопытки;
		
		УдалитьФайлы(ИмяФайла);
		Возврат ДвоичныеДанные;
		
	Исключение
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
			// файл уже недоступен
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

// Описание: Читает файл в ДвоичныеДанные без конструктора Новый ДвоичныеДанные(Путь)
//
Функция ПрочитатьФайлВДвоичныеДанныеЧерезПоток(ИмяФайла)
	
	ЧтениеДанных = Новый ЧтениеДанных(ИмяФайла);
	Попытка
		Буфер = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных();
		ЧтениеДанных.Закрыть();
		Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
	Исключение
		ЧтениеДанных.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

Процедура СообщитьПрогрессВыгрузки(НомерЭтапа, ВсегоЭтапов, ТекстЭтапа, ВремяНачалаМс)
	
	Если ВсегоЭтапов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Процент = Цел(100 * НомерЭтапа / ВсегоЭтапов);
	Если Процент > 99 Тогда
		Процент = 99;
	КонецЕсли;
	
	Текст = ТекстЭтапа;
	ПрошлоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс;
	
	Если НомерЭтапа > 0 И ПрошлоМс > 0 И НомерЭтапа < ВсегоЭтапов Тогда
		ОсталосьМс = Цел(ПрошлоМс * (ВсегоЭтапов - НомерЭтапа) / НомерЭтапа);
		Текст = СтрШаблон("%1. Осталось примерно %2", ТекстЭтапа, ПредставлениеИнтервалаМс(ОсталосьМс));
	КонецЕсли;
	
	ДлительныеОперации.СообщитьПрогресс(Процент, Текст);
	
КонецПроцедуры

Функция ПредставлениеИнтервалаМс(ИнтервалМс)
	
	ВсегоСекунд = Цел(ИнтервалМс / 1000);
	Если ВсегоСекунд < 1 Тогда
		Возврат "менее секунды";
	КонецЕсли;
	
	Минуты = Цел(ВсегоСекунд / 60);
	Секунды = ВсегоСекунд - Минуты * 60;
	
	Если Минуты = 0 Тогда
		Возврат СтрШаблон("%1 сек", Формат(Секунды, "ЧГ=0"));
	КонецЕсли;
	
	Возврат СтрШаблон("%1 мин %2 сек", Формат(Минуты, "ЧГ=0"), Формат(Секунды, "ЧГ=0"));
	
КонецФункции

Процедура ДобавитьЛистВПакет(Пакет, ИмяЛиста, ТабличныйДокумент)
	
	ЭлементПакета = Пакет.Состав.Добавить();
	ЭлементПакета.Наименование = ИмяЛиста;
	ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(ТабличныйДокумент);
	
КонецПроцедуры

Функция СформироватьТабличныйДокументШапки(ДокументОбъект, МетаданныеДокумента)
	
	ТабДок = Новый ТабличныйДокумент;
	
	// строки 1-4 под логотип ВИМ Инвестиции
	ТабДок.Область(1, 1).Текст = "АО ВИМ Инвестиции";
	ОформитьСтрокуЗаголовка(ТабДок, 1, 1);
	ТабДок.Область(2, 1).Текст = "внВыгрузка0420431ВXLSX v" + ВерсияОбработки();
	ВывестиЛоготипВИМ(ТабДок);
	
	НомерСтроки = 6;
	ТабДок.Область(НомерСтроки, 1).Текст = "Реквизит";
	ТабДок.Область(НомерСтроки, 2).Текст = "Значение";
	ОформитьСтрокуЗаголовка(ТабДок, НомерСтроки, 2);
	НомерСтроки = НомерСтроки + 1;
	
	ДобавитьСтрокуШапки(ТабДок, НомерСтроки, "Ссылка", ДокументОбъект.Ссылка);
	НомерСтроки = НомерСтроки + 1;
	ДобавитьСтрокуШапки(ТабДок, НомерСтроки, "Номер", ДокументОбъект.Номер);
	НомерСтроки = НомерСтроки + 1;
	ДобавитьСтрокуШапки(ТабДок, НомерСтроки, "Дата", ДокументОбъект.Дата);
	НомерСтроки = НомерСтроки + 1;
	
	Для Каждого ОписаниеРеквизита Из МетаданныеДокумента.Реквизиты Цикл
		ДобавитьСтрокуШапки(ТабДок, НомерСтроки, ОписаниеРеквизита.Имя, ДокументОбъект[ОписаниеРеквизита.Имя]);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ТабДок.ФиксацияСверху = 6;
	ПодобратьШиринуКолонокПоСодержимому(ТабДок, 2, 1, НомерСтроки - 1);
	Возврат ТабДок;
	
КонецФункции

Процедура ВывестиЛоготипВИМ(ТабличныйДокумент)
	
	Попытка
		ДвоичныеДанныеЛоготипа = ПолучитьМакет("ЛоготипВИМ");
		КартинкаЛоготипа = Новый Картинка(ДвоичныеДанныеЛоготипа);
	Исключение
		Возврат;
	КонецПопытки;
	
	Рисунок = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	Рисунок.Картинка = КартинкаЛоготипа;
	Рисунок.Расположить(ТабличныйДокумент.Область(1, 1, 4, 4));
	Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
	Рисунок.ГраницаСверху = Ложь;
	Рисунок.ГраницаСлева = Ложь;
	Рисунок.ГраницаСправа = Ложь;
	Рисунок.ГраницаСнизу = Ложь;
	
КонецПроцедуры

Процедура ДобавитьСтрокуШапки(ТабДок, НомерСтроки, ИмяРеквизита, ЗначениеРеквизита)
	
	ТабДок.Область(НомерСтроки, 1).Текст = ИмяРеквизита;
	ЗаписатьЗначениеВЯчейку(ТабДок.Область(НомерСтроки, 2), ЗначениеРеквизита);
	
КонецПроцедуры

Функция СформироватьТабличныйДокументИзТаблицы(Таблица, ЗаголовокЛиста, КонтекстПрогресса = Неопределено)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Если Таблица.Колонки.Количество() = 0 Тогда
		ТабДок.Область(1, 1).Текст = ЗаголовокЛиста;
		Возврат ТабДок;
	КонецЕсли;
	
	КоличествоКолонок = Таблица.Колонки.Количество();
	ВсегоСтрок = Таблица.Количество();
	
	// Кэш типов/форматов - иначе Новый ОписаниеТипов на каждую ячейку (критично для Раздел4)
	ТипЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(32, 10));
	ТипДаты = Новый ОписаниеТипов("Дата");
	ТипБулево = Новый ОписаниеТипов("Булево");
	ФорматЦелого = "ЧГ=0; ЧДЦ=0";
	ФорматДробного = "ЧГ=0; ЧРД=.";
	
	ТипыКолонок = Новый Массив;
	КолонкаЧисловаяФлаги = Новый Массив;
	МаксДлины = Новый Массив;
	
	НомерКолонки = 1;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ТипыКолонок.Добавить(Колонка.ТипЗначения);
		КолонкаЧисловаяФлаги.Добавить(Колонка.ТипЗначения.СодержитТип(Тип("Число")));
		МаксДлины.Добавить(0);
		ТабДок.Область(1, НомерКолонки).Текст = Колонка.Имя;
		УчестьДлинуДляШириныКолонки(МаксДлины, НомерКолонки, Колонка.Имя);
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;
	ОформитьСтрокуЗаголовка(ТабДок, 1, КоличествоКолонок);
	
	ЛимитСтрокДляШирины = 3000;
	НомерСтроки = 2;
	ОбработаноСтрок = 0;
	ШагПрогрессаСтрок = 5000;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		СчитатьШиринуПоСтроке = ОбработаноСтрок < ЛимитСтрокДляШирины;
		
		Для ИндексКолонки = 0 По КоличествоКолонок - 1 Цикл
			ЗначениеЯчейки = СтрокаТаблицы[ИндексКолонки];
			ЗаписатьЗначениеВЯчейкуБыстро(
				ТабДок.Область(НомерСтроки, ИндексКолонки + 1),
				ЗначениеЯчейки,
				ТипыКолонок[ИндексКолонки],
				КолонкаЧисловаяФлаги[ИндексКолонки],
				ТипЧисла,
				ТипДаты,
				ТипБулево,
				ФорматЦелого,
				ФорматДробного);
			
			Если СчитатьШиринуПоСтроке Тогда
				УчестьДлинуДляШириныКолонки(
					МаксДлины,
					ИндексКолонки + 1,
					ПредставлениеДляШириныКолонки(ЗначениеЯчейки));
			КонецЕсли;
		КонецЦикла;
		
		НомерСтроки = НомерСтроки + 1;
		ОбработаноСтрок = ОбработаноСтрок + 1;
		
		Если КонтекстПрогресса <> Неопределено
			И ВсегоСтрок > ШагПрогрессаСтрок
			И ОбработаноСтрок % ШагПрогрессаСтрок = 0 Тогда
			
			ТекстСтрок = СтрШаблон(
				"Лист %1: строк %2 из %3",
				КонтекстПрогресса.ИмяЛиста,
				Формат(ОбработаноСтрок, "ЧГ=0"),
				Формат(ВсегоСтрок, "ЧГ=0"));
			СообщитьПрогрессВыгрузки(
				КонтекстПрогресса.НомерЭтапа,
				КонтекстПрогресса.ВсегоЭтапов,
				ТекстСтрок,
				КонтекстПрогресса.ВремяНачалаМс);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТабДок.ФиксацияСверху = 1;
	ПрименитьШиринуКолонок(ТабДок, МаксДлины);
	Возврат ТабДок;
	
КонецФункции

Процедура ОформитьСтрокуЗаголовка(ТабДок, НомерСтроки, КоличествоКолонок)
	
	Для НомерКолонки = 1 По КоличествоКолонок Цикл
		Область = ТабДок.Область(НомерСтроки, НомерКолонки);
		Область.Шрифт = Новый Шрифт(Область.Шрифт, , , Истина);
	КонецЦикла;
	
КонецПроцедуры

// Описание: Запись ячейки с переиспользованием кэшированных ОписаниеТипов/форматов (горячий путь больших ТЧ)
//
Процедура ЗаписатьЗначениеВЯчейкуБыстро(Область, Значение, ОписаниеТиповКолонки, КолонкаЧисловая,
	ТипЧисла, ТипДаты, ТипБулево, ФорматЦелого, ФорматДробного)
	
	ЧисловоеЗначение = 0;
	Если ПодобратьЧислоДляExcel(Значение, ОписаниеТиповКолонки, ЧисловоеЗначение, КолонкаЧисловая) Тогда
		Область.СодержитЗначение = Истина;
		Область.ТипЗначения = ТипЧисла;
		Область.Значение = ЧисловоеЗначение;
		Если ЧисловоеЗначение = Цел(ЧисловоеЗначение) Тогда
			Область.Формат = ФорматЦелого;
		Иначе
			Область.Формат = ФорматДробного;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Область.Текст = "";
		Возврат;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Дата") Тогда
		
		Если Значение = Дата(1, 1, 1) Тогда
			Область.Текст = "";
			Возврат;
		КонецЕсли;
		
		Область.СодержитЗначение = Истина;
		Область.ТипЗначения = ТипДаты;
		Область.Значение = Значение;
		Если Значение = НачалоДня(Значение) Тогда
			Область.Формат = "ДФ=dd.MM.yyyy";
		Иначе
			Область.Формат = "ДФ=dd.MM.yyyy HH:mm:ss";
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		
		Область.СодержитЗначение = Истина;
		Область.ТипЗначения = ТипБулево;
		Область.Значение = Значение;
		Область.Формат = "БЛ=Нет; БИ=Да";
		
	Иначе
		
		Область.Текст = Строка(Значение);
		
	КонецЕсли;
	
КонецПроцедуры

// Описание: Записывает значение в ячейку (шапка). Для больших ТЧ используется ЗаписатьЗначениеВЯчейкуБыстро.
//
Процедура ЗаписатьЗначениеВЯчейку(Область, Значение, ОписаниеТиповКолонки = Неопределено)
	
	ТипЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(32, 10));
	КолонкаЧисловая = ОписаниеТиповКолонки <> Неопределено И ОписаниеТиповКолонки.СодержитТип(Тип("Число"));
	
	ЗаписатьЗначениеВЯчейкуБыстро(
		Область,
		Значение,
		ОписаниеТиповКолонки,
		КолонкаЧисловая,
		ТипЧисла,
		Новый ОписаниеТипов("Дата"),
		Новый ОписаниеТипов("Булево"),
		"ЧГ=0; ЧДЦ=0",
		"ЧГ=0; ЧРД=.");
	
КонецПроцедуры

// Описание: Определяет, нужно ли писать значение в Excel как число (включая 0 и пустые числовые колонки)
//
Функция ПодобратьЧислоДляExcel(Значение, ОписаниеТиповКолонки, ЧисловоеЗначение, КолонкаЧисловая = Неопределено)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		ЧисловоеЗначение = Значение;
		Возврат Истина;
	КонецЕсли;
	
	Если КолонкаЧисловая = Неопределено Тогда
		КолонкаЧисловая = ОписаниеТиповКолонки <> Неопределено
			И ОписаниеТиповКолонки.СодержитТип(Тип("Число"));
	КонецЕсли;
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Если КолонкаЧисловая И ОписаниеТиповКолонки <> Неопределено
			И ОписаниеТиповКолонки.Типы().Количество() = 1 Тогда
			ЧисловоеЗначение = 0;
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не КолонкаЧисловая Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Текст = СокрЛП(Значение);
	Если Текст = "" Тогда
		ЧисловоеЗначение = 0;
		Возврат Истина;
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, Символы.НПП, "");
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");
	
	Попытка
		ЧисловоеЗначение = Число(Текст);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ПредставлениеДляШириныКолонки(Значение)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Число") Тогда
		Если Значение = Цел(Значение) Тогда
			Возврат Формат(Значение, "ЧГ=0; ЧДЦ=0");
		Иначе
			Возврат Формат(Значение, "ЧГ=0; ЧРД=.");
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Если Значение = Дата(1, 1, 1) Тогда
			Возврат "";
		ИначеЕсли Значение = НачалоДня(Значение) Тогда
			Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
		Иначе
			Возврат Формат(Значение, "ДФ=dd.MM.yyyy HH:mm:ss");
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;
	
КонецФункции

Процедура УчестьДлинуДляШириныКолонки(МаксДлины, НомерКолонки, ТекстПредставления)
	
	Индекс = НомерКолонки - 1;
	Если Индекс < 0 Или Индекс >= МаксДлины.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ДлинаТекста = СтрДлина(ТекстПредставления);
	Если ДлинаТекста > МаксДлины[Индекс] Тогда
		МаксДлины[Индекс] = ДлинаТекста;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрименитьШиринуКолонок(ТабДок, МаксДлины)
	
	Для Индекс = 0 По МаксДлины.Количество() - 1 Цикл
		Ширина = МаксДлины[Индекс] + 2;
		Если Ширина < 8 Тогда
			Ширина = 8;
		ИначеЕсли Ширина > 60 Тогда
			Ширина = 60;
		КонецЕсли;
		ТабДок.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = Ширина;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодобратьШиринуКолонокПоСодержимому(ТабДок, КоличествоКолонок, НачальнаяСтрока, КонечнаяСтрока)
	
	Если КоличествоКолонок < 1 Или КонечнаяСтрока < НачальнаяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	МаксДлины = Новый Массив;
	Для Индекс = 0 По КоличествоКолонок - 1 Цикл
		МаксДлины.Добавить(0);
	КонецЦикла;
	
	Для НомерСтроки = НачальнаяСтрока По КонечнаяСтрока Цикл
		Для НомерКолонки = 1 По КоличествоКолонок Цикл
			УчестьДлинуДляШириныКолонки(МаксДлины, НомерКолонки, ТабДок.Область(НомерСтроки, НомерКолонки).Текст);
		КонецЦикла;
	КонецЦикла;
	
	ПрименитьШиринуКолонок(ТабДок, МаксДлины);
	
КонецПроцедуры

Функция ЗначениеВСтрокуВыгрузки(Значение)
	
	Возврат ПредставлениеДляШириныКолонки(Значение);
	
КонецФункции

Процедура УдалитьСлужебныеКолонки(Таблица)
	
	СлужебныеКолонки = Новый Массив;
	СлужебныеКолонки.Добавить("НомерСтроки");
	СлужебныеКолонки.Добавить("Ссылка");
	
	Для Каждого ИмяКолонки Из СлужебныеКолонки Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Таблица.Колонки.Удалить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ИмяЛистаExcel(ИмяРаздела)
	
	// Excel: не более 31 символа; запрещены \ / ? * [ ]
	ИмяЛиста = Строка(ИмяРаздела);
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "\", "_");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "/", "_");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "?", "_");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "*", "_");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "[", "_");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "]", "_");
	
	Если СтрДлина(ИмяЛиста) > 31 Тогда
		ИмяЛиста = Лев(ИмяЛиста, 31);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяЛиста) Тогда
		ИмяЛиста = "Лист";
	КонецЕсли;
	
	Возврат ИмяЛиста;
	
КонецФункции

Функция ИмяФайлаПоУмолчанию(ДокументОбъект)
	
	Период = "";
	Если ЗначениеЗаполнено(ДокументОбъект.НачалоПериода) Или ЗначениеЗаполнено(ДокументОбъект.КонецПериода) Тогда
		Период = СтрШаблон(
			"_%1_%2",
			Формат(ДокументОбъект.НачалоПериода, "ДФ=yyyyMMdd"),
			Формат(ДокументОбъект.КонецПериода, "ДФ=yyyyMMdd"));
	КонецЕсли;
	
	Возврат СтрШаблон("0420431_%1%2.xlsx", СокрЛП(ДокументОбъект.Номер), Период);
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

#Область ВыгрузкаИзXML

// Описание: Читает файл стандартной выгрузки ОКУД0420431 (XML/XTDD) в структуру Шапка + Разделы
//
Функция ПрочитатьДанныеОтчетаИзXML(ПутьКФайлуXML)
	
	Данные = Новый Структура;
	Данные.Вставить("Шапка", Новый Соответствие);
	Данные.Вставить("Разделы", Новый Соответствие);
	Данные.Вставить("ИмяКорня", "");
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлуXML);
	
	Попытка
		
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Данные.ИмяКорня = ЧтениеXML.ЛокальноеИмя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(Данные.ИмяКорня) Тогда
			ВызватьИсключение "В файле не найден корневой элемент XML.";
		КонецЕсли;
		
		ПрочитатьСодержимоеКорняОКУД(ЧтениеXML, Данные);
		ЧтениеXML.Закрыть();
		
	Исключение
		Попытка
			ЧтениеXML.Закрыть();
		Исключение
			// поток уже закрыт
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Данные;
	
КонецФункции

Процедура ПрочитатьСодержимоеКорняОКУД(ЧтениеXML, Данные)
	
	ИмяКорня = Данные.ИмяКорня;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеXML.ЛокальноеИмя = ИмяКорня Тогда
			Возврат;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧтениеXML.ЛокальноеИмя = "Отчетность" Тогда
			ПрочитатьЭлементОтчетность(ЧтениеXML, Данные);
		Иначе
			ПропуститьЭлементXML(ЧтениеXML);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьЭлементОтчетность(ЧтениеXML, Данные)
	
	ИмяРодителя = "Отчетность";
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеXML.ЛокальноеИмя = ИмяРодителя Тогда
			Возврат;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяЭлемента = ЧтениеXML.ЛокальноеИмя;
		
		Если ИмяЭлемента = "ДатаПредставления" Тогда
			
			Данные.Шапка.Вставить(ИмяЭлемента, ПрочитатьТекстЭлементаXML(ЧтениеXML));
			
		ИначеЕсли ИмяЭлемента = "СопроводительноеПисьмо" Тогда
			
			ПрочитатьПлоскиеПоляВСоответствие(ЧтениеXML, ИмяЭлемента, Данные.Шапка);
			
		ИначеЕсли ИмяЭлемента = "ОтчетРеестрЦенныхБумаг" Тогда
			
			ТаблицаРеестра = ПрочитатьТаблицуРеестраЦБИзXML(ЧтениеXML);
			Данные.Разделы.Вставить("РеестрЦенныхБумаг", ТаблицаРеестра);
			
		Иначе
			
			ТаблицаРаздела = ПрочитатьТаблицуРазделаИзXML(ЧтениеXML, ИмяЭлемента);
			Данные.Разделы.Вставить(ИмяЭлемента, ТаблицаРаздела);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПрочитатьТаблицуРазделаИзXML(ЧтениеXML, ИмяРаздела)
	
	Таблица = Новый ТаблицаЗначений;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеXML.ЛокальноеИмя = ИмяРаздела Тогда
			Прервать;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяСтроки = ЧтениеXML.ЛокальноеИмя;
		ЗначенияСтроки = ПрочитатьПлоскиеПоляСтрокиXML(ЧтениеXML, ИмяСтроки);
		ДобавитьСтрокуВТаблицуПоЗначениям(Таблица, ЗначенияСтроки);
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ПрочитатьТаблицуРеестраЦБИзXML(ЧтениеXML)
	
	Таблица = Новый ТаблицаЗначений;
	ИмяРодителя = "ОтчетРеестрЦенныхБумаг";
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеXML.ЛокальноеИмя = ИмяРодителя Тогда
			Прервать;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧтениеXML.ЛокальноеИмя = "ТаблицаРеестрЦенныхБумаг" Тогда
			Таблица = ПрочитатьТаблицуРазделаИзXML(ЧтениеXML, "ТаблицаРеестрЦенныхБумаг");
		Иначе
			ПропуститьЭлементXML(ЧтениеXML);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ПрочитатьПлоскиеПоляСтрокиXML(ЧтениеXML, ИмяСтроки)
	
	Значения = Новый Соответствие;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеXML.ЛокальноеИмя = ИмяСтроки Тогда
			Прервать;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = ЧтениеXML.ЛокальноеИмя;
		Значения.Вставить(ИмяПоля, ПрочитатьТекстЭлементаXML(ЧтениеXML));
		
	КонецЦикла;
	
	Возврат Значения;
	
КонецФункции

Процедура ПрочитатьПлоскиеПоляВСоответствие(ЧтениеXML, ИмяРодителя, Приемник)
	
	Значения = ПрочитатьПлоскиеПоляСтрокиXML(ЧтениеXML, ИмяРодителя);
	Для Каждого КлючИЗначение Из Значения Цикл
		Приемник.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция ПрочитатьТекстЭлементаXML(ЧтениеXML)
	
	ИмяЭлемента = ЧтениеXML.ЛокальноеИмя;
	Значение = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Значение = Значение + ЧтениеXML.Значение;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента
			И ЧтениеXML.ЛокальноеИмя = ИмяЭлемента Тогда
			Прервать;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ПропуститьЭлементXML(ЧтениеXML);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СокрЛП(Значение);
	
КонецФункции

Процедура ПропуститьЭлементXML(ЧтениеXML)
	
	ИмяЭлемента = ЧтениеXML.ЛокальноеИмя;
	Глубина = 1;
	
	Пока Глубина > 0 И ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Глубина = Глубина + 1;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокуВТаблицуПоЗначениям(Таблица, ЗначенияСтроки)
	
	Для Каждого КлючИЗначение Из ЗначенияСтроки Цикл
		Если Таблица.Колонки.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
			Таблица.Колонки.Добавить(КлючИЗначение.Ключ, Новый ОписаниеТипов("Строка"));
		КонецЕсли;
	КонецЦикла;
	
	НоваяСтрока = Таблица.Добавить();
	Для Каждого КлючИЗначение Из ЗначенияСтроки Цикл
		НоваяСтрока[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
	КонецЦикла;
	
КонецПроцедуры

Функция ПривестиТаблицуКРеквизитамТЧ(ТаблицаИсточник, ОписаниеТЧ)
	
	Таблица = Новый ТаблицаЗначений;
	Для Каждого ОписаниеРеквизита Из ОписаниеТЧ.Реквизиты Цикл
		Таблица.Колонки.Добавить(ОписаниеРеквизита.Имя, ОписаниеРеквизита.Тип);
	КонецЦикла;
	
	Если ТаблицаИсточник = Неопределено Или ТаблицаИсточник.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	ЕстьКолонкиИсточника = Новый Соответствие;
	Для Каждого Колонка Из ТаблицаИсточник.Колонки Цикл
		ЕстьКолонкиИсточника.Вставить(Колонка.Имя, Истина);
	КонецЦикла;
	
	Для Каждого СтрокаИсточника Из ТаблицаИсточник Цикл
		
		НоваяСтрока = Таблица.Добавить();
		Для Каждого Колонка Из Таблица.Колонки Цикл
			
			Если ЕстьКолонкиИсточника.Получить(Колонка.Имя) <> Истина Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока[Колонка.Имя] = ПривестиЗначениеXMLКТипуКолонки(
				СтрокаИсточника[Колонка.Имя],
				Колонка.ТипЗначения);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ПривестиЗначениеXMLКТипуКолонки(Значение, ОписаниеТиповКолонки)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат ОписаниеТиповКолонки.ПривестиЗначение(Неопределено);
	КонецЕсли;
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат ОписаниеТиповКолонки.ПривестиЗначение(Значение);
	КонецЕсли;
	
	Текст = СокрЛП(Значение);
	Если Текст = "" Тогда
		Возврат ОписаниеТиповКолонки.ПривестиЗначение(Неопределено);
	КонецЕсли;
	
	Если ОписаниеТиповКолонки.СодержитТип(Тип("Число")) Тогда
		
		ТекстЧисла = СтрЗаменить(Текст, Символы.НПП, "");
		ТекстЧисла = СтрЗаменить(ТекстЧисла, " ", "");
		ТекстЧисла = СтрЗаменить(ТекстЧисла, ",", ".");
		Попытка
			Возврат ОписаниеТиповКолонки.ПривестиЗначение(Число(ТекстЧисла));
		Исключение
			Возврат Текст;
		КонецПопытки;
	КонецЕсли;
	
	Если ОписаниеТиповКолонки.СодержитТип(Тип("Дата")) Тогда
		Попытка
			Возврат ОписаниеТиповКолонки.ПривестиЗначение(XMLЗначение(Тип("Дата"), Текст));
		Исключение
			Возврат Текст;
		КонецПопытки;
	КонецЕсли;
	
	Если ОписаниеТиповКолонки.СодержитТип(Тип("Булево")) Тогда
		ТекстНРег = НРег(Текст);
		Если ТекстНРег = "true" Или ТекстНРег = "истина" Или Текст = "1" Или ТекстНРег = "да" Тогда
			Возврат Истина;
		ИначеЕсли ТекстНРег = "false" Или ТекстНРег = "ложь" Или Текст = "0" Или ТекстНРег = "нет" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОписаниеТиповКолонки.ПривестиЗначение(Текст);
	
КонецФункции

Функция СформироватьТабличныйДокументШапкиИзXML(ДанныеXML, ИмяФайлаИсточника)
	
	ТабДок = Новый ТабличныйДокумент;
	
	ТабДок.Область(1, 1).Текст = "АО ВИМ Инвестиции";
	ОформитьСтрокуЗаголовка(ТабДок, 1, 1);
	ТабДок.Область(2, 1).Текст = "внВыгрузка0420431ВXLSX v" + ВерсияОбработки();
	ВывестиЛоготипВИМ(ТабДок);
	
	НомерСтроки = 6;
	ТабДок.Область(НомерСтроки, 1).Текст = "Реквизит";
	ТабДок.Область(НомерСтроки, 2).Текст = "Значение";
	ОформитьСтрокуЗаголовка(ТабДок, НомерСтроки, 2);
	НомерСтроки = НомерСтроки + 1;
	
	ДобавитьСтрокуШапки(ТабДок, НомерСтроки, "Источник", "Файл XML/XTDD");
	НомерСтроки = НомерСтроки + 1;
	ДобавитьСтрокуШапки(ТабДок, НомерСтроки, "Файл", ИмяФайлаИсточника);
	НомерСтроки = НомерСтроки + 1;
	ДобавитьСтрокуШапки(ТабДок, НомерСтроки, "КореньXML", ДанныеXML.ИмяКорня);
	НомерСтроки = НомерСтроки + 1;
	
	ПорядокКлючей = Новый Массив;
	ПорядокКлючей.Добавить("ДатаПредставления");
	ПорядокКлючей.Добавить("ПолноеНаименование");
	ПорядокКлючей.Добавить("КраткоеНаименование");
	ПорядокКлючей.Добавить("ИНН");
	ПорядокКлючей.Добавить("ОГРН");
	ПорядокКлючей.Добавить("ОКАТО");
	ПорядокКлючей.Добавить("ОтчетныйГод");
	ПорядокКлючей.Добавить("ДатаРегистрации");
	ПорядокКлючей.Добавить("НомерРегистрации");
	
	ВыведенныеКлючи = Новый Соответствие;
	Для Каждого ИмяКлюча Из ПорядокКлючей Цикл
		ЗначениеКлюча = ДанныеXML.Шапка.Получить(ИмяКлюча);
		Если ЗначениеКлюча = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьСтрокуШапки(ТабДок, НомерСтроки, ИмяКлюча, ЗначениеКлюча);
		НомерСтроки = НомерСтроки + 1;
		ВыведенныеКлючи.Вставить(ИмяКлюча, Истина);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ДанныеXML.Шапка Цикл
		Если ВыведенныеКлючи.Получить(КлючИЗначение.Ключ) = Истина Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьСтрокуШапки(ТабДок, НомерСтроки, КлючИЗначение.Ключ, КлючИЗначение.Значение);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ТабДок.ФиксацияСверху = 6;
	ПодобратьШиринуКолонокПоСодержимому(ТабДок, 2, 1, НомерСтроки - 1);
	Возврат ТабДок;
	
КонецФункции

Функция ИмяФайлаПоУмолчаниюИзXML(ДанныеXML)
	
	Суффикс = "";
	ДатаПредставления = ДанныеXML.Шапка.Получить("ДатаПредставления");
	Если ЗначениеЗаполнено(ДатаПредставления) Тогда
		ТекстДаты = СтрЗаменить(Строка(ДатаПредставления), "-", "");
		ТекстДаты = СтрЗаменить(ТекстДаты, ".", "");
		ТекстДаты = СтрЗаменить(ТекстДаты, " ", "");
		Если СтрДлина(ТекстДаты) >= 8 Тогда
			Суффикс = "_" + Лев(ТекстДаты, 8);
		КонецЕсли;
	КонецЕсли;
	
	Возврат "0420431_XML" + Суффикс + ".xlsx";
	
КонецФункции

