#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
		ДополнительнаяОбработкаСсылка = Параметры.ДополнительнаяОбработкаСсылка;
	КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Версия = ОбработкаОбъект.ВерсияОбработки();
	
	Элементы.НадписьЗаголовок.Заголовок =
		"Выгрузка регл. отчета 0420431 в Excel"
		+ Символы.ПС
		+ "АО ВИМ Инвестиции | версия " + Версия;
	
	СтатусВыгрузки = "Версия обработки: " + Версия
		+ Символы.ПС
		+ "Рекомендуется открывать из справочника ""Дополнительные отчеты и обработки"""
		+ " (БезопасныйРежим = Ложь)."
		+ Символы.ПС
		+ "Источник: документ 0420431 или файл стандартной выгрузки XML/XTDD."
		+ Символы.ПС
		+ "В файл попадут лист ""Шапка"" и все табличные части (каждый раздел - отдельный лист).";
	
	УстановитьДоступностьЭлементовИсточникаНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДокументПриИзменении(Элемент)
	
	СтатусВыгрузки = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьИзФайлаXMLПриИзменении(Элемент)
	
	СтатусВыгрузки = "";
	УстановитьДоступностьЭлементовИсточникаНаКлиенте();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайлXML(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл стандартной выгрузки 0420431 (XML/XTDD)";
	Диалог.Фильтр =
		"Выгрузка 0420431 (*.xtdd;*.xml)|*.xtdd;*.xml|Файлы XTDD (*.xtdd)|*.xtdd|Файлы XML (*.xml)|*.xml|Все файлы (*.*)|*.*";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлуXML = Диалог.ПолноеИмяФайла;
	ВыгружатьИзФайлаXML = Истина;
	АдресФайлаXML = "";
	УстановитьДоступностьЭлементовИсточникаНаКлиенте();
	СтатусВыгрузки = "Выбран файл XML/XTDD:" + Символы.ПС + ПутьКФайлуXML;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВXLSX(Команда)
	
	Если ВыгружатьИзФайлаXML Тогда
		
		Если Не ЗначениеЗаполнено(ПутьКФайлуXML) Тогда
			ПоказатьПредупреждение(, "Выберите файл XML/XTDD.");
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Документ) Тогда
		
		ПоказатьПредупреждение(, "Укажите документ 0420431 или включите выгрузку из файла XML.");
		Возврат;
		
	КонецЕсли;
	
	ИмяФайлаПоУмолчанию = ПолучитьИмяФайлаПоУмолчаниюНаСервере();
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить выгрузку 0420431";
	Диалог.Фильтр = "Книга Excel (*.xlsx)|*.xlsx";
	Диалог.ПолноеИмяФайла = ИмяФайлаПоУмолчанию;
	Диалог.Расширение = "xlsx";
	
	Если Не Диалог.Выбрать() Тогда
		СтатусВыгрузки = "Выгрузка отменена.";
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = Диалог.ПолноеИмяФайла;
	СтатусВыгрузки = "Запуск выгрузки...";
	
	АдресФайлаОбработки = "";
	ПутьКФайлуОбработки = ПолучитьИспользуемоеИмяФайлаНаСервере();
	
	Если ЗначениеЗаполнено(ПутьКФайлуОбработки) Тогда
		Попытка
			Если Не ПоместитьФайл(АдресФайлаОбработки, ПутьКФайлуОбработки, , Ложь, УникальныйИдентификатор) Тогда
				АдресФайлаОбработки = "";
			КонецЕсли;
		Исключение
			АдресФайлаОбработки = "";
		КонецПопытки;
	КонецЕсли;
	
	Если ВыгружатьИзФайлаXML Тогда
		
		АдресФайлаXML = "";
		Попытка
			Если Не ПоместитьФайл(АдресФайлаXML, ПутьКФайлуXML, , Ложь, УникальныйИдентификатор) Тогда
				ПоказатьПредупреждение(, "Не удалось передать файл XML на сервер.");
				Возврат;
			КонецЕсли;
		Исключение
			ПоказатьПредупреждение(, "Не удалось передать файл XML на сервер: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		
	КонецЕсли;
	
	ЗапуститьВыгрузкуПослеПодготовки(ПутьКФайлу, АдресФайлаОбработки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьДоступностьЭлементовИсточникаНаКлиенте()
	
	Элементы.Документ.Доступность = Не ВыгружатьИзФайлаXML;
	Элементы.ПутьКФайлуXML.ТолькоПросмотр = Истина;
	Элементы.ПутьКФайлуXML.Доступность = ВыгружатьИзФайлаXML;
	Элементы.ВыбратьФайлXML.Доступность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементовИсточникаНаСервере()
	
	Элементы.Документ.Доступность = Не ВыгружатьИзФайлаXML;
	Элементы.ПутьКФайлуXML.ТолькоПросмотр = Истина;
	Элементы.ПутьКФайлуXML.Доступность = ВыгружатьИзФайлаXML;
	Элементы.ВыбратьФайлXML.Доступность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьВыгрузкуПослеПодготовки(ПутьКФайлу, АдресФайлаОбработки)
	
	ДлительнаяОперация = НачатьВыгрузкуВФонеНаСервере(АдресФайлаОбработки);
	Если ДлительнаяОперация = Неопределено Тогда
		СтатусВыгрузки = "Фоновое задание недоступно - выполняется синхронная выгрузка...";
		ВыполнитьСинхроннуюВыгрузку(ПутьКФайлу);
		Возврат;
	КонецЕсли;
	
	ТекстОжидания = ?(
		ВыгружатьИзФайлаXML,
		"Выгрузка файла XML/XTDD 0420431 в XLSX...",
		"Выгрузка документа 0420431 в XLSX...");
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ТекстСообщения = ТекстОжидания;
	
	Оповещение = Новый ОписаниеОповещения(
		"ВыгрузкаВФонеЗавершение",
		ЭтотОбъект,
		Новый Структура("ПутьКФайлу", ПутьКФайлу));
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		СтатусВыгрузки = "Выгрузка отменена.";
		Возврат;
	КонецЕсли;
	
	ЗавершитьВыгрузкуПоРезультату(Результат, ДополнительныеПараметры.ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыгрузкуПоРезультату(РезультатОперации, ПутьКФайлу)
	
	Если РезультатОперации.Статус = "Ошибка" Тогда
		
		ТекстОшибки = РезультатОперации.КраткоеПредставлениеОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Ошибка фоновой выгрузки.";
		КонецЕсли;
		
		ТекстОшибкиНРег = НРег(ТекстОшибки);
		Если СтрНайти(ТекстОшибкиНРег, "каталог не обнаружен") > 0
			Или СтрНайти(ТекстОшибкиНРег, "файл не обнаружен") > 0
			Или СтрНайти(ТекстОшибкиНРег, ".epf") > 0 Тогда
			
			СтатусВыгрузки = "Фон недоступен (локальный путь к EPF), выполняется синхронная выгрузка.";
			ВыполнитьСинхроннуюВыгрузку(ПутьКФайлу);
			Возврат;
			
		КонецЕсли;
		
		СтатусВыгрузки = ТекстОшибки;
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
		
	КонецЕсли;
	
	Если РезультатОперации.Статус = "Отменено" Тогда
		СтатусВыгрузки = "Выгрузка отменена.";
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = ПолучитьРезультатВыгрузкиНаСервере(РезультатОперации.АдресРезультата);
	СохранитьРезультатВФайл(РезультатВыгрузки, ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСинхроннуюВыгрузку(ПутьКФайлу)
	
	СтатусВыгрузки = "Синхронная выгрузка...";
	РезультатВыгрузки = ВыполнитьСинхроннуюВыгрузкуНаСервере();
	СохранитьРезультатВФайл(РезультатВыгрузки, ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьРезультатВФайл(РезультатВыгрузки, ПутьКФайлу)
	
	Если Не РезультатВыгрузки.Успех Тогда
		СтатусВыгрузки = РезультатВыгрузки.Описание;
		ПоказатьПредупреждение(, РезультатВыгрузки.Описание);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РезультатВыгрузки.АдресДанных) Тогда
		ТекстОшибки = "Нет данных для сохранения файла.";
		СтатусВыгрузки = ТекстОшибки;
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Попытка
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(РезультатВыгрузки.АдресДанных);
		Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
			ТекстОшибки = "Пустые двоичные данные XLSX - файл не сохранен.";
			СтатусВыгрузки = ТекстОшибки;
			ПоказатьПредупреждение(, ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		ДвоичныеДанные.Записать(ПутьКФайлу);
		СтатусВыгрузки = РезультатВыгрузки.Описание
			+ Символы.ПС
			+ "Файл: "
			+ ПутьКФайлу
			+ Символы.ПС
			+ "Размер: "
			+ Формат(ДвоичныеДанные.Размер(), "ЧГ=0")
			+ " байт";
		ПоказатьПредупреждение(, "Файл сохранен:" + Символы.ПС + ПутьКФайлу);
	Исключение
		ТекстОшибки = "Не удалось сохранить файл: " + ОписаниеОшибки();
		СтатусВыгрузки = ТекстОшибки;
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяФайлаПоУмолчаниюНаСервере()
	
	Если ВыгружатьИзФайлаXML Тогда
		Возврат "0420431_XML.xlsx";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Документ) Тогда
		Возврат "0420431.xlsx";
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Документ, "Номер, НачалоПериода, КонецПериода");
	Период = "";
	Если ЗначениеЗаполнено(Реквизиты.НачалоПериода) Или ЗначениеЗаполнено(Реквизиты.КонецПериода) Тогда
		Период = СтрШаблон(
			"_%1_%2",
			Формат(Реквизиты.НачалоПериода, "ДФ=yyyyMMdd"),
			Формат(Реквизиты.КонецПериода, "ДФ=yyyyMMdd"));
	КонецЕсли;
	
	Возврат СтрШаблон("0420431_%1%2.xlsx", СокрЛП(Реквизиты.Номер), Период);
	
КонецФункции

&НаСервере
Функция ПолучитьИспользуемоеИмяФайлаНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ИспользуемоеИмяФайла;
	
КонецФункции

&НаСервере
Функция ПодготовитьПутьXMLНаСервере()
	
	Если Не ЗначениеЗаполнено(АдресФайлаXML) Тогда
		Возврат "";
	КонецЕсли;
	
	ДвоичныеДанныеXML = ПолучитьИзВременногоХранилища(АдресФайлаXML);
	Если ДвоичныеДанныеXML = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Расширение = "xtdd";
	Если ЗначениеЗаполнено(ПутьКФайлуXML) Тогда
		ФайлИсточника = Новый Файл(ПутьКФайлуXML);
		Если ЗначениеЗаполнено(ФайлИсточника.Расширение) Тогда
			Расширение = СтрЗаменить(ФайлИсточника.Расширение, ".", "");
		КонецЕсли;
	КонецЕсли;
	
	ИмяФайлаНаСервере = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанныеXML.Записать(ИмяФайлаНаСервере);
	Возврат ИмяФайлаНаСервере;
	
КонецФункции

&НаСервере
Функция НачатьВыгрузкуВФонеНаСервере(АдресФайлаОбработки)
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("Документ", Объект.Документ);
	ПараметрыМетода.Вставить("ПутьEPF", "");
	ПараметрыМетода.Вставить("ИсточникДанных", ?(ВыгружатьИзФайлаXML, "ФайлXML", "Документ"));
	ПараметрыМетода.Вставить("ПутьXML", "");
	
	Если ВыгружатьИзФайлаXML Тогда
		ПутьXMLНаСервере = ПодготовитьПутьXMLНаСервере();
		Если Не ЗначениеЗаполнено(ПутьXMLНаСервере) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ПараметрыМетода.ПутьXML = ПутьXMLНаСервере;
	КонецЕсли;
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяМетода", "СформироватьФайлXLSXВФоне");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыМетода);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
	ПараметрыЗадания.Вставить("ИмяОбработки", "");
	ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", Неопределено);
	
	Если ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		
		ПараметрыЗадания.ДополнительнаяОбработкаСсылка = ДополнительнаяОбработкаСсылка;
		
	Иначе
		
		ИмяФайлаОбработки = "";
		
		Если ЗначениеЗаполнено(АдресФайлаОбработки) Тогда
			
			Попытка
				ДвоичныеДанныеEPF = ПолучитьИзВременногоХранилища(АдресФайлаОбработки);
				ИмяФайлаОбработки = ПолучитьИмяВременногоФайла("epf");
				ДвоичныеДанныеEPF.Записать(ИмяФайлаОбработки);
			Исключение
				Возврат Неопределено;
			КонецПопытки;
			
		Иначе
			
			ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
			КандидатПути = ОбработкаОбъект.ИспользуемоеИмяФайла;
			
			Если Не ЗначениеЗаполнено(КандидатПути) Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			ФайлНаСервере = Новый Файл(КандидатПути);
			Если Не ФайлНаСервере.Существует() Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Попытка
				ДвоичныеДанныеEPF = Новый ДвоичныеДанные(КандидатПути);
				ИмяФайлаОбработки = ПолучитьИмяВременногоФайла("epf");
				ДвоичныеДанныеEPF.Записать(ИмяФайлаОбработки);
			Исключение
				Возврат Неопределено;
			КонецПопытки;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ИмяФайлаОбработки) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПараметрыМетода.ПутьEPF = ИмяФайлаОбработки;
		ПараметрыЗадания.ИмяОбработки = ИмяФайлаОбработки;
		
	КонецЕсли;
	
	ТекстЗадания = ?(
		ВыгружатьИзФайлаXML,
		"Выгрузка файла XML/XTDD 0420431 в XLSX",
		"Выгрузка документа 0420431 в XLSX");
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = ТекстЗадания;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Попытка
		Возврат ДлительныеОперации.ВыполнитьВФоне(
			"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			ПараметрыЗадания,
			ПараметрыВыполнения);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПолучитьРезультатВыгрузкиНаСервере(АдресРезультата)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Описание", "Пустой результат выгрузки.");
	Результат.Вставить("АдресДанных", "");
	
	ДанныеРезультата = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(ДанныеРезультата) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = ДанныеРезультата.Успех;
	Результат.Описание = ДанныеРезультата.Описание;
	
	Если ДанныеРезультата.Успех И ДанныеРезультата.ДвоичныеДанные <> Неопределено Тогда
		Результат.АдресДанных = ПоместитьВоВременноеХранилище(ДанныеРезультата.ДвоичныеДанные, УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВыполнитьСинхроннуюВыгрузкуНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если ВыгружатьИзФайлаXML Тогда
		
		ПутьXMLНаСервере = ПодготовитьПутьXMLНаСервере();
		Если Не ЗначениеЗаполнено(ПутьXMLНаСервере) Тогда
			РезультатОшибки = Новый Структура;
			РезультатОшибки.Вставить("Успех", Ложь);
			РезультатОшибки.Вставить("Описание", "Не удалось подготовить файл XML на сервере.");
			РезультатОшибки.Вставить("АдресДанных", "");
			Возврат РезультатОшибки;
		КонецЕсли;
		
		РезультатВыгрузки = ОбработкаОбъект.СформироватьФайлXLSXИзXML(ПутьXMLНаСервере);
		
		Попытка
			УдалитьФайлы(ПутьXMLНаСервере);
		Исключение
			// временный файл уже недоступен
		КонецПопытки;
		
	Иначе
		РезультатВыгрузки = ОбработкаОбъект.СформироватьФайлXLSX(Объект.Документ);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Описание", РезультатВыгрузки.Описание);
	Результат.Вставить("АдресДанных", "");
	
	Если РезультатВыгрузки.Успех
		И РезультатВыгрузки.ДвоичныеДанные <> Неопределено
		И РезультатВыгрузки.ДвоичныеДанные.Размер() > 0 Тогда
		
		Результат.Успех = Истина;
		Результат.АдресДанных = ПоместитьВоВременноеХранилище(РезультатВыгрузки.ДвоичныеДанные, УникальныйИдентификатор);
		
	ИначеЕсли РезультатВыгрузки.Успех Тогда
		Результат.Описание = "Ошибка: сформирован пустой XLSX.";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
