#Область ПрограммныйИнтерфейс

// Описание: Сравнивает два документа 0420431 по шапке и всем табличным частям
// Строки ТЧ сопоставляются по ключу раздела, расхождения выводятся по полям
//
// Параметры:
// Документ1 - ДокументСсылка.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У - первый документ
// Документ2 - ДокументСсылка.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У - второй документ
// ТолькоРасхождения - Булево - не добавлять строки "Совпадает" по разделам
//
// Возвращаемое значение:
// Структура - поля: Идентичны (Булево), Итог (Строка), Расхождения (ТаблицаЗначений)
//
Функция СравнитьДокументы(Документ1, Документ2, ТолькоРасхождения = Истина) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Идентичны", Истина);
	Результат.Вставить("Итог", "");
	Результат.Вставить("Расхождения", СоздатьТаблицуРасхождений());
	
	Если Не ЗначениеЗаполнено(Документ1) Или Не ЗначениеЗаполнено(Документ2) Тогда
		Результат.Идентичны = Ложь;
		Результат.Итог = "Не указаны оба документа для сравнения.";
		Возврат Результат;
	КонецЕсли;
	
	Если Документ1 = Документ2 Тогда
		Результат.Идентичны = Ложь;
		Результат.Итог = "Выбран один и тот же документ.";
		ДобавитьСтрокуРасхождения(Результат.Расхождения, "Проверка", "Документы", Строка(Документ1), Строка(Документ2), "Один документ");
		Возврат Результат;
	КонецЕсли;
	
	Объект1 = Документ1.ПолучитьОбъект();
	Объект2 = Документ2.ПолучитьОбъект();
	МетаданныеДокумента = Метаданные.Документы.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У;
	
	КоличествоРасхождений = 0;
	
	КоличествоРасхождений = КоличествоРасхождений + СравнитьШапку(Объект1, Объект2, МетаданныеДокумента, Результат.Расхождения);
	
	Для Каждого ОписаниеТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		
		Таблица1 = Объект1[ОписаниеТЧ.Имя].Выгрузить();
		Таблица2 = Объект2[ОписаниеТЧ.Имя].Выгрузить();
		УдалитьСлужебныеКолонки(Таблица1);
		УдалитьСлужебныеКолонки(Таблица2);
		
		КоличествоРасхожденийРаздела = СравнитьТабличнуюЧасть(
			Таблица1,
			Таблица2,
			ОписаниеТЧ,
			Результат.Расхождения);
		КоличествоРасхождений = КоличествоРасхождений + КоличествоРасхожденийРаздела;
		
		Если КоличествоРасхожденийРаздела = 0 И Не ТолькоРасхождения Тогда
			ДобавитьСтрокуРасхождения(
				Результат.Расхождения,
				ОписаниеТЧ.Имя,
				"Раздел",
				Формат(Таблица1.Количество(), "ЧГ=0") + " строк",
				Формат(Таблица2.Количество(), "ЧГ=0") + " строк",
				"Совпадает");
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Идентичны = (КоличествоРасхождений = 0);
	
	Если Результат.Идентичны Тогда
		Результат.Итог = СтрШаблон(
			"Документы идентичны (кроме Номер/Дата/Ссылка): %1 и %2",
			Документ1,
			Документ2);
	Иначе
		Результат.Итог = СтрШаблон(
			"Обнаружено расхождений: %1. %2 <> %3",
			КоличествоРасхождений,
			Документ1,
			Документ2);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьТаблицуРасхождений()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Область", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Таблица.Колонки.Добавить("Поле", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Таблица.Колонки.Добавить("ЗначениеДок1", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеДок2", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ТипРасхождения", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	
	Возврат Таблица;
	
КонецФункции

Функция ИсключаемыеРеквизитыШапки()
	
	Исключения = Новый Массив;
	Исключения.Добавить("Номер");
	Исключения.Добавить("Дата");
	Исключения.Добавить("Проведен");
	Исключения.Добавить("ПометкаУдаления");
	
	Возврат Исключения;
	
КонецФункции

