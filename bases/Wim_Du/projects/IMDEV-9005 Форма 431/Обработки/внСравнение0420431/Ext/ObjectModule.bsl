Функция ПоляКлюча(СтрокаПолей)
	
	Результат = Новый Массив;
	
	Для Каждого ИмяПоля Из СтрРазделить(СтрокаПолей, ",", Ложь) Цикл
		Результат.Добавить(СокрЛП(ИмяПоля));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Возвращает массив имен полей ключа для табличной части
//
Функция ПолучитьПоляКлюча(ОписаниеТЧ, Колонки)
	
	КлючиРазделов = КлючиСопоставленияПоРазделам();
	ПоляКлюча = КлючиРазделов.Получить(ОписаниеТЧ.Имя);
	
	Если ПоляКлюча <> Неопределено Тогда
		Возврат ПоляКлюча;
	КонецЕсли;
	
	// Резерв: все нечисловые реквизиты ТЧ - ключ, числовые - сравниваемые поля
	ПоляКлюча = Новый Массив;
	
	Для Каждого ОписаниеРеквизита Из ОписаниеТЧ.Реквизиты Цикл
		
		Если Колонки.Найти(ОписаниеРеквизита.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОписаниеРеквизита.Тип.СодержитТип(Тип("Число")) Тогда
			Продолжить;
		КонецЕсли;
		
		ПоляКлюча.Добавить(ОписаниеРеквизита.Имя);
		
	КонецЦикла;
	
	Возврат ПоляКлюча;
	
КонецФункции

Функция СравнитьШапку(Объект1, Объект2, МетаданныеДокумента, Расхождения)
	
	КоличествоРасхождений = 0;
	Исключения = ИсключаемыеРеквизитыШапки();
	
	Для Каждого ОписаниеРеквизита Из МетаданныеДокумента.Реквизиты Цикл
		
		Если Исключения.Найти(ОписаниеРеквизита.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Значение1 = Объект1[ОписаниеРеквизита.Имя];
		Значение2 = Объект2[ОписаниеРеквизита.Имя];
		
		Если ЗначенияРавны(Значение1, Значение2, ОписаниеРеквизита.Тип) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоРасхождений = КоличествоРасхождений + 1;
		ДобавитьСтрокуРасхождения(
			Расхождения,
			"Шапка",
			ОписаниеРеквизита.Имя,
			ПредставлениеЗначения(Значение1),
			ПредставлениеЗначения(Значение2),
			"Реквизит");
		
	КонецЦикла;
	
	Возврат КоличествоРасхождений;
	
КонецФункции

Функция СравнитьТабличнуюЧасть(Таблица1, Таблица2, ОписаниеТЧ, Расхождения)
	
	КоличествоРасхождений = 0;
	ИмяТЧ = ОписаниеТЧ.Имя;
	ПоляКлюча = ПолучитьПоляКлюча(ОписаниеТЧ, Таблица1.Колонки);
	
	Если Таблица1.Количество() <> Таблица2.Количество() Тогда
		КоличествоРасхождений = КоличествоРасхождений + 1;
		ДобавитьСтрокуРасхождения(
			Расхождения,
			ИмяТЧ,
			"Количество строк",
			Формат(Таблица1.Количество(), "ЧГ=0"),
			Формат(Таблица2.Количество(), "ЧГ=0"),
			"Количество");
	КонецЕсли;
	
	Индекс1 = ПостроитьИндексПоКлючу(Таблица1, ПоляКлюча);
	Индекс2 = ПостроитьИндексПоКлючу(Таблица2, ПоляКлюча);
	ВсеКлючи = ОбъединитьКлючиСоответствия(Индекс1, Индекс2);
	
	Для Каждого ЭлементКлюча Из ВсеКлючи Цикл
		
		КлючСопоставления = ЭлементКлюча.Ключ;
		Строки1 = Индекс1.Получить(КлючСопоставления);
		Строки2 = Индекс2.Получить(КлючСопоставления);
		
		Если Строки1 = Неопределено Тогда
			Строки1 = Новый Массив;
		КонецЕсли;
		
		Если Строки2 = Неопределено Тогда
			Строки2 = Новый Массив;
		КонецЕсли;
		
		КоличествоРасхождений = КоличествоРасхождений + СравнитьГруппуСтрок(
			Строки1,
			Строки2,
			Таблица1.Колонки,
			ОписаниеТЧ,
			ИмяТЧ,
			КлючСопоставления,
			Расхождения);
		
	КонецЦикла;
	
	Возврат КоличествоРасхождений;
	
КонецФункции

Функция СравнитьГруппуСтрок(Строки1, Строки2, Колонки, ОписаниеТЧ, ИмяТЧ, КлючСопоставления, Расхождения)
	
	КоличествоРасхождений = 0;
	ПредставлениеКлюча = СократитьСтроку(КлючСопоставления, 120);
	
	Если Строки1.Количество() = 0 И Строки2.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Строки1.Количество() = 0 Тогда
		КоличествоРасхождений = КоличествоРасхождений + 1;
		ДобавитьСтрокуРасхождения(
			Расхождения,
			ИмяТЧ,
			ПредставлениеКлюча,
			"<нет>",
			Формат(Строки2.Количество(), "ЧГ=0") + " строк",
			"Только в док.2");
		Возврат КоличествоРасхождений;
	КонецЕсли;
	
	Если Строки2.Количество() = 0 Тогда
		КоличествоРасхождений = КоличествоРасхождений + 1;
		ДобавитьСтрокуРасхождения(
			Расхождения,
			ИмяТЧ,
			ПредставлениеКлюча,
			Формат(Строки1.Количество(), "ЧГ=0") + " строк",
			"<нет>",
			"Только в док.1");
		Возврат КоличествоРасхождений;
	КонецЕсли;
	
	Если Строки1.Количество() <> Строки2.Количество() Тогда
		КоличествоРасхождений = КоличествоРасхождений + 1;
		ДобавитьСтрокуРасхождения(
			Расхождения,
			ИмяТЧ,
			ПредставлениеКлюча + " -> количество строк с ключом",
			Формат(Строки1.Количество(), "ЧГ=0"),
			Формат(Строки2.Количество(), "ЧГ=0"),
			"Количество вхождений");
	КонецЕсли;
	
	Если Строки1.Количество() = 1 И Строки2.Количество() = 1 Тогда
		Возврат КоличествоРасхождений + СравнитьДвеСтрокиТЧ(
			Строки1[0],
			Строки2[0],
			Колонки,
			ОписаниеТЧ,
			ИмяТЧ,
			ПредставлениеКлюча,
			Расхождения);
	КонецЕсли;
	
	Возврат КоличествоРасхождений + СравнитьГруппуСтрокМультимножество(
		Строки1,
		Строки2,
		Колонки,
		ИмяТЧ,
		ПредставлениеКлюча,
		Расхождения);
	
КонецФункции

Функция СравнитьДвеСтрокиТЧ(Строка1, Строка2, Колонки, ОписаниеТЧ, ИмяТЧ, ПредставлениеКлюча, Расхождения)
	
	КоличествоРасхождений = 0;
	
	Для Каждого Колонка Из Колонки Цикл
		
		ИмяПоля = Колонка.Имя;
		ОписаниеТипа = ОписаниеТипаКолонки(ОписаниеТЧ, ИмяПоля);
		Значение1 = Строка1[ИмяПоля];
		Значение2 = Строка2[ИмяПоля];
		
		Если ЗначенияРавны(Значение1, Значение2, ОписаниеТипа) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоРасхождений = КоличествоРасхождений + 1;
		ДобавитьСтрокуРасхождения(
			Расхождения,
			ИмяТЧ,
			ПредставлениеКлюча + " -> " + ИмяПоля,
			ПредставлениеЗначения(Значение1),
			ПредставлениеЗначения(Значение2),
			"Поле строки");
		
	КонецЦикла;
	
	Возврат КоличествоРасхождений;
	
КонецФункции

Функция СравнитьГруппуСтрокМультимножество(Строки1, Строки2, Колонки, ИмяТЧ, ПредставлениеКлюча, Расхождения)
	
	Таблица1 = Новый ТаблицаЗначений;
	Таблица2 = Новый ТаблицаЗначений;
	
	Для Каждого Колонка Из Колонки Цикл
		Таблица1.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		Таблица2.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Для Каждого ИндексСтроки Из Строки1 Цикл
		ЗаполнитьЗначенияСвойств(Таблица1.Добавить(), ИндексСтроки);
	КонецЦикла;
	
	Для Каждого ИндексСтроки Из Строки2 Цикл
		ЗаполнитьЗначенияСвойств(Таблица2.Добавить(), ИндексСтроки);
	КонецЦикла;
	
	КоличествоРасхождений = 0;
	Счетчик1 = ПостроитьСчетчикСтрок(Таблица1);
	Счетчик2 = ПостроитьСчетчикСтрок(Таблица2);
	ВсеКлючи = ОбъединитьКлючиСоответствия(Счетчик1, Счетчик2);
	
	Для Каждого ЭлементКлюча Из ВсеКлючи Цикл
		
		КлючСтрокиПолный = ЭлементКлюча.Ключ;
		Количество1 = ?(Счетчик1.Получить(КлючСтрокиПолный) = Неопределено, 0, Счетчик1.Получить(КлючСтрокиПолный));
		Количество2 = ?(Счетчик2.Получить(КлючСтрокиПолный) = Неопределено, 0, Счетчик2.Получить(КлючСтрокиПолный));
		
		Если Количество1 = Количество2 Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоРасхождений = КоличествоРасхождений + 1;
		
		ТипРасхождения = "Строка";
		Если Количество1 = 0 Тогда
			ТипРасхождения = "Только в док.2";
		ИначеЕсли Количество2 = 0 Тогда
			ТипРасхождения = "Только в док.1";
		Иначе
			ТипРасхождения = "Количество вхождений";
		КонецЕсли;
		
		ДобавитьСтрокуРасхождения(
			Расхождения,
			ИмяТЧ,
			ПредставлениеКлюча + " -> " + СократитьСтроку(КлючСтрокиПолный, 100),
			ФорматКоличества(Количество1),
			ФорматКоличества(Количество2),
			ТипРасхождения);
		
	КонецЦикла;
	
	Возврат КоличествоРасхождений;
	
КонецФункции

Функция ОписаниеТипаКолонки(ОписаниеТЧ, ИмяПоля)
	
	ОписаниеРеквизита = ОписаниеТЧ.Реквизиты.Найти(ИмяПоля);
	
	Если ОписаниеРеквизита = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОписаниеРеквизита.Тип;
	
КонецФункции

Функция ПостроитьИндексПоКлючу(Таблица, ПоляКлюча)
	
	Индекс = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Ключ = КлючСопоставленияСтроки(СтрокаТаблицы, ПоляКлюча);
		СтрокиКлюча = Индекс.Получить(Ключ);
		
		Если СтрокиКлюча = Неопределено Тогда
			СтрокиКлюча = Новый Массив;
			Индекс.Вставить(Ключ, СтрокиКлюча);
		КонецЕсли;
		
		СтрокиКлюча.Добавить(СтрокаТаблицы);
		
	КонецЦикла;
	
	Возврат Индекс;
	
КонецФункции

Функция КлючСопоставленияСтроки(СтрокаТаблицы, ПоляКлюча)
	
	ЧастиКлюча = Новый Массив;
	
	Для Каждого ИмяПоля Из ПоляКлюча Цикл
		ЧастиКлюча.Добавить(НормализоватьЗначение(СтрокаТаблицы[ИмяПоля]));
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиКлюча, "|");
	
КонецФункции

Процедура УдалитьСлужебныеКолонки(Таблица)
	
	СлужебныеКолонки = Новый Массив;
	СлужебныеКолонки.Добавить("НомерСтроки");
	СлужебныеКолонки.Добавить("Ссылка");
	
	Для Каждого ИмяКолонки Из СлужебныеКолонки Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Таблица.Колонки.Удалить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПостроитьСчетчикСтрок(Таблица)
	
	Счетчик = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Ключ = КлючСтроки(СтрокаТаблицы, Таблица.Колонки);
		Количество = Счетчик.Получить(Ключ);
		
		Если Количество = Неопределено Тогда
			Количество = 0;
		КонецЕсли;
		
		Счетчик.Вставить(Ключ, Количество + 1);
		
	КонецЦикла;
	
	Возврат Счетчик;
	
КонецФункции

Функция ОбъединитьКлючиСоответствия(Соответствие1, Соответствие2)
	
	ВсеКлючи = Новый Соответствие;
	
	Для Каждого Элемент Из Соответствие1 Цикл
		ВсеКлючи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	
	Для Каждого Элемент Из Соответствие2 Цикл
		ВсеКлючи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	
	Возврат ВсеКлючи;
	
КонецФункции

Функция КлючСтроки(СтрокаТаблицы, Колонки)
	
	ЧастиКлюча = Новый Массив;
	
	Для Каждого Колонка Из Колонки Цикл
		ЧастиКлюча.Добавить(НормализоватьЗначение(СтрокаТаблицы[Колонка.Имя]));
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиКлюча, "|");
	
КонецФункции

Функция ЗначенияРавны(Значение1, Значение2, ОписаниеТипов = Неопределено)
	
	Заполнено1 = ЗначениеЗаполнено(Значение1);
	Заполнено2 = ЗначениеЗаполнено(Значение2);
	
	Если Не Заполнено1 И Не Заполнено2 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Заполнено1 <> Заполнено2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОписаниеТипов <> Неопределено И ОписаниеТипов.СодержитТип(Тип("Число")) Тогда
		Возврат Макс(Значение1, Значение2) - Мин(Значение1, Значение2) <= 0.01;
	КонецЕсли;
	
	Если ТипЗнч(Значение1) = Тип("Число") И ТипЗнч(Значение2) = Тип("Число") Тогда
		Возврат Макс(Значение1, Значение2) - Мин(Значение1, Значение2) <= 0.01;
	КонецЕсли;
	
	Возврат НормализоватьЗначение(Значение1) = НормализоватьЗначение(Значение2);
	
КонецФункции

Функция НормализоватьЗначение(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Окр(Значение, 4), "ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=D");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "1", "0");
	Иначе
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;
	
КонецФункции

Функция ПредставлениеЗначения(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "<пусто>";
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

Функция ФорматКоличества(Количество)
	
	Возврат Формат(Количество, "ЧГ=0");
	
КонецФункции

Функция СократитьСтроку(Текст, МаксимальнаяДлина)
	
	Если СтрДлина(Текст) <= МаксимальнаяДлина Тогда
		Возврат Текст;
	КонецЕсли;
	
	Возврат Лев(Текст, МаксимальнаяДлина - 3) + "...";
	
КонецФункции

Процедура ДобавитьСтрокуРасхождения(Расхождения, Область, Поле, ЗначениеДок1, ЗначениеДок2, ТипРасхождения)
	
	НоваяСтрока = Расхождения.Добавить();
	НоваяСтрока.Область = Область;
	НоваяСтрока.Поле = Поле;
	НоваяСтрока.ЗначениеДок1 = ЗначениеДок1;
	НоваяСтрока.ЗначениеДок2 = ЗначениеДок2;
	НоваяСтрока.ТипРасхождения = ТипРасхождения;
	
КонецПроцедуры

#КонецОбласти
