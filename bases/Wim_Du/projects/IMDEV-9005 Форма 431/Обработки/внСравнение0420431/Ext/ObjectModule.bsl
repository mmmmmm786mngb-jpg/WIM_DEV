#Область ПрограммныйИнтерфейс

// Описание: Сравнивает два документа 0420431 по шапке и всем табличным частям
// Исключаются служебные реквизиты (Номер, Дата, Проведен, ПометкаУдаления, НомерСтроки)
// Табличные части сравниваются как мультимножества строк (порядок строк не важен)
//
// Параметры:
// Документ1 - ДокументСсылка.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У - первый документ
// Документ2 - ДокументСсылка.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У - второй документ
// ТолькоРасхождения - Булево - не добавлять строки "Совпадает" по разделам
//
// Возвращаемое значение:
// Структура - поля: Идентичны (Булево), Итог (Строка), Расхождения (ТаблицаЗначений)
//
Функция СравнитьДокументы(Документ1, Документ2, ТолькоРасхождения = Истина) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Идентичны", Истина);
	Результат.Вставить("Итог", "");
	Результат.Вставить("Расхождения", СоздатьТаблицуРасхождений());
	
	Если Не ЗначениеЗаполнено(Документ1) Или Не ЗначениеЗаполнено(Документ2) Тогда
		Результат.Идентичны = Ложь;
		Результат.Итог = "Не указаны оба документа для сравнения.";
		Возврат Результат;
	КонецЕсли;
	
	Если Документ1 = Документ2 Тогда
		Результат.Идентичны = Ложь;
		Результат.Итог = "Выбран один и тот же документ.";
		ДобавитьСтрокуРасхождения(Результат.Расхождения, "Проверка", "Документы", Строка(Документ1), Строка(Документ2), "Один документ");
		Возврат Результат;
	КонецЕсли;
	
	Объект1 = Документ1.ПолучитьОбъект();
	Объект2 = Документ2.ПолучитьОбъект();
	МетаданныеДокумента = Метаданные.Документы.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У;
	
	КоличествоРасхождений = 0;
	
	КоличествоРасхождений = КоличествоРасхождений + СравнитьШапку(Объект1, Объект2, МетаданныеДокумента, Результат.Расхождения);
	
	Для Каждого ОписаниеТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		
		Таблица1 = Объект1[ОписаниеТЧ.Имя].Выгрузить();
		Таблица2 = Объект2[ОписаниеТЧ.Имя].Выгрузить();
		УдалитьСлужебныеКолонки(Таблица1);
		УдалитьСлужебныеКолонки(Таблица2);
		
		КоличествоРасхожденийРаздела = СравнитьТабличнуюЧасть(Таблица1, Таблица2, ОписаниеТЧ.Имя, Результат.Расхождения);
		КоличествоРасхождений = КоличествоРасхождений + КоличествоРасхожденийРаздела;
		
		Если КоличествоРасхожденийРаздела = 0 И Не ТолькоРасхождения Тогда
			ДобавитьСтрокуРасхождения(
				Результат.Расхождения,
				ОписаниеТЧ.Имя,
				"Раздел",
				Формат(Таблица1.Количество(), "ЧГ=0") + " строк",
				Формат(Таблица2.Количество(), "ЧГ=0") + " строк",
				"Совпадает");
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Идентичны = (КоличествоРасхождений = 0);
	
	Если Результат.Идентичны Тогда
		Результат.Итог = СтрШаблон(
			"Документы идентичны (кроме Номер/Дата/Ссылка): %1 и %2",
			Документ1,
			Документ2);
	Иначе
		Результат.Итог = СтрШаблон(
			"Обнаружено расхождений: %1. %2 <> %3",
			КоличествоРасхождений,
			Документ1,
			Документ2);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьТаблицуРасхождений()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Область", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Таблица.Колонки.Добавить("Поле", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Таблица.Колонки.Добавить("ЗначениеДок1", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеДок2", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ТипРасхождения", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	
	Возврат Таблица;
	
КонецФункции

Функция ИсключаемыеРеквизитыШапки()
	
	Исключения = Новый Массив;
	Исключения.Добавить("Номер");
	Исключения.Добавить("Дата");
	Исключения.Добавить("Проведен");
	Исключения.Добавить("ПометкаУдаления");
	
	Возврат Исключения;
	
КонецФункции

Функция СравнитьШапку(Объект1, Объект2, МетаданныеДокумента, Расхождения)
	
	КоличествоРасхождений = 0;
	Исключения = ИсключаемыеРеквизитыШапки();
	
	Для Каждого ОписаниеРеквизита Из МетаданныеДокумента.Реквизиты Цикл
		
		Если Исключения.Найти(ОписаниеРеквизита.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Значение1 = Объект1[ОписаниеРеквизита.Имя];
		Значение2 = Объект2[ОписаниеРеквизита.Имя];
		
		Если ЗначенияРавны(Значение1, Значение2, ОписаниеРеквизита.Тип) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоРасхождений = КоличествоРасхождений + 1;
		ДобавитьСтрокуРасхождения(
			Расхождения,
			"Шапка",
			ОписаниеРеквизита.Имя,
			ПредставлениеЗначения(Значение1),
			ПредставлениеЗначения(Значение2),
			"Реквизит");
		
	КонецЦикла;
	
	Возврат КоличествоРасхождений;
	
КонецФункции

Функция СравнитьТабличнуюЧасть(Таблица1, Таблица2, ИмяТЧ, Расхождения)
	
	КоличествоРасхождений = 0;
	
	Если Таблица1.Количество() <> Таблица2.Количество() Тогда
		КоличествоРасхождений = КоличествоРасхождений + 1;
		ДобавитьСтрокуРасхождения(
			Расхождения,
			ИмяТЧ,
			"Количество строк",
			Формат(Таблица1.Количество(), "ЧГ=0"),
			Формат(Таблица2.Количество(), "ЧГ=0"),
			"Количество");
	КонецЕсли;
	
	Счетчик1 = ПостроитьСчетчикСтрок(Таблица1);
	Счетчик2 = ПостроитьСчетчикСтрок(Таблица2);
	ВсеКлючи = ОбъединитьКлючи(Счетчик1, Счетчик2);
	
	Для Каждого ЭлементКлюча Из ВсеКлючи Цикл
		
		Ключ = ЭлементКлюча.Ключ;
		Количество1 = ?(Счетчик1.Получить(Ключ) = Неопределено, 0, Счетчик1.Получить(Ключ));
		Количество2 = ?(Счетчик2.Получить(Ключ) = Неопределено, 0, Счетчик2.Получить(Ключ));
		
		Если Количество1 = Количество2 Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоРасхождений = КоличествоРасхождений + 1;
		
		ТипРасхождения = "Строка";
		Если Количество1 = 0 Тогда
			ТипРасхождения = "Только в док.2";
		ИначеЕсли Количество2 = 0 Тогда
			ТипРасхождения = "Только в док.1";
		Иначе
			ТипРасхождения = "Количество вхождений";
		КонецЕсли;
		
		ДобавитьСтрокуРасхождения(
			Расхождения,
			ИмяТЧ,
			СократитьСтроку(Ключ, 240),
			Формат(Количество1, "ЧГ=0") + " x " + СократитьСтроку(Ключ, 180),
			Формат(Количество2, "ЧГ=0") + " x " + СократитьСтроку(Ключ, 180),
			ТипРасхождения);
		
	КонецЦикла;
	
	Возврат КоличествоРасхождений;
	
КонецФункции

Процедура УдалитьСлужебныеКолонки(Таблица)
	
	СлужебныеКолонки = Новый Массив;
	СлужебныеКолонки.Добавить("НомерСтроки");
	СлужебныеКолонки.Добавить("Ссылка");
	
	Для Каждого ИмяКолонки Из СлужебныеКолонки Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Таблица.Колонки.Удалить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПостроитьСчетчикСтрок(Таблица)
	
	Счетчик = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Ключ = КлючСтроки(СтрокаТаблицы, Таблица.Колонки);
		Количество = Счетчик.Получить(Ключ);
		
		Если Количество = Неопределено Тогда
			Количество = 0;
		КонецЕсли;
		
		Счетчик.Вставить(Ключ, Количество + 1);
		
	КонецЦикла;
	
	Возврат Счетчик;
	
КонецФункции

Функция ОбъединитьКлючи(Счетчик1, Счетчик2)
	
	ВсеКлючи = Новый Соответствие;
	
	Для Каждого Элемент Из Счетчик1 Цикл
		ВсеКлючи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	
	Для Каждого Элемент Из Счетчик2 Цикл
		ВсеКлючи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	
	Возврат ВсеКлючи;
	
КонецФункции

Функция КлючСтроки(СтрокаТаблицы, Колонки)
	
	ЧастиКлюча = Новый Массив;
	
	Для Каждого Колонка Из Колонки Цикл
		ЧастиКлюча.Добавить(НормализоватьЗначение(СтрокаТаблицы[Колонка.Имя]));
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиКлюча, "|");
	
КонецФункции

Функция ЗначенияРавны(Значение1, Значение2, ОписаниеТипов = Неопределено)
	
	Заполнено1 = ЗначениеЗаполнено(Значение1);
	Заполнено2 = ЗначениеЗаполнено(Значение2);
	
	Если Не Заполнено1 И Не Заполнено2 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Заполнено1 <> Заполнено2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОписаниеТипов <> Неопределено И ОписаниеТипов.СодержитТип(Тип("Число")) Тогда
		Возврат Макс(Значение1, Значение2) - Мин(Значение1, Значение2) <= 0.01;
	КонецЕсли;
	
	Если ТипЗнч(Значение1) = Тип("Число") И ТипЗнч(Значение2) = Тип("Число") Тогда
		Возврат Макс(Значение1, Значение2) - Мин(Значение1, Значение2) <= 0.01;
	КонецЕсли;
	
	Возврат НормализоватьЗначение(Значение1) = НормализоватьЗначение(Значение2);
	
КонецФункции

Функция НормализоватьЗначение(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Окр(Значение, 4), "ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=D");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "1", "0");
	Иначе
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;
	
КонецФункции

Функция ПредставлениеЗначения(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "<пусто>";
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

Функция СократитьСтроку(Текст, МаксимальнаяДлина)
	
	Если СтрДлина(Текст) <= МаксимальнаяДлина Тогда
		Возврат Текст;
	КонецЕсли;
	
	Возврат Лев(Текст, МаксимальнаяДлина - 3) + "...";
	
КонецФункции

Процедура ДобавитьСтрокуРасхождения(Расхождения, Область, Поле, ЗначениеДок1, ЗначениеДок2, ТипРасхождения)
	
	НоваяСтрока = Расхождения.Добавить();
	НоваяСтрока.Область = Область;
	НоваяСтрока.Поле = Поле;
	НоваяСтрока.ЗначениеДок1 = ЗначениеДок1;
	НоваяСтрока.ЗначениеДок2 = ЗначениеДок2;
	НоваяСтрока.ТипРасхождения = ТипРасхождения;
	
КонецПроцедуры

#КонецОбласти
