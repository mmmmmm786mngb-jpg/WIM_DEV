#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТолькоРасхождения = Истина;
	ИтогСравнения = "Укажите два документа 0420431 за один период и нажмите ""Сравнить"".";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура Документ1ПриИзменении(Элемент)
	
	ОчиститьРезультатСравненияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Документ2ПриИзменении(Элемент)
	
	ОчиститьРезультатСравненияНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сравнить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Документ1) Или Не ЗначениеЗаполнено(Объект.Документ2) Тогда
		ПоказатьПредупреждение(, "Укажите оба документа для сравнения.");
		Возврат;
	КонецЕсли;
	
	СравнитьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОчиститьРезультатСравненияНаСервере()
	
	ИтогСравнения = "";
	Расхождения.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура СравнитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатСравнения = ОбработкаОбъект.СравнитьДокументы(Объект.Документ1, Объект.Документ2, ТолькоРасхождения);
	
	Расхождения.Очистить();
	
	Для Каждого СтрокаРасхождения Из РезультатСравнения.Расхождения Цикл
		ЗаполнитьЗначенияСвойств(Расхождения.Добавить(), СтрокаРасхождения);
	КонецЦикла;
	
	ИтогСравнения = РезультатСравнения.Итог;
	
КонецПроцедуры

#КонецОбласти
