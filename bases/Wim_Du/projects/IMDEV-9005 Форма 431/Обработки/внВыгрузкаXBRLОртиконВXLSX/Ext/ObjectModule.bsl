				КонецЕсли;
				Текст = СокрЛП(ПрочитатьТекстЭлементаXML(Чтение, Имя));
				Если Не ЗначениеЗаполнено(Метка) Или Не ЗначениеЗаполнено(Текст) Тогда
					Продолжить;
				КонецЕсли;
				Если ЭтоТехническаяПодписьТаксономии(Текст) Тогда
					Продолжить;
				КонецЕсли;
				
				Приоритет = ПриоритетПодписиТаксономии(Роль, Язык);
				Если Приоритет <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Текущий = Ресурсы.Получить(Метка);
				Если Текущий = Неопределено Или Приоритет > Текущий.Приоритет Тогда
					Ресурс = Новый Структура("Текст, Приоритет", Текст, Приоритет);
					Ресурсы.Вставить(Метка, Ресурс);
				КонецЕсли;
				
			ИначеЕсли Имя = "labelArc" Или Имя = "arc" Тогда
				
				Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "from");
				Если Не ЗначениеЗаполнено(Откуда) Тогда
					Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:from");
				КонецЕсли;
				Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "to");
				Если Не ЗначениеЗаполнено(Куда) Тогда
					Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:to");
				КонецЕсли;
				
				ИмяКонцепта = Локаторы.Получить(Откуда);
				Ресурс = Ресурсы.Получить(Куда);
				Если Не ЗначениеЗаполнено(ИмяКонцепта) Или Ресурс = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаписатьПодписьВСловарь(Словарь, ИмяКонцепта, Ресурс.Текст, Ресурс.Приоритет);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Чтение.Закрыть();
		
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	// если arcs не сопоставили - fallback по имени label_Concept
	Для Каждого КЗ Из Ресурсы Цикл
		ИмяИзМетки = ИмяКонцептаИзМеткиРесурса(КЗ.Ключ);
		Если ЗначениеЗаполнено(ИмяИзМетки) Тогда
			ЗаписатьПодписьВСловарь(Словарь, ИмяИзМетки, КЗ.Значение.Текст, КЗ.Значение.Приоритет);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПриоритетПодписиТаксономии(Роль, Язык)
	
	РольНРег = НРег(Строка(Роль));
	ЯзыкНРег = НРег(Строка(Язык));
	
	// ShortLabel в таксономии ЦБ - техкоды purcb_INNTIN, не для Excel
	Если СтрНайти(РольНРег, "shortlabel") > 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Приоритет = 10;
	
	// стандартная роль .../label дает коды как в эталоне: 643, 643-RUB
	Если (СтрЗаканчиваетсяНа(РольНРег, "/label") Или СтрЗаканчиваетсяНа(РольНРег, "#label"))
		И СтрНайти(РольНРег, "alternativ") = 0
		И СтрНайти(РольНРег, "terse") = 0
		И СтрНайти(РольНРег, "verbose") = 0
		И СтрНайти(РольНРег, "technical") = 0 Тогда
		Приоритет = 60;
	ИначеЕсли СтрНайти(РольНРег, "verbose") > 0 Тогда
		Приоритет = 35;
	ИначеЕсли СтрНайти(РольНРег, "terse") > 0 Тогда
		Приоритет = 30;
	ИначеЕсли СтрНайти(РольНРег, "technicallabel") > 0 Или СтрНайти(РольНРег, "technical") > 0 Тогда
		Приоритет = 28;
	ИначеЕсли СтрНайти(РольНРег, "alternativ") > 0 Тогда
		Приоритет = 20;
	ИначеЕсли СтрНайти(РольНРег, "label") > 0 Тогда
		Приоритет = 40;
	КонецЕсли;
	
	Если ЯзыкНРег = "ru" Тогда
		Приоритет = Приоритет + 10;
	ИначеЕсли ЯзыкНРег = "en" Тогда
		Приоритет = Приоритет - 5;
	КонецЕсли;
	
	Возврат Приоритет;
	
КонецФункции

Функция ЭтоТехническаяПодписьТаксономии(Текст)
	
	Значение = СокрЛП(Строка(Текст));
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// номера колонок rc-code в table-lab: "1", "2", ...
	ТолькоЦифры = Истина;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			ТолькоЦифры = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ТолькоЦифры Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЗначениеНРег = НРег(Значение);
	Если СтрНачинаетсяС(ЗначениеНРег, "purcb_")
		Или СтрНачинаетсяС(ЗначениеНРег, "nfo_")
		Или СтрНачинаетсяС(ЗначениеНРег, "brk_")
		Или СтрНачинаетсяС(ЗначениеНРег, "mem-int_")
		Или СтрНачинаетсяС(ЗначениеНРег, "dim-int_") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ЗаписатьПодписьВСловарь(Словарь, ИмяКонцепта, Текст, Приоритет)
	
	Если Приоритет <= 0 Или ЭтоТехническаяПодписьТаксономии(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	Ключи = КлючиПодписиДляКонцепта(ИмяКонцепта);
	Для Каждого Ключ Из Ключи Цикл
		Текущий = Словарь.Получить(Ключ);
		Если Текущий = Неопределено Тогда
			Словарь.Вставить(Ключ, Новый Структура("Текст, Приоритет", Текст, Приоритет));
		ИначеЕсли Приоритет > Текущий.Приоритет Тогда
			Текущий.Текст = Текст;
			Текущий.Приоритет = Приоритет;
		ИначеЕсли Приоритет = Текущий.Приоритет
			И СтрДлина(Текст) > СтрДлина(Текущий.Текст) Тогда
			// при равном приоритете берем более полную формулировку (как в эталоне)
			Текущий.Текст = Текст;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция КлючиПодписиДляКонцепта(ИмяКонцепта)
	
	Результат = Новый Массив;
	Имя = СокрЛП(Строка(ИмяКонцепта));
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Добавить(Имя);
	
	БезЧлена = Имя;
	Если СтрЗаканчиваетсяНа(БезЧлена, "Member") Тогда
		БезЧлена = Лев(БезЧлена, СтрДлина(БезЧлена) - 6);
		Результат.Добавить(БезЧлена);
	КонецЕсли;
	
	БезEnum = БезЧлена;
	Если СтрЗаканчиваетсяНа(БезEnum, "Enumerator") Тогда
		БезEnum = Лев(БезEnum, СтрДлина(БезEnum) - 10);
		Результат.Добавить(БезEnum);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ФрагментHrefТаксономии(Href)
	
	Текст = СокрЛП(Строка(Href));
	Позиция = СтрНайти(Текст, "#");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Текст, Позиция + 1);
	
КонецФункции

Функция ЛокальноеИмяИзHrefТаксономии(Href)
	
	Имя = ФрагментHrefТаксономии(Href);
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат "";
	КонецЕсли;
	
	// узлы таблицы, не концепты
	Если СтрНачинаетсяС(Имя, "ruleNode") Или Имя = "table" Или СтрНачинаетсяС(Имя, "breakdown") Тогда
		Возврат "";
	КонецЕсли;
	
	ПозицияПодчеркивания = СтрНайти(Имя, "_");
	Если ПозицияПодчеркивания > 0 Тогда
		Префикс = Лев(Имя, ПозицияПодчеркивания - 1);
		// schema fragment: purcb-dic_Concept, nfo-dic_SokrNaim, mem-int_Member
		Если СтрНайти(Префикс, "-") > 0 Тогда
			Возврат Сред(Имя, ПозицияПодчеркивания + 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Имя;
	
КонецФункции

Функция ИмяКонцептаИзМеткиРесурса(Метка)
	
	Текст = СокрЛП(Строка(Метка));
	Если СтрНачинаетсяС(Текст, "label_") Тогда
		Возврат Сред(Текст, 7);
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ПодписьКолонкиПоТаксономии(ИмяКолонки, СловарьПодписей, ПодписиТаблицы = Неопределено)
	
	Если Не ЗначениеЗаполнено(ИмяКолонки) Тогда
		Возврат ИмяКолонки;
	КонецЕсли;
	
	Кандидаты = КандидатыИменКолонкиДляПодписи(ИмяКолонки);
	
	// 1) подписи конкретной таблицы (как в эталоне ЦБ)
	ЛучшийТекст = ЛучшаяПодписьИзСловаря(Кандидаты, ПодписиТаблицы);
	Если ЗначениеЗаполнено(ЛучшийТекст) Тогда
		Возврат ЛучшийТекст;
	КонецЕсли;
	
	// 2) общие dic-labels
	ЛучшийТекст = ЛучшаяПодписьИзСловаря(Кандидаты, СловарьПодписей);
	Если ЗначениеЗаполнено(ЛучшийТекст) Тогда
		Возврат ЛучшийТекст;
	КонецЕсли;
	
	Возврат ИмяКолонки;
	
КонецФункции

Функция КандидатыИменКолонкиДляПодписи(ИмяКолонки)
	
	Кандидаты = Новый Массив;
	Имя = Строка(ИмяКолонки);
	Кандидаты.Добавить(Имя);
	
	// DSKO_BB_2025-12-31 -> DSKO_BB
	Если СтрНачинаетсяС(Имя, "DSKO_") Тогда
		Позиция = СтрНайти(Имя, "_20");
		Если Позиция > 0 Тогда
			Кандидаты.Добавить(Лев(Имя, Позиция - 1));
		КонецЕсли;
	КонецЕсли;
	
	// dim-int: Rek_kred_org_i_scheta -> Rek_kred_org_i_schetaTaxis
	Если Не СтрЗаканчиваетсяНа(Имя, "Taxis") И Не СтрЗаканчиваетсяНа(Имя, "Axis") Тогда
		Кандидаты.Добавить(Имя + "Taxis");
		Кандидаты.Добавить(Имя + "Axis");
	КонецЕсли;
	
	Кандидаты.Добавить(Имя + "Member");
	Кандидаты.Добавить(Имя + "Enumerator");
	Если СтрЗаканчиваетсяНа(Имя, "Enumerator") Тогда
		Кандидаты.Добавить(Лев(Имя, СтрДлина(Имя) - 10));
	КонецЕсли;
	
	Возврат Кандидаты;
	
КонецФункции

Функция ЛучшаяПодписьИзСловаря(Кандидаты, СловарьПодписей)
	
	Если СловарьПодписей = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЛучшийТекст = "";
	ЛучшийПриоритет = -1;
	Для Каждого Ключ Из Кандидаты Цикл
		Запись = СловарьПодписей.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Запись.Приоритет > ЛучшийПриоритет
			И Не ЭтоТехническаяПодписьТаксономии(Запись.Текст) Тогда
			ЛучшийПриоритет = Запись.Приоритет;
			ЛучшийТекст = Запись.Текст;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЛучшийТекст;
	
КонецФункции

// Описание: Каталог таблиц (включая вторичные SR_*_2) из XSD точки входа instance
//
Функция ЗагрузитьКаталогТаблицИзТочкиВхода(КаталогТаксономии, SchemaRef)
	
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(КаталогТаксономии) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПутьEP = НайтиФайлТочкиВходаТаксономии(КаталогТаксономии, SchemaRef);
	Если Не ЗначениеЗаполнено(ПутьEP) Тогда
		Возврат Результат;
	КонецЕсли;
	
	КаталогиTab = КаталогиТаблицИзXsdТочкиВхода(ПутьEP);
	Для Каждого КаталогTab Из КаталогиTab Цикл
		
		ФайлыLab = НайтиФайлы(КаталогTab, "*-lab.xml", Ложь);
		Для Каждого ФайлLab Из ФайлыLab Цикл
			
			ПутьRend = СтрЗаменить(ФайлLab.ПолноеИмя, "-lab.xml", "-rend.xml");
			ФайлRend = Новый Файл(ПутьRend);
			Если Не ФайлRend.Существует() Тогда
				Продолжить;
			КонецЕсли;
			
			Ключ = СтрЗаменить(ФайлLab.ИмяБезРасширения, "-lab", "");
			Ключ = СтрЗаменить(Ключ, "-Lab", "");
			МетаRend = ПрочитатьМетаданныеТаблицыRend(ПутьRend);
			ЗаголовокТаблицы = ПрочитатьЗаголовокТаблицыИзLab(ФайлLab.ПолноеИмя);
			Если Не ЗначениеЗаполнено(ЗаголовокТаблицы) Тогда
				ЗаголовокТаблицы = Ключ;
			КонецЕсли;
			
			Измерения = Новый Соответствие;
			ПорядокОсей = Новый Массив;
			Для Каждого ИмяИзмерения Из ПрочитатьИзмеренияТаблицыRend(ПутьRend) Цикл
				Если Измерения.Получить(ИмяИзмерения) = Неопределено Тогда
					Измерения.Вставить(ИмяИзмерения, Истина);
					ПорядокОсей.Добавить(ИмяИзмерения);
				КонецЕсли;
			КонецЦикла;
			
			Концепты = Новый Соответствие;
			ПорядокКонцептов = Новый Массив;
			Для Каждого ИмяКонцепта Из МетаRend.ПорядокКонцептов Цикл
				Концепты.Вставить(ИмяКонцепта, Истина);
				ПорядокКонцептов.Добавить(ИмяКонцепта);
			КонецЦикла;
			
			Запись = Новый Структура;
			Запись.Вставить("Ключ", Ключ);
			Запись.Вставить("Toc", ЗаголовокТаблицы);
			Запись.Вставить("SheetTitle", КраткоеИмяЛистаИзЗаголовкаТаблицы(ЗаголовокТаблицы, Ключ));
			Запись.Вставить("Dims", Измерения);
			Запись.Вставить("DimOrder", ПорядокОсей);
			Запись.Вставить("Concepts", Концепты);
			Запись.Вставить("ConceptOrder", ПорядокКонцептов);
			Результат.Добавить(Запись);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиФайлТочкиВходаТаксономии(КаталогТаксономии, SchemaRef)
	
	ИмяФайла = "";
	ТекстRef = СокрЛП(Строка(SchemaRef));
	Если ЗначениеЗаполнено(ТекстRef) Тогда
		ТекстRef = СтрЗаменить(ТекстRef, "\", "/");
		Части = СтрРазделить(ТекстRef, "/");
		Если Части.Количество() > 0 Тогда
			ИмяФайла = Части[Части.ВГраница()];
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Найденные = НайтиФайлы(КаталогТаксономии, ИмяФайла, Истина);
		Если Найденные.Количество() > 0 Тогда
			Возврат Найденные[0].ПолноеИмя;
		КонецЕсли;
	КонецЕсли;
	
	// запасной вариант: любой ep_*ex_mal*.xsd
	Найденные = НайтиФайлы(КаталогТаксономии, "ep_*ex_mal*.xsd", Истина);
	Если Найденные.Количество() > 0 Тогда
		Возврат Найденные[0].ПолноеИмя;
	КонецЕсли;
	
	Найденные = НайтиФайлы(КаталогТаксономии, "ep_*.xsd", Истина);
	Для Каждого Файл Из Найденные Цикл
		Если СтрНайти(НРег(Файл.ПолноеИмя), "\ep\") > 0
			Или СтрНайти(НРег(Файл.ПолноеИмя), "/ep/") > 0 Тогда
			Возврат Файл.ПолноеИмя;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция КаталогиТаблицИзXsdТочкиВхода(ПутьEP)
	
	Результат = Новый Массив;
	УжеДобавлены = Новый Соответствие;
	
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(ПутьEP);
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	КаталогEP = Новый Файл(ПутьEP);
	БазаEP = КаталогEP.Путь;
	
	Попытка
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			Если Чтение.ЛокальноеИмя <> "import" Тогда
				Продолжить;
			КонецЕсли;
			
			SchemaLocation = ЗначениеАтрибутаЧтенияXML(Чтение, "schemaLocation");
			Если Не ЗначениеЗаполнено(SchemaLocation) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(НРег(SchemaLocation), "/tab/") = 0 И СтрНайти(НРег(SchemaLocation), "\tab\") = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ПутьXsd = РазыменоватьОтносительныйПуть(БазаEP, SchemaLocation);
			ФайлXsd = Новый Файл(ПутьXsd);
			Если Не ФайлXsd.Существует() Тогда
				Продолжить;
			КонецЕсли;
			КаталогTab = ФайлXsd.Путь;
			Если ЗначениеЗаполнено(КаталогTab) И УжеДобавлены.Получить(КаталогTab) = Неопределено Тогда
				УжеДобавлены.Вставить(КаталогTab, Истина);
				Результат.Добавить(КаталогTab);
			КонецЕсли;
			
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьЗаголовокТаблицыИзLab(ПутьКФайлу)
	
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(ПутьКФайлу);
	Исключение
		Возврат "";
	КонецПопытки;
	
	Локаторы = Новый Соответствие;
	Ресурсы = Новый Соответствие;
	ПодписьTable = "";
	КандидатПоКоду = "";
	
	Попытка
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "loc" Тогда
				Метка = ЗначениеАтрибутаЧтенияXML(Чтение, "label");
				Если Не ЗначениеЗаполнено(Метка) Тогда
					Метка = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:label");
				КонецЕсли;
				Href = ЗначениеАтрибутаЧтенияXML(Чтение, "href");
				Если Не ЗначениеЗаполнено(Href) Тогда
					Href = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:href");
				КонецЕсли;
				Локаторы.Вставить(Метка, ФрагментHrefТаксономии(Href));
				
			ИначеЕсли Имя = "label" Тогда
				Метка = ЗначениеАтрибутаЧтенияXML(Чтение, "label");
				Если Не ЗначениеЗаполнено(Метка) Тогда
					Метка = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:label");
				КонецЕсли;
				Язык = ЗначениеАтрибутаЧтенияXML(Чтение, "lang");
				Если Не ЗначениеЗаполнено(Язык) Тогда
					Язык = ЗначениеАтрибутаЧтенияXML(Чтение, "xml:lang");
				КонецЕсли;
				Текст = СокрЛП(ПрочитатьТекстЭлементаXML(Чтение, Имя));
				Если НРег(Строка(Язык)) = "ru" И ЗначениеЗаполнено(Текст) И Не ЭтоТехническаяПодписьТаксономии(Текст) Тогда
					Ресурсы.Вставить(Метка, Текст);
					Если Не ЗначениеЗаполнено(КандидатПоКоду)
						И СтрДлина(Текст) >= 7
						И СтрНайти("0123456789", Лев(Текст, 1)) > 0 Тогда
						КандидатПоКоду = Текст;
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли Имя = "arc" Или Имя = "labelArc" Тогда
				Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "from");
				Если Не ЗначениеЗаполнено(Откуда) Тогда
					Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:from");
				КонецЕсли;
				Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "to");
				Если Не ЗначениеЗаполнено(Куда) Тогда
					Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:to");
				КонецЕсли;
				// xlink:label локатора обычно "table"; фрагмент href может быть
				// #table (SR_INFO) или #sr_soprovod (имя таблицы в rend)
				ФрагментОткуда = Локаторы.Получить(Откуда);
				Если Откуда = "table" Или ФрагментОткуда = "table" Тогда
					Текст = Ресурсы.Получить(Куда);
					Если ЗначениеЗаполнено(Текст) Тогда
						ПодписьTable = Текст;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ПодписьTable) Тогда
		Возврат ПодписьTable;
	КонецЕсли;
	Возврат КандидатПоКоду;
	
КонецФункции

Функция ПрочитатьИзмеренияТаблицыRend(ПутьКФайлу)
	
	Результат = Новый Массив;
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(ПутьКФайлу);
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	Попытка
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			Если Чтение.ЛокальноеИмя = "dimensionAspect" Тогда
				Текст = СокрЛП(ПрочитатьТекстЭлементаXML(Чтение, "dimensionAspect"));
				Имя = ЛокальноеИмяИзQName(Текст);
				Если ЗначениеЗаполнено(Имя) Тогда
					Результат.Добавить(Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция РазыменоватьОтносительныйПуть(БазовыйКаталог, ОтносительныйПуть)
	
	Разделитель = ПолучитьРазделительПути();
	База = СокрЛП(Строка(БазовыйКаталог));
	Если Не СтрЗаканчиваетсяНа(База, Разделитель) Тогда
		База = База + Разделитель;
	КонецЕсли;
	
	Относительный = СтрЗаменить(СокрЛП(Строка(ОтносительныйПуть)), "/", Разделитель);
	Относительный = СтрЗаменить(Относительный, "\", Разделитель);
	
	ЧастиБазы = СтрРазделить(База, Разделитель, Ложь);
	ЧастиОтн = СтрРазделить(Относительный, Разделитель, Ложь);
	
	Для Каждого Часть Из ЧастиОтн Цикл
		Если Часть = "." Или Не ЗначениеЗаполнено(Часть) Тогда
			Продолжить;
		ИначеЕсли Часть = ".." Тогда
			Если ЧастиБазы.Количество() > 0 Тогда
				ЧастиБазы.Удалить(ЧастиБазы.ВГраница());
			КонецЕсли;
		Иначе
			ЧастиБазы.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиБазы, Разделитель);
	
КонецФункции

Функция КраткоеИмяЛистаИзЗаголовкаТаблицы(Заголовок, КлючЗапасной)
	
	Текст = СокрЛП(Строка(Заголовок));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Текст = КлючЗапасной;
	КонецЕсли;
	
	// убираем хвост "ежемесячная" и сверхдлинные уточнения в скобках для краткости имени листа
	Текст = СтрЗаменить(Текст, ", ежемесячная", "");
	Если СтрДлина(Текст) > 40 Тогда
		ПозицияСкобки = СтрНайти(Текст, " (");
		Если ПозицияСкобки > 20 Тогда
			Текст = Лев(Текст, ПозицияСкобки - 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция ЭтоКлючТаблицыБанковскихСчетов(КлючТаблицы)
	
	Ключ = Строка(КлючТаблицы);
	Возврат СтрНайти(Ключ, "0420409_m") > 0 И СтрНайти(Ключ, "0420409_2") = 0;
	
КонецФункции

// Описание: Подбирает запись каталога EP (лист таксономии) по измерениям и концептам фактов
// Учитывает TechnicalAxis/Итого: матч только по концептам без штрафа за ось
// Оптимизация: оценка только кандидатов из индекса (ПоОси/ПоКонцепту), логика счета та же.
//
// Параметры:
// Dims - Соответствие - измерения контекста XBRL
// Факты - Соответствие - concept -> value текущего контекста
// КаталогТаблицEP - Массив - записи EP (Dims, Concepts, SheetTitle, Toc, ...)
// ИндексEP - Структура, Неопределено - индекс ПостроитьИндексКаталогаEP (быстрее)
//
// Возвращаемое значение:
// Структура, Неопределено - лучшая запись каталога или Неопределено
//
Функция НайтиЗаписьКаталогаEP(Dims, Факты, КаталогТаблицEP, ИндексEP = Неопределено)
	
	Если КаталогТаблицEP = Неопределено Или КаталогТаблицEP.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Лучшая = Неопределено;
	ЛучшийСчет = 0;
	ТолькоТехническаяОсь = ЭтоКонтекстТолькоТехническойОси(Dims);
	Кандидаты = КандидатыЗаписейКаталогаEP(Dims, Факты, КаталогТаблицEP, ИндексEP, ТолькоТехническаяОсь);
	
	Для Каждого Запись Из Кандидаты Цикл
		
		Счет = 0;
		СовпалоИзмерений = 0;
		
		Для Каждого КЗДим Из Dims Цикл
			Если Запись.Dims.Получить(КЗДим.Ключ) <> Неопределено Тогда
				Счет = Счет + 3;
				СовпалоИзмерений = СовпалоИзмерений + 1;
			КонецЕсли;
		КонецЦикла;
		
		СовпалоКонцептов = 0;
		Если Факты <> Неопределено И Факты.Количество() > 0 И Запись.Concepts.Количество() > 0 Тогда
			// обходим меньшее множество - сумма та же
			Если Запись.Concepts.Количество() <= Факты.Количество() Тогда
				Для Каждого КЗКонц Из Запись.Concepts Цикл
					Если Факты.Получить(КЗКонц.Ключ) <> Неопределено Тогда
						Счет = Счет + 5;
						СовпалоКонцептов = СовпалоКонцептов + 1;
					КонецЕсли;
				КонецЦикла;
			Иначе
				Для Каждого КЗФакт Из Факты Цикл
					Если Запись.Concepts.Получить(КЗФакт.Ключ) <> Неопределено Тогда
						Счет = Счет + 5;
						СовпалоКонцептов = СовпалоКонцептов + 1;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		// Concept-only (нет совпавших осей) разрешен только когда:
		// 1) TechnicalAxis/Itogo - ось не в dimensionAspect (Vyd_Zajm -> R1, Pol_Zajm -> R2);
		// 2) контекст без осей (шапка SR_INFO) и у таблицы тоже нет осей.
		// Иначе общие концепты (SokrNaim, INN_TIN) уводят 0420409 R2 в банковский R1.
		Если СовпалоИзмерений = 0 Тогда
			Если СовпалоКонцептов = 0 Тогда
				Продолжить;
			КонецЕсли;
			КонтекстБезОсей = (Dims.Количество() = 0);
			ТаблицаБезОсей = (Запись.Dims.Количество() = 0);
			Если ТолькоТехническаяОсь Тогда
				Счет = Счет + 30;
			ИначеЕсли КонтекстБезОсей И ТаблицаБезОсей Тогда
				Счет = Счет + 30;
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		// бонус: все измерения контекста есть в таблице
		Если Dims.Количество() > 0 И СовпалоИзмерений = Dims.Количество() Тогда
			Счет = Счет + 10;
		КонецЕсли;
		
		// сильный бонус: набор осей совпал точно (не сваливать 431 R1 в "широкую" таблицу)
		Если Dims.Количество() > 0
			И Запись.Dims.Количество() = Dims.Количество()
			И СовпалоИзмерений = Dims.Количество() Тогда
			Счет = Счет + 25;
		КонецЕсли;
		
		// штраф за лишние оси таблицы относительно контекста
		// для строки Итого (только TechnicalAxis) штраф не применяем
		Если Не ТолькоТехническаяОсь Тогда
			Если Запись.Dims.Количество() > СовпалоИзмерений Тогда
				Счет = Счет - (Запись.Dims.Количество() - СовпалоИзмерений);
			КонецЕсли;
		КонецЕсли;
		
		// без совпадения концептов не берем "широкий" матч только по одной оси
		Если СовпалоКонцептов = 0 И Запись.Concepts.Количество() > 0 Тогда
			Счет = Счет - 15;
		КонецЕсли;
		
		Если Счет > ЛучшийСчет Тогда
			ЛучшийСчет = Счет;
			Лучшая = Запись;
		КонецЕсли;
		
	КонецЦикла;
	
	// порог: хотя бы одно измерение + один концепт, либо точное совпадение осей,
	// либо матч только по концептам (итоги TechnicalAxis)
	Если ЛучшийСчет < 8 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Лучшая;
	
КонецФункции

// Описание: Индекс каталога EP для быстрого отбора кандидатов (без изменения правил счета)
//
// Параметры:
// КаталогТаблицEP - Массив - записи EP
//
// Возвращаемое значение:
// Структура - ПоОси, ПоКонцепту, БезОсей
//
Функция ПостроитьИндексКаталогаEP(КаталогТаблицEP)
	
	Результат = Новый Структура;
	Результат.Вставить("ПоОси", Новый Соответствие);
	Результат.Вставить("ПоКонцепту", Новый Соответствие);
	Результат.Вставить("БезОсей", Новый Массив);
	
	Если КаталогТаблицEP = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Запись Из КаталогТаблицEP Цикл
		
		Если Запись.Dims.Количество() = 0 Тогда
			Результат.БезОсей.Добавить(Запись);
		Иначе
			Для Каждого КЗДим Из Запись.Dims Цикл
				Список = Результат.ПоОси.Получить(КЗДим.Ключ);
				Если Список = Неопределено Тогда
					Список = Новый Массив;
					Результат.ПоОси.Вставить(КЗДим.Ключ, Список);
				КонецЕсли;
				Список.Добавить(Запись);
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого КЗКонц Из Запись.Concepts Цикл
			Список = Результат.ПоКонцепту.Получить(КЗКонц.Ключ);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				Результат.ПоКонцепту.Вставить(КЗКонц.Ключ, Список);
			КонецЕсли;
			Список.Добавить(Запись);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Кандидаты EP, которые старый полный перебор мог бы оценить (остальные Continue)
// Обычный контекст с осями - только таблицы, делящие хотя бы одну ось.
// TechnicalAxis - оси + таблицы по концептам. Контекст без осей - только EP без осей.
//
Функция КандидатыЗаписейКаталогаEP(Dims, Факты, КаталогТаблицEP, ИндексEP, ТолькоТехническаяОсь)
	
	Если ИндексEP = Неопределено Тогда
		Возврат КаталогТаблицEP;
	КонецЕсли;
	
	Уникальные = Новый Соответствие;
	Кандидаты = Новый Массив;
	КонтекстБезОсей = (Dims = Неопределено Или Dims.Количество() = 0);
	
	Если КонтекстБезОсей Тогда
		Для Каждого Запись Из ИндексEP.БезОсей Цикл
			ДобавитьУникальнуюЗаписьEP(Уникальные, Кандидаты, Запись);
		КонецЦикла;
		Возврат Кандидаты;
	КонецЕсли;
	
	Для Каждого КЗДим Из Dims Цикл
		Список = ИндексEP.ПоОси.Получить(КЗДим.Ключ);
		Если Список = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Запись Из Список Цикл
			ДобавитьУникальнуюЗаписьEP(Уникальные, Кандидаты, Запись);
		КонецЦикла;
	КонецЦикла;
	
	Если ТолькоТехническаяОсь И Факты <> Неопределено Тогда
		Для Каждого КЗФакт Из Факты Цикл
			Список = ИндексEP.ПоКонцепту.Получить(КЗФакт.Ключ);
			Если Список = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Запись Из Список Цикл
				ДобавитьУникальнуюЗаписьEP(Уникальные, Кандидаты, Запись);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Кандидаты;
	
КонецФункции

Процедура ДобавитьУникальнуюЗаписьEP(Уникальные, Кандидаты, Запись)
	
	Если Уникальные.Получить(Запись.Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Уникальные.Вставить(Запись.Ключ, Истина);
	Кандидаты.Добавить(Запись);
	
КонецПроцедуры

Функция ЭтоКонтекстТолькоТехническойОси(Dims)
	
	Если Dims = Неопределено Или Dims.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Dims.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого КЗДим Из Dims Цикл
		Имя = НРег(Строка(КЗДим.Ключ));
		Возврат СтрНайти(Имя, "technicalaxis") > 0;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

// Описание: Парсит XBRL instance: контексты, факты, schemaRef
//
// Параметры:
// ПутьКФайлу - Строка - путь к файлу .xbrl / .xml
// ВремяНачалаМс - Число - метка старта для сообщений прогресса (0 - без прогресса)
//
// Возвращаемое значение:
// Структура - Контексты, Факты, SchemaRef
//
Функция ПрочитатьДанныеXBRL(ПутьКФайлу, ВремяНачалаМс = 0)
	
	Данные = Новый Структура;
	Данные.Вставить("Контексты", Новый Соответствие); // id -> Структура
	Данные.Вставить("Факты", Новый Соответствие); // id -> Соответствие concept->value
	Данные.Вставить("SchemaRef", "");
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьКФайлу);
	
	СчетчикКонтекстов = 0;
	СчетчикФактов = 0;
	ШагПрогресса = 3000;
	
	Попытка
		
		Пока Чтение.Прочитать() Цикл
			
			Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			
			Имя = Чтение.ЛокальноеИмя;
			
			Если Имя = "schemaRef" Тогда
				Если Не ЗначениеЗаполнено(Данные.SchemaRef) Тогда
					Данные.SchemaRef = ЗначениеHrefСхемыXBRL(Чтение);
				КонецЕсли;
				
			ИначеЕсли Имя = "context" Тогда
				Ид = ЗначениеАтрибутаЧтенияXML(Чтение, "id");
				Контекст = ПрочитатьКонтекстXML(Чтение, Имя);
				Если ЗначениеЗаполнено(Ид) Тогда
					Данные.Контексты.Вставить(Ид, Контекст);
					СчетчикКонтекстов = СчетчикКонтекстов + 1;
					Если СчетчикКонтекстов % ШагПрогресса = 0 Тогда
						СообщитьПрогрессЧтенияXBRL(
							СчетчикКонтекстов,
							СчетчикФактов,
							ВремяНачалаМс);
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(ЗначениеАтрибутаЧтенияXML(Чтение, "contextRef")) Тогда
				
				ContextRef = ЗначениеАтрибутаЧтенияXML(Чтение, "contextRef");
				Concept = Имя;
				Значение = ПрочитатьТекстЭлементаXML(Чтение, Имя);
				
				ФактыКонтекста = Данные.Факты.Получить(ContextRef);
				Если ФактыКонтекста = Неопределено Тогда
					ФактыКонтекста = Новый Соответствие;
					Данные.Факты.Вставить(ContextRef, ФактыКонтекста);
				КонецЕсли;
				ФактыКонтекста.Вставить(Concept, Значение);
				СчетчикФактов = СчетчикФактов + 1;
				Если СчетчикФактов % ШагПрогресса = 0 Тогда
					СообщитьПрогрессЧтенияXBRL(
						СчетчикКонтекстов,
						СчетчикФактов,
						ВремяНачалаМс);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Чтение.Закрыть();
		
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	
	СообщитьПрогрессЧтенияXBRL(СчетчикКонтекстов, СчетчикФактов, ВремяНачалаМс, Истина);
	Возврат Данные;
	
КонецФункции

Функция ПрочитатьКонтекстXML(Чтение, ИмяКонтекста)
	
	Результат = Новый Структура;
	Результат.Вставить("Period", "");
	Результат.Вставить("Entity", "");
	Результат.Вставить("Dims", Новый Соответствие);
	Результат.Вставить("SigKey", "");
	
	StartDate = "";
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.ЛокальноеИмя = ИмяКонтекста Тогда
			Прервать;
		КонецЕсли;
		
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = Чтение.ЛокальноеИмя;
		
		Если Имя = "identifier" Тогда
			Результат.Entity = ПрочитатьТекстЭлементаXML(Чтение, Имя);
			
		ИначеЕсли Имя = "instant" Тогда
			Результат.Period = ПрочитатьТекстЭлементаXML(Чтение, Имя);
			
		ИначеЕсли Имя = "startDate" Тогда
			StartDate = ПрочитатьТекстЭлементаXML(Чтение, Имя);
			
		ИначеЕсли Имя = "endDate" Тогда
			Конец = ПрочитатьТекстЭлементаXML(Чтение, Имя);
			Если ЗначениеЗаполнено(StartDate) Тогда
				Результат.Period = StartDate + ".." + Конец;
			Иначе
				Результат.Period = "E:" + Конец;
			КонецЕсли;
			
		ИначеЕсли Имя = "explicitMember" Тогда
			Измерение = ЛокальноеИмяИзQName(ЗначениеАтрибутаЧтенияXML(Чтение, "dimension"));
			ЗначениеЧлена = ЛокальноеИмяИзQName(ПрочитатьТекстЭлементаXML(Чтение, Имя));
			Результат.Dims.Вставить(Измерение, ЗначениеЧлена);
			
		ИначеЕсли Имя = "typedMember" Тогда
			Измерение = ЛокальноеИмяИзQName(ЗначениеАтрибутаЧтенияXML(Чтение, "dimension"));
			ЗначениеТип = ПрочитатьЗначениеTypedMember(Чтение, Имя);
			Результат.Dims.Вставить(Измерение, ЗначениеТип);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.SigKey = КлючСигнатурыОсей(Результат.Dims);
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьЗначениеTypedMember(Чтение, ИмяTyped)
	
	Значение = "";
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.ЛокальноеИмя = ИмяTyped Тогда
			Прервать;
		КонецЕсли;
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Значение = ПрочитатьТекстЭлементаXML(Чтение, Чтение.ЛокальноеИмя);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции

// Описание: Собирает корзины листов Excel из контекстов/фактов XBRL
// При наличии КаталогТаблицEP создаёт заглушки всех таблиц EP (как в эталоне ЦБ)
//
// Параметры:
// ДанныеXBRL - Структура - результат ПрочитатьДанныеXBRL
// ПорядокКолонокТаксономии - Соответствие, Неопределено - ключ таблицы -> порядок концептов
// СловарьПодписей - Соответствие, Неопределено - общие подписи концептов
// КаталогТаблицEP - Массив, Неопределено - каталог entry points таксономии
//
// Возвращаемое значение:
// Соответствие - ключ -> Structure(Name, Toc, Columns, ColSet, Rows, IsBank, TableKey)
//
Функция СобратьЛистыИзДанныхXBRL(ДанныеXBRL, ПорядокКолонокТаксономии = Неопределено, СловарьПодписей = Неопределено, КаталогТаблицEP = Неопределено)
	
	// ключ -> Structure(Name, Toc, Columns, ColSet, Rows, IsBank, TableKey)
	Листы = Новый Соответствие;
	ИспользованныеИмена = Новый Соответствие;
	ИспользованныеИмена.Вставить("TOC", Истина);
	ИндексEP = ПостроитьИндексКаталогаEP(КаталогТаблицEP);
	
	// заглушки всех таблиц EP (как в эталоне ЦБ) - до заполнения данными
	Если КаталогТаблицEP <> Неопределено Тогда
		Для Каждого ЗаписьEP Из КаталогТаблицEP Цикл
			ИмяЛиста = УникальноеИмяЛистаExcel(ЗаписьEP.SheetTitle, ИспользованныеИмена);
			Корзина = Новый Структура;
			Корзина.Вставить("Name", ИмяЛиста);
			Корзина.Вставить("Toc", ЗаписьEP.Toc);
			Корзина.Вставить("Columns", Новый Массив);
			Корзина.Вставить("ColSet", Новый Соответствие);
			Корзина.Вставить("Rows", Новый Массив);
			Корзина.Вставить("IsBank", ЭтоКлючТаблицыБанковскихСчетов(ЗаписьEP.Ключ));
			Корзина.Вставить("TableKey", ЗаписьEP.Ключ);
			Корзина.Вставить("DimOrder", ЗаписьEP.DimOrder);
			Листы.Вставить(ЗаписьEP.Ключ, Корзина);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого КЗ Из ДанныеXBRL.Контексты Цикл
		
		ИдКонтекста = КЗ.Ключ;
		Контекст = КЗ.Значение;
		Факты = ДанныеXBRL.Факты.Получить(ИдКонтекста);
		Если Факты = Неопределено Или Факты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		КлючКорзины = "";
		ЗаписьEP = Неопределено;
		Если КаталогТаблицEP <> Неопределено Тогда
			ЗаписьEP = НайтиЗаписьКаталогаEP(Контекст.Dims, Факты, КаталогТаблицEP, ИндексEP);
		КонецЕсли;
		Если ЗаписьEP <> Неопределено Тогда
			КлючКорзины = ЗаписьEP.Ключ;
			Корзина = Листы.Получить(КлючКорзины);
			Если Корзина = Неопределено Тогда
				ОписаниеЛиста = Новый Структура("Title, Toc", ЗаписьEP.SheetTitle, ЗаписьEP.Toc);
			Иначе
				ОписаниеЛиста = Новый Структура("Title, Toc", Корзина.Name, Корзина.Toc);
			КонецЕсли;
		Иначе
			ОписаниеЛиста = ОписаниеЛистаПоСигнатуре(Контекст.SigKey, Контекст.Dims);
			// не плодим дубль рядом с уже созданным stub EP с тем же Toc
			КлючКорзины = НайтиКлючКорзиныПоToc(Листы, ОписаниеЛиста.Toc);
			Если Не ЗначениеЗаполнено(КлючКорзины) Тогда
				КлючКорзины = ОписаниеЛиста.Title;
			КонецЕсли;
			Корзина = Листы.Получить(КлючКорзины);
		КонецЕсли;
		
		Если Корзина = Неопределено Тогда
			ИмяЛиста = УникальноеИмяЛистаExcel(ОписаниеЛиста.Title, ИспользованныеИмена);
			Корзина = Новый Структура;
			Корзина.Вставить("Name", ИмяЛиста);
			Корзина.Вставить("Toc", ОписаниеЛиста.Toc);
			Корзина.Вставить("Columns", Новый Массив);
			Корзина.Вставить("ColSet", Новый Соответствие);
			Корзина.Вставить("Rows", Новый Массив);
			Корзина.Вставить("IsBank", СтрНачинаетсяС(ОписаниеЛиста.Title, "0420409 Раздел 1")
				Или (ЗаписьEP <> Неопределено И ЭтоКлючТаблицыБанковскихСчетов(ЗаписьEP.Ключ)));
			Корзина.Вставить("TableKey", ?(ЗаписьEP = Неопределено, "", ЗаписьEP.Ключ));
			Если ЗаписьEP <> Неопределено Тогда
				Корзина.Вставить("DimOrder", ЗаписьEP.DimOrder);
			Иначе
				Корзина.Вставить("DimOrder", Новый Массив);
			КонецЕсли;
			Листы.Вставить(КлючКорзины, Корзина);
		ИначеЕсли ЗаписьEP <> Неопределено
			И (Не Корзина.Свойство("DimOrder")
				Или Корзина.DimOrder = Неопределено
				Или Корзина.DimOrder.Количество() = 0)
			И ЗаписьEP.DimOrder.Количество() > 0 Тогда
			Корзина.Вставить("DimOrder", ЗаписьEP.DimOrder);
		КонецЕсли;
		
		СтрокаДанных = Новый Соответствие;
		СтрокаДанных.Вставить("Period", Контекст.Period);
		СтрокаДанных.Вставить("ContextId", ИдКонтекста);
		
		Для Каждого Дим Из Контекст.Dims Цикл
			ИмяКол = ИмяКолонкиИзмерения(Дим.Ключ);
			Если СтрЗаканчиваетсяНа(Дим.Ключ, "Taxis") Тогда
				ЗначКол = Дим.Значение;
			Иначе
				ЗначКол = ПредставлениеЧленаXBRL(Дим.Значение, СловарьПодписей);
			КонецЕсли;
			СтрокаДанных.Вставить(ИмяКол, ЗначКол);
			ДобавитьКолонкуЕслиНет(Корзина, ИмяКол);
		КонецЦикла;
		
		Для Каждого Факт Из Факты Цикл
			ЗначФакта = НормализоватьЗначениеФакта(Факт.Значение, СловарьПодписей);
			СтрокаДанных.Вставить(Факт.Ключ, ЗначФакта);
			ДобавитьКолонкуЕслиНет(Корзина, Факт.Ключ);
		КонецЦикла;
		
		Корзина.Rows.Добавить(СтрокаДанных);
		
	КонецЦикла;
	
	// агрегация банковских счетов, порядок колонок и строк (по осям таксономии)
	Для Каждого КЗЛист Из Листы Цикл
		Корзина = КЗЛист.Значение;
		Если Корзина.IsBank И Корзина.Rows.Количество() > 0 Тогда
			СвернутьБанковскиеСчета(Корзина);
		ИначеЕсли Корзина.Rows.Количество() > 0 Тогда
			УпорядочитьКолонкиЛиста(Корзина);
		КонецЕсли;
		УпорядочитьКолонкиЛистаПоТаксономии(Корзина, ПорядокКолонокТаксономии);
		УпорядочитьСтрокиЛистаПоОсям(Корзина);
	КонецЦикла;
	
	УдалитьПустыеДубликатыЛистовПоToc(Листы);
	
	Возврат Листы;
	
КонецФункции

// Описание: Ищет уже созданную корзину листа по тексту TOC (без учета регистра/пробелов)
//
Функция НайтиКлючКорзиныПоToc(Листы, Toc)
	
	НормИскомый = НормализоватьТекстTocДляСравнения(Toc);
	Если Не ЗначениеЗаполнено(НормИскомый) Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого КЗ Из Листы Цикл
		Если НормализоватьТекстTocДляСравнения(КЗ.Значение.Toc) = НормИскомый Тогда
			Возврат КЗ.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция НормализоватьТекстTocДляСравнения(Toc)
	
	Текст = НРег(СокрЛП(Строка(Toc)));
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат Текст;
	
КонецФункции

// Описание: Удаляет пустые листы-дубликаты с тем же TOC, что у листа с данными
//
Процедура УдалитьПустыеДубликатыЛистовПоToc(Листы)
	
	ЗаполненныеToc = Новый Соответствие;
	Для Каждого КЗ Из Листы Цикл
		Если КЗ.Значение.Rows.Количество() > 0 Тогда
			ЗаполненныеToc.Вставить(НормализоватьТекстTocДляСравнения(КЗ.Значение.Toc), Истина);
		КонецЕсли;
	КонецЦикла;
	
	КлючиУдалить = Новый Массив;
	Для Каждого КЗ Из Листы Цикл
		Если КЗ.Значение.Rows.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		НормToc = НормализоватьТекстTocДляСравнения(КЗ.Значение.Toc);
		Если ЗначениеЗаполнено(НормToc) И ЗаполненныеToc.Получить(НормToc) = Истина Тогда
			КлючиУдалить.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Ключ Из КлючиУдалить Цикл
		Листы.Удалить(Ключ);
	КонецЦикла;
	
КонецПроцедуры

Процедура СвернутьБанковскиеСчета(Корзина)
	
	ПоСчетам = Новый Соответствие;
	
	Для Каждого СтрокаДанных Из Корзина.Rows Цикл
		
		Счет = СтрокаДанных.Получить("Rek_kred_org_i_scheta");
		Если Не ЗначениеЗаполнено(Счет) Тогда
			Счет = СтрокаДанных.Получить("ContextId");
		КонецЕсли;
		
		Элемент = ПоСчетам.Получить(Счет);
		Если Элемент = Неопределено Тогда
			Элемент = Новый Соответствие;
			Элемент.Вставить("Rek_kred_org_i_scheta", Строка(Счет));
			ПоСчетам.Вставить(Счет, Элемент);
		КонецЕсли;
		
		Период = Строка(СтрокаДанных.Получить("Period"));
		ПериодКлюч = СтрЗаменить(СтрЗаменить(Период, "..", "_"), ":", "_");
		Если Не ЗначениеЗаполнено(ПериодКлюч) Тогда
			ПериодКлюч = "NA";
		КонецЕсли;
		
		Для Каждого КЗ Из СтрокаДанных Цикл
			Ключ = КЗ.Ключ;
			Если Ключ = "Period" Или Ключ = "ContextId" Или Ключ = "Rek_kred_org_i_scheta" Тогда
				Продолжить;
			КонецЕсли;
			Если Ключ = "DSKO_BB" Или Ключ = "DSKO_ObDt" Или Ключ = "DSKO_ObKt" Тогда
				Элемент.Вставить(Ключ + "_" + ПериодКлюч, КЗ.Значение);
			ИначеЕсли Не ЗначениеЗаполнено(Элемент.Получить(Ключ)) Тогда
				Элемент.Вставить(Ключ, КЗ.Значение);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	НовыеСтроки = Новый Массив;
	ColSet = Новый Соответствие;
	Columns = Новый Массив;
	
	Для Каждого КЗ Из ПоСчетам Цикл
		НовыеСтроки.Добавить(КЗ.Значение);
		Для Каждого Поле Из КЗ.Значение Цикл
			Если ColSet.Получить(Поле.Ключ) = Неопределено Тогда
				ColSet.Вставить(Поле.Ключ, Истина);
				Columns.Добавить(Поле.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Корзина.Rows = НовыеСтроки;
	Корзина.Columns = Columns;
	Корзина.ColSet = ColSet;
	
	УпорядочитьКолонкиЛистаПоСписку(Корзина, ПорядокКолонокБанковскихСчетовПоУмолчанию());
	
КонецПроцедуры

// Описание: Сортирует строки листа по значениям typed-осей (как группировка в эталоне ЦБ)
// В ключ входят только *Taxis (идентификаторы строк); закрытые *Axis не задают порядок.
// Среди typed: сначала стратегия/брокер, затем остальные идентификаторы.
// Числовые значения выравниваются для корректного порядка (1,2,10).
//
Процедура УпорядочитьСтрокиЛистаПоОсям(Корзина)
	
	Если Корзина = Неопределено Или Корзина.Rows.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	КлючиСортировки = КлючиСортировкиСтрокЛиста(Корзина);
	Если КлючиСортировки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Индекс = 0;
	Для Каждого СтрокаДанных Из Корзина.Rows Цикл
		Список.Добавить(Индекс, КлючСортировкиСтрокиЛиста(СтрокаДанных, КлючиСортировки));
		Индекс = Индекс + 1;
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	
	НовыеСтроки = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		НовыеСтроки.Добавить(Корзина.Rows[Элемент.Значение]);
	КонецЦикла;
	Корзина.Rows = НовыеСтроки;
	
КонецПроцедуры

// Описание: Колонки для сортировки строк листа
// 1) typed-оси (*Taxis) из DimOrder - основной режим как в эталоне;
// 2) иначе идентификаторные колонки ID_/Rek_;
// 3) иначе все оси DimOrder (листы только с закрытыми Axis).
//
Функция КлючиСортировкиСтрокЛиста(Корзина)
	
	TypedКлючи = Новый Массив;
	ВсеКлючиИзОсей = Новый Массив;
	Добавленные = Новый Соответствие;
	
	Если Корзина.Свойство("DimOrder") И Корзина.DimOrder <> Неопределено Тогда
		Для Каждого ИмяОси Из Корзина.DimOrder Цикл
			ИмяКол = ИмяКолонкиИзмерения(ИмяОси);
			Если Не ЗначениеЗаполнено(ИмяКол) Или Добавленные.Получить(ИмяКол) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Не КолонкаЕстьВСтрокахЛиста(Корзина, ИмяКол) Тогда
				Продолжить;
			КонецЕсли;
			Добавленные.Вставить(ИмяКол, Истина);
			ВсеКлючиИзОсей.Добавить(ИмяКол);
			Если ЭтоTypedОсьТаксономии(ИмяОси) Тогда
				TypedКлючи.Добавить(ИмяКол);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если TypedКлючи.Количество() > 0 Тогда
		Возврат УпорядочитьКлючиСортировкиКакВЭталоне(TypedКлючи);
	КонецЕсли;
	
	// без typed в DimOrder: идентификаторные колонки данных
	ИдентКлючи = Новый Массив;
	Список = Новый СписокЗначений;
	Для Каждого ИмяКол Из Корзина.Columns Цикл
		Если ИмяКол = "Period" Или ИмяКол = "ContextId" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(ИмяКол, "ID")
			Или СтрНачинаетсяС(ИмяКол, "Id")
			Или СтрНачинаетсяС(ИмяКол, "Rek") Тогда
			Список.Добавить(ИмяКол);
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Для Каждого Элемент Из Список Цикл
		ИдентКлючи.Добавить(Элемент.Значение);
	КонецЦикла;
	Если ИдентКлючи.Количество() > 0 Тогда
		Возврат УпорядочитьКлючиСортировкиКакВЭталоне(ИдентКлючи);
	КонецЕсли;
	
	Возврат ВсеКлючиИзОсей;
	
КонецФункции

// Описание: Признак typed-оси таксономии (открытое измерение-идентификатор строки)
//
Функция ЭтоTypedОсьТаксономии(ИмяОси)
	
	Имя = Строка(ИмяОси);
	Возврат СтрЗаканчиваетсяНа(Имя, "Taxis");
	
КонецФункции

// Описание: Порядок ключей сортировки ближе к группировке эталона ЦБ
// Сначала стратегия, затем брокер/счет, затем прочие идентификаторы (сохраняя взаимный порядок).
//
Функция УпорядочитьКлючиСортировкиКакВЭталоне(Ключи)
	
	Если Ключи = Неопределено Или Ключи.Количество() <= 1 Тогда
		Возврат Ключи;
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Индекс = 0;
	Для Каждого ИмяКол Из Ключи Цикл
		Приоритет = ПриоритетКлючаСортировкиСтроки(ИмяКол);
		// представление: приоритет + исходный индекс (стабильный порядок внутри группы)
		Представление = Формат(Приоритет, "ЧЦ=2; ЧВН=; ЧГ=0")
			+ Формат(Индекс, "ЧЦ=4; ЧВН=; ЧГ=0")
			+ ИмяКол;
		Список.Добавить(ИмяКол, Представление);
		Индекс = Индекс + 1;
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	
	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Приоритет колонки в ключе сортировки строк (меньше - раньше)
//
Функция ПриоритетКлючаСортировкиСтроки(ИмяКолонки)
	
	ИмяНРег = НРег(Строка(ИмяКолонки));
	
	Если СтрНайти(ИмяНРег, "strateg") > 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	Если СтрНайти(ИмяНРег, "broker") > 0
		Или СтрНайти(ИмяНРег, "brokera") > 0
		Или СтрНайти(ИмяНРег, "kred_org") > 0
		Или СтрНайти(ИмяНРег, "kliring") > 0 Тогда
		Возврат 2;
	КонецЕсли;
	
	Если СтрНачинаетсяС(ИмяКолонки, "ID")
		Или СтрНачинаетсяС(ИмяКолонки, "Id")
		Или СтрНачинаетсяС(ИмяКолонки, "Rek") Тогда
		Возврат 3;
	КонецЕсли;
	
	Возврат 4;
	
КонецФункции

Функция КолонкаЕстьВСтрокахЛиста(Корзина, ИмяКолонки)
	
	Если Корзина.ColSet <> Неопределено И Корзина.ColSet.Получить(ИмяКолонки) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого ИмяКол Из Корзина.Columns Цикл
		Если ИмяКол = ИмяКолонки Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из Корзина.Rows Цикл
		Если СтрокаДанных.Получить(ИмяКолонки) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция КлючСортировкиСтрокиЛиста(СтрокаДанных, КлючиСортировки)
	
	Части = Новый Массив;
	Для Каждого ИмяКол Из КлючиСортировки Цикл
		Значение = СтрокаДанных.Получить(ИмяКол);
		Текст = СокрЛП(Строка(Значение));
		Если ЭтоЦелоеЧислоСтрокойДляСортировки(Текст) Тогда
			Текст = Формат(Число(Текст), "ЧЦ=20; ЧВН=; ЧГ=0");
		КонецЕсли;
		Части.Добавить(Текст);
	КонецЦикла;
	
	Возврат СтрСоединить(Части, Символы.Таб);
	
КонецФункции

Функция ЭтоЦелоеЧислоСтрокойДляСортировки(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

