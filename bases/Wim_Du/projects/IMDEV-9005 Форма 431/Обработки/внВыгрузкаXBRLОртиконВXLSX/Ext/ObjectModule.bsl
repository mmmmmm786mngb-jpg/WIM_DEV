// Описание: Загружает общие dic-labels из файлов таксономии (*label*.xml, *-lab.xml)
//
// Параметры:
// КаталогТаксономии - Строка - корень распакованной таксономии ЦБ
//
// Возвращаемое значение:
// Структура - Подписи, ПодписиТаблиц, ПорядокКолонок (соответствия)
//
Функция ЗагрузитьМетаданныеТаксономии(КаталогТаксономии)
	
	Результат = Новый Структура;
	Результат.Вставить("Подписи", Новый Соответствие); // общие dic-labels
	Результат.Вставить("ПодписиТаблиц", Новый Соответствие); // ключ таблицы -> (концепт -> подпись)
	Результат.Вставить("ПорядокКолонок", Новый Соответствие); // ключ таблицы -> Массив концептов
	
	Если Не ЗначениеЗаполнено(КаталогТаксономии) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Словарь = Результат.Подписи;
	Обработанные = Новый Соответствие;
	Маски = Новый Массив;
	Маски.Добавить("*label*.xml");
	Маски.Добавить("*-lab.xml");
	
	Для Каждого Маска Из Маски Цикл
		Найденные = НайтиФайлы(КаталогТаксономии, Маска, Истина);
		Для Каждого Файл Из Найденные Цикл
			
			ПутьПолный = Файл.ПолноеИмя;
			Если Обработанные.Получить(ПутьПолный) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Обработанные.Вставить(ПутьПолный, Истина);
			
			ПутьНРег = НРег(ПутьПолный);
			Если Не ЭтоФайлСловаряПодписейТаксономии(ПутьНРег) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрНайти(ПутьНРег, "\tab\") > 0 Или СтрНайти(ПутьНРег, "/tab/") > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ПрочитатьФайлПодписейТаксономии(ПутьПолный, Словарь);
			
		КонецЦикла;
	КонецЦикла;
	
	ДополнитьМетаданныеТаблицТаксономии(
		КаталогТаксономии,
		Результат.ПодписиТаблиц,
		Результат.ПорядокКолонок);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоФайлСловаряПодписейТаксономии(ПутьНРег)
	
	Возврат СтрНайти(ПутьНРег, "purcb") > 0
		Или СтрНайти(ПутьНРег, "nfo") > 0
		Или СтрНайти(ПутьНРег, "dictionary-label") > 0
		Или СтрНайти(ПутьНРег, "mem-int-label") > 0
		Или СтрНайти(ПутьНРег, "dim-int-label") > 0
		Или СтрНайти(ПутьНРег, "\eps\") > 0
		Или СтрНайти(ПутьНРег, "/eps/") > 0;
	
КонецФункции

// Описание: Дополняет подписи и порядок колонок по table rend (tab/*-rend.xml, purcb)
//
// Параметры:
// КаталогТаксономии - Строка - корень распакованной таксономии ЦБ
// ПодписиТаблиц - Соответствие - ключ таблицы -> (концепт -> подпись), заполняется на месте
// ПорядокКолонок - Соответствие - ключ таблицы -> Массив концептов, заполняется на месте
//
Процедура ДополнитьМетаданныеТаблицТаксономии(КаталогТаксономии, ПодписиТаблиц, ПорядокКолонок)
	
	НайденныеRend = НайтиФайлы(КаталогТаксономии, "*-rend.xml", Истина);
	Для Каждого ФайлRend Из НайденныеRend Цикл
		
		ПутьНРег = НРег(ФайлRend.ПолноеИмя);
		Если СтрНайти(ПутьНРег, "\tab\") = 0 И СтрНайти(ПутьНРег, "/tab/") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(ПутьНРег, "purcb") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МетаданныеТаблицы = ПрочитатьМетаданныеТаблицыRend(ФайлRend.ПолноеИмя);
		Если МетаданныеТаблицы.УзлыКонцептов.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		КлючиТаблицы = КлючиМетаданныхТаблицыИзИмениФайла(ФайлRend.Имя);
		Если КлючиТаблицы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если МетаданныеТаблицы.ПорядокКонцептов.Количество() > 0 Тогда
			Для Каждого КлючТаблицы Из КлючиТаблицы Цикл
				Если ПорядокКолонок.Получить(КлючТаблицы) = Неопределено Тогда
					ПорядокКолонок.Вставить(КлючТаблицы, МетаданныеТаблицы.ПорядокКонцептов);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// lab строго парный к rend: ...-rend.xml -> ...-lab.xml (не все lab из каталога)
		ИмяLab = СтрЗаменить(ФайлRend.Имя, "-rend.xml", "-lab.xml");
		ИмяLab = СтрЗаменить(ИмяLab, "-rend.XML", "-lab.xml");
		ПутьLab = ФайлRend.Путь + ИмяLab;
		ФайлLab = Новый Файл(ПутьLab);
		Если ФайлLab.Существует() Тогда
			
			// один словарь на все алиасы ключа (полный SR_* как в EP + короткий 0420409_2)
			СловарьТаблицы = Неопределено;
			Для Каждого КлючТаблицы Из КлючиТаблицы Цикл
				СловарьТаблицы = ПодписиТаблиц.Получить(КлючТаблицы);
				Если СловарьТаблицы <> Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СловарьТаблицы = Неопределено Тогда
				СловарьТаблицы = Новый Соответствие;
			КонецЕсли;
			Для Каждого КлючТаблицы Из КлючиТаблицы Цикл
				ПодписиТаблиц.Вставить(КлючТаблицы, СловарьТаблицы);
			КонецЦикла;
			
			ПрочитатьФайлПодписейТаблицыТаксономии(
				ПутьLab,
				МетаданныеТаблицы.УзлыКонцептов,
				СловарьТаблицы);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Полный ключ таблицы как в каталоге EP (SR_0420409_m-SR_0420409_2)
// и короткие алиасы (0420409_2, 0420414_r2) для поиска по разделу листа
//
// Параметры:
// ИмяФайла - Строка - имя *-rend.xml / *-lab.xml
//
// Возвращаемое значение:
// Массив - уникальные ключи метаданных таблицы
//
Функция КлючиМетаданныхТаблицыИзИмениФайла(ИмяФайла)
	
	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	
	ПолныйКлюч = ПолныйКлючТаблицыИзИмениФайла(ИмяФайла);
	Если ЗначениеЗаполнено(ПолныйКлюч) Тогда
		Результат.Добавить(ПолныйКлюч);
		Добавленные.Вставить(ПолныйКлюч, Истина);
	КонецЕсли;
	
	КороткийКлюч = КлючТаблицыТаксономииИзИмениФайла(ИмяФайла);
	Если ЗначениеЗаполнено(КороткийКлюч) И Добавленные.Получить(КороткийКлюч) = Неопределено Тогда
		Результат.Добавить(КороткийКлюч);
		Добавленные.Вставить(КороткийКлюч, Истина);
	КонецЕсли;
	
	// для раздела 2 дополнительно алиас Код_2, если основной короткий ключ вида Код_r2
	Код = КодФормыИзИмениФайлаТаблицы(ИмяФайла);
	Если ЗначениеЗаполнено(Код) Тогда
		Если СтрНайти(НРег(КороткийКлюч), "_r2") > 0 Тогда
			Алиас = Код + "_2";
			Если Добавленные.Получить(Алиас) = Неопределено Тогда
				Результат.Добавить(Алиас);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолныйКлючТаблицыИзИмениФайла(ИмяФайла)
	
	Имя = Строка(ИмяФайла);
	Имя = СтрЗаменить(Имя, "\", "/");
	Части = СтрРазделить(Имя, "/");
	Если Части.Количество() > 0 Тогда
		Имя = Части[Части.ВГраница()];
	КонецЕсли;
	
	ИмяНРег = НРег(Имя);
	Если СтрЗаканчиваетсяНа(ИмяНРег, ".xml") Тогда
		Имя = Лев(Имя, СтрДлина(Имя) - 4);
	КонецЕсли;
	
	ИмяНРег = НРег(Имя);
	Если СтрЗаканчиваетсяНа(ИмяНРег, "-rend") Тогда
		Имя = Лев(Имя, СтрДлина(Имя) - 5);
	ИначеЕсли СтрЗаканчиваетсяНа(ИмяНРег, "-lab") Тогда
		Имя = Лев(Имя, СтрДлина(Имя) - 4);
	КонецЕсли;
	
	Возврат Имя;
	
КонецФункции

Функция КлючТаблицыТаксономииИзИмениФайла(ИмяФайла)
	
	Код = КодФормыИзИмениФайлаТаблицы(ИмяФайла);
	Если Не ЗначениеЗаполнено(Код) Тогда
		Возврат "";
	КонецЕсли;
	
	Имя = Строка(ИмяФайла);
	ИмяВРег = ВРег(Имя);
	ИмяНРег = НРег(Имя);
	
	// SR_0420409_m-SR_0420409_2-rend.xml -> 0420409_2
	// SR_0420459-SR_0420459_2_1-rend.xml -> 0420459_2_1
	Если СтрЧислоВхождений(ИмяВРег, "SR_") >= 2 Тогда
		ПозицияПервого = СтрНайти(ИмяВРег, "SR_");
		ОстатокПослеПервого = Сред(ИмяВРег, ПозицияПервого + 3);
		ПозицияВторогоВОстатке = СтрНайти(ОстатокПослеПервого, "SR_");
		Если ПозицияВторогоВОстатке > 0 Тогда
			ПозицияВторого = ПозицияПервого + 2 + ПозицияВторогоВОстатке;
			ХвостВторого = Сред(Имя, ПозицияВторого + 3);
			Суффикс = КодСекцииТаблицыИзХвостаИмени(ХвостВторого);
			Если ЗначениеЗаполнено(Суффикс) Тогда
				Возврат Суффикс;
			КонецЕсли;
		КонецЕсли;
		Возврат Код + "_2";
	КонецЕсли;
	
	// SR_0420414_r2-rend.xml -> 0420414_r2 (отдельный lab раздела 2)
	Если СтрНайти(ИмяНРег, "_r2") > 0 Тогда
		Возврат Код + "_r2";
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

Функция КодСекцииТаблицыИзХвостаИмени(ХвостИмени)
	
	// 0420409_2-lab.xml / 0420459_2_1-rend.xml -> цифры и _
	Результат = "";
	Для Индекс = 1 По СтрДлина(ХвостИмени) Цикл
		Символ = Сред(ХвостИмени, Индекс, 1);
		Если СтрНайти("0123456789_", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;
	
	Пока СтрЗаканчиваетсяНа(Результат, "_") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	
	Если СтрДлина(Результат) >= 7 Тогда
		Возврат Результат;
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция КодФормыИзИмениФайлаТаблицы(ИмяФайла)
	
	// SR_0420409_m-rend.xml -> 0420409
	Имя = Строка(ИмяФайла);
	Позиция = СтрНайти(Имя, "SR_");
	Если Позиция = 0 Тогда
		Позиция = СтрНайти(ВРег(Имя), "SR_");
	КонецЕсли;
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Хвост = Сред(Имя, Позиция + 3);
	Код = "";
	Для Индекс = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Код = Код + Символ;
	КонецЦикла;
	
	Если СтрДлина(Код) >= 7 Тогда
		Возврат Код;
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ПрочитатьМетаданныеТаблицыRend(ПутьКФайлу)
	
	Результат = Новый Структура;
	Результат.Вставить("УзлыКонцептов", Новый Соответствие); // id -> concept
	Результат.Вставить("ПорядокКонцептов", Новый Массив);
	
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(ПутьКФайлу);
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	УзлыКонцептов = Результат.УзлыКонцептов;
	Абстрактные = Новый Соответствие; // id -> Истина
	МеткаВИд = Новый Соответствие; // xlink:label -> id
	ДугаПорядка = Новый Массив; // Структура(Порядок, Куда) от breakdown
	ДетиУзлов = Новый Соответствие; // parent id -> Массив Structural(Порядок, Ребенок)
	
	ТекущийИдУзла = "";
	ВнутриRuleNode = Ложь;
	
	Попытка
		
		Пока Чтение.Прочитать() Цикл
			
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				
				Имя = Чтение.ЛокальноеИмя;
				
				Если Имя = "ruleNode" Тогда
					ТекущийИдУзла = ЗначениеАтрибутаЧтенияXML(Чтение, "id");
					МеткаУзла = ЗначениеАтрибутаЧтенияXML(Чтение, "label");
					Если Не ЗначениеЗаполнено(МеткаУзла) Тогда
						МеткаУзла = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:label");
					КонецЕсли;
					Абстракт = НРег(ЗначениеАтрибутаЧтенияXML(Чтение, "abstract")) = "true";
					ВнутриRuleNode = ЗначениеЗаполнено(ТекущийИдУзла);
					Если ВнутриRuleNode Тогда
						Если ЗначениеЗаполнено(МеткаУзла) Тогда
							МеткаВИд.Вставить(МеткаУзла, ТекущийИдУзла);
						КонецЕсли;
						Если Абстракт Тогда
							Абстрактные.Вставить(ТекущийИдУзла, Истина);
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли ВнутриRuleNode И Имя = "qname" Тогда
					ТекстQName = ПрочитатьТекстЭлементаXML(Чтение, Имя);
					ИмяКонцепта = ЛокальноеИмяИзQName(ТекстQName);
					Если ЗначениеЗаполнено(ТекущийИдУзла) И ЗначениеЗаполнено(ИмяКонцепта) Тогда
						УзлыКонцептов.Вставить(ТекущийИдУзла, ИмяКонцепта);
					КонецЕсли;
					
				ИначеЕсли Имя = "breakdownTreeArc" Тогда
					Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "from");
					Если Не ЗначениеЗаполнено(Откуда) Тогда
						Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:from");
					КонецЕсли;
					Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "to");
					Если Не ЗначениеЗаполнено(Куда) Тогда
						Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:to");
					КонецЕсли;
					ПорядокТекст = ЗначениеАтрибутаЧтенияXML(Чтение, "order");
					Порядок = 0;
					Если ЗначениеЗаполнено(ПорядокТекст) Тогда
						Попытка
							Порядок = Число(СтрЗаменить(ПорядокТекст, ",", "."));
						Исключение
							Порядок = 0;
						КонецПопытки;
					КонецЕсли;
					Если Откуда = "breakdown" Тогда
						// основной breakdown колонок (не breakdown_2 оси строк)
						ДугаПорядка.Добавить(Новый Структура("Порядок, Куда", Порядок, Куда));
					КонецЕсли;
					
				ИначеЕсли Имя = "definitionNodeSubtreeArc" Тогда
					Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "from");
					Если Не ЗначениеЗаполнено(Откуда) Тогда
						Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:from");
					КонецЕсли;
					Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "to");
					Если Не ЗначениеЗаполнено(Куда) Тогда
						Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:to");
					КонецЕсли;
					ПорядокТекст = ЗначениеАтрибутаЧтенияXML(Чтение, "order");
					Порядок = 0;
					Если ЗначениеЗаполнено(ПорядокТекст) Тогда
						Попытка
							Порядок = Число(СтрЗаменить(ПорядокТекст, ",", "."));
						Исключение
							Порядок = 0;
						КонецПопытки;
					КонецЕсли;
					ИдРодителя = МеткаВИд.Получить(Откуда);
					Если Не ЗначениеЗаполнено(ИдРодителя) Тогда
						ИдРодителя = Откуда;
					КонецЕсли;
					ИдРебенка = МеткаВИд.Получить(Куда);
					Если Не ЗначениеЗаполнено(ИдРебенка) Тогда
						ИдРебенка = Куда;
					КонецЕсли;
					СписокДетей = ДетиУзлов.Получить(ИдРодителя);
					Если СписокДетей = Неопределено Тогда
						СписокДетей = Новый Массив;
						ДетиУзлов.Вставить(ИдРодителя, СписокДетей);
					КонецЕсли;
					СписокДетей.Добавить(Новый Структура("Порядок, Ребенок", Порядок, ИдРебенка));
					
				КонецЕсли;
				
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				
				Если Чтение.ЛокальноеИмя = "ruleNode" Тогда
					ВнутриRuleNode = Ложь;
					ТекущийИдУзла = "";
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Чтение.Закрыть();
		
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	// сортировка дуг колонок
	СписокДуг = Новый СписокЗначений;
	Для Каждого Дуга Из ДугаПорядка Цикл
		СписокДуг.Добавить(Дуга, Формат(Дуга.Порядок, "ЧЦ=12; ЧВН=; ЧДЦ=3; ЧРД=.; ЧГ=0"));
	КонецЦикла;
	СписокДуг.СортироватьПоПредставлению();
	
	ПорядокКонцептов = Результат.ПорядокКонцептов;
	Для Каждого ЭлементДуги Из СписокДуг Цикл
		Дуга = ЭлементДуги.Значение;
		ИдУзла = МеткаВИд.Получить(Дуга.Куда);
		Если Не ЗначениеЗаполнено(ИдУзла) Тогда
			ИдУзла = Дуга.Куда;
		КонецЕсли;
		ДобавитьКонцептыУзлаВПорядок(ИдУзла, УзлыКонцептов, Абстрактные, ДетиУзлов, ПорядокКонцептов);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьКонцептыУзлаВПорядок(ИдУзла, УзлыКонцептов, Абстрактные, ДетиУзлов, ПорядокКонцептов)
	
	Если Абстрактные.Получить(ИдУзла) <> Неопределено Тогда
		СписокДетей = ДетиУзлов.Получить(ИдУзла);
		Если СписокДетей = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Список = Новый СписокЗначений;
		Для Каждого Ребенок Из СписокДетей Цикл
			Список.Добавить(Ребенок, Формат(Ребенок.Порядок, "ЧЦ=12; ЧВН=; ЧДЦ=3; ЧРД=.; ЧГ=0"));
		КонецЦикла;
		Список.СортироватьПоПредставлению();
		Для Каждого Элемент Из Список Цикл
			ДобавитьКонцептыУзлаВПорядок(
				Элемент.Значение.Ребенок,
				УзлыКонцептов,
				Абстрактные,
				ДетиУзлов,
				ПорядокКонцептов);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	ИмяКонцепта = УзлыКонцептов.Получить(ИдУзла);
	Если ЗначениеЗаполнено(ИмяКонцепта) Тогда
		ПорядокКонцептов.Добавить(ИмяКонцепта);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьФайлПодписейТаблицыТаксономии(ПутьКФайлу, УзлыКонцептов, Словарь)
	
	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.ОткрытьФайл(ПутьКФайлу);
	Исключение
		Возврат;
	КонецПопытки;
	
	Локаторы = Новый Соответствие; // xlink:label -> id ruleNode из href
	Ресурсы = Новый Соответствие; // xlink:label -> текст RU
	
	Попытка
		
		Пока Чтение.Прочитать() Цикл
			
			Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			
			Имя = Чтение.ЛокальноеИмя;
			
			Если Имя = "loc" Тогда
				Метка = ЗначениеАтрибутаЧтенияXML(Чтение, "label");
				Если Не ЗначениеЗаполнено(Метка) Тогда
					Метка = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:label");
				КонецЕсли;
				Href = ЗначениеАтрибутаЧтенияXML(Чтение, "href");
				Если Не ЗначениеЗаполнено(Href) Тогда
					Href = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:href");
				КонецЕсли;
				ИдУзла = ФрагментHrefТаксономии(Href);
				Если ЗначениеЗаполнено(Метка) И ЗначениеЗаполнено(ИдУзла) Тогда
					Локаторы.Вставить(Метка, ИдУзла);
				КонецЕсли;
				
			ИначеЕсли Имя = "label" Тогда
				
				Метка = ЗначениеАтрибутаЧтенияXML(Чтение, "label");
				Если Не ЗначениеЗаполнено(Метка) Тогда
					Метка = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:label");
				КонецЕсли;
				Язык = ЗначениеАтрибутаЧтенияXML(Чтение, "lang");
				Если Не ЗначениеЗаполнено(Язык) Тогда
					Язык = ЗначениеАтрибутаЧтенияXML(Чтение, "xml:lang");
				КонецЕсли;
				Текст = СокрЛП(ПрочитатьТекстЭлементаXML(Чтение, Имя));
				Если Не ЗначениеЗаполнено(Метка) Или Не ЗначениеЗаполнено(Текст) Тогда
					Продолжить;
				КонецЕсли;
				Если НРег(Строка(Язык)) <> "ru" Тогда
					Продолжить;
				КонецЕсли;
				Если ЭтоТехническаяПодписьТаксономии(Текст) Тогда
					Продолжить;
				КонецЕсли;
				Ресурсы.Вставить(Метка, Текст);
				
			ИначеЕсли Имя = "arc" Или Имя = "labelArc" Тогда
				
				Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "from");
				Если Не ЗначениеЗаполнено(Откуда) Тогда
					Откуда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:from");
				КонецЕсли;
				Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "to");
				Если Не ЗначениеЗаполнено(Куда) Тогда
					Куда = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:to");
				КонецЕсли;
				
				ИдУзла = Локаторы.Получить(Откуда);
				Текст = Ресурсы.Получить(Куда);
				Если Не ЗначениеЗаполнено(ИдУзла) Или Не ЗначениеЗаполнено(Текст) Тогда
					Продолжить;
				КонецЕсли;
				
				ИмяКонцепта = УзлыКонцептов.Получить(ИдУзла);
				Если Не ЗначениеЗаполнено(ИмяКонцепта) Тогда
					Продолжить;
				КонецЕсли;
				
				// подписи таблицы ЦБ (как в эталоне Excel) - высший приоритет
				ЗаписатьПодписьВСловарь(Словарь, ИмяКонцепта, Текст, 95);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Чтение.Закрыть();
		
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;
	
КонецПроцедуры

