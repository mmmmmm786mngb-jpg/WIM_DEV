Процедура УпорядочитьКолонкиЛиста(Корзина)
	
	Итоговые = Новый Массив;
	Итоговые.Добавить("Period");
	
	TypedLike = Новый Массив;
	Прочие = Новый Массив;
	
	Для Каждого ИмяКол Из Корзина.Columns Цикл
		Если ИмяКол = "Period" Или ИмяКол = "ContextId" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(ИмяКол, "ID") Или СтрНачинаетсяС(ИмяКол, "Rek") Или СтрНачинаетсяС(ИмяКол, "Id") Тогда
			TypedLike.Добавить(ИмяКол);
		Иначе
			Прочие.Добавить(ИмяКол);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяКол Из TypedLike Цикл
		Итоговые.Добавить(ИмяКол);
	КонецЦикла;
	Для Каждого ИмяКол Из Прочие Цикл
		Итоговые.Добавить(ИмяКол);
	КонецЦикла;
	
	Корзина.Columns = Итоговые;
	
КонецПроцедуры

Процедура УпорядочитьКолонкиЛистаПоТаксономии(Корзина, ПорядокКолонокТаксономии)
	
	Если ПорядокКолонокТаксономии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Порядок = Неопределено;
	Для Каждого КлючТаблицы Из КандидатыКлючейМетаданныхЛиста(Корзина) Цикл
		Порядок = ПорядокКолонокТаксономии.Получить(КлючТаблицы);
		Если Порядок <> Неопределено И Порядок.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
		Порядок = Неопределено;
	КонецЦикла;
	
	Если Порядок = Неопределено Или Порядок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПолныйПорядок = Новый Массив;
	Если Корзина.IsBank Тогда
		ПолныйПорядок.Добавить("Rek_kred_org_i_scheta");
	Иначе
		ПолныйПорядок.Добавить("Period");
	КонецЕсли;
	Для Каждого ИмяКонцепта Из Порядок Цикл
		ПолныйПорядок.Добавить(ИмяКонцепта);
	КонецЦикла;
	
	УпорядочитьКолонкиЛистаПоСписку(Корзина, ПолныйПорядок);
	
КонецПроцедуры

Функция КодФормыИзЗаголовкаЛиста(Заголовок)
	
	Текст = СокрЛП(Строка(Заголовок));
	Код = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Если Код = "" Тогда
				Продолжить;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Код = Код + Символ;
		Если СтрДлина(Код) >= 7 Тогда
			Возврат Код;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрДлина(Код) >= 7 Тогда
		Возврат Код;
	КонецЕсли;
	Возврат "";
	
КонецФункции

// Описание: Кандидаты ключей метаданных листа: TableKey EP, секция (_2/_r2), код формы
// Порядок: сначала специфичные ключи раздела, затем общие
//
Функция КандидатыКлючейМетаданныхЛиста(Корзина)
	
	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	
	ТаблицаКлюч = "";
	Если Корзина.Свойство("TableKey") И ЗначениеЗаполнено(Корзина.TableKey) Тогда
		ТаблицаКлюч = Строка(Корзина.TableKey);
	КонецЕсли;
	
	КодФормы = КодФормыИзЗаголовкаЛиста(Корзина.Name);
	Если Не ЗначениеЗаполнено(КодФормы) Тогда
		КодФормы = КодФормыИзЗаголовкаЛиста(Корзина.Toc);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КодФормы) И ЗначениеЗаполнено(ТаблицаКлюч) Тогда
		КодФормы = КодФормыИзИмениФайлаТаблицы(ТаблицаКлюч);
	КонецЕсли;
	
	Текст = НРег(Строка(Корзина.Name) + " " + Строка(Корзина.Toc) + " " + ТаблицаКлюч);
	ЭтоРаздел2 = СтрНайти(Текст, "раздел 2") > 0
		Или СтрНайти(Текст, "_r2") > 0
		Или (ЗначениеЗаполнено(ТаблицаКлюч) И СтрЧислоВхождений(ВРег(ТаблицаКлюч), "SR_") >= 2);
	
	Если ЗначениеЗаполнено(ТаблицаКлюч) Тогда
		ДобавитьУникальныйКлючВМассив(Результат, Добавленные, ТаблицаКлюч);
		Для Каждого Алиас Из КлючиМетаданныхТаблицыИзИмениФайла(ТаблицаКлюч) Цикл
			ДобавитьУникальныйКлючВМассив(Результат, Добавленные, Алиас);
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтоРаздел2 И ЗначениеЗаполнено(КодФормы) Тогда
		ДобавитьУникальныйКлючВМассив(Результат, Добавленные, КодФормы + "_2");
		ДобавитьУникальныйКлючВМассив(Результат, Добавленные, КодФормы + "_r2");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодФормы) Тогда
		ДобавитьУникальныйКлючВМассив(Результат, Добавленные, КодФормы);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьУникальныйКлючВМассив(МассивКлючей, Добавленные, Ключ)
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;
	Если Добавленные.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивКлючей.Добавить(Ключ);
	Добавленные.Вставить(Ключ, Истина);
	
КонецПроцедуры

Процедура УпорядочитьКолонкиЛистаПоСписку(Корзина, ПорядокБазовыхИмен)
	
	Использованные = Новый Соответствие;
	Итоговые = Новый Массив;
	
	Для Каждого БазовоеИмя Из ПорядокБазовыхИмен Цикл
		Подходящие = Новый Массив;
		Для Каждого ИмяКол Из Корзина.Columns Цикл
			Если Использованные.Получить(ИмяКол) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ИмяКол = БазовоеИмя Или СтрНачинаетсяС(ИмяКол, БазовоеИмя + "_") Тогда
				Подходящие.Добавить(ИмяКол);
			КонецЕсли;
		КонецЦикла;
		
		Если Подходящие.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Список = Новый СписокЗначений;
		Для Каждого ИмяКол Из Подходящие Цикл
			Список.Добавить(ИмяКол, ИмяКол);
		КонецЦикла;
		Список.СортироватьПоПредставлению();
		
		// для повторяющегося базового имени (два DSKO_BB) берем по одной колонке за раз
		ЧислоПовторовБазы = 0;
		Для Каждого Проверка Из ПорядокБазовыхИмен Цикл
			Если Проверка = БазовоеИмя Тогда
				ЧислоПовторовБазы = ЧислоПовторовБазы + 1;
			КонецЕсли;
		КонецЦикла;
		
		БратьОдну = ЧислоПовторовБазы > 1 И Подходящие.Количество() > 1;
		Если БратьОдну Тогда
			ИмяКол = Список[0].Значение;
			Итоговые.Добавить(ИмяКол);
			Использованные.Вставить(ИмяКол, Истина);
		Иначе
			Для Каждого Элемент Из Список Цикл
				Итоговые.Добавить(Элемент.Значение);
				Использованные.Вставить(Элемент.Значение, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяКол Из Корзина.Columns Цикл
		Если Использованные.Получить(ИмяКол) = Неопределено Тогда
			Итоговые.Добавить(ИмяКол);
			Использованные.Вставить(ИмяКол, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Корзина.Columns = Итоговые;
	Корзина.ColSet = Новый Соответствие;
	Для Каждого ИмяКол Из Итоговые Цикл
		Корзина.ColSet.Вставить(ИмяКол, Истина);
	КонецЦикла;
	
КонецПроцедуры

// Описание: Записывает листы в XLSX (ПакетОтображаемыхДокументов + гиперссылки TOC)
//
// Параметры:
// Листы - Соответствие - корзины листов из СобратьЛистыИзДанныхXBRL
// ДанныеXBRL - Структура - данные instance (для TOC/шапки)
// ВремяНачалаМс - Число - метка старта для прогресса
// СловарьПодписей - Соответствие, Неопределено - общие подписи
// РежимТаксономии - Булево - русские заголовки из таксономии
// ПодписиТаблиц - Соответствие, Неопределено - подписи по ключу таблицы
// Хронометраж - Соответствие, Неопределено - накопление длительностей этапов
//
// Возвращаемое значение:
// ДвоичныеДанные - содержимое .xlsx
//
Функция ЗаписатьЛистыВXLSX(Листы, ДанныеXBRL, ВремяНачалаМс = 0, СловарьПодписей = Неопределено, РежимТаксономии = Ложь, ПодписиТаблиц = Неопределено, Хронометраж = Неопределено)
	
	Пакет = Новый ПакетОтображаемыхДокументов;
	
	Упорядоченные = УпорядоченныеКорзиныЛистов(Листы);
	ВсегоЛистов = Упорядоченные.Количество();
	
	МеткаЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТабTOC = СформироватьЛистTOC(Упорядоченные, ДанныеXBRL, РежимТаксономии);
	ДобавитьЛистВПакет(Пакет, "TOC", ТабTOC);
	
	НомерЛиста = 0;
	Для Каждого Корзина Из Упорядоченные Цикл
		НомерЛиста = НомерЛиста + 1;
		Если ВсегоЛистов > 0 И (НомерЛиста = 1 Или НомерЛиста % 3 = 0 Или НомерЛиста = ВсегоЛистов) Тогда
			ТекстЛиста = СтрШаблон(
				"Лист %1/%2: %3",
				Формат(НомерЛиста, "ЧГ=0"),
				Формат(ВсегоЛистов, "ЧГ=0"),
				Корзина.Name);
			// диапазон этапа записи: 75..95%
			Процент = 75 + Цел(20 * НомерЛиста / ВсегоЛистов);
			СообщитьПрогрессАбсолютный(Процент, ТекстЛиста, ВремяНачалаМс);
		КонецЕсли;
		ПодписиТаблицы = ПодписиТаблицыДляЛиста(Корзина, ПодписиТаблиц);
		ТабДок = СформироватьТабличныйДокументЛиста(
			Корзина,
			ДанныеXBRL,
			СловарьПодписей,
			РежимТаксономии,
			ПодписиТаблицы);
		ДобавитьЛистВПакет(Пакет, Корзина.Name, ТабДок);
	КонецЦикла;
	МеткаЭтапа = ЗафиксироватьЭтапХронометража(Хронометраж, "Формирование листов Excel", МеткаЭтапа);
	
	СообщитьПрогрессАбсолютный(96, "Запись файла XLSX на диск", ВремяНачалаМс);
	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	Попытка
		Пакет.Записать(ИмяФайла, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
		МеткаЭтапа = ЗафиксироватьЭтапХронометража(Хронометраж, "Запись пакета XLSX", МеткаЭтапа);
		СообщитьПрогрессАбсолютный(97, "Постобработка XLSX (TOC, merge)", ВремяНачалаМс);
		ДобавитьГиперссылкиНавигацииTocВXLSX(ИмяФайла, Упорядоченные);
		МеткаЭтапа = ЗафиксироватьЭтапХронометража(Хронометраж, "Постобработка XLSX", МеткаЭтапа);
		ДвоичныеДанные = ПрочитатьФайлВДвоичныеДанныеЧерезПоток(ИмяФайла);
		ЗафиксироватьЭтапХронометража(Хронометраж, "Чтение XLSX в память", МеткаЭтапа);
		УдалитьФайлы(ИмяФайла);
		Возврат ДвоичныеДанные;
	Исключение
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

Функция УпорядоченныеКорзиныЛистов(Листы)
	
	Список = Новый СписокЗначений;
	Для Каждого КЗ Из Листы Цикл
		Список.Добавить(КЗ.Значение, КЗ.Значение.Name);
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	
	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция СформироватьЛистTOC(Упорядоченные, ДанныеXBRL, РежимТаксономии = Ложь)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Область(1, 1).Текст = ДанныеXBRL.SchemaRef;
	ТабДок.Область(3, 1).Текст = "Generator";
	ТабДок.Область(3, 2).Текст = "внВыгрузкаXBRLОртиконВXLSX v" + ВерсияОбработки()
		+ ?(РежимТаксономии, " (taxonomy labels)", " (1C only)");
	ТабДок.Область(5, 1).Текст = "No.";
	ТабДок.Область(5, 2).Текст = "table";
	ТабДок.Область(5, 3).Текст = "description";
	ОформитьЗаголовок(ТабДок, 5, 3);
	
	Номер = 1;
	НомерСтроки = 6;
	
	Для Каждого Корзина Из Упорядоченные Цикл
		ТабДок.Область(НомерСтроки, 1).Текст = Формат(Номер, "ЧГ=0");
		ОбластьИмени = ТабДок.Область(НомерСтроки, 2);
		ОбластьИмени.Текст = Корзина.Name;
		ОформитьЯчейкуКакГиперссылку(ОбластьИмени);
		ТабДок.Область(НомерСтроки, 3).Текст = Корзина.Toc
			+ " [" + Формат(Корзина.Rows.Количество(), "ЧН=0; ЧГ=0") + " строк]";
		Номер = Номер + 1;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Функция ПодписиТаблицыДляЛиста(Корзина, ПодписиТаблиц)
	
	Если ПодписиТаблиц = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого КлючТаблицы Из КандидатыКлючейМетаданныхЛиста(Корзина) Цикл
		Словарь = ПодписиТаблиц.Получить(КлючТаблицы);
		Если Словарь <> Неопределено Тогда
			Возврат Словарь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция СформироватьТабличныйДокументЛиста(Корзина, ДанныеXBRL = Неопределено, СловарьПодписей = Неопределено, РежимТаксономии = Ложь, ПодписиТаблицы = Неопределено)
	
	ТабДок = Новый ТабличныйДокумент;
	Колонки = Корзина.Columns;
	КоличествоКолонок = Колонки.Количество();
	
	Если КоличествоКолонок = 0 Тогда
		Если РежимТаксономии Тогда
			ОбластьToc = ТабДок.Область(1, 1);
			ОбластьToc.Текст = "TOC";
			ОформитьЯчейкуКакГиперссылку(ОбластьToc);
			ТабДок.Область(2, 1).Текст = Корзина.Name;
		Иначе
			ТабДок.Область(1, 1).Текст = Корзина.Name;
		КонецЕсли;
		Возврат ТабДок;
	КонецЕсли;
	
	НомерСтрокиЗаголовка = 1;
	Если РежимТаксономии Тогда
		ОбластьToc = ТабДок.Область(1, 1);
		ОбластьToc.Текст = "TOC";
		ОформитьЯчейкуКакГиперссылку(ОбластьToc);
		ТабДок.Область(2, 1).Текст = Корзина.Toc;
		Если ДанныеXBRL <> Неопределено Тогда
			ТабДок.Область(3, 1).Текст = ДанныеXBRL.SchemaRef;
		КонецЕсли;
		ТабДок.Область(4, 1).Текст = "Generator: внВыгрузкаXBRLОртиконВXLSX v"
			+ ВерсияОбработки() + " + taxonomy labels";
		НомерСтрокиЗаголовка = 6;
	КонецЕсли;
	
	Для Индекс = 0 По КоличествоКолонок - 1 Цикл
		ИмяКол = Колонки[Индекс];
		ТекстЗаголовка = ПодписьКолонкиПоТаксономии(ИмяКол, СловарьПодписей, ПодписиТаблицы);
		ТабДок.Область(НомерСтрокиЗаголовка, Индекс + 1).Текст = ТекстЗаголовка;
	КонецЦикла;
	ОформитьЗаголовок(ТабДок, НомерСтрокиЗаголовка, КоличествоКолонок);
	
	НомерСтроки = НомерСтрокиЗаголовка + 1;
	Для Каждого СтрокаДанных Из Корзина.Rows Цикл
		Для Индекс = 0 По КоличествоКолонок - 1 Цикл
			ИмяКол = Колонки[Индекс];
			Значение = СтрокаДанных.Получить(ИмяКол);
			ЗаписатьЗначениеВЯчейку(ТабДок.Область(НомерСтроки, Индекс + 1), Значение, ИмяКол);
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ТабДок.ФиксацияСверху = НомерСтрокиЗаголовка;
	Возврат ТабДок;
	
КонецФункции

Процедура ЗаписатьЗначениеВЯчейку(Область, Значение, ИмяКолонки = "")
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Область.СодержитЗначение = Ложь;
		Область.Текст = "";
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если ЭтоИдентификаторнаяКолонкаExcel(ИмяКолонки) Тогда
			Область.СодержитЗначение = Ложь;
			Область.Текст = Формат(Значение, "ЧГ=0");
			Возврат;
		КонецЕсли;
		ЗаписатьЧислоВЯчейкуExcel(Область, Значение);
		Возврат;
	КонецЕсли;
	
	Текст = СокрЛП(Строка(Значение));
	Если Текст = "" Тогда
		Область.СодержитЗначение = Ложь;
		Область.Текст = "";
		Возврат;
	КонецЕсли;
	
	// счет / ИНН / код - всегда текст (как в эталоне ЦБ); числа только денежные DSKO_*
	Если Не ЭтоЧисловаяКолонкаExcel(ИмяКолонки) Тогда
		Область.СодержитЗначение = Ложь;
		Область.Текст = Текст;
		Возврат;
	КонецЕсли;
	
	ТекстЧисла = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.НПП, ""), " ", ""), ",", ".");
	Попытка
		Числовое = Число(ТекстЧисла);
		ЗаписатьЧислоВЯчейкуExcel(Область, Числовое);
		Возврат;
	Исключение
		Область.СодержитЗначение = Ложь;
		Область.Текст = Текст;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьЧислоВЯчейкуExcel(Область, ЧисловоеЗначение)
	
	// число как в эталоне: без разделителей триад, точка как десятичный, до 2 знаков
	Область.СодержитЗначение = Истина;
	Область.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(32, 2));
	Область.Значение = ЧисловоеЗначение;
	Область.Формат = "ЧДЦ=2; ЧРД=.; ЧГ=0";
	
КонецПроцедуры

Функция ЭтоЧисловаяКолонкаExcel(ИмяКолонки)
	
	Имя = Строка(ИмяКолонки);
	Возврат СтрНачинаетсяС(Имя, "DSKO_");
	
КонецФункции

Функция ЭтоИдентификаторнаяКолонкаExcel(ИмяКолонки)
	
	Имя = Строка(ИмяКолонки);
	ИмяНРег = НРег(Имя);
	Возврат СтрНачинаетсяС(Имя, "Rek_")
		Или СтрНачинаетсяС(Имя, "Nom_")
		Или СтрНачинаетсяС(Имя, "INN")
		Или СтрНайти(ИмяНРег, "inn") > 0
		Или СтрНайти(ИмяНРег, "schet") > 0
		Или СтрНайти(ИмяНРег, "bik") > 0;
	
КонецФункции

Процедура ДобавитьЛистВПакет(Пакет, ИмяЛиста, ТабличныйДокумент)
	
	ЭлементПакета = Пакет.Состав.Добавить();
	ЭлементПакета.Наименование = ИмяЛиста;
	ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(ТабличныйДокумент);
	
КонецПроцедуры

Процедура ОформитьЯчейкуКакГиперссылку(Область)
	
	Попытка
		Область.Шрифт.Подчеркивание = Истина;
		Область.ЦветТекста = WebЦвета.Синий;
	Исключение
		// оформление необязательно
	КонецПопытки;
	
КонецПроцедуры

// Описание: Постобработка XLSX после ПакетОтображаемыхДокументов:
// 1) убирает артефактные mergeCells (длинный заголовок в последней колонке);
// 2) добавляет внутренние гиперссылки TOC <-> листы (как в эталоне ЦБ).
//
// Параметры:
// ПутьКФайлуXLSX - Строка - путь к уже записанному .xlsx
// Упорядоченные - Массив - корзины листов в том же порядке, что в TOC (со строки 6)
//
Процедура ДобавитьГиперссылкиНавигацииTocВXLSX(ПутьКФайлуXLSX, Упорядоченные)
	
	Если Не ЗначениеЗаполнено(ПутьКФайлуXLSX) Тогда
		Возврат;
	КонецЕсли;
	
	КаталогРаспаковки = КаталогВременныхФайлов() + "xbrl_xlsx_nav_"
		+ СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	СоздатьКаталог(КаталогРаспаковки);
	ИмяНовогоАрхива = "";
	
	Попытка
		
		ЧтениеАрхива = Новый ЧтениеZipФайла(ПутьКФайлуXLSX);
		ЧтениеАрхива.ИзвлечьВсе(КаталогРаспаковки, РежимВосстановленияПутейФайловZIP.Восстанавливать);
		ЧтениеАрхива.Закрыть();
		
		// артефакт экспорта: merge последней колонки заголовка в пустые ячейки справа
		УдалитьАртефактныеMergeCellsВКаталогеXLSX(КаталогРаспаковки);
		
		Если Упорядоченные <> Неопределено И Упорядоченные.Количество() > 0 Тогда
			
			КартаЛистов = КартаИменЛистовКФайламWorksheetXLSX(КаталогРаспаковки);
			ПутьTOC = КартаЛистов.Получить("TOC");
			Если ЗначениеЗаполнено(ПутьTOC) Тогда
				
				// TOC -> листы (колонка B, строки с 6)
				ЧастиToc = Новый Массив;
				ЧастиToc.Добавить("<hyperlinks>");
				НомерСтроки = 6;
				Для Каждого Корзина Из Упорядоченные Цикл
					ИмяЛиста = Строка(Корзина.Name);
					Если КартаЛистов.Получить(ИмяЛиста) = Неопределено Тогда
						НомерСтроки = НомерСтроки + 1;
						Продолжить;
					КонецЕсли;
					ЧастиToc.Добавить("<hyperlink ref=""B"
						+ Формат(НомерСтроки, "ЧГ=0")
						+ """ location="""
						+ ЭкранироватьАтрибутXML(ЛокацияВнутреннейГиперссылкиExcel(ИмяЛиста))
						+ """/>");
					НомерСтроки = НомерСтроки + 1;
				КонецЦикла;
				ЧастиToc.Добавить("</hyperlinks>");
				ВставитьБлокHyperlinksВWorksheetXml(ПутьTOC, СтрСоединить(ЧастиToc, ""));
				
				// листы -> TOC (ячейка A1)
				БлокОбратно = "<hyperlinks><hyperlink ref=""A1"" location="""
					+ ЭкранироватьАтрибутXML(ЛокацияВнутреннейГиперссылкиExcel("TOC"))
					+ """/></hyperlinks>";
				Для Каждого Корзина Из Упорядоченные Цикл
					ПутьЛиста = КартаЛистов.Получить(Строка(Корзина.Name));
					Если Не ЗначениеЗаполнено(ПутьЛиста) Тогда
						Продолжить;
					КонецЕсли;
					ВставитьБлокHyperlinksВWorksheetXml(ПутьЛиста, БлокОбратно);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ИмяНовогоАрхива = ПолучитьИмяВременногоФайла("xlsx");
		ЗаписьАрхива = Новый ЗаписьZipФайла(ИмяНовогоАрхива);
		// пути в архиве - относительно КаталогРаспаковки (без смены текущего каталога:
		// ТекущийКаталог/УстановитьТекущийКаталог на сервере недоступны)
		ЗаписьАрхива.Добавить(
			КаталогРаспаковки + ПолучитьРазделительПути() + "*.*",
			РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
			РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		ЗаписьАрхива.Записать();
		
		ДвоичныеНового = Новый ДвоичныеДанные(ИмяНовогоАрхива);
		ДвоичныеНового.Записать(ПутьКФайлуXLSX);
		УдалитьФайлы(ИмяНовогоАрхива);
		ИмяНовогоАрхива = "";
		
		УдалитьФайлы(КаталогРаспаковки);
		
	Исключение
		Попытка
			УдалитьФайлы(КаталогРаспаковки);
		Исключение
		КонецПопытки;
		Если ЗначениеЗаполнено(ИмяНовогоАрхива) Тогда
			Попытка
				УдалитьФайлы(ИмяНовогоАрхива);
			Исключение
			КонецПопытки;
		КонецЕсли;
		// постобработка необязательна: файл без ссылок/с merge уже записан
	КонецПопытки;
	
КонецПроцедуры

// Описание: Удаляет блоки mergeCells из всех worksheet OpenXML
// Платформа при экспорте может объединить длинный многострочный заголовок
// последней колонки с пустыми ячейками справа - ломает автофильтр и вид эталона.
//
Процедура УдалитьАртефактныеMergeCellsВКаталогеXLSX(КаталогРаспаковки)
	
	Разделитель = ПолучитьРазделительПути();
	КаталогЛистов = КаталогРаспаковки + Разделитель + "xl" + Разделитель + "worksheets";
	ФайлКаталога = Новый Файл(КаталогЛистов);
	Если Не ФайлКаталога.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	Найденные = НайтиФайлы(КаталогЛистов, "*.xml", Ложь);
	Для Каждого ФайлЛиста Из Найденные Цикл
		УдалитьБлокMergeCellsИзWorksheetXml(ФайлЛиста.ПолноеИмя);
	КонецЦикла;
	
КонецПроцедуры

// Описание: Вырезает из worksheet.xml все блоки <mergeCells>...</mergeCells>
//
Процедура УдалитьБлокMergeCellsИзWorksheetXml(ПутьКФайлу)
	
	Текст = ПрочитатьТекстФайлаUTF8(ПутьКФайлу);
	Если СтрНайти(Текст, "<mergeCells") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Изменен = Ложь;
	Пока Истина Цикл
		
		Позиция = СтрНайти(Текст, "<mergeCells");
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПозицияЗакрытия = СтрНайти(Текст, "</mergeCells>", , Позиция);
		Если ПозицияЗакрытия > 0 Тогда
			КонецБлока = ПозицияЗакрытия + СтрДлина("</mergeCells>");
			Текст = Лев(Текст, Позиция - 1) + Сред(Текст, КонецБлока);
			Изменен = Истина;
			Продолжить;
		КонецЕсли;
		
		// самозакрывающийся тег <mergeCells .../>
		ПозицияКонцаТега = СтрНайти(Текст, "/>", , Позиция);
		Если ПозицияКонцаТега = 0 Тогда
			Прервать;
		КонецЕсли;
		Текст = Лев(Текст, Позиция - 1) + Сред(Текст, ПозицияКонцаТега + 2);
		Изменен = Истина;
		
	КонецЦикла;
	
	Если Изменен Тогда
		ЗаписатьТекстФайлаUTF8(ПутьКФайлу, Текст);
	КонецЕсли;
	
КонецПроцедуры

Функция КартаИменЛистовКФайламWorksheetXLSX(КаталогРаспаковки)
	
	Результат = Новый Соответствие;
	Разделитель = ПолучитьРазделительПути();
	ПутьWorkbook = КаталогРаспаковки + Разделитель + "xl" + Разделитель + "workbook.xml";
	ПутьRels = КаталогРаспаковки + Разделитель + "xl" + Разделитель + "_rels"
		+ Разделитель + "workbook.xml.rels";
	
	ФайлWb = Новый Файл(ПутьWorkbook);
	ФайлRels = Новый Файл(ПутьRels);
	Если Не ФайлWb.Существует() Или Не ФайлRels.Существует() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстWb = ПрочитатьТекстФайлаUTF8(ПутьWorkbook);
	ТекстRels = ПрочитатьТекстФайлаUTF8(ПутьRels);
	
	RIdВФайл = Новый Соответствие;
	Позиция = 1;
	Пока Истина Цикл
		ПозицияRel = СтрНайти(ТекстRels, "<Relationship ", , Позиция);
		Если ПозицияRel = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияКонца = СтрНайти(ТекстRels, "/>", , ПозицияRel);
		Если ПозицияКонца = 0 Тогда
			Прервать;
		КонецЕсли;
		Фрагмент = Сред(ТекстRels, ПозицияRel, ПозицияКонца - ПозицияRel + 2);
		Ид = ЗначениеАтрибутаИзФрагментаXml(Фрагмент, "Id");
		Цель = ЗначениеАтрибутаИзФрагментаXml(Фрагмент, "Target");
		ТипСвязи = ЗначениеАтрибутаИзФрагментаXml(Фрагмент, "Type");
		Если ЗначениеЗаполнено(Ид)
			И ЗначениеЗаполнено(Цель)
			И СтрНайти(НРег(ТипСвязи), "/worksheet") > 0 Тогда
			ЦельНорм = СтрЗаменить(Цель, "/", Разделитель);
			Если СтрНачинаетсяС(ЦельНорм, "worksheets") Или СтрНачинаетсяС(ЦельНорм, "xl") Тогда
				ПутьЛиста = КаталогРаспаковки + Разделитель + "xl" + Разделитель + ЦельНорм;
				Если СтрНачинаетсяС(ЦельНорм, "xl" + Разделитель) Тогда
					ПутьЛиста = КаталогРаспаковки + Разделитель + ЦельНорм;
				КонецЕсли;
			Иначе
				ПутьЛиста = КаталогРаспаковки + Разделитель + "xl" + Разделитель + "worksheets"
					+ Разделитель + ЦельНорм;
			КонецЕсли;
			RIdВФайл.Вставить(Ид, ПутьЛиста);
		КонецЕсли;
		Позиция = ПозицияКонца + 2;
	КонецЦикла;
	
	Позиция = 1;
	Пока Истина Цикл
		ПозицияSheet = СтрНайти(ТекстWb, "<sheet ", , Позиция);
		Если ПозицияSheet = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияКонца = СтрНайти(ТекстWb, "/>", , ПозицияSheet);
		Если ПозицияКонца = 0 Тогда
			Прервать;
		КонецЕсли;
		Фрагмент = Сред(ТекстWb, ПозицияSheet, ПозицияКонца - ПозицияSheet + 2);
		ИмяЛиста = ЗначениеАтрибутаИзФрагментаXml(Фрагмент, "name");
		ИдСвязи = ЗначениеАтрибутаИзФрагментаXml(Фрагмент, "r:id");
		Если Не ЗначениеЗаполнено(ИдСвязи) Тогда
			ИдСвязи = ЗначениеАтрибутаИзФрагментаXml(Фрагмент, "id");
		КонецЕсли;
		ПутьЛиста = RIdВФайл.Получить(ИдСвязи);
		Если ЗначениеЗаполнено(ИмяЛиста) И ЗначениеЗаполнено(ПутьЛиста) Тогда
			Результат.Вставить(ИмяЛиста, ПутьЛиста);
		КонецЕсли;
		Позиция = ПозицияКонца + 2;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ВставитьБлокHyperlinksВWorksheetXml(ПутьКФайлу, БлокHyperlinks)
	
	Если Не ЗначениеЗаполнено(БлокHyperlinks) Тогда
		Возврат;
	КонецЕсли;
	
	Текст = ПрочитатьТекстФайлаUTF8(ПутьКФайлу);
	Если СтрНайти(Текст, "<hyperlinks>") > 0 Тогда
		Возврат;
	КонецЕсли;
	
	// OOXML: hyperlinks должны быть ДО pageMargins/drawing.
	// Вставка перед </worksheet> ломает файл в Excel (хотя openpyxl может открыть).
	Позиция = 0;
	Маркеры = Новый Массив;
	Маркеры.Добавить("<pageMargins");
	Маркеры.Добавить("<printOptions");
	Маркеры.Добавить("<pageSetup");
	Маркеры.Добавить("<drawing");
	Маркеры.Добавить("<legacyDrawing");
	Маркеры.Добавить("</worksheet>");
	Маркеры.Добавить("</x:worksheet>");
	
	Для Каждого Маркер Из Маркеры Цикл
		Позиция = СтрНайти(Текст, Маркер);
		Если Позиция > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Текст = Лев(Текст, Позиция - 1) + БлокHyperlinks + Сред(Текст, Позиция);
	ЗаписатьТекстФайлаUTF8(ПутьКФайлу, Текст);
	
КонецПроцедуры

Функция ЛокацияВнутреннейГиперссылкиExcel(ИмяЛиста)
	
	// Excel: 'Имя листа'!A1 ; апостроф в имени удваивается
	Имя = СтрЗаменить(Строка(ИмяЛиста), "'", "''");
	Возврат "'" + Имя + "'!A1";
	
КонецФункции

Функция ЭкранироватьАтрибутXML(Значение)
	
	Текст = Строка(Значение);
	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Возврат Текст;
	
КонецФункции

Функция ЗначениеАтрибутаИзФрагментаXml(Фрагмент, ИмяАтрибута)
	
	Шаблон = ИмяАтрибута + "=""";
	Позиция = СтрНайти(Фрагмент, Шаблон);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = Позиция + СтрДлина(Шаблон);
	Остаток = Сред(Фрагмент, Начало);
	КонецКавычки = СтрНайти(Остаток, """");
	Если КонецКавычки = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(Остаток, КонецКавычки - 1);
	
КонецФункции

Функция ПрочитатьТекстФайлаUTF8(ПутьКФайлу)
	
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Попытка
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Если Текст = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		// убираем BOM, если платформа его вернула в тексте
		Если СтрДлина(Текст) > 0 И КодСимвола(Лев(Текст, 1)) = 65279 Тогда
			Текст = Сред(Текст, 2);
		КонецЕсли;
		Возврат Текст;
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

Процедура ЗаписатьТекстФайлаUTF8(ПутьКФайлу, Текст)
	
	// без BOM - иначе Excel может не открыть worksheet XML
	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8, Символы.ПС, Ложь);
	Попытка
		Запись.Записать(Текст);
		Запись.Закрыть();
	Исключение
		Запись.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ПрочитатьФайлВДвоичныеДанныеЧерезПоток(ИмяФайла)
	
	ЧтениеДанных = Новый ЧтениеДанных(ИмяФайла);
	Попытка
		Буфер = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных();
		ЧтениеДанных.Закрыть();
		Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
	Исключение
		ЧтениеДанных.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

Процедура СообщитьПрогрессЧтенияXBRL(СчетчикКонтекстов, СчетчикФактов, ВремяНачалаМс, Финал = Ложь)
	
	// чтение - самый долгий этап: держим процент в диапазоне 20..68
	Оценка = СчетчикКонтекстов + Цел(СчетчикФактов / 3);
	Процент = 20 + Цел(Оценка / 2500);
	Если Процент > 68 Тогда
		Процент = 68;
	КонецЕсли;
	Если Финал Тогда
		Процент = 68;
	КонецЕсли;
	
	Текст = СтрШаблон(
		"Чтение XBRL: контекстов %1, фактов %2",
		Формат(СчетчикКонтекстов, "ЧГ=0"),
		Формат(СчетчикФактов, "ЧГ=0"));
	СообщитьПрогрессАбсолютный(Процент, Текст, ВремяНачалаМс);
	
КонецПроцедуры

Процедура СообщитьПрогрессАбсолютный(Процент, ТекстЭтапа, ВремяНачалаМс = 0)
	
	Текст = ТекстЭтапа;
	
	Если ВремяНачалаМс > 0 Тогда
		ПрошлоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс;
		Если ПрошлоМс > 0 И Процент > 0 И Процент < 100 Тогда
			ОсталосьМс = Цел(ПрошлоМс * (100 - Процент) / Процент);
			Текст = СтрШаблон("%1. Осталось примерно %2", ТекстЭтапа, ПредставлениеИнтервалаМс(ОсталосьМс));
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		ДлительныеОперации.СообщитьПрогресс(Процент, Текст);
	Исключение
		// синхронный запуск или нет модуля БСП
	КонецПопытки;
	
КонецПроцедуры

Функция ПредставлениеИнтервалаМс(ИнтервалМс)
	
	ВсегоСекунд = Цел(ИнтервалМс / 1000);
	Если ВсегоСекунд < 1 Тогда
		Возврат "менее секунды";
	КонецЕсли;
	
	Минуты = Цел(ВсегоСекунд / 60);
	Секунды = ВсегоСекунд - Минуты * 60;
	
	Если Минуты = 0 Тогда
		Возврат СтрШаблон("%1 сек", Формат(Секунды, "ЧГ=0"));
	КонецЕсли;
	
	Возврат СтрШаблон("%1 мин %2 сек", Формат(Минуты, "ЧГ=0"), Формат(Секунды, "ЧГ=0"));
	
КонецФункции

#Область МаппингЛистов

// Описание: Заголовок и текст TOC листа по сигнатуре измерений (режим без таксономии)
//
// Параметры:
// SigKey - Строка - упорядоченные ключи осей через "|"
// Dims - Соответствие - измерения контекста (для уточнения заголовка)
//
// Возвращаемое значение:
// Структура - Title, Toc
//
Функция ОписаниеЛистаПоСигнатуре(SigKey, Dims)
	
	Результат = Новый Структура("Title, Toc", "", "");
	
	Если SigKey = "" Тогда
		Результат.Title = "Сопроводительная информация об";
		Результат.Toc = "Сопроводительная информация об отчитывающейся организации";
	ИначеЕсли SigKey = "OKUDAxis" Тогда
		Результат.Title = "Сопроводительная информация к о";
		Результат.Toc = "Сопроводительная информация к отчетности. Ответственные лица";
	ИначеЕсли SigKey = "Rek_kred_org_i_schetaTaxis" Тогда
		Результат.Title = "0420409 Раздел 1 Сведения о бан";
		Результат.Toc = "0420409 Раздел 1. Сведения о банковских счетах";
	ИначеЕсли SigKey = "ID_broker_kliringTaxis|ID_strokiTaxis" Тогда
		Результат.Title = "0420409 Раздел 2 Сведения о ден";
		Результат.Toc = "0420409 Раздел 2. ДС у брокера/клиринга";
	ИначеЕсли SigKey = "ID_strokiTaxis|Rek_Vyd_ZajmTaxis" Тогда
		Результат.Title = "0420414 Раздел 1 Выданные займы";
		Результат.Toc = "0420414 Раздел 1. Выданные займы";
	ИначеЕсли SigKey = "ID_strokiTaxis|Rek_Pol_Zajm_i_KredTaxis" Тогда
		Результат.Title = "0420414 Раздел 2. Полученные за";
		Результат.Toc = "0420414 Раздел 2. Полученные займы";
	// NOTE: SigKey только ID_strokiTaxis - листы документов/ответов (не TechnicalAxis/Итого).
	// TechnicalAxis в режиме таксономии матчится в EP по концептам, отдельный лист не создаётся.
	ИначеЕсли SigKey = "ID_strokiTaxis" Тогда
		Результат.Title = "Информация о документах включен";
		Результат.Toc = "Информация о документах, включенных в состав пакета с отчетностью";
	ИначеЕсли SigKey = "ID_strategTaxis" Тогда
		Результат.Title = "0420431 Раздел 1 Сведения об ос";
		Результат.Toc = "0420431 Раздел 1. Подраздел 1.1. Стратегии ДУ";
	ИначеЕсли SigKey = "ID_CzennojBumagiTaxis" Тогда
		Результат.Title = "0420459 Раздел 1 Сведения о цен";
		Результат.Toc = "0420459 Раздел 1.1. Сведения о ценных бумагах";
	ИначеЕсли ЭтоСигнатураПортфеляЦБ(SigKey) Тогда
		Если ЭтоБрокер(Dims) Тогда
			Результат.Title = "0420431 Раздел 4 Сведения о пор";
			Результат.Toc = "0420431 Раздел 4. Портфель ЦБ (брокер)";
		Иначе
			Результат.Title = "0420431 Раздел 4 Сведения о п_1";
			Результат.Toc = "0420431 Раздел 4. Портфель ЦБ (ДУ)";
		КонецЕсли;
	ИначеЕсли ЭтоСигнатураПортфеляДС(SigKey) Тогда
		Если ЭтоБрокер(Dims) Тогда
			Результат.Title = "0420431 Раздел 2 Сведения о пор";
			Результат.Toc = "0420431 Раздел 2. Портфель ДС (брокер)";
		Иначе
			Результат.Title = "0420431 Раздел 2 Сведения о п_1";
			Результат.Toc = "0420431 Раздел 2. Портфель ДС (ДУ)";
		КонецЕсли;
	ИначеЕсли ЭтоСигнатураПоступлений(SigKey) Тогда
		Если ЭтоБрокер(Dims) Тогда
			Результат.Title = "0420431 Раздел 1 Сведения об _1";
			Результат.Toc = "0420431 Раздел 1. Подраздел 1.2 поступления (брокер)";
		Иначе
			Результат.Title = "0420431 Раздел 1 Сведения об _2";
			Результат.Toc = "0420431 Раздел 1. Подраздел 1.2 поступления (ДУ)";
		КонецЕсли;
	ИначеЕсли ЭтоСигнатураДоговоров(SigKey) Тогда
		Если ЭтоБрокер(Dims) Тогда
			Результат.Title = "0420431 Раздел 1 Договоры брок";
			Результат.Toc = "0420431 Раздел 1. Подраздел 1.2 договоры (брокер)";
		Иначе
			Результат.Title = "0420431 Раздел 1 Договоры ДУ";
			Результат.Toc = "0420431 Раздел 1. Подраздел 1.2 договоры (ДУ)";
		КонецЕсли;
	ИначеЕсли ЭтоСигнатураКонцентрации(SigKey) Тогда
		Результат.Title = "0420431 Раздел 1 Сведения об _3";
		Результат.Toc = "0420431 Раздел 1. Подраздел 1.3. Концентрация";
	ИначеЕсли ЭтоСигнатураДепозитов(SigKey) Тогда
		Результат.Title = "0420431 Раздел 3 Сведения о п_2";
		Результат.Toc = "0420431 Раздел 3. Депозиты";
	ИначеЕсли СтрНайти(SigKey, "Inoe_imushhestvoTaxis") > 0 Тогда
		Результат.Title = "0420431 Раздел 5 Сведения о п_1";
		Результат.Toc = "0420431 Раздел 5. Иное имущество";
	ИначеЕсли СтрНайти(SigKey, "Rek_PFITaxis") > 0 Или СтрНайти(SigKey, "PoTipamPfiAxis") > 0 Тогда
		Результат.Title = "0420431 Раздел 6 Сведения о п_1";
		Результат.Toc = "0420431 Раздел 6. ПФИ";
	ИначеЕсли СтрНайти(SigKey, "TipTrebObAxis") > 0 Тогда
		ТипТреб = Строка(Dims.Получить("TipTrebObAxis"));
		Если СтрНайти(ТипТреб, "Repo") > 0 Или СтрНайти(ТипТреб, "SdelkiRepo") > 0 Тогда
			Результат.Title = "0420431 Раздел 7 Сведения о п_5";
			Результат.Toc = "0420431 Раздел 7. РЕПО (ДУ)";
		Иначе
			Результат.Title = "0420431 Раздел 7 Сведения о п_4";
			Результат.Toc = "0420431 Раздел 7. Прочее (ДУ)";
		КонецЕсли;
	Иначе
		Результат.Title = "Блок_" + Лев(СтрЗаменить(SigKey, "|", "_"), 26);
		Результат.Toc = "Неклассифицированный блок: " + SigKey;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСигнатураПортфеляЦБ(SigKey)
	
	Возврат СтрНайти(SigKey, "ID_CzennojBumagiTaxis") > 0
		И СтрНайти(SigKey, "ID_strategTaxis") > 0
		И СтрНайти(SigKey, "Tip_imushhestvaAxis") > 0
		И СтрНайти(SigKey, "Uroven_riskaAxis") > 0
		И СтрНайти(SigKey, "IDBrokeraKOTaxis") = 0
		И СтрНайти(SigKey, "Inoe_imushhestvoTaxis") = 0;
	
КонецФункции

Функция ЭтоСигнатураПортфеляДС(SigKey)
	
	Возврат СтрНайти(SigKey, "IDBrokeraKOTaxis") > 0
		И СтрНайти(SigKey, "Kod_ValyutyAxis") > 0;
	
КонецФункции

Функция ЭтоСигнатураПоступлений(SigKey)
	
	Возврат СтрНайти(SigKey, "Tip_imushhestvaAxis") > 0
		И СтрНайти(SigKey, "ID_strategTaxis") > 0
		И СтрНайти(SigKey, "Uroven_riskaAxis") = 0
		И СтрНайти(SigKey, "ID_CzennojBumagiTaxis") = 0
		И СтрНайти(SigKey, "IDBrokeraKOTaxis") = 0
		И СтрНайти(SigKey, "RazmSchAxis") = 0;
	
КонецФункции

Функция ЭтоСигнатураДоговоров(SigKey)
	
	Возврат СтрНайти(SigKey, "ID_strategTaxis") > 0
		И СтрНайти(SigKey, "Vid_DeyatelnostiAxis") > 0
		И СтрНайти(SigKey, "Tip_imushhestvaAxis") = 0
		И СтрНайти(SigKey, "Uroven_riskaAxis") = 0
		И СтрНайти(SigKey, "RazmSchAxis") = 0
