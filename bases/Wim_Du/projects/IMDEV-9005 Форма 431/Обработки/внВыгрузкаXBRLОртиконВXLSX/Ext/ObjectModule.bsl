КонецФункции

// Описание: Точка входа для фонового задания БСП (ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки)
// При возможности пересоздает обработку без безопасного режима (ВнешниеОбработки.Создать(..., Ложь))
//
// Параметры:
// ПараметрыВыполнения - Структура - поля ПутьXBRL, ПутьEPF (необязательно)
// АдресХранилища - Строка - адрес результата во временном хранилище
//
Процедура СформироватьФайлXLSXВФоне(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	Результат = Неопределено;
	ПутьEPF = "";
	Если ПараметрыВыполнения.Свойство("ПутьEPF") Тогда
		ПутьEPF = ПараметрыВыполнения.ПутьEPF;
	КонецЕсли;
	
	ПутьXBRL = "";
	Если ПараметрыВыполнения.Свойство("ПутьXBRL") Тогда
		ПутьXBRL = ПараметрыВыполнения.ПутьXBRL;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПутьEPF) Тогда
		Попытка
			ОбработкаБезОграничений = ВнешниеОбработки.Создать(ПутьEPF, Ложь);
			Результат = ОбработкаБезОграничений.СформироватьФайлXLSXИзXBRL(ПутьXBRL);
		Исключение
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = СформироватьФайлXLSXИзXBRL(ПутьXBRL);
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
	
	// временные файлы задания (XBRL/EPF) больше не нужны
	УдалитьВременныйФайлБезопасно(ПутьXBRL);
	УдалитьВременныйФайлБезопасно(ПутьEPF);
	
КонецПроцедуры

// Описание: Конвертирует файл XBRL/ZIP ОРТИКОН в двоичные данные XLSX (чисто на 1С)
// В фоне сообщает прогресс через ДлительныеОперации.СообщитьПрогресс
//
// Параметры:
// ПутьКФайлуXBRL - Строка - путь к .xbrl или .zip на сервере
//
// Возвращаемое значение:
// Структура - Успех, ДвоичныеДанные, Описание, ИмяФайла, Секунд
//
Функция СформироватьФайлXLSXИзXBRL(ПутьКФайлуXBRL) Экспорт
	
	Результат = НовыйРезультатКонвертации();
	
	Попытка
		УстановитьБезопасныйРежим(Ложь);
	Исключение
		// продолжаем
	КонецПопытки;
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Если Не ЗначениеЗаполнено(ПутьКФайлуXBRL) Тогда
		Результат.Описание = "Не указан файл XBRL/ZIP.";
		Возврат Результат;
	КонецЕсли;
	
	ФайлВход = Новый Файл(ПутьКФайлуXBRL);
	Если Не ФайлВход.Существует() Тогда
		Результат.Описание = "Файл не найден: " + ПутьКФайлуXBRL;
		Возврат Результат;
	КонецЕсли;
	
	СообщитьПрогрессАбсолютный(5, "Подготовка файла XBRL", ВремяНачала);
	
	ПутьКXBRL = ПутьКФайлуXBRL;
	ВременныйКаталогZIP = "";
	
	Если НРег(ФайлВход.Расширение) = ".zip" Тогда
		РезультатИзвлечения = ИзвлечьXBRLИзZIP(ПутьКФайлуXBRL);
		ПутьКXBRL = РезультатИзвлечения.ПутьКФайлу;
		ВременныйКаталогZIP = РезультатИзвлечения.Каталог;
		Если Не ЗначениеЗаполнено(ПутьКXBRL) Тогда
			УдалитьВременныйФайлБезопасно(ВременныйКаталогZIP);
			Результат.Описание = "В ZIP не найден файл .xbrl.";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		
		СообщитьПрогрессАбсолютный(15, "Чтение XBRL (контексты и факты)", ВремяНачала);
		ДанныеXBRL = ПрочитатьДанныеXBRL(ПутьКXBRL, ВремяНачала);
		
		СообщитьПрогрессАбсолютный(70, "Сборка листов Excel", ВремяНачала);
		Листы = СобратьЛистыИзДанныхXBRL(ДанныеXBRL);
		
		СообщитьПрогрессАбсолютный(75, "Формирование и запись XLSX", ВремяНачала);
		ДвоичныеДанные = ЗаписатьЛистыВXLSX(Листы, ДанныеXBRL, ВремяНачала);
		
	Исключение
		УдалитьВременныйФайлБезопасно(ВременныйКаталогZIP);
		Результат.Описание = "Ошибка конвертации XBRL: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	УдалитьВременныйФайлБезопасно(ВременныйКаталогZIP);
	
	Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
		Результат.Описание = "Получен пустой файл XLSX.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДлительныеОперации.СообщитьПрогресс(100, "Готово");
	Исключение
		// вне фона прогресс недоступен
	КонецПопытки;
	
	Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	
	Результат.Успех = Истина;
	Результат.ДвоичныеДанные = ДвоичныеДанные;
	Результат.ИмяФайла = "XBRL_Orticon_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss") + ".xlsx";
	Результат.Секунд = Секунд;
	Результат.Описание = СтрШаблон(
		"внВыгрузкаXBRLОртиконВXLSX v%1 (только 1С)%2Листов с данными: %3.%2Время: %4 сек.%2Размер: %5 байт.",
		ВерсияОбработки(),
		Символы.ПС,
		Формат(Листы.Количество(), "ЧГ=0"),
		Формат(Секунд, "ЧДЦ=1; ЧГ=0"),
		Формат(ДвоичныеДанные.Размер(), "ЧГ=0"));
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатКонвертации()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ДвоичныеДанные", Неопределено);
	Результат.Вставить("Описание", "");
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("Секунд", 0);
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьXBRLИзZIP(ПутьZIP)
	
	Результат = Новый Структура("ПутьКФайлу, Каталог", "", "");
	
	Каталог = ПолучитьИмяВременногоФайла("") + ПолучитьРазделительПути();
	СоздатьКаталог(Каталог);
	Результат.Каталог = Каталог;
	
	ЧтениеZip = Новый ЧтениеZipФайла(ПутьZIP);
	ИмяXBRL = "";
	Для Каждого Элемент Из ЧтениеZip.Элементы Цикл
		Если СтрЗаканчиваетсяНа(НРег(Элемент.Имя), ".xbrl") Тогда
			ЧтениеZip.Извлечь(Элемент, Каталог);
			ИмяXBRL = Каталог + Элемент.Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЧтениеZip.Закрыть();
	
	Результат.ПутьКФайлу = ПривестиПолныйПутьФайлаИзZIP(ИмяXBRL, Каталог);
	Возврат Результат;
	
КонецФункции

Функция ПривестиПолныйПутьФайлаИзZIP(ИмяXBRL, Каталог)
	
	Если Не ЗначениеЗаполнено(ИмяXBRL) Тогда
		Возврат "";
	КонецЕсли;
	
	Файл = Новый Файл(ИмяXBRL);
	Если Файл.Существует() Тогда
		Возврат ИмяXBRL;
	КонецЕсли;
	
	// вложенные пути в zip
	Найденные = НайтиФайлы(Каталог, "*.xbrl", Истина);
	Если Найденные.Количество() > 0 Тогда
		Возврат Найденные[0].ПолноеИмя;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура УдалитьВременныйФайлБезопасно(Путь)
	
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		УдалитьФайлы(Путь);
	Исключение
		// временный файл уже недоступен
	КонецПопытки;
	
КонецПроцедуры

Функция ПрочитатьДанныеXBRL(ПутьКФайлу, ВремяНачалаМс = 0)
	
	Данные = Новый Структура;
	Данные.Вставить("Контексты", Новый Соответствие); // id -> Структура
	Данные.Вставить("Факты", Новый Соответствие); // id -> Соответствие concept->value
	Данные.Вставить("SchemaRef", "");
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьКФайлу);
	
	СчетчикКонтекстов = 0;
	СчетчикФактов = 0;
	ШагПрогресса = 3000;
	
	Попытка
		
		Пока Чтение.Прочитать() Цикл
			
			Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			
			Имя = Чтение.ЛокальноеИмя;
			
			Если Имя = "schemaRef" Тогда
				Если Не ЗначениеЗаполнено(Данные.SchemaRef) Тогда
					Данные.SchemaRef = ЗначениеHrefСхемыXBRL(Чтение);
				КонецЕсли;
				
			ИначеЕсли Имя = "context" Тогда
				Ид = ЗначениеАтрибутаЧтенияXML(Чтение, "id");
				Контекст = ПрочитатьКонтекстXML(Чтение, Имя);
				Если ЗначениеЗаполнено(Ид) Тогда
					Данные.Контексты.Вставить(Ид, Контекст);
					СчетчикКонтекстов = СчетчикКонтекстов + 1;
					Если СчетчикКонтекстов % ШагПрогресса = 0 Тогда
						СообщитьПрогрессЧтенияXBRL(
							СчетчикКонтекстов,
							СчетчикФактов,
							ВремяНачалаМс);
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(ЗначениеАтрибутаЧтенияXML(Чтение, "contextRef")) Тогда
				
				ContextRef = ЗначениеАтрибутаЧтенияXML(Чтение, "contextRef");
				Concept = Имя;
				Значение = ПрочитатьТекстЭлементаXML(Чтение, Имя);
				
				ФактыКонтекста = Данные.Факты.Получить(ContextRef);
				Если ФактыКонтекста = Неопределено Тогда
					ФактыКонтекста = Новый Соответствие;
					Данные.Факты.Вставить(ContextRef, ФактыКонтекста);
				КонецЕсли;
				ФактыКонтекста.Вставить(Concept, Значение);
				СчетчикФактов = СчетчикФактов + 1;
				Если СчетчикФактов % ШагПрогресса = 0 Тогда
					СообщитьПрогрессЧтенияXBRL(
						СчетчикКонтекстов,
						СчетчикФактов,
						ВремяНачалаМс);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Чтение.Закрыть();
		
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	
	СообщитьПрогрессЧтенияXBRL(СчетчикКонтекстов, СчетчикФактов, ВремяНачалаМс, Истина);
	Возврат Данные;
	
КонецФункции

Функция ПрочитатьКонтекстXML(Чтение, ИмяКонтекста)
	
	Результат = Новый Структура;
	Результат.Вставить("Period", "");
	Результат.Вставить("Entity", "");
	Результат.Вставить("Dims", Новый Соответствие);
	Результат.Вставить("SigKey", "");
	
	StartDate = "";
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.ЛокальноеИмя = ИмяКонтекста Тогда
			Прервать;
		КонецЕсли;
		
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = Чтение.ЛокальноеИмя;
		
		Если Имя = "identifier" Тогда
			Результат.Entity = ПрочитатьТекстЭлементаXML(Чтение, Имя);
			
		ИначеЕсли Имя = "instant" Тогда
			Результат.Period = ПрочитатьТекстЭлементаXML(Чтение, Имя);
			
		ИначеЕсли Имя = "startDate" Тогда
			StartDate = ПрочитатьТекстЭлементаXML(Чтение, Имя);
			
		ИначеЕсли Имя = "endDate" Тогда
			Конец = ПрочитатьТекстЭлементаXML(Чтение, Имя);
			Если ЗначениеЗаполнено(StartDate) Тогда
				Результат.Period = StartDate + ".." + Конец;
			Иначе
				Результат.Period = "E:" + Конец;
			КонецЕсли;
			
		ИначеЕсли Имя = "explicitMember" Тогда
			Измерение = ЛокальноеИмяИзQName(ЗначениеАтрибутаЧтенияXML(Чтение, "dimension"));
			ЗначениеЧлена = ЛокальноеИмяИзQName(ПрочитатьТекстЭлементаXML(Чтение, Имя));
			Результат.Dims.Вставить(Измерение, ЗначениеЧлена);
			
		ИначеЕсли Имя = "typedMember" Тогда
			Измерение = ЛокальноеИмяИзQName(ЗначениеАтрибутаЧтенияXML(Чтение, "dimension"));
			ЗначениеТип = ПрочитатьЗначениеTypedMember(Чтение, Имя);
			Результат.Dims.Вставить(Измерение, ЗначениеТип);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.SigKey = КлючСигнатурыОсей(Результат.Dims);
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьЗначениеTypedMember(Чтение, ИмяTyped)
	
	Значение = "";
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.ЛокальноеИмя = ИмяTyped Тогда
			Прервать;
		КонецЕсли;
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Значение = ПрочитатьТекстЭлементаXML(Чтение, Чтение.ЛокальноеИмя);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции

Функция СобратьЛистыИзДанныхXBRL(ДанныеXBRL)
	
	// title -> Structure(Name, Toc, Columns Array, ColSet Map, Rows Array of Map, IsBank)
	Листы = Новый Соответствие;
	ИспользованныеИмена = Новый Соответствие;
	ИспользованныеИмена.Вставить("TOC", Истина);
	
	Для Каждого КЗ Из ДанныеXBRL.Контексты Цикл
		
		ИдКонтекста = КЗ.Ключ;
		Контекст = КЗ.Значение;
		Факты = ДанныеXBRL.Факты.Получить(ИдКонтекста);
		Если Факты = Неопределено Или Факты.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеЛиста = ОписаниеЛистаПоСигнатуре(Контекст.SigKey, Контекст.Dims);
		Заголовок = ОписаниеЛиста.Title;
		
		Корзина = Листы.Получить(Заголовок);
		Если Корзина = Неопределено Тогда
			ИмяЛиста = УникальноеИмяЛистаExcel(Заголовок, ИспользованныеИмена);
			Корзина = Новый Структура;
			Корзина.Вставить("Name", ИмяЛиста);
			Корзина.Вставить("Toc", ОписаниеЛиста.Toc);
			Корзина.Вставить("Columns", Новый Массив);
			Корзина.Вставить("ColSet", Новый Соответствие);
			Корзина.Вставить("Rows", Новый Массив);
			Корзина.Вставить("IsBank", СтрНачинаетсяС(Заголовок, "0420409 Раздел 1"));
			Листы.Вставить(Заголовок, Корзина);
		КонецЕсли;
		
		СтрокаДанных = Новый Соответствие;
		СтрокаДанных.Вставить("Period", Контекст.Period);
		СтрокаДанных.Вставить("ContextId", ИдКонтекста);
		
		Для Каждого Дим Из Контекст.Dims Цикл
			ИмяКол = ИмяКолонкиИзмерения(Дим.Ключ);
			ЗначКол = ?(СтрЗаканчиваетсяНа(Дим.Ключ, "Taxis"), Дим.Значение, ОчеловечитьЧлен(Дим.Значение));
			СтрокаДанных.Вставить(ИмяКол, ЗначКол);
			ДобавитьКолонкуЕслиНет(Корзина, ИмяКол);
		КонецЦикла;
		
		Для Каждого Факт Из Факты Цикл
			ЗначФакта = НормализоватьЗначениеФакта(Факт.Значение);
			СтрокаДанных.Вставить(Факт.Ключ, ЗначФакта);
			ДобавитьКолонкуЕслиНет(Корзина, Факт.Ключ);
		КонецЦикла;
		
		Корзина.Rows.Добавить(СтрокаДанных);
		
	КонецЦикла;
	
	// агрегация банковских счетов
	Для Каждого КЗЛист Из Листы Цикл
		Корзина = КЗЛист.Значение;
		Если Корзина.IsBank Тогда
			СвернутьБанковскиеСчета(Корзина);
		Иначе
			УпорядочитьКолонкиЛиста(Корзина);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Листы;
	
КонецФункции

Процедура СвернутьБанковскиеСчета(Корзина)
	
	ПоСчетам = Новый Соответствие;
	
	Для Каждого СтрокаДанных Из Корзина.Rows Цикл
		
		Счет = СтрокаДанных.Получить("Rek_kred_org_i_scheta");
		Если Не ЗначениеЗаполнено(Счет) Тогда
			Счет = СтрокаДанных.Получить("ContextId");
		КонецЕсли;
		
		Элемент = ПоСчетам.Получить(Счет);
		Если Элемент = Неопределено Тогда
			Элемент = Новый Соответствие;
			Элемент.Вставить("Rek_kred_org_i_scheta", Счет);
			ПоСчетам.Вставить(Счет, Элемент);
		КонецЕсли;
		
		Период = Строка(СтрокаДанных.Получить("Period"));
		ПериодКлюч = СтрЗаменить(СтрЗаменить(Период, "..", "_"), ":", "_");
		Если Не ЗначениеЗаполнено(ПериодКлюч) Тогда
			ПериодКлюч = "NA";
		КонецЕсли;
		
		Для Каждого КЗ Из СтрокаДанных Цикл
			Ключ = КЗ.Ключ;
			Если Ключ = "Period" Или Ключ = "ContextId" Или Ключ = "Rek_kred_org_i_scheta" Тогда
				Продолжить;
			КонецЕсли;
			Если Ключ = "DSKO_BB" Или Ключ = "DSKO_ObDt" Или Ключ = "DSKO_ObKt" Тогда
				Элемент.Вставить(Ключ + "_" + ПериодКлюч, КЗ.Значение);
			ИначеЕсли Не ЗначениеЗаполнено(Элемент.Получить(Ключ)) Тогда
				Элемент.Вставить(Ключ, КЗ.Значение);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	НовыеСтроки = Новый Массив;
	ColSet = Новый Соответствие;
	Columns = Новый Массив;
	
	Для Каждого КЗ Из ПоСчетам Цикл
		НовыеСтроки.Добавить(КЗ.Значение);
		Для Каждого Поле Из КЗ.Значение Цикл
			Если ColSet.Получить(Поле.Ключ) = Неопределено Тогда
				ColSet.Вставить(Поле.Ключ, Истина);
				Columns.Добавить(Поле.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Денежные = Новый Массив;
	Прочие = Новый Массив;
	Для Каждого ИмяКол Из Columns Цикл
		Если ИмяКол = "Rek_kred_org_i_scheta" Тогда
			Продолжить;
		ИначеЕсли СтрНачинаетсяС(ИмяКол, "DSKO_") Тогда
			Денежные.Добавить(ИмяКол);
		Иначе
			Прочие.Добавить(ИмяКол);
		КонецЕсли;
	КонецЦикла;
	
	ИтоговыеКолонки = Новый Массив;
	ИтоговыеКолонки.Добавить("Rek_kred_org_i_scheta");
	Для Каждого ИмяКол Из Прочие Цикл
		ИтоговыеКолонки.Добавить(ИмяКол);
	КонецЦикла;
	Для Каждого ИмяКол Из Денежные Цикл
		ИтоговыеКолонки.Добавить(ИмяКол);
	КонецЦикла;
	
	Корзина.Rows = НовыеСтроки;
	Корзина.Columns = ИтоговыеКолонки;
	Корзина.ColSet = Новый Соответствие;
	Для Каждого ИмяКол Из ИтоговыеКолонки Цикл
		Корзина.ColSet.Вставить(ИмяКол, Истина);
	КонецЦикла;
	
КонецПроцедуры

Процедура УпорядочитьКолонкиЛиста(Корзина)
	
	Итоговые = Новый Массив;
	Итоговые.Добавить("Period");
	
	TypedLike = Новый Массив;
	Прочие = Новый Массив;
	
	Для Каждого ИмяКол Из Корзина.Columns Цикл
		Если ИмяКол = "Period" Или ИмяКол = "ContextId" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(ИмяКол, "ID") Или СтрНачинаетсяС(ИмяКол, "Rek") Или СтрНачинаетсяС(ИмяКол, "Id") Тогда
			TypedLike.Добавить(ИмяКол);
		Иначе
			Прочие.Добавить(ИмяКол);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяКол Из TypedLike Цикл
		Итоговые.Добавить(ИмяКол);
	КонецЦикла;
	Для Каждого ИмяКол Из Прочие Цикл
		Итоговые.Добавить(ИмяКол);
	КонецЦикла;
	
	Корзина.Columns = Итоговые;
	
КонецПроцедуры

Функция ЗаписатьЛистыВXLSX(Листы, ДанныеXBRL, ВремяНачалаМс = 0)
	
	Пакет = Новый ПакетОтображаемыхДокументов;
	
	Упорядоченные = УпорядоченныеКорзиныЛистов(Листы);
	ВсегоЛистов = Упорядоченные.Количество();
	
	ТабTOC = СформироватьЛистTOC(Упорядоченные, ДанныеXBRL);
	ДобавитьЛистВПакет(Пакет, "TOC", ТабTOC);
	
	НомерЛиста = 0;
	Для Каждого Корзина Из Упорядоченные Цикл
		НомерЛиста = НомерЛиста + 1;
		Если ВсегоЛистов > 0 И (НомерЛиста = 1 Или НомерЛиста % 3 = 0 Или НомерЛиста = ВсегоЛистов) Тогда
			ТекстЛиста = СтрШаблон(
				"Лист %1/%2: %3",
				Формат(НомерЛиста, "ЧГ=0"),
				Формат(ВсегоЛистов, "ЧГ=0"),
				Корзина.Name);
			// диапазон этапа записи: 75..95%
			Процент = 75 + Цел(20 * НомерЛиста / ВсегоЛистов);
			СообщитьПрогрессАбсолютный(Процент, ТекстЛиста, ВремяНачалаМс);
		КонецЕсли;
		ТабДок = СформироватьТабличныйДокументЛиста(Корзина);
		ДобавитьЛистВПакет(Пакет, Корзина.Name, ТабДок);
	КонецЦикла;
	
	СообщитьПрогрессАбсолютный(96, "Запись файла XLSX на диск", ВремяНачалаМс);
	Возврат ЗаписатьПакетВДвоичныеДанные(Пакет);
	
КонецФункции

Функция УпорядоченныеКорзиныЛистов(Листы)
	
	Список = Новый СписокЗначений;
	Для Каждого КЗ Из Листы Цикл
		Список.Добавить(КЗ.Значение, КЗ.Значение.Name);
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	
	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция СформироватьЛистTOC(Упорядоченные, ДанныеXBRL)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Область(1, 1).Текст = ДанныеXBRL.SchemaRef;
	ТабДок.Область(3, 1).Текст = "Generator";
	ТабДок.Область(3, 2).Текст = "внВыгрузкаXBRLОртиконВXLSX v" + ВерсияОбработки() + " (1C only)";
	ТабДок.Область(5, 1).Текст = "No.";
	ТабДок.Область(5, 2).Текст = "table";
	ТабДок.Область(5, 3).Текст = "description";
	ОформитьЗаголовок(ТабДок, 5, 3);
	
	Номер = 1;
	НомерСтроки = 6;
	
	Для Каждого Корзина Из Упорядоченные Цикл
		ТабДок.Область(НомерСтроки, 1).Текст = Формат(Номер, "ЧГ=0");
		ТабДок.Область(НомерСтроки, 2).Текст = Корзина.Name;
		ТабДок.Область(НомерСтроки, 3).Текст = Корзина.Toc
			+ " [" + Формат(Корзина.Rows.Количество(), "ЧГ=0") + " строк]";
		Номер = Номер + 1;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Функция СформироватьТабличныйДокументЛиста(Корзина)
	
	ТабДок = Новый ТабличныйДокумент;
	Колонки = Корзина.Columns;
	КоличествоКолонок = Колонки.Количество();
	
	Если КоличествоКолонок = 0 Тогда
		ТабДок.Область(1, 1).Текст = Корзина.Name;
		Возврат ТабДок;
	КонецЕсли;
	
	Для Индекс = 0 По КоличествоКолонок - 1 Цикл
		ТабДок.Область(1, Индекс + 1).Текст = Колонки[Индекс];
	КонецЦикла;
	ОформитьЗаголовок(ТабДок, 1, КоличествоКолонок);
	
	НомерСтроки = 2;
	Для Каждого СтрокаДанных Из Корзина.Rows Цикл
		Для Индекс = 0 По КоличествоКолонок - 1 Цикл
			ИмяКол = Колонки[Индекс];
			Значение = СтрокаДанных.Получить(ИмяКол);
			ЗаписатьЗначениеВЯчейку(ТабДок.Область(НомерСтроки, Индекс + 1), Значение);
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ТабДок.ФиксацияСверху = 1;
	Возврат ТабДок;
	
КонецФункции

Процедура ЗаписатьЗначениеВЯчейку(Область, Значение)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Область.Текст = "";
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Область.СодержитЗначение = Истина;
		Область.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(32, 10));
		Область.Значение = Значение;
		Возврат;
	КонецЕсли;
	
	Текст = СокрЛП(Строка(Значение));
	Если Текст = "" Тогда
		Область.Текст = "";
		Возврат;
	КонецЕсли;
	
	// попытка числа с запятой
	ТекстЧисла = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.НПП, ""), " ", ""), ",", ".");
	Попытка
		Числовое = Число(ТекстЧисла);
		Область.СодержитЗначение = Истина;
		Область.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(32, 10));
		Область.Значение = Числовое;
		Возврат;
	Исключение
		Область.Текст = Текст;
	КонецПопытки;
	
КонецПроцедуры

Процедура ДобавитьЛистВПакет(Пакет, ИмяЛиста, ТабличныйДокумент)
	
	ЭлементПакета = Пакет.Состав.Добавить();
	ЭлементПакета.Наименование = ИмяЛиста;
	ЭлементПакета.Данные = ПоместитьВоВременноеХранилище(ТабличныйДокумент);
	
КонецПроцедуры

Функция ЗаписатьПакетВДвоичныеДанные(Пакет)
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	Попытка
		Пакет.Записать(ИмяФайла, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
		ДвоичныеДанные = ПрочитатьФайлВДвоичныеДанныеЧерезПоток(ИмяФайла);
		УдалитьФайлы(ИмяФайла);
		Возврат ДвоичныеДанные;
	Исключение
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

Функция ПрочитатьФайлВДвоичныеДанныеЧерезПоток(ИмяФайла)
	
	ЧтениеДанных = Новый ЧтениеДанных(ИмяФайла);
	Попытка
		Буфер = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных();
		ЧтениеДанных.Закрыть();
		Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
	Исключение
		ЧтениеДанных.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

Процедура СообщитьПрогрессЧтенияXBRL(СчетчикКонтекстов, СчетчикФактов, ВремяНачалаМс, Финал = Ложь)
	
	// чтение - самый долгий этап: держим процент в диапазоне 20..68
	Оценка = СчетчикКонтекстов + Цел(СчетчикФактов / 3);
	Процент = 20 + Цел(Оценка / 2500);
	Если Процент > 68 Тогда
		Процент = 68;
	КонецЕсли;
	Если Финал Тогда
		Процент = 68;
	КонецЕсли;
	
	Текст = СтрШаблон(
		"Чтение XBRL: контекстов %1, фактов %2",
		Формат(СчетчикКонтекстов, "ЧГ=0"),
		Формат(СчетчикФактов, "ЧГ=0"));
	СообщитьПрогрессАбсолютный(Процент, Текст, ВремяНачалаМс);
	
КонецПроцедуры

Процедура СообщитьПрогрессАбсолютный(Процент, ТекстЭтапа, ВремяНачалаМс = 0)
	
	Текст = ТекстЭтапа;
	
	Если ВремяНачалаМс > 0 Тогда
		ПрошлоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс;
		Если ПрошлоМс > 0 И Процент > 0 И Процент < 100 Тогда
			ОсталосьМс = Цел(ПрошлоМс * (100 - Процент) / Процент);
			Текст = СтрШаблон("%1. Осталось примерно %2", ТекстЭтапа, ПредставлениеИнтервалаМс(ОсталосьМс));
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		ДлительныеОперации.СообщитьПрогресс(Процент, Текст);
	Исключение
		// синхронный запуск или нет модуля БСП
	КонецПопытки;
	
КонецПроцедуры

Функция ПредставлениеИнтервалаМс(ИнтервалМс)
	
	ВсегоСекунд = Цел(ИнтервалМс / 1000);
	Если ВсегоСекунд < 1 Тогда
		Возврат "менее секунды";
	КонецЕсли;
	
	Минуты = Цел(ВсегоСекунд / 60);
	Секунды = ВсегоСекунд - Минуты * 60;
	
	Если Минуты = 0 Тогда
		Возврат СтрШаблон("%1 сек", Формат(Секунды, "ЧГ=0"));
	КонецЕсли;
	
	Возврат СтрШаблон("%1 мин %2 сек", Формат(Минуты, "ЧГ=0"), Формат(Секунды, "ЧГ=0"));
	
КонецФункции

#Область МаппингЛистов

Функция ОписаниеЛистаПоСигнатуре(SigKey, Dims)
	
	Результат = Новый Структура("Title, Toc", "", "");
	
	Если SigKey = "" Тогда
		Результат.Title = "Сопроводительная информация об ";
		Результат.Toc = "Сопроводительная информация об отчитывающейся организации";
	ИначеЕсли SigKey = "OKUDAxis" Тогда
		Результат.Title = "Сопроводительная информация к о";
		Результат.Toc = "Сопроводительная информация к отчетности. Ответственные лица";
	ИначеЕсли SigKey = "Rek_kred_org_i_schetaTaxis" Тогда
		Результат.Title = "0420409 Раздел 1 Сведения о бан";
		Результат.Toc = "0420409 Раздел 1. Сведения о банковских счетах";
	ИначеЕсли SigKey = "ID_broker_kliringTaxis|ID_strokiTaxis" Тогда
		Результат.Title = "0420409 Раздел 2 Сведения о ден";
		Результат.Toc = "0420409 Раздел 2. ДС у брокера/клиринга";
	ИначеЕсли SigKey = "ID_strokiTaxis|Rek_Vyd_ZajmTaxis" Тогда
		Результат.Title = "0420414 Раздел 1 Выданные займы";
		Результат.Toc = "0420414 Раздел 1. Выданные займы";
	ИначеЕсли SigKey = "TechnicalAxis" Тогда
		Результат.Title = "0420414 Раздел 2 Полученные зай";
		Результат.Toc = "0420414 Раздел 2. Полученные займы / итоги";
	ИначеЕсли SigKey = "ID_strokiTaxis" Тогда
		Результат.Title = "Информация о документах включен";
		Результат.Toc = "Информация о документах в составе пакета";
	ИначеЕсли SigKey = "ID_strategTaxis" Тогда
		Результат.Title = "0420431 Раздел 1 Сведения об ос";
		Результат.Toc = "0420431 Раздел 1. Подраздел 1.1. Стратегии ДУ";
	ИначеЕсли SigKey = "ID_CzennojBumagiTaxis" Тогда
		Результат.Title = "0420459 Раздел 1 Сведения о цен";
		Результат.Toc = "0420459 Раздел 1.1. Сведения о ценных бумагах";
	ИначеЕсли ЭтоСигнатураПортфеляЦБ(SigKey) Тогда
		Если ЭтоБрокер(Dims) Тогда
			Результат.Title = "0420431 Раздел 4 Сведения о пор";
			Результат.Toc = "0420431 Раздел 4. Портфель ЦБ (брокер)";
		Иначе
			Результат.Title = "0420431 Раздел 4 Сведения о п_1";
			Результат.Toc = "0420431 Раздел 4. Портфель ЦБ (ДУ)";
		КонецЕсли;
	ИначеЕсли ЭтоСигнатураПортфеляДС(SigKey) Тогда
		Если ЭтоБрокер(Dims) Тогда
			Результат.Title = "0420431 Раздел 2 Сведения о пор";
			Результат.Toc = "0420431 Раздел 2. Портфель ДС (брокер)";
		Иначе
			Результат.Title = "0420431 Раздел 2 Сведения о п_1";
			Результат.Toc = "0420431 Раздел 2. Портфель ДС (ДУ)";
		КонецЕсли;
	ИначеЕсли ЭтоСигнатураПоступлений(SigKey) Тогда
		Если ЭтоБрокер(Dims) Тогда
			Результат.Title = "0420431 Раздел 1 Сведения об _1";
			Результат.Toc = "0420431 Раздел 1. Подраздел 1.2 поступления (брокер)";
		Иначе
			Результат.Title = "0420431 Раздел 1 Сведения об _2";
			Результат.Toc = "0420431 Раздел 1. Подраздел 1.2 поступления (ДУ)";
		КонецЕсли;
	ИначеЕсли ЭтоСигнатураДоговоров(SigKey) Тогда
		Если ЭтоБрокер(Dims) Тогда
			Результат.Title = "0420431 Раздел 1 Договоры брок";
			Результат.Toc = "0420431 Раздел 1. Подраздел 1.2 договоры (брокер)";
		Иначе
			Результат.Title = "0420431 Раздел 1 Договоры ДУ";
			Результат.Toc = "0420431 Раздел 1. Подраздел 1.2 договоры (ДУ)";
		КонецЕсли;
	ИначеЕсли ЭтоСигнатураКонцентрации(SigKey) Тогда
		Результат.Title = "0420431 Раздел 1 Сведения об _3";
		Результат.Toc = "0420431 Раздел 1. Подраздел 1.3. Концентрация";
	ИначеЕсли ЭтоСигнатураДепозитов(SigKey) Тогда
		Результат.Title = "0420431 Раздел 3 Сведения о п_2";
		Результат.Toc = "0420431 Раздел 3. Депозиты";
	ИначеЕсли СтрНайти(SigKey, "Inoe_imushhestvoTaxis") > 0 Тогда
		Результат.Title = "0420431 Раздел 5 Сведения о п_1";
		Результат.Toc = "0420431 Раздел 5. Иное имущество";
	ИначеЕсли СтрНайти(SigKey, "Rek_PFITaxis") > 0 Или СтрНайти(SigKey, "PoTipamPfiAxis") > 0 Тогда
		Результат.Title = "0420431 Раздел 6 Сведения о п_1";
		Результат.Toc = "0420431 Раздел 6. ПФИ";
	ИначеЕсли СтрНайти(SigKey, "TipTrebObAxis") > 0 Тогда
		ТипТреб = Строка(Dims.Получить("TipTrebObAxis"));
		Если СтрНайти(ТипТреб, "Repo") > 0 Или СтрНайти(ТипТреб, "SdelkiRepo") > 0 Тогда
			Результат.Title = "0420431 Раздел 7 Сведения о п_5";
			Результат.Toc = "0420431 Раздел 7. РЕПО (ДУ)";
		Иначе
			Результат.Title = "0420431 Раздел 7 Сведения о п_4";
			Результат.Toc = "0420431 Раздел 7. Прочее (ДУ)";
		КонецЕсли;
	Иначе
		Результат.Title = "Блок_" + Лев(СтрЗаменить(SigKey, "|", "_"), 26);
		Результат.Toc = "Неклассифицированный блок: " + SigKey;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

