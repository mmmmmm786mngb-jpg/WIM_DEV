#Область ПрограммныйИнтерфейс

// Описание: Сведения для подсистемы БСП "Дополнительные отчеты и обработки"
// Важно: БезопасныйРежим = Ложь - запись XLSX и чтение крупных файлов
//
// Возвращаемое значение:
// Структура - параметры регистрации внешней обработки (Вид, Наименование, Версия, Команды, ...)
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", "Выгрузка XBRL ОРТИКОН в XLSX");
	ПараметрыРегистрации.Вставить("Версия", ВерсияОбработки());
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Конвертация XBRL instance ОРТИКОН (НСО ПУРЦБ) в multi-sheet Excel. "
		+ "Только платформа 1С. Два режима: быстрый и с таксономией ЦБ "
		+ "(русские подписи из макета " + ИмяМакетаТаксономии() + ").");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, "Выгрузка XBRL ОРТИКОН в XLSX", "внВыгрузкаXBRLОртиконВXLSX", "ОткрытиеФормы");
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Описание: Номер версии обработки
//
// Возвращаемое значение:
// Строка - версия в формате X.Y.Z
//
Функция ВерсияОбработки() Экспорт
	
	Возврат "1.3.27";
	
КонецФункции

// Описание: Имя двоичного макета со вшитой таксономией XBRL Банка России
//
// Возвращаемое значение:
// Строка - имя макета обработки (zip таксономии)
//
Функция ИмяМакетаТаксономии() Экспорт
	
	Возврат "Таксономия_20251230";
	
КонецФункции

// Описание: Извлекает вшитую таксономию (zip) из макета обработки во временный файл
//
// Возвращаемое значение:
// Структура - Успех, ПутьКФайлу, ИмяМакета, Размер, Описание
//
Функция ИзвлечьТаксономиюИзМакетаВоВременныйФайл() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ПутьКФайлу", "");
	Результат.Вставить("ИмяМакета", ИмяМакетаТаксономии());
	Результат.Вставить("Размер", 0);
	Результат.Вставить("Описание", "");
	
	Попытка
		УстановитьБезопасныйРежим(Ложь);
	Исключение
		// продолжаем
	КонецПопытки;
	
	Попытка
		ДвоичныеДанные = ПолучитьМакет(Результат.ИмяМакета);
	Исключение
		Результат.Описание = "Не удалось получить макет таксономии """ + Результат.ИмяМакета + """: "
			+ ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Если ДвоичныеДанные = Неопределено Тогда
		Результат.Описание = "Макет таксономии пуст: " + Результат.ИмяМакета;
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Результат.Описание = "Макет таксономии имеет неожиданный тип: " + Строка(ТипЗнч(ДвоичныеДанные));
		Возврат Результат;
	КонецЕсли;
	
	Если ДвоичныеДанные.Размер() = 0 Тогда
		Результат.Описание = "Макет таксономии не содержит данных.";
		Возврат Результат;
	КонецЕсли;
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла("zip");
	Попытка
		ДвоичныеДанные.Записать(ПутьКФайлу);
	Исключение
		Результат.Описание = "Не удалось записать таксономию во временный файл: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = Истина;
	Результат.ПутьКФайлу = ПутьКФайлу;
	Результат.Размер = ДвоичныеДанные.Размер();
	Результат.Описание = СтрШаблон(
		"Таксономия извлечена из макета %1 (%2 байт).",
		Результат.ИмяМакета,
		Формат(Результат.Размер, "ЧГ=0"));
	
	Возврат Результат;
	
КонецФункции

// Описание: Точка входа для фонового задания БСП (ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки)
// При возможности пересоздает обработку без безопасного режима (ВнешниеОбработки.Создать(..., Ложь))
//
// Параметры:
// ПараметрыВыполнения - Структура - поля ПутьXBRL, ПутьEPF, ИспользоватьТаксономию
// АдресХранилища - Строка - адрес результата во временном хранилище
//
Процедура СформироватьФайлXLSXВФоне(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	Результат = Неопределено;
	ПутьEPF = "";
	Если ПараметрыВыполнения.Свойство("ПутьEPF") Тогда
		ПутьEPF = ПараметрыВыполнения.ПутьEPF;
	КонецЕсли;
	
	ПутьXBRL = "";
	Если ПараметрыВыполнения.Свойство("ПутьXBRL") Тогда
		ПутьXBRL = ПараметрыВыполнения.ПутьXBRL;
	КонецЕсли;
	
	ИспользоватьТаксономию = Ложь;
	Если ПараметрыВыполнения.Свойство("ИспользоватьТаксономию") Тогда
		ИспользоватьТаксономию = ПараметрыВыполнения.ИспользоватьТаксономию = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПутьEPF) Тогда
		Попытка
			ОбработкаБезОграничений = ВнешниеОбработки.Создать(ПутьEPF, Ложь);
			Результат = ОбработкаБезОграничений.СформироватьФайлXLSXИзXBRL(ПутьXBRL, ИспользоватьТаксономию);
		Исключение
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = СформироватьФайлXLSXИзXBRL(ПутьXBRL, ИспользоватьТаксономию);
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
	
	// временные файлы задания (XBRL/EPF) больше не нужны
	УдалитьВременныйФайлБезопасно(ПутьXBRL);
	УдалитьВременныйФайлБезопасно(ПутьEPF);
	
КонецПроцедуры

// Описание: Конвертирует файл XBRL/ZIP ОРТИКОН в двоичные данные XLSX (чисто на 1С)
// В фоне сообщает прогресс через ДлительныеОперации.СообщитьПрогресс
//
// Параметры:
// ПутьКФайлуXBRL - Строка - путь к .xbrl или .zip на сервере
// ИспользоватьТаксономию - Булево - читать вшитую таксономию и подставлять русские подписи
//
// Возвращаемое значение:
// Структура - Успех, ДвоичныеДанные, Описание, ИмяФайла, Секунд
//
Функция СформироватьФайлXLSXИзXBRL(ПутьКФайлуXBRL, ИспользоватьТаксономию = Ложь) Экспорт
	
	Результат = НовыйРезультатКонвертации();
	
	Попытка
		УстановитьБезопасныйРежим(Ложь);
	Исключение
		// продолжаем
	КонецПопытки;
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МеткаЭтапа = ВремяНачала;
	Хронометраж = Новый Соответствие; // имя этапа -> длительность мс
	
	Если Не ЗначениеЗаполнено(ПутьКФайлуXBRL) Тогда
		Результат.Описание = "Не указан файл XBRL/ZIP.";
		Возврат Результат;
	КонецЕсли;
	
	ФайлВход = Новый Файл(ПутьКФайлуXBRL);
	Если Не ФайлВход.Существует() Тогда
		Результат.Описание = "Файл не найден: " + ПутьКФайлуXBRL;
		Возврат Результат;
	КонецЕсли;
	РазмерВходногоФайла = ФайлВход.Размер();
	
	СообщитьПрогрессАбсолютный(5, "Подготовка файла XBRL", ВремяНачала);
	
	ПутьКXBRL = ПутьКФайлуXBRL;
	ВременныйКаталогZIP = "";
	КаталогТаксономии = "";
	ПутьZipТаксономии = "";
	СловарьПодписей = Неопределено;
	ПодписиТаблицТаксономии = Неопределено;
	ПорядокКолонокТаксономии = Неопределено;
	КаталогТаблицEP = Неопределено;
	ТекстТаксономии = "";
	ЧислоПодписейТаксономии = 0;
	ЧислоТаблицEP = 0;
	ЧислоПодписейТаблиц = 0;
	
	Если НРег(ФайлВход.Расширение) = ".zip" Тогда
		РезультатИзвлечения = ИзвлечьXBRLИзZIP(ПутьКФайлуXBRL);
		ПутьКXBRL = РезультатИзвлечения.ПутьКФайлу;
		ВременныйКаталогZIP = РезультатИзвлечения.Каталог;
		МеткаЭтапа = ЗафиксироватьЭтапХронометража(Хронометраж, "Распаковка ZIP XBRL", МеткаЭтапа);
		Если Не ЗначениеЗаполнено(ПутьКXBRL) Тогда
			УдалитьВременныйФайлБезопасно(ВременныйКаталогZIP);
			Результат.Описание = "В ZIP не найден файл .xbrl.";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		
		Если ИспользоватьТаксономию Тогда
			СообщитьПрогрессАбсолютный(8, "Извлечение таксономии из макета", ВремяНачала);
			Извлечение = ИзвлечьТаксономиюИзМакетаВоВременныйФайл();
			Если Не Извлечение.Успех Тогда
				УдалитьВременныйФайлБезопасно(ВременныйКаталогZIP);
				Результат.Описание = Извлечение.Описание;
				Возврат Результат;
			КонецЕсли;
			ПутьZipТаксономии = Извлечение.ПутьКФайлу;
			МеткаЭтапа = ЗафиксироватьЭтапХронометража(Хронометраж, "Извлечение таксономии", МеткаЭтапа);
			
			СообщитьПрогрессАбсолютный(12, "Чтение подписей таксономии", ВремяНачала);
			КаталогТаксономии = РаспаковатьТаксономиюВоВременныйКаталог(ПутьZipТаксономии);
			МетаданныеТаксономии = ЗагрузитьМетаданныеТаксономии(КаталогТаксономии);
			СловарьПодписей = МетаданныеТаксономии.Подписи;
			ПодписиТаблицТаксономии = МетаданныеТаксономии.ПодписиТаблиц;
			ПорядокКолонокТаксономии = МетаданныеТаксономии.ПорядокКолонок;
			ЧислоПодписейТаксономии = СловарьПодписей.Количество();
			Если ПодписиТаблицТаксономии <> Неопределено Тогда
				ЧислоПодписейТаблиц = ПодписиТаблицТаксономии.Количество();
			КонецЕсли;
			МеткаЭтапа = ЗафиксироватьЭтапХронометража(Хронометраж, "Чтение подписей таксономии", МеткаЭтапа);
		КонецЕсли;
		
		СообщитьПрогрессАбсолютный(20, "Чтение XBRL (контексты и факты)", ВремяНачала);
		ДанныеXBRL = ПрочитатьДанныеXBRL(ПутьКXBRL, ВремяНачала);
		МеткаЭтапа = ЗафиксироватьЭтапХронометража(Хронометраж, "Чтение XBRL", МеткаЭтапа);
		
		Если ИспользоватьТаксономию Тогда
			СообщитьПрогрессАбсолютный(65, "Каталог таблиц точки входа (EP)", ВремяНачала);
			КаталогТаблицEP = ЗагрузитьКаталогТаблицИзТочкиВхода(
				КаталогТаксономии,
				ДанныеXBRL.SchemaRef);
			// порядок колонок по точному ключу SR_* из EP (не только 0420431)
			Если ПорядокКолонокТаксономии = Неопределено Тогда
				ПорядокКолонокТаксономии = Новый Соответствие;
			КонецЕсли;
			Для Каждого ЗаписьEP Из КаталогТаблицEP Цикл
				Если ЗаписьEP.ConceptOrder.Количество() > 0 Тогда
					ПорядокКолонокТаксономии.Вставить(ЗаписьEP.Ключ, ЗаписьEP.ConceptOrder);
				КонецЕсли;
			КонецЦикла;
			ЧислоТаблицEP = КаталогТаблицEP.Количество();
			ТекстТаксономии = СтрШаблон(
				" Таксономия: %1, подписей: %2, таблиц EP: %3.",
				ИмяМакетаТаксономии(),
				Формат(ЧислоПодписейТаксономии, "ЧГ=0"),
				Формат(ЧислоТаблицEP, "ЧГ=0"));
			МеткаЭтапа = ЗафиксироватьЭтапХронометража(Хронометраж, "Каталог таблиц EP", МеткаЭтапа);
		КонецЕсли;
		
		СообщитьПрогрессАбсолютный(70, "Сборка листов Excel", ВремяНачала);
		Листы = СобратьЛистыИзДанныхXBRL(
			ДанныеXBRL,
			ПорядокКолонокТаксономии,
			СловарьПодписей,
			КаталогТаблицEP);
		МеткаЭтапа = ЗафиксироватьЭтапХронометража(Хронометраж, "Сборка листов", МеткаЭтапа);
		
		СообщитьПрогрессАбсолютный(75, "Формирование и запись XLSX", ВремяНачала);
		ДвоичныеДанные = ЗаписатьЛистыВXLSX(
			Листы,
			ДанныеXBRL,
			ВремяНачала,
			СловарьПодписей,
			ИспользоватьТаксономию,
			ПодписиТаблицТаксономии,
			Хронометраж);
		
	Исключение
		УдалитьВременныйФайлБезопасно(ВременныйКаталогZIP);
		УдалитьВременныйФайлБезопасно(ПутьZipТаксономии);
		УдалитьВременныйФайлБезопасно(КаталогТаксономии);
		Результат.Описание = "Ошибка конвертации XBRL: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	УдалитьВременныйФайлБезопасно(ВременныйКаталогZIP);
	УдалитьВременныйФайлБезопасно(ПутьZipТаксономии);
	УдалитьВременныйФайлБезопасно(КаталогТаксономии);
	
	Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
		Результат.Описание = "Получен пустой файл XLSX.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДлительныеОперации.СообщитьПрогресс(100, "Готово");
	Исключение
		// вне фона прогресс недоступен
	КонецПопытки;
	
	Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	СтатистикаЛистов = СобратьСтатистикуЛистовXBRL(Листы);
	СтатистикаXBRL = СобратьСтатистикуДанныхXBRL(ДанныеXBRL);
	
	Результат.Успех = Истина;
	Результат.ДвоичныеДанные = ДвоичныеДанные;
	Результат.ИмяФайла = "XBRL_Orticon_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss") + ".xlsx";
	Результат.Секунд = Секунд;
	РежимТекст = ?(ИспользоватьТаксономию, "режим таксономии", "быстрый режим");
	Результат.Описание = СобратьТекстИтогаКонвертацииXBRL(
		РежимТекст,
		Секунд,
		ДвоичныеДанные.Размер(),
		РазмерВходногоФайла,
		ФайлВход.Имя,
		СтатистикаЛистов,
		СтатистикаXBRL,
		Хронометраж,
		ИспользоватьТаксономию,
		ЧислоПодписейТаксономии,
		ЧислоПодписейТаблиц,
		ЧислоТаблицEP,
		ДанныеXBRL.SchemaRef);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатКонвертации()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ДвоичныеДанные", Неопределено);
	Результат.Вставить("Описание", "");
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("Секунд", 0);
	Возврат Результат;
	
КонецФункции

// Описание: Фиксирует длительность этапа в мс и возвращает новую метку времени
//
Функция ЗафиксироватьЭтапХронометража(Хронометраж, ИмяЭтапа, МеткаНачалаМс)
	
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Хронометраж <> Неопределено И ЗначениеЗаполнено(ИмяЭтапа) Тогда
		Длительность = Сейчас - МеткаНачалаМс;
		Если Длительность < 0 Тогда
			Длительность = 0;
		КонецЕсли;
		Было = Хронометраж.Получить(ИмяЭтапа);
		Если Было = Неопределено Тогда
			Хронометраж.Вставить(ИмяЭтапа, Длительность);
		Иначе
			Хронометраж.Вставить(ИмяЭтапа, Было + Длительность);
		КонецЕсли;
	КонецЕсли;
	Возврат Сейчас;
	
КонецФункции

Функция ФорматСекундИзМиллисекунд(Миллисекунды)
	
	Возврат Формат(Число(Миллисекунды) / 1000, "ЧДЦ=1; ЧН=0; ЧГ=0");
	
КонецФункции

Функция ФорматРазмераБайт(РазмерБайт)
	
	Размер = Число(РазмерБайт);
	Если Размер >= 1048576 Тогда
		Возврат Формат(Размер / 1048576, "ЧДЦ=2; ЧН=0; ЧГ=0") + " МБ ("
			+ Формат(Размер, "ЧГ=0") + " байт)";
	ИначеЕсли Размер >= 1024 Тогда
		Возврат Формат(Размер / 1024, "ЧДЦ=1; ЧН=0; ЧГ=0") + " КБ ("
			+ Формат(Размер, "ЧГ=0") + " байт)";
	КонецЕсли;
	Возврат Формат(Размер, "ЧГ=0") + " байт";
	
КонецФункции

Функция СобратьСтатистикуЛистовXBRL(Листы)
	
	Результат = Новый Структура;
	Результат.Вставить("Всего", 0);
	Результат.Вставить("СДанными", 0);
	Результат.Вставить("Пустых", 0);
	Результат.Вставить("Строк", 0);
	
	Если Листы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КЗ Из Листы Цикл
		Результат.Всего = Результат.Всего + 1;
		ЧислоСтрок = КЗ.Значение.Rows.Количество();
		Результат.Строк = Результат.Строк + ЧислоСтрок;
		Если ЧислоСтрок > 0 Тогда
			Результат.СДанными = Результат.СДанными + 1;
		Иначе
			Результат.Пустых = Результат.Пустых + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СобратьСтатистикуДанныхXBRL(ДанныеXBRL)
	
	Результат = Новый Структура;
	Результат.Вставить("Контекстов", 0);
	Результат.Вставить("Фактов", 0);
	Результат.Вставить("Период", "");
	Результат.Вставить("Организация", "");
	
	Если ДанныеXBRL = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Контекстов = ДанныеXBRL.Контексты.Количество();
	Для Каждого КЗ Из ДанныеXBRL.Факты Цикл
		Результат.Фактов = Результат.Фактов + КЗ.Значение.Количество();
	КонецЦикла;
	
	Для Каждого КЗ Из ДанныеXBRL.Контексты Цикл
		Если Не ЗначениеЗаполнено(Результат.Период) И ЗначениеЗаполнено(КЗ.Значение.Period) Тогда
			Результат.Период = Строка(КЗ.Значение.Period);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Результат.Организация) И ЗначениеЗаполнено(КЗ.Значение.Entity) Тогда
			Результат.Организация = Строка(КЗ.Значение.Entity);
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.Период) И ЗначениеЗаполнено(Результат.Организация) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СобратьТекстИтогаКонвертацииXBRL(РежимТекст, СекундВсего, РазмерXLSX, РазмерВхода, ИмяВхода,
	СтатистикаЛистов, СтатистикаXBRL, Хронометраж, ИспользоватьТаксономию,
	ЧислоПодписей, ЧислоПодписейТаблиц, ЧислоТаблицEP, SchemaRef)
	
	ПС = Символы.ПС;
	Части = Новый Массив;
	Части.Добавить("внВыгрузкаXBRLОртиконВXLSX v" + ВерсияОбработки() + " (" + РежимТекст + ")");
	Части.Добавить("Вход: " + ИмяВхода + ", " + ФорматРазмераБайт(РазмерВхода));
	Части.Добавить("Выход XLSX: " + ФорматРазмераБайт(РазмерXLSX));
	Части.Добавить("Время всего: " + Формат(СекундВсего, "ЧДЦ=1; ЧН=0; ЧГ=0") + " сек.");
	Части.Добавить(СтрШаблон(
		"Листы: всего %1 (с данными %2, пустых %3), строк данных: %4.",
		Формат(СтатистикаЛистов.Всего, "ЧГ=0"),
		Формат(СтатистикаЛистов.СДанными, "ЧГ=0"),
		Формат(СтатистикаЛистов.Пустых, "ЧГ=0"),
		Формат(СтатистикаЛистов.Строк, "ЧГ=0")));
	Части.Добавить(СтрШаблон(
		"XBRL: контекстов %1, фактов %2.",
		Формат(СтатистикаXBRL.Контекстов, "ЧГ=0"),
		Формат(СтатистикаXBRL.Фактов, "ЧГ=0")));
	Если ЗначениеЗаполнено(СтатистикаXBRL.Период) Тогда
		Части.Добавить("Период: " + СтатистикаXBRL.Период);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтатистикаXBRL.Организация) Тогда
		Части.Добавить("Организация: " + СтатистикаXBRL.Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(SchemaRef) Тогда
		Части.Добавить("SchemaRef: " + SchemaRef);
	КонецЕсли;
	Если ИспользоватьТаксономию Тогда
		Части.Добавить(СтрШаблон(
			"Таксономия: %1; подписей dic: %2; словарей таблиц: %3; таблиц EP: %4.",
			ИмяМакетаТаксономии(),
			Формат(ЧислоПодписей, "ЧГ=0"),
			Формат(ЧислоПодписейТаблиц, "ЧГ=0"),
			Формат(ЧислоТаблицEP, "ЧГ=0")));
	КонецЕсли;
	
	Части.Добавить("Этапы (сек):");
	ПорядокЭтапов = Новый Массив;
	ПорядокЭтапов.Добавить("Распаковка ZIP XBRL");
	ПорядокЭтапов.Добавить("Извлечение таксономии");
	ПорядокЭтапов.Добавить("Чтение подписей таксономии");
	ПорядокЭтапов.Добавить("Чтение XBRL");
	ПорядокЭтапов.Добавить("Каталог таблиц EP");
	ПорядокЭтапов.Добавить("Сборка листов");
	ПорядокЭтапов.Добавить("Формирование листов Excel");
	ПорядокЭтапов.Добавить("Запись пакета XLSX");
	ПорядокЭтапов.Добавить("Гиперссылки TOC");
	ПорядокЭтапов.Добавить("Чтение XLSX в память");
	
	Если Хронометраж <> Неопределено Тогда
		Для Каждого ИмяЭтапа Из ПорядокЭтапов Цикл
			Мс = Хронометраж.Получить(ИмяЭтапа);
			Если Мс = Неопределено Или Мс <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Части.Добавить("  - " + ИмяЭтапа + ": " + ФорматСекундИзМиллисекунд(Мс));
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрСоединить(Части, ПС);
	
КонецФункции

Функция ИзвлечьXBRLИзZIP(ПутьZIP)
	
	Результат = Новый Структура("ПутьКФайлу, Каталог", "", "");
	
	Каталог = ПолучитьИмяВременногоФайла("") + ПолучитьРазделительПути();
	СоздатьКаталог(Каталог);
	Результат.Каталог = Каталог;
	
	ЧтениеZip = Новый ЧтениеZipФайла(ПутьZIP);
	ИмяXBRL = "";
	Для Каждого Элемент Из ЧтениеZip.Элементы Цикл
		Если СтрЗаканчиваетсяНа(НРег(Элемент.Имя), ".xbrl") Тогда
			ЧтениеZip.Извлечь(Элемент, Каталог);
			ИмяXBRL = Каталог + Элемент.Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЧтениеZip.Закрыть();
	
	Результат.ПутьКФайлу = ПривестиПолныйПутьФайлаИзZIP(ИмяXBRL, Каталог);
	Возврат Результат;
	
КонецФункции

Функция ПривестиПолныйПутьФайлаИзZIP(ИмяXBRL, Каталог)
	
	Если Не ЗначениеЗаполнено(ИмяXBRL) Тогда
		Возврат "";
	КонецЕсли;
	
	Файл = Новый Файл(ИмяXBRL);
	Если Файл.Существует() Тогда
		Возврат ИмяXBRL;
	КонецЕсли;
	
	// вложенные пути в zip
	Найденные = НайтиФайлы(Каталог, "*.xbrl", Истина);
	Если Найденные.Количество() > 0 Тогда
		Возврат Найденные[0].ПолноеИмя;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

