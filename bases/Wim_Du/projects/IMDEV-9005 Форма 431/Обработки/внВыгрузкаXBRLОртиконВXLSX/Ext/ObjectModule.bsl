#Область УтилитыXML

Функция ЗначениеАтрибутаЧтенияXML(Чтение, ИмяАтрибута)
	
	Попытка
		Возврат Чтение.ПолучитьАтрибут(ИмяАтрибута);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ЗначениеHrefСхемыXBRL(Чтение)
	
	Значение = ЗначениеАтрибутаЧтенияXML(Чтение, "href");
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Значение = ЗначениеАтрибутаЧтенияXML(Чтение, "xlink:href");
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Попытка
		Возврат Чтение.ПолучитьАтрибут("http://www.w3.org/1999/xlink", "href");
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ПрочитатьТекстЭлементаXML(Чтение, ИмяЭлемента)
	
	Значение = "";
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			Значение = Значение + Чтение.Значение;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.ЛокальноеИмя = ИмяЭлемента Тогда
			Прервать;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ПропуститьЭлементXML(Чтение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СокрЛП(Значение);
	
КонецФункции

Процедура ПропуститьЭлементXML(Чтение)
	
	Имя = Чтение.ЛокальноеИмя;
	Глубина = 1;
	
	Пока Глубина > 0 И Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЛокальноеИмяИзQName(Значение)
	
	Текст = СокрЛП(Строка(Значение));
	Если Текст = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Если СтрНайти(Текст, "}") > 0 Тогда
		Части = СтрРазделить(Текст, "}");
		Текст = Части[Части.ВГраница()];
	КонецЕсли;
	
	Если СтрНайти(Текст, ":") > 0 Тогда
		Части = СтрРазделить(Текст, ":");
		Текст = Части[Части.ВГраница()];
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция КлючСигнатурыОсей(Dims)
	
	Если Dims.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Имена = Новый Массив;
	Для Каждого КЗ Из Dims Цикл
		Имена.Добавить(КЗ.Ключ);
	КонецЦикла;
	
	Список = Новый СписокЗначений;
	Для Каждого Имя Из Имена Цикл
		Список.Добавить(Имя);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	
	Части = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Части.Добавить(Элемент.Значение);
	КонецЦикла;
	
	Возврат СтрСоединить(Части, "|");
	
КонецФункции

Функция ИмяКолонкиИзмерения(ИмяОси)
	
	Имя = ИмяОси;
	Имя = СтрЗаменить(Имя, "Taxis", "");
	Имя = СтрЗаменить(Имя, "Axis", "");
	Возврат Имя;
	
КонецФункции

// Описание: Представление члена taxonomy как в эталоне ЦБ (643, 156-CNY, а не "Россия"/"Юань")
//
Функция ПредставлениеЧленаXBRL(Значение, СловарьПодписей = Неопределено)
	
	ЛокальноеИмя = ЛокальноеИмяИзQName(Значение);
	Если Не ЗначениеЗаполнено(ЛокальноеИмя) Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;
	
	// эталон ЦБ для валюты/страны берет коды (из имени члена / code-label),
	// а не verbose RU из dictionary-label ("Юань", "Россия")
	Код = КодЧленаИзИмени(ЛокальноеИмя);
	Если ЗначениеЗаполнено(Код) Тогда
		Возврат Код;
	КонецЕсли;
	
	Подпись = ПодписьЧленаИзСловаря(ЛокальноеИмя, СловарьПодписей);
	Если ЗначениеЗаполнено(Подпись) Тогда
		Если ЭтоКодоподобнаяПодписьЧлена(Подпись) Тогда
			Возврат Подпись;
		КонецЕсли;
		// verbose RU оставляем только если кода нет (прочие члены: вид счета и т.п.)
		Возврат Подпись;
	КонецЕсли;
	
	Возврат ОчеловечитьЧлен(ЛокальноеИмя);
	
КонецФункции

Функция ЭтоКодоподобнаяПодписьЧлена(Текст)
	
	Значение = СокрЛП(Строка(Текст));
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// 643 | 156-CNY | 643-RUB
	Если СтрДлина(Значение) <= 12 Тогда
		ЕстьЦифра = Ложь;
		Для Индекс = 1 По СтрДлина(Значение) Цикл
			Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) > 0 Тогда
				ЕстьЦифра = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьЦифра И СтрНайти(Значение, " ") = 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПодписьЧленаИзСловаря(ЛокальноеИмя, СловарьПодписей)
	
	Если СловарьПодписей = Неопределено Или Не ЗначениеЗаполнено(ЛокальноеИмя) Тогда
		Возврат "";
	КонецЕсли;
	
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(ЛокальноеИмя);
	Если СтрЗаканчиваетсяНа(ЛокальноеИмя, "Member") Тогда
		Кандидаты.Добавить(Лев(ЛокальноеИмя, СтрДлина(ЛокальноеИмя) - 6));
	Иначе
		Кандидаты.Добавить(ЛокальноеИмя + "Member");
	КонецЕсли;
	
	Текст = ЛучшаяПодписьИзСловаря(Кандидаты, СловарьПодписей);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	// "Российский рубль [member]" -> без хвоста
	Хвост = " [member]";
	Если СтрЗаканчиваетсяНа(НРег(Текст), НРег(Хвост)) Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - СтрДлина(Хвост));
	КонецЕсли;
	
	Возврат СокрЛП(Текст);
	
КонецФункции

Функция КодЧленаИзИмени(ЛокальноеИмя)
	
	Имя = ЛокальноеИмя;
	Если СтрЗаканчиваетсяНа(Имя, "Member") Тогда
		Имя = Лев(Имя, СтрДлина(Имя) - 6);
	КонецЕсли;
	
	// Valyuta_643RubRossijskijRubl / Valyuta_156CnyYUan -> 643-RUB / 156-CNY
	Если СтрНачинаетсяС(Имя, "Valyuta_") Тогда
		Хвост = Сред(Имя, 9);
		Код = "";
		Поз = 1;
		Пока Поз <= СтрДлина(Хвост) Цикл
			Символ = Сред(Хвост, Поз, 1);
			Если СтрНайти("0123456789", Символ) = 0 Тогда
				Прервать;
			КонецЕсли;
			Код = Код + Символ;
			Поз = Поз + 1;
		КонецЦикла;
		Буквы = "";
		Пока Поз <= СтрДлина(Хвост) И СтрДлина(Буквы) < 3 Цикл
			Символ = Сред(Хвост, Поз, 1);
			Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", Символ) = 0 Тогда
				Прервать;
			КонецЕсли;
			Буквы = Буквы + Символ;
			Поз = Поз + 1;
		КонецЦикла;
		Если ЗначениеЗаполнено(Код) И СтрДлина(Буквы) = 3 Тогда
			Возврат Код + "-" + ВРег(Буквы);
		КонецЕсли;
		Если ЗначениеЗаполнено(Код) Тогда
			Возврат Код;
		КонецЕсли;
	КонецЕсли;
	
	// Strana_643RusRossiya / OKSM-подобные -> 643 (как в эталоне)
	Если СтрНачинаетсяС(Имя, "Strana_") Тогда
		Хвост = Сред(Имя, 8);
		Код = "";
		Для Индекс = 1 По СтрДлина(Хвост) Цикл
			Символ = Сред(Хвост, Индекс, 1);
			Если СтрНайти("0123456789", Символ) = 0 Тогда
				Прервать;
			КонецЕсли;
			Код = Код + Символ;
		КонецЦикла;
		Если ЗначениеЗаполнено(Код) Тогда
			Возврат Код;
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ОчеловечитьЧлен(Значение)
	
	Текст = ЛокальноеИмяИзQName(Значение);
	Если СтрЗаканчиваетсяНа(Текст, "Member") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 6);
	ИначеЕсли СтрЗаканчиваетсяНа(Текст, "MEMBER") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 6);
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "_", " ");
	Возврат Текст;
	
КонецФункции

Функция НормализоватьЗначениеФакта(Значение, СловарьПодписей = Неопределено)
	
	Текст = СокрЛП(Строка(Значение));
	Если СтрНайти(Текст, ":") > 0 И (СтрНайти(Текст, "Member") > 0 Или СтрНачинаетсяС(НРег(Текст), "mem-")) Тогда
		Возврат ПредставлениеЧленаXBRL(Текст, СловарьПодписей);
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

Процедура ДобавитьКолонкуЕслиНет(Корзина, ИмяКолонки)
	
	Если Корзина.ColSet.Получить(ИмяКолонки) = Неопределено Тогда
		Корзина.ColSet.Вставить(ИмяКолонки, Истина);
		Корзина.Columns.Добавить(ИмяКолонки);
	КонецЕсли;
	
КонецПроцедуры

Функция УникальноеИмяЛистаExcel(Имя, ИспользованныеИмена)
	
	ИмяЛиста = Строка(Имя);
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "\", " ");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "/", " ");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "?", " ");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "*", " ");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "[", " ");
	ИмяЛиста = СтрЗаменить(ИмяЛиста, "]", " ");
	ИмяЛиста = СокрЛП(ИмяЛиста);
	
	Если Не ЗначениеЗаполнено(ИмяЛиста) Тогда
		ИмяЛиста = "Лист";
	КонецЕсли;
	
	Если СтрДлина(ИмяЛиста) > 31 Тогда
		ИмяЛиста = Лев(ИмяЛиста, 31);
	КонецЕсли;
	
	База = ИмяЛиста;
	Номер = 1;
	Пока ИспользованныеИмена.Получить(ИмяЛиста) = Истина Цикл
		Суффикс = "_" + Формат(Номер, "ЧГ=0");
		ИмяЛиста = Лев(База, 31 - СтрДлина(Суффикс)) + Суффикс;
		Номер = Номер + 1;
	КонецЦикла;
	
	ИспользованныеИмена.Вставить(ИмяЛиста, Истина);
	Возврат ИмяЛиста;
	
КонецФункции

Процедура ОформитьЗаголовок(ТабДок, НомерСтроки, КоличествоКолонок)
	
	// ВАЖНО про ПакетОтображаемыхДокументов.XLSX:
	// - РазмещениеТекста=Переносить + ШиринаКолонки -> экспорт делает merge (A1:F1 и т.п.)
	//   и сдвигает данные по строкам. Объединять нельзя (автофильтр).
	// Читаемость: вставляем переносы строк (ПС) в текст заголовка вручную,
	// не трогаем ШиринаКолонки и не включаем Переносить.
	// Оставшийся артефакт (merge последней колонки) снимается в постобработке XLSX.
	МаксЧислоСтрок = 1;
	Для НомерКолонки = 1 По КоличествоКолонок Цикл
		Область = ТабДок.Область(НомерСтроки, НомерКолонки);
		ТекстЗаголовка = СокрЛП(Строка(Область.Текст));
		ТекстСПереносами = РазбитьТекстЗаголовкаПоСтрокам(ТекстЗаголовка, 28);
		Область.СодержитЗначение = Ложь;
		Область.Текст = ТекстСПереносами;
		Область.Шрифт = Новый Шрифт(Область.Шрифт, , , Истина);
		Область.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
		
		ЧислоСтрок = СтрЧислоСтрок(ТекстСПереносами);
		Если ЧислоСтрок > МаксЧислоСтрок Тогда
			МаксЧислоСтрок = ЧислоСтрок;
		КонецЕсли;
	КонецЦикла;
	
	Если МаксЧислоСтрок > 6 Тогда
		МаксЧислоСтрок = 6;
	КонецЕсли;
	ЯчейкаВысоты = ТабДок.Область(НомерСтроки, 1);
	ЯчейкаВысоты.АвтоВысотаСтроки = Ложь;
	ЯчейкаВысоты.ВысотаСтроки = 14 * Макс(МаксЧислоСтрок, 2);
	
КонецПроцедуры

// Описание: Разбивает длинный заголовок на строки по ~Ширина символов (по пробелам)
//
Функция РазбитьТекстЗаголовкаПоСтрокам(Текст, ШиринаСтроки)
	
	Исходный = СокрЛП(Строка(Текст));
	Если Не ЗначениеЗаполнено(Исходный) Или СтрДлина(Исходный) <= ШиринаСтроки Тогда
		Возврат Исходный;
	КонецЕсли;
	
	Слова = СтрРазделить(Исходный, " ", Ложь);
	Если Слова.Количество() <= 1 Тогда
		Возврат Исходный;
	КонецЕсли;
	
	Строки = Новый Массив;
	Текущая = "";
	Для Каждого Слово Из Слова Цикл
		Если Не ЗначениеЗаполнено(Текущая) Тогда
			Текущая = Слово;
		ИначеЕсли СтрДлина(Текущая) + 1 + СтрДлина(Слово) <= ШиринаСтроки Тогда
			Текущая = Текущая + " " + Слово;
		Иначе
			Строки.Добавить(Текущая);
			Текущая = Слово;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Текущая) Тогда
		Строки.Добавить(Текущая);
	КонецЕсли;
	
	Возврат РазделитьМассивСтрокПереносами(Строки);
	
КонецФункции

Функция РазделитьМассивСтрокПереносами(Строки)
	
	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = Строки[0];
	Для Индекс = 1 По Строки.ВГраница() Цикл
		Результат = Результат + Символы.ПС + Строки[Индекс];
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
