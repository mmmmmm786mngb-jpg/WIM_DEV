#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
		ДополнительнаяОбработкаСсылка = Параметры.ДополнительнаяОбработкаСсылка;
	КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Версия = ОбработкаОбъект.ВерсияОбработки();
	
	Элементы.НадписьЗаголовок.Заголовок =
		"Выгрузка XBRL ОРТИКОН в Excel"
		+ Символы.ПС
		+ "АО ВИМ Инвестиции | версия " + Версия + " | только 1С";
	
	СтатусВыгрузки =
		"Версия: " + Версия + Символы.ПС
		+ "Конвертация выполняется полностью на платформе 1С (без Python)." + Символы.ПС
		+ "Выберите файл .xbrl / .zip ОРТИКОН и нажмите ""Конвертировать в XLSX""." + Символы.ПС
		+ "Ход работы отображается в окне прогресса БСП (процент и оценка остатка)." + Символы.ПС
		+ "Рекомендуется открывать из ""Дополнительные отчеты и обработки"" (БезопасныйРежим = Ложь).";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайлXBRL(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Файл XBRL ОРТИКОН";
	Диалог.Фильтр =
		"XBRL / ZIP (*.xbrl;*.zip)|*.xbrl;*.zip|XBRL (*.xbrl)|*.xbrl|ZIP (*.zip)|*.zip|Все файлы (*.*)|*.*";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлуXBRL = Диалог.ПолноеИмяФайла;
	СтатусВыгрузки = "Выбран файл:" + Символы.ПС + ПутьКФайлуXBRL;
	
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьВXLSX(Команда)
	
	Если Не ЗначениеЗаполнено(ПутьКФайлуXBRL) Тогда
		ПоказатьПредупреждение(, "Выберите файл XBRL или ZIP.");
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить Excel";
	Диалог.Фильтр = "Книга Excel (*.xlsx)|*.xlsx";
	Диалог.ПолноеИмяФайла = "XBRL_Orticon.xlsx";
	Диалог.Расширение = "xlsx";
	
	Если Не Диалог.Выбрать() Тогда
		СтатусВыгрузки = "Сохранение отменено.";
		Возврат;
	КонецЕсли;
	
	ПутьСохранения = Диалог.ПолноеИмяФайла;
	СтатусВыгрузки = "Запуск конвертации...";
	
	АдресФайлаОбработки = "";
	ПутьКФайлуОбработки = ПолучитьИспользуемоеИмяФайлаНаСервере();
	
	Если ЗначениеЗаполнено(ПутьКФайлуОбработки) Тогда
		Попытка
			Если Не ПоместитьФайл(АдресФайлаОбработки, ПутьКФайлуОбработки, , Ложь, УникальныйИдентификатор) Тогда
				АдресФайлаОбработки = "";
			КонецЕсли;
		Исключение
			АдресФайлаОбработки = "";
		КонецПопытки;
	КонецЕсли;
	
	АдресФайлаXBRL = "";
	Попытка
		Если Не ПоместитьФайл(АдресФайлаXBRL, ПутьКФайлуXBRL, , Ложь, УникальныйИдентификатор) Тогда
			ПоказатьПредупреждение(, "Не удалось передать XBRL на сервер.");
			Возврат;
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, "Не удалось передать XBRL на сервер: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ЗапуститьКонвертациюПослеПодготовки(ПутьСохранения, АдресФайлаОбработки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапуститьКонвертациюПослеПодготовки(ПутьСохранения, АдресФайлаОбработки)
	
	ДлительнаяОперация = НачатьКонвертациюВФонеНаСервере(АдресФайлаОбработки);
	Если ДлительнаяОперация = Неопределено Тогда
		СтатусВыгрузки = "Фоновое задание недоступно - выполняется синхронная конвертация...";
		ВыполнитьСинхроннуюКонвертацию(ПутьСохранения);
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ТекстСообщения = "Конвертация XBRL ОРТИКОН в XLSX...";
	
	Оповещение = Новый ОписаниеОповещения(
		"КонвертацияВФонеЗавершение",
		ЭтотОбъект,
		Новый Структура("ПутьСохранения", ПутьСохранения));
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура КонвертацияВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		СтатусВыгрузки = "Конвертация отменена.";
		Возврат;
	КонецЕсли;
	
	ЗавершитьКонвертациюПоРезультату(Результат, ДополнительныеПараметры.ПутьСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьКонвертациюПоРезультату(РезультатОперации, ПутьСохранения)
	
	Если РезультатОперации.Статус = "Ошибка" Тогда
		
		ТекстОшибки = РезультатОперации.КраткоеПредставлениеОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Ошибка фоновой конвертации.";
		КонецЕсли;
		
		ТекстОшибкиНРег = НРег(ТекстОшибки);
		Если СтрНайти(ТекстОшибкиНРег, "каталог не обнаружен") > 0
			Или СтрНайти(ТекстОшибкиНРег, "файл не обнаружен") > 0
			Или СтрНайти(ТекстОшибкиНРег, ".epf") > 0 Тогда
			
			СтатусВыгрузки = "Фон недоступен (локальный путь к EPF), выполняется синхронная конвертация.";
			ВыполнитьСинхроннуюКонвертацию(ПутьСохранения);
			Возврат;
			
		КонецЕсли;
		
		СтатусВыгрузки = ТекстОшибки;
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
		
	КонецЕсли;
	
	Если РезультатОперации.Статус = "Отменено" Тогда
		СтатусВыгрузки = "Конвертация отменена.";
		Возврат;
	КонецЕсли;
	
	РезультатКонвертации = ПолучитьРезультатКонвертацииНаСервере(РезультатОперации.АдресРезультата);
	СохранитьРезультатВФайл(РезультатКонвертации, ПутьСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСинхроннуюКонвертацию(ПутьСохранения)
	
	СтатусВыгрузки = "Синхронная конвертация (без окна прогресса)...";
	РезультатКонвертации = ВыполнитьСинхроннуюКонвертациюНаСервере();
	СохранитьРезультатВФайл(РезультатКонвертации, ПутьСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьРезультатВФайл(РезультатКонвертации, ПутьСохранения)
	
	Если Не РезультатКонвертации.Успех Тогда
		СтатусВыгрузки = РезультатКонвертации.Описание;
		ПоказатьПредупреждение(, РезультатКонвертации.Описание);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РезультатКонвертации.АдресДанных) Тогда
		ТекстОшибки = "Нет данных для сохранения файла.";
		СтатусВыгрузки = ТекстОшибки;
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Попытка
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(РезультатКонвертации.АдресДанных);
		Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
			ТекстОшибки = "Пустые двоичные данные XLSX - файл не сохранен.";
			СтатусВыгрузки = ТекстОшибки;
			ПоказатьПредупреждение(, ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		ДвоичныеДанные.Записать(ПутьСохранения);
		СтатусВыгрузки = РезультатКонвертации.Описание
			+ Символы.ПС
			+ "Файл: "
			+ ПутьСохранения
			+ Символы.ПС
			+ "Размер: "
			+ Формат(ДвоичныеДанные.Размер(), "ЧГ=0")
			+ " байт";
		ПоказатьПредупреждение(, "Файл сохранен:" + Символы.ПС + ПутьСохранения);
	Исключение
		ТекстОшибки = "Не удалось сохранить файл: " + ОписаниеОшибки();
		СтатусВыгрузки = ТекстОшибки;
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИспользуемоеИмяФайлаНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ИспользуемоеИмяФайла;
	
КонецФункции

&НаСервере
Функция ПодготовитьПутьXBRLНаСервере()
	
	Если Не ЗначениеЗаполнено(АдресФайлаXBRL) Тогда
		Возврат "";
	КонецЕсли;
	
	ДвоичныеДанныеXBRL = ПолучитьИзВременногоХранилища(АдресФайлаXBRL);
	Если ДвоичныеДанныеXBRL = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Расширение = "xbrl";
	Если ЗначениеЗаполнено(ПутьКФайлуXBRL) Тогда
		ФайлКлиента = Новый Файл(ПутьКФайлуXBRL);
		Если НРег(ФайлКлиента.Расширение) = ".zip" Тогда
			Расширение = "zip";
		КонецЕсли;
	КонецЕсли;
	
	ПутьНаСервере = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанныеXBRL.Записать(ПутьНаСервере);
	Возврат ПутьНаСервере;
	
КонецФункции

&НаСервере
Функция НачатьКонвертациюВФонеНаСервере(АдресФайлаОбработки)
	
	ПутьXBRLНаСервере = ПодготовитьПутьXBRLНаСервере();
	Если Не ЗначениеЗаполнено(ПутьXBRLНаСервере) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ПутьXBRL", ПутьXBRLНаСервере);
	ПараметрыМетода.Вставить("ПутьEPF", "");
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяМетода", "СформироватьФайлXLSXВФоне");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыМетода);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
	ПараметрыЗадания.Вставить("ИмяОбработки", "");
	ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", Неопределено);
	
	Если ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		
		ПараметрыЗадания.ДополнительнаяОбработкаСсылка = ДополнительнаяОбработкаСсылка;
		
	Иначе
		
		ИмяФайлаОбработки = "";
		
		Если ЗначениеЗаполнено(АдресФайлаОбработки) Тогда
			
			Попытка
				ДвоичныеДанныеEPF = ПолучитьИзВременногоХранилища(АдресФайлаОбработки);
				ИмяФайлаОбработки = ПолучитьИмяВременногоФайла("epf");
				ДвоичныеДанныеEPF.Записать(ИмяФайлаОбработки);
			Исключение
				Возврат Неопределено;
			КонецПопытки;
			
		Иначе
			
			ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
			КандидатПути = ОбработкаОбъект.ИспользуемоеИмяФайла;
			
			Если Не ЗначениеЗаполнено(КандидатПути) Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			ФайлНаСервере = Новый Файл(КандидатПути);
			Если Не ФайлНаСервере.Существует() Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Попытка
				ДвоичныеДанныеEPF = Новый ДвоичныеДанные(КандидатПути);
				ИмяФайлаОбработки = ПолучитьИмяВременногоФайла("epf");
				ДвоичныеДанныеEPF.Записать(ИмяФайлаОбработки);
			Исключение
				Возврат Неопределено;
			КонецПопытки;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ИмяФайлаОбработки) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПараметрыМетода.ПутьEPF = ИмяФайлаОбработки;
		ПараметрыЗадания.ИмяОбработки = ИмяФайлаОбработки;
		
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Конвертация XBRL ОРТИКОН в XLSX";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Попытка
		Возврат ДлительныеОперации.ВыполнитьВФоне(
			"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			ПараметрыЗадания,
			ПараметрыВыполнения);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПолучитьРезультатКонвертацииНаСервере(АдресРезультата)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Описание", "Пустой результат конвертации.");
	Результат.Вставить("АдресДанных", "");
	
	ДанныеРезультата = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(ДанныеРезультата) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = ДанныеРезультата.Успех;
	Результат.Описание = ДанныеРезультата.Описание;
	
	Если ДанныеРезультата.Успех И ДанныеРезультата.ДвоичныеДанные <> Неопределено Тогда
		Результат.АдресДанных = ПоместитьВоВременноеХранилище(
			ДанныеРезультата.ДвоичныеДанные,
			УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВыполнитьСинхроннуюКонвертациюНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Описание", "");
	Результат.Вставить("АдресДанных", "");
	
	ПутьНаСервере = ПодготовитьПутьXBRLНаСервере();
	Если Не ЗначениеЗаполнено(ПутьНаСервере) Тогда
		Результат.Описание = "Не удалось подготовить файл XBRL на сервере.";
		Возврат Результат;
	КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатКонвертации = ОбработкаОбъект.СформироватьФайлXLSXИзXBRL(ПутьНаСервере);
	
	Попытка
		УдалитьФайлы(ПутьНаСервере);
	Исключение
		// temp
	КонецПопытки;
	
	Результат.Описание = РезультатКонвертации.Описание;
	Если РезультатКонвертации.Успех
		И РезультатКонвертации.ДвоичныеДанные <> Неопределено
		И РезультатКонвертации.ДвоичныеДанные.Размер() > 0 Тогда
		
		Результат.Успех = Истина;
		Результат.АдресДанных = ПоместитьВоВременноеХранилище(
			РезультатКонвертации.ДвоичныеДанные,
			УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
