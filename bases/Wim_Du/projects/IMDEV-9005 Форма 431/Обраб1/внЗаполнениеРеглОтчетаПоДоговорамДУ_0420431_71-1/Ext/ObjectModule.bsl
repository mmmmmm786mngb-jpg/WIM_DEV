		|	втЗадолженностиИтог КАК втЗадолженностиИтог
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СведенияПоКлиентам КАК ВТ_СведенияПоКлиентам
		|		ПО втЗадолженностиИтог.ДоговорДУ = ВТ_СведенияПоКлиентам.ДоговорДУ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СведенияПоКлиентам.КодПоОКАТОиОКСМ,
		|	ВТ_СведенияПоКлиентам.НеРезидент,
		|	ВТ_СведенияПоКлиентам.КатегорияКлиента,
		|	ВТ_СведенияПоКлиентам.ПризнакИИС,
		|	ВТ_СведенияПоКлиентам.ПравоИспользованияДСКлиента,
		|	ВТ_СведенияПоКлиентам.ВидДеятельности,
		|	втЗадолженностиИтог.ТипДЗКЗ,
		|	втЗадолженностиИтог.НаправлениеРЕПО,
		|	ВТ_СведенияПоКлиентам.ТипКлиента,
		|	ВТ_СведенияПоКлиентам.ИнвестиционныйПрофиль,
		|	ВТ_СведенияПоКлиентам.ИдентификаторСтратегии,
		|	ВЫБОР
		|		КОГДА втЗадолженностиИтог.Задолженность = ""Д""
		|			ТОГДА ""Требование""
		|		КОГДА втЗадолженностиИтог.Задолженность = ""К""
		|			ТОГДА ""Обязательство""
		|	КОНЕЦ,
		|	ВТ_СведенияПоКлиентам.КвалификацияИнвестора,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(втЗадолженностиИтог.Контрагент.ИНН, """") = """"
		|			ТОГДА ВЫБОР
		|					КОГДА втЗадолженностиИтог.Контрагент.НеРезидент = ИСТИНА
		|						ТОГДА ""000""
		|					КОГДА втЗадолженностиИтог.ЭтоНДФЛ = ИСТИНА
		|						ТОГДА ""7725074789""
		|					ИНАЧЕ """"
		|				КОНЕЦ
		|		ИНАЧЕ втЗадолженностиИтог.Контрагент.ИНН
		|	КОНЕЦ,
		|	ВТ_СведенияПоКлиентам.СтатусКлиента,
		|	ВТ_СведенияПоКлиентам.ДоговорДУ,
		|	втЗадолженностиИтог.ИдентификаторТребованияОбязательства
		|
		|УПОРЯДОЧИТЬ ПО
		|	НаименованиеКонтрагента,
		|	СтоимостнаяОценкаНаОтчетнуюДату,
		|	ИдентификаторСтратегии,
		|	ТребованияИлиОбязательства";
	
	Запрос.УстановитьПараметр("ВычитатьВнешнийНДФЛ", Ложь);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОтчетОбъект.КонецПериода));
	Запрос.УстановитьПараметр("РежимыТоргов_РЕПО_ЦК", ПолучитьРежимыТоргов_РЕПОЦК());
	Запрос.УстановитьПараметр("Субконто_Контрагенты", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты));

	ВидАктиваКСУ = Новый Массив;
	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_GC_Bonds);
	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_OFZ);
	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_Акции);
	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_Все);
	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_Мтл);
	Запрос.УстановитьПараметр("ВидАктиваКСУ", ВидАктиваКСУ);

	ТЗРаздел7 = Запрос.Выполнить().Выгрузить();
	ТЗРаздел7.Колонки.Добавить("ИдентификаторТребованияОбязательства", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(50)));
	
	Для Каждого ТекСтрока Из ТЗРаздел7 Цикл 
		
		ИдентификаторЦБ = "";
		Актив = ТекСтрока.ИдентификаторТребованияОбязательстваСоставной; 
		
		Если ТипЗнч(Актив) = Тип("Строка")
			Или ТипЗнч(Актив) = Тип("СправочникСсылка.Контрагенты") 
			Или Не ЗначениеЗаполнено(Актив) Тогда    
				ТекСтрока.ИдентификаторТребованияОбязательства = ТекСтрока.ИдентификаторТребованияОбязательстваСоставной;
				Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Актив) = Тип("СправочникСсылка.Активы") Тогда
			Актив = Актив.Объект;  
		КонецЕсли;	

		
		Если ВРег(Актив.КодТипаЦБ) = "SHS8" Тогда
			ИдентификаторЦБ = "000" + "_" + ?(ЗначениеЗаполнено(Актив.ISIN), Актив.ISIN, "000");	
			ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Актив.CFI), Актив.CFI, "000");
			ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Актив.НомерГосРегистрацииВыпуска), Актив.НомерГосРегистрацииВыпуска, "000");	
		Иначе
			ИдентификаторЦБ = ?(ЗначениеЗаполнено(Актив.НомерГосРегистрацииВыпуска), Актив.НомерГосРегистрацииВыпуска, "000"); 
			ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Актив.ISIN), Актив.ISIN, "000"); 
			ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Актив.CFI), Актив.CFI, "000"); 
		КонецЕсли;
		
		ТекСтрока.ИдентификаторТребованияОбязательства = ИдентификаторЦБ;
		
	КонецЦикла;
	
	ТЗРаздел7.Свернуть("ВидДеятельности,      
						|ИдентификаторКонтрагента,
						|ИдентификаторСтратегии,
						|ИдентификаторТребованияОбязательства,
						|ИдентификаторТребованияОбязательстваСоставной,
						|КатегорияКлиента,
						|КвалификацияИнвестора,
						|КодПоОКАТОиОКСМ,
						|Контрагент,
						|НаименованиеКонтрагента,
						|НеРезидент,
						|ПравоИспользованияДСКлиента,
						|ПризнакИИС,
						|НеРезидент,
						|КатегорияКлиента,
						|ПризнакИИС,
						|СтатусКлиента,
						|ТипКлиента,
						|ТипСделкиРЕПО,   
						|ТипТребованияОбязательства,  
						|ТребованияИлиОбязательства,
					    |ИнвестиционныйПрофиль,
						|УровеньРиска" , "КоличествоАктиваТребованияОбязательства, СтоимостнаяОценкаНаОтчетнуюДату"); 
	
	
	ОтчетОбъект.Раздел7.Загрузить(ТЗРаздел7); 
	
	ОтчетОбъект.Раздел7.Свернуть("ВидДеятельности,      
						|ИдентификаторКонтрагента,
						|ИдентификаторСтратегии,
						|ИдентификаторТребованияОбязательства,
						|КатегорияКлиента,
						|КвалификацияИнвестора,
						|КодПоОКАТОиОКСМ,
						|НаименованиеКонтрагента,
						//|НеРезидент,
						|ПравоИспользованияДСКлиента,
						|ПризнакИИС,
						|СтатусКлиента,
						|ТипКлиента,
						|ТипСделкиРЕПО,   
						|ТипТребованияОбязательства,  
						|ТребованияИлиОбязательства,
					    |ИнвестиционныйПрофиль,
						|УровеньРиска" , "КоличествоАктиваТребованияОбязательства, СтоимостнаяОценкаНаОтчетнуюДату");
	
КонецПроцедуры   

Процедура ПредварительныеДанныеПоВалютнымСделкам(ОтчетОбъект, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст =  
		"ВЫБРАТЬ
		|	ОбязательстваПоДСОстатки.ДоговорДУ КАК ДоговорДУ,
		|	ОбязательстваПоДСОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ОбязательстваПоДСОстатки.Валюта КАК ВалютаКод,
		|	ОбязательстваПоДСОстатки.Основание КАК Основание,
		|	ОбязательстваПоДСОстатки.АналитическийСчет КАК АналитическийСчет
		|ПОМЕСТИТЬ ВТ_ОстаткиОбязательствНаВалРынке
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС.Остатки(
		|			&КонецПериода,
		|			Основание ССЫЛКА Документ.СделкаНаВалютномРынке
		|				И Основание.РежимТоргов В (&РежимыТоргов)
		|				И ДоговорДУ В
		|					(ВЫБРАТЬ
		|						ДоговорыДУ.ДоговорДУ КАК ДоговорДУ
		|					ИЗ
		|						втДоговорыДУ_Раздел7 КАК ДоговорыДУ)) КАК ОбязательстваПоДСОстатки
		|ГДЕ
		|	ОбязательстваПоДСОстатки.ВалютнаяСуммаОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОбязательстваПоДС.ДоговорДУ КАК ДоговорДУ,
		|	ОбязательстваПоДС.АналитическийСчет КАК АналитическийСчет,
		|	ОбязательстваПоДС.Валюта КАК Валюта,
		|	ОбязательстваПоДС.Основание КАК Основание,
		|	ОбязательстваПоДС.ВалютнаяСумма КАК ВалютнаяСумма
		|ПОМЕСТИТЬ ВТ_ОткрытыеОбязательстваНаВалРынке
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС КАК ОбязательстваПоДС
		|ГДЕ
		|	ОбязательстваПоДС.Основание В
		|			(ВЫБРАТЬ
		|				ВТ.Основание
		|			ИЗ
		|				ВТ_ОстаткиОбязательствНаВалРынке КАК ВТ)
		|	И (ОбязательстваПоДС.Основание.СуммаВБазовойВалюте = ОбязательстваПоДС.ВалютнаяСумма
		|			ИЛИ ОбязательстваПоДС.Основание.СуммаВВалютеРасчетов = ОбязательстваПоДС.ВалютнаяСумма)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОткрытыеОбязательстваНаВалРынке.ДоговорДУ КАК ДоговорДУ,
		|	ВТ_ОткрытыеОбязательстваНаВалРынке.АналитическийСчет КАК АналитическийСчет,
		|	ВТ_ОткрытыеОбязательстваНаВалРынке.Валюта.Код КАК Валюта,
		|	ВТ_ОткрытыеОбязательстваНаВалРынке.Основание КАК Основание,
		|	ВЫРАЗИТЬ(ВТ_ОткрытыеОбязательстваНаВалРынке.АналитическийСчет.СубъектМестаХранения КАК Справочник.Контрагенты) КАК Контрагент,
		|	ВТ_ОткрытыеОбязательстваНаВалРынке.ВалютнаяСумма КАК ВалютнаяСумма,
		|	ВТ_ОткрытыеОбязательстваНаВалРынке.Основание.СуммаВВалютеРасчетов КАК СуммаВВалютеРасчетов
		|ПОМЕСТИТЬ ВТ_ОбязательстваНаВалРынке
		|ИЗ
		|	ВТ_ОткрытыеОбязательстваНаВалРынке КАК ВТ_ОткрытыеОбязательстваНаВалРынке
		|ГДЕ
		|	ВТ_ОткрытыеОбязательстваНаВалРынке.ВалютнаяСумма <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТребованияПоДСОстатки.ДоговорДУ КАК ДоговорДУ,
		|	ТребованияПоДСОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ТребованияПоДСОстатки.Валюта КАК ВалютаКод,
		|	ТребованияПоДСОстатки.Основание КАК Основание,
		|	ТребованияПоДСОстатки.АналитическийСчет КАК АналитическийСчет
		|ПОМЕСТИТЬ ВТ_ОстаткиТребованийНаВалРынке
		|ИЗ
		|	РегистрНакопления.ТребованияПоДС.Остатки(
		|			&КонецПериода,
		|			Основание ССЫЛКА Документ.СделкаНаВалютномРынке
		|				И Основание.РежимТоргов В (&РежимыТоргов)
		|				И ДоговорДУ В
		|					(ВЫБРАТЬ
		|						ДоговорыДУ.ДоговорДУ КАК ДоговорДУ
		|					ИЗ
		|						втДоговорыДУ_Раздел7 КАК ДоговорыДУ)) КАК ТребованияПоДСОстатки
		|ГДЕ
		|	ТребованияПоДСОстатки.ВалютнаяСуммаОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТребованияПоДС.ДоговорДУ КАК ДоговорДУ,
		|	ТребованияПоДС.АналитическийСчет КАК АналитическийСчет,
		|	ТребованияПоДС.Валюта КАК Валюта,
		|	ТребованияПоДС.Основание КАК Основание,
		|	ТребованияПоДС.ВалютнаяСумма КАК ВалютнаяСумма
		|ПОМЕСТИТЬ ВТ_ОткрытыеТребованияНаВалРынке
		|ИЗ
		|	РегистрНакопления.ТребованияПоДС КАК ТребованияПоДС
		|ГДЕ
		|	ТребованияПоДС.Основание В
		|			(ВЫБРАТЬ
		|				ВТ.Основание
		|			ИЗ
		|				ВТ_ОстаткиТребованийНаВалРынке КАК ВТ)
		|	И (ТребованияПоДС.Основание.СуммаВБазовойВалюте = ТребованияПоДС.ВалютнаяСумма
		|			ИЛИ ТребованияПоДС.Основание.СуммаВВалютеРасчетов = ТребованияПоДС.ВалютнаяСумма)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОткрытыеТребованияНаВалРынке.ДоговорДУ КАК ДоговорДУ,
		|	ВТ_ОткрытыеТребованияНаВалРынке.АналитическийСчет КАК АналитическийСчет,
		|	ВТ_ОткрытыеТребованияНаВалРынке.Валюта.Код КАК Валюта,
		|	ВТ_ОткрытыеТребованияНаВалРынке.Основание КАК Основание,
		|	ВЫРАЗИТЬ(ВТ_ОткрытыеТребованияНаВалРынке.АналитическийСчет.СубъектМестаХранения КАК Справочник.Контрагенты) КАК Контрагент,
		|	ВТ_ОткрытыеТребованияНаВалРынке.ВалютнаяСумма КАК ВалютнаяСумма,
		|	ВТ_ОткрытыеТребованияНаВалРынке.Основание.СуммаВВалютеРасчетов КАК СуммаВВалютеРасчетов
		|ПОМЕСТИТЬ ВТ_ТребованияНаВалРынке
		|ИЗ
		|	ВТ_ОткрытыеТребованияНаВалРынке КАК ВТ_ОткрытыеТребованияНаВалРынке
		|ГДЕ
		|	ВТ_ОткрытыеТребованияНаВалРынке.ВалютнаяСумма <> 0";
	
	РежимыТоргов = Новый Массив;
	РежимыТоргов.Добавить(Перечисления.РежимТорговСделкаСВалютой.TOM);
	РежимыТоргов.Добавить(Перечисления.РежимТорговСделкаСВалютой.TMS);
	
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОтчетОбъект.КонецПериода));
	Запрос.УстановитьПараметр("РежимыТоргов", РежимыТоргов);
	РезультатЗапроса = Запрос.Выполнить(); 
	
КонецПроцедуры	

Процедура ПредварительныеДанныеПоСделкамКромеРепо(ОтчетОбъект, МВТ)
    
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст =
	
	"ВЫБРАТЬ
	|	Бух_Остатки.ДоговорДУ КАК ДоговорДУ,
	|	ВЫРАЗИТЬ(Бух_Остатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент
	|ПОМЕСТИТЬ ВТ_ДУПоСделкамКромеРЕПО
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ),
	|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыЦБПокупка)),
	|			&Субконто_Контрагенты,
	|			ДоговорДУ В
	|				(ВЫБРАТЬ
	|					ДоговорыДУ.ДоговорДУ КАК ДоговорДУ
	|				ИЗ
	|					втДоговорыДУ_Раздел7 КАК ДоговорыДУ)) КАК Бух_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СведенияПоКлиентам КАК ПараметрыДУ
	|		ПО (ПараметрыДУ.ДоговорДУ = Бух_Остатки.ДоговорДУ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Бух_Остатки.ДоговорДУ КАК ДоговорДУ,
	|	ВЫРАЗИТЬ(Бух_Остатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Бух_Остатки.СуммаОстаток < 0
	|			ТОГДА ""К""
	|		ИНАЧЕ ""Д""
	|	КОНЕЦ КАК Задолженность,
	|	""Прочая"" КАК ТипДЗКЗ,
	|	ЛОЖЬ КАК ЦК,
	|	"""" КАК НаправлениеРЕПО,
