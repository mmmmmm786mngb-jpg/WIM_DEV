	ДнейВПериодеОтчёта = 0;
	
	Для Каждого СтрокаДанныеДоходности Из ДанныеДоходностиТабЗнач Цикл
		Если СтрокаДанныеДоходности.TWR_Бенчмарк <> 0 Тогда 
			ДнейВПериодеОтчёта = КалендарныеГрафикиПовтИсп.РазностьДатВКалендарныхДнях(СтрокаДанныеДоходности.Период, КонецПериода) +1;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ДнейВПериодеОтчёта;
	
