		|						И ВТ_АктивыПоКлиентам.СЧА > 1000000000
		|					ТОГДА ""1 млрд +""
		|			КОНЕЦ КАК СТРОКА(30)),
		|		ВЫРАЗИТЬ(ВТ_АктивыПоКлиентам.КвалификацияИнвестора КАК СТРОКА(20)),
		|		ВЫРАЗИТЬ(ВТ_АктивыПоКлиентам.ВидДеятельности КАК СТРОКА(50)),
		|		ВЫРАЗИТЬ(ВТ_АктивыПоКлиентам.ТипКлиента КАК СТРОКА(50))) КАК ВложенныйЗапрос";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ОтчетОбъект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОтчетОбъект.КонецПериода));
	Запрос.УстановитьПараметр("УправляющаяКомпания", ОтчетОбъект.УправляющаяКомпания);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ДанныеРаздела_1_1 = Результаты[Результаты.ВГраница()-2].Выбрать();
	ДанныеРаздела_1_2 = Результаты[Результаты.ВГраница()-1].Выбрать();
	ДанныеРаздела_1_3 = Результаты[Результаты.ВГраница()].Выбрать();
	
	
	СведенияПоДоговорам = МВТ.Таблицы["ВТ_СведенияПоКлиентам"].ПолучитьДанные().Выгрузить(); 
	СведенияПоДоговорамЗагруженные = СведенияПоДоговорам.Скопировать(); 
	СведенияПоДоговорамЗагруженные.Очистить();
	
	Пока ДанныеРаздела_1_1.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОтчетОбъект.Раздел1_Подраздел1_1.Добавить(), ДанныеРаздела_1_1);
	КонецЦикла;
	
	Пока ДанныеРаздела_1_2.Следующий() Цикл  
		НоваяСтрока = ОтчетОбъект.Раздел1_Подраздел1_2.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеРаздела_1_2);
				
		НоваяСтрока.КоличествоДоговоровЗаключенныхВОтчетномПериоде	= 0;
		НоваяСтрока.КоличествоДоговоровПрекращенныхВОтчетномПериоде = 0;
		НоваяСтрока.КоличествоДоговоровНаКонецПериода = 0;
				

		Отбор = Новый Структура("КвалификацияИнвестора,
						|КодПоОКАТОиОКСМ,
						|СтатусКлиента,
						|НеРезидент,
						|КатегорияКлиента,
						|ПризнакИИС,
						|ПравоИспользованияДСКлиента,
						|ДоговорДУ,
						|ИнвестиционныйПрофиль,
						|ТипКлиента", 
						ДанныеРаздела_1_2.КвалификацияИнвестора,
						ДанныеРаздела_1_2.КодПоОКАТОиОКСМ,
						ДанныеРаздела_1_2.СтатусКлиента,
						ДанныеРаздела_1_2.НеРезидент,
						ДанныеРаздела_1_2.КатегорияКлиента,
						ДанныеРаздела_1_2.ПризнакИИС,
						ДанныеРаздела_1_2.ПравоИспользованияДСКлиента,						
						ДанныеРаздела_1_2.ДоговорДУ,						
						ДанныеРаздела_1_2.ИнвестиционныйПрофиль,
						ДанныеРаздела_1_2.ТипКлиента);		
						
		Строки = СведенияПоДоговорам.НайтиСтроки(Отбор);   
		СтрокиУжеЗагружены = СведенияПоДоговорамЗагруженные.НайтиСтроки(Отбор).Количество();
		
		Если Не СтрокиУжеЗагружены Тогда  
			
			КоличествоДоговоровНаКонецПериода				= 0;
			КоличествоДоговоровЗаключенныхВОтчетномПериоде 	= 0;
			КоличествоДоговоровПрекращенныхВОтчетномПериоде	= 0;
			
			Для Каждого Строка Из Строки Цикл
				Если ЗначениеЗаполнено(Строка.ДоговорДУ) И Не ЗначениеЗаполнено(Строка.ПрекращенВПериод) Тогда
					КоличествоДоговоровНаКонецПериода = КоличествоДоговоровНаКонецПериода + 1;	
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(Строка.ЗаключенВПериод) Тогда
					КоличествоДоговоровЗаключенныхВОтчетномПериоде = КоличествоДоговоровЗаключенныхВОтчетномПериоде + 1;	
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Строка.ПрекращенВПериод) Тогда
					КоличествоДоговоровПрекращенныхВОтчетномПериоде =КоличествоДоговоровПрекращенныхВОтчетномПериоде + 1;	
				КонецЕсли;
			КонецЦикла;	
			
			 НоваяСтрока.КоличествоДоговоровЗаключенныхВОтчетномПериоде	= КоличествоДоговоровЗаключенныхВОтчетномПериоде;
			 НоваяСтрока.КоличествоДоговоровПрекращенныхВОтчетномПериоде = КоличествоДоговоровПрекращенныхВОтчетномПериоде;
			 НоваяСтрока.КоличествоДоговоровНаКонецПериода = КоличествоДоговоровНаКонецПериода;
			
			 НоваяСтрокаЗагружены = СведенияПоДоговорамЗагруженные.Добавить();  
			 ЗаполнитьЗначенияСвойств(НоваяСтрокаЗагружены, Отбор);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Пока ДанныеРаздела_1_3.Следующий() Цикл  
		
		ЗаполнитьЗначенияСвойств(ОтчетОбъект.Раздел1_Подраздел1_3.Добавить(), ДанныеРаздела_1_3);
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаполнитьРаздел_2_3(ОтчетОбъект, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДенежныеСредства.ДоговорДУ КАК ДоговорДУ,
		|	ДенежныеСредства.Валюта КАК Валюта,
		|	СУММА(ДенежныеСредства.СуммаОстаток) КАК СуммаОстаток,
		|	ДенежныеСредства.НаименованиеКредитнойОрганизацииБрокера КАК НаименованиеКредитнойОрганизацииБрокера,
		|	ДенежныеСредства.ИдентификаторКредитнойОрганизацииБрокера КАК ИдентификаторКредитнойОрганизацииБрокера,
		|	ДенежныеСредства.Валюта.Код КАК КодВалюты,
		|	СУММА(ДенежныеСредства.НаДепозитныхСчетах) КАК НаДепозитныхСчетах
		|ПОМЕСТИТЬ ВТ_ДенежныеСредства
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДС_Остатки.ДоговорДУ КАК ДоговорДУ,
		|		ДС_Остатки.Валюта КАК Валюта,
		|		ДС_Остатки.СуммаОстаток КАК СуммаОстаток,
		|		ВЫБОР
		|			КОГДА БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный)
		|					И БанковскиеСчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипРасчетногоСчета.Единый)
		|					И БанковскиеСчета.ДоговорДУ = ЗНАЧЕНИЕ(Справочник.ДоговорДУ.ПустаяСсылка)
		|				ТОГДА ДС_Остатки.АналитическийСчет.СубъектМестаХранения.НаименованиеСокращенное
		|			КОГДА БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Брокерский)
		|				ТОГДА БанковскиеСчета.Владелец.НаименованиеСокращенное
		|			ИНАЧЕ БанковскиеСчета.Банк.НаименованиеСокращенное
		|		КОНЕЦ КАК НаименованиеКредитнойОрганизацииБрокера,
		|		ВЫБОР
		|			КОГДА БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный)
		|					И БанковскиеСчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипРасчетногоСчета.Единый)
		|					И БанковскиеСчета.ДоговорДУ = ЗНАЧЕНИЕ(Справочник.ДоговорДУ.ПустаяСсылка)
		|				ТОГДА ДС_Остатки.АналитическийСчет.СубъектМестаХранения.ИНН
		|			КОГДА БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Брокерский)
		|				ТОГДА БанковскиеСчета.Владелец.ИНН
		|			ИНАЧЕ БанковскиеСчета.Банк.ИНН
		|		КОНЕЦ КАК ИдентификаторКредитнойОрганизацииБрокера,
		|		ВЫБОР
		|			КОГДА ВЫРАЗИТЬ(ДС_Остатки.АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
		|				ТОГДА ДС_Остатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК НаДепозитныхСчетах
		|	ИЗ
		|		РегистрНакопления.ДенежныеСредстваУправленческий.Остатки(
		|				КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ),
		|				ДоговорДУ В
		|						(ВЫБРАТЬ
		|							ДоговорыДУ.ДоговорДУ КАК ДоговорДУ
		|						ИЗ
		|							ВТ_ДействующиеДоговора КАК ДоговорыДУ)
		|					И АналитическийСчет.ВидАналитическогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыАналитическогоСчета.ДенежныеСредства)
		|					И АналитическийСчет.МестоХранения ССЫЛКА Справочник.БанковскиеСчета) КАК ДС_Остатки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|			ПО ДС_Остатки.АналитическийСчет.МестоХранения = БанковскиеСчета.Ссылка) КАК ДенежныеСредства
		|
		|СГРУППИРОВАТЬ ПО
		|	ДенежныеСредства.ДоговорДУ,
		|	ДенежныеСредства.Валюта,
		|	ДенежныеСредства.НаименованиеКредитнойОрганизацииБрокера,
		|	ДенежныеСредства.ИдентификаторКредитнойОрганизацииБрокера,
		|	ДенежныеСредства.Валюта.Код
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СведенияПоКлиентам.КвалификацияИнвестора КАК КвалификацияИнвестора,
		|	ВТ_СведенияПоКлиентам.СтатусКлиента КАК СтатусКлиента,
		|	ВТ_СведенияПоКлиентам.КодПоОКАТОиОКСМ КАК КодПоОКАТОиОКСМ,
		|	ВТ_СведенияПоКлиентам.НеРезидент КАК НеРезидент,
		|	ВТ_СведенияПоКлиентам.КатегорияКлиента КАК КатегорияКлиента,
		|	ВТ_СведенияПоКлиентам.ПризнакИИС КАК ПризнакИИС,
		|	ВТ_СведенияПоКлиентам.ПравоИспользованияДСКлиента КАК ПравоИспользованияДСКлиента,
		|	ВТ_СведенияПоКлиентам.ВидДеятельности КАК ВидДеятельности,
		|	ВТ_ДенежныеСредства.КодВалюты КАК КодВалюты,
		|	ВТ_ДенежныеСредства.ИдентификаторКредитнойОрганизацииБрокера КАК ИдентификаторКредитнойОрганизацииБрокера,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВТ_ДенежныеСредства.НаименованиеКредитнойОрганизацииБрокера = ""Филиал «Центральный» Банка ВТБ (ПАО)""
		|				ТОГДА ""Банк ВТБ (ПАО)""
		|			ИНАЧЕ ВТ_ДенежныеСредства.НаименованиеКредитнойОрганизацииБрокера
		|		КОНЕЦ) КАК НаименованиеКредитнойОрганизацииБрокера,
		|	СУММА(ВТ_ДенежныеСредства.СуммаОстаток - ВТ_ДенежныеСредства.НаДепозитныхСчетах) КАК СтоимостнаяОценкаНаОтчетнуюДату,
		|	ВТ_СведенияПоКлиентам.ИдентификаторСтратегии + ""_"" + ВЫРАЗИТЬ(ВТ_СведенияПоКлиентам.ДоговорДУ КАК Справочник.ДоговорДУ).Код КАК ИдентификаторСтратегии,
		|	ВТ_СведенияПоКлиентам.ТипКлиента КАК ТипКлиента,
		|	""Денежные средства"" КАК ТипИмущества,
		|	""Начальный (не присвоен)"" КАК УровеньРиска,
		|	ВТ_СведенияПоКлиентам.ИнвестиционныйПрофиль КАК ИнвестиционныйПрофиль
		|ИЗ
		|	ВТ_СведенияПоКлиентам КАК ВТ_СведенияПоКлиентам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДенежныеСредства КАК ВТ_ДенежныеСредства
		|		ПО ВТ_СведенияПоКлиентам.ДоговорДУ = ВТ_ДенежныеСредства.ДоговорДУ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ДенежныеСредства.ИдентификаторКредитнойОрганизацииБрокера,
		|	ВТ_СведенияПоКлиентам.КатегорияКлиента,
		|	ВТ_ДенежныеСредства.КодВалюты,
		|	ВТ_СведенияПоКлиентам.КвалификацияИнвестора,
		|	ВТ_СведенияПоКлиентам.ПризнакИИС,
		|	ВТ_СведенияПоКлиентам.НеРезидент,
		|	ВТ_СведенияПоКлиентам.СтатусКлиента,
		|	ВТ_СведенияПоКлиентам.ИдентификаторСтратегии,
		|	ВТ_СведенияПоКлиентам.ПравоИспользованияДСКлиента,
		|	ВТ_СведенияПоКлиентам.ВидДеятельности,
		|	ВТ_СведенияПоКлиентам.КодПоОКАТОиОКСМ,
		|	ВТ_СведенияПоКлиентам.ИнвестиционныйПрофиль,
		|	ВТ_СведенияПоКлиентам.ТипКлиента,
		|	ВТ_СведенияПоКлиентам.ДоговорДУ
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВТ_ДенежныеСредства.СуммаОстаток - ВТ_ДенежныеСредства.НаДепозитныхСчетах) > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СведенияПоКлиентам.КвалификацияИнвестора КАК КвалификацияИнвестора,
		|	ВТ_СведенияПоКлиентам.СтатусКлиента КАК СтатусКлиента,
		|	ВТ_СведенияПоКлиентам.КодПоОКАТОиОКСМ КАК КодПоОКАТОиОКСМ,
		|	ВТ_СведенияПоКлиентам.НеРезидент КАК НеРезидент,
		|	ВТ_СведенияПоКлиентам.КатегорияКлиента КАК КатегорияКлиента,
		|	ВТ_СведенияПоКлиентам.ПризнакИИС КАК ПризнакИИС,
		|	ВТ_СведенияПоКлиентам.ПравоИспользованияДСКлиента КАК ПравоИспользованияДСКлиента,
		|	ВТ_СведенияПоКлиентам.ВидДеятельности КАК ВидДеятельности,
		|	ВТ_ДенежныеСредства.КодВалюты КАК КодВалюты,
		|	ВТ_СведенияПоКлиентам.ИдентификаторСтратегии + ""_"" + ВЫРАЗИТЬ(ВТ_СведенияПоКлиентам.ДоговорДУ КАК Справочник.ДоговорДУ).Код КАК ИдентификаторСтратегии,
		|	СУММА(ВТ_ДенежныеСредства.НаДепозитныхСчетах) КАК СтоимостнаяОценкаНаОтчетнуюДату,
		|	ВТ_СведенияПоКлиентам.ТипКлиента КАК ТипКлиента,
		|	""Депозиты в денежных средствах"" КАК ТипИмущества,
		|	""Начальный (не присвоен)"" КАК УровеньРиска,
		|	ВТ_СведенияПоКлиентам.ИнвестиционныйПрофиль КАК ИнвестиционныйПрофиль
		|ИЗ
		|	ВТ_СведенияПоКлиентам КАК ВТ_СведенияПоКлиентам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДенежныеСредства КАК ВТ_ДенежныеСредства
		|		ПО ВТ_СведенияПоКлиентам.ДоговорДУ = ВТ_ДенежныеСредства.ДоговорДУ
		|ГДЕ
		|	ВТ_ДенежныеСредства.НаДепозитныхСчетах <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СведенияПоКлиентам.ПризнакИИС,
		|	ВТ_СведенияПоКлиентам.КвалификацияИнвестора,
		|	ВТ_СведенияПоКлиентам.НеРезидент,
		|	ВТ_СведенияПоКлиентам.СтатусКлиента,
		|	ВТ_СведенияПоКлиентам.ИдентификаторСтратегии,
		|	ВТ_СведенияПоКлиентам.ВидДеятельности,
		|	ВТ_СведенияПоКлиентам.КатегорияКлиента,
		|	ВТ_ДенежныеСредства.КодВалюты,
		|	ВТ_СведенияПоКлиентам.ПравоИспользованияДСКлиента,
		|	ВТ_СведенияПоКлиентам.КодПоОКАТОиОКСМ,
		|	ВТ_СведенияПоКлиентам.ИнвестиционныйПрофиль,
		|	ВТ_СведенияПоКлиентам.ТипКлиента,
		|	ВТ_СведенияПоКлиентам.ДоговорДУ";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОтчетОбъект.КонецПериода));
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ОтчетОбъект.Раздел2.Загрузить(Результаты[Результаты.ВГраница()-1].Выгрузить());	
	ОтчетОбъект.Раздел3.Загрузить(Результаты[Результаты.ВГраница()].Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьРаздел_4(ОтчетОбъект, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
