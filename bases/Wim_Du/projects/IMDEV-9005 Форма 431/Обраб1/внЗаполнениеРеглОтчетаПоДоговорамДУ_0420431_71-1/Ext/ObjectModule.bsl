Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке();
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиЗаполнениеОбъекта();
	ПараметрыРегистрации.Версия = "1.00";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.ВерсияБСП	= СтандартныеПодсистемыСервер.ВерсияБиблиотеки();
	ПараметрыРегистрации.Наименование =  "Заполнение регламентного отчета '0420431' таксономия 7.1 (по договорам ДУ) - 1";	
	ПараметрыРегистрации.Назначение.Добавить("Документ.РО_XBRL7_1_0420431_СведенияОДеятельностиПоУправлениюЦБ_7119У");
	
	// Вызов серверного метода
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Заполнить отчет по договорам ДУ - 1";
	Команда.Идентификатор = "ЗаполнитьОтчетПоДоговорамДУ";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;

	Возврат ПараметрыРегистрации;
	
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Знач Настройки, ПредставлениеНастроек = "") Экспорт
	
	Если Настройки.Свойство("Значения") Тогда		
		ОтноситьРасхожденияНаПрочиеЗадолженности = Настройки.Значения.ОтноситьРасхожденияНаПрочиеЗадолженности;
		ИсключитьЦессии = Настройки.Значения.ИсключитьЦессии;  
		
		МассивБазМО = Неопределено;
		Если Настройки.Значения.Свойство("МассивБазМО", МассивБазМО) Тогда  
			Для каждого СтрокаБаза Из МассивБазМО Цикл
				НоваяСтрока = ВнешниеБазыМО.Добавить();
				НоваяСтрока.База = СтрокаБаза;  
			КонецЦикла;
		 КонецЕсли; 
		 
		Настройки.Значения.Свойство("ТипУчета",					ТипУчета);
		Настройки.Значения.Свойство("ВознаграждениеКакПассив",	ВознаграждениеКакПассив);
		Настройки.Значения.Свойство("КоммисияКакПассив",		КоммисияКакПассив);
		Настройки.Значения.Свойство("НДФЛКакПассив",			НДФЛКакПассив);
		Настройки.Значения.Свойство("ИсключитьПИФ",				ИсключитьПИФ);
		Настройки.Значения.Свойство("УровеньОтсечки",			УровеньОтсечки);

		Настройки.Значения.Свойство("УчитыватьКлиентовПришедшихВнутриПериода",	УчитыватьКлиентовПришедшихВнутриПериода);
		
		ПредставлениеНастроек = "";
	КонецЕсли;
	
КонецПроцедуры

// Обработчик серверных команд.
//
// Параметры:
//   ИдентификаторКоманды - Строка - Имя команды, определенное в функции СведенияОВнешнейОбработке().
//   ОбъектыНазначения    - Массив - Ссылки объектов, для которых вызвана команда.
//       - Неопределено - для команд "ЗаполнениеФормы".
//   ПараметрыВыполнения  - Структура - Контекст выполнения команды.
//       * ДополнительнаяОбработкаСсылка - СправочникСсылка.ДополнительныеОтчетыИОбработки - Ссылка обработки.
//           Может использоваться для чтения параметров обработки.
//           Пример см. в комментарии к функции ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы().
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения, ПараметрыВыполнения) Экспорт

	Если ИдентификаторКоманды <> "ЗаполнитьОтчетПоДоговорамДУ" ИЛИ ОбъектыНазначения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНастроки(ПараметрыВыполнения);   
		
	Если ВнешниеБазыМО.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не добавлено ни одной база МО в настройки алгоритма!");
		Возврат;	
	КонецЕсли;  
	
	МассивСоединений = Новый Массив;
	
	Для Каждого СтрокаБазаМО Из ВнешниеБазыМО Цикл   
 		БазаМО = СтрокаБазаМО.База;  
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.СтруктураПараметровДляУстановкиВнешнегоСоединения();
		ЗаполнитьЗначенияСвойств(ПараметрыПодключения, БазаМО);
		
		СтруктураПодключения = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединение(ПараметрыПодключения);
		Соединение = СтруктураПодключения.Соединение;
		Если Соединение = Неопределено  Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтруктураПодключения.ПодробноеОписаниеОшибки);
			Возврат;
		КонецЕсли;
		
		МассивСоединений.Добавить(Соединение);
	КонецЦикла;
	
	Для Каждого ЭлементОбъектНазначения Из ОбъектыНазначения Цикл
		
		ОбъектНазначения = ЭлементОбъектНазначения.ПолучитьОбъект();
		
		// Зааполнение сопроводительного письма
		ОбъектНазначения.ЗаполнитьОтчет();
		
		// Заполнение 
		ЗаполнитьРазделыОтчета(ОбъектНазначения);
		
		// Дозаполняем пустые значения
		РегламентированнаяОтчетность.ДозаполнениеПустыхЗначенийПоОтчетамПрофучастника(ОбъектНазначения);
	
		ОбъектНазначения.Записать();
		
	КонецЦикла;
		
	Соединение = Неопределено;
	
КонецПроцедуры

#КонецОбласти  


#Область devops

Процедура ЗагрузитьНастройки(ПараметрыРегистрации) Экспорт 
	
	ВерсияПрименения = "1.01";
	ТекущаяРегистрация = СведенияОВнешнейОбработке();  
	
	Если ВерсияПрименения = ТекущаяРегистрация.Версия Тогда  
		ПараметрыРегистрации.Вставить("ЗагружатьНастройки", Истина);
		НастройкиПоУмолчанию(ЭтотОбъект);
		ЗаголовокНастроек = "";
		ЗначенияПараметров = УстановитьПараметры(ЗаголовокНастроек);
		ПараметрыРегистрации.Вставить("Настройки", Новый Структура("Значения, ЗаголовокНастроек", ЗначенияПараметров, ЗаголовокНастроек));
	КонецЕсли;	
	
КонецПроцедуры	

Процедура НастройкиПоУмолчанию(Объект) Экспорт
		
	Объект.ОтноситьРасхожденияНаПрочиеЗадолженности	= Истина;
	Объект.ИсключитьЦессии			= Истина;
	Объект.ТипУчета					= "Плановый";
	Объект.ВознаграждениеКакПассив	= Истина;
	Объект.КоммисияКакПассив		= Ложь;
	Объект.НДФЛКакПассив			= Истина;
	Объект.ИсключитьПИФ				= Истина;
	Объект.УровеньОтсечки			= 1000000;
	Объект.УчитыватьКлиентовПришедшихВнутриПериода	= Истина;
	
	Объект.ВнешниеБазыМО.Очистить();
	
	НоваяСтрока = Объект.ВнешниеБазыМО.Добавить();
	НоваяСтрока.База = Справочники.ВнешниеИнформационныеБазы.НайтиПоНаименованию("PROD_AVC_MO", Истина);
	НоваяСтрока = Объект.ВнешниеБазыМО.Добавить();
	НоваяСтрока.База = Справочники.ВнешниеИнформационныеБазы.НайтиПоНаименованию("PROD_AVC_Retail_MO", Истина);
	
КонецПроцедуры 

Функция УстановитьПараметры(ЗаголовокНастроек) Экспорт
	
	Значения = Новый Структура();
	
	Значения.Вставить("ОтноситьРасхожденияНаПрочиеЗадолженности", ЭтотОбъект.ОтноситьРасхожденияНаПрочиеЗадолженности);
	Значения.Вставить("ИсключитьЦессии", ЭтотОбъект.ИсключитьЦессии);  
	
	МассивБазМО = Новый Массив;
	Для Каждого СрокаБазаМО Из ЭтотОбъект.ВнешниеБазыМО Цикл    
		МассивБазМО.Добавить(СрокаБазаМО.База);
	КонецЦикла;	    
	
	Значения.Вставить("МассивБазМО", МассивБазМО);    
	
	Значения.Вставить("ТипУчета",					ЭтотОбъект.ТипУчета);    
	Значения.Вставить("ВознаграждениеКакПассив",	ЭтотОбъект.ВознаграждениеКакПассив);    
	Значения.Вставить("КоммисияКакПассив",			ЭтотОбъект.КоммисияКакПассив);    
	Значения.Вставить("НДФЛКакПассив",				ЭтотОбъект.НДФЛКакПассив);    
	Значения.Вставить("ИсключитьПИФ",				ЭтотОбъект.ИсключитьПИФ);    
	Значения.Вставить("УровеньОтсечки",				ЭтотОбъект.УровеньОтсечки);    
	Значения.Вставить("УчитыватьКлиентовПришедшихВнутриПериода",	ЭтотОбъект.УчитыватьКлиентовПришедшихВнутриПериода);    
	
	Возврат Значения;
	
КонецФункции	
	
#КонецОбласти


