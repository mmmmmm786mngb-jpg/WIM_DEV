		|	ХозрасчетныйОстатки.ДоговорДУ.ТипКлиентаДУ КАК ТипКлиентаДУ,
		|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.АналитическиеСчета).МестоХранения.СчетВРегистраторе КАК АналитическийСчет,
		|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.АналитическиеСчета).МестоХранения КАК МестоХранения,
		|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.АналитическиеСчета).МестоХранения.Владелец КАК Депозитарий,
		|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.АналитическиеСчета).МестоХранения.СчетВРегистраторе КАК СчетВРегистраторе,
		|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто2 КАК Справочник.Активы) КАК Актив,
		|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто2 КАК Справочник.Активы).Объект КАК АктивОбъект,
		|	ВЫБОР
		|		КОГДА ХозрасчетныйОстатки.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.СобственныеСредстваУК)
		|			ТОГДА ХозрасчетныйОстатки.КоличествоОстатокДт
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоВсего,
		|	ВЫБОР
		|		КОГДА ХозрасчетныйОстатки.ДоговорДУ.ТипКлиентаДУ В (&ТипыКлиентов)
		|			ТОГДА ХозрасчетныйОстатки.КоличествоОстатокДт
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоИныеСчетаДУ,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_БлокированныеЦБ.Действующие, ЛОЖЬ) = ИСТИНА
		|			ТОГДА ВТ_БлокированныеЦБ.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЗаблокированныеЦБ_КоличествоВсего,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_БлокированныеЦБ.Действующие, ЛОЖЬ) = ИСТИНА
		|				И ЕСТЬNULL(ВТ_БлокированныеЦБ.ТипБлокировки, ЗНАЧЕНИЕ(Перечисление.ТипыБлокировкиЦБ.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыБлокировкиЦБ.БлокированоДляКорпоративныхДействий)
		|			ТОГДА ВТ_БлокированныеЦБ.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЗаблокированныеЦБ_КоличествоКорпДействия,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_БлокированныеЦБ.Действующие, ЛОЖЬ) = ИСТИНА
		|				И ЕСТЬNULL(ВТ_БлокированныеЦБ.ТипБлокировки, ЗНАЧЕНИЕ(Перечисление.ТипыБлокировкиЦБ.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыБлокировкиЦБ.БлокированоДляИсполненияАктовПредписанийОргановГосВласти)
		|			ТОГДА ВТ_БлокированныеЦБ.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЗаблокированныеЦБ_КоличествоЗапретОпераций,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_БлокированныеЦБ.Действующие, ЛОЖЬ) = ИСТИНА
		|				И ЕСТЬNULL(ВТ_БлокированныеЦБ.ТипБлокировки, ЗНАЧЕНИЕ(Перечисление.ТипыБлокировкиЦБ.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыБлокировкиЦБ.БлокированоПоАресту)
		|			ТОГДА ВТ_БлокированныеЦБ.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЗаблокированныеЦБ_КоличествоПодАрестом,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто2 КАК Справочник.Активы).Объект.ФормаСуществования = ЗНАЧЕНИЕ(Перечисление.ФормаСуществования.Документарная)
		|			ТОГДА ХозрасчетныйОстатки.КоличествоОстатокДт
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПереданныеВДУ,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто2 КАК Справочник.Активы).ВидАктива = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыАктивов.ПаиПИФ)
		|				ИЛИ ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто2 КАК Справочник.Активы).Объект.ФормаСуществования = ЗНАЧЕНИЕ(Перечисление.ФормаСуществования.Бездокументарная)
		|			ТОГДА ХозрасчетныйОстатки.КоличествоОстатокДт
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоПраваПереданныеВДУ,
		|	ВЫБОР
		|		КОГДА ХозрасчетныйОстатки.ДоговорДУ.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.СобственныеСредстваУК)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Собственные
