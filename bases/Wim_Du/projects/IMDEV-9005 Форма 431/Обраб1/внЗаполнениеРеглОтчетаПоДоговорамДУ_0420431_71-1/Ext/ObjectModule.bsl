	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_GC_Bonds);
	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_OFZ);
	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_Акции);
	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_Все);
	ВидАктиваКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_Мтл);
	Запрос.УстановитьПараметр("ВидАктиваКСУ", ВидАктиваКСУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл   
		
		Если ВРег(Выборка.КодТипаЦБ) = "SHS8" Тогда
			ИдентификаторЦБ = "000" + "_" + ?(ЗначениеЗаполнено(Выборка.ISIN), Выборка.ISIN, "000");	
			ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Выборка.CFI), Выборка.CFI, "000");
			ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Выборка.НомерГосРег), Выборка.НомерГосРег, "000");	
		Иначе
			ИдентификаторЦБ = ?(ЗначениеЗаполнено(Выборка.НомерГосРег), Выборка.НомерГосРег, "000"); 
			ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Выборка.ISIN), Выборка.ISIN, "000"); 
			ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Выборка.CFI), Выборка.CFI, "000"); 
		КонецЕсли;	
	
		НоваяСтрока = ОтчетОбъект.Раздел4.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);  
		НоваяСтрока.ИдентификаторЦеннойБумаги = ИдентификаторЦБ;
		
		НоваяСтрока.УровеньРиска = "Начальный (не присвоен)";		
						
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРаздел_7(ОтчетОбъект, МВТ)
	
	ПредварительныеДанныеПоВалютнымСделкам(ОтчетОбъект, МВТ); 
	ПредварительныеДанныеПоСделкамКромеРепо(ОтчетОбъект, МВТ);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияПараметровДоговораДУСрезПоследних.ДоговорДУ КАК ДоговорДУ
		|ПОМЕСТИТЬ втОтражатьКЗПоПрямомуРЕПО
		|ИЗ
		|	РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
		|			КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ),
		|			ДоговорДУ В
		|					(ВЫБРАТЬ
		|						ДоговорыДУ.ДоговорДУ КАК ДоговорДУ
		|					ИЗ
		|						втДоговорыДУ_Раздел7 КАК ДоговорыДУ)
		|				И Параметр = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыДоговораДУ.ОтражатьКредиторскуюЗадолженностьПоПрямомуРЕПО)) КАК ЗначенияПараметровДоговораДУСрезПоследних
		|ГДЕ
		|	ЗначенияПараметровДоговораДУСрезПоследних.Значение = ИСТИНА
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Задолженности.ДоговорДУ КАК ДоговорДУ,
		|	ЕСТЬNULL(ПодменаБанкаВТБ.НаЧтоМеняем, ЕСТЬNULL(Задолженности.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))) КАК Контрагент,
		|	Задолженности.Задолженность КАК Задолженность,
		|	Задолженности.ТипДЗКЗ КАК ТипДЗКЗ,
		|	Задолженности.ЦК КАК ЦК,
		|	Задолженности.НаправлениеРЕПО КАК НаправлениеРЕПО,
		|	Задолженности.ЭтоНДФЛ КАК ЭтоНДФЛ,
		|	СУММА(Задолженности.Сумма) КАК Сумма,
		|	Задолженности.ИдентификаторТребованияОбязательства КАК ИдентификаторТребованияОбязательства,
		|	СУММА(Задолженности.КоличествоАктиваТребованияОбязательства) КАК Количество
		|ПОМЕСТИТЬ втЗадолженности
		|ИЗ
		|	(ВЫБРАТЬ
		|		Итоги_БУ.ДоговорДУ КАК ДоговорДУ,
		|		Итоги_БУ.Контрагент КАК Контрагент,
		|		Итоги_БУ.Задолженность КАК Задолженность,
		|		Итоги_БУ.ТипДЗКЗ КАК ТипДЗКЗ,
		|		Итоги_БУ.ЦК КАК ЦК,
		|		Итоги_БУ.НаправлениеРЕПО КАК НаправлениеРЕПО,
		|		Итоги_БУ.Сумма КАК Сумма,
		|		Итоги_БУ.ЭтоНДФЛ КАК ЭтоНДФЛ,
		|		ЕСТЬNULL(Итоги_БУ.Актив, """") КАК ИдентификаторТребованияОбязательства,
		|		ЕСТЬNULL(Итоги_БУ.КоличествоОстаток, 0) КАК КоличествоАктиваТребованияОбязательства
		|	ИЗ
		|		Итоги_БУ КАК Итоги_БУ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ПроцентыПоСчетам.ДоговорДУ,
		|		ВЫРАЗИТЬ(ПроцентыПоСчетам.АналитическийСчет.СубъектМестаХранения КАК Справочник.Контрагенты),
		|		ВЫБОР
		|			КОГДА ПроцентыПоСчетам.СуммаОстаток < 0
		|				ТОГДА ""К""
		|			ИНАЧЕ ""Д""
		|		КОНЕЦ,
		|		""Прочая"",
		|		ЛОЖЬ,
