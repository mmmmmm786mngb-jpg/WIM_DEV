Процедура ЗаполнитьРазделыОтчета(ОтчетОбъект)
	
	МВТ = СформироватьМенеджерВременныхТаблиц(ОтчетОбъект);
	СформироватьВТ_ДанныеПоСтратегиям(МВТ, ОтчетОбъект);
	ДополнитьВременныеТаблицы(МВТ, ОтчетОбъект);
	ДополнитьВТ_ВводыВыводы(ОтчетОбъект, МВТ);
	ЗаполнитьРаздел_1(ОтчетОбъект, МВТ);
	ЗаполнитьРаздел_2_3(ОтчетОбъект, МВТ);
	ЗаполнитьРаздел_4(ОтчетОбъект, МВТ);
	ЗаполнитьРаздел_5(ОтчетОбъект, МВТ);
	ЗаполнитьРаздел_6(ОтчетОбъект, МВТ); 
	ЗаполнитьРаздел_7(ОтчетОбъект, МВТ);
	ЗаполнитьРазделРеестрЦБ(ОтчетОбъект, МВТ);
    
КонецПроцедуры

Функция ПолучитьСписокАктивныхКлиентовИзМО(Соединение, ДатаНачала, ДатаОкончания, Валюта, Стратегия, УчитыватьКлиентовПришедшихВнутриПериода)
	
	ТипМандатаПИФ = Соединение.NewObject("Массив");
	//ОПИФ
	ТипМандатаПИФ.Добавить(Соединение.Перечисления.ТипыМандата.A);
	ТипМандатаПИФ.Добавить(Соединение.Перечисления.ТипыМандата.O);
	ТипМандатаПИФ.Добавить(Соединение.Перечисления.ТипыМандата.M);
	ТипМандатаПИФ.Добавить(Соединение.Перечисления.ТипыМандата.X);
	//ЗПИФ
	ТипМандатаПИФ.Добавить(Соединение.Перечисления.ТипыМандата.V);
	ТипМандатаПИФ.Добавить(Соединение.Перечисления.ТипыМандата.Y);
	ТипМандатаПИФ.Добавить(Соединение.Перечисления.ТипыМандата.Q);
	ТипМандатаПИФ.Добавить(Соединение.Перечисления.ТипыМандата.H);
	
	ТекстЗапросаМО = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	т.Ссылка
		|ПОМЕСТИТЬ втМандаты
		|ИЗ
		|	РегистрСведений.ДействующиеФинПланы.СрезПоследних(, ) КАК ДействующиеФинПланыСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Мандаты КАК т
		|		ПО ДействующиеФинПланыСрезПоследних.Мандат = т.Ссылка
		|ГДЕ
		|	НЕ т.ПометкаУдаления
		|	И (НЕ т.ТипМандата В (&ТипМандата)
		|			ИЛИ &НеИсключитьПИФ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	т.Мандат,
		|	СУММА(т.СуммаНаНачало) КАК СуммаНаНачало,
		|	СУММА(т.СуммаНаКонец) КАК СуммаНаКонец
		|ИЗ
		|	(ВЫБРАТЬ
		|		т.Мандат КАК Мандат,
		|		т.Сумма КАК СуммаВВалюте,
		|		т.Валюта КАК Валюта,
		|		тКурсОтчета.Курс КАК КурсВалютыОтчета,
		|		тКурсы.Курс КАК КурсРыночнойСтоимости,
		|		ВЫБОР
		|			КОГДА ЕСТЬNULL(тКурсОтчета.Курс, 0) = 0
		|				ТОГДА 0
		|			ИНАЧЕ т.Сумма * тКурсы.Курс / тКурсОтчета.Курс
		|		КОНЕЦ КАК СуммаНаНачало,
		|		0 КАК СуммаНаКонец
		|	ИЗ
		|		РегистрСведений.РыночнаяСтоимостьПозиции.СрезПоследних(
		|				&ДатаНачала,
		|				Мандат В
		|						(ВЫБРАТЬ
		|							т.Ссылка
		|						ИЗ
		|							втМандаты КАК т)
		|					И СчетМандата.Стратегия В ИЕРАРХИИ (&Стратегия)) КАК т
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаНачала, Валюта = &Валюта) КАК тКурсОтчета
		|			ПО (ИСТИНА)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаНачала, ) КАК тКурсы
		|			ПО (тКурсы.Валюта = т.Валюта)
		|	ГДЕ
		|		НАЧАЛОПЕРИОДА(т.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		т.Мандат,
		|		т.Сумма,
		|		т.Валюта,
		|		тКурсОтчета.Курс,
		|		тКурсы.Курс,
		|		0,
		|		ВЫБОР
		|			КОГДА ЕСТЬNULL(тКурсОтчета.Курс, 0) = 0
		|				ТОГДА 0
		|			ИНАЧЕ т.Сумма * тКурсы.Курс / тКурсОтчета.Курс
		|		КОНЕЦ
		|	ИЗ
		|		РегистрСведений.РыночнаяСтоимостьПозиции.СрезПоследних(
		|				&ДатаОкончания,
		|				Мандат В
		|						(ВЫБРАТЬ
		|							т.Ссылка
		|						ИЗ
		|							втМандаты КАК т)
		|					И СчетМандата.Стратегия В ИЕРАРХИИ (&Стратегия)) КАК т
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаОкончания, Валюта = &Валюта) КАК тКурсОтчета
		|			ПО (ИСТИНА)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаОкончания, ) КАК тКурсы
		|			ПО (тКурсы.Валюта = т.Валюта)
		|	ГДЕ
		|		НАЧАЛОПЕРИОДА(т.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)) КАК т
		|
		|СГРУППИРОВАТЬ ПО
		|	т.Мандат
		|
		|ИМЕЮЩИЕ
		|	(СУММА(т.СуммаНаНачало) > &УровеньОтсечки 
		|		ИЛИ &УчитыватьКлиентовПришедшихВнутриПериода И СУММА(т.СуммаНаНачало) = 0) И
		|	СУММА(т.СуммаНаКонец) > &УровеньОтсечки";
	
	Запрос = Соединение.NewObject("Запрос");
	Запрос.Текст = ТекстЗапросаМО;
	
	Запрос.УстановитьПараметр("ДатаНачала",			ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",		ДатаОкончания);
	Запрос.УстановитьПараметр("Валюта",				Валюта);
	Запрос.УстановитьПараметр("Стратегия",			Стратегия);
	Запрос.УстановитьПараметр("ТипМандата",			ТипМандатаПИФ);
	Запрос.УстановитьПараметр("НеИсключитьПИФ",		Не ИсключитьПИФ);
	Запрос.УстановитьПараметр("УровеньОтсечки",		УровеньОтсечки);
	Запрос.УстановитьПараметр("УчитыватьКлиентовПришедшихВнутриПериода",	УчитыватьКлиентовПришедшихВнутриПериода);
	
	СписокАктивныхКлиентов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Мандат");
	
	Возврат СписокАктивныхКлиентов;

КонецФункции

