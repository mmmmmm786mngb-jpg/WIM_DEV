				ТекСтрока.НоминальнаяСтоимость = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(ТекСтрока.АктивОбъект, КонецДня(ОтчетОбъект.КонецПериода));
			КонецЕсли;
	
			НоваяСтрока = ОтчетОбъект.РеестрЦенныхБумаг.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
			
			НоваяСтрока.ИдентификаторЦБ = ИдентификаторЦБ;
			
			НайденныйКод = СписокКодовЦББезНоминала.Получить(НоваяСтрока.КодТипаЦБ);
			Если НайденныйКод <> Неопределено Тогда
				НоваяСтрока.КодВалютыЦБ = "#";
				НоваяСтрока.НоминальнаяСтоимость = 0;
			КонецЕсли;
		
			// Ищем сокр. наименование по ИНН в справочнике профучастников
			НайденнаяСтрока = СправочникПрофучастника.Найти(СокрЛП(ТекСтрока.ЭмитентИНН), "ИНН");
			Если НайденнаяСтрока <> Неопределено Тогда
				НоваяСтрока.ЭмитентНаименование = НайденнаяСтрока.НаименованиеСокращенное;
			КонецЕсли;
				
			Если ТипЗнч(ТекСтрока.АктивОбъект) = Тип("СправочникСсылка.ПаиПИФ")	ИЛИ СписокВидовКСУ.Найти(ТекСтрока.ВидАктива) <> Неопределено Тогда
				НоваяСтрока.ЭмитентНаименование = НоваяСтрока.ЭмитентНаименование + " (" + ТекСтрока.АктивНаименование + ")";
			КонецЕсли;
			
			Если ТекСтрока.ДепРасписка Тогда
				ИдентификаторДепРасписки = ?(ЗначениеЗаполнено(ТекСтрока.БазовыйАктив_НомерГосРегистрацииВыпуска), ТекСтрока.БазовыйАктив_НомерГосРегистрацииВыпуска, "000"); 
				ИдентификаторДепРасписки = ИдентификаторДепРасписки + "_" + ?(ЗначениеЗаполнено(ТекСтрока.БазовыйАктив_ISIN), ТекСтрока.БазовыйАктив_ISIN, "000"); 
				ИдентификаторДепРасписки = ИдентификаторДепРасписки + "_" + ?(ЗначениеЗаполнено(ТекСтрока.БазовыйАктив_CFI), ТекСтрока.БазовыйАктив_CFI, "000"); 
				НоваяСтрока.ДепРасписка_ИдентификаторЦББазовогоАктива = ИдентификаторДепРасписки;

				НоваяСтрокаДеп = ОтчетОбъект.РеестрЦенныхБумаг.Добавить();
				НоваяСтрокаДеп.ИдентификаторЦБ = ИдентификаторДепРасписки;
				НоваяСтрокаДеп.ЭмитентНаименование = НоваяСтрока.ЭмитентНаименование;
				НоваяСтрокаДеп.ЭмитентИНН = НоваяСтрока.ЭмитентИНН;
				НоваяСтрокаДеп.ЭмитентОГРН = НоваяСтрока.ЭмитентОГРН;
				НоваяСтрокаДеп.ЭмитентКодСтраны = НоваяСтрока.ЭмитентКодСтраны;
				НоваяСтрокаДеп.ЭмитентМестоНахождения = НоваяСтрока.ЭмитентМестоНахождения;
				НоваяСтрокаДеп.ЭмитентНомерТелефона = НоваяСтрока.ЭмитентНомерТелефона;
				НоваяСтрокаДеп.ФИОЛицаЕдиноличногоИсполнительногоОргана = НоваяСтрока.ФИОЛицаЕдиноличногоИсполнительногоОргана;
				НоваяСтрокаДеп.КодТипаЦБ = ТекСтрока.АктивОбъект.БазовыйАктив.КодТипаЦБ;
				НоваяСтрокаДеп.НомерГосРегистрацииВыпуска = ТекСтрока.БазовыйАктив_НомерГосРегистрацииВыпуска;
				НоваяСтрокаДеп.ISIN = ТекСтрока.БазовыйАктив_ISIN;
				НоваяСтрокаДеп.CFI = ТекСтрока.БазовыйАктив_CFI;
				НоваяСтрокаДеп.КодВалютыЦБ = ТекСтрока.АктивОбъект.БазовыйАктив.ВалютаНоминальнойСтоимости.Код;
				НоваяСтрокаДеп.НоминальнаяСтоимость = ТекСтрока.АктивОбъект.БазовыйАктив.НоминальнаяСтоимость;

			КонецЕсли;
		
		КонецЕсли;	
			
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьРежимыТоргов_РЕПОЦК()
	Перем МассивРежимов;
	
	МассивРежимов = Новый Массив();
	МассивРежимов.Добавить("EQRP");
	МассивРежимов.Добавить("EQWP");
	МассивРежимов.Добавить("EQMP");
	МассивРежимов.Добавить("EQTP");
	МассивРежимов.Добавить("EQRD");
	МассивРежимов.Добавить("EQWD");
	МассивРежимов.Добавить("EQMD");
	МассивРежимов.Добавить("EQTD");
	МассивРежимов.Добавить("EQRE");
	МассивРежимов.Добавить("EQWE");
	МассивРежимов.Добавить("EQME");
	МассивРежимов.Добавить("EQTE");
	МассивРежимов.Добавить("EQRY");
	МассивРежимов.Добавить("PSRP");
	МассивРежимов.Добавить("PSRD");
	МассивРежимов.Добавить("PSRE");
	МассивРежимов.Добавить("PSRY");
	
	Возврат МассивРежимов;
КонецФункции

Процедура ЗаполнитьРаздел_5(ОтчетОбъект, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто2 КАК Справочник.Активы).Объект КАК ЦеннаяБумага,
		|	СтоимостьАктивовУправленческийОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	СтоимостьАктивовУправленческийОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ХозрасчетныйОстатки.ДоговорДУ КАК ДоговорДУ,
		|	ХозрасчетныйОстатки.Субконто2.Объект.НомерГосРегистрацииВыпуска КАК НомерГосРег,
		|	ХозрасчетныйОстатки.Субконто2.Объект.ISIN КАК ISIN,
		|	ХозрасчетныйОстатки.Субконто2.Объект.CFI КАК CFI,
		|	ХозрасчетныйОстатки.Субконто2.Объект.КодТипаЦБ КАК КодТипаЦБ
		|ПОМЕСТИТЬ ВТ_ЦБ
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&КонецПериода,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВУЦБ),
		|			,
		|			ДоговорДУ В
		|					(ВЫБРАТЬ
		|						ДоговорыДУ.ДоговорДУ КАК ДоговорДУ
		|					ИЗ
		|						ВТ_ДействующиеДоговора КАК ДоговорыДУ)
		|				И Субконто2.Объект.КодТипаЦБ = ""OTHER""
		|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.АналитическиеСчета).ВидАналитическогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыАналитическогоСчета.ЦенныеБумаги)) КАК ХозрасчетныйОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьАктивовУправленческий.Остатки(
		|				&КонецПериода,
		|				ДоговорДУ В
		|						(ВЫБРАТЬ
		|							ДоговорыДУ.ДоговорДУ КАК ДоговорДУ
		|						ИЗ
		|							ВТ_ДействующиеДоговора КАК ДоговорыДУ)
		|					И Актив.Объект.КодТипаЦБ = ""OTHER"") КАК СтоимостьАктивовУправленческийОстатки
		|		ПО ХозрасчетныйОстатки.Субконто2 = СтоимостьАктивовУправленческийОстатки.Актив
		|			И ХозрасчетныйОстатки.ДоговорДУ = СтоимостьАктивовУправленческийОстатки.ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СведенияПоКлиентам.КвалификацияИнвестора КАК КвалификацияИнвестора,
		|	ВТ_СведенияПоКлиентам.СтатусКлиента КАК СтатусКлиента,
		|	ВТ_СведенияПоКлиентам.КодПоОКАТОиОКСМ КАК КодПоОКАТОиОКСМ,
		|	ВТ_СведенияПоКлиентам.НеРезидент КАК НеРезидент,
		|	ВТ_СведенияПоКлиентам.КатегорияКлиента КАК КатегорияКлиента,
		|	ВТ_СведенияПоКлиентам.ПризнакИИС КАК ПризнакИИС,
		|	ВТ_СведенияПоКлиентам.ПравоИспользованияДСКлиента КАК ПравоИспользованияДСКлиента,
		|	ВТ_СведенияПоКлиентам.ВидДеятельности КАК ВидДеятельности,
		|	ВТ_СведенияПоКлиентам.ИдентификаторСтратегии + ""_"" + ВЫРАЗИТЬ(ВТ_СведенияПоКлиентам.ДоговорДУ КАК Справочник.ДоговорДУ).Код КАК ИдентификаторСтратегии,
		|	ВТ_ЦБ.НомерГосРег КАК НомерГосРег,
		|	ВТ_ЦБ.ISIN КАК ISIN,
		|	ВТ_ЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВТ_ЦБ.КоличествоОстаток КАК КоличествоЦенныхБумаг,
		|	ВТ_ЦБ.СуммаОстаток КАК СтоимостнаяОценкаНаОтчетнуюДату,
		|	ВТ_ЦБ.CFI КАК CFI,
		|	ВТ_СведенияПоКлиентам.ТипКлиента КАК ТипКлиента,
		|	""Прочее"" КАК ТипИмущества,
		|	ВТ_ЦБ.КодТипаЦБ КАК КодТипаЦБ,
		|	ВТ_СведенияПоКлиентам.ИнвестиционныйПрофиль КАК ИнвестиционныйПрофиль
		|ИЗ
		|	ВТ_СведенияПоКлиентам КАК ВТ_СведенияПоКлиентам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЦБ КАК ВТ_ЦБ
		|		ПО ВТ_СведенияПоКлиентам.ДоговорДУ = ВТ_ЦБ.ДоговорДУ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СведенияПоКлиентам.КатегорияКлиента,
		|	ВТ_СведенияПоКлиентам.КвалификацияИнвестора,
		|	ВТ_СведенияПоКлиентам.ПризнакИИС,
		|	ВТ_СведенияПоКлиентам.НеРезидент,
		|	ВТ_СведенияПоКлиентам.СтатусКлиента,
		|	ВТ_СведенияПоКлиентам.ИдентификаторСтратегии,
		|	ВТ_СведенияПоКлиентам.ПравоИспользованияДСКлиента,
		|	ВТ_СведенияПоКлиентам.ВидДеятельности,
		|	ВТ_СведенияПоКлиентам.КодПоОКАТОиОКСМ,
		|	ВТ_СведенияПоКлиентам.ТипКлиента,
		|	ВТ_ЦБ.ЦеннаяБумага,
		|	ВТ_ЦБ.КоличествоОстаток,
		|	ВТ_ЦБ.ISIN,
		|	ВТ_ЦБ.CFI,
		|	ВТ_ЦБ.НомерГосРег,
		|	ВТ_ЦБ.СуммаОстаток,
		|	ВТ_СведенияПоКлиентам.ИнвестиционныйПрофиль,
		|	ВТ_ЦБ.КодТипаЦБ,
		|	ВТ_СведенияПоКлиентам.ДоговорДУ";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОтчетОбъект.КонецПериода));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл   
		
		ИдентификаторЦБ = ?(ЗначениеЗаполнено(Выборка.НомерГосРег), Выборка.НомерГосРег, "000"); 
		ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Выборка.ISIN), Выборка.ISIN, "000"); 
		ИдентификаторЦБ = ИдентификаторЦБ + "_" + ?(ЗначениеЗаполнено(Выборка.CFI), Выборка.CFI, "000"); 	
	
		НоваяСтрока = ОтчетОбъект.Раздел5.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);  
		НоваяСтрока.ИдентификаторИногоИмущества = ИдентификаторЦБ; 
		НоваяСтрока.УровеньРиска = "Начальный (не присвоен)";		
	КонецЦикла;
	
КонецПроцедуры     

Процедура ЗаполнитьРаздел_6(ОтчетОбъект, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ХозрасчетныйОстаткиИОбороты.Счет КАК Счет,
		|	ХозрасчетныйОстаткиИОбороты.Субконто1 КАК ПФИ,
		|	ХозрасчетныйОстаткиИОбороты.Субконто1.ПолныйКод КАК КодПрисвоенныйОрганизаторомТорговли,
		|	ХозрасчетныйОстаткиИОбороты.Субконто2 КАК Субконто2,
		|	ХозрасчетныйОстаткиИОбороты.Субконто3 КАК Субконто3,
		|	ХозрасчетныйОстаткиИОбороты.ДоговорДУ КАК ДоговорДУ,
		|	ХозрасчетныйОстаткиИОбороты.Валюта КАК Валюта,
		|	ХозрасчетныйОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоПФИ,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Субконто1 КАК Справочник.СрочныеКонтракты).ВидАктива = ЗНАЧЕНИЕ(планвидовхарактеристик.видыактивов.Опционы)
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Субконто1 КАК Справочник.СрочныеКонтракты).Премиальный = ИСТИНА
		|						ТОГДА ОпционныеПремии.ВалютнаяСуммаОстаток
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОпционныеПремииСумма
		|ПОМЕСТИТЬ ВТ_СрочныеКонтракты
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(, &КонецПериода, , , Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВУОП), , Субконто1 ССЫЛКА Справочник.СрочныеКонтракты) КАК ХозрасчетныйОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОпционныеПремии.Остатки(&КонецПериода, ) КАК ОпционныеПремии
		|		ПО ХозрасчетныйОстаткиИОбороты.ДоговорДУ = ОпционныеПремии.ДоговорДУ
		|			И ХозрасчетныйОстаткиИОбороты.Субконто1 = ОпционныеПремии.Опцион
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СведенияПоКлиентам.КвалификацияИнвестора КАК КвалификацияИнвестора,
		|	ВТ_СведенияПоКлиентам.СтатусКлиента КАК СтатусКлиента,
		|	ВТ_СведенияПоКлиентам.КодПоОКАТОиОКСМ КАК КодПоОКАТОиОКСМ,
		|	ВТ_СведенияПоКлиентам.НеРезидент КАК НеРезидент,
		|	ВТ_СведенияПоКлиентам.КатегорияКлиента КАК КатегорияКлиента,
		|	ВТ_СведенияПоКлиентам.ПризнакИИС КАК ПризнакИИС,
		|	ВТ_СведенияПоКлиентам.ПравоИспользованияДСКлиента КАК ПравоИспользованияДСКлиента,
		|	ВТ_СведенияПоКлиентам.ВидДеятельности КАК ВидДеятельности,
		|	ВТ_СведенияПоКлиентам.ИдентификаторСтратегии + ""_"" + ВЫРАЗИТЬ(ВТ_СведенияПоКлиентам.ДоговорДУ КАК Справочник.ДоговорДУ).Код КАК ИдентификаторСтратегии,
		|	ВТ_СведенияПоКлиентам.ТипКлиента КАК ТипКлиента,
		|	ВТ_СрочныеКонтракты.КодПрисвоенныйОрганизаторомТорговли КАК КодПрисвоенныйОрганизаторомТорговли,
		|	ВТ_СрочныеКонтракты.ПФИ КАК ПФИ,
		|	ВТ_СрочныеКонтракты.КоличествоПФИ КАК КоличествоПФИ,
		|	ВЫБОР
		|		КОГДА ВТ_СрочныеКонтракты.КоличествоПФИ > 0
		|			ТОГДА ""Покупка""
		|		ИНАЧЕ ""Продажа""
		|	КОНЕЦ КАК НаправлениеСделки,
		|	ВТ_СрочныеКонтракты.ОпционныеПремииСумма КАК ОпционныеПремииСумма,
		|	ВТ_СведенияПоКлиентам.ИнвестиционныйПрофиль КАК ИнвестиционныйПрофиль,
		|	""На организованных торгах"" КАК МестоЗаключенияДоговораПФИ
		|ИЗ
		|	ВТ_СведенияПоКлиентам КАК ВТ_СведенияПоКлиентам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СрочныеКонтракты КАК ВТ_СрочныеКонтракты
		|		ПО ВТ_СведенияПоКлиентам.ДоговорДУ = ВТ_СрочныеКонтракты.ДоговорДУ";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ОтчетОбъект.КонецПериода));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл   
		ПФИ = Выборка.ПФИ;      
		
		Если ПФИ.ВидАктива = ПланыВидовХарактеристик.ВидыАктивов.Фьючерсы Тогда
			ВидПФИ = "фьючерс"; 
		ИначеЕсли ПФИ.ВидАктива = ПланыВидовХарактеристик.ВидыАктивов.Опционы Тогда
			ВидПФИ = "опцион";
		Иначе
			ВидПФИ = ПФИ.ВидАктива.Наименование;
		КонецЕсли;
		
		ОрганизаторТоргов = ?(ПФИ.БиржаЛистинга.Код = "ММВБ", "ПАО Московская Биржа", ПФИ.БиржаЛистинга.Наименование);
		
		НоваяСтрока = ОтчетОбъект.Раздел6.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.НаименованиеОрганизатораТорговли	=	ОрганизаторТоргов;
		НоваяСтрока.ИдентификаторПФИ 					=	ВидПФИ + "_" +  ПФИ.ПолныйКод;
		НоваяСтрока.НаименованиеПФИ                     =	ПФИ.ПолныйКод;
		НоваяСтрока.СтоимостьПФИ						=	Выборка.ОпционныеПремииСумма;
		НоваяСтрока.ВидПФИ = ВидПФИ;
		НоваяСтрока.УровеньРиска = "Начальный (не присвоен)";
		
	КонецЦикла;
	
КонецПроцедуры

