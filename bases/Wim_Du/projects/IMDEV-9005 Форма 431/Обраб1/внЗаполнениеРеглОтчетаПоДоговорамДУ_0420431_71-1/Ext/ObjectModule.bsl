Процедура ДополнитьВТ_ВводыВыводы(ОтчетОбъект, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Активы_Обороты.ДоговорДУ КАК ДоговорДУ,
		|	СУММА(Активы_Обороты.ВводДС_ДенСчета) КАК ВводДС_ДенСчета,
		|	СУММА(Активы_Обороты.ВыводДС_ДенСчета) КАК ВыводДС_ДенСчета,
		|	СУММА(Активы_Обороты.ВводДС_ДепСчета) КАК ВводДС_ДепСчета,
		|	СУММА(Активы_Обороты.ВыводДС_ДепСчета) КАК ВыводДС_ДепСчета,
		|	СУММА(Активы_Обороты.ВводЦБ) КАК ВводЦБ,
		|	СУММА(Активы_Обороты.ВыводЦБ) КАК ВыводЦБ
		|ПОМЕСТИТЬ втВводыВыводыПодготовленная
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДС_Вводы.ДоговорДУ КАК ДоговорДУ,
		|		ВЫБОР
		|			КОГДА ВЫРАЗИТЬ(ДС_Вводы.Регистратор КАК Документ.ПоступлениеНаРасчетныйСчет).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.ВводДенежныхСредствВДУ)
		|					И ВЫРАЗИТЬ(ДС_Вводы.АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный)
		|				ТОГДА ДС_Вводы.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК ВводДС_ДенСчета,
		|		ВЫБОР
		|			КОГДА ВЫРАЗИТЬ(ДС_Вводы.АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
		|				ТОГДА ДС_Вводы.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК ВводДС_ДепСчета,
		|		0 КАК ВыводДС_ДенСчета,
		|		0 КАК ВыводДС_ДепСчета,
		|		0 КАК ВводЦБ,
		|		0 КАК ВыводЦБ
		|	ИЗ
		|		РегистрНакопления.ДенежныеСредстваУправленческий КАК ДС_Вводы
		|	ГДЕ
		|		ДС_Вводы.Активность
		|		И ДС_Вводы.Период >= НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ)
		|		И ДС_Вводы.Период < НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ДЕНЬ, 1), ДЕНЬ)
		|		И ДС_Вводы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|		И ДС_Вводы.АналитическийСчет.ВидАналитическогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыАналитическогоСчета.ДенежныеСредства)
		|		И ДС_Вводы.АналитическийСчет.МестоХранения ССЫЛКА Справочник.БанковскиеСчета
		|		И ВЫРАЗИТЬ(ДС_Вводы.АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный), ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный))
		|		И ДС_Вводы.Регистратор ССЫЛКА Документ.ПоступлениеНаРасчетныйСчет
		|		И ВЫРАЗИТЬ(ДС_Вводы.Регистратор КАК Документ.ПоступлениеНаРасчетныйСчет).СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ВводАктивов)
		|		И ДС_Вводы.ДоговорДУ В
		|				(ВЫБРАТЬ
		|					втВыбранныеДоговорыВводы.ДоговорДУ
		|				ИЗ
		|					втВыбранныеДоговорыВводы КАК втВыбранныеДоговорыВводы)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ДС_Выводы.ДоговорДУ,
		|		0,
		|		0,
		|		ВЫБОР
		|			КОГДА ВЫРАЗИТЬ(ДС_Выводы.Регистратор КАК Документ.СписаниеСРасчетногоСчета).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписаниеДенежныхСредств.ВыводДенежныхСредствИзДУ)
		|					И ВЫРАЗИТЬ(ДС_Выводы.АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный)
		|				ТОГДА ДС_Выводы.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ,
		|		ВЫБОР
		|			КОГДА ВЫРАЗИТЬ(ДС_Выводы.АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
		|				ТОГДА ДС_Выводы.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ,
		|		0,
		|		0
		|	ИЗ
		|		РегистрНакопления.ДенежныеСредстваУправленческий КАК ДС_Выводы
		|	ГДЕ
		|		ДС_Выводы.Активность
		|		И ДС_Выводы.Период >= НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ)
		|		И ДС_Выводы.Период < НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ДЕНЬ, 1), ДЕНЬ)
		|		И ДС_Выводы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|		И ДС_Выводы.АналитическийСчет.ВидАналитическогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыАналитическогоСчета.ДенежныеСредства)
		|		И ДС_Выводы.АналитическийСчет.МестоХранения ССЫЛКА Справочник.БанковскиеСчета
		|		И ВЫРАЗИТЬ(ДС_Выводы.АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ВидСчета В (ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный), ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный))
		|		И ДС_Выводы.Регистратор ССЫЛКА Документ.СписаниеСРасчетногоСчета
		|		И ВЫРАЗИТЬ(ДС_Выводы.Регистратор КАК Документ.СписаниеСРасчетногоСчета).СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.ВыводАктивов)
		|		И ДС_Выводы.ДоговорДУ В
		|				(ВЫБРАТЬ
		|					втВыбранныеДоговорыВводы.ДоговорДУ
		|				ИЗ
		|					втВыбранныеДоговорыВводы КАК втВыбранныеДоговорыВводы)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		СтоимостьАктивов.ДоговорДУ,
		|		0,
		|		0,
		|		0,
		|		0,
		|		ВЫБОР
		|			КОГДА СтоимостьАктивов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА СтоимостьАктивов.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ,
		|		ВЫБОР
		|			КОГДА СтоимостьАктивов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА СтоимостьАктивов.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ
		|	ИЗ
		|		РегистрНакопления.СтоимостьАктивовУправленческий КАК СтоимостьАктивов
		|	ГДЕ
		|		СтоимостьАктивов.Активность
		|		И СтоимостьАктивов.Период >= НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ)
		|		И СтоимостьАктивов.Период < НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ДЕНЬ, 1), ДЕНЬ)
		|		И СтоимостьАктивов.Регистратор ССЫЛКА Документ.ВводВыводЦенныхБумагИзДУ
		|		И СтоимостьАктивов.ДоговорДУ В
		|				(ВЫБРАТЬ
		|					втВыбранныеДоговорыВводы.ДоговорДУ
		|				ИЗ
		|					втВыбранныеДоговорыВводы КАК втВыбранныеДоговорыВводы)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		НачисленныеКД.ДоговорДУ,
		|		0,
		|		0,
		|		0,
		|		0,
		|		ВЫБОР
		|			КОГДА НачисленныеКД.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА НачисленныеКД.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ,
		|		ВЫБОР
		|			КОГДА НачисленныеКД.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА НачисленныеКД.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ
		|	ИЗ
		|		РегистрНакопления.НачисленныйКупонныйДоходУправленческий КАК НачисленныеКД
		|	ГДЕ
		|		НачисленныеКД.Активность
		|		И НачисленныеКД.Период >= НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ)
		|		И НачисленныеКД.Период < НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&КонецПериода, ДЕНЬ, 1), ДЕНЬ)
		|		И НачисленныеКД.Регистратор ССЫЛКА Документ.ВводВыводЦенныхБумагИзДУ
		|		И НачисленныеКД.ДоговорДУ В
		|				(ВЫБРАТЬ
		|					втВыбранныеДоговорыВводы.ДоговорДУ
		|				ИЗ
		|					втВыбранныеДоговорыВводы КАК втВыбранныеДоговорыВводы)) КАК Активы_Обороты
		|
		|СГРУППИРОВАТЬ ПО
		|	Активы_Обороты.ДоговорДУ
		|
		|ИМЕЮЩИЕ
		|	(СУММА(Активы_Обороты.ВводДС_ДенСчета) <> 0
		|		ИЛИ СУММА(Активы_Обороты.ВыводДС_ДенСчета) <> 0
		|		ИЛИ СУММА(Активы_Обороты.ВводДС_ДепСчета) <> 0
		|		ИЛИ СУММА(Активы_Обороты.ВыводДС_ДепСчета) <> 0
		|		ИЛИ СУММА(Активы_Обороты.ВводЦБ) <> 0
		|		ИЛИ СУММА(Активы_Обороты.ВыводЦБ) <> 0)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
