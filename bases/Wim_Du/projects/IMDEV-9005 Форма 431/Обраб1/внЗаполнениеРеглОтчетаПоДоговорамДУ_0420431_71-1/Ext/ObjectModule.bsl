Процедура ЗаполнитьРазделРеестрЦБ(ОтчетОбъект, МВТ)
	
	СписокКодовЦББезНоминала = Новый Соответствие;	
	СписокКодовЦББезНоминала.Вставить("DS1", "DS1 – депозитные сертификаты кредитных организаций–резидентов");
	СписокКодовЦББезНоминала.Вставить("DS2", "DS2 – депозитные сертификаты банков – нерезидентов");
	СписокКодовЦББезНоминала.Вставить("SS1", "SS1 – сберегательные сертификаты кредитных организаций–резидентов");
	СписокКодовЦББезНоминала.Вставить("SS2", "SS2 – сберегательные сертификаты банков – нерезидентов");
	СписокКодовЦББезНоминала.Вставить("SHS7","SHS7 – паи, доли инвестиционных фондов – нерезидентов");
	СписокКодовЦББезНоминала.Вставить("SHS8","SHS8 – паи, доли инвестиционных фондов – резидентов");
	СписокКодовЦББезНоминала.Вставить("DR", "DR – депозитарные расписки");
	СписокКодовЦББезНоминала.Вставить("CON", "CON – складское свидетельство");
	СписокКодовЦББезНоминала.Вставить("WTS", "WTS – варранты");
	СписокКодовЦББезНоминала.Вставить("OPN", "OPN – опционы эмитента");
	СписокКодовЦББезНоминала.Вставить("ENC", "ENC – закладные");
	СписокКодовЦББезНоминала.Вставить("OTHER","OTHER – иное (в том числе иностранные финансовые инструменты, не квалифицированные в качестве ценных бумаг)");
	СписокКодовЦББезНоминала.Вставить("ISU","ISU – ипотечные сертификаты участия");
	
	СписокВидовКСУ = Новый Массив;
	СписокВидовКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_GC_Bonds);
	СписокВидовКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_OFZ);
	СписокВидовКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_Акции);
	СписокВидовКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_Все);
	СписокВидовКСУ.Добавить(ПланыВидовХарактеристик.ВидыАктивов.КСУ_Мтл);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведенияПрофучастника.ИНН,
		|	СведенияПрофучастника.НаименованиеСокращенное
		|ИЗ
		|	РегистрСведений.СведенияПрофучастника КАК СведенияПрофучастника";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СправочникПрофучастника = РезультатЗапроса.Выгрузить();
	СправочникПрофучастника.Индексы.Добавить("ИНН");

#Область _Запрос	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("ТЗсписокКлиентов", ТЗсписокКлиентов);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	БлокированныеЦБСрезПоследних.ДоговорДУ КАК ДоговорДУ,
		|	БлокированныеЦБСрезПоследних.СчетДЕПО КАК СчетДЕПО,
		|	БлокированныеЦБСрезПоследних.Актив КАК Актив,
		|	БлокированныеЦБСрезПоследних.ТипБлокировки КАК ТипБлокировки,
		|	БлокированныеЦБСрезПоследних.Количество КАК Количество,
		|	БлокированныеЦБСрезПоследних.Разблокированы КАК Разблокированы,
		|	БлокированныеЦБСрезПоследних.ДатаРазблокировки КАК ДатаРазблокировки,
		|	БлокированныеЦБСрезПоследних.Разблокированы = ЛОЖЬ
		|		ИЛИ БлокированныеЦБСрезПоследних.Разблокированы = ИСТИНА
		|			И БлокированныеЦБСрезПоследних.ДатаРазблокировки > &КонецОтчета КАК Действующие
		|ПОМЕСТИТЬ ВТ_БлокированныеЦБ
		|ИЗ
		|	РегистрСведений.БлокированныеЦБ.СрезПоследних(
		|			&КонецПериода,
		|			ДоговорДУ.УправляющаяКомпания = &УправляющаяКомпания
		|				И ДоговорДУ.ПометкаУдаления = ЛОЖЬ
		|				И ДоговорДУ.ТипКлиентаДУ В (&ТипыКлиентов)
		//
		|	и ДоговорДУ.Клиент В(&ТЗсписокКлиентов)						
		//
		|) КАК БлокированныеЦБСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
