// IMDEV-8899 3.2: оптимизация единичного запроса — срез с фильтром вместо ПОМЕСТИТЬ + ЛЕВОЕ СОЕДИНЕНИЕ
// Бенчмарк: 3000 договоров x 4 набора, 0 расхождений, -69% к текущему КФ

&ИзменениеИКонтроль("ЗначенияПараметровДоговораДУ")
Функция rev2_ЗначенияПараметровДоговораДУ(ДоговорДУ, Параметры, Знач Дата = '00010101') Экспорт
	ЗначенияПараметров = Новый Соответствие;
	
	Если Параметры = Неопределено тогда 
		 Возврат ЗначенияПараметров;
	КонецЕсли;
	
	Если ТипЗнч(Параметры)<>Тип("Массив") тогда
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(Параметры);
	Иначе
		МассивПараметров = Параметры;
	КонецЕсли;
	
	Если Дата = '00010101' тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	#Вставка
	Для Каждого Параметр Из МассивПараметров Цикл
		ЗначенияПараметров.Вставить(Параметр, Неопределено);
	КонецЦикла;
	#КонецВставки
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", 			Дата);
	Запрос.УстановитьПараметр("ДоговорДУ", 		ДоговорДУ);
	Запрос.УстановитьПараметр("Параметры", 		МассивПараметров);

	#Удаление
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПараметрыДоговораДУ.Ссылка
	               |ПОМЕСТИТЬ Параметры
	               |ИЗ
	               |	ПланВидовХарактеристик.ПараметрыДоговораДУ КАК ПараметрыДоговораДУ
	               |ГДЕ
	               |	ПараметрыДоговораДУ.Ссылка В(&Параметры)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Параметры.Ссылка КАК Параметр,
	               |	ЕСТЬNULL(ПараметрыДУ.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
	               |ИЗ
	               |	Параметры КАК Параметры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
	               |				&Дата,
	               |				ДоговорДУ = &ДоговорДУ
	               |					И Параметр В (&Параметры)) КАК ПараметрыДУ
	               |		ПО Параметры.Ссылка = ПараметрыДУ.Параметр";
	#КонецУдаления
	#Вставка
	Запрос.Текст =
	"ВЫБРАТЬ
	|    Срез.Параметр КАК Параметр,
	|    Срез.Значение КАК Значение
	|ИЗ
	|    РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
	|            &Дата,
	|            ДоговорДУ = &ДоговорДУ
	|                И Параметр В (&Параметры)) КАК Срез";
	#КонецВставки
	#Удаление
				   
   
   ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "РегистрСведений.ЗначенияПараметровДоговоровДУ.МодульМенеджера:ЗначенияПараметровДоговораДУ");
   
   Результат = Запрос.Выполнить();
   ВыборкаВариантов = Результат.Выбрать();
   
   Пока ВыборкаВариантов.Следующий() Цикл
	   ЗначенияПараметров.Вставить(ВыборкаВариантов.Параметр, ВыборкаВариантов.Значение);	   
   КонецЦикла;
	#КонецУдаления
	#Вставка
   Выборка = Запрос.Выполнить().Выбрать();
   
   Пока Выборка.Следующий() Цикл
	   ЗначенияПараметров.Вставить(Выборка.Параметр, Выборка.Значение);
   КонецЦикла;
	#КонецВставки
   
   Возврат ЗначенияПараметров;
   
КонецФункции

// Описание: Возвращает значения параметров по списку договоров ДУ на дату.
//
// Параметры:
// МассивДоговоровДУ - Массив - список договоров ДУ
// Параметры - Массив, ПланВидовХарактеристикСсылка.ПараметрыДоговораДУ - список параметров
// Дата - Дата - дата получения среза
//
// Возвращаемое значение:
// Соответствие - ключ: ДоговорДУ, значение: Соответствие(Параметр -> Значение)
//
Функция ЗначенияПараметровДоговоровДУ(МассивДоговоровДУ, Параметры, Знач Дата = '00010101') Экспорт

    Результат = Новый Соответствие;

    Если Не ЗначениеЗаполнено(МассивДоговоровДУ) Или Параметры = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;

    Если ТипЗнч(Параметры) <> Тип("Массив") Тогда
        МассивПараметров = Новый Массив;
        МассивПараметров.Добавить(Параметры);
    Иначе
        МассивПараметров = Параметры;
    КонецЕсли;

    Если Дата = '00010101' Тогда
        Дата = ТекущаяДатаСеанса();
    КонецЕсли;

    Для Каждого ДоговорДУ Из МассивДоговоровДУ Цикл
        ЗначенияПараметровДоговора = Новый Соответствие;
        Для Каждого Параметр Из МассивПараметров Цикл
            ЗначенияПараметровДоговора.Вставить(Параметр, Неопределено);
        КонецЦикла;
        Результат.Вставить(ДоговорДУ, ЗначенияПараметровДоговора);
    КонецЦикла;

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("МассивДоговоровДУ", МассивДоговоровДУ);
    Запрос.УстановитьПараметр("Параметры", МассивПараметров);

    Запрос.Текст =
    "ВЫБРАТЬ
    |    ПараметрыДУ.ДоговорДУ КАК ДоговорДУ,
    |    ПараметрыДУ.Параметр КАК Параметр,
    |    ПараметрыДУ.Значение КАК Значение
    |ИЗ
    |    РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
    |            &Дата,
    |            ДоговорДУ В (&МассивДоговоровДУ)
    |                И Параметр В (&Параметры)) КАК ПараметрыДУ";

    ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос,
        "РегистрСведений.ЗначенияПараметровДоговоровДУ.МодульМенеджера:ЗначенияПараметровДоговоровДУ");

    ВыборкаПараметров = Запрос.Выполнить().Выбрать();
    Пока ВыборкаПараметров.Следующий() Цикл
        ЗначенияПараметровДоговора = Результат.Получить(ВыборкаПараметров.ДоговорДУ);
        Если ЗначенияПараметровДоговора <> Неопределено Тогда
            ЗначенияПараметровДоговора.Вставить(ВыборкаПараметров.Параметр, ВыборкаПараметров.Значение);
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции
