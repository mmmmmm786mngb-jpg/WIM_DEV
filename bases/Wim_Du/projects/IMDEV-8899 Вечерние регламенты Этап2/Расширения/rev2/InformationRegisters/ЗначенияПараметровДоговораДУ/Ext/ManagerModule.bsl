// IMDEV-8899 3.2: оптимизация единичного запроса — срез с фильтром вместо ПОМЕСТИТЬ + ЛЕВОЕ СОЕДИНЕНИЕ
// Бенчмарк: 3000 договоров x 4 набора, 0 расхождений, -69% к текущему КФ

&ИзменениеИКонтроль("ЗначенияПараметровДоговораДУ")
Функция rev2_ЗначенияПараметровДоговораДУ(ДоговорДУ, Параметры, Знач Дата = '00010101') Экспорт
	ЗначенияПараметров = Новый Соответствие;
	
	Если Параметры = Неопределено тогда 
		 Возврат ЗначенияПараметров;
	КонецЕсли;
	
	Если ТипЗнч(Параметры)<>Тип("Массив") тогда
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(Параметры);
	Иначе
		МассивПараметров = Параметры;
	КонецЕсли;
	
	Если Дата = '00010101' тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	#Вставка
	Для Каждого Параметр Из МассивПараметров Цикл
		ЗначенияПараметров.Вставить(Параметр, Неопределено);
	КонецЦикла;
	#КонецВставки
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", 			Дата);
	Запрос.УстановитьПараметр("ДоговорДУ", 		ДоговорДУ);
	Запрос.УстановитьПараметр("Параметры", 		МассивПараметров);

	#Удаление
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПараметрыДоговораДУ.Ссылка
	               |ПОМЕСТИТЬ Параметры
	               |ИЗ
	               |	ПланВидовХарактеристик.ПараметрыДоговораДУ КАК ПараметрыДоговораДУ
	               |ГДЕ
	               |	ПараметрыДоговораДУ.Ссылка В(&Параметры)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Параметры.Ссылка КАК Параметр,
	               |	ЕСТЬNULL(ПараметрыДУ.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
	               |ИЗ
	               |	Параметры КАК Параметры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
	               |				&Дата,
	               |				ДоговорДУ = &ДоговорДУ
	               |					И Параметр В (&Параметры)) КАК ПараметрыДУ
	               |		ПО Параметры.Ссылка = ПараметрыДУ.Параметр";
	#КонецУдаления
	#Вставка
	Запрос.Текст =
	"ВЫБРАТЬ
	|    Срез.Параметр КАК Параметр,
	|    Срез.Значение КАК Значение
	|ИЗ
	|    РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
	|            &Дата,
	|            ДоговорДУ = &ДоговорДУ
	|                И Параметр В (&Параметры)) КАК Срез";
	#КонецВставки
	#Удаление
				   
   
   ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "РегистрСведений.ЗначенияПараметровДоговоровДУ.МодульМенеджера:ЗначенияПараметровДоговораДУ");
   
   Результат = Запрос.Выполнить();
   ВыборкаВариантов = Результат.Выбрать();
   
   Пока ВыборкаВариантов.Следующий() Цикл
	   ЗначенияПараметров.Вставить(ВыборкаВариантов.Параметр, ВыборкаВариантов.Значение);	   
   КонецЦикла;
	#КонецУдаления
	#Вставка
   Выборка = Запрос.Выполнить().Выбрать();
   
   Пока Выборка.Следующий() Цикл
	   ЗначенияПараметров.Вставить(Выборка.Параметр, Выборка.Значение);
   КонецЦикла;
	#КонецВставки
   
   Возврат ЗначенияПараметров;
   
КонецФункции
