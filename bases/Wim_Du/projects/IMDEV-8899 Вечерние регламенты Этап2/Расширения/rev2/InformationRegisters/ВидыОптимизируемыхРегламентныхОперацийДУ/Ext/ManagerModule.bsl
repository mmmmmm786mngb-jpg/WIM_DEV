// Описание: Модуль менеджера РС "ВидыОптимизируемыхРегламентныхОперацийДУ" (расширение rev2, IMDEV-8899).
// Предварительный отсев договоров ДУ по видам вечерних регламентных операций.

#Область ПрограммныйИнтерфейс

// Описание: Снимает признак Выполнять у строк списка операций закрытия, по которым расчет заведомо не нужен.
//
// Параметры:
//  ДатаПериода - Дата - дата регламентного периода
//  СписокОпераций - ТаблицаЗначений - колонки: ДоговорДУ, ВидОперации, Выполнять, ВремяРеглОпераций, ГруппаОперацийПользователя
//  МассивДоговоровДУ - Массив из СправочникСсылка.ДоговорДУ - договоры, отобранные на форме (динамический список); необязательный
//
Процедура ОтфильтроватьСписокОперацийЗакрытия(ДатаПериода, СписокОпераций, МассивДоговоровДУ = Неопределено) Экспорт
	
	Если Не Константы.ИспользоватьПредварительныеЗапросыДляВечернихРегламентов.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	Если СписокОпераций = Неопределено Или СписокОпераций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивДоговоровДУ = Неопределено Тогда
		МассивДоговоровДУ = УникальныеДоговорыИзСпискаОпераций(СписокОпераций);
	КонецЕсли;
	
	Если Не ВсеДоговорыСПуломРозничноеДУ(МассивДоговоровДУ) Тогда
		Возврат;
	КонецЕсли;
	
	ВидыКОбработке = ВидыОперацийДляОптимизации();
	Если ВидыКОбработке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ВидОперации Из ВидыКОбработке Цикл
		
		МассивДоговоров = ДоговорыПоВидуОперацииИзСписка(СписокОпераций, ВидОперации);
		Если МассивДоговоров.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДоговорыОставить = ПолучитьДоговорыДляСохраненияВыполнения(МассивДоговоров, ДатаПериода, ВидОперации);
		СнятьВыполнениеПоДоговорам(СписокОпераций, ВидОперации, ДоговорыОставить);
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Возвращает подмножество договоров ДУ, для которых операцию оставляют в исполнении.
//
// Параметры:
//  МассивДоговоровДУ - Массив из СправочникСсылка.ДоговорДУ
//  День - Дата - дата регламентного периода
//  ВидОперации - СправочникСсылка.ВидыОперацийЗакрытияПериода
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ДоговорДУ
//
Функция ПолучитьДоговорыДляСохраненияВыполнения(МассивДоговоровДУ, День, ВидОперации) Экспорт
	
	Если Не ЗначениеЗаполнено(МассивДоговоровДУ) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Если Не ВидОперацииВРегистреОптимизации(ВидОперации) Тогда
		Возврат МассивДоговоровДУ;
	КонецЕсли;
	
	Если ЭтоВидПереоценкиДенежныхСредств(ВидОперации) Тогда
		Возврат ДоговорыСОснованиемДляПереоценкиДСОптимизированно(МассивДоговоровДУ, День);
	КонецЕсли;
	
	Если ЭтоВидСписанияДефолтныхОблигаций(ВидОперации) Тогда
		Возврат ДоговорыСДефолтнымиСобытиямиОптимизированно(МассивДоговоровДУ, День);
	КонецЕсли;
	
	Если ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.КонтрольУменьшенияСтоимостиПортфеля_УУ Тогда
		Возврат ДоговорыДляКонтроляУменьшенияПортфеляОптимизированно(МассивДоговоровДУ, День);
	КонецЕсли;
	
	Возврат МассивДоговоровДУ;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Проверяет, что у всех договоров из отбора формы реквизит Пул = "Розничное ДУ" (по наименованию).
// При смешанном отборе отсев не применяется (аналогично RduPF / IMDEV-8641).
//
Функция ВсеДоговорыСПуломРозничноеДУ(МассивДоговоровДУ)
	
	Если МассивДоговоровДУ = Неопределено Или МассивДоговоровДУ.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаименованиеПулаРозничноеДУ = "Розничное ДУ";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьНарушениеПула
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорДУ
	|ГДЕ
	|	ДоговорДУ.Ссылка В(&МассивДоговоровДУ)
	|	И (НЕ ЗначениеЗаполнено(ДоговорДУ.Пул)
	|		ИЛИ ДоговорДУ.Пул.Наименование <> &НаименованиеПулаРозничноеДУ)";
	
	Запрос.УстановитьПараметр("МассивДоговоровДУ", МассивДоговоровДУ);
	Запрос.УстановитьПараметр("НаименованиеПулаРозничноеДУ", НаименованиеПулаРозничноеДУ);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

Функция УникальныеДоговорыИзСпискаОпераций(СписокОпераций)
	
	МассивДоговоров = Новый Массив;
	
	Для Каждого СтрокаСписка Из СписокОпераций Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСписка.ДоговорДУ) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивДоговоров.Найти(СтрокаСписка.ДоговорДУ) = Неопределено Тогда
			МассивДоговоров.Добавить(СтрокаСписка.ДоговорДУ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивДоговоров;
	
КонецФункции

Функция ВидОперацииВРегистреОптимизации(ВидОперации)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Есть
	|ИЗ
	|	РегистрСведений.ВидыОптимизируемыхРегламентныхОперацийДУ КАК Опт
	|ГДЕ
	|	Опт.ВидОперации = &ВидОперации";
	
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ВидыОперацийДляОптимизации()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Опт.ВидОперации КАК ВидОперации
	|ИЗ
	|	РегистрСведений.ВидыОптимизируемыхРегламентныхОперацийДУ КАК Опт";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидОперации");
	
КонецФункции

Функция ЭтоВидПереоценкиДенежныхСредств(ВидОперации)
	
	Возврат ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.ПереоценкаДенежныхСредств_БУ
		Или ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.ПереоценкаДенежныхСредств_НУ
		Или ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.ПереоценкаДенежныхСредств_УУ;
	
КонецФункции

Функция ЭтоВидСписанияДефолтныхОблигаций(ВидОперации)
	
	Возврат ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.СписаниеДефолтныхОблигаций_БУ
		Или ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.СписаниеДефолтныхОблигаций_НУ
		Или ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.СписаниеДефолтныхОблигаций_УУ;
	
КонецФункции

Функция ДоговорыПоВидуОперацииИзСписка(СписокОпераций, ВидОперации)
	
	ПараметрыОтбора = Новый Структура("ВидОперации, Выполнять", ВидОперации, Истина);
	НайденныеСтроки = СписокОпераций.НайтиСтроки(ПараметрыОтбора);
	
	МассивДоговоров = Новый Массив;
	Для Каждого СтрокаСписка Из НайденныеСтроки Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСписка.ДоговорДУ) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивДоговоров.Найти(СтрокаСписка.ДоговорДУ) = Неопределено Тогда
			МассивДоговоров.Добавить(СтрокаСписка.ДоговорДУ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивДоговоров;
	
КонецФункции

Процедура СнятьВыполнениеПоДоговорам(СписокОпераций, ВидОперации, ДоговорыОставить)
	
	СоответствиеОставить = Новый Соответствие;
	Для Каждого ДоговорДУ Из ДоговорыОставить Цикл
		СоответствиеОставить.Вставить(ДоговорДУ, Истина);
	КонецЦикла;
	
	ПараметрыОтбора = Новый Структура("ВидОперации, Выполнять", ВидОперации, Истина);
	НайденныеСтроки = СписокОпераций.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого СтрокаСписка Из НайденныеСтроки Цикл
		
		Если СоответствиеОставить.Получить(СтрокаСписка.ДоговорДУ) = Неопределено Тогда
			СтрокаСписка.Выполнять = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Граница предыдущего отчетного периода по значению параметра периодичности отчета ДУ.
//
// Параметры:
//  ПериодичностьОтчетаДУ - Произвольный - значение параметра ПериодичностьОтчетаДУ
//  День - Дата
//
// Возвращаемое значение:
//  Дата, Неопределено - Неопределено, если периодичность отчета не задана или некорректна
//
Функция ПредыдущийПериодКонтроляУменьшенияПортфеляПоПериодичности(ПериодичностьОтчетаДУ, День)
	
	Если Не ЗначениеЗаполнено(ПериодичностьОтчетаДУ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПериодичностьОтчетаДУДата = Дата("00010101");
	
	Если ПериодичностьОтчетаДУ.Периодичность = Перечисления.Периодичность.Квартал Тогда
		ПериодичностьОтчетаДУДата = НачалоКвартала(День);
	ИначеЕсли ПериодичностьОтчетаДУ.Периодичность = Перечисления.Периодичность.Месяц Тогда
		ПериодичностьОтчетаДУДата = НачалоМесяца(День);
	ИначеЕсли ПериодичностьОтчетаДУ.Периодичность = Перечисления.Периодичность.Год Тогда
		ПериодичностьОтчетаДУДата = НачалоГода(День);
	КонецЕсли;
	
	Если ПериодичностьОтчетаДУДата = Дата("00010101") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПериодичностьОтчетаДУ.ТипДня = Перечисления.ТипДня.ПустаяСсылка() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПериодичностьОтчетаДУ.ТипДня = Перечисления.ТипДня.КалендарныйДень Тогда
		Возврат ПериодичностьОтчетаДУДата - 1;
	Иначе
		Календарь = ?(ПериодичностьОтчетаДУ.Календарь = Справочники.Календари.ПустаяСсылка(),
			Справочники.Календари.РегламентированныйКалендарь,
			ПериодичностьОтчетаДУ.Календарь);
		Возврат КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(Календарь, ПериодичностьОтчетаДУДата - 1, -1);
	КонецЕсли;
	
КонецФункции

#Область ОптимизацияЗапросовЭтап4

// Описание: Пакетный отбор договоров с основанием для переоценки ДС по логике документа ПереоценкаДенежныхСредств
// (ТекстЗапросаБУ/ВУ/УУЗаполнение) и критерию Операция_0100_ПереоценкаДенежныхСредств.
//
// Параметры:
//  МассивДоговоровДУ - Массив из СправочникСсылка.ДоговорДУ
//  День - Дата
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ДоговорДУ
//
Функция ДоговорыСОснованиемДляПереоценкиДСОптимизированно(МассивДоговоровДУ, День)
	
	Если Не ЗначениеЗаполнено(МассивДоговоровДУ) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиБанк.ДоговорДУ КАК ДоговорДУ
	|ПОМЕСТИТЬ ВТ_ДоговорыСОснованием
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&День,
	|			Счет В (&СчетаБанковские)
	|				И Счет.Валютный = ИСТИНА,
	|			,
	|			ДоговорДУ В (&МассивДоговоровДУ)
	|				И Субконто1 ССЫЛКА Справочник.БанковскиеСчета
	|				И Валюта <> &ВалютаРегл) КАК ОстаткиБанк
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ОстаткиБанк.ВалютнаяСуммаОстатокДт <> 0
	|				ТОГДА ЕСТЬNULL(ОстаткиБанк.ВалютнаяСуммаОстатокДт, 0)
	|			ИНАЧЕ ЕСТЬNULL(ОстаткиБанк.ВалютнаяСуммаОстатокКт, 0)
	|		КОНЕЦ > 0
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиБрокер.ДоговорДУ
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&День,
	|			Счет В ИЕРАРХИИ (&СчетаБрокерские)
	|				И Счет.Валютный = ИСТИНА,
	|			,
	|			ДоговорДУ В (&МассивДоговоровДУ)
	|				И Субконто1 ССЫЛКА Справочник.Контрагенты
	|				И Субконто2 ССЫЛКА Справочник.ДоговорыКонтрагентов
	|				И Валюта <> &ВалютаРегл) КАК ОстаткиБрокер
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ОстаткиБрокер.ВалютнаяСуммаОстатокДт <> 0
	|				ТОГДА ЕСТЬNULL(ОстаткиБрокер.ВалютнаяСуммаОстатокДт, 0)
	|			ИНАЧЕ ЕСТЬNULL(ОстаткиБрокер.ВалютнаяСуммаОстатокКт, 0)
	|		КОНЕЦ > 0
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиВУ.ДоговорДУ
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&День,
	|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВУДС)
	|				И Счет.Валютный = ИСТИНА,
	|			,
	|			ДоговорДУ В (&МассивДоговоровДУ)
	|				И Валюта <> &ВалютаРегл) КАК ОстаткиВУ
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ОстаткиВУ.ВалютнаяСуммаОстатокДт <> 0
	|				ТОГДА ЕСТЬNULL(ОстаткиВУ.ВалютнаяСуммаОстатокДт, 0)
	|			ИНАЧЕ ЕСТЬNULL(ОстаткиВУ.ВалютнаяСуммаОстатокКт, 0)
	|		КОНЕЦ > 0
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиУУ.ДоговорДУ
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваУправленческий.Остатки(
	|			&День,
	|			ДоговорДУ В (&МассивДоговоровДУ)
	|				И Валюта <> &ВалютаРегл) КАК ОстаткиУУ
	|ГДЕ
	|	ОстаткиУУ.ВалютнаяСуммаОстаток <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ДоговорыСОснованием.ДоговорДУ КАК ДоговорДУ
	|ИЗ
	|	ВТ_ДоговорыСОснованием КАК ВТ_ДоговорыСОснованием";
	
	СчетаБанковские = СчетаБанковскиеДляПереоценкиДС();
	СчетаБрокерские = Новый Массив;
	СчетаБрокерские.Добавить(ПланыСчетов.Хозрасчетный.РасчетыБрокера55);
	СчетаБрокерские.Добавить(ПланыСчетов.Хозрасчетный.РасчетыБрокера);
	
	Запрос.УстановитьПараметр("День", КонецДня(День));
	Запрос.УстановитьПараметр("МассивДоговоровДУ", МассивДоговоровДУ);
	Запрос.УстановитьПараметр("ВалютаРегл", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("СчетаБанковские", СчетаБанковские);
	Запрос.УстановитьПараметр("СчетаБрокерские", СчетаБрокерские);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДоговорДУ");
	
КонецФункции

// Описание: Пакетный отбор договоров с дефолтными событиями (логика ДефолтноеСобытиеЭмитента.СтатусыЭмитентовДоговораДУ).
//
// Параметры:
//  МассивДоговоровДУ - Массив из СправочникСсылка.ДоговорДУ
//  День - Дата
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ДоговорДУ
//
Функция ДоговорыСДефолтнымиСобытиямиОптимизированно(МассивДоговоровДУ, День)
	
	Если Не ЗначениеЗаполнено(МассивДоговоровДУ) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ДатаАнализа = КонецДня(День);
	ПараметрИсточникиПубликаций = ПланыВидовХарактеристик.ПараметрыДоговораДУ.ИсточникиПубликаций;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсточникиПоДоговорам.ДоговорДУ КАК ДоговорДУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗначенияПараметров.ДоговорДУ КАК ДоговорДУ,
	|		ИсточникиПубликаций.ИсточникПубликации КАК ИсточникПубликации
	|	ИЗ
	|		РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
	|				&ДатаАнализа,
	|				ДоговорДУ В (&МассивДоговоровДУ)
	|					И Параметр = &ПараметрИсточникиПубликаций) КАК ЗначенияПараметров
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УчетнаяПолитика.ИсточникиПубликаций КАК ИсточникиПубликаций
	|			ПО ЗначенияПараметров.Значение = ИсточникиПубликаций.Ссылка) КАК ИсточникиПоДоговорам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДефолтныеСобытияЭмитентов.СрезПоследних(КОНЕЦПЕРИОДА(&ДатаАнализа, ДЕНЬ), ) КАК ДефолтныеЭмитенты
	|		ПО ИсточникиПоДоговорам.ИсточникПубликации = ДефолтныеЭмитенты.ИсточникПубликации";
	
	Запрос.УстановитьПараметр("ДатаАнализа", ДатаАнализа);
	Запрос.УстановитьПараметр("МассивДоговоровДУ", МассивДоговоровДУ);
	Запрос.УстановитьПараметр("ПараметрИсточникиПубликаций", ПараметрИсточникиПубликаций);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДоговорДУ");
	
КонецФункции

// Описание: Пакетный отбор договоров для КонтрольУменьшенияСтоимостиПортфеля.
// Возвращает договоры, по которым нужен расчет
// (НЕ выполняется условие: ВводВывод = 0 И СЧА >= СЧАПредыдущий).
// Логика полностью соответствует РасчитатьУменьшенииеСтоимостиПортфеля / Операция_1020.
//
// Параметры:
//  МассивДоговоровДУ - Массив из СправочникСсылка.ДоговорДУ
//  День - Дата
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ДоговорДУ
//
Функция ДоговорыДляКонтроляУменьшенияПортфеляОптимизированно(МассивДоговоровДУ, День)
	
	Если Не ЗначениеЗаполнено(МассивДоговоровДУ) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ДоговораПодВопросом = Новый Массив;
	ТаблицаПериодов = ТаблицаПериодовКонтроляУменьшенияПортфеля(МассивДоговоровДУ, День, ДоговораПодВопросом);
	Если ТаблицаПериодов.Количество() = 0 Тогда
		Возврат ДоговораПодВопросом;
	КонецЕсли;
	
	КонецПериода = КонецДня(День);
	МинимальныйПредыдущийПериод = МинимальнаяДатаПредыдущегоПериода(ТаблицаПериодов);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПериодов.ДоговорДУ КАК ДоговорДУ,
	|	ТаблицаПериодов.ПредыдущийПериод КАК ПредыдущийПериод
	|ПОМЕСТИТЬ ВТ_Периоды
	|ИЗ
	|	&ТаблицаПериодов КАК ТаблицаПериодов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Периоды.ДоговорДУ КАК ДоговорДУ,
	|	ЕСТЬNULL(СЧАТек.СЧА, 0) КАК СЧА
	|ПОМЕСТИТЬ ВТ_СЧАТекущий
	|ИЗ
	|	ВТ_Периоды КАК Периоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрРСА_СЧА.СрезПоследних(&КонецПериода, ДоговорДУ В (ВЫБРАТЬ ДоговорДУ ИЗ ВТ_Периоды)) КАК СЧАТек
	|		ПО Периоды.ДоговорДУ = СЧАТек.ДоговорДУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Периоды.ДоговорДУ КАК ДоговорДУ,
	|	МАКСИМУМ(РегистрРСА.Период) КАК ПериодСреза
	|ПОМЕСТИТЬ ВТ_МаксПериодПред
	|ИЗ
	|	ВТ_Периоды КАК Периоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РегистрРСА_СЧА КАК РегистрРСА
	|		ПО Периоды.ДоговорДУ = РегистрРСА.ДоговорДУ
	|			И РегистрРСА.Период <= Периоды.ПредыдущийПериод
	|СГРУППИРОВАТЬ ПО
	|	Периоды.ДоговорДУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МаксПериод.ДоговорДУ КАК ДоговорДУ,
	|	ЕСТЬNULL(РегистрРСА.СЧА, 0) КАК СЧАПредыдущийПериод
	|ПОМЕСТИТЬ ВТ_СЧАПредыдущий
	|ИЗ
	|	ВТ_МаксПериодПред КАК МаксПериод
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрРСА_СЧА КАК РегистрРСА
	|		ПО МаксПериод.ДоговорДУ = РегистрРСА.ДоговорДУ
	|			И МаксПериод.ПериодСреза = РегистрРСА.Период
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Периоды.ДоговорДУ КАК ДоговорДУ,
	|	СУММА(ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(Обороты.Регистратор) = &ТипРегистраторВводВывод
	|				ТОГДА ЕСТЬNULL(Обороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтоимостьАктивов
	|ПОМЕСТИТЬ ВТ_СтоимостьАктивов
	|ИЗ
	|	ВТ_Периоды КАК Периоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьАктивовУправленческий.Обороты(
	|				&МинимальныйПредыдущийПериод,
	|				&КонецПериода,
	|				Регистратор,
	|				ДоговорДУ В (ВЫБРАТЬ ДоговорДУ ИЗ ВТ_Периоды)) КАК Обороты
	|		ПО Периоды.ДоговорДУ = Обороты.ДоговорДУ
	|			И Обороты.Период >= Периоды.ПредыдущийПериод
	|СГРУППИРОВАТЬ ПО
	|	Периоды.ДоговорДУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Периоды.ДоговорДУ КАК ДоговорДУ,
	|	СУММА(ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(Обороты.Регистратор) <> &ТипРегистраторВводВывод
	|				ТОГДА ЕСТЬNULL(Обороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ДенежныеСредства
	|ПОМЕСТИТЬ ВТ_ДенежныеСредства
	|ИЗ
	|	ВТ_Периоды КАК Периоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный.Обороты(
	|				&МинимальныйПредыдущийПериод,
	|				&КонецПериода,
	|				Регистратор,
	|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВводВыводАктивовВИзДУ),
	|				,
	|				ДоговорДУ В (ВЫБРАТЬ ДоговорДУ ИЗ ВТ_Периоды),
	|				,
	|				) КАК Обороты
	|		ПО Периоды.ДоговорДУ = Обороты.ДоговорДУ
	|			И Обороты.Период >= Периоды.ПредыдущийПериод
	|СГРУППИРОВАТЬ ПО
	|	Периоды.ДоговорДУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Периоды.ДоговорДУ КАК ДоговорДУ,
	|	ЕСТЬNULL(Стоимость.СтоимостьАктивов, 0) - ЕСТЬNULL(ДС.ДенежныеСредства, 0) КАК ВводВыводАктивовВИзДУ
	|ПОМЕСТИТЬ ВТ_ВводВывод
	|ИЗ
	|	ВТ_Периоды КАК Периоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтоимостьАктивов КАК Стоимость
	|		ПО Периоды.ДоговорДУ = Стоимость.ДоговорДУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДенежныеСредства КАК ДС
	|		ПО Периоды.ДоговорДУ = ДС.ДоговорДУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СЧАТек.ДоговорДУ КАК ДоговорДУ
	|ИЗ
	|	ВТ_СЧАТекущий КАК СЧАТек
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СЧАПредыдущий КАК СЧАПред
	|		ПО СЧАТек.ДоговорДУ = СЧАПред.ДоговорДУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВводВывод КАК ВводВывод
	|		ПО СЧАТек.ДоговорДУ = ВводВывод.ДоговорДУ
	|ГДЕ
	|	СЧАПред.СЧАПредыдущийПериод <> 0
	|	И (ВводВывод.ВводВыводАктивовВИзДУ <> 0
	|		ИЛИ СЧАТек.СЧА < СЧАПред.СЧАПредыдущийПериод)";
	
	Запрос.УстановитьПараметр("ТаблицаПериодов", ТаблицаПериодов);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("МинимальныйПредыдущийПериод", МинимальныйПредыдущийПериод);
	Запрос.УстановитьПараметр("ТипРегистраторВводВывод", Тип("ДокументСсылка.ВводВыводЦенныхБумагИзДУ"));
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДоговорДУ");
	Для Каждого ДоговорДУ Из ДоговораПодВопросом Цикл
		РезультатЗапроса.Добавить(ДоговорДУ);
	КонецЦикла;
	
	Возврат РезультатЗапроса;
	
КонецФункции

// Описание: Таблица договоров с границей предыдущего отчетного периода для пакетного запроса.
//
// Параметры:
//  МассивДоговоровДУ - Массив из СправочникСсылка.ДоговорДУ
//  День - Дата
//  ДоговораПодВопросом - Массив - список договоров с неопределенным предыдущим периодом (заполняется внутри)
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ДоговорДУ, ПредыдущийПериод
//
Функция ТаблицаПериодовКонтроляУменьшенияПортфеля(МассивДоговоровДУ, День, ДоговораПодВопросом)
	
	ТаблицаПериодов = Новый ТаблицаЗначений;
	ТаблицаПериодов.Колонки.Добавить("ДоговорДУ", Новый ОписаниеТипов("СправочникСсылка.ДоговорДУ"));
	ТаблицаПериодов.Колонки.Добавить("ПредыдущийПериод", Новый ОписаниеТипов("Дата"));
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПланыВидовХарактеристик.ПараметрыДоговораДУ.ПериодичностьОтчетаДУ);
	ПараметрыДоговоров = РегистрыСведений.ЗначенияПараметровДоговораДУ.ЗначенияПараметровДоговоровДУ(
		МассивДоговоровДУ, МассивПараметров, День);
	
	Для Каждого ДоговорДУ Из МассивДоговоровДУ Цикл
		
		ЗначенияПараметров = ПараметрыДоговоров.Получить(ДоговорДУ);
		ПериодичностьОтчетаДУ = Неопределено;
		Если ЗначенияПараметров <> Неопределено Тогда
			ПериодичностьОтчетаДУ = ЗначенияПараметров.Получить(
				ПланыВидовХарактеристик.ПараметрыДоговораДУ.ПериодичностьОтчетаДУ);
		КонецЕсли;
		
		ПредыдущийПериод = ПредыдущийПериодКонтроляУменьшенияПортфеляПоПериодичности(ПериодичностьОтчетаДУ, День);
		Если ПредыдущийПериод = Неопределено Тогда
			ДоговораПодВопросом.Добавить(ДоговорДУ);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПериодов.Добавить();
		НоваяСтрока.ДоговорДУ = ДоговорДУ;
		НоваяСтрока.ПредыдущийПериод = ПредыдущийПериод;
		
	КонецЦикла;
	
	Возврат ТаблицаПериодов;
	
КонецФункции

// Описание: Минимальная дата предыдущего периода по таблице договоров (нижняя граница оборотов).
//
// Параметры:
//  ТаблицаПериодов - ТаблицаЗначений
//
// Возвращаемое значение:
//  Дата
//
Функция МинимальнаяДатаПредыдущегоПериода(ТаблицаПериодов)
	
	МинимальнаяДата = Дата("39991231");
	
	Для Каждого СтрокаПериода Из ТаблицаПериодов Цикл
		
		Если СтрокаПериода.ПредыдущийПериод < МинимальнаяДата Тогда
			МинимальнаяДата = СтрокаПериода.ПредыдущийПериод;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МинимальнаяДата;
	
КонецФункции

// Описание: Счета банковских остатков для переоценки ДС (документ ПереоценкаДенежныхСредств, БУ).
//
// Возвращаемое значение:
//  Массив
//
Функция СчетаБанковскиеДляПереоценкиДС()
	
	СчетаБанковские = Новый Массив;
	СчетаБанковские.Добавить(ПланыСчетов.Хозрасчетный.ТранзитныеСчета);
	СчетаБанковские.Добавить(ПланыСчетов.Хозрасчетный.ТекущиеСчета);
	СчетаБанковские.Добавить(ПланыСчетов.Хозрасчетный.ДепозитныеСчетаВВалюте);
	
	Возврат СчетаБанковские;
	
КонецФункции

#КонецОбласти

#Область ОптимизацияЗапросовЭтап2

// IMDEV-8899 3.1
// Описание: Пакетно определяет договоры ДУ, для которых можно пропустить ветку РЕПО в ПереоценкаАктивов.ЗаполнитьТЧ.
// Критерий наличия РЕПО: остатки в регистре СтоимостьАктивовПоСделкамРЕПОУправленческий (ПерваяНога, Количество <> 0).
//
// Параметры:
//  МассивДоговоровДУ - Массив из СправочникСсылка.ДоговорДУ - договоры пачки вечернего расчета
//  ДатаПроведения - Дата - дата проведения вечерних операций (ДатаПроведения из пакетной подготовки)
//
// Возвращаемое значение:
//  Соответствие - ключ: ДоговорДУ, значение: Булево (ПропускРЕПОВетки; Истина = остатков РЕПО нет)
//
Функция ЗаполнитьСоответствиеПропускРЕПОВетки(МассивДоговоровДУ, ДатаПроведения) Экспорт
	
	СоответствиеПропускРЕПОВетки = Новый Соответствие;
	
	Если Не ЗначениеЗаполнено(МассивДоговоровДУ) Тогда
		Возврат СоответствиеПропускРЕПОВетки;
	КонецЕсли;
	
	// Как в Операция_0110: ДокументПереоценки.Дата = ПолучитьДатуСВременемОкончанияРабочегоДня(Дата, 5)
	// и в ЗаполнитьПараметрыСохраненияПакетнымиДаннымиВечернихОпераций: ДатаСЗаданнымиСекундами(ДатаПроведения, 5)
	ДатаДокументаПереоценки = ОбщегоНазначенияДУ.ДатаСЗаданнымиСекундами(ДатаПроведения, 5);
	
	Для Каждого ДоговорДУ Из МассивДоговоровДУ Цикл
		СоответствиеПропускРЕПОВетки.Вставить(ДоговорДУ, Истина);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиРЕПО.ДоговорДУ КАК ДоговорДУ
	|ИЗ
	|	РегистрНакопления.СтоимостьАктивовПоСделкамРЕПОУправленческий.Остатки(
	|			&Дата,
	|			ДоговорДУ В (&МассивДоговоровДУ)
	|				И СделкаРЕПО ССЫЛКА Документ.СделкаРЕПОПерваяНога) КАК ОстаткиРЕПО
	|ГДЕ
	|	ОстаткиРЕПО.КоличествоОстаток <> 0";
	
	Запрос.УстановитьПараметр("Дата", ДатаДокументаПереоценки);
	Запрос.УстановитьПараметр("МассивДоговоровДУ", МассивДоговоровДУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеПропускРЕПОВетки.Вставить(Выборка.ДоговорДУ, Ложь);
	КонецЦикла;
	
	Возврат СоответствиеПропускРЕПОВетки;
	
КонецФункции

#КонецОбласти

#КонецОбласти
