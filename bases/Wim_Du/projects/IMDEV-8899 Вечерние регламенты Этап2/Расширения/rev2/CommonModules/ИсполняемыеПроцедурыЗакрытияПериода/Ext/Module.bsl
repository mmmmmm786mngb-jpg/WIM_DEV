// IMDEV-8899 этап2 п.5+1: коллизия номера документа РасчетСЧА_РСА при параллельной записи
// IMDEV-8899 3.1: передача структуры пакетных данных в ЗаполнитьТЧ операции 0110

&ИзменениеИКонтроль("Операция_0110_ПереоценкаАктивов")
Процедура rev2_Операция_0110_ПереоценкаАктивов(ЗакрытиеПериода, Дата, ДоговорДУ, СписокОпераций, Отказ, ТекстОтказа, ДополнительныеДанные = Неопределено) Экспорт
	
	ДокументПереоценки = ПолучитьПодчиненныйДокумент("ПереоценкаАктивов", ЗакрытиеПериода);
	
	ДокументПереоценки.Дата 			   = ПолучитьДатуСВременемОкончанияРабочегоДня(Дата,5);
	ДокументПереоценки.ДоговорДУ 		   = ДоговорДУ;
	ДокументПереоценки.ДокументОснование   = ЗакрытиеПериода;
	ДокументПереоценки.Комментарий 		   = "Регламентная операция";	
	//	ДокументПереоценки.ПометкаУдаления = Ложь;	
	ДокументПереоценки.ВалютаДокумента = ОбщегоНазначенияДУ.ВалютаРеглУчета(ДоговорДУ);
	
	//Определеяем виды учета
	ДокументПереоценки.БУ = СписокОпераций.Найти(Справочники.ВидыОперацийЗакрытияПериода.Переоценка_БУ)<>Неопределено;
	ДокументПереоценки.УУ = СписокОпераций.Найти(Справочники.ВидыОперацийЗакрытияПериода.Переоценка_УУ)<>Неопределено;	
	ДокументПереоценки.НУ = СписокОпераций.Найти(Справочники.ВидыОперацийЗакрытияПериода.Переоценка_НУ)<>Неопределено;

	#Удаление
	// IMAPPS-35039++ Извлечь кэш из ДополнительныеДанные; при переданном кэше — ЗаполнитьТЧ(КэшКотировокУУ)
	КэшКотировокУУ = Неопределено;
	Если ТипЗнч(ДополнительныеДанные) = Тип("Структура") Тогда
		ДополнительныеДанные.Свойство("КэшКотировокУУ", КэшКотировокУУ);
	Иначе
		КэшКотировокУУ = ДополнительныеДанные;
	КонецЕсли;
	Если КэшКотировокУУ <> Неопределено Тогда
		ДокументПереоценки.ЗаполнитьТЧ(КэшКотировокУУ);
	Иначе
		ДокументПереоценки.ЗаполнитьТЧ();
	КонецЕсли;
	// IMAPPS-35039--
	#КонецУдаления
	#Вставка
	// IMAPPS-35039++ Пакетные данные для ЗаполнитьТЧ (кэш котировок и ПропускРЕПОВетки)
	// IMDEV-8899 3.1
	Если ДополнительныеДанные <> Неопределено Тогда
		ДокументПереоценки.ЗаполнитьТЧ(ДополнительныеДанные);
	Иначе
		ДокументПереоценки.ЗаполнитьТЧ();
	КонецЕсли;
	// IMAPPS-35039--
	#КонецВставки
	
	Если ДокументПереоценки.АктивыПереоценки.Количество() > 0 
		ИЛИ (ДокументПереоценки.УУ И ДокументПереоценки.АктивыПереоценкиРЕПО.Количество() > 0) 
		ИЛИ (ДокументПереоценки.НУ И ДокументПереоценки.АктивыПереоценкиИндексируемогоНоминала.Количество() > 0)Тогда
		Попытка
			ДокументПереоценки.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокументПереоценки.Записать(РежимЗаписиДокумента.Запись);
			Отказ = Истина;	
			ТекстОтказа = "Не удалось провести документ " + Строка(ДокументПереоценки);
		КонецПопытки;
	КонецЕсли; 
	
КонецПроцедуры

&ИзменениеИКонтроль("Операция_1000_РасчетРСА_СЧА")
Процедура rev2_Операция_1000_РасчетРСА_СЧА(ЗакрытиеПериода, Дата, ДоговорДУ, СписокОпераций, Отказ, ТекстОтказа) Экспорт
	
	//TM-733+
	ДокументРасчетСЧА_РСА = ПолучитьПодчиненныйДокумент("РасчетСЧА_РСА", ЗакрытиеПериода);
	
	ДокументРасчетСЧА_РСА.Дата 					= ПолучитьДатуСВременемОкончанияРабочегоДня(Дата,12);
	ДокументРасчетСЧА_РСА.ДоговорДУ 			= ДоговорДУ;
	ДокументРасчетСЧА_РСА.ДокументОснование 	= ЗакрытиеПериода;
	//ДокументРасчетСЧА_РСА.Комментарий 		= "Регламентная операция";
	
	//Определеяем виды учета
	ДокументРасчетСЧА_РСА.РСА = СписокОпераций.Найти(Справочники.ВидыОперацийЗакрытияПериода.РасчетРСА_БУ) <> Неопределено;
	ДокументРасчетСЧА_РСА.СЧА = СписокОпераций.Найти(Справочники.ВидыОперацийЗакрытияПериода.РасчетСЧА_БУ) <> Неопределено;
	
	ДокументРасчетСЧА_РСА.ПолучитьСуммыРСАСЧА(Отказ, ТекстОтказа);
	
	// TM-3363 {
	ИспользоватьТолькоАктуальныеКурсыВалют = ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьТолькоАктуальныеКурсыВалют");
	Если ИспользоватьТолькоАктуальныеКурсыВалют И Отказ Тогда
		#Удаление
		ДокументРасчетСЧА_РСА.Записать(РежимЗаписиДокумента.Запись);
		#КонецУдаления
		#Вставка
		// IMDEV-8899 этап2 п.5+1
		Документы.РасчетСЧА_РСА.ЗаписатьСОбработкойКоллизииНомера(ДокументРасчетСЧА_РСА, РежимЗаписиДокумента.Запись);
		#КонецВставки
		Возврат;
	КонецЕсли;
	// TM-3363 }
	
	#Удаление
	Попытка
		ДокументРасчетСЧА_РСА.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ДокументРасчетСЧА_РСА.Записать(РежимЗаписиДокумента.Запись);
		Отказ = Истина;
		ТекстОтказа = "Не удалось провести документ " + Строка(ДокументРасчетСЧА_РСА);
	КонецПопытки;
	#КонецУдаления
	#Вставка
	// IMDEV-8899 этап2 п.5+1
	Попытка
		Документы.РасчетСЧА_РСА.ЗаписатьСОбработкойКоллизииНомера(ДокументРасчетСЧА_РСА, РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибкиПроведения = ОписаниеОшибки();
		Документы.РасчетСЧА_РСА.ЗаписатьСОбработкойКоллизииНомера(ДокументРасчетСЧА_РСА, РежимЗаписиДокумента.Запись);
		Отказ = Истина;
		ТекстОтказа = "Не удалось провести документ " + Строка(ДокументРасчетСЧА_РСА) + ". " + ТекстОшибкиПроведения;
	КонецПопытки;
	#КонецВставки
	//TM-733+
	
КонецПроцедуры
