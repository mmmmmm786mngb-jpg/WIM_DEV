// IMDEV-8899 этап2 п.5+1
// Описание: Записывает документ с обработкой коллизии автонумерации при параллельной записи.
// Первая попытка — с текущим номером; при ошибке «не уникально» — УстановитьНовыйНомер() и повтор (до 30 раз).
//
// Параметры:// ДокументОбъект - ДокументОбъект.РасчетСЧА_РСА - объект документа для записи
// РежимЗаписи - РежимЗаписиДокумента - режим записи или проведения
//
Процедура ЗаписатьСОбработкойКоллизииНомера(ДокументОбъект, РежимЗаписи) Экспорт
	
	МаксПопытокЗаписи = 30;
	
	Для НомерПопытки = 1 По МаксПопытокЗаписи Цикл
		
		Попытка
			Если НомерПопытки > 1 Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			Возврат;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Если НомерПопытки < МаксПопытокЗаписи И СтрНайти(НРег(ТекстОшибки), "не уникально") > 0 Тогда
				Продолжить;
			Иначе
				ВызватьИсключение СтрШаблон(
					"Ошибка записи документа %1 (режим %2, попытка %3 из %4): %5",
					ДокументОбъект,
					РежимЗаписи,
					НомерПопытки,
					МаксПопытокЗаписи,
					ТекстОшибки);
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры
