// IMDEV-8899 3.1: пропуск тяжелой ветки АктивыПоРЕПОЗаполнить для розничных договоров без остатков РЕПО

&ИзменениеИКонтроль("ЗаполнитьТЧ")
Процедура rev2_ЗаполнитьТЧ(КэшКотировокУУ = Неопределено) Экспорт
	
	#Вставка
	// IMDEV-8899 3.1
	КэшДляКотировок = Неопределено;
	СоответствиеПропускРЕПОВетки = Неопределено;
	rev2_РазобратьПараметрыЗаполнитьТЧ(КэшКотировокУУ, КэшДляКотировок, СоответствиеПропускРЕПОВетки);
	#КонецВставки
	
	// IMAPPS-35039++ Передача кэша в АктивыЗаполнитьПоКотировкам при пакетном формировании вечерних операций
	#Удаление
	АктивыЗаполнитьПоКотировкам(КэшКотировокУУ);
	#КонецУдаления
	#Вставка
	АктивыЗаполнитьПоКотировкам(КэшДляКотировок);
	#КонецВставки
	// IMAPPS-35039--
	
	#Удаление
	АктивыПоРЕПОЗаполнить();
	#КонецУдаления
	#Вставка
	// IMDEV-8899 3.1
	Если rev2_ПропуститьЗаполнениеРЕПО(СоответствиеПропускРЕПОВетки) Тогда
		АктивыПереоценкиРЕПО.Очистить();
	Иначе
		АктивыПоРЕПОЗаполнить();
	КонецЕсли;
	#КонецВставки
	
	ОблигацииСИндексируемымНоминаломЗаполнить();

КонецПроцедуры

// IMDEV-8899 3.1
// Описание: Разбирает параметр ЗаполнитьТЧ: кэш котировок (соответствие) или структура пакетных данных.
//
// Параметры:
//  ПараметрыЗаполнитьТЧ - Произвольный - исходный параметр вызова ЗаполнитьТЧ
//  КэшДляКотировок - Произвольный - кэш котировок для АктивыЗаполнитьПоКотировкам (возврат)
//  СоответствиеПропускРЕПОВетки - Соответствие - признак пропуска ветки РЕПО по договорам (возврат)
//
Процедура rev2_РазобратьПараметрыЗаполнитьТЧ(ПараметрыЗаполнитьТЧ, КэшДляКотировок, СоответствиеПропускРЕПОВетки)
	
	Если ПараметрыЗаполнитьТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыЗаполнитьТЧ) = Тип("Структура") Тогда
		ПараметрыЗаполнитьТЧ.Свойство("КэшКотировокУУ", КэшДляКотировок);
		ПараметрыЗаполнитьТЧ.Свойство("СоответствиеПропускРЕПОВетки", СоответствиеПропускРЕПОВетки);
	Иначе
		КэшДляКотировок = ПараметрыЗаполнитьТЧ;
	КонецЕсли;
	
КонецПроцедуры

// IMDEV-8899 3.1
// Описание: Определяет, можно ли не вызывать АктивыПоРЕПОЗаполнить для текущего договора документа.
//
// Параметры:
//  СоответствиеПропускРЕПОВетки - Соответствие - пакетное соответствие ДоговорДУ -> ПропускРЕПОВетки
//
// Возвращаемое значение:
//  Булево - Истина, если ветку РЕПО можно пропустить
//
Функция rev2_ПропуститьЗаполнениеРЕПО(СоответствиеПропускРЕПОВетки)
	
	Если Не УУ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СоответствиеПропускРЕПОВетки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПропускРЕПОВетки = СоответствиеПропускРЕПОВетки.Получить(ДоговорДУ);
	Если ПропускРЕПОВетки <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаименованиеПула = rev2_НаименованиеПулаДоговораДУ(ДоговорДУ);
	
	Возврат НаименованиеПула = "Розничное ДУ";
	
КонецФункции

// IMDEV-8899 3.1
// Описание: Возвращает наименование пула договора ДУ без лишних обращений к БД при пустой ссылке.
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорДУ - договор ДУ
//
// Возвращаемое значение:
//  Строка - наименование пула или пустая строка
//
Функция rev2_НаименованиеПулаДоговораДУ(Договор)
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат "";
	КонецЕсли;
	
	Пул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Пул");
	Если Не ЗначениеЗаполнено(Пул) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пул, "Наименование");
	
КонецФункции
