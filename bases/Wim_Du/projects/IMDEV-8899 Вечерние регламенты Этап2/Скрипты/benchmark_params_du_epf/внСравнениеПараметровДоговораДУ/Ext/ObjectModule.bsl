////////////////////////////////////////////////////////////////////////////////
// Внешняя обработка: сравнение трех алгоритмов ЗначенияПараметровДоговораДУ
// 1) Текущий (КФ) - ПВХ + ЛЕВОЕ СОЕДИНЕНИЕ
// 2) Новый полный срез - СрезПоследних только по ДоговорДУ
// 3) Новый фильтр - СрезПоследних с Параметр В (&Параметры)
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описание: Выполняет сравнение корректности и замер времени трех алгоритмов
//
// Параметры:
//  ДатаСреза           - Дата - дата среза параметров
//  КоличествоДоговоров - Число - размер выборки (пул Розничное ДУ)
//  ВыполнятьПрогрев    - Булево - прогрев перед замером скорости
//
// Возвращаемое значение:
//  Структура - ТекстОтчета, ЕстьРасхождения, Статистика
//
Функция ВыполнитьСравнение(ДатаСреза, КоличествоДоговоров = 100, ВыполнятьПрогрев = Истина) Экспорт

    Результат = Новый Структура;
    Результат.Вставить("ЕстьРасхождения", Ложь);
    Результат.Вставить("ТекстОтчета", "");
    Результат.Вставить("Статистика", Новый Структура);

    Если Не ЗначениеЗаполнено(ДатаСреза) Тогда
        Результат.ТекстОтчета = "Не указана дата среза.";
        Возврат Результат;
    КонецЕсли;

    Если КоличествоДоговоров <= 0 Тогда
        КоличествоДоговоров = 100;
    КонецЕсли;

    МассивДоговоров = ПолучитьДоговорыРозничноеДУ(КоличествоДоговоров);
    Если МассивДоговоров.Количество() = 0 Тогда
        Результат.ТекстОтчета = "Не найдено договоров с пулом ""Розничное ДУ"".";
        Возврат Результат;
    КонецЕсли;

    НаборыПараметров = ПолучитьНаборыПараметровРегламента();
    КоличествоНаборов = НаборыПараметров.Количество();
    КоличествоВызовов = МассивДоговоров.Количество() * КоличествоНаборов;

    СтрокиОтчета = Новый Массив;
    СтрокиОтчета.Добавить("=== Сравнение алгоритмов ЗначенияПараметровДоговораДУ ===");
    СтрокиОтчета.Добавить("Дата среза: " + Формат(ДатаСреза, "ДЛФ=D"));
    СтрокиОтчета.Добавить("Договоров: " + Формат(МассивДоговоров.Количество(), "ЧГ=0")
        + ", наборов параметров: " + Формат(КоличествоНаборов, "ЧГ=0")
        + ", вызовов на алгоритм: " + Формат(КоличествоВызовов, "ЧГ=0"));
    СтрокиОтчета.Добавить("");

    // --- Корректность ---
    КоличествоРасхождений12 = 0;
    КоличествоРасхождений13 = 0;
    ДеталиРасхождений = Новый Массив;

    Для Каждого ДоговорДУ Из МассивДоговоров Цикл

        Для Каждого НаборПараметров Из НаборыПараметров Цикл

            МассивПараметров = НаборПараметров.Параметры;
            ИмяНабора = НаборПараметров.Имя;

            РезультатТекущий = ЗначенияПараметровДоговораДУ_Текущий(ДоговорДУ, МассивПараметров, ДатаСреза);
            РезультатПолныйСрез = ЗначенияПараметровДоговораДУ_НовыйПолныйСрез(ДоговорДУ, МассивПараметров, ДатаСреза);
            РезультатФильтр = ЗначенияПараметровДоговораДУ_НовыйФильтр(ДоговорДУ, МассивПараметров, ДатаСреза);

            Расхождения12 = СравнитьСоответствия(РезультатТекущий, РезультатПолныйСрез, МассивПараметров);
            Если Расхождения12.Количество() > 0 Тогда
                КоличествоРасхождений12 = КоличествоРасхождений12 + 1;
                ДеталиРасхождений.Добавить(СтрШаблон("%1 / %2: Текущий vs ПолныйСрез (%3)",
                    ДоговорДУ, ИмяНабора, Расхождения12.Количество()));
            КонецЕсли;

            Расхождения13 = СравнитьСоответствия(РезультатТекущий, РезультатФильтр, МассивПараметров);
            Если Расхождения13.Количество() > 0 Тогда
                КоличествоРасхождений13 = КоличествоРасхождений13 + 1;
                ДеталиРасхождений.Добавить(СтрШаблон("%1 / %2: Текущий vs Фильтр (%3)",
                    ДоговорДУ, ИмяНабора, Расхождения13.Количество()));
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    СтрокиОтчета.Добавить("--- Корректность ---");
    СтрокиОтчета.Добавить("Расхождений Текущий vs ПолныйСрез: " + Формат(КоличествоРасхождений12, "ЧГ=0"));
    СтрокиОтчета.Добавить("Расхождений Текущий vs Фильтр:      " + Формат(КоличествоРасхождений13, "ЧГ=0"));

    Если ДеталиРасхождений.Количество() > 0 Тогда
        СтрокиОтчета.Добавить("Детали (первые 20):");
        МаксимумДеталей = Мин(20, ДеталиРасхождений.Количество());
        Для Индекс = 0 По МаксимумДеталей - 1 Цикл
            СтрокиОтчета.Добавить("  " + ДеталиРасхождений[Индекс]);
        КонецЦикла;
    КонецЕсли;

    СтрокиОтчета.Добавить("");

    // --- Прогрев ---
    Если ВыполнятьПрогрев И МассивДоговоров.Количество() > 0 Тогда
        ДоговорПрогрев = МассивДоговоров[0];
        НаборПрогрев = НаборыПараметров[0].Параметры;
        ЗначенияПараметровДоговораДУ_Текущий(ДоговорПрогрев, НаборПрогрев, ДатаСреза);
        ЗначенияПараметровДоговораДУ_НовыйПолныйСрез(ДоговорПрогрев, НаборПрогрев, ДатаСреза);
        ЗначенияПараметровДоговораДУ_НовыйФильтр(ДоговорПрогрев, НаборПрогрев, ДатаСреза);
        СтрокиОтчета.Добавить("Прогрев: 1 договор, 1 набор");
        СтрокиОтчета.Добавить("");
    КонецЕсли;

    // --- Замер времени (отдельные проходы) ---
    ВремяТекущий = ЗамеритьАлгоритм("Текущий", МассивДоговоров, НаборыПараметров, ДатаСреза);
    ВремяПолныйСрез = ЗамеритьАлгоритм("ПолныйСрез", МассивДоговоров, НаборыПараметров, ДатаСреза);
    ВремяФильтр = ЗамеритьАлгоритм("Фильтр", МассивДоговоров, НаборыПараметров, ДатаСреза);

    СтрокиОтчета.Добавить("--- Скорость (мс) ---");
    СтрокиОтчета.Добавить(ФорматироватьСтрокуВремени("1. Текущий (КФ)", ВремяТекущий, КоличествоВызовов));
    СтрокиОтчета.Добавить(ФорматироватьСтрокуВремени("2. Новый полный срез (без фильтра)", ВремяПолныйСрез, КоличествоВызовов));
    СтрокиОтчета.Добавить(ФорматироватьСтрокуВремени("3. Новый с фильтром (реальный)", ВремяФильтр, КоличествоВызовов));
    СтрокиОтчета.Добавить("");

    Если ВремяТекущий > 0 Тогда
        СтрокиОтчета.Добавить("Относительно текущего:");
        СтрокиОтчета.Добавить("  ПолныйСрез: " + Формат((ВремяПолныйСрез / ВремяТекущий - 1) * 100, "ЧЦ=1; ЧДЦ=1") + " %");
        СтрокиОтчета.Добавить("  Фильтр:      " + Формат((ВремяФильтр / ВремяТекущий - 1) * 100, "ЧЦ=1; ЧДЦ=1") + " %");
    КонецЕсли;

    ЕстьРасхождения = КоличествоРасхождений12 > 0 Или КоличествоРасхождений13 > 0;
    Результат.ЕстьРасхождения = ЕстьРасхождения;
    Результат.ТекстОтчета = СтрСоединить(СтрокиОтчета, Символы.ПС);

    Статистика = Новый Структура;
    Статистика.Вставить("ВремяТекущийМс", ВремяТекущий);
    Статистика.Вставить("ВремяПолныйСрезМс", ВремяПолныйСрез);
    Статистика.Вставить("ВремяФильтрМс", ВремяФильтр);
    Статистика.Вставить("КоличествоВызовов", КоличествоВызовов);
    Статистика.Вставить("КоличествоДоговоров", МассивДоговоров.Количество());
    Результат.Статистика = Статистика;

    Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Текущий алгоритм из КФ (ПВХ + ЛЕВОЕ СОЕДИНЕНИЕ)
//
Функция ЗначенияПараметровДоговораДУ_Текущий(ДоговорДУ, Параметры, Знач Дата = '00010101')

    ЗначенияПараметров = Новый Соответствие;
    МассивПараметров = НормализоватьМассивПараметров(Параметры);
    Если МассивПараметров = Неопределено Тогда
        Возврат ЗначенияПараметров;
    КонецЕсли;

    Дата = НормализоватьДату(Дата);

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
    Запрос.УстановитьПараметр("Параметры", МассивПараметров);

    Запрос.Текст =
    "ВЫБРАТЬ
    |   ПараметрыДоговораДУ.Ссылка
    |ПОМЕСТИТЬ Параметры
    |ИЗ
    |   ПланВидовХарактеристик.ПараметрыДоговораДУ КАК ПараметрыДоговораДУ
    |ГДЕ
    |   ПараметрыДоговораДУ.Ссылка В(&Параметры)
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   Параметры.Ссылка КАК Параметр,
    |   ЕСТЬNULL(ПараметрыДУ.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
    |ИЗ
    |   Параметры КАК Параметры
    |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
    |               &Дата,
    |               ДоговорДУ = &ДоговорДУ
    |                   И Параметр В (&Параметры)) КАК ПараметрыДУ
    |   ПО Параметры.Ссылка = ПараметрыДУ.Параметр";

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ЗначенияПараметров.Вставить(Выборка.Параметр, Выборка.Значение);
    КонецЦикла;

    Возврат ЗначенияПараметров;

КонецФункции

// Описание: Новый алгоритм - полный срез по договору без фильтра параметров
//
Функция ЗначенияПараметровДоговораДУ_НовыйПолныйСрез(ДоговорДУ, Параметры, Знач Дата = '00010101')

    ЗначенияПараметров = Новый Соответствие;
    МассивПараметров = НормализоватьМассивПараметров(Параметры);
    Если МассивПараметров = Неопределено Тогда
        Возврат ЗначенияПараметров;
    КонецЕсли;

    Дата = НормализоватьДату(Дата);

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Срез.Параметр КАК Параметр,
    |   Срез.Значение КАК Значение
    |ИЗ
    |   РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
    |       &Дата,
    |       ДоговорДУ = &ДоговорДУ) КАК Срез";

    Выборка = Запрос.Выполнить().Выбрать();

    СоответствиеВсехЗначений = Новый Соответствие;
    Пока Выборка.Следующий() Цикл
        СоответствиеВсехЗначений.Вставить(Выборка.Параметр, Выборка.Значение);
    КонецЦикла;

    Для Каждого Параметр Из МассивПараметров Цикл
        ЗначенияПараметров.Вставить(Параметр, СоответствиеВсехЗначений.Получить(Параметр));
    КонецЦикла;

    Возврат ЗначенияПараметров;

КонецФункции

// Описание: Новый алгоритм - срез с фильтром Параметр В (&Параметры)
//
Функция ЗначенияПараметровДоговораДУ_НовыйФильтр(ДоговорДУ, Параметры, Знач Дата = '00010101')

    ЗначенияПараметров = Новый Соответствие;
    МассивПараметров = НормализоватьМассивПараметров(Параметры);
    Если МассивПараметров = Неопределено Тогда
        Возврат ЗначенияПараметров;
    КонецЕсли;

    Дата = НормализоватьДату(Дата);

    Для Каждого Параметр Из МассивПараметров Цикл
        ЗначенияПараметров.Вставить(Параметр, Неопределено);
    КонецЦикла;

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
    Запрос.УстановитьПараметр("Параметры", МассивПараметров);

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Срез.Параметр КАК Параметр,
    |   Срез.Значение КАК Значение
    |ИЗ
    |   РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
    |       &Дата,
    |       ДоговорДУ = &ДоговорДУ
    |           И Параметр В (&Параметры)) КАК Срез";

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ЗначенияПараметров.Вставить(Выборка.Параметр, Выборка.Значение);
    КонецЦикла;

    Возврат ЗначенияПараметров;

КонецФункции

// Описание: Наборы параметров из документа ПереоценкаАктивов (0110)
//
Функция ПолучитьНаборыПараметровРегламента()

    ПВХ = ПланыВидовХарактеристик.ПараметрыДоговораДУ;
    Наборы = Новый Массив;

    НаборКотировки = Новый Структура("Имя, Параметры", "0110_Kotirovki", Новый Массив);
    НаборКотировки.Параметры.Добавить(ПВХ.БанкротствоТелоСписать_УУ);
    НаборКотировки.Параметры.Добавить(ПВХ.ПравилаОкругленияКотировок);
    НаборКотировки.Параметры.Добавить(ПВХ.ИспользоватьТолькоБиржевыеКотировкиВПереоценке);
    НаборКотировки.Параметры.Добавить(ПВХ.ПереоценкаВалютныхЦБОтдельноПоКурсуИКотировке);
    НаборКотировки.Параметры.Добавить(ПВХ.ПравилоОпределенияКотировокУУ);
    НаборКотировки.Параметры.Добавить(ПВХ.ОсобенныйУчет);
    НаборКотировки.Параметры.Добавить(ПВХ.ИсключаемыеАктивы);
    Наборы.Добавить(НаборКотировки);

    НаборРЕПО = Новый Структура("Имя, Параметры", "0110_REPO", Новый Массив);
    НаборРЕПО.Параметры.Добавить(ПВХ.БанкротствоТелоСписать_УУ);
    НаборРЕПО.Параметры.Добавить(ПВХ.ПравилаОкругленияКотировок);
    НаборРЕПО.Параметры.Добавить(ПВХ.ПравилоОпределенияКотировокУУ);
    НаборРЕПО.Параметры.Добавить(ПВХ.ВариантОценкиСделокРЕПО);
    НаборРЕПО.Параметры.Добавить(ПВХ.НеПереоцениватьНКДВОбратномРЕПО);
    НаборРЕПО.Параметры.Добавить(ПВХ.ОсобенныйУчет);
    НаборРЕПО.Параметры.Добавить(ПВХ.ИсключаемыеАктивы);
    Наборы.Добавить(НаборРЕПО);

    НаборПроведение = Новый Структура("Имя, Параметры", "0110_Provedenie", Новый Массив);
    НаборПроведение.Параметры.Добавить(ПВХ.МетодСписанияПоПартиям);
    НаборПроведение.Параметры.Добавить(ПВХ.ПартионныйУчетПереоценки);
    НаборПроведение.Параметры.Добавить(ПВХ.ПравилаОкругленияКотировок);
    НаборПроведение.Параметры.Добавить(ПВХ.КорректироватьПереоценкуПартииНаСуммуПогрОкр);
    НаборПроведение.Параметры.Добавить(ПВХ.УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ);
    НаборПроведение.Параметры.Добавить(ПВХ.ПереоценкаВалютныхЦБОтдельноПоКурсуИКотировке);
    НаборПроведение.Параметры.Добавить(ПВХ.НеПереоцениватьПартииПозжеДатыБиржевойКотировки);
    НаборПроведение.Параметры.Добавить(ПВХ.ИспользоватьТолькоБиржевыеКотировкиВПереоценке);
    НаборПроведение.Параметры.Добавить(ПВХ.ВариантОценкиСделокРЕПО);
    НаборПроведение.Параметры.Добавить(ПВХ.НеПереоцениватьНКДВОбратномРЕПО);
    Наборы.Добавить(НаборПроведение);

    НаборРезервы = Новый Структура("Имя, Параметры", "0400_Rezervy", Новый Массив);
    НаборРезервы.Параметры.Добавить(ПВХ.АлгоритмРасчетаРезервов);
    Наборы.Добавить(НаборРезервы);

    Возврат Наборы;

КонецФункции

// Описание: Первые N договоров пула Розничное ДУ
//
Функция ПолучитьДоговорыРозничноеДУ(КоличествоДоговоров)

    КоличествоВыборки = Цел(КоличествоДоговоров);
    Если КоличествоВыборки <= 0 Тогда
        КоличествоВыборки = 100;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст = СтрШаблон(
    "ВЫБРАТЬ ПЕРВЫЕ %1
    |   ДоговорДУ.Ссылка КАК ДоговорДУ
    |ИЗ
    |   Справочник.ДоговорДУ КАК ДоговорДУ
    |ГДЕ
    |   НЕ ДоговорДУ.ПометкаУдаления
    |   И ДоговорДУ.Пул.Наименование = &НаименованиеПула
    |УПОРЯДОЧИТЬ ПО
    |   ДоговорДУ.Код",
    Формат(КоличествоВыборки, "ЧГ=0"));

    Запрос.УстановитьПараметр("НаименованиеПула", "Розничное ДУ");

    Результат = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Результат.Добавить(Выборка.ДоговорДУ);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция НормализоватьМассивПараметров(Параметры)

    Если Параметры = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если ТипЗнч(Параметры) <> Тип("Массив") Тогда
        МассивПараметров = Новый Массив;
        МассивПараметров.Добавить(Параметры);
        Возврат МассивПараметров;
    КонецЕсли;

    Возврат Параметры;

КонецФункции

Функция НормализоватьДату(Дата)

    Если Дата = '00010101' Тогда
        Возврат ТекущаяДата();
    КонецЕсли;

    Возврат Дата;

КонецФункции

// Описание: Сравнивает два соответствия по списку параметров
//
Функция СравнитьСоответствия(Соответствие1, Соответствие2, МассивПараметров)

    Расхождения = Новый Массив;

    Для Каждого Параметр Из МассивПараметров Цикл

        Значение1 = Соответствие1.Получить(Параметр);
        Значение2 = Соответствие2.Получить(Параметр);

        Если Не ЗначенияПараметраРавны(Значение1, Значение2) Тогда
            Расхождения.Добавить(Параметр);
        КонецЕсли;

    КонецЦикла;

    Возврат Расхождения;

КонецФункции

Функция ЗначенияПараметраРавны(Значение1, Значение2)

    Если Значение1 = Неопределено И Значение2 = Неопределено Тогда
        Возврат Истина;
    КонецЕсли;

    Если ТипЗнч(Значение1) <> ТипЗнч(Значение2) Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат Значение1 = Значение2;

КонецФункции

Функция ЗамеритьАлгоритм(ИмяАлгоритма, МассивДоговоров, НаборыПараметров, ДатаСреза)

    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

    Для Каждого ДоговорДУ Из МассивДоговоров Цикл

        Для Каждого НаборПараметров Из НаборыПараметров Цикл

            МассивПараметров = НаборПараметров.Параметры;

            Если ИмяАлгоритма = "Текущий" Тогда
                ЗначенияПараметровДоговораДУ_Текущий(ДоговорДУ, МассивПараметров, ДатаСреза);
            ИначеЕсли ИмяАлгоритма = "ПолныйСрез" Тогда
                ЗначенияПараметровДоговораДУ_НовыйПолныйСрез(ДоговорДУ, МассивПараметров, ДатаСреза);
            Иначе
                ЗначенияПараметровДоговораДУ_НовыйФильтр(ДоговорДУ, МассивПараметров, ДатаСреза);
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

КонецФункции

Функция ФорматироватьСтрокуВремени(Заголовок, ВремяМс, КоличествоВызовов)

    СреднееМс = ?(КоличествоВызовов > 0, ВремяМс / КоличествоВызовов, 0);
    Возврат СтрШаблон("%1: всего %2 мс, среднее %3 мс/вызов",
        Заголовок,
        Формат(ВремяМс, "ЧГ=0"),
        Формат(СреднееМс, "ЧЦ=2; ЧДЦ=2"));

КонецФункции

#КонецОбласти
