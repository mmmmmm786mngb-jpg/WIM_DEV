////////////////////////////////////////////////////////////////////////////////
// Внешняя обработка: сравнение трех алгоритмов ЗначенияПараметровДоговораДУ
//
// Назначение:
//   Бенчмарк для задачи IMDEV-8899 (п. 3.2) - выбор оптимального варианта
//   получения параметров договора ДУ из РС.ЗначенияПараметровДоговораДУ.
//
// Сравниваемые алгоритмы:
//   1) Текущий (КФ) - ПВХ ПОМЕСТИТЬ + ЛЕВОЕ СОЕДИНЕНИЕ со срезом
//   2) Новый полный срез - СрезПоследних только по ДоговорДУ (все параметры)
//   3) Новый с фильтром - СрезПоследних с условием Параметр В (&Параметры)
//
// Логирование: во всех вариантах как в КФ (ОбщегоНазначенияДУ.ДобавитьВЛогОтладки).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описание: Выполняет сравнение корректности и замер времени трех алгоритмов
//
// Параметры:
//  ДатаСреза           - Дата - дата среза параметров
//  КоличествоДоговоров - Число - размер выборки договоров пула "Розничное ДУ"
//  ВыполнятьПрогрев    - Булево - выполнить один прогревочный вызов перед замером
//
// Возвращаемое значение:
//  Структура:
//    * ТекстОтчета      - Строка - текстовый отчет для формы
//    * ЕстьРасхождения  - Булево - Истина, если новые алгоритмы отличаются от текущего
//    * Статистика       - Структура - числовые итоги замера (мс, количество вызовов)
//
Функция ВыполнитьСравнение(ДатаСреза, КоличествоДоговоров = 100, ВыполнятьПрогрев = Истина) Экспорт

    Результат = Новый Структура;
    Результат.Вставить("ЕстьРасхождения", Ложь);
    Результат.Вставить("ТекстОтчета", "");
    Результат.Вставить("ТекстСообщения", "");
    Результат.Вставить("Статистика", Новый Структура);

    Если Не ЗначениеЗаполнено(ДатаСреза) Тогда
        Результат.ТекстОтчета = "Не указана дата среза.";
        Возврат Результат;
    КонецЕсли;

    Если КоличествоДоговоров <= 0 Тогда
        КоличествоДоговоров = 100;
    КонецЕсли;

    МассивДоговоров = ПолучитьДоговорыРозничноеДУ(КоличествоДоговоров);
    Если МассивДоговоров.Количество() = 0 Тогда
        Результат.ТекстОтчета = "Не найдено договоров с пулом ""Розничное ДУ"".";
        Возврат Результат;
    КонецЕсли;

    // Наборы параметров имитируют реальные вызовы вечернего регламента (0110, 0400)
    НаборыПараметров = ПолучитьНаборыПараметровРегламента();
    КоличествоНаборов = НаборыПараметров.Количество();
    КоличествоВызовов = МассивДоговоров.Количество() * КоличествоНаборов;

    СтрокиОтчета = Новый Массив;
    СтрокиОтчета.Добавить("=== Сравнение алгоритмов ЗначенияПараметровДоговораДУ ===");
    СтрокиОтчета.Добавить("Дата среза: " + Формат(ДатаСреза, "ДЛФ=D"));
    СтрокиОтчета.Добавить("Договоров: " + ФорматЧислаДляОтчета(МассивДоговоров.Количество())
        + ", наборов параметров: " + ФорматЧислаДляОтчета(КоличествоНаборов)
        + ", вызовов на алгоритм: " + ФорматЧислаДляОтчета(КоличествоВызовов));
    СтрокиОтчета.Добавить("");

    // Этап 1: проверка эквивалентности результатов (эталон - текущий алгоритм КФ)
    КоличествоРасхождений12 = 0;
    КоличествоРасхождений13 = 0;
    ДеталиРасхождений = Новый Массив;

    Для Каждого ДоговорДУ Из МассивДоговоров Цикл

        Для Каждого НаборПараметров Из НаборыПараметров Цикл

            МассивПараметров = НаборПараметров.Параметры;
            ИмяНабора = НаборПараметров.Имя;

            РезультатТекущий = ЗначенияПараметровДоговораДУ_Текущий(ДоговорДУ, МассивПараметров, ДатаСреза);
            РезультатПолныйСрез = ЗначенияПараметровДоговораДУ_НовыйПолныйСрез(ДоговорДУ, МассивПараметров, ДатаСреза);
            РезультатФильтр = ЗначенияПараметровДоговораДУ_НовыйФильтр(ДоговорДУ, МассивПараметров, ДатаСреза);

            Расхождения12 = СравнитьСоответствия(РезультатТекущий, РезультатПолныйСрез, МассивПараметров);
            Если Расхождения12.Количество() > 0 Тогда
                КоличествоРасхождений12 = КоличествоРасхождений12 + 1;
                ДеталиРасхождений.Добавить(СтрШаблон("%1 / %2: Текущий vs ПолныйСрез (%3 шт.)",
                    ДоговорДУ, ИмяНабора, ФорматЧислаДляОтчета(Расхождения12.Количество())));
            КонецЕсли;

            Расхождения13 = СравнитьСоответствия(РезультатТекущий, РезультатФильтр, МассивПараметров);
            Если Расхождения13.Количество() > 0 Тогда
                КоличествоРасхождений13 = КоличествоРасхождений13 + 1;
                ДеталиРасхождений.Добавить(СтрШаблон("%1 / %2: Текущий vs Фильтр (%3 шт.)",
                    ДоговорДУ, ИмяНабора, ФорматЧислаДляОтчета(Расхождения13.Количество())));
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    ВсегоСравнений = КоличествоВызовов;
    СтрокиОтчета.Добавить("--- Корректность ---");
    СтрокиОтчета.Добавить("Проверено пар договор/набор: " + ФорматЧислаДляОтчета(ВсегоСравнений));
    СтрокиОтчета.Добавить("Расхождений Текущий vs ПолныйСрез: " + ФорматЧислаДляОтчета(КоличествоРасхождений12));
    СтрокиОтчета.Добавить("Расхождений Текущий vs Фильтр:      " + ФорматЧислаДляОтчета(КоличествоРасхождений13));

    Если ДеталиРасхождений.Количество() > 0 Тогда
        СтрокиОтчета.Добавить("Детали (первые 20):");
        МаксимумДеталей = Мин(20, ДеталиРасхождений.Количество());
        Для Индекс = 0 По МаксимумДеталей - 1 Цикл
            СтрокиОтчета.Добавить("  " + ДеталиРасхождений[Индекс]);
        КонецЦикла;
    КонецЕсли;

    СтрокиОтчета.Добавить("");

    // Этап 2: прогрев кэша СУБД/платформы (не входит в статистику)
    Если ВыполнятьПрогрев И МассивДоговоров.Количество() > 0 Тогда
        ДоговорПрогрев = МассивДоговоров[0];
        НаборПрогрев = НаборыПараметров[0].Параметры;
        ЗначенияПараметровДоговораДУ_Текущий(ДоговорПрогрев, НаборПрогрев, ДатаСреза);
        ЗначенияПараметровДоговораДУ_НовыйПолныйСрез(ДоговорПрогрев, НаборПрогрев, ДатаСреза);
        ЗначенияПараметровДоговораДУ_НовыйФильтр(ДоговорПрогрев, НаборПрогрев, ДатаСреза);
        СтрокиОтчета.Добавить("Прогрев: 1 договор, 1 набор");
        СтрокиОтчета.Добавить("");
    КонецЕсли;

    // Этап 3: замер времени - три отдельных прохода, чтобы не смешивать кэш алгоритмов
    ВремяТекущий = ЗамеритьАлгоритм("Текущий", МассивДоговоров, НаборыПараметров, ДатаСреза);
    ВремяПолныйСрез = ЗамеритьАлгоритм("ПолныйСрез", МассивДоговоров, НаборыПараметров, ДатаСреза);
    ВремяФильтр = ЗамеритьАлгоритм("Фильтр", МассивДоговоров, НаборыПараметров, ДатаСреза);

    СтрокиОтчета.Добавить("--- Скорость (мс) ---");
    СтрокиОтчета.Добавить(ФорматироватьСтрокуВремени("1. Текущий (КФ)", ВремяТекущий, КоличествоВызовов));
    СтрокиОтчета.Добавить(ФорматироватьСтрокуВремени("2. Новый полный срез (без фильтра)", ВремяПолныйСрез, КоличествоВызовов));
    СтрокиОтчета.Добавить(ФорматироватьСтрокуВремени("3. Новый с фильтром (реальный)", ВремяФильтр, КоличествоВызовов));
    СтрокиОтчета.Добавить("");

    Если ВремяТекущий > 0 Тогда
        СтрокиОтчета.Добавить("Относительно текущего:");
        ПроцентПолныйСрез = (ВремяПолныйСрез / ВремяТекущий - 1) * 100;
        ПроцентФильтр = (ВремяФильтр / ВремяТекущий - 1) * 100;
        СтрокиОтчета.Добавить("  ПолныйСрез: " + ФорматПроцентаДляОтчета(ПроцентПолныйСрез));
        СтрокиОтчета.Добавить("  Фильтр:      " + ФорматПроцентаДляОтчета(ПроцентФильтр));
    КонецЕсли;

    СтрокиОтчета.Добавить("");
    СтрокиОтчета.Добавить("--- Итог ---");
    СтрокиОтчета.Добавить(СформироватьТекстИтога(КоличествоРасхождений12, КоличествоРасхождений13,
        ВремяТекущий, ВремяПолныйСрез, ВремяФильтр));

    ЕстьРасхождения = КоличествоРасхождений12 > 0 Или КоличествоРасхождений13 > 0;
    Результат.ЕстьРасхождения = ЕстьРасхождения;
    Результат.Вставить("ТекстСообщения", СформироватьТекстИтога(КоличествоРасхождений12, КоличествоРасхождений13,
        ВремяТекущий, ВремяПолныйСрез, ВремяФильтр));
    Результат.ТекстОтчета = СтрСоединить(СтрокиОтчета, Символы.ПС);

    Статистика = Новый Структура;
    Статистика.Вставить("ВремяТекущийМс", ВремяТекущий);
    Статистика.Вставить("ВремяПолныйСрезМс", ВремяПолныйСрез);
    Статистика.Вставить("ВремяФильтрМс", ВремяФильтр);
    Статистика.Вставить("КоличествоВызовов", КоличествоВызовов);
    Статистика.Вставить("КоличествоДоговоров", МассивДоговоров.Количество());
    Результат.Статистика = Статистика;

    Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Текущий алгоритм из КФ - копия РС.ЗначенияПараметровДоговораДУ
// Дополнительно: временная таблица из ПВХ + ЛЕВОЕ СОЕДИНЕНИЕ для отсутствующих значений
//
// Параметры:
//  ДоговорДУ - СправочникСсылка.ДоговорДУ
//  Параметры - Массив, ПланВидовХарактеристикСсылка.ПараметрыДоговораДУ
//  Дата      - Дата - дата среза
//
// Возвращаемое значение:
//  Соответствие - Параметр -> Значение
//
Функция ЗначенияПараметровДоговораДУ_Текущий(ДоговорДУ, Параметры, Знач Дата = '00010101')

    ЗначенияПараметров = Новый Соответствие;
    МассивПараметров = НормализоватьМассивПараметров(Параметры);
    Если МассивПараметров = Неопределено Тогда
        Возврат ЗначенияПараметров;
    КонецЕсли;

    Дата = НормализоватьДату(Дата);

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
    Запрос.УстановитьПараметр("Параметры", МассивПараметров);

    Запрос.Текст =
    "ВЫБРАТЬ
    |   ПараметрыДоговораДУ.Ссылка
    |ПОМЕСТИТЬ Параметры
    |ИЗ
    |   ПланВидовХарактеристик.ПараметрыДоговораДУ КАК ПараметрыДоговораДУ
    |ГДЕ
    |   ПараметрыДоговораДУ.Ссылка В(&Параметры)
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   Параметры.Ссылка КАК Параметр,
    |   ЕСТЬNULL(ПараметрыДУ.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
    |ИЗ
    |   Параметры КАК Параметры
    |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
    |               &Дата,
    |               ДоговорДУ = &ДоговорДУ
    |                   И Параметр В (&Параметры)) КАК ПараметрыДУ
    |   ПО Параметры.Ссылка = ПараметрыДУ.Параметр";

    ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос,
        "РегистрСведений.ЗначенияПараметровДоговоровДУ.МодульМенеджера:ЗначенияПараметровДоговораДУ");

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ЗначенияПараметров.Вставить(Выборка.Параметр, Выборка.Значение);
    КонецЦикла;

    Возврат ЗначенияПараметров;

КонецФункции

// Описание: Вариант из txt - читает все параметры договора, отбор в BSL
// Риск: больше данных из БД, чем в текущем алгоритме (сотни параметров УП)
//
// Параметры:
//  ДоговорДУ - СправочникСсылка.ДоговорДУ
//  Параметры - Массив, ПланВидовХарактеристикСсылка.ПараметрыДоговораДУ
//  Дата      - Дата - дата среза
//
// Возвращаемое значение:
//  Соответствие - Параметр -> Значение (Неопределено, если нет в регистре)
//
Функция ЗначенияПараметровДоговораДУ_НовыйПолныйСрез(ДоговорДУ, Параметры, Знач Дата = '00010101')

    ЗначенияПараметров = Новый Соответствие;
    МассивПараметров = НормализоватьМассивПараметров(Параметры);
    Если МассивПараметров = Неопределено Тогда
        Возврат ЗначенияПараметров;
    КонецЕсли;

    Дата = НормализоватьДату(Дата);

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Срез.Параметр КАК Параметр,
    |   Срез.Значение КАК Значение
    |ИЗ
    |   РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
    |       &Дата,
    |       ДоговорДУ = &ДоговорДУ) КАК Срез";

    ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос,
        "РегистрСведений.ЗначенияПараметровДоговоровДУ.МодульМенеджера:ЗначенияПараметровДоговораДУ");

    Выборка = Запрос.Выполнить().Выбрать();

    СоответствиеВсехЗначений = Новый Соответствие;
    Пока Выборка.Следующий() Цикл
        СоответствиеВсехЗначений.Вставить(Выборка.Параметр, Выборка.Значение);
    КонецЦикла;

    Для Каждого Параметр Из МассивПараметров Цикл
        ЗначенияПараметров.Вставить(Параметр, СоответствиеВсехЗначений.Получить(Параметр));
    КонецЦикла;

    Возврат ЗначенияПараметров;

КонецФункции

// Описание: Рекомендуемый вариант - один пакет запроса, фильтр в срезе, отсутствующие в BSL
//
// Параметры:
//  ДоговорДУ - СправочникСсылка.ДоговорДУ
//  Параметры - Массив, ПланВидовХарактеристикСсылка.ПараметрыДоговораДУ
//  Дата      - Дата - дата среза
//
// Возвращаемое значение:
//  Соответствие - Параметр -> Значение (Неопределено, если нет в регистре)
//
Функция ЗначенияПараметровДоговораДУ_НовыйФильтр(ДоговорДУ, Параметры, Знач Дата = '00010101')

    ЗначенияПараметров = Новый Соответствие;
    МассивПараметров = НормализоватьМассивПараметров(Параметры);
    Если МассивПараметров = Неопределено Тогда
        Возврат ЗначенияПараметров;
    КонецЕсли;

    Дата = НормализоватьДату(Дата);

    // Предзаполнение гарантирует наличие всех запрошенных ключей (как LEFT JOIN в текущем)
    Для Каждого Параметр Из МассивПараметров Цикл
        ЗначенияПараметров.Вставить(Параметр, Неопределено);
    КонецЦикла;

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
    Запрос.УстановитьПараметр("Параметры", МассивПараметров);

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Срез.Параметр КАК Параметр,
    |   Срез.Значение КАК Значение
    |ИЗ
    |   РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
    |       &Дата,
    |       ДоговорДУ = &ДоговорДУ
    |           И Параметр В (&Параметры)) КАК Срез";

    ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос,
        "РегистрСведений.ЗначенияПараметровДоговоровДУ.МодульМенеджера:ЗначенияПараметровДоговораДУ");

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ЗначенияПараметров.Вставить(Выборка.Параметр, Выборка.Значение);
    КонецЦикла;

    Возврат ЗначенияПараметров;

КонецФункции

// Описание: Формирует наборы параметров по вызовам вечернего регламента
// Источник: Documents/ПереоценкаАктивов (0110) и Операция_0400
//
// Возвращаемое значение:
//  Массив из Структура(Имя, Параметры) - 4 набора
//
Функция ПолучитьНаборыПараметровРегламента()

    ПВХ = ПланыВидовХарактеристик.ПараметрыДоговораДУ;
    Наборы = Новый Массив;

    // АктивыЗаполнитьПоКотировкам - 7 параметров
    НаборКотировки = Новый Структура("Имя, Параметры", "0110_Kotirovki", Новый Массив);
    НаборКотировки.Параметры.Добавить(ПВХ.БанкротствоТелоСписать_УУ);
