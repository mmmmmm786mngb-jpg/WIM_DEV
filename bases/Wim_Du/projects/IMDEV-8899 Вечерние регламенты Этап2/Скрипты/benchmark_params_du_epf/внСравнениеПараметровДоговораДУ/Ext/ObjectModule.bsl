// Описание: Возвращает первые N договоров пула "Розничное ДУ"
//
// Параметры:
//  КоличествоДоговоров - Число - лимит выборки
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ДоговорДУ
//
// Примечание: в языке запросов ПЕРВЫЕ N требует константу, поэтому N подставляется через СтрШаблон
//
Функция ПолучитьДоговорыРозничноеДУ(КоличествоДоговоров)

    КоличествоВыборки = Цел(КоличествоДоговоров);
    Если КоличествоВыборки <= 0 Тогда
        КоличествоВыборки = 100;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст = СтрШаблон(
    "ВЫБРАТЬ ПЕРВЫЕ %1
    |   ДоговорДУ.Ссылка КАК ДоговорДУ
    |ИЗ
    |   Справочник.ДоговорДУ КАК ДоговорДУ
    |ГДЕ
    |   НЕ ДоговорДУ.ПометкаУдаления
    |   И ДоговорДУ.Пул.Наименование = &НаименованиеПула
    |УПОРЯДОЧИТЬ ПО
    |   ДоговорДУ.Код",
    Формат(КоличествоВыборки, "ЧГ=0"));

    Запрос.УстановитьПараметр("НаименованиеПула", "Розничное ДУ");

    Результат = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Результат.Добавить(Выборка.ДоговорДУ);
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Описание: Приводит параметр к массиву (как в менеджере РС КФ)
//
// Параметры:
//  Параметры - Массив, ПланВидовХарактеристикСсылка.ПараметрыДоговораДУ, Неопределено
//
// Возвращаемое значение:
//  Массив - нормализованный список; Неопределено, если вход Неопределено
//
Функция НормализоватьМассивПараметров(Параметры)

    Если Параметры = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если ТипЗнч(Параметры) <> Тип("Массив") Тогда
        МассивПараметров = Новый Массив;
        МассивПараметров.Добавить(Параметры);
        Возврат МассивПараметров;
    КонецЕсли;

    Возврат Параметры;

КонецФункции

// Описание: Подставляет текущую дату, если передана пустая дата по умолчанию
//
// Параметры:
//  Дата - Дата
//
// Возвращаемое значение:
//  Дата - дата среза для запроса
//
Функция НормализоватьДату(Дата)

    Если Дата = '00010101' Тогда
        Возврат ТекущаяДата();
    КонецЕсли;

    Возврат Дата;

КонецФункции

// Описание: Сравнивает два соответствия по списку запрошенных параметров
//
// Параметры:
//  Соответствие1     - Соответствие - эталон
//  Соответствие2     - Соответствие - проверяемый вариант
//  МассивПараметров  - Массив - список ключей для сравнения
//
// Возвращаемое значение:
//  Массив - параметры, по которым значения различаются
//
Функция СравнитьСоответствия(Соответствие1, Соответствие2, МассивПараметров)

    Расхождения = Новый Массив;

    Для Каждого Параметр Из МассивПараметров Цикл

        Значение1 = Соответствие1.Получить(Параметр);
        Значение2 = Соответствие2.Получить(Параметр);

        Если Не ЗначенияПараметраРавны(Значение1, Значение2) Тогда
            Расхождения.Добавить(Параметр);
        КонецЕсли;

    КонецЦикла;

    Возврат Расхождения;

КонецФункции

// Описание: Сравнивает два значения параметра с учетом Неопределено
//
// Параметры:
//  Значение1 - Произвольный
//  Значение2 - Произвольный
//
// Возвращаемое значение:
//  Булево - Истина, если значения эквивалентны
//
Функция ЗначенияПараметраРавны(Значение1, Значение2)

    // Пустые значения из запроса (NULL) и Неопределено считаем эквивалентными
    Если Не ЗначениеЗаполнено(Значение1) И Не ЗначениеЗаполнено(Значение2) Тогда
        Возврат Истина;
    КонецЕсли;

    Если ТипЗнч(Значение1) <> ТипЗнч(Значение2) Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат Значение1 = Значение2;

КонецФункции

// Описание: Замеряет суммарное время одного алгоритма на всей выборке
//
// Параметры:
//  ИмяАлгоритма      - Строка - "Текущий", "ПолныйСрез" или "Фильтр"
//  МассивДоговоров   - Массив
//  НаборыПараметров  - Массив из Структура(Имя, Параметры)
//  ДатаСреза         - Дата
//
// Возвращаемое значение:
//  Число - длительность в миллисекундах
//
Функция ЗамеритьАлгоритм(ИмяАлгоритма, МассивДоговоров, НаборыПараметров, ДатаСреза)

    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

    Для Каждого ДоговорДУ Из МассивДоговоров Цикл

        Для Каждого НаборПараметров Из НаборыПараметров Цикл

            МассивПараметров = НаборПараметров.Параметры;

            Если ИмяАлгоритма = "Текущий" Тогда
                ЗначенияПараметровДоговораДУ_Текущий(ДоговорДУ, МассивПараметров, ДатаСреза);
            ИначеЕсли ИмяАлгоритма = "ПолныйСрез" Тогда
                ЗначенияПараметровДоговораДУ_НовыйПолныйСрез(ДоговорДУ, МассивПараметров, ДатаСреза);
            Иначе
                ЗначенияПараметровДоговораДУ_НовыйФильтр(ДоговорДУ, МассивПараметров, ДатаСреза);
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

КонецФункции

// Описание: Форматирует строку отчета по времени выполнения
//
// Параметры:
//  Заголовок          - Строка
//  ВремяМс            - Число - суммарное время
//  КоличествоВызовов  - Число
//
// Возвращаемое значение:
//  Строка - строка для текстового отчета
//
Функция ФорматироватьСтрокуВремени(Заголовок, ВремяМс, КоличествоВызовов)

    СреднееМс = ?(КоличествоВызовов > 0, ВремяМс / КоличествоВызовов, 0);
    Возврат СтрШаблон("%1: всего %2 мс, среднее %3 мс/вызов",
        Заголовок,
        ФорматЧислаДляОтчета(ВремяМс),
        ФорматЧислаДляОтчета(СреднееМс, 2));

КонецФункции

// Описание: Безопасное форматирование целых и дробных чисел для текстового отчета
// ЧН=0 - ноль отображается как "0"; ЧГ= - без разделителя тысяч (избегаем пустого вывода и NBSP)
//
Функция ФорматЧислаДляОтчета(Число, ДробныхЗнаков = 0)

    Если ДробныхЗнаков = 0 Тогда
        Возврат Формат(Число, "ЧН=0; ЧГ=");
    КонецЕсли;

    Возврат Формат(Число, "ЧН=0; ЧГ=; ЧДЦ=" + Строка(ДробныхЗнаков));

КонецФункции

// Описание: Форматирует процент изменения времени относительно эталона
//
Функция ФорматПроцентаДляОтчета(Процент)

    Знак = ?(Процент > 0, "+", "");
    Возврат Знак + ФорматЧислаДляОтчета(Процент, 1) + " %";

КонецФункции

// Описание: Формирует итоговую строку для отчета и всплывающего сообщения
//
Функция СформироватьТекстИтога(КоличествоРасхождений12, КоличествоРасхождений13,
    ВремяТекущий, ВремяПолныйСрез, ВремяФильтр)

    ЧастиИтога = Новый Массив;

    Если КоличествоРасхождений12 > 0 Или КоличествоРасхождений13 > 0 Тогда
        ЧастиИтога.Добавить("Корректность: ЕСТЬ расхождения в значениях параметров.");
    Иначе
        ЧастиИтога.Добавить("Корректность: значения параметров совпадают (0 расхождений).");
    КонецЕсли;

    ЧастиИтога.Добавить("Скорость (всего мс):"
        + " Текущий=" + ФорматЧислаДляОтчета(ВремяТекущий)
        + ", ПолныйСрез=" + ФорматЧислаДляОтчета(ВремяПолныйСрез)
        + ", Фильтр=" + ФорматЧислаДляОтчета(ВремяФильтр) + ".");

    МинимальноеВремя = Мин(ВремяТекущий, ВремяПолныйСрез, ВремяФильтр);
    Если МинимальноеВремя = ВремяФильтр Тогда
        ЧастиИтога.Добавить("Быстрее всех: вариант 3 (фильтр).");
    ИначеЕсли МинимальноеВремя = ВремяТекущий Тогда
        ЧастиИтога.Добавить("Быстрее всех: текущий алгоритм КФ.");
    Иначе
        ЧастиИтога.Добавить("Быстрее всех: вариант 2 (полный срез) - неожиданно, проверьте замер.");
    КонецЕсли;

    Возврат СтрСоединить(ЧастиИтога, " ");

КонецФункции

