////////////////////////////////////////////////////////////////////////////////
// Внешняя обработка: быстрое параллельное удаление ПланРегламентныхОперацийДУ
// и подчиненных документов (критерий СвязанныеДокументы).
//
// Назначение (IMDEV-8899 / rev2):
//   Цикл A/B тестирования вечернего регламента на одном операционном дне:
//   1) прогон без rev2 -> снимок
//   2) удаление обработкой
//   3) прогон с rev2 -> снимок
//   4) сравнение снимков
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описание: Регистрация в подсистеме БСП «Дополнительные отчеты и обработки»
//
// Возвращаемое значение:
//  Структура - сведения о внешней обработке для БСП
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("8899.8899.8899");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработки.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0.0.2";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = "Быстрое удаление планов регл. операций ДУ (8899)";
	НоваяКоманда.Идентификатор = "ОткрытьФорму";
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработки.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Точка входа для длительной операции (фоновое задание БСП)
//
// Параметры:
//  Параметры - Структура - см. СформироватьПараметрыОперации
//
// Возвращаемое значение:
//  Структура - результат операции (ТекстОтчета, Статистика, ТаблицаСнимка)
//
Функция ВыполнитьОперациюВФоне(Параметры) Экспорт

	Возврат ВыполнитьОперацию(Параметры);

КонецФункции

// Описание: Фоновая процедура для пакетного удаления планов (параллельные потоки)
//
// Параметры:
//  АдресПараметров - Строка - адрес во временном хранилище со структурой:
//      * МассивПланов - Массив из ДокументСсылка.ПланРегламентныхОперацийДУ
//      * ОтменятьПроведение - Булево
//      * УдалятьПланы - Булево
//      * АдресРезультата - Строка - адрес для записи локальной статистики пакета
//
Процедура УдалитьПакетПланов(АдресПараметров) Экспорт

	ПараметрыПакета = ПолучитьИзВременногоХранилища(АдресПараметров);
	Если ТипЗнч(ПараметрыПакета) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	МассивПланов = ПараметрыПакета.МассивПланов;
	ОтменятьПроведение = ПараметрыПакета.ОтменятьПроведение;
	УдалятьПланы = ПараметрыПакета.УдалятьПланы;

	СтатистикаПакета = НовыйСтатистикаУдаления();

	Для Каждого СсылкаПлана Из МассивПланов Цикл
		УдалитьОдинПлан(СсылкаПлана, ОтменятьПроведение, УдалятьПланы, СтатистикаПакета);
	КонецЦикла;

	Если ПараметрыПакета.Свойство("АдресРезультата")
		И ЗначениеЗаполнено(ПараметрыПакета.АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(СтатистикаПакета, ПараметрыПакета.АдресРезультата);
	КонецЕсли;

КонецПроцедуры

// Описание: Выполняет предпросмотр, снимок или удаление планов за операционный день
//
// Параметры:
//  Параметры - Структура:
//      * ДатаОперационногоДня - Дата
//      * НаименованиеПула - Строка - фильтр по наименованию пула (пусто = все)
//      * ГруппаОперацийПользователя - необязательно, не используется в UI (все группы)
//      * КоличествоПотоков - Число
//      * УдалятьПланы - Булево
//      * ОтменятьПроведение - Булево
//      * Режим - Строка - "Предпросмотр", "Снимок", "Удаление"
//
// Возвращаемое значение:
//  Структура:
//      * ТекстОтчета - Строка
//      * Статистика - Структура
//      * ТаблицаСнимка - ТаблицаЗначений
//
Функция ВыполнитьОперацию(Параметры) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ТекстОтчета", "");
	Результат.Вставить("Статистика", Новый Структура);
	Результат.Вставить("ТаблицаСнимка", НоваяТаблицаСнимка());

	Если Не ЗначениеЗаполнено(Параметры.ДатаОперационногоДня) Тогда
		Результат.ТекстОтчета = "Не указан операционный день.";
		Возврат Результат;
	КонецЕсли;

	ТаблицаПланов = НайтиПланы(Параметры);
	Если ТаблицаПланов.Количество() = 0 Тогда
		Результат.ТекстОтчета = СтрШаблон("Планы за %1 не найдены (пул=%2).",
			Формат(Параметры.ДатаОперационногоДня, "ДЛФ=D"),
			?(ЗначениеЗаполнено(Параметры.НаименованиеПула), Параметры.НаименованиеПула, "любой"));
		Возврат Результат;
	КонецЕсли;

	МассивПланов = ТаблицаПланов.ВыгрузитьКолонку("Ссылка");
	ТаблицаСнимка = СформироватьСнимок(МассивПланов);
	Результат.ТаблицаСнимка = ТаблицаСнимка;

	СтрокиОтчета = Новый Массив;
	СтрокиОтчета.Добавить("=== IMDEV-8899: планы регл. операций ДУ ===");
	СтрокиОтчета.Добавить("Дата: " + Формат(Параметры.ДатаОперационногоДня, "ДЛФ=D"));
	СтрокиОтчета.Добавить("Найдено планов: " + Формат(ТаблицаПланов.Количество(), "ЧН=0; ЧГ="));
	СтрокиОтчета.Добавить("Строк в снимке подчиненных: " + Формат(ТаблицаСнимка.Количество(), "ЧН=0; ЧГ="));
	СтрокиОтчета.Добавить("");

	СводкаСнимка = СформироватьСводкуСнимка(ТаблицаСнимка);
	СтрокиОтчета.Добавить("--- Сводка подчиненных (тип x количество) ---");
	Для Каждого СтрокаСводки Из СводкаСнимка Цикл
		СтрокиОтчета.Добавить(СтрокаСводки);
	КонецЦикла;
	СтрокиОтчета.Добавить("");

	Если Параметры.Режим = "Предпросмотр" Или Параметры.Режим = "Снимок" Тогда
		СтрокиОтчета.Добавить("Режим: " + Параметры.Режим + " (изменений в базе нет).");
		Если Параметры.Режим = "Снимок" Тогда
			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("--- Детализация снимка (первые 200 строк) ---");
			СтрокиОтчета.Добавить(СформироватьТекстДетализацииСнимка(ТаблицаСнимка, 200));
		КонецЕсли;
		СтрокиОтчета.Добавить("");
		СтрокиОтчета.Добавить(ТекстПодсказкиСравнения());
		Результат.ТекстОтчета = СтрСоединить(СтрокиОтчета, Символы.ПС);
		Возврат Результат;
	КонецЕсли;

	// Удаление
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Статистика = УдалитьПланыПараллельно(
		МассивПланов,
		Параметры.КоличествоПотоков,
		Параметры.ОтменятьПроведение,
		Параметры.УдалятьПланы);
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	СтрокиОтчета.Добавить("--- Удаление ---");
	СтрокиОтчета.Добавить("Потоков: " + Формат(Статистика.КоличествоПотоков, "ЧН=0; ЧГ="));
	СтрокиОтчета.Добавить("Обработано планов: " + Формат(Статистика.ОбработаноПланов, "ЧН=0; ЧГ="));
	СтрокиОтчета.Добавить("Помечено подчиненных: " + Формат(Статистика.ПомеченоПодчиненных, "ЧН=0; ЧГ="));
	СтрокиОтчета.Добавить("Отменено проведений: " + Формат(Статистика.ОтмененоПроведений, "ЧН=0; ЧГ="));
	СтрокиОтчета.Добавить("Ошибок: " + Формат(Статистика.Ошибок, "ЧН=0; ЧГ="));
	СтрокиОтчета.Добавить("Время: " + Формат(ДлительностьМс, "ЧН=0; ЧГ=") + " мс");

	Если Статистика.Ошибки.Количество() > 0 Тогда
		СтрокиОтчета.Добавить("");
		СтрокиОтчета.Добавить("Первые ошибки:");
		Максимум = Мин(10, Статистика.Ошибки.Количество());
		Для Индекс = 0 По Максимум - 1 Цикл
			СтрокиОтчета.Добавить("  " + Статистика.Ошибки[Индекс]);
		КонецЦикла;
	КонецЕсли;

	Если Статистика.Свойство("Предупреждение") И ЗначениеЗаполнено(Статистика.Предупреждение) Тогда
		СтрокиОтчета.Добавить("");
		СтрокиОтчета.Добавить(Статистика.Предупреждение);
	КонецЕсли;

	Результат.Статистика = Статистика;
	Результат.ТекстОтчета = СтрСоединить(СтрокиОтчета, Символы.ПС);

	Возврат Результат;

КонецФункции

// Описание: Формирует структуру параметров из реквизитов обработки
//
// Параметры:
//  ДатаОперационногоДня - Дата
//  НаименованиеПула - Строка
//  КоличествоПотоков - Число
//  УдалятьПланы - Булево
//  ОтменятьПроведение - Булево
//  Режим - Строка
//
// Возвращаемое значение:
//  Структура - параметры для ВыполнитьОперацию
//
Функция СформироватьПараметрыОперации(ДатаОперационногоДня, НаименованиеПула,
	КоличествоПотоков, УдалятьПланы, ОтменятьПроведение, Режим) Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ДатаОперационногоДня", ДатаОперационногоДня);
	Параметры.Вставить("НаименованиеПула", НаименованиеПула);
	Параметры.Вставить("ГруппаОперацийПользователя", Неопределено);
	Параметры.Вставить("КоличествоПотоков", КоличествоПотоков);
	Параметры.Вставить("УдалятьПланы", УдалятьПланы);
	Параметры.Вставить("ОтменятьПроведение", ОтменятьПроведение);
	Параметры.Вставить("Режим", Режим);

	Возврат Параметры;

КонецФункции

// Описание: Формирует текст файла снимка (CSV с заголовком метаданных)
//
// Параметры:
//  ТаблицаСнимка - ТаблицаЗначений - данные снимка
//  Метаданные - Структура - Марка, Дата, Пул, КоличествоПланов
//
// Возвращаемое значение:
//  Строка - содержимое файла в UTF-8
//
Функция СформироватьТекстФайлаСнимка(ТаблицаСнимка, Метаданные) Экспорт

	Строки = Новый Массив;
	Строки.Добавить("#FORMAT=8899-SNAPSHOT-1");
	Строки.Добавить("#MARK=" + СокрЛП(?(Метаданные.Свойство("Марка"), Метаданные.Марка, "")));
	Строки.Добавить("#DATE=" + Формат(Метаданные.Дата, "ДФ=yyyyMMdd"));
	Строки.Добавить("#POOL=" + СокрЛП(?(Метаданные.Свойство("Пул"), Метаданные.Пул, "")));
	Строки.Добавить("#PLANS=" + Формат(?(Метаданные.Свойство("КоличествоПланов"), Метаданные.КоличествоПланов, 0), "ЧГ="));
	Строки.Добавить("#ROWS=" + Формат(ТаблицаСнимка.Количество(), "ЧГ="));
	Строки.Добавить("#CREATED=" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss"));
	Строки.Добавить("");
	Строки.Добавить("ДоговорДУ|План|ГруппаОпераций|ПланПроведен|ТипДокумента|Документ|ДокументПроведен|ВидОперации|Выполнять");

	Для Каждого Строка Из ТаблицаСнимка Цикл
		Строки.Добавить(СтрокаСнимкаВТекст(Строка));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Описание: Сравнивает два файла снимков и формирует текстовый анализ
//
// Параметры:
//  ТекстСнимкаA - Строка - содержимое первого файла (базовый / без rev2)
//  ТекстСнимкаB - Строка - содержимое второго файла (с rev2)
//
// Возвращаемое значение:
//  Строка - отчет сравнения
//
Функция СравнитьФайлыСнимков(ТекстСнимкаA, ТекстСнимкаB) Экспорт

	СнимокA = РазобратьФайлСнимка(ТекстСнимкаA);
	Если Не СнимокA.Успех Тогда
		Возврат "Ошибка файла A: " + СнимокA.Ошибка;
	КонецЕсли;

	СнимокB = РазобратьФайлСнимка(ТекстСнимкаB);
	Если Не СнимокB.Успех Тогда
		Возврат "Ошибка файла B: " + СнимокB.Ошибка;
	КонецЕсли;

	Возврат СформироватьОтчетСравнения(СнимокA, СнимокB);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяМетодаПакетногоУдаления()

	Возврат "Обработка.внБыстроеУдалениеПлановРеглОперацийДУ.МодульОбъекта.УдалитьПакетПланов";

КонецФункции

Функция НоваяТаблицаСнимка()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ДоговорДУ");
	Таблица.Колонки.Добавить("План");
	Таблица.Колонки.Добавить("ГруппаОпераций");
	Таблица.Колонки.Добавить("ПланПроведен", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ТипДокумента");
	Таблица.Колонки.Добавить("Документ");
	Таблица.Колонки.Добавить("ДокументПроведен", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ВидОперации");
	Таблица.Колонки.Добавить("Выполнять", Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

Функция НовыйСтатистикаУдаления()

	Статистика = Новый Структура;
	Статистика.Вставить("КоличествоПотоков", 0);
	Статистика.Вставить("ОбработаноПланов", 0);
	Статистика.Вставить("ПомеченоПодчиненных", 0);
	Статистика.Вставить("ОтмененоПроведений", 0);
	Статистика.Вставить("Ошибок", 0);
	Статистика.Вставить("Ошибки", Новый Массив);
	Статистика.Вставить("Предупреждение", "");

	Возврат Статистика;

КонецФункции

Функция НайтиПланы(Параметры)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	План.Ссылка КАК Ссылка,
	|	План.ДоговорДУ КАК ДоговорДУ,
	|	План.ГруппаОперацийПользователя КАК ГруппаОперацийПользователя,
	|	План.Проведен КАК Проведен,
	|	План.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.ПланРегламентныхОперацийДУ КАК План
	|ГДЕ
	|	План.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ План.ПометкаУдаления";

	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Параметры.ДатаОперационногоДня));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Параметры.ДатаОперационногоДня));

	Если ЗначениеЗаполнено(Параметры.НаименованиеПула) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И План.ДоговорДУ.Пул.Наименование = &НаименованиеПула";
		Запрос.УстановитьПараметр("НаименованиеПула", Параметры.НаименованиеПула);
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.ГруппаОперацийПользователя) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И План.ГруппаОперацийПользователя = &ГруппаОперацийПользователя";
		Запрос.УстановитьПараметр("ГруппаОперацийПользователя", Параметры.ГруппаОперацийПользователя);
	КонецЕсли;

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция СформироватьСнимок(МассивПланов)

	ТаблицаСнимка = НоваяТаблицаСнимка();

	Для Каждого СсылкаПлана Из МассивПланов Цикл

		РеквизитыПлана = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаПлана,
			"ДоговорДУ, ГруппаОперацийПользователя, Проведен");

		// Строки ТЧ «Операции» плана — для сравнения флага Выполнять (rev2 фильтрует их)
		ЗапросОпераций = Новый Запрос;
		ЗапросОпераций.Текст =
		"ВЫБРАТЬ
		|	ПланОперации.ВидОперации КАК ВидОперации,
		|	ПланОперации.Выполнять КАК Выполнять
		|ИЗ
		|	Документ.ПланРегламентныхОперацийДУ.Операции КАК ПланОперации
		|ГДЕ
		|	ПланОперации.Ссылка = &Ссылка";
		ЗапросОпераций.УстановитьПараметр("Ссылка", СсылкаПлана);
		ТаблицаОпераций = ЗапросОпераций.Выполнить().Выгрузить();

		Для Каждого СтрокаОперации Из ТаблицаОпераций Цикл
			НоваяСтрока = ТаблицаСнимка.Добавить();
			НоваяСтрока.ДоговорДУ = РеквизитыПлана.ДоговорДУ;
			НоваяСтрока.План = СсылкаПлана;
			НоваяСтрока.ГруппаОпераций = РеквизитыПлана.ГруппаОперацийПользователя;
			НоваяСтрока.ПланПроведен = РеквизитыПлана.Проведен;
			НоваяСтрока.ТипДокумента = "<строка плана>";
			НоваяСтрока.Документ = Неопределено;
			НоваяСтрока.ДокументПроведен = Ложь;
			НоваяСтрока.ВидОперации = СтрокаОперации.ВидОперации;
			НоваяСтрока.Выполнять = СтрокаОперации.Выполнять;
		КонецЦикла;

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СвязанныеДокументы.Ссылка КАК Документ,
		|	ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) КАК ТипДокумента,
		|	СвязанныеДокументы.Ссылка.Проведен КАК ДокументПроведен
		|ИЗ
		|	КритерийОтбора.СвязанныеДокументы(&Ссылка) КАК СвязанныеДокументы
		|ГДЕ
		|	НЕ СвязанныеДокументы.Ссылка.ПометкаУдаления";
		Запрос.УстановитьПараметр("Ссылка", СсылкаПлана);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаСнимка.Добавить();
			НоваяСтрока.ДоговорДУ = РеквизитыПлана.ДоговорДУ;
			НоваяСтрока.План = СсылкаПлана;
			НоваяСтрока.ГруппаОпераций = РеквизитыПлана.ГруппаОперацийПользователя;
			НоваяСтрока.ПланПроведен = РеквизитыПлана.Проведен;
			НоваяСтрока.ТипДокумента = Строка(Выборка.ТипДокумента);
			НоваяСтрока.Документ = Выборка.Документ;
			НоваяСтрока.ДокументПроведен = Выборка.ДокументПроведен;
			НоваяСтрока.ВидОперации = Неопределено;
			НоваяСтрока.Выполнять = Ложь;
		КонецЦикла;

	КонецЦикла;

	Возврат ТаблицаСнимка;

КонецФункции

Функция СформироватьСводкуСнимка(ТаблицаСнимка)

	Сводка = Новый Соответствие;

	Для Каждого Строка Из ТаблицаСнимка Цикл
		Если Строка.ТипДокумента = "<строка плана>" Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Строка(Строка.ТипДокумента);
		ТекущееЗначение = Сводка.Получить(Ключ);
		Если ТекущееЗначение = Неопределено Тогда
			ТекущееЗначение = 0;
		КонецЕсли;
		Сводка.Вставить(Ключ, ТекущееЗначение + 1);
	КонецЦикла;

	Строки = Новый Массив;
	Для Каждого Элемент Из Сводка Цикл
		Строки.Добавить(СтрШаблон("  %1: %2", Элемент.Ключ, Формат(Элемент.Значение, "ЧН=0; ЧГ=")));
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Строки.Добавить("  (подчиненных документов нет)");
	КонецЕсли;

	Возврат Строки;

КонецФункции

Функция СформироватьТекстДетализацииСнимка(ТаблицаСнимка, МаксимумСтрок)

	Строки = Новый Массив;
	Счетчик = 0;

	Для Каждого Строка Из ТаблицаСнимка Цикл

		Если Счетчик >= МаксимумСтрок Тогда
			Строки.Добавить("  ... (обрезано, всего строк: " + Формат(ТаблицаСнимка.Количество(), "ЧН=0; ЧГ=") + ")");
			Прервать;
		КонецЕсли;

		Если Строка.ТипДокумента = "<строка плана>" Тогда
			ТекстСтроки = СтрШаблон("  [план] %1 | %2 | Выполнять=%3",
				Строка.ДоговорДУ,
				Строка.ВидОперации,
				?(Строка.Выполнять, "Да", "Нет"));
		Иначе
			ТекстСтроки = СтрШаблон("  [док] %1 | %2 | %3 | пров=%4",
				Строка.ДоговорДУ,
				Строка.ТипДокумента,
				Строка.Документ,
				?(Строка.ДокументПроведен, "Да", "Нет"));
		КонецЕсли;

		Строки.Добавить(ТекстСтроки);
		Счетчик = Счетчик + 1;

	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Строки.Добавить("  (нет данных)");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТекстПодсказкиСравнения()

	Строки = Новый Массив;
	Строки.Добавить("--- Что сравнивать между прогоном без rev2 и с rev2 ---");
