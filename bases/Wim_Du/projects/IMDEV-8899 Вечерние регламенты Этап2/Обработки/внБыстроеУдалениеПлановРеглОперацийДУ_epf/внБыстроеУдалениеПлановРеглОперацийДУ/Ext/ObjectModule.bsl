	Строки.Добавить("4) Остатки/СЧА на конец дня по тестовым договорам (отчет или регистр).");
	Строки.Добавить("5) Журнал регистрации: ошибки при закрытии периода.");
	Строки.Добавить("6) Время закрытия (замер из формы регл. периода или лог отладки).");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция УдалитьПланыПараллельно(МассивПланов, КоличествоПотоков, ОтменятьПроведение, УдалятьПланы)

	Статистика = НовыйСтатистикаУдаления();

	Если КоличествоПотоков <= 0 Тогда
		КоличествоПотоков = 1;
	КонецЕсли;

	Если КоличествоПотоков = 1 Тогда
		Статистика.КоличествоПотоков = 1;
		Для Каждого СсылкаПлана Из МассивПланов Цикл
			УдалитьОдинПлан(СсылкаПлана, ОтменятьПроведение, УдалятьПланы, Статистика);
		КонецЦикла;
		Возврат Статистика;
	КонецЕсли;

	Пакеты = РазбитьНаПакеты(МассивПланов, КоличествоПотоков);
	Статистика.КоличествоПотоков = Пакеты.Количество();

	МассивЗаданий = Новый Массив;
	МассивАдресовРезультатов = Новый Массив;
	ИдентификаторФормы = Новый УникальныйИдентификатор;

	Для Каждого ПакетПланов Из Пакеты Цикл

		ПараметрыПакета = Новый Структура;
		ПараметрыПакета.Вставить("МассивПланов", ПакетПланов);
		ПараметрыПакета.Вставить("ОтменятьПроведение", ОтменятьПроведение);
		ПараметрыПакета.Вставить("УдалятьПланы", УдалятьПланы);

		АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
		ПараметрыПакета.Вставить("АдресРезультата", АдресРезультата);
		МассивАдресовРезультатов.Добавить(АдресРезультата);

		АдресПараметров = ПоместитьВоВременноеХранилище(ПараметрыПакета, ИдентификаторФормы);

		Попытка
			Задание = ФоновыеЗадания.Выполнить(
				ИмяМетодаПакетногоУдаления(),
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(АдресПараметров),
				,
				"8899 удаление планов регл. операций");
			МассивЗаданий.Добавить(Задание);
		Исключение
			// Параллель недоступна (обработка открыта из файла без регистрации в БСП) — один поток
			Статистика.Предупреждение = "Параллельный режим недоступен: " + ОписаниеОшибки()
				+ ". Выполнено последовательно в текущем сеансе.";
			Для Каждого СсылкаПлана Из МассивПланов Цикл
				УдалитьОдинПлан(СсылкаПлана, ОтменятьПроведение, УдалятьПланы, Статистика);
			КонецЦикла;
			Статистика.КоличествоПотоков = 1;
			Возврат Статистика;
		КонецПопытки;

	КонецЦикла;

	ОжидатьЗавершенияЗаданий(МассивЗаданий, Статистика);

	Для Каждого АдресРезультата Из МассивАдресовРезультатов Цикл
		СтатистикаПакета = ПолучитьИзВременногоХранилища(АдресРезультата);
		Если ТипЗнч(СтатистикаПакета) = Тип("Структура") Тогда
			ОбъединитьСтатистику(Статистика, СтатистикаПакета);
		КонецЕсли;
	КонецЦикла;

	Возврат Статистика;

КонецФункции

Процедура УдалитьОдинПлан(СсылкаПлана, ОтменятьПроведение, УдалятьПланы, Статистика)

	Попытка

		// Подчиненные — через типовой метод менеджера (rev2 перехватывает его)
		Если ОтменятьПроведение Тогда
			ОтменитьПроведениеПодчиненных(СсылкаПлана, Статистика);
		КонецЕсли;

		КоличествоДо = ПодсчитатьПодчиненных(СсылкаПлана);
		Документы.ПланРегламентныхОперацийДУ.ПометитьНаУдалениеПодчиненныеДокументы(СсылкаПлана);
		Статистика.ПомеченоПодчиненных = Статистика.ПомеченоПодчиненных + КоличествоДо;

		Если УдалятьПланы Тогда
			ДокументОбъект = СсылкаПлана.ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				Возврат;
			КонецЕсли;

			Если ОтменятьПроведение И ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Статистика.ОтмененоПроведений = Статистика.ОтмененоПроведений + 1;
			КонецЕсли;

			Если Не ДокументОбъект.ПометкаУдаления Тогда
				ДокументОбъект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		КонецЕсли;

		Статистика.ОбработаноПланов = Статистика.ОбработаноПланов + 1;

	Исключение
		Статистика.Ошибок = Статистика.Ошибок + 1;
		Статистика.Ошибки.Добавить(СтрШаблон("%1: %2", СсылкаПлана, ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

Процедура ОтменитьПроведениеПодчиненных(СсылкаПлана, Статистика)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СвязанныеДокументы.Ссылка КАК Документ
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Ссылка) КАК СвязанныеДокументы
	|ГДЕ
	|	СвязанныеДокументы.Ссылка.Проведен
	|	И НЕ СвязанныеДокументы.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", СсылкаПлана);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ДокументОбъект = Выборка.Документ.ПолучитьОбъект();
			Если ДокументОбъект <> Неопределено И ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Статистика.ОтмененоПроведений = Статистика.ОтмененоПроведений + 1;
			КонецЕсли;
		Исключение
			Статистика.Ошибок = Статистика.Ошибок + 1;
			Статистика.Ошибки.Добавить(СтрШаблон("Отмена проведения %1: %2", Выборка.Документ, ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ПодсчитатьПодчиненных(СсылкаПлана)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(СвязанныеДокументы.Ссылка) КАК Количество
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Ссылка) КАК СвязанныеДокументы
	|ГДЕ
	|	НЕ СвязанныеДокументы.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", СсылкаПлана);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция РазбитьНаПакеты(МассивПланов, КоличествоПакетов)

	Результат = Новый Массив;
	Если МассивПланов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	КоличествоПакетов = Макс(1, Мин(КоличествоПакетов, МассивПланов.Количество()));
	РазмерПакета = Цел(МассивПланов.Количество() / КоличествоПакетов);
	Если РазмерПакета = 0 Тогда
		РазмерПакета = 1;
	КонецЕсли;

	Индекс = 0;
	Пока Индекс < МассивПланов.Количество() Цикл

		Пакет = Новый Массив;
		КонецПакета = Мин(Индекс + РазмерПакета - 1, МассивПланов.Количество() - 1);
		Для Позиция = Индекс По КонецПакета Цикл
			Пакет.Добавить(МассивПланов[Позиция]);
		КонецЦикла;
		Результат.Добавить(Пакет);
		Индекс = КонецПакета + 1;

		Если Результат.Количество() >= КоличествоПакетов - 1 Тогда
			// Последний пакет — все оставшиеся
			Если Индекс < МассивПланов.Количество() Тогда
				ПоследнийПакет = Новый Массив;
				Для Позиция = Индекс По МассивПланов.Количество() - 1 Цикл
					ПоследнийПакет.Добавить(МассивПланов[Позиция]);
				КонецЦикла;
				Результат.Добавить(ПоследнийПакет);
			КонецЕсли;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ОжидатьЗавершенияЗаданий(МассивЗаданий, Статистика)

	МаксимумОжиданияСек = 3600;
	Начало = ТекущаяДата();

	Пока Истина Цикл

		ВсеЗавершены = Истина;

		Для Каждого Задание Из МассивЗаданий Цикл
			ТекущееЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Задание.УникальныйИдентификатор);
			Если ТекущееЗадание = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если ТекущееЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				ВсеЗавершены = Ложь;
			ИначеЕсли ТекущееЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
				Статистика.Ошибок = Статистика.Ошибок + 1;
				Статистика.Ошибки.Добавить("Фоновое задание завершилось с ошибкой: " + ТекущееЗадание.Наименование);
			КонецЕсли;
		КонецЦикла;

		Если ВсеЗавершены Тогда
			Прервать;
		КонецЕсли;

		Если ТекущаяДата() - Начало > МаксимумОжиданияСек Тогда
			Статистика.Ошибок = Статистика.Ошибок + 1;
			Статистика.Ошибки.Добавить("Превышено время ожидания фоновых заданий.");
			Прервать;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ОбъединитьСтатистику(Статистика, СтатистикаПакета)

	Статистика.ОбработаноПланов = Статистика.ОбработаноПланов + СтатистикаПакета.ОбработаноПланов;
	Статистика.ПомеченоПодчиненных = Статистика.ПомеченоПодчиненных + СтатистикаПакета.ПомеченоПодчиненных;
	Статистика.ОтмененоПроведений = Статистика.ОтмененоПроведений + СтатистикаПакета.ОтмененоПроведений;
	Статистика.Ошибок = Статистика.Ошибок + СтатистикаПакета.Ошибок;

	Для Каждого ТекстОшибки Из СтатистикаПакета.Ошибки Цикл
		Статистика.Ошибки.Добавить(ТекстОшибки);
	КонецЦикла;

КонецПроцедуры

Функция СтрокаСнимкаВТекст(Строка)

	Поля = Новый Массив;
	Поля.Добавить(ПредставлениеСсылки(Строка.ДоговорДУ));
	Поля.Добавить(ПредставлениеСсылки(Строка.План));
	Поля.Добавить(ПредставлениеСсылки(Строка.ГруппаОпераций));
	Поля.Добавить(?(Строка.ПланПроведен, "1", "0"));
	Поля.Добавить(Строка.ТипДокумента);
	Поля.Добавить(ПредставлениеСсылки(Строка.Документ));
	Поля.Добавить(?(Строка.ДокументПроведен, "1", "0"));
	Поля.Добавить(ПредставлениеСсылки(Строка.ВидОперации));
	Поля.Добавить(?(Строка.Выполнять, "1", "0"));

	Возврат СтрСоединить(Поля, "|");

КонецФункции

Функция ПредставлениеСсылки(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат XMLСтрока(Значение);
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;

КонецФункции

Функция НоваяТаблицаСнимкаИзФайла()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ДоговорДУ");
	Таблица.Колонки.Добавить("План");
	Таблица.Колонки.Добавить("ГруппаОпераций");
	Таблица.Колонки.Добавить("ПланПроведен", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ТипДокумента");
	Таблица.Колонки.Добавить("Документ");
	Таблица.Колонки.Добавить("ДокументПроведен", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ВидОперации");
	Таблица.Колонки.Добавить("Выполнять", Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

Функция РазобратьФайлСнимка(ТекстФайла)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Метаданные", Новый Структура("Марка, Дата, Пул, КоличествоПланов", "", '00010101', "", 0));
	Результат.Вставить("ТаблицаСнимка", НоваяТаблицаСнимкаИзФайла());

	Если Не ЗначениеЗаполнено(ТекстФайла) Тогда
		Результат.Ошибка = "Пустой файл.";
		Возврат Результат;
	КонецЕсли;

	СтрокиФайла = СтрРазделить(ТекстФайла, Символы.ПС, Ложь);
	ЕстьЗаголовокФормата = Ложь;
	НачалоДанных = 0;

	Для Индекс = 0 По СтрокиФайла.ВГраница() Цикл

		Строка = СокрЛП(СтрокиФайла[Индекс]);
		Если Не ЗначениеЗаполнено(Строка) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Строка, "#") Тогда
			РазборМетаданных = СтрРазделить(Строка, "=", Ложь);
			Если РазборМетаданных.Количество() = 2 Тогда
				Ключ = ВРег(СокрЛП(РазборМетаданных[0]));
				Значение = СокрЛП(РазборМетаданных[1]);
				Если Ключ = "#FORMAT" Тогда
					ЕстьЗаголовокФормата = (Значение = "8899-SNAPSHOT-1");
				ИначеЕсли Ключ = "#MARK" Тогда
					Результат.Метаданные.Марка = Значение;
				ИначеЕсли Ключ = "#DATE" Тогда
					Результат.Метаданные.Дата = ДатаИзСтрокиYYYYMMDD(Значение);
				ИначеЕсли Ключ = "#POOL" Тогда
					Результат.Метаданные.Пул = Значение;
				ИначеЕсли Ключ = "#PLANS" Тогда
					Результат.Метаданные.КоличествоПланов = Число(Значение);
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Строка = "ДоговорДУ|План|ГруппаОпераций|ПланПроведен|ТипДокумента|Документ|ДокументПроведен|ВидОперации|Выполнять" Тогда
			НачалоДанных = Индекс + 1;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если Не ЕстьЗаголовокФормата Тогда
		Результат.Ошибка = "Неизвестный формат файла (ожидается #FORMAT=8899-SNAPSHOT-1).";
		Возврат Результат;
	КонецЕсли;

	Если НачалоДанных = 0 Тогда
		Результат.Ошибка = "Не найдена строка заголовка данных.";
		Возврат Результат;
	КонецЕсли;

	Для Индекс = НачалоДанных По СтрокиФайла.ВГраница() Цикл

		Строка = СокрЛП(СтрокиФайла[Индекс]);
		Если Не ЗначениеЗаполнено(Строка) Тогда
			Продолжить;
		КонецЕсли;

		Поля = СтрРазделить(Строка, "|", Ложь);
		Если Поля.Количество() < 9 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.ТаблицаСнимка.Добавить();
		НоваяСтрока.ДоговорДУ = Поля[0];
		НоваяСтрока.План = Поля[1];
		НоваяСтрока.ГруппаОпераций = Поля[2];
		НоваяСтрока.ПланПроведен = (Поля[3] = "1");
		НоваяСтрока.ТипДокумента = Поля[4];
		НоваяСтрока.Документ = Поля[5];
		НоваяСтрока.ДокументПроведен = (Поля[6] = "1");
		НоваяСтрока.ВидОперации = Поля[7];
		НоваяСтрока.Выполнять = (Поля[8] = "1");

	КонецЦикла;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

Функция ДатаИзСтрокиYYYYMMDD(ТекстДаты)

	Если СтрДлина(ТекстДаты) <> 8 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат Дата(Число(Сред(ТекстДаты, 1, 4)), Число(Сред(ТекстДаты, 5, 2)), Число(Сред(ТекстДаты, 7, 2)));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

Функция СформироватьОтчетСравнения(СнимокA, СнимокB)

	Строки = Новый Массив;
	Строки.Добавить("=== Сравнение снимков IMDEV-8899 ===");
	Строки.Добавить("");
	Строки.Добавить("--- Файл A (базовый) ---");
	Строки.Добавить(ТекстМетаданныхСнимка(СнимокA.Метаданные, СнимокA.ТаблицаСнимка));
	Строки.Добавить("");
	Строки.Добавить("--- Файл B (с rev2) ---");
	Строки.Добавить(ТекстМетаданныхСнимка(СнимокB.Метаданные, СнимокB.ТаблицаСнимка));
	Строки.Добавить("");

	Если СнимокA.Метаданные.Дата <> СнимокB.Метаданные.Дата Тогда
		Строки.Добавить("ВНИМАНИЕ: разные операционные дни в файлах!");
	КонецЕсли;

	Если СнимокA.Метаданные.Пул <> СнимокB.Метаданные.Пул Тогда
		Строки.Добавить("ВНИМАНИЕ: разные пулы в файлах!");
	КонецЕсли;

	Строки.Добавить("");
	Строки.Добавить("--- Сводка подчиненных (тип x количество) ---");

	СводкаA = СводкаПодчиненныхИзФайла(СнимокA.ТаблицаСнимка);
	СводкаB = СводкаПодчиненныхИзФайла(СнимокB.ТаблицаСнимка);
	Строки.Добавить(ТекстСравненияСводок(СводкаA, СводкаB));

	Строки.Добавить("");
	Строки.Добавить("--- Операции плана с Выполнять=Да (по плану) ---");
	Строки.Добавить(ТекстСравненияОпераций(СнимокA.ТаблицаСнимка, СнимокB.ТаблицаСнимка, 30));

	Строки.Добавить("");
	Строки.Добавить("--- Подчиненные документы ---");
	Строки.Добавить(ТекстСравненияДокументов(СнимокA.ТаблицаСнимка, СнимокB.ТаблицаСнимка, 30));

	Строки.Добавить("");
	Строки.Добавить("--- Итог ---");
	Строки.Добавить(ТекстИтогаСравнения(СводкаA, СводкаB, СнимокA.ТаблицаСнимка, СнимокB.ТаблицаСнимка));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТекстМетаданныхСнимка(Метаданные, ТаблицаСнимка)

	Строки = Новый Массив;
	Строки.Добавить("  Марка: " + ?(ЗначениеЗаполнено(Метаданные.Марка), Метаданные.Марка, "(не указана)"));
	Строки.Добавить("  Дата: " + Формат(Метаданные.Дата, "ДЛФ=D"));
	Строки.Добавить("  Пул: " + ?(ЗначениеЗаполнено(Метаданные.Пул), Метаданные.Пул, "(любой)"));
	Строки.Добавить("  Планов (в метаданных): " + Формат(Метаданные.КоличествоПланов, "ЧН=0; ЧГ="));
	Строки.Добавить("  Строк в файле: " + Формат(ТаблицаСнимка.Количество(), "ЧН=0; ЧГ="));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СводкаПодчиненныхИзФайла(ТаблицаСнимка)

	Сводка = Новый Соответствие;

	Для Каждого Строка Из ТаблицаСнимка Цикл
		Если Строка.ТипДокумента = "<строка плана>" Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Строка.ТипДокумента;
		Текущее = Сводка.Получить(Ключ);
		Если Текущее = Неопределено Тогда
			Текущее = 0;
		КонецЕсли;
		Сводка.Вставить(Ключ, Текущее + 1);
	КонецЦикла;

	Возврат Сводка;

КонецФункции

Функция ТекстСравненияСводок(СводкаA, СводкаB)

	Строки = Новый Массив;
	ВсеТипы = Новый Соответствие;

	Для Каждого Элемент Из СводкаA Цикл
		ВсеТипы.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	Для Каждого Элемент Из СводкаB Цикл
		ВсеТипы.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;

	ЕстьОтличия = Ложь;

	Для Каждого Элемент Из ВсеТипы Цикл
		КолA = СводкаA.Получить(Элемент.Ключ);
		КолB = СводкаB.Получить(Элемент.Ключ);
		Если КолA = Неопределено Тогда
			КолA = 0;
		КонецЕсли;
		Если КолB = Неопределено Тогда
			КолB = 0;
		КонецЕсли;
		Маркер = ?(КолA = КолB, "OK", "РАЗЛИЧИЕ");
		Если КолA <> КолB Тогда
			ЕстьОтличия = Истина;
		КонецЕсли;
		Строки.Добавить(СтрШаблон("  [%1] %2: A=%3, B=%4", Маркер, Элемент.Ключ,
			Формат(КолA, "ЧН=0; ЧГ="), Формат(КолB, "ЧН=0; ЧГ=")));
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Строки.Добавить("  (подчиненных документов нет в обоих файлах)");
	ИначеЕсли Не ЕстьОтличия Тогда
		Строки.Добавить("  Сводки совпадают.");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТекстСравненияОпераций(ТаблицаA, ТаблицаB, МаксимумПримеров)

	КлючиA = КлючиОперацийСнимка(ТаблицаA);
	КлючиB = КлючиОперацийСнимка(ТаблицаB);

	ТолькоA = Новый Массив;
	ТолькоB = Новый Массив;
	РазличиеФлага = Новый Массив;

	Для Каждого Элемент Из КлючиA Цикл
		Если КлючиB.Получить(Элемент.Ключ) = Неопределено Тогда
			ТолькоA.Добавить(Элемент.Ключ);
		ИначеЕсли КлючиA.Получить(Элемент.Ключ) <> КлючиB.Получить(Элемент.Ключ) Тогда
			РазличиеФлага.Добавить(СтрШаблон("%1: A=%2, B=%3", Элемент.Ключ,
				?(КлючиA.Получить(Элемент.Ключ), "Да", "Нет"),
				?(КлючиB.Получить(Элемент.Ключ), "Да", "Нет")));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из КлючиB Цикл
		Если КлючиA.Получить(Элемент.Ключ) = Неопределено Тогда
			ТолькоB.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("  Операций с Выполнять=Да: A=%1, B=%2",
		КоличествоОперацийСФлагом(ТаблицаA, Истина),
		КоличествоОперацийСФлагом(ТаблицаB, Истина)));
	Строки.Добавить(СтрШаблон("  Только в A: %1, только в B: %2, различие флага: %3",
		ТолькоA.Количество(), ТолькоB.Количество(), РазличиеФлага.Количество()));

	ДобавитьПримерыРазличий(Строки, "  Примеры только в A:", ТолькоA, МаксимумПримеров);
	ДобавитьПримерыРазличий(Строки, "  Примеры только в B:", ТолькоB, МаксимумПримеров);
	ДобавитьПримерыРазличий(Строки, "  Примеры различия Выполнять:", РазличиеФлага, МаксимумПримеров);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция КлючиОперацийСнимка(ТаблицаСнимка)

	Ключи = Новый Соответствие;

	Для Каждого Строка Из ТаблицаСнимка Цикл
		Если Строка.ТипДокумента <> "<строка плана>" Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СтрШаблон("%1|%2", Строка.План, Строка.ВидОперации);
		Ключи.Вставить(Ключ, Строка.Выполнять);
	КонецЦикла;

	Возврат Ключи;

КонецФункции

Функция КоличествоОперацийСФлагом(ТаблицаСнимка, ЗначениеФлага)

	Количество = 0;
	Для Каждого Строка Из ТаблицаСнимка Цикл
		Если Строка.ТипДокумента = "<строка плана>" И Строка.Выполнять = ЗначениеФлага Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

Функция ТекстСравненияДокументов(ТаблицаA, ТаблицаB, МаксимумПримеров)

	КлючиA = КлючиДокументовСнимка(ТаблицаA);
	КлючиB = КлючиДокументовСнимка(ТаблицаB);

	ТолькоA = Новый Массив;
	ТолькоB = Новый Массив;
	РазличиеПроведения = Новый Массив;

	Для Каждого Элемент Из КлючиA Цикл
		ДанныеB = КлючиB.Получить(Элемент.Ключ);
		Если ДанныеB = Неопределено Тогда
			ТолькоA.Добавить(Элемент.Ключ);
		ИначеЕсли Элемент.Значение <> ДанныеB Тогда
			РазличиеПроведения.Добавить(СтрШаблон("%1: A=%2, B=%3", Элемент.Ключ,
				?(Элемент.Значение, "пров", "не пров"),
				?(ДанныеB, "пров", "не пров")));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из КлючиB Цикл
		Если КлючиA.Получить(Элемент.Ключ) = Неопределено Тогда
			ТолькоB.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("  Документов: A=%1, B=%2",
		КлючиA.Количество(), КлючиB.Количество()));
	Строки.Добавить(СтрШаблон("  Только в A: %1, только в B: %2, различие проведения: %3",
		ТолькоA.Количество(), ТолькоB.Количество(), РазличиеПроведения.Количество()));

	ДобавитьПримерыРазличий(Строки, "  Примеры только в A:", ТолькоA, МаксимумПримеров);
	ДобавитьПримерыРазличий(Строки, "  Примеры только в B:", ТолькоB, МаксимумПримеров);
	ДобавитьПримерыРазличий(Строки, "  Примеры различия проведения:", РазличиеПроведения, МаксимумПримеров);

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция КлючиДокументовСнимка(ТаблицаСнимка)

	Ключи = Новый Соответствие;

	Для Каждого Строка Из ТаблицаСнимка Цикл
		Если Строка.ТипДокумента = "<строка плана>" Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СтрШаблон("%1|%2|%3", Строка.План, Строка.ТипДокумента, Строка.Документ);
		Ключи.Вставить(Ключ, Строка.ДокументПроведен);
	КонецЦикла;

	Возврат Ключи;

КонецФункции

Процедура ДобавитьПримерыРазличий(Строки, Заголовок, МассивПримеров, Максимум)

	Если МассивПримеров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Строки.Добавить(Заголовок);
	Максимум = Мин(Максимум, МассивПримеров.Количество());
	Для Индекс = 0 По Максимум - 1 Цикл
		Строки.Добавить("    " + МассивПримеров[Индекс]);
	КонецЦикла;

	Если МассивПримеров.Количество() > Максимум Тогда
		Строки.Добавить(СтрШаблон("    ... еще %1", МассивПримеров.Количество() - Максимум));
	КонецЕсли;

КонецПроцедуры

Функция ТекстИтогаСравнения(СводкаA, СводкаB, ТаблицаA, ТаблицаB)

	СводкиСовпадают = Истина;
	ВсеТипы = Новый Соответствие;
	Для Каждого Элемент Из СводкаA Цикл
		ВсеТипы.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	Для Каждого Элемент Из СводкаB Цикл
		ВсеТипы.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	Для Каждого Элемент Из ВсеТипы Цикл
		КолA = СводкаA.Получить(Элемент.Ключ);
		КолB = СводкаB.Получить(Элемент.Ключ);
		Если КолA = Неопределено Тогда
			КолA = 0;
		КонецЕсли;
		Если КолB = Неопределено Тогда
			КолB = 0;
		КонецЕсли;
		Если КолA <> КолB Тогда
			СводкиСовпадают = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ОперацииСовпадают = (КлючиОперацийСнимка(ТаблицаA).Количество() = КлючиОперацийСнимка(ТаблицаB).Количество())
		И КоличествоОперацийСФлагом(ТаблицаA, Истина) = КоличествоОперацийСФлагом(ТаблицаB, Истина);

	ДокA = КлючиДокументовСнимка(ТаблицаA);
	ДокB = КлючиДокументовСнимка(ТаблицаB);
	ДокументыСовпадают = (ДокA.Количество() = ДокB.Количество());

	Если СводкиСовпадают И ОперацииСовпадают И ДокументыСовпадают Тогда
		Возврат "OK: снимки совпадают по сводке, составу документов и количеству операций с Выполнять=Да.";
	КонецЕсли;

	Части = Новый Массив;
	Если Не СводкиСовпадают Тогда
		Части.Добавить("различается сводка типов");
	КонецЕсли;
	Если Не ДокументыСовпадают Тогда
		Части.Добавить("различается состав/количество документов");
	КонецЕсли;
	Если Не ОперацииСовпадают Тогда
		Части.Добавить("различаются операции плана (rev2 мог отфильтровать Выполнять)");
	КонецЕсли;

	Возврат "Есть отличия: " + СтрСоединить(Части, "; ") + ".";

КонецФункции

#КонецОбласти
