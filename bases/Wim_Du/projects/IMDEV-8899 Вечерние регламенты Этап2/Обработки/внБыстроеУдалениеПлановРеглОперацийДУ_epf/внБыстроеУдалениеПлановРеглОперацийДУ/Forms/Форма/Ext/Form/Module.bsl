
////////////////////////////////////////////////////////////////////////////////
// Модуль формы внешней обработки "Быстрое удаление планов регл. операций ДУ"
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Предпросмотр(Команда)
	ВыполнитьОперациюНаКлиенте("Предпросмотр");
КонецПроцедуры

&НаКлиенте
Процедура Снимок(Команда)
	ВыполнитьОперациюНаКлиенте("Снимок");
КонецПроцедуры

&НаКлиенте
Процедура СнимокВФайл(Команда)
	ВыполнитьОперациюНаКлиенте("Снимок", Истина);
КонецПроцедуры

&НаКлиенте
Процедура Сравнить(Команда)

	Если Не ЗначениеЗаполнено(ФайлСнимкаA) Или Не ЗначениеЗаполнено(ФайлСнимкаB) Тогда
		ПоказатьПредупреждение(, "Укажите оба файла снимков для сравнения.");
		Возврат;
	КонецЕсли;

	ТекстA = ПрочитатьТекстФайлаНаКлиенте(ФайлСнимкаA);
	Если ТекстA = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстB = ПрочитатьТекстФайлаНаКлиенте(ФайлСнимкаB);
	Если ТекстB = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстРезультата = СравнитьСнимкиНаСервере(ТекстA, ТекстB);

КонецПроцедуры

&НаКлиенте
Процедура ФайлСнимкаAНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайлСнимка("A");

КонецПроцедуры

&НаКлиенте
Процедура ФайлСнимкаBНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайлСнимка("B");

КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)

	ТекстВопроса = "Пометить на удаление подчиненные документы и планы за выбранный день?"
		+ Символы.ПС + "Операция необратима для тестовой базы.";

	Оповещение = Новый ОписаниеОповещения("УдалитьПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПослеПодтверждения(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьОперациюНаКлиенте("Удаление");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.ДатаОперационногоДня) Тогда
		Объект.ДатаОперационногоДня = ТекущаяДатаСеанса();
	КонецЕсли;

	Если Объект.КоличествоПотоков = 0 Тогда
		Объект.КоличествоПотоков = ПолучитьКоличествоПотоковПоУмолчанию();
	КонецЕсли;

	Объект.УдалятьПланы = Истина;
	Объект.ОтменятьПроведение = Истина;

	Если Не ЗначениеЗаполнено(Объект.НаименованиеПула) Тогда
		Объект.НаименованиеПула = "Розничное ДУ";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьОперациюНаКлиенте(Режим, СохранитьВФайл = Ложь)

	Если Режим = "Удаление" Тогда
		РезультатЗадания = ЗапуститьУдалениеВФонеНаСервере();
		Если РезультатЗадания = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если РезультатЗадания.Статус = "Выполняется" Тогда
			НачатьОжиданиеЗадания(РезультатЗадания);
		Иначе
			ОбработатьРезультатОперации(РезультатЗадания, Неопределено);
		КонецЕсли;
	Иначе
		ДопПараметры = Новый Структура("СохранитьВФайл", СохранитьВФайл);
		ОбработатьРезультатОперации(ВыполнитьОперациюНаСервере(Режим), ДопПараметры);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьОжиданиеЗадания(РезультатЗадания)

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = "Удаление планов и подчиненных документов...";

	Оповещение = Новый ОписаниеОповещения("ОбработатьРезультатОперации", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатОперации(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ТекстРезультата = Результат.КраткоеПредставлениеОшибки;
		Возврат;
	КонецЕсли;

	ЗагрузитьТекстРезультатаНаСервере(Результат.АдресРезультата);

	СохранитьВФайл = Ложь;
	Если ДополнительныеПараметры <> Неопределено
		И ДополнительныеПараметры.Свойство("СохранитьВФайл") Тогда
		СохранитьВФайл = ДополнительныеПараметры.СохранитьВФайл;
	КонецЕсли;

	Если СохранитьВФайл Тогда
		СохранитьСнимокВФайлНаКлиенте(Результат.АдресРезультата);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьСнимокВФайлНаКлиенте(АдресРезультата)

	ДанныеФайла = ПодготовитьТекстФайлаСнимкаНаСервере(АдресРезультата, МаркаСнимка);
	Если ДанныеФайла = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось подготовить файл снимка.");
		Возврат;
	КонецЕсли;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить снимок";
	Диалог.Фильтр = "Файлы снимков (*.8899.csv)|*.8899.csv|CSV (*.csv)|*.csv";
	Диалог.ПолноеИмяФайла = ДанныеФайла.ИмяФайла;

	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;

	Если ЗаписатьТекстФайлаНаКлиенте(Диалог.ПолноеИмяФайла, ДанныеФайла.ТекстФайла) Тогда
		ТекстРезультата = ТекстРезультата + Символы.ПС + Символы.ПС
			+ "Файл снимка сохранен: " + Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлСнимка(КакойФайл)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл снимка";
	Диалог.Фильтр = "Файлы снимков (*.8899.csv)|*.8899.csv|CSV (*.csv)|*.csv";

	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;

	Если КакойФайл = "A" Тогда
		ФайлСнимкаA = Диалог.ПолноеИмяФайла;
	Иначе
		ФайлСнимкаB = Диалог.ПолноеИмяФайла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьТекстФайлаНаКлиенте(ПолноеИмяФайла)

	Файл = Новый Файл(ПолноеИмяФайла);
	Если Не Файл.Существует() Тогда
		ПоказатьПредупреждение(, "Файл не найден: " + ПолноеИмяФайла);
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеТекста(ПолноеИмяФайла, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Возврат Текст;
	Исключение
		ПоказатьПредупреждение(, "Ошибка чтения файла: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ЗаписатьТекстФайлаНаКлиенте(ПолноеИмяФайла, Текст)

	Попытка
		Запись = Новый ЗаписьТекста(ПолноеИмяФайла, КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
		Возврат Истина;
	Исключение
		ПоказатьПредупреждение(, "Ошибка записи файла: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервере
Функция ПолучитьКоличествоПотоковПоУмолчанию()

	Количество = 1;
	Попытка
		Количество = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
	Исключение
		Количество = 5;
	КонецПопытки;

	Если Количество <= 0 Тогда
		Количество = 5;
	КонецЕсли;

	Возврат Количество;

КонецФункции

&НаСервере
Функция СформироватьПараметрыНаСервере(Режим)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.СформироватьПараметрыОперации(
		Объект.ДатаОперационногоДня,
		Объект.НаименованиеПула,
		Объект.КоличествоПотоков,
		Объект.УдалятьПланы,
		Объект.ОтменятьПроведение,
		Режим);

КонецФункции

&НаСервере
Функция ВыполнитьОперациюНаСервере(Режим)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПараметрыОперации = СформироватьПараметрыНаСервере(Режим);
	Результат = ОбработкаОбъект.ВыполнитьОперацию(ПараметрыОперации);

	АдресРезультата = ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);

	Ответ = Новый Структура;
	Ответ.Вставить("Статус", "Выполнено");
	Ответ.Вставить("АдресРезультата", АдресРезультата);

	Возврат Ответ;

КонецФункции

&НаСервере
Функция ЗапуститьУдалениеВФонеНаСервере()

	ПараметрыОперации = СформироватьПараметрыНаСервере("Удаление");
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "8899: удаление планов регл. операций ДУ";
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;

	ИмяПроцедуры = "Обработка.внБыстроеУдалениеПлановРеглОперацийДУ.МодульОбъекта.ВыполнитьОперациюВФоне";

	Попытка
		Возврат ДлительныеОперации.ВыполнитьВФоне(ИмяПроцедуры, ПараметрыОперации, ПараметрыВыполнения);
	Исключение
		// Обработка открыта из файла — выполняем синхронно в текущем сеансе
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Результат = ОбработкаОбъект.ВыполнитьОперацию(ПараметрыОперации);
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

		Ответ = Новый Структура;
		Ответ.Вставить("Статус", "Выполнено");
		Ответ.Вставить("АдресРезультата", АдресРезультата);
		Возврат Ответ;
	КонецПопытки;

КонецФункции

&НаСервере
Процедура ЗагрузитьТекстРезультатаНаСервере(АдресРезультата)

	Если Не ЗначениеЗаполнено(АдресРезультата) Тогда
		ТекстРезультата = "";
		Возврат;
	КонецЕсли;

	ДанныеРезультата = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ДанныеРезультата = Неопределено Тогда
		ТекстРезультата = "";
		Возврат;
	КонецЕсли;

	ТекстРезультата = ДанныеРезультата.ТекстОтчета;
	АдресПоследнегоСнимка = АдресРезультата;

КонецПроцедуры

&НаСервере
Функция ПолучитьРезультатИзХранилища(АдресРезультата)

	Если Не ЗначениеЗаполнено(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьИзВременногоХранилища(АдресРезультата);

КонецФункции

&НаСервере
Функция ПодготовитьТекстФайлаСнимкаНаСервере(АдресРезультата, Марка)

	ДанныеРезультата = ПолучитьРезультатИзХранилища(АдресРезультата);
	Если ДанныеРезультата = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Метаданные = Новый Структура;
	Метаданные.Вставить("Марка", Марка);
	Метаданные.Вставить("Дата", Объект.ДатаОперационногоДня);
	Метаданные.Вставить("Пул", Объект.НаименованиеПула);

	КоличествоПланов = 0;
	МассивПланов = Новый Массив;
	Для Каждого Строка Из ДанныеРезультата.ТаблицаСнимка Цикл
		Если ЗначениеЗаполнено(Строка.План) И МассивПланов.Найти(Строка.План) = Неопределено Тогда
			МассивПланов.Добавить(Строка.План);
		КонецЕсли;
	КонецЦикла;
	КоличествоПланов = МассивПланов.Количество();
	Метаданные.Вставить("КоличествоПланов", КоличествоПланов);

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТекстФайла = ОбработкаОбъект.СформироватьТекстФайлаСнимка(ДанныеРезультата.ТаблицаСнимка, Метаданные);

	Ответ = Новый Структура;
	Ответ.Вставить("ТекстФайла", ТекстФайла);
	Ответ.Вставить("ИмяФайла", СформироватьИмяФайлаСнимка(Марка, Объект.ДатаОперационногоДня));

	Возврат Ответ;

КонецФункции

&НаСервере
Функция СформироватьИмяФайлаСнимка(Марка, ДатаОперационногоДня)

	МаркаФайла = СокрЛП(Марка);
	Если Не ЗначениеЗаполнено(МаркаФайла) Тогда
		МаркаФайла = "snapshot";
	КонецЕсли;

	МаркаФайла = СтрЗаменить(МаркаФайла, " ", "_");
	МаркаФайла = СтрЗаменить(МаркаФайла, "\", "_");
	МаркаФайла = СтрЗаменить(МаркаФайла, "/", "_");
	МаркаФайла = СтрЗаменить(МаркаФайла, ":", "_");

	Возврат СтрШаблон("8899_%1_%2.8899.csv",
		МаркаФайла,
		Формат(ДатаОперационногоДня, "ДФ=yyyyMMdd"));

КонецФункции

&НаСервере
Функция СравнитьСнимкиНаСервере(ТекстA, ТекстB)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.СравнитьФайлыСнимков(ТекстA, ТекстB);

КонецФункции

#КонецОбласти
