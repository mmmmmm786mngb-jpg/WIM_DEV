
#Область Т431_СверкаСтенда

// Только для стенда. Считает доходность одних и тех же мандатов кодом 1.07 и кодом 1.08 и сравнивает.
//
// Параметры:
//  СтрокаСоединенияМО  - Строка - строка соединения COMConnector с базой МО
//  МандатыXML          - Строка - UUID мандатов МО через запятую
//  НачалоПериодаTWR    - Дата
//  КонецПериода        - Дата
//  ФлагОсобыеСтратегии - Булево
//  РазмерПорции        - Число - размер пачки для 1.08
//  ДобавитьДубли       - Булево - повторить каждый третий мандат в конце массива
//
// Возвращаемое значение:
//  Строка - строки "ключ;старая;новая", первая строка "#строк_TWR_1_07;N"
//
Функция Т431_Сверка(СтрокаСоединенияМО, МандатыXML, НачалоПериодаTWR, КонецПериода, ФлагОсобыеСтратегии,
	РазмерПорции, ДобавитьДубли) Экспорт

	Т431_УстановитьНастройки(РазмерПорции);
	Соединение = Т431_Соединение(СтрокаСоединенияМО);
	Мандаты = Новый Массив;
	МассивМандатов = Т431_МассивМандатов(Соединение, МандатыXML, ДобавитьДубли, Мандаты);

	СтрокTWR = 0;
	Старые = Т431_Старый(Соединение, МассивМандатов, Мандаты, НачалоПериодаTWR, КонецПериода, ФлагОсобыеСтратегии,
		СтрокTWR);
	Новые = Т431_Новый(Соединение, МассивМандатов, Мандаты, НачалоПериодаTWR, КонецПериода, ФлагОсобыеСтратегии);

	Результат = Новый Массив;
	Результат.Добавить("#строк_TWR_1_07;" + Формат(СтрокTWR, "ЧГ=0"));
	Результат.Добавить("#пачек_1_08;" + Формат(Т431_Пачек, "ЧГ=0") + ";построчно;" + Формат(Т431_ПачекПоСтрокам, "ЧГ=0"));
	Для Каждого КлючИЗначение Из Новые Цикл
		Результат.Добавить(КлючИЗначение.Ключ + ";" + XMLСтрока(Старые.Получить(КлючИЗначение.Ключ)) + ";"
			+ XMLСтрока(КлючИЗначение.Значение));
	КонецЦикла;

	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

// Только для стенда. Точка входа фонового задания для замера памяти одного варианта расчета.
//
// Параметры:
//  Параметры - Структура:
//   * Вариант             - Строка - "1.07" или "1.08"
//   * СтрокаСоединенияМО  - Строка
//   * МандатыXML          - Строка
//   * НачалоПериодаTWR    - Дата
//   * КонецПериода        - Дата
//   * ФлагОсобыеСтратегии - Булево
//   * РазмерПорции        - Число
//  АдресХранилища - Строка - адрес для результата: Структура(Вариант, Мандатов, СуммаДоходности, Секунд)
//
Процедура Т431_Замер(Параметры, АдресХранилища) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Т431_УстановитьНастройки(Параметры.РазмерПорции);
	Соединение = Т431_Соединение(Параметры.СтрокаСоединенияМО);
	Мандаты = Новый Массив;
	МассивМандатов = Т431_МассивМандатов(Соединение, Параметры.МандатыXML, Ложь, Мандаты);

	СтрокTWR = 0;
	Если Параметры.Вариант = "1.07" Тогда
		Итоги = Т431_Старый(Соединение, МассивМандатов, Мандаты, Параметры.НачалоПериодаTWR, Параметры.КонецПериода,
			Параметры.ФлагОсобыеСтратегии, СтрокTWR);
	Иначе
		Итоги = Т431_Новый(Соединение, МассивМандатов, Мандаты, Параметры.НачалоПериодаTWR, Параметры.КонецПериода,
			Параметры.ФлагОсобыеСтратегии);
	КонецЕсли;

	Сумма = 0;
	Для Каждого КлючИЗначение Из Итоги Цикл
		Сумма = Сумма + КлючИЗначение.Значение;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Вариант", Параметры.Вариант);
	Результат.Вставить("Мандатов", Итоги.Количество());
	Результат.Вставить("СтрокTWR", СтрокTWR);
	Результат.Вставить("СуммаДоходности", Сумма);
	Результат.Вставить("Секунд", (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000);
	Результат.Вставить("Пачек", Т431_Пачек);
	Результат.Вставить("ПачекПоСтрокам", Т431_ПачекПоСтрокам);
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

// Только для стенда. Отключает свертку пачки по позициям строк, чтобы проверить построчный путь.
//
// Параметры:
//  Значение - Булево - Истина: все пачки сворачиваются обходом строк
//
Процедура Т431_ОтключитьСверткуПоПозициям(Значение) Экспорт
	
	Т431_ОтключитьПозиции = Значение;
	
КонецПроцедуры

// Реквизиты обработки как в настройках по умолчанию, но фактический учет (на стенде нет плановых оценок).
//
// Параметры:
//  РазмерПорции - Число, Null - размер пачки мандатов для 1.08; не число - размер по умолчанию из модуля
//
Процедура Т431_УстановитьНастройки(РазмерПорции)

	ТипУчета                = "Фактический";
	ВознаграждениеКакПассив = Истина;
	КоммисияКакПассив       = Ложь;
	НДФЛКакПассив           = Истина;
	Т431_РазмерПорции       = Неопределено;
	Т431_Пачек              = 0;
	Т431_ПачекПоСтрокам     = 0;
	Если ТипЗнч(РазмерПорции) = Тип("Число") Тогда
		Т431_РазмерПорции = РазмерПорции; // иначе размер из РазмерПорцииМандатовTWR (None из COM приходит как Null)
	КонецЕсли;

КонецПроцедуры

// Внешнее соединение с МО, как в обработке: COM-соединение в процессе текущего сеанса.
//
// Параметры:
//  СтрокаСоединенияМО - Строка
//
// Возвращаемое значение:
//  COMОбъект - соединение
//
Функция Т431_Соединение(СтрокаСоединенияМО)

	Коннектор = Новый COMОбъект("V83.COMConnector");
	Возврат Коннектор.Connect(СтрокаСоединенияМО);

КонецФункции

// Массив МО со ссылками мандатов по списку UUID.
//
// Параметры:
//  Соединение    - COMОбъект
//  МандатыXML    - Строка - UUID через запятую
//  ДобавитьДубли - Булево - повторить каждый третий мандат в конце массива
//  Мандаты       - Массив - заполняется уникальными ссылками в порядке списка
//
// Возвращаемое значение:
//  COMОбъект - Массив МО
//
Функция Т431_МассивМандатов(Соединение, МандатыXML, ДобавитьДубли, Мандаты)

	МассивМандатов = Соединение.NewObject("Массив");
	Для Каждого Ключ Из СтрРазделить(МандатыXML, ",", Ложь) Цикл
		Мандат = Соединение.Справочники.Мандаты.ПолучитьСсылку(Соединение.NewObject("УникальныйИдентификатор", Ключ));
		МассивМандатов.Добавить(Мандат);
		Мандаты.Добавить(Мандат);
	КонецЦикла;
	Если ДобавитьДубли Тогда
		Для Индекс = 0 По Мандаты.Количество() - 1 Цикл
			Если Индекс % 3 = 0 Тогда
				МассивМандатов.Добавить(Мандаты[Индекс]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат МассивМандатов;

КонецФункции

// Расчет доходности кодом версии 1.07: один вызов TWR, индекс строк по мандату, КоличествоДнейВПериодеОтчёта.
//
// Параметры:
//  Соединение, МассивМандатов, Мандаты, НачалоПериодаTWR, КонецПериода, ФлагОсобыеСтратегии - см. Т431_Сверка
//  СтрокTWR - Число - возвращается число строк результата TWR
//
// Возвращаемое значение:
//  Соответствие - ключ XMLСтрока мандата, значение доходность в процентах
//
Функция Т431_Старый(Соединение, МассивМандатов, Мандаты, НачалоПериодаTWR, КонецПериода, ФлагОсобыеСтратегии,
	СтрокTWR)

	Группировка = "MANDATE";
	ДанныеДоходности = Соединение.ВТБ_РасчетДоходностиСервер.TWR(НачалоПериодаTWR, КонецПериода,
		Соединение.Справочники.Валюты.RUB, ВознаграждениеКакПассив, ?(ТипУчета = "Плановый", Истина, Ложь),
		МассивМандатов, Неопределено, Группировка, КоммисияКакПассив, НДФЛКакПассив,);
	СтрокTWR = ДанныеДоходности.Количество();

	ДоходностьПоМандатам = Соединение.NewObject("Соответствие");
	Для Каждого СтрокаДоходности Из ДанныеДоходности Цикл
		Мандат = СтрокаДоходности.Разделитель;
		СтрокиМандата = ДоходностьПоМандатам.Получить(Мандат);
		Если СтрокиМандата = Неопределено Тогда
			СтрокиМандата = Соединение.NewObject("Массив");
			ДоходностьПоМандатам.Вставить(Мандат, СтрокиМандата);
		КонецЕсли;
		СтрокиМандата.Добавить(СтрокаДоходности);
	КонецЦикла;

	Старые = Новый Соответствие;
	Для Каждого Мандат Из Мандаты Цикл
		Старая = 0;
		СтрокиДоходности = ДоходностьПоМандатам.Получить(Мандат);
		Если СтрокиДоходности <> Неопределено И СтрокиДоходности.Количество() <> 0 Тогда
			Если ФлагОсобыеСтратегии = Истина Тогда
				Rn_НакопленныйБенчмарк 	= 1;
				Для Каждого ТСтрока Из СтрокиДоходности Цикл
					Если (ТСтрока.IO + ТСтрока.MVn_1) <> 0 Тогда
						ТСтрока.Rn_Бенчмарк = ТСтрока.MVn/(ТСтрока.IO + ТСтрока.MVn_1);
					Иначе ТСтрока.Rn_Бенчмарк = 1;
					КонецЕсли;
					Rn_НакопленныйБенчмарк = Rn_НакопленныйБенчмарк * ТСтрока.Rn_Бенчмарк;
					ТСтрока.TWR_Бенчмарк = Rn_НакопленныйБенчмарк -1;
				КонецЦикла;
			КонецЕсли;
			ДнейВПериоде107 = Т431_КоличествоДней107(СтрокиДоходности, КонецПериода);
			Если ДнейВПериоде107 <> 0 Тогда
				КоличествоСтрок     = СтрокиДоходности.Количество()-1;
				ДоходностьСтратегии = (СтрокиДоходности.Получить(КоличествоСтрок).TWR_Бенчмарк) * (365/ДнейВПериоде107);
				Старая = ДоходностьСтратегии * 100;
			КонецЕсли;
		КонецЕсли;
		Старые.Вставить(Соединение.XMLСтрока(Мандат), Старая);
	КонецЦикла;

	Возврат Старые;

КонецФункции

// Расчет доходности кодом версии 1.08: ИтогиTWRПоМандатамПачками и расчет по итогу мандата.
//
// Параметры:
//  Соединение, МассивМандатов, Мандаты, НачалоПериодаTWR, КонецПериода, ФлагОсобыеСтратегии - см. Т431_Сверка
//
// Возвращаемое значение:
//  Соответствие - ключ XMLСтрока мандата, значение доходность в процентах
//
Функция Т431_Новый(Соединение, МассивМандатов, Мандаты, НачалоПериодаTWR, КонецПериода, ФлагОсобыеСтратегии)

	ИтогиПоМандатам = ИтогиTWRПоМандатамПачками(Соединение, МассивМандатов, Неопределено,
		НачалоПериодаTWR, КонецПериода, ФлагОсобыеСтратегии);

	Новые = Новый Соответствие;
	Для Каждого Мандат Из Мандаты Цикл
		Ключ = Соединение.XMLСтрока(Мандат);
		Новая = 0;
		ИтогМандата = ИтогиПоМандатам.Получить(Ключ);
		Если НЕ (ИтогМандата = Неопределено Или ИтогМандата.ПериодПервогоMV = Неопределено) Тогда
			ДнейВПериоде = КалендарныеГрафикиПовтИсп.РазностьДатВКалендарныхДнях(
				ИтогМандата.ПериодПервогоMV, КонецПериода) + 1;
			ДоходностьСтратегии = ИтогМандата.TWR_Бенчмарк * (365 / ДнейВПериоде);
			Новая = ДоходностьСтратегии * 100;
		КонецЕсли;
		Новые.Вставить(Ключ, Новая);
	КонецЦикла;

	Возврат Новые;

КонецФункции

// Копия функции КоличествоДнейВПериодеОтчёта версии 1.07.
//
// Параметры:
//  ДанныеДоходностиТабЗнач - COMОбъект - строки доходности мандата
//  КонецПериода            - Дата
//
// Возвращаемое значение:
//  Число - дней от первого дня с MVn <> 0 до конца периода
//
Функция Т431_КоличествоДней107(ДанныеДоходностиТабЗнач, КонецПериода)

	ДнейВПериодеОтчёта = 0;

	Для Каждого СтрокаДанныеДоходности Из ДанныеДоходностиТабЗнач Цикл
		Если СтрокаДанныеДоходности.MVn <> 0 Тогда
			ДнейВПериодеОтчёта = КалендарныеГрафикиПовтИсп.РазностьДатВКалендарныхДнях(
				СтрокаДанныеДоходности.Период, КонецПериода) +1;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат ДнейВПериодеОтчёта;

КонецФункции

#КонецОбласти
