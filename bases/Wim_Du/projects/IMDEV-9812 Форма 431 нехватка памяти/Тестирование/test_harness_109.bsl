
#Область Т431_Проверка109

// Только для стенда. Доходность особой стратегии: ДоходностьОсобыхСтратегийПачками версии 1.09 против кода 1.07.
//
// Параметры:
//  СтрокаСоединенияМО - Строка
//  МандатыXML         - Строка - UUID мандатов через запятую
//  НачалоПериодаTWR   - Дата
//  КонецПериода       - Дата
//  РазмерПорции       - Число, Null - размер пачки; не число - РазмерПорцииМандатовTWR версии 1.09
//  ДобавитьДубли      - Булево
//
// Возвращаемое значение:
//  Строка - "#строк_TWR_1_07;N", "#пачка;N", затем строки "ключ;старая;новая"
//
Функция Т431_Особые109(СтрокаСоединенияМО, МандатыXML, НачалоПериодаTWR, КонецПериода, РазмерПорции,
	ДобавитьДубли) Экспорт

	ТипУчета                = "Фактический";
	ВознаграждениеКакПассив = Истина;
	КоммисияКакПассив       = Ложь;
	НДФЛКакПассив           = Истина;
	Т431_РазмерПорции       = Неопределено;
	Если ТипЗнч(РазмерПорции) = Тип("Число") Тогда
		Т431_РазмерПорции = РазмерПорции;
	КонецЕсли;

	Коннектор = Новый COMОбъект("V83.COMConnector");
	Соединение = Коннектор.Connect(СтрокаСоединенияМО);
	МассивМандатов = Соединение.NewObject("Массив");
	Мандаты = Новый Массив;
	Для Каждого Ключ Из СтрРазделить(МандатыXML, ",", Ложь) Цикл
		Мандат = Соединение.Справочники.Мандаты.ПолучитьСсылку(Соединение.NewObject("УникальныйИдентификатор", Ключ));
		МассивМандатов.Добавить(Мандат);
		Мандаты.Добавить(Мандат);
	КонецЦикла;
	Если ДобавитьДубли Тогда
		Для Индекс = 0 По Мандаты.Количество() - 1 Цикл
			Если Индекс % 3 = 0 Тогда
				МассивМандатов.Добавить(Мандаты[Индекс]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Новые = ДоходностьОсобыхСтратегийПачками(Соединение, МассивМандатов, Неопределено, НачалоПериодаTWR, КонецПериода);

	ДанныеДоходности = Соединение.ВТБ_РасчетДоходностиСервер.TWR(НачалоПериодаTWR, КонецПериода,
		Соединение.Справочники.Валюты.RUB, ВознаграждениеКакПассив, Ложь,
		МассивМандатов, Неопределено, "MANDATE", КоммисияКакПассив, НДФЛКакПассив,);
	СтрокTWR = ДанныеДоходности.Количество();
	ДоходностьПоМандатам = Соединение.NewObject("Соответствие");
	Для Каждого СтрокаДоходности Из ДанныеДоходности Цикл
		СтрокиМандата = ДоходностьПоМандатам.Получить(СтрокаДоходности.Разделитель);
		Если СтрокиМандата = Неопределено Тогда
			СтрокиМандата = Соединение.NewObject("Массив");
			ДоходностьПоМандатам.Вставить(СтрокаДоходности.Разделитель, СтрокиМандата);
		КонецЕсли;
		СтрокиМандата.Добавить(СтрокаДоходности);
	КонецЦикла;

	Результат = Новый Массив;
	Результат.Добавить("#строк_TWR_1_07;" + Формат(СтрокTWR, "ЧГ=0"));
	Результат.Добавить("#пачка;" + Формат(РазмерПорцииМандатовTWR(), "ЧГ=0"));
	Для Каждого Мандат Из Мандаты Цикл
		Старая = 0;
		СтрокиДоходности = ДоходностьПоМандатам.Получить(Мандат);
		Если СтрокиДоходности <> Неопределено И СтрокиДоходности.Количество() <> 0 Тогда
			Rn_НакопленныйБенчмарк = 1;
			Для Каждого ТСтрока Из СтрокиДоходности Цикл
				Если (ТСтрока.IO + ТСтрока.MVn_1) <> 0 Тогда
					ТСтрока.Rn_Бенчмарк = ТСтрока.MVn/(ТСтрока.IO + ТСтрока.MVn_1);
				Иначе ТСтрока.Rn_Бенчмарк = 1;
				КонецЕсли;
				Rn_НакопленныйБенчмарк = Rn_НакопленныйБенчмарк * ТСтрока.Rn_Бенчмарк;
				ТСтрока.TWR_Бенчмарк = Rn_НакопленныйБенчмарк -1;
			КонецЦикла;
			Дней = КоличествоДнейВПериодеОтчёта(СтрокиДоходности, КонецПериода);
			Если Дней <> 0 Тогда
				ДоходностьСтратегии = (СтрокиДоходности.Получить(СтрокиДоходности.Количество()-1).TWR_Бенчмарк) * (365/Дней);
				Старая = ДоходностьСтратегии * 100;
			КонецЕсли;
		КонецЕсли;
		Ключ = Соединение.XMLСтрока(Мандат);
		Новая = Новые.Получить(Ключ);
		Если Новая = Неопределено Тогда
			Новая = 0;
		КонецЕсли;
		Результат.Добавить(Ключ + ";" + XMLСтрока(Старая) + ";" + XMLСтрока(Новая));
	КонецЦикла;

	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

// Только для стенда. Выполняет запросы ДУ формы до разделов: СформироватьМенеджерВременныхТаблиц,
// пустая ВТ_ДанныеПоСтратегиям, ДополнитьВременныеТаблицы, ДополнитьВТ_ВводыВыводы.
//
// Параметры:
//  УправляющаяКомпания - СправочникСсылка.Контрагенты
//  НачалоПериода       - Дата
//  КонецПериода        - Дата
//
// Возвращаемое значение:
//  Строка - временные таблицы и число строк
//
Функция Т431_ЗапросыДУ(УправляющаяКомпания, НачалоПериода, КонецПериода) Экспорт

	ИсключитьЦессии = Истина;
	ОтчетОбъект = Новый Структура("НачалоПериода, КонецПериода, УправляющаяКомпания",
		НачалоПериода, КонецПериода, УправляющаяКомпания);
	МВТ = СформироватьМенеджерВременныхТаблиц(ОтчетОбъект);

	ТаблицаСтратегий = Новый ТаблицаЗначений;
	ТаблицаСтратегий.Колонки.Добавить("НомерДоговора", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(20)));
	ТаблицаСтратегий.Колонки.Добавить("ИдентификаторСтратегии", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	ТаблицаСтратегий.Колонки.Добавить("НаименованиеСтратегии", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТаблицаСтратегий.Колонки.Добавить("ДоходностьСтратегии", Новый ОписаниеТипов("Число",,,, Новый КвалификаторыЧисла(25,6)));
	ТаблицаСтратегий.Колонки.Добавить("ВременнойГоризонт", Новый ОписаниеТипов("Число",,,, Новый КвалификаторыЧисла(15)));
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ ТЗ.НомерДоговора КАК НомерДоговора, ТЗ.ИдентификаторСтратегии КАК ИдентификаторСтратегии,
	|ТЗ.НаименованиеСтратегии КАК НаименованиеСтратегии, ТЗ.ДоходностьСтратегии КАК ДоходностьСтратегии,
	|ТЗ.ВременнойГоризонт КАК ВременнойГоризонт ПОМЕСТИТЬ ВТ_ДанныеПоСтратегиям ИЗ &ТЗ КАК ТЗ";
	Запрос.УстановитьПараметр("ТЗ", ТаблицаСтратегий);
	Запрос.Выполнить();

	ДополнитьВременныеТаблицы(МВТ, ОтчетОбъект);
	ДополнитьВТ_ВводыВыводы(ОтчетОбъект, МВТ);

	Строки = Новый Массив;
	Для Каждого Таблица Из МВТ.Таблицы Цикл
		Строки.Добавить(Таблица.ПолноеИмя + "=" + Формат(Таблица.ПолучитьДанные().Выгрузить().Количество(), "ЧГ=0; ЧН=0"));
	КонецЦикла;
	Возврат СтрСоединить(Строки, "; ");

КонецФункции

// Только для стенда. Пишет замер через ЗафиксироватьЗамерЗаполнения и возвращает записанную строку регистра.
//
// Параметры:
//  ИмяОперации - Строка
//
// Возвращаемое значение:
//  Строка - поля записи регистра ЗамерыВремени
//
Функция Т431_ЗамерЗаполнения(ИмяОперации) Экспорт

	КоличествоМандатовЗамера = 123;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах() - 1500;
	ЗафиксироватьЗамерЗаполнения(ИмяОперации, Начало, "Строк: тест T431 = 1");
	ЗафиксироватьЗамерЗаполнения(ИмяОперации, Начало, "Строк: тест T431 = 2", Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ З.ДатаНачалаЗамера КАК ДатаНачалаЗамера, З.ВремяВыполнения КАК ВремяВыполнения,
	|З.ВесЗамера КАК ВесЗамера, З.Комментарий КАК Комментарий, З.Пользователь КАК Пользователь,
	|З.ДатаЗаписи КАК ДатаЗаписи, З.ДатаЗаписиЛокальная КАК ДатаЗаписиЛокальная, З.ВыполненСОшибкой КАК ВыполненСОшибкой
	|ИЗ РегистрСведений.ЗамерыВремени КАК З ГДЕ З.КлючеваяОперация.Имя = &Имя";
	Запрос.УстановитьПараметр("Имя", ИмяОперации);
	Выборка = Запрос.Выполнить().Выбрать();
	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Строки.Добавить("время " + Выборка.ВремяВыполнения + "; вес " + Выборка.ВесЗамера + "; комм " + Выборка.Комментарий
			+ "; пользователь [" + Выборка.Пользователь + "]; запись " + Выборка.ДатаЗаписи + "; локальная "
			+ Выборка.ДатаЗаписиЛокальная + "; ошибка " + Выборка.ВыполненСОшибкой);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Только для стенда. Точка входа фонового задания: доходность особой стратегии одним вызовом TWR
// (код версии PROD) или пачками (ДоходностьОсобыхСтратегийПачками версии 1.09). Подключение к МО
// и восстановление ссылок мандатов в замер времени не входят.
//
// Параметры:
//  Параметры - Структура:
//   * Вариант            - Строка - "один вызов" или "пачки"
//   * СтрокаСоединенияМО - Строка
//   * МандатыXML         - Строка
//   * НачалоПериодаTWR   - Дата
//   * КонецПериода       - Дата
//   * РазмерПорции       - Число - для варианта "пачки"
//  АдресХранилища - Строка - результат: Структура(Секунд, СекундTWR, Мандатов, Пачек, СуммаДоходности)
//
Процедура Т431_ЗамерСкорости109(Параметры, АдресХранилища) Экспорт

	ТипУчета                = "Фактический";
	ВознаграждениеКакПассив = Истина;
	КоммисияКакПассив       = Ложь;
	НДФЛКакПассив           = Истина;
	Т431_РазмерПорции       = Параметры.РазмерПорции;

	Коннектор = Новый COMОбъект("V83.COMConnector");
	Соединение = Коннектор.Connect(Параметры.СтрокаСоединенияМО);
	МассивМандатов = Соединение.NewObject("Массив");
	Мандаты = Новый Массив;
	Для Каждого Ключ Из СтрРазделить(Параметры.МандатыXML, ",", Ложь) Цикл
		Мандат = Соединение.Справочники.Мандаты.ПолучитьСсылку(Соединение.NewObject("УникальныйИдентификатор", Ключ));
		МассивМандатов.Добавить(Мандат);
		Мандаты.Добавить(Мандат);
	КонецЦикла;

	Результат = Новый Структура("Секунд, СекундTWR, Мандатов, Пачек, СуммаДоходности", 0, 0, 0, 0, 0);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Если Параметры.Вариант = "пачки" Тогда
		Доходности = ДоходностьОсобыхСтратегийПачками(Соединение, МассивМандатов, Неопределено,
			Параметры.НачалоПериодаTWR, Параметры.КонецПериода);
		Результат.Пачек = Цел((МассивМандатов.Количество() - 1) / РазмерПорцииМандатовTWR()) + 1;
		Для Каждого КлючИЗначение Из Доходности Цикл
			Результат.СуммаДоходности = Результат.СуммаДоходности + КлючИЗначение.Значение;
		КонецЦикла;
		Результат.Мандатов = Доходности.Количество();
	Иначе
		// Код версии PROD для особой стратегии: один вызов TWR, COM-индекс строк, произведение Rn с записью в строку.
		ДанныеДоходности = Соединение.ВТБ_РасчетДоходностиСервер.TWR(Параметры.НачалоПериодаTWR, Параметры.КонецПериода,
			Соединение.Справочники.Валюты.RUB, ВознаграждениеКакПассив, Ложь,
			МассивМандатов, Неопределено, "MANDATE", КоммисияКакПассив, НДФЛКакПассив,);
		Результат.СекундTWR = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
		ДоходностьПоМандатам = Соединение.NewObject("Соответствие");
		Для Каждого СтрокаДоходности Из ДанныеДоходности Цикл
			Мандат = СтрокаДоходности.Разделитель;
			СтрокиМандата = ДоходностьПоМандатам.Получить(Мандат);
			Если СтрокиМандата = Неопределено Тогда
				СтрокиМандата = Соединение.NewObject("Массив");
				ДоходностьПоМандатам.Вставить(Мандат, СтрокиМандата);
			КонецЕсли;
			СтрокиМандата.Добавить(СтрокаДоходности);
		КонецЦикла;
		Для Каждого Мандат Из Мандаты Цикл
			СтрокиДоходности = ДоходностьПоМандатам.Получить(Мандат);
			Если СтрокиДоходности = Неопределено Или СтрокиДоходности.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Rn_НакопленныйБенчмарк = 1;
			Для Каждого ТСтрока Из СтрокиДоходности Цикл
				Если (ТСтрока.IO + ТСтрока.MVn_1) <> 0 Тогда
					ТСтрока.Rn_Бенчмарк = ТСтрока.MVn/(ТСтрока.IO + ТСтрока.MVn_1);
				Иначе ТСтрока.Rn_Бенчмарк = 1;
				КонецЕсли;
				Rn_НакопленныйБенчмарк = Rn_НакопленныйБенчмарк * ТСтрока.Rn_Бенчмарк;
				ТСтрока.TWR_Бенчмарк = Rn_НакопленныйБенчмарк -1;
			КонецЦикла;
			Дней = КоличествоДнейВПериодеОтчёта(СтрокиДоходности, Параметры.КонецПериода);
			Если Дней <> 0 Тогда
				ДоходностьСтратегии = (СтрокиДоходности.Получить(СтрокиДоходности.Количество()-1).TWR_Бенчмарк) * (365/Дней);
				Результат.СуммаДоходности = Результат.СуммаДоходности + ДоходностьСтратегии * 100;
				Результат.Мандатов = Результат.Мандатов + 1;
			КонецЕсли;
		КонецЦикла;
		Результат.Пачек = 1;
	КонецЕсли;

	Результат.Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

#КонецОбласти
