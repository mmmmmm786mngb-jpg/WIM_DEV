
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КонецПериода = НачалоДня(КонецМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1)));
	НачалоПериода = НачалоМесяца(КонецПериода);
	РазмерВыборки = 10000;
	РазмерПачки = 500;
	ИсключитьЦессии = Истина;
	ПлановыйУчет = Истина;
	ВознаграждениеКакПассив = Истина;
	КомиссииКакПассив = Ложь;
	НДФЛКакПассив = Истина;
	ТолькоКрупнееВыборки = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Готовит план проверки и выполняет его по шагам: на каждую стратегию сначала расчет 1.08, затем 1.07.
// Каждый шаг - отдельный серверный вызов, поэтому падение 1.07 по памяти не прерывает остальные шаги.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Замерить(Команда)

	Подготовка = ПодготовитьПроверку();
	Если ЗначениеЗаполнено(Подготовка.Ошибка) Тогда
		ПоказатьПредупреждение(, Подготовка.Ошибка);
		Возврат;
	КонецЕсли;

	Для Номер = 0 По Подготовка.Описания.ВГраница() Цикл
		Состояние("Проверка: шаг " + Формат(Номер + 1, "ЧГ=0") + " из " + Формат(Подготовка.Описания.Количество(), "ЧГ=0")
			+ ". " + Подготовка.Описания[Номер]);
		Попытка
			ВыполнитьШаг(Подготовка.АдресПлана, Номер);
		Исключение
			ЗаписатьОшибкуШага(Подготовка.АдресПлана, Номер, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	СформироватьОтчет(Подготовка.АдресПлана, Подготовка.КоличествоДоговоров);
	Состояние("Проверка завершена.");

КонецПроцедуры

// Сохраняет таблицу проверки текстовым файлом UTF-8. Файл можно передать разработчику.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если ТаблицаОтчета.ВысотаТаблицы = 0 Тогда
		ПоказатьПредупреждение(, "Сначала нажмите ""Проверить"".");
		Возврат;
	КонецЕсли;

	ОписаниеФайла = ФайлЛогаНаСервере();
	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов("Сохранение результата проверки", Истина);
	НачатьПолучениеФайлаССервера(ОписаниеФайла.Адрес, ОписаниеФайла.ИмяФайла, ПараметрыДиалога);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отбирает договоры и стратегии, как заполнение 0420431, и складывает план шагов во временное хранилище.
//
// Возвращаемое значение:
//  Структура:
//   * Ошибка              - Строка - текст, если проверку начать нельзя
//   * АдресПлана          - Строка - адрес плана во временном хранилище
//   * Описания            - Массив из Строка - описание каждого шага для строки состояния
//   * КоличествоДоговоров - Число
//
&НаСервере
Функция ПодготовитьПроверку()

	Результат = Новый Структура("Ошибка, АдресПлана, Описания, КоличествоДоговоров", "", "", Новый Массив, 0);

	Если Не ЗначениеЗаполнено(УправляющаяКомпания) Тогда
		Результат.Ошибка = "Укажите управляющую компанию, как в заполнении формы 431.";
		Возврат Результат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		Результат.Ошибка = "Укажите начало и конец периода отчета.";
		Возврат Результат;
	КонецЕсли;
	Если РазмерВыборки < 1 Или РазмерПачки < 1 Тогда
		Результат.Ошибка = "Число мандатов в проверке и в пачке должно быть больше нуля.";
		Возврат Результат;
	КонецЕсли;

	НомераДоговоров = НомераДоговоровОтчета();
	Если НомераДоговоров.Количество() = 0 Тогда
		Результат.Ошибка = "По указанным отборам договоры не найдены.";
		Возврат Результат;
	КонецЕсли;
	Результат.КоличествоДоговоров = НомераДоговоров.Количество();

	Базы = БазыМО();
	Если Базы.Количество() = 0 Тогда
		Результат.Ошибка = "Не найдена база МО. Укажите ее в поле или проверьте PROD_AVC_MO и PROD_AVC_Retail_MO.";
		Возврат Результат;
	КонецЕсли;

	НачалоTWR = НачалоГода(НачалоПериода);
	Шаги = Новый Массив;
	Для Каждого База Из Базы Цикл
		ДобавитьШагиБазы(База, НомераДоговоров, НачалоTWR, Шаги);
	КонецЦикла;

	Если Шаги.Количество() = 0 Тогда
		Результат.Ошибка = "Не найдено стратегий для проверки. Проверьте коды стратегий и флаг ""Только стратегии крупнее пачки"".";
		Возврат Результат;
	КонецЕсли;

	Для Каждого Шаг Из Шаги Цикл
		Результат.Описания.Добавить(Шаг.ИмяБазы + " / " + Шаг.Код + ": версия " + Шаг.Вариант
			+ ", мандатов " + Формат(Шаг.МандатыXML.Количество(), "ЧГ=0"));
	КонецЦикла;

	План = Новый Структура("НачалоTWR, Шаги", НачалоTWR, Шаги);
	Результат.АдресПлана = ПоместитьВоВременноеХранилище(План, УникальныйИдентификатор);
	Возврат Результат;

КонецФункции

// Читает состав стратегий базы МО и добавляет по два шага на стратегию: 1.08, затем 1.07.
// Ошибка подключения к базе добавляется шагом с текстом ошибки.
//
// Параметры:
//  База            - СправочникСсылка.ВнешниеИнформационныеБазы
//  НомераДоговоров - Массив из Строка
//  НачалоTWR       - Дата
//  Шаги            - Массив из Структура - дополняется шагами
//
&НаСервере
Процедура ДобавитьШагиБазы(База, НомераДоговоров, НачалоTWR, Шаги)

	Соединение = СоединениеСМО(База);
	Если ТипЗнч(Соединение) = Тип("Строка") Тогда
		Шаг = НовыйШаг(База, "", "", Ложь, "", 0, 0, Новый Массив, "1.08");
		Шаг.Ошибка = Соединение;
		Шаги.Добавить(Шаг);
		Возврат;
	КонецЕсли;

	Состав = ПрочитатьСостав(Соединение, НомераДоговоров, НачалоTWR, НачалоДня(КонецПериода));
	Стратегии = СтратегииДляПроверки(Соединение, Состав);
	Состав = Неопределено;

	Для Каждого Описание Из Стратегии Цикл
		Для Каждого Вариант Из СтрРазделить("1.08,1.07", ",") Цикл
			Шаги.Добавить(НовыйШаг(База, Описание.Код, Описание.Наименование, Описание.Особая, Описание.СтратегияXML,
				Описание.МандатовСтратегии, Описание.ДнейСтратегии, Описание.МандатыXML, Вариант));
		КонецЦикла;
	КонецЦикла;

	Соединение = Неопределено;

КонецПроцедуры

&НаСервере
Функция НовыйШаг(База, Код, Наименование, Особая, СтратегияXML, МандатовСтратегии, ДнейСтратегии, МандатыXML, Вариант)

	Шаг = Новый Структура;
	Шаг.Вставить("База", База);
	Шаг.Вставить("ИмяБазы", Строка(База));
	Шаг.Вставить("Код", Код);
	Шаг.Вставить("Наименование", Наименование);
	Шаг.Вставить("Особая", Особая);
	Шаг.Вставить("СтратегияXML", СтратегияXML);
	Шаг.Вставить("МандатовСтратегии", МандатовСтратегии);
	Шаг.Вставить("ДнейСтратегии", ДнейСтратегии);
	Шаг.Вставить("МандатыXML", МандатыXML);
	Шаг.Вставить("Вариант", Вариант);
	Шаг.Вставить("Результат", Неопределено);
	Шаг.Вставить("Ошибка", "");
	Возврат Шаг;

КонецФункции

// Выполняет один шаг плана: подключается к МО, восстанавливает ссылки мандатов и стратегии
// и считает доходность версией шага. Подключение и восстановление ссылок во время расчета не входят.
//
// Параметры:
//  АдресПлана - Строка
//  Номер      - Число - индекс шага
//
&НаСервере
Процедура ВыполнитьШаг(АдресПлана, Номер)

	План = ПолучитьИзВременногоХранилища(АдресПлана);
	Шаг = План.Шаги[Номер];
	Если ЗначениеЗаполнено(Шаг.Ошибка) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Соединение = СоединениеСМО(Шаг.База);
		Если ТипЗнч(Соединение) = Тип("Строка") Тогда
			ВызватьИсключение Соединение;
		КонецЕсли;

		МассивМандатов = Соединение.NewObject("Массив");
		Мандаты = Новый Массив;
		Для Каждого Ключ Из Шаг.МандатыXML Цикл
			Мандат = Соединение.Справочники.Мандаты.ПолучитьСсылку(Соединение.NewObject("УникальныйИдентификатор", Ключ));
			МассивМандатов.Добавить(Мандат);
			Мандаты.Добавить(Мандат);
		КонецЦикла;
		Мандат = Неопределено;

		Стратегия = Неопределено;
		Если ЗначениеЗаполнено(Шаг.СтратегияXML) Тогда
			Стратегия = Соединение.Справочники.Стратегии.ПолучитьСсылку(
				Соединение.NewObject("УникальныйИдентификатор", Шаг.СтратегияXML));
		КонецЕсли;

		ОбъектПроверки = РеквизитФормыВЗначение("Объект");
		ОбъектПроверки.УстановитьНастройки(ПлановыйУчет, ВознаграждениеКакПассив, КомиссииКакПассив, НДФЛКакПассив,
			РазмерПачки);
		Если Шаг.Вариант = "1.07" Тогда
			Шаг.Результат = ОбъектПроверки.РасчетВерсии107(Соединение, МассивМандатов, Мандаты, Стратегия,
				План.НачалоTWR, КонецПериода, Шаг.Особая);
		Иначе
			Шаг.Результат = ОбъектПроверки.РасчетВерсии108(Соединение, МассивМандатов, Мандаты, Стратегия,
				План.НачалоTWR, КонецПериода, Шаг.Особая);
		КонецЕсли;
	Исключение
		Шаг.Результат = Неопределено;
		Шаг.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Мандаты = Неопределено;
	МассивМандатов = Неопределено;
	Стратегия = Неопределено;
	Соединение = Неопределено;

	ПоместитьВоВременноеХранилище(План, АдресПлана);

КонецПроцедуры

// Записывает ошибку шага, если серверный вызов шага завершился исключением целиком.
//
// Параметры:
//  АдресПлана - Строка
//  Номер      - Число
//  Текст      - Строка
//
&НаСервере
Процедура ЗаписатьОшибкуШага(АдресПлана, Номер, Текст)

	План = ПолучитьИзВременногоХранилища(АдресПлана);
	План.Шаги[Номер].Результат = Неопределено;
	План.Шаги[Номер].Ошибка = "Вызов прерван: " + Текст;
	ПоместитьВоВременноеХранилище(План, АдресПлана);

КонецПроцедуры

// Подключается к базе МО так же, как заполнение 0420431.
//
// Параметры:
//  База - СправочникСсылка.ВнешниеИнформационныеБазы
//
// Возвращаемое значение:
//  COMОбъект, Строка - соединение или текст ошибки подключения
//
&НаСервере
Функция СоединениеСМО(База)

	ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.СтруктураПараметровДляУстановкиВнешнегоСоединения();
	ЗаполнитьЗначенияСвойств(ПараметрыПодключения, База);
	СтруктураПодключения = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединение(ПараметрыПодключения);
	Если СтруктураПодключения.Соединение = Неопределено Тогда
		Возврат Строка(База) + ": " + СтруктураПодключения.ПодробноеОписаниеОшибки;
	КонецЕсли;
	Возврат СтруктураПодключения.Соединение;

КонецФункции

// Группирует состав по стратегиям, убирает дубли мандатов и берет не больше РазмерВыборки мандатов
// с наибольшим числом дней оценки.
//
// Параметры:
//  Соединение - COMОбъект
//  Состав     - ТаблицаЗначений - результат ПрочитатьСостав
//
// Возвращаемое значение:
//  Массив из Структура - Код, Наименование, Особая, СтратегияXML, МандатовСтратегии, ДнейСтратегии, МандатыXML
//
&НаСервере
Функция СтратегииДляПроверки(Соединение, Состав)

	ОтобранныеКоды = РазобратьКоды();
	Группы = Новый Соответствие;

	Для Каждого СтрокаСостава Из Состав Цикл
		Группа = Группы.Получить(СтрокаСостава.Код);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура;
			Группа.Вставить("Код", СтрокаСостава.Код);
			Группа.Вставить("Наименование", СтрокаСостава.Наименование);
			Группа.Вставить("СтратегияXML", "");
			Группа.Вставить("Строки", Новый ТаблицаЗначений);
			Группа.Строки.Колонки.Добавить("Ключ");
			Группа.Строки.Колонки.Добавить("Дней", Новый ОписаниеТипов("Число"));
			Группа.Вставить("Ключи", Новый Соответствие);
			Группы.Вставить(СтрокаСостава.Код, Группа);
		КонецЕсли;

		Ключ = Соединение.XMLСтрока(СтрокаСостава.Мандат);
		Если Группа.Ключи.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Группа.Ключи.Вставить(Ключ, Истина);
		НоваяСтрока = Группа.Строки.Добавить();
		НоваяСтрока.Ключ = Ключ;
		НоваяСтрока.Дней = СтрокаСостава.Дней;
		Если Группа.СтратегияXML = "" И ТипЗнч(СтрокаСостава.Стратегия) <> Тип("Строка") Тогда
			КлючСтратегии = Соединение.XMLСтрока(СтрокаСостава.Стратегия);
			Если КлючСтратегии <> "00000000-0000-0000-0000-000000000000" Тогда
				Группа.СтратегияXML = КлючСтратегии;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого КлючИГруппа Из Группы Цикл
		Группа = КлючИГруппа.Значение;
		Мандатов = Группа.Строки.Количество();
		Если ОтобранныеКоды.Количество() > 0 Тогда
			Если ОтобранныеКоды.Получить(ВРег(Группа.Код)) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли ТолькоКрупнееВыборки И Мандатов <= РазмерПачки Тогда
			Продолжить;
		КонецЕсли;

		Группа.Строки.Сортировать("Дней Убыв");
		ДнейСтратегии = Группа.Строки.Итог("Дней");
		МандатыXML = Новый Массив;
		Для Индекс = 0 По Мин(РазмерВыборки, Мандатов) - 1 Цикл
			МандатыXML.Добавить(Группа.Строки[Индекс].Ключ);
		КонецЦикла;

		Описание = Новый Структура;
		Описание.Вставить("Код", Группа.Код);
		Описание.Вставить("Наименование", Группа.Наименование);
		Описание.Вставить("Особая", ОсобаяСтратегия(Группа.Код));
		Описание.Вставить("СтратегияXML", Группа.СтратегияXML);
		Описание.Вставить("МандатовСтратегии", Мандатов);
		Описание.Вставить("ДнейСтратегии", ДнейСтратегии);
		Описание.Вставить("МандатыXML", МандатыXML);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сводит шаги плана по стратегиям, сравнивает доходность 1.07 и 1.08 по каждому мандату и выводит таблицу.
//
// Параметры:
//  АдресПлана          - Строка
//  КоличествоДоговоров - Число
//
&НаСервере
Процедура СформироватьОтчет(АдресПлана, КоличествоДоговоров)

	План = ПолучитьИзВременногоХранилища(АдресПлана);
	Итоги = НоваяТаблицаИтогов();
	СтрокиПоСтратегиям = Новый Соответствие;

	Для Каждого Шаг Из План.Шаги Цикл
		КлючСтратегии = Шаг.ИмяБазы + "|" + Шаг.Код;
		Итог = СтрокиПоСтратегиям.Получить(КлючСтратегии);
		Если Итог = Неопределено Тогда
			Итог = Итоги.Добавить();
			Итог.База = Шаг.ИмяБазы;
			Итог.Код = Шаг.Код;
			Итог.Наименование = Шаг.Наименование;
			Итог.Особая = Шаг.Особая;
			Итог.Мандатов = Шаг.МандатовСтратегии;
			Итог.ВПроверке = Шаг.МандатыXML.Количество();
			СтрокиПоСтратегиям.Вставить(КлючСтратегии, Итог);
		КонецЕсли;

		Если Шаг.Вариант = "1.07" Тогда
			Итог.Ошибка107 = Шаг.Ошибка;
			Если Шаг.Результат <> Неопределено Тогда
				Итог.СтрокTWR = Шаг.Результат.СтрокTWR;
				Итог.СекTWR107 = Шаг.Результат.СекTWR;
				Итог.СекСбора107 = Шаг.Результат.СекСбора;
				Итог.Сек107 = Шаг.Результат.СекTWR + Шаг.Результат.СекСбора;
				Итог.Доходности107 = Шаг.Результат.Доходности;
			КонецЕсли;
		Иначе
			Итог.Ошибка108 = Шаг.Ошибка;
			Если Шаг.Результат <> Неопределено Тогда
				Итог.Пачек = Шаг.Результат.Пачек;
				Итог.Сек108 = Шаг.Результат.Сек;
				Итог.Доходности108 = Шаг.Результат.Доходности;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Итог Из Итоги Цикл
		СравнитьДоходность(Итог);
		Если Итог.ВПроверке > 0 И Итог.Сек108 > 0 Тогда
			Итог.ОценкаСек108 = Итог.Сек108 / Итог.ВПроверке * Итог.Мандатов;
		КонецЕсли;
		Если Итог.СтрокTWR > 0 Тогда
			Итог.ОценкаМБ107 = ОценкаПамятиМБ(Итог.СтрокTWR);
			Итог.ОценкаМБ108 = ОценкаПамятиМБ(Итог.СтрокTWR / Итог.ВПроверке * Мин(РазмерПачки, Итог.ВПроверке));
		КонецЕсли;
	КонецЦикла;

	ВывестиОтчет(Итоги, КоличествоДоговоров, План.НачалоTWR);
	УдалитьИзВременногоХранилища(АдресПлана);

КонецПроцедуры

// Сравнивает доходность мандатов 1.07 и 1.08. Расхождение - любое отличие значения, без округления.
//
// Параметры:
//  Итог - СтрокаТаблицыЗначений - строка итогов стратегии
//
&НаСервере
Процедура СравнитьДоходность(Итог)

	Если Итог.Доходности107 = Неопределено Или Итог.Доходности108 = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Итог.Доходности108 Цикл
		Новая = КлючИЗначение.Значение;
		Старая = Итог.Доходности107.Получить(КлючИЗначение.Ключ);
		Если Старая = Неопределено Тогда
			Старая = 0;
		КонецЕсли;
		Итог.Сравнено = Итог.Сравнено + 1;
		Итог.Сумма107 = Итог.Сумма107 + Старая;
		Итог.Сумма108 = Итог.Сумма108 + Новая;
		Если Старая <> 0 Тогда
			Итог.Ненулевых = Итог.Ненулевых + 1;
		КонецЕсли;
		Разница = Макс(Старая - Новая, Новая - Старая);
		Если Разница <> 0 Тогда
			Итог.Расхождений = Итог.Расхождений + 1;
			Итог.МаксРазница = Макс(Итог.МаксРазница, Разница);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Оценка памяти вызова по замерам стенда: 50 МБ постоянной части и 6,1 КБ на строку результата TWR.
//
// Параметры:
//  КоличествоСтрок - Число
//
// Возвращаемое значение:
//  Число - мегабайты
//
&НаСервере
Функция ОценкаПамятиМБ(КоличествоСтрок)

	Возврат 50 + КоличествоСтрок * 6.1 / 1024;

КонецФункции

&НаСервере
Функция НоваяТаблицаИтогов()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("База");
	Таблица.Колонки.Добавить("Код");
	Таблица.Колонки.Добавить("Наименование");
	Таблица.Колонки.Добавить("Особая");
	Для Каждого Имя Из СтрРазделить("Мандатов,ВПроверке,СтрокTWR,СекTWR107,СекСбора107,Сек107,Пачек,Сек108,"
		+ "ОценкаСек108,ОценкаМБ107,ОценкаМБ108,Сравнено,Ненулевых,Расхождений,МаксРазница,Сумма107,Сумма108", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Число"));
	КонецЦикла;
	Таблица.Колонки.Добавить("Доходности107");
	Таблица.Колонки.Добавить("Доходности108");
	Таблица.Колонки.Добавить("Ошибка107", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Ошибка108", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;

КонецФункции

&НаСервере
Процедура ВывестиОтчет(Итоги, КоличествоДоговоров, НачалоTWR)

	Итоги.Сортировать("ВПроверке Убыв");
	Таб = Новый ТабличныйДокумент;

	Таб.Область(1, 1).Текст = "Верификация расчета TWR формы 431: версия 1.07 (один вызов TWR) и версия 1.08 (пачки).";
	Таб.Область(2, 1).Текст = "Период отчета " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy") + ". В TWR передано " + Формат(НачалоTWR, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy") + ".";
	Таб.Область(3, 1).Текст = "Договоров в отборе формы 431: " + Формат(КоличествоДоговоров, "ЧГ=0; ЧН=0")
		+ ". Учет: " + ?(ПлановыйУчет, "плановый", "фактический")
		+ ". Вознаграждение как пассив: " + ДаНет(ВознаграждениеКакПассив)
		+ ", комиссии как пассив: " + ДаНет(КомиссииКакПассив)
		+ ", НДФЛ как пассив: " + ДаНет(НДФЛКакПассив) + ".";
	Таб.Область(4, 1).Текст = "По каждой стратегии не больше " + Формат(РазмерВыборки, "ЧГ=0")
		+ " мандатов с наибольшим числом дней оценки. Оба расчета получают одни и те же мандаты."
		+ " Сначала 1.08 (пачки по " + Формат(РазмерПачки, "ЧГ=0") + "), затем 1.07, каждый отдельным серверным вызовом.";
	Таб.Область(5, 1).Текст = "Расхождение - любое отличие доходности мандата, без округления."
		+ " Время - расчет без подключения к МО. Память не измерялась: оценка по замерам стенда (50 МБ + 6,1 КБ на строку TWR).";

	НомерСтроки = 7;
	Заголовки = СтрРазделить("База|Код|Наименование|Особая|Мандатов|В проверке|Строк TWR|1.07 сек TWR|1.07 сек сбора"
		+ "|1.07 сек всего|1.08 пачек|1.08 сек всего|1.08 / 1.07|Сравнено мандатов|Ненулевых|Расхождений|Макс разница"
		+ "|Сумма 1.07|Сумма 1.08|Оценка МБ 1.07|Оценка МБ пачки 1.08|Оценка сек 1.08 на всю стратегию"
		+ "|Ошибка 1.07|Ошибка 1.08", "|");
	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Таб.Область(НомерСтроки, Индекс + 1).Текст = Заголовки[Индекс];
	КонецЦикла;

	Для Каждого Итог Из Итоги Цикл
		НомерСтроки = НомерСтроки + 1;
		Значения = Новый Массив;
		Значения.Добавить(Итог.База);
		Значения.Добавить(Итог.Код);
		Значения.Добавить(Итог.Наименование);
		Значения.Добавить(?(Итог.Особая, "да", ""));
		Значения.Добавить(Формат(Итог.Мандатов, "ЧГ=0; ЧН=0"));
		Значения.Добавить(Формат(Итог.ВПроверке, "ЧГ=0; ЧН=0"));
		Значения.Добавить(Формат(Итог.СтрокTWR, "ЧГ=0; ЧН=0"));
		Значения.Добавить(Формат(Итог.СекTWR107, "ЧДЦ=1; ЧН=0"));
		Значения.Добавить(Формат(Итог.СекСбора107, "ЧДЦ=1; ЧН=0"));
		Значения.Добавить(Формат(Итог.Сек107, "ЧДЦ=1; ЧН=0"));
		Значения.Добавить(Формат(Итог.Пачек, "ЧГ=0; ЧН=0"));
		Значения.Добавить(Формат(Итог.Сек108, "ЧДЦ=1; ЧН=0"));
		Значения.Добавить(?(Итог.Сек107 > 0, Формат(Итог.Сек108 / Итог.Сек107, "ЧДЦ=2"), ""));
		Значения.Добавить(Формат(Итог.Сравнено, "ЧГ=0; ЧН=0"));
		Значения.Добавить(Формат(Итог.Ненулевых, "ЧГ=0; ЧН=0"));
		Значения.Добавить(Формат(Итог.Расхождений, "ЧГ=0; ЧН=0"));
		Значения.Добавить(Формат(Итог.МаксРазница, "ЧДЦ=10; ЧН=0"));
		Значения.Добавить(Формат(Итог.Сумма107, "ЧДЦ=6; ЧН=0"));
		Значения.Добавить(Формат(Итог.Сумма108, "ЧДЦ=6; ЧН=0"));
		Значения.Добавить(Формат(Итог.ОценкаМБ107, "ЧДЦ=0; ЧН=0"));
		Значения.Добавить(Формат(Итог.ОценкаМБ108, "ЧДЦ=0; ЧН=0"));
		Значения.Добавить(Формат(Итог.ОценкаСек108, "ЧДЦ=0; ЧН=0"));
		Значения.Добавить(Итог.Ошибка107);
		Значения.Добавить(Итог.Ошибка108);
		Для Индекс = 0 По Значения.ВГраница() Цикл
			Таб.Область(НомерСтроки, Индекс + 1).Текст = Значения[Индекс];
		КонецЦикла;
	КонецЦикла;

	НомерСтроки = НомерСтроки + 2;
	Таб.Область(НомерСтроки, 1).Текст = "Выводы";
	Для Каждого Итог Из Итоги Цикл
		НомерСтроки = НомерСтроки + 1;
		Таб.Область(НомерСтроки, 1).Текст = ТекстВывода(Итог);
	КонецЦикла;

	ТаблицаОтчета = Таб;

КонецПроцедуры

&НаСервере
Функция ТекстВывода(Итог)

	Текст = Итог.Код + " (" + Итог.База + ")" + ?(Итог.Особая, ", особая стратегия", "")
		+ ": проверено " + Формат(Итог.ВПроверке, "ЧГ=0; ЧН=0") + " из " + Формат(Итог.Мандатов, "ЧГ=0; ЧН=0")
		+ " мандатов. ";

	Если ЗначениеЗаполнено(Итог.Ошибка108) Тогда
		Текст = Текст + "1.08 не выполнена: " + Итог.Ошибка108 + ". ";
	Иначе
		Текст = Текст + "1.08: " + Формат(Итог.Сек108, "ЧДЦ=1; ЧН=0") + " с, пачек " + Формат(Итог.Пачек, "ЧГ=0") + ". ";
	КонецЕсли;

	Если ЗначениеЗаполнено(Итог.Ошибка107) Тогда
		Текст = Текст + "1.07 не выполнена: " + Итог.Ошибка107 + ". Сравнение доходности невозможно.";
		Возврат Текст;
	КонецЕсли;
	Текст = Текст + "1.07: " + Формат(Итог.Сек107, "ЧДЦ=1; ЧН=0") + " с, строк TWR " + Формат(Итог.СтрокTWR, "ЧГ=0; ЧН=0") + ". ";

	Если ЗначениеЗаполнено(Итог.Ошибка108) Тогда
		Возврат Текст + "Сравнение доходности невозможно.";
	КонецЕсли;

	Если Итог.Расхождений = 0 Тогда
		Текст = Текст + "Доходность совпала у всех " + Формат(Итог.Сравнено, "ЧГ=0; ЧН=0") + " мандатов.";
	Иначе
		Текст = Текст + "РАСХОЖДЕНИЕ доходности у " + Формат(Итог.Расхождений, "ЧГ=0") + " мандатов из "
			+ Формат(Итог.Сравнено, "ЧГ=0") + ", максимум " + Формат(Итог.МаксРазница, "ЧДЦ=10") + ".";
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Собирает текст лога из таблицы отчета и кладет файл во временное хранилище формы.
//
// Возвращаемое значение:
//  Структура:
//   * Адрес    - Строка - адрес двоичных данных файла
//   * ИмяФайла - Строка - предлагаемое имя файла
//
&НаСервере
Функция ФайлЛогаНаСервере()

	Строки = Новый Массив;
	Строки.Добавить("Верификация расчета TWR формы 431 (1.07 и 1.08)");
	Строки.Добавить("Сформирован: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'")
		+ "; пользователь: " + ИмяПользователя());
	Строки.Добавить("Параметры: период " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy")
		+ "; УК: " + Строка(УправляющаяКомпания)
		+ "; база МО: " + ?(ЗначениеЗаполнено(БазаМО), Строка(БазаМО), "по умолчанию")
		+ "; мандатов в проверке: " + Формат(РазмерВыборки, "ЧГ=0")
		+ "; пачка 1.08: " + Формат(РазмерПачки, "ЧГ=0")
		+ "; коды: " + ?(ЗначениеЗаполнено(КодыСтратегий), КодыСтратегий, "стратегии крупнее пачки")
		+ "; плановый учет: " + ДаНет(ПлановыйУчет));
	Строки.Добавить("");

	Для НомерСтроки = 1 По ТаблицаОтчета.ВысотаТаблицы Цикл
		Ячейки = Новый Массив;
		Для НомерКолонки = 1 По ТаблицаОтчета.ШиринаТаблицы Цикл
			Ячейки.Добавить(ТаблицаОтчета.Область(НомерСтроки, НомерКолонки).Текст);
		КонецЦикла;
		Строки.Добавить(СокрП(СтрСоединить(Ячейки, Символы.Таб)));
	КонецЦикла;

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Строки, Символы.ВК + Символы.ПС), КодировкаТекста.UTF8);
	Результат = Новый Структура;
	Результат.Вставить("Адрес", ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор));
	Результат.Вставить("ИмяФайла", "Верификация431_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt");
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПрочитатьСостав(Соединение, НомераДоговоров, НачалоTWR, КонецОкна)

	Номера = Соединение.NewObject("Массив");
	Для Каждого Номер Из НомераДоговоров Цикл
		Номера.Добавить(Номер);
	КонецЦикла;

	Запрос = Соединение.NewObject("Запрос");
	Запрос.Текст = ТекстЗапросаПоТипуУчета(ТекстЗапросаСостава());
	Запрос.УстановитьПараметр("НомераДоговоров", Номера);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ДатаНачала", НачалоTWR);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецОкна);
	Результат = Запрос.Выполнить().Выгрузить();

	Состав = Новый ТаблицаЗначений;
	Состав.Колонки.Добавить("Код");
	Состав.Колонки.Добавить("Наименование");
	Состав.Колонки.Добавить("Стратегия");
	Состав.Колонки.Добавить("Мандат");
	Состав.Колонки.Добавить("Дней", Новый ОписаниеТипов("Число"));

	Для Каждого СтрокаМО Из Результат Цикл
		Если Не ЗначениеЗаполнено(СтрокаМО.ИдентификаторСтратегии) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Состав.Добавить();
		НоваяСтрока.Код = СтрокаМО.ИдентификаторСтратегии;
		НоваяСтрока.Наименование = СтрокаМО.НаименованиеСтратегии;
		НоваяСтрока.Стратегия = СтрокаМО.Стратегия;
		НоваяСтрока.Мандат = СтрокаМО.Мандат;
		НоваяСтрока.Дней = СтрокаМО.Дней;
	КонецЦикла;

	СтрокаМО = Неопределено;
	Результат = Неопределено;
	Номера = Неопределено;
	Возврат Состав;

КонецФункции

&НаСервере
Функция ТекстЗапросаСостава()

	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Мандаты.Ссылка КАК Мандат,
	|	Мандаты.НомерДоговора КАК НомерДоговора,
	|	ДействующиеФинПланыСрезПоследних.ФинансовыйПлан КАК ФинансовыйПлан
	|ПОМЕСТИТЬ ВТ_ФинПлатыМандатов
	|ИЗ
	|	Справочник.Мандаты КАК Мандаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеФинПланы.СрезПоследних(&КонецПериода, Мандат.НомерДоговора В (&НомераДоговоров)) КАК ДействующиеФинПланыСрезПоследних
	|		ПО (ДействующиеФинПланыСрезПоследних.Мандат = Мандаты.Ссылка)
	|ГДЕ
	|	Мандаты.НомерДоговора В(&НомераДоговоров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,
	|	ВТ_ФинПлатыМандатов.НомерДоговора КАК НомерДоговора,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|		КОНЕЦ) КАК Стратегия
	|ПОМЕСТИТЬ ВТ_ИндивидуальныеСтратегииМандатов
	|ИЗ
	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий
	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ФинПлатыМандатов.НомерДоговора,
	|	ВТ_ФинПлатыМандатов.Мандат
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|		КОНЕЦ) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,
	|	ВЫБОР
	|		КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|			ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|		ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|	КОНЕЦ КАК Стратегия,
	|	ВЫБОР
	|		КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|			ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель.КодСтратегии
	|		ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия.КодСтратегии
	|	КОНЕЦ КАК ИдентификаторСтратегии,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Стратегии.НаименованиеАнгл, """") = """"
	|			ТОГДА ЕСТЬNULL(Стратегии.Наименование, """")
	|		ИНАЧЕ Стратегии.НаименованиеАнгл
	|	КОНЕЦ КАК НаименованиеСтратегии
	|ПОМЕСТИТЬ ВТ_СтрокиСостава
	|ИЗ
	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Стратегии КАК Стратегии
	|			ПО ФинансовыеПланыСоставСтратегий.Стратегия = Стратегии.Ссылка
	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка
	|ГДЕ
	|	НЕ ВТ_ФинПлатыМандатов.НомерДоговора В
	|				(ВЫБРАТЬ
	|					ВТ.НомерДоговора
	|				ИЗ
	|					ВТ_ИндивидуальныеСтратегииМандатов КАК ВТ)
	|	И НЕ (ЕСТЬNULL(Стратегии.Закрыта, ЛОЖЬ)
	|			И ЕСТЬNULL(Стратегии.ОтображатьНулевуюДоходность, ЛОЖЬ))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ИндивидуальныеСтратегииМандатов.Мандат,
	|	ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка),
	|	""IS-001"",
	|	""Индивидуальная стратегия""
	|ИЗ
	|	ВТ_ИндивидуальныеСтратегииМандатов КАК ВТ_ИндивидуальныеСтратегииМандатов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РыночнаяСтоимостьПозиции.Мандат КАК Мандат,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РыночнаяСтоимостьПозиции.Период) КАК Дней
	|ПОМЕСТИТЬ ВТ_ДниМандатов
	|ИЗ
	|	РегистрСведений.РыночнаяСтоимостьПозиции КАК РыночнаяСтоимостьПозиции
	|ГДЕ
	|	РыночнаяСтоимостьПозиции.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1) И &ДатаОкончания
	|	И РыночнаяСтоимостьПозиции.Мандат.НомерДоговора В (&НомераДоговоров)
	|СГРУППИРОВАТЬ ПО
	|	РыночнаяСтоимостьПозиции.Мандат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СтрокиСостава.ИдентификаторСтратегии КАК ИдентификаторСтратегии,
	|	ВТ_СтрокиСостава.НаименованиеСтратегии КАК НаименованиеСтратегии,
	|	ВТ_СтрокиСостава.Стратегия КАК Стратегия,
	|	ВТ_СтрокиСостава.Мандат КАК Мандат,
	|	ЕСТЬNULL(ВТ_ДниМандатов.Дней, 0) КАК Дней
	|ИЗ
	|	ВТ_СтрокиСостава КАК ВТ_СтрокиСостава
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДниМандатов КАК ВТ_ДниМандатов
	|		ПО ВТ_СтрокиСостава.Мандат = ВТ_ДниМандатов.Мандат";

КонецФункции

&НаСервере
Функция ТекстЗапросаПоТипуУчета(ТекстЗапроса)

	Если ПлановыйУчет Тогда
		Возврат СтрЗаменить(ТекстЗапроса, "РыночнаяСтоимостьПозиции", "РыночнаяСтоимостьПлановойПозиции");
	КонецЕсли;
	Возврат ТекстЗапроса;

КонецФункции

&НаСервере
Функция НомераДоговоровОтчета()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоговорДУ.Код КАК Код
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорДУ
	|ГДЕ
	|	ДоговорДУ.ТипКлиентаДУ В (&ТипыКлиентовДУ)
	|	И ДоговорДУ.УправляющаяКомпания = &УправляющаяКомпания
	|	И ДоговорДУ.ПометкаУдаления = ЛОЖЬ
	|	И ДоговорДУ.Код <> """"
	|	И ВЫБОР
	|			КОГДА &ИсключитьЦессии
	|				ТОГДА ДоговорДУ.ДатаЦессии = ДАТАВРЕМЯ(1, 1, 1)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И (ДоговорДУ.ДатаВводаСредствВДУ МЕЖДУ &НачалоПериода И &КонецПериода
	|				И ДоговорДУ.ДатаНачала <= &КонецПериода
	|				И (ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДоговорДУ.ДатаОкончания > &КонецПериода
	|					ИЛИ ДоговорДУ.ДатаОкончания МЕЖДУ ДоговорДУ.ДатаНачала И &КонецПериода)
	|			ИЛИ ДоговорДУ.ДатаОкончания <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаВводаСредствВДУ <> ДАТАВРЕМЯ(1, 1, 1)
	|				И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) <= &КонецПериода
	|				И КОНЕЦПЕРИОДА(ДоговорДУ.ДатаОкончания, ДЕНЬ) МЕЖДУ &НачалоПериода И &КонецПериода
	|				И ДоговорДУ.ДатаВводаСредствВДУ <= &КонецПериода
	|			ИЛИ (ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДоговорДУ.ДатаОкончания > &КонецПериода)
	|				И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) <= &КонецПериода
	|				И ДоговорДУ.ДатаВводаСредствВДУ <= &КонецПериода
	|				И ДоговорДУ.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаВводаСредствВДУ <> ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДоговорДУ.ДатаОкончания <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаОкончания < &НачалоПериода
	|				И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) < &НачалоПериода
	|				И ДоговорДУ.ДатаВводаСредствВДУ <= &НачалоПериода
	|				И ДоговорДУ.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаВводаСредствВДУ <> ДАТАВРЕМЯ(1, 1, 1))";

	Запрос.УстановитьПараметр("ТипыКлиентовДУ", ТипыКлиентовДУ());
	Запрос.УстановитьПараметр("УправляющаяКомпания", УправляющаяКомпания);
	Запрос.УстановитьПараметр("ИсключитьЦессии", ИсключитьЦессии);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код");

КонецФункции

&НаСервере
Функция ТипыКлиентовДУ()

	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.ФизическиеЛица);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.ЮридическиеЛица);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.СтраховыеКомпании);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.СобственныеСредстваСК);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.СаморегулируемыеОрганизации);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.ФондЦелевогоКапитала);
	Возврат МассивТипов;

КонецФункции

&НаСервере
Функция БазыМО()

	Базы = Новый Массив;
	Если ЗначениеЗаполнено(БазаМО) Тогда
		Базы.Добавить(БазаМО);
		Возврат Базы;
	КонецЕсли;

	Имена = Новый Массив;
	Имена.Добавить("PROD_AVC_MO");
	Имена.Добавить("PROD_AVC_Retail_MO");
	Для Каждого ИмяБазы Из Имена Цикл
		Ссылка = Справочники.ВнешниеИнформационныеБазы.НайтиПоНаименованию(ИмяБазы, Истина);
		Если Не Ссылка.Пустая() Тогда
			Базы.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Базы;

КонецФункции

&НаСервере
Функция РазобратьКоды()

	Коды = Новый Соответствие;
	Текст = СтрЗаменить(КодыСтратегий, ";", ",");
	Текст = СтрЗаменить(Текст, " ", ",");
	Части = СтрРазделить(Текст, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		Код = ВРег(СокрЛП(Часть));
		Если Код <> "" Тогда
			Коды.Вставить(Код, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Коды;

КонецФункции

&НаСервере
Функция ОсобаяСтратегия(Код)

	Возврат Код = "SS-010" Или Код = "SS-020" Или Код = "SS-030";

