Новый вариант процедуры СформироватьРегламентныеОперации с разбивкой СписокДоговоровДУ на пачки по 5000 договоров:
bsl// Вспомогательная процедура (добавьте её в модуль перед СформироватьРегламентныеОперации)
Процедура ОчиститьПакетныеДанныеПараметрыСохранения(ПараметрыСохранения)
	
	Если ТипЗнч(ПараметрыСохранения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	КлючиДляУдаления = Новый Массив;
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаВзаиморасчетов");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаКупонныхПериодов");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаОстатковНКД_УУ");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаОстатков");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаАктивовОблигаций");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаОстатковПоБанковскимСчетам");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаЦБ");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаОстатковОблигаций");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаОстатковУУ");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаКотировокБУ");
	КлючиДляУдаления.Добавить("СоответствиеДоговорТаблицаКотировокУУ");
	КлючиДляУдаления.Добавить("ТаблицаДефолтныеСобытияКотировокУУ");
	
	Для Каждого Ключ Из КлючиДляУдаления Цикл
		ПараметрыСохранения.Удалить(Ключ);
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьРегламентныеОперации(ПараметрыПроцедуры, АдресХранилищаРезультат) Экспорт // ASP-196537
	
	// Инициализация результата по умолчанию (неуспешное завершение)
	Результат = Новый Структура("Успешно, Сообщение", Ложь, НСтр("ru='Формирование регламентных операций не выполнено'"));
	
	Попытка
		
		// Валидация входных параметров (полностью сохранена из оригинала)
		Если Не ЗначениеЗаполнено(ПараметрыПроцедуры) Или ТипЗнч(ПараметрыПроцедуры) <> Тип("Структура") Тогда
			Результат.Сообщение = НСтр("ru='Не переданы параметры процедуры'");
			ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
			Возврат;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(АдресХранилищаРезультат) Тогда
			Результат.Сообщение = НСтр("ru='Не указан адрес хранилища результата'");
			ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
			Возврат;
		КонецЕсли;
		
		// Извлечение параметров
		ДатаПериода = Неопределено;
		СписокДоговоровДУ = Неопределено;
		УчитыватьВыполненные = Ложь;
		НаименованиеФоновогоЗадания = "";
		ПараметрыСохранения = Неопределено;
		
		ПараметрыПроцедуры.Свойство("ДатаПериода", ДатаПериода);
		ПараметрыПроцедуры.Свойство("СписокДоговоровДУ", СписокДоговоровДУ);
		ПараметрыПроцедуры.Свойство("УчитыватьВыполненные", УчитыватьВыполненные);
		ПараметрыПроцедуры.Свойство("НаименованиеФоновогоЗадания", НаименованиеФоновогоЗадания);
		ПараметрыПроцедуры.Свойство("ПараметрыСохранения", ПараметрыСохранения);
		
		// Проверка минимально необходимых данных
		Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
			Результат.Сообщение = НСтр("ru='Не указана дата регламентного периода'");
			ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
			Возврат;
		КонецЕсли;
		Если СписокДоговоровДУ = Неопределено Или ТипЗнч(СписокДоговоровДУ) <> Тип("Массив") Тогда
			Результат.Сообщение = НСтр("ru='Список договоров не передан или имеет неверный тип'");
			ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
			Возврат;
		КонецЕсли;
		Если СписокДоговоровДУ.Количество() = 0 Тогда
			Результат.Сообщение = НСтр("ru='Список договоров пуст'");
			ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
			Возврат;
		КонецЕсли;
		Если ПараметрыСохранения = Неопределено Или ТипЗнч(ПараметрыСохранения) <> Тип("Структура") Тогда
			Результат.Сообщение = НСтр("ru='Отсутствуют или некорректны параметры сохранения'");
			ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
			Возврат;
		КонецЕсли;
		
		// === РАЗБИВКА НА ПАЧКИ ПО 5000 ДОГОВОРОВ ===
		КоличествоДоговоров = СписокДоговоровДУ.Количество();
		ТекущийНомер = 0;
		РазмерПачки   = 5000;   // можно вынести в ПараметрыСохранения.РазмерПачкиФормирования
		
		Прогресс = Новый Структура("Процент, Текст", 0, "");
		
		// Подготовка параметров пакетной загрузки (один раз)
		МассивРодителей = Неопределено;
		ПараметрыСохранения.Свойство("МассивРодителей", МассивРодителей);
		
		ВыполнятьПакетнуюЗагрузку = Ложь;
		ГруппаОперацийПользователя = Неопределено;
		ДатаПроведения = Неопределено;
		
		Если ЗначениеЗаполнено(МассивРодителей) 
		   И ТипЗнч(МассивРодителей) = Тип("Массив") 
		   И МассивРодителей.Количество() = 1 Тогда
			
			ГруппаОперацийПользователя = МассивРодителей[0];
			
			Если ЗначениеЗаполнено(ГруппаОперацийПользователя) Тогда
				ДатаПроведения = Дата(Формат(ДатаПериода, "ДФ=""ггггММдд""") + Формат(ГруппаОперацийПользователя.ВремяРеглОпераций,"ДФ=""ЧЧммсс"""));
			Иначе
				ДатаПроведения = Дата(Формат(ДатаПериода, "ДФ=""ггггММдд""") + Формат(ПолныеПрава.ОкончаниеРабочегоДня(),"ДФ=""ЧЧммсс"""));
			КонецЕсли;
			
			ВыполнятьПакетнуюЗагрузку = Истина;
		КонецЕсли;
		
		// Цикл по пачкам
		Для ИндексПачки = 0 По Цел((КоличествоДоговоров - 1) / РазмерПачки) Цикл
			
			НачалоПачки = ИндексПачки * РазмерПачки;
			РазмерТекущейПачки = Мин(РазмерПачки, КоличествоДоговоров - НачалоПачки);
			
			Если РазмерТекущейПачки <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			СписокПачки = Новый Массив;
			Для i = 0 По РазмерТекущейПачки - 1 Цикл
				СписокПачки.Добавить(СписокДоговоровДУ[НачалоПачки + i]);
			КонецЦикла;
			
			// Очищаем пакетные данные предыдущей пачки (освобождаем память)
			ОчиститьПакетныеДанныеПараметрыСохранения(ПараметрыСохранения);
			
			// Пакетная предподготовка ТОЛЬКО для текущей пачки (Утренние / Вечерние)
			Если ВыполнятьПакетнуюЗагрузку Тогда
				
				Если ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПредварительныеЗапросыДляУтреннихРегламентов") = Истина Тогда
					Если ЗначениеЗаполнено(ГруппаОперацийПользователя) И ГруппаОперацийПользователя.Код = "1. ""Утренние"" операции" Тогда
						ЗаполнитьПараметрыСохраненияПакетнымиДаннымиУтреннихОпераций(ПараметрыСохранения, СписокПачки, ДатаПроведения);
					КонецЕсли;
				КонецЕсли;
				
				Если ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ИспользоватьПредварительныеЗапросыДляВечернихРегламентов") = Истина Тогда
					Если ЗначениеЗаполнено(ГруппаОперацийПользователя) И ГруппаОперацийПользователя.Код = "2. ""Вечерние"" операции" Тогда
						ЗаполнитьПараметрыСохраненияПакетнымиДаннымиВечернихОпераций(ПараметрыСохранения, СписокПачки, ДатаПроведения);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			// Обработка договоров текущей пачки
			Для Каждого ТекДоговор Из СписокПачки Цикл
				
				ТекущийНомер = ТекущийНомер + 1;
				
				Прогресс.Процент = ?(КоличествоДоговоров > 0,
					Окр(100 * (ТекущийНомер - 1) / КоличествоДоговоров), 0);
				
				Прогресс.Текст = СтрШаблон(
					НСтр("ru='Обработка договора %1 из %2: %3'"),
					ТекущийНомер, КоличествоДоговоров, ТекДоговор);
				
				ДлительныеОперации.СообщитьПрогресс(Прогресс.Процент, Прогресс.Текст);
				
				СформироватьДокументыЗакрытияПериода(
					ДатаПериода,
					ТекДоговор,
					УчитыватьВыполненные,
					НаименованиеФоновогоЗадания,
					ТекущийНомер,
					КоличествоДоговоров,
					ПараметрыСохранения);
				
			КонецЦикла;
			
		КонецЦикла;
		
		// Финальное сообщение
		ДлительныеОперации.СообщитьПрогресс(100, НСтр("ru='Формирование регламентных операций завершено'"));
		Результат.Успешно = Истина;
		Результат.Сообщение = "";
		
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru='Ошибка при формировании регламентных операций: %1'"), ОписаниеОшибки());
		Результат.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("РегламентныеОперации", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Результат, АдресХранилищаРезультат);
	
КонецПроцедуры
Что изменилось и почему это решает проблему:

Список договоров теперь разбивается на пачки по 5000 штук.
Пакетные процедуры (ЗаполнитьПараметрыСохраненияПакетнымиДаннымиУтреннихОпераций и ...ВечернихОпераций) вызываются только для текущей пачки — большие таблицы в памяти создаются максимум на 5000 договоров.
Перед каждой новой пачкой очищаются все ключи с пакетными данными (ОчиститьПакетныеДанныеПараметрыСохранения) — память от предыдущей пачки освобождается.
Прогресс-бар и логика фоновых заданий работают как раньше (по всему списку).
Остальной код модуля (включая СформироватьДокументыЗакрытияПериода и т.д.) не требует изменений.