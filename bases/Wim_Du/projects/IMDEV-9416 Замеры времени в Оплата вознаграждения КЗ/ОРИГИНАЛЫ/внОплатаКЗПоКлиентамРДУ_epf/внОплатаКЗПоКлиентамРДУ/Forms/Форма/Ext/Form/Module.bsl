Функция СформироватьНазначениеПлатежа(НачислениеНДФЛ = Ложь,ПоступлениеНаРасчетныйСчет = Ложь, ПрефиксДоговораДУ = "", Период = "")
	
	НазначениеПлатежа = "";
	Если ПоступлениеНаРасчетныйСчет Тогда
		НазначениеПлатежа = СтрШаблон("Вывод денежных средств с брокерского счета 30601810100012100828, субсчет 13W6XW, НДС не облагается %1", ПрефиксДоговораДУ);
	ИначеЕсли Не ПоступлениеНаРасчетныйСчет И НЕ НачислениеНДФЛ Тогда
		НазначениеПлатежа = СтрШаблон("Вознаграждение согластно п.3 Приложения № 2 Договора %1 от 15.12.2025г. НДС не облагается", ПрефиксДоговораДУ);
	ИначеЕсли Не ПоступлениеНаРасчетныйСчет И НачислениеНДФЛ Тогда                                                                                             
		НазначениеПлатежа = СтрШаблон("Единый налоговый платеж. НДФЛ удержанный при выплате дохода за %2 год по Договору %1 от 15.12.2025. НДС не облагается.", ПрефиксДоговораДУ, Период);
	КонецЕсли;
	
	Возврат НазначениеПлатежа;
	
