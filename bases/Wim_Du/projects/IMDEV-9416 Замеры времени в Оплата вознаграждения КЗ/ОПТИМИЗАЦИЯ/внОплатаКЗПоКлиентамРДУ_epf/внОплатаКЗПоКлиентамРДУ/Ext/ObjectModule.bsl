	|	ВТ_ГруппировкаДоки.СписаниеСРасчетногоСчета КАК СписаниеСРасчетногоСчета,
	|	ВТ_ГруппировкаДоки.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет,
	|	ВТ_АналитическиеСчетаГруппировка.ДоговорПриемник КАК ДоговорПриемник,
	|	ВТ_АналитическиеСчетаГруппировка.ДоговорИсточник КАК ДоговорИсточник,
	|	ВТ_Обязательства.ДоговорДУ.УправляющаяКомпания КАК УправляющаяКомпания,
	|	ВТ_Обязательства.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВТ_Обязательства.Контрагент КАК КонтрагентОснование,
	|	ВТ_Обязательства.ДоговорДУ.Префикс КАК ДоговорДУПрефикс,
	|	ВТ_Обязательства.СтавкаНДФЛ КАК СтавкаНДФЛ,
	|	ВТ_Обязательства.СчетКонтрагента КАК СчетКонтрагента,
	|	ВТ_Обязательства.НалоговыйПериод КАК НалоговыйПериод,
	|	ВТ_АналитическиеСчетаГруппировка.АналитическийСчетПриемник.МестоХранения КАК БанковскийСчет,
	|	ВТ_Обязательства.Контрагент КАК Контрагент,
	|	ВТ_АналитическиеСчетаГруппировка.АналитическийСчетИсточник.СубъектМестаХранения КАК КонтрагентПоступление,
	|	ВТ_БлокировкаДС.ДокументБлокировки КАК ДокументБлокировки
	|ИЗ
	|	ВТ_Обязательства КАК ВТ_Обязательства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АналитическиеСчетаГруппировка КАК ВТ_АналитическиеСчетаГруппировка
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Поручения КАК ВТ_Поручения
	|				ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГруппировкаДоки КАК ВТ_ГруппировкаДоки
	|				ПО ВТ_Поручения.Поручение = ВТ_ГруппировкаДоки.Поручение
	|			ПО ВТ_АналитическиеСчетаГруппировка.ДоговорДУ = ВТ_Поручения.ДоговорДУ
	|				И ВТ_АналитическиеСчетаГруппировка.АналитическийСчетИсточник = ВТ_Поручения.АналитическийСчетИсточник
	|				И ВТ_АналитическиеСчетаГруппировка.АналитическийСчетПриемник = ВТ_Поручения.АналитическийСчетПриемник
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БлокировкаДС КАК ВТ_БлокировкаДС
	|			ПО ВТ_АналитическиеСчетаГруппировка.ДоговорДУ = ВТ_БлокировкаДС.ДоговорДУ
	|				И ВТ_АналитическиеСчетаГруппировка.АналитическийСчетИсточник = ВТ_БлокировкаДС.АналитическийСчет
	|		ПО ВТ_Обязательства.ДоговорДУ = ВТ_АналитическиеСчетаГруппировка.ДоговорДУ
	|ГДЕ
	|	ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорДУ";
	

	Возврат ТекстЗапроса;
КонецФункции

Функция ПолучитьЗначенияДопСвойств(Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|   ДополнительныеСведения.Свойство,
	|   ЕСТЬNULL(ДополнительныеСведения.Значение, """") КАК Значение
	|ИЗ
	|   РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|   ДополнительныеСведения.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Объект);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьРазмерВознаграждения(ДоговорДУ, Дата, Базис, ЗначениеПараметраДоговораДУ = Неопределено)
    
    СоотВознаграждений = Новый Соответствие;
    
    ФиксСумма = Ложь;
	
	ВалютаРегламентированногоУчета = ОбщегоНазначенияДУ.ВалютаРеглУчета(ДоговорДУ);
    КурсКратностьРегл = МодульВалютногоУчета.ПолучитьКурсВалютыПоПортфелю(ДоговорДУ, ВалютаРегламентированногоУчета, Дата);
    
    МассивПараметровДоговораДУ = Новый Массив;
    МассивПараметровДоговораДУ.Добавить(ПланыВидовХарактеристик.ПараметрыДоговораДУ.ВеличинаВознагражденияУК);
    
    Для каждого СтрокаМассива из МассивПараметровДоговораДУ Цикл
        СоотВознаграждений.Вставить(СтрокаМассива, 0);
    КонецЦикла;
    
    Для каждого СтрокаМассива из МассивПараметровДоговораДУ Цикл
        Если ЗначениеПараметраДоговораДУ = Неопределено Тогда
            Значение = УправлениеПараметрамиДоговораДУ.ПолучитьПараметрДоговораДУ(ДоговорДУ, СтрокаМассива, Дата);
        Иначе
            Значение = ЗначениеПараметраДоговораДУ;
        КонецЕсли;
        
        // может у нас от старых доков просто число пришло
        Если ТипЗнч(Значение) = Тип("Число") Тогда
            СоотВознаграждений.Вставить(СтрокаМассива,Число(Значение));
            Продолжить;
        КонецЕсли;
        
        МассивИзСтрокЛесенки = УправлениеПараметрамиДоговораДУ.РазобратьЗначениеВознаграждения(Значение);
        
        Для каждого СтрокаЛесенки из МассивИзСтрокЛесенки Цикл
            
            Добавляем = Ложь;
            Прерываем = Ложь;
            
            Если СтрокаЛесенки.ТипСравнения = "<" Тогда
                Если Базис < СтрокаЛесенки.Значение Тогда
                    Добавляем = Истина;
                    Прерываем = Истина;										
                КонецЕсли;
            ИначеЕсли СтрокаЛесенки.ТипСравнения = ">=" Тогда
                Если Базис >= СтрокаЛесенки.Значение Тогда
                    Добавляем = Истина;
                    Прерываем = Ложь;		
                КонецЕсли;
            Иначе
                Если Базис > СтрокаЛесенки.Значение Тогда
                    Добавляем = Истина;
                    Прерываем = Ложь;		
                КонецЕсли;
            КонецЕсли;
            
            Если Добавляем Тогда
                Если СтрокаЛесенки.Суммой Тогда
                    
                    Если СтрокаЛесенки.Свойство("Валюта") и СтрокаЛесенки.Валюта <> Справочники.Валюты.RUB Тогда
                        КурсКратность = МодульВалютногоУчета.ПолучитьКурсВалютыПоПортфелю(ДоговорДУ, СтрокаЛесенки.Валюта, Дата);
                        
                        СуммаВознаграждения = Окр(МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(СтрокаЛесенки.РазмерВознаграждения,
                        СтрокаЛесенки.Валюта, Справочники.Валюты.RUB, 
                        КурсКратность.Курс, КурсКратностьРегл.Курс,
                        КурсКратность.Кратность, КурсКратностьРегл.Кратность), 2);
                    Иначе
                        СуммаВознаграждения = СтрокаЛесенки.РазмерВознаграждения;
                    КонецЕсли;
                    
                    СоотВознаграждений.Вставить(СтрокаМассива, Новый Структура("РазмерВознаграждения",СуммаВознаграждения));
                    
                Иначе
                    СоотВознаграждений.Вставить(СтрокаМассива, СтрокаЛесенки.РазмерВознаграждения);
                КонецЕсли;
            КонецЕсли;
            
            Если Прерываем Тогда
                Прервать;
            КонецЕсли;
            
        КонецЦикла;
        
    КонецЦикла;
    
    Возврат СоотВознаграждений;
    
КонецФункции 

Процедура СформироватьИОтправитьПисьмо(ВидРассылки = "Перевод", ОписаниеОшибки, ПутьКФайлу = "") Экспорт
	
	ТаблицаСтрок = ДанныеДляРассылки(ВидРассылки);
	Если ТаблицаСтрок.Количество() = 0 Тогда
		ОписаниеОшибки = ОписаниеОшибки + " Рассылка - " + ВидРассылки + ": не найдены данные для рассылки";
		Возврат;
	КонецЕсли;

	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность, Вложения");
	
	Макет = "ШаблонРассылки";
	ПараметрИтог = "СуммаИтого";
    КолонкаИтог  = "СуммаПоручения";
	ПериодФормат = Формат(Период,"ДФ=dd.MM.yyyy");
	
	Если ВидРассылки = "Перевод" Тогда
		ТемаПисьма = "Перевод с брокерского счета.Розничное ДУ";
	ИначеЕсли ВидРассылки = "Блокировка" Тогда
		Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
			ТемаПисьма = СтрШаблон("Коллеги, %1 произведена блокировка ДС по брокерским счетам договоров РДУ для оплаты вознаграждения НДФЛ",ПериодФормат);
		Иначе 
			ТемаПисьма = СтрШаблон("Коллеги, %1 произведена блокировка ДС по брокерским счетам договоров РДУ для оплаты вознаграждения УК");
		КонецЕсли;   
	Иначе	
		Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
			ТемаПисьма = СтрШаблон("Начисление НДФЛ Шаблон %1 от .",ПериодФормат);
		Иначе 
			ТемаПисьма = СтрШаблон("Оплата вознаграждения договоров розничного ДУ на собственный счет УК");
		КонецЕсли;   
	КонецЕсли;
	
	НомерРассылки = "0";
	
	ТелоПисьма = "";
	Вложения = Новый Структура;
	ФайлыКУдалению = Новый Массив;

	
	Если ТаблицаСтрок.Количество() > 0 И ВидРассылки = "Перевод" Тогда
		ТелоПисьма = СтрШаблон("Прошу подать поручение на перевод с брокерского счета 13W6XW на расчетный счет сумму в размере %1 рублей.", СуммаОбязательства);
	ИначеЕсли  ВидРассылки = "Блокировка" Тогда
		Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
			ТелоПисьма = СтрШаблон("Коллеги, %1 произведена блокировка ДС по брокерским счетам договоров РДУ для оплаты вознаграждения НДФЛ",ПериодФормат);
		Иначе 
			ТелоПисьма = СтрШаблон("Коллеги, %1 произведена блокировка ДС по брокерским счетам договоров РДУ для оплаты вознаграждения УК");
		КонецЕсли;   	
	Иначе
		
		Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
			ТелоПисьма = СтрШаблон("Прошу сформировать платежное поручение следующего образца для оплаты единого налогового платежа розничного ДУ на сумму %1 руб.", СуммаОбязательства);
		Иначе 
			ТелоПисьма = СтрШаблон("Прошу сформировать платежное поручение следующего образца для оплаты вознаграждения розничного ДУ на собственный счет УК на сумму %1 руб.", СуммаОбязательства);	 
		КонецЕсли;
		Вложения.Вставить("Отчет", ПутьКФайлу);
		ФайлыКУдалению.Добавить(ПутьКФайлу); 
	КонецЕсли;
	 
	Для Счетчик = 1 По 1000000 Цикл
		а = 1;
	КонецЦикла;
	ПараметрыПисьма.Вложения = Вложения;
	
	Кому = Новый Массив;
	ОтборКонтактов = ОтборКонтактов(ВидРассылки);
	Для каждого ТекЯщик из СписокРассылки Цикл
		Если ТекЯщик.Мидлофис И ТекЯщик.Отправлять И (ВидРассылки = "Перевод" ИЛИ ВидРассылки = "Блокировка") Тогда
			Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление)); 
		ИначеЕсли ТекЯщик.Сеттелмент И НЕ ВидРассылки = "Перевод" И ТекЯщик.Отправлять Тогда 	
			Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление)); 
		КонецЕсли;
	КонецЦикла;
	
	ФлагРезультатаВТеме = "{OK} ";
	
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ФлагРезультатаВТеме + " Аванкор ДУ: "+ ТемаПисьма + ПропискаРассылки(НомерРассылки);
	ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
	ПараметрыПисьма.Тело = ТелоПисьма;
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;

	Для Счетчик = 1 По 1000000 Цикл
		а = 1;
	КонецЦикла;    
	
	РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
	
	Если НЕ ВидРассылки = "Перевод" Тогда
		РассылкаОтправлена = Истина;
	КонецЕсли;  
	
	Для каждого ФайлКУдалению Из ФайлыКУдалению Цикл
		УдалитьФайлы(ФайлКУдалению);
	КонецЦикла;

КонецПроцедуры

Функция ДанныеДляРассылки(ВидРассылки)

	ДанныеДляРассылки = Новый ТаблицаЗначений;
	ДанныеДляРассылки.Колонки.Добавить("ДоговорДУ");
	ДанныеДляРассылки.Колонки.Добавить("СуммаПоручения");
	ДанныеДляРассылки.Колонки.Добавить("ПоручениеПоДС");
	
	
	Если ВидРассылки = "Перевод" И СуммаПоручений = 0 ИЛИ СуммаОбязательства = 0 Тогда 
		Возврат ДанныеДляРассылки;	
	КонецЕсли;
	
	ПоручениеДляРассылки = ДанныеДляРассылки.Добавить();
	ПоручениеДляРассылки.ДоговорДУ = ВидДокументаОснования;
	ПоручениеДляРассылки.ПоручениеПоДС 	= СуммаПоручений;
	ПоручениеДляРассылки.СуммаПоручения = СуммаПоручений;
	
	Возврат ДанныеДляРассылки;
	
КонецФункции

Функция ОтборКонтактов(ВидРассылки)

	ВидыРассылки = Новый Соответствие;
	ВидыРассылки.Вставить("ПереводСКомпенсацией", "Мидлофис");
	ВидыРассылки.Вставить("ПереводБезКомпенсации", "Мидлофис");
	ВидыРассылки.Вставить("Перевод", "Мидлофис");
	ВидыРассылки.Вставить("ВыводСКомпенсацией", "Сеттелмент");
	ВидыРассылки.Вставить("ВыводБезКомпенсации", "Сеттелмент");
	ВидыРассылки.Вставить("Вывод", "Сеттелмент");
	ВидыРассылки.Вставить("Ввод", "Сеттелмент");
	ВидыРассылки.Вставить("МатВыгода", "Финансы");
	ВидыРассылки.Вставить("Доход", "Финансы");
	
	Ключ = ВидыРассылки.Получить(ВидРассылки);
	ОтборКонтактов = Новый Структура(Ключ, Истина);
	
	Возврат ОтборКонтактов;

КонецФункции   

Функция ТелоПисьма(Заголовок, ТаблицаСтрок, ИмяМакета, КолонкаИтог, ПараметрИтог, ПутьКФайлуXLS)

	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет(ИмяМакета);
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	
	ОбластьШапка.Параметры.Заголовок = Заголовок;
	ТабДок.Вывести(ОбластьШапка);
	
	Для каждого СтрокаТаблицы Из ТаблицаСтрок Цикл
	
		ОбластьСтрока.Параметры.Заполнить(СтрокаТаблицы);
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ОбластьИтог.Параметры[ПараметрИтог] = ТаблицаСтрок.Итог(КолонкаИтог);
	ТабДок.Вывести(ОбластьИтог);
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла(".html");
	
	ТабДок.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.HTML);
	
	ТабДок.Записать(ПутьКФайлуXLS, ТипФайлаТабличногоДокумента.XLS);
	
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу);
	СтрHTML = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	УдалитьФайлы(ПутьКФайлу);
	
	Возврат СтрHTML;

КонецФункции

Функция ПропискаРассылки(Знач НомерРассылки) 
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции     

Процедура Пауза(Секунд) Экспорт 
	
	ПолноеИмяФайла = КаталогВременныхФайлов() + "sleep.vbs";
	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку("wscript.sleep wscript.arguments(0)");
	Текст.Записать(ПолноеИмяФайла, КодировкаТекста.OEM);
	
	WshShell =  Новый ComОбъект("Wscript.Shell");
	WshShell.Run("Wscript.exe"""+ПолноеИмяФайла+""" "+Секунд*1000,0,1);
	
КонецПроцедуры

Функция СформироватьШаблон() Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	ПериодФормат = Формат(Период,"ДФ=dd.MM.yyyy");
	Если ВидДокументаОснования = "НачислениеЗадолженности" Тогда
		Шаблон = ПолучитьМакет("ШаблонНДФЛ");
		ТемаПисьма = СтрШаблон("Начисление НДФЛ Шаблон от %1 ",ПериодФормат);
	Иначе 
		Шаблон = ПолучитьМакет("ШаблонВУК");
		ТемаПисьма = СтрШаблон("Начисление ВУК Шаблон от %1 ",ПериодФормат);
	КонецЕсли;    
	
	ИмяФайла = КаталогВременныхФайлов() + ТемаПисьма + ".docx";
	//ИмяФайла = ПолучитьИмяВременногоФайла(".docx");
	Шаблон.Записать(ИмяФайла);	
	
	ОбъектВорд = Новый COMОбъект("Word.Application");  
	ОбъектВорд.Documents.add(ИмяФайла); 

	ДокументВорд = ОбъектВорд.Application.Documents(1);
	ДокументВорд.Activate();
	
	СуммаОбязательстваСтрокой = Строка(СуммаОбязательства);
	СуммаОбязательстваСтрокой = СтрЗаменить(СуммаОбязательстваСтрокой,",","-");

	Если СтрНайти(СуммаОбязательстваСтрокой,"-") = 0 Тогда
		СуммаОбязательстваСтрокой = СуммаОбязательстваСтрокой + "-00"; 
	Иначе 
		ДлинаСтроки 		= СтрДлина(СуммаОбязательстваСтрокой); 
		СимволРазделения 	= СтрНайти(СуммаОбязательстваСтрокой,"-");
		Если ДлинаСтроки - СимволРазделения = 1 Тогда
			СуммаОбязательстваСтрокой = СуммаОбязательстваСтрокой + "0";
		КонецЕсли;
	КонецЕсли;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПараметрСумма", ?(ВидДокументаОснования = "НачислениеЗадолженности",СуммаОбязательстваСтрокой,СуммаОбязательства));
	СтруктураПараметров.Вставить("ПараметрСуммы", УстановитьСуммуПрописью(СуммаОбязательства));
    СтруктураПараметров.Вставить("ПараметрДата", ПериодФормат);

	Для Каждого Параметр Из СтруктураПараметров Цикл  
	    ДокументВорд.Content.Find.Execute(Параметр.Ключ,,,,,,,,,Параметр.Значение,2);
	КонецЦИкла;
	
	//Вынужденные паузы чтобы не было ошибки совместного доступа
	ДокументВорд.SaveAs(ИмяФайла);
	Для Счетчик = 1 По 1000000 Цикл
		а = 1;
	КонецЦикла;
	ОбъектВорд.Application.Quit(); 
	
	ОписаниеОшибки = "";
	
	СформироватьИОтправитьПисьмо("ОтправкаШаблона", ОписаниеОшибки, ИмяФайла); 
	
	ИзменитьСтатусВознагражденияПриИзмененииСтатусаПлатежногоПоручения();
			
	Возврат Неопределено;      
	
КонецФункции

Функция ВыполнитьЗамену(знач Object,Параметр,Значение)
	СтрокаПоиска = "["+Параметр+"]";
	СтрокаЗамены = Строка(Значение);
	Object.Select();
	Selection = Object.Application.Selection;
	FindObject = Selection.Find;
	FindObject.ClearFormatting();
	Пока  FindObject.Execute(строкапоиска) Цикл 
		Если ПустаяСтрока(СтрокаЗамены) Тогда
			selection.Delete();
		Иначе                  
			Selection.TypeText(СтрокаЗамены);
		КонецЕсли;	
	КонецЦИкла;	               
	Selection.Collapse();
КонецФункции

Функция УстановитьСуммуПрописью(Сумма)
	
	ВыводитьСуммуБезКопеек = Ложь;
	
	Валюта = Справочники.Валюты.RUB;
	Результат     = Сумма;
	ЦелаяЧасть    = Цел(Сумма);
	ФорматСтрока  = "Л=ru_RU; ДП=Ложь";
	ПарамПредмета = Валюта.ПараметрыПрописиНаРусском;
	
	Если Результат = ЦелаяЧасть Тогда
		Если ВыводитьСуммуБезКопеек Тогда
			Результат = ЧислоПрописью(Результат, ФорматСтрока, ПарамПредмета);
			Результат = Лев(Результат, Найти(Результат, "0") - 1);
		Иначе
			Результат = ЧислоПрописью(Результат, ФорматСтрока, ПарамПредмета);
		КонецЕсли;
	Иначе
		Результат = ЧислоПрописью(Результат, ФорматСтрока, ПарамПредмета);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Процедура ИзменитьСтатусВознагражденияПриИзмененииСтатусаПлатежногоПоручения(Отказ = Ложь) Экспорт
	
	Если Отказ Тогда Возврат; КонецЕсли;
	
	МассивИзмененныхДокументов = Новый Массив;
	Для Каждого Строка Из ДокументыКВыгрузке Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.ПорученияВМидл) Тогда
			 Продолжить;
		КонецЕсли;
		
		ДокументОснование = Строка.Основание;	
		
		Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
			Возврат;
		КонецЕсли; 
		
		Если ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.КонвертацияВалюты") 
			И ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.НачислениеВознаграждения") 
			И ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.НачислениеПроцентовОтСреднейСЧА") // ASP-80600
			И ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.НачислениеЗадолженности") 
			И ТипЗнч(ДокументОснование)<>Тип("ДокументСсылка.Поручение") Тогда
			Возврат;
		КонецЕсли; 
		
		ТекущийСтатус = РегистрыСведений.ИсторияСтатусовОбъектов.ПолучитьАктуальныйСтатусОбъекта(ДокументОснование);
		
		НовыйСтатус = Перечисления.СтатусыОбъектов.СформированоПлатежноеПоручение;
		
		Если НовыйСтатус <> ТекущийСтатус Тогда
			Попытка
				РегистрыСведений.ИсторияСтатусовОбъектов.СохранитьТекущийСтатусОбъекта(ДокументОснование, НовыйСтатус);	
				Если ТипЗнч(МассивИзмененныхДокументов) = Тип("Массив") Тогда
					МассивИзмененныхДокументов.Добавить(ДокументОснование);
				КонецЕсли;
			Исключение
				ТекстОтказа = НСтр("ru = 'Не удалось изменить статус документа %1 по причине: %2'");
				ТекстОтказа = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОтказа, ДокументОснование, ОписаниеОшибки()); 
				Отказ = Истина;
			КонецПопытки;
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры

#Область ФормированиеДокументов

// IMDEV-9416. Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВесОплатаКЗРДУ(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// IMDEV-9416. Описание: Формирует имя ключевой операции БСП для замера этапа оплаты КЗ РДУ.
//
// Параметры:
// ЭтапЗамера - Строка - этап замера (БлокировкаДС)
//
// Возвращаемое значение:
// Строка - имя ключевой операции ДУ.ОплатаКЗРДУ.<Этап>
//
Функция ПолучитьИмяКлючевойОперацииЗамераОплатаКЗРДУ(Знач ЭтапЗамера)
	
	Возврат "ДУ.ОплатаКЗРДУ." + ЭтапЗамера;
	
КонецФункции

Процедура СформироватьБлокировкуДенежныхСредств() Экспорт
		
	ДатаСеанса = ОбщегоНазначения.ДатаСеанса(); 
	ДатаДок = НачалоДня(НачалоДня(ДатаСеанса) - 1) + 60*60*9; 
	
	RUB 							= ПредопределенноеЗначение("Справочник.Валюты.RUB");
	ВидОперации 					= Перечисления.ВидыОперацийБлокировкаДС.Блокировка;
	
	// IMDEV-9416 ++
	КлючеваяОперация = ПолучитьИмяКлючевойОперацииЗамераОплатаКЗРДУ("БлокировкаДС");
	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	КоличествоКандидатов = 0;
	КоличествоСоздано = 0;
	КоличествоОшибок = 0;
	ДоговорыЗамера = Новый Соответствие;
	// IMDEV-9416 --

	Для каждого Строка Из ДокументыКВыгрузке Цикл
		
		ТекстОтказа = "";
		Отказ = Ложь;
		Если ЗначениеЗаполнено(Строка.Основание) И НЕ ЗначениеЗаполнено(Строка.ДокументБлокировки) Тогда
			// IMDEV-9416 ++
			КоличествоКандидатов = КоличествоКандидатов + 1;
			Если ЗначениеЗаполнено(Строка.ДоговорДУ) Тогда
				ДоговорыЗамера.Вставить(Строка.ДоговорДУ, Истина);
			КонецЕсли;
			// IMDEV-9416 --
			
			// Создание платежного поручения
			РеквизитыПП = Новый Структура();
			РеквизитыПП.Вставить("Основание",					 Строка.Основание);
			РеквизитыПП.Вставить("ДоговорДУ",  					 Строка.ДоговорДУ);
			РеквизитыПП.Вставить("АналитическийСчет",  			 Строка.АналитическийСчетИсточник);
			РеквизитыПП.Вставить("Валюта",  			 		 RUB);	
			РеквизитыПП.Вставить("ВидОперации",  			 	 ВидОперации);   
			РеквизитыПП.Вставить("ВалютнаяСумма",  			 	 Строка.СуммаБлокировки);
			РеквизитыПП.Вставить("Дата",  			 	 		 ДатаДок);

			Если  ТипЗнч(РеквизитыПП.Основание) = Тип("ДокументСсылка.НачислениеВознаграждения") Тогда
				РеквизитыПП.Вставить("ОбъектБлокировка",  Справочники.ОбъектыБлокировки.Вознаграждение); 
			ИначеЕсли ТипЗнч(РеквизитыПП.Основание) = Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
				РеквизитыПП.Вставить("ОбъектБлокировка",  Справочники.ОбъектыБлокировки.НДФЛ); 
			Иначе
				РеквизитыПП.Вставить("ОбъектБлокировка",  Справочники.ОбъектыБлокировки.ПустаяСсылка()); 
			КонецЕсли;	
			
			ДокументБлокировки = БлокировкаДенежныхСредствСоздатьЗаполнить(РеквизитыПП, Отказ, ТекстОтказа);
			           
			Если Не Отказ Тогда
				Строка.ДокументБлокировки = ДокументБлокировки;
				КоличествоСоздано = КоличествоСоздано + 1;
			Иначе
				Строка.Комментарий = ТекстОтказа;
				КоличествоОшибок = КоличествоОшибок + 1;
			КонецЕсли;
		Иначе
			Строка.Комментарий = Строка.Комментарий +"; Не создан документ блокировки";	
		КонецЕсли;
	
	КонецЦикла;
	
	// IMDEV-9416 ++
	Если ВремяНачалаЗамера > 0 Тогда
		КоличествоДоговоров = ДоговорыЗамера.Количество();
		ВесЗамера = ?(КоличествоДоговоров > 0, КоличествоДоговоров, ?(КоличествоКандидатов > 0, КоличествоКандидатов, 1));
		ОтказЗамера = КоличествоОшибок > 0;
		КомментарийЗамера = "Договоров=" + КоличествоДоговоров
			+ "; Кандидатов=" + КоличествоКандидатов
			+ "; Создано=" + КоличествоСоздано
			+ "; Ошибок=" + КоличествоОшибок
			+ "; ВидДокумента=" + ВидДокументаОснования
			+ "; Период=" + Формат(Период, "ДФ=dd.MM.yyyy")
			+ "; Отказ=" + ?(ОтказЗамера, "Да", "Нет")
			+ ДополнениеКомментарияУдельныйВесОплатаКЗРДУ(ВесЗамера, ВремяНачалаЗамера);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперация,
			ВремяНачалаЗамера,
			ВесЗамера,
			КомментарийЗамера,
			ОтказЗамера);
	КонецЕсли;
	// IMDEV-9416 --

КонецПроцедуры

Функция БлокировкаДенежныхСредствСоздатьЗаполнить(РеквизитыПП, Отказ, ТекстОтказа)
	
	Основание = РеквизитыПП.Основание;
	ОбъектБлокировкаРазблокировкаДС = Документы.БлокировкаРазблокировкаДС.ПустаяСсылка();
	
	Если Основание.Проведен = Ложь Тогда
		Отказ = Истина;
		ТекстОтказа = НСтр("ru = 'Документ основание: %1 не проведен. Поступленин на расчетный счет можно создать только на основании проведенного документа основания.'");
		ТекстОтказа = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОтказа, Основание);
	КонецЕсли;
	
	БлокировкаРазблокировкаДС = Документы.БлокировкаРазблокировкаДС.СоздатьДокумент();
	
	БлокировкаРазблокировкаДС.Основание 			= РеквизитыПП.Основание; 
	БлокировкаРазблокировкаДС.ДоговорДУ		    	= РеквизитыПП.ДоговорДУ;
	БлокировкаРазблокировкаДС.АналитическийСчет 	= РеквизитыПП.АналитическийСчет;
	БлокировкаРазблокировкаДС.Валюта 				= РеквизитыПП.Валюта;
	БлокировкаРазблокировкаДС.ВидОперации 			= РеквизитыПП.ВидОперации;
	БлокировкаРазблокировкаДС.ОбъектБлокировка 		= РеквизитыПП.ОбъектБлокировка; 
	БлокировкаРазблокировкаДС.Ответственный 		= Пользователи.ТекущийПользователь();	
	БлокировкаРазблокировкаДС.Дата 					= РеквизитыПП.Дата;
	БлокировкаРазблокировкаДС.ВалютнаяСумма 		= РеквизитыПП.ВалютнаяСумма;
	
 	Попытка
		БлокировкаРазблокировкаДС.Записать(РежимЗаписиДокумента.Проведение);
		ОбъектБлокировкаРазблокировкаДС = БлокировкаРазблокировкаДС.Ссылка;
	Исключение
		Отказ = Истина;
		ТекстОтказа =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось записать Блокировка разблокировка д/с по причине ""%1""'"),ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ОбъектБлокировкаРазблокировкаДС;

	
КонецФункции

#КонецОбласти

