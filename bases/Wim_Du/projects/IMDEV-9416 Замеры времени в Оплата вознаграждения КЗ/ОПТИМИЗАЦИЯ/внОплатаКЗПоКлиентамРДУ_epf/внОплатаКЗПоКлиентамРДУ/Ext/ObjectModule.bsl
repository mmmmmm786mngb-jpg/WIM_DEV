Функция ПолучитьТекстЗапроса()
	ТекстЗапроса = 
	
	"ВЫБРАТЬ
	|	АналитическиеСчета.ДоговорДУ КАК ДоговорДУ,
	|	АналитическиеСчета.Ссылка КАК АналитическийСчетИсточник,
	|	0 КАК АналитическийСчетПриемник,
	|	БанковскиеСчета.Ссылка КАК БанковскийСчет,
	|	АналитическиеСчета.ДоговорКонтрагента КАК ДоговорИсточник,
	|	0 КАК ДоговорПриемник
	|ПОМЕСТИТЬ Вт_АналитическиеСчета
	|ИЗ
	|	Справочник.АналитическиеСчета КАК АналитическиеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	|		ПО АналитическиеСчета.МестоХранения = БанковскиеСчета.Ссылка
	|ГДЕ
	|	АналитическиеСчета.ДоговорДУ В(&ДоговорДУ)
	|	И БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Брокерский)
	|	И БанковскиеСчета.ТранзитныйСчет = ЛОЖЬ
	|	И (БанковскиеСчета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ БанковскиеСчета.ДатаЗакрытия <> ДАТАВРЕМЯ(1, 1, 1)
	|				И БанковскиеСчета.ДатаЗакрытия >= &НачалоПериода)
	|	И АналитическиеСчета.ОткрытНаБирже
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АналитическиеСчета.ДоговорДУ,
	|	0,
	|	АналитическиеСчета.Ссылка,
	|	БанковскиеСчета.Ссылка,
	|	0,
	|	АналитическиеСчета.ДоговорКонтрагента
	|ИЗ
	|	Справочник.АналитическиеСчета КАК АналитическиеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	|		ПО АналитическиеСчета.МестоХранения = БанковскиеСчета.Ссылка
	|ГДЕ
	|	АналитическиеСчета.ДоговорДУ В(&ДоговорДУ)
	|	И БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Расчетный)
	|	И БанковскиеСчета.ТранзитныйСчет = ЛОЖЬ
	|	И (БанковскиеСчета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ БанковскиеСчета.ДатаЗакрытия <> ДАТАВРЕМЯ(1, 1, 1)
	|				И БанковскиеСчета.ДатаЗакрытия >= &НачалоПериода)
	|	И НЕ АналитическиеСчета.ОткрытНаБирже
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт_АналитическиеСчета.ДоговорДУ КАК ДоговорДУ,
	|	МАКСИМУМ(Вт_АналитическиеСчета.АналитическийСчетИсточник) КАК АналитическийСчетИсточник,
	|	МАКСИМУМ(Вт_АналитическиеСчета.АналитическийСчетПриемник) КАК АналитическийСчетПриемник,
	|	МАКСИМУМ(Вт_АналитическиеСчета.ДоговорПриемник) КАК ДоговорПриемник,
	|	МАКСИМУМ(Вт_АналитическиеСчета.ДоговорИсточник) КАК ДоговорИсточник
	|ПОМЕСТИТЬ ВТ_АналитическиеСчетаГруппировка
	|ИЗ
	|	Вт_АналитическиеСчета КАК Вт_АналитическиеСчета
	|
	|СГРУППИРОВАТЬ ПО
	|	Вт_АналитическиеСчета.ДоговорДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторияСтатусовОбъектовСрезПоследних.Объект КАК Объект
	|ПОМЕСТИТЬ ВТ_НовыйВознаграждения
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовОбъектов.СрезПоследних(&КонецПериода, ) КАК ИсторияСтатусовОбъектовСрезПоследних
	|ГДЕ
	|	ЕСТЬNULL(ИсторияСтатусовОбъектовСрезПоследних.Статус, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.Новый)
	|	И ТИПЗНАЧЕНИЯ(ИсторияСтатусовОбъектовСрезПоследних.Объект) = ТИП(Документ.НачислениеВознаграждения)
	|	И ВЫБОР
	|			КОГДА НЕ &НачислениеНДФЛ = ИСТИНА
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИсторияСтатусовОбъектовСрезПоследних.Объект
	|ИЗ
	|	РегистрСведений.ИсторияСтатусовОбъектов.СрезПоследних(&КонецПериода, ) КАК ИсторияСтатусовОбъектовСрезПоследних
	|ГДЕ
	|	ЕСТЬNULL(ИсторияСтатусовОбъектовСрезПоследних.Статус, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.Новый)
	|	И ТИПЗНАЧЕНИЯ(ИсторияСтатусовОбъектовСрезПоследних.Объект) = ТИП(Документ.НачислениеЗадолженности)
	|	И ВЫБОР
	|			КОГДА &НачислениеНДФЛ = ИСТИНА
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|	И ИсторияСтатусовОбъектовСрезПоследних.Объект.НалоговыйПериод = &НалоговыйПериод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтПлановаяПозиция.МестоХранения КАК МестоХранения,
	|	ВтПлановаяПозиция.РублевыйЭквивалент КАК РублевыйЭквивалент,
	|	ВтПлановаяПозиция.Остаток КАК Остаток,
	|	ВтПлановаяПозиция.РублевыйЭквивалентПлан КАК РублевыйЭквивалентПлан,
	|	ВтПлановаяПозиция.ПлановаяПозицияДС КАК ПлановаяПозицияДС,
	|	ВтПлановаяПозиция.Инструмент КАК Инструмент,
	|	ВтПлановаяПозиция.ДоговорДУ КАК ДоговорДУ,
	|	ВтПлановаяПозиция.СуммаРасчетныйСчет КАК СуммаРасчетныйСчет,
	|	ВтПлановаяПозиция.СуммаБрокерскийСчет КАК СуммаБрокерскийСчет,
	|	ВтОбязательства.СуммаОбязательства КАК СуммаОбязательства,
	|	ВтОбязательства.ВидДокументаОснования КАК ВидДокументаОснования,
	|	ВтОбязательства.Основание КАК Основание,
	|	ВтОбязательства.Контрагент КАК Контрагент,
	|	ВтОбязательства.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ВтОбязательства.СтавкаНДФЛ КАК СтавкаНДФЛ,
	|	ВтОбязательства.СчетКонтрагента КАК СчетКонтрагента,
	|	ВтОбязательства.НалоговыйПериод КАК НалоговыйПериод
	|ПОМЕСТИТЬ втСекция2
	|ИЗ
	|	(ВЫБРАТЬ
	|		ХозрасчетныйОстаткиИОбороты.ДоговорДУ КАК ДоговорДУ,
	|		ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстаток * -1 КАК СуммаОбязательства,
