Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид",ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка());
	ПараметрыРегистрации.Вставить("Наименование", "Оплата КЗ по клиентам РДУ");
	ПараметрыРегистрации.Вставить("Версия", Версия());
	ПараметрыРегистрации.Вставить("БезопасныйРежим",Ложь);
	ПараметрыРегистрации.Вставить("Информация","Оплата КЗ по клиентам РДУ");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд,
			"Оплата КЗ по клиентам РДУ",
			"ЗаполнитьНачислениями",
			"ОткрытиеФормы");
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

Функция Версия() Экспорт
	Возврат "2.1";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДоговорыКЗаполнению(ТекПериод)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорДУ.Ссылка КАК ДоговорДУ
		|ИЗ
		|	Справочник.ДоговорДУ КАК ДоговорДУ
		|ГДЕ
		|	ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|	И ДоговорДУ.ДатаНачала <= &Период
		|	И ДоговорДУ.ТипКлиентаДУ = &ТипКлиентаДУ
		|	И ДоговорДУ.Пул = &Пул
		|	И ИСТИНА
		|	И ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос.УстановитьПараметр("Период", КонецДня(ТекПериод));
	Запрос.УстановитьПараметр("Пул", Справочники.Пул.НайтиПоНаименованию("Розничное ДУ"));
	Запрос.УстановитьПараметр("ТипКлиентаДУ", Перечисления.ТипыКлиентовДУ.ФизическиеЛица);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	Возврат ВыборкаДетальныеЗаписи.ВыгрузитьКолонку("ДоговорДУ");
		
КонецФункции

Процедура ЗаполнитьНачислениями(ВидДокумента, ОтборПосуммам = Ложь) Экспорт
	
	ДокументыКВыгрузке.Очистить();
	
	Если Период = Дата(1,1,1) Тогда
		ТекПериод = ТекущаяДата();
	Иначе
		ТекПериод = Период;
	КонецЕсли;
	
	МассивДоговоров = ДоговорыКЗаполнению(ТекПериод);
	
	Запрос = Новый Запрос();
	//Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("НачДата", НачалоДня(ТекПериод));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ТекПериод));
    Запрос.УстановитьПараметр("КонецПериода", КонецДня(ТекПериод));
	Запрос.УстановитьПараметр("Период", КонецДня(ТекПериод));
	Запрос.УстановитьПараметр("ДоговорДУ", МассивДоговоров);
	Запрос.УстановитьПараметр("НачислениеНДФЛ", ?(ВидДокумента = "НачислениеЗадолженности", Истина,Ложь));
	Запрос.УстановитьПараметр("НачислениеВознаграждения", ?(ВидДокумента = "НачислениеВознаграждения", Истина,Ложь));
    Запрос.УстановитьПараметр("НалоговыйПериод", НалоговыйПериод);

	Запрос.Текст = ПолучитьТекстЗапроса();
	
	ПакетРезультатов = Запрос.Выполнить();
	
	Выборка = ПакетРезультатов.Выбрать();
	
	Пока Выборка.Следующий() Цикл  
		
		Если Выборка.СуммаОбязательства = 0  Тогда
			Продолжить
		КонецЕсли;
		
		Если ОтборПосуммам Тогда
			
			Если СравниватьСБрокерскимиСуммами = "БрокерскимСчетом" И (Выборка.СуммаБрокерскийСчет >= Выборка.СуммаОбязательства) Тогда 
				НоваяСтрока = ДокументыКВыгрузке.Добавить(); 
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);                                   
			ИначеЕсли СравниватьСБрокерскимиСуммами = "РасчетнымСчетом" И (Выборка.СуммаРасчетныйСчет >= Выборка.СуммаОбязательства) Тогда
				НоваяСтрока = ДокументыКВыгрузке.Добавить(); 
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);            
			ИначеЕсли СравниватьСБрокерскимиСуммами = "УчитыватьОстаткиНаБрокерскомСчете" И (Выборка.СуммаБрокерскийСчет <= Выборка.СуммаОбязательства) Тогда
				НоваяСтрока = ДокументыКВыгрузке.Добавить(); 
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
				НоваяСтрока.СуммаБлокировки = Выборка.СуммаОбязательства - Выборка.СуммаБрокерскийСчет; 
			ИначеЕсли СравниватьСБрокерскимиСуммами = "НеУчитыватьОстаткиНаБрокерскомСчете" Тогда
				НоваяСтрока = ДокументыКВыгрузке.Добавить(); 
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка); 
				НоваяСтрока.СуммаБлокировки = Выборка.СуммаОбязательства;
			КонецЕсли;
			
		Иначе
			НоваяСтрока = ДокументыКВыгрузке.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка); 	
		КонецЕсли;  
		
	КонецЦикла;

КонецПроцедуры     

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
	
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если ЗначениеЗаполнено(Настройки) Тогда 
		Если Настройки.Свойство("Значения") Тогда
			Если Не Настройки.Значения = Неопределено Тогда
				СтатьяЗатрат 		= Настройки.Значения.СтатьяЗатрат;
				СтатьяДДС 			= Настройки.Значения.СтатьяДДС;
				СчетРасчетов 		= Настройки.Значения.СчетРасчетов;
				НастрройкиНДФЛ 		= Настройки.Значения.НастрройкиНДФЛ; 
				НастройкиВУК 		= Настройки.Значения.НастройкиВУК; 
				Шаблоны 			= Настройки.Значения.Шаблоны; 
				НазначениеПлатежа 	= Настройки.Значения.НазначениеПлатежа;
				ПочтовыйЛогин 		= Настройки.Значения.ПочтовыйЛогин;
				СтатьяЗатратСписание= Настройки.Значения.СтатьяЗатратСписание; 
				СтатьяДДССписание 	= Настройки.Значения.СтатьяДДССписание;
				СчетРасчетовСписание= Настройки.Значения.СчетРасчетовСписание; 
				
				СтатьяЗатратСписаниеЗадолженность= Настройки.Значения.СтатьяЗатратСписаниеНДФЛ; 
				СтатьяДДССписаниеЗадолженность 	 = Настройки.Значения.СтатьяДДССписаниеНДФЛ;

				СписокРассылки.Загрузить(XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки).Получить()); 
			КонецЕсли;
		
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	УстановитьНастройки(ПараметрыВыполненияКоманды);
КонецПроцедуры

