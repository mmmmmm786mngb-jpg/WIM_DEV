
&НаКлиенте
Процедура Сформировать(Команда)
	Отчет.КонДата = КонецДня(Отчет.НачДата);
	СформироватьНаСервере();
	Отчет.Отчет.ТолькоПросмотр = ИСТИНА;
	//Отчет.Отчет.Показать("Сверка ценных бумаг");
КонецПроцедуры

&НаСервере
Функция СформироватьНаСервере()
	Объект = РеквизитФормыВЗначение("Отчет");
	ТабДок = Объект.ВыполнитьСверку();
	ЗначениеВРеквизитФормы(Объект, "Отчет");
КонецФункции


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Отчет");
	ОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор("a673508c-1950-11e4-9856-005056b100fc"));
	НастройкиОбработки = ОбработкаСсылка.ХранилищеНастроек.Получить();
	ПредставлениеНастроек = "";
	ОбработкаОбъект.УстановитьПользовательскиеНастройки(НастройкиОбработки, ПредставлениеНастроек);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Отчет");       
	
КонецПроцедуры

