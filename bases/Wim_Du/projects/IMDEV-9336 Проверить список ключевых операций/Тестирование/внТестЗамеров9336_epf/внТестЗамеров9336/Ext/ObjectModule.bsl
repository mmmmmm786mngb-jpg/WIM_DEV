// IMDEV-9336 ++
// Описание: Сведения для регистрации дополнительной обработки в БСП
//
// Возвращаемое значение:
// Структура - параметры регистрации внешней обработки
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", "Тест замеров IMDEV-9336 (без внешних соединений)");
	ПараметрыРегистрации.Вставить("Версия", "1.2-IMDEV-9336");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"IMDEV-9336: проверка замеров в СверкаЦБ и ОтрицательныеОстаткиНаАналитическомСчете через справочник доп. обработок БСП, нагрузочные данные из БД (без ADODB).");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, "Тест замеров 9336 (форма)", "ТестЗамеров9336", "ОткрытиеФормы");
	ДобавитьКоманду(ТаблицаКоманд, "Тест замеров 9336 (сервер)", "ВыполнитьТест", "ВызовСерверногоМетода");
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Описание: Запускает тест замеров обеих обработок и возвращает отчет
//
// Возвращаемое значение:
// Структура - Успех, Отказ, ТабДокумент, ТекстОшибки, РезультатыТестов
//
Функция СформироватьОтчетТеста() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Отказ", Ложь);
	Результат.Вставить("ТабДокумент", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("РезультатыТестов", Неопределено);
	
	Попытка
		ВыполнитьТестЗамеров();
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Отказ = Истина;
		Возврат Результат;
	КонецПопытки;
	
	Результат.РезультатыТестов = РезультатыТестов.Скопировать();
	Результат.Отказ = ЕстьСтрокиСОшибкой(РезультатыТестов);
	Результат.Успех = Не Результат.Отказ;
	Результат.ТабДокумент = ПостроитьТабличныйДокумент(РезультатыТестов);
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды = "ВыполнитьТест" Тогда
		СформироватьОтчетТеста();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

// IMDEV-9336: основной прогон - подключение двух доп. обработок из справочника БСП
Процедура ВыполнитьТестЗамеров()
	
	ИнициализироватьТаблицуРезультатов();
	МоментНачалаТеста = ТекущаяДатаСеанса();
	МинимумСтрок = ?(МинимальныйВесНагрузки > 0, МинимальныйВесНагрузки, 50);
	
	ПроверитьОбработку(
		"СверкаЦБ",
		ДопОбработкаСверкаЦБ,
		"ДУ.СверкаЦБ.Сверка.Тест9336",
		МинимумСтрок,
		"СтрокСверки",
		"Нагрузка=БД",
		МоментНачалаТеста);
	
	ПроверитьОбработку(
		"ОтрицательныеОстаткиНаАналитическомСчете",
		ДопОбработкаОтрицательныеОстатки,
		"ДУ.Сверка.ОтрицательныеОстаткиНаРС.ФормированиеОтчета.Тест9336",
		МинимумСтрок,
		"СтрокМинусов",
		"Нагрузка=БД",
		МоментНачалаТеста);
	
КонецПроцедуры

Процедура ПроверитьОбработку(ИмяОбработки, СсылкаДопОбработки, ОжидаемоеИмяКО, МинимальныйВес, МаркерКомментария, МаркерНагрузки, МоментНачалаТеста)
	
	СтрокаРезультата = РезультатыТестов.Добавить();
	СтрокаРезультата.Обработка = ИмяОбработки;
	СтрокаРезультата.ДопОбработка = ПредставлениеДопОбработки(СсылкаДопОбработки);
	СтрокаРезультата.ОжидаемоеИмяКО = ОжидаемоеИмяКО;
	СтрокаРезультата.Статус = "ERROR";
	
	Если Не ЗначениеЗаполнено(СсылкаДопОбработки) Тогда
		СтрокаРезультата.Сообщение = "Не указана доп. обработка в справочнике Дополнительные отчеты и обработки";
		Возврат;
	КонецЕсли;
	
	Попытка
		// IMDEV-9336: подключение через БСП, как при штатном запуске из справочника
		Обработка = ДополнительныеОтчетыИОбработки.ПолучитьОбъектВнешнейОбработки(СсылкаДопОбработки);
		Если Обработка = Неопределено Тогда
			СтрокаРезультата.Сообщение = "Не удалось подключить доп. обработку из справочника";
			Возврат;
		КонецЕсли;
		
		РезультатЗамера = Обработка.ТестЗамераПроизводительности(МинимальныйВес);
	Исключение
		СтрокаРезультата.Сообщение = ОписаниеОшибки();
		Возврат;
	КонецПопытки;
	
	СтрокаРезультата.ИмяКО = РезультатЗамера.ИмяКО;
	СтрокаРезультата.Вес = РезультатЗамера.Вес;
	СтрокаРезультата.Комментарий = РезультатЗамера.Комментарий;
	
	Если РезультатЗамера.Успех <> Истина Тогда
		СтрокаРезультата.Сообщение = ?(ЗначениеЗаполнено(РезультатЗамера.ТекстОшибки),
			РезультатЗамера.ТекстОшибки, "ТестЗамераПроизводительности вернул Успех=Ложь");
		Возврат;
	КонецЕсли;
	
	Если РезультатЗамера.ИмяКО <> ОжидаемоеИмяКО Тогда
		СтрокаРезультата.Сообщение = "Имя КО не совпало. Ожидалось: " + ОжидаемоеИмяКО
			+ "; получено: " + РезультатЗамера.ИмяКО;
		Возврат;
	КонецЕсли;
	
	Если РезультатЗамера.Вес < МинимальныйВес Тогда
		СтрокаРезультата.Сообщение = "Вес меньше минимума нагрузки. Ожидалось >= " + МинимальныйВес
			+ "; получено: " + РезультатЗамера.Вес;
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(РезультатЗамера.Комментарий, МаркерКомментария) = 0 Тогда
		СтрокаРезультата.Сообщение = "В комментарии нет маркера " + МаркерКомментария;
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(РезультатЗамера.Комментарий, МаркерНагрузки) = 0 Тогда
		СтрокаРезультата.Сообщение = "В комментарии нет маркера " + МаркерНагрузки;
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(РезультатЗамера.Комментарий, "Режим=Тест9336") = 0 Тогда
		СтрокаРезультата.Сообщение = "В комментарии нет маркера Режим=Тест9336";
		Возврат;
	КонецЕсли;
	
	ДанныеРС = НайтиЗамерВРегистре(ОжидаемоеИмяКО, МоментНачалаТеста);
	СтрокаРезультата.ЗамерВРС = ДанныеРС.Найден;
	СтрокаРезультата.ВремяВыполнения = ДанныеРС.ВремяВыполнения;
	СтрокаРезультата.ВесРС = ДанныеРС.ВесЗамера;
	СтрокаРезультата.КомментарийРС = ДанныеРС.Комментарий;
	
	Если ДанныеРС.Найден Тогда
		СтрокаРезультата.Статус = "OK";
		СтрокаРезультата.Сообщение = "Замер выполнен, запись в РС.ЗамерыВремени найдена";
	ИначеЕсли ЗамерыПроизводительностиДоступны() Тогда
		СтрокаРезультата.Статус = "WARN";
		СтрокаРезультата.Сообщение = "Код замера отработал, но запись в РС.ЗамерыВремени не найдена (возможно, замеры отключены в настройках)";
	Иначе
		СтрокаРезультата.Статус = "OK";
		СтрокаРезультата.Сообщение = "Код замера отработал; подсистема РС.ЗамерыВремени недоступна в конфигурации";
	КонецЕсли;
	
КонецПроцедуры

Функция ЗамерыПроизводительностиДоступны()
	
	Если Метаданные.РегистрыСведений.Найти("ЗамерыВремени") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("КлючевыеОперации") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// IMDEV-9336: поиск последней записи замера по имени ключевой операции
Функция НайтиЗамерВРегистре(ИмяКО, МоментНачалаТеста)
	
	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("ВремяВыполнения", 0);
	Результат.Вставить("ВесЗамера", 0);
	Результат.Вставить("Комментарий", "");
	
	Если Не ЗамерыПроизводительностиДоступны() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Замеры.ВремяВыполнения КАК ВремяВыполнения,
	|	Замеры.ВесЗамера КАК ВесЗамера,
	|	Замеры.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Замеры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючевыеОперации КАК КлючевыеОперации
	|		ПО Замеры.КлючеваяОперация = КлючевыеОперации.Ссылка
	|ГДЕ
	|	КлючевыеОперации.Наименование = &ИмяКО
	|	И Замеры.ДатаЗаписиЛокальная >= &МоментНачалаТеста
	|
	|УПОРЯДОЧИТЬ ПО
	|	Замеры.ДатаЗаписиЛокальная УБЫВ";
	
	Запрос.УстановитьПараметр("ИмяКО", ИмяКО);
	Запрос.УстановитьПараметр("МоментНачалаТеста", МоментНачалаТеста);
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Найден = Истина;
			Результат.ВремяВыполнения = Выборка.ВремяВыполнения;
			Результат.ВесЗамера = Выборка.ВесЗамера;
			Результат.Комментарий = Выборка.Комментарий;
		КонецЕсли;
	Исключение
		// IMDEV-9336: нет прав на чтение РС - не считаем это ошибкой теста кода замера
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ИнициализироватьТаблицуРезультатов()
	
	РезультатыТестов = Новый ТаблицаЗначений;
	РезультатыТестов.Колонки.Добавить("Обработка", Новый ОписаниеТипов("Строка"));
	РезультатыТестов.Колонки.Добавить("ДопОбработка", Новый ОписаниеТипов("Строка"));
	РезультатыТестов.Колонки.Добавить("ОжидаемоеИмяКО", Новый ОписаниеТипов("Строка"));
	РезультатыТестов.Колонки.Добавить("ИмяКО", Новый ОписаниеТипов("Строка"));
	РезультатыТестов.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	РезультатыТестов.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	РезультатыТестов.Колонки.Добавить("ЗамерВРС", Новый ОписаниеТипов("Булево"));
	РезультатыТестов.Колонки.Добавить("ВремяВыполнения", Новый ОписаниеТипов("Число"));
	РезультатыТестов.Колонки.Добавить("ВесРС", Новый ОписаниеТипов("Число"));
	РезультатыТестов.Колонки.Добавить("КомментарийРС", Новый ОписаниеТипов("Строка"));
	РезультатыТестов.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	РезультатыТестов.Колонки.Добавить("Сообщение", Новый ОписаниеТипов("Строка"));
	
КонецПроцедуры

Функция ЕстьСтрокиСОшибкой(ТаблицаРезультатов)
	
	Для Каждого СтрокаРезультата Из ТаблицаРезультатов Цикл
		Если СтрокаРезультата.Статус = "ERROR" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПостроитьТабличныйДокумент(ТаблицаРезультатов)
	
	ТабДок = Новый ТабличныйДокумент;
	Область = ТабДок.Область(1, 1, 1, 8);
	Область.Текст = "IMDEV-9336: тест замеров (без внешних соединений)";
	Область.Шрифт = Новый Шрифт(, 12, Истина);
	
	Строка = 3;
	Заголовки = "Обработка;Статус;Имя КО;Вес;Замер в РС;Время, с;Сообщение;Комментарий";
	МассивЗаголовков = СтрРазделить(Заголовки, ";");
	Для НомерКолонки = 1 По МассивЗаголовков.Количество() Цикл
		ТабДок.Область(Строка, НомерКолонки, Строка, НомерКолонки).Текст = МассивЗаголовков[НомерКолонки - 1];
		ТабДок.Область(Строка, НомерКолонки, Строка, НомерКолонки).Шрифт = Новый Шрифт(, , Истина);
	КонецЦикла;
	
	Для Каждого СтрокаРезультата Из ТаблицаРезультатов Цикл
		Строка = Строка + 1;
		ТабДок.Область(Строка, 1).Текст = СтрокаРезультата.Обработка;
		ТабДок.Область(Строка, 2).Текст = СтрокаРезультата.Статус;
		ТабДок.Область(Строка, 3).Текст = СтрокаРезультата.ИмяКО;
		ТабДок.Область(Строка, 4).Текст = Формат(СтрокаРезультата.Вес, "ЧГ=0");
		ТабДок.Область(Строка, 5).Текст = ?(СтрокаРезультата.ЗамерВРС, "Да", "Нет");
		ТабДок.Область(Строка, 6).Текст = Формат(СтрокаРезультата.ВремяВыполнения, "ЧЦ=10; ЧДЦ=3");
		ТабДок.Область(Строка, 7).Текст = СтрокаРезультата.Сообщение;
		ТабДок.Область(Строка, 8).Текст = СтрокаРезультата.Комментарий;
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Функция ПредставлениеДопОбработки(СсылкаДопОбработки)
	
	Если Не ЗначениеЗаполнено(СсылкаДопОбработки) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(СсылкаДопОбработки);
	
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
