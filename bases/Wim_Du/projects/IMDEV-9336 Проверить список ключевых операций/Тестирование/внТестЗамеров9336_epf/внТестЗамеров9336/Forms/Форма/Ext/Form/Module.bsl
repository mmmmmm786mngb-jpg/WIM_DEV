#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	
	// IMDEV-9336: доработанные обработки хранятся в справочнике доп. отчетов и обработок БСП
	Если Не ЗначениеЗаполнено(ТекОбъект.ДопОбработкаСверкаЦБ) Тогда
		ТекОбъект.ДопОбработкаСверкаЦБ = НайтиДопОбработкуПоИмениОбъекта("СверкаЦБ");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекОбъект.ДопОбработкаОтрицательныеОстатки) Тогда
		ТекОбъект.ДопОбработкаОтрицательныеОстатки = НайтиДопОбработкуПоИмениОбъекта("ОтрицательныеОстаткиНаАналитическомСчете");
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьТест(Команда)
	
	ЗапуститьТестНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗапуститьТестНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ТекОбъект.СформироватьОтчетТеста();
	
	Если Результат.ТабДокумент <> Неопределено Тогда
		РезультатЗамеров = Результат.ТабДокумент;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
	Если Результат.Успех Тогда
		Сообщить("IMDEV-9336: тест замеров выполнен успешно (без внешних соединений).");
	Иначе
		ТекстОшибки = ?(ЗначениеЗаполнено(Результат.ТекстОшибки), Результат.ТекстОшибки, "Есть ошибки в результатах теста");
		Сообщить("IMDEV-9336: " + ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиДопОбработкуПоИмениОбъекта(ИмяОбъекта)
	
	Возврат Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбъекта);
	
КонецФункции

#КонецОбласти
