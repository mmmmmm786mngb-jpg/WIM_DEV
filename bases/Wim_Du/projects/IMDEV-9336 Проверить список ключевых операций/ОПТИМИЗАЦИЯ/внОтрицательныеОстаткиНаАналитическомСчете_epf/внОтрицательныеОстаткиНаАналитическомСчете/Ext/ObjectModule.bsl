Перем НаименованиеОтчета;
Перем ИдентификаторКомандыДляЗамера; // IMDEV-8274

#Область ОписаниеПодключаемогоОтчета

Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", НСтр("ru = '" + НаименованиеОтчета + "'"));
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Версия", "1.2");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.2.2.1");
	ПараметрыРегистрации.Вставить("Информация", НСтр("ru = '" + НаименованиеОтчета + "'"));
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, НаименованиеОтчета, "ОткрытиеФормыОбработки", "ОткрытиеФормы", Истина, "");
	
	// IMDEV-8274: фоновое формирование отчета для РЗ и рассылки
	ДобавитьКоманду(
		ТаблицаКоманд,
		НаименованиеОтчета + " (фон.)",
		"ФоновоеВыполнение",
		"ВызовСерверногоМетода");
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

// IMDEV-8274 ++
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
	
	ЕстьОшибкиFAIL = Ложь;
	ЕстьОшибкиWARN = Ложь;
	ТекстОшибки = "";
	ДатаОтчета = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, ТекущаяДата(), -1);
	
	ВыполнитьФормированиеОтчета(ДатаОтчета, ЕстьОшибкиFAIL, ЕстьОшибкиWARN, ТекстОшибки);
	
	ИдентификаторКомандыДляЗамера = Неопределено;
	
КонецПроцедуры
// IMDEV-8274 --

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция СформироватьОтчет(ДатаОтчета) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДатаОтчета) Тогда
		ВызватьИсключение "Не указана дата для формирования отчета";
	КонецЕсли;
	
	ЕстьОшибкиFAIL = Ложь;
	ЕстьОшибкиWARN = Ложь;
	ТекстОшибки = "";
	
	Возврат ВыполнитьФормированиеОтчета(ДатаОтчета, ЕстьОшибкиFAIL, ЕстьОшибкиWARN, ТекстОшибки);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// IMDEV-8274 ++
// Описание: Формирует отчет по отрицательным остаткам с замером производительности
//
// Параметры:
// ДатаОтчета - Дата - отчетная дата
// ЕстьОшибкиFAIL - Булево - признак критической ошибки (возврат по ссылке)
// ЕстьОшибкиWARN - Булево - признак предупреждения, найдены минусовые остатки (возврат по ссылке)
// ТекстОшибки - Строка - текст ошибки (возврат по ссылке)
//
// Возвращаемое значение:
// ТабличныйДокумент - сформированный отчет
//
Функция ВыполнитьФормированиеОтчета(ДатаОтчета, ЕстьОшибкиFAIL, ЕстьОшибкиWARN, ТекстОшибки)
	
	КлючеваяОперация = ПолучитьИмяКлючевойОперацииЗамера("ФормированиеОтчета");
	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	
	КоличествоСтрокМинусов = 0;
	КоличествоДоговоров = 0;
	ТабличныйДокумент = Неопределено;
	
	Попытка
		ТабличныйДокумент = ПолучитьДанныеОСВ(ДатаОтчета, КоличествоСтрокМинусов, КоличествоДоговоров);
	Исключение
		ЕстьОшибкиFAIL = Истина;
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Если КоличествоСтрокМинусов > 0 Тогда
		ЕстьОшибкиWARN = Истина;
	КонецЕсли;
	
	Если ВремяНачалаЗамера > 0 Тогда
		ВесЗамера = ?(КоличествоСтрокМинусов > 0, КоличествоСтрокМинусов, 1);
		КомментарийЗамера = "FAIL=" + ?(ЕстьОшибкиFAIL, "Да", "Нет")
			+ "; WARN=" + ?(ЕстьОшибкиWARN, "Да", "Нет")
			+ "; СтрокМинусов=" + Формат(КоличествоСтрокМинусов, "ЧГ=0")
			+ "; Договоров=" + Формат(КоличествоДоговоров, "ЧГ=0")
			+ ДополнениеКомментарияУдельныйВес(ВесЗамера, ВремяНачалаЗамера);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперация,
			ВремяНачалаЗамера,
			ВесЗамера,
			КомментарийЗамера,
			ЕстьОшибкиFAIL);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Описание: Получает данные из регистра бухгалтерии (ОСВ) и формирует табличный документ
//
// Параметры:
// Дата - Дата - отчетная дата
// КоличествоСтрокМинусов - Число - число строк с отрицательным остатком (возврат по ссылке)
// КоличествоДоговоров - Число - число уникальных договоров ДУ в результате (возврат по ссылке)
//
// Возвращаемое значение:
// ТабличныйДокумент - отчет по минусовым остаткам
//
Функция ПолучитьДанныеОСВ(Дата, КоличествоСтрокМинусов = 0, КоличествоДоговоров = 0)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Субконто1 КАК АналитическийСчет,
	|	ХозрасчетныйОстатки.ДоговорДУ КАК ДоговорДУ,
	|	СУММА(ХозрасчетныйОстатки.СуммаОстатокДт) КАК КонечныйОстаток,
	|	ХозрасчетныйОстатки.Валюта КАК Валюта
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&ДатаОтчета, Счет В (&СчетаДС), , ДоговорДУ.Пул = &Пул) КАК ХозрасчетныйОстатки
	|ГДЕ
	|	ХозрасчетныйОстатки.СуммаОстатокДт < 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОстатки.Субконто1,
	|	ХозрасчетныйОстатки.ДоговорДУ,
	|	ХозрасчетныйОстатки.Валюта
	|
	|УПОРЯДОЧИТЬ ПО
	|	АналитическийСчет";
	
	СчетаДС = Новый Массив;
	ДС = ПланыСчетов.Хозрасчетный.НайтиПоКоду("ДС");
	
	Если ЗначениеЗаполнено(ДС) Тогда
		СчетаДС.Добавить(ДС);
	КонецЕсли;
	
	ПулРозничноеДУ = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ");
	
	Запрос.УстановитьПараметр("Пул", ПулРозничноеДУ);
	Запрос.УстановитьПараметр("СчетаДС", СчетаДС);
	Запрос.УстановитьПараметр("ДатаОтчета", КонецДня(Дата));
	
	// IMDEV-8274: вес замера = число строк ОСВ с минусовым остатком
	ТаблицаМинусов = Запрос.Выполнить().Выгрузить();
	КоличествоСтрокМинусов = ТаблицаМинусов.Количество();
	КоличествоДоговоров = КоличествоУникальныхДоговоров(ТаблицаМинусов);
	
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("Макет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy");
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Для Каждого СтрокаМинуса Из ТаблицаМинусов Цикл
		
		ОбластьСтрока.Область(1, 5, 1, 7).ЦветТекста = Новый Цвет(0, 0, 0);
		ОбластьСтрока.Параметры.Заполнить(СтрокаМинуса);
		ТабДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Формирует имя ключевой операции для замера по этапу и контуру запуска
//
// Параметры:
// ЭтапЗамера - Строка - этап замера (например, ФормированиеОтчета)
//
// Возвращаемое значение:
// Строка - имя ключевой операции в формате ДУ.Сверка.ОтрицательныеОстаткиНаРС.<Этап>.<Контур>
//
Функция ПолучитьИмяКлючевойОперацииЗамера(Знач ЭтапЗамера)
	
	Возврат "ДУ.Сверка.ОтрицательныеОстаткиНаРС." + ЭтапЗамера + "."
		+ ?(ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера), ИдентификаторКомандыДляЗамера, "Ручной");
	
КонецФункции

// IMDEV-8274 ++
// IMDEV-9336: тест замера с нагрузочными данными - запрос ОСВ и формирование отчета
//
// Параметры:
// МинимумСтрокНагрузки - Число - минимальное число строк минусовых остатков для нагрузки
//
// Возвращаемое значение:
// Структура - Успех, ИмяКО, Вес, Комментарий, ТекстОшибки, СтрокНагрузки
//
Функция ТестЗамераПроизводительности(МинимумСтрокНагрузки = 50) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ИмяКО", "");
	Результат.Вставить("Вес", 0);
	Результат.Вставить("Комментарий", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("СтрокНагрузки", 0);
	
	ДатаОтчета = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, ТекущаяДатаСеанса(), -1);
	
	ЕстьОшибкиFAIL = Ложь;
	ЕстьОшибкиWARN = Ложь;
	ТекстОшибки = "";
	КоличествоСтрокМинусов = 0;
	КоличествоДоговоров = 0;
	
	Попытка
		КлючеваяОперация = ПолучитьИмяКлючевойОперацииЗамера("ФормированиеОтчета");
		ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
		
		Если ВремяНачалаЗамера <= 0 Тогда
			ВызватьИсключение "Не удалось начать замер (подсистема оценки производительности недоступна или отключена)";
		КонецЕсли;
		
		// IMDEV-9336: нагрузка - реальный запрос ОСВ по регистру бухгалтерии
		ПолучитьДанныеОСВ(ДатаОтчета, КоличествоСтрокМинусов, КоличествоДоговоров);
		
		Если МинимумСтрокНагрузки > 0 И КоличествоСтрокМинусов < МинимумСтрокНагрузки Тогда
			СформироватьНагрузочныеМинусовыеОстатки(
				ДатаОтчета,
				МинимумСтрокНагрузки,
				КоличествоСтрокМинусов,
				КоличествоДоговоров);
		КонецЕсли;
		
		Если КоличествоСтрокМинусов > 0 Тогда
			ЕстьОшибкиWARN = Истина;
		КонецЕсли;
		
		ВесЗамера = ?(КоличествоСтрокМинусов > 0, КоличествоСтрокМинусов, 1);
		КомментарийЗамера = "FAIL=" + ?(ЕстьОшибкиFAIL, "Да", "Нет")
			+ "; WARN=" + ?(ЕстьОшибкиWARN, "Да", "Нет")
			+ "; СтрокМинусов=" + Формат(КоличествоСтрокМинусов, "ЧГ=0")
			+ "; Договоров=" + Формат(КоличествоДоговоров, "ЧГ=0")
			+ "; Нагрузка=БД"
			+ ДополнениеКомментарияУдельныйВес(ВесЗамера, ВремяНачалаЗамера);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперация,
			ВремяНачалаЗамера,
			ВесЗамера,
			КомментарийЗамера,
			ЕстьОшибкиFAIL);
		
		Результат.Успех = Истина;
		Результат.ИмяКО = КлючеваяОперация;
		Результат.Вес = ВесЗамера;
		Результат.СтрокНагрузки = КоличествоСтрокМинусов;
		Результат.Комментарий = КомментарийЗамера;
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	
	Возврат Результат;
	
КонецФункции

// Описание: Формирует нагрузочный отчет по минусовым остаткам на образце договоров из БД
//
// Параметры:
// Дата - Дата - отчетная дата
// МинимумСтрок - Число - требуемое число строк
// КоличествоСтрокМинусов - Число - возврат фактического числа строк (по ссылке)
// КоличествоДоговоров - Число - возврат числа договоров (по ссылке)
//
Процедура СформироватьНагрузочныеМинусовыеОстатки(Дата, МинимумСтрок, КоличествоСтрокМинусов, КоличествоДоговоров)
	
	ПулРозничноеДУ = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	АналитическиеСчета.Ссылка КАК АналитическийСчет,
	|	АналитическиеСчета.ДоговорДУ КАК ДоговорДУ
	|ИЗ
	|	Справочник.АналитическиеСчета КАК АналитическиеСчета
	|ГДЕ
	|	АналитическиеСчета.ПометкаУдаления = ЛОЖЬ
	|	И АналитическиеСчета.ДоговорДУ.ПометкаУдаления = ЛОЖЬ
	|	И АналитическиеСчета.ДоговорДУ.Пул = &Пул";
	
	Запрос.УстановитьПараметр("Пул", ПулРозничноеДУ);
	ОбразецСчетов = Запрос.Выполнить().Выгрузить();
	
	Если ОбразецСчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаМинусов = Новый ТаблицаЗначений;
	ТаблицаМинусов.Колонки.Добавить("АналитическийСчет", Новый ОписаниеТипов("СправочникСсылка.АналитическиеСчета"));
	ТаблицаМинусов.Колонки.Добавить("ДоговорДУ", Новый ОписаниеТипов("СправочникСсылка.ДоговорДУ"));
	ТаблицаМинусов.Колонки.Добавить("КонечныйОстаток", Новый ОписаниеТипов("Число"));
	ТаблицаМинусов.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	Индекс = 0;
	ВалютаРуб = Справочники.Валюты.НайтиПоКоду("643");
	Пока ТаблицаМинусов.Количество() < МинимумСтрок Цикл
		СтрокаОбразца = ОбразецСчетов[Индекс];
		НоваяСтрока = ТаблицаМинусов.Добавить();
		НоваяСтрока.АналитическийСчет = СтрокаОбразца.АналитическийСчет;
		НоваяСтрока.ДоговорДУ = СтрокаОбразца.ДоговорДУ;
		НоваяСтрока.Валюта = ВалютаРуб;
		НоваяСтрока.КонечныйОстаток = -100 - ТаблицаМинусов.Количество();
		Индекс = (Индекс + 1) % ОбразецСчетов.Количество();
	КонецЦикла;
	
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("Макет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy");
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Для Каждого СтрокаМинуса Из ТаблицаМинусов Цикл
		ОбластьСтрока.Область(1, 5, 1, 7).ЦветТекста = Новый Цвет(0, 0, 0);
		ОбластьСтрока.Параметры.Заполнить(СтрокаМинуса);
		ТабДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	КоличествоСтрокМинусов = ТаблицаМинусов.Количество();
	КоличествоДоговоров = КоличествоУникальныхДоговоров(ТаблицаМинусов);
	
КонецПроцедуры

// Описание: Подсчитывает число уникальных договоров ДУ в таблице минусовых остатков
//
// Параметры:
// ТаблицаМинусов - ТаблицаЗначений - результат запроса к ОСВ
//
// Возвращаемое значение:
// Число - количество уникальных договоров
//
Функция КоличествоУникальныхДоговоров(ТаблицаМинусов)
	
	Если ТаблицаМинусов = Неопределено Или ТаблицаМинусов.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ТаблицаДоговоров = ТаблицаМинусов.Скопировать(, "ДоговорДУ");
	ТаблицаДоговоров.Свернуть("ДоговорДУ");
	
	Возврат ТаблицаДоговоров.Количество();
	
КонецФункции
// IMDEV-8274 --

#КонецОбласти

НаименованиеОтчета = "Отчет отрицательные остатки по аналитическим счетам";
