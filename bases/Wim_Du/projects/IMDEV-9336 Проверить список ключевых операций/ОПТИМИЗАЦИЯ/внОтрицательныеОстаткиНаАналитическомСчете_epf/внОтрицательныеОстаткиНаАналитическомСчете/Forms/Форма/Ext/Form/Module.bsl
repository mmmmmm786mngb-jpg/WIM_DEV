
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Устанавливаем дату по умолчанию - текущая дата
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОтчета) Тогда
		ДатаОтчета = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	// Валидация: проверка заполнения даты
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОтчета) Тогда
		Сообщить("Укажите дату для формирования отчета");
		Возврат;
	КонецЕсли;
	
	// Формирование отчета на сервере
	СформироватьОтчетНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьОтчетНаСервере()
	
	Попытка
		
		// Вызов метода объекта обработки для формирования отчета
		// Вся бизнес-логика находится в модуле объекта
		ТабличныйДокумент = РеквизитФормыВЗначение("Объект").СформироватьОтчет(Объект.ДатаОтчета);
		
	Исключение
		
		// Обработка ошибок
		ТекстОшибки = ОписаниеОшибки();
		
		// Сообщение пользователю
		Сообщить(ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
