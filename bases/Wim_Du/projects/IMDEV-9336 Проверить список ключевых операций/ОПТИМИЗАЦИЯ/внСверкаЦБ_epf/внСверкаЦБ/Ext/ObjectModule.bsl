Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	// Реализация логики команды
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда Возврат; КонецЕсли; 
	
	// IMDEV-8927 ++
	ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
	// IMDEV-8927 --
	
	ЕстьОшибкиFAIL = Ложь;
	ЕстьОшибкиWARN = Ложь;
	ТекстОшибки = "";
	
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	Задача = Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
	Задача.Дата 	= ТекущаяДата();
	
	Задача.Наименование 	= "Сверка ценных бумаг";
	Задача.ПараметрыВыполнения = ПредставлениеНастроек;
	 
	НачДата = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, ТекущаяДата(), -1);
	КонДата = НачДата;
	
	ВыполнитьСверку(ЕстьОшибкиFAIL, ЕстьОшибкиWARN, ТекстОшибки);
	
	РассылкаОтчета(ЕстьОшибкиFAIL, ЕстьОшибкиWARN, ТекстОшибки);
	
	Задача.ХранилищеЛога = Новый ХранилищеЗначения(Отчет, Новый СжатиеДанных(9));
	Задача.Описание 	= "Настройки: "+ ПредставлениеНастроек;

	Если СтрДлина(СтатусОшибки) > 0 тогда
		Задача.Описание = Задача.Описание + Символы.ПС + "При выполнении были ошибки:";
		Задача.Описание = Задача.Описание + Символы.ПС + СтатусОшибки;
		Задача.ЗавершеноСОшибками = Истина;
	Иначе
		Задача.Описание = Задача.Описание + Символы.ПС + "Загрузка успешна: " + ТекстОшибки;
	КонецЕсли;
	
	ТекстОписания 		= СокрЛП(ПочтовыйЛогин) + " " + СокрЛП(СписокРассылки.Количество());
	Задача.Описание 	= Задача.Описание + Символы.ПС + ТекстОписания;
	Задача.ДатаИсполнения = ТекущаяДата();
	Задача.Описание = Задача.Описание + Символы.ПС + " ОК";
	Задача.ВыполнитьЗадачу();
	
	// IMDEV-8927 ++
	ИдентификаторКомандыДляЗамера = Неопределено;
	// IMDEV-8927 --
КонецПроцедуры

// IMDEV-8927 ++
// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

