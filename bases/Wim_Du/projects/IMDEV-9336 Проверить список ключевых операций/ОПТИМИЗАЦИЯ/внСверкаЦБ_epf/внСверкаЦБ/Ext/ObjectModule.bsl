// Описание: Подсчитывает число строк сверки с расхождениями для комментария замера
//
// Параметры:
// ТЗ - ТаблицаЗначений - результат ПодготовитьТаблицу
//
// Возвращаемое значение:
// Число - количество строк, где Разница = "Есть расхождения"
//
Функция КоличествоСтрокСРасхождениями(ТЗ)
	
	Если ТЗ = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Количество = 0;
	
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если СтрокаТЗ.Разница = "Есть расхождения" Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции
