Функция ВыполнитьСверку(ЕстьОшибкиFAIL = Ложь, ЕстьОшибкиWARN = Ложь, ТекстОшибки = "") Экспорт
	
	// IMDEV-8927 ++
	КлючеваяОперацияСверки = ПолучитьИмяКлючевойОперацииЗамера("Сверка");
	ВремяНачалаЗамераСверки = ОценкаПроизводительности.НачатьЗамерВремени();
	// IMDEV-8927 --
	
	ТЗ = ПодготовитьТаблицу(ЕстьОшибкиFAIL, ЕстьОшибкиWARN, ТекстОшибки);
	
	Если СтрДлина(СтатусОшибки) = 0 И ТЗ <> Неопределено Тогда
		ТабДок = ЗаполнитьМакет(ТЗ);
		РезультатСверки = ТабДок;
	Иначе
		РезультатСверки = Неопределено;
	КонецЕсли; 
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераСверки > 0 Тогда
		// IMDEV-9336: вес = число строк сверки (ДоговорДУ + ЦБ) после ПодготовитьТаблицу
		ВесЗамераСверки = ?(ТЗ <> Неопределено И ТЗ.Количество() > 0, ТЗ.Количество(), 1);
		СтрокСРасхождениями = КоличествоСтрокСРасхождениями(ТЗ);
		КомментарийЗамераСверки = "FAIL=" + ?(ЕстьОшибкиFAIL, "Да", "Нет")
			+ "; WARN=" + ?(ЕстьОшибкиWARN, "Да", "Нет")
			+ "; СтрокСверки=" + Формат(ВесЗамераСверки, "ЧГ=0")
			+ "; СтрокСРасхождениями=" + Формат(СтрокСРасхождениями, "ЧГ=0")
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераСверки, ВремяНачалаЗамераСверки);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияСверки,
			ВремяНачалаЗамераСверки,
			ВесЗамераСверки,
			КомментарийЗамераСверки,
			ЕстьОшибкиFAIL);
	КонецЕсли;
	// IMDEV-8927 --
	
	Возврат РезультатСверки;
	
КонецФункции

// IMDEV-9336 ++
// Описание: Тест замера производительности без ПодготовитьТаблицу, запросов к БД и внешних соединений
//
// Возвращаемое значение:
// Структура - Успех, ИмяКО, Вес, Комментарий, ТекстОшибки
//
Функция ТестЗамераПроизводительности() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ИмяКО", "");
	Результат.Вставить("Вес", 0);
	Результат.Вставить("Комментарий", "");
	Результат.Вставить("ТекстОшибки", "");
	
	ИдентификаторКомандыДляЗамера = "Тест9336";
	
	Попытка
		КлючеваяОперацияСверки = ПолучитьИмяКлючевойОперацииЗамера("Сверка");
		ВремяНачалаЗамераСверки = ОценкаПроизводительности.НачатьЗамерВремени();
		
		Если ВремяНачалаЗамераСверки <= 0 Тогда
			ВызватьИсключение "Не удалось начать замер (подсистема оценки производительности недоступна или отключена)";
		КонецЕсли;
		
		// IMDEV-9336: имитация веса без бизнес-логики сверки
		ВесЗамераСверки = 5;
		СтрокСРасхождениями = 2;
		КомментарийЗамераСверки = "FAIL=Нет; WARN=Да"
			+ "; СтрокСверки=" + Формат(ВесЗамераСверки, "ЧГ=0")
			+ "; СтрокСРасхождениями=" + Формат(СтрокСРасхождениями, "ЧГ=0")
			+ "; Режим=Тест9336"
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераСверки, ВремяНачалаЗамераСверки);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияСверки,
			ВремяНачалаЗамераСверки,
			ВесЗамераСверки,
			КомментарийЗамераСверки,
			Ложь);
		
		Результат.Успех = Истина;
		Результат.ИмяКО = КлючеваяОперацияСверки;
		Результат.Вес = ВесЗамераСверки;
		Результат.Комментарий = КомментарийЗамераСверки;
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	ИдентификаторКомандыДляЗамера = Неопределено;
	
	Возврат Результат;
	
КонецФункции
// IMDEV-9336 -- 

Функция ЗаполнитьМакет(ТЗ)
	Отчет.Очистить();
	Отчет.ТолькоПросмотр =  ИСТИНА;
	
	Макет = ПолучитьМакет("Макет");
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Период = "Период с " + Формат(НачДата, "ДФ=dd.MM.yyyy") + " по " + Формат(КонДата, "ДФ=dd.MM.yyyy");
	Отчет.Вывести(Область);
	
	Статус = ЛОЖЬ;
	
	ТекВид = Неопределено;
	
	Для Каждого текСтр ИЗ ТЗ Цикл
		Если текСтр.вхБУ = 0 И текСтр.исхБУ = 0 и текСтр.вхВУ = 0 И текСтр.исхВУ = 0 И текСтр.вхУУ = 0 И текСтр.исхУУ = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ОтображатьВсе Тогда
			Если текСтр.Разница = "-" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если текСтр.ТипКлиентаДУ <> ТекВид Тогда
			текВид = текСтр.ТипКлиентаДУ;
			Область = Макет.ПолучитьОбласть("ТипДоговораДУ");
			Область.Параметры.ТипДоговораДУ = текВид;
			Отчет.Вывести(Область);
		КонецЕсли;
		
		Если текСтр.Разница = "Есть расхождения" Тогда
			Статус = ИСТИНА;
			Область = Макет.ПолучитьОбласть("СтрокаПодсв");
		Иначе
			Область = Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.Заполнить(текСтр);
		
		Отчет.Вывести(Область)
	КонецЦикла;
	
	Возврат Отчет;
КонецФункции

Функция ПодготовитьТаблицу(ЕстьОшибкиFAIL = Ложь, ЕстьОшибкиWARN = Ложь, ТекстОшибки = "")
	Запрос = Новый Запрос();
	Запрос.Текст = ПолучитьТекстЗапроса();
	Запрос.УстановитьПараметр("НачГраница", Новый Граница(НачалоДня(НачДата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонГраница", Новый Граница(КонецДня(КонДата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонДата",КонецДня(КонДата));
	
	Попытка
		тзВнутренние = Запрос.Выполнить().Выгрузить();
	Исключение
		ЕстьОшибкиFAIL = Истина;
		ТекстОшибки = ТекстОшибки + " Ошибка выполнения запроса " + Символы.ПС + ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;
	
	// Соединим внешние и внутренние данные
	тзВнешние = ПолучитьДанныеПоВыпискам(ЕстьОшибкиFAIL, ТекстОшибки);
	
	Если ТипЗнч(тзВнешние) = Тип("Строка") Тогда
		СтатусОшибки = тзВнешние;
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого ВнешСтр Из тзВнешние Цикл
		ВнутрСтр = тзВнутренние.Добавить();
		ВнутрСтр.ДоговорДУ = ВнешСтр.ДоговорДУ;
		ВнутрСтр.ТипКлиентаДУ = ВнешСтр.ДоговорДУ.ТипКлиентаДУ;
		ВнутрСтр.ЦБ = ВнешСтр.ЦБ;
		ВнутрСтр.вхВып = ВнешСтр.начОст;
		ВнутрСтр.исхВып = ВнешСтр.конОст;
	КонецЦикла;
	
	тзВнутренние.Свернуть("ДоговорДУ, ТипКлиентаДУ, ЦБ", "вхБУ,исхБУ,вхВУ,исхВУ,вхУУ,исхУУ,вхВып,исхВып");
	тзВнутренние.Сортировать("ТипКлиентаДУ, ДоговорДУ, ЦБ");	
	
	// Проставим разницу
	
	тзВнутренние.Колонки.Добавить("Разница"); 
	РазмерТаблицы = -(тзВнутренние.Количество() - 1);
	Для Сч = РазмерТаблицы По 0 Цикл
		ТекСтр = тзВнутренние.Получить(-Сч);
		
		Если (ТекСтр.вхБУ - ТекСтр.вхВУ) <> 0 ИЛИ (ТекСтр.вхБУ - ТекСтр.вхУУ) <> 0 ИЛИ (ТекСтр.вхВУ - ТекСтр.вхУУ) <> 0  ИЛИ
			 (ТекСтр.исхБУ - ТекСтр.исхВУ) <> 0 ИЛИ (ТекСтр.исхБУ - ТекСтр.исхУУ) <> 0 ИЛИ (ТекСтр.исхВУ - ТекСтр.исхУУ) <> 0 Тогда
			текСтр.Разница = "Есть расхождения";
			ЕстьОшибкиWARN = Истина;	
		Иначе
			текСтр.Разница = "-";
		КонецЕсли;
	КонецЦикла;
	Возврат тзВнутренние;
КонецФункции

Функция ПолучитьТекстЗапроса()
	// MPazhukov IMAPPS-11279
	// Для запроса по ВУ вычитание остатка по РЕПО только для сделок обратного РЕПО
	// Прямое репо дает неправильный остаток
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Подзапрос.ДоговорДУ КАК ДоговорДУ,
	               |	Подзапрос.ДоговорДУ.ТипКлиентаДУ КАК ТипКлиентаДУ,
	               |	Подзапрос.ЦБ КАК ЦБ,
	               |	СУММА(Подзапрос.вхБУ) КАК вхБУ,
	               |	СУММА(Подзапрос.исхБУ) КАК исхБУ,
	               |	СУММА(Подзапрос.вхВУ) КАК вхВУ,
	               |	СУММА(Подзапрос.исхВУ) КАК исхВУ,
	               |	СУММА(Подзапрос.вхУУ) КАК вхУУ,
	               |	СУММА(Подзапрос.исхУУ) КАК исхУУ,
	               |	0 КАК вхВып,
	               |	0 КАК исхВып
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ХозрасчетныйОстаткиИОбороты.ДоговорДУ КАК ДоговорДУ,
	               |		ХозрасчетныйОстаткиИОбороты.Субконто1 КАК ЦБ,
	               |		ЕСТЬNULL(ХозрасчетныйОстаткиИОбороты.КоличествоНачальныйОстаток, 0) КАК вхБУ,
	               |		ЕСТЬNULL(ХозрасчетныйОстаткиИОбороты.КоличествоКонечныйОстаток, 0) КАК исхБУ,
	               |		0 КАК вхВУ,
	               |		0 КАК исхВУ,
	               |		0 КАК вхУУ,
	               |		0 КАК исхУУ
	               |	ИЗ
	               |		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачГраница, &КонГраница, Период, ДвиженияИГраницыПериода, Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ФинансовыеВложения)), , ) КАК ХозрасчетныйОстаткиИОбороты
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ХозрасчетныйОстаткиИОбороты.ДоговорДУ,
	               |		ХозрасчетныйОстаткиИОбороты.Субконто2.Объект,
	               |		0,
	               |		0,
	               |		ЕСТЬNULL(ХозрасчетныйОстаткиИОбороты.КоличествоНачальныйОстаток, 0) - ЕСТЬNULL(СтоимостьАктивовПоСделкамРЕПОУправленческийОстаткиИОбороты.КоличествоНачальныйОстаток, 0),
	               |		ЕСТЬNULL(ХозрасчетныйОстаткиИОбороты.КоличествоКонечныйОстаток, 0) - ЕСТЬNULL(СтоимостьАктивовПоСделкамРЕПОУправленческийОстаткиИОбороты.КоличествоКонечныйОстаток, 0),
	               |		0,
	               |		0
	               |	ИЗ
	               |		РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачГраница, &КонГраница, Период, ДвиженияИГраницыПериода, Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВУЦБ), , ) КАК ХозрасчетныйОстаткиИОбороты
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьАктивовПоСделкамРЕПОУправленческий.ОстаткиИОбороты(&НачГраница, &КонГраница, Период, ДвиженияИГраницыПериода, СделкаРЕПО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО)) КАК СтоимостьАктивовПоСделкамРЕПОУправленческийОстаткиИОбороты
	               |			ПО ХозрасчетныйОстаткиИОбороты.ДоговорДУ = СтоимостьАктивовПоСделкамРЕПОУправленческийОстаткиИОбороты.ДоговорДУ
	               |				И ХозрасчетныйОстаткиИОбороты.Субконто2.Объект = СтоимостьАктивовПоСделкамРЕПОУправленческийОстаткиИОбороты.Актив.Объект
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СтоимостьАктивовУправленческийОстаткиИОбороты.ДоговорДУ,
	               |		СтоимостьАктивовУправленческийОстаткиИОбороты.Актив.Объект,
	               |		0,
	               |		0,
	               |		0,
	               |		0,
	               |		СтоимостьАктивовУправленческийОстаткиИОбороты.КоличествоНачальныйОстаток,
	               |		СтоимостьАктивовУправленческийОстаткиИОбороты.КоличествоКонечныйОстаток
	               |	ИЗ
	               |		РегистрНакопления.СтоимостьАктивовУправленческий.ОстаткиИОбороты(&НачГраница, &КонГраница, Период, ДвиженияИГраницыПериода, ) КАК СтоимостьАктивовУправленческийОстаткиИОбороты) КАК Подзапрос
	               |ГДЕ
	               |	Подзапрос.ДоговорДУ.ПометкаУдаления = ЛОЖЬ
	               |	И (Подзапрос.ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	               |			ИЛИ Подзапрос.ДоговорДУ.ДатаОкончания >= &КонДата)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Подзапрос.ДоговорДУ.ТипКлиентаДУ,
	               |	Подзапрос.ДоговорДУ,
	               |	Подзапрос.ЦБ";
	Возврат ТекстЗапроса;
КонецФункции

Функция ПолучитьДанныеПоВыпискам(ЕстьОшибкиFAIL = Ложь, ТекстОшибки = "") Экспорт
	Возврат Новый ТаблицаЗначений(); // Заглушка пока нет внешних данных
	
	// Получим список нужных счетов
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	БанковскиеСчета.Ссылка КАК Счет,
	               |	БанковскиеСчета.НомерСчета КАК Номер,
	               |	БанковскиеСчета.ДоговорДУ,
	               |	0 КАК начОст,
	               |	0 КАК конОст
	               |ИЗ
	               |	Справочник.БанковскиеСчета КАК БанковскиеСчета
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорДУ КАК Договоры
	               |		ПО БанковскиеСчета.ДоговорДУ = Договоры.Ссылка
	               |ГДЕ
	               |	БанковскиеСчета.ПометкаУдаления = ЛОЖЬ
	               |	И БанковскиеСчета.ВидСчета <> ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
	               |	И (Договоры.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	               |			ИЛИ Договоры.ДатаОкончания >= &КонДата)
	               |	И Договоры.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("КонДата", КонДата); 
	Попытка
		тзСчетов = Запрос.Выполнить().Выгрузить(); 
	Исключение
		ЕстьОшибкиFAIL = Истина;
		ТекстОшибки = ТекстОшибки + " Ошибка выполнения запроса " + Символы.ПС + ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;
	
	СписокСчетов = "";
	
	Для Каждого Счет Из тзСчетов Цикл
		Если СписокСчетов = "" Тогда
			СписокСчетов = "'" + СокрЛП(Счет.Номер) + "'";
		Иначе
			СписокСчетов = СписокСчетов + ", " + "'" + СокрЛП(Счет.Номер) + "'";
		КонецЕсли;
	КонецЦикла;
	
	// Получим остатки из базы iBankReports по нужным счетам
	//АДОстр = "Provider=SQLOLEDB.1;Persist Security Info=True;User ID=rates_view;Password=DgsFaVqDSZQhORL7NrCm;Initial Catalog=iBankReports;Data Source=AMDBRATES\dbmvtbam01";
	//
	//Попытка		
	//	АДО = Новый COMОбъект("ADODB.Connection");
	//	АДО.ConnectionTimeOut = 60000;
	//	АДО.CursorLocation = 3;
	//	АДО.CommandTimeOut = 600;
	//	АДО.Open(АДОстр);		
	//Исключение 
	//	Сообщить(ОписаниеОшибки());
	//	Сообщить("Не могу подсоединиться к базе. Обратитесь к разработчику.");
	//	ЕстьОшибкиFAIL = Истина;
	//	ТекстОшибки = ТекстОшибки + " Ошибка подключения к базе " + Символы.ПС + ОписаниеОшибки();
	//	Возврат ОписаниеОшибки();
	//КонецПопытки;
	
	
	АДО = ПодключитьВнешнююБазу(ЕстьОшибкиFAIL, ТекстОшибки);
	рс = Новый COMОбъект("ADODB.RecordSet");
	
	// На начало периода
	SQL =   "SELECT Account, Balance1 FROM REP_BALANCE where Date1 = '" + Формат(НачДата, "ДФ=yyyyMMdd") + "' AND Account IN (" + СписокСчетов + ")";
	
	рс = АДО.Execute(SQL);
	Пока рс.EOF() = 0 Цикл
		Стр = тзСчетов.Найти(СокрЛП(рс.Fields("Account").Value), "Номер");
		Стр.НачОст = Число(рс.Fields("Balance1").Value);
		
		рс.MoveNext();
	КонецЦикла;
	
	// На начало периода
	SQL =   "SELECT Account, Balance2 FROM REP_BALANCE where Date2 = '" + Формат(КонДата, "ДФ=yyyyMMdd") + "' AND Account IN (" + СписокСчетов + ")";
	
	рс = АДО.Execute(SQL);
	Пока рс.EOF() = 0 Цикл
		Стр = тзСчетов.Найти(СокрЛП(рс.Fields("Account").Value), "Номер");
		Стр.КонОст = Число(рс.Fields("Balance2").Value);
		
		рс.MoveNext();
	КонецЦикла;
		
	тзСчетов.Свернуть("ДоговорДУ, Счет", "НачОст, КонОст");
	Возврат тзСчетов;
КонецФункции 

Функция ПодключитьВнешнююБазу(ЕстьОшибкиFAIL = Ложь, ТекстОшибки = "")
	
	Попытка
		ConnectionSQL = Новый COMОбъект("ADODB.Connection");

		СтруктураПодключения = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ВнешняяИБ, "ИмяСервера1СПредприятия, ИмяИнформационнойБазыНаСервере1СПредприятия, ИмяПользователя, ПарольПользователя");

		ServerName = СтруктураПодключения.ИмяСервера1СПредприятия;
		DSN = СтруктураПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
		UID = СтруктураПодключения.ИмяПользователя;
		PWD = СтруктураПодключения.ПарольПользователя;

		ConnectString = "Provider=SQLOLEDB;Persist Security Info=True;" + "Data Source=" +ServerName + ";Initial Catalog=" + DSN + ";UID=" + UID + ";PWD=" + PWD;

		ConnectionSQL.ConnectionString = ConnectString;
		ConnectionSQL.ConnectionTimeOut = 60000;
		ConnectionSQL.CursorLocation = 3;
		ConnectionSQL.CommandTimeout = 600;
		ConnectionSQL.Open();
	Исключение
		ЕстьОшибкиFAIL = Истина;
		ТекстОшибки = ТекстОшибки + " Ошибка подключения к базе " + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;	
	Возврат ConnectionSQL;
	
КонецФункции

Процедура РассылкаОтчета(ЕстьОшибкиFAIL = Ложь, ЕстьОшибкиWARN = Ложь, ТекстОшибки = "") Экспорт
	Если СписокРассылки.Количество() > 0 и НЕ ПочтовыйЛогин.Пустая() тогда
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, Вложения, Важность");
		//ПараметрыПисьма = Новый Структура("Кому, Тема, Тело");
		ПараметрыПисьма.Тема = ?(ЕстьОшибкиFAIL, "{FAIL} ", ?(ЕстьОшибкиWARN, "{WARN} ", "{OK} ")) + "Аванкор ДУ: Отчет по сверке ценных бумаг " + ПропискаРассылки("r240");
		ПараметрыПисьма.Важность = ?(ЕстьОшибкиFAIL ИЛИ ЕстьОшибкиWARN, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная); 
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылки Цикл
		   Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
			
		ПараметрыПисьма.Кому = кому;
		
		ПутьКФайлу = ПолучитьИмяВременногоФайла("XLS");
		Отчет.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLS);
		
		Вложения = Новый Соответствие;
		ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
		АдресВложения = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		Вложения.Вставить("Report.xls", АдресВложения);
		
		ПараметрыПисьма.Вложения = Вложения;
		
		ПараметрыПисьма.Тело = "Отчет по сверке ценных бумаг " + Формат(НачДата,"ДЛФ=Д") + " по " + Формат(КонДата,"ДЛФ=Д") + "." + ТекстОшибки;
		
		Если ЕстьОшибкиWARN Тогда
			ПараметрыПисьма.Тело = ПараметрыПисьма.Тело + Символы.ПС + Символы.ПС + "Выявлены расхождения. Подробности в приложенном отчете.";
		Иначе
			ПараметрыПисьма.Тело = ПараметрыПисьма.Тело + Символы.ПС + Символы.ПС + "Расхождений не выявлено!";
		КонецЕсли;
		
		Попытка
			ТекстОшибки = РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
		Исключение
			СтатусОшибки = "Рассылка не удалась: " + ОписаниеОшибки(); 
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры  

