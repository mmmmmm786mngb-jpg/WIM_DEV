#Область СОБЫТИЯ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.ИсключаемыеДоговорыДУ.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ДоговорДУ");    
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор("7bd55693-f2b1-11e6-9418-005056b100fc"));
	НастройкиОбработки = ОбработкаСсылка.ХранилищеНастроек.Получить();
	ПредставлениеНастроек = "";
	ОбработкаОбъект.УстановитьПользовательскиеНастройки(НастройкиОбработки, ПредставлениеНастроек);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	//IMAPPS-37692 ++
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.ДоговорДУ"));
	НовоеОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
  	
	ЭлементПоле = ЭтаФорма.Элементы.Найти("СписокДоговоровДУКомБрокРЕПО");
	Если НЕ ЭлементПоле = Неопределено Тогда
   		ЭлементПоле.ОграничениеТипа = НовоеОписаниеТипов;
	КонецЕсли;	
	//IMAPPS-37692 --
	  
КонецПроцедуры

#КонецОбласти 

