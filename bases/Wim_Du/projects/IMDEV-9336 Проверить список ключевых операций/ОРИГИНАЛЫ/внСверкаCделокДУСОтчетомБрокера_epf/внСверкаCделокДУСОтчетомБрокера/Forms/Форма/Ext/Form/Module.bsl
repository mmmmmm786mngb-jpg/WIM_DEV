
&НаКлиенте
Процедура Сформировать(Команда)
	Если Объект.ДатаОкончания < Объект.ДатаНачала Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Указан не корректный период, сформировать отчет нет возможности";
		Сообщение.Сообщить();
		Возврат;
		
	КонецЕсли;	                                                 
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТабДокумент = ОбработкаОбъект.ВыполнитьСверкуСделокСОтчетомБрокераSQL( ,УстанавливатьФлаг);
	ТабДокумент.ФиксацияСверху = 2;
	
КонецПроцедуры

