
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КонецПериода = НачалоДня(КонецМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1)));
	НачалоПериода = НачалоМесяца(КонецПериода);
	РазмерВыборки = 500;
	ИсключитьЦессии = Истина;
	ПлановыйУчет = Истина;
	ВознаграждениеКакПассив = Истина;
	КомиссииКакПассив = Ложь;
	НДФЛКакПассив = Истина;
	ТолькоКрупнееВыборки = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Замерить(Команда)
	ЗамеритьНаСервере();
КонецПроцедуры

// Сохраняет таблицу замера текстовым файлом UTF-8. Файл можно передать разработчику.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если ТаблицаОтчета.ВысотаТаблицы = 0 Тогда
		ПоказатьПредупреждение(, "Сначала нажмите ""Замерить"".");
		Возврат;
	КонецЕсли;

	ОписаниеФайла = ФайлЛогаНаСервере();
	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов("Сохранение замера сбора TWR", Истина);
	НачатьПолучениеФайлаССервера(ОписаниеФайла.Адрес, ОписаниеФайла.ИмяФайла, ПараметрыДиалога);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗамеритьНаСервере()

	Если Не ЗначениеЗаполнено(УправляющаяКомпания) Тогда
		СообщитьПользователю("Укажите управляющую компанию, как в заполнении формы 431.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		СообщитьПользователю("Укажите начало и конец периода отчета.");
		Возврат;
	КонецЕсли;

	ВыборкаОграничена = Ложь;
	Если РазмерВыборки < 1 Тогда
		СообщитьПользователю("Размер выборки должен быть больше нуля.");
		Возврат;
	КонецЕсли;
	Если РазмерВыборки > 500 Тогда
		РазмерВыборки = 500;
		ВыборкаОграничена = Истина;
	КонецЕсли;

	НомераДоговоров = НомераДоговоровОтчета();
	Если НомераДоговоров.Количество() = 0 Тогда
		СообщитьПользователю("По указанным отборам договоры не найдены.");
		Возврат;
	КонецЕсли;

	Базы = БазыМО();
	Если Базы.Количество() = 0 Тогда
		СообщитьПользователю("Не найдена база МО. Укажите ее в поле или проверьте PROD_AVC_MO и PROD_AVC_Retail_MO.");
		Возврат;
	КонецЕсли;

	Итоги = НоваяТаблицаИтогов();
	НачалоTWR = НачалоГода(НачалоПериода);
	КонецTWR = КонецДня(КонецПериода);

	Для Каждого База Из Базы Цикл
		ЗамеритьБазу(База, НомераДоговоров, НачалоTWR, КонецTWR, Итоги);
	КонецЦикла;

	ВывестиОтчет(Итоги, НомераДоговоров.Количество(), НачалоTWR, КонецTWR, ВыборкаОграничена);

КонецПроцедуры

&НаСервере
Процедура ЗамеритьБазу(База, НомераДоговоров, НачалоTWR, КонецTWR, Итоги)

	ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.СтруктураПараметровДляУстановкиВнешнегоСоединения();
	ЗаполнитьЗначенияСвойств(ПараметрыПодключения, База);
	СтруктураПодключения = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединение(ПараметрыПодключения);
	Соединение = СтруктураПодключения.Соединение;
	Если Соединение = Неопределено Тогда
		ДобавитьОшибку(Итоги, Строка(База), "", СтруктураПодключения.ПодробноеОписаниеОшибки);
		Возврат;
	КонецЕсли;

	Состав = ПрочитатьСостав(Соединение, НомераДоговоров, НачалоTWR, НачалоДня(КонецПериода));
	Стратегии = СтратегииДляЗамера(Соединение, Состав);
	Состав = Неопределено;

	Для Каждого ОписаниеСтратегии Из Стратегии Цикл
		ЗамеритьСтратегию(Соединение, Строка(База), ОписаниеСтратегии, НачалоTWR, КонецTWR, Итоги);
	КонецЦикла;

	Соединение = Неопределено;

КонецПроцедуры

// Описание: Вызывает TWR один раз по самым тяжелым мандатам стратегии и на одной таблице
// замеряет старый сбор версии 1.07 и новый сбор версии 1.08.
//
// Параметры:
//  Соединение         - COMОбъект - внешнее соединение с МО
//  ИмяБазы            - Строка
//  ОписаниеСтратегии  - Структура - Код, Наименование, Стратегия, Мандаты, ДнейСтратегии, МандатовСтратегии
//  НачалоTWR          - Дата
//  КонецTWR           - Дата
//  Итоги              - ТаблицаЗначений
//
&НаСервере
Процедура ЗамеритьСтратегию(Соединение, ИмяБазы, ОписаниеСтратегии, НачалоTWR, КонецTWR, Итоги)

	Итог = Итоги.Добавить();
	Итог.База = ИмяБазы;
	Итог.Код = ОписаниеСтратегии.Код;
	Итог.Наименование = ОписаниеСтратегии.Наименование;
	Итог.Особая = ОписаниеСтратегии.Особая;
	Итог.Мандатов = ОписаниеСтратегии.МандатовСтратегии;
	Итог.ДнейСтратегии = ОписаниеСтратегии.ДнейСтратегии;
	Итог.ВВыборке = ОписаниеСтратегии.Мандаты.Количество();

	Порция = Неопределено;
	Данные = Неопределено;

	Попытка
		Порция = Соединение.NewObject("Массив");
		Для Каждого Мандат Из ОписаниеСтратегии.Мандаты Цикл
			Порция.Добавить(Мандат);
		КонецЦикла;
		Мандат = Неопределено;

		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Данные = Соединение.ВТБ_РасчетДоходностиСервер.TWR(
			НачалоTWR,
			КонецTWR,
			Соединение.Справочники.Валюты.RUB,
			ВознаграждениеКакПассив,
			ПлановыйУчет,
			Порция,
			ОписаниеСтратегии.Стратегия,
			"MANDATE",
			КомиссииКакПассив,
			НДФЛКакПассив);
		Итог.СекTWR = Секунды(Начало);

		Если Данные = Неопределено Тогда
			Итог.Ошибка = "TWR вернул Неопределено";
		Иначе
		Итог.СтрокTWR = Данные.Количество();
		КлючиВыборки = КлючиМандатов(Соединение, ОписаниеСтратегии.Мандаты);

		// Новый сбор идет первым: второй проход застает таблицу уже прогретой.
		НачалоНового = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Новые = ДоходностьПоНовому(Соединение, Данные, КлючиВыборки, ОписаниеСтратегии.Особая, КонецTWR, Итог);
		Итог.СекНовый = Секунды(НачалоНового);

		НачалоИндекса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ИндексСтрок = ИндексСтрокПоМандату(Соединение, Данные);
		Итог.СекИндекс = Секунды(НачалоИндекса);

		НачалоРасчета = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Старые = ДоходностьПоСтарому(Соединение, ИндексСтрок, КлючиВыборки, ОписаниеСтратегии.Особая, КонецTWR);
		Итог.СекСтарыйРасчет = Секунды(НачалоРасчета);
		ИндексСтрок = Неопределено;

		СравнитьДоходность(Старые, Новые, Итог);
		Итог.ВерхСек108 = (Итог.СекTWR + Итог.СекНовый) * ЧислоПачек(Итог.Мандатов);
		КонецЕсли;

	Исключение
		Итог.Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Данные = Неопределено;
	Порция = Неопределено;
	ОписаниеСтратегии.Мандаты = Неопределено;
	ОписаниеСтратегии.Стратегия = Неопределено;

КонецПроцедуры

// Строит COM-соответствие мандат - массив строк TWR. Так версия 1.07 готовит обход доходности.
//
&НаСервере
Функция ИндексСтрокПоМандату(Соединение, Данные)

	Индекс = Соединение.NewObject("Соответствие");
	Для Каждого СтрокаДоходности Из Данные Цикл
		Мандат = СтрокаДоходности.Разделитель;
		СтрокиМандата = Индекс.Получить(Мандат);
		Если СтрокиМандата = Неопределено Тогда
			СтрокиМандата = Соединение.NewObject("Массив");
			Индекс.Вставить(Мандат, СтрокиМандата);
		КонецЕсли;
		СтрокиМандата.Добавить(СтрокаДоходности);
	КонецЦикла;
	СтрокаДоходности = Неопределено;
	Возврат Индекс;

КонецФункции

// Считает доходность как версия 1.07: для особой стратегии произведение Rn с записью в строку МО,
// затем годовая доходность от TWR последней строки и первого дня с ненулевой оценкой.
//
&НаСервере
Функция ДоходностьПоСтарому(Соединение, ИндексСтрок, КлючиВыборки, Особая, КонецПериода)

	Результат = Новый Соответствие;
	Для Каждого КлючИМандат Из КлючиВыборки Цикл
		СтрокиМандата = ИндексСтрок.Получить(КлючИМандат.Значение);
		Если СтрокиМандата = Неопределено Или СтрокиМандата.Количество() = 0 Тогда
			Результат.Вставить(КлючИМандат.Ключ, 0);
			Продолжить;
		КонецЕсли;

		Если Особая Тогда
			RnНакопленный = 1;
			Для ИндексСтроки = 0 По СтрокиМандата.Количество() - 1 Цикл
				СтрокаДоходности = СтрокиМандата.Получить(ИндексСтроки);
				Делитель = СтрокаДоходности.IO + СтрокаДоходности.MVn_1;
				Если Делитель <> 0 Тогда
					СтрокаДоходности.Rn_Бенчмарк = СтрокаДоходности.MVn / Делитель;
				Иначе
					СтрокаДоходности.Rn_Бенчмарк = 1;
				КонецЕсли;
				RnНакопленный = RnНакопленный * СтрокаДоходности.Rn_Бенчмарк;
				СтрокаДоходности.TWR_Бенчмарк = RnНакопленный - 1;
			КонецЦикла;
		КонецЕсли;

		ПериодПервого = Неопределено;
		Для ИндексСтроки = 0 По СтрокиМандата.Количество() - 1 Цикл
			СтрокаДоходности = СтрокиМандата.Получить(ИндексСтроки);
			Если СтрокаДоходности.MVn <> 0 Тогда
				ПериодПервого = СтрокаДоходности.Период;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Последняя = СтрокиМандата.Получить(СтрокиМандата.Количество() - 1);
		Результат.Вставить(КлючИМандат.Ключ, ДоходностьГодовая(ПериодПервого, Последняя.TWR_Бенчмарк, КонецПериода));
	КонецЦикла;

	СтрокаДоходности = Неопределено;
	Последняя = Неопределено;
	Возврат Результат;

КонецФункции

// Считает доходность как версия 1.08. Особая стратегия и пачка, у которой не сошелся порядок строк,
// обходятся построчно. Обычная стратегия свертывается по позициям первой и последней строки.
//
&НаСервере
Функция ДоходностьПоНовому(Соединение, Данные, КлючиВыборки, Особая, КонецПериода, Итог)

	ИтогиМандатов = Новый Соответствие;
	Если Особая Тогда
		Итог.Путь = "по строкам";
		СвернутьПоСтрокам(Соединение, Данные, ИтогиМандатов, Истина);
	ИначеЕсли Не СвернутьПоПозициям(Соединение, Данные, ИтогиМандатов) Тогда
		Итог.Путь = "по строкам, позиции не сошлись";
		СвернутьПоСтрокам(Соединение, Данные, ИтогиМандатов, Ложь);
	Иначе
		Итог.Путь = "по позициям";
	КонецЕсли;

	Результат = Новый Соответствие;
	Для Каждого КлючИМандат Из КлючиВыборки Цикл
		ИтогМандата = ИтогиМандатов.Получить(КлючИМандат.Ключ);
		Если ИтогМандата = Неопределено Тогда
			Результат.Вставить(КлючИМандат.Ключ, 0);
		Иначе
			Результат.Вставить(КлючИМандат.Ключ,
				ДоходностьГодовая(ИтогМандата.ПериодПервогоMV, ИтогМандата.TWR_Бенчмарк, КонецПериода));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция СвернутьПоПозициям(Соединение, Данные, ИтогиМандатов)

	КоличествоСтрок = Данные.Количество();
	СтрокиПоМандатам = Данные.Скопировать(, "Разделитель");
	СтрокиПоМандатам.Колонки.Добавить("КоличествоСтрок", Соединение.NewObject("ОписаниеТипов", "Число"));
	СтрокиПоМандатам.ЗаполнитьЗначения(1, "КоличествоСтрок");
	СтрокиПоМандатам.Свернуть("Разделитель", "КоличествоСтрок");

	ИтогиПорции = Новый Соответствие;
	ПорядокСовпал = Истина;
	Позиция = 0;

	Для Каждого СтрокаМандата Из СтрокиПоМандатам Цикл
		КлючМандата = Соединение.XMLСтрока(СтрокаМандата.Разделитель);
		ПоследняяПозиция = Позиция + СтрокаМандата.КоличествоСтрок - 1;
		Если ПоследняяПозиция >= КоличествоСтрок Тогда
			ПорядокСовпал = Ложь;
			Прервать;
		КонецЕсли;

		ПерваяСтрока = Данные.Получить(Позиция);
		ПоследняяСтрока = Данные.Получить(ПоследняяПозиция);
		Если Соединение.XMLСтрока(ПерваяСтрока.Разделитель) <> КлючМандата
			Или Соединение.XMLСтрока(ПоследняяСтрока.Разделитель) <> КлючМандата Тогда
			ПорядокСовпал = Ложь;
			Прервать;
		КонецЕсли;

		ИтогМандата = Новый Структура("ПериодПервогоMV, TWR_Бенчмарк, Rn_НакопленныйБенчмарк", Неопределено, 0, 1);
		Если ПерваяСтрока.MVn <> 0 Тогда
			ИтогМандата.ПериодПервогоMV = ПерваяСтрока.Период;
		Иначе
			ИтогМандата.ПериодПервогоMV = ПериодПервогоНенулевогоMV(Данные, Позиция + 1, ПоследняяПозиция);
		КонецЕсли;
		ИтогМандата.TWR_Бенчмарк = ПоследняяСтрока.TWR_Бенчмарк;
		ИтогиПорции.Вставить(КлючМандата, ИтогМандата);
		Позиция = ПоследняяПозиция + 1;
	КонецЦикла;

	СтрокаМандата = Неопределено;
	ПерваяСтрока = Неопределено;
	ПоследняяСтрока = Неопределено;
	СтрокиПоМандатам = Неопределено;

	Если Не ПорядокСовпал Или Позиция <> КоличествоСтрок Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КлючИЗначение Из ИтогиПорции Цикл
		ИтогиМандатов.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаСервере
Функция ПериодПервогоНенулевогоMV(Данные, НачальнаяПозиция, КонечнаяПозиция)

	Для Позиция = НачальнаяПозиция По КонечнаяПозиция Цикл
		СтрокаДоходности = Данные.Получить(Позиция);
		Если СтрокаДоходности.MVn <> 0 Тогда
			Возврат СтрокаДоходности.Период;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаСервере
Процедура СвернутьПоСтрокам(Соединение, Данные, ИтогиМандатов, Особая)

	Для Каждого СтрокаДоходности Из Данные Цикл
		КлючМандата = Соединение.XMLСтрока(СтрокаДоходности.Разделитель);
		ИтогМандата = ИтогиМандатов.Получить(КлючМандата);
		Если ИтогМандата = Неопределено Тогда
			ИтогМандата = Новый Структура("ПериодПервогоMV, TWR_Бенчмарк, Rn_НакопленныйБенчмарк", Неопределено, 0, 1);
			ИтогиМандатов.Вставить(КлючМандата, ИтогМандата);
		КонецЕсли;

		MVn = СтрокаДоходности.MVn;
		Если Не ЗначениеЗаполнено(ИтогМандата.ПериодПервогоMV) И MVn <> 0 Тогда
			ИтогМандата.ПериодПервогоMV = СтрокаДоходности.Период;
		КонецЕсли;

		Если Особая Тогда
			Делитель = СтрокаДоходности.IO + СтрокаДоходности.MVn_1;
			Если Делитель <> 0 Тогда
				СтрокаДоходности.Rn_Бенчмарк = MVn / Делитель;
			Иначе
				СтрокаДоходности.Rn_Бенчмарк = 1;
			КонецЕсли;
			ИтогМандата.Rn_НакопленныйБенчмарк = ИтогМандата.Rn_НакопленныйБенчмарк * СтрокаДоходности.Rn_Бенчмарк;
			СтрокаДоходности.TWR_Бенчмарк = ИтогМандата.Rn_НакопленныйБенчмарк - 1;
			ИтогМандата.TWR_Бенчмарк = СтрокаДоходности.TWR_Бенчмарк;
		Иначе
			ИтогМандата.TWR_Бенчмарк = СтрокаДоходности.TWR_Бенчмарк;
		КонецЕсли;
	КонецЦикла;
	СтрокаДоходности = Неопределено;

КонецПроцедуры

&НаСервере
Функция ДоходностьГодовая(ПериодПервого, TWR, КонецПериода)

	Если Не ЗначениеЗаполнено(ПериодПервого) Тогда
		Возврат 0;
	КонецЕсли;

	Дней = КалендарныеГрафикиПовтИсп.РазностьДатВКалендарныхДнях(ПериодПервого, КонецПериода) + 1;
	Если Дней = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат TWR * (365 / Дней) * 100;

КонецФункции

&НаСервере
Процедура СравнитьДоходность(Старые, Новые, Итог)

	МаксРазница = 0;
	Расхождений = 0;
	СуммаСтарая = 0;
	СуммаНовая = 0;

	Для Каждого КлючИЗначение Из Старые Цикл
		Старая = КлючИЗначение.Значение;
		Новая = Новые.Получить(КлючИЗначение.Ключ);
		Если Новая = Неопределено Тогда
			Новая = 0;
		КонецЕсли;
		СуммаСтарая = СуммаСтарая + Старая;
		СуммаНовая = СуммаНовая + Новая;
		Разница = Макс(Старая - Новая, Новая - Старая);
		Если Разница > 0.0000001 Тогда
			Расхождений = Расхождений + 1;
		КонецЕсли;
		Если Разница > МаксРазница Тогда
			МаксРазница = Разница;
		КонецЕсли;
	КонецЦикла;

	Итог.СуммаСтарая = СуммаСтарая;
	Итог.СуммаНовая = СуммаНовая;
	Итог.Расхождений = Расхождений;
	Итог.МаксРазница = МаксРазница;

КонецПроцедуры

&НаСервере
Функция КлючиМандатов(Соединение, Мандаты)

	Ключи = Новый Соответствие;
	Для Индекс = 0 По Мандаты.Количество() - 1 Цикл
		Мандат = Мандаты[Индекс];
		Ключи.Вставить(Соединение.XMLСтрока(Мандат), Мандат);
	КонецЦикла;
	Мандат = Неопределено;
	Возврат Ключи;

КонецФункции

&НаСервере
Функция ПрочитатьСостав(Соединение, НомераДоговоров, НачалоTWR, КонецОкна)

	Номера = Соединение.NewObject("Массив");
	Для Каждого Номер Из НомераДоговоров Цикл
		Номера.Добавить(Номер);
	КонецЦикла;

	Запрос = Соединение.NewObject("Запрос");
	Запрос.Текст = ТекстЗапросаПоТипуУчета(ТекстЗапросаСостава());
	Запрос.УстановитьПараметр("НомераДоговоров", Номера);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ДатаНачала", НачалоTWR);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецОкна);
	Результат = Запрос.Выполнить().Выгрузить();

	Состав = Новый ТаблицаЗначений;
	Состав.Колонки.Добавить("Код");
	Состав.Колонки.Добавить("Наименование");
	Состав.Колонки.Добавить("Стратегия");
	Состав.Колонки.Добавить("Мандат");
	Состав.Колонки.Добавить("Дней", Новый ОписаниеТипов("Число"));

	Для Каждого СтрокаМО Из Результат Цикл
		Если Не ЗначениеЗаполнено(СтрокаМО.ИдентификаторСтратегии) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Состав.Добавить();
		НоваяСтрока.Код = СтрокаМО.ИдентификаторСтратегии;
		НоваяСтрока.Наименование = СтрокаМО.НаименованиеСтратегии;
		НоваяСтрока.Стратегия = СтрокаМО.Стратегия;
		НоваяСтрока.Мандат = СтрокаМО.Мандат;
		НоваяСтрока.Дней = СтрокаМО.Дней;
	КонецЦикла;

	СтрокаМО = Неопределено;
	Результат = Неопределено;
	Номера = Неопределено;
	Возврат Состав;

КонецФункции

&НаСервере
Функция СтратегииДляЗамера(Соединение, Состав)

	ОтобранныеКоды = РазобратьКоды();
	Группы = Новый Соответствие;

	Для Каждого СтрокаСостава Из Состав Цикл
		Группа = Группы.Получить(СтрокаСостава.Код);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура;
			Группа.Вставить("Код", СтрокаСостава.Код);
			Группа.Вставить("Наименование", СтрокаСостава.Наименование);
			Группа.Вставить("Стратегия", "");
			Группа.Вставить("ЕстьСтратегия", Ложь);
			Группа.Вставить("Особая", ОсобаяСтратегия(СтрокаСостава.Код));
			Группа.Вставить("Строки", Новый ТаблицаЗначений);
			Группа.Строки.Колонки.Добавить("Мандат");
			Группа.Строки.Колонки.Добавить("Дней", Новый ОписаниеТипов("Число"));
			Группа.Вставить("Ключи", Новый Соответствие);
			Группы.Вставить(СтрокаСостава.Код, Группа);
		КонецЕсли;

		Ключ = Соединение.XMLСтрока(СтрокаСостава.Мандат);
		Если Группа.Ключи.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Группа.Ключи.Вставить(Ключ, Истина);
		НоваяСтрока = Группа.Строки.Добавить();
		НоваяСтрока.Мандат = СтрокаСостава.Мандат;
		НоваяСтрока.Дней = СтрокаСостава.Дней;
		Если Не Группа.ЕстьСтратегия
			И (ТипЗнч(СтрокаСостава.Стратегия) <> Тип("Строка") Или ЗначениеЗаполнено(СтрокаСостава.Стратегия)) Тогда
			Группа.Стратегия = СтрокаСостава.Стратегия;
			Группа.ЕстьСтратегия = Истина;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого КлючИГруппа Из Группы Цикл
		Группа = КлючИГруппа.Значение;
		Мандатов = Группа.Строки.Количество();
		Если ОтобранныеКоды.Количество() > 0 Тогда
			Если ОтобранныеКоды.Получить(ВРег(Группа.Код)) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли ТолькоКрупнееВыборки И Мандатов <= РазмерВыборки Тогда
			Продолжить;
		КонецЕсли;

		Группа.Строки.Сортировать("Дней Убыв");
		ДнейСтратегии = 0;
		Для Каждого СтрокаМандата Из Группа.Строки Цикл
			ДнейСтратегии = ДнейСтратегии + СтрокаМандата.Дней;
		КонецЦикла;

		Предел = Мин(РазмерВыборки, Мандатов);
		Мандаты = Новый Массив;
		Для Индекс = 0 По Предел - 1 Цикл
			Мандаты.Добавить(Группа.Строки[Индекс].Мандат);
		КонецЦикла;

		Описание = Новый Структура;
		Описание.Вставить("Код", Группа.Код);
		Описание.Вставить("Наименование", Группа.Наименование);
		Описание.Вставить("Стратегия", Группа.Стратегия);
		Описание.Вставить("Особая", Группа.Особая);
		Описание.Вставить("МандатовСтратегии", Мандатов);
		Описание.Вставить("ДнейСтратегии", ДнейСтратегии);
		Описание.Вставить("Мандаты", Мандаты);
		Результат.Добавить(Описание);
		Группа.Строки = Неопределено;
		Группа.Ключи = Неопределено;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ТекстЗапросаСостава()

	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Мандаты.Ссылка КАК Мандат,
	|	Мандаты.НомерДоговора КАК НомерДоговора,
	|	ДействующиеФинПланыСрезПоследних.ФинансовыйПлан КАК ФинансовыйПлан
	|ПОМЕСТИТЬ ВТ_ФинПлатыМандатов
	|ИЗ
	|	Справочник.Мандаты КАК Мандаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеФинПланы.СрезПоследних(&КонецПериода, Мандат.НомерДоговора В (&НомераДоговоров)) КАК ДействующиеФинПланыСрезПоследних
	|		ПО (ДействующиеФинПланыСрезПоследних.Мандат = Мандаты.Ссылка)
	|ГДЕ
	|	Мандаты.НомерДоговора В(&НомераДоговоров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,
	|	ВТ_ФинПлатыМандатов.НомерДоговора КАК НомерДоговора,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|		КОНЕЦ) КАК Стратегия
	|ПОМЕСТИТЬ ВТ_ИндивидуальныеСтратегииМандатов
	|ИЗ
	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий
	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ФинПлатыМандатов.НомерДоговора,
	|	ВТ_ФинПлатыМандатов.Мандат
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|		КОНЕЦ) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,
	|	ВЫБОР
	|		КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|			ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|		ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|	КОНЕЦ КАК Стратегия,
	|	ВЫБОР
	|		КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|			ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель.КодСтратегии
	|		ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия.КодСтратегии
	|	КОНЕЦ КАК ИдентификаторСтратегии,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Стратегии.НаименованиеАнгл, """") = """"
	|			ТОГДА ЕСТЬNULL(Стратегии.Наименование, """")
	|		ИНАЧЕ Стратегии.НаименованиеАнгл
	|	КОНЕЦ КАК НаименованиеСтратегии
	|ПОМЕСТИТЬ ВТ_СтрокиСостава
	|ИЗ
	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Стратегии КАК Стратегии
	|			ПО ФинансовыеПланыСоставСтратегий.Стратегия = Стратегии.Ссылка
	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка
	|ГДЕ
	|	НЕ ВТ_ФинПлатыМандатов.НомерДоговора В
	|				(ВЫБРАТЬ
	|					ВТ.НомерДоговора
	|				ИЗ
	|					ВТ_ИндивидуальныеСтратегииМандатов КАК ВТ)
	|	И НЕ (ЕСТЬNULL(Стратегии.Закрыта, ЛОЖЬ)
	|			И ЕСТЬNULL(Стратегии.ОтображатьНулевуюДоходность, ЛОЖЬ))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ИндивидуальныеСтратегииМандатов.Мандат,
	|	ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка),
	|	""IS-001"",
	|	""Индивидуальная стратегия""
	|ИЗ
	|	ВТ_ИндивидуальныеСтратегииМандатов КАК ВТ_ИндивидуальныеСтратегииМандатов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РыночнаяСтоимостьПозиции.Мандат КАК Мандат,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РыночнаяСтоимостьПозиции.Период) КАК Дней
	|ПОМЕСТИТЬ ВТ_ДниМандатов
	|ИЗ
	|	РегистрСведений.РыночнаяСтоимостьПозиции КАК РыночнаяСтоимостьПозиции
	|ГДЕ
	|	РыночнаяСтоимостьПозиции.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1) И &ДатаОкончания
	|	И РыночнаяСтоимостьПозиции.Мандат.НомерДоговора В (&НомераДоговоров)
	|СГРУППИРОВАТЬ ПО
	|	РыночнаяСтоимостьПозиции.Мандат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СтрокиСостава.ИдентификаторСтратегии КАК ИдентификаторСтратегии,
	|	ВТ_СтрокиСостава.НаименованиеСтратегии КАК НаименованиеСтратегии,
	|	ВТ_СтрокиСостава.Стратегия КАК Стратегия,
	|	ВТ_СтрокиСостава.Мандат КАК Мандат,
	|	ЕСТЬNULL(ВТ_ДниМандатов.Дней, 0) КАК Дней
	|ИЗ
	|	ВТ_СтрокиСостава КАК ВТ_СтрокиСостава
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДниМандатов КАК ВТ_ДниМандатов
	|		ПО ВТ_СтрокиСостава.Мандат = ВТ_ДниМандатов.Мандат";

КонецФункции

&НаСервере
Функция ТекстЗапросаПоТипуУчета(ТекстЗапроса)

	Если ПлановыйУчет Тогда
		Возврат СтрЗаменить(ТекстЗапроса, "РыночнаяСтоимостьПозиции", "РыночнаяСтоимостьПлановойПозиции");
	КонецЕсли;
	Возврат ТекстЗапроса;

КонецФункции

&НаСервере
Функция НомераДоговоровОтчета()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоговорДУ.Код КАК Код
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорДУ
	|ГДЕ
	|	ДоговорДУ.ТипКлиентаДУ В (&ТипыКлиентовДУ)
	|	И ДоговорДУ.УправляющаяКомпания = &УправляющаяКомпания
	|	И ДоговорДУ.ПометкаУдаления = ЛОЖЬ
	|	И ДоговорДУ.Код <> """"
	|	И ВЫБОР
	|			КОГДА &ИсключитьЦессии
	|				ТОГДА ДоговорДУ.ДатаЦессии = ДАТАВРЕМЯ(1, 1, 1)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И (ДоговорДУ.ДатаВводаСредствВДУ МЕЖДУ &НачалоПериода И &КонецПериода
	|				И ДоговорДУ.ДатаНачала <= &КонецПериода
	|				И (ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДоговорДУ.ДатаОкончания > &КонецПериода
	|					ИЛИ ДоговорДУ.ДатаОкончания МЕЖДУ ДоговорДУ.ДатаНачала И &КонецПериода)
	|			ИЛИ ДоговорДУ.ДатаОкончания <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаВводаСредствВДУ <> ДАТАВРЕМЯ(1, 1, 1)
	|				И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) <= &КонецПериода
	|				И КОНЕЦПЕРИОДА(ДоговорДУ.ДатаОкончания, ДЕНЬ) МЕЖДУ &НачалоПериода И &КонецПериода
	|				И ДоговорДУ.ДатаВводаСредствВДУ <= &КонецПериода
	|			ИЛИ (ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДоговорДУ.ДатаОкончания > &КонецПериода)
	|				И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) <= &КонецПериода
	|				И ДоговорДУ.ДатаВводаСредствВДУ <= &КонецПериода
	|				И ДоговорДУ.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаВводаСредствВДУ <> ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДоговорДУ.ДатаОкончания <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаОкончания < &НачалоПериода
	|				И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) < &НачалоПериода
	|				И ДоговорДУ.ДатаВводаСредствВДУ <= &НачалоПериода
	|				И ДоговорДУ.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаВводаСредствВДУ <> ДАТАВРЕМЯ(1, 1, 1))";

	Запрос.УстановитьПараметр("ТипыКлиентовДУ", ТипыКлиентовДУ());
	Запрос.УстановитьПараметр("УправляющаяКомпания", УправляющаяКомпания);
	Запрос.УстановитьПараметр("ИсключитьЦессии", ИсключитьЦессии);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код");

