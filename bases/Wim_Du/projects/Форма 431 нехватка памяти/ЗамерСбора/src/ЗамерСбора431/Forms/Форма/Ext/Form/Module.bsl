&НаСервере
Процедура ВывестиОтчет(Итоги, КоличествоДоговоров, НачалоTWR, КонецTWR, ВыборкаОграничена)

	Итоги.Сортировать("СтрокTWR Убыв");
	Таб = Новый ТабличныйДокумент;

	Таб.Область(1, 1).Текст = "Замер сбора TWR. Полный старый вызов по стратегии не выполнялся.";
	Таб.Область(2, 1).Текст = "Период отчета " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy")
		+ ". В TWR передано " + Формат(НачалоTWR, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(КонецTWR, "ДФ='dd.MM.yyyy HH:mm:ss'") + ".";
	Таб.Область(3, 1).Текст = "Договоров в отборе формы 431: " + Формат(КоличествоДоговоров, "ЧГ=0; ЧН=0")
		+ ". Учет: " + ?(ПлановыйУчет, "плановый", "фактический")
		+ ". Вознаграждение как пассив: " + ДаНет(ВознаграждениеКакПассив)
		+ ", комиссии как пассив: " + ДаНет(КомиссииКакПассив)
		+ ", НДФЛ как пассив: " + ДаНет(НДФЛКакПассив) + ".";
	Таб.Область(4, 1).Текст = "На каждую стратегию один вызов TWR по " + Формат(РазмерВыборки, "ЧГ=0")
		+ " мандатам с наибольшим числом дней оценки. На этой же таблице замерен старый сбор 1.07"
		+ " (индекс по ссылке мандата и расчет доходности) и новый сбор 1.08"
		+ " (свертка по позициям, для SS-010, SS-020 и SS-030 построчный обход)."
		+ " Новый сбор замеряется первым.";
	Таб.Область(5, 1).Текст = "Верхняя оценка 1.08 = (секунды TWR + секунды нового сбора) x число пачек."
		+ " Это потолок: в выборку взяты самые тяжелые мандаты, остальные пачки не тяжелее.";
	Если ВыборкаОграничена Тогда
		Таб.Область(6, 1).Текст = "Размер выборки был больше 500 и ограничен 500. "
			+ "Большая пачка на Т-1 может исчерпать память еще на вызове TWR.";
	КонецЕсли;

	НомерСтроки = 8;
	Заголовки = Новый Массив;
	Заголовки.Добавить("База");
	Заголовки.Добавить("Код");
	Заголовки.Добавить("Наименование");
	Заголовки.Добавить("Особая");
	Заголовки.Добавить("Мандатов");
	Заголовки.Добавить("В выборке");
	Заголовки.Добавить("Строк TWR");
	Заголовки.Добавить("Дней по стратегии");
	Заголовки.Добавить("Сек TWR");
	Заголовки.Добавить("Сек старый индекс");
	Заголовки.Добавить("Сек старый расчет");
	Заголовки.Добавить("Сек новый сбор");
	Заголовки.Добавить("Путь");
	Заголовки.Добавить("Сумма старая");
	Заголовки.Добавить("Сумма новая");
	Заголовки.Добавить("Расхождений");
	Заголовки.Добавить("Макс разница");
	Заголовки.Добавить("Верх сек 1.08");
	Заголовки.Добавить("Ошибка");
	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Таб.Область(НомерСтроки, Индекс + 1).Текст = Заголовки[Индекс];
	КонецЦикла;

	Для Каждого Итог Из Итоги Цикл
		НомерСтроки = НомерСтроки + 1;
		Таб.Область(НомерСтроки, 1).Текст = Итог.База;
		Таб.Область(НомерСтроки, 2).Текст = Итог.Код;
		Таб.Область(НомерСтроки, 3).Текст = Итог.Наименование;
		Таб.Область(НомерСтроки, 4).Текст = ?(Итог.Особая, "да", "");
		Таб.Область(НомерСтроки, 5).Текст = Формат(Итог.Мандатов, "ЧГ=0; ЧН=0");
		Таб.Область(НомерСтроки, 6).Текст = Формат(Итог.ВВыборке, "ЧГ=0; ЧН=0");
		Таб.Область(НомерСтроки, 7).Текст = Формат(Итог.СтрокTWR, "ЧГ=0; ЧН=0");
		Таб.Область(НомерСтроки, 8).Текст = Формат(Итог.ДнейСтратегии, "ЧГ=0; ЧН=0");
		Таб.Область(НомерСтроки, 9).Текст = Формат(Итог.СекTWR, "ЧДЦ=1; ЧН=0");
		Таб.Область(НомерСтроки, 10).Текст = Формат(Итог.СекИндекс, "ЧДЦ=1; ЧН=0");
		Таб.Область(НомерСтроки, 11).Текст = Формат(Итог.СекСтарыйРасчет, "ЧДЦ=1; ЧН=0");
		Таб.Область(НомерСтроки, 12).Текст = Формат(Итог.СекНовый, "ЧДЦ=1; ЧН=0");
		Таб.Область(НомерСтроки, 13).Текст = Итог.Путь;
		Таб.Область(НомерСтроки, 14).Текст = Формат(Итог.СуммаСтарая, "ЧДЦ=6; ЧН=0");
		Таб.Область(НомерСтроки, 15).Текст = Формат(Итог.СуммаНовая, "ЧДЦ=6; ЧН=0");
		Таб.Область(НомерСтроки, 16).Текст = Формат(Итог.Расхождений, "ЧГ=0; ЧН=0");
		Таб.Область(НомерСтроки, 17).Текст = Формат(Итог.МаксРазница, "ЧДЦ=8; ЧН=0");
		Таб.Область(НомерСтроки, 18).Текст = Формат(Итог.ВерхСек108, "ЧДЦ=0; ЧН=0");
		Таб.Область(НомерСтроки, 19).Текст = Итог.Ошибка;
	КонецЦикла;

	НомерСтроки = НомерСтроки + 2;
	Таб.Область(НомерСтроки, 1).Текст = "Выводы";
	Для Каждого Итог Из Итоги Цикл
		НомерСтроки = НомерСтроки + 1;
		Таб.Область(НомерСтроки, 1).Текст = ТекстВывода(Итог);
	КонецЦикла;

	ТаблицаОтчета = Таб;

КонецПроцедуры

&НаСервере
Функция ТекстВывода(Итог)

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат Итог.База + " / " + Итог.Код + ": замер не завершен. " + Итог.Ошибка;
	КонецЕсли;

	СтарыйСбор = Итог.СекИндекс + Итог.СекСтарыйРасчет;
	Текст = Итог.Код + " (" + Итог.База + ")"
		+ ?(Итог.Особая, ", особая стратегия", ", обычная стратегия")
		+ ". Выборка " + Формат(Итог.ВВыборке, "ЧГ=0") + " из " + Формат(Итог.Мандатов, "ЧГ=0")
		+ " мандатов, строк TWR " + Формат(Итог.СтрокTWR, "ЧГ=0") + ". "
		+ "TWR " + Формат(Итог.СекTWR, "ЧДЦ=1; ЧН=0") + " с. "
		+ "Старый сбор " + Формат(СтарыйСбор, "ЧДЦ=1; ЧН=0") + " с (индекс "
		+ Формат(Итог.СекИндекс, "ЧДЦ=1; ЧН=0") + ", расчет "
		+ Формат(Итог.СекСтарыйРасчет, "ЧДЦ=1; ЧН=0") + "). "
		+ "Новый сбор " + Формат(Итог.СекНовый, "ЧДЦ=1; ЧН=0") + " с, путь: " + Итог.Путь + ". ";

	Если Итог.СтрокTWR > 0 Тогда
		Текст = Текст + "На 1000 строк: старый сбор "
			+ Формат(СтарыйСбор / Итог.СтрокTWR * 1000, "ЧДЦ=2; ЧН=0")
			+ " с, новый сбор "
			+ Формат(Итог.СекНовый / Итог.СтрокTWR * 1000, "ЧДЦ=2; ЧН=0") + " с. ";
	КонецЕсли;

	Если Итог.Расхождений = 0 Тогда
		Текст = Текст + "Доходность совпала, сумма " + Формат(Итог.СуммаНовая, "ЧДЦ=4; ЧГ=0") + ". ";
	Иначе
		Текст = Текст + "Расхождений доходности " + Формат(Итог.Расхождений, "ЧГ=0")
			+ ", максимум " + Формат(Итог.МаксРазница, "ЧДЦ=8; ЧГ=0") + ". ";
	КонецЕсли;

	Текст = Текст + "Пачек по " + Формат(РазмерВыборки, "ЧГ=0") + ": " + Формат(ЧислоПачек(Итог.Мандатов), "ЧГ=0")
		+ ". Верхняя оценка всего прохода 1.08: " + Формат(Итог.ВерхСек108, "ЧДЦ=0; ЧН=0")
		+ " с. Старый вызов на все мандаты стратегии не выполнялся.";
	Возврат Текст;

КонецФункции

&НаСервере
Функция ДаНет(Значение)

	Возврат ?(Значение, "да", "нет");

КонецФункции

// Собирает текст лога из таблицы отчета и кладет файл во временное хранилище формы.
//
// Возвращаемое значение:
//  Структура:
//   * Адрес    - Строка - адрес двоичных данных файла
//   * ИмяФайла - Строка - предлагаемое имя файла
//
&НаСервере
Функция ФайлЛогаНаСервере()

	Строки = Новый Массив;
	Строки.Добавить("Замер сбора TWR формы 431");
	Строки.Добавить("Сформирован: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'")
		+ "; пользователь: " + ИмяПользователя());
	Строки.Добавить("Параметры: период " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy")
		+ "; УК: " + Строка(УправляющаяКомпания)
		+ "; база МО: " + ?(ЗначениеЗаполнено(БазаМО), Строка(БазаМО), "по умолчанию")
		+ "; выборка: " + Формат(РазмерВыборки, "ЧГ=0")
		+ "; коды: " + ?(ЗначениеЗаполнено(КодыСтратегий), КодыСтратегий, "по флагу крупных")
		+ "; только крупнее выборки: " + ДаНет(ТолькоКрупнееВыборки)
		+ "; плановый учет: " + ДаНет(ПлановыйУчет));
	Строки.Добавить("");

	Для НомерСтроки = 1 По ТаблицаОтчета.ВысотаТаблицы Цикл
		Ячейки = Новый Массив;
		Для НомерКолонки = 1 По ТаблицаОтчета.ШиринаТаблицы Цикл
			Ячейки.Добавить(ТаблицаОтчета.Область(НомерСтроки, НомерКолонки).Текст);
		КонецЦикла;
		Строки.Добавить(СокрП(СтрСоединить(Ячейки, Символы.Таб)));
	КонецЦикла;

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Строки, Символы.ВК + Символы.ПС), КодировкаТекста.UTF8);
	Результат = Новый Структура;
	Результат.Вставить("Адрес", ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор));
	Результат.Вставить("ИмяФайла", "ЗамерСбора431_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt");
	Возврат Результат;

КонецФункции

