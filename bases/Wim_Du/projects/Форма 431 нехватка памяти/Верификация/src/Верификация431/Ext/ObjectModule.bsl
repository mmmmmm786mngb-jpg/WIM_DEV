#Область ОписаниеПеременных

// Настройки, которые читает код версии 1.08. Имена совпадают с реквизитами обработки заполнения 0420431,
// поэтому область РасчетTWRПачками ниже перенесена из модуля 1.08 без изменений (кроме размера пачки).
Перем ТипУчета;
Перем ВознаграждениеКакПассив;
Перем КоммисияКакПассив;
Перем НДФЛКакПассив;
Перем РазмерПачкиПроверки;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает настройки расчета, как в обработке заполнения 0420431.
//
// Параметры:
//  ПлановыйУчет   - Булево - Истина соответствует ТипУчета "Плановый"
//  Вознаграждение - Булево - вознаграждение как пассив
//  Комиссии       - Булево - комиссии как пассив
//  НДФЛ           - Булево - НДФЛ как пассив
//  РазмерПачки    - Число - мандатов в одном вызове TWR для версии 1.08
//
Процедура УстановитьНастройки(ПлановыйУчет, Вознаграждение, Комиссии, НДФЛ, РазмерПачки) Экспорт

	Если ПлановыйУчет Тогда
		ТипУчета = "Плановый";
	Иначе
		ТипУчета = "Фактический";
	КонецЕсли;
	ВознаграждениеКакПассив = Вознаграждение;
	КоммисияКакПассив       = Комиссии;
	НДФЛКакПассив           = НДФЛ;
	РазмерПачкиПроверки     = РазмерПачки;

КонецПроцедуры

// Считает доходность мандатов кодом версии 1.07: один вызов TWR на все мандаты, индекс строк по мандату
// (COM-соответствие), для особых стратегий произведение Rn с записью в строку МО, дни от первой ненулевой оценки.
//
// Параметры:
//  Соединение     - COMОбъект - внешнее соединение с МО
//  МассивМандатов - COMОбъект - Массив МО со ссылками мандатов
//  Мандаты        - Массив - те же ссылки для обхода на стороне ДУ
//  Стратегия      - COMОбъект, Неопределено - стратегия МО, как в заполнении
//  НачалоTWR      - Дата
//  КонецПериода   - Дата - конец периода отчета
//  Особая         - Булево - SS-010, SS-020, SS-030
//
// Возвращаемое значение:
//  Структура:
//   * Доходности - Соответствие - ключ XMLСтрока мандата, значение доходность в процентах
//   * СтрокTWR   - Число - строк в результате TWR
//   * СекTWR     - Число - время вызова TWR
//   * СекСбора   - Число - время индекса и расчета доходности
//
Функция РасчетВерсии107(Соединение, МассивМандатов, Мандаты, Стратегия, НачалоTWR, КонецПериода, Особая) Экспорт

	Результат = Новый Структура("Доходности, СтрокTWR, СекTWR, СекСбора", Новый Соответствие, 0, 0, 0);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Группировка = "MANDATE";
	ДанныеДоходности = Соединение.ВТБ_РасчетДоходностиСервер.TWR(НачалоTWR, КонецПериода,
		Соединение.Справочники.Валюты.RUB, ВознаграждениеКакПассив, ?(ТипУчета = "Плановый", Истина, Ложь),
		МассивМандатов, Стратегия, Группировка, КоммисияКакПассив, НДФЛКакПассив,);
	Результат.СекTWR = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
	Результат.СтрокTWR = ДанныеДоходности.Количество();

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДоходностьПоМандатам = Соединение.NewObject("Соответствие");
	Для Каждого СтрокаДоходности Из ДанныеДоходности Цикл
		Мандат = СтрокаДоходности.Разделитель;
		СтрокиМандата = ДоходностьПоМандатам.Получить(Мандат);
		Если СтрокиМандата = Неопределено Тогда
			СтрокиМандата = Соединение.NewObject("Массив");
			ДоходностьПоМандатам.Вставить(Мандат, СтрокиМандата);
		КонецЕсли;
		СтрокиМандата.Добавить(СтрокаДоходности);
	КонецЦикла;

	Для Каждого Мандат Из Мандаты Цикл
		ДоходностьСтратегии = 0;
		СтрокиДоходности = ДоходностьПоМандатам.Получить(Мандат);
		Если СтрокиДоходности <> Неопределено И СтрокиДоходности.Количество() <> 0 Тогда
			Если Особая Тогда
				Rn_НакопленныйБенчмарк = 1;
				Для Каждого ТСтрока Из СтрокиДоходности Цикл
					Если (ТСтрока.IO + ТСтрока.MVn_1) <> 0 Тогда
						ТСтрока.Rn_Бенчмарк = ТСтрока.MVn / (ТСтрока.IO + ТСтрока.MVn_1);
					Иначе
						ТСтрока.Rn_Бенчмарк = 1;
					КонецЕсли;
					Rn_НакопленныйБенчмарк = Rn_НакопленныйБенчмарк * ТСтрока.Rn_Бенчмарк;
					ТСтрока.TWR_Бенчмарк = Rn_НакопленныйБенчмарк - 1;
				КонецЦикла;
			КонецЕсли;
			ДнейВПериоде = КоличествоДнейВерсии107(СтрокиДоходности, КонецПериода);
			Если ДнейВПериоде <> 0 Тогда
				КоличествоСтрок = СтрокиДоходности.Количество() - 1;
				ДоходностьСтратегии = СтрокиДоходности.Получить(КоличествоСтрок).TWR_Бенчмарк * (365 / ДнейВПериоде) * 100;
			КонецЕсли;
		КонецЕсли;
		Результат.Доходности.Вставить(Соединение.XMLСтрока(Мандат), ДоходностьСтратегии);
	КонецЦикла;
	Результат.СекСбора = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;

	СтрокаДоходности = Неопределено;
	ТСтрока = Неопределено;
	СтрокиДоходности = Неопределено;
	СтрокиМандата = Неопределено;
	ДоходностьПоМандатам = Неопределено;
	ДанныеДоходности = Неопределено;

	Возврат Результат;

КонецФункции

// Считает доходность мандатов кодом версии 1.08: ИтогиTWRПоМандатамПачками и расчет по итогу мандата,
// как в процедуре СформироватьВТ_ДанныеПоСтратегиям обработки 1.08.
//
// Параметры:
//  Соединение, МассивМандатов, Мандаты, Стратегия, НачалоTWR, КонецПериода, Особая - см. РасчетВерсии107
//
// Возвращаемое значение:
//  Структура:
//   * Доходности - Соответствие - ключ XMLСтрока мандата, значение доходность в процентах
//   * Пачек      - Число - вызовов TWR
//   * Сек        - Число - время вызовов TWR и свертки вместе
//
Функция РасчетВерсии108(Соединение, МассивМандатов, Мандаты, Стратегия, НачалоTWR, КонецПериода, Особая) Экспорт

	Результат = Новый Структура("Доходности, Пачек, Сек", Новый Соответствие, 0, 0);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИтогиПоМандатам = ИтогиTWRПоМандатамПачками(Соединение, МассивМандатов, Стратегия, НачалоTWR, КонецПериода, Особая);

	Для Каждого Мандат Из Мандаты Цикл
		ДоходностьСтратегии = 0;
		Ключ = Соединение.XMLСтрока(Мандат);
		ИтогМандата = ИтогиПоМандатам.Получить(Ключ);
		Если ИтогМандата <> Неопределено И ИтогМандата.ПериодПервогоMV <> Неопределено Тогда
			ДнейВПериоде = КалендарныеГрафикиПовтИсп.РазностьДатВКалендарныхДнях(
				ИтогМандата.ПериодПервогоMV, КонецПериода) + 1;
			ДоходностьСтратегии = ИтогМандата.TWR_Бенчмарк * (365 / ДнейВПериоде) * 100;
		КонецЕсли;
		Результат.Доходности.Вставить(Ключ, ДоходностьСтратегии);
	КонецЦикла;
	Результат.Сек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
	Результат.Пачек = Цел((МассивМандатов.Количество() - 1) / РазмерПачкиПроверки) + 1;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область РасчетTWRПачками

// Форма431_Память ++
// Считает TWR стратегии пачками мандатов. Каждая пачка свертывается до итогов по мандату,
// таблица пачки освобождается до вызова следующей пачки. В памяти остаются только итоги.
//
// Параметры:
//  Соединение          - COMОбъект - внешнее соединение с МО
//  МассивМандатов      - COMОбъект - Массив МО со ссылками мандатов стратегии
//  Стратегия           - COMОбъект - ссылка стратегии МО
//  НачалоПериодаTWR    - Дата
//  КонецПериода        - Дата
//  ФлагОсобыеСтратегии - Булево - пересчитать TWR_Бенчмарк как MVn / (IO + MVn_1) (SS-010, SS-020, SS-030)
//
// Возвращаемое значение:
//  Соответствие - ключ XMLСтрока ссылки мандата, значение Структура:
//    * ПериодПервогоMV        - Дата, Неопределено - первый день с MVn <> 0
//    * TWR_Бенчмарк           - Число - значение на последний день периода
//    * Rn_НакопленныйБенчмарк - Число - служебное, произведение Rn_Бенчмарк для особых стратегий
//
Функция ИтогиTWRПоМандатамПачками(Соединение, МассивМандатов, Стратегия, НачалоПериодаTWR, КонецПериода,
	ФлагОсобыеСтратегии)

	ИтогиПоМандатам = Новый Соответствие;

	ВалютаRUB = Соединение.Справочники.Валюты.RUB;
	План = (ТипУчета = "Плановый");
	РазмерПорции = РазмерПорцииМандатовTWR();

	// Мандат входит в стратегию несколькими строками, если в составе финплана две строки одной стратегии
	// или двух дочерних стратегий одного родителя. Один вызов TWR с отбором "В списке" считал такой мандат
	// один раз; при делении на пачки копии могут попасть в разные пачки, и для SS-010, SS-020, SS-030
	// произведение Rn_Бенчмарк выполнилось бы дважды. Поэтому дубли убираются до деления на пачки.
	УникальныеМандаты = Соединение.NewObject("Массив");
	КлючиМандатов = Новый Соответствие;
	Для Индекс = 0 По МассивМандатов.Количество() - 1 Цикл
		Мандат = МассивМандатов.Получить(Индекс);
		КлючМандата = Соединение.XMLСтрока(Мандат);
		Если КлючиМандатов.Получить(КлючМандата) = Неопределено Тогда
			КлючиМандатов.Вставить(КлючМандата, Истина);
			УникальныеМандаты.Добавить(Мандат);
		КонецЕсли;
	КонецЦикла;

	КоличествоМандатов = УникальныеМандаты.Количество();
	ИндексМандата = 0;

	Пока ИндексМандата < КоличествоМандатов Цикл

		ПорцияМандатов = Соединение.NewObject("Массив");
		КонецПорции = Мин(ИндексМандата + РазмерПорции, КоличествоМандатов);
		Пока ИндексМандата < КонецПорции Цикл
			ПорцияМандатов.Добавить(УникальныеМандаты.Получить(ИндексМандата));
			ИндексМандата = ИндексМандата + 1;
		КонецЦикла;

		ДанныеПорции = Соединение.ВТБ_РасчетДоходностиСервер.TWR(НачалоПериодаTWR, КонецПериода,
			ВалютаRUB, ВознаграждениеКакПассив, План,
			ПорцияМандатов, Стратегия, "MANDATE", КоммисияКакПассив, НДФЛКакПассив);

		// Особые стратегии считаются по каждому дню, для них нужен обход всех строк.
		Если ФлагОсобыеСтратегии
			Или НЕ СвернутьПорциюПоПозициям(Соединение, ДанныеПорции, ИтогиПоМандатам) Тогда
			СвернутьПорциюПоСтрокам(Соединение, ДанныеПорции, ИтогиПоМандатам, ФлагОсобыеСтратегии);
		КонецЕсли;

		// Ссылки на таблицу пачки снимаются до следующего вызова TWR.
		ДанныеПорции = Неопределено;
		ПорцияМандатов = Неопределено;

	КонецЦикла;

	Возврат ИтогиПоМандатам;

КонецФункции

// Свертывает пачку до итогов по мандату без обхода всех строк. Строки пачки отсортированы в МО
// по Разделитель, Период, поэтому строки мандата идут подряд: число строк каждого мандата берется
// из свертки копии колонки Разделитель, по нему вычисляются позиции первой и последней строки мандата.
// Через COM читаются только эти строки - около 15 обращений на мандат вместо обращений на каждую строку.
// Если первая или последняя строка отрезка принадлежит другому мандату (строки не подряд или
// Свернуть изменила порядок групп), итоги пачки не записываются и возвращается Ложь.
//
// Параметры:
//  Соединение      - COMОбъект - внешнее соединение с МО
//  ДанныеПорции    - COMОбъект - ТаблицаЗначений МО, результат TWR пачки
//  ИтогиПоМандатам - Соответствие - см. ИтогиTWRПоМандатамПачками, дополняется итогами пачки
//
// Возвращаемое значение:
//  Булево - Истина, если пачка свернута; Ложь - пачку нужно свернуть обходом строк
//
Функция СвернутьПорциюПоПозициям(Соединение, ДанныеПорции, ИтогиПоМандатам)

	КоличествоСтрок = ДанныеПорции.Количество();

	СтрокиПоМандатам = ДанныеПорции.Скопировать(, "Разделитель");
	СтрокиПоМандатам.Колонки.Добавить("КоличествоСтрок", Соединение.NewObject("ОписаниеТипов", "Число"));
	СтрокиПоМандатам.ЗаполнитьЗначения(1, "КоличествоСтрок");
	СтрокиПоМандатам.Свернуть("Разделитель", "КоличествоСтрок");

	ИтогиПорции = Новый Соответствие;
	ПорядокСовпал = Истина;
	Позиция = 0;

	Для Каждого СтрокаМандата Из СтрокиПоМандатам Цикл

		КлючМандата = Соединение.XMLСтрока(СтрокаМандата.Разделитель);
		ПоследняяПозиция = Позиция + СтрокаМандата.КоличествоСтрок - 1;
		Если ПоследняяПозиция >= КоличествоСтрок Тогда
			ПорядокСовпал = Ложь;
			Прервать;
		КонецЕсли;

		ПерваяСтрока = ДанныеПорции.Получить(Позиция);
		ПоследняяСтрока = ДанныеПорции.Получить(ПоследняяПозиция);
		Если Соединение.XMLСтрока(ПерваяСтрока.Разделитель) <> КлючМандата
			Или Соединение.XMLСтрока(ПоследняяСтрока.Разделитель) <> КлючМандата Тогда
			ПорядокСовпал = Ложь;
			Прервать;
		КонецЕсли;

		ИтогМандата = Новый Структура("ПериодПервогоMV, TWR_Бенчмарк, Rn_НакопленныйБенчмарк", Неопределено, 0, 1);
		Если ПерваяСтрока.MVn <> 0 Тогда
			ИтогМандата.ПериодПервогоMV = ПерваяСтрока.Период;
		Иначе
			ИтогМандата.ПериодПервогоMV = ПериодПервогоНенулевогоMV(ДанныеПорции, Позиция + 1, ПоследняяПозиция);
		КонецЕсли;
		ИтогМандата.TWR_Бенчмарк = ПоследняяСтрока.TWR_Бенчмарк;
		ИтогиПорции.Вставить(КлючМандата, ИтогМандата);

		Позиция = ПоследняяПозиция + 1;

	КонецЦикла;

	СтрокаМандата = Неопределено;
	ПерваяСтрока = Неопределено;
	ПоследняяСтрока = Неопределено;
	СтрокиПоМандатам = Неопределено;

	Если НЕ ПорядокСовпал Или Позиция <> КоличествоСтрок Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КлючИЗначение Из ИтогиПорции Цикл
		ИтогиПоМандатам.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Ищет первую строку мандата с ненулевой оценкой в отрезке строк пачки. Сейчас МО не включает
// в результат дни до первой ненулевой оценки, функция страхует от изменения этого поведения.
//
// Параметры:
//  ДанныеПорции     - COMОбъект - ТаблицаЗначений МО, результат TWR пачки
//  НачальнаяПозиция - Число - индекс первой просматриваемой строки
//  КонечнаяПозиция  - Число - индекс последней строки мандата
//
// Возвращаемое значение:
//  Дата, Неопределено - Период первой строки с MVn <> 0; Неопределено, если такой строки нет
//
Функция ПериодПервогоНенулевогоMV(ДанныеПорции, НачальнаяПозиция, КонечнаяПозиция)

	Для Позиция = НачальнаяПозиция По КонечнаяПозиция Цикл
		СтрокаДоходности = ДанныеПорции.Получить(Позиция);
		Если СтрокаДоходности.MVn <> 0 Тогда
			Возврат СтрокаДоходности.Период;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Свертывает пачку до итогов по мандату обходом всех строк. Нужна для особых стратегий и для пачки,
// которую не удалось свернуть по позициям.
//
// Параметры:
//  Соединение          - COMОбъект - внешнее соединение с МО
//  ДанныеПорции        - COMОбъект - ТаблицаЗначений МО, результат TWR пачки
//  ИтогиПоМандатам     - Соответствие - см. ИтогиTWRПоМандатамПачками, дополняется итогами пачки
//  ФлагОсобыеСтратегии - Булево - пересчитать TWR_Бенчмарк как MVn / (IO + MVn_1)
//
Процедура СвернутьПорциюПоСтрокам(Соединение, ДанныеПорции, ИтогиПоМандатам, ФлагОсобыеСтратегии)

	// Строки пачки отсортированы в МО по Разделитель, Период: последняя строка мандата - конец периода
	Для Каждого СтрокаДоходности Из ДанныеПорции Цикл

		КлючМандата = Соединение.XMLСтрока(СтрокаДоходности.Разделитель);
		ИтогМандата = ИтогиПоМандатам.Получить(КлючМандата);
		Если ИтогМандата = Неопределено Тогда
			ИтогМандата = Новый Структура("ПериодПервогоMV, TWR_Бенчмарк, Rn_НакопленныйБенчмарк", Неопределено, 0, 1);
			ИтогиПоМандатам.Вставить(КлючМандата, ИтогМандата);
		КонецЕсли;

		MVn = СтрокаДоходности.MVn;
		Если ИтогМандата.ПериодПервогоMV = Неопределено И MVn <> 0 Тогда
			ИтогМандата.ПериодПервогоMV = СтрокаДоходности.Период;
		КонецЕсли;

		// Rn_Бенчмарк и TWR_Бенчмарк пишутся в строку таблицы МО и читаются из нее, как в версии 1.07:
		// прочитанное из строки значение ограничено по разрядности, поэтому результат совпадает с 1.07.
		Если ФлагОсобыеСтратегии Тогда
			Делитель = СтрокаДоходности.IO + СтрокаДоходности.MVn_1;
			Если Делитель <> 0 Тогда
				СтрокаДоходности.Rn_Бенчмарк = MVn / Делитель;
			Иначе
				СтрокаДоходности.Rn_Бенчмарк = 1;
			КонецЕсли;
			ИтогМандата.Rn_НакопленныйБенчмарк = ИтогМандата.Rn_НакопленныйБенчмарк * СтрокаДоходности.Rn_Бенчмарк;
			СтрокаДоходности.TWR_Бенчмарк = ИтогМандата.Rn_НакопленныйБенчмарк - 1;
			ИтогМандата.TWR_Бенчмарк = СтрокаДоходности.TWR_Бенчмарк;
		Иначе
			ИтогМандата.TWR_Бенчмарк = СтрокаДоходности.TWR_Бенчмарк;
		КонецЕсли;

	КонецЦикла;

	// Переменная цикла держит COM-ссылку на последнюю строку, а через нее всю таблицу пачки.
	СтрокаДоходности = Неопределено;

КонецПроцедуры

// Количество мандатов в одном вызове TWR: реквизит настроек РазмерПачкиTWR, при 0 - 1000.
// 1000 мандатов за полный год - около 2 ГБ памяти вызова по замерам стенда; на Т-1 проходил вызов около 3,5 ГБ.
//
// Возвращаемое значение:
//  Число - размер пачки мандатов
//
Функция РазмерПорцииМандатовTWR()

	Возврат РазмерПачкиПроверки;

КонецФункции
// Форма431_Память --

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Копия функции КоличествоДнейВПериодеОтчёта версии 1.07 (после IMAPPS-37703).
//
// Параметры:
//  ДанныеДоходностиТабЗнач - COMОбъект - строки доходности мандата
//  КонецПериода            - Дата
//
// Возвращаемое значение:
//  Число - дней от первой строки с MVn <> 0 до конца периода, 0 если такой строки нет
//
Функция КоличествоДнейВерсии107(ДанныеДоходностиТабЗнач, КонецПериода)

	ДнейВПериоде = 0;
	Для Каждого СтрокаДанныеДоходности Из ДанныеДоходностиТабЗнач Цикл
		Если СтрокаДанныеДоходности.MVn <> 0 Тогда
			ДнейВПериоде = КалендарныеГрафикиПовтИсп.РазностьДатВКалендарныхДнях(
				СтрокаДанныеДоходности.Период, КонецПериода) + 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ДнейВПериоде;

КонецФункции

#КонецОбласти
