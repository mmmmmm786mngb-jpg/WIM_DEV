&НаСервере
Процедура ВывестиОтчет(СтрокиМандатов, Валюты, КоличествоДоговоров, НачалоTWR, КонецTWR)

	Итоги = СвернутьПоСтратегиям(СтрокиМандатов);
	Итоги.Сортировать("СтрокTWR Убыв");

	Таб = Новый ТабличныйДокумент;
	НомерСтроки = ВывестиСводку(Таб, Итоги, Валюты, СтрокиМандатов, КоличествоДоговоров, НачалоTWR, КонецTWR);
	НомерСтроки = НомерСтроки + 2;
	ВывестиСтратегии(Таб, Итоги, НомерСтроки);
	ТаблицаОтчета = Таб;

КонецПроцедуры

&НаСервере
Функция СвернутьПоСтратегиям(СтрокиМандатов)

	Итоги = Новый ТаблицаЗначений;
	Итоги.Колонки.Добавить("База");
	Итоги.Колонки.Добавить("Код");
	Итоги.Колонки.Добавить("Наименование");
	Итоги.Колонки.Добавить("Особая");
	Итоги.Колонки.Добавить("СтрокСостава");
	Итоги.Колонки.Добавить("Мандатов");
	Итоги.Колонки.Добавить("Дублей");
	Итоги.Колонки.Добавить("Разделителей");
	Итоги.Колонки.Добавить("СтрокTWR");
	Итоги.Колонки.Добавить("МаксВалют");
	Итоги.Колонки.Добавить("Пачек");
	Итоги.Колонки.Добавить("СтрокТяжелойПачки");
	Итоги.Колонки.Добавить("МБ_1_07");
	Итоги.Колонки.Добавить("МБ_1_08");

	УжеПосчитаны = Новый Соответствие;

	Для Каждого Ключ Из СтрокиМандатов Цикл
		КлючСтратегии = Ключ.База + "|" + Ключ.Код;
		Если УжеПосчитаны.Получить(КлючСтратегии) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеПосчитаны.Вставить(КлючСтратегии, Истина);

		Отбор = Новый Структура("База, Код", Ключ.База, Ключ.Код);
		Строки = СтрокиМандатов.НайтиСтроки(Отбор);
		Дни = Новый ТаблицаЗначений;
		Дни.Колонки.Добавить("Дней", Новый ОписаниеТипов("Число"));

		СтрокСостава = 0;
		Мандатов = 0;
		Разделителей = 0;
		СтрокTWR = 0;
		МаксВалют = 0;
		Для Каждого СтрокаМандата Из Строки Цикл
			СтрокСостава = СтрокСостава + СтрокаМандата.СтрокСостава;
			Мандатов = Мандатов + 1;
			Если СтрокаМандата.Дней > 0 Тогда
				Разделителей = Разделителей + 1;
				СтрокTWR = СтрокTWR + СтрокаМандата.Дней;
				Дни.Добавить().Дней = СтрокаМандата.Дней;
			КонецЕсли;
			МаксВалют = Макс(МаксВалют, СтрокаМандата.Валют);
		КонецЦикла;

		Пачек = ?(Мандатов = 0, 0, Цел((Мандатов - 1) / РазмерПачки) + 1);
		СтрокПачки = СтрокСамойТяжелойПачки(Дни);

		Итог = Итоги.Добавить();
		Итог.База = Ключ.База;
		Итог.Код = Ключ.Код;
		Итог.Наименование = Ключ.Наименование;
		Итог.Особая = (Ключ.Код = "SS-010" Или Ключ.Код = "SS-020" Или Ключ.Код = "SS-030");
		Итог.СтрокСостава = СтрокСостава;
		Итог.Мандатов = Мандатов;
		Итог.Дублей = СтрокСостава - Мандатов;
		Итог.Разделителей = Разделителей;
		Итог.СтрокTWR = СтрокTWR;
		Итог.МаксВалют = МаксВалют;
		Итог.Пачек = Пачек;
		Итог.СтрокТяжелойПачки = СтрокПачки;
		Итог.МБ_1_07 = ОценкаПамятиМБ(СтрокTWR);
		Итог.МБ_1_08 = ОценкаПамятиМБ(СтрокПачки);
	КонецЦикла;

	Возврат Итоги;

КонецФункции

&НаСервере
Функция СтрокСамойТяжелойПачки(Дни)

	Если Дни.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Дни.Сортировать("Дней Убыв");
	Сумма = 0;
	Предел = Мин(РазмерПачки, Дни.Количество());
	Для Индекс = 0 По Предел - 1 Цикл
		Сумма = Сумма + Дни[Индекс].Дней;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

&НаСервере
Функция ОценкаПамятиМБ(КоличествоСтрок)

	Если КоличествоСтрок = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ПостояннаяЧастьВызоваМБ() + КоличествоСтрок * КилобайтНаСтрокуTWR() / 1024;

КонецФункции

&НаСервере
Функция ВывестиСводку(Таб, Итоги, Валюты, СтрокиМандатов, КоличествоДоговоров, НачалоTWR, КонецTWR)

	Таб.Область(1, 1).Текст = "Сводка. TWR не вызывался.";
	Таб.Область(2, 1).Текст = "Период отчета " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy")
		+ ". Окно оценки TWR " + Формат(НачалоДня(НачалоTWR) - 86400, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(КонецTWR, "ДФ=dd.MM.yyyy") + ".";
	Таб.Область(3, 1).Текст = "Договоров в отборе формы 431: " + Формат(КоличествоДоговоров, "ЧГ=0");
	Таб.Область(4, 1).Текст = "При группировке MANDATE разделитель - это мандат. "
		+ "Строка результата TWR - один день одного разделителя после свертки валют.";
	Таб.Область(5, 1).Текст = "Число строк - верхняя оценка: дни, на которые в регистре есть запись. "
		+ "TWR отбрасывает дни до первой ненулевой оценки и не добавляет пустые дни. "
		+ "Отбор счетов из настроек отчета TWR здесь не применяется.";
	Таб.Область(6, 1).Текст = "Память: " + Формат(ПостояннаяЧастьВызоваМБ(), "ЧГ=0")
		+ " МБ + " + Формат(КилобайтНаСтрокуTWR(), "ЧДЦ=1; ЧГ=0")
		+ " КБ на строку. Коэффициент со стенда (2000 мандатов, 606604 строки, пик 3670 МБ). "
		+ "Вводы-выводы в оценку не входят.";

	ВсегоМандатов = 0;
	ВсегоДублей = 0;
	ВсегоРазделителей = 0;
	ВсегоСтрок = 0;
	БольшеПачки = 0;
	МаксМБ = 0;
	МаксКод = "";
	Для Каждого Итог Из Итоги Цикл
		ВсегоМандатов = ВсегоМандатов + Итог.Мандатов;
		ВсегоДублей = ВсегоДублей + Итог.Дублей;
		ВсегоРазделителей = ВсегоРазделителей + Итог.Разделителей;
		ВсегоСтрок = ВсегоСтрок + Итог.СтрокTWR;
		Если Итог.Мандатов > РазмерПачки Тогда
			БольшеПачки = БольшеПачки + 1;
		КонецЕсли;
		Если Итог.МБ_1_07 > МаксМБ Тогда
			МаксМБ = Итог.МБ_1_07;
			МаксКод = Итог.База + " / " + Итог.Код;
		КонецЕсли;
	КонецЦикла;

	Таб.Область(8, 1).Текст = "Стратегий";
	Таб.Область(8, 2).Текст = Формат(Итоги.Количество(), "ЧГ=0");
	Таб.Область(9, 1).Текст = "Уникальных мандатов в составе";
	Таб.Область(9, 2).Текст = Формат(ВсегоМандатов, "ЧГ=0");
	Таб.Область(10, 1).Текст = "Лишних строк состава (дубли мандата в стратегии)";
	Таб.Область(10, 2).Текст = Формат(ВсегоДублей, "ЧГ=0");
	Таб.Область(11, 1).Текст = "Разделителей TWR (мандаты, у которых есть оценка)";
	Таб.Область(11, 2).Текст = Формат(ВсегоРазделителей, "ЧГ=0");
	Таб.Область(12, 1).Текст = "Оценка строк TWR по всем стратегиям";
	Таб.Область(12, 2).Текст = Формат(ВсегоСтрок, "ЧГ=0");
	Таб.Область(13, 1).Текст = "Стратегий больше размера пачки (" + Формат(РазмерПачки, "ЧГ=0") + ")";
	Таб.Область(13, 2).Текст = Формат(БольшеПачки, "ЧГ=0");
	Таб.Область(14, 1).Текст = "Самая тяжелая стратегия одним вызовом, МБ";
	Таб.Область(14, 2).Текст = Формат(МаксМБ, "ЧДЦ=0; ЧГ=0") + " (" + МаксКод + ")";

	НомерСтроки = 16;
	Таб.Область(НомерСтроки, 1).Текст = "Валюты регистра рыночной стоимости";
	НомерСтроки = НомерСтроки + 1;
	Таб.Область(НомерСтроки, 1).Текст = "База";
	Таб.Область(НомерСтроки, 2).Текст = "Валюта";
	Таб.Область(НомерСтроки, 3).Текст = "Мандатов";
	Таб.Область(НомерСтроки, 4).Текст = "Записей регистра";
	Таб.Область(НомерСтроки, 5).Текст = "Разных дней";
	Валюты.Сортировать("Записей Убыв");
	Для Каждого СтрокаВалюты Из Валюты Цикл
		НомерСтроки = НомерСтроки + 1;
		Таб.Область(НомерСтроки, 1).Текст = СтрокаВалюты.База;
		Таб.Область(НомерСтроки, 2).Текст = СтрокаВалюты.Валюта;
		Таб.Область(НомерСтроки, 3).Текст = Формат(СтрокаВалюты.Мандатов, "ЧГ=0");
		Таб.Область(НомерСтроки, 4).Текст = Формат(СтрокаВалюты.Записей, "ЧГ=0");
		Таб.Область(НомерСтроки, 5).Текст = Формат(СтрокаВалюты.ГруппПериодМандатВалюта, "ЧГ=0");
	КонецЦикла;

	Возврат НомерСтроки;

КонецФункции

&НаСервере
Процедура ВывестиСтратегии(Таб, Итоги, НомерСтроки)

	Заголовки = Новый Массив;
	Заголовки.Добавить("База");
	Заголовки.Добавить("Код");
	Заголовки.Добавить("Наименование");
	Заголовки.Добавить("Особая");
	Заголовки.Добавить("Строк состава");
	Заголовки.Добавить("Мандатов");
	Заголовки.Добавить("Дублей");
	Заголовки.Добавить("Разделителей");
	Заголовки.Добавить("Строк TWR");
	Заголовки.Добавить("Валют у мандата, макс");
	Заголовки.Добавить("Пачек");
	Заголовки.Добавить("Строк в тяжелой пачке");
	Заголовки.Добавить("МБ одним вызовом");
	Заголовки.Добавить("МБ тяжелой пачки");

	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Таб.Область(НомерСтроки, Индекс + 1).Текст = Заголовки[Индекс];
	КонецЦикла;

	Для Каждого Итог Из Итоги Цикл
		НомерСтроки = НомерСтроки + 1;
		Таб.Область(НомерСтроки, 1).Текст = Итог.База;
		Таб.Область(НомерСтроки, 2).Текст = Итог.Код;
		Таб.Область(НомерСтроки, 3).Текст = Итог.Наименование;
		Таб.Область(НомерСтроки, 4).Текст = ?(Итог.Особая, "да", "");
		Таб.Область(НомерСтроки, 5).Текст = Формат(Итог.СтрокСостава, "ЧГ=0");
		Таб.Область(НомерСтроки, 6).Текст = Формат(Итог.Мандатов, "ЧГ=0");
		Таб.Область(НомерСтроки, 7).Текст = Формат(Итог.Дублей, "ЧГ=0");
		Таб.Область(НомерСтроки, 8).Текст = Формат(Итог.Разделителей, "ЧГ=0");
		Таб.Область(НомерСтроки, 9).Текст = Формат(Итог.СтрокTWR, "ЧГ=0");
		Таб.Область(НомерСтроки, 10).Текст = Формат(Итог.МаксВалют, "ЧГ=0");
		Таб.Область(НомерСтроки, 11).Текст = Формат(Итог.Пачек, "ЧГ=0");
		Таб.Область(НомерСтроки, 12).Текст = Формат(Итог.СтрокТяжелойПачки, "ЧГ=0");
		Таб.Область(НомерСтроки, 13).Текст = Формат(Итог.МБ_1_07, "ЧДЦ=0; ЧГ=0");
		Таб.Область(НомерСтроки, 14).Текст = Формат(Итог.МБ_1_08, "ЧДЦ=0; ЧГ=0");
	КонецЦикла;

