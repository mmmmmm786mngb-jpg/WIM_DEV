
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КонецПериода = НачалоДня(КонецМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1)));
	НачалоПериода = НачалоМесяца(КонецПериода);
	РазмерПачки = 500;
	ИсключитьЦессии = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Собрать(Команда)
	СобратьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// КБ на одну строку результата TWR по замеру стенда: 2000 мандатов, 606604 строки, пик 3670 МБ
// за вычетом 50 МБ постоянной части. Вводы-выводы на стенде были нулевые, поэтому оценка снизу.
//
Функция КилобайтНаСтрокуTWR()
	Возврат 6.1;
КонецФункции

Функция ПостояннаяЧастьВызоваМБ()
	Возврат 50;
КонецФункции

&НаСервере
Процедура СобратьНаСервере()

	Если Не ЗначениеЗаполнено(УправляющаяКомпания) Тогда
		СообщитьПользователю("Укажите управляющую компанию, как в заполнении формы 431.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		СообщитьПользователю("Укажите начало и конец периода отчета.");
		Возврат;
	КонецЕсли;

	Если РазмерПачки < 1 Тогда
		СообщитьПользователю("Размер пачки должен быть больше нуля.");
		Возврат;
	КонецЕсли;

	НомераДоговоров = НомераДоговоровОтчета();
	Если НомераДоговоров.Количество() = 0 Тогда
		СообщитьПользователю("По указанным отборам договоры не найдены.");
		Возврат;
	КонецЕсли;

	Базы = БазыМО();
	Если Базы.Количество() = 0 Тогда
		СообщитьПользователю("Не найдена база МО. Укажите ее в поле или проверьте PROD_AVC_MO и PROD_AVC_Retail_MO.");
		Возврат;
	КонецЕсли;

	СтрокиСтратегий = НоваяТаблицаСтратегий();
	Валюты = НоваяТаблицаВалют();
	НачалоTWR = НачалоГода(НачалоПериода);
	КонецTWR = НачалоДня(КонецПериода);

	Для Каждого База Из Базы Цикл
		ПрочитатьБазуМО(База, НомераДоговоров, НачалоTWR, КонецTWR, СтрокиСтратегий, Валюты);
	КонецЦикла;

	ВывестиОтчет(СтрокиСтратегий, Валюты, НомераДоговоров.Количество(), НачалоTWR, КонецTWR);

КонецПроцедуры

&НаСервере
Функция НомераДоговоровОтчета()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоговорДУ.Код КАК Код
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорДУ
	|ГДЕ
	|	ДоговорДУ.ТипКлиентаДУ В (&ТипыКлиентовДУ)
	|	И ДоговорДУ.УправляющаяКомпания = &УправляющаяКомпания
	|	И ДоговорДУ.ПометкаУдаления = ЛОЖЬ
	|	И ДоговорДУ.Код <> """"
	|	И ВЫБОР
	|			КОГДА &ИсключитьЦессии
	|				ТОГДА ДоговорДУ.ДатаЦессии = ДАТАВРЕМЯ(1, 1, 1)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И (ДоговорДУ.ДатаВводаСредствВДУ МЕЖДУ &НачалоПериода И &КонецПериода
	|				И ДоговорДУ.ДатаНачала <= &КонецПериода
	|				И (ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДоговорДУ.ДатаОкончания > &КонецПериода
	|					ИЛИ ДоговорДУ.ДатаОкончания МЕЖДУ ДоговорДУ.ДатаНачала И &КонецПериода)
	|			ИЛИ ДоговорДУ.ДатаОкончания <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаВводаСредствВДУ <> ДАТАВРЕМЯ(1, 1, 1)
	|				И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) <= &КонецПериода
	|				И КОНЕЦПЕРИОДА(ДоговорДУ.ДатаОкончания, ДЕНЬ) МЕЖДУ &НачалоПериода И &КонецПериода
	|				И ДоговорДУ.ДатаВводаСредствВДУ <= &КонецПериода
	|			ИЛИ (ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДоговорДУ.ДатаОкончания > &КонецПериода)
	|				И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) <= &КонецПериода
	|				И ДоговорДУ.ДатаВводаСредствВДУ <= &КонецПериода
	|				И ДоговорДУ.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаВводаСредствВДУ <> ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДоговорДУ.ДатаОкончания <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаОкончания < &НачалоПериода
	|				И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) < &НачалоПериода
	|				И ДоговорДУ.ДатаВводаСредствВДУ <= &НачалоПериода
	|				И ДоговорДУ.ДатаНачала <> ДАТАВРЕМЯ(1, 1, 1)
	|				И ДоговорДУ.ДатаВводаСредствВДУ <> ДАТАВРЕМЯ(1, 1, 1))";

	Запрос.УстановитьПараметр("ТипыКлиентовДУ", ТипыКлиентовДУ());
	Запрос.УстановитьПараметр("УправляющаяКомпания", УправляющаяКомпания);
	Запрос.УстановитьПараметр("ИсключитьЦессии", ИсключитьЦессии);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код");

КонецФункции

&НаСервере
Функция ТипыКлиентовДУ()

	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.ФизическиеЛица);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.ЮридическиеЛица);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.СтраховыеКомпании);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.СобственныеСредстваСК);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.СаморегулируемыеОрганизации);
	МассивТипов.Добавить(Перечисления.ТипыКлиентовДУ.ФондЦелевогоКапитала);
	Возврат МассивТипов;

КонецФункции

&НаСервере
Функция БазыМО()

	Базы = Новый Массив;
	Если ЗначениеЗаполнено(БазаМО) Тогда
		Базы.Добавить(БазаМО);
		Возврат Базы;
	КонецЕсли;

	Имена = Новый Массив;
	Имена.Добавить("PROD_AVC_MO");
	Имена.Добавить("PROD_AVC_Retail_MO");
	Для Каждого ИмяБазы Из Имена Цикл
		Ссылка = Справочники.ВнешниеИнформационныеБазы.НайтиПоНаименованию(ИмяБазы, Истина);
		Если Не Ссылка.Пустая() Тогда
			Базы.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Базы;

КонецФункции

&НаСервере
Процедура ПрочитатьБазуМО(База, НомераДоговоров, НачалоTWR, КонецTWR, СтрокиСтратегий, Валюты)

	ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.СтруктураПараметровДляУстановкиВнешнегоСоединения();
	ЗаполнитьЗначенияСвойств(ПараметрыПодключения, База);
	СтруктураПодключения = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединение(ПараметрыПодключения);
	Соединение = СтруктураПодключения.Соединение;
	Если Соединение = Неопределено Тогда
		СообщитьПользователю(Строка(База) + ": " + СтруктураПодключения.ПодробноеОписаниеОшибки);
		Возврат;
	КонецЕсли;

	Номера = Соединение.NewObject("Массив");
	Для Каждого Номер Из НомераДоговоров Цикл
		Номера.Добавить(Номер);
	КонецЦикла;

	Запрос = Соединение.NewObject("Запрос");
	Запрос.Текст = ТекстЗапросаСоставаИДней();
	Запрос.УстановитьПараметр("НомераДоговоров", Номера);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ДатаНачала", НачалоTWR);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецTWR);
	Результат = Запрос.Выполнить().Выгрузить();

	ИмяБазы = Строка(База);
	Для Каждого СтрокаМО Из Результат Цикл
		НоваяСтрока = СтрокиСтратегий.Добавить();
		НоваяСтрока.База = ИмяБазы;
		НоваяСтрока.Код = СтрокаМО.ИдентификаторСтратегии;
		НоваяСтрока.Наименование = СтрокаМО.НаименованиеСтратегии;
		НоваяСтрока.СтрокСостава = СтрокаМО.СтрокСостава;
		НоваяСтрока.Дней = СтрокаМО.Дней;
		НоваяСтрока.Валют = СтрокаМО.Валют;
	КонецЦикла;
	СтрокаМО = Неопределено;
	Результат = Неопределено;

	ЗапросВалют = Соединение.NewObject("Запрос");
	ЗапросВалют.Текст = ТекстЗапросаВалют();
	ЗапросВалют.УстановитьПараметр("НомераДоговоров", Номера);
	ЗапросВалют.УстановитьПараметр("ДатаНачала", НачалоTWR);
	ЗапросВалют.УстановитьПараметр("ДатаОкончания", КонецTWR);
	ВалютыМО = ЗапросВалют.Выполнить().Выгрузить();
	Для Каждого СтрокаВалюты Из ВалютыМО Цикл
		НоваяВалюта = Валюты.Добавить();
		НоваяВалюта.База = ИмяБазы;
		НоваяВалюта.Валюта = СтрокаВалюты.Валюта;
		НоваяВалюта.Мандатов = СтрокаВалюты.Мандатов;
		НоваяВалюта.Записей = СтрокаВалюты.Записей;
		НоваяВалюта.ГруппПериодМандатВалюта = СтрокаВалюты.ГруппПериодМандатВалюта;
	КонецЦикла;
	СтрокаВалюты = Неопределено;
	ВалютыМО = Неопределено;

КонецПроцедуры

&НаСервере
Функция ТекстЗапросаСоставаИДней()

	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Мандаты.Ссылка КАК Мандат,
	|	Мандаты.НомерДоговора КАК НомерДоговора,
	|	ДействующиеФинПланыСрезПоследних.ФинансовыйПлан КАК ФинансовыйПлан
	|ПОМЕСТИТЬ ВТ_ФинПлатыМандатов
	|ИЗ
	|	Справочник.Мандаты КАК Мандаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеФинПланы.СрезПоследних(&КонецПериода, Мандат.НомерДоговора В (&НомераДоговоров)) КАК ДействующиеФинПланыСрезПоследних
	|		ПО (ДействующиеФинПланыСрезПоследних.Мандат = Мандаты.Ссылка)
	|ГДЕ
	|	Мандаты.НомерДоговора В(&НомераДоговоров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,
	|	ВТ_ФинПлатыМандатов.НомерДоговора КАК НомерДоговора,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|		КОНЕЦ) КАК Стратегия
	|ПОМЕСТИТЬ ВТ_ИндивидуальныеСтратегииМандатов
	|ИЗ
	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий
	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ФинПлатыМандатов.НомерДоговора,
	|	ВТ_ФинПлатыМандатов.Мандат
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|				ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель
	|			ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия
	|		КОНЕЦ) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ФинПлатыМандатов.Мандат КАК Мандат,
	|	ВЫБОР
	|		КОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|			ТОГДА ФинансовыеПланыСоставСтратегий.Стратегия.Родитель.КодСтратегии
	|		ИНАЧЕ ФинансовыеПланыСоставСтратегий.Стратегия.КодСтратегии
	|	КОНЕЦ КАК ИдентификаторСтратегии,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Стратегии.НаименованиеАнгл, """") = """"
	|			ТОГДА ЕСТЬNULL(Стратегии.Наименование, """")
	|		ИНАЧЕ Стратегии.НаименованиеАнгл
	|	КОНЕЦ КАК НаименованиеСтратегии
	|ПОМЕСТИТЬ ВТ_СтрокиСостава
	|ИЗ
	|	ВТ_ФинПлатыМандатов КАК ВТ_ФинПлатыМандатов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК ФинансовыеПланыСоставСтратегий
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Стратегии КАК Стратегии
	|			ПО ФинансовыеПланыСоставСтратегий.Стратегия = Стратегии.Ссылка
	|		ПО ВТ_ФинПлатыМандатов.ФинансовыйПлан = ФинансовыеПланыСоставСтратегий.Ссылка
	|ГДЕ
	|	НЕ ВТ_ФинПлатыМандатов.НомерДоговора В
	|				(ВЫБРАТЬ
	|					ВТ.НомерДоговора
	|				ИЗ
	|					ВТ_ИндивидуальныеСтратегииМандатов КАК ВТ)
	|	И НЕ (ЕСТЬNULL(Стратегии.Закрыта, ЛОЖЬ)
	|			И ЕСТЬNULL(Стратегии.ОтображатьНулевуюДоходность, ЛОЖЬ))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ИндивидуальныеСтратегииМандатов.Мандат,
	|	""IS-001"",
	|	""Индивидуальная стратегия""
	|ИЗ
	|	ВТ_ИндивидуальныеСтратегииМандатов КАК ВТ_ИндивидуальныеСтратегииМандатов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СтрокиСостава.ИдентификаторСтратегии КАК ИдентификаторСтратегии,
	|	МАКСИМУМ(ВТ_СтрокиСостава.НаименованиеСтратегии) КАК НаименованиеСтратегии,
	|	ВТ_СтрокиСостава.Мандат КАК Мандат,
	|	КОЛИЧЕСТВО(*) КАК СтрокСостава
	|ПОМЕСТИТЬ ВТ_МандатыСтратегий
	|ИЗ
	|	ВТ_СтрокиСостава КАК ВТ_СтрокиСостава
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СтрокиСостава.ИдентификаторСтратегии,
	|	ВТ_СтрокиСостава.Мандат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РыночнаяСтоимостьПозиции.Мандат КАК Мандат,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РыночнаяСтоимостьПозиции.Период) КАК Дней,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РыночнаяСтоимостьПозиции.Валюта) КАК Валют
	|ПОМЕСТИТЬ ВТ_ДниМандатов
	|ИЗ
	|	РегистрСведений.РыночнаяСтоимостьПозиции КАК РыночнаяСтоимостьПозиции
	|ГДЕ
	|	РыночнаяСтоимостьПозиции.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1) И &ДатаОкончания
	|	И РыночнаяСтоимостьПозиции.Мандат.НомерДоговора В (&НомераДоговоров)
	|СГРУППИРОВАТЬ ПО
	|	РыночнаяСтоимостьПозиции.Мандат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
