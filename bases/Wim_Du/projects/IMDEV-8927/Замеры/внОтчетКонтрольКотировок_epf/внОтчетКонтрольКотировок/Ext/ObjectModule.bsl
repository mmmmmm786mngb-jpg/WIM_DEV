

Перем ИдентификаторКомандыДляЗамера; // IMDEV-8927
Перем КоличествоСтрокОтчетаЗамера; // IMDEV-8927

//ПРОЦЕДУРЫ ФУНКЦИИ ДОПОЛНИТЕЛЬНЫХ ОТЧЕТОВ И ОБРАБОТОК//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид","ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение",Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", "Отчет контроль котировок");
	ПараметрыРегистрации.Вставить("Версия", "1.06");
	ПараметрыРегистрации.Вставить("БезопасныйРежим",Ложь);
	ПараметрыРегистрации.Вставить("Информация","Пользовательские уведомления");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд,
	"Отчет контроль котировок",
	"ПроверитьКупон",
	"ОткрытиеФормы");
	
	ДобавитьКоманду(ТаблицаКоманд,
	"Отчет контроль котировок (фон.)",
	"ФоновоеВыполнение",
	"ВызовСерверногоМетода");

	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	Возврат ПараметрыРегистрации;
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

/////////////////////////////////////////////////////////////////

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда Возврат; КонецЕсли;
	// IMDEV-8927 ++
	ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
	// IMDEV-8927 --
	ПроверкаСниженияСЧА(ПараметрыВыполненияКоманды);	
	// IMDEV-8927 ++
	ИдентификаторКомандыДляЗамера = Неопределено;
	// IMDEV-8927 --
КонецПроцедуры

// IMDEV-8927 ++
// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Формирует имя ключевой операции БСП для замера
// по этапу обработки и контуру запуска.
//
// Параметры:
// ЭтапЗамера - Строка - этап замера (например, Отчет)
//
// Возвращаемое значение:
// Строка - имя ключевой операции в формате ДУ.КонтрольКотировок.<Этап>.<Контур>
//
Функция ПолучитьИмяКлючевойОперацииЗамера(Знач ЭтапЗамера)
	Возврат "ДУ.КонтрольКотировок." + ЭтапЗамера + "."
		+ ?(ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера), ИдентификаторКомандыДляЗамера, "Ручной");
КонецФункции
// IMDEV-8927 --

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	ЗначенияНастроек = НастройкиВыполнения;
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек,ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") тогда
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) тогда
			ПочтовыйЛогин = Почта;
			
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки);
			СписокРассылки.Загрузить(Ящики.Получить());
			
		КонецЕсли;
		ПредставлениеНастроек = "Период с:"+Формат(ДатаОтчета,"ДФ=dd.MM.yyyy");
	КонецЕсли;	
	
КонецПроцедуры

/////////////////////////////////////////////////////////////////

Процедура СтартСформироватьОтчет() экспорт
	
	ДатаПред = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(,ДатаОтчета,-1);
	
	ТабличныйДокумент.Очистить();
	КоличествоСтрокОтчетаЗамера = 0; // IMDEV-8927
	Макет = ПолучитьМакет("МакетОтчета");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ДатаОтчета = ДатаОтчета;
	ОбластьШапка.Параметры.ДатаПред = Формат(ДатаПред,"ДФ=dd.MM.yyyy");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаОтчета));
	Запрос.УстановитьПараметр("Дата1", КонецДня(ДатаПред));
	Запрос.УстановитьПараметр("Дата2", КонецДня(ДатаПред) - 1*24*60*60);
	Запрос.УстановитьПараметр("Дата13", КонецДня(ДатаОтчета) - 13*24*60*60);
	
	Запрос.УстановитьПараметр("БиржаММВБ", Справочники.Биржи.НайтиПоНаименованию("ММВБ"));
	Запрос.УстановитьПараметр("БиржаOTC", Справочники.Биржи.НайтиПоНаименованию("OTC"));
	Запрос.УстановитьПараметр("БиржаРТС", Справочники.Биржи.НайтиПоНаименованию("РТС"));
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОбластьСтрока.Параметры.П1 = ВыборкаДетальныеЗаписи.Актив.Наименование;
		ОбластьСтрока.Параметры.П2 = ВыборкаДетальныеЗаписи.Актив.Объект.ISIN;
		ОбластьСтрока.Параметры.П3 = ВыборкаДетальныеЗаписи.Биржа.Наименование;
		ОбластьСтрока.Параметры.П4 = ВыборкаДетальныеЗаписи.КотировкаПредыдущая;
		ОбластьСтрока.Параметры.П5 = ВыборкаДетальныеЗаписи.КотировкаПоследняя;
		ОбластьСтрока.Параметры.П6 = ВыборкаДетальныеЗаписи.ДатаИзменения;
		ОбластьСтрока.Параметры.П7 = ВыборкаДетальныеЗаписи.Процент;
		ОбластьСтрока.Параметры.П8 = ВыборкаДетальныеЗаписи.КотировкаИзменения;
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		КоличествоСтрокОтчетаЗамера = КоличествоСтрокОтчетаЗамера + 1; // IMDEV-8927
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса()

	Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	СтоимостьАктивовУправленческийОстатки.Актив
	        |ПОМЕСТИТЬ ВТ_ЦБ
	        |ИЗ
	        |	РегистрНакопления.СтоимостьАктивовУправленческий.Остатки(&Дата, ) КАК СтоимостьАктивовУправленческийОстатки
	        |ГДЕ
	        |	СтоимостьАктивовУправленческийОстатки.КоличествоОстаток <> 0
	        |	И СтоимостьАктивовУправленческийОстатки.ДоговорДУ.ПометкаУдаления = ЛОЖЬ
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	КотировкиЦБ.Актив,
	        |	КотировкиЦБ.Биржа,
	        |	ВЫБОР
	        |		КОГДА КотировкиЦБ.Биржа = &БиржаММВБ
	        |				И ЕСТЬNULL(КотировкиЦБ.РыночнаяЦена2, 0) <> 0
	        |			ТОГДА КотировкиЦБ.РыночнаяЦена2
	        |		КОГДА КотировкиЦБ.Биржа = &БиржаММВБ
	        |				И ЕСТЬNULL(КотировкиЦБ.РыночнаяЦена3, 0) <> 0
	        |			ТОГДА КотировкиЦБ.РыночнаяЦена3
	        |		ИНАЧЕ КотировкиЦБ.ПризнаваемаяКотировка
	        |	КОНЕЦ КАК КотировкаПоследняя
	        |ПОМЕСТИТЬ ВТ_КотировкаПоследние
	        |ИЗ
	        |	ВТ_ЦБ КАК ВТ_ЦБ
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦБНаБирже КАК КотировкиЦБ
	        |		ПО ВТ_ЦБ.Актив = КотировкиЦБ.Актив
	        |			И (КотировкиЦБ.Биржа <> &БиржаOTC)
	        |			И (КотировкиЦБ.Биржа <> &БиржаРТС)
	        |			И (КотировкиЦБ.Период = НАЧАЛОПЕРИОДА(&Дата1, ДЕНЬ))
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_КотировкаПоследние.Актив,
	        |	ВТ_КотировкаПоследние.Биржа,
	        |	ВТ_КотировкаПоследние.КотировкаПоследняя,
	        |	МАКСИМУМ(КотировкиЦБ.Период) КАК ДатаИзменения
	        |ПОМЕСТИТЬ ВТ_КотировкаИзменение2
	        |ИЗ
	        |	ВТ_КотировкаПоследние КАК ВТ_КотировкаПоследние
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦБНаБирже КАК КотировкиЦБ
	        |		ПО (КотировкиЦБ.Актив = ВТ_КотировкаПоследние.Актив)
	        |			И (КотировкиЦБ.Биржа = ВТ_КотировкаПоследние.Биржа)
	        |			И (КотировкиЦБ.Период < &Дата1)
	        |			И (ВЫБОР
	        |				КОГДА КотировкиЦБ.Биржа = &БиржаММВБ
	        |						И ЕСТЬNULL(КотировкиЦБ.РыночнаяЦена2, 0) <> 0
	        |					ТОГДА КотировкиЦБ.РыночнаяЦена2
	        |				КОГДА КотировкиЦБ.Биржа = &БиржаММВБ
	        |						И ЕСТЬNULL(КотировкиЦБ.РыночнаяЦена3, 0) <> 0
	        |					ТОГДА КотировкиЦБ.РыночнаяЦена3
	        |				ИНАЧЕ КотировкиЦБ.ПризнаваемаяКотировка
	        |			КОНЕЦ <> ВТ_КотировкаПоследние.КотировкаПоследняя)
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_КотировкаПоследние.Актив,
	        |	ВТ_КотировкаПоследние.Биржа,
	        |	ВТ_КотировкаПоследние.КотировкаПоследняя
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_КотировкаИзменение2.Актив,
	        |	ВТ_КотировкаИзменение2.КотировкаПоследняя,
	        |	ВТ_КотировкаИзменение2.Биржа,
	        |	ВТ_КотировкаИзменение2.ДатаИзменения,
	        |	ВЫБОР
	        |		КОГДА КотировкиЦБ.Биржа = &БиржаММВБ
	        |				И ЕСТЬNULL(КотировкиЦБ.РыночнаяЦена2, 0) <> 0
	        |			ТОГДА КотировкиЦБ.РыночнаяЦена2
	        |		КОГДА КотировкиЦБ.Биржа = &БиржаММВБ
	        |				И ЕСТЬNULL(КотировкиЦБ.РыночнаяЦена3, 0) <> 0
	        |			ТОГДА КотировкиЦБ.РыночнаяЦена3
	        |		ИНАЧЕ КотировкиЦБ.ПризнаваемаяКотировка
	        |	КОНЕЦ КАК КотировкаИзменения
	        |ПОМЕСТИТЬ ВТ_КотировкаИзменение
	        |ИЗ
	        |	ВТ_КотировкаИзменение2 КАК ВТ_КотировкаИзменение2
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦБНаБирже КАК КотировкиЦБ
	        |		ПО (КотировкиЦБ.Актив = ВТ_КотировкаИзменение2.Актив)
	        |			И (КотировкиЦБ.Биржа = ВТ_КотировкаИзменение2.Биржа)
	        |			И (КотировкиЦБ.Период = ВТ_КотировкаИзменение2.ДатаИзменения)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_КотировкаИзменение.Актив,
	        |	ВТ_КотировкаИзменение.Биржа,
	        |	ВТ_КотировкаИзменение.КотировкаПоследняя,
	        |	ВТ_КотировкаИзменение.ДатаИзменения,
	        |	ВТ_КотировкаИзменение.КотировкаИзменения,
	        |	ВЫБОР
	        |		КОГДА КотировкиЦБ.Биржа = &БиржаММВБ
	        |				И ЕСТЬNULL(КотировкиЦБ.РыночнаяЦена2, 0) <> 0
	        |			ТОГДА КотировкиЦБ.РыночнаяЦена2
	        |		КОГДА КотировкиЦБ.Биржа = &БиржаММВБ
	        |				И ЕСТЬNULL(КотировкиЦБ.РыночнаяЦена3, 0) <> 0
	        |			ТОГДА КотировкиЦБ.РыночнаяЦена3
	        |		ИНАЧЕ КотировкиЦБ.ПризнаваемаяКотировка
	        |	КОНЕЦ КАК КотировкаПредыдущая
	        |ПОМЕСТИТЬ ВТ_КотировкаРезультат
	        |ИЗ
	        |	ВТ_КотировкаИзменение КАК ВТ_КотировкаИзменение
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦБНаБирже.СрезПоследних(&Дата2, ) КАК КотировкиЦБ
	        |		ПО (КотировкиЦБ.Актив = ВТ_КотировкаИзменение.Актив)
	        |			И (КотировкиЦБ.Биржа = ВТ_КотировкаИзменение.Биржа)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_КотировкаРезультат.Актив,
	        |	ВТ_КотировкаРезультат.Биржа,
	        |	ВТ_КотировкаРезультат.КотировкаПоследняя,
	        |	ВТ_КотировкаРезультат.ДатаИзменения КАК ДатаИзменения,
	        |	ВТ_КотировкаРезультат.КотировкаИзменения,
	        |	ВТ_КотировкаРезультат.КотировкаПредыдущая,
	        |	ВЫБОР
	        |		КОГДА ВТ_КотировкаРезультат.КотировкаПредыдущая = 0
	        |			ТОГДА NULL
	        |		ИНАЧЕ (ВТ_КотировкаРезультат.КотировкаПоследняя / ВТ_КотировкаРезультат.КотировкаПредыдущая - 1) * 100
	        |	КОНЕЦ КАК Процент
	        |ИЗ
	        |	ВТ_КотировкаРезультат КАК ВТ_КотировкаРезультат
	        |ГДЕ
	        |	(ВТ_КотировкаРезультат.КотировкаПоследняя = 0
	        |			ИЛИ ВТ_КотировкаРезультат.ДатаИзменения <= &Дата13
	        |			ИЛИ ВТ_КотировкаРезультат.КотировкаПредыдущая / ВТ_КотировкаРезультат.КотировкаПоследняя >= 1.1
	        |			ИЛИ ВТ_КотировкаРезультат.КотировкаПредыдущая / ВТ_КотировкаРезультат.КотировкаПоследняя <= 0.9)
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	ДатаИзменения,
	        |	Процент УБЫВ,
	        |	ВТ_КотировкаРезультат.Актив.Наименование,
	        |	ВТ_КотировкаРезультат.Биржа.Наименование";
			
	Возврат Текст;
	
КонецФункции // ПолучитьТекстЗапросаТаблицаМесяцев()

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

/////////////////////////////////////////////////////////////////

Процедура ПроверкаСниженияСЧА(ПараметрыВыполненияКоманды)
	
	// IMDEV-8927 ++
	КлючеваяОперацияКонтроль = ПолучитьИмяКлючевойОперацииЗамера("Отчет");
	ВремяНачалаЗамераКонтроль = ОценкаПроизводительности.НачатьЗамерВремени();
	// IMDEV-8927 --
	
	ДатаПроверки = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(,ТекущаяДата(),-1);
	
//////////////////////////	
	ДатаОтчета = ДатаПроверки;
	СтартСформироватьОтчет();
//////////////////////////	

	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	ДопОбработка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;		
	Задача = Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
	Задача.Дата = ТекущаяДата();
	
	Задача.ВидОбмена 		= ДопОбработка;
	Задача.ВерсияОбработки 	= ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДопОбработка, "Версия");
	Задача.Наименование 	= "Отчет контроль котировок в фоновом режиме";
	Задача.ПараметрыВыполнения = ПредставлениеНастроек;
	
	Отказ = Ложь;
	ТекстОшибки = "";
	Задача.Описание	= "Настройки: "+ ПредставлениеНастроек;

	Тема = "Аванкор ДУ: Отчет контроль котировок за " + Формат(ДатаПроверки, "ДФ=yyyy-MM-dd; ДП=") + ПропискаРассылки("r57");
	ТелоПисьма = "Отчет контроль котировок за " + Формат(ДатаПроверки,"ДФ=dd.MM.yyyy; ДЛФ=D");
	
	Если СписокРассылки.Количество()>0 и НЕ ПочтовыйЛогин.Пустая() тогда
		
//		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Вложения");
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, Вложения");
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылки Цикл
			   Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
			
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.Тема = Тема;
		ПараметрыПисьма.Тело = ТелоПисьма;
//		ПараметрыПисьма.ТипТекста = "HTML";

		ПутьКФайлу = ПолучитьИмяВременногоФайла("XLS");
		ТабличныйДокумент.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLS);
		Вложения = Новый Соответствие;
		ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
		АдресВложения = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		Вложения.Вставить("Отчет_контроль_котировок_"+Формат(ДатаПроверки,"ДФ=ddMMyyyy; ДЛФ=D")+".xls", АдресВложения);
		ПараметрыПисьма.Вложения = Вложения;
		
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
			текстРассылки = "Рассылка завершена";
		Исключение
			текстРассылки = "Рассылка не удалась: "+ПочтовыйЛогин; 
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Для Каждого Элемент из Сообщения Цикл
				  текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
			Конеццикла;
		КонецПопытки;
		
	КонецЕсли;

	Задача.Описание = Задача.Описание + Символы.ПС + текстРассылки + Символы.ПС+ТелоПисьма;
	Задача.ВыполнитьЗадачу();

	// IMDEV-8927 ++
	Если ВремяНачалаЗамераКонтроль > 0 Тогда
		ВесЗамераКонтроль = ?(КоличествоСтрокОтчетаЗамера > 0, КоличествоСтрокОтчетаЗамера, 1);
		КомментарийЗамераКонтроль = "СтрокОтчета=" + КоличествоСтрокОтчетаЗамера
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераКонтроль, ВремяНачалаЗамераКонтроль);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияКонтроль,
			ВремяНачалаЗамераКонтроль,
			ВесЗамераКонтроль,
			КомментарийЗамераКонтроль,
			Ложь);
	КонецЕсли;
	// IMDEV-8927 --

КонецПроцедуры