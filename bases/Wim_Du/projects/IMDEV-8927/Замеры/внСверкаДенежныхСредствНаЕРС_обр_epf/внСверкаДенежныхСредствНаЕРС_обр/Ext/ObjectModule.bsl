Функция ВыполнитьСверку() Экспорт
	
	// IMDEV-8927 ++
	КлючеваяОперацияСверки = ПолучитьИмяКлючевойОперацииЗамера("Сверка");
	ВремяНачалаЗамераСверки = ОценкаПроизводительности.НачатьЗамерВремени();
	// IMDEV-8927 --
	
	ТЗ = ПодготовитьТаблицу();
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераСверки > 0 Тогда
		ВесЗамераСверки = ?(КоличествоРасхожденийЗамера > 0, КоличествоРасхожденийЗамера, 1);
		КомментарийЗамераСверки = "Расхождений=" + КоличествоРасхожденийЗамера
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераСверки, ВремяНачалаЗамераСверки);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияСверки,
			ВремяНачалаЗамераСверки,
			ВесЗамераСверки,
			КомментарийЗамераСверки,
			Ложь);
	КонецЕсли;
	// IMDEV-8927 --
	
	Возврат Отчет;
КонецФункции 

Функция ПодготовитьТаблицу()
	Статус = Ложь;
	КоличествоРасхожденийЗамера = 0; // IMDEV-8927
	тзСчетов = ПолучитьДанныеПоВыпискам();
	
	тзСписокСчетов = тзСчетов.Скопировать();
	тзСписокСчетов.Свернуть("БанковскийСчет");
	
	Отчет.Очистить();
	Отчет.ТолькоПросмотр =  ИСТИНА;
	
	Макет = ПолучитьМакет("Макет");
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Период = "Период с " + Формат(НачДата, "ДФ=dd.MM.yyyy") + " по " + Формат(КонДата, "ДФ=dd.MM.yyyy");
	Отчет.Вывести(Область);
	
	Для Каждого ТекСчет ИЗ тзСписокСчетов Цикл
		тзДоговоры = тзСчетов.Скопировать(Новый Структура("БанковскийСчет", ТекСчет.БанковскийСчет));
		Для Каждого ТекДоговор из тзДоговоры Цикл
			Область = Макет.ПолучитьОбласть("Строка");	
			Область.Параметры.Заполнить(ТекДоговор);
			Отчет.Вывести(Область);
		КонецЦикла;
		
		НачОстаток = тзДоговоры.Итог("НачОстаток");
		Приход = тзДоговоры.Итог("Поступило");
		Расход = тзДоговоры.Итог("Списано");
		КонОстаток = тзДоговоры.Итог("КонОстаток");
		
		БанкНачОст = тзДоговоры.Итог("БанкНачОст");
		БанкКонОст = тзДоговоры.Итог("БанкКонОст");
		
		Оборот = БанкКонОст - БанкНачОст;
		ПриходБанк = ?(Оборот > 0, Оборот, 0);
		РасходБанк = ?(Оборот > 0, 0, -Оборот);
		
		Если НачОстаток <> БанкНачОст ИЛИ КонОстаток <> БанкКонОст Тогда
			Статус = Истина;
			КоличествоРасхожденийЗамера = КоличествоРасхожденийЗамера + 1; // IMDEV-8927
			Область = Макет.ПолучитьОбласть("СтрокаИтогПодсв");
		Иначе
			Область = Макет.ПолучитьОбласть("CтрокаИтог");
		КонецЕсли;
		
		Область.Параметры.Счет = ТекСчет.БанковскийСчет;
		Область.Параметры.НачОстаток = НачОстаток;
		Область.Параметры.Поступило = Приход;
		Область.Параметры.Списано = Расход;
		Область.Параметры.КонОстаток = КонОстаток;
		Область.Параметры.БанкНачОст = БанкНачОст;
		Область.Параметры.ПриходБанк = РасходБанк;
		Область.Параметры.РасходБанк = РасходБанк;
		Область.Параметры.КонБанк = БанкКонОст;
		Область.Параметры.Разница = КонОстаток - БанкКонОст;
		Отчет.Вывести(Область);
	КонецЦикла;
	
	Возврат Статус;
КонецФункции

