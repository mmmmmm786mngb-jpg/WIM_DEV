				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	т.Ссылка КАК Ссылка
ПОМЕСТИТЬ ВТ_ЮрЛица
ИЗ
	Справочник.Контрагенты.Изменения КАК т
ГДЕ
	т.Узел = &amp;Узел
	И т.Ссылка.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	И т.Ссылка.ВнешнийIDДляЛК &lt;&gt; 0

СГРУППИРОВАТЬ ПО
	т.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	т.Ссылка КАК Ссылка,
	МАКСИМУМ(БанковскиеСчета.Ссылка) КАК БС,
	0 КАК IS_LE,
	NULL КАК ДУ_ЮЛ
ПОМЕСТИТЬ ВТ_БС
ИЗ
	Справочник.Контрагенты.Изменения КАК т
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		ПО т.Ссылка = БанковскиеСчета.Владелец
ГДЕ
	т.Узел = &amp;Узел
	И т.Ссылка.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	И т.Ссылка.ВнешнийIDДляЛК &lt;&gt; 0
	И БанковскиеСчета.ВалютаДенежныхСредств = &amp;ВалютаРубль

СГРУППИРОВАТЬ ПО
	т.Ссылка

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	КонтрагентыПредставители.Контрагент,
	NULL,
	1,
	КонтрагентыПредставители.Ссылка
ИЗ
	Справочник.Контрагенты.Представители КАК КонтрагентыПредставители
ГДЕ
	КонтрагентыПредставители.Ссылка В
			(ВЫБРАТЬ
				ВТ_ЮрЛица.Ссылка
			ИЗ
				ВТ_ЮрЛица КАК ВТ_ЮрЛица)
	И НЕ КонтрагентыПредставители.АрхивныеСведения
	И КонтрагентыПредставители.Контрагент.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	И КонтрагентыПредставители.Ссылка.ВнешнийIDДляЛК &lt;&gt; 0
	И КонтрагентыПредставители.Ссылка.КлиентДУ

СГРУППИРОВАТЬ ПО
	КонтрагентыПредставители.Контрагент,
	КонтрагентыПредставители.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МАКСИМУМ(тДокУдостЛич.Период) КАК Период,
	т.Ссылка КАК Контрагент
ПОМЕСТИТЬ ВТ_ДокументыКонтрагентов
ИЗ
	Справочник.Контрагенты.Изменения КАК т
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(, ) КАК тДокУдостЛич
		ПО т.Ссылка = тДокУдостЛич.Физлицо

СГРУППИРОВАТЬ ПО
	т.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	т.Ссылка КАК Ссылка,
	т.Ссылка.ВнешнийIDДляЛК КАК CLIENT_ID_DU,
	тФИО.Имя КАК NAME,
	тФИО.Фамилия КАК LAST_NAME,
	тФИО.Отчество КАК SECOND_NAME,
	тДокУдостЛич.ВидДокумента.КодМВД КАК DOC_TYPE,
	тДокУдостЛич.Серия КАК DOC_SERIES,
	тДокУдостЛич.Номер КАК DOC_NUMBER,
	тДокУдостЛич.ДатаВыдачи КАК DOC_ISSUE_DATE,
	ПОДСТРОКА(тДокУдостЛич.КемВыдан, 1, 150) КАК DOC_ISSUE_PLACE,
	тДокУдостЛич.КодПодразделения КАК DocIssuePlaceCode,
	т.Ссылка.ИНН КАК TIN,
	"" КАК SNILS,
	т.Ссылка.ДатаРождения КАК BIRTH_DATE,
	"" КАК BIRTH_PLACE,
	ПОДСТРОКА(тТелКонтрагента.Представление, 1, 50) КАК ТелефонКонтрагента,
	ПОДСТРОКА(тEmail.Представление, 1, 50) КАК EMAIL,
	ЛОЖЬ КАК OFFER_AGREE,
	ЛОЖЬ КАК ITSEC_AGREE,
	т.Ссылка.НеРезидент КАК IS_NOT_RESIDENT,
	т.Ссылка.Страна КАК Citizenship,
	ЕСТЬNULL(т.Ссылка.Менеджер.Наименование, "") КАК ManagerDU,
	ВЫБОР
		КОГДА ВТ_БС.БС ЕСТЬ NULL
			ТОГДА ""
		ИНАЧЕ ВТ_БС.БС.Банк.Код
	КОНЕЦ КАК BIC,
	ВЫБОР
		КОГДА ВТ_БС.БС ЕСТЬ NULL
			ТОГДА ""
		ИНАЧЕ ВТ_БС.БС.НомерСчета
	КОНЕЦ КАК AccountNumber,
	0 КАК IS_LE,
	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК ЮрЛицо
ИЗ
	Справочник.Контрагенты.Изменения КАК т
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДокументыКонтрагентов КАК ВТ_ДокументыКонтрагентов
		ПО т.Ссылка = ВТ_ДокументыКонтрагентов.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(, ) КАК тДокУдостЛич
		ПО (ВТ_ДокументыКонтрагентов.Контрагент = тДокУдостЛич.Физлицо)
			И (тДокУдостЛич.Период = ВТ_ДокументыКонтрагентов.Период)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК тEmail
		ПО т.Ссылка = тEmail.Ссылка
			И (тEmail.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
			И (тEmail.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтрагента))
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК тТелКонтрагента
		ПО т.Ссылка = тТелКонтрагента.Ссылка
			И (тТелКонтрагента.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
			И (тТелКонтрагента.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК тФИО
		ПО т.Ссылка = тФИО.ФизЛицо
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БС КАК ВТ_БС
		ПО т.Ссылка = ВТ_БС.Ссылка
ГДЕ
	т.Узел = &amp;Узел
	И т.Ссылка.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	И т.Ссылка.ВнешнийIDДляЛК &lt;&gt; 0

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_БС.Ссылка,
	ЕСТЬNULL(Контрагенты.ВнешнийIDДляЛК, 0),
	тФИО.Имя,
	тФИО.Фамилия,
	тФИО.Отчество,
	тДокУдостЛич.ВидДокумента.КодМВД,
	тДокУдостЛич.Серия,
	тДокУдостЛич.Номер,
	тДокУдостЛич.ДатаВыдачи,
	ПОДСТРОКА(тДокУдостЛич.КемВыдан, 1, 150),
	тДокУдостЛич.КодПодразделения,
	ВТ_БС.Ссылка.ИНН,
	"",
	ВТ_БС.Ссылка.ДатаРождения,
	"",
	ПОДСТРОКА(тТелКонтрагента.Представление, 1, 50),
	ПОДСТРОКА(тEmail.Представление, 1, 50),
	ЛОЖЬ,
	ЛОЖЬ,
	ВТ_БС.Ссылка.НеРезидент,
	ВТ_БС.Ссылка.Страна,
	ЕСТЬNULL(ВТ_БС.Ссылка.Менеджер.Наименование, ""),
	ВЫБОР
		КОГДА ВТ_БС.БС ЕСТЬ NULL
			ТОГДА ""
		ИНАЧЕ ВТ_БС.БС.Банк.Код
	КОНЕЦ,
	ВЫБОР
		КОГДА ВТ_БС.БС ЕСТЬ NULL
			ТОГДА ""
		ИНАЧЕ ВТ_БС.БС.НомерСчета
	КОНЕЦ,
	ВТ_БС.IS_LE,
	Контрагенты.Ссылка
ИЗ
	ВТ_БС КАК ВТ_БС
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(, ) КАК тДокУдостЛич
		ПО ВТ_БС.Ссылка.Ссылка = тДокУдостЛич.Физлицо
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК тEmail
		ПО ВТ_БС.Ссылка = тEmail.Ссылка
			И (тEmail.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
			И (тEmail.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтрагента))
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК тТелКонтрагента
		ПО ВТ_БС.Ссылка = тТелКонтрагента.Ссылка
			И (тТелКонтрагента.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
			И (тТелКонтрагента.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК тФИО
		ПО ВТ_БС.Ссылка = тФИО.ФизЛицо
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		ПО ВТ_БС.ДУ_ЮЛ = Контрагенты.Ссылка
ГДЕ
	ВТ_БС.IS_LE = 1

УПОРЯДОЧИТЬ ПО
	Ссылка</QueryText>
