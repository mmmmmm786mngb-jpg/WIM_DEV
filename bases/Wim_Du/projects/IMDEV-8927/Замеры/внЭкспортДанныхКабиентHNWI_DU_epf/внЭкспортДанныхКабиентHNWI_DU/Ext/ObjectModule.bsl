Функция _ЗнчСтрока(вхЗнач, Размер)
	т = СокрЛП(вхЗнач);
	Если СтрДлина(т) > Размер Тогда
		Сообщить("Значение ["+т+"] превышает допустимую длину: "+Размер);
		т = Лев(т, Размер);
	КонецЕсли;
	
	т = СтрЗаменить(т, ",", " ");
	//Если т = "" Тогда
	//	т = "nul";
	//КонецЕсли;
	//Возврат "'"+т+"'";
	Возврат т;
КонецФункции

Функция _ЗнчЧисло(вхЗнач)
	стрФорматЧисла = "ЧРД=,; ЧН=0; ЧГ=0";
	
	Если не ЗначениеЗаполнено(вхЗнач) Тогда
		т = 0;
	ИначеЕсли ТипЗнч(вхЗнач) = Тип("Строка") Тогда
		т = СтрЗаменить(вхЗнач, " ", "");
		т = СтрЗаменить(Т, Символы.НПП, "");
		т = ?(т = "", "0", т);
		Попытка
			т = число(т) 
		Исключение
			т = 0 
		КонецПопытки;
	Иначе
		т = вхЗнач;
	КонецЕсли;
	
	т = Формат(т, стрФорматЧисла);
	
	Возврат т;
КонецФункции

Функция _ЗнчДата(вхЗнач)
	стрФорматДаты  = "ДФ='гггг-ММ-дд ЧЧ:мм:сс'";
	Ответ = Формат(?(ЗначениеЗаполнено(вхЗнач), вхЗнач, Дата(1900, 1, 1)), стрФорматДаты);
	//Возврат "'"+Формат(вхЗнач, стрФорматДаты)+"'";
	Возврат Ответ;
КонецФункции

Функция _СтрокаТекДата() Экспорт 
	
	Возврат Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'");
КонецФункции

Функция _УдалитьПиНПП(вхСтрока)
	
	стрРез =  СтрЗаменить(вхСтрока, " ", "");
	стрРез =  СтрЗаменить(стрРез, Символы.НПП, "");
	
	Возврат стрРез;
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	// Реализация логики команды
	Если ИдентификаторКоманды = "ФоновоеВыполнение" Тогда 
		
		УстановитьПривилегированныйРежим(Истина);
		
		// IMDEV-8927 ++
		ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
		// IMDEV-8927 --
		
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
		
		ДатаОкончания    			= ТекущаяДата();
		ОтмечатьДниКакВыгруженные 	= Истина;
		
		ВыгрузитьДанныеВКабинетHNWI("Регламентное задание");
		
		// IMDEV-8927 ++
		ИдентификаторКомандыДляЗамера = Неопределено;
		// IMDEV-8927 --
		
	КонецЕсли;
		
КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	ЗначенияНастроек = НастройкиВыполнения;
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек,ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") тогда
		
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) тогда
			ПочтовыйЛогин = Почта;
			
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки);
			СписокРассылки.Загрузить(Ящики.Получить());
			
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылкиЮЛ);
			СписокРассылкиЮЛ.Загрузить(Ящики.Получить());
						
		КонецЕсли;
		Настройки.Значения.Свойство("УзелОбменаСсылка", УзелОбменаСсылка);
		Настройки.Значения.Свойство("ЗапускатьРассылку", ЗапускатьРассылку);
		ПредставлениеНастроек = "Узел: "+УзелОбменаСсылка;
		
	КонецЕсли;	
	
КонецПроцедуры

