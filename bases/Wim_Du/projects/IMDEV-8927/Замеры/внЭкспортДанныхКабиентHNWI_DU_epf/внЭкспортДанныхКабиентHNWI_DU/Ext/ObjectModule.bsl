Процедура РассылкаСообщения(Знач масСообщения, Знач ЕстьОшибки)
	
	Если СписокРассылки.Количество()>0 и НЕ ПочтовыйЛогин.Пустая() тогда
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
		ПараметрыПисьма.Тема = ?(ЕстьОшибки, "{FAIL} ", "{OK} ") + "Аванкор ДУ: Выгрузка в КК (" + Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'; ДП=") + ")" + ПропискаРассылки("r37");
		ПараметрыПисьма.Важность = ?(ЕстьОшибки, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылки Цикл
			   Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
			
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.ТипТекста = "HTML";
		
		//ПутьКФайлу = ПолучитьИмяВременногоФайла("XLS");
		//Лог.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLS);
		//Упаковка в zip
		//ПутьКZip = ПолучитьИмяВременногоФайла("zip");
		//Упаковка = Новый ЗаписьZipФайла(ПутьКZip);
		//Упаковка.Добавить(ПутьКФайлу);
		//Упаковка.Записать();
		//ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКZip);
		//АдресВложения = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		//Вложения = Новый Соответствие;
		//Вложения.Вставить("Лог.zip",АдресВложения);
		//ПараметрыПисьма.Вложения = Вложения;
			
		РассылкаСообщения_Шапка();
		РассылкаСообщения_Заголовок(ПараметрыПисьма.Тема);
		
		х = новый Массив;
		х.Добавить("");
		х.Добавить("Сообщение");
		РассылкаСообщения_ЗаголовокТаблицы(х);
		
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		х[0] = "Имя базы";
		х[1] = СтрЗаменить(ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия, """", "");
		РассылкаСообщения_СтрокаТаблицы(х);
		
		х[0] = "Пользователь";
		х[1] = ИмяПользователя();
		РассылкаСообщения_СтрокаТаблицы(х);
		
		х[0] = "Компьютер";
		х[1] = ИмяКомпьютера();
		РассылкаСообщения_СтрокаТаблицы(х);
		
		х[0] = "Получатель";
		х[1] = ?(ВыгрузитьUAT, "UAT", "PROD");
		РассылкаСообщения_СтрокаТаблицы(х);
		
		Для каждого СтрокаСообщения Из масСообщения Цикл
			х[0] = Лев(СтрокаСообщения, 20);
			х[1] = Сред(СтрокаСообщения, 21);
			РассылкаСообщения_СтрокаТаблицы(х);
		КонецЦикла;
		РассылкаСообщения_ПодвалТаблицы();
		
		РассылкаСообщения_Окончание();	
		ПараметрыПисьма.Тело = ТелоПисьма;
		
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
			стрКомментарий = _СтрокаТекДата()+" отправлен лог по результатам выгрузки.";;
			ЗаписьЖурналаРегистрации(стрИмяСобытия, УровеньЖурналаРегистрации.Информация, , , стрКомментарий);
	
		Исключение
			стрКомментарий = _СтрокаТекДата()+"не получилось отправить лог обмена: " + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(стрИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , стрКомментарий);
	
		КонецПопытки;
		
		Сообщить(стрКомментарий);
	Иначе
		стрКомментарий = _СтрокаТекДата()+" рассылка лога  не выполнена, проверте настройки.";
		ЗаписьЖурналаРегистрации(стрИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , стрКомментарий);
	КонецЕсли;
	
КонецПроцедуры	

