Функция ЗначениеСвойства(Документ,Свойство) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда Возврат ""; КонецЕсли;
	ЗапросФондов = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияСвойствОбъектов.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Объект = &Документ
		|	И ЗначенияСвойствОбъектов.Свойство.Наименование = &Свойство");
	ЗапросФондов.УстановитьПараметр("Документ", Документ);
	ЗапросФондов.УстановитьПараметр("Свойство", Свойство);
	Выборка = ЗапросФондов.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат СокрЛП(Выборка.Значение);

КонецФункции

