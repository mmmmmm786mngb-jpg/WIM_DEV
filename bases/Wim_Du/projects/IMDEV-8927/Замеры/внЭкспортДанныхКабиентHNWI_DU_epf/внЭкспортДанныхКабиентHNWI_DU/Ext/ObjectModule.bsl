Процедура РассылкаСообщенияКорпКлиента(МассивПисем)
	
	Если СписокРассылкиЮЛ.Количество()>0 и НЕ ПочтовыйЛогин.Пустая() тогда
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
		ПараметрыПисьма.Тема = "Добавлен Представитель Юридического лица";
		ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылкиЮЛ Цикл
			   Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
			
		ПараметрыПисьма.Кому = Кому;
		
		для Каждого Элемент из МассивПисем Цикл
		
			ПараметрыПисьма.ТипТекста = "HTML";	
			ПараметрыПисьма.Тело = Элемент;
			
			Попытка
				РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
				стрКомментарий = _СтрокаТекДата()+" отправлен лог по результатам выгрузки.";;
				ЗаписьЖурналаРегистрации(стрИмяСобытия, УровеньЖурналаРегистрации.Информация, , , стрКомментарий);
		
			Исключение
				стрКомментарий = _СтрокаТекДата()+"не получилось отправить лог обмена: " + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации(стрИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , стрКомментарий);
		
			КонецПопытки;
			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры	
