	|	Справочник.Контрагенты.Изменения КАК т
	//IMAPPS-21859  NOzhiganov +
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДокументыКонтрагентов КАК ВТ_ДокументыКонтрагентов
	|		ПО т.Ссылка = ВТ_ДокументыКонтрагентов.Контрагент		
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(, ) КАК тДокУдостЛич
	|		ПО ВТ_ДокументыКонтрагентов.Контрагент = тДокУдостЛич.Физлицо и тДокУдостЛич.Период = ВТ_ДокументыКонтрагентов.Период
	//IMAPPS-21859  NOzhiganov -
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК тEmail
	|		ПО т.Ссылка = тEmail.Ссылка
	|			И (тEmail.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|			И (тEmail.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК тТелКонтрагента
	|		ПО т.Ссылка = тТелКонтрагента.Ссылка
	|			И (тТелКонтрагента.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|			И (тТелКонтрагента.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК тФИО
	|		ПО т.Ссылка = тФИО.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БС КАК ВТ_БС
	|		ПО т.Ссылка = ВТ_БС.Ссылка
	|ГДЕ
	|	т.Узел = &Узел
	|	И т.Ссылка.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|	И т.Ссылка.ВнешнийIDДляЛК <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_БС.Ссылка,
	|	ЕСТЬNULL(Контрагенты.ВнешнийIDДляЛК, 0),
	|	тФИО.Имя,
	|	тФИО.Фамилия,
	|	тФИО.Отчество,
	|	тДокУдостЛич.ВидДокумента.КодМВД,
	|	тДокУдостЛич.Серия,
	|	тДокУдостЛич.Номер,
	|	тДокУдостЛич.ДатаВыдачи,
	|	ПОДСТРОКА(тДокУдостЛич.КемВыдан, 1, 150),
	|	тДокУдостЛич.КодПодразделения,
	|	ВТ_БС.Ссылка.ИНН,
	|	"""",
	|	ВТ_БС.Ссылка.ДатаРождения,
	|	"""",
	|	ПОДСТРОКА(тТелКонтрагента.Представление, 1, 50),
	|	ПОДСТРОКА(тEmail.Представление, 1, 50),
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ВТ_БС.Ссылка.НеРезидент,
	|	ВТ_БС.Ссылка.Страна,
	|	ЕСТЬNULL(ВТ_БС.Ссылка.Менеджер.Наименование, """"),
	|	ВЫБОР
	|		КОГДА ВТ_БС.БС ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_БС.БС.Банк.Код
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТ_БС.БС ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ ВТ_БС.БС.НомерСчета
	|	КОНЕЦ,
	|	ВТ_БС.IS_LE,
	|	Контрагенты.Ссылка
	|ИЗ
	|	ВТ_БС КАК ВТ_БС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(, ) КАК тДокУдостЛич
	|		ПО ВТ_БС.Ссылка.Ссылка = тДокУдостЛич.Физлицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК тEmail
	|		ПО ВТ_БС.Ссылка = тEmail.Ссылка
	|			И (тEmail.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|			И (тEmail.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК тТелКонтрагента
	|		ПО ВТ_БС.Ссылка = тТелКонтрагента.Ссылка
	|			И (тТелКонтрагента.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|			И (тТелКонтрагента.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних КАК тФИО
	|		ПО ВТ_БС.Ссылка = тФИО.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВТ_БС.ДУ_ЮЛ = Контрагенты.Ссылка
	|ГДЕ
	|	ВТ_БС.IS_LE = 1
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";	
	
	
	Запрос = новый Запрос(ТекстЗапроса);
				   
	Запрос.УстановитьПараметр("Узел", УзелОбменаСсылка);
	
	// MPazhukov 15.05.2019 IMAPPS-7499
	Валюта = Справочники.Валюты.НайтиПоКоду("643");
	Запрос.УстановитьПараметр("ВалютаРубль", Валюта);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьСписокДоговороДУ() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДоговорДУИзменения.Ссылка КАК ДоговорДУ,
	|	ДоговорДУИзменения.Ссылка.Код КАК НомерДоговора,
	|	ДоговорДУИзменения.Ссылка.ДатаВводаСредствВДУ КАК ДатаВводаСредствВДУ
	|ИЗ
	|	Справочник.ДоговорДУ.Изменения КАК ДоговорДУИзменения
	|ГДЕ
	|	ДоговорДУИзменения.Узел = &Узел
	|
	|СГРУППИРОВАТЬ ПО
	|	ДоговорДУИзменения.Ссылка,
	|	ДоговорДУИзменения.Ссылка.Код,
	|	ДоговорДУИзменения.Ссылка.ДатаВводаСредствВДУ";		
	
	Запрос = новый Запрос(ТекстЗапроса);
				   
	Запрос.УстановитьПараметр("Узел", УзелОбменаСсылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

Функция ВыгрузитьДанныеВКабинетHNWI(РежимЗапуска) Экспорт
	
	// IMDEV-8927 ++
	КлючеваяОперацияВыгрузки = ПолучитьИмяКлючевойОперацииЗамера("Выгрузка");
	ВремяНачалаЗамераВыгрузки = ОценкаПроизводительности.НачатьЗамерВремени();
	КоличествоКлиентовЗамера = 0;
	КоличествоДатИнвестЗамера = 0;
	// IMDEV-8927 --
	
	// MPazhukov IMDEV-2078	
	МассивОтгруженныхЮЛ = Новый Массив;
	
	ЕстьОшибкиВсего = Ложь;
	ЕстьДанныеДляВыгрузки = Ложь;
	
	масСообщения = новый Массив;
	
	Если УзелОбменаСсылка.Пустая() Тогда
		стрКомментарий =  _СтрокаТекДата()+ "не выбран узел обмена;";
		масСообщения.Добавить(стрКомментарий);
	Иначе
		стрКомментарий = _СтрокаТекДата()+" старт выгрузки данных.";
		масСообщения.Добавить(стрКомментарий);
		ЗаписьЖурналаРегистрации(стрИмяСобытия, УровеньЖурналаРегистрации.Информация, , , стрКомментарий);
		
		Если мФабрика = Неопределено Тогда
			СоздатьФабрику();
		КонецЕсли;
		
		// клиенты
		СписокКлиенты = ПолучитьСписокКлиентов();
		
		КорневойТип = мФабрика.Тип(мПространствоИменPIF, "Корень");
		ПакетXDTO = мФабрика.Создать(КорневойТип);
		ТипUserPersonalData = мФабрика.Тип(мПространствоИменPIF, "type_UserPersonalData");
		
		Для каждого СтрокаСписка Из СписокКлиенты цикл 		
			
			Если СтрокаСписка.CLIENT_ID_DU = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СокрЛП(СтрокаСписка.DOC_NUMBER) = "" Тогда
				Сообщить("Для "+СтрокаСписка.Ссылка+" не задан номер документа. Код ДУ("+СтрокаСписка.CLIENT_ID_DU+")");
				Продолжить;
			КонецЕсли;
			
			обUserPersonalData = мФабрика.Создать(ТипUserPersonalData);
			
			обUserPersonalData.ClientId = 0;
			обUserPersonalData.ClienIdDU = _ЗнчЧисло(СтрокаСписка.CLIENT_ID_DU);
			обUserPersonalData.Name = _ЗнчСтрока(СтрокаСписка.NAME, 50);
			обUserPersonalData.LastName = _ЗнчСтрока(СтрокаСписка.LAST_NAME, 50);
			обUserPersonalData.SecondName = _ЗнчСтрока(СтрокаСписка.SECOND_NAME, 50);
			обUserPersonalData.DocType = _ЗнчСтрока(СтрокаСписка.DOC_TYPE, 50);
			обUserPersonalData.DocSeries = _УдалитьПиНПП(_ЗнчСтрока(СтрокаСписка.DOC_SERIES, 50));
			обUserPersonalData.DocNumber =  _УдалитьПиНПП(_ЗнчСтрока(СтрокаСписка.DOC_NUMBER, 50));
			обUserPersonalData.DocIssueDate = _ЗнчДата(СтрокаСписка.DOC_ISSUE_DATE);
			обUserPersonalData.DocIssuePlace = _ЗнчСтрока(СтрокаСписка.DOC_ISSUE_PLACE, 150);
			обUserPersonalData.DocIssuePlaceCode = _ЗнчСтрока(СтрокаСписка.DocIssuePlaceCode, 15);
			обUserPersonalData.TIN = _ЗнчСтрока(СтрокаСписка.TIN, 50);
			обUserPersonalData.SNILS = _ЗнчСтрока(СтрокаСписка.SNILS, 50);
			обUserPersonalData.BirthDate = _ЗнчДата(СтрокаСписка.BIRTH_DATE);
			обUserPersonalData.BirthPlace = _ЗнчСтрока(СтрокаСписка.BIRTH_PLACE, 80);
			обUserPersonalData.PhoneNumber = _ЗнчСтрока(СтрокаСписка.ТелефонКонтрагента, 50);
			обUserPersonalData.Email 	= _ЗнчСтрока(СтрокаСписка.EMAIL, 50);
			обUserPersonalData.IsNotResident = ?(СтрокаСписка.IS_NOT_RESIDENT = Истина, _ЗнчЧисло(1), "0");
			
			Если СтрокаСписка.IS_NOT_RESIDENT = Истина Тогда
				обUserPersonalData.Citizenship = _ЗнчСтрока(СтрокаСписка.Citizenship, 150);
			Иначе
				обUserPersonalData.Citizenship = _ЗнчСтрока(Справочники.СтраныМира.Россия, 150);
			КонецЕсли;
			
			// MPazhukov 15.05.2019 IMAPPS-7499
			обUserPersonalData.ManagerDU = СтрокаСписка.ManagerDU;
			обUserPersonalData.AccountNumber = СтрокаСписка.AccountNumber;
			обUserPersonalData.BIC = СтрокаСписка.BIC;
			// MPazhukov 15.05.2019 IMAPPS-7499
			
			// MPazhukov IMDEV-2078			
			обUserPersonalData.IS_LE = СтрокаСписка.IS_LE;
			Если СтрокаСписка.IS_LE = 1 Тогда
				МассивОтгруженныхЮЛ.Добавить(СтрокаСписка);	
			КонецЕсли;
			// MPazhukov IMDEV-2078					
			
			ПакетXDTO.UsersPersonalData.Добавить(обUserPersonalData);
			
			// MPazhukov 13.09.2019
			стрКомментарий = _СтрокаТекДата() + " Выгружен " + СокрЛП(СтрокаСписка.LAST_NAME) + " " + СокрЛП(СтрокаСписка.NAME) + " " + СокрЛП(СтрокаСписка.SECOND_NAME) + " (" + _ЗнчЧисло(СтрокаСписка.CLIENT_ID_DU) + ")";
			масСообщения.Добавить(стрКомментарий);			
			// MPazhukov 13.09.2019
			
		КонецЦикла;
		
		Если ПакетXDTO.UsersPersonalData.Количество() >  0 Тогда
			ЕстьДанныеДляВыгрузки = Истина;
			стрКомментарий = _СтрокаТекДата()+" Записей к выгрузке: "+ПакетXDTO.UsersPersonalData.Количество();
			масСообщения.Добавить(стрКомментарий);
		КонецЕсли;
		
		// IMDEV-8927 ++
		КоличествоКлиентовЗамера = ПакетXDTO.UsersPersonalData.Количество();
		// IMDEV-8927 --
				
		// MPazhukov IMDEV-2078
		МассивПисем = Новый Массив;
		Если ЕстьДанныеДляВыгрузки Тогда
			ПодготовитьПисьмаПоКорпКлиентам(МассивОтгруженныхЮЛ, МассивПисем);
		КонецЕсли;
		// MPazhukov IMDEV-2078	
				
		//стрКомментарий = _СтрокаТекДата()+" данные выгружены, снимаем регистрацию изменений...";
		//масСообщения.Добавить(стрКомментарий);
		Если ЕстьДанныеДляВыгрузки Тогда
			Попытка
				
				мПрокси.ExportKP(ПакетXDTO);
				
				КодОшибки   = ПакетXDTO.Result.Value;
				Комментарий = ПакетXDTO.Result.Comment;
				
			Исключение
				КодОшибки = 1;
				стрКомментарий = _СтрокаТекДата()+" операции: при отправке пакета возникли ошибки: " + Символы.ПС + ОписаниеОшибки();
				масСообщения.Добавить(стрКомментарий);
			КонецПопытки;
			
			
			Если КодОшибки = 0 Тогда
				Уровень = УровеньЖурналаРегистрации.Информация;
			Иначе
				ЕстьОшибкиВсего = Истина;
			КонецЕсли;
		Иначе
			КодОшибки = 0;
			стрКомментарий = _СтрокаТекДата()+" Нет данных для выгрузки.";
			масСообщения.Добавить(стрКомментарий);
		КонецЕсли;
		
		КомментарийЖурналаРегистрации = 
		" Код ошибки = "+КодОшибки+";
		| Комментарий = "+стрКомментарий;
		
		ЗаписьЖурналаРегистрации(стрИмяСобытия, Уровень, , , КомментарийЖурналаРегистрации);
		
		// снимаем регистрацию по выгруженным объектам
		Если не ЕстьОшибкиВсего и ЕстьДанныеДляВыгрузки Тогда
			стрКомментарий = _СтрокаТекДата()+" удаляем регистрацию...";
			масСообщения.Добавить(стрКомментарий);
			
			Для каждого СтрокаСписка Из СписокКлиенты цикл 		
				ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбменаСсылка, СтрокаСписка.Ссылка);
				
				Если ЗначениеЗаполнено(СтрокаСписка.ЮрЛицо) Тогда
					ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбменаСсылка, СтрокаСписка.ЮрЛицо);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;				
		//
				
		// договоры ду
		СписокДУ = ПолучитьСписокДоговороДУ();   
				
		ПакетXDTO = мФабрика.Создать(мФабрика.Тип(мПространствоИменDU, "type_root"));		
		invest_date  = мФабрика.Создать(мФабрика.Тип(мПространствоИменDU, "type_invest_date"));
		ТипЗапись = мФабрика.Тип(мПространствоИменDU, "type_invest_date_item");
		
		Для каждого СтрокаСписка Из СписокДУ цикл 		
			
			Если СокрЛП(СтрокаСписка.НомерДоговора) = "" Тогда
				Сообщить("Для номера договора " + СтрокаСписка.Ссылка);
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаСписка.ДатаВводаСредствВДУ) Тогда
				Продолжить;
			КонецЕсли;
			
			обЗапись = мФабрика.Создать(ТипЗапись);

			обЗапись.AgreementNumber 	= СокрЛП(СтрокаСписка.НомерДоговора);	
			обЗапись.InvestDate		 	= Формат(?(СтрокаСписка.ДатаВводаСредствВДУ = Дата(1,1,1), Дата(1900, 1, 1), СтрокаСписка.ДатаВводаСредствВДУ), "ДФ=yyyy-MM-dd");
			
			ПакетXDTO.invest_date.Добавить(обЗапись);
			
			стрКомментарий = _СтрокаТекДата() + " Выгружена дата инвестирования для " + СокрЛП(СтрокаСписка.НомерДоговора);
			масСообщения.Добавить(стрКомментарий);			
			
		КонецЦикла;
		
		Если ПакетXDTO.invest_date.Количество() >  0 Тогда
			ЕстьДанныеДляВыгрузки = Истина;
			стрКомментарий = _СтрокаТекДата()+" Записей к выгрузке (даты инвестирования): "+ПакетXDTO.invest_date.Количество();
			масСообщения.Добавить(стрКомментарий);
		КонецЕсли;
		
		// IMDEV-8927 ++
		КоличествоДатИнвестЗамера = ПакетXDTO.invest_date.Количество();
		// IMDEV-8927 --
		
		Если ЕстьДанныеДляВыгрузки Тогда
			Попытка
				
				мПрокси.ExportHNWI(ПакетXDTO);
				
				КодОшибки   = ПакетXDTO.result.code;
				стрКомментарий = ПакетXDTO.result.description;
				
			Исключение
				КодОшибки = 1;
				стрКомментарий = _СтрокаТекДата()+" операции: при отправке пакета возникли ошибки: " + Символы.ПС + ОписаниеОшибки();
			КонецПопытки;
		
		
			Если КодОшибки = 0 Тогда
				Уровень = УровеньЖурналаРегистрации.Информация;
			Иначе
				Если стрКомментарий <> "" Тогда
					масСообщения.Добавить(стрКомментарий);
				КонецЕсли;
				ЕстьОшибкиВсего = Истина;
			КонецЕсли;
		Иначе
			КодОшибки = 0;
		КонецЕсли;
		
		Если не ЕстьОшибкиВсего и ЕстьДанныеДляВыгрузки Тогда
			стрКомментарий = _СтрокаТекДата()+" удаляем регистрацию...";
			масСообщения.Добавить(стрКомментарий);
			
			Для каждого СтрокаСписка Из СписокДУ цикл 		
				ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбменаСсылка, СтрокаСписка.ДоговорДУ);				
			КонецЦикла;
			
		КонецЕсли;  		
		///   
		
		// снимаем регистрацию по объектам. которые не участвуют в обмене
		Для Каждого СтрокаДляОбмена Из УзелОбменаСсылка.Метаданные().Состав Цикл
			
			МетаданныеОбъекта = СтрокаДляОбмена.Метаданные;
			
			Если мМетаданныеДляОграничения.Найти(МетаданныеОбъекта) = Неопределено Тогда
				ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбменаСсылка, МетаданныеОбъекта);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьОшибкиВсего Тогда
			стрКомментарий = _СтрокаТекДата()+" что то пошло не так...";
			масСообщения.Добавить(стрКомментарий);
		Иначе
			Если ЕстьДанныеДляВыгрузки Тогда
				стрКомментарий = _СтрокаТекДата()+" Вы пришли к успеху!!!";
				масСообщения.Добавить(стрКомментарий);
			КонецЕсли;
		КонецЕсли;
		ЗаписьЖурналаРегистрации(стрИмяСобытия, УровеньЖурналаРегистрации.Информация, , , стрКомментарий);
		
		стрКомментарий = "";
		Для каждого стрКом Из масСообщения Цикл
			стрКомментарий = стрКомментарий + Символы.ПС + стрКом;
			Сообщить(стрКом);
		КонецЦикла;
		ЗаписьЖурналаРегистрации(стрИмяСобытия, УровеньЖурналаРегистрации.Информация, , , "Выгруженные объекты: "+стрКомментарий);
	КонецЕсли; 

	Если ЗапускатьРассылку Тогда
		РассылкаСообщения(масСообщения, ЕстьОшибкиВсего);
	Иначе
		стрКомментарий = _СтрокаТекДата()+" Рассылка лога обмена отключена";
		ЗаписьЖурналаРегистрации(стрИмяСобытия, УровеньЖурналаРегистрации.Информация, , , стрКомментарий);
	КонецЕсли;
	
	// MPazhukov IMDEV-2078	
	Если ЗапускатьРассылку Тогда
		РассылкаСообщенияКорпКлиента(МассивПисем);
	Иначе
		Для Каждого Элемент из МассивПисем Цикл
			Сообщить(Элемент);	
		КонецЦикла;		
	КонецЕсли;
	// MPazhukov IMDEV-2078
		
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераВыгрузки > 0 Тогда
		КоличествоВыгруженныхЗамера = КоличествоКлиентовЗамера + КоличествоДатИнвестЗамера;
		ВесЗамераВыгрузки = ?(КоличествоВыгруженныхЗамера > 0, КоличествоВыгруженныхЗамера, 1);
		КомментарийЗамераВыгрузки = "Клиентов=" + КоличествоКлиентовЗамера
			+ "; ДатИнвестирования=" + КоличествоДатИнвестЗамера
			+ "; Ошибки=" + ?(ЕстьОшибкиВсего, "Да", "Нет")
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераВыгрузки, ВремяНачалаЗамераВыгрузки);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияВыгрузки,
			ВремяНачалаЗамераВыгрузки,
			ВесЗамераВыгрузки,
			КомментарийЗамераВыгрузки,
			ЕстьОшибкиВсего);
	КонецЕсли;
	// IMDEV-8927 --
	
	Если ЕстьОшибкиВсего Тогда 
		Возврат "Есть Ошибки"; 
	КонецЕсли;
	
	Возврат ""; 
КонецФункции

// IMDEV-8927 ++
// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Формирует имя ключевой операции БСП для замера
// по этапу обработки и контуру запуска.
//
// Параметры:
// ЭтапЗамера - Строка - этап замера (например, Выгрузка)
//
// Возвращаемое значение:
// Строка - имя ключевой операции в формате ДУ.ЭкспортHNWI.<Этап>.<Контур>
//
Функция ПолучитьИмяКлючевойОперацииЗамера(Знач ЭтапЗамера)
	Возврат "ДУ.ЭкспортHNWI." + ЭтапЗамера + "."
		+ ?(ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера), ИдентификаторКомандыДляЗамера, "Ручной");
КонецФункции
