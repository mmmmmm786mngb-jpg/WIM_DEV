Функция ПроверитьРезультатНаВалидность(Узел, Фабрика, ПространствоИмен) Экспорт
	
	КорневойТип = Узел.Тип();
	
	ЧтениеФайла = Новый ЧтениеXML;
	ЧтениеФайла.УстановитьСтроку(ВернутьТекстXML(Узел, Фабрика, ПространствоИмен));
	ЧтениеФайла.Прочитать();
	
	Попытка 
		Фабрика.ПрочитатьXML(ЧтениеФайла, КорневойТип);
	Исключение
		ТекстОшибки = "---------------------------------------------------------------------------"
			+Символы.ПС+"Возникла ошибка при выгрузке секции "+КорневойТип.Имя+Символы.ПС+ОписаниеОшибки();
		Сообщить(ТекстОшибки);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
