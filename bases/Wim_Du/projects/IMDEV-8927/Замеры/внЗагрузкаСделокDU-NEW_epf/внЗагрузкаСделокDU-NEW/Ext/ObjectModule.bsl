// Описание: Загружает сделки из веб-сервиса TIBCO и обрабатывает их
//
// Параметры:
//   Отказ - Булево - флаг отказа выполнения операции
//   ТекстОшибки - Строка - текст ошибки (необязательный)
//   РежимЗагрузки - Строка - режим загрузки: "РЕПО" для работы только с РЕПО сделками, Неопределено для обычной загрузки (необязательный)
//
// Примеры:
//   ЗагрузитьОбъекты(Отказ); // Обычная загрузка всех сделок
//   ЗагрузитьОбъекты(Отказ, "", "РЕПО"); // Загрузка только РЕПО сделок
//
Процедура ЗагрузитьОбъекты(Отказ, ТекстОшибки = "", РежимЗагрузки = Неопределено) Экспорт
	
	// IMDEV-8927 ++
	ВремяНачалаЗамераПолученияСделок = 0;
	КоличествоСделокИзTibco = 0;
	КлючеваяОперацияПолучениеСделок = ПолучитьИмяКлючевойОперацииЗамера("ПолучениеTibco");
	ВремяНачалаЗамераПолученияСделок = ОценкаПроизводительности.НачатьЗамерВремени();
	// IMDEV-8927 --
	
	Лог = Новый ТабличныйДокумент;
	Лог.ОтображатьГруппировки 	= Ложь;
	Лог.ОтображатьСетку 		= Ложь;
	Лог.ОтображатьЗаголовки 	= Ложь;
	
	Заголовок = Макет.ПолучитьОбласть("Заголовок");
	Лог.Вывести(Заголовок);
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.ДатаНачала 		= ДатаНачала;
	Шапка.Параметры.ДатаОкончания 	= ДатаОкончания;
	Шапка.Параметры.ДатаФормирования = ТекущаяДата();
	Шапка.Параметры.Настройки		= ПредставлениеНастроек;
	Лог.Вывести(Шапка);
	
	Ошибка = Макет.ПолучитьОбласть("Ошибка");
	
	ПолноеИмяФайлаWSDL = ПолучитьИмяВременногоФайла("wsdl");
	
	ФайлWSDL = ПолучитьМакет("WSDL");
	ФайлWSDL.Записать(ПолноеИмяФайлаWSDL);
	
	Попытка 
		//		 Определение = Новый WSОпределения(ПолноеИмяФайлаWSDL);
		TIBCO_URL = ?(ТестовыйРежим, "http://smsk02ap209u:8889/", "http://amaptibco:8889/");
		
		Определение = Новый WSОпределения(TIBCO_URL);
		
		Фабрика = Определение.ФабрикаXDTO;
		
		Корень_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "Корень");
		Условия_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "Условия");
		Корень 		= Фабрика.Создать(Корень_ТИП);
		Условия 	= Фабрика.Создать(Условия_ТИП);
		
		Условия.ДатаС 	= ДатаНачала;
		Условия.ДатаПо 	= ДатаОкончания;
		Условия.База	= DV_BrokerCode(ДоговорДУ);
		Условия.База	= DV_BrokerCode1;
		Условия.База2	= DV_BrokerCode2;
		//IMAPPS-15318++
		//Условия.ТолькоOTC = ТолькоОТССделки;;
		
		Условия.ОтборOTC = ОтборOTC;;
		Если ОтборАктивы.Количество() Тогда
			Для каждого СтрОтборАктив Из ОтборАктивы Цикл
				Если ЗначениеЗаполнено(СтрОтборАктив.Актив) Тогда
					Если ЗначениеЗаполнено(СтрОтборАктив.Актив.ISIN) Тогда 
						Условия.ISIN.Добавить(СтрОтборАктив.Актив.ISIN);	
					КонецЕсли;
					
					Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрОтборАктив.Актив.Объект,"БиржиЛистинга") Тогда
						Для каждого СтрБиржаЛистинга Из СтрОтборАктив.Актив.Объект.БиржиЛистинга Цикл
							Если ЗначениеЗаполнено(СтрБиржаЛистинга.КодЦБ) Тогда
								Условия.ISIN.Добавить(СтрБиржаЛистинга.КодЦБ);	
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					
					Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрОтборАктив.Актив.Объект,"ISIN") 
						И ЗначениеЗаполнено(СтрОтборАктив.Актив.Объект.ISIN) Тогда
						Условия.ISIN.Добавить(СтрОтборАктив.Актив.Объект.ISIN);	
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		//IMAPPS-15318--
		
		Корень.Условия = Условия;
		//Если ТестовыйРежим тогда
		//	 Ответ = ТестовыйОтвет(Фабрика, Корень_ТИП);
		//Иначе
		Ответ = ОтветЧерезСервис(Определение, Корень);
		//КонецЕсли;
	Исключение
		ТекстОшибки = "Ошибка подключения: " + ОписаниеОшибки();
		сообщить(ТекстОшибки);
		Отказ = Истина;
		Ошибка.Параметры.ОписаниеОшибки = ТекстОшибки;
		Лог.Вывести(Ошибка);
		
	КонецПопытки;
	
	Если Отказ = Истина тогда
		// IMDEV-8927 ++
		Если ВремяНачалаЗамераПолученияСделок > 0 Тогда
			ОценкаПроизводительности.ЗакончитьЗамерВремени(
				КлючеваяОперацияПолучениеСделок,
				ВремяНачалаЗамераПолученияСделок,
				1,
				"Ошибка подключения к Tibco",
				Истина
			);
		КонецЕсли;
		// IMDEV-8927 --
		Возврат;
	КонецЕсли;
	
	Если Ответ.Сделки.Количество() = 0 тогда
		Сообщить("Сделок за указанный период нет");
		// IMDEV-8927 ++
		Если ВремяНачалаЗамераПолученияСделок > 0 Тогда
			ОценкаПроизводительности.ЗакончитьЗамерВремени(
				КлючеваяОперацияПолучениеСделок,
				ВремяНачалаЗамераПолученияСделок,
				1,
				"Tibco=0; Новых=0",
				Ложь
			);
		КонецЕсли;
		// IMDEV-8927 --
		Возврат;
	КонецЕсли;
	
	// IMDEV-8927 ++
	КоличествоСделокИзTibco = Ответ.Сделки[0].Сделка.Количество();
	// IMDEV-8927 --
	
	// IMAPPS-34861: Добавлен вызов процедуры подготовки кэша перед обработкой сделок
	ПодготовитьКэшЗагрузки(Ответ.Сделки[0].Сделка);
	
	// IMAPPS-PARAM: REPO - переключение режима обработки сделок
	ПрочитатьНаСервере(Ответ.Сделки[0].Сделка, Отказ, РежимЗагрузки);
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераПолученияСделок > 0 Тогда
		ВесЗамераПолученияСделок = ?(КоличествоСделокИзTibco > 0, КоличествоСделокИзTibco, 1);
		КомментарийЗамераПолученияСделок = "Tibco=" + КоличествоСделокИзTibco + "; Новых=" + ВсегоНовых
			+ "; Отказ=" + ?(Отказ, "Да", "Нет")
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераПолученияСделок, ВремяНачалаЗамераПолученияСделок);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияПолучениеСделок,
			ВремяНачалаЗамераПолученияСделок,
			ВесЗамераПолученияСделок,
			КомментарийЗамераПолученияСделок,
			Отказ
		);
	КонецЕсли;
	// IMDEV-8927 --

КонецПроцедуры

