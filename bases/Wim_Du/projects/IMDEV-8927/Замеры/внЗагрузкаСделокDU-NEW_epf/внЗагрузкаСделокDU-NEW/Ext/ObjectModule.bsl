// IMAPPS-36975--

// Распределяет договоры по пачкам с примерно равной суммарной нагрузкой (по количеству сделок)
// Использует жадный алгоритм largest-first + выбор наименее загруженной пачки
// Оптимизировано для скорости: отдельный массив весов для быстрого поиска минимума
//
// Параметры:
//   СделкиПоДоговорам     - Соответствие - {ДоговорДУ -> ТаблицаЗначений со сделками}
//   КоличествоПачек       - Число        - желаемое количество параллельных потоков/пачек
//
// Возвращаемое значение:
//   Массив из Структур с полями:
//     * СоответствиеДоговораИСделок - Соответствие
//     * КоличествоСделокВПачке      - Число
//
Функция РаспределитьДоговорыПоПачкам(СделкиПоДоговорам, КоличествоПачек) Экспорт

	Если КоличествоПачек <= 0 Тогда
		КоличествоПачек = 1;
	КонецЕсли;

	// 1. Собираем только непустые договоры и сортируем по убыванию количества сделок
	ДоговорыПоРазмеру = Новый ТаблицаЗначений;
	ДоговорыПоРазмеру.Колонки.Добавить("ДоговорДУ");
	ДоговорыПоРазмеру.Колонки.Добавить("КоличествоСделок", Новый ОписаниеТипов("Число"));
	ДоговорыПоРазмеру.Колонки.Добавить("ТаблицаСделок");

	Для Каждого КлючИЗначение Из СделкиПоДоговорам Цикл
		Колво = КлючИЗначение.Значение.Количество();
		Если Колво = 0 Тогда
			Продолжить; // пропускаем пустые договоры
		КонецЕсли;

		Строка = ДоговорыПоРазмеру.Добавить();
		Строка.ДоговорДУ       = КлючИЗначение.Ключ;
		Строка.КоличествоСделок = Колво;
		Строка.ТаблицаСделок   = КлючИЗначение.Значение;
	КонецЦикла;

	Если ДоговорыПоРазмеру.Количество() = 0 Тогда
		Возврат Новый Массив; // ничего нет → пустой результат
	КонецЕсли;

	ДоговорыПоРазмеру.Сортировать("КоличествоСделок Убыв");

	// 2. Инициализация пачек и весов
	Пачки = Новый Массив;
	ВесаПачек = Новый Массив; // текущий вес (кол-во сделок) каждой пачки

	Для Сч = 1 По КоличествоПачек Цикл
		Пачка = Новый Структура("СоответствиеДоговораИСделок, КоличествоСделокВПачке",
			Новый Соответствие,
			0);
		Пачки.Добавить(Пачка);
		ВесаПачек.Добавить(0);
	КонецЦикла;

	// 3. Распределение (жадный алгоритм)
	Для Каждого СтрокаДоговора Из ДоговорыПоРазмеру Цикл

		// Находим индекс пачки с минимальным весом
		МинИндекс = 0;
		МинВес = ВесаПачек[0];

		Для Инд = 1 По ВесаПачек.ВГраница() Цикл
			Если ВесаПачек[Инд] < МинВес Тогда
				МинВес = ВесаПачек[Инд];
				МинИндекс = Инд;
			КонецЕсли;
		КонецЦикла;

		// Добавляем договор в выбранную пачку
		ВыбраннаяПачка = Пачки[МинИндекс];
		ВыбраннаяПачка.СоответствиеДоговораИСделок.Вставить(
			СтрокаДоговора.ДоговорДУ,
			СтрокаДоговора.ТаблицаСделок);

		ВыбраннаяПачка.КоличествоСделокВПачке = ВыбраннаяПачка.КоличествоСделокВПачке + СтрокаДоговора.КоличествоСделок;

		// Обновляем вес
		ВесаПачек[МинИндекс] = ВесаПачек[МинИндекс] + СтрокаДоговора.КоличествоСделок;

	КонецЦикла;

	Возврат Пачки;

КонецФункции

// Описание: Обрабатывает сделки по договору ДУ в фоновом задании
//           Создает бизнес-процессы для всех сделок указанного договора
//           Определяет тип сделки по режиму торгов и создает соответствующий объект (БП или документ)
//           Выполняется в фоновом задании через механизм ДлительныеОперации
//
// Параметры:
//   ПараметрыВыполнения - Структура - содержит:
//     * ТаблицаСделокДоговораXML - Строка - XML-сериализованная таблица значений со сделками договора
//     * ГлобальныеПараметрыXML - Строка - XML-сериализованная структура с глобальными параметрами (БУ, ВУ, УУ, комиссии и т.д.)
//   АдресРезультата - Строка - адрес временного хранилища для возврата результата обработки
//
Процедура СоздатьОбъектыПоДоговору(ПараметрыВыполнения, АдресРезультата) Экспорт

	XMLТаблицаСделок = ПараметрыВыполнения.ТаблицаСделокДоговораXML;  // Теперь содержит пачку!
	XMLГлобальныеПараметры = ПараметрыВыполнения.ГлобальныеПараметрыXML;

	// Десериализация пачки договоров {ДоговорДУ -> ТаблицаСделок}
	ПачкаДоговоров = ДесериализоватьТаблицуИзXML(XMLТаблицаСделок);
	ГлобальныеПараметры = ДесериализоватьТаблицуИзXML(XMLГлобальныеПараметры);

	// Инициализация общего результата пачки (одна структура на всю пачку)
	РезультатДоговора = Новый Структура;
	РезультатДоговора.Вставить("Обработано", 0);
	РезультатДоговора.Вставить("Ошибок", 0);
	РезультатДоговора.Вставить("СписокОшибок", Новый Массив);
	РезультатДоговора.Вставить("СписокСделок", Новый Массив);

	// ИНИЦИАЛИЗАЦИЯ КОНСТАНТ И ГЛОБАЛЬНЫХ ПАРАМЕТРОВ ОДИН РАЗ ПЕРЕД ЦИКЛОМ
	ПС = ПланыСчетов.Хозрасчетный;

	// TM-3342
	ВалютаRUB = Справочники.Валюты.RUB;
	FOT = Перечисления.ПлатежныеУсловияСделки.ПоставкаСвободноОтПлатежа;
	DVP = Перечисления.ПлатежныеУсловияСделки.ПоставкаПротивПлатежа;
	PREPAYMENT = Перечисления.ПлатежныеУсловияСделки.Предоплата;
	POSTPAY = Перечисления.ПлатежныеУсловияСделки.Предпоставка;
	// NIsaychev IMAPPS-15479
	HTM = Перечисления.ТипыПортфелей.ИнвестицииДоПогашения;

	БУ = ГлобальныеПараметры.БУ;
	ВУ = ГлобальныеПараметры.ВУ;
	УУ = ГлобальныеПараметры.УУ;
	Если Не БУ И Не ВУ И Не УУ Тогда
		БУ = Истина;
		ВУ = Истина;
		УУ = Истина;
	КонецЕсли;

	КомиссияБиржи = ГлобальныеПараметры.КомиссияБиржи;
	КомиссияБрокера = ГлобальныеПараметры.КомиссияБрокера;
	КомиссияТС = ГлобальныеПараметры.КомиссияТС;
	КомиссияБиржиДДС = ГлобальныеПараметры.КомиссияБиржиДДС;
	КомиссияБрокераДДС = ГлобальныеПараметры.КомиссияБрокераДДС;
	КомиссияТСДДС = ГлобальныеПараметры.КомиссияТСДДС;

	СчетКомиссииБиржа = ГлобальныеПараметры.СчетКомиссииБиржа;
	СчетКомиссииБрокера = ГлобальныеПараметры.СчетКомиссииБрокера;
	СчетКомиссияТС = ГлобальныеПараметры.СчетКомиссияТС;
	БанкВТБ = ГлобальныеПараметры.БанкВТБ;

	// ЦИКЛ ПО КАЖДОМУ ДОГОВОРУ В ПАЧКЕ
	Для Каждого ЭлементПачки Из ПачкаДоговоров Цикл

		ДоговорДУ = ЭлементПачки.Ключ;
		СписокСделок = ЭлементПачки.Значение;

		// Кеш для запросов к регистру ЗначенияПараметровДоговораДУ
		// Ключ: "ДоговорДУ|ДатаСделки", Значение: Порог
		КешПорогов = Новый Соответствие; // Уникальный кеш для каждого договора
		
		Для Каждого ТекСтрока Из СписокСделок Цикл
			
			Попытка
				
				НачалоДняСделки = НачалоДня(ТекСтрока.ДатаСделки);
				НачалоДняРасчетов = НачалоДня(ТекСтрока.ДатаРасчетов);
				РежимТорговНаименование = Строка(ТекСтрока.РежимТоргов);
				
				Если НЕ БУ И НЕ ВУ И НЕ УУ Тогда
					ТекстОшибки = "Отсутствуют области учета";
					ДобавитьОшибкуВРезультатДоговора(РезультатДоговора, ТекСтрока.НомерСделки, ТекстОшибки);
					ДобавитьИнформациюОСделкеВРезультатДоговора(РезультатДоговора, ТекСтрока, Неопределено, ТекстОшибки, Истина);
					
					Продолжить;
				КонецЕсли;
				
				// IMAPPS-559
				Если НЕ ЗначениеЗаполнено(ТекСтрока.Актив) Тогда
					ТекстОшибки = "Не определен Актив";
					ДобавитьОшибкуВРезультатДоговора(РезультатДоговора, ТекСтрока.НомерСделки, ТекстОшибки);
					ДобавитьИнформациюОСделкеВРезультатДоговора(РезультатДоговора, ТекСтрока, Неопределено, ТекстОшибки, Истина);
					
					Продолжить;
				КонецЕсли;
				
				// MPazhukov IMAPPS-10759
				Если НЕ ЗначениеЗаполнено(ТекСтрока.Актив.ВидАктива) Тогда
					ТекстОшибки = "Не определен ВидАктива";
					ДобавитьОшибкуВРезультатДоговора(РезультатДоговора, ТекСтрока.НомерСделки, ТекстОшибки);
					ДобавитьИнформациюОСделкеВРезультатДоговора(РезультатДоговора, ТекСтрока, Неопределено, ТекстОшибки, Истина);
					
					Продолжить;
				КонецЕсли;
				
				// IMAPPS-1693
				Если НЕ ЗначениеЗаполнено(ТекСтрока.ДоговорДУ) Тогда
					ТекстОшибки = "Не определен ДоговорДУ";
					ДобавитьОшибкуВРезультатДоговора(РезультатДоговора, ТекСтрока.НомерСделки, ТекстОшибки);
					ДобавитьИнформациюОСделкеВРезультатДоговора(РезультатДоговора, ТекСтрока, Неопределено, ТекстОшибки, Истина);
					
					Продолжить;
				КонецЕсли;
				
				ТекСделка = Неопределено;
				Отказ = Ложь;
				ТекстОшибки = "";
				
				//DV 07/05/14
				Если РежимТорговНаименование = "OTC" Тогда
					
					ТекСделка = БизнесПроцессы.ВнебиржеваяСделка.СоздатьБизнесПроцесс();
					ТекСделка.Номер = ТекСтрока.НомерСделки;
					// VTB-Borisov 23.10.2017
					ТекСделка.НомерСделки = ТекСтрока.НомерСделки;
					ТекСделка.Дата = ТекСтрока.ДатаСделки;
					ТекСделка.ВидОперации = ?(ТекСтрока.Продажа, Перечисления.ВидОперацииБПВнебиржеваяСделка.Продажа, Перечисления.ВидОперацииБПВнебиржеваяСделка.Покупка);
					ТекСделка.ДоговорДУ = ДоговорДУ;
					ТекСделка.АналитическийСчетЦБ = ТекСтрока.АналитическийСчетЦБ;
					ТекСделка.АналитическийСчетДС = ТекСтрока.АналитическийСчетДС;
					ТекСделка.ФизическоеМестоХраненияДС = ТекСтрока.АналитическийСчетДС;
					ТекСделка.Контрагент = ТекСтрока.Брокер;
					ТекСделка.ДоговорКонтрагента = ТекСтрока.ДоговорБрокера;
					ТекСделка.ВалютаВзаиморасчетов = ТекСтрока.ВалютаСделки;
					ТекСделка.КурсВзаиморасчетов = ТекСтрока.КурсВалютыСделки;
					ТекСделка.КратностьВзаиморасчетов = ТекСтрока.КратностьВалютыСделки;
					ТекСделка.КурсАктива = ТекСтрока.КурсВалютыСделки;
					ТекСделка.КратностьАктива = ТекСтрока.КратностьВалютыСделки;
					ТекСделка.ОпределятьКурсНаДатуОперации = Истина;
					ТекСделка.ОпределятьКурсАктиваНаДатуОперации = Истина;
					ТекСделка.ДатаПлатежа = ?(ЗначениеЗаполнено(ТекСтрока.ДатаОплаты),ТекСтрока.ДатаОплаты,ТекСтрока.ДатаРасчетов);
					ТекСделка.СрокПлатежа = КалендарныеГрафики.ПолучитьЧислоРабочихДнейПериода(, НачалоДня(ТекСделка.Дата), ТекСделка.ДатаПлатежа) - 1;
					ТекСделка.СчетУчетаВзаиморасчетов = ?(ТекСтрока.Продажа,ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.03"),ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.02"));
					
					ТекСделка.БУ = БУ;
					ТекСделка.ВУ = ВУ;
					ТекСделка.УУ = УУ;
					
					
					ТекСделка.Актив = ТекСтрока.Актив;
					ТекСделка.ВалютаАктива = ТекСтрока.Актив.Объект.ВалютаНоминальнойСтоимости;
					ТекСделка.Количество = ТекСтрока.Количество;
					ТекСделка.СуммаСделки = ТекСтрока.Сумма;
					Если ТекСтрока.Актив.ВидАктива.ПринадлежитЭлементу(ПланыВидовХарактеристик.ВидыАктивов.Облигации) Тогда
						ТекСделка.КотировкаОблигации = ТекСтрока.Цена;
						ТекСделка.Цена = ?(ТекСделка.Количество=0,ТекСделка.СуммаСделки,ТекСделка.СуммаСделки/ТекСделка.Количество);
					Иначе
						ТекСделка.Цена = ТекСтрока.Цена;
					КонецЕсли;
					
					ТекСделка.НКД = ТекСтрока.НКД;
					ТекСделка.СрокПеререгистрации = ТекСтрока.ДатаРасчетов;
					ТекСделка.ИсполнениеСделки = КалендарныеГрафики.ПолучитьЧислоРабочихДнейПериода(, НачалоДня(ТекСделка.Дата), ТекСделка.СрокПеререгистрации) - 1;
					ТекСделка.СторонаНесущаяРасходыПоПеререгистрации = "мы";
					ТекСделка.СторонаОсуществляющаяПеререгистрациюЦБ = "мы";
					
					ДопРасход = ТекСделка.ДопРасходы.Добавить();
					ДопРасход.Стоимость	= ТекСтрока.КомиссияБрокера;
					ДопРасход.СтатьяЗатрат = КомиссияБрокера;
