// IMAPPS-34861 Описание: Создает бизнес-процессы (сделки) из таблицы загрузки сделок
//           Группирует сделки по договорам ДУ и запускает параллельную обработку через ДлительныеОперации
//           Управляет пулом фоновых заданий с ограничением максимального количества одновременных заданий
//           Выводит статистику обработки и информацию о каждой сделке в лог
//
// Параметры:
//   Отказ - Булево - признак отказа в выполнении (если Истина, процедура завершается без выполнения)
//   ТекстОшибки - Строка - текст ошибки (необязательный параметр)
//
Процедура СоздатьОбъекты(Отказ, ТекстОшибки = "") Экспорт
	
	Если Отказ Тогда Возврат; КонецЕсли;
	
	// IMDEV-8927 ++
	ВремяНачалаЗамераСозданияСделок = 0;
	КлючеваяОперацияСозданиеСделок = ПолучитьИмяКлючевойОперацииЗамера("СозданиеСделок");
	ВремяНачалаЗамераСозданияСделок = ОценкаПроизводительности.НачатьЗамерВремени();
	// IMDEV-8927 --
	
	// Счетчики для статистики
	ВсегоСделокОбработано = 0;
	ВсегоОшибок = 0;
	ВсеОшибки = Новый Массив;
	ВремяНачалаФормированияСделок = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КвоЗапущенных = 0;

	// Счетчики для статистики валютных сделок
	ВсегоВалютныхСделокОбработано = 0;
	ВсегоОшибокВалютныхСделок = 0;
	
	ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	Лог.Вывести(ЗаголовокТаблицы);
	
	СтрокаДокументов = Макет.ПолучитьОбласть("СтрокаТаблицы");
	
	// Группировка сделок по ДоговорДУ для параллельной обработки
	СделкиПоДоговорам = Новый Соответствие;
	
	// Кэшируем структуру колонок для быстрого создания таблиц
	СтруктураКолонок = СписокЗагрузки.ВыгрузитьКолонки();
	
	ИндексСтроки = 0;
	Для Каждого ТекСтрока Из СписокЗагрузки Цикл
		ИндексСтроки = ИндексСтроки + 1;
		ДоговорДУ = ТекСтрока.ДоговорДУ;
		
		Если Не ЗначениеЗаполнено(ДоговорДУ) Тогда
			// Логируем информацию о пустом договоре
			СтрокаДокументов.Параметры.Заполнить(ТекСтрока);
			СтрокаДокументов.Параметры.ОшибкаСделки = "Отсутствует договор ДУ по номеру сделки " + ТекСтрока.НомерСделки;
			СтрокаДокументов.Параметры.ЕстьОшибки = "ДА";
			СтрокаДокументов.Параметры.ДоговорДУ = "<???>";
			Лог.Вывести(СтрокаДокументов);
			
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("ДоговорДУ", СтрокаДокументов.Параметры.ДоговорДУ);
			СтруктураОшибки.Вставить("ТекстОшибки", СтрокаДокументов.Параметры.ОшибкаСделки);
			ВсеОшибки.Добавить(СтруктураОшибки);
			ВсегоОшибок = ВсегоОшибок + 1;
			Продолжить;
		КонецЕсли;
		
		ТаблицаСделокДоговора = СделкиПоДоговорам.Получить(ДоговорДУ);
		Если ТаблицаСделокДоговора = Неопределено Тогда
			ТаблицаСделокДоговора = СтруктураКолонок.Скопировать();
			// Добавляем колонку ИндексСтроки в новую таблицу
			ТаблицаСделокДоговора.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
			СделкиПоДоговорам.Вставить(ДоговорДУ, ТаблицаСделокДоговора);
		КонецЕсли;
		
		НоваяСтрока = ТаблицаСделокДоговора.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.ИндексСтроки = ИндексСтроки; // Присваиваем индекс
	КонецЦикла;
	
	// Распределение договоров по пачкам с равномерной нагрузкой
	МаксимумОдновременныхЗаданий = ?(КоличествоПотоковСозданияСделок <= 0, 1, КоличествоПотоковСозданияСделок);
	МассивСтруктурПачек = РаспределитьДоговорыПоПачкам(СделкиПоДоговорам, МаксимумОдновременныхЗаданий);

	// Создание очереди пачек для обработки (только непустые пачки)
	ОчередьПачек = Новый Массив;
	Для Каждого СтруктураПачки Из МассивСтруктурПачек Цикл
		// Проверяем, что в пачке есть хотя бы один договор
		Если СтруктураПачки.СоответствиеДоговораИСделок.Количество() > 0 Тогда
			ОчередьПачек.Добавить(СтруктураПачки);
		КонецЕсли;
	КонецЦикла;

	// Определяем режим обработки: параллельный (несколько пачек) или последовательный (одна пачка)
	ВыполнятьВПараллельномРежиме = (ОчередьПачек.Количество() > 1);
	
	// Инициализация структур для управления заданиями
	АктивныеЗадания = Новый Соответствие; // GUID -> Структура с информацией
	ИндексОчереди = 0;
	
	// Таблица для успешно обработанных сделок (для последующего удаления из списка)
	ТаблицаУдаления = Новый ТаблицаЗначений;
	ТаблицаУдаления.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
	
	// Идентификатор формы для ДлительныеОперации
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	
	// Получение ссылки на обработку из справочника
	ДополнительнаяОбработкаСсылка = ПолучитьСсылкуНаОбработкуИзСправочника();
	
	// Создаем структуру глобальных параметров (все параметры кроме ДоговорДУ известны заранее)
	ГлобальныеПараметры = Новый Структура;
	ГлобальныеПараметры.Вставить("БУ", БУ);
	ГлобальныеПараметры.Вставить("ВУ", ВУ);
	ГлобальныеПараметры.Вставить("УУ", УУ);
	ГлобальныеПараметры.Вставить("КомиссияБиржи", КомиссияБиржи);
	ГлобальныеПараметры.Вставить("КомиссияБрокера", КомиссияБрокера);
	ГлобальныеПараметры.Вставить("КомиссияТС", КомиссияТС);
	ГлобальныеПараметры.Вставить("КомиссияБиржиДДС", КомиссияБиржиДДС);
	ГлобальныеПараметры.Вставить("КомиссияБрокераДДС", КомиссияБрокераДДС);
	ГлобальныеПараметры.Вставить("КомиссияТСДДС", КомиссияТСДДС);
	ГлобальныеПараметры.Вставить("СчетКомиссииБиржа", СчетКомиссииБиржа);
	ГлобальныеПараметры.Вставить("СчетКомиссииБрокера", СчетКомиссииБрокера);
	ГлобальныеПараметры.Вставить("СчетКомиссияТС", СчетКомиссияТС);
	ГлобальныеПараметры.Вставить("БанкВТБ", БанкВТБ);
	
	// Основной цикл управления пулом заданий
	Пока ИндексОчереди < ОчередьПачек.Количество() ИЛИ АктивныеЗадания.Количество() > 0 Цикл
		
		// ШАГ 1: Проверить завершенные задания (неблокирующая проверка)
		МассивЗавершенныхGUID = Новый Массив;
		
		Для Каждого ЭлементЗадания Из АктивныеЗадания Цикл
			GUIDЗадания = ЭлементЗадания.Ключ;
			ИнформацияОЗадании = ЭлементЗадания.Значение;

			Попытка
				// Для синхронного выполнения статус сразу "Выполнено"
				Если GUIDЗадания = "СИНХРОННОЕ_ВЫПОЛНЕНИЕ" Тогда
					РезультатОперации = Новый Структура("Статус", "Выполнено");
				Иначе
					// Проверяем статус операции через ДлительныеОперации
					РезультатОперации = ДлительныеОперации.ОперацияВыполнена(GUIDЗадания);
				КонецЕсли;
				
				Если РезультатОперации.Статус = "Выполнено" Тогда
					Попытка
						РезультатЗаданияXML = ПолучитьИзВременногоХранилища(ИнформацияОЗадании.АдресХранилищаРезультата);
						РезультатЗадания = ДесериализоватьТаблицуИзXML(РезультатЗаданияXML);
						
						ВсегоСделокОбработано = ВсегоСделокОбработано + РезультатЗадания.Обработано;
						ВсегоОшибок = ВсегоОшибок + РезультатЗадания.Ошибок;
						
						Для Каждого Ошибка Из РезультатЗадания.СписокОшибок Цикл
							ВсеОшибки.Добавить(Ошибка);
						КонецЦикла;
						
						// Вывод информации о каждой сделке в Лог и сбор успешно обработанных для удаления
						Для Каждого ИнформацияОСделке Из РезультатЗадания.СписокСделок Цикл
							СтрокаДокументов.Параметры.Заполнить(ИнформацияОСделке.ТекСтрока);
							СтрокаДокументов.Параметры.Сделка = ?(ИнформацияОСделке.Отказ, "", ИнформацияОСделке.Сделка);
							СтрокаДокументов.Параметры.ОшибкаСделки = ?(ИнформацияОСделке.Отказ, ИнформацияОСделке.ТекстОшибки, "");
							СтрокаДокументов.Параметры.ЕстьОшибки = ?(ИнформацияОСделке.Отказ, "ДА", "");
							
							Если ИнформацияОСделке.ТекСтрока.ДоговорДУ.Пустая() Тогда
								СтрокаДокументов.Параметры.ДоговорДУ = "<???>";
							КонецЕсли;
							
							Лог.Вывести(СтрокаДокументов);
							
							// Добавляем успешно обработанные сделки в ТаблицаУдаления
							Если НЕ ИнформацияОСделке.Отказ Тогда
								Если ЗначениеЗаполнено(ИнформацияОСделке.ТекСтрока) И ЗначениеЗаполнено(ИнформацияОСделке.ТекСтрока.ИндексСтроки) Тогда
									НоваяСтрокаУдаления = ТаблицаУдаления.Добавить();
									НоваяСтрокаУдаления.ИндексСтроки = ИнформацияОСделке.ТекСтрока.ИндексСтроки;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					Исключение
						СтруктураОшибки = Новый Структура;
						СтруктураОшибки.Вставить("ДоговорДУ", ИнформацияОЗадании.ДоговорДУ);
						СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка чтения результатов: " + ОписаниеОшибки());
						ВсеОшибки.Добавить(СтруктураОшибки);
					КонецПопытки;
					
					МассивЗавершенныхGUID.Добавить(GUIDЗадания);
					
				ИначеЕсли РезультатОперации.Статус = "Ошибка" Тогда
					СтруктураОшибки = Новый Структура;
					СтруктураОшибки.Вставить("ДоговорДУ", ИнформацияОЗадании.ДоговорДУ);
					Если ЗначениеЗаполнено(РезультатОперации.КраткоеПредставлениеОшибки) Тогда
						СтруктураОшибки.Вставить("ТекстОшибки", РезультатОперации.КраткоеПредставлениеОшибки);
					Иначе
						СтруктураОшибки.Вставить("ТекстОшибки", "Задание завершилось с ошибкой");
					КонецЕсли;
					ВсеОшибки.Добавить(СтруктураОшибки);
					МассивЗавершенныхGUID.Добавить(GUIDЗадания);
					
				ИначеЕсли РезультатОперации.Статус = "Отменено" Тогда
					МассивЗавершенныхGUID.Добавить(GUIDЗадания);
					
				ИначеЕсли РезультатОперации.Статус = "Выполняется" Тогда
					// Задание еще выполняется, пропускаем
					Продолжить;
				КонецЕсли;
				
			Исключение
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("ДоговорДУ", ИнформацияОЗадании.ДоговорДУ);
				СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка проверки задания: " + ОписаниеОшибки());
				ВсеОшибки.Добавить(СтруктураОшибки);
				МассивЗавершенныхGUID.Добавить(GUIDЗадания);
			КонецПопытки;
			
		КонецЦикла;
		
		// Удалить завершенные из активных
		Для Каждого ЗавершенныйGUID Из МассивЗавершенныхGUID Цикл
			АктивныеЗадания.Удалить(ЗавершенныйGUID);
		КонецЦикла;
		
		// ШАГ 2: Запустить новые задания из очереди пачек
		Пока АктивныеЗадания.Количество() < МаксимумОдновременныхЗаданий
			И ИндексОчереди < ОчередьПачек.Количество() Цикл

			СтруктураПачки = ОчередьПачек[ИндексОчереди];
			Пачка = СтруктураПачки.СоответствиеДоговораИСделок;
			КоличествоСделокВПачке = СтруктураПачки.КоличествоСделокВПачке;

			// Подготовка параметров для ДлительныеОперации
			ПараметрыВыполненияВФоне = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
			ПараметрыВыполненияВФоне.КлючФоновогоЗадания = Строка(Новый УникальныйИдентификатор);
			ПараметрыВыполненияВФоне.НаименованиеФоновогоЗадания = "Загрузка сделок по пачке (" + КоличествоСделокВПачке + " сделок, " + Пачка.Количество() + " договоров)";

			// Если пачка всего одна - выполняем синхронно, иначе - в фоне
			Если ВыполнятьВПараллельномРежиме Тогда
				ПараметрыВыполненияВФоне.ЗапуститьВФоне = Истина;
			Иначе
				ПараметрыВыполненияВФоне.ЗапуститьВФоне = Ложь;
				ПараметрыВыполненияВФоне.ЗапуститьНеВФоне = Истина;
			КонецЕсли;

			//////ПараметрыВыполненияВФоне.ОжидатьЗавершение = 0;
			// Подготовка параметров для процедуры СоздатьОбъектыПоДоговору в модуле объекта
			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("ИмяОбработки", ЭтотОбъект.Метаданные().Имя);
			ПараметрыЗадания.Вставить("ИмяМетода", "СоздатьОбъектыПоДоговору");
			ПараметрыЗадания.Вставить("ПараметрыВыполнения", Новый Структура);
			ПараметрыЗадания.ПараметрыВыполнения.Вставить("ТаблицаСделокДоговораXML", XML(Пачка));  // Теперь передаем пачку!
			ПараметрыЗадания.ПараметрыВыполнения.Вставить("ГлобальныеПараметрыXML", XML(ГлобальныеПараметры));
			ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
			Если ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
				ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
			КонецЕсли;
			
			Попытка
				// Запуск через ДлительныеОперации
				РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне(
					"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
					ПараметрыЗадания,
					ПараметрыВыполненияВФоне
				);
				
				Если РезультатВыполнения.Статус = "Ошибка" Тогда
					СтруктураОшибки = Новый Структура;
					ОписаниеПачки = "Пачка из " + Пачка.Количество() + " договоров";
					СтруктураОшибки.Вставить("ДоговорДУ", ОписаниеПачки);
					Если ЗначениеЗаполнено(РезультатВыполнения.КраткоеПредставлениеОшибки) Тогда
						СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка запуска задания: " + РезультатВыполнения.КраткоеПредставлениеОшибки);
					Иначе
						СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка запуска задания");
					КонецЕсли;
					ВсеОшибки.Добавить(СтруктураОшибки);
				Иначе
					АдресХранилищаРезультата = РезультатВыполнения.АдресРезультата;

					ИнформацияОЗадании = Новый Структура;
					ОписаниеПачки = "Пачка из " + Пачка.Количество() + " договоров";
					ИнформацияОЗадании.Вставить("ДоговорДУ", ОписаниеПачки);
					ИнформацияОЗадании.Вставить("АдресХранилищаРезультата", АдресХранилищаРезультата);

					// Для синхронного выполнения используем специальный ключ
					Если ВыполнятьВПараллельномРежиме Тогда
						ИдентификаторЗадания = РезультатВыполнения.ИдентификаторЗадания;
					Иначе
						ИдентификаторЗадания = "СИНХРОННОЕ_ВЫПОЛНЕНИЕ";
					КонецЕсли;

					АктивныеЗадания.Вставить(ИдентификаторЗадания, ИнформацияОЗадании);
					КвоЗапущенных = КвоЗапущенных + 1;
				КонецЕсли;
				
			Исключение
				СтруктураОшибки = Новый Структура;
				ОписаниеПачки = "Пачка из " + Пачка.Количество() + " договоров";
				СтруктураОшибки.Вставить("ДоговорДУ", ОписаниеПачки);
				СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка запуска задания: " + ОписаниеОшибки());
				ВсеОшибки.Добавить(СтруктураОшибки);
			КонецПопытки;
			
			ИндексОчереди = ИндексОчереди + 1;
		КонецЦикла;
		
		// ШАГ 3: Пауза перед следующей проверкой (только при множественной обработке)
		Если АктивныеЗадания.Количество() > 0 И ВыполнятьВПараллельномРежиме Тогда
			VTB_ОбщийМодуль.Пауза(5); // секунды
		КонецЕсли;
		
	КонецЦикла;
	
	// Вывод статистики обработки
	ВремяОкончанияФормированияСделок = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПрошлоВремени = ВремяОкончанияФормированияСделок - ВремяНачалаФормированияСделок;
	ПрошлоВремениСек = ПрошлоВремени / 1000;
	Часов = Цел(ПрошлоВремениСек / 3600);
	Минут = Цел((ПрошлоВремениСек - Часов * 3600) / 60);
	Секунд = Цел(ПрошлоВремениСек - Часов * 3600 - Минут * 60);
	
	// Форматирование времени с ведущими нулями
	// ЧВН= включает лидирующие нули, ЧН=00 выводит "00" для нуля
	ВремяФормирования = Формат(Часов, "ЧЦ=2; ЧВН=; ЧН=00") + ":" + 
	                    Формат(Минут, "ЧЦ=2; ЧВН=; ЧН=00") + ":" + 
	                    Формат(Секунд, "ЧЦ=2; ЧВН=; ЧН=00");
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("===========================================================");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  ОБРАБОТКА СДЕЛОК ЗАВЕРШЕНА");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("===========================================================");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("	Обработано сделок: " + Формат(ВсегоСделокОбработано, "ЧГ=; ЧН="));
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("	... с ошибками: " + Формат(ВсегоОшибок, "ЧГ=; ЧН="));
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  Время выполнения: " + ВремяФормирования);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("");
	
	Если ВсеОшибки.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  [ОШИБКА] Обнаружено ошибок: " + Формат(ВсеОшибки.Количество(), "ЧГ=; ЧН="));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("");
		// Выводим первые 10 ошибок
		МаксимумОшибокДляВывода = 10;
		КоличествоВыведенныхОшибок = 0;

		Для Каждого Ошибка Из ВсеОшибки Цикл
			Если КоличествоВыведенныхОшибок >= МаксимумОшибокДляВывода Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("      ... и еще " + Формат(ВсеОшибки.Количество() - МаксимумОшибокДляВывода, "ЧГ=; ЧН=") + " ошибок (смотрите в лог файле)");
				Прервать;
			КонецЕсли;

			Попытка
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("      • Договор: " + Ошибка.ДоговорДУ);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("        Ошибка: " + Ошибка.ТекстОшибки);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("      • Номер сделки: " + Ошибка.НомерСделки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("        Ошибка: " + Ошибка.ТекстОшибки);
			КонецПопытки;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("");

			КоличествоВыведенныхОшибок = КоличествоВыведенныхОшибок + 1;
		КонецЦикла;
	ИначеЕсли ВсегоОшибок > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  [ОШИБКА] Обнаружено прочих ошибок: " + Формат(ВсегоОшибок, "ЧГ=; ЧН="));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  [OK] Ошибок не обнаружено");
	КонецЕсли;

	// Обработка ошибок о не найденных контрагентах (аналог ТаблицаНеНайденныхКонтрагентов))
	ТаблицаНеНайденныхКонтрагентов = Новый ТаблицаЗначений;
	ТаблицаНеНайденныхКонтрагентов.Колонки.Добавить("ДатаСделки", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаНеНайденныхКонтрагентов.Колонки.Добавить("КодБрокера", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	
	ТекстОшибкиНеНайденКонтрагент = "";
	
	// Извлекаем ошибки о не найденных контрагентах из всех ошибок
	Для Каждого Ошибка Из ВсеОшибки Цикл
		Если СтрНайти(Ошибка.ТекстОшибки, "не найден партнер по коду брокера") > 0 Тогда
			// Парсим текст ошибки: "На дату DD.MM.YYYY для БП Сделка РЕПО не найден партнер по коду брокера: КОД"
			ПозицияДаты = СтрНайти(Ошибка.ТекстОшибки, "На дату ");
			ПозицияДля = СтрНайти(Ошибка.ТекстОшибки, " для БП");
			ПозицияКода = СтрНайти(Ошибка.ТекстОшибки, " по коду брокера: ");
			
			Если ПозицияДаты > 0 И ПозицияДля > 0 И ПозицияКода > 0 Тогда
				СтрокаДаты = Сред(Ошибка.ТекстОшибки, ПозицияДаты + 8, ПозицияДля - ПозицияДаты - 8);
				СтрокаКода = Сред(Ошибка.ТекстОшибки, ПозицияКода + 20);
				
				Попытка
					ДатаСделки = Дата(СтрокаДаты);
					КодБрокера = СокрЛП(СтрокаКода);
					
					НоваяСтрокаТаблицы = ТаблицаНеНайденныхКонтрагентов.Добавить();
					НоваяСтрокаТаблицы.ДатаСделки = ДатаСделки;
					НоваяСтрокаТаблицы.КодБрокера = КодБрокера;
				Исключение
					// Если не удалось распарсить, пропускаем
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Сворачиваем таблицу и формируем текст
	Если ТаблицаНеНайденныхКонтрагентов.Количество() > 0 Тогда
		ТаблицаНеНайденныхКонтрагентов.Свернуть("ДатаСделки, КодБрокера");
		
		Для каждого ТекСтрока Из ТаблицаНеНайденныхКонтрагентов Цикл
			СтрокаОшибки = "На дату " + Формат(ТекСтрока.ДатаСделки, "ДФ=dd.MM.yyyy") + " для БП Сделка РЕПО не найден партнер по коду брокера: " + СокрЛП(ТекСтрока.КодБрокера);
			ТекстОшибкиНеНайденКонтрагент = ?(ЗначениеЗаполнено(ТекстОшибкиНеНайденКонтрагент), ТекстОшибкиНеНайденКонтрагент + Символы.ПС + СтрокаОшибки, СтрокаОшибки);
		КонецЦикла;
	КонецЕсли;
	
	// Вся логика создания БП перенесена в процедуру СоздатьОбъектыПоДоговору модуля объекта
	// Старая логика удалена и заменена на параллельную обработку через ДлительныеОперации
	
	// Удаление успешно обработанных сделок из списка
	// ТаблицаУдаления уже заполнена успешно обработанными сделками при обработке результатов фоновых заданий
	// Сортируем по убыванию, чтобы удалять с конца и не сбивать индексы
	ТаблицаУдаления.Сортировать("ИндексСтроки Убыв");
	
	Для Каждого СтрокаУдаления Из ТаблицаУдаления Цикл
		ИндексСтроки = СтрокаУдаления.ИндексСтроки;
		// Проверка на корректность индекса (1-based index в данных -> 0-based в коллекции)
		Если ИндексСтроки >= 1 И ИндексСтроки <= СписокЗагрузки.Количество() Тогда
			СписокЗагрузки.Удалить(ИндексСтроки - 1);
		КонецЕсли;
	КонецЦикла;
	
	// Обработка валютных сделок (синхронно, как в оригинале)
	ВремяНачалаФормированияВалютныхСделок = ТекущаяУниверсальнаяДатаВМиллисекундах();

	МассивУдаленияВалютныеСделки = Новый Массив;
	ВсегоЗагружено = ВсегоСделокОбработано;
	
	// Вывод заголовка для валютных сделок
	ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицыВалютныеСделки");
	Лог.Вывести(ЗаголовокТаблицы);
	
	СтрокаДокументов = Макет.ПолучитьОбласть("СтрокаТаблицыВалютныеСделки");
	
	Для каждого ТекСтрока Из СписокЗагрузкиВалютныеСделки Цикл
		
		ОтказВалютнойСделки = Ложь;
		ТекстОшибкиВалютнойСделки = "";
		
		Если НЕ БУ и НЕ ВУ и НЕ УУ тогда
			ТекстОшибкиВалютнойСделки = "Отсутствуют области учета";
			ОтказВалютнойСделки = Истина;
			СтрокаДокументов.Параметры.Заполнить(ТекСтрока);
			СтрокаДокументов.Параметры.ОшибкаСделки = ТекстОшибкиВалютнойСделки;
			СтрокаДокументов.Параметры.ЕстьОшибки = "ДА";
			Лог.Вывести(СтрокаДокументов);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ВалютаБазовая) Тогда
			ТекстОшибкиВалютнойСделки = "Не определена базовая валюта";
			ОтказВалютнойСделки = Истина;
			СтрокаДокументов.Параметры.Заполнить(ТекСтрока);
			СтрокаДокументов.Параметры.ОшибкаСделки = ТекстОшибкиВалютнойСделки;
			СтрокаДокументов.Параметры.ЕстьОшибки = "ДА";
			Лог.Вывести(СтрокаДокументов);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ВалютаРасчетов) Тогда
			ТекстОшибкиВалютнойСделки = "Не определена валюта расчетов";
			ОтказВалютнойСделки = Истина;
			СтрокаДокументов.Параметры.Заполнить(ТекСтрока);
			СтрокаДокументов.Параметры.ОшибкаСделки = ТекстОшибкиВалютнойСделки;
			СтрокаДокументов.Параметры.ЕстьОшибки = "ДА";
			Лог.Вывести(СтрокаДокументов);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.РежимТоргов) Тогда
			ТекстОшибкиВалютнойСделки = "Не определен режим торгов";
			ОтказВалютнойСделки = Истина;
			СтрокаДокументов.Параметры.Заполнить(ТекСтрока);
			СтрокаДокументов.Параметры.ОшибкаСделки = ТекстОшибкиВалютнойСделки;
			СтрокаДокументов.Параметры.ЕстьОшибки = "ДА";
			Лог.Вывести(СтрокаДокументов);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ДоговорДУ) Тогда
			ТекстОшибкиВалютнойСделки = "Не определен ДоговорДУ";
			ОтказВалютнойСделки = Истина;
			СтрокаДокументов.Параметры.Заполнить(ТекСтрока);
			СтрокаДокументов.Параметры.ОшибкаСделки = ТекстОшибкиВалютнойСделки;
			СтрокаДокументов.Параметры.ЕстьОшибки = "ДА";
			Лог.Вывести(СтрокаДокументов);
			Продолжить;
		КонецЕсли;
		
		ТекСделка = Документы.СделкаНаВалютномРынке.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(ТекСделка, ТекСтрока);
		//IMAPPS-24569
		ТекСделка.ПодтвержденаОтчетомБрокера = Истина;
		ТекСделка.Дата = ТекСтрока.ДатаСделки;
		ТекСделка.ВидОперации = ?(ТекСтрока.Продажа, Перечисления.ВидыОперацийСделкаСВалютой.Продажа, Перечисления.ВидыОперацийСделкаСВалютой.Покупка);
		ТекСделка.АналитическийСчетВалютаБазовая = ТекСтрока.АналитическийСчетДСВалюта;
		ТекСделка.АналитическийСчетВалютаРасчетов = ТекСтрока.АналитическийСчетДС;
		ТекСделка.Контрагент = ТекСтрока.Брокер;
		ТекСделка.ДоговорКонтрагента = ТекСтрока.ДоговорБрокера;
		
		ТекСделка.ДатаОплатыИнойКомиссии = ТекСтрока.ДатаРасчетов;
		ТекСделка.ДатаОплатыКомиссииБиржи = ТекСтрока.ДатаРасчетов;
		ТекСделка.ДатаОплатыКомиссииБрокера = ТекСтрока.ДатаРасчетов;
		ТекСделка.ВалютаИнойКомиссии = ТекСтрока.ВалютаРасчетов;
		ТекСделка.ВалютаКомиссииБиржи = ТекСтрока.ВалютаРасчетов;
		ТекСделка.ВалютаКомиссииБрокера = ТекСтрока.ВалютаРасчетов;
		ТекСделка.ИнаяКомиссия = ТекСтрока.КомиссияТС;
		ТекСделка.КомиссияБиржи = ТекСтрока.КомиссияБиржи;
		ТекСделка.КомиссияБрокера = ТекСтрока.КомиссияБрокера;
		ТекСделка.ПлановаяДатаПлатежа = ТекСтрока.ДатаРасчетов;
		ТекСделка.ПлановаяДатаПоставки = ТекСтрока.ДатаРасчетов;
		ТекСделка.СуммаВВалютеРасчетов = ТекСтрока.Сумма;
		
		ТекСделка.БУ = БУ;
		ТекСделка.ВУ = ВУ;
		ТекСделка.УУ = УУ;
		
		ОтказВалютнойСделки = Ложь;
		Попытка 
			ТекСделка.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОтказВалютнойСделки = Истина;
			ТекстОшибкиВалютнойСделки = ПолучитьТекстОшибки("Ошибки проведения:");
		КонецПопытки;
		
		// Вывод информации о валютной сделке в Лог
		СтрокаДокументов.Параметры.Заполнить(ТекСтрока);
		СтрокаДокументов.Параметры.Сделка = ?(ОтказВалютнойСделки, "", ТекСделка.Ссылка);
		СтрокаДокументов.Параметры.ОшибкаСделки = ?(ОтказВалютнойСделки, ТекстОшибкиВалютнойСделки, "");
		СтрокаДокументов.Параметры.ЕстьОшибки = ?(ОтказВалютнойСделки, "ДА", "");
		
		Если ТекСтрока.ДоговорДУ.Пустая() Тогда
			СтрокаДокументов.Параметры.ДоговорДУ = "<???>";
		КонецЕсли;
		
		Лог.Вывести(СтрокаДокументов);
		
		Если Не ОтказВалютнойСделки тогда
			МассивУдаленияВалютныеСделки.Добавить(ТекСтрока);
			ВсегоЗагружено = ВсегоЗагружено +1;
		КонецЕсли;
		
	КонецЦикла;

	// Подсчет статистики валютных сделок
	ВсегоВалютныхСделокОбработано = СписокЗагрузкиВалютныеСделки.Количество();
	ВсегоОшибокВалютныхСделок = ВсегоВалютныхСделокОбработано - МассивУдаленияВалютныеСделки.Количество();

	ВремяОкончанияФормированияВалютныхСделок = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Для каждого ТекСтрока из МассивУдаленияВалютныеСделки Цикл
		СписокЗагрузкиВалютныеСделки.Удалить(ТекСтрока);
	Конеццикла;
	
	// Вычисление времени выполнения валютных сделок
	ПрошлоВремениВалютных = ВремяОкончанияФормированияВалютныхСделок - ВремяНачалаФормированияВалютныхСделок;
	ПрошлоВремениВалютныхСек = ПрошлоВремениВалютных / 1000;
	ЧасовВалютных = Цел(ПрошлоВремениВалютныхСек / 3600);
	МинутВалютных = Цел((ПрошлоВремениВалютныхСек - ЧасовВалютных * 3600) / 60);
	СекундВалютных = Цел(ПрошлоВремениВалютныхСек - ЧасовВалютных * 3600 - МинутВалютных * 60);

	// Форматирование времени с ведущими нулями для валютных сделок
	ВремяФормированияВалютных = Формат(ЧасовВалютных, "ЧЦ=2; ЧВН=; ЧН=00") + ":" +
	                           Формат(МинутВалютных, "ЧЦ=2; ЧВН=; ЧН=00") + ":" +
	                           Формат(СекундВалютных, "ЧЦ=2; ЧВН=; ЧН=00");

	// Вывод статистики обработки валютных сделок
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("===========================================================");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  ОБРАБОТКА ВАЛЮТНЫХ СДЕЛОК ЗАВЕРШЕНА");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("===========================================================");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  Обработано валютных сделок: " + Формат(ВсегоВалютныхСделокОбработано, "ЧГ=; ЧН="));
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  Ошибок: " + Формат(ВсегоОшибокВалютныхСделок, "ЧГ=; ЧН="));
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  Время выполнения: " + ВремяФормированияВалютных);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("");

	Если ВсегоОшибокВалютныхСделок > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  [ОШИБКА] Обнаружено ошибок валютных сделок: " + Формат(ВсегоОшибокВалютныхСделок, "ЧГ=; ЧН="));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("  [OK] Ошибок валютных сделок не обнаружено");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("===========================================================");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("");

	// Устанавливаем Отказ = Истина, если были ошибки при создании объектов
	// Это обеспечивает совместимость со старой версией, где Отказ устанавливался при ошибках
	// Учитываем ошибки как обычных, так и валютных сделок
	Если ВсегоОшибок > 0 Или ВсегоОшибокВалютныхСделок > 0 Тогда
		Отказ = Истина;
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "При создании объектов возникли ошибки. Всего ошибок: " + (ВсегоОшибок + ВсегоОшибокВалютныхСделок);
		КонецЕсли;
	КонецЕсли;
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераСозданияСделок > 0 Тогда
		ВесЗамераСозданияСделок = ?(ВсегоЗагружено > 0, ВсегоЗагружено, 1);
		КомментарийЗамераСозданияСделок = "КСозданию=" + ВсегоНовых + "; Создано=" + ВсегоЗагружено
			+ "; Ошибок=" + (ВсегоНовых - ВсегоЗагружено)
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераСозданияСделок, ВремяНачалаЗамераСозданияСделок);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияСозданиеСделок,
			ВремяНачалаЗамераСозданияСделок,
			ВесЗамераСозданияСделок,
			КомментарийЗамераСозданияСделок,
			Отказ
		);
	КонецЕсли;
	// IMDEV-8927 --
	
КонецПроцедуры

Функция ПолучитьТекстОшибки(ТекстОшибки)
	ТекстОшибки = ТекстОшибки + Символы.ПС;
	
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	Для каждого ТекСообщение из МассивСообщений Цикл
		ТекстОшибки = ТекстОшибки + ТекСообщение.Текст + Символы.ПС;
	Конеццикла;
	
	Возврат ТекстОшибки;
КонецФункции

Функция ТестовыйОтвет(Фабрика, Корень_ТИП)
	
	ФайлПример = ПолучитьИмяВременногоФайла("xml");
	
	Пример = ПолучитьМакет("ПримерОтвета");
	Пример.Записать(ФайлПример,КодировкаТекста.UTF8 );
	
	Чтение	= Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлПример);
	
	Корень_ТИП  = Фабрика.Тип(ОсновноеПространствоИмен, "Корень");
	Корень 		= Фабрика.ПрочитатьXML(Чтение, Корень_ТИП);
	
	Возврат Корень;
	
КонецФункции

Функция ОтветЧерезСервис(Определение, Корень)
	Прокси = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
	
	// IMAPPS-34861: Замер времени выполнения внешнего веб-сервиса
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Прокси.GetDeals(Корень);
	КонецЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ДлительностьСек = (КонецЗамера - НачалоЗамера) / 1000;
	Минуты = Цел(ДлительностьСек / 60);
	Секунды = ДлительностьСек - (Минуты * 60);
	Сообщить("GetDeals выполнен за " + Минуты + " мин " + Окр(Секунды, 2) + " с");
	
	Возврат Корень;
КонецФункции // ОтветЧерезСервис()

Функция ОтобратьСделкиПоНомеру(Знач ИсходныеСделки)
	Перем Запрос;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ИсходныеСделки", ИсходныеСделки);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсходныеСделки.НомерСделки КАК НомерСделки,
	|	ИсходныеСделки.ЭтоПродажа КАК ЭтоПродажа,
	|	ИсходныеСделки.ЭтоВалютнаяСделка КАК ЭтоВалютнаяСделка,
	|	ИсходныеСделки.ЭтоСделкаСрочногоРынка КАК ЭтоСделкаСрочногоРынка
	|ПОМЕСТИТЬ втИсходныеСделки
	|ИЗ
	|	&ИсходныеСделки КАК ИсходныеСделки
	|ГДЕ
	|	ИсходныеСделки.НомерСделки > """"
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерСделки,
	|	ЭтоПродажа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Отбор.НомерСделки КАК НомерСделки,
	|	Отбор.ЭтоПродажа КАК ЭтоПродажа,
	|	Отбор.ЭтоВалютнаяСделка КАК ЭтоВалютнаяСделка,
	|	ВЫБОР
	|		КОГДА Отбор.Сделка.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА Отбор.Сделка
	|		КОГДА Отбор.СделкаTn.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА Отбор.СделкаTn
	|		КОГДА Отбор.СделкаВнебиржевая.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА Отбор.СделкаВнебиржевая
	|		КОГДА Отбор.СделкаНаСрочном.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА Отбор.СделкаНаСрочном
	|		КОГДА Отбор.СделкаРЕПО.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА Отбор.СделкаРЕПО
	|		КОГДА Отбор.СделкаНаВалютном.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА Отбор.СделкаНаВалютном
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК Сделка,
	|	ВЫБОР
	|		КОГДА Отбор.Сделка.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА ИСТИНА
	|		КОГДА Отбор.СделкаTn.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА ИСТИНА
	|		КОГДА Отбор.СделкаВнебиржевая.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА ИСТИНА
	|		КОГДА Отбор.СделкаНаСрочном.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА ИСТИНА
	|		КОГДА Отбор.СделкаРЕПО.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА ИСТИНА
	|		КОГДА Отбор.СделкаНаВалютном.Ссылка ЕСТЬ НЕ NULL 
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьСделка
	|ИЗ
	|	(ВЫБРАТЬ
	|		Выборка.НомерСделки КАК НомерСделки,
	|		Выборка.ЭтоПродажа КАК ЭтоПродажа,
	|		Выборка.ЭтоВалютнаяСделка КАК ЭтоВалютнаяСделка,
	|		МАКСИМУМ(Выборка.Сделка) КАК Сделка,
	|		МАКСИМУМ(Выборка.СделкаTn) КАК СделкаTn,
	|		МАКСИМУМ(Выборка.СделкаВнебиржевая) КАК СделкаВнебиржевая,
	|		МАКСИМУМ(Выборка.СделкаНаСрочном) КАК СделкаНаСрочном,
	|		МАКСИМУМ(Выборка.СделкаРЕПО) КАК СделкаРЕПО,
	|		МАКСИМУМ(Выборка.СделкаНаВалютном) КАК СделкаНаВалютном
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ИсходныеСделки.НомерСделки КАК НомерСделки,
	|			ИсходныеСделки.ЭтоПродажа КАК ЭтоПродажа,
	|			ИсходныеСделки.ЭтоВалютнаяСделка КАК ЭтоВалютнаяСделка,
	|			ЕСТЬNULL(Сделки_BUY.Ссылка, ЕСТЬNULL(Сделки_SELL.Ссылка, ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка))) КАК Сделка,
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиTn.ПустаяСсылка) КАК СделкаTn,
	|			ЗНАЧЕНИЕ(БизнесПроцесс.ВнебиржеваяСделка.ПустаяСсылка) КАК СделкаВнебиржевая,
	|			ЗНАЧЕНИЕ(Документ.СделкаНаСрочномРынке.ПустаяСсылка) КАК СделкаНаСрочном,
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиРЕПО.ПустаяСсылка) КАК СделкаРЕПО,
	|			ЗНАЧЕНИЕ(Документ.СделкаНаВалютномРынке.ПустаяСсылка) КАК СделкаНаВалютном
	|		ИЗ
	|			втИсходныеСделки КАК ИсходныеСделки
	|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделки_BUY
	|				ПО (Сделки_BUY.НомерВходящегоДокумента = ИсходныеСделки.НомерСделки)
	|					И (Сделки_BUY.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление))
	|					И (НЕ Сделки_BUY.ПометкаУдаления)
	|					И (НЕ ИсходныеСделки.ЭтоПродажа)
	|					И (НЕ ИсходныеСделки.ЭтоВалютнаяСделка)
	|					И (НЕ ИсходныеСделки.ЭтоСделкаСрочногоРынка)
	|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделки_SELL
	|				ПО (Сделки_SELL.НомерВходящегоДокумента = ИсходныеСделки.НомерСделки)
	|					И (Сделки_SELL.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа))
	|					И (НЕ Сделки_SELL.ПометкаУдаления)
	|					И (ИсходныеСделки.ЭтоПродажа)
	|					И (НЕ ИсходныеСделки.ЭтоВалютнаяСделка)
	|					И (НЕ ИсходныеСделки.ЭтоСделкаСрочногоРынка)
	|		
	|		ОБЪЕДИНИТЬ
	|		
	|		ВЫБРАТЬ
	|			ИсходныеСделки.НомерСделки,
	|			ИсходныеСделки.ЭтоПродажа,
	|			ИсходныеСделки.ЭтоВалютнаяСделка,
	|			ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка),
	|			ЕСТЬNULL(Сделки_BUY.Ссылка, ЕСТЬNULL(Сделки_SELL.Ссылка, ЗНАЧЕНИЕ(БизнесПроцесс.СделкиTn.ПустаяСсылка))),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.ВнебиржеваяСделка.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(Документ.СделкаНаСрочномРынке.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиРЕПО.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(Документ.СделкаНаВалютномРынке.ПустаяСсылка)
	|		ИЗ
	|			втИсходныеСделки КАК ИсходныеСделки
	|				ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.СделкиTn КАК Сделки_BUY
	|				ПО (Сделки_BUY.НомерСделки = ИсходныеСделки.НомерСделки)
	|					И (Сделки_BUY.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление))
	|					И (НЕ Сделки_BUY.ПометкаУдаления)
	|					И (НЕ ИсходныеСделки.ЭтоПродажа)
	|					И (НЕ ИсходныеСделки.ЭтоВалютнаяСделка)
	|					И (НЕ ИсходныеСделки.ЭтоСделкаСрочногоРынка)
	|				ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.СделкиTn КАК Сделки_SELL
	|				ПО (Сделки_SELL.НомерСделки = ИсходныеСделки.НомерСделки)
	|					И (Сделки_SELL.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа))
	|					И (НЕ Сделки_SELL.ПометкаУдаления)
	|					И (ИсходныеСделки.ЭтоПродажа)
	|					И (НЕ ИсходныеСделки.ЭтоВалютнаяСделка)
	|					И (НЕ ИсходныеСделки.ЭтоСделкаСрочногоРынка)
	|		
	|		ОБЪЕДИНИТЬ
	|		
	|		ВЫБРАТЬ
	|			ИсходныеСделки.НомерСделки,
	|			ИсходныеСделки.ЭтоПродажа,
	|			ИсходныеСделки.ЭтоВалютнаяСделка,
	|			ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиTn.ПустаяСсылка),
	|			ЕСТЬNULL(Сделки_BUY.Ссылка, ЕСТЬNULL(Сделки_SELL.Ссылка, ЗНАЧЕНИЕ(БизнесПроцесс.ВнебиржеваяСделка.ПустаяСсылка))),
	|			ЗНАЧЕНИЕ(Документ.СделкаНаСрочномРынке.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиРЕПО.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(Документ.СделкаНаВалютномРынке.ПустаяСсылка)
	|		ИЗ
	|			втИсходныеСделки КАК ИсходныеСделки
	|				ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.ВнебиржеваяСделка КАК Сделки_BUY
	|				ПО (Сделки_BUY.НомерСделки = ИсходныеСделки.НомерСделки)
	|					И (Сделки_BUY.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидОперацииБПВнебиржеваяСделка.Покупка))
	|					И (НЕ Сделки_BUY.ПометкаУдаления)
	|					И (НЕ ИсходныеСделки.ЭтоПродажа)
	|					И (НЕ ИсходныеСделки.ЭтоВалютнаяСделка)
	|					И (НЕ ИсходныеСделки.ЭтоСделкаСрочногоРынка)
	|				ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.ВнебиржеваяСделка КАК Сделки_SELL
	|				ПО (Сделки_SELL.НомерСделки = ИсходныеСделки.НомерСделки)
	|					И (Сделки_SELL.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидОперацииБПВнебиржеваяСделка.Продажа))
	|					И (НЕ Сделки_SELL.ПометкаУдаления)
	|					И (ИсходныеСделки.ЭтоПродажа)
	|					И (НЕ ИсходныеСделки.ЭтоВалютнаяСделка)
	|					И (НЕ ИсходныеСделки.ЭтоСделкаСрочногоРынка)
	|		
	|		ОБЪЕДИНИТЬ
	|		
	|		ВЫБРАТЬ
	|			ИсходныеСделки.НомерСделки,
	|			ИсходныеСделки.ЭтоПродажа,
	|			ИсходныеСделки.ЭтоВалютнаяСделка,
	|			ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиTn.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.ВнебиржеваяСделка.ПустаяСсылка),
	|			ЕСТЬNULL(Сделки_BUY.Ссылка, ЕСТЬNULL(Сделки_SELL.Ссылка, ЗНАЧЕНИЕ(Документ.СделкаНаСрочномРынке.ПустаяСсылка))),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиРЕПО.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(Документ.СделкаНаВалютномРынке.ПустаяСсылка)
	|		ИЗ
	|			втИсходныеСделки КАК ИсходныеСделки
	|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаНаСрочномРынке КАК Сделки_BUY
	|				ПО (Сделки_BUY.НомерСделки = ИсходныеСделки.НомерСделки)
	|					И (Сделки_BUY.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаНаСрочномРынке.Покупка))
	|					И (НЕ Сделки_BUY.ПометкаУдаления)
	|					И (НЕ ИсходныеСделки.ЭтоПродажа)
	|					И (НЕ ИсходныеСделки.ЭтоВалютнаяСделка)
	|					И (ИсходныеСделки.ЭтоСделкаСрочногоРынка)
	|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаНаСрочномРынке КАК Сделки_SELL
	|				ПО (Сделки_SELL.НомерСделки = ИсходныеСделки.НомерСделки)
	|					И (Сделки_SELL.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаНаСрочномРынке.Продажа))
	|					И (НЕ Сделки_SELL.ПометкаУдаления)
	|					И (ИсходныеСделки.ЭтоПродажа)
	|					И (НЕ ИсходныеСделки.ЭтоВалютнаяСделка)
	|					И (ИсходныеСделки.ЭтоСделкаСрочногоРынка)
	|		
	|		ОБЪЕДИНИТЬ
	|		
	|		ВЫБРАТЬ
	|			ИсходныеСделки.НомерСделки,
	|			ИсходныеСделки.ЭтоПродажа,
	|			ИсходныеСделки.ЭтоВалютнаяСделка,
	|			ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиTn.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.ВнебиржеваяСделка.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(Документ.СделкаНаСрочномРынке.ПустаяСсылка),
	|			ЕСТЬNULL(СделкиРЕПО.Ссылка, ЗНАЧЕНИЕ(БизнесПроцесс.СделкиРЕПО.ПустаяСсылка)),
	|			ЗНАЧЕНИЕ(Документ.СделкаНаВалютномРынке.ПустаяСсылка)
	|		ИЗ
	|			втИсходныеСделки КАК ИсходныеСделки
	|				ЛЕВОЕ СОЕДИНЕНИЕ БизнесПроцесс.СделкиРЕПО КАК СделкиРЕПО
	|				ПО (СделкиРЕПО.НомерСделки = ИсходныеСделки.НомерСделки)
	|					И (НЕ СделкиРЕПО.ПометкаУдаления)
	|					И (НЕ ИсходныеСделки.ЭтоВалютнаяСделка)
	|		
	|		ОБЪЕДИНИТЬ
	|		
	|		ВЫБРАТЬ
	|			ИсходныеСделки.НомерСделки,
	|			ИсходныеСделки.ЭтоПродажа,
	|			ИсходныеСделки.ЭтоВалютнаяСделка,
	|			ЗНАЧЕНИЕ(Документ.Сделка.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиTn.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.ВнебиржеваяСделка.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(Документ.СделкаНаСрочномРынке.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(БизнесПроцесс.СделкиРЕПО.ПустаяСсылка),
	|			ЕСТЬNULL(Сделки_BUY.Ссылка, ЕСТЬNULL(Сделки_SELL.Ссылка, ЗНАЧЕНИЕ(Документ.СделкаНаВалютномРынке.ПустаяСсылка)))
	|		ИЗ
	|			втИсходныеСделки КАК ИсходныеСделки
	|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаНаВалютномРынке КАК Сделки_BUY
	|				ПО (Сделки_BUY.НомерСделки = ИсходныеСделки.НомерСделки)
	|					И (Сделки_BUY.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаСВалютой.Покупка))
	|					И (НЕ Сделки_BUY.ПометкаУдаления)
	|					И (НЕ ИсходныеСделки.ЭтоПродажа)
	|					И (ИсходныеСделки.ЭтоВалютнаяСделка)
	|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаНаВалютномРынке КАК Сделки_SELL
	|				ПО (Сделки_SELL.НомерСделки = ИсходныеСделки.НомерСделки)
	|					И (Сделки_SELL.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаСВалютой.Продажа))
	|					И (НЕ Сделки_SELL.ПометкаУдаления)
	|					И (ИсходныеСделки.ЭтоПродажа)
	|					И (ИсходныеСделки.ЭтоВалютнаяСделка)) КАК Выборка
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Выборка.НомерСделки,
	|		Выборка.ЭтоПродажа,
	|		Выборка.ЭтоВалютнаяСделка) КАК Отбор
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСделки,
	|	ЭтоПродажа,
	|	ЭтоВалютнаяСделка,
	|	Сделка";
	
	СделкиПоНомеру = Запрос.Выполнить().Выгрузить();
	СделкиПоНомеру.Индексы.Добавить("НомерСделки, ЭтоПродажа");
	
	Возврат СделкиПоНомеру;
КонецФункции // ОтобратьСделкиПоНомеру()

Функция УжеЕстьСделкаПоНомеру(Знач ТаблицаНайденныхСделок, Знач НомерСделки, Знач ЭтоПродажа, ЭтоВалютнаяСделка)
	Перем Строки;
	
	Строки = ТаблицаНайденныхСделок.НайтиСтроки(Новый Структура("НомерСделки, ЭтоВалютнаяСделка", НомерСделки, Истина));
	Если Строки.Количество() > 0 Тогда
		ЭтоВалютнаяСделка = Истина;
	КонецЕсли;
	
	Строки = ТаблицаНайденныхСделок.НайтиСтроки(Новый Структура("НомерСделки, ЭтоПродажа", НомерСделки, ЭтоПродажа));
	Если Строки.Количество() > 0 Тогда
		Возврат (Истина = Строки[0].ЕстьСделка);
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции // УжеЕстьСделкаПоНомеру()

Функция ЭтоСделкаСрочногоРынка(Актив, КодЦБнаММВБ = "", Биржа = "")

	// IMAPPS-34861: Добавлена проверка кэша перед запросом к БД
	Если КэшСрочногоРынка <> Неопределено Тогда
		АктивДляПоиска = Неопределено;
		
		Если ТипЗнч(Актив) = Тип("СправочникСсылка.Активы") Тогда
			АктивДляПоиска = Актив;
		Иначе
			КодПоиска = ?(ЗначениеЗаполнено(КодЦБнаММВБ), КодЦБнаММВБ, Актив.КодЦБнаММВБ);
			БиржаСсылка = ?(ТипЗнч(Биржа) = Тип("СправочникСсылка.Биржи"), Биржа, НайтиБиржуЧерезКэш(Биржа));
			Ключ = СокрЛП(КодПоиска) + "|" + ?(ЗначениеЗаполнено(БиржаСсылка), Строка(БиржаСсылка.УникальныйИдентификатор()), "");
			
			АктивДляПоиска = КэшАктивовПоКоду[Ключ];
		КонецЕсли;
		
		Если АктивДляПоиска <> Неопределено Тогда
			Рез = КэшСрочногоРынка[АктивДляПоиска];
			Если Рез <> Неопределено Тогда Возврат Рез; КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	СрочныйРынок = Ложь;
	
	Если ТипЗнч(Актив)<>Тип("СправочникСсылка.Активы") Тогда
		КодЦБнаММВБ = Актив.КодЦБнаММВБ;
		АктивСпр = АктивПоКоду(КодЦБнаММВБ, Биржа);
	Иначе
		АктивСпр = Актив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Активы.ВидАктива В ИЕРАРХИИ(&СрочныеКонтаркты) КАК СрочныйРынок
		|ИЗ
		|	Справочник.Активы КАК Активы
		|ГДЕ
		|	Активы.Ссылка = &АктивСпр";
	
	Запрос.УстановитьПараметр("АктивСпр", АктивСпр);
	Запрос.УстановитьПараметр("СрочныеКонтаркты", ПланыВидовХарактеристик.ВидыАктивов.СрочныеКонтракты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СрочныйРынок = ВыборкаДетальныеЗаписи.СрочныйРынок;
	КонецЕсли;
	
	Возврат СрочныйРынок;

КонецФункции // ЭтоСделкаСрочногоРынка(ТекСделка.РежимТоргов)()

Процедура ПрочитатьНаСервере(Сделки, Отказ = Ложь, РежимЗагрузки = Неопределено)
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.СписокЗагрузки.Очистить();
	ЭтотОбъект.СписокЗагрузкиВалютныеСделки.Очистить();
	
	ВсегоПрочтено	= 0;
	ВсегоНовых		= 0;
	
	// IMAPPS-31762 Нужно для определения комиссии биржи	
	СББрокер = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор("99904467-45e3-11e2-b4e9-005056b100ec"));
	
	// TM-3342 {
	ВалютаRUB 	= Справочники.Валюты.RUB;
	FOT 		= Перечисления.ПлатежныеУсловияСделки.ПоставкаСвободноОтПлатежа;
	DVP 		= Перечисления.ПлатежныеУсловияСделки.ПоставкаПротивПлатежа;
	СписокГруппВидовАктивовДляОпределенияInstrumentType = СписокГруппВидовАктивовДляОпределенияInstrumentType();
	СвойствоInstrumentType = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Instrument type", Истина);
	// ++ IMAPPS-24495 Чижов В.В. 30.01.2024
	БрокрескаяКомпанияПлатформа = БрокрескаяКомпанияПлатформа(); // Используется для определения валюты комиссии брокера		
	// -- IMAPPS-24495 Чижов В.В. 30.01.2024
	
	//vtb 11.04
	Если СвойствоInstrumentType = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка() Тогда
		СвойствоInstrumentType = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Тип инструмента", Истина);
	КонецЕсли; 
	
	СписокInstrumentType 	= СписокInstrumentType(СвойствоInstrumentType);
	// TM-3342 }
	
	// MPazhukov IMAPPS-12921
	
	ИсходныеСделки = Новый ТаблицаЗначений();
	ИсходныеСделки.Колонки.Добавить("НомерСделки", ОбщегоНазначения.ОписаниеТипаСтрока(30));
	ИсходныеСделки.Колонки.Добавить("ЭтоПродажа", Новый ОписаниеТипов("Булево"));
	ИсходныеСделки.Колонки.Добавить("ЭтоВалютнаяСделка", Новый ОписаниеТипов("Булево"));
	ИсходныеСделки.Колонки.Добавить("ЭтоСделкаСрочногоРынка", Новый ОписаниеТипов("Булево"));
	
	Для Каждого ТекСделка из Сделки Цикл
		НовСтрока = ИсходныеСделки.Добавить();
		НовСтрока.НомерСделки		 = ТекСделка.НомерСделки;
		НовСтрока.ЭтоПродажа		 = НРег(ТекСделка.ТипСделки) = "продажа";
		НовСтрока.ЭтоВалютнаяСделка	 = НРег(Прав(ТекСделка.Актив.КодЦБнаММВБ, 3)) = "tom" 
			Или НРег(Прав(ТекСделка.Актив.КодЦБнаММВБ, 3)) = "tod"
			// IMAPPS-26362 ++
			// Или НРег(Прав(ТекСделка.Актив.КодЦБнаММВБ, 3)) = "spt";
			Или НРег(Прав(ТекСделка.Актив.КодЦБнаММВБ, 3)) = "spt"
			Или ТекСделка.Актив.КодЦБнаММВБ = "CNYRUB_TMS";
			// IMAPPS-26362 --
		
		НаименованиеБиржи = ТекСделка.Биржа.Наименование;
		// IMAPPS-34861: Заменен прямой вызов Справочники.Биржи.НайтиПоНаименованию на НайтиБиржуЧерезКэш
		Биржа = НайтиБиржуЧерезКэш(НаименованиеБиржи);
		
		НовСтрока.ЭтоСделкаСрочногоРынка = ЭтоСделкаСрочногоРынка(ТекСделка.Актив,, Биржа);
		
		Если ЗначениеЗаполнено(DV_НеГрузитьВнебиржу) И ТекСделка.РежимТоргов = "OTC" Тогда
			Продолжить;
		КонецЕсли;
		
		// IMAPPS-34861: Заменен прямой вызов Справочники.Валюты.НайтиПоНаименованию на НайтиВалютуЧерезКэш
		Валюта = НайтиВалютуЧерезКэш(ТекСделка.ВалютаСделки);
		Если Валюта.Пустая() Тогда
			Валюта = ВалютаRUB;
		КонецЕсли;		
		
		Если ОтборПоПулу = 1 Тогда
			Комментарий = СокрЛП(ТекСделка.Комментарий);
			КодКлиента = Лев(Комментарий, СтрДлина(Комментарий) - 1);
		Иначе
			КодКлиента = ТекСделка.КодКлиента;
		КонецЕсли;
		
		ТорговыйКод = ТорговыйКодПоКоду(КодКлиента, ТекСделка.КодБрокера, ТекСделка.РежимТоргов, Валюта);
		Если ТорговыйКод <> Неопределено Тогда
			
			ТекДоговорДУ = ТорговыйКод.ДоговорДУ;
			Если Найти(ТекСделка.РежимТоргов, "EQRD") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQRP") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQRE") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQWP") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQWD") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQWE") > 0
				ИЛИ ЭтоРЕПО_КСУ(ТекСделка.РежимТоргов) Тогда  // IMAPPS-15992
				
				Если ОборотыПоРЕПО.Получить(ТекСделка.КодКлиента) = Неопределено Тогда
					// +Artur Mingalev 27.07.2021 IMAPPS-14187 было ТекДоговорДУ вместо ТекСделка.КодКлиента
					ОборотыПоРЕПО.Вставить(ТекСделка.КодКлиента, ТекСделка.Сумма);
				Иначе
					ТекЗначение = ОборотыПоРЕПО.Получить(ТекСделка.КодКлиента); 
					ОборотыПоРЕПО.Вставить(ТекСделка.КодКлиента, ТекЗначение + ТекСделка.Сумма);
					// -Artur Mingalev 27.07.2021 IMAPPS-14187
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// IMAPPS-12921
	
	СделкиПоНомеру = ОтобратьСделкиПоНомеру(ИсходныеСделки);
	
	НенайденныеАктивы = Новый ТаблицаЗначений;
	НенайденныеАктивы.Колонки.Добавить("КодЦБнаММВБ", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	НенайденныеАктивы.Колонки.Добавить("Биржа", Новый ОписаниеТипов("СправочникСсылка.Биржи"));
	
	НенайденныеВалюты = Новый ТаблицаЗначений;
	НенайденныеВалюты.Колонки.Добавить("Валюта", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(3)));
	
	Для Каждого ТекСделка из Сделки Цикл
		ВсегоПрочтено = ВсегоПрочтено + 1;
		
		// IMAPPS-PARAM: REPO - фильтр по РЕПО режимам торгов
		Если РежимЗагрузки = "РЕПО" Тогда
			ЭтоРЕПОСделка = (Найти(ТекСделка.РежимТоргов, "EQRD") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQRP") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQRE") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQWP") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQWD") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQWE") > 0
				ИЛИ ЭтоРЕПО_КСУ(ТекСделка.РежимТоргов) И ЗначениеЗаполнено(ТекСделка.КодБрокера));
			
			Если НЕ ЭтоРЕПОСделка Тогда
				Продолжить; // Пропускаем не-РЕПО сделки
			КонецЕсли;
		КонецЕсли;
		// IMAPPS-PARAM: REPO
		
		ЭтоПродажа = (НРег(ТекСделка.ТипСделки) = "продажа");
		ЭтоВалютнаяСделка = Ложь;
		
		// IMAPPS-PARAM: REPO - инверсия логики проверки существующих сделок
		Если РежимЗагрузки = "РЕПО" Тогда
			// В режиме РЕПО обрабатываем только СУЩЕСТВУЮЩИЕ сделки (для обновления)
			Если НЕ УжеЕстьСделкаПоНомеру(СделкиПоНомеру, ТекСделка.НомерСделки, ЭтоПродажа, ЭтоВалютнаяСделка) Тогда
				Продолжить; // Пропускаем сделки, которых НЕТ в базе
			КонецЕсли;
		Иначе
			// В обычном режиме обрабатываем только НОВЫЕ сделки (для создания)
			Если УжеЕстьСделкаПоНомеру(СделкиПоНомеру, ТекСделка.НомерСделки, ЭтоПродажа, ЭтоВалютнаяСделка) Тогда
				Продолжить; // Пропускаем сделки, которые УЖЕ ЕСТЬ в базе
			КонецЕсли;
		КонецЕсли;
		// IMAPPS-PARAM: REPO
		
		//Сделка = СделкаПоНомеру(ТекСделка.НомерСделки, ЭтоПродажа);
		//Если Сделка <> Неопределено Тогда
		//	Продолжить;
		//КонецЕсли;
		
		// IMAPPS-559
		Если ЗначениеЗаполнено(DV_НеГрузитьВнебиржу) И ТекСделка.РежимТоргов = "OTC" Тогда
			Продолжить;
		КонецЕсли;
		
		ВсегоНовых = ВсегоНовых + 1;
		
		Если ЭтоВалютнаяСделка Тогда
			НоваяСделка = ЭтотОбъект.СписокЗагрузкиВалютныеСделки.Добавить();
		Иначе
			НоваяСделка = ЭтотОбъект.СписокЗагрузки.Добавить();
			
			Если СтрНайти(ТекСделка.Комментарий,"HTM") > 0 Или (ТекСделка.Свойства().Получить("ОтметкаHTM") <> Неопределено И ТекСделка.ОтметкаHTM = "HTM") Тогда
				НоваяСделка.HTM = истина
			Конецесли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСделка, ТекСделка);
		
		Если Лев(ТекСделка.РежимТоргов,2) = "TQ" или НачалоДня(ТекСделка.ДатаСделки) <> НачалоДня(ТекСделка.ДатаРасчетов)  Тогда
			НоваяСделка.ДатаРасчетов = ТекСделка.ДатаРасчетов;
		КонецЕсли;
		
		НоваяСделка.Продажа = ЭтоПродажа;
		
		ТекВремя 	= ТекСделка.ВремяСделки;
		ТекДата 	= ТекСделка.ДатаСделки;
		НоваяСделка.ДатаСделки = Дата(Год(ТекДата), Месяц(ТекДата), День(ТекДата), Час(ТекВремя), Минута(ТекВремя), Секунда(ТекВремя));
		
		НаименованиеБиржи = ТекСделка.Биржа.Наименование;
		// IMAPPS-34861: Заменен прямой вызов Справочники.Биржи.НайтиПоНаименованию на НайтиБиржуЧерезКэш
		Биржа = НайтиБиржуЧерезКэш(НаименованиеБиржи);
		
		НоваяСделка.Биржа = Биржа;
		// MPazhukov IMAPPS-11989
		Если Найти(ТекСделка.РежимТоргов,"SPB" ) > 0 И Не ТекСделка.РежимТоргов="SPBFUT" Тогда
			НоваяСделка.Биржа = Справочники.Биржи.НайтиПоКоду("СПБФБ");
		КонецЕсли;	
		// MPazhukov IMAPPS-11989
		
		Если ЭтоВалютнаяСделка Тогда
			КодЦБнаММВБ = ТекСделка.Актив.КодЦБнаММВБ;
			ВалютаБазовая = Лев(КодЦБнаММВБ, 3);
			ВалютаРасчетов = Сред(КодЦБнаММВБ, 4, 3);
			РежимТоргов = Прав(КодЦБнаММВБ, 3);
			
			Если ВалютаРасчетов = "000" И ТекСделка.ВалютаСделки = "RUB" Тогда
				ВалютаРасчетов = ТекСделка.ВалютаСделки;
			КонецЕсли;
			
			СтатусПоискаВалютыБазовой = "Валюта не найдена";
			
			Если НенайденныеВалюты.НайтиСтроки(Новый Структура("Валюта", ВалютаБазовая)).Количество() = 0 Тогда
				ВалютаБазовая = ВалютаПоКоду(ВалютаБазовая, СтатусПоискаВалютыБазовой);
			Иначе
				ВалютаБазовая = Неопределено;
			КонецЕсли;
			
			Если ВалютаБазовая = Неопределено Тогда
				НоваяСтрока = НенайденныеВалюты.Добавить();
				НоваяСтрока.Валюта = ВалютаБазовая;
			Иначе
				НоваяСделка.ВалютаБазовая = ВалютаБазовая;
			КонецЕсли;
			
			СтатусПоискаВалютыРасчетов = "Валюта не найдена";
			
			Если НенайденныеВалюты.НайтиСтроки(Новый Структура("Валюта", ВалютаРасчетов)).Количество() = 0 Тогда
				ВалютаРасчетов = ВалютаПоКоду(ВалютаРасчетов, СтатусПоискаВалютыРасчетов);
			Иначе
				ВалютаРасчетов = Неопределено;
			КонецЕсли;
			
			Если ВалютаРасчетов = Неопределено Тогда
				НоваяСтрока = НенайденныеВалюты.Добавить();
				НоваяСтрока.Валюта = ВалютаРасчетов;
			Иначе
				НоваяСделка.ВалютаРасчетов = ВалютаРасчетов;
			КонецЕсли;
			
			НоваяСделка.ВалютаСделки = ВалютаРасчетов;
			
			// IMAPPS-26362 ++
			// НоваяСделка.СуммаВБазовойВалюте = ТекСделка.Количество * 1000;
			Если ТекСделка.РежимТоргов = "CETS_SU" Тогда
				НоваяСделка.СуммаВБазовойВалюте = ТекСделка.Количество;
			Иначе
				НоваяСделка.СуммаВБазовойВалюте = ТекСделка.Количество * 1000;
			КонецЕсли;
			// IMAPPS-26362 --
			
			НоваяСделка.Сумма = ТекСделка.Сумма;
			Если ВРег(РежимТоргов) = "TOD" Тогда
				НоваяСделка.РежимТоргов = Перечисления.РежимТорговСделкаСВалютой.TOD;
			ИначеЕсли ВРег(РежимТоргов) = "TOM" Тогда
				НоваяСделка.РежимТоргов = Перечисления.РежимТорговСделкаСВалютой.TOM;
			// IMAPPS-29198++
			ИначеЕсли ВРег(РежимТоргов) = "TMS" Тогда
				НоваяСделка.РежимТоргов = Перечисления.РежимТорговСделкаСВалютой.TMS;
			// IMAPPS-29198--
			ИначеЕсли ВРег(РежимТоргов) = "SPT" Тогда
				НоваяСделка.РежимТоргов = Перечисления.РежимТорговСделкаСВалютой.SPT;
			КонецЕсли;
			
			НоваяСделка.СтатусПоискаВалютыБазовой = СтатусПоискаВалютыБазовой;
			НоваяСделка.СтатусПоискаВалютыРасчетов = СтатусПоискаВалютыРасчетов;
			
			НоваяСделка.КодБиржи 	 = ТекСделка.Биржа.Наименование;
			НоваяСделка.КодЦБнаММВБ = ТекСделка.Актив.КодЦБнаММВБ;
			
			Если ОтборПоПулу = 1 Тогда
				Комментарий = СокрЛП(ТекСделка.Комментарий);
				КодКлиента = Лев(Комментарий, СтрДлина(Комментарий) - 1);
			Иначе
				КодКлиента = ТекСделка.КодКлиента;
			КонецЕсли;
			
			ТорговыйКод = ТорговыйКодПоКоду(КодКлиента, ТекСделка.КодБрокера, ТекСделка.РежимТоргов, ВалютаРасчетов);
			Если ТорговыйКод <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСделка, ТорговыйКод);
			КонецЕсли;
			
			ТорговыйКод = ТорговыйКодПоКоду(КодКлиента, ТекСделка.КодБрокера, ТекСделка.РежимТоргов, ВалютаБазовая);
			Если ТорговыйКод <> Неопределено Тогда
				НоваяСделка.АналитическийСчетДСВалюта = ТорговыйКод.АналитическийСчетДС;
			КонецЕсли;
			
			//IMAVIN-97 Брокера определяем по коду
			Если НЕ ЗначениеЗаполнено(НоваяСделка.Брокер) ИЛИ ТекСделка.РежимТоргов = "OTC" Тогда
				НоваяСделка.Брокер = ПолучитьБрокераПоКоду(ТекСделка.КодБрокера);
			КонецЕсли;
			НоваяСделка.КомиссияБрокера = ТекСделка.CmsBroker;
			
			РассчитатьКомиссиюБрокераВалютныеСделки(НоваяСделка, НоваяСделка.СтатусКомиссии);
			
		Иначе
			ОбъектАктива = Неопределено; // TM-3342  
			
			СтатусПоискаАктива = "Актив не найден";
			КодЦБнаММВБ = ТекСделка.Актив.КодЦБнаММВБ;
			Если НенайденныеАктивы.НайтиСтроки(Новый Структура("КодЦБнаММВБ, Биржа", КодЦБнаММВБ, Биржа)).Количество() = 0 Тогда
				Актив = АктивПоКоду(КодЦБнаММВБ, Биржа, Истина, СтатусПоискаАктива, 0);
			Иначе
				Актив = Неопределено;
			КонецЕсли;
			
			НоваяСделка.РежимТоргов = РежимТорговПоID(ТекСделка.РежимТоргов);
			
			Если Актив = Неопределено Тогда
				НоваяСтрока = НенайденныеАктивы.Добавить();
				НоваяСтрока.КодЦБнаММВБ = КодЦБнаММВБ;
				НоваяСтрока.Биржа = Биржа;
				НоваяСделка.ЭтоСделкаСрочногоРынка = Ложь;
			Иначе
				НоваяСделка.ЭтоСделкаСрочногоРынка = ЭтоСделкаСрочногоРынка(Актив);
				Если СтрНайти(ТекСделка.Комментарий,"HTM") > 0 Тогда
					НоваяСделка.HTM = истина
				Конецесли;
				НоваяСделка.Актив = Актив;
				
				Если НоваяСделка.ЭтоСделкаСрочногоРынка Тогда
					//НоваяСделка.Количество = НоваяСделка.Количество * Актив.Объект.Лот;
					НоваяСделка.Цена = НоваяСделка.Цена * Актив.Объект.Лот; 
					НоваяСделка.КомиссияБиржи = ТекСделка.komissija_birga;
					НоваяСделка.Биржа = Актив.Объект.БиржаЛистинга;
				КонецЕсли;
				
				ВидАктива = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Актив, "ВидАктива");
				ОбъектАктива = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Актив, "Объект"); 
				
				// VTB-Borisov  - 17.07.2019 {
				Если НЕ ЗначениеЗаполнено(ВидАктива) Тогда
					//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Актив <" + Актив + "> - не указан ВидАктива! Сделка не будет обработана");
					СтатусПоискаАктива = "Актив <" + Актив + "> - не указан ВидАктива.";
					//	Продолжить;
					
				Иначе
					// VTB-Borisov  - 17.07.2019 }
					
					ЭтоСрочныйКонтракт = ВидАктива.ПринадлежитЭлементу(ПланыВидовХарактеристик.ВидыАктивов.СрочныеКонтракты);
					
					Если ЭтоСрочныйКонтракт Тогда
						КотировкаАктива = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ОбъектАктива, "Котировка"); 
						ТекСделка.ВалютаСделки = Строка(КотировкаАктива);
					Иначе	 
						ВалютаНоминальнойСтоимости = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ОбъектАктива, "ВалютаНоминальнойСтоимости"); 
						// ТекСделка.ВалютаСделки = Строка(ВалютаНоминальнойСтоимости);
					КонецЕсли;
				КонецЕсли;
				// TM-3342 } 
			КонецЕсли;
			НоваяСделка.СтатусПоискаАктива = СтатусПоискаАктива;
			НоваяСделка.КодБиржи 	 = ТекСделка.Биржа.Наименование;
			НоваяСделка.КодЦБнаММВБ = ТекСделка.Актив.КодЦБнаММВБ;
			// IMAPPS-34861: Заменен прямой вызов Справочники.Валюты.НайтиПоНаименованию на НайтиВалютуЧерезКэш
			Валюта = НайтиВалютуЧерезКэш(ТекСделка.ВалютаСделки);
			Если Валюта.Пустая() Тогда
				Валюта = ВалютаRUB;
			КонецЕсли;
			КурсКратность = МодульВалютногоУчета.ПолучитьКурсВалюты(ВалютаRUB, Валюта, ТекДата); // TM-3342 
			НоваяСделка.КурсВалютыСделки 	   = КурсКратность.Курс;
			НоваяСделка.КратностьВалютыСделки = КурсКратность.Кратность;
			НоваяСделка.ВалютаСделки 		   = Валюта;
			
			Если ОтборПоПулу = 1 Тогда
				Комментарий = СокрЛП(ТекСделка.Комментарий);
				КодКлиента = Лев(Комментарий, СтрДлина(Комментарий) - 1);
			Иначе
				КодКлиента = ТекСделка.КодКлиента;
			КонецЕсли;
		
			ТорговыйКод = ТорговыйКодПоКоду(КодКлиента, ТекСделка.КодБрокера, ТекСделка.РежимТоргов, Валюта);
			Если ТорговыйКод <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НоваяСделка, ТорговыйКод);
			КонецЕсли;
			
			//IMAVIN-97 Брокера определяем по коду
			Если НЕ ЗначениеЗаполнено(НоваяСделка.Брокер) ИЛИ ТекСделка.РежимТоргов = "OTC" Тогда
				НоваяСделка.Брокер = ПолучитьБрокераПоКоду(ТекСделка.КодБрокера);
			КонецЕсли; 
			НоваяСделка.КомиссияБрокера = ТекСделка.CmsBroker;
			// ++ IMAPPS-24495 Чижов В.В. 30.01.2024
			Если НоваяСделка.Брокер = БрокрескаяКомпанияПлатформа Тогда
				НоваяСделка.ВалютаКомисcииБрокера = ВалютаRUB;
			// ++ IMAPPS-24575 Чижов В.В. 02.02.2024
			ИначеЕсли НоваяСделка.Брокер = БанкВТБ Тогда
				НоваяСделка.ВалютаКомисcииБрокера = НоваяСделка.ВалютаСделки;
				НоваяСделка.ВалютаКомисcииБиржи = НоваяСделка.ВалютаСделки;
				НоваяСделка.КомиссияБиржи = НоваяСделка.КомиссияБиржи / НоваяСделка.КурсВалютыСделки * НоваяСделка.КратностьВалютыСделки; 

				// IMAPPS-24661++
				// Для БанкВТБ КомиссияБиржи состоит из двух комиссий полей komissija_birga + komissija_kliring
				// и брокер на своей стороне комиссию пересчитывает в RUB отдельно по каждой комиссии,а потому результаты суммирует
				// у нас было, что общую сумму в валюте пересчитываем, а в итоге имеем расхождение с данными брокера в копейки 
				Если не ВалютаRUB = Валюта Тогда 
					// IMAPPS-27942 ++
					КомиссияФондовойБиржи = Окр(ТекСделка.komissija_birga / НоваяСделка.КурсВалютыСделки * НоваяСделка.КратностьВалютыСделки, 2);
					КомиссияКлиринга = Окр(ТекСделка.komissija_kliring / НоваяСделка.КурсВалютыСделки * НоваяСделка.КратностьВалютыСделки, 2); 
					// IMAPPS-35297 ++
					Если Найти(ТекСделка.РежимТоргов, "GYRP") > 0 Тогда
						НоваяСделка.КомиссияБиржи = ?(КомиссияФондовойБиржи + КомиссияКлиринга > 0.01, КомиссияФондовойБиржи + КомиссияКлиринга, 0.01);	
					// IMAPPS-35297 --
					Иначе
						НоваяСделка.КомиссияБиржи = 
								?(КомиссияФондовойБиржи > 0.01,КомиссияФондовойБиржи, 0.01) +
								?(КомиссияКлиринга > 0.01,КомиссияКлиринга, 0.01);
					КонецЕсли;
					// IMAPPS-27942 --
				КонецЕсли;
				// IMAPPS-24661--
				
			// -- IMAPPS-24575 Чижов В.В. 02.02.2024
			КонецЕсли;
			// -- IMAPPS-24495 Чижов В.В. 30.01.2024
			
			// TM-3342 {
			Если Не НоваяСделка.Актив.Пустая() И Не НоваяСделка.Брокер.Пустая() И Не ПустаяСтрока(НоваяСделка.ПлатежныеУсловия) Тогда
				ПлатежныеУсловия = Неопределено;
				Если НоваяСделка.ПлатежныеУсловия = "FOP" or НоваяСделка.ПлатежныеУсловия = "PREPAYMENT" or НоваяСделка.ПлатежныеУсловия = "POSTPAY" Тогда
					ПлатежныеУсловия = FOT;
				ИначеЕсли НоваяСделка.ПлатежныеУсловия = "DVP" Тогда
					ПлатежныеУсловия = DVP;
				КонецЕсли;
				
				InstrumentType = InstrumentType(НоваяСделка.Актив, ОбъектАктива, СписокГруппВидовАктивовДляОпределенияInstrumentType, СписокInstrumentType);
				
				Если ПлатежныеУсловия <> Неопределено И InstrumentType <> Неопределено Тогда 
					// MPazhukov IMAPPS-8887 23.08.2019
					//НоваяСделка.РеквизитыДляРасчетовПоЦБ = ДепозитарнаяИнструкцияСсылка(InstrumentType, НоваяСделка.Брокер, ПлатежныеУсловия, СвойствоInstrumentType,НоваяСделка.ДатаСделки);
					Если СтрНайти(ТекСделка.КодКлиента, "_NSD_") Тогда
						НоваяСделка.РеквизитыДляРасчетовПоЦБ = ДепозитарнаяИнструкцияСсылка(InstrumentType, НоваяСделка.Брокер, ПлатежныеУсловия, СвойствоInstrumentType,НоваяСделка.ДатаСделки, ПолучитьНРД());	
					Иначе	
						НоваяСделка.РеквизитыДляРасчетовПоЦБ = ДепозитарнаяИнструкцияСсылка(InstrumentType, НоваяСделка.Брокер, ПлатежныеУсловия, СвойствоInstrumentType,НоваяСделка.ДатаСделки);
					КонецЕсли;
					// MPazhukov IMAPPS-8887 23.08.2019
				КонецЕсли;
			КонецЕсли;
			
			Если Не НоваяСделка.Брокер.Пустая() и НЕ НоваяСделка.Продажа И ТекСделка.РежимТоргов = "OTC" и ПлатежныеУсловия <> DVP Тогда
				НоваяСделка.СчетПолучателя = ПолучитьСчетПолучателя(НоваяСделка.Брокер,НоваяСделка.ВалютаСделки)
			КонецЕсли;
			// MPazhukov IMAPPS-12921
			Если (
				Найти(ТекСделка.РежимТоргов, "EQRD") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQRP") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQRE") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQWP") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQWD") > 0
				ИЛИ Найти(ТекСделка.РежимТоргов, "EQWE") > 0
				ИЛИ ЭтоРЕПО_КСУ(ТекСделка.РежимТоргов)  // IMAPPS-15992
				) Тогда
				// +Artur Mingalev 27.07.2021 IMAPPS-14187 Обороты по коду клиента ТекДоговорДУ вместо ТекСделка.КодКлиента 
				НоваяСделка.ОборотПоРЕПО = ОборотыПоРЕПО.Получить(ТекСделка.КодКлиента);
				// -Artur Mingalev 27.07.2021 IMAPPS-14187
			КонецЕсли;	
			// MPazhukov IMAPPS-12921
			СтруктураДопСведенияАктивов = ПолучитьИзКэшаДопСведенияАктива(ОбъектАктива);
			СтруктураДопСведенияБрокер = ПолучитьИзКэшаДопСведенияБрокера(НоваяСделка.Брокер);
			Если СтруктураДопСведенияАктивов.НеСчитатьКомиссиюБиржиПоСделкам
				И СтруктураДопСведенияБрокер.НеСчитатьКомиссиюБиржиПоСделкам Тогда
				НоваяСделка.КомиссияБиржи = 0;
			КонецЕсли;
			Если СтруктураДопСведенияАктивов.НеСчитатьКомиссиюБрокераПоСделкам
				И СтруктураДопСведенияБрокер.НеСчитатьКомиссиюБрокераПоСделкам Тогда
				НоваяСделка.КомиссияБрокера = 0;
			Иначе        
				// ++ IMAPPS-24575 Чижов В.В. 06.02.2024
				КурсВалютыСделки = НоваяСделка.КурсВалютыСделки;
				Если НоваяСделка.ВалютаСделки = НоваяСделка.ВалютаКомисcииБрокера Тогда
					НоваяСделка.КурсВалютыСделки = 1;
				КонецЕсли;
				// -- IMAPPS-24575 Чижов В.В. 06.02.2024
				РассчитатьКомиссиюБрокера(НоваяСделка, НоваяСделка.СтатусКомиссии); 
				// ++ IMAPPS-24575 Чижов В.В. 06.02.2024
				НоваяСделка.КурсВалютыСделки = КурсВалютыСделки;
				// -- IMAPPS-24575 Чижов В.В. 06.02.2024
			КонецЕсли;
			
			// IMAPPS-31762 ++ 
			Если ДУСКомиссиейБиржи.НайтиПоЗначению(НоваяСделка.ДоговорДУ) <> Неопределено И СББрокер = НоваяСделка.Брокер Тогда
				НоваяСделка.КомиссияБиржи = ТекСделка.TSCommission;
			КонецЕсли;
			// IMAPPS-31762 --
			
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры // ПрочитатьНаСервере()

Процедура РассчитатьКомиссиюБрокера(НоваяСделка, ТекстОшибки = "")
	Если НоваяСделка.РежимТоргов.Наименование = "OTC" Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСделка.КомиссияБрокера = 0;
	
	Если НоваяСделка.ДоговорБрокера.Пустая() Тогда
		ТекстОшибки = "Определить комиссию невозможно";
		Возврат;
	Иначе
		Результат = Справочники.ДоговорыКонтрагентов.РезультатАлгоритма(НоваяСделка.ДоговорБрокера, НоваяСделка, ТекстОшибки);
		
		Если Результат <> Неопределено Тогда
			НоваяСделка.КомиссияБрокера = Результат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура РассчитатьКомиссиюБрокераВалютныеСделки(НоваяСделка, ТекстОшибки = "")
	
	НоваяСделка.КомиссияБрокера = 0;
	
	Если НоваяСделка.ДоговорБрокера.Пустая() Тогда
		ТекстОшибки = "Определить комиссию невозможно";
		Возврат;
	Иначе
		Результат = Справочники.ДоговорыКонтрагентов.РезультатАлгоритма(НоваяСделка.ДоговорБрокера, НоваяСделка, ТекстОшибки);
		
		Если Результат <> Неопределено Тогда
			НоваяСделка.КомиссияБрокера = Результат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// MPazhukov IMAPPS-8887 23.08.2019
Функция ПолучитьНРД()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Контрагенты.Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	Контрагенты.Депозитарий
	               |	И Контрагенты.ИНН = &ИНН";
	Запрос.УстановитьПараметр("ИНН", "7702165310");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции
