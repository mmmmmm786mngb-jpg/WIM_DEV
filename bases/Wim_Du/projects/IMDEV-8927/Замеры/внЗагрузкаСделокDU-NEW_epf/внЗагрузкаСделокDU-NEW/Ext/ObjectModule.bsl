							// vns 22.09.2014 поменял способ расчета цены для облигаций
							// IMAPPS-14673
							НоминальнаяСтоимость = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(ТекСтрока.Актив.Объект, ТекСтрока.ДатаРасчетов);

							ТекСделка.Цена = ?(НоминальнаяСтоимость=0,ТекСделка.КотировкаОблигации,НоминальнаяСтоимость*ТекСделка.КотировкаОблигации/100);
						КонецЕсли;
					КонецЕсли;
					
					ТекСделка.ВидОперации = ?(ТекСтрока.Продажа, Перечисления.ВидыОперацийСделка.Продажа, Перечисления.ВидыОперацийСделка.Поступление);
					
					// vns 23.09.2014
					Если (Лев(ТекСтрока.РежимТоргов,2) <> "TQ" И РежимТорговНаименование <> "OCBR" И РежимТорговНаименование <> "OCBY") И НачалоДняСделки = НачалоДняРасчетов Тогда
						ТекСделка.ВнебиржеваяСделка = Ложь;
					КонецЕсли;
					
					ТекСделка.ДоговорКонтрагента 	= ТекСтрока.ДоговорБрокера;
					ТекСделка.Контрагент			= ТекСтрока.Брокер;
					
					ТекСделка.КратностьВзаиморасчетов	= ТекСтрока.КратностьВалютыСделки;
					ТекСделка.КурсВзаиморасчетов		= ТекСтрока.КурсВалютыСделки;
					ТекСделка.БУ = БУ;
					ТекСделка.ВУ = ВУ;
					ТекСделка.УУ = УУ;
					
					
					Если Не ТекСделка.ВалютаЦБ.Пустая() тогда 
						Курсы = МодульВалютногоУчета.ПолучитьКурсВалюты(ВалютаRUB, ТекСделка.ВалютаЦБ, ТекСделка.Дата);
						
						ТекСделка.КурсЦБ = Курсы.Курс;
						ТекСделка.КратностьЦБ = Курсы.Кратность;
						
						Если (Лев(ТекСтрока.РежимТоргов,2) <> "TQ" И РежимТорговНаименование <> "OCBR") И НачалоДняСделки = НачалоДняРасчетов Тогда
							ТекСделка.СуммаВВалютеНоминальнойСтоимости 		= МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(ТекСделка.Сумма, ТекСделка.ВалютаДокумента, ТекСделка.ВалютаЦБ, ТекСделка.КурсВзаиморасчетов, ТекСделка.КурсЦБ,ТекСделка.КратностьВзаиморасчетов, ТекСделка.КратностьЦБ);
						КонецЕсли;
						
						ТекСделка.СуммаНКДВВалютеНоминальнойСтоимости 	= МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(ТекСделка.НКД, ТекСделка.ВалютаДокумента, ТекСделка.ВалютаЦБ, ТекСделка.КурсВзаиморасчетов, ТекСделка.КурсЦБ,ТекСделка.КратностьВзаиморасчетов, ТекСделка.КратностьЦБ);
					КонецЕсли;
					
					
					// vns 23.09.2014
					Если (Лев(ТекСтрока.РежимТоргов,2) = "TQ" ИЛИ РежимТорговНаименование = "OCBR") или НачалоДняСделки <>НачалоДняРасчетов Тогда
						ТекСделка.НомерСделки 	= ТекСтрока.НомерСделки;
						// IMAPPS-30497
						Если ТекСделка.Контрагент = БанкВТБ И НЕ ТекСделка.ВалютаДокумента = Справочники.Валюты.RUB Тогда
							// АналитическийСчетДСКомиссииБрокера ссылается на Счет в RUB
							ТекСделка.АналитическийСчетДСКомиссиБрокера = ТекСтрока.АналитическийСчетДС; 
						КонецЕсли;

					Иначе
						ТекСделка.НомерВходящегоДокумента = ТекСтрока.НомерСделки;
					КонецЕсли;
					
					// vns 23.09.2014
					Если (Лев(ТекСтрока.РежимТоргов,2) <> "TQ" И РежимТорговНаименование <> "OCBR") И НачалоДняСделки = НачалоДняРасчетов Тогда
						ТекСделка.СчетУчетаАктива	= ?(ЭтоАкция, ПС.АкцииТело, ПС.ОблигацииТело);	
						ТекСделка.СчетУчетаРасчетовПоАвансам = ПС.РасчетыБрокераПоСделкам;
						ТекСделка.СчетУчетаРасчетовСКонтрагентом = ПС.РасчетыБрокераПоСделкам;
					Иначе
						Если ТекСделка.ВидОперации = Перечисления.ВидыОперацийСделка.Продажа Тогда
							ТекСделка.СчетУчетаВзаиморасчетов = ПланыСчетов.Хозрасчетный.РасчетыЦБПродажа;
						Иначе                       
							ТекСделка.СчетУчетаВзаиморасчетов = ПланыСчетов.Хозрасчетный.РасчетыЦБПокупка;
						КонецЕсли;
						
						ТекСделка.АвтоматическоеВыполнениеЗадач = Истина;
						ТекСделка.КомиссиюБрокераОтноситьНаРасходыПриОплате = 2;   
						ТекСделка.КомиссиюБиржиОтноситьНаРасходыПриОплате   = 2;
						ТекСделка.КомиссиюБиржиВключатьВСтоимость = 2;
						ТекСделка.КомиссиюБрокераВключатьВСтоимость = 2;
						ВремяСделки = ТекСделка.Дата - НачалоДня(ТекСделка.Дата);
						ТекСделка.ДатаОплатыСделки = НачалоДняРасчетов+ВремяСделки;
						ТекСделка.ДатаПоставки = НачалоДняРасчетов+ВремяСделки;
						ТекСделка.ДатаОплатыКомиссииБиржи = ТекСтрока.ДатаСделки;     
						ТекСделка.ДатаОплатыКомиссииБрокера = ТекСтрока.ДатаСделки;
						ТекСделка.КомиссияБиржи  = ТекСтрока.КомиссияБиржи;  
						
						ТекСделка.БУ = БУ;
						ТекСделка.ВУ = ВУ;
						ТекСделка.УУ = УУ;
										
						// MPazhukov IMAPPS-10226
						МоментОплаты = ОбщегоНазначенияДУПовтИсп.МоментОплатыКомиссий(ТекСтрока.ДатаСделки, ТекСтрока.Брокер, ТекСтрока.ДоговорБрокера, КомиссияБрокера, ТекСтрока.РежимТоргов);
						Если МоментОплаты = Справочники.МоментыОплатыКомиссий.ДатаРасчетов Тогда
							ТекСделка.ДатаОплатыКомиссииБрокера = НачалоДняРасчетов+ВремяСделки;
						ИначеЕсли МоментОплаты = Справочники.МоментыОплатыКомиссий.ДатаСделки Тогда
							ТекСделка.ДатаОплатыКомиссииБрокера = НачалоДняСделки+ВремяСделки;
						КонецЕсли;
						МоментОплаты = ОбщегоНазначенияДУПовтИсп.МоментОплатыКомиссий(ТекСтрока.ДатаСделки, ТекСтрока.Брокер, ТекСтрока.ДоговорБрокера, КомиссияБиржи, ТекСтрока.РежимТоргов);
						Если МоментОплаты = Справочники.МоментыОплатыКомиссий.ДатаРасчетов Тогда
							ТекСделка.ДатаОплатыКомиссииБиржи = НачалоДняРасчетов+ВремяСделки;
						ИначеЕсли МоментОплаты = Справочники.МоментыОплатыКомиссий.ДатаСделки Тогда
							ТекСделка.ДатаОплатыКомиссииБиржи = НачалоДняСделки+ВремяСделки;
						КонецЕсли;					
						
						// IMAPPS-22647
						Если Лев(ТекСтрока.РежимТоргов,4) = "MPTR" Тогда
							ТекСделка.ДатаОплатыКомиссииБиржи =ТекСтрока.ДатаСделки; 
							ТекСделка.ДатаОплатыКомиссииБрокера = ТекСтрока.ДатаСделки; 
						КонецЕсли;
						
						ЕстьДействующиеУП = РегистрыСведений.УчетныеПолитики.ЕстьДействующиеУП(ТекСтрока.ДатаСделки, ТекСтрока.ДоговорДУ);
						
						Если Не ЕстьДействующиеУП Тогда
							ТекстОшибкиУП = "Не установлена учетная политика для договора ДУ:"+ ТекСтрока.ДоговорДУ;
							ДобавитьОшибкуВРезультатДоговора(РезультатДоговора, ТекСтрока.НомерСделки, ТекстОшибкиУП);
							ДобавитьИнформациюОСделкеВРезультатДоговора(РезультатДоговора, ТекСтрока, Неопределено, ТекстОшибкиУП, Истина);
							Продолжить;
						КонецЕсли;
						
						// Используем кеш для запросов к регистру
						КлючКеша = Строка(ТекСтрока.ДоговорДУ) + "|" + Формат(НачалоДняСделки, "ДФ=yyyyMMdd");
						Порог = КешПорогов.Получить(КлючКеша);
						
						Если Порог = Неопределено Тогда
							Запрос = Новый Запрос();
							Запрос.Текст = 
							"ВЫБРАТЬ
							|	ЗначенияПараметровДоговораДУСрезПоследних.Значение КАК Порог
							|ИЗ
							|	РегистрСведений.ЗначенияПараметровДоговораДУ.СрезПоследних(
							|			&Дата,
							|			ДоговорДУ = &ДоговорДУ
							|				И Параметр = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыДоговораДУ.ПорогВключенияРасходовВСтоимость)) КАК ЗначенияПараметровДоговораДУСрезПоследних";
							
							Запрос.УстановитьПараметр("Дата", 			ТекСтрока.ДатаСделки);
							Запрос.УстановитьПараметр("ДоговорДУ", 		ТекСтрока.ДоговорДУ);
							
							Результат = Запрос.Выполнить().Выбрать();
							
							Если Результат.Следующий() Тогда
								Порог = Результат.Порог;
							Иначе
								ТекстОшибкиУП2 = "Не установлена учетная политика для договора ДУ:"+ ТекСтрока.ДоговорДУ;
								ДобавитьОшибкуВРезультатДоговора(РезультатДоговора, ТекСтрока.НомерСделки, ТекстОшибкиУП2);
								ДобавитьИнформациюОСделкеВРезультатДоговора(РезультатДоговора, ТекСтрока, Неопределено, ТекстОшибкиУП2, Истина);
								Продолжить;
							КонецЕсли;
							
							КешПорогов.Вставить(КлючКеша, Порог);
						КонецЕсли;
						
						Порог = ?(ЗначениеЗаполнено(Порог),Порог,0);
						
						Если Порог = 0 и ТекСделка.ВидОперации <> Перечисления.ВидыОперацийСделка.Продажа Тогда
							ТекСделка.КомиссиюБиржиВключатьВСтоимость    = 1;                                  
							ТекСделка.КомиссиюБрокераВключатьВСтоимость  = 1; 	
							ТекСделка.КомиссиюБрокераОтноситьНаРасходыПриОплате = 0;   
							ТекСделка.КомиссиюБиржиОтноситьНаРасходыПриОплате   = 0;
						Иначе	
							ТекСделка.КомиссиюБиржиВключатьВСтоимость    = 2;                                  
							ТекСделка.КомиссиюБрокераВключатьВСтоимость  = 2; 			
						КонецЕсли; 
						
					КонецЕсли;
					
					ФизическоеМестоХраненияДС = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ТекСделка.АналитическийСчетДС, "АналитическийПризнакСчетаБрокера,МестоХранения");
					Если ФизическоеМестоХраненияДС.АналитическийПризнакСчетаБрокера = Неопределено или ФизическоеМестоХраненияДС.АналитическийПризнакСчетаБрокера.Пустая() тогда
						ТекСделка.ФизическоеМестоХраненияДС = ФизическоеМестоХраненияДС.МестоХранения; 
					Иначе
						ТекСделка.ФизическоеМестоХраненияДС = ФизическоеМестоХраненияДС.АналитическийПризнакСчетаБрокера; 
					КонецЕсли;
					
					// vns 23.09.2014
					Если (Лев(ТекСтрока.РежимТоргов,2) <> "TQ" И РежимТорговНаименование <> "OCBR") И НачалоДняСделки = НачалоДняРасчетов Тогда
						
						ТекСделка.БУ = БУ;
						ТекСделка.ВУ = ВУ;
						ТекСделка.УУ = УУ;
						
						ТекСделка.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.НеЗачитывать;
						ТекСделка.ДопРасходы.Очистить();
						
						Если ТекСтрока.КомиссияБиржи<>0 Тогда
							НовыйДопРасход = ТекСделка.ДопРасходы.Добавить();
							НовыйДопРасход.Стоимость 		= ТекСтрока.КомиссияБиржи;
							НовыйДопРасход.СтатьяЗатрат 	= КомиссияБиржи;
							НовыйДопРасход.СчетУчетаЗатрат 	= СчетКомиссииБиржа;
							НовыйДопРасход.ВключатьВСтоимость = 2;
							// vns 30.03.2016
							НовыйДопРасход.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.КомиссияБиржи;
							
							// MPazhukov IMAPPS-11125
							// IMAPPS-24661
							Если НЕ ТекСделка.Биржа.Иностранная И ТекСделка.Контрагент = БанкВТБ И НЕ ТекСделка.ВалютаДокумента = Справочники.Валюты.RUB Тогда
								// АналитическийСчетДСКомиссииБиржи ссылается на Счет в RUB
								НовыйДопРасход.АналитическийСчетДС = ТекСтрока.АналитическийСчетДС;
							ИначеЕсли НЕ ТекСделка.Биржа.Иностранная Тогда
								НовыйДопРасход.ВалютаКомиссии = Справочники.Валюты.RUB;
								НовыйДопРасход.КурсКомиссии = 1;
								НовыйДопРасход.КратностьКомиссии = 1;
								
								НовыйДопРасход.АналитическийСчетДС = ТекСтрока.АналитическийСчетДСКомиссииБиржи;
							КонецЕсли;	
							// MPazhukov IMAPPS-11125 
							
						КонецЕсли;
						
						Если ТекСтрока.КомиссияТС<>0 Тогда
							НовыйДопРасход = ТекСделка.ДопРасходы.Добавить();
							НовыйДопРасход.Стоимость 		= ТекСтрока.КомиссияТС;
							НовыйДопРасход.СтатьяЗатрат 	= КомиссияТС;
							НовыйДопРасход.СчетУчетаЗатрат 	= СчетКомиссияТС;
							НовыйДопРасход.ВключатьВСтоимость = 2;
							
							// MPazhukov IMAPPS-11125
							Если НЕ ТекСделка.Биржа.Иностранная Тогда
								НовыйДопРасход.ВалютаКомиссии = Справочники.Валюты.RUB;
								НовыйДопРасход.КурсКомиссии = 1;
								НовыйДопРасход.КратностьКомиссии = 1;						
							КонецЕсли;	
							// MPazhukov IMAPPS-11125 						
							
						КонецЕсли;
						
						Если ТекСтрока.КомиссияБрокера<>0 Тогда
							НовыйДопРасход = ТекСделка.ДопРасходы.Добавить();
							НовыйДопРасход.Стоимость 		= ТекСтрока.КомиссияБрокера;
							НовыйДопРасход.СтатьяЗатрат 	= КомиссияБрокера;
							НовыйДопРасход.СчетУчетаЗатрат 	= СчетКомиссииБрокера;
							НовыйДопРасход.ВключатьВСтоимость = 2;
							// vns 30.03.2016
							НовыйДопРасход.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.КомиссияБрокера;
							
							// MPazhukov IMAPPS-11125
							// IMAPPS-24661
							Если НЕ ТекСделка.Биржа.Иностранная И ТекСделка.Контрагент = БанкВТБ И НЕ ТекСделка.ВалютаДокумента = Справочники.Валюты.RUB Тогда
								// АналитическийСчетДСКомиссиБрокера ссылается на счет в RUB
								НовыйДопРасход.АналитическийСчетДС = ТекСтрока.АналитическийСчетДС;
							ИначеЕсли НЕ ТекСделка.Биржа.Иностранная Тогда
								НовыйДопРасход.ВалютаКомиссии = Справочники.Валюты.RUB;	
								НовыйДопРасход.КурсКомиссии = 1;
								НовыйДопРасход.КратностьКомиссии = 1;
								
								НовыйДопРасход.АналитическийСчетДС = ТекСтрока.АналитическийСчетДСКомиссиБрокера;
							КонецЕсли;	
							// MPazhukov IMAPPS-11125 
							
						КонецЕсли;
						
						ТекСделкаВключатьВСтоимость = 2;  
					КонецЕсли; // vns 23.09.2014
					
					Если ЭтоТПлюсРасчетыВвалюте(РежимТорговНаименование) Тогда
						ТекСделка.ОпределятьКурсНаДатуОперации = Истина;
						ТекСделка.ОпределятьКурсАктиваНаДатуОперации = Истина;
					КонецЕсли;
					//DV 07/05/14
				КОНЕЦЕСЛИ;
				
				// Nisaychev IMAPPS-15479
				Если ТекСтрока.HTM И ОбщегоНазначения.ЕстьРеквизитОбъекта("ТипПортфеля",ТекСделка.Метаданные()) Тогда
					ТекСделка.ТипПортфеля = HTM;
				КонецЕсли;
				
				// vns 23.09.2014
				// IMAPPS-21542
				Если ТИпЗнч(ТекСделка.Ссылка) = Тип("БизнесПроцессСсылка.СделкиРЕПО") И ТекСтрока.КомисииВВалютеСделки ТОгда
					// IMAPPS-35845 ++ 
					Если ПроверитьУсловиеНаОбратныеРЕПО(ТекСделка, БанкВТБ) Тогда
						КурсКратность2ЧастьРЕПО = МодульВалютногоУчета.ПолучитьКурсВалютыПоПортфелю(ТекСделка.ДоговорДУ, ТекСделка.ВалютаДокумента, ТекСделка.ДатаОплатыВторойЧастиСделкиРЕПО);
						Если ТекСделка.КомиссияБрокераВторойЧастиРЕПО > 0 Тогда
							ТекСделка.КурсКомиссииБрокера2ЧастьРЕПО = КурсКратность2ЧастьРЕПО.Курс;
							ТекСделка.КратностьКомиссииБрокера2ЧастьРЕПО = КурсКратность2ЧастьРЕПО.Кратность;
						КонецЕсли;
						Если ТекСделка.КомиссияБиржиВторойЧастиРЕПО > 0 Тогда
							ТекСделка.КурсКомиссииБиржи2ЧастьРЕПО = КурсКратность2ЧастьРЕПО.Курс;
							ТекСделка.КратностьКомиссииБиржи2ЧастьРЕПО =  КурсКратность2ЧастьРЕПО.Кратность; 
						Конецесли; 
					Иначе
						Если ТекСделка.КомиссияБрокераПервойЧастиРЕПО > 0 Тогда
							ТекСделка.КратностьКомиссииБрокера1ЧастьРЕПО = ТекСделка.КратностьВзаиморасчетов;
							ТекСделка.КурсКомиссииБрокера1ЧастьРЕПО = ТекСделка.КурсВзаиморасчетов; 
						КонецЕсли;
						Если ТекСделка.КомиссияБрокераВторойЧастиРЕПО > 0 Тогда
							ТекСделка.КратностьКомиссииБрокера2ЧастьРЕПО = ТекСделка.КратностьВзаиморасчетов;
							ТекСделка.КурсКомиссииБрокера2ЧастьРЕПО = ТекСделка.КурсВзаиморасчетов; 
						Конецесли; 
					КонецЕсли;
					// IMAPPS-35845 -- 
				КонецЕсли;
				
				Если (Лев(РежимТорговНаименование,2) <> "TQ" И РежимТорговНаименование <> "OCBR")И
					(НачалоДняСделки = НачалоДняРасчетов Или (НачалоДняСделки <> НачалоДняРасчетов И Найти(РежимТорговНаименование,"OPT")>0))
					И Найти(РежимТорговНаименование, "RP") = 0
					И Найти(РежимТорговНаименование, "RD") = 0
					И Найти(РежимТорговНаименование, "RE") = 0
					И Найти(РежимТорговНаименование, "WP") = 0  // IMAPPS-9973
					И Найти(РежимТорговНаименование, "WD") = 0
					И Найти(РежимТорговНаименование, "WE") = 0
					И Найти(РежимТорговНаименование, "PSRY") = 0   // IMAPPS-32266
					И НЕ (Найти(РежимТорговНаименование, "EQ") > 0 И Найти(РежимТорговНаименование, "BND")>0)  // IMAPPS-22672
					И РежимТорговНаименование <> "OTC"
					И НЕ ЭтоРЕПО_КСУ(РежимТорговНаименование) Тогда  // IMAPPS-15992
					
					Если ТекСделка.ПроверитьЗаполнение() Тогда
						
						Отказ = Ложь;
						Попытка 
							ТекСделка.Записать(РежимЗаписиДокумента.Проведение);
						Исключение
							Отказ = Истина;
							ТекстОшибки = ПолучитьТекстОшибки("Ошибки проведения:");
						КонецПопытки;
					Иначе
						ТекстОшибки = ПолучитьТекстОшибки("Проверка реквизитов:");
						Отказ = Истина;
					КонецЕсли;
					
				Иначе
					Отказ = Ложь;
					Попытка 
						ТекСделка.Записать();
						ТекСделка.Старт();
						Если РежимТорговНаименование = "OTC" Тогда
							БизнесПроцессы.ВнебиржеваяСделка.ВыполнитьШагБизнесПроцессаАвтоматически(ТекСделка.Ссылка,"УстановкаНастроекБП", Ложь);
							БизнесПроцессы.ВнебиржеваяСделка.ВыполнитьШагБизнесПроцессаАвтоматически(ТекСделка.Ссылка,"ОткрытиеПлановойПозиции", Ложь);
						КонецЕсли;
					Исключение
						Отказ = Истина;
						ТекстОшибки = ПолучитьТекстОшибки("Ошибки проведения:");
						ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеОшибки(); // IMAPPS-36975 вывод описания ошибки
					КонецПопытки;
					Если Не Отказ Тогда
						ОбработатьПлановуюПозициюРДУ(ТекСделка.Ссылка, ТекСделка.ДоговорДУ);
					КонецЕсли;
				КонецЕсли; // vns 23.09.2014
				
				Если Не Отказ Тогда
					РезультатДоговора.Обработано = РезультатДоговора.Обработано + 1;
				Иначе
					ДобавитьОшибкуВРезультатДоговора(РезультатДоговора, ТекСтрока.НомерСделки, ТекстОшибки);
				КонецЕсли;
				
				ДобавитьИнформациюОСделкеВРезультатДоговора(РезультатДоговора, ТекСтрока, ?(Отказ, Неопределено, ТекСделка.Ссылка), ?(Отказ, ТекстОшибки, ""), Отказ);
				
			Исключение
				ТекстОшибки = ПолучитьТекстОшибки("Ошибка обработки:");
				ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеОшибки(); // IMAPPS-36975 вывод описания ошибки
				ДобавитьОшибкуВРезультатДоговора(РезультатДоговора, ТекСтрока.НомерСделки, ТекстОшибки);
				
				ДобавитьИнформациюОСделкеВРезультатДоговора(РезультатДоговора, ТекСтрока, Неопределено, ТекстОшибки, Истина);
			КонецПопытки;
			
		КонецЦикла;

		// Конец цикла по договорам в пачке
	КонецЦикла;

	ПоместитьВоВременноеХранилище(XML(РезультатДоговора), АдресРезультата);
	
КонецПроцедуры

// Описание: Сериализует данные в XML-строку
//           Использует СериализаторXDTO для преобразования произвольных данных в XML-формат
//
// Параметры:
//   Данные - Произвольный - данные для сериализации (таблица значений, структура и т.д.)
//
// Возвращаемое значение:
//   Строка - XML-сериализованная строка данных
//
Функция XML(Данные)
	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Данные);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

// Описание: Десериализует таблицу значений или структуру из XML-строки
//           Использует СериализаторXDTO для преобразования XML-строки в объект данных
//
// Параметры:
//   XMLСтрока - Строка - XML-сериализованная строка данных (таблица значений, структура и т.д.)
//
// Возвращаемое значение:
//   Произвольный - десериализованный объект данных (таблица значений, структура и т.д.)
//
Функция ДесериализоватьТаблицуИзXML(Знач XMLСтрока)
	
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.УстановитьСтроку(XMLСтрока);
	Результат = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	Возврат Результат;
	
КонецФункции

// Описание: Добавляет информацию об ошибке в структуру результата обработки договора
//           Увеличивает счетчик ошибок и добавляет структуру с номером сделки и текстом ошибки в список ошибок
//
// Параметры:
//   РезультатДоговора - Структура - структура результата обработки договора (должна содержать поля Ошибок и СписокОшибок)
//   НомерСделки - Строка - номер сделки, при обработке которой возникла ошибка
//   ТекстОшибки - Строка - текст ошибки, возникшей при обработке сделки
//
Процедура ДобавитьОшибкуВРезультатДоговора(РезультатДоговора, НомерСделки, ТекстОшибки)
	
	СтруктураОшибки = Новый Структура;
	СтруктураОшибки.Вставить("НомерСделки", НомерСделки);
	СтруктураОшибки.Вставить("ТекстОшибки", ТекстОшибки);
	РезультатДоговора.СписокОшибок.Добавить(СтруктураОшибки);
	РезультатДоговора.Ошибок = РезультатДоговора.Ошибок + 1;
	
КонецПроцедуры

// Описание: Добавляет информацию о сделке в структуру результата обработки договора для последующего вывода в лог
//           Создает структуру с данными сделки, ссылкой на созданный объект, текстом ошибки и признаком отказа
//
// Параметры:
//   РезультатДоговора - Структура - структура результата обработки договора (должна содержать поле СписокСделок)
//   ТекСтрока - Произвольный - строка таблицы значений с данными сделки (или Неопределено)
//   Сделка - Произвольный - ссылка на созданный объект сделки (БП или документ) или Неопределено, если создание не удалось
//   ТекстОшибки - Строка - текст ошибки, возникшей при обработке сделки, или пустая строка при успешной обработке
//   Отказ - Булево - признак отказа в обработке сделки (Истина - ошибка, Ложь - успешно)
//
Процедура ДобавитьИнформациюОСделкеВРезультатДоговора(РезультатДоговора, ТекСтрока, Сделка, ТекстОшибки, Отказ)
	
	ИнформацияОСделке = Новый Структура;
	ИнформацияОСделке.Вставить("ТекСтрока", ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТекСтрока));
	ИнформацияОСделке.Вставить("Сделка", Сделка);
	ИнформацияОСделке.Вставить("ТекстОшибки", ТекстОшибки);
	ИнформацияОСделке.Вставить("Отказ", Отказ);
	РезультатДоговора.СписокСделок.Добавить(ИнформацияОСделке);
	
КонецПроцедуры

// Описание: Получает ссылку на обработку из справочника ДополнительныеОтчетыИОбработки
//           по имени текущей обработки
//
// Возвращаемое значение:
//   СправочникСсылка.ДополнительныеОтчетыИОбработки - ссылка на элемент справочника с текущей обработкой
//                                                     или Неопределено, если обработка не найдена
//
Функция ПолучитьСсылкуНаОбработкуИзСправочника()
	
	ИмяОбработки = ЭтотОбъект.Метаданные().Имя;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта";
	
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбработки);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ОбработатьПлановуюПозициюРДУ(БП, ДоговорДУ)

	ПулДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорДУ, "Пул");
	Пул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ");
	
	Если ПулДоговора = Пул Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ОткрытиеПлановойПозиции.Ссылка КАК ОткрытиеПлановойПозиции
			|ИЗ
			|	Документ.ОткрытиеПлановойПозиции КАК ОткрытиеПлановойПозиции
			|ГДЕ
			|	ОткрытиеПлановойПозиции.БизнесПроцесс = &БизнесПроцесс
			|	И НЕ ОткрытиеПлановойПозиции.Проведен
			|	И НЕ ОткрытиеПлановойПозиции.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("БизнесПроцесс", БП);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ПлановаПозиция = ВыборкаДетальныеЗаписи.ОткрытиеПлановойПозиции.ПолучитьОбъект();
			Попытка
				ПлановаПозиция.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			Исключение
				ТекстОшибки = ПолучитьТекстОшибки("Ошибки проведения:");
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


#КонецОбласти

ИнициализироватьОбщиеПеременные();
