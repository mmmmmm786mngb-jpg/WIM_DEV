#КонецОбласти

Процедура ОбновитьПартнера(Отказ, ТекстОшибки="") Экспорт
	
	Лог.Очистить();
	
	ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	Лог.Вывести(ЗаголовокТаблицы);
	
	СтрокаДокументов = Макет.ПолучитьОбласть("СтрокаТаблицы");
	
	МассивУдаления = Новый Массив;
	
	ВсегоЗагружено = 0;
	
	Для Каждого ТекСтрока из СписокЗагрузки Цикл
		
		ЕСЛИ Найти(ТекСтрока.РежимТоргов.Наименование, "RP") > 0
			ИЛИ Найти(ТекСтрока.РежимТоргов.Наименование, "RD") > 0
			ИЛИ Найти(ТекСтрока.РежимТоргов.Наименование, "RE") > 0
			ИЛИ Найти(ТекСтрока.РежимТоргов.Наименование, "WP") > 0
			ИЛИ Найти(ТекСтрока.РежимТоргов.Наименование, "WD") > 0
			ИЛИ Найти(ТекСтрока.РежимТоргов.Наименование, "WE") > 0
			ИЛИ (Найти(ТекСтрока.РежимТоргов.Наименование, "EQ") > 0 И Найти(ТекСтрока.РежимТоргов.Наименование, "BND")>0)
			ИЛИ ЭтоРЕПО_КСУ(ТекСтрока.РежимТоргов.Наименование) И ЗначениеЗаполнено(ТекСтрока.КодБрокера) Тогда
			
			ТекСделка = СделкаПоНомеру(ТекСтрока.НомерСделки, ТекСтрока.Продажа);
			Если Не ЗначениеЗаполнено(ТекСделка) Тогда
				МассивУдаления.Добавить(ТекСтрока);
				Продолжить;
			КонецЕсли;
			
			ТекСделкаОбъект = ТекСделка.ПолучитьОбъект();
			
			ТекСделкаОбъект.Партнер = ПолучитьКонтрагентаПоКодуБрокера(ТекСтрока.КодБрокера);
			Если Не ЗначениеЗаполнено(ТекСделкаОбъект.Партнер) Тогда
				ТекстОшибки = "На дату " + Формат(ТекСтрока.ДатаСделки, "ДФ=dd.MM.yyyy") + " для БП Сделка РЕПО не найден партнер по коду брокера: " + СокрЛП(ТекСтрока.КодБрокера);
				Отказ = Истина;
			КонецЕсли;
			
			Отказ = Ложь;
			Попытка
				ТекСделкаОбъект.ОбменДанными.Загрузка = Истина;
				ТекСделкаОбъект.Записать();
			Исключение
				Отказ = Истина;
				ТекстОшибки = ПолучитьТекстОшибки("Ошибки проведения:");
			КонецПопытки;
			
			СтрокаДокументов.Параметры.Заполнить(ТекСтрока);
			СтрокаДокументов.Параметры.Сделка 		= ?(Отказ, "", ТекСделкаОбъект.Ссылка);
			СтрокаДокументов.Параметры.ОшибкаСделки	= ?(Отказ, ТекстОшибки, "");
			СтрокаДокументов.Параметры.ЕстьОшибки 	= ?(Отказ, "ДА", "");
			
			Если ТекСтрока.ДоговорДУ.Пустая() тогда
				СтрокаДокументов.Параметры.ДоговорДУ = "<???>";
			КонецЕсли;
			Лог.Вывести(СтрокаДокументов);
			
			Если Не Отказ тогда
				МассивУдаления.Добавить(ТекСтрока);
				ВсегоЗагружено = ВсегоЗагружено + 1;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ТекСтрока из МассивУдаления Цикл
		СписокЗагрузки.Удалить(ТекСтрока);
	Конеццикла;
	
КонецПроцедуры
// MPazhukov IMAPPS-8887 23.08.2019

Функция ПолучитьКонтрагентаПоКодуБрокера(КодБрокера)
	
	Если Не ЗначениеЗаполнено(КодБрокера) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтрагентыДополнительныеРеквизиты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты.ДополнительныеРеквизиты КАК КонтрагентыДополнительныеРеквизиты
		|ГДЕ
		|	КонтрагентыДополнительныеРеквизиты.Свойство.Наименование = &Наименование
		|	И КонтрагентыДополнительныеРеквизиты.Значение = &Значение";
	
	Запрос.УстановитьПараметр("Значение", СокрЛП(КодБрокера));
	Запрос.УстановитьПараметр("Наименование", "Код контрагента");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

#Область IMAPPS34861_ОптимизацияПоСкорости

// Процедура для предварительной подготовки кэшей перед обработкой сделок
Процедура ПодготовитьКэшЗагрузки(Сделки)
	
	// Инициализация кэшей
	КэшТорговыхКодов = Новый Соответствие;
	КэшСрочногоРынка = Новый Соответствие;
	КэшАктивовПоКоду = Новый Соответствие;
	КэшРежимовТоргов = Новый Соответствие;
	КэшБирж = Новый Соответствие;
	
	// 1. Сбор уникальных ключей из сделок
	КлючиТК = Новый ТаблицаЗначений;
	КлючиТК.Колонки.Добавить("КодКлиента", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	КлючиТК.Колонки.Добавить("ВалютаСсылка", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	КлючиАктивов = Новый ТаблицаЗначений;
	КлючиАктивов.Колонки.Добавить("КодАктива", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	КлючиАктивов.Колонки.Добавить("БиржаСсылка", Новый ОписаниеТипов("СправочникСсылка.Биржи"));
	
	УникТК = Новый Соответствие;
	УникАктивов = Новый Соответствие;
	
	Для Каждого ТекСделка Из Сделки Цикл
		// Ключи Торговых Кодов
		Если ОтборПоПулу = 1 Тогда
			Комментарий = СокрЛП(ТекСделка.Комментарий);
			КодКлиента = Лев(Комментарий, СтрДлина(Комментарий) - 1);
		Иначе
			КодКлиента = ТекСделка.КодКлиента;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодКлиента) Тогда
			ВалютаСсылка = НайтиВалютуЧерезКэш(ТекСделка.ВалютаСделки);
			КлючТК = КодКлиента + "|" + ?(ЗначениеЗаполнено(ВалютаСсылка), Строка(ВалютаСсылка.УникальныйИдентификатор()), "");
			
			Если УникТК[КлючТК] = Неопределено Тогда
				НовСтр = КлючиТК.Добавить();
				НовСтр.КодКлиента = КодКлиента;
				НовСтр.ВалютаСсылка = ВалютаСсылка;
				УникТК.Вставить(КлючТК, Истина);
			КонецЕсли;
		КонецЕсли;
		
		// Ключи Активов (из XDTO объектов веб-сервиса)
		Попытка
			КодАктива = ТекСделка.Актив.КодЦБнаММВБ;
			БиржаСсылка = НайтиБиржуЧерезКэш(ТекСделка.Биржа.Наименование);
		Исключение
			Продолжить; // Пропускаем, если нет нужных полей
		КонецПопытки;
		
		Если ЗначениеЗаполнено(КодАктива) Тогда
			КлючАктива = КодАктива + "|" + ?(ЗначениеЗаполнено(БиржаСсылка), Строка(БиржаСсылка.УникальныйИдентификатор()), "");
			
			Если УникАктивов[КлючАктива] = Неопределено Тогда
				НовСтр = КлючиАктивов.Добавить();
				НовСтр.КодАктива = КодАктива;
				НовСтр.БиржаСсылка = БиржаСсылка;
				УникАктивов.Вставить(КлючАктива, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// 3. Запрос для кэширования Торговых Кодов
	Если КлючиТК.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаКлючейТК", КлючиТК);
		Запрос.УстановитьПараметр("RUB", Справочники.Валюты.RUB);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТК.КодКлиента КАК КодКлиента,
		|	ТК.ВалютаСсылка КАК ВалютаСсылка
		|ПОМЕСТИТЬ втКлючиТК
		|ИЗ
		|	&ТаблицаКлючейТК КАК ТК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Ключи.КодКлиента КАК КлючКодКлиента,
		|	Ключи.ВалютаСсылка КАК КлючВалютаСсылка,
		|	ТорговыеКоды.Ссылка КАК ТорговыйКодСсылка,
		|	ТорговыеКоды.ДоговорДУ КАК ДоговорДУ,
		|	ТорговыеКоды.Брокер КАК Брокер,
		|	ТорговыеКоды.ДоговорБрокера КАК ДоговорБрокера,
		|	ТорговыеКоды.АналитическийСчетЦБ КАК АналитическийСчетЦБ,
		|	ТорговыеКоды.АналитическийСчетДС КАК АналитическийСчетДС,
		|	ТорговыеКодыRUB.АналитическийСчетДС КАК АналитическийСчетДСКомиссиБрокера,
		|	ТорговыеКодыRUB.АналитическийСчетДС КАК АналитическийСчетДСКомиссииБиржи
		|ИЗ
		|	втКлючиТК КАК Ключи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТорговыеКоды КАК ТорговыеКоды
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТорговыеКоды.СписокКодов КАК ТКСписокКодов
		|			ПО (ТКСписокКодов.Ссылка = ТорговыеКоды.Ссылка)
		|		ПО (ТорговыеКоды.ТорговыйКод = Ключи.КодКлиента
		|				ИЛИ ТорговыеКоды.Наименование = Ключи.КодКлиента
		|				ИЛИ ТКСписокКодов.ТорговыйКод = Ключи.КодКлиента)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТорговыеКоды КАК ТорговыеКодыRUB
		|		ПО (ТорговыеКодыRUB.Брокер = ТорговыеКоды.Брокер)
		|			И (ТорговыеКоды.ТорговыйКод = ТорговыеКодыRUB.ТорговыйКод ИЛИ ТорговыеКоды.Наименование = ТорговыеКодыRUB.Наименование)
		|			И (НЕ ТорговыеКодыRUB.ПометкаУдаления)
		|			И (ТорговыеКодыRUB.АналитическийСчетДС.МестоХранения.ВалютаДенежныхСредств = &RUB)
		|			И (ТорговыеКоды.ДоговорДУ = ТорговыеКодыRUB.ДоговорДУ)
		|ГДЕ
		|	НЕ ТорговыеКоды.ПометкаУдаления
		|	И ВЫБОР
		|			КОГДА ТорговыеКоды.АналитическийСчетДС.МестоХранения ССЫЛКА Справочник.БанковскиеСчета
		|				ТОГДА ТорговыеКоды.АналитическийСчетДС.МестоХранения.ВалютаДенежныхСредств = Ключи.ВалютаСсылка
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаТК = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаТК.Следующий() Цикл
			Ключ = ВыборкаТК.КлючКодКлиента + "|" + ?(ЗначениеЗаполнено(ВыборкаТК.КлючВалютаСсылка), Строка(ВыборкаТК.КлючВалютаСсылка.УникальныйИдентификатор()), "");
			
			Если КэшТорговыхКодов[Ключ] = Неопределено Тогда
				ДанныеТК = Новый Структура(
					"ДоговорДУ,Брокер,ДоговорБрокера,АналитическийСчетЦБ,АналитическийСчетДС,АналитическийСчетДСКомиссиБрокера,АналитическийСчетДСКомиссииБиржи",
					ВыборкаТК.ДоговорДУ, ВыборкаТК.Брокер, ВыборкаТК.ДоговорБрокера, ВыборкаТК.АналитическийСчетЦБ, ВыборкаТК.АналитическийСчетДС, ВыборкаТК.АналитическийСчетДСКомиссиБрокера, ВыборкаТК.АналитическийСчетДСКомиссииБиржи
				);
				КэшТорговыхКодов.Вставить(Ключ, ДанныеТК);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// 4. Заполнение кэша активов через вызов АктивПоКоду
	Для Каждого СтрокаКлюча Из КлючиАктивов Цикл
		Ключ = СтрокаКлюча.КодАктива + "|" + ?(ЗначениеЗаполнено(СтрокаКлюча.БиржаСсылка), Строка(СтрокаКлюча.БиржаСсылка.УникальныйИдентификатор()), "");
		
		Если КэшАктивовПоКоду[Ключ] = Неопределено Тогда
			НайденныйАктив = АктивПоКоду(СтрокаКлюча.КодАктива, СтрокаКлюча.БиржаСсылка, Истина, "", 0);
			
			Если НайденныйАктив <> Неопределено Тогда
				КэшАктивовПоКоду.Вставить(Ключ, НайденныйАктив);
				
				Если КэшСрочногоРынка[НайденныйАктив] = Неопределено Тогда
					КэшСрочногоРынка.Вставить(НайденныйАктив, ЭтоСделкаСрочногоРынка(НайденныйАктив));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция для поиска биржи с использованием кэша
Функция НайтиБиржуЧерезКэш(Знач Имя)
	Если ПустаяСтрока(Имя) Тогда
		Возврат Справочники.Биржи.ПустаяСсылка();
	КонецЕсли;
	Рез = КэшБирж[Имя];
	Если Рез = Неопределено Тогда
		Рез = Справочники.Биржи.НайтиПоНаименованию(Имя);
		КэшБирж.Вставить(Имя, Рез);
	КонецЕсли;
	Возврат Рез;
КонецФункции

// Функция для поиска валюты с использованием кэша (с учетом исключения SUR->RUB)
Функция НайтиВалютуЧерезКэш(Знач Имя)
	Если ПустаяСтрока(Имя) Тогда
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;
	
	Рез = СоответствиеВалют[Имя];
	Если Рез = Неопределено Тогда
		// Исключение: SUR -> RUB
		ИмяДляПоиска = Имя;
		Если ВРег(Имя) = "SUR" Тогда
			ИмяДляПоиска = "RUB";
		КонецЕсли;
		
		Рез = Справочники.Валюты.НайтиПоНаименованию(ИмяДляПоиска);
		СоответствиеВалют.Вставить(Имя, Рез);
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция ПроверитьУсловиеНаОбратныеРЕПО(ТекСделка, БанкВТБ) Экспорт
	Если ТекСделка.ВидОперации = Перечисления.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО И ТекСделка.Контрагент = БанкВТБ 
		И (ТекСделка.ДоговорДУ.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ФизическиеЛица 
		ИЛИ ТекСделка.ДоговорДУ.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ЮридическиеЛица
		ИЛИ	ТекСделка.ДоговорДУ.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ФондЦелевогоКапитала
		ИЛИ ТекСделка.ДоговорДУ.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.СаморегулируемыеОрганизации) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

