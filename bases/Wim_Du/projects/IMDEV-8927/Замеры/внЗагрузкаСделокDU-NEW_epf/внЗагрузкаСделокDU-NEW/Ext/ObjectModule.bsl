		Если МассивСвойств.Количество() <> 0 Тогда
			ТаблицаСвойств = УправлениеСвойствами.ПолучитьЗначенияСвойств(Брокер, Ложь, Истина, МассивСвойств);
			Если Не ДопСведениеНеСчитатьКомБиржи.Пустая() Тогда
				НайденнаяСтрока = ТаблицаСвойств.Найти(ДопСведениеНеСчитатьКомБиржи, "Свойство");
				Если НайденнаяСтрока <> Неопределено Тогда
					СтруктураДопСведенияБрокер.НеСчитатьКомиссиюБиржиПоСделкам = НайденнаяСтрока.Значение;
				КонецЕсли;
			КонецЕсли;
			Если Не ДопСведениеНеСчитатьКомБрокера.Пустая() Тогда
				НайденнаяСтрока = ТаблицаСвойств.Найти(ДопСведениеНеСчитатьКомБрокера, "Свойство");
				Если НайденнаяСтрока <> Неопределено Тогда
					СтруктураДопСведенияБрокер.НеСчитатьКомиссиюБрокераПоСделкам = НайденнаяСтрока.Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		мСтруктураКэшДанных.ДопСведенияБрокер.Вставить(Брокер, СтруктураДопСведенияБрокер);
		
	КонецЕсли;
	
	Возврат мСтруктураКэшДанных.ДопСведенияБрокер.Получить(Брокер);
	
КонецФункции

