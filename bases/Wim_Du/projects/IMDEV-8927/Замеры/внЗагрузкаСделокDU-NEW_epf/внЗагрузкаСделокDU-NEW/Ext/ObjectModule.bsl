#Область DV

Функция DV_BrokerCode(ПИФ)
	КодЦБ = "";
	DV_BrokerCode1 = "";
	DV_BrokerCode2 = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТорговыеКоды.ТорговыйКод КАК ТорговыйКод
	               |ИЗ
	               |	Справочник.ТорговыеКоды КАК ТорговыеКоды
	               |ГДЕ
	               |	ТорговыеКоды.ДоговорДУ.ПометкаУдаления = ЛОЖЬ
	               |	И ТорговыеКоды.ДоговорДУ.Пул <> &Пул
	               |	И ТорговыеКоды.ДоговорДУ = &ПИФ
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТорговыеКоды.ТорговыйКод
	               |ИЗ
	               |	Справочник.ТорговыеКоды.СписокКодов КАК ТорговыеКоды
	               |ГДЕ
	               |	НЕ ТорговыеКоды.Ссылка.ПометкаУдаления
	               |	И ТорговыеКоды.Ссылка.ДоговорДУ.Пул <> &Пул
	               |	И ТорговыеКоды.Ссылка.ДоговорДУ = &ПИФ
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ТорговыеКоды.Наименование
	               |ИЗ
	               |	Справочник.ТорговыеКоды КАК ТорговыеКоды
	               |ГДЕ
	               |	НЕ ТорговыеКоды.ДоговорДУ.ПометкаУдаления
	               |	И ТорговыеКоды.ДоговорДУ.Пул <> &Пул
	               |	И ТорговыеКоды.ДоговорДУ = &ПИФ";
	
	Если ЗначениеЗаполнено(ПИФ) Тогда
		//Запрос.Текст = Запрос.Текст + " И ТорговыеКоды.ДоговорДУ = &ПИФ";
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ТорговыеКоды.ДоговорДУ.Пул <> &Пул","");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ТорговыеКоды.Ссылка.ДоговорДУ.Пул <> &Пул","");
		Запрос.УстановитьПараметр("ПИФ", ПИФ);
	ИначеЕсли ОтборПоПулу = 1 Тогда
		Запрос.Текст = ЗапросПоПулу();
	Иначе
		Если Не ЗначениеЗаполнено(Пул) Или ОтборПоПулу = 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ТорговыеКоды.ДоговорДУ.Пул <> &Пул","");
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ТорговыеКоды.Ссылка.ДоговорДУ.Пул <> &Пул","");
		КонецЕсли;
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ТорговыеКоды.ДоговорДУ = &ПИФ","");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ТорговыеКоды.Ссылка.ДоговорДУ = &ПИФ","");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Пул", Пул);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КодЦБ = КодЦБ + ВыборкаДетальныеЗаписи.ТорговыйКод + ",";
		Если СтрДлина(DV_BrokerCode1) < 7500 Тогда
			DV_BrokerCode1 = DV_BrokerCode1 + ВыборкаДетальныеЗаписи.ТорговыйКод + ",";
		Иначе
			DV_BrokerCode2 = DV_BrokerCode2 + ВыборкаДетальныеЗаписи.ТорговыйКод + ",";
		КонецЕсли;			
	КонецЦикла;
	
	//	Сообщить(КодЦБ);
	//	Сообщить(DV_BrokerCode1);
	//	Сообщить(DV_BrokerCode2);
	
	Возврат КодЦБ;
КонецФункции

