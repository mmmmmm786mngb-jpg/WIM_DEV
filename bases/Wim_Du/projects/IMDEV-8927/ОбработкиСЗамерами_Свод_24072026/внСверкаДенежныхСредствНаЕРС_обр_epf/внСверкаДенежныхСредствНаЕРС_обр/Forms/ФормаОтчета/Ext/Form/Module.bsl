
&НаКлиенте
Процедура Сформировать(Команда)
	Отчет.КонДата = КонецДня(Отчет.НачДата);
	СформироватьНаСервере();
	Отчет.Отчет.ТолькоПросмотр = ИСТИНА;
	//Отчет.Отчет.Показать("Сверка денежных средств");
КонецПроцедуры

&НаСервере
Функция СформироватьНаСервере()
	Объект = РеквизитФормыВЗначение("Отчет");
	ТабДок = Объект.ВыполнитьСверку();
	ЗначениеВРеквизитФормы(Объект, "Отчет");
КонецФункции
