
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем ИдентификаторКомандыДляЗамера; // IMDEV-8927

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура();
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", "Расчет вознаграждения розничного ДУ");
	ПараметрыРегистрации.Вставить("Версия", "1.02");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "Расчет вознаграждения розничного ДУ");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(
		ТаблицаКоманд, 
		"Расчет вознаграждения розничного ДУ (Интерактивная)",
		"РасчетВознагражденияРозничногоДУ",
		"ОткрытиеФормы"
	);
	
	ДобавитьКоманду(
		ТаблицаКоманд,
		"Расчет вознаграждения розничного ДУ (фоновое выполнение)",
		"ФоновоеВыполнение",
		"ВызовСерверногоМетода"
	);
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
	
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки.Значения);
		ЗагрузитьТЧ("СписокРассылки", Настройки);
		ЗагрузитьТЧ("НастройкаРасчета", Настройки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда
		Возврат;
	КонецЕсли;
	
	// IMDEV-8927 ++
	ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
	КлючеваяОперацияРасчет = ПолучитьИмяКлючевойОперацииЗамера("Расчет");
	ВремяНачалаЗамераРасчет = ОценкаПроизводительности.НачатьЗамерВремени();
	// IMDEV-8927 --
	
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	ДатаРасчета = ТекущаяДатаСеанса(); 
	ЗаполнитьДоговорыДУКРасчету();
	
	// IMDEV-8927 ++
	КоличествоДоговоровЗамера = ЭтотОбъект.ДоговорыДУКРасчету.Количество();
	// IMDEV-8927 --
	
	ПроизвестиРасчет();
	
	СформироватьИОтправитьПисьмо();
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераРасчет > 0 Тогда
		ВесЗамераРасчет = ?(КоличествоДоговоровЗамера > 0, КоличествоДоговоровЗамера, 1);
		КомментарийЗамераРасчет = "ДоговоровКРасчету=" + КоличествоДоговоровЗамера
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераРасчет, ВремяНачалаЗамераРасчет);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияРасчет,
			ВремяНачалаЗамераРасчет,
			ВесЗамераРасчет,
			КомментарийЗамераРасчет,
			Ложь);
	КонецЕсли;
	ИдентификаторКомандыДляЗамера = Неопределено;
	// IMDEV-8927 --

КонецПроцедуры

// IMDEV-8927 ++
// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Формирует имя ключевой операции БСП для замера
// по этапу обработки и контуру запуска.
//
// Параметры:
// ЭтапЗамера - Строка - этап замера (например, Расчет)
//
// Возвращаемое значение:
// Строка - имя ключевой операции в формате ДУ.РасчетВознагражденияРДУ.<Этап>.<Контур>
//
Функция ПолучитьИмяКлючевойОперацииЗамера(Знач ЭтапЗамера)
	Возврат "ДУ.РасчетВознагражденияРДУ." + ЭтапЗамера + "."
		+ ?(ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера), ИдентификаторКомандыДляЗамера, "Ручной");
КонецФункции
// IMDEV-8927 --

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьДоговорыДУКРасчету() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СпрДоговорДУ.Ссылка КАК ДоговорДУ,
		|	СпрДоговорДУ.СрокДействия КАК СрокДействияЛет
		|ПОМЕСТИТЬ ВТ_ДоговорыДУВсе
		|ИЗ
		|	Справочник.ДоговорДУ КАК СпрДоговорДУ
		|ГДЕ
		|	СпрДоговорДУ.Пул = &Пул
		|	И (СпрДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СпрДоговорДУ.ДатаОкончания > &ДатаРасчета)
		|	И СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДАТАВРЕМЯ(1, 1, 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДоговорыДУВсе.ДоговорДУ КАК ДоговорДУ,
		|	ДоговорыДУВсе.СрокДействияЛет КАК СрокДействияЛет
		|ПОМЕСТИТЬ ВТ_ДоговорыДУ
		|ИЗ
		|	ВТ_ДоговорыДУВсе КАК ДоговорыДУВсе
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОбязательстваПоДС КАК ОбязательстваПоДС
		|		ПО ДоговорыДУВсе.ДоговорДУ = ОбязательстваПоДС.ДоговорДУ
		|			И (ОбязательстваПоДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|			И (ОбязательстваПоДС.Активность = ИСТИНА)
		|			И (ОбязательстваПоДС.Регистратор ССЫЛКА Документ.ОперацияБух
		|				ИЛИ ОбязательстваПоДС.Регистратор ССЫЛКА Документ.НачислениеВознаграждения)
		|ГДЕ
		|	ОбязательстваПоДС.Регистратор ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СпрДоговорДУ.ДоговорДУ КАК ДоговорДУ,
		|	СпрДоговорДУ.СрокДействияЛет КАК СрокДействияЛет,
		|	ВводыВыводыДУ.Сумма КАК СуммаВвода,
		|	ВводыВыводыДУ.Период КАК ДатаВвода,
		|	КОНЕЦПЕРИОДА(ВводыВыводыДУ.Период, КВАРТАЛ) КАК КварталВвода
		|ИЗ
		|	ВТ_ДоговорыДУ КАК СпрДоговорДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыДУ КАК ВводыВыводыДУ
		|		ПО (ВводыВыводыДУ.ДоговорДУ = СпрДоговорДУ.ДоговорДУ)
		|			И (НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ВводыВыводыДУ.Период, ДЕНЬ, &ПериодОхлажденияДней), ДЕНЬ) <= НАЧАЛОПЕРИОДА(&ДатаРасчета, ДЕНЬ))
		|			И (ВводыВыводыДУ.Сумма > 0)
		|ГДЕ
		|	КОНЕЦПЕРИОДА(ВводыВыводыДУ.Период, КВАРТАЛ) < КОНЕЦПЕРИОДА(&ДатаРасчета, КВАРТАЛ)";
	
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("ПериодОхлажденияДней", ПериодОхлажденияДней);
	Запрос.УстановитьПараметр("Пул", Пул);
	
	ДоговорыДУКРасчету.Очистить();
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	
		ДоговорДУКРасчету = ДоговорыДУКРасчету.Добавить();
		ЗаполнитьЗначенияСвойств(ДоговорДУКРасчету, ВыборкаДетальныеЗаписи);
		ДоговорДУКРасчету.СуммаВознаграждения = Окр((ВыборкаДетальныеЗаписи.СуммаВвода / 100) * ПроцентВознаграждения * ВыборкаДетальныеЗаписи.СрокДействияЛет, 2);
	
	КонецЦикла;

КонецПроцедуры

Процедура ПроизвестиРасчет() Экспорт

	Запрос = Новый Запрос;
	
	Для Каждого ДоговорДУКРасчету Из ДоговорыДУКРасчету Цикл
	
		ОжидаемыйПлатеж = ОжидаемыеПлатежи.Найти(ДоговорДУКРасчету.ДоговорДУ, "ДоговорДУ");
		Если ОжидаемыйПлатеж <> Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		КоличествоЧастейВыплаты = КоличествоЧастейВыплаты(ДоговорДУКРасчету.ДоговорДУ);
		
		Если КоличествоЧастейВыплаты > 0 Тогда
		
			СуммаВознаграждения = ДоговорДУКРасчету.СуммаВознаграждения;
			СуммаОжидаемогоПлатежа = Окр(СуммаВознаграждения / КоличествоЧастейВыплаты, 0);
			
			Запрос.Текст = ЗапросДатыВыплат(КоличествоЧастейВыплаты);
			Запрос.УстановитьПараметр("ДатаОтсчета", ДатаРасчета);
			Результат = Запрос.Выполнить();
			
			ДатыВознаграждения = Результат.Выбрать();
			НомерПлатежа = 0;
			Пока ДатыВознаграждения.Следующий() Цикл
				НомерПлатежа = НомерПлатежа + 1;
				Если НомерПлатежа = КоличествоЧастейВыплаты Тогда
					СуммаОжидаемогоПлатежа = СуммаВознаграждения;
				КонецЕсли;
				СуммаВознаграждения = СуммаВознаграждения - СуммаОжидаемогоПлатежа;
				
				ОперацияБух = ОжидаемыйПлатеж(ДоговорДУКРасчету.ДоговорДУ, ДатыВознаграждения.ДатаВознаграждения, СуммаОжидаемогоПлатежа);
				
				ОжидаемыйПлатеж = ОжидаемыеПлатежи.Добавить();
				ОжидаемыйПлатеж.ДоговорДУ = ДоговорДУКРасчету.ДоговорДУ;
				ОжидаемыйПлатеж.ОжидаемыйПлатеж = ОперацияБух;
				ОжидаемыйПлатеж.СуммаВознаграждения = СуммаОжидаемогоПлатежа;
			
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КоличествоЧастейВыплаты(ДоговорДУ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиРасчета.ДатаНачалаРасчета КАК ДатаНачалаРасчета,
		|	НастройкиРасчета.КоличествоЧастейРасчета КАК КоличествоЧастейРасчета
		|ПОМЕСТИТЬ ВТ_НастройкиРасчета
		|ИЗ
		|	&НастройкиРасчета КАК НастройкиРасчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(НастройкиРасчета.ДатаНачалаРасчета) КАК ДатаНачалаРасчета
		|ПОМЕСТИТЬ ВТ_НастройкаРасчета
		|ИЗ
		|	ВТ_НастройкиРасчета КАК НастройкиРасчета
		|ГДЕ
		|	НастройкиРасчета.ДатаНачалаРасчета <= &ДатаНачалаДоговораДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкиРасчета.КоличествоЧастейРасчета КАК КоличествоЧастейРасчета
		|ИЗ
		|	ВТ_НастройкиРасчета КАК НастройкиРасчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НастройкаРасчета КАК НастройкаРасчета
		|		ПО НастройкиРасчета.ДатаНачалаРасчета = НастройкаРасчета.ДатаНачалаРасчета";
	
	Запрос.УстановитьПараметр("НастройкиРасчета", НастройкаРасчета.Выгрузить());
	Запрос.УстановитьПараметр("ДатаНачалаДоговораДУ", ДоговорДУ.ДатаНачала);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.КоличествоЧастейРасчета;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ЗапросДатыВыплат(КоличествоЧастейВыплаты)

	ТекстЗапросаДатыВыплат = 
		"ВЫБРАТЬ
		|	0 КАК Цифра
		|ПОМЕСТИТЬ ВТ_Цифры
		|";
	
	Если КоличествоЧастейВыплаты > 1 Тогда
		Для С_чик = 1 По КоличествоЧастейВыплаты - 1 Цикл
			ТекстЗапросаДатыВыплат = ТекстЗапросаДатыВыплат + 
				"
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	" + С_чик + "
				|";
		КонецЦикла;
	КонецЕсли;
	
	ТекстЗапросаДатыВыплат = ТекстЗапросаДатыВыплат + 
		"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(&ДатаОтсчета, КВАРТАЛ), КВАРТАЛ, ВТ_Цифры.Цифра), МЕСЯЦ), ДЕНЬ) КАК ДатаВознаграждения
		|ИЗ
		|	ВТ_Цифры КАК ВТ_Цифры
		|
		|УПОРЯДОЧИТЬ ПО
		|	Цифра";
		
	Возврат ТекстЗапросаДатыВыплат;

КонецФункции

Функция ОжидаемыйПлатеж(ДоговорДУ, ДатаВознаграждения, СуммаВознаграждения)

	ОжидаемыйПлатеж = Документы.ОперацияБух.СоздатьДокумент();
	ОжидаемыйПлатеж.Дата = ДатаВознаграждения;
	ОжидаемыйПлатеж.ДоговорДУ = ДоговорДУ;
	ОжидаемыйПлатеж.Содержание = "Ожидаемый платеж вознаграждения за управление Розничное ДУ";
	
	РегНакопления = ОжидаемыйПлатеж.ТаблицаРегистровНакопления.Добавить();
	РегНакопления.Имя = "ОбязательстваПоДС";
		
	ОжидаемыйПлатеж.Записать(РежимЗаписиДокумента.Запись);
		
	НаборЗаписей = РегистрыНакопления.ОбязательстваПоДС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ОжидаемыйПлатеж.Ссылка);
		
	Запись = НаборЗаписей.Добавить();
	Запись.ВидДвижения = ВидДвиженияНакопления.Приход;
	Запись.Регистратор = ОжидаемыйПлатеж.Ссылка;
	Запись.Период = ДатаВознаграждения;
	Запись.ДоговорДУ = ДоговорДУ;
	Запись.Валюта = Справочники.Валюты.RUB;
	
	Запись.ВалютнаяСумма = СуммаВознаграждения;
	
	НаборЗаписей.Записать();
	
	Возврат ОжидаемыйПлатеж.Ссылка;

КонецФункции

Процедура СформироватьИОтправитьПисьмо()
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
	
	ТелоПисьма = ТелоПисьма("Расчет вознаграждения розничного ДУ");
	
	Кому = Новый Массив;
	Для каждого ТекЯщик из СписокРассылки Цикл
		Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
	КонецЦикла;
	
	ФлагРезультатаВТеме = "{OK} ";
	
	ТемаСообщения = "Расчет вознаграждения розничного ДУ";
	
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ФлагРезультатаВТеме + ТемаСообщения + ПропискаРассылки("r161");
	ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
	ПараметрыПисьма.Тело = ТелоПисьма;
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
	
	РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
	
КонецПроцедуры

Функция ТелоПисьма(Заголовок)

	ТабДок = Новый ТабличныйДокумент;
	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("Макет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрокаДоговорДУ = Макет.ПолучитьОбласть("СтрокаДоговорДУ");
	ОбластьСтрокаПлатеж = Макет.ПолучитьОбласть("СтрокаПлатеж");
	
	ТабДок.Вывести(ОбластьШапка);
	
	Для каждого ДоговорДУКРасчету Из ДоговорыДУКРасчету Цикл
	
		ОбластьСтрокаДоговорДУ.Параметры.Заполнить(ДоговорДУКРасчету);
		ТабДок.Вывести(ОбластьСтрокаДоговорДУ);
		
		ПарамДоговор = Новый Структура("ДоговорДУ", ДоговорДУКРасчету.ДоговорДУ);
		СтрокиПлатеж = ОжидаемыеПлатежи.НайтиСтроки(ПарамДоговор);
		Для каждого СтрокаПлатеж Из СтрокиПлатеж Цикл
			ОбластьСтрокаПлатеж.Параметры.Заполнить(СтрокаПлатеж);
			ТабДок.Вывести(ОбластьСтрокаПлатеж);
		КонецЦикла;
	КонецЦикла;
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла(".html");
	
	ТабДок.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.HTML);
	
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу);
	СтрHTML = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	УдалитьФайлы(ПутьКФайлу);
	
	Возврат СтрHTML;

КонецФункции

Функция ПропискаРассылки(Знач НомерРассылки) 
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции

