Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение",); // МассивСтрокИмен
	ПараметрыРегистрации.Вставить("Наименование", "Загрузка котировок ц/б");
	ПараметрыРегистрации.Вставить("Версия", "2.23");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "Загрузка котировок через web-service ВТБ");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(
		ТаблицаКоманд,
		"Загрузить котировки",
		"ЗаполнитьWEB_VTB",
		"ОткрытиеФормы"
	);
	
	ДобавитьКоманду(
		ТаблицаКоманд,
		"Загрузить котировки (в фоне)",
		"ФоновоеВыполнение",
		"ВызовСерверногоМетода"
	);
	
	ДобавитьКоманду(
		ТаблицаКоманд,
		"Загрузить котировки только VTBAM-ПИФ (в фоне)",
		"ФоновоеВыполнениеVTBAMПИФ",
		"ВызовСерверногоМетода"
	);
	
	// IMAPPS-18283 ++
	ДобавитьКоманду(
		ТаблицаКоманд,
		"Старт загрузки cbonds в rates (в фоне)",
		"ФоновоеВыполнениеCBONDS",
		"ВызовСерверногоМетода"
	);
	// IMAPPS-18283 --
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
КонецФункции

Процедура ВыполнитьКоманду(Знач ИдентификаторКоманды, Знач ПараметрыВыполненияКоманды) Экспорт
	Перем РежимЗагрузки;

	// IMAPPS-18283 ++
	Если ИдентификаторКоманды = "ФоновоеВыполнениеCBONDS" Тогда
		// IMDEV-8927 ++
		ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
		КлючеваяОперацияЗагрузкаCbonds = ПолучитьИмяКлючевойОперацииЗамера("ЗагрузкаCbonds");
		ВремяНачалаЗамераЗагрузкаCbonds = ОценкаПроизводительности.НачатьЗамерВремени();
		// IMDEV-8927 --
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
		Отказ = Ложь;
		ТекстОшибки = "";
		ЗапуститьФидЗагрузкиКотировок(ДатаНачала, Отказ, ТекстОшибки);
		Если Отказ тогда
			Описание = "Ошибки выполнения:"+Символы.ПС+ ТекстОшибки;
			ЗавершеноСОшибками = Истина;
		Иначе
			Описание = "Загрузка успешна";
			ЗавершеноСОшибками = Ложь;
		КонецЕсли;
		текстРассылки = РассылкаСообщения(
		"Аванкор ДУ: Загрузка котировок cbonds за " + Формат(ДатаНачала, "ДФ=yyyy-MM-dd; ДП="),
		Описание,
		ЗавершеноСОшибками,
		РежимЗагрузки
		);
		// IMDEV-8927 ++
		Если ВремяНачалаЗамераЗагрузкаCbonds > 0 Тогда
			КомментарийЗамераЗагрузкаCbonds = ?(Отказ, "Ошибка: " + ТекстОшибки, "Загрузка успешна")
				+ ДополнениеКомментарияУдельныйВес(1, ВремяНачалаЗамераЗагрузкаCbonds);
			ОценкаПроизводительности.ЗакончитьЗамерВремени(
				КлючеваяОперацияЗагрузкаCbonds,
				ВремяНачалаЗамераЗагрузкаCbonds,
				1,
				КомментарийЗамераЗагрузкаCbonds,
				Отказ
			);
		КонецЕсли;
		ИдентификаторКомандыДляЗамера = Неопределено;
		// IMDEV-8927 --
		Возврат;
	КонецЕсли;
	// IMAPPS-18283 --
		
	РежимЗагрузки = "";
	Если ИдентификаторКоманды = "ФоновоеВыполнение" Тогда
		РежимЗагрузки = "Общая";
		
	ИначеЕсли ИдентификаторКоманды = "ФоновоеВыполнениеVTBAMПИФ" Тогда
		РежимЗагрузки = "ТолькоVTBAMПИФ";
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РежимЗагрузки) Тогда
		Возврат;
	КонецЕсли;
	
	// IMDEV-8927 ++
	ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
	// IMDEV-8927 --
	
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	ДопОбработка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
	
	Задача = Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
	Задача.Дата 			= ТекущаяДата();
	Задача.ВидОбмена 		= ДопОбработка;
	Задача.ВерсияОбработки 	= ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДопОбработка, "Версия");
	Задача.Наименование 	= "Загрузка котровок ц/б";
	Задача.ПараметрыВыполнения = ПредставлениеНастроек;
	
	Отказ = Ложь;
	ТекстОшибки = "";
	
	ЗагрузитьОбъекты(Отказ, ТекстОшибки, РежимЗагрузки);
	СоздатьОбъекты(Отказ, ТекстОшибки, РежимЗагрузки);
	
	Задача.Описание = "";
	Задача.ХранилищеЛога = Новый ХранилищеЗначения(Лог, Новый СжатиеДанных(9));
	
	Если Отказ тогда
		Задача.Описание = "Ошибки выполнения:"+Символы.ПС+ ТекстОшибки;
		Задача.ЗавершеноСОшибками = Истина;
	Иначе
		Задача.Описание = "Загрузка успешна";
		Задача.ЗавершеноСОшибками = Ложь;
	КонецЕсли;
	
	текстРассылки = РассылкаСообщения(
		"Аванкор ДУ: Загрузка котировок ц/б с " + Формат(ДатаНачала, "ДФ=yyyy-MM-dd; ДП=") + " по " + Формат(ДатаОкончания, "ДФ=yyyy-MM-dd; ДП="),
		Задача.Описание,
		Задача.ЗавершеноСОшибками,
		РежимЗагрузки
	);
	
	Задача.Описание = Задача.Описание + Символы.ПС + текстРассылки;
	Задача.ДатаИсполнения = ТекущаяДата();
	Задача.ВыполнитьЗадачу();
	
	// IMDEV-8927 ++
	ИдентификаторКомандыДляЗамера = Неопределено;
	// IMDEV-8927 --
	
КонецПроцедуры

// IMDEV-8927 ++
// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Формирует имя ключевой операции БСП для замера
// по этапу обработки и контуру запуска.
//
// Параметры:
// ЭтапЗамера - Строка - этап замера (например, ПолучениеTibco, СозданиеКотировок)
//
// Возвращаемое значение:
// Строка - имя ключевой операции в формате ДУ.ЗагрузкаКотировок.<Этап>.<Контур>
//
Функция ПолучитьИмяКлючевойОперацииЗамера(Знач ЭтапЗамера)
	Возврат "ДУ.ЗагрузкаКотировок." + ЭтапЗамера + "."
		+ ?(ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера), ИдентификаторКомандыДляЗамера, "Ручной");
КонецФункции
// IMDEV-8927 --

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") тогда
		ОбработкаЗагрузкиАктивов = Настройки.Значения.ОбработкаЗагрузкиАктивов;
		КомандаЗагрузкиАктивов = Настройки.Значения.КомандаЗагрузкиАктивов;
		ТестовыйРежим = Настройки.Значения.ТестовыйРежим;
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) тогда
			ПочтовыйЛогин = Почта;
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки);
			СписокРассылки.Загрузить(Ящики.Получить());
		КонецЕсли;
		
		Если НЕ Настройки.Значения.Свойство("INTERFAX", INTERFAX) тогда
			INTERFAX = Ложь;
		КонецЕсли;
		
		Если НЕ Настройки.Значения.Свойство("MOEX_BMBRG", MOEX_BMBRG) тогда
			MOEX_BMBRG = Ложь;
		КонецЕсли;		
		
		ПредставлениеНастроек = "Период с:"+Формат(ДатаНачала,"ДФ=dd.MM.yyyy") + " по:"+Формат(ДатаОкончания,"ДФ=dd.MM.yyyy") + " ";
	КонецЕсли;
	
КонецПроцедуры

// IMAPPS-18283 ++
Процедура ЗапуститьФидЗагрузкиКотировок(НаДату, Отказ, ТекстОшибки) Экспорт 
	
	//АдресСервера = "DMSK6292";
	//АдресСервера = "smsk02ap209u";
	АдресСервера = "AMAPTIBCO";
	Путь = "/cbonds-marketdata?"+Формат(НаДату, "ДФ=yyyy-MM-dd");
	
	Линк = Новый HTTPСоединение(АдресСервера, 8899);
	Запрос = Новый HTTPЗапрос(Путь); 
	Попытка
		Результат  =  Линк.Получить(Запрос);
		ТекстОшибки = Результат.ПолучитьТелоКакСтроку();
	Исключение
		ТекстОшибки = "Ошибка выполнения: Не выполнен запрос " + АдресСервера + Путь + Символы.ПС + ОписаниеОшибки();
		Отказ = Истина;
	КонецПопытки;
	
КонецПроцедуры
// IMAPPS-18283 --

Функция ЗагрузитьОбъекты(Отказ=Ложь, ТекстОшибки="", Знач РежимЗагрузки = "Общая") Экспорт
	
	// IMDEV-8927 ++
	ВремяНачалаЗамераПолученияКотировок = 0;
	КлючеваяОперацияПолучениеКотировок = ПолучитьИмяКлючевойОперацииЗамера("ПолучениеTibco");
	ВремяНачалаЗамераПолученияКотировок = ОценкаПроизводительности.НачатьЗамерВремени();
	// IMDEV-8927 --
	
	Лог = Новый ТабличныйДокумент;
	СписокЗагрузки.Очистить();
	
	Ошибка = Макет.ПолучитьОбласть("Ошибка");
	Заголовок = Макет.ПолучитьОбласть("Заголовок");
	Лог.Вывести(Заголовок);
	
	Шапка 	= Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.ДатаНачала 			= ДатаНачала;
	Шапка.Параметры.ДатаОкончания 		= ДатаОкончания;
	Шапка.Параметры.ДатаФормирования 	= ТекущаяДата();
	Лог.Вывести(Шапка);
	
	ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	Лог.Вывести(ЗаголовокТаблицы);
	
	ОсновноеПространствоИмен = "http://www.avancore.ru/quotes"; 
	ПолноеИмяФайлаWSDL = ПолучитьИмяВременногоФайла("wsdl");
	
	ФайлWSDL = ПолучитьМакет("WSDL");
	ФайлWSDL.Записать(ПолноеИмяФайлаWSDL);
	
	Попытка
		//Определение = Новый WSОпределения(ПолноеИмяФайлаWSDL);
		Определение = Новый WSОпределения("http://amaptibco:8882/");
		//Определение = Новый WSОпределения("http://smsk02ap209u:8882/");
		//Определение = Новый WSОпределения("http://dmsk6023:8882/");
		
		Фабрика = Определение.ФабрикаXDTO;
		
		Корень_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "Корень");
		Условия_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "УсловиеКотировок");
		
		Если MOEX_BMBRG Тогда
			
			Корень 		= Фабрика.Создать(Корень_ТИП);
			Условия 	= Фабрика.Создать(Условия_ТИП);	
		
			Условия.DateFrom	 = ДатаНачала;
			Условия.DateTo		 = ДатаОкончания;
			Условия.StockCode	 = StockCode(Актив, РежимЗагрузки);
			
			Корень.УсловиеКотировок = Условия;
			
			Если ТестовыйРежим тогда
				Ответ  = ТестоваяЗагрузка(Фабрика, Корень_ТИП);
			Иначе
				Ответ = ЗагрузкаЧерезСервис(Определение, Корень);
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		ТекстОшибки = "Ошибка подключения:"+ОписаниеОшибки();
		сообщить(ТекстОшибки);
		Отказ = Истина;
		
		Ошибка.Параметры.ОписаниеОшибки = ТекстОшибки;
		Лог.Вывести(Ошибка);
		
	КонецПопытки;
	
	Если Отказ=Истина тогда 
		// IMDEV-8927 ++
		Если ВремяНачалаЗамераПолученияКотировок > 0 Тогда
			ОценкаПроизводительности.ЗакончитьЗамерВремени(
				КлючеваяОперацияПолучениеКотировок,
				ВремяНачалаЗамераПолученияКотировок,
				1,
				"Ошибка подключения к Tibco",
				Истина
			);
		КонецЕсли;
		// IMDEV-8927 --
		возврат Лог;
	КонецЕсли;
	
	Если MOEX_BMBRG Тогда
		ПрочитатьКотировки(Ответ.ДокументКотировок);
	КонецЕсли;
	
	Попытка
		
		Если Не MOEX_BMBRG Тогда
		
			Корень 		= Фабрика.Создать(Корень_ТИП);
			Условия 	= Фабрика.Создать(Условия_ТИП);
			
			Условия.DateFrom	 = ДатаНачала;
			Условия.DateTo		 = ДатаОкончания;
			Условия.StockCode	 = StockCode(Актив, РежимЗагрузки);
			
			Корень.УсловиеКотировок = Условия;
		
		КонецЕсли;
		
		Ответ = ЗагрузкаЧерезСервис2(Определение, Корень);
	Исключение
		ТекстОшибки = "Ошибка подключения:"+ОписаниеОшибки();
		сообщить(ТекстОшибки);
		Отказ = Истина;
		
		Ошибка.Параметры.ОписаниеОшибки = ТекстОшибки;
		Лог.Вывести(Ошибка);
		
	КонецПопытки;
	
	Если НЕ Отказ = Истина Тогда
		ПрочитатьКотировки(Ответ.ДокументКотировок, Истина);
	КонецЕсли;
	
	// MPazhukov IMDEV-3371
	Если INTERFAX и не Отказ 
		//VTBC SadykovNiyaz 29.04.2022 (IMAPPS-17285) {
		И НЕ РежимЗагрузки = "ТолькоVTBAMПИФ"
		//VTBC SadykovNiyaz 29.04.2022 (IMAPPS-17285) }
		Тогда
		
		ТаблицаИнтерфакс = СписокЗагрузки.Выгрузить();
		ТаблицаИнтерфакс.Очистить();
		ТаблицаИнтерфакс.Колонки.Добавить("Валюта_Код", ОбщегоНазначения.ОписаниеТипаСтрока(3));
		
		Выборка = ВыборкаСписокISIN(Актив);
		
		ПакетИнтерфакс = Фабрика.Создать(Корень_ТИП);
		ПакетИнтерфакс.УсловиеКотировок = Фабрика.Создать(Условия_ТИП);
		
		ПакетИнтерфакс.УсловиеКотировок.DateFrom = ДатаНачала;
		ПакетИнтерфакс.УсловиеКотировок.DateTo = ДатаОкончания;
		Пока Выборка.Следующий() Цикл
			ПакетИнтерфакс.УсловиеКотировок.ISIN.Добавить(Выборка.ISIN);
		КонецЦикла;
		
		Прокси = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
		
		Прокси.IFXStockPrice(ПакетИнтерфакс);
	
		ПрочитатьКотировкиИнтерфакс(ПакетИнтерфакс.ДокументКотировок, ТаблицаИнтерфакс, Отказ);
		
		ДобавитьКотировкиИнтерфаксВОбщийСписок(ТаблицаИнтерфакс, Отказ);
		
	КонецЕсли;
	// MPazhukov IMDEV-3371
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераПолученияКотировок > 0 Тогда
		КоличествоКотировок = СписокЗагрузки.Количество();
		ВесЗамераПолученияКотировок = ?(КоличествоКотировок > 0, КоличествоКотировок, 1);
		КомментарийЗамераПолученияКотировок = "Котировок=" + КоличествоКотировок
			+ "; Отказ=" + ?(Отказ, "Да", "Нет")
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераПолученияКотировок, ВремяНачалаЗамераПолученияКотировок);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияПолучениеКотировок,
			ВремяНачалаЗамераПолученияКотировок,
			ВесЗамераПолученияКотировок,
			КомментарийЗамераПолученияКотировок,
			Отказ
		);
	КонецЕсли;
	// IMDEV-8927 --
	
КонецФункции

Процедура СоздатьОбъекты(Отказ = Ложь, ТекстОшибки = "", Знач РежимЗагрузки = "Общая") Экспорт
	Перем НакопительДляСверки, КотировкиДляСверки;
	Перем МассивАктивов;
	
	ЭтотОбъект.ЛогИзменений.Очистить();
	ЭтотОбъект.ЕстьРасхожденияКотировок = Ложь;
	
	Если Отказ тогда
		Возврат;
	КонецЕсли;
	
	// IMDEV-8927 ++
	ВремяНачалаЗамераСозданияКотировок = 0;
	КлючеваяОперацияСозданиеКотировок = ПолучитьИмяКлючевойОперацииЗамера("СозданиеКотировок");
	ВремяНачалаЗамераСозданияКотировок = ОценкаПроизводительности.НачатьЗамерВремени();
	КоличествоКСозданию = ЭтотОбъект.СписокЗагрузки.Количество();
	КоличествоСозданныхДокументов = 0;
	// IMDEV-8927 --
	
	ЗаголовоДокументов = Макет.ПолучитьОбласть("ЗаголовокКСозданиюДокументов");
	Лог.Вывести(ЗаголовоДокументов);
	СтрокаЛога = Макет.ПолучитьОбласть("СтрокаДокументов");
	
	МассивУдаления = Новый Массив();
	
	МассивАктивов = Неопределено;
	Если РежимЗагрузки = "ТолькоVTBAMПИФ" Тогда
		МассивАктивов = Новый Массив();
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивАктивов, ЭтотОбъект.СписокЗагрузки.Выгрузить(, "Актив").ВыгрузитьКолонку("Актив"), Истина);
		
	ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Актив) Тогда
		МассивАктивов = Новый Массив();
		МассивАктивов.Добавить(ЭтотОбъект.Актив);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Источник", ЭтотОбъект.СписокЗагрузки.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ Котировки
	|ИЗ
	|	&Источник КАК Источник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	Котировки КАК Котировки
	|ИТОГИ
	|	
	|ПО
	|	Котировки.Дата,
	|	Котировки.Биржа";
	
	НакопительДляСверки = Новый Соответствие();
	
	ГруппаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ГруппаДата.Следующий() Цикл
		
		ГРуппаБиржи = ГруппаДата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ГруппаБиржи.Следующий() Цикл
			Если ГРуппаБиржи.биржа.Пустая() Тогда
				Продолжить;
			КонецЕсли;
			
			Док = КотировкиПоБиржеИДате(ГРуппаБиржи.Биржа, ГруппаДата.Дата, МассивАктивов);
			
			КотировкиДляСверки = ПолучитьКотировкиДоИзменений(Док.Ссылка, МассивАктивов);
			
			Детали = ГРуппаБиржи.Выбрать();
			Пока Детали.Следующий() Цикл
				Если Детали.Актив.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = Док.Котировки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Детали);
				
				НоваяСтрока.Валюта		 = Детали.ВалютаКотировки;
				НоваяСтрока.ЦенаСпроса	 = Детали.BID;          // DV 15/04/14
				НоваяСтрока.ЦБ			 = Детали.Актив;
					
				// MPazhukov IMDEV-3372 + IMDEV-3416
				Если СтрНайти(Детали.Биржа_Код, "CBONDS") Тогда
					НоваяСтрока.CLOSEPERIOD = Детали.LASTPRICE;		
				КонецЕсли;
				Попытка
					 а = Число(Детали.Биржа_Код); 
					 НоваяСтрока.CLOSEPERIOD = Детали.LASTPRICE;
				Исключение					
				КонецПопытки;
				// MPazhukov IMDEV-3372 + IMDEV-3416				
				
				Если КотировкиДляСверки <> Неопределено Тогда
					НоваяСтрокаСверка = КотировкиДляСверки.Добавить();
					НоваяСтрокаСверка.Актив							 = Детали.Актив;
					НоваяСтрокаСверка.ПризнаваемаяКотировка_Стало	 = Детали.ПризнаваемаяКотировка;
					//НоваяСтрокаСверка.ПризнаваемаяКотировка			 = НоваяСтрокаСверка.ПризнаваемаяКотировка;  // старую котировку не трогаем
					НоваяСтрокаСверка.ПризнаваемаяКотировка_Маркер	 = 1;
				КонецЕсли;
			КонецЦикла;
			
			Если Док.Котировки.Количество() = 0 тогда
				Продолжить;
			КонецЕсли;
			
			Отказ = Ложь;
			
			Попытка 
				Док.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Отказ 		= Истина;
				ТекстОшибки = "Не удалось провести:"+ Док+ " Документ будет записан";
				
				Док.записать(РежимЗаписиДокумента.Запись);
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.КлючДанных = Док.Ссылка;
				Сообщение.Сообщить();
			КонецПопытки;
			
			Если НЕ Отказ И КотировкиДляСверки <> Неопределено Тогда
				КотировкиДляСверки.Свернуть("Актив", "ПризнаваемаяКотировка, ПризнаваемаяКотировка_Стало, ПризнаваемаяКотировка_Маркер");
				КотировкиДляСверки.Колонки.Добавить("ПризнаваемаяКотировка_Расхождения", Новый ОписаниеТипов("Булево"));
				КотировкиДляСверки.Сортировать("Актив");
				
				Для Каждого ТекСтрока Из КотировкиДляСверки Цикл
					ТекСтрока.ПризнаваемаяКотировка_Расхождения = НЕ (ТекСтрока.ПризнаваемаяКотировка = ТекСтрока.ПризнаваемаяКотировка_Стало);
				КонецЦикла;
				
				РасхожденияКотировок = КотировкиДляСверки.Скопировать(
					Новый Структура("ПризнаваемаяКотировка_Расхождения, ПризнаваемаяКотировка_Маркер", Истина, 0),
					"Актив, ПризнаваемаяКотировка, ПризнаваемаяКотировка_Стало"
				);
				
				НакопительДляСверки.Вставить(Док.Ссылка, РасхожденияКотировок);
				
				Если РасхожденияКотировок.Количество() > 0 Тогда
					ЭтотОбъект.ЕстьРасхожденияКотировок = Истина;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаЛога.Параметры.Документ = Док.Ссылка;
			
			Лог.Вывести(СтрокаЛога);
			
			// IMDEV-8927 ++
			КоличествоСозданныхДокументов = КоличествоСозданныхДокументов + 1;
			// IMDEV-8927 --
		КонецЦикла;
	КонецЦикла;
	
	Если НакопительДляСверки.Количество() > 0 Тогда
		МакетИзменений = ЭтотОбъект.ПолучитьМакет("ИзмененияКотировок");
		
		ШапкаОбласть	 = МакетИзменений.ПолучитьОбласть("Шапка");
		СтрокаОбласть	 = МакетИзменений.ПолучитьОбласть("СтрокаТаблицы");
		
		ЭтотОбъект.ЛогИзменений.Вывести(ШапкаОбласть);
		
		Для Каждого ТекНакопитель Из НакопительДляСверки Цикл
			РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекНакопитель.Ключ, "Дата, Биржа");
			
			Для Каждого ТекРасхождение Из ТекНакопитель.Значение Цикл
				СтрокаОбласть.Параметры.Дата	 = РеквизитыДокумента.Дата;
				СтрокаОбласть.Параметры.Биржа	 = РеквизитыДокумента.Биржа;
				СтрокаОбласть.Параметры.Документ = ТекНакопитель.Ключ;
				
				СтрокаОбласть.Параметры.Актив						 = ТекРасхождение.Актив;
				СтрокаОбласть.Параметры.ПризнаваемаяКотировка_Было	 = ТекРасхождение.ПризнаваемаяКотировка;
				СтрокаОбласть.Параметры.ПризнаваемаяКотировка_Стало	 = ТекРасхождение.ПризнаваемаяКотировка_Стало;
				
				ЭтотОбъект.ЛогИзменений.Вывести(СтрокаОбласть);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	СписокЗагрузки.Очистить();
	
	Сообщить("Создание документов завершено", СтатусСообщения.Информация);
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераСозданияКотировок > 0 Тогда
		ВесЗамераСозданияКотировок = ?(КоличествоСозданныхДокументов > 0, КоличествоСозданныхДокументов, 1);
		КомментарийЗамераСозданияКотировок = "КСозданию=" + КоличествоКСозданию
			+ "; Создано=" + КоличествоСозданныхДокументов
			+ "; Ошибок=" + ?(Отказ, "Да", "Нет")
			+ ДополнениеКомментарияУдельныйВес(ВесЗамераСозданияКотировок, ВремяНачалаЗамераСозданияКотировок);
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			КлючеваяОперацияСозданиеКотировок,
			ВремяНачалаЗамераСозданияКотировок,
			ВесЗамераСозданияКотировок,
			КомментарийЗамераСозданияКотировок,
			Отказ
		);
	КонецЕсли;
	// IMDEV-8927 --
	
КонецПроцедуры

#КонецОбласти

