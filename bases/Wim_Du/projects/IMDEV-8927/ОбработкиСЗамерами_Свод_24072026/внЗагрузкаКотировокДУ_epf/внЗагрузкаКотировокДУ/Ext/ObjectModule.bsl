Функция УровеньПоКодуИзКэша(КэшУровней, Знач КодУровня)
	Перем Уровень;
	
	Уровень = КэшУровней[КодУровня];
	Если Уровень = Неопределено Тогда
		Уровень = УровеньПоКоду(КодУровня);
		
		КэшУровней[КодУровня] = Уровень;
	КонецЕсли;
	
	Возврат Уровень;
КонецФункции // УровеньПоКодуИзКэша()
