Функция ПолучитьТаблицуТикеров(Знач ДокументыКотировок)
	Перем ТаблицаТикеров, Результат, Запрос;
	Перем БиржаКод, Тикер, ВидыБирж;
	
	ТаблицаТикеров = Новый ТаблицаЗначений();
	ТаблицаТикеров.Колонки.Добавить("БиржаКод", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаТикеров.Колонки.Добавить("Тикер", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаТикеров.Колонки.Добавить("КодЦБ", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаТикеров.Колонки.Добавить("ВидБиржи", ОбщегоНазначения.ОписаниеТипаСтрока(13));
	ТаблицаТикеров.Колонки.Добавить("ВерсияНРД", ОбщегоНазначения.ОписаниеТипаЧисло(1, 0));
	
	ВидыБирж = Новый Структура(
		"РасчетныеНРД, BBG, BVAL, Остальные", 
		"Расчетные_НРД",
		"BBG_EXCH",
		"BBG_BVAL",
		"Остальные"
	);
	
	Для Каждого ТекДок Из ДокументыКотировок Цикл
		БиржаКод = СокрП(ТекДок.Биржа.Наименование);
		
		Для Каждого ТекКотировка Из ТекДок.Состав.СтрокаКотировок Цикл
			Тикер = СокрП(ТекКотировка.Актив.КодЦБнаММВБ);
			
			ДополнитьТаблицуТикеров(ТаблицаТикеров, БиржаКод, Тикер, ВидыБирж);
		КонецЦикла;
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаТикеров", ТаблицаТикеров);
	Запрос.УстановитьПараметр("ВидБиржи_Остальные", ВидыБирж.Остальные);
	Запрос.УстановитьПараметр("ВидБиржи_РасчетныеНРД", ВидыБирж.РасчетныеНРД);
	Запрос.УстановитьПараметр("ВидБиржи_BBG", ВидыБирж.BBG);
	Запрос.УстановитьПараметр("ВидБиржи_BVAL", ВидыБирж.BVAL);
	Запрос.УстановитьПараметр("Биржа_BBG", Справочники.Биржи.ПолучитьСсылку(Новый УникальныйИдентификатор("4212877d-f279-11e5-9c8c-005056b100fc")));
	Запрос.УстановитьПараметр("Биржа_BVAL", Справочники.Биржи.ПолучитьСсылку(Новый УникальныйИдентификатор("886a3ba5-43a1-11ed-80ed-005056b100fc")));
	Запрос.УстановитьПараметр("Биржа_НРД", Справочники.Биржи.ПолучитьСсылку(Новый УникальныйИдентификатор("724d55a8-05c7-11e8-9140-005056b100fc")));
	Запрос.УстановитьПараметр("Биржа_НРД2", Справочники.Биржи.ПолучитьСсылку(Новый УникальныйИдентификатор("daeab02c-2d0f-11ed-80ed-005056b100fc")));
	Запрос.УстановитьПараметр("Биржа_Пустая", Справочники.Биржи.ПустаяСсылка());
	Запрос.Текст ="ВЫБРАТЬ РАЗЛИЧНЫЕ
	              |	ТаблицаТикеров.БиржаКод КАК БиржаКод,
	              |	ТаблицаТикеров.Тикер КАК Тикер,
	              |	ТаблицаТикеров.КодЦБ КАК КодЦБ,
	              |	ТаблицаТикеров.ВидБиржи КАК ВидБиржи,
	              |	ТаблицаТикеров.ВерсияНРД КАК ВерсияНРД
	              |ПОМЕСТИТЬ втТаблицаТикеров
	              |ИЗ
	              |	&ТаблицаТикеров КАК ТаблицаТикеров
	              |
	              |ИНДЕКСИРОВАТЬ ПО
	              |	КодЦБ,
	              |	ВидБиржи,
	              |	БиржаКод
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ РАЗЛИЧНЫЕ
	              |	Выборка.Тикер КАК Тикер,
	              |	Выборка.КодЦБ КАК КодЦБ,
	              |	Активы.Ссылка КАК Актив,
	              |	Выборка.БиржаКод КАК БиржаКод,
	              |	Выборка.БиржаЛистинга КАК БиржаЛистинга
