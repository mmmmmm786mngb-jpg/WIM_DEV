Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
//	IMAPPS-1006
//	ДатаНачала 		= НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(,ТекущаяДата(),-1));
	Если ДеньНедели(ТекущаяДата()) = 1 Тогда
		ДатаНачала 		= НачалоДня(ТекущаяДата()-60*60*72);
		ДатаОкончания 	= КонецДня(ДатаНачала);
	Иначе
		ДатаНачала 		= НачалоДня(ТекущаяДата()-60*60*24);
		ДатаОкончания 	= КонецДня(ДатаНачала);
	КонецЕсли;
	// ПараметрыВыполненияКоманды = Новый Структура();
	//ПараметрыВыполненияКоманды.Вставить("ДополнительнаяОбработкаСсылка", ВнешняяОбработкаСсылка);
	//ПараметрыВыполненияКоманды.Вставить("ПараметрыДополнительнойОбработки",Справочники.ДополнительныеОтчетыИОбработки.НастройкиОбработки(ВнешняяОбработкаСсылка));
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек,ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции

Функция АктивыПоТикеру(Знач КодЦБ, БиржаКод = "")
	Перем Запрос;   
	
	//IMAPPS-31547 ++
	Если Найти(ВРег(КодЦБ), "НРД2") > 0 Тогда
		Биржа_НРД = Справочники.Биржи.ПолучитьСсылку(Новый УникальныйИдентификатор("724d55a8-05c7-11e8-9140-005056b100fc"));  // "Расчетный центр НРД2"
		КодЦБНРД = Лев(КодЦБ, СтрДлина(КодЦБ) - 4); 
		
	ИначеЕсли Найти(ВРег(КодЦБ), "НРД") > 0 Тогда
		Биржа_НРД = Справочники.Биржи.ПолучитьСсылку(Новый УникальныйИдентификатор("daeab02c-2d0f-11ed-80ed-005056b100fc"));  // "Расчетный центр НРД"
		КодЦБНРД = Лев(КодЦБ, СтрДлина(КодЦБ) - 4); 
	Иначе
		Биржа_НРД = Справочники.Биржи.ПустаяСсылка();
	КонецЕсли;
	//IMAPPS-31547--
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("КодЦБ", ПолучитьМассивКодовЦБ(КодЦБ));
	// MPazhukov IMDEV-3396	
	Если Найти(БиржаКод,"CBONDS")>0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Активы.Ссылка.Объект КАК Актив,
		|	Активы.Объект.ISIN КАК КодЦБ,
		|	Биржи.Ссылка КАК БиржаЛистинга
		|ИЗ
		|	Справочник.Активы КАК Активы,
		|	Справочник.Биржи КАК Биржи
		|ГДЕ
		|	Активы.ПометкаУдаления = ЛОЖЬ
		|	И Активы.Объект.ISIN = &КодЦБ
		|	И Биржи.Наименование = &БиржаКод";	
		Запрос.УстановитьПараметр("БиржаКод", БиржаКод);
		Запрос.УстановитьПараметр("КодЦБ", КодЦБ);
	// MPazhukov IMDEV-3396
    ИначеЕсли Найти(ВРег(БиржаКод), ВРег("РасчетныеНРД")) > 0 Тогда //IMAPPS-31547 ++
	
	    Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Активы.Ссылка.Объект КАК Актив,
		|	Активы.Объект.ISIN КАК КодЦБ,
		|	&БиржаНРД КАК БиржаЛистинга
		|ИЗ
		|	Справочник.Активы КАК Активы
		|ГДЕ
		|	НЕ Активы.ПометкаУдаления
		|	И Активы.Объект.ISIN = &КодЦБ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Актив,
		|	КодЦБ,
		|	БиржаЛистинга";
		
		Запрос.УстановитьПараметр("КодЦБ", КодЦБНРД);
		Запрос.УстановитьПараметр("БиржаНРД", Биржа_НРД)
	//IMAPPS-31547 --	
	Иначе		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АкцииБиржиЛистинга.Ссылка КАК Актив,
		|	АкцииБиржиЛистинга.КодЦБ КАК КодЦБ,
		|	АкцииБиржиЛистинга.БиржаЛистинга КАК БиржаЛистинга
		|ИЗ
		|	Справочник.Акции.БиржиЛистинга КАК АкцииБиржиЛистинга
		|ГДЕ
		|	АкцииБиржиЛистинга.КодЦБ В(&КодЦБ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ОблигацииБиржиЛистинга.Ссылка,
		|	ОблигацииБиржиЛистинга.КодЦБ,
		|	ОблигацииБиржиЛистинга.БиржаЛистинга
		|ИЗ
		|	Справочник.Облигации.БиржиЛистинга КАК ОблигацииБиржиЛистинга
		|ГДЕ
		|	ОблигацииБиржиЛистинга.КодЦБ В(&КодЦБ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ПаиПИФБиржиЛистинга.Ссылка,
		|	ПаиПИФБиржиЛистинга.КодЦБ,
		|	ПаиПИФБиржиЛистинга.БиржаЛистинга
		|ИЗ
		|	Справочник.ПаиПИФ.БиржиЛистинга КАК ПаиПИФБиржиЛистинга
		|ГДЕ
		|	ПаиПИФБиржиЛистинга.КодЦБ В(&КодЦБ)";
	КонецЕсли;	
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Возврат Выборка;
КонецФункции // АктивыПоТикеру()

