Функция КотировкиПоБиржеИДате(Знач Биржа, Знач Дата, Знач МассивАктивов = Неопределено)
	Перем Запрос, Результат, Выборка;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Биржа", Биржа);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КотировкиЦБНаБирже.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КотировкиЦБНаБирже КАК КотировкиЦБНаБирже
	|ГДЕ
	|	КотировкиЦБНаБирже.Биржа = &Биржа
	|	И КотировкиЦБНаБирже.Дата >= НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	|	И КотировкиЦБНаБирже.Дата < НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, ДЕНЬ, 1), ДЕНЬ)
	|	И НЕ КотировкиЦБНаБирже.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	КотировкиЦБНаБирже.Дата,
	|	Ссылка";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		НовыйДок = Документы.КотировкиЦБНаБирже.СоздатьДокумент();
		НовыйДок.Дата	 = Дата;
		НовыйДок.Биржа	 = Биржа;
		
		Возврат НовыйДок;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	// DV 29/04/14
	Если ЗначениеЗаполнено(ЭтотОбъект.Актив) Тогда
		Возврат DV_UpdateDoc(ЭтотОбъект.Актив, Выборка.Ссылка);
		
	ИначеЕсли МассивАктивов <> Неопределено Тогда
		ДокументТочечнойПравки = Неопределено;
		
		Для Каждого ТекАктив Из МассивАктивов Цикл
			ДокументТочечнойПравки = DV_UpdateDoc(ТекАктив, Выборка.Ссылка);
		КонецЦикла;
		
		Если ДокументТочечнойПравки = Неопределено Тогда
			ДокументТочечнойПравки = Документы.КотировкиЦБНаБирже.СоздатьДокумент();
			ДокументТочечнойПравки.Дата	 = Дата;
			ДокументТочечнойПравки.Биржа = Биржа;
		КонецЕсли;
		
		Возврат ДокументТочечнойПравки;
	КонецЕсли;
	
	Док = Выборка.Ссылка.ПолучитьОбъект();
	Док.Котировки.Очистить();
	
	Возврат Док;
КонецФункции // КотировкиПоБиржеИДате()

Функция УровеньПоКоду(Код)
	
	Если НЕ ЗначениеЗаполнено(Код) тогда Возврат Справочники.УровниКотировальногоЛиста.ПустаяСсылка() КонецЕсли;
	
	Элемент =  Справочники.УровниКотировальногоЛиста.НайтиПоКоду(Код,Истина);
	Если Элемент.Пустая() тогда
		НовыйЭлемент = Справочники.УровниКотировальногоЛиста.СоздатьЭлемент();
		НовыйЭлемент.Код = Код;
		НовыйЭлемент.Записать();
		Элемент = НовыйЭлемент.Ссылка;
	КонецЕсли;
	
	Возврат Элемент;
КонецФункции

