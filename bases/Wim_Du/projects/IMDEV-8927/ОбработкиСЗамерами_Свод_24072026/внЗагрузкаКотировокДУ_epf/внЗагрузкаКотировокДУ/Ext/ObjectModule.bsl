	              |		НЕ ПаиПИФ.ПометкаУдаления) КАК Выборка
	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
	              |		ПО (Активы.Объект = Выборка.Бумага)
	              |ГДЕ
	              |	Выборка.БиржаЛистинга.Ссылка ЕСТЬ НЕ NULL 
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Тикер,
	              |	КодЦБ,
	              |	Актив,
	              |	БиржаКод,
	              |	БиржаЛистинга
	              |АВТОУПОРЯДОЧИВАНИЕ" ;
	
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Индексы.Добавить("Тикер, БиржаКод");
	
	Возврат Результат;
КонецФункции // ПолучитьТаблицуТикеров()

Процедура ДополнитьТаблицуТикеров(ТаблицаТикеров, Знач БиржаКод, Знач Тикер, Знач ВидыБирж)
	Перем ВидБиржи, МассивКодовЦБ, ВерсияНРД;
	
	ВерсияНРД = 0;
	Если СтрНайти(ВРег(БиржаКод), ВРег("РасчетныеНРД")) > 0 Тогда
		ВидБиржи		 = ВидыБирж.РасчетныеНРД;
		МассивКодовЦБ	 = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрЗаменить(СтрЗаменить(Тикер, "НРД2", ""), "НРД", ""));
		ВерсияНРД		 = ?(СтрНайти(ВРег(Тикер), "НРД2") > 0, 2, 1);
		
	ИначеЕсли СтрНайти(ВРег(Тикер), "@EXCH") > 0 ИЛИ СтрНайти(ВРег(Тикер), "@FRNK") > 0 ИЛИ СтрНайти(ВРег(Тикер), "@STGT") > 0 ИЛИ СтрНайти(ВРег(Тикер), "@MICB") > 0 ИЛИ СтрНайти(ВРег(Тикер), "@LUX") > 0 Тогда
		ВидБиржи		 = ВидыБирж.BBG;
		МассивКодовЦБ	 = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Лев(Тикер, СтрНайти(Тикер, "@") - 1));
		
	ИначеЕсли СтрНайти(ВРег(Тикер), ВРег("@BVAL Corp")) > 0 Тогда
		ВидБиржи		 = ВидыБирж.BVAL;
		МассивКодовЦБ	 = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Лев(Тикер, СтрНайти(ВРег(Тикер), "@BVAL") - 1));
		
	Иначе  // Остальные
		ВидБиржи		 = ВидыБирж.Остальные;
		МассивКодовЦБ	 = ПолучитьМассивКодовЦБ(Тикер);
		
	КонецЕсли;
	
	Для Каждого ТекКодЦБ Из МассивКодовЦБ Цикл
		НоваяСтрока = ТаблицаТикеров.Добавить();
		НоваяСтрока.БиржаКод	 = БиржаКод;
		НоваяСтрока.Тикер		 = Тикер;
		НоваяСтрока.КодЦБ		 = ТекКодЦБ;
		НоваяСтрока.ВидБиржи	 = ВидБиржи;
		НоваяСтрока.ВерсияНРД	 = ВерсияНРД;
	КонецЦикла;
КонецПроцедуры // ДополнитьТаблицуТикеров()

Процедура ПрочитатьКотировки(ДокументыКотировок, НовыеИсточники = Ложь, Отказ = Ложь)
	Перем Дедубликатор;
	Перем Кэш;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицыЛога = Макет.ПолучитьОбласть("СтрокаТаблицы");
	
	Кэш = Новый Структура("Тикеры, Валюты, УровниЛистинга");
	Кэш["Тикеры"]			 = ПолучитьТаблицуТикеров(ДокументыКотировок);
	Кэш["Валюты"]			 = Новый Соответствие();
	Кэш["УровниЛистинга"]	 = Новый Соответствие();

	
	СоответствиеАктивов = Новый Соответствие;
	
	Дедубликатор = Новый ТаблицаЗначений();
	Дедубликатор.Колонки.Добавить("Период", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Дедубликатор.Колонки.Добавить("Актив", Новый ОписаниеТипов("СправочникСсылка.Активы"));
	Дедубликатор.Колонки.Добавить("Биржа", Новый ОписаниеТипов("СправочникСсылка.Биржи"));
	Дедубликатор.Индексы.Добавить("Актив, Биржа, Период");
	
	Для каждого ТекДок из ДокументыКотировок Цикл
		
		БиржаКод 	= ТекДок.Биржа.Наименование;
		ДатаДок 	= ТекДок.Дата;
		
		Для каждого ТекКотировка из ТекДок.Состав.СтрокаКотировок Цикл
			
			Тикер = ТекКотировка.Актив.КодЦБнаММВБ;
			МассивАктивов = АктивыПоТикеруКэш(Кэш["Тикеры"], Тикер, БиржаКод);
			
			//Если НовыеИсточники = Ложь Тогда
			//	СписокАктивов = АктивыПоТикеру(Тикер, БиржаКод); //IMAPPS-31547
			//Иначе
			//	Тикер = Лев(Тикер,12);
			//	СписокАктивов = АктивыПоИСИН(Тикер);
			//КонецЕсли;
			
			//UlyanovM 17/10/2018 IMAPPS-7176
			Если (НЕ(
						ТекКотировка.PRICING_SOURCE = "BGN" 
					ИЛИ 
						ТекКотировка.PRICING_SOURCE = "BVAL"
					)
					//MUlyanov 04/06/2020 IMAPPS-11038 NKD за выходной день
					И НЕ ( ТекКотировка.PRICING_SOURCE = Неопределено 
						И ТекКотировка.BID = 0 
						И ТекКотировка.МинимальнаяЦена = 0
						И ТекКотировка.МаксимальнаяЦена = 0
						И ТекКотировка.ПризнаваемаяКотировка = 0
						И ТекКотировка.СредневзвешеннаяЦенаЗакрытия = 0
						И ТекКотировка.НКД <> 0
						)
					)
					//MUlyanov END IMAPPS-11038
				И БиржаКод = "BLOOMBERG"
				И Найти(Тикер, "@" ) <= 0
				 
				Тогда Источник_НЕ_BGN_ИЛИ_BVAL_И_От_Блумберга_И_НЕТ_Жесткого_источника  = Истина;
				Иначе Источник_НЕ_BGN_ИЛИ_BVAL_И_От_Блумберга_И_НЕТ_Жесткого_источника = Ложь;
			КонецЕсли;
			//UlyanovM 17/10/2018 IMAPPS-7176
			
			Если МассивАктивов = Неопределено тогда 
				//ДобавитьКотировку(ТекКотировка, ДатаДок, Тикер, БиржаКод, ,,СтрокаТаблицыЛога);
				
				СтрокаТаблицыЛога.Параметры.Статус = "Актив не найден";
				Лог.Вывести(СтрокаТаблицыЛога);
				
			Иначе
				Повтор = Ложь;
				Для Каждого ТекАктивСписка Из МассивАктивов Цикл
					
					ТекАктив = ТекАктивСписка.Актив;
					Если НовыеИсточники = Ложь Тогда
						ТекБиржа = ТекАктивСписка.БиржаЛистинга;
					Иначе
						ТекБиржа = ПрочитатьПрямоеСопоставлениеБиржиПоИсточнику(БиржаКод, ТекКотировка.PRICING_SOURCE);
						Если ТекБиржа = Справочники.Биржи.ПустаяСсылка() Тогда
							Сообщить("Для источника " + ТекКотировка.PRICING_SOURCE + " и кода биржи " + БиржаКод + " не найдена Биржа. Необходимо настроить универсальное сопоставление.");
							Продолжить;
						КонецЕсли;
					КонецЕсли;
										
					//UlyanovM 17/10/2018 IMAPPS-7176
					Если ТекАктив.ВидАктива.Родитель = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыАктивов.Облигации")
						Тогда АктивЕстьОблигация = Истина;
						Иначе АктивЕстьОблигация = Ложь;
					КонецЕсли;
					
					Если Источник_НЕ_BGN_ИЛИ_BVAL_И_От_Блумберга_И_НЕТ_Жесткого_источника 
						И АктивЕстьОблигация Тогда
						СтрокаТаблицыЛога.Параметры.Статус = "Для данной облигации источник котировки Не BGN или BVAL";
						Продолжить;
					КонецЕсли;
					//UlyanovM 17/10/2018 IMAPPS-7176
					
					// ИКФ: Не должно быть дублей по Бумаге+Бирже+Дате, документ КотировкиЦБНаБирже такое не понимает!
					Если Дедубликатор.НайтиСтроки(Новый Структура("Период, Актив, Биржа", НачалоДня(ДатаДок), ТекАктив, ТекБиржа)).Количество() > 0 Тогда
						Продолжить;
					Иначе
						НовСтрокаДедубликатора = Дедубликатор.Добавить();
						НовСтрокаДедубликатора.Период	 = НачалоДня(ДатаДок);
						НовСтрокаДедубликатора.Актив	 = ТекАктив;
						НовСтрокаДедубликатора.Биржа	 = ТекБиржа;
					КонецЕсли;
					
					ДобавитьКотировку(Кэш, ТекКотировка, ДатаДок, Тикер, БиржаКод, ТекАктив, ТекБиржа, СтрокаТаблицыЛога);
					Если Повтор = Истина тогда
						СтрокаТаблицыЛога.Параметры.Статус = "Повтор котировки";
					КонецЕсли;
					
					Лог.Вывести(СтрокаТаблицыЛога);
					
					Повтор = Истина;
				Конеццикла;
			КонецЕсли;
		КонецЦикла;
	Конеццикла;
КонецПроцедуры

Процедура ПрочитатьКотировкиИнтерфакс(ДокументыКотировок, ТаблицаИнтерфакс, Отказ = Ложь)
	
	Перем Дедубликатор;
	
	Дедубликатор = Новый ТаблицаЗначений();
	Дедубликатор.Колонки.Добавить("Период", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Дедубликатор.Колонки.Добавить("Актив");
	Дедубликатор.Колонки.Добавить("Биржа");
	Дедубликатор.Индексы.Добавить("Актив, Биржа, Период");	
	
	Если Отказ тогда Возврат; КонецЕсли;
	
	СтрокаТаблицыЛога = Макет.ПолучитьОбласть("СтрокаТаблицы");
	
	СоответствиеАктивов = Новый Соответствие;
	ТаблицаИнтерфакс.Очистить();
	
	Для каждого ТекДок из ДокументыКотировок Цикл
		
		БиржаКод 	= ТекДок.Биржа.ВнешнийКод;
		ДатаДок 	= ТекДок.Дата;
		
		Для каждого ТекКотировка из ТекДок.Состав.СтрокаКотировок Цикл
			
			Если Дедубликатор.НайтиСтроки(Новый Структура("Период, Актив, Биржа", НачалоДня(ДатаДок), ТекКотировка.Актив.КодЦБнаММВБ, БиржаКод)).Количество() > 0 Тогда
				Продолжить;
			Иначе
				НовСтрокаДедубликатора = Дедубликатор.Добавить();
				НовСтрокаДедубликатора.Период	 = НачалоДня(ДатаДок);
				НовСтрокаДедубликатора.Актив	 = ТекКотировка.Актив.КодЦБнаММВБ;
				НовСтрокаДедубликатора.Биржа	 = БиржаКод;
			КонецЕсли;
							
			НовСтрока = ТаблицаИнтерфакс.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ТекКотировка);
			НовСтрока.Дата 		= ДатаДок;
			НовСтрока.Биржа_Код = БиржаКод;
			НовСтрока.Актив_Код = ТекКотировка.Актив.КодЦБнаММВБ;
			НовСтрока.ВалютаКотировки = Справочники.Валюты.НайтиПоНаименованию(ТекКотировка.ВалютаКотировки.КодВалюты);
			
			Если ТекКотировка.ВалютаКотировки.КодВалюты = "" или (НовСтрока.ВалютаКотировки.Пустая() и (ТекКотировка.ВалютаКотировки.КодВалюты = "SUR" или ТекКотировка.ВалютаКотировки.КодВалюты = "RUR")) тогда 
				Если НовСтрока.Актив.Пустая() тогда
					НовСтрока.ВалютаКотировки = Справочники.Валюты.RUB;
				Иначе
					НовСтрока.ВалютаКотировки = НовСтрока.Актив.Объект.ВалютаНоминальнойСтоимости;
				КонецЕсли;
			КонецЕсли;
			
			
		Конеццикла;
	Конеццикла;
	
КонецПроцедуры 

Процедура ДобавитьКотировку(Кэш, ТекКотировка, ДатаДок, Тикер, БиржаКод, Актив = Неопределено, Биржа = Неопределено,СтрокаТаблицыЛога )
	
	НоваяСтрока = СписокЗагрузки.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекКотировка);
	
	НоваяСтрока.УровеньКотировальногоЛиста = УровеньПоКоду(ТекКотировка.УровеньКотировальногоЛиста);
	
	НоваяСтрока.Дата 		= ДатаДок;
	НоваяСтрока.Биржа_Код 	= БиржаКод;
	НоваяСтрока.Биржа	 	= Биржа;
	НоваяСтрока.Актив	 	= Актив;
	НоваяСтрока.Актив_Код 	= Тикер;
	НоваяСтрока.ВалютаКотировки = ?(ЗначениеЗаполнено(ТекКотировка.ВалютаКотировки.КодВалюты), ВалютаИзКэша(Кэш["Валюты"], ТекКотировка.ВалютаКотировки.КодВалюты), Справочники.Валюты.RUB);
	
	Если ТекКотировка.ВалютаКотировки.КодВалюты = "" или (НоваяСтрока.ВалютаКотировки.Пустая() и (ТекКотировка.ВалютаКотировки.КодВалюты = "SUR" или ТекКотировка.ВалютаКотировки.КодВалюты = "RUR")) тогда 
		Если НоваяСтрока.Актив.Пустая() тогда
			НоваяСтрока.ВалютаКотировки = Справочники.Валюты.RUB;
		Иначе
			НоваяСтрока.ВалютаКотировки = НоваяСтрока.Актив.Объект.ВалютаНоминальнойСтоимости;
		КонецЕсли;
	КонецЕсли;
	
	//vns 08.08.2014 IMAVAN-1382 Валюты котировки по всем облигациям заполняем валютой номинала
	// НоваяСтрока.Валюта = Детали.ВалютаКотировки;
	Если НоваяСтрока.Актив.ВидАктива.Родитель = ПланыВидовХарактеристик.ВидыАктивов.Облигации и Биржа.Иностранная = истина Тогда
		НоваяСтрока.ВалютаКотировки = НоваяСтрока.Актив.Объект.ВалютаНоминальнойСтоимости;
	КонецЕсли; 
	//end_vns
	
	СтрокаТаблицыЛога.Параметры.Заполнить(ТекКотировка);
	СтрокаТаблицыЛога.Параметры.Актив = Тикер;
	// VTB-Borisov  - 22.08.2017 { 
	СтрокаТаблицыЛога.Параметры.АктивРасшифровка = Актив;
	// VTB-Borisov  - 22.08.2017 }
	СтрокаТаблицыЛога.Параметры.ВалютаКотировки = НоваяСтрока.ВалютаКотировки.Наименование;
	СтрокаТаблицыЛога.Параметры.Дата = ДатаДок;
	// VTB-Borisov  - 22.08.2017 { 
	СтрокаТаблицыЛога.Параметры.БиржаРасшифровка = Биржа;
	// VTB-Borisov  - 22.08.2017 }
	СтрокаТаблицыЛога.Параметры.Биржа = БиржаКод;
	СтрокаТаблицыЛога.Параметры.Статус = "";
	
КонецПроцедуры

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

Функция РассылкаСообщения(Знач ТемаСообщения, Знач ТекстСообщения, Знач ЕстьОшибки = Ложь, Знач РежимЗагрузки = "Общая")
	Перем ПараметрыПисьма;
	Перем МассивВременныхФайлов;
	
	МассивВременныхФайлов = Новый Массив();
	
	Если СписокРассылки.Количество() > 0 И НЕ ПочтовыйЛогин.Пустая() Тогда
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность, Вложения");
		ПараметрыПисьма.Важность = ?(ЕстьОшибки ИЛИ ЭтотОбъект.ЕстьРасхожденияКотировок, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
		
		Прописка = ПропискаРассылки("r12.1" + ?(РежимЗагрузки = "ТолькоVTBAMПИФ", ".пиф", ""));
		
		Если ЕстьОшибки Тогда
			ПараметрыПисьма.Тема	 = "{FAIL} " + ТемаСообщения + Прописка;
		Иначе
			Если ЭтотОбъект.ЕстьРасхожденияКотировок Тогда
				ПараметрыПисьма.Тема = "{WARN} " + ТемаСообщения + " - ЕСТЬ ИЗМЕНЕНИЯ" + Прописка;
			Иначе
				ПараметрыПисьма.Тема = "{OK} " + ТемаСообщения + Прописка;
			КонецЕсли;
		КонецЕсли;
		
		Кому = Новый Массив();
		Для каждого ТекЯщик из СписокРассылки Цикл
			Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
		
		ПараметрыПисьма.Кому		 = Кому;
		ПараметрыПисьма.ТипТекста	 = "HTML";
		ПараметрыПисьма.Тело		 = РассылкаСообщенияТаблица(ТекстСообщения + ?(ЭтотОбъект.ЕстьРасхожденияКотировок, "<BR><BR>ЕСТЬ ИЗМЕНЕНИЯ КОТИРОВОК<BR><BR>", ""));
		
		Вложения = Новый Соответствие();
		
		Если ЭтотОбъект.ЕстьРасхожденияКотировок Тогда
			ПутьКФайлу = ПолучитьИмяВременногоФайла("XLSX");
			ЭтотОбъект.ЛогИзменений.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);
			
			ПутьКZip = ПолучитьИмяВременногоФайла("zip");
			Упаковка = Новый ЗаписьZipФайла(ПутьКZip);
			Упаковка.Добавить(ПутьКФайлу);
			Упаковка.Записать();
			
			АдресВложения = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКZip));
			
			Вложения.Вставить("ИзмененияКотировок.zip", АдресВложения);
			
			МассивВременныхФайлов.Добавить(ПутьКФайлу);
			МассивВременныхФайлов.Добавить(ПутьКZip);
		КонецЕсли;
		
		ПараметрыПисьма.Вложения = Вложения;
		
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
			текстРассылки = "Рассылка завершена";
		Исключение
			текстРассылки = "Рассылка не удалась: " + ОписаниеОшибки();
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Для Каждого Элемент из Сообщения Цикл
				  текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
			КонецЦикла;
		КонецПопытки;
		
		Возврат текстРассылки;
	КонецЕсли;
	
	Попытка
		Для Каждого ТекФайл Из МассивВременныхФайлов Цикл
			УдалитьФайлы(ТекФайл);
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат "Не установлен список рассылки";
КонецФункции

Функция РассылкаСообщенияТаблица(ТекстСообщения)
	Х =	"";
	Х =	Х + "<html><head><meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" /></head>"+
		    "<body style=""font-family:Arial, Helvetica, sans-serif;color:black;"">"+
		    "<b>"+ТекстСообщения+"</b><br/><br/>";
	Х =	Х + "<table BORDERCOLOR=""Black"" border-style= ""solid"" border-collapse =""collapse"" border=""1"">"+
	        "<tr>"+
			"<th align=""center"" bgcolor=""#C0C0C0"">Дата</th>"+
			"<th align=""center"" bgcolor=""#C0C0C0"">Биржа</th>"+
			"<th align=""center"" bgcolor=""#C0C0C0"">Загружено объектов</th>"+
			"</tr>";
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КотировкиЦБНаБиржеКотировки.Ссылка.Дата КАК Дата,
		|	КотировкиЦБНаБиржеКотировки.Ссылка.Биржа.Наименование КАК Биржа,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КотировкиЦБНаБиржеКотировки.НомерСтроки) КАК Колво
		|ИЗ
		|	Документ.КотировкиЦБНаБирже.Котировки КАК КотировкиЦБНаБиржеКотировки
		|ГДЕ
		|	КотировкиЦБНаБиржеКотировки.Ссылка.Проведен = ИСТИНА
		|	И КотировкиЦБНаБиржеКотировки.Ссылка.Дата МЕЖДУ &Дата1 И &Дата2
		|
		|СГРУППИРОВАТЬ ПО
		|	КотировкиЦБНаБиржеКотировки.Ссылка.Биржа,
		|	КотировкиЦБНаБиржеКотировки.Ссылка.Дата,
		|	КотировкиЦБНаБиржеКотировки.Ссылка.Биржа.Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Биржа";
	Запрос.УстановитьПараметр("Дата1", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("Дата2", КонецДня(ДатаОкончания));
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Х =	Х + "<tr>"+
		        "<td>"+Формат(ВыборкаДетальныеЗаписи.Дата,"ДФ=dd.MM.yyyy")+"</td>"+
		        "<td>"+ВыборкаДетальныеЗаписи.Биржа+"</td>"+
		        "<td>"+Строка(ВыборкаДетальныеЗаписи.Колво)+"</td>"+
		        "</tr>"+Символы.ПС;
	КонецЦикла;
	
	Х =	Х + "</table>";
	Х =	Х + "</body></html>";
	
	Возврат Х;
КонецФункции

// Функция читает прямое сопоставление. Возвращает НашОбъект.
//
// Параметры:
//  ВнешнийОбъект - Строка (100 симовлов) - это обычно код внешнего объкта
//  ИсточникДанных - Строка (100 симовлов) - это источник данных
//  Если данных нет, то возвращается Справочники.Биржи.ПустаяСсылка()
//
// Возвращаемое значение:
//  Ссылка
//
Функция ПрочитатьПрямоеСопоставлениеБиржиПоИсточнику(ВнешнийОбъект, ИсточникДанных, ДатаНачалаДействия = Неопределено)
	
	Если ДатаНачалаДействия = Неопределено Тогда
		ДатаНачалаДействия = ТекущаяДата();
	КонецЕсли;
	
	КонтекстСопоставления = Перечисления.КонтекстСопоставления.Биржа;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачалаДействия", ДатаНачалаДействия);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УниверсальныеСопоставления.НашОбъект,
	|	УниверсальныеСопоставления.ДатаНачалаДействия КАК ДатаНачалаДействия
	|ИЗ
	|	РегистрСведений.УниверсальныеСопоставления КАК УниверсальныеСопоставления
	|ГДЕ
	|	УниверсальныеСопоставления.КонтекстСопоставления = &КонтекстСопоставления
	|	И УниверсальныеСопоставления.ВнешнийОбъект = &ВнешнийОбъект
	|	И УниверсальныеСопоставления.ДатаНачалаДействия <= &ДатаНачалаДействия
	|	И УниверсальныеСопоставления.Наименование ПОДОБНО &Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачалаДействия УБЫВ";
	
	Запрос.УстановитьПараметр("КонтекстСопоставления", КонтекстСопоставления);
	Запрос.УстановитьПараметр("ВнешнийОбъект", ВнешнийОбъект);
	Запрос.УстановитьПараметр("Наименование", "%" + ИсточникДанных + "%");
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат Справочники.Биржи.ПустаяСсылка();
	КонецЕсли;
	Выборка.Следующий();
	Возврат Выборка.НашОбъект;
	
КонецФункции // ПрочитатьПрямоеСопоставление()

