	|	т.НомерМетодаРасчета КАК НомерМетодаРасчета,
	|	т.LASTPRICE КАК LASTPRICE
	|ИЗ
	|	вт КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК Биржи
	|		ПО т.Биржа_Код = Биржи.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
	|		ПО т.Актив_Код = Активы.Объект.ISIN
	|			И (т.Актив_Код <> """")
	|			И (НЕ Активы.ПометкаУдаления)";

	Для каждого СтрокаТаб Из Запрос.Выполнить().Выгрузить() Цикл
		новСтрока = СписокЗагрузки.Добавить();
		ЗаполнитьЗначенияСвойств(новСтрока,  СтрокаТаб);
	КонецЦикла;

КонецПроцедуры
