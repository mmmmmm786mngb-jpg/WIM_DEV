Функция DV_UpdateDoc(Знач Актив, Док)
	Перем Запрос, Выборка;
	Перем БылиУдаления;
	
	НовыйДок = Док.ПолучитьОбъект();
	НовыйДок.Проведен = Ложь;

	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", Док);
	Запрос.УстановитьПараметр("ЦБ", Актив);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КотировкиЦБНаБиржеКотировки.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.КотировкиЦБНаБирже.Котировки КАК КотировкиЦБНаБиржеКотировки
	|ГДЕ
	|	КотировкиЦБНаБиржеКотировки.Ссылка = &Ссылка
	|	И КотировкиЦБНаБиржеКотировки.ЦБ = &ЦБ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки УБЫВ";
	
	БылиУдаления = Ложь;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовыйДок.Котировки.Удалить(НовыйДок.Котировки[Выборка.НомерСтроки - 1]);
		
		БылиУдаления = Истина;
	КонецЦикла;
	
	Если БылиУдаления Тогда
		НовыйДок.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Возврат НовыйДок;
КонецФункции // DV_UpdateDoc()

