Функция ПолучитьКотировкиДоИзменений(Знач ДокСсылка, Знач МассивАктивов = Неопределено)
	Перем Запрос, Выборка;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	Запрос.УстановитьПараметр("ВсеАктивы", МассивАктивов = Неопределено);
	Запрос.УстановитьПараметр("Активы", ?(МассивАктивов = Неопределено, Новый Массив(), МассивАктивов));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КотировкиЦБНаБирже.Актив КАК Актив,
	|	КотировкиЦБНаБирже.ПризнаваемаяКотировка КАК ПризнаваемаяКотировка,
	|	0 КАК ПризнаваемаяКотировка_Стало,
	|	-1 КАК ПризнаваемаяКотировка_Маркер
	|ИЗ
	|	РегистрСведений.КотировкиЦБНаБирже КАК КотировкиЦБНаБирже
	|ГДЕ
	|	КотировкиЦБНаБирже.Регистратор = &Ссылка
	|	И (&ВсеАктивы = ИСТИНА
	|			ИЛИ КотировкиЦБНаБирже.Актив В (&Активы))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Актив";
	
	Выборка = Запрос.Выполнить().Выгрузить();
	Выборка.Индексы.Добавить("Актив");
	
	Возврат Выборка;
КонецФункции // ПолучитьКотировкиДоИзменений()

Функция ПолучитьМассивКодовЦБ(Знач КодЦБ)
	Перем МассивКодовЦБ;
	Перем ЭтоISIN, Концовка;
	
	КодЦБ = СокрЛП(КодЦБ);
	
	МассивКодовЦБ = Новый Массив();
	МассивКодовЦБ.Добавить(КодЦБ);
	
	ЭтоISIN = СтрДлина(КодЦБ) = 12 И СтрНайти(КодЦБ, " ") = 0 И СтрНайти(КодЦБ, Символы.НПП) = 0;  // у ISIN'ов нет пробелов и он длиной 12 символов!
	
	Если НЕ ЭтоISIN Тогда
		Концовка = " USD";
		
		Если СтрЗаканчиваетсяНа(ВРег(КодЦБ), Концовка) Тогда
			// если есть Концовка - выкусываем её
			МассивКодовЦБ.Добавить(СокрП(Лев(КодЦБ, СтрДлина(КодЦБ) - СтрДлина(Концовка))));
		Иначе
			// если нет Концовки - добавляем её
			МассивКодовЦБ.Добавить(КодЦБ + Концовка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат МассивКодовЦБ;
КонецФункции // ПолучитьМассивКодовЦБ()

Функция ПолучитьМассивПИФов()
	Перем Запрос, Выборка;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПаиПИФ.Ссылка КАК Пай
	|ИЗ
	|	Справочник.ПаиПИФ КАК ПаиПИФ
	|ГДЕ
	|	НЕ ПаиПИФ.ПометкаУдаления
	|	И 1 В
	|			(ВЫБРАТЬ
	|				1
	|			ИЗ
	|				Справочник.ПаиПИФ.БиржиЛистинга КАК БиржиЛистинга
	|			ГДЕ
	|				БиржиЛистинга.Ссылка = ПаиПИФ.Ссылка
	|				И БиржиЛистинга.КодЦБ ПОДОБНО ""%@VTBAM%"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пай";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пай");
