	Если Валюта = Неопределено Тогда
		Валюта = Справочники.Валюты.НайтиПоНаименованию(КодВалюты);
		
		КэшВалют[КодВалюты] = Валюта;
	КонецЕсли;
	
	Возврат Валюта;
