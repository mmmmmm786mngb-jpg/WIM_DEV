Функция StockCode(Знач Актив, Знач РежимЗагрузки = "Общая")
	Перем Запрос, Выборка;
	Перем МассивТикеров, Тикеры;
	Перем МассивБумаг;
	
	МассивТикеров	 = Новый Массив();
	МассивБумаг		 = Новый Массив();
	
	Если ЗначениеЗаполнено(Актив) Тогда
		МассивБумаг.Добавить(Актив.Объект);
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Актив) И (РежимЗагрузки = "Общая") Тогда
		Возврат "";  // по всем бумагам!
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Актив) И (РежимЗагрузки = "ТолькоVTBAMПИФ") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			МассивБумаг,
			ПолучитьМассивПИФов(),
			Истина
		);
		
	Иначе
		Возврат "!error!";  // ничего не надо!
		
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Бумаги", МассивБумаг);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Выборка.КодЦБ КАК КодЦБ
	|ИЗ
	|	(ВЫБРАТЬ
	|		АкцииБиржиЛистинга.КодЦБ КАК КодЦБ
	|	ИЗ
	|		Справочник.Акции.БиржиЛистинга КАК АкцииБиржиЛистинга
	|	ГДЕ
	|		АкцииБиржиЛистинга.Ссылка В(&Бумаги)
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		ОблигацииБиржиЛистинга.КодЦБ
	|	ИЗ
	|		Справочник.Облигации.БиржиЛистинга КАК ОблигацииБиржиЛистинга
	|	ГДЕ
	|		ОблигацииБиржиЛистинга.Ссылка В(&Бумаги)
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		ПаиПИФБиржиЛистинга.КодЦБ
	|	ИЗ
	|		Справочник.ПаиПИФ.БиржиЛистинга КАК ПаиПИФБиржиЛистинга
	|	ГДЕ
	|		ПаиПИФБиржиЛистинга.Ссылка В(&Бумаги)) КАК Выборка
	|ГДЕ
	|	Выборка.КодЦБ > """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			МассивТикеров,
			ПолучитьМассивКодовЦБ(Выборка.КодЦБ),
			Истина
		);
	КонецЦикла;
	
    // IMAPPS-31547 	
	МассивТикеров.Добавить(Актив.ISIN + "НРД");
	
	Тикеры = СтрСоединить(МассивТикеров, ",");
	Тикеры = Тикеры + ?(НЕ СтрЗаканчиваетсяНа(Тикеры, ","), ",", "");
	
	Возврат Тикеры;
КонецФункции // StockCode()

