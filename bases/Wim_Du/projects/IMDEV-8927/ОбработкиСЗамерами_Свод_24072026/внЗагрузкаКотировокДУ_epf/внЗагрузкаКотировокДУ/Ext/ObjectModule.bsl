Функция АктивыПоТикеруКэш(Знач Кэш, Знач Тикер, Знач БиржаКод)
	Перем СтрокиКэша;
	
	СтрокиКэша = Кэш.НайтиСтроки(Новый Структура("Тикер, БиржаКод", Тикер, БиржаКод));
	Если СтрокиКэша.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтрокиКэша;
КонецФункции // АктивыПоТикеруКэш()
