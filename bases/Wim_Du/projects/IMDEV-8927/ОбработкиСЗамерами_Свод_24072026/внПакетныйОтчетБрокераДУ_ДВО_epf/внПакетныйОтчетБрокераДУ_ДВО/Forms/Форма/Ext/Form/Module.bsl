// ПРОЦЕДУДРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

// Функция преобразует строку, содержащую дату, в дату
&НаСервереБезКонтекста
Функция ПреобразоватьСтрокуВДату(ДатаСтрока)
	
	ПреобразованнаяДата = '00010101';
	
	Если ЗначениеЗаполнено(ДатаСтрока) Тогда
		Если СтрДлина(ДатаСтрока) = 10 Тогда // формат даты ДД.ММ.ГГГГ
			Попытка
				ПреобразованнаяДата = Дата(Прав(ДатаСтрока, 4) + Сред(ДатаСтрока, 4, 2) + Лев(ДатаСтрока, 2));
			Исключение			
			КонецПопытки;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат ПреобразованнаяДата;
	
КонецФункции // ПреобразоватьСтрокуВДату()

&НаСервере
функция ВернитеДату(Знач значение)
	
	Разделитель = ".";
	НашаДата = "";
	ПорогТысячелетия = 50;
	
	Если значение=Дата('00010101') Тогда
		НашаДата = Дата('00010101');
	Иначе
		Стр = СокрЛП(значение);
		
		Если ПустаяСтрока(Стр) Тогда
			Возврат Дата('00010101');
		КонецЕсли;
		длРазделителя = СтрДлина(СокрЛП(Разделитель));
		НомПоля = 1;
		Пока (ПустаяСтрока(Стр) = 0) Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз = 0 Тогда	//	не нашли
				НазваниеОдногоПоля = Стр;
				Стр = "";
			Иначе
				//	вырезаем очередное поля
				НазваниеОдногоПоля = Лев(Стр,Поз-1);
				Стр = Прав(Стр,СтрДлина(Стр)-(Поз+длРазделителя-1));
			КонецЕсли;
			
			НазваниеОдногоПоля = СокрЛП(НазваниеОдногоПоля);
			
			Если НомПоля = 1 Тогда
				ЗнДень = СокрЛП(НазваниеОдногоПоля);
				Если СтрДлина(ЗнДень)=1 Тогда
					ЗнДень=Строка("0"+ЗнДень);
				КонецЕсли;
			ИначеЕсли НомПоля = 2 Тогда
				ЗнМесяц = СокрЛП(НазваниеОдногоПоля);
				Если СтрДлина(ЗнМесяц)=1 Тогда
					ЗнМесяц=Строка("0"+ЗнМесяц);
				КонецЕсли;
			ИначеЕсли НомПоля = 3 Тогда
				ЗнГод= СокрЛП(НазваниеОдногоПоля);
				Если СтрДлина(ЗнГод)<4 Тогда
					Если СтрДлина(ЗнГод)>=2 Тогда
						Если Число(Прав(ЗнГод,2))>=ПорогТысячелетия Тогда
							ЗнГод=Строка("19"+ЗнГод);
						Иначе
							ЗнГод=Строка(Лев(Прав(Формат(ТекущаяДата(), "ДЛФ=Д"),4),4-СтрДлина(ЗнГод))+ЗнГод);
						КонецЕсли;
					Иначе
						ЗнГод=Строка(Лев(Прав(Формат(ТекущаяДата(), "ДЛФ=Д"),4),4-СтрДлина(ЗнГод))+ЗнГод);
					КонецЕсли;
				КонецЕсли;
				Если СтрДлина(ЗнГод) > 4 Тогда
					ЗнГод = Лев(ЗнГод, 4);
				КонецЕсли;
				
			КонецЕсли;
			
			НомПоля = НомПоля + 1;
			Если НомПоля > 3 Тогда
				Прервать;  // Завершить просмотр строки, т.к. обработаны все необходимые поля, но есть еще что-то.
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			НашаДата = Дата(ЗнГод, ЗнМесяц, ЗнДень);
		Исключение
			НашаДата = Дата('00010101');
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат НашаДата;
	
КонецФункции // ВернитеДату()

