	Об = РеквизитФормыВЗначение("Объект");
	Об.КомандаФормыСоздатьОперацииПоБрокерскомуСчету(БрокерУИД);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДанных2КупонНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТаблицаДанных2.ТекущиеДанные;
	
	Если ТекущиеДанные<>Неопределено и ЗначениеЗаполнено(ТекущиеДанные.Актив) Тогда
		
		ЦБ = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ТекущиеДанные.Актив, "Объект");
		
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура("Владелец", ЦБ);
		ОткрытьФорму("Справочник.КупонныеПериоды.ФормаВыбора", ПараметрыФормы, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДанныхПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	СтрокаТЧ = Элемент.ТекущиеДанные;
	Если СтрокаТЧ <> Неопределено И ЗначениеЗаполнено(СтрокаТЧ.Бумага) Тогда
		УстановитьУниверсальныеСопоставления(СтрокаТЧ.Бумага, СтрокаТЧ.ISIN, СтрокаТЧ.ДатаСделки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУниверсальныеСопоставления(Бумага, ISIN, ДатаСделки)
	
	//Актив
	КонтекстСопоставления = Перечисления.КонтекстСопоставления.ЦенныеБумаги;
	Если ЗначениеЗаполнено(Бумага) И ТипЗнч(Бумага) <> Тип("Строка") Тогда
		РегистрыСведений.УниверсальныеСопоставления.ЗаписатьПрямоеСопоставление(КонтекстСопоставления, Справочники.Биржи.ПустаяСсылка(), ISIN, Бумага, "ISIN", ДатаСделки);
		//Подстановка Бумаги в строки с таким же номером.
		Для каждого СтрокаТЧ Из ТаблицаДанных Цикл
			Если СтрокаТЧ.ISIN = ISIN Тогда
				СтрокаТЧ.Бумага = Бумага;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Набор = РегистрыСведений.УниверсальныеСопоставления.СоздатьНаборЗаписей();
		Набор.Отбор.ВнешнийОбъект.Установить(ISIN, Истина);
		Набор.Отбор.КонтекстСопоставления.Установить(КонтекстСопоставления, Истина);
		Набор.Записать();
	КонецЕсли;
	
КонецПроцедуры // ()


&НаКлиенте
Процедура ТаблицаДанных2ПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	СтрокаТЧ = Элемент.ТекущиеДанные;
	Если СтрокаТЧ <> Неопределено И ЗначениеЗаполнено(СтрокаТЧ.КодЦБ) Тогда
		УстановитьУниверсальныеСопоставления2(СтрокаТЧ.КодЦБ, СтрокаТЧ.Актив, СтрокаТЧ.Дата);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУниверсальныеСопоставления2(КодЦБ, Актив, Дата)
	
	//Облигация
	КонтекстСопоставления = Перечисления.КонтекстСопоставления.ЦенныеБумаги;
	Если ЗначениеЗаполнено(Актив) И ТипЗнч(Актив) <> Тип("Строка") Тогда
		РегистрыСведений.УниверсальныеСопоставления.ЗаписатьПрямоеСопоставление(КонтекстСопоставления, Справочники.Биржи.ПустаяСсылка(), КодЦБ, Актив, "Код ЦБ на бирже", Дата);
		//Подстановка Бумаги в строки с таким же номером.
		Для каждого СтрокаТЧ Из Объект.ТаблицаДанных2 Цикл
			Если СтрокаТЧ.КодЦБ = КодЦБ Тогда
				СтрокаТЧ.Актив = Актив;                          
			КонецЕсли;
		КонецЦикла;                           
	Иначе
		Набор = РегистрыСведений.УниверсальныеСопоставления.СоздатьНаборЗаписей();
		Набор.Отбор.ВнешнийОбъект.Установить(КодЦБ, Истина);
		Набор.Отбор.КонтекстСопоставления.Установить(КонтекстСопоставления, Истина);
		Набор.Записать();
	КонецЕсли;
	
КонецПроцедуры // ()

&НаКлиенте
Процедура ТаблицаДанных4ПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	СтрокаТЧ = Элемент.ТекущиеДанные;
	
	УстановитьУниверсальныеСопоставления4Бумага(СтрокаТЧ.Бумага, СтрокаТЧ.НомерГосРег, СтрокаТЧ.Дата);
	УстановитьУниверсальныеСопоставления4Раздел(СтрокаТЧ.РазделАСЦБ, СтрокаТЧ.Раздел, СтрокаТЧ.Дата);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУниверсальныеСопоставления4Бумага(Бумага, НомерГосРег, Дата)
	
	//Актив
	КонтекстСопоставления = Перечисления.КонтекстСопоставления.ЦенныеБумаги;
	Если ЗначениеЗаполнено(Бумага) И ТипЗнч(Бумага) <> Тип("Строка") Тогда
		РегистрыСведений.УниверсальныеСопоставления.ЗаписатьПрямоеСопоставление(КонтекстСопоставления, Справочники.Биржи.ПустаяСсылка(), НомерГосРег, Бумага, "Код ЦБ", Дата);
		//Подстановка Бумаги в строки с таким же номером.
		Для каждого СтрокаТЧ Из ТаблицаДанных4 Цикл
			Если СтрокаТЧ.НомерГосРег = НомерГосРег Тогда
				СтрокаТЧ.Бумага = Бумага;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Набор = РегистрыСведений.УниверсальныеСопоставления.СоздатьНаборЗаписей();
		Набор.Отбор.ВнешнийОбъект.Установить(НомерГосРег, Истина);
		Набор.Отбор.КонтекстСопоставления.Установить(КонтекстСопоставления, Истина);
		Набор.Записать();
	КонецЕсли;
	
КонецПроцедуры // ()

&НаСервере
Процедура УстановитьУниверсальныеСопоставления4Раздел(РазделАСЦБ, Раздел, Дата)
	
	//Актив
	КонтекстСопоставления = Перечисления.КонтекстСопоставления.РазделыБрокера;
	Если ЗначениеЗаполнено(РазделАСЦБ) И ТипЗнч(РазделАСЦБ) = Тип("СправочникСсылка.Разделы") Тогда
		РегистрыСведений.УниверсальныеСопоставления.ЗаписатьПрямоеСопоставление(КонтекстСопоставления, Объект.Брокер, Раздел, РазделАСЦБ, "Код ЦБ", Дата);
		//Подстановка Бумаги в строки с таким же номером.
		Для каждого СтрокаТЧ Из ТаблицаДанных4 Цикл
			Если СтрокаТЧ.Раздел = Раздел Тогда
				СтрокаТЧ.РазделАСЦБ = РазделАСЦБ;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Набор = РегистрыСведений.УниверсальныеСопоставления.СоздатьНаборЗаписей();
		Набор.Отбор.ВнешнийОбъект.Установить(Раздел, Истина);
		Набор.Отбор.КонтекстСопоставления.Установить(КонтекстСопоставления, Истина);
		Набор.Записать();
	КонецЕсли;
	
КонецПроцедуры // ()


