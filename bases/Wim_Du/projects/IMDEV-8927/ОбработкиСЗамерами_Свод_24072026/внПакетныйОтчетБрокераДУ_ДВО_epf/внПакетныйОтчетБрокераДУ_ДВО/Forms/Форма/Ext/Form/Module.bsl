
&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбора.Заголовок                   = "Выберите файл для загрузки данных";
	ДиалогВыбора.ПредварительныйПросмотр     = Ложь;
	ДиалогВыбора.ИндексФильтра               = 0;
	ДиалогВыбора.ПолноеИмяФайла              = Элемент.ТекстРедактирования;
	ДиалогВыбора.ПроверятьСуществованиеФайла = Ложь;
	
	
	
	//Если Строка(Брокер.УникальныйИдентификатор()) = "73fc232b-45e3-11e2-b4e9-005056b100ec" Тогда // Банк ВТБ
		ФорматФайлаXLSX = "XLSX";
	//Иначе
		ФорматФайла = "XLS";
	//КонецЕсли;
	
	Фильтр = НСтр("ru = 'Файлы " + ФорматФайла + "|*." + ФорматФайла + ";*." + ФорматФайлаXLSX +"| ZIP архив |*.zip| Файл json |*.json'");
	ДиалогВыбора.Фильтр = Фильтр;	
	
	Если ДиалогВыбора.Выбрать() Тогда
		ИмяФайла = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчитатьФайл(Команда)
	ОчиститьСообщения();
	ИмяКаталогаРазархива = Неопределено;
	АдресФайлаНаСервере = "";
	Отказ = Ложь;
	Расширение = Прав(ИмяФайла,СтрДлина(ИмяФайла)-СтрНайти(ИмяФайла,"."));
	Если ВРЕГ(Расширение) = "ZIP" Тогда   
		ИмяКаталогаРазархива = КаталогВременныхФайлов()+Строка(Новый УникальныйИдентификатор)+"\";    	
		
		Разархивировано = РаспаковатьФайл(ИмяФайла,ИмяКаталогаРазархива);
		Если Не Разархивировано Тогда
			Возврат
		КонецЕсли;
		
		Файлы = НайтиФайлы(ИмяКаталогаРазархива, "*.xls*");
		Если Файлы.Количество() = 1 Тогда
			ИмяФайла = Файлы[0].ПолноеИмя	
		Иначе
			Сообщить("Не удалось разархивировать файл или в архиве больше 1-го файла, разархивируйте вручную и запустите загрузку");
			УдалитьФайлы(ИмяКаталогаРазархива,"*.*");
			Возврат
		КонецЕсли;
	Иначе
			
	КонецЕсли;
		
	
	//Поместим файл с данными во временное хранилище на сервере
	Попытка
		ПоместитьФайл(АдресФайлаНаСервере, ИмяФайла, , Ложь, УникальныйИдентификатор);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось прочитать файл " + ИмяФайла + "! Проверьте правильность пути к файлу.", , "Объект.ИмяФайла", ,Отказ);
	КонецПопытки;
	
	Если НЕ Отказ Тогда
		
		обФайл = новый Файл(ИмяФайла);
		Если НРег(Расширение) = "json" Тогда
			СчитатьФайлСервер_json(АдресФайлаНаСервере, обФайл.ИмяБезРасширения, Строка(Объект.Брокер.УникальныйИдентификатор()));	
		Иначе	
			СчитатьФайлСервер(АдресФайлаНаСервере, обФайл.ИмяБезРасширения, Строка(Объект.Брокер.УникальныйИдентификатор()));
		КонецЕсли;
	
	КонецЕсли;
	
	Если не ИмяКаталогаРазархива = Неопределено Тогда
		УдалитьФайлы(ИмяКаталогаРазархива,"*.*");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СчитатьФайлСервер(АдресФайлаНаСервере, ИмяФайлаБезРасширения, БрокерУИД)
	
	УстановитьВидимость();
	
	Об = РеквизитФормыВЗначение("Объект");
	
	//Об.КомандаФормыСчитатьФайл(АдресФайлаНаСервере, ИмяФайлаБезРасширения);	//IMAPPS-18376
	Об.КомандаФормыСчитатьФайл(АдресФайлаНаСервере, ИмяФайлаБезРасширения, БрокерУИД);

	ЗначениеВРеквизитФормы(Об, "Объект");
	
КонецПроцедуры // СчитатьФайлСервер()

&НаСервере
Процедура СчитатьФайлСервер_json(АдресФайлаНаСервере, ИмяФайлаБезРасширения, БрокерУИД)
	
	УстановитьВидимость();
	
	Об = РеквизитФормыВЗначение("Объект");	
	Об.ПрочитатьФайлJSON(АдресФайлаНаСервере, ИмяФайлаБезРасширения, БрокерУИД);
	ЗначениеВРеквизитФормы(Об, "Объект");
	
КонецПроцедуры // СчитатьФайлСервер_json()


 // Распаковывает файл архива ZIP в указанный каталог; Извлекает все файлы архива
//
// Параметры:
//  ПолноеИмяФайлаАрхива  - Строка - имя файла архива, который необходимо распаковать
//  ПутьРаспаковкиФайлов  - Строка - путь по которому необходимо распаковать файлы
//  ПарольАрхива          - Строка - пароль для распаковки архива. По умолчанию пустая строка
// 
// Возвращаемое значение:
//  Результат - Булево - Истина, если успешно, Ложь, если нет.
//
&НаКлиенте
Функция РаспаковатьФайл( ПолноеИмяФайлаАрхива, ПутьРаспаковкиФайлов, ПарольАрхива = "") 	
	
	Результат = Истина;
	
	Попытка
		
		Архиватор = Новый ЧтениеZipФайла(ПолноеИмяФайлаАрхива, ПарольАрхива);
		
	Исключение
		Архиватор = Неопределено;
		//СообщитьОбОшибке(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		
		Архиватор.ИзвлечьВсе(ПутьРаспаковкиФайлов, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		
	Исключение
		
		СтрокаСообщения = НСтр("ru = 'Ошибка при распаковке файлов архива: %1 в каталог: %2'");
		//СтрокаСообщения = ПодставитьПараметрыВСтроку(СтрокаСообщения, ПолноеИмяФайлаАрхива, ПутьРаспаковкиФайлов);
		Сообщить(СтрокаСообщения);
		
		Результат = Ложь;
	КонецПопытки;
	
	Архиватор.Закрыть();
	Архиватор = Неопределено;
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Процедура СверитьДанные(Команда)
	
	СверитьДанныеСервер();	
	
КонецПроцедуры

&НаСервере
Процедура СверитьДанныеСервер()
	
	//ТаблицаДанныхПоиск   = ДанныеФормыВЗначение(ТаблицаДанных, Тип("ТаблицаЗначений"));
	//ТаблицаДанныхПоиск.Свернуть("ДоговорДУ, АналитическийСчетЦБ, АналитическийСчетДС, Бумага, ВидСделки","Количество, Сумма, НКД, КомиссияБрокера, КомиссияБиржи");
	
	Отказ = Ложь;
	НомСтр = 0;
	
	Для Каждого Строчка из Объект.ТаблицаДанных3 Цикл
		
		НомСтр = НомСтр + 1;
		Если НЕ ЗначениеЗаполнено(Строчка.АналитическийСчетДС) Тогда
			Сообщить("В строке №" + НомСтр + " таблицы сверки д/с не указан аналитический счет ДС");
			Отказ = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строчка.ДоговорДУ) Тогда
			Сообщить("В строке №" + НомСтр + " таблицы сверки д/с не указан ДоговорДУ");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	НомСтр = 0;
	Для Каждого Строчка из ТаблицаДанных4 Цикл
		
		НомСтр = НомСтр + 1;
		Если НЕ ЗначениеЗаполнено(Строчка.АналитическийСчетЦБ) Тогда
			Сообщить("В строке №" + НомСтр + " таблицы сверки ЦБ не указан аналитический счет ЦБ");
			Отказ = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строчка.ДоговорДУ) Тогда
			Сообщить("В строке №" + НомСтр + " таблицы сверки ЦБ не указан ДоговорДУ");
			Отказ = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строчка.Бумага) Тогда
			Сообщить("В строке №" + НомСтр + " таблицы сверки ЦБ не указана ЦБ");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	//Если Отказ Тогда
	//	Сообщить("Сверка не может быть выполнена", СтатусСообщения.ОченьВажное);
	//	Возврат;
	//КонецЕсли;	
	
	Сообщить("Идет сверка данных...", СтатусСообщения.Информация);
	
	ПустойАС = Справочники.АналитическиеСчета.ПустаяСсылка();
	ПустойДУ = Справочники.ДоговорДУ.ПустаяСсылка();
	ПустаяБумага = Справочники.Активы.ПустаяСсылка();
	
	//Сверка остатков ДС 	
	НомСтр = 0;
	Для Каждого Строчка из Объект.ТаблицаДанных3 Цикл
		
		Если НомСтр = 0 Тогда
			ДатаБалланса = Строчка.Дата;
			ТаблицаОстатковДС = ОстаткиПоАналитическимСчетамБрокераДС(ДатаБалланса);
		КонецЕсли;
		
		НомСтр = НомСтр + 1;
		
		//Сверка полученных данных с базой 
		Если Строчка.АналитическийСчетДС <> ПустойАС И Строчка.ДоговорДУ <> ПустойДУ Тогда
			СтрокиДС = ТаблицаОстатковДС.НайтиСтроки (Новый Структура("АналитическийСчетДС, ДоговорДУ", Строчка.АналитическийСчетДС, Строчка.ДоговорДУ));
		Иначе
			Строчка.Результат = "Сверка не проводилась. Необходимо заполнить пустые поля.";
			Продолжить;
		КонецЕсли;
		
		Если СтрокиДС.Количество() > 0 Тогда
			
			ЗаполнитьЗначенияСвойств(Строчка, СтрокиДС[0],"СуммаНачальныйОстатокБД, СуммаОборотДтБД, СуммаОборотКтБД, СуммаКонечныйОстатокБД");
			
			Если Строчка.СуммаНачальныйОстатокБД <> Строчка.СуммаНачальныйОстаток 
				Или Строчка.СуммаОборотКтБД <> Строчка.СуммаОборотКт 
				Или Строчка.СуммаОборотДтБД <> Строчка.СуммаОборотДт
				Или Строчка.СуммаКонечныйОстатокБД <> Строчка.СуммаКонечныйОстаток
				Тогда
				Строчка.Результат = "Данные отличаются от значений БД";
			Иначе	
				Строчка.Результат = "Данные идентичны.";
			КонецЕсли;
			
		Иначе
			Строчка.Результат = "Не найдены остатки в БД.";
		КонецЕсли;
		
	КонецЦикла;	
	
	//Сверка остатков ЦБ 
	НомСтр = 0;
	Для каждого Строчка Из ТаблицаДанных4 Цикл
		
		Если НомСтр = 0 Тогда
			ДатаБалланса = Строчка.Дата;
			ТаблицаОстатковЦБ = ОстаткиЦБ(ДатаБалланса);
		КонецЕсли;
		
		НомСтр = НомСтр + 1;
		
		//Сверка полученных данных с базой
		Если Строчка.АналитическийСчетЦБ <> ПустойАС И Строчка.ДоговорДУ <> ПустойДУ И Строчка.Бумага <> ПустаяБумага Тогда
			СтрокиЦБ = ТаблицаОстатковЦБ.НайтиСтроки (Новый Структура("АналитическийСчетЦБ, ДоговорДУ, Бумага", Строчка.АналитическийСчетЦБ, Строчка.ДоговорДУ, Строчка.Бумага));
		Иначе	
			Строчка.Результат = "Сверка не проводилась. Необходимо заполнить пустые поля.";
			Продолжить;
		КонецЕсли;
		
		Если СтрокиЦБ.Количество() > 0 Тогда
			
			ЗаполнитьЗначенияСвойств(Строчка, СтрокиЦБ[0],"ПриходБД, РасходБД, АктуальныйОстатокБД");
			
			Если Строчка.АктуальныйОстатокБД <> Строчка.АктуальныйОстаток ИЛИ Строчка.ПриходБД <> Строчка.Приход  ИЛИ Строчка.РасходБД <> Строчка.Расход Тогда
				Строчка.Результат = "Данные отличаются от значений БД";
			Иначе	
				Строчка.Результат = "Данные идентичны.";
			КонецЕсли;
			
		Иначе
			Строчка.Результат = "Не найдены остатки в БД.";
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Сверка отчета завершена.", СтатусСообщения.Информация);
	
КонецПроцедуры // СверитьДанныеСервер()


&НаКлиенте
Процедура СоздатьОбъекты(Команда)
	СоздатьОбъектыСервер();
КонецПроцедуры

&НаСервере
Процедура СоздатьОбъектыСервер()
	
	Отказ = Ложь;
	НомСтр = 0;
	
	Для Каждого Строчка из ТаблицаДанных Цикл
		НомСтр = НомСтр + 1;
		
		Если НЕ ЗначениеЗаполнено(Строчка.Бумага) Тогда
			Сообщить("В строке №" + НомСтр + " таблицы ""Сделки"" не указана ц/б");
			Отказ = Истина;
		КонецЕсли;		
	КонецЦикла;
	
	
	Если Отказ Тогда
		Сообщить("Загрузка не может быть выполнена", СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;	
	
	ТаблицаДанных.Сортировать("ДатаСделки Возр,ВремяСделки Возр, НомерСделки Возр, ВидСделки Возр");
	Объект.ТаблицаДанных2.Сортировать("Дата Возр");
	
	
	ФайлЗагрузки = Новый Файл(ИмяФайла);
	ПВХ			 = ПланыВидовХарактеристик.ВидыАктивов;
	ПС			 = ПланыСчетов.Хозрасчетный;
	//ВалютаРег	 = ЗначениеНастроекПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	СписокДоков  = Новый СписокЗначений;
	ВестиТолькоБухгалтерскийУчет = Константы.ВестиТолькоБухгалтерскийУчет.Получить();
	
	НомСтр = 0;
	//ТаблицаЗагрузки.Очистить();
	
	Сообщить("Идет формирование списка документов...", СтатусСообщения.Информация);
	
	ВключатьРасходыВСтоимость = Истина;
	ДатаСделки = '00010101';
	Для Каждого Строчка из ТаблицаДанных Цикл
		
		НомСтр = НомСтр + 1;
		
		Попытка
			Строчка.ВремяСделки = СокрЛП(Строчка.ВремяСделки);
			ДатаДокумента 	    = Дата(Год(Строчка.ДатаСделки), Месяц(Строчка.ДатаСделки), День(Строчка.ДатаСделки), Число(Лев(Строчка.ВремяСделки,2)), Число(Сред(Строчка.ВремяСделки,4,2)), Число(Прав(Строчка.ВремяСделки,2)));
		Исключение
			ДатаДокумента = Строчка.ДатаСделки;
		КонецПопытки;
		
		//Получить таблицу сделок за день
		Если НомСтр = 1 Или Строчка.ДатаСделки <> ДатаСделки Тогда
			
			ТаблицаСозданныхДокументов = ПолучитьТаблицуСделок(ДатаДокумента);
			
			ДатаСделки = Строчка.ДатаСделки;
			
		КонецЕсли;
		
		Если ВРег(Строчка.ВидСделки) = "ПОКУПКА" ИЛИ ВРег(Строчка.ВидСделки) = "КУПЛЯ" Тогда 
			НайденныеДокументы = ТаблицаСозданныхДокументов.НайтиСтроки(Новый Структура("ТипСделки, НомерВходящегоДокумента", "Купля", Строчка.НомерСделки));
		ИначеЕсли ВРег(Строчка.ВидСделки) = "ПРОДАЖА" Тогда 
			НайденныеДокументы = ТаблицаСозданныхДокументов.НайтиСтроки(Новый Структура("ТипСделки, НомерВходящегоДокумента", "Продажа", Строчка.НомерСделки));
		КонецЕсли;
		
		ДокументСделки = Неопределено;
		
		Если ЗначениеЗаполнено(НайденныеДокументы) И НайденныеДокументы.Количество() > 0 Тогда
			ДокументСделки = НайденныеДокументы.Получить(0).Ссылка;				
		КонецЕсли;
		
		Если ДокументСделки = Неопределено Тогда
			ДокументСделки = Документы.Сделка.СоздатьДокумент();
			Создан = Истина;     
		Иначе
			ДокументСделки = ДокументСделки.ПолучитьОбъект();
			Создан = Ложь;
		КонецЕсли;		
		
		
		Если ВРег(Строчка.ВидСделки) = "ПОКУПКА" ИЛИ ВРег(Строчка.ВидСделки) = "КУПЛЯ" Тогда 
			
			ДокументСделки.СчетУчетаРасчетовСКонтрагентом = ПС.РасчетыБрокераПоСделкам;
			ДокументСделки.СчетУчетаРасчетовПоАвансам = ПС.РасчетыПоАвансамВыданным;
			ДокументСделки.ВидОперации = Перечисления.ВидыОперацийСделка.Поступление;
		ИначеЕсли ВРег(Строчка.ВидСделки) = "ПРОДАЖА" Тогда 
			
			ДокументСделки.СчетУчетаРасчетовСКонтрагентом = ПС.РасчетыБрокераПоСделкам;
			ДокументСделки.СчетУчетаРасчетовПоАвансам = ПС.РасчетыПоАвансамПолученным;
			ДокументСделки.ВидОперации = Перечисления.ВидыОперацийСделка.Продажа;
		КонецЕсли;	
		
		ДокументСделки.Дата = ДатаДокумента;
		ДоговорДУ = Строчка.ДоговорДУ;
		ДокументСделки.ДоговорДУ = ДоговорДУ;
		ДокументСделки.ВнебиржеваяСделка = Ложь;
		ДокументСделки.Контрагент = Строчка.Брокер;
		ДокументСделки.ДоговорКонтрагента = Строчка.ДоговорБрокера; 
		ДокументСделки.Биржа = Строчка.Биржа;
		ДокументСделки.КурсВзаиморасчетов = 1;
		ДокументСделки.КратностьВзаиморасчетов = 1;
		ДокументСделки.ВалютаДокумента = Строчка.Валюта;
		ДокументСделки.ВидОбращаемости = Перечисления.ВидыОбращаемостиЦБ.ОбращающиесяЦБВРублях;
		ДокументСделки.НомерВходящегоДокумента = Строчка.НомерСделки;
		ДокументСделки.БУ = Истина;
		Если ВестиТолькоБухгалтерскийУчет Тогда
			ДокументСделки.ВУ = Ложь;
			ДокументСделки.УУ = Ложь;
		Иначе
			ДокументСделки.ВУ = Истина;
			ДокументСделки.УУ = Истина;
			ДокументСделки.АналитическийСчетДС = Строчка.АналитическийСчетДС;
			ДокументСделки.АналитическийСчет = Строчка.АналитическийСчетЦБ;
			ДокументСделки.ФизическоеМестоХраненияДС =  Строчка.ФизическоеМестоХраненияДС;
		КонецЕсли;
		ДокументСделки.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
		//ДокументСделки.УправляющаяКомпания = ДоговорДУ.УправляющаяКомпания;
		
		ДокументСделки.ДопРасходы.Очистить();
		
		ДокументСделки.ПометкаУдаления = Ложь;
		
		ДокументСделки.Актив 		= Строчка.Бумага;
		ДокументСделки.Цена 		= Строчка.Цена;
		ДокументСделки.Количество 	= Строчка.Количество;
		ДокументСделки.Сумма	 	= Строчка.Сумма;
		ДокументСделки.НКД 			= Строчка.НКД;
		
		Если ЗначениеЗаполнено(ДокументСделки.Актив) И  ЗначениеЗаполнено(ДокументСделки.Актив.ВидАктива)Тогда
		
			Если ДокументСделки.Актив.ВидАктива.ПринадлежитЭлементу(ПланыВидовХарактеристик.ВидыАктивов.Облигации) Тогда
				НоминальнаяСтоимость = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(ДокументСделки.Актив.Объект, ДатаДокумента);
				ДокументСделки.КотировкаОблигации = ?(НоминальнаяСтоимость=0,0,ДокументСделки.Цена/НоминальнаяСтоимость*100);
			КонецЕсли;
		
		КонецЕсли;
		
		Попытка
			ВалютаЦБ = Строчка.Бумага.Объект.ВалютаНоминальнойСтоимости;
		Исключение		
			ВалютаЦБ = Неопределено;
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(ВалютаЦБ) ИЛИ ВалютаЦБ = Строчка.ДоговорДУ.Валюта Тогда
			ВалютаЦБ = Строчка.ДоговорДУ.Валюта;
			
			ДокументСделки.ВалютаЦБ = ВалютаЦБ;
			ДокументСделки.КурсЦБ = 1;
			ДокументСделки.КратностьЦБ = 1;
			
			ДокументСделки.СуммаНКДВВалютеНоминальнойСтоимости = Строчка.НКД;
			ДокументСделки.СуммаВВалютеНоминальнойСтоимости = Строчка.Сумма;
		Иначе			
			КурсКраностьЦБ = МодульВалютногоУчета.ПолучитьКурсВалюты(ДоговорДУ.Валюта, ВалютаЦБ, ДатаДокумента);
			
			ДокументСделки.ВалютаЦБ = ВалютаЦБ;
			ДокументСделки.КурсЦБ = КурсКраностьЦБ.Курс;
			ДокументСделки.КратностьЦБ = КурсКраностьЦБ.Кратность;						
			
			ДокументСделки.СуммаНКДВВалютеНоминальнойСтоимости = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(Строчка.НКД, Строчка.ДоговорДУ.Валюта, ВалютаЦБ, 1, КурсКраностьЦБ.Курс, 1, КурсКраностьЦБ.Кратность);
			ДокументСделки.СуммаВВалютеНоминальнойСтоимости = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(Строчка.Сумма, Строчка.ДоговорДУ.Валюта, ВалютаЦБ, 1, КурсКраностьЦБ.Курс, 1, КурсКраностьЦБ.Кратность);
		КонецЕсли;					
		
		Если Строчка.Количество <> 0 Тогда
			ДокументСделки.НКДед = Строчка.НКД / Строчка.Количество;
		КонецЕсли;	
		Если Строчка.Бумага.ВидАктива.Родитель = ПВХ.Акции Тогда
			ДокументСделки.СчетУчетаАктива = ПС.АкцииТело;
		ИначеЕсли Строчка.Бумага.ВидАктива.Родитель = ПВХ.Облигации Тогда	
			ДокументСделки.СчетУчетаАктива = ПС.ОблигацииТело;
		КонецЕсли;	
		
		//Заполнение ТЧ Доп. расходы
		Если Строчка.КомиссияБрокера > 0 Тогда
			СтрокаДопРасходов 								= ДокументСделки.ДопРасходы.Добавить();
			СтрокаДопРасходов.СтатьяЗатрат 					= Справочники.СтатьиДоходовИРасходов.КомиссияБрокера;
			СтрокаДопРасходов.СтатьяДДС                     = Справочники.СтатьиДвиженияДенежныхСредств.КомиссияПосредника;
			СтрокаДопРасходов.СчетУчетаЗатрат 				= Справочники.СтатьиДоходовИРасходов.КомиссияБрокера.СчетУчета;
			СтрокаДопРасходов.СчетУчетаЗатратКонтрагента 	= ПС.РасчетыБрокераПоСделкам;
			СтрокаДопРасходов.Стоимость 					= Строчка.КомиссияБрокера;
			СтрокаДопРасходов.ДопСведения					= "Комиссия брокера";
			Если ДокументСделки.ВидОперации = Перечисления.ВидыОперацийСделка.Поступление Тогда
				СтрокаДопРасходов.ВключатьВСтоимость 		= Истина;
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаДопРасходов.СчетУчетаЗатрат) Тогда
					СтрокаДопРасходов.СчетУчетаЗатрат 		= ПС.РасходыПоПродажам;			
				КонецЕсли;				
			КонецЕсли;	
		КонецЕсли;
		
		Если Строчка.КомиссияБиржи > 0 Тогда
			СтрокаДопРасходов 								= ДокументСделки.ДопРасходы.Добавить();
			СтрокаДопРасходов.СтатьяЗатрат 					= Справочники.СтатьиДоходовИРасходов.КомиссияБиржи;
			СтрокаДопРасходов.СтатьяДДС                     = Справочники.СтатьиДвиженияДенежныхСредств.КомиссияПосредника;
			СтрокаДопРасходов.СчетУчетаЗатрат 				= Справочники.СтатьиДоходовИРасходов.КомиссияБрокера.СчетУчета;
			Если Не ЗначениеЗаполнено(СтрокаДопРасходов.СчетУчетаЗатрат) Тогда
				СтрокаДопРасходов.СчетУчетаЗатрат = ПС.РасходыПоПродажам;			
			КонецЕсли;			
			СтрокаДопРасходов.СчетУчетаЗатратКонтрагента 	= ПС.РасчетыБрокераПоСделкам;
			СтрокаДопРасходов.Стоимость 					= Строчка.КомиссияБиржи;
			СтрокаДопРасходов.ДопСведения					= "Комиссия биржи";
			Если ДокументСделки.ВидОперации = Перечисления.ВидыОперацийСделка.Поступление Тогда
				СтрокаДопРасходов.ВключатьВСтоимость 		= Истина;
			Иначе
				Если Не ЗначениеЗаполнено(СтрокаДопРасходов.СчетУчетаЗатрат) Тогда
					СтрокаДопРасходов.СчетУчетаЗатрат 		= ПС.РасходыПоПродажам;			
				КонецЕсли;				
			КонецЕсли;
		КонецЕсли;
		
		ДокументСделки.СуммаДопРасходов 					= ДокументСделки.ДопРасходы.Итог("Стоимость");
		
		Попытка
			ДокументСделки.Записать();
			Если СписокДоков.НайтиПоЗначению(ДокументСделки.Ссылка) = Неопределено Тогда
				СписокДоков.Добавить(ДокументСделки.Ссылка);	
			КонецЕсли;	
		Исключение
			Сообщить("Не удалось записать данные строки №" + НомСтр);
		КонецПопытки;	
		
	КонецЦикла;	
	
	
	Счетчик = 0;
	
	//Проведение документов
	Для Каждого ЭлементСписка Из СписокДоков Цикл
		
		Док = ЭлементСписка.Значение;
		
		Счетчик = Счетчик + 1;	
		
		ДокОбъект = Док.ПолучитьОбъект();
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Не удалось провести документ " + Док);
		КонецПопытки;	
		
	КонецЦикла;
	
	Сообщить("Проведение документов завершено.", СтатусСообщения.Информация);
	
	СверитьДанныеСервер();
	
КонецПроцедуры // СоздатьОбъектыСервер()


&НаКлиенте
