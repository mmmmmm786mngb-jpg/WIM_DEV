	Для каждого Строка Из Объект.ТаблицаДанных2 Цикл
		Если Команда.Имя = "ТаблицаДанных2УдалитьЗеленые" И НЕ Строка.Документ = ПредопределенноеЗначение("Документ.ОперацияПоСчетуБрокера.ПустаяСсылка") Тогда
			МассивУдаления.Добавить(Строка);
