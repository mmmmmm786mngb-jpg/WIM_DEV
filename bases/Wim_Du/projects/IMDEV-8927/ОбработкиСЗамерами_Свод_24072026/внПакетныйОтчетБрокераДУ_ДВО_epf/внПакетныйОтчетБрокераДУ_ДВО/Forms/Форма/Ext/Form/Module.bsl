&НаСервере
Процедура СоздатьУниверсальноеСопоставление(КонтекстСопоставления, КонтекстОбъекта, НашОбъект, ВнешнийОбъект)
	
	Попытка
		Если НашОбъект<>Неопределено Тогда		
			//Удалить старые записи
			Набор = РегистрыСведений.УниверсальныеСопоставления.СоздатьНаборЗаписей();
			Набор.Отбор.КонтекстСопоставления.Установить(Перечисления.КонтекстСопоставления[КонтекстСопоставления]);
			Если ВнешнийОбъект="" Тогда 
				// Режим торгов
				Набор.Отбор.НашОбъект.Установить(НашОбъект);
			Иначе	
				// FX_ПИФ / FX_ТорговыйКод
				Набор.Отбор.ВнешнийОбъект.Установить(ВнешнийОбъект);
				Набор.Отбор.КонтекстОбъекта.Установить(КонтекстОбъекта);
			КонецЕсли;
			Набор.Записать(Истина);
			
			Запись = РегистрыСведений.УниверсальныеСопоставления.СоздатьМенеджерЗаписи();
			Запись.КонтекстСопоставления 	= Перечисления.КонтекстСопоставления[КонтекстСопоставления];
			Запись.КонтекстОбъекта 			= КонтекстОбъекта;
			Запись.НашОбъект 				= НашОбъект;
			Запись.ВнешнийОбъект 			= ВнешнийОбъект;
			Запись.Записать(Истина);
		КонецЕсли;
	Исключение
		Сообщить("Ошибка создания универсального сопоставления: " + ОписаниеОшибки());
	КонецПопытки;	
	
КонецПроцедуры

