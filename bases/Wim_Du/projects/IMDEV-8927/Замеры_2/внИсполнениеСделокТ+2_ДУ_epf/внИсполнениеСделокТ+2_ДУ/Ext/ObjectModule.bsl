		Возврат
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Справочник.Контрагенты) КАК Брокер
	               |ПОМЕСТИТЬ ВТ_Брокеры
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект ССЫЛКА Справочник.Контрагенты
	               |	И ДополнительныеСведения.Свойство = &Свойство
	               |	И ДополнительныеСведения.Значение = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СделкиTn.Ссылка,
	               |	СделкиTn.Стартован,
	               |	СделкиTn.АналитическийСчетДС,
	               |	СделкиTn.Сумма
	               |ИЗ
	               |	БизнесПроцесс.СделкиTn КАК СделкиTn
	               |ГДЕ
	               |	НЕ СделкиTn.ПометкаУдаления
	               |	И НЕ СделкиTn.Завершен
	               |	И НАЧАЛОПЕРИОДА(СделкиTn.Дата, ДЕНЬ) = &Дата
	               |	И СделкиTn.Контрагент В
	               |			(ВЫБРАТЬ
	               |				ВТ_Брокеры.Брокер
	               |			ИЗ
	               |				ВТ_Брокеры КАК ВТ_Брокеры)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Сделка.Ссылка,
	               |	ИСТИНА,
	               |	Сделка.АналитическийСчетДС,
	               |	Сделка.Сумма
	               |ИЗ
	               |	Документ.Сделка КАК Сделка
	               |ГДЕ
	               |	НЕ Сделка.ПометкаУдаления
	               |	И НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) = &Дата
	               |	И Сделка.Контрагент В
	               |			(ВЫБРАТЬ
	               |				ВТ_Брокеры.Брокер
	               |			ИЗ
	               |				ВТ_Брокеры КАК ВТ_Брокеры)
	               |	И Сделка.БизнесПроцесс = НЕОПРЕДЕЛЕНО";
	Запрос.УстановитьПараметр("Свойство", ДопСвойство);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаИсполнения));
	
	Данные = Запрос.Выполнить().Выгрузить();
	Данные.Индексы.Добавить("АналитическийСчетДС"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОткрытиеПлановойПозиции.Ссылка,
	               |	ОткрытиеПлановойПозиции.Проведен,
	               |	ОткрытиеПлановойПозиции.БизнесПроцесс,
	               |	ОткрытиеПлановойПозиции.КомиссияБрокера,
	               |	0 КАК СуммаДокумента
	               |ИЗ
	               |	Документ.ОткрытиеПлановойПозиции КАК ОткрытиеПлановойПозиции
	               |ГДЕ
	               |	НЕ ОткрытиеПлановойПозиции.ПометкаУдаления
	               |	И ОткрытиеПлановойПозиции.БизнесПроцесс В(&БизнесПроцесс)
	               |	И НАЧАЛОПЕРИОДА(ОткрытиеПлановойПозиции.Дата, ДЕНЬ) = &Дата
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОперацияПоСчетуБрокера.Ссылка,
	               |	ОперацияПоСчетуБрокера.Проведен,
	               |	ОперацияПоСчетуБрокера.БизнесПроцесс,
	               |	0,
	               |	ОперацияПоСчетуБрокера.СуммаДокумента
	               |ИЗ
	               |	Документ.ОперацияПоСчетуБрокера КАК ОперацияПоСчетуБрокера
	               |ГДЕ
	               |	НЕ ОперацияПоСчетуБрокера.ПометкаУдаления
	               |	И ОперацияПоСчетуБрокера.БизнесПроцесс В(&БизнесПроцесс)
	               |	И ОперацияПоСчетуБрокера.СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.СтатьиДоходовИРасходов.КомиссияБрокера)
	               |	И НАЧАЛОПЕРИОДА(ОперацияПоСчетуБрокера.Дата, ДЕНЬ) = &Дата";
	Запрос.УстановитьПараметр("БизнесПроцесс", Данные.ВыгрузитьКолонку("Ссылка"));
	Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаИсполнения));
	ПодчиненныеДокументы = Запрос.Выполнить().Выгрузить();
	ПодчиненныеДокументы.Индексы.Добавить("БизнесПроцесс"); 
	
	СписокАС = Данные.Скопировать();
	СписокАС.Свернуть("АналитическийСчетДС", "Сумма");
	
	ОбщаяСуммаОборот = СписокАС.Итог("Сумма");
	
	Для Каждого Строка ИЗ СписокАС Цикл
				
		КомиссияБрокераОбщая = 0; 
		
		Сообщить("АС " + Строка(Строка.АналитическийСчетДС));
	
		ДоговорБрокера = Строка.АналитическийСчетДС.ДоговорКонтрагента;
		Сообщить("Договор брокера " + Строка(Строка.АналитическийСчетДС.ДоговорКонтрагента)); 
		
		Если ДоговорБрокера.Пустая() Тогда
			ТекстОшибки = "Определить общую комиссию невозможно";
			Продолжить;
		Иначе
			
			НоваяСделка = Новый Структура; 
			НоваяСделка.Вставить("ДоговорДУ", Строка.АналитическийСчетДС.ДоговорДУ);
			НоваяСделка.Вставить("Сумма", Строка.Сумма);
			НоваяСделка.Вставить("ОбщаяСуммаОборот", ОбщаяСуммаОборот);
			НоваяСделка.Вставить("ДатаСделки", ДатаИсполнения);
			НоваяСделка.Вставить("РежимТоргов", "");
			НоваяСделка.Вставить("РЕПОСрок", 0);
			НоваяСделка.Вставить("ВалютаСделки", Справочники.Валюты.RUB);
			НоваяСделка.Вставить("КурсВалютыСделки", 1);
						
			Результат = Справочники.ДоговорыКонтрагентов.РезультатАлгоритма(ДоговорБрокера, НоваяСделка, ТекстОшибки);
			Если Результат <> Неопределено Тогда
				КомиссияБрокераОбщая = Результат;
			КонецЕсли;
			
		КонецЕсли;    
		
		Сообщить("Оборот " + Формат(Строка.Сумма, "ЧДЦ=2"));
		Сообщить("Общая комиссия " + Формат(КомиссияБрокераОбщая, "ЧДЦ=2; ЧН=Ноль"));
		
		Если КомиссияБрокераОбщая = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("АналитическийСчетДС", Строка.АналитическийСчетДС);
		
		ДанныеПоАС = Данные.Скопировать(Отбор);
		
		СуммаКомиссий = 0;  
		ДанныеПоАС.Сортировать("Сумма");
		Сч = 1;
		Для Каждого Сделка из ДанныеПоАС Цикл
			
			НоваяКомиссия = Окр((Сделка.Сумма / Строка.Сумма) * КомиссияБрокераОбщая, 2);
			СуммаКомиссий = СуммаКомиссий + НоваяКомиссия; 
			
			// Корректировка итоговой комиссии
			Если Сч = ДанныеПоАС.Количество() Тогда
				Дельта = КомиссияБрокераОбщая - СуммаКомиссий; 	
				НоваяКомиссия = НоваяКомиссия + Дельта;	 
				Сообщить("Дельта " + Строка(Дельта));
			КонецЕсли;       					
			
			Если ТипЗнч(Сделка.Ссылка) = Тип("БизнесПроцессСсылка.СделкиTn") Тогда
				
				ОтборБП = Новый Структура;
				ОтборБП.Вставить("БизнесПроцесс", Сделка.Ссылка);
				
				СписокПодчиненных = ПодчиненныеДокументы.НайтиСтроки(ОтборБП);
				
				ОбновитьКомиссиюВБизнесПроцессе(Сделка.Ссылка, СписокПодчиненных, НоваяКомиссия);
				
			ИначеЕсли ТипЗнч(Сделка.Ссылка) = Тип("ДокументСсылка.Сделка") Тогда
				
				ОбновитьКомиссиюВСделке(Сделка.Ссылка, НоваяКомиссия);				
				
			КонецЕсли;
			
			Сч = Сч + 1;
		
		КонецЦикла;	
			
	КонецЦикла;	
	
	
КонецПроцедуры 

Процедура ОбновитьКомиссиюВБизнесПроцессе(СделкаСсылка, СписокПодчиненных, НоваяКомиссия)
	
 	ОбСделка = СделкаСсылка.ПолучитьОбъект();
	ОбСделка.КомиссияБрокера = НоваяКомиссия; 
	ОбСделка.ОбменДанными.Загрузка = Истина;
	Попытка 
		ОбСделка.Записать();
	Исключение;
	КонецПопытки;   
	
	Если СделкаСсылка.Стартован Тогда
		
		Для Каждого Док из СписокПодчиненных Цикл
			
			ОбДок = Док.Ссылка.ПолучитьОбъект();
			Если ТипЗнч(ОбДок.Ссылка) = Тип("ДокументСсылка.ОткрытиеПлановойПозиции") Тогда
				ОбДок.КомиссияБрокера = НоваяКомиссия;
			ИначеЕсли ТипЗнч(ОбДок.Ссылка) = Тип("ДокументСсылка.ОперацияПоСчетуБрокера") Тогда
				ОбДок.СуммаДокумента = НоваяКомиссия;
				ОбДок.СуммаДокументаРуб = НоваяКомиссия;
			КонецЕсли;
			
			Если Док.Проведен Тогда
				
				Попытка 
					ОбДок.Записать(РежимЗаписиДокумента.Проведение);
				Исключение;
				КонецПопытки;						
							
			Иначе
				ОбДок.ОбменДанными.Загрузка = Истина;
				ОбДок.Записать();						
			КонецЕсли;
			
		КонецЦикла;			
		
	КонецЕсли;
	
КонецПроцедуры   

Процедура ОбновитьКомиссиюВСделке(СделкаСсылка, НоваяКомиссия)
	
 	ОбСделка = СделкаСсылка.ПолучитьОбъект();
	//ОбСделка = Документы.Сделка.СоздатьДокумент();
	
	РежимЗаписи = РежимЗаписиДокумента.Проведение;
	
	Если НЕ СделкаСсылка.Проведен Тогда
		ОбСделка.ОбменДанными.Загрузка = Истина;
		РежимЗаписи = РежимЗаписиДокумента.Запись;	
	КонецЕсли;
	
	Для Каждого Затрата из ОбСделка.ДопРасходы Цикл
		
		Если Затрата.СтатьяЗатрат = Справочники.СтатьиДоходовИРасходов.КомиссияБрокера Тогда
			Затрата.Стоимость = НоваяКомиссия;		
		КонецЕсли;
		
	КонецЦикла;	
	
	Попытка 
		ОбСделка.Записать(РежимЗаписи);
	Исключение;
	КонецПопытки;   		
	
КонецПроцедуры

Процедура ОтправитьСообщениеОбОшибкеПриРасчетеКомиссии(Комментарий)

	Если СписокРассылки.Количество()>0 и НЕ ПочтовыйЛогин.Пустая() Тогда
		ПрипискаРассылки = "r2.3";
		
		ТемаСообщения = "Аванкор ДУ: Ошибка при перерасчете комиссии (дневные обороты) (" + Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'; ДП=") + ")";
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, Вложения, Важность");
		ПараметрыПисьма.Тема = "{OK} " + ТемаСообщения + ПропискаРассылки(ПрипискаРассылки);
		
		Кому = Новый Массив;
		Для Каждого ТекЯщик из СписокРассылки Цикл
			Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
			// текстРассылки = текстРассылки+ТекЯщик.АдресЭлектроннойПочты;
		КонецЦикла;
		
		ПараметрыПисьма.Вложения = Новый Соответствие;
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.Тело = Комментарий;
		ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Высокая;  
			
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
			ТекстРассылки = "Рассылка завершена";
		Исключение
			ТекстРассылки = "Рассылка не удалась: "; 
		КонецПопытки;
	КонецЕсли;	
	
КонецПроцедуры
