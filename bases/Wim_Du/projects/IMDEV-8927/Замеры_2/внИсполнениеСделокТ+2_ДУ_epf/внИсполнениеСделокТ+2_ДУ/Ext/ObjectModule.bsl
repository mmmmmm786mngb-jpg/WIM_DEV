//IMAPPS-36216 ++
Процедура ПересчитатьКурсКомиссийВСделкахОбратногоРЕПО() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СделкиРЕПО.Ссылка КАК Ссылка,
	               |	СделкаРЕПОВтораяНога.Ссылка КАК СделкаРЕПОВтораяНога
	               |ИЗ
	               |	БизнесПроцесс.СделкиРЕПО КАК СделкиРЕПО
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПОВтораяНога КАК СделкаРЕПОВтораяНога
	               |		ПО СделкиРЕПО.Ссылка = СделкаРЕПОВтораяНога.БизнесПроцесс
	               |ГДЕ
	               |	НЕ СделкиРЕПО.ПометкаУдаления
	               |	И НАЧАЛОПЕРИОДА(СделкиРЕПО.ДатаОплатыВторойЧастиСделкиРЕПО, ДЕНЬ) = &Дата
	               |	И СделкиРЕПО.Контрагент = &ВТББрокер";
	Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаИсполнения));
	Запрос.УстановитьПараметр("ВТББрокер", Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", "7702070139"));
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	Выборка = Результат.Выбрать();	
	Пока Выборка.Следующий() Цикл
		
		СделкаРЕПО = Выборка.Ссылка.ПолучитьОбъект(); 
		СделкаРЕПО.ОбменДанными.Загрузка = Истина; 
		Изменения = Ложь;
		КурсКратность2ЧастьРЕПО = МодульВалютногоУчета.ПолучитьКурсВалютыПоПортфелю(СделкаРЕПО.ДоговорДУ, СделкаРЕПО.ВалютаДокумента, СделкаРЕПО.ДатаОплатыВторойЧастиСделкиРЕПО);

		Если СделкаРЕПО.КомиссияБиржиВторойЧастиРЕПО > 0 Тогда 
			Изменения = Истина;
			СделкаРЕПО.КурсКомиссииБиржи2ЧастьРЕПО = КурсКратность2ЧастьРЕПО.Курс;
			СделкаРЕПО.КратностьКомиссииБиржи2ЧастьРЕПО =  КурсКратность2ЧастьРЕПО.Кратность;
		КонецЕсли;
		Если СделкаРЕПО.КомиссияБрокераВторойЧастиРЕПО > 0 Тогда 
			Изменения = Истина;
			СделкаРЕПО.КурсКомиссииБрокера2ЧастьРЕПО = КурсКратность2ЧастьРЕПО.Курс;
			СделкаРЕПО.КратностьКомиссииБрокера2ЧастьРЕПО = КурсКратность2ЧастьРЕПО.Кратность;
		КонецЕсли;
		
		Если Изменения Тогда
			Попытка 
				СделкаРЕПО.Записать();
			Исключение;
				ТекстОшибки = "Ошибка при пересчете комиссий в БП сделки РЕПО " + СделкаРЕПО.Номер + " : " + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("Фоновое исполнение сделок Т+n", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			КонецПопытки; 
			Если НЕ Выборка.СделкаРЕПОВтораяНога.Пустая() Тогда
				СделкаРЕПО2Нога = Выборка.СделкаРЕПОВтораяНога.ПолучитьОбъект();
				СделкаРЕПО2Нога.ОбменДанными.Загрузка = Истина; 
				СделкаРЕПО2Нога.КурсВзаиморасчетов = КурсКратность2ЧастьРЕПО.Курс;
				СделкаРЕПО2Нога.КратностьВзаиморасчетов = КурсКратность2ЧастьРЕПО.Кратность;
				Для Каждого СтрокаРасходы Из СделкаРЕПО2Нога.ДопРасходы Цикл
					СтрокаРасходы.КурсКомиссии = КурсКратность2ЧастьРЕПО.Курс;
					СтрокаРасходы.КратностьКомиссии = КурсКратность2ЧастьРЕПО.Кратность;
				КонецЦикла; 
				Попытка 
					СделкаРЕПО2Нога.Записать();
				Исключение;
					ТекстОшибки = "Ошибка при пересчете комиссий в сделке РЕПО 2 нога : " + СделкаРЕПО2Нога.Номер + ОписаниеОшибки();
					ЗаписьЖурналаРегистрации("Фоновое исполнение сделок Т+n", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				КонецПопытки; 
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;  

КонецПроцедуры;
