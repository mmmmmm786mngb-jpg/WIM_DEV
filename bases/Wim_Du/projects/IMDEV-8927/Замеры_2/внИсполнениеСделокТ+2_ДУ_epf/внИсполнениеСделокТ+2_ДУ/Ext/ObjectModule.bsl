Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	// MPazhukov IMAPPS-11733
	//Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда Возврат; КонецЕсли;
	Если Найти(ИдентификаторКоманды,"ФоновоеВыполнение") = 0 Тогда Возврат; КонецЕсли;
	
	// IMDEV-8927 ++
	ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
	// IMDEV-8927 --
	
	ДатаИсполнения = ТекущаяДата();
	
	// MPazhukov IMAPPS-12997
	Если ИдентификаторКоманды = "ФоновоеВыполнение_ПотоковоеИсполнениеСделок" Тогда
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды);
		Возврат;
	КонецЕсли;
	// MPazhukov IMAPPS-12997
	
	// IMAPPS-16444 -->
	Если ИдентификаторКоманды = "ФоновоеВыполнениеПотоковое_ТМинус1" Тогда
		ДатаИсполнения = ТекущаяДата() - 86400;
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды, "На Т-1");
		Возврат;
	КонецЕсли;
	// IMAPPS-16444 <-
	
	Если ИдентификаторКоманды = "ФоновоеВыполнение_ПотоковоеИсполнениеСделокПул" Тогда
		ДатаИсполнения = НачалоДня(ТекущаяДата());
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды, "Пул");
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторКоманды = "ФоновоеВыполнение_ПотоковоеИсполнениеСделокПул_ТМинус1" Тогда
		ДатаИсполнения = НачалоДня(ТекущаяДата()) - 86400;
		ВыполнитьСделкиПотоки(ПараметрыВыполненияКоманды, "Пул");
		Возврат;
	КонецЕсли;

	
	//// MPazhukov IMAPPS-11733
	//Если ИдентификаторКоманды = "ФоновоеВыполнение_ТМинус1" Тогда
	//	ДатаИсполнения = ТекущаяДата() - 86400;
	//КонецЕсли;	
	//// MPazhukov IMAPPS-11733
	
	ВыполнитьСделки(Истина, ,ПараметрыВыполненияКоманды);
	
	// IMDEV-8927 ++
	ИдентификаторКомандыДляЗамера = Неопределено;
	// IMDEV-8927 --
КонецПроцедуры

// IMDEV-8927 ++
// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Формирует имя ключевой операции БСП для замера
// по этапу обработки и контуру запуска.
//
// Параметры:
// ЭтапЗамера - Строка - этап замера (например, ИсполнениеВПотоках)
//
// Возвращаемое значение:
// Строка - имя ключевой операции в формате ДУ.ИсполнениеСделокТ+n.<Этап>.<Контур>
//
Функция ПолучитьИмяКлючевойОперацииЗамера(Знач ЭтапЗамера)
	Возврат "ДУ.ИсполнениеСделокТ+n." + ЭтапЗамера + "."
		+ ?(ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера), ИдентификаторКомандыДляЗамера, "Ручной");
КонецФункции
