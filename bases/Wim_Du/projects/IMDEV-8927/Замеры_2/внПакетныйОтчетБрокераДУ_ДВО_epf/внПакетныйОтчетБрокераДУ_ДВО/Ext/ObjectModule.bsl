Функция ПолучитьСуммуДивидентовНаОднуАкцию(ДоговорДУ, Акция, СуммаНачисления, ДатаПолученияОстатков)
	
	КоличествоАкций = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ХозрасчетныйОстатки.КоличествоОстаток КАК Количество,
	|	ХозрасчетныйОстатки.СуммаОстаток
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&ДатаПолученияОстатков,
	|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.АкцииТело),
	|			,
	|			(ВЫРАЗИТЬ(Субконто1 КАК Справочник.Акции)) = &Акция
	|				И ДоговорДУ = &ДоговорДУ
	|				) КАК ХозрасчетныйОстатки";
	Запрос.УстановитьПараметр("Счет",ПланыСчетов.Хозрасчетный.АкцииТело);
	Запрос.УстановитьПараметр("Акция", Акция);
	Запрос.УстановитьПараметр("ДатаПолученияОстатков", ДатаПолученияОстатков);
	Запрос.УстановитьПараметр("ДоговорДУ",ДоговорДУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КоличествоАкций = Выборка.Количество;
	КонецЕсли;
	
