Функция ПреобразоватьСтрокуВДату(ДатаСтрока)
	
	ПреобразованнаяДата = '00010101';
	
	Если СтрНайти(ДатаСтрока, "/") > 0 Тогда
		
		ВремТекст = новый ТекстовыйДокумент;
		ВремТекст.УстановитьТекст(СтрЗаменить(ДатаСтрока, "/", Символы.ПС));
		
		Если ВремТекст.КоличествоСтрок() < 3 Тогда
			Возврат Дата(ПреобразованнаяДата);
		КонецЕсли;
		
		Попытка
			ПреобразованнаяДата = Дата(Прав("000"+ВремТекст.ПолучитьСтроку(3), 4) + Прав("000"+ВремТекст.ПолучитьСтроку(1), 2) + Прав("000"+ВремТекст.ПолучитьСтроку(2), 2));
		Исключение			
		КонецПопытки;
		
	Иначе
		
		Если ЗначениеЗаполнено(ДатаСтрока) Тогда
			Если СтрДлина(ДатаСтрока) = 10 Тогда // формат даты ДД.ММ.ГГГГ
				Попытка
					ПреобразованнаяДата = Дата(Прав(ДатаСтрока, 4) + Сред(ДатаСтрока, 4, 2) + Лев(ДатаСтрока, 2));
				Исключение			
				КонецПопытки;
			КонецЕсли;	
		КонецЕсли;	
	
	КонецЕсли;
	
	Возврат ПреобразованнаяДата;
	
КонецФункции // ПреобразоватьСтрокуВДату()

