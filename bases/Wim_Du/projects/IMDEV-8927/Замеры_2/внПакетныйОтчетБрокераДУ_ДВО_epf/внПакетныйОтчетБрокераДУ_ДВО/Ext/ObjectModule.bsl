Функция КоличествоАктивныхЗаданий(МассивФоновыхЗаданий)
	
	КоличествоАктивных = 0;
	
	Для каждого ДанныеФоновогоЗадания Из МассивФоновыхЗаданий Цикл
		ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ДанныеФоновогоЗадания.УникальныйИдентификатор);
		Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			КоличествоАктивных = КоличествоАктивных + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат КоличествоАктивных;
	
КонецФункции

Процедура ОжидатьЗавершенияАктивныхЗаданий(МассивФоновыхЗаданий, ЛимитФоновыхЗаданий)
	
	КоличествоАктивных = КоличествоАктивныхЗаданий(МассивФоновыхЗаданий);
	
	Пока КоличествоАктивных >= ЛимитФоновыхЗаданий И НЕ КоличествоАктивных = 0 Цикл
		
		Если НЕ ЭтоВызовСКлиента Тогда
			ВызватьПаузу(5000); // Платформенная реализация 8.3.25 без использования CPU
		Иначе
			// При вызове с клиента (из формы) ВызватьПаузу падает с ошибкой
			// вызываем колхоз
			ОбщегоНазначенияДУ.Задержка(5);
		КонецЕсли;
		КоличествоАктивных = КоличествоАктивныхЗаданий(МассивФоновыхЗаданий);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьОперацииПоБрокерскомуСчетуВПотоках(Важность,Выводить = Истина)
	
	Если НЕ ТаблицаДанных2.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	// IMDEV-8927 ++
	ВремяНачалаЗамераСозданиеОпераций = 0;
	КлючеваяОперацияСозданиеОпераций = "";
	КоличествоСтрокКОбработкеЗамера = ТаблицаДанных2.Количество();
	Если ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера) Тогда
		КлючеваяОперацияСозданиеОпераций = ПолучитьИмяКлючевойОперацииЗамера("СозданиеОпераций");
		ВремяНачалаЗамераСозданиеОпераций = ОценкаПроизводительности.НачатьЗамерВремени();
	КонецЕсли;
	// IMDEV-8927 --
	
	ТаблицаДанных2.Сортировать("Дата Возр");
	
	КоличествоПотоков = 6;
	
	// Т.к. в алгоритме взятом из СоздатьОперацииПоБрокерскомуСчету есть проверка на дубли созданных документов
	// и при последовательном выполнении дубли выявляются в созданных документах
	// для поддержания этой логики необходимо потоки разделить так, чтобы "дубли" были в одном потоке
	// для этого достаточно, чтобы один ДоговорДУ был в одном потоке
	
	РаспределениеТаблицаДанных2 = Новый ТаблицаЗначений;
	РаспределениеТаблицаДанных2.Колонки.Добавить("ТаблицаДанных2");
	РаспределениеТаблицаДанных2.Колонки.Добавить("КоличествоСтрок", Новый ОписаниеТипов("Число"));
	
	Для Сч = 1 По КоличествоПотоков Цикл 
		СтрокаРаспределения = РаспределениеТаблицаДанных2.Добавить();
		СтрокаРаспределения.ТаблицаДанных2 = ТаблицаДанных2.ВыгрузитьКолонки();
	КонецЦикла;
	
	Отбор = Новый Структура("ДоговорДУ");
	Для каждого Строка Из ТаблицаДанных2 Цикл
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		
		НайденаСтрокаРаспределения = Ложь;
		Для каждого СтрокаРаспределения Из РаспределениеТаблицаДанных2 Цикл
			// Ищем ДоговорДУ в существующих записях
			НайденныеСтроки = СтрокаРаспределения.ТаблицаДанных2.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() Тогда
				НайденаСтрокаРаспределения = Истина;
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения.ТаблицаДанных2.Добавить(), Строка);
				СтрокаРаспределения.КоличествоСтрок = СтрокаРаспределения.ТаблицаДанных2.Количество();
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ НайденаСтрокаРаспределения Тогда
			// Выше не нашли ДоговорДУ, добавим его в самую маленькую таблицу
			РаспределениеТаблицаДанных2.Сортировать("КоличествоСтрок");
			СтрокаРаспределения = РаспределениеТаблицаДанных2.Получить(0);
			ЗаполнитьЗначенияСвойств(СтрокаРаспределения.ТаблицаДанных2.Добавить(), Строка);
			СтрокаРаспределения.КоличествоСтрок = СтрокаРаспределения.ТаблицаДанных2.Количество();
		КонецЕсли;
	КонецЦикла;
	
	
	// Передаем собранные потоки в Фоновое задание этой обработки
	МассивФоновыхЗаданий = Новый Массив;
	Для каждого СтрокаРаспределения Из РаспределениеТаблицаДанных2 Цикл
		
		АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, );
		ТаблицаДанных2Хран = Новый ХранилищеЗначения(СтрокаРаспределения.ТаблицаДанных2);

		ПараметрыВыполненияОбработки = Новый Структура;
		ПараметрыВыполненияОбработки.Вставить("ДополнительнаяОбработкаСсылка",ДополнительнаяОбработкаСсылка);
		ПараметрыВыполненияОбработки.Вставить("ТаблицаДанных2Хран", ТаблицаДанных2Хран);
		ПараметрыВыполненияОбработки.Вставить("Выводить", Выводить);
		ПараметрыВыполненияОбработки.Вставить("АдресХранилища", АдресХранилища);
		
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(ДополнительнаяОбработкаСсылка);
		МассивПараметров.Добавить("КомандаСоздатьОперацииПоБрокерскомуСчетуПоток");
		МассивПараметров.Добавить(ПараметрыВыполненияОбработки);
		
		ФонЗадание = ФоновыеЗадания.Выполнить("ДополнительныеОтчетыИОбработки.ВыполнитьКомандуОбработкиПоПараметрам", МассивПараметров);
		
		ДанныеФоновогоЗадания = Новый Структура;
		ДанныеФоновогоЗадания.Вставить("УникальныйИдентификатор", ФонЗадание.УникальныйИдентификатор);
		ДанныеФоновогоЗадания.Вставить("АдресХранилища", АдресХранилища);
		
		МассивФоновыхЗаданий.Добавить(ДанныеФоновогоЗадания);
		
		ОжидатьЗавершенияАктивныхЗаданий(МассивФоновыхЗаданий, КоличествоПотоков);
		
	КонецЦикла;
	
	// Ожидаем завершения всех фоновых
	ОжидатьЗавершенияАктивныхЗаданий(МассивФоновыхЗаданий, 0);
	
	// Получим результаты работы фоновых
	Для каждого ДанныеФоновогоЗадания Из МассивФоновыхЗаданий Цикл
		ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ДанныеФоновогоЗадания.УникальныйИдентификатор);
		Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			ДанныеВыполнения = ПолучитьИзВременногоХранилища(ДанныеФоновогоЗадания.АдресХранилища);
			Важность = Макс(Важность, ДанныеВыполнения.Важность);
			
			Для Каждого Сообщение Из ДанныеВыполнения.масСообщения Цикл
				масСообщения.Добавить(Сообщение);
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ДанныеВыполнения.ТелоПисьма) Тогда
				ТелоПисьма = ТелоПисьма + ДанныеВыполнения.ТелоПисьма;
			КонецЕсли;
			
		Иначе
			Важность = 2;
			Если ТипЗнч(ФоновоеЗадание.ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
				Инфо = ФоновоеЗадание.ИнформацияОбОшибке;
				ДобавитьСообщение("", Инфо.ИмяМодуля, Инфо.НомерСтроки,  Инфо.ИсходнаяСтрока, Инфо.Описание, СтатусСообщения.ОченьВажное);
			Иначе
				ДобавитьСообщение("", "", "",  "", "Фоновое задание потока не было корректно завершено! Данные об ошибке отсутствуют.", СтатусСообщения.ОченьВажное);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьСообщение("Проведение документов", "", "", "", "Завершено.", СтатусСообщения.Информация);
	
	// IMDEV-8927 ++
	Если ВремяНачалаЗамераСозданиеОпераций > 0 Тогда
		ВесЗамераСозданиеОпераций = ?(КоличествоСтрокКОбработкеЗамера > 0, КоличествоСтрокКОбработкеЗамера, 1);
		ОтказЗамераСозданиеОпераций = (Важность >= 2);
		КомментарийЗамераСозданиеОпераций = "СтрокКОбработке=" + КоличествоСтрокКОбработкеЗамера
			+ "; Потоков=" + КоличествоПотоков
			+ "; ФоновыхЗаданий=" + МассивФоновыхЗаданий.Количество()
			+ "; Важность=" + Важность
