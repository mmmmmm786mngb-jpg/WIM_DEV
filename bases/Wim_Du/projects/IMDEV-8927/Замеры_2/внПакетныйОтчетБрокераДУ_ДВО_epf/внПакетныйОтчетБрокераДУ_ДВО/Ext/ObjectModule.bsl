					Если НоваяСтрока.Актив = Справочники.Активы.ПустаяСсылка() Тогда // IMAPPS-23546 ++
						
						АктивОбъект = СоответствиеКодЦБНаБирже.Получить(НоваяСтрока.КодЦБ);
