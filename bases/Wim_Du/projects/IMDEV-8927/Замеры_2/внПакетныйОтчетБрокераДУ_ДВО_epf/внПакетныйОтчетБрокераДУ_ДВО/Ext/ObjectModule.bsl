		ОперацияДок.Контрагент = Строка.ТорговыйКодРасход.Брокер;
		ОперацияДок.СтрокаРазмешенияБрокерскогоСчета = "ОРЦБ";
		ОперацияДок.СуммаДокумента = Строка.Сумма;
		ОперацияДок.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
		ОперацияДок.ВалютаДокумента = Строка.ТорговыйКодРасход.АналитическийСчетДС.МестоХранения.ВалютаДенежныхСредств;
		Если ОперацияДок.ВалютаДокумента = Справочники.Валюты.RUB Тогда
			ОперацияДок.СуммаДокументаРуб = Строка.Сумма;
