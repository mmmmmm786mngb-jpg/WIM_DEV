			КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Справочники.Валюты.RUB,ОперацияДок.ВалютаДокумента, Строка.Дата);
			// IMAPPS-24664 ++
			//ОперацияДок.СуммаДокументаРуб = Строка.Сумма / КурсВалюты.Курс;
			ОперацияДок.СуммаДокументаРуб = Строка.Сумма * КурсВалюты.Курс;
			// IMAPPS-24664 --
		КонецЕсли;		
		
		// IMAPPS-24664 ++
		КурсКратность = МодульВалютногоУчета.ПолучитьКурсВалюты(Справочники.Валюты.RUB, ОперацияДок.ВалютаДокумента, Строка.Дата);
		ОперацияДок.КурсВзаиморасчетов 			= КурсКратность.Курс;
		ОперацияДок.КратностьВзаиморасчетов 	= КурсКратность.Кратность;
			
		ОперацияДок.КурсКорреспондента 			= КурсКратность.Курс;
		ОперацияДок.КратностьКорреспондента 	= КурсКратность.Кратность;
		// IMAPPS-24664 --
		
		ОперацияДок.АналитическийСчетКорреспондента = Строка.ТорговыйКодПриход.АналитическийСчетДС;
		ОперацияДок.ДоговорКорреспондента = Строка.ТорговыйКодПриход.ДоговорБрокера;
		ОперацияДок.Корреспондент = Строка.ТорговыйКодПриход.Брокер;
		ОперацияДок.СтрокаРазмешенияКорБрокерскогоСчета = "ОРЦБ";
