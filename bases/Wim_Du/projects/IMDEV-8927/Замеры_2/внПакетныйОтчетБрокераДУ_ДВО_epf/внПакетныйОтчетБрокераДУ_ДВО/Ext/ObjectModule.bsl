Функция НайтиПоНомерГосРегВНазначенииПлатежа(НазначениеПлатежа) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	// IMAPPS-28573 ++
	//	"ВЫБРАТЬ
	//	|	Облигации.Ссылка.ISIN КАК ISIN
	//	|ИЗ
	//	|	Справочник.Облигации КАК Облигации
	//	|ГДЕ
	//	|	ЕСТЬNULL(Облигации.Ссылка.НомерГосРегистрацииВыпуска, """") <> """"
	//	|	И &ISIN ПОДОБНО ""%"" + Облигации.Ссылка.НомерГосРегистрацииВыпуска + ""%""
	//	|	И Облигации.Ссылка.ПометкаУдаления = ЛОЖЬ";
	//Запрос.УстановитьПараметр("ISIN", НазначениеПлатежа);
	
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Облигации.Ссылка.ISIN КАК ISIN,
	|	Облигации.Ссылка КАК Ссылка,
	|	Облигации.Ссылка.НомерГосРегистрацииВыпуска КАК СсылкаНомерГосРегистрацииВыпуска,
	|	&НомерГосРегистрацииВыпуска КАК ISIN1,
	|	ДЛИНАСТРОКИ(Облигации.Ссылка.НомерГосРегистрацииВыпуска) КАК ДЛИНА
	|ИЗ
	|	Справочник.Облигации КАК Облигации
	|ГДЕ
	|	ЕСТЬNULL(Облигации.Ссылка.НомерГосРегистрацииВыпуска, """") <> """"
	|	И &НомерГосРегистрацииВыпуска ПОДОБНО ""%"" + Облигации.Ссылка.НомерГосРегистрацииВыпуска + ""%""
	|	И Облигации.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДЛИНА УБЫВ
	|";
	Запрос.Параметры.Вставить("НомерГосРегистрацииВыпуска", НазначениеПлатежа);
	// IMAPPS-28573 --
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ISIN;
	КонецЦикла;
	
	Возврат "";
КонецФункции


