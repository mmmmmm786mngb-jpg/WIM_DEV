Функция ОстаткиПоАналитическимСчетамБрокераДС(Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ХозрасчетныйОстаткиИОбороты.Субконто1 КАК Справочник.АналитическиеСчета) КАК АналитическийСчетДС,
	|	ХозрасчетныйОстаткиИОбороты.ДоговорДУ,
	|	ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстатокБД,
	|	ХозрасчетныйОстаткиИОбороты.СуммаОборотКт КАК СуммаОборотКтБД,
	|	ХозрасчетныйОстаткиИОбороты.СуммаОборотДт КАК СуммаОборотДтБД,
	|	ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстатокБД
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, День, , Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВУДС), , ) КАК ХозрасчетныйОстаткиИОбороты";
	
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница (НачалоДня(Дата),ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница (КонецДня(Дата), ВидГраницы.Включая));
	
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
КонецФункции // ()

