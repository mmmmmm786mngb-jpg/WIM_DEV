			ДокументОперацияПоСчетуБрокера.КратностьВзаиморасчетов 	= КурсКратность.Кратность; 
			ДокументОперацияПоСчетуБрокера.ВалютаДокумента 			= ВалютаПоСтроке;
			ДокументОперацияПоСчетуБрокера.ВалютаКорреспондента		= ВалютаПоСтроке;  
			ДокументОперацияПоСчетуБрокера.КурсКорреспондента      	= КурсКратность.Курс;
