//Kmusorin функция для поиска счета по торговому коду и валюте для http://jira/browse/IMAPPS-3207		   
Функция НайтиАналитическийСчетпоТорговомуКодуиВалюте(ТорговыйКод,Валюта,КодТорг = Неопределено)
	
	Запрос	= Новый Запрос;                                                                   
	Если КодТорг = Неопределено Тогда
		Запрос.Текст	= "ВЫБРАТЬ
		            	  |	ТорговыеКоды.АналитическийСчетДС.Ссылка КАК АналитическийСчетДССсылка
		            	  |ИЗ
		            	  |	Справочник.ТорговыеКоды КАК ТорговыеКоды
		            	  |ГДЕ
		            	  |	ТорговыеКоды.АналитическийСчетДС.МестоХранения.ВалютаДенежныхСредств.Ссылка = &Валюта
		            	  |	И ТорговыеКоды.ТорговыйКод ПОДОБНО &ТорговыйКод
		            	  |	И ТорговыеКоды.ПометкаУдаления = Ложь";
	Иначе	 
		Запрос.Текст	= "ВЫБРАТЬ
	            	  |	ТорговыеКоды.АналитическийСчетДС.Ссылка КАК АналитическийСчетДССсылка
	            	  |ИЗ
	            	  |	Справочник.ТорговыеКоды КАК ТорговыеКоды
	            	  |ГДЕ
	            	  |	ТорговыеКоды.ссылка = &КодТорг";
	
	КонецЕсли;	
	Запрос.УстановитьПараметр("ТорговыйКод", ТорговыйКод + "%");
	Запрос.УстановитьПараметр("КодТорг", КодТорг );
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Результат	= Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Справочники.ТорговыеКоды.ПустаяСсылка();
	Иначе
		Выборка	= Результат.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.АналитическийСчетДССсылка;
	КонецЕсли;
	
КонецФункции		   

Функция ПропискаРассылки(Знач НомерРассылки)
