		Иначе
			ДокументОперацияПоСчетуБрокера.НУ = Истина;
		КонецЕсли;
		ДокументОперацияПоСчетуБрокера.Контрагент = Строчка.Брокер;
		ДокументОперацияПоСчетуБрокера.ДоговорКонтрагента = Строчка.ДоговорБрокера;
		Если ВестиТолькоБухгалтерскийУчет Тогда
			ДокументОперацияПоСчетуБрокера.УУ = Ложь;
			ДокументОперацияПоСчетуБрокера.ВУ = Ложь;
		Иначе
			ДокументОперацияПоСчетуБрокера.УУ = Истина;
			ДокументОперацияПоСчетуБрокера.ВУ = Истина;
