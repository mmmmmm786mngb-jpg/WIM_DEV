			ДокументОперацияПоСчетуБрокера.ФизическоеМестоХраненияДС 	= Строчка.ФизическоеМестоХраненияДС;
		КонецЕсли;
		
		//ДокументОперацияПоСчетуБрокера.Раздел = Справочники.Разделы.Торговый;
		ДокументОперацияПоСчетуБрокера.Биржа = Строчка.Биржа;
		ДокументОперацияПоСчетуБрокера.НаименованиеОперации = Строчка.НазначениеПлатежа;
		ВалютаДоговора = Строчка.ДоговорБрокера.ВалютаВзаиморасчетов;
