		ОперацияДок.СтатьяДвиженияДенежныхСредствКорреспондента = СтатьяДДС;
		ОперацияДок.ВалютаКорреспондента = Строка.ТорговыйКодПриход.АналитическийСчетДС.МестоХранения.ВалютаДенежныхСредств;
		
		ОперацияДок.БУ = Истина;
		ОперацияДок.ВУ = Истина;
		ОперацияДок.УУ = Истина;
		
		ОперацияДок.Комментарий = "#Создано обработкой " + Строка(ТекущаяДата());
		
		Попытка
			
			ОперацияДок.Записать(РежимЗаписиДокумента.Проведение);
			Сообщить("Проведен документ " + Строка(ОперацияДок.Ссылка));
			
		Исключение
			
