Функция СформироватьИОтправитьПисьмо(НаДату,ВажностьОшибки)
	
	Тема = "Рассылка результатов загрузки операций по брокерскому счету на " + Формат(НаДату, "ДФ=dd.MM.yyyy");
	
	ТекстТаблицаОпераций  = ТелоПисьма;
	
	РассылкаСообщения_Шапка();
	РассылкаСообщения_Заголовок("Сообщения загрузки операций брокера на дату: " + Формат(НаДату, "ДФ=dd.MM.yyyy"));
	
	х = новый Массив;
	х.Добавить("Имя файла");
	х.Добавить("стр. №");
	х.Добавить("Торговый Код");
	х.Добавить("Договор ДУ");
	х.Добавить("Сообщение");
	РассылкаСообщения_ЗаголовокТаблицы(х);
	
	Для каждого Сообщение Из масСообщения Цикл
		х[0] = Сообщение.ИмяФайла;
		х[1] = Сообщение.НомерСтроки;
		х[2] = Сообщение.ТорговыйКод;
		х[3] = Сообщение.ДоговорДУ;
		х[4] = Сообщение.Текст;
		РассылкаСообщения_СтрокаТаблицы(х);
	КонецЦикла;
	РассылкаСообщения_ПодвалТаблицы();
	
	//РассылкаСообщения_Заголовок("Таблица данных");
	ТелоПисьма = ТелоПисьма+ТекстТаблицаОпераций;
	
	РассылкаСообщения_Окончание();	
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста");
	Кому = Новый Массив;
	Для каждого ТекЯщик из СписокРассылки Цикл
		Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
	КонецЦикла;
	
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ПрефиксПисьма(ВажностьОшибки) + Тема + ПропискаРассылки("r215");;
	ПараметрыПисьма.Тело = ТелоПисьма;
	ПараметрыПисьма.ТипТекста = "HTML";
	
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
		текстРассылки = "Рассылка завершена";
	Исключение
		текстРассылки = "Рассылка не удалась: "+ПочтовыйЛогин; 
		Сообщения = ПолучитьСообщенияПользователю(Истина);
	КонецПопытки;
	
	Возврат текстРассылки; 
КонецФункции

Процедура ДобавитьСообщение(ИмяФайлаОтчета, НомерСтроки, ТорговыйКод, стрДоговорДУ, ТекстСообщения, Статус = Неопределено)
	
	Сообщение = новый Структура("Текст", ТекстСообщения);
	Сообщение.Вставить("ИмяФайла", ИмяФайлаОтчета);
	Сообщение.Вставить("НомерСтроки", НомерСтроки);
	Сообщение.Вставить("ТорговыйКод", ТорговыйКод);
	Сообщение.Вставить("ДоговорДУ", стрДоговорДУ);
	Сообщение.Вставить("Статус", ?(Статус = Неопределено, СтатусСообщения.БезСтатуса, Статус));
	
	масСообщения.Добавить(Сообщение);
КонецПроцедуры

Функция ТекстСообщения(СтруктураСообщения)
	
	стрТекст = "";
	стрТекст = стрТекст+?(ЗначениеЗаполнено(СтруктураСообщения.ИмяФайла),"["+СтруктураСообщения.ИмяФайла+"]" , "");
