Функция НайтиДокументНачислениеНКД(ДоговорДУ, Облигация, Дата)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ //ПЕРВЫЕ 1     //IMAPPS-24092
	|	ПереводНКДВЗадолженностьЭмитента.Ссылка КАК Ссылка,
