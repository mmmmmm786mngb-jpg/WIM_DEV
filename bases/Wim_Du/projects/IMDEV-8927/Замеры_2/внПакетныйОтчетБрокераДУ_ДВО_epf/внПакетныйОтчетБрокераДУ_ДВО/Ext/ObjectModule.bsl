Функция КлирингОткрытыхПозиций(СтруктураДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КлирингОткрытыхПозиций.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КлирингОткрытыхПозиций КАК КлирингОткрытыхПозиций
		|ГДЕ
		|	КлирингОткрытыхПозиций.ДоговорДУ = &ДоговорДУ
		|	И НАЧАЛОПЕРИОДА(КлирингОткрытыхПозиций.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|	И НЕ КлирингОткрытыхПозиций.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Дата", СтруктураДокумента.ДатаДок);
	Запрос.УстановитьПараметр("ДоговорДУ", СтруктураДокумента.ДоговорДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	Иначе
		НовыйДокумент = Документы.КлирингОткрытыхПозиций.СоздатьДокумент();
		НовыйДокумент.Дата = НачалоДня(СтруктураДокумента.ДатаДок) + 72000; // 18:00;
		
		НовыйДокумент.БУ = Истина;
		НовыйДокумент.ВУ = Истина;
		НовыйДокумент.УУ = Истина;
		
		НовыйДокумент.ДоговорДУ = СтруктураДокумента.ДоговорДУ;
		
		Возврат НовыйДокумент;
		
	КонецЕсли;

КонецФункции
