		// IMAPPS-30183--
		
		МассивДок = ДокументыВБазе.НайтиСтроки(Отбор);
		Если МассивДок.Количество() Тогда
			ОперацияДок = МассивДок[0].Ссылка.ПолучитьОбъект();	
		Иначе
			ОперацияДок = Документы.ОперацияПоСчетуБрокера.СоздатьДокумент();
		КонецЕсли;
		
		ОперацияДок.Дата = Строка.Дата + 9 * 3600;
		ОперацияДок.ВидОперации = Перечисления.ВидыОперацийПоСчетуБрокера.Перевод;
		ОперацияДок.ДоговорДУ = Строка.ДоговорДУ;
		
		ОперацияДок.АналитическийСчетБрокера = Строка.ТорговыйКодРасход.АналитическийСчетДС;
