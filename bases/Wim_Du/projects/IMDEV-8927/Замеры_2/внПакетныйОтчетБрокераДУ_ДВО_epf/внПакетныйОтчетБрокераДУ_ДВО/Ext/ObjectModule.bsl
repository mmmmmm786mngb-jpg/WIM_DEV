	               |ГДЕ
	               |	НАЧАЛОПЕРИОДА(ОперацияПоСчетуБрокера.Дата, ДЕНЬ) В (&Дата)
	               |	И ОперацияПоСчетуБрокера.ДоговорДУ В(&ДоговорДУ)
	               |	И ОперацияПоСчетуБрокера.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоСчетуБрокера.Перевод)
	               |	И ОперацияПоСчетуБрокера.Комментарий ПОДОБНО &Комментарий
	               |	И НЕ ОперацияПоСчетуБрокера.ПометкаУдаления";
	Запрос.УстановитьПараметр("Дата", ТаблицаДанных5.ВыгрузитьКолонку("Дата"));
	Запрос.УстановитьПараметр("ДоговорДУ", ТаблицаДанных5.ВыгрузитьКолонку("ДоговорДУ"));
	Запрос.УстановитьПараметр("Комментарий", "#Создано обработкой%");
	
	ДокументыВБазе = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка ИЗ ТаблицаДанных5 Цикл
		//// IMAPPS-17933 ++
		//IMAPPS-18376 ++
		//Если Строка.Брокер = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор("99904467-45e3-11e2-b4e9-005056b100ec")) Тогда 
		Если БрокерУИД = "99904467-45e3-11e2-b4e9-005056b100ec" Тогда
		//IMAPPS-18376 --
		Если Строка.ДоговорДУ.ТипКлиентаДУ = ТипВИ Тогда 
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Перевод с/на брокерский счет - ВИ");
			ИначеЕсли Строка.ДоговорДУ.ТипКлиентаДУ = ТипПН_НПФ Тогда 
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Перевод с/на брокерский счет - ПН НПФ");
			ИначеЕсли Строка.ДоговорДУ.ТипКлиентаДУ = ТипПР_НПФ Тогда 
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Перевод с/на брокерский счет - ПР НПФ");
			ИначеЕсли Строка.ДоговорДУ.ТипКлиентаДУ = Тип_ПФР Тогда 
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Перевод с/на брокерский счет - ПФР");
			ИначеЕсли Строка.ДоговорДУ.ТипКлиентаДУ = ТипСС_НПФ Тогда 
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Перевод с/на брокерский счет - СС НПФ");
			ИначеЕсли Строка.ДоговорДУ.ТипКлиентаДУ = ТипФФЦК Тогда 
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Перевод с/на брокерский счет - ФФЦК");
			Иначе 
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Перевод с/на брокерский счет - ФЛ/ЮЛ");
			КонецЕсли;
		Иначе 
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Перевод с/на брокерский счет - ФЛ/ЮЛ");
		КонецЕсли;
		//// IMAPPS-17933 --

		Отбор = Новый Структура;
		Отбор.Вставить("Дата", Строка.Дата);
		Отбор.Вставить("ДоговорДУ", Строка.ДоговорДУ);
		Отбор.Вставить("СуммаДокумента", Строка.Сумма);
		// IMAPPS-30183++
		// Перепутано местами Приход/Расход, по коду ниже документ заполняется в другой порядке
		// Отбор.Вставить("АналитическийСчетБрокера", Строка.ТорговыйКодПриход.АналитическийСчетДС);//Отбор.Вставить("АналитическийСчетБрокера", Строка.ТорговыйКодРасход.АналитическийСчетДС);
		// Отбор.Вставить("АналитическийСчетКорреспондента", Строка.ТорговыйКодРасход.АналитическийСчетДС);//Отбор.Вставить("АналитическийСчетКорреспондента", Строка.ТорговыйКодПриход.АналитическийСчетДС);
		
		Отбор.Вставить("АналитическийСчетБрокера", Строка.ТорговыйКодРасход.АналитическийСчетДС);
