Функция ПолучитьТорговыйКод(СубСчет)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТорговыеКоды.Ссылка КАК Ссылка,
		|	ТорговыеКоды.Наименование КАК Наименование,
		|	ТорговыеКоды.АналитическийСчетДС КАК АналитическийСчетДС,
		|	ТорговыеКоды.Брокер КАК Брокер,
		|	ТорговыеКоды.ДоговорБрокера КАК ДоговорБрокера,
		|	ТорговыеКоды.ДоговорДУ КАК ДоговорДУ,
		|	ТорговыеКоды.ТорговыйКод КАК ТорговыйКод
		|ИЗ
		|	Справочник.ТорговыеКоды КАК ТорговыеКоды
		|ГДЕ
		|	ТорговыеКоды.Наименование = &СубСчет
		|	И НЕ ТорговыеКоды.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("СубСчет", СубСчет);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
//IMAPPS-11276

Функция ПолучитьТорговыйКодПоСчетуБрокера(СубСчет, ТорговыйКод, ВалютаКод)
	
	Если ВалютаКод = "RUR" Тогда 
		ВалютаCashFlows = "RUB";
	Иначе
		ВалютаCashFlows = ВалютаКод;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТорговыеКоды.Ссылка КАК Ссылка,
		|	ТорговыеКоды.Наименование КАК Наименование,
		|	ТорговыеКоды.АналитическийСчетДС КАК АналитическийСчетДС,
		|	ТорговыеКоды.Брокер КАК Брокер,
		|	ТорговыеКоды.ДоговорБрокера КАК ДоговорБрокера,
		|	ТорговыеКоды.ДоговорДУ КАК ДоговорДУ,
		|	ТорговыеКоды.ТорговыйКод КАК ТорговыйКод
		|ИЗ
		|	Справочник.ТорговыеКоды КАК ТорговыеКоды
		|ГДЕ
		|	ТорговыеКоды.АналитическийСчетДС.АналитическийПризнакСчетаБрокера.Наименование = &ТорговыйКод
		|	И ВЫРАЗИТЬ(ТорговыеКоды.АналитическийСчетДС.МестоХранения КАК Справочник.БанковскиеСчета).ВалютаДенежныхСредств.Наименование = &ВалютаКод
		|	И ТорговыеКоды.Наименование ПОДОБНО ""%/"" + &СубСчет
		|	И НЕ ТорговыеКоды.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ТорговыеКоды.Ссылка,
		|	ТорговыеКоды.Наименование,
		|	ТорговыеКоды.АналитическийСчетДС,
		|	ТорговыеКоды.Брокер,
		|	ТорговыеКоды.ДоговорБрокера,
		|	ТорговыеКоды.ДоговорДУ,
		|	ТорговыеКоды.ТорговыйКод
		|ИЗ
		|	Справочник.ТорговыеКоды КАК ТорговыеКоды
		|ГДЕ
		|	ВЫРАЗИТЬ(ТорговыеКоды.АналитическийСчетДС.МестоХранения КАК Справочник.БанковскиеСчета).НомерСчета = &ТорговыйКод
		|	И ВЫРАЗИТЬ(ТорговыеКоды.АналитическийСчетДС.МестоХранения КАК Справочник.БанковскиеСчета).ВалютаДенежныхСредств.Наименование = &ВалютаКод
		|	И ТорговыеКоды.Наименование ПОДОБНО ""%/"" + &СубСчет
		|	И НЕ ТорговыеКоды.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ТорговыеКоды.Ссылка,
		|	ТорговыеКоды.Наименование,
		|	ТорговыеКоды.АналитическийСчетДС,
		|	ТорговыеКоды.Брокер,
		|	ТорговыеКоды.ДоговорБрокера,
		|	ТорговыеКоды.ДоговорДУ,
		|	ТорговыеКоды.ТорговыйКод
		|ИЗ
		|	Справочник.ТорговыеКоды КАК ТорговыеКоды
		|ГДЕ
		|	ВЫРАЗИТЬ(ТорговыеКоды.АналитическийСчетДС.МестоХранения КАК Справочник.БанковскиеСчета).НомерСчета = &ТорговыйКод
		|	И ВЫРАЗИТЬ(ТорговыеКоды.АналитическийСчетДС.МестоХранения КАК Справочник.БанковскиеСчета).ВалютаДенежныхСредств.Наименование = &ВалютаКод
		|	И ТорговыеКоды.Наименование = &СубСчет
		|	И НЕ ТорговыеКоды.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ТорговыйКод", ТорговыйКод);
	Запрос.УстановитьПараметр("ВалютаКод", ВалютаCashFlows);
	Запрос.УстановитьПараметр("СубСчет", СубСчет);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	ЗначенияНастроек = НастройкиВыполнения;
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек,ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") тогда
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) тогда
			ПочтовыйЛогин = Почта;
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки);
			СписокРассылки.Загрузить(Ящики.Получить());
		КонецЕсли;
		Настройки.Значения.Свойство("ПериодЧас", ПериодЧас);
		ПредставлениеНастроек = "Период отчета:"+ПериодЧас;
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьТаблицуКоманд()
	
	// Создадим пустую таблицу команд и колонки в ней
	Команды = Новый ТаблицаЗначений;
	
	// Как будет выглядеть описание печатной формы для пользователя
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка")); 
	
	// Имя нашего макета, что бы могли отличить вызванную команду в обработке печати
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	
	// Тут задается, как должна вызваться команда обработки
	// Возможные варианты:
	// - ОткрытиеФормы - в этом случае в колонке идентификатор должно быть указано имя формы, которое должна будет открыть система
	// - ВызовКлиентскогоМетода - вызвать клиентскую экспортную процедуру из модуля формы обработки
	// - ВызовСерверногоМетода - вызвать серверную экспортную процедуру из модуля объекта обработки
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	
	// Следующий параметр указывает, необходимо ли показывать оповещение при начале и завершению работы обработки. Не имеет смысла при открытии формы
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	
	// Для печатной формы должен содержать строку ПечатьMXL 
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	// Добавляем команду в таблицу команд по переданному описанию.
	// Параметры и их значения можно посмотреть в функции ПолучитьТаблицуКоманд
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	масСообщения = новый Массив;
	ДополнительнаяОбработкаСсылка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка; // IMAPPS-26041
	
	Если ИдентификаторКоманды = "ФоновоеВыполнение" Тогда 
		
		// IMDEV-8927 ++
		ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
		// IMDEV-8927 --
		
		ВажностьОшибки = 0;
		
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
		
		НачДня = НачалоДня(ТекущаяДата());
		ПредРабочийДень = КалендарныеГрафики.ПолучитьПоследнийРабочийДеньПериода(,НачДня-30*24*3600, НачДня-1); //-1*24*3600
		
		Задача = Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
		Задача.Дата = ТекущаяДата();
		
		Задача.ВидОбмена 		= ДополнительнаяОбработкаСсылка;
		Задача.ВерсияОбработки 	= ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДополнительнаяОбработкаСсылка, "Версия");
		Задача.Наименование 	= "Загрузка операций по брокерскому счету в фоновом режиме";
		Задача.ПараметрыВыполнения = ПредставлениеНастроек;
	    Попытка
			СчитатьДанныеSQL(ПредРабочийДень,ВажностьОшибки);
		Исключение    
			Инфо = ИнформацияОбОшибке().Описание;
			ДобавитьСообщение("", Инфо.ИмяМодуля, Инфо.НомерСтроки,  Инфо.ИсходнаяСтрока, Инфо.Описание, СтатусСообщения.ОченьВажное);
			ВажностьОшибки = 2;
		КонецПопытки;			
		
		ТекстТаблицаОпераций = "";
		
		// запишем строки исходной таблицы в текст письма
		ТелоПисьма = "";
		РассылкаСообщения_Заголовок("Не проведенные операции по счету брокера");
		х = новый Массив;
		х.Добавить("№");
		х.Добавить("Торговый код");
		х.Добавить("Дата");
		х.Добавить("Договор ДУ");
		х.Добавить("Брокер");
		х.Добавить("Договор брокера");
		х.Добавить("Назначение платежа");
		х.Добавить("Приход");
		х.Добавить("Расход");
		х.Добавить("Операция в базе 1С");
		РассылкаСообщения_ЗаголовокТаблицы(х);
		
		Попытка
			// IMAPPS-26041++
			// СоздатьОперацииПоБрокерскомуСчету(ВажностьОшибки,ЛОЖЬ);
			СоздатьОперацииПоБрокерскомуСчетуВПотоках(ВажностьОшибки,ЛОЖЬ);
			// IMAPPS-26041--
		Исключение    
			Инфо = ИнформацияОбОшибке();
			ДобавитьСообщение("", Инфо.ИмяМодуля, Инфо.НомерСтроки,  Инфо.ИсходнаяСтрока, Инфо.Описание, СтатусСообщения.ОченьВажное);
			ВажностьОшибки = 2;
		КонецПопытки;	
			
		
		РассылкаСообщения_ПодвалТаблицы();
		
		Если СписокРассылки.Количество()>0 и НЕ ПочтовыйЛогин.Пустая() тогда
			
			текстРассылки = СформироватьИОтправитьПисьмо(ПредРабочийДень,ВажностьОшибки);
			
			Для каждого Сообщение Из масСообщения Цикл
				Задача.Описание = Задача.Описание + Символы.ПС + Сообщение.Текст;
			КонецЦикла;
			
		КонецЕсли;
		
		Задача.Описание = Задача.Описание + Символы.ПС + Символы.ПС + текстРассылки;
		Задача.ВыполнитьЗадачу();
		
		// IMDEV-8927 ++
		ИдентификаторКомандыДляЗамера = Неопределено;
		// IMDEV-8927 --
		
	// IMAPPS-26041++
	ИначеЕсли ИдентификаторКоманды = "КомандаСоздатьОперацииПоБрокерскомуСчетуПоток" Тогда
		
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
		СоздатьОперацииПоБрокерскомуСчетуПоток(ПараметрыВыполненияКоманды);
	// IMAPPS-26041--
	
	КонецЕсли;
	
КонецПроцедуры

// IMDEV-8927 ++
// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Формирует имя ключевой операции БСП для замера по этапу и контуру запуска.
//
// Параметры:
// ЭтапЗамера - Строка - этап (ПолучениеSQL, СозданиеОпераций)
//
// Возвращаемое значение:
// Строка - имя ключевой операции в формате ДУ.ПакетныйОтчетБрокера.<Этап>.<Контур>
//
Функция ПолучитьИмяКлючевойОперацииЗамера(Знач ЭтапЗамера)
	
	Возврат "ДУ.ПакетныйОтчетБрокера." + ЭтапЗамера + "."
		+ ?(ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера), ИдентификаторКомандыДляЗамера, "Ручной");
	
КонецФункции
