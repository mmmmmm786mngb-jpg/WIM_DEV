		ТипПН_НПФ    = Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеЧерезНПФ;
		ТипПР_НПФ    = Перечисления.ТипыКлиентовДУ.ПенсионныеРезервыНПФ;
		Тип_ПФР    	 = Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеПФР;
		ТипСС_НПФ    = Перечисления.ТипыКлиентовДУ.СобственныеСредстваНПФ;
		ТипФФЦК	     = Перечисления.ТипыКлиентовДУ.ФондЦелевогоКапитала;
		// IMAPPS-17933 --
		
		Если НЕ ЗначениеЗаполнено(Строчка.ДоговорДУ) И НЕ ЗначениеЗаполнено(Строчка.Брокер) И НЕ ЗначениеЗаполнено(Строчка.ДоговорБрокера) Тогда
			Продолжить;
		КонецЕсли;
		
				
		Если СтрНайти(Строчка.НазначениеПлатежа, "Комиссия за расчетные услуги") > 0 ИЛИ СтрНайти(Строчка.НазначениеПлатежа, "Списание комиссии с ИБС клиента") > 0
			//	IMAPPS-919
			ИЛИ СтрНайти(Строчка.НазначениеПлатежа, "Депозитарная комиссия") > 0 ИЛИ СтрНайти(Строчка.НазначениеПлатежа, "Использование брокером ДС") > 0
			Тогда
			НайденныеДокументы = ТаблицаСозданныхДокументов.НайтиСтроки(Новый Структура("Контрагент, ДоговорДУ, СуммаДокумента, ДоговорКонтрагента", Строчка.Брокер, Строчка.ДоговорДУ, Число(Строчка.Приход), Строчка.ДоговорБрокера));
		Иначе
			НайденныеДокументы = ТаблицаСозданныхДокументов.НайтиСтроки(Новый Структура("Контрагент, ДоговорДУ, СуммаДокумента, ДоговорКонтрагента", Строчка.Брокер, Строчка.ДоговорДУ, Число(Строчка.Расход), Строчка.ДоговорБрокера));																			
		КонецЕсли;	
		
		ДокументОперацияПоСчетуБрокера = Неопределено;
		
		Если ЗначениеЗаполнено(НайденныеДокументы) И НайденныеДокументы.Количество() > 0 Тогда
			ДокументОперацияПоСчетуБрокера = НайденныеДокументы.Получить(0).Ссылка;				
		КонецЕсли;
		
		Если ДокументОперацияПоСчетуБрокера = Неопределено Тогда
			ДокументОперацияПоСчетуБрокера = Документы.ОперацияПоСчетуБрокера.СоздатьДокумент();
			Создан = Истина;     
		Иначе
			ДокументОперацияПоСчетуБрокера = ДокументОперацияПоСчетуБрокера.ПолучитьОбъект();
			Создан = Ложь;
		КонецЕсли;		
		
		ДокументОперацияПоСчетуБрокера.Дата = НачалоДня(Строчка.Дата)+36000;
		ДокументОперацияПоСчетуБрокера.ДоговорДУ = Строчка.ДоговорДУ;
		ДокументОперацияПоСчетуБрокера.БУ = Истина;
		//Kmusorin 	IMAPPS-3207 убираем НУ для физиков	
