				ДокументОперацияПоСчетуБрокера.СтатьяДвиженияДенежныхСредств = СтатьяДДС_ИспДС_Брокером_Проценты;
				
				Если НЕ ВестиТолькоБухгалтерскийУчет Тогда
					ДокументОперацияПоСчетуБрокера.СубконтоКоррСчета2 = Строчка.АналитическийСчетДС.МестоХранения;
				КонецЕсли;
				//Начало создания документа Начисление дивидентов
				ДокументНачислениеПроцентовСсылка = НайтиДокументНачислениеПроцентовБС(Строчка.ДоговорДУ, Строчка.Дата, Строчка.Расход);
				
				Если ДокументНачислениеПроцентовСсылка = Неопределено Тогда
					ДокументНачислениеПроцентов = Документы.НачислениеПроцентовПоБанковскимСчетам.СоздатьДокумент();
					ДокументНачислениеПроцентов.Дата = Строчка.Дата;
					ДокументНачислениеПроцентов.ДоговорДУ = Строчка.ДоговорДУ;
				Иначе
					ДокументНачислениеПроцентов = ДокументНачислениеПроцентовСсылка.ПолучитьОбъект();
					ДокументНачислениеПроцентов.СписокНачислений.Очистить();
				КонецЕсли;
				
				ДокументНачислениеПроцентов.БУ = Истина;
				
				СтрокаДокумента = ДокументНачислениеПроцентов.СписокНачислений.Добавить();
				СтрокаДокумента.Контрагент = Строчка.Брокер;
				СтрокаДокумента.ДоговорКонтрагента = Строчка.ДоговорБрокера;
				
				СтрокаДокумента.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.РасчетыПоБанковскимСчетам;
				СтрокаДокумента.КорСчет = ПланыСчетов.Хозрасчетный.ПроцентыНаОстатокДенежныхСредствНаРасчетныхСчетах;
				
				СтрокаДокумента.ВалютаВклада = Справочники.Валюты.RUB;
				СтрокаДокумента.Курс = 1;
				СтрокаДокумента.Кратность = 1;
				
				СтрокаДокумента.СуммаДоначисления = Строчка.Расход;
				СтрокаДокумента.ВалютаСуммаДоначисления = Строчка.Расход;
				
				Если ВестиТолькоБухгалтерскийУчет Тогда
					ДокументНачислениеПроцентов.УУ = Ложь;
					СтрокаДокумента.СуммаДоначисленияУУ = 0;
					СтрокаДокумента.ВалютаСуммаДоначисленияУУ = 0;
				Иначе
					ДокументНачислениеПроцентов.УУ = Истина;
					СтрокаДокумента.АналитическийСчет 	= Строчка.АналитическийСчетДС;
					СтрокаДокумента.БанковскийСчет 	= Строчка.АналитическийСчетДС.МестоХранения;
					СтрокаДокумента.СуммаДоначисленияУУ = Строчка.Расход;
					СтрокаДокумента.ВалютаСуммаДоначисленияУУ = Строчка.Расход;
				КонецЕсли;
				
				ЗаписатьДокументПоСтроке(ДокументНачислениеПроцентов, СписокДоков, Строчка, НомСтр,Выводить,Важность);
				//Конец создания документа Начисление дивидентов
				
				ДокументОперацияПоСчетуБрокера.ДокументОснование = ДокументНачислениеПроцентов.Ссылка;
			КонецЕсли;
			
			Если ВалютаДоговора = Строчка.ДоговорДУ.Валюта Тогда
				ДокументОперацияПоСчетуБрокера.СуммаДокументаРуб = ДокументОперацияПоСчетуБрокера.СуммаДокумента;
			Иначе
				ДокументОперацияПоСчетуБрокера.СуммаДокументаРуб = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(ДокументОперацияПоСчетуБрокера.СуммаДокумента, ВалютаДоговора, Строчка.ДоговорДУ.Валюта, 1, ДокументОперацияПоСчетуБрокера.КурсВзаиморасчетов, 1, ДокументОперацияПоСчетуБрокера.КратностьВзаиморасчетов);
			КонецЕсли;
			
			Если ВестиТолькоБухгалтерскийУчет Тогда
				ДокументОперацияПоСчетуБрокера.УУ = Ложь;
				ДокументОперацияПоСчетуБрокера.ВУ = Ложь;
			Иначе
				ДокументОперацияПоСчетуБрокера.УУ = Истина;
				ДокументОперацияПоСчетуБрокера.ВУ = Истина;
				ДокументОперацияПоСчетуБрокера.АналитическийСчетБрокера 	= Строчка.АналитическийСчетДС;
				ДокументОперацияПоСчетуБрокера.ФизическоеМестоХраненияДС 	= Строчка.ФизическоеМестоХраненияДС;
			КонецЕсли;
			
		КонецЕсли;
		
		//ДокументОперацияПоСчетуБрокера.НомерВходящегоДокумента = Строчка.НомерСделки;
		//ДокументОперацияПоСчетуБрокера.БУ = Истина;
		//Если ВестиТолькоБухгалтерскийУчет Тогда
		//	ДокументОперацияПоСчетуБрокера.ВУ = Ложь;
		//	ДокументОперацияПоСчетуБрокера.УУ = Ложь;
		//Иначе
		//	ДокументОперацияПоСчетуБрокера.УУ = Истина;
		//	ДокументОперацияПоСчетуБрокера.ВУ = Истина;
		//КонецЕсли;
		//Варианты = МножественныеУчетныеПолитики.ДействующиеВариантыУчетныхПолитикДУ(ДокументОперацияПоСчетуБрокера.Дата, ДокументОперацияПоСчетуБрокера.ДоговорДУ);
		Если ВалютаПоСтроке <> Строчка.ДоговорДУ.Валюта 
			И НЕ ВалютаПоСтроке = Справочники.Валюты.ПустаяСсылка() Тогда 
			ДокументОперацияПоСчетуБрокера.ВалютаКорреспондента		= ВалютаПоСтроке;  
			ДокументОперацияПоСчетуБрокера.КурсКорреспондента      	= КурсКратность.Курс;
    		ДокументОперацияПоСчетуБрокера.КратностьКорреспондента 	= КурсКратность.Кратность; 
		Иначе
			ДокументОперацияПоСчетуБрокера.КурсКорреспондента = 1;
			ДокументОперацияПоСчетуБрокера.КратностьКорреспондента = 1;
			ДокументОперацияПоСчетуБрокера.ВалютаКорреспондента  = Справочники.Валюты.RUB;
		
		КонецЕсли;	
	
		
		
		//Для Каждого Вариант Из Варианты Цикл			
		//	НоваяСтрока = ДокументОперацияПоСчетуБрокера.ВариантыУчетныхПолитик.Добавить();
		//	НоваяСтрока.Вариант = Вариант;			
		//КонецЦикла;	
		
		ЗаписатьДокументПоСтроке(ДокументОперацияПоСчетуБрокера, СписокДоков, Строчка, НомСтр,Выводить,Важность);
		
	КонецЦикла;
	
	Счетчик = 0;
	
	//Проведение документов
	Для Каждого ЭлементСписка Из СписокДоков Цикл
		
		Док = ЭлементСписка.Значение;
		
		Счетчик = Счетчик + 1;	
		
		ДокОбъект = Док.ПолучитьОбъект();
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			//масСообщения.Добавить("Не удалось провести документ " + Док);
			ДобавитьСообщение("Проведение документов", "", "", "", "Не удалось провести документ " + Док, СтатусСообщения.Важное);
			Важность = 1;
		КонецПопытки;	
		
	КонецЦикла;
	
	//масСообщения.Добавить("Проведение документов завершено.");
	// IMAPPS-26041++
	// ДобавитьСообщение("Проведение документов", "", "", "", "Завершено.", СтатусСообщения.Информация);
	
	// Возвращаем результаты выполнения
	РезультатВыполнения.Важность = Важность;
	РезультатВыполнения.масСообщения = масСообщения;
	РезультатВыполнения.ТелоПисьма = ТелоПисьма;
	РезультатВыполнения.ВыполненоУспешно = Истина;
	
	ПоместитьВоВременноеХранилище(РезультатВыполнения, ПараметрыВыполнения.СервисныеПараметры.АдресХранилища);
	// IMAPPS-26041++
	
КонецПроцедуры // СоздатьОперацииСервер()

