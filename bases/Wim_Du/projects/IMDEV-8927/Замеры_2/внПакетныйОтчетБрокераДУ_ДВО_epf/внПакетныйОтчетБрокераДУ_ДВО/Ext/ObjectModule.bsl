Функция ПрефиксПисьма(Знач ВажностьОшибки, Знач ЭтоОтчет = Ложь)
	Перем ПрефиксПисьма;
	
	Если ВажностьОшибки = 1 Тогда
		ПрефиксПисьма = "{WARN} ";
		
	ИначеЕсли ВажностьОшибки = 2 Тогда
		ПрефиксПисьма = "{FAIL} ";
		
	Иначе
		ПрефиксПисьма = ?(ЭтоОтчет, "", "{OK} ");
	КонецЕсли;
	
	Возврат ПрефиксПисьма;
КонецФункции // ПрефиксПисьма()

Процедура ПрочитатьФайлJSON(АдресФайлаНаСервере, ИмяФайлаБезРасширения, БрокерУИД="") Экспорт
	
	масСообщения = новый Массив;
	
	ТаблицаДанных2.Очистить();
	ТаблицаДанных5.Очистить();  
	
	ВестиТолькоБухгалтерскийУчет = Константы.ВестиТолькоБухгалтерскийУчет.Получить();
	
	ЛокТаблицаДанных5 = ТаблицаДанных5.Выгрузить();
	тблКешФлоу = Новый ТаблицаЗначений;
	тблКешФлоу.Колонки.Добавить("Счет", ОбщегоНазначения.ОписаниеТипаСтрока(125));
	тблКешФлоу.Колонки.Добавить("Период", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	тблКешФлоу.Колонки.Добавить("Описание", ОбщегоНазначения.ОписаниеТипаСтрока(200));
	тблКешФлоу.Колонки.Добавить("Кредит", ОбщегоНазначения.ОписаниеТипаЧисло(20,2));
	тблКешФлоу.Колонки.Добавить("Дебет", ОбщегоНазначения.ОписаниеТипаЧисло(20,2));
	тблКешФлоу.Колонки.Добавить("Валюта", ОбщегоНазначения.ОписаниеТипаСтрока(3));
	тблКешФлоу.Колонки.Добавить("СубСчет", ОбщегоНазначения.ОписаниеТипаСтрока(125));
	
	УникальноеИмяФайла = Новый УникальныйИдентификатор;
	
	ИмяФайлаНаСервере = КаталогВременныхФайлов() + ИмяФайлаБезРасширения + ".json";	
	
	ФайлДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаНаСервере);
	ФайлДвоичныеДанные.Записать(ИмяФайлаНаСервере);
		
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяФайлаНаСервере);
	
	ДанныеФайла = ПрочитатьJSON(Чтение);

	// чтение json
	reportInfoЕсть = ДанныеФайла.Свойство("reportInfo");
	Если НЕ reportInfoЕсть Тогда 
		Сообщить("Не блока reportInfo в файле json"); 
		Возврат;
	КонецЕсли;   
	
	reportInfo = ДанныеФайла.reportInfo;	
	mainЕсть = reportInfo.Свойство("main");
	Если НЕ mainЕсть Тогда 
		Сообщить("Не блока main в файле json"); 
		Возврат;
	КонецЕсли; 
	
	main = reportInfo.main;
	
	СчетчикCash = 0;
	СчетчикСтрок = 0;
	
	СоответствиеКодЦБНаБирже = ПолучитьСоответствиеКодЦБНаБирже();
	
	Для Каждого ОсновнойБлок из main Цикл
		
		Договор = "";
		ДепоСчет = "";
		ДатаДепоСчет = Дата(1, 1, 1);
		
		Если ОсновнойБлок.Свойство("agreement") Тогда
			Договор = ОсновнойБлок.agreement;
		КонецЕсли; 
		Если ОсновнойБлок.Свойство("depoAccount") Тогда
			ДепоСчет = ОсновнойБлок.depoAccount;
		КонецЕсли;
		Если ОсновнойБлок.Свойство("agrDate") Тогда
			ДатаСтрока = СтрЗаменить(ОсновнойБлок.agrDate, "-", "");
			Договор = Дата(ДатаСтрока);
		КонецЕсли;
		
		Если НЕ ОсновнойБлок.Свойство("clients") Тогда
			Сообщить("Не блока clients в файле json");
			Продолжить;
		КонецЕсли;
		
		Для Каждого КлиентФайл из ОсновнойБлок.clients Цикл
			
			КлиентНаименование = "";
			СубСчетКлиента = "";
			Если КлиентФайл.Свойство("clientName") Тогда
				КлиентНаименование = КлиентФайл.clientName;
			КонецЕсли; 
			Если КлиентФайл.Свойство("diasoftCode") Тогда
				СубСчетКлиента = КлиентФайл.diasoftCode;
			КонецЕсли;
			
			Если КлиентФайл.Свойство("cash") Тогда
				ПрочитатьCashБанкВТБ_JSON(КлиентФайл.cash, ВестиТолькоБухгалтерскийУчет, СубСчетКлиента, СчетчикCash);
			КонецЕсли;
			
			Если КлиентФайл.Свойство("cashFlows") Тогда
				ПрочитатьCashFlowБанкВТБ_JSON(КлиентФайл.cashFlows, ВестиТолькоБухгалтерскийУчет, СубСчетКлиента, ИмяФайлаБезРасширения, ЛокТаблицаДанных5, тблКешФлоу, СчетчикСтрок, СоответствиеКодЦБНаБирже, БрокерУИД)
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	МассивЛишнихСтрок = Новый Массив;
	
	Для Каждого СтрокаТЧ из ЛокТаблицаДанных5 Цикл
		
		Если МассивЛишнихСтрок.Найти(СтрокаТЧ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Отбор = Новый Структура;
		Отбор.Вставить("Дата", СтрокаТЧ.Дата);
		Отбор.Вставить("ДоговорДУ", СтрокаТЧ.ДоговорДУ);
		Отбор.Вставить("Сумма", СтрокаТЧ.Сумма);
		Если СтрокаТЧ.ТорговыйКодПриход.Пустая() Тогда
			Отбор.Вставить("ТорговыйКодРасход", Справочники.ТорговыеКоды.ПустаяСсылка());
		ИначеЕсли СтрокаТЧ.ТорговыйКодРасход.Пустая() Тогда
			Отбор.Вставить("ТорговыйКодПриход", Справочники.ТорговыеКоды.ПустаяСсылка());	
		КонецЕсли;	
		
		МассивПоиск = ЛокТаблицаДанных5.НайтиСтроки(Отбор);
		Если МассивПоиск.Количество() Тогда
			
			Если СтрокаТЧ.ТорговыйКодПриход.Пустая() Тогда
				СтрокаТЧ.ТорговыйКодПриход = МассивПоиск[0].ТорговыйКодПриход;	
			ИначеЕсли СтрокаТЧ.ТорговыйКодРасход.Пустая() Тогда
				СтрокаТЧ.ТорговыйКодРасход = МассивПоиск[0].ТорговыйКодРасход;		
			КонецЕсли;		
			
			МассивЛишнихСтрок.Добавить(МассивПоиск[0]);
			
			СтрокаНовая = ТаблицаДанных5.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНовая, СтрокаТЧ);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если тблКешФлоу.Количество() > 0 Тогда
		Запрос = новый Запрос;
		Запрос.УстановитьПараметр("тбл", тблКешФлоу);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	т.Счет КАК Счет,
			|	т.СубСчет КАК СубСчет,
			|	т.Период КАК Период,
			|	т.Описание КАК Описание,
			|	т.Кредит КАК Кредит,
			|	т.Дебет КАК Дебет,
			|	ВЫБОР
			|		КОГДА т.Валюта = ""RUR""
			|			ТОГДА ""RUB""
			|		ИНАЧЕ т.Валюта
			|	КОНЕЦ КАК Валюта
			|ПОМЕСТИТЬ втСтроки
			|ИЗ
			|	&тбл КАК т
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МАКСИМУМ(ВЫБОР
			|			КОГДА т.Дебет > 0
			|				ТОГДА ТорговыеКоды.Ссылка
			|			ИНАЧЕ """"
			|		КОНЕЦ) КАК ТорговыйКодРасход,
			|	МАКСИМУМ(ВЫБОР
			|			КОГДА т.Кредит > 0
			|				ТОГДА ТорговыеКоды.Ссылка
			|			ИНАЧЕ """"
			|		КОНЕЦ) КАК ТорговыйКодПриход,
			|	т.Период КАК Дата,
			|	т.Описание КАК Описание,
			|	т.Валюта КАК Валюта,
			|	ВЫБОР
			|		КОГДА т.Дебет > 0
			|			ТОГДА т.Дебет
			|		ИНАЧЕ т.Кредит
			|	КОНЕЦ КАК Сумма,
			|	ТорговыеКоды.ДоговорДУ КАК ДоговорДУ
			|ИЗ
			|	втСтроки КАК т
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТорговыеКоды КАК ТорговыеКоды
			|		ПО (ВЫРАЗИТЬ(ТорговыеКоды.АналитическийСчетДС.МестоХранения КАК Справочник.БанковскиеСчета).НомерСчета = т.Счет)
			|			И (ТорговыеКоды.Наименование ПОДОБНО ""%/"" + т.СубСчет)
			|			И т.Валюта = ТорговыеКоды.Ссылка.АналитическийСчетДС.МестоХранения.ВалютаДенежныхСредств.Наименование
			|
			|СГРУППИРОВАТЬ ПО
			|	т.Период,
			|	т.Описание,
			|	т.Валюта,
			|	ВЫБОР
			|		КОГДА т.Дебет > 0
			|			ТОГДА т.Дебет
			|		ИНАЧЕ т.Кредит
			|	КОНЕЦ,
			|	ТорговыеКоды.ДоговорДУ";
		
		таб = запрос.Выполнить().Выгрузить();
		Для каждого СтрокаТаб Из таб Цикл
			Если СтрокаТаб.ТорговыйКодРасход = СтрокаТаб.ТорговыйКодПриход Тогда
				Продолжить;
			КонецЕсли;
			СтрокаНовая = ТаблицаДанных5.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНовая, СтрокаТаб);
		КонецЦикла;
	КонецЕсли;
		
	Если СчетчикСтрок = 0 Тогда
		ДобавитьСообщение(ИмяФайлаБезРасширения, "", "", "", "Файл не содержит данных о сделках!", СтатусСообщения.Важное);
		Возврат;		
	КонецЕсли;
			
	Для каждого Сообщение Из масСообщения Цикл
		Сообщить(ТекстСообщения(Сообщение), Сообщение.Статус);
	КонецЦикла;
		
КонецПроцедуры

Процедура ПрочитатьCashБанкВТБ_JSON(БлокCash, ВестиТолькоБухгалтерскийУчет, SubAccount, СчетчикCash)

	МассивПропущенныеТорговыеКоды = Новый Массив;
	СчетчикСтрок 	= 0;
	СчетчикCash 	= 0;
	
	Для Каждого ЗаписьCash из БлокCash Цикл
		
		InvAccount 		= "";
		ДатаБалланса 	= "";
		BalOpen 		= "";
		Debited 		= "";
		Credited 		= "";
		BalCls			= "";  
		Currency		= "";	
		
		Если ЗаписьCash.Свойство("invAccount") Тогда
			InvAccount = ЗаписьCash.invAccount;
		КонецЕсли;  
		Если ЗаписьCash.Свойство("date") Тогда 
			ДатаСтрока = СтрЗаменить(ЗаписьCash.date, "-", ""); 
			ДатаСтрока = СтрЗаменить(ДатаСтрока, "T00:00:00", "");
			ДатаБалланса = Дата(ДатаСтрока);
		КонецЕсли;
		Если ЗаписьCash.Свойство("blOpen") Тогда
			BalOpen = ЗаписьCash.blOpen;
		КонецЕсли;
		Если ЗаписьCash.Свойство("debited") Тогда
			Debited = ЗаписьCash.debited;
		КонецЕсли;
		Если ЗаписьCash.Свойство("credited") Тогда
			Credited = ЗаписьCash.credited;
		КонецЕсли;
		Если ЗаписьCash.Свойство("balCls") Тогда
			BalCls = ЗаписьCash.balCls;
		КонецЕсли; 
		Если ЗаписьCash.Свойство("currency") Тогда
			Currency = ЗаписьCash.currency;
		КонецЕсли;
				
		Если СчетчикCash = 0 Тогда
						
			//ТаблицаОстатковИОборотовПоАналитическимСчетамДС = ОстаткиПоАналитическимСчетамБрокераДС(ДатаБалланса);
			СчетчикCash = СчетчикCash + 1;
		КонецЕсли;
		
		Если СчетчикCash > 0 И ЗначениеЗаполнено(ДатаБалланса) Тогда
			
			НоваяСтрока	= ТаблицаДанных3.Добавить();
			НоваяСтрока.ТорговыйКод = InvAccount;
			КодТорг = Справочники.ТорговыеКоды.НайтиПоРеквизиту("ТорговыйКод", НоваяСтрока.ТорговыйКод);
			Если ЗначениеЗаполнено(КодТорг) Тогда
				НоваяСтрока.АналитическийСчетДС = НайтиАналитическийСчетпоТорговомуКодуиВалюте(НоваяСтрока.ТорговыйКод,Справочники.Валюты.RUB);			
				НоваяСтрока.ДоговорДУ = ОбщегоНазначения.ПолучитьЗначениеРеквизита(КодТорг, "ДоговорДУ");
				АналитическийСчетДС = НоваяСтрока.АналитическийСчетДС;
				Если НЕ ВестиТолькоБухгалтерскийУчет И ЗначениеЗаполнено(АналитическийСчетДС) Тогда
					НоваяСтрока.ФизическоеМестоХраненияДС = ?(ЗначениеЗаполнено(АналитическийСчетДС.АналитическийПризнакСчетаБрокера),АналитическийСчетДС.АналитическийПризнакСчетаБрокера, АналитическийСчетДС.МестоХранения);
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.Дата = ДатаБалланса;
			НоваяСтрока.СуммаНачальныйОстаток = BalOpen;
			НоваяСтрока.СуммаОборотКт = Credited;
			НоваяСтрока.СуммаОборотДт = Debited;
			НоваяСтрока.СуммаКонечныйОстаток = BalCls;
			
			СчетчикCash = СчетчикCash + 1;
		КонецЕсли;
					
	КонецЦикла;  
			
КонецПроцедуры

Процедура ПрочитатьCashFlowБанкВТБ_JSON(БлокCashFlow, ВестиТолькоБухгалтерскийУчет, SubAccount, ИмяФайлаБезРасширения, ЛокТаблицаДанных5, тблКешФлоу, СчетчикСтрок, СоответствиеКодЦБНаБирже, БрокерУИД)
	
	//ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить(); 
	
	Для Каждого ЗаписьCashFlow из БлокCashFlow Цикл
		
		НазначениеПлатежа = "";
		Если ЗаписьCashFlow.Свойство("numberDescr") Тогда
			НазначениеПлатежа = ЗаписьCashFlow.numberDescr;
		КонецЕсли; 
		Если ЗаписьCashFlow.Свойство("Descr") Тогда
			НазначениеПлатежа = ЗаписьCashFlow.Descr;
		КонецЕсли;		
		
		InvAccount 		= "";
		ДатаБалланса 	= "";
		Credited 		= "";
		Debited 		= "";
		Currency 		= "";
		
		Если ЗаписьCashFlow.Свойство("invAccount") Тогда
			InvAccount = ЗаписьCashFlow.invAccount;
		КонецЕсли;
		Если ЗаписьCashFlow.Свойство("date") Тогда
			ДатаСтрока = СтрЗаменить(ЗаписьCashFlow.date, "-", "");
			ДатаСтрока = СтрЗаменить(ДатаСтрока, "T00:00:00", "");
			ДатаБалланса = Дата(ДатаСтрока);
		КонецЕсли;
		Если ЗаписьCashFlow.Свойство("credited") Тогда
			Credited = ЗаписьCashFlow.credited;
		КонецЕсли;
		Если ЗаписьCashFlow.Свойство("debited") Тогда
			Debited = ЗаписьCashFlow.debited;
		КонецЕсли;
		Если ЗаписьCashFlow.Свойство("currency") Тогда
			Currency = ЗаписьCashFlow.currency;
		КонецЕсли;
		
		Если (СтрНайти(НазначениеПлатежа, "Выплата") > 0 И СтрНайти(НазначениеПлатежа, "купона") > 0)
			ИЛИ СтрНайти(Врег(НазначениеПлатежа), "ДИВИДЕН") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Комиссия за расчетные услуги") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Частичное погашение") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Полное погашение") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Списание комиссии с ИБС клиента") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Погашение купона") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Депозитарная комиссия") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Использование брокером ДС клиента") > 0 //IMDEV-621, IMDEV-622
			ИЛИ СтрНайти(Назначениеплатежа, "Комиссия «Проведение расчетных операций с ценными бумагами по итогам сделок»") > 0 //IMAPPS-11276
			ИЛИ СтрНайти(Назначениеплатежа, "Комиссия «Возмещение расходов НКО АО НРД за обслуживание выпуска ценных бумаг»") > 0 //IMAPPS-13993
			ИЛИ СтрНайти(НазначениеПлатежа, "MICEX / Возврат выплат.Исполнение обязательств по передаче дохода Клиринговым центром ") > 0 // IMAPPS-23546
			
			ИЛИ СтрНайти(НазначениеПлатежа, "Оплата комиссии по операции Проведение расчетных операций с ЦБ (оплата)") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Комиссия за хранение цб. Счет депо") > 0 // IMAPPS-37065
			ИЛИ СтрНайти(НазначениеПлатежа, "Выплата купонного дохода по облигациям") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Выплата дохода по акциям") > 0
			ИЛИ СтрНайти(НазначениеПлатежа, "Погашение номинальной стоимости облигаций") > 0
			
		Тогда
			
			НоваяСтрока	= ТаблицаДанных2.Добавить();
			НоваяСтрока.ТорговыйКод = InvAccount;
			
			НоваяСтрока.Дата = ДатаБалланса;
			ИскатьКупон = Ложь;
			Если СтрНайти(НазначениеПлатежа, "Выплата") > 0 И СтрНайти(НазначениеПлатежа, "купона") > 0 Тогда
				НоваяСтрока.КодЦБ = СокрЛП(Лев(НазначениеПлатежа, СтрНайти(НазначениеПлатежа, "(Выплата")-1));
				ИскатьКупон = Истина;
			ИначеЕсли СтрНайти(НазначениеПлатежа, "Выплата купонного дохода по облигациям") > 0 Тогда
				НоваяСтрока.КодЦБ = НайтиПоИсинВНазначенииПлатежа(НазначениеПлатежа);
				ИскатьКупон = Истина;
			ИначеЕсли СтрНайти(НазначениеПлатежа, "Погашение купона") > 0 Тогда
				НоваяСтрока.КодЦБ = НайтиПоИсинВНазначенииПлатежа(НазначениеПлатежа);
				ИскатьКупон = Истина;
			ИначеЕсли СтрНайти(НазначениеПлатежа, "Частичное погашение") > 0 Тогда
				НоваяСтрока.КодЦБ = СокрЛП(Лев(НазначениеПлатежа, СтрНайти(НазначениеПлатежа, "(Частичное")-1));
				Если Не ЗначениеЗаполнено(НоваяСтрока.КодЦБ) Тогда
					НоваяСтрока.КодЦБ = НайтиПоИсинВНазначенииПлатежа(НазначениеПлатежа);
				КонецЕсли;
			ИначеЕсли СтрНайти(НазначениеПлатежа, "Полное погашение") > 0 Тогда
				НоваяСтрока.КодЦБ = СокрЛП(Лев(НазначениеПлатежа, СтрНайти(НазначениеПлатежа, "(Полное погашение")-1));
				Если Не ЗначениеЗаполнено(НоваяСтрока.КодЦБ) Тогда
					НоваяСтрока.КодЦБ = НайтиПоИсинВНазначенииПлатежа(НазначениеПлатежа);
				КонецЕсли;
			ИначеЕсли СтрНайти(НазначениеПлатежа, "Погашение номинальной стоимости облигаций") > 0 Тогда
				НоваяСтрока.КодЦБ = НайтиПоИсинВНазначенииПлатежа(НазначениеПлатежа);
			ИначеЕсли СтрНайти(Врег(НазначениеПлатежа), "MICEX / ВОЗВРАТ ВЫПЛАТ") > 0 Тогда
				НоваяСтрока.КодЦБ = СокрЛП(Прав(НазначениеПлатежа,12));
				НоваяСтрока.Актив = НайтиАктивПоISIN(НоваяСтрока.КодЦБ);
			ИначеЕсли СтрНайти(Врег(НазначениеПлатежа), "ДИВИДЕН") > 0 Или СтрНайти(Врег(НазначениеПлатежа), "ВЫПЛАТА ДОХОДА ПО АКЦИЯМ") > 0 Тогда
				НоваяСтрока.КодЦБ = НайтиПоИсинВНазначенииПлатежа(НазначениеПлатежа);
			КонецЕсли;
			
			НоваяСтрока.НазначениеПлатежа = НазначениеПлатежа;
			
			Если БрокерУИД = "73fc232b-45e3-11e2-b4e9-005056b100ec" Тогда // Банк ВТБ
				НоваяСтрока.Приход = Credited;
				НоваяСтрока.Расход = Debited;
			Иначе
				НоваяСтрока.Приход = Debited;
				НоваяСтрока.Расход = Credited;
			КонецЕсли;
			
			ТорговыйКодБрокера = ПолучитьТорговыйКодПоСчетуБрокера(SubAccount, InvAccount, Currency);
			
			Для Каждого Строка Из ТорговыйКодБрокера Цикл
				НоваяСтрока.АналитическийСчетДС = Строка.АналитическийСчетДС;
				НоваяСтрока.Брокер = Строка.Брокер;
				НоваяСтрока.ДоговорДУ = Строка.ДоговорДУ;
				НоваяСтрока.ДоговорБрокера = Строка.ДоговорБрокера;
			КонецЦикла;
			
			//Поиск бумаги				
			Если НоваяСтрока.Актив = Справочники.Активы.ПустаяСсылка() Тогда 
				
				АктивОбъект = СоответствиеКодЦБНаБирже.Получить(НоваяСтрока.КодЦБ);
				Если АктивОбъект <> Неопределено Тогда
					НоваяСтрока.Актив = АктивСервер.ПолучитьАктивПоОбъекту(АктивОбъект);
				Иначе
					КонтекстСопоставления = Перечисления.КонтекстСопоставления.ЦенныеБумаги;
					НоваяСтрока.Актив = РегистрыСведений.УниверсальныеСопоставления.ПрочитатьПрямоеСопоставление(КонтекстСопоставления,Справочники.Биржи.ПустаяСсылка(), НоваяСтрока.КодЦБ, Ложь, ДатаБалланса);
				КонецЕсли;
				
			КонецЕсли; 
			
			//Заполним реквизиты по торговому коду
			КодТорг = Справочники.ТорговыеКоды.НайтиПоРеквизиту("ТорговыйКод", НоваяСтрока.ТорговыйКод); 
			ВалютаСчета = Справочники.Валюты.RUB;
			Если КодТорг = Справочники.ТорговыеКоды.ПустаяСсылка() Тогда 
				Если Currency = "RUR" Тогда 
					ВалютаCashFlows = "RUB";
				Иначе 
					ВалютаCashFlows = Currency;
				КонецЕсли;
				Если  НЕ ВалютаCashFlows = "RUB" и НЕ ПустаяСтрока(ВалютаCashFlows) Тогда
					ВалютаСчета = ПолучитьВалютуПоСтроке(ВалютаCashFlows);
				КонецЕсли;	
				КодТорг = ПолучитьТорговыйКодСсылку(НоваяСтрока.ТорговыйКод + "/" + ВалютаCashFlows);
			КонецЕсли; 
			НоваяСтрока.Валюта = ВалютаСчета;
			
			Если ЗначениеЗаполнено(КодТорг) Тогда

				Если ЗначениеЗаполнено(КодТорг) Тогда
					НоваяСтрока.АналитическийСчетДС = НайтиАналитическийСчетпоТорговомуКодуиВалюте(НоваяСтрока.ТорговыйКод,ВалютаСчета,КодТорг);
				Иначе
					НоваяСтрока.АналитическийСчетДС = НайтиАналитическийСчетпоТорговомуКодуиВалюте(НоваяСтрока.ТорговыйКод,ВалютаСчета);
				КонецЕсли;
				СтруктураКодТорг = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(КодТорг, "ДоговорДУ, Биржа, Брокер, ДоговорБрокера");
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураКодТорг);
				 АналитическийСчетДС = НоваяСтрока.АналитическийСчетДС;
				Если НЕ ВестиТолькоБухгалтерскийУчет И ЗначениеЗаполнено(АналитическийСчетДС) Тогда
					НоваяСтрока.ФизическоеМестоХраненияДС = ?(ЗначениеЗаполнено(АналитическийСчетДС.АналитическийПризнакСчетаБрокера),АналитическийСчетДС.АналитическийПризнакСчетаБрокера, АналитическийСчетДС.МестоХранения);
				КонецЕсли;
			КонецЕсли;
			
			//Поиск купона
			Если ИскатьКупон И ЗначениеЗаполнено(НоваяСтрока.Актив)И ЗначениеЗаполнено(НоваяСтрока.ДоговорДУ) Тогда
				НоваяСтрока.Купон = ПолучитьКупон(ДатаБалланса, НоваяСтрока.Актив.Объект, НоваяСтрока.Расход, НоваяСтрока.ДоговорДУ, НоваяСтрока.ТорговыйКод, СчетчикСтрок, ИмяФайлаБезРасширения,,НоваяСтрока.Валюта);
			КонецЕсли;
			
			СчетчикСтрок = СчетчикСтрок + 1;
			
		ИначеЕсли СтрНайти(НазначениеПлатежа, "Перечислено в ТС (Зачисление денег) / Выведено из ТС (Перевод на Основной рынок)") > 0 Тогда
			
			НоваяСтрока = ЛокТаблицаДанных5.Добавить();
			
			НоваяСтрока.Дата = ДатаБалланса;
			
			Приход = 0;
			Попытка
				Приход = Число(Debited);
			Исключение
			КонецПопытки;
			
			Расход = 0;
			Попытка
				Расход = Число(Credited);
			Исключение
			КонецПопытки;
			
			НоваяСтрока.Сумма = Макс(Приход, Расход);
			
			ТорговыйКодБрокера = ПолучитьТорговыйКод(SubAccount);
			Для Каждого Строка Из ТорговыйКодБрокера Цикл
				Если Приход > 0 Тогда
					НоваяСтрока.ТорговыйКодПриход = Строка.Ссылка;
				ИначеЕсли Расход > 0 Тогда
					НоваяСтрока.ТорговыйКодРасход = Строка.Ссылка;
				КонецЕсли;
				НоваяСтрока.ДоговорДУ = Строка.ДоговорДУ;
			КонецЦикла;
			
			// IMAPPS-30183++
			НоваяСтрока.Описание = НазначениеПлатежа;
			// IMAPPS-30183--
			
			СчетчикСтрок = СчетчикСтрок + 1
			
		ИначеЕсли СтрНайти(НазначениеПлатежа, "Перевод ДС ") > 0 
			Или СтрНайти(НазначениеПлатежа, "Перевод денежных средств с субсчета ") > 0 Тогда
			
			НоваяСтрока = тблКешФлоу.Добавить();
			НоваяСтрока.Счет 		 = InvAccount;
			НоваяСтрока.Период 		 = ДатаБалланса;
			НоваяСтрока.Описание	 = НазначениеПлатежа;
			НоваяСтрока.Кредит 		 = Credited;
			НоваяСтрока.Дебет 		 = Debited;
			НоваяСтрока.Валюта 		 = Currency;
			НоваяСтрока.СубСчет		 = SubAccount;
			
			СчетчикСтрок = СчетчикСтрок + 1
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

