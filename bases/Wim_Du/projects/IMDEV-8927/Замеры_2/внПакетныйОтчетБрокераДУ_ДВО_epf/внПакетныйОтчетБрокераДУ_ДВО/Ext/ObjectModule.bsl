			ДокументОперацияПоСчетуБрокера.КратностьВзаиморасчетов 	= КурсКратность.Кратность;
		Иначе	
			ДокументОперацияПоСчетуБрокера.КурсВзаиморасчетов = 1;
			ДокументОперацияПоСчетуБрокера.КратностьВзаиморасчетов = 1;
			ДокументОперацияПоСчетуБрокера.ВалютаДокумента = Строчка.ДоговорДУ.Валюта;
		КонецЕсли;                                                                                   
		ВалютаПоСтроке =  Строчка.Валюта;
		Если ВалютаПоСтроке <> Строчка.ДоговорДУ.Валюта 
