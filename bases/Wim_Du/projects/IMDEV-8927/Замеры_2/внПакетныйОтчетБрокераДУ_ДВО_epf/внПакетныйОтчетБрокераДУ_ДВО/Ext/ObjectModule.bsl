Функция ПолучитьКупон(ДатаОтчета, Облигация, СуммаОстатокДт, ДоговорДУ, ТорговыйКод, НомерСтроки, ИмяФайла,Важность = 0, Валюта = Неопределено) Экспорт
	Если Валюта = Неопределено  или Валюта = Справочники.Валюты.ПустаяСсылка()Тогда
		Валюта = Справочники.Валюты.RUB
	КонецЕсли;
	//Получаем купонный период 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто3 КАК Справочник.КупонныеПериоды) КАК Купон
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&ДатаОтчета,
	|			Счет  = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыПоОблигациям),
	|			,
	|			Валюта = &Валюта
	|				И ДоговорДУ = &ДоговорДУ
	|				И Субконто2 = &Облигация) КАК ХозрасчетныйОстатки
	|ГДЕ
	|	ХозрасчетныйОстатки.СуммаОстатокДт >= &СуммаОстатокДт";
	
	Запрос.УстановитьПараметр("ДатаОтчета", КонецДня(ДатаОтчета)+1);
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	Запрос.УстановитьПараметр("Облигация", Облигация);
	Запрос.УстановитьПараметр("СуммаОстатокДт", СуммаОстатокДт);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Купон;
	Иначе
		//масСообщения.Добавить("Внимание! Не найден Купонный период для " + Облигация);
		ДобавитьСообщение(ИмяФайла, НомерСтроки, ТорговыйКод, ДоговорДУ, "Внимание! Не найден Купонный период для " + Облигация, СтатусСообщения.Важное);
		Важность = 1;
		Возврат Справочники.КупонныеПериоды.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции // ПолучитьКупон()

