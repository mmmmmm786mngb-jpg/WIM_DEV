Функция ДатаДокументаИзТаблицы(ТорговыйКодФайл)

	СтрокаДатыПоТорговымКодам = ДатыПоТорговымКодам.Найти(ТорговыйКодФайл, "ТорговыйКодФайл");
	
	Если СтрокаДатыПоТорговымКодам<>Неопределено Тогда
		Возврат СтрокаДатыПоТорговымКодам.ДатаДокумента;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции // ДатаДокументаИзТаблицы(СтрокаДоговорДУ.ТорговыйКодФайл)()

Процедура КлирингОткрытыхПозицийСоздатьДокумент() Экспорт

	Если ТаблицаДанных10.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТЗДоговорДУ = ТаблицаДанных10.Выгрузить();
	ТЗДоговорДУ.Свернуть("ДоговорДУ, ДоговорКонтрагента, АналитическийСчетДС, TransDate, ТорговыйКодФайл, GO",);

	Для каждого СтрокаДоговорДУ Из ТЗДоговорДУ Цикл
		
		ДатаДокумента = ДатаДокументаИзТаблицы(СтрокаДоговорДУ.ТорговыйКодФайл);//СтрокаДоговорДУ.TransDate;
		
		СтруктураДокумента = Новый Структура("ДоговорДУ, ДатаДок", СтрокаДоговорДУ.ДоговорДУ, ДатаДокумента);
		
		НовыйДокумент = КлирингОткрытыхПозиций(СтруктураДокумента);//Документы.КлирингОткрытыхПозиций.СоздатьДокумент();
		

		ГарОбеспеч = СтрокаДоговорДУ.GO;
		
		АналитическийСчетДС = СтрокаДоговорДУ.АналитическийСчетДС;
		
		СтрутураОтбор = Новый Структура("ДоговорДУ, TransDate", СтрокаДоговорДУ.ДоговорДУ, СтрокаДоговорДУ.TransDate);
		СтрокиТаблицаДанных10 = ТаблицаДанных10.НайтиСтроки(СтрутураОтбор);
		
		Для Каждого СтрокаТаблицы Из СтрокиТаблицаДанных10 ЦИкл
			
			НовыйКонтракт = НовыйДокумент.Контракты.Добавить();
			НовыйКонтракт.ВариационнаяМаржа = СтрокаТаблицы.VariationMargin;
			НовыйКонтракт.ВидОбращаемости = Перечисления.ВидыОбращаемостиЦБ.ОбращающиесяФинансовыеИнструментыСрочныхСделокСБазиснымАктивомНеЦБ;
			НовыйКонтракт.Контракт = СтрокаТаблицы.Актив;
			
		КонецЦикла;
		
		//НовыйДокумент.Дата = НачалоДня(ДатаДокумента) + 72000; // 18:00;
		//НовыйДокумент.Дата = НачалоДня(ДатаДокумента) + 72000; // 18:00;
		
		НовыйДокумент.АналитическийСчетДС = АналитическийСчетДС;
		НовыйДокумент.Контрагент = Брокер;
		НовыйДокумент.ДоговорКонтрагента = СтрокаДоговорДУ.ДоговорКонтрагента;
		//НовыйДокумент.ДоговорДУ = СтрокаДоговорДУ.ДоговорДУ;
		
		НовыйДокумент.КурсВзаиморасчетов = 1;
		НовыйДокумент.КратностьВзаиморасчетов = 1;
		
		НовыйДокумент.СтатьяДвиженияДенежныхСредствВМ 	= Справочники.СтатьиДвиженияДенежныхСредств.ВариационнаяМаржа;
		НовыйДокумент.СтатьяДоходовИРасходовВМ 			= Справочники.СтатьиДоходовИРасходов.ВариационнаяМаржа;
		НовыйДокумент.СтатьяДвиженияДенежныхСредствГО 	= Справочники.СтатьиДвиженияДенежныхСредств.ГарантийноеОбеспечение;
		НовыйДокумент.ГарантированноеОбеспечение = ГарОбеспеч;
		
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			ОперацияАванкор = НовыйДокумент.Ссылка;
		Исключение
			НовыйДокумент.Записать();
			ОперацияАванкор = НовыйДокумент.Ссылка;
			ВызватьИсключение "Не удалось провести документ: " + ОписаниеОшибки();
		КонецПопытки;
		
		Для Каждого СтрокаТаблицы Из СтрокиТаблицаДанных10 ЦИкл
			СтрокаТаблицы.КлирингОткрытыхПозиций = НовыйДокумент.Ссылка;
		КонецЦикла;
		
		Сообщить(СтрШаблон("Документ %1 создан", ОперацияАванкор));
	
	КонецЦикла;
		
		
КонецПроцедуры


Процедура ЗаписатьДокументПоСтроке(обДок, СписДок, СтрокаТаблицы, НомСтр, Выводить = Истина,Важность = 0)

	х = новый Массив;
	х.Добавить(НомСтр); // №
	х.Добавить(СтрокаТаблицы.ТорговыйКод); //Торговый код
	х.Добавить(Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy")); // Дата
	х.Добавить(СтрокаТаблицы.ДоговорДУ); //Договор ДУ
	х.Добавить(СтрокаТаблицы.Брокер); //Брокер
	х.Добавить(СтрокаТаблицы.ДоговорБрокера); // Договор
	х.Добавить(СтрокаТаблицы.НазначениеПлатежа); //Назначение платежа
	х.Добавить(СтрокаТаблицы.Приход); //приход
	х.Добавить(СтрокаТаблицы.Расход); //расход
	Попытка
		обДок.Записать();
		Если СписДок.НайтиПоЗначению(обДок.Ссылка) = Неопределено Тогда
			СписДок.Добавить(обДок.Ссылка);	
		КонецЕсли;
	Исключение
		//масСообщения.Добавить("Не удалось записать данные строки №" + НомСтр + " в таблице ""Операции по счету брокера""");
		ДобавитьСообщение(СтрокаТаблицы.ИмяФайла, НомСтр, СтрокаТаблицы.ТорговыйКод, СтрокаТаблицы.ДоговорДУ, "Не удалось записать данные строки", СтатусСообщения.Важное); 
		Инфо = ИнформацияОбОшибке();
		х.Добавить("Ошибка записи документа: " + Инфо.Описание);// обДок.Метаданные().Синоним);
		Важность = 1;//Регистратор   
		РассылкаСообщения_СтрокаТаблицы(х);
    КонецПопытки;
	
		
КонецПроцедуры

