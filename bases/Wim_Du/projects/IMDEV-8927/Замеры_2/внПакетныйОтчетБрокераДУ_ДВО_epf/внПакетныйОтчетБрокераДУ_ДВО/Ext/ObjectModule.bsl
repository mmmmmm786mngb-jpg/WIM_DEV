				ДокументОперацияПоСчетуБрокера.СуммаДокументаРуб = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(Строчка.Приход, ВалютаДоговора, Строчка.ДоговорДУ.Валюта, 1, ДокументОперацияПоСчетуБрокера.КурсВзаиморасчетов, 1, ДокументОперацияПоСчетуБрокера.КратностьВзаиморасчетов);
			КонецЕсли;
			
			// IMAPPS-28406 ++
		ИначеЕсли СтрНайти(Строчка.НазначениеПлатежа, "Куп. дох. по обл.") > 0 Или СтрНайти(Строчка.НазначениеПлатежа, "Выплата купонного дохода по облигациям") > 0 Тогда
			
			Если ЗначениеЗаполнено(Строчка.Актив) И ТипЗнч(Строчка.Актив.Объект) = Тип("СправочникСсылка.Облигации") Тогда
				Облигация = Строчка.Актив.Объект;
				Эмитент = Облигация.Эмитент;
