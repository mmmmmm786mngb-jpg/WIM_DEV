Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды = "ФоновоеВыполнение" ИЛИ ИдентификаторКоманды = "ФоновоеПроведение" Тогда 
		
		// IMDEV-8927 ++
		Если ИдентификаторКоманды = "ФоновоеВыполнение" Тогда
			ИдентификаторКомандыДляЗамера = "ФоновоеВыполнение";
		КонецЕсли;
		// IMDEV-8927 --
		
		Если ИдентификаторКоманды = "ФоновоеПроведение" Тогда
			ПроставитьФлагВДокументах = Истина;
		Иначе
			ПроставитьФлагВДокументах = Ложь;
		КонецЕсли;
		
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
		
		ДопОбработка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;		
		
		Задача = Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
		Задача.Дата = ТекущаяДата();
		
		Задача.ВидОбмена 		= ДопОбработка;
		Задача.ВерсияОбработки 	= ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДопОбработка, "Версия");
		Задача.Наименование 	= "Сверка cделок ДУ с отчетом брокер";
		Задача.ПараметрыВыполнения = ПредставлениеНастроек;
		
		Если СписокРассылки.Количество()>0 и НЕ ПочтовыйЛогин.Пустая() тогда
			
			Если _Тест Тогда
				текстРассылки = СформироватьИОтправитьПисьмо('20160111', ПроставитьФлагВДокументах);
			Иначе
				// IMAPPS-25776 ++
				//текстРассылки = СформироватьИОтправитьПисьмо(ТекущаяДата() - 86400, ПроставитьФлагВДокументах);
				КалендарьММВБ = Справочники.Календари.ПолучитьСсылку(Новый УникальныйИдентификатор("5d49c010-d28a-11e2-8084-005056b100fc"));
				ПредРабДата = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(КалендарьММВБ, НачалоДня(ТекущаяДата()),-1);
				текстРассылки = СформироватьИОтправитьПисьмо(ПредРабДата, ПроставитьФлагВДокументах);
				// IMAPPS-25776 --
			КонецЕсли;
			
		КонецЕсли;
		
		Задача.Описание = Задача.Описание + Символы.ПС + "!";
		Задача.ВыполнитьЗадачу();
		
		// IMDEV-8927 ++
		ИдентификаторКомандыДляЗамера = Неопределено;
		// IMDEV-8927 --
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьИОтправитьПисьмо(ДатаСверки, ПроставитьФлагВДокументах)
	
	ДатаНачала = ДатаСверки;
	ДатаОкончания = КонецДня(ДатаСверки); 
	
	ЕстьОшибкиFAIL = Ложь;
	ЕстьОшибкиWARN = Ложь;
	ТекстОшибки = "";
	
	ТекстРезультат = "";	
	ТабличныйДокумент = ВыполнитьСверкуСделокСОтчетомБрокераSQL(ТекстРезультат, ПроставитьФлагВДокументах, ЕстьОшибкиFAIL, ЕстьОшибкиWARN, ТекстОшибки);
	
	Тема = ?(ЕстьОшибкиFAIL, "{FAIL} ", ?(ЕстьОшибкиWARN, "{WARN} ", "{OK} ")) + "Аванкор ДУ: Сверка cделок ДУ с отчетом брокера на " + Формат(ДатаСверки, "ДФ=dd.MM.yyyy") + ПропискаРассылки("r241");
			
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Вложения, Важность");
	Кому = Новый Массив;
	Для каждого ТекЯщик из СписокРассылки Цикл
		Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
	КонецЦикла;
	
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = Тема;
	ПараметрыПисьма.Тело = ТекстРезультат + ТекстОшибки;
	ПараметрыПисьма.ТипТекста = "ПростойТекст";
	ПараметрыПисьма.Важность = ?(ЕстьОшибкиFAIL ИЛИ ЕстьОшибкиWARN, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
	
	
	Если ТабличныйДокумент.Области.Количество() <= 1 Тогда
		Вложения = Новый Соответствие;
		ПараметрыПисьма.Вложения = Вложения;			
	Иначе
		ПутьКФайлу = ПолучитьИмяВременногоФайла("XLSX");
		ТабличныйДокумент.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);
		Вложения = Новый Соответствие;
		ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
		АдресВложения = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		Вложения.Вставить("Сверка cделок (только расхождения).xlsx", АдресВложения);
		ПараметрыПисьма.Вложения = Вложения;
	КонецЕсли;
		
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
		текстРассылки = "Рассылка завершена";
	Исключение
		текстРассылки = "Рассылка не удалась: "+ПочтовыйЛогин; 
		Сообщения = ПолучитьСообщенияПользователю(Истина);
	КонецПопытки;
	
	Возврат текстРассылки;
	
КонецФункции

