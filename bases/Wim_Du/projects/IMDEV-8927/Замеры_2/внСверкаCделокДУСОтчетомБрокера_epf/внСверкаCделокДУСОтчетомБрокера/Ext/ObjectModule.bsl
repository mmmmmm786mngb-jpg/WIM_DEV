		ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеОшибки();
		// IMDEV-8927 ++
		ЗавершитьЗамерСверкиСделокДУСОтчетомБрокера(ВремяНачалаЗамераСверки, КлючеваяОперацияСверки, 0,
			ПроставитьФлагВДокументах, ЕстьОшибкиFAIL, ЕстьОшибкиWARN);
		// IMDEV-8927 --
		Возврат Неопределено
	КонецЕсли;
	
	// IMDEV-8927 ++
	КоличествоСделокИзSQL = ТаблицаСделокБрокера.Количество();
