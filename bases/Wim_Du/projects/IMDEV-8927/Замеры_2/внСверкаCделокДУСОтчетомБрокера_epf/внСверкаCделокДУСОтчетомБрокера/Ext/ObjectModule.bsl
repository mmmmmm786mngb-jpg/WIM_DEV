	ОграничитьТаблицуСделокSQL(ТаблицаСделокБрокера, ЕстьОшибкиFAIL, ЕстьОшибкиWARN, ТекстОшибки);
	
	Если ТаблицаСделокБрокера = Неопределено Тогда
		Сообщить("Сверка не выполнена из-за ошибок", СтатусСообщения.Важное); 
