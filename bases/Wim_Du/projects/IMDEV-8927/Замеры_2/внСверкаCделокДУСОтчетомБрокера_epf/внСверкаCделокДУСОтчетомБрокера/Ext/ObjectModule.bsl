Функция ВыполнитьСверкуСделокСОтчетомБрокераSQL(ТекстРезультат = Неопределено, ПроставитьФлагВДокументах = Ложь,  ЕстьОшибкиFAIL = Ложь, ЕстьОшибкиWARN = Ложь, ТекстОшибки = "") Экспорт
	
	// IMDEV-8927 ++
	ВремяНачалаЗамераСверки = 0;
	КлючеваяОперацияСверки = "";
	КоличествоСделокИзSQL = 0;
