	               |	СделкиНаВалютномРынке.СуммаВВалютеРасчетов,
	               |	0,
	               |	ЕСТЬNULL(СделкиНаВалютномРынке.КомиссияБрокера, 0),
	               |	ЕСТЬNULL(СделкиНаВалютномРынке.КомиссияБиржи, 0),
	               |	СделкиНаВалютномРынке.Ссылка,
	               |	СделкиНаВалютномРынке.ПодтвержденаОтчетомБрокера
	               |ИЗ
	               |	СделкиНаВалютномРынке КАК СделкиНаВалютномРынке
	               |ГДЕ
	               |	НЕ СделкиНаВалютномРынке.ДоговорДУ В (&ИсключаемыеДоговорыДУ)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СделкиНаСрочномРынке.Дата,
	               |	СделкиНаСрочномРынке.НомерСделки,
	               |	СделкиНаСрочномРынке.ДоговорДУ,
	               |	СделкиНаСрочномРынке.ТипСделки,
	               |	СделкиНаСрочномРынке.Количество,
	               |	СделкиНаСрочномРынке.Сумма,
	               |	0,
	               |	ЕСТЬNULL(КомиссияБрокераСрочныеСделки.Стоимость, 0),
	               |	ЕСТЬNULL(КомиссияБиржиСрочныеСделки.Стоимость, 0),
	               |	СделкиНаСрочномРынке.Ссылка,
	               |	Ложь 
				   //СделкиНаСрочномРынке.ПодтвержденаОтчетомБрокера КАК ПодтвержденаОтчетомБрокера
	               |ИЗ
	               |	СделкиНаСрочномРынке КАК СделкиНаСрочномРынке
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КомиссияБрокераСрочныеСделки КАК КомиссияБрокераСрочныеСделки
	               |		ПО СделкиНаСрочномРынке.Ссылка = КомиссияБрокераСрочныеСделки.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КомиссияБиржиСрочныеСделки КАК КомиссияБиржиСрочныеСделки
	               |		ПО СделкиНаСрочномРынке.Ссылка = КомиссияБиржиСрочныеСделки.Ссылка
	               |ГДЕ
	               |	НЕ СделкиНаСрочномРынке.ДоговорДУ В (&ИсключаемыеДоговорыДУ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(СделкиСКомиссиями.НомерСделки) КАК Количество
	               |ИЗ
	               |	СделкиСКомиссиями КАК СделкиСКомиссиями
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(СделкиПоОтчетуБрокера.НомерСделки) КАК Количество
	               |ИЗ
	               |	СделкиПоОтчетуБрокера КАК СделкиПоОтчетуБрокера
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(СделкиПоОтчетуБрокера.НомерСделки, СделкиСКомиссиями.НомерСделки) КАК НомерСделки,
	               |	ЕСТЬNULL(СделкиПоОтчетуБрокера.ДатаСделки, СделкиСКомиссиями.Дата) КАК ДатаСделки,
	               |	ЕСТЬNULL(СделкиПоОтчетуБрокера.ТипСделки, СделкиСКомиссиями.ТипСделки) КАК Тип,
	               |	ЕСТЬNULL(СделкиСКомиссиями.ДоговорДУ, ""-"") КАК ДоговорДУ,
	               |	ЕСТЬNULL(СделкиСКомиссиями.Количество, ""-"") КАК Количество1,
	               |	ЕСТЬNULL(СделкиСКомиссиями.Сумма, ""-"") КАК Сумма1,
	               |	ЕСТЬNULL(СделкиСКомиссиями.НКД, ""-"") КАК НКД1,
	               |	ЕСТЬNULL(СделкиСКомиссиями.КомиссияБрокера, ""-"") КАК КомиссияБрокера1,
	               |	ЕСТЬNULL(СделкиСКомиссиями.КомиссияБиржи, ""-"") КАК КомиссияБиржи1,
	               |	ЕСТЬNULL(СделкиПоОтчетуБрокера.Количество, ""-"") КАК Количество2,
	               |	ЕСТЬNULL(СделкиПоОтчетуБрокера.Сумма, ""-"") КАК Сумма2,
	               |	ЕСТЬNULL(СделкиПоОтчетуБрокера.НКД, ""-"") КАК НКД2,
	               |	ЕСТЬNULL(СделкиПоОтчетуБрокера.КомиссияБрокера, ""-"") КАК КомиссияБрокера2,
	               |	ЕСТЬNULL(СделкиПоОтчетуБрокера.КомиссияБиржи, ""-"") КАК КомиссияБиржи2,
	               |	ЕСТЬNULL(СделкиПоОтчетуБрокера.НомерКлиента, ""-"") КАК НомерКлиента,
	               |	СделкиСКомиссиями.Ссылка КАК Документ,
	               |	ЕСТЬNULL(СделкиСКомиссиями.Ссылка.Проведен, ЛОЖЬ) КАК Проведен
	               |ИЗ
	               |	СделкиПоОтчетуБрокера КАК СделкиПоОтчетуБрокера
	               |		ПОЛНОЕ СОЕДИНЕНИЕ СделкиСКомиссиями КАК СделкиСКомиссиями
	               |		ПО (СделкиПоОтчетуБрокера.НомерСделки ПОДОБНО ""%"" + СделкиСКомиссиями.НомерСделки)
	               |			И СделкиПоОтчетуБрокера.ДатаСделки = СделкиСКомиссиями.Дата
	               |			И СделкиПоОтчетуБрокера.ТипСделки = СделкиСКомиссиями.ТипСделки
	               |ГДЕ
	               |	&Фильтр
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаСделки,
	               |	ДоговорДУ,
	               |	НомерСделки";
	

	Запрос.УстановитьПараметр("Таблица", ТаблицаСделокБрокера);
	Запрос.УстановитьПараметр("ИсключаемыеДоговорыДУ", ИсключаемыеДоговорыДУ.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	
	ФильтрЕстьРазличия = "(ЕСТЬNULL(СделкиПоОтчетуБрокера.Количество, ""-"") <> ЕСТЬNULL(СделкиСКомиссиями.Количество, ""-"") ИЛИ ЕСТЬNULL(СделкиПоОтчетуБрокера.Сумма, ""-"") <> ЕСТЬNULL(СделкиСКомиссиями.Сумма, ""-"") ИЛИ ЕСТЬNULL(СделкиПоОтчетуБрокера.НКД, ""-"") <> ЕСТЬNULL(СделкиСКомиссиями.НКД, ""-"") ИЛИ ЕСТЬNULL(СделкиПоОтчетуБрокера.КомиссияБрокера, ""-"") <> ЕСТЬNULL(СделкиСКомиссиями.КомиссияБрокера, ""-"") ИЛИ ЕСТЬNULL(СделкиПоОтчетуБрокера.КомиссияБиржи, ""-"") <> ЕСТЬNULL(СделкиСКомиссиями.КомиссияБиржи, ""-"") ИЛИ СделкиСКомиссиями.ДоговорДУ ЕСТЬ NULL ИЛИ СделкиПоОтчетуБрокера.НомерКлиента ЕСТЬ NULL)";
	
	КоличествоУстановленныхФлагов = 0;
	Если ПроставитьФлагВДокументах Тогда
		
		ЗаписьЖурналаРегистрации("!!! Происходила запись документов!!");
		
		СохраненныйТекстЗапроса = Запрос.Текст;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Фильтр", "НЕ (" + ФильтрЕстьРазличия + ")"); 
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			//Если ЗначениеЗаполнено(Выборка.Документ) Тогда
				ДокументОбъект = Выборка.Документ.ПолучитьОбъект();
				ДокументОбъект.ПодтвержденаОтчетомБрокера = Истина;
				Попытка
					Если Выборка.Проведен Тогда
						ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
					Иначе
						ДокументОбъект.Записать();
					КонецЕсли;
					КоличествоУстановленныхФлагов = КоличествоУстановленныхФлагов + 1;
				Исключение
					Сообщить("Ошибка при записи " + Выборка.Документ + ": " + ОписаниеОшибки(), СтатусСообщения.Важное);
					ЕстьОшибкиFAIL = Истина;
					ТекстОшибки = ТекстОшибки + "Ошибка при записи документа" +  Символы.ПС + ОписаниеОшибки();
				КонецПопытки;
			//КонецЕсли;
		КонецЦикла;
		Запрос.Текст = СохраненныйТекстЗапроса;
	КонецЕсли;
		
	Если ТолькоРазличия И Не ИсключитьПодтвержденныеБрокером Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Фильтр", ФильтрЕстьРазличия);
	ИначеЕсли ТолькоРазличия И ИсключитьПодтвержденныеБрокером Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Фильтр", ФильтрЕстьРазличия + " И СделкиСКомиссиями.ПодтвержденаОтчетомБрокера = Ложь");
	ИначеЕсли НЕ ТолькоРазличия И ИсключитьПодтвержденныеБрокером Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Фильтр", " СделкиСКомиссиями.ПодтвержденаОтчетомБрокера = Ложь");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Фильтр", "ИСТИНА");
	КонецЕсли;
			
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("Макет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	МассивРезультатовЗапроса = Запрос.ВыполнитьПакет();
	КоличествоАванкор = МассивРезультатовЗапроса[11].Выгрузить()[0].Количество;
	КоличествоВОтчете = МассивРезультатовЗапроса[12].Выгрузить()[0].Количество;
	
	Выборка = МассивРезультатовЗапроса[13].Выбрать();
	ЕстьРазличия = Ложь;
	Н = 2;
	Пока Выборка.Следующий() Цикл
		Н = Н + 1;
		
		ОбластьСтрока.Параметры.Заполнить(Выборка);
				
		ТабДокумент.Вывести(ОбластьСтрока);
		
		Для К = 5 По 9 Цикл
			Если ТабДокумент.Область(Н, К, Н, К).Текст <> ТабДокумент.Область(Н, К + 5, Н, К + 5).Текст Тогда
				ТабДокумент.Область(Н, К, Н, К).ЦветТекста = Новый Цвет(255,0,0);
				ТабДокумент.Область(Н, К + 5, Н, К + 5).ЦветТекста = Новый Цвет(255,0,0);
				ЕстьРазличия = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ТабДокумент.Область(Н, 4, Н, 4).Текст = "-" Тогда
			ТабДокумент.Область(Н, 4, Н, 4).ЦветТекста = Новый Цвет(255,0,0);
			ЕстьРазличия = Истина;
		КонецЕсли;
		
		Если ТабДокумент.Область(Н, 15, Н, 15).Текст = "-" Тогда
			ТабДокумент.Область(Н, 15, Н, 15).ЦветТекста = Новый Цвет(255,0,0);
			ЕстьРазличия = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьРазличия Тогда
		ТекстРезультат = "За период с " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	    ТекстРезультат = ТекстРезультат + Символы.ПС + "Количество сделок, загруженных в Аванкор ДУ:" + Символы.Таб + КоличествоАванкор;
		ТекстРезультат = ТекстРезультат + Символы.ПС + "Количество сделок в отчете брокера:" + Символы.Таб + КоличествоВОтчете;
		Если ПроставитьФлагВДокументах Тогда
			ТекстРезультат = ТекстРезультат + Символы.ПС + "Количество подтвержденных отчетом брокера сделок:" + Символы.Таб + КоличествоУстановленныхФлагов;
		КонецЕсли;
		ТекстРезультат = ТекстРезультат + Символы.ПС + "Отчет о расхождениях в находится приложении.";
		ЕстьОшибкиWARN = Истина;
	Иначе
		ТекстРезультат = "За период с " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	    ТекстРезультат = ТекстРезультат + Символы.ПС + "Количество сделок, загруженных в Аванкор ДУ:" + Символы.Таб + КоличествоАванкор + Символы.ПС + "(совпадает с отчетом брокера).";
		Если ПроставитьФлагВДокументах Тогда
			ТекстРезультат = ТекстРезультат + Символы.ПС + "Количество подтвержденных отчетом брокера сделок:" + Символы.Таб + КоличествоУстановленныхФлагов;
		КонецЕсли;
	КонецЕсли;	
	
	// IMDEV-8927 ++
	ЗавершитьЗамерСверкиСделокДУСОтчетомБрокера(ВремяНачалаЗамераСверки, КлючеваяОперацияСверки, КоличествоСделокИзSQL,
		ПроставитьФлагВДокументах, ЕстьОшибкиFAIL, ЕстьОшибкиWARN);
	// IMDEV-8927 --
	
	Возврат ТабДокумент
		
КонецФункции

Функция ПолучитьТаблицуСделокИзSQL(ЕстьОшибкиFAIL = Ложь, ТекстОшибки = "") Экспорт
	
	SQL = ВыполнитьПодключениеSQL(ЕстьОшибкиFAIL, ТекстОшибки);
	Если SQL = Неопределено Тогда                                                                                                  
		Возврат Неопределено
	КонецЕсли;
	
	// +Artur Mingalev 30.08.2021 IMAPPS-14159
	ТекстКоманды = "SELECT * FROM BrokerReports.dbo.dwhRpt_DayTransactions WHERE TransDate BETWEEN '" + Формат(ДатаНачала, "ДФ=yyyyMMdd") + "' AND '" + Формат(ДатаОкончания, "ДФ=yyyyMMdd") +"' AND " +"PartMark not like '%DMA_PIF'
	    //IMAPPS-25495
		|and NOT (FileName like '%VTBUA_TOTAL_nonDMA' and SecQty=0) and NOT OrderNumber like '%M%'";
		//IMAPPS-25495
	// -Artur Mingalev 30.08.2021 IMAPPS-14159
	CommandSQL = Новый COMОбъект("ADODB.Command");
	CommandSQL.ActiveConnection	= SQL;
	CommandSQL.CommandText		= ТекстКоманды;
	CommandSQL.CommandType		= 1;
	// Туманов ++ IMAPPS-18685
	CommandSQL.CommandTimeout	= 600;
	// Туманов -- IMAPPS-18685
	
	Попытка
		НаборЗаписей = CommandSQL.Execute();
	Исключение
		Сообщить("Ошибка выполнения SQL команды: " + ОписаниеОшибки());
		Сообщить("Текст команды:");
		Сообщить(ТекстКоманды);
		ЕстьОшибкиFAIL = Истина;
		ТекстОшибки = ТекстОшибки + " Ошибка подключения к базе " + Символы.ПС + ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;
	
	ТаблицаСделокИзSQL = Новый ТаблицаЗначений;
	ТаблицаСделокИзSQL.Колонки.Добавить("ISIN", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(15)));
	ТаблицаСделокИзSQL.Колонки.Добавить("НомерСделки", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(30)));
	ТаблицаСделокИзSQL.Колонки.Добавить("ДатаСделки", Новый ОписаниеТипов("Дата"));
	ТаблицаСделокИзSQL.Колонки.Добавить("ТипСделки", Новый ОписаниеТипов("Булево"));
	ТаблицаСделокИзSQL.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15,2)));
	ТаблицаСделокИзSQL.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15,2)));
	ТаблицаСделокИзSQL.Колонки.Добавить("НКД", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15,2)));	
	ТаблицаСделокИзSQL.Колонки.Добавить("КомиссияБрокера", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15,2)));	
	ТаблицаСделокИзSQL.Колонки.Добавить("КомиссияБиржи", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15,2)));
	ТаблицаСделокИзSQL.Колонки.Добавить("НомерКлиента", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(15)));
	
	Сч = 0;
	Пока НаборЗаписей.EOF() = 0 Цикл
		Сч = Сч+1;
		
		Строка = ТаблицаСделокИзSQL.Добавить();
		Строка.ISIN = НаборЗаписей.Fields("ISIN").Value;
		Строка.ДатаСделки = НаборЗаписей.Fields("TransDate").Value;
		Строка.ТипСделки = НаборЗаписей.Fields("DealType").Value;
		
		Строка.НомерСделки = Формат(НаборЗаписей.Fields("TransNumber").Value, "ЧГ=0");
		//VTBC SadykovNiyaz 21.09.2021 (IMAPPS-14773) {
		Если Лев(Строка.НомерСделки, 2) = "BP" Тогда
			Строка.НомерСделки = Прав(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 2);
			Если Лев(Строка.НомерСделки, 1) = "R" Тогда
				Строка.НомерСделки = Прав(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 1);
				Если Прав(Строка.НомерСделки, 2) = "-1" Тогда
					Строка.ТипСделки = 0;
				Иначе
					Строка.ТипСделки = 1;
				КонецЕсли;	
				Строка.НомерСделки = Лев(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 2);
			Иначе
				Строка.ТипСделки = 0;	
			КонецЕсли;				
		КонецЕсли;
		Если Лев(Строка.НомерСделки, 2) = "SP" Тогда
			Строка.НомерСделки = Прав(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 2);
			Если Лев(Строка.НомерСделки, 1) = "R" Тогда
				Строка.НомерСделки = Прав(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 1);
				Если Прав(Строка.НомерСделки, 2) = "-1" Тогда
					Строка.ТипСделки = 1;
				Иначе
					Строка.ТипСделки = 0;
				КонецЕсли;
				Строка.НомерСделки = Лев(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 2);
			Иначе
				Строка.ТипСделки = 1;
			КонецЕсли;
		КонецЕсли;
		//VTBC SadykovNiyaz 21.09.2021 (IMAPPS-14773) }
		
		Если Лев(Строка.НомерСделки, 1) = "B" Тогда
			Строка.НомерСделки = Прав(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 1);
			// MPazhukov IMAPPS-11766
			//Строка.ТипСделки = 0;
			Если Лев(Строка.НомерСделки, 1) = "R" Тогда
				Строка.НомерСделки = Прав(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 1);
				Если Прав(Строка.НомерСделки, 2) = "-1" Тогда
					Строка.ТипСделки = 0;
				Иначе
					Строка.ТипСделки = 1;
				КонецЕсли;
				Строка.НомерСделки = Лев(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 2);
			Иначе
				Строка.ТипСделки = 0;
			КонецЕсли;
			// MPazhukov IMAPPS-11766
		КонецЕсли;
		Если Лев(Строка.НомерСделки, 1) = "S" Тогда
			Строка.НомерСделки = Прав(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 1);
			// MPazhukov IMAPPS-11766
			//Строка.ТипСделки = 1;
			Если Лев(Строка.НомерСделки, 1) = "R" Тогда
				Строка.НомерСделки = Прав(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 1);
				Если Прав(Строка.НомерСделки, 2) = "-1" Тогда
					Строка.ТипСделки = 1;
				Иначе
					Строка.ТипСделки = 0;
				КонецЕсли;
				Строка.НомерСделки = Лев(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 2);
			Иначе
				Строка.ТипСделки = 1;
			КонецЕсли;
			// MPazhukov IMAPPS-11766
		КонецЕсли; 
		//IMAPPS-27962 +
		Если Лев(Строка.НомерСделки, 2) = "CB" Тогда
			Строка.НомерСделки = Прав(Строка.НомерСделки, СтрДлина(Строка.НомерСделки) - 2);
			Строка.ТипСделки = 0;
		КонецЕсли;
		//IMAPPS-27962 -
		Строка.Количество = НаборЗаписей.Fields("SecQty").Value;
		Если НаборЗаписей.Fields("TransPlace").Value = "FORTS" Тогда
			Строка.Сумма = Строка.Количество * НаборЗаписей.Fields("Price").Value;
		Иначе
			Строка.Сумма = НаборЗаписей.Fields("Amount").Value;
		КонецЕсли;
		Строка.НКД = НаборЗаписей.Fields("CoupInc").Value;
		Строка.КомиссияБрокера = НаборЗаписей.Fields("BrokerCMS").Value;
		Если НаборЗаписей.Fields("BrokerID").Value = 1 Тогда  
			Строка.КомиссияБиржи = НаборЗаписей.Fields("SecFees").Value;
		Иначе
			Строка.КомиссияБиржи = НаборЗаписей.Fields("ExchangeCMS").Value;
		КонецЕсли;
		Строка.НомерКлиента = НаборЗаписей.Fields("InvAccount").Value;
		
		НаборЗаписей.MoveNext();
	КонецЦикла;
	
	Возврат ТаблицаСделокИзSQL;
	
КонецФункции

Процедура ОграничитьТаблицуСделокSQL(ТаблицаСделок, ЕстьОшибкиFAIL = Ложь, ЕстьОшибкиWARN = Ложь, ТекстОшибки = "") // Исключить из таблицы сделки для ПИФ
	
	Если _Тест Тогда
		БазаПИФ = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединение(Справочники.ВнешниеИнформационныеБазы.НайтиПоНаименованию("AVC_DEV_PIF")).Соединение;
		//БазаПИФ = ПодключитьВнешнююБазу("AVC_DEV_PIF", "smsk02mg31");
		НаименованиеБрокераВТБ = "ООО ""ВТБ Капитал Брокер""";
	Иначе
		БазаПИФ = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединение(Справочники.ВнешниеИнформационныеБазы.НайтиПоНаименованию("PROD_AVC_PIF")).Соединение;
		//БазаПИФ = ПодключитьВнешнююБазу("PROD_AVC_PIF", "smsk01mg31");
		НаименованиеБрокераВТБ = "ООО ВТБ Капитал Брокер";
	КонецЕсли;
	
	Если БазаПИФ = Неопределено Тогда
		Сообщить("Не удалось подключиться к базе ПИФ", СтатусСообщения.Важное);
		ЕстьОшибкиFAIL = Истина;
		ТекстОшибки = ТекстОшибки + "Не удалось подключиться к базе ПИФ" + Символы.ПС + ОписаниеОшибки();
		Возврат;
	КонецЕсли;
	
	Если БазаПИФ.Справочники.Контрагенты.НайтиПоНаименованию(НаименованиеБрокераВТБ).Наименование = "" Тогда
		Сообщить("Не удалось найти ПИФ контрагента """ + НаименованиеБрокераВТБ + """ + в базе ПИФ", СтатусСообщения.Важное);
		Сообщить("из-за этого в сверке присутствуют сделки ПИФ", СтатусСообщения.Важное);
		ЕстьОшибкиWARN = Истина;
		ТекстОшибки = ТекстОшибки + "Не удалось найти ПИФ контрагента """ + НаименованиеБрокераВТБ + """ + в базе ПИФ, из-за этого в сверке присутствуют сделки ПИФ" + Символы.ПС + ОписаниеОшибки();
		Возврат;
	Иначе
		БрокерВТБ = БазаПИФ.Справочники.Контрагенты.НайтиПоНаименованию(НаименованиеБрокераВТБ);
	КонецЕсли;
	
	Запрос = БазаПИФ.NewObject("Запрос");
	Запрос.Текст = "ВЫБРАТЬ
					|ДоговорБрокера.Наименование КАК КодКлиента
					|	ИЗ
					|Справочник.ТорговыеКоды КАК ТорговыеКоды
					|	ГДЕ
					|ТорговыеКоды.Брокер = &БрокерВТБ
					|	И ВЫРАЗИТЬ(ТорговыеКоды.Ссылка.Наименование КАК СТРОКА(1)) <> ""я""
					|	И ВЫРАЗИТЬ(ТорговыеКоды.ПИФ.Наименование КАК СТРОКА(1)) <> ""я""";
					
	Запрос.УстановитьПараметр("БрокерВТБ", БрокерВТБ);				
	ТЗ_КодовКлиентовИзПИФ = Запрос.Выполнить().Выгрузить();
	
	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("КодКлиента", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(20)));
	
	Для Каждого Эл Из ТЗ_КодовКлиентовИзПИФ Цикл
		НСтрока = ТаблицаКодов.Добавить();
		НСтрока.КодКлиента = Эл.КодКлиента;
		//Сообщить(НСтрока.КодКлиента);
	КонецЦикла;
	
	//МассивСтрок = ТаблицаКодов.НайтиСтроки(Новый Структура("КодКлиента", "1001136"));
	//Сообщить(_Тест);
	//Сообщить(МассивСтрок.Количество());
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таблица.ISIN КАК ISIN,
	               |	Таблица.НомерСделки КАК НомерСделки,
	               |	Таблица.ДатаСделки КАК ДатаСделки,
	               |	Таблица.ТипСделки КАК ТипСделки,
	               |	Таблица.Количество КАК Количество,
	               |	Таблица.Сумма КАК Сумма,
	               |	Таблица.НКД КАК НКД,
	               |	Таблица.КомиссияБрокера КАК КомиссияБрокера,
	               |	Таблица.КомиссияБиржи КАК КомиссияБиржи,
	               |	Таблица.НомерКлиента КАК НомерКлиента
	               |ПОМЕСТИТЬ Сделки
	               |ИЗ
	               |	&Таблица КАК Таблица
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаКодов.КодКлиента КАК КодКлиента
	               |ПОМЕСТИТЬ КодПИФ
	               |ИЗ
	               |	&ТаблицаКодов КАК ТаблицаКодов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Сделки.ISIN КАК ISIN,
	               |	Сделки.НомерСделки КАК НомерСделки,
	               |	Сделки.ДатаСделки КАК ДатаСделки,
	               |	Сделки.ТипСделки КАК ТипСделки,
	               |	Сделки.Количество КАК Количество,
	               |	Сделки.Сумма КАК Сумма,
	               |	Сделки.НКД КАК НКД,
	               |	Сделки.КомиссияБрокера КАК КомиссияБрокера,
	               |	Сделки.КомиссияБиржи КАК КомиссияБиржи,
	               |	Сделки.НомерКлиента КАК НомерКлиента
	               |ИЗ
	               |	Сделки КАК Сделки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КодПИФ КАК КодПИФ
	               |		ПО Сделки.НомерКлиента = КодПИФ.КодКлиента
	               |ГДЕ
	               |	КодПИФ.КодКлиента ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Таблица", ТаблицаСделок);
	Запрос.УстановитьПараметр("ТаблицаКодов", ТаблицаКодов);
	
	Попытка
		ТаблицаСделок = Запрос.Выполнить().Выгрузить();
	Исключение
		ЕстьОшибкиFAIL = Истина;
		ТекстОшибки = ТекстОшибки + "Не удалось получить таблицу сделок" + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры


