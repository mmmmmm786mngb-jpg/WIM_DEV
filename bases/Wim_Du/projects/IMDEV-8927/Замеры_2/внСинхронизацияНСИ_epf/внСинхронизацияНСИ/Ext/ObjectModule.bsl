КонецФункции

Процедура ЗавершитьЗадачиПоУспешнымДоговорамДУ(УдачныеДоговорыДУ)
	
	Запрос = ВнешБаза.Соединение.NewObject("Запрос");
	Запрос.УстановитьПараметр("СписокДоговоровДУ", УдачныеДоговорыДУ);
	Запрос.УстановитьПараметр("Исполнитель", Синхронизатор);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗадачаИсполнителяПредметы.Ссылка КАК Задача
	|ИЗ
	|	Задача.ЗадачаИсполнителя.Предметы КАК ЗадачаИсполнителяПредметы
	|ГДЕ
	|	ЗадачаИсполнителяПредметы.Ссылка.Исполнитель = &Исполнитель
	|	И ЗадачаИсполнителяПредметы.Предмет ССЫЛКА Справочник.ВнутренниеДокументы
	|	И ЗадачаИсполнителяПредметы.Ссылка.Выполнена = ЛОЖЬ
	|	И ЗадачаИсполнителяПредметы.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ЗадачаИсполнителяПредметы.Ссылка.БизнесПроцесс.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияБизнесПроцессов.Активен)
	|	И ЗадачаИсполнителяПредметы.Ссылка.БизнесПроцесс ССЫЛКА БизнесПроцесс.Исполнение
	|	И ВЫРАЗИТЬ(ЗадачаИсполнителяПредметы.Предмет КАК Справочник.ВнутренниеДокументы) В (&СписокДоговоровДУ)
	|	И НЕ ЗадачаИсполнителяПредметы.РольПредмета = ЗНАЧЕНИЕ(Перечисление.РолиПредметов.Заполняемый)";
	
	Выборка = Запрос.Execute().Select();
	
	ИсполненныеЗадачи = ВнешБаза.Соединение.NewObject("Массив");
	
	ЕстьОповещенияУспеха = Ложь;
	Пока Выборка.Next() Цикл
		
		Задача = Выборка.Задача.ПолучитьОбъект();
		
		Попытка
			
			Задача.ExecuteTask();
			
			ЕстьОповещенияУспеха = Истина;
			ИсполненныеЗадачи.Add(Задача.Ссылка);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			
			ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Не удалось завершить задачу в 1С:ДО. Описание ошибки: %1", ТекстОшибки)
			);
			
			ОповещениеОХодеОбмена("Не удалось завершить задачу в ДО:" + ТекстОшибки, Истина);
		КонецПопытки;
		
	КонецЦикла;
	
	Если ЕстьОповещенияУспеха тогда
		 ОповещениеОХодеОбмена(""+ТекущаяДата() + " Выполнены задачи по успешным контрагентам");
	КонецЕсли;
	
	//Установить признак завершения синхронизации в предметах
	
	ЗапросПредметы = ВнешБаза.Соединение.NewObject("Query");
	ЗапросПредметы.УстановитьПараметр("СписокЗадач",			ИсполненныеЗадачи);
	ЗапросПредметы.УстановитьПараметр("ИмяСвойства",			ИМЯ_СВОЙСТВА_СИНХРОНИЗАЦИИ_ДОКУМЕНТА);
	ЗапросПредметы.УстановитьПараметр("СвойствоКонтрагентов",	ИМЯ_СВОЙСТВА_КОНТРАГЕНТА);
	ЗапросПредметы.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВидыВнутреннихДокументов.Ссылка КАК ВидДокумента,
	|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВидыДокументов
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыВнутреннихДокументов КАК ВидыВнутреннихДокументов
	|		ПО (ВидыВнутреннихДокументов.НаборСвойств = ДополнительныеРеквизитыИСведения.НаборСвойств)
	|ГДЕ
	|	ДополнительныеРеквизитыИСведения.Заголовок = &ИмяСвойства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Предмет КАК Предмет,
	|	ВложенныйЗапрос.Контрагент КАК Контрагент,
	|	ВложенныйЗапрос.ВидДокумента КАК ВидДокумента,
	|	ВложенныйЗапрос.РегистрационныйНомер КАК РегистрационныйНомер,
	|	ВидыДокументов.Ссылка КАК Свойство
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ЗадачаИсполнителяПредметы.Предмет КАК Предмет,
	|		ВЫРАЗИТЬ(ЗадачаИсполнителяПредметы.Предмет КАК Справочник.ВнутренниеДокументы).ВидДокумента КАК ВидДокумента,
	|		ВЫРАЗИТЬ(ЗадачаИсполнителяПредметы.Предмет КАК Справочник.ВнутренниеДокументы).РегистрационныйНомер КАК РегистрационныйНомер,
	|		ВЫРАЗИТЬ(ЗадачаИсполнителяПредметы.Предмет КАК Справочник.ВнутренниеДокументы).Контрагент КАК Контрагент
	|	ИЗ
	|		Задача.ЗадачаИсполнителя.Предметы КАК ЗадачаИсполнителяПредметы
	|	ГДЕ
	|		ЗадачаИсполнителяПредметы.Ссылка В(&СписокЗадач)
	|		И ЗадачаИсполнителяПредметы.Предмет ССЫЛКА Справочник.ВнутренниеДокументы
	|		И НЕ ЗадачаИсполнителяПредметы.РольПредмета = ЗНАЧЕНИЕ(Перечисление.РолиПредметов.Заполняемый)) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВидыДокументов КАК ВидыДокументов
	|		ПО ВложенныйЗапрос.ВидДокумента = ВидыДокументов.ВидДокумента";
	
	Предметы = ЗапросПредметы.Execute().Select();
	
	ОповещатьОбИзмененииДокументов = Ложь;
	ОповещатьОбИзменнииКонтрагентов= Ложь;
	
	ПредметУжеОбрабатывался 		= Новый Соответствие;
	КонтрагентУжеОбрабатывался 		= Новый Соответствие;
	
	Пока Предметы.Next() Цикл
		
		СвойствоДокумента	 	= Предметы.Свойство;
		ТекПредмет				= Предметы.Предмет;
		ТекКонтрагент 			= Предметы.Контрагент;
		
		Если ПредметУжеОбрабатывался.Получить(ТекПредмет)= Неопределено тогда
			
			ПредметУжеОбрабатывался.Вставить(ТекПредмет, ИСТИНА);
			ТекДок = ТекПредмет.GetObject();
			
			ПлатежноеПоручение = ПлатежныеПоручения.Найти(Предметы.РегистрационныйНомер, "НомерДоговорДУ");
			СвойствоОтправкаБрокеру 
				= ВнешБаза.Соединение.ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("УникальныйКодДляПоля", "Доп_7c5a900b_5");
			
			НеВыполнено = Истина;
			Пока НеВыполнено Цикл
				НеВыполнено = ДополнительныеРеквизитыДО(ТекДок, СвойствоДокумента, ПлатежноеПоручение, СвойствоОтправкаБрокеру);
			КонецЦикла;
			
			ОповещатьОбИзмененииДокументов = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОповещатьОбИзмененииДокументов тогда
		 ОповещениеОХодеОбмена(""+ТекущаяДата()+ " Установлены свойства документов");
	КонецЕсли;

КонецПроцедуры

Функция ДополнительныеРеквизитыДО(ТекДок, СвойствоДокумента, ПлатежноеПоручение, СвойствоОтправкаБрокеру)

	НеВыполнено = Истина;
	
	ДопРек = ТекДок.ДополнительныеРеквизиты;
	Строка = ДопРек.Найти(СвойствоДокумента,"Свойство");
	
	Если Строка = неопределено тогда
		Строка = ДопРек.Add();
	КонецЕсли;
	
	Строка.Свойство = СвойствоДокумента;
	Строка.Значение = Истина;
	
	Если ПлатежноеПоручение <> Неопределено Тогда
	
		Строка = ДопРек.Найти(СвойствоОтправкаБрокеру, "Свойство");
		Если Строка = неопределено тогда
			Строка = ДопРек.Add();
		КонецЕсли;
		Строка.Свойство = СвойствоОтправкаБрокеру;
		Строка.Значение = Истина;
	
	КонецЕсли;
	
	Попытка
		
		ТекДок.Записать();
		НеВыполнено = Ложь;
	
	Исключение
		НеВыполнено = Истина;
		
		ТекстОшибки = ОписаниеОшибки();
		
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Произошла ошибка при установке отметки в 1С:ДО 'Отправлено на брокерский счет' для договора "
			+ ПлатежноеПоручение.ДоговорДУ.Наименование +"! Описание ошибки: " + ТекстОшибки
		);
	КонецПопытки;
	
	Возврат НеВыполнено;

КонецФункции

//Создание процессов админу по неудачным контрагентам
Процедура СоздатьОповещениеАдмина(ОшибкиКонтрагенты, ТекстыОшибок)
	Перем ПользовательДляУведомлений;
	
	ПользовательДляУведомлений = ВнешБаза.Соединение.Справочники.Пользователи.НайтиПоНаименованию(ОповещениеОбОшибках);
	Если ПользовательДляУведомлений.Пустая() Тогда
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Пользователь для уведомления об ошибках: " + ОповещениеОбОшибках + " не найден в базе документооборота"
		);
		
		ОповещениеОХодеОбмена("Пользователь для уведомления об ошибках: " + ОповещениеОбОшибках + " не найден в базе документооборота", Истина);
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	ЕстьОповещения = Ложь;
	Для каждого текКонтрагент из ОшибкиКонтрагенты Цикл
		
		Если НЕ ОшибочныеКонтрагентыДО.Find(текКонтрагент) = неопределено Тогда Продолжить; КонецЕсли;
		
		//Создать новое ознакомление администратору
		НовоеОзнакомление = ВнешБаза.Соединение.БизнесПроцессы.Ознакомление.CreateBusinessProcess();
		НовоеОзнакомление.Автор 		= Синхронизатор;
		НовоеОзнакомление.Дата 			= ТекущаяДата();
		НовоеОзнакомление.Наименование 	= ИМЯ_ЗАДАЧИ_ОШИБКИСИНХРОНИЗАЦИИ;
		НовоеОзнакомление.Описание		= ""+ТекущаяДата() + Символы.ПС + " Во время синхронизации с ДУ возникла ошибка: "+ Символы.ПС + ТекстыОшибок.Получить(текКонтрагент);
		
		НовыйИсполнитель 				= НовоеОзнакомление.Исполнители.Add(); 
		НовыйИсполнитель.Исполнитель 	= ПользовательДляУведомлений; 
		
		ВнешБаза.Соединение.Мультипредметность.ПередатьПредметыПроцессу(НовоеОзнакомление,текКонтрагент);
		
		НовоеОзнакомление.Записать();
		НовоеОзнакомление.Старт();
		
		ЕстьОповещения = Истина;
	КонецЦикла;
	
	Если ЕстьОповещения тогда
		ОповещениеОХодеОбмена(""+ТекущаяДата() + " Созданы оповещения по ошибкам синхронизации");
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтрагентыСОшибкамиДО()
	
	ОшибочныеКонтрагентыДО = ВнешБаза.Соединение.NewObject("Массив");	
	
	//ЕстьОткрытые
	Запрос = ВнешБаза.Соединение.NewObject("Запрос");;
	Запрос.УстановитьПараметр("Наименование",		ИМЯ_ЗАДАЧИ_ОШИБКИСИНХРОНИЗАЦИИ);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ОзнакомлениеПредметы.Предмет КАК Справочник.Контрагенты) КАК Контрагент
	|ИЗ
	|	БизнесПроцесс.Ознакомление.Предметы КАК ОзнакомлениеПредметы
	|ГДЕ
	|	ОзнакомлениеПредметы.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ОзнакомлениеПредметы.Ссылка.Завершен = ЛОЖЬ
	|	И ОзнакомлениеПредметы.Ссылка.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияБизнесПроцессов.Активен)
	|	И ОзнакомлениеПредметы.Ссылка.Наименование = &Наименование
	|	И ОзнакомлениеПредметы.Предмет ССЫЛКА Справочник.Контрагенты";
	
	ОшибочныеКонтрагентыДО = Запрос.Execute().Unload().UnloadColumn("Контрагент");
	
КонецПроцедуры

Процедура ОповещениеОХодеОбмена(Знач ТекстСообщения, Знач ЭтоОшибка = Ложь)
	Сообщить(ТекстСообщения, ?(ЭтоОшибка, СтатусСообщения.ОченьВажное, СтатусСообщения.Информация));
КонецПроцедуры // ОповещениеОХодеОбмена()

Процедура СинхронизацияДатыРасторженияДоговоров_в_ДО()
	Перем ЗапросВн, ВыборкаВн, Запрос, Выборка;
	Перем ДанныеВн, НоваяСтрока;
	Перем МассивДляИсправления;
	
	МассивДляИсправления = Новый Массив();
	
	ДанныеВн = Новый ТаблицаЗначений();
	ДанныеВн.Колонки.Добавить("Договор");
	ДанныеВн.Колонки.Добавить("UIDДоговора", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ДанныеВн.Колонки.Добавить("ДатаРасторжения", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ДанныеВн.Колонки.Добавить("ПредставлениеДоговора", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ДанныеВн.Индексы.Добавить("UIDДоговора");
	
	ЗапросВн = ВнешБаза.Соединение.NewObject("Query");
	ЗапросВн.УстановитьПараметр("ВидДокумента", "ВидДокумента_ДоговорДУ_ФЛ");  // Договор доверительного управления (физ.лицо)
	ЗапросВн.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВнутренниеДокументы.Ссылка КАК Договор,
	|	ВнутренниеДокументы.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ВнутренниеДокументы.ДатаОкончанияДействия КАК ДатаРасторжения,
	|	ВнутренниеДокументы.Заголовок КАК ПредставлениеДоговора
	|ИЗ
	|	Справочник.ВнутренниеДокументы КАК ВнутренниеДокументы
	|ГДЕ
	|	НЕ ВнутренниеДокументы.ПометкаУдаления
	|	И НЕ ВнутренниеДокументы.НеДействует
	|	И 1 В
	|			(ВЫБРАТЬ
	|				1
	|			ИЗ
	|				РегистрСведений.УниверсальныеСопоставления КАК УниверсальныеСопоставления
	|			ГДЕ
	|				УниверсальныеСопоставления.Ключ = &ВидДокумента
	|				И УниверсальныеСопоставления.Значение ССЫЛКА Справочник.ВидыВнутреннихДокументов
	|				И УниверсальныеСопоставления.Значение = ВнутренниеДокументы.ВидДокумента)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВнутренниеДокументы.ДатаНачалаДействия,
	|	ВнутренниеДокументы.ДатаСоздания,
	|	Договор";
	
	ВыборкаВн = ЗапросВн.Execute().Select();
	Пока ВыборкаВн.Next() Цикл
		НоваяСтрока = ДанныеВн.Добавить();
		НоваяСтрока.Договор					 = ВыборкаВн.Договор;
		НоваяСтрока.UIDДоговора				 = ПолучитьСтроковыйUUID(ВыборкаВн.Договор);
		НоваяСтрока.ДатаРасторжения			 = ВыборкаВн.ДатаРасторжения;
		НоваяСтрока.ПредставлениеДоговора	 = ВыборкаВн.ПредставлениеДоговора;
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Договоры.Код КАК НомерДоговора,
	|	Договоры.Ссылка КАК Договор,
	|	Договоры.ДатаНачала КАК ДатаНачала,
	|	Договоры.ДатаОкончания КАК ДатаРасторжения,
	|	Договоры.ДатаВводаСредствВДУ КАК ДатаВводаСредствВДУ,
	|	ОбъектыИнтегрированные.ИдентификаторОбъектаДокументооборота КАК UIDДоговора
	|ИЗ
	|	Справочник.ДоговорДУ КАК Договоры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбъектыИнтегрированныеС1СДокументооборотом КАК ОбъектыИнтегрированные
	|		ПО (ОбъектыИнтегрированные.Объект = Договоры.Ссылка)
	|			И (ОбъектыИнтегрированные.Объект ССЫЛКА Справочник.ДоговорДУ)
	|ГДЕ
	|	ОбъектыИнтегрированные.ТипОбъектаДокументооборота = ""DMInternalDocument""
	|	И ОбъектыИнтегрированные.ИдентификаторОбъектаДокументооборота > """"
	|	И Договоры.ДатаОкончания > ДАТАВРЕМЯ(1, 1, 1)
	|	И Договоры.ДатаОкончания > Договоры.ДатаНачала
	|	//И Договоры.ДатаВводаСредствВДУ > ДАТАВРЕМЯ(1, 1, 1)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачала,
	|	НомерДоговора,
	|	Договор";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки = ДанныеВн.НайтиСтроки(Новый Структура("UIDДоговора", Выборка.UIDДоговора));
		Если Строки.Количество() > 0 Тогда
			Если Строки[0].ДатаРасторжения <> Выборка.ДатаРасторжения Тогда
				МассивДляИсправления.Добавить(
					Новый Структура(
						"Договор, ПредставлениеДоговора, ДатаРасторжения",
						Строки[0].Договор,
						Строки[0].ПредставлениеДоговора,
						Выборка.ДатаРасторжения
					)
				);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивДляИсправления.Количество() > 0 Тогда
		ТекстОшибки = "";
		ПорядокПродления = ВнешБаза.Соединение.Перечисления.ПорядокПродления.НеПродлевается;
		
		Для Каждого ТекЗначение Из МассивДляИсправления Цикл
			ВнешОбъект = ТекЗначение.Договор.ПолучитьОбъект();
			ВнешОбъект.ДатаОкончанияДействия = ТекЗначение.ДатаРасторжения;
			ВнешОбъект.НеДействует			 = ТекЗначение.ДатаРасторжения <= ТекущаяДата();
			ВнешОбъект.Бессрочный			 = Ложь;
			ВнешОбъект.ПорядокПродления		 = ПорядокПродления;
			
			Попытка
				ВнешОбъект.Записать();
			Исключение
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") + ОписаниеОшибки();
				
				ЗаписьЖурналаРегистрации(
					"Дополнительные отчеты и обработки." + Метаданные().Представление(),
					УровеньЖурналаРегистрации.Ошибка,,,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("При записи договора %1 в 1С:ДО произошла ошибка: %2", ТекЗначение.ПредставлениеДоговора, ТекстОшибки)
				);
				
				ОповещениеОХодеОбмена("Не удалось обновить договор в 1С:ДО (Дата расторжения): " + ТекЗначение.ПредставлениеДоговора + " " + ТекстОшибки, Истина);
			КонецПопытки;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры // СинхронизацияДатыРасторженияДоговоров_в_ДО()

Процедура СинхронизацияДатыПодписанияДоговоров_в_ДУ()
	Перем ЗапросВн, ВыборкаВн, Запрос, Выборка;
	Перем ДанныеВн, Строки, НоваяСтрока;
	Перем ТекущаяДата;
	
	ДанныеВн = Новый ТаблицаЗначений();
	ДанныеВн.Колонки.Добавить("Договор");
	ДанныеВн.Колонки.Добавить("UIDДоговора", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ДанныеВн.Колонки.Добавить("ДатаПодписания", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ДанныеВн.Индексы.Добавить("UIDДоговора");
	
	ТекущаяДата = ТекущаяДатаСеанса();
	
	ЗапросВн = ВнешБаза.Соединение.NewObject("Query");
	ЗапросВн.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	ЗапросВн.УстановитьПараметр("ВидДокумента", "ВидДокумента_ДоговорДУ_ФЛ");
	ЗапросВн.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВнутренниеДокументы.Ссылка КАК Договор,
	|	ВнутренниеДокументы.ДатаПодписания КАК ДатаПодписания
	|ИЗ
	|	Справочник.ВнутренниеДокументы КАК ВнутренниеДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УниверсальныеСопоставления КАК УниверсальныеСопоставления
	|		ПО (УниверсальныеСопоставления.Ключ = &ВидДокумента)
	|			И (УниверсальныеСопоставления.Значение ССЫЛКА Справочник.ВидыВнутреннихДокументов)
	|			И (УниверсальныеСопоставления.Значение = ВнутренниеДокументы.ВидДокумента)
	|ГДЕ
	|	НЕ ВнутренниеДокументы.ПометкаУдаления
	|	И ВнутренниеДокументы.ДатаПодписания > ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), МЕСЯЦ, -3)
	|	И ВнутренниеДокументы.РезультатПодписания = ЗНАЧЕНИЕ(Перечисление.РезультатыПодписания.Подписан)
	|	И НЕ ВнутренниеДокументы.НеДействует";
	
	ВыборкаВн = ЗапросВн.Execute().Select();
	Пока ВыборкаВн.Next() Цикл
		НоваяСтрока = ДанныеВн.Добавить();
		НоваяСтрока.Договор			 = ВыборкаВн.Договор;
		НоваяСтрока.UIDДоговора		 = ПолучитьСтроковыйUUID(ВыборкаВн.Договор);
		НоваяСтрока.ДатаПодписания	 = ВыборкаВн.ДатаПодписания;
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	УниверсальныеСопоставления.КонтекстОбъекта КАК Договор,
	|	УниверсальныеСопоставления.НашОбъект КАК Инвестпрофиль,
	|	ОбъектыИнтегрированные.ИдентификаторОбъектаДокументооборота КАК UIDДоговора
	|ИЗ
	|	РегистрСведений.УниверсальныеСопоставления КАК УниверсальныеСопоставления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбъектыИнтегрированныеС1СДокументооборотом КАК ОбъектыИнтегрированные
	|		ПО (ОбъектыИнтегрированные.Объект = УниверсальныеСопоставления.КонтекстОбъекта)
	|			И (ОбъектыИнтегрированные.ТипОбъектаДокументооборота = ""DMInternalDocument"")
	|ГДЕ
	|	УниверсальныеСопоставления.КонтекстСопоставления = ЗНАЧЕНИЕ(Перечисление.КонтекстСопоставления.ДоговорДУ)
	|	И УниверсальныеСопоставления.ВнешнийОбъект = ""Инвестпрофиль""
	|	И УниверсальныеСопоставления.ДатаНачалаДействия > ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), МЕСЯЦ, -3)
	|	И УниверсальныеСопоставления.НашОбъект ССЫЛКА Документ.ИнвестиционныйПрофиль
	|	И НЕ ВЫРАЗИТЬ(УниверсальныеСопоставления.НашОбъект КАК Документ.ИнвестиционныйПрофиль).Проведен
	|	И НЕ ВЫРАЗИТЬ(УниверсальныеСопоставления.НашОбъект КАК Документ.ИнвестиционныйПрофиль).ПометкаУдаления
	|	И УниверсальныеСопоставления.КонтекстОбъекта ССЫЛКА Справочник.ДоговорДУ
	|
	|УПОРЯДОЧИТЬ ПО
	|	UIDДоговора,
	|	Договор,
	|	Инвестпрофиль";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки = ДанныеВн.НайтиСтроки(Новый Структура("UIDДоговора", Выборка.UIDДоговора));
		Если Строки.Количество() > 0 Тогда
			УстановитьДатуПодписания_в_ДУ(Выборка.Договор, Выборка.Инвестпрофиль, Строки[0].ДатаПодписания);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // СинхронизацияДатыПодписанияДоговоров_в_ДУ()

Процедура УстановитьДатуПодписания_в_ДУ(Знач Договор, Знач Инвестпрофиль, Знач ДатаПодписания)
	Перем ДоговорОбъект, ПрофильОбъект;
	Перем ТекстОшибки;
	
	ДатаПодписания = НачалоДня(ДатаПодписания);
	
	НачатьТранзакцию();
	
	Попытка
		ДоговорОбъект = Договор.ПолучитьОбъект();
		Если НачалоДня(ДоговорОбъект.ДатаНачала) <> ДатаПодписания Тогда
			ДоговорОбъект.ДатаНачала	 = ДатаПодписания;
			ДоговорОбъект.ДатаОкончания	 = ДатаПодписания;
			ДоговорОбъект.Записать();
		КонецЕсли;
		
		ПрофильОбъект = Инвестпрофиль.ПолучитьОбъект();
		ПрофильОбъект.Дата = КонецДня(ДатаПодписания);
		ПрофильОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Произошла ошибка при синхронизации (установка даты подписания)! Описание ошибки: " + ТекстОшибки
		);
		
		ОповещениеОХодеОбмена("" + ТекущаяДата() + " Произошла ошибка во время установки даты подписания! Описание ошибки: " + ТекстОшибки, Истина);
	КонецПопытки;
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
КонецПроцедуры // УстановитьДатуПодписания_в_ДУ()

Функция СрокИИС(ДатаВводаДС)

	СрокиИИС = Новый Соответствие;
	СрокиИИС.Вставить(2024, 5);
	СрокиИИС.Вставить(2025, 5);
	СрокиИИС.Вставить(2026, 5);
	СрокиИИС.Вставить(2027, 6);
	СрокиИИС.Вставить(2028, 7);
	СрокиИИС.Вставить(2029, 8);
	СрокиИИС.Вставить(2030, 9);
	СрокиИИС.Вставить(2031, 10);
	
	ГодВвода = Год(ДатаВводаДС);
	
	СрокИИС = СрокиИИС.Получить(ГодВвода);
	СрокИИС = ?(СрокИИС = Неопределено, 10, СрокИИС);
	
	Возврат СрокИИС;

КонецФункции

