Процедура СформироватьИОтправитьПисьмо()
	РассылкаПП = РассылкаПП();
	
	Если РассылкаПП.Количество() > 0 Тогда
	
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность, Вложения");
		
		ТемаСообщения = "Платежные поручения по договорам розничного ДУ";
		
		ПутьКФайлуXLS = КаталогВременныхФайлов() + ТемаСообщения + ".xls";
		ТелоПисьма = ТелоПисьма("Аванкор ДУ: Платежные поручения по договорам розничного ДУ", РассылкаПП, ПутьКФайлуXLS);
		
		ПараметрыПисьма.Вложения = Новый Структура("Отчет", ПутьКФайлуXLS);

		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылки Цикл
			Если ТекЯщик.Общая Тогда
				Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
			КонецЕсли;
		КонецЦикла;
		
		ФлагРезультатаВТеме = "{OK} ";
		
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.Тема = ФлагРезультатаВТеме + ТемаСообщения + ПропискаРассылки("r285");
		ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
		ПараметрыПисьма.Тело = ТелоПисьма;
		ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
		
		РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
		
	ИначеЕсли РассылкаПП.Количество() <> ПлатежныеПоручения.Количество() Тогда
		
		РассылкаППОшибки = РассылкаПП(Истина);
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность, Вложения");
		
		ТемаСообщения = "Сбой создания платежных поручений по договорам розничного ДУ";
		
		ПутьКФайлуXLS = КаталогВременныхФайлов() + ТемаСообщения + ".xls";
		ТелоПисьма = ТелоПисьма("Аванкор ДУ: Ошибки - Платежные поручения по договорам розничного ДУ", РассылкаПП, ПутьКФайлуXLS);
		
		ПараметрыПисьма.Вложения = Новый Структура("Отчет", ПутьКФайлуXLS);
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылки Цикл
			Если ТекЯщик.Ошибки Тогда
				Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
			КонецЕсли;
		КонецЦикла;
		
		ФлагРезультатаВТеме = "{FAIL} ";
		
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.Тема = ФлагРезультатаВТеме + ТемаСообщения + ПропискаРассылки("r285.1");
		ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
		ПараметрыПисьма.Тело = ТелоПисьма;
		ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
		
		РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
	КонецЕсли;

КонецПроцедуры

Функция РассылкаПП(Ошибки = Ложь)

	РассылкаПП = ПлатежныеПоручения.Выгрузить();
	РассылкаПП.Очистить();
	
	Для каждого ПлатежноеПоручение Из ПлатежныеПоручения Цикл
		Если ЗначениеЗаполнено(ПлатежноеПоручение.ПлатежноеПоручение.ВерсияДанных) И ЗначениеЗаполнено(ПлатежноеПоручение.ДоговорДУ.ВерсияДанных) Тогда
			Если Не Ошибки Тогда
				БезОбшибокРассылкаПП = РассылкаПП.Добавить();
				ЗаполнитьЗначенияСвойств(БезОбшибокРассылкаПП, ПлатежноеПоручение);
			КонецЕсли;
		ИначеЕсли Ошибки Тогда
			ОбшибокиРассылкаПП = РассылкаПП.Добавить();
			ЗаполнитьЗначенияСвойств(ОбшибокиРассылкаПП, ПлатежноеПоручение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РассылкаПП;

КонецФункции

Функция ТелоПисьма(Заголовок, РассылкаПлатежныеПоручения, ПутьКФайлуXLS)

	ТабДок = Новый ТабличныйДокумент;
	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("ПлатежныеПоручения");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");

	ОбластьШапка.Параметры.Заголовок = Заголовок;
	ТабДок.Вывести(ОбластьШапка);
	
	Для каждого ПлатежноеПоручение Из РассылкаПлатежныеПоручения Цикл
	
		ОбластьСтрока.Параметры.Заполнить(ПлатежноеПоручение);
		ТабДок.Вывести(ОбластьСтрока);
	
	КонецЦикла;
	
	ОбластьПодвал.Параметры.ИтогоСуммаПлатежа = ПлатежныеПоручения.Итог("СуммаПлатежа");
	ТабДок.Вывести(ОбластьПодвал);
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла(".html");
	
	ТабДок.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.HTML);
	
	ТабДок.Записать(ПутьКФайлуXLS, ТипФайлаТабличногоДокумента.XLS);
	
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу);
	СтрHTML = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	УдалитьФайлы(ПутьКФайлу);
	
	Возврат СтрHTML;

КонецФункции

Функция ПропискаРассылки(Знач НомерРассылки) 
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции

Функция БлижайшийРабочийДень(ДатаРасчета, Предыдущий = Ложь)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	" + ?(Предыдущий, "МАКСИМУМ", "МИНИМУМ") + "(КалендарныеГрафики.ДатаГрафика) КАК ДатаГрафика
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
		|ГДЕ
		|	КалендарныеГрафики.ДатаГрафика " + ?(Предыдущий, "<", ">=") + " НАЧАЛОПЕРИОДА(&ДатаРасчета, ДЕНЬ)
		|	И КалендарныеГрафики.ДеньВключенВГрафик
		|	И КалендарныеГрафики.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.РегламентированныйКалендарь)";
	
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ДатаГрафика;
	КонецЕсли;
	
	Возврат ДатаРасчета;
	
КонецФункции

Функция ВремяТекущее()
	
	ТекВремя = ТекущаяДатаСеанса();
	Часы = Час(ТекВремя);
	Часы = ?(Часы > 20, 20, Часы);
	Минуты = ?(Часы = 20, 0, Минута(ТекВремя));
	Секунды = ?(Часы = 20, 0, Секунда(ТекВремя));
	
	Возврат Часы * 3600 + Минуты * 60 + Секунды;

КонецФункции

Функция ТекущееВремяРабочее()

	ДатаРасчета = ТекущаяДатаСеанса();
	РабочийДень = БлижайшийРабочийДень(ДатаРасчета);
	
	Если НачалоДня(ДатаРасчета) = НачалоДня(РабочийДень) Тогда
		Час = Час(ДатаРасчета);
		Если Час >= РабочееВремяНачало И Час < РабочееВремяОкончание Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ПлатежныеПорученияРозничногоДУ()

	ДатаРасчета = ТекущаяДатаСеанса();
	ПредыдущийРабочийДень = БлижайшийРабочийДень(ДатаРасчета, Истина);
	
	ПлатежныеПорученияСледующийРабочий.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыДУ.Ссылка КАК ДоговорДУ
		|ПОМЕСТИТЬ ВТ_ДоговорыДУ
		|ИЗ
		|	Справочник.ДоговорДУ КАК ДоговорыДУ
		|ГДЕ
		|	ДоговорыДУ.Пул = &Пул
		|	И НАЧАЛОПЕРИОДА(ДоговорыДУ.ДатаВводаСредствВДУ, ДЕНЬ) >= НАЧАЛОПЕРИОДА(&ПредыдущийРабочийДень, ДЕНЬ)
		|	И ДоговорыДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДАТАВРЕМЯ(1, 1, 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Поручение.Ссылка КАК ПоручениеПоДС,
		|	ПРЕДСТАВЛЕНИЕ(Поручение.ДоговорДУ) КАК ПредставлениеДоговора,
		|	Поручение.ДоговорДУ КАК ДоговорДУ,
		|	Поручение.ДоговорДУ.Код КАК НомерДоговорДУ,
		|	Поручение.СуммаДС КАК СуммаДоговора
		|ИЗ
		|	Документ.Поручение КАК Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
		|		ПО (ПлатежноеПоручение.ДокументОснование = Поручение.Ссылка)
		|ГДЕ
		|	ПлатежноеПоручение.Ссылка ЕСТЬ NULL
		|	И Поручение.ДоговорДУ В
		|			(ВЫБРАТЬ
		|				ДоговорыДУ.ДоговорДУ
		|			ИЗ
		|				ВТ_ДоговорыДУ КАК ДоговорыДУ)
		|	И Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.Перевод)
		|	И Поручение.Комментарий <> ""Перевод ДС при расторжении""";
	
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень", ПредыдущийРабочийДень);
	Запрос.УстановитьПараметр("Пул", ПулРозничноеДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПлатежноеПоручение = ПлатежныеПорученияСледующийРабочий.Добавить();
		ПлатежноеПоручение.ПлатежноеПоручение 
			= СоздатьПлатежноеПоручение(ВыборкаДетальныеЗаписи.ПоручениеПоДС, ДатаРасчета);
		ПлатежноеПоручение.ПредставлениеДоговора = ВыборкаДетальныеЗаписи.ПредставлениеДоговора;
		ПлатежноеПоручение.ДоговорДУ = ВыборкаДетальныеЗаписи.ДоговорДУ;
		ПлатежноеПоручение.НомерДоговорДУ = ВыборкаДетальныеЗаписи.НомерДоговорДУ;
		ПлатежноеПоручение.СуммаПлатежа = ВыборкаДетальныеЗаписи.СуммаДоговора;
	КонецЦикла;

КонецПроцедуры

Функция ПрефиксПисьма(ЕстьОшибки, ЕстьПредупреждения)
	Перем ПрефиксПисьма;
	
	Если ЕстьОшибки = Истина Тогда
		ПрефиксПисьма = "{FAIL} ";
		Важность = ВажностьИнтернетПочтовогоСообщения.Высокая;
	ИначеЕсли ЕстьПредупреждения = Истина Тогда
		ПрефиксПисьма = "{WARN} ";
		Важность = ВажностьИнтернетПочтовогоСообщения.Высокая;
	Иначе
		ПрефиксПисьма = "{OK} ";
		Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
	КонецЕсли;
	
	Возврат ПрефиксПисьма;
КонецФункции // ПрефиксПисьма()

Функция СформироватьИОтправитьПисьмоПоПоручениям(ЕстьОшибки, ЕстьПредупреждения)
	
	Тема = "Аванкор ДУ: Создание Поручений из Документооборота";
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
	Кому = Новый Массив;
	Для каждого ТекЯщик из СписокРассылки Цикл
		Если ТекЯщик.РассылкаПоПоручениям = Истина Тогда
			Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ПрефиксПисьма(ЕстьОшибки, ЕстьПредупреждения) + Тема + ПропискаРассылки("r295");
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла("html");
	ЛогРассылки.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.HTML5);
	Файл = Новый ЧтениеТекста(ПутьКФайлу);
	Текст = Файл.Прочитать();
	Файл.Закрыть();
	УдалитьФайлы(ПутьКФайлу);
	
	ПараметрыПисьма.Тело = Текст;
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
	ПараметрыПисьма.Важность = Важность;
	
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
		текстРассылки = "Рассылка завершена";
	Исключение
		текстРассылки = "Рассылка не удалась: " + ПочтовыйЛогин;
	КонецПопытки;
	
	Возврат текстРассылки;
	
КонецФункции

Процедура ДобавитьТекст(ДобавляемыйТекст)
	
	ОбластьШапка.Параметры.ТекстСообщения = ДобавляемыйТекст;
	ЛогРассылки.Вывести(ОбластьШапка);
	
КонецПроцедуры

Функция ПолучитьСервис(АдресВеб, Логин, Пароль)
	
	Определения = Новый WSОпределения(АдресВеб, Логин, Пароль, , 600);
	URIПространстваИмен = Определения.Сервисы[0].URIПространстваИмен;
	ИмяСервиса = Определения.Сервисы[0].Имя;
	ТочкаПодключения = Определения.Сервисы[0].ТочкиПодключения[1].Имя;
	Прокси = Новый WSПрокси(Определения, URIПространстваИмен, ИмяСервиса, ТочкаПодключения, 600);
	Прокси.Пользователь = Логин;
	Прокси.Пароль = Пароль;

	Возврат Прокси;
	
КонецФункции

Процедура УстановкаПризнакаОтправкиНаБрокерскийСчет() Экспорт

	Сервис = ПолучитьСервис(АдресВебДО, ПользовательДО, ПарольДО);
	
	Для каждого ПлатежноеПоручение Из ПлатежныеПоручения Цикл
		Попытка
		
			Сервис.SetRetailSentToBroker(ПлатежноеПоручение.ДоговорДУ.Код, Истина);
		
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			
			ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				"Произошла ошибка при установке отметки в 1С:ДО  для договора " + ПлатежноеПоручение.ДоговорДУ.Наименование +"! Описание ошибки: " + ТекстОшибки
			);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры


