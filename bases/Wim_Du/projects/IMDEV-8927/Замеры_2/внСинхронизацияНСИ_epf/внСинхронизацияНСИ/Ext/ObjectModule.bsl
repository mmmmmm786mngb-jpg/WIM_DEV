		);
		
		Если текСтрока.ТипДУ = "Розничное" Тогда
			Если ЗначениеЗаполнено(текСтрока.Стратегия) Тогда
				ЗаписатьСтратегию(ДоговорОбъект.Ссылка, текСтрока.Стратегия);
			КонецЕсли;
			текСтрока.ОписаниеОшибки = ЗаполнитьАналитикуПоДоговоруДУ(ДоговорОбъект.Ссылка, текСтрока.ПредставлениеДоговора
