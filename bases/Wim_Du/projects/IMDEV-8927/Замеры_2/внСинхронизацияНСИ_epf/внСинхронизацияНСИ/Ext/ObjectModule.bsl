		КонецЕсли;
	
		
		Если ЗначениеЗаполнено(текСтрока.БанковскийСчет) Тогда
			БанкСчетОбъект = текСтрока.БанковскийСчет.ПолучитьОбъект();
		ИначеЕсли ЗначениеЗаполнено(текСтрока.НомерСчета) Тогда
