			//	текСтрока.ДоговорКонтрагента = НайтиДоговорКонтрагента(текСтрока.ДоговорДУ);
			//КонецЕсли;
			Если текСтрока.КаналПродаж = "Private" Тогда
				текСтрока.ДоговорКонтрагента = НайтиДоговорКонтрагента(текСтрока.ДоговорДУ, "7710353606", "997950001", "1027739609391");
