Процедура СинхронизацияМенеджеров()
		
	Запрос = ВнешБаза.Соединение.NewObject("Запрос");
	Запрос.Текст = "ВЫБРАТЬ
	|	ВнутренниеДокументы.Контрагент КАК КонтрагентДО,
	|	ВнутренниеДокументы.РегистрационныйНомер КАК РегистрационныйНомерДО,
	|	ЕСТЬNULL(ВнутренниеДокументыДополнительныеРеквизиты.Значение, ЗНАЧЕНИЕ(Справочник.МенеджерыУК.ПустаяСсылка)) КАК МенеджерДО
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.ВнутренниеДокументы.ДополнительныеРеквизиты КАК ВнутренниеДокументыДополнительныеРеквизиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВнутренниеДокументы КАК ВнутренниеДокументы
	|		ПО ВнутренниеДокументыДополнительныеРеквизиты.Ссылка = ВнутренниеДокументы.Ссылка
	|ГДЕ
	|	ВнутренниеДокументы.ВидДокумента.Наименование = ""Договор доверительного управления (физ.лицо)""
	|	И ВнутренниеДокументыДополнительныеРеквизиты.Свойство.Заголовок = ""Менеджер ВТБК УА""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Представление(ВТ.КонтрагентДО) КАК КонтрагентДО,
	|	Представление(ВТ.РегистрационныйНомерДО) КАК РегистрационныйНомерДО,
	|	Представление(ВТ.МенеджерДО) КАК  МенеджерДО,
	|	ВТ.МенеджерДО КАК  МенеджерДОСсылка
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.КонтрагентДО В
	|			(ВЫБРАТЬ
	|				ВТ.КонтрагентДО
	|			ИЗ
	|				ВТ КАК ВТ
	|			СГРУППИРОВАТЬ ПО
	|				ВТ.КонтрагентДО
	|			ИМЕЮЩИЕ
	|				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ.МенеджерДО) = 1)";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	РезультатВДО = Новый ТаблицаЗначений;
	РезультатВДО.Колонки.ДОбавить("КонтрагентДО", Новый ОписаниеТипов("Строка"));
	РезультатВДО.Колонки.ДОбавить("РегистрационныйНомерДО", Новый ОписаниеТипов("Строка"));
	РезультатВДО.Колонки.ДОбавить("МенеджерДО", Новый ОписаниеТипов("Строка"));
	РезультатВДО.Колонки.ДОбавить("НовыйМенеджерВДУ", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	
	Для Каждого Стр Из РезультатЗапроса Цикл
		
		Если СокрЛП(Стр.МенеджерДО) = "" Тогда Продолжить; КонецЕсли;
		
		НовыйМенеджерВДУ = НайтиМенеджера(Стр.МенеджерДОСсылка,  СокрЛП(Стр.МенеджерДО));
		
		НоваяСтрока = РезультатВДО.ДОбавить();
		НоваяСтрока.КонтрагентДО =СокрЛП(Стр.КонтрагентДО);
		НоваяСтрока.РегистрационныйНомерДО = СокрЛП(СтрЗаменить(Стр.РегистрационныйНомерДО, "ф-",""));
		НоваяСтрока.МенеджерДО = НовыйМенеджерВДУ.Наименование;
		НоваяСтрока.НовыйМенеджерВДУ = НовыйМенеджерВДУ;
		
	КонецЦикла;	
	
	ЗапросВДУ = Новый Запрос;
	ЗапросВДУ.Текст = 
	"ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(ДоговорДУ.Клиент) КАК КонтрагентДУ,
	|	ДоговорДУ.Префикс КАК РегистрационныйНомерДУ,
	|	ПРЕДСТАВЛЕНИЕ(ДоговорДУ.Клиент.Менеджер) КАК МенеджерДУ,
	|	ДоговорДУ.Клиент
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорДУ";
	РезультатВДУ = ЗапросВДУ.Выполнить().Выгрузить();
	
	
	Для Каждого Стр Из РезультатВДУ Цикл
		Стр.КонтрагентДУ = СокрЛП(Стр.КонтрагентДУ);
		Стр.РегистрационныйНомерДУ = СокрЛП(Стр.РегистрационныйНомерДУ);
		Стр.МенеджерДУ = СокрЛП(Стр.МенеджерДУ);
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РезультатВДО.КонтрагентДО,
	|	РезультатВДО.РегистрационныйНомерДО,
	|	РезультатВДО.МенеджерДО,
	|	РезультатВДО.НовыйМенеджерВДУ
	|ПОМЕСТИТЬ ДО
	|ИЗ
	|	&РезультатВДО КАК РезультатВДО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РезультатВДУ.КонтрагентДУ,
	|	РезультатВДУ.РегистрационныйНомерДУ,
	|	РезультатВДУ.МенеджерДУ,
	|	РезультатВДУ.Клиент
	|ПОМЕСТИТЬ ДУ
	|ИЗ
	|	&РезультатВДУ КАК РезультатВДУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДУ.Клиент КАК Клиент,
	|	ДО.НовыйМенеджерВДУ
	|ИЗ
	|	ДО КАК ДО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДУ КАК ДУ
	|		ПО (ПОДСТРОКА(ДО.КонтрагентДО, 1, 100) = ПОДСТРОКА(ДУ.КонтрагентДУ, 1, 100))
	|			И (ПОДСТРОКА(ДО.РегистрационныйНомерДО, 1, 100) = ПОДСТРОКА(ДУ.РегистрационныйНомерДУ, 1, 100))
	|ГДЕ
	|	ПОДСТРОКА(ДО.МенеджерДО, 1, 100) <> ПОДСТРОКА(ДУ.МенеджерДУ, 1, 100)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДО.НовыйМенеджерВДУ,
	|	ДУ.Клиент
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДО.НовыйМенеджерВДУ) = 1";
	ЗАпрос.УстановитьПараметр("РезультатВДО", РезультатВДО);
	ЗАпрос.УстановитьПараметр("РезультатВДУ", РезультатВДУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.НовыйМенеджерВДУ) Тогда Продолжить; КонецЕсли;
		КонтрагентСсылка = Выборка.Клиент;
		КонтрагентОбъект = КонтрагентСсылка.ПолучитьОбъект();
		КонтрагентОбъект.Менеджер = Выборка.НовыйМенеджерВДУ;
		Попытка
			КонтрагентОбъект.Записать();
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ОписаниеОшибки();
			Сообщение.Сообщить();
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиМенеджера(Ссылка, Наименование)
	
	Менеджер_UID = ПолучитьСтроковыйUUID(Ссылка);
	
	Менеджер_Наименование = СокрЛП(Наименование);
	
	МенеджерУК = НайтиМенеджераУК(Менеджер_UID);
	
	Если НЕ ЗначениеЗаполнено(МенеджерУК) Тогда
		МенеджерУК = СоздатьМенеджераУК(Менеджер_UID, Менеджер_Наименование);
	КонецЕсли;
	
	Возврат МенеджерУК;
	
КонецФункции

