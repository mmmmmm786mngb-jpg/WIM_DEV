Функция НайтиДоговорКонтрагента(Знач ДоговорДУ, ИНН, КПП, ОГРН)
// IMAPPS-26580 --

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СпрДоговорДУ.Ссылка КАК ДоговорДУ,
	|	СпрДоговорДУ.Префикс КАК Префикс,
	|	Контрагенты.Ссылка КАК Контрагент
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.ДоговорДУ КАК СпрДоговорДУ,
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	СпрДоговорДУ.Ссылка = &Ссылка
	// IMAPPS-26580 ++
	//|	И Контрагенты.ИНН = ""7710353606""
	//|	И Контрагенты.КПП = ""997950001""
	//|	И Контрагенты.ОГРН = ""1027739609391""
	|	И Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП
	|	И Контрагенты.ОГРН = &ОГРН
	|	И Контрагенты.Агент
	// IMAPPS-26580 --
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДоговорДУ,
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Префикс,
	|	ВТ.Контрагент,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.Ссылка, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК ДоговорКонтрагента
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ВТ.Контрагент = ДоговорыКонтрагентов.Владелец
	|			И ВТ.ДоговорДУ = ДоговорыКонтрагентов.ДоговорДУ";
	
	Запрос.УстановитьПараметр("Ссылка", ДоговорДУ);
	// IMAPPS-26580 ++
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.УстановитьПараметр("ОГРН", ОГРН);
	// IMAPPS-26580 --
	
	РезультатЗапроса = Запрос.Выполнить();
	
	//Такого не может быть, но пусть будет
	Если РезультатЗапроса.Пустой() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не найден ни договор ДУ ни контрагент для создания договора контрагента по договору ДУ -" + ДоговорДУ;
		Сообщение.Сообщить();
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДоговорКонтрагента) Тогда
		Возврат ВыборкаДетальныеЗаписи.ДоговорКонтрагента;
	КонецЕсли;
	
	НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	НовыйДоговор.РольДоговора = Перечисления.РолиДоговоровКонтрагента.Агентский;
	НовыйДоговор.Владелец = ВыборкаДетальныеЗаписи.Контрагент;
	НовыйДоговор.ДоговорДУ = ДоговорДУ;
	НовыйДоговор.ВалютаВзаиморасчетов = Справочники.Валюты.RUB;
	// IMAPPS-26580 ++
	//НовыйДоговор.Наименование = "Агентский_ВТБ24_" + ВыборкаДетальныеЗаписи.Префикс;
	//НовыйДоговор.НомерДоговора = "1420";
	//НовыйДоговор.ДатаДоговора = Дата(2011, 04, 04); 
	Если ИНН = "7710353606" Тогда 
		НовыйДоговор.Наименование = "Агентский_ВТБ24_" + ВыборкаДетальныеЗаписи.Префикс;
		НовыйДоговор.НомерДоговора = "1420";
		НовыйДоговор.ДатаДоговора = Дата(2011, 04, 04); 
	ИначеЕсли ИНН = "" Тогда 
		НовыйДоговор.Наименование = "Агентский_НРБ_" + ВыборкаДетальныеЗаписи.Префикс;
		НовыйДоговор.НомерДоговора = "б/н";
		НовыйДоговор.ДатаДоговора = Дата(2024, 04, 18); 
	КонецЕсли;
	// IMAPPS-26580 --
	НовыйДоговор.АлгоритмДоговора = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Алгоритм расчета начисления вознаграждения агента");
	Настройки = Новый Структура("ЗаголовокНастроек, Значения");
	НастройкиЗначения = Новый Структура;
	НастройкиЗначения.Вставить("ДатаВвода3года", Ложь);
	НастройкиЗначения.Вставить("ПутьСохраненияОтчета", "");
	//НастройкиЗначения.Вставить("СтавкаНДС", Перечисления.СтавкиНДС.НДС20);
	НастройкиЗначения.Вставить("СтавкаНДС", Перечисления.СтавкиНДС.НДС22);  // IMAPPS-34656
	НастройкиЗначения.Вставить("СуммарноеСЧААгента", Справочники.Контрагенты.ПустаяСсылка());
	НастройкиЗначения.Вставить("ТипВознагражденияАгента", "ЗаУправлениеЗаУспех");
	
	
	ТаблицаВознаграждений = Новый ТаблицаЗначений;
	ТаблицаВознаграждений.Колонки.Добавить("РазмерВознаграждения", Новый ОписаниеТипов("Число"));
	ТаблицаВознаграждений.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаВознаграждений.Колонки.Добавить("ТипСравнения", Новый ОписаниеТипов("Строка"));
	ТаблицаВознаграждений.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число"));
	ТаблицаВознаграждений.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Булево"));
	
	НоваяСтрока =  ТаблицаВознаграждений.Добавить();
	НоваяСтрока.РазмерВознаграждения = 50;
	НоваяСтрока.Валюта = Справочники.Валюты.RUB;
	ХранилищеТаблицаВознаграждений = Новый ХранилищеЗначения(ТаблицаВознаграждений);
	
	НастройкиЗначения.Вставить("ТаблицаВознаграждений", ХранилищеТаблицаВознаграждений);
	
	ТаблицаДоговоровДУ = Новый ТаблицаЗначений;
	ТаблицаДоговоровДУ.Колонки.Добавить("ДоговорДУ", Новый ОписаниеТипов("СправочникСсылка.ДоговорДУ"));
	НоваяСтрока =  ТаблицаДоговоровДУ.Добавить();
	НоваяСтрока.ДоговорДУ = ДоговорДУ;
	ХранилищеТаблицаДоговоровДУ = Новый ХранилищеЗначения(ТаблицаДоговоровДУ);
	
	НастройкиЗначения.Вставить("ТаблицаДоговоровДУ", ХранилищеТаблицаДоговоровДУ);
	
	Настройки.ЗаголовокНастроек = "ТипВознагражденияАгента:"+ НастройкиЗначения.ТипВознагражденияАгента+", Ставка НДС:"+НастройкиЗначения.СтавкаНДС;
	Настройки.Значения = НастройкиЗначения;
	НовыйДоговор.НастройкиАлгоритма = Новый ХранилищеЗначения(Настройки);
	Попытка
		НовыйДоговор.Записать();
		Возврат НовыйДоговор.Ссылка;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при создании договора контрагента: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

Функция НайтиБанк(Знач UID, Знач БИК, Знач СВИФТ)
	Перем Запрос, Выборка;
	Перем ОбъектИнтеграции;
	
	Если ЗначениеЗаполнено(UID) Тогда
		ОбъектИнтеграции = СсылкаНаОбъектПоДаннымДокументооборота(UID, "DMBank");
		Если ЗначениеЗаполнено(ОбъектИнтеграции) Тогда
			Если ОбщегоНазначения.СсылкаСуществует(ОбъектИнтеграции) Тогда
				Возврат ОбъектИнтеграции;
			КонецЕсли;
		КонецЕсли;
		
		ОбъектИнтеграции = Справочники.Банки.ПолучитьСсылку(Новый УникальныйИдентификатор(UID));
		Если ЗначениеЗаполнено(ОбъектИнтеграции) Тогда
			Если ОбщегоНазначения.СсылкаСуществует(ОбъектИнтеграции) Тогда
				Возврат ОбъектИнтеграции;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(БИК) Тогда
		Возврат Справочники.Банки.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("БИК", БИК);
	Запрос.УстановитьПараметр("СВИФТ", СВИФТ);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Банки.Ссылка КАК Банк,
	|	1 КАК Приоритет
	|ПОМЕСТИТЬ втБанки
	|ИЗ
	|	Справочник.Банки КАК Банки
	|ГДЕ
	|	Банки.Код = &БИК
	|	И Банки.СВИФТБИК = &СВИФТ
	|	И НЕ Банки.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Банки.Ссылка,
	|	2
	|ИЗ
	|	Справочник.Банки КАК Банки
	|ГДЕ
	|	Банки.Код = &БИК
	|	И НЕ Банки.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Банки.Ссылка,
	|	3
	|ИЗ
	|	Справочник.Банки КАК Банки
	|ГДЕ
	|	Банки.СВИФТБИК = &СВИФТ
	|	И НЕ Банки.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Банки.Банк КАК Банк
	|ИЗ
	|	втБанки КАК Банки
	|ГДЕ
	|	Банки.Приоритет В
	|			(ВЫБРАТЬ
	|				МИНИМУМ(БанкиВн.Приоритет) КАК Приоритет
	|			ИЗ
	|				втБанки КАК БанкиВн)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Банк;
	КонецЕсли;
	
	Возврат Справочники.Банки.ПустаяСсылка();
КонецФункции // НайтиБанк()

Функция НайтиБанковскийСчет(Знач UID, Знач Банк, Знач НомерСчета, Знач UIDВладельца , Знач ВнешнийКодВладельца = Неопределено)
	Перем ОбъектИнтеграции, Владелец;
	Перем Запрос, Выборка;
	
	// Сначала пытаемся найти по УИДу
	//
	Если ЗначениеЗаполнено(UID) Тогда
		ОбъектИнтеграции = СсылкаНаОбъектПоДаннымДокументооборота(UID, "DMBankAccount");
		Если ЗначениеЗаполнено(ОбъектИнтеграции) Тогда
			Если ОбщегоНазначения.СсылкаСуществует(ОбъектИнтеграции) Тогда
				Возврат ОбъектИнтеграции;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Владелец = НайтиКонтрагента(UIDВладельца, ВнешнийКодВладельца);
	Если НЕ ЗначениеЗаполнено(Владелец) Тогда
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;
	
	Если НЕ ОбщегоНазначения.СсылкаСуществует(Владелец) Тогда
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Банк", Банк);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	БанковскиеСчета.Ссылка КАК БанковскийСчет
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Банк = &Банк
	|	И БанковскиеСчета.Владелец = &Владелец
	|	И БанковскиеСчета.НомерСчета = &НомерСчета
	|	И НЕ БанковскиеСчета.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.БанковскийСчет;
	КонецЕсли;
	
	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
КонецФункции

Функция НайтиКонтрагента(Знач UID, Знач ВнешнийКод = Неопределено)
	Перем ОбъектИнтеграции;
	Перем Запрос, Выборка;
	
	Если ЗначениеЗаполнено(UID) Тогда
		ОбъектИнтеграции = СсылкаНаОбъектПоДаннымДокументооборота(UID, "DMCorrespondent");
		Если ЗначениеЗаполнено(ОбъектИнтеграции) Тогда
			Если ОбщегоНазначения.СсылкаСуществует(ОбъектИнтеграции) Тогда
				Возврат ОбъектИнтеграции;
			КонецЕсли;
		КонецЕсли;
		
		ОбъектИнтеграции = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(UID));
		Если ЗначениеЗаполнено(ОбъектИнтеграции) Тогда
			Если ОбщегоНазначения.СсылкаСуществует(ОбъектИнтеграции) Тогда
				Возврат ОбъектИнтеграции;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВнешнийКод) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ВнешнийКод", ВнешнийКод);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И Контрагенты.ВнешнийКод = &ВнешнийКод
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.Наименование,
	|	Контрагенты.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Контрагент;
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
КонецФункции // НайтиКонтрагента()

