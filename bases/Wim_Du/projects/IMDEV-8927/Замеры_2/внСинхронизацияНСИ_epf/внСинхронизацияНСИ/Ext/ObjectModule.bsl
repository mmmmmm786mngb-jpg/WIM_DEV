Функция ЗаполнитьАналитикуПоДоговоруДУ(ДоговорСсылка, ПредставлениеДоговора, УК, СуммаДоговора, ДатаВводаСредствВДУ)

	ПереводРеквизиты = Новый Структура;
	
	ОписаниеОшибкиВозврат = ЗаполнитьУчетнаяПолитка(ДоговорСсылка, ПредставлениеДоговора);
	
	ОписаниеОшибкиВозврат = ОписаниеОшибкиВозврат + " -> " + ЗаполнитьНастройкиОтчетности(ДоговорСсылка, ПредставлениеДоговора);
	
	ОписаниеОшибкиВозврат = ОписаниеОшибкиВозврат + " -> " + ЗаполнитьНастройкиВознаграждения(ДоговорСсылка, ПредставлениеДоговора);
		
	ОписаниеОшибкиВозврат = ОписаниеОшибкиВозврат + " -> " + ЗаполнитьАналитическиеСчета(ДоговорСсылка, ПереводРеквизиты);
	
	РольДоговора = Перечисления.РолиДоговоровКонтрагента.Прочий;
	НаименованиеДоговра = "Возмещение ДУ " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
	НомерДоговора = "б/н";
	ДоговорКонтрагента(ДоговорСсылка, НаименованиеДоговра, УК, РольДоговора, НомерДоговора);
	
	НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(ДоговорСсылка);
	ДопРеквизитТип = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Тип", Истина);
	НаборЗаписей.Отбор.Свойство.Установить(ДопРеквизитТип);
	Запись = НаборЗаписей.Добавить();
	Запись.Объект = ДоговорСсылка;
	Запись.Свойство = ДопРеквизитТип;
	Запись.Значение = "Розничное ДУ";
	НаборЗаписей.Записать();
	
	ПереводРеквизиты.Вставить("Комментарий", ТорговыйКод + ", субпозиция " + ТорговыйКод + "/" 
					+ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код"));
	
	ТекстОшибки = "";
	ПоручениеПоДС = СоздатьПоручение(ДоговорСсылка, ПереводРеквизиты, СуммаДоговора, ТекстОшибки,  ДатаВводаСредствВДУ);
	
	Если ПоручениеПоДС <> Неопределено Тогда
	
		Если ТекущееВремяРабочее() Тогда
			ПлатежноеПоручение = ПлатежныеПоручения.Добавить();
			ПлатежноеПоручение.ПлатежноеПоручение = СоздатьПлатежноеПоручение(ПоручениеПоДС, ДатаВводаСредствВДУ);
			ПлатежноеПоручение.ПредставлениеДоговора = ПредставлениеДоговора;
			ПлатежноеПоручение.ДоговорДУ = ДоговорСсылка;
			ПлатежноеПоручение.НомерДоговорДУ = ДоговорСсылка.Код;
			ПлатежноеПоручение.СуммаПлатежа = СуммаДоговора;
		
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат ОписаниеОшибкиВозврат;

КонецФункции

Функция ЗаполнитьУчетнаяПолитка(ДоговорСсылка, ПредставлениеДоговора)

	ТекстОшибки = "";
	Если ЗначениеЗаполнено(ОбразецУП) Тогда
		
		ШаблонДокумента = ОбразецУП.ПолучитьОбъект();
		ДокументУП = ШаблонДокумента.Скопировать();
		ДокументУП.ДоговорДУ = ДоговорСсылка;
		ДокументУП.Дата = ДоговорСсылка.ДатаНачала;
		
