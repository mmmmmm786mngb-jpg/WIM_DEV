	Запись.ИдентификаторОбъектаДокументооборота = ID;
	
	НаборЗаписей.Записать();
КонецПроцедуры // ДобавитьСвязь()

Функция УниверсальноеСопоставление(Знач КонтекстСопоставления, Знач КонтекстОбъекта = Неопределено, Знач Идентификатор, Знач ВызыватьИсключение = Ложь)
	Перем Запрос, Выборка;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("КонтекстСопоставления", КонтекстСопоставления);
	Запрос.УстановитьПараметр("КонтекстОбъекта", КонтекстОбъекта);
	Запрос.УстановитьПараметр("ВнешнийОбъект", Идентификатор);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	УниверсальныеСопоставления.НашОбъект КАК ОбъектСопоставления
	|ИЗ
	|	РегистрСведений.УниверсальныеСопоставления КАК УниверсальныеСопоставления
	|ГДЕ
	|	УниверсальныеСопоставления.КонтекстСопоставления = &КонтекстСопоставления
	|	И 1 = 1
	|	И УниверсальныеСопоставления.ВнешнийОбъект = &ВнешнийОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	УниверсальныеСопоставления.КонтекстСопоставления,
	|	УниверсальныеСопоставления.ВнешнийОбъект";
	
	Если КонтекстОбъекта <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "УниверсальныеСопоставления.КонтекстОбъекта = &КонтекстОбъекта");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ОбъектСопоставления
	КонецЕсли;
	
	Если ВызыватьИсключение Тогда
		ВызватьИсключение "Отсутствует Универсальное сопоставление для ключа " + Идентификатор + " (контекст " + КонтекстСопоставления + "). Обратитесь к администратору.";
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции // УниверсальноеСопоставление()

Функция НайтиРодительскуюПапкуКонтрагента()
	Возврат УниверсальноеСопоставление(Перечисления.КонтекстСопоставления.ДоговорДУ,, "РодительскаяПапка_ФизЛицо_для_ДО", Истина);
КонецФункции // НайтиРодительскуюПапкуКонтрагента()

Процедура ИсполнитьЗадачиДО()
	
	УдачныеДоговры = ВнешБаза.Соединение.NewObject("Массив");
	ОшибкиДоговоры = ВнешБаза.Соединение.NewObject("Массив");
	
	ТекстыОшибок = Новый Соответствие;
	
	Для каждого ТекДоговор из Договоры Цикл
		
		ВнешДокумент = ВнутреннийДокументПоUID(ТекДоговор.UID);
		
		Если ТекДоговор.Отказ тогда
			ОшибкиДоговоры.Добавить(ВнешДокумент);
			ТекстыОшибок.Вставить(ВнешДокумент, ТекДоговор.ОписаниеОшибки);
		Иначе
			УдачныеДоговры.Добавить(ВнешДокумент);
		КонецЕсли;
	КонецЦикла;
	
	ЗавершитьЗадачиПоУспешнымДоговорамДУ(УдачныеДоговры);
	
	СоздатьОповещениеАдмина(ОшибкиДоговоры, ТекстыОшибок);
		
КонецПроцедуры

