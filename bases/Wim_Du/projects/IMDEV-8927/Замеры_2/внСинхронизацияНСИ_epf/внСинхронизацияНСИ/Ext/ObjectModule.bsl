Функция СформироватьНаименованиеПортфеля(Знач УК, Знач Префикс)
	Перем РеквизитыУК;
	Перем НаименованиеПортфеля;
	
	РеквизитыУК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УК, "НаименованиеСокращенное, НаименованиеПолное, Наименование");
	
	НаименованиеПортфеля = СокрЛП(РеквизитыУК.НаименованиеСокращенное);
	НаименованиеПортфеля = ?(НЕ ЗначениеЗаполнено(НаименованиеПортфеля), СокрЛП(РеквизитыУК.НаименованиеПолное), НаименованиеПортфеля);
	НаименованиеПортфеля = ?(НЕ ЗначениеЗаполнено(НаименованиеПортфеля), СокрЛП(РеквизитыУК.Наименование), НаименованиеПортфеля);
	НаименованиеПортфеля = НаименованиеПортфеля + " ДУ " + Префикс;
	
	Возврат СокрЛП(НаименованиеПортфеля);
КонецФункции // СформироватьНаименованиеПортфеля()

Функция СформироватьНаименованиеДоговора(Знач ПредставлениеДоговора, Знач Префикс, Знач ПолноеНаименованиеКонтрагента)
	Перем МассивИсходноеФИО;
	Перем НаименованиеДоговора;
	Перем Фамилия, Имя, Отчество;
	
	МассивИсходноеФИО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолноеНаименованиеКонтрагента, " ");
	Если МассивИсходноеФИО.Количество() < 2 Тогда
		Возврат ПредставлениеДоговора;
	КонецЕсли;
	
	Фамилия	 = МассивИсходноеФИО[0];
	Имя		 = МассивИсходноеФИО[1];
	Отчество = ?(МассивИсходноеФИО.Количество() >= 3, МассивИсходноеФИО[2], "");
	
	Если ПустаяСтрока(Отчество) Тогда
		НаименованиеДоговора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ДУ %1 (%2 %3.)", Префикс, Фамилия, Лев(Имя, 1));
	Иначе
		НаименованиеДоговора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ДУ %1 (%2 %3.%4.)", Префикс, Фамилия, Лев(Имя, 1), Лев(Отчество, 1));
	КонецЕсли;
	
	Возврат НаименованиеДоговора;
КонецФункции // СформироватьНаименованиеДоговора()

Функция СсылкаНаОбъектПоДаннымДокументооборота(Знач ID, Знач Тип)
	Возврат РегистрыСведений.ОбъектыИнтегрированныеС1СДокументооборотом.СсылкаНаОбъектПоДаннымДокументооборота(ID, Тип);
