		|ИЗ
		|	Справочник.АналитическиеПризнакиБрокерскогоСчета КАК АналитическиеПризнакиБрокерскогоСчета
		|ГДЕ
		|	АналитическиеПризнакиБрокерскогоСчета.Владелец = &Брокер
		|	И АналитическиеПризнакиБрокерскогоСчета.Наименование = &НомерБанковскогоСчета
		|	И АналитическиеПризнакиБрокерскогоСчета.ДоговорДУ = &ДоговорСсылка";
	
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("ДоговорСсылка", ДоговорСсылка);
	Запрос.УстановитьПараметр("НомерБанковскогоСчета", СчетУБрокера);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		АналитическийПризнакиБрокерскогоСчета = Справочники.АналитическиеПризнакиБрокерскогоСчета.СоздатьЭлемент();
		АналитическийПризнакиБрокерскогоСчета.Владелец = Брокер;
		АналитическийПризнакиБрокерскогоСчета.Наименование = СчетУБрокера;
		АналитическийПризнакиБрокерскогоСчета.ДоговорДУ = ДоговорСсылка;
		АналитическийПризнакиБрокерскогоСчета.Записать();
		Возврат АналитическийПризнакиБрокерскогоСчета.Ссылка;
	КонецЕсли;

КонецФункции

Функция СоздатьАналитическийСчет(ДоговорДУ, ДоговорКонтрагента, МестоХранения, Наименование, Вид, СчетаБрокера = Неопределено)
	
	НовДок = Справочники.АналитическиеСчета.СоздатьЭлемент();
	НовДок.Наименование = Наименование;
	НовДок.ДоговорДУ = ДоговорДУ;
	НовДок.НомерСчета = Наименование;
	НовДок.ВидАналитическогоСчета = Вид;
	НовДок.СубъектМестаХранения = Брокер;
	НовДок.ДоговорКонтрагента = ДоговорКонтрагента;
	НовДок.МестоХранения = МестоХранения;
	
	Если ТипЗнч(МестоХранения) = Тип("СправочникСсылка.БанковскиеСчета") Тогда 
		НовДок.Транзитный = МестоХранения.ТранзитныйСчет;
		Если СчетаБрокера <> Неопределено Тогда 
			НовДок.АналитическийПризнакСчетаБрокера = СчетаБрокера;
			НовДок.ОткрытНаБирже = Истина;
			НовДок.Биржа = Биржа;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(МестоХранения) = Тип("СправочникСсылка.СчетаДепо") Тогда 
		НовДок.Раздел = Справочники.Разделы.Торговый;
	КонецЕсли;
	
	НовДок.Записать();
	
	Возврат НовДок.Ссылка;
	
КонецФункции

Функция СоздатьПлатежноеПоручение(ПоручениеПоДС, ДатаВводаСредствВДУ)

	ПлатежноеПоручение = Документы.ПлатежноеПоручение.ПустаяСсылка();
	
	ПлатежноеПоручениеОбъект = Документы.ПлатежноеПоручение.СоздатьДокумент();
	ПлатежноеПоручениеОбъект.Дата = БлижайшийРабочийДень(ДатаВводаСредствВДУ) + ВремяТекущее();
	ПлатежноеПоручениеОбъект.Заполнить(ПоручениеПоДС);
	
	Попытка
		ПлатежноеПоручениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ПлатежноеПоручение = ПлатежноеПоручениеОбъект.Ссылка;
	Исключение
		Отказ = Истина;
		ТекстОтказа =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось записать платежное поручение по причине ""%1""'"),ОписаниеОшибки());
	КонецПопытки;
		
	Возврат ПлатежноеПоручение;
	
КонецФункции

Функция СоздатьПоручение(ДоговорДУ, Реквизиты, Сумма, ТекстОшибки = "", ДатаВводаСредствВДУ) 
	
	оПоручение = Документы.Поручение.СоздатьДокумент();
	РабочийДень = БлижайшийРабочийДень(ДатаВводаСредствВДУ);
	ВремяТекущее = ?(НачалоДня(РабочийДень) <> НачалоДня(ТекущаяДатаСеанса()), 28800, ВремяТекущее());
	
	оПоручение.Дата = РабочийДень + ВремяТекущее;
	оПоручение.ВидОперации = Перечисления.ВидыОперацийПоручение.Перевод;
	
	оПоручение.ДоговорДУ = ДоговорДУ;
	оПоручение.ДоговорКонтрагента = ДоговорБрокераЕБС(ДоговорДУ);
	оПоручение.АналитическийСчетИсточник = Реквизиты.АналитическийСчетИсточник;
	оПоручение.АналитическийСчетПриемник = Реквизиты.АналитическийСчетПриемник;
	оПоручение.СуммаДС = Сумма;
	оПоручение.ВалютаДокумента = Справочники.Валюты.RUB;
	
	КурсКратность = МодульВалютногоУчета.ПолучитьКурсВалютыПоПортфелю(ДоговорДУ, Справочники.Валюты.RUB, оПоручение.Дата);
	оПоручение.КурсВзаиморасчетов = КурсКратность.Курс;
	оПоручение.КратностьВзаиморасчетов = КурсКратность.Кратность;
	
	оПоручение.СпособПодачиПоручения = Перечисления.СпособыПодачиПоручения.БумажныйНосительОригинал;
	оПоручение.ДокументЗарегистрировал = "Не применимо";
	оПоручение.Ответственный = Пользователи.ТекущийПользователь(); 
	оПоручение.Комментарий = Реквизиты.Комментарий;
	
	Попытка
		
		оПоручение.Записать(РежимЗаписиДокумента.Проведение);
		
		оПоручениеСсылка = оПоручение.Ссылка;
	
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("При записи Поручения по ДС по Договору ДУ %1 произошла ошибка: %2", ДоговорДУ, ТекстОшибки)
			);
			
		ОповещениеОХодеОбмена("Ошибка записи Договора ДУ: '" + ДоговорДУ + "'! Описание ошибки: " + ТекстОшибки, Истина);
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат оПоручениеСсылка;
	
КонецФункции

Функция ДоговорБрокераЕБС(ДоговорДУ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.ДоговорДУ = &ДоговорДУ
		|	И ДоговорыКонтрагентов.РольДоговора = ЗНАЧЕНИЕ(Перечисление.РолиДоговоровКонтрагента.Брокерский)";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();

КонецФункции

Процедура СоздатьНСИ(Знач КЕШ = Неопределено, МенеджерыКлиентов = Неопределено)
	Перем ЭтоНовыйКонтрагент;
	Перем МенеджерУК;
	
	Если КЕШ = Неопределено Тогда
		КЕШ = СоздатьКЕШ();
	КонецЕсли;
	
	Если МенеджерыКлиентов = Неопределено Тогда
		МенеджерыКлиентов = Новый Соответствие();
	КонецЕсли;
	
	СвойствоКонтрагента = ВнешБаза.Соединение.ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Заголовок", ИМЯ_СВОЙСТВА_КОНТРАГЕНТА);
	
	ОповещатьОбОбработке_Контрагенты = Ложь;
	Для каждого текСтрока из ЭтотОбъект.СписокКонтрагентов Цикл
		Если текСтрока.Отказ = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(текСтрока.КонтрагентДУ) Тогда
			Продолжить;  // АХТУНГ
		КонецЕсли;
		
		ЭтоНовыйКонтрагент = Истина;
		Если НЕ ЗначениеЗаполнено(текСтрока.КонтрагентДУ) Тогда
			КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
			КонтрагентОбъект.УстановитьСсылкуНового(Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(текСтрока.UID)));
		Иначе
			ЭтоНовыйКонтрагент = Ложь;
			
			КонтрагентОбъект = текСтрока.КонтрагентДУ.ПолучитьОбъект();
			
			Если КонтрагентОбъект.ПометкаУдаления Тогда
				КонтрагентОбъект.ПометкаУдаления = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(текСтрока.ВнешнийКод) Тогда
			КонтрагентОбъект.ВнешнийКод = текСтрока.ВнешнийКод;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(КонтрагентОбъект, текСтрока,, "ВнешнийКод");
		
		КонтрагентОбъект.КонтактнаяИнформация.Очистить();
		
		Если ЗначениеЗаполнено(текСтрока.ЮридическийАдрес) Тогда
			ЮрАдрес = КонтрагентОбъект.КонтактнаяИнформация.Добавить();
			ЮрАдрес.Тип				 = Перечисления.ТипыКонтактнойИнформации.Адрес;
			ЮрАдрес.Вид				 = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
			ИсхСтруктураПолей		 = УправлениеКонтактнойИнформациейКлиентСервер.СтруктураПолейАдресаИзСпискаПолейКонтактнойИнформации(ВнешБаза.Соединение.УправлениеКонтактнойИнформацией.ПредыдущийФорматКонтактнойИнформацииXML(текСтрока.ЮридическийАдресXML, Истина), "");
			ЮрАдрес.ЗначенияПолей	 = УпаковатьЗначенияПолейКИ(ИсхСтруктураПолей);
			ЮрАдрес.Представление	 = текСтрока.ЮридическийАдрес;
			ЗаполнитьРеквизитыТабличнойЧастиДляАдреса(ЮрАдрес, ИсхСтруктураПолей);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(текСтрока.ФактическийАдрес) Тогда
			ФактАдрес = КонтрагентОбъект.КонтактнаяИнформация.Добавить();
			ФактАдрес.Тип			 = Перечисления.ТипыКонтактнойИнформации.Адрес;
			ФактАдрес.Вид			 = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
			ИсхСтруктураПолей		 = УправлениеКонтактнойИнформациейКлиентСервер.СтруктураПолейАдресаИзСпискаПолейКонтактнойИнформации(ВнешБаза.Соединение.УправлениеКонтактнойИнформацией.ПредыдущийФорматКонтактнойИнформацииXML(текСтрока.ФактическийАдресXML, Истина), "");
			ФактАдрес.ЗначенияПолей	 = УпаковатьЗначенияПолейКИ(ИсхСтруктураПолей);
			ФактАдрес.Представление	 = текСтрока.ФактическийАдрес;
			ЗаполнитьРеквизитыТабличнойЧастиДляАдреса(ФактАдрес, ИсхСтруктураПолей);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(текСтрока.ПочтовыйАдрес) Тогда
			ПочтАдрес = КонтрагентОбъект.КонтактнаяИнформация.Добавить();
			ПочтАдрес.Тип			 = Перечисления.ТипыКонтактнойИнформации.Адрес;
			ПочтАдрес.Вид			 = Справочники.ВидыКонтактнойИнформации.ПочтАдресКонтрагента;
			ИсхСтруктураПолей		 = УправлениеКонтактнойИнформациейКлиентСервер.СтруктураПолейАдресаИзСпискаПолейКонтактнойИнформации(ВнешБаза.Соединение.УправлениеКонтактнойИнформацией.ПредыдущийФорматКонтактнойИнформацииXML(текСтрока.ПочтовыйАдресXML, Истина), "");
			ПочтАдрес.ЗначенияПолей	 = УпаковатьЗначенияПолейКИ(ИсхСтруктураПолей);
			ПочтАдрес.Представление	 = текСтрока.ПочтовыйАдрес;
			ЗаполнитьРеквизитыТабличнойЧастиДляАдреса(ПочтАдрес, ИсхСтруктураПолей);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(текСтрока.Телефон) Тогда
			ЗначенияПолейXML = ВнешБаза.Соединение.УправлениеКонтактнойИнформацией.ПредыдущийФорматКонтактнойИнформацииXML(текСтрока.ТелефонXML);
			
			Телефон = КонтрагентОбъект.КонтактнаяИнформация.Добавить();
			Телефон.Тип				 = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Телефон.Вид				 = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
			Телефон.ЗначенияПолей	 = ЗначенияПолейXML;
			Телефон.НомерТелефона	 = текСтрока.Телефон;
			Телефон.Представление	 = текСтрока.Телефон;
			
			// Если второго тлф нет, то дублируем из другого
			Если НЕ ЗначениеЗаполнено(текСтрока.МобильныйТелефон) Тогда
				Телефон = КонтрагентОбъект.КонтактнаяИнформация.Добавить();
				Телефон.Тип				 = Перечисления.ТипыКонтактнойИнформации.Телефон;
				Телефон.Вид				 = Справочники.ВидыКонтактнойИнформации.СотовыйТелефонКонтрагента;
				Телефон.ЗначенияПолей	 = ЗначенияПолейXML;
				Телефон.НомерТелефона	 = текСтрока.Телефон;
				Телефон.Представление	 = текСтрока.Телефон;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(текСтрока.МобильныйТелефон) Тогда
			ЗначенияПолейXML = ВнешБаза.Соединение.УправлениеКонтактнойИнформацией.ПредыдущийФорматКонтактнойИнформацииXML(текСтрока.МобильныйТелефонXML);
			
			Телефон = КонтрагентОбъект.КонтактнаяИнформация.Добавить();
			Телефон.Тип				 = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Телефон.Вид				 = Справочники.ВидыКонтактнойИнформации.СотовыйТелефонКонтрагента;
			Телефон.ЗначенияПолей	 = ЗначенияПолейXML;
			Телефон.НомерТелефона	 = текСтрока.МобильныйТелефон;
			Телефон.Представление	 = текСтрока.МобильныйТелефон;
			
			// Если второго тлф нет, то дублируем из другого
			Если НЕ ЗначениеЗаполнено(текСтрока.Телефон) Тогда
				Телефон = КонтрагентОбъект.КонтактнаяИнформация.Добавить();
				Телефон.Тип				 = Перечисления.ТипыКонтактнойИнформации.Телефон;
				Телефон.Вид				 = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
				Телефон.ЗначенияПолей	 = ЗначенияПолейXML;
				Телефон.НомерТелефона	 = текСтрока.МобильныйТелефон;
				Телефон.Представление	 = текСтрока.МобильныйТелефон;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(текСтрока.email) Тогда
			email = КонтрагентОбъект.КонтактнаяИнформация.Добавить();
			email.Тип			 = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			email.Вид			 = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
			email.Представление	 = текСтрока.email;
			email.АдресЭП		 = текСтрока.email;
		КонецЕсли;
		
		КонтрагентОбъект.КлиентДУ	 = Истина;
		КонтрагентОбъект.НеРезидент	 = НЕ ЭтоГражданинРФ(текСтрока.UIDФизика);
		
		// Место рождения
		ДополнительныйРеквизит_МестоРождения = НайтиДополнительныйРеквизитКонтрагента("Место рождения", Справочники.НаборыДополнительныхРеквизитовИСведений.Справочник_Контрагенты_ФизЛица);
		Если ЗначениеЗаполнено(ДополнительныйРеквизит_МестоРождения) Тогда
			Строки_МестоРождения = КонтрагентОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ДополнительныйРеквизит_МестоРождения));
			
			Если Строки_МестоРождения.Количество() > 0 Тогда
				Для Каждого ТекСтрокаДР Из Строки_МестоРождения Цикл
					ТекСтрокаДР.Значение = текСтрока.МестоРождения;
				КонецЦикла;
			Иначе
				ТекСтрокаДР = КонтрагентОбъект.ДополнительныеРеквизиты.Добавить();
				ТекСтрокаДР.Свойство = ДополнительныйРеквизит_МестоРождения;
				ТекСтрокаДР.Значение = текСтрока.МестоРождения;
			КонецЕсли;
		КонецЕсли;
		
		// Страна рождения
		ДополнительныйРеквизит_СтранаРождения = НайтиДополнительныйРеквизитКонтрагента("Страна рождения", Справочники.НаборыДополнительныхРеквизитовИСведений.Справочник_Контрагенты_ФизЛица);
		Если ЗначениеЗаполнено(ДополнительныйРеквизит_СтранаРождения) Тогда
			Строки_СтранаРождения = КонтрагентОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ДополнительныйРеквизит_СтранаРождения));
			
			Если Строки_СтранаРождения.Количество() > 0 Тогда
				Для Каждого ТекСтрокаДР Из Строки_СтранаРождения Цикл
					ТекСтрокаДР.Значение = Справочники.СтраныМира.НайтиПоНаименованию(текСтрока.СтранаРождения);
				КонецЦикла;
			Иначе
				ТекСтрокаДР = КонтрагентОбъект.ДополнительныеРеквизиты.Добавить();
				ТекСтрокаДР.Свойство = ДополнительныйРеквизит_СтранаРождения;
				ТекСтрокаДР.Значение = Справочники.СтраныМира.НайтиПоНаименованию(текСтрока.СтранаРождения);
			КонецЕсли;
		КонецЕсли;
		
		// АнглийскоеНаименование
		ДополнительныйРеквизит_НаименованиеАнгл = НайтиДополнительныйРеквизитКонтрагента("АнглийскоеНаименование", Справочники.НаборыДополнительныхРеквизитовИСведений.Справочник_Контрагенты_Общие);
		Если ЗначениеЗаполнено(ДополнительныйРеквизит_НаименованиеАнгл) Тогда
			Строки_НаименованиеАнгл = КонтрагентОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ДополнительныйРеквизит_НаименованиеАнгл));
			
			Если Строки_НаименованиеАнгл.Количество() > 0 Тогда
				Для Каждого ТекСтрокаДР Из Строки_НаименованиеАнгл Цикл
					ТекСтрокаДР.Значение = текСтрока.НаименованиеАнгл;
				КонецЦикла;
			Иначе
				ТекСтрокаДР = КонтрагентОбъект.ДополнительныеРеквизиты.Добавить();
				ТекСтрокаДР.Свойство = ДополнительныйРеквизит_НаименованиеАнгл;
				ТекСтрокаДР.Значение = текСтрока.НаименованиеАнгл;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоНовыйКонтрагент ИЛИ НЕ ЗначениеЗаполнено(КонтрагентОбъект.КодСектораЭкономики) Тогда
			КонтрагентОбъект.КодСектораЭкономики = ?(КонтрагентОбъект.НеРезидент, "OTH", "S14");
		КонецЕсли;
		
		Если КонтрагентОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо И НЕ ЗначениеЗаполнено(КонтрагентОбъект.ИНН) Тогда
			КонтрагентОбъект.ИНН = "000000000000";
		КонецЕсли;
		
		Если КонтрагентОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			КонтрагентОбъект.Родитель = НайтиРодительскуюПапкуКонтрагента();
		КонецЕсли;
		
		Попытка
			КонтрагентОбъект.Записать();
			
			текСтрока.КонтрагентДУ = КонтрагентОбъект.Ссылка;
			
			ОповещатьОбОбработке_Контрагенты = Истина;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			
			ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				"При записи контрагента произошла ошибка: " + ТекстОшибки
			);
			
			ОповещениеОХодеОбмена("Ошибка записи контрагента: " + КонтрагентОбъект.Ссылка + " " + ТекстОшибки, Истина);
			
			текСтрока.ОписаниеОшибки = ТекстОшибки;
			текСтрока.Отказ = Истина;
			
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
		
		ДобавитьСвязь(текСтрока.UID, "DMCorrespondent", КонтрагентОбъект.Ссылка);
		
		// Установка допсвойства в ДО
		ДополнительныйРеквизитДО_ДатаСинхронизации	 = НайтиДополнительныйРеквизитКонтрагентаДО(ИМЯ_СВОЙСТВА_КОНТРАГЕНТА, ВнешБаза.Соединение.Справочники.НаборыДополнительныхРеквизитовИСведений.Справочник_Контрагенты_Общие, ВнешБаза);
		ДополнительныйРеквизитДО_КДУ_ИД				 = НайтиДополнительныйРеквизитКонтрагентаДО("КДУ_ИД", ВнешБаза.Соединение.Справочники.НаборыДополнительныхРеквизитовИСведений.Справочник_Контрагенты_Общие, ВнешБаза);
		
		Если ВнешБаза.Соединение.ЗначениеЗаполнено(ДополнительныйРеквизитДО_ДатаСинхронизации) ИЛИ ВнешБаза.Соединение.ЗначениеЗаполнено(ДополнительныйРеквизитДО_КДУ_ИД) Тогда
			ВнешКонтр	 = ВнешнийКонтрагентПоUID(текСтрока.UID);
			
			ВнешОбъект	 = ВнешКонтр.ПолучитьОбъект();
			ДопРеквезиты = ВнешОбъект.ДополнительныеРеквизиты;
			
			НужноЗаписать = Ложь;
			
			Если ВнешБаза.Соединение.ЗначениеЗаполнено(ДополнительныйРеквизитДО_ДатаСинхронизации) Тогда
				Отбор = ВнешБаза.Соединение.NewObject("Структура");
				Отбор.Вставить("Свойство", ДополнительныйРеквизитДО_ДатаСинхронизации);
				
				ДопСтроки = ДопРеквезиты.НайтиСтроки(Отбор);
				Если ДопСтроки.Количество() = 0 Тогда
					ДопСтрока = ДопРеквезиты.Add();
				Иначе
					Для Каждого ТекДопСтроки Из ДопСтроки Цикл
						ДопСтрока = ТекДопСтроки;
						Прервать;
					КонецЦикла;
				КонецЕсли;
				
				ДопСтрока.Свойство = ДополнительныйРеквизитДО_ДатаСинхронизации;
				ДопСтрока.Значение = ДопСтрока.Свойство.ТипЗначения.ПривестиЗначение(ТекущаяДата());
				
				НужноЗаписать = Истина;
			КонецЕсли;
			
			Если ВнешБаза.Соединение.ЗначениеЗаполнено(ДополнительныйРеквизитДО_КДУ_ИД) Тогда
				Отбор = ВнешБаза.Соединение.NewObject("Структура");
				Отбор.Вставить("Свойство", ДополнительныйРеквизитДО_КДУ_ИД);
				
				ДопСтроки = ДопРеквезиты.НайтиСтроки(Отбор);
				Если ДопСтроки.Количество() = 0 Тогда
					ДопСтрока = ДопРеквезиты.Add();
				Иначе
					Для Каждого ТекДопСтроки Из ДопСтроки Цикл
						ДопСтрока = ТекДопСтроки;
						Прервать;
					КонецЦикла;
				КонецЕсли;
				
				ДопСтрока.Свойство = ДополнительныйРеквизитДО_КДУ_ИД;
				ДопСтрока.Значение = ДопСтрока.Свойство.ТипЗначения.ПривестиЗначение(КонтрагентОбъект.ВнешнийIDДляЛК);
				
				НужноЗаписать = Истина;
			КонецЕсли;
			
			Если НужноЗаписать Тогда
				Попытка
					ВнешОбъект.Записать();
				Исключение
					ТекстОшибки = ОписаниеОшибки();
				
					ЗаписьЖурналаРегистрации(
						"Дополнительные отчеты и обработки." + Метаданные().Представление(),
						УровеньЖурналаРегистрации.Ошибка,,,
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("При записи контрагента %1 в 1С:ДО произошла ошибка: %2", текСтрока.Наименование, ТекстОшибки)
					);
					
					ОповещениеОХодеОбмена("Не удалось обновить дату синхронизации у контрагента ДО: " + текСтрока.Наименование + " " + ТекстОшибки, Истина);
				
					ВызватьИсключение ТекстОшибки;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		// ЗаполнениеДокументов
		Если текСтрока.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			НаборЗаписей = РегистрыСведений.ДокументыФизическихЛиц.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ФизЛицо.Установить(КонтрагентОбъект.Ссылка);
			НаборЗаписей.Записать();
			
			СтрокиДокументов = ЭтотОбъект.ДокументыФизиков.НайтиСтроки(Новый Структура("UIDФизика", текСтрока.UIDФизика));
			Для каждого текДокумент Из СтрокиДокументов Цикл
				Если текДокумент.ВидДокумента.Пустая() тогда
					текДокумент.Отказ = Истина;
					текДокумент.ОписаниеОшибки = "Не найден вид документа: " + текДокумент.ВидДокумента;
				КонецЕсли;
				
				НоваяЗапись = РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
				НоваяЗапись.Физлицо 		= КонтрагентОбъект.Ссылка;
				НоваяЗапись.ВидДокумента 	= текДокумент.ВидДокумента;
				НоваяЗапись.Гражданство 	= ?(текДокумент.ГражданинРФ, Справочники.СтраныМира.Россия, Справочники.СтраныМира.ПустаяСсылка());
				ЗаполнитьЗначенияСвойств(НоваяЗапись, текДокумент);
				
				Попытка
					НоваяЗапись.Записать();
				Исключение
					текДокумент.Отказ = Истина;
					текДокумент.ОписаниеОшибки = ОписаниеОшибки();
					
					ВызватьИсключение текДокумент.ОписаниеОшибки;
				КонецПопытки;
			КонецЦикла;
			
			// ФИО физ.лица
			СтруктураФИО = РаспаковатьФИО(текСтрока.ДополнительноФИО);
			Если СтруктураФИО <> Неопределено Тогда
				МЗ = РегистрыСведений.ФИОФизЛиц.СоздатьМенеджерЗаписи();
				МЗ.ФизЛицо		 = КонтрагентОбъект.Ссылка;
				МЗ.Период		 = СтруктураФИО.Период;
				МЗ.Фамилия		 = СтруктураФИО.Фамилия;
				МЗ.Имя			 = СтруктураФИО.Имя;
				МЗ.Отчество		 = СтруктураФИО.Отчество;
				МЗ.ФамилияРод	 = СтруктураФИО.ФамилияРодПад;
				МЗ.ИмяРод		 = СтруктураФИО.ИмяРодПад;
				МЗ.ОтчествоРод	 = СтруктураФИО.ОтчествоРодПад;
				МЗ.Записать(Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ОповещатьОбОбработке_Контрагенты Тогда
		ОповещениеОХодеОбмена("" + ТекущаяДата() + " Обработка контрагентов завершена");
	КонецЕсли;
	
	// Договоры ДУ, сообщение DMInternalDocument
	//
	КЕШировать(КЕШ, "Сопоставления", "ВидУслуги_ДоверительноеУправление", УниверсальноеСопоставление(Перечисления.КонтекстСопоставления.ДоговорДУ,, "ВидУслуги_ДоверительноеУправление", Истина));
	
	КЕШировать(КЕШ, "Reporting", "ПВХ_Reporting_MISReporting", УниверсальноеСопоставление(Перечисления.КонтекстСопоставления.ДоговорДУ,, "ПВХ_Reporting_MISReporting", Истина));
	КЕШировать(КЕШ, "Reporting", "ПВХ_Reporting_CostCentr", УниверсальноеСопоставление(Перечисления.КонтекстСопоставления.ДоговорДУ,, "ПВХ_Reporting_CostCentr", Истина));
	КЕШировать(КЕШ, "Reporting", "ПВХ_ОтчетностьЧерезЛК", УниверсальноеСопоставление(Перечисления.КонтекстСопоставления.ДоговорДУ,, "ПВХ_ОтчетностьЧерезЛК", Истина));
	КЕШировать(КЕШ, "Reporting", "ПВХ_СуммаДоговора", УниверсальноеСопоставление(Перечисления.КонтекстСопоставления.ДоговорДУ,, "ПВХ_ОтчетностьЧерезЛК", Истина));
	
	ОповещатьОбОбработке_ДоговорыДУ = Ложь;
	Для Каждого текСтрока из ЭтотОбъект.Договоры Цикл
		Если ЗначениеЗаполнено(текСтрока.ДоговорДУ) Тогда  // АХТУНГ: не перетираем!
			Продолжить;
		КонецЕсли;
		
		Клиент = НайтиКонтрагента(текСтрока.UIDКонтрагента, текСтрока.ВнешнийКодКонтрагента);
		Если НЕ ЗначениеЗаполнено(Клиент) Тогда
			ВызватьИсключение "Не удалось найти контрагента '" + текСтрока.ПолноеНаименованиеКонтрагента + "' (уид: " + текСтрока.UIDКонтрагента + "; внешний код: " + текСтрока.ВнешнийКодКонтрагента + ")";
		КонецЕсли;
		
		УправляющаяКомпания = ПолучитьИзКЕШа(КЕШ, "Организации", "УК_для_ДО: " + текСтрока.UIDОрганизации);
		Если УправляющаяКомпания = Неопределено Тогда
			УправляющаяКомпания = УниверсальноеСопоставление(Перечисления.КонтекстСопоставления.ДоговорДУ,, "УК_для_ДО: " + текСтрока.UIDОрганизации, Истина);
			
			КЕШировать(КЕШ, "Организации", "УК_для_ДО: " + текСтрока.UIDОрганизации, УправляющаяКомпания);
		КонецЕсли;
		
		МассивРегНомера = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(текСтрока.РегистрационныйНомер, "-");
		Если МассивРегНомера.Количество() > 1 Тогда
			Префикс = СокрЛП(МассивРегНомера[1]);
		Иначе
			Префикс = СокрЛП(текСтрока.РегистрационныйНомер);
		КонецЕсли;
		
		ЭтоНовыйДоговор = Истина;
		Если НЕ ЗначениеЗаполнено(текСтрока.ДоговорДУ) Тогда
			ДоговорОбъект = Справочники.ДоговорДУ.СоздатьЭлемент();
			ДоговорОбъект.УстановитьСсылкуНового(Справочники.ДоговорДУ.ПолучитьСсылку(Новый УникальныйИдентификатор(текСтрока.UID)));
		Иначе
			ДоговорОбъект = текСтрока.ДоговорДУ.ПолучитьОбъект();
			
			Если ДоговорОбъект.ПометкаУдаления Тогда
				ДоговорОбъект.ПометкаУдаления = Ложь;
			КонецЕсли;
			
			ЭтоНовыйДоговор = Ложь;
		КонецЕсли;
		
		ДоговорОбъект.Наименование				 = СформироватьНаименованиеДоговора(текСтрока.ПредставлениеДоговора, Префикс, СокрЛП(текСтрока.ПолноеНаименованиеКонтрагента));
		ДоговорОбъект.Код						 = текСтрока.РегистрационныйНомер;
		ДоговорОбъект.Валюта					 = текСтрока.ВалютаПортфеля;
		ДоговорОбъект.Блокировка				 = Перечисления.ВидыБлокировокДоговораДУ.ПустаяСсылка();
		
		ДоговорОбъект.ТипИИС = текСтрока.ТипИИС;
		Если текСтрока.ТипИИС = Перечисления.ТипыИИС.Нет Тогда
			ДоговорОбъект.ВидУслугПоДоговору = ПолучитьИзКЕШа(КЕШ, "Сопоставления", "ВидУслуги_ДоверительноеУправление");
		Иначе
			ДоговорОбъект.ВидУслугПоДоговору = Справочники.ВидыУслугПоДоговоруДУ.ДоверительноеУправлениеИИС;
			Если текСтрока.ДатаВводаСредствВДУ <> Дата(1, 1, 1) И текСтрока.ДатаВводаСредствВДУ <> Дата(1900, 1, 1) Тогда
				ДоговорОбъект.СрокИИС = СрокИИС(текСтрока.ДатаВводаСредствВДУ);
			КонецЕсли
		КонецЕсли;
		
		ДоговорОбъект.ВнешнийКод				 = "";
		ДоговорОбъект.ДатаНачала				 = текСтрока.ДатаРегистрации;
		
		Если ЭтоНовыйДоговор И текСтрока.ТипДУ <> "Розничное" Тогда
			ДоговорОбъект.ДатаОкончания = ДоговорОбъект.ДатаНачала;  // для новых Договоров ДУ ДатаОкончания должна ровнятся ДатаНачала!
		КонецЕсли;
		
		ДоговорОбъект.ИнформационнаяПлощадка	 = Справочники.ИнформационныеПлощадки.ЦБРФ;
		ДоговорОбъект.Клиент					 = Клиент;
		ДоговорОбъект.Комментарий				 = "";
		ДоговорОбъект.ПолноеНаименование		 = "ДУ " + СокрЛП(Префикс) + " (" + СокрЛП(текСтрока.ПолноеНаименованиеКонтрагента) + ")";
		ДоговорОбъект.Портфель					 = СформироватьНаименованиеПортфеля(УправляющаяКомпания, Префикс);
		ДоговорОбъект.Префикс					 = Префикс;
		ДоговорОбъект.Пул						 = текСтрока.Пул;
		ДоговорОбъект.ТипКлиентаДУ				 = Перечисления.ТипыКлиентовДУ.ФизическиеЛица;  // АХТУНГ: будут еще юрики, которых тоже нужно будет делить на..!
		ДоговорОбъект.УправляющаяКомпания		 = УправляющаяКомпания;
		ДоговорОбъект.СрокДействия = текСтрока.СрокДействия;
		
		Если текСтрока.ТипДУ = "Розничное" Тогда
			Если текСтрока.ДатаВводаСредствВДУ = Дата(1, 1, 1) Или текСтрока.ДатаВводаСредствВДУ = Дата(1900, 1, 1) Тогда
				Продолжить;
			КонецЕсли;
			ДоговорОбъект.ДатаВводаСредствВДУ = текСтрока.ДатаВводаСредствВДУ;
			ДоговорОбъект.ДатаОкончания = Дата(1, 1, 1);
			ДоговорОбъект.УчетДСНаЕдиномРС = Перечисления.УчетДСНаЕдиномРС.Разрешен;
		Иначе
