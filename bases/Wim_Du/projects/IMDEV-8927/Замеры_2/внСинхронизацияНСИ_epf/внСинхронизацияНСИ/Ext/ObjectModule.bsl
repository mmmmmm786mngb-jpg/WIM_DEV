Функция ПреобразоватьНомерТелефона(Знач Телефон, Знач ТелефонXML)
	
	СтруктураОтвета = Новый Структура("КодСтраны, КодГорода, НомерТелефона, Представление, XML","","","","","");
	ТелефонИзн = Телефон;
	Телефон = СтрЗаменить(Телефон, "(", "");
	Телефон = СтрЗаменить(Телефон, ")", "");
	Телефон = СтрЗаменить(Телефон, "-", "");
	Телефон = СтрЗаменить(Телефон, " ", "");
	Телефон = СтрЗаменить(Телефон, Символы.НПП, "");
	Телефон = СтрЗаменить(Телефон, "+", "");
	Телефон = СтрЗаменить(Телефон, ".", "");
	
	Если СтрДлина(Телефон) = 11 И (Лев(Телефон, 2) = "74" ИЛИ Лев(Телефон, 2) = "79" ИЛИ Лев(Телефон, 1) = "8") Тогда	
		СтруктураОтвета.КодСтраны = "7";
		СтруктураОтвета.КодГорода = Сред(Телефон,2,3);
		СтруктураОтвета.НомерТелефона = Сред(Телефон,5,3) + " " + Сред(Телефон,8,2) + " " + Сред(Телефон,10,2);
		СтруктураОтвета.Представление = "+7 (" +Сред(Телефон,2,3) + ") " + Сред(Телефон,5,3) + " " + Сред(Телефон,8,2) + " " + Сред(Телефон,10,2);
		СтруктураОтвета.XML = ПреобразоватьНомерТелефонаXML(СтруктураОтвета);
	ИначеЕсли СтрДлина(Телефон) = 10 И (Лев(Телефон, 1) = "9" ИЛИ Лев(Телефон, 2) = "49") Тогда
		
		СтруктураОтвета.КодСтраны = "7";
		СтруктураОтвета.КодГорода = Сред(Телефон,1,3);
		СтруктураОтвета.НомерТелефона = Сред(Телефон,4,3) + " " + Сред(Телефон,7,2) + " " + Сред(Телефон,9,2);
		СтруктураОтвета.Представление = "+7 (" +Сред(Телефон,1,3) + ") " + Сред(Телефон,4,3) + " " + Сред(Телефон,7,2) + " " + Сред(Телефон,9,2);
		СтруктураОтвета.XML = ПреобразоватьНомерТелефонаXML(СтруктураОтвета);
	Иначе
		
		Если СтрНайти(ТелефонXML, "КодСтраны=""") <> 0 Тогда
			
			НачалоКодСтраны = СтрНайти(ТелефонXML, "КодСтраны=""");
			НачалоКодГорода = СтрНайти(ТелефонXML, "КодГорода=""");
			НачалоНомер = СтрНайти(ТелефонXML, "Номер=""");
			КодСтраны = Сред(ТелефонXML, НачалоКодСтраны+12, НачалоКодГорода-НачалоКодСтраны-14);
			КодГорода = Сред(ТелефонXML, НачалоКодГорода+11, НачалоНомер-НачалоКодГорода-13);
			НомерТелефона = Сред(ТелефонXML, НачалоНомер+7, СтрНайти(ТелефонXML, "Добавочный")-НачалоНомер-9);
			
			СтруктураОтвета.КодСтраны = КодСтраны;
			СтруктураОтвета.КодГорода = КодГорода;
			СтруктураОтвета.НомерТелефона = НомерТелефона;
			СтруктураОтвета.Представление = "+"+КодСтраны + " (" + КодГорода+") " + ПроставитьПробелыВНомере(НомерТелефона);
			СтруктураОтвета.XML = ПреобразоватьНомерТелефонаXML(СтруктураОтвета);
		Иначе
			СтруктураОтвета.Представление = ТелефонИзн;
			СтруктураОтвета.XML = ТелефонXML;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураОтвета;

КонецФункции

Функция ПреобразоватьНомерТелефонаXML(СтруктураТелефона)
	
	Возврат  "<КонтактнаяИнформация xmlns=""http://www.v8.1c.ru/ssl/contactinfo"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" Представление="""+СтруктураТелефона.Представление+"""><Комментарий/><Состав xsi:type=""НомерТелефона"" КодСтраны="""+ СтруктураТелефона.КодСтраны+""" КодГорода="""+СтруктураТелефона.КодГорода+""" Номер=""" + СтруктураТелефона.НомерТелефона + """ Добавочный=""""/></КонтактнаяИнформация>";
	
КонецФункции

Функция ПроставитьПробелыВНомере(Номер)
	
	Если СтрДлина(Номер) < 4 Тогда
		Возврат Номер;
	ИначеЕсли СтрДлина(Номер) = 4 Тогда
		Возврат Лев(Номер,2) +" " + Сред(Номер, 3);
	Иначе
		Возврат Лев(Номер,3) + " " + ПроставитьПробелыВНомере(Сред(Номер, 4)); 
	КонецЕсли;
	
КонецФункции

