		НоваяСтрока.ЮрФизЛицо	 = ?(ВыборкаКонтрагентов.ЭтоФизик, Перечисления.ЮрФизЛицо.ФизЛицо, Перечисления.ЮрФизЛицо.ЮрЛицо);
		
		Если НоваяСтрока.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			НоваяСтрока.UIDФизика	 = ПолучитьСтроковыйUUID(ВыборкаКонтрагентов.Физлицо);
			НоваяСтрока.Пол			 = ?(ВыборкаКонтрагентов.ПолМужской, Перечисления.ПолФизическогоЛица.Мужской, Перечисления.ПолФизическогоЛица.Женский);
		КонецЕсли;
		
		Если НоваяСтрока.Отказ = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		// Поиск контрагента по UID затем по внешнему коду
		НоваяСтрока.КонтрагентДУ = НайтиКонтрагента(НоваяСтрока.UID, НоваяСтрока.ВнешнийКод);
		
		ВнешОтборФЛ.Insert("ФизическоеЛицо", ВыборкаКонтрагентов.Физлицо);
		
		НоваяСтрока.ДополнительноФИО = jsonУпаковатьФИО(ДополнительноФИО, ВнешОтборФЛ);
	КонецЦикла;
	
	// Выборка уд.документов физ.лиц
	//
	ВыборкаДокументов = Пакет.Get(2).Select();
	Пока ВыборкаДокументов.Next() Цикл
		НоваяСтрока = ЭтотОбъект.ДокументыФизиков.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДокументов);
		
		НоваяСтрока.UIDФизика = ПолучитьСтроковыйUUID(ВыборкаДокументов.ФизЛицо);
		
		Если ВыборкаДокументов.Предопределенный Тогда
			НоваяСтрока.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц[ВыборкаДокументов.ИмяПредопределенногоДокумента];
		Иначе
			НоваяСтрока.ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.НайтиПоНаименованию(ВыборкаДокументов.ВидДокументаНаименование);
		КонецЕсли;
		
		НоваяСтрока.ВидДокументаДО = ВыборкаДокументов.ВидДокументаНаименование;
	КонецЦикла;
	
	// Выборка Договоров ДУ
	//
	ВыборкаДоговоров = Пакет.Get(3).Select();
	Пока ВыборкаДоговоров.Next() Цикл
		
		Если СтрНайти(ВыборкаДоговоров.ТипДУ, "Розничное") > 0 Тогда
			Если ВыборкаДоговоров.ДатаВводаСредствВДУ = Дата(1, 1, 1) Или ВыборкаДоговоров.ДатаВводаСредствВДУ = Дата(1900, 1, 1) Или ВыборкаДоговоров.СуммаДоговора = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока = ЭтотОбъект.Договоры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДоговоров);
		
		ВалютаПортфеля = Справочники.Валюты.RUB;
		НоваяСтрока.ВалютаПортфеля = ВалютаПортфеля;  // Всегда RUB!!!
		
		НоваяСтрока.UID						 = ПолучитьСтроковыйUUID(ВыборкаДоговоров.ДоговорДУ);
		НоваяСтрока.UIDКонтрагента			 = ПолучитьСтроковыйUUID(ВыборкаДоговоров.Контрагент);
		НоваяСтрока.UIDОрганизации			 = ПолучитьСтроковыйUUID(ВыборкаДоговоров.Организация);
		НоваяСтрока.UIDМенеджераУК			 = ПолучитьСтроковыйUUID(ВыборкаДоговоров.МенеджерУК);
		НоваяСтрока.UIDИнвестпрофиля		 = ПолучитьСтроковыйUUID(ВыборкаДоговоров.Инвестпрофиль);
		
		НоваяСтрока.ВнешнийКодКонтрагента	 = СокрЛП(НРег(ВнешБаза.Соединение.String(ВыборкаДоговоров.ВнешнийКод)));
		НоваяСтрока.ПредставлениеКонтрагента = СокрЛП(ВнешБаза.Соединение.String(ВыборкаДоговоров.Контрагент));
		НоваяСтрока.ПредставлениеОрганизации = СокрЛП(ВнешБаза.Соединение.String(ВыборкаДоговоров.Организация));
		НоваяСтрока.ПредставлениеМенеджераУК = СокрЛП(ВнешБаза.Соединение.String(ВыборкаДоговоров.МенеджерУК));
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ПредставлениеДоговора) Тогда
			НоваяСтрока.ПредставлениеДоговора = СокрЛП(ВыборкаДоговоров.НаименованиеДоговора);
		КонецЕсли;
		
		НоваяСтрока.ДоговорДУ = НайтиДоговорДУ(НоваяСтрока.UID, НоваяСтрока.РегистрационныйНомер, НоваяСтрока.UIDКонтрагента, НоваяСтрока.ВнешнийКодКонтрагента);
		
		Если ВыборкаДоговоров.ТипИИС = "" Или ВыборкаДоговоров.ТипИИС = "НЕТ" Тогда
			НоваяСтрока.ТипИИС = Перечисления.ТипыИИС.Нет;
		ИначеЕсли ВыборкаДоговоров.ТипИИС = "ИИС1" Тогда
			НоваяСтрока.ТипИИС = Перечисления.ТипыИИС.ИИС1;
		ИначеЕсли  ВыборкаДоговоров.ТипИИС = "ИИС2" Тогда
			НоваяСтрока.ТипИИС = Перечисления.ТипыИИС.ИИС2;
		ИначеЕсли ВыборкаДоговоров.ТипИИС = "ИИС3" Тогда
			НоваяСтрока.ТипИИС = Перечисления.ТипыИИС.ИИС3;
		ИначеЕсли ВыборкаДоговоров.ТипИИС = "Иное" Тогда
			НоваяСтрока.ТипИИС = Перечисления.ТипыИИС.Иное;
		КонецЕсли;
		
		Если ВыборкаДоговоров.СтратегияУправленияСсылка <> "" Тогда
			НоваяСтрока.Стратегия = ПолучитьСтроковыйUUID(ВыборкаДоговоров.СтратегияУправленияСсылка);
		Иначе
			ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("При чтении из ДО не была получена стратегия управления по договору ДУ %1 ", НоваяСтрока.ДоговорДУ)
			);
		КонецЕсли;
		
		НоваяСтрока.КаналПродаж = СокрЛП(ВнешБаза.Соединение.String(ВыборкаДоговоров.КаналПродаж)); 
		
		Если СтрНайти(ВыборкаДоговоров.СтратегияУправления, "Защитная") > 0
			И ВыборкаДоговоров.СрокДействия <> 5
			И ВыборкаДоговоров.ПорядокПродленияНеПродлевается = Истина Тогда
				НоваяСтрока.Пул = ПулСохранностьКапитала;
		ИначеЕсли СтрНайти(ВыборкаДоговоров.ТипДУ, "Розничное") > 0 Тогда
			НоваяСтрока.Пул = ПулРозничноеДУ;
		КонецЕсли;
	КонецЦикла;
	
	// Выборка Банковских счетов
	//
	МаппингВидовСчетов = Новый Соответствие();
	МаппингВидовСчетов.Вставить(НРег("Расчетный"), Перечисления.ВидБанковскогоСчета.Расчетный);
	МаппингВидовСчетов.Вставить(НРег("Current"), Перечисления.ВидБанковскогоСчета.Расчетный);
	МаппингВидовСчетов.Вставить(НРег("Депозитный"), Перечисления.ВидБанковскогоСчета.Депозитный);
	МаппингВидовСчетов.Вставить(НРег("Escrow"), Перечисления.ВидБанковскогоСчета.Депозитный);
	
	ВыборкаБанкСчетов = Пакет.Get(4).Select();
	Пока ВыборкаБанкСчетов.Next() Цикл
		НоваяСтрока = ЭтотОбъект.БанковскиеСчета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаБанкСчетов);
		
		ВалютаБанкСчета = Справочники.Валюты.RUB;
		Если ВыборкаБанкСчетов.КодВалюты = "840" Тогда
			ВалютаБанкСчета = Справочники.Валюты.USD;
			
		ИначеЕсли ВыборкаБанкСчетов.КодВалюты = "978" Тогда
			ВалютаБанкСчета = Справочники.Валюты.EUR;
			
		ИначеЕсли ВыборкаБанкСчетов.КодВалюты = "643" Тогда
			ВалютаБанкСчета = Справочники.Валюты.RUB;
			
		Иначе
			ВалютаБанкСчетаВр	 = Справочники.Валюты.НайтиПоКоду(ВыборкаБанкСчетов.КодВалюты);
			ВалютаБанкСчета		 = ?(ВалютаБанкСчетаВр <> Неопределено, ВалютаБанкСчетаВр, ВыборкаБанкСчетов.КодВалюты);
		КонецЕсли;
		НоваяСтрока.Валюта = ВалютаБанкСчета;
		
		Если ЗначениеЗаполнено(ВыборкаБанкСчетов.БанкБИК) Тогда
			БанкВр = НайтиБанк(ПолучитьСтроковыйUUID(ВыборкаБанкСчетов.Банк), ВыборкаБанкСчетов.БанкБИК, ВыборкаБанкСчетов.БанкСВИФТБИК);
			
			Если ЗначениеЗаполнено(БанкВр) Тогда
				НоваяСтрока.Банк = БанкВр;
			Иначе
				ЗаписьЖурналаРегистрации(
					"Дополнительные отчеты и обработки." + Метаданные().Представление(),
					УровеньЖурналаРегистрации.Ошибка,,,
					"Не найден банк по БИКу """ + ВыборкаБанкСчетов.БанкБИК + """ для банковского счета " + ВыборкаБанкСчетов.НомерСчета + " клиента """ + ВыборкаБанкСчетов.ПредставлениеКонтрагента + """!"
				);
				
				НоваяСтрока.Банк = ВыборкаБанкСчетов.БанкБИК;  // БИК
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаБанкСчетов.БанкДляРасчетовБИК) Тогда
			БанкДляРасчетовВр = НайтиБанк(ПолучитьСтроковыйUUID(ВыборкаБанкСчетов.БанкДляРасчетов), ВыборкаБанкСчетов.БанкДляРасчетовБИК, ВыборкаБанкСчетов.БанкДляРасчетовСВИФТБИК);
			
			Если ЗначениеЗаполнено(БанкДляРасчетовВр) Тогда
				НоваяСтрока.БанкДляРасчетов = БанкДляРасчетовВр;
			Иначе
				ЗаписьЖурналаРегистрации(
					"Дополнительные отчеты и обработки." + Метаданные().Представление(),
					УровеньЖурналаРегистрации.Ошибка,,,
					"Не найден банк по БИКу """ + ВыборкаБанкСчетов.БанкДляРасчетовБИК + """ для банковского счета " + ВыборкаБанкСчетов.НомерСчета + " клиента """ + ВыборкаБанкСчетов.ПредставлениеКонтрагента + """!"
				);
				
				НоваяСтрока.БанкДляРасчетов = ВыборкаБанкСчетов.БанкДляРасчетовБИК;  // БИК
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.ВидСчета = МаппингВидовСчетов.Получить(НРег(ВыборкаБанкСчетов.ВидСчета));
		
		НоваяСтрока.ПредставлениеКонтрагента = ВнешБаза.Соединение.String(ВыборкаБанкСчетов.Владелец);
		НоваяСтрока.UIDКонтрагента			 = ПолучитьСтроковыйUUID(ВыборкаБанкСчетов.Владелец);
		НоваяСтрока.UID						 = ПолучитьСтроковыйUUID(ВыборкаБанкСчетов.БанковскийСчет);
		
		НоваяСтрока.БанковскийСчет = НайтиБанковскийСчет(НоваяСтрока.UID, НоваяСтрока.Банк, НоваяСтрока.НомерСчета, НоваяСтрока.UIDКонтрагента , НоваяСтрока.ВнешнийКодКонтрагента);
	КонецЦикла;
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(ЭтотОбъект.СписокКонтрагентов.Выгрузить(), "Данные контрагентов из ДО");
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(ЭтотОбъект.ДокументыФизиков.Выгрузить(), "Данные документов физиков из ДО");
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(ЭтотОбъект.Договоры.Выгрузить(), "Данные договоров ДУ из ДО");
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(ЭтотОбъект.БанковскиеСчета.Выгрузить(), "Данные банковских счетов из ДО");
	
	ОповещениеОХодеОбмена("" + ТекущаяДата() +  " Получение данных из ДО завершено");
КонецПроцедуры // ПрочитатьДанныеДО()

Функция ПолучитьСтроковыйUUID(Знач ИсходнаяСсылка)
	Перем ВнешнийUUID;
	
	ВнешнийUUID = ВнешБаза.Соединение.XMLСтрока(ИсходнаяСсылка.UUID());
	ВнешнийUUID = СокрЛП(НРег(ВнешнийUUID));
	ВнешнийUUID = ?(ВнешнийUUID = "00000000-0000-0000-0000-000000000000", "", ВнешнийUUID);
	
	Возврат ВнешнийUUID;
КонецФункции // ПолучитьСтроковыйUUID()

Функция jsonУпаковатьФИО(Знач ДополнительноФИО, Знач Отбор)
	Перем json, СтруктураФИО;
	
	СтрокиОтбора = ДополнительноФИО.FindRows(Отбор);
	Если СтрокиОтбора.Count() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	СтруктураФИО = Новый Структура("Фамилия, Имя, Отчество, ФамилияРодПад, ИмяРодПад, ОтчествоРодПад, Период", "", "", "", "", "", "", Дата(1, 1, 1));
	
	Для Каждого ТекСтрока Из СтрокиОтбора Цикл
		ЗаполнитьЗначенияСвойств(СтруктураФИО, ТекСтрока);
		Прервать;
	КонецЦикла;
	
	json = Новый ЗаписьJSON();
	json.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	
	ЗаписатьJSON(json, СтруктураФИО);
	
	Возврат json.Закрыть();
КонецФункции // jsonУпаковатьФИО()

Функция РаспаковатьФИО(Знач jsonСтрока)
	Перем json, СтруктураФИО;
	
	Если НЕ ЗначениеЗаполнено(jsonСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	json = Новый ЧтениеJSON();
	json.УстановитьСтроку(jsonСтрока);
	
	СтруктураФИО = ПрочитатьJSON(json);
	
	Если ТипЗнч(СтруктураФИО.Период) = Тип("Строка") Тогда
		СтруктураФИО.Период = ПрочитатьДатуJSON(СтруктураФИО.Период, ФорматДатыJSON.ISO);
	КонецЕсли;
	
	Возврат СтруктураФИО;
КонецФункции // РаспаковатьФИО()

Функция НайтиДоговорДУ(Знач UID, Знач РегистрационныйНомер, Знач UIDВладельца, Знач ВнешнийКодВладельца = Неопределено)
	Перем ОбъектИнтеграции, Владелец;
	Перем Запрос, Выборка;
	
	Если ЗначениеЗаполнено(UID) Тогда
		ОбъектИнтеграции = СсылкаНаОбъектПоДаннымДокументооборота(UID, "DMInternalDocument");
		Если ЗначениеЗаполнено(ОбъектИнтеграции) Тогда
			Если ОбщегоНазначения.СсылкаСуществует(ОбъектИнтеграции) Тогда
				Возврат ОбъектИнтеграции;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(UIDВладельца) Тогда
		Владелец = НайтиКонтрагента(UIDВладельца, ВнешнийКодВладельца);
		Если НЕ ЗначениеЗаполнено(Владелец) Тогда
			Возврат Справочники.ДоговорДУ.ПустаяСсылка();
		КонецЕсли;
		
		Если НЕ ОбщегоНазначения.СсылкаСуществует(Владелец) Тогда
			Возврат Справочники.ДоговорДУ.ПустаяСсылка();
		КонецЕсли;
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("РегистрационныйНомер", РегистрационныйНомер);
		Запрос.УстановитьПараметр("Владелец", Владелец);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДоговорыДУ.Ссылка КАК Договор
		|ИЗ
		|	Справочник.ДоговорДУ КАК ДоговорыДУ
		|ГДЕ
		|	НЕ ДоговорыДУ.ПометкаУдаления
		|	И ДоговорыДУ.Клиент = &Владелец
		|	И ДоговорыДУ.Код = &РегистрационныйНомер
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДоговорыДУ.Код УБЫВ,
		|	Ссылка";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Договор;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.ДоговорДУ.ПустаяСсылка();
КонецФункции // НайтиДоговорДУ()

