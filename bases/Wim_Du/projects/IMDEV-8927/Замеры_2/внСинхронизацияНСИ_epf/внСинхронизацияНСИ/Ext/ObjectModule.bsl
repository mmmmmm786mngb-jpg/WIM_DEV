Функция ПризнакИИС(ДоговорДУ)

	ПризнакиИИС = Новый Соответствие;
	ПризнакиИИС.Вставить(Перечисления.ТипыИИС.ИИС1, "I");
	ПризнакиИИС.Вставить(Перечисления.ТипыИИС.ИИС2, "I");
	ПризнакиИИС.Вставить(Перечисления.ТипыИИС.ИИС3, "I");
	ПризнакиИИС.Вставить(Перечисления.ТипыИИС.Иное, "");
	ПризнакиИИС.Вставить(Перечисления.ТипыИИС.Нет, "");
	
	ТипИИС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорДУ, "ТипИИС");
	
	Возврат ПризнакиИИС.Получить(ТипИИС);

КонецФункции

Функция ДоговорКонтрагента(ДоговорСсылка, НаименованиеДоговора, Владелец, РольДоговора, НомерДоговора, ДатаДогДУ = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ДоговорДУ = &ДоговорДУ
		|	И ДоговорыКонтрагентов.РольДоговора = &РольДоговора";
	
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорСсылка);
	Запрос.УстановитьПараметр("РольДоговора", РольДоговора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		ДоговорКонтрагента.РольДоговора = РольДоговора;
		ДоговорКонтрагента.Владелец = Владелец;
		//IMAPPS-34301++
		ДоговорКонтрагента.Наименование = НаименованиеДоговора;
		ДоговорКонтрагента.НомерДоговора = НомерДоговора;  
		Если ДатаДогДУ = Неопределено Тогда 
			ДоговорКонтрагента.ДатаДоговора = ДоговорСсылка.ДатаНачала; 
		Иначе
			ДоговорКонтрагента.ДатаДоговора = ДатаДогДУ;
		КонецЕсли; 
		//IMAPPS-34301--
		ДоговорКонтрагента.ДоговорДУ = ДоговорСсылка;
		ДоговорКонтрагента.УстановитьНовыйКод();
		ДоговорКонтрагента.Записать();
		
		Возврат ДоговорКонтрагента.Ссылка;
	КонецЕсли;

КонецФункции

