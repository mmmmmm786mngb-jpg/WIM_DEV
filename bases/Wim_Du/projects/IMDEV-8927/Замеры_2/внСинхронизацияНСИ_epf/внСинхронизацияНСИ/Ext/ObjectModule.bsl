Функция СписокОбъектовИзОткрытыхЗадач()
	Перем Запрос, Пакет;
	Перем ВнешКонтрагенты, ВнешДоговоры;
	
	Запрос = ВнешБаза.Соединение.NewObject("Запрос");
	Запрос.УстановитьПараметр("Исполнитель", Синхронизатор);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ЗадачаИсполнителяПредметы.Предмет КАК Справочник.ВнутренниеДокументы) КАК ВнДокумент
	|ПОМЕСТИТЬ втВнутренниеДокументы
	|ИЗ
	|	Задача.ЗадачаИсполнителя.Предметы КАК ЗадачаИсполнителяПредметы
	|ГДЕ
	|	ЗадачаИсполнителяПредметы.Ссылка.Исполнитель = &Исполнитель
	|	И ЗадачаИсполнителяПредметы.Предмет ССЫЛКА Справочник.ВнутренниеДокументы
	|	И ЗадачаИсполнителяПредметы.Ссылка.БизнесПроцесс.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияБизнесПроцессов.Активен)
	|	И ЗадачаИсполнителяПредметы.Ссылка.БизнесПроцесс ССЫЛКА БизнесПроцесс.Исполнение
	|	И НЕ ЗадачаИсполнителяПредметы.Ссылка.Выполнена
	|	И НЕ ЗадачаИсполнителяПредметы.Ссылка.ПометкаУдаления
	|	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ВнутренниеДокументы.ВнДокумент КАК Справочник.ВнутренниеДокументы) КАК ДоговорДУ
	|ИЗ
	|	втВнутренниеДокументы КАК ВнутренниеДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ВнутренниеДокументы.ВнДокумент.Контрагент КАК Справочник.Контрагенты) КАК Контрагент
	|ИЗ
	|	втВнутренниеДокументы КАК ВнутренниеДокументы";
	
	Пакет = Запрос.ExecuteBatch();
	
	ВнешДоговоры = Пакет.Get(1).Unload().UnloadColumn("ДоговорДУ");
	ВнешКонтрагенты = Пакет.Get(2).Unload().UnloadColumn("Контрагент");
	
	Возврат Новый Структура("Контрагенты, Договоры", ВнешКонтрагенты, ВнешДоговоры);
КонецФункции // СписокОбъектовИзОткрытыхЗадач()

Функция СписокКонтрагентовВыборочнойСинхронизации()
	
	СписокВнешКонтрагентов	= ВнешБаза.Соединение.NewObject("Массив");
	СвойствоВнешнийКод 		= ВнешБаза.Соединение.ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.FindByAttribute("Заголовок","ВнешнийКод");

	
	Для каждого текСтрока из ВыборочнаяСинхронизация Цикл
		
		Если НЕ текСтрока.ВыполнитьСинхронизацию или текСтрока.Ошибка или текСтрока.Контрагент.Пустая() тогда продолжить; КонецЕсли;
		
		ГУЙ = Строка(текСтрока.Контрагент.УникальныйИдентификатор());
		ВнешКонтрагент = ВнешнийКонтрагентПоUID(ГУЙ);
		
		Если ВнешКонтрагент.GetObject() = неопределено тогда
			ВнешнийКод = СокрЛП(текСтрока.Контрагент.ВнешнийКод); 
			Если НЕ ВнешнийКод="" тогда
                 ВнешКонтрагент = КонтрагентДОпоВнешнемуКоду(ВнешнийКод,СвойствоВнешнийКод);				
			КонецЕсли;          
			
			Если ВнешКонтрагент.IsEmpty() тогда
				текСтрока.Ошибка = Истина;
				текСтрока.ОписаниеОшибки = "В ДО не найден контрагент для синхронизации";
			Иначе
				СписокВнешКонтрагентов.Add(ВнешКонтрагент);
			КонецЕсли;
			 
		Иначе
			СписокВнешКонтрагентов.Add(ВнешКонтрагент);
		КонецЕсли;

	КонецЦикла;
	
	ОповещениеОХодеОбмена(""+ТекущаяДата() + " Получен список контрагентов ДО по выборочной синхронизации");
	
	Возврат СписокВнешКонтрагентов;
	
КонецФункции

Функция СписокВнешКонтрагентовПоВнутренним(массивКонтрагентов)
	
	СписокВнешКонтрагентов	= ВнешБаза.Соединение.NewObject("Массив");
	СвойствоВнешнийКод 		= ВнешБаза.Соединение.ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.FindByAttribute("Заголовок","ВнешнийКод");
	
	Для каждого текКонтрагент из массивКонтрагентов цикл
		
		ГУЙ = Строка(текКонтрагент.УникальныйИдентификатор());
		ВнешКонтрагент = ВнешнийКонтрагентПоUID(ГУЙ);
		
		Если ВнешКонтрагент.GetObject() = неопределено тогда
			ВнешнийКод = СокрЛП(текКонтрагент.ВнешнийКод); 
			
			Если НЕ ВнешнийКод="" тогда
				ВнешКонтрагент = КонтрагентДОпоВнешнемуКоду(ВнешнийКод,СвойствоВнешнийКод);				
			КонецЕсли;          
			
			Если НЕ ВнешКонтрагент.IsEmpty() тогда				
				СписокВнешКонтрагентов.Add(ВнешКонтрагент);
			КонецЕсли; 	
			
		Иначе
			
			СписокВнешКонтрагентов.Add(ВнешКонтрагент);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокВнешКонтрагентов;
	
КонецФункции

Процедура СнятьФлажкиВыборочнойСинхронизации()
	
	Для каждого ТекСтрока из ВыборочнаяСинхронизация Цикл
		
		СтрокаСпискаКонтрагентов = СписокКонтрагентов.Найти(ТекСтрока.Контрагент,"КонтрагентДУ");
		Если НЕ СтрокаСпискаКонтрагентов = Неопределено и СтрокаСпискаКонтрагентов.Отказ = Ложь тогда
			ТекСтрока.ВыполнитьСинхронизацию = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КонтрагентДОпоВнешнемуКоду(ВнешнийКод, Свойство)
	
	ПустаяСсылка = ВнешБаза.Соединение.Справочники.Контрагенты.EmptyRef();
	
	Если Свойство.IsEmpty() тогда 
		Возврат ПустаяСсылка;
	КонецЕсли;
	  				
	Запрос = ВнешБаза.Соединение.NewObject("Запрос");
	Запрос.УстановитьПараметр("ВнешнийКод", 	ВнешнийКод);
	Запрос.УстановитьПараметр("Свойство", 		Свойство);

	
	Запрос.текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ДопРекв.Ссылка,
	               |	ДопРекв.Значение,
	               |	ДопРекв.Свойство
	               |ИЗ
	               |	Справочник.Контрагенты.ДополнительныеРеквизиты КАК ДопРекв
	               |ГДЕ
	               |	ДопРекв.Свойство = &Свойство
	               |	И ДопРекв.Значение = &ВнешнийКод";

	Результат = Запрос.Execute();
	
	Если Результат.IsEmpty() тогда 
		Возврат ПустаяСсылка;
	КонецЕсли;
	
	Выборка = Результат.Select();
	Выборка.Next();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция ЭтоГражданинРФ(Знач UIDФизика)
	Перем ДокументыФизика;
	
	ДокументыФизика = ЭтотОбъект.ДокументыФизиков.Выгрузить(Новый Структура("UIDФизика", UIDФизика), "Период, ГражданинРФ");
	ДокументыФизика.Сортировать("Период Убыв");
	
	Если ДокументыФизика.Количество() > 0 Тогда
		Возврат ДокументыФизика[0].ГражданинРФ;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции // ЭтоГражданинРФ()

