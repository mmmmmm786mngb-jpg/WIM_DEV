// IMDEV-8927 ++
// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Имя ключевой операции для замера фоновых команд внСинхронизацияНСИ (РЗ №07, №15).
//
// Параметры:
// ИдентификаторКоманды - Строка - ФоновоеВыполнение или ФоновоеВыполнениеПоручения
//
// Возвращаемое значение:
// Строка - имя ключевой операции
//
Функция ПолучитьИмяКлючевойОперацииЗамераСинхронизацияНСИ(ИдентификаторКоманды)
	
	Возврат "ДУ.СинхронизацияНСИ." + ИдентификаторКоманды;
	
КонецФункции

// Описание: Завершает замер синхронизации НСИ (без времени формирования и отправки почты).
//
// Параметры:
// ВремяНачалаЗамера - Число - метка начала замера; 0 - замер не выполнялся
// КлючеваяОперация - Строка - имя ключевой операции
// КоличествоОбъектов - Число - вес замера
// ЕстьОшибкиFAIL - Булево - признак критической ошибки
// ЕстьПредупреждения - Булево - признак предупреждения
//
Процедура ЗавершитьЗамерСинхронизацииНСИ(ВремяНачалаЗамера, КлючеваяОперация, КоличествоОбъектов,
	ЕстьОшибкиFAIL, ЕстьПредупреждения = Ложь)
	
	Если ВремяНачалаЗамера <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВесЗамера = ?(КоличествоОбъектов > 0, КоличествоОбъектов, 1);
	КомментарийЗамера = "Объектов=" + КоличествоОбъектов
		+ "; FAIL=" + ?(ЕстьОшибкиFAIL, "Да", "Нет")
		+ "; WARN=" + ?(ЕстьПредупреждения, "Да", "Нет")
		+ ДополнениеКомментарияУдельныйВес(ВесЗамера, ВремяНачалаЗамера);
	ОценкаПроизводительности.ЗакончитьЗамерВремени(
		КлючеваяОперация,
		ВремяНачалаЗамера,
		ВесЗамера,
		КомментарийЗамера,
		ЕстьОшибкиFAIL);
	
КонецПроцедуры
