Функция ЗаполнитьАналитическиеСчета(ДоговорСсылка, ПереводРеквизиты)

	ТекстОшибки = "";
	Попытка
		Код = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
		ПризнакИИС = ПризнакИИС(ДоговорСсылка);
		SubAccount = ТорговыйКод + "//" + ПризнакИИС + ПреобразоватьКод(Код);
		
		СпрТорговыйКод = Справочники.ТорговыеКоды.СоздатьЭлемент();
		СпрТорговыйКод.УстановитьНовыйКод();
		СпрТорговыйКод.ТорговыйКод = SubAccount;
		СпрТорговыйКод.Наименование = SubAccount;
		СпрТорговыйКод.Биржа = Биржа;
		СпрТорговыйКод.ДоговорДУ = ДоговорСсылка;
		СпрТорговыйКод.Брокер = Брокер;
		
		
		Если ЗначениеЗаполнено(ОбразецДоговорБрокерский)Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
				|ГДЕ
				|	ДоговорыКонтрагентов.Владелец = &Владелец
				|	И ДоговорыКонтрагентов.ДоговорДУ = &ДоговорДУ
				|	И ДоговорыКонтрагентов.РольДоговора = &РольДоговора";
			
			Запрос.УстановитьПараметр("Владелец", Брокер);
			Запрос.УстановитьПараметр("ДоговорДУ", ДоговорСсылка);
			Запрос.УстановитьПараметр("РольДоговора", ОбразецДоговорБрокерский.РольДоговора);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				 СпрТорговыйКод.ДоговорБрокера = ВыборкаДетальныеЗаписи.Ссылка;
			Иначе

				ШаблонДоговора = ОбразецДоговорБрокерский.ПолучитьОбъект();
				ДоговорБрокерский = ШаблонДоговора.Скопировать();
				ДоговорБрокерский.Скопировать();
				ДоговорБрокерский.ДоговорДУ = ДоговорСсылка;
				//ДоговорБрокерский.ДатаДоговора = ДоговорСсылка.ДатаНачала;
				ДоговорБрокерский.Наименование = "ЕБС_ВТБ_RUB_" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
				ДоговорБрокерский.НомерДоговора = "б/н";
				ДоговорБрокерский.ДатаДоговора = ДоговорСсылка.ДатаНачала; 
				
				ДоговорБрокерский.Записать();
				СпрТорговыйКод.ДоговорБрокера = ДоговорБрокерский.Ссылка;   
			КонецЕсли;
		Иначе //прошлый алгоритм, если по какой-то причине не установлены настройки
			РольДоговора = Перечисления.РолиДоговоровКонтрагента.Брокерский;
			НаименованиеДоговора = "ЕБС_ВТБ_RUB_" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
			НомерДоговора = "б/н";
			ДоговорБрокера = ДоговорКонтрагента(ДоговорСсылка, НаименованиеДоговора, Брокер, РольДоговора, НомерДоговора);
			СпрТорговыйКод.ДоговорБрокера = ДоговорБрокера;
		КонецЕсли;
		
		МестоХранения = БанковскийСчетБрокера;
		Наименование = ДоговорСсылка.Код + "_ВТБ24_ММВБ_НГЦБ_ДС";
		Вид = Перечисления.ВидыАналитическогоСчета.ДенежныеСредства;
		СчетаБрокера = АналитическийПризнакиБрокерскогоСчета(ДоговорСсылка);
		// MAPPS-34920++
		//АналитическийСчетДС = СоздатьАналитическийСчет(ДоговорСсылка, ДоговорБрокера, МестоХранения, Наименование, Вид, СчетаБрокера);
		АналитическийСчетДС = СоздатьАналитическийСчет(ДоговорСсылка, СпрТорговыйКод.ДоговорБрокера, МестоХранения, Наименование, Вид, СчетаБрокера);
		// MAPPS-34920--
		СпрТорговыйКод.АналитическийСчетДС = АналитическийСчетДС;
		ПереводРеквизиты.Вставить("АналитическийСчетПриемник", АналитическийСчетДС);
		
		РольДоговора = Перечисления.РолиДоговоровКонтрагента.БанковскогоСчета;
		НаименованиеДоговора = "ЕРС_ВТБ_RUB_" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
		НомерДоговора = "б/н";
		ДоговорЕРС = ДоговорКонтрагента(ДоговорСсылка, НаименованиеДоговора, Брокер, РольДоговора, НомерДоговора);
		
		РольДоговора = Перечисления.РолиДоговоровКонтрагента.Агентский;  
		ПулРозничноеДУ = Справочники.Пул.ПолучитьСсылку(Новый УникальныйИдентификатор("686be652-ff24-11ef-b2be-0050569f27c0")); //IMAPPS-34301 
	    БанкВТБ_Агент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор("d0e9c57a-ca23-11f0-b2cb-0050569f27c0"));  //IMAPPS-34301 

		//IMAPPS-34301++ 
		Если ДоговорСсылка.Пул = ПулРозничноеДУ И Агент = БанкВТБ_Агент Тогда 
			НаименованиеДоговора = "Агентский_ВТБ_" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
			НомерДоговора = "01-РД";
		    ДатаДоговораДУ = Дата(2025, 10, 31);
		Иначе
			НаименованиеДоговора = "Агентский_ВТБ24_" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
			НомерДоговора = "б/н";
		    ДатаДоговораДУ = Неопределено;
		КонецЕсли;
		//IMAPPS-34301--
		ДоговорАгентский = ДоговорКонтрагента(ДоговорСсылка, НаименованиеДоговора, Агент, РольДоговора, НомерДоговора,ДатаДоговораДУ);
		
		МестоХранения = БанковскийСчет;
		Наименование = "р/с_ВТБ_ДС_RUR_" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
		Вид = Перечисления.ВидыАналитическогоСчета.ДенежныеСредства;
		АналитическийСчетДС = СоздатьАналитическийСчет(ДоговорСсылка, ДоговорЕРС, МестоХранения, Наименование, Вид);
		ПереводРеквизиты.Вставить("АналитическийСчетИсточник", АналитическийСчетДС);
		
		РольДоговора = Перечисления.РолиДоговоровКонтрагента.Депозитарный;
		НаименованиеДоговора = "Депозитарный_ВТБ24_ЕДС_" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
		НомерДоговора = "б/н";
		ДоговорДепозитарный = ДоговорКонтрагента(ДоговорСсылка, НаименованиеДоговора, Брокер, РольДоговора, НомерДоговора);
		
		МестоХранения = СчетДепо;
		Наименование = "ВТБ24_ММВБ_НГЦБ_" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "Код");
		Вид = Перечисления.ВидыАналитическогоСчета.ЦенныеБумаги;
		АналитическийСчетЦБ = СоздатьАналитическийСчет(ДоговорСсылка, ДоговорДепозитарный, МестоХранения, Наименование, Вид, СчетаБрокера);
		СпрТорговыйКод.АналитическийСчетЦБ = АналитическийСчетЦБ;
		
		СпрТорговыйКод.Записать();
		
	Исключение
		Шаблон = "Ошибки создания торгового кода по счету %1. Описание ошибки: %3";
		ТекстОшибки = СтрШаблон(Шаблон, SubAccount, ОписаниеОшибки());
		
		ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				"При записи Аналитики договора розничного ДУ произошла ошибка: " + ТекстОшибки
			);
			
			ОповещениеОХодеОбмена("Ошибка записи Аналитики договора розничного ДУ: " + ДоговорСсылка+ " " + ТекстОшибки, Истина);
	
	КонецПопытки; 
	
	Возврат ТекстОшибки;

