			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				БанкСчетОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			Иначе
				БанкСчетОбъект = Справочники.БанковскиеСчета.СоздатьЭлемент();
			КонецЕсли;
			
		Иначе
			БанкСчетОбъект = Справочники.БанковскиеСчета.СоздатьЭлемент();
		КонецЕсли;
		
		БанкСчетОбъект.Наименование			 = текСтрока.Наименование;
		БанкСчетОбъект.Владелец				 = Владелец;
		БанкСчетОбъект.ВалютаДенежныхСредств = текСтрока.Валюта;
		БанкСчетОбъект.ВидСчета				 = текСтрока.ВидСчета;
		БанкСчетОбъект.НомерСчета			 = текСтрока.НомерСчета;
		БанкСчетОбъект.Банк					 = текСтрока.Банк;
		БанкСчетОбъект.БанкДляРасчетов		 = текСтрока.БанкДляРасчетов;
		БанкСчетОбъект.ДатаОткрытия			 = текСтрока.ДатаОткрытия;
		БанкСчетОбъект.ДатаЗакрытия			 = текСтрока.ДатаЗакрытия;
		БанкСчетОбъект.ТекстНазначения		 = текСтрока.ТекстНазначения;
		БанкСчетОбъект.ТипСчета				 = Перечисления.ТипРасчетногоСчета.Индивидуальный;
		
		Попытка
			//БанкСчетОбъект.ОбменДанными.Загрузка = Истина;
			БанкСчетОбъект.Записать();
			
			текСтрока.БанковскийСчет = БанкСчетОбъект.Ссылка;
			
			ОповещатьОбОбработке_БанкСчета = Истина;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			
			ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("При записи Банковского счета %1 контрагента %2 произошла ошибка: %3", текСтрока.НомерСчета, текСтрока.ПредставлениеКонтрагента, ТекстОшибки)
			);
			
			текСтрока.ОписаниеОшибки = ТекстОшибки;
			текСтрока.Отказ = Истина;
			
			ОповещениеОХодеОбмена("Ошибка записи Банковского счета: '" + текСтрока.Наименование + "'! Описание ошибки: " + ТекстОшибки, Истина);
			
			//ВызватьИсключение ТекстОшибки;
		КонецПопытки;
		
		ДобавитьСвязь(текСтрока.UID, "DMBankAccount", БанкСчетОбъект.Ссылка);
	КонецЦикла;
	
	Если ОповещатьОбОбработке_БанкСчета Тогда
		ОповещениеОХодеОбмена("" + ТекущаяДата() + " Обработка Банковских счетов завершена");
	КонецЕсли;
КонецПроцедуры // СоздатьНСИ()

Процедура СоздатьИнвестпрофиль(Знач ДоговорДУ, Знач ДатаДоговора, Знач ТипИнвестпрофиля, Знач Запарковать = Истина, Проводить)
	Перем ПрофильОбъект;
	Перем МЗ, ДатаПарковки;
	
	ДатаПарковки = ТекущаяДатаСеанса();
	
	ПрофильОбъект = Документы.ИнвестиционныйПрофиль.СоздатьДокумент();
	ПрофильОбъект.Дата						 = ?(ЗначениеЗаполнено(ДатаДоговора), ДатаДоговора, ТекущаяДатаСеанса());
	ПрофильОбъект.ДоговорДУ					 = ДоговорДУ;
	ПрофильОбъект.Стратегия					 = Справочники.Стратегии.ПустаяСсылка();
	ПрофильОбъект.ТипИнвестиционногоПрофиля	 = ТипИнвестпрофиля;
	ПрофильОбъект.Комментарий				 = "Создан при синхронизации с 1С:ДО " + Формат(ДатаПарковки, "ДФ='yyyy-MM-dd HH:mm:ss'");
	ПрофильОбъект.МетодРасчетаДопустимогоУровняРисков = Перечисления.МетодыРасчетаДопустимогоУровняРисков.ПоАлгоритмуTWR;
	
	РежимДок = ?(Проводить, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	ПрофильОбъект.Записать(РежимДок);  // приходит непроведенным!!!
	
	Если Запарковать Тогда
		МЗ = РегистрыСведений.УниверсальныеСопоставления.СоздатьМенеджерЗаписи();
		МЗ.КонтекстСопоставления = Перечисления.КонтекстСопоставления.ДоговорДУ;
		МЗ.КонтекстОбъекта		 = ДоговорДУ;
		МЗ.ВнешнийОбъект		 = "Инвестпрофиль";
		МЗ.НашОбъект			 = ПрофильОбъект.Ссылка;
		МЗ.ДатаНачалаДействия	 = ДатаПарковки;
		МЗ.Наименование			 = "Создано при синхронизации с 1С:ДО " + Формат(ДатаПарковки, "ДФ='yyyy-MM-dd HH:mm:ss'");
		МЗ.Записать();
	КонецЕсли;
КонецПроцедуры // СоздатьИнвестпрофиль()

