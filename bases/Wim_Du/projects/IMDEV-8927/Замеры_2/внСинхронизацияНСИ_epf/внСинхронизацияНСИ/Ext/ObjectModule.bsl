#Область ПРОГРАММНЫЙ_ИНТЕРФЕЙС

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды = "ФоновоеВыполнение" Тогда
		
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
		
		// IMDEV-8927 ++
		КлючеваяОперацияЗамера = ПолучитьИмяКлючевойОперацииЗамераСинхронизацияНСИ("ФоновоеВыполнение");
		ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
		// IMDEV-8927 --
		
		ВыполнитьСинхронизациюНСИ(Ложь);
		
		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ПлатежныеПорученияСледующийРабочий, ПлатежныеПоручения);
		
		// IMDEV-8927 ++
		ЗавершитьЗамерСинхронизацииНСИ(
			ВремяНачалаЗамера,
			КлючеваяОперацияЗамера,
			ПлатежныеПоручения.Количество(),
			Ложь);
		// IMDEV-8927 --
		
		Если СписокРассылки.Количество() > 0 И ЗначениеЗаполнено(ПочтовыйЛогин) И ПлатежныеПоручения.Количество() > 0 Тогда
			СформироватьИОтправитьПисьмо();
		КонецЕсли;
		
		Если ПлатежныеПорученияСледующийРабочий.Количество() > 0 Тогда
			УстановкаПризнакаОтправкиНаБрокерскийСчет();
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "ФоновоеВыполнениеПоручения" Тогда
		
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
		
		// IMDEV-8927 ++
		КлючеваяОперацияЗамера = ПолучитьИмяКлючевойОперацииЗамераСинхронизацияНСИ("ФоновоеВыполнениеПоручения");
		ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
		// IMDEV-8927 --
		
		ЕстьОшибки = Ложь;
		ЕстьПредупреждения = Ложь;
		Важность = 0;
		
		Попытка
			ПолучитьУведомления(ЕстьОшибки, ЕстьПредупреждения);
			
			СоздатьПоручения(ЕстьОшибки, ЕстьПредупреждения);
		Исключение
			ДобавитьТекст(ОписаниеОшибки());
			ЕстьОшибки = Истина;
		КонецПопытки;
		
		// IMDEV-8927 ++
		ЗавершитьЗамерСинхронизацииНСИ(
			ВремяНачалаЗамера,
			КлючеваяОперацияЗамера,
			Поручения.Количество(),
			ЕстьОшибки,
			ЕстьПредупреждения);
		// IMDEV-8927 --
		
		Если СписокРассылки.Количество() > 0 И ЗначениеЗаполнено(ПочтовыйЛогин) И Поручения.Количество() > 0 Тогда
			СформироватьИОтправитьПисьмоПоПоручениям(ЕстьОшибки, ЕстьПредупреждения)
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	Перем НастройкиВыполнения, ЗначенияНастроек;
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда
		Возврат "<Настройки не установлены>";
	КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции // УстановитьНастройки()

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	Если Настройки.Свойство("Значения") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки.Значения);
		
		Если Настройки.Значения.Свойство("СписокРассылки") тогда
			СписокРассылки.Загрузить(XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки).Получить());
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры // УстановитьПользовательскиеНастройки()

