Процедура КЕШировать(КЕШ, Знач Раздел, Знач Ключ, Знач Значение)
	Если КЕШ = Неопределено Тогда
		КЕШ = СоздатьКЕШ();
	КонецЕсли;
	
	КЕШ[Раздел].Вставить(Ключ, Значение);
КонецПроцедуры // КЕШировать()

Процедура ВыполнитьСинхронизациюНСИ(Отказ = Ложь) Экспорт
	Перем ТекстОшибки;
	Перем КЕШ;
	Перем СписокОбъектов;
	
	УстановитьСоединениеДО(Отказ);
	
	Если Отказ тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		КонтрагентыСОшибкамиДО();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Отказ = Истина;
		
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Произошла ошибка при синхронизации (получение error-контрагентов из 1С:ДО)! Описание ошибки: " + ТекстОшибки
		);
		
		ОповещениеОХодеОбмена("" + ТекущаяДата() + " Произошла ошибка во время получения контрагентов из 1С:ДО! Описание ошибки: " + ТекстОшибки, Истина);
	КонецПопытки;
	
	Если НЕ Отказ Тогда
		Попытка
			СписокОбъектов = СписокОбъектовИзОткрытыхЗадач();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				"Произошла ошибка при синхронизации (получение ключевых объектов из 1С:ДО)! Описание ошибки: " + ТекстОшибки
			);
			
			ОповещениеОХодеОбмена("" + ТекущаяДата() + " Произошла ошибка во время получения ключевых объектов из 1С:ДО! Описание ошибки: " + ТекстОшибки, Истина);
		КонецПопытки;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		Попытка
			ПрочитатьДанныеДО(
				СписокОбъектов.Контрагенты,
				СписокОбъектов.Договоры
			);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				"Произошла ошибка при синхронизации (получение данных из 1С:ДО)! Описание ошибки: " + ТекстОшибки
			);
			
			ОповещениеОХодеОбмена("" + ТекущаяДата() + " Произошла ошибка во время получения данных из 1С:ДО! Описание ошибки: " + ТекстОшибки, Истина);
		КонецПопытки;
	КонецЕсли;
	
	КЕШ = СоздатьКЕШ();
	
	МенеджерыКлиентов = Новый Соответствие();
	
	НачатьТранзакцию();
	
	Если НЕ Отказ Тогда
		Попытка
			СоздатьНСИ(КЕШ, МенеджерыКлиентов);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				"Произошла ошибка при синхронизации (создание НСИ)! Описание ошибки: " + ТекстОшибки
			);
			
			ОповещениеОХодеОбмена("" + ТекущаяДата() + " Произошла ошибка во время создания НСИ! Описание ошибки: " + ТекстОшибки, Истина);
		КонецПопытки;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		Попытка
			УстановитьМенеджераКлиента(МенеджерыКлиентов);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				"Произошла ошибка при заполнении менеджера клиента! Описание ошибки: " + ТекстОшибки
			);
			
			ОповещениеОХодеОбмена("" + ТекущаяДата() + " Произошла ошибка при заполнении менеджера клиента! Описание ошибки: " + ТекстОшибки, Истина);
		КонецПопытки;
	КонецЕсли;
	
	// IMAPPS-9510 -->
	СинхронизацияМенеджеров();
	// IMAPPS-9510 <--
	
	Если ТранзакцияАктивна() Тогда
		Если Отказ Тогда
			ОтменитьТранзакцию();
		Иначе
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		Попытка
			ИсполнитьЗадачиДО();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				"Произошла ошибка при синхронизации (исполнение задач)! Описание ошибки: " + ТекстОшибки
			);
			
			ОповещениеОХодеОбмена("" + ТекущаяДата() + " Произошла ошибка во время исполнения задачи в 1С:ДО! Описание ошибки: " + ТекстОшибки, Истина);
		КонецПопытки;
	КонецЕсли;
	
	Если ТекущееВремяРабочее() Тогда
		ПлатежныеПорученияРозничногоДУ();
	КонецЕсли;
	
	// Вне транзакции!
	СинхронизацияДатыПодписанияДоговоров_в_ДУ();  // если в ДО появилась дата Подписания, то нужно ее перенести в ДУ!
	СинхронизацияДатыРасторженияДоговоров_в_ДО();  // и обратно - если в АванкорДУ появилась дата Расторжения, то нужно ее перенести в ДО и пометить договор недействующим!
КонецПроцедуры

Процедура УстановитьМенеджераКлиента(Знач МенеджерыКлиентов)
	Перем Клиент, КлиентОбъект;
	Перем МенеджерУК;
	
	Для Каждого ТекНабор Из МенеджерыКлиентов Цикл
		Клиент = ТекНабор.Ключ;
		
		Если ЗначениеЗаполнено(ТекНабор.Значение.UID) Тогда
			МенеджерУК = НайтиМенеджераУК(ТекНабор.Значение.UID);
			
			Если НЕ ЗначениеЗаполнено(МенеджерУК) Тогда
				МенеджерУК = СоздатьМенеджераУК(ТекНабор.Значение.UID, ТекНабор.Значение.Наименование);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(МенеджерУК) Тогда
				КлиентОбъект = Клиент.ПолучитьОбъект();
				КлиентОбъект.Менеджер = МенеджерУК;
				КлиентОбъект.ОбменДанными.Загрузка = Истина;  // от греха подальше
				КлиентОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // УстановитьМенеджераКлиента()

Функция СоздатьМенеджераУК(Знач UID, Знач Наименование)
	Перем МенеджерОбъект;
	
	КонтрагентСсылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(UID));
	
	Если КонтрагентСсылка.ПолучитьОбъект() = Неопределено Тогда
	
		МенеджерОбъект = Справочники.Контрагенты.СоздатьЭлемент();
		МенеджерОбъект.УстановитьСсылкуНового(КонтрагентСсылка);
		МенеджерОбъект.Наименование = Наименование;
		МенеджерОбъект.ОбменДанными.Загрузка = Истина;
		МенеджерОбъект.Записать();
		
		ДобавитьСвязь(UID, "DMICManagers", МенеджерОбъект.Ссылка);
		
		Возврат МенеджерОбъект.Ссылка;
	Иначе
		ДобавитьСвязь(UID, "DMICManagers", КонтрагентСсылка);
		
		Возврат КонтрагентСсылка;
	КонецЕсли;
	

КонецФункции // СоздатьМенеджераУК()

Процедура ВыполнитьВыборочнуюСинхронизацию(Отказ = Ложь) Экспорт
	
	УстановитьСоединениеДО(Отказ);
	Если Отказ тогда возврат; КонецЕсли;
	
	КонтрагентыСОшибкамиДО();
	
	ВнешКонтрагенты = СписокКонтрагентовВыборочнойСинхронизации();
	ПрочитатьДанныеДО(ВнешКонтрагенты);
	
	СоздатьНСИ();
	
	СнятьФлажкиВыборочнойСинхронизации();
	
КонецПроцедуры

Функция ОтчетПоСверке(Отказ=Ложь) Экспорт
	Перем Запрос;
	
	УстановитьСоединениеДО(Отказ);
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.КПП КАК КПП,
	|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
	|	Контрагенты.Наименование КАК Наименование,
	|	Контрагенты.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо) КАК ЭтоФизик,
	|	ЕСТЬNULL(ЮрАдрес.Представление, """") КАК ЮридическийАдрес,
	|	ЕСТЬNULL(ФактАдрес.Представление, """") КАК ФактическийАдрес,
	|	ЕСТЬNULL(ПочтовыйАдрес.Представление, """") КАК ПочтовыйАдрес,
	|	ЕСТЬNULL(email.АдресЭП, """") КАК email,
	|	ЕСТЬNULL(Телефон.Представление, """") КАК Телефон,
	|	Контрагенты.ВнешнийКод КАК ВнешнийКод,
	|	Контрагенты.Пол КАК Пол,
	|	Контрагенты.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК ЮрАдрес
	|		ПО Контрагенты.Ссылка = ЮрАдрес.Ссылка
	|			И (ЮрАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (ЮрАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК ФактАдрес
	|		ПО Контрагенты.Ссылка = ФактАдрес.Ссылка
	|			И (ФактАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (ФактАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК ПочтовыйАдрес
	|		ПО Контрагенты.Ссылка = ПочтовыйАдрес.Ссылка
	|			И (ПочтовыйАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (ПочтовыйАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ПочтАдресКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК email
	|		ПО Контрагенты.Ссылка = email.Ссылка
	|			И (email.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|			И (email.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК Телефон
	|		ПО Контрагенты.Ссылка = Телефон.Ссылка
	|			И (Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|			И (Телефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента))
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И НЕ Контрагенты.ЭтоГруппа";
	
	Результат = Запрос.Выполнить();
	
	МассивКонтрагентов = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОшибочныеКонтрагентыДО	= ВнешБаза.Соединение.NewObject("Массив");
	
	СписокКонтрагентов.Очистить();
	ТЗ = СписокКонтрагентов.Выгрузить();
	
	ВнешКонтрагенты = СписокВнешКонтрагентовПоВнутренним(массивКонтрагентов);
	ПрочитатьДанныеДО(ВнешКонтрагенты);
	
	ТабДок = Новый ТабличныйДокумент;

	Макет = ПолучитьМакет("Сверка");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	
	ОбластьКонтрагент 	= Макет.ПолучитьОбласть("Контрагент");
	ОбластьРеквизит 	= Макет.ПолучитьОбласть("Реквизит");
	
	ТабДок.Вывести(Шапка);
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ОбластьКонтрагент 	= Макет.ПолучитьОбласть("Контрагент");
		ОбластьКонтрагент.Параметры.Контрагент = Выборка.ссылка;
		
		СтрВнешнийКонтрагент =  СписокКонтрагентов.Найти(Выборка.ссылка,"КонтрагентДУ");
		Если СтрВнешнийКонтрагент = Неопределено Тогда
			ОбластьКонтрагент.Область("R1C2:R1C2").ЦветФона = WebЦвета.Коралловый;
			ТабДок.Вывести(ОбластьКонтрагент);					
			Продолжить;
		КонецЕсли;
		
		ЕстьРазличия = Ложь;
		
		ТабРеквизиты = Новый ТабличныйДокумент;

		Для каждого ТекКолонка из Результат.Колонки Цикл
			
			Если ТЗ.Колонки.Найти(ТекКолонка.Имя)=Неопределено тогда Продолжить; КонецЕсли;
			
			ДО = СтрВнешнийКонтрагент[ТекКолонка.Имя];
			ДУ = Выборка[ТекКолонка.Имя];
			
			Если ДО=ДУ тогда Продолжить; КонецЕсли;
			
						
			ОбластьРеквизит.Параметры.ИмяРеквизита 	= ТекКолонка.Имя;
			ОбластьРеквизит.Параметры.ДУ 			= ДУ; 
			ОбластьРеквизит.Параметры.ДО			= ДО;
			ТабРеквизиты.Вывести(ОбластьРеквизит);
			
			ЕстьРазличия = Истина;
			
		КонецЦикла;
		
		Если ЕстьРазличия тогда
			ОбластьКонтрагент.Область("R1C2:R1C2").ЦветФона = WebЦвета.СветлоЗолотистый;
			ТабДок.Вывести(ОбластьКонтрагент);
			ТабДок.Вывести(ТабРеквизиты);					
		Иначе
			ОбластьКонтрагент.Область("R1C2:R1C2").ЦветФона = WebЦвета.СветлоЗеленый;
			ТабДок.Вывести(ОбластьКонтрагент);		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабДок;
КонецФункции

Процедура ПолучитьУведомления(ЕстьОшибки, ЕстьПредупреждения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	УстановитьСоединениеДО(ЕстьОшибки);
	
	МассивСообщений = ПолучитьСообщенияПользователю();
	
	Для каждого Сообщение Из МассивСообщений Цикл
		ДобавитьТекст(Сообщение.Текст);
	КонецЦикла;
	
	Если ЕстьОшибки Тогда Возврат; КонецЕсли;
	
	ТекущаяДата = ТекущаяДатаСеанса();
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Поручение.Ссылка КАК Поручение,
	|	ОбъектыИнтегрированные.ИдентификаторОбъектаДокументооборота КАК UIDПоручения
	|ИЗ
	|	Документ.Поручение КАК Поручение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбъектыИнтегрированныеС1СДокументооборотом КАК ОбъектыИнтегрированные
	|		ПО (ОбъектыИнтегрированные.Объект = Поручение.Ссылка)
	|			И (ОбъектыИнтегрированные.Объект ССЫЛКА Документ.Поручение)
	|ГДЕ
	|	ОбъектыИнтегрированные.ТипОбъектаДокументооборота = ""DMInternalDocument""
	|	И ОбъектыИнтегрированные.ИдентификаторОбъектаДокументооборота > """"
	|	И Поручение.Дата > ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), МЕСЯЦ, -1)";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	
	Данные = Запрос.Выполнить().Выгрузить();
	Данные.Индексы.Добавить("UIDПоручения");
	
	СписокКлючей = ВнешБаза.Соединение.NewObject("Массив");;
	СписокКлючей.Добавить("ВидДокумента_УведомлениеДоговорДУ_ФЛ");
	СписокКлючей.Добавить("ПВХ_ВидУведомленияДУ");
	СписокКлючей.Добавить("ПВХ_ТипДУ");
	СписокКлючей.Добавить("ДопЗнч_ТипДУ_Розничное");
	СписокКлючей.Добавить("ТипСвязи_ИмеетУведомление");
	СписокКлючей.Добавить("ВидУведомленияДУ_ВыводЧастиАктивов");
	СписокКлючей.Добавить("ВидДокумента_ДоговорДУ_ФЛ");
	
	ЗапросВн = ВнешБаза.Соединение.NewObject("Query");
	ЗапросВн.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	ЗапросВн.УстановитьПараметр("СписокКлючей", СписокКлючей);
	ЗапросВн.УстановитьПараметр("Шаблон1", "%перевод дс из%");
	ЗапросВн.УстановитьПараметр("Шаблон2", "%на основании распоряжения Клиента%");
	ЗапросВн.Текст = 
	"ВЫБРАТЬ
	|	УниверсальныеСопоставления.Ключ КАК Ключ,
	|	УниверсальныеСопоставления.Значение КАК Значение
	|ПОМЕСТИТЬ УУ
	|ИЗ
	|	РегистрСведений.УниверсальныеСопоставления КАК УниверсальныеСопоставления
	|ГДЕ
	|	УниверсальныеСопоставления.Ключ В(&СписокКлючей)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВнутренниеДокументы.Ссылка КАК Уведомление
	|ПОМЕСТИТЬ т
	|ИЗ
	|	Справочник.ВнутренниеДокументы.ДополнительныеРеквизиты КАК ВнутренниеДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ УУ КАК УУ
	|		ПО (УУ.Ключ = ""ВидДокумента_УведомлениеДоговорДУ_ФЛ"")
	|			И (УУ.Значение ССЫЛКА Справочник.ВидыВнутреннихДокументов)
	|			И (УУ.Значение = ВнутренниеДокументы.Ссылка.ВидДокумента)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ УУ КАК УУ1
	|		ПО (УУ1.Ключ = ""ПВХ_ВидУведомленияДУ"")
	|			И (УУ1.Значение = ВнутренниеДокументы.Свойство)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ УУ КАК УУ2
	|		ПО (УУ2.Ключ = ""ВидУведомленияДУ_ВыводЧастиАктивов"")
	|			И (УУ2.Значение = ВнутренниеДокументы.Значение)
	|ГДЕ
	|	НЕ ВнутренниеДокументы.Ссылка.ПометкаУдаления
	|	И ВнутренниеДокументы.Ссылка.ДатаСоздания > ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), МЕСЯЦ, -1)
	|	И ВнутренниеДокументы.Ссылка.РезультатПодписания = ЗНАЧЕНИЕ(Перечисление.РезультатыПодписания.Подписан)
	|	И НЕ ВнутренниеДокументы.Ссылка.НеДействует
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВизыСогласования.Документ КАК Документ,
	|	ВизыСогласования.Комментарий КАК Комментарий
	|ПОМЕСТИТЬ Визы
	|ИЗ
	|	Справочник.ВизыСогласования КАК ВизыСогласования
	|ГДЕ
	|	ВизыСогласования.Комментарий ПОДОБНО &Шаблон1
	|	И ВизыСогласования.Комментарий ПОДОБНО &Шаблон2
	|	И ВизыСогласования.Документ В
	|			(ВЫБРАТЬ
	|				т.Уведомление КАК Уведомление
	|			ИЗ
	|				т КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязиДокументов.Документ КАК Договор,
	|	СвязиДокументов.СвязанныйДокумент.РегистрационныйНомер КАК РегистрационныйНомер,
	|	СвязиДокументов.СвязанныйДокумент.ДатаРегистрации КАК ДатаРегистрации,
	|	СвязиДокументов.СвязанныйДокумент.Сумма КАК Сумма,
	|	СвязиДокументов.СвязанныйДокумент.Валюта.Наименование КАК НаименованиеВалюты,
	|	СвязиДокументов.СвязанныйДокумент.Контрагент КАК Контрагент,
	|	СвязиДокументов.СвязанныйДокумент.ПодписанЭП КАК ПодписанЭП,
	|	СвязиДокументов.СвязанныйДокумент КАК Уведомление,
	|	ЕСТЬNULL(ВнутренниеДокументыДополнительныеРеквизиты.Значение, """") КАК ТипДУ,
	|	ЕСТЬNULL(Визы.Комментарий, """") КАК КомментарийПереводДС
	|ИЗ
	|	РегистрСведений.СвязиДокументов КАК СвязиДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВнутренниеДокументы.ДополнительныеРеквизиты КАК ВнутренниеДокументыДополнительныеРеквизиты
	|		ПО СвязиДокументов.Документ = ВнутренниеДокументыДополнительныеРеквизиты.Ссылка
	|			И (ВнутренниеДокументыДополнительныеРеквизиты.Свойство В
	|				(ВЫБРАТЬ
	|					УУ.Значение КАК Значение
	|				ИЗ
	|					УУ КАК УУ
	|				ГДЕ
	|					УУ.Ключ = ""ПВХ_ТипДУ""))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Визы КАК Визы
	|		ПО СвязиДокументов.СвязанныйДокумент = Визы.Документ
	|ГДЕ
	|	СвязиДокументов.ТипСвязи В
	|			(ВЫБРАТЬ
	|				УУ.Значение КАК Значение
	|			ИЗ
	|				УУ КАК УУ
	|			ГДЕ
	|				УУ.Ключ = ""ТипСвязи_ИмеетУведомление"")
	|	И СвязиДокументов.Документ.ВидДокумента В
	|			(ВЫБРАТЬ
	|				УУ.Значение КАК Значение
	|			ИЗ
	|				УУ КАК УУ
	|			ГДЕ
	|				УУ.Ключ = ""ВидДокумента_ДоговорДУ_ФЛ"")
	|	И СвязиДокументов.СвязанныйДокумент В
	|			(ВЫБРАТЬ
	|				т.Уведомление КАК Уведомление
	|			ИЗ
	|				т КАК т)
	|	И НЕ ЕСТЬNULL(ВнутренниеДокументыДополнительныеРеквизиты.Значение, """") В
	|				(ВЫБРАТЬ
	|					УУ.Значение КАК Значение
	|				ИЗ
	|					УУ КАК УУ
	|				ГДЕ
	|					УУ.Ключ = ""ДопЗнч_ТипДУ_Розничное"")";
	
	Поручения.Очистить();
	
	ВыборкаВн = ЗапросВн.Execute().Select();
	Пока ВыборкаВн.Next() Цикл
		
		UIDПоручения = ПолучитьСтроковыйUUID(ВыборкаВн.Уведомление);
		
		Строки = Данные.НайтиСтроки(Новый Структура("UIDПоручения", UIDПоручения));
		Если Строки.Количество() = 0 Тогда
			НоваяСтрока = Поручения.Добавить();
			НоваяСтрока.UIDПоручения = UIDПоручения;
			НоваяСтрока.UIDДоговораДУ = ПолучитьСтроковыйUUID(ВыборкаВн.Договор);;
			НоваяСтрока.ДоговорДУ = РегистрыСведений.ОбъектыИнтегрированныеС1СДокументооборотом.СсылкаНаОбъектПоДаннымДокументооборота(НоваяСтрока.UIDДоговораДУ,
				"DMInternalDocument", Тип("СправочникСсылка.ДоговорДУ"));
			
			Если ЗначениеЗаполнено(ВыборкаВн.ДатаРегистрации) Тогда
				НоваяСтрока.Дата = ВыборкаВн.ДатаРегистрации;
			Иначе
				НоваяСтрока.Дата = ТекущаяДатаСеанса();
			КонецЕсли;
			
			НоваяСтрока.Сумма = ВыборкаВн.Сумма;
			НоваяСтрока.ВалютаДокумента = Справочники.Валюты.НайтиПоНаименованию(ВыборкаВн.НаименованиеВалюты, Истина);
			Если НоваяСтрока.ВалютаДокумента = Справочники.Валюты.RUB Тогда
				НоваяСтрока.КурсВзаиморасчетов = 1;
				НоваяСтрока.КратностьВзаиморасчетов = 1;
			Иначе
				КурсКратность = МодульВалютногоУчета.ПолучитьКурсВалютыПоПортфелю(НоваяСтрока.ДоговорДУ, НоваяСтрока.ВалютаДокумента, НоваяСтрока.Дата);
				
				НоваяСтрока.КурсВзаиморасчетов = КурсКратность.Курс;
				НоваяСтрока.КратностьВзаиморасчетов = КурсКратность.Кратность;
			КонецЕсли;
			
			НоваяСтрока.ВходящаяДата = ВыборкаВн.ДатаРегистрации;
			НоваяСтрока.ВходящийНомер = ВыборкаВн.РегистрационныйНомер;
			
			НоваяСтрока.ПодписанЭП = ВыборкаВн.ПодписанЭП;
			Если ВыборкаВн.ПодписанЭП = Истина Тогда
				НоваяСтрока.СпособПодачиПоручения = Перечисления.СпособыПодачиПоручения.ЭлектронныйДокумент;
				НоваяСтрока.ДокументЗарегистрировал = "Не применимо";
			Иначе
				НоваяСтрока.СпособПодачиПоручения = Перечисления.СпособыПодачиПоручения.БумажныйНосительОригинал;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаВн.КомментарийПереводДС) Тогда
				НоваяСтрока.КомментарийПереводДС = ВыборкаВн.КомментарийПереводДС;
				НоваяСтрока.МеждуДоговорамиДУ = Истина;
				НоваяСтрока.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("АО ВИМ Инвестиции", Истина);
				
				ПозицияНачало = СтрНайти(ВыборкаВн.КомментарийПереводДС, " в ДУ") + 5;
				Если ПозицияНачало > 0 Тогда
					ПозицияКонец = СтрНайти(ВыборкаВн.КомментарийПереводДС, " ",, ПозицияНачало);
					НомерДоговора = СокрЛП(Сред(ВыборкаВн.КомментарийПереводДС, ПозицияНачало, ПозицияКонец - ПозицияНачало));
					
					Если ЗначениеЗаполнено(НомерДоговора) Тогда
						НоваяСтрока.ДоговорДУ_Получатель = Справочники.ДоговорДУ.НайтиПоРеквизиту("Префикс", НомерДоговора);
					КонецЕсли;
				КонецЕсли;
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	БанковскиеСчета.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.БанковскиеСчета КАК БанковскиеСчета
				|ГДЕ
				|	БанковскиеСчета.Наименование ПОДОБНО &Наименование
				|	И БанковскиеСчета.ВалютаДенежныхСредств = &Валюта
				|	И НЕ БанковскиеСчета.ПометкаУдаления
				|	И БанковскиеСчета.ДоговорДУ = &ДоговорДУ";
				
				Запрос.УстановитьПараметр("ДоговорДУ", НоваяСтрока.ДоговорДУ_Получатель);
				Запрос.УстановитьПараметр("Валюта", НоваяСтрока.ВалютаДокумента);
				Запрос.УстановитьПараметр("Наименование", "%Центральный%");
				
				РезультатЗапроса = Запрос.Выполнить();
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Если ВыборкаДетальныеЗаписи.Следующий() Тогда
					НоваяСтрока.СчетКонтрагента = ВыборкаДетальныеЗаписи.Ссылка;
				КонецЕсли;
				
			Иначе
				НоваяСтрока.UIDКонтрагента = ПолучитьСтроковыйUUID(ВыборкаВн.Контрагент);
				НоваяСтрока.Контрагент = РегистрыСведений.ОбъектыИнтегрированныеС1СДокументооборотом.СсылкаНаОбъектПоДаннымДокументооборота(НоваяСтрока.UIDКонтрагента,
					"DMCorrespondent", Тип("СправочникСсылка.Контрагенты"));
					
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	БанковскиеСчета.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.БанковскиеСчета КАК БанковскиеСчета
				|ГДЕ
				|	БанковскиеСчета.Владелец = &Владелец
				|	И БанковскиеСчета.ДоговорДУ = &ДоговорДУ
				|	И БанковскиеСчета.ВалютаДенежныхСредств = &Валюта
				|	И НЕ БанковскиеСчета.ПометкаУдаления";
				
				Запрос.УстановитьПараметр("Владелец", НоваяСтрока.Контрагент);
				Запрос.УстановитьПараметр("Валюта", НоваяСтрока.ВалютаДокумента);
				Запрос.УстановитьПараметр("ДоговорДУ", НоваяСтрока.ДоговорДУ);
				
				РезультатЗапроса = Запрос.Выполнить();
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Если ВыборкаДетальныеЗаписи.Следующий() Тогда
					НоваяСтрока.СчетКонтрагента = ВыборкаДетальныеЗаписи.Ссылка;
				Иначе
					Запрос.Текст = 
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	БанковскиеСчета.Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.БанковскиеСчета КАК БанковскиеСчета
					|ГДЕ
					|	БанковскиеСчета.Владелец = &Владелец
					|	И БанковскиеСчета.ВалютаДенежныхСредств = &Валюта
					|	И НЕ БанковскиеСчета.ПометкаУдаления";
					
					РезультатЗапроса = Запрос.Выполнить();
					ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
					
					Если ВыборкаДетальныеЗаписи.Следующий() Тогда
						НоваяСтрока.СчетКонтрагента = ВыборкаДетальныеЗаписи.Ссылка;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	АналитическиеСчета.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.АналитическиеСчета КАК АналитическиеСчета
			|ГДЕ
			|	АналитическиеСчета.ДоговорДУ = &ДоговорДУ
			|	И АналитическиеСчета.Наименование ПОДОБНО &Наименование
			|	И АналитическиеСчета.МестоХранения.ВалютаДенежныхСредств = &Валюта
			|	И АналитическиеСчета.МестоХранения ССЫЛКА Справочник.БанковскиеСчета
			|	И НЕ АналитическиеСчета.ПометкаУдаления";
			
			Запрос.УстановитьПараметр("ДоговорДУ", НоваяСтрока.ДоговорДУ);
			Запрос.УстановитьПараметр("Валюта", НоваяСтрока.ВалютаДокумента);
			Запрос.УстановитьПараметр("Наименование", "%Центральный%");
			
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				НоваяСтрока.АналитическийСчетИсточник = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Поручение.Ссылка КАК Ссылка,
			|	Поручение.АналитическийСчетИсточник КАК АналитическийСчетИсточник,
			|	Поручение.СчетКонтрагента КАК СчетКонтрагента
			|ИЗ
			|	Документ.Поручение КАК Поручение
			|ГДЕ
			|	Поручение.Проведен
			|	И НЕ Поручение.ПометкаУдаления
			|	И Поручение.ДоговорДУ = &ДоговорДУ
			|	И Поручение.Дата < &Дата
			|	И Поручение.ВидОперации = &ВидОперации
			|	И Поручение.МеждуДоговорамиДУ = &МеждуДоговорамиДУ
			|	И Поручение.ВалютаДокумента = &Валюта
			|
			|УПОРЯДОЧИТЬ ПО
			|	Поручение.МоментВремени УБЫВ";
			
			Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийПоручение.ВыводИзДУ);
			Запрос.УстановитьПараметр("ДоговорДУ", НоваяСтрока.ДоговорДУ);
			Запрос.УстановитьПараметр("Дата", НоваяСтрока.Дата);
			Запрос.УстановитьПараметр("МеждуДоговорамиДУ", НоваяСтрока.МеждуДоговорамиДУ);
			Запрос.УстановитьПараметр("Валюта", НоваяСтрока.ВалютаДокумента);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				НоваяСтрока.АналитическийСчетИсточник = ВыборкаДетальныеЗаписи.АналитическийСчетИсточник;
				НоваяСтрока.СчетКонтрагента = ВыборкаДетальныеЗаписи.СчетКонтрагента;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура СоздатьПоручения(ЕстьОшибки, ЕстьПредупреждения) Экспорт
	
	Если ЕстьОшибки Тогда Возврат; КонецЕсли;
	
	Для каждого ТекПоручение Из Поручения Цикл
	
		ДокументОбъект = Документы.Поручение.СоздатьДокумент();
		ДокументОбъект.Дата = ТекПоручение.Дата;
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоручение.ВыводИзДУ;
		ДокументОбъект.ДоговорДУ = ТекПоручение.ДоговорДУ;
		ДокументОбъект.СуммаДС = ТекПоручение.Сумма;
		ДокументОбъект.ВалютаДокумента = ТекПоручение.ВалютаДокумента;
		ДокументОбъект.КурсВзаиморасчетов = ТекПоручение.КурсВзаиморасчетов;
		ДокументОбъект.КратностьВзаиморасчетов = ТекПоручение.КратностьВзаиморасчетов;
		ДокументОбъект.СпособПодачиПоручения = ТекПоручение.СпособПодачиПоручения;
		ДокументОбъект.ВходящийНомер = ТекПоручение.ВходящийНомер;
		ДокументОбъект.ВходящаяДата = ТекПоручение.ВходящаяДата;
		
		Если ТекПоручение.ПодписанЭП = Истина Тогда
			ДокументОбъект.ДокументЗарегистрировал = ТекПоручение.ДокументЗарегистрировал;
		КонецЕсли;
		
		ДокументОбъект.МеждуДоговорамиДУ = ТекПоручение.МеждуДоговорамиДУ;
		ДокументОбъект.Контрагент = ТекПоручение.Контрагент;
		ДокументОбъект.СчетКонтрагента = ТекПоручение.СчетКонтрагента;
		
		Если ТекПоручение.МеждуДоговорамиДУ = Истина Тогда
			ДокументОбъект.ДоговорДУ_Получатель = ТекПоручение.ДоговорДУ_Получатель;
		КонецЕсли;
		
		ДокументОбъект.АналитическийСчетИсточник = ТекПоручение.АналитическийСчетИсточник;
		ДокументОбъект.Ответственный = Справочники.Пользователи.НайтиПоНаименованию("svc_avancore", Истина);
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ДобавитьСвязь(ТекПоручение.UIDПоручения, "DMInternalDocument", ДокументОбъект.Ссылка);
			ТекПоручение.Поручение = ДокументОбъект.Ссылка;
			ДобавитьТекст("Создан и проведен документ " + ДокументОбъект.Ссылка);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			
			ЗаписьЖурналаРегистрации(
				"Дополнительные отчеты и обработки." + Метаданные().Представление(),
				УровеньЖурналаРегистрации.Ошибка,,,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("При проведении Поручение ДС по Договору ДУ %1 произошла ошибка: %2", ТекПоручение.ДоговорДУ, ТекстОшибки)
			);
			
			ОповещениеОХодеОбмена("При проведении Поручение ДС по Договору ДУ '" + ТекПоручение.ДоговорДУ + "' произошла ошибка! Описание ошибки: " + ТекстОшибки, Истина);
			ЕстьОшибки = Истина;
			ДобавитьТекст("При проведении Поручение ДС по Договору ДУ '" + ТекПоручение.ДоговорДУ + "' произошла ошибка! Описание ошибки: " + ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Процедура УстановитьСоединениеДО(Отказ)
	
	ВнешБаза = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединение(БазаДО);
	
	Если НЕ ВнешБаза.ПодробноеОписаниеОшибки = "" тогда
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Произошла ошибка при попытке подключения к внешней ИБ! Описание ошибки: " + ВнешБаза.ПодробноеОписаниеОшибки
		);
		
		ОповещениеОХодеОбмена(ВнешБаза.ПодробноеОписаниеОшибки, Истина);
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	Синхронизатор = ВнешБаза.Соединение.Справочники.Пользователи.НайтиПоНаименованию(ИМЯ_ПОЛЬЗОВАТЕЛЯ_СИНХРОНИЗАТОРА);
	Если Синхронизатор.Пустая() Тогда
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Пользователь синхронизации: " + ИМЯ_ПОЛЬЗОВАТЕЛЯ_СИНХРОНИЗАТОРА + " не найден во внешней базе!"
		);
		
		ОповещениеОХодеОбмена("Пользователь синхронизации: "+ИМЯ_ПОЛЬЗОВАТЕЛЯ_СИНХРОНИЗАТОРА + " не найден в базе документооборота", Истина);
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	ОповещениеОХодеОбмена("" + ТекущаяДата() + " Соединение с ДО установлено");
КонецПроцедуры // УстановитьСоединениеДО()

Процедура ПрочитатьДанныеДО(Знач ВнешКонтрагенты, Знач ВнешДоговоры = Неопределено)
	Перем Запрос, Пакет;
	Перем ВыборкаКонтрагентов, ВыборкаДокументов, ВыборкаДоговоров, ВыборкаБанкСчетов;
	
	Если ВнешДоговоры = Неопределено Тогда
		ВнешДоговоры = ВнешБаза.Соединение.NewObject("Массив");
	КонецЕсли;
	
	ЭтотОбъект.Договоры.Очистить();
	ЭтотОбъект.СписокКонтрагентов.Очистить();
	ЭтотОбъект.ДокументыФизиков.Очистить();
	ЭтотОбъект.БанковскиеСчета.Очистить();
	
	Запрос = ВнешБаза.Соединение.NewObject("Запрос");
	Запрос.УстановитьПараметр("Исполнитель", Синхронизатор);
	Запрос.УстановитьПараметр("СписокКонтрагентов", ВнешКонтрагенты);
	Запрос.УстановитьПараметр("СписокДоговоров", ВнешДоговоры);
#Область ЗапросДО
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.КонтрагентСсылка КАК КонтрагентСсылка,
	|	ВложенныйЗапрос.ИНН КАК ИНН,
	|	ВложенныйЗапрос.КПП КАК КПП,
	|	ВложенныйЗапрос.НаименованиеПолное КАК НаименованиеПолное,
	|	ВложенныйЗапрос.Наименование КАК Наименование,
	|	ВложенныйЗапрос.ЭтоФизик КАК ЭтоФизик,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ВложенныйЗапрос.КонтрагентСсылка.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				ТОГДА ЕСТЬNULL(РегАдресФЛ.Представление, """")
	|			ИНАЧЕ ЕСТЬNULL(ЮрАдрес.Представление, """")
	|		КОНЕЦ КАК СТРОКА(500)) КАК ЮридическийАдрес,
	|	ПОДСТРОКА(ВЫБОР
	|			КОГДА ВложенныйЗапрос.КонтрагентСсылка.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				ТОГДА ЕСТЬNULL(РегАдресФЛ.ЗначенияПолей, """")
