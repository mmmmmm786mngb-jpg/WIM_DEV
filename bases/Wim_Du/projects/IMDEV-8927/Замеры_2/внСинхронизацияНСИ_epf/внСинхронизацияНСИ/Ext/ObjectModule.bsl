	КЕШ = Новый Структура();
	КЕШ.Вставить("Валюты", Новый Соответствие());
	КЕШ.Вставить("Сопоставления", Новый Соответствие());
	КЕШ.Вставить("Контрагенты", Новый Соответствие());
	КЕШ.Вставить("Организации", Новый Соответствие());
	КЕШ.Вставить("Reporting", Новый Соответствие());
	
