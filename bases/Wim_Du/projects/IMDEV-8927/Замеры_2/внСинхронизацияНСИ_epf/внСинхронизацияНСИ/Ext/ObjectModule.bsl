Функция НайтиДополнительныйРеквизитКонтрагента(Знач Наименование, Знач Принадлежность)
	Перем Запрос, Выборка;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Принадлежность", Принадлежность);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДополнительныеРеквизиты.Ссылка КАК Реквизит
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизиты
	|ГДЕ
	|	ДополнительныеРеквизиты.Наименование = &Наименование
	|	И НЕ ДополнительныеРеквизиты.ЭтоДополнительноеСведение
	|	И 1 В
	|			(ВЫБРАТЬ
	|				1
	|			ИЗ
	|				Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитов
	|			ГДЕ
	|				НаборыДополнительныхРеквизитов.Свойство = ДополнительныеРеквизиты.Ссылка
	|				И НаборыДополнительныхРеквизитов.Ссылка = &Принадлежность)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реквизит";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
