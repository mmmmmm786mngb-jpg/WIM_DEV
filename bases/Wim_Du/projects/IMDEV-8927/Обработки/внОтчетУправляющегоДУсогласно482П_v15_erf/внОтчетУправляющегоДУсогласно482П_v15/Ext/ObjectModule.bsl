			Если ((ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.ВнебиржеваяСделка") И БизнесПроцесс.СделкаЧерезБрокера) 
				Или ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.СделкиTn")) И БизнесПроцесс.НКД <> 0 Тогда
				
				НоваяСтрока = ДанныеРаздела.Обороты.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаИзРезультатаЗапроса);
				
