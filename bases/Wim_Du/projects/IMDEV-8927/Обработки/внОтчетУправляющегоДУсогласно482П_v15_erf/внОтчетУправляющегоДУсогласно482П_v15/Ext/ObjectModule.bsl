Процедура ДобавитьРЕПО_ПФИ(ТабличныйДокумент, Макет)
	
	Если Не ЗагружатьДанныеЕПС Тогда
		Возврат;
	КонецЕсли;
	
	ЗадолженностьПоРЕПО_ЕПС = СтруктураДанныхЕПС.ЗадолженностьПоРЕПО_ЕПС;
	
	Если ЗадолженностьПоРЕПО_ЕПС.Количество() > 0 Тогда
		
		ОбластьШапкаПрочиеАктивы = Макет.ПолучитьОбласть("ШапкаПрочиеАктивы");
		ОбластьСтрокаПрочиеАктивы = Макет.ПолучитьОбласть("СтрокаПрочиеАктивы");
		ОбластьИтогоПрочиеАктивы = Макет.ПолучитьОбласть("ИтогоПрочиеАктивы");
		
		ТабличныйДокумент.Вывести(ОбластьШапкаПрочиеАктивы);
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидЗадолженности", "Обратное_РЕПО");
		
		НайденныеСтроки = ЗадолженностьПоРЕПО_ЕПС.НайтиСтроки(ПараметрыОтбора); 
		
		Для каждого Строка Из НайденныеСтроки Цикл
			ОбластьСтрокаПрочиеАктивы.Параметры.Заполнить(Строка);
			ТабличныйДокумент.Вывести(ОбластьСтрокаПрочиеАктивы);
		КонецЦикла;
		
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидЗадолженности", "Прямое_РЕПО");
		
		НайденныеСтроки = ЗадолженностьПоРЕПО_ЕПС.НайтиСтроки(ПараметрыОтбора); 
		
		Для каждого Строка Из НайденныеСтроки Цикл
			ОбластьСтрокаПрочиеАктивы.Параметры.Заполнить(Строка);
			ТабличныйДокумент.Вывести(ОбластьСтрокаПрочиеАктивы);
		КонецЦикла;
		
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидЗадолженности", "ПФИ_Прибыль");
		
		НайденныеСтроки = ЗадолженностьПоРЕПО_ЕПС.НайтиСтроки(ПараметрыОтбора); 
		
		Для каждого Строка Из НайденныеСтроки Цикл
			ОбластьСтрокаПрочиеАктивы.Параметры.Заполнить(Строка);
			ТабличныйДокумент.Вывести(ОбластьСтрокаПрочиеАктивы);
		КонецЦикла;
		
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидЗадолженности", "ПФИ_Убыток");
		
		НайденныеСтроки = ЗадолженностьПоРЕПО_ЕПС.НайтиСтроки(ПараметрыОтбора); 
		
		Для каждого Строка Из НайденныеСтроки Цикл
			ОбластьСтрокаПрочиеАктивы.Параметры.Заполнить(Строка);
			ТабличныйДокумент.Вывести(ОбластьСтрокаПрочиеАктивы);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьДанныеЕПС(ДоговорДУ)
	
	Если Не ЗагружатьДанныеЕПС Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПодключения = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединение(ВнешняяИБ);
	
	Если СтруктураПодключения.Соединение = Неопределено Тогда
		Сообщить(СтруктураПодключения.ПодробноеОписаниеОшибки);
	Иначе
		ВнешнееСоединение = СтруктураПодключения.Соединение;
		
		Портфель = ВнешнееСоединение.Справочники.Портфели.НайтиПоКоду(СокрЛП(ДоговорДУ.Код));
		
		Если Не ЗначениеЗаполнено(Портфель.Code) Тогда
			Сообщить("Во внешней базе" + ВнешняяИБ + " не найден портфель с номером " + СокрЛП(ДоговорДУ.Код) + "!");
			Возврат;
		КонецЕсли;
		
		#Область Портфель_ДенежныеСредства
		
		ТаблицаЗадолженностейПоРЕПО = Новый ТаблицаЗначений;
		
		ТаблицаЗадолженностейПоРЕПО.Колонки.Добавить("ВидЗадолженности");
		ТаблицаЗадолженностейПоРЕПО.Колонки.Добавить("ПрочиеАктивы");
		ТаблицаЗадолженностейПоРЕПО.Колонки.Добавить("Сумма");
		ТаблицаЗадолженностейПоРЕПО.Колонки.Добавить("Валюта");
		ТаблицаЗадолженностейПоРЕПО.Колонки.Добавить("СуммаПоКурсу");
		ТаблицаЗадолженностейПоРЕПО.Колонки.Добавить("КурсЦБ");
		
		ТаблицаЗадолженностейПоРЕПО.Индексы.Добавить("ВидЗадолженности");
		
		#Область ОбратноеПрямоеПФИ
		
		ТекстЗапроса = "ВЫБРАТЬ
		|	ЕПСОстатки.ВалютнаяСуммаОстаток КАК СуммаПрибыль,
		|	0 КАК СуммаУбыток,
		|	0 КАК СуммаРЕПОПрямое,
		|	0 КАК СуммаРЕПОобратное,
		|	ЕСТЬNULL(ЕПСОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.RUB)) КАК Валюта
		|ИЗ
		|	РегистрБухгалтерии.ЕПС.Остатки(&Дата, Счет = ЗНАЧЕНИЕ(ПланСчетов.ЕПС.ЦенныеБумаги_52601), , Портфель = &Портфель) КАК ЕПСОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	ЕПСОстатки.ВалютнаяСуммаОстаток,
		|	0,
		|	0,
		|	ЕСТЬNULL(ЕПСОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.RUB)) КАК Валюта
		|ИЗ
		|	РегистрБухгалтерии.ЕПС.Остатки(&Дата, Счет = ЗНАЧЕНИЕ(ПланСчетов.ЕПС.ЦенныеБумаги_52602), , Портфель = &Портфель) КАК ЕПСОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	0,
		|	ЕПСОстатки.ВалютнаяСуммаОстаток,
		|	0,
		|	ЕСТЬNULL(ЕПСОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.RUB)) КАК Валюта
		|ИЗ
		|	РегистрБухгалтерии.ЕПС.Остатки(&Дата, Счет В (&СчетаЕПСПрямогоРЕПО), , Портфель = &Портфель) КАК ЕПСОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	0,
		|	0,
		|	ЕПСОстатки.ВалютнаяСуммаОстаток,
		|	ЕСТЬNULL(ЕПСОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.RUB)) КАК Валюта
		|ИЗ
		|	РегистрБухгалтерии.ЕПС.Остатки(&Дата, Счет В (&СчетаЕПСОбратногоРЕПО), , Портфель = &Портфель) КАК ЕПСОстатки";
		
		Запрос = ВнешнееСоединение.NewObject("Запрос", ТекстЗапроса);
