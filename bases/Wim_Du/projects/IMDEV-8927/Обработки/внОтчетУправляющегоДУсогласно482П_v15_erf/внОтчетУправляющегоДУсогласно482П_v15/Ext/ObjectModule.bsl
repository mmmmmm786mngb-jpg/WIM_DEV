	Если ПоставкаПротивПлатежа Тогда
		Для Каждого СтрокаОбороты Из ДанныеРаздела.Обороты Цикл
			
			ДатаПеререгистрации = ПолучитьДатуПеререгистрацииВнебиржиПоставкаПротивПлатежа(СтрокаОбороты);
			Если ЗначениеЗаполнено(ДатаПеререгистрации) Тогда
				СтрокаОбороты.Дата = ДатаПеререгистрации;	
			КонецЕсли;	
			
		КонецЦикла; 
	КонецЕсли;
	// -- IMAPPS-24743 Чижов В.В. 13.02.2024
	
	ДанныеРаздела.Обороты.Сортировать("Дата, Регистратор");
	// TM-3253 }
	
	Возврат ДанныеРаздела;
	
