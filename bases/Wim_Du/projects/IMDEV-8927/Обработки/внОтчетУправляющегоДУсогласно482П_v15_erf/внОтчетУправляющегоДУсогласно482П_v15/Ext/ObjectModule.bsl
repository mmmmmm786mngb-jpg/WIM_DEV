	//ОбластьИтогоКорпОблигации.Параметры.РыночнаяОценкаUSD 			= ИпОблРыночнаяСуммаUSDИтог;
	ОбластьИтогоКорпОблигации.Параметры.РыночнаяОценкаRUR 			= ИпОблРыночнаяСуммаRURИтог;
	ОбластьИтогоКорпОблигации.Параметры.НКДСумма 					= ИпОблУпрНКДИтог;
	
