						ЭтоПоследняяСтрока = НПП = ВсегоСтрок; // TM-3208
					КонецЕсли;
					//}IMAPPS-18836

				
				НПП = НПП + 1;
				
				ОбластьСтрокаДДС.Параметры.НПП       = НПП;
				ОбластьСтрокаДДС.Параметры.Дата      = СтрокаОбороты.Дата;
				ОбластьСтрокаДДС.Параметры.КодСделки = КодСделки;
				ОбластьСтрокаДДС.Параметры.Основание = СокрЛП(НаименованиеОснования(Расход.Ключ.Наименование));
				ОбластьСтрокаДДС.Параметры.Сумма     = -Расход.Значение;
				
				Если PDF Тогда
					ЭтоПоследняяСтрока = НПП = ВсегоСтрок;    
					//ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаДДС, ОбластьСтрокаДДС, ЭтоПоследняяСтрока);
					ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаДДС, ОбластьСтрокаДДС, ЭтоПоследняяСтрока, СтруктураОтчета);//IMAPPS-21832
				Иначе
					ТабличныйДокумент.Вывести(ОбластьСтрокаДДС);
					ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь); //IMAPPS-21832
				КонецЕсли;
				
			КонецЦикла;			
			НПП = НПП + 1;
			
		КонецЦикла; 
		
		ОбластьИсходящийДО.Параметры.Валюта = СтрокаТаблицыЗначений.ВалютаПредставление;
		
		СуммаКонечныйОстаток = 0;
		
		НайденныеОстатки = ОстаткиКонецПериода.НайтиСтроки(ОтборБанковскийСчет);
		
		Если НайденныеОстатки.Количество() > 0 Тогда		
			СуммаКонечныйОстаток = НайденныеОстатки[0].Сумма;		
		КонецЕсли; 
		
		ОбластьИсходящийДО.Параметры.Сумма = СуммаКонечныйОстаток;
		
		Если PDF Тогда
			Если НЕ ОбластьСтрокаДДС = Неопределено И ОбластьСтрокаДДС.Параметры.Сумма = Неопределено Тогда
				//ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаДДС, ОбластьИсходящийДО, Неопределено);  // TM-3208 
				ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаДДС, ОбластьИсходящийДО, Неопределено, СтруктураОтчета);  // TM-3208 IMAPPS-21832
			Иначе 
				//ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаДДС, ОбластьИсходящийДО, ОбластьСтрокаДДС);  // TM-3208 
				ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаДДС, ОбластьИсходящийДО, ОбластьСтрокаДДС, СтруктураОтчета);  // TM-3208 IMAPPS-21832
			КонецЕсли;
		Иначе
			ТабличныйДокумент.Вывести(ОбластьИсходящийДО);
			ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь); //IMAPPS-21832
		КонецЕсли;
		
	КонецЦикла; 
	
	ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Истина, Ложь); //IMAPPS-21832
	
КонецПроцедуры

Процедура ЗаполнитьРаздел5Общая(СтруктураОтчета, Макет, ДанныеРаздела, ТипФайла)
	
	PDF = ТипФайла = "pdf";
	
	ДатаНачалаПредставление 	= Формат(ДатаНачала, "ДФ=dd.MM.yyyy");
	ДатаОкончанияПредставление 	= Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	ОбластьЗаголовокДвижениеЦБ 		= Макет.ПолучитьОбласть("ЗаголовокДвижениеЦБ");
	ОбластьШапкаДвижениеЦБ 			= Макет.ПолучитьОбласть("ШапкаДвижениеЦБ");
	ОбластьСтрокаДвижениеДС 		= Макет.ПолучитьОбласть("СтрокаДвижениеДС");
	ОбластьВходящийЦБ 				= Макет.ПолучитьОбласть("ВходящийЦБ");
	ОбластьИсходящийЦБ 				= Макет.ПолучитьОбласть("ИсходящийЦБ");
	
	ОбластьЗаголовокДвижениеЦБ.Параметры.НачалоПериода = ДатаНачалаПредставление;
	ОбластьЗаголовокДвижениеЦБ.Параметры.КонецПериода = ДатаОкончанияПредставление;
	
	Если PDF Тогда
		ТабличныйДокумент = СтруктураОтчета.РазделPDF5;
		
		ОбластьЧертаКолонтитула		= Макет.ПолучитьОбласть("ЧертаКолонтитула");
		ТабличныйДокумент.Вывести(ОбластьЧертаКолонтитула);
	Иначе
		ТабличныйДокумент = СтруктураОтчета.Раздел5;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокДвижениеЦБ);
	
	ДвиженияЦБ = ДанныеРаздела.ДвиженияЦБ;
	Активы = ДанныеРаздела.Активы;
	ОстаткиНаНачало = ДанныеРаздела.ОстаткиНаНачало;
	ОстаткиНаКонец = ДанныеРаздела.ОстаткиНаКонец;
	
	ТабличныйДокумент.Вывести(ОбластьШапкаДвижениеЦБ);
	
	Для Каждого СтрокаТаблицыАктивов Из Активы Цикл
		
		ОтборАктив = Новый Структура("Актив", СтрокаТаблицыАктивов.Актив);
		НайденныеОстатки = ОстаткиНаНачало.НайтиСтроки(ОтборАктив);
		КоличествоНачальныйОстаток = 0;
		Если НайденныеОстатки.Количество() > 0 Тогда		
			КоличествоНачальныйОстаток = НайденныеОстатки[0].Количество;		
		КонецЕсли; 
		ОбластьВходящийЦБ.Параметры.Количество = КоличествоНачальныйОстаток;
		
		Если PDF Тогда
			//ПроверитьВывестиОбластьРазделШапка(ТабличныйДокумент, ОбластьВходящийЦБ, ОбластьШапкаДвижениеЦБ, Истина); //TM-3169
			ПроверитьВывестиОбластьРазделШапка(ТабличныйДокумент, ОбластьВходящийЦБ, ОбластьШапкаДвижениеЦБ, Истина, СтруктураОтчета); //TM-3169 IMAPPS-21832
		Иначе
			ТабличныйДокумент.Вывести(ОбластьВходящийЦБ);
			ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь); //IMAPPS-21832
		КонецЕсли;
		
		ДвиженияЦБОбороты = ДвиженияЦБ.НайтиСтроки(ОтборАктив);
		
		Счетчик = 0; //TM-3208
		ВсегоСтрок = ДвиженияЦБОбороты.Количество(); //TM-3208
		
		Для Каждого СтрокаТаблицыЗначений Из ДвиженияЦБОбороты Цикл
			
			ОбластьСтрокаДвижениеДС.Параметры.ДатаПеререгистрации = СтрокаТаблицыЗначений.Дата;
			
			ЕстьНомерВыпуска = ЗначениеЗаполнено(СтрокаТаблицыЗначений.НомерВыпуска);
			ЕстьНомерГосРегистрации = ЗначениеЗаполнено(СтрокаТаблицыЗначений.НомерГосРегистрации);
			ЕстьISIN = ЗначениеЗаполнено(СтрокаТаблицыЗначений.ISIN);
			ЕстьВидАктива = ЗначениеЗаполнено(СтрокаТаблицыЗначений.ВидАктива);
			
			// TM-3208, ОснованиеДвиженияЦБ()
			ОбластьСтрокаДвижениеДС.Параметры.Основание = ОснованиеДвиженияЦБ(СтрокаТаблицыЗначений.Документ);
			
			СтрокаЭмитент = "" + СтрокаТаблицыЗначений.ЭмитентПредставление;
			
			Если Не ПустаяСтрока(СтрокаЭмитент) Тогда
				
				Если ЕстьВидАктива Тогда
					СтрокаЭмитент = СтрокаЭмитент + ", " + СтрокаТаблицыЗначений.ВидАктиваПредставление;
				КонецЕсли;
				
			Иначе
				СтрокаЭмитент = СтрокаТаблицыЗначений.ВидАктива;
			КонецЕсли;
			
			Если Не ПустаяСтрока(СтрокаЭмитент) Тогда
				
				Если ЕстьНомерВыпуска Тогда
					СтрокаЭмитент = СтрокаЭмитент + ", " + СтрокаТаблицыЗначений.НомерВыпуска;
				КонецЕсли;
				
			Иначе
				СтрокаЭмитент = СтрокаТаблицыЗначений.НомерВыпуска;
			КонецЕсли;
			
			Если Не ПустаяСтрока(СтрокаЭмитент) Тогда
				
				Если ЕстьНомерГосРегистрации Тогда
					СтрокаЭмитент = СтрокаЭмитент + ", " + СтрокаТаблицыЗначений.НомерГосРегистрации;
				КонецЕсли;
				
			Иначе
				СтрокаЭмитент = СтрокаТаблицыЗначений.НомерГосРегистрации;
			КонецЕсли;	
			
			Если Не ПустаяСтрока(СтрокаЭмитент) Тогда
				
				Если ЕстьISIN Тогда
					СтрокаЭмитент = СтрокаЭмитент + ", " + СтрокаТаблицыЗначений.ISIN;
				КонецЕсли;
				
			Иначе
				СтрокаЭмитент = СтрокаТаблицыЗначений.ISIN;			
			КонецЕсли;	
			
			ОбластьСтрокаДвижениеДС.Параметры.Эмитент 			= СтрокаЭмитент;		
			ОбластьСтрокаДвижениеДС.Параметры.НаименованиеЦБ 	= СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление;
			
			//vtb 05.07.2016
			КоличествоОборот = СтрокаТаблицыЗначений.КоличествоОборот;
			
			ОбластьСтрокаДвижениеДС.Параметры.Количество 		= КоличествоОборот;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыЗначений.НомерСчета) Тогда		
				ОбластьСтрокаДвижениеДС.Параметры.НомерСчетаДепо = СтрокаТаблицыЗначений.НомерСчета;	
			Иначе
				ОбластьСтрокаДвижениеДС.Параметры.НомерСчетаДепо = "";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыЗначений.ДепозитарийНаименование) Тогда		
				//IMAPPS-21832++
				//ОбластьСтрокаДвижениеДС.Параметры.Депозитарий = СтрокаТаблицыЗначений.ДепозитарийНаименование;	
				СноскаТекст = "";
				ДанныеСноски = Неопределено;
				
				Если ЗначениеЗаполнено(СтрокаТаблицыЗначений.Депозитарий) Тогда
					ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(СтрокаТаблицыЗначений.Депозитарий,"Ключ");
					Если ДанныеСноски = Неопределено Тогда
						ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Добавить();
						ДанныеСноски.Ключ = СтрокаТаблицыЗначений.Депозитарий;
						ДанныеСноски.Номер = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Количество();
						ДанныеСноски.Сноска = ПолучитьТекстСноски(ДанныеСноски.Номер);
						ДанныеСноски.ТекстСноски = ДанныеСноски.Сноска + " - " + СтрокаТаблицыЗначений.ДепозитарийНаименованиеПолное;
					КонецЕсли;
					
					СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = ДанныеСноски.Номер;
					СноскаТекст = ДанныеСноски.Сноска;
				КонецЕсли;
				ОбластьСтрокаДвижениеДС.Параметры.Депозитарий = СноскаТекст + СокрЛП(СтрокаТаблицыЗначений.ДепозитарийНаименование);
				//IMAPPS-21832--
				
			ИНаче
				
				ОбластьСтрокаДвижениеДС.Параметры.Депозитарий = "";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыЗначений.ИНН) Тогда		
				ОбластьСтрокаДвижениеДС.Параметры.ИНН = СтрокаТаблицыЗначений.ИНН;	
			Иначе
				ОбластьСтрокаДвижениеДС.Параметры.ИНН = "";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыЗначений.ОГРН) Тогда		
				ОбластьСтрокаДвижениеДС.Параметры.ОГРН = СтрокаТаблицыЗначений.ОГРН;	
			Иначе
				ОбластьСтрокаДвижениеДС.Параметры.ОГРН = "";
			КонецЕсли;
			
			ОбластьСтрокаДвижениеДС.Параметры.Местонахождение = СтрокаТаблицыЗначений.ФактическийАдрес;
			
			ТипОперации = "";
			
			Если ТипЗнч(СтрокаТаблицыЗначений.Документ) = Тип("ДокументСсылка.Сделка") Тогда
				
				ВидОперации = ОбщегоНазначения.ПолучитьЗначениеРеквизита(СтрокаТаблицыЗначений.Документ, "ВидОперации");
				
				Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Поступление") Тогда
					ТипОперации = "Зачисление";
				Иначе
					ТипОперации = "Списание";
				КонецЕсли; 
				
			ИначеЕсли ТипЗнч(СтрокаТаблицыЗначений.Документ) = Тип("ДокументСсылка.ВводВыводЦенныхБумагИзДУ") Тогда
				
				ВидОперации = ОбщегоНазначения.ПолучитьЗначениеРеквизита(СтрокаТаблицыЗначений.Документ, "ВидОперации");
				
				Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийВводВыводАктивовИзДУ.ВводАктивовВДУ") Тогда
					ТипОперации = "Ввод";
				Иначе
					ТипОперации = "Вывод";
				КонецЕсли; 
				
			ИначеЕсли ТипЗнч(СтрокаТаблицыЗначений.Документ) = Тип("ДокументСсылка.СписаниеКоличестваЦенныхБумаг") ИЛИ 
				ТипЗнч(СтрокаТаблицыЗначений.Документ) = Тип("ДокументСсылка.ПогашениеОблигаций")  Тогда
				
				Если СтрокаТаблицыЗначений.КорСчет = ПланыСчетов.Хозрасчетный.ВУРЦБ Тогда
					
					ТипОперации = "Списание";
					
				КонецЕсли; 
				
			ИначеЕсли ТипЗнч(СтрокаТаблицыЗначений.Документ) = Тип("ДокументСсылка.КонвертацияАктивов") Тогда
				
				Если СтрокаТаблицыЗначений.КоличествоОборот > 0 Тогда
					ТипОперации = "Зачисление";
				Иначе
					ТипОперации = "Списание";
				КонецЕсли; 
				
			ИначеЕсли ТипЗнч(СтрокаТаблицыЗначений.Документ) = Тип("ДокументСсылка.ОперацияСАналитическимиСчетами") Тогда
				
				Если СтрокаТаблицыЗначений.КоличествоОборот > 0 Тогда
					ТипОперации = "Зачисление";
				Иначе
					ТипОперации = "Списание";
				КонецЕсли;
				
				//vtb 27.06	
			ИначеЕсли ТипЗнч(СтрокаТаблицыЗначений.Документ) = Тип("ДокументСсылка.ПогашениеОблигаций") Тогда
				ТипОперации = "Списание (Погашение ЦБ)";
				
				// TM-3208
			ИначеЕсли ТипЗнч(СтрокаТаблицыЗначений.Документ) = Тип("ДокументСсылка.СделкаРЕПОПерваяНога") Тогда
				
				ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицыЗначений.Документ, "ВидОперации");
				Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО") Тогда
					ТипОперации = "Зачисление";
				Иначе
					ТипОперации = "Списание";
				КонецЕсли;
				
				// TM-3208
			ИначеЕсли ТипЗнч(СтрокаТаблицыЗначений.Документ) = Тип("ДокументСсылка.СделкаРЕПОВтораяНога") Тогда
				
				ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицыЗначений.Документ, "ВидОперации");
				Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ПрямойРЕПО") Тогда
					ТипОперации = "Зачисление";
				Иначе
					ТипОперации = "Списание";
				КонецЕсли;
				
			КонецЕсли; 
			
			ОбластьСтрокаДвижениеДС.Параметры.ТипОперации = ТипОперации;
			
			Счетчик = Счетчик + 1; // TM-3208
			
			Если PDF Тогда
				ЭтоПоследняяСтрока = Счетчик = ВсегоСтрок;// TM-3208
				//ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаДвижениеЦБ, ОбластьСтрокаДвижениеДС, ЭтоПоследняяСтрока); // TM-3169
				ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаДвижениеЦБ, ОбластьСтрокаДвижениеДС, ЭтоПоследняяСтрока, СтруктураОтчета); // TM-3169 IMAPPS-21832
			Иначе
				ТабличныйДокумент.Вывести(ОбластьСтрокаДвижениеДС);
				ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь); //IMAPPS-21832
			КонецЕсли;
			
		КонецЦикла;
		
		КоличествоИсходящийОстаток = 0;
		НайденныеОстатки = ОстаткиНаКонец.НайтиСтроки(ОтборАктив);
		Если НайденныеОстатки.Количество() > 0 Тогда		
			КоличествоИсходящийОстаток = НайденныеОстатки[0].Количество;		
		КонецЕсли; 
		ОбластьИсходящийЦБ.Параметры.Количество = КоличествоИсходящийОстаток;
		
		Если PDF Тогда
			//ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаДвижениеЦБ, ОбластьИсходящийЦБ, ОбластьСтрокаДвижениеДС); // TM-3208
			ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаДвижениеЦБ, ОбластьИсходящийЦБ, ОбластьСтрокаДвижениеДС, СтруктураОтчета); // TM-3208 IMAPPS-21832
		Иначе
			ТабличныйДокумент.Вывести(ОбластьИсходящийЦБ);
			ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь); //IMAPPS-21832
		КонецЕсли;
		
	конецЦикла;
	
	ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Истина, Ложь); //IMAPPS-21832
	
КонецПроцедуры

Процедура ЗаполнитьРаздел61Общая(СтруктураОтчета, Макет, ДанныеРаздела, ТипФайла)
	
	PDF = ТипФайла = "pdf";
	
	ДатаНачалаПредставление 	= Формат(ДатаНачала, "ДФ=dd.MM.yyyy");
	ДатаОкончанияПредставление 	= Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	ОбластьЗаголовокРасходыУправляющего 		= Макет.ПолучитьОбласть("ЗаголовокРасходыУправляющего");
	ОбластьТаблицаРасходыУправляющего 			= Макет.ПолучитьОбласть("ТаблицаРасходыУправляющего");
	ОбластьЗаголовокОбязательства				= Макет.ПолучитьОбласть("ЗаголовокОбязательства");
	ОбластьШапкаТаблицыОбязательства			= Макет.ПолучитьОбласть("ШапкаТаблицыОбязательства");
	ОбластьСтрокаТаблицыОбязательств			= Макет.ПолучитьОбласть("СтрокаТаблицыОбязательств");
	ОбластьИтогоТаблицыОбязательства			= Макет.ПолучитьОбласть("ИтогоТаблицыОбязательства");
	
	Если PDF Тогда
		ТабличныйДокумент = СтруктураОтчета.РазделPDF6_1;
		
		ОбластьЧертаКолонтитула             	= Макет.ПолучитьОбласть("ЧертаКолонтитула");
		ТабличныйДокумент.Вывести(ОбластьЧертаКолонтитула);
	Иначе
		ТабличныйДокумент = СтруктураОтчета.Раздел6_1;
	КонецЕсли;
	
	ОбластьЗаголовокРасходыУправляющего.Параметры.НачалоПериода = ДатаНачалаПредставление;
	ОбластьЗаголовокРасходыУправляющего.Параметры.КонецПериода = ДатаОкончанияПредставление;
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокРасходыУправляющего);
	
	ОбластьТаблицаРасходыУправляющего.Параметры.КомиссияБиржи = ДанныеРаздела.КомиссияБиржи;
	ОбластьТаблицаРасходыУправляющего.Параметры.КомиссияБрокера = ДанныеРаздела.КомиссияБрокера;
	ОбластьТаблицаРасходыУправляющего.Параметры.ДепозитарныеУслуги = ДанныеРаздела.ДепозитарныеУслуги;
	ОбластьТаблицаРасходыУправляющего.Параметры.КомиссияБанка = ДанныеРаздела.УслугиБанка;
	ОбластьТаблицаРасходыУправляющего.Параметры.СпецДеп = ДанныеРаздела.УслугиСпецдепозитария;
	ОбластьТаблицаРасходыУправляющего.Параметры.ИныеРасходы = ДанныеРаздела.ПрочиеРасходыПрочие;
	ОбластьТаблицаРасходыУправляющего.Параметры.Валюта = ПредопределенноеЗначение("Справочник.Валюты.RUB");
	
	ОбластьТаблицаРасходыУправляющего.Параметры.ИтогоСумма = 
	ДанныеРаздела.КомиссияБиржи + 
	ДанныеРаздела.КомиссияБрокера + 
	ДанныеРаздела.ДепозитарныеУслуги +
	ДанныеРаздела.УслугиБанка +
	ДанныеРаздела.УслугиСпецдепозитария +
	ДанныеРаздела.ПрочиеРасходыПрочие;
	
	ТабличныйДокумент.Вывести(ОбластьТаблицаРасходыУправляющего);
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокОбязательства);
	
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицыОбязательства);
	
	Для каждого СтрокаТаблицыЗначений Из ДанныеРаздела.Обязательства Цикл
		
		ОбластьСтрокаТаблицыОбязательств.Параметры.Основание = СтрокаТаблицыЗначений.СчетПредставление;
		ОбластьСтрокаТаблицыОбязательств.Параметры.Сумма = СтрокаТаблицыЗначений.Сумма;
		ОбластьСтрокаТаблицыОбязательств.Параметры.Валюта = ПредопределенноеЗначение("Справочник.Валюты.RUB");
		
		Если СтрокаТаблицыЗначений.Сумма <> 0 Тогда
			// IMAPPS-13736 ++
			//ОбластьСтрокаТаблицыОбязательств.Параметры.ДатаОперации = ДатаОкончанияПредставление;
			Если СтрокаТаблицыЗначений.СчетПредставление = "Начисление % от средней СЧА" Тогда 
				ОбластьСтрокаТаблицыОбязательств.Параметры.ДатаОперации = СтрокаТаблицыЗначений.ДатаРегистратора;
			Иначе 
				ОбластьСтрокаТаблицыОбязательств.Параметры.ДатаОперации = ДатаОкончанияПредставление;
			КонецЕсли;
			// IMAPPS-13736 --
		Иначе
			ОбластьСтрокаТаблицыОбязательств.Параметры.ДатаОперации = "Текущей задолженности нет";
		КонецЕсли;
		
		Если PDF Тогда
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаТаблицыОбязательства, ОбластьСтрокаТаблицыОбязательств); // TM-3169
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицыОбязательств);
		КонецЕсли;
		
	КонецЦикла; 
	
	//vtb 17.06
	Если ДанныеРаздела.Обязательства.Количество() = 0 Тогда
		ОбластьСтрокаТаблицыОбязательств.Параметры.ДатаОперации = "Текущей задолженности нет";
		ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицыОбязательств);
	КонецЕсли; 
	
	ТабличныйДокумент.Вывести(ОбластьИтогоТаблицыОбязательства);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел62Общая(СтруктураОтчета, Макет, ДанныеРаздела, ТипФайла)
	
	PDF = ТипФайла = "pdf";
	
	ОбластьЗаголовокОбязательстваПоСделкам 		= Макет.ПолучитьОбласть("ЗаголовокОбязательстваПоСделкам");
	ОбластьШапкаОбязательстваПоЦБ 				= Макет.ПолучитьОбласть("ШапкаОбязательстваПоЦБ");
	ОбластьСтрокаОбязательстваПоЦБ 				= Макет.ПолучитьОбласть("СтрокаОбязательстваПоЦБ");
	ОбластьШапкаОбязательстваПоДС 				= Макет.ПолучитьОбласть("ШапкаОбязательстваПоДС");
	ОбластьСтрокаОбязательстваПоДС				= Макет.ПолучитьОбласть("СтрокаОбязательстваПоДС");
	
	Если PDF Тогда
		ТабличныйДокумент = СтруктураОтчета.РазделPDF6_2;
		
		ОбластьЧертаКолонтитула             	= Макет.ПолучитьОбласть("ЧертаКолонтитула");
		ТабличныйДокумент.Вывести(ОбластьЧертаКолонтитула);
	Иначе
		ТабличныйДокумент = СтруктураОтчета.Раздел6_2;
	КонецЕсли;
	
	//vtb 27.06
	ОбластьЗаголовокОбязательстваПоСделкам.параметры.ДатаОбязательств =  ДатаОкончания;
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокОбязательстваПоСделкам);
	
	ТабличныйДокумент.Вывести(ОбластьШапкаОбязательстваПоЦБ);
	
	Сделки = ДанныеРаздела.Сделки;
	СделкиБезОплаты = ДанныеРаздела.СделкиБезОплаты;
	ВалютныеСделки = ДанныеРаздела.ВалютныеСделки;
	
	//&_Галимов_Начало 29.12.2016 21:00:04 
	ДополнитьДаннымиЕПС_НезавершенныеСделки(СтруктураДанныхЕПС.ТаблицаСправедливаяЦенаПоНезавершеннымСделкам, Сделки);
	//&_Галимов_Конец 29.12.2016 21:00:09
	
	Для каждого СтрокаТабличнойЧасти Из Сделки Цикл
		
		//&_Галимов_Начало 29.12.2016 21:00:24
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.СправедливаяСтоимостьЕПС = СтрокаТабличнойЧасти.СправедливаяСтоимостьЕПС;
		//&_Галимов_Конец 29.12.2016 21:00:25
		
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.НомерСделки 						= СтрокаТабличнойЧасти.НомерСделки;
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.ДатаСделки 						= СтрокаТабличнойЧасти.Дата;
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.Эмитент 							= СтрокаТабличнойЧасти.АктивПредставление;
		
		НоминальнаяСтоимость = 0;
		
		Если СтрокаТабличнойЧасти.ЭтоОблигация Тогда //IL-106 ВидАктива.ПринадлежитЭлементу(ПланыВидовХарактеристик.ВидыАктивов.Облигации)
			НоминальнаяСтоимость = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(СтрокаТабличнойЧасти.АктивОбъект, ДатаОкончания);
		Иначе
			НоминальнаяСтоимость = СтрокаТабличнойЧасти.НоминальнаяСтоимость;
		КонецЕсли; 
		
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.Номинал 							= НоминальнаяСтоимость;
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.Валюта 							= СтрокаТабличнойЧасти.ВалютаНоминальнойСтоимостиПредставление;
		
		ТипСделки = "";
		
		Если СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Продажа") Тогда
			ТипСделки = "Продажа";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Поступление") Тогда
			ТипСделки = "Покупка";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидОперацииБПВнебиржеваяСделка.Продажа") Тогда
			ТипСделки = "Продажа";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидОперацииБПВнебиржеваяСделка.Покупка") Тогда
			ТипСделки = "Покупка";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО") Тогда
			ТипСделки = "Обратное РЕПО";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ПрямойРЕПО") Тогда
			ТипСделки = "Прямое РЕПО";
		КонецЕсли; 
		
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.ТипСделки 							= ТипСделки;
		
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.Количество 						= СтрокаТабличнойЧасти.Количество;
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.ВалютаЦены 						= СтрокаТабличнойЧасти.ВалютаЦеныПредставление;
		
		
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.Цена 								= СтрокаТабличнойЧасти.Цена;
		
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.ПлановаяДата 					= СтрокаТабличнойЧасти.ДатаПоставки;
		
		// Закоментировано по IL-106 30.09.2017 (устанавливаеться в запросе, оптимизация)
		//Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.БизнесПроцесс) И
		//		ТипЗнч(СтрокаТабличнойЧасти.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ВнебиржеваяСделка") Тогда	
		//	ОбластьСтрокаОбязательстваПоЦБ.Параметры.ТорговаяПлощадка = "Внебиржа";
		//Иначе
		ОбластьСтрокаОбязательстваПоЦБ.Параметры.ТорговаяПлощадка = СтрокаТабличнойЧасти.БиржаПредставление;
		//КонецЕсли;
		
		Если PDF Тогда
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаОбязательстваПоЦБ, ОбластьСтрокаОбязательстваПоЦБ); //TM-3169
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаОбязательстваПоЦБ);
		КонецЕсли;
		
	КонецЦикла; 
	
	Если PDF Тогда
		ПроверитьВывестиОбластьРазделШапка(ТабличныйДокумент, ОбластьШапкаОбязательстваПоДС); //TM-3169
	Иначе
		ТабличныйДокумент.Вывести(ОбластьШапкаОбязательстваПоДС);
	КонецЕсли;
	
	Для каждого СтрокаТабличнойЧасти Из СделкиБезОплаты Цикл
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.НомерСделки 						= СтрокаТабличнойЧасти.НомерСделки;
		ОбластьСтрокаОбязательстваПоДС.Параметры.ДатаСделки 						= СтрокаТабличнойЧасти.Дата;
		ОбластьСтрокаОбязательстваПоДС.Параметры.Эмитент 							= СтрокаТабличнойЧасти.АктивПредставление;
		
		НоминальнаяСтоимость = 0;
		
		Если СтрокаТабличнойЧасти.ЭтоОблигация Тогда //IL-106 ВидАктива.ПринадлежитЭлементу(ПланыВидовХарактеристик.ВидыАктивов.Облигации)
			НоминальнаяСтоимость = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(СтрокаТабличнойЧасти.АктивОбъект, ДатаОкончания);
		Иначе
			НоминальнаяСтоимость = СтрокаТабличнойЧасти.НоминальнаяСтоимость;
		КонецЕсли; 
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.Номинал 							= НоминальнаяСтоимость;
		ОбластьСтрокаОбязательстваПоДС.Параметры.Валюта 							= СтрокаТабличнойЧасти.ВалютаНоминальнойСтоимостиПредставление;
		
		ТипСделки = "";
		
		Если СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Продажа") Тогда
			ТипСделки = "Продажа";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Поступление") Тогда
			ТипСделки = "Покупка";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидОперацииБПВнебиржеваяСделка.Продажа") Тогда
			ТипСделки = "Продажа";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидОперацииБПВнебиржеваяСделка.Покупка") Тогда
			ТипСделки = "Покупка";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО") Тогда
			ТипСделки = "Обратное РЕПО";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ПрямойРЕПО") Тогда
			ТипСделки = "Прямое РЕПО";
		КонецЕсли; 
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.ТипСделки 							= ТипСделки;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.Количество 						= СтрокаТабличнойЧасти.Количество;
		ОбластьСтрокаОбязательстваПоДС.Параметры.ВалютаЦены 						= СтрокаТабличнойЧасти.ВалютаЦеныПредставление;
		
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.Цена 								= СтрокаТабличнойЧасти.Цена;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.ПлановаяДата 					= СтрокаТабличнойЧасти.ДатаПоставки;
		
		// Закоментировано по IL-106 30.09.2017 (устанавливаеться в запросе, оптимизация)
		//Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.БизнесПроцесс) И
		//		ТипЗнч(СтрокаТабличнойЧасти.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ВнебиржеваяСделка") Тогда	
		//	ОбластьСтрокаОбязательстваПоДС.Параметры.ТорговаяПлощадка = "Внебиржа";
		//Иначе
		ОбластьСтрокаОбязательстваПоДС.Параметры.ТорговаяПлощадка = СтрокаТабличнойЧасти.БиржаПредставление;
		//КонецЕсли;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.КомиссияБрокера = СтрокаТабличнойЧасти.КомиссияБрокера;
		ОбластьСтрокаОбязательстваПоДС.Параметры.КомиссияБиржи = СтрокаТабличнойЧасти.КомиссияБиржи;
		
		НужнКурс = СтрокаТабличнойЧасти.Курс;
		// IMAPPS-15455 -->
		// указывать курс ЦБ раный 1 если валюта номинала отлична от рублей, а валюта цены равно RUR		
		Если СтрокаТабличнойЧасти.ВалютаНоминальнойСтоимости <> Справочники.Валюты.RUB И 
			СтрокаТабличнойЧасти.ВалютаЦены = Справочники.Валюты.RUB Тогда
			НужнКурс = 1;
		КонецЕсли;
		СтрокаТабличнойЧасти.Курс = НужнКурс;
		// IMAPPS-15455 <--
		ОбластьСтрокаОбязательстваПоДС.Параметры.Курс = СтрокаТабличнойЧасти.Курс;
		ОбластьСтрокаОбязательстваПоДС.Параметры.ДатаКурса = СтрокаТабличнойЧасти.ДатаКурса;
		
		СуммаВВалютеСделки = 0;
		
		Если СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Поступление") 
			ИЛИ СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидОперацииБПВнебиржеваяСделка.Покупка")
			
			ИЛИ СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО") Тогда
			СуммаВВалютеСделки	= СтрокаТабличнойЧасти.Сумма + 
			СтрокаТабличнойЧасти.КомиссияБиржи + СтрокаТабличнойЧасти.КомиссияБрокера + СтрокаТабличнойЧасти.НКД;
		Иначе
			СуммаВВалютеСделки = СтрокаТабличнойЧасти.Сумма - 
			СтрокаТабличнойЧасти.КомиссияБиржи - СтрокаТабличнойЧасти.КомиссияБрокера + СтрокаТабличнойЧасти.НКД;
		КонецЕсли; 
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.СуммаВВалютеСделки = СуммаВВалютеСделки;
		
		СуммаВВалютеВзаиморасчетов = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(
		СуммаВВалютеСделки,
		СтрокаТабличнойЧасти.ВалютаНоминальнойСтоимости, ПредопределенноеЗначение("Справочник.Валюты.RUB"),
		СтрокаТабличнойЧасти.Курс, 1, 
		1, 1);
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.СуммаВВалютеРасчетов = СуммаВВалютеВзаиморасчетов;
		
		Если PDF Тогда
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаОбязательстваПоДС, ОбластьСтрокаОбязательстваПоДС); //TM-3169
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаОбязательстваПоДС);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаТабличнойЧасти Из ВалютныеСделки Цикл
		
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ФактическаяДатаПоставки) И ЗначениеЗаполнено(СтрокаТабличнойЧасти.ФактическаяДатаПлатежа)
			И СтрокаТабличнойЧасти.ФактическаяДатаПоставки <= ДатаОкончания И СтрокаТабличнойЧасти.ФактическаяДатаПлатежа <= ДатаОкончания Тогда
				Продолжить;
		КонецЕсли;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.НомерСделки 			= СтрокаТабличнойЧасти.НомерСделки;
		ОбластьСтрокаОбязательстваПоДС.Параметры.ДатаСделки 			= СтрокаТабличнойЧасти.Дата;
		ОбластьСтрокаОбязательстваПоДС.Параметры.Эмитент 				= СтрокаТабличнойЧасти.Инструмент;
		
		НоминальнаяСтоимость = 0;
		ОбластьСтрокаОбязательстваПоДС.Параметры.Номинал 				= НоминальнаяСтоимость;
		ОбластьСтрокаОбязательстваПоДС.Параметры.Валюта 				= СтрокаТабличнойЧасти.ВалютаРасчетовПредставление;
		
		ТипСделки = "";
		
		Если СтрокаТабличнойЧасти.ВидОперации 							= ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаСВалютой.Продажа") Тогда
			ТипСделки = "Продажа";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации 						= ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаСВалютой.Покупка") Тогда
			ТипСделки = "Покупка";
		КонецЕсли;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.ТипСделки 				= ТипСделки;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.Количество 			= СтрокаТабличнойЧасти.Количество;
		ОбластьСтрокаОбязательстваПоДС.Параметры.ВалютаЦены 			= СтрокаТабличнойЧасти.ВалютаБазоваяПредставление;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.Цена 					= СтрокаТабличнойЧасти.Курс;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.ПлановаяДата 			= СтрокаТабличнойЧасти.ДатаПоставкиПлан;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.ТорговаяПлощадка 		= СтрокаТабличнойЧасти.БиржаПредставление;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.КомиссияБрокера 		= СтрокаТабличнойЧасти.КомиссияБрокера;
		ОбластьСтрокаОбязательстваПоДС.Параметры.КомиссияБиржи 			= СтрокаТабличнойЧасти.КомиссияБиржи;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.Курс 					= СтрокаТабличнойЧасти.Курс;
		ОбластьСтрокаОбязательстваПоДС.Параметры.ДатаКурса 				= СтрокаТабличнойЧасти.Дата;
		
		ОбластьСтрокаОбязательстваПоДС.Параметры.СуммаВВалютеСделки 	= СтрокаТабличнойЧасти.Количество;
		ОбластьСтрокаОбязательстваПоДС.Параметры.СуммаВВалютеРасчетов 	= СтрокаТабличнойЧасти.Сумма;
		
		Если PDF Тогда
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаОбязательстваПоДС, ОбластьСтрокаОбязательстваПоДС); //TM-3169
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаОбязательстваПоДС);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРаздел7Общая(СтруктураОтчета, Макет, ДанныеРаздела, ДоговорДУ, ТипФайла)
	
	PDF = ТипФайла = "pdf";
	
	ДатаНачалаПредставление 	= Формат(ДатаНачала, "ДФ=dd.MM.yyyy");
	ДатаОкончанияПредставление 	= Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	ОбластьШапкаПравоГолоса = Макет.ПолучитьОбласть("ШапкаПравоГолоса");
	ОбластьСтрокаПравоГолоса = Макет.ПолучитьОбласть("СтрокаПравоГолоса");
	ОбластьГолосованиеГруппировка = Макет.ПолучитьОбласть("ГолосованиеГруппировка");
	ОбластьЗаголовокПравоГолоса = Макет.ПолучитьОбласть("ЗаголовокПравоГолоса");
	
	//VTBC SadykovNiyaz 01.04.2022 (IMAPPS-16952) {
	Если ФлагНовоеНаименованиеУК   Тогда
		ОбластьСканПодпись = Макет.ПолучитьОбласть("СканПодпись");
	ИначеЕсли СтрНайти(Подписант.Наименование,"Юрашева") <> 0 Тогда
		ОбластьСканПодпись = Макет.ПолучитьОбласть("СканПодписьВИМ");
	ИначеЕсли  СтрНайти(Подписант.Наименование,"Влюшина") <> 0 Тогда
		ОбластьСканПодпись = Макет.ПолучитьОбласть("СканПодписьВлюшина");	
	КонецЕсли;
	ОбластьСканТолькоПодпись = Макет.ПолучитьОбласть("СканТолькоПодпись");
	//VTBC SadykovNiyaz 01.04.2022 (IMAPPS-16952) }
	
	ОбластьПодпись = Макет.ПолучитьОбласть("ПодписьБезПечати");
	
	Если PDF Тогда
		ТабличныйДокумент = СтруктураОтчета.РазделPDF7;
		
		ОбластьЧертаКолонтитула	= Макет.ПолучитьОбласть("ЧертаКолонтитула");
		ТабличныйДокумент.Вывести(ОбластьЧертаКолонтитула);
	Иначе
		ТабличныйДокумент = СтруктураОтчета.Раздел7;
	КонецЕсли;
	
	ОбластьЗаголовокПравоГолоса.Параметры.НачалоПериода = ДатаНачалаПредставление;
	ОбластьЗаголовокПравоГолоса.Параметры.КонецПериода = ДатаОкончанияПредставление;
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокПравоГолоса);
	
	ТабличныйДокумент.Вывести(ОбластьШапкаПравоГолоса);
	
	Голосование = ДанныеРаздела.Голосование;
	Эмитенты = ДанныеРаздела.Эмитенты;
	
	НПП = 1;
	
	Для каждого Эмитент Из Эмитенты Цикл
		
		ОтборЭмитент = Новый Структура("Эмитент", Эмитент.Эмитент);
		
		ОбластьГолосованиеГруппировка.Параметры.Эмитент = Эмитент.НаименованиеПолное;
		ТабличныйДокумент.Вывести(ОбластьГолосованиеГруппировка);
		
		НайденныеСтроки = Голосование.НайтиСтроки(ОтборЭмитент);
		
		Для каждого СтрокаТаблицыЗначений Из НайденныеСтроки Цикл
			
			ОбластьСтрокаПравоГолоса.Параметры.Номер = НПП;
			ОбластьСтрокаПравоГолоса.Параметры.Дата = СтрокаТаблицыЗначений.Дата;
			ОбластьСтрокаПравоГолоса.Параметры.Вопрос = СтрокаТаблицыЗначений.ФормулировкаВопроса;
			ОбластьСтрокаПравоГолоса.Параметры.Решение = СтрокаТаблицыЗначений.ФормулировкаРешения;
			ОбластьСтрокаПравоГолоса.Параметры.Позиция = СтрокаТаблицыЗначений.ПозицияУправляющейКомпании;
			ОбластьСтрокаПравоГолоса.Параметры.Голоса = СтрокаТаблицыЗначений.КоличествоГолосов;
			
			Если PDF Тогда
				ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаПравоГолоса, ОбластьСтрокаПравоГолоса); // TM-3169
			Иначе
				ТабличныйДокумент.Вывести(ОбластьСтрокаПравоГолоса);
			КонецЕсли;
			
			НПП = НПП + 1;
			
		КонецЦикла; 
		
	КонецЦикла; 
	//IMAPPS-23458
	Если РежимРаботы <> 0 И НЕ НеФормироватьПечать и (СтрНайти(Подписант.Наименование,"Юрашева") <> 0 ИЛИ СтрНайти(Подписант.Наименование,"Влюшина") <> 0 ) Тогда
		
		ТабличныйДокумент.Вывести(ОбластьСканПодпись);
				
		//vtb
	Иначе
			
		// Управляющая компания
		СведенияУК = Новый СписокЗначений;
		СведенияУК.Добавить("", "НаимЮЛПол");
		СведенияУК.Добавить("", "АдрФакт");
		СведенияУК.Добавить("", "ФИОРук");
		СведенияУК.Добавить("", "ДолжностьРук");
		СведенияУК.Добавить("", "ФИООтв");
		СведенияУК.Добавить("", "ДолжностьОтв");
		
		УКСведения = РегламентированнаяОтчетность.ПолучитьСведенияОбОрганизации(ДоговорДУ.УправляющаяКомпания, ДатаОкончания, СведенияУК);
		
		НаимЮлПол = "";
		АдрФакт = "";
		ФИОРук = "";
		ДолжностьРук = "";
		ФИООтв = "";
		ДолжностьОтв = "";
		
		УКСведения.Свойство("НаимЮлПол", НаимЮлПол);
		УКСведения.Свойство("АдрФакт", АдрФакт);
		УКСведения.Свойство("ФИОРук", ФИОРук);
		
		//VTBC SadykovNiyaz 08.04.2022 (IMAPPS-16952) {
		//УКСведения.Свойство("ДолжностьРук", ДолжностьРук);
		//Если ФлагНовоеНаименованиеУК Тогда
			ДолжностьРук = "Начальник отдела учета операций доверительного управления";
		//Иначе
		//	ДолжностьРук = "Представитель по Доверенности";
		//КонецЕсли;
		//VTBC SadykovNiyaz 08.04.2022 (IMAPPS-16952) }
		
		УКСведения.Свойство("ФИООтв", ФИООтв);
		УКСведения.Свойство("ДолжностьОтв", ДолжностьОтв);
		
		//// Подписи
		//Если РегламентированнаяОтчетностьКлиентСервер.ПустоеЗначение(ФИОРук) Тогда ФИОРук = ""; КонецЕсли;
		//Если РегламентированнаяОтчетностьКлиентСервер.ПустоеЗначение(ДолжностьРук) Тогда ДолжностьРук = ""; КонецЕсли;
		//Если РегламентированнаяОтчетностьКлиентСервер.ПустоеЗначение(ФИООтв) Тогда ФИООтв = ""; КонецЕсли;
		//Если РегламентированнаяОтчетностьКлиентСервер.ПустоеЗначение(ДолжностьОтв) Тогда ДолжностьОтв = ""; КонецЕсли;
		//
		//
		
		//
		//Доп. подписант  
		Структура = Новый Структура;
		Структура.Вставить("ФИОРукПодр", "");
		Структура.Вставить("ДолжностьРукПодр", "");
		
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Владелец", ДоговорДУ.УправляющаяКомпания);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактныеЛица.Роль,
		|	КонтактныеЛица.Наименование,
		|	КонтактныеЛица.Должность
		|ИЗ
		|	Справочник.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.Владелец = &Владелец
		|	И КонтактныеЛица.Роль В (ЗНАЧЕНИЕ(Справочник.РолиКонтактныхЛиц.РуководительПодразделения))";
		
		Результат = Запрос.Выполнить();
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Структура.ФИОРукПодр = Выборка.Наименование;
			Структура.ДолжностьРукПодр = Выборка.Должность;
		КонецЦикла;
		
		РеквизитыУправляющейКомпании = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДоговорДУ.УправляющаяКомпания, "НаименованиеПолное");
		
		//VTBC SadykovNiyaz 18.04.2022 () {
		//IMAPPS-23458 PKlimova
		Если ФлагНовоеНаименованиеУК Тогда
			ОбластьПодпись.Параметры.УправляющаяКомпания 			= НаименованиеУК;
		Иначе
			ОбластьПодпись.Параметры.УправляющаяКомпания 			= "АО ВИМ Инвестиции";
		КонецЕсли;
		//VTBC SadykovNiyaz 18.04.2022 () }
		
		//ОбластьПодпись.Параметры.УправляющаяКомпания = РеквизитыУправляющейКомпании.НаименованиеПолное;
		ОбластьПодпись.Параметры.Руководитель = "/ " +  Подписант.Фамилия + " " + Лев(Подписант.Имя,1) + ". " + Лев(Подписант.Отчество,1)+ ".";
		ОбластьПодпись.Параметры.ДолжностьРук = Подписант.Должность;
		//ОбластьПодпись.Параметры.РуководительПодр = "/ " +Структура.ФИОРукПодр;
		//ОбластьПодпись.Параметры.ДолжностьРукПодр = Выборка.Должность;

		ТабличныйДокумент.Вывести(ОбластьПодпись);
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьСтруктуруОтчета()
	
	РазделыОтчета = Новый Структура;
	РазделыОтчета.Вставить("Раздел1", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("Раздел2", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("Раздел3", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("Раздел4", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("Раздел5", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("Раздел6_1", Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("Раздел6_2", Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("Раздел7", 	Новый ТабличныйДокумент);
	
	РазделыОтчета.Вставить("РазделPDF1", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("РазделPDF2", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("РазделPDF3", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("РазделPDF4", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("РазделPDF5", 	Новый ТабличныйДокумент);
	РазделыОтчета.Вставить("РазделPDF6_1", Новый ТабличныйДокумент);
