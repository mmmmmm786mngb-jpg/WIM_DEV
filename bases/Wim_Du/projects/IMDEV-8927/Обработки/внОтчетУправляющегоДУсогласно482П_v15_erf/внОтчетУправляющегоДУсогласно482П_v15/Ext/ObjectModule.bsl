	ДанныеРаздела.Вставить("ВалютныеСделки", ВалютныеСделки);
	
	Если ВыгружатьВФорматеExcel ИЛИ ВыводитьНаФорму Тогда
		ЗаполнитьРаздел62Общая(СтруктураОтчета, Макет, ДанныеРаздела, "xls"); // TM-3253 {}
	КонецЕсли;
	Если ВыгружатьВФорматеPDF Тогда
		ЗаполнитьРаздел62Общая(СтруктураОтчета, Макет, ДанныеРаздела, "pdf"); // TM-3253 {}
	КонецЕсли;
	
	// Раздел 7
	
	ДанныеРаздела = ПолучитьДанныеРаздел_7(ДоговорДУ);
	
	Если ВыгружатьВФорматеExcel ИЛИ ВыводитьНаФорму Тогда
		ЗаполнитьРаздел7Общая(СтруктураОтчета, Макет, ДанныеРаздела, ДоговорДУ, "xls"); // TM-3253 {}
	КонецЕсли;
	Если ВыгружатьВФорматеPDF Тогда
		ЗаполнитьРаздел7Общая(СтруктураОтчета, Макет, ДанныеРаздела, ДоговорДУ, "pdf"); // TM-3253 {}
	КонецЕсли;
	
	//IMAPPS-21832++
	Если СтруктураОтчета.Свойство("ДанныеСносок") Тогда
		СтруктураОтчета.Удалить("ДанныеСносок"); //Содержит ТаблицуЗначений, при передачи на клиент ошибка отображения
	КонецЕсли;
	//IMAPPS-21832--
	
	Возврат СтруктураОтчета;
КонецФункции // ЗаполнитьДанныеОтчета()

Функция ЗаполнитьЛог() Экспорт
	
	Макет = ПолучитьМакет("Лог");
	
	Лог = Новый ТабличныйДокумент;
	
	ОбластьТекстСообщения = Макет.ПолучитьОбласть("ТекстСообщения");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Если ЗначениеЗаполнено(ТекстовыйЛог) Тогда
		ОбластьТекстСообщения.Параметры.Сообщение = ТекстовыйЛог;
		Лог.Вывести(ОбластьТекстСообщения);
	КонецЕсли;
	
	Лог.Вывести(ОбластьШапка);
	
	Для Каждого Строка Из ТаблицаЛога Цикл
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Строка);
		
		Лог.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	Возврат Лог;
	
КонецФункции

Функция ЗаполнитьФоновыйЛог() Экспорт
	
	Макет = ПолучитьМакет("Лог");
	
	Лог = Новый ТабличныйДокумент;
	
	ОбластьТекстСообщения = Макет.ПолучитьОбласть("ТекстСообщения");
	
	ОбластьТекстСообщения.Параметры.Сообщение = ТекстовыйЛог;
	Лог.Вывести(ОбластьТекстСообщения);
	
	Возврат Лог;
	
КонецФункции

Процедура ЗарегистрироватьСостояниеВыгрузкиОтчетовДУ(СписокДоговоровДУ, РежимОтчета) Экспорт
	
	ПараметрыФормированияОтчета = СоздатьСтруктуруФормированияОтчета();
	
	Таблица = ПолучитьНеВыгруженныеОтчетыДУ();
	Если Таблица.Количество() = 0 Тогда
		Для каждого ТекДоговор Из СписокДоговоровДУ Цикл
			Если РежимОтчета = "ЗаПериод" Или РежимОтчета = "ЗаКвартал" Тогда
				РегистрыСведений.СостоянияВыгрузкиОтчетовДУ.ЗарегистрироватьСостояниеВыгрузкиОтчетаДУ(ТекДоговор, ПараметрыФормированияОтчета);
			ИначеЕсли РежимОтчета = "ПриРасторжении" Тогда
				РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекДоговор, "ДатаОкончания, ДатаВводаСредствВДУ");
				ПараметрыФормированияОтчета.ДатаНачала = РеквизитыДоговора.ДатаВводаСредствВДУ;
				ПараметрыФормированияОтчета.ДатаОкончания = РеквизитыДоговора.ДатаОкончания;
				РегистрыСведений.СостоянияВыгрузкиОтчетовДУ.ЗарегистрироватьСостояниеВыгрузкиОтчетаДУ(ТекДоговор, ПараметрыФормированияОтчета);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ДобавитьТекстСообщения(ТекстовыйЛог, "Предыдущая выгрузка завершилась с ошибкой. Выгружаются только те договора ДУ, по которым выгрузка отчетов не была завершена");
		Сообщить("Предыдущая выгрузка завершилась с ошибкой. Выгружаются только те договора ДУ, по которым выгрузка отчетов не была завершена");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьЗапись(Идентификатор, Выгружено, ЧислоПопытокВыгрузки) Экспорт
	
	РегистрыСведений.СостоянияВыгрузкиОтчетовДУ.ОбновитьЗапись(Идентификатор, Выгружено, ЧислоПопытокВыгрузки);
	
КонецПроцедуры

Процедура ВыгрузкаПоКлиентамРозничногоДУвФоне(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	//Путь = "\\corp\Applications\VTBAM\1C\test\svc_im_avancore_uat\asharunov\внОтчетУправляющегоДУсогласно482П_v15.erf";
	//Обр = ВнешниеОтчеты.Создать(Путь, Ложь);
	//ЗаполнитьЗначенияСвойств(Обр, ЭтотОбъект);
	//Обр.ВыгрузкаПоКлиентамРозничногоДУвФоне(ПараметрыВыполнения, АдресХранилища);
	//Возврат;
	
	РежимРаботы = 2;
	
	НомерИтерации = 0;
	КоличествоИтераций = ПараметрыВыполнения.Таблица.Количество();
	ТекущаяДата = ТекущаяДатаСеанса();
	
	Для каждого ТекСтрока Из ПараметрыВыполнения.Таблица Цикл
		НомерИтерации = НомерИтерации + 1;
		
		ПараметрыФормированияОтчета = ТекСтрока.ПараметрыФормированияОтчета.Получить();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыФормированияОтчета);
		
		ТекущийКаталогВыгрузки = ?(Прав(КаталогВыгрузкиНаСервере, 1) = "\", КаталогВыгрузкиНаСервере, КаталогВыгрузкиНаСервере + "\");
		ТекущийКаталогВыгрузкиКопия = ?(Прав(КаталогВыгрузкиНаСервереКопия, 1) = "\", КаталогВыгрузкиНаСервереКопия, КаталогВыгрузкиНаСервереКопия + "\");
		ТекущийКаталогВыгрузкиКопия = ТекущийКаталогВыгрузкиКопия + "ОТЧЕТЫ ДУ РОЗНИЧНОЕ\" + Формат(ТекущаяДата, "ДФ=ddMMyyyy")+ "\";
		
		ПроверитьСуществованиеКаталога(ТекущийКаталогВыгрузкиКопия);
		
		Если РазбиватьОтчетыПоПризнакуЛК И ЗначениеЗаполнено(КаталогВыгрузкиПоПризнакуЛКНаСервере) Тогда
			
			СвойствоДоговораДУРазрешенаОтчетностьЧерезЛК = СоответствиеРазрешенаОтчетностьЧерезЛК.Получить(ТекСтрока.ДоговорДУ);
			
			Если СвойствоДоговораДУРазрешенаОтчетностьЧерезЛК <> Неопределено И СвойствоДоговораДУРазрешенаОтчетностьЧерезЛК = Истина Тогда
				ТекущийКаталогВыгрузки = ?(Прав(КаталогВыгрузкиПоПризнакуЛКНаСервере, 1) = "\", КаталогВыгрузкиПоПризнакуЛКНаСервере, КаталогВыгрузкиПоПризнакуЛКНаСервере + "\");
			КонецЕсли;
			
		КонецЕсли;
		
		ТекущийПроцентВыполнения = Окр(100 * НомерИтерации / КоличествоИтераций, 0);
		ДлительныеОперации.СообщитьПрогресс(ТекущийПроцентВыполнения, СтрШаблон("Выполняется итерация %1 из %2", НомерИтерации, КоличествоИтераций));
		
		ТабличныеДокументы = ЗаполнитьДанныеОтчета(ТекСтрока.ДоговорДУ);
		
		Если ТабличныеДокументы = Неопределено Тогда   // для договора ДУ дата ввода средств ДУ>Даты окончания отчета, не формируем очтет.
			МассивСформированныхОтчетов_xlsx = Новый Массив;
			МассивСформированныхОтчетов_pdf = Новый Массив;
			
			МассивСформированныхОтчетов = Новый Структура;
			МассивСформированныхОтчетов.Вставить("xlsx", МассивСформированныхОтчетов_xlsx);
			МассивСформированныхОтчетов.Вставить("pdf" , МассивСформированныхОтчетов_pdf);
			
		Иначе
			МассивСформированныхОтчетов = Выгрузить(ТекСтрока.ДоговорДУ, ТабличныеДокументы);
		КонецЕсли;
		
		ЕстьОшибкиВыгрузки = Ложь;
		
		НоваяСтрокаЛога = ТаблицаЛога.Добавить();
		НоваяСтрокаЛога.Портфель = Строка(ТекСтрока.ДоговорДУ);
		
		Если (ВыгружатьВФорматеExcel И МассивСформированныхОтчетов.xlsx.Количество() = 0) 
			ИЛИ (ВыгружатьВФорматеPDF И МассивСформированныхОтчетов.pdf.Количество() = 0) Тогда
			
			НоваяСтрокаЛога.Статус = "Не выгружен";
			НоваяСтрокаЛога.Комментарий = "Дата ввода средств в ДУ > Даты окончания периода";
			ОбновитьЗапись(ТекСтрока.Идентификатор, Ложь, ТекСтрока.ЧислоПопытокОбработки + 3);
		Иначе
			
			Если ВыгружатьВФорматеExcel Тогда
				МассивСформированныхОтчетов_xlsx = МассивСформированныхОтчетов.xlsx;
				
				Для каждого ЭлементМассива Из МассивСформированныхОтчетов_xlsx Цикл
					ИмяФайлаОтчета = СформироватьИмяФайла(ЭлементМассива.ДоговорДУ);
					ИмяФайлаОтчета = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаОтчета);
					
					Попытка
						ЭлементМассива.ТабличныйДокумент.Записать(ТекущийКаталогВыгрузки + ИмяФайлаОтчета + ".xlsx", ТипФайлаТабличногоДокумента.XLSX);
						ЭлементМассива.ТабличныйДокумент.Записать(ТекущийКаталогВыгрузкиКопия + ИмяФайлаОтчета + ".xlsx", ТипФайлаТабличногоДокумента.XLSX);
					Исключение
						НоваяСтрокаЛога.Статус = "Не выгружен";
						НоваяСтрокаЛога.Комментарий = ОписаниеОшибки();
						ЕстьОшибкиВыгрузки = Истина;
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			
			Если ВыгружатьВФорматеPDF Тогда
				МассивСформированныхОтчетов_pdf  = МассивСформированныхОтчетов.pdf;
				
				Для каждого ЭлементМассива Из МассивСформированныхОтчетов_pdf Цикл
					ИмяФайлаОтчета = СформироватьИмяФайла(ЭлементМассива.ДоговорДУ);
					ИмяФайлаОтчета = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаОтчета);
					
					Попытка
						ЭлементМассива.ТабличныйДокумент.Записать(ТекущийКаталогВыгрузки + ИмяФайлаОтчета + ".pdf", ТипФайлаТабличногоДокумента.PDF);
						ЭлементМассива.ТабличныйДокумент.Записать(ТекущийКаталогВыгрузкиКопия + ИмяФайлаОтчета + ".pdf", ТипФайлаТабличногоДокумента.PDF);
					Исключение
						НоваяСтрокаЛога.Статус = "Не выгружен";
						НоваяСтрокаЛога.Комментарий = ОписаниеОшибки();
						ЕстьОшибкиВыгрузки = Истина;
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
			Если ЕстьОшибкиВыгрузки = Истина Тогда
				ОбновитьЗапись(ТекСтрока.Идентификатор, Ложь, ТекСтрока.ЧислоПопытокОбработки + 1);
			Иначе
				НоваяСтрокаЛога.Статус = "Выгружен";
				ОбновитьЗапись(ТекСтрока.Идентификатор, Истина, Неопределено);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ДлительныеОперации.СообщитьПрогресс(, "Фоновое задание выполнено");
	
	ПоместитьВоВременноеХранилище(ТаблицаЛога.Выгрузить(), АдресХранилища);
	
КонецПроцедуры

Функция ПолучитьДополнительныеСвойства(ДоговораДУ) Экспорт
	
	СвойстваДоговоровДУРазрешенаОтчетностьЧерезЛК = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеСведения.Объект,
		|	ДополнительныеСведения.Значение
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Объект В(&ДоговораДУ)
		|	И ДополнительныеСведения.Свойство.Наименование ПОДОБНО ""Разрешена отчетность через ЛК""";
	
	Запрос.УстановитьПараметр("ДоговораДУ", ДоговораДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СвойстваДоговоровДУРазрешенаОтчетностьЧерезЛК.Вставить(ВыборкаДетальныеЗаписи.Объект, ВыборкаДетальныеЗаписи.Значение);
		
	КонецЦикла;
	
	Возврат СвойстваДоговоровДУРазрешенаОтчетностьЧерезЛК;
	
КонецФункции

Функция ПолучитьНеВыгруженныеОтчетыДУ() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СостоянияВыгрузкиОтчетовДУ.Автор КАК Автор,
	|	СостоянияВыгрузкиОтчетовДУ.ДоговорДУ КАК ДоговорДУ,
	|	СостоянияВыгрузкиОтчетовДУ.Период КАК Дата,
	|	СостоянияВыгрузкиОтчетовДУ.ЧислоПопытокВыгрузки КАК ЧислоПопытокОбработки,
	|	СостоянияВыгрузкиОтчетовДУ.Идентификатор КАК Идентификатор,
	|	СостоянияВыгрузкиОтчетовДУ.ПараметрыФормированияОтчета КАК ПараметрыФормированияОтчета
	|ИЗ
	|	РегистрСведений.СостоянияВыгрузкиОтчетовДУ КАК СостоянияВыгрузкиОтчетовДУ
	|ГДЕ
	|	СостоянияВыгрузкиОтчетовДУ.Выгружено = ЛОЖЬ
	|	И СостоянияВыгрузкиОтчетовДУ.НеУдалосьВыгрузить = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СостоянияВыгрузкиОтчетовДУ.Период";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура МассоваяВыгрузкаПоКлиентамРозничногоДУВФоне(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	//Путь = "\\corp\Applications\VTBAM\1C\test\svc_im_avancore_uat\asharunov\внОтчетУправляющегоДУсогласно482П_v15.erf";
	//Обр = ВнешниеОтчеты.Создать(Путь, Ложь);
	//ЗаполнитьЗначенияСвойств(Обр, ЭтотОбъект);
	//Обр.МассоваяВыгрузкаПоКлиентамРозничногоДУВФоне(ПараметрыВыполнения, АдресХранилища);
	//Возврат;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыВыполнения.ПараметрыОтчета);
	
	СостоянияВыгрузкиОтчетовДУ = ПолучитьНеВыгруженныеОтчетыДУ();
	
	ДоговораДУ = Новый Массив;
	Для каждого ТекСтрока Из СостоянияВыгрузкиОтчетовДУ Цикл
		ДоговораДУ.Добавить(ТекСтрока.ДоговорДУ);
	КонецЦикла;
	
	Если РазбиватьОтчетыПоПризнакуЛК Тогда
		СоответствиеРазрешенаОтчетностьЧерезЛК = ПолучитьДополнительныеСвойства(ДоговораДУ);
	КонецЕсли;
	
	ЗапуститьВыгрузкуПоКлиентамРозничногоДУвПотоках(СостоянияВыгрузкиОтчетовДУ, ПараметрыВыполнения.МассивСтрокУникальныхИдентификаторов);
	
КонецПроцедуры

