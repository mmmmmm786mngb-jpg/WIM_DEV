	ВсегоСтрок = ПремииОпционы.Количество();  // TM-3208
	
	Для каждого СтрокаТаблицыЗначений Из ПремииОпционы Цикл
		
		Счетчик = Счетчик + 1;
		
		ОбластьСтрокаПремии.Параметры.НаименованиеПремии = СтрокаТаблицыЗначений.Наименование;
		ОбластьСтрокаПремии.Параметры.Код = СтрокаТаблицыЗначений.Код;
		ОбластьСтрокаПремии.Параметры.Количество = СтрокаТаблицыЗначений.Количество;
		ОбластьСтрокаПремии.Параметры.БалансовыеДанные = СтрокаТаблицыЗначений.БалансоваяСтоимость;
		ОбластьСтрокаПремии.Параметры.ОценочныеДанные = СтрокаТаблицыЗначений.РыночнаяСтоимость;
		
		Если PDF Тогда
			ЭтоПоследняяСтрока = Счетчик = ВсегоСтрок; // TM-3208
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаПремии, ОбластьСтрокаПремии, ЭтоПоследняяСтрока);  
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаПремии);
		КонецЕсли;
		
	КонецЦикла; 
	
	ОбластьИтогоПремии.Параметры.Количество = ПремииОпционы.Итог("Количество");
	ОбластьИтогоПремии.Параметры.БалансовыеДанные = ПремииОпционы.Итог("БалансоваяСтоимость");
	ОбластьИтогоПремии.Параметры.ОценочныеДанные = ПремииОпционы.Итог("РыночнаяСтоимость");
	
	Если PDF Тогда
		
		//vtb 01.07.2016
		Если ВсегоСтрок <> 0 Тогда
			ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаПремии, ОбластьИтогоПремии, ОбластьСтрокаПремии);  // TM-3208
		КонецЕсли;
		
	Иначе
		
		//vtb 01.07.2016
		Если ПремииОпционы.Количество() <> 0 Тогда
			ТабличныйДокумент.Вывести(ОбластьИтогоПремии);
		КонецЕсли;
	КонецЕсли;
	
	#КонецОбласти 	
	
	
	#КонецОбласти 
	
	//&_Галимов_Начало 29.12.2016 22:05:09
	#Область РЕПО_ПФИ
	
	Если ЗагружатьДанныеЕПС Тогда
		ДобавитьРЕПО_ПФИ(ТабличныйДокумент, Макет);	
	КонецЕсли;	
	
	#КонецОбласти
	//&_Галимов_Конец 27.12.2016 21:54:32	
КонецПроцедуры

Процедура ЗаполнитьРаздел2Общая(СтруктураОтчета, Макет, ДанныеРаздела, ТипФайла)
	
	PDF = ТипФайла = "pdf";
	
	ВалютаРегл = ПредопределенноеЗначение("Справочник.Валюты.RUB");
	
	КонецПериодаПредставление = Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	ОбластьПредупреждение 							= Макет.ПолучитьОбласть("Предупреждение");
	ОбластьЗаголовокПортфельКлиента 				= Макет.ПолучитьОбласть("ЗаголовокПортфельКлиента");
	ОбластьШапкаДенежныеСредства 					= Макет.ПолучитьОбласть("ШапкаДенежныеСредства");
	ОбластьСтрокаДенежныеСредства 					= Макет.ПолучитьОбласть("СтрокаДенежныеСредства");
	ОбластьИтогоДенежныеСредства 					= Макет.ПолучитьОбласть("ИтогоДенежныеСредства");
	ОбластьВидАктива								= Макет.ПолучитьОбласть("ВидАктива");
	// Loevets E. IMAPPS-32349
	ОбластьТипВложения								= Макет.ПолучитьОбласть("ТипВложения");
	
	//&_Галимов_Закомментировано 20.07.2017 22:07:50 
	//ОбластьШапкаАктивы								= Макет.ПолучитьОбласть("ШапкаАктивы");
	//ОбластьСтрокаАктивы								= Макет.ПолучитьОбласть("СтрокаАктивы");
	//ОбластьИтогоАктивы								= Макет.ПолучитьОбласть("ИтогоАктивы");
	//ОбластьШапкаКорпОблигации							= Макет.ПолучитьОбласть("ШапкаКорпОблигации");
	//ОбластьСтрокаКорпОблигации						= Макет.ПолучитьОбласть("СтрокаКорпОблигации");
	//ОбластьИтогоКорпОблигации							= Макет.ПолучитьОбласть("ИтогоКорпОблигации");
	//&_Галимов_Закомментировано 20.07.2017 22:07:54 
	
	//&_Галимов_Начало 20.07.2017 22:08:00
	Если ЗагружатьДанные Тогда
		ОбластьШапкаАктивы								= Макет.ПолучитьОбласть("ШапкаАктивыЕПС");
		ОбластьСтрокаАктивы								= Макет.ПолучитьОбласть("СтрокаАктивыЕПС");
		ОбластьИтогоАктивы								= Макет.ПолучитьОбласть("ИтогоАктивыЕПС");
		ОбластьШапкаКорпОблигации						= Макет.ПолучитьОбласть("ШапкаКорпОблигацииЕПС");
		ОбластьСтрокаКорпОблигации						= Макет.ПолучитьОбласть("СтрокаКорпОблигацииЕПС");
		ОбластьИтогоКорпОблигации						= Макет.ПолучитьОбласть("ИтогоКорпОблигацииЕПС");
		// IMAPPS-30982 ++
	ИначеЕсли СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанные Тогда
		ОбластьШапкаАктивы								= Макет.ПолучитьОбласть("ШапкаАктивыБезБаланса");
		ОбластьСтрокаАктивы								= Макет.ПолучитьОбласть("СтрокаАктивыБезБаланса");
		ОбластьИтогоАктивы								= Макет.ПолучитьОбласть("ИтогоАктивыБезБаланса");
		ОбластьШапкаКорпОблигации						= Макет.ПолучитьОбласть("ШапкаКорпОблигацииБезБаланса");
		ОбластьСтрокаКорпОблигации						= Макет.ПолучитьОбласть("СтрокаКорпОблигацииБезБаланса");
		ОбластьИтогоКорпОблигации						= Макет.ПолучитьОбласть("ИтогоКорпОблигацииБезБаланса");
	    ОбластьСтрокаАктивы2							= Макет.ПолучитьОбласть("СтрокаАктивы2БезБаланса");
	    ОбластьСтрокаКорпОблигации2                     = Макет.ПолучитьОбласть("СтрокаКорпОблигации2БезБаланса");
	   // //IMAPPS-30982 --
	Иначе
		ОбластьШапкаАктивы								= Макет.ПолучитьОбласть("ШапкаАктивы");
		ОбластьСтрокаАктивы								= Макет.ПолучитьОбласть("СтрокаАктивы");
		ОбластьИтогоАктивы								= Макет.ПолучитьОбласть("ИтогоАктивы");
		ОбластьШапкаКорпОблигации						= Макет.ПолучитьОбласть("ШапкаКорпОблигации");
		ОбластьСтрокаКорпОблигации						= Макет.ПолучитьОбласть("СтрокаКорпОблигации");
		ОбластьИтогоКорпОблигации						= Макет.ПолучитьОбласть("ИтогоКорпОблигации");
	    ОбластьСтрокаАктивы2							= Макет.ПолучитьОбласть("СтрокаАктивы2");
	    ОбластьСтрокаКорпОблигации2                     = Макет.ПолучитьОбласть("СтрокаКорпОблигации2");
	КонецЕсли;

	
	//&_Галимов_Конец 20.07.2017 22:08:05 
	
	Если СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанные Тогда
		ОбластьШапкаВсегоЦБ								= Макет.ПолучитьОбласть("ШапкаВсегоЦББезБаланса");
		ОбластьИтогоВсегоЦБ								= Макет.ПолучитьОбласть("ИтогоВсегоЦББезБаланса");
	Иначе
		ОбластьШапкаВсегоЦБ								= Макет.ПолучитьОбласть("ШапкаВсегоЦБ");
		ОбластьИтогоВсегоЦБ								= Макет.ПолучитьОбласть("ИтогоВсегоЦБ");
	КонецЕсли;
	ОбластьШапкаКонтракты							= Макет.ПолучитьОбласть("ШапкаКонтракты");
	ОбластьСтрокаКонтракты							= Макет.ПолучитьОбласть("СтрокаКонтракты");
	ОбластьИтогоКонтракты							= Макет.ПолучитьОбласть("ИтогоКонтракты");
	ОбластьШапкаПремии								= Макет.ПолучитьОбласть("ШапкаПремии");
	ОбластьСтрокаПремии								= Макет.ПолучитьОбласть("СтрокаПремии");
	ОбластьИтогоПремии								= Макет.ПолучитьОбласть("ИтогоПремии");
	
	Если PDF Тогда
		ОбластьЧертаКолонтитула			            = Макет.ПолучитьОбласть("ЧертаКолонтитула");
		ТабличныйДокумент = СтруктураОтчета.РазделPDF2;
		ТабличныйДокумент.Вывести(ОбластьЧертаКолонтитула);
	Иначе
		ТабличныйДокумент = СтруктураОтчета.Раздел2;
	КонецЕсли;
	
	КурсыВалют = Новый Соответствие;
	КурсыВалют.Вставить(ПредопределенноеЗначение("Справочник.Валюты.USD"), ДанныеРаздела.КурсUSD);
	
	ОбластьЗаголовокПортфельКлиента.Параметры.КонецПериода = КонецПериодаПредставление;
	ТабличныйДокумент.Вывести(ОбластьЗаголовокПортфельКлиента);
	
	ОбластьПредупреждение.Параметры.КурсДоллара = ДанныеРаздела.КурсUSD.Курс;
	ТабличныйДокумент.Вывести(ОбластьПредупреждение);
	
	ТабличныйДокумент.Вывести(ОбластьШапкаДенежныеСредства);
	
	#Область ДенежныеСредства	
	
	#Область ДенежныеСредстваНаТекущихСчетах
	
	ДенежныеСредстваНаТекущихСчетахИтого = 0;
	
	ДенежныеСредстваНаТекущихСчетах = ДанныеРаздела.ДенежныеСредстваНаТекущихСчетах;
	
	Если ДенежныеСредстваНаТекущихСчетах.Количество() = 0 Тогда
		
		ОбластьСтрокаДенежныеСредства.Параметры.ДенежныеСредства 	= "Денежные средства на текущих счетах";
		ОбластьСтрокаДенежныеСредства.Параметры.Сумма 				= 0;
		ОбластьСтрокаДенежныеСредства.Параметры.Валюта 				= "";		
		ОбластьСтрокаДенежныеСредства.Параметры.СуммаПоКурсу 		= 0;
		ОбластьСтрокаДенежныеСредства.Параметры.КурсЦБ 				= 0;
		
		ТабличныйДокумент.Вывести(ОбластьСтрокаДенежныеСредства);
		
	КонецЕсли; 
	
	Для Каждого СтрокаТаблицыЗначений Из ДенежныеСредстваНаТекущихСчетах Цикл
		
		ОбластьСтрокаДенежныеСредства.Параметры.ДенежныеСредства = "Денежные средства на текущих счетах";
		ОбластьСтрокаДенежныеСредства.Параметры.Сумма = СтрокаТаблицыЗначений.ВалютнаяСуммаОстаток;
		ОбластьСтрокаДенежныеСредства.Параметры.Валюта = СтрокаТаблицыЗначений.ВалютаПредставление;
		
		Если СтрокаТаблицыЗначений.Валюта = ПредопределенноеЗначение("Справочник.Валюты.RUB") Тогда
			
			ОбластьСтрокаДенежныеСредства.Параметры.СуммаПоКурсу = СтрокаТаблицыЗначений.ВалютнаяСуммаОстаток;
			
			//vtb 17.06
			ОбластьСтрокаДенежныеСредства.Параметры.КурсЦБ = 0;
			
			ДенежныеСредстваНаТекущихСчетахИтого = ДенежныеСредстваНаТекущихСчетахИтого + СтрокаТаблицыЗначений.ВалютнаяСуммаОстаток;
			
		Иначе
			
			КурсВалюты = КурсыВалют.Получить(СтрокаТаблицыЗначений.Валюта);
			
			Если КурсВалюты = Неопределено Тогда	
				КурсВалюты = МодульВалютногоУчета.ПолучитьКурсВалюты(ПредопределенноеЗначение("Справочник.Валюты.RUB"), СтрокаТаблицыЗначений.Валюта, ДатаОкончания);
				КурсыВалют.Вставить(СтрокаТаблицыЗначений.Валюта, КурсВалюты);
			КонецЕсли; 
			
			СуммаПоКурсу = МодульВалютногоУчета.ПересчитатьВВалютуУчета(
			СтрокаТаблицыЗначений.ВалютнаяСуммаОстаток,
			ПредопределенноеЗначение("Справочник.Валюты.RUB"),
			СтрокаТаблицыЗначений.Валюта,
			КурсВалюты.Курс,
			КурсВалюты.Кратность
			);
			
			ОбластьСтрокаДенежныеСредства.Параметры.СуммаПоКурсу = СуммаПоКурсу;
			ОбластьСтрокаДенежныеСредства.Параметры.КурсЦБ = КурсВалюты.Курс;
			
			ДенежныеСредстваНаТекущихСчетахИтого = ДенежныеСредстваНаТекущихСчетахИтого + СуммаПоКурсу;
			
		КонецЕсли; 
		
		ТабличныйДокумент.Вывести(ОбластьСтрокаДенежныеСредства);
		
	КонецЦикла; 
	
	#КонецОбласти 
	
	#Область ДенежныеСредстваВПути
	
	ДенежныеСредстваВПутиИтого = 0;
	
	ДенежныеСредстваВПути = ДанныеРаздела.ДенежныеСредстваВПути;
	
	Если ДенежныеСредстваВПути.Количество() = 0 Тогда
		
		ОбластьСтрокаДенежныеСредства.Параметры.ДенежныеСредства 	= "Денежные средства в пути";
		ОбластьСтрокаДенежныеСредства.Параметры.Сумма 				= 0;
		ОбластьСтрокаДенежныеСредства.Параметры.Валюта 				= "";		
		ОбластьСтрокаДенежныеСредства.Параметры.СуммаПоКурсу 		= 0;
		ОбластьСтрокаДенежныеСредства.Параметры.КурсЦБ 				= 0;
		
		ТабличныйДокумент.Вывести(ОбластьСтрокаДенежныеСредства);
		
	КонецЕсли; 
	
	Для Каждого СтрокаТаблицыЗначений Из ДенежныеСредстваВПути Цикл
		
		ОбластьСтрокаДенежныеСредства.Параметры.ДенежныеСредства = "Денежные средства в пути";
		ОбластьСтрокаДенежныеСредства.Параметры.Сумма = СтрокаТаблицыЗначений.ВалютнаяСуммаОстаток;
		ОбластьСтрокаДенежныеСредства.Параметры.Валюта = СтрокаТаблицыЗначений.ВалютаПредставление;
		
		Если СтрокаТаблицыЗначений.Валюта = ПредопределенноеЗначение("Справочник.Валюты.RUB") Тогда
			
			ОбластьСтрокаДенежныеСредства.Параметры.СуммаПоКурсу = СтрокаТаблицыЗначений.ВалютнаяСуммаОстаток;
			//vtb 17.06
			ОбластьСтрокаДенежныеСредства.Параметры.КурсЦБ = 0;
			
			ДенежныеСредстваВПутиИтого = ДенежныеСредстваВПутиИтого + СтрокаТаблицыЗначений.ВалютнаяСуммаОстаток;
			
		Иначе
			
			КурсВалюты = КурсыВалют.Получить(СтрокаТаблицыЗначений.Валюта);
			
			Если КурсВалюты = Неопределено Тогда	
				КурсВалюты = МодульВалютногоУчета.ПолучитьКурсВалюты(ПредопределенноеЗначение("Справочник.Валюты.RUB"), СтрокаТаблицыЗначений.Валюта, ДатаОкончания);
				КурсыВалют.Вставить(СтрокаТаблицыЗначений.Валюта, КурсВалюты);
			КонецЕсли; 
			
			СуммаПоКурсу = МодульВалютногоУчета.ПересчитатьВВалютуУчета(СтрокаТаблицыЗначений.ВалютнаяСуммаОстаток,
			ВалютаРегл, СтрокаТаблицыЗначений.Валюта, КурсВалюты.Курс, КурсВалюты.Кратность);
			
			ОбластьСтрокаДенежныеСредства.Параметры.СуммаПоКурсу = СуммаПоКурсу;
			ОбластьСтрокаДенежныеСредства.Параметры.КурсЦБ = КурсВалюты.Курс;
			
			ДенежныеСредстваВПутиИтого = ДенежныеСредстваВПутиИтого + СуммаПоКурсу;
			
		КонецЕсли;
		
		Если PDF Тогда
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаДенежныеСредства, ОбластьСтрокаДенежныеСредства); // TM-3169
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаДенежныеСредства);
		КонецЕсли;
		
	КонецЦикла; 
	
	#КонецОбласти
	
	// Добавлено по IL-106	30/09/2017 ----
	#Область ДенежныеСредстваВПутиЗаблокированоПодРасчетыППП
	
	ДенежныеСредстваВПутиИтого = 0;
	ДенежныеСредстваВПутиБлокированиеДС = ДанныеРаздела.ДенежныеСредстваВПутиБлокированиеДС;
	
	Если ДенежныеСредстваВПутиБлокированиеДС.Количество() = 0 Тогда
		
		ОбластьСтрокаДенежныеСредства.Параметры.ДенежныеСредства 	= "Денежные средства в пути (заблокировано под расчеты ППП)";
		ОбластьСтрокаДенежныеСредства.Параметры.Сумма 				= 0;
		ОбластьСтрокаДенежныеСредства.Параметры.Валюта 				= "";		
		ОбластьСтрокаДенежныеСредства.Параметры.СуммаПоКурсу 		= 0;
		ОбластьСтрокаДенежныеСредства.Параметры.КурсЦБ 				= 0;
		
		ТабличныйДокумент.Вывести(ОбластьСтрокаДенежныеСредства);
		
	КонецЕсли; 
	
	Для Каждого СтрокаТаблицыЗначений Из ДенежныеСредстваВПутиБлокированиеДС Цикл
		
		ОбластьСтрокаДенежныеСредства.Параметры.ДенежныеСредства = "Денежные средства в пути (заблокировано под расчеты ППП)";
