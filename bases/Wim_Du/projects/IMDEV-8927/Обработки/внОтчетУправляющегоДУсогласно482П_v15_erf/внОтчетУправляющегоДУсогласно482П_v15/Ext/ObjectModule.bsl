Функция Выгрузить(ДоговорДУ, ТабличныеДокументы)
	
	Результат = Новый Структура;
	Результат.Вставить("xlsx", Неопределено);
	Результат.Вставить("pdf" , Неопределено);
	
	МассивСформированныхОтчетов_xlsx = Новый Массив;
	МассивСформированныхОтчетов_pdf = Новый Массив;
	
	Если ВыгружатьВФорматеExcel Тогда
		СформироватьМассивОтчетов(ДоговорДУ, ТабличныеДокументы, МассивСформированныхОтчетов_xlsx, "");
	КонецЕсли;
	
	Если ВыгружатьВФорматеPDF Тогда
		СформироватьМассивОтчетов(ДоговорДУ, ТабличныеДокументы, МассивСформированныхОтчетов_pdf, "pdf");
	КонецЕсли;
	
	Результат.Вставить("xlsx", МассивСформированныхОтчетов_xlsx);
	Результат.Вставить("pdf" , МассивСформированныхОтчетов_pdf);
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьМассивОтчетов(ДоговорДУ, ТабличныеДокументы, МассивСформированныхОтчетов, ВидМассива)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"1"]);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"2"]);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"3"]);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"4"]);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"5"]);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"6_1"]);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"6_2"]);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"7"]);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Если ВидМассива <> "pdf" Тогда
		ТабличныйДокумент.ПолеСверху = 20;
	КонецЕсли;
	ТабличныйДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2;
	ТабличныйДокумент.ВерхнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	
	Если ФлагНовоеНаименованиеУК Тогда
		ТабличныйДокумент.ВерхнийКолонтитул.ТекстСлева = НаименованиеУК;
	Иначе
		ТабличныйДокумент.ВерхнийКолонтитул.ТекстСлева = ДоговорДУ.УправляющаяКомпания.Наименование;
	КонецЕсли;
	
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = "Отчет о деятельности Управляющего за период с " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy") + Символы.ПС
		+ "Договор № " + ДоговорДУ.Код + " от " + Формат(ДоговорДУ.ДатаНачала, "ДФ=dd.MM.yyyy"); 
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстСправа= "Стр. [&НомерСтраницы] (Всего [&СтраницВсего] стр.)";
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
	
	СформированныйОтчет = Новый Структура("ДоговорДУ, ТабличныйДокумент");
	СформированныйОтчет.ДоговорДУ = ДоговорДУ;
	СформированныйОтчет.ТабличныйДокумент = ТабличныйДокумент;
	
	МассивСформированныхОтчетов.Добавить(СформированныйОтчет);
	
КонецПроцедуры

Функция СформироватьИмяФайла(Знач ДоговорДУ)
	
	РеквизитыДоговорДУ = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДоговорДУ, "Префикс, Код, Клиент");
	РеквизитыКлиента = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(РеквизитыДоговорДУ.Клиент, "ЮрФизЛицо, НаименованиеСокращенное, ВнешнийIDДляЛК");
	
	ИмяФайлаОтчета = "";
	
	Если РеквизитыКлиента.ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда
		ИмяФайлаОтчета =  "AM" + СтрЗаменить(РеквизитыКлиента.ВнешнийIDДляЛК, Символ(160), "") + "-" + "ДУ " + СокрЛП(РеквизитыДоговорДУ.Префикс) + " (" + СокрЛП(РеквизитыДоговорДУ.Код) + ") - Отчет ДУ " + Формат(ДатаОкончания,"ДФ=ddMMyyyy");
	Иначе
		ИмяФайлаОтчета =  "AM" + СтрЗаменить(РеквизитыКлиента.ВнешнийIDДляЛК, Символ(160), "") + "-" + СокрЛП(РеквизитыКлиента.НаименованиеСокращенное) + " (" + СокрЛП(РеквизитыДоговорДУ.Код) + ") - Отчет ДУ " + Формат(ДатаОкончания,"ДФ=ddMMyyyy");
	КонецЕсли;
	
	Возврат ИмяФайлаОтчета;
	
КонецФункции

Функция ПолучитьСписокДоговоровРозничногоДУНаРасторжение(Дата)
	
	СписокДоговоровДУ = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорДУ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорДУ КАК ДоговорДУ
		|ГДЕ
		|	НЕ ДоговорДУ.ПометкаУдаления
		|	И ДоговорДУ.ДатаОкончания = &Дата
		|	И ДоговорДУ.Пул.Наименование = ""Розничное ДУ""
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДоговорДУ.Наименование";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	
	СписокДоговоровДУ.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат СписокДоговоровДУ;
	
КонецФункции

Функция СформироватьИОтправитьПисьмо(НаДату)
	
	Тема = "Аванкор ДУ: Отчет управляющего ДУ, согласно 577П";
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
	Кому = Новый Массив;
	Для каждого ТекЯщик из СписокРассылки Цикл
		Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
	КонецЦикла;
	
	Лог = ЗаполнитьЛог();
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла("html");
	Лог.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.HTML5);
	Файл = Новый ЧтениеТекста(ПутьКФайлу);
	Текст = Файл.Прочитать();
	Файл.Закрыть();
	УдалитьФайлы(ПутьКФайлу);
	
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ПрефиксПисьма() + Тема + ПропискаРассылки("r292");
	ПараметрыПисьма.Тело = Текст;
	ПараметрыПисьма.ТипТекста = "HTML";
	ПараметрыПисьма.Важность = Важность;
	
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
		текстРассылки = "Рассылка завершена";
	Исключение
		текстРассылки = "Рассылка не удалась: " + ПочтовыйЛогин;
		Сообщения = ПолучитьСообщенияПользователю(Истина);
	КонецПопытки;
	
	Возврат текстРассылки;
КонецФункции

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	Возврат Прописка;   
КонецФункции // ПропискаРассылки()

Функция ПрефиксПисьма()
	Перем ПрефиксПисьма;
	
	Если ЕстьОшибки = Истина Тогда
		ПрефиксПисьма = "{FAIL} ";
		Важность = ВажностьИнтернетПочтовогоСообщения.Высокая;
	ИначеЕсли ЕстьПредупреждения = Истина Тогда
		ПрефиксПисьма = "{WARN} ";
		Важность = ВажностьИнтернетПочтовогоСообщения.Высокая;
	Иначе
		ПрефиксПисьма = "{OK} ";
		Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
	КонецЕсли;
	
	Возврат ПрефиксПисьма;
КонецФункции // ПрефиксПисьма()

