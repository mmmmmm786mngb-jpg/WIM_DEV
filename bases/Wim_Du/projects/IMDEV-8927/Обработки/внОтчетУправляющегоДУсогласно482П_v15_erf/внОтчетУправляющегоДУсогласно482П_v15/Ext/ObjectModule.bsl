Функция ПолучитьДанныеРаздел_1(ДоговорДУ)
	
	РеквизитыДоговораДУ = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДоговорДУ, 
	"Клиент, ТипКлиентаДУ, Портфель, ПолноеНаименование, УправляющаяКомпания, ДатаВводаСредствВДУ");
	
	РеквизитыКлиента = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(РеквизитыДоговораДУ.Клиент, 
	"НаименованиеПолное, ВнешнийIDДляЛК");
	
	РеквизитыУправляющейКомпании = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(РеквизитыДоговораДУ.УправляющаяКомпания, 
	"НаименованиеПолное");
	
	//ПВХ = ПланыВидовХарактеристик.ПараметрыДоговораДУ;
	//
	//МассивПараметров = Новый Массив;
	//МассивПараметров.Добавить(ПВХ.ВеличинаВознагражденияЗаУспех);
	//МассивПараметров.Добавить(ПВХ.ОтражатьСведенияСЧАДоходностьСНачалаИнвестирования); // TM-3093
	//
	//СписокПараметров = РегистрыСведений.ЗначенияПараметровДоговораДУ.ЗначенияПараметровДоговораДУ(ДоговорДУ, МассивПараметров, КонецДня(ДатаОкончания));
	
	ВеличинаВознагражденияЗаУспех = СписокПараметров.Получить(ПВХ.ВеличинаВознагражденияЗаУспех);
	ОтражатьСНачалаИнвестирования = СписокПараметров.Получить(ПВХ.ОтражатьСведенияСЧАДоходностьСНачалаИнвестирования); // TM-3093
	ОтражатьСНачалаИнвестирования = ?(ОтражатьСНачалаИнвестирования = Неопределено, Истина, ОтражатьСНачалаИнвестирования);
	
	
	НастройкиПериодичности 					= Справочники.НастройкиПериодичности.СоздатьЭлемент();
	НастройкиПериодичности.Периодичность 	= ПредопределенноеЗначение("Перечисление.Периодичность.Месяц");
	НастройкиПериодичности.ТипДня 			= ПредопределенноеЗначение("Перечисление.ТипДня.КалендарныйДень"); //IMAPPS-22226 NOzhiganov
	НастройкиПериодичности.Спецификатор 	= ПредопределенноеЗначение("Перечисление.Спецификатор.Последний");
	
	ДатаВводаСредствВДУ = ?(ЗначениеЗаполнено(РеквизитыДоговораДУ.ДатаВводаСредствВДУ), РеквизитыДоговораДУ.ДатаВводаСредствВДУ, ДобавитьМесяц(ДатаОкончания, -12)); // TM-3260 {}
	
	// TM-3255 {
	Если ДатаВводаСредствВДУ > ДатаОкончания Тогда 
		Сообщить("По договору ДУ """ + ДоговорДУ + """ Дата ввода средств в ДУ > Даты окончания периода, отчет не сформирован!"); // TM-3268 {}
		Возврат Неопределено
	КонецЕсли;
	// TM-3255 }
	
	ДатаНачалаРасчетаДоходности = ?(ОтражатьСНачалаИнвестирования, ДатаВводаСредствВДУ, ДобавитьМесяц(ДатаОкончания, -12)); // TM-3260 {}
	
	ПериодичностьМесяцТаблицаЗначений = КалендарныеГрафики.ПолучитьПериодыСогласноНастройке(ДатаНачалаРасчетаДоходности, ДатаОкончания, НастройкиПериодичности);
	ПериодичностьМесяц = ПериодичностьМесяцТаблицаЗначений.ВыгрузитьКолонку("РезультирующаяДата");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаРаздел_1(); // TM-3260 {}
	
	ВидыЛицензий = Новый Массив;
	ВидыЛицензий.Добавить(ПредопределенноеЗначение("Перечисление.ВидыЛицензий.ДоверительноеУправление"));
	ВидыЛицензий.Добавить(ПредопределенноеЗначение("Перечисление.ВидыЛицензий.ПенсионноеОбеспечениеИСтрахование"));
	ВидыЛицензий.Добавить(ПредопределенноеЗначение("Перечисление.ВидыЛицензий.УправлениеПИФами"));
	
	ПланСчетов = ПланыСчетов.Хозрасчетный;
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	Запрос.УстановитьПараметр("Клиент", РеквизитыДоговораДУ.Клиент);
	Запрос.УстановитьПараметр("УправляющаяКомпания", РеквизитыДоговораДУ.УправляющаяКомпания);
	Запрос.УстановитьПараметр("ТипКонтактнойИнформацииТелефон", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Телефон"));
	Запрос.УстановитьПараметр("ВидКонтактнойИнформацииТелефон", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента"));
	Запрос.УстановитьПараметр("ТипКонтактнойИнформацииФакс", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Факс"));
	Запрос.УстановитьПараметр("ВидКонтактнойИнформацииФакс", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФаксКонтрагента"));
	Запрос.УстановитьПараметр("ТипКонтактнойИнформацииEmail", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты"));
	Запрос.УстановитьПараметр("ВидКонтактнойИнформацииEmail", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailКонтрагента"));
	Запрос.УстановитьПараметр("ТипКонтактнойИнформацииПочтовыйАдрес", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
	Запрос.УстановитьПараметр("ВидКонтактнойИнформацииПочтовыйАдрес", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента"));
	Запрос.УстановитьПараметр("НачалоПериода", ДатаНачалаРасчетаДоходности); // TM-3260 {}
	Запрос.УстановитьПараметр("НачалоПериодаОтчета", НачалоДня(ДатаНачала)); // TM-3316 {}
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("НачалоПериодаГраница", Новый Граница(НачалоДня(ДатаНачалаРасчетаДоходности), ВидГраницы.Исключая)); // TM-3260 {}
	Запрос.УстановитьПараметр("КонецПериодаГраница", Новый Граница(КонецДня(ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоПериодаОтчетаГраница", Новый Граница(НачалоДня(ДатаНачала), ВидГраницы.Исключая)); // TM-3315 {}
	Запрос.УстановитьПараметр("ВидыЛицензий", ВидыЛицензий);
	Запрос.УстановитьПараметр("ПериодичностьМесяц", ПериодичностьМесяц);
	Запрос.УстановитьПараметр("ПериодичностьМесяцТаблицаЗначений", ПериодичностьМесяцТаблицаЗначений);
	Запрос.УстановитьПараметр("Счет_76_06_1", ПланСчетов.РасчетВознаграждениеУКЗаУправление);
	Запрос.УстановитьПараметр("Счет_76_06_2", ПланСчетов.РасчетВознаграждениеУКЗаУспех);
	Запрос.УстановитьПараметр("Счет_91_02_3", ПланСчетов.ВознаграждениеУК);
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "Отчет управляющего ДУ, согласно 482П - Раздел 1");
	
	//vns 17.06
	//ДоходностьДатаНачала = ДобавитьМесяц(ДатаОкончания, -12);
	ДатаНачалаРасчетаДоходности = max(ДатаНачалаРасчетаДоходности,ДоговорДУ.ДатаВводаСредствВДУ);
	
	СписокДоговоровДУ = Новый Массив;
	СписокДоговоровДУ.Добавить(ДоговорДУ);
	
	Если ДоговорДУ.ДатаВозобновленияУправления > ДатаОкончания Тогда             
		ДоходностьMWR = Отчеты.ДоходностьПортфеляMWR_TWR.РасчетДоходностиMWR(ДатаНачалаРасчетаДоходности, ДатаОкончания, СписокДоговоровДУ, 
		ОбщегоНазначенияДУ.ВалютаРеглУчета(), Ложь); // XG-437 {}
		
		ДоходностьMWRГрафик = Отчеты.ДоходностьПортфеляMWR_TWR.РасчетДоходностиMWR(ДоговорДУ.ДатаВводаСредствВДУ, КонецДня(ДатаОкончания), СписокДоговоровДУ, 
		ОбщегоНазначенияДУ.ВалютаРеглУчета(), Ложь);//IMAPPS-23088
	Иначе
		ДоходностьMWR = Отчеты.ДоходностьПортфеляMWR_TWR.РасчетДоходностиMWR(ДатаНачалаРасчетаДоходности, ДатаОкончания, СписокДоговоровДУ, 
		ОбщегоНазначенияДУ.ВалютаРеглУчета(), Ложь,Истина); // XG-437 {}
		
		ДоходностьMWRГрафик = Отчеты.ДоходностьПортфеляMWR_TWR.РасчетДоходностиMWR(ДоговорДУ.ДатаВводаСредствВДУ, КонецДня(ДатаОкончания), СписокДоговоровДУ, 
		ОбщегоНазначенияДУ.ВалютаРеглУчета(), Ложь,Истина);//IMAPPS-23088
	КонецЕСли;	
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	РазмерыВознаграждения = ПолучитьРазмерВознаграждения(ДоговорДУ, ДатаОкончания, 1);
	ВеличинаВознагражденияУК = РазмерыВознаграждения.Получить(ПВХ.ВеличинаВознагражденияУК);       
	
	//vtb 14.07.2016
	Если ""+ТипЗнч(ВеличинаВознагражденияУК) = "Структура" Тогда
		ВеличинаВознагражденияУК = 0;			
	КонецЕсли; 
	
	// MPazhukov IMAPPS-12999
	Если ДоговорДУ.Префикс = "5044" Тогда
		
		ПараметрыДУ = РегистрыСведений.ЗначенияПараметровДоговораДУ.ЗначенияПараметровДоговораДУ(ДоговорДУ, ПланыВидовХарактеристик.ПараметрыДоговораДУ.ДоговорВознагражденияУК, ДатаОкончания);
		ДоговорВознаграждение = ПараметрыДУ.Получить(ПланыВидовХарактеристик.ПараметрыДоговораДУ.ДоговорВознагражденияУК);
		
		РеквизитыДоговора = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДоговорВознаграждение, "Владелец, АлгоритмДоговора, НастройкиАлгоритма");
		
		Алгоритм 	= РеквизитыДоговора.АлгоритмДоговора;
		Настройки 	= РеквизитыДоговора.НастройкиАлгоритма.Получить();
		
		Если Алгоритм.Пустая() тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если Настройки = Неопределено или ТипЗнч(Настройки)<>Тип("Структура") тогда
			Настройки = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Алгоритм, "ХранилищеНастроек").Получить();
		КонецЕсли;
		
		Ставка1 = Настройки.Значения.Ставка_MF0;
		Ставка2 = Настройки.Значения.Ставка_MF51;
		
		ВеличинаВознагражденияУК = Формат(Ставка1, "ЧДЦ=2") + " % / " + Формат(Ставка2, "ЧДЦ=2") + " %"
		
	КонецЕсли;	
	// MPazhukov IMAPPS-12999
	
	// IMAPPS-34169 ++
	Если ДоговорДУ.Пул = ПулРДУ Тогда 
		ДоговорВознагражденияРозница = УправлениеПараметрамиДоговораДУ.ПолучитьПараметрДоговораДУ(ДоговорДУ, ПланыВидовХарактеристик.ПараметрыДоговораДУ.ДоговорВознагражденияУК, ДатаОкончания);
		Если ДоговорВознагражденияРозница <> Неопределено Тогда 
			ХранилищеЗначенияДоговорВознагражденияРозница = ДоговорВознагражденияРозница.НастройкиАлгоритма.Получить();
			Если ХранилищеЗначенияДоговорВознагражденияРозница = Неопределено или ТипЗнч(ХранилищеЗначенияДоговорВознагражденияРозница)<>Тип("Структура") тогда
				ХранилищеЗначенияДоговорВознагражденияРозница = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Алгоритм, "ХранилищеНастроек").Получить();
			КонецЕсли;
		
			ВеличинаВознагражденияУК = ХранилищеЗначенияДоговорВознагражденияРозница.Значения.СтавкаВознаграждения;
		КонецЕсли;
	Иначе 
	КонецЕсли;	
	// IMAPPS-34169 --
	
	Вознаграждения = РезультатЗапроса[11].Выгрузить(); //IMAPPS-22226 
	ВознаграждениеЗаУспех = 0;
	ПлатаЗаУправление = 0;
	Если Вознаграждения.Количество() > 0 Тогда
		
		ВознаграждениеЗаУспех = Вознаграждения[0].ВознаграждениеЗаУспех;
		ПлатаЗаУправление = Вознаграждения[0].ПлатаЗаУправление;	
		
	КонецЕсли; 
	
	
	ДанныеРаздела = Новый Структура;
	ДанныеРаздела.Вставить("ДоговорДУ", 						ДоговорДУ);
	ДанныеРаздела.Вставить("Шапка", 							РезультатЗапроса[3].Выгрузить());
	ДанныеРаздела.Вставить("Лицензии", 							РезультатЗапроса[4].Выгрузить());
	ДанныеРаздела.Вставить("СтоимостьАктивовНачалоПериода", 	РезультатЗапроса[5].Выгрузить());
	ДанныеРаздела.Вставить("СтоимостьАктивовКонецПериода", 		РезультатЗапроса[6].Выгрузить());
	ДанныеРаздела.Вставить("ВложенияИзъятия", 					РезультатЗапроса[7].Выгрузить());
	ДанныеРаздела.Вставить("СтоимостьПортфеля", 				РезультатЗапроса[10].Выгрузить());
	ДанныеРаздела.Вставить("ВеличинаВознагражденияУК", 			ВеличинаВознагражденияУК);
	ДанныеРаздела.Вставить("ВеличинаВознагражденияЗаУспех", 	ВеличинаВознагражденияЗаУспех);
	ДанныеРаздела.Вставить("ПлатаЗаУправление", 				ПлатаЗаУправление);
	ДанныеРаздела.Вставить("ВознаграждениеЗаУспех", 			ВознаграждениеЗаУспех);
	ДанныеРаздела.Вставить("ДоходностьMWR", 					ДоходностьMWR);
	ДанныеРаздела.Вставить("ДоходностьMWRГрафик",               ДоходностьMWRГрафик);//IMAPPS-23088
	ДанныеРаздела.Вставить("РеквизитыКлиента", 					РеквизитыКлиента);
	ДанныеРаздела.Вставить("РеквизитыУправляющейКомпании", 		РеквизитыУправляющейКомпании);
	ДанныеРаздела.Вставить("ДоходностьДатаНачала", 				ДатаНачалаРасчетаДоходности);
	ДанныеРаздела.Вставить("ДоходностьДатаОкончания", 			ДатаОкончания);
	
	Возврат ДанныеРаздела;
	
КонецФункции

Функция ПолучитьДанныеРаздел_2_ПоставкаПротивПлатежа(ДоговорДУ)
	
	ОценкаНезавершенныхСделокПоСС = СписокПараметров.Получить(ПВХ.ОценкаНезавершенныхСделокПоСС) = Истина;
	КурсUSD = МодульВалютногоУчета.ПолучитьКурсВалюты(ПредопределенноеЗначение("Справочник.Валюты.RUB"), ПредопределенноеЗначение("Справочник.Валюты.USD"), КонецДня(ДатаОкончания));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	
	#Область ТекстЗапросаДенежныеСредства
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДенежныеСредстваУправленческийОстатки.ВалютнаяСуммаОстаток,
	|	ДенежныеСредстваУправленческийОстатки.Валюта,
	|	ПРЕДСТАВЛЕНИЕ(ДенежныеСредстваУправленческийОстатки.Валюта),
	|	ВЫРАЗИТЬ(ДенежныеСредстваУправленческийОстатки.АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ВидСчета КАК ВидСчета,
	|	ВЫРАЗИТЬ(ДенежныеСредстваУправленческийОстатки.АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ТранзитныйСчет КАК ТранзитныйСчет
	|ПОМЕСТИТЬ ДенежныеСредства
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваУправленческий.Остатки(
	|			&КонецПериодаГраница,
	|			ДоговорДУ = &ДоговорДУ
	|				И ВЫРАЗИТЬ(АналитическийСчет.МестоХранения КАК Справочник.БанковскиеСчета).ВидСчета В (&ВидыБанковскихСчетов)) КАК ДенежныеСредстваУправленческийОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидСчета,
	|	ТранзитныйСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДенежныеСредства.Валюта,
	|	СУММА(ДенежныеСредства.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток,
	|	ДенежныеСредства.ВалютаПредставление
	|ИЗ
	|	ДенежныеСредства КАК ДенежныеСредства
	|ГДЕ
	|	ДенежныеСредства.ВидСчета = &ВидСчетаРасчетный
	|	И ДенежныеСредства.ТранзитныйСчет = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ДенежныеСредства.Валюта,
	|	ДенежныеСредства.ВалютаПредставление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДенежныеСредства.Валюта,
	|	СУММА(ДенежныеСредства.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток,
	|	ДенежныеСредства.ВалютаПредставление
	|ИЗ
	|	ДенежныеСредства КАК ДенежныеСредства
	|ГДЕ
	|	ДенежныеСредства.ВидСчета = &ВидСчетаРасчетный
	|	И ДенежныеСредства.ТранзитныйСчет = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ДенежныеСредства.Валюта,
	|	ДенежныеСредства.ВалютаПредставление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДенежныеСредства.Валюта,
	|	СУММА(ДенежныеСредства.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток,
	|	ДенежныеСредства.ВалютаПредставление
	|ИЗ
	|	ДенежныеСредства КАК ДенежныеСредства
	|ГДЕ
	|	ДенежныеСредства.ВидСчета = &ВидСчетаДепозитный
	|
	|СГРУППИРОВАТЬ ПО
	|	ДенежныеСредства.Валюта,
	|	ДенежныеСредства.ВалютаПредставление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДенежныеСредства.Валюта,
	|	СУММА(ДенежныеСредства.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток,
	|	ДенежныеСредства.ВалютаПредставление
	|ИЗ
	|	ДенежныеСредства КАК ДенежныеСредства
	|ГДЕ
	|	ДенежныеСредства.ВидСчета = &ВидСчетаБрокерский
	|
	|СГРУППИРОВАТЬ ПО
	|	ДенежныеСредства.Валюта,
	|	ДенежныеСредства.ВалютаПредставление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДенежныеСредства
	|;
	|
