			|	КОНЕЦ КАК ISIN,
			|	СУММА(ВЫБОР
			|			КОГДА ХозрасчетныйОстатки.Счет В (&СчетаУчетаНКД)
			|				ТОГДА ХозрасчетныйОстатки.СуммаОстатокДт
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК СуммаНКД,
			|	СУММА(ВЫБОР
			|           КОГДА ХозрасчетныйОстатки.Счет В (&СчетаПереоценка)
			|				ТОГДА ХозрасчетныйОстатки.СуммаОстаток
   			|			КОГДА ХозрасчетныйОстатки.Счет В (&СчетаАкций, &СчетаОблигаций)
			|				ТОГДА ХозрасчетныйОстатки.СуммаОстатокДт
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК СуммаОстатокСобственные
			|ИЗ
			|	РегистрБухгалтерии.Хозрасчетный.Остатки(&Дата, Счет В (&СчетаАкций, &СчетаОблигаций, &СчетаУчетаНКД), , Портфель = &Портфель) КАК ХозрасчетныйОстатки
			|
			|
			|СГРУППИРОВАТЬ ПО
			|	ВЫБОР
			|		КОГДА ХозрасчетныйОстатки.Счет В (&СчетаАкций)
			|			ТОГДА ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.Акции).ISIN
			|		ИНАЧЕ ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.Облигации).ISIN
			|	КОНЕЦ"; 
			#КонецОбласти
			
			Запрос = ВнешнееСоединение.NewObject("Запрос", ТекстЗапроса);	
