Процедура ДобавитьСуммуПоКурсуКурс(Сумма, НоваяСтрока)
	
	Если НоваяСтрока.Валюта = ПредопределенноеЗначение("Справочник.Валюты.RUB") Тогда
		СуммаПоКурсу = Сумма;
		КурсЦБ = 0;
	Иначе
		КурсыВалют = Новый Соответствие;
		КурсВалюты = МодульВалютногоУчета.ПолучитьКурсВалюты(ПредопределенноеЗначение("Справочник.Валюты.RUB"), НоваяСтрока.Валюта, ДатаОкончания);
		КурсыВалют.Вставить(НоваяСтрока.Валюта, КурсВалюты);
		
		СуммаПоКурсу = МодульВалютногоУчета.ПересчитатьВВалютуУчета(
		Сумма,
		НоваяСтрока.Валюта,
		ПредопределенноеЗначение("Справочник.Валюты.RUB"),
		КурсВалюты.Курс, КурсВалюты.Кратность);
		
		КурсЦБ = КурсВалюты.Курс;	
	КонецЕсли;
	
	НоваяСтрока.СуммаПоКурсу = СуммаПоКурсу;
	НоваяСтрока.КурсЦБ = КурсЦБ;
	
КонецПроцедуры

