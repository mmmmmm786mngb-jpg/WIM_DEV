				Если (ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.ВнебиржеваяСделка") И БизнесПроцесс.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидОперацииБПВнебиржеваяСделка.Покупка"))
					Или (ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.СделкиTn") И БизнесПроцесс.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Поступление")) Тогда
					
					НоваяСтрока.Сумма = -БизнесПроцесс.НКД;
					
				Иначе
					
					НоваяСтрока.Сумма = БизнесПроцесс.НКД;
					
				КонецЕсли;
				
				Отбор = Новый Структура("Регистратор, СДДС", ВыборкаИзРезультатаЗапроса.Регистратор, ВыборкаИзРезультатаЗапроса.СДДС);
				
				СтараяСтрока = ДанныеРаздела.Обороты.НайтиСтроки(Отбор)[0];
				СтараяСтрока.Сумма = ?(СтараяСтрока.Сумма < 0, СтараяСтрока.Сумма + БизнесПроцесс.НКД, СтараяСтрока.Сумма - БизнесПроцесс.НКД);
				// TM-3327 }
				
			КонецЕсли;
			
