Функция КонтрагентБанк(Банк)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Контрагенты.ИНН = """"
	|			ТОГДА ДЛИНАСТРОКИ(Контрагенты.НаименованиеПолное)
	|		ИНАЧЕ 9999
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Банк
	|	И Контрагенты.БанкСсылка = &БанкСсылка
	|	И НЕ Контрагенты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет УБЫВ";
	
	Запрос.УстановитьПараметр("БанкСсылка",Банк);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
	
