	КоБалансоваяСуммаИтог 	= 0;
	КоБалансовыйНКДИтог		= 0;
	КоУпрНКДИтог			= 0;
	КоНоминалИтог 			= 0;
	КоРыночнаяСуммаRURИтог 	= 0;
