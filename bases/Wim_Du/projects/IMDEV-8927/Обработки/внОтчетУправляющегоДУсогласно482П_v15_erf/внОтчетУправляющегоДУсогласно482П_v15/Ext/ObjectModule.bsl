	Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
	ОбластьИтогоКорпОблигации.Параметры.БалансовыеДанныеСтоимость 	= ИпОблБалансоваяСуммаИтог;
	ОбластьИтогоКорпОблигации.Параметры.БалансовыеДанныеНКД 		= ИпОблБалансовыйНКДИтог;
	КонецЕсли;
