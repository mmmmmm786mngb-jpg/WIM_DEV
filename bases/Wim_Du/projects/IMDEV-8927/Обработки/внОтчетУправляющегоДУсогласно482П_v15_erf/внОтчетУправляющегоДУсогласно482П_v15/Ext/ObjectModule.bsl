Процедура ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, НоваяСтраница, ЭтоКонецРаздела, ЭтоПоследняяСтрока)
	
	Если ЭтоПоследняяСтрока Тогда
		//В этом случае очередная строка не будет выведена
		//а будет передана в другую процедуру вывода ИТОГО
		//Нужно обеспечить, чтобы в текущий вызов ТекущийНомерСноски не вывелся и не обнулился
		
		//Для начала запомним текущий номер
		ТекущийНомерСноски = СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски;
		
		//И обнулим, чтобы в текущий вызов не попала сноска
		СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = 0;
	КонецЕсли;
	
	Если PDF Тогда
		Если не ЭтоКонецРаздела Тогда
			//Проверяем и выводим, если это новая страница
			Если НоваяСтраница Тогда
				//Не поместились новые строки с новой сноской. Значит надо пересобрать все сноски с сортировкой, за исключением текущей,
				//текущая пойдет на новую страницу
				СтруктураОтчета.ДанныеСносок.ТекущиеСноски.Сортировать("Номер");
				СтруктураОтчета.ДанныеСносок.СобранныеСноски.Очистить();
				Для каждого Стр Из СтруктураОтчета.ДанныеСносок.ТекущиеСноски Цикл
					ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(Стр.Номер, "Номер");
					Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
						СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски + " (до 28.03.2024г. Общество с ограниченной ответственностью Брокерская компания Платформа).";
					Иначе
				    	СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски;
					КонецЕсли;
					//СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски;
					СтруктураОтчета.ДанныеСносок.СобранныеСноски.Вывести(СтруктураОтчета.ДанныеСносок.ОбластьСноска);
				КонецЦикла;
				
				//Для забиваем пустыми строками до конца страницы
				//Предыдущая строка могла быть большой и перешла на новую страницу, сноски нужно увести до конца страницы
				Помещается = Ложь;
				Пока Истина Цикл
					ВыводимыеОбласти = Новый Массив;
					ВыводимыеОбласти.Добавить(СтруктураОтчета.ДанныеСносок.ОбластьПустаяСтрока);
					ВыводимыеОбласти.Добавить(СтруктураОтчета.ДанныеСносок.СобранныеСноски);
					Попытка
						Помещается = ТабличныйДокумент.ПроверитьВывод(ВыводимыеОбласти);
					Исключение
						Сообщить("Не удается получить информацию о текущем принтере");
						Прервать;
					КонецПопытки;
					
					Если Помещается Тогда
						ТабличныйДокумент.Вывести(СтруктураОтчета.ДанныеСносок.ОбластьПустаяСтрока);
					Иначе
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				ТабличныйДокумент.Вывести(СтруктураОтчета.ДанныеСносок.СобранныеСноски);
				
