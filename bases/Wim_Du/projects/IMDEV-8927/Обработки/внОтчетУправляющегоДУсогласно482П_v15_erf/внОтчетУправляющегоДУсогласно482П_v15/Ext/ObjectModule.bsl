	Запрос.УстановитьПараметр("УчитыватьСделкиРЕПОКакПокупкаПродажа",УчитыватьСделкиРЕПОКакПокупкаПродажа);
	Запрос.УстановитьПараметр("УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ",УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ);
	// IMAPPS-23069--
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "Отчет управляющего ДУ, согласно 482П - Раздел 2 - Ценные бумаги");
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Выполнить();
	
	Запрос.Текст =
	
	#Область ТекстЗапроса
	
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ЦеннаяБумага,
	|	ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.Акции).ISIN КАК ISIN,
	|	ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.Акции).НомерГосРегистрацииВыпуска КАК НомерГосРегистрации,
	|	ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.Акции).НоминальнаяСтоимость КАК НоминальнаяСтоимость,
	|	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминальнойСтоимости) КАК ВалютаНоминальнойСтоимостиПредставление,
	|	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.ЦеннаяБумага),
	|	СУММА(ВложенныйЗапрос.Количество) КАК Количество,
	|	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.Биржа),
	|	ВложенныйЗапрос.ДатаКотировки,
	|	СУММА(ВложенныйЗапрос.БалансоваяСтоимость) КАК БалансоваяСтоимость,
	|	СУММА(ВложенныйЗапрос.РыночнаяСтоимость) КАК РыночнаяСтоимость,
	|	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.РыночнаяВалюта),
	|	ВложенныйЗапрос.БалансоваяЦена,
	|	ВложенныйЗапрос.РыночнаяЦена,
	|	ВложенныйЗапрос.ЭтоРепо, 
	|   ВложенныйЗапрос.ПрямойРЕПО КАК ПрямойРЕПО,
	|   ВложенныйЗапрос.ОбратныйРЕПО КАК ОбратныйРЕПО
	|ИЗ
	|	(ВЫБРАТЬ
	|		Акции.ЦеннаяБумага КАК ЦеннаяБумага,
	|		ВЫБОР 
	|			КОГДА Акции.СделкаРЕПО = ИСТИНА 
	|				ТОГДА Акции.Количество
	|			ИНАЧЕ ЕСТЬNULL(ЦенныебумагиХозрасчетныйостатки.Количество,0) - ЕСТЬNULL(АкцииОбратныйРЕПО.Количество,0)	
	|		КОНЕЦ КАК Количество,
	//|		Акции.Количество КАК Количество,
	//|		выбор когда Акции.ПрямойРЕПО тогда 0 иначе Акции.Количество конец КАК Количество,
	|		Акции.Биржа КАК Биржа,
	|		Акции.ДатаКотировки КАК ДатаКотировки,
	|		Акции.БалансоваяСтоимость КАК БалансоваяСтоимость,
	//IMAPPS-33189
	|       ВЫБОР КОГДА Акции.ОбратныйРЕПО ТОГДА 0 ИНАЧЕ  
	|		Акции.РыночнаяСтоимость КОНЕЦ КАК РыночнаяСтоимость,
	|		Акции.РыночнаяВалюта КАК РыночнаяВалюта,
	|		ВЫБОР
	|			КОГДА Акции.СделкаРЕПО = ИСТИНА И Акции.Количество <> 0
	|				ТОГДА Акции.БалансоваяСтоимость / Акции.Количество
	|			КОГДА Акции.СделкаРЕПО = ЛОЖЬ И ЕСТЬNULL(ЦенныебумагиХозрасчетныйостатки.Количество,0) - ЕСТЬNULL(АкцииОбратныйРЕПО.Количество,0) <> 0
	|				ТОГДА Акции.БалансоваяСтоимость / ( ЕСТЬNULL(ЦенныебумагиХозрасчетныйостатки.Количество,0) - ЕСТЬNULL(АкцииОбратныйРЕПО.Количество,0))
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК БалансоваяЦена,
	|		ВЫБОР 
	//IMAPPS-33189
	|			КОГДА Акции.СделкаРЕПО = ИСТИНА И Акции.Количество <> 0 И НЕ Акции.ОбратныйРЕПО  
	|				ТОГДА Акции.РыночнаяСтоимость / Акции.Количество
	|			КОГДА Акции.СделкаРЕПО = ЛОЖЬ И ЕСТЬNULL(ЦенныебумагиХозрасчетныйОстатки.Количество,0) - ЕСТЬNULL(АкцииОбратныйРЕПО.Количество,0) <> 0
	|				ТОГДА Акции.РыночнаяСтоимость / ЕСТЬNULL(ЦенныебумагиХозрасчетныйОстатки.Количество,0) - ЕСТЬNULL(АкцииОбратныйРЕПО.Количество,0)
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК РыночнаяЦена,
	|		Акции.СделкаРЕПО КАК ЭтоРепо
	|		, Акции.ПрямойРЕПО КАК ПрямойРЕПО
	|		, Акции.ОбратныйРЕПО КАК ОбратныйРЕПО
	|	ИЗ
	|		Акции КАК Акции 
	|			ЛЕВОЕ СОЕДИНЕНИЕ ЦенныебумагиХозрасчетныйОстатки КАК ЦенныебумагиХозрасчетныйОстатки
	|        	ПО Акции.ЦеннаяБумага = ЦенныебумагиХозрасчетныйОстатки.ЦеннаяБумага
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ * ИЗ Акции ГДЕ Акции.ОбратныйРЕПО) КАК АкцииОбратныйРЕПО
	|        		ПО Акции.ЦеннаяБумага = АкцииОбратныйРЕПО.ЦеннаяБумага
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		АкцииРыночнаяСтоимостьРЕПО.ЦеннаяБумага,
	|		ВЫБОР 
	|			КОГДА АкцииРыночнаяСтоимостьРЕПО.СделкаРЕПО = ИСТИНА 
	|				ТОГДА АкцииРыночнаяСтоимостьРЕПО.Количество
	|			ИНАЧЕ ЕСТЬNULL(ЦенныебумагиХозрасчетныйостатки.Количество,0) - ЕСТЬNULL(АкцииРыночнаяСтоимостьОбратныйРЕПО.Количество,0)	
	|		КОНЕЦ КАК Количество,
	//|		АкцииРыночнаяСтоимостьРЕПО.Количество,	
	//|		выбор когда АкцииРыночнаяСтоимостьРЕПО.ПрямойРЕПО тогда 0 иначе АкцииРыночнаяСтоимостьРЕПО.Количество конец КАК Количество,
	|		ЕСТЬNULL(ЗафиксированныеКотировки.Биржа, ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка)),
	|		ЕСТЬNULL(ЗафиксированныеКотировки.Период, ДАТАВРЕМЯ(1, 1, 1)),
	|		ЕСТЬNULL(БалансоваяСтоимость.Сумма, 0),
	//IMAPPS-33189
	|       ВЫБОР КОГДА АкцииРыночнаяСтоимостьРЕПО.ОбратныйРЕПО ТОГДА 0 ИНАЧЕ 
	|		АкцииРыночнаяСтоимостьРЕПО.Сумма КОНЕЦ,
	|		АкцииРыночнаяСтоимостьРЕПО.Валюта,
	|		ВЫБОР
	|			КОГДА АкцииРыночнаяСтоимостьРЕПО.СделкаРЕПО = ИСТИНА И АкцииРыночнаяСтоимостьРЕПО.Количество <> 0
	|				ТОГДА БалансоваяСтоимость.Сумма / АкцииРыночнаяСтоимостьРЕПО.Количество
	|			КОГДА АкцииРыночнаяСтоимостьРЕПО.СделкаРЕПО = ЛОЖЬ И ЕСТЬNULL(ЦенныебумагиХозрасчетныйостатки.Количество,0) - ЕСТЬNULL(АкцииРыночнаяСтоимостьОбратныйРЕПО.Количество,0) <> 0
	|				ТОГДА  БалансоваяСтоимость.Сумма / ( ЕСТЬNULL(ЦенныебумагиХозрасчетныйостатки.Количество,0) - ЕСТЬNULL(АкцииРыночнаяСтоимостьОбратныйРЕПО.Количество,0))
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		ВЫБОР 
	//IMAPPS-33189
	|			КОГДА АкцииРыночнаяСтоимостьРЕПО.СделкаРЕПО = ИСТИНА И АкцииРыночнаяСтоимостьРЕПО.Количество <> 0 И НЕ АкцииРыночнаяСтоимостьРЕПО.ОбратныйРЕПО 
	|				ТОГДА АкцииРыночнаяСтоимостьРЕПО.Сумма / АкцииРыночнаяСтоимостьРЕПО.Количество
	|			КОГДА АкцииРыночнаяСтоимостьРЕПО.СделкаРЕПО = ЛОЖЬ И ЕСТЬNULL(ЦенныебумагиХозрасчетныйОстатки.Количество,0) - ЕСТЬNULL(АкцииРыночнаяСтоимостьОбратныйРЕПО.Количество,0) <> 0
	|				ТОГДА АкцииРыночнаяСтоимостьРЕПО.Сумма / ЕСТЬNULL(ЦенныебумагиХозрасчетныйОстатки.Количество,0) - ЕСТЬNULL(АкцииРыночнаяСтоимостьОбратныйРЕПО.Количество,0)
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		АкцииРыночнаяСтоимостьРЕПО.СделкаРЕПО 
	|		, АкцииРыночнаяСтоимостьРЕПО.ПрямойРЕПО 
	|		, АкцииРыночнаяСтоимостьРЕПО.ОбратныйРЕПО 
	|	ИЗ
	|		АкцииРыночнаяСтоимостьРЕПО КАК АкцииРыночнаяСтоимостьРЕПО
	|			ЛЕВОЕ СОЕДИНЕНИЕ ЗафиксированныеКотировки КАК ЗафиксированныеКотировки
	|			ПО АкцииРыночнаяСтоимостьРЕПО.ЦеннаяБумага = ЗафиксированныеКотировки.ЦеннаяБумага
	|			ЛЕВОЕ СОЕДИНЕНИЕ ЦенныебумагиХозрасчетныйОстатки КАК ЦенныебумагиХозрасчетныйОстатки
	|        	ПО АкцииРыночнаяСтоимостьРЕПО.ЦеннаяБумага = ЦенныебумагиХозрасчетныйОстатки.ЦеннаяБумага
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ * ИЗ АкцииРыночнаяСтоимостьРЕПО ГДЕ АкцииРыночнаяСтоимостьРЕПО.ОбратныйРЕПО) КАК АкцииРыночнаяСтоимостьОбратныйРЕПО
	|        		ПО АкцииРыночнаяСтоимостьРЕПО.ЦеннаяБумага = АкцииРыночнаяСтоимостьОбратныйРЕПО.ЦеннаяБумага
	|			ЛЕВОЕ СОЕДИНЕНИЕ БалансоваяСтоимость КАК БалансоваяСтоимость
	|			ПО АкцииРыночнаяСтоимостьРЕПО.ЦеннаяБумага = БалансоваяСтоимость.ЦеннаяБумага
	|				И АкцииРыночнаяСтоимостьРЕПО.СделкаРЕПО = БалансоваяСтоимость.СделкаРЕПО) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ЦеннаяБумага,
	|	ВложенныйЗапрос.Биржа,
	|	ВложенныйЗапрос.ДатаКотировки,
	|	ВложенныйЗапрос.РыночнаяВалюта,
	|	ВложенныйЗапрос.БалансоваяЦена,
	|	ВложенныйЗапрос.РыночнаяЦена,
	|	ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.Акции).ISIN,
	|	ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.Акции).НомерГосРегистрацииВыпуска,
	|	ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.Акции).НоминальнаяСтоимость,
	|	ВложенныйЗапрос.ЭтоРепо,
	|   ВложенныйЗапрос.ПрямойРЕПО,
	|   ВложенныйЗапрос.ОбратныйРЕПО
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВложенныйЗапрос.ЦеннаяБумага.Наименование
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ЦеннаяБумага,
	|	ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.ПаиПИФ).ISIN КАК ISIN,
	|	ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.ПаиПИФ).НомерГосРегистрацииВыпуска КАК НомерГосРегистрации,
	|	0 КАК НоминальнаяСтоимость,
	|	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ВложенныйЗапрос.ЦеннаяБумага КАК Справочник.ПаиПИФ).ВалютаНоминальнойСтоимости) КАК ВалютаНоминальнойСтоимостиПредставление,
	|	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.ЦеннаяБумага),
	|	СУММА(ВложенныйЗапрос.Количество) КАК Количество,
	|	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.Биржа),
	|	ВложенныйЗапрос.ДатаКотировки,
	|	СУММА(ВложенныйЗапрос.БалансоваяСтоимость) КАК БалансоваяСтоимость,
	|	СУММА(ВложенныйЗапрос.РыночнаяСтоимость) КАК РыночнаяСтоимость,
	|	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.РыночнаяВалюта),
	|	ВложенныйЗапрос.БалансоваяЦена,
	|	ВложенныйЗапрос.РыночнаяЦена,
	|	ВложенныйЗапрос.ЭтоРепо,
	|   ВложенныйЗапрос.ПрямойРЕПО КАК ПрямойРЕПО,
	|   ВложенныйЗапрос.ОбратныйРЕПО КАК ОбратныйРЕПО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ИнвестиционныеПаи.ЦеннаяБумага КАК ЦеннаяБумага,
	|		ВЫБОР 
	|			КОГДА ИнвестиционныеПаи.СделкаРЕПО = ИСТИНА 
	|				ТОГДА ИнвестиционныеПаи.Количество
	|			ИНАЧЕ ЕСТЬNULL(ЦенныебумагиХозрасчетныйостатки.Количество,0) - ЕСТЬNULL(ИнвестиционныеПаиОбратныйРЕПО.Количество,0)	
	|		КОНЕЦ КАК Количество,
	//|		ИнвестиционныеПаи.Количество КАК Количество,	
	//|		выбор когда ИнвестиционныеПаи.ПрямойРЕПО тогда 0 иначе ИнвестиционныеПаи.Количество конец КАК Количество,
	|		ИнвестиционныеПаи.Биржа КАК Биржа,
	|		ИнвестиционныеПаи.ДатаКотировки КАК ДатаКотировки,
	|		ИнвестиционныеПаи.БалансоваяСтоимость КАК БалансоваяСтоимость,
	|       ВЫБОР КОГДА ИнвестиционныеПаи.ОбратныйРЕПО ТОГДА 0 ИНАЧЕ   
	|		ИнвестиционныеПаи.РыночнаяСтоимость КОНЕЦ КАК РыночнаяСтоимость,
	|		ИнвестиционныеПаи.РыночнаяВалюта КАК РыночнаяВалюта,
	|		ВЫБОР
