					КонецЕсли;
					
					Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
						ДанныеСноски.ТекстСноски = ДанныеСноски.ТекстСноски + " (до 28.03.2024г. Общество с ограниченной ответственностью Брокерская компания Платформа).";
					КонецЕсли;
					
					СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = ДанныеСноски.Номер;
					СноскаТекст = ДанныеСноски.Сноска;
				КонецЕсли; 
				
				ОбластьСтрокаАктивы.Параметры.Депозитарий = СноскаТекст + СокрЛП(Строки[0].НаименованиеСокращенное);
				//IMAPPS-21832--
				
			ИначеЕсли НЕ ЗагружатьДанные Тогда 
				
				ОбластьСтрокаАктивы.Параметры.Депозитарий = ""; 
			КонецЕсли;
						
			Если Строки.Количество() > 0 И НЕ ЗагружатьДанные И НЕ ОбластьСтрокаАктивы.Параметры.ТипВложения = "СБСТВ РЕПО" тогда  
			   ОбластьСтрокаАктивы.Параметры.МестоДепозитария              = Строки[0].Представление;
			   ОбластьСтрокаАктивы.Параметры.ИННДеп                        = Строки[0].ИНН;
			   ОбластьСтрокаАктивы.Параметры.ОГРНДеп                       = Строки[0].ОГРН;
		   ИначеЕсли НЕ ЗагружатьДанные Тогда
			   ОбластьСтрокаАктивы.Параметры.Депозитарий				   = "";
			   ОбластьСтрокаАктивы.Параметры.МестоДепозитария              = "";
			   ОбластьСтрокаАктивы.Параметры.ИННДеп                        = "";
			   ОбластьСтрокаАктивы.Параметры.ОГРНДеп                       = "";
           КонецЕсли;
		
		
		РыночнаяОценкаUSD = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(
		СтрокаТаблицыЗначений.РыночнаяСтоимость,
		ПредопределенноеЗначение("Справочник.Валюты.RUB"), ПредопределенноеЗначение("Справочник.Валюты.USD"),
		1, ДанныеРаздела.КурсUSD.Курс, 
		1, ДанныеРаздела.КурсUSD.Кратность);
		
		//DDneprovsky IMAPPS-13406
		//ОбластьСтрокаАктивы.Параметры.РыночнаяОценкаUSD = РыночнаяОценкаUSD;
		
		Если PDF Тогда
			ЭтоПоследняяСтрока = Счетчик = ВсегоСтрок; // TM-3208
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаАктивы, ОбластьСтрокаАктивы, ЭтоПоследняяСтрока);
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаАктивы); 
		КонецЕсли;
	
	КонецЕсли;
				
		АкцииКоличествоИтог 		= АкцииКоличествоИтог + СтрокаТаблицыЗначений.Количество;
		АкцииБалансоваяСуммаИтог 	= АкцииБалансоваяСуммаИтог + СтрокаТаблицыЗначений.БалансоваяСтоимость;
		АкцииНоминалИтог 			= АкцииНоминалИтог + СтрокаТаблицыЗначений.НоминальнаяСтоимость;
		АкцииРыночнаяСуммаRURИтог 	= АкцииРыночнаяСуммаRURИтог + СтрокаТаблицыЗначений.РыночнаяСтоимость;
		АкцииРыночнаяСуммаUSDИтог 	= АкцииРыночнаяСуммаUSDИтог + РыночнаяОценкаUSD;
		
	КонецЦикла;  
	
	// IMAPPS-30982
    //Если НЕ СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанныеЕПС Тогда	
    Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
    	ОбластьИтогоАктивы.Параметры.БалансовыеДанныеСтоимость = АкцииБалансоваяСуммаИтог;
    КонецЕсли;
    ОбластьИтогоАктивы.Параметры.НКДСумма = 0;
    //DDneprovsky IMAPPS-13406
    //ОбластьИтогоАктивы.Параметры.РыночнаяОценкаUSD = АкцииРыночнаяСуммаUSDИтог;
    ОбластьИтогоАктивы.Параметры.РыночнаяОценкаRUR = АкцииРыночнаяСуммаRURИтог;
    
    Если PDF Тогда
    	
    	//vtb 01.07.2016
    	Если ВсегоСтрок <> 0 Тогда
    		ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаАктивы, ОбластьИтогоАктивы, ОбластьСтрокаАктивы); // TM-3208
    	КонецЕсли;
    	
    Иначе
    	
    	//vtb 01.07.2016
    	Если Акции.Количество() <> 0 Тогда
    		ТабличныйДокумент.Вывести(ОбластьИтогоАктивы);
    	КонецЕсли;
	КонецЕсли;  

	Если НЕ СкрыватьБалансовуюСтоимость Тогда
		СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.БалансоваяСтоимость = СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.БалансоваяСтоимость + АкцииБалансоваяСуммаИтог;
	КонецЕсли;	
	СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.РыночнаяСтоимость = СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.РыночнаяСтоимость + АкцииРыночнаяСуммаRURИтог;



	
КонецФункции

Функция ОбработатьИнвестиционныеПаи(Паи, ДанныеРаздела, СтруктураОтчета, PDF, ТабличныйДокумент, СтруктураОбластей) 
	
	Депозитарий = ДанныеРаздела.ДанныеДепозитария; 
	
	ОбластьСтрокаАктивы2 = СтруктураОбластей.ОбластьСтрокаАктивы2;
	ОбластьСтрокаАктивы = СтруктураОбластей.ОбластьСтрокаАктивы; 
	ОбластьШапкаАктивы = СтруктураОбластей.ОбластьШапкаАктивы;
	ОбластьИтогоАктивы = СтруктураОбластей.ОбластьИтогоАктивы; 
	
	ПаиКоличествоИтог 		= 0;
	ПаиБалансоваяСуммаИтог 	= 0;
	ПаиНоминалИтог 			= 0;
	ПаиРыночнаяСуммаRURИтог 	= 0;
	ПаиРыночнаяСуммаUSDИтог 	= 0;
	РыночнаяОценкаUSD			= 0;             
	//IMAPPS-24443
	
		
	Счетчик = 0;                   // TM-3208
	ВсегоСтрок = Паи.Количество(); // TM-3208
	
	Для Каждого СтрокаТаблицыЗначений Из Паи Цикл
		
		//&_Галимов_Начало 28.12.2016 21:29:08
		//очистим
		//СтруктураПараметровЕПС = Новый Структура;
		//СтруктураПараметровЕПС.Вставить("ТипВложения", "");
		//ОбластьСтрокаАктивы.Параметры.Заполнить(СтруктураПараметровЕПС);
		//&_Галимов_Конец 28.12.2016 21:29:09
		
		Если СтрокаТаблицыЗначений.Количество = 0 Тогда
			Продолжить;
		Конецесли;

		Счетчик = Счетчик + 1; // TM-3208  
		Отбор = Новый Структура();
		Отбор.Вставить("АктивНаименование",СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление);
		Строки = Депозитарий.НайтиСтроки(Отбор);
		Если Строки.Количество() > 1 и НЕ ЗагружатьДанные   Тогда
			ОбластьСтрокаАктивы2.Параметры.Депозитарий1    = Строки[0].НаименованиеСокращенное;
		    ОбластьСтрокаАктивы2.Параметры.МестоДепозитария1              = Строки[0].Представление;
		    ОбластьСтрокаАктивы2.Параметры.ИННДеп1                        = Строки[0].ИНН;
		    ОбластьСтрокаАктивы2.Параметры.ОГРНДеп1                       = Строки[0].ОГРН;
	        ОбластьСтрокаАктивы2.Параметры.Депозитарий2    = Строки[1].НаименованиеСокращенное;
		    ОбластьСтрокаАктивы2.Параметры.МестоДепозитария2              = Строки[1].Представление;
		    ОбластьСтрокаАктивы2.Параметры.ИННДеп2                        = Строки[1].ИНН;
		    ОбластьСтрокаАктивы2.Параметры.ОГРНДеп2                       = Строки[1].ОГРН; 
	        ОбластьСтрокаАктивы2.Параметры.Количество1 = Строки[0].Количество;
            ОбластьСтрокаАктивы2.Параметры.Количество2 = Строки[1].Количество;
			ОбластьСтрокаАктивы2.Параметры.НаименованиеЦБ = СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление;
		    ОбластьСтрокаАктивы2.Параметры.НомерГосРегистрации = 
		    ?(ЗначениеЗаполнено(СтрокаТаблицыЗначений.НомерГосРегистрации), 
		    СтрокаТаблицыЗначений.НомерГосРегистрации, СтрокаТаблицыЗначений.ISIN);
		    //ОбластьСтрокаАктивы2.Параметры.Количество = СтрокаТаблицыЗначений.Количество;
			// IMAPPS-30982
			//Если НЕ СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанныеЕПС Тогда
			Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
				ОбластьСтрокаАктивы2.Параметры.БалансовыеДанныеСтоимость = СтрокаТаблицыЗначений.БалансоваяСтоимость;
				ОбластьСтрокаАктивы2.Параметры.БалансовыеДанныеЦена = СтрокаТаблицыЗначений.БалансоваяЦена;
			КонецЕсли;
		    ОбластьСтрокаАктивы2.Параметры.РыночнаяЦена = СтрокаТаблицыЗначений.РыночнаяЦена;
		
		    ОбластьСтрокаАктивы2.Параметры.РыночнаяЦенаЕдИзм = СтрокаТаблицыЗначений.РыночнаяВалютаПредставление;
		
		    ОбластьСтрокаАктивы2.Параметры.ИсточникКотировки = СтрокаТаблицыЗначений.БиржаПредставление;
		    ОбластьСтрокаАктивы2.Параметры.ДатаКотировки = СтрокаТаблицыЗначений.ДатаКотировки;
		
		    ОбластьСтрокаАктивы2.Параметры.НоминалСумма = СтрокаТаблицыЗначений.НоминальнаяСтоимость;
		    ОбластьСтрокаАктивы2.Параметры.НоминалЕдИзм = СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимостиПредставление;
		
		    ОбластьСтрокаАктивы2.Параметры.НКДСумма = 0;
		    ОбластьСтрокаАктивы2.Параметры.НКДЕдИзм = "";
			ОбластьСтрокаАктивы2.Параметры.РыночнаяОценкаRUR = СтрокаТаблицыЗначений.РыночнаяСтоимость; 
			
			Если ОбластьСтрокаАктивы2.Параметры.ТипВложения = "СБСТВ РЕПО" Тогда
				ОбластьСтрокаАктивы2.Параметры.Депозитарий1   			 = "";
				ОбластьСтрокаАктивы2.Параметры.МестоДепозитария1         = "";
				ОбластьСтрокаАктивы2.Параметры.ИННДеп1                   = "";
				ОбластьСтрокаАктивы2.Параметры.ОГРНДеп1                  = "";
				ОбластьСтрокаАктивы2.Параметры.Депозитарий2    			 = "";
				ОбластьСтрокаАктивы2.Параметры.МестоДепозитария2         = "";
				ОбластьСтрокаАктивы2.Параметры.ИННДеп2                   = "";
				ОбластьСтрокаАктивы2.Параметры.ОГРНДеп2                  = "";
			КонецЕсли;
			
			Если PDF Тогда
			ЭтоПоследняяСтрока = Счетчик = ВсегоСтрок; // TM-3208
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаАктивы, ОбластьСтрокаАктивы2, ЭтоПоследняяСтрока);  
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаАктивы2);	
		КонецЕсли;


		Иначе 
			ОбластьСтрокаАктивы.Параметры.НаименованиеЦБ = СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление;
		    ОбластьСтрокаАктивы.Параметры.НомерГосРегистрации = 
		    ?(ЗначениеЗаполнено(СтрокаТаблицыЗначений.НомерГосРегистрации), 
		    СтрокаТаблицыЗначений.НомерГосРегистрации, СтрокаТаблицыЗначений.ISIN);
		    ОбластьСтрокаАктивы.Параметры.Количество = СтрокаТаблицыЗначений.Количество;
			// IMAPPS-30982
			//Если НЕ СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанныеЕПС Тогда
			Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
				ОбластьСтрокаАктивы.Параметры.БалансовыеДанныеСтоимость = СтрокаТаблицыЗначений.БалансоваяСтоимость;
				ОбластьСтрокаАктивы.Параметры.БалансовыеДанныеЦена = СтрокаТаблицыЗначений.БалансоваяЦена;
			КонецЕсли;
		    ОбластьСтрокаАктивы.Параметры.РыночнаяЦена = СтрокаТаблицыЗначений.РыночнаяЦена;
		
		    ОбластьСтрокаАктивы.Параметры.РыночнаяЦенаЕдИзм = СтрокаТаблицыЗначений.РыночнаяВалютаПредставление;
		
		    ОбластьСтрокаАктивы.Параметры.ИсточникКотировки = СтрокаТаблицыЗначений.БиржаПредставление;
		    ОбластьСтрокаАктивы.Параметры.ДатаКотировки = СтрокаТаблицыЗначений.ДатаКотировки;
		
		    ОбластьСтрокаАктивы.Параметры.НоминалСумма = СтрокаТаблицыЗначений.НоминальнаяСтоимость;
		    ОбластьСтрокаАктивы.Параметры.НоминалЕдИзм = СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимостиПредставление;
		
		    ОбластьСтрокаАктивы.Параметры.НКДСумма = 0;
		    ОбластьСтрокаАктивы.Параметры.НКДЕдИзм = "";
		 //IMAPPS-23458
		    Если Строки.Количество() > 0 И ЗначениеЗаполнено(Строки[0].НаименованиеСокращенное) Тогда		
				//IMAPPS-21832++
				//ОбластьСтрокаДвижениеДС.Параметры.Депозитарий = СтрокаТаблицыЗначений.ДепозитарийНаименование;	
				СноскаТекст = "";
				ДанныеСноски = Неопределено;
				
				Если ЗначениеЗаполнено(Строки[0].НаименованиеСокращенное) и НЕ ЗагружатьДанные Тогда
					ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(Строки[0].НаименованиеСокращенное,"Ключ");
					Если ДанныеСноски = Неопределено Тогда
						ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Добавить();
						ДанныеСноски.Ключ = Строки[0].НаименованиеСокращенное;
						ДанныеСноски.Номер = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Количество();
						ДанныеСноски.Сноска = ПолучитьТекстСноски(ДанныеСноски.Номер);
						ДанныеСноски.ТекстСноски = ДанныеСноски.Сноска + " - " + Строки[0].Владелец;
					КонецЕсли;
					
					Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
						ДанныеСноски.ТекстСноски = ДанныеСноски.ТекстСноски + " (до 28.03.2024г. Общество с ограниченной ответственностью Брокерская компания Платформа).";
					КонецЕсли;
					
					СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = ДанныеСноски.Номер;
					СноскаТекст = ДанныеСноски.Сноска;
				КонецЕсли; 
				
				ОбластьСтрокаАктивы.Параметры.Депозитарий = СноскаТекст + СокрЛП(Строки[0].НаименованиеСокращенное);
				//IMAPPS-21832--
				
			ИНаче
				
				ОбластьСтрокаАктивы.Параметры.Депозитарий = "";
			КонецЕсли;
			
			Если Строки.Количество() > 0 И НЕ ЗагружатьДанные И НЕ ОбластьСтрокаАктивы.Параметры.ТипВложения = "СБСТВ РЕПО" тогда  
			   ОбластьСтрокаАктивы.Параметры.МестоДепозитария              = Строки[0].Представление;
			   ОбластьСтрокаАктивы.Параметры.ИННДеп                        = Строки[0].ИНН;
			   ОбластьСтрокаАктивы.Параметры.ОГРНДеп                       = Строки[0].ОГРН;
		   Иначе
			   ОбластьСтрокаАктивы.Параметры.Депозитарий				   = "";
			   ОбластьСтрокаАктивы.Параметры.МестоДепозитария              = "";
			   ОбластьСтрокаАктивы.Параметры.ИННДеп                        = "";
			   ОбластьСтрокаАктивы.Параметры.ОГРНДеп                       = "";
            КонецЕсли;

		    ОбластьСтрокаАктивы.Параметры.РыночнаяОценкаRUR = СтрокаТаблицыЗначений.РыночнаяСтоимость; 
		Если PDF Тогда
			ЭтоПоследняяСтрока = Счетчик = ВсегоСтрок; // TM-3208
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаАктивы, ОбластьСтрокаАктивы, ЭтоПоследняяСтрока);  
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаАктивы);
		КонецЕсли;

	КонецЕсли;
		РыночнаяОценкаUSD = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(
		СтрокаТаблицыЗначений.РыночнаяСтоимость,
		ПредопределенноеЗначение("Справочник.Валюты.RUB"), ПредопределенноеЗначение("Справочник.Валюты.USD"),
		1, ДанныеРаздела.КурсUSD.Курс, 
		1, ДанныеРаздела.КурсUSD.Кратность);
		
		//DDneprovsky IMAPPS-13406
		//ОбластьСтрокаАктивы.Параметры.РыночнаяОценкаUSD = РыночнаяОценкаUSD;
		
		
		ПаиКоличествоИтог 			= ПаиКоличествоИтог + СтрокаТаблицыЗначений.Количество;
		ПаиБалансоваяСуммаИтог 		= ПаиБалансоваяСуммаИтог + СтрокаТаблицыЗначений.БалансоваяСтоимость;
		ПаиНоминалИтог 				= ПаиНоминалИтог + СтрокаТаблицыЗначений.НоминальнаяСтоимость;
		ПаиРыночнаяСуммаRURИтог 	= ПаиРыночнаяСуммаRURИтог + СтрокаТаблицыЗначений.РыночнаяСтоимость;
		ПаиРыночнаяСуммаUSDИтог 	= ПаиРыночнаяСуммаUSDИтог + РыночнаяОценкаUSD;
		
	КонецЦикла; 
	// IMAPPS-30982
	//Если НЕ СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанныеЕПС Тогда
	Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
		ОбластьИтогоАктивы.Параметры.БалансовыеДанныеСтоимость 	= ПаиБалансоваяСуммаИтог;
	КонецЕсли;
	ОбластьИтогоАктивы.Параметры.НКДСумма 					= 0;
	//DDneprovsky IMAPPS-13406
	//ОбластьИтогоАктивы.Параметры.РыночнаяОценкаUSD 			= ПаиРыночнаяСуммаUSDИтог;
	ОбластьИтогоАктивы.Параметры.РыночнаяОценкаRUR 			= ПаиРыночнаяСуммаRURИтог;
	
	Если PDF Тогда
		
		//vtb 01.07.2016
		Если Паи.Количество() <> 0 Тогда
			//ТабличныйДокумент.Вывести(ОбластьИтогоАктивы);
			ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаАктивы, ОбластьИтогоАктивы, ОбластьСтрокаАктивы); // TM-3208			
		КонецЕсли;
		
	Иначе
		
		//vtb 01.07.2016
		Если ВсегоСтрок <> 0 Тогда
			//ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаАктивы, ОбластьИтогоАктивы, ОбластьСтрокаАктивы); // TM-3208
			ТабличныйДокумент.Вывести(ОбластьИтогоАктивы);
		КонецЕсли;
		
	КонецЕсли; 
	
	Если НЕ СкрыватьБалансовуюСтоимость Тогда
		СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.БалансоваяСтоимость = СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.БалансоваяСтоимость + ПаиБалансоваяСуммаИтог;
	Конецесли;	
	СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.РыночнаяСтоимость = СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.РыночнаяСтоимость + ПаиРыночнаяСуммаRURИтог;


	
КонецФункции 

Функция ОбработатьИСУ(ИСУ, ДанныеРаздела, СтруктураОтчета, PDF, ТабличныйДокумент, СтруктураОбластей) 
	
	Депозитарий = ДанныеРаздела.ДанныеДепозитария; 
	
	ОбластьСтрокаАктивы2 = СтруктураОбластей.ОбластьСтрокаАктивы2;
	ОбластьСтрокаАктивы = СтруктураОбластей.ОбластьСтрокаАктивы; 
	ОбластьШапкаАктивы = СтруктураОбластей.ОбластьШапкаАктивы;
	ОбластьИтогоАктивы = СтруктураОбластей.ОбластьИтогоАктивы;
	
	ИсуКоличествоИтог 		= 0;
	ИсуБалансоваяСуммаИтог 	= 0;
	ИсуНоминалИтог 			= 0;
	ИсуРыночнаяСуммаRURИтог 	= 0;
	ИсуРыночнаяСуммаUSDИтог 	= 0;
	РыночнаяОценкаUSD			= 0;             
	//IMAPPS-24443
	
		
	Счетчик = 0;                   // TM-3208
	ВсегоСтрок = ИСУ.Количество(); // TM-3208
	
	Для Каждого СтрокаТаблицыЗначений Из ИСУ Цикл
		
		//&_Галимов_Начало 28.12.2016 21:29:08
		//очистим
		//СтруктураПараметровЕПС = Новый Структура;
		//СтруктураПараметровЕПС.Вставить("ТипВложения", "");
		//ОбластьСтрокаАктивы.Параметры.Заполнить(СтруктураПараметровЕПС);
		//&_Галимов_Конец 28.12.2016 21:29:09
		
		Если СтрокаТаблицыЗначений.Количество = 0 Тогда
			Продолжить;
		Конецесли;
		Счетчик = Счетчик + 1; 
		
		Отбор = Новый Структура();
		Отбор.Вставить("АктивНаименование",СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление);
		Строки = Депозитарий.НайтиСтроки(Отбор);
		Если Строки.Количество() > 1 и НЕ ЗагружатьДанные Тогда
			ОбластьСтрокаАктивы2.Параметры.Депозитарий1    = Строки[0].НаименованиеСокращенное;
		    ОбластьСтрокаАктивы2.Параметры.МестоДепозитария1              = Строки[0].Представление;
		    ОбластьСтрокаАктивы2.Параметры.ИННДеп1                        = Строки[0].ИНН;
		    ОбластьСтрокаАктивы2.Параметры.ОГРНДеп1                       = Строки[0].ОГРН;
	        ОбластьСтрокаАктивы2.Параметры.Депозитарий2    = Строки[1].НаименованиеСокращенное;
		    ОбластьСтрокаАктивы2.Параметры.МестоДепозитария2              = Строки[1].Представление;
		    ОбластьСтрокаАктивы2.Параметры.ИННДеп2                        = Строки[1].ИНН;
		    ОбластьСтрокаАктивы2.Параметры.ОГРНДеп2                       = Строки[1].ОГРН; 
	        ОбластьСтрокаАктивы2.Параметры.Количество1 = Строки[0].Количество;
            ОбластьСтрокаАктивы2.Параметры.Количество2 = Строки[1].Количество;
		    ОбластьСтрокаАктивы2.Параметры.НаименованиеЦБ = СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление;
		    ОбластьСтрокаАктивы2.Параметры.НомерГосРегистрации = 
		    ?(ЗначениеЗаполнено(СтрокаТаблицыЗначений.НомерГосРегистрации), 
		    СтрокаТаблицыЗначений.НомерГосРегистрации, СтрокаТаблицыЗначений.ISIN);
		    //ОбластьСтрокаАктивы2.Параметры.Количество = СтрокаТаблицыЗначений.Количество;
			// IMAPPS-30982
			//Если НЕ СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанныеЕПС Тогда
			Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
				ОбластьСтрокаАктивы2.Параметры.БалансовыеДанныеСтоимость = СтрокаТаблицыЗначений.БалансоваяСтоимость;
				ОбластьСтрокаАктивы2.Параметры.БалансовыеДанныеЦена = СтрокаТаблицыЗначений.БалансоваяЦена;
			КонецЕсли;
		    ОбластьСтрокаАктивы2.Параметры.РыночнаяЦена = СтрокаТаблицыЗначений.РыночнаяЦена;
		
		    ОбластьСтрокаАктивы2.Параметры.РыночнаяЦенаЕдИзм = СтрокаТаблицыЗначений.РыночнаяВалютаПредставление;
		
		    ОбластьСтрокаАктивы2.Параметры.ИсточникКотировки = СтрокаТаблицыЗначений.БиржаПредставление;
		    ОбластьСтрокаАктивы2.Параметры.ДатаКотировки = СтрокаТаблицыЗначений.ДатаКотировки;
		
		    ОбластьСтрокаАктивы2.Параметры.НоминалСумма = СтрокаТаблицыЗначений.НоминальнаяСтоимость;
		    ОбластьСтрокаАктивы2.Параметры.НоминалЕдИзм = СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимостиПредставление;
		
		    ОбластьСтрокаАктивы2.Параметры.НКДСумма = 0;
		    ОбластьСтрокаАктивы2.Параметры.НКДЕдИзм = "";
		
		    ОбластьСтрокаАктивы2.Параметры.РыночнаяОценкаRUR = СтрокаТаблицыЗначений.РыночнаяСтоимость; 
			
			Если ОбластьСтрокаАктивы2.Параметры.ТипВложения = "СБСТВ РЕПО" Тогда
				ОбластьСтрокаАктивы2.Параметры.Депозитарий1   			 = "";
				ОбластьСтрокаАктивы2.Параметры.МестоДепозитария1         = "";
				ОбластьСтрокаАктивы2.Параметры.ИННДеп1                   = "";
				ОбластьСтрокаАктивы2.Параметры.ОГРНДеп1                  = "";
				ОбластьСтрокаАктивы2.Параметры.Депозитарий2    			 = "";
				ОбластьСтрокаАктивы2.Параметры.МестоДепозитария2         = "";
				ОбластьСтрокаАктивы2.Параметры.ИННДеп2                   = "";
				ОбластьСтрокаАктивы2.Параметры.ОГРНДеп2                  = "";
			КонецЕсли;

            Если PDF Тогда
				ЭтоПоследняяСтрока = Счетчик = ВсегоСтрок; // TM-3208
			    ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаАктивы, ОбластьСтрокаАктивы2, ЭтоПоследняяСтрока);  
		    Иначе
			    ТабличныйДокумент.Вывести(ОбластьСтрокаАктивы2);
		    КонецЕсли;
		
		Иначе
			ОбластьСтрокаАктивы.Параметры.НаименованиеЦБ = СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление;
		    ОбластьСтрокаАктивы.Параметры.НомерГосРегистрации = 
		    ?(ЗначениеЗаполнено(СтрокаТаблицыЗначений.НомерГосРегистрации), 
		    СтрокаТаблицыЗначений.НомерГосРегистрации, СтрокаТаблицыЗначений.ISIN);
		    ОбластьСтрокаАктивы.Параметры.Количество = СтрокаТаблицыЗначений.Количество;
			// IMAPPS-30982
			//Если НЕ СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанныеЕПС Тогда
			Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
				ОбластьСтрокаАктивы.Параметры.БалансовыеДанныеСтоимость = СтрокаТаблицыЗначений.БалансоваяСтоимость;
		        ОбластьСтрокаАктивы.Параметры.БалансовыеДанныеЦена = СтрокаТаблицыЗначений.БалансоваяЦена; 
			КонецЕсли;
		    ОбластьСтрокаАктивы.Параметры.РыночнаяЦена = СтрокаТаблицыЗначений.РыночнаяЦена;
		
		    ОбластьСтрокаАктивы.Параметры.РыночнаяЦенаЕдИзм = СтрокаТаблицыЗначений.РыночнаяВалютаПредставление;
		
		    ОбластьСтрокаАктивы.Параметры.ИсточникКотировки = СтрокаТаблицыЗначений.БиржаПредставление;
		    ОбластьСтрокаАктивы.Параметры.ДатаКотировки = СтрокаТаблицыЗначений.ДатаКотировки;
		
		    ОбластьСтрокаАктивы.Параметры.НоминалСумма = СтрокаТаблицыЗначений.НоминальнаяСтоимость;
		    ОбластьСтрокаАктивы.Параметры.НоминалЕдИзм = СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимостиПредставление;
		
		    ОбластьСтрокаАктивы.Параметры.НКДСумма = 0;
		    ОбластьСтрокаАктивы.Параметры.НКДЕдИзм = "";
		
		    ОбластьСтрокаАктивы.Параметры.РыночнаяОценкаRUR = СтрокаТаблицыЗначений.РыночнаяСтоимость;
		 //IMAPPS-23458
		    Если ЗначениеЗаполнено(Строки[0].НаименованиеСокращенное)  и НЕ ЗагружатьДанные Тогда		
				//IMAPPS-21832++
				//ОбластьСтрокаДвижениеДС.Параметры.Депозитарий = СтрокаТаблицыЗначений.ДепозитарийНаименование;	
				СноскаТекст = "";
				ДанныеСноски = Неопределено;
				
				Если ЗначениеЗаполнено(Строки[0].НаименованиеСокращенное) Тогда
					ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(Строки[0].НаименованиеСокращенное,"Ключ");
					Если ДанныеСноски = Неопределено Тогда
						ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Добавить();
						ДанныеСноски.Ключ = Строки[0].НаименованиеСокращенное;
						ДанныеСноски.Номер = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Количество();
						ДанныеСноски.Сноска = ПолучитьТекстСноски(ДанныеСноски.Номер);
						ДанныеСноски.ТекстСноски = ДанныеСноски.Сноска + " - " + Строки[0].Владелец;
					КонецЕсли;
					
					Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
						ДанныеСноски.ТекстСноски = ДанныеСноски.ТекстСноски + " (до 28.03.2024г. Общество с ограниченной ответственностью Брокерская компания Платформа).";
					КонецЕсли;
					
					СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = ДанныеСноски.Номер;
					СноскаТекст = ДанныеСноски.Сноска;
				КонецЕсли; 
				
				ОбластьСтрокаАктивы.Параметры.Депозитарий = СноскаТекст + СокрЛП(Строки[0].НаименованиеСокращенное);
				//IMAPPS-21832--
				
			ИНачеЕсли НЕ ЗагружатьДанные тогда 
				
				ОбластьСтрокаАктивы.Параметры.Депозитарий = "";
			КонецЕсли;
			
			Если Строки.Количество() > 0 И НЕ ЗагружатьДанные И НЕ ОбластьСтрокаАктивы.Параметры.ТипВложения = "СБСТВ РЕПО" тогда  
			   ОбластьСтрокаАктивы.Параметры.МестоДепозитария              = Строки[0].Представление;
			   ОбластьСтрокаАктивы.Параметры.ИННДеп                        = Строки[0].ИНН;
			   ОбластьСтрокаАктивы.Параметры.ОГРНДеп                       = Строки[0].ОГРН;
		   Иначе
			   ОбластьСтрокаАктивы.Параметры.Депозитарий				   = "";
			   ОбластьСтрокаАктивы.Параметры.МестоДепозитария              = "";
			   ОбластьСтрокаАктивы.Параметры.ИННДеп                        = "";
			   ОбластьСтрокаАктивы.Параметры.ОГРНДеп                       = "";
           КонецЕсли;

			Если PDF Тогда
				ЭтоПоследняяСтрока = Счетчик = ВсегоСтрок; // TM-3208
			    ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаАктивы, ОбластьСтрокаАктивы, ЭтоПоследняяСтрока);  
		    Иначе
			    ТабличныйДокумент.Вывести(ОбластьСтрокаАктивы);
		    КонецЕсли; 
		
	КонецЕсли;
	
		
		РыночнаяОценкаUSD = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(
		СтрокаТаблицыЗначений.РыночнаяСтоимость,
		ПредопределенноеЗначение("Справочник.Валюты.RUB"), ПредопределенноеЗначение("Справочник.Валюты.USD"),
		1, ДанныеРаздела.КурсUSD.Курс, 
		1, ДанныеРаздела.КурсUSD.Кратность);
		
		//DDneprovsky IMAPPS-13406
		//ОбластьСтрокаАктивы.Параметры.РыночнаяОценкаUSD = РыночнаяОценкаUSD;
		
		
		ИсуКоличествоИтог 			= ИсуКоличествоИтог + СтрокаТаблицыЗначений.Количество;
		ИсуБалансоваяСуммаИтог 		= ИсуБалансоваяСуммаИтог + СтрокаТаблицыЗначений.НоминальнаяСтоимость;
		ИсуНоминалИтог 				= ИсуНоминалИтог + СтрокаТаблицыЗначений.НоминальнаяСтоимость;
		ИсуРыночнаяСуммаRURИтог 	= ИсуРыночнаяСуммаRURИтог + СтрокаТаблицыЗначений.РыночнаяСтоимость;
		ИсуРыночнаяСуммаUSDИтог 	= ИсуРыночнаяСуммаUSDИтог + РыночнаяОценкаUSD;
		
	КонецЦикла;  
	// IMAPPS-30982
	//Если НЕ СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанныеЕПС Тогда
	Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
		ОбластьИтогоАктивы.Параметры.БалансовыеДанныеСтоимость 	= ИсуБалансоваяСуммаИтог;
	КонецЕсли;
	
	ОбластьИтогоАктивы.Параметры.НКДСумма 					= 0;
	//DDneprovsky IMAPPS-13406
	//ОбластьИтогоАктивы.Параметры.РыночнаяОценкаUSD 			= ИсуРыночнаяСуммаUSDИтог;
	ОбластьИтогоАктивы.Параметры.РыночнаяОценкаRUR 			= ИсуРыночнаяСуммаRURИтог;
	
	Если PDF Тогда
		
		//vtb 01.07.2016
		Если ВсегоСтрок <> 0 Тогда
			ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаАктивы, ОбластьИтогоАктивы, ОбластьСтрокаАктивы); // TM-3208
		КонецЕсли;
		
	Иначе
		
		//vtb 01.07.2016
		Если ИСУ.Количество() <> 0 Тогда
			ТабличныйДокумент.Вывести(ОбластьИтогоАктивы);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ СкрыватьБалансовуюСтоимость Тогда
		СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.БалансоваяСтоимость = СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.БалансоваяСтоимость + ИСУБалансоваяСуммаИтог;
	КонецЕсли;	
	СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.РыночнаяСтоимость = СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.РыночнаяСтоимость + ИСУРыночнаяСуммаRURИтог;


КонецФункции

Функция ОбработатьКорпоративныеОблигации(КорпоративныеОблигации, ДанныеРаздела, СтруктураОтчета, PDF, ТабличныйДокумент, СтруктураОбластей, СтруктураОбластейКорпОблигаций) 

	Депозитарий = ДанныеРаздела.ДанныеДепозитария;
	
	
	ОбластьСтрокаКорпОблигации = СтруктураОбластейКорпОблигаций.ОбластьСтрокаКорпОблигации;
