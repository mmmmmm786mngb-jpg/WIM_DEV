	УчитыватьСделкиРЕПОКакПокупкаПродажа	= УправлениеПараметрамиДоговораДУ.ПолучитьПараметрДоговораДУ(ДоговорДУ,ПланыВидовХарактеристик.ПараметрыДоговораДУ.УчитыватьСделкиРЕПОКакПокупкаПродажа,КонецДня(ДатаОкончания)) = Истина;
	УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ	= УправлениеПараметрамиДоговораДУ.ПолучитьПараметрДоговораДУ(ДоговорДУ,ПланыВидовХарактеристик.ПараметрыДоговораДУ.УчитыватьСделкиРЕПОСогласноПисьмаЦБ_УУ,КонецДня(ДатаОкончания)) = Истина;
