			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаКорпОблигации, ОбластьСтрокаКорпОблигации, ЭтоПоследняяСтрока);  
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаКорпОблигации);
		КонецЕсли;
	КонецЕсли;	
	
		
		ИпОблКоличествоИтог 			= ИпОблКоличествоИтог + СтрокаТаблицыЗначений.Количество;
		ИпОблБалансоваяСуммаИтог 		= ИпОблБалансоваяСуммаИтог + СтрокаТаблицыЗначений.БалансоваяСтоимость;
		ИпОблНоминалИтог 				= ИпОблНоминалИтог + НоминальнаяСтоимость;
		ИпОблРыночнаяСуммаRURИтог 		= ИпОблРыночнаяСуммаRURИтог + РыночнаяОценкаRUR;
		ИпОблРыночнаяСуммаUSDИтог 		= ИпОблРыночнаяСуммаUSDИтог + РыночнаяОценкаUSD;
		ИпОблБалансовыйНКДИтог			= ИпОблБалансовыйНКДИтог + ?(ЗагружатьДанные И СтрокаТаблицыЗначений.БалансоваяСтоимость = 0, 0,СтрокаТаблицыЗначений.НКД);
		ИпОблУпрНКДИтог				= ИпОблУпрНКДИтог + СтрокаТаблицыЗначений.УпрНКД;
		
	КонецЦикла; 
	
	// IMAPPS-30982
