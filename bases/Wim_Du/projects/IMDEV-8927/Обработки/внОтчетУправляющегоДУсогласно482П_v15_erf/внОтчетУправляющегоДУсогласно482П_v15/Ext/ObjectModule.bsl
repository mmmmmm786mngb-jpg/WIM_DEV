		   // 		СноскаТекст = ДанныеСноски.Сноска;
		   // 	КонецЕсли; 
		   // 	
		   // 	ОбластьСтрокаКорпОблигации.Параметры.Депозитарий = СноскаТекст + СокрЛП(Строки[0].НаименованиеСокращенное);
		   // 	//IMAPPS-21832--
				
			Если НЕ ЗагружатьДанные тогда
				
				ОбластьСтрокаКорпОблигации.Параметры.Депозитарий = "";
			КонецЕсли;	
			
