		   // 		ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(Строки[0].НаименованиеСокращенное,"Ключ");
		   // 		Если ДанныеСноски = Неопределено Тогда
		   // 			ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Добавить();
		   // 			ДанныеСноски.Ключ = Строки[0].НаименованиеСокращенное;
