	#КонецОбласти
	
	#Область ЦенныеБумагиСобственные  
	
	ОбластьТипВложения.Параметры.ТипВложения = "ЦЕННЫЕ БУМАГИ СОБСТВЕННЫЕ";  
		
	СтруктураОтбора.ТипСделки = "ЭтоРепо"; 
	СтруктураОтбора.ТипВложения = "СБСТВ";
	СтруктураОтбора.Признак = Ложь;
	ОбработатьАктивыПоТипамВложений(СтруктураОтбора, ДанныеРаздела, СтруктураОтчета, PDF, ТабличныйДокумент, СтруктураОбластей, СтруктураОбластейКорпОблигаций); 
	
	#КонецОбласти
  
	
	#Область ГосОблигации
	
	ИпотечныеОблигации = ДанныеРаздела.ИпотечныеОблигации;
	
	
	
	#КонецОбласти 
	
	
	#Область ИтогиЦенныеБумаги
	
	ТабличныйДокумент.Вывести(ОбластьШапкаВсегоЦБ);
	// IMAPPS-30982
