Функция СчетаУчетаАктивовЕПС(ВнешнееСоединение)
	
	Запрос = ВнешнееСоединение.NewObject("Запрос",
	"ВЫБРАТЬ
	|	ЕПС.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ИсключенныеСчета
	|ИЗ
	|	ПланСчетов.ЕПС КАК ЕПС
	|ГДЕ
	|	ЕПС.Код МЕЖДУ ""509"" И ""512""
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПС.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПС КАК ЕПС
	|ГДЕ
	// VTB-Borisov  - 28.11.2017 {
	//очень странный код, но ломать не будем
	//|	ЕПС.Код МЕЖДУ ""5"" И ""526""
	|	((ЕПС.Код МЕЖДУ ""5"" И ""526"") или (ЕПС.Ссылка в Иерархии ( ЗНАЧЕНИЕ(Плансчетов.ЕПС.ПроизводныеФинансовыеИнструменты))))
	// VTB-Borisov  - 28.11.2017 }
	|	И ЕПС.ЗапретитьИспользоватьВПроводках = ЛОЖЬ
	|	И НЕ ЕПС.Ссылка В (&СчетаУчетаАктивовЕПСПрямоеРЕПО)
	|	И НЕ ЕПС.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТ_ИсключенныеСчета.Ссылка
	|				ИЗ
	|					ВТ_ИсключенныеСчета)");
	
	Запрос.УстановитьПараметр("СчетаУчетаАктивовЕПСПрямоеРЕПО", СчетаУчетаАктивовЕПСПрямоеРЕПО(ВнешнееСоединение));	
	
