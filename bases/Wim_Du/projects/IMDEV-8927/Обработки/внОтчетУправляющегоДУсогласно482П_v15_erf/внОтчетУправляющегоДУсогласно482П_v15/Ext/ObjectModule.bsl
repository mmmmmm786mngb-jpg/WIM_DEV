//IMAPPS-21832++
Функция ПолучитьТекстСноски(НомерСноски)
	//Возвращаем строку в верхнем индексе
	Результат = "";
	
	Если ТипЗнч(НомерСноски) = Тип("Число") Тогда
		ТекстСноски = Формат(НомерСноски,"ЧН=0; ЧГ=0");
	Иначе
		ТекстСноски = Строка(НомерСноски);
	КонецЕсли;
	
	Для Сч = 1 По СтрДлина(ТекстСноски) Цикл
		ТекСимвол = Сред(ТекстСноски,Сч,1);
		СимволВерхнийИндекс = СоответствиеСимволовВерхнийИндекс.Получить(ТекСимвол);
		Если СимволВерхнийИндекс = Неопределено Тогда
			СимволВерхнийИндекс = ТекСимвол;
		КонецЕсли;
		Результат = Результат + СимволВерхнийИндекс;
	КонецЦикла;
	
	Возврат Результат;
	
