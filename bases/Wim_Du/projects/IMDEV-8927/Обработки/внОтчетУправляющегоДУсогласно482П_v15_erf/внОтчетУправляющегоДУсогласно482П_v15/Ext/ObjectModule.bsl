		Сообщить("Не удается получить информацию о текущем принтере");
	КонецПопытки;
	
	//IMAPPS-21832++
	Если не СтруктураОтчета = Неопределено Тогда
		ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, Истина, Не Помещается, Ложь, Ложь);
	КонецЕсли;
	//IMAPPS-21832--
	
	Если Не Помещается Тогда
		Макет = ПолучитьМакет("Макет");
		ОбластьЧертаКолонтитула = Макет.ПолучитьОбласть("ЧертаКолонтитула");
		
