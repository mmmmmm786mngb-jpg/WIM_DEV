		ВыводимыеОбласти.Добавить(СтруктураОтчета.ДанныеСносок.СобранныеСноски); //Ранее "добавленные" и проверенные сноски
		ВыводимыеОбласти.Добавить(СтруктураОтчета.ДанныеСносок.ОбластьСноска); //Новая сноска вместе с текущей строкой
	КонецЕсли;
	//IMAPPS-21832--
	
	Помещается = Истина;
	Попытка
