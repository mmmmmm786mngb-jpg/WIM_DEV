Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	НоваяКоманда = Команды.Добавить();
	НоваяКоманда.Представление = "Отчет управляющего ДУ, согласно 577П"; 
	НоваяКоманда.Идентификатор = "Отчет управляющего ДУ, согласно 482П_новая версия отчёта, использовать с 01.10.2017 (ускор.)";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	
	Возврат Команды;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	//Путь = "\\corp\Applications\VTBAM\1C\test\svc_im_avancore_uat\asharunov\внОтчетУправляющегоДУсогласно482П_v15.erf";
	//Обр = ВнешниеОтчеты.Создать(Путь, Ложь);
	//Обр.ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды);
	//Возврат;
	
	ДополнительнаяОбработкаСсылка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
	
	Если ИдентификаторКоманды = "ФоновоеВыполнение" Тогда 
		ТекстовыйЛог = "";
		ЕстьПредупреждения = Ложь;
		ЕстьОшибки = Ложь;
		ФормироватьЕжеквартальныеОтчеты = Ложь;
		ФормироватьОтчетыПриРасторжении = Ложь;
		
		// IMDEV-8927 ++
		ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;
		// IMDEV-8927 --
		
		Попытка
		
			ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
			
			РежимРаботы = 2;
			
			Таблица = ПолучитьНеВыгруженныеОтчетыДУ();
			Если Таблица.Количество() = 0 Тогда
				
				ДатаФормированияОтчета = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, ТекущаяДата(), -1);
				НачалоДня = НачалоДня(ДатаФормированияОтчета);
				НачалоТекущегоКвартала = НачалоКвартала(НачалоДня);
				ОкончаниеПредыдущегоКвартала = НачалоТекущегоКвартала - 86400;
				НачалоПредыдущегоКвартала = НачалоКвартала(ОкончаниеПредыдущегоКвартала);
				
				Если НачалоДня = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, ОкончаниеПредыдущегоКвартала, КоличествоДнейПослеОкончанияКвартала) Тогда
					ФормироватьЕжеквартальныеОтчеты = Истина;
				КонецЕсли;
				
				Если ФормироватьЕжеквартальныеОтчеты = Истина Тогда
					ДатаНачала = НачалоПредыдущегоКвартала;
					ДатаОкончания = ОкончаниеПредыдущегоКвартала;
					
					СписокДоговоровДУ = Новый СписокЗначений;
					ЗаполнитьСписокДоговоровКлиентамиРозничногоДУ(СписокДоговоровДУ, ДатаОкончания);
					ЗарегистрироватьСостояниеВыгрузкиОтчетовДУ(СписокДоговоровДУ.ВыгрузитьЗначения(), "ЗаКвартал");
					МассоваяВыгрузкаПоКлиентамРозничногоДУ();
				КонецЕсли;
				
				ДатаРасторжения = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, НачалоДня, -КоличествоДнейПослеРасторженияДоговораДУ);
				
				СписокДоговоровДУ = ПолучитьСписокДоговоровРозничногоДУНаРасторжение(ДатаРасторжения);
				
				Если СписокДоговоровДУ.Количество() > 0 Тогда
					ФормироватьОтчетыПриРасторжении = Истина;
				КонецЕсли;
				
				Если ФормироватьОтчетыПриРасторжении = Истина Тогда
					ДатаНачала = НачалоКвартала(ДатаРасторжения);
					ДатаОкончания = ДатаРасторжения;
					
					ЗарегистрироватьСостояниеВыгрузкиОтчетовДУ(СписокДоговоровДУ.ВыгрузитьЗначения(), "ПриРасторжении");
					МассоваяВыгрузкаПоКлиентамРозничногоДУ();
				КонецЕсли;
				
			Иначе
				ДобавитьТекстСообщения(ТекстовыйЛог, "Предыдущая выгрузка завершилась с ошибкой. Выгружаются только те договора ДУ, по которым выгрузка отчетов не была завершена");
				МассоваяВыгрузкаПоКлиентамРозничногоДУ();
			КонецЕсли;
		
		Исключение
			Инфо = ОписаниеОшибки();
			ДобавитьТекстСообщения(ТекстовыйЛог, Инфо);
			ЕстьОшибки = Истина;
		КонецПопытки;
		
		Если СписокРассылки.Количество()>0 И Не ПочтовыйЛогин.Пустая() тогда
			
			текстРассылки = СформироватьИОтправитьПисьмо(НачалоДня);
			
		КонецЕсли;
		
		// IMDEV-8927 ++
		ИдентификаторКомандыДляЗамера = Неопределено;
		// IMDEV-8927 --
		
	КонецЕсли;
	
КонецПроцедуры

// IMDEV-8927 ++
// Описание: Добавляет в комментарий замера скорость обработки (вес / время), об/с.
//
// Параметры:
// Вес - Число - количество обработанных объектов
// ВремяНачала - Число - метка начала замера в миллисекундах
//
// Возвращаемое значение:
// Строка - фрагмент комментария вида "; УдельныйВес=1.25 об/с"
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)
	
	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);
	
	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";
	
КонецФункции

// Описание: Формирует имя ключевой операции БСП для замера
// по этапу обработки и контуру запуска.
//
// Параметры:
// ЭтапЗамера - Строка - этап замера (например, МассоваяВыгрузка)
//
// Возвращаемое значение:
// Строка - имя ключевой операции в формате ДУ.ОтчетУправляющегоДУ.<Этап>.<Контур>
//
Функция ПолучитьИмяКлючевойОперацииЗамера(Знач ЭтапЗамера)
	Возврат "ДУ.ОтчетУправляющегоДУ." + ЭтапЗамера + "."
		+ ?(ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера), ИдентификаторКомандыДляЗамера, "Ручной");
КонецФункции
