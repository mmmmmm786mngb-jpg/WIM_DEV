Функция ОснованиеДвиженияЦБ(Документ) // TM-3208
	
	Результат = Документ.Номер;	
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.Сделка") Тогда
		
		Если Документ.ВнебиржеваяСделка = Истина Тогда
			
			Если ЗначениеЗаполнено(Документ.БизнесПроцесс) Тогда
				Результат = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Документ.БизнесПроцесс, "Номер");
			КонецЕсли;  
			
		Иначе			
			Результат = Документ.НомерВходящегоДокумента;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СделкаРЕПОПерваяНога")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.СделкаРЕПОВтораяНога") Тогда
		
		Результат = Документ.НомерВходящегоДокумента;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

