	Возврат РезультатЗапроса.ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

Функция СчетаХозрасчетныйЦБСобственные(ВнешнееСоединение) 
	
	// 58.01, 58.02 и 58.03
	ПС = ВнешнееСоединение.ПланыСчетов.Хозрасчетный;
	
	СчетаАкций = ВнешнееСоединение.NewObject("Массив");
	СчетаАкций.Добавить(ПС.Акции);
	СчетаАкций.Добавить(ПС.АкцииТело);
	СчетаАкций.Добавить(ПС.АкцииПереоценка);
	СчетаАкций.Добавить(ПС.АкцииЗатратыПоПриобретению); 
	
	СчетаОблигаций = ВнешнееСоединение.NewObject("Массив");
	СчетаОблигаций.Добавить(ПС.Облигации);
	СчетаОблигаций.Добавить(ПС.ОблигацииТело); 	
	СчетаОблигаций.Добавить(ПС.ОблигацииПереоценка);	
	СчетаОблигаций.Добавить(ПС.ОблигацииЗатратыПоПриобретению);
	
	СчетаУчетаНКД = ВнешнееСоединение.NewObject("Массив");
	СчетаУчетаНКД.Добавить(ПС.НКДПоОблигациям);
	СчетаУчетаНКД.Добавить(ПС.УплаченныйНКД_58);
	СчетаУчетаНКД.Добавить(ПС.НачисленныйНКД_58);
	СчетаУчетаНКД.Добавить(ПС.НачисленныйНКДПоСтруктурнымНотам_58);
	
	СчетаПереоценка = ВнешнееСоединение.NewObject("Массив");
	СчетаПереоценка.Добавить(ПС.ОблигацииПереоценка);
	СчетаПереоценка.Добавить(ПС.АкцииПереоценка);
	
	Возврат Новый Структура("СчетаАкций,СчетаОблигаций,СчетаУчетаНКД,СчетаПереоценка", СчетаАкций, СчетаОблигаций,СчетаУчетаНКД, СчетаПереоценка);   
	
КонецФункции

Процедура ДополнитьДаннымиЕПС_ТипВложения(ДанныеЕПС, ТаблицаЦБ)
	
	Если ТаблицаЦБ.Колонки.Найти("ТипВложения") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("ТипВложения", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("Порядок") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("НаименованиеЦБ") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("НаименованиеЦБ");
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("БалансовыеДанныеНКД") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("БалансовыеДанныеНКД", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("НКД") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("НКД", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("НоминальнаяСтоимость") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("НоминальнаяСтоимость", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("РыночнаяСтоимость") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("РыночнаяСтоимость", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("Количество") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("НомерГосРегистрации") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("НомерГосРегистрации", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("БалансоваяСтоимость") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("БалансоваяСтоимость", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("БалансоваяЦена") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("БалансоваяЦена", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("ISIN") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("ISIN", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	Если ТаблицаЦБ.Колонки.Найти("ЦеннаяБумагаПредставление") = Неопределено Тогда
		ТаблицаЦБ.Колонки.Добавить("ЦеннаяБумагаПредставление", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	Если Не ЗагружатьДанные Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из ТаблицаЦБ Цикл
		Строка.НаименованиеЦБ = Строка.ЦеннаяБумага;
	КонецЦикла;
	
	Для каждого ТекСтрока Из ТаблицаЦБ Цикл
		
		Если Не ЗначениеЗаполнено(ТекСтрока.НаименованиеЦБ) Тогда
			Продолжить;
		КонецЕсли;	
		
		НайденнаяСтрока = ДанныеЕПС.Найти(СокрЛП(ТекСтрока.ISIN), "ISIN");
		
		Если НайденнаяСтрока <> Неопределено Тогда
			
			Если НайденнаяСтрока.СуммаОстатокСобственные <> 0 Тогда
				
				ТекСтрока.ТипВложения = "СБСТВ";
				ТекСтрока.БалансоваяСтоимость = НайденнаяСтрока.СуммаОстатокСобственные;
				ТекСтрока.Порядок = 1;
				ТекСтрока.БалансовыеДанныеНКД = НайденнаяСтрока.СуммаНКД;
				ТекСтрока.НКД = НайденнаяСтрока.СуммаНКД;
				
				Если ТекСтрока.Количество <> 0 Тогда
					ТекСтрока.БалансоваяЦена = ТекСтрока.БалансоваяСтоимость / ТекСтрока.Количество;
				Иначе
					ТекСтрока.БалансоваяЦена = 0;
				КонецЕсли;
				
			КонецЕсли;	
			
			Если НайденнаяСтрока.СуммаОстатокПереданные <> 0 Тогда
				
				Если ЗначениеЗаполнено(ТекСтрока.ТипВложения) Тогда
					НоваяСтрока = ТаблицаЦБ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока, , "НаименованиеЦБ");
					НоваяСтрока.Порядок = 2;
				Иначе
					НоваяСтрока = ТекСтрока;
					НоваяСтрока.Порядок = 1;
				КонецЕсли;
				
				НоваяСтрока.ТипВложения = "СБСТВ РЕПО";
				НоваяСтрока.БалансоваяСтоимость = НайденнаяСтрока.СуммаОстатокПереданные;
				НоваяСтрока.НКД = НайденнаяСтрока.СуммаНКД;
				НоваяСтрока.БалансовыеДанныеНКД = НайденнаяСтрока.СуммаНКД;
				
				Если НоваяСтрока.Количество <> 0 Тогда
					НоваяСтрока.БалансоваяЦена = НоваяСтрока.БалансоваяСтоимость / НоваяСтрока.Количество;
				Иначе
					НоваяСтрока.БалансоваяЦена = 0;
				КонецЕсли;
				
			КонецЕсли;
			
			//Если НайденнаяСтрока.СуммаОстатокПолученные <> 0 Тогда
			//	
			//	Если ЗначениеЗаполнено(ТекСтрока.ТипВложения) Тогда
			//		НоваяСтрока = ТаблицаЦБ.Добавить();
			//		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока, , "НаименованиеЦБ");
			//		НоваяСтрока.Порядок = 3;
			//	Иначе
			//		НоваяСтрока = ТекСтрока;
			//		НоваяСтрока.Порядок = 1;
			//	КонецЕсли;
			//	
			//	НоваяСтрока.ТипВложения = "ПОЛУЧ РЕПО";
			//	НоваяСтрока.БалансоваяСтоимость = НайденнаяСтрока.СуммаОстатокПолученные;
			//	НоваяСтрока.НКД = НайденнаяСтрока.СуммаНКД;
			//	НоваяСтрока.БалансовыеДанныеНКД = НайденнаяСтрока.СуммаНКД;
			//	
			//	Если НоваяСтрока.Количество <> 0 Тогда
			//		НоваяСтрока.БалансоваяЦена = НоваяСтрока.БалансоваяСтоимость / НоваяСтрока.Количество;
			//	Иначе
			//		НоваяСтрока.БалансоваяЦена = 0;
			//	КонецЕсли;
			//	
			//КонецЕсли;
			
		Иначе
			
			ТекСтрока.ТипВложения = "";
			ТекСтрока.БалансоваяСтоимость = 0;
			ТекСтрока.Порядок = 1;
			ТекСтрока.БалансовыеДанныеНКД = 0;
			ТекСтрока.БалансоваяЦена = 0;
			ТекСтрока.НКД = 0;
			
		КонецЕсли;	
		
		Если ТекСтрока.ЭтоРепо И ЗагружатьДанные = Ложь Тогда
			ТекСтрока.ТипВложения = "ПОЛУЧ РЕПО";		
			ТекСтрока.БалансоваяСтоимость = 0;
			ТекСтрока.БалансоваяЦена = 0;
			ТекСтрока.БалансовыеДанныеНКД = 0;
			ТекСтрока.Котировка = 0;
			ТекСтрока.НКД = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаЦБ.Сортировать("ЦеннаяБумага, Порядок");
	
КонецПроцедуры	

Процедура ДополнитьДаннымиЕПС_НезавершенныеСделки(ДанныеЕПС, ТаблицаЦБ)
	
	Если ТаблицаЦБ.Колонки.Найти("СправедливаяСтоимостьЕПС") = Неопределено Тогда
