				//Добавим сноску для последующих листов
				Если не СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = 0 Тогда
					СтруктураОтчета.ДанныеСносок.ТекущиеСноски.Добавить().Номер = СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски;
					ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски, "Номер"); 
					Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
						СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски + " (до 28.03.2024г. Общество с ограниченной ответственностью Брокерская компания Платформа).";
					Иначе
				    	СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски;
					КонецЕсли;
					//СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски;
					СтруктураОтчета.ДанныеСносок.СобранныеСноски.Вывести(СтруктураОтчета.ДанныеСносок.ОбластьСноска);
					СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = 0;
				КонецЕсли;
					
			Иначе //PDF и Это не НоваяСтраница
				
				Если не СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = 0
						И СтруктураОтчета.ДанныеСносок.ТекущиеСноски.Найти(СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски,"Номер") = Неопределено Тогда
					СтруктураОтчета.ДанныеСносок.ТекущиеСноски.Добавить().Номер = СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски;
					ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски, "Номер");
					Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
						СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски + " (до 28.03.2024г. Общество с ограниченной ответственностью Брокерская компания Платформа).";
					Иначе
				    	СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски;
					КонецЕсли;
					//СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски;
					СтруктураОтчета.ДанныеСносок.СобранныеСноски.Вывести(СтруктураОтчета.ДанныеСносок.ОбластьСноска);
					СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = 0;
				КонецЕсли;
			КонецЕсли; //Если НоваяСтраница
			
			СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = 0;
		
		Иначе //ЭтоКонецРаздела
			//Это конец раздела
			//Нужно вывести сноски, если остались
			СтруктураОтчета.ДанныеСносок.ТекущиеСноски.Сортировать("Номер");
			СтруктураОтчета.ДанныеСносок.СобранныеСноски.Очистить();
			Для каждого Стр Из СтруктураОтчета.ДанныеСносок.ТекущиеСноски Цикл
				ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(Стр.Номер, "Номер");
				Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
					СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски + " (до 28.03.2024г. Общество с ограниченной ответственностью Брокерская компания Платформа).";
				Иначе
				    СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски;
				КонецЕсли;
				//СтруктураОтчета.ДанныеСносок.ОбластьСноска.Параметры.ТекстСноски = ДанныеСноски.ТекстСноски;
				СтруктураОтчета.ДанныеСносок.СобранныеСноски.Вывести(СтруктураОтчета.ДанныеСносок.ОбластьСноска);
			КонецЦикла;
			
			//Для PDF забиваем пустыми строками до конца страницы
			Помещается = Ложь;
			Пока Истина Цикл
				ВыводимыеОбласти = Новый Массив;
				ВыводимыеОбласти.Добавить(СтруктураОтчета.ДанныеСносок.ОбластьПустаяСтрока);
				ВыводимыеОбласти.Добавить(СтруктураОтчета.ДанныеСносок.СобранныеСноски);
