		Если НачалоДня(СтрокаТаблицыЗначений.Период) <= НачалоДня(ДатаОкончания) ТОгда //IMAPPS-22226 Nozhiganov если последний период больше даты построения, то не выводим его.
			ОбластьСтоимостьПортфеляСтрока.Параметры.Дата = СтрокаТаблицыЗначений.Период; //IMAPPS-21870 Nozhiganov
			ОбластьСтоимостьПортфеляСтрока.Параметры.Сумма = СтрокаТаблицыЗначений.СуммаСЧА;
					
			Если PDF Тогда
				ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьСтоимостьПортфеляШапка, ОбластьСтоимостьПортфеляСтрока); // TM-3169
			Иначе
				ТабличныйДокумент.Вывести(ОбластьСтоимостьПортфеляСтрока);
			КонецЕсли;
		КонецЕсли; //IMAPPS-22226	
		
	КонецЦикла;
	
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц(); //TM-3137
	Если PDF Тогда
		ТабличныйДокумент.Вывести(ОбластьЧертаКолонтитула);
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ДоходностьMWR
	
	// Заполняем доходность MWR
	
	ОбластьНаименованиеРаздела.Параметры.НаименованиеРаздела = "I.2   Сведения о динамике ежемесячной доходности инвестиционного портфеля за 12 месяцев, предшествующих " + ДатаОкончанияПредставление;
	ТабличныйДокумент.Вывести(ОбластьНаименованиеРаздела);
	
	ДанныеДоходностьMWR = ДанныеРаздела.ДоходностьMWR;
	ДанныеДоходностьMWRГрафик = ДанныеРаздела.ДоходностьMWRГрафик;//IMAPPS-23088
	
	НастройкиПериодичности = Справочники.НастройкиПериодичности.СоздатьЭлемент();
	
	НастройкиПериодичности.Периодичность 	= ПредопределенноеЗначение("Перечисление.Периодичность.Месяц");
	НастройкиПериодичности.ТипДня 			= ПредопределенноеЗначение("Перечисление.ТипДня.КалендарныйДень");   //IMAPPS-21870 NOZhiganov
	НастройкиПериодичности.Спецификатор 	= ПредопределенноеЗначение("Перечисление.Спецификатор.Последний");   //IMAPPS-21870 NOZhiganov
	
	ПериодичностьМесяцТаблицаЗначений = КалендарныеГрафики.ПолучитьПериодыСогласноНастройке(
	ДанныеРаздела.ДоходностьДатаНачала, ДанныеРаздела.ДоходностьДатаОкончания, НастройкиПериодичности);
	
	ПериодичностьМесяц = ПериодичностьМесяцТаблицаЗначений.ВыгрузитьКолонку("РезультирующаяДата");
	
	ДоходностьПоМесяцам = Новый ТаблицаЗначений;
	ДоходностьПоМесяцам.Колонки.Добавить("Дата");
	ДоходностьПоМесяцам.Колонки.Добавить("Доходность");
	
	// IMAPPS-23906 ++
	// определим последнюю точку доходности
	ДанныеПоследнейТочкиДоходности = Новый Структура("Дата, Доходность");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеДоходностьMWRГрафик.Дата КАК Дата,
	               |	ДанныеДоходностьMWRГрафик.Доходность КАК Доходность
	               |ПОМЕСТИТЬ втДанныеДоходностьMWRГрафик
	               |ИЗ
	               |	&ДанныеДоходностьMWRГрафик КАК ДанныеДоходностьMWRГрафик
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(втДанныеДоходностьMWRГрафик.Дата) КАК Дата
	               |ПОМЕСТИТЬ втДатаПоследнейДоходности
	               |ИЗ
	               |	втДанныеДоходностьMWRГрафик КАК втДанныеДоходностьMWRГрафик
	               |ГДЕ
	               |	втДанныеДоходностьMWRГрафик.Доходность <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втДанныеДоходностьMWRГрафик.Дата КАК Дата,
	               |	втДанныеДоходностьMWRГрафик.Доходность КАК Доходность
	               |ИЗ
	               |	втДанныеДоходностьMWRГрафик КАК втДанныеДоходностьMWRГрафик
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДатаПоследнейДоходности КАК втДатаПоследнейДоходности
	               |		ПО втДанныеДоходностьMWRГрафик.Дата = втДатаПоследнейДоходности.Дата";
	
	Запрос.УстановитьПараметр("ДанныеДоходностьMWRГрафик",	ДанныеДоходностьMWRГрафик);
	
	МассивРезультатов = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ДанныеПоследнейТочкиДоходности.Дата			= Выборка.Дата;
		ДанныеПоследнейТочкиДоходности.Доходность	= Выборка.Доходность;
		
	КонецЕсли;
	
	// сформируем таблицу доходности
	Для каждого ПериодМесяц Из ПериодичностьМесяц Цикл
		
		ОтборПериодДоговор = Новый Структура("ДоговорДУ, Дата", ДанныеРаздела.ДоговорДУ, ПериодМесяц);
		СтрокиДоходностьMWR = ДанныеДоходностьMWRГрафик.НайтиСтроки(ОтборПериодДоговор);
		
		Если СтрокиДоходностьMWR.Количество() > 0 Тогда
			
			СтрокаДоходностьMWR = СтрокиДоходностьMWR[0];
			
			// Прерываем график, если доходность дальше равна 0
			Если ДанныеПоследнейТочкиДоходности.Дата <> Неопределено
					И СтрокаДоходностьMWR.Дата > ДанныеПоследнейТочкиДоходности.Дата Тогда
				
				НоваяСтрока = ДоходностьПоМесяцам.Добавить();
				НоваяСтрока.Дата 		= ДанныеПоследнейТочкиДоходности.Дата;
				НоваяСтрока.Доходность 	= ДанныеПоследнейТочкиДоходности.Доходность;
			
				Прервать;
				
			КонецЕсли;
			
			НоваяСтрока = ДоходностьПоМесяцам.Добавить();
			НоваяСтрока.Дата 		= СтрокаДоходностьMWR.Дата;
			НоваяСтрока.Доходность 	= СтрокаДоходностьMWR.Доходность;
			
		КонецЕсли;
		
	КонецЦикла;
	
	КоличествоПериодов_ДоходностьПоМесяцам = ДоходностьПоМесяцам.Количество();
	Если ДанныеПоследнейТочкиДоходности.Дата <> Неопределено
			И КоличествоПериодов_ДоходностьПоМесяцам <> 0
			И ДанныеПоследнейТочкиДоходности.Дата > ДоходностьПоМесяцам[КоличествоПериодов_ДоходностьПоМесяцам-1].Дата Тогда
	
		НоваяСтрока = ДоходностьПоМесяцам.Добавить();
		НоваяСтрока.Дата 		= ДанныеПоследнейТочкиДоходности.Дата;
		НоваяСтрока.Доходность 	= ДанныеПоследнейТочкиДоходности.Доходность;
		
	КонецЕсли;
	
	// IMAPPS-23906 --
	
	////IMAPPS-21870 NOzhiganov исключил вывод
	////vtb 04.07.2016
	////Если клиент зашёл в середине периода, то добавляем первую точку принудительно
	//Если ДанныеДоходностьMWR.Количество() > 0 И ДанныеДоходностьMWR[0].Дата > ДатаНачала  Тогда 
	//	НоваяСтрока = ДоходностьПоМесяцам.Добавить();
	//	НоваяСтрока.Дата 		= ДанныеДоходностьMWR[0].Дата;
	//	НоваяСтрока.Доходность 	= ДанныеДоходностьMWR[0].Доходность;	
	//КонецЕсли; 
	
	////IMAPPS-21870 NOzhiganov добавить вывод даты ДанныеРаздела.ДоходностьДатаНачала +	
	//Если ПериодичностьМесяц.Количество() > 0 И ДанныеРаздела.ДоходностьДатаНачала < ПериодичностьМесяц[0]  Тогда
	//	
	//	ОтборПериодДоговор = Новый Структура("ДоговорДУ, Дата", ДанныеРаздела.ДоговорДУ, ДанныеРаздела.ДоходностьДатаНачала);
	//	СтрокиДоходностьMWR = ДанныеДоходностьMWR.НайтиСтроки(ОтборПериодДоговор);
	//	
	//	Если СтрокиДоходностьMWR.Количество() > 0 Тогда
	//		
	//		СтрокаДоходностьMWR = СтрокиДоходностьMWR[0];
	//		
	//		НоваяСтрока = ДоходностьПоМесяцам.Добавить();
	//		НоваяСтрока.Дата 		= СтрокаДоходностьMWR.Дата;
	//		НоваяСтрока.Доходность 	= СтрокаДоходностьMWR.Доходность;
	//		
	//	КонецЕсли;		
	//КонецЕсли;	
	////IMAPPS-21870 NOzhiganov - 
	
	// IMAPPS-23906 ++
	//Для каждого ПериодМесяц Из ПериодичностьМесяц Цикл
	//	
	//	ОтборПериодДоговор = Новый Структура("ДоговорДУ, Дата", ДанныеРаздела.ДоговорДУ, ПериодМесяц);
