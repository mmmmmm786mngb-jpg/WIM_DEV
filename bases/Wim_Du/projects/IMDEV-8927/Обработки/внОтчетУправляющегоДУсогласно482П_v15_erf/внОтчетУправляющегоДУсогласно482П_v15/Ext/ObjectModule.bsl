				ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(Стр.Номер, "Номер");
				
				Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
