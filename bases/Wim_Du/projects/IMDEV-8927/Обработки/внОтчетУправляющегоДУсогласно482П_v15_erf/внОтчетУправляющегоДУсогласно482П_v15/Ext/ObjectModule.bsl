	ТекстСообщения = ?(ЗначениеЗаполнено(ТекстСообщения), ТекстСообщения + Символы.ПС + ДобавляемыйТекст, ДобавляемыйТекст);
	
КонецПроцедуры

Функция ОжидатьЗавершение(Знач МассивСтруктурФоновогоЗадания, КраткоеПредставлениеОшибки)
	
	ВсеФоновыеВыполнены = Ложь;
	
	ТаблицаЗаданий = СоздатьНовуюТаблицуЗаданий();
	
	НомерФоновогоЗадания = 0;
	
	Для каждого ДлительнаяОперация Из МассивСтруктурФоновогоЗадания Цикл
		НомерФоновогоЗадания = НомерФоновогоЗадания + 1;
		
		Если ЗначениеЗаполнено(ДлительнаяОперация.ИдентификаторЗадания) Тогда
			НоваяСтрока = ТаблицаЗаданий.Добавить();
			НоваяСтрока.НомерФоновогоЗадания = НомерФоновогоЗадания;
			НоваяСтрока.ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
			НоваяСтрока.АдресРезультата = ДлительнаяОперация.АдресРезультата;
		КонецЕсли;
		
	КонецЦикла;
	
	Пока ВсеФоновыеВыполнены = Ложь Цикл
		
		Для каждого ТекЗадание Из ТаблицаЗаданий Цикл
			
			Если ЗначениеЗаполнено(ДлительнаяОперация.ИдентификаторЗадания) Тогда
				
				Задание = ПроверитьЗаданиеВыполнено(ТекЗадание.ИдентификаторЗадания);
				ТекЗадание.Статус = Задание.Статус;
				ТекЗадание.КраткоеПредставлениеОшибки = Задание.КраткоеПредставлениеОшибки;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ПарамертрыПоиска = Новый Структура("Статус", "Выполняется");
		НайденныеСтроки = ТаблицаЗаданий.НайтиСтроки(ПарамертрыПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			
			ВсеФоновыеВыполнены = Истина;
			
			ПарамертрыПоиска = Новый Структура("Статус", "Ошибка");
			НайденныеСтрокиСОшибкой = ТаблицаЗаданий.НайтиСтроки(ПарамертрыПоиска);
			
			Если НайденныеСтрокиСОшибкой.Количество() > 0 Тогда
				
				МассивОшибок = Новый Массив;
				Для каждого ТекСтрока Из НайденныеСтрокиСОшибкой Цикл
					МассивОшибок.Добавить(ТекСтрока);
					КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки + Символы.ПС + ТекСтрока.КраткоеПредставлениеОшибки;
				КонецЦикла;
				
				Возврат МассивОшибок;
				
			КонецЕсли;
			
			ПарамертрыПоиска = Новый Структура("Статус", "Выполнено");
			НайденныеСтрокиВыполнено = ТаблицаЗаданий.НайтиСтроки(ПарамертрыПоиска);
			
			Если ТаблицаЗаданий.Количество() = НайденныеСтрокиВыполнено.Количество() Тогда
				
				МассивРезультата = Новый Массив;
				Для каждого ТекСтрока Из НайденныеСтрокиВыполнено Цикл
					МассивРезультата.Добавить(ТекСтрока);
				КонецЦикла;
				
				Возврат МассивРезультата;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

