Процедура ЗаполнитьРаздел1Общая(СтруктураОтчета, Макет, ДанныеРаздела, ТипФайла)
	
	PDF = ТипФайла = "pdf";
	
	ОбластьШапкаОтчета 				= Макет.ПолучитьОбласть("ШапкаОтчета");
	ОбластьНаименованиеРаздела 		= Макет.ПолучитьОбласть("НаименованиеРаздела");
	ОбластьРасчетПриростаРСА 		= Макет.ПолучитьОбласть("РасчетПриростаРСА");
	ОбластьСтоимостьПортфеляШапка 	= Макет.ПолучитьОбласть("СтоимостьПортфеляШапка");
	ОбластьСтоимостьПортфеляСтрока 	= Макет.ПолучитьОбласть("СтоимостьПортфеляСтрока");
	ОбластьДоходностьMWR			= Макет.ПолучитьОбласть("ДоходностьMWR");
	ОбластьВознаграждение			= Макет.ПолучитьОбласть("Вознаграждение");
	
	Если PDF Тогда 
		ОбластьЧертаКолонтитула		= Макет.ПолучитьОбласть("ЧертаКолонтитула");
		ТабличныйДокумент = СтруктураОтчета.РазделPDF1;
	Иначе
		ТабличныйДокумент = СтруктураОтчета.Раздел1;
	КонецЕсли;
	
	ДатаНачалаПредставление 		= Формат(ДатаНачала, "ДФ=dd.MM.yyyy");
	ДатаОкончанияПредставление 		= Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	#Область ШапкаОтчета
	
	//VTBC SadykovNiyaz 01.04.2022 (IMAPPS-16952) {
	//ОбластьШапкаОтчета.Параметры.УправляющаяКомпания 	= ДанныеРаздела.РеквизитыУправляющейКомпании.НаименованиеПолное;
	//Договорились сделать такое костыльное решение, видимо, на время перехода, исходная строка выше закомментирована
	Если ФлагНовоеНаименованиеУК Тогда
		ОбластьШапкаОтчета.Параметры.УправляющаяКомпания 	= СтрЗаменить(НаименованиеУК,"АО ","Акционерное общество ");
	Иначе
		ОбластьШапкаОтчета.Параметры.УправляющаяКомпания 	= "Акционерное общество ВИМ Инвестиции";
	КонецЕсли;
	//VTBC SadykovNiyaz 01.04.2022 (IMAPPS-16952) }

	
	ОбластьШапкаОтчета.Параметры.ДатаНачала 			= ДатаНачалаПредставление;
	ОбластьШапкаОтчета.Параметры.ДатаОкончания 			= ДатаОкончанияПредставление;
	
	ШапкаОтчета = 	ДанныеРаздела.Шапка[0];
	
	Если ШапкаОтчета.ТипКлиентаДУ = ПредопределенноеЗначение("Перечисление.ТипыКлиентовДУ.ФизическиеЛица") Тогда
		Если ОтоброжатьФИО Тогда
			ОбластьШапкаОтчета.Параметры.Клиент 				= ШапкаОтчета.Фамилия + " " + ШапкаОтчета.Имя + " " + ШапкаОтчета.Отчество;	
			//VTBC SadykovNiyaz 06.04.2022 (IMAPPS-16952) {
			//ОбластьШапкаОтчета.Параметры.СчетКлиента 			= ШапкаОтчета.НаименованиеПортфеля;
			//Договорились сделать такое костыльное решение, видимо, на время перехода, исходная строка выше закомментирована
			Если ФлагНовоеНаименованиеУК Тогда
				ОбластьШапкаОтчета.Параметры.СчетКлиента 			= СтрЗаменить(ШапкаОтчета.НаименованиеПортфеля,"АО ВИМ Инвестиции", НаименованиеУК);
			Иначе
				ОбластьШапкаОтчета.Параметры.СчетКлиента 			= СтрЗаменить(ШапкаОтчета.НаименованиеПортфеля,"АО ВТБ Капитал Управление активами", "АО ВИМ Инвестиции");
			КонецЕсли;
			//VTBC SadykovNiyaz 06.04.2022 (IMAPPS-16952) }

		Иначе
			//vtb 17.06
			ОбластьШапкаОтчета.Параметры.Клиент 				= СтрЗаменить("АМ" + ДанныеРаздела.РеквизитыКлиента.ВнешнийIDДляЛК," ","");
			//VTBC SadykovNiyaz 06.04.2022 (IMAPPS-16952) {
			//ОбластьШапкаОтчета.Параметры.СчетКлиента 			= ДанныеРаздела.ДоговорДУ.УправляющаяКомпания.Наименование + " ДУ "+ ДанныеРаздела.ДоговорДУ.Префикс;
			//Договорились сделать такое костыльное решение, видимо, на время перехода, исходная строка выше закомментирована
			Если ФлагНовоеНаименованиеУК Тогда
				ОбластьШапкаОтчета.Параметры.СчетКлиента 			= НаименованиеУК + " ДУ "+ ДанныеРаздела.ДоговорДУ.Префикс;
			Иначе
				ОбластьШапкаОтчета.Параметры.СчетКлиента 			= "АО ВИМ Инвестиции" + " ДУ "+ ДанныеРаздела.ДоговорДУ.Префикс;
			КонецЕсли;
			//VTBC SadykovNiyaz 06.04.2022 (IMAPPS-16952) }

		КонецЕсли;
	Иначе
		// Loevets E. IMAPPS-32398
		Если ШапкаОтчета.ТипКлиентаДУ = ПредопределенноеЗначение("Перечисление.ТипыКлиентовДУ.ФондЦелевогоКапитала") Тогда
			ОбластьШапкаОтчета.Параметры.Клиент 				= ШапкаОтчета.НомерДоговораДУ;
		Иначе
			ОбластьШапкаОтчета.Параметры.Клиент 				= ДанныеРаздела.РеквизитыКлиента.НаименованиеПолное;	
		КонецЕсли;	
		//VTBC SadykovNiyaz 06.04.2022 (IMAPPS-16952) {
		//ОбластьШапкаОтчета.Параметры.СчетКлиента 			= ШапкаОтчета.НаименованиеПортфеля;
		//Договорились сделать такое костыльное решение, видимо, на время перехода, исходная строка выше закомментирована
		Если ФлагНовоеНаименованиеУК Тогда
			ОбластьШапкаОтчета.Параметры.СчетКлиента 			= СтрЗаменить(ШапкаОтчета.НаименованиеПортфеля,"АО ВИМ Инвестиции", НаименованиеУК);
		Иначе
			ОбластьШапкаОтчета.Параметры.СчетКлиента 			= СтрЗаменить(ШапкаОтчета.НаименованиеПортфеля,"АО ВТБ Капитал Управление активами", "АО ВИМ Инвестиции");
		КонецЕсли;
		//VTBC SadykovNiyaz 06.04.2022 (IMAPPS-16952) }

	КонецЕсли; 
	
	//vtb 17.06
	ОбластьШапкаОтчета.Параметры.НомерДоговора 					= ДанныеРаздела.ДоговорДУ.Код+" от "+Формат(ДанныеРаздела.ДоговорДУ.ДатаНачала,"ДФ=dd.MM.yyyy");
	
	ОбластьШапкаОтчета.Параметры.КлиентТелефон 					= ШапкаОтчета.КлиентТелефон;
	ОбластьШапкаОтчета.Параметры.КлиентФакс 					= ШапкаОтчета.КлиентФакс;
	ОбластьШапкаОтчета.Параметры.КлиентEmail 					= ШапкаОтчета.КлиентEmail;
	ОбластьШапкаОтчета.Параметры.УправляющаяКомпанияЮрАдрес		= ШапкаОтчета.УправляющаяКомпанияПочтовыйАдрес;
	ОбластьШапкаОтчета.Параметры.УправляющаяКомпанияТелефон		= ШапкаОтчета.УправляющаяКомпанияТелефон;
	ОбластьШапкаОтчета.Параметры.УправляющаяКомпанияEmail		= ШапкаОтчета.УправляющаяКомпанияEmail;
	
	Лицензии = ДанныеРаздела.Лицензии;
	
	ОбластьШапкаОтчета.Параметры.ЦенныеБумагиЛицензия = "";
	ОбластьШапкаОтчета.Параметры.ФондыЛицензия = "";
	
	Для каждого Лицензия Из Лицензии Цикл
		
		Если Лицензия.ВидЛицензии = ПредопределенноеЗначение("Перечисление.ВидыЛицензий.ДоверительноеУправление") Тогда
			ОбластьШапкаОтчета.Параметры.ЦенныеБумагиЛицензия = " по управлению ценными бумагами " +
			"№" + Лицензия.НомерЛицензии + " от " + Формат(Лицензия.ДатаВыдачи, "ДФ=dd.MM.yyyy");	
		КонецЕсли; 
		
		Если Лицензия.ВидЛицензии = ПредопределенноеЗначение("Перечисление.ВидыЛицензий.УправлениеПИФами") Тогда
			ОбластьШапкаОтчета.Параметры.ФондыЛицензия = " по управленияю инвестиционными фондами, ПИФ и НПФ	" 
			"№" + Лицензия.НомерЛицензии + " от " + Формат(Лицензия.ДатаВыдачи, "ДФ=dd.MM.yyyy");		
		КонецЕсли; 
		
	КонецЦикла; 
	
	ТабличныйДокумент.Вывести(ОбластьШапкаОтчета);
	
	#КонецОбласти 
	
	#Область РасчетПрироста
	
	// Заполняем РСА и СЧА
	
	ОбластьНаименованиеРаздела.Параметры.НаименованиеРаздела = "I. Расчет Прироста Рыночной стоимости активов за отчетный период";
	ТабличныйДокумент.Вывести(ОбластьНаименованиеРаздела);
	
	ДанныеСтоимостьАктивовНачалоПериода = ДанныеРаздела.СтоимостьАктивовНачалоПериода;
	ДанныеСтоимостьАктивовКонецПериода 	= ДанныеРаздела.СтоимостьАктивовКонецПериода;
	ДанныеВложенияИзъятия 				= ДанныеРаздела.ВложенияИзъятия;
	
	СЧА_НачалоПериода 	= 0;
	СЧА_КонецПериода 	= 0;
	
	Если ДанныеСтоимостьАктивовНачалоПериода.Количество() > 0 Тогда
		
		СтрокаТаблицыЗначений = ДанныеСтоимостьАктивовНачалоПериода[0];
		
		ОбластьРасчетПриростаРСА.Параметры.РСА_НачалоПериода = СтрокаТаблицыЗначений.РСА_НачалоПериода;
		
		СЧА_НачалоПериода = СтрокаТаблицыЗначений.СЧА_НачалоПериода;
		ОбластьРасчетПриростаРСА.Параметры.СЧА_НачалоПериода = СЧА_НачалоПериода;
		
	Иначе
		
		ОбластьРасчетПриростаРСА.Параметры.РСА_НачалоПериода = 0;
		ОбластьРасчетПриростаРСА.Параметры.СЧА_НачалоПериода = 0;
		
	КонецЕсли;
	
	Если ДанныеСтоимостьАктивовКонецПериода.Количество() > 0 Тогда
		
		СтрокаТаблицыЗначений = ДанныеСтоимостьАктивовКонецПериода[0];
		
		ОбластьРасчетПриростаРСА.Параметры.РСА_КонецПериода = СтрокаТаблицыЗначений.РСА_КонецПериода;
		
		СЧА_КонецПериода = СтрокаТаблицыЗначений.СЧА_КонецПериода;
		ОбластьРасчетПриростаРСА.Параметры.СЧА_КонецПериода = СЧА_КонецПериода;
		
	Иначе
		
		ОбластьРасчетПриростаРСА.Параметры.РСА_КонецПериода = 0;
		ОбластьРасчетПриростаРСА.Параметры.СЧА_КонецПериода = 0;
		
	КонецЕсли;
	
	Если ДанныеВложенияИзъятия.Количество() > 0 Тогда
		
