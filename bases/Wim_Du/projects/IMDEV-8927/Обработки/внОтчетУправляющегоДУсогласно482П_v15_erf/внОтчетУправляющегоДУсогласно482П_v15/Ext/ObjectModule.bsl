КонецПроцедуры

Процедура ЗаполнитьРаздел3Общая(СтруктураОтчета, Макет, ДанныеРаздела, ТипФайла)
	
	PDF = ТипФайла = "pdf";
	
	ДатаНачалаПредставление 		= Формат(ДатаНачала, "ДФ=dd.MM.yyyy");
	ДатаОкончанияПредставление 		= Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	ОбластьЗаголовокСделки 		= Макет.ПолучитьОбласть("ЗаголовокСделки");
	ОбластьШапкаСделки 			= Макет.ПолучитьОбласть("ШапкаСделки");
	ОбластьСтрокаСделки 		= Макет.ПолучитьОбласть("СтрокаСделки");
	ОбластьРазделСрочныеСделки 	= Макет.ПолучитьОбласть("РазделСрочныеСделки");
	ОбластьШапкаСрочныеСделки	= Макет.ПолучитьОбласть("ШапкаСрочныеСделки");
	ОбластьСтрокаСрочныеСделки	= Макет.ПолучитьОбласть("СтрокаСрочныеСделки");
	ОбластьРазделВалютныеСделки	= Макет.ПолучитьОбласть("РазделВалютныеСделки");
	ОбластьШапкаВалютныеСделки	= Макет.ПолучитьОбласть("ШапкаВалютныеСделки");
	ОбластьСтрокаВалютныеСделки	= Макет.ПолучитьОбласть("СтрокаВалютныеСделки");
	
	Если PDF Тогда
		ТабличныйДокумент = СтруктураОтчета.РазделPDF3;
		
		ОбластьЧертаКолонтитула		= Макет.ПолучитьОбласть("ЧертаКолонтитула");
		ТабличныйДокумент.Вывести(ОбластьЧертаКолонтитула);
	Иначе
		ТабличныйДокумент = СтруктураОтчета.Раздел3;
	КонецЕсли;
	
	ОбластьЗаголовокСделки.Параметры.НачалоПериода = ДатаНачалаПредставление;
	ОбластьЗаголовокСделки.Параметры.КонецПериода = ДатаОкончанияПредставление;
	ТабличныйДокумент.Вывести(ОбластьЗаголовокСделки);
	
	ТабличныйДокумент.Вывести(ОбластьШапкаСделки);
	
	Сделки = ДанныеРаздела.Сделки;
	ФактДатыОплаты   = ДанныеРаздела.ФактДатыОплаты;
	ФактДатыПоставки = ДанныеРаздела.ФактДатыПоставки; // TM-3208
	
	Для каждого СтрокаТабличнойЧасти Из Сделки Цикл
		
		ОбластьСтрокаСделки.Параметры.НомерСделки 						= СтрокаТабличнойЧасти.НомерСделки;
		ОбластьСтрокаСделки.Параметры.ДатаСделки 						= СтрокаТабличнойЧасти.Дата;
		ОбластьСтрокаСделки.Параметры.НаименованиеАктива 				= СтрокаТабличнойЧасти.АктивПредставление;
		
		НоминальнаяСтоимость = 0;
		
		Если СтрокаТабличнойЧасти.ВидАктива.ПринадлежитЭлементу(ПланыВидовХарактеристик.ВидыАктивов.Облигации) Тогда
			НоминальнаяСтоимость = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(СтрокаТабличнойЧасти.ЦеннаяБумага, ДатаОкончания);
		Иначе
			НоминальнаяСтоимость = СтрокаТабличнойЧасти.НоминальнаяСтоимость;
		КонецЕсли; 
		
		ОбластьСтрокаСделки.Параметры.Номинал 							= НоминальнаяСтоимость;
		ОбластьСтрокаСделки.Параметры.ВалютаНоминала 					= СтрокаТабличнойЧасти.ВалютаНоминальнойСтоимостиПредставление;
		
		ТипСделки = "";
		
		Если СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Продажа") Тогда
			ТипСделки = "Продажа";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Поступление") Тогда
			ТипСделки = "Покупка";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидОперацииБПВнебиржеваяСделка.Продажа") Тогда
			ТипСделки = "Продажа";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидОперацииБПВнебиржеваяСделка.Покупка") Тогда
			ТипСделки = "Покупка";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО") Тогда
			Если СтрокаТабличнойЧасти.Нога = "ПерваяНога" Тогда // TM-3208, условие по ноге
				ТипСделки = "Покупка";
			ИначеЕсли СтрокаТабличнойЧасти.Нога = "ВтораяНога" Тогда 
				ТипСделки = "Продажа";
			КонецЕсли;;		
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ПрямойРЕПО") Тогда
			Если СтрокаТабличнойЧасти.Нога = "ПерваяНога" Тогда // TM-3208, условие по ноге
				ТипСделки = "Продажа";
			ИначеЕсли СтрокаТабличнойЧасти.Нога = "ВтораяНога" Тогда 
				ТипСделки = "Покупка";
			КонецЕсли;
		КонецЕсли; 
		
		ОбластьСтрокаСделки.Параметры.ТипСделки 						= ТипСделки;
		
		ОбластьСтрокаСделки.Параметры.Количество 						= СтрокаТабличнойЧасти.Количество;
		ОбластьСтрокаСделки.Параметры.ВалютаЦены 						= СтрокаТабличнойЧасти.ВалютаЦеныПредставление;
		ОбластьСтрокаСделки.Параметры.Цена 								= СтрокаТабличнойЧасти.Цена;
		ОбластьСтрокаСделки.Параметры.СуммаСделки 						= СтрокаТабличнойЧасти.Сумма;
		
		ОбластьСтрокаСделки.Параметры.КомиссияБиржи 					= СтрокаТабличнойЧасти.КомиссияБиржи;
		ОбластьСтрокаСделки.Параметры.КомиссияБрокера 					= СтрокаТабличнойЧасти.КомиссияБрокера;
		ОбластьСтрокаСделки.Параметры.НКД 								= СтрокаТабличнойЧасти.НКД;
		
		// MPazhukov IMAPPS-12738
		Если СтрокаТабличнойЧасти.КомиссияБрокераВал <> СтрокаТабличнойЧасти.КомиссияБрокера Тогда
			ОбластьСтрокаСделки.Параметры.КомиссияБрокераВал			= СтрокаТабличнойЧасти.КомиссияБрокераВал;
		Иначе
			ОбластьСтрокаСделки.Параметры.КомиссияБрокераВал			= "-";	
		КонецЕсли;	
		
		// MPazhukov IMAPPS-12738
		
		Если СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделка.Поступление") ИЛИ
			СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО") и ТипСделки = "Покупка" ИЛИ
			СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидОперацииБПВнебиржеваяСделка.Покупка") Тогда
			
			ОбластьСтрокаСделки.Параметры.СуммаСделкиСУчетомКомиссийНКД	= СтрокаТабличнойЧасти.Сумма + 
			СтрокаТабличнойЧасти.КомиссияБиржи + СтрокаТабличнойЧасти.КомиссияБрокера + СтрокаТабличнойЧасти.НКД;
		Иначе
			ОбластьСтрокаСделки.Параметры.СуммаСделкиСУчетомКомиссийНКД = СтрокаТабличнойЧасти.Сумма - 
			СтрокаТабличнойЧасти.КомиссияБиржи - СтрокаТабличнойЧасти.КомиссияБрокера + СтрокаТабличнойЧасти.НКД;
		КонецЕсли; 
		
		ОбластьСтрокаСделки.Параметры.ВалютаРасчетов 					= СтрокаТабличнойЧасти.ВалютаЦеныПредставление;
		
		Если СтрокаТабличнойЧасти.Нога = "ПерваяНога" Тогда
			ОбластьСтрокаСделки.Параметры.СтавкаРЕПО 						=""+ СтрокаТабличнойЧасти.СтавкаРЕПО+"/"+окр(СтрокаТабличнойЧасти.БизнесПроцесс.ЦенаЦБВторойЧастиРЕПО,2);
		Иначе
			ОбластьСтрокаСделки.Параметры.СтавкаРЕПО 						= СтрокаТабличнойЧасти.СтавкаРЕПО;
		КонецЕсли; 
		
		ОбластьСтрокаСделки.Параметры.ДатаПоставкиПлан 					= СтрокаТабличнойЧасти.ДатаПоставки;
		ОбластьСтрокаСделки.Параметры.ДатаОплатыПлан 					= СтрокаТабличнойЧасти.ДатаОплаты;
		ОбластьСтрокаСделки.Параметры.ДатаПоставкиФакт 					= СтрокаТабличнойЧасти.ДатаПоставкиФакт;
		
		ДатаОплатыФакт = Дата(1, 1, 1);
		
		// TM-3208 {
		Если ТипЗнч(СтрокаТабличнойЧасти.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ВнебиржеваяСделка")
			ИЛИ ТипЗнч(СтрокаТабличнойЧасти.БизнесПроцесс) = Тип("БизнесПроцессСсылка.СделкиTn") Тогда
			Отбор = Новый Структура("БизнесПроцесс", СтрокаТабличнойЧасти.БизнесПроцесс);
			СтрокиФактПоставки = ФактДатыПоставки.НайтиСтроки(Отбор);
			Если СтрокиФактПоставки.Количество() > 0 Тогда	
				ОбластьСтрокаСделки.Параметры.ДатаПоставкиФакт = СтрокиФактПоставки[0].Дата;	
			КонецЕсли; 
			// Для БП Сделки РЕПО даты план совпадают с датой факт
		ИначеЕсли ТипЗнч(СтрокаТабличнойЧасти.БизнесПроцесс) = Тип("БизнесПроцессСсылка.СделкиРЕПО") Тогда
			ОбластьСтрокаСделки.Параметры.ДатаПоставкиФакт = СтрокаТабличнойЧасти.ДатаПоставки;	
			ДатаОплатыФакт = СтрокаТабличнойЧасти.ДатаОплаты;
		КонецЕсли;
		// TM-3208 }
		
		ОбластьСтрокаСделки.Параметры.ЕдИзм								= СтрокаТабличнойЧасти.ВалютаМаксМин;
		
		Отбор = Новый Структура("БизнесПроцесс", СтрокаТабличнойЧасти.БизнесПроцесс);
		СтрокиФактОплаты = ФактДатыОплаты.НайтиСтроки(Отбор);
		Если СтрокиФактОплаты.Количество() > 0 Тогда	
			ДатаОплатыФакт = СтрокиФактОплаты[0].Дата;	
		КонецЕсли; 
		
		//vtb 04.07.2016 если БП нет, то сделка т0 дата оплаты = дате сделки
		Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.БизнесПроцесс) Тогда
			ДатаОплатыФакт = СтрокаТабличнойЧасти.ДатаОплаты;
		КонецЕсли;
		
		ОбластьСтрокаСделки.Параметры.ДатаОплатыФакт = ДатаОплатыФакт;
		
		// ++ IMAPPS-24743 Чижов В.В. 13.02.2024
		Если ПоставкаПротивПлатежа Тогда
			ДатаВалютирования = ОбластьСтрокаСделки.Параметры.ДатаОплатыФакт;
			Если ТипЗнч(СтрокаТабличнойЧасти.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ВнебиржеваяСделка")
				И СтрокаТабличнойЧасти.ПлатежныеУсловияСделки = Перечисления.ПлатежныеУсловияСделки.ПоставкаПротивПлатежа Тогда
				ДатаВалютирования = ОбластьСтрокаСделки.Параметры.ДатаПоставкиФакт;	
			КонецЕсли;
			ОбластьСтрокаСделки.Параметры.ДатаВалютирования = ДатаВалютирования;
		КонецЕсли;
		// -- IMAPPS-24743 Чижов В.В. 13.02.2024
		
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.БизнесПроцесс) Тогда	
			БизнесПроцессЗавершен = СтрокаТабличнойЧасти.БизнесПроцессЗавершен;
			
			ОбластьСтрокаСделки.Параметры.СтатусСделки = ?(БизнесПроцессЗавершен, "Завершена", "Не завершена");
		Иначе
			//vtb 04.07.2016 если БП нет, то сделка т0 - всегда заверщена
			ОбластьСтрокаСделки.Параметры.СтатусСделки = "Завершена";
		КонецЕсли;
		
		//vtb 18.07
		Если КонецДня(ДатаОплатыФакт) > КонецДня(ДатаОкончания) И ЗначениеЗаполнено(ДатаОкончания) Тогда
			ОбластьСтрокаСделки.Параметры.СтатусСделки = "Не завершена";
			ОбластьСтрокаСделки.Параметры.ДатаОплатыФакт = '00010101';
			//ОбластьСтрокаСделки.Параметры.ДатаПоставкиФакт = '00010101';
		КонецЕсли; 
		
		Если КонецДня(ОбластьСтрокаСделки.Параметры.ДатаПоставкиФакт) > КонецДня(ДатаОкончания) И ЗначениеЗаполнено(ДатаОкончания) Тогда
			ОбластьСтрокаСделки.Параметры.СтатусСделки = "Не завершена";
			ОбластьСтрокаСделки.Параметры.ДатаПоставкиФакт = '00010101';
		КонецЕсли;
		
		ОбластьСтрокаСделки.Параметры.МинЦенаНаБирже = СтрокаТабличнойЧасти.МинимальнаяЦена;		
		ОбластьСтрокаСделки.Параметры.МаксЦенаНаБирже = СтрокаТабличнойЧасти.МаксимальнаяЦена;
		ОбластьСтрокаСделки.Параметры.ТорговаяПлощадка = СтрокаТабличнойЧасти.БиржаПредставление;
		Если СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ПрямойРЕПО") Тогда //TM-3169
			ОбластьСтрокаСделки.Параметры.ОсобенностиСделки = "Прямое РЕПО";
		ИначеЕсли СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО") Тогда
			ОбластьСтрокаСделки.Параметры.ОсобенностиСделки = "Обратное РЕПО";
		Иначе
			ОбластьСтрокаСделки.Параметры.ОсобенностиСделки = "";
		КонецЕсли;
		
		//vtb 27.06
		//IMAPPS-21832++
		//ОбластьСтрокаСделки.Параметры.Брокер = ?(СокрЛП(СтрокаТабличнойЧасти.БрокерНаименование) = "", "", СтрокаТабличнойЧасти.БрокерНаименование + ", " + СтрокаТабличнойЧасти.БрокерИНН);
		СноскаТекст = "";
		ДанныеСноски = Неопределено;
		Если не СокрЛП(СтрокаТабличнойЧасти.БрокерНаименование) = "" Тогда
			ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(СтрокаТабличнойЧасти.Брокер,"Ключ");
			Если ДанныеСноски = Неопределено Тогда
				ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Добавить();
				ДанныеСноски.Ключ = СтрокаТабличнойЧасти.Брокер;
				ДанныеСноски.Номер = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Количество();
				ДанныеСноски.Сноска = ПолучитьТекстСноски(ДанныеСноски.Номер);
				ДанныеСноски.ТекстСноски = ДанныеСноски.Сноска + " - " + СтрокаТабличнойЧасти.БрокерНаименованиеПолное;
			КонецЕсли;
			
			//Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
			//	ДанныеСноски.ТекстСноски = ДанныеСноски.ТекстСноски + " (до 28.03.2024г. Общество с ограниченной ответственностью Брокерская компания Платформа).";
			//КонецЕсли;
			
			СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = ДанныеСноски.Номер;
			СноскаТекст = ДанныеСноски.Сноска;
		КонецЕсли;
		ОбластьСтрокаСделки.Параметры.Брокер =  СноскаТекст + ?(СокрЛП(СтрокаТабличнойЧасти.БрокерНаименование) = "", "", СокрЛП(СтрокаТабличнойЧасти.БрокерНаименование) + ", " + СокрЛП(СтрокаТабличнойЧасти.БрокерИНН));
		//IMAPPS-21832--
		
		Если PDF Тогда
			//ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаСделки, ОбластьСтрокаСделки); //TM-3169
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаСделки, ОбластьСтрокаСделки, ,СтруктураОтчета); //TM-3169 IMAPPS-21832
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаСделки);
			ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь);//IMAPPS-21832
		КонецЕсли;
		
	КонецЦикла; 
	
	СрочныеСделки = ДанныеРаздела.СрочныеСделки;
	
	Если PDF Тогда
		ПроверитьВывестиОбластьРазделШапка(ТабличныйДокумент, ОбластьШапкаСрочныеСделки, ОбластьРазделСрочныеСделки); //TM-3169
	Иначе
		ТабличныйДокумент.Вывести(ОбластьРазделСрочныеСделки);
		ТабличныйДокумент.Вывести(ОбластьШапкаСрочныеСделки);
	КонецЕсли;
	
	Для каждого СтрокаТабличнойЧасти Из СрочныеСделки Цикл
		
		ОбластьСтрокаСрочныеСделки.Параметры.НомерСделки 				= СтрокаТабличнойЧасти.НомерСделки;
		ОбластьСтрокаСрочныеСделки.Параметры.ДатаСделки 				= СтрокаТабличнойЧасти.Дата;
		ОбластьСтрокаСрочныеСделки.Параметры.НаименованиеАктива 		= СтрокаТабличнойЧасти.АктивПредставление;
		
		Если СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаНаСрочномРынке.Покупка") Тогда
			ТипСделки = "Покупка";
		Иначе
			ТипСделки = "Продажа";
		КонецЕсли; 
		
		ОбластьСтрокаСрочныеСделки.Параметры.ТипСделки 						= ТипСделки;
		ОбластьСтрокаСрочныеСделки.Параметры.Количество 					= СтрокаТабличнойЧасти.Количество;
		ОбластьСтрокаСрочныеСделки.Параметры.ВалютаРасчетов 				= СтрокаТабличнойЧасти.ВалютаПредставление;
		ОбластьСтрокаСрочныеСделки.Параметры.Цена 							= СтрокаТабличнойЧасти.Цена;
		ОбластьСтрокаСрочныеСделки.Параметры.СуммаСделки 					= СтрокаТабличнойЧасти.Сумма;
		
		ОбластьСтрокаСрочныеСделки.Параметры.БиржевойСбор 					= СтрокаТабличнойЧасти.КомиссияБиржи;
		ОбластьСтрокаСрочныеСделки.Параметры.КомиссияБрокера 				= СтрокаТабличнойЧасти.КомиссияБрокера;
		
		ОбластьСтрокаСрочныеСделки.Параметры.РазмерПремии					= СтрокаТабличнойЧасти.ОпционнаяПремия;
		
		ОбластьСтрокаСрочныеСделки.Параметры.ТорговаяПлощадка				= СтрокаТабличнойЧасти.БиржаПредставление;
		
		СтатусСделки = "";
		ДатаПоставки = Дата(1, 1, 1);
		ДатаОплаты = Дата(1, 1, 1);
		ДатаПоставкиФакт = Дата(1, 1, 1);
		ДатаОплатыФакт = Дата(1, 1, 1);
		
		Если PDF Тогда
			//ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаСрочныеСделки, ОбластьСтрокаСрочныеСделки); //TM-3169
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаСрочныеСделки, ОбластьСтрокаСрочныеСделки, ,СтруктураОтчета); //TM-3169 IMAPPS-21832
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаСрочныеСделки);
			ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь); //IMAPPS-21832
		КонецЕсли;
		
	КонецЦикла;
	
	ВалютныеСделки = ДанныеРаздела.ВалютныеСделки;
	
	Если PDF Тогда
		ПроверитьВывестиОбластьРазделШапка(ТабличныйДокумент, ОбластьШапкаВалютныеСделки, ОбластьРазделВалютныеСделки);
	Иначе
		ТабличныйДокумент.Вывести(ОбластьРазделВалютныеСделки);
		ТабличныйДокумент.Вывести(ОбластьШапкаВалютныеСделки);
	КонецЕсли;
	
	Для каждого СтрокаТабличнойЧасти Из ВалютныеСделки Цикл
		
		ОбластьСтрокаВалютныеСделки.Параметры.НомерСделки 				= СтрокаТабличнойЧасти.НомерСделки;
		ОбластьСтрокаВалютныеСделки.Параметры.ДатаСделки 				= СтрокаТабличнойЧасти.Дата;
		ОбластьСтрокаВалютныеСделки.Параметры.Инструмент 				= СтрокаТабличнойЧасти.Инструмент;
		
		ТипСделки = "";
		
		Если СтрокаТабличнойЧасти.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСделкаСВалютой.Покупка") Тогда
			ТипСделки = "Покупка";
		Иначе
			ТипСделки = "Продажа";
		КонецЕсли;
		
		//IMAPPS-29205 ++
		Если не СокрЛП(СтрокаТабличнойЧасти.БрокерКонтрагент) = "" Тогда
			ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(СтрокаТабличнойЧасти.БрокерКонтрагент,"Ключ");
			Если ДанныеСноски = Неопределено Тогда
				ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Добавить();
				ДанныеСноски.Ключ = СтрокаТабличнойЧасти.БрокерКонтрагент;
				ДанныеСноски.Номер = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Количество();
				ДанныеСноски.Сноска = ПолучитьТекстСноски(ДанныеСноски.Номер);
				ДанныеСноски.ТекстСноски = ДанныеСноски.Сноска + " - " + СтрокаТабличнойЧасти.БрокерНаименованиеПолное;
			КонецЕсли;
						
			СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = ДанныеСноски.Номер;
			СноскаТекст = ДанныеСноски.Сноска;
		КонецЕсли;
		
		ОбластьСтрокаВалютныеСделки.Параметры.ВалютаБазовая 			= СтрокаТабличнойЧасти.ВалютаБазоваяПредставление;
		ОбластьСтрокаВалютныеСделки.Параметры.ВалютаРасчетов 			= СтрокаТабличнойЧасти.ВалютаРасчетовПредставление;
		
		ОбластьСтрокаВалютныеСделки.Параметры.ТипСделки 				= ТипСделки;
		ОбластьСтрокаВалютныеСделки.Параметры.Количество 				= СтрокаТабличнойЧасти.Количество;
		ОбластьСтрокаВалютныеСделки.Параметры.Курс 						= СтрокаТабличнойЧасти.Курс;
		ОбластьСтрокаВалютныеСделки.Параметры.СуммаСделки 				= СтрокаТабличнойЧасти.Сумма;
		
		ОбластьСтрокаВалютныеСделки.Параметры.БиржевойСбор 				= СтрокаТабличнойЧасти.КомиссияБиржи;
		ОбластьСтрокаВалютныеСделки.Параметры.КомиссияБрокера 			= СтрокаТабличнойЧасти.КомиссияБрокера;
		ОбластьСтрокаВалютныеСделки.Параметры.ДатаПоставкиПлан			= СтрокаТабличнойЧасти.ДатаПоставкиПлан;
		ОбластьСтрокаВалютныеСделки.Параметры.ДатаОплатыПлан			= СтрокаТабличнойЧасти.ДатаОплатыПлан;
		
		ФактическаяДатаПоставки = СтрокаТабличнойЧасти.ФактическаяДатаПоставки;
		ФактическаяДатаПлатежа 	= СтрокаТабличнойЧасти.ФактическаяДатаПлатежа;
		
		ОбластьСтрокаВалютныеСделки.Параметры.ДатаПоставкиФакт			= ФактическаяДатаПоставки;
		ОбластьСтрокаВалютныеСделки.Параметры.ДатаОплатыФакт			= ФактическаяДатаПлатежа;
		
		СтатусСделки = ?(ЗначениеЗаполнено(ФактическаяДатаПоставки) И ЗначениеЗаполнено(ФактическаяДатаПлатежа)
			И ФактическаяДатаПоставки <= ДатаОкончания И ФактическаяДатаПлатежа <= ДатаОкончания, "Завершена", "Не завершена");
		
		ОбластьСтрокаВалютныеСделки.Параметры.СтатусСделки				= СтатусСделки;
		ОбластьСтрокаВалютныеСделки.Параметры.ТорговаяПлощадка			= СтрокаТабличнойЧасти.БиржаПредставление;
		ОбластьСтрокаВалютныеСделки.Параметры.Брокер					= СноскаТекст + СтрокаТабличнойЧасти.Брокер;
		
		Если PDF Тогда
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаВалютныеСделки, ОбластьСтрокаВалютныеСделки, ,СтруктураОтчета);
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаВалютныеСделки);
			ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
	ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Истина, Ложь); //IMAPPS-21832
	
КонецПроцедуры

Процедура ЗаполнитьРаздел4Общая(СтруктураОтчета, Макет, ДанныеРаздела, ТипФайла)
	
	PDF = ТипФайла = "pdf";
	
	ДатаНачалаПредставление 	= Формат(ДатаНачала, "ДФ=dd.MM.yyyy");
	ДатаОкончанияПредставление 	= Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	ОбластьЗаголовокДДС 		= Макет.ПолучитьОбласть("ЗаголовокДДС");
	ОбластьШапкаСчета 			= Макет.ПолучитьОбласть("ШапкаСчета");
	ОбластьСтрокаСчета 			= Макет.ПолучитьОбласть("СтрокаСчета");
	ОбластьВходящийДО 			= Макет.ПолучитьОбласть("ВходящийДО");
	ОбластьИсходящийДО 			= Макет.ПолучитьОбласть("ИсходящийДО");
	ОбластьШапкаДДС 			= Макет.ПолучитьОбласть("ШапкаДДС");
	
	Если PDF Тогда
		ТабличныйДокумент = СтруктураОтчета.РазделPDF4;
		
		ОбластьЧертаКолонтитула		= Макет.ПолучитьОбласть("ЧертаКолонтитула");
		ТабличныйДокумент.Вывести(ОбластьЧертаКолонтитула);
	Иначе
		ТабличныйДокумент = СтруктураОтчета.Раздел4;
	КонецЕсли;
	
	ОбластьЗаголовокДДС.Параметры.НачалоПериода = ДатаНачалаПредставление;
	ОбластьЗаголовокДДС.Параметры.КонецПериода = ДатаОкончанияПредставление;
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокДДС);
	
	БанковскиеСчета		 = ДанныеРаздела.БанковскиеСчета;
	ОстаткиНачалоПериода = ДанныеРаздела.ОстаткиНачалоПериода;
	ОстаткиКонецПериода	 = ДанныеРаздела.ОстаткиКонецПериода;
	ОборотыСчета		 = ДанныеРаздела.Обороты;
	
	Для каждого СтрокаТаблицыЗначений Из БанковскиеСчета Цикл
		
		ОбластьСтрокаДДС = Неопределено; // TM-3361
		
		Если PDF Тогда
			//ПроверитьВывестиОбластьРазделШапка(ТабличныйДокумент, ОбластьШапкаСчета); // TM-3208
			ПроверитьВывестиОбластьРазделШапка(ТабличныйДокумент, ОбластьШапкаСчета, , , СтруктураОтчета); // TM-3208  IMAPPS-21832
		Иначе
			ТабличныйДокумент.Вывести(ОбластьШапкаСчета);
			ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь); //IMAPPS-21832
		КонецЕсли;
		
		ОбластьСтрокаСчета.Параметры.Номер = СтрокаТаблицыЗначений.НомерСчета;
		ОбластьСтрокаСчета.Параметры.Валюта = СтрокаТаблицыЗначений.ВалютаПредставление;
		
		НаименованиеБанка = "";
		Местонахождение = "";
		
		Если СтрокаТаблицыЗначений.ВидСчета = ПредопределенноеЗначение("Перечисление.ВидБанковскогоСчета.Брокерский") Тогда
			НаименованиеБанка = СтрокаТаблицыЗначений.НаименованиеБрокера;
			Местонахождение = СтрокаТаблицыЗначений.ФактическийАдрес;
		Иначе
			НаименованиеБанка = СтрокаТаблицыЗначений.НаименованиеБанка;
			Местонахождение = СтрокаТаблицыЗначений.АдресБанка;
		КонецЕсли; 
		
		//IMAPPS-21832++
		//ОбластьСтрокаСчета.Параметры.Наименование = НаименованиеБанка;
		СноскаТекст = "";
		ДанныеСноски = Неопределено;
		БрокерБанк = Неопределено;
		Если СтрокаТаблицыЗначений.ВидСчета = ПредопределенноеЗначение("Перечисление.ВидБанковскогоСчета.Брокерский") Тогда
			БрокерБанк = СтрокаТаблицыЗначений.Брокер;
		Иначе
			БрокерБанк = СтрокаТаблицыЗначений.Банк;
		КонецЕсли;
		Если ЗначениеЗаполнено(БрокерБанк) Тогда
			НаименованиеПолное = "";
			Если ТипЗнч(БрокерБанк) = Тип("СправочникСсылка.Контрагенты") Тогда
				НаименованиеПолное = БрокерБанк.НаименованиеПолное;
			ИначеЕсли ТипЗнч(БрокерБанк) = Тип("СправочникСсылка.Банки") Тогда
				//Для банка нужно найти Контрагента и из него взять Полное наименование
				КонтрагентБанк = КонтрагентБанк(БрокерБанк);
				Если ЗначениеЗаполнено(КонтрагентБанк) Тогда
					БрокерБанк = КонтрагентБанк;
					НаименованиеПолное = БрокерБанк.НаименованиеПолное;
				Иначе
					НаименованиеПолное = БрокерБанк.Наименование;
				КонецЕсли;
			КонецЕсли;
			ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Найти(БрокерБанк,"Ключ");
			Если ДанныеСноски = Неопределено Тогда
				ДанныеСноски = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Добавить();
				ДанныеСноски.Ключ = БрокерБанк;
				ДанныеСноски.Номер = СтруктураОтчета.ДанныеСносок.СоответствиеСносок.Количество();
				ДанныеСноски.Сноска = ПолучитьТекстСноски(ДанныеСноски.Номер);
				ДанныеСноски.ТекстСноски = ДанныеСноски.Сноска + " - " + НаименованиеПолное;
			КонецЕсли;
			
			//Если СтрНайти(нрег(ДанныеСноски.ТекстСноски), "сб-брокер") <> 0 И СтрНайти(нрег(ДанныеСноски.ТекстСноски), "платформа") = 0 Тогда
			//	ДанныеСноски.ТекстСноски = ДанныеСноски.ТекстСноски + " (до 28.03.2024г. Общество с ограниченной ответственностью Брокерская компания Платформа).";
			//КонецЕсли;
			
			СтруктураОтчета.ДанныеСносок.ТекущийНомерСноски = ДанныеСноски.Номер;
			СноскаТекст = ДанныеСноски.Сноска;
		КонецЕсли;
		ОбластьСтрокаСчета.Параметры.Наименование = СноскаТекст + СокрЛП(НаименованиеБанка);
		//IMAPPS-21832--
		
		
		//vtb 17.06
		ОбластьСтрокаСчета.Параметры.Местонахождение = СокрЛП(Местонахождение);
		
		ВидБанковскогоСчета = "";
		
		Если СтрокаТаблицыЗначений.ТранзитныйСчет Тогда
			ВидБанковскогоСчета = "Транзитный";
		Иначе
			ВидБанковскогоСчета = СтрокаТаблицыЗначений.ВидСчетаПредставление;
		КонецЕсли;
		
		ОбластьСтрокаСчета.Параметры.ВидСчета = ВидБанковскогоСчета;
		
		Если PDF Тогда
			//ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаСчета, ОбластьСтрокаСчета); // TM-3208
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаСчета, ОбластьСтрокаСчета,,СтруктураОтчета); // TM-3208 IMAPPS-21832
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаСчета);
			ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь); //IMAPPS-21832
		КонецЕсли;
		
		ОбластьВходящийДО.Параметры.Валюта = СтрокаТаблицыЗначений.ВалютаПредставление;
		
		ОтборБанковскийСчет = Новый Структура("БанковскийСчет", СтрокаТаблицыЗначений.БанковскийСчет);
		НайденныеОстатки = ОстаткиНачалоПериода.НайтиСтроки(ОтборБанковскийСчет);
		
		СуммаНачальныйОстаток = 0;
		
		Если НайденныеОстатки.Количество() > 0 Тогда		
			СуммаНачальныйОстаток = НайденныеОстатки[0].Сумма;		
		КонецЕсли; 
		
		ОбластьВходящийДО.Параметры.Сумма = СуммаНачальныйОстаток;
		
		Если PDF Тогда
			//ПроверитьВывестиОбластьРазделШапка(ТабличныйДокумент, ОбластьШапкаДДС, ОбластьВходящийДО); // TM-3169
			ПроверитьВывестиОбластьРазделШапка(ТабличныйДокумент, ОбластьШапкаДДС, ОбластьВходящийДО, , СтруктураОтчета); // TM-3169 IMAPPS-21832
		Иначе
			ТабличныйДокумент.Вывести(ОбластьВходящийДО);
			ТабличныйДокумент.Вывести(ОбластьШапкаДДС);
			ВывестиСноски(ТабличныйДокумент, СтруктураОтчета, PDF, Ложь, Ложь, Ложь); //IMAPPS-21832
		КонецЕсли;
		
		НайденныеОбороты = ОборотыСчета.НайтиСтроки(ОтборБанковскийСчет);
		
		НПП = 1;
		
		ВсегоСтрок = НайденныеОбороты.Количество(); // TM-3208
		
		Для Каждого СтрокаОбороты Из НайденныеОбороты Цикл
			
			ОбластьСтрокаДДС = Макет.ПолучитьОбласть("СтрокаДДС"); // TM-3361
			
			РасходыВключенныеВСтоимость = Новый Соответствие; // TM-3232
			
			ОбластьСтрокаДДС.Параметры.НПП = НПП;
			ОбластьСтрокаДДС.Параметры.Дата = СтрокаОбороты.Дата;
			
			КодСделки = "";
			ОснованиеНаименование = "";
			
			ЭтоНКД = Ложь;
			
			Если ТипЗнч(СтрокаОбороты.Регистратор) = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда // TM-3253 {}
				
				РегистраторРеквизиты = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(СтрокаОбороты.Регистратор, "Номер, БизнесПроцесс, НомерВходящегоДокумента, НазначениеПлатежа");
				
				БизнесПроцесс = РегистраторРеквизиты.БизнесПроцесс; // TM-3253 {}
				
				Если ЗначениеЗаполнено(БизнесПроцесс) И ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.ВнебиржеваяСделка") И Не БизнесПроцесс.СделкаЧерезБрокера Тогда // TM-3329 {}
					
					КодСделки = ОбщегоНазначения.ПолучитьЗначениеРеквизита(БизнесПроцесс, "Номер"); // TM-3329 {}
					
					ОснованиеНаименование = "Оплата по сделке";
					
					Актив = БизнесПроцесс.Актив;
					Если ЗначениеЗаполнено(Актив) Тогда
						
						Если АктивСерверПовтИсп.ЭтоОблигация(Актив) Тогда
							
							НКД = БизнесПроцесс.НКД;
							Если ЗначениеЗаполнено(НКД) Тогда
								ОснованиеНаименование =  "Оплата по сделке( Сумма сделки: " + БизнесПроцесс.СуммаСделки + " ; Сумма НКД: " + НКД + " )"; 
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе // TM-3253 }
					
					Если ЗначениеЗаполнено(РегистраторРеквизиты.БизнесПроцесс) 
						И ТипЗнч(РегистраторРеквизиты.БизнесПроцесс) = Тип("БизнесПроцессСсылка.ВнебиржеваяСделка") Тогда					
						КодСделки = ОбщегоНазначения.ПолучитьЗначениеРеквизита(РегистраторРеквизиты.БизнесПроцесс, "Номер");				
						//vtb 27.06
						ОснованиеНаименование = "Оплата по сделке";
					ИначеЕсли НЕ ПустаяСтрока(РегистраторРеквизиты.НомерВходящегоДокумента) Тогда 
						КодСделки = РегистраторРеквизиты.НомерВходящегоДокумента;
					Иначе
						КодСделки = РегистраторРеквизиты.Номер;
					КонецЕсли; 
					
					//vtb 27.06
					если ОснованиеНаименование = "" тогда ОснованиеНаименование = РегистраторРеквизиты.НазначениеПлатежа конецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(СтрокаОбороты.Регистратор) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда // TM-3253 {}
				
				РегистраторРеквизиты = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(СтрокаОбороты.Регистратор, "Номер, БизнесПроцесс, НомерВходящегоДокумента, НазначениеПлатежа");
				
				БизнесПроцесс = РегистраторРеквизиты.БизнесПроцесс; // TM-3253 {}
				
				Если ЗначениеЗаполнено(БизнесПроцесс) И ТипЗнч(БизнесПроцесс) = Тип("БизнесПроцессСсылка.ВнебиржеваяСделка") И Не БизнесПроцесс.СделкаЧерезБрокера Тогда // TM-3329 {}
					
					КодСделки = ОбщегоНазначения.ПолучитьЗначениеРеквизита(БизнесПроцесс, "Номер"); // TM-3329 {}
					
					ОснованиеНаименование = "Оплата по сделке";
					
					Актив = БизнесПроцесс.Актив;
					Если ЗначениеЗаполнено(Актив) Тогда
						
						Если АктивСерверПовтИсп.ЭтоОблигация(Актив) Тогда
							
							НКД = БизнесПроцесс.НКД;
							Если ЗначениеЗаполнено(НКД) Тогда
								ОснованиеНаименование =  "Оплата по сделке( Сумма сделки: " + БизнесПроцесс.СуммаСделки + " ; Сумма НКД: " + НКД + " )"; 
							КонецЕсли;
							
						КонецЕсли;
						
