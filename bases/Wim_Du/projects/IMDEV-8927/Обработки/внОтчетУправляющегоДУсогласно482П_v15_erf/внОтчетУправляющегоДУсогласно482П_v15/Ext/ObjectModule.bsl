Функция ПолучитьДанныеРаздел_7(ДоговорДУ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	
	#Область ТекстЗапроса
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ГолосованиеРаспределениеГолосов.Ссылка,
	|	СУММА(ГолосованиеРаспределениеГолосов.КоличествоГолосов) КАК КоличествоГолосов
	|ПОМЕСТИТЬ Голоса
	|ИЗ
	|	Документ.Голосование.РаспределениеГолосов КАК ГолосованиеРаспределениеГолосов
	|ГДЕ
	|	ГолосованиеРаспределениеГолосов.ДоговорДУ = &ДоговорДУ
	|	И ГолосованиеРаспределениеГолосов.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ГолосованиеРаспределениеГолосов.Ссылка.Проведен = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ГолосованиеРаспределениеГолосов.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ГолосованиеИтогиГолосования.ФормулировкаВопроса,
	|	ГолосованиеИтогиГолосования.ФормулировкаРешения,
	|	ГолосованиеИтогиГолосования.ПозицияУправляющейКомпании,
	|	ГолосованиеИтогиГолосования.Ссылка,
	|	ГолосованиеИтогиГолосования.Ссылка.Эмитент,
	|	ГолосованиеИтогиГолосования.Ссылка.Дата
	|ПОМЕСТИТЬ ИтогиГолосования
	|ИЗ
	|	Документ.Голосование.ИтогиГолосования КАК ГолосованиеИтогиГолосования
	|ГДЕ
	|	ГолосованиеИтогиГолосования.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ГолосованиеИтогиГолосования.Ссылка.Проведен = ИСТИНА
	|	И ГолосованиеИтогиГолосования.Ссылка.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Голоса.Ссылка
	|			ИЗ
	|				Голоса КАК Голоса)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Голоса.КоличествоГолосов,
	|	ЕСТЬNULL(ИтогиГолосования.ФормулировкаВопроса, """") КАК ФормулировкаВопроса,
	|	ЕСТЬNULL(ИтогиГолосования.ФормулировкаРешения, """") КАК ФормулировкаРешения,
	|	ЕСТЬNULL(ИтогиГолосования.ПозицияУправляющейКомпании, """") КАК ПозицияУправляющейКомпании,
	|	ЕСТЬNULL(ИтогиГолосования.Эмитент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Эмитент,
	|	ЕСТЬNULL(ИтогиГолосования.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК Дата
	|ПОМЕСТИТЬ Данные
	|ИЗ
	|	Голоса КАК Голоса
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиГолосования КАК ИтогиГолосования
	|		ПО Голоса.Ссылка = ИтогиГолосования.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Данные.КоличествоГолосов,
	|	Данные.ФормулировкаВопроса,
	|	Данные.ФормулировкаРешения,
	|	Данные.ПозицияУправляющейКомпании,
	|	Данные.Эмитент,
	|	Данные.Дата КАК Дата
	|ИЗ
	|	Данные КАК Данные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Данные.Эмитент,
	|	Данные.Эмитент.НаименованиеПолное КАК НаименованиеПолное
	|ИЗ
	|	Данные КАК Данные";
	
	
	#КонецОбласти 
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	
	ДанныеРаздела = Новый Структура;
	
	РезультатЗапроса =  Запрос.ВыполнитьПакет();
	
	ДанныеРаздела.Вставить("Голосование", РезультатЗапроса[3].Выгрузить());
	ДанныеРаздела.Вставить("Эмитенты", РезультатЗапроса[4].Выгрузить());
	
	Возврат ДанныеРаздела;
	
КонецФункции

