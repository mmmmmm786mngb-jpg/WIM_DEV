		Если СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимости = ПредопределенноеЗначение("Справочник.Валюты.RUB") Тогда		
			ОбластьСтрокаКорпОблигации.Параметры.КурсЦБ	= 0;
			ОбластьСтрокаКорпОблигации.Параметры.ТипКурса = "";
		Иначе			
			КурсВалюты = КурсыВалют.Получить(СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимости);
			Если КурсВалюты = Неопределено Тогда
				КурсВалюты = МодульВалютногоУчета.ПолучитьКурсВалюты(ПредопределенноеЗначение("Справочник.Валюты.RUB"), СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимости, ДатаОкончания);
				КурсыВалют.Вставить(СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимости, КурсВалюты);
			КонецЕсли;
			ОбластьСтрокаКорпОблигации.Параметры.КурсЦБ	= КурсВалюты.Курс;
			ОбластьСтрокаКорпОблигации.Параметры.ТипКурса = СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимостиПредставление + "/RUB";
		КонецЕсли;
		
		Если PDF Тогда
			ЭтоПоследняяСтрока = Счетчик = ВсегоСтрок; // TM-3208
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаКорпОблигации, ОбластьСтрокаКорпОблигации, ЭтоПоследняяСтрока);  
		Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаКорпОблигации);
		КонецЕсли;
		
	КонецЕсли;
		
		МунОблКоличествоИтог 			= МунОблКоличествоИтог + СтрокаТаблицыЗначений.Количество;
		МунОблБалансоваяСуммаИтог 		= МунОблБалансоваяСуммаИтог + СтрокаТаблицыЗначений.БалансоваяСтоимость;
		МунОблНоминалИтог 				= МунОблНоминалИтог + НоминальнаяСтоимость;
		МунОблРыночнаяСуммаRURИтог 		= МунОблРыночнаяСуммаRURИтог + РыночнаяОценкаRUR;
		МунОблРыночнаяСуммаUSDИтог 		= МунОблРыночнаяСуммаUSDИтог + РыночнаяОценкаUSD;
		МунОблБалансовыйНКДИтог			= МунОблБалансовыйНКДИтог + ?(ЗагружатьДанные И СтрокаТаблицыЗначений.БалансоваяСтоимость = 0, 0,СтрокаТаблицыЗначений.НКД);
		МунОблУпрНКДИтог				= МунОблУпрНКДИтог + СтрокаТаблицыЗначений.УпрНКД;
		
	КонецЦикла; 
	
	// IMAPPS-30982
	//Если НЕ СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанныеЕПС Тогда
	Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
		ОбластьИтогоКорпОблигации.Параметры.БалансовыеДанныеСтоимость 	= МунОблБалансоваяСуммаИтог; 
		ОбластьИтогоКорпОблигации.Параметры.БалансовыеДанныеНКД 		= МунОблБалансовыйНКДИтог;
	КонецЕсли;
	//DDneprovsky IMAPPS-13406
	//ОбластьИтогоКорпОблигации.Параметры.РыночнаяОценкаUSD 			= МунОблРыночнаяСуммаUSDИтог;
	ОбластьИтогоКорпОблигации.Параметры.РыночнаяОценкаRUR 			= МунОблРыночнаяСуммаRURИтог;
	ОбластьИтогоКорпОблигации.Параметры.НКДСумма 					= МунОблУпрНКДИтог;
	
	Если PDF Тогда
		
		//vtb 01.07.2016
		Если ВсегоСтрок <> 0 Тогда	
			ПроверитьВывестиОбластьИтого(ТабличныйДокумент, ОбластьШапкаКорпОблигации, ОбластьИтогоКорпОблигации, ОбластьСтрокаКорпОблигации); // TM-3208
		КонецЕсли;
		
	Иначе
		
		//vtb 01.07.2016
		Если МуниципальныеОблигации.Количество() <> 0 Тогда	
			ТабличныйДокумент.Вывести(ОбластьИтогоКорпОблигации);
		КонецЕсли;
	КонецЕсли;
	
	//IMAPPS-33171++
	Если НЕ СкрыватьБалансовуюСтоимость Тогда
		СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.БалансоваяСтоимость = СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.БалансоваяСтоимость + МунОблБалансоваяСуммаИтог + МунОблБалансовыйНКДИтог;
	КонецЕсли;
	СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.РыночнаяСтоимость = СтруктураОбластей.ОбластьИтогоВсегоЦБ.Параметры.РыночнаяСтоимость + МунОблРыночнаяСуммаRURИтог;


КонецФункции   

Функция ОбработатьИпотечныеОблигации(ИпотечныеОблигации, ДанныеРаздела, СтруктураОтчета, PDF, ТабличныйДокумент, СтруктураОбластей, СтруктураОбластейКорпОблигаций) 

	Депозитарий = ДанныеРаздела.ДанныеДепозитария;
	
	ОбластьСтрокаКорпОблигации = СтруктураОбластейКорпОблигаций.ОбластьСтрокаКорпОблигации;
	ОбластьСтрокаКорпОблигации2 = СтруктураОбластейКорпОблигаций.ОбластьСтрокаКорпОблигации2;
	ОбластьШапкаКорпОблигации = СтруктураОбластейКорпОблигаций.ОбластьШапкаКорпОблигации; 
	ОбластьИтогоКорпОблигации = СтруктураОбластейКорпОблигаций.ОбластьИтогоКорпОблигации; 
	ОбластьШапкаАктивы = СтруктураОбластей.ОбластьШапкаАктивы;
	ОбластьИтогоАктивы = СтруктураОбластей.ОбластьИтогоАктивы;
	
	КурсыВалют = Новый Соответствие;
	КурсыВалют.Вставить(ПредопределенноеЗначение("Справочник.Валюты.USD"), ДанныеРаздела.КурсUSD);
	
	ИпОблКоличествоИтог 		= 0;
	ИпОблБалансоваяСуммаИтог 	= 0;
	ИпОблНоминалИтог 			= 0;
	ИпОблРыночнаяСуммаRURИтог 	= 0;
	ИпОблРыночнаяСуммаUSDИтог 	= 0;
	ИпОблУпрНКДИтог			= 0;
	ИпОблБалансовыйНКДИтог 	= 0;
	РыночнаяОценкаUSD			= 0;             //IMAPPS-24443
	
	//&_Галимов_Начало 28.12.2016 21:41:04
	Если ЗагружатьДанныеЕПС = Истина Тогда
		ДополнитьДаннымиЕПС_ТипВложения(СтруктураДанныхЕПС.ТаблицаОстатковЕПС, ИпотечныеОблигации);
	КонецЕсли;
	//&_Галимов_Конец 28.12.2016 21:41:06  
	Если ЗагружатьДанныеРСБУ = Истина Тогда
		ДополнитьДаннымиЕПС_ТипВложения(СтруктураДанныхЕПС.ТаблицаРСБУ_ЦБ_Собственные, ИпотечныеОблигации);
	КонецЕсли;
	
	Счетчик = 0;                                  // TM-3208
	ВсегоСтрок = ИпотечныеОблигации.Количество(); // TM-3208
	
	Для Каждого СтрокаТаблицыЗначений Из ИпотечныеОблигации Цикл
		
		//&_Галимов_Начало 28.12.2016 21:29:08 
		//СтруктураПараметровЕПС = Новый Структура;
		//СтруктураПараметровЕПС.Вставить("ТипВложения", СтрокаТаблицыЗначений.ТипВложения);
		//ОбластьСтрокаКорпОблигации.Параметры.Заполнить(СтруктураПараметровЕПС);
		//&_Галимов_Конец 28.12.2016 21:29:09 
		
		Если СтрокаТаблицыЗначений.Количество = 0 Тогда
			Продолжить;
		Конецесли;
		Счетчик = Счетчик + 1; // TM-3208
		
		Отбор = Новый Структура();
		Отбор.Вставить("АктивНаименование",СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление);
		Строки = Депозитарий.НайтиСтроки(Отбор);
		Если Строки.Количество() > 1 и НЕ ЗагружатьДанные  Тогда
			ОбластьСтрокаКорпОблигации2.Параметры.Депозитарий1    = Строки[0].НаименованиеСокращенное;
		    ОбластьСтрокаКорпОблигации2.Параметры.МестоДепозитария1              = Строки[0].Представление;
		    ОбластьСтрокаКорпОблигации2.Параметры.ИННДеп1                        = Строки[0].ИНН;
		    ОбластьСтрокаКорпОблигации2.Параметры.ОГРНДеп1                       = Строки[0].ОГРН;
	        ОбластьСтрокаКорпОблигации2.Параметры.Депозитарий2    = Строки[1].НаименованиеСокращенное;
		    ОбластьСтрокаКорпОблигации2.Параметры.МестоДепозитария2              = Строки[1].Представление;
		    ОбластьСтрокаКорпОблигации2.Параметры.ИННДеп2                        = Строки[1].ИНН;
		    ОбластьСтрокаКорпОблигации2.Параметры.ОГРНДеп2                       = Строки[1].ОГРН; 
	        ОбластьСтрокаКорпОблигации2.Параметры.Количество1 = Строки[0].Количество;
            ОбластьСтрокаКорпОблигации2.Параметры.Количество2 = Строки[1].Количество;
            ОбластьСтрокаКорпОблигации2.Параметры.НаименованиеЦБ 			= СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление;
		    ОбластьСтрокаКорпОблигации2.Параметры.НомерГосРегистрации 		= СтрокаТаблицыЗначений.ISIN;
		    ОбластьСтрокаКорпОблигации2.Параметры.БалансовыеДанныеСтоимость 	= СтрокаТаблицыЗначений.БалансоваяСтоимость;
		    ОбластьСтрокаКорпОблигации2.Параметры.БалансовыеДанныеНКД 		= ?(ЗагружатьДанные И СтрокаТаблицыЗначений.БалансоваяСтоимость = 0, 0,СтрокаТаблицыЗначений.НКД);
		
		    ОбластьСтрокаКорпОблигации2.Параметры.БалансовыеДанныеЦена 	= СтрокаТаблицыЗначений.БалансоваяЦена;
		    ОбластьСтрокаКорпОблигации2.Параметры.РыночнаяЦенаРубли 		= СтрокаТаблицыЗначений.РыночнаяЦена;
		
		    ОбластьСтрокаКорпОблигации2.Параметры.РыночнаяЦена 		= СтрокаТаблицыЗначений.Котировка;
		
		    ОбластьСтрокаКорпОблигации2.Параметры.ИсточникКотировки 	= СтрокаТаблицыЗначений.БиржаПредставление;
		    ОбластьСтрокаКорпОблигации2.Параметры.ДатаКотировки 		= СтрокаТаблицыЗначений.ДатаКотировки;
			
		
		    НоминальнаяСтоимость = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(СтрокаТаблицыЗначений.ЦеннаяБумага, ДатаОкончания);
		
		    ОбластьСтрокаКорпОблигации2.Параметры.НоминалСумма 		= НоминальнаяСтоимость;
		
		    ОбластьСтрокаКорпОблигации2.Параметры.НоминалЕдИзм 		= СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимостиПредставление;
		
		    ОбластьСтрокаКорпОблигации2.Параметры.НКДСумма 			= СтрокаТаблицыЗначений.УпрНКД;
		    ОбластьСтрокаКорпОблигации2.Параметры.НКДЕдИзм 			= СтрокаТаблицыЗначений.УпрНКДВалютаПредставление;
			
			//РыночнаяОценкаRUR = СтрокаТаблицыЗначений.РыночнаяСтоимость + СтрокаТаблицыЗначений.УпрНКД; 
			РыночнаяОценкаRUR = СтрокаТаблицыЗначений.РыночнаяСтоимость;
		
		   ОбластьСтрокаКорпОблигации.Параметры.РыночнаяОценкаRUR = РыночнаяОценкаRUR;
		
		   РыночнаяОценкаUSD = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(
		   РыночнаяОценкаRUR,
		   ПредопределенноеЗначение("Справочник.Валюты.RUB"), ПредопределенноеЗначение("Справочник.Валюты.USD"),
		   1, ДанныеРаздела.КурсUSD.Курс, 
		   1, ДанныеРаздела.КурсUSD.Кратность);
		
		//
		//ОбластьСтрокаКорпОблигации.Параметры.РыночнаяОценкаUSD = РыночнаяОценкаUSD;
		
		   Если СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимости = ПредопределенноеЗначение("Справочник.Валюты.RUB") Тогда		
			ОбластьСтрокаКорпОблигации2.Параметры.КурсЦБ	= 0;
			ОбластьСтрокаКорпОблигации2.Параметры.ТипКурса = "";
		   Иначе			
			КурсВалюты = КурсыВалют.Получить(СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимости);
			Если КурсВалюты = Неопределено Тогда
				КурсВалюты = МодульВалютногоУчета.ПолучитьКурсВалюты(ПредопределенноеЗначение("Справочник.Валюты.RUB"), СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимости, ДатаОкончания);
				КурсыВалют.Вставить(СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимости, КурсВалюты);
			КонецЕсли;
				ОбластьСтрокаКорпОблигации2.Параметры.КурсЦБ	= КурсВалюты.Курс;
				ОбластьСтрокаКорпОблигации2.Параметры.ТипКурса = СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимостиПредставление + "/RUB"
			КонецЕсли;
		
			Если ОбластьСтрокаКорпОблигации2.Параметры.ТипВложения = "СБСТВ РЕПО" Тогда
				ОбластьСтрокаКорпОблигации2.Параметры.Депозитарий1   			= "";
				ОбластьСтрокаКорпОблигации2.Параметры.МестоДепозитария1         = "";
				ОбластьСтрокаКорпОблигации2.Параметры.ИННДеп1                   = "";
				ОбластьСтрокаКорпОблигации2.Параметры.ОГРНДеп1                  = "";
				ОбластьСтрокаКорпОблигации2.Параметры.Депозитарий2    			= "";
				ОбластьСтрокаКорпОблигации2.Параметры.МестоДепозитария2         = "";
				ОбластьСтрокаКорпОблигации2.Параметры.ИННДеп2                   = "";
				ОбластьСтрокаКорпОблигации2.Параметры.ОГРНДеп2                  = "";
			КонецЕсли;
		
		   Если PDF Тогда
			ЭтоПоследняяСтрока = Счетчик = ВсегоСтрок; // TM-3208
			ПроверитьВывестиОбластьСтрока(ТабличныйДокумент, ОбластьШапкаКорпОблигации, ОбластьСтрокаКорпОблигации2, ЭтоПоследняяСтрока);  
		   Иначе
			ТабличныйДокумент.Вывести(ОбластьСтрокаКорпОблигации2);
		   КонецЕсли;
	   Иначе 	
		   ОбластьСтрокаКорпОблигации.Параметры.НаименованиеЦБ 			= СтрокаТаблицыЗначений.ЦеннаяБумагаПредставление;
		   ОбластьСтрокаКорпОблигации.Параметры.НомерГосРегистрации 		= СтрокаТаблицыЗначений.ISIN;
		   ОбластьСтрокаКорпОблигации.Параметры.Количество 				= СтрокаТаблицыЗначений.Количество; 
		   
		   // IMAPPS-30982
		   //Если НЕ СкрыватьБалансовуюСтоимость И НЕ ЗагружатьДанныеЕПС Тогда
		   Если НЕ СкрыватьБалансовуюСтоимость Тогда      // IMAPPS-32385
			   ОбластьСтрокаКорпОблигации.Параметры.БалансовыеДанныеСтоимость 	= СтрокаТаблицыЗначений.БалансоваяСтоимость;
			   ОбластьСтрокаКорпОблигации.Параметры.БалансовыеДанныеНКД 		= ?(ЗагружатьДанные И СтрокаТаблицыЗначений.БалансоваяСтоимость = 0, 0,СтрокаТаблицыЗначений.НКД);
			   ОбластьСтрокаКорпОблигации.Параметры.БалансовыеДанныеЦена 	= СтрокаТаблицыЗначений.БалансоваяЦена; 
		   КонецЕсли;
		   
		   ОбластьСтрокаКорпОблигации.Параметры.РыночнаяЦенаРубли 		= СтрокаТаблицыЗначений.РыночнаяЦена;
		
		   ОбластьСтрокаКорпОблигации.Параметры.РыночнаяЦена 		= СтрокаТаблицыЗначений.Котировка;
		
		   ОбластьСтрокаКорпОблигации.Параметры.ИсточникКотировки 	= СтрокаТаблицыЗначений.БиржаПредставление;
		   ОбластьСтрокаКорпОблигации.Параметры.ДатаКотировки 		= СтрокаТаблицыЗначений.ДатаКотировки;
		
		   НоминальнаяСтоимость = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(СтрокаТаблицыЗначений.ЦеннаяБумага, ДатаОкончания);
		
		   ОбластьСтрокаКорпОблигации.Параметры.НоминалСумма 		= НоминальнаяСтоимость;
		
		   ОбластьСтрокаКорпОблигации.Параметры.НоминалЕдИзм 		= СтрокаТаблицыЗначений.ВалютаНоминальнойСтоимостиПредставление;
		
		   ОбластьСтрокаКорпОблигации.Параметры.НКДСумма 			= СтрокаТаблицыЗначений.УпрНКД;
		   ОбластьСтрокаКорпОблигации.Параметры.НКДЕдИзм 			= СтрокаТаблицыЗначений.УпрНКДВалютаПредставление;
		
		   //РыночнаяОценкаRUR = СтрокаТаблицыЗначений.РыночнаяСтоимость + СтрокаТаблицыЗначений.УпрНКД; 
			РыночнаяОценкаRUR = СтрокаТаблицыЗначений.РыночнаяСтоимость;
		
				//IMAPPS-23458
		   //Если ЗначениеЗаполнено(Строки[0].НаименованиеСокращенное) и НЕ ЗагружатьДанные  Тогда		
