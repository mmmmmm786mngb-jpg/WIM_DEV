	// ++ IMAPPS-24743 Чижов В.В. 14.02.2024
	КонецЕсли;
	// -- IMAPPS-24743 Чижов В.В. 14.02.2024
	
	СтруктураОтчета = ПодготовитьСтруктуруОтчета();
	
	//&_Галимов_Начало 20.07.2017 22:00:57
	ПолучитьДанныеЕПСиРСБУ(ДоговорДУ);
	//&_Галимов_Конец 20.07.2017 22:00:58 
	
	ВыводитьНаФорму = (ВыгружатьВФорматеExcel = Ложь) И (ВыгружатьВФорматеPDF = Ложь);
	
	// Параметры ДоговораДУ
	ПВХ = ПланыВидовХарактеристик.ПараметрыДоговораДУ;
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПВХ.ВеличинаВознагражденияЗаУспех);
	МассивПараметров.Добавить(ПВХ.ОтражатьСведенияСЧАДоходностьСНачалаИнвестирования); // TM-3093
	МассивПараметров.Добавить(ПВХ.ОценкаНезавершенныхСделокПоСС);
	
	СписокПараметров = РегистрыСведений.ЗначенияПараметровДоговораДУ.ЗначенияПараметровДоговораДУ(ДоговорДУ, МассивПараметров, КонецДня(ДатаОкончания));
	
	
	// Раздел 1
	
	ДанныеРаздела = ПолучитьДанныеРаздел_1(ДоговорДУ);
	
	// TM-3255 {
	Если ДанныеРаздела <> Неопределено Тогда
		Если ВыгружатьВФорматеExcel ИЛИ ВыводитьНаФорму Тогда
			ЗаполнитьРаздел1Общая(СтруктураОтчета, Макет, ДанныеРаздела, "xls"); // TM-3253 {}
		КонецЕсли;
		Если ВыгружатьВФорматеPDF Тогда
			ЗаполнитьРаздел1Общая(СтруктураОтчета, Макет, ДанныеРаздела, "pdf"); // TM-3253 {}
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	// TM-3255 {
	
	// Раздел 2
	
	Если ПоставкаПротивПлатежа Тогда
		ДанныеРаздела = ПолучитьДанныеРаздел_2_ПоставкаПротивПлатежа(ДоговорДУ) // IMAPPS-33115
	Иначе
		ДанныеРаздела = ПолучитьДанныеРаздел_2(ДоговорДУ);
	КонецЕсли;
	//IMAPPS-33189
	Если ПоставкаПротивПлатежа Тогда
		Если ВыгружатьВФорматеExcel ИЛИ ВыводитьНаФорму Тогда
			ЗаполнитьРаздел2Общая_ПоставкаПротивПлатежа(СтруктураОтчета, Макет, ДанныеРаздела, "xls"); // IMAPPS-33115
		КонецЕсли;
		
		Если ВыгружатьВФорматеPDF Тогда
			ЗаполнитьРаздел2Общая_ПоставкаПротивПлатежа(СтруктураОтчета, Макет, ДанныеРаздела, "pdf"); // IMAPPS-33115
		КонецЕсли;
	Иначе
		Если ВыгружатьВФорматеExcel ИЛИ ВыводитьНаФорму Тогда
			ЗаполнитьРаздел2Общая(СтруктураОтчета, Макет, ДанныеРаздела, "xls"); // TM-3253 {}
		КонецЕсли;
	//IMAPPS-33189
