&НаКлиенте
Процедура УстановитьВидимостьЭлементовНаФорме()
	
	Элементы.ДоговорДУ.Видимость = Отчет.РежимРаботы = 0;
	Элементы.СписокДоговоровДУ.Видимость = Отчет.РежимРаботы <> 0;
	
	Элементы.ПараметрыCom.Видимость = Отчет.РежимРаботы = 2;
	Элементы.КоличествоПотоков.Видимость = Отчет.РежимРаботы = 2;
	
	Отчет.ОтоброжатьФИО = Отчет.РежимРаботы = 0;
	
	Если Отчет.РежимРаботы <> 0 И ЗначениеЗаполнено(ДоговорДУ) Тогда
		СписокДоговоровДУ.Очистить();
		СписокДоговоровДУ.Добавить(ДоговорДУ);
	КонецЕсли;
	
	Если Отчет.РежимРаботы = 2 Тогда
		Элементы.КаталогВыгрузки.Видимость = Ложь;
		Элементы.КаталогВыгрузкиНаСервере.Видимость = Истина;
		Элементы.КаталогВыгрузкиНаСервереКопия.Видимость = Истина;
		Элементы.КаталогВыгрузкиПоПризнакуЛКНаСервере.Видимость = Отчет.РазбиватьОтчетыПоПризнакуЛК;
		Элементы.КаталогВыгрузкиПоПризнакуЛК.Видимость = Ложь;
	Иначе
		Элементы.КаталогВыгрузки.Видимость = Истина;
		Элементы.КаталогВыгрузкиНаСервере.Видимость = Ложь;
		Элементы.КаталогВыгрузкиНаСервереКопия.Видимость = Ложь;
		Элементы.КаталогВыгрузкиПоПризнакуЛК.Видимость = Отчет.РазбиватьОтчетыПоПризнакуЛК;
		Элементы.КаталогВыгрузкиПоПризнакуЛКНаСервере.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

