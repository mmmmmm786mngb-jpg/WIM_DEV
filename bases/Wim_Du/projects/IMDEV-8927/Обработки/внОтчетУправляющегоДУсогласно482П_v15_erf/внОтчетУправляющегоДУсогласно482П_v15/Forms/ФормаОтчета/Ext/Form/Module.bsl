&НаКлиенте
Функция СформироватьИмяФайла(Знач ДоговорДУ)

	РеквизитыДоговорДУ = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДоговорДУ, "Префикс, Код, Клиент");
	РеквизитыКлиента = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(РеквизитыДоговорДУ.Клиент, "ЮрФизЛицо, НаименованиеСокращенное, ВнешнийIDДляЛК");
	
	ИмяФайлаОтчета = "";
	
	Если РеквизитыКлиента.ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда
		ИмяФайлаОтчета =  "AM" + СтрЗаменить(РеквизитыКлиента.ВнешнийIDДляЛК, Символ(160), "") + "-" + "ДУ " + СокрЛП(РеквизитыДоговорДУ.Префикс) + " (" + СокрЛП(РеквизитыДоговорДУ.Код) + ") - Отчет ДУ " + Формат(ЭтаФорма.Отчет.ДатаОкончания,"ДФ=ddMMyyyy");
	Иначе
		ИмяФайлаОтчета =  "AM" + СтрЗаменить(РеквизитыКлиента.ВнешнийIDДляЛК, Символ(160), "") + "-" + СокрЛП(РеквизитыКлиента.НаименованиеСокращенное) + " (" + СокрЛП(РеквизитыДоговорДУ.Код) + ") - Отчет ДУ " + Формат(ЭтаФорма.Отчет.ДатаОкончания,"ДФ=ddMMyyyy");
	КонецЕсли;
	
	Возврат ИмяФайлаОтчета;

КонецФункции

&НаКлиенте
Процедура ОдиночнаяВыгрузка()
	
	Если ЭтаФорма.СформированныеОтчеты.Количество() = 0 Тогда
		Сообщить(НСтр("ru = 'Отчет не сформирован'"));
		Возврат;
	КонецЕсли; 
	
	МассивСформированныхОтчетов = ВыгрузитьНаСервере(ЭтаФорма.Отчет.ВыгружатьВФорматеExcel, ЭтаФорма.Отчет.ВыгружатьВФорматеPDF);
	МассивСформированныхОтчетов_xlsx = МассивСформированныхОтчетов.xlsx;
	МассивСформированныхОтчетов_pdf  = МассивСформированныхОтчетов.pdf;
	
	//ЭлементМассива = МассивСформированныхОтчетов_pdf[0]; //IMAPPS-21832 ошибка, если не выбрана галка PDF
	
	Если ЭтаФорма.Отчет.ВыгружатьВФорматеExcel Тогда
		СохранитьМногостраничныйФайл(ЭтаФорма.СформированныеОтчеты[0].Значение.ДоговорДУ);
	КонецЕсли; 
	
	Если ЭтаФорма.Отчет.ВыгружатьВФорматеPDF Тогда
		ЭлементМассива = МассивСформированныхОтчетов_pdf[0]; //IMAPPS-21832 перенес сюда
		ИмяФайлаОтчета = СформироватьИмяФайла(ЭлементМассива.ДоговорДУ);
		ИмяФайлаОтчета = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаОтчета);
		Попытка
			ЭлементМассива.ТабличныйДокумент.Записать(КаталогВыгрузки + ИмяФайлаОтчета + ".pdf", ТипФайлаТабличногоДокумента.PDF);
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура МассоваяВыгрузка()
	ЭтаФорма.ТаблицаЛога.Очистить();
	
	ДоговораДУ = ЭтаФорма.СписокДоговоровДУ.ВыгрузитьЗначения();
	
	// TM-3324 {
	Если ЭтаФорма.Отчет.РазбиватьОтчетыПоПризнакуЛК Тогда
		СвойстваДоговоровДУРазрешенаОтчетностьЧерезЛК = ПолучитьДополнительныеСвойстваНаСервере(ДоговораДУ);
	КонецЕсли;
	// TM-3324 } 
	
	Для каждого ТекущийДоговорДУ Из ДоговораДУ Цикл
		ОчиститьТабличныеДокументы();
		
		// TM-3324 {
		ТекущийКаталогВыгрузки = КаталогВыгрузки;
		
		Если ЭтаФорма.Отчет.РазбиватьОтчетыПоПризнакуЛК И ЗначениеЗаполнено(КаталогВыгрузкиПоПризнакуЛК) Тогда
			
			СвойствоДоговораДУРазрешенаОтчетностьЧерезЛК = СвойстваДоговоровДУРазрешенаОтчетностьЧерезЛК.Получить(ТекущийДоговорДУ);
			
			Если СвойствоДоговораДУРазрешенаОтчетностьЧерезЛК <> Неопределено И СвойствоДоговораДУРазрешенаОтчетностьЧерезЛК = Истина Тогда
				ТекущийКаталогВыгрузки = КаталогВыгрузкиПоПризнакуЛК;
			КонецЕсли;
			
		КонецЕсли;
		// TM-3324 }
		
		НоваяСтрокаЛога = ЭтаФорма.ТаблицаЛога.Добавить();
		НоваяСтрокаЛога.Портфель = Строка(ТекущийДоговорДУ);
		
		МассивСформированныхОтчетов = ЗаполнитьТабличныеДокументы(
			ТекущийДоговорДУ,
			Истина,
			ЭтаФорма.Отчет.ВыгружатьВФорматеExcel,
			ЭтаФорма.Отчет.ВыгружатьВФорматеPDF
		);
		
		Если (ЭтаФорма.Отчет.ВыгружатьВФорматеExcel И МассивСформированныхОтчетов.xlsx.Количество() = 0) 
			ИЛИ (ЭтаФорма.Отчет.ВыгружатьВФорматеPDF И МассивСформированныхОтчетов.pdf.Количество() = 0) Тогда
			
			НоваяСтрокаЛога.Статус = "Не выгружен";
			НоваяСтрокаЛога.Комментарий =  "Дата ввода средств в ДУ > Даты окончания периода";
			
			Продолжить;
		КонецЕсли; 
		
		Если ЭтаФорма.Отчет.ВыгружатьВФорматеExcel Тогда
			МассивСформированныхОтчетов_xlsx = МассивСформированныхОтчетов.xlsx;
			
			Для каждого ЭлементМассива Из МассивСформированныхОтчетов_xlsx Цикл
				ИмяФайлаОтчета = СформироватьИмяФайла(ЭлементМассива.ДоговорДУ);
				ИмяФайлаОтчета = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаОтчета);
				
				Попытка
					ЭлементМассива.ТабличныйДокумент.Записать(ТекущийКаталогВыгрузки + ИмяФайлаОтчета + ".xlsx", ТипФайлаТабличногоДокумента.XLSX); // TM-3324 {}
				Исключение
					НоваяСтрокаЛога.Статус = "Не выгружен";
					НоваяСтрокаЛога.Комментарий = ОписаниеОшибки();
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		Если ЭтаФорма.Отчет.ВыгружатьВФорматеPDF Тогда
			МассивСформированныхОтчетов_pdf  = МассивСформированныхОтчетов.pdf;
			
			Для каждого ЭлементМассива Из МассивСформированныхОтчетов_pdf Цикл
				ИмяФайлаОтчета = СформироватьИмяФайла(ЭлементМассива.ДоговорДУ);
				ИмяФайлаОтчета = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаОтчета);
				
				Попытка
					ЭлементМассива.ТабличныйДокумент.Записать(ТекущийКаталогВыгрузки + ИмяФайлаОтчета + ".pdf", ТипФайлаТабличногоДокумента.PDF); // TM-3324 {}
				Исключение
					НоваяСтрокаЛога.Статус = "Не выгружен";
					НоваяСтрокаЛога.Комментарий = ОписаниеОшибки();
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		НоваяСтрокаЛога.Статус = "Выгружен";
	КонецЦикла;
	
	ВывестиЛог();
КонецПроцедуры // МассоваяВыгрузка()

