		Элементы.ЗагружатьДанныеРСБУ.Доступность = Ложь;
		Отчет.ЗагружатьДанныеРСБУ = Ложь;
	ИначеЕсли   Отчет.ЗагружатьДанныеРСБУ = Истина Тогда 
		Элементы.ЗагружатьДанныеЕПС.Доступность = Ложь;
		Отчет.ЗагружатьДанныеЕПС = Ложь;
	Иначе 
		Элементы.ЗагружатьДанныеРСБУ.Доступность = Истина;
