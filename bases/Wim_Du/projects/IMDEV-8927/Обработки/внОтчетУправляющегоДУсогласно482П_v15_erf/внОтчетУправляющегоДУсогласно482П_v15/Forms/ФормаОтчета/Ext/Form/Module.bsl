&НаСервере
Функция ПолучитьСообщенияПользователюНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураПоиска = Новый Структура("Ключ", КлючОсновногоЗадания);
	МассивФоновыхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(СтруктураПоиска);
	НайденноеЗадание = МассивФоновыхЗаданий[0];
	ИдентификаторЗадания = НайденноеЗадание.УникальныйИдентификатор;
	
	ОсновноеФоновоеВыполнено = Ложь;
	
	Пока ОсновноеФоновоеВыполнено = Ложь Цикл
		Задание = ДлительныеОперации.ОперацияВыполнена(ИдентификаторЗадания);
		
		Если Задание.Статус = "Выполнено" Тогда
			ОсновноеФоновоеВыполнено = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВсеСообщения = ДлительныеОперации.СообщенияПользователю(Ложь, ИдентификаторЗадания);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ВсеСообщения;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьТекстСообщения(ТекстСообщения, ДобавляемыйТекст)
	
	ТекстСообщения = ?(ЗначениеЗаполнено(ТекстСообщения), ТекстСообщения + Символы.ПС + ДобавляемыйТекст, ДобавляемыйТекст);
	
КонецПроцедуры

