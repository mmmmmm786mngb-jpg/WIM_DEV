&НаКлиенте
Процедура Сформировать(Команда) Экспорт //Тест
	
	СообщениеПользователю = Новый СообщениеПользователю;
	
	Если ЭтаФорма.Отчет.ДатаНачала <'20171001' или ЭтаФорма.Отчет.ДатаОкончания <'20171001' Тогда
		ТекстСообщения = НСтр("ru = 'Данная версия отчёта не работает на этом периоде, пользуйтесь старой версией.'");
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Поле = "Отчет.ДатаНачала";
		СообщениеПользователю.Сообщить();
		
		Возврат;
	КонецЕсли; 


	Если ЭтаФорма.Отчет.ДатаНачала > ЭтаФорма.Отчет.ДатаОкончания Тогда
		
		ТекстСообщения = НСтр("ru = 'Дата начала не может быть позже даты окончания отчета.'");
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Поле = "Отчет.ДатаНачала";
		СообщениеПользователю.Сообщить();
		
		Возврат;
	КонецЕсли;	
	
	
	Если Отчет.РежимРаботы <> 0 Тогда
		
		Если ЭтаФорма.СписокДоговоровДУ.Количество() = 0 Тогда
		
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит Договора ДУ'");
			СообщениеПользователю.Текст = ТекстСообщения;
			СообщениеПользователю.Поле = "СписокДоговоровДУ";
			СообщениеПользователю.Сообщить();
			Возврат;			
		
		КонецЕсли; 

	Иначе
		
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.ДоговорДУ) Тогда
		
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит Договор ДУ'");
			СообщениеПользователю.Поле = "Отчет.ДоговорДУ";
			СообщениеПользователю.Текст = ТекстСообщения;
			СообщениеПользователю.Сообщить();
			Возврат;	
		
		КонецЕсли; 

	КонецЕсли; 
	
	//IMAPPS-21832++
	//Сообщим пользователю, если вдруг Дата формирования указана слишком далеко от периода
	Если ЗначениеЗаполнено(Отчет.ДатаФормированияРучная) 
		и (Отчет.ДатаФормированияРучная > ДобавитьМесяц(Отчет.ДатаОкончания, 3)
		или Отчет.ДатаФормированияРучная < ДобавитьМесяц(Отчет.ДатаНачала, -3)) Тогда
		ПоказатьПредупреждение(,"Проверьте Дату Формирования, возможно она указана некорректно");
	КонецЕсли;
	//IMAPPS-21832--
	
	Если ЭтаФорма.ПроверитьЗаполнение() Тогда
	
		СформироватьНаСервере();
	
		УстановитьСостояниеТабличныхДокументов(Ложь);	
	
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
