&НаСервере
Процедура ЗарегистрироватьСостояниеВыгрузкиОтчетовДУНаСервере()
	
	ТабличныйДокументЛог.Очистить();
	
	ЗаполнитьСписокДоговоровКлиентамиРозничногоДУ(СписокДоговоровДУ, Отчет.ИсключатьСЗаполненойДатойОкончания);
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.ЗарегистрироватьСостояниеВыгрузкиОтчетовДУ(СписокДоговоровДУ.ВыгрузитьЗначения(), "ЗаПериод");
	
КонецПроцедуры

&НаСервере
Процедура МассоваяВыгрузкаПоКлиентамРозничногоДУНаСервере(МассивУникальныхИдентификаторов)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	//Подключаемся к базе под svc учеткой
	СтруктураПодключения = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединение(ПараметрыCom);
	
	Если СтруктураПодключения.Соединение = Неопределено Тогда
		Сообщить(СтруктураПодключения.ПодробноеОписаниеОшибки);
	Иначе
		ВнешнееСоединение = СтруктураПодключения.Соединение;
		
		//ссылка на доп. обработку, подключенную к базе. В данном примере ищем по наименованию, указанному в Сведениях о внешней обработке
		ДополнительнаяОбработкаСсылка = ВнешнееСоединение.Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(ОтчетОбъект.СведенияОВнешнейОбработке().Наименование, Истина);
		
		ПараметрыОтчета = ВнешнееСоединение.NewObject("Структура");
		ПараметрыОтчета.Вставить("ДатаНачала", ОтчетОбъект.ДатаНачала);
		ПараметрыОтчета.Вставить("ДатаОкончания", ОтчетОбъект.ДатаОкончания);
		ПараметрыОтчета.Вставить("ОтоброжатьФИО", ОтчетОбъект.ОтоброжатьФИО);
		ПараметрыОтчета.Вставить("НеФормироватьПечать", ОтчетОбъект.НеФормироватьПечать);
		ПараметрыОтчета.Вставить("ЗагружатьДанныеЕПС", ОтчетОбъект.ЗагружатьДанныеЕПС);
		//ПараметрыОтчета.Вставить("ВнешняяИБ", Справочники.ВнешниеИнформационныеБазы.НайтиПоНаименованию(ОтчетОбъект.ВнешняяИБ.Наименование, Истина));
		ПараметрыОтчета.Вставить("НаименованиеУК", ОтчетОбъект.НаименованиеУК);
		ПараметрыОтчета.Вставить("ФлагНовоеНаименованиеУК", ОтчетОбъект.ФлагНовоеНаименованиеУК);
		ПараметрыОтчета.Вставить("ДатаФормированияРучная", ОтчетОбъект.ДатаФормированияРучная);
		//ПараметрыОтчета.Вставить("Подписант", Справочники.КонтактныеЛица.НайтиПоНаименованию(ОтчетОбъект.Подписант.Наименование, Истина));
		ПараметрыОтчета.Вставить("ПоставкаПротивПлатежа", ОтчетОбъект.ПоставкаПротивПлатежа);
		ПараметрыОтчета.Вставить("СкрыватьБалансовуюСтоимость", ОтчетОбъект.СкрыватьБалансовуюСтоимость);
		ПараметрыОтчета.Вставить("КаталогВыгрузкиНаСервере", ОтчетОбъект.КаталогВыгрузкиНаСервере);
		ПараметрыОтчета.Вставить("КаталогВыгрузкиНаСервереКопия", ОтчетОбъект.КаталогВыгрузкиНаСервереКопия);
		ПараметрыОтчета.Вставить("ВыгружатьВФорматеExcel", ОтчетОбъект.ВыгружатьВФорматеExcel);
		ПараметрыОтчета.Вставить("ВыгружатьВФорматеPDF", ОтчетОбъект.ВыгружатьВФорматеPDF);
		ПараметрыОтчета.Вставить("РазбиватьОтчетыПоПризнакуЛК", ОтчетОбъект.РазбиватьОтчетыПоПризнакуЛК);
		ПараметрыОтчета.Вставить("КаталогВыгрузкиПоПризнакуЛКНаСервере", ОтчетОбъект.КаталогВыгрузкиПоПризнакуЛКНаСервере);
		ПараметрыОтчета.Вставить("КоличествоПотоков", ОтчетОбъект.КоличествоПотоков);
		
		МассивСтрокУникальныхИдентификаторов = ВнешнееСоединение.NewObject("Массив");
		
		Для каждого ТекИдентификатор Из МассивУникальныхИдентификаторов Цикл
			МассивСтрокУникальныхИдентификаторов.Добавить(Строка(ТекИдентификатор));
		КонецЦикла;
		
		НовыйУникальныйИдентификатор = ВнешнееСоединение.NewObject("УникальныйИдентификатор");
		
		КлючОсновногоЗадания = Новый УникальныйИдентификатор(ВнешнееСоединение.String(НовыйУникальныйИдентификатор));
		
		НаименованиеЗадания = НСтр("ru = 'Инициализация запуска Выгрузки отчетов по клиентам розничного ДУ'");;
		
		//запуск фоновой процедуры происходит через метод "ВыполнитьПроцедуруМодуляОбъектаОбработки", куда мы передаем данные об обработке и о процедуре, которую необходимо запустить
		ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки";
		
		ПараметрыЗадания = ВнешнееСоединение.NewObject("Структура");
		//имя внешней обработки
		ПараметрыЗадания.Вставить("ИмяОбработки", "ВнешнийОтчет.внОтчетУправляющегоДУсогласно482П_v15");
		//имя экспортной серверной процедуры обработки
		ПараметрыЗадания.Вставить("ИмяМетода", "МассоваяВыгрузкаПоКлиентамРозничногоДУВФоне");
		//входящие параметры процедуры
		СтруктураПараметров = ВнешнееСоединение.NewObject("Структура");
		СтруктураПараметров.Вставить("МассивСтрокУникальныхИдентификаторов", МассивСтрокУникальныхИдентификаторов);
		СтруктураПараметров.Вставить("ПараметрыОтчета", ПараметрыОтчета);
		
		ПараметрыЗадания.Вставить("ПараметрыВыполнения", СтруктураПараметров);
		//признак внешней обработки
		ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
		//ссылка на доп. обработку в базе
		ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
		
		//получаем пустую структуру параметров выполнения фонового задания и заполняем ее необходимыми данными
		ПараметрыВыполнения = ВнешнееСоединение.ДлительныеОперации.ПараметрыВыполненияВФоне(НовыйУникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		ПараметрыВыполнения.ОжидатьЗавершение = 0;
		ПараметрыВыполнения.ИдентификаторФормы = НовыйУникальныйИдентификатор;
		ПараметрыВыполнения.КлючФоновогоЗадания = НовыйУникальныйИдентификатор;
		
		//запускаем выполнение фонового задания
		Попытка
			ВнешнееСоединение.ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения);
		Исключение
			Инфо = ИнформацияОбОшибке();
			Сообщить(Инфо);
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоНеВыгруженныеОтчетыДУНаСервере()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Возврат ОтчетОбъект.ПолучитьНеВыгруженныеОтчетыДУ().Количество();
	
