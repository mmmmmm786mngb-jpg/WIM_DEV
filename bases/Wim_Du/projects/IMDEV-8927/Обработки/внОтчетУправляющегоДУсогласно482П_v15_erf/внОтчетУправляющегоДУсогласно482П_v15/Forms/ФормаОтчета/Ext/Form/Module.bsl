КонецПроцедуры

&НаКлиенте
Процедура ВыборКаталога(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборКаталогаЗавершение", ЭтотОбъект);
	
	РежимДиалога = РежимДиалогаВыбораФайла.ВыборКаталога;
	
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалога);
	ДиалогВыбораКаталога.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
	Сообщить("Отчет запущен: " + ТекущаяДата());
	
	НеЗаполненыРеквизиты = Ложь;
	
	Если НЕ ЗначениеЗаполнено(КаталогВыгрузки) И Отчет.РежимРаботы <> 2 Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит Каталог выгрузки'");
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Поле = "КаталогВыгрузки";
		СообщениеПользователю.Сообщить();
		НеЗаполненыРеквизиты = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.КаталогВыгрузкиНаСервере) И Отчет.РежимРаботы = 2 Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит Каталог выгрузки на сервере'");
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Поле = "КаталогВыгрузкиНаСервере";
		СообщениеПользователю.Сообщить();
		НеЗаполненыРеквизиты = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.КаталогВыгрузкиНаСервереКопия) И Отчет.РежимРаботы = 2 Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит Каталог выгрузки на сервере (копия)'");
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Поле = "КаталогВыгрузкиНаСервереКопия";
		СообщениеПользователю.Сообщить();
		НеЗаполненыРеквизиты = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыCom) И Отчет.РежимРаботы = 2 Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит Параметры com текущей базы'");
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Поле = "ПараметрыCom";
		СообщениеПользователю.Сообщить();
		НеЗаполненыРеквизиты = Истина;
	КонецЕсли;
	
	Если НеЗаполненыРеквизиты = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Отчет.РежимРаботы = 2 Тогда
		МассоваяВыгрузкаПоКлиентамРозничногоДУ();
	ИначеЕсли Отчет.РежимРаботы = 1 Тогда
		МассоваяВыгрузка();
		Сообщить("Отчет завершен: " + ТекущаяДата());
	ИначеЕсли Отчет.РежимРаботы = 0 Тогда
		ОдиночнаяВыгрузка();
		Сообщить("Отчет завершен: " + ТекущаяДата());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ДополнительнаяОбработкаСсылка", ДопОбработка);
	ОткрытьФорму("ВнешнийОтчет.внОтчетУправляющегоДУсогласно482П_v15.Форма.ФормаНастроек", ДопПараметры, ЭтаФорма);
КонецПроцедуры

