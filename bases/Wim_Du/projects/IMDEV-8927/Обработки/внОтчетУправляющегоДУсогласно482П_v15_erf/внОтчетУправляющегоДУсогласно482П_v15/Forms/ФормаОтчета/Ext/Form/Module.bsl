#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()
	
	// TM-3252 {
	ОчиститьТабличныеДокументы(); 
	
	ЗаполнитьТабличныеДокументы(
		ЭтаФорма.ДоговорДУ,
		Ложь,
		ЭтаФорма.Отчет.ВыгружатьВФорматеExcel,
		ЭтаФорма.Отчет.ВыгружатьВФорматеPDF
	);
	// TM-3252 }

КонецПроцедуры

&НаСервере
Процедура ОчиститьТабличныеДокументы()
	
	ЭтаФорма.ТабличныйДокументРаздел1.Очистить();
	ЭтаФорма.ТабличныйДокументРаздел2.Очистить();
	ЭтаФорма.ТабличныйДокументРаздел3.Очистить();
	ЭтаФорма.ТабличныйДокументРаздел4.Очистить();
	ЭтаФорма.ТабличныйДокументРаздел5.Очистить();
	ЭтаФорма.ТабличныйДокументРаздел6_1.Очистить();
	ЭтаФорма.ТабличныйДокументРаздел6_2.Очистить();
	ЭтаФорма.ТабличныйДокументРаздел7.Очистить();
	
	ЭтаФорма.СформированныеОтчеты.Очистить();
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьТабличныеДокументы(Знач ТекущийДоговорДУ, Знач ВернутьМассив, Знач КакXLS, Знач КакPDF)
	Перем ОтчетОбъект, ТабличныеДокументы, МассивОтчетов;
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ТабличныеДокументы = ОтчетОбъект.ЗаполнитьДанныеОтчета(ТекущийДоговорДУ);
	
	Если ТабличныеДокументы  = Неопределено Тогда   // для договора ДУ дата ввода средств ДУ>Даты окончания отчета, не формируем очтет.
		МассивСформированныхОтчетов_xlsx = Новый Массив;
		МассивСформированныхОтчетов_pdf = Новый Массив;
		
		Результат = Новый Структура;
		Результат.Вставить("xlsx", МассивСформированныхОтчетов_xlsx);
		Результат.Вставить("pdf" , МассивСформированныхОтчетов_pdf);
		
		Возврат Результат;
	КонецЕсли;
	
	ЭтаФорма.СформированныеОтчеты.Добавить(Новый Структура("ДоговорДУ, ТабличныеДокументы", ТекущийДоговорДУ, ТабличныеДокументы));
	
	Если Отчет.РежимРаботы = 0 Тогда
		ЭтаФорма.ТабличныйДокументРаздел1.Вывести(ТабличныеДокументы.Раздел1);
		ЭтаФорма.ТабличныйДокументРаздел1.ВывестиГоризонтальныйРазделительСтраниц();
		
		ЭтаФорма.ТабличныйДокументРаздел2.Вывести(ТабличныеДокументы.Раздел2);
		ЭтаФорма.ТабличныйДокументРаздел2.ВывестиГоризонтальныйРазделительСтраниц();
		
		ЭтаФорма.ТабличныйДокументРаздел3.Вывести(ТабличныеДокументы.Раздел3);
		ЭтаФорма.ТабличныйДокументРаздел3.ВывестиГоризонтальныйРазделительСтраниц();
		
		ЭтаФорма.ТабличныйДокументРаздел4.Вывести(ТабличныеДокументы.Раздел4);
		ЭтаФорма.ТабличныйДокументРаздел4.ВывестиГоризонтальныйРазделительСтраниц();
		
		ЭтаФорма.ТабличныйДокументРаздел5.Вывести(ТабличныеДокументы.Раздел5);
		ЭтаФорма.ТабличныйДокументРаздел5.ВывестиГоризонтальныйРазделительСтраниц();
		
		ЭтаФорма.ТабличныйДокументРаздел6_1.Вывести(ТабличныеДокументы.Раздел6_1);
		ЭтаФорма.ТабличныйДокументРаздел6_1.ВывестиГоризонтальныйРазделительСтраниц();
		
		ЭтаФорма.ТабличныйДокументРаздел6_2.Вывести(ТабличныеДокументы.Раздел6_2);
		ЭтаФорма.ТабличныйДокументРаздел6_2.ВывестиГоризонтальныйРазделительСтраниц();
		
		ЭтаФорма.ТабличныйДокументРаздел7.Вывести(ТабличныеДокументы.Раздел7);
		ЭтаФорма.ТабличныйДокументРаздел7.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	Если ВернутьМассив Тогда
		МассивОтчетов = ВыгрузитьНаСервере(КакXLS, КакPDF);
		
		ОчиститьТабличныеДокументы();
		
		Возврат МассивОтчетов;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции // ЗаполнитьТабличныеДокументы()

&НаСервере
Процедура СформироватьМассивОтчетов(МассивСформированныхОтчетов, ВидМассива)
	
	Для каждого СтрокаСписка Из ЭтаФорма.СформированныеОтчеты Цикл	
		
		ТабличныеДокументы = СтрокаСписка.Значение.ТабличныеДокументы;
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.АвтоМасштаб = Истина;
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		
		ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"1"]);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"2"]);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"3"]);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"4"]);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"5"]);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"6_1"]);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"6_2"]);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.Вывести(ТабличныеДокументы["Раздел" + ВидМассива +"7"]);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТабличныйДокумент.АвтоМасштаб = Истина;
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		
		////TM-3137
		Если ВидМассива <> "pdf" Тогда
			ТабличныйДокумент.ПолеСверху = 20;
		КонецЕсли;
		ТабличныйДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 2;
		ТабличныйДокумент.ВерхнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
		
		//VTBC SadykovNiyaz 01.04.2022 (IMAPPS-16952) {
		Если Отчет.ФлагНовоеНаименованиеУК Тогда
			ТабличныйДокумент.ВерхнийКолонтитул.ТекстСлева 	= Отчет.НаименованиеУК;
		Иначе
			ТабличныйДокумент.ВерхнийКолонтитул.ТекстСлева = СтрокаСписка.Значение.ДоговорДУ.УправляющаяКомпания.Наименование;  
		КонецЕсли;
		//VTBC SadykovNiyaz 01.04.2022 (IMAPPS-16952) }

		ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = "Отчет о деятельности Управляющего за период с " + Формат(ЭтаФорма.Отчет.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ЭтаФорма.Отчет.ДатаОкончания, "ДФ=dd.MM.yyyy") + Символы.ПС
		+ "Договор № " + СтрокаСписка.Значение.ДоговорДУ.Код + " от " + Формат(СтрокаСписка.Значение.ДоговорДУ.ДатаНачала, "ДФ=dd.MM.yyyy"); 
		ТабличныйДокумент.ВерхнийКолонтитул.ТекстСправа= "Стр. [&НомерСтраницы] (Всего [&СтраницВсего] стр.)";
		ТабличныйДокумент.ВерхнийКолонтитул.Выводить = Истина;
		////TM-3137
		
		СформированныйОтчет = Новый Структура("ДоговорДУ, ТабличныйДокумент");
		СформированныйОтчет.ДоговорДУ = СтрокаСписка.Значение.ДоговорДУ;
		СформированныйОтчет.ТабличныйДокумент = ТабличныйДокумент;
		
		МассивСформированныхОтчетов.Добавить(СформированныйОтчет);
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере(Знач КакXLS, Знач КакPDF)
	
	МассивСформированныхОтчетов_xlsx = Новый Массив;
	МассивСформированныхОтчетов_pdf = Новый Массив;
	
	Результат = Новый Структура;
	Результат.Вставить("xlsx", МассивСформированныхОтчетов_xlsx);
	Результат.Вставить("pdf" , МассивСформированныхОтчетов_pdf);
	
	Если КакXLS Тогда
		СформироватьМассивОтчетов(МассивСформированныхОтчетов_xlsx, "");
	КонецЕсли;
	
	Если КакPDF Тогда
		СформироватьМассивОтчетов(МассивСформированныхОтчетов_pdf, "pdf");
	КонецЕсли;
	
	Результат.Вставить("xlsx", МассивСформированныхОтчетов_xlsx);
	Результат.Вставить("pdf" , МассивСформированныхОтчетов_pdf);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СохранитьМногостраничныйФайл(Знач ДоговорДУ)
	
	ТипФайла = ТипФайлаТабличногоДокумента.XLSX;
	
	ФайлРаздел2 = ПолучитьИмяВременногоФайла();
	ЭтаФорма.ТабличныйДокументРаздел2.Записать(ФайлРаздел2, ТипФайла);
	
	ФайлРаздел3 = ПолучитьИмяВременногоФайла();
	ЭтаФорма.ТабличныйДокументРаздел3.Записать(ФайлРаздел3, ТипФайла);
	
	ФайлРаздел4 = ПолучитьИмяВременногоФайла();
	ЭтаФорма.ТабличныйДокументРаздел4.Записать(ФайлРаздел4, ТипФайла);
	
	ФайлРаздел5 = ПолучитьИмяВременногоФайла();
	ЭтаФорма.ТабличныйДокументРаздел5.Записать(ФайлРаздел5, ТипФайла);
	
	ФайлРаздел6_1 = ПолучитьИмяВременногоФайла();
	ЭтаФорма.ТабличныйДокументРаздел6_1.Записать(ФайлРаздел6_1, ТипФайла);
	
	ФайлРаздел6_2 = ПолучитьИмяВременногоФайла();
	ЭтаФорма.ТабличныйДокументРаздел6_2.Записать(ФайлРаздел6_2, ТипФайла);
	
	ФайлРаздел7 = ПолучитьИмяВременногоФайла();
	ЭтаФорма.ТабличныйДокументРаздел7.Записать(ФайлРаздел7, ТипФайла);
	
	МассивФайлов = Новый Массив;
	МассивФайлов.Добавить(ФайлРаздел2);
	МассивФайлов.Добавить(ФайлРаздел3);
	МассивФайлов.Добавить(ФайлРаздел4);
	МассивФайлов.Добавить(ФайлРаздел5);
	МассивФайлов.Добавить(ФайлРаздел6_1);
	МассивФайлов.Добавить(ФайлРаздел6_2);
	МассивФайлов.Добавить(ФайлРаздел7);

	ИмяФайлаОтчета = СформироватьИмяФайла(ДоговорДУ);
	
	ИмяФайлаОтчета = ИмяФайлаОтчета + ".xlsx";
	ИмяФайлаОтчета = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаОтчета);
	
	ПолныйПуть = КаталогВыгрузки + ИмяФайлаОтчета;
	
	Попытка
	
		ЭтаФорма.ТабличныйДокументРаздел1.Записать(ПолныйПуть, ТипФайла);
	    
	Исключение
		
		Сообщить(ОписаниеОшибки());
		
		Для каждого Файл Из МассивФайлов Цикл
		
			УдалитьФайлы(Файл);
		
		КонецЦикла; 
		
		Возврат;
		
	КонецПопытки;
	
	
	Попытка
	
		Excel = Новый COMОбъект("Excel.Application");
		ОбщаяКнига = Excel.WorkBooks.Open(ПолныйПуть);
	
	Исключение
		
		Сообщить(ОписаниеОшибки());
		Excel.Quit();
		Excel = Неопределено;
	              
		Для каждого Файл Из МассивФайлов Цикл
		
			УдалитьФайлы(Файл);
		
		КонецЦикла; 
		
		Возврат;
	
	КонецПопытки; 

	НомерЛиста = 1;
	
	Для каждого Файл Из МассивФайлов Цикл
		
		Книга = Excel.WorkBooks.Open(Файл);
		
		ЛистСДанными = Книга.Sheets(1);
		ЛистСДанными.Select();
		ЛистСДанными.Copy(null, ОбщаяКнига.Sheets(НомерЛиста));
		Книга.Close();
		
		НомерЛиста = НомерЛиста + 1;
		
	КонецЦикла; 
	
	ОбщаяКнига.Sheets(1).Name = "РСА";
	ОбщаяКнига.Sheets(2).Name = "Портфель";
	ОбщаяКнига.Sheets(3).Name = "Сделки";
	ОбщаяКнига.Sheets(4).Name = "Движение ДС";
	ОбщаяКнига.Sheets(5).Name = "Движение ЦБ";
	ОбщаяКнига.Sheets(6).Name = "Расходы ДУ";
	ОбщаяКнига.Sheets(7).Name = "Незавершенные сделки";
	ОбщаяКнига.Sheets(8).Name = "Голосование";
		
	РеквизитыДоговорДУ = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(ДоговорДУ, "УправляющаяКомпания, Код, ДатаНачала"); //TM-3137
	
	РеквизитыУправляющейКомпании = ОбщегоНазначения.ПолучитьЗначенияРеквизитов(РеквизитыДоговорДУ.УправляющаяКомпания, "Наименование"); //TM-3137
		
	Для НомерЛиста = 1 По 8 Цикл
		
		//TM-3137
		ОбщаяКнига.Sheets(НомерЛиста).PageSetup.DifferentFirstPageHeaderFooter = True;
	    ОбщаяКнига.Sheets(НомерЛиста).PageSetup.LeftHeader   = РеквизитыУправляющейКомпании.Наименование;
		ОбщаяКнига.Sheets(НомерЛиста).PageSetup.CenterHeader = "Отчет о деятельности Управляющего за период с " + Формат(ЭтаФорма.Отчет.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ЭтаФорма.Отчет.ДатаОкончания, "ДФ=dd.MM.yyyy") + Символы.ПС
		                                                       + "Договор № " + РеквизитыДоговорДУ.Код + " от " + Формат(РеквизитыДоговорДУ.ДатаНачала, "ДФ=dd.MM.yyyy");
		ОбщаяКнига.Sheets(НомерЛиста).PageSetup.RightHeader  = "Стр. &С&P (Всего &К&N стр.)";
		//TM-3137
	
		ОбщаяКнига.Sheets(НомерЛиста).PageSetup.FitToPagesWide = 1;
		ОбщаяКнига.Sheets(НомерЛиста).PageSetup.FitToPagesTall = 99;
		ОбщаяКнига.Sheets(НомерЛиста).PageSetup.Orientation = 2;
		ОбщаяКнига.Sheets(НомерЛиста).PageSetup.Zoom = Ложь;
	
	КонецЦикла; 
	
	
    Excel.ActiveWindow.DisplayWorkbookTabs = -1;
    Excel.ActiveWindow.TabRatio = 0.25;
	
	//vtb 12.07.2016
	ОбщаяКнига.Sheets(1).Select();
	
	
	Попытка
	
		ОбщаяКнига.Save();
		Сообщить(НСтр("ru = 'Файл успешно сохранен.'"));
	
	Исключение
		
		Сообщить(ОписаниеОшибки());
	
	КонецПопытки;
	
	ОбщаяКнига.Close();
	Excel.Quit();
	Excel = Неопределено;
              
	Для каждого Файл Из МассивФайлов Цикл
		
		УдалитьФайлы(Файл);
		
	КонецЦикла; 

КонецПроцедуры

&НаКлиенте
Процедура ВыборПериодаЗавершение(Период, ДополнительныеПараметры) Экспорт
	
	Если Период <> Неопределено Тогда
	
		ЭтаФорма.Отчет.ДатаНачала = Период.ДатаНачала;
		ЭтаФорма.Отчет.ДатаОкончания = Период.ДатаОкончания;
		
		УстановитьСостояниеТабличныхДокументов(Истина, "НеАктуально");
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКаталогаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		
		ЕстьСлэш = Прав(ВыбранныеФайлы[0], 1) = "\";
		
		КаталогВыгрузки = ВыбранныеФайлы[0] + ?(ЕстьСлэш, "", "\");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКаталогаПоПризнакуЛКЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		
		ЕстьСлэш = Прав(ВыбранныеФайлы[0], 1) = "\";
		
		КаталогВыгрузкиПоПризнакуЛК = ВыбранныеФайлы[0] + ?(ЕстьСлэш, "", "\");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеТабличныхДокументов(Видимость, Режим = "НеСформирован")
	
	Если Режим = "НеСформирован" Тогда
		
		Текст = НСтр("ru = 'Отчет не сформирован. Нажмите кнопку ""Сформировать"" для получения отчета.'");
		
	ИначеЕсли Режим = "НеАктуально" Тогда
		
		Текст = НСтр("ru = 'Данные отчета не актуальны. Нажмите кнопку ""Сформировать"" для получения отчета.'");
	
	Иначе
		
		Видимость = Ложь;
		Текст = "";
	
	КонецЕсли; 

	Для Каждого ТабличныйДокумент Из ЭтаФорма.СписокЭлементовТабличныхДокументов Цикл
			
		ЭтаФорма.Элементы[ТабличныйДокумент.Значение].ОтображениеСостояния.Видимость = Видимость;
		ЭтаФорма.Элементы[ТабличныйДокумент.Значение].ОтображениеСостояния.Картинка = БиблиотекаКартинок.Информация32;
		ЭтаФорма.Элементы[ТабличныйДокумент.Значение].ОтображениеСостояния.Текст = Текст;
		
		Если Режим = "НеАктуально" Тогда
			ЭтаФорма.Элементы[ТабличныйДокумент.Значение].ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
		Иначе
			ЭтаФорма.Элементы[ТабличныйДокумент.Значение].ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;
		КонецЕсли;
		
	КонецЦикла;
	
	//IMAPPS-30982++
	Если ЭтотОбъект.ДоговорДУ.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ФизическиеЛица Тогда
		Отчет.СкрыватьБалансовуюСтоимость = Истина
	Иначе
		 Отчет.СкрыватьБалансовуюСтоимость = Ложь
	КонецЕсли;
    //IMAPPS-30982--


КонецПроцедуры

