&НаКлиенте
Процедура ВыпискиКВыгрузкеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Возврат; // ДП 20151117 Заблокировал, чтоб не пользовались старым функционалом
	
	Если Поле.Имя <> "ВыпискиКВыгрузкеВыгружать" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СтруктураПараметров = Новый Структура;
		
		ТекДанные = Элементы.ВыпискиКВыгрузке.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			СтруктураПараметров.Вставить("НачалоПериода", ТекДанные.ДатаВыписки);
			СтруктураПараметров.Вставить("КонецПериода", ТекДанные.ДатаВыписки);
			СтруктураПараметров.Вставить("ДоговорДУ", ТекДанные.ДоговорДУ);
			СтруктураПараметров.Вставить("БанковскийСчет", ТекДанные.БанковскийСчет);
			СтруктураПараметров.Вставить("Банк", ТекДанные.Банк);
			СтруктураПараметров.Вставить("ГруппировкаДокументовПоБанку", ГруппировкаДокументовПоБанку);
		КонецЕсли;
		
		СтруктураПараметров.Вставить("КлиентБанкРежимПоУмолчанию", "  Выгрузка  ");
		
		ОткрытьФорму("Обработка.КлиентБанк.Форма", СтруктураПараметров);
		
		//Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыКВыгрузкеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	//	Если Поле.Имя = "ДокументыКВыгрузкеДокумент" Тогда
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элемент.ТекущаяСтрока;
	Строка = Объект.ДокументыКВыгрузке.НайтиПоИдентификатору(ТекущаяСтрока);
	
