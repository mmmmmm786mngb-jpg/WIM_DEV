// ДП 20151117 Взял из обработки КлиентБанк более новую версию (с группировкой по банку)
Функция ЗагрузитьНастройкиПрограммыКлиентаБанка(ДоговорДУ,БанковскийСчет, ГруппировкаДокументовПоБанку = Ложь);
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НастройкиОбменаСКлиентомБанка.Программа,
	|	НастройкиОбменаСКлиентомБанка.Кодировка,
	|	НастройкиОбменаСКлиентомБанка.ФайлЗагрузки,
	|	НастройкиОбменаСКлиентомБанка.ФайлВыгрузки,
	|	НастройкиОбменаСКлиентомБанка.ВидыВыгружаемыхПлатДокументов
	|ИЗ
	|	РегистрСведений.НастройкиОбменаСКлиентомБанка КАК НастройкиОбменаСКлиентомБанка
	|Где
	|	НастройкиОбменаСКлиентомБанка.БанковскийСчет = &Счет
	|	И НастройкиОбменаСКлиентомБанка.ДоговорДУ = &ДоговорДУ
	|";
	
	Запрос.УстановитьПараметр("Счет",БанковскийСчет);
	Если ГруппировкаДокументовПоБанку Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И НастройкиОбменаСКлиентомБанка.ДоговорДУ = &ДоговорДУ","");
	Иначе	
		Запрос.УстановитьПараметр("ДоговорДУ",ДоговорДУ);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество()<>0 Тогда                     
		Настройки = Новый Структура("Кодировка,Программа,ФайлВыгрузки,ФайлЗагрузки",
		Выборка[0].Кодировка,Выборка[0].Программа,Выборка[0].ФайлВыгрузки,Выборка[0].ФайлЗагрузки);
		
		ВидыВыгружаемыхПлатДокументов = Выборка[0].ВидыВыгружаемыхПлатДокументов.Получить();
		Если ВидыВыгружаемыхПлатДокументов<>Неопределено Тогда
			Для Каждого Вид Из ВидыВыгружаемыхПлатДокументов Цикл
				Настройки.Вставить(СтрЗаменить(Вид.Документ," ","_"),Вид.Пометка);
			КонецЦикла;
		КонецЕсли;
		Возврат Настройки;
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции


&НаСервере
Процедура УстановитьВидимость()
	
	Элементы.Банк.Видимость = ГруппировкаДокументовПоБанку;
