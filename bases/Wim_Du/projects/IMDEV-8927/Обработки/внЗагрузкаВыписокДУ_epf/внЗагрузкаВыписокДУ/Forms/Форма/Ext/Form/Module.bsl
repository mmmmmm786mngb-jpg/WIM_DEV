		+ "<td>" + ТекДокумент.Документ + "</td>"
		+ "<td align=""right"">" + Формат(ТекДокумент.СуммаДокумента,"ЧДЦ=2") + "</td>"
		+ "<td align=""right"">" + Формат(ТекДокумент.СЧА,"ЧДЦ=2") + "</td>"
		+ "<td align=""right"">" + Формат(ТекДокумент.Порог,"ЧДЦ=2") + "</td>"
		+ "</tr> "+Символы.ПС;
	КонецЦикла;		
	
	Если Таб <> "" Тогда
		ТелоПисьма = "<html> <head> <meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" /> </head>"+
		"<body style=""font-family:Arial, Helvetica, sans-serif;color:black;"">"+
		"<b>"+Тема+"</b><br/><br/>"+
		"<table  BORDERCOLOR=""Black"" border-style= ""solid"" border-collapse =""collapse"" border=""1""><tr>"+
		"<th align=""center"" bgcolor=""#C0C0C0"">Договор ДУ</th>"+
		"<th align=""center"" bgcolor=""#C0C0C0"">Вывод ДС</th>"+
		"<th align=""center"" bgcolor=""#C0C0C0"">Стоимость выводимых активов</th>"+
		"<th align=""center"" bgcolor=""#C0C0C0"">СЧА</th>"+
		"<th align=""center"" bgcolor=""#C0C0C0"">Процент</th></tr>"+
		Таб+
		"</table>"+
		"</body></html>";
	КонецЕсли;
	
	Если НЕ Объект.ПочтовыйЛогин.Пустая() тогда
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста");
		ПараметрыПисьма.Тема = Тема;
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из Объект.СписокРассылки Цикл
			Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
		
		ПараметрыПисьма.Кому = кому;
		ПараметрыПисьма.ТипТекста = "HTML";
		
		ПараметрыПисьма.Тело =  ТелоПисьма;
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьСообщение(Объект.ПочтовыйЛогин, ПараметрыПисьма);
			текстРассылки = "Рассылка завершена";
		Исключение
			текстРассылки = "Рассылка не удалась: "+Объект.ПочтовыйЛогин; 
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Для Каждого Элемент из Сообщения Цикл
				текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
			Конеццикла;
		КонецПопытки;
		
	КонецЕсли;
	
	//Задача.Описание = Задача.Описание + Символы.ПС + текстРассылки + Символы.ПС+ТелоПисьма;
	//Задача.ВыполнитьЗадачу();
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПрочитатьНастройкиНаСервере();		
КонецПроцедуры

&НаСервере
Процедура ПрочитатьНастройкиНаСервере()
	
	Если Объект.ДополнительнаяОбработкаСсылка.Пустая() Тогда
		//Сообщить("Обработка не определена!");
		Объект.ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Загрузка выписок", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДополнительнаяОбработкаСсылка) Тогда
		ПараметрыОбработки = Справочники.ДополнительныеОтчетыИОбработки.НастройкиОбработки(Объект.ДополнительнаяОбработкаСсылка);
	КонецЕсли;
	
	Если ПараметрыОбработки <> Неопределено Тогда
		об = РеквизитФормыВЗначение("Объект");
		об.УстановитьПользовательскиеНастройки(ПараметрыОбработки);
		ЗначениеВРеквизитФормы(об, "Объект");
	КонецЕсли;
	
	//IMDEV-8204 +++
	Если РольДоступна("ВТБ_ЗапретПросмотраПлатежейРозничногоДУ") Тогда
		Объект.РозничноеДУ = Истина;
	КонецЕсли;
	//IMDEV-8204 ---
	
КонецПроцедуры


// ДП 20151117
&НаСервере
Функция РассылкаОтветственным(СписокДокументов)
	Тема = "Обработка платёжного поручения.";
	Таб = "";
	
	ДатаПроверки = ТекущаяДата();
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СписокПП", СписокДокументов);
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПлатежноеПоручение.Ссылка КАК ПлатежноеПоручение,
	|	ПользователиКонтактнаяИнформация.АдресЭП КАК АдресЭП
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО ПлатежноеПоручение.Ответственный = ПользователиКонтактнаяИнформация.Ссылка
	|ГДЕ ПлатежноеПоручение.Ссылка В (&СписокПП)
	|УПОРЯДОЧИТЬ ПО
	|	АдресЭП,
	|	ПлатежноеПоручение";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекПолучатель = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если ТекПолучатель <> Выборка.АдресЭП Тогда
			Если ТекПолучатель <> Неопределено Тогда
				Если Таб <> "" Тогда
					ТелоПисьма = "<html> <head> <meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" /> </head>"+
					"<body style=""font-family:Arial, Helvetica, sans-serif;color:black;"">"+
					"<b>"+Тема+"</b><br/><br/>"+
