&НаКлиенте
Процедура СохранитьМассивФайловНаКлиенте(МассивФайлов)
	
	Сч = 0;
	Для каждого Файл Из МассивФайлов Цикл
		Сч = Сч+1;
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(Файл.АдресВремХранилища);
		
		Попытка
			ОбФайл = новый Файл(Файл.ИмяФайла);
			КаталогКорень = ОбФайл.Путь;
			КаталогФайла = "PM"+Формат(ТекущаяДата(), "ДФ=ггггММддЧЧммсс")+Прав("000"+Сч, 3);
			
			Если ИмяКомпьютера() = "DMSK6058" Тогда 
				КаталогКорень = "C:\temp\";
			КонецЕсли;
			СоздатьКаталог(КаталогКорень+КаталогФайла);
			
			ИмяФайлаВыгрузки = КаталогКорень+КаталогФайла+"\"+ОбФайл.Имя;
			ДвоичныеДанные.Записать(ИмяФайлаВыгрузки);
		Исключение
			Сообщить(Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + " ошибка записи: "+ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультПредпросмотраНРД(Ответ, РезВыгрузка)
	
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивФайлов = ПолучитьИзВременногоХранилища(РезВыгрузка.АдресДанных);
	
	Сч = 0;
	Для каждого Файл Из МассивФайлов Цикл
		Сч = Сч+1;
		
		Попытка
			КаталогКорень = РезВыгрузка.КаталогВыгрузки+?(Прав(РезВыгрузка.КаталогВыгрузки,1) = "\", "", "\");
			КаталогФайла = "PM"+Формат(ТекущаяДата(), "ДФ=ггггММддЧЧммсс")+Прав("000"+Сч, 3);
			
			//Сообщить("Каталог: "+КаталогКорень+КаталогФайла);
			СоздатьКаталог(КаталогКорень+КаталогФайла);
			
			ИмяФайлаВыгрузки = КаталогКорень+КаталогФайла+"\"+Файл.ИмяФайлСообщения;
			//ИмяФайлаВыгрузки = КаталогКорень+ОбФайл.Имя;
			Текст = новый ТекстовыйДокумент;
			Текст.УстановитьТекст(Файл.СтрокаXML);
			Текст.Записать(ИмяФайлаВыгрузки, КодировкаТекста.ANSI);
			
			ДокОбъект = Файл.Ссылка.ПолучитьОбъект();
			ДокОбъект.Выгружено = ИСТИНА;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			УстановитьСтатусВыгружено(Файл.Ссылка);
			
		Исключение
			Сообщить("Файл: "+ИмяФайлаВыгрузки);
			Сообщить(Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + " ошибка записи: "+ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;
		
	КонецЦикла; 
	
	Сообщить("Данные успешно выгружены!");
	
	Если ГруппировкаДокументовПоБанку Тогда
		ОбновитьСписокКВыгрузкеНаСервереПоБанку();
	Иначе
		ОбновитьСписокКВыгрузкеНаСервереПоБанковскомуСчету();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВКлиентБанкНРД(Команда)
	
	Если Элементы.ВыпискиКВыгрузке.ТекущиеДанные = Неопределено Тогда
		Предупреждение("Нет данных для выгрузки!", 30);
		Возврат;
	КонецЕсли;
	
	текКлючВыписки	  = Элементы.ВыпискиКВыгрузке.ТекущиеДанные.КлючВыписки;
	текДоговорДУ	  = Элементы.ВыпискиКВыгрузке.ТекущиеДанные.ДоговорДУ;
	текБанковскийСчет = Элементы.ВыпискиКВыгрузке.ТекущиеДанные.БанковскийСчет;
	
	РезВыгрузка = ВыгрузитьВКлиентБанкНРДНаСервере(текКлючВыписки, текДоговорДУ, текБанковскийСчет);
	//СохранитьМассивФайловНаКлиенте(МассивФайлов);
	//Структура("КаталогВыгрузки, АдресДанных"
	стрИмяФормы = ЭтаФорма.ИмяФормы;
	стрИмяФормы = СтрЗаменить(стрИмяФормы, ".", Символы.ПС);
	
	ОбработкаОповещенияПредпросмотра = новый ОписаниеОповещения("ОбработатьРезультПредпросмотраНРД", ЭтотОбъект, РезВыгрузка);
	ОткрытьФорму("ВнешняяОбработка."+СтрПолучитьСтроку(стрИмяФормы, 2)+".Форма.ФормаПредпросмотр", РезВыгрузка, ЭтаФорма, , , , ОбработкаОповещенияПредпросмотра, );
	
КонецПроцедуры

