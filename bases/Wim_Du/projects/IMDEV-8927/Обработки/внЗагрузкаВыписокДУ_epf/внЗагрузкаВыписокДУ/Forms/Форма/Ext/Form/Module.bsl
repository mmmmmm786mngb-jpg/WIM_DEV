&НаКлиенте
Процедура НастройкиОбмена(Команда)
	
	
	ПараметрыФормы = Новый Структура;
	
	ТекДанные = Элементы.ВыпискиКВыгрузке.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		//ПараметрыФормы.Вставить("ГруппаДляНовыхКонтрагентов",Объект.ГруппаДляНовыхКонтрагентов);
		ПараметрыФормы.Вставить("НастройкаЗаполнения", Объект.НастройкаЗаполнения);
		ПараметрыФормы.Вставить("ДоговорДУ", ТекДанные.ДоговорДУ);
		ПараметрыФормы.Вставить("БанковскийСчет", ТекДанные.БанковскийСчет);
		ПараметрыФормы.Вставить("Банк", 		ТекДанные.Банк);
		ПараметрыФормы.Вставить("ГруппировкаДокументовПоБанку", ГруппировкаДокументовПоБанку);
		
	Иначе
		
	КонецЕсли;
	
	ФормаНастройки = ОткрытьФормуМодально("Обработка.КлиентБанк.Форма.ФормаНастройкиЗаполнения", ПараметрыФормы, ЭтаФорма);
	
	Если ФормаНастройки <> Неопределено И ФормаНастройки<>КодВозвратаДиалога.Отмена Тогда
		
		Для каждого СтрокаДокумента Из ФормаНастройки.Настр_ТаблицаДокументов Цикл
			НайденнаяСтрока = ТаблицаДокументов.НайтиСтроки(Новый Структура("Название",СтрокаДокумента.Документ));
			НайденнаяСтрока[0].Пометка 	= СтрокаДокумента.Пометка; 
		КонецЦикла;
		
		Для каждого СтрокаДокумента Из ФормаНастройки.Настр_ТаблицаНастроекПриЗагрузке Цикл
			НайденнаяСтрока = Объект.НастройкаЗаполнения.НайтиСтроки(Новый Структура("Документ",СтрокаДокумента.Документ));
			НайденнаяСтрока[0].Проводить = СтрокаДокумента.Проводить; 
			НайденнаяСтрока[0].СтатьяДДС = СтрокаДокумента.СтатьяДДС; 
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(Объект,ФормаНастройки);
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура Выгрузить(Команда)
	
	Счетчик = 0;
	Ошибка = Ложь;
	ОчиститьСообщения();
	
	Для каждого ТекВыписка Из Объект.ВыпискиКВыгрузке Цикл
		
		Если ТекВыписка.Выгружать Тогда
			
			СтруктураФайлаВыгрузки = ВыгрузитьНаСервере(ТекВыписка.КлючВыписки, ТекВыписка.ДоговорДУ, ТекВыписка.БанковскийСчет, ТекВыписка.ДатаВыписки, ТекВыписка.НомерСтроки);
			
			Если СтруктураФайлаВыгрузки <> Неопределено Тогда
				ПолучитьФайл(СтруктураФайлаВыгрузки.Адрес, СтруктураФайлаВыгрузки.ФайлВыгрузки, Ложь);
				Счетчик = Счетчик + 1;
			Иначе
				Ошибка = Истина;
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Счетчик > 0 И НЕ Ошибка Тогда
		Сообщить("Данные успешно выгружены.");
	ИначеЕсли Счетчик > 0 И Ошибка Тогда
		Сообщить("Данные выгружены частично.");    
	Иначе
		Сообщить("Список документов для выгрузки пуст.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере(КлючВыписки, ДоговорДУ, БанковскийСчет, ДатаВыписки, НомерСтроки)
	
	НастройкиОбменаБС = ЗагрузитьНастройкиПрограммыКлиентаБанка(ДоговорДУ, ?(ГруппировкаДокументовПоБанку,Объект.Банк,БанковскийСчет));
	Если НастройкиОбменаБС <> Неопределено И ЗначениеЗаполнено(НастройкиОбменаБС.Программа) И ЗначениеЗаполнено(НастройкиОбменаБС.Кодировка)И ЗначениеЗаполнено(НастройкиОбменаБС.ФайлВыгрузки)  Тогда
		Программа       = НастройкиОбменаБС.Программа;
		Кодировка       = НастройкиОбменаБС.Кодировка;
		ФайлВыгрузки    = НастройкиОбменаБС.ФайлВыгрузки;
		НачПериода      = Объект.ДатаНачала;
		КонПериода      = Объект.ДатаОкончания;
	Иначе
		Если ГруппировкаДокументовПоБанку Тогда
			Сообщить("Не заполнены настройки обмена для банка " + Объект.Банк+" в строке номер " + НомерСтроки +". Платежные документы по этому счету не выгружены.");
		Иначе
			Сообщить("Не заполнены настройки обмена для счета " + БанковскийСчет +" в строке номер " + НомерСтроки +". Платежные документы по этому счету не выгружены.");
		КонецЕсли;
		Возврат Неопределено;
		
	КонецЕсли; 
	
	ПлатежныеДокументы = Объект.ДокументыКВыгрузке.НайтиСтроки(Новый Структура("КлючВыписки",КлючВыписки));
	МассивСсылок = Новый Массив;
	Для каждого ТекДокумент Из ПлатежныеДокументы Цикл
		МассивСсылок.Добавить(ТекДокумент.Документ);
	КонецЦикла;
	
	ПлатежныеДокументы = ЗаполнитьДокументыНаЭкспорт(МассивСсылок);
	
	Адрес = Обработки.КлиентБанк.Выгрузить(ТаблицаДокументов, ПлатежныеДокументы, Кодировка, Программа, НачПериода, КонПериода, БанковскийСчет, ФайлВыгрузки, ДоговорДУ, ГруппировкаДокументовПоБанку);
	
	Возврат Новый Структура("Адрес, ФайлВыгрузки", Адрес, ФайлВыгрузки);
	
КонецФункции

&НаКлиенте
Процедура ВыгрузкаПриИзменении(Элемент)
	Объект.Выгрузка = РежимИспользования = "Выгрузка";
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ЗапроскСервису(Команда)
	
	ВремяСтарт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Отказ = Ложь;
	ЗапросКСервисуНаСервере(Отказ);
	
	НавСсылка = ЭтаФорма.Окно.ПолучитьНавигационнуюСсылку();
	Если Отказ Тогда
		ПоказатьОповещениеПользователя("Во время загрузки выписок произошли ошибки", НавСсылка,, БиблиотекаКартинок.ВыполненоСОшибками32);
	Иначе
		ПоказатьОповещениеПользователя("Чтение выписок успешно завершено", НавСсылка,, БиблиотекаКартинок.ВыполненоУспешно32);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Продолжительность: " + Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяСтарт) / 1000, "ЧДЦ=1; ЧРД=.; ЧН=; ЧГ=") + " сек.");
КонецПроцедуры // ЗапроскСервису()

