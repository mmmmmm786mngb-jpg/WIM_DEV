// ДП 20151117
Функция ВыгрузитьВКлиентБанкНаСервере(КлючВыписки, ДоговорДУ, БанковскийСчет)
	ПлатежкиКВыгрузке = Объект.ДокументыКВыгрузке.Выгрузить(Новый Структура("КлючВыписки, Выгружать, Статус", КлючВыписки, Истина, Перечисления.СтатусыОбъектов.КОплате));
	
	НастройкиОбменаБС = ЗагрузитьНастройкиПрограммыКлиентаБанка(ДоговорДУ, ?(ГруппировкаДокументовПоБанку,Объект.Банк, БанковскийСчет));
	Если НастройкиОбменаБС <> Неопределено И ЗначениеЗаполнено(НастройкиОбменаБС.Программа) И ЗначениеЗаполнено(НастройкиОбменаБС.Кодировка)И ЗначениеЗаполнено(НастройкиОбменаБС.ФайлВыгрузки)  Тогда
		Программа       = НастройкиОбменаБС.Программа;
		Кодировка       = НастройкиОбменаБС.Кодировка;
		ФайлВыгрузки    = НастройкиОбменаБС.ФайлВыгрузки;
		//IMDEV-8204 +++
		Если Объект.РозничноеДУ = 1 Тогда 
			ФайлВыгрузки = СтрЗаменить(ФайлВыгрузки, ".txt", "_розничное ДУ.txt");
		КонецЕсли;      
		//IMDEV-8204 ---
		НачПериода      = Объект.ДатаНачала;
		КонПериода      = Объект.ДатаОкончания;
	Иначе
		Если ГруппировкаДокументовПоБанку Тогда
			Сообщить("Не заполнены настройки обмена для банка " + Объект.Банк +". Платежные документы по этому счету не выгружены.");
		Иначе
			Сообщить("Не заполнены настройки обмена для счета " + БанковскийСчет + ". Платежные документы по этому счету не выгружены.");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли; 
	
	МассивСсылок = ПлатежкиКВыгрузке.ВыгрузитьКолонку("Документ");
	ПлатежныеДокументы = ЗаполнитьДокументыНаЭкспорт(МассивСсылок);
	
	// IMAPPS-1766	
	Для Каждого ТекДок ИЗ МассивСсылок Цикл
		Если ТекДок.СчетДоговораДУ.Банк.Код = "044525202" И СтрДлина(ТекДок.НазначениеПлатежа) > 175 Тогда 
			Сообщить("" + ТекДок + ". НазначениеПлатежа более 175 для Ситибанка.");
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Адрес = Обработки.КлиентБанк.Выгрузить(ТаблицаДокументов, ПлатежныеДокументы, Кодировка, Программа, НачПериода, КонПериода, БанковскийСчет, ФайлВыгрузки, ДоговорДУ, ГруппировкаДокументовПоБанку);
	
	// Отметка о выгрузке
	ТаблицаРассылки = Новый ТаблицаЗначений();
	ТаблицаРассылки.Колонки.Добавить("Документ");
	ТаблицаРассылки.Колонки.Добавить("Получатель");
	ТаблицаРассылки.Колонки.Добавить("Адрес");
	
	Для Каждого ТекДок ИЗ МассивСсылок Цикл
		ДокОбъект = ТекДок.ПолучитьОбъект();
		ДокОбъект.Выгружено = ИСТИНА;
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		УстановитьСтатусВыгружено(ТекДок);
	КонецЦикла;
	
	// Рассылка отвественным о том, что платёж выгружен
	РассылкаОтветственным(МассивСсылок);
	
	// Проверка на СПН
	ПроверитьВыводыСПН(МассивСсылок);
	
	Возврат Новый Структура("Адрес, ФайлВыгрузки", Адрес, ФайлВыгрузки);
КонецФункции

