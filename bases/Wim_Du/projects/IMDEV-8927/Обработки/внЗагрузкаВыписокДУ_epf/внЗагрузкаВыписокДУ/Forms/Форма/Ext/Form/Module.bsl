			КонПериода      = Объект.ДатаОкончания;
			
			ОбФайл = новый Файл(ФайлВыгрузки);
			КаталогВыгрузки = ОбФайл.Путь;
		Иначе
			Если ГруппировкаДокументовПоБанку Тогда
				Сообщить("Не заполнены настройки обмена для банка " + Объект.Банк +". Платежные документы по этому счету не выгружены.");
			Иначе
				Сообщить("Не заполнены настройки обмена для счета " + БанковскийСчет + ". Платежные документы по этому счету не выгружены.");
			КонецЕсли;
			Возврат новый Массив;
		КонецЕсли; 
		
		мас = новый Массив;
		мас.Добавить("40701756500004002324"); // chf
		мас.Добавить("40701978500002002324"); // eur
		мас.Добавить("40701826900000002324"); // gbp
		мас.Добавить("40701810900003002324"); // rur
		
		Модуль = РеквизитФормыВЗначение("Объект"); 
