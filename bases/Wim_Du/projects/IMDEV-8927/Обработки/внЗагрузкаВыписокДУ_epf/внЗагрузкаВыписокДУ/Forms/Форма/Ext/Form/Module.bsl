&НаКлиенте
Процедура ОбновитьСписокДокументовКВыгрузке(Команда)
	
	ОбновитьСписокДокументовКВыгрузкеНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокДокументовКВыгрузкеНаКлиенте()
	
	Если ГруппировкаДокументовПоБанку Тогда
		ОбновитьСписокКВыгрузкеНаСервереПоБанку();
	Иначе
		ОбновитьСписокКВыгрузкеНаСервереПоБанковскомуСчету();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокКВыгрузкеНаСервереПоБанковскомуСчету()
	
	Объект.ВыпискиКВыгрузке.Очистить();
	Объект.ДокументыКВыгрузке.Очистить();
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	//СписокСчетов = ТекОбъект.СписокБанковскихСчетовПоОтбору();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПлатежноеПоручение.Ссылка,
	|	ПлатежноеПоручение.Номер,
	|	НАЧАЛОПЕРИОДА(ПлатежноеПоручение.Дата, ДЕНЬ) КАК ДатаВыписки,
	|	ПлатежноеПоручение.ДоговорДУ,
	|	ПлатежноеПоручение.СуммаДокумента КАК СуммаДокумента,
	|	ПлатежноеПоручение.СчетДоговораДУ КАК БанковскийСчет,
	|	ПлатежноеПоручение.Контрагент,
	|	ИсторияСтатусов.Статус,
	|	ПлатежноеПоручение.НазначениеПлатежа
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияСтатусовОбъектов.СрезПоследних КАК ИсторияСтатусов
	|		ПО ИсторияСтатусов.Объект = ПлатежноеПоручение.Ссылка
	|ГДЕ
	|	ПлатежноеПоручение.Дата МЕЖДУ &ДатаНач И &ДатаКон
	//	|	И ПлатежноеПоручение.СчетДоговораДУ В(&СписокСчетов)
	//|	И НЕ ПлатежноеПоручение.Оплачено
	//|	И НЕ ПлатежноеПоручение.Выгружено  // ДП 20151117
	|	И ИсторияСтатусов.Статус В(ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.КОплате), ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.Выгружено))
	|	И ПлатежноеПоручение.ДоговорДУ.УправляющаяКомпания = &УправляющаяКомпания
	|	И ПлатежноеПоручение.ДоговорДУ.ТипКлиентаДУ = &ТипКлиентаДУ
	|	И ПлатежноеПоручение.Проведен
	// VTB-Borisov  - 15.07.2016 { 
	|УПОРЯДОЧИТЬ ПО
	|	ПлатежноеПоручение.Дата,
	|	ПлатежноеПоручение.Номер
	// VTB-Borisov  - 15.07.2016 }
	|ИТОГИ
	|	СУММА(СуммаДокумента)
	|ПО
	|	ДатаВыписки,
	|	БанковскийСчет";   
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Объект.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Объект.ДатаОкончания));
	//	Запрос.УстановитьПараметр("СписокСчетов", Объект.СписокСчетов);
	Если ЗначениеЗаполнено(Объект.УправляющаяКомпания) Тогда
		Запрос.УстановитьПараметр("УправляющаяКомпания", Объект.УправляющаяКомпания);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ПлатежноеПоручение.ДоговорДУ.УправляющаяКомпания = &УправляющаяКомпания","");
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ТипКлиента) Тогда
		Запрос.УстановитьПараметр("ТипКлиентаДУ", Объект.ТипКлиента);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ПлатежноеПоручение.ДоговорДУ.ТипКлиентаДУ = &ТипКлиентаДУ","");
	КонецЕсли;
	
	ВыборкаДат = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	Пока ВыборкаДат.Следующий() Цикл
		
		ВыборкаСчетов = ВыборкаДат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСчетов.Следующий() Цикл
			
			НоваяВыписка = Объект.ВыпискиКВыгрузке.Добавить();
			НоваяВыписка.ДатаВыписки 	= ВыборкаСчетов.ДатаВыписки;
			НоваяВыписка.БанковскийСчет  = ВыборкаСчетов.БанковскийСчет;
			НоваяВыписка.СуммаВыписки 	= ВыборкаСчетов.СуммаДокумента;
			НоваяВыписка.КлючВыписки 	= Новый УникальныйИдентификатор;
			НоваяВыписка.Выгружать 		= Истина;
			НоваяВыписка.ДоговорДУ       = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ВыборкаСчетов.БанковскийСчет,"ДоговорДУ");;
			
			Детали = ВыборкаСчетов.Выбрать();
			Пока Детали.Следующий() Цикл
				Если НЕ ЗначениеЗаполнено(НоваяВыписка.ДоговорДУ) Тогда
					НоваяВыписка.ДоговорДУ = Детали.ДоговорДУ;
				КонецЕсли;
				НовыеДетали = Объект.ДокументыКВыгрузке.Добавить();
				НовыеДетали.КлючВыписки 		    = НоваяВыписка.КлючВыписки;
				НовыеДетали.НазначениеПлатежа    = Детали.НазначениеПлатежа;
				НовыеДетали.Контрагент 		    = Детали.Контрагент;
				НовыеДетали.Документ 			= Детали.Ссылка;
				НовыеДетали.НомерДокумента		= ТекОбъект.УдалитьЛидирующиеНули(Детали.Номер);
				НовыеДетали.Статус 				= Детали.Статус;
				НовыеДетали.Пул 				= Детали.ДоговорДУ.Пул;     //IMDEV-8204 +++
				НовыеДетали.Выгружать = Ложь;
			Конеццикла;		
		Конеццикла;
		
	Конеццикла;
	
	ИзменитьЗаголовокВыгрузить();
	ИзменитьЗаголовокВыгрузитьПлатежки();	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокКВыгрузкеНаСервереПоБанку()
	
	Объект.ВыпискиКВыгрузке.Очистить();
	Объект.ДокументыКВыгрузке.Очистить();
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	//СписокСчетов = ТекОбъект.СписокБанковскихСчетовПоОтбору();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПлатежноеПоручение.Ссылка,
	|	ПлатежноеПоручение.Номер КАК Номер,
	|	НАЧАЛОПЕРИОДА(ПлатежноеПоручение.Дата, ДЕНЬ) КАК ДатаВыписки,
	|	ПлатежноеПоручение.СуммаДокумента КАК СуммаДокумента,
	|	ПлатежноеПоручение.Контрагент,
	|	ИсторияСтатусов.Статус,
	|	ПлатежноеПоручение.НазначениеПлатежа,
	//IMDEV-8204 +++
	|	ПлатежноеПоручение.ДоговорДУ КАК ДоговорДУ
	//IMDEV-8204 ---
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияСтатусовОбъектов.СрезПоследних КАК ИсторияСтатусов
	|		ПО ИсторияСтатусов.Объект = ПлатежноеПоручение.Ссылка
	|ГДЕ
	|	ПлатежноеПоручение.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПлатежноеПоручение.СчетДоговораДУ.Банк = &Банк
	//|	И НЕ ПлатежноеПоручение.Оплачено
	//|	И НЕ ПлатежноеПоручение.Выгружено  // ДП 20151117
	|	И ИсторияСтатусов.Статус В(ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.КОплате), ЗНАЧЕНИЕ(Перечисление.СтатусыОбъектов.Выгружено))
	|	И ПлатежноеПоручение.ДоговорДУ.УправляющаяКомпания = &УправляющаяКомпания
	|	И ПлатежноеПоручение.ДоговорДУ.ТипКлиентаДУ = &ТипКлиентаДУ
	|	И ПлатежноеПоручение.Проведен = ИСТИНА
	// VTB-Borisov  - 15.07.2016 { 
	|УПОРЯДОЧИТЬ ПО
	|	ПлатежноеПоручение.Дата,
	|	ПлатежноеПоручение.Номер
	// VTB-Borisov  - 15.07.2016 }
	|ИТОГИ
	|	СУММА(СуммаДокумента)
	|ПО
	|	ДатаВыписки";   
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Объект.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Объект.ДатаОкончания));
	Запрос.УстановитьПараметр("Банк", Объект.Банк);
	Если ЗначениеЗаполнено(Объект.УправляющаяКомпания) Тогда
		Запрос.УстановитьПараметр("УправляющаяКомпания", Объект.УправляющаяКомпания);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ПлатежноеПоручение.ДоговорДУ.УправляющаяКомпания = &УправляющаяКомпания","");
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ТипКлиента) Тогда
		Запрос.УстановитьПараметр("ТипКлиентаДУ", Объект.ТипКлиента);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ПлатежноеПоручение.ДоговорДУ.ТипКлиентаДУ = &ТипКлиентаДУ","");
	КонецЕсли;
	
	ВыборкаДат = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	Пока ВыборкаДат.Следующий() Цикл
		
		НоваяВыписка = Объект.ВыпискиКВыгрузке.Добавить();
		НоваяВыписка.ДатаВыписки 	= ВыборкаДат.ДатаВыписки;
		НоваяВыписка.Банк  			= Объект.Банк;
		НоваяВыписка.КлючВыписки 	= Новый УникальныйИдентификатор;
		НоваяВыписка.Выгружать 		= Истина;
		
		Детали = ВыборкаДат.Выбрать();
		Пока Детали.Следующий() Цикл
			НовыеДетали = Объект.ДокументыКВыгрузке.Добавить();
			НовыеДетали.КлючВыписки 		= НоваяВыписка.КлючВыписки;
			НовыеДетали.НазначениеПлатежа   = Детали.НазначениеПлатежа;
			НовыеДетали.Контрагент 		    = Детали.Контрагент;
			НовыеДетали.Документ 			= Детали.Ссылка;
			НовыеДетали.НомерДокумента		= ТекОбъект.УдалитьЛидирующиеНули(Детали.Номер);
			НовыеДетали.Статус 				= Детали.Статус;
			НовыеДетали.Пул 				= Детали.ДоговорДУ.Пул;   //IMDEV-8204 +++
			НовыеДетали.Выгружать 			= Ложь;   // ДП 20151117
		Конеццикла;	
		
	КонецЦикла;
	
	ИзменитьЗаголовокВыгрузить();
	ИзменитьЗаголовокВыгрузитьПлатежки();
	
КонецПроцедуры


&НаКлиенте
Процедура ИмяНастройкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	П = Новый Структура("НастройкиОтбора", Новый Структура("ИмяНастройки, ПараметрыОтбораБанковскихСчетов, СписокСчетов", Объект.ИмяНастройки, Объект.ПараметрыОтбораБанковскихСчетов, Объект.СписокСчетов));
	СтруктураНастроек = ОткрытьФормуМодально("ВнешняяОбработка.ЗагрузкаВыписок.Форма.НастройкиБанковскихСчетов", П);
	
	Если ТипЗнч(СтруктураНастроек) = Тип("Структура") тогда
		
		Объект.ИмяНастройки 					= ?(СтруктураНастроек.ИмяНастройки="","Все",СтруктураНастроек.ИмяНастройки);
		Объект.ПараметрыОтбораБанковскихСчетов 	= СтруктураНастроек.ПараметрыОтбораБанковскихСчетов;
		Объект.СписокСчетов                     = СтруктураНастроек.СписокСчетов;
		
		ОбновитьСписокКВыгрузкеНаСервереПоБанковскомуСчету();
		
	КонецЕсли;
	
КонецПроцедуры

//ОБЩИЕ ПРОЦЕДУРЫ ФУНКЦИИ

&НаКлиенте
Процедура ОбновитьПлатежныеДокументы()
	
	Если Элементы.Выписки.ТекущиеДанные = неопределено тогда 
		Выписка = -1;
	Иначе
		Выписка = Элементы.Выписки.ТекущиеДанные.КлючВыписки;
	КонецЕсли;
	
	Отбор = Новый ФиксированнаяСтруктура("КлючВыписки", Выписка);
	Элементы.ПлатежныеДокументы.ОтборСтрок = Отбор;
	
КонецПроцедуры  

&НаКлиенте
Процедура ОбновитьПлатежныеДокументыВыгрузки()
	
	Если Элементы.ВыпискиКВыгрузке.ТекущиеДанные = неопределено тогда 
		Выписка = -1;
	Иначе
		Выписка = Элементы.ВыпискиКВыгрузке.ТекущиеДанные.КлючВыписки;
	КонецЕсли;
	
	//IMDEV-8204 +++
	Если Объект.РозничноеДУ = 1 Тогда
		Отбор = Новый ФиксированнаяСтруктура("КлючВыписки, Пул", Выписка, ПулРозничногоДУ());
	ИначеЕсли Объект.РозничноеДУ = 0 Тогда
		Отбор = Новый ФиксированнаяСтруктура("КлючВыписки, Пул", Выписка, ПредопределенноеЗначение("Справочник.Пул.ПустаяСсылка")); 
	Иначе 
		Отбор = Новый ФиксированнаяСтруктура("КлючВыписки", Выписка);
	КонецЕсли;
	//Отбор = Новый ФиксированнаяСтруктура("КлючВыписки", Выписка);
	//IMDEV-8204 ---
	Элементы.ДокументыКВыгрузке.ОтборСтрок = Отбор;
	ИзменитьЗаголовокВыгрузитьПлатежки();
КонецПроцедуры

//Действие: 0 -снять, 1- установить, -1 - инвертировать
&НаСервере
Процедура УправлениеФлажками(Действие)
	
	Для каждого СтрокаВыписки из Объект.Выписки Цикл
		СтрокаВыписки.Загружать = ?(Действие=-1, НЕ СтрокаВыписки.Загружать,Булево(Действие));
	Конеццикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеВыписки(Выписка)
	
	Возврат "Выписка: " + Выписка.ДатаСоздания +Символы.Таб +Выписка.ДоговорДУ + Символы.Таб + Выписка.БанковскийСчетКод;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеПП(ПП)
	
	Возврат ПП.Номер + " " + Формат(ПП.Дата,"ДФ=dd.MM.yyyy") + " Сумма: " + ПП.Сумма + " Плательщик:" + ПП.Плательщик + " Получатель:"+ ПП.Получатель + " Назначение платежа:"+ ПП.НазначениеПлатежа;
	
КонецФункции


Функция ЗаполнитьДокументыНаЭкспорт(МассивСсылок) 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|   ""Платежное поручение"" КАК ВидДокумента,
	|   ПлатежноеПоручение.Ссылка КАК Документ,
	|   ПлатежноеПоручение.Проведен,
	|   ПлатежноеПоручение.Номер,
	|   ПлатежноеПоручение.Дата,
	|   ПлатежноеПоручение.ВидПлатежа,
	|   ПлатежноеПоручение.ОчередностьПлатежа,
	|   ПлатежноеПоручение.НазначениеПлатежа,
	|   ПлатежноеПоручение.СуммаДокумента,
	|   0 КАК СуммаНаПриход,
	|   ПлатежноеПоручение.СуммаДокумента КАК СуммаНаРасход,
	|   ПлатежноеПоручение.ТекстПлательщика,
	|   ПлатежноеПоручение.ТекстПолучателя,
	|   ПлатежноеПоручение.ИННПлательщика,
	|   ПлатежноеПоручение.КПППлательщика,
	|   ПлатежноеПоручение.ИННПолучателя,
	|   ПлатежноеПоручение.КПППолучателя,
	|   ПлатежноеПоручение.КодБК,
	|   ПлатежноеПоручение.КодОКАТО,
	|   ПлатежноеПоручение.ПоказательДаты,
	|   ПлатежноеПоручение.ПоказательНомера,
	|   ПлатежноеПоручение.ПоказательОснования,
	|   ПлатежноеПоручение.ПоказательТипа,
	|   ПлатежноеПоручение.ПоказательПериода,
	|   ПлатежноеПоручение.СтатусСоставителя,
	|   ВЫРАЗИТЬ(ПлатежноеПоручение.ДоговорДУ.УправляющаяКомпания.Наименование КАК СТРОКА(255)) КАК Организация,
	|   ПлатежноеПоручение.ДоговорДУ.УправляющаяКомпания.Наименование КАК ОрганизацияКратко,
	|   ПлатежноеПоручение.ДоговорДУ.УправляющаяКомпания.ИНН КАК ОрганизацияИНН,
	|   ПлатежноеПоручение.ДоговорДУ.УправляющаяКомпания.КПП КАК ОрганизацияКПП,
	|   ПлатежноеПоручение.СчетДоговораДУ КАК ОрганизацияСчет,
	|   ПлатежноеПоручение.СчетДоговораДУ.НомерСчета КАК ОрганизацияНомерСчета,
	|   ПлатежноеПоручение.СчетДоговораДУ.Банк.Код КАК ОрганизацияБИКБанка,
	|   ПлатежноеПоручение.СчетДоговораДУ.Банк.Наименование КАК ОрганизацияБанк,
