		Импорт_РасчетныеСчета.Колонки.Добавить("РасчСчет");
		Импорт_РасчетныеСчета.Колонки.Добавить("ДатаНачала");
		Импорт_РасчетныеСчета.Колонки.Добавить("ДатаКонца");
		Импорт_РасчетныеСчета.Колонки.Добавить("НачальныйОстаток");
		Импорт_РасчетныеСчета.Колонки.Добавить("ВсегоПоступило");
		Импорт_РасчетныеСчета.Колонки.Добавить("ВсегоСписано");
		Импорт_РасчетныеСчета.Колонки.Добавить("КонечныйОстаток");
		Импорт_РасчетныеСчета.Колонки.Добавить("Начало");
		Импорт_РасчетныеСчета.Колонки.Добавить("Конец");
		Импорт_РасчетныеСчета.Колонки.Добавить("РасчетныйСчет");
		Импорт_РасчетныеСчета.Колонки.Добавить("НачальнаяСумма");
		Импорт_РасчетныеСчета.Колонки.Добавить("Поступило");
		Импорт_РасчетныеСчета.Колонки.Добавить("Списано");
		Импорт_РасчетныеСчета.Колонки.Добавить("КонечнаяСумма");
		
		ОбработкаКлиентБанк = Обработки.КлиентБанк.Создать();
		ЗаполнитьЗначенияСвойств(ОбработкаКлиентБанк, ТекВыписка, "БанковскийСчет, ДоговорДУ, НачальныйОстаток, ВсегоПоступило, ВсегоСписано, КонечныйОстаток");
		
		//TM-2308----
		ОбработкаКлиентБанк.НачПериода = ТекВыписка.ДатаСоздания;
		ОбработкаКлиентБанк.КонПериода = ТекВыписка.ДатаСоздания;
		//-----TM-2308
		
		ПлатежныеДокументы = Объект.ПлатежныеДокументы.НайтиСтроки(Новый Структура("КлючВыписки", ТекВыписка.КлючВыписки));		
		Для каждого СтрокаПлатежки Из ПлатежныеДокументы Цикл
			
			НоваяСтрока_ДокументыКИмпорту = ОбработкаКлиентБанк.ДокументыКИмпорту.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока_ДокументыКИмпорту, СтрокаПлатежки, ,"Лог,Загружен");
			
			НоваяСтрока_ПлатежныеДокументы = ОбработкаКлиентБанк.ПлатежныеДокументы.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтрока_ПлатежныеДокументы, СтрокаПлатежки);
			
		КонецЦикла;
		
		Обработки.КлиентБанк.РазобратьДанныеИмпорта(ОбработкаКлиентБанк.ДоговорДУ, ОбработкаКлиентБанк.БанковскийСчет, ОбработкаКлиентБанк.ДокументыКИмпорту, Неопределено);
		Обработки.КлиентБанк.ПроверитьЗаполнениеТаблицыДокументов(ОбработкаКлиентБанк, ОбработкаКлиентБанк.ПлатежныеДокументы);
		
		Обработки.КлиентБанк.Загрузить(ОбработкаКлиентБанк.ДокументыКИмпорту, Неопределено, Неопределено, ОбработкаКлиентБанк.ДоговорДУ, Импорт_РасчетныеСчета, 
		ОбработкаКлиентБанк.ИспользоватьГраницуОбработки, ОбработкаКлиентБанк.ДатаГраницыОбработки, ОбработкаКлиентБанк.БанковскийСчет);
		
		Обработки.КлиентБанк.ПослеЗагрузкиВыписки(ОбработкаКлиентБанк);
		
		ВсеПлатежкиЗагружены = Истина;
		Для каждого ТекСтрокаПлатежки Из ПлатежныеДокументы Цикл
			
			НайденнаяСтрока = ОбработкаКлиентБанк.ДокументыКИмпорту.Найти(ТекСтрокаПлатежки.КлючДокумента,"КлючДокумента");
			Если НайденнаяСтрока = Неопределено Тогда
				ВсеПлатежкиЗагружены = Ложь;
				Продолжить;	  
			ИначеЕсли НайденнаяСтрока.Загружен = Ложь Тогда
				ВсеПлатежкиЗагружены = Ложь;
			КонецЕсли;
			
			ТекСтрокаПлатежки.Загружен = НайденнаяСтрока.Загружен;
			ОбщийЛогПоВыписке =  ОбщийЛогПоВыписке  + Символы.ПС + ПредставлениеПП(НайденнаяСтрока) + Символы.ПС + СокрЛП(НайденнаяСтрока.Лог);//
			
		КонецЦикла;
		
		ТекВыписка.Загружена = ВсеПлатежкиЗагружены;
		Если ТекВыписка.Загружена Тогда
			ТекВыписка.Лог = ПредставлениеВыписки(ТекВыписка) + Символы.ПС + СокрЛП(ОбщийЛогПоВыписке);
		КонецЕсли;
		
		ОбщийЛог = ОбщийЛог + Символы.ПС + Символы.ПС+ ТекВыписка.Лог;

	КонецЦикла;	
	
КонецПроцедуры // ()
// }

&НаСервере
