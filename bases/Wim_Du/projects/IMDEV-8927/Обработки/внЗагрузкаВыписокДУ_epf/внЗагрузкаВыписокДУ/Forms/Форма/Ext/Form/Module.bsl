&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Заголовок = "v."+ТекОбъект.СведенияОВнешнейОбработке().Версия;
	
	Объект.ПолноеИмяОбработки = ТекОбъект.Метаданные().ПолноеИмя();
	Объект.ТипСчетов = "ДУ";
	РежимИспользования = "Загрузка";
	
	Объект.ИмяНастройки = ?(Объект.ИмяНастройки="","Все",Объект.ИмяНастройки);
	Если НЕ ЗначениеЗаполнено(Объект.ПараметрыОтбораБанковскихСчетов) Тогда
		Объект.ПараметрыОтбораБанковскихСчетов = "<Отбор/>";
	КонецЕсли;
	
	Если Объект.НастройкаЗаполнения.Количество() = 0 Тогда
		Объект.НастройкаЗаполнения.Добавить().Документ = "Поступление на расчетный счет";
		Объект.НастройкаЗаполнения.Добавить().Документ = "Списание с расчетного счета";
	КонецЕсли;
	
	НоваяСтрока = ТаблицаДокументов.Добавить();
	НоваяСтрока.Документ = "ПлатежноеПоручение";
	НоваяСтрока.ДокументКратко = "ПлатежноеПоручение";
	НоваяСтрока.Корреспондент = "Получатель";
	НоваяСтрока.Название = "Платежное поручение";
	НоваяСтрока.Пометка = Истина;
	
	НоваяСтрока = ТаблицаДокументов.Добавить();
	НоваяСтрока.Документ = "ПлатежноеТребование";
	НоваяСтрока.ДокументКратко = "ПлатежноеТребование";
	НоваяСтрока.Корреспондент = "Получатель";
	НоваяСтрока.Название = "Платежное требование";
	НоваяСтрока.Пометка = Ложь;
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если  ИмяСобытия = "ЗагруженаВыписка" и ТипЗнч(Параметр) = Тип("Структура") тогда
		
		Выписка = Неопределено;
		Параметр.Свойство("ИсточникДанных", Выписка);
		Если Выписка = Неопределено тогда Возврат; КонецЕсли;
		
		ЗагруженныеПП = Неопределено;
		Если НЕ Параметр.Свойство("ЗагруженныеДокументы",ЗагруженныеПП) тогда Возврат; КонецЕсли;
		
		УстановитьЗагруженныеДокументы(ЗагруженныеПП, Выписка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗагруженныеДокументы(ЗагруженныеПП, Выписка)
	
	ОбщийЛог = "";
	
	МассивВыписок = объект.Выписки.найтиСтроки(Новый Структура("КлючВыписки",Выписка));
	Если МассивВыписок.Количество()=0 тогда Возврат; КонецЕсли;
	
	ТекВыписка = МассивВыписок[0];
	
	МассивПлатежек = Объект.ПлатежныеДокументы.НайтиСтроки(Новый Структура("КлючВыписки", Выписка));
	ВсегоПП = МассивПлатежек.Количество();
	сч=0;	
	Для каждого ПП из МассивПлатежек Цикл
		ТекЛог = ЗагруженныеПП.Получить(ПП.КлючДокумента);
		
		Если ТекЛог<>Неопределено тогда
			сч = сч+1;
		КонецЕсли;
		
		ПП.Загружен = ТекЛог<>Неопределено;
		
		ПП.Лог 	= ТекЛог;  
		ОбщийЛог =  ОбщийЛог  + Символы.ПС+ ПредставлениеПП(ПП) + Символы.ПС+ СокрЛП(ТекЛог);//
		
	Конеццикла;
	
	ТекВыписка.Загружена = ?(Сч=0,0, ?(ВсегоПП=сч,1,-1)); 
	Если ТекВыписка.Загружена = 0 тогда
		ТекВыписка.Загружать = Ложь;
	КонецЕсли;
	
	ТекстВыписки = ПредставлениеВыписки(ТекВыписка)+ Символы.ПС; 
	ТекВыписка.Лог = ТекстВыписки + СокрЛП(ОбщийЛог);
	
КонецПроцедуры

