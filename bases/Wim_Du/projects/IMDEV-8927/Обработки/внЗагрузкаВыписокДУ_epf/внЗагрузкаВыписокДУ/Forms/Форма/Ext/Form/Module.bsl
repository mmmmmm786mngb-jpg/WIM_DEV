&НаСервере
Процедура УдалитьСвязанныеПлатежи(Выписка)
	
	ВсегоСтрок = Объект.ПлатежныеДокументы.Количество()-1;
	Для сч =0 по ВсегоСтрок-1 Цикл
		ТекСтрока = Объект.ПлатежныеДокументы[ВсегоСтрок-сч];
		Если ТекСтрока.КлючВыписки = Выписка тогда
			Объект.ПлатежныеДокументы.Удалить(ТекСтрока);
		КонецЕсли;
