		ОбФайл = новый Файл(СтруктураФайлаВыгрузки.ФайлВыгрузки);
		Если ИмяКомпьютера() = "DMSK6138" Тогда
			ИмяФайлаВыгрузки = "C:\temp\import_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + ОбФайл.Расширение;
		Иначе
			ИмяФайлаВыгрузки = ОбФайл.Путь + "import" + ОбФайл.Расширение;
		КонецЕсли;
		
		ПолучитьФайл(СтруктураФайлаВыгрузки.Адрес, ИмяФайлаВыгрузки, Ложь);
		// перекодируем в DOS
		обТекст = новый ТекстовыйДокумент;
		обТекст.Прочитать(ИмяФайлаВыгрузки, КодировкаТекста.ANSI);
		обТекст.Записать(ИмяФайлаВыгрузки, КодировкаТекста.OEM);
		//--
		
		Сообщить("Данные успешно выгружены!");
		ОбновитьСписокДокументовКВыгрузкеНаКлиенте();
	КонецЕсли;
КонецПроцедуры

// ДП 20151117
&НаСервере
Функция ПроверитьВыводыСПН(МассивДокументов)
	ДокументыКВыгрузке = Новый СписокЗначений();
	
	СписокТипов = Новый СписокЗначений;
	СписокТипов.Добавить(Перечисления.ТипыКлиентовДУ.ПенсионныеРезервыНПФ);
	СписокТипов.Добавить(Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеЧерезНПФ);
	СписокТипов.Добавить(Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеПФР);
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СписокТипов", СписокТипов);
	Запрос.УстановитьПараметр("СписокДокументов", МассивДокументов);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПлатежноеПоручение.Ссылка КАК Документ,
	|	ПлатежноеПоручение.ДоговорДУ,
	|	ПлатежноеПоручение.НазначениеПлатежа,
	|	ПлатежноеПоручение.СуммаДокумента,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КурсыВалют.Курс, 0) = 0
	|			ТОГДА ВЫБОР
	|					КОГДА ПлатежноеПоручение.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.RUB)
	|						ТОГДА ПлатежноеПоручение.СуммаДокумента
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ПлатежноеПоручение.СуммаДокумента * (КурсыВалют.Курс / КурсыВалют.Кратность) / ЕСТЬNULL(РегистрРСА_СЧА.СЧА, 0) * 100
	|	КОНЕЦ КАК Порог,
	|	ЕСТЬNULL(РегистрРСА_СЧА.СЧА, 0) КАК СЧА
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрРСА_СЧА КАК РегистрРСА_СЧА
	|		ПО ПлатежноеПоручение.ДоговорДУ = РегистрРСА_СЧА.ДоговорДУ
	|			И (РегистрРСА_СЧА.Период В
	|				(ВЫБРАТЬ
	|					МАКСИМУМ(РегистрСведений.РегистрРСА_СЧА.Период)
	|				ИЗ
	|					РегистрСведений.РегистрРСА_СЧА
	|				ГДЕ
	|					РегистрСведений.РегистрРСА_СЧА.ДоговорДУ = ПлатежноеПоручение.ДоговорДУ
	|					И РегистрСведений.РегистрРСА_СЧА.Период <= ПлатежноеПоручение.Дата))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО ПлатежноеПоручение.ВалютаДокумента = КурсыВалют.Валюта
	|			И (КурсыВалют.Период В
	|				(ВЫБРАТЬ
	|					МАКСИМУМ(РегистрСведений.КурсыВалют.Период)
	|				ИЗ
	|					РегистрСведений.КурсыВалют
	|				ГДЕ
	|					РегистрСведений.КурсыВалют.Валюта = ПлатежноеПоручение.ВалютаДокумента
	|					И РегистрСведений.КурсыВалют.Кратность <> 0
	|					И РегистрСведений.КурсыВалют.Период <= ПлатежноеПоручение.Дата))
	|ГДЕ
	|	ПлатежноеПоручение.Ссылка В(&СписокДокументов)
	|	И ПлатежноеПоручение.ДоговорДУ.ТипКлиентаДУ В(&СписокТипов)
	|	И ВЫБОР
	|			КОГДА ЕСТЬNULL(КурсыВалют.Курс, 0) = 0
	|				ТОГДА ВЫБОР
	|						КОГДА ПлатежноеПоручение.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.RUB)
	|							ТОГДА ПлатежноеПоручение.СуммаДокумента
	|						ИНАЧЕ 0
	|					КОНЕЦ
	|			ИНАЧЕ ПлатежноеПоручение.СуммаДокумента * (КурсыВалют.Курс / КурсыВалют.Кратность) / ЕСТЬNULL(РегистрРСА_СЧА.СЧА, 0) * 100
	|		КОНЕЦ > 1
	|	И (ПлатежноеПоручение.НазначениеПлатежа ПОДОБНО ""%вывод%""
	|			ИЛИ ПлатежноеПоручение.НазначениеПлатежа ПОДОБНО ""%передача средств%""
	|			ИЛИ ПлатежноеПоручение.НазначениеПлатежа ПОДОБНО ""%доход%"")";
	
	ТабДокументов = Запрос.Выполнить().Выгрузить();
	ДокументыКВыгрузке = ТабДокументов.ВыгрузитьКолонку("Документ");
	
	ВнешняяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Загрузка выписок");
	ПараметрыВыполненияКоманды = Новый Структура();
	ПараметрыВыполненияКоманды.Вставить("ДополнительнаяОбработкаСсылка", ВнешняяОбработкаСсылка);
	ПараметрыВыполненияКоманды.Вставить("ПараметрыДополнительнойОбработки",Справочники.ДополнительныеОтчетыИОбработки.НастройкиОбработки(ВнешняяОбработкаСсылка));
	ПредставлениеНастроек = "";
	ЗначенияНастроек = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	
	Если ЗначенияНастроек = Неопределено Тогда
		Сообщить("Не установлены настройки рассылки! Письма отправлены не будут!", СтатусСообщения.Важное);
		Возврат Ложь;
	Иначе	
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		ТекОбъект.УстановитьПользовательскиеНастройки(ЗначенияНастроек,ПредставлениеНастроек);
		ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
		
		Если ДокументыКВыгрузке.Количество() > 0 Тогда		
			СформироватьКоррекциюВМО(ДокументыКВыгрузке);
			СформироватьРассылку(ТабДокументов);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

// ДП 20151117
&НаСервере
Функция СформироватьКоррекциюВМО(СписокДокументов)
	Внешняя = Новый COMObject ("V83.ComConnector");  
	Попытка
		База = Внешняя.Connect("Srvr=""" + Объект.СерверМО + """;Ref=""" + Объект.БазаМО + """;Usr=""" + Объект.ЛогинМО + """;Pwd=""" + Объект.ПарольМО + """");
	Исключение
		Сообщить("Ошибка подключения к базе: " + База + ". Проверьте настройки обработки!", СтатусСообщения.Важное);
		Возврат ЛОЖЬ;
	КонецПопытки;
	
	Для Каждого ТекДокумент ИЗ СписокДокументов Цикл
		// Поиск справочных данных
		Мандат = База.Справочники.Мандаты.ПолучитьСсылку(База.NewObject("УникальныйИдентификатор", Строка(ТекДокумент.ДоговорДУ.УникальныйИдентификатор())));
		
		Запрос = База.NewObject("Запрос");
		Запрос.УстановитьПараметр("Мандат", Мандат);
		Запрос.УстановитьПараметр("НомерСчета", ТекДокумент.СчетДоговораДУ.НомерСчета);
		Запрос.Текст = 	  "ВЫБРАТЬ
		|	СчетаМандатов.Ссылка
		|ИЗ
		|	Справочник.СчетаМандатов КАК СчетаМандатов
		|ГДЕ
		|	СчетаМандатов.Владелец = &Мандат
		|	И СчетаМандатов.МестоХранения.НомерСчета = &НомерСчета";
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			СчетМандата = Результат.Ссылка;
		Иначе
			Сообщить("В базе МО не найден счет мандата для р/с № " + ТекДокумент.СчетДоговораДУ.НомерСчета);
		КонецЕсли;
		
		Валюта = База.Справочники.Валюты.НайтиПоНаименованию(ТекДокумент.ВалютаДокумента.Наименование);
		
		Содержание =  "{Автокоррекция ДУ} ПП № " + ТекДокумент.Номер + " от " + Формат(ТекДокумент.Дата, "ДФ=дд.ММ.гггг"); 
		Запрос = База.NewObject("Запрос");
		Запрос.Текст = 	 "ВЫБРАТЬ
		|	Операция.Ссылка КАК Документ
		|ИЗ
		|	Документ.Операция КАК Операция
		|ГДЕ
		|	Операция.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И Операция.Содержание = &Содержание";
		Запрос.УстановитьПараметр("Период", ТекДокумент.Дата - 60*60*24);
		Запрос.УстановитьПараметр("Содержание",Содержание);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Док = Выборка.Документ.ПолучитьОбъект();
			Сообщить("Удален документ " + Док.Номер);
			Док.Удалить();
		КонецЦикла;
		
		Операция  = База.Документы.Операция.СоздатьДокумент();
		Операция.Дата = ТекДокумент.Дата - 60*60*24;
		Операция.Мандат = Мандат;
		Операция.Содержание = Содержание;
		Операция.СпособЗаполнения = "Вручную";
		Операция.ВременнаяКорректировка = Истина;
		Операция.Записать(База.РежимЗаписиДокумента.Запись);
		
		Регистр = Операция.ТаблицаРегистровНакопления.Добавить();
		Регистр.Имя = "ДенежныеСредства";
		
		НаборЗаписейДС = База.РегистрыНакопления.ДенежныеСредства.СоздатьНаборЗаписей();	
		НаборЗаписейДС.Отбор.Регистратор.Установить(Операция.Ссылка);
		
		Запись = НаборЗаписейДС.ДобавитьРасход();
		Запись.Период = ТекДокумент.Дата;
		Запись.Валюта = Валюта;
		Запись.Мандат = Мандат;
		Запись.СчетМандата = СчетМандата;
		//Запись.СтатьяДДС = ;
		Запись.Сумма = ТекДокумент.СуммаДокумента;
		
		НаборЗаписейДС.Записать(Ложь);
	КонецЦикла;
КонецФункции

