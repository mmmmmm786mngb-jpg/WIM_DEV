	МассивФайлов = ЗапросОтменаПлатежаНРДНаСервере(Элементы.ВыпискиКВыгрузке.ТекущиеДанные.КлючВыписки, Элементы.ВыпискиКВыгрузке.ТекущиеДанные.ДоговорДУ, Элементы.ВыпискиКВыгрузке.ТекущиеДанные.БанковскийСчет);
	СохранитьМассивФайловНаКлиенте(МассивФайлов); 
	
КонецПроцедуры


&НаКлиенте
Процедура ПечатьПП(Команда)
	
	масПП = новый Массив;
	
	фильтр = новый Структура("Выгружать", Истина);
	Если Элементы.ДокументыКВыгрузке.ОтборСтрок.Свойство("КлючВыписки") Тогда
		фильтр.Вставить("КлючВыписки", Элементы.ДокументыКВыгрузке.ОтборСтрок.КлючВыписки);
	Иначе
		Возврат;
	КонецЕсли;
	мас = Объект.ДокументыКВыгрузке.НайтиСтроки(фильтр);
	Для каждого СтрокаПП Из мас Цикл //Объект.ДокументыКВыгрузке
		масПП.Добавить(СтрокаПП.Документ);
	КонецЦикла;
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.ПлатежноеПоручение", "ПлатежноеПоручение", масПП, ЭтаФорма, Неопределено)
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусВыгружено(ПП_Ссылка)
	
	РегистрыСведений.ИсторияСтатусовОбъектов.СохранитьТекущийСтатусОбъекта(ПП_Ссылка, Перечисления.СтатусыОбъектов.Выгружено);
	
КонецПроцедуры


&НаСервере
Процедура УстановитьСтатусОшибочноВыгруженНаСервере(КлючВыписки)
	
	Модуль = РеквизитФормыВЗначение("Объект"); 
	ПлатежкиКВыгрузке = Модуль.ФильтрПлатежей(Объект.ДокументыКВыгрузке.Выгрузить(Новый Структура("КлючВыписки, Выгружать, Статус", КлючВыписки, Истина, Перечисления.СтатусыОбъектов.Выгружено)), 0);
	
	Для Каждого СтрокаПлатеж ИЗ ПлатежкиКВыгрузке Цикл
		РегистрыСведений.ИсторияСтатусовОбъектов.СохранитьТекущийСтатусОбъекта(СтрокаПлатеж.Документ, Перечисления.СтатусыОбъектов.ОшибочноВыгружено);
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьСтатусОшибочноВыгружен(Команда)
	
	УстановитьСтатусОшибочноВыгруженНаСервере(Элементы.ВыпискиКВыгрузке.ТекущиеДанные.КлючВыписки);
	ОбновитьСписокДокументовКВыгрузкеНаКлиенте();
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьФлажкиПоЗначениюСтатуса(Команда)
	ВыделитьСтатус = Элементы.ДокументыКВыгрузке.ТекущиеДанные.Статус;	
	//Сообщить(ЗначениеАктивнойЯчейки);
	Для каждого Платежка из Объект.ДокументыКВыгрузке Цикл
		Если Платежка.Статус = ВыделитьСтатус Тогда
			Платежка.Выгружать = Истина;
		КонецЕсли;
	Конеццикла;
КонецПроцедуры

&НаКлиенте
Процедура РазобратьРеестрыПоРозничномуДУ(Команда)
	
	ПараметрыДляФормы = Новый Структура;
	ЗаполнитьПлатежкиРДУНаСервере(ПараметрыДляФормы);
	
	ОткрытьФорму("ВнешняяОбработка.ЗагрузкаВыписок.Форма.ФормаРДУ", ПараметрыДляФормы);
	
КонецПроцедуры      


&НаСервере
Процедура ЗаполнитьПлатежкиРДУНаСервере(ПараметрыДляФормы)

	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.ЗаполнитьДанныеПоРозничномуДУ();	
	ЗначениеВРеквизитФормы(ТекОбъект,"Объект");  
	
	ПараметрыДляФормы.Вставить("ДатаНачала", Объект.ДатаНачала);	
	ПараметрыДляФормы.Вставить("ДатаОкончания", Объект.ДатаОкончания); 
	Адрес = ПоместитьВоВременноеХранилище(Объект.ПлатежныеДокументы_РДУ.Выгрузить());
	ПараметрыДляФормы.Вставить("ПлатежныеДокументы_РДУ", Адрес);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗачисленияНаРСРозничногоДУ(Команда) 

	Результат = ЗачисленияНаРСРозничногоДУНаСервере(); 
	Если ЗначениеЗаполнено(Результат.ИмяОбработки) Тогда
		НоваяФорма = ОткрытьФорму("ВнешняяОбработка."+Результат.ИмяОбработки+".Форма.Форма", Результат.Параметры);
		
		НоваяФорма.Элементы.ФормаНачислить.Доступность = Ложь;
		Для Каждого ТекСтрока ИЗ Объект.ПорученияПоДС_РДУ Цикл 
			НоваяСтрока = НоваяФорма.Объект.ПорученияПоДС.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
		
		Для Каждого ТекСтрока ИЗ Объект.ПорученияПоДСВвод_РДУ Цикл 
			НоваяСтрока = НоваяФорма.Объект.ПорученияПоДСВвод.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
	
	КонецЕсли;
	
	Если Результат.ТекстСообщения <> "" Тогда 
		Сообщить(Результат.ТекстСообщения);	
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Функция ЗачисленияНаРСРозничногоДУНаСервере()

	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ТекОбъект.ЗачисленияНаРСРозничногоДУ();
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
	Возврат Результат;

КонецФункции 
