	ОбработкаОбъект.ДОДоговорыДУКРасторжению();
	ОбработкаОбъект.ОбработкаДоговоровКРасторжению();
	
	//ОбработкаОбъект.СформироватьИОтправитьПисьмо("Перевод", ОписаниеОшибки);
