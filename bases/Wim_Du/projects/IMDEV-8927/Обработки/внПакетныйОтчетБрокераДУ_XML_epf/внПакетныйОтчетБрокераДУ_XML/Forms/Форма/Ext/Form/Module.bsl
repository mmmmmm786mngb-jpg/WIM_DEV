&НаКлиенте
Процедура СоздатьОбъекты(Команда)
	СоздатьОбъектыСервер();
КонецПроцедуры

&НаСервере
Процедура СоздатьОбъектыСервер()
	
	Для каждого Х Из Объект.ОперацииДляСоздания Цикл
		
		Если Не ЗначениеЗаполнено(Х.Дата) Или
			 Не ЗначениеЗаполнено(Х.ДоговорДУ) Или
			 Не ЗначениеЗаполнено(Х.Контрагент) Или
			 Не ЗначениеЗаполнено(Х.ДоговорКонтрагента) Или
			 Не ЗначениеЗаполнено(Х.АналитическийСчетБрокера) Или
			 Не ЗначениеЗаполнено(Х.Облигация) Или
			 Не ЗначениеЗаполнено(Х.ВалютаДокумента) Или
			 Не ЗначениеЗаполнено(Х.СуммаДокумента) Тогда
			Сообщить("Не заполнены необходимые параметры для строки " + Строка(Х.НомерСтроки));
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Х.ДокументОснование) Тогда
			Сообщить("Не найден документ ""Погашение НКД"" для строки " + Строка(Х.НомерСтроки));
			Продолжить;
			
			НовДок = Документы.ПереводНКДВЗадолженностьЭмитента.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(НовДок,Х);
			НовДок.УУ = Истина;
			НовДок.БУ = Истина;
			НовДок.ЗаполнитьКупоннымиПериодами();
			НовДок.Записать(РежимЗаписиДокумента.Проведение);
			Сообщить("Создан документ ""Погашение НКД"" для строки " + Строка(Х.НомерСтроки));
			НайтиПогашениеНКД(Х);
			Если Не ЗначениеЗаполнено(Х.ДокументОснование) Тогда
				Сообщить("Расхождение в сумме документа в ""Погашение НКД"" и ""Отчет Брокера"" для строки " + Строка(Х.НомерСтроки));
				Х.ДокументОснование = НовДок.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		НовДок = Документы.ОперацияПоСчетуБрокера.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(НовДок,Х);
		НовДок.ВидОперации = Перечисления.ВидыОперацийПоСчетуБрокера.Зачисление;
		НовДок.БУ = Истина;
		НовДок.ВУ = Истина;
		НовДок.УУ = Истина;
		НовДок.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Расчеты по НКД");
		НовДок.СтатьяЗатрат = Справочники.СтатьиДоходовИРасходов.НайтиПоНаименованию("Расчеты по НКД");
		Т = РаботаСКурсамиВалют.ПолучитьКурсВалюты(НовДок.ВалютаДокумента,НовДок.Дата);
		НовДок.КурсВзаиморасчетов = Т.Курс;
		НовДок.КурсКорреспондента = Т.Курс;
		НовДок.КратностьВзаиморасчетов = Т.Кратность;
		НовДок.КратностьКорреспондента = Т.Кратность;
		НовДок.СуммаДокументаРуб = Окр(НовДок.СуммаДокумента * НовДок.КурсВзаиморасчетов,2);
		НовДок.КоррСчет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.04.2.1");
		НовДок.Корреспондент = Х.Облигация.Эмитент;
		НовДок.СубконтоКоррСчета1 = Х.Облигация.Эмитент;
		НовДок.СубконтоКоррСчета2 = Х.Облигация;
		НовДок.СубконтоКоррСчета3 = Х.КупонныйПериод;
		НовДок.СуммаКорреспондента = НовДок.СуммаДокумента;
		НовДок.ВалютаКорреспондента = НовДок.ВалютаДокумента;
		НовДок.СтатьяЗатратКорреспондента = НовДок.СтатьяЗатрат;
		
		НовДок.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("Создан документ ""Отчет Брокера"" для строки " + Строка(Х.НомерСтроки));
		Х.ОперацияПоСчетуБрокера = НовДок.Ссылка;
		
	КонецЦикла;
	
КонецПроцедуры // СоздатьОбъектыСервер()

