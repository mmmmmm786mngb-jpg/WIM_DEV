///////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ФайлИлиКаталогПриИзменении(Элемент)
	ВидимостьФайлИлиКаталог();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВидимостьФайлИлиКаталог();
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьФайлИлиКаталог()
	ЭтотОбъект.Элементы.ИмяФайла.Видимость = Объект.ФайлИлиКаталог;
	ЭтотОбъект.Элементы.КаталогФайлов.Видимость = Не Объект.ФайлИлиКаталог;
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбора.Заголовок                   = "Выберите файл для загрузки данных";
	ДиалогВыбора.ПредварительныйПросмотр     = Ложь;
	ДиалогВыбора.ИндексФильтра               = 0;
	ДиалогВыбора.ПолноеИмяФайла              = Элемент.ТекстРедактирования;
	ДиалогВыбора.ПроверятьСуществованиеФайла = Ложь;
	
	ФорматФайла = "xml";
	
	Фильтр = НСтр("ru = 'Файлы " + ФорматФайла + "|*." + ФорматФайла + "'");
	ДиалогВыбора.Фильтр = Фильтр;	
	
	Если ДиалогВыбора.Выбрать() Тогда
		Объект.ИмяФайла = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.Каталог = Объект.КаталогФайлов;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = НСтр("ru = 'Выберите путь к каталогу файлов агентов'");
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		ИмяКаталога = ДиалогОткрытияФайла.Каталог;
		ИмяКаталога = ИмяКаталога + ФайловыеФункцииКлиентСервер.ПолучитьСлеш(ФайловыеФункцииКлиентПовтИсп.ТипПлатформыКлиента());
		Объект.КаталогФайлов = ИмяКаталога;
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура СчитатьФайл(Команда)
	
	Если Объект.ФайлИлиКаталог И Не ЗначениеЗаполнено(Объект.ИмяФайла) Тогда
		Сообщить("Не заполнено Имя файла");
		Возврат;
	КонецЕсли;
	Если Не Объект.ФайлИлиКаталог И Не ЗначениеЗаполнено(Объект.КаталогФайлов) Тогда
		Сообщить("Не заполнен Каталог файлов");
		Возврат;
	КонецЕсли;
	
	Объект.БумагиИзФайла.Очистить();
	Объект.КупоныИзФайла.Очистить();
	Объект.ОперацииДляСоздания.Очистить();
	
	Если Не Объект.ФайлИлиКаталог Тогда 
		МассивФайлов = НайтиФайлы(Объект.КаталогФайлов, "*.xml", Ложь);
	Иначе
		МассивФайлов = Новый Массив;
		МассивФайлов.Добавить(Объект.ИмяФайла);
	КонецЕсли;
	
	Для Каждого ТекФайл ИЗ МассивФайлов Цикл
		Если ТипЗнч(ТекФайл) = Тип("Файл") Тогда 
			ТекФайлИмя = ТекФайл.ПолноеИмя;
		Иначе
			ТекФайлИмя = ТекФайл;
		КонецЕсли;
			
		АдресФайлаНаСервере = "";
		Отказ = Ложь;
		Попытка
			ПоместитьФайл(АдресФайлаНаСервере, ТекФайлИмя, , Ложь, УникальныйИдентификатор);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось прочитать файл " + ТекФайлИмя + "! Проверьте правильность пути к файлу.", , , ,Отказ);
		КонецПопытки;
		Если НЕ Отказ Тогда
			СчитатьФайлСервер(АдресФайлаНаСервере);	
		КонецЕсли;
	КонецЦикла;	
	
	СоздатьОперацииДляСоздания();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Версия = ТекОбъект.СведенияОВнешнейОбработке().Версия;
	Заголовок = "v." + Версия;

КонецПроцедуры

&НаСервере
Процедура СчитатьФайлСервер(АдресФайлаНаСервере)
	
	УникальноеИмяФайла = Новый УникальныйИдентификатор;	
	ИмяФайлаНаСервере = КаталогВременныхФайлов() + УникальноеИмяФайла + ".xml";	
	ФайлДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаНаСервере);
	ФайлДвоичныеДанные.Записать(ИмяФайлаНаСервере);
	
	ЕстьБлок1 = Ложь;
	ЕстьСтрока1 = Ложь;
	ЕстьБлок21 = Ложь;
	ЕстьБлок22 = Ложь;
	ЕстьСтрока2 = Ложь;
	
	Account1 = "";
	Account2 = "";
	Currency = "";
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайлаНаСервере);	
	Пока ЧтениеXML.Прочитать() Цикл
		
		//	БамагиИзФайла
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Securities" Тогда
			ЕстьБлок1 = Истина;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "Securities" Тогда
			ЕстьБлок1 = Ложь;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Account" И ЕстьБлок1 Тогда
			ЧтениеXML.Прочитать();
			Account1 = ЧтениеXML.Значение;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "SecuritiesHoldings" И ЕстьБлок1 Тогда
			НовСтр1 = Объект.БумагиИзФайла.Добавить();
			НовСтр1.ИмяФайла = ИмяФайлаНаСервере;
			НовСтр1.Account = Account1;
			ЕстьСтрока1 = Истина;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "SecuritiesHoldings" И ЕстьБлок1 Тогда
			ЕстьСтрока1 = Ложь;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Security" И ЕстьСтрока1 Тогда
			ЧтениеXML.Прочитать();
			НовСтр1.Security = ЧтениеXML.Значение;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "ISIN" И ЕстьСтрока1 Тогда
			ЧтениеXML.Прочитать();
			НовСтр1.ISIN = ЧтениеXML.Значение;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "StateRegNo" И ЕстьСтрока1 Тогда
			ЧтениеXML.Прочитать();
			НовСтр1.StateRegNo = ЧтениеXML.Значение;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "OpeningBalance" И ЕстьСтрока1 Тогда
			ЧтениеXML.Прочитать();
			НовСтр1.OpeningBalance = ЧтениеXML.Значение;
		КонецЕсли;
		
		//	КупоныИзФайла
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Cash" Тогда
			ЕстьБлок21 = Истина;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "Cash" Тогда
			ЕстьБлок21 = Ложь;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Account" И ЕстьБлок21 Тогда
			ЧтениеXML.Прочитать();
			Account2 = ЧтениеXML.Значение;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Currency" И ЕстьБлок21 Тогда
			ЧтениеXML.Прочитать();
			Currency = ЧтениеXML.Значение;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Movements" И ЕстьБлок21 Тогда
			ЕстьБлок22 = Истина;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "Movements" И ЕстьБлок21 Тогда
			ЕстьБлок22 = Ложь;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "CashTransactions" И ЕстьБлок22 Тогда
			НовСтр2 = Объект.КупоныИзФайла.Добавить();
			НовСтр2.ИмяФайла = ИмяФайлаНаСервере;
			НовСтр2.Account = Account2;
			НовСтр2.Currency = Currency;
			ЕстьСтрока2 = Истина;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "CashTransactions" И ЕстьБлок22 Тогда
			ЕстьСтрока2 = Ложь;
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "TransactionNo" И ЕстьСтрока2 Тогда
			ЧтениеXML.Прочитать();
			НовСтр2.TransactionNo = ЧтениеXML.Значение;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "RealPaymentDT" И ЕстьСтрока2 Тогда
			ЧтениеXML.Прочитать();
			НовСтр2.RealPaymentDT = ПреобразоватьСтрокуВДату(ЧтениеXML.Значение);
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Security" И ЕстьСтрока2 Тогда
			ЧтениеXML.Прочитать();
			НовСтр2.Security = ЧтениеXML.Значение;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Quantity" И ЕстьСтрока2 Тогда
			ЧтениеXML.Прочитать();
			НовСтр2.Quantity = ЧтениеXML.Значение;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "TransactionType" И ЕстьСтрока2 Тогда
			ЧтениеXML.Прочитать();
			НовСтр2.TransactionType = ЧтениеXML.Значение;
		КонецЕсли;
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Amount" И ЕстьСтрока2 Тогда
			ЧтениеXML.Прочитать();
			НовСтр2.Amount = ПреобразоватьСтрокуВЧисло(ЧтениеXML.Значение);
		КонецЕсли;
		
	КонецЦикла;
	ЧтениеXML.Закрыть();
//	ТорговыйКод = ЧтениеXML.ПолучитьАтрибут("Account");
    
КонецПроцедуры // СчитатьФайлСервер()

