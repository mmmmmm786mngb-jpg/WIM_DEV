&НаСервереБезКонтекста
Функция ПреобразоватьСтрокуВДату(ДатаВремяСтрока)
	
	ДатаСтрока = Лев(ДатаВремяСтрока, 10);
	ВремяСтрока = Прав(ДатаВремяСтрока, 8);
	ПреобразованнаяДата = '00010101';
	
	Если ЗначениеЗаполнено(ДатаСтрока) Тогда
		ПреобразованнаяДата = Дата(Прав(ДатаСтрока, 4) + Сред(ДатаСтрока, 4, 2) + Лев(ДатаСтрока, 2));
//		ПреобразованнаяДата = Дата(Прав(ДатаСтрока, 4) + Сред(ДатаСтрока, 4, 2) + Лев(ДатаСтрока, 2) + Лев(ВремяСтрока, 2) + Сред(ВремяСтрока,4, 2) + Прав(ВремяСтрока, 2));
	КонецЕсли;	
	
	Возврат ПреобразованнаяДата;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПреобразоватьСтрокуВЧисло(ЧислоСтрока)
	
	Рез = ЧислоСтрока;
	Рез = СтрЗаменить(Рез,",","");
	Рез = СтрЗаменить(Рез," ","");
	Рез = СтрЗаменить(Рез,"+","");
	
	Возврат Число(Рез);
	
КонецФункции

