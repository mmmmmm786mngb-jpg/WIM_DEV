&НаСервере
Процедура СоздатьОперацииДляСоздания()
	
	Для Каждого Х Из Объект.КупоныИзФайла Цикл
		Если Не Найти(ВРег(Х.TransactionType),ВРег("Выплата купона")) И Не Найти(ВРег(Х.TransactionType),ВРег("Coupon payment")) Тогда Продолжить; КонецЕсли;
		НовСтр = Объект.ОперацииДляСоздания.Добавить();
		НовСтр.ИмяФайла = Х.ИмяФайла;
		ЗаполнитьЗначенияСвойств(НовСтр,НайтиОблигацию(Х.Security,Х.ИмяФайла));
		НовСтр.БрокерскийСчет = Х.Account;
		НовСтр.ВалютаДокумента = Справочники.Валюты.НайтиПоНаименованию(Х.Currency);
		НовСтр.СуммаДокумента = Х.Amount;
		НовСтр.Дата = Х.RealPaymentDT + 9*60*60;
		ЗаполнитьЗначенияСвойств(НовСтр,НайтиТорговыйКод(НовСтр.БрокерскийСчет,НовСтр.ДепоСчет));
		НайтиПогашениеНКД(НовСтр);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиОблигацию(Security,ИмяФайла)
	Рез = Новый Структура();
	Рез.Вставить("Облигация", Справочники.Облигации.ПустаяСсылка());
	Рез.Вставить("ДепоСчет", "яяяяя");
	
	Стр = Security;
	Х = Найти(Стр,"/");
	Если Х Тогда Стр = Лев(Стр,Х-1); КонецЕсли; 
	Х = Найти(Стр,",");
	Если Х Тогда Стр = Лев(Стр,Х-1); КонецЕсли; 
	Стр = СтрЗаменить(Стр,".","");
	Стр = СтрЗаменить(Стр," ","");
	
	Для Каждого Х Из Объект.БумагиИзФайла Цикл
		Если Найти(СтрЗаменить(СтрЗаменить(Х.Security,".","")," ",""),Стр) И Х.ИмяФайла = ИмяФайла Тогда
			Рез.ДепоСчет = Х.Account;
			Рез.Облигация = Справочники.Облигации.ОблигацияПоISIN(Х.ISIN);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Рез.Облигация = Справочники.Облигации.ПустаяСсылка() Тогда
		Сообщить("Не определена Облигация");
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

&НаСервере
Функция НайтиТорговыйКод(БрокерскийСчет,ДепоСчет)
	Рез = Новый Структура();
	Рез.Вставить("ДоговорДУ", Справочники.ДоговорДУ.ПустаяСсылка());
	Рез.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Рез.Вставить("ДоговорКонтрагента", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Рез.Вставить("АналитическийСчетБрокера", Справочники.АналитическиеСчета.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	     "ВЫБРАТЬ
	     |	ТорговыеКоды.ДоговорДУ КАК ДоговорДУ,
	     |	ТорговыеКоды.Брокер КАК Контрагент,
	     |	ТорговыеКоды.ДоговорБрокера КАК ДоговорКонтрагента,
	     |	ТорговыеКоды.АналитическийСчетДС КАК АналитическийСчетБрокера,
	     |	10 КАК Порядок
	     |ИЗ
	     |	Справочник.ТорговыеКоды КАК ТорговыеКоды
	     |ГДЕ
	     |	ТорговыеКоды.ТорговыйКод ПОДОБНО ""%"" + &ТорговыйКод + ""%""
	     |	И НЕ ТорговыеКоды.ПометкаУдаления
	     |
	     |ОБЪЕДИНИТЬ ВСЕ
	     |
	     |ВЫБРАТЬ
	     |	АналитическиеСчета.ДоговорДУ,
	     |	АналитическиеСчета.СубъектМестаХранения,
	     |	АналитическиеСчета.ДоговорКонтрагента,
	     |	АналитическиеСчета.Ссылка,
	     |	20
	     |ИЗ
	     |	Справочник.АналитическиеСчета КАК АналитическиеСчета
	     |ГДЕ
	     |	АналитическиеСчета.НомерСчета ПОДОБНО ""%"" + &НомерДоговора + ""%""
	     |	И НЕ АналитическиеСчета.ПометкаУдаления
	     |
	     |УПОРЯДОЧИТЬ ПО
	     |	Порядок";
	Запрос.УстановитьПараметр("ТорговыйКод",ДепоСчет);	 
	Запрос.УстановитьПараметр("НомерДоговора",БрокерскийСчет);	 
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Рез,ВыборкаДетальныеЗаписи);
		Прервать;
	КонецЦикла;
	
	Если Рез.ДоговорДУ = Справочники.ДоговорДУ.ПустаяСсылка() Тогда
		Сообщить("Не определен ДоговорДУ");
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

&НаСервере
Процедура НайтиПогашениеНКД(НовСтр)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	     "ВЫБРАТЬ
	     |	НачисленныйКупонныйДоходУправленческий.Регистратор КАК ДокументОснование,
	     |	НачисленныйКупонныйДоходУправленческий.КупонныйПериод КАК КупонныйПериод,
	     |	НачисленныйКупонныйДоходУправленческий.Сумма КАК СуммаДокументаРуб
	     |ИЗ
	     |	РегистрНакопления.НачисленныйКупонныйДоходУправленческий КАК НачисленныйКупонныйДоходУправленческий
	     |ГДЕ
	     |	НачисленныйКупонныйДоходУправленческий.ДоговорДУ = &ДоговорДУ
	     |	И НачисленныйКупонныйДоходУправленческий.Облигация = &Облигация
	     |	И НачисленныйКупонныйДоходУправленческий.Период >= &Период1
	     |	И НачисленныйКупонныйДоходУправленческий.Период <= &Период2
	     |	И НачисленныйКупонныйДоходУправленческий.Валюта = &Валюта
	     |	И НачисленныйКупонныйДоходУправленческий.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента";
	Запрос.УстановитьПараметр("ДоговорДУ",НовСтр.ДоговорДУ);
	Запрос.УстановитьПараметр("Облигация",НовСтр.Облигация);
	Запрос.УстановитьПараметр("Период1",ДобавитьМесяц(НовСтр.Дата,-1));
	Запрос.УстановитьПараметр("Период2",НовСтр.Дата);
	Запрос.УстановитьПараметр("Валюта",НовСтр.ВалютаДокумента);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(НовСтр,ВыборкаДетальныеЗаписи);
	КонецЦикла;

КонецПроцедуры

