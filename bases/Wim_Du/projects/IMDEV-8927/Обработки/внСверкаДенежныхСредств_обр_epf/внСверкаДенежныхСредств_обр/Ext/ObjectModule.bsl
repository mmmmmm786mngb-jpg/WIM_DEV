Перем Макет;
Перем ПредставлениеНастроек;

Функция ВыполнитьСверку() Экспорт
	ТЗ = ПодготовитьТаблицу();
	
	Если СтрДлина(СтатусОшибки) = 0 Тогда
		ТабДок = ЗаполнитьМакет(ТЗ);
		Возврат ТабДок;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции 

Функция ЗаполнитьМакет(ТЗ)
	Отчет.Очистить();
	Отчет.ТолькоПросмотр =  ИСТИНА;
	
	Макет = ПолучитьМакет("Макет");
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Период = "Период с " + Формат(НачДата, "ДФ=dd.MM.yyyy") + " по " + Формат(КонДата, "ДФ=dd.MM.yyyy");
	Отчет.Вывести(Область);
	
	Статус = ЛОЖЬ;
	
	ТекВид = Неопределено;
	
	Для Каждого текСтр ИЗ ТЗ Цикл
		Если текСтр.вхБУ = 0 И текСтр.исхБУ = 0 и текСтр.вхВУ = 0 И текСтр.исхВУ = 0 И текСтр.вхУУ = 0 И текСтр.исхУУ = 0 И текСтр.вхВып = 0 И текСтр.исхВып = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ОтображатьВсе Тогда
			Если текСтр.Разница = "-" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если текСтр.ТипКлиентаДУ <> ТекВид Тогда
			текВид = текСтр.ТипКлиентаДУ;
			Область = Макет.ПолучитьОбласть("ТипДоговораДУ");
			Область.Параметры.ТипДоговораДУ = текВид;
			Отчет.Вывести(Область);
		КонецЕсли;
		
		Если текСтр.Разница = "Есть расхождения" Тогда
			Статус = ИСТИНА;
			Если текСтр.Счет.ДоговорДУ = Справочники.ДоговорДУ.ПустаяСсылка() Тогда 
				Область = Макет.ПолучитьОбласть("СтрокаЕРС");
			Иначе 
				Область = Макет.ПолучитьОбласть("СтрокаПодсв");
			КонецЕсли;
		Иначе
			Область = Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.Заполнить(текСтр);
		
		Отчет.Вывести(Область)
	КонецЦикла;
	
	Возврат Отчет;
КонецФункции

Функция ПодготовитьТаблицу()
	
	Запрос = Новый Запрос();
	Запрос.Текст = ПолучитьТекстЗапроса();
	Запрос.УстановитьПараметр("ДоговорИсключение", ДоговорИсключение); //IMAPPS-20859
	Запрос.УстановитьПараметр("СчетИсключение", СчетИсключение); // IMAPPS-25493
	
	// 07.06.2018 DDneprovsky IMAPPS-6388 {
	ВладелецЕРС = РегистрыСведений.УниверсальныеСопоставления.ПрочитатьПрямоеСопоставление(Перечисления.КонтекстСопоставления.ДоговорДУ, Справочники.Контрагенты.ПустаяСсылка(), "Контрагент_Банк_ВТБ_ПАО", Ложь);
	БанкВКоторомОткрытЕРС = РегистрыСведений.УниверсальныеСопоставления.ПрочитатьПрямоеСопоставление(Перечисления.КонтекстСопоставления.ДоговорДУ, Справочники.Банки.ПустаяСсылка(), "Банк_ВТБ_ПАО", Ложь);
	Запрос.УстановитьПараметр("ВладелецЕРС", ВладелецЕРС);
	Запрос.УстановитьПараметр("БанкВКоторомОткрытЕРС", БанкВКоторомОткрытЕРС);
	// } 07.06.2018 DDneprovsky IMAPPS-6388
	Запрос.УстановитьПараметр("НачГраница", Новый Граница(НачалоДня(НачДата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонГраница", Новый Граница(КонецДня(КонДата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонДата",КонецДня(КонДата));
	тзВнутренние = Запрос.Выполнить().Выгрузить();
	
	// Соединим внешние и внутренние данные
	тзВнешние = ПолучитьДанныеПоВыпискам();
	
	Если ТипЗнч(тзВнешние) = Тип("Строка") Тогда
		СтатусОшибки = тзВнешние;
		Возврат 0;
	КонецЕсли;
	
	Для Каждого ВнешСтр Из тзВнешние Цикл
		ВнутрСтр = тзВнутренние.Добавить();
		ВнутрСтр.ДоговорДУ = ВнешСтр.ДоговорДУ;
		ВнутрСтр.ТипКлиентаДУ = ВнешСтр.ДоговорДУ.ТипКлиентаДУ;
		ВнутрСтр.Валюта = ВнешСтр.Счет.ВалютаДенежныхСредств;
		ВнутрСтр.Счет = ВнешСтр.Счет;
		ВнутрСтр.вхВып = ВнешСтр.начОст;
		ВнутрСтр.исхВып = ВнешСтр.конОст;
	КонецЦикла;
	
	тзВнутренние.Свернуть("ДоговорДУ, Счет, Валюта, ТипКлиентаДУ", "вхБУ,исхБУ,вхВУ,исхВУ,вхУУ,исхУУ,вхВып,исхВып");
	тзВнутренние.Сортировать("ТипКлиентаДУ, ДоговорДУ, Счет");	
	
	// Проставим разницу
	// IMAPPS-25536{  попросили отключить рублевую сумму по валютным счетам 
	// Если КалендарныеГрафики.ПолучитьПоследнийРабочийДень(,КонецМесяца(НачДата)) = НачДата Тогда
	//	флОтображатьРубли = ИСТИНА;
	// Иначе
		флОтображатьРубли = ЛОЖЬ;
	// КонецЕсли;
	// }IMAPPS-25536
	тзВнутренние.Колонки.Добавить("Разница"); 
	РазмерТаблицы = -(тзВнутренние.Количество() - 1);
	Для Сч = РазмерТаблицы По 0 Цикл
		ТекСтр = тзВнутренние.Получить(-Сч);
		
		Если (ТекСтр.вхБУ - ТекСтр.вхВУ) <> 0 ИЛИ (ТекСтр.вхБУ - ТекСтр.вхУУ) <> 0 ИЛИ (ТекСтр.вхБУ - ТекСтр.вхВып) <> 0 ИЛИ (ТекСтр.вхВУ - ТекСтр.вхУУ) <> 0 ИЛИ (ТекСтр.вхВУ - ТекСтр.вхВып) <> 0 ИЛИ (ТекСтр.вхУУ - ТекСтр.вхВып) <> 0 ИЛИ
			 (ТекСтр.исхБУ - ТекСтр.исхВУ) <> 0 ИЛИ (ТекСтр.исхБУ - ТекСтр.исхУУ) <> 0 ИЛИ (ТекСтр.исхБУ - ТекСтр.исхВып) <> 0 ИЛИ (ТекСтр.исхВУ - ТекСтр.исхУУ) <> 0 ИЛИ (ТекСтр.исхВУ - ТекСтр.исхВып) <> 0 ИЛИ (ТекСтр.исхУУ - ТекСтр.исхВып) <> 0 Тогда
			текСтр.Разница = "Есть расхождения";
			
		Иначе
			текСтр.Разница = "-";
		КонецЕсли;
		
		// Если это не конец месяца, то рублевую сумму по валютным счетам не отражаем
		
		Если НЕ флОтображатьРубли Тогда
			Если (ТекСтр.Счет.ВалютаДенежныхСредств <> Справочники.Валюты.RUB) И (ТекСтр.Валюта = Справочники.Валюты.RUB) Тогда
				тзВнутренние.Удалить(-Сч);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат тзВнутренние;
КонецФункции

