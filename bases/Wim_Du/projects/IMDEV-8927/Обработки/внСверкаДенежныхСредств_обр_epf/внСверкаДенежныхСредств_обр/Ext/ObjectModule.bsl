	               |				ИЛИ БанковскиеСчета.Владелец <> &ВладелецЕРС
	               |				ИЛИ БанковскиеСчета.Банк <> &БанкВКоторомОткрытЕРС
	               |				ИЛИ БанковскиеСчета.ДоговорДУ <> ЗНАЧЕНИЕ(Справочник.ДоговорДУ.ПустаяСсылка))
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорДУ КАК ДоговорыДУ
	               |		ПО ВременнаяОстатки.ДоговорДУ = ДоговорыДУ.Ссылка
	               |			И (НЕ ДоговорыДУ.ПометкаУдаления)
				// IMAPPS-25536{  
				// |			И (ДоговорыДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	            // |				ИЛИ ДоговорыДУ.ДатаОкончания >= &КонДата
	            // |				ИЛИ ДоговорыДУ.ДатаНачала = ДоговорыДУ.ДатаОкончания)
				// }IMAPPS-25536   
				   |ГДЕ НЕ ВременнаяОстатки.Счет В (&СчетИсключение) // IMAPPS-25493
	               |СГРУППИРОВАТЬ ПО
	               |	ДоговорыДУ.ТипКлиентаДУ,
	               |	ВременнаяОстатки.ДоговорДУ,
	               |	ВременнаяОстатки.Счет,
	               |	ЕСТЬNULL(ВременнаяОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.RUB))";
	               
	Возврат ТекстЗапроса;           
