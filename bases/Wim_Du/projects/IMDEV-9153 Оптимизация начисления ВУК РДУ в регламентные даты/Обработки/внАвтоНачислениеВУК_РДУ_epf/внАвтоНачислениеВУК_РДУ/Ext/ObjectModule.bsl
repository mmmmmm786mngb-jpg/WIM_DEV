// Описание: Возвращает сведения о внешней обработке для регистрации в подсистеме БСП
//           "Дополнительные отчеты и обработки".
//
// Возвращаемое значение:
//  Структура - параметры регистрации (Вид, Наименование, Версия, БезопасныйРежим, Команды)
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Новый Массив);
	ПараметрыРегистрации.Вставить("Наименование", "Авто-начисление ВУК РДУ в регламентные даты");
	ПараметрыРегистрации.Вставить("Версия", "1.0.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"IMDEV-9153. Автоматическое начисление вознаграждения УК по договорам розничного ДУ в регламентные даты.");

	ТаблицаКоманд = ПолучитьТаблицуКоманд();

	ДобавитьКоманду(
		ТаблицаКоманд,
		"Авто-начисление ВУК РДУ (фоновое выполнение)",
		"ФоновоеВыполнение",
		"ВызовСерверногоМетода");

	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Точка входа при вызове команды обработки из БСП (в т.ч. из регламентного задания).
//
// Параметры:
//  ИдентификаторКоманды - Строка - идентификатор вызываемой команды
//  ПараметрыВыполненияКоманды - Структура - параметры выполнения команды БСП
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьНастройки(ПараметрыВыполненияКоманды);
	ВыполнитьНачислениеВУК();

КонецПроцедуры

// Описание: Основной сценарий авто-начисления ВУК по договорам РДУ.
//
Процедура ВыполнитьНачислениеВУК() Экспорт

	ДатаЗапуска = ТекущаяДатаСеанса();
	ПрименитьЗначенияПоУмолчанию();

	Если Не ИгнорироватьПроверкуРегламентнойДаты
		И Не ЭтоРегламентнаяДатаЗапуска(ДатаЗапуска) Тогда
		Лог("Запуск не в регламентную дату (" + Формат(ДатаЗапуска, "ДЛФ=D") + "). Выход.",
			УровеньЖурналаРегистрации.Предупреждение);
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаПериодаПринудительно) Тогда
		ДатаПериода = КонецДня(ДатаПериодаПринудительно);
	Иначе
		ДатаПериода = КонецДня(НачалоМесяца(ДатаЗапуска) - 1);
	КонецЕсли;

	ГруппаОперацийСсылка = ПолучитьГруппуОпераций();
	Если Не ЗначениеЗаполнено(ГруппаОперацийСсылка) Тогда
		Лог("Не найдена группа операций '3.1 Вознаграждение за управление'.",
			УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;

	ВремяРеглОпераций = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаОперацийСсылка, "ВремяРеглОпераций");
	ВидОперацииУК = ПолучитьВидОперацииУК();

	РеглПериод = Справочники.РегламентныеПериоды.ПериодПоДате(ДатаПериода);
	Если РеглПериод.Пустая() Тогда
		Если СоздаватьПериодЕслиНет Тогда
			РеглПериод = СоздатьРегламентныйПериод(ДатаПериода);
		Иначе
			Лог("Регламентный период на " + Формат(ДатаПериода, "ДЛФ=D") + " не найден. Выход.",
				УровеньЖурналаРегистрации.Ошибка);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	СписокДоговоровДУ = ПолучитьСписокДоговоровРДУ(ДатаПериода);
	Если СписокДоговоровДУ.Количество() = 0 Тогда
		Лог("Нет договоров РДУ для начисления на " + Формат(ДатаПериода, "ДЛФ=D") + ".",
			УровеньЖурналаРегистрации.Предупреждение);
		Если ОтправлятьПисьмоОбИтогах Тогда
			ИтогиПустые = Новый Структура("Всего, Успешно, СОшибками, ТаблицаУспешных, ТаблицаОшибок",
				0, 0, 0, Новый ТаблицаЗначений, Новый ТаблицаЗначений);
			ОбработатьРезультат(
				Новый Структура("Успешно, Сообщение", Истина, "Нет договоров для обработки"),
				ДатаЗапуска, ДатаПериода, Новый Массив, ГруппаОперацийСсылка, ИтогиПустые);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ПараметрыСохранения = СформироватьПараметрыСохранения(
		СписокДоговоровДУ, ДатаПериода, ГруппаОперацийСсылка, ВидОперацииУК, ВремяРеглОпераций);

	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ДатаПериода", ДатаПериода);
	ПараметрыПроцедуры.Вставить("СписокДоговоровДУ", СписокДоговоровДУ);
	ПараметрыПроцедуры.Вставить("УчитыватьВыполненные", УчитыватьВыполненные);
	ПараметрыПроцедуры.Вставить("НаименованиеФоновогоЗадания",
		"ВУК РДУ авто " + Формат(ДатаПериода, "ДФ=yyyy.MM.dd"));
	ПараметрыПроцедуры.Вставить("ПараметрыСохранения", ПараметрыСохранения);

	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);

	Лог(СтрШаблон("Старт начисления ВУК РДУ. Период: %1, договоров: %2.",
		Формат(ДатаПериода, "ДЛФ=D"), СписокДоговоровДУ.Количество()),
		УровеньЖурналаРегистрации.Информация);

	Попытка
		Справочники.РегламентныеПериоды.СформироватьРегламентныеОперации(ПараметрыПроцедуры, АдресРезультата);
	Исключение
		Лог("Ошибка вызова СформироватьРегламентныеОперации: " + ОписаниеОшибки(),
			УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецПопытки;

	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	ОбработатьРезультат(Результат, ДатаЗапуска, ДатаПериода, СписокДоговоровДУ, ГруппаОперацийСсылка);

КонецПроцедуры

// Описание: Загружает пользовательские настройки обработки из параметров команды БСП / формы.
//
// Параметры:
//  ПараметрыВыполненияКоманды - Структура, Неопределено - параметры выполнения команды БСП
//
Процедура ЗагрузитьНастройки(ПараметрыВыполненияКоманды = Неопределено) Экспорт

	Если ТипЗнч(ПараметрыВыполненияКоманды) = Тип("Структура")
		И ПараметрыВыполненияКоманды.Свойство("ПараметрыДополнительнойОбработки") Тогда

		Настройки = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
		Если ТипЗнч(Настройки) = Тип("Структура") Тогда
			УстановитьПользовательскиеНастройки(Настройки);
		КонецЕсли;
	КонецЕсли;

	ПрименитьЗначенияПоУмолчанию();

КонецПроцедуры

// Описание: Заполняет реквизиты обработки из сохранённых настроек доп. обработки.
//
// Параметры:
//  Настройки - Структура - структура настроек (Значения или плоская)
//
Процедура УстановитьПользовательскиеНастройки(Настройки) Экспорт

	Значения = Настройки;
	Если ТипЗнч(Настройки) = Тип("Структура") И Настройки.Свойство("Значения") Тогда
		Значения = Настройки.Значения;
	КонецЕсли;

	Если ТипЗнч(Значения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Значения);

	Если Значения.Свойство("СписокРассылки") Тогда
		ЗагрузитьТЧ("СписокРассылки", Значения);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТаблицуКоманд()

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	Возврат Команды;

КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

Процедура ПрименитьЗначенияПоУмолчанию()

	Если Не ЗначениеЗаполнено(НаименованиеПула) Тогда
		НаименованиеПула = "Розничное ДУ";
	КонецЕсли;

	Если МаксСтрокВТелеПисьма = 0 Тогда
		МаксСтрокВТелеПисьма = 200;
	КонецЕсли;

	// Значение по умолчанию для флага создания периода — Истина при первом запуске без настроек.
	// Если реквизит уже сохранён как Ложь — не перезаписываем (проверяем через отсутствие настройки сложно),
	// поэтому явное значение задаётся формой настроек; здесь только страховка для пустого объекта.

КонецПроцедуры

// Описание: Заполняет реквизиты обработки типовыми значениями для РДУ / ВУК.
// Почта — по принятому в Wim_Du паттерну (системная УЗ + IMAppSupport).
//
Процедура ЗаполнитьНастройкиПоУмолчанию() Экспорт

	НаименованиеПула = "Розничное ДУ";
	ГруппаОпераций = НайтиГруппуОперацийВознаграждениеЗаУправление();
	ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.ВознаграждениеУК_БУ;
	УчитыватьВыполненные = Ложь;
	СоздаватьПериодЕслиНет = Истина;
	ИгнорироватьПроверкуРегламентнойДаты = Ложь;
	ДатаПериодаПринудительно = '00010101';
	МаксСтрокВТелеПисьма = 200;

	ОтправлятьПисьмоОбИтогах = Истина;
	ПочтовыйЛогин = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;

	СписокРассылки.Очистить();
	СтрокаРассылки = СписокРассылки.Добавить();
	СтрокаРассылки.Отправлять = Истина;
	СтрокаРассылки.ПочтовыйЯщик = "IMAppSupport@wiminvest.ru";
	СтрокаРассылки.Представление = "IMAppSupport@wiminvest.ru";

КонецПроцедуры

// Описание: Совместимое имя с другими внешними обработками Wim_Du.
//
Процедура НастройкиПоУмолчанию() Экспорт

	ЗаполнитьНастройкиПоУмолчанию();

КонецПроцедуры

Функция ЭтоРегламентнаяДатаЗапуска(ДатаЗапуска)

	Если День(ДатаЗапуска) <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	МесяцЗапуска = Месяц(ДатаЗапуска);
	Возврат МесяцЗапуска = 1 Или МесяцЗапуска = 4 Или МесяцЗапуска = 7 Или МесяцЗапуска = 10;

КонецФункции

Функция ПолучитьГруппуОпераций()

	Если ЗначениеЗаполнено(ГруппаОпераций) Тогда
		Возврат ГруппаОпераций;
	КонецЕсли;

	Возврат НайтиГруппуОперацийВознаграждениеЗаУправление();

КонецФункции

Функция НайтиГруппуОперацийВознаграждениеЗаУправление()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыОпераций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыОперацийЗакрытияПериода КАК ВидыОпераций
	|ГДЕ
	|	ВидыОпераций.ЭтоГруппа = ИСТИНА
	|	И ВидыОпераций.Наименование ПОДОБНО &Наименование
	|	И ВидыОпераций.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыОпераций.Наименование";
	Запрос.УстановитьПараметр("Наименование", "3.1%Вознаграждение за управление%");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// Запасной поиск без префикса 3.1 (на случай другого наименования в базе).
	Запрос.УстановитьПараметр("Наименование", "%Вознаграждение за управление%");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьВидОперацииУК()

	Если ЗначениеЗаполнено(ВидОперации) Тогда
		Возврат ВидОперации;
	КонецЕсли;

	Возврат Справочники.ВидыОперацийЗакрытияПериода.ВознаграждениеУК_БУ;

КонецФункции

Функция СоздатьРегламентныйПериод(ДатаПериода)

	НовыйЭлемент = Справочники.РегламентныеПериоды.СоздатьЭлемент();
	НовыйЭлемент.ДатаПериода = ДатаПериода;
	НовыйЭлемент.Записать();

	Лог("Создан регламентный период на " + Формат(ДатаПериода, "ДЛФ=D") + ".",
		УровеньЖурналаРегистрации.Информация);

	Возврат НовыйЭлемент.Ссылка;

КонецФункции

Функция ПолучитьСписокДоговоровРДУ(ДатаПериода)

	ПулСсылка = Справочники.Пул.НайтиПоНаименованию(НаименованиеПула);
	Если Не ЗначениеЗаполнено(ПулСсылка) Тогда
		Лог("Не найден пул по наименованию: " + НаименованиеПула, УровеньЖурналаРегистрации.Ошибка);
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорДУ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорДУ
	|ГДЕ
	|	ДоговорДУ.Пул = &Пул
	|	И ДоговорДУ.ПометкаУдаления = ЛОЖЬ
	|	И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) <= &ДатаПериода
	|	И (КОНЕЦПЕРИОДА(ДоговорДУ.ДатаОкончания, ДЕНЬ) >= &ДатаПериода
	|		ИЛИ ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))";
	Запрос.УстановитьПараметр("Пул", ПулСсылка);
	Запрос.УстановитьПараметр("ДатаПериода", ДатаПериода);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция СформироватьПараметрыСохранения(СписокДоговоровДУ, ДатаПериода, ГруппаОперацийСсылка, ВидОперацииУК, ВремяРеглОпераций)

	СписокОпераций = Новый ТаблицаЗначений;
	СписокОпераций.Колонки.Добавить("ДоговорДУ", Новый ОписаниеТипов("СправочникСсылка.ДоговорДУ"));
	СписокОпераций.Колонки.Добавить("ВидОперации", Новый ОписаниеТипов("СправочникСсылка.ВидыОперацийЗакрытияПериода"));
	СписокОпераций.Колонки.Добавить("Выполнять", Новый ОписаниеТипов("Булево"));
	СписокОпераций.Колонки.Добавить("ВремяРеглОпераций", Новый ОписаниеТипов("Дата"));
	СписокОпераций.Колонки.Добавить("ГруппаОперацийПользователя",
		Новый ОписаниеТипов("СправочникСсылка.ВидыОперацийЗакрытияПериода"));

	Для Каждого ДоговорДУ Из СписокДоговоровДУ Цикл
		Стр = СписокОпераций.Добавить();
		Стр.ДоговорДУ = ДоговорДУ;
		Стр.ВидОперации = ВидОперацииУК;
		Стр.Выполнять = Истина;
		Стр.ВремяРеглОпераций = ВремяРеглОпераций;
		Стр.ГруппаОперацийПользователя = ГруппаОперацийСсылка;
	КонецЦикла;

	СписокОпераций.Индексы.Добавить("ДоговорДУ");
	СписокОпераций.Индексы.Добавить("ДоговорДУ, ГруппаОперацийПользователя");

	ДокументыПоДоговорам = ПолучитьДокументыПоДоговорам(СписокДоговоровДУ, ДатаПериода, ГруппаОперацийСсылка);

	МассивРодителей = Новый Массив;
	МассивРодителей.Добавить(ГруппаОперацийСсылка);

	ПараметрыСохранения = Новый Структура;
	ПараметрыСохранения.Вставить("СписокОпераций", СписокОпераций);
	ПараметрыСохранения.Вставить("ДокументыПоДоговорам", ДокументыПоДоговорам);
	ПараметрыСохранения.Вставить("КоличествоПотоков",
		Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить());
	ПараметрыСохранения.Вставить("МассивРодителей", МассивРодителей);
	ПараметрыСохранения.Вставить("МассивФоновыхЗаданий", Новый Массив);

	Возврат ПараметрыСохранения;

КонецФункции

Функция ПолучитьДокументыПоДоговорам(СписокДоговоровДУ, ДатаПериода, ГруппаОперацийСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПланРО.ДоговорДУ КАК ДоговорДУ,
	|	ПланРО.Ссылка КАК Ссылка,
	|	ПланРО.Дата КАК Дата,
	|	ПланРО.ГруппаОперацийПользователя КАК ГруппаОперацийПользователя
	|ИЗ
	|	Документ.ПланРегламентныхОперацийДУ КАК ПланРО
	|ГДЕ
	|	ПланРО.ДоговорДУ В (&СписокДоговоровДУ)
	|	И ПланРО.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ПланРО.ГруппаОперацийПользователя = &ГруппаОпераций
	|	И ПланРО.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("СписокДоговоровДУ", СписокДоговоровДУ);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПериода));
	Запрос.УстановитьПараметр("ГруппаОпераций", ГруппаОперацийСсылка);

	ДокументыПоДоговорам = Запрос.Выполнить().Выгрузить();
	ДокументыПоДоговорам.Индексы.Добавить("ДоговорДУ, ГруппаОперацийПользователя");

	Возврат ДокументыПоДоговорам;

КонецФункции

Процедура ОбработатьРезультат(Результат, ДатаЗапуска, ДатаПериода, СписокДоговоровДУ, ГруппаОперацийСсылка, Итоги = Неопределено)

	Успешно = Ложь;
	Сообщение = "";
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("Успешно", Успешно);
		Результат.Свойство("Сообщение", Сообщение);
	КонецЕсли;

	Если Итоги = Неопределено Тогда
		Итоги = СобратьИтогиПоДоговорам(ДатаПериода, СписокДоговоровДУ, ГруппаОперацийСсылка);
	КонецЕсли;

	ТекстИтога = СтрШаблон(
		"Начисление ВУК РДУ за %1. Всего: %2, успешно: %3, с ошибками: %4. Успешно(метод): %5. %6",
		Формат(ДатаПериода, "ДЛФ=D"),
		Итоги.Всего,
		Итоги.Успешно,
		Итоги.СОшибками,
		?(Успешно, "Да", "Нет"),
		Сообщение);

	Лог(ТекстИтога, ?(Успешно И Итоги.СОшибками = 0,
		УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка));

	Если ОтправлятьПисьмоОбИтогах Тогда
		Если СписокРассылки.Количество() = 0 Тогда
			Лог("СписокРассылки пуст — письмо об итогах не отправлено.",
				УровеньЖурналаРегистрации.Предупреждение);
		Иначе
			Попытка
				СформироватьИОтправитьПисьмоОбИтогах(ДатаЗапуска, ДатаПериода, Результат, Итоги);
			Исключение
				Лог("Ошибка отправки письма об итогах: " + ОписаниеОшибки(),
					УровеньЖурналаРегистрации.Ошибка);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция СобратьИтогиПоДоговорам(ДатаПериода, СписокДоговоровДУ, ГруппаОперацийСсылка)

	ТаблицаУспешных = Новый ТаблицаЗначений;
	ТаблицаУспешных.Колонки.Добавить("ДоговорДУ");
	ТаблицаУспешных.Колонки.Добавить("План");
	ТаблицаУспешных.Колонки.Добавить("Начисление");
	ТаблицаУспешных.Колонки.Добавить("Сумма");

	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("ДоговорДУ");
	ТаблицаОшибок.Колонки.Добавить("ТекстОшибки");

	Итоги = Новый Структура;
	Итоги.Вставить("Всего", СписокДоговоровДУ.Количество());
	Итоги.Вставить("Успешно", 0);
	Итоги.Вставить("СОшибками", 0);
	Итоги.Вставить("ТаблицаУспешных", ТаблицаУспешных);
	Итоги.Вставить("ТаблицаОшибок", ТаблицаОшибок);

	Если СписокДоговоровДУ.Количество() = 0 Тогда
		Возврат Итоги;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПланРО.ДоговорДУ КАК ДоговорДУ,
	|	ПланРО.Ссылка КАК План,
	|	ПланРО.Проведен КАК ПланПроведен
	|ПОМЕСТИТЬ ВТ_Планы
	|ИЗ
	|	Документ.ПланРегламентныхОперацийДУ КАК ПланРО
	|ГДЕ
	|	ПланРО.ДоговорДУ В (&СписокДоговоровДУ)
	|	И ПланРО.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ПланРО.ГруппаОперацийПользователя = &ГруппаОпераций
	|	И ПланРО.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Начисление.ДоговорДУ КАК ДоговорДУ,
	|	Начисление.Ссылка КАК Начисление,
	|	Начисление.СуммаВознаграждения КАК Сумма,
	|	Начисление.Проведен КАК НачислениеПроведен
	|ПОМЕСТИТЬ ВТ_Начисления
	|ИЗ
	|	Документ.НачислениеВознаграждения КАК Начисление
	|ГДЕ
	|	Начисление.ДоговорДУ В (&СписокДоговоровДУ)
	|	И Начисление.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Начисление.ЗаУспех = ЛОЖЬ
	|	И Начисление.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Договоры.Ссылка КАК ДоговорДУ,
	|	Планы.План КАК План,
	|	Планы.ПланПроведен КАК ПланПроведен,
	|	Начисления.Начисление КАК Начисление,
	|	Начисления.Сумма КАК Сумма,
	|	Начисления.НачислениеПроведен КАК НачислениеПроведен
	|ИЗ
	|	Справочник.ДоговорДУ КАК Договоры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Планы КАК Планы
	|		ПО Договоры.Ссылка = Планы.ДоговорДУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Начисления КАК Начисления
	|		ПО Договоры.Ссылка = Начисления.ДоговорДУ
	|ГДЕ
	|	Договоры.Ссылка В (&СписокДоговоровДУ)";
	Запрос.УстановитьПараметр("СписокДоговоровДУ", СписокДоговоровДУ);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаПериода));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПериода));
	Запрос.УстановитьПараметр("ГруппаОпераций", ГруппаОперацийСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПланПроведен = Истина И Выборка.НачислениеПроведен = Истина Тогда
			Стр = ТаблицаУспешных.Добавить();
			Стр.ДоговорДУ = Выборка.ДоговорДУ;
			Стр.План = Выборка.План;
			Стр.Начисление = Выборка.Начисление;
			Стр.Сумма = Выборка.Сумма;
			Итоги.Успешно = Итоги.Успешно + 1;
		Иначе
			Стр = ТаблицаОшибок.Добавить();
			Стр.ДоговорДУ = Выборка.ДоговорДУ;
			Если Не ЗначениеЗаполнено(Выборка.План) Тогда
				Стр.ТекстОшибки = "Не создан план регламентных операций";
			ИначеЕсли Выборка.ПланПроведен <> Истина Тогда
				Стр.ТекстОшибки = "План регламентных операций не проведён";
			ИначеЕсли Не ЗначениеЗаполнено(Выборка.Начисление) Тогда
				Стр.ТекстОшибки = "Не создан документ НачислениеВознаграждения";
			Иначе
				Стр.ТекстОшибки = "Документ НачислениеВознаграждения не проведён";
			КонецЕсли;
			Итоги.СОшибками = Итоги.СОшибками + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Итоги;

КонецФункции

Процедура СформироватьИОтправитьПисьмоОбИтогах(ДатаЗапуска, ДатаПериода, Результат, Итоги)

	Успешно = Ложь;
	СообщениеМетода = "";
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("Успешно", Успешно);
		Результат.Свойство("Сообщение", СообщениеМетода);
	КонецЕсли;

	ЕстьОшибки = (Не Успешно) Или (Итоги.СОшибками > 0);
	ФлагРезультатаВТеме = ?(ЕстьОшибки, "{ERR} ", "{OK} ");

	ТемаПисьма = ФлагРезультатаВТеме
		+ "Авто-начисление ВУК РДУ за " + Формат(ДатаПериода, "ДФ=dd.MM.yyyy")
		+ ПропискаРассылки("r9153");

	ТелоПисьма = СформироватьТелоПисьмаОбИтогах(ДатаЗапуска, ДатаПериода, СообщениеМетода, Итоги, ЕстьОшибки);

	Кому = Новый Массив;
	Для Каждого ТекЯщик Из СписокРассылки Цикл
		Если ТекЯщик.Отправлять = Ложь Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекЯщик.ПочтовыйЯщик) Тогда
			Продолжить;
		КонецЕсли;
		Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
	КонецЦикла;

	Если Кому.Количество() = 0 Тогда
		Лог("Нет адресов для отправки (Отправлять=Истина и заполнен ПочтовыйЯщик).",
			УровеньЖурналаРегистрации.Предупреждение);
		Возврат;
	КонецЕсли;

	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ТемаПисьма;
	ПараметрыПисьма.Тело = ТелоПисьма;
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
	ПараметрыПисьма.Важность = ?(ЕстьОшибки,
		ВажностьИнтернетПочтовогоСообщения.Высокая,
		ВажностьИнтернетПочтовогоСообщения.Обычная);

	РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);

	Лог("Письмо об итогах отправлено. Тема: " + ТемаПисьма, УровеньЖурналаРегистрации.Информация);

КонецПроцедуры

Функция СформироватьТелоПисьмаОбИтогах(ДатаЗапуска, ДатаПериода, СообщениеМетода, Итоги, ЕстьОшибки)

	МаксСтрок = ?(МаксСтрокВТелеПисьма > 0, МаксСтрокВТелеПисьма, 200);

	Части = Новый Массив;
	Части.Добавить("<html><body style=""font-family:Calibri,Arial,sans-serif;font-size:14px;"">");
	Части.Добавить("<h2>Авто-начисление ВУК РДУ</h2>");
	Части.Добавить("<h3>Сводка</h3><ul>");
	Части.Добавить("<li>Дата запуска: " + Формат(ДатаЗапуска, "ДЛФ=DT") + "</li>");
	Части.Добавить("<li>Дата периода: " + Формат(ДатаПериода, "ДЛФ=D") + "</li>");
	Части.Добавить("<li>Пул: " + НаименованиеПула + "</li>");
	Части.Добавить("<li>Всего договоров: " + Формат(Итоги.Всего, "ЧН=0; ЧГ=") + "</li>");
	Части.Добавить("<li>Успешно: " + Формат(Итоги.Успешно, "ЧН=0; ЧГ=") + "</li>");
	Части.Добавить("<li>С ошибками: " + Формат(Итоги.СОшибками, "ЧН=0; ЧГ=") + "</li>");
	Части.Добавить("<li>Итог: " + ?(ЕстьОшибки, "ОШИБКА", "OK") + "</li>");
	Если ЗначениеЗаполнено(СообщениеМетода) Тогда
		Части.Добавить("<li>Сообщение метода: " + СообщениеМетода + "</li>");
	КонецЕсли;
	Части.Добавить("</ul>");

	Части.Добавить("<h3>Успешно обработанные</h3>");
	Части.Добавить(ТаблицаИтоговВHTML(Итоги.ТаблицаУспешных, МаксСтрок, Истина));

	Части.Добавить("<h3>Ошибки</h3>");
	Если Итоги.СОшибками = 0 Тогда
		Части.Добавить("<p>Ошибок нет.</p>");
	Иначе
		Части.Добавить(ТаблицаИтоговВHTML(Итоги.ТаблицаОшибок, МаксСтрок, Ложь));
	КонецЕсли;

	Части.Добавить("</body></html>");

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Функция ТаблицаИтоговВHTML(Таблица, МаксСтрок, ЭтоУспех)

	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Или Таблица.Количество() = 0 Тогда
		Возврат "<p>(пусто)</p>";
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить("<table border=""1"" cellpadding=""4"" cellspacing=""0"" style=""border-collapse:collapse;"">");
	Если ЭтоУспех Тогда
		Части.Добавить("<tr><th>Договор ДУ</th><th>План</th><th>Начисление</th><th>Сумма</th></tr>");
	Иначе
		Части.Добавить("<tr><th>Договор ДУ</th><th>Ошибка</th></tr>");
	КонецЕсли;

	Сч = 0;
	Для Каждого Стр Из Таблица Цикл
		Сч = Сч + 1;
		Если Сч > МаксСтрок Тогда
			Части.Добавить("<tr><td colspan=""4"">и ещё "
				+ Формат(Таблица.Количество() - МаксСтрок, "ЧН=0; ЧГ=")
				+ " (см. журнал регистрации)</td></tr>");
			Прервать;
		КонецЕсли;
		Если ЭтоУспех Тогда
			Части.Добавить("<tr><td>" + Строка(Стр.ДоговорДУ) + "</td><td>"
				+ Строка(Стр.План) + "</td><td>" + Строка(Стр.Начисление) + "</td><td>"
				+ Формат(Стр.Сумма, "ЧН=0; ЧГ=") + "</td></tr>");
		Иначе
			Части.Добавить("<tr><td>" + Строка(Стр.ДоговорДУ) + "</td><td>"
				+ Стр.ТекстОшибки + "</td></tr>");
		КонецЕсли;
	КонецЦикла;

	Части.Добавить("</table>");
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Функция ПропискаРассылки(НомерРассылки)

	ИмяИБ = "";
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(
			СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
		// Имя ИБ необязательно.
	КонецПопытки;

	Возврат " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";

КонецФункции

Процедура ЗагрузитьТЧ(ИмяТЧ, Значения)

	Если Не Значения.Свойство(ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;

	ДанныеТЧ = Значения[ИмяТЧ];
	Если ТипЗнч(ДанныеТЧ) = Тип("Строка") Тогда
		Попытка
			ДанныеТЧ = XMLЗначение(Тип("ХранилищеЗначения"), ДанныеТЧ).Получить();
		Исключение
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Если ТипЗнч(ДанныеТЧ) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;

	ЭтотОбъект[ИмяТЧ].Загрузить(ДанныеТЧ);

КонецПроцедуры

Процедура Лог(Текст, Уровень)

	ЗаписьЖурналаРегистрации("IMDEV-9153.АвтоВУК_РДУ", Уровень, , , Текст);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
