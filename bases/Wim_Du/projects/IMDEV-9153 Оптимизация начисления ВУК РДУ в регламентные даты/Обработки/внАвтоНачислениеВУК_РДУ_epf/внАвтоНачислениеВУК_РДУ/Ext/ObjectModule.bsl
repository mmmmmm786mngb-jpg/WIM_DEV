// Описание: Проверяет, что дата запуска — первое число квартала (1 янв / 1 апр / 1 июл / 1 окт).
//
// Параметры:
//  ДатаЗапуска - Дата - дата запуска регламента
//
// Возвращаемое значение:
//  Булево - Истина, если дата является регламентной датой запуска
//
Функция ЭтоРегламентнаяДатаЗапуска(ДатаЗапуска)

    Если День(ДатаЗапуска) <> 1 Тогда
        Возврат Ложь;
    КонецЕсли;

    МесяцЗапуска = Месяц(ДатаЗапуска);
    Возврат МесяцЗапуска = 1 Или МесяцЗапуска = 4 Или МесяцЗапуска = 7 Или МесяцЗапуска = 10;

КонецФункции

// Описание: Возвращает группу операций закрытия периода "3.1 Вознаграждение за управление".
//
// Возвращаемое значение:
//  СправочникСсылка.ВидыОперацийЗакрытияПериода, или Неопределено, если не найдена
//
Функция ПолучитьГруппуОпераций()

    // TODO: подтвердить способ поиска группы (по наименованию/коду).
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    ВидыОпераций.Ссылка КАК Ссылка
        |ИЗ
        |    Справочник.ВидыОперацийЗакрытияПериода КАК ВидыОпераций
        |ГДЕ
        |    ВидыОпераций.ЭтоГруппа = ИСТИНА
        |    И ВидыОпераций.Наименование ПОДОБНО &Наименование";
    Запрос.УстановитьПараметр("Наименование", "%Вознаграждение за управление%");

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Возврат Неопределено;

КонецФункции

// Описание: Создаёт элемент справочника РегламентныеПериоды на указанную дату.
//
// Параметры:
//  ДатаПериода - Дата - дата регламентного периода
//
// Возвращаемое значение:
//  СправочникСсылка.РегламентныеПериоды - ссылка на созданный период
//
Функция СоздатьРегламентныйПериод(ДатаПериода)

    НовыйЭлемент = Справочники.РегламентныеПериоды.СоздатьЭлемент();
    НовыйЭлемент.ДатаПериода = ДатаПериода;
    НовыйЭлемент.Записать();

    Лог("Создан регламентный период на " + Формат(ДатаПериода, "ДЛФ=D") + ".",
        УровеньЖурналаРегистрации.Информация);

    Возврат НовыйЭлемент.Ссылка;

КонецФункции

// Описание: Возвращает массив договоров ДУ пула розничного ДУ, действующих на дату периода.
//
// Параметры:
//  ДатаПериода - Дата - дата регламентного периода
//
// Возвращаемое значение:
//  Массив - ссылки СправочникСсылка.ДоговорДУ
//
Функция ПолучитьСписокДоговоровРДУ(ДатаПериода)

    // TODO(BA): согласовать точный отбор (действующие, без расторгнутых, стратегии).
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    ДоговорДУ.Ссылка КАК Ссылка
        |ИЗ
        |    Справочник.ДоговорДУ КАК ДоговорДУ
        |ГДЕ
        |    ДоговорДУ.Пул = &Пул
        |    И ДоговорДУ.ПометкаУдаления = ЛОЖЬ
        |    И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаНачала, ДЕНЬ) <= &ДатаПериода
        |    И (КОНЕЦПЕРИОДА(ДоговорДУ.ДатаОкончания, ДЕНЬ) >= &ДатаПериода
        |        ИЛИ ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))";
    Запрос.УстановитьПараметр("Пул", Справочники.Пул.НайтиПоНаименованию(НаименованиеПула));
    Запрос.УстановитьПараметр("ДатаПериода", ДатаПериода);

    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Описание: Формирует структуру ПараметрыСохранения для СформироватьРегламентныеОперации.
//
// Параметры:
//  СписокДоговоровДУ - Массив - договоры РДУ
//  ДатаПериода - Дата - дата регламентного периода
//  ГруппаОпераций - СправочникСсылка.ВидыОперацийЗакрытияПериода - группа 3.1
//  ВидОперацииУК - СправочникСсылка.ВидыОперацийЗакрытияПериода - операция УК (БУ)
//  ВремяРеглОпераций - Дата - время регламентных операций из группы 3.1
//
// Возвращаемое значение:
//  Структура - ПараметрыСохранения
//
Функция СформироватьПараметрыСохранения(СписокДоговоровДУ, ДатаПериода, ГруппаОпераций, ВидОперацииУК, ВремяРеглОпераций)

    СписокОпераций = Новый ТаблицаЗначений;
    СписокОпераций.Колонки.Добавить("ДоговорДУ", Новый ОписаниеТипов("СправочникСсылка.ДоговорДУ"));
    СписокОпераций.Колонки.Добавить("ВидОперации", Новый ОписаниеТипов("СправочникСсылка.ВидыОперацийЗакрытияПериода"));
    СписокОпераций.Колонки.Добавить("Выполнять", Новый ОписаниеТипов("Булево"));
    СписокОпераций.Колонки.Добавить("ВремяРеглОпераций", Новый ОписаниеТипов("Дата"));
    СписокОпераций.Колонки.Добавить("ГруппаОперацийПользователя", Новый ОписаниеТипов("СправочникСсылка.ВидыОперацийЗакрытияПериода"));

    Для Каждого ДоговорДУ Из СписокДоговоровДУ Цикл
        Стр = СписокОпераций.Добавить();
        Стр.ДоговорДУ = ДоговорДУ;
        Стр.ВидОперации = ВидОперацииУК;
        Стр.Выполнять = Истина;
        Стр.ВремяРеглОпераций = ВремяРеглОпераций; // Строго из группы 3.1
        Стр.ГруппаОперацийПользователя = ГруппаОпераций;
    КонецЦикла;

    СписокОпераций.Индексы.Добавить("ДоговорДУ");
    СписокОпераций.Индексы.Добавить("ДоговорДУ, ГруппаОперацийПользователя");

    ДокументыПоДоговорам = ПолучитьДокументыПоДоговорам(СписокДоговоровДУ, ДатаПериода, ГруппаОпераций);

    МассивРодителей = Новый Массив;
    МассивРодителей.Добавить(ГруппаОпераций);

    ПараметрыСохранения = Новый Структура;
    ПараметрыСохранения.Вставить("СписокОпераций", СписокОпераций);
    ПараметрыСохранения.Вставить("ДокументыПоДоговорам", ДокументыПоДоговорам);
    ПараметрыСохранения.Вставить("КоличествоПотоков", Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить());
    ПараметрыСохранения.Вставить("МассивРодителей", МассивРодителей);
    ПараметрыСохранения.Вставить("МассивФоновыхЗаданий", Новый Массив);

    Возврат ПараметрыСохранения;

КонецФункции

// Описание: Возвращает таблицу существующих документов ПланРегламентныхОперацийДУ по договорам за период.
//
// Параметры:
//  СписокДоговоровДУ - Массив - договоры РДУ
//  ДатаПериода - Дата - дата регламентного периода
//  ГруппаОпераций - СправочникСсылка.ВидыОперацийЗакрытияПериода - группа 3.1
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: ДоговорДУ, Ссылка, Дата, ГруппаОперацийПользователя
//
Функция ПолучитьДокументыПоДоговорам(СписокДоговоровДУ, ДатаПериода, ГруппаОпераций)

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |    ПланРО.ДоговорДУ КАК ДоговорДУ,
        |    ПланРО.Ссылка КАК Ссылка,
        |    ПланРО.Дата КАК Дата,
        |    ПланРО.ГруппаОперацийПользователя КАК ГруппаОперацийПользователя
        |ИЗ
        |    Документ.ПланРегламентныхОперацийДУ КАК ПланРО
        |ГДЕ
        |    ПланРО.ДоговорДУ В (&СписокДоговоровДУ)
        |    И ПланРО.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
        |    И ПланРО.ГруппаОперацийПользователя = &ГруппаОпераций
        |    И ПланРО.ПометкаУдаления = ЛОЖЬ";
    Запрос.УстановитьПараметр("СписокДоговоровДУ", СписокДоговоровДУ);
    Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаПериода));
    Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаПериода));
    Запрос.УстановитьПараметр("ГруппаОпераций", ГруппаОпераций);

    ДокументыПоДоговорам = Запрос.Выполнить().Выгрузить();
    ДокументыПоДоговорам.Индексы.Добавить("ДоговорДУ, ГруппаОперацийПользователя");

    Возврат ДокументыПоДоговорам;

КонецФункции

// Описание: Обрабатывает итог выполнения: запись в журнал регистрации и (опц.) отправка письма.
//
// Параметры:
//  Результат - Структура - {Успешно, Сообщение}, полученная из СформироватьРегламентныеОперации
//  ДатаПериода - Дата - дата регламентного периода
//  КоличествоДоговоров - Число - число договоров в запуске
//
Процедура ОбработатьРезультат(Результат, ДатаПериода, КоличествоДоговоров)

    Успешно = Ложь;
    Сообщение = "";
    Если ТипЗнч(Результат) = Тип("Структура") Тогда
        Результат.Свойство("Успешно", Успешно);
        Результат.Свойство("Сообщение", Сообщение);
    КонецЕсли;

    ТекстИтога = СтрШаблон("Начисление ВУК РДУ за %1. Договоров: %2. Успешно: %3. %4",
        Формат(ДатаПериода, "ДЛФ=D"), КоличествоДоговоров, ?(Успешно, "Да", "Нет"), Сообщение);

    Лог(ТекстИтога, ?(Успешно, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка));

    // TODO(BA): при ОтправлятьПисьмоОбИтогах = Истина сформировать и отправить письмо.

КонецПроцедуры

// Описание: Единая точка записи в журнал регистрации.
//
// Параметры:
//  Текст - Строка - текст сообщения
//  Уровень - УровеньЖурналаРегистрации - уровень записи
//
Процедура Лог(Текст, Уровень)

    ЗаписьЖурналаРегистрации("IMDEV-9153.АвтоВУК_РДУ", Уровень, , , Текст);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
