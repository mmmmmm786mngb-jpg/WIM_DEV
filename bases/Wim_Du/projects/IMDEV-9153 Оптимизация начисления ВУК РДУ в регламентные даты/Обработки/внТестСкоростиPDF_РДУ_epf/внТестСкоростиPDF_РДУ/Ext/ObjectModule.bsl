// Описание: Сведения для регистрации внешней обработки в БСП.
//
// Возвращаемое значение:
//  Структура - параметры регистрации
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Тест скорости PDF справок ВУК РДУ (IMDEV-9153)");
	ПараметрыРегистрации.Вставить("Версия", "1.0.0");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"IMDEV-9153. Сравнение последовательного и параллельного формирования PDF справок.");

	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	ТаблицаКоманд.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	Команда = ТаблицаКоманд.Добавить();
	Команда.Представление = "Тест скорости PDF справок ВУК РДУ";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = "ОткрытиеФормы";

	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Заполняет ТЧ договорами для теста. Учитывает КоличествоВВыборке (ПЕРВЫЕ N).
//
Процедура ВыбратьДоговоры() Экспорт

	ДоговорыКТесту.Очистить();
	ОбновитьЛимитПотоковИзКонстанты();

	Если Не ЗначениеЗаполнено(ДатаНачисления) Тогда
		ДатаНачисления = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

	Если КоличествоВВыборке <= 0 Тогда
		ВызватьИсключение "Укажите КоличествоВВыборке больше 0 перед выбором.";
	КонецЕсли;

	ЛимитСтрок = Формат(КоличествоВВыборке, "ЧГ=0");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + ЛимитСтрок + "
		|	СпрДоговорДУ.Ссылка КАК ДоговорДУ,
		|	СпрДоговорДУ.СрокДействия КАК СрокДоговораЧисло,
		|	СпрДоговорДУ.Код КАК КодДоговора,
		|	СпрДоговорДУ.ДатаНачала КАК ДатаНачала,
		|	ЛОЖЬ КАК Расторжение,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаРасторжения
		|ПОМЕСТИТЬ ВТ_Договоры
		|ИЗ
		|	Справочник.ДоговорДУ КАК СпрДоговорДУ
		|ГДЕ
		|	(НЕ &ОтборПоСписку
		|				И СпрДоговорДУ.Пул = &Пул
		|			ИЛИ &ОтборПоСписку
		|				И СпрДоговорДУ.Ссылка В (&ДоговорыДУ))
		|	И (СпрДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СпрДоговорДУ.ДатаОкончания > &ДатаРасчета)
		|	И СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДАТАВРЕМЯ(1, 1, 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВводыВыводыДУ.ДоговорДУ КАК ДоговорДУ,
		|	СУММА(ВводыВыводыДУ.ВалютнаяСумма) КАК СуммаИнвестиций
		|ПОМЕСТИТЬ ВТ_Ввод
		|ИЗ
		|	РегистрНакопления.ВводыВыводыДУ КАК ВводыВыводыДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Договоры КАК ВТ_Договоры
		|		ПО ВводыВыводыДУ.ДоговорДУ = ВТ_Договоры.ДоговорДУ
		|ГДЕ
		|	ВводыВыводыДУ.Активность
		|	И ВводыВыводыДУ.Сумма > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ВводыВыводыДУ.ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбязательстваПоДСОстатки.ДоговорДУ КАК ДоговорДУ,
		|	СУММА(ОбязательстваПоДСОстатки.ВалютнаяСуммаОстаток) КАК СуммаВознаграждения
		|ПОМЕСТИТЬ ВТ_Сумма
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС.Остатки(
		|			&ДатаРасчета,
		|			ДоговорДУ В
		|					(ВЫБРАТЬ
		|						ВТ_Договоры.ДоговорДУ
		|					ИЗ
		|						ВТ_Договоры КАК ВТ_Договоры)
		|				И Основание.Ссылка ЕСТЬ NULL) КАК ОбязательстваПоДСОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ОбязательстваПоДСОстатки.ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Договоры.ДоговорДУ КАК ДоговорДУ,
		|	ВТ_Договоры.КодДоговора КАК КодДоговора,
		|	ВТ_Договоры.ДатаНачала КАК ДатаНачала,
		|	ВТ_Договоры.СрокДоговораЧисло КАК СрокДоговораЧисло,
		|	ВТ_Договоры.Расторжение КАК Расторжение,
		|	ВТ_Договоры.ДатаРасторжения КАК ДатаРасторжения,
		|	ЕСТЬNULL(ВТ_Сумма.СуммаВознаграждения, 0) КАК СуммаВознаграждения,
		|	ЕСТЬNULL(ВТ_Ввод.СуммаИнвестиций, 0) КАК СуммаИнвестиций
		|ИЗ
		|	ВТ_Договоры КАК ВТ_Договоры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Ввод КАК ВТ_Ввод
		|		ПО ВТ_Договоры.ДоговорДУ = ВТ_Ввод.ДоговорДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Сумма КАК ВТ_Сумма
		|		ПО ВТ_Договоры.ДоговорДУ = ВТ_Сумма.ДоговорДУ
		|ГДЕ
		|	ЕСТЬNULL(ВТ_Сумма.СуммаВознаграждения, 0) > 0";

	Запрос.УстановитьПараметр("ДатаРасчета", КонецДня(ДатаНачисления));
	Запрос.УстановитьПараметр("Пул", Пул);
	Запрос.УстановитьПараметр("ДоговорыДУ", ДоговорыДУ.ВыгрузитьЗначения());
	ОтборПоСписку = ДоговорыДУ.Количество() > 0;
	Запрос.УстановитьПараметр("ОтборПоСписку", ОтборПоСписку);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		СтрокаТЧ = ДоговорыКТесту.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
		СтрокаТЧ.СрокДоговора = "" + Выборка.СрокДоговораЧисло;
		СтрокаТЧ.СуммаУдержанияПриРасторжении = 0;
		СтрокаТЧ.СуммаВознагражденияВесьСрок =
			Окр((Выборка.СуммаИнвестиций / 100) * СтавкаВознаграждения * Выборка.СрокДоговораЧисло, 2);

	КонецЦикла;

КонецПроцедуры

// Описание: Последовательный и параллельный прогон PDF, сравнение времени и размеров.
//
Процедура ЗапуститьСравнение() Экспорт

	ОбновитьЛимитПотоковИзКонстанты();

	Если ДоговорыКТесту.Количество() = 0 Тогда
		ВызватьИсключение "Сначала выполните Выбор договоров.";
	КонецЕсли;
	Если ПустаяСтрока(КаталогПоследовательный) Или ПустаяСтрока(КаталогПараллельный) Тогда
		ВызватьИсключение "Укажите каталоги для последовательного и параллельного режимов.";
	КонецЕсли;
	Если ПустаяСтрока(ПутьКФайлуОбработки) Тогда
		ВызватьИсключение "Не задан путь к файлу обработки (откройте EPF с диска).";
	КонецЕсли;
	Если РазмерПачки <= 0 Тогда
		РазмерПачки = 50;
	КонецЕсли;

	ОчиститьКаталогТеста(КаталогПоследовательный);
	ОчиститьКаталогТеста(КаталогПараллельный);

	МассивДанных = ДанныеДоговоровДляПачек();

	// --- Режим как сейчас: последовательно в текущем сеансе ---
	НачалоПосл = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОшибкиПосл = Новый Массив;
	СформироватьPDFПоМассиву(МассивДанных, КаталогПоследовательный, ОшибкиПосл);
	ВремяПослМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПосл;
	СтатПосл = СтатистикаКаталога(КаталогПоследовательный);

	// --- Режим параллельный: фоновые пачки, лимит = константа монитора ---
	НачалоПар = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОшибкиПар = Новый Массив;
	СформироватьPDFПараллельно(МассивДанных, КаталогПараллельный, ОшибкиПар);
	ВремяПарМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПар;
	СтатПар = СтатистикаКаталога(КаталогПараллельный);

	ТекстОтчета = СобратьТекстОтчета(
		МассивДанных.Количество(),
		ВремяПослМс, СтатПосл, ОшибкиПосл,
		ВремяПарМс, СтатПар, ОшибкиПар);

КонецПроцедуры

// Описание: Точка входа фонового задания (через ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки).
//
// Параметры:
//  ПараметрыВыполнения - Структура - Каталог, ДатаНачисления, СтавкаВознаграждения, ДанныеДоговоров
//  АдресХранилища - Строка - адрес результата во временном хранилище
//
Процедура СформироватьPDFПачки(ПараметрыВыполнения, АдресХранилища) Экспорт

	Результат = Новый Структура("Успех, Ошибки, Количество", Истина, Новый Массив, 0);

	Попытка
		ДатаНачисления = ПараметрыВыполнения.ДатаНачисления;
		СтавкаВознаграждения = ПараметрыВыполнения.СтавкаВознаграждения;
		Ошибки = Результат.Ошибки;
		СформироватьPDFПоМассиву(ПараметрыВыполнения.ДанныеДоговоров, ПараметрыВыполнения.Каталог, Ошибки);
		Результат.Количество = ПараметрыВыполнения.ДанныеДоговоров.Количество();
		Результат.Успех = (Ошибки.Количество() = 0);
	Исключение
		Результат.Успех = Ложь;
		Результат.Ошибки.Добавить(ОписаниеОшибки());
	КонецПопытки;

	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

// Описание: Читает константу МаксимальноеКоличествоПараллельныхПотоков монитора.
//
Процедура ОбновитьЛимитПотоковИзКонстанты() Экспорт

	ЛимитПотоковКонстанта = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
	Если ЛимитПотоковКонстанта <= 0 Тогда
		ЛимитПотоковКонстанта = 1;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеДоговоровДляПачек()

	Результат = Новый Массив;
	Для Каждого СтрокаТЧ Из ДоговорыКТесту Цикл
		Данные = Новый Структура;
		Данные.Вставить("ДоговорДУ", СтрокаТЧ.ДоговорДУ);
		Данные.Вставить("КодДоговора", СтрокаТЧ.КодДоговора);
		Данные.Вставить("ДатаНачала", СтрокаТЧ.ДатаНачала);
		Данные.Вставить("СрокДоговора", СтрокаТЧ.СрокДоговора);
		Данные.Вставить("СуммаВознаграждения", СтрокаТЧ.СуммаВознаграждения);
		Данные.Вставить("СуммаВознагражденияВесьСрок", СтрокаТЧ.СуммаВознагражденияВесьСрок);
		Данные.Вставить("СуммаИнвестиций", СтрокаТЧ.СуммаИнвестиций);
		Данные.Вставить("СуммаУдержанияПриРасторжении", СтрокаТЧ.СуммаУдержанияПриРасторжении);
		Данные.Вставить("Расторжение", СтрокаТЧ.Расторжение);
		Данные.Вставить("ДатаРасторжения", СтрокаТЧ.ДатаРасторжения);
		Результат.Добавить(Данные);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура СформироватьPDFПоМассиву(МассивДанных, Каталог, Ошибки)

	СоздатьКаталогЕслиНет(Каталог);
	Для Каждого ДанныеДоговора Из МассивДанных Цикл
		Попытка
			СформироватьИСохранитьСправку(ДанныеДоговора, Каталог);
		Исключение
			Ошибки.Добавить(Строка(ДанныеДоговора.ДоговорДУ) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьPDFПараллельно(МассивДанных, Каталог, Ошибки)

	Если Не ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены() Тогда
		Ошибки.Добавить("Фоновые задания недоступны — параллельный режим выполнен последовательно.");
		СформироватьPDFПоМассиву(МассивДанных, Каталог, Ошибки);
		Возврат;
	КонецЕсли;

	СоздатьКаталогЕслиНет(Каталог);
	ЛимитПотоков = ЛимитПотоковКонстанта;
	Если ЛимитПотоков <= 0 Тогда
		ЛимитПотоков = 1;
	КонецЕсли;

	Пачки = РазбитьНаПачки(МассивДанных, РазмерПачки);
	СписокФоновыхЗаданий = Новый СписокЗначений;
	ИндексПачки = 0;

	Для Каждого Пачка Из Пачки Цикл

		ИндексПачки = ИндексПачки + 1;
		АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);

		ПараметрыПачки = Новый Структура;
		ПараметрыПачки.Вставить("Каталог", Каталог);
		ПараметрыПачки.Вставить("ДатаНачисления", ДатаНачисления);
		ПараметрыПачки.Вставить("СтавкаВознаграждения", СтавкаВознаграждения);
		ПараметрыПачки.Вставить("ДанныеДоговоров", Пачка);

		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ИмяМетода", "СформироватьPDFПачки");
		ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Истина);
		ПараметрыМетода.Вставить("ИмяОбработки", ПутьКФайлуОбработки);
		ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка",
			Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка());
		ПараметрыМетода.Вставить("ПараметрыВыполнения", ПараметрыПачки);

		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(ПараметрыМетода);
		МассивПараметров.Добавить(АдресРезультата);

		Наименование = "IMDEV-9153 PDF тест пачка " + Формат(ИндексПачки, "ЧГ=0");
		Задание = ФоновыеЗадания.Выполнить(
			"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			МассивПараметров,
			,
			Наименование);

		СписокФоновыхЗаданий.Добавить(Задание, АдресРезультата);

		Если СписокФоновыхЗаданий.Количество() >= ЛимитПотоков Тогда
			ДождатьсяИСобратьРезультаты(СписокФоновыхЗаданий, Ошибки);
			СписокФоновыхЗаданий.Очистить();
		КонецЕсли;

	КонецЦикла;

	Если СписокФоновыхЗаданий.Количество() > 0 Тогда
		ДождатьсяИСобратьРезультаты(СписокФоновыхЗаданий, Ошибки);
	КонецЕсли;

КонецПроцедуры

Процедура ДождатьсяИСобратьРезультаты(СписокФоновыхЗаданий, Ошибки)

	МассивЗаданий = СписокФоновыхЗаданий.ВыгрузитьЗначения();
	ФоновыеЗадания.ОжидатьЗавершенияВыполнения(МассивЗаданий);

	Для Каждого Элемент Из СписокФоновыхЗаданий Цикл

		Задание = Элемент.Значение;
		АдресРезультата = Элемент.Представление;

		Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			ТекстОшибки = "Фоновое задание аварийно";
			Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
				ТекстОшибки = ТекстОшибки + ": "
					+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
			КонецЕсли;
			Ошибки.Добавить(ТекстОшибки);
			Продолжить;
		КонецЕсли;

		Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("Ошибки") Тогда
			Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
				Ошибки.Добавить(ТекстОшибки);
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция РазбитьНаПачки(МассивДанных, Размер)

	Пачки = Новый Массив;
	Текущая = Новый Массив;
	Для Каждого Элемент Из МассивДанных Цикл
		Текущая.Добавить(Элемент);
		Если Текущая.Количество() >= Размер Тогда
			Пачки.Добавить(Текущая);
			Текущая = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Текущая.Количество() > 0 Тогда
		Пачки.Добавить(Текущая);
	КонецЕсли;
	Возврат Пачки;

КонецФункции

Процедура СформироватьИСохранитьСправку(ДоговорДУ, Каталог)

	СтруктураПоказателей = ПоказателиСправки();
	СтруктураПоказателей.ДоговорДУ = ДоговорДУ.ДоговорДУ;

	ДатаНомерДоговораДУ = "" + ДоговорДУ.КодДоговора + " от "
		+ Формат(ДоговорДУ.ДатаНачала, "ДФ='dd MMMM yyyy'") + "г.";
	СтруктураПоказателей.ДатаНомерДоговораДУ = ДатаНомерДоговораДУ;
	СтруктураПоказателей.Заявление = "к Заявлению о присоединении № " + ДатаНомерДоговораДУ;

	ДатаРасчета = ?(ДоговорДУ.Расторжение, ДоговорДУ.ДатаРасторжения, ДатаНачисления);
	СтруктураПоказателей.ПериодРасчета = "с " + Формат(НачалоКвартала(ДатаРасчета), "ДФ='dd MMMM yyyy'") + "г."
		+ " по " + Формат(ДатаРасчета, "ДФ='dd MMMM yyyy'") + "г.";
	СтруктураПоказателей.ИмяФайла = ИмяФайла(ДоговорДУ.ДоговорДУ);
	СтруктураПоказателей.НачалоРасчета = НачалоКвартала(ДатаРасчета);
	СтруктураПоказателей.ОкончаниеРасчета = ДатаРасчета;
	СтруктураПоказателей.СрокДоговора = ДоговорДУ.СрокДоговора;
	СтруктураПоказателей.СтавкаВознаграждения = СтавкаВознаграждения;
	СтруктураПоказателей.СуммаВознаграждения = ДоговорДУ.СуммаВознаграждения;
	СтруктураПоказателей.СуммаВознагражденияВесьСрок = ДоговорДУ.СуммаВознагражденияВесьСрок;
	СтруктураПоказателей.СуммаИнвестиций = ДоговорДУ.СуммаИнвестиций;
	СтруктураПоказателей.СуммаПоледующегоВознаграждения = 0;
	СтруктураПоказателей.СуммаУдержанногоВознаграждения = ДоговорДУ.СуммаУдержанияПриРасторжении;

	Справка = СправкаРасчет(СтруктураПоказателей);
	Путь = Каталог;
	Если Прав(Путь, 1) <> "\" Тогда
		Путь = Путь + "\";
	КонецЕсли;
	СохранитьНаДиск(Справка, Путь);

КонецПроцедуры

Функция ПоказателиСправки()

	Показатели = Новый Структура;
	Показатели.Вставить("ДоговорДУ", "");
	Показатели.Вставить("ДатаНомерДоговораДУ", "");
	Показатели.Вставить("Заявление", "");
	Показатели.Вставить("ПериодРасчета", "");
	Показатели.Вставить("НачалоРасчета", "");
	Показатели.Вставить("ОкончаниеРасчета", "");
	Показатели.Вставить("СуммаИнвестиций", "");
	Показатели.Вставить("СрокДоговора", "");
	Показатели.Вставить("СтавкаВознаграждения", 0);
	Показатели.Вставить("СуммаВознагражденияВесьСрок", 0);
	Показатели.Вставить("СуммаВознаграждения", 0);
	Показатели.Вставить("СуммаУдержанногоВознаграждения", 0);
	Показатели.Вставить("СуммаПоледующегоВознаграждения", 0);
	Показатели.Вставить("ИмяФайла", "");
	Возврат Показатели;

КонецФункции

Функция СправкаРасчет(СтруктураПоказателей)

	ТабДокументШапка = Новый ТабличныйДокумент;
	ТабДокументТело = Новый ТабличныйДокумент;
	ТабДокументПодвал = Новый ТабличныйДокумент;

	Макет = ПолучитьМакет("СправкаРасчет");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьТаблицаСтрока = Макет.ПолучитьОбласть("СтрокиТаблицы");
	ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");

	ОбластьЗаголовок.Параметры.Заявление = СтруктураПоказателей.Заявление;
	ОбластьЗаголовок.Параметры.ПериодРасчета = СтруктураПоказателей.ПериодРасчета;
	ТабДокументШапка.Вывести(ОбластьЗаголовок);
	ТабДокументТело.Вывести(ОбластьШапкаТаблицы);
	ОбластьТаблицаСтрока.Параметры.Заполнить(СтруктураПоказателей);
	ТабДокументТело.Вывести(ОбластьТаблицаСтрока);
	ТабДокументПодвал.Вывести(ОбластьПодвал);

	Возврат Новый Структура("ШапкаРасчет, ТелоРасчет, ПодвалРасчет, ИмяФайла",
		ТабДокументШапка, ТабДокументТело, ТабДокументПодвал, СтруктураПоказателей.ИмяФайла);

КонецФункции

Функция ИмяФайла(ДоговорДУ)

	КодКлиент = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорДУ, "Код, Клиент");
	IDКлиента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КодКлиент.Клиент, "ВнешнийIDДляЛК");
	Возврат "AM" + СтрЗаменить(IDКлиента, " ", "") + "-ДУ " + КодКлиент.Код + " (" + КодКлиент.Код + ")";

КонецФункции

Процедура СохранитьНаДиск(СправкаРасчет, ПутьСохранения)

	Т = Новый ТабличныйДокумент;
	Т.Вывести(СправкаРасчет.ШапкаРасчет);
	Т.Вывести(СправкаРасчет.ТелоРасчет);
	Т.Вывести(СправкаРасчет.ПодвалРасчет);
	Т.Записать(ПутьСохранения + СправкаРасчет.ИмяФайла + ".pdf", ТипФайлаТабличногоДокумента.PDF);

КонецПроцедуры

Процедура СоздатьКаталогЕслиНет(Путь)

	ФайлКаталог = Новый Файл(Путь);
	Если Не ФайлКаталог.Существует() Тогда
		СоздатьКаталог(Путь);
	КонецЕсли;

КонецПроцедуры

Процедура ОчиститьКаталогТеста(Путь)

	СоздатьКаталогЕслиНет(Путь);
	Файлы = НайтиФайлы(Путь, "*.pdf", Ложь);
	Для Каждого ФайлPDF Из Файлы Цикл
		УдалитьФайлы(ФайлPDF.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

Функция СтатистикаКаталога(Путь)

	Результат = Новый Структура("КоличествоФайлов, РазмерБайт", 0, 0);
	Файлы = НайтиФайлы(Путь, "*.pdf", Ложь);
	Результат.КоличествоФайлов = Файлы.Количество();
	Для Каждого ФайлPDF Из Файлы Цикл
		Результат.РазмерБайт = Результат.РазмерБайт + ФайлPDF.Размер();
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СобратьТекстОтчета(КоличествоДоговоров, ВремяПослМс, СтатПосл, ОшибкиПосл,
	ВремяПарМс, СтатПар, ОшибкиПар)

	СекПосл = ВремяПослМс / 1000;
	СекПар = ВремяПарМс / 1000;
	Ускорение = ?(СекПар > 0, СекПосл / СекПар, 0);
	ДельтаРазмер = СтатПар.РазмерБайт - СтатПосл.РазмерБайт;

	Строки = Новый Массив;
	Строки.Добавить("IMDEV-9153 — отчет сравнения скорости PDF справок ВУК РДУ");
	Строки.Добавить("Дата прогона: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	Строки.Добавить("Договоров в тесте: " + Формат(КоличествоДоговоров, "ЧГ=0"));
	Строки.Добавить("Размер пачки: " + Формат(РазмерПачки, "ЧГ=0"));
	Строки.Добавить("Лимит параллельных потоков (константа монитора): "
		+ Формат(ЛимитПотоковКонстанта, "ЧГ=0"));
	Строки.Добавить("");
	Строки.Добавить("--- Режим как сейчас (последовательно) ---");
	Строки.Добавить("Каталог: " + КаталогПоследовательный);
	Строки.Добавить("Время, сек: " + Формат(СекПосл, "ЧДЦ=3; ЧН=0"));
	Строки.Добавить("Файлов PDF: " + Формат(СтатПосл.КоличествоФайлов, "ЧГ=0"));
	Строки.Добавить("Суммарный размер, байт: " + Формат(СтатПосл.РазмерБайт, "ЧГ=0"));
	Строки.Добавить("Ошибок: " + Формат(ОшибкиПосл.Количество(), "ЧГ=0"));
	Строки.Добавить("");
	Строки.Добавить("--- Режим параллельный (фоновые пачки) ---");
	Строки.Добавить("Каталог: " + КаталогПараллельный);
	Строки.Добавить("Время, сек: " + Формат(СекПар, "ЧДЦ=3; ЧН=0"));
	Строки.Добавить("Файлов PDF: " + Формат(СтатПар.КоличествоФайлов, "ЧГ=0"));
	Строки.Добавить("Суммарный размер, байт: " + Формат(СтатПар.РазмерБайт, "ЧГ=0"));
	Строки.Добавить("Ошибок: " + Формат(ОшибкиПар.Количество(), "ЧГ=0"));
	Строки.Добавить("");
	Строки.Добавить("--- Сравнение ---");
	Строки.Добавить("Ускорение (посл/пар): " + Формат(Ускорение, "ЧДЦ=2; ЧН=0"));
	Строки.Добавить("Разница размера (пар - посл), байт: " + Формат(ДельтаРазмер, "ЧГ=0"));
	Если СтатПосл.КоличествоФайлов <> СтатПар.КоличествоФайлов Тогда
		Строки.Добавить("ВНИМАНИЕ: число файлов не совпадает — возможна регрессия.");
	ИначеЕсли ДельтаРазмер <> 0 Тогда
		Строки.Добавить("ВНИМАНИЕ: суммарный размер файлов отличается — проверьте выборочно PDF.");
	Иначе
		Строки.Добавить("Число файлов и суммарный размер совпали.");
	КонецЕсли;

	Если ОшибкиПосл.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить("Ошибки последовательного режима:");
		Для Каждого ТекстОшибки Из ОшибкиПосл Цикл
			Строки.Добавить(" - " + ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
	Если ОшибкиПар.Количество() > 0 Тогда
		Строки.Добавить("");
		Строки.Добавить("Ошибки параллельного режима:");
		Для Каждого ТекстОшибки Из ОшибкиПар Цикл
			Строки.Добавить(" - " + ТекстОшибки);
		КонецЦикла;
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

