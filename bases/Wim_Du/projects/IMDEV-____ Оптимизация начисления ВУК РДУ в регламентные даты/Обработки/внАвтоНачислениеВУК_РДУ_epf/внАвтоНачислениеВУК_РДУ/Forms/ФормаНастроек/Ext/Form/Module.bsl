#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастройкиОбработки = Неопределено;
	Если Параметры.Свойство("НастройкиАлгоритма") И ТипЗнч(Параметры.НастройкиАлгоритма) = Тип("Структура") Тогда
		НастройкиОбработки = Параметры.НастройкиАлгоритма;
	Иначе
		ДопОбработка = Неопределено;
		Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", ДопОбработка)
			И ЗначениеЗаполнено(ДопОбработка) Тогда
			НастройкиОбработки = Справочники.ДополнительныеОтчетыИОбработки.НастройкиОбработки(ДопОбработка);
		КонецЕсли;
	КонецЕсли;

	ТекОбъект = РеквизитФормыВЗначение("Объект");

	Если ЗначениеЗаполнено(НастройкиОбработки) Тогда
		ТекОбъект.УстановитьПользовательскиеНастройки(НастройкиОбработки);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекОбъект.НаименованиеПула) Тогда
		ТекОбъект.НаименованиеПула = "Розничное ДУ";
	КонецЕсли;
	Если ТекОбъект.МаксСтрокВТелеПисьма = 0 Тогда
		ТекОбъект.МаксСтрокВТелеПисьма = 200;
	КонецЕсли;
	// По умолчанию создавать период, если настройка ещё не сохранялась.
	Если Не ЗначениеЗаполнено(НастройкиОбработки) Тогда
		ТекОбъект.СоздаватьПериодЕслиНет = Истина;
	КонецЕсли;

	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Установить(Команда)

	ЗаголовокНастроек = "";
	ЗначенияПараметров = УстановитьПараметрыНаСервере(ЗаголовокНастроек);
	ОповеститьОВыборе(Новый Структура("Значения, ЗаголовокНастроек", ЗначенияПараметров, ЗаголовокНастроек));

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСейчас(Команда)

	РезультатТекст = ВыполнитьСейчасНаСервере();
	ПоказатьПредупреждение(, РезультатТекст);

КонецПроцедуры

&НаКлиенте
Процедура НастройкиПоУмолчанию(Команда)

	РезультатТекст = НастройкиПоУмолчаниюНаСервере();
	Если ЗначениеЗаполнено(РезультатТекст) Тогда
		ПоказатьПредупреждение(, РезультатТекст);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция УстановитьПараметрыНаСервере(ЗаголовокНастроек)

	Значения = Новый Структура;
	Значения.Вставить("НаименованиеПула", Объект.НаименованиеПула);
	Значения.Вставить("ГруппаОпераций", Объект.ГруппаОпераций);
	Значения.Вставить("ВидОперации", Объект.ВидОперации);
	Значения.Вставить("УчитыватьВыполненные", Объект.УчитыватьВыполненные);
	Значения.Вставить("СоздаватьПериодЕслиНет", Объект.СоздаватьПериодЕслиНет);
	Значения.Вставить("ОтправлятьПисьмоОбИтогах", Объект.ОтправлятьПисьмоОбИтогах);
	Значения.Вставить("ПочтовыйЛогин", Объект.ПочтовыйЛогин);
	Значения.Вставить("МаксСтрокВТелеПисьма", Объект.МаксСтрокВТелеПисьма);
	Значения.Вставить("ИгнорироватьПроверкуРегламентнойДаты", Объект.ИгнорироватьПроверкуРегламентнойДаты);
	Значения.Вставить("ДатаПериодаПринудительно", Объект.ДатаПериодаПринудительно);
	Значения.Вставить("СписокРассылки", XMLСтрока(Новый ХранилищеЗначения(Объект.СписокРассылки.Выгрузить())));

	ЗаголовокНастроек = "Settings: " + Объект.НаименованиеПула;
	Возврат Значения;

КонецФункции

&НаСервере
Функция ВыполнитьСейчасНаСервере()

	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.ИгнорироватьПроверкуРегламентнойДаты = Истина;
	Попытка
		ТекОбъект.ВыполнитьНачислениеВУК();
		Возврат "Выполнение завершено. Подробности — в журнале регистрации (IMDEV-9153.АвтоВУК_РДУ).";
	Исключение
		Возврат "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

&НаСервере
Функция НастройкиПоУмолчаниюНаСервере()

	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.ЗаполнитьНастройкиПоУмолчанию();
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");

	Если Не ЗначениеЗаполнено(Объект.ГруппаОпераций) Тогда
		Возврат "Заполнены базовые значения, но группа '3.1 Вознаграждение за управление' не найдена в справочнике. Укажите её вручную.";
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти
