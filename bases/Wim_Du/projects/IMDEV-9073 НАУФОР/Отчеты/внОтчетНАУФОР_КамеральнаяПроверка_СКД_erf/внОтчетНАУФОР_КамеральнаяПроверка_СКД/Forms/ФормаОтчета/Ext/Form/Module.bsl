
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Отчет.ОтчетнаяДата) Тогда
		Отчет.ОтчетнаяДата = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	СинхронизироватьПараметрыСКДСАтрибутами();
	
КонецПроцедуры

&НаСервере
Процедура ПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить(
		"КлючВарианта", ЭтотОбъект.КлючТекущегоВарианта);
	
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьПараметрыСКДСАтрибутами()
	
	Настройки = Отчет.КомпоновщикНастроек.Настройки;
	
	УстановитьПараметрСКД(Настройки, "ОтчетнаяДата", Отчет.ОтчетнаяДата);
	УстановитьПараметрСКД(Настройки, "УправляющаяКомпания", Отчет.УправляющаяКомпания);
	УстановитьПараметрСКД(Настройки, "ТипКлиентаДУ", Отчет.ТипКлиентаДУ);
	УстановитьПараметрСКД(Настройки, "ЛицензияПУРЦБ", Отчет.ЛицензияПУРЦБ);
	УстановитьПараметрСКД(Настройки, "ЛицензияНПФ", Отчет.ЛицензияНПФ);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрСКД(Настройки, ИмяПараметра, Значение)
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	Если Параметр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Параметр.Использование = Истина;
	Параметр.Значение = Значение;
	
КонецПроцедуры
