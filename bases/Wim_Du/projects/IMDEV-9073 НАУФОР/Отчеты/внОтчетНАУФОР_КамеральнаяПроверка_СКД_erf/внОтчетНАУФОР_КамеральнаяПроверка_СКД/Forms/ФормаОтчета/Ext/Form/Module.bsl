
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Отчет.ОтчетнаяДата) Тогда
		Отчет.ОтчетнаяДата = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	СинхронизироватьПараметрыСКДСАтрибутами();
	
КонецПроцедуры

&НаСервере
Процедура ПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить(
		"КлючВарианта", ЭтотОбъект.КлючТекущегоВарианта);
	
	СинхронизироватьАтрибутыИзНастроекСКД();
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрОтчетаПриИзменении(Элемент)
	
	СинхронизироватьПараметрыСКДСАтрибутами();
	
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьПараметрыСКДСАтрибутами()
	
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	
	УстановитьПараметрСКД(Настройки, "ОтчетнаяДата", Отчет.ОтчетнаяДата);
	УстановитьПараметрСКД(Настройки, "УправляющаяКомпания", Отчет.УправляющаяКомпания);
	УстановитьПараметрСКД(Настройки, "ТипКлиентаДУ", Отчет.ТипКлиентаДУ);
	УстановитьПараметрСКД(Настройки, "ЛицензияПУРЦБ", Отчет.ЛицензияПУРЦБ);
	УстановитьПараметрСКД(Настройки, "ЛицензияНПФ", Отчет.ЛицензияНПФ);
	
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьАтрибутыИзНастроекСКД()
	
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	
	ЗначениеДаты = ПрочитатьПараметрСКД(Настройки, "ОтчетнаяДата");
	Если ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Отчет.ОтчетнаяДата = ЗначениеДаты;
	КонецЕсли;
	
	ЗначениеУК = ПрочитатьПараметрСКД(Настройки, "УправляющаяКомпания");
	Если ЗначениеЗаполнено(ЗначениеУК) Тогда
		Отчет.УправляющаяКомпания = ЗначениеУК;
	КонецЕсли;
	
	ЗначениеТипа = ПрочитатьПараметрСКД(Настройки, "ТипКлиентаДУ");
	Если ЗначениеЗаполнено(ЗначениеТипа) Тогда
		Отчет.ТипКлиентаДУ = ЗначениеТипа;
	КонецЕсли;
	
	Отчет.ЛицензияПУРЦБ = ПрочитатьПараметрСКД(Настройки, "ЛицензияПУРЦБ", Ложь);
	Отчет.ЛицензияНПФ = ПрочитатьПараметрСКД(Настройки, "ЛицензияНПФ", Ложь);
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьПараметрСКД(Настройки, ИмяПараметра, ЗначениеПоУмолчанию = Неопределено)
	
	ЭлементПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	Если ЭлементПараметра = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если ТипЗнч(ЭлементПараметра.Значение) = Тип("Булево") Тогда
		Возврат ЭлементПараметра.Значение;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭлементПараметра.Значение) Тогда
		Возврат ЭлементПараметра.Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

&НаСервере
Процедура УстановитьПараметрСКД(Настройки, ИмяПараметра, Значение)
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	Если Параметр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Параметр.Использование = Истина;
	Параметр.Значение = Значение;
	
КонецПроцедуры
