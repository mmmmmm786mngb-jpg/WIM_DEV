
#Область ПрограммныйИнтерфейс

// Описание: Формирует табличный документ отчета (программный вызов, вариант НАУФОР)
//
// Параметры:
//  ПараметрыОтчета - Структура - ключи: ОтчетнаяДата, УправляющаяКомпания, ТипКлиентаДУ,
//      ЛицензияПУРЦБ, ЛицензияНПФ
//
// Возвращаемое значение:
//  ТабличныйДокумент - сформированный отчет; Неопределено при отсутствии данных
//
Функция СформироватьОтчет(ПараметрыОтчета) Экспорт
	
	Если Не ЗначениеЗаполнено(ПараметрыОтчета.ОтчетнаяДата) Тогда
		ВызватьИсключение "Не заполнена отчетная дата";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыОтчета.УправляющаяКомпания) Тогда
		ВызватьИсключение "Не заполнена управляющая компания";
	КонецЕсли;
	
	ТаблицаДанных = ПолучитьДанныеОтчета(ПараметрыОтчета);
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СформироватьТабличныйДокумент(ТаблицаДанных, ПараметрыОтчета.ОтчетнаяДата);
	
КонецФункции

// Описание: Возвращает параметры регистрации внешнего отчета в подсистеме дополнительных отчетов БСП
//
// Возвращаемое значение:
//  Структура - параметры регистрации и команды открытия формы отчета
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительныйОтчет");
	ПараметрыРегистрации.Вставить("Назначение", Неопределено);
	ПараметрыРегистрации.Вставить("Наименование", НаименованиеОтчета());
	ПараметрыРегистрации.Вставить("Версия", "1.02");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", "IMDEV-9073. Экспериментальный отчет на СКД с гибкими отборами");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд,
		НаименованиеОтчета(),
		"ОтчетНАУФОРКамеральнаяПроверкаСКД",
		"ОткрытиеФормы");
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Описание: Обработчик компоновки результата СКД. Вариант «НАУФОР» - фиксированная печатная форма;
// вариант «Аналитический» - вывод через СКД с пользовательскими отборами.
//
// Параметры:
//  ДокументРезультат - ТабличныйДокумент - результирующий документ
//  ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных - расшифровка
//  СтандартнаяОбработка - Булево - признак стандартной обработки платформой
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	КлючВарианта = ПолучитьКлючВариантаОтчета();
	ПараметрыОтчета = ПолучитьПараметрыИзНастроекСКД(Настройки);
	СохранитьПараметрыВАтрибуты(ПараметрыОтчета);
	
	Если Не ЗначениеЗаполнено(ПараметрыОтчета.ОтчетнаяДата) Тогда
		ВызватьИсключение "Не заполнена отчетная дата";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыОтчета.УправляющаяКомпания) Тогда
		ВызватьИсключение "Не заполнена управляющая компания";
	КонецЕсли;
	
	ТаблицаДанных = ПолучитьДанныеОтчета(ПараметрыОтчета);
	ДокументРезультат.Очистить();
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если КлючВарианта = "НАУФОР" Тогда
		ТабДокНауфор = СформироватьТабличныйДокумент(ТаблицаДанных, ПараметрыОтчета.ОтчетнаяДата);
		ДокументРезультат.Вывести(ТабДокНауфор);
		Возврат;
	КонецЕсли;
	
	ТаблицаСКД = ПреобразоватьТаблицуДляСКД(ТаблицаДанных);
	ДополнитьСхемуСКДПолямиТаблицы(ТаблицаСКД);
	
	ВнешнийНабор = Новый Структура("ДанныеОтчета", ТаблицаСКД);
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешнийНабор, ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Возвращает ключ текущего варианта настроек СКД
//
// Возвращаемое значение:
//  Строка - «НАУФОР» или «Аналитический»
//
Функция ПолучитьКлючВариантаОтчета()
	
	КлючВарианта = "Аналитический";
	ДопСвойства = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства;
	
	Если ДопСвойства.Свойство("КлючВарианта", КлючВарианта) Тогда
		Возврат КлючВарианта;
	КонецЕсли;
	
	Возврат "Аналитический";
	
КонецФункции

// Описание: Читает параметры формирования из настроек СКД с подстановкой значений реквизитов отчета
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - текущие настройки компоновщика
//
// Возвращаемое значение:
//  Структура - параметры для ПолучитьДанныеОтчета
//
Функция ПолучитьПараметрыИзНастроекСКД(Настройки)
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ОтчетнаяДата", ПолучитьЗначениеПараметраСКД(Настройки, "ОтчетнаяДата", ОтчетнаяДата));
	ПараметрыОтчета.Вставить("УправляющаяКомпания", ПолучитьЗначениеПараметраСКД(Настройки, "УправляющаяКомпания", УправляющаяКомпания));
	ПараметрыОтчета.Вставить("ТипКлиентаДУ", ПолучитьЗначениеПараметраСКД(Настройки, "ТипКлиентаДУ", ТипКлиентаДУ));
	ПараметрыОтчета.Вставить("ЛицензияПУРЦБ", ПолучитьЗначениеПараметраСКД(Настройки, "ЛицензияПУРЦБ", ЛицензияПУРЦБ));
	ПараметрыОтчета.Вставить("ЛицензияНПФ", ПолучитьЗначениеПараметраСКД(Настройки, "ЛицензияНПФ", ЛицензияНПФ));
	
	Возврат ПараметрыОтчета;
	
КонецФункции

// Описание: Возвращает значение параметра данных СКД
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - настройки компоновки
//  ИмяПараметра - Строка - имя параметра схемы
//  ЗначениеПоУмолчанию - Произвольный - значение при отсутствии параметра
//
// Возвращаемое значение:
//  Произвольный - значение параметра
//
Функция ПолучитьЗначениеПараметраСКД(Настройки, ИмяПараметра, ЗначениеПоУмолчанию)
	
	ЭлементПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	Если ЭлементПараметра <> Неопределено Тогда
		Если ТипЗнч(ЭлементПараметра.Значение) = Тип("Булево") Тогда
			Возврат ЭлементПараметра.Значение;
		ИначеЕсли ЗначениеЗаполнено(ЭлементПараметра.Значение) Тогда
			Возврат ЭлементПараметра.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

// Описание: Сохраняет параметры формирования в реквизиты объекта отчета
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры формирования
//
Процедура СохранитьПараметрыВАтрибуты(ПараметрыОтчета)
	
	ОтчетнаяДата = ПараметрыОтчета.ОтчетнаяДата;
	УправляющаяКомпания = ПараметрыОтчета.УправляющаяКомпания;
	ТипКлиентаДУ = ПараметрыОтчета.ТипКлиентаДУ;
	ЛицензияПУРЦБ = ПараметрыОтчета.ЛицензияПУРЦБ;
	ЛицензияНПФ = ПараметрыОтчета.ЛицензияНПФ;
	
КонецПроцедуры

// Описание: Возвращает таблицу для набора данных СКД (все колонки, включая реквизиты ДоговорДУ)
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - результат ПолучитьДанныеОтчета
//
// Возвращаемое значение:
//  ТаблицаЗначений - данные для внешнего набора «ДанныеОтчета»
//
Функция ПреобразоватьТаблицуДляСКД(ТаблицаДанных)
	
	Возврат ТаблицаДанных;
	
КонецФункции

// Описание: Добавляет в схему СКД поля таблицы данных, отсутствующие в макете (реквизиты ДоговорДУ и др.)
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица для внешнего набора данных
//
Процедура ДополнитьСхемуСКДПолямиТаблицы(ТаблицаДанных)
	
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Найти("ДанныеОтчета");
	Если НаборДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МетаДоговорДУ = Метаданные.Справочники.ДоговорДУ;
	
	Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
		
		Если НаборДанных.Поля.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле = Колонка.Имя;
		НовоеПоле.ПутьКДанным = Колонка.Имя;
		НовоеПоле.Заголовок = ПолучитьЗаголовокПоляСКД(Колонка.Имя, МетаДоговорДУ);
		НовоеПоле.ТипЗначения = Колонка.ТипЗначения;
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Возвращает заголовок поля СКД по имени колонки и метаданным справочника ДоговорДУ
//
// Параметры:
//  ИмяПоля - Строка - имя колонки таблицы данных
//  МетаДоговорДУ - ОбъектМетаданныхСправочник - метаданные справочника ДоговорДУ
//
// Возвращаемое значение:
//  Строка - представление поля для пользователя
//
Функция ПолучитьЗаголовокПоляСКД(ИмяПоля, МетаДоговорДУ)
	
	Реквизит = МетаДоговорДУ.Реквизиты.Найти(ИмяПоля);
	Если Реквизит <> Неопределено Тогда
		Возврат "Договор ДУ: " + Реквизит.Представление();
	КонецЕсли;
	
	Если ИмяПоля = "НаименованиеКлиента" Тогда
		Возврат "Наименование организации / ФИО";
	ИначеЕсли ИмяПоля = "НомерДоговора" Тогда
		Возврат "Договор ДУ: Код";
	ИначеЕсли ИмяПоля = "ДатаЗаключения" Тогда
		Возврат "Договор ДУ: Дата начала";
	ИначеЕсли ИмяПоля = "ДоговорПредставление" Тогда
		Возврат "Договор ДУ (номер, дата)";
	ИначеЕсли ИмяПоля = "ТипКлиента" Тогда
		Возврат "Тип клиента (представление)";
	КонецЕсли;
	
	Возврат ИмяПоля;
	
КонецФункции

#Область ДанныеОтчета

// Логика расчета - снимок регламентного отчета внОтчетНАУФОР_КамеральнаяПроверка v1.24.
// Регламентный отчет не изменяется; при правках ТЗ синхронизировать вручную.

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

// Описание: Формирует таблицу данных отчета по действующим договорам ДУ с учетом фильтров ТЗ.
// Исключаются договоры с датой заключения позже отчетной даты, уже закрытые на отчетную дату
// и договоры с уведомлением о расторжении на отчетную дату или ранее.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры отбора и формирования отчета
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки отчета с заполненными колонками
//
Функция ПолучитьДанныеОтчета(ПараметрыОтчета)
	
	ОтчетнаяДатаНачало = НачалоДня(ПараметрыОтчета.ОтчетнаяДата);
	ОтчетнаяДата = КонецДня(ПараметрыОтчета.ОтчетнаяДата);
	ТипыКлиентов = ПолучитьДопустимыеТипыКлиентов(ПараметрыОтчета);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорДУ.Ссылка КАК ДоговорДУ,
	|	ДоговорДУ.Клиент.Наименование КАК НаименованиеКлиента,
	|	ДоговорДУ.Клиент КАК Клиент,
	|	ДоговорДУ.Код КАК НомерДоговора,
	|	ДоговорДУ.ДатаНачала КАК ДатаЗаключения,
	|	ДоговорДУ.ТипКлиентаДУ КАК ТипКлиентаДУ,
	|	ПРЕДСТАВЛЕНИЕ(ДоговорДУ.ТипКлиентаДУ) КАК ТипКлиента,
	|	ДоговорДУ.СрокДействия КАК СрокДействия,
	|	ДоговорДУ.ДействуетДо КАК ДействуетДо,
	|	ДоговорДУ.ПролонгацияДоговора КАК ПролонгацияДоговора,
	|	ДоговорДУ.ДатаВводаСредствВДУ КАК ДатаВводаСредствВДУ,
	|	ДоговорДУ.Блокировка КАК Блокировка,
	|	ДоговорДУ.Валюта КАК Валюта,
	|	ДоговорДУ.ВидУслугПоДоговору КАК ВидУслугПоДоговору,
	|	ДоговорДУ.ВнешнийКод КАК ВнешнийКод,
	|	ДоговорДУ.ДатаВозобновленияУправления КАК ДатаВозобновленияУправления,
	|	ДоговорДУ.ДатаНачалаРасчетаВознаграждений КАК ДатаНачалаРасчетаВознаграждений,
	|	ДоговорДУ.ДатаОкончания КАК ДатаОкончания,
	|	ДоговорДУ.ДатаПолученияОригиналаДоговора КАК ДатаПолученияОригиналаДоговора,
	|	ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ КАК ДатаПолученияУведомленияОРасторженииДоговораДУ,
	|	ДоговорДУ.ДатаПриостановкиУправления КАК ДатаПриостановкиУправления,
	|	ДоговорДУ.ДатаРепортингаПУРЦБ КАК ДатаРепортингаПУРЦБ,
	|	ДоговорДУ.ДатаЦессии КАК ДатаЦессии,
	|	ДоговорДУ.ИнформационнаяПлощадка КАК ИнформационнаяПлощадка,
	|	ДоговорДУ.Комментарий КАК Комментарий,
	|	ДоговорДУ.ОбменСДУЧерезОтчетБрокера КАК ОбменСДУЧерезОтчетБрокера,
	|	ДоговорДУ.ПолноеНаименование КАК ПолноеНаименование,
	|	ДоговорДУ.Портфель КАК Портфель,
	|	ДоговорДУ.Префикс КАК Префикс,
	|	ДоговорДУ.Пул КАК Пул,
	|	ДоговорДУ.СрокИИС КАК СрокИИС,
	|	ДоговорДУ.ТипИИС КАК ТипИИС,
	|	ДоговорДУ.ТолькоЛицензияПУРЦБ КАК ТолькоЛицензияПУРЦБ,
	|	ДоговорДУ.УправляющаяКомпания КАК УправляющаяКомпанияДоговора,
	|	ДоговорДУ.УчетДСНаЕдиномРС КАК УчетДСНаЕдиномРС,
	|	ДоговорДУ.Цессия КАК Цессия
	|ИЗ
	|	Справочник.ДоговорДУ КАК ДоговорДУ
	|ГДЕ
	|	НЕ ДоговорДУ.ПометкаУдаления
	|	И (ДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ДоговорДУ.ДатаОкончания > &ОтчетнаяДата)
	|	И ДоговорДУ.ДатаНачала <= &ОтчетнаяДата
	|	И ДоговорДУ.УправляющаяКомпания = &УправляющаяКомпания
	|	И (&БезОтбораПоТипу ИЛИ ДоговорДУ.ТипКлиентаДУ = &ТипКлиентаДУ)
	|	И (&БезОтбораПоЛицензии ИЛИ ДоговорДУ.ТипКлиентаДУ В (&ТипыКлиентов))
	|	И ВЫБОР
	|			КОГДА ДоговорДУ.ТолькоЛицензияПУРЦБ
	|					И ДоговорДУ.ДатаРепортингаПУРЦБ <> ДАТАВРЕМЯ(1, 1, 1)
	|					И &ОтчетнаяДатаНачало > ДоговорДУ.ДатаРепортингаПУРЦБ
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <> ДАТАВРЕМЯ(1, 1, 1)
	|					И НАЧАЛОПЕРИОДА(ДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ, ДЕНЬ) <= &ОтчетнаяДатаНачало
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НаименованиеКлиента,
	|	НомерДоговора";
	
	Запрос.УстановитьПараметр("УправляющаяКомпания", ПараметрыОтчета.УправляющаяКомпания);
	Запрос.УстановитьПараметр("ОтчетнаяДата", ОтчетнаяДата);
	Запрос.УстановитьПараметр("ОтчетнаяДатаНачало", ОтчетнаяДатаНачало);
	Запрос.УстановитьПараметр("ТипКлиентаДУ", ПараметрыОтчета.ТипКлиентаДУ);
	Запрос.УстановитьПараметр("БезОтбораПоТипу", Не ЗначениеЗаполнено(ПараметрыОтчета.ТипКлиентаДУ));
	Запрос.УстановитьПараметр("БезОтбораПоЛицензии", ТипыКлиентов = Неопределено);
	Запрос.УстановитьПараметр("ТипыКлиентов", ?(ТипыКлиентов = Неопределено, Новый Массив, ТипыКлиентов));
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	
	ДобавитьКолонкиОтчета(ТаблицаДанных);
	ЗаполнитьДатыСделок(ТаблицаДанных, ОтчетнаяДата);
	ЗаполнитьДанныеКвалификации(ТаблицаДанных, ОтчетнаяДата, ПараметрыОтчета.УправляющаяКомпания);
	ЗаполнитьДанныеПрофилирования(ТаблицаДанных, ОтчетнаяДата);
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		ЗаполнитьСтрокуОтчета(СтрокаДанных, ОтчетнаяДата);
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

// Описание: Возвращает список типов клиентов для отбора по выбранным лицензиям ПУРЦБ/НПФ
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры отчета с флагами ЛицензияПУРЦБ и ЛицензияНПФ
//
// Возвращаемое значение:
//  Массив, Неопределено - типы клиентов для отбора; Неопределено, если фильтр по лицензии не задан
//
Функция ПолучитьДопустимыеТипыКлиентов(ПараметрыОтчета)
	
	Если Не ПараметрыОтчета.ЛицензияПУРЦБ И Не ПараметрыОтчета.ЛицензияНПФ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипыКлиентов = Новый Массив;
	
	Если ПараметрыОтчета.ЛицензияНПФ Тогда
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.ПенсионныеРезервыНПФ);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеЧерезНПФ);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеПФР);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.ВоеннаяИпотека);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.СобственныеСредстваНПФ);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.СаморегулируемыеОрганизации);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.ФондЦелевогоКапитала);
	КонецЕсли;
	
	Если ПараметрыОтчета.ЛицензияПУРЦБ Тогда
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.ФизическиеЛица);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.ЮридическиеЛица);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.ФондЦелевогоКапитала);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.СаморегулируемыеОрганизации);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.СтраховыеКомпании);
		ТипыКлиентов.Добавить(Перечисления.ТипыКлиентовДУ.СобственныеСредстваСК);
	КонецЕсли;
	
	Возврат ТипыКлиентов;
	
КонецФункции

Процедура ДобавитьКолонкиОтчета(ТаблицаДанных)
	
	ТаблицаДанных.Колонки.Добавить("ДоговорПредставление", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("ДатаПролонгации", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("СтратегияИндивидуальная", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("СтратегияСтандартная", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("КоммерческаяОрганизация", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("НекоммерческаяОрганизация", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("Квалифицированный", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("Неквалифицированный", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("ДатаПрофилирования", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ПересмотрПрофиля", Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("ДатаПервойСделки", Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ДатаПоследнейСделки", Новый ОписаниеТипов("Дата"));
	
КонецПроцедуры

// Описание: Заполняет колонки 2-9 одной строки отчета по правилам ТЗ
//
// Параметры:
//  СтрокаДанных - СтрокаТаблицыЗначений - строка таблицы данных отчета
//  ОтчетнаяДата - Дата - отчетная дата (конец дня)
//
Процедура ЗаполнитьСтрокуОтчета(СтрокаДанных, ОтчетнаяДата)
	
	СтрокаДанных.ДоговорПредставление = Строка(СтрокаДанных.НомерДоговора) + " от "
		+ Формат(СтрокаДанных.ДатаЗаключения, "ДФ=dd.MM.yyyy");
	СтрокаДанных.ДатаПролонгации = РассчитатьДатуПоследнейПролонгации(
		СтрокаДанных.ДатаЗаключения,
		СтрокаДанных.СрокДействия,
		СтрокаДанных.ДействуетДо,
		СтрокаДанных.ПролонгацияДоговора,
		ОтчетнаяДата);
	СтрокаДанных.СтратегияИндивидуальная = "Индивидуальная";
	СтрокаДанных.СтратегияСтандартная = "";
	
	СтрокаДанных.ФизическоеЛицо = "";
	СтрокаДанных.КоммерческаяОрганизация = "";
	СтрокаДанных.НекоммерческаяОрганизация = "";
	
	Если СтрокаДанных.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ФизическиеЛица Тогда
		СтрокаДанных.ФизическоеЛицо = "Физическое лицо";
	ИначеЕсли СтрокаДанных.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ФондЦелевогоКапитала
		Или СтрокаДанных.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.СаморегулируемыеОрганизации Тогда
		СтрокаДанных.НекоммерческаяОрганизация = "Некоммерческая организация";
	ИначеЕсли ЭтоКоммерческийТипКлиентаДУ(СтрокаДанных.ТипКлиентаДУ) Тогда
		СтрокаДанных.КоммерческаяОрганизация = "Коммерческая организация";
	КонецЕсли;
	
КонецПроцедуры

// Описание: Определяет, относится ли тип клиента ДУ к коммерческим организациям (колонка 8 отчета)
//
// Параметры:
//  ТипКлиентаДУ - ПеречислениеСсылка.ТипыКлиентовДУ - тип клиента по договору ДУ
//
// Возвращаемое значение:
//  Булево - Истина, если в колонку 8 выводится «Коммерческая организация»
//
Функция ЭтоКоммерческийТипКлиентаДУ(ТипКлиентаДУ)
	
	Возврат ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ЮридическиеЛица
		Или ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ПенсионныеРезервыНПФ
		Или ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеЧерезНПФ
		Или ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ПенсионныеНакопленияГражданПереданныеПФР
		Или ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ВоеннаяИпотека
		Или ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.СобственныеСредстваНПФ
		Или ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.СтраховыеКомпании
		Или ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.СобственныеСредстваСК
		Или ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ГарантийныеФонда;
	
КонецФункции

// Описание: Рассчитывает дату последней пролонгации договора ДУ на отчетную дату
// Правила: файл «Даты пролонгации.xlsx» - шаг пролонгации в днях (срок в годах * 365).
// Флаг «Пролонгация договора» обязателен только при заполненном «Действует до».
//
// Параметры:
//  ДатаЗаключения - Дата - дата начала договора
//  СрокДействия - Число - срок в годах (если > 100, трактуется как количество дней)
//  ДействуетДо - Дата - ограничение действия договора
//  ПролонгацияДоговора - Булево - признак пролонгации
//  ОтчетнаяДата - Дата - дата отчета
//
// Возвращаемое значение:
//  Дата - дата последней пролонгации; пустая дата, если не применимо
//
Функция РассчитатьДатуПоследнейПролонгации(ДатаЗаключения, СрокДействия, ДействуетДо, ПролонгацияДоговора, ОтчетнаяДата)
	
	ПустаяДата = Дата(1, 1, 1);
	ОтчетнаяДатаСравнение = НачалоДня(ОтчетнаяДата);
	ДействуетДоЗаполнено = ЗначениеЗаполнено(ДействуетДо) И ДействуетДо <> ПустаяДата;
	
	Если ДействуетДоЗаполнено Тогда
		Если Не ПролонгацияДоговора Тогда
			Возврат ПустаяДата;
		КонецЕсли;
		Если ДействуетДо < ОтчетнаяДатаСравнение
			И (Не ЗначениеЗаполнено(СрокДействия) Или СрокДействия = 0) Тогда
			Возврат ПустаяДата;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СрокДействия) Или СрокДействия = 0 Тогда
		Возврат ПустаяДата;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаЗаключения) Или ДатаЗаключения = ПустаяДата Тогда
		Возврат ПустаяДата;
	КонецЕсли;
	
	Если СрокДействия > 100 Тогда
		СрокДней = СрокДействия;
	Иначе
		СрокДней = СрокДействия * 365;
	КонецЕсли;
	
	ДатаПролонгации = НачалоДня(ДатаЗаключения);
	ПоследняяПролонгация = ПустаяДата;
	СекундВСутках = 86400;
	
	Пока Истина Цикл
		
		СледующаяПролонгация = ДатаПролонгации + СрокДней * СекундВСутках;
		
		Если СледующаяПролонгация > ОтчетнаяДатаСравнение Тогда
			Прервать;
		КонецЕсли;
		
		Если ДействуетДоЗаполнено И СледующаяПролонгация > НачалоДня(ДействуетДо) Тогда
			Прервать;
		КонецЕсли;
		
		ДатаПролонгации = СледующаяПролонгация;
		ПоследняяПролонгация = ДатаПролонгации;
		
	КонецЦикла;
	
	Возврат ПоследняяПролонгация;
	
КонецФункции

// Описание: Заполняет колонки 14 и 15 (номера 13 и 14 в шапке) - даты первой и последней сделки по договорам.
// Общий набор источников; по договору MIN и MAX даты (календарный день <= отчетной, проведен, не удален).
// Где есть ВидОперации - отбор купля/продажа (или прямой/обратный РЕПО).
// - ОткрытиеПлановойПозиции.Дата
// - СделкаРЕПОПерваяНога.Дата
// - СделкаНаСрочномРынке.Дата
// - Сделка: Сделка.Дата или Сделка.БизнесПроцесс.Дата (если БП заполнен)
// Если сделок нет - колонки остаются пустыми.
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица строк отчета
//  ОтчетнаяДата - Дата - отчетная дата (нормализуется к началу дня для отбора)
//
Процедура ЗаполнитьДатыСделок(ТаблицаДанных, ОтчетнаяДата)
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОтчетнаяДатаДень = НачалоДня(ОтчетнаяДата);
	МассивДоговоров = ТаблицаДанных.ВыгрузитьКолонку("ДоговорДУ");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сделки.ДоговорДУ КАК ДоговорДУ,
	|	МИНИМУМ(Сделки.ДатаСделки) КАК ДатаПервойСделки,
	|	МАКСИМУМ(Сделки.ДатаСделки) КАК ДатаПоследнейСделки
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОткрытиеПлановойПозиции.ДоговорДУ КАК ДоговорДУ,
	|		ОткрытиеПлановойПозиции.Дата КАК ДатаСделки
	|	ИЗ
	|		Документ.ОткрытиеПлановойПозиции КАК ОткрытиеПлановойПозиции
	|	ГДЕ
	|		ОткрытиеПлановойПозиции.Проведен
	|		И НЕ ОткрытиеПлановойПозиции.ПометкаУдаления
	|		И ОткрытиеПлановойПозиции.ДоговорДУ В (&ДоговорыДУ)
	|		И НАЧАЛОПЕРИОДА(ОткрытиеПлановойПозиции.Дата, ДЕНЬ) <= &ОтчетнаяДатаДень
	|		И ОткрытиеПлановойПозиции.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа))
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		СделкаРЕПОПерваяНога.ДоговорДУ,
	|		СделкаРЕПОПерваяНога.Дата
	|	ИЗ
	|		Документ.СделкаРЕПОПерваяНога КАК СделкаРЕПОПерваяНога
	|	ГДЕ
	|		СделкаРЕПОПерваяНога.Проведен
	|		И НЕ СделкаРЕПОПерваяНога.ПометкаУдаления
	|		И СделкаРЕПОПерваяНога.ДоговорДУ В (&ДоговорыДУ)
	|		И НАЧАЛОПЕРИОДА(СделкаРЕПОПерваяНога.Дата, ДЕНЬ) <= &ОтчетнаяДатаДень
	|		И СделкаРЕПОПерваяНога.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаРЕПО.ПрямойРЕПО), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаРЕПО.ОбратныйРЕПО))
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		СделкаНаСрочномРынке.ДоговорДУ,
	|		СделкаНаСрочномРынке.Дата
	|	ИЗ
	|		Документ.СделкаНаСрочномРынке КАК СделкаНаСрочномРынке
	|	ГДЕ
	|		СделкаНаСрочномРынке.Проведен
	|		И НЕ СделкаНаСрочномРынке.ПометкаУдаления
	|		И СделкаНаСрочномРынке.ДоговорДУ В (&ДоговорыДУ)
	|		И НАЧАЛОПЕРИОДА(СделкаНаСрочномРынке.Дата, ДЕНЬ) <= &ОтчетнаяДатаДень
	|		И СделкаНаСрочномРынке.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаНаСрочномРынке.Покупка), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделкаНаСрочномРынке.Продажа))
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Сделка.ДоговорДУ,
	|		ВЫБОР
	|			КОГДА Сделка.БизнесПроцесс = НЕОПРЕДЕЛЕНО
	|				ТОГДА Сделка.Дата
	|			ИНАЧЕ Сделка.БизнесПроцесс.Дата
	|		КОНЕЦ
	|	ИЗ
	|		Документ.Сделка КАК Сделка
	|	ГДЕ
	|		Сделка.Проведен
	|		И НЕ Сделка.ПометкаУдаления
	|		И Сделка.ДоговорДУ В (&ДоговорыДУ)
	|		И НАЧАЛОПЕРИОДА(
	|			ВЫБОР
	|				КОГДА Сделка.БизнесПроцесс = НЕОПРЕДЕЛЕНО
	|					ТОГДА Сделка.Дата
	|				ИНАЧЕ Сделка.БизнесПроцесс.Дата
	|			КОНЕЦ, ДЕНЬ) <= &ОтчетнаяДатаДень
	|		И Сделка.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа))) КАК Сделки
	|
	|СГРУППИРОВАТЬ ПО
	|	Сделки.ДоговорДУ";
	
	Запрос.УстановитьПараметр("ДоговорыДУ", МассивДоговоров);
	Запрос.УстановитьПараметр("ОтчетнаяДатаДень", ОтчетнаяДатаДень);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СоответствиеСделок = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		СоответствиеСделок.Вставить(Выборка.ДоговорДУ, Новый Структура("ДатаПервой, ДатаПоследней",
			Выборка.ДатаПервойСделки, Выборка.ДатаПоследнейСделки));
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		ДанныеСделок = СоответствиеСделок.Получить(СтрокаДанных.ДоговорДУ);
		Если ДанныеСделок <> Неопределено Тогда
			СтрокаДанных.ДатаПервойСделки = ДанныеСделок.ДатаПервой;
			СтрокаДанных.ДатаПоследнейСделки = ДанныеСделок.ДатаПоследней;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Описание: Заполняет колонки 10-11 по регистру ДействующиеКвалИнвесторы на отчетную дату
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица строк отчета
//  ОтчетнаяДата - Дата - отчетная дата (конец дня)
//  УправляющаяКомпания - СправочникСсылка.УправляющиеКомпании - УК отчета
//
Процедура ЗаполнитьДанныеКвалификации(ТаблицаДанных, ОтчетнаяДата, УправляющаяКомпания)
	
	МассивКлиентов = Новый Массив;
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		СтрокаДанных.Квалифицированный = "";
		СтрокаДанных.Неквалифицированный = "";
		Если ЗначениеЗаполнено(СтрокаДанных.Клиент) Тогда
			МассивКлиентов.Добавить(СтрокаДанных.Клиент);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивКлиентов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДействующиеКвалИнвесторыСрез.Контрагент КАК Контрагент,
	|	ДействующиеКвалИнвесторыСрез.ВключенВРеестр КАК ВключенВРеестр
	|ИЗ
	|	РегистрСведений.ДействующиеКвалИнвесторы.СрезПоследних(
	|			&ОтчетнаяДата,
	|			Контрагент В (&Контрагенты)
	|				И УправляющаяКомпания = &УправляющаяКомпания) КАК ДействующиеКвалИнвесторыСрез";
	
	Запрос.УстановитьПараметр("ОтчетнаяДата", ОтчетнаяДата);
	Запрос.УстановитьПараметр("Контрагенты", МассивКлиентов);
	Запрос.УстановитьПараметр("УправляющаяКомпания", УправляющаяКомпания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СоответствиеКвалификации = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		СоответствиеКвалификации.Вставить(Выборка.Контрагент, Выборка.ВключенВРеестр);
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаДанных.Клиент) Тогда
			Продолжить;
		КонецЕсли;
		
		ВключенВРеестр = СоответствиеКвалификации.Получить(СтрокаДанных.Клиент);
		Если ВключенВРеестр = Истина Тогда
			СтрокаДанных.Квалифицированный = "квалифицированный";
		Иначе
			СтрокаДанных.Неквалифицированный = "неквалифицированный";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Заполняет колонки 12-13 по документам ИнвестиционныйПрофиль на отчетную дату
// Колонка 12 - дата последнего профилирования (последний документ на отчетную дату)
// Колонка 13 - "Да", если несколько документов с разными датами; иначе "Нет"
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица строк отчета
//  ОтчетнаяДата - Дата - отчетная дата (конец дня)
//
Процедура ЗаполнитьДанныеПрофилирования(ТаблицаДанных, ОтчетнаяДата)
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		СтрокаДанных.ПересмотрПрофиля = "Нет";
	КонецЦикла;
	
	МассивДоговоров = ТаблицаДанных.ВыгрузитьКолонку("ДоговорДУ");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИнвестиционныйПрофиль.ДоговорДУ КАК ДоговорДУ,
	|	ИнвестиционныйПрофиль.Дата КАК Дата
	|ПОМЕСТИТЬ ВТ_Профили
	|ИЗ
	|	Документ.ИнвестиционныйПрофиль КАК ИнвестиционныйПрофиль
	|ГДЕ
	|	ИнвестиционныйПрофиль.Проведен
	|	И НЕ ИнвестиционныйПрофиль.ПометкаУдаления
	|	И ИнвестиционныйПрофиль.ДоговорДУ В (&ДоговорыДУ)
	|	И ИнвестиционныйПрофиль.Дата <= &ОтчетнаяДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Профили.ДоговорДУ КАК ДоговорДУ,
	|	МАКСИМУМ(ВТ_Профили.Дата) КАК ДатаПрофилирования,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ НАЧАЛОПЕРИОДА(ВТ_Профили.Дата, ДЕНЬ)) КАК КоличествоДат
	|ИЗ
	|	ВТ_Профили КАК ВТ_Профили
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Профили.ДоговорДУ";
	
	Запрос.УстановитьПараметр("ДоговорыДУ", МассивДоговоров);
	Запрос.УстановитьПараметр("ОтчетнаяДата", ОтчетнаяДата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СоответствиеПрофилей = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		СоответствиеПрофилей.Вставить(Выборка.ДоговорДУ, Новый Структура("Дата, КоличествоДат",
			Выборка.ДатаПрофилирования, Выборка.КоличествоДат));
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		ДанныеПрофиля = СоответствиеПрофилей.Получить(СтрокаДанных.ДоговорДУ);
		Если ДанныеПрофиля <> Неопределено Тогда
			СтрокаДанных.ДатаПрофилирования = ДанныеПрофиля.Дата;
			Если ДанныеПрофиля.КоличествоДат > 1 Тогда
				СтрокаДанных.ПересмотрПрофиля = "Да";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Описание: Формирует табличный документ отчета по подготовленной таблице данных
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - строки отчета с заполненными колонками
//  ОтчетнаяДата - Дата - отчетная дата для заголовка
//
// Возвращаемое значение:
//  ТабличныйДокумент - сформированный отчет
//
Функция СформироватьТабличныйДокумент(ТаблицаДанных, ОтчетнаяДата)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	КоличествоКолонок = 15;
	Заголовки = Новый Массив;
	Заголовки.Добавить("Наименование организации / ФИО");
	Заголовки.Добавить("Договор ДУ (номер, дата заключения)");
	Заголовки.Добавить("Дата последней пролонгации");
	Заголовки.Добавить("Стратегия индивидуальная");
	Заголовки.Добавить("Стратегия стандартная");
	Заголовки.Добавить("Физическое лицо");
	Заголовки.Добавить("Тип клиента");
	Заголовки.Добавить("Коммерческая организация");
	Заголовки.Добавить("Некоммерческая организация");
	Заголовки.Добавить("Квалифицированный инвестор");
	Заголовки.Добавить("Неквалифицированный инвестор");
	Заголовки.Добавить("Дата последнего профилирования");
	Заголовки.Добавить("Пересмотр инвестиционного профиля");
	Заголовки.Добавить("Дата первой сделки");
	Заголовки.Добавить("Дата последней сделки");
	
	ТекстЗаголовка = НаименованиеОтчета() + " на " + Формат(ОтчетнаяДата, "ДФ=dd.MM.yyyy");
	
	СтрокаЗаголовок = Новый ТабличныйДокумент;
	ОбластьЗаголовок = СтрокаЗаголовок.Область(1, 1, 1, КоличествоКолонок);
	ОбластьЗаголовок.Объединить();
	ОбластьЗаголовок.Текст = ТекстЗаголовка;
	ОбластьЗаголовок.Шрифт = Новый Шрифт(, , Истина);
	ОбластьЗаголовок.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ТабДок.Вывести(СтрокаЗаголовок);
	
	СтрокаШапка = Новый ТабличныйДокумент;
	Для НомерКолонки = 1 По КоличествоКолонок Цикл
		Область = СтрокаШапка.Область(1, НомерКолонки, 1, НомерКолонки);
		Область.Текст = Заголовки[НомерКолонки - 1];
		Область.Шрифт = Новый Шрифт(, , Истина);
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		ОбвестиЯчейку(Область);
	КонецЦикла;
	ТабДок.Вывести(СтрокаШапка);
	
	СтрокаНомераКолонок = Новый ТабличныйДокумент;
	Для ФизическийНомерКолонки = 1 По КоличествоКолонок Цикл
		Область = СтрокаНомераКолонок.Область(1, ФизическийНомерКолонки, 1, ФизическийНомерКолонки);
		Область.Текст = НомерКолонкиВШапкеОтчета(ФизическийНомерКолонки);
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		ОбвестиЯчейку(Область);
	КонецЦикла;
	ТабДок.Вывести(СтрокаНомераКолонок);
	
	НомерСтроки = ТабДок.ВысотаТаблицы + 1;
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		ТабДок.Область(НомерСтроки, 1).Текст = СтрокаДанных.НаименованиеКлиента;
		ТабДок.Область(НомерСтроки, 2).Текст = СтрокаДанных.ДоговорПредставление;
		ТабДок.Область(НомерСтроки, 3).Текст = ФорматДаты(СтрокаДанных.ДатаПролонгации);
		ТабДок.Область(НомерСтроки, 4).Текст = СтрокаДанных.СтратегияИндивидуальная;
		ТабДок.Область(НомерСтроки, 5).Текст = СтрокаДанных.СтратегияСтандартная;
		ТабДок.Область(НомерСтроки, 6).Текст = СтрокаДанных.ФизическоеЛицо;
		ТабДок.Область(НомерСтроки, 7).Текст = СтрокаДанных.ТипКлиента;
		ТабДок.Область(НомерСтроки, 8).Текст = СтрокаДанных.КоммерческаяОрганизация;
		ТабДок.Область(НомерСтроки, 9).Текст = СтрокаДанных.НекоммерческаяОрганизация;
		ТабДок.Область(НомерСтроки, 10).Текст = СтрокаДанных.Квалифицированный;
		ТабДок.Область(НомерСтроки, 11).Текст = СтрокаДанных.Неквалифицированный;
		ТабДок.Область(НомерСтроки, 12).Текст = ФорматДаты(СтрокаДанных.ДатаПрофилирования);
		ТабДок.Область(НомерСтроки, 13).Текст = СтрокаДанных.ПересмотрПрофиля;
		ТабДок.Область(НомерСтроки, 14).Текст = ФорматДаты(СтрокаДанных.ДатаПервойСделки);
		ТабДок.Область(НомерСтроки, 15).Текст = ФорматДаты(СтрокаДанных.ДатаПоследнейСделки);
		ОбвестиТаблицуОтчета(ТабДок, НомерСтроки, НомерСтроки, КоличествоКолонок);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	УстановитьШиринуКолонок(ТабДок, КоличествоКолонок);
	ТабДок.ФиксацияСверху = 3;
	Возврат ТабДок;
	
КонецФункции

// Описание: Обводит ячейку табличного документа сплошной рамкой
// Аналог: внПортфельКлиента, процедура ДВ_ОбвестиЯчейку
//
// Параметры:
//  Область - ОбластьЯчеекТабличногоДокумента - ячейка или диапазон для обводки
//
Процедура ОбвестиЯчейку(Область)
	
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Область.ГраницаСверху = Линия;
	Область.ГраницаСнизу = Линия;
	Область.ГраницаСлева = Линия;
	Область.ГраницаСправа = Линия;
	
КонецПроцедуры

// Описание: Обводит прямоугольную область таблицы отчета (шапка и строки данных)
//
// Параметры:
//  ТабДок - ТабличныйДокумент - формируемый отчет
//  НачалоСтроки - Число - первая строка области
//  КонецСтроки - Число - последняя строка области
//  КоличествоКолонок - Число - число колонок отчета
//
Процедура ОбвестиТаблицуОтчета(ТабДок, НачалоСтроки, КонецСтроки, КоличествоКолонок)
	
	Для НомерСтроки = НачалоСтроки По КонецСтроки Цикл
		Для НомерКолонки = 1 По КоличествоКолонок Цикл
			ОбвестиЯчейку(ТабДок.Область(НомерСтроки, НомерКолонки));
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Описание: Задает ширину колонок табличного документа отчета
//
// Параметры:
//  ТабДок - ТабличныйДокумент - формируемый отчет
//  КоличествоКолонок - Число - число колонок отчета
//
Процедура УстановитьШиринуКолонок(ТабДок, КоличествоКолонок)
	
	ШириныКолонок = Новый Массив;
	ШириныКолонок.Добавить(38);
	ШириныКолонок.Добавить(24);
	ШириныКолонок.Добавить(16);
	ШириныКолонок.Добавить(14);
	ШириныКолонок.Добавить(14);
	ШириныКолонок.Добавить(16);
	ШириныКолонок.Добавить(28);
	ШириныКолонок.Добавить(18);
	ШириныКолонок.Добавить(18);
	ШириныКолонок.Добавить(18);
	ШириныКолонок.Добавить(20);
	ШириныКолонок.Добавить(16);
	ШириныКолонок.Добавить(24);
	ШириныКолонок.Добавить(16);
	ШириныКолонок.Добавить(16);
	
	Для НомерКолонки = 1 По КоличествоКолонок Цикл
		ТабДок.Область(1, НомерКолонки).ШиринаКолонки = ШириныКолонок[НомерКолонки - 1];
	КонецЦикла;
	
КонецПроцедуры

// Описание: Возвращает строковое представление даты для ячейки отчета
//
// Параметры:
//  ЗначениеДаты - Дата - форматируемая дата
//
// Возвращаемое значение:
//  Строка - дата в формате dd.MM.yyyy или пустая строка
//
Функция ФорматДаты(ЗначениеДаты)
	
	Если Не ЗначениеЗаполнено(ЗначениеДаты) Или ЗначениеДаты = Дата(1, 1, 1) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Формат(ЗначениеДаты, "ДФ=dd.MM.yyyy");
	
КонецФункции

// Описание: Возвращает наименование отчета для регистрации в БСП, команд и заголовка печатной формы
//
// Возвращаемое значение:
//  Строка - синоним внешнего отчета
//
Функция НаименованиеОтчета()
	
	Возврат "Анкета УК НАУФОР (СКД, экспериментальный)";
	
КонецФункции

// Описание: Возвращает физический номер технической колонки «Тип клиента» (без номера в шапке)
//
// Возвращаемое значение:
//  Число - номер колонки в табличном документе
//
Функция НомерТехническойКолонкиТипКлиента()
	
	Возврат 7;
	
КонецФункции

// Описание: Возвращает номер колонки для строки нумерации шапки отчета
// Колонка «Тип клиента» - без номера; остальные после нее нумеруются с 7
//
// Параметры:
//  ФизическийНомерКолонки - Число - номер колонки в табличном документе
//
// Возвращаемое значение:
//  Строка - номер колонки для шапки или пустая строка для технической колонки
//
Функция НомерКолонкиВШапкеОтчета(ФизическийНомерКолонки)
	
	Если ФизическийНомерКолонки = НомерТехническойКолонкиТипКлиента() Тогда
		Возврат "";
	КонецЕсли;
	
	Если ФизическийНомерКолонки < НомерТехническойКолонкиТипКлиента() Тогда
		Возврат Строка(ФизическийНомерКолонки);
	КонецЕсли;
	
	Возврат Строка(ФизическийНомерКолонки - 1);
	
КонецФункции

#КонецОбласти

#КонецОбласти
