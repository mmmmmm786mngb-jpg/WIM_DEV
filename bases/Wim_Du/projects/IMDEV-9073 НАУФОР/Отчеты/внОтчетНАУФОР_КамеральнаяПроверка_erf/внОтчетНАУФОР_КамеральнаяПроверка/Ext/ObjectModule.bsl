КонецФункции

// Описание: Определяет, прошло ли с даты заключения договора до отчетной даты более 5 лет
//
// Параметры:
//  ДатаЗаключения - Дата - дата начала договора (ДатаНачала)
//  ОтчетнаяДатаНачалаДня - Дата - начало календарного дня отчетной даты
//
// Возвращаемое значение:
//  Булево - Истина, если с даты заключения по отчетную дату прошло строго больше 5 лет
//
Функция ДоговорСрокПревышаетПятьЛет(ДатаЗаключения, ОтчетнаяДатаНачалаДня)
	
	Если Не ЗначениеЗаполнено(ДатаЗаключения) Или ДатаЗаключения = Дата(1, 1, 1) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтчетнаяДатаНачалаДня) Или ОтчетнаяДатаНачалаДня = Дата(1, 1, 1) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ДобавитьМесяц(НачалоДня(ДатаЗаключения), 60) < НачалоДня(ОтчетнаяДатаНачалаДня);
	
КонецФункции

// Описание: Выделяет оранжевым фоном даты сделок, рассчитанные по периоду проверки (после обводки рамок)
//
// Параметры:
//  ТабДок - ТабличныйДокумент - формируемый отчет
//  ТаблицаДанных - ТаблицаЗначений - строки отчета
//  ПерваяСтрокаДанных - Число - номер первой строки данных в табличном документе
//
Процедура УстановитьЦветФонаДатСделокПериодаПроверки(ТабДок, ТаблицаДанных, ПерваяСтрокаДанных)
	
	ЦветФона = ЦветФонаДатыСделкиДлинногоДоговора();
	НомерСтроки = ПерваяСтрокаДанных;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		Если СтрокаДанных.ПерваяСделкаИзПериодаПроверки Тогда
			ТабДок.Область(НомерСтроки, НомерКолонкиДатыПервойСделки()).ЦветФона = ЦветФона;
		КонецЕсли;
		
		Если СтрокаДанных.ПоследняяСделкаИзПериодаПроверки Тогда
			ТабДок.Область(НомерСтроки, НомерКолонкиДатыПоследнейСделки()).ЦветФона = ЦветФона;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Определяет, нужна ли пометка «*» у даты первой сделки (требование НАУФОР)
//
// Параметры:
//  ДатаПервойСделки - Дата - минимальная дата сделок по договору
//  ПерваяСделкаИзПериодаПроверки - Булево - дата рассчитана для договора старше 5 лет на отчетную дату с 29.04.2024
//
// Возвращаемое значение:
//  Булево - Истина, если к дате добавляется суффикс «*»
//
Функция НужнаПометкаДатыПервойСделки(ДатаПервойСделки, ПерваяСделкаИзПериодаПроверки)
	
	Если Не ДатаСделкиЗаполнена(ДатаПервойСделки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПерваяСделкаИзПериодаПроверки;
	
КонецФункции

// Описание: Возвращает строковое представление даты первой сделки для ячейки отчета
//
// Параметры:
//  ЗначениеДаты - Дата - дата первой сделки по договору
//  ПерваяСделкаИзПериодаПроверки - Булево - признак расчета по периоду проверки для длинного договора
//
// Возвращаемое значение:
//  Строка - дата в формате dd.MM.yyyy, при необходимости с суффиксом «*»
//
Функция ФорматДатыПервойСделки(ЗначениеДаты, ПерваяСделкаИзПериодаПроверки)
	
	ТекстДаты = ФорматДаты(ЗначениеДаты);
	
	Если ПустаяСтрока(ТекстДаты) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НужнаПометкаДатыПервойСделки(ЗначениеДаты, ПерваяСделкаИзПериодаПроверки) Тогда
		Возврат ТекстДаты + "*";
	КонецЕсли;
	
	Возврат ТекстДаты;
	
КонецФункции

