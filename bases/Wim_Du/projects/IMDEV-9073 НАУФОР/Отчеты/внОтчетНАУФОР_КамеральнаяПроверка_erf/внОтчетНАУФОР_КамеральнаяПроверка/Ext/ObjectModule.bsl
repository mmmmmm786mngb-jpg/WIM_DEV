// Описание: Возвращает строковое представление даты для ячейки отчета
//
// Параметры:
//  ЗначениеДаты - Дата - форматируемая дата
//
// Возвращаемое значение:
//  Строка - дата в формате dd.MM.yyyy или пустая строка
//
Функция ФорматДаты(ЗначениеДаты)
	
	Если Не ЗначениеЗаполнено(ЗначениеДаты) Или ЗначениеДаты = Дата(1, 1, 1) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Формат(ЗначениеДаты, "ДФ=dd.MM.yyyy");
	
КонецФункции

// Описание: Проверяет, что дата сделки заполнена (не пустая и не 01.01.0001)
//
// Параметры:
//  ДатаСделки - Дата - проверяемая дата
//
// Возвращаемое значение:
//  Булево - Истина, если дату можно выводить в отчет
//
Функция ДатаСделкиЗаполнена(ДатаСделки)
	
	Возврат ЗначениеЗаполнено(ДатаСделки) И ДатаСделки <> Дата(1, 1, 1);
	
КонецФункции

