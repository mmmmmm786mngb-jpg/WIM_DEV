
&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Не СформироватьНаСервере() Тогда
		Сообщить("Нет данных для формирования отчета", СтатусСообщения.Важное);
	КонецЕсли;
	
КонецПроцедуры

// Описание: Формирует отчет на сервере и записывает результат в реквизит формы ТабДокумент
//
// Возвращаемое значение:
//  Булево - Истина, если отчет сформирован; Ложь при отсутствии данных
//
&НаСервере
Функция СформироватьНаСервере()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ОтчетнаяДата", Отчет.ОтчетнаяДата);
	ПараметрыОтчета.Вставить("УправляющаяКомпания", Отчет.УправляющаяКомпания);
	ПараметрыОтчета.Вставить("ТипКлиентаДУ", Отчет.ТипКлиентаДУ);
	ПараметрыОтчета.Вставить("ЛицензияПУРЦБ", Отчет.ЛицензияПУРЦБ);
	ПараметрыОтчета.Вставить("ЛицензияНПФ", Отчет.ЛицензияНПФ);
	
	ТабДок = ОтчетОбъект.СформироватьОтчет(ПараметрыОтчета);
	
	Если ТабДок = Неопределено Тогда
		ТабДокумент.Очистить();
		Возврат Ложь;
	КонецЕсли;
	
	ТабДокумент = ТабДок;
	Возврат Истина;
	
КонецФункции

// Описание: Проверяет, что в реквизите формы есть сформированный табличный документ
//
// Возвращаемое значение:
//  Булево - Истина, если табличный документ заполнен
//
&НаСервере
Функция ТабличныйДокументЗаполнен()
	
	Возврат ТабДокумент.ВысотаТаблицы > 0;
	
КонецФункции

&НаКлиенте
Процедура СохранитьExcel(Команда)
	
	СохранитьОтчетНаКлиенте("xlsx");
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьWord(Команда)
	
	СохранитьОтчетНаКлиенте("docx");
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтчетНаКлиенте(РасширениеФайла)
	
	Если Не ТабличныйДокументЗаполнен() Тогда
		Сообщить("Сначала сформируйте отчет", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбора.Заголовок = "Сохранить отчет";
	ДиалогВыбора.ПолноеИмяФайла = "Отчет_НАУФОР_камеральная_проверка." + РасширениеФайла;
	ДиалогВыбора.Фильтр = ?(РасширениеФайла = "xlsx", "Excel (*.xlsx)|*.xlsx", "Word (*.docx)|*.docx");
	
	Если Не ДиалогВыбора.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	ТипФайла = ?(РасширениеФайла = "xlsx", ТипФайлаТабличногоДокумента.XLSX, ТипФайлаТабличногоДокумента.DOCX);
	
	Попытка
		ТабДокумент.Записать(ДиалогВыбора.ПолноеИмяФайла, ТипФайла);
	Исключение
		Сообщить("Не удалось сохранить файл: " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;
	
	Сообщить("Отчет сохранен: " + ДиалогВыбора.ПолноеИмяФайла, СтатусСообщения.Информация);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Отчет.ОтчетнаяДата) Тогда
		Отчет.ОтчетнаяДата = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
КонецПроцедуры
