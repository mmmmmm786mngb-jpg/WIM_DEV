Процедура РассчитатьДолиЗамеровБлоков(ЗамерыБлоков, ОбщееВремяМс)
	
	Для Каждого СтрокаЗамера Из ЗамерыБлоков Цикл
		Если ОбщееВремяМс > 0 Тогда
			СтрокаЗамера.ДоляПроцента = Окр(СтрокаЗамера.ВремяМс / ОбщееВремяМс * 100, 2);
		Иначе
			СтрокаЗамера.ДоляПроцента = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПостроитьТабличныйДокумент(ПараметрыОтчета, РезультатТеста)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Очистить();
	
	Область = ТабДок.Область(1, 1, 1, 6);
	Область.Объединить();
	Область.Текст = "Тест ПлатежныеПорученияРозничногоДУ (IMDEV-9101, v6)";
	Область.Шрифт = Новый Шрифт(, 12, Истина);
	
	Строка = 3;
	
	Если РезультатТеста.СравнительныйПрогон = Истина И РезультатТеста.Вердикт <> Неопределено Тогда
		
		ТабДок.Область(Строка, 1, Строка, 6).Объединить();
		ТабДок.Область(Строка, 1).Текст = "РЕГРЕСС:  " + РезультатТеста.Вердикт.ТекстРегресс;
		ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, , Истина);
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1, Строка, 6).Объединить();
		ТабДок.Область(Строка, 1).Текст = "СКОРОСТЬ: " + РезультатТеста.Вердикт.ТекстСкорость;
		ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, , Истина);
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1, Строка, 6).Объединить();
		ТабДок.Область(Строка, 1).Текст = "ВЕРДИКТ:  " + РезультатТеста.Вердикт.ТекстВердикт;
		ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, 11, Истина);
		Строка = Строка + 2;
		
		Сравнение = РезультатТеста.СравнениеСкорости;
		ТабДок.Область(Строка, 1, Строка, 5).Объединить();
		ТабДок.Область(Строка, 1).Текст = "Сравнение времени создания (A без флагов / B с флагами)";
		ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, , Истина);
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1).Текст = "Показатель";
		ТабДок.Область(Строка, 2).Текст = "Режим A";
		ТабДок.Область(Строка, 3).Текст = "Режим B";
		ТабДок.Область(Строка, 4).Текст = "Дельта";
		ТабДок.Область(Строка, 1, Строка, 4).Шрифт = Новый Шрифт(, , Истина);
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1).Текст = "Создано ПП";
		ТабДок.Область(Строка, 2).Текст = Формат(Сравнение.СозданоA, "ЧГ=0");
		ТабДок.Область(Строка, 3).Текст = Формат(Сравнение.СозданоB, "ЧГ=0");
		ТабДок.Область(Строка, 4).Текст = "";
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1).Текст = "Ошибки";
		ТабДок.Область(Строка, 2).Текст = Формат(Сравнение.ОшибокA, "ЧГ=0");
		ТабДок.Область(Строка, 3).Текст = Формат(Сравнение.ОшибокB, "ЧГ=0");
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1).Текст = "Время создания, мс";
		ТабДок.Область(Строка, 2).Текст = Формат(Сравнение.ВремяA, "ЧГ=0");
		ТабДок.Область(Строка, 3).Текст = Формат(Сравнение.ВремяB, "ЧГ=0");
		ТабДок.Область(Строка, 4).Текст = Формат(Сравнение.Дельта, "ЧГ=0");
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1).Текст = "Среднее мс/ПП";
		ТабДок.Область(Строка, 2).Текст = Формат(Сравнение.МсНаПП_A, "ЧГ=0");
		ТабДок.Область(Строка, 3).Текст = Формат(Сравнение.МсНаПП_B, "ЧГ=0");
		ТабДок.Область(Строка, 4).Текст = Формат(Сравнение.ДельтаМсНаПП, "ЧГ=0");
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1).Текст = "Выигрыш, %";
		ТабДок.Область(Строка, 4).Текст = Формат(Сравнение.ПроцентВыигрыша, "ЧГ=0");
		Строка = Строка + 2;
		
		СравнениеСтатусов = РезультатТеста.СравнениеСтатусов;
		ТабДок.Область(Строка, 1, Строка, 5).Объединить();
		ТабДок.Область(Строка, 1).Текст = СтрШаблон(
			"Сравнение статусов: совпало %1; расхождений %2; нарушений инвариантов %3",
			СравнениеСтатусов.Совпало,
			СравнениеСтатусов.Расхождений,
			СравнениеСтатусов.ИнвариантыНарушены);
		ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, , Истина);
		Строка = Строка + 1;
		
		Если СравнениеСтатусов.ДеталиРасхождений.Количество() > 0 Тогда
			Для Каждого ТекстРасхождения Из СравнениеСтатусов.ДеталиРасхождений Цикл
				ТабДок.Область(Строка, 1, Строка, 6).Объединить();
				ТабДок.Область(Строка, 1).Текст = ТекстРасхождения;
				Строка = Строка + 1;
			КонецЦикла;
		КонецЕсли;
		
		Строка = Строка + 1;
		
	КонецЕсли;
	
	ТабДок.Область(Строка, 1).Текст = "Дата расчета:";
	ТабДок.Область(Строка, 2).Текст = Формат(ПараметрыОтчета.ДатаРасчета, "ДЛФ=D");
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Период отбора:";
	ТабДок.Область(Строка, 2).Текст = СтрШаблон("%1 - %2",
		Формат(РезультатТеста.ПараметрыПрогона.ДатаНачалаПериода, "ДЛФ=D"),
		Формат(РезультатТеста.ПараметрыПрогона.ДатаОкончанияПериода, "ДЛФ=D"));
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Сравнительный P1-A:";
	ТабДок.Область(Строка, 2).Текст = ?(РезультатТеста.СравнительныйПрогон, "Да (A затем B)", "Нет");
	Строка = Строка + 1;
	
	ТолькоМассовый = Ложь;
	Если РезультатТеста.ПараметрыПрогона.Свойство("ТолькоМассовыйРежимP1A") Тогда
		ТолькоМассовый = РезультатТеста.ПараметрыПрогона.ТолькоМассовыйРежимP1A = Истина;
	КонецЕсли;
	ТабДок.Область(Строка, 1).Текст = "Только массовый режим:";
	ТабДок.Область(Строка, 2).Текст = ?(ТолькоМассовый, "Да (флаги вкл, без сверки)", "Нет");
	Строка = Строка + 2;
	
	ТабДок.Область(Строка, 1, Строка, 5).Объединить();
	ТабДок.Область(Строка, 1).Текст = "Замеры времени блоков";
	ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, , Истина);
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Блок";
	ТабДок.Область(Строка, 2).Текст = "Время, мс";
	ТабДок.Область(Строка, 3).Текст = "Доля, %";
	ТабДок.Область(Строка, 4).Текст = "Строк";
	ТабДок.Область(Строка, 5).Текст = "Комментарий";
	ТабДок.Область(Строка, 1, Строка, 5).Шрифт = Новый Шрифт(, , Истина);
	СтрокаНачалаЗамеров = Строка;
	Строка = Строка + 1;
	
	Для Каждого СтрокаЗамера Из РезультатТеста.ЗамерыБлоков Цикл
		ТабДок.Область(Строка, 1).Текст = СтрокаЗамера.Блок;
		ТабДок.Область(Строка, 2).Текст = Формат(СтрокаЗамера.ВремяМс, "ЧГ=0");
		ТабДок.Область(Строка, 3).Текст = Формат(СтрокаЗамера.ДоляПроцента, "ЧГ=0");
		ТабДок.Область(Строка, 4).Текст = Формат(СтрокаЗамера.СтрокОбработано, "ЧГ=0");
		ТабДок.Область(Строка, 5).Текст = СтрокаЗамера.Комментарий;
		Строка = Строка + 1;
	КонецЦикла;
	
	Строка = Строка + 1;
	
	Если РезультатТеста.ДеталиПоручений.Количество() > 0 Тогда
		
		ТабДок.Область(Строка, 1, Строка, 7).Объединить();
		ТабДок.Область(Строка, 1).Текст = ?(РезультатТеста.СравнительныйПрогон,
			"Детализация по поручениям (режим B)",
			"Детализация по поручениям");
		ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, , Истина);
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1).Текст = "N";
		ТабДок.Область(Строка, 2).Текст = "Договор";
		ТабДок.Область(Строка, 3).Текст = "Поручение";
		ТабДок.Область(Строка, 4).Текст = "Сумма";
		ТабДок.Область(Строка, 5).Текст = "Удал., мс";
		ТабДок.Область(Строка, 6).Текст = "Созд., мс";
		ТабДок.Область(Строка, 7).Текст = "ПП";
		ТабДок.Область(Строка, 8).Текст = "Ошибка";
		ТабДок.Область(Строка, 1, Строка, 8).Шрифт = Новый Шрифт(, , Истина);
		Строка = Строка + 1;
		
		Для Каждого СтрокаДетали Из РезультатТеста.ДеталиПоручений Цикл
			ТабДок.Область(Строка, 1).Текст = Формат(СтрокаДетали.НомерСтроки, "ЧГ=0");
			ТабДок.Область(Строка, 2).Текст = СтрокаДетали.ПредставлениеДоговора;
			ТабДок.Область(Строка, 3).Текст = Строка(СтрокаДетали.ПоручениеПоДС);
			ТабДок.Область(Строка, 4).Текст = Формат(СтрокаДетали.СуммаДоговора, "ЧДЦ=2");
			ТабДок.Область(Строка, 5).Текст = Формат(СтрокаДетали.ВремяУдаленияМс, "ЧГ=0");
			ТабДок.Область(Строка, 6).Текст = Формат(СтрокаДетали.ВремяСозданияМс, "ЧГ=0");
			ТабДок.Область(Строка, 7).Текст = ?(ЗначениеЗаполнено(СтрокаДетали.ПлатежноеПоручение), Строка(СтрокаДетали.ПлатежноеПоручение), "");
			ТабДок.Область(Строка, 8).Текст = СтрокаДетали.ТекстОшибки;
			Строка = Строка + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	ТабДок.ФиксацияСверху = СтрокаНачалаЗамеров;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	
	Возврат ТабДок;
	
КонецФункции

Функция СформироватьСообщенияЗамеров(РезультатТеста)
	
	Сообщения = Новый Массив;
	Сообщения.Добавить("=== Замеры ПлатежныеПорученияРозничногоДУ (IMDEV-9101, v5) ===");
	
	Если РезультатТеста.СравнительныйПрогон = Истина И РезультатТеста.Вердикт <> Неопределено Тогда
		Сообщения.Добавить("РЕГРЕСС:  " + РезультатТеста.Вердикт.ТекстРегресс);
		Сообщения.Добавить("СКОРОСТЬ: " + РезультатТеста.Вердикт.ТекстСкорость);
		Сообщения.Добавить("ВЕРДИКТ:  " + РезультатТеста.Вердикт.ТекстВердикт);
	КонецЕсли;
	
	Для Каждого СтрокаЗамера Из РезультатТеста.ЗамерыБлоков Цикл
		ТекстСообщения = СтрШаблон("%1: %2 мс (%3%%)%4",
			СтрокаЗамера.Блок,
			Формат(СтрокаЗамера.ВремяМс, "ЧГ=0"),
			Формат(СтрокаЗамера.ДоляПроцента, "ЧГ=0"),
			?(ЗначениеЗаполнено(СтрокаЗамера.Комментарий), "; " + СтрокаЗамера.Комментарий, ""));
		Сообщения.Добавить(ТекстСообщения);
	КонецЦикла;
	
	Если Не РезультатТеста.СравнительныйПрогон Тогда
		Для Каждого ТекстИтога Из СформироватьСтрокиИтогаСкоростиБезУдаления(РезультатТеста) Цикл
			Сообщения.Добавить(ТекстИтога);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Сообщения;
	
КонецФункции

Функция СформироватьСтрокиИтогаСкоростиБезУдаления(РезультатТеста)
	
	Строки = Новый Массив;
	Строки.Добавить("--- Итог скорости без удаления ПП (для оценки боя) ---");
	
	Строки.Добавить(СтрШаблон(
		"Время без удаления: %1 мс (общее %2 мс; исключено удаление %3 мс)",
		Формат(РезультатТеста.ВремяБезУдаленияМс, "ЧГ=0"),
		Формат(РезультатТеста.ОбщееВремяМс, "ЧГ=0"),
		Формат(РезультатТеста.ВремяУдаленияППМс, "ЧГ=0")));
	
	Если РезультатТеста.ВремяСозданияППМс > 0 Тогда
		
		ТекстСоздания = СтрШаблон("Создание ПП: %1 мс",
			Формат(РезультатТеста.ВремяСозданияППМс, "ЧГ=0"));
		
		Если РезультатТеста.КоличествоСоздано > 0 Тогда
			ТекстСоздания = ТекстСоздания + СтрШаблон("; создано %1; среднее %2 мс/ПП",
				РезультатТеста.КоличествоСоздано,
				Формат(Окр(РезультатТеста.ВремяСозданияППМс / РезультатТеста.КоличествоСоздано, 1), "ЧГ=0"));
		КонецЕсли;
		
		Строки.Добавить(ТекстСоздания);
		
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

Процедура ЗаписатьИтогСкоростиВЖурналРегистрации(РезультатТеста)
	
	Если РезультатТеста.СравнительныйПрогон = Истина И РезультатТеста.Вердикт <> Неопределено Тогда
		ТекстЖурнала = СтрШаблон(
			"РЕГРЕСС: %1%2СКОРОСТЬ: %3%2ВЕРДИКТ: %4",
			РезультатТеста.Вердикт.ТекстРегресс,
			Символы.ПС,
			РезультатТеста.Вердикт.ТекстСкорость,
			РезультатТеста.Вердикт.ТекстВердикт);
	Иначе
		СтрокиИтога = СформироватьСтрокиИтогаСкоростиБезУдаления(РезультатТеста);
		ТекстЖурнала = СтрСоединить(СтрокиИтога, Символы.ПС);
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		"IMDEV9101.ТестППРозничногоДУ",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		ТекстЖурнала);
	
КонецПроцедуры

#КонецОбласти
