#Область ПрограммныйИнтерфейс

// Описание: Запускает автономный тест логики ПлатежныеПорученияРозничногоДУ (без внешней обработки)
// IMDEV-9101: поддержка сравнительного прогона P1-A (режим A без флагов / режим B с флагами)
//
// Параметры:
// ПараметрыОтчета - Структура - реквизиты отчета (даты, пул, флаги)
//
// Возвращаемое значение:
// Структура - Успех, ТабДокумент, РезультатТеста, СообщенияЗамеров
//
Функция СформироватьОтчет(ПараметрыОтчета) Экспорт
	
	РезультатФормирования = Новый Структура;
	РезультатФормирования.Вставить("Успех", Ложь);
	РезультатФормирования.Вставить("ТабДокумент", Неопределено);
	РезультатФормирования.Вставить("РезультатТеста", Неопределено);
	РезультатФормирования.Вставить("СообщенияЗамеров", Новый Массив);
	РезультатФормирования.Вставить("ТекстОшибки", "");
	
	ПараметрыТеста = Новый Структура;
	ПараметрыТеста.Вставить("ДатаРасчета", ПараметрыОтчета.ДатаРасчета);
	ПараметрыТеста.Вставить("ДатаНачалаПериода", ПараметрыОтчета.ДатаНачалаПериода);
	ПараметрыТеста.Вставить("ДатаОкончанияПериода", ПараметрыОтчета.ДатаОкончанияПериода);
	ПараметрыТеста.Вставить("Пул", ПараметрыОтчета.ПулРозничноеДУ);
	ПараметрыТеста.Вставить("СоздаватьПлатежныеПоручения", ПараметрыОтчета.СоздаватьПлатежныеПоручения);
	ПараметрыТеста.Вставить("ОграничениеКоличества", ПараметрыОтчета.ОграничениеКоличества);
	ПараметрыТеста.Вставить("РежимТестаПроизводительности", ПараметрыОтчета.РежимТестаПроизводительности);
	
	СравнительныйПрогонP1A = Ложь;
	Если ПараметрыОтчета.Свойство("СравнительныйПрогонP1A") Тогда
		СравнительныйПрогонP1A = ПараметрыОтчета.СравнительныйПрогонP1A = Истина;
	КонецЕсли;
	
	ТолькоМассовыйРежимP1A = Ложь;
	Если ПараметрыОтчета.Свойство("ТолькоМассовыйРежимP1A") Тогда
		ТолькоМассовыйРежимP1A = ПараметрыОтчета.ТолькоМассовыйРежимP1A = Истина;
	КонецЕсли;
	
	// Для профилирования: только массовый режим отключает сверку A/B
	Если ТолькоМассовыйРежимP1A Тогда
		СравнительныйПрогонP1A = Ложь;
	КонецЕсли;
	
	ПараметрыТеста.Вставить("СравнительныйПрогонP1A", СравнительныйПрогонP1A);
	ПараметрыТеста.Вставить("ТолькоМассовыйРежимP1A", ТолькоМассовыйРежимP1A);
	
	Попытка
		РезультатТеста = ВыполнитьТестПлатежныеПорученияРозничногоДУ(ПараметрыТеста);
	Исключение
		РезультатФормирования.ТекстОшибки = "Ошибка выполнения теста: " + ОписаниеОшибки();
		Возврат РезультатФормирования;
	КонецПопытки;
	
	Если Не РезультатТеста.Успех Тогда
		РезультатФормирования.ТекстОшибки = РезультатТеста.ТекстОшибки;
		РезультатФормирования.РезультатТеста = РезультатТеста;
		Возврат РезультатФормирования;
	КонецЕсли;
	
	ТабДок = ПостроитьТабличныйДокумент(ПараметрыОтчета, РезультатТеста);
	СообщенияЗамеров = СформироватьСообщенияЗамеров(РезультатТеста);
	ЗаписатьИтогСкоростиВЖурналРегистрации(РезультатТеста);
	
	РезультатФормирования.Успех = Истина;
	РезультатФормирования.ТабДокумент = ТабДок;
	РезультатФормирования.РезультатТеста = РезультатТеста;
	РезультатФормирования.СообщенияЗамеров = СообщенияЗамеров;
	
	Возврат РезультатФормирования;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Выполняет тест с замером блоков; сравнительный A/B или только массовый режим
//
Функция ВыполнитьТестПлатежныеПорученияРозничногоДУ(ПараметрыТеста)
	
	Результат = НовыйПустойРезультатТеста();
	ВремяНачалаОбщее = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Попытка
		
		ДатаРасчета = ПараметрыТеста.ДатаРасчета;
		Если Не ЗначениеЗаполнено(ДатаРасчета) Тогда
			ДатаРасчета = ТекущаяДатаСеанса();
		КонецЕсли;
		
		Пул = ПараметрыТеста.Пул;
		Если Не ЗначениеЗаполнено(Пул) Тогда
			Пул = Справочники.Пул.ПолучитьСсылку(Новый УникальныйИдентификатор("686be652-ff24-11ef-b2be-0050569f27c0"));
		КонецЕсли;
		
		СоздаватьПП = ПараметрыТеста.СоздаватьПлатежныеПоручения = Истина;
		ОграничениеКоличества = 0;
		Если ПараметрыТеста.Свойство("ОграничениеКоличества") Тогда
			ОграничениеКоличества = ПараметрыТеста.ОграничениеКоличества;
		КонецЕсли;
		
		РежимТестаПроизводительности = Истина;
		Если ПараметрыТеста.Свойство("РежимТестаПроизводительности") Тогда
			РежимТестаПроизводительности = ПараметрыТеста.РежимТестаПроизводительности = Истина;
		КонецЕсли;
		
		СравнительныйПрогонP1A = Ложь;
		Если ПараметрыТеста.Свойство("СравнительныйПрогонP1A") Тогда
			СравнительныйПрогонP1A = ПараметрыТеста.СравнительныйПрогонP1A = Истина;
		КонецЕсли;
		
		ТолькоМассовыйРежимP1A = Ложь;
		Если ПараметрыТеста.Свойство("ТолькоМассовыйРежимP1A") Тогда
			ТолькоМассовыйРежимP1A = ПараметрыТеста.ТолькоМассовыйРежимP1A = Истина;
		КонецЕсли;
		
		Если Не СоздаватьПП Тогда
			СравнительныйПрогонP1A = Ложь;
			ТолькоМассовыйРежимP1A = Ложь;
		КонецЕсли;
		
		// Профилирование: один прогон «по-новому», без сверки
		Если ТолькоМассовыйРежимP1A Тогда
			СравнительныйПрогонP1A = Ложь;
		КонецЕсли;
		
		ПересоздаватьПП = РежимТестаПроизводительности И СоздаватьПП;
		Если СравнительныйПрогонP1A Или ТолькоМассовыйРежимP1A Тогда
			ПересоздаватьПП = Истина;
		КонецЕсли;
		
		ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ДатаНачалаПериода = ПараметрыТеста.ДатаНачалаПериода;
		Если Не ЗначениеЗаполнено(ДатаНачалаПериода) Тогда
			ДатаНачалаПериода = БлижайшийРабочийДень(ДатаРасчета, Истина);
		КонецЕсли;
		
		ДатаОкончанияПериода = ПараметрыТеста.ДатаОкончанияПериода;
		Если Не ЗначениеЗаполнено(ДатаОкончанияПериода) Тогда
			ДатаОкончанияПериода = ДатаРасчета;
		КонецЕсли;
		
		Если СравнительныйПрогонP1A Тогда
			КомментарийДат = СтрШаблон("Сравнительный P1-A: период %1 - %2; режим A затем B",
				Формат(ДатаНачалаПериода, "ДЛФ=D"),
				Формат(ДатаОкончанияПериода, "ДЛФ=D"));
		ИначеЕсли ТолькоМассовыйРежимP1A Тогда
			КомментарийДат = СтрШаблон("Только массовый режим P1-A: период %1 - %2; флаги вкл (без сверки)",
				Формат(ДатаНачалаПериода, "ДЛФ=D"),
				Формат(ДатаОкончанияПериода, "ДЛФ=D"));
		ИначеЕсли РежимТестаПроизводительности Тогда
			КомментарийДат = СтрШаблон("Режим теста: период отбора %1 - %2; пересоздание ПП",
				Формат(ДатаНачалаПериода, "ДЛФ=D"),
				Формат(ДатаОкончанияПериода, "ДЛФ=D"));
		Иначе
			КомментарийДат = СтрШаблон("Дата расчета: %1; период отбора: %2 - %3",
				Формат(ДатаРасчета, "ДЛФ=D"),
				Формат(ДатаНачалаПериода, "ДЛФ=D"),
				Формат(ДатаОкончанияПериода, "ДЛФ=D"));
		КонецЕсли;
		
		ДобавитьЗамерБлока(Результат.ЗамерыБлоков, "1. Расчет рабочих дат", ВремяНачалаБлока, 0, КомментарийДат);
		
		Результат.ПараметрыПрогона.Вставить("ДатаРасчета", ДатаРасчета);
		Результат.ПараметрыПрогона.Вставить("ДатаНачалаПериода", ДатаНачалаПериода);
		Результат.ПараметрыПрогона.Вставить("ДатаОкончанияПериода", ДатаОкончанияПериода);
		Результат.ПараметрыПрогона.Вставить("Пул", Пул);
		Результат.ПараметрыПрогона.Вставить("СоздаватьПлатежныеПоручения", СоздаватьПП);
		Результат.ПараметрыПрогона.Вставить("ОграничениеКоличества", ОграничениеКоличества);
		Результат.ПараметрыПрогона.Вставить("РежимТестаПроизводительности", РежимТестаПроизводительности);
		Результат.ПараметрыПрогона.Вставить("ПересоздаватьПлатежныеПоручения", ПересоздаватьПП);
		Результат.ПараметрыПрогона.Вставить("СравнительныйПрогонP1A", СравнительныйПрогонP1A);
		Результат.ПараметрыПрогона.Вставить("ТолькоМассовыйРежимP1A", ТолькоМассовыйРежимP1A);
		
		ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ОтборКакВТесте = РежимТестаПроизводительности Или СравнительныйПрогонP1A Или ТолькоМассовыйРежимP1A;
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаОтбораПоручений(ОтборКакВТесте);
		Запрос.УстановитьПараметр("Пул", Пул);
		Запрос.УстановитьПараметр("ДатаНачалаПериода", ДатаНачалаПериода);
		Запрос.УстановитьПараметр("ДатаОкончанияПериода", ДатаОкончанияПериода);
		
		КомментарийЗапроса = СтрШаблон(
			"Поручения пула за период %1 - %2",
			Формат(ДатаНачалаПериода, "ДЛФ=D"),
			Формат(ДатаОкончанияПериода, "ДЛФ=D"));
		
		РезультатЗапроса = Запрос.Выполнить();
		ТаблицаПоручений = ТаблицаПорученийИзВыборки(РезультатЗапроса, ОграничениеКоличества);
		Результат.КоличествоНайдено = ТаблицаПоручений.Количество();
		
		ДобавитьЗамерБлока(Результат.ЗамерыБлоков, "2. Запрос отбора поручений", ВремяНачалаБлока,
			Результат.КоличествоНайдено, СтрШаблон("%1; пул: %2", КомментарийЗапроса, Пул));
		
		Если СравнительныйПрогонP1A Тогда
			ВыполнитьСравнительныйПрогонP1A(Результат, ТаблицаПоручений, ДатаРасчета);
		Иначе
			ВыполнитьОдинарныйПрогон(Результат, ТаблицаПоручений, ДатаРасчета, СоздаватьПП, ПересоздаватьПП,
				ТолькоМассовыйРежимP1A);
		КонецЕсли;
		
		Результат.Успех = Истина;
		
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Результат.ОбщееВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаОбщее;
	Результат.ВремяБезУдаленияМс = Результат.ОбщееВремяМс - Результат.ВремяУдаленияППМс;
	ДобавитьЗамерБлока(Результат.ЗамерыБлоков, "ИТОГО", ВремяНачалаОбщее, Результат.КоличествоОбработано,
		СтрШаблон("Найдено: %1; удалено ПП: %2; создано: %3; ошибок: %4",
			Результат.КоличествоНайдено,
			Результат.КоличествоУдаленоПП,
			Результат.КоличествоСоздано,
			Результат.КоличествоОшибок));
	
	РассчитатьДолиЗамеровБлоков(Результат.ЗамерыБлоков, Результат.ОбщееВремяМс);
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьСравнительныйПрогонP1A(Результат, ТаблицаПоручений, ДатаРасчета)
	
	// Режим A — как было (без доп. свойств)
	ПрогонA = ВыполнитьПрогонРежима(ТаблицаПоручений, ДатаРасчета, Ложь, Истина, "A");
	СнимокA = СнятьСнимокСтатусов(ПрогонA.ДеталиПоручений);
	
	ДобавитьЗамерБлокаПоВремени(Результат.ЗамерыБлоков, "3A. Удаление ПП (режим A)", ПрогонA.ВремяУдаленияППМс,
		ПрогонA.КоличествоОбработано, СтрШаблон("Удалено: %1", ПрогонA.КоличествоУдаленоПП));
	ДобавитьЗамерБлокаПоВремени(Результат.ЗамерыБлоков, "4A. Создание ПП без флагов (режим A)", ПрогонA.ВремяСозданияППМс,
		ПрогонA.КоличествоСоздано, ТекстСреднегоМсПП(ПрогонA));
	
	// Режим B — как стало (с флагами массового режима)
	ПрогонB = ВыполнитьПрогонРежима(ТаблицаПоручений, ДатаРасчета, Истина, Истина, "B");
	СнимокB = СнятьСнимокСтатусов(ПрогонB.ДеталиПоручений);
	
	ДобавитьЗамерБлокаПоВремени(Результат.ЗамерыБлоков, "3B. Удаление ПП (режим B)", ПрогонB.ВремяУдаленияППМс,
		ПрогонB.КоличествоОбработано, СтрШаблон("Удалено: %1", ПрогонB.КоличествоУдаленоПП));
	ДобавитьЗамерБлокаПоВремени(Результат.ЗамерыБлоков, "4B. Создание ПП с флагами (режим B)", ПрогонB.ВремяСозданияППМс,
		ПрогонB.КоличествоСоздано, ТекстСреднегоМсПП(ПрогонB));
	
	СравнениеСтатусов = СравнитьСнимкиСтатусов(СнимокA, СнимокB);
	СравнениеСкорости = СравнитьСкоростьПрогонов(ПрогонA, ПрогонB);
	Вердикт = СформироватьВердиктP1A(СравнениеСкорости, СравнениеСтатусов, ПрогонA, ПрогонB);
	
	Результат.КоличествоУдаленоПП = ПрогонA.КоличествоУдаленоПП + ПрогонB.КоличествоУдаленоПП;
	Результат.КоличествоОбработано = ПрогонB.КоличествоОбработано;
	Результат.КоличествоСоздано = ПрогонB.КоличествоСоздано;
	Результат.КоличествоОшибок = ПрогонA.КоличествоОшибок + ПрогонB.КоличествоОшибок;
	Результат.ВремяУдаленияППМс = ПрогонA.ВремяУдаленияППМс + ПрогонB.ВремяУдаленияППМс;
	Результат.ВремяСозданияППМс = ПрогонB.ВремяСозданияППМс;
	Результат.ДеталиПоручений = ПрогонB.ДеталиПоручений;
	
	Результат.СравнительныйПрогон = Истина;
	Результат.ПрогонA = ПрогонA;
	Результат.ПрогонB = ПрогонB;
	Результат.СнимокСтатусовA = СнимокA;
	Результат.СнимокСтатусовB = СнимокB;
	Результат.СравнениеСтатусов = СравнениеСтатусов;
	Результат.СравнениеСкорости = СравнениеСкорости;
	Результат.Вердикт = Вердикт;
	
КонецПроцедуры

Процедура ВыполнитьОдинарныйПрогон(Результат, ТаблицаПоручений, ДатаРасчета, СоздаватьПП, ПересоздаватьПП, УстанавливатьФлаги)
	
	Прогон = ВыполнитьПрогонРежима(ТаблицаПоручений, ДатаРасчета, УстанавливатьФлаги, ПересоздаватьПП, "");
	
	Если ПересоздаватьПП Тогда
		ДобавитьЗамерБлокаПоВремени(Результат.ЗамерыБлоков, "3. Удаление существующих ПП", Прогон.ВремяУдаленияППМс,
			Прогон.КоличествоОбработано, СтрШаблон("Удалено документов ПП: %1", Прогон.КоличествоУдаленоПП));
	КонецЕсли;
	
	Если СоздаватьПП Тогда
		Если УстанавливатьФлаги Тогда
			ИмяБлока = "4. Создание ПП с флагами (массовый режим)";
		ИначеЕсли ПересоздаватьПП Тогда
			ИмяБлока = "4. Создание платежных поручений";
		Иначе
			ИмяБлока = "3. Создание платежных поручений";
		КонецЕсли;
		ДобавитьЗамерБлокаПоВремени(Результат.ЗамерыБлоков, ИмяБлока, Прогон.ВремяСозданияППМс,
			Прогон.КоличествоОбработано, "СоздатьПлатежноеПоручение + проведение; " + ТекстСреднегоМсПП(Прогон));
	КонецЕсли;
	
	Результат.КоличествоУдаленоПП = Прогон.КоличествоУдаленоПП;
	Результат.КоличествоОбработано = Прогон.КоличествоОбработано;
	Результат.КоличествоСоздано = Прогон.КоличествоСоздано;
	Результат.КоличествоОшибок = Прогон.КоличествоОшибок;
	Результат.ВремяУдаленияППМс = Прогон.ВремяУдаленияППМс;
	Результат.ВремяСозданияППМс = Прогон.ВремяСозданияППМс;
	Результат.ДеталиПоручений = Прогон.ДеталиПоручений;
	
КонецПроцедуры

Функция ВыполнитьПрогонРежима(ТаблицаПоручений, ДатаРасчета, УстанавливатьФлагиМассовогоРежима, ПересоздаватьПП, КодРежима)
	
	Прогон = Новый Структура;
	Прогон.Вставить("КодРежима", КодРежима);
	Прогон.Вставить("УстанавливатьФлаги", УстанавливатьФлагиМассовогоРежима);
	Прогон.Вставить("ДеталиПоручений", НоваяТаблицаДеталейПоручений());
	Прогон.Вставить("КоличествоОбработано", 0);
	Прогон.Вставить("КоличествоСоздано", 0);
	Прогон.Вставить("КоличествоОшибок", 0);
	Прогон.Вставить("КоличествоУдаленоПП", 0);
	Прогон.Вставить("ВремяУдаленияППМс", 0);
	Прогон.Вставить("ВремяСозданияППМс", 0);
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаПоручения Из ТаблицаПоручений Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ВремяУдаленияПП = 0;
		ВремяСозданияПП = 0;
		СсылкаПП = Документы.ПлатежноеПоручение.ПустаяСсылка();
		ТекстОшибкиПП = "";
		УдаленоПППоСтроке = 0;
		
		Если ПересоздаватьПП Тогда
			ВремяНачалаПП = ТекущаяУниверсальнаяДатаВМиллисекундах();
			УдаленоПППоСтроке = УдалитьПлатежныеПорученияПоОснованию(СтрокаПоручения.ПоручениеПоДС, ТекстОшибкиПП);
			ВремяУдаленияПП = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаПП;
			Прогон.ВремяУдаленияППМс = Прогон.ВремяУдаленияППМс + ВремяУдаленияПП;
			Прогон.КоличествоУдаленоПП = Прогон.КоличествоУдаленоПП + УдаленоПППоСтроке;
		КонецЕсли;
		
		ВремяНачалаПП = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			СсылкаПП = СоздатьПлатежноеПоручение(СтрокаПоручения.ПоручениеПоДС, ДатаРасчета, УстанавливатьФлагиМассовогоРежима);
		Исключение
			ТекстОшибкиПП = ОписаниеОшибки();
		КонецПопытки;
		ВремяСозданияПП = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаПП;
		Прогон.ВремяСозданияППМс = Прогон.ВремяСозданияППМс + ВремяСозданияПП;
		
		Если ЗначениеЗаполнено(СсылкаПП) Тогда
			Прогон.КоличествоСоздано = Прогон.КоличествоСоздано + 1;
		Иначе
			Прогон.КоличествоОшибок = Прогон.КоличествоОшибок + 1;
		КонецЕсли;
		
		СтрокаДетали = Прогон.ДеталиПоручений.Добавить();
		СтрокаДетали.НомерСтроки = НомерСтроки;
		СтрокаДетали.ДоговорДУ = СтрокаПоручения.ДоговорДУ;
		СтрокаДетали.ПредставлениеДоговора = СтрокаПоручения.ПредставлениеДоговора;
		СтрокаДетали.ПоручениеПоДС = СтрокаПоручения.ПоручениеПоДС;
		СтрокаДетали.СуммаДоговора = СтрокаПоручения.СуммаДоговора;
		СтрокаДетали.ВремяУдаленияМс = ВремяУдаленияПП;
		СтрокаДетали.ВремяСозданияМс = ВремяСозданияПП;
		СтрокаДетали.ВремяМс = ВремяУдаленияПП + ВремяСозданияПП;
		СтрокаДетали.УдаленоПП = УдаленоПППоСтроке;
		СтрокаДетали.ПлатежноеПоручение = СсылкаПП;
		СтрокаДетали.Успех = ЗначениеЗаполнено(СсылкаПП);
		СтрокаДетали.ТекстОшибки = ТекстОшибкиПП;
		
	КонецЦикла;
	
	Прогон.КоличествоОбработано = НомерСтроки;
	
	Возврат Прогон;
	
КонецФункции

// Описание: Создает платежное поручение по поручению (логика из внСинхронизацияНСИ.СоздатьПлатежноеПоручение)
// IMDEV-9101: опциональная установка флагов массового режима в ДополнительныеСвойства
//
Функция СоздатьПлатежноеПоручение(ПоручениеПоДС, ДатаВводаСредствВДУ, УстанавливатьФлагиМассовогоРежима = Ложь)
	
	ПлатежноеПоручение = Документы.ПлатежноеПоручение.ПустаяСсылка();
	
	ПлатежноеПоручениеОбъект = Документы.ПлатежноеПоручение.СоздатьДокумент();
	ПлатежноеПоручениеОбъект.Дата = БлижайшийРабочийДень(ДатаВводаСредствВДУ) + ВремяТекущее();
	ПлатежноеПоручениеОбъект.Заполнить(ПоручениеПоДС);
	
	Если УстанавливатьФлагиМассовогоРежима Тогда
		ПлатежноеПоручениеОбъект.ДополнительныеСвойства.Вставить("МассовоеСозданиеППРозничногоДУ", Истина);
		ПлатежноеПоручениеОбъект.ДополнительныеСвойства.Вставить("СтатусОснованияИзвестен",
			Перечисления.СтатусыОбъектов.Новый);
	КонецЕсли;
	
	Попытка
		ПлатежноеПоручениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ПлатежноеПоручение = ПлатежноеПоручениеОбъект.Ссылка;
	Исключение
		// Ошибка записи - вернем пустую ссылку, текст в детализации
	КонецПопытки;
	
	Возврат ПлатежноеПоручение;
	
КонецФункции

Функция ТаблицаПорученийИзВыборки(РезультатЗапроса, ОграничениеКоличества)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ПоручениеПоДС");
	Таблица.Колонки.Добавить("ПредставлениеДоговора");
	Таблица.Колонки.Добавить("ДоговорДУ");
	Таблица.Колонки.Добавить("НомерДоговорДУ");
	Таблица.Колонки.Добавить("СуммаДоговора", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ОграничениеКоличества > 0 И Таблица.Количество() >= ОграничениеКоличества Тогда
			Прервать;
		КонецЕсли;
		СтрокаТаблицы = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция СнятьСнимокСтатусов(ДеталиПоручений)
	
	Снимок = Новый ТаблицаЗначений;
	Снимок.Колонки.Добавить("Поручение");
	Снимок.Колонки.Добавить("СтатусОснования");
	Снимок.Колонки.Добавить("СтатусПП");
	Снимок.Колонки.Добавить("ПлатежноеПоручение");
	
	Для Каждого СтрокаДетали Из ДеталиПоручений Цикл
		Если Не ЗначениеЗаполнено(СтрокаДетали.ПлатежноеПоручение) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСнимка = Снимок.Добавить();
		СтрокаСнимка.Поручение = СтрокаДетали.ПоручениеПоДС;
		СтрокаСнимка.ПлатежноеПоручение = СтрокаДетали.ПлатежноеПоручение;
		СтрокаСнимка.СтатусОснования = РегистрыСведений.ИсторияСтатусовОбъектов.ПолучитьАктуальныйСтатусОбъекта(
			СтрокаДетали.ПоручениеПоДС);
		СтрокаСнимка.СтатусПП = РегистрыСведений.ИсторияСтатусовОбъектов.ПолучитьАктуальныйСтатусОбъекта(
			СтрокаДетали.ПлатежноеПоручение);
	КонецЦикла;
	
	Возврат Снимок;
	
КонецФункции

Функция СравнитьСнимкиСтатусов(СнимокA, СнимокB)
	
	Сравнение = Новый Структура;
	Сравнение.Вставить("Совпало", 0);
	Сравнение.Вставить("Расхождений", 0);
	Сравнение.Вставить("ДеталиРасхождений", Новый Массив);
	Сравнение.Вставить("ИнвариантыНарушены", 0);
	
	ИндексB = Новый Соответствие;
	Для Каждого СтрокаB Из СнимокB Цикл
		ИндексB.Вставить(СтрокаB.Поручение, СтрокаB);
	КонецЦикла;
	
	ОжидаемыйОснования = Перечисления.СтатусыОбъектов.СформированоПлатежноеПоручение;
	ОжидаемыйПП = Перечисления.СтатусыОбъектов.КОплате;
	
	Для Каждого СтрокаA Из СнимокA Цикл
		
		СтрокаB = ИндексB.Получить(СтрокаA.Поручение);
		Если СтрокаB = Неопределено Тогда
			Сравнение.Расхождений = Сравнение.Расхождений + 1;
			Сравнение.ДеталиРасхождений.Добавить(СтрШаблон(
				"Поручение %1: нет строки в режиме B", СтрокаA.Поручение));
			Продолжить;
		КонецЕсли;
		
		ИнвариантA = (СтрокаA.СтатусОснования = ОжидаемыйОснования И СтрокаA.СтатусПП = ОжидаемыйПП);
		ИнвариантB = (СтрокаB.СтатусОснования = ОжидаемыйОснования И СтрокаB.СтатусПП = ОжидаемыйПП);
		Если Не ИнвариантA Или Не ИнвариантB Тогда
			Сравнение.ИнвариантыНарушены = Сравнение.ИнвариантыНарушены + 1;
		КонецЕсли;
		
		Если СтрокаA.СтатусОснования = СтрокаB.СтатусОснования
			И СтрокаA.СтатусПП = СтрокаB.СтатусПП Тогда
			Сравнение.Совпало = Сравнение.Совпало + 1;
		Иначе
			Сравнение.Расхождений = Сравнение.Расхождений + 1;
			Сравнение.ДеталиРасхождений.Добавить(СтрШаблон(
				"Поручение %1: основание A=%2 B=%3; ПП A=%4 B=%5",
				СтрокаA.Поручение,
				СтрокаA.СтатусОснования,
				СтрокаB.СтатусОснования,
				СтрокаA.СтатусПП,
				СтрокаB.СтатусПП));
		КонецЕсли;
		
	КонецЦикла;
	
	Если СнимокB.Количество() > СнимокA.Количество() Тогда
		Сравнение.Расхождений = Сравнение.Расхождений + (СнимокB.Количество() - СнимокA.Количество());
	КонецЕсли;
	
	Возврат Сравнение;
	
КонецФункции

Функция СравнитьСкоростьПрогонов(ПрогонA, ПрогонB)
	
	Сравнение = Новый Структура;
	Сравнение.Вставить("ВремяA", ПрогонA.ВремяСозданияППМс);
	Сравнение.Вставить("ВремяB", ПрогонB.ВремяСозданияППМс);
	Сравнение.Вставить("Дельта", ПрогонA.ВремяСозданияППМс - ПрогонB.ВремяСозданияППМс);
	Сравнение.Вставить("СозданоA", ПрогонA.КоличествоСоздано);
	Сравнение.Вставить("СозданоB", ПрогонB.КоличествоСоздано);
	Сравнение.Вставить("ОшибокA", ПрогонA.КоличествоОшибок);
	Сравнение.Вставить("ОшибокB", ПрогонB.КоличествоОшибок);
	
	МсНаПП_A = 0;
	МсНаПП_B = 0;
	Если ПрогонA.КоличествоСоздано > 0 Тогда
		МсНаПП_A = Окр(ПрогонA.ВремяСозданияППМс / ПрогонA.КоличествоСоздано, 1);
	КонецЕсли;
	Если ПрогонB.КоличествоСоздано > 0 Тогда
		МсНаПП_B = Окр(ПрогонB.ВремяСозданияППМс / ПрогонB.КоличествоСоздано, 1);
	КонецЕсли;
	
	Сравнение.Вставить("МсНаПП_A", МсНаПП_A);
	Сравнение.Вставить("МсНаПП_B", МсНаПП_B);
	Сравнение.Вставить("ДельтаМсНаПП", МсНаПП_A - МсНаПП_B);
	
	Процент = 0;
	Если ПрогонA.ВремяСозданияППМс > 0 Тогда
		Процент = Окр((ПрогонA.ВремяСозданияППМс - ПрогонB.ВремяСозданияППМс)
			/ ПрогонA.ВремяСозданияППМс * 100, 1);
	КонецЕсли;
	Сравнение.Вставить("ПроцентВыигрыша", Процент);
	
	Возврат Сравнение;
	
КонецФункции

Функция СформироватьВердиктP1A(СравнениеСкорости, СравнениеСтатусов, ПрогонA, ПрогонB)
	
	Вердикт = Новый Структура;
	
	РегрессOK = (СравнениеСкорости.СозданоA = СравнениеСкорости.СозданоB)
		И (СравнениеСкорости.СозданоA > 0)
		И (СравнениеСкорости.ОшибокA = 0)
		И (СравнениеСкорости.ОшибокB = 0)
		И (СравнениеСтатусов.Расхождений = 0)
		И (СравнениеСтатусов.ИнвариантыНарушены = 0);
	
	СкоростьOK = (СравнениеСкорости.ВремяB < СравнениеСкорости.ВремяA)
		И (СравнениеСкорости.Дельта > 0);
	
	Вердикт.Вставить("РегрессOK", РегрессOK);
	Вердикт.Вставить("СкоростьOK", СкоростьOK);
	Вердикт.Вставить("Принято", РегрессOK И СкоростьOK);
	
	Вердикт.Вставить("ТекстРегресс",
		?(РегрессOK,
			СтрШаблон("OK — ПП A=%1 B=%2, ошибок %3/%4, расхождений статусов %5",
				СравнениеСкорости.СозданоA,
				СравнениеСкорости.СозданоB,
				СравнениеСкорости.ОшибокA,
				СравнениеСкорости.ОшибокB,
				СравнениеСтатусов.Расхождений),
			СтрШаблон("FAIL — создано A/B=%1/%2, ошибок %3/%4, расхождений статусов %5, инварианты %6",
				СравнениеСкорости.СозданоA,
				СравнениеСкорости.СозданоB,
				СравнениеСкорости.ОшибокA,
				СравнениеСкорости.ОшибокB,
				СравнениеСтатусов.Расхождений,
				СравнениеСтатусов.ИнвариантыНарушены)));
	
	Вердикт.Вставить("ТекстСкорость",
		?(СкоростьOK,
			СтрШаблон("OK — создание B быстрее A на %1 мс (%2 мс/ПП, %3%%)",
				Формат(СравнениеСкорости.Дельта, "ЧГ=0"),
				Формат(СравнениеСкорости.ДельтаМсНаПП, "ЧГ=0"),
				Формат(СравнениеСкорости.ПроцентВыигрыша, "ЧГ=0")),
			СтрШаблон("FAIL — A=%1 мс, B=%2 мс (B должен быть меньше A)",
				Формат(СравнениеСкорости.ВремяA, "ЧГ=0"),
				Формат(СравнениеСкорости.ВремяB, "ЧГ=0"))));
	
	Вердикт.Вставить("ТекстВердикт", ?(Вердикт.Принято, "ПРИНЯТО", "НЕ ПРИНЯТО"));
	
	Возврат Вердикт;
	
КонецФункции

Функция ТекстСреднегоМсПП(Прогон)
	
	Если Прогон.КоличествоСоздано > 0 Тогда
		Возврат СтрШаблон("создано %1; среднее %2 мс/ПП; ошибок %3",
			Прогон.КоличествоСоздано,
			Формат(Окр(Прогон.ВремяСозданияППМс / Прогон.КоличествоСоздано, 1), "ЧГ=0"),
			Прогон.КоличествоОшибок);
	КонецЕсли;
	
	Возврат СтрШаблон("создано 0; ошибок %1", Прогон.КоличествоОшибок);
	
КонецФункции

