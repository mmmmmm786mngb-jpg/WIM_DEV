Процедура ДобавитьЗамерБлока(ЗамерыБлоков, ИмяБлока, ВремяНачала, СтрокОбработано = 0, Комментарий = "")
	
	СтрокаЗамера = ЗамерыБлоков.Добавить();
	СтрокаЗамера.Блок = ИмяБлока;
	СтрокаЗамера.ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	СтрокаЗамера.СтрокОбработано = СтрокОбработано;
	СтрокаЗамера.Комментарий = Комментарий;
	
КонецПроцедуры

Процедура ДобавитьЗамерБлокаПоВремени(ЗамерыБлоков, ИмяБлока, ВремяМс, СтрокОбработано = 0, Комментарий = "")
	
	СтрокаЗамера = ЗамерыБлоков.Добавить();
	СтрокаЗамера.Блок = ИмяБлока;
	СтрокаЗамера.ВремяМс = ВремяМс;
	СтрокаЗамера.СтрокОбработано = СтрокОбработано;
	СтрокаЗамера.Комментарий = Комментарий;
	
КонецПроцедуры

Процедура РассчитатьДолиЗамеровБлоков(ЗамерыБлоков, ОбщееВремяМс)
	
	Для Каждого СтрокаЗамера Из ЗамерыБлоков Цикл
		Если ОбщееВремяМс > 0 Тогда
			СтрокаЗамера.ДоляПроцента = Окр(СтрокаЗамера.ВремяМс / ОбщееВремяМс * 100, 2);
		Иначе
			СтрокаЗамера.ДоляПроцента = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПостроитьТабличныйДокумент(ПараметрыОтчета, РезультатТеста)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Очистить();
	
	Область = ТабДок.Область(1, 1, 1, 6);
	Область.Объединить();
	Область.Текст = "Тест ПлатежныеПорученияРозничногоДУ (IMDEV-9101, автономный отчет)";
	Область.Шрифт = Новый Шрифт(, 12, Истина);
	
	Строка = 3;
	ТабДок.Область(Строка, 1).Текст = "Дата расчета:";
	ТабДок.Область(Строка, 2).Текст = Формат(ПараметрыОтчета.ДатаРасчета, "ДЛФ=D");
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Период отбора:";
	Если РезультатТеста.ПараметрыПрогона.РежимТестаПроизводительности Тогда
		ТабДок.Область(Строка, 2).Текст = "не используется (отбор по пулу)";
	Иначе
		ТабДок.Область(Строка, 2).Текст = СтрШаблон("%1 - %2",
			Формат(РезультатТеста.ПараметрыПрогона.ДатаНачалаПериода, "ДЛФ=D"),
			Формат(РезультатТеста.ПараметрыПрогона.ДатаОкончанияПериода, "ДЛФ=D"));
	КонецЕсли;
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Режим теста:";
	ТабДок.Область(Строка, 2).Текст = ?(ПараметрыОтчета.РежимТестаПроизводительности,
		"Отладка: все поручения пула, пересоздание ПП",
		"Как в бою: только без ПП");
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Пул:";
	ТабДок.Область(Строка, 2).Текст = Строка(РезультатТеста.ПараметрыПрогона.Пул);
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Создавать ПП:";
	ТабДок.Область(Строка, 2).Текст = ?(ПараметрыОтчета.СоздаватьПлатежныеПоручения, "Да", "Нет (только запрос)");
	Строка = Строка + 2;
	
	ТабДок.Область(Строка, 1, Строка, 5).Объединить();
	ТабДок.Область(Строка, 1).Текст = "Замеры времени блоков";
	ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, , Истина);
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1).Текст = "Блок";
	ТабДок.Область(Строка, 2).Текст = "Время, мс";
	ТабДок.Область(Строка, 3).Текст = "Доля, %";
	ТабДок.Область(Строка, 4).Текст = "Строк";
	ТабДок.Область(Строка, 5).Текст = "Комментарий";
	ТабДок.Область(Строка, 1, Строка, 5).Шрифт = Новый Шрифт(, , Истина);
	СтрокаНачалаЗамеров = Строка;
	Строка = Строка + 1;
	
	Для Каждого СтрокаЗамера Из РезультатТеста.ЗамерыБлоков Цикл
		ТабДок.Область(Строка, 1).Текст = СтрокаЗамера.Блок;
		ТабДок.Область(Строка, 2).Текст = Формат(СтрокаЗамера.ВремяМс, "ЧГ=0");
		ТабДок.Область(Строка, 3).Текст = Формат(СтрокаЗамера.ДоляПроцента, "ЧГ=0");
		ТабДок.Область(Строка, 4).Текст = Формат(СтрокаЗамера.СтрокОбработано, "ЧГ=0");
		ТабДок.Область(Строка, 5).Текст = СтрокаЗамера.Комментарий;
		Строка = Строка + 1;
	КонецЦикла;
	
	Строка = Строка + 1;
	
	ТабДок.Область(Строка, 1, Строка, 7).Объединить();
	ТабДок.Область(Строка, 1).Текст = СтрШаблон("Сводка: найдено %1; удалено ПП %2; создано %3; ошибок %4; общее время %5 мс",
		РезультатТеста.КоличествоНайдено,
		РезультатТеста.КоличествоУдаленоПП,
		РезультатТеста.КоличествоСоздано,
		РезультатТеста.КоличествоОшибок,
		Формат(РезультатТеста.ОбщееВремяМс, "ЧГ=0"));
	Строка = Строка + 2;
	
	Если РезультатТеста.ДеталиПоручений.Количество() > 0 Тогда
		
		ТабДок.Область(Строка, 1, Строка, 7).Объединить();
		ТабДок.Область(Строка, 1).Текст = "Детализация по поручениям";
		ТабДок.Область(Строка, 1).Шрифт = Новый Шрифт(, , Истина);
		Строка = Строка + 1;
		
		ТабДок.Область(Строка, 1).Текст = "N";
		ТабДок.Область(Строка, 2).Текст = "Договор";
		ТабДок.Область(Строка, 3).Текст = "Поручение";
		ТабДок.Область(Строка, 4).Текст = "Сумма";
		ТабДок.Область(Строка, 5).Текст = "Удал., мс";
		ТабДок.Область(Строка, 6).Текст = "Созд., мс";
		ТабДок.Область(Строка, 7).Текст = "ПП";
		ТабДок.Область(Строка, 8).Текст = "Ошибка";
		ТабДок.Область(Строка, 1, Строка, 8).Шрифт = Новый Шрифт(, , Истина);
		Строка = Строка + 1;
		
		Для Каждого СтрокаДетали Из РезультатТеста.ДеталиПоручений Цикл
			ТабДок.Область(Строка, 1).Текст = Формат(СтрокаДетали.НомерСтроки, "ЧГ=0");
			ТабДок.Область(Строка, 2).Текст = СтрокаДетали.ПредставлениеДоговора;
			ТабДок.Область(Строка, 3).Текст = Строка(СтрокаДетали.ПоручениеПоДС);
			ТабДок.Область(Строка, 4).Текст = Формат(СтрокаДетали.СуммаДоговора, "ЧДЦ=2");
			ТабДок.Область(Строка, 5).Текст = Формат(СтрокаДетали.ВремяУдаленияМс, "ЧГ=0");
			ТабДок.Область(Строка, 6).Текст = Формат(СтрокаДетали.ВремяСозданияМс, "ЧГ=0");
			ТабДок.Область(Строка, 7).Текст = ?(ЗначениеЗаполнено(СтрокаДетали.ПлатежноеПоручение), Строка(СтрокаДетали.ПлатежноеПоручение), "");
			ТабДок.Область(Строка, 8).Текст = СтрокаДетали.ТекстОшибки;
			Строка = Строка + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	ТабДок.ФиксацияСверху = СтрокаНачалаЗамеров;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	
	Возврат ТабДок;
	
КонецФункции

Функция СформироватьСообщенияЗамеров(РезультатТеста)
	
	Сообщения = Новый Массив;
	Сообщения.Добавить("=== Замеры ПлатежныеПорученияРозничногоДУ (автономный отчет) ===");
	
	Для Каждого СтрокаЗамера Из РезультатТеста.ЗамерыБлоков Цикл
		ТекстСообщения = СтрШаблон("%1: %2 мс (%3%%)%4",
			СтрокаЗамера.Блок,
			Формат(СтрокаЗамера.ВремяМс, "ЧГ=0"),
			Формат(СтрокаЗамера.ДоляПроцента, "ЧГ=0"),
			?(ЗначениеЗаполнено(СтрокаЗамера.Комментарий), "; " + СтрокаЗамера.Комментарий, ""));
		Сообщения.Добавить(ТекстСообщения);
	КонецЦикла;
	
	Возврат Сообщения;
	
КонецФункции

#КонецОбласти
