#Область ПрограммныйИнтерфейс

// Описание: Запускает автономный тест логики ПлатежныеПорученияРозничногоДУ (без внешней обработки)
//
// Параметры:
// ПараметрыОтчета - Структура - реквизиты отчета (даты, пул, флаги)
//
// Возвращаемое значение:
// Структура - Успех, ТабДокумент, РезультатТеста, СообщенияЗамеров
//
Функция СформироватьОтчет(ПараметрыОтчета) Экспорт
	
	РезультатФормирования = Новый Структура;
	РезультатФормирования.Вставить("Успех", Ложь);
	РезультатФормирования.Вставить("ТабДокумент", Неопределено);
	РезультатФормирования.Вставить("РезультатТеста", Неопределено);
	РезультатФормирования.Вставить("СообщенияЗамеров", Новый Массив);
	РезультатФормирования.Вставить("ТекстОшибки", "");
	
	ПараметрыТеста = Новый Структура;
	ПараметрыТеста.Вставить("ДатаРасчета", ПараметрыОтчета.ДатаРасчета);
	ПараметрыТеста.Вставить("ДатаНачалаПериода", ПараметрыОтчета.ДатаНачалаПериода);
	ПараметрыТеста.Вставить("ДатаОкончанияПериода", ПараметрыОтчета.ДатаОкончанияПериода);
	ПараметрыТеста.Вставить("Пул", ПараметрыОтчета.ПулРозничноеДУ);
	ПараметрыТеста.Вставить("СоздаватьПлатежныеПоручения", ПараметрыОтчета.СоздаватьПлатежныеПоручения);
	ПараметрыТеста.Вставить("ОграничениеКоличества", ПараметрыОтчета.ОграничениеКоличества);
	ПараметрыТеста.Вставить("РежимТестаПроизводительности", ПараметрыОтчета.РежимТестаПроизводительности);
	
	Попытка
		РезультатТеста = ВыполнитьТестПлатежныеПорученияРозничногоДУ(ПараметрыТеста);
	Исключение
		РезультатФормирования.ТекстОшибки = "Ошибка выполнения теста: " + ОписаниеОшибки();
		Возврат РезультатФормирования;
	КонецПопытки;
	
	Если Не РезультатТеста.Успех Тогда
		РезультатФормирования.ТекстОшибки = РезультатТеста.ТекстОшибки;
		РезультатФормирования.РезультатТеста = РезультатТеста;
		Возврат РезультатФормирования;
	КонецЕсли;
	
	ТабДок = ПостроитьТабличныйДокумент(ПараметрыОтчета, РезультатТеста);
	СообщенияЗамеров = СформироватьСообщенияЗамеров(РезультатТеста);
	
	РезультатФормирования.Успех = Истина;
	РезультатФормирования.ТабДокумент = ТабДок;
	РезультатФормирования.РезультатТеста = РезультатТеста;
	РезультатФормирования.СообщенияЗамеров = СообщенияЗамеров;
	
	Возврат РезультатФормирования;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Выполняет тест с замером блоков (копия логики ПлатежныеПорученияРозничногоДУ для отладки)
//
Функция ВыполнитьТестПлатежныеПорученияРозничногоДУ(ПараметрыТеста)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ЗамерыБлоков", НоваяТаблицаЗамеровБлоков());
	Результат.Вставить("ДеталиПоручений", НоваяТаблицаДеталейПоручений());
	Результат.Вставить("КоличествоНайдено", 0);
	Результат.Вставить("КоличествоОбработано", 0);
	Результат.Вставить("КоличествоСоздано", 0);
	Результат.Вставить("КоличествоОшибок", 0);
	Результат.Вставить("КоличествоУдаленоПП", 0);
	Результат.Вставить("ОбщееВремяМс", 0);
	Результат.Вставить("ПараметрыПрогона", Новый Структура);
	
	ВремяНачалаОбщее = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Попытка
		
		ДатаРасчета = ПараметрыТеста.ДатаРасчета;
		Если Не ЗначениеЗаполнено(ДатаРасчета) Тогда
			ДатаРасчета = ТекущаяДатаСеанса();
		КонецЕсли;
		
		Пул = ПараметрыТеста.Пул;
		Если Не ЗначениеЗаполнено(Пул) Тогда
			Пул = Справочники.Пул.ПолучитьСсылку(Новый УникальныйИдентификатор("686be652-ff24-11ef-b2be-0050569f27c0"));
		КонецЕсли;
		
		СоздаватьПП = ПараметрыТеста.СоздаватьПлатежныеПоручения = Истина;
		ОграничениеКоличества = 0;
		Если ПараметрыТеста.Свойство("ОграничениеКоличества") Тогда
			ОграничениеКоличества = ПараметрыТеста.ОграничениеКоличества;
		КонецЕсли;
		
		РежимТестаПроизводительности = Истина;
		Если ПараметрыТеста.Свойство("РежимТестаПроизводительности") Тогда
			РежимТестаПроизводительности = ПараметрыТеста.РежимТестаПроизводительности = Истина;
		КонецЕсли;
		
		ПересоздаватьПП = РежимТестаПроизводительности И СоздаватьПП;
		
		ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ДатаНачалаПериода = ПараметрыТеста.ДатаНачалаПериода;
		Если Не ЗначениеЗаполнено(ДатаНачалаПериода) Тогда
			ДатаНачалаПериода = БлижайшийРабочийДень(ДатаРасчета, Истина);
		КонецЕсли;
		
		ДатаОкончанияПериода = ПараметрыТеста.ДатаОкончанияПериода;
		Если Не ЗначениеЗаполнено(ДатаОкончанияПериода) Тогда
			ДатаОкончанияПериода = ДатаРасчета;
		КонецЕсли;
		
		ДобавитьЗамерБлока(Результат.ЗамерыБлоков, "1. Расчет рабочих дат", ВремяНачалаБлока, 0,
			?(РежимТестаПроизводительности,
				СтрШаблон("Режим теста: отбор договоров только по пулу; дата расчета %1", Формат(ДатаРасчета, "ДЛФ=D")),
				СтрШаблон("Дата расчета: %1; период отбора: %2 - %3",
					Формат(ДатаРасчета, "ДЛФ=D"),
					Формат(ДатаНачалаПериода, "ДЛФ=D"),
					Формат(ДатаОкончанияПериода, "ДЛФ=D"))));
		
		Результат.ПараметрыПрогона.Вставить("ДатаРасчета", ДатаРасчета);
		Результат.ПараметрыПрогона.Вставить("ДатаНачалаПериода", ДатаНачалаПериода);
		Результат.ПараметрыПрогона.Вставить("ДатаОкончанияПериода", ДатаОкончанияПериода);
		Результат.ПараметрыПрогона.Вставить("Пул", Пул);
		Результат.ПараметрыПрогона.Вставить("СоздаватьПлатежныеПоручения", СоздаватьПП);
		Результат.ПараметрыПрогона.Вставить("ОграничениеКоличества", ОграничениеКоличества);
		Результат.ПараметрыПрогона.Вставить("РежимТестаПроизводительности", РежимТестаПроизводительности);
		Результат.ПараметрыПрогона.Вставить("ПересоздаватьПлатежныеПоручения", ПересоздаватьПП);
		
		ВремяНачалаБлока = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаОтбораПоручений(РежимТестаПроизводительности);
		Запрос.УстановитьПараметр("Пул", Пул);
		
		Если РежимТестаПроизводительности Тогда
			КомментарийЗапроса = "Все поручения пула (включая с существующими ПП)";
		Иначе
			Запрос.УстановитьПараметр("ДатаНачалаПериода", ДатаНачалаПериода);
			Запрос.УстановитьПараметр("ДатаОкончанияПериода", ДатаОкончанияПериода);
			КомментарийЗапроса = "Как в бою: только поручения без ПП";
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		КоличествоНайдено = 0;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			КоличествоНайдено = КоличествоНайдено + 1;
		КонецЦикла;
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Результат.КоличествоНайдено = КоличествоНайдено;
		
		ДобавитьЗамерБлока(Результат.ЗамерыБлоков, "2. Запрос отбора поручений", ВремяНачалаБлока, КоличествоНайдено,
			СтрШаблон("%1; пул: %2", КомментарийЗапроса, Пул));
		
		КоличествоОбработано = 0;
		КоличествоСоздано = 0;
		КоличествоОшибок = 0;
		КоличествоУдаленоПП = 0;
		СуммаВремениСозданияПП = 0;
		СуммаВремениУдаленияПП = 0;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ОграничениеКоличества > 0 И КоличествоОбработано >= ОграничениеКоличества Тогда
				Прервать;
			КонецЕсли;
			
			КоличествоОбработано = КоличествоОбработано + 1;
			ВремяУдаленияПП = 0;
			ВремяСозданияПП = 0;
			СсылкаПП = Документы.ПлатежноеПоручение.ПустаяСсылка();
			ТекстОшибкиПП = "";
			УдаленоПППоСтроке = 0;
			
			Если ПересоздаватьПП Тогда
				ВремяНачалаПП = ТекущаяУниверсальнаяДатаВМиллисекундах();
				УдаленоПППоСтроке = УдалитьПлатежныеПорученияПоОснованию(ВыборкаДетальныеЗаписи.ПоручениеПоДС, ТекстОшибкиПП);
				ВремяУдаленияПП = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаПП;
				СуммаВремениУдаленияПП = СуммаВремениУдаленияПП + ВремяУдаленияПП;
				КоличествоУдаленоПП = КоличествоУдаленоПП + УдаленоПППоСтроке;
			КонецЕсли;
			
			Если СоздаватьПП Тогда
				
				ВремяНачалаПП = ТекущаяУниверсальнаяДатаВМиллисекундах();
				
				Попытка
					СсылкаПП = СоздатьПлатежноеПоручение(ВыборкаДетальныеЗаписи.ПоручениеПоДС, ДатаРасчета);
				Исключение
					ТекстОшибкиПП = ОписаниеОшибки();
				КонецПопытки;
				
				ВремяСозданияПП = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаПП;
				СуммаВремениСозданияПП = СуммаВремениСозданияПП + ВремяСозданияПП;
				
				Если ЗначениеЗаполнено(СсылкаПП) Тогда
					КоличествоСоздано = КоличествоСоздано + 1;
				Иначе
					КоличествоОшибок = КоличествоОшибок + 1;
				КонецЕсли;
				
			КонецЕсли;
			
			СтрокаДетали = Результат.ДеталиПоручений.Добавить();
			СтрокаДетали.НомерСтроки = КоличествоОбработано;
			СтрокаДетали.ДоговорДУ = ВыборкаДетальныеЗаписи.ДоговорДУ;
			СтрокаДетали.ПредставлениеДоговора = ВыборкаДетальныеЗаписи.ПредставлениеДоговора;
			СтрокаДетали.ПоручениеПоДС = ВыборкаДетальныеЗаписи.ПоручениеПоДС;
			СтрокаДетали.СуммаДоговора = ВыборкаДетальныеЗаписи.СуммаДоговора;
			СтрокаДетали.ВремяУдаленияМс = ВремяУдаленияПП;
			СтрокаДетали.ВремяСозданияМс = ВремяСозданияПП;
			СтрокаДетали.ВремяМс = ВремяУдаленияПП + ВремяСозданияПП;
			СтрокаДетали.УдаленоПП = УдаленоПППоСтроке;
			СтрокаДетали.ПлатежноеПоручение = СсылкаПП;
			СтрокаДетали.Успех = Не СоздаватьПП Или ЗначениеЗаполнено(СсылкаПП);
			СтрокаДетали.ТекстОшибки = ТекстОшибкиПП;
			
		КонецЦикла;
		
		Если ПересоздаватьПП Тогда
			КомментарийУдаления = СтрШаблон("Удалено документов ПП: %1", КоличествоУдаленоПП);
			Если КоличествоОбработано > 0 Тогда
				КомментарийУдаления = КомментарийУдаления + СтрШаблон("; среднее на поручение: %1 мс",
					Окр(СуммаВремениУдаленияПП / КоличествоОбработано, 1));
			КонецЕсли;
			ДобавитьЗамерБлокаПоВремени(Результат.ЗамерыБлоков, "3. Удаление существующих ПП", СуммаВремениУдаленияПП,
				КоличествоОбработано, КомментарийУдаления);
		КонецЕсли;
		
		Если СоздаватьПП Тогда
			КомментарийСоздания = "СоздатьПлатежноеПоручение + проведение";
			Если КоличествоОбработано > 0 Тогда
				КомментарийСоздания = КомментарийСоздания + СтрШаблон("; среднее на ПП: %1 мс",
					Окр(СуммаВремениСозданияПП / КоличествоОбработано, 1));
			КонецЕсли;
			ИмяБлокаСоздания = ?(ПересоздаватьПП, "4. Создание платежных поручений", "3. Создание платежных поручений");
			ДобавитьЗамерБлокаПоВремени(Результат.ЗамерыБлоков, ИмяБлокаСоздания, СуммаВремениСозданияПП,
				КоличествоОбработано, КомментарийСоздания);
		КонецЕсли;
		
		Результат.КоличествоУдаленоПП = КоличествоУдаленоПП;
		Результат.КоличествоОбработано = КоличествоОбработано;
		Результат.КоличествоСоздано = КоличествоСоздано;
		Результат.КоличествоОшибок = КоличествоОшибок;
		Результат.Успех = Истина;
		
	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Результат.ОбщееВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаОбщее;
	ДобавитьЗамерБлока(Результат.ЗамерыБлоков, "ИТОГО", ВремяНачалаОбщее, Результат.КоличествоОбработано,
		СтрШаблон("Найдено: %1; удалено ПП: %2; создано: %3; ошибок: %4",
			Результат.КоличествоНайдено,
			Результат.КоличествоУдаленоПП,
			Результат.КоличествоСоздано,
			Результат.КоличествоОшибок));
	
	РассчитатьДолиЗамеровБлоков(Результат.ЗамерыБлоков, Результат.ОбщееВремяМс);
	
	Возврат Результат;
	
КонецФункции

// Описание: Создает платежное поручение по поручению (логика из внСинхронизацияНСИ.СоздатьПлатежноеПоручение)
//
Функция СоздатьПлатежноеПоручение(ПоручениеПоДС, ДатаВводаСредствВДУ)
	
	ПлатежноеПоручение = Документы.ПлатежноеПоручение.ПустаяСсылка();
	
	ПлатежноеПоручениеОбъект = Документы.ПлатежноеПоручение.СоздатьДокумент();
	ПлатежноеПоручениеОбъект.Дата = БлижайшийРабочийДень(ДатаВводаСредствВДУ) + ВремяТекущее();
	ПлатежноеПоручениеОбъект.Заполнить(ПоручениеПоДС);
	
	Попытка
		ПлатежноеПоручениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ПлатежноеПоручение = ПлатежноеПоручениеОбъект.Ссылка;
	Исключение
		// Ошибка записи - вернем пустую ссылку, текст в детализации
	КонецПопытки;
	
	Возврат ПлатежноеПоручение;
	
КонецФункции

Функция БлижайшийРабочийДень(ДатаРасчета, Предыдущий = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	" + ?(Предыдущий, "МАКСИМУМ", "МИНИМУМ") + "(КалендарныеГрафики.ДатаГрафика) КАК ДатаГрафика
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
		|ГДЕ
		|	КалендарныеГрафики.ДатаГрафика " + ?(Предыдущий, "<", ">=") + " НАЧАЛОПЕРИОДА(&ДатаРасчета, ДЕНЬ)
		|	И КалендарныеГрафики.ДеньВключенВГрафик
		|	И КалендарныеГрафики.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.РегламентированныйКалендарь)";
	
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаГрафика;
	КонецЕсли;
	
	Возврат ДатаРасчета;
	
КонецФункции

Функция ВремяТекущее()
	
	ТекВремя = ТекущаяДатаСеанса();
	Часы = Час(ТекВремя);
	Часы = ?(Часы > 20, 20, Часы);
	Минуты = ?(Часы = 20, 0, Минута(ТекВремя));
	Секунды = ?(Часы = 20, 0, Секунда(ТекВремя));
	
	Возврат Часы * 3600 + Минуты * 60 + Секунды;
	
КонецФункции

Функция УдалитьПлатежныеПорученияПоОснованию(ПоручениеПоДС, ТекстОшибки = "")
	
	КоличествоУдалено = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПлатежноеПоручение.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
		|ГДЕ
		|	ПлатежноеПоручение.ДокументОснование = &ПоручениеПоДС
		|	И НЕ ПлатежноеПоручение.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПоручениеПоДС", ПоручениеПоДС);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Попытка
			ДокументПП = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокументПП.Проведен Тогда
				ДокументПП.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			ДокументПП.Удалить();
			КоличествоУдалено = КоличествоУдалено + 1;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	
	Возврат КоличествоУдалено;
	
КонецФункции

Функция ТекстЗапросаОтбораПоручений(РежимТестаПроизводительности)
	
	Если РежимТестаПроизводительности Тогда
		Возврат
			"ВЫБРАТЬ
			|	ДоговорыДУ.Ссылка КАК ДоговорДУ
			|ПОМЕСТИТЬ ВТ_ДоговорыДУ
			|ИЗ
			|	Справочник.ДоговорДУ КАК ДоговорыДУ
			|ГДЕ
			|	ДоговорыДУ.Пул = &Пул
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Поручение.Ссылка КАК ПоручениеПоДС,
			|	ПРЕДСТАВЛЕНИЕ(Поручение.ДоговорДУ) КАК ПредставлениеДоговора,
			|	Поручение.ДоговорДУ КАК ДоговорДУ,
			|	Поручение.ДоговорДУ.Код КАК НомерДоговорДУ,
			|	Поручение.СуммаДС КАК СуммаДоговора
			|ИЗ
			|	Документ.Поручение КАК Поручение
			|ГДЕ
			|	Поручение.ДоговорДУ В
			|			(ВЫБРАТЬ
			|				ДоговорыДУ.ДоговорДУ
			|			ИЗ
			|				ВТ_ДоговорыДУ КАК ДоговорыДУ)
			|	И Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.Перевод)
			|	И Поручение.Комментарий <> ""Перевод ДС при расторжении""
			|	И НЕ Поручение.ПометкаУдаления";
	КонецЕсли;
	
	Возврат
		"ВЫБРАТЬ
		|	ДоговорыДУ.Ссылка КАК ДоговорДУ
		|ПОМЕСТИТЬ ВТ_ДоговорыДУ
		|ИЗ
		|	Справочник.ДоговорДУ КАК ДоговорыДУ
		|ГДЕ
		|	ДоговорыДУ.Пул = &Пул
		|	И НАЧАЛОПЕРИОДА(ДоговорыДУ.ДатаВводаСредствВДУ, ДЕНЬ) >= НАЧАЛОПЕРИОДА(&ДатаНачалаПериода, ДЕНЬ)
		|	И НАЧАЛОПЕРИОДА(ДоговорыДУ.ДатаВводаСредствВДУ, ДЕНЬ) <= НАЧАЛОПЕРИОДА(&ДатаОкончанияПериода, ДЕНЬ)
		|	И ДоговорыДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДАТАВРЕМЯ(1, 1, 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Поручение.Ссылка КАК ПоручениеПоДС,
		|	ПРЕДСТАВЛЕНИЕ(Поручение.ДоговорДУ) КАК ПредставлениеДоговора,
		|	Поручение.ДоговорДУ КАК ДоговорДУ,
		|	Поручение.ДоговорДУ.Код КАК НомерДоговорДУ,
		|	Поручение.СуммаДС КАК СуммаДоговора
		|ИЗ
		|	Документ.Поручение КАК Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
		|		ПО (ПлатежноеПоручение.ДокументОснование = Поручение.Ссылка)
		|			И (НЕ ПлатежноеПоручение.ПометкаУдаления)
		|ГДЕ
		|	ПлатежноеПоручение.Ссылка ЕСТЬ NULL
		|	И Поручение.ДоговорДУ В
		|			(ВЫБРАТЬ
		|				ДоговорыДУ.ДоговорДУ
		|			ИЗ
		|				ВТ_ДоговорыДУ КАК ДоговорыДУ)
		|	И Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоручение.Перевод)
		|	И Поручение.Комментарий <> ""Перевод ДС при расторжении""
		|	И НЕ Поручение.ПометкаУдаления";
	
КонецФункции

