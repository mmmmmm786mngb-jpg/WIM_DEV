
&НаКлиенте
Процедура Сформировать(Команда)
	
	СформироватьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ДатаРасчета", Отчет.ДатаРасчета);
	ПараметрыОтчета.Вставить("ДатаНачалаПериода", Отчет.ДатаНачалаПериода);
	ПараметрыОтчета.Вставить("ДатаОкончанияПериода", Отчет.ДатаОкончанияПериода);
	ПараметрыОтчета.Вставить("ПулРозничноеДУ", Отчет.ПулРозничноеДУ);
	ПараметрыОтчета.Вставить("СоздаватьПлатежныеПоручения", Отчет.СоздаватьПлатежныеПоручения);
	ПараметрыОтчета.Вставить("РежимТестаПроизводительности", Отчет.РежимТестаПроизводительности);
	ПараметрыОтчета.Вставить("СравнительныйПрогонP1A", Отчет.СравнительныйПрогонP1A);
	ПараметрыОтчета.Вставить("ОграничениеКоличества", Отчет.ОграничениеКоличества);
	
	Результат = ОтчетОбъект.СформироватьОтчет(ПараметрыОтчета);
	
	Если Результат.Успех Тогда
		ТабДокумент = Результат.ТабДокумент;
		ВывестиСообщенияЗамеров(Результат.СообщенияЗамеров);
		Сообщить("Тест завершен. Результат отображен в табличном документе.", СтатусСообщения.Информация);
	Иначе
		ТабДокумент.Очистить();
		ТекстОшибки = Результат.ТекстОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Не удалось выполнить тест";
		КонецЕсли;
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСообщенияЗамеров(СообщенияЗамеров)
	
	Для Каждого ТекстСообщения Из СообщенияЗамеров Цикл
		Сообщить(ТекстСообщения, СтатусСообщения.Информация);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Отчет.ДатаРасчета) Тогда
		Отчет.ДатаРасчета = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Отчет.ПулРозничноеДУ) Тогда
		Отчет.ПулРозничноеДУ = Справочники.Пул.ПолучитьСсылку(
			Новый УникальныйИдентификатор("686be652-ff24-11ef-b2be-0050569f27c0"));
	КонецЕсли;
	
	Отчет.РежимТестаПроизводительности = Истина;
	Отчет.СравнительныйПрогонP1A = Истина;
	Отчет.СоздаватьПлатежныеПоручения = Истина;
	Отчет.ОграничениеКоличества = 200;
	
КонецПроцедуры
