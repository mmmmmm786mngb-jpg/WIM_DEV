
// IMDEV-9573. Кнопка "Заполнить и закрыть": документ заполняется и записывается на сервере по ссылке, без копирования
// табличных частей в данные формы и без перечитывания формы; после успешного заполнения форма закрывается.

#Область ОбработчикиСобытийФормы

// Переименовывает команду Заполнить в "Заполнить и закрыть".
//
// Параметры:
//  Отказ                - Булево
//  СтандартнаяОбработка - Булево
//
&НаСервере
&После("ПриСозданииНаСервере")
Процедура И9573_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Команды.Заполнить.Заголовок = НСтр("ru = 'Заполнить и закрыть'");
	Команды.Заполнить.Подсказка = НСтр("ru = 'Заполнить отчет, записать документ и закрыть форму'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Заполняет документ по ссылке и закрывает форму. Новый документ сначала записывается из формы. У существующего
// измененного документа шапка и отборы передаются на сервер и записываются вместе с результатом заполнения:
// запись из формы перепроводит проведенный документ по старым строкам (форма перепроводит при записи).
// При отказе заполнения (неподходящие договоры ДУ) документ не меняется, форма остается открытой с сообщениями.
// Полная замена без ПродолжитьВызов: типовая процедура копирует документ в форму и обратно.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
&Вместо("Заполнить")
Процедура И9573_Заполнить(Команда)

	Если Не ЗначениеЗаполнено(Объект.УправляющаяКомпания) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит Управляющая компания. Заполнение невозможно.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.УправляющаяКомпания");
		Возврат;
	КонецЕсли;

	ДанныеШапки = Неопределено;
	Если Объект.Ссылка.Пустая() Тогда
		Если Не Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись)) Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли Модифицированность Тогда
		ДанныеШапки = ДанныеШапкиФормы();
	КонецЕсли;

	Результат = ЗаполнитьИЗаписатьПоСсылке(Объект.Ссылка, ДанныеШапки);
	Если Не Результат.Заполнено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Документ не изменен.'"));
		Возврат;
	КонецЕсли;

	Модифицированность = Ложь;
	ОповеститьОбИзменении(Объект.Ссылка);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Отчет заполнен и записан'"),
		ПолучитьНавигационнуюСсылку(Объект.Ссылка), Строка(Объект.Ссылка));

	Если Результат.Проведен Тогда
		ТекстПредупреждения = НСтр("ru = 'Документ проведен ранее: файл отчета во вложениях сформирован до перезаполнения.
			|Проведите документ повторно, чтобы сформировать файл по новым данным.'");
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ЗакрытьПослеПредупреждения", ЭтотОбъект), ТекстПредупреждения);
	Иначе
		Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Полная замена без ПродолжитьВызов: типовая процедура при открытии формы и после записи дважды копирует весь
// документ между формой и объектом ради регистра ДанныеРегламентныхОтчетов, а сохранение в этот регистр в модуле
// объекта отключено.
//
// Параметры:
//  Отказ - Булево
//
&НаСервере
&Вместо("ЗагрузитьДанныеТабЧастейИзРегистра")
Процедура И9573_ЗагрузитьДанныеТабЧастейИзРегистра(Отказ = Ложь)

	Возврат;

КонецПроцедуры

#Область ЗаполнениеПоСсылке

// Заполняет документ по ссылке (ЗаполнитьОтчет) и записывает его в режиме Запись: проведенный документ остается
// проведенным. При отказе заполнения документ не записывается, чтобы не сохранить очищенные разделы.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//  ДанныеШапки    - Структура, Неопределено - несохраненные изменения шапки и отборов, см. ДанныеШапкиФормы
//
// Возвращаемое значение:
//  Структура:
//   * Заполнено - Булево - Истина, если документ заполнен и записан
//   * Проведен  - Булево - документ проведен
//
&НаСервереБезКонтекста
Функция ЗаполнитьИЗаписатьПоСсылке(Знач ДокументСсылка, Знач ДанныеШапки)

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Если ДанныеШапки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеШапки.Реквизиты);
		ЗаполнитьОтбор(ДокументОбъект.ДоговораДУ, "ДоговорДУ", ДанныеШапки.ДоговораДУ);
		ЗаполнитьОтбор(ДокументОбъект.Активы, "Актив", ДанныеШапки.Активы);
		ЗаполнитьОтбор(ДокументОбъект.Валюты, "Валюта", ДанныеШапки.Валюты);
	КонецЕсли;

	ДокументОбъект.ЗаполнитьОтчет();

	// При отказе ЗаполнитьОтчет очищает разделы и выходит до ЗаполнитьСведенияУК, а дату направления запроса
	// заполняет только ЗаполнитьСведенияУК (значением КонецПериода): по ней отказ отличается от заполнения.
	Заполнено = ЗначениеЗаполнено(ДокументОбъект.ДатаНаправленияЗапроса);
	Если Заполнено Тогда
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

	Возврат Новый Структура("Заполнено, Проведен", Заполнено, ДокументОбъект.Проведен);

КонецФункции

// Табличные части отборов передаются массивами значений: таблица значений на клиент не передается.
//
// Возвращаемое значение:
//  Структура - шапка и отборы документа из данных формы:
//   * Реквизиты  - Структура - Дата, Номер и реквизиты документа
//   * ДоговораДУ - Массив из СправочникСсылка.ДоговорДУ - табличная часть ДоговораДУ
//   * Активы     - Массив - значения колонки Актив табличной части Активы
//   * Валюты     - Массив - значения колонки Валюта табличной части Валюты
//
&НаСервере
Функция ДанныеШапкиФормы()

	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Дата");
	ИменаРеквизитов.Добавить("Номер");
	Для Каждого Реквизит Из Метаданные.Документы.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П.Реквизиты Цикл
		ИменаРеквизитов.Добавить(Реквизит.Имя);
	КонецЦикла;

	Реквизиты = Новый Структура(СтрСоединить(ИменаРеквизитов, ","));
	ЗаполнитьЗначенияСвойств(Реквизиты, Объект);

	ДанныеШапки = Новый Структура;
	ДанныеШапки.Вставить("Реквизиты",  Реквизиты);
	ДанныеШапки.Вставить("ДоговораДУ", Объект.ДоговораДУ.Выгрузить().ВыгрузитьКолонку("ДоговорДУ"));
	ДанныеШапки.Вставить("Активы",     Объект.Активы.Выгрузить().ВыгрузитьКолонку("Актив"));
	ДанныеШапки.Вставить("Валюты",     Объект.Валюты.Выгрузить().ВыгрузитьКолонку("Валюта"));

	Возврат ДанныеШапки;

КонецФункции

// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть - отбор документа: ДоговораДУ, Активы или Валюты
//  ИмяКолонки     - Строка - единственная колонка отбора
//  Значения       - Массив - значения колонки из формы
//
&НаСервереБезКонтекста
Процедура ЗаполнитьОтбор(ТабличнаяЧасть, ИмяКолонки, Значения)

	ТабличнаяЧасть.Очистить();
	Для Каждого Значение Из Значения Цикл
		ТабличнаяЧасть.Добавить()[ИмяКолонки] = Значение;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура ЗакрытьПослеПредупреждения(ДополнительныеПараметры) Экспорт

	Закрыть();

КонецПроцедуры

#КонецОбласти

#КонецОбласти
