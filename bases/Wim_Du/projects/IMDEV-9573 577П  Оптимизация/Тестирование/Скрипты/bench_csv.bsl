
#Область Замеры

// Описание: Замер вариантов выгрузки одного раздела. Тестовая функция IMDEV-9573, не для поставки.
// Q - только запрос, I - запрос и обход выборки, R - обход и чтение полей по индексу,
// A - текущий цикл обработки, B - проверка переводов строк один раз на строку,
// C - B и СОКРП в запросе, D - C и XMLСтрока вместо Формат, E - C и массив со СтрСоединить,
// F - C и кеш представлений дат.
//
// Параметры:
// ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П - документ
// ИмяРаздела - Строка - имя табличной части
// Вариант - Строка - буква варианта
// ИмяФайла - Строка - файл CSV для вариантов с записью
//
// Возвращаемое значение:
// Строка - "запрос;цикл;строк" в миллисекундах
//
Функция Замер(ДокументСсылка, ИмяРаздела, Вариант, ИмяФайла) Экспорт

    Колонки = КолонкиРаздела(ИмяРаздела);
    Запрос = Новый Запрос;
    Если СтрНайти("CDEF", Вариант) > 0 Тогда
        Запрос.Текст = ТекстЗапросаСокрП(ИмяРаздела, Колонки);
    Иначе
        Запрос.Текст = ТекстЗапросаРаздела(ИмяРаздела, Колонки);
    КонецЕсли;
    Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    РезультатЗапроса = Запрос.Выполнить();
    МсЗапрос = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
    Если Вариант = "Q" Тогда
        Возврат Формат(МсЗапрос, "ЧН=0; ЧГ=0") + ";0;0";
    КонецЕсли;

    Заголовки = Новый Массив;
    Форматы = Новый Массив;
    Виды = Новый Массив;
    Для Каждого Колонка Из Колонки Цикл
        Заголовки.Добавить(Колонка.Заголовок);
        Форматы.Добавить(ФорматКолонки(Колонка.Вид));
        Виды.Добавить(Колонка.Вид);
    КонецЦикла;
    ИндексПоследнегоПоля = Колонки.Количество() - 2;

    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Выборка = РезультатЗапроса.Выбрать();
    Счетчик = 0;
    Если Вариант = "I" Тогда
        Пока Выборка.Следующий() Цикл
            Счетчик = Счетчик + 1;
        КонецЦикла;
    ИначеЕсли Вариант = "R" Тогда
        Пока Выборка.Следующий() Цикл
            Для Индекс = 0 По ИндексПоследнегоПоля Цикл
                ЗначениеПоля = Выборка[Индекс];
            КонецЦикла;
            Счетчик = Счетчик + 1;
        КонецЦикла;
    Иначе
        ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
        ЗаписьТекста.ЗаписатьСтроку(СтрСоединить(Заголовки, "|"));
        Если Вариант = "A" Тогда
            Счетчик = ЦиклA(Выборка, Форматы, ИндексПоследнегоПоля, ЗаписьТекста);
        ИначеЕсли Вариант = "B" Тогда
            Счетчик = ЦиклB(Выборка, Форматы, ИндексПоследнегоПоля, ЗаписьТекста, Истина);
        ИначеЕсли Вариант = "C" Тогда
            Счетчик = ЦиклB(Выборка, Форматы, ИндексПоследнегоПоля, ЗаписьТекста, Ложь);
        ИначеЕсли Вариант = "D" Тогда
            Счетчик = ЦиклD(Выборка, Виды, ИндексПоследнегоПоля, ЗаписьТекста, Ложь);
        ИначеЕсли Вариант = "G" Тогда
            Счетчик = ЦиклD(Выборка, Виды, ИндексПоследнегоПоля, ЗаписьТекста, Истина);
        ИначеЕсли Вариант = "H" Тогда
            Счетчик = ЦиклH(Выборка, Виды, ИндексПоследнегоПоля, ЗаписьТекста);
        ИначеЕсли Вариант = "E" Тогда
            Счетчик = ЦиклE(Выборка, Форматы, ИндексПоследнегоПоля, ЗаписьТекста);
        Иначе
            Счетчик = ЦиклF(Выборка, Форматы, Виды, ИндексПоследнегоПоля, ЗаписьТекста);
        КонецЕсли;
        ЗаписьТекста.Закрыть();
    КонецЕсли;
    МсЦикл = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

    Возврат Формат(МсЗапрос, "ЧН=0; ЧГ=0") + ";" + Формат(МсЦикл, "ЧН=0; ЧГ=0") + ";" + Формат(Счетчик, "ЧН=0; ЧГ=0");

КонецФункции

// Описание: Замер выгрузки раздела порциями по диапазону НомерСтроки. Тестовая функция.
// РазмерПорции = 0 - только запрос раздела без УПОРЯДОЧИТЬ ПО (время запроса).
//
// Параметры:
// ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П - документ
// ИмяРаздела - Строка - имя табличной части
// ИмяФайла - Строка - файл CSV
// РазмерПорции - Число - строк в порции
//
// Возвращаемое значение:
// Строка - "запросы;цикл;строк;порций" в миллисекундах
//
Функция ЗамерПорциями(ДокументСсылка, ИмяРаздела, ИмяФайла, РазмерПорции) Экспорт

    Колонки = КолонкиРаздела(ИмяРаздела);
    ТекстЗапроса = ТекстЗапросаРаздела(ИмяРаздела, Колонки);

    Если РазмерПорции = 0 Тогда
        Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб + "Раздел.НомерСтроки", ""));
        Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
        Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
        РезультатЗапроса = Запрос.Выполнить();
        Возврат Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, "ЧН=0; ЧГ=0") + ";0;0;1";
    КонецЕсли;

    ЗапросМаксимум = Новый Запрос(
        "ВЫБРАТЬ
        |    ЕСТЬNULL(МАКСИМУМ(Раздел.НомерСтроки), 0) КАК НомерСтроки
        |ИЗ
        |    Документ.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П." + ИмяРаздела + " КАК Раздел
        |ГДЕ
        |    Раздел.Ссылка = &Ссылка");
    ЗапросМаксимум.УстановитьПараметр("Ссылка", ДокументСсылка);
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    ВыборкаМаксимум = ЗапросМаксимум.Выполнить().Выбрать();
    ВыборкаМаксимум.Следующий();
    МаксимальныйНомер = ВыборкаМаксимум.НомерСтроки;
    МсЗапросы = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

    Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "Раздел.Ссылка = &Ссылка",
        "Раздел.Ссылка = &Ссылка" + Символы.ПС + Символы.Таб + "И Раздел.НомерСтроки МЕЖДУ &НачалоПорции И &КонецПорции"));
    Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

    Виды = Новый Массив;
    Заголовки = Новый Массив;
    Для Каждого Колонка Из Колонки Цикл
        Заголовки.Добавить(Колонка.Заголовок);
        Виды.Добавить(Колонка.Вид);
    КонецЦикла;
    ИндексПоследнегоПоля = Колонки.Количество() - 2;

    МсЦикл = 0;
    Счетчик = 0;
    Порций = 0;
    Буфер = Новый Массив;
    ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
    ЗаписьТекста.ЗаписатьСтроку(СтрСоединить(Заголовки, "|"));
    НачалоПорции = 1;
    Пока НачалоПорции <= МаксимальныйНомер Цикл
        Запрос.УстановитьПараметр("НачалоПорции", НачалоПорции);
        Запрос.УстановитьПараметр("КонецПорции", НачалоПорции + РазмерПорции - 1);
        Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
        РезультатЗапроса = Запрос.Выполнить();
        МсЗапросы = МсЗапросы + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
        Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Выборка = РезультатЗапроса.Выбрать();
        Пока Выборка.Следующий() Цикл
            СтрокаCSV = СтрокаФайла(Выборка, Виды, ИндексПоследнегоПоля);
            Если СтрНайти(СтрокаCSV, Символы.ПС) > 0 Или СтрНайти(СтрокаCSV, Символы.ВК) > 0 Тогда
                СтрокаCSV = ТекстБезПереводовСтрок(СтрокаCSV);
            КонецЕсли;
            Буфер.Добавить(СтрокаCSV);
            Счетчик = Счетчик + 1;
            Если Буфер.Количество() >= 4000 Тогда
                СброситьБуфер(Буфер, ЗаписьТекста);
            КонецЕсли;
        КонецЦикла;
        Выборка = Неопределено;
        РезультатЗапроса = Неопределено;
        МсЦикл = МсЦикл + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
        Порций = Порций + 1;
        НачалоПорции = НачалоПорции + РазмерПорции;
    КонецЦикла;
    Если Буфер.Количество() > 0 Тогда
        СброситьБуфер(Буфер, ЗаписьТекста);
    КонецЕсли;
    ЗаписьТекста.Закрыть();

    Возврат Формат(МсЗапросы, "ЧН=0; ЧГ=0") + ";" + Формат(МсЦикл, "ЧН=0; ЧГ=0") + ";"
        + Формат(Счетчик, "ЧН=0; ЧГ=0") + ";" + Формат(Порций, "ЧН=0; ЧГ=0");

КонецФункции

Функция ФорматКолонки(Вид)

    Если Вид = 1 Тогда
        Возврат "ДФ=yyyy-MM-dd";
    ИначеЕсли Вид = 2 Тогда
        Возврат "ДФ=ЧЧ:мм:сс";
    ИначеЕсли Вид = 3 Тогда
        Возврат "ЧРД=.; ЧН=0; ЧГ=0";
    ИначеЕсли Вид = 4 Тогда
        Возврат "ЧРД=.; ЧГ=0";
    Иначе
        Возврат "";
    КонецЕсли;

КонецФункции

Функция ТекстЗапросаСокрП(ИмяРаздела, Колонки)

    Поля = Новый Массив;
    Для Каждого Колонка Из Колонки Цикл
        Если Не ЗначениеЗаполнено(Колонка.Имя) Тогда
            Продолжить;
        КонецЕсли;
        Если Колонка.Вид = 0 Тогда
            Поля.Добавить("СОКРП(Раздел." + Колонка.Имя + ") КАК " + Колонка.Имя);
        Иначе
            Поля.Добавить("Раздел." + Колонка.Имя + " КАК " + Колонка.Имя);
        КонецЕсли;
    КонецЦикла;

    Возврат "ВЫБРАТЬ"
        + Символы.ПС + Символы.Таб + СтрСоединить(Поля, "," + Символы.ПС + Символы.Таб)
        + Символы.ПС + "ИЗ"
        + Символы.ПС + Символы.Таб + "Документ.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П." + ИмяРаздела + " КАК Раздел"
        + Символы.ПС + "ГДЕ"
        + Символы.ПС + Символы.Таб + "Раздел.Ссылка = &Ссылка"
        + Символы.ПС + "УПОРЯДОЧИТЬ ПО"
        + Символы.ПС + Символы.Таб + "Раздел.НомерСтроки";

КонецФункции

Процедура СброситьБуфер(Буфер, ЗаписьТекста)

    ЗаписьТекста.Записать(СтрСоединить(Буфер, Символы.ПС) + Символы.ПС);
    Буфер.Очистить();

КонецПроцедуры

Функция ЦиклA(Выборка, Форматы, ИндексПоследнегоПоля, ЗаписьТекста)

    Буфер = Новый Массив;
    Счетчик = 0;
    Пока Выборка.Следующий() Цикл
        СтрокаCSV = "";
        Для Индекс = 0 По ИндексПоследнегоПоля Цикл
            ФорматПоля = Форматы[Индекс];
            Если ФорматПоля = "" Тогда
                ТекстПоля = СокрП(Выборка[Индекс]);
                Если СтрНайти(ТекстПоля, Символы.ПС) > 0 Или СтрНайти(ТекстПоля, Символы.ВК) > 0 Тогда
                    ТекстПоля = ТекстБезПереводовСтрок(ТекстПоля);
                КонецЕсли;
                СтрокаCSV = СтрокаCSV + ТекстПоля + "|";
            Иначе
                СтрокаCSV = СтрокаCSV + Формат(Выборка[Индекс], ФорматПоля) + "|";
            КонецЕсли;
        КонецЦикла;
        Буфер.Добавить(СтрокаCSV);
        Счетчик = Счетчик + 1;
        Если Буфер.Количество() >= 4000 Тогда
            СброситьБуфер(Буфер, ЗаписьТекста);
        КонецЕсли;
    КонецЦикла;
    Если Буфер.Количество() > 0 Тогда
        СброситьБуфер(Буфер, ЗаписьТекста);
    КонецЕсли;
    Возврат Счетчик;

КонецФункции

Функция ЦиклB(Выборка, Форматы, ИндексПоследнегоПоля, ЗаписьТекста, СокращатьПробелы)

    Буфер = Новый Массив;
    Счетчик = 0;
    Пока Выборка.Следующий() Цикл
        СтрокаCSV = "";
        Если СокращатьПробелы Тогда
            Для Индекс = 0 По ИндексПоследнегоПоля Цикл
                ФорматПоля = Форматы[Индекс];
                Если ФорматПоля = "" Тогда
                    СтрокаCSV = СтрокаCSV + СокрП(Выборка[Индекс]) + "|";
                Иначе
                    СтрокаCSV = СтрокаCSV + Формат(Выборка[Индекс], ФорматПоля) + "|";
                КонецЕсли;
            КонецЦикла;
        Иначе
            Для Индекс = 0 По ИндексПоследнегоПоля Цикл
                ФорматПоля = Форматы[Индекс];
                Если ФорматПоля = "" Тогда
                    СтрокаCSV = СтрокаCSV + Выборка[Индекс] + "|";
                Иначе
                    СтрокаCSV = СтрокаCSV + Формат(Выборка[Индекс], ФорматПоля) + "|";
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если СтрНайти(СтрокаCSV, Символы.ПС) > 0 Или СтрНайти(СтрокаCSV, Символы.ВК) > 0 Тогда
            СтрокаCSV = ТекстБезПереводовСтрок(СтрокаCSV);
        КонецЕсли;
        Буфер.Добавить(СтрокаCSV);
        Счетчик = Счетчик + 1;
        Если Буфер.Количество() >= 4000 Тогда
            СброситьБуфер(Буфер, ЗаписьТекста);
        КонецЕсли;
    КонецЦикла;
    Если Буфер.Количество() > 0 Тогда
        СброситьБуфер(Буфер, ЗаписьТекста);
    КонецЕсли;
    Возврат Счетчик;

КонецФункции

Функция ЦиклD(Выборка, Виды, ИндексПоследнегоПоля, ЗаписьТекста, СокращатьПробелы)

    ПустаяДата = Дата(1, 1, 1);
    Буфер = Новый Массив;
    Счетчик = 0;
    Пока Выборка.Следующий() Цикл
        СтрокаCSV = "";
        Для Индекс = 0 По ИндексПоследнегоПоля Цикл
            Вид = Виды[Индекс];
            Если Вид = 0 Тогда
                Если СокращатьПробелы Тогда
                    СтрокаCSV = СтрокаCSV + СокрП(Выборка[Индекс]) + "|";
                Иначе
                    СтрокаCSV = СтрокаCSV + Выборка[Индекс] + "|";
                КонецЕсли;
            ИначеЕсли Вид = 3 Тогда
                СтрокаCSV = СтрокаCSV + XMLСтрока(Выборка[Индекс]) + "|";
            ИначеЕсли Вид = 1 Тогда
                ЗначениеПоля = Выборка[Индекс];
                Если ЗначениеПоля = ПустаяДата Тогда
                    СтрокаCSV = СтрокаCSV + "|";
                Иначе
                    СтрокаCSV = СтрокаCSV + Лев(XMLСтрока(ЗначениеПоля), 10) + "|";
                КонецЕсли;
            ИначеЕсли Вид = 4 Тогда
                ЗначениеПоля = Выборка[Индекс];
                Если ЗначениеПоля = 0 Тогда
                    СтрокаCSV = СтрокаCSV + "|";
                Иначе
                    СтрокаCSV = СтрокаCSV + XMLСтрока(ЗначениеПоля) + "|";
                КонецЕсли;
            Иначе
                ЗначениеПоля = Выборка[Индекс];
                Если ЗначениеПоля = ПустаяДата Тогда
                    СтрокаCSV = СтрокаCSV + "|";
                Иначе
                    СтрокаCSV = СтрокаCSV + Сред(XMLСтрока(ЗначениеПоля), 12, 8) + "|";
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Если СтрНайти(СтрокаCSV, Символы.ПС) > 0 Или СтрНайти(СтрокаCSV, Символы.ВК) > 0 Тогда
            СтрокаCSV = ТекстБезПереводовСтрок(СтрокаCSV);
        КонецЕсли;
        Буфер.Добавить(СтрокаCSV);
        Счетчик = Счетчик + 1;
        Если Буфер.Количество() >= 4000 Тогда
            СброситьБуфер(Буфер, ЗаписьТекста);
        КонецЕсли;
    КонецЦикла;
    Если Буфер.Количество() > 0 Тогда
        СброситьБуфер(Буфер, ЗаписьТекста);
    КонецЕсли;
    Возврат Счетчик;

КонецФункции

Функция ЦиклH(Выборка, Виды, ИндексПоследнегоПоля, ЗаписьТекста)

    ПустаяДата = Дата(1, 1, 1);
    Буфер = Новый Массив;
    Значения = Новый Массив(ИндексПоследнегоПоля + 2);
    Значения[ИндексПоследнегоПоля + 1] = "";
    Счетчик = 0;
    Пока Выборка.Следующий() Цикл
        Для Индекс = 0 По ИндексПоследнегоПоля Цикл
            Вид = Виды[Индекс];
            Если Вид = 0 Тогда
                Значения[Индекс] = СокрП(Выборка[Индекс]);
            ИначеЕсли Вид = 3 Тогда
