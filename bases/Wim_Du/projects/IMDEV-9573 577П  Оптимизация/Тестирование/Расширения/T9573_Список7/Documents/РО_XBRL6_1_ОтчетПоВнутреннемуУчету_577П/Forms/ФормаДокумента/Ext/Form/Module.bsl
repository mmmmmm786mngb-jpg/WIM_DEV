
#Область ОбработчикиСобытийФормы

// Тестовое расширение IMDEV-9573, не для поставки. Опыт: раздел 7 показывается динамическим списком
// СписокРаздел7 (читает строки из базы порциями), таблица Объект.Раздел7 скрыта.
//
// Параметры:
//  Отказ - Булево
//  СтандартнаяОбработка - Булево
//
&НаСервере
&После("ПриСозданииНаСервере")
Процедура T9573Л_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Раздел7.Видимость = Ложь;
	СписокРаздел7.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Код "Стало" из p577_fill_code_swap.html, но вместо Прочитать() обновляется динамический список раздела 7.
// Табличные части Объект после заполнения не перечитываются: опыт меряет только память и время.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
&Вместо("Заполнить")
Процедура T9573Л_Заполнить(Команда)

	Отказ = Ложь;

	Если Не ЗначениеЗаполнено(Объект.УправляющаяКомпания) Тогда

		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит Управляющая компания. Заполнение невозможно.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.УправляющаяКомпания", , Отказ);

	КонецЕсли;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЗаполнитьДокументНаСервере(Объект.Ссылка);

	СписокРаздел7.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	Элементы.СписокРаздел7.Обновить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеБезКонтекстаФормы

// Заполняет и записывает документ по ссылке без передачи данных формы.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//
&НаСервереБезКонтекста
Процедура ЗаполнитьДокументНаСервере(ДокументСсылка)

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ДокументОбъект.ЗаполнитьОтчет();
	ДокументОбъект.Записать();

КонецПроцедуры

#КонецОбласти

#КонецОбласти
