
#Область ПрограммныйИнтерфейс

// Тестовое расширение IMDEV-9573, не для поставки.
//
// После штатного ЗаполнитьОтчет() дописывает в разделы 1-11 детерминированные строки, чтобы на
// базе без операционных данных проверить перенос строк формой. Количество строк на раздел берется
// из ХранилищеОбщихНастроек ("T9573", "КоличествоСтрок"); 0 или пусто - генерация выключена.
// Строки не создаются, если заполнены ДоговораДУ: этот режим оставлен для проверки отказа
// заполнения штатным кодом.
//
&После("ЗаполнитьОтчет")
Процедура T9573Д_ЗаполнитьОтчет() Экспорт

	КоличествоСтрок = ХранилищеОбщихНастроек.Загрузить("T9573", "КоличествоСтрок");
	Если ТипЗнч(КоличествоСтрок) <> Тип("Число") Или КоличествоСтрок <= 0 Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЭтотОбъект["ДоговораДУ"]) Тогда
		Возврат;
	КонецЕсли;

	Ссылки = СсылкиДляГенерации();

	Для НомерРаздела = 1 По 11 Цикл
		Если Не ЭтотОбъект["ВыгружатьРаздел" + НомерРаздела] Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьРазделТестовымиСтроками(НомерРаздела, КоличествоСтрок, Ссылки);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ГенерацияТестовыхСтрок

// Заполняет табличную часть РазделN строками, значения которых зависят только от номера раздела,
// номера строки и номера колонки.
//
// Параметры:
//  НомерРаздела - Число - 1..11
//  КоличествоСтрок - Число - сколько строк добавить
//  Ссылки - Соответствие - из СсылкиДляГенерации()
//
Процедура ЗаполнитьРазделТестовымиСтроками(НомерРаздела, КоличествоСтрок, Ссылки)

	ИмяРаздела = "Раздел" + НомерРаздела;
	Колонки = ОписаниеКолонокРаздела(ИмяРаздела, Ссылки);
	ТабличнаяЧасть = ЭтотОбъект[ИмяРаздела];

	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		Для Каждого Колонка Из Колонки Цикл
			НоваяСтрока[Колонка.Имя] = ЗначениеЯчейки(Колонка, НомерРаздела, НомерСтроки);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Описание колонок раздела для генерации.
//
// Параметры:
//  ИмяРаздела - Строка - имя табличной части
//  Ссылки - Соответствие - из СсылкиДляГенерации()
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя - Строка
//   * НомерКолонки - Число
//   * Вид - Строка - Строка, Число, Дата, Время, ДатаВремя, Булево, Ссылка
//   * Длина - Число - длина строки, 0 - неограниченная
//   * Разрядность - Число
//   * РазрядностьДробнойЧасти - Число
//   * Значения - Массив - ссылки для колонки ссылочного типа
//
Функция ОписаниеКолонокРаздела(ИмяРаздела, Ссылки)

	Колонки = Новый Массив;
	НомерКолонки = 0;

	Для Каждого Реквизит Из Метаданные().ТабличныеЧасти[ИмяРаздела].Реквизиты Цикл

		НомерКолонки = НомерКолонки + 1;
		ТипРеквизита = Реквизит.Тип;

		Колонка = Новый Структура;
		Колонка.Вставить("Имя", Реквизит.Имя);
		Колонка.Вставить("НомерКолонки", НомерКолонки);
		Колонка.Вставить("Вид", "");
		Колонка.Вставить("Длина", 0);
		Колонка.Вставить("Разрядность", 0);
		Колонка.Вставить("РазрядностьДробнойЧасти", 0);
		Колонка.Вставить("Значения", Неопределено);

		Если ТипРеквизита.СодержитТип(Тип("Строка")) Тогда
			Колонка.Вид = "Строка";
			Колонка.Длина = ТипРеквизита.КвалификаторыСтроки.Длина;
		ИначеЕсли ТипРеквизита.СодержитТип(Тип("Число")) Тогда
			Колонка.Вид = "Число";
			Колонка.Разрядность = ТипРеквизита.КвалификаторыЧисла.Разрядность;
			Колонка.РазрядностьДробнойЧасти = ТипРеквизита.КвалификаторыЧисла.РазрядностьДробнойЧасти;
		ИначеЕсли ТипРеквизита.СодержитТип(Тип("Дата")) Тогда
			Если ТипРеквизита.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Время Тогда
				Колонка.Вид = "Время";
			ИначеЕсли ТипРеквизита.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Дата Тогда
				Колонка.Вид = "Дата";
			Иначе
				Колонка.Вид = "ДатаВремя";
			КонецЕсли;
		ИначеЕсли ТипРеквизита.СодержитТип(Тип("Булево")) Тогда
			Колонка.Вид = "Булево";
		Иначе
			Колонка.Вид = "Ссылка";
			Колонка.Значения = Ссылки.Получить(ТипРеквизита.Типы()[0]);
		КонецЕсли;

		Колонки.Добавить(Колонка);

	КонецЦикла;

	Возврат Колонки;

КонецФункции

// Значение ячейки по номеру раздела, строки и колонки. Каждый 11-й ряд пустой, каждый 7-й содержит
// спецсимволы и строку предельной длины, каждый 5-й - отрицательные числа.
//
// Параметры:
//  Колонка - Структура - элемент из ОписаниеКолонокРаздела()
//  НомерРаздела - Число
//  НомерСтроки - Число
//
// Возвращаемое значение:
//  Строка, Число, Дата, Булево, ЛюбаяСсылка, Неопределено
//
Функция ЗначениеЯчейки(Колонка, НомерРаздела, НомерСтроки)

	Ключ = НомерРаздела * 1000003 + НомерСтроки * 7919 + Колонка.НомерКолонки * 104729;
	ПустаяСтрокаДанных = (НомерСтроки % 11 = 0);
	ОсобаяСтрока = (НомерСтроки % 7 = 0);

	Если Колонка.Вид = "Строка" Тогда
		Если ПустаяСтрокаДанных Тогда
			Возврат "";
		КонецЕсли;
		Текст = СтрШаблон("Р%1-С%2-К%3", НомерРаздела, НомерСтроки, Колонка.НомерКолонки);
		Если ОсобаяСтрока Тогда
			Текст = Текст + " ""кавычки"" <тег> & амп; Ёё ##";
			Пока Колонка.Длина > 0 И СтрДлина(Текст) < Колонка.Длина Цикл
				Текст = Текст + "Ж" + НомерСтроки;
			КонецЦикла;
		КонецЕсли;
		Если Колонка.Длина > 0 Тогда
			Текст = Лев(Текст, Колонка.Длина);
		КонецЕсли;
		Возврат Текст;

	ИначеЕсли Колонка.Вид = "Число" Тогда
		Если ПустаяСтрокаДанных Тогда
			Возврат 0;
		КонецЕсли;
		ЦифрЦелой = Мин(Колонка.Разрядность - Колонка.РазрядностьДробнойЧасти, 12);
		Значение = Ключ % Pow(10, ЦифрЦелой);
		Если Колонка.РазрядностьДробнойЧасти > 0 Тогда
			ДробнаяЧасть = (Ключ * 31) % Pow(10, Колонка.РазрядностьДробнойЧасти);
			Значение = Значение + ДробнаяЧасть / Pow(10, Колонка.РазрядностьДробнойЧасти);
		КонецЕсли;
		Если НомерСтроки % 5 = 0 Тогда
			Значение = -Значение;
		КонецЕсли;
		Возврат Значение;

	ИначеЕсли Колонка.Вид = "Дата" Тогда
		Если ПустаяСтрокаДанных Тогда
			Возврат Дата(1, 1, 1);
		КонецЕсли;
		Возврат Дата(2026, 6, 1) + (Ключ % 30) * 86400;

	ИначеЕсли Колонка.Вид = "Время" Тогда
		Если ПустаяСтрокаДанных Тогда
			Возврат Дата(1, 1, 1);
		КонецЕсли;
		Возврат Дата(1, 1, 1) + Ключ % 86400;

	ИначеЕсли Колонка.Вид = "ДатаВремя" Тогда
		Возврат Дата(2026, 6, 1) + Ключ % (30 * 86400);

	ИначеЕсли Колонка.Вид = "Булево" Тогда
		Возврат (Ключ % 2 = 0);

	Иначе
		Если ПустаяСтрокаДанных Или Колонка.Значения = Неопределено Или Не ЗначениеЗаполнено(Колонка.Значения) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Колонка.Значения[Ключ % Колонка.Значения.Количество()];

	КонецЕсли;

КонецФункции

// Первые 200 элементов справочников, на которые ссылаются колонки разделов, в постоянном порядке.
//
// Возвращаемое значение:
//  Соответствие - ключ Тип ссылки, значение Массив ссылок
//
Функция СсылкиДляГенерации()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорДУ КАК Договоры
	|УПОРЯДОЧИТЬ ПО
	|	Договоры.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 200
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АналитическиеСчета КАК Счета
	|УПОРЯДОЧИТЬ ПО
	|	Счета.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 200
	|	Валюты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|УПОРЯДОЧИТЬ ПО
	|	Валюты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 200
	|	Активы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Активы КАК Активы
	|УПОРЯДОЧИТЬ ПО
	|	Активы.Ссылка";

	Результаты = Запрос.ВыполнитьПакет();

	Ссылки = Новый Соответствие;
	Ссылки.Вставить(Тип("СправочникСсылка.ДоговорДУ"), Результаты[0].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Ссылки.Вставить(Тип("СправочникСсылка.АналитическиеСчета"), Результаты[1].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Ссылки.Вставить(Тип("СправочникСсылка.Валюты"), Результаты[2].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Ссылки.Вставить(Тип("СправочникСсылка.Активы"), Результаты[3].Выгрузить().ВыгрузитьКолонку("Ссылка"));

	Возврат Ссылки;

КонецФункции

#КонецОбласти

#КонецОбласти
