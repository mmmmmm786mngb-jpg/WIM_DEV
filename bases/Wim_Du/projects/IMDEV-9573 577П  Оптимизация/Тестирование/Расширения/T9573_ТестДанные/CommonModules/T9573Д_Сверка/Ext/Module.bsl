
#Область ПрограммныйИнтерфейс

// Тестовое расширение IMDEV-9573, не для поставки.
//
// Снимок записанного документа 577-П для сравнения прогонов "было" и "стало". Ничего не записывает.
//
// Параметры:
//  Ссылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//
// Возвращаемое значение:
//  Строка - строки вида "ключ=значение": реквизиты шапки, Проведен, ПометкаУдаления, число вложений,
//   по каждой табличной части число строк и MD5 построчного представления
//
Функция СнимокДокумента(Ссылка) Экспорт

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	МетаданныеДокумента = ДокументОбъект.Метаданные();

	Строки = Новый Массив;
	Строки.Добавить("Проведен=" + XMLСтрока(ДокументОбъект.Проведен));
	Строки.Добавить("ПометкаУдаления=" + XMLСтрока(ДокументОбъект.ПометкаУдаления));
	Строки.Добавить("Вложений=" + XMLСтрока(КоличествоВложений(Ссылка)));

	Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		Строки.Добавить("Шапка." + Реквизит.Имя + "=" + ПредставлениеЗначения(ДокументОбъект[Реквизит.Имя]));
	КонецЦикла;

	Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		Таблица = ДокументОбъект[ТабличнаяЧасть.Имя];
		Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Хеширование.Добавить(ПредставлениеСтроки(СтрокаТаблицы, ТабличнаяЧасть));
		КонецЦикла;
		Строки.Добавить(СтрШаблон("ТЧ.%1=%2;%3", ТабличнаяЧасть.Имя, XMLСтрока(Таблица.Количество()),
			ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма)));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Построчная выгрузка одной табличной части для поиска первого расхождения.
//
// Параметры:
//  Ссылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//  ИмяТабличнойЧасти - Строка
//
// Возвращаемое значение:
//  Строка - одна строка текста на строку табличной части
//
Функция ВыгрузкаТабличнойЧасти(Ссылка, ИмяТабличнойЧасти) Экспорт

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ТабличнаяЧасть = ДокументОбъект.Метаданные().ТабличныеЧасти[ИмяТабличнойЧасти];

	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТабличнойЧасти] Цикл
		Строки.Добавить(ПредставлениеСтроки(СтрокаТаблицы, ТабличнаяЧасть));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Формирует файл отчета штатной функцией ВыгрузитьОтчет() у документа из базы.
//
// Параметры:
//  Ссылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//
// Возвращаемое значение:
//  Строка - "размер;MD5" двоичных данных файла
//
Функция ХешФайлаВыгрузки(Ссылка) Экспорт

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	АдресДанных = ДокументОбъект.ВыгрузитьОтчет();
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресДанных);

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(ДанныеФайла);

	Возврат XMLСтрока(ДанныеФайла.Размер()) + ";" + ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПредставлениеДанных

// Параметры:
//  СтрокаТаблицы - СтрокаТабличнойЧасти
//  ТабличнаяЧасть - ОбъектМетаданных - табличная часть документа
//
// Возвращаемое значение:
//  Строка - номер строки и значения всех колонок через табуляцию
//
Функция ПредставлениеСтроки(СтрокаТаблицы, ТабличнаяЧасть)

	Значения = Новый Массив;
	Значения.Добавить(XMLСтрока(СтрокаТаблицы.НомерСтроки));
	Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
		Значения.Добавить(ПредставлениеЗначения(СтрокаТаблицы[Реквизит.Имя]));
	КонецЦикла;

	Возврат СтрСоединить(Значения, Символы.Таб);

КонецФункции

// Параметры:
//  Значение - Произвольный - значение реквизита
//
// Возвращаемое значение:
//  Строка - имя типа и XML-представление, чтобы различать 0, пустую строку и пустую ссылку
//
Функция ПредставлениеЗначения(Значение)

	Если Значение = Неопределено Тогда
		Возврат "U";
	КонецЕсли;

	Возврат XMLТипЗнч(Значение).ИмяТипа + ":" + XMLСтрока(Значение);

КонецФункции

// Параметры:
//  Ссылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//
// Возвращаемое значение:
//  Число - непомеченные вложения документа
//
Функция КоличествоВложений(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Файлы.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.ХранилищеПрисоединенныхФайлов КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла = &Ссылка
	|	И НЕ Файлы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти

#КонецОбласти
