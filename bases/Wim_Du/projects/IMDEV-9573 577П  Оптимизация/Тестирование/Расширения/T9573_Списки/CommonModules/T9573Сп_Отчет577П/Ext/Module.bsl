
// Прототип IMDEV-9573, не для поставки: работа с документом "(XBRL6.1) Отчет по внутреннему учету 577-П" по ссылке,
// без копирования табличных частей разделов в данные формы.

#Область СлужебныйПрограммныйИнтерфейс

// Заполняет документ по ссылке (ЗаполнитьОтчет) и записывает его в режиме Запись. Вызывается в фоновом задании
// из формы документа. Если заполнение отказано (среди договоров ДУ есть неподходящие), документ не записывается,
// чтобы не сохранить очищенные разделы.
//
// Параметры:
//  Параметры - Структура - параметры задания:
//   * ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//   * ДанныеШапки    - Структура, Неопределено - несохраненные изменения шапки из формы, состав см. ЗаполнитьШапку
//  АдресРезультата - Строка - адрес временного хранилища, куда помещается Структура:
//   * Заполнено - Булево - Истина, если документ заполнен и записан
//   * Сообщения - Массив из Строка - сообщения заполнения при отказе (какие договоры ДУ не подходят и почему)
//
Процедура ЗаполнитьИЗаписать(Параметры, АдресРезультата) Экспорт

	ДокументОбъект = Параметры.ДокументСсылка.ПолучитьОбъект();
	Если Параметры.ДанныеШапки <> Неопределено Тогда
		ЗаполнитьШапку(ДокументОбъект, Параметры.ДанныеШапки);
	КонецЕсли;

	ДокументОбъект.ЗаполнитьОтчет();

	// При отказе ЗаполнитьОтчет очищает разделы и выходит до ЗаполнитьСведенияУК, а дату направления запроса
	// заполняет только ЗаполнитьСведенияУК (значением КонецПериода): по ней отказ отличается от заполнения.
	Заполнено = ЗначениеЗаполнено(ДокументОбъект.ДатаНаправленияЗапроса);
	Сообщения = Новый Массив;
	Если Заполнено Тогда
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Иначе
		// Сообщения фонового задания в форму не доходят: передаются текстом в результате.
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Сообщения.Добавить(Сообщение.Текст);
		КонецЦикла;
	КонецЕсли;

	ПоместитьВоВременноеХранилище(Новый Структура("Заполнено, Сообщения", Заполнено, Сообщения), АдресРезультата);

КонецПроцедуры

// Переносит в документ шапку и отборы из формы и записывает его в указанном режиме. Табличные части разделов
// берутся из базы. При проведении документ выгружает отчет в присоединенный файл (ОбработкаПроведения).
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//  ДанныеШапки    - Структура - шапка и отборы из формы, состав см. ЗаполнитьШапку
//  РежимЗаписи    - РежимЗаписиДокумента
//
// Возвращаемое значение:
//  Структура - реквизиты шапки после записи, см. РеквизитыШапки
//
Функция ЗаписатьШапку(ДокументСсылка, ДанныеШапки, РежимЗаписи) Экспорт

	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ЗаполнитьШапку(ДокументОбъект, ДанныеШапки);
	ДокументОбъект.Записать(РежимЗаписи);

	Возврат РеквизитыШапки(ДокументСсылка);

КонецФункции

// Читает реквизиты шапки документа запросом, без чтения табличных частей.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//
// Возвращаемое значение:
//  Структура - Проведен, ПометкаУдаления и реквизиты из ИзменяемыеРеквизитыШапки
//
Функция РеквизитыШапки(ДокументСсылка) Экспорт

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Проведен, ПометкаУдаления, " + ИзменяемыеРеквизитыШапки());

КонецФункции

// Имена реквизитов шапки, которые пользователь меняет в форме: Дата, Номер и реквизиты документа.
//
// Возвращаемое значение:
//  Строка - имена через запятую
//
Функция ИзменяемыеРеквизитыШапки() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Дата");
	Имена.Добавить("Номер");
	Для Каждого Реквизит Из Метаданные.Документы.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П.Реквизиты Цикл
		Имена.Добавить(Реквизит.Имя);
	КонецЦикла;

	Возврат СтрСоединить(Имена, ", ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  ДокументОбъект - ДокументОбъект.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//  ДанныеШапки    - Структура:
//   * Реквизиты  - Структура - значения реквизитов из ИзменяемыеРеквизитыШапки
//   * ДоговораДУ - ТаблицаЗначений - табличная часть ДоговораДУ
//   * Активы     - ТаблицаЗначений - табличная часть Активы
//   * Валюты     - ТаблицаЗначений - табличная часть Валюты
//
Процедура ЗаполнитьШапку(ДокументОбъект, ДанныеШапки)

	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеШапки.Реквизиты);
	ДокументОбъект.ДоговораДУ.Загрузить(ДанныеШапки.ДоговораДУ);
	ДокументОбъект.Активы.Загрузить(ДанныеШапки.Активы);
	ДокументОбъект.Валюты.Загрузить(ДанныеШапки.Валюты);

КонецПроцедуры

#КонецОбласти
