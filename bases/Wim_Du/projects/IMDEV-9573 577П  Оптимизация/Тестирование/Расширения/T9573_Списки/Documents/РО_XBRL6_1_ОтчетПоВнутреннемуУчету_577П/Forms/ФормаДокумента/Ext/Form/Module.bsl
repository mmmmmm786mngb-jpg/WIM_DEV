
// Прототип IMDEV-9573, не для поставки. Разделы 1-11 показываются динамическими списками СписокРазделN, исходные
// таблицы Объект.РазделN скрыты. У записанного документа заполнение, запись, проведение и выгрузка выполняются
// на сервере по ссылке, поэтому табличные части разделов в данных формы не нужны и очищаются при открытии.

#Область ОбработчикиСобытийФормы

// Скрывает таблицы разделов, настраивает отбор списков по документу, очищает разделы в данных формы.
//
// Параметры:
//  Отказ                - Булево
//  СтандартнаяОбработка - Булево
//
&НаСервере
&После("ПриСозданииНаСервере")
Процедура T9573Сп_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого ИмяРаздела Из ИменаРазделов() Цикл
		Элементы[ИмяРаздела].Видимость = Ложь;
		Если Не Объект.Ссылка.Пустая() Тогда
			Объект[ИмяРаздела].Очистить();
		КонецЕсли;
	КонецЦикла;
	УстановитьОтборСписков();

КонецПроцедуры

// Настраивает отбор списков после первой записи нового документа.
//
// Параметры:
//  ТекущийОбъект  - ДокументОбъект.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П
//  ПараметрыЗаписи - Структура
//
&НаСервере
&После("ПослеЗаписиНаСервере")
Процедура T9573Сп_ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	УстановитьОтборСписков();

КонецПроцедуры

// Стандартная запись существующего документа (горячие клавиши, вопрос при закрытии) заменяется записью
// по ссылке: стандартная записала бы пустые разделы из данных формы.
//
// Параметры:
//  Отказ           - Булево
//  ПараметрыЗаписи - Структура - содержит РежимЗаписи
//
&НаКлиенте
Процедура T9573Сп_ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	ЗаписатьДокумент(ПараметрыЗаписи.РежимЗаписи);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Заполняет документ в фоновом задании по ссылке и записывает его. После заполнения обновляются шапка
// и списки разделов; документ в форму не перечитывается.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
&Вместо("Заполнить")
Процедура T9573Сп_Заполнить(Команда)

	Если Не ЗначениеЗаполнено(Объект.УправляющаяКомпания) Тогда
		ТекстСообщения = НСтр("ru = 'Не заполнен реквизит Управляющая компания. Заполнение невозможно.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.УправляющаяКомпания");
		Возврат;
	КонецЕсли;

	Если Объект.Ссылка.Пустая() Тогда
		Если Не Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись)) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ДлительнаяОперация = НачатьЗаполнение(Модифицированность);

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения    = НСтр("ru = 'Заполнение отчета'");
	ПараметрыОжидания.ВыводитьСообщения = Истина;

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнениеЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ПровестиИЗакрытьПоСсылке(Команда)

	Если ЗаписатьДокумент(РежимЗаписиДокумента.Проведение) Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ЗаписатьПоСсылке(Команда)

	ЗаписатьДокумент(РежимЗаписиДокумента.Запись);

КонецПроцедуры

// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ПровестиПоСсылке(Команда)

	ЗаписатьДокумент(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Таблицы разделов остаются скрытыми, видимость списков следует флагам ВыгружатьРазделN.
//
&НаКлиенте
&После("УправлениеФормой")
Процедура T9573Сп_УправлениеФормой()

	Для Каждого ИмяРаздела Из ИменаРазделов() Цикл
		Элементы[ИмяРаздела].Видимость = Ложь;
		Элементы["Список" + ИмяРаздела].Видимость = Объект["Выгружать" + ИмяРаздела];
	КонецЦикла;

КонецПроцедуры

// Выгружает отчет из документа, прочитанного по ссылке: разделы в данных формы очищены.
// Полная замена без ПродолжитьВызов: типовая функция выгружает данные формы.
//
// Возвращаемое значение:
//  Строка - адрес временного хранилища с двоичными данными файла отчета
//
&НаСервере
&Вместо("ВыгрузитьНаСервере")
Функция T9573Сп_ВыгрузитьНаСервере()

	Возврат Объект.Ссылка.ПолучитьОбъект().ВыгрузитьОтчет();

КонецФункции

// Полная замена без ПродолжитьВызов: типовая процедура дважды копирует весь документ между формой и объектом
// ради регистра ДанныеРегламентныхОтчетов, а сохранение в этот регистр в модуле объекта отключено.
//
// Параметры:
//  Отказ - Булево
//
&НаСервере
&Вместо("ЗагрузитьДанныеТабЧастейИзРегистра")
Процедура T9573Сп_ЗагрузитьДанныеТабЧастейИзРегистра(Отказ = Ложь)

	Возврат;

КонецПроцедуры

#Область ЗаполнениеИЗаписьПоСсылке

// Параметры:
//  ПередатьШапку - Булево - передать в задание несохраненные изменения шапки
//
// Возвращаемое значение:
//  Структура - см. ДлительныеОперации.ВыполнитьВФоне
//
&НаСервере
Функция НачатьЗаполнение(Знач ПередатьШапку)

	ПараметрыПроцедуры = Новый Структура("ДокументСсылка, ДанныеШапки", Объект.Ссылка, Неопределено);
	Если ПередатьШапку Тогда
		ПараметрыПроцедуры.ДанныеШапки = ДанныеШапкиФормы();
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение отчета 577-П'");

	Возврат ДлительныеОперации.ВыполнитьВФоне("T9573Сп_Отчет577П.ЗаполнитьИЗаписать", ПараметрыПроцедуры,
		ПараметрыВыполнения);

КонецФункции

// Параметры:
//  Результат               - Структура, Неопределено - см. ДлительныеОперацииКлиент.ОжидатьЗавершение
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура ЗаполнениеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	РезультатЗаполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	Если Не РезультатЗаполнения.Заполнено Тогда
		Для Каждого ТекстСообщения Из РезультатЗаполнения.Сообщения Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Документ не изменен.'"));
		Возврат;
	КонецЕсли;

	ОбновитьШапкуИзБазы();
	ПослеЗаписиПоСсылке();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Отчет заполнен и записан'"), , ТекстПослеЗаписиПоСсылке());

КонецПроцедуры

// Записывает документ: новый - стандартной записью формы, существующий - по ссылке.
//
// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента
//
// Возвращаемое значение:
//  Булево - Истина, если документ записан
//
&НаКлиенте
Функция ЗаписатьДокумент(РежимЗаписи)

	Если Объект.Ссылка.Пустая() Тогда
		Возврат Записать(Новый Структура("РежимЗаписи", РежимЗаписи));
	КонецЕсли;

	ЗаписатьШапкуНаСервере(РежимЗаписи);
	ПослеЗаписиПоСсылке();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Документ записан'"), , ТекстПослеЗаписиПоСсылке());

	Возврат Истина;

КонецФункции

// После записи по ссылке версия данных в форме устаревает: стандартная блокировка данных формы при изменении
// предложила бы перечитать весь документ. Поэтому форма переводится в режим просмотра.
//
&НаКлиенте
Процедура ПослеЗаписиПоСсылке()

	Модифицированность = Ложь;
	ТолькоПросмотр = Истина;
	ОбновитьСписки();
	ОповеститьОбИзменении(Объект.Ссылка);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстПослеЗаписиПоСсылке()

	Возврат НСтр("ru = 'Чтобы изменить шапку, откройте документ заново.'");

КонецФункции

// Параметры:
//  РежимЗаписи - РежимЗаписиДокумента
//
&НаСервере
Процедура ЗаписатьШапкуНаСервере(Знач РежимЗаписи)

	Реквизиты = T9573Сп_Отчет577П.ЗаписатьШапку(Объект.Ссылка, ДанныеШапкиФормы(), РежимЗаписи);
	ЗаполнитьЗначенияСвойств(Объект, Реквизиты);

КонецПроцедуры

&НаСервере
Процедура ОбновитьШапкуИзБазы()

	ЗаполнитьЗначенияСвойств(Объект, T9573Сп_Отчет577П.РеквизитыШапки(Объект.Ссылка));

КонецПроцедуры

// Возвращаемое значение:
//  Структура - шапка и отборы документа из данных формы, см. T9573Сп_Отчет577П.ЗаполнитьШапку
//
&НаСервере
Функция ДанныеШапкиФормы()

	Реквизиты = Новый Структура(T9573Сп_Отчет577П.ИзменяемыеРеквизитыШапки());
	ЗаполнитьЗначенияСвойств(Реквизиты, Объект);

	ДанныеШапки = Новый Структура;
	ДанныеШапки.Вставить("Реквизиты",  Реквизиты);
	ДанныеШапки.Вставить("ДоговораДУ", Объект.ДоговораДУ.Выгрузить());
	ДанныеШапки.Вставить("Активы",     Объект.Активы.Выгрузить());
	ДанныеШапки.Вставить("Валюты",     Объект.Валюты.Выгрузить());

	Возврат ДанныеШапки;

КонецФункции

#КонецОбласти

#Область СпискиРазделов

&НаСервере
Процедура УстановитьОтборСписков()

	Для Каждого ИмяРаздела Из ИменаРазделов() Цикл
		ЭтотОбъект["Список" + ИмяРаздела].Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписки()

	Для Каждого ИмяРаздела Из ИменаРазделов() Цикл
		Элементы["Список" + ИмяРаздела].Обновить();
	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//  Массив из Строка - имена табличных частей разделов: Раздел1 ... Раздел11
//
&НаКлиентеНаСервереБезКонтекста
Функция ИменаРазделов()

	Имена = Новый Массив;
	Для НомерРаздела = 1 По 11 Цикл
		Имена.Добавить("Раздел" + Формат(НомерРаздела, "ЧГ="));
	КонецЦикла;

	Возврат Имена;

КонецФункции

#КонецОбласти

#КонецОбласти
