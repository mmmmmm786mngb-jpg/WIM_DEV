
&НаКлиенте
Процедура СформироватьФайлыВыгрузкиОтчета(Команда)
	
	ПереопределитьПутьВыгрузки(Объект.ПутьВыгрузки);
	
	РазделыДляВыгрузки = СтруктураРазделовДляВыгрузки();
	
	Для каждого Раздел из РазделыДляВыгрузки Цикл
		
		СформироватьСохранитьТДПоРазделу(Раздел.Значение); 
		
		ДанныеCSV = ПолучитьИзВременногоХранилища(Объект.АдресХранилищаФайлаCSV);
		ДанныеXLSX = ПолучитьИзВременногоХранилища(Объект.АдресХранилищаФайлаXLSX);
		
		ПутьФайлаРаздела = Объект.ПутьВыгрузки + Раздел.Ключ;
		ДанныеCSV.Записать(ПутьФайлаРаздела + ".csv");
		ДанныеXLSX.Записать(ПутьФайлаРаздела + ".xlsx");
		
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Сформированы файлы выгрузки " + Раздел.Значение + ": " + ПутьФайлаРаздела;
		СообщениеПользователю.Сообщить();
		
	КонецЦикла;
	
	ДанныеСопроводительнойИнформации = СопроводительнаяИнформация();
	
	ПутьФайлаСопроводительнойИнформации = Объект.ПутьВыгрузки + "sr_sved_purcb.csv";
	ДанныеCSV = Новый ЗаписьТекста(ПутьФайлаСопроводительнойИнформации, КодировкаТекста.UTF8);
	
	МассивЗаголовков = Новый Массив;
	МассивДанных = Новый Массив;
	
	Для Каждого Колонка Из ДанныеСопроводительнойИнформации Цикл
		МассивЗаголовков.Добавить(Колонка.Ключ);
		МассивДанных.Добавить(Колонка.Значение);
	КонецЦикла;
	СтрокаЗаголовков = СтрСоединить(МассивЗаголовков, "|");
	СтрокаЗначений = СтрСоединить(МассивДанных, "|");
	ДанныеCSV.ЗаписатьСтроку(СтрокаЗаголовков);
	ДанныеCSV.ЗаписатьСтроку(СтрокаЗначений);
	ДанныеCSV.Закрыть();
	
	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = "Сформирован файл: " + ПутьФайлаСопроводительнойИнформации;
	СообщениеПользователю.Сообщить();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначенияМассив) Экспорт
	
	Для каждого ОбъектНазначения из ОбъектыНазначенияМассив Цикл
		Объект.ДокументОтчета = ОбъектНазначения;
		СформироватьФайлыВыгрузкиОтчета(ИдентификаторКоманды);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураРазделовДляВыгрузки()
	Разделы = Новый Структура;
	Разделы.Вставить("R1", "Раздел1");
	Разделы.Вставить("R2", "Раздел2");
	Разделы.Вставить("R3", "Раздел3");
	Разделы.Вставить("R4", "Раздел4");
	Разделы.Вставить("R5", "Раздел5");
	Разделы.Вставить("R6", "Раздел6");
	Разделы.Вставить("R7", "Раздел7");
	Разделы.Вставить("R8", "Раздел8");
	Разделы.Вставить("R9", "Раздел9");
	Разделы.Вставить("R10", "Раздел10");
	Разделы.Вставить("R11", "Раздел11");
	Возврат Разделы;
КонецФункции

&НаКлиенте
Процедура ПереопределитьПутьВыгрузки(ПутьВыгрузки)
	
	ПутьВыгрузки = "C:\InfoBases\";
	
	Файл = Новый Файл(ПутьВыгрузки);
	Если НЕ Файл.Существует() Тогда
		ПутьВыгрузки = "";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПутьВыгрузки) Тогда
		
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		
		Диалог.Заголовок = НСтр("ru = 'Укажите каталог'");
		Если Диалог.Выбрать() Тогда
			ПутьВыгрузки = Диалог.Каталог + "\";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьСохранитьТДПоРазделу(ИмяРаздела)
	
	ИсточникДанных = Объект.ДокументОтчета[ИмяРаздела];
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ИсточникДанных);
	Построитель.ВыводитьПодвалТаблицы = Ложь;
	СкорректироватьПредставлениеИПорядокПолей(ИмяРаздела, Построитель.ВыбранныеПоля);
	УстановитьОформление(Построитель);
	Построитель.Вывести(ТабличныйДокумент);
	
	//Построитель оставляет первую колонку пустой, удаляем ее чтобы данные начинались с первой колонки
	ОбластьУдаления = ТабличныйДокумент.Область(1, , 3, );
	ТабличныйДокумент.УдалитьОбласть(ОбластьУдаления, ТипСмещенияТабличногоДокумента.ПоВертикали);
	ОбластьУдаления = ТабличныйДокумент.Область(1, 1, ТабличныйДокумент.ВысотаТаблицы, 1);
	ТабличныйДокумент.УдалитьОбласть(ОбластьУдаления, ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	
	ИмяВременногоФайлаXLSX = ПолучитьИмяВременногоФайла("xlsx");
	ТабличныйДокумент.Записать(ИмяВременногоФайлаXLSX,"XLSX");
	Объект.АдресХранилищаФайлаXLSX = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайлаXLSX), УникальныйИдентификатор);
		
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("csv");
	
	//В Табличном документе заменяем все символы Табуляции на текст "<$СимволТабуляции$/>" чтобы исключить конфликты при создании csv-файла
	// этот цикл можно исключить если исходные данные точно не содержат символы табуляции
	ОбластьПоиска = ТабличныйДокумент.Область(1,1,1,1);
	Пока Истина Цикл
		ОбластьПоиска = ТабличныйДокумент.НайтиТекст(Символы.Таб,ОбластьПоиска);
		Если ОбластьПоиска = Неопределено Тогда
			Прервать;
		КонецЕсли;
		ОбластьПоиска.Текст = СтрЗаменить(ОбластьПоиска.Текст,Символы.Таб,"<$СимволТабуляции$/>");
	КонецЦикла;
	
	// Сохраняем Табличный документ как текст, в полученном текстовом документе значения каждой ячейки разделяются через символ табуляции 
	ТабличныйДокумент.Записать(ИмяВременногоФайла,ТипФайлаТабличногоДокумента.TXT);
	
	//Извлекаем полученный Текстовый документ
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.Прочитать(ИмяВременногоФайла,КодировкаТекста.UTF8,Символы.ПС);
	Текст = ТекстовыйФайл.ПолучитьТекст();
	
	//Заменяем сформированные символы табуляции на символ рахделитель csv файла - ";"
	Текст = СтрЗаменить(Текст,Символы.Таб,"|"); 
	
	// Востанавливаем ранее экранированные символы табуляции в самих данных
	Текст = СтрЗаменить(Текст,"<$СимволТабуляции$/>",Символы.Таб);
	
	// Сохраняем сформированные текст csv-файла 
	ТекстовыйФайл.УстановитьТекст(Текст);
	ТекстовыйФайл.Записать(ИмяВременногоФайла,,Символы.ПС);  
	Объект.АдресХранилищаФайлаCSV = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), УникальныйИдентификатор);
	
	УдалитьФайлы(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайлаXLSX);
	
КонецПроцедуры 

