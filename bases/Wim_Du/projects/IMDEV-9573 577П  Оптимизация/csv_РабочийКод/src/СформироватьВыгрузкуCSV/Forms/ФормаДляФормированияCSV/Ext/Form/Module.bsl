&НаСервере
Процедура СкорректироватьПредставлениеИПорядокПолей(ИсточникДанных, ВыбранныеПоля)
	ВыбранныеПоля.Очистить();
	Если ИсточникДанных = "Раздел1" Тогда
		Представления = СписокПредставленийРаздел1();
	ИначеЕсли ИсточникДанных = "Раздел2" Тогда
		Представления = СписокПредставленийРаздел2();
	ИначеЕсли ИсточникДанных = "Раздел3" Тогда
		Представления = СписокПредставленийРаздел3();
	ИначеЕсли ИсточникДанных = "Раздел4" Тогда
		Представления = СписокПредставленийРаздел4();
	ИначеЕсли ИсточникДанных = "Раздел5" Тогда
		Представления = СписокПредставленийРаздел5();
	ИначеЕсли ИсточникДанных = "Раздел6" Тогда
		Представления = СписокПредставленийРаздел6();
	ИначеЕсли ИсточникДанных = "Раздел7" Тогда
		Представления = СписокПредставленийРаздел7();
	ИначеЕсли ИсточникДанных = "Раздел8" Тогда
		Представления = СписокПредставленийРаздел8();
	ИначеЕсли ИсточникДанных = "Раздел9" Тогда
		Представления = СписокПредставленийРаздел9();
	ИначеЕсли ИсточникДанных = "Раздел10" Тогда
		Представления = СписокПредставленийРаздел10();
	ИначеЕсли ИсточникДанных = "Раздел11" Тогда
		Представления = СписокПредставленийРаздел11();
	КонецЕсли;
	Представления.СортироватьПоПредставлению();
	Для каждого Поле из Представления Цикл
		ВыбранныеПоля.Добавить(Поле.Значение, Поле.Значение);
	КонецЦикла;
	Для каждого Поле из ВыбранныеПоля Цикл
		НайденноеПоле = Представления.НайтиПоЗначению(Поле.Имя);
		Если НЕ НайденноеПоле = Неопределено Тогда
			Поле.Представление = НайденноеПоле.Представление;
		КонецЕсли;
	КонецЦикла;
	ВыбранныеПоля[0].Представление = "string_num";
	ВыбранныеПоля.Добавить("НомерСтроки", "uuid").Представление = "uuid";
КонецПроцедуры

&НаСервере
Процедура УстановитьОформление(Построитель)  
	
	ЭлементОформления = Построитель.УсловноеОформление.Добавить("ОформлениеЧислаДаты");
	ЭлементОформления.Оформление.Формат.Значение = "ЧРД=.; ЧН=0; ЧГ=0; ДФ=yyyy-MM-dd";
	ЭлементОформления.Оформление.Формат.Использование = Истина;
	ЭлементОформления.Использование = Истина;
		
	ПоляВремени = Новый Массив;
	Для каждого Поле из Построитель.ВыбранныеПоля Цикл
		Если СтрНайти(ВРЕГ(Поле.Имя), "ВРЕМЯ") > 0 Тогда
			ПоляВремени.Добавить(Поле.Имя);
		КонецЕсли;
	КонецЦикла;
	Если ПоляВремени.Количество() > 0 Тогда 
		ЭлементОформления = Построитель.УсловноеОформление.Добавить("ОформлениеВремени");
		ЭлементОформления.Оформление.Формат.Значение = "ДФ=ЧЧ:мм:сс";
		ЭлементОформления.Оформление.Формат.Использование = Истина;
		Для каждого ИмяПоля из ПоляВремени Цикл
			ЭлементОбласти = ЭлементОформления.Область.Добавить(ИмяПоля);
		КонецЦикла;
		ЭлементОформления.Использование = Истина;
	КонецЕсли;
	
	
	ПолеUUID = Построитель.ВыбранныеПоля.Найти("uuid");
	Если НЕ ПолеUUID = Неопределено Тогда
		ЭлементОформления = Построитель.УсловноеОформление.Добавить("ОформлениеUUID");
		ЭлементОформления.Оформление.Текст.Значение = "";
		ЭлементОформления.Оформление.Текст.Использование = Истина;
		ЭлементОформления.Область.Добавить(ПолеUUID.ПутьКДанным, ПолеUUID.Имя);
		ЭлементОформления.Использование = Истина;
	КонецЕсли;
	
	//У следующих колонок пустое значение не допускается в виде 0
	МассивИменПустыхПолей = Новый Массив();
	МассивИменПустыхПолей.Добавить("ВидимоеКоличествоАктиваТипаАйсберг");
	МассивИменПустыхПолей.Добавить("СтавкаРЕПО");
	МассивИменПустыхПолей.Добавить("СтоимостьАктиваОперацииВВалютеЦены");
	МассивИменПустыхПолей.Добавить("ПремияДисконтНакопленныйПроцентПоЦБ");
	МассивИменПустыхПолей.Добавить("ВидАктива");
	
	Для каждого ИмяПустогоПоля из МассивИменПустыхПолей цикл
		
		ПустоеПоле = Построитель.ВыбранныеПоля.Найти(ИмяПустогоПоля);
		Если НЕ ПустоеПоле = Неопределено тогда
			ЭлементОформления = Построитель.УсловноеОформление.Добавить("Оформление"+ИмяПустогоПоля);
			ЭлементОформления.Оформление.Формат.Значение = "ЧРД=.; ЧГ=0";
			ЭлементОформления.Оформление.Формат.Использование = Истина;
			ЭлементОформления.Область.Добавить(ПустоеПоле.ПутьКДанным, ПустоеПоле.Имя);
			ЭлементОформления.Использование = Истина;
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

#Область ВспомогательныеФункцииОформления

&НаСервере
Функция ЕстьДанные(КоличествоСтрок)
	Если КоличествоСтрок = 0 Тогда
		Возврат "Запрошенные данные отсутствуют";
	Иначе 
		Возврат "Данные переданы";
	КонецЕсли;
КонецФункции

&НаСервере
Функция ГодОтчета()
	Годы = "";
	ДатаОтчета = Объект.ДокументОтчета.НачалоПериода;
	Пока ДатаОтчета < Объект.ДокументОтчета.КонецПериода Цикл
		Годы = Годы + Формат(ДатаОтчета, "ДФ=yyyy");
		ДатаОтчета = ДобавитьМесяц(ДатаОтчета, 12);
	КонецЦикла;
	Возврат Годы;
КонецФункции

&НаСервере
Функция СписокПредставленийРаздел1()
