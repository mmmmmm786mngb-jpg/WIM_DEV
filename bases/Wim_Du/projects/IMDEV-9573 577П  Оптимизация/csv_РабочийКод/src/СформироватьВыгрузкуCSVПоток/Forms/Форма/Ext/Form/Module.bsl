
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
        ДополнительнаяОбработкаСсылка = Параметры.ДополнительнаяОбработкаСсылка;
    КонецЕсли;

    Если Параметры.Свойство("ОбъектыНазначения") И Параметры.ОбъектыНазначения.Количество() > 0 Тогда
        Объект.ДокументОтчета = Параметры.ОбъектыНазначения[0];
        Для Каждого ДокументНазначения Из Параметры.ОбъектыНазначения Цикл
            ДокументыВыгрузки.Добавить(ДокументНазначения);
        КонецЦикла;
    КонецЕсли;

    СохраненныйРежим = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "РежимСохранения");
    Если СохраненныйРежим = РежимКомпьютер() Тогда
        РежимСохранения = РежимКомпьютер();
    Иначе
        РежимСохранения = РежимСеть();
    КонецЕсли;
    ЗагрузитьКаталогРежима();
    ОбновитьНадписьДокументовНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументОтчетаПриИзменении(Элемент)

    ДокументыВыгрузки.Очистить();
    ОбновитьНадписьДокументов();

КонецПроцедуры

&НаКлиенте
Процедура РежимСохраненияПриИзменении(Элемент)

    ЗагрузитьКаталогРежима();

КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ВыбратьКаталогВыгрузки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Описание: Команда обработки из документа или списка 577-П. Выгрузка сразу не начинается: открывается
// форма, где пользователь видит и подтверждает документы, режим и каталог, затем нажимает Выгрузить.
// Раньше каталог брался из сохраненной настройки молча.
//
// Параметры:
// ИдентификаторКоманды - Строка - идентификатор команды
// ОбъектыНазначенияМассив - Массив из ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П - выбранные документы
//
&НаКлиенте
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначенияМассив) Экспорт

    Если ОбъектыНазначенияМассив.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Не выбран документ отчета 577-П.");
        Возврат;
    КонецЕсли;

    ДокументыВыгрузки.ЗагрузитьЗначения(ОбъектыНазначенияМассив);
    Объект.ДокументОтчета = ОбъектыНазначенияМассив[0];
    ОбновитьНадписьДокументов();

    Если Открыта() Тогда
        Активизировать();
    Иначе
        Открыть();
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)

    Документы = ДокументыКВыгрузке();
    Если Документы.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Укажите документ отчета 577-П.");
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Объект.ПутьВыгрузки) Тогда
        ПоказатьПредупреждение(, "Укажите каталог выгрузки.");
        Возврат;
    КонецЕсли;

    Если РежимСохранения = РежимКомпьютер() Тогда
        ТекстОшибки = ПроверитьКаталогНаКомпьютере();
        Если ЗначениеЗаполнено(ТекстОшибки) Тогда
            ПоказатьПредупреждение(, ТекстОшибки);
            Возврат;
        КонецЕсли;
        ЗапомнитьКаталогИРежим(Объект.ПутьВыгрузки);

        Контекст = Новый Структура;
        Контекст.Вставить("Документы",         Документы);
        Контекст.Вставить("ИндексДокумента",   0);
        Контекст.Вставить("ИндексФайла",       0);
        Контекст.Вставить("Счетчики",          Новый Структура);
        Контекст.Вставить("Итоги",             Новый Массив);
        Контекст.Вставить("Каталог",           Объект.ПутьВыгрузки);
        Контекст.Вставить("ИмяФайлаОбработки", "");
        Контекст.Вставить("ТекущийИтог",       Неопределено);
        НачатьВыгрузкуНаКомпьютер(Контекст);
    Иначе
        НачатьВыгрузкуСписка(Документы, 0);
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВыгрузкаВСетевуюПапку

&НаКлиенте
Процедура НачатьВыгрузкуСписка(Документы, Индекс)

    Если Индекс >= Документы.Количество() Тогда
        ОтпуститьФормуВыгрузки();
        Возврат;
    КонецЕсли;

    Объект.ДокументОтчета = Документы[Индекс];

    ТекстОшибки = ПроверитьИЗапомнитьКаталогНаСервере();
    Если ЗначениеЗаполнено(ТекстОшибки) Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, ТекстОшибки);
        Возврат;
    КонецЕсли;

    Запуск = НачатьВыгрузкуВФонеНаСервере();
    Если Не Запуск.Успех Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, Запуск.Описание);
        Возврат;
    КонецЕсли;

    ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ФормаВладелецОжидания());
    ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
    ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
    ПараметрыОжидания.Интервал = 1;
    ПараметрыОжидания.ТекстСообщения = "Выгрузка 577-П в CSV...";

    Оповещение = Новый ОписаниеОповещения(
        "ВыгрузкаВФонеЗавершение",
        ЭтотОбъект,
        Новый Структура("Документы, Индекс", Документы, Индекс));

    УдержатьФормуВыгрузки();
    ДлительныеОперацииКлиент.ОжидатьЗавершение(Запуск.ДлительнаяОперация, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт

    Если Результат = Неопределено Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, "Выгрузка отменена.");
        Возврат;
    КонецЕсли;

    Если Результат.Статус = "Ошибка" Тогда
        ОтпуститьФормуВыгрузки();
        ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
        Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
            ТекстОшибки = "Выгрузка завершилась с ошибкой.";
        КонецЕсли;
        ПоказатьПредупреждение(, ТекстОшибки);
        Возврат;
    КонецЕсли;

    Итог = ПрочитатьРезультатНаСервере(Результат.АдресРезультата);
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Итог.Описание;
    Сообщение.Сообщить();

    НачатьВыгрузкуСписка(ДополнительныеПараметры.Документы, ДополнительныеПараметры.Индекс + 1);

КонецПроцедуры

&НаСервере
Функция ПроверитьИЗапомнитьКаталогНаСервере()

    Каталог = СокрЛП(Объект.ПутьВыгрузки);
    Каталог = СтрЗаменить(Каталог, "/", "\");
    Если Не ЗначениеЗаполнено(Каталог) Тогда
        Возврат "Укажите каталог выгрузки.";
    КонецЕсли;
    Если Не СтрЗаканчиваетсяНа(Каталог, "\") Тогда
        Каталог = Каталог + "\";
    КонецЕсли;

    ФайлКаталога = Новый Файл(Каталог);
    Если Не ФайлКаталога.Существует() Или Не ФайлКаталога.ЭтоКаталог() Тогда
        Возврат "Сервер 1С не видит каталог " + Каталог
            + ". Укажите сетевую папку, доступную серверу, или выберите режим Мой компьютер.";
    КонецЕсли;

    ЗапомнитьКаталогИРежим(Каталог);
    Возврат "";

КонецФункции

#КонецОбласти

#Область ВыгрузкаНаКомпьютерПользователя

// Описание: Выгрузка в каталог на компьютере пользователя, по одному файлу за шаг. Для каждого файла
// (R1-R11, затем sr_sved_purcb) фоновое задание формирует CSV на сервере и сжимает его в ZIP только для
// передачи; клиент получает архив, распаковывает его в каталог и удаляет. Одновременно в работе один
// архив: память сервера не зависит от размера документа. Файлы передаются через временное хранилище, а не
// через путь на сервере: в кластере фоновое задание и вызовы формы могут выполняться на разных серверах.
//
// Параметры:
// Контекст - Структура - состояние выгрузки: Документы, ИндексДокумента, ИндексФайла, Счетчики, Итоги,
//            Каталог, ИмяФайлаОбработки, ТекущийИтог
//
&НаКлиенте
Процедура НачатьВыгрузкуНаКомпьютер(Контекст)

    Файлы = ФайлыВыгрузки();
    Если Контекст.ИндексФайла >= Файлы.Количество() Тогда
        СообщитьИтогДокумента(Контекст);
        Контекст.ИндексДокумента = Контекст.ИндексДокумента + 1;
        Контекст.ИндексФайла     = 0;
        Контекст.Счетчики        = Новый Структура;
        Контекст.Итоги           = Новый Массив;
    КонецЕсли;

    Если Контекст.ИндексДокумента >= Контекст.Документы.Количество() Тогда
        ОтпуститьФормуВыгрузки();
        Возврат;
    КонецЕсли;

    Объект.ДокументОтчета = Контекст.Документы[Контекст.ИндексДокумента];
    ОписаниеФайла = Файлы[Контекст.ИндексФайла];

    ПараметрыФайла = Новый Структура;
    ПараметрыФайла.Вставить("ИмяФайлаДляКлиента", ОписаниеФайла.Файл);
    ПараметрыФайла.Вставить("ИмяРаздела",         ОписаниеФайла.Раздел);
    ПараметрыФайла.Вставить("СчетчикиРазделов",   Контекст.Счетчики);

    Запуск = НачатьВыгрузкуВФонеНаСервере(ПараметрыФайла, Контекст.ИмяФайлаОбработки);
    Если Не Запуск.Успех Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, Запуск.Описание);
        Возврат;
    КонецЕсли;
    Контекст.ИмяФайлаОбработки = Запуск.ИмяФайлаОбработки;

    ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ФормаВладелецОжидания());
    ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
    ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
    ПараметрыОжидания.Интервал = 1;
    ПараметрыОжидания.ТекстСообщения = СтрШаблон("Выгрузка 577-П на компьютер: %1 (%2 из %3)...",
        ОписаниеФайла.Файл, Контекст.ИндексФайла + 1, Файлы.Количество());

    УдержатьФормуВыгрузки();
    ДлительныеОперацииКлиент.ОжидатьЗавершение(Запуск.ДлительнаяОперация,
        Новый ОписаниеОповещения("ФайлДляКомпьютераСформирован", ЭтотОбъект, Контекст), ПараметрыОжидания);

КонецПроцедуры

// Описание: Фоновое задание сформировало архив одного файла: запоминает число строк раздела для
// sr_sved_purcb и начинает получение архива в каталог пользователя.
//
// Параметры:
// Результат - Структура, Неопределено - результат длительной операции; Неопределено - отмена
// Контекст - Структура - см. НачатьВыгрузкуНаКомпьютер
//
&НаКлиенте
Процедура ФайлДляКомпьютераСформирован(Результат, Контекст) Экспорт

    Если Результат = Неопределено Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, "Выгрузка отменена.");
        Возврат;
    КонецЕсли;

    Если Результат.Статус = "Ошибка" Тогда
        ОтпуститьФормуВыгрузки();
        ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
        Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
            ТекстОшибки = "Выгрузка завершилась с ошибкой.";
        КонецЕсли;
        ПоказатьПредупреждение(, ТекстОшибки);
        Возврат;
    КонецЕсли;

    Итог = ПолучитьИтогФайлаНаСервере(Результат.АдресРезультата);
    Если Не Итог.Успех Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, Итог.Описание);
        Возврат;
    КонецЕсли;

    Если ЗначениеЗаполнено(Итог.ИмяРаздела) Тогда
        Контекст.Счетчики.Вставить(Итог.ИмяРаздела, Итог.КоличествоСтрок);
    КонецЕсли;
    Контекст.ТекущийИтог = Итог;

    ПолучаемыеФайлы = Новый Массив;
    ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(Итог.ИмяФайла + ".zip", Итог.АдресАрхива));
    НачатьПолучениеФайлов(Новый ОписаниеОповещения("АрхивПолучен", ЭтотОбъект, Контекст),
        ПолучаемыеФайлы, Контекст.Каталог, Ложь);

КонецПроцедуры

// Описание: Архив получен в каталог пользователя: распаковывает его, удаляет архив и переходит к следующему
// файлу. При ошибке распаковки архив остается в каталоге, выгрузка останавливается с сообщением.
//
// Параметры:
// ПолученныеФайлы - Массив из ОписаниеПереданногоФайла, Неопределено - полученные файлы
// Контекст - Структура - см. НачатьВыгрузкуНаКомпьютер
//
&НаКлиенте
Процедура АрхивПолучен(ПолученныеФайлы, Контекст) Экспорт

    Итог = Контекст.ТекущийИтог;
    УдалитьИзВременногоХранилища(Итог.АдресАрхива);

    ИмяАрхива = Контекст.Каталог + Итог.ИмяФайла + ".zip";
    Если ПолученныеФайлы = Неопределено Или ПолученныеФайлы.Количество() = 0 Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, "Не удалось получить файл " + ИмяАрхива + " с сервера.");
        Возврат;
    КонецЕсли;

    ТекстОшибки = РаспаковатьАрхив(ИмяАрхива, Контекст.Каталог);
    Если ЗначениеЗаполнено(ТекстОшибки) Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, ТекстОшибки);
        Возврат;
    КонецЕсли;

    Контекст.Итоги.Добавить(Контекст.Каталог + Итог.ИмяФайла + " (" + Итог.Описание + ")");
    Контекст.ИндексФайла = Контекст.ИндексФайла + 1;
    НачатьВыгрузкуНаКомпьютер(Контекст);

КонецПроцедуры

// Описание: Распаковывает архив в каталог (без путей внутри архива) и удаляет архив.
//
// Параметры:
// ИмяАрхива - Строка - полный путь архива на компьютере пользователя
// Каталог - Строка - каталог распаковки
//
// Возвращаемое значение:
// Строка - текст ошибки, пустая строка при успехе
//
&НаКлиенте
Функция РаспаковатьАрхив(ИмяАрхива, Каталог)

    Попытка
        ЧтениеАрхива = Новый ЧтениеZipФайла(ИмяАрхива);
        ЧтениеАрхива.ИзвлечьВсе(Каталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
        ЧтениеАрхива.Закрыть();
    Исключение
        Возврат "Не удалось распаковать " + ИмяАрхива + ": "
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ". Архив оставлен в каталоге.";
    КонецПопытки;

    УдалитьФайлы(ИмяАрхива);
    Возврат "";

КонецФункции

&НаКлиенте
Процедура СообщитьИтогДокумента(Контекст)

    ВсегоСтрок = 0;
    Для Каждого Счетчик Из Контекст.Счетчики Цикл
        ВсегоСтрок = ВсегоСтрок + Счетчик.Значение;
    КонецЦикла;

    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = "Выгрузка на компьютер завершена. Строк разделов: " + Формат(ВсегоСтрок, "ЧН=0; ЧГ=0")
        + ". Каталог: " + Контекст.Каталог + Символы.ПС + СтрСоединить(Контекст.Итоги, Символы.ПС);
    Сообщение.Сообщить();

КонецПроцедуры

// Описание: Проверяет каталог на компьютере пользователя и приводит путь к виду с разделителем в конце.
//
// Возвращаемое значение:
// Строка - текст ошибки, пустая строка при успехе
//
&НаКлиенте
Функция ПроверитьКаталогНаКомпьютере()

    Каталог = СтрЗаменить(СокрЛП(Объект.ПутьВыгрузки), "/", "\");
    Если Не СтрЗаканчиваетсяНа(Каталог, "\") Тогда
        Каталог = Каталог + "\";
    КонецЕсли;

    ФайлКаталога = Новый Файл(Каталог);
    Если Не ФайлКаталога.Существует() Или Не ФайлКаталога.ЭтоКаталог() Тогда
        Возврат "Каталог " + Каталог + " не найден на вашем компьютере.";
    КонецЕсли;

    Объект.ПутьВыгрузки = Каталог;
    Возврат "";

КонецФункции

// Описание: Файлы выгрузки в порядке формирования: разделы R1-R11, затем sr_sved_purcb (ему нужны
// числа строк разделов). Тот же состав, что у РазделыДляВыгрузки модуля объекта.
//
// Возвращаемое значение:
// Массив из Структура - Файл (имя файла CSV), Раздел (имя раздела; пусто для sr_sved_purcb)
//
&НаКлиентеНаСервереБезКонтекста
Функция ФайлыВыгрузки()

    Файлы = Новый Массив;
    Для НомерРаздела = 1 По 11 Цикл
        Файлы.Добавить(Новый Структура("Файл, Раздел", "R" + НомерРаздела + ".csv", "Раздел" + НомерРаздела));
    КонецЦикла;
    Файлы.Добавить(Новый Структура("Файл, Раздел", "sr_sved_purcb.csv", ""));
    Возврат Файлы;

КонецФункции

#КонецОбласти

#Область ВыборКаталогаИРежима

&НаКлиенте
Процедура ВыбратьКаталогВыгрузки()

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Если РежимСохранения = РежимКомпьютер() Тогда
        Диалог.Заголовок = "Каталог на вашем компьютере";
    Иначе
        Диалог.Заголовок = "Сетевая папка, доступная серверу 1С";
    КонецЕсли;
    Если ЗначениеЗаполнено(Объект.ПутьВыгрузки) Тогда
        Диалог.Каталог = Объект.ПутьВыгрузки;
    КонецЕсли;

    Диалог.Показать(Новый ОписаниеОповещения("ВыборКаталогаЗавершение", ЭтотОбъект));

КонецПроцедуры

// Описание: Ставит выбранный каталог. В режиме сетевой папки буква подключенного сетевого диска заменяется
// сетевым путем; если выбран диск компьютера пользователя, предлагается переключиться на режим Мой компьютер.
//
// Параметры:
// ВыбранныеФайлы - Массив из Строка, Неопределено - выбранный каталог; Неопределено - выбор отменен
// ДополнительныеПараметры - Неопределено - не используется
//
&НаКлиенте
Процедура ВыборКаталогаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Каталог = ВыбранныеФайлы[0];
    Если РежимСохранения = РежимКомпьютер() Тогда
        Объект.ПутьВыгрузки = Каталог;
        Возврат;
    КонецЕсли;

    Каталог = СетевойПутьВместоДиска(Каталог);
    Если СтрНачинаетсяС(Каталог, "\\") Тогда
        Объект.ПутьВыгрузки = Каталог;
        Возврат;
    КонецЕсли;

    ТекстВопроса = "Каталог " + Каталог + " находится на вашем компьютере, сервер 1С его, скорее всего, не видит."
        + Символы.ПС + "Переключить режим на Мой компьютер?";
    ПоказатьВопрос(Новый ОписаниеОповещения("ВопросПереключенияРежимаЗавершение", ЭтотОбъект, Каталог),
        ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ВопросПереключенияРежимаЗавершение(Ответ, Каталог) Экспорт

    Если Ответ = КодВозвратаДиалога.Да Тогда
        РежимСохранения = РежимКомпьютер();
        ЗагрузитьКаталогРежима();
    КонецЕсли;
    Объект.ПутьВыгрузки = Каталог;

КонецПроцедуры

// Описание: Ставит в поле каталог, сохраненный для текущего режима, и список недавних каталогов режима.
//
&НаСервере
Процедура ЗагрузитьКаталогРежима()

    СохраненныйПуть = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), КлючКаталога(РежимСохранения));
    Если ЗначениеЗаполнено(СохраненныйПуть) Тогда
        Объект.ПутьВыгрузки = СохраненныйПуть;
    Иначе
        Объект.ПутьВыгрузки = "";
    КонецЕсли;
    ЗаполнитьСписокНедавнихКаталогов();

КонецПроцедуры

// Описание: Запоминает режим, каталог режима и добавляет каталог в недавние режима. Вызывается после
// проверки каталога: в недавние попадают только рабочие каталоги.
//
// Параметры:
// Каталог - Строка - проверенный каталог выгрузки
//
&НаСервере
Процедура ЗапомнитьКаталогИРежим(Каталог)

    Объект.ПутьВыгрузки = Каталог;
    ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "РежимСохранения", РежимСохранения);
    ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), КлючКаталога(РежимСохранения), Каталог);
    ЗапомнитьНедавнийКаталог(Каталог, РежимСохранения);
    ЗаполнитьСписокНедавнихКаталогов();

КонецПроцедуры

// Описание: Заполняет выпадающий список поля каталога недавними каталогами текущего режима.
//
&НаСервере
Процедура ЗаполнитьСписокНедавнихКаталогов()

    Элементы.ПутьВыгрузки.СписокВыбора.Очистить();
    Для Каждого НедавнийКаталог Из НедавниеКаталоги(РежимСохранения) Цикл
        Элементы.ПутьВыгрузки.СписокВыбора.Добавить(НедавнийКаталог);
    КонецЦикла;

КонецПроцедуры

// Описание: Недавние каталоги выгрузки текущего пользователя для режима, последний использованный первым.
//
// Параметры:
// Режим - Строка - Сеть или Компьютер
//
// Возвращаемое значение:
// Массив из Строка - пути каталогов
//
&НаСервереБезКонтекста
Функция НедавниеКаталоги(Режим)

    Сохраненные = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), КлючНедавних(Режим));
    Если ТипЗнч(Сохраненные) = Тип("Массив") Тогда
        Возврат Сохраненные;
    КонецЕсли;
    Возврат Новый Массив;

КонецФункции

// Описание: Ставит каталог первым в список недавних режима, список ограничен 10 каталогами.
//
// Параметры:
// Каталог - Строка - каталог выгрузки
// Режим - Строка - Сеть или Компьютер
//
&НаСервереБезКонтекста
Процедура ЗапомнитьНедавнийКаталог(Знач Каталог, Знач Режим)

    НовыйСписок = Новый Массив;
    НовыйСписок.Добавить(Каталог);
    Для Каждого НедавнийКаталог Из НедавниеКаталоги(Режим) Цикл
        Если НовыйСписок.Количество() >= 10 Тогда
            Прервать;
        КонецЕсли;
        Если ВРег(НедавнийКаталог) <> ВРег(Каталог) Тогда
            НовыйСписок.Добавить(НедавнийКаталог);
        КонецЕсли;
    КонецЦикла;
    ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), КлючНедавних(Режим), НовыйСписок);

КонецПроцедуры

// Описание: Заменяет букву подключенного сетевого диска пользователя полным сетевым путем:
// Z:\Обмен\577 -> \\сервер\папка\Обмен\577. На сервере 1С буквы сетевых дисков пользователя нет.
// Список сетевых дисков дает WScript.Network.EnumNetworkDrives (пары: буква диска, сетевой путь).
// Путь без буквы сетевого диска возвращается без изменений.
//
// Параметры:
// Путь - Строка - каталог, выбранный на компьютере пользователя
//
// Возвращаемое значение:
// Строка - сетевой путь или исходный путь
//
&НаКлиенте
Функция СетевойПутьВместоДиска(Знач Путь)

    Если СтрДлина(Путь) < 2 Или Сред(Путь, 2, 1) <> ":" Тогда
        Возврат Путь;
    КонецЕсли;

#Если Не ВебКлиент Тогда
    БукваДиска = ВРег(Лев(Путь, 2));
    Попытка
        СетьWindows = Новый COMОбъект("WScript.Network");
        СетевыеДиски = СетьWindows.EnumNetworkDrives();
        Индекс = 0;
        Пока Индекс + 1 < СетевыеДиски.Count() Цикл
            Если ВРег(СетевыеДиски.Item(Индекс)) = БукваДиска И ЗначениеЗаполнено(СетевыеДиски.Item(Индекс + 1)) Тогда
                Возврат СетевыеДиски.Item(Индекс + 1) + Сред(Путь, 3);
            КонецЕсли;
            Индекс = Индекс + 2;
        КонецЦикла;
    Исключение
        // Без WScript.Network путь остается буквенным; сервер проверит каталог перед выгрузкой.
        Возврат Путь;
    КонецПопытки;
#КонецЕсли

    Возврат Путь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РежимСеть()

    Возврат "Сеть";

КонецФункции

