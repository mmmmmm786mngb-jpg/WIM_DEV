// Описание: Запускает фоновое задание выгрузки текущего документа.
//
// Параметры:
// ПараметрыФайла - Структура, Неопределено - для режима Мой компьютер: ИмяФайлаДляКлиента, ИмяРаздела,
//                  СчетчикиРазделов; Неопределено - выгрузка всех файлов в сетевую папку
// ИмяФайлаОбработки - Строка - копия файла обработки на сервере, подготовленная прошлым запуском; пусто - подготовить
//
// Возвращаемое значение:
// Структура - Успех, Описание, ДлительнаяОперация, ИмяФайлаОбработки
//
&НаСервере
Функция НачатьВыгрузкуВФонеНаСервере(ПараметрыФайла = Неопределено, Знач ИмяФайлаОбработки = "")

    Ответ = Новый Структура;
    Ответ.Вставить("Успех", Ложь);
    Ответ.Вставить("Описание", "");
    Ответ.Вставить("ДлительнаяОперация", Неопределено);
    Ответ.Вставить("ИмяФайлаОбработки", ИмяФайлаОбработки);

    Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) И Не ЗначениеЗаполнено(ИмяФайлаОбработки) Тогда
        ИмяФайлаОбработки = ПодготовитьФайлОбработкиНаСервере();
        Если Не ЗначениеЗаполнено(ИмяФайлаОбработки) Тогда
            Ответ.Описание = "Не удалось подготовить файл обработки для фонового задания. "
                + "Откройте обработку из файла или зарегистрируйте ее в дополнительных обработках.";
            Возврат Ответ;
        КонецЕсли;
        Ответ.ИмяФайлаОбработки = ИмяФайлаОбработки;
    КонецЕсли;

    ПараметрыМетода = Новый Структура;
    ПараметрыМетода.Вставить("ДокументСсылка", Объект.ДокументОтчета);
    ПараметрыМетода.Вставить("Каталог", Объект.ПутьВыгрузки);
    ПараметрыМетода.Вставить("ПутьEPF", ИмяФайлаОбработки);
    Если ПараметрыФайла <> Неопределено Тогда
        Для Каждого ПараметрФайла Из ПараметрыФайла Цикл
            ПараметрыМетода.Вставить(ПараметрФайла.Ключ, ПараметрФайла.Значение);
        КонецЦикла;
    КонецЕсли;

    ПараметрыЗадания = Новый Структура;
    ПараметрыЗадания.Вставить("ИмяМетода", "ВыгрузитьВФоне");
    ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыМетода);
    ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
    ПараметрыЗадания.Вставить("ИмяОбработки", ИмяФайлаОбработки);
    ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);

    ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
    ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выгрузка 577-П в CSV";
    ПараметрыВыполнения.ОжидатьЗавершение = 0;
    ПараметрыВыполнения.ЗапуститьВФоне = Истина;

    Попытка
        Ответ.ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
            "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
            ПараметрыЗадания,
            ПараметрыВыполнения);
        Ответ.Успех = Истина;
    Исключение
        Ответ.Описание = "Не удалось запустить выгрузку: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    Возврат Ответ;

КонецФункции

&НаСервере
Функция ПодготовитьФайлОбработкиНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Путь = ОбработкаОбъект.ИспользуемоеИмяФайла;
    Если Не ЗначениеЗаполнено(Путь) Тогда
        Возврат "";
    КонецЕсли;

    ФайлОбработки = Новый Файл(Путь);
    Если Не ФайлОбработки.Существует() Тогда
        Возврат "";
    КонецЕсли;

    ДвоичныеДанные = Новый ДвоичныеДанные(Путь);
    ИмяФайла = ПолучитьИмяВременногоФайла("epf");
    ДвоичныеДанные.Записать(ИмяФайла);
    Возврат ИмяФайла;

КонецФункции

// Описание: Результат фонового задания одного файла для режима Мой компьютер. Архив из результата
// перекладывается во временное хранилище формы (АдресАрхива), чтобы клиент получил его как файл, а не
// через ответ серверного вызова; адрес результата освобождается.
//
// Параметры:
// АдресРезультата - Строка - адрес результата длительной операции
//
// Возвращаемое значение:
// Структура - результат задания без двоичных данных, с адресом архива АдресАрхива
//
&НаСервере
Функция ПолучитьИтогФайлаНаСервере(Знач АдресРезультата)

    Результат = ПрочитатьРезультатНаСервере(АдресРезультата);
    Если Не Результат.Успех Или Не Результат.Свойство("Архив") Тогда
        Возврат Результат;
    КонецЕсли;

    Результат.Вставить("АдресАрхива", ПоместитьВоВременноеХранилище(Результат.Архив, УникальныйИдентификатор));
    Результат.Удалить("Архив");
    УдалитьИзВременногоХранилища(АдресРезультата);
    Возврат Результат;

КонецФункции

&НаСервере
Функция ПрочитатьРезультатНаСервере(АдресРезультата)

    Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
    Если ТипЗнч(Результат) <> Тип("Структура") Тогда
        Пустой = Новый Структура;
        Пустой.Вставить("Успех", Ложь);
        Пустой.Вставить("Описание", "Пустой результат выгрузки.");
        Возврат Пустой;
    КонецЕсли;

    Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти
