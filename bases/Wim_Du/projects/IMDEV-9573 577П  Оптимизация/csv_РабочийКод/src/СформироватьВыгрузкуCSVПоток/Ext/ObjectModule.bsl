// Потоковая выгрузка отчета 577-П в CSV.
// Раздел читается запросом по ссылке и сразу пишется в файл: документ целиком,
// табличный документ и xlsx не создаются.

#Область ПрограммныйИнтерфейс

// Описание: Сведения для подсистемы "Дополнительные отчеты и обработки".
// Безопасный режим выключен: фоновое задание пишет файлы в каталог сервера.
//
// Возвращаемое значение:
// Структура - параметры регистрации внешней обработки
//
Функция СведенияОВнешнейОбработке() Экспорт

    ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке();
    ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиЗаполнениеОбъекта();
    ПараметрыРегистрации.Версия = "2.03";
    ПараметрыРегистрации.БезопасныйРежим = Ложь;
    ПараметрыРегистрации.ВерсияБСП = СтандартныеПодсистемыСервер.ВерсияБиблиотеки();
    ПараметрыРегистрации.Наименование = "Выгрузка отчетности XBRL-CSV для PB (поток)";
    ПараметрыРегистрации.Информация = "Потоковая выгрузка отчета 577-П в CSV (R1-R11 и sr_sved_purcb) без табличного документа.";
    ПараметрыРегистрации.Назначение.Добавить("Документ.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П");

    Команда = ПараметрыРегистрации.Команды.Добавить();
    Команда.Представление = "Выгрузить CSV (поток)";
    Команда.Идентификатор = "ВыгрузитьCSV";
    Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовКлиентскогоМетода();

    Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Точка входа фонового задания БСП.
// При запуске из файла обработки пересоздает объект без безопасного режима,
// чтобы запись в каталог сервера не блокировалась.
//
// Параметры:
// ПараметрыВыполнения - Структура - ДокументСсылка, Каталог, ПутьEPF
// АдресХранилища - Строка - адрес результата во временном хранилище
//
Процедура ВыгрузитьВФоне(ПараметрыВыполнения, АдресХранилища) Экспорт

    ПутьEPF = "";
    Если ПараметрыВыполнения.Свойство("ПутьEPF") Тогда
        ПутьEPF = ПараметрыВыполнения.ПутьEPF;
    КонецЕсли;

    УжеБезОграничений = Ложь;
    Если ПараметрыВыполнения.Свойство("УжеБезОграничений") Тогда
        УжеБезОграничений = ПараметрыВыполнения.УжеБезОграничений;
    КонецЕсли;

    Если ЗначениеЗаполнено(ПутьEPF) И Не УжеБезОграничений Тогда
        ОбработкаБезОграничений = ВнешниеОбработки.Создать(ПутьEPF, Ложь);
        ПараметрыВыполнения.Вставить("УжеБезОграничений", Истина);
        ОбработкаБезОграничений.ВыгрузитьВФоне(ПараметрыВыполнения, АдресХранилища);
        Возврат;
    КонецЕсли;

    Если ПараметрыВыполнения.Свойство("ИмяФайлаДляКлиента") Тогда
        ВыгрузитьФайлДляКлиента(ПараметрыВыполнения, АдресХранилища);
    Иначе
        ВыполнитьВыгрузку(ПараметрыВыполнения, АдресХранилища);
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Выгружает один документ в каталог и кладет итог во временное хранилище.
//
// Параметры:
// ПараметрыВыполнения - Структура - ДокументСсылка, Каталог
// АдресХранилища - Строка - адрес результата
//
Процедура ВыполнитьВыгрузку(ПараметрыВыполнения, АдресХранилища)

    ДокументСсылка = ПараметрыВыполнения.ДокументСсылка;
    Каталог = НормализоватьКаталог(ПараметрыВыполнения.Каталог);

    Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
        ВызватьИсключение "Не выбран документ отчета 577-П.";
    КонецЕсли;

    ФайлКаталога = Новый Файл(Каталог);
    Если Не ФайлКаталога.Существует() Или Не ФайлКаталога.ЭтоКаталог() Тогда
        ВызватьИсключение "Сервер 1С не видит каталог " + Каталог
            + ". Укажите сетевую папку, доступную серверу.";
    КонецЕсли;

    Файлы = Новый Массив;
    ОбщееКоличество = 0;
    Разделы = РазделыДляВыгрузки();
    КоличествоШагов = Разделы.Количество() + 1;
    НомерШага = 0;
    СчетчикиРазделов = Новый Соответствие;

    Для Каждого Раздел Из Разделы Цикл

        НомерШага = НомерШага + 1;
        ДлительныеОперации.СообщитьПрогресс(
            Окр(НомерШага / КоличествоШагов * 100, 0),
            "Выгрузка " + Раздел.Файл + ".csv");

        ИмяФайла = Каталог + Раздел.Файл + ".csv";
        Попытка
            Источник = ИсточникДанныхРаздела(ДокументСсылка, Раздел.Имя);
            КоличествоСтрок = ВыгрузитьРаздел(ДокументСсылка, Раздел.Имя, ИмяФайла, Источник);
        Исключение
            ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
            ЗаписьЖурналаРегистрации(
                "ВыгрузкаCSV577",
                УровеньЖурналаРегистрации.Ошибка,
                ,
                ДокументСсылка,
                ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
            ВызватьИсключение "Ошибка выгрузки " + Раздел.Файл + ".csv: " + ТекстОшибки;
        КонецПопытки;

        СчетчикиРазделов.Вставить(Раздел.Имя, КоличествоСтрок);
        ОбщееКоличество = ОбщееКоличество + КоличествоСтрок;
        Файлы.Добавить(ИмяФайла + " (" + Формат(КоличествоСтрок, "ЧН=0; ЧГ=0") + ", " + Источник.Представление + ")");

    КонецЦикла;

    НомерШага = НомерШага + 1;
    ДлительныеОперации.СообщитьПрогресс(100, "Сопроводительная информация");
    ИмяСопроводительного = Каталог + "sr_sved_purcb.csv";
    ЗаписатьСопроводительнуюИнформацию(ДокументСсылка, СчетчикиРазделов, ИмяСопроводительного);
    Файлы.Добавить(ИмяСопроводительного);

    Описание = "Выгрузка завершена. Строк разделов: " + Формат(ОбщееКоличество, "ЧН=0; ЧГ=0")
        + ". Каталог: " + Каталог
        + Символы.ПС + СтрСоединить(Файлы, Символы.ПС);

    Результат = Новый Структура;
    Результат.Вставить("Успех", Истина);
    Результат.Вставить("Описание", Описание);
    Результат.Вставить("Файлы", Файлы);
    Результат.Вставить("КоличествоСтрок", ОбщееКоличество);
    ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

// Описание: Режим выгрузки на компьютер пользователя: формирует один файл (раздел или sr_sved_purcb)
// во временном каталоге сервера фонового задания, сжимает его в ZIP только для передачи и возвращает
// архив в результате задания (Архив). Временные файлы удаляются в любом исходе. Архив передается через
// результат, а не через путь на сервере: в кластере вызовы формы могут выполняться на другом сервере.
// Отдельный адрес во временном хранилище, заведенный в фоновом задании, после его окончания в сеансе
// формы пуст: из задания в сеанс передается только результат по адресу, выданному БСП.
//
// Параметры:
// ПараметрыВыполнения - Структура - ДокументСсылка, ИмяФайлаДляКлиента (R1.csv ... sr_sved_purcb.csv),
//                       ИмяРаздела (пусто для sr_sved_purcb), СчетчикиРазделов (Структура: раздел и
//                       число строк, для sr_sved_purcb)
// АдресХранилища - Строка - адрес результата
//
Процедура ВыгрузитьФайлДляКлиента(ПараметрыВыполнения, АдресХранилища)

    ДокументСсылка = ПараметрыВыполнения.ДокументСсылка;
    ИмяФайла       = ПараметрыВыполнения.ИмяФайлаДляКлиента;
    ИмяРаздела     = ПараметрыВыполнения.ИмяРаздела;

    ВременныйКаталог = ПолучитьИмяВременногоФайла("csv577") + ПолучитьРазделительПутиСервера();
    СоздатьКаталог(ВременныйКаталог);

    Попытка
        ИмяCSV = ВременныйКаталог + ИмяФайла;
        Если ЗначениеЗаполнено(ИмяРаздела) Тогда
            Источник = ИсточникДанныхРаздела(ДокументСсылка, ИмяРаздела);
            КоличествоСтрок = ВыгрузитьРаздел(ДокументСсылка, ИмяРаздела, ИмяCSV, Источник);
            Описание = Формат(КоличествоСтрок, "ЧН=0; ЧГ=0") + ", " + Источник.Представление;
        Иначе
            СчетчикиРазделов = Новый Соответствие;
            Для Каждого Счетчик Из ПараметрыВыполнения.СчетчикиРазделов Цикл
                СчетчикиРазделов.Вставить(Счетчик.Ключ, Счетчик.Значение);
            КонецЦикла;
            ЗаписатьСопроводительнуюИнформацию(ДокументСсылка, СчетчикиРазделов, ИмяCSV);
            КоличествоСтрок = 0;
            Описание = "сопроводительная информация";
        КонецЕсли;

        ИмяАрхива = ИмяCSV + ".zip";
        ЗаписьАрхива = Новый ЗаписьZipФайла(ИмяАрхива, , , МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Оптимальный);
        ЗаписьАрхива.Добавить(ИмяCSV, РежимСохраненияПутейZIP.НеСохранятьПути);
        ЗаписьАрхива.Записать();

        ФайлCSV      = Новый Файл(ИмяCSV);
        ФайлАрхива   = Новый Файл(ИмяАрхива);
        РазмерCSV    = ФайлCSV.Размер();
        РазмерАрхива = ФайлАрхива.Размер();
        Архив        = Новый ДвоичныеДанные(ИмяАрхива);
    Исключение
        ИнформацияОшибки = ИнформацияОбОшибке();
        УдалитьВременныйКаталог(ВременныйКаталог);
        ЗаписьЖурналаРегистрации("ВыгрузкаCSV577", УровеньЖурналаРегистрации.Ошибка, , ДокументСсылка,
            ПодробноеПредставлениеОшибки(ИнформацияОшибки));
        ВызватьИсключение "Ошибка выгрузки " + ИмяФайла + ": " + КраткоеПредставлениеОшибки(ИнформацияОшибки);
    КонецПопытки;

    УдалитьВременныйКаталог(ВременныйКаталог);

    Результат = Новый Структура;
    Результат.Вставить("Успех",           Истина);
    Результат.Вставить("ИмяФайла",        ИмяФайла);
    Результат.Вставить("ИмяРаздела",      ИмяРаздела);
    Результат.Вставить("КоличествоСтрок", КоличествоСтрок);
    Результат.Вставить("Описание",        Описание);
    Результат.Вставить("Архив",           Архив);
    Результат.Вставить("РазмерCSV",       РазмерCSV);
    Результат.Вставить("РазмерАрхива",    РазмерАрхива);
    ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

// Описание: Удаляет временный каталог выгрузки. Ошибка удаления пишется в журнал регистрации и не
// подменяет основной результат или исходную ошибку выгрузки.
//
// Параметры:
// ВременныйКаталог - Строка - каталог на сервере
//
Процедура УдалитьВременныйКаталог(ВременныйКаталог)

    Попытка
        УдалитьФайлы(ВременныйКаталог);
    Исключение
        ЗаписьЖурналаРегистрации("ВыгрузкаCSV577", УровеньЖурналаРегистрации.Предупреждение, , ,
            "Не удалось удалить временный каталог " + ВременныйКаталог + ": "
            + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

КонецПроцедуры

// Описание: Пишет один раздел CSV: заголовок и строки раздела. Раздел читается порциями (см. ПорцииРаздела),
// в файл строки уходят пачками по 4000: память вызова не зависит от размера раздела.
// Переводы строк внутри значений проверяются один раз на строку файла: других переводов строк
// в собранной строке нет.
//
// Параметры:
// ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П - выгружаемый документ
// ИмяРаздела - Строка - имя раздела (табличной части)
// ИмяФайла - Строка - полный путь файла CSV
// Источник - Структура - см. ИсточникДанныхРаздела
//
// Возвращаемое значение:
// Число - количество записанных строк данных
//
Функция ВыгрузитьРаздел(ДокументСсылка, ИмяРаздела, ИмяФайла, Источник)

    Колонки = КолонкиРаздела(ИмяРаздела);
    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапросаРаздела(Источник, Колонки);
    Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
    Порции = ПорцииРаздела(ДокументСсылка, Источник);

    Заголовки = Новый Массив;
    Виды = Новый Массив;
    Для Каждого Колонка Из Колонки Цикл
        Заголовки.Добавить(Колонка.Заголовок);
        Виды.Добавить(Колонка.Вид);
    КонецЦикла;
    ИндексПоследнегоПоля = Колонки.Количество() - 2;

    РазмерБуфера = 4000;
    Буфер = Новый Массив;
    Счетчик = 0;

    ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
    Попытка
        ЗаписьТекста.ЗаписатьСтроку(СтрСоединить(Заголовки, "|"));
        Для Каждого Порция Из Порции Цикл

            Для Каждого ПараметрПорции Из Порция Цикл
                Запрос.УстановитьПараметр(ПараметрПорции.Ключ, ПараметрПорции.Значение);
            КонецЦикла;
            РезультатЗапроса = Запрос.Выполнить();
            Выборка = РезультатЗапроса.Выбрать();
            Пока Выборка.Следующий() Цикл

                СтрокаCSV = СтрокаФайла(Выборка, Виды, ИндексПоследнегоПоля);
                Если СтрНайти(СтрокаCSV, Символы.ПС) > 0 Или СтрНайти(СтрокаCSV, Символы.ВК) > 0 Тогда
                    СтрокаCSV = ТекстБезПереводовСтрок(СтрокаCSV);
                КонецЕсли;

                Буфер.Добавить(СтрокаCSV);
                Счетчик = Счетчик + 1;

                Если Буфер.Количество() >= РазмерБуфера Тогда
                    ЗаписьТекста.Записать(СтрСоединить(Буфер, Символы.ПС) + Символы.ПС);
                    Буфер.Очистить();
                КонецЕсли;

            КонецЦикла;
            Выборка = Неопределено;
            РезультатЗапроса = Неопределено;

        КонецЦикла;

        Если Буфер.Количество() > 0 Тогда
            ЗаписьТекста.Записать(СтрСоединить(Буфер, Символы.ПС) + Символы.ПС);
        КонецЕсли;
    Исключение
        ЗаписьТекста.Закрыть();
        ВызватьИсключение;
    КонецПопытки;

    ЗаписьТекста.Закрыть();
    Возврат Счетчик;

КонецФункции

// Описание: Строка файла CSV по текущей записи выборки, без последней колонки uuid: она всегда
// пустая, поэтому строка заканчивается разделителем. Представления те же, что давал построитель
// отчета прежней выгрузки с масками "ЧРД=.; ЧН=0; ЧГ=0", "ДФ=yyyy-MM-dd", "ДФ=ЧЧ:мм:сс":
// строка без пробелов в конце, число с точкой и без группировки, дата yyyy-MM-dd, время ЧЧ:мм:сс,
// пустая дата и ноль у пяти полей с пустым нулем - пустое значение. XMLСтрока дает эти
// представления быстрее, чем Формат по маске.
//
// Параметры:
// Выборка - ВыборкаИзРезультатаЗапроса - текущая запись раздела, поля в порядке колонок
// Виды - Массив из Число - вид колонки: 0 строка, 1 дата, 2 время, 3 число, 4 число с пустым нулем
// ИндексПоследнегоПоля - Число - индекс последнего поля выборки
//
// Возвращаемое значение:
// Строка - строка файла без перевода строки
//
Функция СтрокаФайла(Выборка, Виды, ИндексПоследнегоПоля)

    СтрокаCSV = "";
    Для Индекс = 0 По ИндексПоследнегоПоля Цикл
        Вид = Виды[Индекс];
        Если Вид = 0 Тогда
            СтрокаCSV = СтрокаCSV + СокрП(Выборка[Индекс]) + "|";
        ИначеЕсли Вид = 3 Тогда
            СтрокаCSV = СтрокаCSV + XMLСтрока(Выборка[Индекс]) + "|";
        Иначе
            ЗначениеПоля = Выборка[Индекс];
            Если ЗначениеПоля = '00010101' Или ЗначениеПоля = 0 Тогда
                СтрокаCSV = СтрокаCSV + "|";
            ИначеЕсли Вид = 1 Тогда
                СтрокаCSV = СтрокаCSV + Лев(XMLСтрока(ЗначениеПоля), 10) + "|";
            ИначеЕсли Вид = 2 Тогда
                СтрокаCSV = СтрокаCSV + Сред(XMLСтрока(ЗначениеПоля), 12, 8) + "|";
            Иначе
                СтрокаCSV = СтрокаCSV + XMLСтрока(ЗначениеПоля) + "|";
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Возврат СтрокаCSV;

КонецФункции

// Описание: Строка файла CSV без переводов строк внутри значений: возврат каретки удаляется,
// перевод строки заменяется пробелом.
//
// Параметры:
// Текст - Строка - строка файла, в значениях которой есть перевод строки
//
// Возвращаемое значение:
// Строка - строка файла в одну строку
//
Функция ТекстБезПереводовСтрок(Текст)

    Возврат СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, " ");

КонецФункции

// Описание: Колонки раздела в порядке прежней выгрузки: сортировка по коду Банка России,
// последняя колонка пустой uuid. Колонки string_num (НомерСтроки) в файле нет, как и в прежней
// выгрузке: построитель отчета выводил поле НомерСтроки один раз, под заголовком uuid.
//
// Параметры:
// ИмяРаздела - Строка - имя табличной части
//
// Возвращаемое значение:
// Массив из Структура - Имя, Заголовок, Вид
//
Функция КолонкиРаздела(ИмяРаздела)

    Список = СписокПредставленийРаздела(ИмяРаздела);
    Список.СортироватьПоПредставлению();

    // Типы колонок берутся из табличной части; если вендор ее удалит - из ресурсов регистра раздела
    // (в ДУ 1.5.30.6 состав и типы ресурсов совпадают с реквизитами табличной части).
    ТабличнаяЧасть = Метаданные.Документы.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П.ТабличныеЧасти.Найти(ИмяРаздела);
    Если ТабличнаяЧасть <> Неопределено Тогда
        РеквизитыРаздела = ТабличнаяЧасть.Реквизиты;
    Иначе
        РеквизитыРаздела = Метаданные.РегистрыСведений["Отчет577П_" + ИмяРаздела].Ресурсы;
    КонецЕсли;
    Колонки = Новый Массив;

    Для Каждого Элемент Из Список Цикл
        Если Элемент.Значение = "НомерСтроки" Тогда
            Продолжить;
        КонецЕсли;
        Колонка = Новый Структура;
        Колонка.Вставить("Имя", Элемент.Значение);
        Колонка.Вставить("Заголовок", Элемент.Представление);
        Колонка.Вставить("Вид", ВидКолонки(РеквизитыРаздела, Элемент.Значение));
        Колонки.Добавить(Колонка);
    КонецЦикла;

    КолонкаПустая = Новый Структура;
    КолонкаПустая.Вставить("Имя", "");
    КолонкаПустая.Вставить("Заголовок", "uuid");
    КолонкаПустая.Вставить("Вид", 5);
    Колонки.Добавить(КолонкаПустая);

    Возврат Колонки;

КонецФункции

// Описание: Вид форматирования колонки по типу реквизита табличной части.
//
// Параметры:
// РеквизитыРаздела - КоллекцияРеквизитов - реквизиты табличной части
// ИмяПоля - Строка - имя реквизита или НомерСтроки
//
// Возвращаемое значение:
// Число - 0 строка, 1 дата, 2 время, 3 число, 4 число с пустым нулем
//
Функция ВидКолонки(РеквизитыРаздела, ИмяПоля)

    Если ИмяПоля = "НомерСтроки" Тогда
        Возврат 3;
    КонецЕсли;

    Реквизит = РеквизитыРаздела.Найти(ИмяПоля);
    Если Реквизит = Неопределено Тогда
        ВызватьИсключение "В табличной части нет реквизита " + ИмяПоля;
    КонецЕсли;

    ТипРеквизита = Реквизит.Тип;
    Если ТипРеквизита.СодержитТип(Тип("Дата")) Тогда
        Если СтрНайти(ВРег(ИмяПоля), "ВРЕМЯ") > 0 Тогда
            Возврат 2;
        КонецЕсли;
        Возврат 1;
    КонецЕсли;

    Если ТипРеквизита.СодержитТип(Тип("Число")) Тогда
        Если ИмяПоля = "ВидимоеКоличествоАктиваТипаАйсберг"
            Или ИмяПоля = "СтавкаРЕПО"
            Или ИмяПоля = "СтоимостьАктиваОперацииВВалютеЦены"
            Или ИмяПоля = "ПремияДисконтНакопленныйПроцентПоЦБ"
            Или ИмяПоля = "ВидАктива" Тогда
            Возврат 4;
        КонецЕсли;
        Возврат 3;
    КонецЕсли;

    Возврат 0;

КонецФункции

// Описание: Откуда читать строки раздела. С версии ДУ 1.5.30.6 разделы 3, 4, 5, 6, 7, 9 хранятся
// в регистрах сведений Отчет577П_РазделN (измерения Отчет, [Дата], ПорядковыйНомер; ПорядковыйНомер
// сквозной по разделу, как НомерСтроки табличной части). Документы, заполненные раньше, хранят эти
// разделы в табличных частях, а регистры по ним пусты: тогда, как и в конфигурации без регистров,
// раздел читается из табличной части. Наличие регистра проверяется по метаданным, чтобы обработка
// работала и до, и после обновления конфигурации.
//
// Параметры:
// ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П - документ
// ИмяРаздела - Строка - имя раздела (табличной части)
//
// Возвращаемое значение:
// Структура - описание источника:
//  * Таблица - Строка - таблица запроса
//  * ПолеДокумента - Строка - поле ссылки на документ (Ссылка или Отчет)
//  * ПолеНомера - Строка - поле порядка строк (НомерСтроки или ПорядковыйНомер)
//  * ПорцииПоДням - Булево - Истина для регистров с измерением Дата
//  * Представление - Строка - для итога выгрузки
//
Функция ИсточникДанныхРаздела(ДокументСсылка, ИмяРаздела)

    Источник = Новый Структура;
    Источник.Вставить("Таблица",       "Документ.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П." + ИмяРаздела);
    Источник.Вставить("ПолеДокумента", "Ссылка");
    Источник.Вставить("ПолеНомера",    "НомерСтроки");
    Источник.Вставить("ПорцииПоДням",  Ложь);
    Источник.Вставить("Представление", "табличная часть");

    МетаданныеРегистра = Метаданные.РегистрыСведений.Найти("Отчет577П_" + ИмяРаздела);
    Если МетаданныеРегистра = Неопределено Тогда
        Возврат Источник;
    КонецЕсли;

    ТаблицаРегистра = "РегистрСведений." + МетаданныеРегистра.Имя;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Раздел.ПорядковыйНомер КАК ПорядковыйНомер
    |ИЗ
    |    " + ТаблицаРегистра + " КАК Раздел
    |ГДЕ
    |    Раздел.Отчет = &Ссылка";
    Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
    Если Запрос.Выполнить().Пустой() Тогда
        Возврат Источник;
    КонецЕсли;

    Источник.Таблица       = ТаблицаРегистра;
    Источник.ПолеДокумента = "Отчет";
    Источник.ПолеНомера    = "ПорядковыйНомер";
    Источник.ПорцииПоДням  = МетаданныеРегистра.Измерения.Найти("Дата") <> Неопределено;
    Источник.Представление = "регистр сведений";
    Возврат Источник;

КонецФункции

// Описание: Текст запроса порции строк раздела. Порция по дням - параметр Дата (регистры с измерением
// Дата: отбор по началу индекса Отчет, Дата, ПорядковыйНомер); иначе диапазон номера строки
// в параметрах НачалоПорции и КонецПорции. В выборку входят только колонки файла.
//
// Параметры:
// Источник - Структура - см. ИсточникДанныхРаздела
// Колонки - Массив из Структура - описание колонок
//
// Возвращаемое значение:
// Строка - текст запроса
//
Функция ТекстЗапросаРаздела(Источник, Колонки)

    Поля = Новый Массив;
    Для Каждого Колонка Из Колонки Цикл
        Если Не ЗначениеЗаполнено(Колонка.Имя) Тогда
            Продолжить;
        КонецЕсли;
        Поля.Добавить("Раздел." + Колонка.Имя + " КАК " + Колонка.Имя);
    КонецЦикла;

    Если Источник.ПорцииПоДням Тогда
        УсловиеПорции = "И Раздел.Дата = &Дата";
    Иначе
        УсловиеПорции = "И Раздел." + Источник.ПолеНомера + " МЕЖДУ &НачалоПорции И &КонецПорции";
    КонецЕсли;

    Возврат "ВЫБРАТЬ"
        + Символы.ПС + Символы.Таб + СтрСоединить(Поля, "," + Символы.ПС + Символы.Таб)
        + Символы.ПС + "ИЗ"
        + Символы.ПС + Символы.Таб + Источник.Таблица + " КАК Раздел"
        + Символы.ПС + "ГДЕ"
        + Символы.ПС + Символы.Таб + "Раздел." + Источник.ПолеДокумента + " = &Ссылка"
        + Символы.ПС + Символы.Таб + УсловиеПорции
        + Символы.ПС + "УПОРЯДОЧИТЬ ПО"
        + Символы.ПС + Символы.Таб + "Раздел." + Источник.ПолеНомера;

КонецФункции

// Описание: Параметры порций чтения раздела в порядке строк файла.
// Регистры с измерением Дата - по порции на день (день раздела 7 или 9 - до 150 тыс. строк).
// Табличные части и регистры разделов 3, 4 - диапазоны номера строки по 100 тыс.: на разделе 1,5 млн
// строк память вызова около 0,2 ГБ против 2,8 ГБ при чтении целиком, запросы 14 с против 60 с.
//
// Параметры:
// ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П - документ
// Источник - Структура - см. ИсточникДанныхРаздела
//
// Возвращаемое значение:
// Массив из Структура - параметры запроса порции: Дата либо НачалоПорции и КонецПорции
//
Функция ПорцииРаздела(ДокументСсылка, Источник)

    Порции = Новый Массив;
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

    Если Источник.ПорцииПоДням Тогда
        Запрос.Текст =
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |    Раздел.Дата КАК ДатаПорции
        |ИЗ
        |    " + Источник.Таблица + " КАК Раздел
        |ГДЕ
        |    Раздел.Отчет = &Ссылка
        |
        |УПОРЯДОЧИТЬ ПО
        |    ДатаПорции";
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Порции.Добавить(Новый Структура("Дата", Выборка.ДатаПорции));
        КонецЦикла;
        Возврат Порции;
    КонецЕсли;

    Запрос.Текст =
    "ВЫБРАТЬ
    |    ЕСТЬNULL(МАКСИМУМ(Раздел." + Источник.ПолеНомера + "), 0) КАК НомерСтроки
    |ИЗ
    |    " + Источник.Таблица + " КАК Раздел
    |ГДЕ
    |    Раздел." + Источник.ПолеДокумента + " = &Ссылка";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    МаксимальныйНомер = Выборка.НомерСтроки;

    РазмерПорции = 100000;
    НачалоПорции = 1;
    Пока НачалоПорции <= МаксимальныйНомер Цикл
        Порции.Добавить(Новый Структура("НачалоПорции, КонецПорции", НачалоПорции, НачалоПорции + РазмерПорции - 1));
        НачалоПорции = НачалоПорции + РазмерПорции;
    КонецЦикла;
    Возврат Порции;

КонецФункции

// Описание: Пишет sr_sved_purcb.csv. Реквизиты шапки одним запросом,
// признак раздела берется из уже посчитанного числа строк.
//
// Параметры:
// ДокументСсылка - ДокументСсылка.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П - документ
// СчетчикиРазделов - Соответствие - имя раздела и количество строк
// ИмяФайла - Строка - полный путь файла
//
Процедура ЗаписатьСопроводительнуюИнформацию(ДокументСсылка, СчетчикиРазделов, ИмяФайла)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	Док.НаименованиеПрофУчастника КАК НаименованиеПрофУчастника,
    |	Док.ИННПрофУчастника КАК ИННПрофУчастника,
    |	Док.ФИООтветственного КАК ФИООтветственного,
    |	Док.ТелефонОтветственного КАК ТелефонОтветственного,
    |	Док.АдресЭлПочтыОтветственного КАК АдресЭлПочтыОтветственного,
    |	Док.ПрограммноеОбеспечение КАК ПрограммноеОбеспечение,
    |	Док.ДатаНаправленияЗапроса КАК ДатаНаправленияЗапроса,
    |	Док.ДатаПредоставленияОтветаНаЗапрос КАК ДатаПредоставленияОтветаНаЗапрос,
    |	Док.НачалоПериода КАК НачалоПериода,
    |	Док.КонецПериода КАК КонецПериода
    |ИЗ
    |	Документ.РО_XBRL6_1_ОтчетПоВнутреннемуУчету_577П КАК Док
    |ГДЕ
    |	Док.Ссылка = &Ссылка";
    Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "Документ отчета 577-П не найден.";
    КонецЕсли;

    Заголовки = Новый Массив;
    Значения = Новый Массив;

    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_PSMP_Nm_dimGrp_1_periodGrp_1", Выборка.НаименованиеПрофУчастника);
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_PSMP_INN_dimGrp_1_periodGrp_1", Выборка.ИННПрофУчастника);
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_OtvZaPrInf_FIO_dimGrp_1_periodGrp_1", Выборка.ФИООтветственного);
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_OtvZaPrInf_Tlf_dimGrp_1_periodGrp_1", Выборка.ТелефонОтветственного);
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_OtvZaPrInf_ElPoch_dimGrp_1_periodGrp_1", Выборка.АдресЭлПочтыОтветственного);
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_Inf_PO_dimGrp_1_periodGrp_1", Выборка.ПрограммноеОбеспечение);
    ДобавитьПолеСопровождения(
        Заголовки, Значения, "purcb_dic_Rqst_Dt_dimGrp_1_periodGrp_1",
        Формат(Выборка.ДатаНаправленияЗапроса, "ДФ=yyyy-MM-dd"));
    ДобавитьПолеСопровождения(
        Заголовки, Значения, "purcb_dic_Rspns_Dt_dimGrp_1_periodGrp_1",
        Формат(Выборка.ДатаПредоставленияОтветаНаЗапрос, "ДФ=yyyy-MM-dd"));
    ДобавитьПолеСопровождения(
        Заголовки, Значения, "purcb_dic_PeriodStart_Dt_dimGrp_1_periodGrp_1",
        Формат(Выборка.НачалоПериода, "ДФ=yyyy-MM-dd"));
    ДобавитьПолеСопровождения(
        Заголовки, Значения, "purcb_dic_PeriodEnd_Dt_dimGrp_1_periodGrp_1",
        Формат(Выборка.КонецПериода, "ДФ=yyyy-MM-dd"));
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_R1Enumerator_dimGrp_1_periodGrp_1", ЕстьДанные(СчетчикиРазделов["Раздел1"]));
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_R2Enumerator_dimGrp_1_periodGrp_1", ЕстьДанные(СчетчикиРазделов["Раздел2"]));
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_R3Enumerator_dimGrp_1_periodGrp_1", ЕстьДанные(СчетчикиРазделов["Раздел3"]));
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_R4Enumerator_dimGrp_1_periodGrp_1", ЕстьДанные(СчетчикиРазделов["Раздел4"]));
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_R5Enumerator_dimGrp_1_periodGrp_1", ЕстьДанные(СчетчикиРазделов["Раздел5"]));
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_R6Enumerator_dimGrp_1_periodGrp_1", ЕстьДанные(СчетчикиРазделов["Раздел6"]));
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_PR7Enumerator_dimGrp_1_periodGrp_1", ЕстьДанные(СчетчикиРазделов["Раздел7"]));
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_R8Enumerator_dimGrp_1_periodGrp_1", ЕстьДанные(СчетчикиРазделов["Раздел8"]));
    ДобавитьПолеСопровождения(Заголовки, Значения, "purcb_dic_R9Enumerator_dimGrp_1_periodGrp_1", ЕстьДанные(СчетчикиРазделов["Раздел9"]));
    ДобавитьПолеСопровождения(
        Заголовки,
        Значения,
        "purcb_dic_R10Enumerator_dimGrp_1_periodGrp_1",
        ЕстьДанные(СчетчикиРазделов["Раздел10"]));
    ДобавитьПолеСопровождения(
        Заголовки,
        Значения,
        "purcb_dic_R11Enumerator_dimGrp_1_periodGrp_1",
        ЕстьДанные(СчетчикиРазделов["Раздел11"]));
    ДобавитьПолеСопровождения(
        Заголовки, Значения, "purcb_dic_Rqst_YrsEnumerator2_dimGrp_1_periodGrp_1",
        ГодОтчета(Выборка.НачалоПериода, Выборка.КонецПериода));

    ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
    ЗаписьТекста.ЗаписатьСтроку(СтрСоединить(Заголовки, "|"));
    ЗаписьТекста.ЗаписатьСтроку(СтрСоединить(Значения, "|"));
    ЗаписьТекста.Закрыть();

КонецПроцедуры

Процедура ДобавитьПолеСопровождения(Заголовки, Значения, Заголовок, Значение)

    Заголовки.Добавить(Заголовок);
    Значения.Добавить(Значение);

КонецПроцедуры

Функция ЕстьДанные(КоличествоСтрок)

    Если КоличествоСтрок = 0 Тогда
        Возврат "Запрошенные данные отсутствуют";
    КонецЕсли;

    Возврат "Данные переданы";

КонецФункции

Функция ГодОтчета(НачалоПериода, КонецПериода)

    Годы = "";
    ДатаОтчета = НачалоПериода;
    Пока ДатаОтчета < КонецПериода Цикл
        Годы = Годы + Формат(ДатаОтчета, "ДФ=yyyy");
        ДатаОтчета = ДобавитьМесяц(ДатаОтчета, 12);
    КонецЦикла;
    Возврат Годы;

