Функция НормализоватьКаталог(Каталог)

    Результат = СокрЛП(Каталог);
    Результат = СтрЗаменить(Результат, "/", "\");
    Если Не СтрЗаканчиваетсяНа(Результат, "\") Тогда
        Результат = Результат + "\";
    КонецЕсли;
    Возврат Результат;

