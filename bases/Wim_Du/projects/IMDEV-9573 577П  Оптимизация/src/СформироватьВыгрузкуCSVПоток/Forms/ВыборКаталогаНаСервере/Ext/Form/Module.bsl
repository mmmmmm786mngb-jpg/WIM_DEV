
// Выбор каталога выгрузки на сервере 1С. Стандартный диалог выбора показывает каталоги компьютера
// пользователя, а файлы выгрузки пишет сервер, поэтому список дисков и каталогов строится на сервере.
// Результат закрытия формы - выбранный каталог (Строка) или Неопределено.

#Область ОбработчикиСобытийФормы

// Описание: Открывает каталог из параметра Каталог, если сервер его видит, иначе начальный список:
// недавние каталоги и диски сервера.
//
// Параметры:
// Отказ - Булево - признак отказа от создания формы
// СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    НачальныйКаталог = "";
    Если Параметры.Свойство("Каталог") Тогда
        НачальныйКаталог = Параметры.Каталог;
    КонецЕсли;

    Если ЗначениеЗаполнено(НачальныйКаталог) И КаталогДоступенНаСервере(НормализоватьКаталог(НачальныйКаталог)) Тогда
        ПоказатьКаталог(НачальныйКаталог);
    Иначе
        ПоказатьКаталог("");
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Описание: Открывает каталог, путь которого пользователь вписал в поле.
//
// Параметры:
// Элемент - ПолеФормы - поле ТекущийКаталог
//
&НаКлиенте
Процедура ТекущийКаталогПриИзменении(Элемент)

    ПерейтиВКаталог(ТекущийКаталог);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКаталоги

// Описание: Открывает каталог, по которому дважды щелкнули в списке.
//
// Параметры:
// Элемент - ТаблицаФормы - таблица Каталоги
// ВыбраннаяСтрока - Число - идентификатор строки
// Поле - ПолеФормы - колонка
// СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаКлиенте
Процедура КаталогиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    СтрокаКаталога = Каталоги.НайтиПоИдентификатору(ВыбраннаяСтрока);
    Если СтрокаКаталога <> Неопределено Тогда
        ПерейтиВКаталог(СтрокаКаталога.ПолноеИмя);
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Описание: Закрывает форму с открытым каталогом в качестве результата; в начальном списке - с выделенной
// строкой (недавний каталог или диск) и запоминает выбор в недавних.
//
// Параметры:
// Команда - КомандаФормы - команда Выбрать
//
&НаКлиенте
Процедура Выбрать(Команда)

    КаталогВыбора = ТекущийКаталог;
    ТекущиеДанные = Элементы.Каталоги.ТекущиеДанные;
    Если Не ЗначениеЗаполнено(КаталогВыбора) И ТекущиеДанные <> Неопределено Тогда
        КаталогВыбора = ТекущиеДанные.ПолноеИмя;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(КаталогВыбора) Тогда
        ПоказатьПредупреждение(, "Откройте каталог, в который нужно выгрузить файлы.");
        Возврат;
    КонецЕсли;

    ЗапомнитьКаталог(КаталогВыбора);
    Закрыть(КаталогВыбора);

КонецПроцедуры

// Описание: Открывает родительский каталог; с корня диска и сетевой папки - начальный список.
//
// Параметры:
// Команда - КомандаФормы - команда Вверх
//
&НаКлиенте
Процедура Вверх(Команда)

    ПерейтиВКаталог(РодительскийКаталог(ТекущийКаталог));

КонецПроцедуры

// Описание: Открывает стандартный диалог выбора каталога на компьютере пользователя, чтобы выбрать сетевую
// папку мышью (раздел Сеть или подключенный сетевой диск).
//
// Параметры:
// Команда - КомандаФормы - команда СетевойКаталог
//
&НаКлиенте
Процедура СетевойКаталог(Команда)

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Заголовок = "Сетевая папка (раздел Сеть или подключенный сетевой диск)";
    Диалог.Показать(Новый ОписаниеОповещения("СетевойКаталогЗавершение", ЭтотОбъект));

КонецПроцедуры

// Описание: Переводит выбранный в диалоге каталог в полный сетевой путь и открывает его на сервере 1С.
// Буква подключенного сетевого диска заменяется сетевым путем: на сервере 1С этой буквы нет.
// Каталог на диске компьютера пользователя не принимается: сервер 1С его не видит.
//
// Параметры:
// ВыбранныеФайлы - Массив из Строка, Неопределено - выбранный каталог; Неопределено - выбор отменен
// ДополнительныеПараметры - Неопределено - не используется
//
&НаКлиенте
Процедура СетевойКаталогЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Каталог = СетевойПутьВместоДиска(ВыбранныеФайлы[0]);
    Если Не СтрНачинаетсяС(Каталог, "\\") Тогда
        ПоказатьПредупреждение(, "Каталог " + Каталог + " находится на компьютере пользователя, сервер 1С его не видит."
            + " Выберите сетевую папку в разделе Сеть или на подключенном сетевом диске.");
        Возврат;
    КонецЕсли;

    ПерейтиВКаталог(Каталог);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Заменяет букву подключенного сетевого диска пользователя полным сетевым путем:
// Z:\Обмен\577 -> \\сервер\папка\Обмен\577. Список сетевых дисков дает WScript.Network.EnumNetworkDrives
// (пары: буква диска, сетевой путь). Путь без буквы сетевого диска возвращается без изменений.
//
// Параметры:
// Путь - Строка - каталог, выбранный на компьютере пользователя
//
// Возвращаемое значение:
// Строка - сетевой путь или исходный путь
//
&НаКлиенте
Функция СетевойПутьВместоДиска(Знач Путь)

    Если СтрДлина(Путь) < 2 Или Сред(Путь, 2, 1) <> ":" Тогда
        Возврат Путь;
    КонецЕсли;

#Если Не ВебКлиент Тогда
    БукваДиска = ВРег(Лев(Путь, 2));
    Попытка
        СетьWindows = Новый COMОбъект("WScript.Network");
        СетевыеДиски = СетьWindows.EnumNetworkDrives();
        Индекс = 0;
        Пока Индекс + 1 < СетевыеДиски.Count() Цикл
            Если ВРег(СетевыеДиски.Item(Индекс)) = БукваДиска И ЗначениеЗаполнено(СетевыеДиски.Item(Индекс + 1)) Тогда
                Возврат СетевыеДиски.Item(Индекс + 1) + Сред(Путь, 3);
            КонецЕсли;
            Индекс = Индекс + 2;
        КонецЦикла;
    Исключение
        // Без WScript.Network путь остается буквенным, вызывающий код откажет с пояснением.
        Возврат Путь;
    КонецПопытки;
#КонецЕсли

    Возврат Путь;

КонецФункции

&НаКлиенте
Процедура ПерейтиВКаталог(Каталог)

    ТекстОшибки = ПоказатьКаталог(Каталог);
    Если ЗначениеЗаполнено(ТекстОшибки) Тогда
        ПоказатьПредупреждение(, ТекстОшибки);
    КонецЕсли;

КонецПроцедуры

// Описание: Заполняет список подкаталогов каталога на сервере 1С; для пустого пути - начальный список.
// Если сервер не видит каталог, список не меняется.
//
// Параметры:
// Каталог - Строка - путь на сервере 1С или сетевой путь
//
// Возвращаемое значение:
// Строка - текст ошибки, пустая строка при успехе
//
&НаСервере
Функция ПоказатьКаталог(Знач Каталог)

    Если Не ЗначениеЗаполнено(СокрЛП(Каталог)) Тогда
        ЗаполнитьНачальныйСписок();
        Возврат "";
    КонецЕсли;

    Каталог = НормализоватьКаталог(Каталог);
    Если Не КаталогДоступенНаСервере(Каталог) Тогда
        Возврат "Сервер 1С не видит каталог " + Каталог + ". Проверьте путь и права учетной записи сервера 1С.";
    КонецЕсли;

    Подкаталоги = Новый СписокЗначений;
    Для Каждого НайденныйФайл Из НайтиФайлы(Каталог, "*", Ложь) Цикл
        Если НайденныйФайл.ЭтоКаталог() Тогда
            Подкаталоги.Добавить(НайденныйФайл.ПолноеИмя + "\", НайденныйФайл.Имя);
        КонецЕсли;
    КонецЦикла;
    Подкаталоги.СортироватьПоПредставлению();

    Каталоги.Очистить();
    Для Каждого Подкаталог Из Подкаталоги Цикл
        НоваяСтрока = Каталоги.Добавить();
        НоваяСтрока.Имя       = Подкаталог.Представление;
        НоваяСтрока.ПолноеИмя = Подкаталог.Значение;
    КонецЦикла;

    ТекущийКаталог = Каталог;
    Возврат "";

КонецФункции

// Описание: Заполняет начальный список: недавно выбранные каталоги (в том числе сетевые) и диски
// сервера 1С (буквы A-Z, у которых есть корневой каталог). Список общих папок сетевого сервера
// платформа не получает, поэтому сетевой каталог один раз вписывают в поле, дальше он в недавних.
//
&НаСервере
Процедура ЗаполнитьНачальныйСписок()

    Каталоги.Очистить();

    Для Каждого НедавнийКаталог Из НедавниеКаталоги() Цикл
        НоваяСтрока = Каталоги.Добавить();
        НоваяСтрока.Имя       = НедавнийКаталог;
        НоваяСтрока.ПолноеИмя = НедавнийКаталог;
        НоваяСтрока.Где       = "Недавний каталог";
    КонецЦикла;

    Для КодБуквы = КодСимвола("A") По КодСимвола("Z") Цикл
        КореньДиска = Символ(КодБуквы) + ":\";
        Если КаталогДоступенНаСервере(КореньДиска) Тогда
            НоваяСтрока = Каталоги.Добавить();
            НоваяСтрока.Имя       = КореньДиска;
            НоваяСтрока.ПолноеИмя = КореньДиска;
            НоваяСтрока.Где       = "Диск сервера";
        КонецЕсли;
    КонецЦикла;

    ТекущийКаталог = "";

КонецПроцедуры

// Описание: Недавно выбранные каталоги текущего пользователя, последний выбранный первым.
//
// Возвращаемое значение:
// Массив из Строка - пути каталогов
//
&НаСервереБезКонтекста
Функция НедавниеКаталоги()

    Сохраненные = ХранилищеОбщихНастроек.Загрузить("СформироватьВыгрузкуCSVПоток", "НедавниеКаталоги");
    Если ТипЗнч(Сохраненные) = Тип("Массив") Тогда
        Возврат Сохраненные;
    КонецЕсли;
    Возврат Новый Массив;

КонецФункции

// Описание: Ставит каталог первым в список недавних, список ограничен 10 каталогами.
//
// Параметры:
// Каталог - Строка - выбранный каталог
//
&НаСервереБезКонтекста
Процедура ЗапомнитьКаталог(Знач Каталог)

    НовыйСписок = Новый Массив;
    НовыйСписок.Добавить(Каталог);
    Для Каждого НедавнийКаталог Из НедавниеКаталоги() Цикл
        Если НовыйСписок.Количество() >= 10 Тогда
            Прервать;
        КонецЕсли;
        Если ВРег(НедавнийКаталог) <> ВРег(Каталог) Тогда
            НовыйСписок.Добавить(НедавнийКаталог);
        КонецЕсли;
    КонецЦикла;
    ХранилищеОбщихНастроек.Сохранить("СформироватьВыгрузкуCSVПоток", "НедавниеКаталоги", НовыйСписок);

КонецПроцедуры

// Описание: Признак, что сервер 1С видит каталог.
//
// Параметры:
// Каталог - Строка - нормализованный путь с завершающим разделителем
//
// Возвращаемое значение:
// Булево - Истина, если каталог существует и доступен серверу
//
&НаСервереБезКонтекста
Функция КаталогДоступенНаСервере(Каталог)

    ФайлКаталога = Новый Файл(Каталог);
    Возврат ФайлКаталога.Существует() И ФайлКаталога.ЭтоКаталог();

КонецФункции

// Описание: Путь каталога с обратными косыми чертами и завершающим разделителем.
//
// Параметры:
// Каталог - Строка - путь
//
// Возвращаемое значение:
// Строка - нормализованный путь
//
&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьКаталог(Знач Каталог)

    Каталог = СтрЗаменить(СокрЛП(Каталог), "/", "\");
    Если Не СтрЗаканчиваетсяНа(Каталог, "\") Тогда
        Каталог = Каталог + "\";
    КонецЕсли;
    Возврат Каталог;

КонецФункции

// Описание: Родительский каталог. Для корня диска и для сетевой папки \\сервер\папка\ - пустая строка
// (список дисков): список общих папок сетевого сервера платформа не получает.
//
// Параметры:
// Каталог - Строка - текущий каталог
//
// Возвращаемое значение:
// Строка - родительский каталог или пустая строка
//
&НаКлиентеНаСервереБезКонтекста
Функция РодительскийКаталог(Знач Каталог)

    Если Не ЗначениеЗаполнено(Каталог) Тогда
        Возврат "";
    КонецЕсли;

    Части = СтрРазделить(НормализоватьКаталог(Каталог), "\", Ложь);
    ЭтоСетевойПуть = СтрНачинаетсяС(Каталог, "\\");
    МинимумЧастей = 1;
    Если ЭтоСетевойПуть Тогда
        МинимумЧастей = 2;
    КонецЕсли;
    Если Части.Количество() <= МинимумЧастей Тогда
        Возврат "";
    КонецЕсли;

    Части.Удалить(Части.ВГраница());
    Родитель = СтрСоединить(Части, "\") + "\";
    Если ЭтоСетевойПуть Тогда
        Родитель = "\\" + Родитель;
    КонецЕсли;
    Возврат Родитель;

КонецФункции

#КонецОбласти
