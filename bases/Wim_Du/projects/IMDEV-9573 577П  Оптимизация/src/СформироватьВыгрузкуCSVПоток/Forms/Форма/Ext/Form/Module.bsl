&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
        ДополнительнаяОбработкаСсылка = Параметры.ДополнительнаяОбработкаСсылка;
    КонецЕсли;

    Если Параметры.Свойство("ОбъектыНазначения") И Параметры.ОбъектыНазначения.Количество() > 0 Тогда
        Объект.ДокументОтчета = Параметры.ОбъектыНазначения[0];
    КонецЕсли;

    СохраненныйПуть = ХранилищеОбщихНастроек.Загрузить("СформироватьВыгрузкуCSVПоток", "ПутьВыгрузки");
    Если ЗначениеЗаполнено(СохраненныйПуть) Тогда
        Объект.ПутьВыгрузки = СохраненныйПуть;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначенияМассив) Экспорт

    Если ОбъектыНазначенияМассив.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Не выбран документ отчета 577-П.");
        Возврат;
    КонецЕсли;

    Объект.ДокументОтчета = ОбъектыНазначенияМассив[0];
    НачатьВыгрузкуСписка(ОбъектыНазначенияМассив, 0);

КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)

    Если Не ЗначениеЗаполнено(Объект.ДокументОтчета) Тогда
        ПоказатьПредупреждение(, "Укажите документ отчета 577-П.");
        Возврат;
    КонецЕсли;

    Документы = Новый Массив;
    Документы.Добавить(Объект.ДокументОтчета);
    НачатьВыгрузкуСписка(Документы, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ВыбратьКаталогВыгрузки();

КонецПроцедуры

&НаКлиенте
Процедура НачатьВыгрузкуСписка(Документы, Индекс)

    Если Индекс >= Документы.Количество() Тогда
        ОтпуститьФормуВыгрузки();
        Возврат;
    КонецЕсли;

    Объект.ДокументОтчета = Документы[Индекс];

    Если Не ЗначениеЗаполнено(Объект.ПутьВыгрузки) Тогда
        Если Не ВыбратьКаталогВыгрузки() Тогда
            ОтпуститьФормуВыгрузки();
            Возврат;
        КонецЕсли;
    КонецЕсли;

    ТекстОшибки = ПроверитьИЗапомнитьКаталогНаСервере();
    Если ЗначениеЗаполнено(ТекстОшибки) Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, ТекстОшибки);
        Возврат;
    КонецЕсли;

    Запуск = НачатьВыгрузкуВФонеНаСервере();
    Если Не Запуск.Успех Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, Запуск.Описание);
        Возврат;
    КонецЕсли;

    ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ФормаВладелецОжидания());
    ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
    ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
    ПараметрыОжидания.Интервал = 1;
    ПараметрыОжидания.ТекстСообщения = "Выгрузка 577-П в CSV...";

    Оповещение = Новый ОписаниеОповещения(
        "ВыгрузкаВФонеЗавершение",
        ЭтотОбъект,
        Новый Структура("Документы, Индекс", Документы, Индекс));

    УдержатьФормуВыгрузки();
    ДлительныеОперацииКлиент.ОжидатьЗавершение(Запуск.ДлительнаяОперация, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт

    Если Результат = Неопределено Тогда
        ОтпуститьФормуВыгрузки();
        ПоказатьПредупреждение(, "Выгрузка отменена.");
        Возврат;
    КонецЕсли;

    Если Результат.Статус = "Ошибка" Тогда
        ОтпуститьФормуВыгрузки();
        ТекстОшибки = Результат.КраткоеПредставлениеОшибки;
        Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
            ТекстОшибки = "Выгрузка завершилась с ошибкой.";
        КонецЕсли;
        ПоказатьПредупреждение(, ТекстОшибки);
        Возврат;
    КонецЕсли;

    Итог = ПрочитатьРезультатНаСервере(Результат.АдресРезультата);
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Итог.Описание;
    Сообщение.Сообщить();

    НачатьВыгрузкуСписка(ДополнительныеПараметры.Документы, ДополнительныеПараметры.Индекс + 1);

КонецПроцедуры

&НаКлиенте
Функция ФормаВладелецОжидания()

    // Команда из списка или документа выполняется на форме, которую БСП получает через ПолучитьФорму и не открывает.
    // Окно ожидания с таким владельцем сразу закрывается. Владельцем ставим уже открытую форму списка или документа.
    Если Открыта() Тогда
        Возврат ЭтотОбъект;
    КонецЕсли;

    Если ТипЗнч(ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") И ВладелецФормы.Открыта() Тогда
        Возврат ВладелецФормы;
    КонецЕсли;

    Открыть();
    Возврат ЭтотОбъект;

КонецФункции

&НаКлиенте
Процедура УдержатьФормуВыгрузки()

    // БСП отпускает ссылку на форму сразу после ВыполнитьКоманду. Пока окно ожидания открыто, форма нужна для оповещения о завершении.
    ПараметрыПриложения.Вставить(КлючУдержанияФормыВыгрузки(), ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОтпуститьФормуВыгрузки()

    Ключ = КлючУдержанияФормыВыгрузки();
    Если ПараметрыПриложения.Получить(Ключ) <> Неопределено Тогда
        ПараметрыПриложения.Удалить(Ключ);
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция КлючУдержанияФормыВыгрузки()

    Возврат "СформироватьВыгрузкуCSVПоток." + Строка(УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Функция ВыбратьКаталогВыгрузки()

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Заголовок = "Каталог на сервере 1С (сетевая папка)";
    Если ЗначениеЗаполнено(Объект.ПутьВыгрузки) Тогда
        Диалог.Каталог = Объект.ПутьВыгрузки;
    КонецЕсли;

    Если Не Диалог.Выбрать() Тогда
        Возврат Ложь;
    КонецЕсли;

    Объект.ПутьВыгрузки = Диалог.Каталог;
    Возврат Истина;

КонецФункции

&НаСервере
Функция ПроверитьИЗапомнитьКаталогНаСервере()

    Каталог = СокрЛП(Объект.ПутьВыгрузки);
    Каталог = СтрЗаменить(Каталог, "/", "\");
    Если Не ЗначениеЗаполнено(Каталог) Тогда
        Возврат "Укажите каталог выгрузки.";
    КонецЕсли;
    Если Не СтрЗаканчиваетсяНа(Каталог, "\") Тогда
        Каталог = Каталог + "\";
    КонецЕсли;

    ФайлКаталога = Новый Файл(Каталог);
    Если Не ФайлКаталога.Существует() Или Не ФайлКаталога.ЭтоКаталог() Тогда
        Возврат "Сервер 1С не видит каталог " + Каталог
            + ". Укажите сетевую папку, доступную серверу.";
    КонецЕсли;

    Объект.ПутьВыгрузки = Каталог;
    ХранилищеОбщихНастроек.Сохранить("СформироватьВыгрузкуCSVПоток", "ПутьВыгрузки", Каталог);
    Возврат "";

КонецФункции

&НаСервере
Функция НачатьВыгрузкуВФонеНаСервере()

    Ответ = Новый Структура;
    Ответ.Вставить("Успех", Ложь);
    Ответ.Вставить("Описание", "");
    Ответ.Вставить("ДлительнаяОперация", Неопределено);

    ИмяФайлаОбработки = "";
    Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
        ИмяФайлаОбработки = ПодготовитьФайлОбработкиНаСервере();
        Если Не ЗначениеЗаполнено(ИмяФайлаОбработки) Тогда
            Ответ.Описание = "Не удалось подготовить файл обработки для фонового задания. "
                + "Откройте обработку из файла или зарегистрируйте ее в дополнительных обработках.";
            Возврат Ответ;
        КонецЕсли;
    КонецЕсли;

    ПараметрыМетода = Новый Структура;
    ПараметрыМетода.Вставить("ДокументСсылка", Объект.ДокументОтчета);
    ПараметрыМетода.Вставить("Каталог", Объект.ПутьВыгрузки);
    ПараметрыМетода.Вставить("ПутьEPF", ИмяФайлаОбработки);

    ПараметрыЗадания = Новый Структура;
    ПараметрыЗадания.Вставить("ИмяМетода", "ВыгрузитьВФоне");
    ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыМетода);
    ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
    ПараметрыЗадания.Вставить("ИмяОбработки", ИмяФайлаОбработки);
    ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);

    ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
    ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выгрузка 577-П в CSV";
    ПараметрыВыполнения.ОжидатьЗавершение = 0;
    ПараметрыВыполнения.ЗапуститьВФоне = Истина;

    Попытка
        Ответ.ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
            "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
            ПараметрыЗадания,
            ПараметрыВыполнения);
        Ответ.Успех = Истина;
    Исключение
        Ответ.Описание = "Не удалось запустить выгрузку: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    Возврат Ответ;

КонецФункции

&НаСервере
Функция ПодготовитьФайлОбработкиНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Путь = ОбработкаОбъект.ИспользуемоеИмяФайла;
    Если Не ЗначениеЗаполнено(Путь) Тогда
        Возврат "";
    КонецЕсли;

    ФайлОбработки = Новый Файл(Путь);
    Если Не ФайлОбработки.Существует() Тогда
        Возврат "";
    КонецЕсли;

    ДвоичныеДанные = Новый ДвоичныеДанные(Путь);
    ИмяФайла = ПолучитьИмяВременногоФайла("epf");
    ДвоичныеДанные.Записать(ИмяФайла);
    Возврат ИмяФайла;

КонецФункции

&НаСервере
Функция ПрочитатьРезультатНаСервере(АдресРезультата)

    Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
    Если ТипЗнч(Результат) <> Тип("Структура") Тогда
        Пустой = Новый Структура;
        Пустой.Вставить("Успех", Ложь);
        Пустой.Вставить("Описание", "Пустой результат выгрузки.");
        Возврат Пустой;
    КонецЕсли;

    Возврат Результат;

КонецФункции
