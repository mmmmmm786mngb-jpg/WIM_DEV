
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Заголовок = "IMDEV-9105 тест РДУ без ДО | v. " + ТекОбъект.СведенияОВнешнейОбработке().Версия;
	
	// 1) Подтянуть боевые настройки шаблонов из "Синхронизация НСИ с ДО" (если зарегистрирована)
	ЗагрузитьНастройкиИзСинхронизацииНСИ(ТекОбъект);
	
	// 2) Готовый профиль для замера на 100 договорах - только нажать кнопку
	ЗаполнитьПараметрыТестаПоУмолчанию(ТекОбъект);
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
КонецПроцедуры

// Описание: Заполняет параметры теста IMDEV-9105 для запуска одной кнопкой
//
&НаСервере
Процедура ЗаполнитьПараметрыТестаПоУмолчанию(ТекОбъект)
	
	ТекОбъект.КоличествоОбразцов = 100;
	ТекОбъект.ПрефиксТеста = "T9105";
	ТекОбъект.ОткатыватьТранзакцию = Истина;
	ТекОбъект.ПринудительноСоздаватьПП = Истина;
	ТекОбъект.РежимТолькоЧтениеДО = Истина;
	
	// Пул РДУ всегда "Розничное ДУ" (как в остальных обработках ДУ)
	ТекОбъект.ПулРозничноеДУ = ПолучитьПулРозничноеДУ();
	
КонецПроцедуры

// Описание: Возвращает ссылку на пул "Розничное ДУ" (по наименованию, иначе по известному UUID)
//
// Возвращаемое значение:
// СправочникСсылка.Пул - пул розничного ДУ или пустая ссылка
//
&НаСервере
Функция ПолучитьПулРозничноеДУ()
	
	Пул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	Если ЗначениеЗаполнено(Пул) Тогда
		Возврат Пул;
	КонецЕсли;
	
	// Запасной UUID из настроек СинхронизацияНСИ / IMAPPS-34301
	ПулПоUID = Справочники.Пул.ПолучитьСсылку(Новый УникальныйИдентификатор("686be652-ff24-11ef-b2be-0050569f27c0"));
	Если ОбщегоНазначения.СсылкаСуществует(ПулПоUID) Тогда
		Возврат ПулПоUID;
	КонецЕсли;
	
	Возврат Справочники.Пул.ПустаяСсылка();
	
КонецФункции

// Описание: Ищет доп. обработку СинхронизацияНСИ и копирует ХранилищеНастроек (шаблоны УП/брокер/счета)
//
&НаСервере
Процедура ЗагрузитьНастройкиИзСинхронизацииНСИ(ТекОбъект)
	
	НастройкиЗагружены = Ложь;
	
	// Сначала - если открыли как зарегистрированную доп. обработку (своя регистрация)
	ДопОбработкаСсылка = Неопределено;
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", ДопОбработкаСсылка)
		И ЗначениеЗаполнено(ДопОбработкаСсылка) Тогда
		
		Настройки = ДопОбработкаСсылка.ХранилищеНастроек.Получить();
		Если Настройки <> Неопределено Тогда
			ТекОбъект.УстановитьПользовательскиеНастройки(Настройки);
			НастройкиЗагружены = Истина;
			ДопОбработка = ДопОбработкаСсылка;
		КонецЕсли;
	КонецЕсли;
	
	// Затем - боевая "СинхронизацияНСИ" по имени объекта метаданных внешней обработки
	Если Не НастройкиЗагружены Тогда
		СсылкаСНСИ = НайтиДопОбработкуПоИмениОбъекта("СинхронизацияНСИ");
		Если ЗначениеЗаполнено(СсылкаСНСИ) Тогда
			Настройки = СсылкаСНСИ.ХранилищеНастроек.Получить();
			Если Настройки <> Неопределено Тогда
				ТекОбъект.УстановитьПользовательскиеНастройки(Настройки);
				НастройкиЗагружены = Истина;
				ДопОбработка = СсылкаСНСИ;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Запасной вариант - поиск по наименованию
	Если Не НастройкиЗагружены Тогда
		СсылкаСНСИ = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Синхронизация НСИ с ДО", Истина);
		Если ЗначениеЗаполнено(СсылкаСНСИ) Тогда
			Настройки = СсылкаСНСИ.ХранилищеНастроек.Получить();
			Если Настройки <> Неопределено Тогда
				ТекОбъект.УстановитьПользовательскиеНастройки(Настройки);
				НастройкиЗагружены = Истина;
				ДопОбработка = СсылкаСНСИ;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиЗагружены Тогда
		Сообщить("Настройки шаблонов загружены из доп. обработки Синхронизация НСИ.", СтатусСообщения.Информация);
	Иначе
		Сообщить("Не найдены сохраненные настройки Синхронизация НСИ. Проверьте шаблоны на форме настроек.", СтатусСообщения.Внимание);
	КонецЕсли;
	
КонецПроцедуры

// Описание: Ищет элемент справочника доп. обработок по реквизиту ИмяОбъекта
//
&НаСервере
Функция НайтиДопОбработкуПоИмениОбъекта(ИмяОбъекта)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Доп.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Доп
	|ГДЕ
	|	Доп.ИмяОбъекта = &ИмяОбъекта
	|	И НЕ Доп.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Доп.Наименование";
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СинхронизоватьНСИ(Команда)
	
	СформироватьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	СформироватьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	
	// На всякий случай фиксируем профиль теста перед запуском
	Если ТекОбъект.КоличествоОбразцов <= 0 Тогда
		ТекОбъект.КоличествоОбразцов = 100;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекОбъект.ПрефиксТеста) Тогда
		ТекОбъект.ПрефиксТеста = "T9105";
	КонецЕсли;
	ТекОбъект.ПринудительноСоздаватьПП = Истина;
	ТекОбъект.РежимТолькоЧтениеДО = Истина;
	Если Не ЗначениеЗаполнено(ТекОбъект.ПулРозничноеДУ) Тогда
		ТекОбъект.ПулРозничноеДУ = ПолучитьПулРозничноеДУ();
	КонецЕсли;
	
	Результат = ТекОбъект.СформироватьОтчетЗамеровТеста();
	
	Сверка.Очистить();
	Если Результат.ТабДокумент <> Неопределено Тогда
		Сверка.Вывести(Результат.ТабДокумент);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
	Элементы.ДанныеКонтрагентов.ТекущаяСтраница = Элементы.ОтчетПоСверке;
	
	Если Результат.Успех Тогда
		Сообщить("Тест завершен. Замеры выведены в табличный документ.", СтатусСообщения.Информация);
	Иначе
		ТекстОшибки = Результат.ТекстОшибки;
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Тест завершен с ошибками. См. табличный документ и журнал IMDEV-9105.Замер";
		КонецЕсли;
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыборочнуюСинхронизацию(Команда)
	ВыполнитьВыборочнуюСинхронизациюНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьВыборочнуюСинхронизациюНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.ВыполнитьВыборочнуюСинхронизацию();
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьУведомления(Команда)
	ПолучитьУведомленияНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПолучитьУведомленияНаСервере()
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ЕстьОшибки = Ложь;
	ЕстьПредупреждения = Ложь;
	ТекОбъект.ПолучитьУведомления(ЕстьОшибки, ЕстьПредупреждения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПоручения(Команда)
	СоздатьПорученияНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьПорученияНаСервере()
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ЕстьОшибки = Ложь;
	ЕстьПредупреждения = Ложь;
	ТекОбъект.СоздатьПоручения(ЕстьОшибки, ЕстьПредупреждения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
КонецПроцедуры

#КонецОбласти
