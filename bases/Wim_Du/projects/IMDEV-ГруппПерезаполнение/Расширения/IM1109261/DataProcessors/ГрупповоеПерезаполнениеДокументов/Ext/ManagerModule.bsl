#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область IMDEV_110926_1

#Область ПрограммныйИнтерфейс

// Описание: Диспетчер группового перезаполнения: нарезка пачек по договорам ДУ,
// скользящее окно воркеров, прогресс, сводка и замер длительной операции.
//
// Параметры:
// Параметры - Структура - вид, таблицы документов, процедуры заполнения, лимиты потоков и порции
// АдресРезультата - Строка - адрес временного хранилища для структуры результата
//
Процедура ВыполнитьГрупповоеПерезаполнение(Параметры, АдресРезультата) Экспорт

    ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
        "ДУ.ГрупповоеПерезаполнениеДокументов");
    ВремяСтарта = ТекущаяУниверсальнаяДата();

    Результат = Новый Структура;
    Результат.Вставить("ВидДокумента", "");
    Результат.Вставить("Документов", 0);
    Результат.Вставить("ДокументовРиска", 0);
    Результат.Вставить("Договоров", 0);
    Результат.Вставить("Успешно", 0);
    Результат.Вставить("Ошибок", 0);
    Результат.Вставить("Потоков", 0);
    Результат.Вставить("ТекстСводки", "");

    Попытка

        ВидДокумента = "";
        ТаблицаДокументов = Неопределено;
        ТаблицаРиска = Неопределено;
        ПроцедураЗаполнения = "";
        ПроцедураЗаполненияРиска = "";
        ФлагРиска = Ложь;
        КоличествоПотоков = 0;
        РазмерПорции = 50;

        Параметры.Свойство("ВидДокумента", ВидДокумента);
        Параметры.Свойство("ТаблицаДокументов", ТаблицаДокументов);
        Параметры.Свойство("ТаблицаРиска", ТаблицаРиска);
        Параметры.Свойство("ПроцедураЗаполнения", ПроцедураЗаполнения);
        Параметры.Свойство("ПроцедураЗаполненияРиска", ПроцедураЗаполненияРиска);
        Параметры.Свойство("ФлагРиска", ФлагРиска);
        Параметры.Свойство("КоличествоПотоков", КоличествоПотоков);
        Параметры.Свойство("РазмерПорции", РазмерПорции);

        Результат.ВидДокумента = ВидДокумента;

        Если ТипЗнч(ТаблицаДокументов) <> Тип("ТаблицаЗначений") Тогда
            ТаблицаДокументов = Новый ТаблицаЗначений;
            ТаблицаДокументов.Колонки.Добавить("Ссылка");
            ТаблицаДокументов.Колонки.Добавить("ДоговорДУ");
        КонецЕсли;
        Если ТипЗнч(ТаблицаРиска) <> Тип("ТаблицаЗначений") Тогда
            ТаблицаРиска = Новый ТаблицаЗначений;
            ТаблицаРиска.Колонки.Добавить("Ссылка");
            ТаблицаРиска.Колонки.Добавить("ДоговорДУ");
        КонецЕсли;
        Если Не ЗначениеЗаполнено(РазмерПорции) Или РазмерПорции < 1 Тогда
            РазмерПорции = 50;
        КонецЕсли;
        Если КоличествоПотоков < 0 Тогда
            КоличествоПотоков = 0;
        КонецЕсли;

        СоответствиеДоговоров = Новый Соответствие;
        ПорядокДоговоров = Новый Массив;

        Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
            ДанныеДоговора = СоответствиеДоговоров.Получить(СтрокаДокумента.ДоговорДУ);
            Если ДанныеДоговора = Неопределено Тогда
                ДанныеДоговора = Новый Структура("ДокументыВида, ДокументыРиска", Новый Массив, Новый Массив);
                СоответствиеДоговоров.Вставить(СтрокаДокумента.ДоговорДУ, ДанныеДоговора);
                ПорядокДоговоров.Добавить(СтрокаДокумента.ДоговорДУ);
            КонецЕсли;
            ДанныеДоговора.ДокументыВида.Добавить(СтрокаДокумента.Ссылка);
        КонецЦикла;

        Если ФлагРиска Тогда
            Для Каждого СтрокаДокумента Из ТаблицаРиска Цикл
                ДанныеДоговора = СоответствиеДоговоров.Получить(СтрокаДокумента.ДоговорДУ);
                Если ДанныеДоговора = Неопределено Тогда
                    ДанныеДоговора = Новый Структура("ДокументыВида, ДокументыРиска", Новый Массив, Новый Массив);
                    СоответствиеДоговоров.Вставить(СтрокаДокумента.ДоговорДУ, ДанныеДоговора);
                    ПорядокДоговоров.Добавить(СтрокаДокумента.ДоговорДУ);
                КонецЕсли;
                ДанныеДоговора.ДокументыРиска.Добавить(СтрокаДокумента.Ссылка);
            КонецЦикла;
        КонецЕсли;

        Пачки = Новый Массив;
        ТекущиеДоговорыПачки = Новый Массив;
        Для Каждого ДоговорДУ Из ПорядокДоговоров Цикл
            Если ТекущиеДоговорыПачки.Количество() >= РазмерПорции Тогда
                Пачки.Добавить(ТекущиеДоговорыПачки);
                ТекущиеДоговорыПачки = Новый Массив;
            КонецЕсли;
            ТекущиеДоговорыПачки.Добавить(ДоговорДУ);
        КонецЦикла;
        Если ТекущиеДоговорыПачки.Количество() > 0 Тогда
            Пачки.Добавить(ТекущиеДоговорыПачки);
        КонецЕсли;

        ВсегоДокументовВида = ТаблицаДокументов.Количество();
        ВсегоДокументовРиска = ?(ФлагРиска, ТаблицаРиска.Количество(), 0);
        ВсегоДокументов = ВсегоДокументовВида + ВсегоДокументовРиска;
        ВсегоДоговоров = ПорядокДоговоров.Количество();
        ВсегоПачек = Пачки.Количество();

        Результат.Документов = ВсегоДокументов;
        Результат.ДокументовРиска = ВсегоДокументовРиска;
        Результат.Договоров = ВсегоДоговоров;
        Результат.Потоков = КоличествоПотоков;

        ПараллельныйРежим = КоличествоПотоков > 0
            И ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены();

        Обработано = 0;
        Успешно = 0;
        Ошибок = 0;
        НомерЗапущеннойПорции = 0;

        ОтборАктивных = Новый Структура;
        ОтборАктивных.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);

        Если ВсегоДокументов = 0 Или ВсегоПачек = 0 Тогда
            ДлительныеОперации.СообщитьПрогресс(100,
                "100% * 0/0 док. * потоков 0 / в базе "
                + Формат(ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборАктивных).Количество(), "ЧН=0; ЧГ=")
                + " * порция 0/0");
        ИначеЕсли Не ПараллельныйРежим Тогда

            НомерПорции = 0;
            Для Каждого ДоговорыПачки Из Пачки Цикл
                НомерПорции = НомерПорции + 1;
                ПараметрыПачки = Новый Структура;
                ПараметрыПачки.Вставить("ДокументыВида", Новый Массив);
                ПараметрыПачки.Вставить("ДокументыРиска", Новый Массив);
                ПараметрыПачки.Вставить("ПроцедураЗаполнения", ПроцедураЗаполнения);
                ПараметрыПачки.Вставить("ПроцедураЗаполненияРиска", ПроцедураЗаполненияРиска);
                ПараметрыПачки.Вставить("ФлагРиска", ФлагРиска);
                ПараметрыПачки.Вставить("Успешно", 0);
                ПараметрыПачки.Вставить("Ошибок", 0);
                ПараметрыПачки.Вставить("Обработано", 0);

                Для Каждого ДоговорДУ Из ДоговорыПачки Цикл
                    ДанныеДоговора = СоответствиеДоговоров.Получить(ДоговорДУ);
                    Для Каждого СсылкаДокумента Из ДанныеДоговора.ДокументыВида Цикл
                        СтрокаПачки = Новый Структура("Ссылка, ДоговорДУ", СсылкаДокумента, ДоговорДУ);
                        ПараметрыПачки.ДокументыВида.Добавить(СтрокаПачки);
                    КонецЦикла;
                    Для Каждого СсылкаДокумента Из ДанныеДоговора.ДокументыРиска Цикл
                        СтрокаПачки = Новый Структура("Ссылка, ДоговорДУ", СсылкаДокумента, ДоговорДУ);
                        ПараметрыПачки.ДокументыРиска.Добавить(СтрокаПачки);
                    КонецЦикла;
                КонецЦикла;

                ОбработатьПачкуДокументов(ПараметрыПачки);

                Обработано = Обработано + ПараметрыПачки.Обработано;
                Успешно = Успешно + ПараметрыПачки.Успешно;
                Ошибок = Ошибок + ПараметрыПачки.Ошибок;
                НомерЗапущеннойПорции = НомерПорции;

                Процент = ?(ВсегоДокументов > 0, Окр(100 * Обработано / ВсегоДокументов), 0);
                ЗаданийВБазе = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборАктивных).Количество();
                ТекстПрогресса = Формат(Процент, "ЧН=0; ЧГ=") + "% * "
                    + Формат(Обработано, "ЧН=0; ЧГ=") + "/" + Формат(ВсегоДокументов, "ЧН=0; ЧГ=") + " док. * потоков 0 / в базе "
                    + Формат(ЗаданийВБазе, "ЧН=0; ЧГ=") + " * порция "
                    + Формат(НомерЗапущеннойПорции, "ЧН=0; ЧГ=") + "/" + Формат(ВсегоПачек, "ЧН=0; ЧГ=");
                Если Процент >= 10 И Обработано > 0 Тогда
                    ПрошлоСек = ТекущаяУниверсальнаяДата() - ВремяСтарта;
                    ОсталосьСек = ПрошлоСек * (ВсегоДокументов - Обработано) / Обработано;
                    Если ОсталосьСек < 60 Тогда
                        ТекстПрогресса = ТекстПрогресса + " * меньше минуты";
                    Иначе
                        Часов = Цел(ОсталосьСек / 3600);
                        Минут = Цел((ОсталосьСек - Часов * 3600) / 60);
                        Если Часов = 0 Тогда
                            ТекстПрогресса = ТекстПрогресса + " * около " + Формат(Макс(Минут, 1), "ЧН=0; ЧГ=") + " мин";
                        Иначе
                            ТекстПрогресса = ТекстПрогресса + " * около " + Формат(Часов, "ЧН=0; ЧГ=")
                                + " ч " + Формат(Минут, "ЧН=0; ЧГ=") + " мин";
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;
                ДлительныеОперации.СообщитьПрогресс(Процент, ТекстПрогресса);
            КонецЦикла;

        Иначе

            МассивЗаданий = Новый Массив;
            РазмерПачкиПоУИД = Новый Соответствие;
            ИндексОчереди = 0;

            Пока ИндексОчереди < Пачки.Количество() Или МассивЗаданий.Количество() > 0 Цикл

                Пока МассивЗаданий.Количество() < КоличествоПотоков И ИндексОчереди < Пачки.Количество() Цикл

                    ДоговорыПачки = Пачки[ИндексОчереди];
                    ИндексОчереди = ИндексОчереди + 1;
                    НомерЗапущеннойПорции = ИндексОчереди;

                    ПараметрыПачки = Новый Структура;
                    ПараметрыПачки.Вставить("ДокументыВида", Новый Массив);
                    ПараметрыПачки.Вставить("ДокументыРиска", Новый Массив);
                    ПараметрыПачки.Вставить("ПроцедураЗаполнения", ПроцедураЗаполнения);
                    ПараметрыПачки.Вставить("ПроцедураЗаполненияРиска", ПроцедураЗаполненияРиска);
                    ПараметрыПачки.Вставить("ФлагРиска", ФлагРиска);
                    ПараметрыПачки.Вставить("Успешно", 0);
                    ПараметрыПачки.Вставить("Ошибок", 0);
                    ПараметрыПачки.Вставить("Обработано", 0);
                    ПараметрыПачки.Вставить("ВернутьИтогСообщением", Истина);

                    ДокументовВПачке = 0;
                    Для Каждого ДоговорДУ Из ДоговорыПачки Цикл
                        ДанныеДоговора = СоответствиеДоговоров.Получить(ДоговорДУ);
                        Для Каждого СсылкаДокумента Из ДанныеДоговора.ДокументыВида Цикл
                            СтрокаПачки = Новый Структура("Ссылка, ДоговорДУ", СсылкаДокумента, ДоговорДУ);
                            ПараметрыПачки.ДокументыВида.Добавить(СтрокаПачки);
                            ДокументовВПачке = ДокументовВПачке + 1;
                        КонецЦикла;
                        Для Каждого СсылкаДокумента Из ДанныеДоговора.ДокументыРиска Цикл
                            СтрокаПачки = Новый Структура("Ссылка, ДоговорДУ", СсылкаДокумента, ДоговорДУ);
                            ПараметрыПачки.ДокументыРиска.Добавить(СтрокаПачки);
                            ДокументовВПачке = ДокументовВПачке + 1;
                        КонецЦикла;
                    КонецЦикла;

                    ИмяВоркера = "Обработки.ГрупповоеПерезаполнениеДокументов.ОбработатьПачкуДокументов";
                    ПараметрыМетода = Новый Массив;
                    ПараметрыМетода.Добавить(ПараметрыПачки);

                    ВсеПараметры = Новый Структура;
                    ВсеПараметры.Вставить("ИмяПроцедуры", ИмяВоркера);
                    ВсеПараметры.Вставить("ПараметрыПроцедуры", ПараметрыМетода);

                    ПараметрыЗадания = Новый Массив;
                    ПараметрыЗадания.Добавить(ВсеПараметры);

                    КлючЗадания = "IM1109261_" + Формат(НомерЗапущеннойПорции, "ЧН=0; ЧГ=")
                        + "_" + Строка(Новый УникальныйИдентификатор);
                    НаименованиеЗадания = НСтр("ru='Групповое перезаполнение, порция '")
                        + Формат(НомерЗапущеннойПорции, "ЧН=0; ЧГ=");

                    ТекЗадание = ФоновыеЗадания.Выполнить(
                        "ДлительныеОперации.ВыполнитьСКонтекстомКлиента",
                        ПараметрыЗадания,
                        КлючЗадания,
                        НаименованиеЗадания);

                    МассивЗаданий.Добавить(ТекЗадание);
                    РазмерПачкиПоУИД.Вставить(ТекЗадание.УникальныйИдентификатор, ДокументовВПачке);

                КонецЦикла;

                Если МассивЗаданий.Количество() = 0 Тогда
                    Прервать;
                КонецЕсли;

                МассивЗаданий = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(МассивЗаданий, 5);

                ЖивыеЗадания = Новый Массив;
                Для Каждого ТекЗадание Из МассивЗаданий Цикл

                    АктуальноеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
                        ТекЗадание.УникальныйИдентификатор);
                    Если АктуальноеЗадание = Неопределено Тогда
                        РазмерПачки = РазмерПачкиПоУИД.Получить(ТекЗадание.УникальныйИдентификатор);
                        Если РазмерПачки = Неопределено Тогда
                            РазмерПачки = 0;
                        КонецЕсли;
                        Обработано = Обработано + РазмерПачки;
                        Успешно = Успешно + РазмерПачки;
                        Продолжить;
                    КонецЕсли;

                    Если АктуальноеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
                        ЖивыеЗадания.Добавить(АктуальноеЗадание);
                        Продолжить;
                    КонецЕсли;

                    РазмерПачки = РазмерПачкиПоУИД.Получить(АктуальноеЗадание.УникальныйИдентификатор);
                    Если РазмерПачки = Неопределено Тогда
                        РазмерПачки = 0;
                    КонецЕсли;

                    ИтогУспешно = Неопределено;
                    ИтогОшибок = Неопределено;
                    ИтогОбработано = Неопределено;

                    МассивСообщений = АктуальноеЗадание.ПолучитьСообщенияПользователю(Истина);
                    Если МассивСообщений <> Неопределено Тогда
                        Для Каждого ТекСообщение Из МассивСообщений Цикл
                            ТекстСообщения = ТекСообщение.Текст;
                            Если СтрНачинаетсяС(ТекстСообщения, "IM1109261_ИТОГ:") Тогда
                                ЧастиИтога = СтрРазделить(Сред(ТекстСообщения, СтрДлина("IM1109261_ИТОГ:") + 1), ";");
                                Для Каждого ЧастьИтога Из ЧастиИтога Цикл
                                    Если СтрНачинаетсяС(ЧастьИтога, "Успешно=") Тогда
                                        ИтогУспешно = Число(Сред(ЧастьИтога, СтрДлина("Успешно=") + 1));
                                    ИначеЕсли СтрНачинаетсяС(ЧастьИтога, "Ошибок=") Тогда
                                        ИтогОшибок = Число(Сред(ЧастьИтога, СтрДлина("Ошибок=") + 1));
                                    ИначеЕсли СтрНачинаетсяС(ЧастьИтога, "Обработано=") Тогда
                                        ИтогОбработано = Число(Сред(ЧастьИтога, СтрДлина("Обработано=") + 1));
                                    КонецЕсли;
                                КонецЦикла;
                            Иначе
                                ТекСообщение.Сообщить();
                            КонецЕсли;
                        КонецЦикла;
                    КонецЕсли;

                    Если АктуальноеЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
                        ТекстОшибки = НСтр("ru='Не удалось выполнить порцию перезаполнения. '")
                            + ПодробноеПредставлениеОшибки(АктуальноеЗадание.ИнформацияОбОшибке);
                        Сообщение = Новый СообщениеПользователю;
                        Сообщение.Текст = ТекстОшибки;
                        Сообщение.Сообщить();
                        ЗаписьЖурналаРегистрации(
                            "ГрупповоеПерезаполнениеДокументов",
                            УровеньЖурналаРегистрации.Ошибка,
                            ,
                            ,
                            ТекстОшибки);
                        Обработано = Обработано + РазмерПачки;
                        Ошибок = Ошибок + РазмерПачки;
                    Иначе
                        Если ИтогОбработано = Неопределено Тогда
                            ИтогОбработано = РазмерПачки;
                        КонецЕсли;
                        Если ИтогОшибок = Неопределено Тогда
                            ИтогОшибок = 0;
                        КонецЕсли;
                        Если ИтогУспешно = Неопределено Тогда
                            ИтогУспешно = ИтогОбработано - ИтогОшибок;
                        КонецЕсли;
                        Обработано = Обработано + ИтогОбработано;
                        Успешно = Успешно + ИтогУспешно;
                        Ошибок = Ошибок + ИтогОшибок;
                    КонецЕсли;

                КонецЦикла;

                МассивЗаданий = ЖивыеЗадания;

                Процент = ?(ВсегоДокументов > 0, Окр(100 * Обработано / ВсегоДокументов), 0);
                ЗаданийВБазе = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборАктивных).Количество();
                ТекстПрогресса = Формат(Процент, "ЧН=0; ЧГ=") + "% * "
                    + Формат(Обработано, "ЧН=0; ЧГ=") + "/" + Формат(ВсегоДокументов, "ЧН=0; ЧГ=") + " док. * потоков "
                    + Формат(МассивЗаданий.Количество(), "ЧН=0; ЧГ=") + " / в базе "
                    + Формат(ЗаданийВБазе, "ЧН=0; ЧГ=") + " * порция "
                    + Формат(НомерЗапущеннойПорции, "ЧН=0; ЧГ=") + "/" + Формат(ВсегоПачек, "ЧН=0; ЧГ=");
                Если Процент >= 10 И Обработано > 0 Тогда
                    ПрошлоСек = ТекущаяУниверсальнаяДата() - ВремяСтарта;
                    ОсталосьСек = ПрошлоСек * (ВсегоДокументов - Обработано) / Обработано;
                    Если ОсталосьСек < 60 Тогда
                        ТекстПрогресса = ТекстПрогресса + " * меньше минуты";
                    Иначе
                        Часов = Цел(ОсталосьСек / 3600);
                        Минут = Цел((ОсталосьСек - Часов * 3600) / 60);
                        Если Часов = 0 Тогда
                            ТекстПрогресса = ТекстПрогресса + " * около " + Формат(Макс(Минут, 1), "ЧН=0; ЧГ=") + " мин";
                        Иначе
                            ТекстПрогресса = ТекстПрогресса + " * около " + Формат(Часов, "ЧН=0; ЧГ=")
                                + " ч " + Формат(Минут, "ЧН=0; ЧГ=") + " мин";
                        КонецЕсли;
                    КонецЕсли;
                КонецЕсли;
                ДлительныеОперации.СообщитьПрогресс(Процент, ТекстПрогресса);

            КонецЦикла;

        КонецЕсли;

        Результат.Успешно = Успешно;
        Результат.Ошибок = Ошибок;

        ЗатраченоСек = ТекущаяУниверсальнаяДата() - ВремяСтарта;
        МинутЗатрачено = Цел(ЗатраченоСек / 60);
        СекундЗатрачено = ЗатраченоСек - МинутЗатрачено * 60;
        ТекстВремени = СтрШаблон(
            НСтр("ru='%1 мин %2 сек'"),
            Формат(МинутЗатрачено, "ЧН=0; ЧГ="),
            Формат(СекундЗатрачено, "ЧН=0; ЧГ="));

        Если ФлагРиска Тогда
            ТекстСводки = СтрШаблон(
                НСтр("ru='Перезаполнение завершено. Вид: %1. Документов: %2, из них риск: %3. Договоров: %4. Успешно: %5, с ошибкой: %6. Потоков: %7. Затрачено: %8.'"),
                ВидДокумента,
                Формат(ВсегоДокументов, "ЧН=0; ЧГ="),
                Формат(ВсегоДокументовРиска, "ЧН=0; ЧГ="),
                Формат(ВсегоДоговоров, "ЧН=0; ЧГ="),
                Формат(Успешно, "ЧН=0; ЧГ="),
                Формат(Ошибок, "ЧН=0; ЧГ="),
                Формат(КоличествоПотоков, "ЧН=0; ЧГ="),
                ТекстВремени);
        Иначе
            ТекстСводки = СтрШаблон(
                НСтр("ru='Перезаполнение завершено. Вид: %1. Документов: %2. Договоров: %3. Успешно: %4, с ошибкой: %5. Потоков: %6. Затрачено: %7.'"),
                ВидДокумента,
                Формат(ВсегоДокументов, "ЧН=0; ЧГ="),
                Формат(ВсегоДоговоров, "ЧН=0; ЧГ="),
                Формат(Успешно, "ЧН=0; ЧГ="),
                Формат(Ошибок, "ЧН=0; ЧГ="),
                Формат(КоличествоПотоков, "ЧН=0; ЧГ="),
                ТекстВремени);
        КонецЕсли;
        Результат.ТекстСводки = ТекстСводки;

        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = ТекстСводки;
        Сообщение.Сообщить();

        КомментарийЗамера = СтрШаблон(
            НСтр("ru='Вид=%1; Договоров=%2; Документов=%3; Риск=%4; Потоков=%5; Успешно=%6; Ошибок=%7; Порция=%8'"),
            ВидДокумента,
            Формат(ВсегоДоговоров, "ЧН=0; ЧГ="),
            Формат(ВсегоДокументов, "ЧН=0; ЧГ="),
            ?(ФлагРиска, "Да", "Нет"),
            Формат(КоличествоПотоков, "ЧН=0; ЧГ="),
            Формат(Успешно, "ЧН=0; ЧГ="),
            Формат(Ошибок, "ЧН=0; ЧГ="),
            Формат(РазмерПорции, "ЧН=0; ЧГ="));

        ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(
            ОписаниеЗамера,
            ВсегоДокументов,
            "",
            КомментарийЗамера);

    Исключение

        ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Результат.ТекстСводки = НСтр("ru='Ошибка группового перезаполнения: '") + ТекстОшибки;
        ЗаписьЖурналаРегистрации(
            "ГрупповоеПерезаполнениеДокументов",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            ТекстОшибки);

        КомментарийЗамера = СтрШаблон(
            НСтр("ru='Вид=%1; Договоров=; Документов=; Риск=; Потоков=; Успешно=; Ошибок=1; Порция='"),
            Результат.ВидДокумента);
        ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(
            ОписаниеЗамера,
            1,
            "",
            КомментарийЗамера);

        ВызватьИсключение;

    КонецПопытки;

    ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

// Описание: Воркер пачки: по каждому договору сначала документы основного вида,
// затем контроль риска того же договора. Заполнение через Выполнить, как в типовой обработке.
//
// Параметры:
// ПараметрыПачки - Структура - массивы документов вида и риска, строки процедур заполнения, счетчики итога
//
Процедура ОбработатьПачкуДокументов(ПараметрыПачки) Экспорт

    ПроцедураЗаполнения = ПараметрыПачки.ПроцедураЗаполнения;
    ПроцедураЗаполненияРиска = ПараметрыПачки.ПроцедураЗаполненияРиска;
    ФлагРиска = ПараметрыПачки.ФлагРиска;

    СоответствиеДоговоров = Новый Соответствие;
    ПорядокДоговоров = Новый Массив;

    Для Каждого СтрокаДокумента Из ПараметрыПачки.ДокументыВида Цикл
        ДанныеДоговора = СоответствиеДоговоров.Получить(СтрокаДокумента.ДоговорДУ);
        Если ДанныеДоговора = Неопределено Тогда
            ДанныеДоговора = Новый Структура("ДокументыВида, ДокументыРиска, ЕстьОшибкаВида",
                Новый Массив, Новый Массив, Ложь);
            СоответствиеДоговоров.Вставить(СтрокаДокумента.ДоговорДУ, ДанныеДоговора);
            ПорядокДоговоров.Добавить(СтрокаДокумента.ДоговорДУ);
        КонецЕсли;
        ДанныеДоговора.ДокументыВида.Добавить(СтрокаДокумента.Ссылка);
    КонецЦикла;

    Если ФлагРиска Тогда
        Для Каждого СтрокаДокумента Из ПараметрыПачки.ДокументыРиска Цикл
            ДанныеДоговора = СоответствиеДоговоров.Получить(СтрокаДокумента.ДоговорДУ);
            Если ДанныеДоговора = Неопределено Тогда
                ДанныеДоговора = Новый Структура("ДокументыВида, ДокументыРиска, ЕстьОшибкаВида",
                    Новый Массив, Новый Массив, Ложь);
                СоответствиеДоговоров.Вставить(СтрокаДокумента.ДоговорДУ, ДанныеДоговора);
                ПорядокДоговоров.Добавить(СтрокаДокумента.ДоговорДУ);
            КонецЕсли;
            ДанныеДоговора.ДокументыРиска.Добавить(СтрокаДокумента.Ссылка);
        КонецЦикла;
    КонецЕсли;

    Успешно = 0;
    Ошибок = 0;
    Обработано = 0;

    Для Каждого ДоговорДУ Из ПорядокДоговоров Цикл

        ДанныеДоговора = СоответствиеДоговоров.Получить(ДоговорДУ);

        Для Каждого СсылкаДокумента Из ДанныеДоговора.ДокументыВида Цикл
            Обработано = Обработано + 1;
            Если ПерезаполнитьДокументПачки(СсылкаДокумента, ПроцедураЗаполнения) Тогда
                Успешно = Успешно + 1;
            Иначе
                Ошибок = Ошибок + 1;
                ДанныеДоговора.ЕстьОшибкаВида = Истина;
            КонецЕсли;
        КонецЦикла;

        Если ФлагРиска И Не ДанныеДоговора.ЕстьОшибкаВида Тогда
            Для Каждого СсылкаДокумента Из ДанныеДоговора.ДокументыРиска Цикл
                Обработано = Обработано + 1;
                Если ПерезаполнитьДокументПачки(СсылкаДокумента, ПроцедураЗаполненияРиска) Тогда
                    Успешно = Успешно + 1;
                Иначе
                    Ошибок = Ошибок + 1;
                КонецЕсли;
            КонецЦикла;
        ИначеЕсли ФлагРиска И ДанныеДоговора.ЕстьОшибкаВида Тогда
            Обработано = Обработано + ДанныеДоговора.ДокументыРиска.Количество();
        КонецЕсли;

    КонецЦикла;

    ПараметрыПачки.Успешно = Успешно;
    ПараметрыПачки.Ошибок = Ошибок;
    ПараметрыПачки.Обработано = Обработано;

    ВернутьИтогСообщением = Ложь;
    Если ПараметрыПачки.Свойство("ВернутьИтогСообщением") Тогда
        ВернутьИтогСообщением = ПараметрыПачки.ВернутьИтогСообщением;
    КонецЕсли;
    Если ВернутьИтогСообщением Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "IM1109261_ИТОГ:Успешно=" + Формат(Успешно, "ЧН=0; ЧГ=")
            + ";Ошибок=" + Формат(Ошибок, "ЧН=0; ЧГ=")
            + ";Обработано=" + Формат(Обработано, "ЧН=0; ЧГ=");
        Сообщение.Сообщить();
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Заполняет и записывает один документ пачки той же схемой, что типовая ПереполнитьДокументы.
//
// Параметры:
// СсылкаДокумента - ДокументСсылка - документ для перезаполнения
// ПроцедураЗаполнения - Строка - вызов метода объекта со скобками, например ПолучитьСуммыРСАСЧА()
//
// Возвращаемое значение:
// Булево - Истина, если заполнение и запись выполнены без ошибки
//
Функция ПерезаполнитьДокументПачки(СсылкаДокумента, ПроцедураЗаполнения)

    ДокументОбъект = Неопределено;

    Попытка
        ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
        Выполнить("ДокументОбъект." + ПроцедураЗаполнения);
        Если ДокументОбъект.Проведен Тогда
            ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
        Иначе
            ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
        КонецЕсли;
        Возврат Истина;
    Исключение
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = НСтр("ru = 'Не удалось перезаполнить документ '") + СсылкаДокумента
            + НСтр("ru = 'по причине '") + ОписаниеОшибки() + ".";
        Если ДокументОбъект <> Неопределено Тогда
            Сообщение.УстановитьДанные(ДокументОбъект);
        КонецЕсли;
        Сообщение.Сообщить();
        Возврат Ложь;
    КонецПопытки;

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
