// IMDEV-9153: подсчёт ошибок начисления волны из результатов пачек + проверка аварийного завершения ФЗ.
// Неполученный результат сам по себе НЕ считается ошибкой (данные могли не дойти через хранилище);
// ошибкой считаем только аварийно завершившиеся задания.
//
// Возвращаемое значение:
//  Число - количество ошибок начисления в волне
//
Функция СобратьОшибкиВолны(ОписанияФоновыхЗаданий)

	ОшибокВолны = 0;

	Для Каждого ОписаниеФЗ Из ОписанияФоновыхЗаданий Цикл

		Задание = ОписаниеФЗ.Задание;
		Попытка
			Если Задание <> Неопределено Тогда
				АктуальноеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Задание.УникальныйИдентификатор);
				Если АктуальноеЗадание <> Неопределено Тогда
					Задание = АктуальноеЗадание;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// оставляем исходный объект задания
		КонецПопытки;

		АварийноеЗавершение = (Задание <> Неопределено
			И Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно);

		Если АварийноеЗавершение Тогда
			ТекстАварии = "аварийное завершение фонового задания";
			Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
				ТекстАварии = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
			КонецЕсли;
			ОшибокВолны = ОшибокВолны + ОписаниеФЗ.КоличествоДоговоров;
			Лог(УровеньЖурналаРегистрации.Ошибка,
				"Пачка " + Формат(ОписаниеФЗ.НомерПачки, "ЧГ=0") + ": " + ТекстАварии);
			Продолжить;
		КонецЕсли;

		ИтогПачки = Неопределено;
		Если ЭтоАдресВременногоХранилища(ОписаниеФЗ.АдресРезультата) Тогда
			ИтогПачки = ПолучитьИзВременногоХранилища(ОписаниеФЗ.АдресРезультата);
		КонецЕсли;

		Если ТипЗнч(ИтогПачки) = Тип("Структура") Тогда
			ОшибокВолны = ОшибокВолны + ИтогПачки.ОшибокДоговоров;
			Если Не ПустаяСтрока(ИтогПачки.ТекстОшибки) Тогда
				ОшибокВолны = ОшибокВолны + ОписаниеФЗ.КоличествоДоговоров;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат ОшибокВолны;

КонецФункции

