// IMDEV-9153: краткая сводка итогов (для формы / письма) — только счётчики, без детализации.
//
// Параметры:
//  ВсегоДоговоров   - Число - всего договоров в ТЧ
//  КоличествоПачек  - Число - число пачек (фонов)
//  ОшибокНачисления - Число - суммарно ошибок начисления
//  РезультатыУдаления - Структура - Всего, Успешно, СОшибками (Фаза 2)
//  ДлительностьСек  - Число - общее время выполнения, секунд
//
Функция СформироватьТекстСводки(ВсегоДоговоров, КоличествоПачек, ОшибокНачисления, РезультатыУдаления, ДлительностьСек = 0)

	Строки = Новый Массив;
	Строки.Добавить("Начисление ВУК РДУ (параллельно).");
	Строки.Добавить("Договоров: " + Формат(ВсегоДоговоров, "ЧН=0; ЧГ=0")
		+ "; пачек: " + Формат(КоличествоПачек, "ЧН=0; ЧГ=0")
		+ "; ошибок начисления: " + Формат(ОшибокНачисления, "ЧН=0; ЧГ=0") + ".");
	Строки.Добавить("Удалено документов ОперацияБух: " + Формат(РезультатыУдаления.Успешно, "ЧН=0; ЧГ=0")
		+ " из " + Формат(РезультатыУдаления.Всего, "ЧН=0; ЧГ=0")
		+ "; ошибок удаления: " + Формат(РезультатыУдаления.СОшибками, "ЧН=0; ЧГ=0") + ".");
	Строки.Добавить("Затрачено времени: " + ПредставлениеДлительности(ДлительностьСек) + ".");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// IMDEV-9153: человекочитаемое представление длительности (чч:мм:сс) для сводки/письма.
//
// Параметры:
//  ДлительностьСек - Число - длительность в секундах
//
// Возвращаемое значение:
//  Строка - представление вида "0 ч 05 мин 12 сек"
//
Функция ПредставлениеДлительности(ДлительностьСек)

	ВсегоСек = Макс(Цел(ДлительностьСек), 0);
	Часы    = Цел(ВсегоСек / 3600);
	Минуты  = Цел((ВсегоСек - Часы * 3600) / 60);
	Секунды = ВсегоСек - Часы * 3600 - Минуты * 60;

	Возврат Формат(Часы, "ЧН=0; ЧГ=0") + " ч "
		+ Прав("0" + Формат(Минуты, "ЧГ=0"), 2) + " мин "
		+ Прав("0" + Формат(Секунды, "ЧГ=0"), 2) + " сек";

КонецФункции

