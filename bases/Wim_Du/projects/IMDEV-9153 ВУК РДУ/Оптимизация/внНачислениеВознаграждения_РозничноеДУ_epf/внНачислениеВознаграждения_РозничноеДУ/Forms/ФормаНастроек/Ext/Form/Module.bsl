
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкиОбработки = Неопределено;
	Если ТипЗнч(Параметры.НастройкиАлгоритма) = Тип("Структура") тогда
		НастройкиОбработки = Параметры.НастройкиАлгоритма;
	Иначе
		ДопОбработка = Неопределено;
		Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", ДопОбработка) Тогда
			НастройкиОбработки = Справочники.ДополнительныеОтчетыИОбработки.НастройкиОбработки(ДопОбработка);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиОбработки) Тогда
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		ТекОбъект.УстановитьПользовательскиеНастройки(НастройкиОбработки);
		ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Установить(Команда)
	
	Заголовок = "Расчет суммы вознаграждения за управление для Розничного ДУ.";
	ЗначениеВыбора = Новый Структура;
	ЗначениеВыбора.Вставить("Значения", ПодготовитьСтруктуруХранилища());
	ЗначениеВыбора.Вставить("ЗаголовокНастроек", Заголовок);
	
	ОповеститьОВыборе(ЗначениеВыбора);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПодготовитьСтруктуруХранилища()
	
	Значения = Новый Структура;
	Значения.Вставить("СтавкаВознаграждения", Объект.СтавкаВознаграждения);
	Значения.Вставить("Пул", Объект.Пул);
	Значения.Вставить("СчетВознаграждения", Объект.СчетВознаграждения);
	Значения.Вставить("КаталогСохранения", Объект.КаталогСохранения);
	Значения.Вставить("КаталогСохраненияКабинетаДУ", Объект.КаталогСохраненияКабинетаДУ);
	
	// IMDEV-9153: настройки письма об итогах регламентного начисления.
	Значения.Вставить("ОтправлятьПисьмоОбИтогах", Объект.ОтправлятьПисьмоОбИтогах);
	Значения.Вставить("ИгнорироватьПроверкуРегламентнойДаты", Объект.ИгнорироватьПроверкуРегламентнойДаты);
	Значения.Вставить("ПочтовыйЛогин", Объект.ПочтовыйЛогин);
	Значения.Вставить("МаксСтрокВТелеПисьма", Объект.МаксСтрокВТелеПисьма);
	// ТЧ сериализуем в строку (XML хранилища значения) — так надёжно проходит через хранилище настроек.
	Значения.Вставить("СписокРассылки", XMLСтрока(Новый ХранилищеЗначения(Объект.СписокРассылки.Выгрузить())));
	
	Возврат Значения;
	
Конецфункции

#КонецОбласти