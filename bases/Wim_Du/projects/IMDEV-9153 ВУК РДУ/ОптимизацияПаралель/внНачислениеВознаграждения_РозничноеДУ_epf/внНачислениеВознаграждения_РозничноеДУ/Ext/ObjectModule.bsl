Функция КрайняяДатаОбязательств()

	ЗапросДатаВсехВознаграждений = Новый Запрос;
	ЗапросДатаВсехВознаграждений.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ОбязательстваПоДС.Период) КАК ДатаВсехВознаграждений
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС КАК ОбязательстваПоДС
		|ГДЕ
		|	ОбязательстваПоДС.Регистратор ССЫЛКА Документ.ОперацияБух
		|	И ОбязательстваПоДС.Основание.Ссылка ЕСТЬ NULL
		|	И ОбязательстваПоДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)";
	
	РезультатЗапроса = ЗапросДатаВсехВознаграждений.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ДатаВсехВознаграждений = ВыборкаДетальныеЗаписи.ДатаВсехВознаграждений;
	КонецЕсли;
	
	Возврат ДатаВсехВознаграждений;
	
КонецФункции

Функция НачислениеВознаграждения(ДоговорДУ, Расторжение)

	Если Расторжение Тогда
		Начисление = НачислениеВознагражденияРасторжени(ДоговорДУ.ДоговорДУ);
		Комментарий = "Дополнительное вознаграждение";
	Иначе
		Начисление = Документы.НачислениеВознаграждения.СоздатьДокумент();
		Если РежимРасторжения Тогда
			Комментарий = "Вознаграждение за управление при расторжении";
		Иначе
			Комментарий = "";
		КонецЕсли;
	КонецЕсли;
	
	Начисление.Дата = ДатаНачисления + 86100;
	Начисление.ДоговорДУ = ДоговорДУ.ДоговорДУ;
	Начисление.ДоговорКонтрагента = ДоговорДУ.ДоговорВознаграждения;
	Начисление.Контрагент = ДоговорДУ.УК;
	
	Начисление.УстановитьНовыйНомер();
	
	Начисление.Розница = Истина;
	Начисление.СпособНачисленияВознаграждения = Перечисления.СпособНачисленияВознаграждения.ФиксированнаяСумма;
	Начисление.СчетКонтрагента = СчетВознаграждения;
	Начисление.ВалютаДокумента = Справочники.Валюты.RUB;
	Начисление.ВалютаОплаты = Справочники.Валюты.RUB;
	Начисление.Курс = 1;
	Начисление.Кратность = 1;
	Начисление.ВидКонтрагента = Перечисления.ВидыОбязательныхКонтрагентов.УправляющаяКомпания;
	Начисление.СтатьяЗатрат = Справочники.СтатьиДоходовИРасходов.ВознаграждениеУК;
	Начисление.СуммаВознаграждения 
			= ?(Расторжение, ДоговорДУ.СуммаУдержанияПриРасторжении, ДоговорДУ.СуммаВознаграждения);
	Начисление.СуммаДокумента = ?(Расторжение, ДоговорДУ.СуммаУдержанияПриРасторжении, ДоговорДУ.СуммаВознаграждения);
	Начисление.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.РасчетВознаграждениеУКЗаУправление;
	Начисление.Комментарий = Комментарий;
	
	Попытка
		
		Начисление.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		
	Исключение
	
	КонецПопытки;
	
	Возврат Начисление.Ссылка;

КонецФункции

Функция НачислениеВознагражденияРасторжени(ДоговорДУ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеВознаграждения.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.НачислениеВознаграждения КАК НачислениеВознаграждения
		|ГДЕ
		|	НачислениеВознаграждения.ДоговорДУ = &ДоговорДУ
		|	И НЕ НачислениеВознаграждения.ПометкаУдаления
		|	И НачислениеВознаграждения.Розница
		|	И НачислениеВознаграждения.Комментарий = ""Дополнительное вознаграждение""";
	
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Возврат Документы.НачислениеВознаграждения.СоздатьДокумент();

КонецФункции

Процедура ФормироватьСправкуРасчет(ДоговорДУ, Расторжение)
	
	СтруктураПоказателей = ПоказателиСправки();
	
	СтруктураПоказателей.ДоговорДУ = ДоговорДУ.ДоговорДУ;
	ДатаНомерДоговораДУ = "" + ДоговорДУ.Код + " от " 
								+ Формат(ДоговорДУ.ДатаНачала, "ДФ='dd MMMM yyyy'") + "г.";
								
	СтруктураПоказателей.ДатаНомерДоговораДУ = ДатаНомерДоговораДУ;
	СтруктураПоказателей.Заявление = "к Заявлению о присоединении № " + ДатаНомерДоговораДУ;
	
	ДатаРасчета = ?(ДоговорДУ.Расторжение, ДоговорДУ.ДатаРасторжения, ДатаНачисления);
	СтруктураПоказателей.ПериодРасчета = "с " + Формат(НачалоКвартала(ДатаРасчета), "ДФ='dd MMMM yyyy'") + "г."
			+ " по " + Формат(ДатаРасчета, "ДФ='dd MMMM yyyy'") + "г.";
			
	СтруктураПоказателей.ИмяФайла = ИмяФайла(ДоговорДУ.ДоговорДУ);
	
	СтруктураПоказателей.НачалоРасчета = НачалоКвартала(ДатаРасчета);
	СтруктураПоказателей.ОкончаниеРасчета = ДатаРасчета;
	СтруктураПоказателей.СрокДоговора = ДоговорДУ.СрокДоговора;
	
	СтруктураПоказателей.СтавкаВознаграждения = СтавкаВознаграждения;
	СтруктураПоказателей.СуммаВознаграждения = ДоговорДУ.СуммаВознаграждения;
	СтруктураПоказателей.СуммаВознагражденияВесьСрок = ДоговорДУ.СуммаВознагражденияВесьСрок;
	
	СтруктураПоказателей.СуммаИнвестиций = ДоговорДУ.СуммаИнвестиций;
	СтруктураПоказателей.СуммаПоледующегоВознаграждения = 0;
	СтруктураПоказателей.СуммаУдержанногоВознаграждения = ДоговорДУ.СуммаУдержанияПриРасторжении;
	
	СправкаРасчет = СправкаРасчет(СтруктураПоказателей);
	
	ПутьСохранения = ПутьСохранения(Расторжение, КаталогСохранения);
	
	Если ПутьСохранения <> Неопределено Тогда
		СохранитьНаДиск(СправкаРасчет, ПутьСохранения);
	КонецЕсли;
	
	Если Не ПустаяСтрока(КаталогСохраненияКабинетаДУ) Тогда
		ФайлКаталогаКабинета = Новый Файл(КаталогСохраненияКабинетаДУ);
		Если Не ФайлКаталогаКабинета.Существует() Тогда
			Если Не СоздатьКаталогДляСохранения(КаталогСохраненияКабинетаДУ) Тогда
				ВызватьИсключение "Не удалось создать каталог сохранения кабинета ДУ: "
					+ КаталогСохраненияКабинетаДУ;
			КонецЕсли;
		КонецЕсли;
		СохранитьНаДиск(СправкаРасчет, КаталогСохраненияКабинетаДУ + "\");
	КонецЕсли;

КонецПроцедуры
	
// Описание: Находит ОперацияБух-регистраторы обязательств по договору и удаляет их
// через УдалитьОперациюОбязательства (пустой набор РН + Удалить с ОбменДанными.Загрузка).
//
// Параметры:
//  ДоговорДУ - СправочникСсылка.ДоговорыДУ - договор для поиска движений
//  Расторжение - Булево - Истина: без отбора по минимальному периоду
//
Процедура УдалитьОбязательствоДС(ДоговорДУ, Расторжение)

	Запрос = Новый Запрос;
	Запрос.Текст = ?(Расторжение, ТекстЗапросаРасторжение(), ТекстЗапроса());
	Запрос.УстановитьПараметр("ДоговорДУ", ДоговорДУ);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		УдалитьОперациюОбязательства(ВыборкаДетальныеЗаписи.Регистратор);
	КонецЦикла;

КонецПроцедуры

// Описание: Очищает ОбязательстваПоДС по регистратору и удаляет документ ОперацияБух.
// С ОбменДанными.Загрузка платформа при Удалить() движения НЕ чистит,
// поэтому сначала пишется пустой набор с Загрузка, затем Удалить с Загрузка.
//
// Параметры:
//  Регистратор - ДокументСсылка.ОперацияБух - удаляемый регистратор обязательств
//
Процедура УдалитьОперациюОбязательства(Регистратор)

	НаборЗаписей = РегистрыНакопления.ОбязательстваПоДС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.Записать();

	ОперацияОбъект = Регистратор.ПолучитьОбъект();
	Если ОперацияОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОперацияОбъект.ОбменДанными.Загрузка = Истина;
	ОперацияОбъект.Удалить();

КонецПроцедуры

Функция ТекстЗапроса()

	Возврат "ВЫБРАТЬ
		|	МИНИМУМ(ОбязательстваПоДС.Период) КАК Период
		|ПОМЕСТИТЬ ВТ_ПериодВознаграждения
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС КАК ОбязательстваПоДС
		|ГДЕ
		|	ОбязательстваПоДС.Регистратор ССЫЛКА Документ.ОперацияБух
		|	И ОбязательстваПоДС.ДоговорДУ = &ДоговорДУ
		|	И ОбязательстваПоДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ОбязательстваПоДС.Основание.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбязательстваПоДС.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС КАК ОбязательстваПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПериодВознаграждения КАК ВТ_ПериодВознаграждения
		|		ПО ОбязательстваПоДС.Период = ВТ_ПериодВознаграждения.Период
		|ГДЕ
		|	ОбязательстваПоДС.Регистратор ССЫЛКА Документ.ОперацияБух
		|	И ОбязательстваПоДС.ДоговорДУ = &ДоговорДУ
		|	И ОбязательстваПоДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ОбязательстваПоДС.Основание.Ссылка ЕСТЬ NULL";

КонецФункции

Функция ТекстЗапросаРасторжение()

	Возврат "ВЫБРАТЬ
		|	ОбязательстваПоДС.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС КАК ОбязательстваПоДС
		|ГДЕ
		|	ОбязательстваПоДС.Регистратор ССЫЛКА Документ.ОперацияБух
		|	И ОбязательстваПоДС.ДоговорДУ = &ДоговорДУ
		|	И ОбязательстваПоДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ОбязательстваПоДС.Основание.Ссылка ЕСТЬ NULL";

КонецФункции

Функция СловоЛет(СрокДействияЛет)

	Если СрокДействияЛет = 1 Тогда
		Возврат " год";
	ИначеЕсли СрокДействияЛет < 5 Тогда
		Возврат " года и 10 дней";
	Иначе
		Возврат " лет";
	КонецЕсли;

КонецФункции

Функция ПутьСохранения(Расторжение, Каталог)

	Если ПустаяСтрока(Каталог) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ФайлКорня = Новый Файл(Каталог);
	Если Не ФайлКорня.Существует() Тогда
		Если Не СоздатьКаталогДляСохранения(Каталог) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	ПутьСохранения = Каталог + "\";
	
	Если Расторжение Тогда
		ФайлОбъект = Новый Файл(ПутьСохранения + "РАСТОРЖЕНИЕ");
		Если Не ФайлОбъект.Существует() Тогда
			Если Не СоздатьКаталогДляСохранения(ПутьСохранения + "РАСТОРЖЕНИЕ") Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		ПутьСохранения = ПутьСохранения + "РАСТОРЖЕНИЕ";
	Иначе
		ФайлОбъект = Новый Файл(ПутьСохранения + "РЕГЛАМЕНТНЫЕ");
		Если Не ФайлОбъект.Существует() Тогда
			Если Не СоздатьКаталогДляСохранения(ПутьСохранения + "РЕГЛАМЕНТНЫЕ") Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		ПутьСохранения = ПутьСохранения + "РЕГЛАМЕНТНЫЕ\";
		ГодПапка = СтрЗаменить(Год(ДатаНачисления), " ", "");
		ФайлОбъект = Новый Файл(ПутьСохранения + ГодПапка);
		Если Не ФайлОбъект.Существует() Тогда
			Если Не СоздатьКаталогДляСохранения(ПутьСохранения + ГодПапка) Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		ПутьСохранения = ПутьСохранения + ГодПапка;
		КварталПапка = Квартал(ДатаНачисления, ГодПапка);
		ФайлОбъект = Новый Файл(ПутьСохранения + "\" + КварталПапка);
		Если Не ФайлОбъект.Существует() Тогда
			Если Не СоздатьКаталогДляСохранения(ПутьСохранения + "\" + КварталПапка) Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		ПутьСохранения = ПутьСохранения + "\" + КварталПапка;
	КонецЕсли;

	Возврат ПутьСохранения + "\";

КонецФункции

Функция СоздатьКаталогДляСохранения(Путь)

	Результат = Ложь;
	
	Попытка
		СоздатьКаталог(Путь);
		Результат = Истина;
	Исключение
		ИмяСобытия = "Создание каталога для сохранения расчетов вознаграждения по РДУ";
		УровеньСобытия = УровеньЖурналаРегистрации.Ошибка;
		Комментарий = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньСобытия,,, Комментарий);
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

Функция Квартал(ПоДате, Год)

	Если Не КонецДня(ПоДате) = КонецКвартала(ПоДате) Тогда
		ПоДате = НачалоКвартала(ПоДате) - 1;
	КонецЕсли;
	НомерКвартала = Цел((Месяц(ПоДате) - 1) / 3) + 1;
	
	Возврат Строка(НомерКвартала) + " кв " + Год;

КонецФункции

Функция СправкаРасчет(СтруктураПоказателей)
	
	ТабДокументШапка = Новый ТабличныйДокумент;
	ТабДокументТело = Новый ТабличныйДокумент;
	ТабДокументПодвал = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("СправкаРасчет");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьТаблицаСтрока = Макет.ПолучитьОбласть("СтрокиТаблицы");
	ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	ОбластьЗаголовок.Параметры.Заявление = СтруктураПоказателей.Заявление;
	ОбластьЗаголовок.Параметры.ПериодРасчета = СтруктураПоказателей.ПериодРасчета;
	
	ТабДокументШапка.Вывести(ОбластьЗаголовок);
	
	ТабДокументТело.Вывести(ОбластьШапкаТаблицы);
	
	ОбластьТаблицаСтрока.Параметры.Заполнить(СтруктураПоказателей);
	ТабДокументТело.Вывести(ОбластьТаблицаСтрока);
	
	СуммаИтог = Формат(СтруктураПоказателей.СуммаВознаграждения, "ЧДЦ=2; ЧН=0,00") + " ("
			+ РаботаСКурсамиВалют.СформироватьСуммуПрописью(ОКР(СтруктураПоказателей.СуммаВознаграждения, 2),
								ОбщегоНазначенияДУ.ВалютаРеглУчета(СтруктураПоказателей.ДоговорДУ), ЛОЖЬ) + ")";
	
	
	//ОбластьПодвал.Параметры.ПериодРасчета = СтруктураПоказателей.ПериодРасчета;
	//
	//ОбластьПодвал.Параметры.СуммаВознаграждения = СтруктураПоказателей.СуммаВознаграждения;
	//ОбластьПодвал.Параметры.СуммаВознагражденияПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ОКР(СтруктураПоказателей.СуммаВознаграждения, 2), Справочники.Валюты.RUB, ЛОЖЬ);
	//
	//ОбластьПодвал.Параметры.Клиент = "Клиент: " + СтруктураПоказателей.ДоговорДУ.Клиент.НаименованиеПолное;
	//ОбластьПодвал.Параметры.Управляющий = "Управляющий: " 
	//								+ СокрЛП(СтруктураПоказателей.ДоговорДУ.УправляющаяКомпания.НаименованиеПолное)
	//								+ Символы.ПС + ПолучитьПодписанта(СтруктураПоказателей.ДоговорДУ.УправляющаяКомпания);
	//
	ТабДокументПодвал.Вывести(ОбластьПодвал);
	
	Возврат Новый Структура("ШапкаРасчет, ТелоРасчет, ПодвалРасчет, НачалоПериода, ОкончаниеПериода, ИмяФайла",
					ТабДокументШапка, ТабДокументТело, ТабДокументПодвал, 
					СтруктураПоказателей.НачалоРасчета, СтруктураПоказателей.ОкончаниеРасчета, СтруктураПоказателей.ИмяФайла);

КонецФункции

Функция ИмяФайла(ДоговорДУ)

	КодКлиент = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорДУ, "Код, Клиент");
	IDКлиента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КодКлиент.Клиент, "ВнешнийIDДляЛК");
	
	Возврат "AM" + СтрЗаменить(IDКлиента, " ", "") + "-ДУ " + КодКлиент.Код + " (" + КодКлиент.Код + ")";

КонецФункции

Процедура СохранитьНаДиск(СправкаРасчет, ПутьСохранения)

	Т = Новый ТабличныйДокумент;
	Т.Вывести(СправкаРасчет.ШапкаРасчет);
	Т.Вывести(СправкаРасчет.ТелоРасчет);
	Т.Вывести(СправкаРасчет.ПодвалРасчет);
	
	Т.Записать(ПутьСохранения + СправкаРасчет.ИмяФайла + ".pdf", ТипФайлаТабличногоДокумента.PDF );

КонецПроцедуры

Функция ПолучитьПодписанта(УК)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	КонтактныеЛица.Ссылка
	               |ИЗ
	               |	Справочник.КонтактныеЛица КАК КонтактныеЛица
	               |ГДЕ
	               |	КонтактныеЛица.Владелец = &УК
	               |	И КонтактныеЛица.ПометкаУдаления = ЛОЖЬ
	               |	И КонтактныеЛица.Роль = &Роль";
	
	Запрос.УстановитьПараметр("УК", УК);
	Запрос.УстановитьПараметр("Роль", Справочники.РолиКонтактныхЛиц.РуководительПодразделения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Ссылка.Должность) + ": " + Выборка.Ссылка.Фамилия + " " + Лев(Выборка.Ссылка.Имя, 1) + "." + Лев(Выборка.Ссылка.Отчество, 1) + ".";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция БлижайшийРабочийДень(ДатаДня, Предыдущий = Ложь)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	" + ?(Предыдущий, "МАКСИМУМ", "МИНИМУМ") + "(КалендарныеГрафики.ДатаГрафика) КАК ДатаГрафика
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
		|ГДЕ
		|	КалендарныеГрафики.ДатаГрафика " + ?(Предыдущий, "<", ">=") + " НАЧАЛОПЕРИОДА(&ДатаДня, ДЕНЬ)
		|	И КалендарныеГрафики.ДеньВключенВГрафик
		|	И КалендарныеГрафики.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.РегламентированныйКалендарь)";
	
	Запрос.УстановитьПараметр("ДатаДня", ДатаДня);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ДатаГрафика;
	КонецЕсли;
	
	Возврат ДатаДня;
	
КонецФункции

