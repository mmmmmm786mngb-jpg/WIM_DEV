
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем ИдентификаторКомандыДляЗамера; // IMDEV-8927 / IMDEV-9153: контур для имени ключевой операции

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	Структура = Новый Структура;
	Структура.Вставить("Вид", ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка());
	Структура.Вставить("Наименование", "Начисление вознаграждения за управление: Розничное ДУ");
	Структура.Вставить("Версия", "2.19"); // IMDEV-9153
	Структура.Вставить("БезопасныйРежим", Ложь);
	Структура.Вставить("Информация", "");

	Команды = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(
		Команды, 
		"Начисление вознаграждения за управление: Розничное ДУ",
		"НачислениеВознагражденияЗаУправлениеРозничноеДУ",
		"ОткрытиеФормы"
	);
	
	ДобавитьКоманду(
		Команды, 
		"Начисление вознаграждения при расторжении: Розничное ДУ (фоновое)",
		"НачислениеВознагражденияПриРасторженииРозничноеДУФоновое",
		"ВызовСерверногоМетода"
	);
	
	// IMDEV-9153: регламентная команда для запуска по расписанию 4 раза в год (01.01, 01.04, 01.07, 01.10).
	ДобавитьКоманду(
		Команды,
		"Начисление ВУК: Розничное ДУ (регламентное фоновое)",
		"НачислениеВУКРегламентноеФоновое",
		"ВызовСерверногоМетода"
	);

	Структура.Вставить("Команды", Команды);

	Возврат Структура;

КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")

	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;

КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды) <> Тип("Структура") тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда возврат "<Настройки не установлены>"; КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
	
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") Тогда
		// IMDEV-9153: ТЧ СписокРассылки заполняем отдельно (её нельзя копировать через ЗаполнитьЗначенияСвойств).
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки.Значения, , "СписокРассылки");
		Если Настройки.Значения.Свойство("СписокРассылки") Тогда
			ЗагрузитьСписокРассылки(Настройки.Значения.СписокРассылки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	ИдентификаторКомандыДляЗамера = ИдентификаторКоманды;

	Если ИдентификаторКоманды = "НачислениеВознагражденияПриРасторженииРозничноеДУФоновое" Тогда
		ДатаНачисления = НачалоДня(ТекущаяДатаСеанса());
		Если ДатаНачисления = БлижайшийРабочийДень(ДатаНачисления) Тогда

			УстановитьНастройки(ПараметрыВыполненияКоманды);
			РежимРасторжения = Истина;

			ДоговорыКНачислению();
			СоздатьНачисления();

		КонецЕсли;
	ИначеЕсли ИдентификаторКоманды = "НачислениеВУКРегламентноеФоновое" Тогда
		ВыполнитьРегламентноеНачисление(ПараметрыВыполненияКоманды);
	КонецЕсли;

	ИдентификаторКомандыДляЗамера = Неопределено;

КонецПроцедуры

Процедура ДоговорыКНачислению() Экспорт

	ДоговорыДУКНачислению.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СпрДоговорДУ.Ссылка КАК ДоговорДУ,
		|	СпрДоговорДУ.СрокДействия КАК СрокДоговора,
		|	ДоговорыКонтрагентов.Ссылка КАК ДоговорВознаграждения,
		|	СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <> ДАТАВРЕМЯ(1, 1, 1)
		|		И СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <= &ДатаРасчета КАК Расторжение,
		|	ВЫБОР
		|		КОГДА СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <> ДАТАВРЕМЯ(1, 1, 1)
		|				И СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <= &ДатаРасчета
		|			ТОГДА РАЗНОСТЬДАТ(СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ, СпрДоговорДУ.ДатаНачала, ДЕНЬ)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДнейРасторжения,
		|	ВЫБОР
		|		КОГДА ДЕНЬГОДА(КОНЕЦПЕРИОДА(СпрДоговорДУ.ДатаНачала, ГОД)) = 366
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Високосный,
		|	СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ КАК ДатаРасторжения,
		|	КОНЕЦПЕРИОДА(СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ, КВАРТАЛ) КАК КварталРасторжения,
		|	СпрДоговорДУ.УправляющаяКомпания КАК УправляющаяКомпания,
		|	СпрДоговорДУ.Код КАК Код,
		|	СпрДоговорДУ.ДатаНачала КАК ДатаНачала,
		|	РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(СпрДоговорДУ.ДатаВводаСредствВДУ, ГОД, СпрДоговорДУ.СрокДействия), СпрДоговорДУ.ДатаВводаСредствВДУ, ДЕНЬ) КАК СрокОкончанияДней,
		|	ДОБАВИТЬКДАТЕ(СпрДоговорДУ.ДатаВводаСредствВДУ, ГОД, СпрДоговорДУ.СрокДействия) > СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ КАК ДосрочноеРасторжение
		|ПОМЕСТИТЬ ВТ_ДоговорыДУКРасчету
		|ИЗ
		|	Справочник.ДоговорДУ КАК СпрДоговорДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО СпрДоговорДУ.Ссылка = ДоговорыКонтрагентов.ДоговорДУ
		|			И (ДоговорыКонтрагентов.РольДоговора = ЗНАЧЕНИЕ(Перечисление.РолиДоговоровКонтрагента.СоглашениеОВознаграждении))
		|ГДЕ
		|	(НЕ &ОтборПоСписку
		|				И СпрДоговорДУ.Пул = &Пул
		|			ИЛИ &ОтборПоСписку
		|				И СпрДоговорДУ.Ссылка В (&ДоговорыДУ))
		|	И (СпрДоговорДУ.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СпрДоговорДУ.ДатаОкончания > &ДатаРасчета)
		|	И ВЫБОР
		|			КОГДА &РежимРасторжения
		|				ТОГДА СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <> ДАТАВРЕМЯ(1, 1, 1)
		|						И СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ <= &ДатаРасчета
		|						И ДОБАВИТЬКДАТЕ(СпрДоговорДУ.ДатаВводаСредствВДУ, ДЕНЬ, 13) < СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ
		|			ИНАЧЕ СпрДоговорДУ.ДатаПолученияУведомленияОРасторженииДоговораДУ = ДАТАВРЕМЯ(1, 1, 1)
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ХозрасчетныйОбороты.ДоговорДУ КАК ДоговорДУ,
		|	ХозрасчетныйОбороты.СуммаОборот КАК СуммаВознаграждения
		|ПОМЕСТИТЬ ВТ_ВыплаченноеВознаграждение
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|			,
		|			&ДатаРасчета,
		|			,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетВознаграждениеУКЗаУправление),
		|			,
		|			ДоговорДУ В
		|				(ВЫБРАТЬ
		|					ДоговорыДУКРасчету.ДоговорДУ
		|				ИЗ
		|					ВТ_ДоговорыДУКРасчету КАК ДоговорыДУКРасчету),
		|			КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета),
		|			) КАК ХозрасчетныйОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВводыВыводыДУ.ДоговорДУ КАК ДоговорДУ,
		|	СУММА(ВводыВыводыДУ.ВалютнаяСумма) КАК СуммаИнвестиций,
		|	МАКСИМУМ(ВводыВыводыДУ.Период) КАК ДатаВвода
		|ПОМЕСТИТЬ ВТ_ВводВДУ
		|ИЗ
		|	РегистрНакопления.ВводыВыводыДУ КАК ВводыВыводыДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДоговорыДУКРасчету КАК ДоговорыКРАсчету
		|		ПО ВводыВыводыДУ.ДоговорДУ = ДоговорыКРАсчету.ДоговорДУ
		|ГДЕ
		|	ВводыВыводыДУ.Активность
		|	И ВводыВыводыДУ.Сумма > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ВводыВыводыДУ.ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбязательстваПоДСОстатки.ДоговорДУ КАК ДоговорДУ,
		|	СУММА(ОбязательстваПоДСОстатки.ВалютнаяСуммаОстаток) КАК СуммаВознаграждения
		|ПОМЕСТИТЬ ВТ_СуммаВознагражденияДоговорДУ
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС.Остатки(
		|			&ДатаРасчета,
		|			ДоговорДУ В
		|					(ВЫБРАТЬ
		|						ДоговорыКРАсчету.ДоговорДУ
		|					ИЗ
		|						ВТ_ДоговорыДУКРАсчету КАК ДоговорыКРАсчету)
		|				И Основание.Ссылка ЕСТЬ NULL) КАК ОбязательстваПоДСОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ОбязательстваПоДСОстатки.ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбязательстваПоДС.ДоговорДУ КАК ДоговорДУ,
		|	СУММА(ОбязательстваПоДС.ВалютнаяСумма) КАК СуммаВознаграждения
		|ПОМЕСТИТЬ ВТ_СуммаВознагражденияПриРасторженииДоговорДУ
		|ИЗ
		|	РегистрНакопления.ОбязательстваПоДС КАК ОбязательстваПоДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Дог.ДоговорДУ КАК ДоговорДУ,
		|			Дог.КварталРасторжения КАК КварталРасторжения
		|		ИЗ
		|			ВТ_ДоговорыДУКРасчету КАК Дог
		|		ГДЕ
		|			Дог.Расторжение
		|			И Дог.ДосрочноеРасторжение) КАК ДоговорыДУКРАсчету
		|		ПО ОбязательстваПоДС.ДоговорДУ = ДоговорыДУКРАсчету.ДоговорДУ
		|ГДЕ
		|	ОбязательстваПоДС.Основание.Ссылка ЕСТЬ NULL
		|	И ОбязательстваПоДС.Активность
		|	И ДоговорыДУКРАсчету.КварталРасторжения >= ОбязательстваПоДС.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	ОбязательстваПоДС.ДоговорДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорыДУКРасчету.ДоговорДУ КАК ДоговорДУ,
		|	ВЫБОР
		|		КОГДА ДоговорыДУКРасчету.Расторжение
		|			ТОГДА ЕСТЬNULL(СуммаВознагражденияПриРасторженииДоговорДУ.СуммаВознаграждения, 0)
		|		ИНАЧЕ СуммаВознагражденияДоговорДУ.СуммаВознаграждения
		|	КОНЕЦ КАК СуммаВознаграждения,
		|	ВЫБОР
		|		КОГДА ДоговорыДУКРасчету.Расторжение
		|				И ДоговорыДУКРасчету.ДосрочноеРасторжение
		|			ТОГДА ВводВДУ.СуммаИнвестиций / 100 * ВЫБОР
		|					КОГДА ВЫБОР
		|							КОГДА ДоговорыДУКРасчету.Високосный
		|								ТОГДА ДоговорыДУКРасчету.ДнейРасторжения < 366
		|							ИНАЧЕ ДоговорыДУКРасчету.ДнейРасторжения < 365
		|						КОНЕЦ
		|						ТОГДА 3
		|					КОГДА ДоговорыДУКРасчету.ДнейРасторжения < 720
		|						ТОГДА 2
		|					КОГДА ДоговорыДУКРасчету.ДнейРасторжения >= ДоговорыДУКРасчету.СрокОкончанияДней
		|						ТОГДА 0
		|					ИНАЧЕ 1
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаУдержанияПриРасторжении,
		|	ДоговорыДУКРасчету.СрокДоговора КАК СрокДоговора,
		|	ВводВДУ.СуммаИнвестиций КАК СуммаИнвестиций,
		|	ВводВДУ.ДатаВвода КАК ДатаВвода,
		|	ДоговорыДУКРасчету.ДоговорВознаграждения КАК ДоговорВознаграждения,
		|	ДоговорыДУКРасчету.Расторжение КАК Расторжение,
		|	ДоговорыДУКРасчету.ДатаРасторжения КАК ДатаРасторжения,
		|	ДоговорыДУКРасчету.УправляющаяКомпания КАК УК,
		|	ДоговорыДУКРасчету.Код КАК Код,
		|	ДоговорыДУКРасчету.ДатаНачала КАК ДатаНачала,
		|	ДоговорыДУКРасчету.ДосрочноеРасторжение КАК ДосрочноеРасторжение,
		|	ВыплаченноеВознаграждение.СуммаВознаграждения КАК СуммаВыплаченногоВознаграждения
		|ИЗ
		|	ВТ_ДоговорыДУКРасчету КАК ДоговорыДУКРасчету
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВводВДУ КАК ВводВДУ
		|		ПО (ВводВДУ.ДоговорДУ = ДоговорыДУКРасчету.ДоговорДУ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СуммаВознагражденияДоговорДУ КАК СуммаВознагражденияДоговорДУ
		|		ПО ДоговорыДУКРасчету.ДоговорДУ = СуммаВознагражденияДоговорДУ.ДоговорДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СуммаВознагражденияПриРасторженииДоговорДУ КАК СуммаВознагражденияПриРасторженииДоговорДУ
		|		ПО ДоговорыДУКРасчету.ДоговорДУ = СуммаВознагражденияПриРасторженииДоговорДУ.ДоговорДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеВознаграждения КАК НачислениеВознаграждения
		|		ПО (НачислениеВознаграждения.ДоговорДУ = ДоговорыДУКРасчету.ДоговорДУ)
		|			И (НачислениеВознаграждения.Розница)
		|			И (НачислениеВознаграждения.Комментарий = ""Дополнительное вознаграждение"")
		|			И (НачислениеВознаграждения.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВыплаченноеВознаграждение КАК ВыплаченноеВознаграждение
		|		ПО ДоговорыДУКРасчету.ДоговорДУ = ВыплаченноеВознаграждение.ДоговорДУ
		|ГДЕ
		|	(НЕ СуммаВознагражденияДоговорДУ.ДоговорДУ ЕСТЬ NULL
		|			ИЛИ ДоговорыДУКРасчету.Расторжение)
		|	И НачислениеВознаграждения.Ссылка ЕСТЬ NULL";
	
	КрайняяДатаОбязательств = КрайняяДатаОбязательств();
	
	Запрос.УстановитьПараметр("ДатаРасчета", КонецДня(ДатаНачисления));
	Запрос.УстановитьПараметр("КрайняяДатаОбязательств", КонецДня(КрайняяДатаОбязательств));
	Запрос.УстановитьПараметр("РежимРасторжения", РежимРасторжения);
	Запрос.УстановитьПараметр("Пул", Пул);
	Запрос.УстановитьПараметр("ДоговорыДУ", ДоговорыДУ);
	ОтборПоСписку = Ложь;
	Если ДоговорыДУ.Количество() > 0 Тогда
		ОтборПоСписку = Истина;
	КонецЕсли;
	Запрос.УстановитьПараметр("ОтборПоСписку", ОтборПоСписку);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаЗаписи.Следующий() Цикл
	
		СуммаВознаграждений = ВыборкаЗаписи.СуммаВознаграждения + ВыборкаЗаписи.СуммаУдержанияПриРасторжении;
		Если СуммаВознаграждений > 0 Тогда
		
			ДоговорКНачислению = ДоговорыДУКНачислению.Добавить();
			ЗаполнитьЗначенияСвойств(ДоговорКНачислению, ВыборкаЗаписи);
			
			СрокДоговора = "" + ВыборкаЗаписи.СрокДоговора + СловоЛет(ВыборкаЗаписи.СрокДоговора);
			ДоговорКНачислению.СрокДоговора = СрокДоговора;
			
			ДоговорКНачислению.КрайняяДатаОбязательств = КрайняяДатаОбязательств;
			Если РежимРасторжения Тогда
				ДоговорКНачислению.СуммаВознагражденияВесьСрок = ВыборкаЗаписи.СуммаВыплаченногоВознаграждения;
			Иначе
				ДоговорКНачислению.СуммаВознагражденияВесьСрок 
					= Окр((ВыборкаЗаписи.СуммаИнвестиций / 100) * СтавкаВознаграждения * ВыборкаЗаписи.СрокДоговора, 2);
			КонецЕсли;

		
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область IMDEV_9153

// =============================================================================
// IMDEV-9153: параллельное начисление (пачки) + регламент + письмо об итогах + замеры (IMDEV-8927).
// В пачке: начисление, PDF (с созданием каталогов при отсутствии), удаление ОперацияБух
// (через ОбменДанными.Загрузка). Результат пачки: ссылки начислений + текст первой ошибки.
// =============================================================================

// Описание: Заполняет ТЧ СписокРассылки из настроек (XML / ХранилищеЗначения / ТаблицаЗначений).
//
// Параметры:
//  Данные - Строка, ХранилищеЗначения, ТаблицаЗначений - сохранённый список рассылки
//
Процедура ЗагрузитьСписокРассылки(Данные)

	ТаблицаРассылки = Данные;

	Если ТипЗнч(ТаблицаРассылки) = Тип("Строка") Тогда
		Если ПустаяСтрока(ТаблицаРассылки) Тогда
			Возврат;
		КонецЕсли;
		Попытка
			ТаблицаРассылки = XMLЗначение(Тип("ХранилищеЗначения"), ТаблицаРассылки).Получить();
		Исключение
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Если ТипЗнч(ТаблицаРассылки) = Тип("ХранилищеЗначения") Тогда
		ТаблицаРассылки = ТаблицаРассылки.Получить();
	КонецЕсли;

	Если ТипЗнч(ТаблицаРассылки) = Тип("ТаблицаЗначений") Тогда
		СписокРассылки.Загрузить(ТаблицаРассылки);
	КонецЕсли;

КонецПроцедуры

// Описание: Регламентное начисление ВУК РДУ (команда НачислениеВУКРегламентноеФоновое).
// Запуск: 01.01, 01.04, 01.07, 01.10 (обычно 00:15). Проверка даты — если не включён игнор.
// ДатаЗапуска = НачалоДня(момент запуска); ДатаНачисления = ДатаЗапуска - 1 сек
// (реквизит «Дата» без времени -> предыдущий день 00:00); документы = ДатаНачисления + 86100 (23:55).
// Дальше: договоры к начислению и СоздатьНачисления (письмо — там же при флаге отправки).
//
// Параметры:
//  ПараметрыВыполненияКоманды - Структура - параметры команды БСП (настройки доп. обработки)
//
// Пример:
//  ВыполнитьРегламентноеНачисление(ПараметрыВыполненияКоманды);
//
Процедура ВыполнитьРегламентноеНачисление(ПараметрыВыполненияКоманды) Экспорт

	УстановитьНастройки(ПараметрыВыполненияКоманды);
	РежимРасторжения = Ложь;

	// Значения по умолчанию для рассылки (если не заданы в настройках обработки).
	Если МаксСтрокВТелеПисьма = 0 Тогда
		МаксСтрокВТелеПисьма = 200;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПочтовыйЛогин) Тогда
		ПочтовыйЛогин = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
	КонецЕсли;
	Если СписокРассылки.Количество() = 0 Тогда
		СтрокаРассылки = СписокРассылки.Добавить();
		СтрокаРассылки.Отправлять = Истина;
		СтрокаРассылки.ПочтовыйЯщик = "IMAppSupport@wiminvest.ru";
		СтрокаРассылки.Представление = "IMAppSupport@wiminvest.ru";
	КонецЕсли;

	МоментЗапуска = ТекущаяДатаСеанса();
	// Всегда начало дня: иначе при старте в 00:15 «минус 1 секунда» остаётся тем же днём,
	// и реквизит ДатаНачисления (тип Дата без времени) станет 01.10 00:00:00 вместо 30.09.
	ДатаЗапуска = НачалоДня(МоментЗапуска);

	// Проверка регламентной даты: 1-е число января / апреля / июля / октября.
	Если Не ИгнорироватьПроверкуРегламентнойДаты Тогда
		МесяцЗапуска = Месяц(ДатаЗапуска);
		Если День(ДатаЗапуска) <> 1
			Или Не (МесяцЗапуска = 1 Или МесяцЗапуска = 4 Или МесяцЗапуска = 7 Или МесяцЗапуска = 10) Тогда
			Лог(УровеньЖурналаРегистрации.Предупреждение,
				"Запуск не в регламентную дату (" + Формат(ДатаЗапуска, "ДЛФ=D") + "). Начисление не выполняется.");
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Дата расчета: начало дня старта минус 1 сек -> 30.09 23:59:59;
	// реквизит типа «Дата» без времени -> 30.09 00:00:00; документ = +86100 -> 30.09 23:55:00.
	ДатаНачисления = ДатаЗапуска - 1;

	ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту(
		"ИмяОбъекта", ЭтотОбъект.Метаданные().Имя);

	ДоговорыКНачислению();
	СоздатьНачисления(ДополнительнаяОбработкаСсылка, Новый УникальныйИдентификатор, МоментЗапуска);

КонецПроцедуры

// Описание: Дирижёр начисления ВУК РДУ (форма и регламент).
// Параллельно: пачки по 100, лимит потоков из константы; в пачке — начисление, PDF, удаление.
// Запуск ФЗ через ДлительныеОперации.ВыполнитьВФоне (якорь — ИдентификаторФормы).
// После ФЗ: мерж ссылок начислений в ТЧ; в сводку/письмо — «Пример ошибки» (первая из пачек).
// Расторжение или лимит потоков <= 1 — последовательный режим (НачислитьПоследовательно).
// Пишет замер производительности БСП (IMDEV-8927): ДУ.НачислениеВознагражденияРДУ.Начисление.<Контур>.
//
// Параметры:
//  ДополнительнаяОбработкаСсылка - СправочникСсылка.ДополнительныеОтчетыИОбработки -
//      ссылка доп. обработки для ФЗ; если пусто — последовательный режим
//  ИдентификаторФормы - УникальныйИдентификатор - якорь временного хранилища БСП
//  ДатаСтартаРасчета - Дата - для письма об итогах; если пусто — ТекущаяДатаСеанса
//
// Возвращаемое значение:
//  Строка - текст сводки (в т.ч. пример ошибки при сбоях); пустая при последовательном режиме
//      или без договоров
//
// Пример:
//  ТекстСводки = СоздатьНачисления(СсылкаДопОбработки, УникальныйИдентификатор, МоментЗапуска);
//
Функция СоздатьНачисления(ДополнительнаяОбработкаСсылка = Неопределено, ИдентификаторФормы = Неопределено,
	ДатаСтартаРасчета = Неопределено) Экспорт

	КлючеваяОперацияЗамера = ПолучитьИмяКлючевойОперацииЗамера("Начисление");
	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	КоличествоДоговоровЗамера = ДоговорыДУКНачислению.Количество();
	НомерПачкиЗамера = 0;
	ОшибокЗамера = 0;
	ЛимитПотоковЗамера = 0;
	ТекстСводки = "";

	Если РежимРасторжения Тогда
		НачислитьПоследовательно();
	Иначе

		ЛимитПотоков = 0;
		Если ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка)
			И ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены() Тогда
			ЛимитПотоков = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
		КонецЕсли;
		ЛимитПотоковЗамера = ЛимитПотоков;

		Если ЛимитПотоков <= 1 Тогда
			НачислитьПоследовательно();
		Иначе

			ТаблицаДоговоров = ДоговорыДУКНачислению.Выгрузить();
			Всего = ТаблицаДоговоров.Количество();
			КоличествоДоговоровЗамера = Всего;

			Если Всего > 0 Тогда

				Если Не ЗначениеЗаполнено(ИдентификаторФормы) Тогда
					ИдентификаторФормы = Новый УникальныйИдентификатор;
				КонецЕсли;

				Если Не ЗначениеЗаполнено(ДатаСтартаРасчета) Тогда
					ДатаСтартаРасчета = ТекущаяДатаСеанса();
				КонецЕсли;

				РазмерПачки = 100;
				НастройкиШапки = Новый Структура(
					"ДатаНачисления, СтавкаВознаграждения, СчетВознаграждения, КаталогСохранения, КаталогСохраненияКабинетаДУ, РежимРасторжения",
					ДатаНачисления, СтавкаВознаграждения, СчетВознаграждения, КаталогСохранения, КаталогСохраненияКабинетаДУ, Ложь);

				ВремяНачалаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
				ОшибокНачисления = 0;
				ТекстПервойОшибки = "";
				Активные = Новый Массив;
				НомерПачки = 0;
				Индекс = 0;

				Пока Индекс < Всего Или Активные.Количество() > 0 Цикл

					Пока Активные.Количество() < ЛимитПотоков И Индекс < Всего Цикл

						РазмерТекущейПачки = Мин(РазмерПачки, Всего - Индекс);
						ТаблицаПачки = ТаблицаДоговоров.СкопироватьКолонки();
						Для Смещение = 0 По РазмерТекущейПачки - 1 Цикл
							ЗаполнитьЗначенияСвойств(ТаблицаПачки.Добавить(), ТаблицаДоговоров[Индекс + Смещение]);
						КонецЦикла;
						Индекс = Индекс + РазмерТекущейПачки;
						НомерПачки = НомерПачки + 1;

						ПараметрыПачки = Новый Структура("НастройкиШапки, ТаблицаПачки, НомерПачки",
							НастройкиШапки, ТаблицаПачки, НомерПачки);

						ПараметрыМетода = Новый Структура;
						ПараметрыМетода.Вставить("ИмяМетода", "ОбработатьПачкуНачислений");
						ПараметрыМетода.Вставить("ЭтоВнешняяОбработка", Истина);
						ПараметрыМетода.Вставить("ИмяОбработки", "");
						ПараметрыМетода.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
						ПараметрыМетода.Вставить("ПараметрыВыполнения", XMLСтрока(Новый ХранилищеЗначения(ПараметрыПачки)));

						ПараметрыФона = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
						ПараметрыФона.ЗапуститьВФоне = Истина;
						ПараметрыФона.ОжидатьЗавершение = 0;
						ПараметрыФона.НаименованиеФоновогоЗадания =
							"IMDEV-9153 Начисление РДУ пачка " + Формат(НомерПачки, "ЧГ=0");

						Контекст = ДлительныеОперации.ВыполнитьВФоне(
							"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
							ПараметрыМетода,
							ПараметрыФона);

						Активные.Добавить(Новый Структура(
							"Контекст, НомерПачки, КоличествоДоговоров",
							Контекст, НомерПачки, ТаблицаПачки.Количество()));

					КонецЦикла;

					Если Активные.Количество() > 0
						И ЗначениеЗаполнено(Активные[0].Контекст.ИдентификаторЗадания) Тогда
						Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
							Активные[0].Контекст.ИдентификаторЗадания);
						Если Задание <> Неопределено Тогда
							Попытка
								Задание.ОжидатьЗавершения(0.5);
							Исключение
								// Авария/таймаут — состояние ниже через ОперацияВыполнена
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;

					ИтогСбора = СобратьЗавершённыеПачкиПула(Активные);
					ОшибокНачисления = ОшибокНачисления + ИтогСбора.Ошибок;
					Если ПустаяСтрока(ТекстПервойОшибки)
						И Не ПустаяСтрока(ИтогСбора.ТекстПервойОшибки) Тогда
						ТекстПервойОшибки = ИтогСбора.ТекстПервойОшибки;
					КонецЕсли;

				КонецЦикла;

				НомерПачкиЗамера = НомерПачки;
				ОшибокЗамера = ОшибокНачисления;

				ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс) / 1000;
				ВсегоСек = Макс(Цел(ДлительностьСек), 0);
				Часы = Цел(ВсегоСек / 3600);
				Минуты = Цел((ВсегоСек - Часы * 3600) / 60);
				Секунды = ВсегоСек - Часы * 3600 - Минуты * 60;

				ТекстСводки =
					"Выполнено начисление вознаграждения за управление (розничное ДУ)." + Символы.ПС
					+ "По каждому договору: создано начисление, сформирована справка-расчет (PDF),"
					+ " удалено обязательство по денежным средствам." + Символы.ПС
					+ "Обработано договоров: " + Формат(Всего, "ЧН=0; ЧГ=0") + "." + Символы.ПС
					+ "Ошибок: " + Формат(ОшибокНачисления, "ЧН=0; ЧГ=0") + "." + Символы.ПС
					+ "Время выполнения: " + Формат(Часы, "ЧН=0; ЧГ=0") + " ч "
					+ Прав("0" + Формат(Минуты, "ЧГ=0"), 2) + " мин "
					+ Прав("0" + Формат(Секунды, "ЧГ=0"), 2) + " сек.";
				Если ОшибокНачисления > 0 И Не ПустаяСтрока(ТекстПервойОшибки) Тогда
					ТекстСводки = ТекстСводки + Символы.ПС
						+ "Пример ошибки: " + ТекстПервойОшибки;
				КонецЕсли;

				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСводки);
				Лог(УровеньЖурналаРегистрации.Информация,
					ТекстСводки + Символы.ПС
						+ "Пачек: " + Формат(НомерПачки, "ЧН=0; ЧГ=0") + ".");

				Если ОтправлятьПисьмоОбИтогах Тогда
					ДатаДокументовНачисления = ?(ЗначениеЗаполнено(ДатаНачисления),
						ДатаНачисления + 86100,
						НачалоДня(ТекущаяДатаСеанса()));
					Попытка
						ОтправитьПисьмоОбИтогах(ДатаСтартаРасчета, ДатаДокументовНачисления,
							ТекстСводки, ОшибокНачисления, Всего);
					Исключение
						ТекстОшибки = "Ошибка отправки письма об итогах: " + ОписаниеОшибки();
						Лог(УровеньЖурналаРегистрации.Ошибка, ТекстОшибки);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
					КонецПопытки;
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	ЗавершитьЗамерНачисленияВУК(
		КлючеваяОперацияЗамера,
		ВремяНачалаЗамера,
		КоличествоДоговоровЗамера,
		НомерПачкиЗамера,
		ОшибокЗамера,
		ЛимитПотоковЗамера,
		ОшибокЗамера > 0);

	Возврат ТекстСводки;

КонецФункции

// Описание: Фоновая обработка одной пачки договоров.
// По каждому договору: начисление, PDF, удаление ОперацияБух (ОбменДанными.Загрузка).
// В результат: массив Строки (ДоговорДУ + ссылки начислений) и ТекстПервойОшибки для сводки.
// Результат в хранилище: XMLСтрока(ХранилищеЗначения(...)).
//
// Параметры:
//  ПараметрыВыполнения - Строка, Структура - XML пачки или структура
//      (НастройкиШапки, ТаблицаПачки, НомерПачки)
//  АдресХранилища - Строка - адрес результата во временном хранилище
//
// Пример:
//  ОбработатьПачкуНачислений(ПараметрыПачки, АдресРезультата);
//
Процедура ОбработатьПачкуНачислений(ПараметрыВыполнения, АдресХранилища) Экспорт

	Если ТипЗнч(ПараметрыВыполнения) = Тип("Строка") Тогда
		ПараметрыВыполнения = XMLЗначение(Тип("ХранилищеЗначения"), ПараметрыВыполнения).Получить();
	КонецЕсли;

	Результат = Новый Структура("НомерПачки, ОшибокДоговоров, ТекстОшибки, ТекстПервойОшибки, Строки",
		ПараметрыВыполнения.НомерПачки, 0, "", "", Новый Массив);

	Попытка
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыВыполнения.НастройкиШапки);
		ДоговорыДУКНачислению.Очистить();
		Для Каждого СтрокаПачки Из ПараметрыВыполнения.ТаблицаПачки Цикл
			ЗаполнитьЗначенияСвойств(ДоговорыДУКНачислению.Добавить(), СтрокаПачки);
		КонецЦикла;

		Для Каждого ДоговорДУ Из ДоговорыДУКНачислению Цикл
			Попытка
				Если ДоговорДУ.СуммаВознаграждения > 0 Тогда
					ДоговорДУ.НачислениеВознаграждения = НачислениеВознаграждения(ДоговорДУ, Ложь);
				КонецЕсли;
				ФормироватьСправкуРасчет(ДоговорДУ, Ложь);
				УдалитьОбязательствоДС(ДоговорДУ.ДоговорДУ, Ложь);
			Исключение
				ОтменитьАктивныеТранзакцииПачки();
				Результат.ОшибокДоговоров = Результат.ОшибокДоговоров + 1;
				ТекстОшибкиДоговора = "Договор " + Строка(ДоговорДУ.ДоговорДУ) + ": " + ОписаниеОшибки();
				Если ПустаяСтрока(Результат.ТекстПервойОшибки) Тогда
					Результат.ТекстПервойОшибки = ТекстОшибкиДоговора;
				КонецЕсли;
				Лог(УровеньЖурналаРегистрации.Ошибка, ТекстОшибкиДоговора);
			КонецПопытки;

			Результат.Строки.Добавить(Новый Структура(
				"ДоговорДУ, НачислениеВознаграждения, НачислениеУдержанияПриРасторжении",
				ДоговорДУ.ДоговорДУ,
				ДоговорДУ.НачислениеВознаграждения,
				ДоговорДУ.НачислениеУдержанияПриРасторжении));
		КонецЦикла;

	Исключение
		ОтменитьАктивныеТранзакцииПачки();
		Результат.ТекстОшибки = ОписаниеОшибки();
		Если ПустаяСтрока(Результат.ТекстПервойОшибки) Тогда
			Результат.ТекстПервойОшибки = Результат.ТекстОшибки;
		КонецЕсли;
		Лог(УровеньЖурналаРегистрации.Ошибка,
			"Пачка " + Формат(Результат.НомерПачки, "ЧГ=0") + ": " + Результат.ТекстОшибки);
	КонецПопытки;

	Попытка
		ПоместитьВоВременноеХранилище(XMLСтрока(Новый ХранилищеЗначения(Результат)), АдресХранилища);
	Исключение
		Лог(УровеньЖурналаРегистрации.Ошибка,
			"Не удалось поместить результат пачки " + Формат(Результат.НомерПачки, "ЧГ=0")
				+ " во временное хранилище: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Описание: Последовательное начисление по ТЧ (расторжение или fallback без параллели).
// По договору: начисление, PDF, удаление обязательства.
//
Процедура НачислитьПоследовательно()

	Для Каждого ДоговорДУ Из ДоговорыДУКНачислению Цикл

		Если ДоговорДУ.СуммаВознаграждения > 0 Тогда
			ДоговорДУ.НачислениеВознаграждения = НачислениеВознаграждения(ДоговорДУ, Ложь);
		КонецЕсли;

		Если ДоговорДУ.Расторжение И ДоговорДУ.СуммаУдержанияПриРасторжении > 0 Тогда
			ДоговорДУ.НачислениеУдержанияПриРасторжении = НачислениеВознаграждения(ДоговорДУ, Истина);
		КонецЕсли;

		ФормироватьСправкуРасчет(ДоговорДУ, ДоговорДУ.Расторжение);

		УдалитьОбязательствоДС(ДоговорДУ.ДоговорДУ, ДоговорДУ.Расторжение);

	КонецЦикла;

КонецПроцедуры

// Описание: Забирает из пула завершённые ФЗ, суммирует ошибки, удаляет их из Активные.
// Статус — ОперацияВыполнена(..., Ложь); результат — XML из Контекст.АдресРезультата.
// Ссылки начислений из результата пачки переносятся в ТЧ ДоговорыДУКНачислению.
// Собирает ТекстПервойОшибки из пачек (или из сбоя ФЗ) для сводки/письма.
//
// Параметры:
//  Активные - Массив из Структура - Контекст (ВыполнитьВФоне), НомерПачки, КоличествоДоговоров
//
// Возвращаемое значение:
//  Структура - Ошибок (Число), ТекстПервойОшибки (Строка)
//
// Пример:
//  ИтогСбора = СобратьЗавершённыеПачкиПула(Активные);
//
Функция СобратьЗавершённыеПачкиПула(Активные)

	ИтогСбора = Новый Структура("Ошибок, ТекстПервойОшибки", 0, "");
	Индекс = Активные.ВГраница();

	Пока Индекс >= 0 Цикл

		Описание = Активные[Индекс];
		Контекст = Описание.Контекст;

		ТекстОшибкиЗадания = "";
		Если ЗначениеЗаполнено(Контекст.ИдентификаторЗадания) Тогда
			СтатусЗадания = ДлительныеОперации.ОперацияВыполнена(Контекст.ИдентификаторЗадания, Ложь);
			Если СтатусЗадания.Статус = "Выполняется" Тогда
				Индекс = Индекс - 1;
				Продолжить;
			КонецЕсли;
			ТекстОшибкиЗадания = СтатусЗадания.КраткоеПредставлениеОшибки;
		Иначе
			ТекстОшибкиЗадания = Контекст.КраткоеПредставлениеОшибки;
		КонецЕсли;

		ИтогПачки = Неопределено;
		Если ЗначениеЗаполнено(Контекст.АдресРезультата) Тогда
			СтрокаXMLРезультата = ПолучитьИзВременногоХранилища(Контекст.АдресРезультата);
			Если ЗначениеЗаполнено(СтрокаXMLРезультата) Тогда
				Попытка
					Если ТипЗнч(СтрокаXMLРезультата) = Тип("Строка") Тогда
						ИтогПачки = XMLЗначение(Тип("ХранилищеЗначения"), СтрокаXMLРезультата).Получить();
					ИначеЕсли ТипЗнч(СтрокаXMLРезультата) = Тип("Структура") Тогда
						ИтогПачки = СтрокаXMLРезультата;
					КонецЕсли;
				Исключение
					ИтогПачки = Неопределено;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;

		Если ТипЗнч(ИтогПачки) = Тип("Структура") Тогда
			ПрименитьРезультатыПачкиКТабличнойЧасти(ИтогПачки);
			Если Не ПустаяСтрока(ИтогПачки.ТекстОшибки) Тогда
				ИтогСбора.Ошибок = ИтогСбора.Ошибок + Описание.КоличествоДоговоров;
			Иначе
				ИтогСбора.Ошибок = ИтогСбора.Ошибок + ИтогПачки.ОшибокДоговоров;
			КонецЕсли;
			Если ПустаяСтрока(ИтогСбора.ТекстПервойОшибки) Тогда
				Если ИтогПачки.Свойство("ТекстПервойОшибки")
					И Не ПустаяСтрока(ИтогПачки.ТекстПервойОшибки) Тогда
					ИтогСбора.ТекстПервойОшибки = ИтогПачки.ТекстПервойОшибки;
				ИначеЕсли Не ПустаяСтрока(ИтогПачки.ТекстОшибки) Тогда
					ИтогСбора.ТекстПервойОшибки = ИтогПачки.ТекстОшибки;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ТекстОшибкиЗадания) Тогда
			ИтогСбора.Ошибок = ИтогСбора.Ошибок + Описание.КоличествоДоговоров;
			Если ПустаяСтрока(ИтогСбора.ТекстПервойОшибки) Тогда
				ИтогСбора.ТекстПервойОшибки =
					"Пачка " + Формат(Описание.НомерПачки, "ЧГ=0") + ": " + ТекстОшибкиЗадания;
			КонецЕсли;
			Лог(УровеньЖурналаРегистрации.Ошибка,
				"Пачка " + Формат(Описание.НомерПачки, "ЧГ=0") + ": " + ТекстОшибкиЗадания);
		Иначе
			Лог(УровеньЖурналаРегистрации.Предупреждение,
				"Пачка " + Формат(Описание.НомерПачки, "ЧГ=0")
					+ ": результат не получен из временного хранилища (договоров в пачке: "
					+ Формат(Описание.КоличествоДоговоров, "ЧГ=0") + ").");
		КонецЕсли;

		Активные.Удалить(Индекс);
		Индекс = Индекс - 1;

	КонецЦикла;

	Возврат ИтогСбора;

КонецФункции

// Описание: Переносит из результата пачки ссылки начислений в ТЧ ДоговорыДУКНачислению.
// Поиск строк по ДоговорДУ; заполняет НачислениеВознаграждения и НачислениеУдержанияПриРасторжении.
//
// Параметры:
//  ИтогПачки - Структура - результат ФЗ (поле Строки — массив структур по договорам)
//
Процедура ПрименитьРезультатыПачкиКТабличнойЧасти(ИтогПачки)

	Если Не ИтогПачки.Свойство("Строки") Или ТипЗнч(ИтогПачки.Строки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаРезультата Из ИтогПачки.Строки Цикл

		Если Не ЗначениеЗаполнено(СтрокаРезультата.ДоговорДУ) Тогда
			Продолжить;
		КонецЕсли;

		НайденныеСтроки = ДоговорыДУКНачислению.НайтиСтроки(
			Новый Структура("ДоговорДУ", СтрокаРезультата.ДоговорДУ));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТЧ = НайденныеСтроки[0];
		Если ЗначениеЗаполнено(СтрокаРезультата.НачислениеВознаграждения) Тогда
			СтрокаТЧ.НачислениеВознаграждения = СтрокаРезультата.НачислениеВознаграждения;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаРезультата.НачислениеУдержанияПриРасторжении) Тогда
			СтрокаТЧ.НачислениеУдержанияПриРасторжении = СтрокаРезультата.НачислениеУдержанияПриРасторжении;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Описание: Письмо об итогах через БСП (РаботаСПочтовымиСообщениями).
// Получатели — ТЧ СписокРассылки (с учётом флага «Отправлять»).
// В письме: дата старта расчета, дата документов начисления, текст сводки
// (включая «Пример ошибки», если он уже добавлен в ТекстСводки).
// Тема: префикс {OK}/{WARN}/{FAIL} + текст + прописка рассылки {r9153, ib: ...}.
//
// Параметры:
//  ДатаСтартаРасчета - Дата - момент запуска расчета
//  ДатаДокументовНачисления - Дата - дата документов начисления (ДатаНачисления + 86100)
//  ТекстСводки - Строка - итоги для тела письма (может содержать пример ошибки)
//  Ошибок - Число - количество ошибок по договорам
//  ВсегоДоговоров - Число - обработано договоров (для выбора WARN vs FAIL)
//
// Пример:
//  ОтправитьПисьмоОбИтогах(МоментЗапуска, ДатаНачисления + 86100, ТекстСводки, Ошибок, Всего);
//
Процедура ОтправитьПисьмоОбИтогах(ДатаСтартаРасчета, ДатаДокументовНачисления, ТекстСводки,
	Ошибок = 0, ВсегоДоговоров = 0)

	ЕстьПометкаОтправлять = Ложь;
	Для Каждого СтрокаЯщика Из СписокРассылки Цикл
		Если СтрокаЯщика.Отправлять Тогда
			ЕстьПометкаОтправлять = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Кому = Новый Массив;
	Для Каждого СтрокаЯщика Из СписокРассылки Цикл
		Если Не ЗначениеЗаполнено(СтрокаЯщика.ПочтовыйЯщик) Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьПометкаОтправлять И Не СтрокаЯщика.Отправлять Тогда
			Продолжить;
		КонецЕсли;
		Кому.Добавить(Новый Структура("Адрес, Представление",
			СтрокаЯщика.ПочтовыйЯщик, СтрокаЯщика.Представление));
	КонецЦикла;

	Если Кому.Количество() = 0 Тогда
		Текст = "Письмо об итогах не отправлено: не заполнен список рассылки (ТЧ СписокРассылки).";
		Лог(УровеньЖурналаРегистрации.Предупреждение, Текст);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПочтовыйЛогин) Тогда
		Текст = "Письмо об итогах не отправлено: не выбрана учётная запись почты (ПочтовыйЛогин).";
		Лог(УровеньЖурналаРегистрации.Предупреждение, Текст);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;

	ТелоПисьма = "<html><body style=""font-family:Calibri,Arial,sans-serif;font-size:14px;"">"
		+ "<h2>Начисление вознаграждения за управление (розничное ДУ)</h2>"
		+ "<p>Дата старта расчета: " + Формат(ДатаСтартаРасчета, "ДФ='dd.MM.yyyy HH:mm:ss'") + "</p>"
		+ "<p>Дата документов начисления: " + Формат(ДатаДокументовНачисления, "ДФ=dd.MM.yyyy") + "</p>"
		+ "<pre style=""white-space:pre-wrap;font-family:Calibri,Arial,sans-serif;font-size:14px;"">"
		+ ТекстСводки + "</pre>"
		+ "</body></html>";

	Если Ошибок <= 0 Тогда
		ФлагРезультатаВТеме = "{OK} ";
		ВажностьПисьма = ВажностьИнтернетПочтовогоСообщения.Обычная;
	ИначеЕсли ВсегоДоговоров > 0 И Ошибок < ВсегоДоговоров Тогда
		ФлагРезультатаВТеме = "{WARN} ";
		ВажностьПисьма = ВажностьИнтернетПочтовогоСообщения.Высокая;
	Иначе
		ФлагРезультатаВТеме = "{FAIL} ";
		ВажностьПисьма = ВажностьИнтернетПочтовогоСообщения.Высокая;
	КонецЕсли;

	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ФлагРезультатаВТеме
		+ "Авто-начисление ВУК РДУ за "
		+ Формат(ДатаДокументовНачисления, "ДФ=dd.MM.yyyy")
		+ ПропискаРассылки("r9153");
	ПараметрыПисьма.Тело = ТелоПисьма;
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
	ПараметрыПисьма.Важность = ВажностьПисьма;

	РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
	Лог(УровеньЖурналаРегистрации.Информация, "Письмо об итогах отправлено: " + ПараметрыПисьма.Тема);

КонецПроцедуры

// Описание: Хвост темы письма с номером рассылки и именем ИБ (как в других обработках ДУ).
//
// Параметры:
//  НомерРассылки - Строка - код рассылки (например, r9153)
//
// Возвращаемое значение:
//  Строка - фрагмент вида " {r9153, ib: WIM_DU}"
//
Функция ПропискаРассылки(Знач НомерРассылки)

	ИмяИБ = "";
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(
			СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
		// Имя ИБ недоступно — в теме будет заглушка
	КонецПопытки;

	Возврат " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";

КонецФункции

// Описание: Запись в ЖР с событием IMDEV-9153.НачислениеВознагражденияРозничноеДУ.
//
// Параметры:
//  Уровень - УровеньЖурналаРегистрации - уровень записи
//  Текст - Строка - комментарий
//
// Пример:
//  Лог(УровеньЖурналаРегистрации.Ошибка, "Пачка 3: " + ОписаниеОшибки());
//
Процедура Лог(Уровень, Текст)

	ЗаписьЖурналаРегистрации("IMDEV-9153.НачислениеВознагражденияРозничноеДУ", Уровень, , , Текст);

КонецПроцедуры

// Описание: Откатывает все активные транзакции сессии после ошибки в пачке.
//
Процедура ОтменитьАктивныеТранзакцииПачки()

	Пока ТранзакцияАктивна() Цикл
		ОтменитьТранзакцию();
	КонецЦикла;

КонецПроцедуры

#Область ЗамерыПроизводительности

// Описание: Добавляет в комментарий замера скорость (вес / время), об/с.
//
// Параметры:
//  Вес - Число - количество обработанных объектов
//  ВремяНачала - Число - метка начала замера
//
// Возвращаемое значение:
//  Строка - фрагмент "; УдельныйВес=..."
//
Функция ДополнениеКомментарияУдельныйВес(Вес, ВремяНачала)

	ДлительностьСек = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Скорость = ?(ДлительностьСек > 0, Вес / ДлительностьСек, 0);

	Возврат "; УдельныйВес=" + Формат(Скорость, "ЧЦ=10; ЧДЦ=2") + " об/с";

КонецФункции

// Описание: Имя ключевой операции для замера начисления ВУК РДУ.
//
// Параметры:
//  ЭтапЗамера - Строка - этап (Начисление)
//
// Возвращаемое значение:
//  Строка - ДУ.НачислениеВознагражденияРДУ.<Этап>.<Контур>
//
Функция ПолучитьИмяКлючевойОперацииЗамера(Знач ЭтапЗамера)

	Возврат "ДУ.НачислениеВознагражденияРДУ." + ЭтапЗамера + "."
		+ ?(ЗначениеЗаполнено(ИдентификаторКомандыДляЗамера), ИдентификаторКомандыДляЗамера, "Ручной");

КонецФункции

// Описание: Завершает замер начисления ВУК с типовым комментарием IMDEV-9153.
//
// Параметры:
//  КлючеваяОперация - Строка - имя ключевой операции
//  ВремяНачала - Число - метка начала
//  КоличествоДоговоров - Число - вес / договоры
//  НомерПачки - Число - число пачек (0 при последовательном режиме)
//  Ошибок - Число - ошибок по договорам
//  ЛимитПотоков - Число - параллельность
//  ВыполненСОшибкой - Булево - признак ошибки
//
Процедура ЗавершитьЗамерНачисленияВУК(КлючеваяОперация, ВремяНачала, КоличествоДоговоров,
	НомерПачки, Ошибок, ЛимитПотоков, ВыполненСОшибкой = Ложь)

	ВесЗамера = ?(КоличествоДоговоров > 0, КоличествоДоговоров, 1);
	КомментарийЗамера = "IMDEV-9153"
		+ "; Договоров=" + Формат(КоличествоДоговоров, "ЧН=0; ЧГ=0")
		+ "; Пачек=" + Формат(НомерПачки, "ЧН=0; ЧГ=0")
		+ "; Ошибок=" + Формат(Ошибок, "ЧН=0; ЧГ=0")
		+ "; Параллельность=" + Формат(Макс(ЛимитПотоков, 1), "ЧН=0; ЧГ=0")
		+ ДополнениеКомментарияУдельныйВес(ВесЗамера, ВремяНачала);

	ОценкаПроизводительности.ЗакончитьЗамерВремени(
		КлючеваяОперация,
		ВремяНачала,
		ВесЗамера,
		КомментарийЗамера,
		ВыполненСОшибкой);

КонецПроцедуры

