
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПустаяСтрока(ПользовательЗаданий) Тогда
		ПользовательЗаданий = "svc_avancore";
	КонецЕсли;

	Если ПустаяСтрока(КлючЗаданияВУК) Тогда
		КлючЗаданияВУК = "Начисление ВУК: Розничное ДУ (регламентное)";
	КонецЕсли;

	Если ПустаяСтрока(КлючЗаданияРасторжение) Тогда
		КлючЗаданияРасторжение = ""; // не меняем ключ расторжения без явного указания
	КонецЕсли;

	Протокол = "1) Выберите элемент справочника «Дополнительные отчеты и обработки»"
		+ " (Начисление вознаграждения за управление: Розничное ДУ)." + Символы.ПС
		+ "2) Нажмите «Проверить» — посмотрите протокол." + Символы.ПС
		+ "3) Нажмите «Починить» — развяжет общий GUID и настроит задания." + Символы.ПС
		+ "Расторжение сохранит своё задание; квартальная команда получит отдельное"
		+ " с расписанием 01.01/01.04/01.07/01.10 в 00:15.";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Починить(Команда)

	Если Не ЗначениеЗаполнено(ДополнительнаяОбработка) Тогда
		ПоказатьПредупреждение(, "Выберите элемент справочника «Дополнительные отчеты и обработки».");
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПочинитьПослеПодтверждения", ЭтотОбъект),
		"Починить GUID и регламентные задания для выбранной доп. обработки?"
			+ Символы.ПС + "Расторжение сохранит своё задание; у квартальной команды будет создано отдельное.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПочинитьПослеПодтверждения(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Протокол = ПочинитьНаСервере(Ложь);
	ПоказатьПредупреждение(, "Готово. См. протокол на форме.");

КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)

	Если Не ЗначениеЗаполнено(ДополнительнаяОбработка) Тогда
		ПоказатьПредупреждение(, "Выберите элемент справочника «Дополнительные отчеты и обработки».");
		Возврат;
	КонецЕсли;

	Протокол = ПочинитьНаСервере(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПочинитьНаСервере(ТолькоПроверка)

	Если ПустаяСтрока(ПользовательЗаданий) Тогда
		ПользовательЗаданий = "svc_avancore";
	КонецЕсли;

	Если ПустаяСтрока(КлючЗаданияВУК) Тогда
		КлючЗаданияВУК = "Начисление ВУК: Розничное ДУ (регламентное)";
	КонецЕсли;

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ПочинитьКоманды(
		ДополнительнаяОбработка,
		ПользовательЗаданий,
		КлючЗаданияВУК,
		КлючЗаданияРасторжение,
		ТолькоПроверка);

КонецФункции

#КонецОбласти
