
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Описание: Сведения для подключения через БСП (опционально).
//
Функция СведенияОВнешнейОбработке() Экспорт

	Структура = Новый Структура;
	Структура.Вставить("Вид", ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка());
	Структура.Вставить("Наименование", "Починка регламентных команд ВУК РДУ (IMDEV-9153)");
	Структура.Вставить("Версия", "1.0");
	Структура.Вставить("БезопасныйРежим", Ложь);
	Структура.Вставить("Информация",
		"Развязывает общие GUID регламентных заданий у команд доп. обработки "
		+ "начисления ВУК РДУ (расторжение и квартальное начисление).");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));

	НоваяКоманда = Команды.Добавить();
	НоваяКоманда.Представление = "Починка регламентных команд ВУК РДУ";
	НоваяКоманда.Идентификатор = "ОткрытьФормуПочинки";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Структура.Вставить("Команды", Команды);

	Возврат Структура;

КонецФункции

// Описание: Проверяет или чинит GUID/регламентные задания команд доп. обработки ВУК РДУ.
// Расторжение сохраняет своё задание (если оно валидно); квартальная команда получает
// отдельный GUID и расписание 1/4/7/10 в 00:15.
//
// Параметры:
//  ДополнительнаяОбработка - СправочникСсылка.ДополнительныеОтчетыИОбработки - элемент справочника
//  ПользовательЗаданий - Строка - имя пользователя для заданий (например, svc_avancore)
//  КлючЗаданияВУК - Строка - ключ задания квартального начисления
//  КлючЗаданияРасторжение - Строка - ключ задания расторжения; пусто = не менять
//  ТолькоПроверка - Булево - Истина: только протокол, без записи
//
// Возвращаемое значение:
//  Строка - протокол выполнения
//
Функция ПочинитьКоманды(ДополнительнаяОбработка, ПользовательЗаданий, КлючЗаданияВУК,
	КлючЗаданияРасторжение = "", ТолькоПроверка = Ложь) Экспорт

	Протокол = Новый Массив;
	ДобавитьВПротокол(Протокол, "Старт: " + ?(ТолькоПроверка, "проверка", "починка"));

	Если Не ЗначениеЗаполнено(ДополнительнаяОбработка) Тогда
		ДобавитьВПротокол(Протокол, "ОШИБКА: не выбран элемент справочника «Дополнительные отчеты и обработки».");
		Возврат СтрСоединить(Протокол, Символы.ПС);
	КонецЕсли;

	ИдРасторжение = "НачислениеВознагражденияПриРасторженииРозничноеДУФоновое";
	ИдВУК = "НачислениеВУКРегламентноеФоновое";
	ПустойGUID = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");

	УстановитьПривилегированныйРежим(Истина);

	ОбъектОбработки = ДополнительнаяОбработка.ПолучитьОбъект();
	ДобавитьВПротокол(Протокол, "Элемент: " + Строка(ОбъектОбработки) + ", версия EPF: " + ОбъектОбработки.Версия);
	ДобавитьВПротокол(Протокол, "Команд в ТЧ: " + Формат(ОбъектОбработки.Команды.Количество(), "ЧГ=0"));

	СтрокаРасторжение = НайтиСтрокуКоманды(ОбъектОбработки, ИдРасторжение);
	СтрокаВУК = НайтиСтрокуКоманды(ОбъектОбработки, ИдВУК);

	Если СтрокаРасторжение = Неопределено Тогда
		ДобавитьВПротокол(Протокол, "ПРЕДУПРЕЖДЕНИЕ: не найдена команда расторжения (" + ИдРасторжение + ").");
	Иначе
		ДобавитьВПротокол(Протокол, "Команда расторжения: " + СтрокаРасторжение.Представление
			+ "; GUID=" + Строка(СтрокаРасторжение.РегламентноеЗаданиеGUID));
	КонецЕсли;

	Если СтрокаВУК = Неопределено Тогда
		ДобавитьВПротокол(Протокол,
			"ОШИБКА: не найдена команда квартального начисления (" + ИдВУК + "). "
			+ "Сначала загрузите EPF версии с этой командой.");
		Возврат СтрСоединить(Протокол, Символы.ПС);
	Иначе
		ДобавитьВПротокол(Протокол, "Команда ВУК: " + СтрокаВУК.Представление
			+ "; GUID=" + Строка(СтрокаВУК.РегламентноеЗаданиеGUID));
	КонецЕсли;

	// --- Развязка общего GUID ---
	Если СтрокаРасторжение <> Неопределено
		И ЗначениеЗаполнено(СтрокаРасторжение.РегламентноеЗаданиеGUID)
		И СтрокаРасторжение.РегламентноеЗаданиеGUID <> ПустойGUID
		И СтрокаРасторжение.РегламентноеЗаданиеGUID = СтрокаВУК.РегламентноеЗаданиеGUID Тогда

		ДобавитьВПротокол(Протокол,
			"ОБНАРУЖЕНО: обе команды ссылаются на один GUID "
			+ Строка(СтрокаВУК.РегламентноеЗаданиеGUID) + ".");

		Если Не ТолькоПроверка Тогда
			СтрокаВУК.РегламентноеЗаданиеGUID = ПустойGUID;
			ДобавитьВПротокол(Протокол, "Сброшен GUID у команды ВУК (расторжение сохраняет задание).");
		Иначе
			ДобавитьВПротокол(Протокол, "Нужно: сбросить GUID у команды ВУК.");
		КонецЕсли;
	КонецЕсли;

	// Общая развязка: любой GUID, на который смотрят >1 серверных команд
	РазвязатьДублиGUID(ОбъектОбработки, ИдРасторжение, ПустойGUID, Протокол, ТолькоПроверка);

	// --- Обеспечить задание расторжения ---
	Если СтрокаРасторжение <> Неопределено Тогда
		ОбеспечитьЗаданиеКоманды(
			ОбъектОбработки,
			СтрокаРасторжение,
			ДополнительнаяОбработка,
			ПользовательЗаданий,
			КлючЗаданияРасторжение,
			Неопределено, // расписание не навязываем
			Протокол,
			ТолькоПроверка,
			"расторжение");
	КонецЕсли;

	// --- Обеспечить задание ВУК с квартальным расписанием ---
	РасписаниеВУК = РасписаниеКвартальногоНачисления();
	ОбеспечитьЗаданиеКоманды(
		ОбъектОбработки,
		СтрокаВУК,
		ДополнительнаяОбработка,
		ПользовательЗаданий,
		КлючЗаданияВУК,
		РасписаниеВУК,
		Протокол,
		ТолькоПроверка,
		"ВУК");

	Если Не ТолькоПроверка Тогда
		ОбъектОбработки.Записать();
		ДобавитьВПротокол(Протокол, "Элемент справочника записан.");
	Иначе
		ДобавитьВПротокол(Протокол, "Запись не выполнялась (режим проверки).");
	КонецЕсли;

	// Итоговая сверка
	ДобавитьВПротокол(Протокол, "----- Итог -----");
	Если СтрокаРасторжение <> Неопределено Тогда
		ДобавитьВПротокол(Протокол, ОписаниеСостоянияКоманды(СтрокаРасторжение, "Расторжение"));
	КонецЕсли;
	ДобавитьВПротокол(Протокол, ОписаниеСостоянияКоманды(СтрокаВУК, "ВУК"));

	Если СтрокаРасторжение <> Неопределено
		И ЗначениеЗаполнено(СтрокаРасторжение.РегламентноеЗаданиеGUID)
		И СтрокаРасторжение.РегламентноеЗаданиеGUID <> ПустойGUID
		И СтрокаРасторжение.РегламентноеЗаданиеGUID = СтрокаВУК.РегламентноеЗаданиеGUID Тогда
		ДобавитьВПротокол(Протокол, "ОШИБКА: GUID всё ещё общий.");
	Иначе
		ДобавитьВПротокол(Протокол, "OK: GUID команд различны (или один из них пуст до создания задания).");
	КонецЕсли;

	Возврат СтрСоединить(Протокол, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьВПротокол(Протокол, Текст)

	Протокол.Добавить(Формат(ТекущаяДатаСеанса(), "ДФ='HH:mm:ss'") + "  " + Текст);

КонецПроцедуры

Функция НайтиСтрокуКоманды(ОбъектОбработки, Идентификатор)

	Найденные = ОбъектОбработки.Команды.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
	Если Найденные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Найденные[0];

КонецФункции

Процедура РазвязатьДублиGUID(ОбъектОбработки, ИдПриоритета, ПустойGUID, Протокол, ТолькоПроверка)

	Группы = Новый Соответствие;

	Для Каждого СтрокаКоманды Из ОбъектОбработки.Команды Цикл

		Если СтрокаКоманды.ВариантЗапуска
			<> Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаКоманды.РегламентноеЗаданиеGUID)
			Или СтрокаКоманды.РегламентноеЗаданиеGUID = ПустойGUID Тогда
			Продолжить;
		КонецЕсли;

		КлючGUID = Строка(СтрокаКоманды.РегламентноеЗаданиеGUID);
		Список = Группы.Получить(КлючGUID);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Группы.Вставить(КлючGUID, Список);
		КонецЕсли;
		Список.Добавить(СтрокаКоманды);

	КонецЦикла;

	Для Каждого КлючИЗначение Из Группы Цикл

		Список = КлючИЗначение.Значение;
		Если Список.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьВПротокол(Протокол,
			"Дубль GUID " + КлючИЗначение.Ключ + " у " + Формат(Список.Количество(), "ЧГ=0") + " команд.");

		Владелец = Неопределено;
		Для Каждого СтрокаКоманды Из Список Цикл
			Если СтрокаКоманды.Идентификатор = ИдПриоритета Тогда
				Владелец = СтрокаКоманды;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Владелец = Неопределено Тогда
			Владелец = Список[0];
		КонецЕсли;

		Для Каждого СтрокаКоманды Из Список Цикл
			Если СтрокаКоманды = Владелец Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьВПротокол(Протокол,
				"  сброс GUID у «" + СтрокаКоманды.Представление + "» (оставляем у «"
				+ Владелец.Представление + "»).");
			Если Не ТолькоПроверка Тогда
				СтрокаКоманды.РегламентноеЗаданиеGUID = ПустойGUID;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Процедура ОбеспечитьЗаданиеКоманды(ОбъектОбработки, СтрокаКоманды, СсылкаОбработки,
	ПользовательЗаданий, КлючЗадания, РасписаниеДляУстановки, Протокол, ТолькоПроверка, Метка)

	ПустойGUID = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Задание = Неопределено;

	Если ЗначениеЗаполнено(СтрокаКоманды.РегламентноеЗаданиеGUID)
		И СтрокаКоманды.РегламентноеЗаданиеGUID <> ПустойGUID Тогда
		Задание = ДополнительныеОтчетыИОбработки.НайтиРегламентноеЗадание(
			СтрокаКоманды.РегламентноеЗаданиеGUID, Истина);
	КонецЕсли;

	Если Задание = Неопределено Тогда

		ДобавитьВПротокол(Протокол, Метка + ": регламентное задание не найдено — нужно создать.");

		Если ТолькоПроверка Тогда
			Возврат;
		КонецЕсли;

		Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание("ЗапускДополнительныхОбработок");
		Задание.Использование = Ложь;
		Задание.Наименование = Лев(ПредставлениеЗаданияОбработки(ОбъектОбработки, СтрокаКоманды), 120);
		Задание.Записать();

		СтрокаКоманды.РегламентноеЗаданиеGUID = Задание.УникальныйИдентификатор;
		ДобавитьВПротокол(Протокол, Метка + ": создано задание GUID=" + Строка(Задание.УникальныйИдентификатор));

	Иначе
		ДобавитьВПротокол(Протокол, Метка + ": задание найдено GUID=" + Строка(Задание.УникальныйИдентификатор)
			+ "; расписание: " + Строка(Задание.Расписание));
	КонецЕсли;

	Если ТолькоПроверка Тогда
		Возврат;
	КонецЕсли;

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(СсылкаОбработки);
	ПараметрыЗадания.Добавить(СтрокаКоманды.Идентификатор);

	Задание.Наименование = Лев(ПредставлениеЗаданияОбработки(ОбъектОбработки, СтрокаКоманды), 120);
	Задание.Параметры = ПараметрыЗадания;
	Задание.Использование = Истина;

	Если РасписаниеДляУстановки <> Неопределено Тогда
		Задание.Расписание = РасписаниеДляУстановки;
		ДобавитьВПротокол(Протокол, Метка + ": установлено расписание: " + Строка(РасписаниеДляУстановки));
	КонецЕсли;

	Если ЗначениеЗаполнено(ПользовательЗаданий) Тогда
		Задание.ИмяПользователя = ПользовательЗаданий;
		ДобавитьВПротокол(Протокол, Метка + ": пользователь задания = " + ПользовательЗаданий);
	КонецЕсли;

	Если ЗначениеЗаполнено(КлючЗадания) Тогда
		Задание.Ключ = КлючЗадания;
		ДобавитьВПротокол(Протокол, Метка + ": ключ задания = " + КлючЗадания);
	КонецЕсли;

	Задание.Записать();
	ДобавитьВПротокол(Протокол, Метка + ": задание записано.");

КонецПроцедуры

Функция ПредставлениеЗаданияОбработки(ОбъектОбработки, СтрокаКоманды)

	Возврат СокрЛП(ОбъектОбработки.Вид)
		+ ": "
		+ СокрЛП(ОбъектОбработки.Наименование)
		+ " / "
		+ НСтр("ru = 'Команда'")
		+ ": "
		+ СокрЛП(СтрокаКоманды.Представление);

КонецФункции

Функция РасписаниеКвартальногоНачисления()

	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ДатаНачала = НачалоДня(ТекущаяДатаСеанса());
	Расписание.ВремяНачала = Дата(1, 1, 1, 0, 15, 0);
	Расписание.ДеньВМесяце = 1;

	Месяцы = Новый Массив;
	Месяцы.Добавить(1);
	Месяцы.Добавить(4);
	Месяцы.Добавить(7);
	Месяцы.Добавить(10);
	Расписание.Месяцы = Месяцы;

	Возврат Расписание;

КонецФункции

Функция ОписаниеСостоянияКоманды(СтрокаКоманды, Метка)

	ПустойGUID = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Текст = Метка + ": GUID=" + Строка(СтрокаКоманды.РегламентноеЗаданиеGUID);

	Если Не ЗначениеЗаполнено(СтрокаКоманды.РегламентноеЗаданиеGUID)
		Или СтрокаКоманды.РегламентноеЗаданиеGUID = ПустойGUID Тогда
		Возврат Текст + "; задание не привязано.";
	КонецЕсли;

	Задание = ДополнительныеОтчетыИОбработки.НайтиРегламентноеЗадание(
		СтрокаКоманды.РегламентноеЗаданиеGUID, Истина);
	Если Задание = Неопределено Тогда
		Возврат Текст + "; задание в ИБ НЕ найдено.";
	КонецЕсли;

	Возврат Текст
		+ "; использование=" + ?(Задание.Использование, "Да", "Нет")
		+ "; ключ=" + Задание.Ключ
		+ "; пользователь=" + Задание.ИмяПользователя
		+ "; расписание=" + Строка(Задание.Расписание);

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
