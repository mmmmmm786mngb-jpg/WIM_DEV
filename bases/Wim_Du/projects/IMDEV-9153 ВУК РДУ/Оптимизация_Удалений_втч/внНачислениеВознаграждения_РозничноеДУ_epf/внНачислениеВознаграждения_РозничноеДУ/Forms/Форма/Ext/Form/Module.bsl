#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДополнительнаяОбработкаСсылка = Неопределено;
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Заголовок = "Начисление вознаграждения за управление: Розничное ДУ. Версия - " + ОбработкаОбъект.СведенияОВнешнейОбработке().Версия;
	
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка) Тогда
		Если ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда
			ИмяОбработки = ОбработкаОбъект.Метаданные().Имя;
			ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбработки);
		КонецЕсли;
	Иначе
		ИмяОбработки = ОбработкаОбъект.Метаданные().Имя;
		ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбработки);
	КонецЕсли;
	
	Если ДополнительнаяОбработкаСсылка <> Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда
		Настройки = ДополнительнаяОбработкаСсылка.ХранилищеНастроек.Получить();
		ОбработкаОбъект.УстановитьПользовательскиеНастройки(Настройки);
		
		ДопОбработка = ДополнительнаяОбработкаСсылка;
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	КонецЕсли;
	
	//Объект.ДоговорыДУ.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ДоговорДУ");
	
КонецПроцедуры

&НаСервере
Процедура ДоговорыКНачислениюНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ДоговорыКНачислению();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ДоговорыКНачислению(Команда)
	ДоговорыКНачислениюНаСервере();
КонецПроцедуры

&НаСервере
Процедура НачислитьНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	// IMDEV-9153: ссылка доп.обработки нужна для параллельного запуска пачек в фоне.
	// Если обработка не зарегистрирована в справочнике — отработает последовательный режим.
	ДополнительнаяОбработкаСсылка = СсылкаДополнительнойОбработки(ОбработкаОбъект);
	ОбработкаОбъект.СоздатьНачисления(ДополнительнаяОбработкаСсылка);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаСервере
Функция СсылкаДополнительнойОбработки(ОбработкаОбъект)
	ИмяОбработки = ОбработкаОбъект.Метаданные().Имя;
	Возврат Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбработки);
КонецФункции

&НаКлиенте
Процедура Начислить(Команда)
	НачислитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОбязательства(Команда)

	Если Объект.ДоговорыДУКНачислению.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			"Табличная часть пуста. Сначала нажмите «Выбрать», чтобы заполнить договоры.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Будут удалены обязательства (документы ОперацияБух / движения регистра ОбязательстваПоДС)"
		+ Символы.ПС + "по договорам из табличной части, для которых УЖЕ существуют начисления вознаграждения"
		+ Символы.ПС + "(и по договорам с нулевой суммой вознаграждения - как в обычном режиме)."
		+ Символы.ПС + Символы.ПС + "Новые начисления создаваться НЕ будут."
		+ Символы.ПС + Символы.ПС + "Продолжить удаление обязательств?";

	Оповещение = Новый ОписаниеОповещения("УдалитьОбязательстваПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьОбязательстваПослеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	УдалитьОбязательстваНаСервере();

КонецПроцедуры

&НаСервере
Процедура УдалитьОбязательстваНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.УдалитьОбязательстваПоНачислениям();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

#КонецОбласти

