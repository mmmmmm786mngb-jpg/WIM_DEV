Функция СЧА_РСА_НаДату(Дата, Отбор = Неопределено) Экспорт

	Условие = "";
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли; 
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", НачалоДня(Дата));
	Запрос.УстановитьПараметр("СписокТиповПортфелейПИФ", СписокТиповПортфелейПИФ());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Мандат,
	|	МАКСИМУМ(т.Период) КАК Период
	|ПОМЕСТИТЬ втПериоды
	|ИЗ
	|	РегистрСведений.РыночнаяСтоимостьПозиции.СрезПоследних(&ДатаОкончанияПериода, (Мандат <> ЗНАЧЕНИЕ(Справочник.Мандаты.НеОпределен) И (Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Мандат.ДатаОкончания > &ДатаОкончанияПериода)) &УсловиеОтбора) КАК т
	|ГДЕ
	|	т.Период >= ДОБАВИТЬКДАТЕ(&ДатаОкончанияПериода, ДЕНЬ, -10)
	|	И НЕ т.Мандат.ТипМандата В (&СписокТиповПортфелейПИФ)
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Мандат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПериоды.Мандат,
	|	втПериоды.Период,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(т.Регистратор.Кратность, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(т.Сумма, 0) * ЕСТЬNULL(т.Регистратор.Курс, 0) / ЕСТЬNULL(т.Регистратор.Кратность, 0)
	|		КОНЕЦ) КАК РСА,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(т.Регистратор.Кратность, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(т.Сумма, 0) * ЕСТЬNULL(т.Регистратор.Курс, 0) / ЕСТЬNULL(т.Регистратор.Кратность, 0)
	|		КОНЕЦ) КАК СЧА
	|ИЗ
	|	втПериоды КАК втПериоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РыночнаяСтоимостьПозиции.СрезПоследних(&ДатаОкончанияПериода, (Мандат <> ЗНАЧЕНИЕ(Справочник.Мандаты.НеОпределен) И (Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Мандат.ДатаОкончания > &ДатаОкончанияПериода)) &УсловиеОтбора) КАК т
	|		ПО втПериоды.Период = т.Период
	|			И втПериоды.Мандат = т.Мандат
	|
	|СГРУППИРОВАТЬ ПО
	|	втПериоды.Мандат,
	|	втПериоды.Период";
	
	
	Условие = "";
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("Мандаты") Тогда
			Условие = " И Мандат В (&Мандаты)";
			Запрос.УстановитьПараметр("Мандаты", Отбор.Мандаты);
		КонецЕсли; 
		Если Отбор.Свойство("СчетаМандатов") Тогда
			
			Условие = " И СчетМандата В (&СчетаМандатов)";
			Запрос.УстановитьПараметр("СчетаМандатов", Отбор.СчетаМандатов);
			
			Запрос.УстановитьПараметр("Мандаты", Отбор.ОтборМандаты);
			
		КонецЕсли;
	КонецЕсли;
	
	Если ОтборМандат Тогда
		ПроверитьУсловиеМандатыОтбор(Условие, Истина);	
		Запрос.УстановитьПараметр("СписМандатОтбор", СписМандатОтбор);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", Условие);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСоединения", " И " + Условие);
	
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Регистр ""Денежные средства"": Денежные средства");
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ДоходыКПолучениюНаДату()

Процедура СЧА_РСА_НаДату_ДополнитьПИФ(НаДату, тз, Отказ = Ложь, ТекстСообщений = "", Отбор)
	
	ствОтборПИФ = новый Соответствие;
	стрОтборПИФ = "";
	списМандаты = новый Массив;
	списСчета = новый Массив;
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("Мандаты") Тогда
			СтрокаУсловие = "Мандат В (&Мандаты)";
			//ПроверитьУсловиеМандатыОтбор(СтрокаУсловие);
			списМандаты =  Отбор.Мандаты;
		КонецЕсли;
		
		Если Отбор.Свойство("СчетаМандатов") Тогда
			списСчета = Отбор.СчетаМандатов;
			списМандаты = новый Массив;
			
			Для каждого СчетМандата_ из Отбор.СчетаМандатов Цикл
				списМандаты.Добавить(СчетМандата_.Владелец);
			КонецЦикла;
			
		КонецЕсли; 
	КонецЕсли;
	
	Если списМандаты.Количество() > 0 Тогда
		стрОтборПИФ = "Мандат";
		Для каждого сс Из списМандаты Цикл
			ствОтборПИФ.Вставить(сс, Истина);
		КонецЦикла;
	КонецЕсли;
	
	//СерверПИФ = "AMMGAVANCORE";
	//БазаПИФ = "PROD_AVC_PIF";
	СерверПИФ = "SMSK02MG31U";
	БазаПИФ = "AVC_PP_PIF";
	ЛогинПИФ = "svc_avancore";
	ПарольПИФ = "адм232882";
	
	Попытка
		Внешняя = Новый COMObject("V83.ComConnector");  
		БазаПИФ = Внешняя.Connect("Srvr=""" + СерверПИФ + """;Ref=""" + БазаПИФ + """;Usr=""" + ЛогинПИФ + """;Pwd=""" + ПарольПИФ + """");
	Исключение
		Отказ = Истина;
		ТекстСообщений = ТекстСообщений + Символы.ПС + ОписаниеОшибки();
		Сообщить(ТекстСообщений);
		Возврат;
	КонецПопытки;

	Запрос = БазаПИФ.NewObject("Запрос");
	Запрос.Параметры.Вставить("НаДату", НачалоДня(НаДату));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	т.Период КАК Период,
	|	т.ПИФ КАК ПИФ,
	|	т.СЧА КАК СЧА,
	|		т.СЧА КАК РСА
	|ИЗ
	|	РегистрСведений.СтоимостьЧистыхАктивов.СрезПоследних(&НаДату, ) КАК т";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		пифМандат = ПолучитьСсылкуПоCom(БазаПИФ, Выборка.ПИФ);
		//пифСчетМандата = ПолучитьСчетМандатаПИФ(пифМандат, Выборка.НомерСчета);
		
		Если стрОтборПИФ = "Мандат" Тогда
			Если ствОтборПИФ[пифМандат] = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		//ИначеЕсли стрОтбор = "СчетМандата" Тогда
		//	Если ствОбор[пифСчетМандата] = Неопределено Тогда
		//		Продолжить;
		//	КонецЕсли;
		КонецЕсли;
		
		НовСтрока = тз.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
		НовСтрока.Мандат = пифМандат;
		//НовСтрока.СчетМандата = пифСчетМандата;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает текст запроса для функции "ДоходыКПолучениюНаДату"
// MID-117 заменил регистр НКД на ЦенныеБумаги + ЗафиксированыеКотировки
Функция ПолучитьТекстЗапросаЦенныеБумагиНаДату()
	
	Возврат
	"ВЫБРАТЬ
	|	т.Период КАК Период,
	|	т.Валюта КАК Валюта,
	|	т.ИсточникКурса КАК ИсточникКурса,
	|	т.Курс КАК Курс,
	|	т.Кратность КАК Кратность
	|ПОМЕСТИТЬ втКурсы
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаОкончанияПериода, ) КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Мандат,
	|	т.СчетМандата КАК СчетМандата,
	|	т.Актив КАК Актив,
	|	т.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ втОстатки
	|ИЗ
	|	РегистрНакопления.ЦенныеБумаги.Остатки(
	|			&ДатаОкончанияПериода,
	|			Актив.Объект.ВыгружатьФО = ИСТИНА
	|				И Мандат <> ЗНАЧЕНИЕ(Справочник.Мандаты.НеОпределен) И (Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Мандат.ДатаОкончания > &ДатаОкончанияПериода) &УсловиеОтбора) КАК т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Мандат,
	|	Актив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Мандат КАК Мандат,
	|	т.Актив КАК Актив,
	|	т.КотировкаУУ * ЕСТЬNULL(тКурсКотировки.Курс, 0) / ЕСТЬNULL(тКурсКотировки.Кратность, 1) КАК Котировка,
	|	т.Период КАК Период,
	|	т.НоминалОблигации КАК НоминалОблигации,
	|	т.Биржа КАК Биржа
	|ПОМЕСТИТЬ ВтЦены
	|ИЗ
	|	РегистрСведений.ЗафиксированныеКотировки.СрезПоследних(
	|			&ДатаОкончанияПериода,
	|			(Мандат, Актив) В (ВЫБРАТЬ Мандат, Актив ИЗ втОстатки КАК втОстатки)) КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсы КАК тКурсКотировки
	|		ПО т.ВалютаУУ = тКурсКотировки.Валюта
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Мандат,
	|	Актив,
	|	Биржа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Котировки.Период) КАК Период,
	|	Котировки.Актив
	|ПОМЕСТИТЬ ВтАктивДатаКотировка
	|ИЗ
	|	РегистрСведений.КотировкиЦБНаБирже.СрезПоследних(&ДатаОкончанияПериода, Актив В (ВЫБРАТЬ Актив ИЗ втОстатки КАК втОстатки)) КАК Котировки
	|
	|СГРУППИРОВАТЬ ПО
	|	Котировки.Актив
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Актив,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Котировки.Актив КАК Актив,
	|	Котировки.НКД * ЕСТЬNULL(тКурсНКД.Курс, 0) / ЕСТЬNULL(тКурсНКД.Кратность, 1) КАК КотировкаНКД,
	|	Котировки.Период КАК Период,
	|	Котировки.Валюта,
	|	Котировки.Биржа КАК Биржа,
	|	ВтЦены.Мандат КАК Мандат
	|ПОМЕСТИТЬ ВтНКД
	|ИЗ
	|	РегистрСведений.КотировкиЦБНаБирже.СрезПоследних(&ДатаОкончанияПериода, Актив В (ВЫБРАТЬ Актив ИЗ втОстатки КАК втОстатки) И НЕ Биржа = &Биржа) КАК Котировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсы КАК тКурсНКД
	|		ПО Котировки.Валюта = тКурсНКД.Валюта
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтЦены КАК ВтЦены
	|		ПО Котировки.Актив = ВтЦены.Актив
	|			И Котировки.Биржа = ВтЦены.Биржа
	|ГДЕ
	|	Котировки.Активность = ИСТИНА
	|	И ЕСТЬNULL(Котировки.НКД, 0) <> 0
	|	И Котировки.Период В
	|			(ВЫБРАТЬ
	|				ВтАктивДатаКотировка.Период
	|			ИЗ
	|				ВтАктивДатаКотировка
	|			ГДЕ
	|				ВтАктивДатаКотировка.Актив = Котировки.Актив)
	|	И (Котировки.Актив, Котировки.Биржа) В
	|			(ВЫБРАТЬ
	|				ВтЦены.Актив,
	|				ВтЦены.Биржа
	|			ИЗ
	|				ВтЦены КАК ВтЦены)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Актив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Мандат,
	|	Остатки.СчетМандата,
	|	Остатки.Актив,
	|	Остатки.Количество КАК Количество,
	|	Остатки.Количество * ЕСТЬNULL(ВтЦены.Котировка, 0) КАК Стоимость,
	|	Остатки.Количество * ЕСТЬNULL(ВтНКД.КотировкаНКД, 0) КАК СуммаНКД,
	|	ВтНКД.Валюта,
	|	ВтНКД.Биржа,
	|	0 КАК Задолженость
	|ИЗ
	|	втОстатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтЦены КАК ВтЦены
	|		ПО Остатки.Мандат = ВтЦены.Мандат
	|			И Остатки.Актив = ВтЦены.Актив
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтНКД КАК ВтНКД
	|		ПО Остатки.Актив = ВтНКД.Актив
	|			И Остатки.Мандат = ВтНКД.Мандат";
	
КонецФункции // ПолучитьТекстЗапросаЦенныеБумагиНаДату()
