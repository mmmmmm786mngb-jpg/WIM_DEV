Функция ПолучитьИсполнение(ПозицияФО, Отбор = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТБ.Мандат КАК Мандат,
		|	ТБ.Валюта КАК Валюта,
		|	ТБ.Актив КАК Актив
		|ПОМЕСТИТЬ ВТ_МандатАктив
		|ИЗ
		|	&ТабМандатАктив КАК ТБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИСТИНА КАК Проведен,
		|	ПлановаяПозицияПоЦеннымБумагам.Сделка КАК Сделка,
		|	ПлановаяПозицияПоЦеннымБумагам.Актив КАК Актив,
		|	ПлановаяПозицияПоЦеннымБумагам.Мандат КАК Портфель,
		|	ПлановаяПозицияПоЦеннымБумагам.СчетМандата.МестоХранения КАК МестоХранения,
		|	ПлановаяПозицияПоЦеннымБумагам.СчетМандата КАК Субпортфель,
		|	ПлановаяПозицияПоЦеннымБумагам.Количество КАК Количество,
		|	ПлановаяПозицияПоЦеннымБумагам.ВидДвижения КАК ВидДвижение,
		|	ПлановаяПозицияПоЦеннымБумагам.МоментВремени КАК МоментВремени,
		|	ПлановаяПозицияПоЦеннымБумагам.Сделка.НомерСделки
		|ИЗ
		|	РегистрНакопления.ПлановаяПозицияПоЦеннымБумагам КАК ПлановаяПозицияПоЦеннымБумагам
		|ГДЕ
		|	ПлановаяПозицияПоЦеннымБумагам.Период > ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, &КоличестовДнейПроверкиИсполненияСделок)
		|	И (ПлановаяПозицияПоЦеннымБумагам.Сделка.Внебиржевая
		|			ИЛИ ПлановаяПозицияПоЦеннымБумагам.Сделка.КодКласса ПОДОБНО ""DMA%"")
		|	И ВЫБОР
		|			КОГДА ПлановаяПозицияПоЦеннымБумагам.Сделка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление)
		|				ТОГДА ПлановаяПозицияПоЦеннымБумагам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ИНАЧЕ ПлановаяПозицияПоЦеннымБумагам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|		КОНЕЦ
		|	И (ПлановаяПозицияПоЦеннымБумагам.Мандат, ПлановаяПозицияПоЦеннымБумагам.Актив) В
		|			(ВЫБРАТЬ
		|				МандатАктив.Мандат,
		|				МандатАктив.Актив
		|			ИЗ
		|				ВТ_МандатАктив КАК МандатАктив) &УсловиеЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИСТИНА,
		|	ПлановаяПозицияПоДенежнымСредствам.Сделка,
		|	ПлановаяПозицияПоДенежнымСредствам.Валюта,
		|	ПлановаяПозицияПоДенежнымСредствам.Мандат,
		|	ПлановаяПозицияПоДенежнымСредствам.СчетМандата.МестоХранения,
		|	ПлановаяПозицияПоДенежнымСредствам.СчетМандата,
		|	ПлановаяПозицияПоДенежнымСредствам.Сумма,
		|	ПлановаяПозицияПоДенежнымСредствам.ВидДвижения,
		|	ПлановаяПозицияПоДенежнымСредствам.МоментВремени,
		|	ПлановаяПозицияПоДенежнымСредствам.Сделка.НомерСделки
		|ИЗ
		|	РегистрНакопления.ПлановаяПозицияПоДенежнымСредствам КАК ПлановаяПозицияПоДенежнымСредствам
		|ГДЕ
		|	ПлановаяПозицияПоДенежнымСредствам.Период > ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, &КоличестовДнейПроверкиИсполненияСделок)
		|	И (ПлановаяПозицияПоДенежнымСредствам.Сделка.Внебиржевая
		|			ИЛИ ПлановаяПозицияПоДенежнымСредствам.Сделка.КодКласса ПОДОБНО ""DMA%"")
		|	И ВЫБОР
		|			КОГДА ПлановаяПозицияПоДенежнымСредствам.Сделка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа)
		|				ТОГДА ПлановаяПозицияПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ИНАЧЕ ПлановаяПозицияПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|		КОНЕЦ
		|	И (ПлановаяПозицияПоДенежнымСредствам.Мандат, ПлановаяПозицияПоДенежнымСредствам.Валюта) В
		|			(ВЫБРАТЬ
		|				МандатАктив.Мандат,
		|				МандатАктив.Валюта
		|			ИЗ
		|				ВТ_МандатАктив КАК МандатАктив) &УсловиеДС";
	
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("ТабМандатАктив", ПозицияФО);
	Запрос.УстановитьПараметр("КоличестовДнейПроверкиИсполненияСделок", КоличестовДнейПроверкиИсполненияСделок);
	
	УсловиеЦБ = "";
	УсловиеДС = "";
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("Мандаты") Тогда
			УсловиеЦБ = УсловиеЦБ + " И ПлановаяПозицияПоЦеннымБумагам.Мандат В (&Мандаты)";
			УсловиеДС = УсловиеДС + " И ПлановаяПозицияПоДенежнымСредствам.Мандат В (&Мандаты)";
			Запрос.УстановитьПараметр("Мандаты", Отбор.Мандаты);
		КонецЕсли; 
		Если Отбор.Свойство("СчетаМандатов") Тогда
			
			УсловиеЦБ = УсловиеЦБ + " И ПлановаяПозицияПоЦеннымБумагам.СчетМандата В (&СчетаМандатов)";
			УсловиеДС = УсловиеДС + " И ПлановаяПозицияПоДенежнымСредствам.СчетМандата В (&СчетаМандатов)";
			Запрос.УстановитьПараметр("СчетаМандатов", Отбор.СчетаМандатов);
			
			Запрос.УстановитьПараметр("Мандаты", Отбор.ОтборМандаты);
			
		КонецЕсли;
	КонецЕсли;
	
	Если ОтборМандат Тогда
		Если СписМандатОтбор.Количество() Тогда
			УсловиеЦБ = УсловиеЦБ + " И ПлановаяПозицияПоЦеннымБумагам.Мандат В (&СписМандатОтбор)";
			УсловиеДС = УсловиеДС + " И ПлановаяПозицияПоДенежнымСредствам.Мандат В (&СписМандатОтбор)";
		КонецЕсли;
		Запрос.УстановитьПараметр("СписМандатОтбор", СписМандатОтбор);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЦБ", УсловиеЦБ);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДС", УсловиеДС);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТЗИсполнение = РезультатЗапроса.Выгрузить();
	
	Возврат ТЗИсполнение;
	
КонецФункции // ПолучитьИсполнение() 

