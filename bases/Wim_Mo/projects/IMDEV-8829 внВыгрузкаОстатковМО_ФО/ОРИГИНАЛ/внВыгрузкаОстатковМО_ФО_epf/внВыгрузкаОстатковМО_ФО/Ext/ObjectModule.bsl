Функция СведенияОВнешнейОбработке() Экспорт
	
	МассивСтрокИмен = Новый Массив;
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид","Обмены");
	ПараметрыРегистрации.Вставить("НаправлениеОбмена", Перечисления.НаправленияОбменов.Выгрузка);
	ПараметрыРегистрации.Вставить("Назначение",МассивСтрокИмен);
	ПараметрыРегистрации.Вставить("Наименование", "Выгрузка остатков МО ФО");
	ПараметрыРегистрации.Вставить("Версия", "1.33");
	ПараметрыРегистрации.Вставить("БезопасныйРежим",Ложь);
	ПараметрыРегистрации.Вставить("Информация","Выгрузка остатков МО ФО");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	ПараметрыРегистрации.Вставить("ИспользоватьДляФормыОбъекта", Ложь);
	ПараметрыРегистрации.Вставить("ИспользоватьДляФормыСписка", Истина);
	
	#Область DevOps
	Если ПараметрыРегистрации.Версия = "0.69" Тогда
		//ПараметрыРегистрации.Вставить("ПереименоватьПриЗагрузке", Истина);
		//ПараметрыРегистрации.Вставить("СтароеИмяФайла", "");
		//ПараметрыРегистрации.Вставить("НовоеИмяФайла", 	"");
	КонецЕсли;	
	#КонецОбласти
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд,"Выгрузка остатков МО ФО", "ЗагрузкаFront_MID", "ОткрытиеФормы");
	
	ДобавитьКоманду(ТаблицаКоманд,"Выгрузка остатков МО ФО (в фоне)", "ФоноваяВыгрузка", "ВызовСерверногоМетода");
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды <> "ФоноваяВыгрузка" Тогда Возврат; КонецЕсли;
	
	Если ТипЗнч(ПараметрыВыполненияКоманды) = Тип("Структура") тогда
		Если ПараметрыВыполненияКоманды.Свойство("Узел") Тогда
			ПараметрыВыполненияКоманды.Вставить("Узел", ПараметрыВыполненияКоманды.Узел);
		КонецЕсли;
	КонецЕсли;
	
	ДатаПоз = ТекущаяДата();
	
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	ОписаниеОбменов.ВыполнитьКомандуПоОбменам(ЭтотОбъект, ИдентификаторКоманды, ПараметрыВыполненияКоманды, ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка.БезопасныйРежим);
	
КонецПроцедуры

#КонецОбласти

#Область DevOps

Процедура ЗагрузитьНастройки(ПараметрыРегистрации) Экспорт
	
	ВерсияПрименения = "1.02";
	ТекущаяРегистрация = СведенияОВнешнейОбработке();
	Если ВерсияПрименения = ТекущаяРегистрация.Версия Тогда
		ПараметрыРегистрации.Вставить("ЗагружатьНастройки", Истина);
		НастройкиПоУмолчанию(ЭтотОбъект);
		ЗаголовокНастроек = "";
		ЗначенияПараметров = УстановитьПараметры(ЗаголовокНастроек);
		ПараметрыРегистрации.Вставить("Настройки", Новый Структура("Значения, ЗаголовокНастроек", ЗначенияПараметров, ЗаголовокНастроек));
	КонецЕсли;	
	
КонецПроцедуры

