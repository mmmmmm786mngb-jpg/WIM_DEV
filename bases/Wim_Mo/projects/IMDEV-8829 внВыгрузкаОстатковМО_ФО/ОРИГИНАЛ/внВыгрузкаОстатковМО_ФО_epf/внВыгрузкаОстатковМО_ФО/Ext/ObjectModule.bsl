	//
	//Если ТЗАктивыРЕПО.Количество()>0 Тогда
	//	ОпубликоватьАктивыРЕПО(ФабрикаСервиса, Прокси, ДатаПубликации, ТЗАктивыРЕПО);
	//КонецЕсли;
		
	ВыполнитьРассылкуПоПерерасчетуРСА(ФабрикаСервиса, Прокси, ИдентификаторСеанса, НачалоОбработки, ТекущаяДатаСеанса());
	
	//Если ВыгружатьРейтинги Тогда
	//	ЗаполнитьРейтинги(Прокси, ФабрикаСервиса);
