	обХДТО.РеквизитыПоВидуОперации.РЕПО.СрокРЕПО = СтрокаСделкиРЕПО.СделкаРЕПО.СрокРЕПО;
	обХДТО.РеквизитыПоВидуОперации.РЕПО.СтавкаРЕПО = СтрокаСделкиРЕПО.СделкаРЕПО.СтавкаРЕПО;
	обХДТО.РеквизитыПоВидуОперации.РЕПО.Субпортфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоСубпортфельПоиск(СтрокаСделкиРЕПО.Субпортфель, ФабрикаСервиса);
	обХДТО.РеквизитыПоВидуОперации.РЕПО.СубпортфельЦБ = ПроцедурыФункцииОбмена_МО_ФО.хдтоСубпортфельПоиск(СтрокаСделкиРЕПО.СубпортфельЦБ, ФабрикаСервиса);
	
	обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО = ФабрикаСервиса.Создать(обХДТО.РеквизитыПоВидуОперации.РЕПО.Свойства().Получить("РеквизитыПоВидуРЕПО").Тип);
	
	Если СтрокаСделкиРЕПО.СделкаСЦК Тогда
		обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО_С_ЦК = ФабрикаСервиса.Создать(обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.Свойства().Получить("СделкаРЕПО_С_ЦК").Тип);
		обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО_С_ЦК.ЗаполнениеПоСумме = ФабрикаСервиса.Создать(обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО_С_ЦК.Свойства().Получить("ЗаполнениеПоСумме").Тип); 				
