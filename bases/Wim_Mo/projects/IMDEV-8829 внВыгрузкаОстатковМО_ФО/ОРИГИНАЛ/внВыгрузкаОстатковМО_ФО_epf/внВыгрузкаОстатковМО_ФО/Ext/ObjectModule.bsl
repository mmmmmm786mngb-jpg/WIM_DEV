Процедура ДобавитьЗаблокированныеДенежныеСредства(Дата)
	
	ТаблицаДенежныеСредства = ДенежныеСредства.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТаблицаДенежныеСредства.Мандат,
	|	ТаблицаДенежныеСредства.СчетМандата,
	|	ТаблицаДенежныеСредства.Валюта,
	|	ТаблицаДенежныеСредства.ВходящийОстаток,
	|	ТаблицаДенежныеСредства.ДневнойОборот,
	|	ТаблицаДенежныеСредства.РЕПО
	|ПОМЕСТИТЬ ДС_КВыгрузке
	|ИЗ
	|	&ТаблицаДС КАК ТаблицаДенежныеСредства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДенежныеСредстваЗаблокированныеОстатки.Мандат,
	|	ДенежныеСредстваЗаблокированныеОстатки.СчетМандата,
	|	ДенежныеСредстваЗаблокированныеОстатки.Валюта,
	|	СУММА(ДенежныеСредстваЗаблокированныеОстатки.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток
	|ПОМЕСТИТЬ ДС_Заблокированные
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваЗаблокированные.Остатки(&Дата, ) КАК ДенежныеСредстваЗаблокированныеОстатки
	// IMAPPS-13192 -->
	|	ГДЕ  ДенежныеСредстваЗаблокированныеОстатки.ВалютнаяСуммаОстаток >=0
	// IMAPPS-13192 <--
	|
	|СГРУППИРОВАТЬ ПО
	|	ДенежныеСредстваЗаблокированныеОстатки.Мандат,
	|	ДенежныеСредстваЗаблокированныеОстатки.СчетМандата,
	|	ДенежныеСредстваЗаблокированныеОстатки.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДС_КВыгрузке.Мандат,
	|	ДС_КВыгрузке.СчетМандата,
	|	ДС_КВыгрузке.Валюта,
	|	ДС_КВыгрузке.ВходящийОстаток,
	|	ДС_КВыгрузке.ДневнойОборот,
	|	ДС_КВыгрузке.РЕПО,
	|	ЕСТЬNULL(ДС_Заблокированные.ВалютнаяСуммаОстаток, 0) КАК Заблокировано
	|ИЗ
	|	ДС_КВыгрузке КАК ДС_КВыгрузке
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДС_Заблокированные КАК ДС_Заблокированные
	|		ПО ДС_КВыгрузке.Мандат = ДС_Заблокированные.Мандат
	|			И ДС_КВыгрузке.СчетМандата = ДС_Заблокированные.СчетМандата
	|			И ДС_КВыгрузке.Валюта = ДС_Заблокированные.Валюта";
	
	Запрос.УстановитьПараметр("Дата", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ТаблицаДС", ТаблицаДенежныеСредства);
	ДенежныеСредства.Загрузить(Запрос.Выполнить().Выгрузить());

