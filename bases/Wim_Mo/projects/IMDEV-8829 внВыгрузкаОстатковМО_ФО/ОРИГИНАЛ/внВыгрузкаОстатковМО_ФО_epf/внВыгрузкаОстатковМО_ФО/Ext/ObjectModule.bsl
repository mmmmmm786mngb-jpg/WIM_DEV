// Возвращает данные по ценным бумагам на дату находящиеся в РЕПО 
//
// Параметры:
//  Дата  - Дата - Дата, на которую будут получены данные
//  Отбор - Структура - структура отбора данных, содержащая одно из полей:
//						[Мандаты] - Массив - Массив ссылок Справочник.Мандаты
//                      [СчетаМандатов] - Массив ссылок Справочник.СчетаМандатов
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица данных по денежным средствам на дату
//
Функция РЕПОЦенныеБумагиНаДату(Дата, Отбор) Экспорт

	Условие = "";
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли; 
	
	Запрос = Новый Запрос(ПолучитьТекстЗапросаРЕПОЦенныеБумагиНаДату());
	Запрос.УстановитьПараметр("Дата", Дата); // Параметр нужен для отображения в логе
	//Запрос.УстановитьПараметр("ДатаНачалаПериода", Новый Граница(НачалоДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("Мандаты") Тогда
			Условие = "Мандат В (&Мандаты)";
			Запрос.УстановитьПараметр("Мандаты", Отбор.Мандаты);
		КонецЕсли; 
		Если Отбор.Свойство("СчетаМандатов") Тогда
			Условие = Условие + ?(ПустаяСтрока(Условие), "", " И ");
			Условие = "СчетМандата В (&СчетаМандатов)";
			Запрос.УстановитьПараметр("СчетаМандатов", Отбор.СчетаМандатов);
		КонецЕсли; 
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Регистр ""Ценные бумаги, отданные/полученные по РЕПО"": Денежные средства на дату");
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	
КонецФункции // РЕПОЦенныеБумагиНаДату()

// Возвращает текст запроса для функции "ЦенныеБумагиРЕПОНаДату"
//
Функция ПолучитьТекстЗапросаРЕПОЦенныеБумагиНаДату()

	Возврат
	"ВЫБРАТЬ
	|	ЦенныеБумагиОтданныеВРЕПО.СчетМандата КАК СчетМандата,
	|	ЦенныеБумагиОтданныеВРЕПО.Актив КАК Актив,
	|	0 КАК ВходящийОстаток,
	|	0 КАК ДневнойОборот,
	|	ВЫРАЗИТЬ(ЦенныеБумагиОтданныеВРЕПО.Актив.Объект КАК Справочник.Облигации).ВалютаНоминальнойСтоимости КАК ВалютаНоминальнойСтоимости,
