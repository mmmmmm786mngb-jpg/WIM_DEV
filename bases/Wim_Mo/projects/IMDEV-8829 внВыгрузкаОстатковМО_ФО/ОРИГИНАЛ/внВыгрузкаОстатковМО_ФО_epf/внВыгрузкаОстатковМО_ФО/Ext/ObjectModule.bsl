Процедура хдтоДобавитьВПакетУстановкаРейтингаПоЭмитенту(обПакет, ссДок, ФабрикаСервиса)
	
	//ссДОк = Документы.УстановкаРейтингаПоЭмитенту.ПустаяСсылка();
	типХДТО	 = ФабрикаСервиса.Тип(ПространствоИменСервиса, "УстановкаРейтингаПоЭмитенту");
	обХДТО = ФабрикаСервиса.Создать(типХДТО);
	обХДТО.ВнешнийКод = СокрЛП(ссДок.УникальныйИдентификатор());
	обХДТО.Дата = ссДок.Дата;
	обХДТО.РучнаяКорректировка = Ложь;
	обХДТО.Проведен = ссДок.Проведен;
	обХДТО.ПометкаУдаления  = ссДок.ПометкаУдаления;
	обХДТО.Агентство = ПроцедурыФункцииОбмена_МО_ФО.хдтоКонтрагентПоиск(ссДок.Агентство, ФабрикаСервиса);
	обХДТО.Эмитент = ПроцедурыФункцииОбмена_МО_ФО.хдтоКонтрагентПоиск(ссДок.Эмитент, ФабрикаСервиса);
	
	типХДТО_РА = обХДТО.Свойства().Получить("РейтинговыеАгентства").Тип;
	Для каждого СтрокаДок из ссДок.РейтинговыеАгентства Цикл
		обХДТО_РА = ФабрикаСервиса.Создать(типХДТО_РА);
		обХДТО_РА.ШкалаРейтингов = ПроцедурыФункцииОбмена_МО_ФО.хдтоШкалаРейтинговПоиск(СтрокаДок.ШкалаРейтингов, ФабрикаСервиса);
		обХДТО_РА.Рейтинг = ПроцедурыФункцииОбмена_МО_ФО.хдтоРейтингПоиск(СтрокаДок.Рейтинг, ФабрикаСервиса);
		//обХДТО_РА.ПрогнозныйРейтинг = "";
		обХДТО.РейтинговыеАгентства.Добавить(обХДТО_РА);
	КонецЦикла;
	
	типХДТО_Выпуск = обХДТО.Свойства().Получить("РейтингиПоВыпускам").Тип;
	Для каждого СтрокаДок из ссДок.РейтингиПоВыпускам Цикл
		обХДТО_Выпуск = ФабрикаСервиса.Создать(типХДТО_Выпуск);
		обХДТО_Выпуск.Актив = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПоиск(СтрокаДок.Актив, ФабрикаСервиса);
		обХДТО_Выпуск.ШкалаРейтингов = ПроцедурыФункцииОбмена_МО_ФО.хдтоШкалаРейтинговПоиск(СтрокаДок.ШкалаРейтингов, ФабрикаСервиса);
		обХДТО_Выпуск.Рейтинг = ПроцедурыФункцииОбмена_МО_ФО.хдтоРейтингПоиск(СтрокаДок.Рейтинг, ФабрикаСервиса);
		//обХДТО_Выпуск.ПрогнозныйРейтинг = "";
		обХДТО.РейтингиПоВыпускам.Добавить(обХДТО_Выпуск);
	КонецЦикла;
	
	обПакет.Документы.УстановкаРейтингаПоЭмитенту.Добавить(обХДТО);
	
КонецПроцедуры

Функция РазрешеноДобавитьВПакетСсылку(СсылкаДляВыгрузки)
	
	Ответ = Ложь;
	
	Если не ВыгружатьАктивыСчета Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Если списВыгруженныеОбъекты = Неопределено Тогда
		списВыгруженныеОбъекты = новый Соответствие;
	КонецЕсли;
	
	Если списВыгруженныеОбъекты[СсылкаДляВыгрузки] = Неопределено Тогда
		Ответ = Истина;
		списВыгруженныеОбъекты.Вставить(СсылкаДляВыгрузки, Истина);
	КонецЕсли;
	
	Возврат Ответ;
КонецФункции

