Функция АктивПоВнешнемуКоду(ВнешнийКод)
	
	Если не ЗначениеЗаполнено(ВнешнийКод) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Актив = ДанныеДляРассылки.КэшНайденныхАктивов.Получить(ВнешнийКод);
	
	Если ЗначениеЗаполнено(Актив) Тогда
		Возврат Актив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Активы.Ссылка
	|ИЗ
	|	Справочник.Активы КАК Активы
	|ГДЕ
	|	Активы.ВнешнийКод = &ВнешнийКод";
	
	Запрос.УстановитьПараметр("ВнешнийКод",ВнешнийКод);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеДляРассылки.КэшНайденныхАктивов.Вставить(ВнешнийКод,Выборка.Ссылка);
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

