Процедура СформироватьПакетФлагПозицияНеВыгружена(СоответствиеПортфелей, ФабрикаСервиса, Прокси, ПакетХДТО)
	
	Для каждого сс Из СоответствиеПортфелей Цикл
		
		типПортфель = ФабрикаСервиса.Тип(ПространствоИменСервиса, "Портфель");
		обХДТО = ФабрикаСервиса.Создать(типПортфель);
		обХДТО.ВнешнийКод = сс.Ключ.КодМандата;
		обХДТО.НеполноеОбновление = Истина;
		
		типЭлементХДТО = обХДТО.Свойства().Получить("ДополнительныеСведения").Тип;
		
		элХДТО = ФабрикаСервиса.Создать(типЭлементХДТО);
		элХДТО.Ключ = "Лимиты позиция_выгружена";
		элХДТО.Значение = Ложь;
		обХДТО.ДополнительныеСведения.Добавить(элХДТО);
		ПакетХДТО.Справочники.Портфели.Добавить(обХДТО);
		
	КонецЦикла;
	
	Если вклОтладка Тогда
		обЗапись = Новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ПакетХДТО);
		ТекстовыйЛог.ДобавитьСтроку(обЗапись.Закрыть());
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПакетФлагПозицияВыгружена(СоответствиеПортфелей, ФабрикаСервиса, Прокси, ПакетХДТО)
	
	Если СоответствиеПортфелей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого сс Из СоответствиеПортфелей Цикл
		
		Если сс.Значение = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		типПортфель = ФабрикаСервиса.Тип(ПространствоИменСервиса, "Портфель");
		обХДТО = ФабрикаСервиса.Создать(типПортфель);
		обХДТО.ВнешнийКод = сс.Ключ.КодМандата;
		обХДТО.НеполноеОбновление = Истина;
		
		типЭлементХДТО = обХДТО.Свойства().Получить("ДополнительныеСведения").Тип;
		
		Если СписокТиповПортфелейПИФ().Найти(сс.Ключ.ТипМандата) <> Неопределено Тогда
			элХДТО = ФабрикаСервиса.Создать(типЭлементХДТО); //ПИФ
			элХДТО.Ключ = "Лимиты позиция_выгружена";
			элХДТО.Значение = Истина;
			обХДТО.ДополнительныеСведения.Добавить(элХДТО);
			ПакетХДТО.Справочники.Портфели.Добавить(обХДТО);
		Иначе
			элХДТО = ФабрикаСервиса.Создать(типЭлементХДТО); //ДУ
			элХДТО.Ключ = "Лимиты позиция_выгружена";
			элХДТО.Значение = Ложь;
			обХДТО.ДополнительныеСведения.Добавить(элХДТО);
			
			элХДТО = ФабрикаСервиса.Создать(типЭлементХДТО);
			элХДТО.Ключ = "Лимиты требуется_перерасчет_РСА";
			элХДТО.Значение = Истина;
			обХДТО.ДополнительныеСведения.Добавить(элХДТО);
			
			элХДТО = ФабрикаСервиса.Создать(типЭлементХДТО);
			элХДТО.Ключ = "Лимиты есть_ошибки_выгрузки_позиции";
			элХДТО.Значение = Ложь;
			обХДТО.ДополнительныеСведения.Добавить(элХДТО);
			ПакетХДТО.Справочники.Портфели.Добавить(обХДТО);
		КонецЕсли;
		
	КонецЦикла;
	
	Если вклОтладка Тогда
		обЗапись = Новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ПакетХДТО);
		ТекстовыйЛог.ДобавитьСтроку(обЗапись.Закрыть());
	КонецЕсли;
	
КонецПроцедуры

