// Возвращает данные по денежным средствам на дату находящиеся в РЕПО 
//
// Параметры:
//  Дата  - Дата - Дата, на которую будут получены данные
//  Отбор - Структура - структура отбора данных, содержащая одно из полей:
//						[Мандаты] - Массив - Массив ссылок Справочник.Мандаты
//                      [СчетаМандатов] - Массив ссылок Справочник.СчетаМандатов
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица данных по денежным средствам на дату
//
Функция РЕПОДенежныеСредстваНаДату(Дата, Отбор) Экспорт
	
	Условие = "";
	ДатаЗаполнения =  НачалоДня(Дата);
	
	Запрос = Новый Запрос(ПолучитьТекстЗапросаРЕПОДенежныеСредстваНаДату());
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", Новый Граница(КонецДня(ДатаЗаполнения), ВидГраницы.Включая));
	
	Условие = "Мандат <> ЗНАЧЕНИЕ(Справочник.Мандаты.НеОпределен) И (Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Мандат.ДатаОкончания > &ДатаОкончанияПериода)";
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("Мандаты") Тогда
			Условие = Условие + " И Мандат В (&Мандаты)";
			Запрос.УстановитьПараметр("Мандаты", Отбор.Мандаты);
		КонецЕсли; 
		Если Отбор.Свойство("СчетаМандатов") Тогда
			Условие = Условие + ?(ПустаяСтрока(Условие), "", " И ");
			Условие = "СчетМандата В (&СчетаМандатов)";
			Запрос.УстановитьПараметр("СчетаМандатов", Отбор.СчетаМандатов);
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Регистр ""Денежные средства, отданные/полученные по РЕПО"": Денежные средства на дату");
	
	РезультатЗапроса = Запрос.Выполнить();;
	
	//ДатаЗаполнения =  ДатаПоз+1;//КонецДня(ТекущаяДата());
	СтруктураСервиса = ПолучитьОпределениеСервиса();
	Если СтруктураСервиса.ЕстьОшибки Тогда
		Сообщить(СтруктураСервиса.ОписаниеОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	ВалютаРубли = Справочники.Валюты.RUB;
	
	ПозицияРЕПОФО = ПолучитьРЕПОФО(ДатаЗаполнения, Отбор);
	СделкиРЕПОМО.Очистить();
	
	ВыборкаСделкаРЕПО = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаСделкаРЕПО.Следующий() Цикл
		
		НомерСделки = ВыборкаСделкаРЕПО.НомерСделки;
		ВнешнийКод = ВыборкаСделкаРЕПО.Портфель.КодМандата;
		
		СтруктураПоиск = Новый Структура("НомерСделки, Портфель", ВыборкаСделкаРЕПО.НомерСделки, ВыборкаСделкаРЕПО.Портфель);
		СтрокиПозицияРЕПОФО = ПозицияРЕПОФО.НайтиСтроки(СтруктураПоиск);
		Если СтрокиПозицияРЕПОФО.Количество()>0 Тогда
			Продолжить;
		КонецЕсли;
		
		Определение = СтруктураСервиса.ОпределениеWS;
		ФабрикаСервиса = Определение.ФабрикаXDTO;
		URIПространстваИмен = Определение.Сервисы[0].URIПространстваИмен;
		Прокси = Новый WSПрокси(Определение, URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
		
		Если ЭтотОбъект.АдресWS="http://smsk02mg31u/AVC_PP_FO/ws/avancore_ws.1cws?wsdl" Тогда
			Прокси.Пользователь = "admin";
			Прокси.Пароль = "адм232882";
		КонецЕсли;
		
		ПакетПараметрыЗапроса = хдтоСоздатьПакетЗапросНайтиРЕПО(НомерСделки, ВнешнийКод, ФабрикаСервиса);
		Ответ = Прокси.GetDataOnRequest("СделкаРЕПОПоНомеруИПортфелю", ПакетПараметрыЗапроса);
		
		Рез = ОбработатьОтветПоискРЕПО(Ответ, ФабрикаСервиса, вклОтладка);
		
		Если Не Рез.НайденСделка Тогда
			Если ВыборкаСделкаРЕПО.СделкаРЕПО.Дата>=ДатаНачалоВыгрузкиРЕПО И ДатаНачалоВыгрузкиРЕПО<>Дата(1,1,1) Тогда
				НоваяСделкиРЕПОМО = СделкиРЕПОМО.Добавить();		
				ЗаполнитьЗначенияСвойств(НоваяСделкиРЕПОМО, ВыборкаСделкаРЕПО);
				НоваяСделкиРЕПОМО.ДеньЗаключения = НачалоДня(ВыборкаСделкаРЕПО.СделкаРЕПО.ПлановаяДатаПлатежаПо1Части)=ДатаЗаполнения;
				НоваяСделкиРЕПОМО.ДеньРасчета = НачалоДня(ВыборкаСделкаРЕПО.СделкаРЕПО.ПлановаяДатаПлатежаПо2Части)<=ДатаЗаполнения;
				НоваяСделкиРЕПОМО.Количество = ВыборкаСделкаРЕПО.СделкаРЕПО.Количество;
				НоваяСделкиРЕПОМО.СуммаРЕПО = ?(НоваяСделкиРЕПОМО.ДеньРасчета, -1, 1)*ВыборкаСделкаРЕПО.СделкаРЕПО.СуммаСделкиПоПервойЧасти;
				ДатаПлатежаПо1Части = ВыборкаСделкаРЕПО.СделкаРЕПО.ПлановаяДатаПлатежаПо1Части;
				НоваяСделкиРЕПОМО.СуммаРЕПОРубли = ?(НоваяСделкиРЕПОМО.Валюта=ВалютаРубли, НоваяСделкиРЕПОМО.СуммаРЕПО, РаботаСКурсамиВалют.ПересчитатьВВалюту(НоваяСделкиРЕПОМО.СуммаРЕПО, НоваяСделкиРЕПОМО.Валюта, ВалютаРубли, ДатаПлатежаПо1Части));//?(НоваяСделкиРЕПОМО.ДеньРасчета, -1, 1)*ВыборкаСделкаРЕПО.СделкаРЕПО.СуммаСделкиПоПервойЧасти;
			КонецЕсли; 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПозицияРЕПОФО;
	
КонецФункции // РЕПОДенежныеСредстваНаДату()

// Возвращает данные по подтвержденным денежным переводам внутри дня 
//
// Параметры:
//  Отбор - Структура - структура отбора данных, содержащая одно из полей:
//						[Мандаты] - Массив - Массив ссылок Справочник.Мандаты
//                      [СчетаМандатов] - Массив ссылок Справочник.СчетаМандатов
//
// Возвращаемое значение:
//   ТаблицаЗначений   - Таблица данных по денежным средствам на дату
//
Функция ПереводыВнутриДняНаДату(Отбор) Экспорт

	Условие = "";
	ТекДата = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	т.Мандат,
	|	т.СчетМандата,
	|	т.Валюта,
	|	т.СуммаВыполненоОборот КАК ВходящийОстаток,
	|	0 КАК РЕПО,
	|	0 КАК ДневнойОборот
	|ИЗ
	|	РегистрНакопления.ДвиженияДенежныхСредствВнутриДня.Обороты(&НачДня, &КонецДня, , &СтрокаОтбор) КАК т"
	;

	Запрос.УстановитьПараметр("НачДня", НачалоДня(ТекДата));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ТекДата));
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("Мандаты") Тогда
			Условие = "Мандат В (&Мандаты)";
			Запрос.УстановитьПараметр("Мандаты", Отбор.Мандаты);
		КонецЕсли; 
		Если Отбор.Свойство("СчетаМандатов") Тогда
			Условие = Условие + ?(ПустаяСтрока(Условие), "", " И ");
			Условие = "СчетМандата В (&СчетаМандатов)";
			Запрос.УстановитьПараметр("СчетаМандатов", Отбор.СчетаМандатов);
		КонецЕсли; 
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СтрокаОтбор", Условие);
	
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Регистр ""Движения денежных средств внутри дня"": Денежные средства на дату");
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	
КонецФункции // РЕПОДенежныеСредстваНаДату()

Функция ПолучитьФактПозициюIntraDay(Прокси, ФабрикаСервиса)
    
    ДатыПериодаПозиции = ДатаПредыдущегоДня();
        
	ПакетПараметрыЗапроса = хдтоСоздатьПакетЗапросФактическойПозицииIntraDay(ДатыПериодаПозиции, ФабрикаСервиса);
	
	Ответ = Прокси.GetDataOnRequest("ЗапросФактическойПозицииIntraDay", ПакетПараметрыЗапроса);
			
	Рез = ОбработатьОтветФактПозицииIntraDay(Ответ, ФабрикаСервиса, вклОтладка);	
    
    Возврат Рез.ТЗ_ФО;
    
КонецФункции // ПолучитьФактПозициюIntraDay()

Функция хдтоСоздатьПакетЗапросФактическойПозицииIntraDay(ДатаПозиции, ФабрикаСервиса)
	
	типЗапросУниверсальныхДанных = ФабрикаСервиса.Тип(ПроцедурыФункцииОбмена_МО_ФО.ПолучитьПространствоИменСервиса(), "ЗапросУниверсальныхДанных");
	обХДТОЗапрос = ФабрикаСервиса.Создать(типЗапросУниверсальныхДанных);
	
	типЗаголовок = ФабрикаСервиса.Тип(ПроцедурыФункцииОбмена_МО_ФО.ПолучитьПространствоИменСервиса(), "Заголовок");
	обХДТОЗапрос.Заголовок = ФабрикаСервиса.Создать(типЗаголовок);
	обХДТОЗапрос.Заголовок.УникальныйИдентификатор = "777";
	обХДТОЗапрос.Заголовок.ДатаВыполнения = ТекущаяДатаСеанса();
	обХДТОЗапрос.Заголовок.ИдентификаторСистемы = "МО";
	обХДТОЗапрос.Заголовок.ИмяПользователя = "сп";
	
	типПараметры = обХДТОЗапрос.Тип().Свойства.Получить("Параметры").Тип;
	
	//параметрыЗапроса
	обХДТОПараметры = ФабрикаСервиса.Создать(типПараметры);
	обХДТОПараметры.Ключ = "НачалоПериод";
	типЗначения = обХДТОПараметры.Тип().Свойства.Получить("Значения").Тип;
	
	обХДТОЗначения = ФабрикаСервиса.Создать(типЗначения);
		
	обХДТОЗначения.Значение = ДатаПозиции.ДатаНачала;
	обХДТОПараметры.Значения.Добавить(обХДТОЗначения);
	
	обХДТОЗапрос.Параметры.Добавить(обХДТОПараметры);
	
	обХДТОПараметры = ФабрикаСервиса.Создать(типПараметры);
	обХДТОПараметры.Ключ = "КонецПериод";
	типЗначения = обХДТОПараметры.Тип().Свойства.Получить("Значения").Тип;
	
	обХДТОЗначения = ФабрикаСервиса.Создать(типЗначения);
		
	обХДТОЗначения.Значение = ДатаПозиции.ДатаКонца;
	обХДТОПараметры.Значения.Добавить(обХДТОЗначения);
	
	обХДТОЗапрос.Параметры.Добавить(обХДТОПараметры);

	
	Возврат обХДТОЗапрос;
	
КонецФункции //хдтоСоздатьПакетЗапросФактическойПозицииIntraDay()

Функция хдтоСоздатьПакетЗапросРЕПО(ДатаПозиции, ФабрикаСервиса, Отбор)
	
	типЗапросУниверсальныхДанных = ФабрикаСервиса.Тип(ПроцедурыФункцииОбмена_МО_ФО.ПолучитьПространствоИменСервиса(), "ЗапросУниверсальныхДанных");
	обХДТОЗапрос = ФабрикаСервиса.Создать(типЗапросУниверсальныхДанных);
	
	типЗаголовок = ФабрикаСервиса.Тип(ПроцедурыФункцииОбмена_МО_ФО.ПолучитьПространствоИменСервиса(), "Заголовок");
	обХДТОЗапрос.Заголовок = ФабрикаСервиса.Создать(типЗаголовок);
	обХДТОЗапрос.Заголовок.УникальныйИдентификатор = "777";
	обХДТОЗапрос.Заголовок.ДатаВыполнения = ТекущаяДатаСеанса();
	обХДТОЗапрос.Заголовок.ИдентификаторСистемы = "МО";
	обХДТОЗапрос.Заголовок.ИмяПользователя = "сп";
	
	типПараметры = обХДТОЗапрос.Тип().Свойства.Получить("Параметры").Тип;
	
	//параметрыЗапроса
	обХДТОПараметры = ФабрикаСервиса.Создать(типПараметры);
	обХДТОПараметры.Ключ = "ДатаПериода";
	типЗначения = обХДТОПараметры.Тип().Свойства.Получить("Значения").Тип;
	
	обХДТОЗначения = ФабрикаСервиса.Создать(типЗначения);
	
	обХДТОЗначения.Значение = ДатаПозиции;
	обХДТОПараметры.Значения.Добавить(обХДТОЗначения);
	
	обХДТОЗапрос.Параметры.Добавить(обХДТОПараметры);
	
	Если Отбор.МассивКодМандат.Количество() > 0 Тогда
		
		обХДТОПараметры = ФабрикаСервиса.Создать(типПараметры);
		обХДТОПараметры.Ключ = "ОтборПоПортфелю";
		типЗначения = обХДТОПараметры.Тип().Свойства.Получить("Значения").Тип;
		
		обХДТОЗначения = ФабрикаСервиса.Создать(типЗначения);
		
		обХДТОЗначения.Значение = Истина;
		обХДТОПараметры.Значения.Добавить(обХДТОЗначения);
		
		обХДТОЗапрос.Параметры.Добавить(обХДТОПараметры);
		
		//СписокКодовМандатов
		обХДТОПараметры = ФабрикаСервиса.Создать(типПараметры);
		обХДТОПараметры.Ключ = "СписокВнешнихКодов";
		типЗначения = обХДТОПараметры.Тип().Свойства.Получить("Значения").Тип;
		
		Для каждого КодМандат Из Отбор.МассивКодМандат Цикл
			
			обХДТОЗначения = ФабрикаСервиса.Создать(типЗначения);
			
			обХДТОЗначения.Значение = КодМандат;
			обХДТОПараметры.Значения.Добавить(обХДТОЗначения);
		КонецЦикла;
		
		обХДТОЗапрос.Параметры.Добавить(обХДТОПараметры);
	КонецЕсли;
	
	Возврат обХДТОЗапрос;
	
КонецФункции //хдтоСоздатьПакетЗапросРЕПО()

