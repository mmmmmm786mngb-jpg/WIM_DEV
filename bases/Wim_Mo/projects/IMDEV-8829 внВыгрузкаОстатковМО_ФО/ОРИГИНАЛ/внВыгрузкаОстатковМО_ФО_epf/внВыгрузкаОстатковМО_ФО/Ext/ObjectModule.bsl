КонецПроцедуры // Опубликовать()


Функция хдтоСформироватьПакетИсполнений(ФабрикаСервиса, ДатаВыгрузки) Экспорт
		
	обПакет = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "Пакет"));
	обПакет.Документы = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("Документы").Тип);
	
	обПакет.Заголовок = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "Заголовок"));
	обПакет.Заголовок.УникальныйИдентификатор = СокрЛП(новый УникальныйИдентификатор());
	обПакет.Заголовок.ДатаВыполнения = ТекущаяДата();
	обПакет.Заголовок.ИдентификаторСистемы = "МО 1.0";
	обПакет.Заголовок.ИмяПользователя = "Сервис";
	обПакет.Заголовок.ДатаВыгрузки = ?(ДатаВыгрузки=Дата(1,1,1), ТекущаяДата(), ДатаВыгрузки);
	
	обПакет.ИспользоватьЧастичнуюЗагрузкуПозиции = Истина;
	обПакет.ДоступнаНеПолнаяПозиция = Истина;
	
	Возврат обПакет;
	
КонецФункции

Функция хдтоСформироватьПакетАктивыВРЕПО(ФабрикаСервиса, ДатаВыгрузки) Экспорт
		
	обПакет = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "Пакет"));
	обПакет.РегистрыСведений = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("РегистрыСведений").Тип);
	
	обПакет.Заголовок = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "Заголовок"));
	обПакет.Заголовок.УникальныйИдентификатор = СокрЛП(новый УникальныйИдентификатор());
	обПакет.Заголовок.ДатаВыполнения = ТекущаяДата();
	обПакет.Заголовок.ИдентификаторСистемы = "МО 1.0";
	обПакет.Заголовок.ИмяПользователя = "Сервис";
	обПакет.Заголовок.ДатаВыгрузки = ?(ДатаВыгрузки=Дата(1,1,1), ТекущаяДата(), ДатаВыгрузки);
	
	обПакет.ИспользоватьЧастичнуюЗагрузкуПозиции = Истина;
	обПакет.ДоступнаНеПолнаяПозиция = Истина;
	
	Возврат обПакет;
	
КонецФункции

Процедура ДобавитьПакетАктивыРЕПО(ПакетХДТО, ФабрикаСервиса, ДатаИсполнения = Неопределено, ТЗИсточник)

	Если ДатаИсполнения=Неопределено Тогда
		ДатаИсполнения = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Для каждого СтрокаТЗ Из ТЗИсточник Цикл
		ДобавитьПакетСтрокуАктивыРЕПО(ПакетХДТО, ФабрикаСервиса,СтрокаТЗ, ДатаИсполнения);
	КонецЦикла;
	
КонецПроцедуры //ДобавитьПакетАктивыРЕПО()

Процедура ДобавитьПакетСтрокуАктивыРЕПО(ПакетХДТО, ФабрикаСервиса, СтрокаТЗ, ДатаИсполнения)

	Если Не СтрокаТЗ.ИсполнениеСделкиРЕПОПоЦБ И Не СтрокаТЗ.ДеньРасчета Тогда
		
		типХДТО	 = ФабрикаСервиса.Тип(ПространствоИменСервиса, "АктивыВРЕПО");
		обХДТО = ФабрикаСервиса.Создать(типХДТО);
		обХДТО.ДатаРасчетов = ДатаИсполнения;
		обХДТО.Портфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоПорфельПоиск(СтрокаТЗ.Портфель, ФабрикаСервиса);
		обХДТО.Актив = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПоиск(СтрокаТЗ.Актив, ФабрикаСервиса);
		обХДТО.МестоХранения = ПроцедурыФункцииОбмена_МО_ФО.хдтоМестоХраненияПоиск(СтрокаТЗ.МестоХраненияЦБ, ФабрикаСервиса);
		обХДТО.Субпортфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоСубпортфельПоиск(СтрокаТЗ.СубпортфельЦБ, ФабрикаСервиса);
		
		хдтоПортфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоПорфельПоиск(СтрокаТЗ.Портфель, ФабрикаСервиса); 
		ВнешнийКодСделкаРЕПО = Строка(СтрокаТЗ.СделкаРЕПО.УникальныйИдентификатор());//СтрокаТЗ.НомерСделки+"#"+хдтоПортфель.ВнешнийКод;
		обХДТО.Сделка = ХДТОСделкаРЕПОПоиск(хдтоПортфель, ВнешнийКодСделкаРЕПО, СтрокаТЗ.НомерСделки, ФабрикаСервиса);
		
		обХДТО.Сумма = СтрокаТЗ.СуммаРЕПОРубли;
		обХДТО.Количество = СтрокаТЗ.Количество;
		обХДТО.СделкаСЦК = СтрокаТЗ.СделкаСЦК;
		
		ПакетХДТО.РегистрыСведений.АктивыВРЕПО.Добавить(обХДТО);
		
	КонецЕсли;

КонецПроцедуры


Процедура ОпубликоватьАктивыРЕПО(ФабрикаСервиса, Прокси, ДатаИсполнения = Неопределено, ТЗИсточник)

	Если ДатаИсполнения=Неопределено Тогда
		ДатаИсполнения = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ствАктивыНеВыгружать = Новый Соответствие;
	ПакетХДТО = хдтоСформироватьПакетАктивыВРЕПО(ФабрикаСервиса, ДатаИсполнения);
	
	Для каждого СтрокаТЗ Из ТЗИсточник Цикл
	
		Если Не СтрокаТЗ.ИсполнениеСделкиРЕПОПоЦБ И Не СтрокаТЗ.ДеньРасчета Тогда
		
			типХДТО	 = ФабрикаСервиса.Тип(ПространствоИменСервиса, "АктивыВРЕПО");
			обХДТО = ФабрикаСервиса.Создать(типХДТО);
			обХДТО.ДатаРасчетов = ДатаИсполнения;
			обХДТО.Портфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоПорфельПоиск(СтрокаТЗ.Портфель, ФабрикаСервиса);
			обХДТО.Актив = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПоиск(СтрокаТЗ.Актив, ФабрикаСервиса);
			обХДТО.МестоХранения = ПроцедурыФункцииОбмена_МО_ФО.хдтоМестоХраненияПоиск(СтрокаТЗ.МестоХраненияЦБ, ФабрикаСервиса);
			обХДТО.Субпортфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоСубпортфельПоиск(СтрокаТЗ.СубпортфельЦБ, ФабрикаСервиса);
			
			хдтоПортфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоПорфельПоиск(СтрокаТЗ.Портфель, ФабрикаСервиса); 
			ВнешнийКодСделкаРЕПО = Строка(СтрокаТЗ.СделкаРЕПО.УникальныйИдентификатор());//СтрокаТЗ.НомерСделки+"#"+хдтоПортфель.ВнешнийКод;
			обХДТО.Сделка = ХДТОСделкаРЕПОПоиск(хдтоПортфель, ВнешнийКодСделкаРЕПО, СтрокаТЗ.НомерСделки, ФабрикаСервиса);
			
			обХДТО.Сумма = СтрокаТЗ.СуммаРЕПО;
			обХДТО.Количество = СтрокаТЗ.Количество;
			обХДТО.СделкаСЦК = СтрокаТЗ.СделкаСЦК;
			
			ПакетХДТО.РегистрыСведений.АктивыВРЕПО.Добавить(обХДТО);
		
		КонецЕсли;
	КонецЦикла;
	
	Ответ = Прокси.DownloadPosition(ПакетХДТО);
	
	ЕстьОшибкиПортфель = Ложь;
	
	Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, вклОтладка, УзелОбменаДляРегистрацииНенайденных);
	Если Рез.ЕстьОшибки Тогда
		ЕстьОшибкиПортфель = Истина;
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
		ТекстовыйЛог.ДобавитьСтроку("Ошибка выгрузки исполнения по: "+ ДатаИсполнения);
		ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
	КонецЕсли;
	
	Если вклОтладка Тогда
		ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОтвета);
	КонецЕсли;
	
КонецПроцедуры //ОпубликоватьАктивыРЕПО()

Процедура ОпубликоватьИсполнениеСделок(ФабрикаСервиса, Прокси)

	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ИсполнениеСделок", ИсполненияПоСделкам.Выгрузить());
	Запрос.Текст = ПолучитьТекстЗапросаДляВыгрузкиИсполнения();
	
	ВыборкаПериоды = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПериоды.Следующий() Цикл
		Попытка
			
			ствАктивыНеВыгружать = новый Соответствие;
			ПакетХДТО = хдтоСформироватьПакетИсполнений(ФабрикаСервиса, ВыборкаПериоды.ДатаИсполнения);
			
			ПоместитьИсполнениеВПакет(ПакетХДТО, ВыборкаПериоды, ФабрикаСервиса);
			
			Ответ = Прокси.DownloadPosition(ПакетХДТО);	
		
			ЕстьОшибкиПортфель = Ложь;
			
			Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, вклОтладка, УзелОбменаДляРегистрацииНенайденных);
			Если Рез.ЕстьОшибки Тогда
				ЕстьОшибкиПортфель = истина;
				ЕстьОшибки = истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
				ТекстовыйЛог.ДобавитьСтроку("Ошибка выгрузки исполнения по: "+ ВыборкаПериоды.ДатаИсполнения);
				ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
			КонецЕсли;
			
			Если вклОтладка Тогда
				ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОтвета);
			КонецЕсли	
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ЕстьОшибки = Истина;
			ТекстовыйЛог.ДобавитьСтроку("Ошибка выгрузки исполнения по: "+ ВыборкаПериоды.ДатаИсполнения);
			ТекстовыйЛог.ДобавитьСтроку(ОписаниеОшибки);
		КонецПопытки;
		
	КонецЦикла;
	

КонецПроцедуры //ОпубликоватьИсполнениеСделок()

Функция ПолучитьТекстЗапросаДляВыгрузкиИсполнения()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	т.ДатаИсполнения КАК ДатаИсполнения,
	|	т.Действие КАК Действие,
	|	т.Сделка КАК Сделка,
	|	т.Актив КАК Актив,
	|	т.Портфель КАК Портфель,
	|	т.МестоХранения КАК МестоХранения,
	|	т.Субпортфель КАК Субпортфель,
	|	т.ТипПортфеля КАК ТипПортфеля,
	|	т.Количество КАК Количество,
	|	т.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ втИсполнениеСделок
	|ИЗ
	|	&ИсполнениеСделок КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втИсполнениеСделок.ДатаИсполнения КАК ДатаИсполнения,
	|	втИсполнениеСделок.Действие,
	|	втИсполнениеСделок.Сделка,
	|	втИсполнениеСделок.Актив,
	|	втИсполнениеСделок.Портфель,
	|	втИсполнениеСделок.МестоХранения,
	|	втИсполнениеСделок.Субпортфель,
	|	втИсполнениеСделок.ТипПортфеля,                           
	|	втИсполнениеСделок.Количество,
	|	втИсполнениеСделок.Идентификатор
	|ИЗ
	|	втИсполнениеСделок КАК втИсполнениеСделок
	|ГДЕ
	|	втИсполнениеСделок.Действие <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаИсполнения
	|ИТОГИ ПО
	|	ДатаИсполнения";
	
	Возврат ТекстЗапроса;
	 
КонецФункции

Функция ДобавитьВПакетМандат(ПакетХДТО, ВыборкаПортфели, ствАктивыНеВыгружать, ФабрикаСервиса)
	
	ВыборкаПозиции = ВыборкаПортфели.Выбрать();
	
	ЕстьОшибкиПоПортфелю = Ложь;
	
	Пока ВыборкаПозиции.Следующий() Цикл
		
		Если ствАктивыНеВыгружать[ВыборкаПозиции.Актив] <> Неопределено Или ВыборкаПозиции.Актив="НЕОПРЕДЕЛЕНО" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВыборкаПозиции.КодСчетаМандата) Тогда
			ТекстОшибки = "У счета мандата """ + ВыборкаПозиции.СчетМандата + """ не заполнен код счета мандата. Выгрузка по счету мандата не выполнена";
			Сообщить(ТекстОшибки);
			ТекстовыйЛог.ДобавитьСтроку(ТекстОшибки);
			ДобавитьОшибкуВДанныеДляРассылки(ВыборкаПозиции.Мандат, ТекстОшибки, ВыборкаПозиции.Колво);
			ЕстьОшибки = Истина;
			ЕстьОшибкиПоПортфелю = Истина;
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВыборкаПозиции.МХ) Тогда
			ТекстОшибки = "У счета мандата """ + ВыборкаПозиции.СчетМандата + """ не заполнено место хранения. Выгрузка по счету мандата не выполнена";
			Сообщить(ТекстОшибки);
			ТекстовыйЛог.ДобавитьСтроку(ТекстОшибки);
			ДобавитьОшибкуВДанныеДляРассылки(ВыборкаПозиции.Мандат, ТекстОшибки, ВыборкаПозиции.Колво);
			ЕстьОшибки = Истина;
			ЕстьОшибкиПоПортфелю = Истина;
			Продолжить;
		КонецЕсли;
		
		хдтоДобавитьВПакетФактическаяПозиция(ПакетХДТО,
		ДатаДляФронт,
		ВыборкаПозиции.Актив,
		ВыборкаПозиции.Мандат,
		ВыборкаПозиции.СчетМандата,
		ВыборкаПозиции.ДоходыКПолучению,
		ВыборкаПозиции.МХ,
		ВыборкаПозиции.Колво,
		ВыборкаПозиции.Стоим,
		ВыборкаПозиции.СуммаНКД,
		ВыборкаПозиции.СуммаЗадолженность,
		ВыборкаПозиции.ДСиЗадолженность,
		ФабрикаСервиса);
		
	КонецЦикла;
	
	СтрокиСЧА = СЧА_РСА.НайтиСтроки(новый Структура("Мандат", ВыборкаПортфели.Мандат));
	
	Для каждого СтрокаВыгрузить из СтрокиСЧА Цикл
		хдтоДобавитьВПакетСтоимостьЧистыхАктивов(ПакетХДТО, ДатаДляФронт, СтрокаВыгрузить.Мандат, СтрокаВыгрузить.СЧА, СтрокаВыгрузить.РСА, ФабрикаСервиса);
	КонецЦикла;
	
	Возврат ЕстьОшибкиПоПортфелю;
	
КонецФункции

Функция ХДТОСделкаРЕПОПоиск(хдтоПортфель, СделкаРЕПОВнешнийКод, СделкаРЕПОНомерСделки, ФабрикаСервиса)

	типХДТО	 = ФабрикаСервиса.Тип(ПространствоИменСервиса, "СделкаРЕПОПоиск"); 
	обСделкаРЕПОПоискХДТО = ФабрикаСервиса.Создать(типХДТО); 
	обСделкаРЕПОПоискХДТО.ВнешнийКод = СделкаРЕПОВнешнийКод;
	обСделкаРЕПОПоискХДТО.НомерСделки = СделкаРЕПОНомерСделки;
	обСделкаРЕПОПоискХДТО.Портфель = хдтоПортфель;

	Возврат обСделкаРЕПОПоискХДТО;	

