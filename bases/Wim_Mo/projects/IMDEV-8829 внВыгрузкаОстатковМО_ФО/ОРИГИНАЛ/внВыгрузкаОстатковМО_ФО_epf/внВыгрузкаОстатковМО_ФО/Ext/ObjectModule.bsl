	         |	И (ПлановаяПозицияПоДенежнымСредствам.Сделка.Внебиржевая
	         |			ИЛИ ПлановаяПозицияПоДенежнымСредствам.Сделка.КодКласса ПОДОБНО ""%DMA%"")
	         |	&УсловиеОтбораПлановаяПозицияПоДенежнымСредствам
	         |
	         |ОБЪЕДИНИТЬ ВСЕ
	         |
	         |ВЫБРАТЬ
	         |	ИСТИНА,
	         |	ПлановаяПозицияПоЦеннымБумагам.Сделка,
	         |	ПлановаяПозицияПоЦеннымБумагам.Актив,
	         |	ПлановаяПозицияПоЦеннымБумагам.Мандат,
	         |	ПлановаяПозицияПоЦеннымБумагам.СчетМандата.МестоХранения,
	         |	ПлановаяПозицияПоЦеннымБумагам.СчетМандата,
	         |	ПлановаяПозицияПоЦеннымБумагам.Количество
	         |ИЗ
	         |	РегистрНакопления.ПлановаяПозицияПоЦеннымБумагам КАК ПлановаяПозицияПоЦеннымБумагам
	         |ГДЕ
	         |	(ПлановаяПозицияПоЦеннымБумагам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	         |				И ПлановаяПозицияПоЦеннымБумагам.Сделка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление)
	         |			ИЛИ ПлановаяПозицияПоЦеннымБумагам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	         |				И ПлановаяПозицияПоЦеннымБумагам.Сделка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа))
	         |	И ПлановаяПозицияПоЦеннымБумагам.Период МЕЖДУ &ДатаНачалаПериода И &ДатаОкончанияПериода
	         |	И (ПлановаяПозицияПоЦеннымБумагам.Сделка.Внебиржевая
	         |			ИЛИ ПлановаяПозицияПоЦеннымБумагам.Сделка.КодКласса ПОДОБНО ""%DMA%"")
	         |	&УсловиеОтбораПлановаяПозицияПоЦеннымБумагам";	

КонецФункции // ПолучитьТекстЗапросаИсполнениеСделокВнеБиржДМАНаДату()  //RKatunin IMDEV-3438

#Область СлужебныеПроцедурыИФункции

Функция хдтоВиртуальныйСубпортфельПоиск(сс, ФабрикаСервиса)
	
	хдтоОбъект = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "СубпортфельПоиск"));
	
	КодСчета = СокрЛП(сс.КодСчета);
	КодСчета = Лев(КодСчета, СтрДлина(КодСчета) - 3) + "-VI";
	хдтоОбъект.КодСчета = КодСчета;
	
	ГУИД = СокрЛП(сс.УникальныйИдентификатор());
	хдтоОбъект.ВнешнийКод = Лев(ГУИД, СтрДлина(ГУИД) - 3) + "-vi";;
	
	Возврат хдтоОбъект;
КонецФункции

Функция ПолучитьТекстЗапросаДляВиртуальныхСубпортфелей()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(т.СчетМандата КАК Справочник.СчетаМандатов) КАК СчетМандата,
	|	т.ДоходыКПолучению КАК ДоходыКПолучению
	|ПОМЕСТИТЬ втДС
	|ИЗ
	|	&ДС КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.СчетМандата
	|ИЗ
	|	втДС КАК т
	|ГДЕ
	|	т.ДоходыКПолучению = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	т.СчетМандата";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ПроверитьИСоздатьВиртуальныеСубпортфели(Прокси, ФабрикаСервиса, Отказ, тхтОшибки)
	
	//ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
	// IMAPPS-24915 ++
	//СтруктураПакета = Новый Структура("Справочники, Документы, РегистрыСведений, Рейтинг", Ложь, Ложь, Ложь, Ложь);
	СтруктураПакета = Новый Структура("Справочники, Документы, РегистрыСведений, Рейтинг", Истина, Ложь, Ложь, Ложь);
	// IMAPPS-24915 --
	ПакетХДТО = хдтоСформироватьПакет(ФабрикаСервиса, СтруктураПакета);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДС", ДенежныеСредства.Выгрузить());
	Запрос.Текст = ПолучитьТекстЗапросаДляВиртуальныхСубпортфелей();
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ПакетПараметрыЗапроса = хдтоСоздатьПакетПараметрыЗапроса(Выборка, ФабрикаСервиса);
	
	Ответ = Прокси.GetDataOnRequest("СуществующиеВиртуальныеСубпортфели", ПакетПараметрыЗапроса);
	
	Рез = ОбработатьОтветЗапроса(Ответ, ФабрикаСервиса, вклОтладка);
	
	Если Рез.ЕстьОшибки Тогда
		ЕстьОшибки = Истина;
		Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
			ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Выборка.Сбросить();
	Пока Выборка.Следующий() Цикл
		
		ГУИД = СокрЛП(Выборка.СчетМандата.УникальныйИдентификатор());
		ВнешнийКод = Лев(ГУИД, СтрДлина(ГУИД) - 3) + "-vi";
		
		НайденнаяСтрока = Рез.ТЗ_ФО.Найти(ВнешнийКод, "ВнешнийКод");
		Если НайденнаяСтрока = Неопределено Тогда
			хдтоДобавитьВПакетВиртуальныйСубпортфель(ПакетХДТО, Выборка.СчетМандата, ВнешнийКод, ФабрикаСервиса, Отказ, тхтОшибки);
		КонецЕсли;
	КонецЦикла;
	
	Если вклОтладка Тогда
		обЗапись = новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ПакетХДТО);
		ТекстовыйЛог.ДобавитьСтроку(обЗапись.Закрыть());
	КонецЕсли;
	
	Ответ = Прокси.DownloadPosition(ПакетХДТО);
	
	ЕстьОшибкиПортфель = Ложь;
	
	Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, вклОтладка, УзелОбменаДляРегистрацииНенайденных, УзелОбменаДляРегистрацииНенайденныхСчетовМандатов);
	Если Рез.ЕстьОшибки Тогда
		ЕстьОшибки = Истина;
		Если ЗначениеЗаполнено(Рез.ТекстОшибкиСервиса) Тогда
			ДобавитьОшибкуВДанныеДляРассылки(Справочники.Мандаты.ПустаяСсылка(), "При создании виртуальных субпортфелей в ФО возникла ошибка:" + Символы.ПС + Рез.ТекстОшибкиСервиса);
		Иначе
			ТаблицаПортфелейСОшибкой = ПолучитьМандатыПоНенайденнымОбъектамВиртуальныеСубпортфели(Рез);
			
			//IMAPPS-19973++
			ОбработатьОтветДляРассылки(ТаблицаПортфелейСОшибкой);
			//IMAPPS-19973--
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
		ТекстовыйЛог.ДобавитьСтроку("Ошибки создания виртуальных субпортфелей");
		ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
	КонецЕсли;
	
	Если вклОтладка Тогда
		ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОтвета);
	КонецЕсли;
	
КонецПроцедуры

Процедура хдтоДобавитьВПакетВиртуальныйСубпортфель(обПакет, сс, ВнешнийКод, ФабрикаСервиса, Отказ, ТекстОшибки) Экспорт
	
	Если Не ЗначениеЗаполнено(сс.КодСчета) Тогда
		Возврат;
	КонецЕсли;
	
	КодСчета = СокрЛП(сс.КодСчета);
	КодСчета = Лев(КодСчета, СтрДлина(КодСчета) - 3) + "-VI";
	
	//сс = Справочники.СчетаМандатов.ПустаяСсылка();
	типСубпортфель	 = ФабрикаСервиса.Тип(ПространствоИменСервиса, "Субпортфель");
	обХДТО = ФабрикаСервиса.Создать(типСубпортфель);
	//обХДТО.НеполноеОбновление = Ложь;
	обХДТО.ВнешнийКод = ВнешнийКод;
	обХДТО.Наименование = КодСчета;
	обХДТО.КодСчета = КодСчета;
	обХДТО.Портфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоПорфельПоиск(сс.Владелец, ФабрикаСервиса);
