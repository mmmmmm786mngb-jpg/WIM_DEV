						ТаблицаПортфелейСОшибкой.ЗаполнитьЗначения(Рез.ТекстОшибкиСервиса, "ТекстОшибки");
						ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибкиСервиса);
					Иначе
						ТаблицаПортфелейСОшибкой = ПолучитьМандатыПоНенайденнымОбъектамФактПоз(Рез, ТаблицаПортфелей, СоответствиеПортфелей);
					КонецЕсли;
					ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
					//IMAPPS-19973++
					ОбработатьОтветДляРассылки(ТаблицаПортфелейСОшибкой);
					//IMAPPS-19973--
				КонецЕсли;
				
				Если вклОтладка Тогда
					ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОтвета);
				КонецЕсли;
				
			КонецЕсли;
			
			// выгрузка блокировок
			СтрокиБлокировки = Блокировки.НайтиСтроки(новый Структура("Мандат", ВыборкаПортфели.Мандат));
			Если СтрокиБлокировки.Количество() > 0 Тогда
				
				ПакетБлокировкиХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакетПоручений(ФабрикаСервиса);
				ПакетБлокировкиХДТО.ЗапускатьПроверкуЛимитов = Ложь;
				
				Для каждого СтрокаВыгрузить из СтрокиБлокировки Цикл
					хдтоДобавитьВПакетБлокировку(ПакетБлокировкиХДТО, ДатаДляФронт, СтрокаВыгрузить.ОперацияВнешнийКод, СтрокаВыгрузить.Мандат, СтрокаВыгрузить.Валюта, СтрокаВыгрузить.СчетМандата, СтрокаВыгрузить.Количество, СтрокаВыгрузить.Стоимость, ФабрикаСервиса);
					
					НоваяСтрока = ТаблицаДляУдаленияБлокировок.Добавить();
					НоваяСтрока.КодМандата = ВыборкаПортфели.Мандат.КодМандата;
					НоваяСтрока.КодСчета = СтрокаВыгрузить.СчетМандата.КодСчета;
					НоваяСтрока.КодВалюты = СтрокаВыгрузить.Валюта.Код;
				КонецЦикла;
				
				Если вклОтладка Тогда
					обЗапись = Новый ЗаписьXML;
					обЗапись.УстановитьСтроку("UTF-8");
					ФабрикаСервиса.ЗаписатьXML(обЗапись, ПакетБлокировкиХДТО);
					ТекстовыйЛог.ДобавитьСтроку(обЗапись.Закрыть());
				КонецЕсли;
				
				Ответ = Прокси.DownloadOrders(ПакетБлокировкиХДТО);
				
				Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, вклОтладка, Неопределено, УзелОбменаДляРегистрацииНенайденныхСчетовМандатов);
				Если Рез.ЕстьОшибки Тогда
					ЕстьОшибки = Истина;
					ЕстьОшибкиПортфель = Истина;
					СоответствиеПортфелей.Вставить(ВыборкаПортфели.Мандат, Истина);
					ДобавитьОшибкуВДанныеДляРассылки(ВыборкаПортфели.Мандат, "При выгрузке блокировки в ФО возникла ошибка:" + Символы.ПС + Рез.ЕстьОшибки, ВыборкаПортфели.Колво);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
					ТекстовыйЛог.ДобавитьСтроку("Ошибка выгрузки блокировки по: " + ВыборкаПортфели.Мандат);
					ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
				КонецЕсли;
				
				Если вклОтладка Тогда
					ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОтвета);
				КонецЕсли;
			Иначе
				МассивКодовПортфелейДляУдаленияБлокировок.Добавить(ВыборкаПортфели.Мандат.КодМандата);
			КонецЕсли;
			
			Если КоличествоВПакете = КоличествоПакет Или КоличествоПортфелей = КоличествоПортфелейВсего Тогда
				ПроверитьИУдалитьБлокировкиФО(МассивКодовПортфелейДляУдаленияБлокировок, ТаблицаДляУдаленияБлокировок, ФабрикаСервиса, Прокси, ИдентификаторСеанса);
			КонецЕсли;
			
			Если НовыйПакет = Истина Тогда
				СтруктураПакета = Новый Структура("Справочники, Документы, РегистрыСведений, Рейтинг", Истина, Ложь, Ложь, Ложь);
				ПакетХДТОФлагПозиции = хдтоСформироватьПакет(ФабрикаСервиса, СтруктураПакета);
				//ПакетХДТОФлагПозиции = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
			КонецЕсли;
			
			Если КоличествоВПакете = КоличествоПакет Или КоличествоПортфелей = КоличествоПортфелейВсего Тогда
				
				СформироватьПакетФлагПозицияВыгружена(СоответствиеПортфелей, ФабрикаСервиса, Прокси, ПакетХДТОФлагПозиции);
				МассивКодовПортфелей = Новый Массив;
				Для каждого Соот Из СоответствиеПортфелей Цикл
					МассивКодовПортфелей.Добавить(Соот.Ключ.КодМандата);
					Если Соот.Значение = Ложь Тогда
						ТекстовыйЛог.ДобавитьСтроку(" "+ Соот.Ключ +" - успех!");
					Иначе
							//IMAPPS-19973++
						ДанныеДляРассылки.КоличествоОшибок = ДанныеДляРассылки.КоличествоОшибок + 1;
							//IMAPPS-19973--
					КонецЕсли;
				КонецЦикла;
				СформироватьПакетФлагПозицияВыгруженаСОшибкой(СоответствиеПортфелей, ФабрикаСервиса, Прокси, ПакетХДТОФлагПозиции);
				
				Ответ = Прокси.DownloadPosition(ПакетХДТОФлагПозиции);
				
				Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, Ложь, Неопределено);
				Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
					ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
				КонецЕсли;
				
				ВыполнитьПерерасчетРСА(ФабрикаСервиса, Прокси, ИдентификаторСеанса, МассивКодовПортфелей, ДатаДляФронт);
				
			КонецЕсли;
			
			НовыйПакет = Ложь;
			Если КоличествоПакет = КоличествоВПакете Или КоличествоПортфелей = КоличествоПортфелейВсего Тогда
				КоличествоВПакете = 0;
				НовыйПакет = Истина;
			КонецЕсли;
			
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ЕстьОшибки = Истина;
			ТекстовыйЛог.ДобавитьСтроку("Ошибка выгрузки позиции по: "+ ВыборкаПортфели.Мандат);
			ТекстовыйЛог.ДобавитьСтроку(ОписаниеОшибки);
			//Возврат;
		КонецПопытки;
	КонецЦикла;
	
	ОпубликоватьИсполнениеСделок(ФабрикаСервиса, Прокси); 
	
	//ТЗАктивыРЕПО = СделкиРЕПОМО.Выгрузить();
	//
	//ПараметрыОтбора = Новый Структура("ДеньРасчета, НетПоручения", Ложь, Истина);
	//СтрокиРЕПОДеньги = РЕПОДеньги.НайтиСтроки(ПараметрыОтбора);
	//Для каждого СтрокаРЕПОДеньги Из СтрокиРЕПОДеньги Цикл
	//	ЗаполнитьЗначенияСвойств(ТЗАктивыРЕПО.Добавить(), СтрокаРЕПОДеньги);
