// Формирует структуру отбора для заполнения табличных частей из фонового задания
//
Функция СформироватьОтборДляФоновогоЗадания()
	
	Запрос = Новый Запрос(ПолучитьТекстЗапросаДляФоновогоЗадания());
//	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДата());
	Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ТекущаяДата()-60*60*24));

	Условие = "";
	Если ОтборМандат Тогда 
		ПроверитьУсловиеМандатыОтбор(Условие, Ложь);
		Запрос.УстановитьПараметр("СписМандатОтбор", СписМандатОтбор);
	Иначе
		Если ЗначениеЗаполнено(МандатДляТеста) Тогда
			СписМандатОтбор.Добавить(МандатДляТеста);
			ПроверитьУсловиеМандатыОтбор(Условие, Ложь);
			Запрос.УстановитьПараметр("СписМандатОтбор", СписМандатОтбор);
		КонецЕсли;
	КонецЕсли;

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", Условие);

	Возврат Новый Структура("СчетаМандатов", Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетМандата"));

КонецФункции // СформироватьОтборДляФоновогоЗадания()

// Возвращает текст запроса для функции "СформироватьОтборДляФоновогоЗадания"
//
Функция ПолучитьТекстЗапросаДляФоновогоЗадания()

	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Остатки.СчетМандата КАК СчетМандата
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДенежныеСредстваОстатки.СчетМандата КАК СчетМандата
	|	ИЗ
	|		РегистрНакопления.ДенежныеСредства.Остатки(&ДатаОстатков, &УсловиеОтбора) КАК ДенежныеСредстваОстатки
	|	ГДЕ
	|		1 = 1
	|		И ДенежныеСредстваОстатки.СчетМандата.Наименование <> ""Счет мандата не определен""
	|		И ЕСТЬNULL(ДенежныеСредстваОстатки.СчетМандата.МестоХранения.ВидБанковскогоСчета, """") <> ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
	|		И (ДенежныеСредстваОстатки.СчетМандата.ВидСчетаМандата.Наименование = ""Брокерский""
	|					И ДенежныеСредстваОстатки.СчетМандата.Владелец.ТипМандата.Ссылка В (ЗНАЧЕНИЕ(Перечисление.ТипыМандата.V), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Y), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Q), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.H))
	|				ИЛИ НЕ ДенежныеСредстваОстатки.СчетМандата.Владелец.ТипМандата.Ссылка В (ЗНАЧЕНИЕ(Перечисление.ТипыМандата.V), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Y), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Q), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.H)))
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЦенныеБумагиОстатки.СчетМандата
	|	ИЗ
	|		РегистрНакопления.ЦенныеБумаги.Остатки(&ДатаОстатков, &УсловиеОтбора) КАК ЦенныеБумагиОстатки
	|	ГДЕ
	|		1 = 1
	|		И ЦенныеБумагиОстатки.СчетМандата.Наименование <> ""Счет мандата не определен""
	|		И ЕСТЬNULL(ЦенныеБумагиОстатки.СчетМандата.МестоХранения.ВидБанковскогоСчета, """") <> ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
	|		И (ЦенныеБумагиОстатки.СчетМандата.ВидСчетаМандата.Наименование = ""Брокерский""
	|					И ЦенныеБумагиОстатки.СчетМандата.Владелец.ТипМандата.Ссылка В (ЗНАЧЕНИЕ(Перечисление.ТипыМандата.V), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Y), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Q), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.H))
	|				ИЛИ НЕ ЦенныеБумагиОстатки.СчетМандата.Владелец.ТипМандата.Ссылка В (ЗНАЧЕНИЕ(Перечисление.ТипыМандата.V), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Y), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Q), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.H)))) КАК Остатки"
			
	;
	
КонецФункции // ПолучитьТекстЗапросаДляФоновогоЗадания()

