Функция НайтиПоКодуСчета(КодСчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетаМандатов.Ссылка
		|ИЗ
		|	Справочник.СчетаМандатов КАК СчетаМандатов
		|ГДЕ
		|	СчетаМандатов.КодСчета = &КодСчета";
	
	Запрос.УстановитьПараметр("КодСчета", КодСчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СчетаМандатов.ПустаяСсылка();
	
КонецФункции // НайтиПоКодуСчета()

Функция ОбработатьОшибкиЗагрузки(Ответ)

	Результат = новый Структура("ЕстьОшибки, ЕстьПредупреждения, ТекстОшибки", Ложь,  Ложь, Новый Массив);
    
    СписСубпортфель = Новый Массив;
	Для каждого РегОшибка Из Ответ.ОшибкиЗагрузки.РегистрыСведений Цикл
	    Если РегОшибка.Ошибка="Не заполнен субпортфель." Тогда
	    	Для каждого Субпортфель Из РегОшибка.Измерения Цикл
				Если Субпортфель.Измерение="Субпортфель" Тогда
					Для каждого КлючПоиска Из Субпортфель.КлючиПоиска Цикл
						Если КлючПоиска.Ключ="КодСчета" Тогда
							СчётМандата = НайтиПоКодуСчета(КлючПоиска.Значение);
							Если СписСубпортфель.Найти(СчётМандата)=Неопределено Тогда
								СписСубпортфель.Добавить(СчётМандата);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;						
				КонецЕсли;
			КонецЦикла;
			Результат.ЕстьОшибки = Истина;
			Продолжить;
		КонецЕсли;	
	КонецЦикла;	
	
	//IMAPPS-19973++
	//Если УзелОбменаДляРегистрацииНенайденныхСчетовМандатов <> Неопределено И СписСубпортфель.Количество() > 0 Тогда 
	Если ЗначениеЗаполнено(УзелОбменаДляРегистрацииНенайденныхСчетовМандатов) И СписСубпортфель.Количество() > 0 Тогда 
	//IMAPPS-19973--
		
		Для Каждого СчетМандата Из СписСубпортфель Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбменаДляРегистрацииНенайденныхСчетовМандатов, СчетМандата);
			//Результат.ТекстОшибки = Результат.ТекстОшибки + Символы.ПС + "Счёта мандата "+СчетМандата+" зарегистрированы к обмену. Узел: " + УзелОбменаДляРегистрацииНенайденныхСчетовМандатов;
			Результат.ТекстОшибки.Добавить("Счёта мандата "+СчетМандата+" зарегистрированы к обмену. Узел: " + УзелОбменаДляРегистрацииНенайденныхСчетовМандатов);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции // ОбработатьОшибкиЗагрузки()


// Производит публикацию данных для web-service из табличных частей обработки
//
// Параметры:
//  ПересчитатьРыночнуюСтоимость  - Булево - Значение параметра сервиса "ПересчитатьРыночнуюСтоимость"
//  ПересчитатьКомплаинс  		  - Булево - Значение параметра сервиса "ПересчитатьКомплаинс"
//
Процедура Опубликовать(ПересчитатьРыночнуюСтоимость = Ложь, ПересчитатьКомплаинс = Ложь, ДатаПубликации = Неопределено) Экспорт
	
	Если ДатаПубликации=Неопределено Тогда
		ДатаПубликации = ТекущаяДатаСеанса();
	КонецЕсли;
	
	НачалоОбработки = ТекущаяДатаСеанса();
	ИдентификаторСеанса = Новый УникальныйИдентификатор;
	
	ТекстовыйЛог.ДобавитьСтроку("--------- Position set ------------");
	
	СтруктураСервиса = ПолучитьОпределениеСервиса();
	Если СтруктураСервиса.ЕстьОшибки Тогда
		Сообщить(СтруктураСервиса.ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	тхтОшибки = "";
	
	Попытка
		
		Определение = СтруктураСервиса.ОпределениеWS;
		ФабрикаСервиса = Определение.ФабрикаXDTO;
		
		Прокси = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
		
		Если ЭтотОбъект.АдресWS="http://smsk02mg138u/AVC_PP_FO/ws/avancore_ws.1cws?wsdl" Тогда
			Прокси.Пользователь = "admin";
			Прокси.Пароль = "адм232882";
		КонецЕсли;
		
		ПроверитьИСоздатьВиртуальныеСубпортфели(Прокси, ФабрикаСервиса, Отказ, тхтОшибки);
		
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ЕстьОшибки = Истина;
		ТекстовыйЛог.ДобавитьСтроку("Ошибки создания виртуальных субпортфелей");
		ТекстовыйЛог.ДобавитьСтроку(ОписаниеОшибки);
	КонецПопытки;
	
	КоличествоПакет = КоличествоПортфелейВПакете;
	КоличествоВПакете = 0;
	НовыйПакет = Истина;
	
	//IMDEV-3786 RKatunin
	//ОпубликоватьПорученияРЕПОМО(ФабрикаСервиса, Прокси);
	ОпубликоватьСделкиРЕПОМО(ФабрикаСервиса, Прокси);
	//IMDEV-3786 RKatunin
	
	СтруктураВыбора = Новый Структура("ДеньРасчета", Истина);
	СтрокиСделкиРЕПОМО = СделкиРЕПОМО.НайтиСтроки(СтруктураВыбора);
	ТЗСделкиРЕПОМО = СделкиРЕПОМО.Выгрузить(СтрокиСделкиРЕПОМО);
	ТЗСделкиРЕПОМО.Колонки.Добавить("ДеньгиУчтеныМО", Новый ОписаниеТипов("Булево"));
	ТЗСделкиРЕПОМО.ЗаполнитьЗначения(Ложь, "ДеньгиУчтеныМО");
	
	Для каждого СтрокаРЕПОДеньги Из РЕПОДеньги Цикл
		ЗаполнитьЗначенияСвойств(ТЗСделкиРЕПОМО.Добавить(), СтрокаРЕПОДеньги);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДС", ДенежныеСредства.Выгрузить());
	Запрос.УстановитьПараметр("ЦБ", ЦенныеБумаги.Выгрузить());
	Запрос.УстановитьПараметр("РЕПО", ТЗСделкиРЕПОМО);
	Запрос.Текст = ПолучитьТекстЗапросаДляВыгрузкиДСиЦБ();
	
	ВыборкаПортфели = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КоличествоПортфелейВсего = ВыборкаПортфели.Количество();
	КоличествоПортфелей = 0;
	
	Пока ВыборкаПортфели.Следующий() Цикл
		Попытка
			//IMAPPS-19973++
			ДанныеДляРассылки.КоличествоПортфелей = ДанныеДляРассылки.КоличествоПортфелей + 1;
			//IMAPPS-19973--
			
			Если Не ЗначениеЗаполнено(ВыборкаПортфели.Мандат.КодМандата) Тогда
				ТекстОшибки = "У мандата """ + ВыборкаПортфели.Мандат + """ не заполнен код мандата. Выгрузка по мандату не выполнена";
				Сообщить(ТекстОшибки);
				ТекстовыйЛог.ДобавитьСтроку(ТекстОшибки);
				ДобавитьОшибкуВДанныеДляРассылки(ВыборкаПортфели.Мандат, ТекстОшибки, ВыборкаПортфели.Колво);
				ЕстьОшибки = Истина;
				Продолжить;
			КонецЕсли;
			
			ствАктивыНеВыгружать = новый Соответствие;
			
			КоличествоВПакете = КоличествоВПакете + 1;
			КоличествоПортфелей = КоличествоПортфелей + 1;
			
			Если НовыйПакет = Истина Тогда
				
				ТЗАктивыРЕПО = СделкиРЕПОМО.Выгрузить();
				ТЗАктивыРЕПО.Очистить();
				
				ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
				ПакетХДТО.ИспользоватьЧастичнуюЗагрузкуПозиции = Ложь;
				ПакетХДТО.ДоступнаНеПолнаяПозиция = Истина;
				
				СоответствиеПортфелей = Новый Соответствие;
				МассивКодовПортфелейДляУдаленияБлокировок = Новый Массив;
				ТаблицаДляУдаленияБлокировок = Новый ТаблицаЗначений;
				ТаблицаДляУдаленияБлокировок.Колонки.Добавить("КодМандата");
				ТаблицаДляУдаленияБлокировок.Колонки.Добавить("КодСчета");
				ТаблицаДляУдаленияБлокировок.Колонки.Добавить("КодВалюты");
				
				ТаблицаПортфелей = Новый ТаблицаЗначений;
				ТаблицаПортфелей.Колонки.Добавить("Мандат", Новый ОписаниеТипов("СправочникСсылка.Мандаты"), "Мандат");
				ТаблицаПортфелей.Колонки.Добавить("Колво", Новый ОписаниеТипов("Число"), "Количество");
				
				ПакетХДТОФлагПозицииНеВыгружена = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
			КонецЕсли;
			
			ЕстьОшибкиПоПортфелю = ДобавитьВПакетМандат(ПакетХДТО, ВыборкаПортфели, ствАктивыНеВыгружать, ФабрикаСервиса);
			СоответствиеПортфелей.Вставить(ВыборкаПортфели.Мандат, ЕстьОшибкиПоПортфелю);
			НоваяСтрокаПортфелей = ТаблицаПортфелей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПортфелей, ВыборкаПортфели);
			
			СтруктураВыбора = Новый Структура("Портфель", ВыборкаПортфели.Мандат);
			СтрокиСделкиРЕПОМО = СделкиРЕПОМО.НайтиСтроки(СтруктураВыбора);
			Для каждого СтрокаСделкиРЕПОМО Из СтрокиСделкиРЕПОМО Цикл
				ДобавитьПакетСтрокуАктивыРЕПО(ПакетХДТО, ФабрикаСервиса, СтрокаСделкиРЕПОМО, ДатаПоз);
			КонецЦикла;
			
			ПараметрыОтбора = Новый Структура("ДеньРасчета, НетПоручения, Портфель", Ложь, Истина, ВыборкаПортфели.Мандат);
			СтрокиРЕПОДеньги = РЕПОДеньги.НайтиСтроки(ПараметрыОтбора);
			Если СтрокиРЕПОДеньги.Количество()>0 Тогда
				ДобавитьПакетАктивыРЕПО(ПакетХДТО, ФабрикаСервиса, ДатаПоз, СтрокиРЕПОДеньги);
			КонецЕсли;
			
			//ДобавитьФактПозициюIntraDay(ПакетХДТО, ВыборкаПортфели.Мандат, ФабрикаСервиса, ДатаПубликации);
			
			///Произвести валидацию запроса установки
			//Попытка
			//	ПакетХДТО.Проверить();
			//Исключение
			//	ОписаниеОшибки = ОписаниеОшибки();
			//	ЕстьОшибки = Истина;
			//	ТекстовыйЛог.ДобавитьСтроку("Ошибка валидации запроса установки: " + ОписаниеОшибки);
			//	Возврат;
			//КонецПопытки;
			
			Если КоличествоВПакете = КоличествоПакет Или КоличествоПортфелей = КоличествоПортфелейВсего Тогда
				
				СформироватьПакетФлагПозицияНеВыгружена(СоответствиеПортфелей, ФабрикаСервиса, Прокси, ПакетХДТОФлагПозицииНеВыгружена);
				
				Ответ = Прокси.DownloadPosition(ПакетХДТОФлагПозицииНеВыгружена);
				
				Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, Ложь, Неопределено);
				Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
					ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
				КонецЕсли;
				
				Если вклОтладка Тогда
					обЗапись = новый ЗаписьXML;
