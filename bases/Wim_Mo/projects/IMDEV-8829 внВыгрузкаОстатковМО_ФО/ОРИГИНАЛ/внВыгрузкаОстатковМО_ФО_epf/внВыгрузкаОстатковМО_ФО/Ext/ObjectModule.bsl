		|			ТОГДА ""Исполнение""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Действие,
		|	СделкаСЦеннымиБумагами.Ссылка КАК Сделка,
		|	СделкаСЦеннымиБумагами.Номер КАК Идентификатор,
		|	СделкаСЦеннымиБумагами.Актив КАК Актив,
		|	""Бумаги"" КАК ВидАктива,
		|	СделкаСЦеннымиБумагами.Мандат КАК Портфель,
		|	СделкаСЦеннымиБумагами.СчетМандатаЦБ.МестоХранения КАК МестоХранения,
		|	СделкаСЦеннымиБумагами.СчетМандатаЦБ КАК Субпортфель,
		|	СделкаСЦеннымиБумагами.НомерСделки КАК НомерСделки,
		|	СделкаСЦеннымиБумагами.Количество КАК Количество
		|ИЗ
		|	Документ.СделкаСЦеннымиБумагами КАК СделкаСЦеннымиБумагами
		|ГДЕ
		|	СделкаСЦеннымиБумагами.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, &КоличестовДнейПроверкиИсполненияСделок) И &Период
		|	И (СделкаСЦеннымиБумагами.Внебиржевая
		|			ИЛИ СделкаСЦеннымиБумагами.КодКласса ПОДОБНО ""DMA%"") &УсловиеЦБ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаДенежныеСредства.ФактическаяДатаПлатежа <> ДАТАВРЕМЯ(1, 1, 1),
		|	СделкаДенежныеСредства.ФактическаяДатаПлатежа,
		|	ВЫБОР
		|		КОГДА СделкаДенежныеСредства.ФактическаяДатаПлатежа <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ""Исполнение""
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	СделкаДенежныеСредства.Ссылка,
		|	СделкаДенежныеСредства.Номер,
		|	СделкаДенежныеСредства.Валюта,
		|	""Деньги"",
		|	СделкаДенежныеСредства.Мандат,
		|	СделкаДенежныеСредства.СчетМандатаДС.МестоХранения,
		|	СделкаДенежныеСредства.СчетМандатаДС,
		|	СделкаДенежныеСредства.НомерСделки,
		|	СделкаДенежныеСредства.СуммаСделки
		|ИЗ
		|	Документ.СделкаСЦеннымиБумагами КАК СделкаДенежныеСредства
		|ГДЕ
		|	СделкаДенежныеСредства.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, &КоличестовДнейПроверкиИсполненияСделок) И &Период
		|	И (СделкаДенежныеСредства.Внебиржевая
		|			ИЛИ СделкаДенежныеСредства.КодКласса ПОДОБНО ""DMA%"") &УсловиеДС";
		
		
		
	Запрос.УстановитьПараметр("Период", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("КоличестовДнейПроверкиИсполненияСделок", КоличестовДнейПроверкиИсполненияСделок);
	
	УсловиеЦБ = "";
	УсловиеДС = "";
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("Мандаты") Тогда
			УсловиеЦБ = УсловиеЦБ + " И СделкаСЦеннымиБумагами.Мандат В (&Мандаты)";
			УсловиеДС = УсловиеДС + " И СделкаДенежныеСредства.Мандат В (&Мандаты)";
			Запрос.УстановитьПараметр("Мандаты", Отбор.Мандаты);
		КонецЕсли; 
		Если Отбор.Свойство("СчетаМандатов") Тогда
			
			УсловиеЦБ = УсловиеЦБ + " И СделкаСЦеннымиБумагами.СчетМандатаЦБ В (&СчетаМандатов)";
			УсловиеДС = УсловиеДС + " И СделкаДенежныеСредства.СчетМандатаДС В (&СчетаМандатов)";
			Запрос.УстановитьПараметр("СчетаМандатов", Отбор.СчетаМандатов);
			
			Запрос.УстановитьПараметр("Мандаты", Отбор.ОтборМандаты);
			
		КонецЕсли;
	КонецЕсли;
	
	Если ОтборМандат Тогда
		Если СписМандатОтбор.Количество() Тогда
			УсловиеЦБ = УсловиеЦБ + " И СделкаСЦеннымиБумагами.Мандат В (&СписМандатОтбор)";
			УсловиеДС = УсловиеДС + " И СделкаДенежныеСредства.Мандат В (&СписМандатОтбор)";
		КонецЕсли;
		Запрос.УстановитьПараметр("СписМандатОтбор", СписМандатОтбор);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЦБ", УсловиеЦБ);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДС", УсловиеДС);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТЗИсполнение = РезультатЗапроса.Выгрузить();
	
	Возврат ТЗИсполнение;
	
КонецФункции // ПолучитьИсполнениеСделокМО()

Функция ИсполнениеСделок(Дата, Отбор = Неопределено) Экспорт 
	
	Если ИсполнениеПоСуммеМО Тогда
		СписокПозиций = ПолучитьПозициюФО(Дата, "Плановая");
		
		ПозицияФО = Новый ТаблицаЗначений;
		ПозицияФО.Колонки.Добавить("Мандат", Новый ОписаниеТипов("СправочникСсылка.Мандаты"));
		ПозицияФО.Колонки.Добавить("Актив", Новый ОписаниеТипов("СправочникСсылка.Активы"));
		ПозицияФО.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
		
		Для Каждого ТекущаяПозицияХДТО Из СписокПозиций.ТекущаяПозиция Цикл
		
			Мандат = ПолучитьМандат(ТекущаяПозицияХДТО.Портфель);
			Для каждого ПозицияПортфеляХДТО Из ТекущаяПозицияХДТО.ПозицияПортфеля Цикл
			
				Для каждого ЦенныеБумагиХДТО Из ПозицияПортфеляХДТО.ЦенныеБумаги Цикл
					СтрокаПозицияФО = ПозицияФО.Добавить();
					Актив = ПолучитьАктив(ЦенныеБумагиХДТО.Актив.Актив);	
				
					СтрокаПозицияФО.Мандат = Мандат;
					СтрокаПозицияФО.Актив = Актив;
				КонецЦикла;	
			
				Для каждого ЦенныеБумагиХДТО Из ПозицияПортфеляХДТО.ДенежныеСредства Цикл
					СтрокаПозицияФО = ПозицияФО.Добавить();
					Валюта = ПолучитьВалюта(ЦенныеБумагиХДТО.Актив.Валюта);	
				
					СтрокаПозицияФО.Мандат = Мандат;
					СтрокаПозицияФО.Валюта = Валюта;
				КонецЦикла;
				
			КонецЦикла;
		КонецЦикла;
		
		ИсполненныеСделкиМО = ПолучитьИсполнение(ПозицияФО, Отбор);
	Иначе	
		
		ИсполненныеСделкиМО = ПолучитьИсполнениеСделокМО(Отбор);
		ИсполненныеСделкиФО = ПолучитьСделкиИсполнениеФО();
		
		ИсполненныеСделкиМО.Колонки.Добавить("ИсполнениеПроверка");
		
		Для каждого ИсполнениеФО Из ИсполненныеСделкиФО.ИсполненияПоСделке Цикл
			
			ВидАктива = ?(ИсполнениеФО.Актив.Актив=Неопределено, "Деньги", "Бумаги");
			
			СтруктПоиск = Новый Структура("НомерСделки, ВидАктива", ИсполнениеФО.Сделка.Идентификатор, ВидАктива);
			СделкиМО = ИсполненныеСделкиМО.НайтиСтроки(СтруктПоиск);
			Если СделкиМО.Количество() Тогда
				Для каждого СделкаМО Из СделкиМО Цикл
					Если Не СделкаМО.Проведен И ИсполнениеФО.Количество<>0 Тогда
						СделкаМО.Действие = "Отмена исп";
						СделкаМО.Количество = 0;
						СделкаМО.ИсполнениеПроверка = "ИсполненаФО";
					ИначеЕсли СделкаМО.Проведен И ИсполнениеФО.Количество<>0 Тогда
						СделкаМО.ИсполнениеПроверка = "ИсполненаФО";
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		ТекДата = НачалоДня(ТекущаяДата());
		Для каждого СделкаМО Из ИсполненныеСделкиМО Цикл
			
			Если ТекДата<>НачалоДня(СделкаМО.ДатаИсполнения) И СделкаМО.ИсполнениеПроверка="ИсполненаФО" И СделкаМО.Проведен Тогда
				СделкаМО.Действие = "";
			КонецЕсли;
			
			Если СделкаМО.Действие="Исполнение" Тогда
				Для каждого СделкаФО Из ИсполненныеСделкиФО.Сделки Цикл
					Если СделкаФО.Идентификатор=СделкаМО.Идентификатор Тогда
						Если ТипЗнч(СделкаМО.Актив)=Тип("СправочникСсылка.Активы") Тогда
							СделкаМО.Количество = СделкаФО.Количество;
						ИначеЕсли ТипЗнч(СделкаМО.Актив)=Тип("СправочникСсылка.Валюты") Тогда
							СделкаМО.Количество = СделкаФО.Сумма;
						КонецЕсли;
					КонецЕсли;				
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		     
	КонецЕсли;
    
	Возврат ИсполненныеСделкиМО;

КонецФункции // ИсполнениеСделок()
