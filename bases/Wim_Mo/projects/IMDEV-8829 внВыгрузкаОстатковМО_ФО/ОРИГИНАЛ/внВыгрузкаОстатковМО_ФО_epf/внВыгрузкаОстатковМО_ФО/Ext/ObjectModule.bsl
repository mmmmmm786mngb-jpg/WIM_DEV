// Функция подготовки данных БД для выгрузки.
//
// Параметры:
//  Параметры  - Структура - содержит входные параметры, необходимые для работы обработки
//
// Возвращаемое значение:
//   Структура   - Содержит обязательные поля описатели результата выполнения:
//				   ЕстьОшибки - Булево - Показатель ошибок выполнения обработки;
//				   ОписаниеОшибок - Строка - Строка, содержащая описание ошибок.
//
// Дополнительно:
//	 1. В структуру переданных параметров можно передать параметр "Лог" типа "Табличный документ",
//      который будет прикреплен к Бизнес-процессу загрузки.
//   2. В структуру возврат можно передать любые данные (примитивного и ссылочного типа) для следующего шага.
//	 3. В структуру можно передать параметр "МассивСсылок" типа массив, содержащий ссылки выгружаемых реквизитов,
//		на основании которого будут произведены записи в регистр сведений "ПротоколОбмена".
//
Функция ПодготовитьДанные(Параметры) Экспорт

	Отказ = Ложь;
	//ТестовыйРежим = Ложь;
	ФоновоеЗадание = Истина;
	
	СтруктураВозврата = Новый Структура("ЕстьОшибки, ОписаниеОшибок", Ложь, "");
		
	Если НЕ ТипЗнч(Параметры) = Тип("Структура") Тогда
		СтруктураВозврата.ЕстьОшибки = Истина;
		СтруктураВозврата.ОписаниеОшибок = "Не определены параметры обработки";
		Возврат СтруктураВозврата;
	КонецЕсли; 
		
	Параметры.Вставить("ТекстовыйЛог", ТекстовыйЛог); //Ведется лог выгрузки
	
	// Сформируем отбор
	Отбор = СформироватьОтборДляФоновогоЗадания();
	
	// Заполним табличные части обработки
	Заполнить(Отбор, );

	Если ЦенныеБумаги.Количество() = 0
		И ДенежныеСредства.Количество() = 0 Тогда
		СтруктураВозврата.ЕстьОшибки = Истина;
		СтруктураВозврата.ОписаниеОшибок = "Данные для выгрузки отсутствуют";
	КонецЕсли; 
	
	Если НЕ СтруктураВозврата.ЕстьОшибки
		И ЕстьОшибки Тогда
		СтруктураВозврата.ЕстьОшибки = Истина;
		СтруктураВозврата.ОписаниеОшибок = ОписаниеОшибки;
	КонецЕсли; 
	
	Возврат СтруктураВозврата; 

КонецФункции

// Функция записи данных, подготовленных на предыдущем шаге.
//
// Параметры:
//	ДанныеОбмена - Структура - содержит структуру, полученную на шаге подготовки данных. 
//							   Может понадобиться для передачи доп. данных между шагами.
//  Параметры  - Структура - содержит входные параметры, необходимые для работы обработки.
//
// Возвращаемое значение:
//   Структура   - Содержит обязательные поля, описатели результата выполнения:
//				   ЕстьОшибки - Булево - Показатель ошибок выполнения обработки;
//				   ОписаниеОшибок - Строка - Строка, содержащая описание ошибок.
//
//
Функция ЗаписатьДанные(ДанныеОбмена, Параметры) Экспорт

	СтруктураВозврата = Новый Структура("ЕстьОшибки, ОписаниеОшибок", Ложь, ""); 
	
	Если НЕ ТипЗнч(Параметры) = Тип("Структура") Тогда
		СтруктураВозврата.ЕстьОшибки = Истина;
		СтруктураВозврата.ОписаниеОшибок = "Ошибочный тип переданных параметров";
		Возврат СтруктураВозврата;
	КонецЕсли; 
	
	//IMAPPS-19973++
	//Опубликовать();
	
	//Выполним в попытке для случая FAIL
	ЕстьИсключения = Ложь;
	Попытка
		Опубликовать();
	Исключение
		ЕстьИсключения = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	
	Попытка
		ТекстОповещения = "";
		Если ЕстьИсключения Тогда
			ТекстОповещения = "При выгрузке произошла исключительная ситуация:" + Символы.ПС + 
								КраткоеПредставлениеОшибки(ИнформацияОбОшибке) + Символы.ПС + Символы.ПС + 
								"Подробности смотрите по источнику обмена (ВыгрузкаОстатков_ФО) -> Перейти к бизнес-процессам";
		КонецЕсли;
		
		РассылкаСообщения("Загрузка остатков МО -> ФО", ТекстОповещения, ЕстьОшибки, ЕстьИсключения);
		
	Исключение
	КонецПопытки;
	
	
	Если ЕстьИсключения Тогда
		//Передадим исключение выше по стеку, чтобы сохранилось в описании выгрузки по узлу обмена
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;
	//IMAPPS-19973--

	Если НЕ СтруктураВозврата.ЕстьОшибки
		И ЕстьОшибки Тогда
		СтруктураВозврата.ЕстьОшибки = Истина;
		СтруктураВозврата.ОписаниеОшибок = ОписаниеОшибки;
	КонецЕсли; 
	
	Возврат СтруктураВозврата;
	
КонецФункции // ЗаписатьДанные()

#КонецОбласти

#Область ЭкспортныеПроцедурыИФункции

// Заполняет табличные части обработки на основании переданного отбора
//
// Параметры:
//  Отбор  - Структура - Структура содержащая массив объектов обработки
//                 		[Мандаты] - Массив - Массив элементов справочника мандатов
//						[СчетаМандатов] - Массив - массив элементов справочника счета мандатов
//
Процедура Заполнить(Отбор, ДатаЗаполнения) Экспорт
	Если ОтборМандат Тогда
		ЗаполнитьСписокМандатДляОтбора();	
	КонецЕсли;
	
	Если ДатаЗаполнения = Неопределено Тогда
		ДатаЗаполнения = НачалоДня(ТекущаяДата());
	КонецЕсли;
	
	ТаблицаОтборов = ПолучитьМассивМандатовДляОтбора(Отбор);
	Отбор.Вставить("ОтборМандаты", ТаблицаОтборов.ВыгрузитьКолонку("Мандат"));
	Отбор.Вставить("МассивКодМандат", ТаблицаОтборов.ВыгрузитьКолонку("КодМандата"));
	
	ДатаПоз = ДатаЗаполнения;
	ДатаДляФронт = НачалоДня(ДатаЗаполнения);
	
	ТабИсполСделк = ИсполнениеСделок(ДатаЗаполнения, Отбор); //RKatunin IMDEV-3438
	
	РЕПОДС = РЕПОДенежныеСредстваНаДату(ДатаДляФронт, Отбор); //RKatunin IMDEV-4022
	
	РЕПОДеньги.Загрузить(РЕПОДС);//RKatunin IMDEV-4022
	
	ЦБ = ЦенныеБумагиНаДату(ДатаЗаполнения, Отбор);
