Функция ПолучитьВалюту(стрНаименование)
	
	ссВалюты = КешБазыПИФ[стрНаименование];
	Если ссВалюты = Неопределено Тогда
		ссВалюты = Справочники.Валюты.НайтиПоНаименованию(СокрЛП(стрНаименование));
		КешБазыПИФ.Вставить(стрНаименование, ссВалюты);
	КонецЕсли;
	
	Возврат ссВалюты;
КонецФункции

Функция ПолучитьСчетМандатаПИФ(сМандат, стрНаименование)
	
	ссСчет = КешБазыПИФ[стрНаименование];
	Если ссСчет = Неопределено Тогда
		
		Запрос = новый Запрос;
		Запрос.УстановитьПараметр("Владелец", сМандат);
		Запрос.УстановитьПараметр("НомерСчета", стрНаименование);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	т.Ссылка
		|ИЗ
		|	Справочник.СчетаМандатов КАК т
		|ГДЕ
		|	т.Владелец = &Владелец
		|	И ВЫРАЗИТЬ(т.МестоХранения КАК Справочник.БанковскиеСчета).НомерСчета = &НомерСчета";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ссСчет = Выборка.Ссылка;
		КонецЕсли;
		КешБазыПИФ.Вставить(стрНаименование, ссСчет);
	КонецЕсли;
	
	Возврат ссСчет;
КонецФункции

Функция ПолучитьСсылкуПоCom(БазаCom, ОбъектCom) Экспорт 
	
	обXML = БазаCom.NewObject("ЗаписьXML");
	обXML.SetString();
	БазаCom.WriteXML(обXML, ОбъектCom);
	стрXML = обXML.Close();
	стрXML = СтрЗаменить(стрXML, "ПИФ", "Мандаты");
	
	обXML = новый ЧтениеXML;
	обXML.УстановитьСтроку(стрXML);
	
	Возврат ПрочитатьXML(обXML);
КонецФункции

Функция СписокТиповПортфелейПИФ() Экспорт
	
	Спис = новый Массив;
	Спис.Добавить(Перечисления.ТипыМандата.A); // ОПИФA
	Спис.Добавить(Перечисления.ТипыМандата.M); // ОПИФС
	Спис.Добавить(Перечисления.ТипыМандата.O); // ОПИФО
	Спис.Добавить(Перечисления.ТипыМандата.X); // ОПИФИ
	Спис.Добавить(Перечисления.ТипыМандата.H); // ЗПИ Хедж фонд
	Спис.Добавить(Перечисления.ТипыМандата.Q); // ЗПИФ Прямых инв-ий
	Спис.Добавить(Перечисления.ТипыМандата.V); // ЗПИФ ВИ
	Спис.Добавить(Перечисления.ТипыМандата.Y); // ЗПИФ недвижимости
	
	Возврат Спис;
КонецФункции

