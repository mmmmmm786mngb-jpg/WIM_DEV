КонецПроцедуры

Функция УстановитьПараметры(Заголовок) Экспорт
	
	Значения = Новый Структура();
	Значения.Вставить("УзелОбменаДляРегистрацииНенайденных",	ЭтотОбъект.УзелОбменаДляРегистрацииНенайденных);
	Значения.Вставить("УзелОбменаДляРегистрацииНенайденныхСчетовМандатов",	ЭтотОбъект.УзелОбменаДляРегистрацииНенайденныхСчетовМандатов);
	Значения.Вставить("АдресWS", ЭтотОбъект.АдресWS);
	Значения.Вставить("ОтборМандат", ЭтотОбъект.ОтборМандат);
	Значения.Вставить("КоличестовДнейПроверкиИсполненияСделок", ЭтотОбъект.КоличестовДнейПроверкиИсполненияСделок);
	Значения.Вставить("УК", ЭтотОбъект.УК);
	Значения.Вставить("ИсполнениеПоСуммеМО", ЭтотОбъект.ИсполнениеПоСуммеМО);
	Значения.Вставить("ДатаНачалоВыгрузкиРЕПО", ЭтотОбъект.ДатаНачалоВыгрузкиРЕПО);
	Значения.Вставить("КоличествоПортфелейВПакете", ЭтотОбъект.КоличествоПортфелейВПакете);
	Значения.Вставить("МандатДляТеста", ЭтотОбъект.МандатДляТеста);
	
	//IMAPPS-19973++
	Значения.Вставить("УчетнаяЗаписьПочты", ЭтотОбъект.УчетнаяЗаписьПочты);
	МассивЭлементов = Новый Массив;
	Для каждого ЭлементСписка Из СписокРассылки Цикл
		МассивЭлементов.Добавить(Новый Структура("Адрес,Представление",ЭлементСписка.Адрес,ЭлементСписка.Представление));
	КонецЦикла;
	Значения.Вставить("СписокРассылки", МассивЭлементов);
	//IMAPPS-19973--
	
	Возврат Значения;
	
КонецФункции

Функция УстановитьНастройки(Знач ПараметрыВыполненияКоманды)
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда
		Возврат "<Настройки не установлены>";
	КонецЕсли;
	
	ЗначенияНастроек		 = НастройкиВыполнения;
	ПредставлениеНастроек	 = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
	
КонецФункции // УстановитьНастройки()

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	//ЗначенияНастроек = Настройки.Значения;
	//ТестовыйРежим = ЗначенияНастроек.ТестовыйРежим; УзелОбменаДляРегистрацииНенайденных
	Если Настройки <> Неопределено И Настройки.Свойство("Значения") Тогда
		Настройки.Значения.Свойство("УзелОбменаДляРегистрацииНенайденных", УзелОбменаДляРегистрацииНенайденных);
		Настройки.Значения.Свойство("УзелОбменаДляРегистрацииНенайденныхСчетовМандатов", УзелОбменаДляРегистрацииНенайденныхСчетовМандатов);
		ПредставлениеНастроек = "Узел для регистрации ненайденных: "+УзелОбменаДляРегистрацииНенайденных;
		Настройки.Значения.Свойство("АдресWS", АдресWS);
		Настройки.Значения.Свойство("ОтборМандат", ОтборМандат);
		Настройки.Значения.Свойство("КоличестовДнейПроверкиИсполненияСделок", КоличестовДнейПроверкиИсполненияСделок);
		Настройки.Значения.Свойство("УК", УК);
		Настройки.Значения.Свойство("ИсполнениеПоСуммеМО", ИсполнениеПоСуммеМО);
		Настройки.Значения.Свойство("ДатаНачалоВыгрузкиРЕПО", ДатаНачалоВыгрузкиРЕПО);
		Настройки.Значения.Свойство("КоличествоПортфелейВПакете", КоличествоПортфелейВПакете);
		Настройки.Значения.Свойство("МандатДляТеста", МандатДляТеста);
		
		//IMAPPS-19973++
		Настройки.Значения.Свойство("УчетнаяЗаписьПочты", УчетнаяЗаписьПочты);
		Если Настройки.Значения.Свойство("СписокРассылки") и ТипЗнч(Настройки.Значения.СписокРассылки) = Тип("Массив") Тогда
			Для каждого ЭлементСписка из Настройки.Значения.СписокРассылки Цикл
				ЗаполнитьЗначенияСвойств(СписокРассылки.Добавить(),ЭлементСписка);
			КонецЦикла;
		КонецЕсли;
		//IMAPPS-19973--
	КонецЕсли;
	
КонецПроцедуры

