Функция ПолучитьСделкаРЕПОПоНомеру(НомерСделки, ИсполнениеПоДеньгам, ИсполнениеПоЦБ, СделкаЗакрыта, ДатаПубликации)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокСделкаРЕПО.Ссылка КАК СделкаРЕПО,
		|	ВЫБОР
		|		КОГДА ДокСделкаРЕПО.ФактическаяДатаПлатежаПо2Части > &ДатаПубликации
		|				ИЛИ ДокСделкаРЕПО.ФактическаяДатаПлатежаПо2Части = &ПустаяДата
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ИсполнениеПоДеньгам,
		|	ВЫБОР
		|		КОГДА ДокСделкаРЕПО.ФактическаяДатаПоставкиПо2Части > &ДатаПубликации
		|				ИЛИ ДокСделкаРЕПО.ФактическаяДатаПоставкиПо2Части = &ПустаяДата
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ИсполнениеПоЦБ,
		|	ВЫБОР
		|		КОГДА ВложенныйЗапрос.СуммаОстаток ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ НЕ ВложенныйЗапрос.СуммаОстаток > 0
		|	КОНЕЦ КАК СделкаЗакрыта
		|ИЗ
		|	Документ.СделкаРЕПО КАК ДокСделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ДенежныеСредстваОтданныеВРЕПООстатки.СделкаРЕПО КАК СделкаРЕПО,
		|			ДенежныеСредстваОтданныеВРЕПООстатки.СуммаОстаток КАК СуммаОстаток
		|		ИЗ
		|			РегистрНакопления.ДенежныеСредстваОтданныеВРЕПО.Остатки КАК ДенежныеСредстваОтданныеВРЕПООстатки
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			ДенежныеСредстваПолученныеПоРЕПООстатки.СделкаРЕПО,
		|			ДенежныеСредстваПолученныеПоРЕПООстатки.СуммаОстаток
		|		ИЗ
		|			РегистрНакопления.ДенежныеСредстваПолученныеПоРЕПО.Остатки КАК ДенежныеСредстваПолученныеПоРЕПООстатки) КАК ВложенныйЗапрос
		|		ПО ДокСделкаРЕПО.Ссылка = ВложенныйЗапрос.СделкаРЕПО
		|ГДЕ
		|	ДокСделкаРЕПО.НомерСделки = &НомерСделки";
	
	Запрос.УстановитьПараметр("НомерСделки", НомерСделки);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	Запрос.УстановитьПараметр("ДатаПубликации", ДатаПубликации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда  
		
		ИсполнениеПоДеньгам = ВыборкаДетальныеЗаписи.ИсполнениеПоДеньгам;
		ИсполнениеПоЦБ = ВыборкаДетальныеЗаписи.ИсполнениеПоЦБ;
		СделкаЗакрыта = ВыборкаДетальныеЗаписи.СделкаЗакрыта;
		
		Возврат ВыборкаДетальныеЗаписи.СделкаРЕПО;
	КонецЕсли;
	
	ИсполнениеПоДеньгам = Ложь;
	ИсполнениеПоЦБ = Ложь;
		
	Возврат Документы.СделкаРЕПО.ПустаяСсылка();
		
КонецФункции // ПолучитьСделкаРЕПОПоНомеру()

Функция ПолучитьМандат(Портфель)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Мандаты.Ссылка КАК Мандат
		|ИЗ
		|	Справочник.Мандаты КАК Мандаты
		|ГДЕ
		|	Мандаты.КодМандата = &Код";
	           
	Если ТипЗнч(Портфель)=Тип("Строка") Тогда
		Запрос.УстановитьПараметр("Код", Портфель);
	Иначе
		Запрос.УстановитьПараметр("Код", Портфель.ВнешнийКод);
	КонецЕсли;           
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Возврат ВыборкаДетальныеЗаписи.Мандат;
	КонецЕсли;
	
	Возврат Справочники.Мандаты.ПустаяСсылка();

