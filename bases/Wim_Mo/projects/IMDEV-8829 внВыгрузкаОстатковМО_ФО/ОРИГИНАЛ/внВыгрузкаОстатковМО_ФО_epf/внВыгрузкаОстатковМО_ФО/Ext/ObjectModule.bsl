#Область ФормированиеПакетаXDTO

Функция хдтоСформироватьПакет(ФабрикаСервиса, СтруктураПакета)
		
	обПакет = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "Пакет"));
	Если СтруктураПакета.Справочники Тогда
		обПакет.Справочники = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("Справочники").Тип);
	КонецЕсли; 
	Если СтруктураПакета.Документы Тогда
		обПакет.Документы = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("Документы").Тип);
	КонецЕсли;
	Если СтруктураПакета.РегистрыСведений Тогда
		обПакет.РегистрыСведений = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("РегистрыСведений").Тип);
	КонецЕсли;
	Если СтруктураПакета.Рейтинг Тогда
		обПакет.Рейтинг = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("Рейтинг").Тип);
	КонецЕсли;
		
	обПакет.Заголовок = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "Заголовок"));
	обПакет.Заголовок.УникальныйИдентификатор = СокрЛП(новый УникальныйИдентификатор());
	обПакет.Заголовок.ДатаВыполнения = ТекущаяДата();
	обПакет.Заголовок.ИдентификаторСистемы = "МО 1.0";
	обПакет.Заголовок.ИмяПользователя = "Сервис";
	ДатаВыгрузки = Неопределено;
	СтруктураПакета.Свойство("ДатаВыгрузки", ДатаВыгрузки);
	обПакет.Заголовок.ДатаВыгрузки = ?(ДатаВыгрузки=Неопределено, ТекущаяДата(), ДатаВыгрузки);
	
	обПакет.ИспользоватьЧастичнуюЗагрузкуПозиции = Истина;
	обПакет.ДоступнаНеПолнаяПозиция = Истина;
	Возврат обПакет;
	
КонецФункции 

Функция хдтоСоздатьПакетПараметрыЗапроса(Выборка, ФабрикаСервиса)
	
	типЗапросУниверсальныхДанных = ФабрикаСервиса.Тип(ПространствоИменСервиса, "ЗапросУниверсальныхДанных");
	обХДТОЗапрос = ФабрикаСервиса.Создать(типЗапросУниверсальныхДанных);
	
	типЗаголовок = ФабрикаСервиса.Тип(ПространствоИменСервиса, "Заголовок");
	обХДТОЗапрос.Заголовок = ФабрикаСервиса.Создать(типЗаголовок);
	обХДТОЗапрос.Заголовок.УникальныйИдентификатор = "333";
	обХДТОЗапрос.Заголовок.ДатаВыполнения = ТекущаяДатаСеанса();
	обХДТОЗапрос.Заголовок.ИдентификаторСистемы = "МО";
	обХДТОЗапрос.Заголовок.ИмяПользователя = "сп";
	
	типПараметры = обХДТОЗапрос.Тип().Свойства.Получить("Параметры").Тип;
	
	//СписокКодовМандатов
	обХДТОПараметры = ФабрикаСервиса.Создать(типПараметры);
	обХДТОПараметры.Ключ = "СписокВнешнихКодов";
	типЗначения = обХДТОПараметры.Тип().Свойства.Получить("Значения").Тип;
	
	Пока Выборка.Следующий() Цикл
		обХДТОЗначения = ФабрикаСервиса.Создать(типЗначения);
		
		ГУИД = СокрЛП(Выборка.СчетМандата.УникальныйИдентификатор());
		ВнешнийКод = Лев(ГУИД, СтрДлина(ГУИД) - 3) + "-vi";
		
		обХДТОЗначения.Значение = ВнешнийКод;
		обХДТОПараметры.Значения.Добавить(обХДТОЗначения);
	КонецЦикла;
	
	обХДТОЗапрос.Параметры.Добавить(обХДТОПараметры);
	
	Возврат обХДТОЗапрос;
	
КонецФункции

#КонецОбласти

Функция ОбработатьОтветЗапроса(ОтветXDTO, ФабрикаСервиса, вклОтладка = Ложь)
	
	ТЗ_ФО = Новый ТаблицаЗначений;
	ТЗ_ФО.Колонки.Добавить("ВнешнийКод", Новый ОписаниеТипов("Строка"));
	
	Результат = Новый Структура("ЕстьОшибки, ТекстОшибки, ТЗ_ФО", Ложь, "", ТЗ_ФО);
	
	Если ОтветXDTO.СтатусОтвета.Код <> 0 тогда
		Результат.ТекстОшибки = "Внутренняя ошибка сервиса: "+ ОтветXDTO.СтатусОтвета.Описание;
		Результат.ЕстьОшибки = Истина;
	КонецЕсли;
	
	Для Каждого хдтоОтвеСообщение Из ОтветXDTO.СтатусОтвета.Сообщения Цикл
		Результат.ТекстОшибки = Результат.ТекстОшибки + Символы.ПС + "СтатусОтвета.Сообщения: "+ ?(хдтоОтвеСообщение.ЭтоОшибка, "err", "inf") + " [" + хдтоОтвеСообщение.Код + "] " + хдтоОтвеСообщение.Описание;
	КонецЦикла;
	
	Для каждого ТекСтрока Из ОтветXDTO.Строка Цикл
		
		НоваяСтрока = ТЗ_ФО.Добавить();
		
		Для Каждого ТекПоказатель Из ТекСтрока.Показатель Цикл
			НоваяСтрока[ТекПоказатель.Имя] = ТекПоказатель.Значение;
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.ТЗ_ФО = ТЗ_ФО;
	
	Если вклОтладка Тогда
		обЗапись = новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ОтветXDTO);
		Результат.Вставить("ТекстОтвета", обЗапись.Закрыть());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМассивМандатовДляОтбора(Отбор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетаМандатов.Владелец КАК Мандат,
		|	СчетаМандатов.Владелец.КодМандата КАК КодМандата
		|ИЗ
		|	Справочник.СчетаМандатов КАК СчетаМандатов
		|ГДЕ
		|	СчетаМандатов.Ссылка В(&СчетаМандатов)";
	
	Запрос.УстановитьПараметр("СчетаМандатов", Отбор.СчетаМандатов);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ()

Функция ПолучитьМандатыПоНенайденнымОбъектамФактПоз(Рез, ТаблицаПортфелей, СоответствиеПортфелей);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЦБ", ЦенныеБумаги.Выгрузить());
	Запрос.УстановитьПараметр("ТаблицаПортфелей", ТаблицаПортфелей);
	Запрос.УстановитьПараметр("МассивНенайденныхАктивов", Рез.МассивНенайденныхАктивов);
	Запрос.УстановитьПараметр("МассивНенайденныхСчетовМандатов", Рез.МассивНенайденныхСчетовМандатов);
	Запрос.УстановитьПараметр("МассивНенайденныхКодовКонтрагентов", Рез.МассивНенайденныхКодовКонтрагентов);
	Запрос.УстановитьПараметр("МассивНенайденныхКодовПортфелей", Рез.МассивНенайденныхКодовПортфелей);
	Запрос.УстановитьПараметр("МассивНенайденныхКодовВалюты", Рез.МассивНенайденныхКодовВалюты);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	т.Мандат КАК Мандат,
	|	ВЫРАЗИТЬ(т.Актив КАК Справочник.Активы) КАК Актив
	|ПОМЕСТИТЬ втЦБ
	|ИЗ
	|	&ЦБ КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Мандат КАК Мандат,
	|	т.Колво КАК Колво
	|ПОМЕСТИТЬ втПортфели
	|ИЗ
	|	&ТаблицаПортфелей КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаМандатов.Владелец КАК Мандат,
	|	""Не найден Субпортфель. КодСчета: "" + СчетаМандатов.КодСчета КАК ТекстОшибки
	|ПОМЕСТИТЬ МандатыСОшибками
	|ИЗ
	|	Справочник.СчетаМандатов КАК СчетаМандатов
	|ГДЕ
	|	СчетаМандатов.Ссылка В(&МассивНенайденныхСчетовМандатов)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втЦБ.Мандат,
	|	""Не найден Актив ("" + втЦБ.Актив.Наименование + "") ВнешнийКод: "" + втЦБ.Актив.ВнешнийКод
	|ИЗ
	|	втЦБ КАК втЦБ
	|ГДЕ
	|	втЦБ.Актив В(&МассивНенайденныхАктивов)
	|	И втЦБ.Мандат В
	|			(ВЫБРАТЬ
	|				втПортфели.Мандат
	|			ИЗ
	|				втПортфели КАК втПортфели)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СчетаМандатов.Владелец,
	|	""Не найден Портфель. КодМандата: "" + СчетаМандатов.Владелец.КодМандата
	|ИЗ
	|	Справочник.СчетаМандатов КАК СчетаМандатов
	|ГДЕ
	|	СчетаМандатов.Владелец.КодМандата В(&МассивНенайденныхКодовПортфелей)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МандатыСОшибками.Мандат,
	|	МандатыСОшибками.ТекстОшибки,
	|	втПортфели.Колво
	|ИЗ
	|	МандатыСОшибками КАК МандатыСОшибками
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПортфели КАК втПортфели
	|		ПО МандатыСОшибками.Мандат = втПортфели.Мандат
	|
	|УПОРЯДОЧИТЬ ПО
	|	МандатыСОшибками.Мандат.Наименование";
	
	ТаблицаПортфелейСОшибкой = Запрос.Выполнить().Выгрузить();
	
	Для каждого ТекСтрока Из ТаблицаПортфелейСОшибкой Цикл
		СоответствиеПортфелей.Вставить(ТекСтрока.Мандат, Истина);
	КонецЦикла;
	
	Возврат ТаблицаПортфелейСОшибкой;
	
КонецФункции

Функция ПолучитьМандатыПоНенайденнымОбъектамВиртуальныеСубпортфели(Рез)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДС", ДенежныеСредства.Выгрузить());
	Запрос.УстановитьПараметр("МассивНенайденныхКодовПортфелей", Рез.МассивНенайденныхКодовПортфелей);
	Запрос.УстановитьПараметр("МассивНенайденныхСчетовМандатов", Рез.МассивНенайденныхСчетовМандатов);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(т.СчетМандата КАК Справочник.СчетаМандатов) КАК СчетМандата,
	|	т.ДоходыКПолучению КАК ДоходыКПолучению
	|ПОМЕСТИТЬ втДС
	|ИЗ
	|	&ДС КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.СчетМандата
	|ПОМЕСТИТЬ т
	|ИЗ
	|	втДС КАК т
	|ГДЕ
	|	т.ДоходыКПолучению = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	т.СчетМандата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.СчетМандата.Владелец КАК Мандат,
	|	""Не найден Субпортфель. КодСчета: "" + т.СчетМандата.КодСчета КАК ТекстОшибки
	|ИЗ
	|	т КАК т
	|ГДЕ
	|	т.СчетМандата В(&МассивНенайденныхСчетовМандатов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.СчетМандата.Владелец,
	|	""Не найден Портфель. КодМандата: "" + т.СчетМандата.Владелец.КодМандата
	|ИЗ
	|	т КАК т
	|ГДЕ
	|	т.СчетМандата.Владелец.КодМандата В(&МассивНенайденныхКодовПортфелей)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Мандат";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ()

Процедура ДобавитьОшибкуВДанныеДляРассылки(Мандат, ТекстОшибки, Колво = 0)
	
	СтруктураПоиска = Новый Структура("Мандат", Мандат);
	НайденныеСтроки = ДанныеДляРассылки.ПозицииСОшибкой.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяЗапись = ДанныеДляРассылки.ПозицииСОшибкой.Добавить();
		НоваяЗапись.Мандат = Мандат;
		НоваяЗапись.Колво = Колво;
		НоваяЗапись.Комментарий = ТекстОшибки;
	Иначе
		НайденнаяСтрока = НайденныеСтроки[0];
		НайденнаяСтрока.Комментарий = НайденнаяСтрока.Комментарий + Символы.ПС + ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

