Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

Процедура РассылкаСообщения(Знач ТемаСообщения, Знач ТекстСообщения, Знач ЕстьОшибки, Знач ЕстьИсключение)
	
	Если СписокРассылки.Количество() > 0 и НЕ УчетнаяЗаписьПочты.Пустая() тогда
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
		ПараметрыПисьма.Тема = ?(ЕстьИсключение, "{FAIL} ", ?(ЕстьОшибки, "{WARN} ", "{OK} ")) + ТемаСообщения + ПропискаРассылки("r179");
		ПараметрыПисьма.Важность = ?(ЕстьОшибки ИЛИ ЕстьИсключение, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылки Цикл
			Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.Адрес, ТекЯщик.Представление));
		КонецЦикла;
		
		ТекстСообщения = "Загрузка произведена по адресу: " + АдресWS + Символы.ПС + Символы.ПС + ТекстСообщения;
		
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.ТипТекста = "HTML";
		ПараметрыПисьма.Тело = ТекстHTMLСОшибками(ТекстСообщения);
		//ПараметрыПисьма.Тело = ТекстСообщения;
		
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьСообщение(УчетнаяЗаписьПочты, ПараметрыПисьма);
			текстРассылки = "Рассылка завершена";
		Исключение
			текстРассылки = "Рассылка не удалась: "; 
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Для Каждого Элемент из Сообщения Цикл
				текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
			КонецЦикла;
		КонецПопытки;
		Сообщить(текстРассылки);
		
	КонецЕсли;
	
КонецПроцедуры	

Функция ТекстHTMLСОшибками(ТекстСообщения)
	
	Х =	"";
	Х =	Х + "<html><head><meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" /></head>"+
	"<body style=""font-family:Arial, Helvetica, sans-serif;color:black;"">"+
	"<b>"+ ТекстСообщения +"</b><br/><br/>";
	
	Х = Х + "<b>" + "Всего загружено данных по Портфелям: " + ДанныеДляРассылки.КоличествоПортфелей + "</b><br/>";
	Х = Х + "<b>" + "Всего фактических позиций: " + ДанныеДляРассылки.КоличествоФактическихПозиций + "</b><br/>";
	Х = Х + "<b>" + "Позиций с ошибками: " + ДанныеДляРассылки.КоличествоОшибок + "</b><br/><br/>";
	
	Если ДанныеДляРассылки.ПозицииСОшибкой.Количество() Тогда
		
		//Заголовки
		Х =	Х + "<table BORDERCOLOR=""Black"" border-style= ""solid"" border-collapse =""collapse"" border=""1""><tr>" + Символы.ПС;
		Для каждого Колонка Из ДанныеДляРассылки.ПозицииСОшибкой.Колонки Цикл
			Х =	Х + "<th align=""center"" bgcolor=""#C0C0C0"">" + Колонка.Заголовок + "</th>" + Символы.ПС;
		КонецЦикла;
		Х =	Х + "</tr>" + Символы.ПС;
		
		//Строки
		Для каждого Строка Из ДанныеДляРассылки.ПозицииСОшибкой Цикл
			Х =	Х + "<tr>" + Символы.ПС;
			Для каждого Колонка Из ДанныеДляРассылки.ПозицииСОшибкой.Колонки Цикл
				Значение = Строка(Строка[Колонка.Имя]);
				Значение = СтрЗаменить(Значение, Символы.ПС, "<br/>");
				Х =	Х + "<td>"+ Значение +"</td>" + Символы.ПС;
			КонецЦикла;
		    Х =	Х + "</tr>"+Символы.ПС;
		КонецЦикла;
		
		Х =	Х + "</table>" + Символы.ПС;
	КонецЕсли;
	
	Х =	Х + "</body></html>";
	
	
	
	Возврат Х;
КонецФункции

