Функция ОбработатьОтветФактПозицииIntraDay(ОтветXDTO, ФабрикаСервиса, вклОтладка = Ложь)

	ТЗ_ФО = Новый ТаблицаЗначений;  
	ТЗ_ФО.Колонки.Добавить("Регистратор");
	ТЗ_ФО.Колонки.Добавить("СделкаРЕПОНомер");
	ТЗ_ФО.Колонки.Добавить("СделкаРЕПОИдентификатор");
	ТЗ_ФО.Колонки.Добавить("НомерСтроки");
	ТЗ_ФО.Колонки.Добавить("Портфель");
	ТЗ_ФО.Колонки.Добавить("ПортфельВнешнийКод");
	ТЗ_ФО.Колонки.Добавить("МестоХраненияВнешнийКод");
	ТЗ_ФО.Колонки.Добавить("Актив");
	ТЗ_ФО.Колонки.Добавить("АктивISIN");
	ТЗ_ФО.Колонки.Добавить("СубпортфельВнешнийКод");
	ТЗ_ФО.Колонки.Добавить("Количество");
	ТЗ_ФО.Колонки.Добавить("Стоимость");
	
	Результат = Новый Структура("ЕстьОшибки, ТекстОшибки, ТЗ_ФО", Ложь, "", ТЗ_ФО);
	
	Если ОтветXDTO.СтатусОтвета.Код <> 0 тогда
		Результат.ТекстОшибки = "Внутренняя ошибка сервиса: "+ ОтветXDTO.СтатусОтвета.Описание;
		Результат.ЕстьОшибки = Истина;
	КонецЕсли;
	
	Для Каждого хдтоОтвеСообщение Из ОтветXDTO.СтатусОтвета.Сообщения Цикл
		Результат.ТекстОшибки = Результат.ТекстОшибки + Символы.ПС + "СтатусОтвета.Сообщения: "+ ?(хдтоОтвеСообщение.ЭтоОшибка, "err", "inf") + " [" + хдтоОтвеСообщение.Код + "] " + хдтоОтвеСообщение.Описание;
	КонецЦикла;
	
	Для каждого ТекСтрока Из ОтветXDTO.Строка Цикл
		
		НоваяСтрока = ТЗ_ФО.Добавить();
		
		Для Каждого ТекПоказатель Из ТекСтрока.Показатель Цикл
			НоваяСтрока[ТекПоказатель.Имя] = ТекПоказатель.Значение;
		КонецЦикла;
		
	КонецЦикла;
	
	Результат.ТЗ_ФО = ТЗ_ФО;
	
	Если вклОтладка Тогда
		обЗапись = новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ОтветXDTO);
		Результат.Вставить("ТекстОтвета", обЗапись.Закрыть());
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ОбработатьОтветФактПозицииIntraDay()

Функция ОбработатьОтветРЕПО(ОтветXDTO, ФабрикаСервиса, вклОтладка = Ложь, ДатаПубликации)

	ТЗ_ФО = Новый ТаблицаЗначений;  
	ТЗ_ФО.Колонки.Добавить("Актив");
	ТЗ_ФО.Колонки.Добавить("Валюта");
	ТЗ_ФО.Колонки.Добавить("СделкаСЦК");
	ТЗ_ФО.Колонки.Добавить("НомерСделки");
	ТЗ_ФО.Колонки.Добавить("Направление");
	ТЗ_ФО.Колонки.Добавить("Портфель");
	ТЗ_ФО.Колонки.Добавить("Субпортфель"); 
	ТЗ_ФО.Колонки.Добавить("СубпортфельЦБ");
	ТЗ_ФО.Колонки.Добавить("МестоХранения");
	ТЗ_ФО.Колонки.Добавить("МестоХраненияЦБ");
	ТЗ_ФО.Колонки.Добавить("Количество");
	ТЗ_ФО.Колонки.Добавить("СуммаРЕПО");
	ТЗ_ФО.Колонки.Добавить("СуммаРЕПОРубли");
	ТЗ_ФО.Колонки.Добавить("СделкаРЕПО");
	ТЗ_ФО.Колонки.Добавить("ИсполнениеСделкиРЕПОПоДеньгам");
	ТЗ_ФО.Колонки.Добавить("ИсполнениеСделкиРЕПОПоЦБ");
	ТЗ_ФО.Колонки.Добавить("ДеньРасчета");
	ТЗ_ФО.Колонки.Добавить("ДеньгиУчтеныМО");
	ТЗ_ФО.Колонки.Добавить("НетПоручения");
	
	Результат = Новый Структура("ЕстьОшибки, ТекстОшибки, ТЗ_ФО", Ложь, "", ТЗ_ФО);
	
	Если ОтветXDTO.СтатусОтвета.Код <> 0 тогда
		Результат.ТекстОшибки = "Внутренняя ошибка сервиса: "+ ОтветXDTO.СтатусОтвета.Описание;
		Результат.ЕстьОшибки = Истина;
	КонецЕсли;
	
	Для Каждого хдтоОтвеСообщение Из ОтветXDTO.СтатусОтвета.Сообщения Цикл
		Результат.ТекстОшибки = Результат.ТекстОшибки + Символы.ПС + "СтатусОтвета.Сообщения: "+ ?(хдтоОтвеСообщение.ЭтоОшибка, "err", "inf") + " [" + хдтоОтвеСообщение.Код + "] " + хдтоОтвеСообщение.Описание;
	КонецЦикла;
	
	Для каждого ТекСтрока Из ОтветXDTO.Строка Цикл
		
		НоваяСтрока = ТЗ_ФО.Добавить();
		СуммаВторойЧастиРЕПО = 0;
		СуммаПервойЧастиРЕПО = 0;
		
		МестоХраненияВнешнийКод = "";
		МестоХраненияЦБВнешнийКод = "";
		Для Каждого ТекПоказатель Из ТекСтрока.Показатель Цикл
			Если ТекПоказатель.Имя="АктивВнешнийКод" Тогда
				НоваяСтрока.Актив = ПолучитьАктив(ТекПоказатель.Значение);
			ИначеЕсли ТекПоказатель.Имя="ВалютаРасчетовКод" Тогда
				НоваяСтрока.Валюта = ПолучитьВалюта(ТекПоказатель.Значение);
			ИначеЕсли ТекПоказатель.Имя="СделкаСЦК" Тогда
				НоваяСтрока.СделкаСЦК = ?(ТекПоказатель.Значение="false", Ложь, Истина);
			ИначеЕсли ТекПоказатель.Имя="ПортфельВнешнийКод" Тогда
				НоваяСтрока.Портфель = ПолучитьМандат(ТекПоказатель.Значение);
			ИначеЕсли ТекПоказатель.Имя="МестоХраненияВнешнийКод" Тогда 
				МестоХраненияВнешнийКод = ТекПоказатель.Значение;
			ИначеЕсли ТекПоказатель.Имя="ВидМестаХранения" Тогда 
				НоваяСтрока.МестоХранения = МХПоКоду(МестоХраненияВнешнийКод, ТекПоказатель.Значение);
			ИначеЕсли ТекПоказатель.Имя="МестоХраненияЦБВнешнийКод" Тогда 
				МестоХраненияЦБВнешнийКод = ТекПоказатель.Значение;
			ИначеЕсли ТекПоказатель.Имя="ВидМестаХраненияЦБ" Тогда 
				НоваяСтрока.МестоХраненияЦБ = МХПоКоду(МестоХраненияЦБВнешнийКод, ТекПоказатель.Значение);
			ИначеЕсли ТекПоказатель.Имя="СубпортфельВнешнийКод" Тогда
				НоваяСтрока.Субпортфель = ПолучитьСчетМандата(ТекПоказатель.Значение);
			ИначеЕсли ТекПоказатель.Имя="СубпортфельЦБВнешнийКод" Тогда
				НоваяСтрока.СубпортфельЦБ = ПолучитьСчетМандата(ТекПоказатель.Значение);
			ИначеЕсли ТекПоказатель.Имя="Количество" Тогда
				НоваяСтрока.Количество = ТекПоказатель.Значение;
			ИначеЕсли ТекПоказатель.Имя="Направление" Тогда
				НоваяСтрока.Направление = ТекПоказатель.Значение;
			ИначеЕсли ТекПоказатель.Имя="НомерСделки" Тогда
				НоваяСтрока.НомерСделки = СтрЗаменить(СтрЗаменить(ТекПоказатель.Значение, " ", ""), Символы.НПП, "");
			ИначеЕсли ТекПоказатель.Имя="СуммаПервойЧастиРЕПО" Тогда
				СуммаПервойЧастиРЕПО = Число(СтрЗаменить(СтрЗаменить(ТекПоказатель.Значение, " ", ""), Символы.НПП, ""));
			ИначеЕсли ТекПоказатель.Имя="СуммаВторойЧастиРЕПО" Тогда
				СуммаВторойЧастиРЕПО = Число(СтрЗаменить(СтрЗаменить(ТекПоказатель.Значение, " ", ""), Символы.НПП, ""));
			ИначеЕсли ТекПоказатель.Имя="ДеньРасчета" Тогда
				НоваяСтрока.ДеньРасчета = ?(ТекПоказатель.Значение="true", Истина, Ложь);
			ИначеЕсли ТекПоказатель.Имя="НетПоручения" Тогда
				НоваяСтрока.НетПоручения = ?(ТекПоказатель.Значение="true", Истина, Ложь);
			КонецЕсли;
			
		КонецЦикла;
		
		НоваяСтрока.СуммаРЕПО = ?(НоваяСтрока.ДеньРасчета, СуммаВторойЧастиРЕПО, СуммаПервойЧастиРЕПО);
		
	КонецЦикла;
	
	ВалютаРубли = Справочники.Валюты.RUB;
	
	Для каждого СтрокаТЗ_ФО Из ТЗ_ФО Цикл
		
		ИсполнениеСделкиРЕПОПоДеньгам = Ложь;
		ИсполнениеСделкиРЕПОПоЦБ = Ложь;  
		СделкаЗакрыта = Ложь; 
		СтрокаТЗ_ФО.ДеньгиУчтеныМО = Ложь;
		СтрокаТЗ_ФО.СделкаРЕПО = ПолучитьСделкаРЕПОПоНомеру(СтрокаТЗ_ФО.НомерСделки, ИсполнениеСделкиРЕПОПоДеньгам, ИсполнениеСделкиРЕПОПоЦБ, СделкаЗакрыта, ДатаПубликации);
		СтрокаТЗ_ФО.ИсполнениеСделкиРЕПОПоДеньгам = ИсполнениеСделкиРЕПОПоДеньгам;
		СтрокаТЗ_ФО.ИсполнениеСделкиРЕПОПоЦБ = ИсполнениеСделкиРЕПОПоЦБ;
		ДатаПлатежаПо1Части = СтрокаТЗ_ФО.СделкаРЕПО.ПлановаяДатаПлатежаПо1Части;
		СтрокаТЗ_ФО.СуммаРЕПОРубли = ?(СтрокаТЗ_ФО.СделкаРЕПО.Валюта=ВалютаРубли, СтрокаТЗ_ФО.СуммаРЕПО, РаботаСКурсамиВалют.ПересчитатьВВалюту(СтрокаТЗ_ФО.СуммаРЕПО, СтрокаТЗ_ФО.СделкаРЕПО.Валюта, ВалютаРубли, ДатаПлатежаПо1Части));
		
		Если СтрокаТЗ_ФО.ДеньРасчета Тогда
			//Если НЕ СделкаЗакрыта Тогда
				СтрокаТЗ_ФО.СуммаРЕПО = -СтрокаТЗ_ФО.СуммаРЕПО;
				СтрокаТЗ_ФО.СуммаРЕПОРубли = -СтрокаТЗ_ФО.СуммаРЕПОРубли;
			//КонецЕсли;
		ИначеЕсли СтрокаТЗ_ФО.СделкаРЕПО<>Документы.СделкаРЕПО.ПустаяСсылка() Тогда
			//Если НЕ СделкаЗакрыта Тогда
				СтрокаТЗ_ФО.ДеньгиУчтеныМО = Истина;
			//КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	Результат.ТЗ_ФО = ТЗ_ФО;
	
	Если вклОтладка Тогда
		обЗапись = новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ОтветXDTO);
		Результат.Вставить("ТекстОтвета", обЗапись.Закрыть());
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ОбработатьОтветРЕПО()

Функция ОбработатьОтветПоискРЕПО(ОтветXDTO, ФабрикаСервиса, вклОтладка = Ложь)

	Результат = Новый Структура("ЕстьОшибки, ТекстОшибки, НайденСделка", Ложь, "", Ложь);
	
	Если ОтветXDTO.СтатусОтвета.Код <> 0 тогда
		Результат.ТекстОшибки = "Внутренняя ошибка сервиса: "+ ОтветXDTO.СтатусОтвета.Описание;
		Результат.ЕстьОшибки = Истина;
	КонецЕсли;
	
	Для Каждого хдтоОтвеСообщение Из ОтветXDTO.СтатусОтвета.Сообщения Цикл
		Результат.ТекстОшибки = Результат.ТекстОшибки + Символы.ПС + "СтатусОтвета.Сообщения: "+ ?(хдтоОтвеСообщение.ЭтоОшибка, "err", "inf") + " [" + хдтоОтвеСообщение.Код + "] " + хдтоОтвеСообщение.Описание;
	КонецЦикла;
	
	Для каждого ТекСтрока Из ОтветXDTO.Строка Цикл
		Для Каждого ТекПоказатель Из ТекСтрока.Показатель Цикл
			Результат.НайденСделка = Не ПустаяСтрока(ТекПоказатель.Значение);
		КонецЦикла;
	КонецЦикла;
	
	Если вклОтладка Тогда
		обЗапись = новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ОтветXDTO);
		Результат.Вставить("ТекстОтвета", обЗапись.Закрыть());
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ОбработатьОтветПоискРЕПО()

Функция МХПоКоду(ВнешнийКод, ВидМХ)
                         
	Если ВидМХ="Брокерские счета" Тогда
		ВидМХСпр = "БрокерскиеСчета";
	ИначеЕсли ВидМХ="Банковские счета" Тогда
		ВидМХСпр = "БанковскиеСчета";
	Иначе
		Возврат ПланыВидовХарактеристик.ВидыСчетаМандата.ПустаяСсылка();	
	КонецЕсли;                         
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МХ.Ссылка КАК МестоХранения
		|ИЗ
		|	Справочник."+ВидМХСпр+" КАК МХ
		|ГДЕ
		|	МХ.КодМестаХранения = &КодМестаХранения";
	
	Запрос.УстановитьПараметр("КодМестаХранения", ВнешнийКод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Возврат ВыборкаДетальныеЗаписи.МестоХранения;
	КонецЕсли;
	
	Возврат ПланыВидовХарактеристик.ВидыСчетаМандата.ПустаяСсылка();

КонецФункции // МХПоКоду(МестоХраненияВнешнийКод, ТекПоказатель.Значение)()


