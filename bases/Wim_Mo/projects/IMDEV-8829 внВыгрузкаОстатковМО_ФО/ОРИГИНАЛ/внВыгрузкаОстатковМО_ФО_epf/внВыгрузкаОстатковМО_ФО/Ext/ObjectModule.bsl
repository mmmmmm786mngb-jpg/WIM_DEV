	Иначе
	    обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО = ФабрикаСервиса.Создать(обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.Свойства().Получить("СделкаРЕПО").Тип);	
	КонецЕсли;
	
	обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоРежимуТоргов = ФабрикаСервиса.Создать(обХДТО.РеквизитыПоВидуОперации.РЕПО.Свойства().Получить("РеквизитыПоРежимуТоргов").Тип);	
	обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоРежимуТоргов.Биржевая =  ФабрикаСервиса.Создать(обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоРежимуТоргов.Свойства().Получить("Биржевая").Тип); 
	обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоРежимуТоргов.Биржевая.Биржа = ПроцедурыФункцииОбмена_МО_ФО.хдтоБиржаПоиск(СтрокаСделкиРЕПО.СделкаРЕПО.Биржа, ФабрикаСервиса);
	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоРежимуТоргов.Биржевая.КодКлиента  
	хдтоОбъект = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "РежимТорговПоиск"));
	хдтоОбъект.Наименование = СтрокаСделкиРЕПО.СделкаРЕПО.КодКласса;
	обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоРежимуТоргов.Биржевая.РежимТоргов = хдтоОбъект;
	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоРежимуТоргов.Биржевая.ТорговыйСчет
	
	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО.Котировка
	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО.Цена
