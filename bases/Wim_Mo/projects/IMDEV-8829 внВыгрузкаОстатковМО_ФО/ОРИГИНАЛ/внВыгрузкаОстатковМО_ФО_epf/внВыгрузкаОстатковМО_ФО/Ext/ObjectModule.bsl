Функция ПолучитьСделкиИсполнениеФО()
	
	ДатаЗаполнения = ТекущаяДата(); 
	СтруктураСервиса = ПолучитьОпределениеСервиса();
	Если СтруктураСервиса.ЕстьОшибки Тогда
		Сообщить(СтруктураСервиса.ОписаниеОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Определение = СтруктураСервиса.ОпределениеWS;
	ФабрикаСервиса = Определение.ФабрикаXDTO;
	URIПространстваИмен = Определение.Сервисы[0].URIПространстваИмен;
	Прокси = Новый WSПрокси(Определение, URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
	Если ЭтотОбъект.АдресWS="http://smsk02mg31u/AVC_PP_FO/ws/avancore_ws.1cws?wsdl" Тогда
		Прокси.Пользователь = "admin";
		Прокси.Пароль = "адм232882";
	КонецЕсли;
	
	ТипЗапросСпискаСделок = ФабрикаСервиса.Тип(URIПространстваИмен, "ЗапросСпискаСделок");
	ЗапросСпискаСделок = ФабрикаСервиса.Создать(ТипЗапросСпискаСделок);
	
	ЗапросСпискаСделок.Заголовок = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип("http://avancore.ru/xsd", "Заголовок"));
	ЗапросСпискаСделок.Заголовок.УникальныйИдентификатор = СокрЛП(новый УникальныйИдентификатор());
	ЗапросСпискаСделок.Заголовок.ДатаВыполнения = ТекущаяДата();
	ЗапросСпискаСделок.Заголовок.ИдентификаторСистемы = "МО 1.0";
	ЗапросСпискаСделок.Заголовок.ИмяПользователя = "Сервис";
	ЗапросСпискаСделок.Заголовок.ДатаВыгрузки = КонецДня(ДатаЗаполнения);
	
	ДатыПериода = ДатыПериода();
	ЗаполнитьЗначенияСвойств(ЗапросСпискаСделок, ДатыПериода); 
	ВидОперации = ФабрикаСервиса.Создать(ЗапросСпискаСделок.ВидыОпераций.ВладеющееСвойство.Тип);
	ВидОперации.ВидОперации = "Сделка";
	ЗапросСпискаСделок.ВидыОпераций.Добавить(ВидОперации); 
	ЗапросСпискаСделок.ВыгружатьИсполненияПоСделкам = "Внебиржевые";
	ЗапросСпискаСделок.ТипСделок = "Внебиржевые";
	
	Ответ = Прокси.GetListOfDeals(ЗапросСпискаСделок);
	
	Возврат Ответ;

