Функция СформироватьПакетПоМандату(ВыборкаПортфели, ствАктивыНеВыгружать, ФабрикаСервиса)
	
	ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
	ВыборкаПозиции = ВыборкаПортфели.Выбрать();
	
	Пока ВыборкаПозиции.Следующий() Цикл
		
		Если ствАктивыНеВыгружать[ВыборкаПозиции.Актив] <> Неопределено Или ВыборкаПозиции.Актив="НЕОПРЕДЕЛЕНО" Или ПустаяСтрока(ВыборкаПозиции.Актив) Тогда
			Продолжить;
		КонецЕсли;
		
		//IMAPPS-19973++
		ДанныеДляРассылки.КоличествоФактическихПозиций = ДанныеДляРассылки.КоличествоФактическихПозиций + 1;
		//IMAPPS-19973--
		
		хдтоДобавитьВПакетФактическаяПозиция(ПакетХДТО,
		ДатаДляФронт,
		ВыборкаПозиции.Актив,
		ВыборкаПозиции.Мандат,
		ВыборкаПозиции.СчетМандата,
		ВыборкаПозиции.ДоходыКПолучению,
		ВыборкаПозиции.МХ,
		ВыборкаПозиции.Колво,
		ВыборкаПозиции.Стоим,
		ВыборкаПозиции.СуммаНКД, 
		ВыборкаПозиции.СуммаЗадолженность,
		ВыборкаПозиции.ДСиЗадолженность,
		ФабрикаСервиса);
		
	КонецЦикла;
	
	СтрокиСЧА = СЧА_РСА.НайтиСтроки(новый Структура("Мандат", ВыборкаПортфели.Мандат));
	
	Для каждого СтрокаВыгрузить из СтрокиСЧА Цикл
		хдтоДобавитьВПакетСтоимостьЧистыхАктивов(ПакетХДТО, ДатаДляФронт, СтрокаВыгрузить.Мандат, СтрокаВыгрузить.СЧА, СтрокаВыгрузить.РСА, ФабрикаСервиса);
	КонецЦикла;
	
	СтрокиСделкиРЕПОМО = СделкиРЕПОМО.НайтиСтроки(новый Структура("Портфель", ВыборкаПортфели.Мандат));
	
	Для каждого СтрокаСделкиРЕПОМО из СтрокиСделкиРЕПОМО Цикл
		ОпубликоватьСделкиРЕПО(ПакетХДТО, СтрокаСделкиРЕПОМО, ФабрикаСервиса);
	КонецЦикла;
	        
	Возврат ПакетХДТО;
КонецФункции

Процедура ОпубликоватьСделкиРЕПО(ПакетХДТО, СтрокаСделкиРЕПОМО, ФабрикаСервиса)

	типХДТО	 = ФабрикаСервиса.Тип(ПространствоИменСервиса, "СделкаРЕПО");
	обХДТО = ФабрикаСервиса.Создать(типХДТО);
	обХДТО.Актив = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПоиск(СтрокаСделкиРЕПОМО.Актив, ФабрикаСервиса);
	обХДТО.ВалютаРасчетов = ПроцедурыФункцииОбмена_МО_ФО.хдтоВалютаПоиск(СтрокаСделкиРЕПОМО.Валюта, ФабрикаСервиса);
	//обХДТО.ВерхнийДисконт                      
	Если СтрокаСделкиРЕПОМО.СделкаСЦК Тогда
		обХДТО.ВидОперацииРЕПО = "СделкаРЕПО_С_ЦК";
	Иначе
		обХДТО.ВидОперацииРЕПО = "СделкаРЕПО";	
	КонецЕсли;
	
	обХДТО.Внебиржевая = Ложь;
	обХДТО.ВнешнийКод = Строка(СтрокаСделкиРЕПОМО.СделкаРЕПО.УникальныйИдентификатор());
	обХДТО.Дата = СтрокаСделкиРЕПОМО.СделкаРЕПО.Дата;
	обХДТО.ДатаОплатыВторойЧастиРЕПО = СтрокаСделкиРЕПОМО.СделкаРЕПО.ПлановаяДатаПлатежаПо2Части;
	обХДТО.ДатаОплатыПервойЧастиРЕПО = СтрокаСделкиРЕПОМО.СделкаРЕПО.ПлановаяДатаПлатежаПо1Части;
	обХДТО.ДатаПоставкиВторойЧастиРЕПО = СтрокаСделкиРЕПОМО.СделкаРЕПО.ПлановаяДатаПоставкиПо2Части;
	обХДТО.ДатаПоставкиПервойЧастиРЕПО = СтрокаСделкиРЕПОМО.СделкаРЕПО.ПлановаяДатаПоставкиПо1Части;
	//обХДТО.ДляПрогноза
	обХДТО.Количество = СтрокаСделкиРЕПОМО.СделкаРЕПО.Количество;
	обХДТО.Контрагент = ПроцедурыФункцииОбмена_МО_ФО.хдтоКонтрагентПоиск(СтрокаСделкиРЕПОМО.СделкаРЕПО.Контрагент, ФабрикаСервиса);
	//обХДТО.КупонВторойЧастиРЕПО
	//обХДТО.КупонПервойЧастиРЕПО
	обХДТО.МестоХранения = ПроцедурыФункцииОбмена_МО_ФО.хдтоМестоХраненияПоиск(СтрокаСделкиРЕПОМО.МестоХранения, ФабрикаСервиса);
	обХДТО.МестоХраненияЦБ = ПроцедурыФункцииОбмена_МО_ФО.хдтоМестоХраненияПоиск(СтрокаСделкиРЕПОМО.МестоХраненияЦБ, ФабрикаСервиса);
	обХДТО.Направление = СтрокаСделкиРЕПОМО.Направление;
	//обХДТО.НачальныйДисконт
	//обХДТО.НеУчитыватьМестоХраненияЦБ
	//обХДТО.НижнийДисконт
	обХДТО.НомерСделки = СтрокаСделкиРЕПОМО.СделкаРЕПО.НомерСделки;
	//обХДТО.ПометкаУдаления
	обХДТО.Портфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоПорфельПоиск(СтрокаСделкиРЕПОМО.Портфель, ФабрикаСервиса);  
	хдтоПоручениеПоиск = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "ПоручениеПоиск"));
	хдтоПоручениеПоиск.ВнешнийКод = Строка(СтрокаСделкиРЕПОМО.СделкаРЕПО.УникальныйИдентификатор());
	обХДТО.Поручение = хдтоПоручениеПоиск;
	обХДТО.Проведен = Истина;
	//обХДТО.РучнаяКорректировка
	обХДТО.СтавкаРЕПО = СтрокаСделкиРЕПОМО.СделкаРЕПО.СрокРЕПО;
	обХДТО.СубПортфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоСубпортфельПоиск(СтрокаСделкиРЕПОМО.Субпортфель, ФабрикаСервиса);
	обХДТО.СубпортфельЦБ = ПроцедурыФункцииОбмена_МО_ФО.хдтоСубпортфельПоиск(СтрокаСделкиРЕПОМО.СубпортфельЦБ, ФабрикаСервиса);
	обХДТО.СуммаВторойЧастиРЕПО = СтрокаСделкиРЕПОМО.СделкаРЕПО.СуммаСделкиПоВторойЧасти;
	обХДТО.СуммаПервойЧастиРЕПО = СтрокаСделкиРЕПОМО.СделкаРЕПО.СуммаСделкиПоПервойЧасти; 
	//обХДТО.ТипПортфеля
	обХДТО.ЦенаВторойЧастиРЕПО = СтрокаСделкиРЕПОМО.СделкаРЕПО.СуммаСделкиПоВторойЧасти/СтрокаСделкиРЕПОМО.СделкаРЕПО.Количество;
	обХДТО.ЦенаПервойЧастиРЕПО = СтрокаСделкиРЕПОМО.СделкаРЕПО.СуммаСделкиПоПервойЧасти/СтрокаСделкиРЕПОМО.СделкаРЕПО.Количество;
	
	ПакетХДТО.Документы.СделкаРЕПО.Добавить(обХДТО);		

КонецПроцедуры //ОпубликоватьСделкиРЕПО()

Процедура ОпубликоватьПорученияРЕПОМО(ФабрикаСервиса, Прокси)
    
    Попытка
		
		ПакетПорученияХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакетПоручений(ФабрикаСервиса);
		ПакетПорученияХДТО.ЗапускатьПроверкуЛимитов = Ложь;
	    
		Для каждого СтрокаСделкиРЕПО из СделкиРЕПОМО Цикл   
			хдтоДобавитьВПакетПоручениеРЕПО(ПакетПорученияХДТО, СтрокаСделкиРЕПО, ФабрикаСервиса);
		КонецЦикла;	
		
		Ответ = Прокси.DownloadOrders(ПакетПорученияХДТО);
					
		Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, вклОтладка, Неопределено);
		Если Рез.ЕстьОшибки Тогда
			ЕстьОшибки = истина;
			ЕстьОшибкиПортфель = истина;
		КонецЕсли;
					
		Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
			ТекстовыйЛог.ДобавитьСтроку("Ошибка выгрузки поручений РЕПО из МО");
			ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
		КонецЕсли;
					
		Если вклОтладка Тогда
			ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОтвета);
		КонецЕсли;
				
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ЕстьОшибки = Истина;
		ТекстовыйЛог.ДобавитьСтроку("Ошибки создания виртуальных субпортфелей");
		ТекстовыйЛог.ДобавитьСтроку(ОписаниеОшибки);
	КонецПопытки;

КонецПроцедуры // ОпубликоватьСделкиРЕПОМО()

Процедура ОпубликоватьСделкиРЕПОМО(ФабрикаСервиса, Прокси)
	
	Попытка
		
		ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
		
		Для каждого СтрокаСделкиРЕПО из СделкиРЕПОМО Цикл   
			ОпубликоватьСделкиРЕПО(ПакетХДТО, СтрокаСделкиРЕПО, ФабрикаСервиса);
		КонецЦикла;	
		
		Ответ = Прокси.DownloadPosition(ПакетХДТО);
					
		Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, вклОтладка, Неопределено);
		Если Рез.ЕстьОшибки Тогда
			ЕстьОшибки = истина;
			ЕстьОшибкиПортфель = истина;
		КонецЕсли;
					
		Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
			ТекстовыйЛог.ДобавитьСтроку("Ошибка выгрузки сделок РЕПО из МО");
			ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
		КонецЕсли;
					
		Если вклОтладка Тогда
			ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОтвета);
		КонецЕсли;
				
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ЕстьОшибки = Истина;
		ТекстовыйЛог.ДобавитьСтроку("Ошибки создания виртуальных субпортфелей");
		ТекстовыйЛог.ДобавитьСтроку(ОписаниеОшибки);
	КонецПопытки;

КонецПроцедуры // ОпубликоватьСделкиРЕПОМО()

Процедура хдтоДобавитьВПакетПоручениеРЕПО(ПакетХДТО, СтрокаСделкиРЕПО, ФабрикаСервиса)

	типХДТО = ФабрикаСервиса.Тип(ПространствоИменСервиса, "Поручение");
	обХДТО = ФабрикаСервиса.Создать(типХДТО);
	обХДТО.Проведен = Истина;
	обХДТО.ПометкаУдаления = Ложь;
	обХДТО.ВнешнийКод = Строка(СтрокаСделкиРЕПО.СделкаРЕПО.УникальныйИдентификатор());
	обХДТО.Дата = СтрокаСделкиРЕПО.СделкаРЕПО.Дата;
	обХДТО.Ответственный = хдтоПользовательПоиск("svc_avancore", ФабрикаСервиса);
	обХДТО.Актив = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПозицияПоиск(СтрокаСделкиРЕПО.Актив, ФабрикаСервиса);
	
	обХДТО.РеквизитыПоВидуОперации = ФабрикаСервиса.Создать(обХДТО.Свойства().Получить("РеквизитыПоВидуОперации").Тип);
	обХДТО.РеквизитыПоВидуОперации.РЕПО = ФабрикаСервиса.Создать(обХДТО.РеквизитыПоВидуОперации.Свойства().Получить("РЕПО").Тип);

	обХДТО.РеквизитыПоВидуОперации.РЕПО.Направление = СтрокаСделкиРЕПО.Направление;
	обХДТО.РеквизитыПоВидуОперации.РЕПО.Портфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоПорфельПоиск(СтрокаСделкиРЕПО.Портфель, ФабрикаСервиса);
	обХДТО.РеквизитыПоВидуОперации.РЕПО.ВалютаРасчетов = ПроцедурыФункцииОбмена_МО_ФО.хдтоВалютаПоиск(СтрокаСделкиРЕПО.Валюта, ФабрикаСервиса);
	обХДТО.РеквизитыПоВидуОперации.РЕПО.ДатаВторойЧастиРЕПО = СтрокаСделкиРЕПО.СделкаРЕПО.ПлановаяДатаПоставкиПо2Части;
