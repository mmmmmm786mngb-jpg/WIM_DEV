	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО.Лот
	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО.Партнер
	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО.КодРасчетовРЕПО
	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО.ЦенаВВалютеИнструмента
	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО.КурсПересчетов
	//обХДТО.РеквизитыПоВидуОперации.РЕПО.РеквизитыПоВидуРЕПО.СделкаРЕПО.КратностьПересчетов
	
			
	ПакетХДТО.Поручения.Добавить(обХДТО);  
	
КонецПроцедуры //хдтоДобавитьВПакетСделкаРЕПО()

#КонецОбласти

Процедура ЗаполнитьРейтинги(Прокси, ФабрикаСервиса)
	
	Запрос = новый Запрос;
	//Запрос.УстановитьПараметр("", );
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Ссылка
	|ИЗ
	|	Документ.УстановкаРейтингаПоЭмитенту КАК т
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(т.Дата, ДЕНЬ) В
	|			(ВЫБРАТЬ
	|				НАЧАЛОПЕРИОДА(МАКСИМУМ(т.Дата), ДЕНЬ)
	|			ИЗ
	|				Документ.УстановкаРейтингаПоЭмитенту КАК т)";
	
	обПакет = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			хдтоДобавитьВПакетУстановкаРейтингаПоЭмитенту(обПакет, Выборка.Ссылка, ФабрикаСервиса);	
			//Ответ = Прокси.DownloadPosition(обПакет);
			Ответ = Прокси.DownloadPosition(обПакет);
			
			Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, вклОтладка);
			Если Рез.ЕстьОшибки Тогда
				ЕстьОшибки = истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
				ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
			КонецЕсли;
			
			Если вклОтладка Тогда
				ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОтвета);
			КонецЕсли;
			
			Если не Рез.ЕстьОшибки Тогда
				ТекстовыйЛог.ДобавитьСтроку(" * Выгрузка - успешно *");
			КонецЕсли;
			
		Исключение
				ТекстовыйЛог.ДобавитьСтроку("Выгрузка: "+ Выборка.Ссылка);
				ТекстовыйЛог.ДобавитьСтроку(ОписаниеОшибки());
				ЕстьОшибки = истина;
		КонецПопытки;
	КонецЦикла;
	
	
КонецПроцедуры
//WS PositionSet 

Процедура хдтоДобавитьВПакетФактическаяПозиция(обПакет, Период, вхАктив, вхПортфель, вхСубпортфель, ДоходыКПолучению, вхМХ, Колво, Стоим, СуммаНКД, СуммаЗадолженность, ДСиЗадолженность, ФабрикаСервиса)
	
	типХДТО	 = ФабрикаСервиса.Тип(ПространствоИменСервиса, "ФактическаяПозиция");
	обХДТО = ФабрикаСервиса.Создать(типХДТО);
	обХДТО.Дата = Период;
	обХДТО.Портфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоПорфельПоиск(вхПортфель, ФабрикаСервиса);
	обХДТО.Актив = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПозицияПоиск(вхАктив, ФабрикаСервиса);
	обХДТО.МестоХранения = ПроцедурыФункцииОбмена_МО_ФО.хдтоМестоХраненияПоиск(вхМХ, ФабрикаСервиса);
	
	Если ДоходыКПолучению = Истина Тогда
		обХДТО.Субпортфель = хдтоВиртуальныйСубпортфельПоиск(вхСубпортфель, ФабрикаСервиса);
	Иначе
		обХДТО.Субпортфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоСубпортфельПоиск(вхСубпортфель, ФабрикаСервиса);
	КонецЕсли;

	обХДТО.Количество = Колво;
	обХДТО.Стоимость = Стоим;
	обХДТО.НКД = СуммаНКД;
	обХДТО.Задолженность = СуммаЗадолженность;
	обХДТО.СуммаДенежныхСредствСЗадолженностью = ДСиЗадолженность;
	обПакет.РегистрыСведений.ФактическаяПозиция.Добавить(обХДТО);
	
	Отказ = Ложь;
	тхтОшибки = "";
	
КонецПроцедуры

Процедура хдтоДобавитьВПакетСтоимостьЧистыхАктивов(обПакет, Период, Портфель, СЧА, РСА, ФабрикаСервиса)
	
	типХДТО	 = ФабрикаСервиса.Тип(ПространствоИменСервиса, "РыночнаяСтоимостьИСтоимостьЧистыхАктивов");
	обХДТО = ФабрикаСервиса.Создать(типХДТО);
	обХДТО.Период = Период;
