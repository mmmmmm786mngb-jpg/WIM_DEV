//RKatunin IMDEV-3438
Процедура хдтоДобавитьВПакетИсполнениеСделки(обПакет, Сделка, вхАктив, вхПортфель, вхСубпортфель, вхМХ, КолвоСуммаАктив, Проведен, ФабрикаСервиса)
	
	типХДТО	 = ФабрикаСервиса.Тип(ПространствоИменСервиса, "ИсполнениеПоСделке");
	обХДТО = ФабрикаСервиса.Создать(типХДТО);
	обХДТО.Проведен = Проведен;
	обХДТО.Сделка = хдтоСделкаПоиск(Сделка, ФабрикаСервиса);
	обХДТО.Актив = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПозицияПоиск(вхАктив, ФабрикаСервиса);
	обХДТО.Портфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоПорфельПоиск(вхПортфель, ФабрикаСервиса);
	
	обХДТО.МестоХранения = ПроцедурыФункцииОбмена_МО_ФО.хдтоМестоХраненияПоиск(вхМХ, ФабрикаСервиса);
	обХДТО.Субпортфель = ПроцедурыФункцииОбмена_МО_ФО.хдтоСубпортфельПоиск(вхСубпортфель, ФабрикаСервиса);
	                   
	Количество = КолвоСуммаАктив;
	Если Сделка.ВидОперации=Перечисления.ВидыОперацийСделка.Поступление И ТипЗнч(вхАктив)=Тип("СправочникСсылка.Валюты") Тогда	                                                                                                                          
	    Количество = -Число(Количество);
	ИначеЕсли Сделка.ВидОперации=Перечисления.ВидыОперацийСделка.Продажа И ТипЗнч(вхАктив)=Тип("СправочникСсылка.Активы") Тогда
		Количество = -Число(Количество);
	КонецЕсли;	                    
	                    
	обХДТО.Количество = Количество;
	
	обПакет.Документы.ИсполненияПоСделке.Добавить(обХДТО);
	
	Отказ = Ложь;
	тхтОшибки = "";
	
КонецПроцедуры //RKatunin IMDEV-3438

//RKatunin IMDEV-3438

Функция ЦенныеБумагиНаДату(Дата, Отбор = Неопределено) Экспорт
	
	Условие = "";
	УсловиеМандат = "";
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли; 
	
	Запрос = Новый Запрос(ПолучитьТекстЗапросаЦенныеБумагиНаДату());
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", НачалоДня(Дата));
	
	Условие = "";
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("Мандаты") Тогда
			Условие = " И Мандат В (&Мандаты)";
			Запрос.УстановитьПараметр("Мандаты", Отбор.Мандаты);
		КонецЕсли; 
		Если Отбор.Свойство("СчетаМандатов") Тогда
			
			Условие = " И СчетМандата В (&СчетаМандатов)";
			Запрос.УстановитьПараметр("СчетаМандатов", Отбор.СчетаМандатов);
			
			Запрос.УстановитьПараметр("Мандаты", Отбор.ОтборМандаты);
			
		КонецЕсли;
	КонецЕсли;
	
	Если ОтборМандат Тогда
		ПроверитьУсловиеМандатыОтбор(Условие, Истина);
		Запрос.УстановитьПараметр("СписМандатОтбор", СписМандатОтбор);
	КонецЕсли;
	Запрос.УстановитьПараметр("Биржа",Справочники.Биржи.НайтиПоКоду("НРД_02"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", Условие);
	
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Регистр ""Ценные бумаги"": Ценные бумаги на дату");
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ДоходыКПолучениюНаДату()

Функция ДенежныеСредстваНаДату(Дата, Отбор = Неопределено) Экспорт
	
	Условие = "";
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаНачалаПериода", Новый Граница(НачалоДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаОкончанияПериода", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаВыгрузки", КонецДня(Дата));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Период КАК Период,
	|	т.Валюта КАК Валюта,
	|	т.ИсточникКурса КАК ИсточникКурса,
	|	т.Курс КАК Курс,
	|	т.Кратность КАК Кратность
	|ПОМЕСТИТЬ втКурсы
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаОкончанияПериода, ) КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Мандат,
	|	т.СчетМандата КАК СчетМандата,
	|	т.Валюта КАК Валюта,
	|	т.СуммаОстаток КАК Количество,
	|	0 КАК Задолженость,
	|	ЛОЖЬ КАК ДоходыКПолучению
	|ПОМЕСТИТЬ втОстатки
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.Остатки(&ДатаНачалаПериода, Мандат <> ЗНАЧЕНИЕ(Справочник.Мандаты.НеОпределен) И (Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Мандат.ДатаОкончания > &ДатаВыгрузки) &УсловиеОтбора) КАК т
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	т.Мандат,
	|	т.СчетМандата,
	|	т.Валюта,
	|	т.СуммаОстаток,
	|	0,
	|	ИСТИНА
	|ИЗ
	|	РегистрНакопления.ДоходыКПолучению.Остатки(&ДатаНачалаПериода, Мандат <> ЗНАЧЕНИЕ(Справочник.Мандаты.НеОпределен) И (Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Мандат.ДатаОкончания > &ДатаВыгрузки) &УсловиеОтбора) КАК т
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДвиженияДенежныхСредствВнутриДняОбороты.Мандат,
	|	ДвиженияДенежныхСредствВнутриДняОбороты.СчетМандата,
	|	ДвиженияДенежныхСредствВнутриДняОбороты.Валюта,
	|	ДвиженияДенежныхСредствВнутриДняОбороты.СуммаВыполненоОборот,
	|	0,
	|	ЛОЖЬ
	|ИЗ
	|	РегистрНакопления.ДвиженияДенежныхСредствВнутриДня.Обороты(&ДатаНачалаПериода, &ДатаОкончанияПериода, , Мандат <> ЗНАЧЕНИЕ(Справочник.Мандаты.НеОпределен) И (Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Мандат.ДатаОкончания > &ДатаВыгрузки) &УсловиеОтбора) КАК ДвиженияДенежныхСредствВнутриДняОбороты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втОстатки.Мандат КАК Мандат,
	|	втОстатки.СчетМандата КАК СчетМандата,
	|	втОстатки.Валюта КАК Валюта,
	|	втОстатки.ДоходыКПолучению КАК ДоходыКПолучению,
	|	СУММА(втОстатки.Количество) КАК Количество,
	|	СУММА(втОстатки.Задолженость) КАК Задолженость
	|ПОМЕСТИТЬ втОстаткиОбщ
	|ИЗ
	|	втОстатки КАК втОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	втОстатки.Мандат,
	|	втОстатки.СчетМандата,
	|	втОстатки.Валюта,
	|	втОстатки.ДоходыКПолучению
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Мандат,
	|	Остатки.СчетМандата,
	|	Остатки.Валюта,
	|	Остатки.ДоходыКПолучению,
	|	СУММА(Остатки.Количество) КАК Количество,
	|	СУММА(Остатки.Количество * ЕСТЬNULL(втКурсы.Курс, 0) / ЕСТЬNULL(втКурсы.Кратность, 1)) КАК Стоимость,
	|	СУММА(Остатки.Задолженость * ЕСТЬNULL(втКурсы.Курс, 0) / ЕСТЬNULL(втКурсы.Кратность, 1)) КАК Задолженность
	|ИЗ
	|	втОстаткиОбщ КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ втКурсы КАК втКурсы
	|		ПО Остатки.Валюта = втКурсы.Валюта
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Мандат,
	|	Остатки.СчетМандата,
	|	Остатки.ДоходыКПолучению,
	|	Остатки.Валюта";
	
	
	Условие = "";
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("Мандаты") Тогда
			Условие = " И Мандат В (&Мандаты)";
			Запрос.УстановитьПараметр("Мандаты", Отбор.Мандаты);
		КонецЕсли; 
		Если Отбор.Свойство("СчетаМандатов") Тогда
			
			Условие = " И СчетМандата В (&СчетаМандатов)";
			Запрос.УстановитьПараметр("СчетаМандатов", Отбор.СчетаМандатов);
			
			Запрос.УстановитьПараметр("Мандаты", Отбор.ОтборМандаты);
			
		КонецЕсли;
	КонецЕсли;
	
	Если ОтборМандат Тогда
		ПроверитьУсловиеМандатыОтбор(Условие, Истина);
		Запрос.УстановитьПараметр("СписМандатОтбор", СписМандатОтбор);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", Условие);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСоединения", " И " + Условие);
	
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Регистр ""Денежные средства"": Денежные средства");
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ДоходыКПолучениюНаДату()

