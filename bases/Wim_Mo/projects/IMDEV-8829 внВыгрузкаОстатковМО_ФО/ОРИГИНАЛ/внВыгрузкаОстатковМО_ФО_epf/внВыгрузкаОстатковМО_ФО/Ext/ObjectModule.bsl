	обХДТО.ТипИнструментовРисков = СокрЛП(сс.Стратегия.ТипИнструментовРисков.Наименование);
	обХДТО.МестоХранения = ПроцедурыФункцииОбмена_МО_ФО.хдтоМестоХраненияПоиск(сс.МестоХранения, ФабрикаСервиса);
