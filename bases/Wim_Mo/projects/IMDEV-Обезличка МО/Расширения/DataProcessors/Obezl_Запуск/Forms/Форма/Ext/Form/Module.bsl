#Область ОбработчикиСобытийФормы

// Описание: Инициализирует текст состояния при открытии формы.
//
// Параметры:
// Отказ - Булево - признак отказа от создания формы.
// СтандартнаяОбработка - Булево - признак выполнения стандартной обработки.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтатусВыполнения = "Готово к запуску обезличивания.";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормыЗакрытие

// Описание: Снимает опрос фонового задания при закрытии формы, иначе при завершении сеанса
//           возможен серверный вызов при запрете вызовов (ошибка ПараметрыРаботыКлиента / БСП).
//
// Параметры:
// Отказ - Булево - признак отказа от закрытия.
// СтандартнаяОбработка - Булево - стандартная обработка.
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	ИдентификаторЗаданияОбезличивания = "";
	АдресРезультатаОбезличивания = "";
	ОтключитьОбработчикОжидания("ПроверитьЗавершениеОбезличивания");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Описание: Запускает обезличивание данных из формы обработки.
//
// Параметры:
// Команда - КомандаФормы - источник вызова.
//
&НаКлиенте
Процедура Обезличить(Команда)
	
	СтатусВыполнения = "Выполняется обезличивание...";
	Состояние(СтатусВыполнения);
	
	РезультатЗапуска = ЗапуститьОбезличиваниеНаСервере();
	Если РезультатЗапуска = Неопределено Тогда
		СтатусВыполнения = "Ошибка запуска обезличивания.";
		ПоказатьПредупреждение(, СтатусВыполнения);
		Возврат;
	КонецЕсли;
	
	НачатьОжиданиеОбезличивания(РезультатЗапуска);
	
КонецПроцедуры

// Описание: Обрабатывает завершение длительной операции обезличивания.
//
// Параметры:
// Результат - Структура - результат ожидания по контракту БСП.
//
&НаКлиенте
Процедура ОбработатьРезультатОбезличивания(Результат)
	
	Если Результат = Неопределено Тогда
		СтатусВыполнения = "Результат обезличивания недоступен.";
		ПоказатьПредупреждение(, СтатусВыполнения);
		Возврат;
	КонецЕсли;
	
	СтатусОперации = "";
	Результат.Свойство("Статус", СтатусОперации);
	
	Если СтатусОперации = "Ошибка" Тогда
		ТекстОшибки = "";
		Если Результат.Свойство("ПодробноеПредставлениеОшибки", ТекстОшибки) И ЗначениеЗаполнено(ТекстОшибки) Тогда
			СтатусВыполнения = ТекстОшибки;
		Иначе
			СтатусВыполнения = "Обезличивание завершилось с ошибкой.";
		КонецЕсли;
		ПоказатьПредупреждение(, СтатусВыполнения);
		Возврат;
	КонецЕсли;
	
	Если СтатусОперации = "Отменено" Тогда
		СтатусВыполнения = "Обезличивание отменено пользователем.";
		ПоказатьПредупреждение(, СтатусВыполнения);
		Возврат;
	КонецЕсли;
	
	Итог = Неопределено;
	Попытка
		Итог = ПолучитьИтогОбезличиванияНаСервере(Результат);
	Исключение
		СтатусВыполнения = "Завершение сеанса: итог обезличивания недоступен.";
		Возврат;
	КонецПопытки;
	
	Если Итог = Неопределено Тогда
		СтатусВыполнения = "Не удалось получить итог обезличивания.";
		ПоказатьПредупреждение(, СтатусВыполнения);
		Возврат;
	КонецЕсли;
	
	Успешно = Истина;
	ЧастичныйУспех = Ложь;
	ТекстДиагностики = "";
	Итог.Свойство("Успешно", Успешно);
	Итог.Свойство("ЧастичныйУспех", ЧастичныйУспех);
	Итог.Свойство("ТекстДиагностики", ТекстДиагностики);
	
	Если Не Успешно Тогда
		СтатусВыполнения = "Обезличивание завершено с ошибкой.";
	ИначеЕсли ЧастичныйУспех Тогда
		СтатусВыполнения = "Обезличивание завершено частично.";
	Иначе
		СтатусВыполнения = "Обезличивание успешно завершено.";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстДиагностики) Тогда
		СтатусВыполнения = СтатусВыполнения + " " + ТекстДиагностики;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтатусВыполнения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Выполняет запуск оркестратора обезличивания и возвращает итог.
//
// Возвращаемое значение:
// Структура - результат запуска длительной операции.
//
&НаСервере
Функция ЗапуститьОбезличиваниеНаСервере()
	
	ПараметрыЗапуска = Новый Структура;
	ПараметрыПроцедуры = Новый Структура("ПараметрыXML", ЗначениеВСтрокуВнутр(ПараметрыЗапуска));
		
	Возврат ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		УникальныйИдентификатор,
		"Обработки.Obezl_Запуск.Obezl_ОркестраторОбезличивания",
		ПараметрыПроцедуры,
		"Obezl: обезличивание данных",
		Ложь);
	
КонецФункции

// Описание: Подключает ожидание завершения длительной операции в интерфейсе.
//
// Параметры:
// РезультатЗапуска - Структура - результат ВыполнитьВФоне.
//
&НаКлиенте
Процедура НачатьОжиданиеОбезличивания(РезультатЗапуска)
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторЗаданияЛокальный = Неопределено;
	РезультатЗапуска.Свойство("ИдентификаторЗадания", ИдентификаторЗаданияЛокальный);
	ИдентификаторЗаданияОбезличивания = ?(ИдентификаторЗаданияЛокальный = Неопределено, "", Строка(ИдентификаторЗаданияЛокальный));
	АдресРезультатаОбезличивания = "";
	Если Не РезультатЗапуска.Свойство("АдресРезультата", АдресРезультатаОбезличивания) Тогда
		РезультатЗапуска.Свойство("АдресХранилища", АдресРезультатаОбезличивания);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗаданияОбезличивания) Тогда
		СтатусВыполнения = "Не получен идентификатор фонового задания.";
		ПоказатьПредупреждение(, СтатусВыполнения);
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПроверитьЗавершениеОбезличивания", 1, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеОбезличивания()
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗаданияОбезличивания) Тогда
		ОтключитьОбработчикОжидания("ПроверитьЗавершениеОбезличивания");
		Возврат;
	КонецЕсли;
	
	ЗавершеноОперация = Ложь;
	Попытка
		ЗавершеноОперация = ЗаданиеОбезличиванияЗавершеноНаСервере(ИдентификаторЗаданияОбезличивания);
	Исключение
		ОтключитьОбработчикОжидания("ПроверитьЗавершениеОбезличивания");
		ИдентификаторЗаданияОбезличивания = "";
		АдресРезультатаОбезличивания = "";
		Возврат;
	КонецПопытки;
	
	Если Не ЗавершеноОперация Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПроверитьЗавершениеОбезличивания");
	РезультатДляОбработки = Новый Структура("Статус, АдресРезультата", "Выполнено", АдресРезультатаОбезличивания);
	ОбработатьРезультатОбезличивания(РезультатДляОбработки);
	ИдентификаторЗаданияОбезличивания = "";
	АдресРезультатаОбезличивания = "";
	
КонецПроцедуры

// Описание: Читает итог обезличивания из временного хранилища результата ДО.
//
// Параметры:
// РезультатДО - Структура - результат выполнения ДлительныеОперации.
//
// Возвращаемое значение:
// Структура - итог оркестратора; Неопределено при ошибке.
//
&НаСервере
Функция ПолучитьИтогОбезличиванияНаСервере(Знач РезультатДО)
	
	АдресРезультата = "";
	Если Не РезультатДО.Свойство("АдресРезультата", АдресРезультата) Тогда
		РезультатДО.Свойство("АдресХранилища", АдресРезультата);
	КонецЕсли;
	Если Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Итог = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Описание: Проверяет признак завершения фонового задания.
//
// Параметры:
// ИдентификаторЗадания - УникальныйИдентификатор - идентификатор фонового задания.
//
// Возвращаемое значение:
// Булево - Истина, если задание завершено.
//
&НаСервере
Функция ЗаданиеОбезличиванияЗавершеноНаСервере(Знач ИдентификаторЗадания)
	Попытка
		УИДЗадания = Новый УникальныйИдентификатор(ИдентификаторЗадания);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат ДлительныеОперации.ЗаданиеВыполнено(УИДЗадания);
КонецФункции

#КонецОбласти
