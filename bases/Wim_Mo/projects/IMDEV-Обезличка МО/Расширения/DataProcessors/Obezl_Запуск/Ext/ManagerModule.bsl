#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// Модуль менеджера обработки Obezl_Запуск
//
// Назначение:
//   Оркестрация полного цикла обезличивания данных в копии базы Wim_Mo.
//   Запускается из формы через БСП (длительная операция) как фоновое задание.
//
// Ответственность модуля:
//   - подготовка снимка «до» и карты мандатов (через модуль объекта);
//   - последовательный запуск этапов: Контрагенты, МандатыИСчета, СчетаДЕПО,
//     БрокерскиеСчета, БанковскиеСчета;
//   - разбиение ссылок на пачки (до 8 фоновых заданий, ~1000 элементов на пачку);
//   - ожидание пачек, прогресс, отмена при отмене родительского задания;
//   - агрегация итога и запись в журнал регистрации (событие Obezl).
//
// Точка входа (Экспорт): Obezl_ОркестраторОбезличивания.
////////////////////////////////////////////////////////////////////////////////

// Описание: Выполняет полный сценарий обезличивания: снимок, карта мандатов, этапы в фоне, очистка ВерсииОбъектов.
// Вызывается из формы обработки через подсистему ДлительныеОперации.
//
// Параметры:
//   Параметры - Структура - параметры запуска; допускается пустая структура или поле ПараметрыXML (сериализованная структура).
//   АдресРезультата - Строка - адрес временного хранилища для структуры итога (Успешно, ЧастичныйУспех, ДеталиЭтапов и др.).
//
Процедура Obezl_ОркестраторОбезличивания(Параметры, АдресРезультата) Экспорт
	
	ИдентификаторЗапуска = Строка(Новый УникальныйИдентификатор);
	Итог = Новый Структура;
	Итог.Вставить("Успешно", Истина);
	Итог.Вставить("ЧастичныйУспех", Ложь);
	Итог.Вставить("ТекстДиагностики", "");
	Итог.Вставить("ДеталиЭтапов", Новый Соответствие);
	Итог.Вставить("АдресСнимкаДоОбезличивания", "");

	СтрокаВхода = "";
	Если Параметры <> Неопределено И Параметры.Свойство("ПараметрыXML", СтрокаВхода) И ЗначениеЗаполнено(СтрокаВхода) Тогда
		Попытка
			Параметры = ЗначениеИзСтрокиВнутр(СтрокаВхода);
		Исключение
			Параметры = Новый Структура;
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		Лог(ИдентификаторЗапуска, "Старт", "Запуск обезличивания.");
		ОбработкаОбъект = Обработки.Obezl_Запуск.Создать();
		ТаблицаСнимка = ОбработкаОбъект.СформироватьСнимокДоОбезличивания();
		Итог.АдресСнимкаДоОбезличивания = ПоместитьВоВременноеХранилище(ТаблицаСнимка);
		
		КартаМандатов = ОбработкаОбъект.СформироватьКартуМандатов();
		ВсегоЭтапов = 5;
		НомерЭтапа = 0;
		НомерЭтапа = НомерЭтапа + 1;
		ОбработатьЭтап(ОбработкаОбъект, ИдентификаторЗапуска, Итог, "Контрагенты", Неопределено, НомерЭтапа, ВсегоЭтапов);
		Если Итог.Успешно Тогда
			НомерЭтапа = НомерЭтапа + 1;
			ОбработатьЭтапМандатыИСчета(ОбработкаОбъект, ИдентификаторЗапуска, Итог, КартаМандатов, НомерЭтапа, ВсегоЭтапов);
		КонецЕсли;
		Если Итог.Успешно Тогда
			НомерЭтапа = НомерЭтапа + 1;
			ОбработатьЭтап(ОбработкаОбъект, ИдентификаторЗапуска, Итог, "СчетаДЕПО", Неопределено, НомерЭтапа, ВсегоЭтапов);
		КонецЕсли;
		Если Итог.Успешно Тогда
			НомерЭтапа = НомерЭтапа + 1;
			ОбработатьЭтап(ОбработкаОбъект, ИдентификаторЗапуска, Итог, "БрокерскиеСчета", Неопределено, НомерЭтапа, ВсегоЭтапов);
		КонецЕсли;
		Если Итог.Успешно Тогда
			НомерЭтапа = НомерЭтапа + 1;
			ОбработатьЭтап(ОбработкаОбъект, ИдентификаторЗапуска, Итог, "БанковскиеСчета", Неопределено, НомерЭтапа, ВсегоЭтапов);
		КонецЕсли;
		
		Если Итог.Успешно Тогда
			ОбработкаОбъект.ОчиститьВерсииОбъектов();
			ОбработкаОбъект.ОчиститьСлужебныеДанные();
		КонецЕсли;
		
		Лог(ИдентификаторЗапуска, "Финиш", "Обезличивание завершено.");
		
	Исключение
		Итог.Успешно = Ложь;
		Итог.ТекстДиагностики = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Лог(ИдентификаторЗапуска, "Финиш", Итог.ТекстДиагностики, УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	
	Если ЗначениеЗаполнено(АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(Итог, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры
// Описание: Обрабатывает составной этап «МандатыИСчета»: в одной фоновой пачке сначала мандаты, затем счета с Владелец из этой пачки.
//
// Параметры:
//   ОбработкаОбъект - ОбработкаОбъект.Obezl_Запуск - экземпляр обработки с правилами обезличивания.
//   ИдентификаторЗапуска - Строка - UUID запуска для журнала Obezl.
//   Итог - Структура - накопительный результат оркестратора (изменяется по ссылке).
//   КартаМандатов - Соответствие - карта старых/новых наименований мандатов для передачи в фон.
//   НомерЭтапа - Число - порядковый номер этапа для прогресса (1..ВсегоЭтапов).
//   ВсегоЭтапов - Число - общее число этапов с прогрессом (5).
//
Процедура ОбработатьЭтапМандатыИСчета(ОбработкаОбъект, ИдентификаторЗапуска, Итог, КартаМандатов, НомерЭтапа, ВсегоЭтапов)
	
	ИмяЭтапа = "МандатыИСчета";
	СсылкиМандаты = ОбработкаОбъект.ПолучитьСсылкиДляЭтапа("Мандаты");
	Если СсылкиМандаты.Количество() = 0 Тогда
		Итог.ДеталиЭтапов.Вставить(ИмяЭтапа, 0);
		Возврат;
	КонецЕсли;
	
	МассивПачекМандатов = РазбитьНаПачки(СсылкиМандаты);
	КонтекстыПачек = Новый Массив;
	НомерПачки = 0;
	
	Для Каждого ПачкаМандатов Из МассивПачекМандатов Цикл
		НомерПачки = НомерПачки + 1;
		ПачкаСчетов = ОбработкаОбъект.ПолучитьСсылкиСчетовМандатовПоВладельцам(ПачкаМандатов);
		ПачкаКомплекс = Новый Структура("Мандаты, СчетаМандатов", ПачкаМандатов, ПачкаСчетов);
		КонтекстПачки = ЗапуститьПачкуВФоне(ИдентификаторЗапуска, ИмяЭтапа, НомерПачки, ПачкаКомплекс, КартаМандатов);
		КонтекстыПачек.Добавить(КонтекстПачки);
	КонецЦикла;
	
	Если Не ОжидатьЗавершениеПачекСПрогрессом(КонтекстыПачек, ИмяЭтапа, НомерЭтапа, ВсегоЭтапов) Тогда
		Итог.Успешно = Ложь;
		Итог.ТекстДиагностики = "Выполнение прервано пользователем.";
		Возврат;
	КонецЕсли;
	
	РезультатыПачек = Новый Массив;
	Для Каждого КонтекстПачки Из КонтекстыПачек Цикл
		РезультатПачки = ПолучитьРезультатПачки(КонтекстПачки);
		РезультатыПачек.Добавить(РезультатПачки);
	КонецЦикла;
	
	Обработано = 0;
	Для Каждого РезультатПачки Из РезультатыПачек Цикл
		Если РезультатПачки = Неопределено Тогда
			Итог.ЧастичныйУспех = Истина;
			Продолжить;
		КонецЕсли;
		Обработано = Обработано + РезультатПачки.ОбработаноЭлементов;
		Если РезультатПачки.ЕстьОшибка Тогда
			Итог.ЧастичныйУспех = Истина;
			Лог(ИдентификаторЗапуска, ИмяЭтапа, РезультатПачки.ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
		КонецЕсли;
	КонецЦикла;
	
	Итог.ДеталиЭтапов.Вставить(ИмяЭтапа, Обработано);
	Лог(ИдентификаторЗапуска, ИмяЭтапа, СтрШаблон("Этап завершен. Обработано элементов (мандаты+счета): %1", Обработано));
	
КонецПроцедуры
// Описание: Обрабатывает один этап обезличивания с параллельными фоновыми пачками (массив ссылок одного типа).
//
// Параметры:
//   ОбработкаОбъект - ОбработкаОбъект.Obezl_Запуск - экземпляр обработки.
//   ИдентификаторЗапуска - Строка - UUID запуска для журнала.
//   Итог - Структура - накопительный результат оркестратора.
//   ИмяЭтапа - Строка - код этапа: Контрагенты, СчетаДЕПО, БрокерскиеСчета, БанковскиеСчета.
//   КартаМандатов - Соответствие, Неопределено - карта мандатов (для этапов без мандатов — Неопределено).
//   НомерЭтапа - Число - номер этапа для прогресса.
//   ВсегоЭтапов - Число - всего этапов с прогрессом.
//
Процедура ОбработатьЭтап(ОбработкаОбъект, ИдентификаторЗапуска, Итог, ИмяЭтапа, КартаМандатов, НомерЭтапа, ВсегоЭтапов)
	
	Ссылки = ОбработкаОбъект.ПолучитьСсылкиДляЭтапа(ИмяЭтапа);
	Если Ссылки.Количество() = 0 Тогда
		Итог.ДеталиЭтапов.Вставить(ИмяЭтапа, 0);
		Возврат;
	КонецЕсли;
	
	МассивПачек = РазбитьНаПачки(Ссылки);
	КонтекстыПачек = Новый Массив;
	НомерПачки = 0;
	
	Для Каждого Пачка Из МассивПачек Цикл
		НомерПачки = НомерПачки + 1;
		КонтекстПачки = ЗапуститьПачкуВФоне(ИдентификаторЗапуска, ИмяЭтапа, НомерПачки, Пачка, КартаМандатов);
		КонтекстыПачек.Добавить(КонтекстПачки);
	КонецЦикла;
	Если Не ОжидатьЗавершениеПачекСПрогрессом(КонтекстыПачек, ИмяЭтапа, НомерЭтапа, ВсегоЭтапов) Тогда
		Итог.Успешно = Ложь;
		Итог.ТекстДиагностики = "Выполнение прервано пользователем.";
		Возврат;
	КонецЕсли;
	
	РезультатыПачек = Новый Массив;
	Для Каждого КонтекстПачки Из КонтекстыПачек Цикл
		РезультатПачки = ПолучитьРезультатПачки(КонтекстПачки);
		РезультатыПачек.Добавить(РезультатПачки);
	КонецЦикла;
	
	Обработано = 0;
	Для Каждого РезультатПачки Из РезультатыПачек Цикл
		Если РезультатПачки = Неопределено Тогда
			Итог.ЧастичныйУспех = Истина;
			Продолжить;
		КонецЕсли;
		Обработано = Обработано + РезультатПачки.ОбработаноЭлементов;
		Если РезультатПачки.ЕстьОшибка Тогда
			Итог.ЧастичныйУспех = Истина;
			Лог(ИдентификаторЗапуска, ИмяЭтапа, РезультатПачки.ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
		КонецЕсли;
	КонецЦикла;
	
	Итог.ДеталиЭтапов.Вставить(ИмяЭтапа, Обработано);
	Лог(ИдентификаторЗапуска, ИмяЭтапа, СтрШаблон("Этап завершен. Обработано: %1", Обработано));
	
КонецПроцедуры
// Описание: Запускает фоновое задание обработки одной пачки через ДлительныеОперации (Obezl_ВыполнитьПачку).
//
// Параметры:
//   ИдентификаторЗапуска - Строка - UUID запуска для журнала.
//   ИмяЭтапа - Строка - код этапа или МандатыИСчета.
//   НомерПачки - Число - порядковый номер пачки в этапе.
//   Пачка - Массив, Структура - ссылки этапа или структура {Мандаты, СчетаМандатов}.
//   КартаМандатов - Соответствие, Неопределено - карта для этапа мандатов.
//
// Возвращаемое значение:
//   Структура - контекст пачки: ЕстьОшибка, ТекстОшибки, ОбработаноЭлементов, ИдентификаторЗадания, АдресРезультата.
//
Функция ЗапуститьПачкуВФоне(ИдентификаторЗапуска, ИмяЭтапа, НомерПачки, Пачка, КартаМандатов)
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);
	ПараметрыПачки = Новый Структура;
	ПараметрыПачки.Вставить("ИдентификаторЗапуска", ИдентификаторЗапуска);
	ПараметрыПачки.Вставить("ИмяЭтапа", ИмяЭтапа);
	ПараметрыПачки.Вставить("НомерПачки", НомерПачки);
	ПараметрыПачки.Вставить("Пачка", Пачка);
	ПараметрыПачки.Вставить("АдресРезультатаПачки", АдресРезультата);
	ПараметрыПачки.Вставить("КартаМандатов", КартаМандатов);
	
	ПараметрыВыполненияПроцедуры = Новый Структура;
	ПараметрыВыполненияПроцедуры.Вставить("ПараметрыXML", ЗначениеВСтрокуВнутр(ПараметрыПачки));
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяОбработки", "Obezl_Запуск");
	ПараметрыЗадания.Вставить("ИмяМетода", "Obezl_ВыполнитьПачку");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыВыполненияПроцедуры);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Ложь);
	
	РезультатВыполнения = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		Новый УникальныйИдентификатор,
		"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
		ПараметрыЗадания,
		СтрШаблон("Obezl %1 пачка %2", ИмяЭтапа, НомерПачки),
		Ложь);
	
	ИдентификаторЗадания = Неопределено;
	РезультатВыполнения.Свойство("ИдентификаторЗадания", ИдентификаторЗадания);
	Если ИдентификаторЗадания = Неопределено Тогда
		Возврат Новый Структура("ЕстьОшибка, ТекстОшибки, ОбработаноЭлементов, ИдентификаторЗадания, АдресРезультата",
			Истина,
			"Не удалось запустить фоновое задание пачки.",
			0,
			Неопределено,
			АдресРезультата);
	КонецЕсли;
	
	Возврат Новый Структура("ЕстьОшибка, ТекстОшибки, ОбработаноЭлементов, ИдентификаторЗадания, АдресРезультата",
		Ложь,
		"",
		0,
		ИдентификаторЗадания,
		АдресРезультата);
	
КонецФункции
// Описание: Извлекает результат обработки пачки из временного хранилища по контексту запуска.
//
// Параметры:
//   КонтекстПачки - Структура - контекст, возвращенный ЗапуститьПачкуВФоне.
//
// Возвращаемое значение:
//   Структура, Неопределено - результат пачки (ЕстьОшибка, ТекстОшибки, ОбработаноЭлементов) или Неопределено.
//
Функция ПолучитьРезультатПачки(КонтекстПачки)
	
	Если КонтекстПачки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если КонтекстПачки.ЕстьОшибка Тогда
		Возврат Новый Структура("ЕстьОшибка, ТекстОшибки, ОбработаноЭлементов",
			Истина,
			КонтекстПачки.ТекстОшибки,
			0);
	КонецЕсли;
	
	Возврат ПолучитьИзВременногоХранилища(КонтекстПачки.АдресРезультата);
	
КонецФункции
// Описание: Ожидает завершения всех фоновых пачек этапа; сообщает прогресс; при отмене родительского задания отменяет пачки.
//
// Параметры:
//   КонтекстыПачек - Массив - массив контекстов пачек.
//   ИмяЭтапа - Строка - имя этапа для текста прогресса.
//   НомерЭтапа - Число - номер текущего этапа.
//   ВсегоЭтапов - Число - всего этапов.
//
// Возвращаемое значение:
//   Булево - Ложь, если выполнение прервано пользователем (отмена родительского задания).
//
Функция ОжидатьЗавершениеПачекСПрогрессом(КонтекстыПачек, ИмяЭтапа, НомерЭтапа, ВсегоЭтапов)
	
	ВсегоПачек = КонтекстыПачек.Количество();
	Если ВсегоПачек = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Пока Истина Цикл
		РодительскоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
		Если РодительскоеЗадание <> Неопределено
			И РодительскоеЗадание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
			ОтменитьАктивныеПачки(КонтекстыПачек);
			Возврат Ложь;
		КонецЕсли;
		
		ЗавершеноПачек = 0;
		Для Каждого КонтекстПачки Из КонтекстыПачек Цикл
			Если КонтекстПачки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если КонтекстПачки.ЕстьОшибка Или Не ЗначениеЗаполнено(КонтекстПачки.ИдентификаторЗадания) Тогда
				ЗавершеноПачек = ЗавершеноПачек + 1;
				Продолжить;
			КонецЕсли;
			Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(КонтекстПачки.ИдентификаторЗадания);
			Если Задание = Неопределено Или Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
				ЗавершеноПачек = ЗавершеноПачек + 1;
			Иначе
				Попытка
					Задание.ОжидатьЗавершенияВыполнения(0.2);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		ДоляЭтапа = ЗавершеноПачек / ВсегоПачек;
		Процент = Окр((НомерЭтапа - 1 + ДоляЭтапа) * 100 / ВсегоЭтапов, 0);
		ТекстПрогресса = СтрШаблон("Этап %1/%2: %3. Пачек завершено: %4 из %5",
			НомерЭтапа, ВсегоЭтапов, ИмяЭтапа, ЗавершеноПачек, ВсегоПачек);
		ДлительныеОперации.СообщитьПрогресс(Процент, ТекстПрогресса);
		
		Если ЗавершеноПачек = ВсегоПачек Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
// Описание: Отменяет активные фоновые задания пачек при отмене родительского задания оркестратора.
//
// Параметры:
//   КонтекстыПачек - Массив - массив контекстов пачек с полем ИдентификаторЗадания.
//
Процедура ОтменитьАктивныеПачки(КонтекстыПачек)
	Для Каждого КонтекстПачки Из КонтекстыПачек Цикл
		Если КонтекстПачки = Неопределено Или Не ЗначениеЗаполнено(КонтекстПачки.ИдентификаторЗадания) Тогда
			Продолжить;
		КонецЕсли;
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(КонтекстПачки.ИдентификаторЗадания);
		Если Задание = Неопределено Или Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Задание.Отменить();
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры
// Описание: Делит массив ссылок на пачки для параллельного фонового выполнения (не более 8 пачек, ориентир ~1000 ссылок на пачку).
//
// Параметры:
//   МассивСсылок - Массив - ссылки элементов одного этапа.
//
// Возвращаемое значение:
//   Массив - массив массивов (пачек ссылок).
//
Функция РазбитьНаПачки(МассивСсылок)
	
	МаксПотоков = 8;
	РазмерПачки = 1000;
	Результат = Новый Массив;
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЧислоПачекПоРазмеру = Цел(МассивСсылок.Количество() / РазмерПачки);
	Если (МассивСсылок.Количество() % РазмерПачки) > 0 Тогда
		ЧислоПачекПоРазмеру = ЧислоПачекПоРазмеру + 1;
	КонецЕсли;
	
	ЧислоПачек = Макс(1, Мин(МаксПотоков, ЧислоПачекПоРазмеру));
	БазовыйРазмер = Цел(МассивСсылок.Количество() / ЧислоПачек);
	Остаток = МассивСсылок.Количество() % ЧислоПачек;
	
	Индекс = 0;
	Для НомерПачки = 1 По ЧислоПачек Цикл
		ТекущийРазмер = БазовыйРазмер + ?(НомерПачки <= Остаток, 1, 0);
		Пачка = Новый Массив;
		Для Счетчик = 1 По ТекущийРазмер Цикл
			Пачка.Добавить(МассивСсылок[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		Результат.Добавить(Пачка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
// Описание: Записывает сообщение в журнал регистрации с событием Obezl.
//
// Параметры:
//   ИдентификаторЗапуска - Строка - UUID запуска обезличивания.
//   Этап - Строка - код этапа или Старт/Финиш.
//   Сообщение - Строка - текст записи.
//   Уровень - УровеньЖурналаРегистрации - уровень; по умолчанию Информация.
//
Процедура Лог(ИдентификаторЗапуска, Этап, Сообщение, Уровень = Неопределено)
	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	ЗаписьЖурналаРегистрации("Obezl", Уровень, , , СтрШаблон("[%1][%2] %3", ИдентификаторЗапуска, Этап, Сообщение));
КонецПроцедуры

#КонецЕсли
