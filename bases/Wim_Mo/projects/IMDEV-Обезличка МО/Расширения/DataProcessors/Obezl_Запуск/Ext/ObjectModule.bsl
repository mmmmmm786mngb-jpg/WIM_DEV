#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем КартаМандатов;

// Описание: Возвращает ссылки элементов для указанного этапа обезличивания.
Функция ПолучитьСсылкиДляЭтапа(Знач ИмяЭтапа) Экспорт
	
	Результат = Новый Массив;
	Запрос = Новый Запрос;
	
	Если ИмяЭтапа = "Контрагенты" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Клиент
		|	И Не Контрагенты.Предопределенный";
	ИначеЕсли ИмяЭтапа = "Мандаты" Тогда
		Запрос.Текст = "ВЫБРАТЬ Мандаты.Ссылка КАК Ссылка ИЗ Справочник.Мандаты КАК Мандаты ГДЕ Не Мандаты.Предопределенный";
	ИначеЕсли ИмяЭтапа = "СчетаМандатов" Тогда
		Запрос.Текст = "ВЫБРАТЬ СчетаМандатов.Ссылка КАК Ссылка ИЗ Справочник.СчетаМандатов КАК СчетаМандатов ГДЕ Не СчетаМандатов.Предопределенный";
	ИначеЕсли ИмяЭтапа = "СчетаДЕПО" Тогда
		Запрос.Текст = "ВЫБРАТЬ СчетаДЕПО.Ссылка КАК Ссылка ИЗ Справочник.СчетаДЕПО КАК СчетаДЕПО ГДЕ Не СчетаДЕПО.Предопределенный";
	ИначеЕсли ИмяЭтапа = "БрокерскиеСчета" Тогда
		Запрос.Текст = "ВЫБРАТЬ БрокерскиеСчета.Ссылка КАК Ссылка ИЗ Справочник.БрокерскиеСчета КАК БрокерскиеСчета ГДЕ Не БрокерскиеСчета.Предопределенный";
	ИначеЕсли ИмяЭтапа = "БанковскиеСчета" Тогда
		Запрос.Текст = "ВЫБРАТЬ БанковскиеСчета.Ссылка КАК Ссылка ИЗ Справочник.БанковскиеСчета КАК БанковскиеСчета ГДЕ Не БанковскиеСчета.Предопределенный";
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Возвращает ссылки счетов мандатов, у которых владелец входит в переданный список мандатов (та же пачка, что и мандаты).
//
// Параметры:
// МассивМандатов - Массив - ссылки Справочник.Мандаты.
//
// Возвращаемое значение:
// Массив - ссылки Справочник.СчетаМандатов.
//
Функция ПолучитьСсылкиСчетовМандатовПоВладельцам(Знач МассивМандатов) Экспорт
	
	Результат = Новый Массив;
	Если МассивМандатов = Неопределено Или МассивМандатов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетаМандатов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СчетаМандатов КАК СчетаМандатов
	|ГДЕ
	|	Не СчетаМандатов.Предопределенный
	|	И СчетаМандатов.Владелец В (&Владельцы)";
	Запрос.УстановитьПараметр("Владельцы", МассивМандатов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Стабильный ключ карты мандатов для поиска после сериализации (ЗначениеВСтрокуВнутр) и из объекта счета.
// Строка(Ссылка) в разных контекстах может различаться; GUID совпадает для одной и той же ссылки.
//
Функция КлючМандатаВКарте(Знач СсылкаНаМандат)
	
	Если Не ЗначениеЗаполнено(СсылкаНаМандат) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(СсылкаНаМандат.УникальныйИдентификатор());
	
КонецФункции

// Описание: Строит карту соответствия наименований мандатов в памяти.
Функция СформироватьКартуМандатов() Экспорт
	
	Карта = Новый Соответствие;
	Ссылки = ПолучитьСсылкиДляЭтапа("Мандаты");
	Счетчик = 0;
	Для Каждого СсылкаМандата Из Ссылки Цикл
		Счетчик = Счетчик + 1;
		Объект = СсылкаМандата.ПолучитьОбъект();
		СтароеНаименование = Объект.Наименование;
		НовоеНаименование = СтрШаблон("Мандат %1", Формат(Счетчик, "ЧЦ=5; ЧГ=0"));
		Карта.Вставить(КлючМандатаВКарте(СсылкаМандата), Новый Структура("СтароеНаименование, НовоеНаименование", СтароеНаименование, НовоеНаименование));
	КонецЦикла;
	КартаМандатов = Карта;
	
	Возврат Карта;
	
КонецФункции

// Описание: Формирует снимок исходных данных перед обезличиванием в таблицу значений.
//
// Возвращаемое значение:
// ТаблицаЗначений - снимок значений полей до изменения.
//
Функция СформироватьСнимокДоОбезличивания() Экспорт
	
	Снимок = Новый ТаблицаЗначений;
	Снимок.Колонки.Добавить("Объект");
	Снимок.Колонки.Добавить("Ссылка");
	Снимок.Колонки.Добавить("Поле");
	Снимок.Колонки.Добавить("ЗначениеДо");
	
	ДобавитьСнимокПоЭтапу(Снимок, "Контрагенты");
	ДобавитьСнимокПоЭтапу(Снимок, "Мандаты");
	ДобавитьСнимокПоЭтапу(Снимок, "СчетаМандатов");
	ДобавитьСнимокПоЭтапу(Снимок, "СчетаДЕПО");
	ДобавитьСнимокПоЭтапу(Снимок, "БрокерскиеСчета");
	ДобавитьСнимокПоЭтапу(Снимок, "БанковскиеСчета");
	
	Возврат Снимок;
	
КонецФункции

Процедура ДобавитьСнимокПоЭтапу(Снимок, ИмяЭтапа)
	
	Ссылки = ПолучитьСсылкиДляЭтапа(ИмяЭтапа);
	Для Каждого СсылкаОбъекта Из Ссылки Цикл
		Объект = СсылкаОбъекта.ПолучитьОбъект();
		Если ИмяЭтапа = "Контрагенты" Тогда
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "ИНН", БезопасноПолучитьСвойство(Объект, "ИНН"));
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "ОГРН", БезопасноПолучитьСвойство(Объект, "ОГРН"));
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "КПП", БезопасноПолучитьСвойство(Объект, "КПП"));
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "TIN", БезопасноПолучитьСвойство(Объект, "TIN"));
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "ОКПО", БезопасноПолучитьСвойство(Объект, "ОКПО"));
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "ОКАТО", БезопасноПолучитьСвойство(Объект, "ОКАТО"));
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "Наименование", БезопасноПолучитьСвойство(Объект, "Наименование"));
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "НаименованиеПолное", БезопасноПолучитьСвойство(Объект, "НаименованиеПолное"));
		ИначеЕсли ИмяЭтапа = "Мандаты" Тогда
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "Наименование", БезопасноПолучитьСвойство(Объект, "Наименование"));
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "НаименованиеПолное", БезопасноПолучитьСвойство(Объект, "НаименованиеПолное"));
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "ПолноеНаименование", БезопасноПолучитьСвойство(Объект, "ПолноеНаименование"));
		ИначеЕсли ИмяЭтапа = "СчетаМандатов" Тогда
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "Наименование", БезопасноПолучитьСвойство(Объект, "Наименование"));
		ИначеЕсли ИмяЭтапа = "СчетаДЕПО" Тогда
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "Наименование", БезопасноПолучитьСвойство(Объект, "Наименование"));
		ИначеЕсли ИмяЭтапа = "БрокерскиеСчета" Тогда
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "НомерБанковскогоСчета", БезопасноПолучитьСвойство(Объект, "НомерБанковскогоСчета"));
		ИначеЕсли ИмяЭтапа = "БанковскиеСчета" Тогда
			ДобавитьСтрокуСнимка(Снимок, ИмяЭтапа, СсылкаОбъекта, "НомерСчета", БезопасноПолучитьСвойство(Объект, "НомерСчета"));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокуСнимка(Снимок, Объект, СсылкаОбъекта, Поле, ЗначениеДо)
	СтрокаТаблицы = Снимок.Добавить();
	СтрокаТаблицы.Объект = Объект;
	СтрокаТаблицы.Ссылка = Строка(СсылкаОбъекта);
	СтрокаТаблицы.Поле = Поле;
	СтрокаТаблицы.ЗначениеДо = Строка(ЗначениеДо);
КонецПроцедуры

Функция БезопасноПолучитьСвойство(Объект, ИмяСвойства)
	Попытка
		Возврат Вычислить("Объект." + ИмяСвойства);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Описание: Выполняет обработку одной пачки ссылок в фоне.
Процедура Obezl_ВыполнитьПачку(ПараметрыВыполнения, АдресХранилищаРезультата) Экспорт
	
	РезультатПачки = Новый Структура("ЕстьОшибка, ТекстОшибки, ОбработаноЭлементов", Ложь, "", 0);
	
	Попытка
		СтрокаПараметров = "";
		Если Не ПараметрыВыполнения.Свойство("ПараметрыXML", СтрокаПараметров) Тогда
			ВызватьИсключение "Не переданы параметры пачки.";
		КонецЕсли;
		
		ПараметрыПачки = ЗначениеИзСтрокиВнутр(СтрокаПараметров);
		ИмяЭтапа = ПараметрыПачки.ИмяЭтапа;
		Пачка = ПараметрыПачки.Пачка;
		АдресРезультатаПачки = ПараметрыПачки.АдресРезультатаПачки;
		КартаЛокальная = Неопределено;
		Если ПараметрыПачки.Свойство("КартаМандатов", КартаЛокальная) Тогда
			КартаМандатов = КартаЛокальная;
		КонецЕсли;
		
		РезультатПачки = ОбработатьПачку(ИмяЭтапа, Пачка);
		ПоместитьВоВременноеХранилище(РезультатПачки, АдресРезультатаПачки);
	Исключение
		РезультатПачки.ЕстьОшибка = Истина;
		РезультатПачки.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если ЗначениеЗаполнено(АдресХранилищаРезультата) Тогда
		ПоместитьВоВременноеХранилище(Не РезультатПачки.ЕстьОшибка, АдресХранилищаРезультата);
	КонецЕсли;
	
КонецПроцедуры

Функция ОбработатьПачку(Знач ИмяЭтапа, Знач Пачка) Экспорт
	
	Результат = Новый Структура("ЕстьОшибка, ТекстОшибки, ОбработаноЭлементов", Ложь, "", 0);
	
	Попытка
		Если ИмяЭтапа = "МандатыИСчета" Тогда
			ПачкаМандатов = Пачка.Мандаты;
			ПачкаСчетов = Пачка.СчетаМандатов;
			Для Каждого Ссылка Из ПачкаМандатов Цикл
				ОбезличитьМандат(Ссылка);
				Результат.ОбработаноЭлементов = Результат.ОбработаноЭлементов + 1;
			КонецЦикла;
			Для Каждого Ссылка Из ПачкаСчетов Цикл
				ОбезличитьСчетМандата(Ссылка);
				Результат.ОбработаноЭлементов = Результат.ОбработаноЭлементов + 1;
			КонецЦикла;
		Иначе
		Для Каждого Ссылка Из Пачка Цикл
			Если ИмяЭтапа = "Контрагенты" Тогда
				ОбезличитьКонтрагента(Ссылка);
			ИначеЕсли ИмяЭтапа = "Мандаты" Тогда
				ОбезличитьМандат(Ссылка);
			ИначеЕсли ИмяЭтапа = "СчетаМандатов" Тогда
				ОбезличитьСчетМандата(Ссылка);
			ИначеЕсли ИмяЭтапа = "СчетаДЕПО" Тогда
				ОбезличитьСчетДЕПО(Ссылка);
			ИначеЕсли ИмяЭтапа = "БрокерскиеСчета" Тогда
				ОбезличитьБрокерскийСчет(Ссылка);
			ИначеЕсли ИмяЭтапа = "БанковскиеСчета" Тогда
				ОбезличитьБанковскийСчет(Ссылка);
			КонецЕсли;
			Результат.ОбработаноЭлементов = Результат.ОбработаноЭлементов + 1;
		КонецЦикла;
		КонецЕсли;
	Исключение
		Результат.ЕстьОшибка = Истина;
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ОчиститьВерсииОбъектов() Экспорт
	Набор = РегистрыСведений.ВерсииОбъектов.СоздатьНаборЗаписей();
	Набор.Прочитать();
	Набор.Очистить();
	Набор.Записать();
КонецПроцедуры

// Описание: Очищает служебные данные в памяти после завершения обработки.
Процедура ОчиститьСлужебныеДанные() Экспорт
	КартаМандатов = Неопределено;
КонецПроцедуры

// Описание: Возвращает строку карты мандатов по ключу (без СодержитКлюч — совместимость с десериализацией во фоне).
//
// Параметры:
// Ключ - Строка - ключ вида Строка(УникальныйИдентификатор() ссылки на мандат).
//
// Возвращаемое значение:
// Структура, Неопределено - данные замены или отсутствие ключа.
//
Функция ДанныеМандатаПоКлючу(Знач Ключ)
	
	Если КартаМандатов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Результат = КартаМандатов.Получить(Ключ);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Описание: Строка UUID ссылки без дефисов для уникальных псевдонимов (32 шестнадцатеричных символа).
//
// Параметры:
// Ссылка - ЛюбаяСсылка - ссылка на объект.
//
// Возвращаемое значение:
// Строка - 32 символа или пустая строка при пустой ссылке.
//
Функция УникальныйИдентификаторСсылкиБезДефисов(Знач Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрЗаменить(Строка(Ссылка.УникальныйИдентификатор()), "-", "");
	
КонецФункции

Функция МаскаЦифр(Знач Текст)
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	ИсходнаяСтрока = Строка(Текст);
	Результат = "";
	Для Индекс = 1 По СтрДлина(ИсходнаяСтрока) Цикл
		Символ = Сред(ИсходнаяСтрока, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Результат = Результат + "0";
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Описание: Проверяет, что строка непустая и состоит только из цифр (коды, ИНН-подобные значения в КИ).
//
// Параметры:
// Текст - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
// Булево - Истина, если только цифры.
//
Функция СтрокаСодержитТолькоЦифры(Знач Текст)
	
	С = СокрЛП(Строка(Текст));
	Если С = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(С) Цикл
		Символ = Сред(С, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Описание: Строковый литерал для подстановки во Выполнить() (экранирование кавычек и переводов строк).
//
// Параметры:
// Текст - Строка - исходный текст.
//
// Возвращаемое значение:
// Строка - фрагмент кода 1С: "...escaped...".
//
Функция СтрокаЛитералДляВыполнить(Знач Текст)
	
	Заменено = СтрЗаменить(Строка(Текст), Символ(13), " ");
	Заменено = СтрЗаменить(Заменено, Символ(10), " ");
	Возврат """" + СтрЗаменить(Заменено, """", """""") + """";
	
КонецФункции

// Описание: Читает реквизит строки табличной части КонтактнаяИнформация по имени.
//
Функция ЗначениеРеквизитаСтрокиКонтактнойИнформации(СтрокаКонтакта, ИмяРеквизита)
	
	Попытка
		Возврат Вычислить("СтрокаКонтакта." + ИмяРеквизита);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Описание: Записывает значение в реквизит строки ТЧ КонтактнаяИнформация (динамическое имя поля).
//
Процедура ПрисвоитьРеквизитСтрокиКонтактнойИнформацииСтрока(СтрокаКонтакта, ИмяРеквизита, ЗначениеСтрока)
	
	Попытка
		Выполнить("СтрокаКонтакта." + ИмяРеквизита + " = " + СтрокаЛитералДляВыполнить(ЗначениеСтрока));
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Описание: Записывает число в реквизит строки ТЧ КонтактнаяИнформация.
//
Процедура ПрисвоитьРеквизитСтрокиКонтактнойИнформацииЧисло(СтрокаКонтакта, ИмяРеквизита, ЗначениеЧисло)
	
	Попытка
		Выполнить("СтрокаКонтакта." + ИмяРеквизита + " = " + Формат(ЗначениеЧисло, "ЧРГ=; ЧН=0; ЧГ=0"));
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Описание: Формирует новое строковое значение для реквизита КИ.
// Методика: известные поля (телефон, e-mail, география, домен) — шаблоны; ЗначенияПолей — очистка; коды из цифр — МаскаЦифр; прочий текст — константа "Обезличено".
//
// Параметры:
// ИмяПоля - Строка - имя реквизита метаданных.
// СтароеЗначение - Строка - исходное значение.
// ИндексСтроки - Число - порядковый номер строки ТЧ в обработке элемента.
// ТокенУникальности - Строка - UUID ссылки владельца без дефисов (уникальность между разными контрагентами).
//
// Возвращаемое значение:
// Строка - обезличенное значение.
//
Функция НовоеСтроковоеЗначениеКонтактнойИнформации(ИмяПоля, СтароеЗначение, ИндексСтроки, ТокенУникальности)
	
	Номер = Формат(ИндексСтроки, "ЧЦ=5; ЧГ=0");
	Токен = ?(ЗначениеЗаполнено(ТокенУникальности), ТокенУникальности, "00000000000000000000000000000000");
	
	Если ИмяПоля = "АдресЭП" Тогда
		Возврат СтрШаблон("user_%1_%2@example.invalid", Токен, Номер);
	ИначеЕсли ИмяПоля = "НомерТелефона" Тогда
		Возврат СтрШаблон("+7999%1%2", Лев(Токен, 8), Номер);
	ИначеЕсли ИмяПоля = "НомерТелефонаБезКодов" Тогда
		Возврат МаскаЦифр(СтароеЗначение);
	ИначеЕсли ИмяПоля = "Страна" Или ИмяПоля = "Регион" Или ИмяПоля = "Город" Тогда
		Возврат "Обезличено";
	ИначеЕсли ИмяПоля = "ДоменноеИмяСервера" Тогда
		Возврат "example.invalid";
	ИначеЕсли ИмяПоля = "ЗначенияПолей" Тогда
		Возврат "";
	ИначеЕсли ИмяПоля = "Представление" Тогда
		Возврат "Обезличено";
	ИначеЕсли СтрокаСодержитТолькоЦифры(СтароеЗначение) Тогда
		Возврат МаскаЦифр(СтароеЗначение);
	Иначе
		Возврат "Обезличено";
	КонецЕсли;
	
КонецФункции

// Описание: Обезличивает все примитивные реквизиты (Строка, Число) в табличной части КонтактнаяИнформация по метаданным. Ссылки и перечисления не трогаются.
//
// Параметры:
// Объект - СправочникОбъект.Контрагенты - объект контрагента.
//
Процедура ОбезличитьКонтактнуюИнформациюПоМетаданным(Объект)
	
	МетаданныеТЧ = Объект.Метаданные().ТабличныеЧасти.КонтактнаяИнформация;
	ИндексКонтакта = 0;
	ТокенУникальности = УникальныйИдентификаторСсылкиБезДефисов(Объект.Ссылка);
	
	Для Каждого СтрокаКонтакта Из Объект.КонтактнаяИнформация Цикл
		
		ИндексКонтакта = ИндексКонтакта + 1;
		
		Для Каждого Реквизит Из МетаданныеТЧ.Реквизиты Цикл
			
			ИмяРеквизита = Реквизит.Имя;
			ТекЗнач = ЗначениеРеквизитаСтрокиКонтактнойИнформации(СтрокаКонтакта, ИмяРеквизита);
			Если ТекЗнач = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТипЗначения = ТипЗнч(ТекЗнач);
			
			Если ТипЗначения = Тип("Строка") Тогда
				Если Не ЗначениеЗаполнено(ТекЗнач) Тогда
					Продолжить;
				КонецЕсли;
				НовоеСтр = НовоеСтроковоеЗначениеКонтактнойИнформации(ИмяРеквизита, ТекЗнач, ИндексКонтакта, ТокенУникальности);
				ПрисвоитьРеквизитСтрокиКонтактнойИнформацииСтрока(СтрокаКонтакта, ИмяРеквизита, НовоеСтр);
			ИначеЕсли ТипЗначения = Тип("Число") Тогда
				ПрисвоитьРеквизитСтрокиКонтактнойИнформацииЧисло(СтрокаКонтакта, ИмяРеквизита, 0);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбезличитьКонтрагента(СсылкаКонтрагента)
	Объект = СсылкаКонтрагента.ПолучитьОбъект();
	Если Не Объект.Клиент Тогда
		Возврат;
	КонецЕсли;
	Суффикс = УникальныйИдентификаторСсылкиБезДефисов(Объект.Ссылка);
	Попытка Объект.ИНН = МаскаЦифр(Объект.ИНН); Исключение КонецПопытки;
	Попытка Объект.ОГРН = МаскаЦифр(Объект.ОГРН); Исключение КонецПопытки;
	Попытка Объект.КПП = МаскаЦифр(Объект.КПП); Исключение КонецПопытки;
	Попытка Объект.TIN = МаскаЦифр(Объект.TIN); Исключение КонецПопытки;
	Попытка Объект.ОКПО = МаскаЦифр(Объект.ОКПО); Исключение КонецПопытки;
	// Код по ОКАТО в конфигурации: реквизит ОКАТО (см. метаданные Справочник.Контрагенты).
	Попытка Объект.ОКАТО = МаскаЦифр(Объект.ОКАТО); Исключение КонецПопытки;
	НовоеНаименование = СтрШаблон("Контрагент %1", Суффикс);
	Попытка Объект.Наименование = НовоеНаименование; Исключение КонецПопытки;
	Попытка Объект.НаименованиеПолное = НовоеНаименование; Исключение КонецПопытки;
	Попытка Объект.НаименованиеКраткое = НовоеНаименование; Исключение КонецПопытки;
	Попытка Объект.НаименованиеПолноеАнгл = СтрШаблон("Counterparty %1", Суффикс); Исключение КонецПопытки;
	Попытка Объект.НаименованиеКраткоеАнгл = СтрШаблон("Counterparty %1", Суффикс); Исключение КонецПопытки;
	ОбезличитьКонтактнуюИнформациюПоМетаданным(Объект);
	Для Каждого СтрокаДопРеквизита Из Объект.ДополнительныеРеквизиты Цикл
		Попытка
			Если ТипЗнч(СтрокаДопРеквизита.Значение) = Тип("Строка") Тогда
				СтрокаДопРеквизита.Значение = "Значение обезличено";
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка СтрокаДопРеквизита.ТекстоваяСтрока = "Значение обезличено"; Исключение КонецПопытки;
	КонецЦикла;
	Объект.Записать();
КонецПроцедуры

Процедура ОбезличитьМандат(СсылкаМандата)
	Объект = СсылкаМандата.ПолучитьОбъект();
	Ключ = КлючМандатаВКарте(СсылкаМандата);
	ДанныеМандата = ДанныеМандатаПоКлючу(Ключ);
	Если ДанныеМандата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.Наименование = ДанныеМандата.НовоеНаименование;
	Попытка Объект.НаименованиеПолное = ДанныеМандата.НовоеНаименование; Исключение КонецПопытки;
	Попытка Объект.ПолноеНаименование = ДанныеМандата.НовоеНаименование; Исключение КонецПопытки;
	Объект.Записать();
КонецПроцедуры

// Описание: Обезличивает наименование счета мандата по карте кратких имен мандатов; при отсутствии замены по паре
// подставляет «Обезличено» вместо текста в первой паре круглых скобок (), если скобки в строке есть (как у СчетаДЕПО).
//
// Параметры:
// СсылкаСчета - СправочникСсылка.СчетаМандатов - обрабатываемый элемент.
//
Процедура ОбезличитьСчетМандата(СсылкаСчета)
	
	Объект = СсылкаСчета.ПолучитьОбъект();
	Мандат = Неопределено;
	Попытка Мандат = Объект.Владелец; Исключение КонецПопытки;
	Если Не ЗначениеЗаполнено(Мандат) Тогда
		Попытка Мандат = Объект.Мандат; Исключение КонецПопытки;
	КонецЕсли;
	
	ИзменилиНаименование = Ложь;
	
	Если ЗначениеЗаполнено(Мандат) Тогда
		Ключ = КлючМандатаВКарте(Мандат);
		ДанныеМандата = ДанныеМандатаПоКлючу(Ключ);
		Если ДанныеМандата <> Неопределено Тогда
			Старое = ДанныеМандата.СтароеНаименование;
			Новое = ДанныеМандата.НовоеНаименование;
			// Только обычное (краткое) наименование мандата — см. ТЗ.
			Если ЗначениеЗаполнено(Старое) И СтрНайти(Объект.Наименование, Старое) > 0 Тогда
				Объект.Наименование = СтрЗаменить(Объект.Наименование, Старое, Новое);
				ИзменилиНаименование = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ИзменилиНаименование Тогда
		Текст = Объект.Наименование;
		Поз1 = СтрНайти(Текст, "(");
		Поз2 = СтрНайти(Текст, ")");
		Если Поз1 > 0 И Поз2 > Поз1 Тогда
			УникФрагмент = УникальныйИдентификаторСсылкиБезДефисов(СсылкаСчета);
			Объект.Наименование = Лев(Текст, Поз1) + "Обезличено_" + УникФрагмент + Сред(Текст, Поз2);
			ИзменилиНаименование = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ИзменилиНаименование Тогда
		Объект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбезличитьСчетДЕПО(СсылкаСчета)
	Объект = СсылкаСчета.ПолучитьОбъект();
	Текст = Объект.Наименование;
	Поз1 = СтрНайти(Текст, "(");
	Поз2 = СтрНайти(Текст, ")");
	Если Поз1 > 0 И Поз2 > Поз1 Тогда
		УникФрагмент = УникальныйИдентификаторСсылкиБезДефисов(СсылкаСчета);
		Объект.Наименование = Лев(Текст, Поз1) + "Обезличено_" + УникФрагмент + Сред(Текст, Поз2);
		Объект.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура ОбезличитьБрокерскийСчет(СсылкаСчета)
	Объект = СсылкаСчета.ПолучитьОбъект();
