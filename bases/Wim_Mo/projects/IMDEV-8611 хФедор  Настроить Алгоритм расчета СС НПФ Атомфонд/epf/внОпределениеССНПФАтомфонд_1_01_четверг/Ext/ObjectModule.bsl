Функция КотировкаПоВыбПолю(СтруктураНастроек, СтрокаСпискаЦБ, КонецПериода, ТаблицаКотировокПоАктиву, ЗаполненнаяСтрокаКотировок)
	
	СтрокаТаблицаКотировокПоАктиву	= ТаблицаКотировокПоАктиву.Найти(НачалоДня(КонецПериода), "Период");
	
	Если СтрокаТаблицаКотировокПоАктиву = Неопределено Тогда
		Возврат ЗаполненнаяСтрокаКотировок;
	КонецЕсли;
	
	ЦенаСпроса = СтрокаТаблицаКотировокПоАктиву[СтруктураНастроек.ИмяКолонкиBID];
	СредневзвешеннаяЦена = СтрокаТаблицаКотировокПоАктиву["СредневзвешеннаяЦена"];
	
	МинимальнаяЦена = СтрокаТаблицаКотировокПоАктиву["МинимальнаяЦена"];
	МаксимальнаяЦена = СтрокаТаблицаКотировокПоАктиву["МаксимальнаяЦена"];
	ЦенаOffer = СтрокаТаблицаКотировокПоАктиву["OFFER"];
	ЦенаClose = СтрокаТаблицаКотировокПоАктиву["Close"];
	//Сообщить(""  + СтрокаСпискаЦБ.Объект+ ", ЦенаСпроса " + ЦенаСпроса + ", МинимальнаяЦена " + МинимальнаяЦена + ", МаксимальнаяЦена " + МаксимальнаяЦена + ", ЦенаOffer " + ЦенаOffer + ", СредневзвешеннаяЦена " + СредневзвешеннаяЦена);
	
	Если ЦенаСпроса > 0 И МинимальнаяЦена <= ЦенаСпроса И ЦенаСпроса <= МаксимальнаяЦена Тогда
		ОпределяемаяКотировка = ЦенаСпроса;
		ВыбПоле = "ЦенаСпроса";
	ИначеЕсли 
		// IMAPPS-11205 -->
		СредневзвешеннаяЦена = 0 и МинимальнаяЦена = 0 и МаксимальнаяЦена = 0 Тогда
		Возврат ЗаполненнаяСтрокаКотировок;
	ИначеЕсли ЦенаСпроса <= СредневзвешеннаяЦена И СредневзвешеннаяЦена <= ЦенаOffer Тогда
		ОпределяемаяКотировка = СредневзвешеннаяЦена;
		ВыбПоле = "СредневзвешеннаяЦена";	
	ИначеЕсли  СредневзвешеннаяЦена <= ЦенаСпроса и ЦенаСпроса  <= ЦенаOffer Тогда
		ОпределяемаяКотировка = ЦенаСпроса;
		ВыбПоле = "ЦенаСпроса";
	ИначеЕсли  ЦенаСпроса  <= ЦенаOffer  и ЦенаOffer <= СредневзвешеннаяЦена Тогда 
		ОпределяемаяКотировка = ЦенаClose;
		ВыбПоле = "ЦенаЗакрытия";	
		//СредневзвешеннаяЦена > 0 Тогда
		//ОпределяемаяКотировка = СредневзвешеннаяЦена;
		//ВыбПоле = "СредневзвешеннаяЦена";
		// IMAPPS-11205 <--		
	Иначе
		Возврат ЗаполненнаяСтрокаКотировок;
	КонецЕсли;
		//Сообщить("" + ОпределяемаяКотировка);
		
	ЗаполнитьЗначенияСвойств(ЗаполненнаяСтрокаКотировок, СтрокаТаблицаКотировокПоАктиву);
	ЗаполненнаяСтрокаКотировок.НаименованиеКотировки = ВыбПоле;
	ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка = ОпределяемаяКотировка;
	ЗаполненнаяСтрокаКотировок.ДатаОпределения 		 = КонецПериода;
	
	СправкаРасчетОбластьСтрока.Параметры.Графа 	= ВыбПоле;
	СправкаРасчетОбластьСтрока.Параметры.Котировка			= ОпределяемаяКотировка;
	СправкаРасчетОбластьСтрока.Параметры.ДатаОпределения	= КонецПериода;
	СправкаРасчетОбластьСтрока.Параметры.BID 		= ЦенаСпроса;
	СправкаРасчетОбластьСтрока.Параметры.Min 		= МинимальнаяЦена;
	СправкаРасчетОбластьСтрока.Параметры.Max 		= МаксимальнаяЦена;
	СправкаРасчетОбластьСтрока.Параметры.WAP  		= СредневзвешеннаяЦена;
			
	Возврат ЗаполненнаяСтрокаКотировок;
	
