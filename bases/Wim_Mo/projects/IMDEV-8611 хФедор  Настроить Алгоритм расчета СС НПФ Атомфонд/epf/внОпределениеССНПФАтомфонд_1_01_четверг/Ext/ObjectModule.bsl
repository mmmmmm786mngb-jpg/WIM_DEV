	КонецЕсли; 
	
	ФормулаРасчета	= ОбщегоНазначения.ПолучитьЗначениеРеквизита(Валюта, "ФормулаРасчетаПоКривойДоходности");
	
	НеВыполненРасчетПоФормулеПользователя	= Истина;
	
	Если СокрЛП(ФормулаРасчета) <> "" Тогда
		
		Попытка
			Выполнить(ФормулаРасчета);
			
			НеВыполненРасчетПоФормулеПользователя	= Ложь;
		Исключение
			НеВыполненРасчетПоФормулеПользователя	= Истина;
		КонецПопытки;
		
	КонецЕсли; 
	
	Если Дюрация = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если НеВыполненРасчетПоФормулеПользователя Тогда
		Ставка = РасчетПоВнутреннейФормуле(Контекст, Дюрация, Актив);
