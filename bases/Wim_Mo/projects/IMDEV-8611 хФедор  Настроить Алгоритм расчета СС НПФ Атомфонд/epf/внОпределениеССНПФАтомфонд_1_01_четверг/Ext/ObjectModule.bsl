Функция ОсновнойРынокАктивен(СтруктураНастроек, НаДату, СтрокаСпискаЦБ, ОсновнойРынок, ТаблицаКотировокПоОсновнымРынкамПоАктиву)
	
	ОсновнойРынокАктивен	= Ложь;
	АктивОбъект = СтрокаСпискаЦБ.Объект;
	
	КоличествоСделок = 0;
	ОбъемТоргов = 0;
	ОбъемТорговВпоследнийДень = 0;
	
	Для Каждого СтрокаТаблицаКотировокПоОсновнымРынкамПоАктиву Из ТаблицаКотировокПоОсновнымРынкамПоАктиву Цикл
		Если СтрокаТаблицаКотировокПоОсновнымРынкамПоАктиву.Биржа = ОсновнойРынок Тогда
			
			КоличествоСделок 	= КоличествоСделок + СтрокаТаблицаКотировокПоОсновнымРынкамПоАктиву.NUMTRADES;
			ОбъемТоргов 		= ОбъемТоргов + СтрокаТаблицаКотировокПоОсновнымРынкамПоАктиву.ОбъемТоргов;
			
			// IMAPPS-15948 ++
			Если СтрокаТаблицаКотировокПоОсновнымРынкамПоАктиву.Период = НаДату Тогда
				ОбъемТорговВпоследнийДень = СтрокаТаблицаКотировокПоОсновнымРынкамПоАктиву.ОбъемТоргов;
			КонецЕсли;
			// IMAPPS-15948 --
			
		КонецЕсли;
	КонецЦикла;
	
	// IMAPPS-15948 ++
	//ОсновнойРынокАктивен = (КоличествоСделок >= 10) И (ОбъемТоргов/10 >= 500000);
	ОсновнойРынокАктивен = (ОбъемТорговВпоследнийДень > 0) И (КоличествоСделок >= 10) И (ОбъемТоргов >= 500000);
	// IMAPPS-15948 --
	
	Возврат ОсновнойРынокАктивен;
	
КонецФункции

Функция ЦенаАктиваУровень1(СтруктураНастроек, СтрокаСпискаЦБ, Знач КонецПериода, ТаблицаКотировокПоАктиву, ЗаполненнаяСтрокаКотировок)
	
	ОпределяемаяКотировка 	= 0;
	ОсновнойРынокАктивен	= Ложь;
	АктивОбъект 			= СтрокаСпискаЦБ.Объект;
	
	Если ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка <> 0 Тогда Возврат ЗаполненнаяСтрокаКотировок; КонецЕсли;
	
	ОсновнойРынок = СтруктураНастроек.БиржаММВБ;
	ОсновнойРынокАктивен	= ОсновнойРынокАктивен(СтруктураНастроек, КонецПериода, СтрокаСпискаЦБ, ОсновнойРынок, ТаблицаКотировокПоАктиву);
	
	// + FVasiliev IMDEV-8611 30.04.2026 
	//Не проверяя активный рынок, если бумага куплена при первичном размещении, что определяется отсутсвием котировок, берем цену размещения
	Если ТаблицаКотировокПоАктиву.Количество() = 0 Тогда
		СтруктураР = ОпределитьЦенуПервичногоРазмещения(СтрокаСпискаЦБ, КонецПериода);
		ОпределяемаяКотировка = СтруктураР.Цена;
		ЗаполненнаяСтрокаКотировок.УровеньЦены = 1;
		
		//ЗаполнитьЗначенияСвойств(ЗаполненнаяСтрокаКотировок, СтрокаТаблицаКотировокПоАктиву);
		ЗаполненнаяСтрокаКотировок.Актив = СтрокаСпискаЦБ;
		ЗаполненнаяСтрокаКотировок.Биржа = ОсновнойРынок;
		ЗаполненнаяСтрокаКотировок.Валюта = СтруктураР.Валюта;
		ЗаполненнаяСтрокаКотировок.Период = КонецПериода;
		ЗаполненнаяСтрокаКотировок.НаименованиеКотировки = "Цена первичного размещения";
		ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка = ОпределяемаяКотировка;
		ЗаполненнаяСтрокаКотировок.ДатаОпределения 		 = СтруктураР.Дата;
		
		СправкаРасчетОбластьСтрока.Параметры.Графа 	= "Цена первичного размещения";
		СправкаРасчетОбластьСтрока.Параметры.Котировка			= ОпределяемаяКотировка;
		СправкаРасчетОбластьСтрока.Параметры.ДатаОпределения	= СтруктураР.Дата;
		СправкаРасчетОбластьСтрока.Параметры.Биржа = ОсновнойРынок;
	Иначе
	// - FVasiliev IMDEV-8611 30.04.2026
		Если ОсновнойРынокАктивен Тогда
			ЗаполненнаяСтрокаКотировок = КотировкаПоВыбПолю(СтруктураНастроек, СтрокаСпискаЦБ, КонецПериода, ТаблицаКотировокПоАктиву, ЗаполненнаяСтрокаКотировок);
			СправкаРасчетОбластьСтрока.Параметры.Биржа			= ОсновнойРынок;
		КонецЕсли;
		
		СправкаРасчетОбластьСтрока.Параметры.РынокАктивен	= ОсновнойРынокАктивен;
		
		Если ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка <> 0 И ОсновнойРынокАктивен Тогда  
			ЗаполненнаяСтрокаКотировок.УровеньЦены = 1;
		Иначе
			ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка = 0;
			ЗаполненнаяСтрокаКотировок.УровеньЦены = 0;
		КонецЕсли;
	// + FVasiliev IMDEV-8611 30.04.2026 
	КонецЕсли;	
	// - FVasiliev IMDEV-8611 30.04.2026
	
	Возврат ЗаполненнаяСтрокаКотировок;
	
КонецФункции

Процедура ЦенаАктиваУровень2(Актив, Дата, СтруктураНастроек, ТаблицаКотировокНРД, ЗаполненнаяСтрокаКотировок, ТаблицаКотировокПоАктиву, Мандат)
			
	ЦенаНРД = 0;
	ВерсияРасчетаНРД = "";
	DCF = 0;
	ОпределяемаяКотировка = 0;
	// + FVasiliev IMDEV-8611 07.05.2026 
	ЭтоРублеваяОблигация = (Актив.ВидАктива.ПринадлежитЭлементу(ПланыВидовХарактеристик.ВидыАктивов.Облигации)
	И Актив.ВалютаНоминальнойСтоимости = Справочники.Валюты.RUB);
	// - FVasiliev IMDEV-8611 07.05.2026
	
	Если ЗначениеЗаполнено(СтруктураНастроек.РасчетныйЦентрНРД2) Тогда
		НайденныеСтрокиНРД	= ТаблицаКотировокНРД.НайтиСтроки(Новый Структура("Актив, Период, Биржа", Актив, НачалоДня(Дата), СтруктураНастроек.РасчетныйЦентрНРД2));
		Для каждого НайденнаяСтрока из НайденныеСтрокиНРД Цикл
			
			// + FVasiliev IMDEV-8611 07.05.2026 
			Если ЭтоРублеваяОблигация И НайденнаяСтрока.НомерМетодаРасчета = 3 Тогда
				Продолжить;
			КонецЕсли;
			// - FVasiliev IMDEV-8611 07.05.2026
			
			ЦенаНРД 	= НайденнаяСтрока.ПризнаваемаяКотировка;
			
			Если ЦенаНРД <> 0 Тогда
				ВерсияРасчетаНРД = "в.2";
				СтрокаКотировокПоНРД	= НайденнаяСтрока;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если ЦенаНРД = 0 И ЗначениеЗаполнено(СтруктураНастроек.РасчетныйЦентрНРД) Тогда
		НайденныеСтрокиНРД	= ТаблицаКотировокНРД.НайтиСтроки(Новый Структура("Актив, Период, Биржа", Актив, НачалоДня(Дата), СтруктураНастроек.РасчетныйЦентрНРД));
		Для каждого НайденнаяСтрока из НайденныеСтрокиНРД Цикл
			
			// + FVasiliev IMDEV-8611 07.05.2026 
			Если ЭтоРублеваяОблигация И НайденнаяСтрока.НомерМетодаРасчета = 3 Тогда
				Продолжить;
			КонецЕсли;
			// - FVasiliev IMDEV-8611 07.05.2026
			
			ЦенаНРД 	= НайденнаяСтрока.ПризнаваемаяКотировка;
			
			Если ЦенаНРД <> 0 Тогда
				ВерсияРасчетаНРД = "в.1";
				СтрокаКотировокПоНРД	= НайденнаяСтрока;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	ОпределяемаяКотировка		= ЦенаНРД;
	
	Если ЦенаНРД <> 0 Тогда
		ДатаОпределения				= СтрокаКотировокПоНРД.Период;
		УровеньЦены					= 2;
		ИмяГрафы					= "НРД "+ВерсияРасчетаНРД;
		
		ЗаполнитьЗначенияСвойств(ЗаполненнаяСтрокаКотировок, СтрокаКотировокПоНРД);
		ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка	= ОпределяемаяКотировка;
		ЗаполненнаяСтрокаКотировок.ДатаОпределения			= ДатаОпределения;
		ЗаполненнаяСтрокаКотировок.УровеньЦены				= УровеньЦены;
		
		СправкаРасчетОбластьСтрока.Параметры.Биржа			= "Расчетный центр НРД ("+ВерсияРасчетаНРД+")";
		СправкаРасчетОбластьСтрока.Параметры.Котировка		= ОпределяемаяКотировка;
		СправкаРасчетОбластьСтрока.Параметры.ДатаОпределения= ДатаОпределения;
		
