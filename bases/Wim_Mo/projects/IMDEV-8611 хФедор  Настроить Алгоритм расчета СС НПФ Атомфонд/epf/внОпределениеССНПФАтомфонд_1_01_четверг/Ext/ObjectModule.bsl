// FVasiliev IMDEV-8611 30.04.2026 
Процедура ДобавитьВыплатыКупонногоДохода(СтрокаОблигации, ДенежныйПоток, Портфель, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ОблигацииКупоны.ДатаВыплатыКупонногоДохода <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ОблигацииКупоны.ДатаВыплатыКупонногоДохода
		|		ИНАЧЕ ОблигацииКупоны.ДатаОкончанияКупонногоПериода
		|	КОНЕЦ КАК ДатаВыплатыКупонногоДохода,
		|	ОблигацииКупоны.ДатаОкончанияКупонногоПериода,
		|	ОблигацииКупоны.РазмерДоходаВПроцентах,
		|	ОблигацииКупоны.РазмерДоходаВРублях,
		|	ОблигацииКупоны.КолДнейВКупонномПериоде,
		|	ВЫБОР
		|		КОГДА ОблигацииКупоны.РазмерДоходаВРублях = 0
		|			ТОГДА Истина
		|		ИНАЧЕ ОблигацииКупоны.РасчетКупонаОтПроцента
		|	КОНЕЦ КАК РасчетКупонаОтПроцента,
		|	ОблигацииКупоны.ДатаНачалаКупонногоПериода
		|ИЗ
		|	Справочник.Облигации.Купоны КАК ОблигацииКупоны
		|ГДЕ
		|	ОблигацииКупоны.Ссылка = &Облигация
		|	И ВЫБОР
		|			КОГДА ОблигацииКупоны.ДатаВыплатыКупонногоДохода <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|				ТОГДА ОблигацииКупоны.ДатаВыплатыКупонногоДохода
		|			ИНАЧЕ ОблигацииКупоны.ДатаОкончанияКупонногоПериода
		|		КОНЕЦ > &ДатаНачала
		|	И ОблигацииКупоны.ДатаОкончанияКупонногоПериода <= &ДатаОкончания
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОблигацииКупоны.ДатаОкончанияКупонногоПериода";
	
	Запрос.УстановитьПараметр("ДатаНачала", Дата(1,1,1));
	Запрос.УстановитьПараметр("Облигация", СтрокаОблигации.Объект);
	Запрос.УстановитьПараметр("ДатаОкончания", '3999.12.31');
	
	Купоны = Запрос.Выполнить().Выгрузить();
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Документ.РасчетЭСП.МодульОбъекта.ДобавитьВыплатыКупонногоДохода()");
	
	ДатаДенежногоПотокаКупона = "ДатаОкончанияКупонногоПериода";
	
	ПоследнийИзвестныйКупон 		= Неопределено;
	ПоследнийКупонныйДоход 			= 0;
	ПоследнийИзвесныйПроцентКупона 	= 0;
	Для Каждого Купон Из Купоны Цикл
		
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(ПланыВидовХарактеристик.ПараметрыПортфеля.ПравилаОкругленияКотировок);
		ЗначенияПараметров = РегистрыСведений.ЗначенияПараметровПортфеля.ЗначенияПараметровПортфеля(Портфель, МассивПараметров, Дата);
		
		ПараметрыПортфеля = Новый Структура;
		ПараметрыПортфеля.Вставить("ПравилаОкругленияКотировок", ЗначенияПараметров.Получить(ПланыВидовХарактеристик.ПараметрыПортфеля.ПравилаОкругленияКотировок));

		НКДЗаЕдиницу = Перечисления.МетодыРасчетаНКД.НКД_НаДату(СтрокаОблигации.Объект, Купон, Купон.ДатаОкончанияКупонногоПериода, ПараметрыПортфеля.ПравилаОкругленияКотировок);
		
		Если НКДЗаЕдиницу = 0 Тогда
			НКДЗаЕдиницу	= ПоследнийКупонныйДоход;
		КонецЕсли; 
		
		ДобавитьДенежныйПоток(СтрокаОблигации, ДенежныйПоток, Купон[ДатаДенежногоПотокаКупона], 0, НКДЗаЕдиницу);
		
		ПоследнийИзвестныйКупон 		= Купон;
		ПоследнийКупонныйДоход 			= НКДЗаЕдиницу;
		ПоследнийИзвесныйПроцентКупона 	= Купон.РазмерДоходаВПроцентах;
	КонецЦикла;
	
КонецПроцедуры

// FVasiliev IMDEV-8611 30.04.2026 
Процедура ДобавитьВыплатыТела(СтрокаОблигации, ДенежныйПоток)
	
	РеквизитыОблигации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаОблигации.Объект, "ДатаПогашения, Амортизационная, ВидАктива, ВалютаНоминальнойСтоимости, МетодРасчетаНКД");
	
	ДатаОкончания = РеквизитыОблигации.ДатаПогашения;
	НоминальнаяСтоимостьВДатуОкончания = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(СтрокаОблигации.Объект, ДатаОкончания);
	ДобавитьДенежныйПоток(СтрокаОблигации, ДенежныйПоток, ДатаОкончания, НоминальнаяСтоимостьВДатуОкончания, 0);
	
	Если РеквизитыОблигации.Амортизационная Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОблигацииАмортизационныеВыплаты.ДатаПогашения КАК ДатаПогашения,
		|	ОблигацииАмортизационныеВыплаты.СуммаПогашения КАК СуммаПогашения
		|ИЗ
		|	Справочник.Облигации.АмортизационныеВыплаты КАК ОблигацииАмортизационныеВыплаты
		|ГДЕ
		|	ОблигацииАмортизационныеВыплаты.Ссылка = &Облигация
		|	И ОблигацииАмортизационныеВыплаты.ДатаПогашения > &ДатаНачала
		|	И ОблигацииАмортизационныеВыплаты.ДатаПогашения <= &ДатаОкончания
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПогашения";
		
		Запрос.УстановитьПараметр("ДатаНачала", Дата(1,1,1));
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
		Запрос.УстановитьПараметр("Облигация", СтрокаОблигации.Объект);
		
		ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Документ.РасчетФинансовыхПоказателейОблигаций.МодульОбъекта.ДобавитьВыплатыТела()");
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДобавитьДенежныйПоток(СтрокаОблигации, ДенежныйПоток, Выборка.ДатаПогашения, Выборка.СуммаПогашения, 0);
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

// FVasiliev IMDEV-8611 30.04.2026 
Процедура ОграничитьДенежныйПотокОфертой(Актив, ПоследняяСС, ДенежныйПоток, Дата)
		
	Запрос	= Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	      	               |	ОфертыОблигаций.Актив,
	      	               |	ОфертыОблигаций.ТипОферты,
	      	               |	ОфертыОблигаций.Период КАК Период,
	      	               |	ОфертыОблигаций.ЦенаОферты
	      	               |ИЗ
	      	               |	РегистрСведений.ОфертыОблигаций КАК ОфертыОблигаций
	      	               |ГДЕ
	      	               |	ОфертыОблигаций.Активность = ИСТИНА
	      	               |	И ОфертыОблигаций.Период >= &ДатаК
	      	               |	И ОфертыОблигаций.Актив = &Актив
	      	               |	И ВЫБОР
	      	               |			КОГДА ОфертыОблигаций.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОферт.CALL)
	      	               |				ТОГДА &СС >= ОфертыОблигаций.ЦенаОферты
	      	               |			ИНАЧЕ ИСТИНА
	      	               |		КОНЕЦ
	      	               |
	      	               |УПОРЯДОЧИТЬ ПО
	      	               |	ОфертыОблигаций.Период");
	
	Запрос.УстановитьПараметр("ДатаК", Дата);
	Запрос.УстановитьПараметр("Актив", Актив);
	Запрос.УстановитьПараметр("СС", ПоследняяСС);
	
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "РасчетЭСП.ОграничитьДенежныйПотокОфертой");
	
	Результат	= Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	
	Выборка	= Результат.Выбрать();
	Выборка.Следующий();
	
	КоличествоСтрокВПотоке	= ДенежныйПоток.Количество();
	
	Если КоличествоСтрокВПотоке <= 1 Тогда
		Возврат;
	КонецЕсли;
	ТекСтрока			= Неопределено;
	ПредыдущаяСтрока	= ДенежныйПоток.Получить(КоличествоСтрокВПотоке - 1);
	
	//vtb 11.01
	//ПоследнееТело		= ПредыдущаяСтрока.Тело;
	ПоследнееТело = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(Актив.Объект,Выборка.Период);
	
	СтрокиКУдалению	= Новый Массив;
	СтрокиКУдалению.Добавить(ПредыдущаяСтрока);
	
	Сутки	= 24*60*60;
	ДенежныйПоток.Сортировать("Дата Возр");
	Для Счетчик = 1 По КоличествоСтрокВПотоке Цикл//обратный цикл
		
		Если Счетчик = 1 Тогда
			Продолжить;
		КонецЕсли; 
		
		ТекСтрока	= ДенежныйПоток.Получить(КоличествоСтрокВПотоке - Счетчик);
		
		ДанныеНайдены = ЛожЬ;
		
		Если ПредыдущаяСтрока.Дата >= Выборка.Период И ТекСтрока.Дата <= Выборка.Период Тогда
			ДанныеНайдены = Истина;
			ТекСтрока.Тело = ПоследнееТело;
			Прервать;
