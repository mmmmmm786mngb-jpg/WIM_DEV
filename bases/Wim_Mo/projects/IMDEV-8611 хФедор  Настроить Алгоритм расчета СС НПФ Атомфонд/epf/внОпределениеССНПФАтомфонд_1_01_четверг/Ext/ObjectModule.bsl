Процедура ДобавитьДенежныйПоток(СтрокаОблигации, ДенежныйПоток, ДатаПотока, Тело, НКД);
	
	Если ТипЗнч(ДатаПотока) <> Тип("Дата") Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = ДенежныйПоток.НайтиСтроки(Новый Структура("Дата", ДатаПотока));
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрока = ДенежныйПоток.Добавить();
		НоваяСтрока.Актив 			= СтрокаОблигации.Актив;
		НоваяСтрока.Дата 			= ДатаПотока;
		НоваяСтрока.Тело 			= Тело;
		НоваяСтрока.КупонныйДоход 	= НКД;
		НоваяСтрока.Итого 			= НоваяСтрока.КупонныйДоход;
	Иначе
		НоваяСтрока = НайденныеСтроки[0];
		НоваяСтрока.Тело 			= НоваяСтрока.Тело + Тело;
		НоваяСтрока.КупонныйДоход 	= НоваяСтрока.КупонныйДоход + НКД;
		НоваяСтрока.Итого 			= НоваяСтрока.КупонныйДоход;
		
	КонецЕсли;
	
