// FVasiliev IMDEV-8611 30.04.2026 
Функция РасчетПоВнутреннейФормуле(Контекст, Dur, Актив)
	
	betta0	= Контекст.betta0;
	betta1	= Контекст.betta1;
	betta2	= Контекст.betta2;
	
	b1	= Контекст.b1;
	b2	= Контекст.b2;
	b3	= Контекст.b3;
	b4	= Контекст.b4;
	b5	= Контекст.b5;
	b6	= Контекст.b6;
	b7	= Контекст.b7;
	b8	= Контекст.b8;
	b9	= Контекст.b9;
	
	tetta	= Контекст.tetta;
	
	a1	= Контекст.a1;
	a2	= Контекст.a2;
	a3	= Контекст.a3;
	a4	= Контекст.a4;
	a5	= Контекст.a5;
	a6	= Контекст.a6;
	a7	= Контекст.a7;
	a8	= Контекст.a8;
	a9	= Контекст.a9;
	
	g1	= Контекст.g1;
	g2	= Контекст.g2;
	g3	= Контекст.g3;
	g4	= Контекст.g4;
	g5	= Контекст.g5;
	g6	= Контекст.g6;
	g7	= Контекст.g7;
	g8	= Контекст.g8;
	g9	= Контекст.g9;
	
	
	Попытка 
		Часть1	= betta0+(betta1+betta2)*(tetta/Dur)*(1-EXP(-Dur/tetta));
	Исключение 
		Сообщить("Актив: " + Актив + " дюрация " + Dur + " tetta " + tetta);
	КонецПопытки;
	
	Часть2	= betta2*EXP(-Dur/tetta);
	Часть3	= g1*EXP(-(Pow((Dur-a1),2))/Pow(b1,2));
	Часть4	= g2*EXP(-(Pow((Dur-a2),2))/Pow(b2,2));
	Часть5	= g3*EXP(-(Pow((Dur-a3),2))/Pow(b3,2));
	Часть6	= g4*EXP(-(Pow((Dur-a4),2))/Pow(b4,2));
	Часть7	= g5*Exp(-(Pow((Dur-a5),2))/Pow(b5,2));
	Часть8	= g6*Exp(-(Pow((Dur-a6),2))/Pow(b6,2));
	Часть9	= g7*Exp(-(Pow((Dur-a7),2))/Pow(b7,2));
	Часть10	= g8*Exp(-(Pow((Dur-a8),2))/Pow(b8,2));
	Часть11	= g9*Exp(-(Pow((Dur-a9),2))/Pow(b9,2));
	
	Ставка = EXP((Часть1-Часть2+Часть3+Часть4+Часть5+Часть6+Часть7+Часть8+Часть9+Часть10+Часть11)/10000)-1;
	
	Возврат Ставка;
	
КонецФункции

// FVasiliev IMDEV-8611 30.04.2026 
Процедура ДобавитьФиксированныеПараметры(Контекст)
	
	Контекст.Вставить("a1", 0);
	Контекст.Вставить("a2", 0.6);
	
	к = 1.6;
	т = Контекст.a2;
	
	Для инд = 2 по 8 Цикл
		т = т + Контекст.a2 * pow(к, инд-1);
		
		Контекст.Вставить("a"+Строка(инд+1), т);
	КонецЦикла;
	
	т = Контекст.a2;
	Контекст.Вставить("b1", т);
	
	Для инд = 1 по 8 Цикл
		т = т * к;
		Контекст.Вставить("b"+Строка(инд+1), т);
	КонецЦикла;
	
КонецПроцедуры

