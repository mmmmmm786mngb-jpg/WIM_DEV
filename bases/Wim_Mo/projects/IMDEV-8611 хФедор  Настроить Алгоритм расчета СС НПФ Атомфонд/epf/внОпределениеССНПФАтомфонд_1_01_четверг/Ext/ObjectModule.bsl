Функция ПолучитьТекстЗапросаТаблицаКотировокММВБ()
	
	Текст = "ВЫБРАТЬ
	        |	т.Период КАК Период,
	        |	т.Актив,
	        |	т.Биржа,
	        |	т.Валюта,
	        |	т.ПризнаваемаяКотировка,
	        |	т.УровеньКотировальногоЛиста,
	        |	т.ОбъемТоргов,
	        |	т.НКД,
	        |	т.OPENPERIOD,
	        |	т.OPEN,
	        |	т.ЦенаЗакрытия,
	        |	т.CLOSE,
	        |	т.LASTPRICE,
	        |	т.РыночнаяЦена2,
	        |	т.РыночнаяЦена3,
	        |	т.ЦенаСпроса,
	        |	т.OFFER,
	        |	т.NUMTRADES,
			|	т.МинимальнаяЦена,
			|	т.МаксимальнаяЦена,
			|	т.СредневзвешеннаяЦена
	        |ИЗ
	        |	РегистрСведений.КотировкиЦБНаБирже КАК т
	        |ГДЕ
	        |	т.Период МЕЖДУ &НачалоПериода И &КонецПериода
	        |	И т.Актив В (&СписокЦБ)
	        |	И т.Биржа = &ММВБ
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	Период";
				   
	Возврат Текст;
	
КонецФункции

Функция ПолучитьТекстЗапросаСырыеКотировкиНРД()
	
	Текст = "ВЫБРАТЬ
	        |	НАЧАЛОПЕРИОДА(КотировкиЦБНаБирже.Период, ДЕНЬ) КАК Период,
	        |	КотировкиЦБНаБирже.Регистратор,
	        |	КотировкиЦБНаБирже.Актив КАК Актив,
	        |	КотировкиЦБНаБирже.Биржа,
	        |	КотировкиЦБНаБирже.Валюта,
	        |	КотировкиЦБНаБирже.ПризнаваемаяКотировка,
			|	КотировкиЦБНаБирже.НомерМетодаРасчета
	        |ИЗ
	        |	РегистрСведений.КотировкиЦБНаБирже КАК КотировкиЦБНаБирже
	        |ГДЕ
	        |	НАЧАЛОПЕРИОДА(КотировкиЦБНаБирже.Период, ДЕНЬ) МЕЖДУ &НачалоПериода И &КонецПериода
	        |	И КотировкиЦБНаБирже.Актив В(&СписокЦБ)
	        |	И КотировкиЦБНаБирже.Биржа in (&НРД , &НРД2)
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	Актив,
	        |	Период УБЫВ";
	
	Возврат Текст;
	
КонецФункции

