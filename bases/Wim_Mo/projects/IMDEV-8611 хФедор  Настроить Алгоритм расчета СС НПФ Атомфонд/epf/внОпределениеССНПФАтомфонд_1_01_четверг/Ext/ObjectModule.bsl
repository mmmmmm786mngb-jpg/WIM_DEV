// FVasiliev IMDEV-8611 30.04.2026 
Процедура ЦенаАктиваУровень3(Актив, Дата, СтруктураНастроек, ТаблицаКотировокПоАктиву, ТаблицаКотировокОценщик, ТаблицаКотировокНРД, ЗаполненнаяСтрокаКотировок, СтруктураЦенПоСпредам)
			
	ЦенаОценщик = 0;
	ОпределяемаяКотировка = 0;
	ЦенаНРД = 0;
	
	Если ЗначениеЗаполнено(СтруктураНастроек.РасчетныйЦентрНРД2) Тогда
		НайденныеСтрокиНРД	= ТаблицаКотировокНРД.НайтиСтроки(Новый Структура("Актив, Период, Биржа, НомерМетодаРасчета", Актив, НачалоДня(Дата), СтруктураНастроек.РасчетныйЦентрНРД2, 3));
		Для каждого НайденнаяСтрока из НайденныеСтрокиНРД Цикл
			
			ЦенаНРД 	= НайденнаяСтрока.ПризнаваемаяКотировка;
			
			Если ЦенаНРД <> 0 Тогда
				ВерсияРасчетаНРД = "в.2";
				СтрокаКотировокПоНРД	= НайденнаяСтрока;
				
				ОсновнойРынок = СтруктураНастроек.РасчетныйЦентрНРД2;
				
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Если ЦенаНРД <> 0 Тогда
		ОпределяемаяКотировка		= ЦенаНРД;
		Если ОпределяемаяКотировка = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ДатаОпределения				= СтрокаКотировокПоНРД.Период;
		УровеньЦены					= 3;
