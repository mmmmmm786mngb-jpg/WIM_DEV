		ОграничитьДенежныйПотокОфертой(Актив, ПоследняяСС, ТЗ_ДенежныйПоток, СтруктураЦенПоСпредам.ДанныеРасчета.Дата);
		
		ТЗ = ТЗ_ДенежныйПоток.Скопировать();
		ТЗ.Колонки.Добавить("КоличествоДней", новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СрокДоПогашения", новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("КБД", новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("DCF", новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("КредитныйСпред", новый ОписаниеТипов("Число"));
		Знаменатель = 0;
		
		Рез = ПолучитьКредитныйРейтинг(Актив, Дата);
			Если Рез = "" Тогда
				КредитныйСпред = 0;
			Иначе 
				
				Если Рез = "МинСпред" Тогда		
					КредитныйСпред = ЗначенияМедиан.Получить(Справочники.УровниКредитногоРейтинга.A);
				ИначеЕсли Рез = "Медиана" Тогда		
					КредитныйСпред = ЗначенияМедиан.Получить(Справочники.УровниКредитногоРейтинга.B);
				Иначе
					КредитныйСпред = ЗначенияМедиан.Получить(Справочники.УровниКредитногоРейтинга.C);
				КонецЕсли;	
				КредитныйСпред = Окр(КредитныйСпред, 0);
				КредитныйСпред = КредитныйСпред/100;
				//КредитныйСпред = СтруктураЦенПоСпредам.ДанныеРасчета[Рез]/100;   
			КонецЕсли;

		Для Каждого Стр ИЗ ТЗ Цикл
			Стр.КоличествоДней = ?(стр.Дата - НачалоДня(Дата)<0, 0 ,(стр.Дата - НачалоДня(Дата))/(3600*24));
			Стр.СрокДоПогашения = ?(Стр.КоличествоДней>0, Стр.КоличествоДней, 0)/365;                                                
			Стр.КБД = Окр(СтавкаПоКривойБезрисковойДоходности(СтруктураЦенПоСпредам.ДанныеРасчета.Валюта, Дата, Стр.СрокДоПогашения, Актив)*100,2);
			Стр.КредитныйСпред = КредитныйСпред;   
			Стр.DCF = ?(Стр.КоличествоДней = 0, 0, (Стр.Тело + Стр.КупонныйДоход)/pow(1+(Стр.КБД + Стр.КредитныйСпред)/100, Стр.КоличествоДней/365)); //=(D44+G44)/((1+(L44+M44)/100)^(I44/365))
			Если Стр.СрокДоПогашения > 0 Тогда		
				Знаменатель = Знаменатель + Стр.Тело;
			КонецЕсли;
		КонецЦикла;
		
		PV = ТЗ.Итог("DCF")/Знаменатель*1000 - СтруктураЦенПоСпредам.ДанныеРасчета.Купон;
		PV = PV/10;
		
		Если PV > ЦенаПредложения И ЦенаПредложения <> 0 Тогда
			ОпределяемаяКотировка = ЦенаПредложения;
		ИначеЕсли PV < ЦенаСпроса Тогда 
			ОпределяемаяКотировка = ЦенаСпроса;
		Иначе
			ОпределяемаяКотировка = PV;
		КонецЕсли;
		
		ИмяГрафы				= "DCF по ставке";
		ДатаОпределения			= Дата;
		УровеньЦены				= 3;
		ПодУровеньЦены			= "3.C";
					
		ИмяБиржи	= "Расчетные данные";
			
		ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка	= ОпределяемаяКотировка;
		ЗаполненнаяСтрокаКотировок.ДатаОпределения			= ДатаОпределения;
		ЗаполненнаяСтрокаКотировок.УровеньЦены				= УровеньЦены;
		ЗаполненнаяСтрокаКотировок.НаименованиеКотировки	= ИмяГрафы; 
		ЗаполненнаяСтрокаКотировок.период					= ДатаОпределения;
		ЗаполненнаяСтрокаКотировок.Актив					= Актив;
		ЗаполненнаяСтрокаКотировок.Валюта					= Актив.ВалютаНоминальнойСтоимости;
		
		СправкаРасчетОбластьСтрока.Параметры.Биржа				= "DCF";
		СправкаРасчетОбластьСтрока.Параметры.Графа 				= ИмяГрафы;
		СправкаРасчетОбластьСтрока.Параметры.Котировка			= ОпределяемаяКотировка;
		СправкаРасчетОбластьСтрока.Параметры.ДатаОпределения	= ДатаОпределения;
		СправкаРасчетОбластьСтрока.Параметры.Bid 				= ЦенаСпроса;
		СправкаРасчетОбластьСтрока.Параметры.Offer 				= ЦенаПредложения;
			
	КонецЕсли;
// IMAPPS-11191 <--
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
		
	Если ЗначениеЗаполнено(СтруктураНастроек.Оценщик) Тогда
