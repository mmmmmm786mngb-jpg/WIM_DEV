Функция ТекущиеКотировкиПоПравилу(Мандат, Дата, Правило, СписокБирж,  СписокЦБ, ТекстОшибок) Экспорт

	ОтправитьЛог = Ложь;
	
	Макет	= ПолучитьМакет("СправкаРасчет");
	
	СправкаРасчет	= Новый ТабличныйДокумент;
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	
	СтруктураНастроек = НастройкиАлгоритма(Правило.НастройкиАлгоритма);
		
	МакетЛога = ПолучитьМакет("Лог");
	Лог = Новый ТабличныйДокумент;
	
	Шапка 	= МакетЛога.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Дата			= Дата;
	Лог.Вывести(Шапка);
	
	ЗаголовокТаблицы = МакетЛога.ПолучитьОбласть("ЗаголовокТаблицы");
	Лог.Вывести(ЗаголовокТаблицы);
	
	СтрокаТаблицыЛога = МакетЛога.ПолучитьОбласть("СтрокаТаблицы");	
	
	Календарь	= СтруктураНастроек.БиржевойКалендарь;
	// + FVasiliev IMDEV-8611 30.04.2026 
	//Календарь	= ?(Календарь.Пустая(), Справочники.ПроизводственныеКалендари.РегламентированныйКалендарь, Календарь);
	Календарь	= ?(НЕ ЗначениеЗаполнено(Календарь), Справочники.ПроизводственныеКалендари.РегламентированныйКалендарь, Календарь);
	// - FVasiliev IMDEV-8611 30.04.2026
	
	НачалоПериода = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(Календарь, Дата, -9);
	КонецПериода  = КалендарныеГрафики.ПолучитьПоследнийРабочийДеньПериода(Календарь, НачалоПериода, Дата);
	
	ТаблицаКотировокПоОсновнымРынкам = ПодготовитьДанныеДляРасчетаММБВ(НачалоПериода, КонецПериода, СписокЦБ, СтруктураНастроек);
	ТаблицаКотировокНРД = ПодготовитьДанныеДляРасчетаНРД(НачалоПериода, КонецПериода, СписокЦБ, СтруктураНастроек);
	// + FVasiliev IMDEV-8611 30.04.2026 
	ТаблицаКотировокОценщик = ПодготовитьДанныеДляРасчетаОценщик(КонецПериода, КонецПериода, СписокЦБ, СтруктураНастроек);
	СтруктураЦенПоСпредам = Неопределено;
	// - FVasiliev IMDEV-8611 30.04.2026
		
	ТаблицаКотировок = ТаблицаКотировокПоОсновнымРынкам.Скопировать();
	ТаблицаКотировок.Очистить();
	ТаблицаКотировок.Колонки.Добавить("ОпределяемаяКотировка", Новый ОписаниеТипов("Число"));
	ТаблицаКотировок.Колонки.Добавить("УровеньЦены", Новый ОписаниеТипов("Число"));
	ТаблицаКотировок.Колонки.Добавить("НаименованиеКотировки", Новый ОписаниеТипов("Строка"));
	ТаблицаКотировок.Колонки.Добавить("ДатаОпределения", Новый ОписаниеТипов("Дата"));
	
	// VTB-Borisov  - 06.07.2018 { 
	КотировкиНКД = ПодготовитьДанныеДляРасчетаНКД(Дата, СписокЦБ, СтруктураНастроек);
	// VTB-Borisov  - 06.07.2018 }
	
	СправкаРасчет.Вывести(ОбластьШапка);
	
	Для Каждого СтрокаСпискаЦБ Из СписокЦБ Цикл
		
		ТаблицаКотировокПоАктиву = ТаблицаКотировокПоОсновнымРынкам.Скопировать(Новый Структура("Актив", СтрокаСпискаЦБ));
		
		РеквизитыАктива	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаСпискаЦБ, "ВидАктива, Объект.ISIN");
		
		СправкаРасчетОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
		СправкаРасчетОбластьСтрока.Параметры.Актив		= СтрокаСпискаЦБ;
		СправкаРасчетОбластьСтрока.Параметры.ВидАктива	= РеквизитыАктива.ВидАктива;
		СправкаРасчетОбластьСтрока.Параметры.ИСИН		= РеквизитыАктива.ОбъектISIN;
		
		ЗаполненнаяСтрокаКотировок	= ТаблицаКотировок.Добавить();
		ЗаполненнаяСтрокаКотировок = ЦенаАктиваУровень1(СтруктураНастроек, СтрокаСпискаЦБ, КонецПериода, ТаблицаКотировокПоАктиву, ЗаполненнаяСтрокаКотировок);
		
		Если ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка = 0 Тогда
			// IMAPPS-11205 -->
			ЦенаАктиваУровень2(СтрокаСпискаЦБ, КонецПериода, СтруктураНастроек, ТаблицаКотировокНРД, ЗаполненнаяСтрокаКотировок, ТаблицаКотировокПоАктиву, Мандат);
			//ЦенаАктиваУровень2(СтрокаСпискаЦБ, КонецПериода, СтруктураНастроек, ТаблицаКотировокНРД, ЗаполненнаяСтрокаКотировок);
			// IMAPPS-11205 <--
		КонецЕсли;
		
	// + FVasiliev IMDEV-8611 30.04.2026 
		Если ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка = 0 Тогда
			ЦенаАктиваУровень3(СтрокаСпискаЦБ, КонецПериода, СтруктураНастроек, ТаблицаКотировокПоАктиву, ТаблицаКотировокОценщик, ТаблицаКотировокНРД, ЗаполненнаяСтрокаКотировок, СтруктураЦенПоСпредам)	
		КонецЕсли;	
	// - FVasiliev IMDEV-8611 30.04.2026
		
		Если ЗаполненнаяСтрокаКотировок <> Неопределено И ЗаполненнаяСтрокаКотировок.ОпределяемаяКотировка <> 0 Тогда
			
			// алгоритмы определения цены могли взять историческую котировку (определенную по глубине поиска), восстановим НКД на дату рассчета
			//КотировкаНКД = ТаблицаКотировокПоАктиву.НайтиСтроки(Новый Структура("Период", НачалоДня(Дата)));
			//Для Каждого СтрокаКотировки Из КотировкаНКД Цикл
			//	ЗаполненнаяСтрокаКотировок.НКД = СтрокаКотировки.НКД;
			//КонецЦикла;
			//НКД заполняем в конце
			ЗаполненнаяСтрокаКотировок.НКД = 0;
									
			СправкаРасчетОбластьСтрока.Параметры.УровеньЦены	= ЗаполненнаяСтрокаКотировок.УровеньЦены;
			
			СправкаРасчет.Вывести(СправкаРасчетОбластьСтрока);
			
		Иначе
			
			ОтправитьЛог = Истина;
			СтрокаТаблицыЛога.Параметры.Актив = СтрокаСпискаЦБ;
			СтрокаТаблицыЛога.Параметры.ISIN = РеквизитыАктива.ОбъектISIN;
			СтрокаТаблицыЛога.Параметры.УровеньЦены 	= 3;
			Лог.Вывести(СтрокаТаблицыЛога);
			// не расчитанные бумаги тоже выведем. чтобы было понятно
			СправкаРасчетОбластьСтрока.Параметры.УровеньЦены 	= 3;
			СправкаРасчетОбластьСтрока.Параметры.Котировка		= "-";
			СправкаРасчетОбластьСтрока.Параметры.ДатаОпределения= "-";
			СправкаРасчетОбластьСтрока.Параметры.Биржа			= "-";
			СправкаРасчетОбластьСтрока.Параметры.Графа 	= "";
			
			СправкаРасчетОбластьСтрока.Область(1,1,1,13).ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
			СправкаРасчет.Вывести(СправкаРасчетОбластьСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// IMAPPS-11205 -->
	Если ДанныеОПотоках.Количество() > 0 Тогда
		
		ОбластьШапка	= Макет.ПолучитьОбласть("ШапкаПотоки");		
		СправкаРасчет.Вывести(ОбластьШапка);
		
		Для каждого ТекПоток Из ДанныеОПотоках Цикл	
			Для каждого ТекСтрокаПотока Из ТекПоток.Значение.Поток Цикл
				
				ОбластьСтрока	= Макет.ПолучитьОбласть("СтрокаПотоки");		
				ОбластьСтрока.Параметры.Актив	= ТекПоток.Значение.Наименование;
				ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ТекСтрокаПотока);		
				СправкаРасчет.Вывести(ОбластьСтрока);
				
			КонецЦикла; 			
		КонецЦикла; 	
	КонецЕсли;
	// IMAPPS-11205 <--
	
	//Отправим лог по бумагам, по которым не смогли определить котировки первого уровня
	
	Если ОтправитьЛог и ЗначениеЗаполнено(СтруктураНастроек.ПочтовыйЛогин) и ЗначениеЗаполнено(СтруктураНастроек.EmailПолучателей) Тогда	
		
		Если тзОшибки.Количество()>0 тогда
			ШапкаОшибка 	= МакетЛога.ПолучитьОбласть("ШапкаОшибка");
			Лог.Вывести(ШапкаОшибка);
	
			Для каждого СтрОшибка  Из тзОшибки Цикл
				СтрокаОшибки 	= МакетЛога.ПолучитьОбласть("СтрокаОшибки");
				СтрокаОшибки.Параметры.Ошибка			= СтрОшибка.Ошибка;
				Лог.Вывести(СтрокаОшибки);
			КонецЦикла; 
		КонецЕсли;
		
		 ПараметрыПисьма = Новый Структура("Кому, Тема, Тело,Вложения");
		 ПараметрыПисьма.Тема = "Котировки по портфелю "+ Мандат+" за "+ Формат(Дата,"ДФ=dd.MM.yyyy");
		 ПараметрыПисьма.Кому = СтруктураНастроек.EmailПолучателей;

		 ПутьКФайлу = ПолучитьИмяВременногоФайла("XLS");
		 Лог.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLS);
		 		
		 Вложения = Новый Соответствие;
		 ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
		 АдресВложения = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		 Вложения.Вставить("Котировки по портфелю "+ Мандат+" за "+ Формат(Дата,"ДФ=dd.MM.yyyy")+".xls", АдресВложения);
		 
		 ПараметрыПисьма.Вложения = Вложения;
		 
		 ПараметрыПисьма.Тело =  "Котировки по портфелю "+ Мандат+" за "+ Дата;
		 Попытка
			 РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(СтруктураНастроек.ПочтовыйЛогин, ПараметрыПисьма);
			 //РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты, ПараметрыПисьма);
			 текстРассылки = "Рассылка завершена";
		 Исключение 
			 Сообщения = ПолучитьСообщенияПользователю(Истина);
		 КонецПопытки;
	КонецЕсли;
	
	СправкаРасчет.ОтображатьЗаголовки	= Ложь;
	СправкаРасчет.ОтображатьСетку		= Ложь;
	
	// дозаполним поля для документа
	ТаблицаКотировок.Колонки.Добавить("НоминалОблигации", Новый ОписаниеТипов("Число"));
	ТаблицаКотировок.Колонки.Добавить("КотировкаУУ", Новый ОписаниеТипов("Число"));
	ТаблицаКотировок.Колонки.Добавить("НаименованиеКотировкиУУ", Новый ОписаниеТипов("Строка"));
	ТаблицаКотировок.Колонки.Добавить("БиржаУУ", новый ОписаниеТипов("СправочникСсылка.Биржи"));
	ТаблицаКотировок.Колонки.Добавить("КотировкаВПроцентахУУ", Новый ОписаниеТипов("Число"));
	ТаблицаКотировок.Колонки.Добавить("КотировкаВПроцентахБУ", Новый ОписаниеТипов("Число"));
	ТаблицаКотировок.Колонки.Добавить("ВалютаУУ", новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаКотировок.Колонки.Добавить("ВалютаНКД", новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	Для каждого СтрокаКотировки Из ТаблицаКотировок Цикл
		СтрокаКотировки.НоминалОблигации = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(СтрокаКотировки.Актив, Дата);
		СтрокаКотировки.КотировкаВПроцентахБУ = СтрокаКотировки.ОпределяемаяКотировка;
		Если СтрокаКотировки.НоминалОблигации <> 0 Тогда
			СтрокаКотировки.ОпределяемаяКотировка = СтрокаКотировки.ОпределяемаяКотировка*СтрокаКотировки.НоминалОблигации/100;
		КонецЕсли;
		СтрокаКотировки.КотировкаУУ = СтрокаКотировки.ОпределяемаяКотировка;
		СтрокаКотировки.НаименованиеКотировкиУУ = СтрокаКотировки.НаименованиеКотировки;
		СтрокаКотировки.КотировкаВПроцентахУУ = СтрокаКотировки.КотировкаВПроцентахБУ;
		СтрокаКотировки.БиржаУУ = СтрокаКотировки.Биржа;
		СтрокаКотировки.ВалютаУУ = СтрокаКотировки.Актив.ВалютаНоминальнойСтоимости;
		СтрокаКотировки.ВалютаНКД = СтрокаКотировки.Валюта;
		//СтрокаКотировки.ДатаОпределения = Дата;	
		
		// VTB-Borisov  - 06.07.2018 { 
		Если (СтрокаКотировки.НКД = 0) ИЛИ СтрокаКотировки.НКД = Неопределено Тогда
			мас = КотировкиНКД.НайтиСтроки(Новый Структура("Актив", СтрокаКотировки.Актив));
			Для каждого СтрокаНКД ИЗ мас Цикл
				Если СтрокаНКД.НКД <> 0 Тогда
					СтрокаКотировки.НКД = СтрокаНКД.НКД;
					СтрокаКотировки.ВалютаНКД = СтрокаНКД.Валюта;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// VTB-Borisov  - 06.07.2018 }
		
	КонецЦикла;
	
	
	Возврат Новый Структура("ТаблицаКотировок, СправкаРасчет", ТаблицаКотировок, СправкаРасчет);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СвойствоСтруктуры(Структура, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено) Экспорт
	Если Структура.Свойство(ИмяСвойства) Тогда
		Возврат Структура[ИмяСвойства];
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
КонецФункции

Функция НастройкиАлгоритма(ХранилищеНастроек)
	
	СтруктураНастроек = Новый Структура("масИнБиржи,БиржевойКалендарь,ИмяКолонкиPX_LAST,ПочтовыйЛогин,EmailПолучателей,РасчетныйЦентрНРД, РасчетныйЦентрНРД2, Оценщик");

	//ХранилищеНастроек = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Алгоритм, "ХранилищеНастроек");
	Настройки = ХранилищеНастроек.Получить();
	
	СтруктураНастроек.Вставить("БиржаММВБ", Справочники.Биржи.ПустаяСсылка());
	
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		
		СтруктураНастроек.масИнБиржи = СвойствоСтруктуры(Настройки, "масИнБиржи", новый Массив);
		СтруктураНастроек.БиржевойКалендарь = СвойствоСтруктуры(Настройки, "БиржевойКалендарь");
		
		СтруктураНастроек.ПочтовыйЛогин = СвойствоСтруктуры(Настройки, "ПочтовыйЛогин");
		СтруктураНастроек.EmailПолучателей = СвойствоСтруктуры(Настройки, "EmailПолучателей");
		
		СтруктураНастроек.БиржаММВБ = СвойствоСтруктуры(Настройки, "БиржаММВБ", СтруктураНастроек.БиржаММВБ);
		СтруктураНастроек.РасчетныйЦентрНРД = СвойствоСтруктуры(Настройки, "РасчетныйЦентрНРД", СтруктураНастроек.РасчетныйЦентрНРД);
		СтруктураНастроек.РасчетныйЦентрНРД2 = СвойствоСтруктуры(Настройки, "РасчетныйЦентрНРД2", СтруктураНастроек.РасчетныйЦентрНРД2);
		
		СтруктураНастроек.Оценщик = СвойствоСтруктуры(Настройки, "Оценщик", СтруктураНастроек.Оценщик);
	КонецЕсли;
	
	СтруктураНастроек.Вставить("ИмяКолонкиPX_LAST", "ПризнаваемаяКотировка");
	СтруктураНастроек.Вставить("ИмяКолонкиLAST_PRICE", "LASTPRICE");
	
	СтруктураНастроек.Вставить("ИмяКолонкиBID", "ЦенаСпроса");
	СтруктураНастроек.Вставить("ИмяКолонкиCLOSE", "ЦенаЗакрытия"); //ЦенаЗакрытия
	СтруктураНастроек.Вставить("ИмяКолонкиOFFER", "OFFER");
	
	Возврат СтруктураНастроек;

КонецФункции
	
