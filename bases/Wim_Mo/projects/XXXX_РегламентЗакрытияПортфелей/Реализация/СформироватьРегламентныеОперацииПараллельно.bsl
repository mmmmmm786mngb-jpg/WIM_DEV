////////////////////////////////////////////////////////////////////////////////
// Параллельный запуск формирования регламентных операций по мандатам
//
// Назначение:
//   Разбить все мандаты (договора ДУ) на K партиций, где K берётся из константы
//   "МаксимальноеКоличествоПараллельныхПотоков", и запустить K фоновых заданий
//   параллельно. Каждое задание обрабатывает свою партицию мандатов последовательно,
//   переиспользуя существующий диспетчер
//   Справочники.РегламентныеПериоды.СформироватьДокументыЗакрытияПериода().
//
// Точка входа (команда формы):
//   Справочник.РегламентныеПериоды.Форма.РегламентныйПериод
//   → кнопка "Сформировать регл. операции (параллельно)"
//   → СформироватьРеглОперацииПараллельно(Команда) — клиентская
//   → СформироватьРегламентныеОперацииПараллельно() — клиентская
//
// Содержимое файла (3 блока кода для 2 разных мест):
//   [Блок 1] Модуль формы "РегламентныйПериод" — клиент + сервер
//   [Блок 2] Общий модуль "ФоновыеЗаданияСервер" — тело партиции (Экспорт)
//
// Требования:
//   - В конфигурации должна существовать Константа.МаксимальноеКоличествоПараллельныхПотоков
//     (тип: Число, длина 3, неотрицательное). Если константа отсутствует — код
//     корректно падает в синхронный режим.
//   - Клиент-серверная или файловая ИБ с включенными фоновыми заданиями.
//     Проверяется существующей функцией ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены().
////////////////////////////////////////////////////////////////////////////////



////////////////////////////////////////////////////////////////////////////////
// [Блок 1] МОДУЛЬ ФОРМЫ
// Путь: SRC/CF/Catalogs/РегламентныеПериоды/Forms/РегламентныйПериод/Ext/Form/Module.bsl
// Добавить в конец модуля (и создать команду формы "СформироватьРеглОперацииПараллельно")
////////////////////////////////////////////////////////////////////////////////

// Описание: Обработчик команды формы "Сформировать регл. операции (параллельно)".
//           Запускает формирование документов закрытия периода по всем мандатам
//           в K параллельных фоновых заданиях.
//
// Параметры:
//   Команда - КомандаФормы - команда, с которой вызван обработчик.
//
&НаКлиенте
Процедура СформироватьРеглОперацииПараллельно(Команда)

    ОчиститьСообщения();
    СформироватьРегламентныеОперацииПараллельно();

КонецПроцедуры


// Описание: Клиентская процедура параллельного формирования регламентных операций.
//           Отдаёт серверу подготовленную сессию, дожидается завершения заданий,
//           обновляет дерево и показывает прогресс/сообщения пользователю.
//
&НаКлиенте
Процедура СформироватьРегламентныеОперацииПараллельно()

    // Если период не определён — нет смысла что-либо запускать
    Если РеглПериод.Пустая() Тогда
        ОбщегоНазначения.СообщитьОбОшибке("Период:" + ДатаПериода + " не существует");
        Возврат;
    КонецЕсли;

    // Подготовка сессии на сервере:
    //   - расчёт количества потоков;
    //   - разбиение мандатов на партиции;
    //   - запуск фоновых заданий;
    //   - возврат описания сессии (список ИД заданий, имя задания, адрес хранилища).
    ОписаниеСессии = ПодготовитьИЗапуститьПараллельныеЗадания();

    Если ОписаниеСессии = Неопределено Тогда
        // Подготовка не удалась или нет мандатов — серверная часть уже показала сообщение
        Возврат;
    КонецЕсли;

    // Если сервер решил идти синхронным путём — он сам всё посчитал и вернул признак
    Если ОписаниеСессии.РежимСинхронный Тогда
        ОбновитьРеглОперацииНаСервере();
        РазвернутьДерево("ДеревоРеглОпераций");
        Состояние("Выполнение регламентных операций", 100);
        Возврат;
    КонецЕсли;

    // Ждём завершения всех партиций. Сервер сам ретранслирует сообщения пользователю.
    Картинка = БиблиотекаКартинок.ЗапуститьОтдельныйСеансДляВыполненияРегламентныхЗаданий;
    Состояние("Выполнение регламентных операций (параллельно, "
        + ОписаниеСессии.КоличествоПотоков + " поток(ов))", 0, , Картинка);

    ДождатьсяЗавершенияПараллельныхЗаданий(ОписаниеСессии);

    Состояние("Выполнение регламентных операций", 100, , Картинка);

    ОбновитьРеглОперацииНаСервере();
    РазвернутьДерево("ДеревоРеглОпераций");

КонецПроцедуры // СформироватьРегламентныеОперацииПараллельно()


// Описание: Подготавливает параллельную сессию: получает мандаты, разбивает на K партиций,
//           запускает K фоновых заданий и возвращает их идентификаторы на клиент.
//           В случае невозможности параллельного запуска (нет константы, одно ядро,
//           фон недоступен, 1 мандат) — выполняет работу синхронно и возвращает признак.
//
// Возвращаемое значение:
//   Структура - описание запущенной сессии:
//     * РежимСинхронный        - Булево   - Истина, если работа уже выполнена синхронно
//     * КоличествоПотоков      - Число    - фактическое число запущенных партиций (1..K)
//     * ИдентификаторыЗаданий  - Массив   - массив УИД запущенных фоновых заданий
//     * НаименованиеФоновогоЗадания - Строка - тег сессии (для отбора аварийных)
//     * АдресВременногоХранилища - Строка - адрес общих параметров для заданий
//   Неопределено — подготовка не удалась (сообщение пользователю уже выведено).
//
&НаСервере
Функция ПодготовитьИЗапуститьПараллельныеЗадания()

    // 1) Получаем мандаты и готовим общее временное хранилище
    СписокМандатов           = ПолучитьМандатыПоДинамическомуСписку();
    АдресХранилища           = АдресВременногоХранилища;      // реквизит формы, уст. в ПолучитьАдресВременногоХранилища
    НаименованиеЗадания      = "ФоновоеЗадание:" + ЭтаФорма.УникальныйИдентификатор;

    // Защита: адрес должен быть валидным
    Если Не ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
        ОбщегоНазначения.СообщитьОбОшибке("Ошибка подготовки данных для проведения регламентных операций.");
        Возврат Неопределено;
    КонецЕсли;

    // Нет мандатов — выходим
    Если СписокМандатов.Количество() = 0 Тогда
        ОбщегоНазначения.СообщитьОбОшибке("Нет мандатов для обработки по динамическому списку.");
        Возврат Неопределено;
    КонецЕсли;

    // 2) Определяем количество потоков (из константы + защитные ограничения)
    КоличествоПотоков = ПолучитьМаксимальноеКоличествоПараллельныхПотоков();

    ФонРазрешён = ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены();

    // Синхронный режим — если фон запрещён, или потоков <= 1, или мандат один
    Если (Не ФонРазрешён) Или КоличествоПотоков <= 1 Или СписокМандатов.Количество() = 1 Тогда
        ВыполнитьСинхронноВсеМандаты(СписокМандатов, НаименованиеЗадания);
        ОписаниеСинхр = Новый Структура;
        ОписаниеСинхр.Вставить("РежимСинхронный",             Истина);
        ОписаниеСинхр.Вставить("КоличествоПотоков",           1);
        ОписаниеСинхр.Вставить("ИдентификаторыЗаданий",       Новый Массив);
        ОписаниеСинхр.Вставить("НаименованиеФоновогоЗадания", НаименованиеЗадания);
        ОписаниеСинхр.Вставить("АдресВременногоХранилища",    АдресХранилища);
        Возврат ОписаниеСинхр;
    КонецЕсли;

    // 3) Перед запуском заданий гарантируем, что внутри партиции диспетчер пойдёт
    //    в синхронную ветку (Иначе), чтобы не плодить ещё фоновые задания.
    //    Для этого в общем хранилище выставим КоличествоПотоков = 0 и перепишем его
    //    под тем же УИД, что ЭтаФорма.УникальныйИдентификатор.
    ПерезаписатьКоличествоПотоковВХранилище(АдресХранилища, 0, ЭтаФорма.УникальныйИдентификатор);

    // 4) Разбиваем мандаты на K партиций (round-robin — равномернее по «весу»)
    ФактическоеЧислоПотоков = Мин(КоличествоПотоков, СписокМандатов.Количество());
    Партиции                = РазделитьМандатыНаПартиции(СписокМандатов, ФактическоеЧислоПотоков);

    // 5) Запускаем по одному фоновому заданию на партицию
    ИдентификаторыЗаданий = Новый Массив;

    Для Каждого Партиция Из Партиции Цикл

        Если Партиция.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;

        МассивПараметров = Новый Массив;
        МассивПараметров.Добавить(ДатаПериода);                             // Дата
        МассивПараметров.Добавить(Партиция);                                 // Массив: СправочникСсылка.Мандаты
        МассивПараметров.Добавить(АдресХранилища);                           // Строка: адрес хранилища
        МассивПараметров.Добавить(НаименованиеЗадания);                      // Строка: тег сессии
        МассивПараметров.Добавить(ЭтаФорма.УникальныйИдентификатор);         // УИД: владелец хранилища

        ТекЗадание = ФоновыеЗадания.Выполнить(
            "ФоновыеЗаданияСервер.СформироватьПартициюМандатов",
            МассивПараметров, ,
            НаименованиеЗадания);

        ИдентификаторыЗаданий.Добавить(ТекЗадание.УникальныйИдентификатор);

    КонецЦикла;

    Описание = Новый Структура;
    Описание.Вставить("РежимСинхронный",             Ложь);
    Описание.Вставить("КоличествоПотоков",           ИдентификаторыЗаданий.Количество());
    Описание.Вставить("ИдентификаторыЗаданий",       ИдентификаторыЗаданий);
    Описание.Вставить("НаименованиеФоновогоЗадания", НаименованиеЗадания);
    Описание.Вставить("АдресВременногоХранилища",    АдресХранилища);

    Возврат Описание;

КонецФункции


// Описание: Синхронный fallback — проходит по всем мандатам в текущем серверном вызове.
//           Используется, если фон недоступен или количество потоков <= 1.
//
// Параметры:
//   СписокМандатов       - Массив - массив СправочникСсылка.Мандаты
//   НаименованиеЗадания  - Строка - тег сессии (для совместимости с диспетчером)
//
&НаСервере
Процедура ВыполнитьСинхронноВсеМандаты(СписокМандатов, НаименованиеЗадания)

    // В синхронном режиме гарантируем, что диспетчер не запустит доп. фон
    ПерезаписатьКоличествоПотоковВХранилище(АдресВременногоХранилища, 0, ЭтаФорма.УникальныйИдентификатор);

    ТекЗнач = 0;
    МаксЗнач = СписокМандатов.Количество();

    Для Каждого ТекМандат Из СписокМандатов Цикл
        ТекЗнач = ТекЗнач + 1;
        Справочники.РегламентныеПериоды.СформироватьДокументыЗакрытияПериода(
            ДатаПериода, ТекМандат, АдресВременногоХранилища,
            НаименованиеЗадания, МаксЗнач, ТекЗнач,
            ЭтаФорма.УникальныйИдентификатор);
    КонецЦикла;

КонецПроцедуры


// Описание: Возвращает количество потоков из константы.
//           Если константа отсутствует в метаданных или значение некорректно — вернёт 0.
//
// Возвращаемое значение:
//   Число - значение константы, приведённое к неотрицательному целому.
//
&НаСервереБезКонтекста
Функция ПолучитьМаксимальноеКоличествоПараллельныхПотоков()

    МетаКонстанта = Метаданные.Константы.Найти("МаксимальноеКоличествоПараллельныхПотоков");
    Если МетаКонстанта = Неопределено Тогда
        // Константа не определена в конфигурации — считаем, что параллелизм выключен
        Возврат 0;
    КонецЕсли;

    Значение = Константы.МаксимальноеКоличествоПараллельныхПотоков.Получить();
    Если ТипЗнч(Значение) <> Тип("Число") Или Значение < 0 Тогда
        Возврат 0;
    КонецЕсли;

    Возврат Цел(Значение);

КонецФункции


// Описание: Разбивает массив мандатов на K партиций по round-robin-правилу.
//           Round-robin выбран как более равномерный в случае неравномерного «веса» мандатов.
//
// Параметры:
//   СписокМандатов - Массив - исходный массив мандатов (СправочникСсылка.Мандаты)
//   КоличествоПартиций - Число - сколько партиций создать (>=1)
//
// Возвращаемое значение:
//   Массив - массив из Массив (партиции); длина = КоличествоПартиций.
//
&НаСервереБезКонтекста
Функция РазделитьМандатыНаПартиции(СписокМандатов, КоличествоПартиций)

    Результат = Новый Массив;
    Для Индекс = 1 По КоличествоПартиций Цикл
        Результат.Добавить(Новый Массив);
    КонецЦикла;

    Индекс = 0;
    Для Каждого Мандат Из СписокМандатов Цикл
        НомерПартиции = Индекс % КоличествоПартиций;
        Результат[НомерПартиции].Добавить(Мандат);
        Индекс = Индекс + 1;
    КонецЦикла;

    Возврат Результат;

КонецФункции


// Описание: Переписывает поле КоличествоПотоков в уже существующем временном хранилище.
//           Нужно чтобы внутри фоновых заданий диспетчер СформироватьДокументыЗакрытияПериода
//           шёл в синхронную ветку (Иначе) и не плодил ещё фоновые задания.
//
// Параметры:
//   АдресХранилища  - Строка - адрес временного хранилища
//   НовоеЗначение   - Число  - новое значение КоличествоПотоков
//   УИД             - УникальныйИдентификатор - владелец хранилища (обычно УИД формы)
//
&НаСервереБезКонтекста
Процедура ПерезаписатьКоличествоПотоковВХранилище(АдресХранилища, НовоеЗначение, УИД)

    ПараметрыСохранения = ПолучитьИзВременногоХранилища(АдресХранилища);
    Если ТипЗнч(ПараметрыСохранения) <> Тип("Структура") Тогда
        Возврат;
    КонецЕсли;

    ПараметрыСохранения.КоличествоПотоков = НовоеЗначение;
    ПоместитьВоВременноеХранилище(ПараметрыСохранения, УИД);

КонецПроцедуры


// Описание: Блокирует клиент до завершения всех фоновых заданий партиций, собирает
//           пользовательские сообщения из каждого задания и ретранслирует в текущий сеанс.
//           Также выводит ошибки аварийно завершённых заданий.
//
// Параметры:
//   ОписаниеСессии - Структура - то, что вернула ПодготовитьИЗапуститьПараллельныеЗадания
//
&НаКлиенте
Процедура ДождатьсяЗавершенияПараллельныхЗаданий(ОписаниеСессии)

    // На клиенте только оркестрация — ожидание делает сервер,
    // потому что ФоновыеЗадания.ОжидатьЗавершения доступно только на сервере.
    ОжидатьЗавершенияНаСервере(ОписаниеСессии.НаименованиеФоновогоЗадания);

КонецПроцедуры


// Описание: Серверная часть ожидания — снимает сообщения и ошибки по всем заданиям сессии.
//
// Параметры:
//   НаименованиеЗадания - Строка - тег сессии, по которому ищутся задания
//
&НаСервере
Процедура ОжидатьЗавершенияНаСервере(НаименованиеЗадания)

    // Все задания сессии — и завершённые, и активные
    ПараметрыОтбора = Новый Структура("Наименование", НаименованиеЗадания);
    ВсеЗадания      = ФоновыеЗадания.ПолучитьФоновыеЗадания(ПараметрыОтбора);

    Если ВсеЗадания.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ФоновыеЗадания.ОжидатьЗавершения(ВсеЗадания);

    // Ретранслируем пользовательские сообщения
    Для Каждого ТекЗадание Из ВсеЗадания Цикл
        МассивСообщений = ТекЗадание.ПолучитьСообщенияПользователю(Истина);
        Если МассивСообщений <> Неопределено Тогда
            Для Каждого ТекСообщение Из МассивСообщений Цикл
                ТекСообщение.Сообщить();
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;

    // Отдельно показываем ошибки аварийно завершённых
    ПараметрыАварий = Новый Структура("Наименование, Состояние",
        НаименованиеЗадания, СостояниеФоновогоЗадания.ЗавершеноАварийно);
    АварийныеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(ПараметрыАварий);
    Для Каждого ТекАварийное Из АварийныеЗадания Цикл
        Информация = ТекАварийное.ИнформацияОбОшибке;
        Если Информация <> Неопределено И Информация.Причина <> Неопределено Тогда
            Сообщить("Партиция " + ТекАварийное.УникальныйИдентификатор
                + ": " + Информация.Причина.Описание);
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры



