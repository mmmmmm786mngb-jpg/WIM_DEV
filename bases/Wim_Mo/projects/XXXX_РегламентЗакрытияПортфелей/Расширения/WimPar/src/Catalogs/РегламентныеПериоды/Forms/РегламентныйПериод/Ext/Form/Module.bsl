////////////////////////////////////////////////////////////////////////////////
// Расширение формы Справочник.РегламентныеПериоды.Форма.РегламентныйПериод.
//
// Добавляет команду "Создать операции (параллельно)" — формирование регламентных
// документов по мандатам периода с разбиением на K партиций и параллельным
// запуском через ФоновыеЗадания.Выполнить().
//
// Управление пулом:
//   Количество потоков задаётся в Константе.WimPar_МаксимальноеКоличествоПараллельныхПотоков.
//   Если константа = 0 или 1, фон запрещён, или мандат в выборке один —
//   работа выполняется синхронно в рамках текущего серверного вызова.
//
// Защита от "фонового внутри фонового":
//   Перед запуском фоновых заданий в общем временном хранилище принудительно
//   устанавливается КоличествоПотоков = 0, поэтому внутри каждого ФЗ диспетчер
//   Справочники.РегламентныеПериоды.СформироватьДокументыЗакрытияПериода
//   уходит в синхронную ветку и не плодит дополнительных ФЗ.
//
// Совместимость:
//   Требуется CompatibilityMode ≥ 8.3.21 в основной конфигурации.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиКомандФормы

// Описание: Обработчик команды "Создать операции (параллельно)".
//   Запускает серверную подготовку сессии, а затем ожидает завершения ФЗ
//   (или сразу возвращает результат синхронного режима).
//
// Параметры:
//   Команда - КомандаФормы - команда, с которой пришёл вызов.
//
&НаКлиенте
Процедура WimPar_СформироватьПараллельно(Команда)
	
	ОчиститьСообщения();
	
	ОписаниеСессии = WimPar_ПодготовитьПараллельнуюСессию();
	Если ОписаниеСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОписаниеСессии.Режим = "Синхронный" Тогда
		WimPar_ОбновитьИнтерфейсПослеЗавершения();
		Сообщить("WimPar: синхронное закрытие завершено, обработано мандатов = "
			+ ОписаниеСессии.КоличествоМандатов + ".");
		Возврат;
	КонецЕсли;
	
	Результат = WimPar_ОжидатьЗавершенияНаСервере(ОписаниеСессии.ИдентификаторыЗаданий);
	
	Для Каждого Сообщение Из Результат.Сообщения Цикл
		Сообщить(Сообщение);
	КонецЦикла;
	Для Каждого ОписаниеОшибки Из Результат.ОписаниеОшибок Цикл
		Сообщить(ОписаниеОшибки);
	КонецЦикла;
	
	WimPar_ОбновитьИнтерфейсПослеЗавершения();
	
	Если Результат.СОшибкой > 0 Тогда
		Сообщить("WimPar: параллельное закрытие завершилось с ошибками: "
			+ Результат.СОшибкой + " из " + Результат.Завершено + " партиций.");
	Иначе
		Сообщить("WimPar: параллельное закрытие завершено. Успешно: "
			+ Результат.Успешно + " партиций (потоков: "
			+ ОписаниеСессии.КоличествоПартиций + ", мандатов: "
			+ ОписаниеСессии.КоличествоМандатов + ").");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедурыПараллельногоЗапуска

// Описание: Серверная подготовка параллельной сессии.
//   1) Валидирует выбранную дату и существование периода.
//   2) Получает список мандатов через штатный метод
//      Справочники.Мандаты.СписокМандатовПоДинамическомуСписку.
//   3) Готовит временное хранилище через штатный метод
//      Справочники.РегламентныеПериоды.ПолучитьАдресВременногоХранилища.
//   4) Решает, запускать ли параллель (есть константа и её значение ≥ 2,
//      фоновые разрешены, мандатов больше одного).
//   5) Если параллель невозможна — выполняет обработку синхронно и
//      возвращает структуру с Режим = "Синхронный".
//   6) Иначе — делит мандаты на партиции и запускает
//      ФоновыеЗадания.Выполнить("WimPar_ПараллельноеВыполнение.СформироватьПартициюМандатов").
//
// Возвращаемое значение:
//   Структура / Неопределено:
//     * Режим                  - Строка  - "Синхронный" / "Параллельный".
//     * ИдентификаторыЗаданий  - Массив  - УникальныйИдентификатор каждого ФЗ.
//     * АдресХранилища         - Строка  - адрес общего временного хранилища.
//     * КоличествоПартиций     - Число.
//     * КоличествоМандатов     - Число.
//   Неопределено — выполнение прервано по причине валидации (сообщение выведено).
//
&НаСервере
Функция WimPar_ПодготовитьПараллельнуюСессию()
	
	Если Не ЗначениеЗаполнено(ДатаПериода) Тогда
		Сообщить("Сначала укажите дату регламентного периода.");
		Возврат Неопределено;
	КонецЕсли;
	
	РеглПериод = Справочники.РегламентныеПериоды.ПериодПоДате(ДатаПериода);
	Если РеглПериод.Пустая() Тогда
		Сообщить("Период: " + Строка(ДатаПериода) + " не существует.");
		Возврат Неопределено;
	КонецЕсли;
	
	СписокМандатов = Справочники.Мандаты.СписокМандатовПоДинамическомуСписку(ДатаПериода, Мандаты);
	Если СписокМандатов.Количество() = 0 Тогда
		Сообщить("Нет мандатов для обработки.");
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйАдрес = Справочники.РегламентныеПериоды.ПолучитьАдресВременногоХранилища(
		РеглПериод,
		СписокМандатов,
		РеквизитФормыВЗначение("ДеревоРеглОпераций"),
		ГруппаРегламентныхОпераций,
		ЭтаФорма.УникальныйИдентификатор);
	
	Если Не ЭтоАдресВременногоХранилища(НовыйАдрес) Тогда
		Сообщить("Ошибка подготовки данных для проведения регламентных операций.");
		Возврат Неопределено;
	КонецЕсли;
	
	АдресВременногоХранилища = НовыйАдрес;
	НаименованиеЗадания      = "WimPar: параллельное закрытие " + Строка(РеглПериод);
	
	КоличествоПотоков = WimPar_ПараллельноеВыполнение.ПолучитьКоличествоПотоков();
	ФонДоступен       = WimPar_ПараллельноеВыполнение.ФоновыеЗаданияРазрешены();
	
	Если (Не ФонДоступен) Или КоличествоПотоков <= 1 Или СписокМандатов.Количество() = 1 Тогда
		WimPar_ВыполнитьСинхронноВсеМандаты(СписокМандатов, НовыйАдрес, НаименованиеЗадания);
		Возврат Новый Структура(
			"Режим, ИдентификаторыЗаданий, АдресХранилища, КоличествоПартиций, КоличествоМандатов",
			"Синхронный", Новый Массив(), НовыйАдрес, 1, СписокМандатов.Количество());
	КонецЕсли;
	
	// Защита от "фонового внутри фонового": во внутренних вызовах диспетчера
	// КоличествоПотоков должно быть 0, чтобы он ушёл в синхронную ветку.
	WimPar_ПараллельноеВыполнение.ПерезаписатьКоличествоПотоковВХранилище(
		НовыйАдрес, 0, ЭтаФорма.УникальныйИдентификатор);
	
	Партиции = WimPar_ПараллельноеВыполнение.РазделитьМандатыНаПартиции(
		СписокМандатов, КоличествоПотоков);
	
	ИдентификаторыЗаданий = Новый Массив();
	
	Для НомерПартиции = 0 По Партиции.ВГраница() Цикл
		
		Если Партиции[НомерПартиции].Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПартиции = НаименованиеЗадания + " [" + (НомерПартиции + 1) + "]";
		
		МассивПараметров = Новый Массив();
		МассивПараметров.Добавить(ДатаПериода);
		МассивПараметров.Добавить(Партиции[НомерПартиции]);
		МассивПараметров.Добавить(НовыйАдрес);
		МассивПараметров.Добавить(ИмяПартиции);
		МассивПараметров.Добавить(ЭтаФорма.УникальныйИдентификатор);
		
		ТекЗадание = ФоновыеЗадания.Выполнить(
			"WimPar_ПараллельноеВыполнение.СформироватьПартициюМандатов",
			МассивПараметров,
			,
			ИмяПартиции);
		
		ИдентификаторыЗаданий.Добавить(ТекЗадание.УникальныйИдентификатор);
		
	КонецЦикла;
	
	Возврат Новый Структура(
		"Режим, ИдентификаторыЗаданий, АдресХранилища, КоличествоПартиций, КоличествоМандатов",
		"Параллельный", ИдентификаторыЗаданий, НовыйАдрес,
		ИдентификаторыЗаданий.Количество(), СписокМандатов.Количество());
	
КонецФункции

// Описание: Синхронный проход по всему списку мандатов.
//   Используется как fallback, если параллель невозможна (фон запрещён,
//   потоков <= 1, мандат один).
//
// Параметры:
//   СписокМандатов      - СписокЗначений - элементы = СправочникСсылка.Мандаты.
//   АдресХранилища      - Строка         - адрес временного хранилища сессии.
//   НаименованиеЗадания - Строка         - имя сессии для диспетчера.
//
&НаСервере
Процедура WimPar_ВыполнитьСинхронноВсеМандаты(СписокМандатов, АдресХранилища, НаименованиеЗадания)
	
	WimPar_ПараллельноеВыполнение.ПерезаписатьКоличествоПотоковВХранилище(
		АдресХранилища, 0, ЭтаФорма.УникальныйИдентификатор);
	
	МаксимальноеЗначение = СписокМандатов.Количество();
	ТекущееЗначение      = 0;
	
	Для Каждого ЭлементСписка Из СписокМандатов Цикл
		
		ТекущееЗначение = ТекущееЗначение + 1;
		
		Справочники.РегламентныеПериоды.СформироватьДокументыЗакрытияПериода(
			ДатаПериода,
			ЭлементСписка.Значение,
			АдресХранилища,
			НаименованиеЗадания,
			МаксимальноеЗначение,
			ТекущееЗначение,
			ЭтаФорма.УникальныйИдентификатор);
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Серверный безконтекстный вызов, ожидающий завершения пакета ФЗ
//   и собирающий их сообщения/ошибки. Делегирует всё в общий модуль
//   WimPar_ПараллельноеВыполнение.ОжидатьЗавершенияЗаданий.
//
// Параметры:
//   ИдентификаторыЗаданий - Массив - УникальныйИдентификатор каждого ФЗ сессии.
//
// Возвращаемое значение:
//   Структура - см. WimPar_ПараллельноеВыполнение.ОжидатьЗавершенияЗаданий.
//
&НаСервереБезКонтекста
Функция WimPar_ОжидатьЗавершенияНаСервере(ИдентификаторыЗаданий)
	
	Возврат WimPar_ПараллельноеВыполнение.ОжидатьЗавершенияЗаданий(ИдентификаторыЗаданий);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

// Описание: Обновляет интерфейс формы после завершения работы —
//   перечитывает дерево регламентных операций и разворачивает его.
//   Если соответствующая серверная/клиентская процедура формы
//   переименована или недоступна — молча выходим.
//
&НаКлиенте
Процедура WimPar_ОбновитьИнтерфейсПослеЗавершения()
	
	Попытка
		ОбновитьРеглОперацииНаСервере();
	Исключение
		// Если базовая процедура переименована — молча пропускаем.
	КонецПопытки;
	
	Попытка
		РазвернутьДерево("ДеревоРеглОпераций");
	Исключение
		// То же — если функция недоступна в этой сборке.
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
