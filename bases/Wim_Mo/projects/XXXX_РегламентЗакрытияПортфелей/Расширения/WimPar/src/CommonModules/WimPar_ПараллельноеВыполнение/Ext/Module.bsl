////////////////////////////////////////////////////////////////////////////////
// Общий модуль WimPar_ПараллельноеВыполнение.
//
// Назначение:
//   Серверная логика параллельного формирования регламентных операций по
//   мандатам. Вызывается из модуля формы Справочник.РегламентныеПериоды.Форма.РегламентныйПериод.
//
// Точки входа:
//   * ПолучитьКоличествоПотоков() — чтение константы расширения.
//   * ФоновыеЗаданияРазрешены()   — проверка возможности запускать ФЗ в сеансе.
//   * РазделитьМандатыНаПартиции(Список, K) — round-robin-разбиение.
//   * ПерезаписатьКоличествоПотоковВХранилище(Адрес, Значение, УИД) —
//     защита от "фонового внутри фонового": принудительно ставим КоличествоПотоков=0.
//   * СформироватьПартициюМандатов(ДатаПериода, Партиция, АдресХранилища,
//     НаименованиеЗадания, УИД) — тело фонового задания.
//   * ОжидатьЗавершенияЗаданий(ИдентификаторыЗаданий) — ожидание и сбор
//     сообщений/ошибок с пакета фоновых заданий.
//
// Совместимость:
//   Для корректной работы расширения требуется CompatibilityMode ≥ 8.3.21 в
//   основной конфигурации (общие модули — с 8.3.9, константы — с 8.3.16,
//   UI-расширение формы — с 8.3.11; целевой ориентир — 8.3.21+).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описание: Возвращает количество потоков для параллельного запуска.
//   Читает значение из Константы.WimPar_МаксимальноеКоличествоПараллельныхПотоков.
//   Если константа отсутствует в метаданных (например, при переносе в основную
//   конфигурацию имя изменится), либо значение не число — возвращает 0, и
//   вызывающий код уходит в синхронный режим.
//
// Возвращаемое значение:
//   Число - неотрицательное целое количество потоков (0 или 1 — синхронный режим).
//
Функция ПолучитьКоличествоПотоков() Экспорт
	
	МетаКонстанта = Метаданные.Константы.Найти("WimPar_МаксимальноеКоличествоПараллельныхПотоков");
	Если МетаКонстанта = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Значение = Константы.WimPar_МаксимальноеКоличествоПараллельныхПотоков.Получить();
	Если ТипЗнч(Значение) <> Тип("Число") Или Значение < 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Цел(Значение);
	
КонецФункции

// Описание: Проверяет, разрешены ли фоновые задания в текущем сеансе.
//   Делегирует в существующий общий модуль основной конфигурации
//   ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены(), который уже учитывает
//   файловый/серверный режим базы и настройки разделителей.
//
// Возвращаемое значение:
//   Булево - Истина, если ФЗ можно запускать.
//
Функция ФоновыеЗаданияРазрешены() Экспорт
	
	Возврат ФоновыеЗаданияСервер.ФоновыеЗаданияРазрешены();
	
КонецФункции

// Описание: Делит список мандатов на K партиций round-robin-методом.
//   Round-robin выбран сознательно — он даёт более равномерную нагрузку при
//   неравномерном "весе" мандатов (у разных мандатов разное число документов,
//   а последовательное разбиение может посадить все тяжёлые в одну партицию).
//
// Параметры:
//   СписокМандатов    - СписокЗначений или Массив - элементы = СправочникСсылка.Мандаты
//                       (для СписокЗначений используется .Значение).
//   КоличествоПотоков - Число - желаемое количество партиций (K >= 1).
//
// Возвращаемое значение:
//   Массив - массив партиций; каждая партиция — Массив элементов СправочникСсылка.Мандаты.
//
Функция РазделитьМандатыНаПартиции(СписокМандатов, Знач КоличествоПотоков) Экспорт
	
	Если КоличествоПотоков < 1 Тогда
		КоличествоПотоков = 1;
	КонецЕсли;
	
	ФактическоеЧисло = Мин(КоличествоПотоков, СписокМандатов.Количество());
	Если ФактическоеЧисло < 1 Тогда
		ФактическоеЧисло = 1;
	КонецЕсли;
	
	Результат = Новый Массив();
	Для Индекс = 1 По ФактическоеЧисло Цикл
		Результат.Добавить(Новый Массив());
	КонецЦикла;
	
	Индекс = 0;
	Для Каждого ЭлементСписка Из СписокМандатов Цикл
		
		Если ТипЗнч(ЭлементСписка) = Тип("ЭлементСпискаЗначений") Тогда
			Значение = ЭлементСписка.Значение;
		Иначе
			Значение = ЭлементСписка;
		КонецЕсли;
		
		НомерПартиции = Индекс % ФактическоеЧисло;
		Результат[НомерПартиции].Добавить(Значение);
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Переписывает поле КоличествоПотоков в уже существующем временном
//   хранилище, чтобы диспетчер Справочники.РегламентныеПериоды.СформироватьДокументыЗакрытияПериода
//   внутри каждого фонового задания уходил в синхронную ветку и не плодил
//   ещё один пул ФЗ ("фоновое внутри фонового").
//
// Параметры:
//   АдресХранилища - Строка                  - адрес временного хранилища сессии.
//   НовоеЗначение  - Число                   - новое значение поля КоличествоПотоков.
//   УИД            - УникальныйИдентификатор - владелец хранилища (обычно УИД формы-инициатора).
//
Процедура ПерезаписатьКоличествоПотоковВХранилище(АдресХранилища, Знач НовоеЗначение, УИД) Экспорт
	
	Если Не ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСохранения = ПолучитьИзВременногоХранилища(АдресХранилища);
	Если ТипЗнч(ПараметрыСохранения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыСохранения.Свойство("КоличествоПотоков") Тогда
		ПараметрыСохранения.КоличествоПотоков = НовоеЗначение;
	Иначе
		ПараметрыСохранения.Вставить("КоличествоПотоков", НовоеЗначение);
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(ПараметрыСохранения, УИД);
	
КонецПроцедуры

// Описание: Тело фонового задания для параллельной обработки партиции мандатов.
//   Последовательно обходит все мандаты партиции и вызывает существующий
//   диспетчер Справочники.РегламентныеПериоды.СформироватьДокументыЗакрытияПериода().
//   Диспетчер уходит в синхронную ветку, так как КоличествоПотоков в общем
//   хранилище принудительно установлен в 0 перед запуском заданий
//   (см. ПерезаписатьКоличествоПотоковВХранилище).
//
// Параметры:
//   ДатаПериода         - Дата                     - дата закрытия периода.
//   МассивМандатов      - Массив                   - партиция: элементы = СправочникСсылка.Мандаты.
//   АдресХранилища      - Строка                   - адрес общего временного хранилища.
//   НаименованиеЗадания - Строка                   - тег сессии (для совместимости с диспетчером).
//   УИД                 - УникальныйИдентификатор  - владелец хранилища (УИД формы-инициатора).
//
// Пример:
//   ФоновыеЗадания.Выполнить(
//       "WimPar_ПараллельноеВыполнение.СформироватьПартициюМандатов",
//       МассивПараметров, ,
//       НаименованиеЗадания);
//
Процедура СформироватьПартициюМандатов(ДатаПериода, МассивМандатов,
		АдресХранилища, НаименованиеЗадания, УИД) Экспорт
	
	МаксимальноеЗначение = МассивМандатов.Количество();
	ТекЗначение          = 0;
	
	Для Каждого ТекМандат Из МассивМандатов Цикл
		
		ТекЗначение = ТекЗначение + 1;
		
		Справочники.РегламентныеПериоды.СформироватьДокументыЗакрытияПериода(
			ДатаПериода,
			ТекМандат,
			АдресХранилища,
			НаименованиеЗадания,
			МаксимальноеЗначение,
			ТекЗначение,
			УИД);
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Ожидает завершения пакета фоновых заданий и собирает
//   пользовательские сообщения и описания ошибок по каждому заданию.
//   Вызывается из клиентской части формы через серверную обёртку.
//
// Параметры:
//   ИдентификаторыЗаданий - Массив - УникальныйИдентификатор каждого ФЗ сессии.
//
// Возвращаемое значение:
//   Структура:
//     * Сообщения       - Массив - тексты пользовательских сообщений (Сообщение.Текст).
//     * ОписаниеОшибок  - Массив - строки описания ошибок аварийных заданий.
//     * Успешно         - Число  - количество заданий, завершившихся без ошибок.
//     * СОшибкой        - Число  - количество заданий, завершившихся с ошибкой.
//     * Завершено       - Число  - общее количество проверенных заданий.
//
Функция ОжидатьЗавершенияЗаданий(ИдентификаторыЗаданий) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Сообщения",      Новый Массив());
	Результат.Вставить("ОписаниеОшибок", Новый Массив());
	Результат.Вставить("Успешно",        0);
	Результат.Вставить("СОшибкой",       0);
	Результат.Вставить("Завершено",      0);
	
	Если ТипЗнч(ИдентификаторыЗаданий) <> Тип("Массив") Или ИдентификаторыЗаданий.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	СобранныеЗадания = Новый Массив();
	Для Каждого УИДЗадания Из ИдентификаторыЗаданий Цикл
		
		ТекЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(УИДЗадания);
		Если ТекЗадание <> Неопределено Тогда
			СобранныеЗадания.Добавить(ТекЗадание);
		КонецЕсли;
		
	КонецЦикла;
	
	Если СобранныеЗадания.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ФоновыеЗадания.ОжидатьЗавершения(СобранныеЗадания);
	
	Для Каждого ТекЗадание Из СобранныеЗадания Цикл
		
		Результат.Завершено = Результат.Завершено + 1;
		
		МассивСообщений = ТекЗадание.ПолучитьСообщенияПользователю(Истина);
		Если МассивСообщений <> Неопределено Тогда
			Для Каждого ТекСообщение Из МассивСообщений Цикл
				Результат.Сообщения.Добавить(ТекСообщение.Текст);
			КонецЦикла;
		КонецЕсли;
		
		Если ТекЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			
			Результат.СОшибкой = Результат.СОшибкой + 1;
			
			Информация = ТекЗадание.ИнформацияОбОшибке;
			Если Информация <> Неопределено И Информация.Причина <> Неопределено Тогда
				Результат.ОписаниеОшибок.Добавить("Партиция " + Строка(ТекЗадание.УникальныйИдентификатор)
					+ ": " + Информация.Причина.Описание);
			Иначе
				Результат.ОписаниеОшибок.Добавить("Партиция " + Строка(ТекЗадание.УникальныйИдентификатор)
					+ ": аварийное завершение без описания.");
			КонецЕсли;
			
		Иначе
			Результат.Успешно = Результат.Успешно + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
