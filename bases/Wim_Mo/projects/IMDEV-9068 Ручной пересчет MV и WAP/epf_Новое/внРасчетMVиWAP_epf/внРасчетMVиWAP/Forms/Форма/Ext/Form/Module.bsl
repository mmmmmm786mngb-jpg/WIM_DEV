&НаСервере
Процедура ЗаполнитьНаСервере()
	Модуль = РеквизитФормыВЗначение("Объект");
	Модуль.Заполнить();
	
	ЗначениеВРеквизитФормы(Модуль, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПериодРасчета()
	
	Если Не ЗначениеЗаполнено(Объект.НачДата) Или Не ЗначениеЗаполнено(Объект.КонДата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнены даты начала и окончания периода!");
		Возврат Ложь;
	КонецЕсли;
	
	Если НачалоДня(Объект.НачДата) > НачалоДня(Объект.КонДата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата начала периода не может быть больше даты окончания!");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПолучитьКоличествоДнейПериодаРасчета()
	
	Если Не ЗначениеЗаполнено(Объект.НачДата) Или Не ЗначениеЗаполнено(Объект.КонДата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнены даты начала и окончания периода!");
		Возврат 0;
	КонецЕсли;
	
	НачДатаПериода = НачалоДня(Объект.НачДата);
	КонДатаПериода = НачалоДня(Объект.КонДата);
	
	Если НачДатаПериода > КонДатаПериода Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата начала периода не может быть больше даты окончания!");
		Возврат 0;
	КонецЕсли;
	
	Возврат (КонДатаПериода - НачДатаПериода) / (24 * 60 * 60) + 1;
	
КонецФункции

&НаСервере
Процедура СформироватьНаСервере()
	
	КоличествоДней = ПолучитьКоличествоДнейПериодаРасчета();
	Если КоличествоДней = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Модуль = РеквизитФормыВЗначение("Объект");
	Модуль.СформироватьMV(Ложь, КоличествоДней, Ложь, Неопределено);
	
КонецПроцедуры // СформироватьНаСервере()

&НаКлиенте
Процедура Сформировать(Команда)
	Если Не ЭтаФорма.Объект.ПоВсем И ЭтаФорма.Объект.Мандаты.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны мандаты!");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьПериодРасчета() Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПутьДляСохраненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Если СокрЛП(Объект.ПутьДляСохранения) <> "" Тогда
		Диалог.Каталог = Объект.ПутьДляСохранения;
	КонецЕсли;
	
	Если Диалог.Выбрать() Тогда
		Объект.ПутьДляСохранения = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СохранениеОбъектов(Ключ, ТабОбъекта);
	ИмяФайла = СформироватьИмяФайла(Ключ);
	
	Попытка
		ТабОбъекта.Записать(Объект.ПутьДляСохранения + "\" + ИмяФайла,"windows-1251");
	Исключение
		Предупреждение(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ОписаниеОшибки();
КонецФункции

&НаСервере
Функция СформироватьИмяФайла(Ключ)
	Если Ключ = "Акции"  Тогда
		//e.g. AVANKOR.Equity.Trades.31JUL2015.csv
		ИмяФайла = "AVANCORE.Equity.Trades." + Врег(Формат(Объект.ДатаОтчета, "Л=en; ДФ=ddMMMyyyy"))+".csv"; 	
	ИначеЕсли Ключ = "Облигации"  Тогда
		ИмяФайла = "AVANCORE.Bond.Trades." + Врег(Формат(Объект.ДатаОтчета, "Л=en; ДФ=ddMMMyyyy"))+".csv"; 	
	КонецЕсли; 
	
	
	ИмяФайла = СтрЗаменить(ИмяФайла, """", "_");
	ИмяФайла = СтрЗаменить(ИмяФайла, "/", "_");
	ИмяФайла = СтрЗаменить(ИмяФайла, "\", "_");
	ИмяФайла = СтрЗаменить(ИмяФайла, "'", "_");
	ИмяФайла = СтрЗаменить(ИмяФайла, ":", "_");
	//ИмяФайла = СтрЗаменить(ИмяФайла, ".", "");
	ИмяФайла = СтрЗаменить(ИмяФайла, "^", "");
	ИмяФайла = СтрЗаменить(ИмяФайла, "&", "");
	ИмяФайла = СтрЗаменить(ИмяФайла, Символ(160), "");
	
	Возврат ИмяФайла;
КонецФункции


&НаСервере
Процедура СформироватьWAPНаСервере()
	
	КоличествоДней = ПолучитьКоличествоДнейПериодаРасчета();
	Если КоличествоДней = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Модуль = РеквизитФормыВЗначение("Объект");
	Модуль.СформироватьWAP(Ложь, "", КоличествоДней, Ложь, Ложь);
	Модуль.СформироватьWAP(Ложь, "", КоличествоДней, Ложь, Истина);
	
КонецПроцедуры // СформироватьWAPНаСервере()

&НаКлиенте
Процедура СформироватьWAP(Команда)
	Если Не ЭтаФорма.Объект.ПоВсем И ЭтаФорма.Объект.Мандаты.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбраны мандаты!");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьПериодРасчета() Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьWAPНаСервере();
КонецПроцедуры


