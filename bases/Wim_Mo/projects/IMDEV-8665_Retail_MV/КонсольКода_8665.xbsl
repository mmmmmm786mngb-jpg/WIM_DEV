"Текст": "ТекДата = ТекущаяДата();\r\n\u0009\u0009ТЗСтрок = Новый ТаблицаЗначений;\r\n\u0009\u0009ТЗСтрок.Колонки.Добавить(\"Мандат\");\r\n\u0009\u0009Новстр = ТЗСтрок.Добавить();\r\n\u0009\u0009Мандат = Справочники.Мандаты.НайтиПоНаименованию(\"ДУ МИИ91 (Усманова А.Ф.)\");\r\n\u0009\u0009Новстр.Мандат = Мандат;\r\n\u0009\u0009\r\n\u0009\u0009СлужебныйДок = Документы.РасчетРыночнойСтоимости.СоздатьДокумент();\r\n\u0009\u0009СлужебныйДок.Дата = НачалоДня(ТекДата) + 23 * 60 * 60 + 59 * 60 + 59;\r\n\u0009\u0009СлужебныйДок.ДополнительныеСвойства.Вставить(\"МассивМандатов\", ТЗСтрок.ВыгрузитьКолонку(\"Мандат\"));\r\n\u0009\u0009СлужебныйДок.ИнициализироватьRegExpМандат();\r\n\r\n\u0009\u0009\r\n\u0009\u0009\u0009RegExp = Неопределено;\r\n\u0009\r\n\u0009Если Не СлужебныйДок.ДополнительныеСвойства.Свойство(\"RegExpМандат\", RegExp) Тогда\r\n\u0009\u0009//СлужебныйДок.ИнициализироватьRegExpМандат();\r\n\u0009\u0009//RegExp = СлужебныйДок.ДополнительныеСвойства[\"RegExpМандат\"];\r\n\u0009КонецЕсли;\r\n\u0009\r\n\u0009СлужебныйДок.ПерезаполнитьВсеТЧ(Истина);\r\n\u0009\r\n\u0009СлужебныйДок.ПостроитьИндексПоМандатам();\r\n\u0009\r\n\u0009Док = Документы.РасчетРыночнойСтоимости.СоздатьДокумент();\r\n\u0009СлужебныйДок.КопироватьПоМандату(СлужебныйДок, Док, Мандат);\r\n\u0009\r\n\u0009\r\n\u0009Текст = \"Мандат = &Мандат \";\r\n\u0009\r\n\u0009Результат =  RegExp.Replace(Текст, \"$1 В ($2)\");\r\n\u0009Сообщить(Результат);",
