"Текст": "ТекДата = Дата(\"20260226\");\r\n\u0009\u0009ТЗСтрок = Новый ТаблицаЗначений;\r\n\u0009\u0009ТЗСтрок.Колонки.Добавить(\"Мандат\");\r\n\u0009\r\n\u0009\u0009Новстр = ТЗСтрок.Добавить();\r\n\u0009\u0009Мандат = Справочники.Мандаты.НайтиПоНаименованию(\"ДУ МИИ459 (Лукин С.А.)\");\r\n\u0009\u0009Новстр.Мандат = Мандат;\r\n\u0009\u0009\r\n\u0009\u0009Новстр = ТЗСтрок.Добавить();\r\n\u0009\u0009Мандат = Справочники.Мандаты.НайтиПоНаименованию(\"ДУ МИ16318 (Ветрова Е.Н.)\");\r\n\u0009\u0009Новстр.Мандат = Мандат;\r\n\r\n\u0009\u0009\r\n// WAP \r\n\u0009\u0009СлужебныйДок = Документы.РасчетСредневзвешеннойСтоимости.СоздатьДокумент();\r\n\u0009\u0009// Получаем данные сразу по всем мандатам\r\n\u0009\u0009СтруктураДанныхРасчета = Документы.РасчетСредневзвешеннойСтоимости.ПолучитьДанныеРасчета(\r\n\u0009\u0009\u0009ТекДата, ТЗСтрок.ВыгрузитьКолонку(\"Мандат\"));\r\n\u0009\u0009СлужебныйДок.ДополнительныеСвойства.Вставить(\"СтруктураДанныхРасчета\", СтруктураДанныхРасчета);\r\n\u0009\r\n\u0009ИмяДокумента = \"РасчетСредневзвешеннойСтоимости\";\r\n\u0009Док = Документы[ИмяДокумента].СоздатьДокумент();\r\n\u0009\r\n\u0009Док.Дата = НачалоДня(ТекДата) + 23 * 3600 + 59 * 60 + 59;\r\n\u0009Док.Мандат = Мандат;\r\n\u0009// WAP\r\n\u0009ДанныеПоМандату = Документы.РасчетСредневзвешеннойСтоимости.ПолучитьДанныеМандата(СлужебныйДок, Мандат);\r\n\u0009Если Не ДанныеПоМандату = Неопределено Тогда\r\n\u0009\u0009Док.ЗаполнитьДокумент(, ДанныеПоМандату);\r\n\u0009КонецЕсли;",
