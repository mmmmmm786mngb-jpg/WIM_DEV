	|	ВТ_АктивыСЗафиксированнымиКотировками.СчетМандата,
	|	ВТ_АктивыСЗафиксированнымиКотировками.Актив,
	|	ВТ_АктивыСЗафиксированнымиКотировками.Валюта,
	|	ВТ_АктивыСЗафиксированнымиКотировками.Количество,
	|	ВТ_АктивыСЗафиксированнымиКотировками.КотировкаУУ,
	|	ВТ_АктивыСЗафиксированнымиКотировками.ПроблемныйАктив
	|ИЗ
	|	ВТ_АктивыСЗафиксированнымиКотировками КАК ВТ_АктивыСЗафиксированнымиКотировками
	|ГДЕ
	|	НЕ ВТ_АктивыСЗафиксированнымиКотировками.ПроблемныйАктив
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_АктивыСЗафиксированнымиКотировками.СчетМандата,
	|	ВТ_АктивыСЗафиксированнымиКотировками.Актив,
	|	ВТ_КотировкиЦБПоАктивам.Валюта,
	|	ВТ_АктивыСЗафиксированнымиКотировками.Количество,
	|	ВТ_КотировкиЦБПоАктивам.ПризнаваемаяКотировка,
	|	ВТ_АктивыСЗафиксированнымиКотировками.ПроблемныйАктив
	|ИЗ
	|	ВТ_АктивыСЗафиксированнымиКотировками КАК ВТ_АктивыСЗафиксированнымиКотировками
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КотировкиЦБПоАктивам КАК ВТ_КотировкиЦБПоАктивам
	|		ПО ВТ_АктивыСЗафиксированнымиКотировками.Актив = ВТ_КотировкиЦБПоАктивам.Актив
	|ГДЕ
	|	ВТ_АктивыСЗафиксированнымиКотировками.ПроблемныйАктив";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	МандатДляКотировки = ВТБ_АлгоритмыРасчета.МандатРозничноеДУ(Мандат);
	Запрос.УстановитьПараметр("МандатДляКотировки", МандатДляКотировки);
#Удаление
	Запрос.УстановитьПараметр("Мандат", Мандат);
#КонецУдаления
#Вставка
	Запрос.УстановитьПараметр("Мандат", ОпределитьМножествоМандатов());
#КонецВставки
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(КонецДня(Дата), ВидГраницы.Включая)); 
	Запрос.УстановитьПараметр("ДатаСреза", КонецДня(Дата)); 
	Если НЕ ЗначениеЗаполнено(СчетМандата) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СчетМандата = &СчетМандата", ""); 
	Иначе
		Запрос.УстановитьПараметр("СчетМандата", СчетМандата);
	КонецЕсли; 
#Вставка
    Запрос.Текст = ЗаменитьМандатНаВ(Запрос.Текст);
#КонецВставки
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Расчет рыночной стоимости: ЗаполнитьТЧПлановыеЦБ");

	Результат = Запрос.Выполнить();

	//Заполним ТЧ
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ Выборка.ПроблемныйАктив Тогда
			ЗаполнитьЗначенияСвойств(ПлановаяПозицияПоЦеннымБумагам.Добавить(), Выборка);
		Иначе	
			НоваяСтрока = ПлановаяПозицияПоЦеннымБумагам.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			Если Выборка.Актив.ВидАктива.ПринадлежитЭлементу(ПланыВидовХарактеристик.ВидыАктивов.Облигации) Тогда
				НоваяСтрока.КотировкаУУ = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(Выборка.Актив, Дата) * Выборка.КотировкаУУ / 100;
			ИначеЕсли Выборка.Актив.ВидАктива = ПланыВидовХарактеристик.ВидыАктивов.СтруктурныеНоты Тогда
				НоваяСтрока.КотировкаУУ = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Выборка.Актив.Объект, "НоминальнаяСтоимость") * Выборка.КотировкаУУ / 100;
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла; 
	//MID-177 <--

	// Рассчитаем суммы в валюте документа
	КэшКурсов = Новый Соответствие;

	Для каждого СтрокаТЧ Из ПлановаяПозицияПоЦеннымБумагам Цикл
		Если СчетМандата <> Неопределено
			И СтрокаТЧ.СчетМандата <> СчетМандата Тогда // пересчитаем выборочно
			Продолжить;
		КонецЕсли; 
		СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.КотировкаУУ;
		Если ЗначениеЗаполнено(СтрокаТЧ.Валюта) Тогда
			Если КэшКурсов.Получить(СтрокаТЧ.Валюта) = Неопределено Тогда
				КэшКурсов.Вставить(СтрокаТЧ.Валюта, РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаТЧ.Валюта, Дата));
			КонецЕсли;
#Удаление
			ПараметрыВалютыДокумента = Новый Структура("Валюта, Курс, Кратность", Валюта, Курс, Кратность); //Курс и кратность могут быть скорректированны вручную
#КонецУдаления
#Вставка
			ВалютаДляРасчета = ?(ЗначениеЗаполнено(Валюта), Валюта, СтрокаТЧ.СчетМандата.Владелец.ВалютаМандата);
			Если Не ЗначениеЗаполнено(ВалютаДляРасчета) Тогда
				ВалютаДляРасчета = Справочники.Валюты.RUB;
			КонецЕсли;
			Если ЗначениеЗаполнено(Валюта) Тогда
				// Если валюта в шапке документа заполнена — используем Курс и Кратность из реквизитов документа
				// (они могут быть скорректированы вручную)
				КурсДляРасчета     = Курс;
				КратностьДляРасчета = Кратность;
			Иначе
				// Если валюта в шапке не заполнена — берём курс и кратность из кэша по валюте мандата
				Если КэшКурсов.Получить(ВалютаДляРасчета) = Неопределено Тогда
					КэшКурсов.Вставить(ВалютаДляРасчета, РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДляРасчета, Дата));
				КонецЕсли;
				КурсДляРасчета     = КэшКурсов[ВалютаДляРасчета].Курс;
				КратностьДляРасчета = КэшКурсов[ВалютаДляРасчета].Кратность;
			КонецЕсли;
			ПараметрыВалютыДокумента = Новый Структура("Валюта, Курс, Кратность", ВалютаДляРасчета, КурсДляРасчета, КратностьДляРасчета);				
#КонецВставки
			СтрокаТЧ.СуммаВВалютеДокумента = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СтрокаТЧ.Сумма, 
			КэшКурсов.Получить(СтрокаТЧ.Валюта),
			ПараметрыВалютыДокумента);
		Иначе	
			СтрокаТЧ.СуммаВВалютеДокумента = СтрокаТЧ.Сумма;	
		КонецЕсли; 

	КонецЦикла; 

	Если Пересчитывать Тогда
		ПересчитатьДокумент();
	КонецЕсли; 

КонецПроцедуры


