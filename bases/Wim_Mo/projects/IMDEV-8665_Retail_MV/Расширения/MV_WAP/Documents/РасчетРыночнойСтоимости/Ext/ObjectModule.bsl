	// IMAPPS-17826 --
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ПроблемныйАктив
	|ИЗ
	|	ВтЦенныеБумаги КАК ВтЦенныеБумаги
	|		ЛЕВОЕ СОЕДИНЕНИЕ втУсловияКотировки КАК втУсловияКотировки
	|		ПО ВтЦенныеБумаги.Актив = втУсловияКотировки.Актив
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОбщаяТаблицаКотировок КАК втОбщаяТаблицаКотировок
	|		ПО (втОбщаяТаблицаКотировок.Актив = втУсловияКотировки.Актив)
	|			И (втОбщаяТаблицаКотировок.Период = втУсловияКотировки.Период)
	|			И (втУсловияКотировки.Приоритет = втОбщаяТаблицаКотировок.Приоритет)";

	МандатДляКотировки = ВТБ_АлгоритмыРасчета.МандатРозничноеДУ(Мандат);
	Запрос.УстановитьПараметр("МандатДляКотировки", МандатДляКотировки);
#Удаление
	Запрос.УстановитьПараметр("Мандат", Мандат);
#КонецУдаления
#Вставка
	МандатВЗапросе = ОпределитьМножествоМандатов();
	Запрос.УстановитьПараметр("Мандат", МандатВЗапросе);
	Если ТипЗнч(МандатВЗапросе) = Тип("СправочникСсылка.Мандаты") Тогда
		МандатыКлиентВидКонтрагента = МандатВЗапросе.Клиент.ВидКонтрагента;
	Иначе // Тип = Массив мандатов
		МандатыКлиентВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо; // Массив передается только для физических лиц
	КонецЕсли;
	Запрос.УстановитьПараметр("МандатыКлиентВидКонтрагента", МандатыКлиентВидКонтрагента);
#КонецВставки
	Запрос.УстановитьПараметр("ДатаОстатков", Дата);
	Запрос.УстановитьПараметр("ММВБ", Справочники.Биржи.ПолучитьСсылку(Новый УникальныйИдентификатор("a778ebdd-0acd-11e5-8de2-7071bc6f4530"))); //IMAPPS-17826

	Если НЕ ЗначениеЗаполнено(СчетМандата) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СчетМандата = &СчетМандата", ""); 
	Иначе
		Запрос.УстановитьПараметр("СчетМандата", СчетМандата);
	КонецЕсли; 	
#Вставка
    Запрос.Текст = ЗаменитьМандатНаВ(Запрос.Текст);
#КонецВставки
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Расчет рыночной стоимости: ЗаполнитьТЧЦенныеБумаги");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ЦенныеБумаги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если Выборка.ПроблемныйАктив Тогда
			Попытка
				Если Выборка.Актив.ВидАктива.ПринадлежитЭлементу(ПланыВидовХарактеристик.ВидыАктивов.Облигации) Тогда
					Попытка
						НоваяСтрока.КотировкаУУ = Справочники.Облигации.ПолучитьНоминальнуюСтоимость(Выборка.Актив, Дата) * Выборка.КотировкаУУ / 100;
					Исключение
						Сообщить("Ошибка при расчете: " + Дата + "; " + Мандат + "; " + Выборка.Актив + "; " + ОписаниеОшибки(), СтатусСообщения.Важное);
						Прервать;
					КонецПопытки;
				ИначеЕсли Выборка.Актив.ВидАктива = ПланыВидовХарактеристик.ВидыАктивов.СтруктурныеНоты Тогда
					Попытка
						НоваяСтрока.КотировкаУУ = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Выборка.Актив.Объект, "НоминальнаяСтоимость") * Выборка.КотировкаУУ / 100;
					Исключение
						Сообщить("Ошибка при расчете: " + Дата + "; " + Мандат + "; " + Выборка.Актив + "; " + ОписаниеОшибки(), СтатусСообщения.Важное);
						Прервать;
					КонецПопытки;
				КонецЕсли;			
			Исключение
				Сообщить("Ошибка при расчете: " + Дата + "; " + Мандат + "; " + Выборка.Актив + "; " + ОписаниеОшибки(), СтатусСообщения.Важное);
				Прервать;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла; 

	// Рассчитаем суммы в валюте документа
	КэшКурсов = Новый Соответствие;

	Для каждого СтрокаТЧ Из ЦенныеБумаги Цикл
		Если СчетМандата <> Неопределено
			И СтрокаТЧ.СчетМандата <> СчетМандата Тогда // пересчитаем выборочно
			Продолжить;
		КонецЕсли; 
		СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.КотировкаУУ;
		Если ЗначениеЗаполнено(СтрокаТЧ.Валюта) Тогда
			Если КэшКурсов.Получить(СтрокаТЧ.Валюта) = Неопределено Тогда
				КэшКурсов.Вставить(СтрокаТЧ.Валюта, РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаТЧ.Валюта, Дата));
			КонецЕсли;
#Удаление
			ПараметрыВалютыДокумента = Новый Структура("Валюта, Курс, Кратность", Валюта, Курс, Кратность); //Курс и кратность могут быть скорректированны вручную
#КонецУдаления
#Вставка
			ВалютаДляРасчета = ?(ЗначениеЗаполнено(Валюта), Валюта, СтрокаТЧ.СчетМандата.Владелец.ВалютаМандата);
			Если Не ЗначениеЗаполнено(ВалютаДляРасчета) Тогда
				ВалютаДляРасчета = Справочники.Валюты.RUB;
			КонецЕсли;
			Если ЗначениеЗаполнено(Валюта) Тогда
				// Если валюта в шапке документа заполнена — используем Курс и Кратность из реквизитов документа
				// (они могут быть скорректированы вручную)
				КурсДляРасчета     = Курс;
				КратностьДляРасчета = Кратность;
			Иначе
				// Если валюта в шапке не заполнена — берём курс и кратность из кэша по валюте мандата
				Если КэшКурсов.Получить(ВалютаДляРасчета) = Неопределено Тогда
					КэшКурсов.Вставить(ВалютаДляРасчета, РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДляРасчета, Дата));
				КонецЕсли;
				КурсДляРасчета     = КэшКурсов[ВалютаДляРасчета].Курс;
				КратностьДляРасчета = КэшКурсов[ВалютаДляРасчета].Кратность;
			КонецЕсли;
			ПараметрыВалютыДокумента = Новый Структура("Валюта, Курс, Кратность", ВалютаДляРасчета, КурсДляРасчета, КратностьДляРасчета);				
#КонецВставки
			СтрокаТЧ.СуммаВВалютеДокумента = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СтрокаТЧ.Сумма, 
			КэшКурсов.Получить(СтрокаТЧ.Валюта),
			ПараметрыВалютыДокумента);
		Иначе	
			СтрокаТЧ.СуммаВВалютеДокумента = СтрокаТЧ.Сумма;	
		КонецЕсли; 

	КонецЦикла; 

	Если Пересчитывать Тогда
		ПересчитатьДокумент();
	КонецЕсли; 

КонецПроцедуры

&ИзменениеИКонтроль("ЗаполнитьТЧПлановыеЦБ")
Процедура MV_WAP_ЗаполнитьТЧПлановыеЦБ(Пересчитывать, СчетМандата)

	Если СчетМандата = Неопределено Тогда
		ПлановаяПозицияПоЦеннымБумагам.Очистить();
	Иначе
		врТаблица = ПлановаяПозицияПоЦеннымБумагам.Выгрузить();
		СтрокиУдаления = врТаблица.НайтиСтроки(Новый Структура("СчетМандата", СчетМандата)); 
		Для каждого СтрокаУдаления Из СтрокиУдаления Цикл
			врТаблица.Удалить(СтрокаУдаления);
		КонецЦикла;
		ПлановаяПозицияПоЦеннымБумагам.Загрузить(врТаблица);
	КонецЕсли; 

	//MID-177 -->		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПлановаяПозицияПоЦеннымБумагамОстатки.Мандат КАК Мандат,
	|	ПлановаяПозицияПоЦеннымБумагамОстатки.СчетМандата КАК СчетМандата,
	|	ПлановаяПозицияПоЦеннымБумагамОстатки.Актив КАК Актив,
	|	ПлановаяПозицияПоЦеннымБумагамОстатки.КоличествоОстаток
	|ПОМЕСТИТЬ ВтЦенныеБумаги
	|ИЗ
	|	РегистрНакопления.ПлановаяПозицияПоЦеннымБумагам.Остатки(
	|			&ДатаОстатков,
	|			Мандат = &Мандат
	|				И СчетМандата = &СчетМандата) КАК ПлановаяПозицияПоЦеннымБумагамОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Мандат,
	|	Актив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
#Удаление
	|	&Мандат КАК Мандат,
#КонецУдаления
	|	ЗафиксированныеКотировкиСрезПоследних.Актив КАК Актив,
	|	ЗафиксированныеКотировкиСрезПоследних.КотировкаУУ КАК КотировкаУУ,
	|	ЗафиксированныеКотировкиСрезПоследних.ВалютаУУ КАК Валюта
	|ПОМЕСТИТЬ ВтЗафиксированныеКотировки
	|ИЗ
	|	РегистрСведений.ЗафиксированныеКотировки.СрезПоследних(&ДатаОстатков, Мандат = &МандатДляКотировки) КАК ЗафиксированныеКотировкиСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
#Удаление
	|	Мандат,
#КонецУдаления
	|	Актив
	|;
