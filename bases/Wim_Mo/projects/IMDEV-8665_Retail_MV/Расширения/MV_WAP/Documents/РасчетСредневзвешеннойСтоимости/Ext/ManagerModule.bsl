// IMDEV-8665 - блок "КЕШ": отладочный запрос и делегирование выборки валют в ОбщегоНазначенияПовтИсп.

// Описание: Логирование того же запроса, что выполняется в ОбщегоНазначенияПовтИсп.ПолучитьВалютыРасчета, затем результат из кешируемой функции (Идея1 п. 3.2).
//
// Параметры:
//   ДатаСреза - Дата - дата среза для отбора настройки списка валют WAP.
//
// Возвращаемое значение:
//   Массив - валюты расчёта (колонка "Валюта").
//
&НаСервере
&Вместо("ПолучитьВалютыРасчета")
Функция MV_WAP_ПолучитьВалютыРасчета(ДатаСреза)

	Запрос = ОбщегоНазначенияПовтИсп.ЗапросПолучитьВалютыРасчета(ДатаСреза);

	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Расчет средневзвешенной стоимости: Запрос валют расчета");

	Возврат ОбщегоНазначенияПовтИсп.ПолучитьВалютыРасчета(ДатаСреза);

КонецФункции


#Область IMDEV_8665_WAP

// Описание: Строит вложенное соответствие по результату седьмого запроса пакета WAP:
// внешний ключ — мандат, внутренний — актив, значение — таблица значений со строками по счетам.
//
// Параметры:
//   РезультатЗапроса - РезультатЗапроса - результат запроса с группировкой ИТОГИ ПО Мандат, Актив.
//
// Возвращаемое значение:
//   Соответствие - Мандат -> (Соответствие: Актив -> ТаблицаЗначений детальных строк).
//
Функция MV_WAP_ПостроитьСоответствиеРезультатаWAPПоМандатамИАктивам(РезультатЗапроса)
	
	СоответствиеПоМандатам = Новый Соответствие;
	Если РезультатЗапроса = Неопределено Тогда
		Возврат СоответствиеПоМандатам;
	КонецЕсли;
	
	ВыборкаМандат = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаМандат.Следующий() Цикл
		
		МандатГруппы = ВыборкаМандат.Мандат;
		СоответствиеПоАктивам = Новый Соответствие;
		
		ВыборкаАктив = ВыборкаМандат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаАктив.Следующий() Цикл
			
			АктивГруппы = ВыборкаАктив.Актив;
			ТаблицаСчетов = Новый ТаблицаЗначений;
			ТаблицаСчетов.Колонки.Добавить("СчетМандата");
			ТаблицаСчетов.Колонки.Добавить("Актив");
			ТаблицаСчетов.Колонки.Добавить("ОстатокНаНачало");
			ТаблицаСчетов.Колонки.Добавить("ОстатокНаКонец");
			ТаблицаСчетов.Колонки.Добавить("Порядок");
			ТаблицаСчетов.Колонки.Добавить("Период");
			
			ВыборкаДетальные = ВыборкаАктив.Выбрать();
			Пока ВыборкаДетальные.Следующий() Цикл
				СтрокаТаблицы = ТаблицаСчетов.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыборкаДетальные);
			КонецЦикла;
			
			СоответствиеПоАктивам.Вставить(АктивГруппы, ТаблицаСчетов);
			
		КонецЦикла;
		
		СоответствиеПоМандатам.Вставить(МандатГруппы, СоответствиеПоАктивам);
		
	КонецЦикла;
	
	Возврат СоответствиеПоМандатам;
	
КонецФункции

// Описание: Выделяет из общей структуры расчёта WAP данные, относящиеся к одному мандату (таблицы и вложенное соответствие по активам).
//
// Параметры:
//   Служебный - Произвольный - объект с ДополнительныеСвойства.СтруктураДанныхРасчета (результат массового ПолучитьДанныеРасчета).
//   Мандат - СправочникСсылка - мандат, для которого нужны данные.
//
// Возвращаемое значение:
//   Структура - поля как у ПолучитьДанныеРасчета для одного мандата; РезультатаЗапроса — Соответствие (Актив -> ТаблицаЗначений по счетам).
//
Функция ПолучитьДанныеМандата(Служебный, Мандат) Экспорт
	
	СтруктураДанныхРасчета = Неопределено;
	Если Служебный.ДополнительныеСвойства.Свойство("СтруктураДанныхРасчета", СтруктураДанныхРасчета) И СтруктураДанныхРасчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеМандата = Новый Структура;
	
	// 1. Данные, которые не зависят от мандата
	ДанныеМандата.Вставить("ВалютыРасчета", СтруктураДанныхРасчета.ВалютыРасчета);
	ДанныеМандата.Вставить("ТаблицаКотировок", СтруктураДанныхРасчета.ТаблицаКотировок);
	
	// 2. ЭтоНачалоОтчетногоПериода (булево)
	Если ТипЗнч(СтруктураДанныхРасчета.ЭтоНачалоОтчетногоПериода) = Тип("Соответствие") Тогда
		Значение = СтруктураДанныхРасчета.ЭтоНачалоОтчетногоПериода.Получить(Мандат);
		ДанныеМандата.Вставить("ЭтоНачалоОтчетногоПериода", ?(Значение = Неопределено, Ложь, Значение));
	Иначе
		ДанныеМандата.Вставить("ЭтоНачалоОтчетногоПериода", СтруктураДанныхРасчета.ЭтоНачалоОтчетногоПериода);
	КонецЕсли;
	
	// 3. Таблицы, которые нужно фильтровать по мандату
	ДанныеМандата.Вставить("ТаблицаПредыдущихСтоимостей", 
		ОтфильтроватьТаблицуПоМандату(СтруктураДанныхРасчета.ТаблицаПредыдущихСтоимостей, Мандат));
	
	ДанныеМандата.Вставить("ТаблицаОпераций", 
		ОтфильтроватьТаблицуПоМандату(СтруктураДанныхРасчета.ТаблицаОпераций, Мандат));
	
	СоответствиеПоАктивам = Неопределено;
	Если ТипЗнч(СтруктураДанныхРасчета.РезультатаЗапроса) = Тип("Соответствие") Тогда
		СоответствиеПоАктивам = СтруктураДанныхРасчета.РезультатаЗапроса.Получить(Мандат);
	КонецЕсли;
	Если СоответствиеПоАктивам = Неопределено Тогда
		СоответствиеПоАктивам = Новый Соответствие;
	КонецЕсли;
	ДанныеМандата.Вставить("РезультатаЗапроса", СоответствиеПоАктивам);
	
	Возврат ДанныеМандата;
	
КонецФункции

// Универсальная фильтрация таблицы по мандату
Функция ОтфильтроватьТаблицуПоМандату(Знач Таблица, Знач Мандат) Экспорт
	
	Если Таблица = Неопределено Или Таблица.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	// Определяем имя колонки с мандатом
	ИмяКолонкиМандата = "";
	Если Таблица.Колонки.Найти("Мандат") <> Неопределено Тогда
		ИмяКолонкиМандата = "Мандат";
	ИначеЕсли Таблица.Колонки.Найти("СчетМандата") <> Неопределено Тогда
		ИмяКолонкиМандата = "СчетМандата";
	Иначе
		// Если колонки нет — возвращаем копию всей таблицы
		Возврат Таблица.Скопировать();
	КонецЕсли;
	
	Отбор = Новый Структура(ИмяКолонкиМандата, Мандат);
	Возврат Таблица.Скопировать(Отбор);
	
КонецФункции

#КонецОбласти

&ИзменениеИКонтроль("ПолучитьДанныеРасчета")
Функция MV_WAP_ПолучитьДанныеРасчета(Дата, Мандат)
	
#Вставка
	ЭтоМассивМандатов = ТипЗнч(Мандат) = Тип("Массив") Или ТипЗнч(Мандат) = Тип("СписокЗначений");
#КонецВставки
	
	СтруктураВозврата = Новый Структура("ВалютыРасчета, ЭтоНачалоОтчетногоПериода, ТаблицаКотировок, ТаблицаПредыдущихСтоимостей, ТаблицаОпераций, РезультатаЗапроса", 
	Новый Массив,
#Удаление
	Ложь,
#КонецУдаления
#Вставка
	?(ЭтоМассивМандатов, Новый Соответствие, Ложь),
#КонецВставки
	Новый ТаблицаЗначений,
	Новый ТаблицаЗначений,
	Новый ТаблицаЗначений,
	Неопределено); 

	//Получим действующие валюты расчета
	ВалютыРасчета = ПолучитьВалютыРасчета(Дата);

	СтруктураВозврата.ВалютыРасчета = ВалютыРасчета;
#Удаление
	Запрос = Новый Запрос(ПолучитьТекстЗапросаЗаполненияДокумента());
#КонецУдаления
#Вставка
	Запрос = Новый Запрос(ПолучитьТекстЗапросаЗаполненияДокумента());
#КонецВставки
	
	Запрос.УстановитьПараметр("ДатаСреза"	, Дата);
	Запрос.УстановитьПараметр("ДатаНачала", Новый Граница(НачалоДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаОкончания", Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
#Удаление
	МандатДляКотировки = ВТБ_АлгоритмыРасчета.МандатРозничноеДУ(Мандат);
#КонецУдаления
#Вставка
	МандатДляКотировки = ВТБ_АлгоритмыРасчета.МандатРозничноеДУ(?(ЭтоМассивМандатов, Неопределено, Мандат));
#КонецВставки
	Запрос.УстановитьПараметр("МандатДляКотировки", МандатДляКотировки);
	Запрос.УстановитьПараметр("Мандат"		, Мандат);
	Запрос.УстановитьПараметр("МассивВалют"	, ВалютыРасчета);
	Запрос.УстановитьПараметр("СчетаМандата"	, СписокСчетовВыбранногоМандата(Мандат));

	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(Запрос, "Расчет средневзвешенной стоимости: Запрос данных для расчета");

	РезультатВыполнения = Запрос.ВыполнитьПакет();

	//Определим флаг расчета WAP1
	Выборка = РезультатВыполнения[3].Выбрать();
#Удаление
	Если Выборка.Следующий()
		И ЗначениеЗаполнено(Выборка.ДатаНачалаОтчетногоПериода) Тогда
		СтруктураВозврата.ЭтоНачалоОтчетногоПериода = НачалоДня(Выборка.ДатаНачалаОтчетногоПериода) = НачалоДня(Дата);	
	КонецЕсли;
#КонецУдаления
#Вставка
	Если ЭтоМассивМандатов Тогда
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.ДатаНачалаОтчетногоПериода) Тогда
				ЗначениеФлага = НачалоДня(Выборка.ДатаНачалаОтчетногоПериода) = НачалоДня(Дата);
			Иначе
				ЗначениеФлага = Ложь;
			КонецЕсли;
			СтруктураВозврата.ЭтоНачалоОтчетногоПериода.Вставить(Выборка.Мандат, ЗначениеФлага);
		КонецЦикла;	
	Иначе
		Если Выборка.Следующий()
			И ЗначениеЗаполнено(Выборка.ДатаНачалаОтчетногоПериода) Тогда
			СтруктураВозврата.ЭтоНачалоОтчетногоПериода = НачалоДня(Выборка.ДатаНачалаОтчетногоПериода) = НачалоДня(Дата);	
		КонецЕсли;
	КонецЕсли;
#КонецВставки

	//Получим зафиксированные котировки на дату документа
	СтруктураВозврата.ТаблицаКотировок = РезультатВыполнения[5].Выгрузить();

	//Получим таблицу данных по предыдущим средневзвешенным стоимостям (по необходимым валютам)
	СтруктураВозврата.ТаблицаПредыдущихСтоимостей = РезультатВыполнения[8].Выгрузить();

	//Получим таблицу операций
	СтруктураВозврата.ТаблицаОпераций = РезультатВыполнения[6].Выгрузить();
#Удаление
	СтруктураВозврата.РезультатаЗапроса = РезультатВыполнения[7];
#КонецУдаления
#Вставка
	СоответствиеПоМандатам7 = MV_WAP_ПостроитьСоответствиеРезультатаWAPПоМандатамИАктивам(РезультатВыполнения[7]);
	Если ЭтоМассивМандатов Тогда
		СтруктураВозврата.РезультатаЗапроса = СоответствиеПоМандатам7;
	Иначе 
		СтруктураВозврата.РезультатаЗапроса = СоответствиеПоМандатам7.Получить(Мандат);
	КонецЕсли;
#КонецВставки

	Возврат СтруктураВозврата;									

КонецФункции

&Вместо("СписокСчетовВыбранногоМандата")
Функция MV_WAP_СписокСчетовВыбранногоМандата(Мандат)
	
	Запрос	= Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	      	               |	СчетаМандатов.Ссылка КАК Ссылка
	      	               |ИЗ
	      	               |	Справочник.СчетаМандатов КАК СчетаМандатов
	      	               |ГДЕ
	      	               |	СчетаМандатов.Владелец В(&Мандат)");
	Запрос.УстановитьПараметр("Мандат", Мандат);
	
	СписокСчетовМандата	= Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат СписокСчетовМандата;
	
КонецФункции

&ИзменениеИКонтроль("ПолучитьТекстЗапросаЗаполненияДокумента")
Функция MV_WAP_ПолучитьТекстЗапросаЗаполненияДокумента()

	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
#Удаление
	|	ОперацииСАктивами.СчетМандата КАК СчетМандата,
#КонецУдаления
#Вставка
	|	ОперацииСАктивами.Мандат КАК Мандат,
	|	ОперацииСАктивами.СчетМандата КАК СчетМандата,
#КонецВставки
	|	ОперацииСАктивами.Актив КАК Актив,
	|	ОперацииСАктивами.Валюта,
	|	ОперацииСАктивами.Количество,
	|	ОперацииСАктивами.Сумма,
	|	ОперацииСАктивами.Период,
	|	ОперацииСАктивами.Регистратор,
	|	ВЫБОР
	|		КОГДА ОперацииСАктивами.Регистратор ССЫЛКА Документ.ПереводМеждуСчетамиМандатов
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Порядок,
	|	ОперацииСАктивами.МоментВремени,
	|	ВЫБОР
	|		КОГДА ОперацииСАктивами.Регистратор ССЫЛКА Документ.ПереводМеждуСчетамиМандатов
	|			ТОГДА ОперацииСАктивами.Регистратор.СчетИсточник
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СчетаМандатов.ПустаяСсылка)
	|	КОНЕЦ КАК СчетИсточник
	// IMAPPS-30289 ++
	|	, ВЫБОР
	|		КОГДА ОперацииСАктивами.Регистратор ССЫЛКА Документ.Операция
	|			ТОГДА ВЫБОР
	|					КОГДА ВЫРАЗИТЬ(ОперацииСАктивами.Регистратор КАК Документ.Операция).ВидОперации = Значение(Перечисление.ВидыОпераций.Реорганизация)
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Реорганизация
	// IMAPPS-30289 --
	|ПОМЕСТИТЬ ВТ_ТаблицаОпераций
	|ИЗ
	|	РегистрНакопления.ОперацииСАктивами КАК ОперацииСАктивами
	|ГДЕ
#Удаление
	|	ОперацииСАктивами.Мандат = &Мандат
#КонецУдаления
#Вставка
	|	ОперацииСАктивами.Мандат В (&Мандат)
#КонецВставки
	|	И ОперацииСАктивами.Период МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаСреза, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаСреза, ДЕНЬ)
	|	И ОперацииСАктивами.Количество > 0
	|	И ОперацииСАктивами.Активность = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦенныеБумагиОстаткиИОбороты.Мандат КАК Мандат,
	|	ЦенныеБумагиОстаткиИОбороты.СчетМандата КАК СчетМандата,
	|	ЦенныеБумагиОстаткиИОбороты.Актив КАК Актив,
	|	ЦенныеБумагиОстаткиИОбороты.КоличествоНачальныйОстаток КАК ОстатокНаНачало,
	|	ЦенныеБумагиОстаткиИОбороты.КоличествоКонечныйОстаток КАК ОстатокНаКонец,
	|	ЦенныеБумагиОстаткиИОбороты.КоличествоРасход КАК Расход //IMAPPS-24875
	|ПОМЕСТИТЬ ВТ_ТаблицаОстатков
	|ИЗ
#Удаление
	|	РегистрНакопления.ЦенныеБумаги.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, , , Мандат = &Мандат) КАК ЦенныеБумагиОстаткиИОбороты
#КонецУдаления
#Вставка
	|	РегистрНакопления.ЦенныеБумаги.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, , , Мандат В (&Мандат)) КАК ЦенныеБумагиОстаткиИОбороты
#КонецВставки
	|ГДЕ
	|	(ЦенныеБумагиОстаткиИОбороты.КоличествоНачальныйОстаток <> 0
	|			ИЛИ ЦенныеБумагиОстаткиИОбороты.КоличествоКонечныйОстаток <> 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Актив,
	|	СчетМандата,
	|	Мандат
	|;
	|
