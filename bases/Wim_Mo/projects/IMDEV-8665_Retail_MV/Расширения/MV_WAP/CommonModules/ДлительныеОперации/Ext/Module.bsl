// IMDEV-8665: замена ЗапуститьВыполнениеВФоне (расширение, директива Вместо).
// По умолчанию: обычный канал 0.2 с вместо типовых 2 с; медленный канал 4 с без изменений.
// Дополнительно (без новых объектов метаданных): опциональные служебные ключи в Структура Параметры
// (не попадают в фоновое задание):
//   ИнтервалОжиданияПриЗапускеФонаОбычныйСек - Число > 0, секунды для обычной скорости клиента;
//   ИнтервалОжиданияПриЗапускеФонаМедленныйКаналСек - Число > 0, секунды для СкоростьКлиентскогоСоединения.Низкая.

// Описание: Запуск процедуры в фоне с коротким ожиданием первичного завершения задания (для сценариев с множеством параллельных заданий).
//
// Параметры:
//   ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы вызывающего контекста.
//   ИмяЭкспортнойПроцедуры - Строка - имя экспортной процедуры фона.
//   Параметры - Структура - параметры процедуры (опционально см. служебные ключи ИнтервалОжиданияПриЗапускеФона* выше).
//   НаименованиеЗадания - Строка - наименование фонового задания.
//   ИспользоватьДополнительноеВременноеХранилище - Булево - признак второго хранилища.
//
// Возвращаемое значение:
//   Структура - АдресХранилища, ЗаданиеВыполнено, ИдентификаторЗадания и при необходимости АдресХранилищаДополнительный.
//
&НаСервере
&Вместо("ЗапуститьВыполнениеВФоне")
Функция MV_WAP_ЗапуститьВыполнениеВФоне(Знач ИдентификаторФормы, Знач ИмяЭкспортнойПроцедуры,
	Знач Параметры, Знач НаименованиеЗадания = "", ИспользоватьДополнительноеВременноеХранилище = Ложь) Экспорт

	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);

	Если Не ЗначениеЗаполнено(НаименованиеЗадания) Тогда
		НаименованиеЗадания = ИмяЭкспортнойПроцедуры;
	КонецЕсли;

	ИнтервалОбычныйКанал = Неопределено;
	ИнтервалМедленныйКанал = Неопределено;
	ПараметрыДляФона = Параметры;

	Если ТипЗнч(Параметры) = Тип("Структура") Тогда

		ПараметрыДляФона = Новый Структура;

		Для Каждого ЭлементПараметров Из Параметры Цикл

			Если ЭлементПараметров.Ключ = "ИнтервалОжиданияПриЗапускеФонаОбычныйСек" Тогда
				Если ТипЗнч(ЭлементПараметров.Значение) = Тип("Число") И ЭлементПараметров.Значение > 0 Тогда
					ИнтервалОбычныйКанал = ЭлементПараметров.Значение;
				КонецЕсли;
				Продолжить;
			ИначеЕсли ЭлементПараметров.Ключ = "ИнтервалОжиданияПриЗапускеФонаМедленныйКаналСек" Тогда
				Если ТипЗнч(ЭлементПараметров.Значение) = Тип("Число") И ЭлементПараметров.Значение > 0 Тогда
					ИнтервалМедленныйКанал = ЭлементПараметров.Значение;
				КонецЕсли;
				Продолжить;
			Иначе
				ПараметрыДляФона.Вставить(ЭлементПараметров.Ключ, ЭлементПараметров.Значение);
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	ПараметрыЭкспортнойПроцедуры = Новый Массив;
	ПараметрыЭкспортнойПроцедуры.Добавить(ПараметрыДляФона);
	ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилища);

	Если ИспользоватьДополнительноеВременноеХранилище Тогда
		АдресХранилищаДополнительный = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
		ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилищаДополнительный);
	КонецЕсли;

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ИмяЭкспортнойПроцедуры);
	ПараметрыЗадания.Добавить(ПараметрыЭкспортнойПроцедуры);

	Если ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая Тогда
		Если ИнтервалМедленныйКанал <> Неопределено Тогда
			ВремяОжидания = ИнтервалМедленныйКанал;
		Иначе
			ВремяОжидания = 4;
		КонецЕсли;
	Иначе
		Если ИнтервалОбычныйКанал <> Неопределено Тогда
			ВремяОжидания = ИнтервалОбычныйКанал;
		Иначе
			ВремяОжидания = 0.2;
		КонецЕсли;
	КонецЕсли;

	Задание = ФоновыеЗадания.Выполнить("РаботаВБезопасномРежиме.ВыполнитьМетодКонфигурации", ПараметрыЗадания,, НаименованиеЗадания);
	Попытка
		Задание.ОжидатьЗавершения(ВремяОжидания);
	Исключение
		// Специальная обработка не требуется, возможно исключение вызвано истечением времени ожидания.
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("АдресХранилища",       АдресХранилища);
	Результат.Вставить("ЗаданиеВыполнено",     ЗаданиеВыполнено(Задание.УникальныйИдентификатор));
	Результат.Вставить("ИдентификаторЗадания", Задание.УникальныйИдентификатор);

	Если ИспользоватьДополнительноеВременноеХранилище Тогда
		Результат.Вставить("АдресХранилищаДополнительный", АдресХранилищаДополнительный);
	КонецЕсли;

	Возврат Результат;

КонецФункции
