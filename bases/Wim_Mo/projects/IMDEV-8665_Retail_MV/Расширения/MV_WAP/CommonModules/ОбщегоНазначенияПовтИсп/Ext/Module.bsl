// IMDEV-8665 - блок "КЕШ": расчётные функции с повторным использованием возвращаемых значений сеанса (DuringSession).

// Описание: Возвращает курс валюты на дату (логика перенесена из РаботаСКурсамиВалют для кеширования через модуль повторного использования).
//
// Параметры:
//   Валюта - СправочникСсылка.Валюты - валюта, для которой получается курс.
//   ДатаКурса - Дата - дата, на которую получается курс.
//   ИсточникКурса - СправочникСсылка.Биржи - источник курса валюты (необязательно).
//
// Возвращаемое значение:
//   Структура - параметры курса (Курс, Кратность, Валюта, ИсточникКурса, ДатаКурса).
//
Функция ПолучитьКурсВалюты(Валюта, ДатаКурса, ИсточникКурса = Неопределено) Экспорт

	Если ЗначениеЗаполнено(ИсточникКурса) Тогда
		Результат = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ДатаКурса, Новый Структура("Валюта, ИсточникКурса", Валюта, ИсточникКурса));
	Иначе
		Результат = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ДатаКурса, Новый Структура("Валюта", Валюта));
	КонецЕсли;

	Результат.Вставить("Валюта", Валюта);
	Результат.Вставить("ИсточникКурса", ИсточникКурса);
	Результат.Вставить("ДатаКурса", ДатаКурса);

	Возврат Результат;

КонецФункции

Процедура MV_WAP_ЗаполнитьЗапросВалютРасчета(Запрос, ДатаСреза)

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкаСпискаВалютWAPСрезПоследних.СписокВалют КАК СписокВалют
	|ПОМЕСТИТЬ ВТ_ДокументСпискаВалют
	|ИЗ
	|	РегистрСведений.НастройкаСпискаВалютWAP КАК НастройкаСпискаВалютWAPСрезПоследних
	|ГДЕ
	|	НастройкаСпискаВалютWAPСрезПоследних.Период <= &ДатаСреза
	|
	|УПОРЯДОЧИТЬ ПО
	|	НастройкаСпискаВалютWAPСрезПоследних.Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВалютыРасчетаWAPСписокВалют.Валюта
	|ИЗ
	|	Документ.ВалютыРасчетаWAP.СписокВалют КАК ВалютыРасчетаWAPСписокВалют
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументСпискаВалют КАК ВТ_ДокументСпискаВалют
	|		ПО ВалютыРасчетаWAPСписокВалют.Ссылка = ВТ_ДокументСпискаВалют.СписокВалют.Ссылка";

	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);

КонецПроцедуры

// Описание: Запрос для получения валют расчёта WAP (тот же текст и параметры, что в ПолучитьВалютыРасчета).
// Используется в менеджере документа перед ДобавитьВЛогОтладки по схеме из IMDEV-8665 (Идея1).
//
// Параметры:
//   ДатаСреза - Дата - дата среза для отбора настройки списка валют WAP.
//
// Возвращаемое значение:
//   Запрос - объект запроса с установленным текстом и параметром ДатаСреза.
//
Функция ЗапросПолучитьВалютыРасчета(ДатаСреза) Экспорт

	Запрос = Новый Запрос;
	MV_WAP_ЗаполнитьЗапросВалютРасчета(Запрос, ДатаСреза);
	Возврат Запрос;

КонецФункции

// Описание: Возвращает массив валют расчёта WAP на дату среза (логика перенесена из менеджера документа для кеширования).
//
// Параметры:
//   ДатаСреза - Дата - дата, на которую определяется список валют.
//
// Возвращаемое значение:
//   Массив - ссылки на валюты из колонки запроса "Валюта".
//
Функция ПолучитьВалютыРасчета(ДатаСреза) Экспорт

	Запрос = Новый Запрос;
	MV_WAP_ЗаполнитьЗапросВалютРасчета(Запрос, ДатаСреза);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Валюта");

КонецФункции
