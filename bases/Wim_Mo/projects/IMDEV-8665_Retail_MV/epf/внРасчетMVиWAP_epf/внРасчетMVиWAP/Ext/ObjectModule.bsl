Функция ПолучитьКурсВалюты(Знач Валюта, Знач ТекДата, КЭШ)
	Перем Запрос, Выборка, ЗначениеКурса;
	
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		ВызватьИсключение "Не указана валюта, для которой необходимо получить курс!";
	КонецЕсли;
	
	ТекДата		 = НачалоДня(ТекДата);
	КлючВалюты	 = Формат(ТекДата, "ДФ=dd.MM.yyyy; ДП=") + "_" + Прав("000" + Валюта.Код, 3);
	
	ЗначениеКурса = КЭШ[КлючВалюты];
	Если ЗначениеКурса = Неопределено Тогда
		ЗначениеКурса = Новый Структура("Период, Валюта, Курс, Кратность", Дата(1, 1, 1), ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка"), 1, 1);
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("Валюта", Валюта);
		Запрос.УстановитьПараметр("Период", ТекДата);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КурсыВалютСрез.Период КАК Период,
		|	КурсыВалютСрез.Валюта КАК Валюта,
		|	КурсыВалютСрез.Курс КАК Курс,
		|	КурсыВалютСрез.Кратность КАК Кратность
		|ИЗ
		|	РегистрСведений.КурсыВалют.СрезПоследних(
		|			&Период,
		|			Валюта = &Валюта
		|				И ИсточникКурса = ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка)) КАК КурсыВалютСрез";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗначениеКурса.Период	 = Выборка.Период;
			ЗначениеКурса.Валюта	 = Выборка.Валюта;
			ЗначениеКурса.Курс		 = Выборка.Курс;
			ЗначениеКурса.Кратность	 = Выборка.Кратность;
		Иначе
			ВызватьИсключение "Отсутствует курс валюты '" + Валюта + "' на дату " + Формат(ТекДата, "ДФ=dd.MM.yyyy; ДП=");  // сюр, конечно, но все же!
		КонецЕсли;
		
		КЭШ[КлючВалюты] = ЗначениеКурса;
	КонецЕсли;
	
	Возврат ЗначениеКурса;
	
КонецФункции // ПолучитьКурсВалюты()

// IMDEV-8665 - параллельное удаление документов расчета средневзвешенной стоимости (WAP) за день
// Описание: Удаляет документы расчета средневзвешенной стоимости за дату по мандатам (параллельное удаление через фоновые задания).
// Параметры:
// ТекДата - Дата - день удаления.
// МассивМандатов - Массив - мандаты.
// Ошибка - Булево - признак ошибки при удалении.
//
Процедура УдалитьДокументыРасчетСредневзвешеннойСтоимости(Знач ТекДата, Знач МассивМандатов, Ошибка)
	
	УдалитьДокументыФоновоУниверсально(ТекДата, МассивМандатов, "РасчетСредневзвешеннойСтоимости", Ошибка);
	
КонецПроцедуры // УдалитьДокументыРасчетСредневзвешеннойСтоимости()

// IMDEV-8665 - параллельное удаление документов расчета рыночной стоимости (MV) за день
// Описание: Удаляет документы расчета рыночной стоимости за дату по мандатам (параллельное удаление через фоновые задания).
// Параметры:
// ТекДата - Дата - день удаления.
// МассивМандатов - Массив - мандаты.
// Ошибка - Булево - признак ошибки при удалении.
//
Процедура УдалитьДокументыРасчетРыночнойСтоимости(Знач ТекДата, Знач МассивМандатов, Ошибка)
	
	УдалитьДокументыФоновоУниверсально(ТекДата, МассивМандатов, "РасчетРыночнойСтоимости", Ошибка);

КонецПроцедуры // УдалитьДокументыРасчетРыночнойСтоимости()

Функция ВыполнятьЗамерыПроизводительности()
	Возврат Константы.ВыполнятьЗамерыПроизводительности.Получить();
КонецФункции	

// IMDEV-8665 - типы мандата для режима "физлица" в запросе ТЗМандатов (I и B, в т.ч. РДУ)
Функция ТипыМандатаДляОтбораФизическихЛиц()
	
	Типы = Новый Массив;
	Типы.Добавить(Перечисления.ТипыМандата.I);
	Типы.Добавить(Перечисления.ТипыМандата.B);
	Возврат Типы;
	
КонецФункции

// IMDEV-8665 - расчет MV за период. УДАЛИТЬ ОТЛАДКУ: ПЕРВЫЕ 20 в запросе мандатов ниже - временное ограничение для отладки.
//DDneprovsky 08.10.2018 IMAPPS-6929
Процедура СформироватьMV(Ошибка = Ложь, Знач КоличествоДней = 1, Знач ОткрыватьТранзакцию = Ложь, Знач ФизЛицо = Неопределено) Экспорт
	Перем ВалютныйКЭШ;
	Перем ТекстОшибки;
	// +Artur Mingalev 14.10.2021 IMAPPS-14620
	ТмпКалендарь = ?(ЭтотОбъект.Календарь.Пустая(), Справочники.ПроизводственныеКалендари.РегламентированныйКалендарь, ЭтотОбъект.Календарь);
	// -Artur Mingalev 14.10.2021 IMAPPS-14620
	
	ИдентификаторОперации = "СформироватьMv" + Строка(КоличествоДней) + ?(ФизЛицо = Неопределено, "", ?(Истина = ФизЛицо, "Физ", "Юр")) + "Сервер";
	Если ВыполнятьЗамеры Тогда
		ВремяНачалаЗамера = ОценкаПроизводительностиКлиентСервер.НачатьЗамерВремени(ИдентификаторОперации);
	КонецЕсли;
		
	ВалютныйКЭШ = Новый Соответствие();
	
	Запрос = Новый Запрос();
	// IMDEV-8665-MV: физлица В (I,B), юрлица НЕ В (I,B); в ТЗМандатов без предопределенных мандатов; пустой ТипМандата допускается
	Запрос.УстановитьПараметр("ТипМандата", ТипыМандатаДляОтбораФизическихЛиц());
	Запрос.УстановитьПараметр("ВидОперации", Справочники.ВидыОперацийЗакрытияПериода.РасчетРыночнойСтоимости);
	Запрос.УстановитьПараметр("СписокМандатов", Мандаты.ВыгрузитьКолонку("Мандат"));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачДата) - 14 * 24 * 60 * 60);  // страховочный интервал в 14 дней
	Запрос.Текст = 
	"ВЫБРАТЬ  РАЗЛИЧНЫЕ первые 20
	|	УстановкаРеглОперацийНастройки.Ссылка.Мандат КАК Мандат,
	|	УстановкаРеглОперацийНастройки.Ссылка.Мандат.ВалютаМандата КАК Валюта,
	|	УстановкаРеглОперацийНастройки.Ссылка.Мандат.ДатаОкончания КАК МандатДатаОкончания
	|ИЗ
	|	Документ.УстановкаРеглОпераций.Настройки КАК УстановкаРеглОперацийНастройки
	|ГДЕ
	|	УстановкаРеглОперацийНастройки.Ссылка.Проведен = ИСТИНА
	|	И УстановкаРеглОперацийНастройки.ВидОперации = &ВидОперации
	|	И (УстановкаРеглОперацийНастройки.Ссылка.Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ УстановкаРеглОперацийНастройки.Ссылка.Мандат.ДатаОкончания >= &НачалоПериода)
	|	И 1 = 1
	|	И 2 = 2
	|	И НЕ УстановкаРеглОперацийНастройки.Ссылка.Мандат.Предопределенный
	|
	|УПОРЯДОЧИТЬ ПО
	|	Мандат,
	|	Валюта
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Если НЕ ПоВсем Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "УстановкаРеглОперацийНастройки.Ссылка.Мандат В (&СписокМандатов)");
	КонецЕсли;
	
	Если ФизЛицо = Неопределено Тогда
		// по всем
	ИначеЕсли НЕ ФизЛицо Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "УстановкаРеглОперацийНастройки.Ссылка.Мандат.ТипМандата НЕ В (&ТипМандата)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "УстановкаРеглОперацийНастройки.Ссылка.Мандат.ТипМандата В (&ТипМандата)");
	КонецЕсли;
	
	ТЗМандатов = Запрос.Выполнить().Выгрузить();
	
	ТекДата = НачалоДня(НачДата);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(), "ДЛФ=ДВ") + " ->"  + " == Начали обработку MV");
	
	Пока ТекДата <= НачалоДня(КонДата) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(), "ДЛФ=ДВ") + " ->"  + " == MV == Обрабатывается " + Формат(ТекДата,"ДЛФ=Д"));
		
		Если ОткрыватьТранзакцию Тогда
			Если НЕ ТранзакцияАктивна() Тогда
				НачатьТранзакцию();
			КонецЕсли;
		КонецЕсли;
		
		УдалитьДокументыРасчетРыночнойСтоимости(ТекДата, ТЗМандатов.ВыгрузитьКолонку("Мандат"), Ошибка);
		Если Ошибка Тогда
			Если ОткрыватьТранзакцию Тогда
				Если ТранзакцияАктивна() Тогда
					ОтменитьТранзакцию();
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ТЗКФормированию = ТЗМандатов.СкопироватьКолонки();
		ТЗКФормированию.Очистить();
		ТЗКФормированию.Колонки.Добавить("Курс", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 4)));
		ТЗКФормированию.Колонки.Добавить("Кратность", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
		
		Для Каждого Выборка Из ТЗМандатов Цикл
			// Пропускаем мандат, у которого завершился договор
			Если ЗначениеЗаполнено(Выборка.МандатДатаОкончания) И (Выборка.МандатДатаОкончания < ТекДата) Тогда
				Продолжить;
			КонецЕсли;
			
			//DDneprovsky 08.10.2018 IMAPPS-6929
			Если НеобходимоПропуститьРасчет(НачалоДня(ТекДата), Выборка.Мандат, КоличествоДней) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Пропущен расчет MV по мандату: " + Выборка.Мандат + ". За дату: " + Формат(НачалоДня(ТекДата),"ДЛФ=ДВ"));
				Продолжить;
			КонецЕсли;
			//DDneprovsky 08.10.2018 IMAPPS-6929
					
			Если Выборка.Валюта = Справочники.Валюты.ПустаяСсылка() Тогда
				Ошибка = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Не заполнена валюта мандата! Клиент пропущен: " + Выборка.Мандат);
				Продолжить;
			КонецЕсли;
			
			КурсВалюты = ПолучитьКурсВалюты(Выборка.Валюта, ТекДата, ВалютныйКЭШ);
			
			Если ОткрыватьТранзакцию Тогда
				
				Док = Документы.РасчетРыночнойСтоимости.СоздатьДокумент();
				Док.Валюта 		= Выборка.Валюта;
				Док.Курс	 	= КурсВалюты.Курс;
				Док.Кратность 	= КурсВалюты.Кратность;
				Док.Дата 		= НачалоДня(ТекДата) + 23*60*60 + 59*60 + 59;
				Док.Мандат 		= Выборка.Мандат;
				Док.ЗаполнитьДокумент();
				// VTB-Borisov  - 26.10.2017 {
				Попытка
					Док.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					ТекстОшибки = ОписаниеОшибки();
					Ошибка = Истина;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Ошибка при проведении документа <"+ Док + ">. " + ТекстОшибки);
					
					// VTB-Borisov  - 05.08.2019 {
					//ВызватьИсключение ТекстОшибки;
					Продолжить;
					// VTB-Borisov  - 05.08.2019 }
					
				КонецПопытки;
				// VTB-Borisov  - 26.10.2017 }
				
				//ОбработкаПрерыванияПользователя();
				
			Иначе
				
				НовСтр = ТЗКФормированию.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
				НовСтр.Курс = КурсВалюты.Курс;
				НовСтр.Кратность = КурсВалюты.Кратность;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ОткрыватьТранзакцию И ТЗКФормированию.Количество() > 0 Тогда
			ОшибкаФоновогоФормирования = Ложь;
			СформироватьДокументыПараллельно("РасчетРыночнойСтоимости", ТекДата, ТЗКФормированию, ОшибкаФоновогоФормирования, 10);
			Ошибка = Ошибка Или ОшибкаФоновогоФормирования;
		КонецЕсли;
		
		ТекДата = ТекДата + 24*60*60;     
		
		// ILang IMAPPS-19348
		//// +Artur Mingalev 14.10.2021 IMAPPS-14620
		//Если КоличествоДней = 1 Тогда 
		//	Если Не ЭтоРабочийДень(ТекДата,ТмпКалендарь) Тогда
		//		ТекДата = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(ТмпКалендарь, ТекДата, +1);
		//	КонецЕсли;		
		//КонецЕсли;
		//// -Artur Mingalev 14.10.2021 IMAPPS-14620
		// ILang IMAPPS-19348

		Если ОткрыватьТранзакцию Тогда
			Если ТранзакцияАктивна() Тогда
				ЗафиксироватьТранзакцию();
			КонецЕсли;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Обработка MV завершена!");
	КонецЦикла;
	
	Если ОткрыватьТранзакцию Тогда
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;
	
	Если ВыполнятьЗамеры Тогда
		ОценкаПроизводительностиКлиентСервер.ЗакончитьЗамерВремени(ИдентификаторОперации, ВремяНачалаЗамера);
	КонецЕсли;	

КонецПроцедуры // СформироватьMV()

// IMDEV-8665 - расчет WAP за период. УДАЛИТЬ ОТЛАДКУ: ПЕРВЫЕ 20 в запросе мандатов ниже - временное ограничение для отладки.
//DDneprovsky 08.10.2018 IMAPPS-6929
Процедура СформироватьWAP(Ошибка = Ложь, ТекстСообщения = "", Знач КоличествоДней = 1, Знач ОткрыватьТранзакцию = Ложь, Знач ФизЛицо = Неопределено) Экспорт
		
	ИдентификаторОперации = "СформироватьWap" + Строка(КоличествоДней) + ?(ФизЛицо = Неопределено, "", ?(Истина = ФизЛицо, "Физ", "Юр")) + "Сервер";
	Если ВыполнятьЗамеры Тогда
		ВремяНачалаЗамера = ОценкаПроизводительностиКлиентСервер.НачатьЗамерВремени(ИдентификаторОперации);
	КонецЕсли;
	// +Artur Mingalev 14.10.2021 IMAPPS-14620
	ТмпКалендарь = ?(ЭтотОбъект.Календарь.Пустая(), Справочники.ПроизводственныеКалендари.РегламентированныйКалендарь, ЭтотОбъект.Календарь);
	// -Artur Mingalev 14.10.2021 IMAPPS-14620
	Запрос = Новый Запрос();
	// IMDEV-8665-WAP: физлица В (I,B), юрлица НЕ В (I,B); в ТЗМандатов без предопределенных мандатов; пустой ТипМандата допускается
	Запрос.УстановитьПараметр("ТипМандата", ТипыМандатаДляОтбораФизическихЛиц());
	Запрос.УстановитьПараметр("ВидОперации", Справочники.ВидыОперацийЗакрытияПериода.РасчетРыночнойСтоимости);
	Запрос.УстановитьПараметр("СписокМандатов", Мандаты.ВыгрузитьКолонку("Мандат"));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачДата) - 14 * 24 * 60 * 60);  // страховочный интервал в 14 дней
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ первые 20
	|	УстановкаРеглОперацийНастройки.Ссылка.Мандат КАК Мандат,
	|	УстановкаРеглОперацийНастройки.Ссылка.Мандат.ВалютаМандата КАК Валюта,
	|	УстановкаРеглОперацийНастройки.Ссылка.Мандат.ДатаОкончания КАК МандатДатаОкончания
	|ИЗ
	|	Документ.УстановкаРеглОпераций.Настройки КАК УстановкаРеглОперацийНастройки
	|ГДЕ
	|	УстановкаРеглОперацийНастройки.Ссылка.Проведен = ИСТИНА
	|	И УстановкаРеглОперацийНастройки.ВидОперации = &ВидОперации
	|	И (УстановкаРеглОперацийНастройки.Ссылка.Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ УстановкаРеглОперацийНастройки.Ссылка.Мандат.ДатаОкончания >= &НачалоПериода)
	|	И 1 = 1
	|	И 2 = 2
	|	И НЕ УстановкаРеглОперацийНастройки.Ссылка.Мандат.Предопределенный
	|
	|УПОРЯДОЧИТЬ ПО
	|	Мандат,
	|	Валюта
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Если НЕ ПоВсем Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "УстановкаРеглОперацийНастройки.Ссылка.Мандат В (&СписокМандатов)");
	КонецЕсли;
	
	Если ФизЛицо = Неопределено Тогда
		// по всем
	ИначеЕсли НЕ ФизЛицо Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "УстановкаРеглОперацийНастройки.Ссылка.Мандат.ТипМандата НЕ В (&ТипМандата)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "УстановкаРеглОперацийНастройки.Ссылка.Мандат.ТипМандата В (&ТипМандата)");
	КонецЕсли;
	
	ТЗМандатов = Запрос.Выполнить().Выгрузить();
	
	ТекДата = НачалоДня(НачДата);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " == Начали обработку WAP");
	
	Пока ТекДата <= НачалоДня(КонДата) Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " == WAP == Обрабатывается " + Формат(ТекДата,"ДЛФ=Д"));
		
		Если ОткрыватьТранзакцию Тогда
			Если НЕ ТранзакцияАктивна() Тогда
				НачатьТранзакцию();
			КонецЕсли;
		КонецЕсли;
		
		УдалитьДокументыРасчетСредневзвешеннойСтоимости(ТекДата, ТЗМандатов.ВыгрузитьКолонку("Мандат"), Ошибка);
		Если Ошибка Тогда
			Если ОткрыватьТранзакцию Тогда
				Если ТранзакцияАктивна() Тогда
					ОтменитьТранзакцию();
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ТЗКФормированию = ТЗМандатов.СкопироватьКолонки();
		ТЗКФормированию.Очистить();
		ТЗКФормированию.Колонки.Добавить("Курс", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 4)));
		ТЗКФормированию.Колонки.Добавить("Кратность", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
		
		Для Каждого Выборка Из ТЗМандатов Цикл
			// Пропускаем мандат, у которого завершился договор
			Если ЗначениеЗаполнено(Выборка.МандатДатаОкончания) И (Выборка.МандатДатаОкончания < ТекДата) Тогда
				Продолжить;
			КонецЕсли;
			
			//DDneprovsky 08.10.2018 IMAPPS-6929
			Если НеобходимоПропуститьРасчет(НачалоДня(ТекДата), Выборка.Мандат, КоличествоДней) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Пропущен расчет WAP по мандату: " + Выборка.Мандат + ". За дату: " + Формат(НачалоДня(ТекДата),"ДЛФ=ДВ"));
				Продолжить;
			КонецЕсли;
			
			Если Выборка.Валюта = Справочники.Валюты.ПустаяСсылка() Тогда
				Ошибка = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Не заполнена валюта мандата! Клиент пропущен: " + Выборка.Мандат);
				Продолжить;
			КонецЕсли;
			
			Если ОткрыватьТранзакцию Тогда
				
				Док = Документы.РасчетСредневзвешеннойСтоимости.СоздатьДокумент();
				Док.Дата 	= НачалоДня(ТекДата) + 23*60*60 + 59*60 + 59;
				Док.Мандат 	= Выборка.Мандат;
				Док.ЗаполнитьДокумент();
							
				// VTB-Borisov  - 26.10.2017 {
				//Док.Записать(РежимЗаписиДокумента.Проведение);
				Попытка
					Док.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					ТекстОшибки = ОписаниеОшибки();
					Ошибка = Истина;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Ошибка при проведении документа <"+ Док + ">. " + ТекстОшибки);
					
					// VTB-Borisov  - 05.08.2019 {
					//ВызватьИсключение ТекстОшибки;
					Продолжить;
					// VTB-Borisov  - 05.08.2019 }
					
				КонецПопытки;
				// VTB-Borisov  - 26.10.2017 }
				
				//ОбработкаПрерыванияПользователя();
				
			Иначе
				
				НовСтр = ТЗКФормированию.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
				НовСтр.Курс = 1;
				НовСтр.Кратность = 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ОткрыватьТранзакцию И ТЗКФормированию.Количество() > 0 Тогда
			ОшибкаФоновогоФормирования = Ложь;
			СформироватьДокументыПараллельно("РасчетСредневзвешеннойСтоимости", ТекДата, ТЗКФормированию, ОшибкаФоновогоФормирования, 10);
			Ошибка = Ошибка Или ОшибкаФоновогоФормирования;
		КонецЕсли;
		
		ТекДата = ТекДата + 24*60*60;
		//// +Artur Mingalev 14.10.2021 IMAPPS-14620
		//Если КоличествоДней = 1 Тогда 
		//	Если Не ЭтоРабочийДень(ТекДата,ТмпКалендарь) Тогда
		//		ТекДата = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(ТмпКалендарь, ТекДата, +1);
		//	КонецЕсли;		
		//КонецЕсли;
		//// -Artur Mingalev 14.10.2021 IMAPPS-14620

		Если ОткрыватьТранзакцию Тогда
			Если ТранзакцияАктивна() Тогда
				ЗафиксироватьТранзакцию();
			КонецЕсли;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Обработка WAP завершена!");
	КонецЦикла;
	
	Если ОткрыватьТранзакцию Тогда
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;
	
	Если ВыполнятьЗамеры Тогда
		ОценкаПроизводительностиКлиентСервер.ЗакончитьЗамерВремени(ИдентификаторОперации, ВремяНачалаЗамера);
	КонецЕсли;	
КонецПроцедуры // СформироватьWAP()

// IMDEV-8665 Одна итерация пула: опционально подождать первое активное задание, затем убрать из массива завершённые записи.
//
// Параметры:
// АктивныеЗадания - Массив - элементы со свойством ИдентификаторЗадания (результат ДлительныеОперации.ЗапуститьВыполнениеВФоне).
// ИнтервалОжиданияСек - Число - интервал ФоновоеЗадание.ОжидатьЗавершения.
// УдалятьЗаписиБезИдентификатора - Булево - Истина при финальном дренаже (удалять «битые» элементы без GUID); Ложь в основном цикле запуска.
//
Процедура ОжиданиеИОчисткаАктивныхФоновыхЗаданийПула(АктивныеЗадания, ИнтервалОжиданияСек, УдалятьЗаписиБезИдентификатора)
	
	Если АктивныеЗадания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеРезультата = АктивныеЗадания[0];
	Если ОписаниеРезультата.Свойство("ИдентификаторЗадания") Тогда
		ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ОписаниеРезультата.ИдентификаторЗадания);
		Если ФоновоеЗадание <> Неопределено И ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Попытка
				ФоновоеЗадание.ОжидатьЗавершения(ИнтервалОжиданияСек);
			Исключение
				// Задание могло завершиться между проверкой состояния и вызовом ОжидатьЗавершения.
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	ИндексОбратный = АктивныеЗадания.ВГраница();
	Пока ИндексОбратный >= 0 Цикл
		ЗаписьОРезультате = АктивныеЗадания[ИндексОбратный];
		Если ЗаписьОРезультате.Свойство("ИдентификаторЗадания") Тогда
			ФЗ = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ЗаписьОРезультате.ИдентификаторЗадания);
			Если ФЗ = Неопределено Или ФЗ.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
				АктивныеЗадания.Удалить(ИндексОбратный);
			КонецЕсли;
		ИначеЕсли УдалятьЗаписиБезИдентификатора Тогда
			АктивныеЗадания.Удалить(ИндексОбратный);
		КонецЕсли;
		ИндексОбратный = ИндексОбратный - 1;
	КонецЦикла;
	
КонецПроцедуры

// IMDEV-8665 Запуск одного фонового формирования документа по строке таблицы мандатов (ДлительныеОперации).
//
// Параметры:
// ИмяДокумента - Строка
// ТекДата - Дата
// СтрокаМандата - СтрокаТаблицыЗначений - Мандат; опционально Валюта, Курс, Кратность
//
// Возвращаемое значение:
// Структура - результат ДлительныеОперации.ЗапуститьВыполнениеВФоне
//
Функция ЗапуститьПараллельноеФормированиеДокументаПоСтроке(ИмяДокумента, ТекДата, СтрокаМандата)
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяДокумента", ИмяДокумента);
	ПараметрыЗадания.Вставить("ТекДата", ТекДата);
	ПараметрыЗадания.Вставить("Мандат", СтрокаМандата.Мандат);
	ПараметрыЗадания.Вставить("Валюта", ?(СтрокаМандата.Свойство("Валюта"), СтрокаМандата.Валюта, Неопределено));
	ПараметрыЗадания.Вставить("Курс", ?(СтрокаМандата.Свойство("Курс"), СтрокаМандата.Курс, 1));
	ПараметрыЗадания.Вставить("Кратность", ?(СтрокаМандата.Свойство("Кратность"), СтрокаМандата.Кратность, 1));
	
	ПараметрыФЗ = Новый Структура;
	ПараметрыФЗ.Вставить("ИмяМетода", "СоздатьИПровестиДокументВФоне");
	ПараметрыФЗ.Вставить("ПараметрыВыполнения", ПараметрыЗадания);
	ПараметрыФЗ.Вставить("ЭтоВнешняяОбработка", Истина);
	ПараметрыФЗ.Вставить("ДополнительнаяОбработкаСсылка", ПолучитьСсылкуНаСебя());
	ПараметрыФЗ.Вставить("ИмяОбработки", "внРасчетMVиWAP");
	
	Возврат ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		Новый УникальныйИдентификатор,
		"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
		ПараметрыФЗ,
		"Формирование " + ИмяДокумента + " по мандату " + СтрокаМандата.Мандат);
	
КонецФункции

// IMDEV-8665 Параллельное формирование и проведение документов MV или WAP (до МаксПотоков фоновых заданий ДлительныеОперации).
// Ожидание слотов без ОбщегоНазначенияКлиентСервер.Пауза: ФоновоеЗадание.ОжидатьЗавершения(интервал в секундах); финальное ожидание — опрос состояний.
// Не вызывать при ОткрыватьТранзакцию = Истина (фон вне транзакции вызывающего сеанса).
//
// Параметры:
// ИмяДокумента - Строка - "РасчетРыночнойСтоимости" или "РасчетСредневзвешеннойСтоимости"
// ТекДата - Дата
// ТЗМандатов - ТаблицаЗначений - колонка Мандат; для MV нужны Валюта, Курс, Кратность
// Ошибка - Булево - Истина при аварийном завершении любого задания
// МаксПотоков - Число
//
Процедура СформироватьДокументыПараллельно(ИмяДокумента, ТекДата, ТЗМандатов, Ошибка, МаксПотоков = 10)
	
	Ошибка = Ложь;
	АктивныеЗадания = Новый Массив;
	ИндексСтроки = 0;
	КоличествоСтрок = ТЗМандатов.Количество();
	
	МаксПотоков = Макс(МаксПотоков, 1);
	
	ИнтервалОжиданияСек = 0.1;
	
	Пока ИндексСтроки < КоличествоСтрок Цикл
		
		Пока АктивныеЗадания.Количество() < МаксПотоков И ИндексСтроки < КоличествоСтрок Цикл
			
			СтрокаМандата = ТЗМандатов[ИндексСтроки];
			АктивныеЗадания.Добавить(ЗапуститьПараллельноеФормированиеДокументаПоСтроке(ИмяДокумента, ТекДата, СтрокаМандата));
			ИндексСтроки = ИндексСтроки + 1;
			
		КонецЦикла;
		
		ОжиданиеИОчисткаАктивныхФоновыхЗаданийПула(АктивныеЗадания, ИнтервалОжиданияСек, Ложь);
		
	КонецЦикла;
	
	КопияЗапусковДляКонтроляОшибок = Новый Массив;
	Для Каждого ЭлементКопии Из АктивныеЗадания Цикл
		КопияЗапусковДляКонтроляОшибок.Добавить(ЭлементКопии);
	КонецЦикла;
	
	Пока АктивныеЗадания.Количество() > 0 Цикл
		ОжиданиеИОчисткаАктивныхФоновыхЗаданийПула(АктивныеЗадания, ИнтервалОжиданияСек, Истина);
	КонецЦикла;
	
	Для Каждого ЗаписьОРезультате Из КопияЗапусковДляКонтроляОшибок Цикл
		Если ЗаписьОРезультате.Свойство("ИдентификаторЗадания") Тогда
			ФЗ = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ЗаписьОРезультате.ИдентификаторЗадания);
			Если ФЗ <> Неопределено И ФЗ.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
				Ошибка = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// IMDEV-8665 Исполнитель ДлительныеОперации: создание и проведение одного документа расчета по параметрам мандата (MV или WAP).
//
// Параметры:
// Параметры - Структура - ИмяДокумента, ТекДата, Мандат; для MV также Валюта, Курс, Кратность
// АдресРезультата - Строка - адрес во временном хранилище результата БСП
//
Процедура СоздатьИПровестиДокументВФоне(Параметры, АдресРезультата) Экспорт
	
	Док = Документы[Параметры.ИмяДокумента].СоздатьДокумент();
	
	Док.Дата = НачалоДня(Параметры.ТекДата) + 23 * 3600 + 59 * 60 + 59;
	Док.Мандат = Параметры.Мандат;
	
	Если Параметры.ИмяДокумента = "РасчетРыночнойСтоимости" Тогда
		Док.Валюта = Параметры.Валюта;
		Док.Курс = Параметры.Курс;
		Док.Кратность = Параметры.Кратность;
	КонецЕсли;
	
	Док.ЗаполнитьДокумент();
	
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			Формат(ТекущаяДатаСеанса(), "ДЛФ=ДВ") + " -> Ошибка при проведении документа <" + Док + ">. " + ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Истина, АдресРезультата);
	
КонецПроцедуры

// IMDEV-8665 - ссылка на элемент справочника доп. обработок для запуска процедур объекта обработки из фона БСП
// Описание: Возвращает ссылку на элемент справочника «Дополнительные отчеты и обработки», соответствующий этой внешней обработке (имя объекта внРасчетMVиWAP).
// Результат кэшируется в переменной модуля СсылкаНаСебя при первом успешном поиске.
// Используется для запуска фоновых заданий БСП (ДлительныеОперации) с контекстом внешней обработки.
//
// Параметры:
// Нет.
//
// Возвращаемое значение:
// СправочникСсылка.ДополнительныеОтчетыИОбработки - ссылка на подключенную обработку с публикацией «Используется».
//
// Исключения:
// Вызывается исключение, если элемент справочника по имени объекта внРасчетMVиWAP не найден.
//
Функция ПолучитьСсылкуНаСебя()
	Если ЗначениеЗаполнено(СсылкаНаСебя) Тогда Возврат СсылкаНаСебя; КонецЕсли;
	
	Имя = "внРасчетMVиWAP";
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ДополнительныеОтчетыИОбработки 
	|ГДЕ ИмяОбъекта = &Имя И Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)");
	Запрос.УстановитьПараметр("Имя", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	
	СсылкаНаСебя = ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(Имя, Истина));
	
	Если СсылкаНаСебя.Пустая() Тогда
		ВызватьИсключение "Не найдена обработка " + Имя;
	КонецЕсли;
	Возврат СсылкаНаСебя;
КонецФункции

// IMDEV-8665 - параллельное удаление документов за сутки по мандатам (отбор, пачки, ДлительныеОперации, ожидание)
// Описание: Отбирает документы указанного типа за сутки по мандатам, разбивает ссылки на пачки и удаляет их параллельно через БСП (ДлительныеОперации).
// Дожидается завершения всех заданий; при аварийном завершении любого задания выставляет Ошибка = Истина и сообщает пользователю.
// Параметры:
// ТекДата - Дата - день удаления.
// МассивМандатов - Массив - мандаты для отбора.
// ИмяДокумента - Строка - имя объекта метаданных документа (например, "РасчетРыночнойСтоимости").
// Ошибка - Булево - признак ошибки в ходе фонового удаления.
//
Процедура УдалитьДокументыФоновоУниверсально(Знач ТекДата, Знач МассивМандатов, Знач ИмяДокумента, Ошибка)
	
	Ошибка = Ложь;
	МассивЗаданий = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекДата", ТекДата);
	Запрос.УстановитьПараметр("Мандаты", МассивМандатов);
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ Ссылка ИЗ Документ.%1 
	|ГДЕ Мандат В(&Мандаты) 
	|	И Дата >= НАЧАЛОПЕРИОДА(&ТекДата,ДЕНЬ) 
	|	И Дата < НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекДата,ДЕНЬ,1),ДЕНЬ)
	|УПОРЯДОЧИТЬ ПО Дата, Ссылка", ИмяДокумента);
	
	МассивСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если МассивСсылок.Количество() = 0 Тогда Возврат; КонецЕсли;
	
	Пачки = РазбитьМассивНаПачки(МассивСсылок, 10);
	
	Для Каждого Пачка Из Пачки Цикл
		Если Пачка.Количество() = 0 Тогда Продолжить; КонецЕсли;
		
		ПараметрыПачки = Новый Структура("МассивСсылок,ИмяДокумента", Пачка, ИмяДокумента);
		
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("ИмяМетода", "УдалитьПачкуДокументовВФоне");
		ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыПачки);
		ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
		ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ПолучитьСсылкуНаСебя());
		ПараметрыЗадания.Вставить("ИмяОбработки", "внРасчетMVиWAP");
		
		Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
			Новый УникальныйИдентификатор,
			"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			ПараметрыЗадания,
			"Удаление " + ИмяДокумента);
		
		МассивЗаданий.Добавить(Результат);
	КонецЦикла;
	
	Если МассивЗаданий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Ожидание завершения всех фоновых заданий (опрос состояния по ИдентификаторЗадания из структуры результата БСП).
	ВсегоПачек = МассивЗаданий.Количество();
	МассивЗаданиеЗавершено = Новый Массив;
	Для ИндексПачки = 0 По ВсегоПачек - 1 Цикл
		МассивЗаданиеЗавершено.Добавить(Ложь);
	КонецЦикла;
	
	ЗавершеноПачек = 0;
	Пока ЗавершеноПачек < ВсегоПачек Цикл
		
		Для ИндексПачки = 0 По ВсегоПачек - 1 Цикл
			
			Если МассивЗаданиеЗавершено[ИндексПачки] Тогда
				Продолжить;
			КонецЕсли;
			
			КонтекстПачки = МассивЗаданий[ИндексПачки];
			
			Если КонтекстПачки = Неопределено Тогда
				МассивЗаданиеЗавершено[ИндексПачки] = Истина;
				ЗавершеноПачек = ЗавершеноПачек + 1;
				Продолжить;
			КонецЕсли;
			
			ИдентификаторЗадания = Неопределено;
			Если Не КонтекстПачки.Свойство("ИдентификаторЗадания", ИдентификаторЗадания)
				Или Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
				МассивЗаданиеЗавершено[ИндексПачки] = Истина;
				ЗавершеноПачек = ЗавершеноПачек + 1;
				Продолжить;
			КонецЕсли;
			
			Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
			
			Если Задание = Неопределено Или Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
				
				МассивЗаданиеЗавершено[ИндексПачки] = Истина;
				ЗавершеноПачек = ЗавершеноПачек + 1;
				
				Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
					Ошибка = Истина;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						"Ошибка при фоновом удалении " + ИмяДокумента + ": "
						+ ?(Задание.ИнформацияОбОшибке <> Неопределено,
						КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке), "Неизвестная ошибка"));
				КонецЕсли;
			Иначе
				Попытка
					Задание.ОжидатьЗавершения(0.2);
				Исключение
					// Задание могло завершиться между проверкой состояния и вызовом ОжидатьЗавершения.
				КонецПопытки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// IMDEV-8665 - фоновое удаление объектов документов по ссылкам (исполнитель для ДлительныеОперации)
// Описание: Удаляет объекты документов по переданным ссылкам (вызов из фонового задания БСП для обработки внРасчетMVиWAP).
// Параметры:
// Параметры - Структура - ключи: МассивСсылок (Массив), ИмяДокумента (Строка); ИмяДокумента зарезервировано для единообразия с универсальной процедурой.
// АдресРезультата - Строка - адрес во временном хранилище для помещения признака успешного завершения (Истина).
//
Процедура УдалитьПачкуДокументовВФоне(Параметры, АдресРезультата) Экспорт
	
	Для Каждого Ссылка Из Параметры.МассивСсылок Цикл
		Попытка
			ДокОбъект = Ссылка.ПолучитьОбъект();
			Если ДокОбъект <> Неопределено Тогда
				ДокОбъект.Удалить();
			КонецЕсли;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				Формат(ТекущаяДатаСеанса(), "ДЛФ=ДВ") + " -> Ошибка при удалении документа <" + Ссылка + ">. " + ТекстОшибки);
			
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Истина, АдресРезультата);
	
КонецПроцедуры

// IMDEV-8665 - разбиение массива ссылок на несколько пачек для параллельного удаления
// Описание: Распределяет элементы исходного массива по фиксированному числу вложенных массивов (округляющее распределение по индексу).
// Параметры:
// Массив - Массив - произвольные элементы.
// КоличествоПачек - Число - число сегментов (не менее 1).
//
// Возвращаемое значение:
// Массив - массив из КоличествоПачек вложенных массивов с элементами исходного Массив.
//
Функция РазбитьМассивНаПачки(Знач Массив, Знач КоличествоПачек = 10) Экспорт
	
	Если Массив.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	КоличествоПачек = Макс(КоличествоПачек, 1);
	Результат = Новый Массив(КоличествоПачек);
	Для ИндексПачки = 0 По КоличествоПачек - 1 Цикл
		Результат[ИндексПачки] = Новый Массив;
	КонецЦикла;
	
	Для ИндексЭлемента = 0 По Массив.ВГраница() Цикл
		Результат[ИндексЭлемента % КоличествоПачек].Добавить(Массив[ИндексЭлемента]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

ВыполнятьЗамеры = ВыполнятьЗамерыПроизводительности();