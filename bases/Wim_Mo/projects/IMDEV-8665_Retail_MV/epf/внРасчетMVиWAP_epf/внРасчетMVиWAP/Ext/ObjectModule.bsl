	Возврат КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(ТмпКалендарь, ТекДата, -1);
КонецФункции	

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

Функция РассылкаСообщения(Знач ТемаСообщения, Знач ТекстСообщения, Знач СписокПолучатели, Знач ЕстьОшибки, Знач НомерРассылки)
	
	Если СписокПолучатели.Количество()>0 и НЕ ПочтовыйЛогин.Пустая() тогда
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
		ПараметрыПисьма.Тема = ?(ЕстьОшибки, "{FAIL} ", "{OK} ") + ТемаСообщения + ПропискаРассылки(НомерРассылки);
		ПараметрыПисьма.Тело = ТекстСообщения;
		ПараметрыПисьма.Важность = ?(ЕстьОшибки, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокПолучатели Цикл
			   Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
			
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.ТипТекста = "PlainText";
		
		// VTB-Borisov  - 03.11.2017 { 
		ПараметрыПисьма.Тело = ТекстСообщения;
		// VTB-Borisov  - 03.11.2017 }
		
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
			текстРассылки = "Рассылка завершена";
		Исключение
			текстРассылки = "Рассылка не удалась: "; 
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Для Каждого Элемент из Сообщения Цикл
				текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
			КонецЦикла;
		КонецПопытки;
		
		Возврат текстРассылки;
	КонецЕсли;
	
	Возврат "Не установлен список рассылки";
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	Ошибка = Ложь;
	ТекстСообщения = "";
	
	Если ИдентификаторКоманды  =  "Пересчет_MV_и_WAP_10d" Тогда 
		
		ВыполнитьКомандуПересчет_MV_и_WAP(10, Ложь); //юр лицо
		ВыполнитьКомандуПересчет_MV_и_WAP(10, Истина);   //физ лицо
		
	// IMAPPS-19348 ILang
	//ИначеЕсли ИдентификаторКоманды  =  "Пересчет_MV_и_WAP_1d" Тогда
	//	// IMAPPS-11403 AJetenov
	//	ВыполнитьКомандуПересчет_MV_и_WAP(1, Ложь);
	//	ВыполнитьКомандуПересчет_MV_и_WAP(1, Истина);
	//	// IMAPPS-11403 AJetenov     
	
	ИначеЕсли ИдентификаторКоманды  =  "Пересчет_MV_и_WAP_2d" Тогда
		ВыполнитьКомандуПересчет_MV_и_WAP(2, Ложь);
		ВыполнитьКомандуПересчет_MV_и_WAP(2, Истина);
		
	// IMAPPS-19348 ILang
	
	// IMAPPS-36383 ++
	ИначеЕсли ИдентификаторКоманды  =  "Пересчет_MV_и_WAP_3d_Retail" Тогда
		ВыполнитьКомандуПересчет_MV_и_WAP(3, Ложь);
		ВыполнитьКомандуПересчет_MV_и_WAP(3, Истина);
		
	ИначеЕсли ИдентификаторКоманды  =  "Пересчет_MV_и_WAP_1d_Retail" Тогда
		ВыполнитьКомандуПересчет_MV_и_WAP(1, Ложь);
		ВыполнитьКомандуПересчет_MV_и_WAP(1, Истина);
	// IMAPPS-36383 --
		
	ИначеЕсли ИдентификаторКоманды  =  "ПроцедурыДляСС" Тогда
		
		ПоВсем = истина;
		Отказ = Ложь;
		ЕстьОшибки = Ложь;
		
		НачДата = НачалоДня(ТекущаяДата());
		ПредРабочийДень = ПредыдущийРабочийДень(НачДата);
		НачДата = НачДата - 24*60*60;
		
		Если НачДата <> НачалоДня(КонецМесяца(НачДата)) Тогда
			НачДата = ПредРабочийДень;
		КонецЕсли;
		
		КонДата = КонецДня(НачДата);
		
		ТекстСообщения = ТекстСообщения + Символы.ПС + "СТАРТ "+ТекущаяДата() + Символы.ПС;
		
		Попытка
			Ошибка = Ложь;
			ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + " Расчет справедливой стоимости...";
			СформироватьУстановкуСС(Ошибка, ТекстСообщения); // если установлено правило определения котировок, то рассчитываем их, а не ждем из обмена.
		Исключение
			ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеОшибки();
			Отказ = Истина;
			ЕстьОшибки = Ошибка;
		КонецПопытки;
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + ?(Ошибка, " Завершено с ошибками.", " Завершено успешно.");
		
		Попытка
			Ошибка = Ложь;
			ТекстСообщения = ТекстСообщения + Символы.ПС + НачДата + " Расчет финансовых показателей облигаций ...";
			СформироватьРасчетФинПоказателей(Ошибка, ТекстСообщения);
		Исключение
			ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеОшибки();
			Отказ = Истина;
			ЕстьОшибки = Ошибка;
		КонецПопытки;
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + ?(Ошибка, " Завершено с ошибками.", " Завершено успешно.");
		
		ДатаТемп = НачДата;
		
		//IMAPPS-11089 фин показатели за 2 предыдущих дня
		////-2
		НачДата = НачалоДня(ТекущаяДата());
		ПредРабочийДень = ПредыдущийРабочийДень(ПредыдущийРабочийДень(НачДата));
		НачДата = НачДата-2*24*60*60;
		
		Если НачДата <> НачалоДня(КонецМесяца(НачДата)) Тогда
			НачДата = ПредРабочийДень;
		КонецЕсли;
		
		КонДата = КонецДня(НачДата);
		
		Попытка
			Ошибка = Ложь;
			ТекстСообщения = ТекстСообщения + Символы.ПС + НачДата + " Расчет финансовых показателей облигаций (T-2) ...";
			СформироватьРасчетФинПоказателей(Ошибка, ТекстСообщения);
		Исключение
			ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеОшибки();
			Отказ = Истина;
			ЕстьОшибки = Ошибка;
		КонецПопытки;
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + ?(Ошибка, " Завершено с ошибками.", " Завершено успешно.");
		
		////-3
		НачДата = НачалоДня(ТекущаяДата());
		ПредРабочийДень = ПредыдущийРабочийДень(ПредыдущийРабочийДень(ПредыдущийРабочийДень(НачДата)));
		НачДата = НачДата-3*24*60*60;
		
		Если НачДата <> НачалоДня(КонецМесяца(НачДата)) Тогда
			НачДата = ПредРабочийДень;
		КонецЕсли;
		
		КонДата = КонецДня(НачДата);
		
		Попытка
			Ошибка = Ложь;
			ТекстСообщения = ТекстСообщения + Символы.ПС + НачДата + " Расчет финансовых показателей облигаций (T-3) ...";
			СформироватьРасчетФинПоказателей(Ошибка, ТекстСообщения);
		Исключение
			ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеОшибки();
			Отказ = Истина;
			ЕстьОшибки = Ошибка;
		КонецПопытки;
		////
		
		НачДата = ДатаТемп;
		
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + ?(Ошибка, " Завершено с ошибками.", " Завершено успешно.");
		
		ТекстСообщения = ТекстСообщения + Символы.ПС + Символы.ПС + "ФИНИШ "+ТекущаяДата();
		
		ТемаСообщения = "Аванкор МО: Расчет финансовых показателей и справедливой стоимости на " + Формат(НачДата, "ДФ=yyyy-MM-dd; ДП=");
		
		РассылкаСообщения(
			ТемаСообщения,
			ТекстСообщения,
			СписокРассылкиСаппорт,
			ЕстьОшибки,
			"r25"
		);
	//DDneprovsky IMAPPS-11699 добавляем расчет фин показателей для предопр. мандата НРД	
	ИначеЕсли ИдентификаторКоманды = "ФинПоказателиНРД" Тогда
		Отказ = Ложь;
		ЕстьОшибки = Ложь;
		ТекстСообщения = ТекстСообщения + Символы.ПС + "СТАРТ " + ТекущаяДата() + Символы.ПС;
		
		ДатаРасчета = НачалоДня(ТекущаяДата());
		Для Шаг = 1 По 3 Цикл // три итерации, Т-1, Т-2, Т-3
			Ошибка = Ложь;
			ДатаРасчета = ПредыдущийРабочийДень(ДатаРасчета);
			ТекстСообщения = ТекстСообщения + Символы.ПС + ДатаРасчета
					+ " Расчет финансовых показателей облигаций по мандату НРД (T-" + Строка(Шаг) + ") ...";
			Попытка
				СформироватьРасчетФинПоказателейНРД(ДатаРасчета, Ошибка, ТекстСообщения);
			Исключение
				ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеОшибки();
				Отказ = Истина;
				ЕстьОшибки = Ошибка;				
			КонецПопытки;
			ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + ?(Ошибка, " Завершено с ошибками.", " Завершено успешно.");
		КонецЦикла;	
		
		ТекстСообщения = ТекстСообщения + Символы.ПС + Символы.ПС + "ФИНИШ "+ТекущаяДата();
		ТемаСообщения = "Аванкор МО: Расчет финансовых показателей для портфеля НРД "
			+ Формат(ПредыдущийРабочийДень(НачалоДня(ТекущаяДата())), "ДФ=yyyy-MM-dd; ДП=");
		
		РассылкаСообщения(
			ТемаСообщения,
			ТекстСообщения,
			СписокРассылкиСаппорт,
			ЕстьОшибки,
			"r25.2"
		);
	КонецЕсли;
	//DDneprovsky IMAPPS-11699 добавляем расчет фин показателей для предопр. мандата НРД
КонецПроцедуры

Процедура ВыполнитьКомандуПересчет_MV_и_WAP(Знач КоличествоДней, Знач ФизЛицо = Неопределено) Экспорт
	
	Ошибка = Ложь;
	ТекстОшибки = "";
	текстСообщения = "";
	ТмпКалендарь = ?(ЭтотОбъект.Календарь.Пустая(), Справочники.ПроизводственныеКалендари.РегламентированныйКалендарь, ЭтотОбъект.Календарь);
	
	ПоВсем = истина;
	КонДата = КонецДня(НачалоДня(ТекущаяДата())-60);
	
	// ILang IMAPPS-19348
	// +Artur Mingalev 13.10.2021 IMAPPS-14620	
	//Если не ЭтоРабочийДень(КонДата,ТмпКалендарь) тогда
	//КонДата = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(ТмпКалендарь, КонДата, -1);	
	//КонецЕсли;		
	// -Artur Mingalev 13.10.2021 IMAPPS-14620  
	//
	//НачДата = КонДата - 24 * 60 * 60 * КоличествоДней;
		
	Если КоличествоДней = 2 тогда
		СтартДата = КонДата-20*24*60*60;		
		МассивРабочихДней = КалендарныеГрафики.ПолучитьСписокРабочихДнейПериода(ТмпКалендарь,СтартДата,КонДата);    ///ТмпКалендарь    
		НачДата = МассивРабочихДней[МассивРабочихДней.Количество() - 2];
	Иначе НачДата = КонДата - 24 * 60 * 60 * КоличествоДней;
	КонецЕсли;    
	// ILang IMAPPS-19348
	
	//IMAPPS-11652 Jetenov
	Если не ЭтоРабочийДень(НачДата, ТмпКалендарь) тогда
		НачДата = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(ТмпКалендарь, НачДата, -1);  //IMAPPS-11652
	КонецЕсли;
	//IMAPPS-11652 Jetenov

	Попытка
		// Первый этап
		СформироватьMV(Ошибка, КоличествоДней, Ложь, ФизЛицо);
		
		Если Ошибка Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Обработка ""Пересчет по расписанию MV и WAP"" - завершена с ошибкой (MV-этап)!");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Были ошибки в MV-этапе");
		КонецЕсли;
		
		// Второй этап
		СформироватьWAP(Ошибка, "", КоличествоДней, Ложь, ФизЛицо);
		
		Если Ошибка Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Обработка ""Пересчет по расписанию MV и WAP"" - завершена с ошибкой (WAP-этап)!");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Были ошибки в WAP-этапе");
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Обработка ""Пересчет по расписанию MV и WAP"" - завершена!");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Ошибка = Истина;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(), "ДЛФ=ДВ") + " ->"  + " Обработка ""Пересчет по расписанию MV и WAP"" - завершена с ошибкой! Описание Ошибки: " + ТекстОшибки);
		
		текстСообщения = текстСообщения + ?(ЗначениеЗаполнено(текстСообщения), "" + Символы.ПС, "") + "Пересчет по расписанию MV и WAP"" - завершен с ошибкой! Описание Ошибки: " + ТекстОшибки;
	КонецПопытки;
	
	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Для Каждого ТекЭлемент из Сообщения Цикл
		текстСообщения = текстСообщения + Символы.ПС + ТекЭлемент.Текст;
	КонецЦикла;
	
	Получатели = СписокРассылки.Выгрузить();
	Для каждого СтрокаРассСаппорт Из СписокРассылкиСаппорт Цикл
		НовСтрока = Получатели.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаРассСаппорт);
	КонецЦикла;
	
	Если КоличествоДней > 0 Тогда
		ТемаСообщения = "Аванкор МО: Пересчет по расписанию MV и WAP (глубина " + Формат(КоличествоДней, "ЧДЦ=0; ЧН=; ЧГ=") + " дн.) с " + Формат(НачДата, "ДФ=yyyy-MM-dd; ДП=") + " по " + Формат(КонДата, "ДФ=yyyy-MM-dd; ДП=");
		НомерРассылки = "r26.2." + ?(ФизЛицо = Неопределено, "ВСЕ", ?(Истина = ФизЛицо, "ФЛ", "ЮЛ"));
	Иначе
		ТемаСообщения = "Аванкор МО: Пересчет по расписанию MV и WAP с " + Формат(НачДата, "ДФ=yyyy-MM-dd; ДП=") + " по " + Формат(КонДата, "ДФ=yyyy-MM-dd; ДП=");
		НомерРассылки = "r26.1." + ?(ФизЛицо = Неопределено, "ВСЕ", ?(Истина = ФизЛицо, "ФЛ", "ЮЛ"));
	КонецЕсли;
	
	тт = РассылкаСообщения(
		ТемаСообщения,
		текстСообщения,
		Получатели,
		Ошибка,
		НомерРассылки
	);
	
КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
//	IMAPPS-1006
//	ДатаНачала 		= НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(,ТекущаяДата(),-1));
	ДатаНачала 		= НачалоДня(ТекущаяДата() - 60 * 60 * 24);
	ДатаОкончания 	= КонецДня(ДатаНачала);
	
	// ПараметрыВыполненияКоманды = Новый Структура();
	//ПараметрыВыполненияКоманды.Вставить("ДополнительнаяОбработкаСсылка", ВнешняяОбработкаСсылка);
	//ПараметрыВыполненияКоманды.Вставить("ПараметрыДополнительнойОбработки",Справочники.ДополнительныеОтчетыИОбработки.НастройкиОбработки(ВнешняяОбработкаСсылка));
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда
		Возврат "<Настройки не установлены>";
	КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек,ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции


Процедура СформироватьУстановкуСС(Ошибка = Ложь, ТекстСообщения = "") экспорт
	
	//// проверка: если у Мандата есть правило определения котировок, то выключаем документ из обмена
	//МассивПараметров = Новый Массив;
	//МассивПараметров.Добавить(ПланыВидовХарактеристик.ПараметрыПортфеля.ПравилоОпределенияКотировок);
	//ЗначенияПараметров = РегистрыСведений.ЗначенияПараметровПортфеля.ЗначенияПараметровПортфеля(Объект.Мандат, МассивПараметров, Объект.Дата);
	//ПравилоОпределенияКотировок = ЗначенияПараметров.Получить(ПланыВидовХарактеристик.ПараметрыПортфеля.ПравилоОпределенияКотировок);
	//Если ЗначениеЗаполнено(ПравилоОпределенияКотировок) Тогда
	//	Отказ = Истина;
	//	НеЗамещатьОбъект = Истина;
	//КонецЕсли;
	//// проверка
		
	ИдентификаторОперации = "MvWapУстановкаСсСервер";
	Если ВыполнятьЗамеры Тогда
		ВремяНачалаЗамера = ОценкаПроизводительностиКлиентСервер.НачатьЗамерВремени(ИдентификаторОперации);
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ПравилоОпределенияСС", 	ПланыВидовХарактеристик.ПараметрыПортфеля.ПравилоОпределенияКотировок);
	Запрос.УстановитьПараметр("ВидОперации", 			Справочники.ВидыОперацийЗакрытияПериода.РасчетРыночнойСтоимости);
	Запрос.УстановитьПараметр("СписокМандатов", 		Мандаты.ВыгрузитьКолонку("Мандат"));
	Запрос.УстановитьПараметр("КонДата", 				КонецДня(КонДата));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	тНастройки.Мандат,
	|	тНастройки.ВидОперации,
	|	тНастройки.Периодичность КАК ПериодичностьОперации,
	|	тПарам.Значение КАК ПравилоОпределенияКотировки
	|ИЗ
	|	РегистрСведений.НастройкиЗакрытияПериода.СрезПоследних(
	|			&КонДата,
	|			ВидОперации = &ВидОперации
	|				И Мандат В (&СписокМандатов)) КАК тНастройки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПараметровПортфеля.СрезПоследних(
	|				&КонДата,
	|				Параметр = &ПравилоОпределенияСС
	|					И Портфель В (&СписокМандатов)) КАК тПарам
	|		ПО тНастройки.Мандат = тПарам.Портфель
	|ГДЕ
	|	(ВЫРАЗИТЬ(тПарам.Значение КАК Справочник.ПравилаОпределенияКотировок)) <> ЗНАЧЕНИЕ(Справочник.ПравилаОпределенияКотировок.ПустаяСсылка)";  
	
	Если ПоВсем Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Мандат В (&СписокМандатов)", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Портфель В (&СписокМандатов)", "");
	КонецЕсли;
	
	ТЗМандатов = Запрос.Выполнить().Выгрузить();
	
	ТекДата = НачалоДня(НачДата);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " == Начали обработку установки СС");
	
	Пока ТекДата <= НачалоДня(КонДата) Цикл
		Если ЭтоКонецМесяца(ТекДата) Тогда
			// по последним дням месяца нужно считать - такая особенность!
		ИначеЕсли ЭтотОбъект.ИспользоватьКалендарь И ЭтоРабочийДень(ТекДата, ЭтотОбъект.Календарь) Тогда
			// по рабочим дням календаря нужно считать!
		ИначеЕсли НЕ ЭтотОбъект.ИспользоватьКалендарь Тогда
			// пользователь решил считать по выбранным дням, независимо от календаря.
		Иначе
			ТекДата = ТекДата + 24 * 60 * 60;
			Продолжить;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " == установка СС == Обрабатывается " + Формат(ТекДата,"ДЛФ=Д"));
		
		ЗапросДок = Новый Запрос();
		ЗапросДок.УстановитьПараметр("НачДата", НачалоДня(ТекДата));
		ЗапросДок.УстановитьПараметр("КонДата", КонецДня(ТекДата));
		ЗапросДок.УстановитьПараметр("СписокМандатов", ТЗМандатов.ВыгрузитьКолонку("Мандат"));
		ЗапросДок.Текст = 
		"ВЫБРАТЬ
		|	т.Ссылка
		|ИЗ
		|	Документ.УстановкаКотировок КАК т
		|ГДЕ
		|	т.Дата МЕЖДУ &НачДата И &КонДата
		|	И т.Мандат В(&СписокМандатов)";
		

		ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
		Пока ВыборкаДок.Следующий() Цикл
			ДокОбъект = ВыборкаДок.Ссылка.ПолучитьОбъект();
			
			Попытка
				ДокОбъект.Удалить();
			Исключение
				Ошибка = Истина;
				стрСообщение = Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Ошибка при удалении документа <"+ ДокОбъект + ">. " + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(стрСообщение);
				ТекстСообщения = ТекстСообщения + Символы.ПС + стрСообщение;
			КонецПопытки;
		КонецЦикла;
		
		Для Каждого СтрокаМандат Из ТЗМандатов Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Мандат: " + СтрокаМандат.Мандат + "; Правило: "+СтрокаМандат.ПравилоОпределенияКотировки);
			
			Док = Документы.УстановкаКотировок.СоздатьДокумент();
			Док.Дата 		= НачалоДня(ТекДата) + 23*60*60;
			Док.Мандат 		= СтрокаМандат.Мандат;
			Док.ЗаполнитьКотировки(0);
			
			Попытка
				Док.Записать(РежимЗаписиДокумента.Проведение);	
			Исключение
				Ошибка = Истина;
				стрСообщение = Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Ошибка при проведении документа <"+ Док + ">. " + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(стрСообщение);
				ТекстСообщения = ТекстСообщения + Символы.ПС + стрСообщение;
			КонецПопытки;
			
		КонецЦикла;
		
		ТекДата = ТекДата + 24*60*60;
		
	КонецЦикла;
	
	Если ВыполнятьЗамеры Тогда
		ОценкаПроизводительностиКлиентСервер.ЗакончитьЗамерВремени(ИдентификаторОперации, ВремяНачалаЗамера);
	КонецЕсли;	
	
КонецПроцедуры	//СформироватьУстановкуСС

Процедура СформироватьРасчетФинПоказателей(Ошибка = Ложь, ТекстСообщения = "") экспорт
		
	ИдентификаторОперации = "MvWapФинПоказателиСервер";
	Если ВыполнятьЗамеры Тогда
		ВремяНачалаЗамера = ОценкаПроизводительностиКлиентСервер.НачатьЗамерВремени(ИдентификаторОперации);
	КонецЕсли;
	
	списТипМандатов = новый Массив;
	списТипМандатов.Добавить(Перечисления.ТипыМандата.P);  // ПФ пенсионные резервы
	списТипМандатов.Добавить(Перечисления.ТипыМандата.N);  // ПФ пенсионные накопления
	списТипМандатов.Добавить(Перечисления.ТипыМандата.S);  // Страховые резервы
	списТипМандатов.Добавить(Перечисления.ТипыМандата.K);  // Страховые Собственные средства
	//05.05.2019 IMDEV-1295
	списТипМандатов.Добавить(Перечисления.ТипыМандата.E);  // Целевой капитал
	списТипМандатов.Добавить(Перечисления.ТипыМандата.L);  // Юридическое лицо
	списТипМандатов.Добавить(Перечисления.ТипыМандата.R);  // Фонды СРО
	// 20.04.2020 IMAPPS-9979
	списТипМандатов.Добавить(Перечисления.ТипыМандата.Z);  // Иные лица
	// 20.04.2020 IMAPPS-9979
		
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СписокТипМандатов", списТипМандатов);
	Запрос.УстановитьПараметр("ДатаС", 			НачалоДня(КонДата));
	Запрос.УстановитьПараметр("ДатаПо", 		КонецДня(КонДата));
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	т.Мандат
	|ИЗ
	|	РегистрСведений.РыночнаяСтоимостьПлановойПозиции КАК т
	|ГДЕ
	|	т.Период МЕЖДУ &ДатаС И &ДатаПо
	|	И т.Мандат.ТипМандата В(&СписокТипМандатов)";
	
	ТЗМандатов = Запрос.Выполнить().Выгрузить();
	
	ТекДата = НачалоДня(НачДата);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " == Начали обработку установки СС");
	
	Пока ТекДата <= НачалоДня(КонДата) Цикл
		Если ЭтоКонецМесяца(ТекДата) Тогда
			// по последним дням месяца нужно считать - такая особенность!
		ИначеЕсли ЭтотОбъект.ИспользоватьКалендарь И ЭтоРабочийДень(ТекДата, ЭтотОбъект.Календарь) Тогда
			// по рабочим дням календаря нужно считать!
		ИначеЕсли НЕ ЭтотОбъект.ИспользоватьКалендарь Тогда
			// пользователь решил считать по выбранным дням, независимо от календаря.
		Иначе
			ТекДата = ТекДата + 24 * 60 * 60;
			Продолжить;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " == установка СС == Обрабатывается " + Формат(ТекДата,"ДЛФ=Д"));
		
		ЗапросДок = Новый Запрос();
		ЗапросДок.УстановитьПараметр("НачДата", НачалоДня(ТекДата));
		ЗапросДок.УстановитьПараметр("КонДата", КонецДня(ТекДата));
		ЗапросДок.УстановитьПараметр("СписокМандатов", ТЗМандатов.ВыгрузитьКолонку("Мандат"));
		ЗапросДок.Текст = 
		"ВЫБРАТЬ
		|	т.Ссылка
		|ИЗ
		|	Документ.РасчетФинансовыхПоказателейОблигаций КАК т
		|ГДЕ
		|	т.Дата МЕЖДУ &НачДата И &КонДата
		|	И т.Портфель В(&СписокМандатов)";
		
		ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
		Пока ВыборкаДок.Следующий() Цикл
			
			ДокОбъект = ВыборкаДок.Ссылка.ПолучитьОбъект();
			
			Попытка
				ДокОбъект.Удалить();
			Исключение
				стрСообщение = Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Ошибка при удалении документа <"+ ДокОбъект + ">. " + ОписаниеОшибки();
				Ошибка = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(стрСообщение);
				ТекстСообщения = ТекстСообщения + Символы.ПС + стрСообщение;
			КонецПопытки;
		КонецЦикла;
		
		Для Каждого Выборка Из ТЗМандатов Цикл
			СоздатьДокументРасчетаФинансовыхПоказателейОблигаций(КонецДня(ТекДата), Выборка.Мандат, Ошибка, ТекстСообщения)
		КонецЦикла;
		
		ТекДата = ТекДата + 24*60*60;
	КонецЦикла;
	
	Если ВыполнятьЗамеры Тогда
		ОценкаПроизводительностиКлиентСервер.ЗакончитьЗамерВремени(ИдентификаторОперации, ВремяНачалаЗамера);
	КонецЕсли;	
КонецПроцедуры // СформироватьРасчетФинПоказателей()

//DDneprovsky IMAPPS-11699 добавляем расчет фин показателей для предопр. мандата НРД
Процедура СоздатьДокументРасчетаФинансовыхПоказателейОблигаций(Знач ДатаДок, Знач Портфель, Ошибка = Ложь, ТекстСообщения = "")
	Попытка
		Док = Документы.РасчетФинансовыхПоказателейОблигаций.СоздатьДокумент();
		Док.Дата = ДатаДок;
		Док.Портфель = Портфель;
		Док.ЗаполнитьОблигации();
		врем_УдалитьБессрочныеОблигации(Док, ДатаДок);
		Док.ЗаполнитьДенежныеПотоки();
		Док.РассчитатьЭСП();
		Док.РассчитатьДюрацию();
		Док.Записать(РежимЗаписиДокумента.Проведение);	
	Исключение
		стрСообщение = Формат(ТекущаяДата(), "ДЛФ=ДВ") + " ->"  + " Ошибка при проведении документа <"+ Док + ">. " + ОписаниеОшибки();
		Ошибка = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(стрСообщение);
		ТекстСообщения = ТекстСообщения + Символы.ПС + стрСообщение;
	КонецПопытки;
КонецПроцедуры

Процедура СформироватьРасчетФинПоказателейНРД(ДатаРасчета, Ошибка = Ложь, ТекстСообщения = "")
	ИдентификаторОперации = "MvWapФинПоказателиНрдСервер";
	Если ВыполнятьЗамеры Тогда
		ВремяНачалаЗамера = ОценкаПроизводительностиКлиентСервер.НачатьЗамерВремени(ИдентификаторОперации);
	КонецЕсли;
	
	ЗапросДок = Новый Запрос();
	ЗапросДок.УстановитьПараметр("НачДата", НачалоДня(ДатаРасчета));
	ЗапросДок.УстановитьПараметр("КонДата", КонецДня(ДатаРасчета));
	ЗапросДок.Текст = 
	"ВЫБРАТЬ
	|	Док.Ссылка
	|ИЗ
	|	Документ.РасчетФинансовыхПоказателейОблигаций КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &НачДата И &КонДата
	|	И Док.Портфель = ЗНАЧЕНИЕ(Справочник.Мандаты.НРД)";
	
	ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
	Пока ВыборкаДок.Следующий() Цикл
		ДокОбъект = ВыборкаДок.Ссылка.ПолучитьОбъект();
		Попытка
			ДокОбъект.Удалить();
		Исключение
			стрСообщение = Формат(ТекущаяДата(),"ДЛФ=ДВ") + " ->"  + " Ошибка при удалении документа <"+ ДокОбъект + ">. " + ОписаниеОшибки();
			Ошибка = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(стрСообщение);
			ТекстСообщения = ТекстСообщения + Символы.ПС + стрСообщение;
		КонецПопытки;
	КонецЦикла;
	
	ДатаДокументаФинПоказателей = НачалоДня(ДатаРасчета) + 8 * 60 * 60; //ДатаРасчета  8:00
	СоздатьДокументРасчетаФинансовыхПоказателейОблигаций(ДатаДокументаФинПоказателей, Справочники.Мандаты.НРД, Ошибка, ТекстСообщения);
	
	Если ВыполнятьЗамеры Тогда
		ОценкаПроизводительностиКлиентСервер.ЗакончитьЗамерВремени(ИдентификаторОперации, ВремяНачалаЗамера);
	КонецЕсли;	
КонецПроцедуры	
