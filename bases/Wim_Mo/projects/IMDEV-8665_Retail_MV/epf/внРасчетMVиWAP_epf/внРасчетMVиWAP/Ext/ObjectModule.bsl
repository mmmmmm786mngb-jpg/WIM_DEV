Процедура врем_УдалитьБессрочныеОблигации(Док, Дата)
	Перем Активы, Запрос, Выборка;
	
	Если 1 = 0 Тогда
		Док = Документы.РасчетФинансовыхПоказателейОблигаций.СоздатьДокумент();
	КонецЕсли;
	
	Активы = Док.Облигации.ВыгрузитьКолонку("Актив");
	Если Активы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Активы", Активы);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Активы.Объект КАК Справочник.Облигации) КАК Облигация
	|ПОМЕСТИТЬ втОблигации
	|ИЗ
	|	Справочник.Активы КАК Активы
	|ГДЕ
	|	Активы.Объект ССЫЛКА Справочник.Облигации
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Облигация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОфертаПоОблигациям.Ссылка КАК Ссылка,
	|	ОфертаПоОблигациям.Облигация КАК Облигация,
	|	ОфертаПоОблигациям.Дата КАК Дата
	|ПОМЕСТИТЬ втАктуальныеОферты
	|ИЗ
	|	Документ.ОфертаПоОблигациям КАК ОфертаПоОблигациям
	|ГДЕ
	|	ОфертаПоОблигациям.Дата > &Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОфертаПоОблигациям.Облигация,
	|	МИНИМУМ(ОфертаПоОблигациям.Дата) КАК Дата
	|ПОМЕСТИТЬ втОферты
	|ИЗ
	|	втАктуальныеОферты КАК ОфертаПоОблигациям
	|
	|СГРУППИРОВАТЬ ПО
	|	ОфертаПоОблигациям.Облигация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Активы.Ссылка КАК Актив,
	|	Облигации.ДатаВыпуска КАК ДатаВыпуска,
	|	Облигации.ДатаПогашения КАК ДатаПогашения,
	|	РАЗНОСТЬДАТ(Облигации.ДатаВыпуска, Облигации.ДатаПогашения, ДЕНЬ) КАК ДнейДоПогашения,
	|	ОфертаПоОблигациям.Дата КАК ДатаОферты
	|ИЗ
	|	Справочник.Облигации КАК Облигации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
	|		ПО (Активы.Объект = Облигации.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОферты КАК ОфертаПоОблигациям
	|		ПО (ОфертаПоОблигациям.Облигация = Облигации.Ссылка)
	|ГДЕ
	|	1 В
	|			(ВЫБРАТЬ
	|				1
	|			ИЗ
	|				втОблигации КАК ОблигацииДокумента
	|			ГДЕ
	|				ОблигацииДокумента.Облигация = Облигации.Ссылка)
	|	И (Облигации.ДатаПогашения = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ РАЗНОСТЬДАТ(Облигации.ДатаВыпуска, Облигации.ДатаПогашения, ДЕНЬ) > 365 * 50)
	|	И (Облигации.ДатаПогашения = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ РАЗНОСТЬДАТ(Облигации.ДатаВыпуска, ОфертаПоОблигациям.Дата, ДЕНЬ) > 365 * 50)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Актив";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивСтрок = Док.Облигации.НайтиСтроки(Новый Структура("Актив", Выборка.Актив));
		
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			Док.Облигации.Удалить(ТекСтрока);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры // врем_УдалитьБессрочныеОблигации()

