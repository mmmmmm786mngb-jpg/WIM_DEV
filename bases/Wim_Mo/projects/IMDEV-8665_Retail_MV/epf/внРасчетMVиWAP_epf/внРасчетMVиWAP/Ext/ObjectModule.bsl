	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
КонецПроцедуры

Процедура Заполнить() Экспорт
	Если Мандаты.Количество() > 0 Тогда
		Мандаты.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаОтчета", КонецДня(НачДата));
	запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТБ_PPG_НастройкиКнигСрезПоследних.Мандат КАК Мандат,
	|	ВТБ_PPG_НастройкиКнигСрезПоследних.Факт КАК Факт
	|ИЗ
	|	РегистрСведений.ВТБ_PPG_НастройкиКниг.СрезПоследних(&ДатаОтчета, Выгружать = ИСТИНА) КАК ВТБ_PPG_НастройкиКнигСрезПоследних";
	
	тз = Запрос.Выполнить().Выгрузить();
	
	Для каждого стр  Из тз Цикл
		стрМ = Мандаты.Добавить();
		стрМ.Мандат = стр.Мандат;
		стрМ.Факт   = стр.факт;	
	КонецЦикла;
КонецПроцедуры // Заполнить()

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	Перем Значения;
	
	Если Настройки.Свойство("Значения", Значения) Тогда
		Значения.Свойство("ИспользоватьКалендарь", ЭтотОбъект.ИспользоватьКалендарь);
		
		Если ЭтотОбъект.ИспользоватьКалендарь Тогда
			Значения.Свойство("Календарь", ЭтотОбъект.Календарь);
		Иначе
			ЭтотОбъект.Календарь = Справочники.ПроизводственныеКалендари.ПустаяСсылка();
		КонецЕсли;
		
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) тогда
			ЭтотОбъект.ПочтовыйЛогин = Почта;
			
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"), Значения.СписокРассылки);
			ЭтотОбъект.СписокРассылки.Загрузить(Ящики.Получить());
			
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"), Значения.СписокРассылкиСаппорт);
			ЭтотОбъект.СписокРассылкиСаппорт.Загрузить(Ящики.Получить());
			
		КонецЕсли;
		
		//DDneprovsky 08.10.2018 IMAPPS-6929
		Значения.Свойство("ПропускатьРасчет", ЭтотОбъект.ПропуститьРасчет);
		Значения.Свойство("ПропуститьРасчетПоМандату", ЭтотОбъект.ПропуститьРасчетПоМандату);
		Значения.Свойство("ПропуститьРасчетДата", ЭтотОбъект.ПропуститьРасчетДата);
		//DDneprovsky 08.10.2018 IMAPPS-6929
		
		ПредставлениеНастроек = "Настройки установлены";
	КонецЕсли;
КонецПроцедуры

Функция СформироватьИмяФайла(Ключ)
	Если Ключ = "Акции"  Тогда
		//e.g. AVANKOR.Equity.Trades.31JUL2015.csv
		ИмяФайла = "AVANCORE.Equity.Trades." + Врег(Формат(НачДата, "Л=en; ДФ=ddMMMyyyy"))+".csv"; 	
	ИначеЕсли Ключ = "Облигации"  Тогда
		ИмяФайла = "AVANCORE.Bond.Trades." + Врег(Формат(НачДата, "Л=en; ДФ=ddMMMyyyy"))+".csv"; 	
	КонецЕсли; 
	
	
	ИмяФайла = СтрЗаменить(ИмяФайла, """", "_");
	ИмяФайла = СтрЗаменить(ИмяФайла, "/", "_");
	ИмяФайла = СтрЗаменить(ИмяФайла, "\", "_");
	ИмяФайла = СтрЗаменить(ИмяФайла, "'", "_");
	ИмяФайла = СтрЗаменить(ИмяФайла, ":", "_");
	//ИмяФайла = СтрЗаменить(ИмяФайла, ".", "");
	ИмяФайла = СтрЗаменить(ИмяФайла, "^", "");
	ИмяФайла = СтрЗаменить(ИмяФайла, "&", "");
	ИмяФайла = СтрЗаменить(ИмяФайла, Символ(160), "");
	
	Возврат ИмяФайла;
КонецФункции

Функция ЭтоРабочийДень(Знач ДатаРасчета, Знач Календарь)
