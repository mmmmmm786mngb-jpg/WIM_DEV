// Готовый код к ТЗ: скрытие типов операции ДС по списку из РС ПараметрыГлобальные.
// Вставки в существующие модули базовой конфигурации SBB_Broker.

////////////////////////////////////////////////////////////////////////////////
// 1. Documents/ОперацииДС/Ext/ManagerModule.bsl - в конец модуля.

// Описание: Имя записи РС ПараметрыГлобальные со списком скрываемых типов операции ДС.
//
// Возвращаемое значение:
// Строка - имя параметра
//
Функция ИмяПараметраСкрываемыхТиповОпераций() Экспорт

    Возврат "СкрываемыеТипыОперацийДС";

КонецФункции

// Описание: Типы, которые нельзя выбирать вручную на форме ОперацииДС.
// Состав - строка имён через запятую в РС ПараметрыГлобальные.
// Нет записи или пустая строка - пустой массив, на форме ничего не скрывать.
//
// Возвращаемое значение:
// Массив - значения ПеречислениеСсылка.ТипыОпераций
//
Функция СкрываемыеТипыОпераций() Экспорт

    Результат = Новый Массив;

    СтрокаИмен = РегистрыСведений.ПараметрыГлобальные.ЗначениеПараметра(
        ИмяПараметраСкрываемыхТиповОпераций(),
        "");
    Если Не ЗначениеЗаполнено(СтрокаИмен) Тогда
        Возврат Результат;
    КонецЕсли;

    Для Каждого ИмяИзСтроки Из СтрРазделить(Строка(СтрокаИмен), ",", Ложь) Цикл

        ИмяЗначения = СокрЛП(ИмяИзСтроки);
        Если Не ЗначениеЗаполнено(ИмяЗначения) Тогда
            Продолжить;
        КонецЕсли;

        Если Метаданные.Перечисления.ТипыОпераций.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        ЗначениеТипа = Перечисления.ТипыОпераций[ИмяЗначения];
        Если Результат.Найти(ЗначениеТипа) = Неопределено Тогда
            Результат.Добавить(ЗначениеТипа);
        КонецЕсли;

    КонецЦикла;

    Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// 2. Documents/ОперацииДС/Forms/ФормаДокумента/Ext/Form/Module.bsl
// В конце ПриСозданииНаСервере, после УстановитьДоступностьЭлементовФормы();
//     НастроитьСписокВыбораТипаОперации();

// Описание: Список поля ТипОперации - все значения перечисления, кроме скрытых по регистру.
// Если в документе уже записан скрытый тип, текущее значение добавляется в список.
//
&НаСервере
Процедура НастроитьСписокВыбораТипаОперации()

    СкрываемыеТипы = Документы.ОперацииДС.СкрываемыеТипыОпераций();
    Если СкрываемыеТипы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Элементы.ТипОперации.РежимВыбораИзСписка = Истина;
    Элементы.ТипОперации.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
    Элементы.ТипОперации.СписокВыбора.Очистить();

    Для Каждого ОписаниеЗначения Из Метаданные.Перечисления.ТипыОпераций.ЗначенияПеречисления Цикл

        ЗначениеТипа = Перечисления.ТипыОпераций[ОписаниеЗначения.Имя];
        Если СкрываемыеТипы.Найти(ЗначениеТипа) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Элементы.ТипОперации.СписокВыбора.Добавить(ЗначениеТипа);

    КонецЦикла;

    ТекущийТип = Объект.ТипОперации;
    Если ЗначениеЗаполнено(ТекущийТип)
        И СкрываемыеТипы.Найти(ТекущийТип) <> Неопределено
        И Элементы.ТипОперации.СписокВыбора.НайтиПоЗначению(ТекущийТип) = Неопределено Тогда

        Элементы.ТипОперации.СписокВыбора.Добавить(ТекущийТип);

    КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// 3. InformationRegisters/ПараметрыГлобальные/Ext/ManagerModule.bsl
// В СуществующиеИменаПараметров перед Возврат:
//     ИменаПараметров.Добавить("СкрываемыеТипыОперацийДС");

////////////////////////////////////////////////////////////////////////////////
// 4. DataProcessors/ОбновлениеИнформационнойБазыNew/Ext/ObjectModule.bsl
// Конец ОбновитьВерсии. Подставить номер задачи. После выкладки прогнать обработку.

    НомерЗадачи = 0; // подставить номер задачи
    Если ОбработкаОбновленияПоЗадаче(НомерЗадачи, ВыполнитьОбновлениеПоЗадаче) Тогда
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
            СтрШаблон("Обновление по задаче %1. Создание глобального параметра СкрываемыеТипыОперацийДС", НомерЗадачи));
        РегистрыСведений.ПараметрыГлобальные.УстановитьЗначениеПараметра(
            Документы.ОперацииДС.ИмяПараметраСкрываемыхТиповОпераций(),
            "МаржинальныйВзносКОплате,МаржинальныйВзносКПолучению,ВводОстатков",
            "Типы, скрываемые в списке документа Операции с ДС. Имена Перечисление.ТипыОпераций через запятую.");
        ЛогироватьВыполнениеОбработчика(НомерЗадачи);
    КонецЕсли;
