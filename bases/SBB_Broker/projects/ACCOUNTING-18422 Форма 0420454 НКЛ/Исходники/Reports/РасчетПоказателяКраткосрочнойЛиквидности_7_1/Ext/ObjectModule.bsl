	СтрокиПоТипуЦК = Расшифровка.НайтиСтроки(ФильтрЦК);
	Для Каждого СтрокаЦК Из СтрокиПоТипуЦК Цикл
		Расчет.ЦК = Расчет.ЦК + СтрокаЦК.Сумма;
	КонецЦикла;
	
	Результат = Пакеты[1];
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Расчет.Итог = ?(ЗначениеЗаполнено(Выборка.Итог), Окр(Выборка.Итог, 2), 0);
		Расчет.КромеЦК = ?(ЗначениеЗаполнено(Выборка.КромеЦК), Окр(Выборка.КромеЦК, 2), 0);
		Если Развернутый И Расшифровка.Количество() > 0 Тогда
			Если ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				ДанныеРасшифровки.Вставить("П29", Расшифровка);
			Иначе
				ДанныеРасшифровки.Вставить("П43", Расшифровка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Расчет;
	
КонецФункции

Функция ДСПоВалютнымСделкам(МенеджерВременныхТаблиц, ДанныеРасшифровки, ВидСделки, ТипКонтрагента = "")
	
	Расчет = Новый Структура("КромеЦК, ЦК, Итог", 0, 0, 0);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(СуммыДСПоВалютнымСделкам.СуммаНеттингаПоЦК), 0) КАК СуммаНеттингаПоЦК,
		|	ЕСТЬNULL(СУММА(СуммыДСПоВалютнымСделкам.СуммаБезУчастияЦК), 0) КАК СуммаБезУчастияЦК
		|ПОМЕСТИТЬ СуммыДСПоВалютнымСделкам
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДСПоВалютнымСделкамЦКПоВидуСделки.Сумма КАК СуммаНеттингаПоЦК,
		|		0 КАК СуммаБезУчастияЦК
		|	ИЗ
		|		ДСПоВалютнымСделкам КАК ДСПоВалютнымСделкамЦКПоВидуСделки
		|	ГДЕ
		|		ДСПоВалютнымСделкамЦКПоВидуСделки.ВидСделки = &ВидСделки
		|		И ДСПоВалютнымСделкамЦКПоВидуСделки.ЭтоСделкаЦК
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-ДСПоВалютнымСделкамЦКПоОбратномуВидуСделки.Сумма,
		|		0
		|	ИЗ
		|		ДСПоВалютнымСделкам КАК ДСПоВалютнымСделкамЦКПоОбратномуВидуСделки
		|	ГДЕ
		|		ДСПоВалютнымСделкамЦКПоОбратномуВидуСделки.ВидСделки = &ОбратныйВидСделки
		|		И ДСПоВалютнымСделкамЦКПоОбратномуВидуСделки.ЭтоСделкаЦК
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		0,
		|		ДСПоВалютнымСделкамБезЦКПоВидуСделки.Сумма
		|	ИЗ
		|		ДСПоВалютнымСделкам КАК ДСПоВалютнымСделкамБезЦКПоВидуСделки
		|	ГДЕ
		|		ДСПоВалютнымСделкамБезЦКПоВидуСделки.ВидСделки = &ВидСделки
		|		И НЕ ДСПоВалютнымСделкамБезЦКПоВидуСделки.ЭтоСделкаЦК) КАК СуммыДСПоВалютнымСделкам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СуммыДСПоВалютнымСделкам.СуммаНеттингаПоЦК > 0
		|			ТОГДА СуммыДСПоВалютнымСделкам.СуммаНеттингаПоЦК + СуммыДСПоВалютнымСделкам.СуммаБезУчастияЦК
		|		ИНАЧЕ СуммыДСПоВалютнымСделкам.СуммаБезУчастияЦК
		|	КОНЕЦ КАК Итог,
		|	СуммыДСПоВалютнымСделкам.СуммаБезУчастияЦК КАК КромеЦК
		|ИЗ
		|	СуммыДСПоВалютнымСделкам КАК СуммыДСПоВалютнымСделкам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДСПоВалютнымСделкам.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ДСПоВалютнымСделкам.ISIN КАК ISIN,
		|	ДСПоВалютнымСделкам.Курс КАК Курс,
		|	ДСПоВалютнымСделкам.Биржа КАК Биржа,
		|	ДСПоВалютнымСделкам.ВалютнаяСумма КАК СуммаВалютная,
		|	ДСПоВалютнымСделкам.Сумма КАК Сумма,
		|	ДСПоВалютнымСделкам.ТипДеятельности КАК ТипДеятельности,
		|	ДСПоВалютнымСделкам.Валюта КАК Валюта,
		|	ДСПоВалютнымСделкам.ТипПозиции КАК ТипПозиции,
		|	ДСПоВалютнымСделкам.ЭтоСделкаЦК КАК ЭтоСделкаЦК,
		|	ЕСТЬNULL(ДСПоВалютнымСделкам.КонтрагентЮрЛицо.Наименование, """") КАК Контрагент
		|ИЗ
		|	ДСПоВалютнымСделкам КАК ДСПоВалютнымСделкам
		|ГДЕ
		|	ДСПоВалютнымСделкам.ВидСделки = &ВидСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СуммыДСПоВалютнымСделкам";
	
	Запрос.УстановитьПараметр("ВидСделки", ВидСделки);
	Если ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		ОбратныйВидСделки = Перечисления.ВидыСделок.Продажа;
	Иначе
		ОбратныйВидСделки = Перечисления.ВидыСделок.Покупка;
	КонецЕсли;
	Запрос.УстановитьПараметр("ОбратныйВидСделки", ОбратныйВидСделки);
	Запрос.УстановитьПараметр("ЦентральныйКонтрагент", ЦентральныйКонтрагент());
	
	Пакеты = Запрос.ВыполнитьПакет();
	Расшифровка = Пакеты[2].Выгрузить();
	
	ФильтрЦК = Новый Структура("ЭтоСделкаЦК", Истина);
	СтрокиПоТипуЦК = Расшифровка.НайтиСтроки(ФильтрЦК);
	Для Каждого СтрокаЦК Из СтрокиПоТипуЦК Цикл
		Расчет.ЦК = Расчет.ЦК + СтрокаЦК.Сумма;
	КонецЦикла;
	
	Результат = Пакеты[1];
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Расчет.Итог = ?(ЗначениеЗаполнено(Выборка.Итог), Окр(Выборка.Итог, 2), 0);
		Расчет.КромеЦК = ?(ЗначениеЗаполнено(Выборка.КромеЦК), Окр(Выборка.КромеЦК, 2), 0);
		Если Развернутый И Расшифровка.Количество() > 0 Тогда
			Если ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
				ДанныеРасшифровки.Вставить("П31", Расшифровка);
			Иначе
				ДанныеРасшифровки.Вставить("П44", Расшифровка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Расчет;
	
КонецФункции

Функция ДанныеРаздела1(МенеджерВременныхТаблиц, ДанныеОтчета)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВозвратДСКлиентам.Валюта.Код + ""-"" + ВЫБОР
		|		КОГДА ВозвратДСКлиентам.Валюта.Наименование = ""SUR""
		|			ТОГДА ""RUB""
		|		ИНАЧЕ ВозвратДСКлиентам.Валюта.Наименование
		|	КОНЕЦ КАК КодВалюты,
		|	&ИмяП20 КАК ИмяПоказателя,
		|	СУММА(ВозвратДСКлиентам.СуммаВалютная) КАК Сумма,
		|	СУММА(ВозвратДСКлиентам.Сумма) КАК СуммаРуб
		|ИЗ
		|	ВозвратДСКлиентам КАК ВозвратДСКлиентам
		|
		|СГРУППИРОВАТЬ ПО
		|	ВозвратДСКлиентам.Валюта.Код + ""-"" + ВЫБОР
		|		КОГДА ВозвратДСКлиентам.Валюта.Наименование = ""SUR""
		|			ТОГДА ""RUB""
		|		ИНАЧЕ ВозвратДСКлиентам.Валюта.Наименование
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	КодВалюты";
	Запрос.УстановитьПараметр("ИмяП20", ДанныеОтчета.ИмяП20);
	Возврат Запрос.Выполнить().Выбрать();
	
