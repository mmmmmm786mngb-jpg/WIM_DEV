Процедура СформироватьДанныеМВТ(МенеджерВременныхТаблиц, ДатаОтчета)
	
	Разделитель = "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапросаКурсыВалют() + Разделитель
		+ ТекстЗапросаПраваИспользованияДСКлиентов() + Разделитель
		+ ТекстЗапросаДСПоНезакрытымСделкам() + Разделитель
		+ ТекстЗапросаДСПоНезакрытымСделкамРЕПОДилерская() + Разделитель
		+ ТекстЗапросаДСПоНезакрытымСделкамРЕПОБрокерская() + Разделитель
		+ ТекстЗапросаДСПоВалютнымСделкам();
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаОтчета));
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(ДатаОтчета, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПустойВидЗатрат", Перечисления.ТипыУслугБиржевые.ПустаяСсылка());
	Запрос.УстановитьПараметр("РежимТорговРЕПО", Перечисления.РежимыТоргов.РЕПО);
	Запрос.УстановитьПараметр("ДниОтсрочки", 30);
	Запрос.УстановитьПараметр("ВидСделкиПокупка", Перечисления.ВидыСделок.Покупка);
	Запрос.УстановитьПараметр("ВидСделкиПродажа", Перечисления.ВидыСделок.Продажа);
	Запрос.УстановитьПараметр("ТипКотировкиРыночная", Перечисления.ТипыКотировокЦБ.РыночнаяЦена);
	Запрос.УстановитьПараметр("ТипКотировкиНКД", Перечисления.ТипыКотировокЦБ.НКД);
	Запрос.УстановитьПараметр("ЮрЛицоПустаяСсылка", Справочники.ЮридическиеЛица.ПустаяСсылка());
	Запрос.УстановитьПараметр("СостояниеСделкиОплачена", Перечисления.СостоянияСделок.Оплачена);
	Запрос.УстановитьПараметр("СостояниеСделкиЗавершена", Перечисления.СостоянияСделок.Завершена);
	Запрос.УстановитьПараметр("ДатаМоментаВремени", КонецДня(ДатаОтчета) + 1);
	Запрос.УстановитьПараметр("ЦентральныйКонтрагент", ЦентральныйКонтрагент());
	Запрос.УстановитьПараметр("Брокерская", Перечисления.ТипыДеятельности.Б);
	Запрос.УстановитьПараметр("ТипКлиентская", "Клиентская");
	Запрос.УстановитьПараметр("ТипСобственная", "Собственная");
	Запрос.УстановитьПараметр("ВалютыПустаяСсылка", Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("Руб", ОбщегоНазначенияПовтИсп.ВалютаРегламентированногоУчета());
	
	Запрос.Выполнить();
	
