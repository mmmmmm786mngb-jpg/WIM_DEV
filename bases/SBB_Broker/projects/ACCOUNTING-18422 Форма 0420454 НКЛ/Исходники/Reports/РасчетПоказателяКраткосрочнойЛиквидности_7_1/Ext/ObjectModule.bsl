#Область СлужебныйПрограммныйИнтерфейс

// Возвращает соответсвие имен разделов и табличных документов, перед этим формируя результат отчета по ним
//
// Параметры:
//  ОтправитьПоПочте - Булево - признак формирования результата для отправки уведомлений, прерывает формирование
// отчета при ошибках если значение равно Истина
//
// Возвращаемое значение:
//  Соответствие - соответсвие имен разделов и табличных документов
//
Функция ТабличныеДокументы(ОтправитьПоПочте = Ложь) Экспорт
	
	ДатаОтчета = КонецДня(Дата);
	Макет = ПолучитьМакет("Макет");
	ТабличныеДокументы = Новый Соответствие;
	ДанныеОтчета = Новый Структура;
	ДанныеРасшифровки = Новый Структура;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТекстОшибки = "";
	ПроверитьНаличиеДанныхПоБиржамГО(ТекстОшибки);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ТабличныеДокументы.Вставить("ТекстОшибки", ТекстОшибки);
		Если ОтправитьПоПочте Тогда
			Возврат ТабличныеДокументы;
		КонецЕсли;
	КонецЕсли;
	
	НКЛБрокера = "Норматив краткосрочной ликвидности брокера: ";
	
	СформироватьДанныеМВТ(МенеджерВременныхТаблиц, ДатаОтчета);
	ЗаполнитьДанныеШапки(ДанныеОтчета, ДатаОтчета);
	ЗаполнитьИменаИЗначенияПоказателей(МенеджерВременныхТаблиц, ДанныеОтчета, ДанныеРасшифровки, ДатаОтчета, НКЛБрокера);
	
	ТабДокСводно = Новый ТабличныйДокумент;
	Область = Макет.ПолучитьОбласть("ОбластьСводно");
	ЗаполнитьЗначенияСвойств(Область.Параметры, ДанныеОтчета);
	ТабДокСводно.Вывести(Область);
	ТабличныеДокументы.Вставить("Сводно", ТабДокСводно);
	
	ТабДокРаздел1 = Новый ТабличныйДокумент;
	Область = Макет.ПолучитьОбласть("ШапкаРаздел1");
	ТабДокРаздел1.Вывести(Область);
	Область = Макет.ПолучитьОбласть("СтрокаРаздел1");
	
	ДанныеРаздела1 = ДанныеРаздела1(МенеджерВременныхТаблиц, ДанныеОтчета);
	Пока ДанныеРаздела1.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Область.Параметры, ДанныеРаздела1);
		ТабДокРаздел1.Вывести(Область);
	КонецЦикла;
	ТабличныеДокументы.Вставить("Раздел1", ТабДокРаздел1);
	
	ОчиститьНКЛБрокераВДанныхОтчета(ДанныеОтчета, НКЛБрокера);
	
	ТабДокРаздел2 = Новый ТабличныйДокумент;
	Область = Макет.ПолучитьОбласть("ШапкаРаздел2");
	ТабДокРаздел2.Вывести(Область);
	Область = Макет.ПолучитьОбласть("СтрокаРаздел2");
	
	KHЮрЛиц = Новый Соответствие;
	НомерКНБезTIN = 0;
	ДанныеРаздела2 = ДанныеРаздела2(МенеджерВременныхТаблиц, ДанныеОтчета);
	Пока ДанныеРаздела2.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Область.Параметры, ДанныеРаздела2);
		Область.Параметры.КодСтраны = СокрЛП(ДанныеРаздела2.КодСтраны);
		Область.Параметры.ИНН_TIN = ИНН_TIN(ДанныеРаздела2);
		Область.Параметры.ИдентификаторКонтрагента = ИдентификаторЮрЛица(ДанныеРаздела2, Область.Параметры.ИНН_TIN, KHЮрЛиц, НомерКНБезTIN);
		ТабДокРаздел2.Вывести(Область);
	КонецЦикла;
	ТабличныеДокументы.Вставить("Раздел2", ТабДокРаздел2);
	
	ТабДокРаздел3 = Новый ТабличныйДокумент;
	Область = Макет.ПолучитьОбласть("ШапкаРаздел3");
	ТабДокРаздел3.Вывести(Область);
	Область = Макет.ПолучитьОбласть("СтрокаРаздел3");
	ЦенныеБумагиДляРеестраЦБ.Очистить();
	ДанныеРаздела3 = ДанныеРаздела3(МенеджерВременныхТаблиц, ДанныеОтчета);
	Пока ДанныеРаздела3.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Область.Параметры, ДанныеРаздела3);
		Область.Параметры.КодСтраны = СокрЛП(ДанныеРаздела3.КодСтраны);
		Область.Параметры.ИНН_TIN = ИНН_TIN(ДанныеРаздела3);
		Область.Параметры.ИдентификаторКонтрагента = ИдентификаторЮрЛица(ДанныеРаздела3, Область.Параметры.ИНН_TIN, KHЮрЛиц, НомерКНБезTIN);
		Область.Параметры.ИдентификаторЦБ = Справочники.ЦенныеБумаги.ИдентификаторЦБXBRL(ДанныеРаздела3.ЦеннаяБумагаСсылка, ДатаОтчета);
		ТабДокРаздел3.Вывести(Область);
		Если ЦенныеБумагиДляРеестраЦБ.Найти(ДанныеРаздела3.ЦеннаяБумагаСсылка, "ЦеннаяБумага") = Неопределено Тогда
			НоваяСтрока = ЦенныеБумагиДляРеестраЦБ.Добавить();
			НоваяСтрока.ЦеннаяБумага = ДанныеРаздела3.ЦеннаяБумагаСсылка;
		КонецЕсли;
	КонецЦикла;
	ТабличныеДокументы.Вставить("Раздел3", ТабДокРаздел3);
	
	ТабДокРаздел4 = Новый ТабличныйДокумент;
	Область = Макет.ПолучитьОбласть("ОбластьРаздел4");
	ЗаполнитьЗначенияСвойств(Область.Параметры, ДанныеОтчета);
	ТабДокРаздел4.Вывести(Область);
	ТабличныеДокументы.Вставить("Раздел4", ТабДокРаздел4);
	
	ВывестиТабличныеДокументыРазвернуто(ТабличныеДокументы, ДанныеРасшифровки, Макет, ДанныеОтчета);
	
	Возврат ТабличныеДокументы;
	
КонецФункции

// Формирует результаты отчета и добавляет их в уведомление к отправке
//
Процедура ОтправитьОтчетПоПочте() Экспорт
	
	ОтправитьПоПочте = Истина;
	ТабличныеДокументы = ТабличныеДокументы(ОтправитьПоПочте);
	
	ИсточникОтправки = ПланыВидовХарактеристик.ВнешниеИсточники.РассылкаПоказателяКраткосрочнойЛиквидности;
	НастройкиОтправки = ВнешниеДанные.ПолучитьПараметрыВнешнегоИсточника(ИсточникОтправки).Настройка;
	
	ПараметрыУведомления = Новый Соответствие;
	ПараметрыУведомления.Вставить("НастройкиОбмена", НастройкиОтправки);
	ПараметрыУведомления.Вставить("ТемаПисьма", "Расчет показателя краткосрочной ликвидности (ТАКСОНОМИЯ 7.1)");
	ПараметрыУведомления.Вставить("ТекстПисьма", "");
	ПараметрыУведомления.Вставить("ТипТекстаПисьма", ТипТекстаПочтовогоСообщения.HTML);
	ПараметрыУведомления.Вставить("Кодировка", "UTF-8");
	
	ТекстОшибки = ТабличныеДокументы.Получить("ТекстОшибки");
	Если НЕ ТекстОшибки = Неопределено Тогда
		ПараметрыУведомления.Вставить("ТекстПисьма", ТекстОшибки);
		ЗаписьЖурналаРегистрации("Отправка отчета 'Расчет показателя краткосрочной ликвидности (ТАКСОНОМИЯ 7.1)'",
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	Иначе
		ДанныеФайлов = ДанныеФайловExcel(ТабличныеДокументы);
		Вложения = Новый Соответствие;
		
		Для Каждого ДанныеФайла Из ДанныеФайлов Цикл
			ОтправляемыйФайл = Новый ДвоичныеДанные(ДанныеФайла.Значение);
			Вложения.Вставить(ДанныеФайла.Ключ, ОтправляемыйФайл);
			УдалитьФайлы(ДанныеФайла.Значение);
		КонецЦикла;
		
		ПараметрыУведомления.Вставить("Вложения", Вложения);
	КонецЕсли;
	
	РегистрыСведений.УведомленияКОтправке.ДобавитьУведомлениеКотправке(ПараметрыУведомления);
	
КонецПроцедуры

// Возвращает соответствие имен и путей файлов Excel, перед этим сохранив их из
// переданных табличных документов
//
// Параметры:
//  ТабличныеДокументы	 - Соответствие - соответствие имен разделов и табличных документов
//
// Возвращаемое значение:
//  Соответствие - соответствие имен и путей файлов Excel
//
Функция ДанныеФайловExcel(ТабличныеДокументы) Экспорт
	
	ОбрабатываемыеВкладки = Новый Массив;
	ОбрабатываемыеВкладки.Добавить("1");
	ОбрабатываемыеВкладки.Добавить("2");
	ОбрабатываемыеВкладки.Добавить("3");
	
	ДанныеФайлов = Новый Соответствие;
	
	ЗаписатьФайлОтчетаПКЛ(ДанныеФайлов, ОбрабатываемыеВкладки, ТабличныеДокументы);
	ЗаписатьФайлыТаксономии(ДанныеФайлов, ОбрабатываемыеВкладки, ТабличныеДокументы);
	
	Возврат ДанныеФайлов;
	
КонецФункции

// Процедура - Сохранить настройки
//
// Параметры:
//  ИмяОтчета			 - Строка - Название отчета
//  ИмяНастроек	 - Строка - Название настроек
//
Процедура СохранитьНастройки(ИмяОтчета, ИмяНастроек) Экспорт
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Развернутый", Развернутый);
	СтруктураПараметров.Вставить("КаталогФайла", КаталогФайла);
	
	ХранилищеОбщихНастроек.Сохранить(ИмяОтчета, "СтруктураПараметров" + ИмяНастроек, СтруктураПараметров);
	
КонецПроцедуры

// Процедура - Восстановить настройки
//
// Параметры:
//  ИмяОтчета			 - Строка - Название отчета
//  ИмяНастроек	 - Строка - Название настроек
//
Процедура ВосстановитьНастройки(ИмяОтчета, ИмяНастроек) Экспорт
	
	СтруктураПараметров = ХранилищеОбщихНастроек.Загрузить(ИмяОтчета, "СтруктураПараметров" + ИмяНастроек);
	
	Если СтруктураПараметров <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, СтруктураПараметров);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Сохранить список ЦБ Для формирования реестра ЦБ
//
Процедура СохранитьСписокЦБДляФормированияРеестраЦБ() Экспорт
	
	ВидОтчета =
		Справочники.XBRLВидыОтчетов.ПолучитьСоздатьПоКоду("0420454_7.1", "0420454_7.1 Расчет норматива краткосрочной ликвидности брокера");
	ОтчетнаяДата = КонецДня(Дата);
	
	Если НЕ ЗначениеЗаполнено(ТочкаВхода) Тогда
		ТекстОшибки = "Не указана точка входа XBRL.";
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	РегистрыСведений.XBRLРеестрЦенныхБумаг.ЗаписатьДанные(ВидОтчета, ТочкаВхода, ОтчетнаяДата, ЦенныеБумагиДляРеестраЦБ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОчиститьНКЛБрокераВДанныхОтчета(ДанныеОтчета, НКЛБрокера)
	
	НачалоПозицииНовогоЗначенияПоказателя = СтрДлина(НКЛБрокера) + 1;
	
	Для Каждого ПоказательОтчета Из ДанныеОтчета Цикл
		ЗначениеПоказателяСтрокой = СокрЛП(ПоказательОтчета.Значение);
		Если СтрНайти(ЗначениеПоказателяСтрокой, НКЛБрокера) > 0 Тогда
			НовоеЗначениеПоказателя = Сред(ПоказательОтчета.Значение, НачалоПозицииНовогоЗначенияПоказателя);
			ДанныеОтчета[ПоказательОтчета.Ключ] = НовоеЗначениеПоказателя;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиТабличныеДокументыРазвернуто(ТабличныеДокументы, ДанныеРасшифровки, Макет, ДанныеОтчета)
	
	Если Развернутый Тогда
		
		НомерПункта = "";
		
		Для Каждого Расшифровка Из ДанныеРасшифровки Цикл
			
			Если Лев(Расшифровка.Ключ, 3) <> НомерПункта Тогда
				НомерПункта = Лев(Расшифровка.Ключ, 3);
				ТабДокСтрока = Новый ТабличныйДокумент;
			КонецЕсли;
			
			ИмяСвойства = Расшифровка.Ключ;
			
			ПоказателиСИтогами = Новый Массив;
			ПоказателиСИтогами.Добавить("П22");
			ПоказателиСИтогами.Добавить("П37");
			ПоказателиСИтогами.Добавить("П27");
			ПоказателиСИтогами.Добавить("П41");
			ПоказателиСИтогами.Добавить("П29");
			ПоказателиСИтогами.Добавить("П43");
			ПоказателиСИтогами.Добавить("П31");
			ПоказателиСИтогами.Добавить("П44");
			Если ПоказателиСИтогами.Найти(ИмяСвойства) = Неопределено Тогда
				ВыводитьИтоги = Ложь;
			Иначе
				ВыводитьИтоги = Истина;
			КонецЕсли;
			
			ВывестиРасшифровку(ДанныеРасшифровки, ИмяСвойства, Макет, ТабДокСтрока, ДанныеОтчета, ВыводитьИтоги);
			
			Если ТабличныеДокументы.Получить(НомерПункта) = Неопределено Тогда
				ТабличныеДокументы.Вставить(НомерПункта, ТабДокСтрока);
			Иначе
				ТабличныеДокументы[НомерПункта] = ТабДокСтрока;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьФайлыТаксономии(Знач ДанныеФайлов, Знач ОбрабатываемыеВкладки, Знач ТабличныеДокументы)
	
	Для НомерЛиста = 0 По 4 Цикл
		
		ПакетДокументов = Новый ПакетОтображаемыхДокументов;
		
		Если НомерЛиста = 0 Тогда
			ТабДок = ТабличныеДокументы.Получить("Сводно");
			НомерТаблицы = 106;
		Иначе
			ТабДок = ТабличныеДокументы.Получить("Раздел" + НомерЛиста);
			НомерТаблицы = НомерТаблицы + 1;
		КонецЕсли;
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".xlsx");
		ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
		
		ЛистПакетаДокументов = ПакетДокументов.Состав.Добавить();
		ЛистПакетаДокументов.Наименование = ?(НомерЛиста = 0, "Сводно", НомерЛиста);
		ЛистПакетаДокументов.Данные = ПоместитьВоВременноеХранилище(ТабДок);
		
		Если НомерЛиста = 0 Тогда
			ИмяФайла = "0420454 Сводно (Таксономия 7.1).xlsx";
		Иначе
			ИмяФайла = "0420454 Расшифровка " + НомерЛиста + " (Таксономия 7.1).xlsx";
		КонецЕсли;
		Если ЗначениеЗаполнено(КаталогФайла) Тогда
			ПутьКФайлу = КаталогФайла + "\" + ИмяФайла;
		Иначе
			ПутьКФайлу = ПолучитьИмяВременногоФайла(".xlsx");
		КонецЕсли;
		
		Попытка
			ПакетДокументов.Записать(ПутьКФайлу, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
		Исключение
			ТекстСообщения = "Сохранение в " + ПутьКФайлу + " невозможно. (Укажите доступный сетевой каталог)" + Символы.ПС;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			УдалитьФайлы(ИмяВременногоФайла);
			ВызватьИсключение ТекстСообщения;
		КонецПопытки;
		
		Если ОбрабатываемыеВкладки.Найти(Строка(НомерЛиста)) <> Неопределено Тогда
			ПараметрыЗаполненияЯчеек = РаботаСФайламиМайкрософтОфис.НовыеПараметрыЗаполненияЯчеек();
			ПодготовитьПараметрыЗаполненияЯчеек(Строка(НомерЛиста), ПараметрыЗаполненияЯчеек, ТабДок.ВысотаТаблицы);
			РаботаСФайламиМайкрософтОфис.РедактироватьФайлXLSX(ПутьКФайлу, ПараметрыЗаполненияЯчеек);
		КонецЕсли;
		
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
			УровеньПредупреждение = УровеньЖурналаРегистрации.Предупреждение;
			ИмяСобытия = "РасчетПоказателяКраткосрочнойЛиквидности_7_1.ДанныеФайловExcel";
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньПредупреждение, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
		ДанныеФайлов.Вставить(ИмяФайла, ПутьКФайлу);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьФайлОтчетаПКЛ(Знач ДанныеФайлов, Знач ОбрабатываемыеВкладки, Знач ТабличныеДокументы)
	
	ПакетДокументов = Новый ПакетОтображаемыхДокументов;
	ПараметрыЗаполненияЯчеек = РаботаСФайламиМайкрософтОфис.НовыеПараметрыЗаполненияЯчеек();
	
	Для Каждого ТабДок Из ТабличныеДокументы Цикл
		
		// Переименуем лист в общем файле
		Если СтрНайти(ТабДок.Ключ, "Раздел") Тогда
			ИмяЛиста = СтрЗаменить(ТабДок.Ключ, "Раздел", "");
		ИначеЕсли СтрНайти(ТабДок.Ключ, "Строка") Тогда
			ИмяЛиста = СтрЗаменить(ТабДок.Ключ, "Строка", "Строка ");
		Иначе
			ИмяЛиста = ТабДок.Ключ;
		КонецЕсли;
		
		ЛистПакетаДокументов = ПакетДокументов.Состав.Добавить();
		ЛистПакетаДокументов.Наименование = ИмяЛиста;
		ЛистПакетаДокументов.Данные = ПоместитьВоВременноеХранилище(ТабДок.Значение);
		
		Если ОбрабатываемыеВкладки.Найти(ИмяЛиста) <> Неопределено Тогда
			ПодготовитьПараметрыЗаполненияЯчеек(ИмяЛиста, ПараметрыЗаполненияЯчеек, ТабДок.Значение.ВысотаТаблицы);
		КонецЕсли;
		
	КонецЦикла;
	
	РасширениеФайла = ".xlsx";
	
	ИмяФайла = "ПКЛ_" + Формат(Дата, "ДФ=ddMMyyyy") + РасширениеФайла;
	
	Если ЗначениеЗаполнено(КаталогФайла) Тогда
		ПутьКФайлу = КаталогФайла + "\" + ИмяФайла;
	Иначе
		ПутьКФайлу = ПолучитьИмяВременногоФайла(РасширениеФайла);
	КонецЕсли;
	
	ДанныеФайлов.Вставить(ИмяФайла, ПутьКФайлу);
	
	ВременныйФайл = ПолучитьИмяВременногоФайла(РасширениеФайла);
	ПакетДокументов.Записать(ВременныйФайл, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
	
	РаботаСФайламиМайкрософтОфис.РедактироватьФайлXLSX(ВременныйФайл, ПараметрыЗаполненияЯчеек);
	
	Попытка
		КопироватьФайл(ВременныйФайл, ПутьКФайлу);
	Исключение
		ТекстСообщения = "Сохранение в " + ПутьКФайлу + " невозможно. (Укажите доступный сетевой каталог)" + Символы.ПС;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	
	УдалитьФайлы(ВременныйФайл);
	
КонецПроцедуры

Процедура ПодготовитьПараметрыЗаполненияЯчеек(ИмяЛиста, ПараметрыЗаполненияЯчеек, ВысотаТаблицы)
	
	// Формат ячейки - строка
	Если ИмяЛиста = "1" Тогда
		КолонкиРаздел = "2";
	ИначеЕсли ИмяЛиста = "2" Тогда
		КолонкиРаздел = "3";
	ИначеЕсли ИмяЛиста = "3" Тогда
		КолонкиРаздел = "4,9,10";
	Иначе
		КолонкиРаздел = "2";
	КонецЕсли;
	
	МассивКолонокРаздел = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиРаздел);
	
	НоваяСтрокаПараметров = ПараметрыЗаполненияЯчеек.Добавить();
	НоваяСтрокаПараметров.ИмяЛиста = ИмяЛиста;
	НоваяСтрокаПараметров.ВысотаТаблицы = ВысотаТаблицы;
	НоваяСтрокаПараметров.МассивКолонок = МассивКолонокРаздел;
	НоваяСтрокаПараметров.ТипЯчейки = Тип("Строка");
	
	// Формат ячейки - число
	Если ИмяЛиста = "1" Тогда
		КолонкиРаздел = "3,4";
	ИначеЕсли ИмяЛиста = "2" Тогда
		КолонкиРаздел = "6,7";
	ИначеЕсли ИмяЛиста = "3" Тогда
		КолонкиРаздел = "6,7,12";
	Иначе
		КолонкиРаздел = "3,4,5";
	КонецЕсли;
	
	МассивКолонокРаздел = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиРаздел);
	
	НоваяСтрокаПараметров = ПараметрыЗаполненияЯчеек.Добавить();
	НоваяСтрокаПараметров.ИмяЛиста = ИмяЛиста;
	НоваяСтрокаПараметров.ВысотаТаблицы = ВысотаТаблицы;
	НоваяСтрокаПараметров.МассивКолонок = МассивКолонокРаздел;
	НоваяСтрокаПараметров.ТипЯчейки = Тип("Число");
	
КонецПроцедуры

Процедура ЗаполнитьДанныеШапки(ДанныеОтчета, ДатаОтчета)
	
	ДанныеОтчета.Вставить("Организация", Организация);
	ДанныеОтчета.Вставить("ИНН", Организация.ИНН);
	ДанныеОтчета.Вставить("ОтветственноеЛицо", "");
	ДанныеОтчета.Вставить("Телефон", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ФИОФизЛицСрезПоследних.Фамилия + "" "" + ПОДСТРОКА(ФИОФизЛицСрезПоследних.Имя, 1, 1) + "". "" + ПОДСТРОКА(ФИОФизЛицСрезПоследних.Отчество, 1, 1) + ""., "" + ОтветственныеЛицаСрезПоследних.Должность.Наименование КАК ОтветственноеЛицо,
		|	КонтактнаяИнформацияСрезПоследних.Представление КАК Телефон
		|ИЗ
		|	РегистрСведений.ОтветственныеЛица.СрезПоследних(
		|			&Дата,
		|			ЮрЛицо = &Организация
		|				И Должность = &Должность) КАК ОтветственныеЛицаСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизЛиц.СрезПоследних(&Дата, 1 = 1) КАК ФИОФизЛицСрезПоследних
		|		ПО ОтветственныеЛицаСрезПоследних.ФизЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Дата,
		|				Вид = &ВидКонтактнойИнформации
		|					И Тип = &ТипКонтактнойИнформации) КАК КонтактнаяИнформацияСрезПоследних
		|		ПО ОтветственныеЛицаСрезПоследних.ФизЛицо = КонтактнаяИнформацияСрезПоследних.Объект";
	
	Запрос.УстановитьПараметр("Дата", ДатаОтчета);
	Запрос.УстановитьПараметр("Должность", Справочники.ДолжностиОрганизаций.ГлавныйБухгалтер);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТипКонтактнойИнформации", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("ВидКонтактнойИнформации", Справочники.ВидыКонтактнойИнформации.ТелефонФизЛица);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеОтчета.ОтветственноеЛицо = Выборка.ОтветственноеЛицо;
		ДанныеОтчета.Телефон = Выборка.Телефон;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьИменаИЗначенияПоказателей(МенеджерВременныхТаблиц, ДанныеОтчета, ДанныеРасшифровки, ДатаОтчета, НКЛБрокера)
	
	ДанныеОтчета.Вставить("ИмяП3", НКЛБрокера + "Денежные средства, находящиеся в кассе");
	ДанныеОтчета.Вставить("П3", 0);
	
	ДанныеОтчета.Вставить("ИмяП4", НКЛБрокера
		+ "Денежные средства брокера, находящиеся на расчетных счетах в кредитных организациях и (или) иностранных банках");
	ДанныеОтчета.Вставить("П4",
		ОстаткиДСПоТипуДеятельности(МенеджерВременныхТаблиц, ДанныеРасшифровки, ДатаОтчета, Перечисления.ТипыДеятельности.Д));
	
	ДанныеОтчета.Вставить("ИмяП5", НКЛБрокера + "Денежные средства клиентов брокера, полученные с правом использования в интересах брокера,"
		+ " находящиеся на специальных брокерских счетах в кредитных организациях и (или) в иностранных банках");
	ДанныеОтчета.Вставить("П5",
		ОстаткиДСПоТипуДеятельности(МенеджерВременныхТаблиц, ДанныеРасшифровки, ДатаОтчета, Перечисления.ТипыДеятельности.Б));
	
	ДанныеОтчета.Вставить("ИмяП6", НКЛБрокера
		+ "Драгоценные металлы, находящиеся на счетах в кредитных организациях и (или) иностранных банках");
	ДанныеОтчета.Вставить("П6", 0);
	
	ДанныеОтчета.Вставить("ИмяП7", НКЛБрокера
		+ "Драгоценные металлы на банковских вкладах (депозитах) в кредитных организациях и (или) иностранных банках");
	ДанныеОтчета.Вставить("П7", 0);
	
	ДанныеОтчета.Вставить("ИмяП8", НКЛБрокера
		+ "Денежные средства во вкладах (депозитах) в кредитных организациях и (или) иностранных банках");
	ДанныеОтчета.Вставить("П8", 0);
	
	ДанныеОтчета.Вставить("ИмяП9", НКЛБрокера
		+ "Денежные средства, переданные по договору о брокерском обслуживании брокеру и (или) иностранному лицу,"
		+ " имеющему право в соответствии с его личным законом осуществлять брокерскую деятельность на рынке ценных бумаг");
	ДанныеОтчета.Вставить("П9", 0);
	
	ДанныеОтчета.Вставить("ИмяП10", НКЛБрокера
		+ "Денежные средства, драгоценные металлы и ценные бумаги, являющиеся индивидуальным клиринговым обеспечением,"
		+ " которые могут быть получены брокером в соответствии с договором об оказании клиринговых услуг");
	ДанныеОтчета.Вставить("П10", ИКОиКСУ(МенеджерВременныхТаблиц, ДанныеРасшифровки, ДатаОтчета));
	
	ДанныеОтчета.Вставить("ИмяП11", НКЛБрокера + "Ценные бумаги, удовлетворяющие требованиям ВЛА-1,"
		+ "за исключением ценных бумаг, полученных по операциям репо или займа ценных бумаг");
	ДанныеОтчета.Вставить("П11", 0);
	
	ДанныеОтчета.Вставить("ИмяП12", НКЛБрокера
		+ "Ценные бумаги, удовлетворяющие требованиям ВЛА-1, полученные по операциям репо ценных бумаг");
	ДанныеОтчета.Вставить("П12", 0);
	
	ДанныеОтчета.Вставить("ИмяП13", НКЛБрокера
		+ "Ценные бумаги, удовлетворяющие требованиям ВЛА-1, полученные по операциям займа ценных бумаг");
	ДанныеОтчета.Вставить("П13", 0);
	
	ДанныеОтчета.Вставить("ИмяП2", НКЛБрокера + "Итого высоколиквидные активы первого уровня:");
	ДанныеОтчета.Вставить("П2", ДанныеОтчета.П3 + ДанныеОтчета.П4 + ДанныеОтчета.П5 + ДанныеОтчета.П6
		+ ДанныеОтчета.П7 + ДанныеОтчета.П8 + ДанныеОтчета.П9 + ДанныеОтчета.П10
		+ ДанныеОтчета.П11 + ДанныеОтчета.П12 + ДанныеОтчета.П13);
	
	ДанныеОтчета.Вставить("ИмяП15", НКЛБрокера + "Ценные бумаги, удовлетворяющие требованиям ВЛА-2,"
		+ " за исключением ценных бумаг, полученных по операциям репо или займа ценных бумаг");
	ДанныеОтчета.Вставить("П15", 0);
	
	ДанныеОтчета.Вставить("ИмяП16", НКЛБрокера + "Ценные бумаги, удовлетворяющие требованиям ВЛА-2,"
		+ " полученные по операциям репо ценных бумаг");
	ДанныеОтчета.Вставить("П16", 0);
	
	ДанныеОтчета.Вставить("ИмяП17", НКЛБрокера
		+ "Ценные бумаги, удовлетворяющие требованиям ВЛА-2, полученные по операциям займа ценных бумаг");
	ДанныеОтчета.Вставить("П17", 0);
	
	ДанныеОтчета.Вставить("ИмяП14", НКЛБрокера + "Итого высоколиквидные активы второго уровня");
	ДанныеОтчета.Вставить("П14", ДанныеОтчета.П15 + ДанныеОтчета.П16 + ДанныеОтчета.П17);
	
	ДанныеОтчета.Вставить("ИмяП18", НКЛБрокера + "Величина корректировки высоколиквидных активов");
	ДанныеОтчета.Вставить("П18", 0);
	
	ДанныеОтчета.Вставить("ИмяП1", НКЛБрокера + "ИТОГО высоколиквидные активы");
	ДанныеОтчета.Вставить("П1", ДанныеОтчета.П2 + ДанныеОтчета.П14 + ДанныеОтчета.П18);
	
	ДанныеОтчета.Вставить("ИмяП20", НКЛБрокера + "Оттоки по возврату средств клиентов по договорам о брокерском обслуживании,"
		+ " в соответствии с которыми клиентами предоставлено брокеру право использования их денежных средств в его интересах,"
		+ " рассчитываемые как произведение коэффициента оттока денежных средств, равного 0,3,"
		+ " и суммарной величины планового исходящего остатка по денежным средствам каждого клиента");
	ДанныеОтчета.Вставить("П20", ВозвратДСКлиентам(МенеджерВременныхТаблиц, ДанныеРасшифровки, ДатаОтчета));
	
	ДанныеОтчета.Вставить("ИмяП21", НКЛБрокера
		+ "Оттоки по полученным займам и кредитам (в том числе просроченным) с учетом подлежащих выплате процентов");
	ДанныеОтчета.Вставить("П21", 0);
	
	ВидСделки = Перечисления.ВидыСделок.Покупка;
	ДанныеОтчета.Вставить("ИмяП22", НКЛБрокера + "Оттоки по передаче денежных средств по договорам купли-продажи ценных бумаг");
	ДСПоНезакрытымСделкам = ДСПоНезакрытымСделкам(МенеджерВременныхТаблиц, ДанныеРасшифровки, ВидСделки);
	ДанныеОтчета.Вставить("П22", ДСПоНезакрытымСделкам.КромеЦК);
	ДанныеОтчета.Вставить("П22цк", ДСПоНезакрытымСделкам.ЦК);
	ДанныеОтчета.Вставить("П22итог", ДСПоНезакрытымСделкам.Итог);
	
	ДанныеОтчета.Вставить("ИмяП23", НКЛБрокера
		+ " Оттоки по выпущенным брокером долговым ценным бумагам с учетом подлежащего выплате процентного (купонного) дохода");
	ДанныеОтчета.Вставить("П23", 0);
	
	ДанныеОтчета.Вставить("ИмяП24", НКЛБрокера + " Оттоки по возврату денежных средств, полученных брокером по сделкам займа (кредита),"
		+ " исполнение обязательств брокера по которым обеспечено ценными бумагами, удовлетворяющими критериям ВЛА-1,"
		+ " за вычетом величины указанных ценных бумаг");
	ДанныеОтчета.Вставить("П24", 0);
	
	ДанныеОтчета.Вставить("ИмяП25", НКЛБрокера + "Оттоки по возврату денежных средств, полученных брокером по сделкам займа (кредита),"
		+ " исполнение обязательств брокера по которым обеспечено ценными бумагами, удовлетворяющими критериям ВЛА-2,"
		+ " за вычетом величины указанных ценных бумаг");
	ДанныеОтчета.Вставить("П25", 0);
	
	ДанныеОтчета.Вставить("ИмяП26", НКЛБрокера + "Оттоки по возврату денежных средств, полученных брокером по сделкам займа (кредита),"
		+ " исполнение обязательств брокера по которым обеспечено ценными бумагами,"
		+ " не удовлетворяющими критериям ВЛА-1 и ВЛА-2");
	ДанныеОтчета.Вставить("П26", 0);
	
	ДанныеОтчета.Вставить("ИмяП27", НКЛБрокера + "Оттоки по возврату денежных средств по договорам репо,"
		+ " предоставленных брокеру под обеспечение ценными бумагами, удовлетворяющими критериям ВЛА-1,"
		+ " за вычетом величины указанных ценных бумаг");
	ДСПоНезакрытымСделкамРЕПОДилерская = ДСПоНезакрытымСделкамРЕПОДилерская(МенеджерВременныхТаблиц, ДанныеРасшифровки, ВидСделки);
	ДанныеОтчета.Вставить("П27", ДСПоНезакрытымСделкамРЕПОДилерская.КромеЦК);
	ДанныеОтчета.Вставить("П27цк", ДСПоНезакрытымСделкамРЕПОДилерская.ЦК);
	ДанныеОтчета.Вставить("П27итог", ДСПоНезакрытымСделкамРЕПОДилерская.Итог);
	
	ДанныеОтчета.Вставить("ИмяП28", НКЛБрокера + "Оттоки по возврату денежных средств по договорам репо,"
		+ " предоставленных брокеру под обеспечение ценными бумагами, удовлетворяющими критериям ВЛА-2,"
		+ " за вычетом величины указанных ценных бумаг");
	ДанныеОтчета.Вставить("П28", 0);
	
	ДанныеОтчета.Вставить("ИмяП29", НКЛБрокера + "Оттоки по возврату денежных средств по договорам репо,"
