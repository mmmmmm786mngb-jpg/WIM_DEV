Функция ИНН_TIN(Выборка)
	
	ЭтоРезидент = (Выборка.КодСтраны = Справочники.КлассификаторСтранМира.РОССИЯ.Код);
	
	Если ЭтоРезидент Тогда
		Если ЗначениеЗаполнено(Выборка.ИНН) Тогда
			Возврат СокрЛП(Выборка.ИНН);
		Иначе
			Возврат "0000000000";
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Выборка.TIN) Тогда
			Возврат Выборка.TIN;
		ИначеЕсли ЗначениеЗаполнено(Выборка.РегНомер) Тогда
			Возврат Выборка.РегНомер;
		Иначе
			Возврат "000";
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ИдентификаторЮрЛица(Выборка, ИНН_TIN, KHЮрЛиц, НомерКНБезTIN)
	
	КодСтраны = СокрЛП(Выборка.КодСтраны);
	ЭтоРезидент = (КодСтраны = СокрЛП(Справочники.КлассификаторСтранМира.РОССИЯ.Код));
	
	Если ЭтоРезидент Тогда
		Возврат КодСтраны + "_" + ИНН_TIN
		+ "_" + ?(ЗначениеЗаполнено(Выборка.ОГРН), Выборка.ОГРН, "0000000000000")
		+ "_" + ?(ЗначениеЗаполнено(Выборка.КПП), Выборка.КПП, "000000000");
	Иначе
		KHЮрЛица = KHЮрЛиц.Получить(Выборка.КонтрагентЮрЛицо);
		Если KHЮрЛица = Неопределено Тогда
			Если ИНН_TIN = "000" Тогда
				НомерКНБезTIN = НомерКНБезTIN + 1;
				KHЮрЛица = НомерКНБезTIN;
				KHЮрЛица = "KH" + Формат(KHЮрЛица, "ЧЦ=4; ЧВН=; ЧГ=0");
			Иначе
				KHЮрЛица = "KH0000";
			КонецЕсли;
			KHЮрЛиц.Вставить(Выборка.КонтрагентЮрЛицо, KHЮрЛица);
		КонецЕсли;
		
		Возврат КодСтраны + "_" + ИНН_TIN + "_" + KHЮрЛица;
	КонецЕсли;
	
КонецФункции

Процедура ВывестиРасшифровку(ДанныеРасшифровки, ИмяСвойства, Макет, ТабДок, ДанныеОтчета, ВыводитьИтоги)
	
	ТЗРасшифровки = Неопределено;
	
	Если ДанныеРасшифровки.Свойство(ИмяСвойства, ТЗРасшифровки) Тогда
		
		ТабДок.НачатьАвтогруппировкуСтрок();
		
		ВывестиОбластьВМакет("Шапка" + ИмяСвойства, Макет, ТабДок, ДанныеОтчета, 0, ИмяСвойства);
		
		ИмяПрефиксаСтрока = "Строка";
		СуммаИтого = 0;
		Для Каждого СтрокаТЗ Из ТЗРасшифровки Цикл
			СтруктураСтроки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТЗ);
			
			Если СтруктураСтроки.Свойство("ЭтоСделкаЦК") И СтруктураСтроки.ЭтоСделкаЦК Тогда
				ВывестиОбластьВМакет(ИмяПрефиксаСтрока + ИмяСвойства + "НКЦ", Макет, ТабДок, СтруктураСтроки, 1, ИмяСвойства);
			Иначе
				ВывестиОбластьВМакет(ИмяПрефиксаСтрока + ИмяСвойства, Макет, ТабДок, СтруктураСтроки, 1, ИмяСвойства);
			КонецЕсли;
			
			Если ВыводитьИтоги И СтруктураСтроки.Свойство("Сумма") Тогда
				СуммаИтого = СуммаИтого + СтруктураСтроки.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		Если ВыводитьИтоги Тогда
			СтруктураИтоги = Новый Структура("Сумма", СуммаИтого);
			ВывестиОбластьВМакет(ИмяПрефиксаСтрока + ИмяСвойства + "Итого", Макет, ТабДок, СтруктураИтоги, 1, ИмяСвойства);
		КонецЕсли;
		
		ТабДок.ЗакончитьАвтогруппировкуСтрок();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиОбластьВМакет(ИмяОбласти, Макет, ТабДок, ДанныеОтчета, Уровень = 0, ИмяГруппы = "")
	
	Область = Макет.ПолучитьОбласть(ИмяОбласти);
	ЗаполнитьЗначенияСвойств(Область.Параметры, ДанныеОтчета);
	
	Если ДанныеОтчета.Свойство("Банк") Тогда
		Область.Параметры.Банк = Строка(ДанныеОтчета.Банк) + " (" + СокрЛП(Строка(ДанныеОтчета.БанкКод)) + ")";
	КонецЕсли;
	Если ДанныеОтчета.Свойство("ЦеннаяБумага") Тогда
		Область.Параметры.ЦеннаяБумага = Строка(ДанныеОтчета.ЦеннаяБумага) + " (" + Строка(ДанныеОтчета.ISIN) + ")";
	КонецЕсли;
	
	Если ИмяГруппы = "П33" ИЛИ ИмяГруппы = "П35" ИЛИ ИмяГруппы = "П37" Тогда
		Если ДанныеОтчета.Свойство("КодСтраны") Тогда
			Область.Параметры.КодСтраны = СокрЛП(ДанныеОтчета.КодСтраны);
		КонецЕсли;
	КонецЕсли;
	
	ТабДок.Вывести(Область, Уровень, ИмяГруппы);
	
КонецПроцедуры

Функция ОстаткиДСПоТипуДеятельности(МенеджерВременныхТаблиц, ДанныеРасшифровки, ДатаОтчета, ТипДеятельности)
	
	СуммаВозврата = 0;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка КАК Ссылка,
		|	БанковскиеСчета.ТипНазначения КАК ТипСчета,
		|	БанковскиеСчета.Банк КАК Банк
		|ПОМЕСТИТЬ БСОрганизации
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
