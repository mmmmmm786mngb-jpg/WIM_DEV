	|		ПО ДенежныеСредстваВПутиБОстатки.Договор.Владелец = Клиенты.Клиент
	|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыВалют КАК КурсыВалют
	|		ПО ДенежныеСредстваВПутиБОстатки.Валюта = КурсыВалют.Валюта
	|ГДЕ
	|	ВЫБОР
	|			КОГДА -ЕСТЬNULL(ДенежныеСредстваВПутиБОстатки.ВалютнаяСуммаОстаток, 0) > 0
	|				ТОГДА -ЕСТЬNULL(ДенежныеСредстваВПутиБОстатки.ВалютнаяСуммаОстаток, 0) > 0
	|			ИНАЧЕ ЕСТЬNULL(ДенежныеСредстваВПутиБОстатки.ВалютнаяСуммаОстаток, 0) > 0
	|		КОНЕЦ";
	
КонецФункции

Процедура ПроверитьНаличиеДанныхПоБиржамГО(ТекстОшибки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	Биржи.Ссылка КАК Биржа
		|ПОМЕСТИТЬ БиржиГО
		|ИЗ
		|	Справочник.Биржи КАК Биржи
		|ГДЕ
		|	Биржи.Ссылка В(&БиржиГО)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БиржиГО.Биржа КАК Биржа
		|ИЗ
		|	БиржиГО КАК БиржиГО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗагрузкаДанныхГО КАК ЗагрузкаДанныхГО
		|		ПО БиржиГО.Биржа = ЗагрузкаДанныхГО.Биржа
		|			И (ЗагрузкаДанныхГО.Дата = &Дата)
		|			И (ЗагрузкаДанныхГО.ОтчетЗагружен)
		|ГДЕ
		|	ЗагрузкаДанныхГО.Биржа ЕСТЬ NULL ";
	
	БиржиГО = Новый Массив;
	БиржиГО.Добавить(Справочники.Биржи.FORTS);
	БиржиГО.Добавить(Справочники.Биржи.MICEX);
	БиржиГО.Добавить(Справочники.Биржи.MICEXSELT);
	Запрос.УстановитьПараметр("Дата", ДатаГарантийногоОбеспечения());
	Запрос.УстановитьПараметр("БиржиГО", БиржиГО);
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		ТекстОшибки = "Отсутствуют данные по Гарантийному обеспечению для следующих бирж: ";
		Пока Выборка.Следующий() Цикл
			ТекстОшибки = ТекстОшибки + СокрЛП(Выборка.Биржа) + "; ";
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ДатаГарантийногоОбеспечения()
	
	Если ОбщегоНазначения.РабочийДень(Дата) Тогда
		Возврат Дата;
	Иначе
		Возврат ОбщегоНазначения.ПредыдущийРабочийДень(Дата);
	КонецЕсли;
	
КонецФункции

Функция ЦентральныйКонтрагент()
	Возврат Константы.КлиринговаяОрганизация.Получить();
КонецФункции

#КонецОбласти