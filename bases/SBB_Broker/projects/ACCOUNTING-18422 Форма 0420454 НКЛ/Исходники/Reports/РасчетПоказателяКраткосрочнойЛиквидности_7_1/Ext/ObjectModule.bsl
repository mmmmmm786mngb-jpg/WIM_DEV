		|	СУММА(ЦенныеБумагиДОстатки.КоличествоОстаток) КАК Количество,
		|	СУММА(ЕСТЬNULL(НоминалЦБСрезПоследних.Сумма, 1)) КАК Цена,
		|	СУММА(ВЫРАЗИТЬ(ЦенныеБумагиДОстатки.КоличествоОстаток * ЕСТЬNULL(НоминалЦБСрезПоследних.Сумма, 1) КАК ЧИСЛО(19, 2))) КАК Сумма,
		|	СУММА(ВЫРАЗИТЬ(ЦенныеБумагиДОстатки.КоличествоОстаток * ЕСТЬNULL(НоминалЦБСрезПоследних.Сумма, 1) * ЕСТЬNULL(КурсыВалют.Курс, 0) / ЕСТЬNULL(КурсыВалют.Кратность, 1) КАК ЧИСЛО(19, 2))) КАК СуммаРуб,
		|	ЦенныеБумагиДОстатки.Депозитарий КАК Депозитарий
		|ПОМЕСТИТЬ КСУ
		|ИЗ
		|	РегистрНакопления.ЦенныеБумагиДКоличество.Остатки(
		|			&МоментВремени,
		|			Организация = &Организация
		|				И ЦеннаяБумага.ВидЦББанкаРоссии = &КСУ) КАК ЦенныеБумагиДОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалЦБ.СрезПоследних(&МоментВремени, 1 = 1) КАК НоминалЦБСрезПоследних
		|		ПО ЦенныеБумагиДОстатки.ЦеннаяБумага = НоминалЦБСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыВалют КАК КурсыВалют
		|		ПО ЦенныеБумагиДОстатки.ЦеннаяБумага.ВалютаНоминала = КурсыВалют.Валюта
		|ГДЕ
		|	ЦенныеБумагиДОстатки.КоличествоОстаток > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦенныеБумагиДОстатки.ЦеннаяБумага,
		|	ЦенныеБумагиДОстатки.ЦеннаяБумага.ВалютаНоминала,
		|	ЦенныеБумагиДОстатки.Депозитарий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КСУ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КСУ.ВалютаНоминала КАК ВалютаНоминала,
		|	КСУ.Количество КАК Количество,
		|	КСУ.Цена КАК Цена,
		|	КСУ.Сумма КАК Сумма,
		|	КСУ.СуммаРуб КАК СуммаРуб,
		|	КСУ.Депозитарий КАК Депозитарий,
		|	МАКСИМУМ(ЕСТЬNULL(ТКССрезПоследних.БанковскийСчет.Банк, &ПустойБанк)) КАК Банк
		|ПОМЕСТИТЬ КСУиБанки
		|ИЗ
		|	КСУ КАК КСУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТКС.СрезПоследних(&МоментВремени, 1 = 1) КАК ТКССрезПоследних
		|		ПО КСУ.ВалютаНоминала = ТКССрезПоследних.Валюта
		|			И КСУ.Депозитарий = ТКССрезПоследних.МестоХранения
		|			И (ТКССрезПоследних.ТипДеятельности = &Дилерская)
		|			И (ТКССрезПоследних.ФлагАктивности)
		|
		|СГРУППИРОВАТЬ ПО
		|	КСУ.ЦеннаяБумага,
		|	КСУ.ВалютаНоминала,
		|	КСУ.Депозитарий,
		|	КСУ.Количество,
		|	КСУ.Цена,
		|	КСУ.Сумма,
		|	КСУ.СуммаРуб
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(ОстаткиДСД.ДСД, 0) + ЕСТЬNULL(ОстаткиДСБ.ДСБ, 0) - ЕСТЬNULL(ГарантийноеОбеспечение.СуммаБС, 0) + ЕСТЬNULL(ОценкиЦБ.СуммаЦБ, 0)) КАК Сумма
		|ИЗ
