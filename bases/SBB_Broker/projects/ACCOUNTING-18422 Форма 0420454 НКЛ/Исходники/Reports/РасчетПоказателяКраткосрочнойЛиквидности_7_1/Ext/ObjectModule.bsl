	Запрос.УстановитьПараметр("ТипНазначенияИной", Перечисления.ТипыНазначенияБанковскихСчетов.Иной);
	БикБанковИсключаемыхИз0420454Строкой = РегистрыСведений.ПараметрыГлобальные.ЗначениеПараметра("15361.БикБанковИсключаемыхИз0420454", "");
	БикБанковИсключаемыхИз0420454 = СтрРазделить(БикБанковИсключаемыхИз0420454Строкой, ",", Ложь);
	Запрос.УстановитьПараметр("БикБанковИсключаемыхИз0420454", БикБанковИсключаемыхИз0420454);
	
	Пакеты = Запрос.ВыполнитьПакет();
	
	Результат = Пакеты[2];
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		СуммаВозврата = ?(ЗначениеЗаполнено(Выборка.Сумма), Выборка.Сумма, 0);
		Если Развернутый И СуммаВозврата <> 0 Тогда
			ДанныеРасшифровки.Вставить(?(ТипДеятельности = Перечисления.ТипыДеятельности.Д, "П4", "П5"), Пакеты[3].Выгрузить());
		КонецЕсли;
	КонецЕсли;
	
	Возврат Окр(СуммаВозврата, 2);
	
