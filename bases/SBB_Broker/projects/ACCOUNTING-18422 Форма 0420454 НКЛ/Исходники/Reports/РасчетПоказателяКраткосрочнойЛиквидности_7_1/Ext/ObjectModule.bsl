		|			И (СтавкиРискаПоЦК.КонецДиапозона > ВЫБОР
		|					КОГДА ЕСТЬNULL(ЦенныеБумагиДОстатки.КоличествоОстаток, 0) > 0
		|						ТОГДА ЦенныеБумагиДОстатки.КоличествоОстаток
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|				ИЛИ СтавкиРискаПоЦК.КонецДиапозона = 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтавкиРискаПоЦК.Дисконт,
		|	ЕСТЬNULL(СтавкиРискаПоЦК.Дисконт, 100),
		|	ЦенныеБумагиДОстатки.ЦеннаяБумага,
		|	ЦенныеБумагиДОстатки.Депозитарий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦБ.Кол КАК Кол,
		|	ОстаткиЦБ.Дисконт КАК Дисконт,
		|	ОстаткиЦБ.Депозитарий КАК Депозитарий,
		|	МАКСИМУМ(ЕСТЬNULL(ТКССрезПоследних.БанковскийСчет.Банк, &ПустойБанк)) КАК Банк
		|ПОМЕСТИТЬ ОстаткиЦБиБанки
		|ИЗ
		|	ОстаткиЦБ КАК ОстаткиЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТКС.СрезПоследних(&МоментВремени, 1 = 1) КАК ТКССрезПоследних
		|		ПО (&Руб = ТКССрезПоследних.Валюта)
		|			И ОстаткиЦБ.Депозитарий = ТКССрезПоследних.МестоХранения
		|			И (ТКССрезПоследних.ТипДеятельности = &Дилерская)
		|			И (ТКССрезПоследних.ФлагАктивности)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиЦБ.Депозитарий,
		|	ОстаткиЦБ.ЦеннаяБумага,
		|	ОстаткиЦБ.Кол,
		|	ОстаткиЦБ.Дисконт
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВЫРАЗИТЬ(ОстаткиЦБиБанкиИтого.Кол * (ЕСТЬNULL(КотировкаРыночная.Котировка, 0) + ЕСТЬNULL(КотировкаНКД.Котировка, 0)) КАК ЧИСЛО(19, 2))) КАК СуммаБезДисконтаЦБ,
		|	СУММА(ВЫРАЗИТЬ(ОстаткиЦБиБанкиИтого.Кол * ((ЕСТЬNULL(КотировкаРыночная.Котировка, 0) + ЕСТЬNULL(КотировкаНКД.Котировка, 0)) * (1 - ОстаткиЦБиБанкиИтого.Дисконт / 100)) КАК ЧИСЛО(19, 2))) КАК СуммаЦБ,
		|	ОстаткиЦБиБанкиИтого.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(КотировкаРыночная.Котировка, 0) КАК Цена,
		|	ЕСТЬNULL(КотировкаНКД.Котировка, 0) КАК НКД,
		|	ОстаткиЦБиБанкиИтого.Кол КАК Количество,
		|	ОстаткиЦБиБанкиИтого.Дисконт КАК Дисконт,
		|	ОстаткиЦБиБанкиИтого.Банк КАК Банк,
		|	&Руб КАК Валюта
		|ПОМЕСТИТЬ ОценкиЦБ
		|ИЗ
		|	(ВЫБРАТЬ
		|		ОстаткиЦБиБанки.ЦеннаяБумага КАК ЦеннаяБумага,
		|		СУММА(ОстаткиЦБиБанки.Кол) КАК Кол,
		|		ОстаткиЦБиБанки.Дисконт КАК Дисконт,
		|		ОстаткиЦБиБанки.Банк КАК Банк
		|	ИЗ
		|		ОстаткиЦБиБанки КАК ОстаткиЦБиБанки
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ОстаткиЦБиБанки.Банк,
		|		ОстаткиЦБиБанки.ЦеннаяБумага,
		|		ОстаткиЦБиБанки.Дисконт) КАК ОстаткиЦБиБанкиИтого
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкаРыночная КАК КотировкаРыночная
		|		ПО ОстаткиЦБиБанкиИтого.ЦеннаяБумага = КотировкаРыночная.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ КотировкаНКД КАК КотировкаНКД
		|		ПО ОстаткиЦБиБанкиИтого.ЦеннаяБумага = КотировкаНКД.ЦеннаяБумага
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(КотировкаРыночная.Котировка, 0),
		|	ЕСТЬNULL(КотировкаНКД.Котировка, 0),
		|	ОстаткиЦБиБанкиИтого.Банк,
		|	ОстаткиЦБиБанкиИтого.Дисконт,
		|	ОстаткиЦБиБанкиИтого.Кол,
		|	ОстаткиЦБиБанкиИтого.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЦенныеБумагиДОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
