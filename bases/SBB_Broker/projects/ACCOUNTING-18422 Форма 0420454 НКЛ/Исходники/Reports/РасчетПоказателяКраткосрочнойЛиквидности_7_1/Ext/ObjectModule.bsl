		|			ИЛИ БанковскиеСчета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|	И (БанковскиеСчета.ДатаОткрытия <= &ДатаЗакрытия
		|			ИЛИ БанковскиеСчета.ДатаОткрытия = ДАТАВРЕМЯ(1, 1, 1))
		|	И БанковскиеСчета.ВозможностьИспользованияДССчета = &ВозможностьИспользованияДССчета
		|	И БанковскиеСчета.ВключаетсяВ0420409 = &ВключаетсяВ0420409
		|	И НЕ БанковскиеСчета.ПометкаУдаления
		|	И НЕ БанковскиеСчета.ТипНазначения = &ТипНазначенияИной
		|	И НЕ БанковскиеСчета.Банк.Код В (&БикБанковИсключаемыхИз0420454)
		|	И НЕ БанковскиеСчета.Банк.SWIFT В (&БикБанковИсключаемыхИз0420454)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВЫРАЗИТЬ(ДенежныеСредстваДОстатки.ВалютнаяСуммаОстаток * ЕСТЬNULL(КурсыВалют.Курс, 0) / ЕСТЬNULL(КурсыВалют.Кратность, 1) КАК ЧИСЛО(19, 2))) КАК Сумма,
		|	СУММА(ДенежныеСредстваДОстатки.ВалютнаяСуммаОстаток) КАК СуммаВалютная,
		|	ДенежныеСредстваДОстатки.БанковскийСчет.НомерСчета КАК НомерСчета,
		|	БСОрганизации.ТипСчета КАК ТипСчета,
		|	БСОрганизации.Банк КАК Банк,
		|	ДенежныеСредстваДОстатки.Валюта КАК Валюта,
		|	&ТипПозиции КАК ТипПозиции,
		|	БСОрганизации.Банк.ЮридическоеЛицо КАК БанкЮрЛицо
		|ПОМЕСТИТЬ ОстаткиДСТипДеятельностиД
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваД.Остатки(&МоментВремени, Организация = &Организация) КАК ДенежныеСредстваДОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ БСОрганизации КАК БСОрганизации
