Функция ТекстЗапросаКурсыВалют()
	
	Возврат
	"ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Валюта КАК Валюта,
	|	КурсыВалютСрезПоследних.Курс КАК Курс,
	|	КурсыВалютСрезПоследних.Кратность КАК Кратность
	|ПОМЕСТИТЬ КурсыВалют
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Дата, 1 = 1) КАК КурсыВалютСрезПоследних
	|";
	
КонецФункции

Функция ТекстЗапросаПраваИспользованияДСКлиентов()
	
	Возврат
	"ВЫБРАТЬ
	|	ПравоИспользованияДСКлиентовСрезПоследних.Клиент КАК Клиент
	|ПОМЕСТИТЬ Клиенты
	|ИЗ
	|	РегистрСведений.ПравоИспользованияДСКлиентов.СрезПоследних(&Дата, 1 = 1) КАК ПравоИспользованияДСКлиентовСрезПоследних
	|ГДЕ
	|	ПравоИспользованияДСКлиентовСрезПоследних.Значение
	|";
	
КонецФункции

Функция ТекстЗапросаДСПоНезакрытымСделкам()
	
	Возврат
	"ВЫБРАТЬ
	|	БиржеваяСделка.ВидСделки КАК ВидСделки,
	|	НАЧАЛОПЕРИОДА(БиржеваяСделка.Дата, ДЕНЬ) КАК Дата,
	|	БиржеваяСделка.Номер КАК Номер,
	|	БиржеваяСделка.ЦеннаяБумага.Наименование КАК ЦеннаяБумага,
	|	БиржеваяСделка.ЦеннаяБумага.ISIN КАК ISIN,
	|	БиржеваяСделка.Количество КАК Количество,
	|	БиржеваяСделка.ДатаОплатыПлановая КАК ДатаРасчета,
	|	ЕСТЬNULL(КурсыВалют.Курс, 0) / ЕСТЬNULL(КурсыВалют.Кратность, 1) КАК Курс,
	|	ДенежныеСредстваВПутиДОстатки.Биржа КАК Биржа,
	|	СУММА(ВЫБОР
	|			КОГДА БиржеваяСделка.ВидСделки = &ВидСделкиПокупка
	|				ТОГДА -ЕСТЬNULL(ДенежныеСредстваВПутиДОстатки.ВалютнаяСуммаОстаток, 0)
	|			ИНАЧЕ ЕСТЬNULL(ДенежныеСредстваВПутиДОстатки.ВалютнаяСуммаОстаток, 0)
	|		КОНЕЦ) КАК ВалютнаяСумма,
	|	СУММА(ВЫРАЗИТЬ(ВЫБОР
	|				КОГДА БиржеваяСделка.ВидСделки = &ВидСделкиПокупка
	|					ТОГДА -ЕСТЬNULL(ДенежныеСредстваВПутиДОстатки.ВалютнаяСуммаОстаток, 0) * ЕСТЬNULL(КурсыВалют.Курс, 0) / ЕСТЬNULL(КурсыВалют.Кратность, 1)
	|				ИНАЧЕ ЕСТЬNULL(ДенежныеСредстваВПутиДОстатки.ВалютнаяСуммаОстаток, 0) * ЕСТЬNULL(КурсыВалют.Курс, 0) / ЕСТЬNULL(КурсыВалют.Кратность, 1)
	|			КОНЕЦ КАК ЧИСЛО(19, 2))) КАК Сумма,
	|	БиржеваяСделка.ТипДеятельности КАК ТипДеятельности,
	|	ДенежныеСредстваВПутиДОстатки.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА БиржеваяСделка.Биржа.ИностранныйРынок
	|			ТОГДА БиржеваяСделка.СтороннийБрокер.ЮридическиеФизическиеЛица
