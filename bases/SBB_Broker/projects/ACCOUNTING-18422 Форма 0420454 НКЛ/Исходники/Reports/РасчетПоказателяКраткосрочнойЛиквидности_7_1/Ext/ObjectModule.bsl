		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ОстаткиДСД";
	
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(ДатаОтчета, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТипКотировкиРыночная", Перечисления.ТипыКотировокЦБ.РыночнаяЦена);
	Запрос.УстановитьПараметр("ТипКотировкиНКД", Перечисления.ТипыКотировокЦБ.НКД);
	Запрос.УстановитьПараметр("ТипНазначения", Перечисления.ТипыНазначенияБанковскихСчетов.Иной);
	Запрос.УстановитьПараметр("Процент", 100);
	
	ИсключенныеВидыЦББР = Новый Массив;
	ИсключенныеВидыЦББР.Добавить(Справочники.ВидыЦББанкаРоссии.КСУ());
	ИсключенныеВидыЦББР.Добавить(Справочники.ВидыЦББанкаРоссии.ПустаяСсылка());
	Запрос.УстановитьПараметр("ИсключенныеВидыЦББР", ИсключенныеВидыЦББР);
	Запрос.УстановитьПараметр("ДатаГО", ДатаГарантийногоОбеспечения());
	Запрос.УстановитьПараметр("ТипЦБПай", Перечисления.ТипыЦБ.Пай);
	Запрос.УстановитьПараметр("БиржаFORTS", Справочники.Биржи.FORTS);
	Запрос.УстановитьПараметр("БиржаMICEX", Справочники.Биржи.MICEX);
	Запрос.УстановитьПараметр("БиржаMICEXSELT", Справочники.Биржи.MICEXSELT);
	Запрос.УстановитьПараметр("Да", Перечисления.ДаНет.Да);
	Запрос.УстановитьПараметр("КСУ", Справочники.ВидыЦББанкаРоссии.КСУ());
	Запрос.УстановитьПараметр("ПустойБанк", Справочники.Банки.ПустаяСсылка());
	Запрос.УстановитьПараметр("Дилерская", Перечисления.ТипыДеятельности.Д);
	Запрос.УстановитьПараметр("Руб", ОбщегоНазначенияПовтИсп.ВалютаРегламентированногоУчета());
	СобственныйПортфель = ОбщегоНазначенияПовтИсп.ПолучитьЗначениеКонстанты("СобственныйПортфель");
	Запрос.УстановитьПараметр("СобственныйПортфель", СобственныйПортфель);
	Банк_НКО_НКЦ_АО = ОбщегоНазначенияПовтИсп.ПолучитьЗначениеКонстанты("Банк_НКО_НКЦ_АО");
	Запрос.УстановитьПараметр("Банк_НКО_НКЦ_АО", Банк_НКО_НКЦ_АО);
	
	Пакеты = Запрос.ВыполнитьПакет();
	
	Результат = Пакеты[12];
	ИКО = 0;
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ИКО = ?(ЗначениеЗаполнено(Выборка.Сумма), Выборка.Сумма, 0);
	КонецЕсли;
	Результат = Пакеты[15];
	КСУ = 0;
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		КСУ = ?(ЗначениеЗаполнено(Выборка.Сумма), Выборка.Сумма, 0);
	КонецЕсли;
	Если Развернутый Тогда
		ДанныеРасшифровки.Вставить("П10Расш1", Пакеты[13].Выгрузить());
		ДанныеРасшифровки.Вставить("П10Расш2", Пакеты[14].Выгрузить());
		ДанныеРасшифровки.Вставить("П10Расш3", Пакеты[16].Выгрузить());
	КонецЕсли;
	СуммаВозврата = ИКО + КСУ;
	
	Возврат Окр(СуммаВозврата, 2);
	
КонецФункции

Функция ВозвратДСКлиентам(МенеджерВременныхТаблиц, ДанныеРасшифровки, ДатаОтчета)
	
	СуммаВозврата = 0;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДенежныеСредстваБОстатки.Договор.Наименование КАК Договор,
		|	ДенежныеСредстваБОстатки.Валюта КАК Валюта,
		|	ЕСТЬNULL(КурсыВалют.Курс, 0) / ЕСТЬNULL(КурсыВалют.Кратность, 1) КАК Курс,
		|	ДенежныеСредстваБОстатки.ВалютнаяСуммаОстаток * ЕСТЬNULL(КурсыВалют.Курс, 0) / ЕСТЬNULL(КурсыВалют.Кратность, 1) КАК Сумма,
		|	ДенежныеСредстваБОстатки.ВалютнаяСуммаОстаток КАК СуммаВалютная,
		|	0 КАК СуммаВП,
		|	0 КАК СуммаВалютнаяВП,
		|	&Брокерская КАК ТипДеятельности,
		|	&ТипКлиентская КАК ТипПозиции
		|ПОМЕСТИТЬ ВозвратДСКлиентамБезГруппировки
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваБ.Остатки(&МоментВремени, Организация = &Организация) КАК ДенежныеСредстваБОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Клиенты КАК Клиенты
		|		ПО ДенежныеСредстваБОстатки.Договор.Владелец = Клиенты.Клиент
		|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыВалют КАК КурсыВалют
		|		ПО ДенежныеСредстваБОстатки.Валюта = КурсыВалют.Валюта
		|ГДЕ
		|	ДенежныеСредстваБОстатки.ВалютнаяСуммаОстаток <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДенежныеСредстваВПутиБОстатки.Договор.Наименование,
		|	ДенежныеСредстваВПутиБОстатки.Валюта,
		|	ЕСТЬNULL(КурсыВалют.Курс, 0) / ЕСТЬNULL(КурсыВалют.Кратность, 1),
		|	0,
		|	0,
		|	ДенежныеСредстваВПутиБОстатки.ВалютнаяСуммаОстаток * ЕСТЬNULL(КурсыВалют.Курс, 0) / ЕСТЬNULL(КурсыВалют.Кратность, 1),
		|	ДенежныеСредстваВПутиБОстатки.ВалютнаяСуммаОстаток,
		|	&Брокерская,
		|	&ТипКлиентская
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВПутиБ.Остатки(&МоментВремени, Организация = &Организация) КАК ДенежныеСредстваВПутиБОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Клиенты КАК Клиенты
		|		ПО ДенежныеСредстваВПутиБОстатки.Договор.Владелец = Клиенты.Клиент
		|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыВалют КАК КурсыВалют
		|		ПО ДенежныеСредстваВПутиБОстатки.Валюта = КурсыВалют.Валюта
		|ГДЕ
		|	ДенежныеСредстваВПутиБОстатки.ВалютнаяСуммаОстаток <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВозвратДСКлиентамБезГруппировки.Договор КАК Договор,
		|	ВозвратДСКлиентамБезГруппировки.Валюта КАК Валюта,
		|	МАКСИМУМ(ВозвратДСКлиентамБезГруппировки.Курс) КАК Курс,
		|	СУММА(ВозвратДСКлиентамБезГруппировки.Сумма) КАК Сумма,
		|	СУММА(ВозвратДСКлиентамБезГруппировки.СуммаВалютная) КАК СуммаВалютная,
		|	СУММА(ВозвратДСКлиентамБезГруппировки.СуммаВП) КАК СуммаВП,
		|	СУММА(ВозвратДСКлиентамБезГруппировки.СуммаВалютнаяВП) КАК СуммаВалютнаяВП,
		|	ВозвратДСКлиентамБезГруппировки.ТипДеятельности КАК ТипДеятельности,
		|	ВозвратДСКлиентамБезГруппировки.ТипПозиции КАК ТипПозиции
		|ПОМЕСТИТЬ ВозвратДСКлиентамГруппировка
		|ИЗ
		|	ВозвратДСКлиентамБезГруппировки КАК ВозвратДСКлиентамБезГруппировки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВозвратДСКлиентамБезГруппировки.Договор,
		|	ВозвратДСКлиентамБезГруппировки.Валюта,
		|	ВозвратДСКлиентамБезГруппировки.ТипДеятельности,
		|	ВозвратДСКлиентамБезГруппировки.ТипПозиции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВозвратДСКлиентамГруппировка.Договор КАК Договор,
		|	ВозвратДСКлиентамГруппировка.Валюта КАК Валюта,
		|	ВозвратДСКлиентамГруппировка.Курс КАК Курс,
		|	ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА ЕСТЬNULL(ВозвратДСКлиентамГруппировка.Сумма, 0) + ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВП, 0) > 0
		|				ТОГДА (ЕСТЬNULL(ВозвратДСКлиентамГруппировка.Сумма, 0) + ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВП, 0)) * &Процент
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК ЧИСЛО(19, 2)) КАК Сумма,
		|	ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА ЕСТЬNULL(ВозвратДСКлиентамГруппировка.Сумма, 0) + ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВП, 0) > 0
		|				ТОГДА ЕСТЬNULL(ВозвратДСКлиентамГруппировка.Сумма, 0) + ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВП, 0)
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК ЧИСЛО(19, 2)) КАК СуммаБезДисконта,
		|	ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВалютная, 0) + ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВалютнаяВП, 0) > 0
		|				ТОГДА (ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВалютная, 0) + ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВалютнаяВП, 0)) * &Процент
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК ЧИСЛО(19, 2)) КАК СуммаВалютная,
		|	ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВалютная, 0) КАК СуммаВалютнаяФакт,
		|	ЕСТЬNULL(ВозвратДСКлиентамГруппировка.СуммаВалютнаяВП, 0) КАК СуммаВалютнаяЗадолженность,
		|	ВозвратДСКлиентамГруппировка.ТипПозиции КАК ТипПозиции
		|ПОМЕСТИТЬ ВозвратДСКлиентам
		|ИЗ
		|	ВозвратДСКлиентамГруппировка КАК ВозвратДСКлиентамГруппировка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВозвратДСКлиентам.Сумма) КАК Сумма
		|ИЗ
		|	ВозвратДСКлиентам КАК ВозвратДСКлиентам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВозвратДСКлиентам.Договор КАК Договор,
		|	ВозвратДСКлиентам.Валюта.НаименованиеОтчет КАК Валюта,
		|	ВозвратДСКлиентам.Курс КАК Курс,
		|	ВозвратДСКлиентам.СуммаВалютнаяФакт КАК СуммаВалютнаяФакт,
		|	ВозвратДСКлиентам.СуммаВалютнаяЗадолженность КАК СуммаВалютнаяЗадолженность,
		|	ВозвратДСКлиентам.СуммаБезДисконта КАК СуммаБезДисконта,
		|	ВозвратДСКлиентам.Сумма КАК Сумма,
		|	ВозвратДСКлиентам.СуммаВалютная КАК СуммаВалютная,
		|	ВозвратДСКлиентам.ТипПозиции КАК ТипПозиции
		|ИЗ
		|	ВозвратДСКлиентам КАК ВозвратДСКлиентам";
	
	Запрос.УстановитьПараметр("Процент", 0.3);
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(ДатаОтчета, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Брокерская", Перечисления.ТипыДеятельности.Б);
	Запрос.УстановитьПараметр("ТипКлиентская", "Клиентская");
	
	Пакеты = Запрос.ВыполнитьПакет();
	
	Результат = Пакеты[3];
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		СуммаВозврата = ?(ЗначениеЗаполнено(Выборка.Сумма), Выборка.Сумма, 0);
		Если Развернутый И СуммаВозврата <> 0 Тогда
			ДанныеРасшифровки.Вставить("П20", Пакеты[4].Выгрузить());
		КонецЕсли;
	КонецЕсли;
	
	Возврат Окр(СуммаВозврата, 2);
	
КонецФункции

Функция ДСПоНезакрытымСделкам(МенеджерВременныхТаблиц, ДанныеРасшифровки, ВидСделки, ТипКонтрагента = "")
	
	Расчет = Новый Структура("КромеЦК, ЦК, Итог", 0, 0, 0);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(СуммыДСПоНезакрытымСделкам.СуммаНеттингаПоЦК), 0) КАК СуммаНеттингаПоЦК,
		|	ЕСТЬNULL(СУММА(СуммыДСПоНезакрытымСделкам.СуммаБезУчастияЦК), 0) КАК СуммаБезУчастияЦК
		|ПОМЕСТИТЬ СуммыДСПоНезакрытымСделкам
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДСПоНезакрытымСделкамЦКПоВидуСделки.Сумма КАК СуммаНеттингаПоЦК,
		|		0 КАК СуммаБезУчастияЦК
		|	ИЗ
		|		ДСПоНезакрытымСделкам КАК ДСПоНезакрытымСделкамЦКПоВидуСделки
		|	ГДЕ
		|		ДСПоНезакрытымСделкамЦКПоВидуСделки.ВидСделки = &ВидСделки
		|		И ДСПоНезакрытымСделкамЦКПоВидуСделки.ЭтоСделкаЦК
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-ДСПоНезакрытымСделкамЦКПоОбратномуВидуСделки.Сумма,
		|		0
		|	ИЗ
		|		ДСПоНезакрытымСделкам КАК ДСПоНезакрытымСделкамЦКПоОбратномуВидуСделки
		|	ГДЕ
		|		ДСПоНезакрытымСделкамЦКПоОбратномуВидуСделки.ВидСделки = &ОбратныйВидСделки
		|		И ДСПоНезакрытымСделкамЦКПоОбратномуВидуСделки.ЭтоСделкаЦК
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		0,
		|		ДСПоНезакрытымСделкамБезЦКПоВидуСделки.Сумма
		|	ИЗ
		|		ДСПоНезакрытымСделкам КАК ДСПоНезакрытымСделкамБезЦКПоВидуСделки
		|	ГДЕ
		|		ДСПоНезакрытымСделкамБезЦКПоВидуСделки.ВидСделки = &ВидСделки
		|		И НЕ ДСПоНезакрытымСделкамБезЦКПоВидуСделки.ЭтоСделкаЦК) КАК СуммыДСПоНезакрытымСделкам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СуммыДСПоНезакрытымСделкам.СуммаНеттингаПоЦК > 0
		|			ТОГДА СуммыДСПоНезакрытымСделкам.СуммаНеттингаПоЦК + СуммыДСПоНезакрытымСделкам.СуммаБезУчастияЦК
		|		ИНАЧЕ СуммыДСПоНезакрытымСделкам.СуммаБезУчастияЦК
		|	КОНЕЦ КАК Итог,
		|	СуммыДСПоНезакрытымСделкам.СуммаБезУчастияЦК КАК КромеЦК
		|ИЗ
		|	СуммыДСПоНезакрытымСделкам КАК СуммыДСПоНезакрытымСделкам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДСПоНезакрытымСделкам.Дата КАК Дата,
		|	ДСПоНезакрытымСделкам.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ДСПоНезакрытымСделкам.ISIN КАК ISIN,
		|	СУММА(ДСПоНезакрытымСделкам.Количество) КАК Количество,
		|	ДСПоНезакрытымСделкам.ДатаРасчета КАК ДатаРасчета,
		|	ДСПоНезакрытымСделкам.Валюта КАК Валюта,
		|	МАКСИМУМ(ДСПоНезакрытымСделкам.Курс) КАК Курс,
		|	ДСПоНезакрытымСделкам.Биржа КАК Биржа,
		|	СУММА(ДСПоНезакрытымСделкам.ВалютнаяСумма) КАК СуммаВалютная,
		|	СУММА(ДСПоНезакрытымСделкам.Сумма) КАК Сумма,
		|	ДСПоНезакрытымСделкам.ТипДеятельности КАК ТипДеятельности,
		|	ЕСТЬNULL(ДСПоНезакрытымСделкам.КонтрагентЮрЛицо.Наименование, """") КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ДСПоНезакрытымСделкам.КонтрагентЮрЛицо.МеждународнаяОрганизация
		|			ТОГДА ""998""
		|		ИНАЧЕ ЕСТЬNULL(ДСПоНезакрытымСделкам.КонтрагентЮрЛицо.Страна.Код, ""999"")
		|	КОНЕЦ КАК КодСтраны,
		|	ДСПоНезакрытымСделкам.КонтрагентЮрЛицо.ИНН КАК ИНН,
		|	ДСПоНезакрытымСделкам.ЭтоСделкаЦК КАК ЭтоСделкаЦК,
		|	ДСПоНезакрытымСделкам.ТипПозиции КАК ТипПозиции
		|ИЗ
		|	ДСПоНезакрытымСделкам КАК ДСПоНезакрытымСделкам
		|ГДЕ
		|	ДСПоНезакрытымСделкам.ВидСделки = &ВидСделки
		|
		|СГРУППИРОВАТЬ ПО
		|	ДСПоНезакрытымСделкам.Биржа,
		|	ДСПоНезакрытымСделкам.Дата,
		|	ДСПоНезакрытымСделкам.ТипДеятельности,
		|	ДСПоНезакрытымСделкам.ЦеннаяБумага,
		|	ДСПоНезакрытымСделкам.ДатаРасчета,
		|	ДСПоНезакрытымСделкам.ISIN,
		|	ДСПоНезакрытымСделкам.Валюта,
		|	ЕСТЬNULL(ДСПоНезакрытымСделкам.КонтрагентЮрЛицо.Наименование, """"),
		|	ВЫБОР
		|		КОГДА ДСПоНезакрытымСделкам.КонтрагентЮрЛицо.МеждународнаяОрганизация
		|			ТОГДА ""998""
		|		ИНАЧЕ ЕСТЬNULL(ДСПоНезакрытымСделкам.КонтрагентЮрЛицо.Страна.Код, ""999"")
		|	КОНЕЦ,
		|	ДСПоНезакрытымСделкам.КонтрагентЮрЛицо.ИНН,
		|	ДСПоНезакрытымСделкам.ЭтоСделкаЦК,
		|	ДСПоНезакрытымСделкам.ТипПозиции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
