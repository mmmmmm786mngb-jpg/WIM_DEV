
&НаСервере
Перем ТекущийОбъект;

&НаСервере
Функция ТекущийОбъект()
	
	Если ТекущийОбъект = Неопределено Тогда
		ТекущийОбъект = РеквизитФормыВЗначение("Отчет");
	КонецЕсли; 
	
	Возврат ТекущийОбъект;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Дата") Тогда 
		Отчет.Дата = Параметры.Дата;
	Иначе 
		Отчет.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Параметры.Свойство("Организация") Тогда 
		Отчет.Организация = Параметры.Организация;
	Иначе 
		Отчет.Организация = ПараметрыСеанса.Организация;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Не ЗначениеЗаполнено(Отчет.Организация) Тогда
		ТекстОшибки = "Не заполнена организация отчета";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Отчет.Дата) Тогда
		ТекстОшибки = "Не заполнена дата отчета";
	КонецЕсли;
	
	Если ТекстОшибки <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	
	ТабличныеДокументы = ТекущийОбъект().РезультатФормированияОтчета();
	
	Для Каждого ТабличныйДокумент Из ТабличныеДокументы Цикл
		
		ИмяТабДок = "Результат" + ТабличныйДокумент.Ключ;
		
		ЭтаФорма[ИмяТабДок].Очистить();
		ЭтаФорма[ИмяТабДок] = ТабличныйДокумент.Значение;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите каталог для выгрузки файла";
	
	Если Диалог.Выбрать() Тогда
		Отчет.КаталогФайла = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВExcel(Команда)
	
	Если Не ЗначениеЗаполнено(Отчет.КаталогФайла) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан путь к файлу!");
		Возврат;
	КонецЕсли;
	
	Попытка
		ExcelApp = Новый COMОбъект("Excel.Application");
		ExcelApp.DisplayAlerts = 0;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при запуске приложения MS Excel." + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	ОбщаяКнига = ExcelApp.WorkBooks.Add();
	ОбщаяКнига.Sheets(1).Name = "Удалить";
	
	СохранитьРазделВExcel("РезультатКлиентскиеСделкиФонд", ExcelApp, ОбщаяКнига);
	СохранитьРазделВExcel("РезультатСобственныеСделкиФонд", ExcelApp, ОбщаяКнига);
	СохранитьРазделВExcel("РезультатКлиентскиеСделкиВал", ExcelApp, ОбщаяКнига);
	СохранитьРазделВExcel("РезультатСобственныеСделкиВал", ExcelApp, ОбщаяКнига);
	СохранитьРазделВExcel("РезультатОбязательстваПоКомиссиямС", ExcelApp, ОбщаяКнига);
	СохранитьРазделВExcel("РезультатОбязательстваПоКомиссиямБез", ExcelApp, ОбщаяКнига);
	СохранитьРазделВExcel("РезультатОбязательстваПоРасходамС", ExcelApp, ОбщаяКнига);
	СохранитьРазделВExcel("РезультатОбязательстваПоРасходамБез", ExcelApp, ОбщаяКнига);
	СохранитьРазделВExcel("РезультатСобственныеАктивыНаФОРТС", ExcelApp, ОбщаяКнига);
	
	//Удалим ненужный лист в общем файле
	ОбщаяКнига.Sheets("Удалить").Delete();
	
	ИмяФайла = "ПКЛ_" + Формат(Отчет.Дата, "ДФ=ddMMyyyy") + " (проверочный).xlsx";
	Путь = СокрЛП(Отчет.КаталогФайла);
	Если Прав(Путь, 1) <> "\" Тогда 
		Путь = Путь + "\";
	КонецЕсли;
	ПолноеИмяФайла = Путь + ИмяФайла;
	
	ОбщаяКнига.SaveAs(ПолноеИмяФайла);
	
	ExcelApp.Quit();
	Книга = Неопределено;
	ОбщаяКнига = Неопределено;
	ExcelApp = Неопределено;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл успешно сохранен.");
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьРазделВExcel(ИмяТабличногоДокумента, ExcelApp, ОбщаяКнига)
	
	ИндексЛиста = ОбщаяКнига.Sheets.Count;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".xlsx");
	ЭтаФорма[ИмяТабличногоДокумента].Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
	
	Книга = ExcelApp.WorkBooks.Open(ИмяВременногоФайла);
	Книга.Sheets(1).Copy(ОбщаяКнига.Sheets(ИндексЛиста));
	Книга.Close();
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
	КонецПопытки;
	
	//Переименуем лист в общем файле
	ОбщаяКнига.Sheets(ИндексЛиста).Name = Элементы[ИмяТабличногоДокумента].Заголовок;
	
КонецПроцедуры
