	|	ВТ_СделкиВалютные.ПерваяСделка КАК ПерваяСделка,
	|	ВТ_СделкиВалютные.ИдентификаторСделки КАК ИдентификаторСделки,
	|	ВТ_СделкиВалютные.СпособРасчета КАК СпособРасчета,
	|	ВТ_СделкиВалютные.СекцияБиржи КАК СекцияБиржи,
	|	ВТ_СделкиВалютные.ФормаРасчетов КАК ФормаРасчетов,
	|	ВТ_СделкиВалютные.ДатаОплатыВВалютеЛота КАК ДатаОплатыВВалютеЛота,
	|	ВТ_СделкиВалютные.ДатаОплатыВВалютеЛотаПлан КАК ДатаОплатыВВалютеЛотаПлан,
	|	ВТ_СделкиВалютные.ДатаОплатыВВалютеРасчетов КАК ДатаОплатыВВалютеРасчетов,
	|	ВТ_СделкиВалютные.ДатаОплатыВВалютеРасчетовПлан КАК ДатаОплатыВВалютеРасчетовПлан
	|ИЗ
	|	ВТ_СделкиВалютные КАК ВТ_СделкиВалютные
	|ГДЕ
	|	ВТ_СделкиВалютные.ТипДеятельности = &ТипДеятельностиДилерская
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВремяСделки,
	|	НомерСделки";
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Формирует текст запроса к регистру ДенежныеСредстваВПутиБ
//
// Параметры:
//  ИмяПараметра1	 - Строка - Имя параметра, содержащего список видов затрат
//  ИмяПараметра2	 - Строка - Имя параметра, отвечающего за использование денежных средств клиента
// 
// Возвращаемое значение:
//  Строка - Текст запроса
//
Функция ТекстЗапросаОстаткиИОбороты(ВидыЗатрат, ПредоставленоПравоПользованияДС)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДенежныеСредстваВПутиБОстаткиИОбороты.Валюта КАК Измерение,
	|	ДенежныеСредстваВПутиБОстаткиИОбороты.ВалютнаяСуммаНачальныйОстаток КАК НачальныйОстаток,
	|	ДенежныеСредстваВПутиБОстаткиИОбороты.ВалютнаяСуммаПриход КАК Приход,
	|	ДенежныеСредстваВПутиБОстаткиИОбороты.ВалютнаяСуммаРасход КАК Расход,
	|	ДенежныеСредстваВПутиБОстаткиИОбороты.ВалютнаяСуммаКонечныйОстаток КАК КонечныйОстаток
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваВПутиБ.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			,
	|			ВидЗатрат В (&ВидыЗатрат)
	|				И &ПредоставленоПравоПользованияДС) КАК ДенежныеСредстваВПутиБОстаткиИОбороты
	|
	|УПОРЯДОЧИТЬ ПО
	|	Измерение
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВидыЗатрат", ВидыЗатрат);
	Если ПредоставленоПравоПользованияДС = "ПредоставленоПравоПользованияДСНет" Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПредоставленоПравоПользованияДС", "НЕ Договор.Владелец.ПредоставленоПравоПользованияДС");
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПредоставленоПравоПользованияДС", "Договор.Владелец.ПредоставленоПравоПользованияДС");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Формирует текст запроса к регистру ЦенныеБумагиД
// 
// Возвращаемое значение:
//  Строка - Текст запроса
//
Функция ТекстЗапросаСобственныеАктивыНаФОРТС()
	
	Возврат
	"ВЫБРАТЬ
	|	ЦенныеБумагиДОстаткиИОбороты.Депозитарий КАК Измерение,
	|	ЦенныеБумагиДОстаткиИОбороты.ЦеннаяБумага КАК Измерение2,
	|	ЦенныеБумагиДОстаткиИОбороты.КоличествоНачальныйОстаток КАК НачальныйОстаток,
	|	ЦенныеБумагиДОстаткиИОбороты.КоличествоПриход КАК Приход,
	|	ЦенныеБумагиДОстаткиИОбороты.КоличествоРасход КАК Расход,
	|	ЦенныеБумагиДОстаткиИОбороты.КоличествоКонечныйОстаток КАК КонечныйОстаток
	|ИЗ	
	// БИА: разделение регистров (партии, количество) -->
	//|	РегистрНакопления.ЦенныеБумагиД.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , Депозитарий = &ДепозитарийFORTS) КАК ЦенныеБумагиДОстаткиИОбороты	
	|	РегистрНакопления.ЦенныеБумагиДКоличество.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , Депозитарий = &ДепозитарийFORTS) КАК ЦенныеБумагиДОстаткиИОбороты	
	// БИА <--
	|
	|УПОРЯДОЧИТЬ ПО
	|	Измерение,
	|	Измерение2
	|ИТОГИ
	|	СУММА(НачальныйОстаток),
	|	СУММА(Приход),
	|	СУММА(Расход),
	|	СУММА(КонечныйОстаток)
	|ПО
	|	Измерение
	|АВТОУПОРЯДОЧИВАНИЕ";
	
КонецФункции

// Заполняет табличный документ данными раздела (для Фондового и Валютного рынков)
//
// Параметры:
//  ТабличныеДокументы	 - Структура - соответствие разделов отчета и сформированных табличных документов
//  ДанныеРазделов		 - Массив	 - Результаты запроса по разделам
//  ИмяРаздела			 - Строка	 - Имя раздела
//  ИмяМакета			 - Строка	 - Макет, который необходимо использовать при формировании табличного документа
//
Процедура ДобавитьРазделВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, ИмяРаздела, ИмяМакета)
	
	ТабДок = Новый ТабличныйДокумент;
	ДанныеРаздела = ДанныеРазделаПоИмени(ДанныеРазделов, ИмяРаздела);
	
	Если ДанныеРаздела = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Макет = ПолучитьМакет(ИмяМакета);
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ТабДок.Вывести(ОбластьШапка);
	Пока ДанныеРаздела.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ДанныеРаздела,, "Количество, Цена");
		
		СоставЧисла = ИнформацияОЧисле(ДанныеРаздела.Количество);
		Если СоставЧисла.ЦелаяЧастьДлина > 15 Тогда 
			КоличествоВОтчет = ДанныеРаздела.Количество;
			Точность = 6;
		Иначе
			Точность = Мин(15-СоставЧисла.ЦелаяЧастьДлина, 6);
			КоличествоВОтчет = Окр(ДанныеРаздела.Количество, Точность);
		КонецЕсли;
		
		ОбластьСтрока.Параметры.Количество = Формат(КоличествоВОтчет, "ЧДЦ="+Точность);
		
		Если ИмяМакета = "ФондовыйРынок" Тогда 
			МаксимальнаяТочность = 12;
		Иначе 
			МаксимальнаяТочность = 10;
		КонецЕсли;
		СоставЧисла = ИнформацияОЧисле(ДанныеРаздела.Цена);
		Если СоставЧисла.ЦелаяЧастьДлина > 15 Тогда 
			ЦенаВОтчет = ДанныеРаздела.Цена;
			Точность = МаксимальнаяТочность;
		Иначе
			Точность = Мин(15-СоставЧисла.ЦелаяЧастьДлина, МаксимальнаяТочность);
			ЦенаВОтчет = Окр(ДанныеРаздела.Цена, Точность);
		КонецЕсли;
		
		ОбластьСтрока.Параметры.Цена = Формат(ЦенаВОтчет, "ЧДЦ="+Точность);
		
		ТабДок.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	ТабДок.ФиксацияСверху = 1;
	
	ТабличныеДокументы.Вставить(ИмяРаздела, ТабДок);
	
КонецПроцедуры

// Получает длину целой и дробной части числа
//
// Параметры:
//  Число	 - Число - Число, которое требуется проанализировать
// 
// Возвращаемое значение:
//  Структура - Информация о длине целой и дробной части числа
//
Функция ИнформацияОЧисле(Число)
	
	ЧислоСтр = СтрЗаменить(Строка(Число), " ", "");
	ЧислоСтр = СтрЗаменить(Строка(ЧислоСтр), Символы.НПП, "");
	
	Разделитель = СтрНайти(ЧислоСтр, ",");
	Если Разделитель = 0 Тогда 
		ЦелаяЧастьСтр = ЧислоСтр;
		ДробнаяЧастьСтр = "";
	Иначе 
		ЦелаяЧастьСтр = Лев(ЧислоСтр, Разделитель-1);
		ДробнаяЧастьСтр = Сред(ЧислоСтр, Разделитель+1);
	КонецЕсли;
	
	Информация = Новый Структура("ЦелаяЧастьДлина, ДробнаяЧастьДлина", 0,0);
	Информация.ЦелаяЧастьДлина = СтрДлина(ЦелаяЧастьСтр);
	Информация.ДробнаяЧастьДлина = СтрДлина(ДробнаяЧастьСтр);
	
	Возврат Информация;
	
КонецФункции

// Заполняет табличный документ данными раздела (для макета ОстаткиИОбороты)
//
// Параметры:
//  ТабличныеДокументы	 - Структура - соответствие разделов отчета и сформированных табличных документов
//  ДанныеРазделов		 - Массив	 - Результаты запроса по разделам
//  ИмяРаздела			 - Строка	 - Имя раздела
//  Измерение			 - Строка	 - Имя группировки в шапке таблицы
//  Показатель			 - Строка	 - Имя показателя в шапке таблицы
//  Постфикс			 - Строка	 - Используется для изменения имени используемой области макета
//
Процедура ДобавитьРазделОстаткиИОборотыВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, ИмяРаздела, Измерение = "Валюта", Показатель = "Валютная сумма", Постфикс = "")
	
	ТабДок = Новый ТабличныйДокумент;
	ДанныеРаздела = ДанныеРазделаПоИмени(ДанныеРазделов, ИмяРаздела);
	
	Если ДанныеРаздела = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Макет = ПолучитьМакет("ОстаткиИОбороты");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка" + Постфикс);
	ОбластьСтрокаДетали = Макет.ПолучитьОбласть("СтрокаДетали" + Постфикс);
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал" + Постфикс);
	
	ОбластьШапка.Параметры.Измерение = Измерение;
	ОбластьШапка.Параметры.Показатель = Показатель;
	ТабДок.Вывести(ОбластьШапка);
	
	НачальныйОстатокИтог = 0;
	ПриходИтог = 0;
	РасходИтог = 0;
	КонечныйОстатокИтог = 0;
	Пока ДанныеРаздела.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ДанныеРаздела);
		ТабДок.Вывести(ОбластьСтрока);
		
		ДетальныеЗаписи = ДанныеРаздела.Выбрать();
		Пока ДетальныеЗаписи.Следующий() Цикл 
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаДетали.Параметры, ДетальныеЗаписи,, "Измерение");
			ОбластьСтрокаДетали.Параметры.Измерение = ДетальныеЗаписи.Измерение2;
			ТабДок.Вывести(ОбластьСтрокаДетали);
		КонецЦикла;
		
		НачальныйОстатокИтог = НачальныйОстатокИтог + ДанныеРаздела.НачальныйОстаток;
		ПриходИтог = ПриходИтог + ДанныеРаздела.Приход;
		РасходИтог = РасходИтог + ДанныеРаздела.Расход;
		КонечныйОстатокИтог= КонечныйОстатокИтог + ДанныеРаздела.КонечныйОстаток;
	КонецЦикла;
	ОбластьПодвал.Параметры.НачальныйОстатокИтог = НачальныйОстатокИтог;
	ОбластьПодвал.Параметры.ПриходИтог = ПриходИтог;
	ОбластьПодвал.Параметры.РасходИтог = РасходИтог;
	ОбластьПодвал.Параметры.КонечныйОстатокИтог = КонечныйОстатокИтог;
	ТабДок.Вывести(ОбластьПодвал);
	
	ТабличныеДокументы.Вставить(ИмяРаздела, ТабДок);
	
КонецПроцедуры
