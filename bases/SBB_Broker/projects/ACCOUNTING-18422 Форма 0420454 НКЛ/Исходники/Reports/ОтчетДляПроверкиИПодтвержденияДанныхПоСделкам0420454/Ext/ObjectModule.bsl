// Формирует текст запроса для выбора биржевых сделок (клиентских и собственных)
// 
// Возвращаемое значение:
//  Строка - Текст запроса
//
Функция ТекстЗапросаФондовыйРынок()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	БиржеваяСделка.Дата КАК ДатаВремяСделки,
	|	БиржеваяСделка.Номер КАК НомерСделки,
	|	БиржеваяСделка.ВидСделки КАК НаправлениеСделки,
	|	БиржеваяСделка.Биржа КАК Биржа,
	|	БиржеваяСделка.Портфель КАК Портфель,
	|	БиржеваяСделка.РежимТоргов КАК РежимТоргов,
	|	БиржеваяСделка.Сумма КАК СуммаСделки,
	|	БиржеваяСделка.ВалютаСделки КАК ВалютаСделки,
	|	БиржеваяСделка.ТипДеятельности КАК ТипДеятельности,
	|	БиржеваяСделка.ЦеннаяБумага КАК ЦеннаяБумага,
	|	БиржеваяСделка.ЦеннаяБумага.ISIN КАК ISIN,
	|	БиржеваяСделка.Клиент КАК Клиент,
	|	БиржеваяСделка.ПерваяСделка КАК ПерваяСделка,
	|	БиржеваяСделка.ИдентификаторЗагрузки КАК ИдентификаторСделки,
	|	ВЫРАЗИТЬ(БиржеваяСделка.Поручение КАК Документ.ПоручениеКлиента) КАК ПоручениеКлиента,
	|	ВЫРАЗИТЬ(БиржеваяСделка.Комментарий КАК СТРОКА(1000)) КАК Комментарий,
	|	БиржеваяСделка.БанковскийСчет КАК БанковскийСчет,
	|	БиржеваяСделка.ДатаОплатыПлановая КАК ДатаОплатыПлан,
	|	СостоянияСделкиСрезПоследних.ДатаОплаты КАК ДатаОплатыФакт,
	|	БиржеваяСделка.ДатаПеререгистрацииПлановая КАК ДатаПеререгистрацииПлан,
	|	СостоянияСделкиСрезПоследних.ДатаПеререгистрации КАК ДатаПеререгистрацииФакт,
	|	БиржеваяСделка.Депозитарий КАК Депозитарий,
	|	БиржеваяСделка.ДепозитарийКонтрагента КАК ДепозитарийКонтрагента,
	|	БиржеваяСделка.ДоговорСКлиентом КАК Договор,
	|	БиржеваяСделка.Количество КАК Количество,
	|	БиржеваяСделка.Контрагент КАК Контрагент,
	|	БиржеваяСделка.ПроцентРЕПО КАК ПроцентРЕПО,
	|	БиржеваяСделка.СуммаНКД КАК СуммаНКД,
	|	БиржеваяСделка.Цена КАК Цена,
	|	БиржеваяСделка.ВтораяЧастьДатаРасчетов КАК ВтораяЧастьДатаРасчетов,
	|	БиржеваяСделка.ВтораяЧастьСуммаНКД КАК ВтораяЧастьСуммаНКД,
	|	БиржеваяСделка.ВтораяЧастьЦена КАК ВтораяЧастьЦена,
	|	БиржеваяСделка.ТипСделкиРЕПО КАК ТипСделкиРЕПО,
	|	БиржеваяСделка.СпособРасчета КАК СпособРасчета,
	|	ВЫРАЗИТЬ(БиржеваяСделка.УсловиеОпределенияСуммы КАК СТРОКА(1000)) КАК УсловиеОпределенияСуммы
	|ПОМЕСТИТЬ ВТ_Сделки
	|ИЗ
	|	Документ.БиржеваяСделка КАК БиржеваяСделка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСделки.СрезПоследних(&КонецПериода, ) КАК СостоянияСделкиСрезПоследних
	|		ПО БиржеваяСделка.Ссылка = СостоянияСделкиСрезПоследних.Сделка
	|ГДЕ
	|	БиржеваяСделка.Дата МЕЖДУ &НачалоПериодаФондаВалюта И &КонецПериода
	|	И БиржеваяСделка.ТипДеятельности В (&ТипДеятельностиБрокерская, &ТипДеятельностиДилерская)
	|	И (БиржеваяСделка.ДатаОплатыПлановая > &КонецПериода
	|			ИЛИ БиржеваяСделка.ДатаПеререгистрацииПлановая > &КонецПериода)
	|	И НЕ СостоянияСделкиСрезПоследних.СостояниеСделки В (&СостоянияЗавершенныхСделок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	БиржеваяСделка.Дата,
	|	БиржеваяСделка.Номер,
	|	БиржеваяСделка.ВидСделки,
	|	БиржеваяСделка.Биржа,
	|	БиржеваяСделка.Портфель,
	|	БиржеваяСделка.РежимТоргов,
	|	БиржеваяСделка.Сумма,
	|	БиржеваяСделка.ВалютаСделки,
	|	БиржеваяСделка.ТипДеятельности,
	|	БиржеваяСделка.ЦеннаяБумага,
	|	БиржеваяСделка.ЦеннаяБумага.ISIN,
	|	БиржеваяСделка.Клиент,
	|	БиржеваяСделка.ПерваяСделка,
	|	БиржеваяСделка.ИдентификаторЗагрузки,
	|	ВЫРАЗИТЬ(БиржеваяСделка.Поручение КАК Документ.ПоручениеКлиента),
	|	ВЫРАЗИТЬ(БиржеваяСделка.Комментарий КАК СТРОКА(1000)),
	|	БиржеваяСделка.БанковскийСчет,
	|	БиржеваяСделка.ДатаОплатыПлановая,
	|	СостоянияСделкиСрезПоследних.ДатаОплаты,
	|	БиржеваяСделка.ДатаПеререгистрацииПлановая,
	|	СостоянияСделкиСрезПоследних.ДатаПеререгистрации,
	|	БиржеваяСделка.Депозитарий,
	|	БиржеваяСделка.ДепозитарийКонтрагента,
	|	БиржеваяСделка.ДоговорСКлиентом,
	|	БиржеваяСделка.Количество,
	|	БиржеваяСделка.Контрагент,
	|	БиржеваяСделка.ПроцентРЕПО,
	|	БиржеваяСделка.СуммаНКД,
	|	БиржеваяСделка.Цена,
	|	БиржеваяСделка.ВтораяЧастьДатаРасчетов,
	|	БиржеваяСделка.ВтораяЧастьСуммаНКД,
	|	БиржеваяСделка.ВтораяЧастьЦена,
	|	БиржеваяСделка.ТипСделкиРЕПО,
	|	БиржеваяСделка.СпособРасчета,
	|	ВЫРАЗИТЬ(БиржеваяСделка.УсловиеОпределенияСуммы КАК СТРОКА(1000))
	|ИЗ
	|	Документ.БиржеваяСделка КАК БиржеваяСделка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияСделки.СрезПоследних(&КонецПериода, ) КАК СостоянияСделкиСрезПоследних
	|		ПО БиржеваяСделка.Ссылка = СостоянияСделкиСрезПоследних.Сделка
	|ГДЕ
	|	БиржеваяСделка.Дата МЕЖДУ &НачалоПериодаФондаВалюта И &КонецПериода
	|	И БиржеваяСделка.ТипДеятельности В (&ТипДеятельностиБрокерская, &ТипДеятельностиДилерская)
	|	И (БиржеваяСделка.ДатаОплатыПлановая <= &КонецПериода
	|			ИЛИ БиржеваяСделка.ДатаПеререгистрацииПлановая <= &КонецПериода)
	|	И (СостоянияСделкиСрезПоследних.ДатаОплаты = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ СостоянияСделкиСрезПоследних.ДатаОплаты > &КонецПериода)
	|	И НЕ СостоянияСделкиСрезПоследних.СостояниеСделки В (&СостоянияЗавершенныхСделок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Сделки.ДатаВремяСделки КАК ДатаВремяСделки,
	|	ВТ_Сделки.НомерСделки КАК НомерСделки,
	|	ВТ_Сделки.НаправлениеСделки КАК НаправлениеСделки,
	|	ВТ_Сделки.Биржа КАК Биржа,
