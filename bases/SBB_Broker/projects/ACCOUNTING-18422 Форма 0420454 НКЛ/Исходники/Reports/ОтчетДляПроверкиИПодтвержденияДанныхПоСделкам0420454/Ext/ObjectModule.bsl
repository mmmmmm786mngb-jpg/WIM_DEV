
// Формирует табличные документы для каждого раздела отчета.
// 
// Возвращаемое значение:
//  Структура - соответствие разделов отчета и сформированных табличных документов
//
Функция РезультатФормированияОтчета() Экспорт
	
	ТабличныеДокументы = Новый Структура;
	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода = КонецДня(Дата);
	
	ЗапросДанныеРазделов = ЗапросДанныеРазделов(НачалоПериода, КонецПериода);
	ДанныеРазделов = ЗапросДанныеРазделов.ВыполнитьПакет();
	
	ДобавитьРазделВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, "КлиентскиеСделкиФонд", "ФондовыйРынок");
	ДобавитьРазделВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, "СобственныеСделкиФонд", "ФондовыйРынок");
	ДобавитьРазделВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, "КлиентскиеСделкиВал", "ВалютныйРынок");
	ДобавитьРазделВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, "СобственныеСделкиВал", "ВалютныйРынок");
	
	ДобавитьРазделОстаткиИОборотыВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, "ОбязательстваПоКомиссиямС");
	ДобавитьРазделОстаткиИОборотыВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, "ОбязательстваПоКомиссиямБез");
	ДобавитьРазделОстаткиИОборотыВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, "ОбязательстваПоРасходамС");
	ДобавитьРазделОстаткиИОборотыВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, "ОбязательстваПоРасходамБез");
	ДобавитьРазделОстаткиИОборотыВТабличныйДокумент(ТабличныеДокументы, ДанныеРазделов, "СобственныеАктивыНаФОРТС", "Ценная бумага", "Количество", "К");
	
	Возврат ТабличныеДокументы;
	
КонецФункции

// Возвращает выборку записей из массива результатов запроса для указанного раздела
//
// Параметры:
//  ДанныеРазделов	 - Массив - Результаты запроса по разделам
//  ИмяРаздела		 - Строка - Имя раздела
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса или Неопределено- данные указанного раздела
//
Функция ДанныеРазделаПоИмени(ДанныеРазделов, ИмяРаздела)
	
	Если ИмяРаздела = "КлиентскиеСделкиФонд" Тогда 
		Возврат ДанныеРазделов[1].Выбрать();
	ИначеЕсли ИмяРаздела = "СобственныеСделкиФонд" Тогда 
		Возврат ДанныеРазделов[2].Выбрать();
	ИначеЕсли ИмяРаздела = "КлиентскиеСделкиВал" Тогда 
		Возврат ДанныеРазделов[4].Выбрать();
	ИначеЕсли ИмяРаздела = "СобственныеСделкиВал" Тогда 
		Возврат ДанныеРазделов[5].Выбрать();
	ИначеЕсли ИмяРаздела = "ОбязательстваПоКомиссиямС" Тогда 
		Возврат ДанныеРазделов[6].Выбрать();
	ИначеЕсли ИмяРаздела = "ОбязательстваПоКомиссиямБез" Тогда 
		Возврат ДанныеРазделов[7].Выбрать();
	ИначеЕсли ИмяРаздела = "ОбязательстваПоРасходамС" Тогда 
		Возврат ДанныеРазделов[8].Выбрать();
	ИначеЕсли ИмяРаздела = "ОбязательстваПоРасходамБез" Тогда 
		Возврат ДанныеРазделов[9].Выбрать();
	ИначеЕсли ИмяРаздела = "СобственныеАктивыНаФОРТС" Тогда 
		Возврат ДанныеРазделов[10].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Формирует текст запроса и получает данные разделов из БД
//
// Параметры:
//  НачалоПериода	 - Дата - Начало периода отчета
//  КонецПериода	 - Дата - Окончание периода отчета
// 
// Возвращаемое значение:
//  Массив - Результаты выполнения запроса
//
Функция ЗапросДанныеРазделов(НачалоПериода, КонецПериода) Экспорт 
	
	НачалоПериодаФондаВалюта = РегистрыСведений.ПараметрыГлобальные.ЗначениеПараметра("12201.НачалоПериодаФондаВалюта");
	КодыРежимовТорговДляИсключенияСтрока =
		РегистрыСведений.ПараметрыГлобальные.ЗначениеПараметра("12972.КодыРежимовТорговИсключаемыеИзРазделаФондовыйРынокСобственныеСделки");
	КодыРежимовТорговДляИсключения = СтрРазделить(КодыРежимовТорговДляИсключенияСтрока, ",", Ложь);
	
	Разделитель = "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаФондовыйРынок() + Разделитель
				 + ТекстЗапросаВалютныйРынок() + Разделитель
				 + ТекстЗапросаОстаткиИОбороты("ВидыЗатратОбязательстваПоКомиссиям", "ПредоставленоПравоПользованияДСДа") + Разделитель
				 + ТекстЗапросаОстаткиИОбороты("ВидыЗатратОбязательстваПоКомиссиям", "ПредоставленоПравоПользованияДСНет") + Разделитель
				 + ТекстЗапросаОстаткиИОбороты("ВидыЗатратОбязательстваПоРасходам", "ПредоставленоПравоПользованияДСДа") + Разделитель
				 + ТекстЗапросаОстаткиИОбороты("ВидыЗатратОбязательстваПоРасходам", "ПредоставленоПравоПользованияДСНет") + Разделитель
				 + ТекстЗапросаСобственныеАктивыНаФОРТС();
				 
	Запрос.УстановитьПараметр("НачалоПериодаФондаВалюта", НачалоПериодаФондаВалюта);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("ТипДеятельностиБрокерская", Перечисления.ТипыДеятельности.Б);
	Запрос.УстановитьПараметр("ТипДеятельностиДилерская", Перечисления.ТипыДеятельности.Д);
	Запрос.УстановитьПараметр("ТипыСделок", ТипыСделок());
	Запрос.УстановитьПараметр("ВидыЗатратОбязательстваПоКомиссиям", ВидыЗатратОбязательстваПоКомиссиям());
	Запрос.УстановитьПараметр("ВидыЗатратОбязательстваПоРасходам", ВидыЗатратОбязательстваПоРасходам());
	Запрос.УстановитьПараметр("ДепозитарийFORTS", Справочники.МестаХранения.МестоХраненияFORTS());
	Запрос.УстановитьПараметр("ВидВалютнойСделкиSwap", Перечисления.ВидыВалютныхСделок.Swap);
	Запрос.УстановитьПараметр("ТипСделкиSwap", Перечисления.ТипыСделокПоручение.Swap);
	Запрос.УстановитьПараметр("ТипСделкиSpot", Перечисления.ТипыСделокПоручение.Spot);
	Запрос.УстановитьПараметр("СостоянияЗавершенныхСделок", СостоянияЗавершенныхСделок());
	Запрос.УстановитьПараметр("КодыРежимовТорговДляИсключения", КодыРежимовТорговДляИсключения);
	
	Возврат Запрос;
	
КонецФункции

Функция СостоянияЗавершенныхСделок()
	
	Состояния = Новый СписокЗначений;
	Состояния.Добавить(Перечисления.СостоянияСделок.Завершена);
	Состояния.Добавить(Перечисления.СостоянияСделок.Отменена);
	Состояния.Добавить(Перечисления.СостоянияСделок.Расторгнута);
			
	Возврат Состояния;
	
КонецФункции

// Формирует список типов клиентских сделок
// 
// Возвращаемое значение:
//  СписокЗначений - Список типов клиентских сделок
//
Функция ТипыСделок()
	
	ТипыСделок = Новый СписокЗначений;
	ТипыСделок.Добавить(Перечисления.ТипыСделокПоручение.Сделка);
	ТипыСделок.Добавить(Перечисления.ТипыСделокПоручение.РЕПО);
	ТипыСделок.Добавить(Перечисления.ТипыСделокПоручение.СделкаСПаями);
	
	Возврат ТипыСделок;
	
КонецФункции

// Формирует список видов затрат для отбора обязательств по комиссиям
// 
// Возвращаемое значение:
//  СписокЗначений - Список видов затрат
//
Функция ВидыЗатратОбязательстваПоКомиссиям()
	
	ВидыЗатрат = Новый СписокЗначений;
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.Вознаграждение);
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.Депозитарная);
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.РКО);
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.ВознаграждениеУЦ);
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.КомпенсацияНедостаточностиГО);
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.КомиссияКВозмещению);
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.Прочие);
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.МаржинальноеВознаграждение);
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.Займы);
	
	Возврат ВидыЗатрат;
	
КонецФункции

// Формирует список видов затрат для отбора обязательств по расходам
// 
// Возвращаемое значение:
//  СписокЗначений - Список видов затрат
//
Функция ВидыЗатратОбязательстваПоРасходам()
	
	ВидыЗатрат = Новый СписокЗначений;
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.СтороннегоБрокера);
	ВидыЗатрат.Добавить(Перечисления.ТипыУслугБиржевые.Налог);
	
