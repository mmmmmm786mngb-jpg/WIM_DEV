{"S","s = ""Возврат средств по РД Плат.пор. №143700 от 20.06.2024"";

ДатаНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
Сообщить(ДатаНачала);

// Функция NumbersFromString
// Дана строка, содержащая натуральные числа и слова. 
// Необходимо сформировать массив подстрок из чисел, содержащихся в этой строке.

length = StrLen(s);
integers = new Array;
i = 1;
while i <= length do
    s_int = """";
    while i <= length and ""0"" <= Mid(s, i, 1) and Mid(s, i, 1) <= ""9"" do
        s_int = s_int + Mid(s, i, 1);
        i = i + 1;
	enddo;
    i = i + 1;
    if s_int <> """" then
        integers.add(s_int);
	endif;
enddo;

ДатаОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах(); 
Сообщить(ДатаОкончания);

ВремяВыполненияЗапроса = ДатаОкончания - ДатаНачала;
Сообщить(ВремяВыполненияЗапроса);
"},
