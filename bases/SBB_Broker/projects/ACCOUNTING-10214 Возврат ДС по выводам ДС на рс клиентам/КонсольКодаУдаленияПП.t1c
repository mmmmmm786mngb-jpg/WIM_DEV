{"#",fc01b5df-97fe-449b-83d4-218a090e681e,5c63bdff-1a2e-4036-8184-706d1796a48a},
{"S","	  
	  СтрокаСЧислом = ""Возврат средств по платежному поручению 7685 от 03/03/2025. Счет получателя закрыт."";
	  
ДатаНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
Сообщить(ДатаНачала);
	  
	  Результат= """";
	  ДлинаСтроки = СтрДлина(СтрокаСЧислом);
	  ДоступныеСимволы = ""0123456789"";
	  ОжидаемНачалоЧисла = Истина;
	  
	  Для Индекс = 1 По ДлинаСтроки Цикл
		  ПроверяемыйСимвол = Сред(СтрокаСЧислом, Индекс, 1);
		  ЭтоСимволЦифра = СтрНайти(ДоступныеСимволы, ПроверяемыйСимвол) > 0;
		  Если ЭтоСимволЦифра Тогда
		     Если ОжидаемНачалоЧисла Тогда
		  	    ОжидаемНачалоЧисла = Ложь;
				Результат = ПроверяемыйСимвол; 
		     Иначе
			    Результат = Результат + ПроверяемыйСимвол;
		     КонецЕсли;
		  Иначе
			 Если ОжидаемНачалоЧисла Тогда
		  	    Продолжить;	  
		     Иначе
			    Прервать;
		     КонецЕсли; 
		  КонецЕсли;
	  КонецЦикла;
	  
	  

ДатаОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах(); 
Сообщить(ДатаОкончания);

ВремяВыполненияЗапроса = ДатаОкончания - ДатаНачала;
Сообщить(ВремяВыполненияЗапроса);
