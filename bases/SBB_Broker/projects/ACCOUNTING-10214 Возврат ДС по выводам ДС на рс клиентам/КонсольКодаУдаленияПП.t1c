{"#",fc01b5df-97fe-449b-83d4-218a090e681e,c0bc49e3-da37-4899-bc5b-31acd874b1aa},
{"S","   Выгружено = Ложь;
   Договор = Справочники.ДоговорыКонтрагентов.НайтиПоКоду(""1001051"");
   Если Не (Договор.ДатаОкончанияДействия < ТекущаяДатаСеанса() И Договор.ДатаОкончанияДействия <> Дата(1, 1, 1)) Тогда
   
  	ДоговорыДляРегистрации = новый Массив;
   	ДоговорыДляРегистрации.Добавить(Договор);
   
   	ДанныеДляФайла = РегистрацияКлиентовСервер.ДанныеПортфеляИБиржевыхКодовКлиента(ДоговорыДляРегистрации);
   
   	ФайлXMLАнкеты = Обработки.ВыгрузкаXMLАнкетДляРегистрацииКлиентовНаБирже.АнкетыДляРегистрацииКлиентов(ДанныеДляФайла);
    Выгружено = ФайлXMLАнкеты.Количество() > 0;
	
КонецЕсли;
ОбщегоНазначенияКлиентСервер.СообщитьПользователю(""Договор = "" + Договор + ""; Выгружено = "" + Выгружено);"},
