#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ДатаДок = ТекущаяДатаСеанса();
    ДатаОткрытияСчета = НачалоДня(ТекущаяДатаСеанса());
    ДатаИсторическихЗначений = КонецМесяца(ДобавитьМесяц(ДатаДок, -1));
    ФорматФайла = 0;
    ФлСоздаватьКонтрагентов = Ложь;
    ФлСоздаватьЛицевыеСчета = Ложь;
    МножитьЛицСчета = Ложь;
    НастроитьРастягиваниеТаблиц();

КонецПроцедуры

// Описание: Растягивает страницы и таблицы строк/протокола на ширину окна.
// На веб-клиенте автоограничение ширины таблицы не отключается свойством формы,
// поэтому явно задаются РастягиватьПоГоризонтали и Ширина в символах.
//
Процедура НастроитьРастягиваниеТаблиц()

    Элементы.ГруппаРабочаяОбласть.РастягиватьПоГоризонтали = Истина;
    Элементы.Страницы.РастягиватьПоГоризонтали = Истина;
    Элементы.СтраницаСтроки.РастягиватьПоГоризонтали = Истина;
    Элементы.СтраницаПротокол.РастягиватьПоГоризонтали = Истина;
    Элементы.СтрокиФайла.РастягиватьПоГоризонтали = Истина;
    Элементы.ПротоколСопоставления.РастягиватьПоГоризонтали = Истина;
    Элементы.СтрокиФайла.Ширина = 180;
    Элементы.ПротоколСопоставления.Ширина = 180;
    Элементы.Страницы.Ширина = 180;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

    ОбновитьПодсказкуИтогов();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяФайлаКлиентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ВыбратьФайл(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ФондПриИзменении(Элемент)

    ЗаполнитьЛицевойСчетНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура НоминальныйДержательПриИзменении(Элемент)

    ЗаполнитьЛицевойСчетНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайл(Команда)

    // В веб-клиенте локальный путь недоступен: файл сразу помещаем во временное хранилище.
    Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);
    НачатьПомещениеФайла(Оповещение, АдресФайлаВоВременномХранилище, ИмяФайлаКлиент, Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда)

    Если ПустаяСтрока(АдресФайлаВоВременномХранилище) Тогда
        ВыбратьФайл(Команда);
        Возврат;
    КонецЕсли;

    ПрочитатьФайлНаСервере();
    Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСтроки;
    ОбновитьПодсказкуИтогов();

КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

    Если Не Результат Тогда
        Возврат;
    КонецЕсли;

    АдресФайлаВоВременномХранилище = Адрес;
    Если ЗначениеЗаполнено(ВыбранноеИмяФайла) Тогда
        ИмяФайлаКлиент = ВыбранноеИмяФайла;
    КонецЕсли;

    ПрочитатьФайлНаСервере();
    Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСтроки;
    ОбновитьПодсказкуИтогов();

КонецПроцедуры

&НаКлиенте
Процедура Сопоставить(Команда)

    Если СтрокиФайла.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Сначала прочитайте файл.");
        Возврат;
    КонецЕсли;

    СопоставитьНаСервере();
    Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПротокол;
    ОбновитьПодсказкуИтогов();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНедостающих(Команда)

    Если СтрокиФайла.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Нет строк для создания.");
        Возврат;
    КонецЕсли;

    СоздатьНедостающихНаСервере();
    ОбновитьПодсказкуИтогов();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокумент(Команда)

    СсылкаДокумента = СоздатьДокументНаСервере();
    Если ЗначениеЗаполнено(СсылкаДокумента) Тогда
        ПоказатьЗначение(, СсылкаДокумента);
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьПротокол(Команда)

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Фильтр = "Табличный документ (*.mxl)|*.mxl";
    Диалог.ПолноеИмяФайла = "protocol_nominee_owners.mxl";
    Оповещение = Новый ОписаниеОповещения("СохранитьПротоколЗавершение", ЭтотОбъект);
    Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьПротоколЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    АдресПротокола = ПоместитьПротоколВоВременноеХранилище();
    Если Не ЗначениеЗаполнено(АдресПротокола) Тогда
        Возврат;
    КонецЕсли;

    ПолучитьФайл(АдресПротокола, ВыбранныеФайлы[0], Истина);

КонецПроцедуры

&НаКлиенте
Процедура НайтиНезаполненные(Команда)

    УстановитьОтборСтрок(Новый Структура("Контрагент", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка")));

КонецПроцедуры

&НаКлиенте
Процедура НайтиНеНайденные(Команда)

    УстановитьОтборСтрок(Новый Структура("СпособСопоставления", ""));

КонецПроцедуры

&НаКлиенте
Процедура НайтиПодмены(Команда)

    УстановитьОтборСтрок(Новый Структура("ПодменаКлиента", Истина));

КонецПроцедуры

&НаКлиенте
Процедура НайтиВыборИзНескольких(Команда)

    УстановитьОтборСтрок(Новый Структура("ВыборИзНескольких", Истина));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтбор(Команда)

    УстановитьОтборСтрок(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборСтрок(Отбор)

    Элементы.СтрокиФайла.ОтборСтрок = Отбор;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПодсказкуИтогов()

    Если ПустаяСтрока(ТекстИтогов) Тогда
        ТекстИтогов = "Строк в таблице: " + СтрокиФайла.Количество();
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛицевойСчетНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ЛицевойСчет = ОбработкаОбъект.НайтиЛицевойСчетНоминальногоДержателя(Фонд, НоминальныйДержатель);

КонецПроцедуры

&НаСервере
Функция ПараметрыНачиткиФормы()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ПараметрыНачитки = ОбработкаОбъект.НовыйПараметрыНачитки();
    ПараметрыНачитки.Фонд = Фонд;
    ПараметрыНачитки.НоминальныйДержатель = НоминальныйДержатель;
    ПараметрыНачитки.ЛицевойСчет = ЛицевойСчет;
    ПараметрыНачитки.ГруппаКонтрагентов = ГруппаКонтрагентов;
    ПараметрыНачитки.ДатаДок = ДатаДок;
    ПараметрыНачитки.ДатаИсторическихЗначений = ДатаИсторическихЗначений;
    ПараметрыНачитки.ДатаОткрытияСчета = ДатаОткрытияСчета;
    ПараметрыНачитки.ФлСоздаватьКонтрагентов = ФлСоздаватьКонтрагентов;
    ПараметрыНачитки.ФлСоздаватьЛицевыеСчета = ФлСоздаватьЛицевыеСчета;
    ПараметрыНачитки.МножитьЛицСчета = МножитьЛицСчета;
    ПараметрыНачитки.ФорматФайла = ФорматФайла;

    Возврат ПараметрыНачитки;

КонецФункции

&НаСервере
Процедура ПрочитатьФайлНаСервере()

    Если ПустаяСтрока(АдресФайлаВоВременномХранилище) Тогда
        Возврат;
    КонецЕсли;

    ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
    Расширение = РасширениеИмениФайла(ИмяФайлаКлиент);
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
    ДвоичныеДанные.Записать(ИмяВременногоФайла);

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ТаблицаСтрок = ОбработкаОбъект.ПрочитатьФайлВТаблицу(ИмяВременногоФайла, ПараметрыНачиткиФормы());
    ЗначениеВРеквизитФормы(ТаблицаСтрок, "СтрокиФайла");
    ТекстИтогов = "Прочитано строк: " + ТаблицаСтрок.Количество();

    Попытка
        УдалитьФайлы(ИмяВременногоФайла);
    Исключение
        // Временный файл удалит платформа.
    КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СопоставитьНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ТаблицаСтрок = РеквизитФормыВЗначение("СтрокиФайла");
    Результат = ОбработкаОбъект.СопоставитьСтрокиФайла(ТаблицаСтрок, ПараметрыНачиткиФормы());
    ЗначениеВРеквизитФормы(Результат.ТаблицаСтрок, "СтрокиФайла");
    ЗначениеВРеквизитФормы(Результат.Протокол, "ПротоколСопоставления");
    ТекстИтогов = Результат.ТекстИтогов;

КонецПроцедуры

&НаСервере
Процедура СоздатьНедостающихНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ТаблицаСтрок = РеквизитФормыВЗначение("СтрокиФайла");
    Результат = ОбработкаОбъект.СоздатьНедостающихПоСтрокам(ТаблицаСтрок, ПараметрыНачиткиФормы());
    ЗначениеВРеквизитФормы(Результат.ТаблицаСтрок, "СтрокиФайла");
    ТекстИтогов = "Создано контрагентов: " + Результат.СозданоКонтрагентов
        + ", лицевых счетов: " + Результат.СозданоЛицевыхСчетов
        + ", банковских счетов: " + Результат.СозданоБанковскихСчетов;

КонецПроцедуры

&НаСервере
Функция СоздатьДокументНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ТаблицаСтрок = РеквизитФормыВЗначение("СтрокиФайла");
    Результат = ОбработкаОбъект.СоздатьДокументСписокВладельцев(ТаблицаСтрок, ПараметрыНачиткиФормы());
    ТекстИтогов = "Документ записан. Строк: " + Результат.ЗаписаноСтрок + ", пропущено: " + Результат.ПропущеноСтрок;

    Возврат Результат.Ссылка;

КонецФункции

&НаСервере
Функция ПоместитьПротоколВоВременноеХранилище()

    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Область(1, 1).Текст = "Протокол сопоставления владельцев НД";
    ТабДок.Область(2, 1).Текст = ТекстИтогов;

    НомерСтроки = 4;
    ТабДок.Область(НомерСтроки, 1).Текст = "N";
    ТабДок.Область(НомерСтроки, 2).Текст = "Категория";
    ТабДок.Область(НомерСтроки, 3).Текст = "ФИО файла";
    ТабДок.Область(НомерСтроки, 4).Текст = "ФИО карточки";
    ТабДок.Область(НомерСтроки, 5).Текст = "Способ";
    ТабДок.Область(НомерСтроки, 6).Текст = "НРД файла";
    ТабДок.Область(НомерСтроки, 7).Текст = "НРД до";
    ТабДок.Область(НомерСтроки, 8).Текст = "Комментарий";

    Для Каждого СтрокаПротокола Из ПротоколСопоставления Цикл
        НомерСтроки = НомерСтроки + 1;
        ТабДок.Область(НомерСтроки, 1).Текст = Строка(СтрокаПротокола.НомерСтрокиФайла);
        ТабДок.Область(НомерСтроки, 2).Текст = СтрокаПротокола.Категория;
        ТабДок.Область(НомерСтроки, 3).Текст = СтрокаПротокола.ФИОФайла;
        ТабДок.Область(НомерСтроки, 4).Текст = СтрокаПротокола.ФИОКарточки;
        ТабДок.Область(НомерСтроки, 5).Текст = СтрокаПротокола.СпособСопоставления;
        ТабДок.Область(НомерСтроки, 6).Текст = СтрокаПротокола.НРДidФайла;
        ТабДок.Область(НомерСтроки, 7).Текст = СтрокаПротокола.НРДidКарточкиДо;
        ТабДок.Область(НомерСтроки, 8).Текст = СтрокаПротокола.Комментарий;
    КонецЦикла;

    ИмяВременногоФайла = ПолучитьИмяВременногоФайла("mxl");
    ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.MXL);
    ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
    Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

    Попытка
        УдалитьФайлы(ИмяВременногоФайла);
    Исключение
        // Временный файл удалит платформа.
    КонецПопытки;

    Возврат Адрес;

КонецФункции

&НаСервере
Функция РасширениеИмениФайла(Знач ИмяФайла)

    ПозицияТочки = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
    Если ПозицияТочки = 0 Тогда
        Возврат "xlsx";
    КонецЕсли;

    Возврат Сред(ИмяФайла, ПозицияТочки + 1);

КонецФункции

#КонецОбласти
