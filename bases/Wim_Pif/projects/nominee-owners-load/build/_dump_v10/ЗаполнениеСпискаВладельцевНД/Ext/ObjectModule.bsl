// Описание: Возвращает описание внешней обработки для справочника дополнительных отчетов и обработок.
//
// Возвращаемое значение:
// Структура - параметры регистрации обработки и команды открытия формы.
//
Функция СведенияОВнешнейОбработке() Экспорт

    МетаОбъект = ЭтотОбъект.Метаданные();

    ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке();
    ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
    ПараметрыРегистрации.Наименование = МетаОбъект.Синоним;
    ПараметрыРегистрации.Версия = "1.0.3";
    ПараметрыРегистрации.БезопасныйРежим = Ложь;
    ПараметрыРегистрации.Информация =
        "Начитка списка владельцев номинального держателя: пакетный поиск по НРД id, ФИО+ДР и имени+отчеству+ДР+адресу, протокол подмен.";

    Команда = ПараметрыРегистрации.Команды.Добавить();
    Команда.Представление = МетаОбъект.Синоним;
    Команда.Идентификатор = МетаОбъект.Имя;
    Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ВариантЗапускаОткрытиеФормы();
    Команда.ПоказыватьОповещение = Ложь;

    Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Собирает структуру параметров начитки со значениями по умолчанию.
//
// Возвращаемое значение:
// Структура - ключи Фонд, НоминальныйДержатель, ЛицевойСчет, даты, флаги создания и формат файла.
//
Функция НовыйПараметрыНачитки() Экспорт

    ПараметрыНачитки = Новый Структура;
    ПараметрыНачитки.Вставить("Фонд", Справочники.ПИФ.ПустаяСсылка());
    ПараметрыНачитки.Вставить("НоминальныйДержатель", Справочники.Контрагенты.ПустаяСсылка());
    ПараметрыНачитки.Вставить("ЛицевойСчет", Справочники.ЛицевыеСчетаПайщиков.ПустаяСсылка());
    ПараметрыНачитки.Вставить("ГруппаКонтрагентов", Справочники.Контрагенты.ПустаяСсылка());
    ПараметрыНачитки.Вставить("ДатаДок", ТекущаяДатаСеанса());
    ПараметрыНачитки.Вставить("ДатаИсторическихЗначений", ДатаИсторическихЗначенийПоУмолчанию());
    ПараметрыНачитки.Вставить("ДатаОткрытияСчета", НачалоДня(ТекущаяДатаСеанса()));
    ПараметрыНачитки.Вставить("ФлСоздаватьКонтрагентов", Ложь);
    ПараметрыНачитки.Вставить("ФлСоздаватьЛицевыеСчета", Ложь);
    ПараметрыНачитки.Вставить("МножитьЛицСчета", Ложь);
    ПараметрыНачитки.Вставить("ФорматФайла", 0);
    ПараметрыНачитки.Вставить("ЗаписыватьНРДidНаШага2а", Истина);
    ПараметрыНачитки.Вставить("ОбновлятьАнкетуПриПоиске", Ложь);

    Возврат ПараметрыНачитки;

КонецФункции

