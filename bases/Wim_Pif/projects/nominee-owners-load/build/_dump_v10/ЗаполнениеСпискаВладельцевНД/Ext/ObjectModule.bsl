Функция ПривестиКЧислу(Знач ТекстЗначения)

    ТекстЗначения = СокрЛП(СтрЗаменить(Строка(ТекстЗначения), " ", ""));
    ТекстЗначения = СтрЗаменить(ТекстЗначения, ",", ".");
    Если Не ЗначениеЗаполнено(ТекстЗначения) Тогда
        Возврат 0;
    КонецЕсли;

    Попытка
        Возврат Число(ТекстЗначения);
    Исключение
        Возврат 0;
    КонецПопытки;

