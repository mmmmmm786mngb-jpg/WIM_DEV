Функция ПривестиКДате(Знач ЗначениеДаты)

    Если ТипЗнч(ЗначениеДаты) = Тип("Дата") Тогда
        Возврат ЗначениеДаты;
    КонецЕсли;

    ТекстДаты = СокрЛП(Строка(ЗначениеДаты));
    Если Не ЗначениеЗаполнено(ТекстДаты) Тогда
        Возврат Дата(1, 1, 1);
    КонецЕсли;

    Возврат ИзвлечьДатуРожденияИзТекста(ТекстДаты);

КонецФункции

Функция ИзвлечьДатуРожденияИзТекста(Знач Текст)

    Текст = СокрЛП(Строка(Текст));
    Если СтрДлина(Текст) < 8 Тогда
        Возврат Дата(1, 1, 1);
    КонецЕсли;

    Если СтрНайти(Текст, ".") > 0 Тогда
        День = Лев(Текст, 2);
        Месяц = Сред(Текст, 4, 2);
        Год = Сред(Текст, 7, 4);
        Попытка
            Возврат Дата(Число(Год), Число(Месяц), Число(День));
        Исключение
            Возврат Дата(1, 1, 1);
        КонецПопытки;
    КонецЕсли;

    Если СтрНайти(Текст, "-") > 0 Тогда
        Год = Лев(Текст, 4);
        Месяц = Сред(Текст, 6, 2);
        День = Сред(Текст, 9, 2);
        Попытка
            Возврат Дата(Число(Год), Число(Месяц), Число(День));
        Исключение
            Возврат Дата(1, 1, 1);
        КонецПопытки;
    КонецЕсли;

    Возврат Дата(1, 1, 1);

КонецФункции

Процедура ПрочитатьФайлXMLВТБСД(ПутьКФайлу, ТаблицаСтрок, ПараметрыНачитки)

    КодСчетаФильтр = "";
    ЛицевойСчетНД = ЗначениеПараметра(ПараметрыНачитки, "ЛицевойСчет", Неопределено);
    Если ЗначениеЗаполнено(ЛицевойСчетНД) Тогда
        КодСчетаФильтр = СокрЛП(ЛицевойСчетНД.Код);
    КонецЕсли;

    ЧтениеXML = Новый ЧтениеXML;
    ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
    ПостроительDOM = Новый ПостроительDOM;
    ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
    ЧтениеXML.Закрыть();

    УзлыНомера = ДокументDOM.ПолучитьЭлементыПоИмени("ЗЛ_НомерСчета");
    НомерСтроки = 0;

    Для Каждого УзелНомера Из УзлыНомера Цикл

        НомерСчета = СокрЛП(УзелНомера.ТекстовоеСодержимое);
        Если ЗначениеЗаполнено(КодСчетаФильтр) И НомерСчета <> КодСчетаФильтр Тогда
            Продолжить;
        КонецЕсли;

        Пайщик = УзелНомера.РодительскийУзел;
        НомерСтроки = НомерСтроки + 1;
        СтрокаФайла = ТаблицаСтрок.Добавить();
        СтрокаФайла.НомерСтрокиФайла = НомерСтроки;
        СтрокаФайла.ФИО = СокрЛП(ТекстДочернегоУзла(Пайщик, "ЗЛ_Наименование"));
        ЧастиФИО = РазобратьФИО(СтрокаФайла.ФИО);
        СтрокаФайла.Фамилия = ЧастиФИО.Фамилия;
        СтрокаФайла.Имя = ЧастиФИО.Имя;
        СтрокаФайла.Отчество = ЧастиФИО.Отчество;
        СтрокаФайла.ФИО = ЧастиФИО.НормализованноеФИО;
        СтрокаФайла.ДатаРождения = ИзвлечьДатуРожденияИзТекста(ТекстДочернегоУзла(Пайщик, "ЗЛ_ДатаРождения"));
        СтрокаФайла.ЮрАдрес = СокрЛП(ТекстДочернегоУзла(Пайщик, "ЗЛ_ЮрАдрес"));
        СтрокаФайла.ПочтовыйАдрес = СокрЛП(ТекстДочернегоУзла(Пайщик, "ЗЛ_ПочтовыйАдрес"));
        СтрокаФайла.ИНН = СокрЛП(ТекстДочернегоУзла(Пайщик, "ЗЛ_ИНН"));
        СтрокаФайла.КоличествоПаев = ПривестиКЧислу(ТекстДочернегоУзла(Пайщик, "ЗЛ_КоличествоПаев"));
        ДокументТекст = ТекстДочернегоУзла(Пайщик, "ЗЛ_Документ");
        ЗаполнитьПаспортИзСтрокиДокумента(СтрокаФайла, ДокументТекст);

        ТипФЛЮЛ = ВРег(СокрЛП(ТекстДочернегоУзла(Пайщик, "ЗЛ_Тип")));
        Если СтрНайти(ТипФЛЮЛ, "ЮЛ") > 0 Или СтрДлина(СтрокаФайла.ИНН) = 10 Тогда
            СтрокаФайла.ЭтоЮрЛицо = Истина;
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

Функция ТекстДочернегоУзла(Родитель, ИмяУзла)

    Если Родитель = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Для Каждого Узел Из Родитель.ДочерниеУзлы Цикл
        Если Узел.ИмяУзла = ИмяУзла Тогда
            Возврат Строка(Узел.ТекстовоеСодержимое);
        КонецЕсли;
    КонецЦикла;

    Возврат "";

КонецФункции

Процедура ЗаполнитьПаспортИзСтрокиДокумента(СтрокаФайла, ДокументТекст)

    ДокументТекст = СокрЛП(ДокументТекст);
    Если Не ЗначениеЗаполнено(ДокументТекст) Тогда
        Возврат;
    КонецЕсли;

    Если СтрНайти(ДокументТекст, "ОГРН") > 0 Тогда
        СтрокаФайла.ЭтоЮрЛицо = Истина;
        СтрокаФайла.ОГРН = ОтделитьЦифры(ДокументТекст);
        Возврат;
    КонецЕсли;

КонецПроцедуры

Функция ОтделитьЦифры(Знач Текст)

    Результат = "";
    Для Индекс = 1 По СтрДлина(Текст) Цикл
        Символ = Сред(Текст, Индекс, 1);
        Если СтрНайти("0123456789", Символ) > 0 Тогда
            Результат = Результат + Символ;
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

Процедура ЗаполнитьСопоставлениеПоНРДid(ТаблицаСтрок, СвойствоНРДid)

    Идентификаторы = Новый Массив;
    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл
        Если ЗначениеЗаполнено(СтрокаФайла.Контрагент) Тогда
            Продолжить;
        КонецЕсли;
        Если ЗначениеЗаполнено(СтрокаФайла.НРДid) И Идентификаторы.Найти(СтрокаФайла.НРДid) = Неопределено Тогда
            Идентификаторы.Добавить(СтрокаФайла.НРДid);
        КонецЕсли;
    КонецЦикла;

    Если Идентификаторы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ЗначенияСвойствОбъектов.Объект КАК Контрагент,
    |    ЗначенияСвойствОбъектов.Значение КАК НРДid,
    |    Контрагенты.НаименованиеПолное КАК ФИОКарточки
    |ИЗ
    |    РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
    |        ПО ЗначенияСвойствОбъектов.Объект = Контрагенты.Ссылка
    |ГДЕ
    |    ЗначенияСвойствОбъектов.Свойство = &Свойство
    |    И ЗначенияСвойствОбъектов.Значение В (&Идентификаторы)
    |    И НЕ Контрагенты.ПометкаУдаления";
    Запрос.УстановитьПараметр("Свойство", СвойствоНРДid);
    Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

    Найденные = Новый Соответствие;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ОписаниеНайденного = Новый Структура("Контрагент, ФИОКарточки", Выборка.Контрагент, Выборка.ФИОКарточки);
        Найденные.Вставить(Строка(Выборка.НРДid), ОписаниеНайденного);
    КонецЦикла;

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл
        Если ЗначениеЗаполнено(СтрокаФайла.Контрагент) Или Не ЗначениеЗаполнено(СтрокаФайла.НРДid) Тогда
            Продолжить;
        КонецЕсли;
        Данные = Найденные.Получить(СтрокаФайла.НРДid);
        Если Данные = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ПрисвоитьНайденного(СтрокаФайла, Данные.Контрагент, Данные.ФИОКарточки, "НРДid", СтрокаФайла.НРДid, Ложь);
    КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСопоставлениеЮрлиц(ТаблицаСтрок)

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл

        Если ЗначениеЗаполнено(СтрокаФайла.Контрагент) Или Не СтрокаФайла.ЭтоЮрЛицо Тогда
            Продолжить;
        КонецЕсли;

        Если ЗначениеЗаполнено(СтрокаФайла.ИНН) Тогда
            Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", СтрокаФайла.ИНН);
            Если ЗначениеЗаполнено(Контрагент) Тогда
                ПрисвоитьНайденного(СтрокаФайла, Контрагент, Строка(Контрагент), "ИНН", "", Ложь);
                Продолжить;
            КонецЕсли;
        КонецЕсли;

        Если ЗначениеЗаполнено(СтрокаФайла.ОГРН) Тогда
            Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ОГРН", СтрокаФайла.ОГРН);
            Если ЗначениеЗаполнено(Контрагент) Тогда
                ПрисвоитьНайденного(СтрокаФайла, Контрагент, Строка(Контрагент), "ОГРН", "", Ложь);
            КонецЕсли;
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСопоставлениеПоФИОиДР(ТаблицаСтрок, ПараметрыНачитки, СвойствоНРДid)

    ТаблицаПоиска = Новый ТаблицаЗначений;
    ТаблицаПоиска.Колонки.Добавить("НомерСтрокиФайла", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
    ТаблицаПоиска.Колонки.Добавить("ФИО", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
    ТаблицаПоиска.Колонки.Добавить("ДатаРождения", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
    ТаблицаПоиска.Колонки.Добавить("ДокументНомер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл
        Если ЗначениеЗаполнено(СтрокаФайла.Контрагент) Или СтрокаФайла.ВыборИзНескольких Или СтрокаФайла.ЭтоЮрЛицо Тогда
            Продолжить;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(СтрокаФайла.ФИО) Тогда
            Продолжить;
        КонецЕсли;
        СтрокаПоиска = ТаблицаПоиска.Добавить();
        СтрокаПоиска.НомерСтрокиФайла = СтрокаФайла.НомерСтрокиФайла;
        СтрокаПоиска.ФИО = СтрокаФайла.ФИО;
        СтрокаПоиска.ДатаРождения = СтрокаФайла.ДатаРождения;
        СтрокаПоиска.ДокументНомер = СтрокаФайла.ДокументНомер;
    КонецЦикла;

    Если ТаблицаПоиска.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Т.НомерСтрокиФайла КАК НомерСтрокиФайла,
    |    Т.ФИО КАК ФИО,
    |    Т.ДатаРождения КАК ДатаРождения,
    |    Т.ДокументНомер КАК ДокументНомер
    |ПОМЕСТИТЬ ВТФайла
    |ИЗ
    |    &Таблица КАК Т
    |;
    |
    |ВЫБРАТЬ
    |    ВТФайла.НомерСтрокиФайла КАК НомерСтрокиФайла,
    |    Контрагенты.Ссылка КАК Контрагент,
    |    Контрагенты.НаименованиеПолное КАК ФИОКарточки
    |ИЗ
    |    ВТФайла КАК ВТФайла
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
    |        ПО (Контрагенты.Наименование = ВТФайла.ФИО
    |                ИЛИ Контрагенты.НаименованиеПолное = ВТФайла.ФИО)
    |            И НЕ Контрагенты.ПометкаУдаления
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПаспортныеДанныеФизЛиц.СрезПервых КАК ПаспортныеДанныеФизЛицСрезПервых
    |        ПО ПаспортныеДанныеФизЛицСрезПервых.ФизЛицо = Контрагенты.Ссылка
    |ГДЕ
    |    ВЫБОР
    |            КОГДА ВТФайла.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
    |                    ИЛИ Контрагенты.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
    |                ТОГДА ПаспортныеДанныеФизЛицСрезПервых.ДокументНомер = ВТФайла.ДокументНомер
    |            ИНАЧЕ Контрагенты.ДатаРождения = ВТФайла.ДатаРождения
    |        КОНЕЦ";
    Запрос.УстановитьПараметр("Таблица", ТаблицаПоиска);

    КандидатыПоСтроке = Новый Соответствие;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Список = КандидатыПоСтроке.Получить(Выборка.НомерСтрокиФайла);
        Если Список = Неопределено Тогда
            Список = Новый Массив;
            КандидатыПоСтроке.Вставить(Выборка.НомерСтрокиФайла, Список);
        КонецЕсли;
        ОписаниеКандидата = Новый Структура("Контрагент, ФИОКарточки", Выборка.Контрагент, Выборка.ФИОКарточки);
        Список.Добавить(ОписаниеКандидата);
    КонецЦикла;

    Фонд = ЗначениеПараметра(ПараметрыНачитки, "Фонд", Справочники.ПИФ.ПустаяСсылка());

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл
        Если ЗначениеЗаполнено(СтрокаФайла.Контрагент) Тогда
            Продолжить;
        КонецЕсли;
        Список = КандидатыПоСтроке.Получить(СтрокаФайла.НомерСтрокиФайла);
        Если Список = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ОбработатьКандидатовШага2(СтрокаФайла, Список, Фонд, СвойствоНРДid);
    КонецЦикла;

КонецПроцедуры

Процедура ОбработатьКандидатовШага2(СтрокаФайла, Список, Фонд, СвойствоНРДid)

    Если Список.Количество() = 1 Тогда
        Кандидат = Список[0];
        НРДidДо = ПолучитьНРДidКонтрагента(Кандидат.Контрагент, СвойствоНРДid);
        ПрисвоитьНайденного(СтрокаФайла, Кандидат.Контрагент, Кандидат.ФИОКарточки, "ФИО+ДР", НРДidДо, Ложь);
        Если Не ЗначениеЗаполнено(НРДidДо) Тогда
            ЗаписатьНРДid(Кандидат.Контрагент, СтрокаФайла.НРДid, СвойствоНРДid);
        КонецЕсли;
        Возврат;
    КонецЕсли;

    МассивСсылок = Новый Массив;
    Для Каждого Кандидат Из Список Цикл
        МассивСсылок.Добавить(Кандидат.Контрагент);
    КонецЦикла;

    ПайщикПоСчету = НайтиПайщикаПоСчетуВФонде(МассивСсылок, Фонд);
    Если ЗначениеЗаполнено(ПайщикПоСчету) Тогда
        ФИОКарточки = "";
        Для Каждого Кандидат Из Список Цикл
            Если Кандидат.Контрагент = ПайщикПоСчету Тогда
                ФИОКарточки = Кандидат.ФИОКарточки;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        НРДidДо = ПолучитьНРДidКонтрагента(ПайщикПоСчету, СвойствоНРДid);
        ПрисвоитьНайденного(СтрокаФайла, ПайщикПоСчету, ФИОКарточки, "ФИО+ДР+ЛС", НРДidДо, Ложь);
        Если Не ЗначениеЗаполнено(НРДidДо) Тогда
            ЗаписатьНРДid(ПайщикПоСчету, СтрокаФайла.НРДid, СвойствоНРДid);
        КонецЕсли;
        Возврат;
    КонецЕсли;

    СтрокаФайла.ВыборИзНескольких = Истина;
    СтрокаФайла.КоличествоКандидатов = Список.Количество();
    СтрокаФайла.СпособСопоставления = "РучнойВыбор";
    Описание = "";
    Для Каждого Кандидат Из Список Цикл
        Описание = Описание + Строка(Кандидат.Контрагент) + "; ";
    КонецЦикла;
    СтрокаФайла.ОписаниеКандидатов = Описание;
    СтрокаФайла.КомментарийСопоставления = "Найдено несколько карточек с тем же ФИО и датой рождения";

КонецПроцедуры

Функция НайтиПайщикаПоСчетуВФонде(МассивПайщиков, Фонд)

    Если Не ЗначениеЗаполнено(Фонд) Или МассивПайщиков.Количество() = 0 Тогда
        Возврат Справочники.Контрагенты.ПустаяСсылка();
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ЛицевыеСчетаПайщиков.Пайщик КАК Пайщик
    |ИЗ
    |    Справочник.ЛицевыеСчетаПайщиков КАК ЛицевыеСчетаПайщиков
    |ГДЕ
    |    ЛицевыеСчетаПайщиков.Пайщик В (&МассивПайщик)
    |    И ЛицевыеСчетаПайщиков.Владелец = &Владелец
    |    И ЛицевыеСчетаПайщиков.ВидЛицевогоСчета В (ЗНАЧЕНИЕ(Перечисление.ВидыЛицевыхСчетов.СчетНоминальногоДержателя), ЗНАЧЕНИЕ(Перечисление.ВидыЛицевыхСчетов.Технический))
    |    И НЕ ЛицевыеСчетаПайщиков.ПометкаУдаления";
    Запрос.УстановитьПараметр("МассивПайщик", МассивПайщиков);
    Запрос.УстановитьПараметр("Владелец", Фонд);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Пайщик;
    КонецЕсли;

    Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

Процедура ЗаполнитьСопоставлениеПоИмениОтчествуАдресу(ТаблицаСтрок, ПараметрыНачитки, СвойствоНРДid)

    ДатыРождения = Новый Массив;
    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл
        Если ЗначениеЗаполнено(СтрокаФайла.Контрагент) Или СтрокаФайла.ВыборИзНескольких Тогда
            Продолжить;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(СтрокаФайла.Имя) Или Не ЗначениеЗаполнено(СтрокаФайла.Отчество)
            Или Не ЗначениеЗаполнено(СтрокаФайла.ДатаРождения) Тогда
            Продолжить;
        КонецЕсли;
        Если ДатыРождения.Найти(СтрокаФайла.ДатаРождения) = Неопределено Тогда
            ДатыРождения.Добавить(СтрокаФайла.ДатаРождения);
        КонецЕсли;
    КонецЦикла;

    Если ДатыРождения.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ДатаИст = ЗначениеПараметра(ПараметрыНачитки, "ДатаИсторическихЗначений", ТекущаяДатаСеанса());

    ЗапросКандидаты = Новый Запрос;
    ЗапросКандидаты.Текст =
    "ВЫБРАТЬ
    |    Контрагенты.Ссылка КАК Контрагент,
    |    Контрагенты.ДатаРождения КАК ДатаРождения,
    |    Контрагенты.НаименованиеПолное КАК ФИОКарточки
    |ИЗ
    |    Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |    Контрагенты.ДатаРождения В (&ДатыРождения)
    |    И Контрагенты.Пайщик
    |    И НЕ Контрагенты.ПометкаУдаления";
    ЗапросКандидаты.УстановитьПараметр("ДатыРождения", ДатыРождения);
    Кандидаты = ЗапросКандидаты.Выполнить().Выгрузить();
    Если Кандидаты.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Кандидаты.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
    Кандидаты.Колонки.Добавить("Отчество", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));

    СсылкиКандидатов = Кандидаты.ВыгрузитьКолонку("Контрагент");

    ЗапросФИО = Новый Запрос;
    ЗапросФИО.Текст =
    "ВЫБРАТЬ
    |    ФИОФизЛицСрезПоследних.ФизЛицо КАК ФизЛицо,
    |    ФИОФизЛицСрезПоследних.Имя КАК Имя,
    |    ФИОФизЛицСрезПоследних.Отчество КАК Отчество
    |ИЗ
    |    РегистрСведений.ФИОФизЛиц.СрезПоследних(&ДатаИст, ФизЛицо В (&Контрагенты)) КАК ФИОФизЛицСрезПоследних";
    ЗапросФИО.УстановитьПараметр("ДатаИст", ДатаИст);
    ЗапросФИО.УстановитьПараметр("Контрагенты", СсылкиКандидатов);
    ВыборкаФИО = ЗапросФИО.Выполнить().Выбрать();
    Пока ВыборкаФИО.Следующий() Цикл
        СтрокаКандидата = Кандидаты.Найти(ВыборкаФИО.ФизЛицо, "Контрагент");
        Если СтрокаКандидата <> Неопределено Тогда
            СтрокаКандидата.Имя = ВыборкаФИО.Имя;
            СтрокаКандидата.Отчество = ВыборкаФИО.Отчество;
        КонецЕсли;
    КонецЦикла;

    СсылкиКандидатов = Кандидаты.ВыгрузитьКолонку("Контрагент");
    АдресаПоКонтрагенту = ПредставленияАдресовКонтрагентов(СсылкиКандидатов, ДатаИст);
    ЗаписыватьНРД = ЗначениеПараметра(ПараметрыНачитки, "ЗаписыватьНРДidНаШага2а", Истина);

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл

        Если ЗначениеЗаполнено(СтрокаФайла.Контрагент) Или СтрокаФайла.ВыборИзНескольких Тогда
            Продолжить;
        КонецЕсли;

        АдресФайла = АдресФайлаДляПоиска(СтрокаФайла);
        Если Не ЗначениеЗаполнено(АдресФайла) Тогда
            Продолжить;
        КонецЕсли;

        Подобранные = Новый Массив;
        Для Каждого Кандидат Из Кандидаты Цикл
            Если Кандидат.ДатаРождения <> СтрокаФайла.ДатаРождения Тогда
                Продолжить;
            КонецЕсли;
            Если ВРег(СокрЛП(Кандидат.Имя)) <> ВРег(СокрЛП(СтрокаФайла.Имя)) Тогда
                Продолжить;
            КонецЕсли;
            Если ВРег(СокрЛП(Кандидат.Отчество)) <> ВРег(СокрЛП(СтрокаФайла.Отчество)) Тогда
                Продолжить;
            КонецЕсли;
            Если Не АдресСовпадает(АдресФайла, АдресаПоКонтрагенту.Получить(Кандидат.Контрагент)) Тогда
                Продолжить;
            КонецЕсли;
            Подобранные.Добавить(Кандидат);
        КонецЦикла;

        Если Подобранные.Количество() = 1 Тогда
            Кандидат = Подобранные[0];
            НРДidДо = ПолучитьНРДidКонтрагента(Кандидат.Контрагент, СвойствоНРДid);
            ЭтоПодмена = НормализоватьФИОДляСравнения(СтрокаФайла.ФИО) <> НормализоватьФИОДляСравнения(Кандидат.ФИОКарточки);
            ПрисвоитьНайденного(СтрокаФайла, Кандидат.Контрагент, Кандидат.ФИОКарточки, "Имя+Отчество+ДР+Адрес", НРДidДо, ЭтоПодмена);
            Если ЗаписыватьНРД И ЗначениеЗаполнено(СтрокаФайла.НРДid) И СтрокаФайла.НРДid <> Строка(НРДidДо) Тогда
                ЗаписатьНРДid(Кандидат.Контрагент, СтрокаФайла.НРДid, СвойствоНРДid);
                СтрокаФайла.КомментарийСопоставления = СтрокаФайла.КомментарийСопоставления
                    + "; записан новый НРД id";
            КонецЕсли;
        ИначеЕсли Подобранные.Количество() > 1 Тогда
            СтрокаФайла.ВыборИзНескольких = Истина;
            СтрокаФайла.КоличествоКандидатов = Подобранные.Количество();
            СтрокаФайла.СпособСопоставления = "РучнойВыбор";
            СтрокаФайла.КомментарийСопоставления = "Шаг 2а: несколько карточек с тем же именем, отчеством, ДР и адресом";
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

Функция ПредставленияАдресовКонтрагентов(СсылкиКандидатов, ДатаИст)

    Результат = Новый Соответствие;
    Если СсылкиКандидатов.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    История.Объект КАК Контрагент,
    |    История.Представление КАК Представление
    |ИЗ
    |    РегистрСведений.ИсторияИзмененияКонтактнойИнформации.СрезПоследних(
    |            &ДатаИст,
    |            Объект В (&Контрагенты)
    |                И Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)) КАК История
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |    Регл.Контрагент,
    |    Регл.Представление
    |ИЗ
    |    РегистрСведений.ПредставлениеАдресаДляРегламентнойОтчетности.СрезПоследних(&ДатаИст, Контрагент В (&Контрагенты)) КАК Регл";
    Запрос.УстановитьПараметр("Контрагенты", СсылкиКандидатов);
    Запрос.УстановитьПараметр("ДатаИст", ДатаИст);

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Список = Результат.Получить(Выборка.Контрагент);
        Если Список = Неопределено Тогда
            Список = Новый Массив;
            Результат.Вставить(Выборка.Контрагент, Список);
        КонецЕсли;
        Список.Добавить(Выборка.Представление);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция АдресФайлаДляПоиска(СтрокаФайла)

    Если ЗначениеЗаполнено(СтрокаФайла.ЮрАдрес) Тогда
        Возврат СтрокаФайла.ЮрАдрес;
    КонецЕсли;

    Возврат СтрокаФайла.ПочтовыйАдрес;

КонецФункции

Функция АдресСовпадает(АдресФайла, АдресаКарточки)

    НормаФайла = НормализоватьАдресДляПоиска(АдресФайла);
    Если Не ЗначениеЗаполнено(НормаФайла) Или АдресаКарточки = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;

    Для Каждого АдресКарточки Из АдресаКарточки Цикл
        Если НормаФайла = НормализоватьАдресДляПоиска(АдресКарточки) Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;

    Возврат Ложь;

КонецФункции

Функция НормализоватьФИОДляСравнения(Знач ФИО)

    Возврат ВРег(СокрЛП(СтрЗаменить(Строка(ФИО), "  ", " ")));

КонецФункции

Процедура ПрисвоитьНайденного(СтрокаФайла, Контрагент, ФИОКарточки, Способ, НРДidДо, ПодменаКлиента)

    СтрокаФайла.Контрагент = Контрагент;
    СтрокаФайла.ФИОКарточки = ФИОКарточки;
    СтрокаФайла.СпособСопоставления = Способ;
    СтрокаФайла.НРДidКарточкиДо = Строка(НРДidДо);
    СтрокаФайла.ПодменаКлиента = ПодменаКлиента;
    Если Не ЗначениеЗаполнено(СтрокаФайла.КомментарийСопоставления) Тогда
        Если ПодменаКлиента Тогда
            СтрокаФайла.КомментарийСопоставления = "ФИО файла отличается от ФИО карточки, карточка не перезаписывалась";
        Иначе
            СтрокаФайла.КомментарийСопоставления = "Найден по способу " + Способ;
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

Функция ПолучитьНРДidКонтрагента(Контрагент, СвойствоНРДid)

    Если Не ЗначениеЗаполнено(Контрагент) Тогда
        Возврат "";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ЗначенияСвойствОбъектов.Значение КАК Значение
    |ИЗ
    |    РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
    |ГДЕ
    |    ЗначенияСвойствОбъектов.Свойство = &Свойство
    |    И ЗначенияСвойствОбъектов.Объект = &Контрагент";
    Запрос.УстановитьПараметр("Свойство", СвойствоНРДid);
    Запрос.УстановитьПараметр("Контрагент", Контрагент);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Строка(Выборка.Значение);
    КонецЕсли;

    Возврат "";

КонецФункции

Процедура ЗаписатьНРДid(Контрагент, НРДid, СвойствоНРДid)

    Если Не ЗначениеЗаполнено(Контрагент) Или Не ЗначениеЗаполнено(НРДid) Тогда
        Возврат;
    КонецЕсли;

    МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
    МенеджерЗаписи.Объект = Контрагент;
    МенеджерЗаписи.Свойство = СвойствоНРДid;
    МенеджерЗаписи.Значение = НРДid;
    МенеджерЗаписи.Записать();

КонецПроцедуры

Процедура ЗаполнитьЛицевыеИБанковскиеСчета(ТаблицаСтрок, ПараметрыНачитки)

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл

        Если Не ЗначениеЗаполнено(СтрокаФайла.Контрагент) Тогда
            Продолжить;
        КонецЕсли;

        Если Не ЗначениеЗаполнено(СтрокаФайла.ЛицевойСчет) Тогда
            СтрокаФайла.ЛицевойСчет = НайтиИлиСоздатьЛицевойСчет(
                СтрокаФайла.Контрагент,
                ПараметрыНачитки,
                Истина,
                СчетаДляИсключенияПриРазмножении(ТаблицаСтрок, СтрокаФайла, ПараметрыНачитки));
        КонецЕсли;

        Если Не ЗначениеЗаполнено(СтрокаФайла.БанковскийСчет) И ЗначениеЗаполнено(СтрокаФайла.РасчетныйСчет) Тогда
            СтрокаФайла.БанковскийСчет = НайтиБанковскийСчет(СтрокаФайла.РасчетныйСчет, СтрокаФайла.Контрагент);
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

Функция СчетаДляИсключенияПриРазмножении(ТаблицаСтрок, ТекущаяСтрока, ПараметрыНачитки)

    ИсключитьСчета = Новый Массив;
    Если Не ЗначениеПараметра(ПараметрыНачитки, "МножитьЛицСчета", Ложь) Тогда
        Возврат ИсключитьСчета;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ТекущаяСтрока.Контрагент) Тогда
        Возврат ИсключитьСчета;
    КонецЕсли;

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл
        Если СтрокаФайла = ТекущаяСтрока Тогда
            Продолжить;
        КонецЕсли;
        Если СтрокаФайла.Контрагент = ТекущаяСтрока.Контрагент
            И ЗначениеЗаполнено(СтрокаФайла.ЛицевойСчет) Тогда
            ИсключитьСчета.Добавить(СтрокаФайла.ЛицевойСчет);
        КонецЕсли;
    КонецЦикла;

    Возврат ИсключитьСчета;

КонецФункции

Функция НайтиИлиСоздатьЛицевойСчет(Контрагент, ПараметрыНачитки, ТолькоНайти, ИсключитьСчета = Неопределено)

    Фонд = ЗначениеПараметра(ПараметрыНачитки, "Фонд", Справочники.ПИФ.ПустаяСсылка());
    Если Не ЗначениеЗаполнено(Фонд) Тогда
        Возврат Справочники.ЛицевыеСчетаПайщиков.ПустаяСсылка();
    КонецЕсли;

    Если ИсключитьСчета = Неопределено Тогда
        ИсключитьСчета = Новый Массив;
    КонецЕсли;

    Запрос = Новый Запрос;
    ТекстЗапроса =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ЛицевыеСчетаПайщиков.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.ЛицевыеСчетаПайщиков КАК ЛицевыеСчетаПайщиков
    |ГДЕ
    |    ЛицевыеСчетаПайщиков.Владелец = &Владелец
    |    И ЛицевыеСчетаПайщиков.Пайщик = &Пайщик
    |    И (ЛицевыеСчетаПайщиков.ВидЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыЛицевыхСчетов.СчетНоминальногоДержателя)
    |            ИЛИ ЛицевыеСчетаПайщиков.ВидЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыЛицевыхСчетов.Технический))
    |    И НЕ ЛицевыеСчетаПайщиков.ПометкаУдаления";
    Если ИсключитьСчета.Количество() > 0 Тогда
        ТекстЗапроса = ТекстЗапроса + "
        |    И НЕ ЛицевыеСчетаПайщиков.Ссылка В (&ИсключитьСчета)";
    КонецЕсли;
    Запрос.Текст = ТекстЗапроса;
    Запрос.УстановитьПараметр("Владелец", Фонд);
    Запрос.УстановитьПараметр("Пайщик", Контрагент);
    Если ИсключитьСчета.Количество() > 0 Тогда
        Запрос.УстановитьПараметр("ИсключитьСчета", ИсключитьСчета);
    КонецЕсли;

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Если ТолькоНайти = Истина Тогда
        Возврат Справочники.ЛицевыеСчетаПайщиков.ПустаяСсылка();
    КонецЕсли;

    ЛицевойСчетНД = ЗначениеПараметра(ПараметрыНачитки, "ЛицевойСчет", Справочники.ЛицевыеСчетаПайщиков.ПустаяСсылка());
    НовыйСчет = Справочники.ЛицевыеСчетаПайщиков.СоздатьЭлемент();
    Если ЗначениеЗаполнено(ЛицевойСчетНД) И ИсключитьСчета.Количество() = 0 Тогда
        НовыйСчет.Код = СокрЛП(ЛицевойСчетНД.Код);
    КонецЕсли;
    НовыйСчет.ВидЛицевогоСчета = Перечисления.ВидыЛицевыхСчетов.Технический;
    НовыйСчет.Владелец = Фонд;
    НовыйСчет.Пайщик = Контрагент;
    НовыйСчет.ДатаОткрытия = ЗначениеПараметра(ПараметрыНачитки, "ДатаОткрытияСчета", НачалоДня(ТекущаяДатаСеанса()));
    НовыйСчет.ОбменДанными.Загрузка = Истина;
    НовыйСчет.Записать();

    Возврат НовыйСчет.Ссылка;

КонецФункции

Функция НайтиБанковскийСчет(НомерСчета, Контрагент)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    БанковскиеСчета.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.БанковскиеСчета КАК БанковскиеСчета
    |ГДЕ
    |    БанковскиеСчета.НомерСчета = &НомерСчета
    |    И БанковскиеСчета.Владелец = &Владелец
    |    И НЕ БанковскиеСчета.ПометкаУдаления";
    Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
    Запрос.УстановитьПараметр("Владелец", Контрагент);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Возврат Справочники.БанковскиеСчета.ПустаяСсылка();

КонецФункции

Функция НайтиИлиСоздатьБанковскийСчет(СтрокаФайла)

    Найденный = НайтиБанковскийСчет(СтрокаФайла.РасчетныйСчет, СтрокаФайла.Контрагент);
    Если ЗначениеЗаполнено(Найденный) Тогда
        Возврат Найденный;
    КонецЕсли;

    Банк = Справочники.Банки.ПустаяСсылка();
    Если ЗначениеЗаполнено(СтрокаФайла.БИК) Тогда
        Банк = Справочники.Банки.НайтиПоКоду(СтрокаФайла.БИК);
        Если Не ЗначениеЗаполнено(Банк) Тогда
            НовыйБанк = Справочники.Банки.СоздатьЭлемент();
            НовыйБанк.Код = СтрокаФайла.БИК;
            НовыйБанк.Наименование = "Банк " + СтрокаФайла.БИК;
            НовыйБанк.ОбменДанными.Загрузка = Истина;
            НовыйБанк.Записать();
            Банк = НовыйБанк.Ссылка;
        КонецЕсли;
    КонецЕсли;

    НовыйСчет = Справочники.БанковскиеСчета.СоздатьЭлемент();
    НовыйСчет.Владелец = СтрокаФайла.Контрагент;
    НовыйСчет.НомерСчета = СтрокаФайла.РасчетныйСчет;
    НовыйСчет.Банк = Банк;
    НовыйСчет.Наименование = СтрокаФайла.РасчетныйСчет;
    НовыйСчет.ОбменДанными.Загрузка = Истина;
    НовыйСчет.Записать();

    Возврат НовыйСчет.Ссылка;

КонецФункции

Функция СоздатьКонтрагентаПоСтроке(СтрокаФайла, ПараметрыНачитки)

    ЧастиФИО = РазобратьФИО(СтрокаФайла.ФИО);
    НовКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
    НовКонтрагент.НаименованиеПолное = ЧастиФИО.НормализованноеФИО;
    НовКонтрагент.Наименование = ЧастиФИО.Фамилия + " " + Лев(ЧастиФИО.Имя, 1) + "." + Лев(ЧастиФИО.Отчество, 1) + ". "
        + СтрЗаменить(СтрокаФайла.ДокументСерия, " ", "") + " " + СтрокаФайла.ДокументНомер;
    Группа = ЗначениеПараметра(ПараметрыНачитки, "ГруппаКонтрагентов", Справочники.Контрагенты.ПустаяСсылка());
    Если ЗначениеЗаполнено(Группа) Тогда
        НовКонтрагент.Родитель = Группа;
    КонецЕсли;

    Если СтрокаФайла.ЭтоЮрЛицо Тогда
        НовКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
        НовКонтрагент.Пайщик = Истина;
    Иначе
        НовКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
        НовКонтрагент.Пайщик = Истина;
        НовКонтрагент.ДатаРождения = СтрокаФайла.ДатаРождения;
    КонецЕсли;

    НовКонтрагент.ИНН = СтрокаФайла.ИНН;
    НовКонтрагент.ВнешнийIDДляЛК = СледующийВнешнийIDДляЛК();
    НовКонтрагент.ОбменДанными.Загрузка = Истина;
    НовКонтрагент.Записать();

    ДатаИст = ЗначениеПараметра(ПараметрыНачитки, "ДатаИсторическихЗначений", ТекущаяДатаСеанса());
    ЗаписатьФИО(НовКонтрагент.Ссылка, ЧастиФИО.Фамилия, ЧастиФИО.Имя, ЧастиФИО.Отчество, ДатаИст);
    ЗаписатьПаспорт(НовКонтрагент.Ссылка, СтрокаФайла, ДатаИст);
    ЗаписатьАдрес(НовКонтрагент.Ссылка, СтрокаФайла.ЮрАдрес, "Фактический", ДатаИст);
    ЗаписатьАдрес(НовКонтрагент.Ссылка, СтрокаФайла.ПочтовыйАдрес, "Почтовый", ДатаИст);
    ЗаписатьНРДid(НовКонтрагент.Ссылка, СтрокаФайла.НРДid, ОбеспечитьСвойствоНРДid());

    Попытка
        Справочники.Контрагенты.СинхронизацияСохраняемыхРеквизитов(НовКонтрагент.Ссылка, ДатаИст, "");
    Исключение
        // Синхронизация не обязательна для тестовой базы без заполненных регистров.
    КонецПопытки;

    Возврат НовКонтрагент.Ссылка;

КонецФункции

Функция СледующийВнешнийIDДляЛК()

    НачальныйНомер = 100000;
    Попытка
        ЗначениеКонстанты = Константы.НачальныйНомерIDДляЛК.Получить();
        Если ЗначениеЗаполнено(ЗначениеКонстанты) Тогда
            НачальныйНомер = ЗначениеКонстанты;
        КонецЕсли;
    Исключение
        НачальныйНомер = 100000;
    КонецПопытки;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контрагенты.ВнешнийIDДляЛК КАК ВнешнийIDДляЛК
    |ИЗ
    |    Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |    Контрагенты.ВнешнийIDДляЛК >= &НачальныйНомер
    |    И НЕ Контрагенты.ПометкаУдаления
    |
    |УПОРЯДОЧИТЬ ПО
    |    ВнешнийIDДляЛК УБЫВ";
    Запрос.УстановитьПараметр("НачальныйНомер", НачальныйНомер);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ВнешнийIDДляЛК) Тогда
        Возврат Выборка.ВнешнийIDДляЛК + 1;
    КонецЕсли;

    Возврат НачальныйНомер;

КонецФункции

Процедура ЗаписатьФИО(Контрагент, Фамилия, Имя, Отчество, ДатаИст)

    МенеджерЗаписи = РегистрыСведений.ФИОФизЛиц.СоздатьМенеджерЗаписи();
    МенеджерЗаписи.ФизЛицо = Контрагент;
    МенеджерЗаписи.Период = ДатаИст;
    МенеджерЗаписи.Фамилия = Фамилия;
    МенеджерЗаписи.Имя = Имя;
    МенеджерЗаписи.Отчество = Отчество;
    МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

Процедура ЗаписатьПаспорт(Контрагент, СтрокаФайла, ДатаИст)

    Если Не ЗначениеЗаполнено(СтрокаФайла.ДокументНомер) Тогда
        Возврат;
    КонецЕсли;

    ЗаписьПаспорт = РегистрыСведений.ПаспортныеДанныеФизЛиц.СоздатьМенеджерЗаписи();
    ЗаписьПаспорт.Период = ДатаИст;
    ЗаписьПаспорт.ФизЛицо = Контрагент;
    ЗаписьПаспорт.ДокументВид = Справочники.ДокументыУдостоверяющиеЛичность.ПаспортРФ;
    ЗаписьПаспорт.ДокументСерия = СтрокаФайла.ДокументСерия;
    ЗаписьПаспорт.ДокументНомер = СтрокаФайла.ДокументНомер;
    ЗаписьПаспорт.ДокументДатаВыдачи = СтрокаФайла.ДокументДатаВыдачи;
    ЗаписьПаспорт.ДокументКемВыдан = СтрокаФайла.ДокументКемВыдан;
    Попытка
        ЗаписьПаспорт.Гражданство = Справочники.КлассификаторСтранМира.Россия;
    Исключение
        // Предопределенная страна может отсутствовать до начального заполнения.
    КонецПопытки;
    ЗаписьПаспорт.Записать();

КонецПроцедуры

Процедура ЗаписатьАдрес(Контрагент, СтрокаАдрес, ТипПочтФакт, ДатаИст)

    Если Не ЗначениеЗаполнено(СтрокаАдрес) Тогда
        Возврат;
    КонецЕсли;

    Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
    Если ТипПочтФакт = "Почтовый" Тогда
        Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
    Иначе
        Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
    КонецЕсли;

    НаборЗаписей = РегистрыСведений.ИсторияИзмененияКонтактнойИнформации.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Период.Установить(ДатаИст);
    НаборЗаписей.Отбор.Объект.Установить(Контрагент);
    НаборЗаписей.Отбор.Тип.Установить(Тип);
    НаборЗаписей.Отбор.Вид.Установить(Вид);
    Запись = НаборЗаписей.Добавить();
    Запись.Объект = Контрагент;
    Запись.Тип = Тип;
    Запись.Вид = Вид;
    Запись.Период = ДатаИст;
    Запись.Представление = СтрокаАдрес;
    Запись.АдресРазобран = Ложь;
    НаборЗаписей.Записать();

    НаборРегл = РегистрыСведений.ПредставлениеАдресаДляРегламентнойОтчетности.СоздатьНаборЗаписей();
    НаборРегл.Отбор.Период.Установить(ДатаИст);
    НаборРегл.Отбор.Контрагент.Установить(Контрагент);
    НаборРегл.Отбор.ВидАдреса.Установить(Вид);
    ЗаписьРегл = НаборРегл.Добавить();
    ЗаписьРегл.Контрагент = Контрагент;
    ЗаписьРегл.Период = ДатаИст;
    ЗаписьРегл.Представление = СтрокаАдрес;
    ЗаписьРегл.ВидАдреса = Вид;
    НаборРегл.Записать();

КонецПроцедуры

Процедура ЗаполнитьПротоколПоСтрокам(ТаблицаСтрок, Протокол)

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл

        Если СтрокаФайла.ВыборИзНескольких Тогда
            ДобавитьСтрокуПротокола(Протокол, СтрокаФайла, "ВыборИзНескольких");
        ИначеЕсли СтрокаФайла.ПодменаКлиента Тогда
            ДобавитьСтрокуПротокола(Протокол, СтрокаФайла, "ПодменаКлиента");
        ИначеЕсли СтрокаФайла.СпособСопоставления = "Имя+Отчество+ДР+Адрес"
            И СтрокаФайла.НРДidКарточкиДо <> СтрокаФайла.НРДid
            И ЗначениеЗаполнено(СтрокаФайла.НРДid) Тогда
            ДобавитьСтрокуПротокола(Протокол, СтрокаФайла, "ЗаменаНРДid");
        ИначеЕсли Не ЗначениеЗаполнено(СтрокаФайла.Контрагент) Тогда
            ДобавитьСтрокуПротокола(Протокол, СтрокаФайла, "НеНайден");
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокуПротокола(Протокол, СтрокаФайла, Категория)

    СтрокаПротокола = Протокол.Добавить();
    СтрокаПротокола.НомерСтрокиФайла = СтрокаФайла.НомерСтрокиФайла;
    СтрокаПротокола.Категория = Категория;
    СтрокаПротокола.ФИОФайла = СтрокаФайла.ФИО;
    СтрокаПротокола.ФИОКарточки = СтрокаФайла.ФИОКарточки;
    СтрокаПротокола.СпособСопоставления = СтрокаФайла.СпособСопоставления;
    СтрокаПротокола.НРДidФайла = СтрокаФайла.НРДid;
    СтрокаПротокола.НРДidКарточкиДо = СтрокаФайла.НРДidКарточкиДо;
    СтрокаПротокола.Комментарий = СтрокаФайла.КомментарийСопоставления;
    СтрокаПротокола.Контрагент = СтрокаФайла.Контрагент;

КонецПроцедуры

Функция ПодсчитатьИтоги(ТаблицаСтрок)

    Итоги = Новый Структура;
    Итоги.Вставить("Всего", ТаблицаСтрок.Количество());
    Итоги.Вставить("НайденоПоНРДid", 0);
    Итоги.Вставить("НайденоПоФИОиДР", 0);
    Итоги.Вставить("НайденоПоАдресу", 0);
    Итоги.Вставить("НайденоПоИНН", 0);
    Итоги.Вставить("ПодменаКлиента", 0);
    Итоги.Вставить("ВыборИзНескольких", 0);
    Итоги.Вставить("НеНайдено", 0);
    Итоги.Вставить("Создано", 0);

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл
        Если СтрокаФайла.СпособСопоставления = "НРДid" Тогда
            Итоги.НайденоПоНРДid = Итоги.НайденоПоНРДid + 1;
        ИначеЕсли СтрокаФайла.СпособСопоставления = "ФИО+ДР" Или СтрокаФайла.СпособСопоставления = "ФИО+ДР+ЛС" Тогда
            Итоги.НайденоПоФИОиДР = Итоги.НайденоПоФИОиДР + 1;
        ИначеЕсли СтрокаФайла.СпособСопоставления = "Имя+Отчество+ДР+Адрес" Тогда
            Итоги.НайденоПоАдресу = Итоги.НайденоПоАдресу + 1;
        ИначеЕсли СтрокаФайла.СпособСопоставления = "ИНН" Или СтрокаФайла.СпособСопоставления = "ОГРН" Тогда
            Итоги.НайденоПоИНН = Итоги.НайденоПоИНН + 1;
        ИначеЕсли СтрокаФайла.СпособСопоставления = "Создан" Тогда
            Итоги.Создано = Итоги.Создано + 1;
        ИначеЕсли Не ЗначениеЗаполнено(СтрокаФайла.Контрагент) Тогда
            Итоги.НеНайдено = Итоги.НеНайдено + 1;
        КонецЕсли;
        Если СтрокаФайла.ПодменаКлиента Тогда
            Итоги.ПодменаКлиента = Итоги.ПодменаКлиента + 1;
        КонецЕсли;
        Если СтрокаФайла.ВыборИзНескольких Тогда
            Итоги.ВыборИзНескольких = Итоги.ВыборИзНескольких + 1;
        КонецЕсли;
    КонецЦикла;

    Возврат Итоги;

КонецФункции

Функция СформироватьТекстИтогов(Итоги)

    Возврат "Всего строк: " + Итоги.Всего
        + Символы.ПС + "По НРД id: " + Итоги.НайденоПоНРДid
        + Символы.ПС + "По ФИО и дате рождения: " + Итоги.НайденоПоФИОиДР
        + Символы.ПС + "По имени, отчеству, ДР и адресу: " + Итоги.НайденоПоАдресу
        + Символы.ПС + "По ИНН/ОГРН: " + Итоги.НайденоПоИНН
        + Символы.ПС + "Подмена клиента: " + Итоги.ПодменаКлиента
        + Символы.ПС + "Выбор из нескольких: " + Итоги.ВыборИзНескольких
        + Символы.ПС + "Не найдено: " + Итоги.НеНайдено
        + Символы.ПС + "Создано: " + Итоги.Создано;

КонецФункции

#КонецОбласти
