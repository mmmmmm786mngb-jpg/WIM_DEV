// Описание: Выделяет первое слово из строки и возвращает остаток через тот же параметр.
// Исправлена ошибка старой обработки: позиция пробела и остаток считаются по одной и той же обрезанной строке.
//
// Параметры:
// ИсходнаяСтрока - Строка - разбор ФИО; после вызова содержит остаток без первого слова
//
// Возвращаемое значение:
// Строка - первое слово без крайних пробелов
//
// Пример:
// Остаток = "  Иван   Петрович"; Слово = ВыделитьСлово(Остаток); // Слово = "Иван"
//
Функция ВыделитьСлово(ИсходнаяСтрока) Экспорт

    ИсходнаяСтрока = СокрЛ(Строка(ИсходнаяСтрока));
    ПозицияПробела = СтрНайти(ИсходнаяСтрока, " ");

    Если ПозицияПробела = 0 Тогда
        Результат = СокрЛП(ИсходнаяСтрока);
        ИсходнаяСтрока = "";
        Возврат Результат;
    КонецЕсли;

    Результат = СокрЛП(Лев(ИсходнаяСтрока, ПозицияПробела - 1));
    ИсходнаяСтрока = СокрЛ(Сред(ИсходнаяСтрока, ПозицияПробела + 1));

    Возврат Результат;

КонецФункции

// Описание: Разбирает строку ФИО на фамилию, имя, отчество с нормализацией пробелов.
//
// Параметры:
// ФИО - Строка - полное ФИО из файла
//
// Возвращаемое значение:
// Структура - Фамилия, Имя, Отчество, НормализованноеФИО
//
Функция РазобратьФИО(Знач ФИО) Экспорт

    Остаток = СокрЛП(Строка(ФИО));
    Фамилия = ВыделитьСлово(Остаток);
    Имя = ВыделитьСлово(Остаток);
    Отчество = СокрЛП(Остаток);

    Результат = Новый Структура;
    Результат.Вставить("Фамилия", Фамилия);
    Результат.Вставить("Имя", Имя);
    Результат.Вставить("Отчество", Отчество);
    Результат.Вставить("НормализованноеФИО", СокрЛП(Фамилия + " " + Имя + " " + Отчество));

    Возврат Результат;

КонецФункции

// Описание: Приводит адрес к виду для сравнения: нижний регистр, без лишних пробелов вокруг запятых.
//
// Параметры:
// Адрес - Строка - представление адреса из файла или карточки
//
// Возвращаемое значение:
// Строка - нормализованный адрес
//
Функция НормализоватьАдресДляПоиска(Знач Адрес) Экспорт

    Результат = НРег(СокрЛП(Строка(Адрес)));
    Результат = СтрЗаменить(Результат, Символы.НПП, " ");
    Результат = СтрЗаменить(Результат, Символы.ПС, " ");
    Результат = СтрЗаменить(Результат, Символы.ВК, " ");
    Результат = СтрЗаменить(Результат, Символы.Таб, " ");
    Результат = СтрЗаменить(Результат, ", ", ",");
    Результат = СтрЗаменить(Результат, " ,", ",");

    Пока СтрНайти(Результат, "  ") > 0 Цикл
        Результат = СтрЗаменить(Результат, "  ", " ");
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Описание: Находит или создает вид характеристики "НРД id клиента" в плане видов характеристик СвойстваОбъектов.
//
// Возвращаемое значение:
// ПланВидовХарактеристикСсылка.СвойстваОбъектов - свойство для записи идентификатора НРД
//
Функция ОбеспечитьСвойствоНРДid() Экспорт

    Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("НРД id клиента", Истина);
    Если ЗначениеЗаполнено(Свойство) Тогда
        Возврат Свойство;
    КонецЕсли;

    ОбъектСвойства = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
    ОбъектСвойства.Наименование = "НРД id клиента";
    ОбъектСвойства.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50));
    ОбъектСвойства.ОбменДанными.Загрузка = Истина;
    ОбъектСвойства.Записать();

    Возврат ОбъектСвойства.Ссылка;

КонецФункции

// Описание: Читает файл начитки (Excel или XML) в таблицу строк без обращения к Excel COM, если платформа читает файл сама.
//
// Параметры:
// ПутьКФайлу - Строка - полный путь к файлу на сервере
// ПараметрыНачитки - Структура - формат файла и лицевой счет для фильтра XML ВТБ СД
//
// Возвращаемое значение:
// ТаблицаЗначений - строки файла
//
Функция ПрочитатьФайлВТаблицу(Знач ПутьКФайлу, Знач ПараметрыНачитки) Экспорт

    ФорматФайла = Число(ЗначениеПараметра(ПараметрыНачитки, "ФорматФайла", 0));
    ТаблицаСтрок = СоздатьТаблицуСтрокФайла();

    Если ФорматФайла = 1 Тогда
        ПрочитатьФайлXMLВТБСД(ПутьКФайлу, ТаблицаСтрок, ПараметрыНачитки);
        Возврат ТаблицаСтрок;
    КонецЕсли;

    ТабДок = ПрочитатьТабличныйДокумент(ПутьКФайлу);
    ПрочитатьТабличныйДокументВСтроки(ТабДок, ТаблицаСтрок, ФорматФайла);

    Возврат ТаблицаСтрок;

КонецФункции

// Описание: Сопоставляет строки файла с карточками: шаг 1 НРД id, шаг 2 ФИО+ДР, шаг 2а имя+отчество+ДР+адрес.
// Анкету найденной карточки не меняет. На шаге 2а записывает новый НРД id.
//
// Параметры:
// ТаблицаСтрок - ТаблицаЗначений - строки файла, колонки заполняются результатами
// ПараметрыНачитки - Структура - фонд, флаги, даты
//
// Возвращаемое значение:
// Структура - ТаблицаСтрок, Протокол, Итоги, ТекстИтогов
//
Функция СопоставитьСтрокиФайла(ТаблицаСтрок, Знач ПараметрыНачитки) Экспорт

    ОбеспечитьКолонкиСтрок(ТаблицаСтрок);
    ПодготовитьФИОСтрок(ТаблицаСтрок);

    СвойствоНРДid = ОбеспечитьСвойствоНРДid();
    Протокол = СоздатьТаблицуПротокола();

    ЗаполнитьСопоставлениеПоНРДid(ТаблицаСтрок, СвойствоНРДid);
    ЗаполнитьСопоставлениеЮрлиц(ТаблицаСтрок);
    ЗаполнитьСопоставлениеПоФИОиДР(ТаблицаСтрок, ПараметрыНачитки, СвойствоНРДid);
    ЗаполнитьСопоставлениеПоИмениОтчествуАдресу(ТаблицаСтрок, ПараметрыНачитки, СвойствоНРДid);
    ЗаполнитьЛицевыеИБанковскиеСчета(ТаблицаСтрок, ПараметрыНачитки);
    ЗаполнитьПротоколПоСтрокам(ТаблицаСтрок, Протокол);

    Итоги = ПодсчитатьИтоги(ТаблицаСтрок);
    Результат = Новый Структура;
    Результат.Вставить("ТаблицаСтрок", ТаблицаСтрок);
    Результат.Вставить("Протокол", Протокол);
    Результат.Вставить("Итоги", Итоги);
    Результат.Вставить("ТекстИтогов", СформироватьТекстИтогов(Итоги));

    Возврат Результат;

КонецФункции

// Описание: Создает недостающих контрагентов, технические лицевые счета и банковские счета по флагам параметров.
//
// Параметры:
// ТаблицаСтрок - ТаблицаЗначений - строки после сопоставления
// ПараметрыНачитки - Структура - флаги создания и реквизиты шапки
//
// Возвращаемое значение:
// Структура - ТаблицаСтрок и количество созданных объектов
//
Функция СоздатьНедостающихПоСтрокам(ТаблицаСтрок, Знач ПараметрыНачитки) Экспорт

    СозданоКонтрагентов = 0;
    СозданоЛицевыхСчетов = 0;
    СозданоБанковскихСчетов = 0;

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл

        Если Не ЗначениеЗаполнено(СтрокаФайла.Контрагент)
            И ЗначениеПараметра(ПараметрыНачитки, "ФлСоздаватьКонтрагентов", Ложь)
            И Не СтрокаФайла.ВыборИзНескольких Тогда

            СтрокаФайла.Контрагент = СоздатьКонтрагентаПоСтроке(СтрокаФайла, ПараметрыНачитки);
            Если ЗначениеЗаполнено(СтрокаФайла.Контрагент) Тогда
                СтрокаФайла.НовыйКонтрагент = Истина;
                СтрокаФайла.СпособСопоставления = "Создан";
                СтрокаФайла.ФИОКарточки = СтрокаФайла.ФИО;
                СтрокаФайла.КомментарийСопоставления = "Создана новая карточка";
                СозданоКонтрагентов = СозданоКонтрагентов + 1;
            КонецЕсли;

        КонецЕсли;

        Если ЗначениеЗаполнено(СтрокаФайла.Контрагент)
            И Не ЗначениеЗаполнено(СтрокаФайла.ЛицевойСчет)
            И ЗначениеПараметра(ПараметрыНачитки, "ФлСоздаватьЛицевыеСчета", Ложь) Тогда

            СтрокаФайла.ЛицевойСчет = НайтиИлиСоздатьЛицевойСчет(
                СтрокаФайла.Контрагент,
                ПараметрыНачитки,
                Неопределено,
                СчетаДляИсключенияПриРазмножении(ТаблицаСтрок, СтрокаФайла, ПараметрыНачитки));
            Если ЗначениеЗаполнено(СтрокаФайла.ЛицевойСчет) Тогда
                СозданоЛицевыхСчетов = СозданоЛицевыхСчетов + 1;
            КонецЕсли;

        КонецЕсли;

        Если ЗначениеЗаполнено(СтрокаФайла.Контрагент)
            И Не ЗначениеЗаполнено(СтрокаФайла.БанковскийСчет)
            И ЗначениеЗаполнено(СтрокаФайла.РасчетныйСчет) Тогда

            СтрокаФайла.БанковскийСчет = НайтиИлиСоздатьБанковскийСчет(СтрокаФайла);
            Если ЗначениеЗаполнено(СтрокаФайла.БанковскийСчет) Тогда
                СозданоБанковскихСчетов = СозданоБанковскихСчетов + 1;
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("ТаблицаСтрок", ТаблицаСтрок);
    Результат.Вставить("СозданоКонтрагентов", СозданоКонтрагентов);
    Результат.Вставить("СозданоЛицевыхСчетов", СозданоЛицевыхСчетов);
    Результат.Вставить("СозданоБанковскихСчетов", СозданоБанковскихСчетов);

    Возврат Результат;

КонецФункции

// Описание: Записывает документ СписокВладельцевНоминальногоДержателя по сопоставленным строкам.
//
// Параметры:
// ТаблицаСтрок - ТаблицаЗначений - строки с заполненными контрагентом, ЛС, паями
// ПараметрыНачитки - Структура - шапка документа
//
// Возвращаемое значение:
// Структура - Ссылка, ПропущеноСтрок, ЗаписаноСтрок
//
Функция СоздатьДокументСписокВладельцев(ТаблицаСтрок, Знач ПараметрыНачитки) Экспорт

    НовыйДокумент = Документы.СписокВладельцевНоминальногоДержателя.СоздатьДокумент();
    НовыйДокумент.Дата = ЗначениеПараметра(ПараметрыНачитки, "ДатаДок", ТекущаяДатаСеанса());
    НовыйДокумент.ПИФ = ЗначениеПараметра(ПараметрыНачитки, "Фонд", Справочники.ПИФ.ПустаяСсылка());
    НовыйДокумент.НоминальныйДержатель = ЗначениеПараметра(ПараметрыНачитки, "НоминальныйДержатель", Справочники.Контрагенты.ПустаяСсылка());
    НовыйДокумент.ЛицевойСчет = ЗначениеПараметра(ПараметрыНачитки, "ЛицевойСчет", Справочники.ЛицевыеСчетаПайщиков.ПустаяСсылка());
    НовыйДокумент.Комментарий = "Заполнение списка владельцев НД (тонкий клиент)";

    ПропущеноСтрок = 0;
    ЗаписаноСтрок = 0;

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл

        Если Не ЗначениеЗаполнено(СтрокаФайла.Контрагент)
            Или Не ЗначениеЗаполнено(СтрокаФайла.КоличествоПаев)
            Или Не ЗначениеЗаполнено(СтрокаФайла.ЛицевойСчет) Тогда
            ПропущеноСтрок = ПропущеноСтрок + 1;
            Продолжить;
        КонецЕсли;

        СтрокаДокумента = НовыйДокумент.Владельцы.Добавить();
        СтрокаДокумента.Контрагент = СтрокаФайла.Контрагент;
        СтрокаДокумента.КоличествоПаев = СтрокаФайла.КоличествоПаев;
        СтрокаДокумента.ЛицевойСчет = СтрокаФайла.ЛицевойСчет;
        СтрокаДокумента.БанковскийСчет = СтрокаФайла.БанковскийСчет;
        СтрокаДокумента.НРДid = СтрокаФайла.НРДid;
        ЗаписаноСтрок = ЗаписаноСтрок + 1;

    КонецЦикла;

    НовыйДокумент.ОбменДанными.Загрузка = Истина;
    НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);

    Результат = Новый Структура;
    Результат.Вставить("Ссылка", НовыйДокумент.Ссылка);
    Результат.Вставить("ПропущеноСтрок", ПропущеноСтрок);
    Результат.Вставить("ЗаписаноСтрок", ЗаписаноСтрок);

    Возврат Результат;

КонецФункции

// Описание: Ищет лицевой счет номинального держателя в выбранном фонде.
//
// Параметры:
// Фонд - СправочникСсылка.ПИФ - фонд
// НоминальныйДержатель - СправочникСсылка.Контрагенты - номинальный держатель
//
// Возвращаемое значение:
// СправочникСсылка.ЛицевыеСчетаПайщиков - найденный счет или пустая ссылка
//
Функция НайтиЛицевойСчетНоминальногоДержателя(Знач Фонд, Знач НоминальныйДержатель) Экспорт

    Если Не ЗначениеЗаполнено(Фонд) Или Не ЗначениеЗаполнено(НоминальныйДержатель) Тогда
        Возврат Справочники.ЛицевыеСчетаПайщиков.ПустаяСсылка();
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ЛицевыеСчетаПайщиков.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.ЛицевыеСчетаПайщиков КАК ЛицевыеСчетаПайщиков
    |ГДЕ
    |    ЛицевыеСчетаПайщиков.Владелец = &Фонд
    |    И ЛицевыеСчетаПайщиков.Пайщик = &Владелец
    |    И НЕ ЛицевыеСчетаПайщиков.ПометкаУдаления";
    Запрос.УстановитьПараметр("Фонд", Фонд);
    Запрос.УстановитьПараметр("Владелец", НоминальныйДержатель);

    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Возврат Справочники.ЛицевыеСчетаПайщиков.ПустаяСсылка();

КонецФункции

// Описание: Полный цикл начитки из файла: чтение, сопоставление, опциональное создание и документ.
//
// Параметры:
// ПутьКФайлу - Строка - путь к файлу на сервере
// ПараметрыНачитки - Структура - параметры начитки
// СоздаватьДокумент - Булево - записывать документ списка владельцев
//
// Возвращаемое значение:
// Структура - результат сопоставления и ссылка на документ
//
Функция ВыполнитьНачиткуИзФайла(Знач ПутьКФайлу, Знач ПараметрыНачитки, Знач СоздаватьДокумент = Ложь) Экспорт

    ТаблицаСтрок = ПрочитатьФайлВТаблицу(ПутьКФайлу, ПараметрыНачитки);
    Результат = СопоставитьСтрокиФайла(ТаблицаСтрок, ПараметрыНачитки);

    Если ЗначениеПараметра(ПараметрыНачитки, "ФлСоздаватьКонтрагентов", Ложь)
        Или ЗначениеПараметра(ПараметрыНачитки, "ФлСоздаватьЛицевыеСчета", Ложь) Тогда
        РезультатСоздания = СоздатьНедостающихПоСтрокам(Результат.ТаблицаСтрок, ПараметрыНачитки);
        Результат.ТаблицаСтрок = РезультатСоздания.ТаблицаСтрок;
        Результат.Вставить("СозданоКонтрагентов", РезультатСоздания.СозданоКонтрагентов);
        Результат.Вставить("СозданоЛицевыхСчетов", РезультатСоздания.СозданоЛицевыхСчетов);
    КонецЕсли;

    Если СоздаватьДокумент Тогда
        РезультатДокумента = СоздатьДокументСписокВладельцев(Результат.ТаблицаСтрок, ПараметрыНачитки);
        Результат.Вставить("Документ", РезультатДокумента.Ссылка);
        Результат.Вставить("ЗаписаноСтрокДокумента", РезультатДокумента.ЗаписаноСтрок);
    КонецЕсли;

    Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДатаИсторическихЗначенийПоУмолчанию()

    ДатаКонцаПредыдущегоМесяца = КонецМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));

    Попытка
        Возврат КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, НачалоМесяца(ТекущаяДатаСеанса()), -1) + 64800;
    Исключение
        Возврат ДатаКонцаПредыдущегоМесяца;
    КонецПопытки;

КонецФункции

Функция ЗначениеПараметра(ПараметрыНачитки, ИмяКлюча, ЗначениеПоУмолчанию)

    Если ТипЗнч(ПараметрыНачитки) <> Тип("Структура") Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;

    Если ПараметрыНачитки.Свойство(ИмяКлюча) Тогда
        Возврат ПараметрыНачитки[ИмяКлюча];
    КонецЕсли;

    Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция СоздатьТаблицуПротокола()

    Протокол = Новый ТаблицаЗначений;
    Протокол.Колонки.Добавить("НомерСтрокиФайла", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
    Протокол.Колонки.Добавить("Категория", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(80)));
    Протокол.Колонки.Добавить("ФИОФайла", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
    Протокол.Колонки.Добавить("ФИОКарточки", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
    Протокол.Колонки.Добавить("СпособСопоставления", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
    Протокол.Колонки.Добавить("НРДidФайла", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
    Протокол.Колонки.Добавить("НРДidКарточкиДо", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
    Протокол.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0)));
    Протокол.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));

    Возврат Протокол;

КонецФункции

Процедура ОбеспечитьКолонкиСтрок(ТаблицаСтрок)

    Эталон = СоздатьТаблицуСтрокФайла();
    Для Каждого Колонка Из Эталон.Колонки Цикл
        Если ТаблицаСтрок.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
            ТаблицаСтрок.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Процедура ПодготовитьФИОСтрок(ТаблицаСтрок)

    Для Каждого СтрокаФайла Из ТаблицаСтрок Цикл

        Если Не ЗначениеЗаполнено(СтрокаФайла.Фамилия) И ЗначениеЗаполнено(СтрокаФайла.ФИО) Тогда
            ЧастиФИО = РазобратьФИО(СтрокаФайла.ФИО);
            СтрокаФайла.Фамилия = ЧастиФИО.Фамилия;
            СтрокаФайла.Имя = ЧастиФИО.Имя;
            СтрокаФайла.Отчество = ЧастиФИО.Отчество;
            СтрокаФайла.ФИО = ЧастиФИО.НормализованноеФИО;
        КонецЕсли;

        Если Не ЗначениеЗаполнено(СтрокаФайла.СпособСопоставления) Тогда
            СтрокаФайла.СпособСопоставления = "";
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

Функция ПрочитатьТабличныйДокумент(ПутьКФайлу)

    ТабДок = Новый ТабличныйДокумент;

    Попытка
        ТабДок.Прочитать(ПутьКФайлу);
        Возврат ТабДок;
    Исключение
        ВызватьИсключение "Не удалось прочитать файл табличным документом: " + ОписаниеОшибки();
    КонецПопытки;

КонецФункции

Процедура ПрочитатьТабличныйДокументВСтроки(ТабДок, ТаблицаСтрок, ФорматФайла)

    Если ФорматФайла = 2 Тогда
        НачСтрока = 2;
        Карта = КартаКолонокЦДФ();
    ИначеЕсли ФорматФайла = 3 Тогда
        НачСтрока = 3;
        Карта = КартаКолонокГарантNew();
    Иначе
        НачСтрока = 3;
        Карта = КартаКолонокГарант();
    КонецЕсли;

    ВысотаТаблицы = ТабДок.ВысотаТаблицы;
    Для НомерСтроки = НачСтрока По ВысотаТаблицы Цикл

        ФИО = СокрЛП(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ФИО));
        Если Не ЗначениеЗаполнено(ФИО) Тогда
            Продолжить;
        КонецЕсли;

        СтрокаФайла = ТаблицаСтрок.Добавить();
        СтрокаФайла.НомерСтрокиФайла = НомерСтроки;
        ЧастиФИО = РазобратьФИО(ФИО);
        СтрокаФайла.ФИО = ЧастиФИО.НормализованноеФИО;
        СтрокаФайла.Фамилия = ЧастиФИО.Фамилия;
        СтрокаФайла.Имя = ЧастиФИО.Имя;
        СтрокаФайла.Отчество = ЧастиФИО.Отчество;
        СтрокаФайла.ЮрАдрес = СокрЛП(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ЮрАдрес));
        СтрокаФайла.ПочтовыйАдрес = СокрЛП(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ПочтовыйАдрес));
        СтрокаФайла.КоличествоПаев = ПривестиКЧислу(ТекстЯчейки(ТабДок, НомерСтроки, Карта.КоличествоПаев));
        СтрокаФайла.БИК = СокрЛП(ТекстЯчейки(ТабДок, НомерСтроки, Карта.БИК));
        СтрокаФайла.РасчетныйСчет = СокрЛП(ТекстЯчейки(ТабДок, НомерСтроки, Карта.РасчетныйСчет));
        СтрокаФайла.ДокументНомер = СокрЛП(СтрЗаменить(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ДокументНомер), " ", ""));
        СтрокаФайла.ДокументСерия = СокрЛП(СтрЗаменить(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ДокументСерия), " ", ""));
        СтрокаФайла.ДокументКемВыдан = СокрЛП(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ДокументКемВыдан));
        СтрокаФайла.ДокументДатаВыдачи = ПривестиКДате(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ДокументДатаВыдачи));
        СтрокаФайла.НРДid = СокрЛП(ТекстЯчейки(ТабДок, НомерСтроки, Карта.НРДid));
        СтрокаФайла.ИНН = СокрЛП(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ИНН));

        Если Карта.Свойство("ДатаРождения") Тогда
            СтрокаФайла.ДатаРождения = ПривестиКДате(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ДатаРождения));
        КонецЕсли;

        Если Не ЗначениеЗаполнено(СтрокаФайла.ДатаРождения) Тогда
            СтрокаФайла.ДатаРождения = ИзвлечьДатуРожденияИзТекста(ТекстЯчейки(ТабДок, НомерСтроки, Карта.ДанныеРегистрации));
        КонецЕсли;

        Если ЗначениеЗаполнено(СтрокаФайла.ОГРН) Или СтрДлина(СтрокаФайла.ИНН) = 10 Тогда
            СтрокаФайла.ЭтоЮрЛицо = Истина;
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

Функция КартаКолонокГарант()

    Карта = Новый Структура;
    Карта.Вставить("ЮрАдрес", 5);
    Карта.Вставить("ФИО", 6);
    Карта.Вставить("КоличествоПаев", 7);
    Карта.Вставить("ПочтовыйАдрес", 8);
    Карта.Вставить("ДанныеРегистрации", 9);
    Карта.Вставить("БИК", 11);
    Карта.Вставить("РасчетныйСчет", 13);
    Карта.Вставить("ДокументКемВыдан", 14);
    Карта.Вставить("ДокументНомер", 16);
    Карта.Вставить("ДокументСерия", 17);
    Карта.Вставить("ДокументДатаВыдачи", 18);
    Карта.Вставить("НРДid", 19);
    Карта.Вставить("ИНН", 0);
    Карта.Вставить("ДатаРождения", 0);

    Возврат Карта;

КонецФункции

Функция КартаКолонокГарантNew()

    Карта = Новый Структура;
    Карта.Вставить("ФИО", 1);
    Карта.Вставить("ЮрАдрес", 6);
    Карта.Вставить("ПочтовыйАдрес", 6);
