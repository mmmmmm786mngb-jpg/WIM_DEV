#Область ОписаниеПеременных

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Описание: Ищет изменения значения указанного реквизита в версиях объектов
//   (РегистрСведений.ВерсииОбъектов) за заданный период. Для каждой версии,
//   попавшей в период, определяет предыдущую версию и сравнивает значение реквизита.
//   В результат попадают только строки, где значение реквизита изменилось.
//
// Параметры:
//   ПолноеИмяОбъекта - Строка - полное имя типа версионируемого объекта,
//       например "Справочник.Контрагенты". Пустая строка — без фильтра по типу.
//   ИмяРеквизита     - Строка - имя реквизита или дополнительного реквизита,
//       значение которого отслеживается, например "КДУ_ИД".
//   ДатаНачала       - Дата   - начало периода поиска (по ДатаВерсии).
//   ДатаОкончания    - Дата   - конец периода поиска (по ДатаВерсии), включительно.
//   Автор            - СправочникСсылка.Пользователи, Неопределено - автор версии
//       для фильтра. Неопределено — без фильтра по автору.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки:
//       Объект                  - ЛюбаяСсылка - ссылка на версионируемый объект;
//       ПредставлениеОбъекта     - Строка;
//       НомерВерсии             - Число - номер версии с изменением;
//       НомерПредыдущейВерсии    - Число - номер предыдущей версии (эталон);
//       ДатаВерсии              - Дата;
//       Автор                   - Строка;
//       ЗначениеНовое           - Строка - представление значения в версии НомерВерсии;
//       ЗначениеСтарое          - Строка - представление значения в предыдущей версии;
//       Восстанавливать         - Булево - признак выбора для восстановления.
//
Функция НайтиИзмененияРеквизита(Знач ПолноеИмяОбъекта, Знач ИмяРеквизита, Знач ДатаНачала, Знач ДатаОкончания, Знач Автор = Неопределено) Экспорт

	Результат = НоваяТаблицаРезультата();

	// Убираем случайные пробелы по краям ввода.
	ПолноеИмяОбъекта = СокрЛП(ПолноеИмяОбъекта);
	ИмяРеквизита = СокрЛП(ИмяРеквизита);

	Если Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ВызватьИсключение "Не указано имя реквизита для поиска изменений.";
	КонецЕсли;

	МетаданныеОбъектаФильтра = Неопределено;
	Если ЗначениеЗаполнено(ПолноеИмяОбъекта) Тогда
		МетаданныеОбъектаФильтра = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
		Если МетаданныеОбъектаФильтра = Неопределено Тогда
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				"Объект метаданных ""%1"" не найден. Укажите имя в формате ""Справочник.Контрагенты"" (вид в единственном числе, имя - как в конфигураторе).",
				ПолноеИмяОбъекта);
		КонецЕсли;
	КонецЕсли;

	ВерсииВПериоде = ВерсииЗаПериод(ПолноеИмяОбъекта, ДатаНачала, ДатаОкончания, Автор);

	Для Каждого СтрокаВерсии Из ВерсииВПериоде Цикл

		МетаданныеОбъекта = ?(МетаданныеОбъектаФильтра <> Неопределено,
			МетаданныеОбъектаФильтра, СтрокаВерсии.Объект.Метаданные());
		ВнутреннееИмяРеквизита = РазрешитьИмяРеквизита(МетаданныеОбъекта, ИмяРеквизита);

		НомерПредыдущейВерсии = НомерПредыдущейВерсииОбъекта(
			СтрокаВерсии.Объект, СтрокаВерсии.НомерВерсии);

		// Если предыдущей пользовательской версии нет — сравнивать и восстанавливать не из чего.
		Если НомерПредыдущейВерсии <= 0 Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеНовое = ЗначениеРеквизитаИзВерсии(
			СтрокаВерсии.Объект, СтрокаВерсии.НомерВерсии, ИмяРеквизита, ВнутреннееИмяРеквизита);
		ЗначениеСтарое = ЗначениеРеквизитаИзВерсии(
			СтрокаВерсии.Объект, НомерПредыдущейВерсии, ИмяРеквизита, ВнутреннееИмяРеквизита);

		// Реквизит отсутствует в обеих версиях — изменение не относится к нему.
		Если Не ЗначениеНовое.Найдено И Не ЗначениеСтарое.Найдено Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеНовое.Представление = ЗначениеСтарое.Представление Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Объект = СтрокаВерсии.Объект;
		НоваяСтрока.ПредставлениеОбъекта = Строка(СтрокаВерсии.Объект);
		НоваяСтрока.НомерВерсии = СтрокаВерсии.НомерВерсии;
		НоваяСтрока.НомерПредыдущейВерсии = НомерПредыдущейВерсии;
		НоваяСтрока.ДатаВерсии = СтрокаВерсии.ДатаВерсии;
		НоваяСтрока.Автор = Строка(СтрокаВерсии.АвторВерсии);
		НоваяСтрока.ЗначениеНовое = ЗначениеНовое.Представление;
		НоваяСтрока.ЗначениеСтарое = ЗначениеСтарое.Представление;
		НоваяСтрока.Восстанавливать = Ложь;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Описание: Восстанавливает значение реквизита из предыдущей версии для переданных объектов.
//   Значение берётся не из таблицы формы, а заново считывается из предыдущей версии объекта
//   (типизированное значение), после чего записывается в объект базы.
//   Поддерживаются обычные реквизиты и дополнительные реквизиты (ПВХ ДополнительныеРеквизитыИСведения).
//
// Параметры:
//   ТаблицаКВосстановлению - ТаблицаЗначений - строки результата НайтиИзмененияРеквизита
//       (нужны колонки Объект, НомерПредыдущейВерсии).
//   ИмяРеквизита           - Строка - имя восстанавливаемого реквизита.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки:
//       Объект          - ЛюбаяСсылка;
//       ПредставлениеОбъекта - Строка;
//       Успешно         - Булево;
//       ВосстановленноеЗначение - Строка - представление записанного значения;
//       Сообщение       - Строка - текст ошибки или результата.
//
Функция ВосстановитьЗначения(Знач ТаблицаКВосстановлению, Знач ИмяРеквизита) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Объект");
	Результат.Колонки.Добавить("ПредставлениеОбъекта", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Успешно", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ВосстановленноеЗначение", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Сообщение", Новый ОписаниеТипов("Строка"));

	ИмяРеквизита = СокрЛП(ИмяРеквизита);

	Для Каждого СтрокаВосстановления Из ТаблицаКВосстановлению Цикл

		СтрокаОтчета = Результат.Добавить();
		СтрокаОтчета.Объект = СтрокаВосстановления.Объект;
		СтрокаОтчета.ПредставлениеОбъекта = Строка(СтрокаВосстановления.Объект);

		Попытка

			ВнутреннееИмяРеквизита = РазрешитьИмяРеквизита(СтрокаВосстановления.Объект.Метаданные(), ИмяРеквизита);

			ЭталонноеЗначение = ЗначениеРеквизитаИзВерсии(
				СтрокаВосстановления.Объект, СтрокаВосстановления.НомерПредыдущейВерсии,
				ИмяРеквизита, ВнутреннееИмяРеквизита);

			Если Не ЭталонноеЗначение.Найдено Тогда
				СтрокаОтчета.Успешно = Ложь;
				СтрокаОтчета.Сообщение = "В предыдущей версии реквизит не найден.";
				Продолжить;
			КонецЕсли;

			ЗаписатьЗначениеРеквизита(СтрокаВосстановления.Объект, ВнутреннееИмяРеквизита, ЭталонноеЗначение.Значение);

			СтрокаОтчета.Успешно = Истина;
			СтрокаОтчета.ВосстановленноеЗначение = ЭталонноеЗначение.Представление;
			СтрокаОтчета.Сообщение = "Значение восстановлено.";

		Исключение
			СтрокаОтчета.Успешно = Ложь;
			СтрокаОтчета.Сообщение = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(
				"Восстановление реквизита по версиям",
				УровеньЖурналаРегистрации.Ошибка,
				СтрокаВосстановления.Объект.Метаданные(),
				СтрокаВосстановления.Объект,
				ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Возвращает пустую таблицу результата поиска с типизированными колонками.
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. НайтиИзмененияРеквизита.
//
Функция НоваяТаблицаРезультата()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Объект");
	Таблица.Колонки.Добавить("ПредставлениеОбъекта", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("НомерВерсии", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("НомерПредыдущейВерсии", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ДатаВерсии", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Автор", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеНовое", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеСтарое", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Восстанавливать", Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

// Описание: Возвращает версии объектов за период по регистру ВерсииОбъектов.
//   Учитываются только версии типа "Изменено пользователем".
//
// Параметры:
//   ПолноеИмяОбъекта - Строка - полное имя типа или пустая строка.
//   ДатаНачала       - Дата.
//   ДатаОкончания    - Дата.
//   Автор            - СправочникСсылка.Пользователи, Неопределено.
//
// Возвращаемое значение:
//   РезультатЗапроса.Выгрузить() - таблица с колонками Объект, НомерВерсии, ДатаВерсии, АвторВерсии.
//
Функция ВерсииЗаПериод(Знач ПолноеИмяОбъекта, Знач ДатаНачала, Знач ДатаОкончания, Знач Автор)

	УстановитьПривилегированныйРежим(Истина);

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВерсииОбъектов.Объект КАК Объект,
	|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии,
	|	ВерсииОбъектов.ДатаВерсии КАК ДатаВерсии,
	|	ВерсииОбъектов.АвторВерсии КАК АвторВерсии
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.ДатаВерсии МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ВерсииОбъектов.ТипВерсииОбъекта = ЗНАЧЕНИЕ(Перечисление.ТипыВерсийОбъекта.ИзмененоПользователем)
	|	&УсловиеТип
	|	&УсловиеАвтор
	|УПОРЯДОЧИТЬ ПО
	|	Объект,
	|	НомерВерсии";

	УсловиеТип = ?(ЗначениеЗаполнено(ПолноеИмяОбъекта),
		"И ВерсииОбъектов.Объект ССЫЛКА " + ПолноеИмяОбъекта, "");
	УсловиеАвтор = ?(ЗначениеЗаполнено(Автор),
		"И ВерсииОбъектов.АвторВерсии = &Автор", "");

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеТип", УсловиеТип);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеАвтор", УсловиеАвтор);

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Если ЗначениеЗаполнено(Автор) Тогда
		Запрос.УстановитьПараметр("Автор", Автор);
	КонецЕсли;

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Описание: Возвращает номер предыдущей версии объекта, измененной пользователем.
//   Локальная копия логики из ВерсионированиеОбъектов.НомерПредыдущейВерсии —
//   в конфигурации ДО метод не экспортирован и недоступен из внешней обработки.
//
// Параметры:
//   Ссылка             - ЛюбаяСсылка - объект.
//   ТекущийНомерВерсии - Число       - номер версии, для которой ищется предыдущая.
//
// Возвращаемое значение:
//   Число - номер предыдущей версии; 0 или -1, если предыдущей версии нет.
//
Функция НомерПредыдущейВерсииОбъекта(Знач Ссылка, Знач ТекущийНомерВерсии)

	Если Ссылка.Пустая() Тогда
		Возврат 0;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВерсииОбъектов.НомерВерсии), -1) КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект = &Ссылка
	|	И ВерсииОбъектов.ТипВерсииОбъекта = ЗНАЧЕНИЕ(Перечисление.ТипыВерсийОбъекта.ИзмененоПользователем)
	|	И ВерсииОбъектов.НомерВерсии < &ТекущийНомерВерсии";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ТекущийНомерВерсии", ТекущийНомерВерсии);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.НомерВерсии;

КонецФункции

// Описание: Сопоставляет ввод пользователя с внутренним именем реквизита метаданных.
//   Поддерживает имя из конфигуратора и синоним (в т.ч. часть составного синонима
//   через запятую, например "ОГРН" -> "РегистрационныйНомер").
//
// Параметры:
//   МетаданныеОбъекта - ОбъектМетаданных - метаданные версионируемого объекта.
//   ИмяИлиСиноним     - Строка           - имя, синоним или часть синонима.
//
// Возвращаемое значение:
//   Строка - внутреннее имя реквизита или исходный ввод для дополнительных реквизитов.
//
Функция РазрешитьИмяРеквизита(Знач МетаданныеОбъекта, Знач ИмяИлиСиноним)

	ИмяИлиСиноним = СокрЛП(ИмяИлиСиноним);
	Если Не ЗначениеЗаполнено(ИмяИлиСиноним) Тогда
		Возврат "";
	КонецЕсли;

	Если МетаданныеОбъекта.Реквизиты.Найти(ИмяИлиСиноним) <> Неопределено Тогда
		Возврат ИмяИлиСиноним;
	КонецЕсли;

	Для Каждого ОписаниеРеквизита Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если ОписаниеРеквизита.Имя = ИмяИлиСиноним Тогда
			Возврат ИмяИлиСиноним;
		КонецЕсли;
	КонецЦикла;

	ИмяПоСинониму = НайтиИмяРеквизитаПоСинониму(МетаданныеОбъекта.Реквизиты, ИмяИлиСиноним);
	Если ЗначениеЗаполнено(ИмяПоСинониму) Тогда
		Возврат ИмяПоСинониму;
	КонецЕсли;

	ИмяПоСинониму = НайтиИмяРеквизитаПоСинониму(МетаданныеОбъекта.СтандартныеРеквизиты, ИмяИлиСиноним);
	Если ЗначениеЗаполнено(ИмяПоСинониму) Тогда
		Возврат ИмяПоСинониму;
	КонецЕсли;

	Возврат ИмяИлиСиноним;

КонецФункции

// Описание: Ищет реквизит по полному синониму или по одной из частей синонима (через запятую).
//
// Параметры:
//   КоллекцияРеквизитов - КоллекцияОбъектовМетаданных - реквизиты объекта.
//   ИмяИлиСиноним       - Строка - искомое имя или синоним.
//
// Возвращаемое значение:
//   Строка - внутреннее имя реквизита или пустая строка.
//
Функция НайтиИмяРеквизитаПоСинониму(Знач КоллекцияРеквизитов, Знач ИмяИлиСиноним)

	ВводНРег = ВРег(ИмяИлиСиноним);

	Для Каждого ОписаниеРеквизита Из КоллекцияРеквизитов Цикл

		Синоним = СокрЛП(ОписаниеРеквизита.Представление());
		Если Не ЗначениеЗаполнено(Синоним) Тогда
			Продолжить;
		КонецЕсли;

		Если ВРег(Синоним) = ВводНРег Тогда
			Возврат ОписаниеРеквизита.Имя;
		КонецЕсли;

		ЧастиСинонима = СтрРазделить(Синоним, ",", Ложь);
		Для Каждого ЧастьСинонима Из ЧастиСинонима Цикл
			Если ВРег(СокрЛП(ЧастьСинонима)) = ВводНРег Тогда
				Возврат ОписаниеРеквизита.Имя;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат "";

КонецФункции

// Описание: Проверяет, относится ли строка разобранной версии к искомому реквизиту.
//
// Параметры:
//   Ссылка                - ЛюбаяСсылка - объект.
//   ИмяВВерсии            - Строка      - имя реквизита в разборе версии.
//   ИмяИскомого           - Строка      - исходный ввод пользователя.
//   ВнутреннееИмяРеквизита - Строка     - разрешенное внутреннее имя.
//   ПредставлениеИскомого - Строка      - выводимое наименование из БСП.
//
// Возвращаемое значение:
//   Булево.
//
Функция РеквизитВерсииСовпадает(Знач Ссылка, Знач ИмяВВерсии, Знач ИмяИскомого,
	Знач ВнутреннееИмяРеквизита, Знач ПредставлениеИскомого)

	Если ИмяВВерсии = ВнутреннееИмяРеквизита
		Или ИмяВВерсии = ИмяИскомого
		Или ИмяВВерсии = ПредставлениеИскомого Тогда
		Возврат Истина;
	КонецЕсли;

	ОписаниеСтроки = ВерсионированиеОбъектов.НаименованиеВыводимогоРеквизита(Ссылка, ИмяВВерсии);
	ВыводимоеИмяСтроки = ОписаниеСтроки.ВыводимоеНаименование;

	Если ВыводимоеИмяСтроки = ИмяИскомого
		Или ВыводимоеИмяСтроки = ПредставлениеИскомого Тогда
		Возврат Истина;
	КонецЕсли;

	Если СинонимСовпадаетСВводом(ВыводимоеИмяСтроки, ИмяИскомого) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Описание: Сравнивает синоним реквизита с вводом пользователя (точно или по части до запятой).
//
// Параметры:
//   Синоним - Строка - синоним или составной синоним реквизита.
//   Ввод    - Строка - ввод пользователя.
//
// Возвращаемое значение:
//   Булево.
//
Функция СинонимСовпадаетСВводом(Знач Синоним, Знач Ввод)

	Синоним = СокрЛП(Синоним);
	Ввод = СокрЛП(Ввод);

	Если Не ЗначениеЗаполнено(Синоним) Или Не ЗначениеЗаполнено(Ввод) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВРег(Синоним) = ВРег(Ввод) Тогда
		Возврат Истина;
	КонецЕсли;

	ЧастиСинонима = СтрРазделить(Синоним, ",", Ложь);
	Для Каждого ЧастьСинонима Из ЧастиСинонима Цикл
		Если ВРег(СокрЛП(ЧастьСинонима)) = ВРег(Ввод) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Описание: Извлекает значение реквизита из конкретной версии объекта.
//   Поддерживает как обычные реквизиты (по внутреннему имени или представлению),
//   так и дополнительные реквизиты, хранящиеся в табличной части объекта
//   "ДополнительныеРеквизиты" (строки Свойство/Значение).
//
// Параметры:
//   Ссылка       - ЛюбаяСсылка - объект.
//   НомерВерсии  - Число       - номер версии.
//   ИмяРеквизита - Строка      - искомый реквизит.
//
// Возвращаемое значение:
//   Структура - Найдено (Булево), Значение (Произвольный), Представление (Строка).
//
Функция ЗначениеРеквизитаИзВерсии(Знач Ссылка, Знач НомерВерсии, Знач ИмяРеквизита,
	Знач ВнутреннееИмяРеквизита = "")

	Результат = Новый Структура("Найдено, Значение, Представление", Ложь, Неопределено, "");

	Если Не ЗначениеЗаполнено(ВнутреннееИмяРеквизита) Тогда
		ВнутреннееИмяРеквизита = РазрешитьИмяРеквизита(Ссылка.Метаданные(), ИмяРеквизита);
	КонецЕсли;

	РазобраннаяВерсия = ВерсионированиеОбъектов.РазборВерсии(Ссылка, НомерВерсии);

	ПредставлениеИскомого = ВерсионированиеОбъектов.НаименованиеВыводимогоРеквизита(
		Ссылка, ВнутреннееИмяРеквизита).ВыводимоеНаименование;

	// 1. Обычные реквизиты (и доп. реквизиты, хранимые отдельно от объекта).
	Для Каждого СтрокаРеквизита Из РазобраннаяВерсия.Реквизиты Цикл

		Если Не РеквизитВерсииСовпадает(Ссылка, СтрокаРеквизита.НаименованиеРеквизита, ИмяРеквизита,
			ВнутреннееИмяРеквизита, ПредставлениеИскомого) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Найдено = Истина;
		Результат.Значение = СтрокаРеквизита.ЗначениеРеквизита;
		Результат.Представление = ПредставлениеЗначения(СтрокаРеквизита.ЗначениеРеквизита);
		Возврат Результат;

	КонецЦикла;

	// 2. Дополнительные реквизиты в табличной части объекта.
	ЗначениеДопРеквизита = ЗначениеДополнительногоРеквизитаИзВерсии(РазобраннаяВерсия, ИмяРеквизита, ПредставлениеИскомого);
	Если ЗначениеДопРеквизита.Найдено Тогда
		Возврат ЗначениеДопРеквизита;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Описание: Ищет значение дополнительного реквизита в табличной части "ДополнительныеРеквизиты"
//   разобранной версии объекта.
//
// Параметры:
//   РазобраннаяВерсия     - Структура - результат ВерсионированиеОбъектов.РазборВерсии.
//   ИмяРеквизита          - Строка    - имя дополнительного реквизита.
//   ПредставлениеИскомого - Строка    - представление (синоним) реквизита.
//
// Возвращаемое значение:
//   Структура - Найдено (Булево), Значение (Произвольный), Представление (Строка).
//
Функция ЗначениеДополнительногоРеквизитаИзВерсии(Знач РазобраннаяВерсия, Знач ИмяРеквизита, Знач ПредставлениеИскомого)

	Результат = Новый Структура("Найдено, Значение, Представление", Ложь, Неопределено, "");

	ТаблицаДопРеквизитов = РазобраннаяВерсия.ТабличныеЧасти.Получить("ДополнительныеРеквизиты");
	Если ТаблицаДопРеквизитов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТаблицаДопРеквизитов.Колонки.Найти("Свойство") = Неопределено
		Или ТаблицаДопРеквизитов.Колонки.Найти("Значение") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаДопРеквизита Из ТаблицаДопРеквизитов Цикл

		ИмяСвойства = СокрЛП(Строка(СтрокаДопРеквизита.Свойство));
		Совпадает = (ИмяСвойства = ИмяРеквизита)
			Или (ИмяСвойства = ПредставлениеИскомого)
			Или СинонимСовпадаетСВводом(ИмяСвойства, ИмяРеквизита);

		Если Не Совпадает Тогда
			Продолжить;
		КонецЕсли;

		Результат.Найдено = Истина;
		Результат.Значение = СтрокаДопРеквизита.Значение;
		Результат.Представление = ПредставлениеЗначения(СтрокаДопРеквизита.Значение);
		Прервать;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Описание: Возвращает строковое представление значения для отображения и сравнения.
//
// Параметры:
//   Значение - Произвольный.
//
// Возвращаемое значение:
//   Строка.
//
Функция ПредставлениеЗначения(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Описание: Записывает значение реквизита в объект базы. Определяет, обычный это
//   реквизит или дополнительный, и применяет соответствующий способ записи.
//
// Параметры:
//   Ссылка       - ЛюбаяСсылка   - объект для изменения.
//   ИмяРеквизита - Строка        - имя реквизита.
//   Значение     - Произвольный  - восстанавливаемое значение.
//
Процедура ЗаписатьЗначениеРеквизита(Знач Ссылка, Знач ИмяРеквизита, Знач Значение)

	УстановитьПривилегированныйРежим(Истина);

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение "Объект не найден или удален.";
	КонецЕсли;

	МетаданныеОбъекта = Объект.Метаданные();
	ЭтоОбычныйРеквизит = (МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено);

	Если ЭтоОбычныйРеквизит Тогда
		Объект[ИмяРеквизита] = Значение;
	Иначе
		ЗаписатьДополнительныйРеквизит(Объект, ИмяРеквизита, Значение);
	КонецЕсли;

	Объект.ДополнительныеСвойства.Вставить("ВосстановлениеРеквизитаПоВерсиям", Истина);
	Объект.Записать();

КонецПроцедуры

// Описание: Записывает значение в дополнительный реквизит объекта (ТЧ ДополнительныеРеквизиты).
//   Ищет строку по наименованию свойства; если строки нет — добавляет при наличии свойства.
//
// Параметры:
//   Объект       - ОбъектСсылочногоТипа - объект для изменения.
//   ИмяРеквизита - Строка                - наименование дополнительного реквизита.
//   Значение     - Произвольный          - значение для записи.
//
Процедура ЗаписатьДополнительныйРеквизит(Объект, Знач ИмяРеквизита, Знач Значение)

	Если ТипЗнч(Объект.ДополнительныеРеквизиты) = Тип("Неопределено") Тогда
		ВызватьИсключение "У объекта нет табличной части дополнительных реквизитов.";
	КонецЕсли;

	НайденаСтрока = Ложь;
	Для Каждого СтрокаДопРеквизита Из Объект.ДополнительныеРеквизиты Цикл
		Если Строка(СтрокаДопРеквизита.Свойство) = ИмяРеквизита Тогда
			СтрокаДопРеквизита.Значение = Значение;
			НайденаСтрока = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не НайденаСтрока Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"Дополнительный реквизит ""%1"" не найден у объекта.", ИмяРеквизита);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
