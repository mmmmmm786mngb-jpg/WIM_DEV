#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Период по умолчанию — текущие сутки.
	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;

	// Значения по умолчанию для типового сценария (инцидент синхронизации НСИ).
	Если Не ЗначениеЗаполнено(ПолноеИмяОбъекта) Тогда
		ПолноеИмяОбъекта = "Справочник.Контрагенты";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ИмяРеквизита = "КДУ_ИД";
	КонецЕсли;

	ТекстСообщения = "Укажите период и нажмите ""Найти изменения"". Имя реквизита: как в конфигураторе, синоним или часть синонима (например, ОГРН -> РегистрационныйНомер).";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиИзменения(Команда)

	Если Не ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ПоказатьСообщениеПользователю("Укажите имя реквизита для поиска.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьСообщениеПользователю("Укажите период поиска (с и по).");
		Возврат;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		ПоказатьСообщениеПользователю("Дата начала больше даты окончания.");
		Возврат;
	КонецЕсли;

	Попытка
		КоличествоНайдено = НайтиИзмененияНаСервере();
	Исключение
		ПоказатьСообщениеПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если КоличествоНайдено = 0 Тогда
		ПоказатьСообщениеПользователю("Изменений реквизита за указанный период не найдено.");
	Иначе
		ПоказатьСообщениеПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				"Найдено изменений: %1. Проверьте таблицу и отметьте строки для восстановления.",
				КоличествоНайдено),
			Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьОтметку(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	УстановитьОтметку(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьОтмеченные(Команда)

	КоличествоОтмеченных = 0;
	Для Каждого СтрокаТаблицы Из ТаблицаИзменений Цикл
		Если СтрокаТаблицы.Восстанавливать Тогда
			КоличествоОтмеченных = КоличествоОтмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоОтмеченных = 0 Тогда
		ПоказатьСообщениеПользователю("Не отмечено ни одной строки для восстановления.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"Восстановить старое значение реквизита для отмеченных строк (%1 шт.)? Объекты будут перезаписаны.",
		КоличествоОтмеченных);

	ОписаниеОповещения = Новый ОписаниеОповещения("ВосстановитьОтмеченныеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ВосстановитьОтмеченныеЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ТекстИтога = ВосстановитьОтмеченныеНаСервере();
	Исключение
		ПоказатьСообщениеПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ПоказатьСообщениеПользователю(ТекстИтога, Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Выводит текст в поле формы и при необходимости показывает модальное предупреждение.
//
// Параметры:
//   ТекстПредупреждения - Строка - текст для пользователя.
//   ПоказыватьДиалог    - Булево - Истина: дополнительно вызвать ПоказатьПредупреждение.
//
&НаКлиенте
Процедура ПоказатьСообщениеПользователю(ТекстПредупреждения, ПоказыватьДиалог = Истина)

	ТекстСообщения = ТекстПредупреждения;

	Если ПоказыватьДиалог Тогда
		ПоказатьПредупреждение(
			Неопределено,
			ТекстПредупреждения,
			,
			"Восстановление реквизита по версиям");
	КонецЕсли;

КонецПроцедуры

// Описание: Выполняет поиск изменений реквизита на сервере и заполняет таблицу формы.
//
// Возвращаемое значение:
//   Число - количество найденных строк.
//
&НаСервере
Функция НайтиИзмененияНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");

	РезультатПоиска = Обработка.НайтиИзмененияРеквизита(
		ПолноеИмяОбъекта, ИмяРеквизита, ДатаНачала, ДатаОкончания, Автор);

	ТаблицаИзменений.Очистить();

	Для Каждого СтрокаРезультата Из РезультатПоиска Цикл
		НоваяСтрока = ТаблицаИзменений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
	КонецЦикла;

	Возврат ТаблицаИзменений.Количество();

КонецФункции

// Описание: Восстанавливает значения по отмеченным строкам и возвращает текст итога.
//
// Возвращаемое значение:
//   Строка - итог операции для показа пользователю.
//
&НаСервере
Функция ВосстановитьОтмеченныеНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");

	ТаблицаКВосстановлению = Новый ТаблицаЗначений;
	ТаблицаКВосстановлению.Колонки.Добавить("Объект");
	ТаблицаКВосстановлению.Колонки.Добавить("НомерПредыдущейВерсии", Новый ОписаниеТипов("Число"));

	Для Каждого СтрокаТаблицы Из ТаблицаИзменений Цикл
		Если Не СтрокаТаблицы.Восстанавливать Тогда
			Продолжить;
		КонецЕсли;
		СтрокаВосстановления = ТаблицаКВосстановлению.Добавить();
		СтрокаВосстановления.Объект = СтрокаТаблицы.Объект;
		СтрокаВосстановления.НомерПредыдущейВерсии = СтрокаТаблицы.НомерПредыдущейВерсии;
	КонецЦикла;

	РезультатВосстановления = Обработка.ВосстановитьЗначения(ТаблицаКВосстановлению, ИмяРеквизита);

	КоличествоУспешно = РезультатВосстановления.НайтиСтроки(Новый Структура("Успешно", Истина)).Количество();
	КоличествоОшибок = РезультатВосстановления.Количество() - КоличествоУспешно;

	УспешныеОбъекты = Новый Соответствие;
	Для Каждого СтрокаОтчета Из РезультатВосстановления Цикл
		Если СтрокаОтчета.Успешно Тогда
			УспешныеОбъекты.Вставить(СтрокаОтчета.Объект, Истина);
		КонецЕсли;
	КонецЦикла;

	СтрокиКУдалению = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаИзменений Цикл
		Если СтрокаТаблицы.Восстанавливать И УспешныеОбъекты[СтрокаТаблицы.Объект] = Истина Тогда
			СтрокиКУдалению.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		ТаблицаИзменений.Удалить(СтрокаКУдалению);
	КонецЦикла;

	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"Восстановлено: %1. Ошибок: %2.", КоличествоУспешно, КоличествоОшибок);

КонецФункции

// Описание: Устанавливает признак восстановления для всех строк таблицы.
//
// Параметры:
//   Значение - Булево - устанавливаемое значение признака.
//
&НаКлиенте
Процедура УстановитьОтметку(Знач Значение)

	Для Каждого СтрокаТаблицы Из ТаблицаИзменений Цикл
		СтрокаТаблицы.Восстанавливать = Значение;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
