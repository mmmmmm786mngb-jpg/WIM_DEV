#Область ОбработчикиКомандФормы

// Проверяет введенную строку и выводит в поле Результат все различные перестановки ее символов.
// Пустая строка и строка длиннее МаксимальнаяДлинаСтроки() не обрабатываются - выводится предупреждение.
//
// Параметры:
//  Команда - КомандаФормы - команда "Перестановки".
//
&НаКлиенте
Процедура Перестановки(Команда)

	Результат = "";

	ДлинаСтроки = СтрДлина(ИсходнаяСтрока);
	Если ДлинаСтроки = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите строку символов.'"));
		Возврат;
	КонецЕсли;

	Если ДлинаСтроки > МаксимальнаяДлинаСтроки() Тогда
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Длина строки %1 символов, допустимо не более %2: число перестановок растет как факториал длины.'"),
			ДлинаСтроки, МаксимальнаяДлинаСтроки()));
		Возврат;
	КонецЕсли;

	Результат = ПерестановкиСтроки(ИсходнаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ограничение длины исходной строки: 9 символов дают 362 880 перестановок (около 3,6 млн символов текста).
//
// Возвращаемое значение:
//  Число - максимальная допустимая длина строки.
//
&НаКлиенте
Функция МаксимальнаяДлинаСтроки()

	Возврат 9;

КонецФункции

// Формирует все различные перестановки символов строки в лексикографическом порядке по кодам символов.
// Повторяющиеся символы не дают одинаковых строк: для "112" - 3 строки, а не 6.
//
// Параметры:
//  ТекстСтроки - Строка - исходная непустая строка.
//
// Возвращаемое значение:
//  Строка - перестановки, разделенные переводом строки.
//
&НаСервереБезКонтекста
Функция ПерестановкиСтроки(Знач ТекстСтроки)

	Коды = Новый Массив;
	Для Позиция = 1 По СтрДлина(ТекстСтроки) Цикл
		Коды.Добавить(КодСимвола(ТекстСтроки, Позиция));
	КонецЦикла;

	УпорядочитьПоВозрастанию(Коды);

	СтрокиРезультата = Новый Массив;
	Пока Истина Цикл
		СтрокиРезультата.Добавить(СтрокаИзКодов(Коды));
		Если Не СледующаяПерестановка(Коды) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(СтрокиРезультата, Символы.ПС);

КонецФункции

// Упорядочивает массив чисел по возрастанию на месте (сортировка вставками: элементов не больше
// МаксимальнаяДлинаСтроки()).
//
// Параметры:
//  Коды - Массив из Число - коды символов, изменяется на месте.
//
&НаСервереБезКонтекста
Процедура УпорядочитьПоВозрастанию(Коды)

	Для Индекс = 1 По Коды.ВГраница() Цикл
		Значение = Коды[Индекс];
		Позиция = Индекс - 1;
		Пока Позиция >= 0 И Коды[Позиция] > Значение Цикл
			Коды[Позиция + 1] = Коды[Позиция];
			Позиция = Позиция - 1;
		КонецЦикла;
		Коды[Позиция + 1] = Значение;
	КонецЦикла;

КонецПроцедуры

// Преобразует массив в следующую по возрастанию перестановку (алгоритм Нарайаны).
//
// Параметры:
//  Коды - Массив из Число - текущая перестановка, изменяется на месте.
//
// Возвращаемое значение:
//  Булево - Ложь, если массив уже был последней (убывающей) перестановкой и не изменен.
//
&НаСервереБезКонтекста
Функция СледующаяПерестановка(Коды)

	// Справа ищем первую позицию I, где Коды[I] < Коды[I + 1]; ее нет - перестановка последняя.
	I = Коды.ВГраница() - 1;
	Пока I >= 0 И Коды[I] >= Коды[I + 1] Цикл
		I = I - 1;
	КонецЦикла;
	Если I < 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// Справа ищем первый элемент больше Коды[I], меняем их местами и разворачиваем хвост после I.
	J = Коды.ВГраница();
	Пока Коды[J] <= Коды[I] Цикл
		J = J - 1;
	КонецЦикла;
	ПоменятьМестами(Коды, I, J);

	Лево = I + 1;
	Право = Коды.ВГраница();
	Пока Лево < Право Цикл
		ПоменятьМестами(Коды, Лево, Право);
		Лево = Лево + 1;
		Право = Право - 1;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Меняет местами два элемента массива.
//
// Параметры:
//  Коды    - Массив из Число - изменяется на месте.
//  Индекс1 - Число - индекс первого элемента.
//  Индекс2 - Число - индекс второго элемента.
//
&НаСервереБезКонтекста
Процедура ПоменятьМестами(Коды, Индекс1, Индекс2)

	Значение = Коды[Индекс1];
	Коды[Индекс1] = Коды[Индекс2];
	Коды[Индекс2] = Значение;

КонецПроцедуры

// Собирает строку из кодов символов.
//
// Параметры:
//  Коды - Массив из Число - коды символов в порядке следования.
//
// Возвращаемое значение:
//  Строка - строка из соответствующих символов.
//
&НаСервереБезКонтекста
Функция СтрокаИзКодов(Коды)

	СобраннаяСтрока = "";
	Для Каждого Код Из Коды Цикл
		СобраннаяСтрока = СобраннаяСтрока + Символ(Код);
	КонецЦикла;

	Возврат СобраннаяСтрока;

КонецФункции

#КонецОбласти
