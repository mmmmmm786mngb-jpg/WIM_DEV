#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	АдресАгента = ОбработкаОбъект.АдресАгентаПоУмолчанию();

	СобиратьОССервера = Истина;
	СобиратьЖурналРегистрации = Истина;
	РассчитатьРазмерБД = Ложь;
	// В файловом варианте кластера нет.
	СобиратьКластер = ЗначениеЗаполнено(АдресАгента);

	Элементы.ГруппаКластер.Доступность = СобиратьКластер;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СобиратьКластерПриИзменении(Элемент)

	Элементы.ГруппаКластер.Доступность = СобиратьКластер;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОбработка(Команда)

	Состояние("Сбор сведений о сервере 1С...");
	СформироватьНаСервере(СведенияКлиента());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере(СведенияКлиента)

	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("СведенияКлиента", СведенияКлиента);
	ПараметрыОтчета.Вставить("СобиратьОССервера", СобиратьОССервера);
	ПараметрыОтчета.Вставить("СобиратьЖурналРегистрации", СобиратьЖурналРегистрации);
	ПараметрыОтчета.Вставить("РассчитатьРазмерБД", РассчитатьРазмерБД);
	ПараметрыОтчета.Вставить("СобиратьКластер", СобиратьКластер);
	ПараметрыОтчета.Вставить("АдресАгента", АдресАгента);
	ПараметрыОтчета.Вставить("АдминистраторКластера", АдминистраторКластера);
	ПараметрыОтчета.Вставить("ПарольАдминистратораКластера", ПарольАдминистратораКластера);

	Результат = РеквизитФормыВЗначение("Объект").СформироватьОтчет(ПараметрыОтчета);

КонецПроцедуры

&НаКлиенте
Функция СведенияКлиента()

	СистемнаяИнформация = Новый СистемнаяИнформация;

	Сведения = Новый Структура;
	Сведения.Вставить("ВидКлиента", ВидКлиента());
	Сведения.Вставить("ВерсияПриложения", СистемнаяИнформация.ВерсияПриложения);
	Сведения.Вставить("ТипПлатформы", Строка(СистемнаяИнформация.ТипПлатформы));
	Сведения.Вставить("ВерсияОС", СистемнаяИнформация.ВерсияОС);
	Сведения.Вставить("Процессор", СистемнаяИнформация.Процессор);
	Сведения.Вставить("ОперативнаяПамять", СистемнаяИнформация.ОперативнаяПамять);
	Сведения.Вставить("ИнформацияПрограммыПросмотра", СистемнаяИнформация.ИнформацияПрограммыПросмотра);
	Сведения.Вставить("СкоростьСоединения", Строка(ПолучитьСкоростьКлиентскогоСоединения()));

#Если ВебКлиент Тогда
	Сведения.Вставить("ИмяКомпьютера", "");
#Иначе
	Сведения.Вставить("ИмяКомпьютера", ИмяКомпьютера());
#КонецЕсли

	Экраны = Новый Массив;
	Для Каждого Экран Из ПолучитьИнформациюЭкрановКлиента() Цикл
		Экраны.Добавить(СтрШаблон("%1x%2 (DPI %3)", Формат(Экран.Ширина, "ЧГ=0"), Формат(Экран.Высота, "ЧГ=0"), Экран.DPI));
	КонецЦикла;
	Сведения.Вставить("Экраны", СтрСоединить(Экраны, "; "));

	Сведения.Вставить("ДатаКлиента", ТекущаяДата());
	Сведения.Вставить("УниверсальнаяДатаВМиллисекундах", ТекущаяУниверсальнаяДатаВМиллисекундах());

	Возврат Сведения;

КонецФункции

&НаКлиенте
Функция ВидКлиента()

#Если ВебКлиент Тогда
	Возврат "Веб-клиент";
#ИначеЕсли ТонкийКлиент Тогда
	Возврат "Тонкий клиент";
#ИначеЕсли ТолстыйКлиентУправляемоеПриложение Тогда
	Возврат "Толстый клиент (управляемое приложение)";
#Иначе
	Возврат "Другой";
#КонецЕсли

КонецФункции

#КонецОбласти
