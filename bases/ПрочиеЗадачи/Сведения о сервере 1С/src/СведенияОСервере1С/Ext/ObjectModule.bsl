#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Формирует отчет со сведениями о сервере 1С.
// Каждый раздел собирается в своей попытке: ошибка раздела выводится в отчет и не прерывает сбор остальных.
//
// Параметры:
//  Параметры - Структура:
//   * СведенияКлиента - Структура - сведения клиентского приложения, см. форму обработки.
//   * СобиратьОССервера - Булево - собирать сведения ОС сервера (WMI на Windows, команды на Linux).
//   * СобиратьЖурналРегистрации - Булево - собирать ошибки журнала регистрации за сутки.
//   * РассчитатьРазмерБД - Булево - рассчитывать размер данных информационной базы.
//   * СобиратьКластер - Булево - собирать сведения кластера через COM-соединение с агентом.
//   * АдресАгента - Строка - адрес агента кластера, например tcp://server:1540.
//   * АдминистраторКластера - Строка - имя администратора кластера.
//   * ПарольАдминистратораКластера - Строка - пароль администратора кластера.
//
// Возвращаемое значение:
//  ТабличныйДокумент - отчет.
//
Функция СформироватьОтчет(Параметры) Экспорт

	Контекст = Новый Структура("Блоки, Замечания", Новый Массив, Новый Массив);
	// Часы сравниваются до сбора разделов: расчет размера базы может идти минуты.
	Контекст.Вставить("РасхождениеЧасов", Окр((ТекущаяУниверсальнаяДатаВМиллисекундах()
		- Параметры.СведенияКлиента.УниверсальнаяДатаВМиллисекундах) / 1000, 1));

	Попытка
		ДобавитьСведенияИнформационнойБазы(Контекст, Параметры.РассчитатьРазмерБД);
	Исключение
		ДобавитьОшибкуРаздела(Контекст, "Информационная база", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ДобавитьСведенияСервера(Контекст, Параметры.СведенияКлиента);
	Исключение
		ДобавитьОшибкуРаздела(Контекст, "Рабочий сервер 1С", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ДобавитьСведенияКлиента(Контекст, Параметры.СведенияКлиента);
	Исключение
		ДобавитьОшибкуРаздела(Контекст, "Клиент", ИнформацияОбОшибке());
	КонецПопытки;

	Если Параметры.СобиратьОССервера Тогда
		Попытка
			ДобавитьСведенияОССервера(Контекст);
		Исключение
			ДобавитьОшибкуРаздела(Контекст, "Операционная система сервера", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Попытка
		ДобавитьСведенияСеансов(Контекст);
	Исключение
		ДобавитьОшибкуРаздела(Контекст, "Сеансы информационной базы", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ДобавитьСведенияЗаданий(Контекст);
	Исключение
		ДобавитьОшибкуРаздела(Контекст, "Фоновые и регламентные задания", ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ДобавитьСведенияРасширений(Контекст);
	Исключение
		ДобавитьОшибкуРаздела(Контекст, "Расширения конфигурации", ИнформацияОбОшибке());
	КонецПопытки;

	Если Параметры.СобиратьЖурналРегистрации Тогда
		Попытка
			ДобавитьСведенияЖурналаРегистрации(Контекст);
		Исключение
			ДобавитьОшибкуРаздела(Контекст, "Журнал регистрации", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Если Параметры.СобиратьКластер Тогда
		Попытка
			ДобавитьСведенияКластера(Контекст, Параметры);
		Исключение
			ДобавитьОшибкуРаздела(Контекст, "Кластер серверов", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат ТабличныйДокументОтчета(Контекст);

КонецФункции

// Определяет адрес агента кластера по строке соединения информационной базы.
// Порт агента считается на единицу меньше порта менеджера кластера (1541 -> 1540).
//
// Возвращаемое значение:
//  Строка - адрес вида tcp://server:1540, пустая строка для файловой базы.
//
Функция АдресАгентаПоУмолчанию() Экспорт

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Если ЭтоФайловаяБаза(СтрокаСоединения) Тогда
		Возврат "";
	КонецЕсли;

	Сервер = ЗначениеИзСтрокиСоединения(СтрокаСоединения, "Srvr");
	// В кластере из нескольких серверов строка содержит их список через запятую.
	Сервер = СокрЛП(СтрРазделить(Сервер, ",;")[0]);
	Сервер = СтрЗаменить(Сервер, "tcp://", "");

	ПортАгента = 1540;
	ПозицияДвоеточия = СтрНайти(Сервер, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Попытка
			ПортАгента = Число(Сред(Сервер, ПозицияДвоеточия + 1)) - 1;
		Исключение
			ПортАгента = 1540;
		КонецПопытки;
		Сервер = Лев(Сервер, ПозицияДвоеточия - 1);
	КонецЕсли;

	Возврат СтрШаблон("tcp://%1:%2", Сервер, Формат(ПортАгента, "ЧГ=0"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнформационнаяБаза

Процедура ДобавитьСведенияИнформационнойБазы(Контекст, РассчитатьРазмерБД)

	ДобавитьРаздел(Контекст, "Информационная база");

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	ДобавитьПараметр(Контекст, "Строка соединения", СтрокаСоединения);
	ДобавитьПараметр(Контекст, "Вариант работы",
		?(ЭтоФайловаяБаза(СтрокаСоединения), "Файловый", "Клиент-серверный"));
	ДобавитьПараметр(Контекст, "Конфигурация", СтрШаблон("%1 (%2)", Метаданные.Синоним, Метаданные.Имя));
	ДобавитьПараметр(Контекст, "Версия конфигурации", Метаданные.Версия);
	ДобавитьПараметр(Контекст, "Поставщик", Метаданные.Поставщик);
	ДобавитьПараметр(Контекст, "Режим совместимости", Метаданные.РежимСовместимости);
	ДобавитьПараметр(Контекст, "Режим управления блокировкой данных", Метаданные.РежимУправленияБлокировкойДанных);
	ДобавитьПараметр(Контекст, "Режим использования модальности", Метаданные.РежимИспользованияМодальности);

	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	ДобавитьПараметр(Контекст, "Текущий пользователь",
		?(ПустаяСтрока(ТекущийПользователь.Имя), "<не задан>", ТекущийПользователь.Имя));
	ДобавитьПараметр(Контекст, "Номер текущего сеанса", НомерСеансаИнформационнойБазы());
	ДобавитьПараметр(Контекст, "Безопасный режим", БезопасныйРежим());

	Попытка
		ДобавитьПараметр(Контекст, "Пользователей информационной базы",
			ПользователиИнформационнойБазы.ПолучитьПользователей().Количество());
	Исключение
		ДобавитьПараметр(Контекст, "Пользователей информационной базы", ТекстОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		ДобавитьСведенияБлокировкиСеансов(Контекст);
	Исключение
		ДобавитьПараметр(Контекст, "Блокировка сеансов", ТекстОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Уровни = ПолучитьИспользованиеЖурналаРегистрации();
		ДобавитьПараметр(Контекст, "Уровни журнала регистрации",
			?(Уровни.Количество() = 0, "журнал не ведется", Уровни));
		Если Уровни.Количество() = 0 Тогда
			ДобавитьЗамечание(Контекст, "Журнал регистрации отключен: ошибки не регистрируются.");
		КонецЕсли;
	Исключение
		ДобавитьПараметр(Контекст, "Уровни журнала регистрации", ТекстОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если РассчитатьРазмерБД Тогда
		Попытка
			ДобавитьПараметр(Контекст, "Размер данных базы, ГБ (без истории данных и расширений)",
				Окр(ПолучитьРазмерДанныхБазыДанных() / 1073741824, 2));
		Исключение
			ДобавитьПараметр(Контекст, "Размер данных базы", ТекстОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСведенияБлокировкиСеансов(Контекст)

	Блокировка = ПолучитьБлокировкуСеансов();
	Если Не Блокировка.Установлена Тогда
		ДобавитьПараметр(Контекст, "Блокировка сеансов", "не установлена");
		Возврат;
	КонецЕсли;

	ДобавитьПараметр(Контекст, "Блокировка сеансов",
		СтрШаблон("установлена: с %1 по %2. %3",
			ПредставлениеЗначения(Блокировка.Начало),
			?(ЗначениеЗаполнено(Блокировка.Конец), ПредставлениеЗначения(Блокировка.Конец), "без срока"),
			Блокировка.Сообщение));

	ТекущийМомент = ТекущаяДатаСеанса();
	Если Блокировка.Начало <= ТекущийМомент
		И (Не ЗначениеЗаполнено(Блокировка.Конец) Или Блокировка.Конец > ТекущийМомент) Тогда
		ДобавитьЗамечание(Контекст, "Действует блокировка начала сеансов информационной базы.");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СерверИКлиент

Процедура ДобавитьСведенияСервера(Контекст, СведенияКлиента)

	ДобавитьРаздел(Контекст, "Рабочий сервер 1С (процесс, в котором выполняется серверный код)");

	СистемнаяИнформация = Новый СистемнаяИнформация;
	ДобавитьПараметр(Контекст, "Имя компьютера", ИмяКомпьютера());
	ДобавитьПараметр(Контекст, "Пользователь ОС процесса сервера", ИмяПользователяОССервера());
	ДобавитьПараметр(Контекст, "Версия платформы", СистемнаяИнформация.ВерсияПриложения);
	ДобавитьПараметр(Контекст, "Тип платформы", СистемнаяИнформация.ТипПлатформы);
	ДобавитьПараметр(Контекст, "Операционная система", СистемнаяИнформация.ВерсияОС);
	ДобавитьПараметр(Контекст, "Процессор", СистемнаяИнформация.Процессор);
	ДобавитьПараметр(Контекст, "Оперативная память, МБ", СистемнаяИнформация.ОперативнаяПамять);
	ДобавитьПараметр(Контекст, "Каталог программы", КаталогПрограммы());
	ДобавитьПараметр(Контекст, "Каталог временных файлов", КаталогВременныхФайлов());
	ДобавитьПараметр(Контекст, "Код локализации", ТекущийКодЛокализации());
	ДобавитьПараметр(Контекст, "Часовой пояс сервера", ЧасовойПояс());
	ДобавитьПараметр(Контекст, "Часовой пояс сеанса", ЧасовойПоясСеанса());
	// Нужно время самого сервера, а не время сеанса.
	ДобавитьПараметр(Контекст, "Дата и время сервера", ТекущаяДата());

	РасхождениеЧасов = Контекст.РасхождениеЧасов;
	ДобавитьПараметр(Контекст, "Расхождение часов сервера и клиента, с (включая время вызова)", РасхождениеЧасов);
	Если Макс(РасхождениеЧасов, -РасхождениеЧасов) > 30 Тогда
		ДобавитьЗамечание(Контекст, СтрШаблон(
			"Часы сервера и клиента расходятся на %1 с: проверьте синхронизацию времени.", РасхождениеЧасов));
	КонецЕсли;

	Если СведенияКлиента.ВерсияПриложения <> СистемнаяИнформация.ВерсияПриложения
		И СведенияКлиента.ВидКлиента <> "Веб-клиент" Тогда
		ДобавитьЗамечание(Контекст, СтрШаблон("Версия клиента %1 отличается от версии сервера %2.",
			СведенияКлиента.ВерсияПриложения, СистемнаяИнформация.ВерсияПриложения));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСведенияКлиента(Контекст, СведенияКлиента)

	ДобавитьРаздел(Контекст, "Клиент (приложение, из которого открыта обработка)");

	ДобавитьПараметр(Контекст, "Вид клиента", СведенияКлиента.ВидКлиента);
	ДобавитьПараметр(Контекст, "Имя компьютера", СведенияКлиента.ИмяКомпьютера);
	ДобавитьПараметр(Контекст, "Версия платформы", СведенияКлиента.ВерсияПриложения);
	ДобавитьПараметр(Контекст, "Тип платформы", СведенияКлиента.ТипПлатформы);
	ДобавитьПараметр(Контекст, "Операционная система", СведенияКлиента.ВерсияОС);
	ДобавитьПараметр(Контекст, "Процессор", СведенияКлиента.Процессор);
	ДобавитьПараметр(Контекст, "Оперативная память, МБ", СведенияКлиента.ОперативнаяПамять);
	ДобавитьПараметр(Контекст, "Браузер", СведенияКлиента.ИнформацияПрограммыПросмотра);
	ДобавитьПараметр(Контекст, "Скорость соединения", СведенияКлиента.СкоростьСоединения);
	ДобавитьПараметр(Контекст, "Экраны", СведенияКлиента.Экраны);
	ДобавитьПараметр(Контекст, "Дата и время клиента", СведенияКлиента.ДатаКлиента);

КонецПроцедуры

#КонецОбласти

#Область ОперационнаяСистема

Процедура ДобавитьСведенияОССервера(Контекст)

	ДобавитьРаздел(Контекст, "Операционная система сервера 1С");

	СистемнаяИнформация = Новый СистемнаяИнформация;
	ТипСервера = СистемнаяИнформация.ТипПлатформы;
	Если ТипСервера = ТипПлатформы.Windows_x86 Или ТипСервера = ТипПлатформы.Windows_x86_64 Тогда
		ДобавитьСведенияWindows(Контекст);
	ИначеЕсли ЭтоLinuxСервер(ТипСервера) Тогда
		ДобавитьСведенияLinux(Контекст);
	Иначе
		ДобавитьПараметр(Контекст, "Сведения ОС", СтрШаблон("Тип платформы %1 не поддерживается", ТипСервера));
	КонецЕсли;

КонецПроцедуры

Функция ЭтоLinuxСервер(ТипСервера)

	Если ТипСервера = ТипПлатформы.Linux_x86 Или ТипСервера = ТипПлатформы.Linux_x86_64 Тогда
		Возврат Истина;
	КонецЕсли;

	// Значения, которых нет в старых версиях платформы.
	Для Каждого ИмяТипа Из СтрРазделить("Linux_ARM64,Linux_E2K", ",") Цикл
		Попытка
			Если ТипСервера = ТипПлатформы[ИмяТипа] Тогда
				Возврат Истина;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьСведенияWindows(Контекст)

	Попытка
		СлужбаWMI = ПолучитьCOMОбъект("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2");
	Исключение
		ДобавитьОшибку(Контекст, "Нет доступа к WMI: " + ТекстОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	// Операционная система.
	ТаблицаОС = ТаблицаWMI(Контекст, СлужбаWMI, "SELECT * FROM Win32_OperatingSystem",
		"Caption|ОС;Version|Версия;OSArchitecture|Разрядность;LastBootUpTime|Последняя загрузка|ДатаWMI;"
		+ "TotalVisibleMemorySize|Память всего, МБ|КБвМБ;FreePhysicalMemory|Свободно памяти, МБ|КБвМБ;"
		+ "TotalVirtualMemorySize|Виртуальная память всего, МБ|КБвМБ;FreeVirtualMemory|Свободно виртуальной памяти, МБ|КБвМБ;"
		+ "NumberOfProcesses|Процессов");
	ДобавитьПараметрыИзТаблицы(Контекст, ТаблицаОС);
	Если ТаблицаОС <> Неопределено И ТаблицаОС.Количество() > 0 Тогда
		СтрокаОС = ТаблицаОС[0];
		Если ТипЗнч(СтрокаОС.К4) = Тип("Дата") И ЗначениеЗаполнено(СтрокаОС.К4) Тогда
			// Время загрузки WMI отдает во времени сервера.
			ДобавитьПараметр(Контекст, "Время работы без перезагрузки, дней", Окр((ТекущаяДата() - СтрокаОС.К4) / 86400, 1));
		КонецЕсли;
		ПроверитьОстатокРесурса(Контекст, "Свободной оперативной памяти", СтрокаОС.К6, СтрокаОС.К5, 10);
	КонецЕсли;

	// Компьютер.
	ДобавитьПараметрыИзТаблицы(Контекст, ТаблицаWMI(Контекст, СлужбаWMI, "SELECT * FROM Win32_ComputerSystem",
		"Manufacturer|Производитель;Model|Модель;Domain|Домен;NumberOfProcessors|Физических процессоров;"
		+ "NumberOfLogicalProcessors|Логических процессоров;TotalPhysicalMemory|Физическая память, МБ|БвМБ;"
		+ "HypervisorPresent|Запущен под гипервизором"));

	ДобавитьПараметрыИзТаблицы(Контекст,
		ТаблицаWMI(Контекст, СлужбаWMI, "SELECT * FROM Win32_TimeZone", "Caption|Часовой пояс ОС"));

	ДобавитьСхемуЭлектропитания(Контекст);
	ДобавитьСведенияЗащитникаWindows(Контекст);

	ДобавитьТаблицу(Контекст, ТаблицаWMI(Контекст, СлужбаWMI, "SELECT * FROM Win32_Processor",
		"DeviceID|Процессор;Name|Модель;NumberOfCores|Ядер;NumberOfLogicalProcessors|Логических;"
		+ "MaxClockSpeed|Частота макс., МГц;CurrentClockSpeed|Частота текущая, МГц;LoadPercentage|Загрузка, %"),
		"Процессоры");

	ДобавитьДискиWindows(Контекст, СлужбаWMI);

	ДобавитьТаблицу(Контекст, ТаблицаWMI(Контекст, СлужбаWMI, "SELECT * FROM Win32_PageFileUsage",
		"Name|Файл подкачки;AllocatedBaseSize|Размер, МБ;CurrentUsage|Используется, МБ;PeakUsage|Пик, МБ"),
		"Файлы подкачки");

	ДобавитьТаблицу(Контекст, ТаблицаWMI(Контекст, СлужбаWMI,
		"SELECT * FROM Win32_NetworkAdapterConfiguration WHERE IPEnabled = TRUE",
		"Description|Сетевой адаптер;IPAddress|IP-адреса|Массив;DefaultIPGateway|Шлюз|Массив;"
		+ "DNSServerSearchOrder|DNS-серверы|Массив;DHCPEnabled|DHCP"),
		"Сетевые адаптеры");

	ДобавитьТаблицу(Контекст, ТаблицаWMI(Контекст, СлужбаWMI,
		"SELECT * FROM Win32_Service WHERE Name LIKE '%1C%' OR DisplayName LIKE '%1C%'
		| OR Name LIKE 'MSSQL%' OR Name LIKE 'SQLAgent%' OR Name LIKE 'postgres%'
		| OR Name LIKE 'Apache%' OR Name = 'W3SVC'",
		"Name|Служба;DisplayName|Представление;State|Состояние;StartMode|Запуск;StartName|Учетная запись;"
		+ "PathName|Командная строка"),
		"Службы 1С, СУБД и веб-серверов");

	ДобавитьПроцессыWindows(Контекст, СлужбаWMI);

КонецПроцедуры

Процедура ДобавитьСхемуЭлектропитания(Контекст)

	Попытка
		СлужбаWMI = ПолучитьCOMОбъект("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2\power");
	Исключение
		ДобавитьПараметр(Контекст, "Схема электропитания", ТекстОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Таблица = ТаблицаWMI(Контекст, СлужбаWMI, "SELECT * FROM Win32_PowerPlan WHERE IsActive = TRUE",
		"ElementName|Схема электропитания;InstanceID|Идентификатор");
	Если Таблица = Неопределено Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДобавитьПараметр(Контекст, "Схема электропитания", Таблица[0].К1);
	// Идентификаторы схем "Высокая производительность" и "Максимальная производительность".
	Идентификатор = НРег(Строка(Таблица[0].К2));
	Если СтрНайти(Идентификатор, "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c") = 0
		И СтрНайти(Идентификатор, "e9a42b02-d5df-448d-aa00-03f14749eb61") = 0 Тогда
		ДобавитьЗамечание(Контекст, СтрШаблон(
			"Схема электропитания сервера ""%1"": для сервера 1С рекомендуется ""Высокая производительность"".",
			Таблица[0].К1));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСведенияЗащитникаWindows(Контекст)

	Попытка
		СлужбаWMI = ПолучитьCOMОбъект("winmgmts:{impersonationLevel=impersonate}!\\.\root\Microsoft\Windows\Defender");
	Исключение
		// Защитник не установлен или нет доступа к пространству имен.
		Возврат;
	КонецПопытки;

	ДобавитьПараметрыИзТаблицы(Контекст, ТаблицаWMI(Контекст, СлужбаWMI, "SELECT * FROM MSFT_MpComputerStatus",
		"AMServiceEnabled|Защитник Windows включен;RealTimeProtectionEnabled|Защита в реальном времени"));
	ДобавитьПараметрыИзТаблицы(Контекст, ТаблицаWMI(Контекст, СлужбаWMI, "SELECT * FROM MSFT_MpPreference",
		"ExclusionPath|Исключения антивируса (пути)|Массив;ExclusionProcess|Исключения антивируса (процессы)|Массив"));

КонецПроцедуры

Процедура ДобавитьДискиWindows(Контекст, СлужбаWMI)

	Таблица = ТаблицаWMI(Контекст, СлужбаWMI, "SELECT * FROM Win32_LogicalDisk WHERE DriveType = 3",
		"DeviceID|Диск;VolumeName|Метка;FileSystem|Файловая система;Size|Размер, ГБ|БвГБ;FreeSpace|Свободно, ГБ|БвГБ");
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Таблица.Колонки.Добавить("К6", , "Свободно, %");
	Для Каждого СтрокаДиска Из Таблица Цикл
		Если ТипЗнч(СтрокаДиска.К4) = Тип("Число") И СтрокаДиска.К4 > 0 Тогда
			СтрокаДиска.К6 = Окр(ЧислоИлиНоль(СтрокаДиска.К5) / СтрокаДиска.К4 * 100, 1);
		КонецЕсли;
		ПроверитьОстатокРесурса(Контекст, "Свободного места на диске " + СтрокаДиска.К1,
			СтрокаДиска.К5, СтрокаДиска.К4, 10);
	КонецЦикла;

	ДобавитьТаблицу(Контекст, Таблица, "Локальные диски");

КонецПроцедуры

Процедура ДобавитьПроцессыWindows(Контекст, СлужбаWMI)

	Таблица = ТаблицаWMI(Контекст, СлужбаWMI,
		"SELECT * FROM Win32_Process WHERE Name = 'ragent.exe' OR Name = 'rmngr.exe' OR Name = 'rphost.exe'
		| OR Name = 'ras.exe' OR Name = 'sqlservr.exe' OR Name = 'postgres.exe' OR Name = 'httpd.exe' OR Name = 'w3wp.exe'",
		"Name|Процесс;ProcessId|PID;WorkingSetSize|Память, МБ|БвМБ;ThreadCount|Потоков;HandleCount|Дескрипторов;"
		+ "CreationDate|Запущен|ДатаWMI;CommandLine|Командная строка");
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Итоги = НоваяТаблица("Процесс|Процесс;Количество|Количество;Память|Память, МБ;Потоков|Потоков");
	Для Каждого СтрокаПроцесса Из Таблица Цикл
		СтрокаИтога = Итоги.Добавить();
		СтрокаИтога.Процесс = СтрокаПроцесса.К1;
		СтрокаИтога.Количество = 1;
		СтрокаИтога.Память = ЧислоИлиНоль(СтрокаПроцесса.К3);
		СтрокаИтога.Потоков = ЧислоИлиНоль(СтрокаПроцесса.К4);
	КонецЦикла;
	Итоги.Свернуть("Процесс", "Количество, Память, Потоков");
	Итоги.Сортировать("Память Убыв");
	ДобавитьТаблицу(Контекст, Итоги, "Процессы 1С, СУБД и веб-серверов (итоги)");

	// Подробно - только процессы 1С: у СУБД процессов может быть много.
	ПроцессыНе1С = Новый Массив;
	Для Каждого СтрокаПроцесса Из Таблица Цикл
		Если СтрНайти(",ragent.exe,rmngr.exe,rphost.exe,ras.exe,", "," + НРег(СтрокаПроцесса.К1) + ",") = 0 Тогда
			ПроцессыНе1С.Добавить(СтрокаПроцесса);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаПроцесса Из ПроцессыНе1С Цикл
		Таблица.Удалить(СтрокаПроцесса);
	КонецЦикла;
	Таблица.Сортировать("К1, К3 Убыв");
	ДобавитьТаблицу(Контекст, Таблица, "Процессы сервера 1С");

КонецПроцедуры

Процедура ДобавитьСведенияLinux(Контекст)

	// Заголовок|команда оболочки. Команда может содержать символ | (конвейер).
	Команды = Новый Массив;
	Команды.Добавить("Ядро и дистрибутив|uname -a; grep -E '^(PRETTY_NAME|VERSION_ID)=' /etc/os-release");
	Команды.Добавить("Время работы и средняя загрузка|uptime");
	Команды.Добавить("Процессор|echo ""CPU: $(nproc)""; lscpu | grep -iE 'model name|socket|core|thread|mhz|hypervisor|virtualization'");
	Команды.Добавить("Регулятор частоты процессора|cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor");
	Команды.Добавить("Память, МБ|free -m");
	Команды.Добавить("Диски|df -hT -x tmpfs -x devtmpfs -x overlay -x squashfs");
	Команды.Добавить("Процессы 1С, СУБД и веб-серверов|ps -eo pid,rss,nlwp,etime,args --sort=-rss | grep -E 'ragent|rmngr|rphost|/ras |postgres|httpd|apache2' | grep -v grep | head -40");
	Команды.Добавить("Службы|systemctl list-units --type=service --all --no-pager | grep -iE '1c|srv1cv8|ras|postgres|apache|httpd'");
	Команды.Добавить("Время и синхронизация|timedatectl");
	Команды.Добавить("Сетевые адреса|hostname -I; hostname -f");
	Команды.Добавить("Ограничения процесса 1С (ulimit)|ulimit -a");

	ИмяСкрипта = ПолучитьИмяВременногоФайла("sh");
	ИмяРезультата = ПолучитьИмяВременногоФайла("txt");

	СтрокиСкрипта = Новый Массив;
	СтрокиСкрипта.Добавить("exec > '" + ИмяРезультата + "' 2>&1");
	СтрокиСкрипта.Добавить("export LANG=C.UTF-8");
	Для Каждого Команда Из Команды Цикл
		Части = СтрРазделить(Команда, "|");
		СтрокиСкрипта.Добавить("echo '### " + Части[0] + "'");
		Части.Удалить(0);
		СтрокиСкрипта.Добавить(СтрСоединить(Части, "|"));
	КонецЦикла;

	Попытка
		// Без BOM: иначе sh не распознает первую строку скрипта.
		ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(СтрокиСкрипта, Символы.ПС), "UTF-8", Ложь).Записать(ИмяСкрипта);
		КодВозврата = 0;
		ЗапуститьПриложение("/bin/sh " + ИмяСкрипта, , Истина, КодВозврата);

		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ИмяРезультата, КодировкаТекста.UTF8);
		ДобавитьВыводКомандLinux(Контекст, ТекстовыйДокумент);
	Исключение
		ДобавитьОшибку(Контекст, "Не удалось выполнить команды ОС: " + ТекстОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	УдалитьВременныйФайл(ИмяСкрипта);
	УдалитьВременныйФайл(ИмяРезультата);

КонецПроцедуры

Процедура ДобавитьВыводКомандLinux(Контекст, ТекстовыйДокумент)

	Заголовок = "";
	Строки = Новый Массив;
	Для НомерСтроки = 1 По ТекстовыйДокумент.КоличествоСтрок() Цикл
		ТекстСтроки = ТекстовыйДокумент.ПолучитьСтроку(НомерСтроки);
		Если СтрНачинаетсяС(ТекстСтроки, "### ") Тогда
			ДобавитьВыводКоманды(Контекст, Заголовок, Строки);
			Заголовок = Сред(ТекстСтроки, 5);
			Строки = Новый Массив;
		Иначе
			Строки.Добавить(ТекстСтроки);
		КонецЕсли;
	КонецЦикла;
	ДобавитьВыводКоманды(Контекст, Заголовок, Строки);

КонецПроцедуры

Процедура ДобавитьВыводКоманды(Контекст, Заголовок, Строки)

	Если ПустаяСтрока(Заголовок) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьПодраздел(Контекст, Заголовок);
	ДобавитьТекст(Контекст, ?(Строки.Количество() = 0, "<нет вывода>", СтрСоединить(Строки, Символы.ПС)));

	Если Заголовок = "Регулятор частоты процессора" И Строки.Количество() > 0
		И СтрНайти(Строки[0], "performance") = 0 И СтрНайти(Строки[0], "No such file") = 0 Тогда
		ДобавитьЗамечание(Контекст, СтрШаблон(
			"Регулятор частоты процессора ""%1"": для сервера 1С рекомендуется ""performance"".", СокрЛП(Строки[0])));
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьВременныйФайл(ИмяФайла)

	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		// Файла нет или он занят: временный каталог очищается платформой.
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СеансыИЗадания

Процедура ДобавитьСведенияСеансов(Контекст)

	ДобавитьРаздел(Контекст, "Сеансы информационной базы");

	Сеансы = ПолучитьСеансыИнформационнойБазы();
	ТекущийСеанс = НомерСеансаИнформационнойБазы();
	ДобавитьПараметр(Контекст, "Всего сеансов", Сеансы.Количество());

	Таблица = НоваяТаблица("НомерСеанса|Сеанс;Приложение|Приложение;Пользователь|Пользователь;"
		+ "Компьютер|Компьютер;IPАдрес|IP-адрес;Начало|Начало;Текущий|Текущий");
	Для Каждого Сеанс Из Сеансы Цикл
		СтрокаСеанса = Таблица.Добавить();
		СтрокаСеанса.НомерСеанса = Сеанс.НомерСеанса;
		СтрокаСеанса.Приложение = ИмяПриложенияСПредставлением(Сеанс.ИмяПриложения);
		СтрокаСеанса.Пользователь = ?(Сеанс.Пользователь = Неопределено, "", Сеанс.Пользователь.Имя);
		СтрокаСеанса.Компьютер = Сеанс.ИмяКомпьютера;
		Попытка
			СтрокаСеанса.IPАдрес = Сеанс.IPАдресКлиента;
		Исключение
			// Свойства нет в старых версиях платформы.
			СтрокаСеанса.IPАдрес = "";
		КонецПопытки;
		СтрокаСеанса.Начало = Сеанс.НачалоСеанса;
		СтрокаСеанса.Текущий = (Сеанс.НомерСеанса = ТекущийСеанс);
	КонецЦикла;

	Итоги = Таблица.Скопировать(, "Приложение");
	Итоги.Колонки.Добавить("Количество", , "Количество");
	Итоги.ЗаполнитьЗначения(1, "Количество");
	Итоги.Свернуть("Приложение", "Количество");
	Итоги.Сортировать("Количество Убыв");
	ДобавитьТаблицу(Контекст, Итоги, "Сеансы по приложениям");

	Таблица.Сортировать("Начало");
	ДобавитьТаблицу(Контекст, Таблица, "Список сеансов", 300);

КонецПроцедуры

Функция ИмяПриложенияСПредставлением(ИмяПриложения)

	Попытка
		Возврат СтрШаблон("%1 (%2)", ПредставлениеПриложения(ИмяПриложения), ИмяПриложения);
	Исключение
		Возврат ИмяПриложения;
	КонецПопытки;

КонецФункции

Процедура ДобавитьСведенияЗаданий(Контекст)

	ДобавитьРаздел(Контекст, "Фоновые и регламентные задания");

	ТекущийМомент = ТекущаяДатаСеанса();

	Активные = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно));
	Таблица = НоваяТаблица("Наименование|Задание;ИмяМетода|Метод;Начало|Начало;Длительность|Выполняется, мин;"
		+ "Расположение|Сервер");
	Для Каждого Задание Из Активные Цикл
		СтрокаЗадания = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗадания, Задание, "Наименование, ИмяМетода, Начало, Расположение");
		СтрокаЗадания.Длительность = Окр((ТекущийМомент - Задание.Начало) / 60, 1);
	КонецЦикла;
	Таблица.Сортировать("Начало");
	ДобавитьПараметр(Контекст, "Активных фоновых заданий", Таблица.Количество());
	ДобавитьТаблицу(Контекст, Таблица, "Активные фоновые задания", 100);

	ДобавитьАварийныеЗадания(Контекст, ТекущийМомент);
	ДобавитьРегламентныеЗадания(Контекст);

КонецПроцедуры

Процедура ДобавитьАварийныеЗадания(Контекст, ТекущийМомент)

	Аварийные = ФоновыеЗадания.ПолучитьФоновыеЗадания(
		Новый Структура("Состояние", СостояниеФоновогоЗадания.ЗавершеноАварийно));

	Таблица = НоваяТаблица("ИмяМетода|Метод;Количество|Количество;Последнее|Последнее;Ошибка|Последняя ошибка");
	Таблица.Индексы.Добавить("ИмяМетода");
	Для Каждого Задание Из Аварийные Цикл
		Если Задание.Начало < ТекущийМомент - 86400 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЗадания = Таблица.Найти(Задание.ИмяМетода, "ИмяМетода");
		Если СтрокаЗадания = Неопределено Тогда
			СтрокаЗадания = Таблица.Добавить();
			СтрокаЗадания.ИмяМетода = Задание.ИмяМетода;
			СтрокаЗадания.Количество = 0;
		КонецЕсли;
		СтрокаЗадания.Количество = СтрокаЗадания.Количество + 1;
		Если СтрокаЗадания.Последнее = Неопределено Или Задание.Начало > СтрокаЗадания.Последнее Тогда
			СтрокаЗадания.Последнее = Задание.Начало;
			СтрокаЗадания.Ошибка = ?(Задание.ИнформацияОбОшибке = Неопределено, "",
				Лев(ТекстОшибки(Задание.ИнформацияОбОшибке), 500));
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("Количество Убыв");

	Если Таблица.Количество() > 0 Тогда
		ДобавитьЗамечание(Контекст, СтрШаблон(
			"За сутки аварийно завершались фоновые задания %1 методов, см. раздел ""Фоновые и регламентные задания"".",
			Таблица.Количество()));
	КонецЕсли;
	ДобавитьТаблицу(Контекст, Таблица, "Аварийно завершенные фоновые задания за сутки (по методам)", 50);

КонецПроцедуры

Процедура ДобавитьРегламентныеЗадания(Контекст)

	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	Таблица = НоваяТаблица("Наименование|Регламентное задание;Расписание|Расписание;"
		+ "Начало|Последний запуск;Состояние|Состояние последнего запуска");
	Для Каждого Задание Из Задания Цикл
		Если Не Задание.Использование Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЗадания = Таблица.Добавить();
		СтрокаЗадания.Наименование = ?(ПустаяСтрока(Задание.Наименование),
			Задание.Метаданные.Представление(), Задание.Наименование);
		СтрокаЗадания.Расписание = Строка(Задание.Расписание);
		ПоследнееЗадание = Задание.ПоследнееЗадание;
		Если ПоследнееЗадание <> Неопределено Тогда
			СтрокаЗадания.Начало = ПоследнееЗадание.Начало;
			СтрокаЗадания.Состояние = ПоследнееЗадание.Состояние;
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("Наименование");

	ДобавитьПараметр(Контекст, "Регламентных заданий всего / используется",
		СтрШаблон("%1 / %2", Задания.Количество(), Таблица.Количество()));
	ДобавитьТаблицу(Контекст, Таблица, "Используемые регламентные задания");

КонецПроцедуры

Процедура ДобавитьСведенияРасширений(Контекст)

	ДобавитьРаздел(Контекст, "Расширения конфигурации");

	Подключенные = Новый Соответствие;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.СеансАктивные) Цикл
		Подключенные.Вставить(Расширение.УникальныйИдентификатор, Истина);
	КонецЦикла;

	Таблица = НоваяТаблица("Имя|Имя;Синоним|Синоним;Версия|Версия;Активно|Активно;Подключено|Подключено в сеансе;"
		+ "БезопасныйРежим|Безопасный режим;Назначение|Назначение;ИзменяетСтруктуру|Изменяет структуру данных");
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		СтрокаРасширения = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРасширения, Расширение, "Имя, Синоним, Версия, Активно, БезопасныйРежим, Назначение");
		СтрокаРасширения.Подключено = (Подключенные[Расширение.УникальныйИдентификатор] = Истина);
		Попытка
			СтрокаРасширения.ИзменяетСтруктуру = Расширение.ИзменяетСтруктуруДанных();
		Исключение
			СтрокаРасширения.ИзменяетСтруктуру = Неопределено;
		КонецПопытки;
	КонецЦикла;

	ДобавитьТаблицу(Контекст, Таблица, "");

КонецПроцедуры

Процедура ДобавитьСведенияЖурналаРегистрации(Контекст)

	МаксимумЗаписей = 20000;
	ДобавитьРаздел(Контекст, "Ошибки журнала регистрации за сутки");

	Записи = Новый ТаблицаЗначений;
	// Журнал хранит время сервера, поэтому отбор по времени сервера.
	Отбор = Новый Структура("ДатаНачала, Уровень", ТекущаяДата() - 86400, УровеньЖурналаРегистрации.Ошибка);
	ВыгрузитьЖурналРегистрации(Записи, Отбор, "Дата,Событие,Комментарий", , МаксимумЗаписей);

	ДобавитьПараметр(Контекст, "Записей с уровнем Ошибка", Записи.Количество());
	Если Записи.Количество() >= МаксимумЗаписей Тогда
		ДобавитьПараметр(Контекст, "Ограничение", СтрШаблон("обработаны первые %1 записей", МаксимумЗаписей));
	КонецЕсли;

	Таблица = НоваяТаблица("Событие|Событие;Количество|Количество;Последнее|Последнее;Комментарий|Последний комментарий");
	Таблица.Индексы.Добавить("Событие");
	Для Каждого Запись Из Записи Цикл
		СтрокаСобытия = Таблица.Найти(Запись.Событие, "Событие");
		Если СтрокаСобытия = Неопределено Тогда
			СтрокаСобытия = Таблица.Добавить();
			СтрокаСобытия.Событие = Запись.Событие;
			СтрокаСобытия.Количество = 0;
		КонецЕсли;
		СтрокаСобытия.Количество = СтрокаСобытия.Количество + 1;
		// Записи выгружаются по возрастанию даты: последняя запись перезаписывает предыдущие.
		СтрокаСобытия.Последнее = Запись.Дата;
		СтрокаСобытия.Комментарий = Лев(Запись.Комментарий, 500);
	КонецЦикла;
	Таблица.Сортировать("Количество Убыв");

	ДобавитьТаблицу(Контекст, Таблица, "Ошибки по событиям", 50);

КонецПроцедуры

#КонецОбласти

#Область Кластер

Процедура ДобавитьСведенияКластера(Контекст, Параметры)

	ДобавитьРаздел(Контекст, "Кластер серверов 1С");

	АдресАгента = СокрЛП(Параметры.АдресАгента);
	Если ПустаяСтрока(АдресАгента) Тогда
		ДобавитьОшибку(Контекст, "Не указан адрес агента кластера.");
		Возврат;
	КонецЕсли;
	ДобавитьПараметр(Контекст, "Агент кластера", АдресАгента);

	Коннектор = Неопределено;
	ОшибкиСоздания = Новый Массив;
	Для Каждого ИмяКоннектора Из СтрРазделить("V83.COMConnector,V85.COMConnector,V82.COMConnector", ",") Цикл
		Попытка
			Коннектор = Новый COMОбъект(ИмяКоннектора);
			ДобавитьПараметр(Контекст, "COM-соединитель", ИмяКоннектора);
			Прервать;
		Исключение
			ОшибкиСоздания.Добавить(ИмяКоннектора + ": " + ТекстОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Если Коннектор = Неопределено Тогда
		// Сервер 1С работает службой под своим пользователем ОС: регистрация только для другого
		// пользователя (HKCU) ему не видна, нужна регистрация из консоли администратора (HKLM).
		ДобавитьОшибку(Контекст, СтрШаблон(
			"COM-соединитель не зарегистрирован для процесса сервера 1С (пользователь ОС: %1). "
				+ "Зарегистрируйте его в командной строке, запущенной от имени администратора: regsvr32 ""%2comcntr.dll"". "
				+ "Ошибки создания: %3",
			ИмяПользователяОССервера(), КаталогПрограммы(), СтрСоединить(ОшибкиСоздания, "; ")));
		Возврат;
	КонецЕсли;

	Попытка
		Агент = Коннектор.ConnectAgent(АдресАгента);
	Исключение
		ДобавитьОшибку(Контекст, "Не удалось подключиться к агенту кластера: " + ТекстОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Для Каждого Кластер Из Агент.GetClusters() Цикл
		ДобавитьСведенияОдногоКластера(Контекст, Агент, Кластер, Параметры);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСведенияОдногоКластера(Контекст, Агент, Кластер, Параметры)

	ДобавитьПодраздел(Контекст, СтрШаблон("Кластер ""%1"" (%2:%3)",
		ЗначениеCOM(Кластер, "ClusterName"), ЗначениеCOM(Кластер, "HostName"),
		ПредставлениеЗначения(ЗначениеCOM(Кластер, "MainPort"))));

	ДобавитьПараметрыИзТаблицы(Контекст, ТаблицаCOM(МассивИзОбъекта(Кластер),
		"SecurityLevel|Уровень безопасности соединений;"
		+ "LoadBalancingMode|Режим распределения нагрузки (0 - по производительности, 1 - по памяти);"
		+ "SessionFaultToleranceLevel|Уровень отказоустойчивости;"
		+ "LifeTimeLimit|Интервал перезапуска процессов, с;"
		+ "ExpirationTimeout|Принудительно завершать проблемные процессы через, с;"
		+ "KillProblemProcesses|Выключать процессы, превысившие лимиты;"
		+ "KillByMemoryWithDump|Дамп при превышении памяти;"
		+ "ErrorsCountThreshold|Порог ошибок сервера, %;"
		+ "MaxMemorySize|Допустимый объем памяти процессов (устаревшее), КБ;"
		+ "MaxMemoryTimeLimit|Интервал превышения памяти (устаревшее), с"));

	Попытка
		Агент.Authenticate(Кластер, Параметры.АдминистраторКластера, Параметры.ПарольАдминистратораКластера);
	Исключение
		ДобавитьОшибку(Контекст, "Ошибка аутентификации администратора кластера: " + ТекстОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ДобавитьТаблицу(Контекст, ТаблицаCOM(МассивАгента(Контекст, Агент, "GetClusterManagers", Кластер),
		"Descr|Менеджер;HostName|Сервер;MainPort|Порт;PID|PID;MainManager|Главный|Булево"),
		"Менеджеры кластера");

	ДобавитьТаблицу(Контекст, ТаблицаCOM(МассивАгента(Контекст, Агент, "GetWorkingServers", Кластер),
		"Name|Рабочий сервер;HostName|Компьютер;MainPort|Порт;MainServer|Центральный;"
		+ "InfoBasesPerWorkingProcessLimit|ИБ на процесс;ConnectionsPerWorkingProcessLimit|Соединений на процесс;"
		+ "WorkingProcessMemoryLimit|Временно допустимый объем памяти процесса, МБ|БвМБ;"
		+ "SafeWorkingProcessesMemoryLimit|Безопасный объем памяти процессов, МБ|БвМБ;"
		+ "SafeCallMemoryLimit|Безопасный расход памяти за вызов, МБ|БвМБ;"
		+ "CriticalProcessesTotalMemory|Критический объем памяти процессов, МБ|БвМБ;"
		+ "TemporaryAllowedProcessesTotalMemory|Временно допустимый объем памяти процессов, МБ|БвМБ;"
		+ "TemporaryAllowedProcessesTotalMemoryTimeLimit|Интервал превышения, с;"
		+ "DedicatedManagers|Менеджер под каждый сервис"),
		"Рабочие серверы (0 - без ограничения)");

	ДобавитьРабочиеПроцессы(Контекст, Агент, Кластер);

	Сеансы = МассивАгента(Контекст, Агент, "GetSessions", Кластер);
	ДобавитьИнформационныеБазыКластера(Контекст, Агент, Кластер, Сеансы);
	ДобавитьСеансыКластера(Контекст, Сеансы);
	ДобавитьЛицензииКластера(Контекст, Сеансы);

	Блокировки = МассивАгента(Контекст, Агент, "GetLocks", Кластер);
	Если Блокировки <> Неопределено Тогда
		ДобавитьПараметр(Контекст, "Блокировок объектов в кластере", Блокировки.Количество());
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьРабочиеПроцессы(Контекст, Агент, Кластер)

	Таблица = ТаблицаCOM(МассивАгента(Контекст, Агент, "GetWorkingProcesses", Кластер),
		"HostName|Компьютер;MainPort|Порт;PID|PID;Running|Запущен|Булево;Use|Использование;StartedAt|Время запуска;"
		+ "MemorySize|Память, МБ|КБвМБ;MemoryExcessTime|Превышение памяти, с;connections|Соединений;"
		+ "AvailablePerfomance|Доступная производительность;Capacity|Емкость;AvgThreads|Потоков (среднее);"
		+ "AvgCallTime|Время вызова, с;AvgServerCallTime|Время сервера, с;AvgDBCallTime|Время СУБД, с;"
		+ "AvgLockCallTime|Время блокировок, с");
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПроцесса Из Таблица Цикл
		Если ЧислоИлиНоль(СтрокаПроцесса.К8) > 0 Тогда
			ДобавитьЗамечание(Контекст, СтрШаблон(
				"Рабочий процесс PID %1 на %2 превышает допустимый объем памяти уже %3 с.",
				СтрокаПроцесса.К3, СтрокаПроцесса.К1, СтрокаПроцесса.К8));
		КонецЕсли;
	КонецЦикла;

	ДобавитьТаблицу(Контекст, Таблица, "Рабочие процессы");

КонецПроцедуры

Процедура ДобавитьИнформационныеБазыКластера(Контекст, Агент, Кластер, Сеансы)

	СеансовПоБазам = Новый Соответствие;
	Если Сеансы <> Неопределено Тогда
		Для Каждого Сеанс Из Сеансы Цикл
			ИмяБазы = ЗначениеCOM(Сеанс, "infoBase.Name");
			СеансовПоБазам.Вставить(ИмяБазы, ЧислоИлиНоль(СеансовПоБазам[ИмяБазы]) + 1);
		КонецЦикла;
	КонецЕсли;

	Таблица = ТаблицаCOM(МассивАгента(Контекст, Агент, "GetInfoBases", Кластер), "Name|Информационная база;Descr|Описание");
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Таблица.Колонки.Добавить("К3", , "Сеансов");
	Для Каждого СтрокаБазы Из Таблица Цикл
		СтрокаБазы.К3 = ЧислоИлиНоль(СеансовПоБазам[СтрокаБазы.К1]);
	КонецЦикла;
	Таблица.Сортировать("К1");

	ДобавитьТаблицу(Контекст, Таблица, "Информационные базы кластера");

КонецПроцедуры

Процедура ДобавитьСеансыКластера(Контекст, Сеансы)

	Таблица = ТаблицаCOM(Сеансы,
		"infoBase.Name|База;SessionID|Сеанс;AppID|Приложение;userName|Пользователь;Host|Компьютер;"
		+ "StartedAt|Начало;LastActiveAt|Активность;MemoryCurrent|Память сейчас, МБ|БвМБ;"
		+ "cpuTimeLast5Min|Процессор за 5 мин, мс;dbmsBytesLast5Min|Данные СУБД за 5 мин, МБ|БвМБ;"
		+ "durationCurrentDBMS|Текущий вызов СУБД, мс;blockedByDBMS|Ждет сеанс (СУБД);blockedByLS|Ждет сеанс (1С)");
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДобавитьПараметр(Контекст, "Сеансов в кластере", Таблица.Количество());

	Итоги = Таблица.Скопировать(, "К1, К3");
	Итоги.Колонки.Добавить("Количество", , "Сеансов");
	Итоги.ЗаполнитьЗначения(1, "Количество");
	Итоги.Свернуть("К1, К3", "Количество");
	Итоги.Сортировать("К1, Количество Убыв");
	ДобавитьТаблицу(Контекст, Итоги, "Сеансы кластера по базам и приложениям");

	Для Каждого СтрокаСеанса Из Таблица Цикл
		Если ЧислоИлиНоль(СтрокаСеанса.К12) <> 0 Или ЧислоИлиНоль(СтрокаСеанса.К13) <> 0 Тогда
			ДобавитьЗамечание(Контекст, СтрШаблон(
				"Сеанс %1 базы %2 (%3) ожидает блокировку: СУБД - сеанс %4, 1С - сеанс %5.",
				СтрокаСеанса.К2, СтрокаСеанса.К1, СтрокаСеанса.К4, СтрокаСеанса.К12, СтрокаСеанса.К13));
		КонецЕсли;
	КонецЦикла;

	Таблица.Сортировать("К9 Убыв");
	ДобавитьТаблицу(Контекст, Таблица, "Сеансы кластера с наибольшей загрузкой процессора за 5 минут", 20);

КонецПроцедуры

Процедура ДобавитьЛицензииКластера(Контекст, Сеансы)

	Если Сеансы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Таблица = НоваяТаблица("Лицензия|Лицензия;Сервер|Выдана сервером;Количество|Сеансов");
	Для Каждого Сеанс Из Сеансы Цикл
		Лицензия = ЗначениеCOM(Сеанс, "License");
		Если Лицензия = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЛицензии = Таблица.Добавить();
		СтрокаЛицензии.Лицензия = ЗначениеCOM(Лицензия, "ShortPresentation");
		Если Не ЗначениеЗаполнено(СтрокаЛицензии.Лицензия) Тогда
			СтрокаЛицензии.Лицензия = ЗначениеCOM(Лицензия, "FullPresentation");
		КонецЕсли;
		СтрокаЛицензии.Сервер = ЗначениеCOM(Лицензия, "IssuedByServer");
		СтрокаЛицензии.Количество = 1;
	КонецЦикла;
	Таблица.Свернуть("Лицензия, Сервер", "Количество");
	Таблица.Сортировать("Количество Убыв");

	ДобавитьТаблицу(Контекст, Таблица, "Лицензии сеансов кластера");

КонецПроцедуры

// Вызывает метод агента кластера с параметром-кластером и возвращает результат массивом.
// При ошибке выводит ее в отчет и возвращает Неопределено.
//
Функция МассивАгента(Контекст, Агент, ИмяМетода, Кластер)

	Попытка
		// Имя метода - константа из кода обработки.
		Результат = Вычислить("Агент." + ИмяМетода + "(Кластер)");
	Исключение
		ДобавитьОшибку(Контекст, ИмяМетода + ": " + ТекстОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

	Массив = Новый Массив;
	Для Каждого Элемент Из Результат Цикл
		Массив.Добавить(Элемент);
	КонецЦикла;

	Возврат Массив;

КонецФункции

Функция МассивИзОбъекта(Объект)

	Массив = Новый Массив;
	Массив.Добавить(Объект);
	Возврат Массив;

КонецФункции

#КонецОбласти

#Область ТаблицыCOM

// Читает объекты WMI запросом в таблицу.
//
// Параметры:
//  Контекст - Структура - контекст отчета, сюда выводится ошибка запроса.
//  СлужбаWMI - COMОбъект - SWbemServices.
//  ТекстЗапроса - Строка - запрос WQL.
//  ОписаниеКолонок - Строка - см. ТаблицаCOM.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - Неопределено при ошибке запроса.
//
Функция ТаблицаWMI(Контекст, СлужбаWMI, ТекстЗапроса, ОписаниеКолонок)

	Попытка
		Объекты = Новый Массив;
		Для Каждого ОбъектWMI Из СлужбаWMI.ExecQuery(ТекстЗапроса) Цикл
			Объекты.Добавить(ОбъектWMI);
		КонецЦикла;
	Исключение
		ДобавитьОшибку(Контекст, СтрШаблон("WMI %1: %2",
			СокрЛП(СтрЗаменить(ТекстЗапроса, Символы.ПС, " ")), ТекстОшибки(ИнформацияОбОшибке())));
		Возврат Неопределено;
	КонецПопытки;

	Возврат ТаблицаCOM(Объекты, ОписаниеКолонок);

КонецФункции

// Читает свойства COM-объектов в таблицу. Отсутствующее свойство дает пустое значение.
//
// Параметры:
//  Объекты - Массив, Неопределено - COM-объекты.
//  ОписаниеКолонок - Строка - колонки через ";" в формате Свойство|Заголовок[|Преобразование],
//    свойство может быть составным (infoBase.Name). Колонки таблицы называются К1, К2, ...
//    Преобразования: БвМБ, БвГБ, КБвМБ, ДатаWMI, Булево, Массив.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - Неопределено, если Объекты не заданы.
//
Функция ТаблицаCOM(Объекты, ОписаниеКолонок)

	Если Объекты = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Колонки = Новый Массив;
	Таблица = Новый ТаблицаЗначений;
	Для Каждого ОписаниеКолонки Из СтрРазделить(ОписаниеКолонок, ";", Ложь) Цикл
		Части = СтрРазделить(ОписаниеКолонки, "|");
		Колонка = Новый Структура("Свойство, Имя, Преобразование", СокрЛП(Части[0]),
			"К" + Формат(Колонки.Количество() + 1, "ЧГ=0"), ?(Части.Количество() > 2, Части[2], ""));
		Колонки.Добавить(Колонка);
		Таблица.Колонки.Добавить(Колонка.Имя, , Части[1]);
	КонецЦикла;

	Для Каждого Объект Из Объекты Цикл
		НоваяСтрока = Таблица.Добавить();
		Для Каждого Колонка Из Колонки Цикл
			НоваяСтрока[Колонка.Имя] = ПреобразоватьЗначениеCOM(ЗначениеCOM(Объект, Колонка.Свойство), Колонка.Преобразование);
		КонецЦикла;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Возвращает свойство COM-объекта или Неопределено, если свойства нет в этой версии.
Функция ЗначениеCOM(Объект, ИмяСвойства)

	Попытка
		// Имя свойства - константа из кода обработки.
		Возврат Вычислить("Объект." + ИмяСвойства);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПреобразоватьЗначениеCOM(Значение, Преобразование)

	Если Значение = Неопределено Или Значение = NULL Или ПустаяСтрока(Преобразование) Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Если Преобразование = "БвМБ" Тогда
			// Числа uint64 WMI передает строкой.
			Возврат Окр(Число(Значение) / 1048576, 0);
		ИначеЕсли Преобразование = "БвГБ" Тогда
			Возврат Окр(Число(Значение) / 1073741824, 1);
		ИначеЕсли Преобразование = "КБвМБ" Тогда
			Возврат Окр(Число(Значение) / 1024, 0);
		ИначеЕсли Преобразование = "ДатаWMI" Тогда
			// Формат CIM_DATETIME: ГГГГММДДЧЧММСС.мммммм+ЗЗЗ
			Возврат Дата(Лев(Значение, 14));
		ИначеЕсли Преобразование = "Булево" Тогда
			Возврат Число(Значение) <> 0;
		ИначеЕсли Преобразование = "Массив" Тогда
			Массив = Новый Массив;
			Для Каждого Элемент Из Значение.Выгрузить() Цикл
				Массив.Добавить(Строка(Элемент));
			КонецЦикла;
			Возврат Массив;
		КонецЕсли;
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;

	Возврат Значение;

КонецФункции

#КонецОбласти

#Область ВыводОтчета

Процедура ДобавитьБлок(Контекст, Вид, Заголовок, Значение = Неопределено, МаксимумСтрок = 0)

	Контекст.Блоки.Добавить(Новый Структура("Вид, Заголовок, Значение, МаксимумСтрок",
		Вид, Заголовок, Значение, МаксимумСтрок));

КонецПроцедуры

Процедура ДобавитьРаздел(Контекст, Заголовок)
	ДобавитьБлок(Контекст, "Раздел", Заголовок);
КонецПроцедуры

Процедура ДобавитьПодраздел(Контекст, Заголовок)
	ДобавитьБлок(Контекст, "Подраздел", Заголовок);
КонецПроцедуры

Процедура ДобавитьПараметр(Контекст, Имя, Значение)
	ДобавитьБлок(Контекст, "Параметр", Имя, Значение);
КонецПроцедуры

Процедура ДобавитьТекст(Контекст, Текст)
	ДобавитьБлок(Контекст, "Текст", "", Текст);
КонецПроцедуры

Процедура ДобавитьОшибку(Контекст, Текст)
	ДобавитьБлок(Контекст, "Ошибка", "", Текст);
КонецПроцедуры

Процедура ДобавитьТаблицу(Контекст, Таблица, Заголовок, МаксимумСтрок = 0)

	Если Таблица <> Неопределено Тогда
		ДобавитьБлок(Контекст, "Таблица", Заголовок, Таблица, МаксимумСтрок);
	КонецЕсли;

КонецПроцедуры

// Выводит каждую колонку первой строки таблицы как параметр отчета.
Процедура ДобавитьПараметрыИзТаблицы(Контекст, Таблица)

	Если Таблица = Неопределено Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Колонка Из Таблица.Колонки Цикл
		ДобавитьПараметр(Контекст, Колонка.Заголовок, Таблица[0][Колонка.Имя]);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗамечание(Контекст, Текст)
	Контекст.Замечания.Добавить(Текст);
КонецПроцедуры

Процедура ДобавитьОшибкуРаздела(Контекст, ИмяРаздела, ИнформацияОбОшибке)

	Текст = СтрШаблон("Раздел ""%1"" собран не полностью: %2", ИмяРаздела, ТекстОшибки(ИнформацияОбОшибке));
	ДобавитьОшибку(Контекст, Текст);
	ДобавитьЗамечание(Контекст, Текст);

КонецПроцедуры

Процедура ПроверитьОстатокРесурса(Контекст, Ресурс, Свободно, Всего, ПорогПроцентов)

	Если ТипЗнч(Свободно) <> Тип("Число") Или ТипЗнч(Всего) <> Тип("Число") Или Всего = 0 Тогда
		Возврат;
	КонецЕсли;

	Процент = Окр(Свободно / Всего * 100, 1);
	Если Процент < ПорогПроцентов Тогда
		ДобавитьЗамечание(Контекст, СтрШаблон("%1 осталось %2 процентов (%3 из %4).", Ресурс, Процент, Свободно, Всего));
	КонецЕсли;

КонецПроцедуры

Функция ТабличныйДокументОтчета(Контекст)

	Документ = Новый ТабличныйДокумент;
	Документ.Область(, 1, , 1).ШиринаКолонки = 45;
	Для НомерКолонки = 2 По 20 Цикл
		Документ.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки = 16;
	КонецЦикла;

	НомерСтроки = 1;
	Область = ВывестиЯчейку(Документ, НомерСтроки, 1, "Сведения о сервере 1С", 8);
	Область.Шрифт = Новый Шрифт(, 14, Истина);
	НомерСтроки = НомерСтроки + 1;
	ВывестиЯчейку(Документ, НомерСтроки, 1, "Сформирован: " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"), 8);
	НомерСтроки = НомерСтроки + 2;

	Область = ВывестиЯчейку(Документ, НомерСтроки, 1, "Замечания", 8);
	Область.Шрифт = Новый Шрифт(, 12, Истина);
	НомерСтроки = НомерСтроки + 1;
	Если Контекст.Замечания.Количество() = 0 Тогда
		ВывестиЯчейку(Документ, НомерСтроки, 1, "Замечаний нет", 8);
		НомерСтроки = НомерСтроки + 1;
	КонецЕсли;
	Для Каждого Замечание Из Контекст.Замечания Цикл
		Область = ВывестиЯчейку(Документ, НомерСтроки, 1, "- " + Замечание, 8);
		Область.ЦветТекста = ЦветОшибки();
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Для Каждого Блок Из Контекст.Блоки Цикл
		НомерСтроки = ВывестиБлок(Документ, НомерСтроки, Блок);
	КонецЦикла;

	Возврат Документ;

КонецФункции

Функция ВывестиБлок(Документ, Знач НомерСтроки, Блок)

	Если Блок.Вид = "Раздел" Тогда
		НомерСтроки = НомерСтроки + 1;
		Область = ВывестиЯчейку(Документ, НомерСтроки, 1, Блок.Заголовок, 8);
		Область.Шрифт = Новый Шрифт(, 12, Истина);
		Область.ЦветФона = Новый Цвет(221, 235, 247);
		НомерСтроки = НомерСтроки + 1;

	ИначеЕсли Блок.Вид = "Подраздел" Тогда
		Область = ВывестиЯчейку(Документ, НомерСтроки, 1, Блок.Заголовок, 8);
		Область.Шрифт = Новый Шрифт(, , Истина);
		НомерСтроки = НомерСтроки + 1;

	ИначеЕсли Блок.Вид = "Параметр" Тогда
		ВывестиЯчейку(Документ, НомерСтроки, 1, Блок.Заголовок);
		ВывестиЯчейку(Документ, НомерСтроки, 2, Блок.Значение, 8);
		НомерСтроки = НомерСтроки + 1;

	ИначеЕсли Блок.Вид = "Текст" Тогда
		Область = ВывестиЯчейку(Документ, НомерСтроки, 1, Блок.Значение, 8);
		Область.Шрифт = Новый Шрифт("Courier New", 9);
		НомерСтроки = НомерСтроки + 2;

	ИначеЕсли Блок.Вид = "Ошибка" Тогда
		Область = ВывестиЯчейку(Документ, НомерСтроки, 1, Блок.Значение, 8);
		Область.ЦветТекста = ЦветОшибки();
		НомерСтроки = НомерСтроки + 1;

	ИначеЕсли Блок.Вид = "Таблица" Тогда
		НомерСтроки = ВывестиТаблицу(Документ, НомерСтроки, Блок);
	КонецЕсли;

	Возврат НомерСтроки;

КонецФункции

Функция ВывестиТаблицу(Документ, Знач НомерСтроки, Блок)

	Таблица = Блок.Значение;
	Если Не ПустаяСтрока(Блок.Заголовок) Тогда
		НомерСтроки = НомерСтроки + 1;
		Область = ВывестиЯчейку(Документ, НомерСтроки, 1, Блок.Заголовок, 8);
		Область.Шрифт = Новый Шрифт(, , Истина);
		НомерСтроки = НомерСтроки + 1;
	КонецЕсли;

	Если Таблица.Количество() = 0 Тогда
		ВывестиЯчейку(Документ, НомерСтроки, 1, "нет данных");
		Возврат НомерСтроки + 1;
	КонецЕсли;

	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	ЦветШапки = Новый Цвет(242, 242, 242);

	НомерКолонки = 1;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Область = ВывестиЯчейку(Документ, НомерСтроки, НомерКолонки, Колонка.Заголовок);
		Область.Шрифт = Новый Шрифт(, , Истина);
		Область.ЦветФона = ЦветШапки;
		Область.Обвести(Линия, Линия, Линия, Линия);
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	Выведено = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Блок.МаксимумСтрок > 0 И Выведено >= Блок.МаксимумСтрок Тогда
			ВывестиЯчейку(Документ, НомерСтроки, 1,
				СтрШаблон("... показано %1 строк из %2", Выведено, Таблица.Количество()), 8);
			НомерСтроки = НомерСтроки + 1;
			Прервать;
		КонецЕсли;
		НомерКолонки = 1;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Область = ВывестиЯчейку(Документ, НомерСтроки, НомерКолонки, СтрокаТаблицы[Колонка.Имя]);
			Область.Обвести(Линия, Линия, Линия, Линия);
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
		Выведено = Выведено + 1;
	КонецЦикла;

	Возврат НомерСтроки;

КонецФункции

Функция ВывестиЯчейку(Документ, НомерСтроки, НомерКолонки, Значение, КонечнаяКолонка = 0)

	Если КонечнаяКолонка > НомерКолонки Тогда
		Область = Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, КонечнаяКолонка);
		Область.Объединить();
	Иначе
		Область = Документ.Область(НомерСтроки, НомерКолонки);
	КонецЕсли;

	Область.Текст = ПредставлениеЗначения(Значение);
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.ВертикальноеПоложение = ВертикальноеПоложение.Верх;

	Возврат Область;

КонецФункции

Функция ПредставлениеЗначения(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат "";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Окр(Значение, 3), "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=DT");
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Представления = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Представления.Добавить(ПредставлениеЗначения(Элемент));
		КонецЦикла;
		Возврат СтрСоединить(Представления, ", ");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция ЦветОшибки()
	Возврат Новый Цвет(192, 0, 0);
КонецФункции

