Функция НоваяТаблица(ОписаниеКолонок)

	Таблица = Новый ТаблицаЗначений;
	Для Каждого ОписаниеКолонки Из СтрРазделить(ОписаниеКолонок, ";", Ложь) Цикл
		Части = СтрРазделить(ОписаниеКолонки, "|");
		Таблица.Колонки.Добавить(СокрЛП(Части[0]), , Части[1]);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ЭтоФайловаяБаза(СтрокаСоединения)
	Возврат СтрНайти(ВРег(СтрокаСоединения), "FILE=") = 1;
КонецФункции

Функция ЗначениеИзСтрокиСоединения(СтрокаСоединения, Ключ)

	Для Каждого Часть Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл
		ПозицияРавно = СтрНайти(Часть, "=");
		Если ПозицияРавно > 0 И ВРег(СокрЛП(Лев(Часть, ПозицияРавно - 1))) = ВРег(Ключ) Тогда
			Возврат СтрЗаменить(СокрЛП(Сред(Часть, ПозицияРавно + 1)), """", "");
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

