// Описание: Возвращает параметры регистрации обработки в подсистеме "Дополнительные отчеты и обработки".
// Обработка регистрируется как глобальная дополнительная обработка с открытием собственной формы.
//
// Возвращаемое значение:
//  Структура - параметры регистрации внешней обработки для БСП
//
Функция СведенияОВнешнейОбработке() Экспорт

    ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
    ПараметрыРегистрации.Вид             = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
    ПараметрыРегистрации.Наименование    = НСтр("ru = 'Перенос запросов к данным'");
    ПараметрыРегистрации.Версия          = ВерсияОбработки();
    ПараметрыРегистрации.БезопасныйРежим = Истина;
    ПараметрыРегистрации.Информация      = НСтр("ru = 'Выгрузка и загрузка элементов справочника ""Запросы к данным"" в формате JSON.'");

    Команда = ПараметрыРегистрации.Команды.Добавить();
    Команда.Представление        = НСтр("ru = 'Перенос запросов к данным'");
    Команда.Идентификатор        = ЭтотОбъект.Метаданные().Имя;
    Команда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
    Команда.ПоказыватьОповещение = Ложь;

    Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Версия обработки. Пишется в файл выгрузки и в карточку дополнительной обработки.
//
// Возвращаемое значение:
//  Строка - версия в формате "1.0"
//
Функция ВерсияОбработки() Экспорт

    Возврат "1.0";

КонецФункции

// Описание: Возвращает список элементов справочника "Запросы к данным" для отображения на форме.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Пометка, Ссылка, Наименование, КодЗапроса, Параметров
//
Функция ТаблицаЗапросовКДанным() Экспорт

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Запросы.Ссылка КАК Ссылка,
    |    Запросы.Наименование КАК Наименование,
    |    Запросы.КодЗапроса КАК КодЗапроса,
    |    КОЛИЧЕСТВО(ПараметрыЗапроса.НомерСтроки) КАК Параметров
    |ИЗ
    |    Справочник.ЗапросыКДанным КАК Запросы
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗапросыКДанным.Параметры КАК ПараметрыЗапроса
    |        ПО Запросы.Ссылка = ПараметрыЗапроса.Ссылка
    |СГРУППИРОВАТЬ ПО
    |    Запросы.Ссылка,
    |    Запросы.Наименование,
    |    Запросы.КодЗапроса
    |УПОРЯДОЧИТЬ ПО
    |    Запросы.Наименование";

    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
    Таблица.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.ЗапросыКДанным"));
    Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("КодЗапроса", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("Параметров", Новый ОписаниеТипов("Число"));

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        НоваяСтрока = Таблица.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
    КонецЦикла;

    Возврат Таблица;

КонецФункции

// Описание: Формирует текст JSON по списку элементов справочника "Запросы к данным".
//
// Параметры:
//  МассивСсылок - Массив из СправочникСсылка.ЗапросыКДанным - выгружаемые элементы
//
// Возвращаемое значение:
//  Структура - результат выгрузки:
//   * ТекстJSON - Строка - содержимое файла
//   * Протокол  - Массив из Строка - сообщения о ходе выгрузки
//   * Выгружено - Число - количество выгруженных элементов
//
Функция ВыгрузитьЭлементы(МассивСсылок) Экспорт

    Протокол = Новый Массив;

    МассивЭлементов = Новый Массив;
    Для Каждого Ссылка Из МассивСсылок Цикл

        Если Не ЗначениеЗаполнено(Ссылка) Тогда
            Протокол.Добавить(НСтр("ru = 'Пропущена пустая ссылка.'"));
            Продолжить;
        КонецЕсли;

        ОбъектСправочника = Ссылка.ПолучитьОбъект();
        Если ОбъектСправочника = Неопределено Тогда
            Протокол.Добавить(СтрШаблон(НСтр("ru = 'Элемент %1 не найден в базе, пропущен.'"), Строка(Ссылка)));
            Продолжить;
        КонецЕсли;

        МассивЭлементов.Добавить(ДанныеЭлементаДляВыгрузки(ОбъектСправочника));
        Протокол.Добавить(СтрШаблон(НСтр("ru = 'Выгружен элемент ""%1"" (параметров: %2).'"),
            ОбъектСправочника.Наименование, Формат(ОбъектСправочника.Параметры.Количество(), "ЧН=0; ЧГ=")));

    КонецЦикла;

    СтруктураВыгрузки = Новый Структура;
    СтруктураВыгрузки.Вставить("ФорматВыгрузки", ИмяФормата());
    СтруктураВыгрузки.Вставить("ВерсияФормата", ВерсияФормата());
    СтруктураВыгрузки.Вставить("ВерсияОбработки", ВерсияОбработки());
    СтруктураВыгрузки.Вставить("ДатаВыгрузки", XMLСтрока(ТекущаяДатаСеанса()));
    СтруктураВыгрузки.Вставить("Источник", ОписаниеИсточника());
    СтруктураВыгрузки.Вставить("Элементы", МассивЭлементов);

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
    ЗаписатьJSON(ЗаписьJSON, СтруктураВыгрузки);

    Результат = Новый Структура;
    Результат.Вставить("ТекстJSON", ЗаписьJSON.Закрыть());
    Результат.Вставить("Протокол", Протокол);
    Результат.Вставить("Выгружено", МассивЭлементов.Количество());

    Возврат Результат;

КонецФункции

// Описание: Разбирает текст файла выгрузки и проверяет его формат.
//
// Параметры:
//  ТекстJSON - Строка - содержимое файла выгрузки
//
// Возвращаемое значение:
//  Структура - результат разбора:
//   * Успешно        - Булево - файл прочитан и соответствует формату
//   * ОписаниеОшибки - Строка - причина отказа
//   * Данные         - Соответствие, Неопределено - разобранное содержимое файла
//   * Протокол       - Массив из Строка - замечания к файлу
//
Функция ПрочитатьДанныеВыгрузки(ТекстJSON) Экспорт

    Результат = Новый Структура;
    Результат.Вставить("Успешно", Ложь);
    Результат.Вставить("ОписаниеОшибки", "");
    Результат.Вставить("Данные", Неопределено);
    Результат.Вставить("Протокол", Новый Массив);

    Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
        Результат.ОписаниеОшибки = НСтр("ru = 'Файл пустой.'");
        Возврат Результат;
    КонецЕсли;

    // Содержимое файла приходит извне, ошибка разбора не может быть предсказана проверками.
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТекстJSON);
        Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
        ЧтениеJSON.Закрыть();
    Исключение
        Результат.ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Не удалось разобрать JSON: %1'"), ОписаниеОшибки());
        Возврат Результат;
    КонецПопытки;

    Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
        Результат.ОписаниеОшибки = НСтр("ru = 'Ожидалась структура выгрузки, в файле данные другого вида.'");
        Возврат Результат;
    КонецЕсли;

    Если ЗначениеИзСоответствия(Данные, "ФорматВыгрузки", "") <> ИмяФормата() Тогда
        Результат.ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Файл не является выгрузкой запросов к данным (ожидался формат ""%1"").'"),
            ИмяФормата());
        Возврат Результат;
    КонецЕсли;

    Элементы = ЗначениеИзСоответствия(Данные, "Элементы", Неопределено);
    Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
        Результат.ОписаниеОшибки = НСтр("ru = 'В файле отсутствует список элементов.'");
        Возврат Результат;
    КонецЕсли;

    Источник = ЗначениеИзСоответствия(Данные, "Источник", Неопределено);
    Если ТипЗнч(Источник) = Тип("Соответствие") Тогда
        ИмяКонфигурацииИсточника = ЗначениеИзСоответствия(Источник, "ИмяКонфигурации", "");
        Если ЗначениеЗаполнено(ИмяКонфигурацииИсточника) И ИмяКонфигурацииИсточника <> Метаданные.Имя Тогда
            Результат.Протокол.Добавить(СтрШаблон(
                НСтр("ru = 'Внимание: файл выгружен из конфигурации ""%1"", текущая конфигурация — ""%2"". Значения параметров ссылочных типов перенести не удастся.'"),
                ИмяКонфигурацииИсточника, Метаданные.Имя));
        КонецЕсли;
    КонецЕсли;

    Результат.Протокол.Добавить(СтрШаблон(НСтр("ru = 'В файле элементов: %1.'"),
        Формат(Элементы.Количество(), "ЧН=0; ЧГ=")));

    Результат.Успешно = Истина;
    Результат.Данные  = Данные;

    Возврат Результат;

КонецФункции

// Описание: Готовит перечень изменений, которые внесёт загрузка файла, без записи в базу.
//
// Параметры:
//  ДанныеВыгрузки - Соответствие - разобранное содержимое файла
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Элемент, Действие, Поле, ЗначениеВБазе, ЗначениеВФайле
//
Функция ТаблицаСравнения(ДанныеВыгрузки) Экспорт

    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Элемент", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("Действие", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("Поле", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("ЗначениеВБазе", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));

    Для Каждого ДанныеЭлемента Из ЗначениеИзСоответствия(ДанныеВыгрузки, "Элементы", Новый Массив) Цикл

        Если ТипЗнч(ДанныеЭлемента) <> Тип("Соответствие") Тогда
            Продолжить;
        КонецЕсли;

        ПредставлениеЭлемента = ПредставлениеЭлементаФайла(ДанныеЭлемента);
        СуществующаяСсылка    = НайтиЭлементПоДанным(ДанныеЭлемента);

        Если Не ЗначениеЗаполнено(СуществующаяСсылка) Тогда
            ДобавитьСтрокуСравнения(Таблица, ПредставлениеЭлемента, НСтр("ru = 'Создание'"), "", "",
                СтрШаблон(НСтр("ru = 'Новый элемент, параметров: %1'"),
                    Формат(МассивПараметровФайла(ДанныеЭлемента).Количество(), "ЧН=0; ЧГ=")));
            Продолжить;
        КонецЕсли;

        ОбъектВБазе = СуществующаяСсылка.ПолучитьОбъект();
        ЕстьРазличия = Ложь;

        Для Каждого ИмяРеквизита Из ИменаСравниваемыхРеквизитов() Цикл
            ЗначениеВФайле = ЗначениеИзСоответствия(ДанныеЭлемента, ИмяРеквизита, "");
            ЗначениеВБазе  = ОбъектВБазе[ИмяРеквизита];
            Если Строка(ЗначениеВБазе) <> Строка(ЗначениеВФайле) Тогда
                ДобавитьСтрокуСравнения(Таблица, ПредставлениеЭлемента, НСтр("ru = 'Обновление'"), ИмяРеквизита,
                    Строка(ЗначениеВБазе), Строка(ЗначениеВФайле));
                ЕстьРазличия = Истина;
            КонецЕсли;
        КонецЦикла;

        ЕстьРазличияПараметров = ДобавитьСравнениеПараметров(Таблица, ПредставлениеЭлемента, ОбъектВБазе, ДанныеЭлемента);
        ЕстьРазличия = ЕстьРазличия Или ЕстьРазличияПараметров;

        Если Не ЕстьРазличия Тогда
            ДобавитьСтрокуСравнения(Таблица, ПредставлениеЭлемента, НСтр("ru = 'Без изменений'"), "", "", "");
        КонецЕсли;

    КонецЦикла;

    Возврат Таблица;

КонецФункции

// Описание: Записывает содержимое файла выгрузки в справочник "Запросы к данным".
// Существующие элементы обновляются целиком, включая табличную часть параметров.
//
// Параметры:
//  ДанныеВыгрузки - Соответствие - разобранное содержимое файла
//
// Возвращаемое значение:
//  Структура - итог загрузки:
//   * Протокол  - Массив из Строка - построчный отчёт
//   * Создано   - Число
//   * Обновлено - Число
//   * Ошибок    - Число
//
Функция ЗагрузитьЭлементы(ДанныеВыгрузки) Экспорт

    Результат = Новый Структура;
    Результат.Вставить("Протокол", Новый Массив);
    Результат.Вставить("Создано", 0);
    Результат.Вставить("Обновлено", 0);
    Результат.Вставить("Ошибок", 0);

    Для Каждого ДанныеЭлемента Из ЗначениеИзСоответствия(ДанныеВыгрузки, "Элементы", Новый Массив) Цикл

        Если ТипЗнч(ДанныеЭлемента) <> Тип("Соответствие") Тогда
            Результат.Ошибок = Результат.Ошибок + 1;
            Результат.Протокол.Добавить(НСтр("ru = 'Пропущен элемент файла: неверная структура данных.'"));
            Продолжить;
        КонецЕсли;

        ЗагрузитьОдинЭлемент(ДанныеЭлемента, Результат);

    КонецЦикла;

    Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяФормата()

    Возврат "ЗапросыКДанным";

КонецФункции

Функция ВерсияФормата()

    Возврат "1.0";

КонецФункции

Функция ИменаСравниваемыхРеквизитов()

    Реквизиты = Новый Массив;
    Реквизиты.Добавить("Код");
    Реквизиты.Добавить("Наименование");
    Реквизиты.Добавить("КодЗапроса");
    Реквизиты.Добавить("ТекстЗапроса");

    Возврат Реквизиты;

КонецФункции

Функция ОписаниеИсточника()

    Описание = Новый Структура;
    Описание.Вставить("ИмяКонфигурации", Метаданные.Имя);
    Описание.Вставить("СинонимКонфигурации", Метаданные.Синоним);
    Описание.Вставить("ВерсияКонфигурации", Метаданные.Версия);

    Возврат Описание;

КонецФункции

// Описание: Собирает структуру данных одного элемента справочника для записи в JSON.
//
// Параметры:
//  ОбъектСправочника - СправочникОбъект.ЗапросыКДанным - выгружаемый элемент
//
// Возвращаемое значение:
//  Структура - данные элемента в формате выгрузки
//
Функция ДанныеЭлементаДляВыгрузки(ОбъектСправочника)

    ДанныеЭлемента = Новый Структура;
    ДанныеЭлемента.Вставить("УникальныйИдентификатор", Строка(ОбъектСправочника.Ссылка.УникальныйИдентификатор()));
    ДанныеЭлемента.Вставить("Код", ОбъектСправочника.Код);
    ДанныеЭлемента.Вставить("Наименование", ОбъектСправочника.Наименование);
    ДанныеЭлемента.Вставить("КодЗапроса", ОбъектСправочника.КодЗапроса);
    ДанныеЭлемента.Вставить("ТекстЗапроса", ОбъектСправочника.ТекстЗапроса);
    ДанныеЭлемента.Вставить("ПометкаУдаления", ОбъектСправочника.ПометкаУдаления);
    ДанныеЭлемента.Вставить("ДоступныеТипыДанных", ОписаниеЗначения(ОбъектСправочника.ДоступныеТипыДанных));

    МассивПараметров = Новый Массив;
    Для Каждого СтрокаПараметра Из ОбъектСправочника.Параметры Цикл

        ДанныеПараметра = Новый Структура;
        ДанныеПараметра.Вставить("НомерСтроки", СтрокаПараметра.НомерСтроки);
        ДанныеПараметра.Вставить("Имя", СтрокаПараметра.Имя);
        ДанныеПараметра.Вставить("Тип", СтрокаПараметра.Тип);
        ДанныеПараметра.Вставить("Внешний", СтрокаПараметра.Внешний);
        ДанныеПараметра.Вставить("Идентификатор", Строка(СтрокаПараметра.Идентификатор));
        ДанныеПараметра.Вставить("ЗначениеВнутреннее", СтрокаПараметра.Значение);
        ДанныеПараметра.Вставить("ЗначениеОписание", ОписаниеЗначенияИзВнутреннего(СтрокаПараметра.Значение));

        МассивПараметров.Добавить(ДанныеПараметра);

    КонецЦикла;

    ДанныеЭлемента.Вставить("Параметры", МассивПараметров);

    Возврат ДанныеЭлемента;

КонецФункции

// Описание: Формирует пару "внутреннее представление + разобранное описание" для произвольного значения.
//
// Параметры:
//  Значение - Произвольный - сериализуемое значение
//
// Возвращаемое значение:
//  Структура - ЗначениеВнутреннее (Строка) и Описание (Структура)
//
Функция ОписаниеЗначения(Значение)

    Результат = Новый Структура;
    Результат.Вставить("ЗначениеВнутреннее", ЗначениеВСтрокуВнутр(Значение));
    Результат.Вставить("Описание", РазобратьЗначение(Значение));

    Возврат Результат;

КонецФункции

// Описание: Разбирает значение, хранящееся во внутреннем формате платформы, в понятное описание.
// Если строка не читается текущей конфигурацией, возвращается описание с признаком ошибки —
// сама выгрузка при этом не прерывается.
//
// Параметры:
//  ВнутреннееПредставление - Строка - значение в формате ЗначениеВСтрокуВнутр
//
// Возвращаемое значение:
//  Структура - описание значения
//
Функция ОписаниеЗначенияИзВнутреннего(ВнутреннееПредставление)

    Если Не ЗначениеЗаполнено(ВнутреннееПредставление) Тогда
        Возврат РазобратьЗначение(Неопределено);
    КонецЕсли;

    // Реквизит заполняется внешними механизмами, содержимое строки заранее не известно.
    Попытка
        Значение = ЗначениеИзСтрокиВнутр(ВнутреннееПредставление);
    Исключение
        Описание = Новый Структура;
        Описание.Вставить("ВидЗначения", "НеРазобрано");
        Описание.Вставить("Представление", "");
        Описание.Вставить("ОшибкаРазбора", ОписаниеОшибки());
        Возврат Описание;
    КонецПопытки;

    Возврат РазобратьЗначение(Значение);

КонецФункции

Функция РазобратьЗначение(Значение)

    Описание = Новый Структура;

    Если Значение = Неопределено Тогда
        Описание.Вставить("ВидЗначения", "Неопределено");
        Описание.Вставить("Представление", "");
        Возврат Описание;
    КонецЕсли;

    ТипЗначения     = ТипЗнч(Значение);
    ОпределениеXML  = XMLТип(ТипЗначения);
    ИмяТипаXML      = ?(ОпределениеXML = Неопределено, "", ОпределениеXML.ИмяТипа);

    Если ОбщегоНазначения.ЭтоСсылка(ТипЗначения) Тогда

        МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗначения);

        Если МетаданныеЗначения <> Неопределено И Метаданные.Перечисления.Содержит(МетаданныеЗначения) Тогда
            Описание.Вставить("ВидЗначения", "Перечисление");
            Описание.Вставить("ТипЗначения", Строка(ТипЗначения));
            Описание.Вставить("ТипЗначенияXML", ИмяТипаXML);
            Описание.Вставить("ПолноеИмяОбъекта", МетаданныеЗначения.ПолноеИмя());
            Описание.Вставить("ИмяЗначения", XMLСтрока(Значение));
            Описание.Вставить("Представление", Строка(Значение));
        Иначе
            Описание.Вставить("ВидЗначения", "Ссылка");
            Описание.Вставить("ТипЗначения", Строка(ТипЗначения));
            Описание.Вставить("ТипЗначенияXML", ИмяТипаXML);
            Описание.Вставить("ПолноеИмяОбъекта", ?(МетаданныеЗначения = Неопределено, "", МетаданныеЗначения.ПолноеИмя()));
            Описание.Вставить("УникальныйИдентификатор", Строка(Значение.УникальныйИдентификатор()));
            Описание.Вставить("Представление", Строка(Значение));
        КонецЕсли;

    ИначеЕсли ТипЗначения = Тип("Дата") Тогда
        // XMLСтрока, а не Формат: у пустой даты Формат возвращает пустую строку.
        Описание.Вставить("ВидЗначения", "Примитив");
        Описание.Вставить("ТипЗначения", Строка(ТипЗначения));
        Описание.Вставить("Представление", XMLСтрока(Значение));

    ИначеЕсли ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
        Описание.Вставить("ВидЗначения", "Примитив");
        Описание.Вставить("ТипЗначения", Строка(ТипЗначения));
        Описание.Вставить("Представление", Строка(Значение));

    Иначе
        Описание.Вставить("ВидЗначения", "Прочее");
        Описание.Вставить("ТипЗначения", Строка(ТипЗначения));
        Описание.Вставить("Представление", Строка(Значение));

    КонецЕсли;

    Возврат Описание;

КонецФункции

// Описание: Ищет элемент справочника по данным файла: сначала по уникальному идентификатору,
// затем по коду запроса.
//
// Параметры:
//  ДанныеЭлемента - Соответствие - данные элемента из файла
//
// Возвращаемое значение:
//  СправочникСсылка.ЗапросыКДанным - найденный элемент либо пустая ссылка
//
Функция НайтиЭлементПоДанным(ДанныеЭлемента)

    СтрокаИдентификатора = ЗначениеИзСоответствия(ДанныеЭлемента, "УникальныйИдентификатор", "");
    Если ЗначениеЗаполнено(СтрокаИдентификатора) Тогда
        Ссылка = СсылкаПоИдентификатору(СтрокаИдентификатора);
        Если ЗначениеЗаполнено(Ссылка) И ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
            Возврат Ссылка;
        КонецЕсли;
    КонецЕсли;

    КодЗапроса = ЗначениеИзСоответствия(ДанныеЭлемента, "КодЗапроса", "");
    Если ЗначениеЗаполнено(КодЗапроса) Тогда
        Ссылка = Справочники.ЗапросыКДанным.НайтиПоРеквизиту("КодЗапроса", КодЗапроса);
        Если ЗначениеЗаполнено(Ссылка) Тогда
            Возврат Ссылка;
        КонецЕсли;
    КонецЕсли;

    Возврат Справочники.ЗапросыКДанным.ПустаяСсылка();

КонецФункции

// Описание: Преобразует строку в ссылку справочника. Строка приходит из файла,
// поэтому её корректность как GUID не гарантирована.
//
// Параметры:
//  СтрокаИдентификатора - Строка - представление уникального идентификатора
//
// Возвращаемое значение:
//  СправочникСсылка.ЗапросыКДанным - ссылка либо пустая ссылка при неверном формате
//
Функция СсылкаПоИдентификатору(СтрокаИдентификатора)

    Попытка
        Идентификатор = Новый УникальныйИдентификатор(СтрокаИдентификатора);
    Исключение
        Возврат Справочники.ЗапросыКДанным.ПустаяСсылка();
    КонецПопытки;

    Возврат Справочники.ЗапросыКДанным.ПолучитьСсылку(Идентификатор);

КонецФункции

Процедура ЗагрузитьОдинЭлемент(ДанныеЭлемента, Результат)

    ПредставлениеЭлемента = ПредставлениеЭлементаФайла(ДанныеЭлемента);
    СуществующаяСсылка    = НайтиЭлементПоДанным(ДанныеЭлемента);
    ЭтоСоздание           = Не ЗначениеЗаполнено(СуществующаяСсылка);

    Если ЭтоСоздание Тогда
        ОбъектСправочника    = Справочники.ЗапросыКДанным.СоздатьЭлемент();
        СтрокаИдентификатора = ЗначениеИзСоответствия(ДанныеЭлемента, "УникальныйИдентификатор", "");
        НоваяСсылка          = СсылкаПоИдентификатору(СтрокаИдентификатора);
        Если ЗначениеЗаполнено(НоваяСсылка) Тогда
            ОбъектСправочника.УстановитьСсылкуНового(НоваяСсылка);
        КонецЕсли;
    Иначе
        ОбъектСправочника = СуществующаяСсылка.ПолучитьОбъект();
    КонецЕсли;

    ОбъектСправочника.Код             = ЗначениеИзСоответствия(ДанныеЭлемента, "Код", "");
    ОбъектСправочника.Наименование    = ЗначениеИзСоответствия(ДанныеЭлемента, "Наименование", "");
    ОбъектСправочника.КодЗапроса      = ЗначениеИзСоответствия(ДанныеЭлемента, "КодЗапроса", "");
    ОбъектСправочника.ТекстЗапроса    = ЗначениеИзСоответствия(ДанныеЭлемента, "ТекстЗапроса", "");
    ОбъектСправочника.ПометкаУдаления = ЗначениеИзСоответствия(ДанныеЭлемента, "ПометкаУдаления", Ложь);

    ОписаниеТиповДанных = ЗначениеИзСоответствия(ДанныеЭлемента, "ДоступныеТипыДанных", Неопределено);
    Если ТипЗнч(ОписаниеТиповДанных) = Тип("Соответствие") Тогда
        ОбъектСправочника.ДоступныеТипыДанных = ЗначениеИзОписания(ОписаниеТиповДанных, Результат.Протокол,
            ПредставлениеЭлемента, "ДоступныеТипыДанных");
    КонецЕсли;

    ОбъектСправочника.Параметры.Очистить();
    Для Каждого ДанныеПараметра Из МассивПараметровФайла(ДанныеЭлемента) Цикл

        Если ТипЗнч(ДанныеПараметра) <> Тип("Соответствие") Тогда
            Продолжить;
        КонецЕсли;

        СтрокаПараметра          = ОбъектСправочника.Параметры.Добавить();
        СтрокаПараметра.Имя      = ЗначениеИзСоответствия(ДанныеПараметра, "Имя", "");
        СтрокаПараметра.Тип      = ЗначениеИзСоответствия(ДанныеПараметра, "Тип", "");
        СтрокаПараметра.Внешний  = ЗначениеИзСоответствия(ДанныеПараметра, "Внешний", Ложь);
        СтрокаПараметра.Значение = ЗначениеИзСоответствия(ДанныеПараметра, "ЗначениеВнутреннее", "");

        ИдентификаторПараметра = ЗначениеИзСоответствия(ДанныеПараметра, "Идентификатор", "");
        Если ЗначениеЗаполнено(ИдентификаторПараметра) Тогда
            СтрокаПараметра.Идентификатор = ИдентификаторСтрокиИзСтроки(ИдентификаторПараметра);
        КонецЕсли;

        ПроверитьЗначениеПараметра(ДанныеПараметра, Результат, ПредставлениеЭлемента);

    КонецЦикла;

    // Запись выполняется по данным внешнего файла: причина отказа платформы заранее не известна.
    Попытка
        ОбъектСправочника.Записать();
    Исключение
        Результат.Ошибок = Результат.Ошибок + 1;
        Результат.Протокол.Добавить(СтрШаблон(НСтр("ru = 'Ошибка записи элемента ""%1"": %2'"),
            ПредставлениеЭлемента, ОписаниеОшибки()));
        Возврат;
    КонецПопытки;

    Если ЭтоСоздание Тогда
        Результат.Создано = Результат.Создано + 1;
        Результат.Протокол.Добавить(СтрШаблон(НСтр("ru = 'Создан элемент ""%1"".'"), ПредставлениеЭлемента));
    Иначе
        Результат.Обновлено = Результат.Обновлено + 1;
        Результат.Протокол.Добавить(СтрШаблон(НСтр("ru = 'Обновлён элемент ""%1"".'"), ПредставлениеЭлемента));
    КонецЕсли;

КонецПроцедуры

// Описание: Проверяет, разрешается ли значение параметра в текущей базе, и пишет замечания в протокол.
// Само значение переносится в неизменном внутреннем виде, проверка носит контрольный характер.
//
// Параметры:
//  ДанныеПараметра       - Соответствие - данные строки параметра из файла
//  Результат             - Структура    - накопитель протокола загрузки
//  ПредставлениеЭлемента - Строка       - имя элемента для сообщений
//
Процедура ПроверитьЗначениеПараметра(ДанныеПараметра, Результат, ПредставлениеЭлемента)

    ИмяПараметра       = ЗначениеИзСоответствия(ДанныеПараметра, "Имя", "");
    ЗначениеВнутреннее = ЗначениеИзСоответствия(ДанныеПараметра, "ЗначениеВнутреннее", "");

    Если Не ЗначениеЗаполнено(ЗначениеВнутреннее) Тогда
        Возврат;
    КонецЕсли;

    // Строка получена из внешнего файла и может быть сформирована в другой конфигурации.
    Попытка
        Значение = ЗначениеИзСтрокиВнутр(ЗначениеВнутреннее);
    Исключение
        Результат.Протокол.Добавить(СтрШаблон(
            НСтр("ru = 'Элемент ""%1"", параметр ""%2"": значение не читается текущей конфигурацией (%3).'"),
            ПредставлениеЭлемента, ИмяПараметра, ОписаниеОшибки()));
        Возврат;
    КонецПопытки;

    Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Или Не ЗначениеЗаполнено(Значение) Тогда
        Возврат;
    КонецЕсли;

    МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
    Если МетаданныеЗначения <> Неопределено И Метаданные.Перечисления.Содержит(МетаданныеЗначения) Тогда
        Возврат;
    КонецЕсли;

    Если Не ОбщегоНазначения.СсылкаСуществует(Значение) Тогда
        ОписаниеИзФайла  = ЗначениеИзСоответствия(ДанныеПараметра, "ЗначениеОписание", Неопределено);
        ПредставлениеИзФайла = ?(ТипЗнч(ОписаниеИзФайла) = Тип("Соответствие"),
            ЗначениеИзСоответствия(ОписаниеИзФайла, "Представление", ""), "");
        Результат.Протокол.Добавить(СтрШаблон(
            НСтр("ru = 'Элемент ""%1"", параметр ""%2"": объект, на который ссылается значение, в базе не найден (%3).'"),
            ПредставлениеЭлемента, ИмяПараметра, ПредставлениеИзФайла));
    КонецЕсли;

КонецПроцедуры

// Описание: Восстанавливает значение по описанию из файла для реквизитов, хранящих произвольный тип.
//
// Параметры:
//  ОписаниеИзФайла       - Соответствие - блок ЗначениеВнутреннее/Описание
//  Протокол              - Массив       - накопитель сообщений
//  ПредставлениеЭлемента - Строка       - имя элемента для сообщений
//  ИмяРеквизита          - Строка       - имя реквизита для сообщений
//
// Возвращаемое значение:
//  Произвольный - восстановленное значение либо Неопределено
//
Функция ЗначениеИзОписания(ОписаниеИзФайла, Протокол, ПредставлениеЭлемента, ИмяРеквизита)

    ЗначениеВнутреннее = ЗначениеИзСоответствия(ОписаниеИзФайла, "ЗначениеВнутреннее", "");
    Если Не ЗначениеЗаполнено(ЗначениеВнутреннее) Тогда
        Возврат Неопределено;
    КонецЕсли;

    // Строка получена из внешнего файла и может быть сформирована в другой конфигурации.
    Попытка
        Возврат ЗначениеИзСтрокиВнутр(ЗначениеВнутреннее);
    Исключение
        Протокол.Добавить(СтрШаблон(
            НСтр("ru = 'Элемент ""%1"", реквизит ""%2"": значение не читается текущей конфигурацией (%3).'"),
            ПредставлениеЭлемента, ИмяРеквизита, ОписаниеОшибки()));
        Возврат Неопределено;
    КонецПопытки;

КонецФункции

Функция ИдентификаторСтрокиИзСтроки(СтрокаИдентификатора)

    Попытка
        Возврат Новый УникальныйИдентификатор(СтрокаИдентификатора);
    Исключение
        Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
    КонецПопытки;

КонецФункции

Функция ДобавитьСравнениеПараметров(Таблица, ПредставлениеЭлемента, ОбъектВБазе, ДанныеЭлемента)

    ПараметрыФайла = МассивПараметровФайла(ДанныеЭлемента);
    ЕстьРазличия   = Ложь;

    Если ОбъектВБазе.Параметры.Количество() <> ПараметрыФайла.Количество() Тогда
        ДобавитьСтрокуСравнения(Таблица, ПредставлениеЭлемента, НСтр("ru = 'Обновление'"),
            НСтр("ru = 'Параметры (количество строк)'"),
            Формат(ОбъектВБазе.Параметры.Количество(), "ЧН=0; ЧГ="),
            Формат(ПараметрыФайла.Количество(), "ЧН=0; ЧГ="));
        ЕстьРазличия = Истина;
    КонецЕсли;

    Индекс = 0;
    Для Каждого ДанныеПараметра Из ПараметрыФайла Цикл

        Если ТипЗнч(ДанныеПараметра) <> Тип("Соответствие") Тогда
            Индекс = Индекс + 1;
            Продолжить;
        КонецЕсли;

        ИмяПараметра = ЗначениеИзСоответствия(ДанныеПараметра, "Имя", "");

        Если Индекс >= ОбъектВБазе.Параметры.Количество() Тогда
            ДобавитьСтрокуСравнения(Таблица, ПредставлениеЭлемента, НСтр("ru = 'Обновление'"),
                СтрШаблон(НСтр("ru = 'Параметры[%1]'"), Формат(Индекс + 1, "ЧН=0; ЧГ=")),
                "", СтрШаблон(НСтр("ru = 'Добавится параметр ""%1""'"), ИмяПараметра));
            ЕстьРазличия = Истина;
            Индекс = Индекс + 1;
            Продолжить;
        КонецЕсли;

        СтрокаВБазе = ОбъектВБазе.Параметры[Индекс];

        Для Каждого ИмяПоля Из ИменаСравниваемыхПолейПараметра() Цикл
            ИмяПоляВФайле  = ?(ИмяПоля = "Значение", "ЗначениеВнутреннее", ИмяПоля);
            ЗначениеВФайле = Строка(ЗначениеИзСоответствия(ДанныеПараметра, ИмяПоляВФайле, ""));
            ЗначениеВБазе  = Строка(СтрокаВБазе[ИмяПоля]);
            Если ЗначениеВБазе <> ЗначениеВФайле Тогда
                ДобавитьСтрокуСравнения(Таблица, ПредставлениеЭлемента, НСтр("ru = 'Обновление'"),
                    СтрШаблон(НСтр("ru = 'Параметры[%1].%2 (%3)'"),
                        Формат(Индекс + 1, "ЧН=0; ЧГ="), ИмяПоля, ИмяПараметра),
                    ЗначениеВБазе, ЗначениеВФайле);
                ЕстьРазличия = Истина;
            КонецЕсли;
        КонецЦикла;

        Индекс = Индекс + 1;

    КонецЦикла;

    Пока Индекс < ОбъектВБазе.Параметры.Количество() Цикл
        ДобавитьСтрокуСравнения(Таблица, ПредставлениеЭлемента, НСтр("ru = 'Обновление'"),
            СтрШаблон(НСтр("ru = 'Параметры[%1]'"), Формат(Индекс + 1, "ЧН=0; ЧГ=")),
            СтрШаблон(НСтр("ru = 'Удалится параметр ""%1""'"), ОбъектВБазе.Параметры[Индекс].Имя), "");
        ЕстьРазличия = Истина;
        Индекс = Индекс + 1;
    КонецЦикла;

    Возврат ЕстьРазличия;

КонецФункции

Функция ИменаСравниваемыхПолейПараметра()

    Поля = Новый Массив;
    Поля.Добавить("Имя");
    Поля.Добавить("Тип");
    Поля.Добавить("Значение");
    Поля.Добавить("Внешний");

    Возврат Поля;

КонецФункции

Процедура ДобавитьСтрокуСравнения(Таблица, Элемент, Действие, Поле, ЗначениеВБазе, ЗначениеВФайле)

    НоваяСтрока = Таблица.Добавить();
    НоваяСтрока.Элемент        = Элемент;
    НоваяСтрока.Действие       = Действие;
    НоваяСтрока.Поле           = Поле;
    НоваяСтрока.ЗначениеВБазе  = СокращенноеПредставление(ЗначениеВБазе);
    НоваяСтрока.ЗначениеВФайле = СокращенноеПредставление(ЗначениеВФайле);

КонецПроцедуры

Функция СокращенноеПредставление(Значение)

    Текст = СтрЗаменить(СтрЗаменить(Строка(Значение), Символы.ПС, " "), Символы.Таб, " ");
    Если СтрДлина(Текст) > 200 Тогда
        Текст = Лев(Текст, 200) + "...";
    КонецЕсли;

    Возврат Текст;

КонецФункции

Функция ПредставлениеЭлементаФайла(ДанныеЭлемента)

    Наименование = ЗначениеИзСоответствия(ДанныеЭлемента, "Наименование", "");
    Если ЗначениеЗаполнено(Наименование) Тогда
        Возврат Наименование;
    КонецЕсли;

    КодЗапроса = ЗначениеИзСоответствия(ДанныеЭлемента, "КодЗапроса", "");
    Если ЗначениеЗаполнено(КодЗапроса) Тогда
        Возврат КодЗапроса;
    КонецЕсли;

    Возврат НСтр("ru = '<без наименования>'");

КонецФункции

Функция МассивПараметровФайла(ДанныеЭлемента)

    Параметры = ЗначениеИзСоответствия(ДанныеЭлемента, "Параметры", Неопределено);
    Если ТипЗнч(Параметры) = Тип("Массив") Тогда
        Возврат Параметры;
    КонецЕсли;

    Возврат Новый Массив;

КонецФункции

// Описание: Читает значение из соответствия, полученного разбором JSON, с подстановкой значения по умолчанию.
//
// Параметры:
//  Соответствие      - Соответствие - источник данных
//  Ключ              - Строка       - имя читаемого свойства
//  ЗначениеПоУмолчанию - Произвольный - результат, если свойство отсутствует или не заполнено
//
// Возвращаемое значение:
//  Произвольный - прочитанное значение
//
Функция ЗначениеИзСоответствия(Соответствие, Ключ, ЗначениеПоУмолчанию)

    Если ТипЗнч(Соответствие) <> Тип("Соответствие") Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;

    Значение = Соответствие.Получить(Ключ);
    Если Значение = Неопределено Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;

    Возврат Значение;

КонецФункции

#КонецОбласти
