#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ОбъектОбработки = РеквизитФормыВЗначение("Объект");
    Заголовок = СтрШаблон(НСтр("ru = 'Перенос запросов к данным (версия %1)'"), ОбъектОбработки.ВерсияОбработки());

    ЗаполнитьСписокЭлементов();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЗапросКДаннымПриИзменении(Элемент)

    Для Каждого СтрокаТаблицы Из ЭлементыВыгрузки Цикл
        СтрокаТаблицы.Пометка = ЗначениеЗаполнено(ЗапросКДанным) И СтрокаТаблицы.Ссылка = ЗапросКДанным;
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Заголовок                   = НСтр("ru = 'Выберите файл выгрузки запросов к данным'");
    Диалог.Фильтр                      = НСтр("ru = 'Файл выгрузки (*.json)|*.json|Все файлы (*.*)|*.*'");
    Диалог.Расширение                  = "json";
    Диалог.МножественныйВыбор          = Ложь;
    Диалог.ПроверятьСуществованиеФайла = Истина;

    Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлаЗагрузки", ЭтотОбъект));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСписокКоманда(Команда)

    ОбновитьСписокНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеКоманда(Команда)

    УстановитьПометки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкиКоманда(Команда)

    УстановитьПометки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВФайлКоманда(Команда)

    МассивСсылок = ОтмеченныеСсылки();
    Если МассивСсылок.Количество() = 0 Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одного элемента для выгрузки.'"));
        Возврат;
    КонецЕсли;

    РезультатВыгрузки = ПодготовитьВыгрузкуНаСервере(МассивСсылок);

    Если Не ЗначениеЗаполнено(РезультатВыгрузки.Адрес) Тогда
        Возврат;
    КонецЕсли;

    Оповещение = Новый ОписаниеОповещения("ПослеПодключенияРасширенияДляВыгрузки", ЭтотОбъект, РезультатВыгрузки);
    НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайлКоманда(Команда)

    Если Не ЗначениеЗаполнено(ИмяФайлаЗагрузки) Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Не указан файл для загрузки.'"));
        Возврат;
    КонецЕсли;

    НачатьПомещениеФайла(Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект), , ИмяФайлаЗагрузки, Ложь,
        ЭтотОбъект.УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИзмененияКоманда(Команда)

    Если Не ЗначениеЗаполнено(АдресДанныхЗагрузки) Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Сначала прочитайте файл выгрузки.'"));
        Возврат;
    КонецЕсли;

    ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОЗаписи", ЭтотОбъект),
        НСтр("ru = 'Записать изменения в справочник ""Запросы к данным""?'"), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Выгрузка

&НаКлиенте
Процедура ПослеПодключенияРасширенияДляВыгрузки(Подключено, РезультатВыгрузки) Экспорт

    Если Не Подключено Тогда
        Протокол = ПротоколСДобавлением(Протокол,
            НСтр("ru = 'Без расширения работы с файлами сохранить файл невозможно.'"));
        Возврат;
    КонецЕсли;

    ПолучаемыеФайлы = Новый Массив;
    ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(РезультатВыгрузки.ИмяФайла, РезультатВыгрузки.Адрес));

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Заголовок          = НСтр("ru = 'Сохранить выгрузку запросов к данным'");
    Диалог.Фильтр             = НСтр("ru = 'Файл выгрузки (*.json)|*.json'");
    Диалог.Расширение         = "json";
    Диалог.ПолноеИмяФайла     = РезультатВыгрузки.ИмяФайла;
    Диалог.МножественныйВыбор = Ложь;

    НачатьПолучениеФайлов(Новый ОписаниеОповещения("ПослеПолученияФайлов", ЭтотОбъект),
        ПолучаемыеФайлы, Диалог, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПолученияФайлов(ПолученныеФайлы, ДополнительныеПараметры) Экспорт

    Если ПолученныеФайлы = Неопределено Или ПолученныеФайлы.Количество() = 0 Тогда
        Протокол = ПротоколСДобавлением(Протокол, НСтр("ru = 'Сохранение файла отменено.'"));
        Возврат;
    КонецЕсли;

    Протокол = ПротоколСДобавлением(Протокол,
        СтрШаблон(НСтр("ru = 'Файл сохранён: %1'"), ПолученныеФайлы[0].Имя));

КонецПроцедуры

&НаСервере
Функция ПодготовитьВыгрузкуНаСервере(МассивСсылок)

    ОбъектОбработки   = РеквизитФормыВЗначение("Объект");
    РезультатВыгрузки = ОбъектОбработки.ВыгрузитьЭлементы(МассивСсылок);

    Протокол = ПротоколСДобавлением(Протокол, РезультатВыгрузки.Протокол);

    Результат = Новый Структура;
    Результат.Вставить("Выгружено", РезультатВыгрузки.Выгружено);
    Результат.Вставить("ИмяФайла", ИмяФайлаВыгрузки());
    Результат.Вставить("Адрес", "");

    Если РезультатВыгрузки.Выгружено = 0 Тогда
        Протокол = ПротоколСДобавлением(Протокол, НСтр("ru = 'Выгружать нечего.'"));
        Возврат Результат;
    КонецЕсли;

    ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(РезультатВыгрузки.ТекстJSON, "UTF-8", Ложь);
    Результат.Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

    Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ИмяФайлаВыгрузки()

    Возврат "ЗапросыКДанным_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss") + ".json";

КонецФункции

#КонецОбласти

#Область Загрузка

&НаКлиенте
Процедура ПослеВыбораФайлаЗагрузки(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

    Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ИмяФайлаЗагрузки = ВыбранныеФайлы[0];

    НачатьПомещениеФайла(Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект), , ИмяФайлаЗагрузки, Ложь,
        ЭтотОбъект.УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайла(Помещен, АдресФайла, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

    Если Не Помещен Тогда
        Протокол = ПротоколСДобавлением(Протокол, НСтр("ru = 'Не удалось прочитать файл.'"));
        Возврат;
    КонецЕсли;

    РазобратьФайлНаСервере(АдресФайла);

КонецПроцедуры

&НаСервере
Процедура РазобратьФайлНаСервере(АдресФайла)

    ТаблицаИзменений.Очистить();
    АдресДанныхЗагрузки = "";

    ТекстJSON = ТекстИзДвоичныхДанных(ПолучитьИзВременногоХранилища(АдресФайла));

    ОбъектОбработки = РеквизитФормыВЗначение("Объект");
    РезультатЧтения = ОбъектОбработки.ПрочитатьДанныеВыгрузки(ТекстJSON);

    Протокол = ПротоколСДобавлением(Протокол, РезультатЧтения.Протокол);

    Если Не РезультатЧтения.Успешно Тогда
        Протокол = ПротоколСДобавлением(Протокол, РезультатЧтения.ОписаниеОшибки);
        Возврат;
    КонецЕсли;

    ТаблицаИзменений.Загрузить(ОбъектОбработки.ТаблицаСравнения(РезультатЧтения.Данные));
    АдресДанныхЗагрузки = ПоместитьВоВременноеХранилище(ТекстJSON, УникальныйИдентификатор);

    Протокол = ПротоколСДобавлением(Протокол, НСтр("ru = 'Файл прочитан. Проверьте перечень изменений и нажмите ""Записать изменения"".'"));

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЗаписи(Ответ, ДополнительныеПараметры) Экспорт

    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ЗаписатьИзмененияНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьИзмененияНаСервере()

    ОбъектОбработки = РеквизитФормыВЗначение("Объект");

    ТекстJSON       = ПолучитьИзВременногоХранилища(АдресДанныхЗагрузки);
    РезультатЧтения = ОбъектОбработки.ПрочитатьДанныеВыгрузки(ТекстJSON);

    Если Не РезультатЧтения.Успешно Тогда
        Протокол = ПротоколСДобавлением(Протокол, РезультатЧтения.ОписаниеОшибки);
        Возврат;
    КонецЕсли;

    РезультатЗагрузки = ОбъектОбработки.ЗагрузитьЭлементы(РезультатЧтения.Данные);

    Протокол = ПротоколСДобавлением(Протокол, РезультатЗагрузки.Протокол);
    Протокол = ПротоколСДобавлением(Протокол, СтрШаблон(
        НСтр("ru = 'Итого: создано %1, обновлено %2, ошибок %3.'"),
        Формат(РезультатЗагрузки.Создано, "ЧН=0; ЧГ="),
        Формат(РезультатЗагрузки.Обновлено, "ЧН=0; ЧГ="),
        Формат(РезультатЗагрузки.Ошибок, "ЧН=0; ЧГ=")));

    ТаблицаИзменений.Очистить();
    АдресДанныхЗагрузки = "";
    ЗаполнитьСписокЭлементов();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекстИзДвоичныхДанных(ДвоичныеДанные)

    Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, "UTF-8");

    Если СтрДлина(Текст) > 0 И КодСимвола(Текст, 1) = 65279 Тогда
        Текст = Сред(Текст, 2);
    КонецЕсли;

    Возврат Текст;

КонецФункции

#КонецОбласти

#Область РаботаСоСписком

&НаСервере
Процедура ОбновитьСписокНаСервере()

    ЗаполнитьСписокЭлементов();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЭлементов()

    ОтмеченныеРанее = Новый Массив;
    Для Каждого СтрокаТаблицы Из ЭлементыВыгрузки Цикл
        Если СтрокаТаблицы.Пометка Тогда
            ОтмеченныеРанее.Добавить(СтрокаТаблицы.Ссылка);
        КонецЕсли;
    КонецЦикла;

    ОбъектОбработки = РеквизитФормыВЗначение("Объект");
    ЭлементыВыгрузки.Загрузить(ОбъектОбработки.ТаблицаЗапросовКДанным());

    Для Каждого СтрокаТаблицы Из ЭлементыВыгрузки Цикл
        СтрокаТаблицы.Пометка = ОтмеченныеРанее.Найти(СтрокаТаблицы.Ссылка) <> Неопределено;
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Пометка)

    Для Каждого СтрокаТаблицы Из ЭлементыВыгрузки Цикл
        СтрокаТаблицы.Пометка = Пометка;
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ОтмеченныеСсылки()

    МассивСсылок = Новый Массив;

    Для Каждого СтрокаТаблицы Из ЭлементыВыгрузки Цикл
        Если СтрокаТаблицы.Пометка Тогда
            МассивСсылок.Добавить(СтрокаТаблицы.Ссылка);
        КонецЕсли;
    КонецЦикла;

    Возврат МассивСсылок;

КонецФункции

#КонецОбласти

#Область Протокол

// Описание: Возвращает текст протокола с добавленными сообщениями. Используется и на клиенте, и на сервере.
//
// Параметры:
//  ТекущийПротокол - Строка - накопленный текст протокола
//  Сообщения       - Строка, Массив из Строка - добавляемые сообщения
//
// Возвращаемое значение:
//  Строка - текст протокола после добавления
//
&НаКлиентеНаСервереБезКонтекста
Функция ПротоколСДобавлением(ТекущийПротокол, Сообщения)

    Строки = Новый Массив;

    Если ЗначениеЗаполнено(ТекущийПротокол) Тогда
        Строки.Добавить(ТекущийПротокол);
    КонецЕсли;

    Если ТипЗнч(Сообщения) = Тип("Массив") Тогда
        Для Каждого Сообщение Из Сообщения Цикл
            Строки.Добавить(Строка(Сообщение));
        КонецЦикла;
    ИначеЕсли ЗначениеЗаполнено(Сообщения) Тогда
        Строки.Добавить(Строка(Сообщения));
    КонецЕсли;

    Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#КонецОбласти
