
#Область ОбработчикиСобытийФормы

// Заполняет список выбора колонки "Категория", задает процент изменения цен по умолчанию
// и делает первую запись журнала нажатий.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого Категория Из СписокКатегорий() Цикл
		Элементы.ТоварыКатегория.СписокВыбора.Добавить(Категория);
	КонецЦикла;

	ПроцентИзменения = 10;
	ТекущаяСтрока    = НСтр("ru = 'Строка не выбрана'");

	ДобавитьВЖурналНаСервере(НСтр("ru = 'Форма открыта'"),
		НСтр("ru = 'ПриСозданииНаСервере: заполнен список категорий'"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Включает или снимает отбор строк таблицы товаров по колонке "Отметка".
//
&НаКлиенте
Процедура ТолькоОтмеченныеПриИзменении(Элемент)

	Если ТолькоОтмеченные Тогда
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("Отметка", Истина);
		ДобавитьВЖурнал(НСтр("ru = 'Флажок ""Только отмеченные""'"),
			НСтр("ru = 'Установлен отбор строк: Отметка = Истина'"));
	Иначе
		Элементы.Товары.ОтборСтрок = Неопределено;
		ДобавитьВЖурнал(НСтр("ru = 'Флажок ""Только отмеченные""'"), НСтр("ru = 'Отбор строк снят'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

// После изменения строки пересчитывает итоги подвала и таблицу итогов по категориям.
//
&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)

	ОбновитьИтоги();

КонецПроцедуры

// Выводит описание текущей строки товаров в поле "Текущая строка" под таблицей.
//
&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)

	ОбновитьТекущуюСтроку();

КонецПроцедуры

// Записывает в журнал наименование удаляемой строки. Удаление не отменяет.
//
&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ДобавитьВЖурнал(НСтр("ru = 'Удаление строки'"), ТекущиеДанные.Наименование);
	КонецЕсли;

КонецПроцедуры

// После удаления строк пересчитывает итоги.
//
&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)

	ОбновитьИтоги();

КонецПроцедуры

// Записывает в журнал установку или снятие отметки строки.
//
&НаКлиенте
Процедура ТоварыОтметкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ДобавитьВЖурнал(НСтр("ru = 'Отметка строки'"),
		СтрШаблон("%1: %2", ТекущиеДанные.Наименование,
			Формат(ТекущиеДанные.Отметка, НСтр("ru = 'БЛ=снята; БИ=установлена'"))));

КонецПроцедуры

// Пересчитывает сумму текущей строки после изменения количества.
//
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)

	РассчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);

КонецПроцедуры

// Пересчитывает сумму текущей строки после изменения цены.
//
&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	РассчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИтогиПоКатегориям

// Двойной щелчок по строке итогов: устанавливает отбор товаров по выбранной категории
// и переключает форму на вкладку "Товары".
//
&НаКлиенте
Процедура ИтогиПоКатегориямВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Категория = ИтогиПоКатегориям.НайтиПоИдентификатору(ВыбраннаяСтрока).Категория;

	ТолькоОтмеченные = Ложь;
	Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("Категория", Категория);
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТовары;

	ДобавитьВЖурнал(НСтр("ru = 'Двойной щелчок по итогам'"),
		СтрШаблон(НСтр("ru = 'Отбор товаров по категории ""%1""'"), Категория));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Заполняет таблицу товаров примером на сервере (один вызов сервера) и пересчитывает итоги на клиенте.
//
&НаКлиенте
Процедура ЗаполнитьПример(Команда)

	ЗаполнитьПримерНаСервере();
	ОбновитьИтоги();

КонецПроцедуры

// Очищает таблицу товаров и снимает отбор строк.
//
&НаКлиенте
Процедура Очистить(Команда)

	Товары.Очистить();
	ТолькоОтмеченные = Ложь;
	Элементы.Товары.ОтборСтрок = Неопределено;
	ОбновитьИтоги();
	ДобавитьВЖурнал(НСтр("ru = 'Кнопка ""Очистить""'"), НСтр("ru = 'Таблица товаров очищена'"));

КонецПроцедуры

// Сортирует товары по сумме, по убыванию (подменю "Сортировка").
//
&НаКлиенте
Процедура СортироватьПоСумме(Команда)

	Товары.Сортировать("Сумма Убыв");
	ОбновитьТекущуюСтроку();
	ДобавитьВЖурнал(НСтр("ru = 'Подменю ""Сортировка""'"), НСтр("ru = 'По сумме, по убыванию'"));

КонецПроцедуры

// Сортирует товары по наименованию (подменю "Сортировка").
//
&НаКлиенте
Процедура СортироватьПоНаименованию(Команда)

	Товары.Сортировать("Наименование");
	ОбновитьТекущуюСтроку();
	ДобавитьВЖурнал(НСтр("ru = 'Подменю ""Сортировка""'"), НСтр("ru = 'По наименованию'"));

КонецПроцедуры

// Показывает перечень приемов, которые демонстрирует форма (команда в меню "Еще").
//
&НаКлиенте
Процедура ЧтоУмеетФорма(Команда)

	ТекстСправки = НСтр("ru = 'Форма показывает основные приемы работы с кнопками и таблицами:
		|- кнопки командной панели формы, подменю и команда в меню ""Еще"";
		|- обычные кнопки, гиперссылка и флажок в группе;
		|- командная панель таблицы со стандартными командами и собственная панель под таблицей;
		|- редактирование строк с пересчетом суммы и итогами в подвале;
		|- отбор строк, сортировка, выделение нескольких строк;
		|- вызов сервера и вопрос пользователю перед удалением;
		|- вторая таблица с итогами по категориям (двойной щелчок - отбор).'");

	ПоказатьПредупреждение(, ТекстСправки);
	ДобавитьВЖурнал(НСтр("ru = 'Меню ""Еще""'"), НСтр("ru = 'Показана справка'"));

КонецПроцедуры

// Меняет цены на ПроцентИзменения: в выделенных строках, если выделено больше одной строки,
// иначе во всех строках таблицы. Пересчитывает суммы и итоги.
//
&НаКлиенте
Процедура ИзменитьЦены(Команда)

	Если ПроцентИзменения = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите процент изменения цен.'"));
		Возврат;
	КонецЕсли;

	ВыделенныеСтроки = Элементы.Товары.ВыделенныеСтроки;
	СтрокиДляИзменения = Новый Массив;
	Если ВыделенныеСтроки.Количество() > 1 Тогда
		Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
			СтрокиДляИзменения.Добавить(Товары.НайтиПоИдентификатору(Идентификатор));
		КонецЦикла;
	Иначе
		Для Каждого СтрокаТоваров Из Товары Цикл
			СтрокиДляИзменения.Добавить(СтрокаТоваров);
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаТоваров Из СтрокиДляИзменения Цикл
		СтрокаТоваров.Цена = Окр(СтрокаТоваров.Цена * (100 + ПроцентИзменения) / 100, 2);
		РассчитатьСуммуСтроки(СтрокаТоваров);
	КонецЦикла;

	ОбновитьИтоги();
	ДобавитьВЖурнал(НСтр("ru = 'Кнопка ""Изменить цены на %""'"),
		СтрШаблон(НСтр("ru = 'Цены изменены на %1%% в строках: %2'"),
			ПроцентИзменения, СтрокиДляИзменения.Количество()));

КонецПроцедуры

// Пересчитывает суммы и итоги по категориям на сервере.
//
&НаКлиенте
Процедура ПересчитатьНаСервере(Команда)

	ПересчитатьНаСервереСервер();
	ОбновитьТекущуюСтроку();

КонецПроцедуры

// Показывает реквизиты текущей строки товаров в окне предупреждения.
//
&НаКлиенте
Процедура ПоказатьТекущуюСтроку(Команда)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В таблице товаров нет текущей строки.'"));
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Наименование: %1
		|Категория: %2
		|Количество: %3
		|Цена: %4
		|Сумма: %5'"), ТекущиеДанные.Наименование, ТекущиеДанные.Категория,
		ТекущиеДанные.Количество, ТекущиеДанные.Цена, ТекущиеДанные.Сумма));
	ДобавитьВЖурнал(НСтр("ru = 'Кнопка ""Показать текущую строку""'"), ТекущиеДанные.Наименование);

КонецПроцедуры

// Выводит сообщение пользователю с числом строк, общим количеством и суммой таблицы товаров
// и записывает итог в журнал нажатий.
//
&НаКлиенте
Процедура ИтогВСообщение(Команда)

	ТекстИтога = СтрШаблон(НСтр("ru = 'Строк: %1, количество: %2, сумма: %3'"),
		Товары.Количество(), Товары.Итог("Количество"), Формат(Товары.Итог("Сумма"), "ЧДЦ=2; ЧН=0"));

	ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Итог по товарам. '") + ТекстИтога);
	ДобавитьВЖурнал(НСтр("ru = 'Кнопка ""Итог в сообщение""'"), ТекстИтога);

КонецПроцедуры

// Устанавливает отметку во всех строках товаров.
//
&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьОтметки(Истина);

КонецПроцедуры

// Снимает отметку во всех строках товаров.
//
&НаКлиенте
Процедура СнятьОтметки(Команда)

	УстановитьОтметки(Ложь);

КонецПроцедуры

// Задает вопрос об удалении отмеченных строк; удаление выполняет УдалитьОтмеченныеЗавершение.
//
&НаКлиенте
Процедура УдалитьОтмеченные(Команда)

	Отмеченные = Товары.НайтиСтроки(Новый Структура("Отметка", Истина));
	Если НЕ ЗначениеЗаполнено(Отмеченные) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет отмеченных строк.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("УдалитьОтмеченныеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, СтрШаблон(НСтр("ru = 'Удалить отмеченные строки (%1)?'"), Отмеченные.Количество()),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

// Снимает любой отбор строк таблицы товаров.
//
&НаКлиенте
Процедура СброситьОтбор(Команда)

	ТолькоОтмеченные = Ложь;
	Элементы.Товары.ОтборСтрок = Неопределено;
	ДобавитьВЖурнал(НСтр("ru = 'Кнопка ""Показать все строки""'"), НСтр("ru = 'Отбор строк снят'"));

КонецПроцедуры

// Очищает журнал нажатий.
//
&НаКлиенте
Процедура ОчиститьЖурнал(Команда)

	Журнал.Очистить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Продолжение команды "Удалить отмеченные" после ответа пользователя.
//
// Параметры:
//  Ответ                   - КодВозвратаДиалога, Неопределено - ответ на вопрос
//  ДополнительныеПараметры - Неопределено - не используется
//
&НаКлиенте
Процедура УдалитьОтмеченныеЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		ДобавитьВЖурнал(НСтр("ru = 'Кнопка ""Удалить отмеченные""'"),
			НСтр("ru = 'Пользователь отказался от удаления'"));
		Возврат;
	КонецЕсли;

	Отмеченные = Товары.НайтиСтроки(Новый Структура("Отметка", Истина));
	Для Каждого СтрокаТоваров Из Отмеченные Цикл
		Товары.Удалить(СтрокаТоваров);
	КонецЦикла;

	ОбновитьИтоги();
	ДобавитьВЖурнал(НСтр("ru = 'Кнопка ""Удалить отмеченные""'"),
		СтрШаблон(НСтр("ru = 'Удалено строк: %1'"), Отмеченные.Количество()));

КонецПроцедуры

// Устанавливает одно значение отметки во всех строках товаров.
//
// Параметры:
//  Отметка - Булево - новое значение колонки "Отметка"
//
&НаКлиенте
Процедура УстановитьОтметки(Отметка)

	Для Каждого СтрокаТоваров Из Товары Цикл
		СтрокаТоваров.Отметка = Отметка;
	КонецЦикла;

	Если Отметка Тогда
		Действие = НСтр("ru = 'Кнопка ""Отметить все""'");
	Иначе
		Действие = НСтр("ru = 'Кнопка ""Снять отметки""'");
	КонецЕсли;
	ДобавитьВЖурнал(Действие, СтрШаблон(НСтр("ru = 'Строк: %1'"), Товары.Количество()));

КонецПроцедуры

// Рассчитывает сумму строки как количество, умноженное на цену.
//
// Параметры:
//  СтрокаТоваров - ДанныеФормыЭлементКоллекции - строка таблицы "Товары"
//
&НаКлиенте
Процедура РассчитатьСуммуСтроки(СтрокаТоваров)

	СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;

КонецПроцедуры

// Пересчитывает итоги подвала таблицы товаров, заново заполняет таблицу итогов по категориям
// и обновляет описание текущей строки. Строки без категории собираются в группу "<без категории>".
//
&НаКлиенте
Процедура ОбновитьИтоги()

	ИтогКоличество = Товары.Итог("Количество");
	ИтогСумма      = Товары.Итог("Сумма");

	ИтогиПоКатегориям.Очистить();
	СтрокиКатегорий = Новый Соответствие;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Категория = СтрокаТоваров.Категория;
		Если ПустаяСтрока(Категория) Тогда
			Категория = НСтр("ru = '<без категории>'");
		КонецЕсли;

		СтрокаИтогов = СтрокиКатегорий.Получить(Категория);
		Если СтрокаИтогов = Неопределено Тогда
			СтрокаИтогов = ИтогиПоКатегориям.Добавить();
			СтрокаИтогов.Категория = Категория;
			СтрокиКатегорий.Вставить(Категория, СтрокаИтогов);
		КонецЕсли;

		СтрокаИтогов.Строк      = СтрокаИтогов.Строк + 1;
		СтрокаИтогов.Количество = СтрокаИтогов.Количество + СтрокаТоваров.Количество;
		СтрокаИтогов.Сумма      = СтрокаИтогов.Сумма + СтрокаТоваров.Сумма;
	КонецЦикла;
	ИтогиПоКатегориям.Сортировать("Сумма Убыв");

	ОбновитьТекущуюСтроку();

КонецПроцедуры

// Заполняет поле "Текущая строка" номером и реквизитами текущей строки товаров.
//
&НаКлиенте
Процедура ОбновитьТекущуюСтроку()

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ТекущаяСтрока = НСтр("ru = 'Строка не выбрана'");
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = СтрШаблон(НСтр("ru = 'N %1: %2, %3 x %4 = %5'"),
		Товары.Индекс(ТекущиеДанные) + 1, ТекущиеДанные.Наименование,
		ТекущиеДанные.Количество, ТекущиеДанные.Цена, ТекущиеДанные.Сумма);

КонецПроцедуры

// Заменяет содержимое таблицы товаров семью строками примера.
//
&НаСервере
Процедура ЗаполнитьПримерНаСервере()

	Товары.Очистить();
	ДобавитьТовар("Бумага офисная А4", "Канцелярия", 20, 350);
	ДобавитьТовар("Ручка шариковая", "Канцелярия", 100, 25.5);
	ДобавитьТовар("Монитор 27""", "Техника", 3, 21990);
	ДобавитьТовар("Клавиатура", "Техника", 5, 1890);
	ДобавитьТовар("Кофе в зернах 1 кг", "Продукты", 4, 1450);
	ДобавитьТовар("Вода питьевая 19 л", "Продукты", 10, 390);
	ДобавитьТовар("Кресло офисное", "Мебель", 2, 12500);

	ДобавитьВЖурналНаСервере(НСтр("ru = 'Кнопка ""Заполнить пример""'"),
		СтрШаблон(НСтр("ru = 'Вызов сервера: добавлено строк %1'"), Товары.Количество()));

КонецПроцедуры

// Добавляет строку в таблицу товаров и рассчитывает ее сумму.
//
// Параметры:
//  Наименование - Строка - наименование товара
//  Категория    - Строка - категория из СписокКатегорий()
//  Количество   - Число  - количество
//  Цена         - Число  - цена за единицу
//
&НаСервере
Процедура ДобавитьТовар(Наименование, Категория, Количество, Цена)

	СтрокаТоваров = Товары.Добавить();
	СтрокаТоваров.Наименование = Наименование;
	СтрокаТоваров.Категория    = Категория;
	СтрокаТоваров.Количество   = Количество;
	СтрокаТоваров.Цена         = Цена;
	СтрокаТоваров.Сумма        = Количество * Цена;

КонецПроцедуры

// Пересчитывает суммы строк и итоги по категориям средствами ТаблицаЗначений на сервере
// (Выгрузить, Свернуть, Загрузить) - серверный аналог клиентской процедуры ОбновитьИтоги.
//
&НаСервере
Процедура ПересчитатьНаСервереСервер()

	ТаблицаТоваров = Товары.Выгрузить();
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;
	КонецЦикла;
	Товары.Загрузить(ТаблицаТоваров);

	ТаблицаИтогов = ТаблицаТоваров.Скопировать(, "Категория, Количество, Сумма");
	ТаблицаИтогов.Колонки.Добавить("Строк", Новый ОписаниеТипов("Число"));
	ТаблицаИтогов.ЗаполнитьЗначения(1, "Строк");
	ТаблицаИтогов.Свернуть("Категория", "Строк, Количество, Сумма");
	ТаблицаИтогов.Сортировать("Сумма Убыв");
	ИтогиПоКатегориям.Загрузить(ТаблицаИтогов);

	ИтогКоличество = ТаблицаТоваров.Итог("Количество");
	ИтогСумма      = ТаблицаТоваров.Итог("Сумма");

	ДобавитьВЖурналНаСервере(НСтр("ru = 'Кнопка ""Пересчитать на сервере""'"),
		СтрШаблон(НСтр("ru = 'ТаблицаЗначений.Свернуть: категорий %1, сумма %2'"),
			ТаблицаИтогов.Количество(), Формат(ИтогСумма, "ЧДЦ=2")));

КонецПроцедуры

// Категории товаров для списка выбора колонки "Категория".
//
// Возвращаемое значение:
//  Массив из Строка - наименования категорий
//
&НаСервереБезКонтекста
Функция СписокКатегорий()

	Категории = Новый Массив;
	Категории.Добавить(НСтр("ru = 'Канцелярия'"));
	Категории.Добавить(НСтр("ru = 'Техника'"));
	Категории.Добавить(НСтр("ru = 'Продукты'"));
	Категории.Добавить(НСтр("ru = 'Мебель'"));
	Возврат Категории;

КонецФункции

// Вставляет запись в начало журнала нажатий. Общая часть клиентской и серверной записи в журнал.
//
// Параметры:
//  Журнал      - ДанныеФормыКоллекция - реквизит формы "Журнал"
//  Время       - Дата   - время действия
//  Действие    - Строка - какая кнопка или событие сработали
//  Подробности - Строка - результат действия
//
// Возвращаемое значение:
//  Число - идентификатор вставленной записи, для установки текущей строки таблицы "Журнал"
//
&НаКлиентеНаСервереБезКонтекста
Функция ДобавитьЗаписьЖурнала(Журнал, Время, Действие, Подробности)

	Запись = Журнал.Вставить(0);
	Запись.Время       = Время;
	Запись.Действие    = Действие;
	Запись.Подробности = Подробности;

	Возврат Запись.ПолучитьИдентификатор();

КонецФункции

// Записывает действие в журнал нажатий на клиенте, время - дата сеанса. Новая запись становится текущей.
//
// Параметры:
//  Действие    - Строка - какая кнопка или событие сработали
//  Подробности - Строка - результат действия
//
&НаКлиенте
Процедура ДобавитьВЖурнал(Действие, Подробности)

	Элементы.Журнал.ТекущаяСтрока = ДобавитьЗаписьЖурнала(Журнал,
		ОбщегоНазначенияКлиент.ДатаСеанса(), Действие, Подробности);

КонецПроцедуры

// Записывает действие в журнал нажатий на сервере, время - дата сеанса. Новая запись становится текущей.
//
// Параметры:
//  Действие    - Строка - какая кнопка или событие сработали
//  Подробности - Строка - результат действия
//
&НаСервере
Процедура ДобавитьВЖурналНаСервере(Действие, Подробности)

	Элементы.Журнал.ТекущаяСтрока = ДобавитьЗаписьЖурнала(Журнал, ТекущаяДатаСеанса(), Действие, Подробности);

КонецПроцедуры

#КонецОбласти
