//  Информация - ИнформацияОбОшибке - ошибка
//
Процедура ДобавитьОшибку(Лог, Информация)

	Лог.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(Информация));

КонецПроцедуры

