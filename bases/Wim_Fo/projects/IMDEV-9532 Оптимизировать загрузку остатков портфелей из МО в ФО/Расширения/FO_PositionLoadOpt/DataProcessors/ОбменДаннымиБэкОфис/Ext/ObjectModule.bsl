#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

&ИзменениеИКонтроль("ОбработатьДанные_ДополнительныеСведения")
Процедура FO_PositionLoadOpt_ОбработатьДанные_ДополнительныеСведения(СписокXDTO)

#Вставка
	// Замер производительности загрузки регистра: вес - разные найденные портфели, в комментарии - строки пакета и
	// сколько из них записано после пропуска флагов, у которых в регистре уже то же значение.
	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	ПортфелиСведений = Новый Соответствие;
	ЗаписаноСтрок = 0;
#КонецВставки

#Вставка
	// Флаги лимитов (шаги "флаг до позиции" и "флаги после позиции" выгрузки остатков из МО) приходят по несколько
	// строк на портфель с одними и теми же ключами и значениями. Свойство по наименованию и преобразованное значение
	// ищутся один раз на пакет, а флаг, у которого в регистре уже то же значение, повторно не записывается.
	КэшСвойств = Новый Соответствие;
	КэшЗначений = Новый Соответствие;
	ТекущиеЗначения = Новый Соответствие;

#КонецВставки
	Для Каждого СтрокаОбъектXDTO Из СписокXDTO Цикл

		ОбъектСсылка = Неопределено;
		ТипОбъекта = "";

		Если СтрокаОбъектXDTO.Объект.Актив <> Неопределено Тогда
			ОбъектСсылка = АктивПоиск(СтрокаОбъектXDTO.Объект.Актив, Истина);
			ТипОбъекта = "Актив";
		ИначеЕсли СтрокаОбъектXDTO.Объект.МестоХранения <> Неопределено Тогда
			ОбъектСсылка = МестоХраненияПоиск(СтрокаОбъектXDTO.Объект.МестоХранения);
			ТипОбъекта = "МестоХранения";
		ИначеЕсли СтрокаОбъектXDTO.Объект.Портфель <> Неопределено Тогда
			ОбъектСсылка = ПортфельПоиск(СтрокаОбъектXDTO.Объект.Портфель);
			ТипОбъекта = "Портфель";
		ИначеЕсли СтрокаОбъектXDTO.Объект.Контрагент <> Неопределено Тогда
			ОбъектСсылка = КонтрагентПоиск(СтрокаОбъектXDTO.Объект.Контрагент, Истина);
			ТипОбъекта = "Контрагент";
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда

			СведенияДляРассылки = СведенияДляРассылки("РегистрыСведений", "ДополнительныеСведения");
			СведенияДляРассылки.Вставить("Измерения", Новый Структура("Объект, Ключ", ТипОбъекта, СтрокаОбъектXDTO.Ключ));

			ЗаписатьОшибкуОбмена(мМетодыСервиса.ФинПоказатели,
				мВидыОшибок.ПоискСсылки, НСтр("ru='Не найден объект типа'") + " " + ТипОбъекта, СведенияДляРассылки);

			Продолжить;
		КонецЕсли;
#Вставка

		Если ТипОбъекта = "Портфель" Тогда
			ПортфелиСведений.Вставить(ОбъектСсылка, Истина);
		КонецЕсли;
#КонецВставки

#Удаление
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(СтрокаОбъектXDTO.Ключ, Истина);
#КонецУдаления
#Вставка
		Свойство = СвойствоПоНаименованию(СтрокаОбъектXDTO.Ключ, КэшСвойств);
#КонецВставки
		Если Не ЗначениеЗаполнено(Свойство) Тогда

			СведенияДляРассылки = СведенияДляРассылки("РегистрыСведений", "ДополнительныеСведения");
			СведенияДляРассылки.Вставить("Измерения", Новый Структура("Объект, Ключ", ОбъектСсылка, СтрокаОбъектXDTO.Ключ));

			ЗаписатьОшибкуОбмена(мМетодыСервиса.ФинПоказатели,
				мВидыОшибок.ПоискСсылки, НСтр("ru='Не найдено свойство с наименованием'") + " " + СтрокаОбъектXDTO.Ключ, СведенияДляРассылки);

			Продолжить;
		КонецЕсли;

#Удаление
		Значение = ПреобразоватьЗначениеДополнительногоСведения(СтрокаОбъектXDTO.Значение, Свойство);
#КонецУдаления
#Вставка
		Значение = ПреобразованноеЗначениеСведения(СтрокаОбъектXDTO.Значение, Свойство, КэшЗначений);

		Если ФлагУжеИмеетЗначение(ОбъектСсылка, Свойство, Значение, ТекущиеЗначения) Тогда
			Продолжить;
		КонецЕсли;
#КонецВставки

		Запись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		Запись.Объект = ОбъектСсылка;
		Запись.Свойство = Свойство;
		Запись.Значение = Значение;
		Запись.Записать();
#Вставка
		ЗаписаноСтрок = ЗаписаноСтрок + 1;
#КонецВставки
#Вставка

		ЗапомнитьЗаписанноеЗначение(ОбъектСсылка, Свойство, Значение, ТекущиеЗначения);
#КонецВставки

	КонецЦикла;
#Вставка

	Если ЗначениеЗаполнено(НачалоЗамера) И СписокXDTO.Количество() > 0 Тогда
		Если ПортфелиСведений.Количество() > 0 Тогда
			ВесЗамера = ПортфелиСведений.Количество();
		Иначе
			ВесЗамера = СписокXDTO.Количество();
		КонецЕсли;
		ИдентификаторПакета = "";
		Если мОбъектОтвет <> Неопределено И мОбъектОтвет.Заголовок <> Неопределено Тогда
			ИдентификаторПакета = Строка(мОбъектОтвет.Заголовок.УникальныйИдентификаторЗапроса);
		КонецЕсли;
		Комментарий = СтрШаблон("Строк: %1; Портфелей: %2; Записано: %3; Пакет: %4",
			Формат(СписокXDTO.Количество(), "ЧН=0; ЧГ=0"), Формат(ПортфелиСведений.Количество(), "ЧН=0; ЧГ=0"),
			Формат(ЗаписаноСтрок, "ЧН=0; ЧГ=0"), ИдентификаторПакета);
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ОбменБэкОфис.РегистрыСведений.ДополнительныеСведения",
			НачалоЗамера, ВесЗамера, Комментарий);
	КонецЕсли;
#КонецВставки

КонецПроцедуры

#Область ЗаписьДополнительныхСведенийПакета

// Находит свойство (дополнительный реквизит или сведение) по точному наименованию так же, как штатная загрузка,
// но обращается к базе один раз на наименование в пределах пакета. Ненайденное свойство (пустая ссылка) тоже
// запоминается: ошибка обмена по каждой строке с ним записывается вызывающим кодом, как и без кэша.
//
// Параметры:
//  Наименование - Строка - ключ строки пакета (наименование свойства)
//  КэшСвойств - Соответствие - кэш пакета: свойства по наименованию
//
// Возвращаемое значение:
//  ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - найденное свойство или пустая ссылка
//
Функция СвойствоПоНаименованию(Наименование, КэшСвойств)

	Если ТипЗнч(Наименование) <> Тип("Строка") Тогда
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(Наименование, Истина);
	КонецЕсли;

	Свойство = КэшСвойств.Получить(Наименование);
	Если Свойство = Неопределено Тогда
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(Наименование, Истина);
		КэшСвойств.Вставить(Наименование, Свойство);
	КонецЕсли;

	Возврат Свойство;

КонецФункции

// Преобразует значение строки пакета к типу свойства штатной функцией ПреобразоватьЗначениеДополнительногоСведения
// и запоминает результат для пары "свойство - значение из пакета". Штатная функция на каждую строку читает тип
// значения свойства запросом, а для ссылочных типов еще ищет значение по наименованию; в пакете флагов пары
// повторяются на каждом портфеле. Запоминаются только значения примитивных типов из пакета, остальные
// преобразуются без кэша.
//
// Параметры:
//  ЗначениеXDTO - Произвольный - значение строки пакета
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство строки
//  КэшЗначений - Соответствие - кэш пакета: ключ - свойство, значение - Соответствие, где ключ - значение
//                из пакета, значение - Структура с полем Значение (преобразованное значение)
//
// Возвращаемое значение:
//  Произвольный - значение для записи в регистр, как его вернула бы ПреобразоватьЗначениеДополнительногоСведения
//
Функция ПреобразованноеЗначениеСведения(ЗначениеXDTO, Свойство, КэшЗначений)

	Если ПолучитьМассивПримитивныхТипов().Найти(ТипЗнч(ЗначениеXDTO)) = Неопределено Тогда
		Возврат ПреобразоватьЗначениеДополнительногоСведения(ЗначениеXDTO, Свойство);
	КонецЕсли;

	ЗначенияСвойства = КэшЗначений.Получить(Свойство);
	Если ЗначенияСвойства = Неопределено Тогда
		ЗначенияСвойства = Новый Соответствие;
		КэшЗначений.Вставить(Свойство, ЗначенияСвойства);
	КонецЕсли;

	// Результат хранится в структуре: преобразованное значение может быть Неопределено.
	Преобразованное = ЗначенияСвойства.Получить(ЗначениеXDTO);
	Если Преобразованное = Неопределено Тогда
		Преобразованное = Новый Структура("Значение",
			ПреобразоватьЗначениеДополнительногоСведения(ЗначениеXDTO, Свойство));
		ЗначенияСвойства.Вставить(ЗначениеXDTO, Преобразованное);
	КонецЕсли;

	Возврат Преобразованное.Значение;

КонецФункции

// Определяет, что запись флага можно пропустить: значение булево и в регистре у объекта уже есть запись этого
// свойства с тем же значением, то есть после записи регистр не изменился бы. Пропуск только для булевых значений:
// флаги лимитов булевы, а на запись небулевых свойств в конфигурации есть подписки с действиями (например,
// распространение правил при записи эталонного портфеля), которые должны срабатывать на каждую запись.
// Текущие значения объекта читаются один раз на пакет при первой булевой строке объекта и дальше
// поддерживаются процедурой ЗапомнитьЗаписанноеЗначение.
//
// Параметры:
//  ОбъектСсылка - ЛюбаяСсылка - объект строки (портфель, актив, место хранения, контрагент)
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство строки
//  Значение - Произвольный - значение для записи
//  ТекущиеЗначения - Соответствие - кэш пакета: ключ - объект, значение - Соответствие из
//                    ТекущиеЗначенияСведенийОбъекта
//
// Возвращаемое значение:
//  Булево - Истина, если запись не изменит регистр и ее можно не выполнять
//
Функция ФлагУжеИмеетЗначение(ОбъектСсылка, Свойство, Значение, ТекущиеЗначения)

	Если ТипЗнч(Значение) <> Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗначенияОбъекта = ТекущиеЗначения.Получить(ОбъектСсылка);
	Если ЗначенияОбъекта = Неопределено Тогда
		ЗначенияОбъекта = ТекущиеЗначенияСведенийОбъекта(ОбъектСсылка);
		ТекущиеЗначения.Вставить(ОбъектСсылка, ЗначенияОбъекта);
	КонецЕсли;

	ТекущаяЗапись = ЗначенияОбъекта.Получить(Свойство);
	Если ТекущаяЗапись = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТекущаяЗапись.Значение = Значение;

КонецФункции

// Читает записи регистра ДополнительныеСведения объекта.
//
// Параметры:
//  ОбъектСсылка - ЛюбаяСсылка - объект, значения свойств которого нужны
//
// Возвращаемое значение:
//  Соответствие - ключ - свойство, значение - Структура с полем Значение (значение записи регистра).
//                 Свойства без записи в соответствии нет
//
Функция ТекущиеЗначенияСведенийОбъекта(ОбъектСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДополнительныеСведения.Свойство КАК Свойство,
	|	ДополнительныеСведения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", ОбъектСсылка);

	ЗначенияОбъекта = Новый Соответствие;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗначенияОбъекта.Вставить(Выборка.Свойство, Новый Структура("Значение", Выборка.Значение));
	КонецЦикла;

	Возврат ЗначенияОбъекта;

КонецФункции

// Отражает выполненную запись в кэше текущих значений объекта, если значения этого объекта уже прочитаны,
// чтобы следующие строки пакета с тем же объектом и свойством сравнивались с записанным значением.
//
// Параметры:
//  ОбъектСсылка - ЛюбаяСсылка - объект записи
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство записи
//  Значение - Произвольный - записанное значение
//  ТекущиеЗначения - Соответствие - кэш пакета, см. ФлагУжеИмеетЗначение
//
Процедура ЗапомнитьЗаписанноеЗначение(ОбъектСсылка, Свойство, Значение, ТекущиеЗначения)

	ЗначенияОбъекта = ТекущиеЗначения.Получить(ОбъектСсылка);
	Если ЗначенияОбъекта <> Неопределено Тогда
		ЗначенияОбъекта.Вставить(Свойство, Новый Структура("Значение", Значение));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
