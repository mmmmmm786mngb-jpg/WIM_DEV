
#Область СлужебныйПрограммныйИнтерфейс

// IMDEV-9529. Заглушка отправки FIX для тестовой копии
//
// В тестовой базе (см. Адаптеры.ЗаглушкаОтправкиFIXВключена) снимает у результатов проверки лимитов признаки
// нарушения: у всех строк таблицы очищается Зона (Красная, Желтая) и сбрасывается Отказ. Таблица передается по
// ссылке из Распорядители.ПроверкаИОтправка, поэтому после этого типовой код записывает поручениям статусы
// "Проверено"/"Ожидает отправки" и включает их в список на отправку. Контрольная ведомость и кэш проверки
// (КэшВм*) содержат фактические нарушения: они записываются до этого вызова.
// Действует на любую проверку поручений из блоттера или формы поручения, в том числе на "Проверить" без отправки.
// Поручения без назначенных лимитов (нет строк в таблице) по-прежнему не отправляются.
// В журнал регистрации пишется событие "IMDEV-9529.ЗаглушкаFIX" с числом поручений, у которых сняты нарушения.
// Вне тестовых баз ничего не делает.
//
// Параметры:
//  КэшВмКраткоПоручения - ТаблицаЗначений - результаты проверки по поручениям: Поручение, Лимит, Зона, Отказ.
//  КлючДоступа - УникальныйИдентификатор - ключ распорядителя (не используется).
//
&Перед("ЗаписатьСтатусыПоручений")
Процедура FO_SendFixStub_ЗаписатьСтатусыПоручений(КэшВмКраткоПоручения, КлючДоступа) Экспорт

	Если Не Адаптеры.ЗаглушкаОтправкиFIXВключена() Тогда
		Возврат;
	КонецЕсли;

	ПорученияСНарушениями = Новый Соответствие;
	ЗонаБезНарушений = Перечисления.ЗоныПроверкиЛимитов.ПустаяСсылка();
	Для Каждого СтрокаПроверки Из КэшВмКраткоПоручения Цикл
		Если СтрокаПроверки.Отказ Или ЗначениеЗаполнено(СтрокаПроверки.Зона) Тогда
			ПорученияСНарушениями.Вставить(СтрокаПроверки.Поручение, Истина);
		КонецЕсли;
		СтрокаПроверки.Зона = ЗонаБезНарушений;
		СтрокаПроверки.Отказ = Ложь;
	КонецЦикла;

	Поручения = КэшВмКраткоПоручения.Скопировать(, "Поручение");
	Поручения.Свернуть("Поручение");
	Комментарий = СтрШаблон(НСтр("ru = 'Нарушения лимитов проигнорированы: поручений %1 из %2'"),
		ПорученияСНарушениями.Количество(), Поручения.Количество());
	ЗаписьЖурналаРегистрации("IMDEV-9529.ЗаглушкаFIX", УровеньЖурналаРегистрации.Информация, , , Комментарий);

КонецПроцедуры

#КонецОбласти
