
#Область СлужебныйПрограммныйИнтерфейс

// IMDEV-9529. Заглушка отправки FIX для тестовой копии
//
// Дополняет список готовых к работе адаптеров поручений идентификаторами всех адаптеров вида FIX из регистра
// ИспользуемыеАдаптеры. Нужен в тестовой базе, где соединения с прокси нет и регламентная синхронизация не
// отмечает адаптер готовым. Состояние адаптеров в регистре СостоянияАдаптеров не меняет.
// Вне тестовых баз (см. ЗаглушкаОтправкиFIXВключена) возвращает результат типового метода без изменений.
//
// Возвращаемое значение:
//  Массив - идентификаторы используемых адаптеров, готовых к работе (как у типового метода).
//
&Вместо("АдаптерыПорученийГотовыеКРаботе")
Функция FO_SendFixStub_АдаптерыПорученийГотовыеКРаботе() Экспорт

	Результат = ПродолжитьВызов();
	Если Не ЗаглушкаОтправкиFIXВключена() Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИспользуемыеАдаптеры.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ИспользуемыеАдаптеры КАК ИспользуемыеАдаптеры
	|ГДЕ
	|	ИспользуемыеАдаптеры.Адаптер.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыАдаптеров.FIX)";

	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	Для Каждого Идентификатор Из РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Идентификатор") Цикл
		Если Результат.Найти(Идентификатор) = Неопределено Тогда
			Результат.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#Область ЗаглушкаОтправкиFIX

// IMDEV-9529. Заглушка отправки FIX для тестовой копии
//
// Определяет, работает ли заглушка отправки FIX в текущей информационной базе. Заглушка работает только в
// базах из списка РазрешенныеБазыЗаглушкиFIX: имя базы ищется в строке соединения как параметр Ref.
// В остальных базах, в том числе в PROD, перехватчики расширения вызывают типовой код без изменений.
//
// Возвращаемое значение:
//  Булево - Истина, если текущая информационная база есть в списке тестовых баз.
//
Функция ЗаглушкаОтправкиFIXВключена() Экспорт

	СтрокаСоединения = НРег(СтрокаСоединенияИнформационнойБазы());
	Для Каждого ИмяБазы Из РазрешенныеБазыЗаглушкиFIX() Цикл
		Если СтрНайти(СтрокаСоединения, НРег("Ref=""" + ИмяБазы + """")) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// IMDEV-9529. Заглушка отправки FIX для тестовой копии
//
// Записывает вызов команды отправки прокси FIX в JSON-файл вместо HTTP-запроса. Каталог файлов -
// КаталогВременныхФайлов() рабочего процесса сервера + "IMDEV-9529_FIX", по одному файлу на вызов; файлы не
// удаляются, это результат прогона для анализа. Вызывается внутри транзакции адаптера FIX: при откате
// транзакции файл остается. В журнал регистрации пишется событие "IMDEV-9529.ЗаглушкаFIX" с числом заявок
// NewOrderSingle (35=D), длиной тела и временем записи файла.
//
// Поля файла: command - команда прокси; utc_ms - момент вызова, мс UTC; guid - идентификатор адаптера для
// прокси; orders - число заявок 35=D в пакете; body_length - длина тела запроса; messages - раскодированный
// пакет FIX, разделитель полей SOH заменен на "|".
//
// Параметры:
//  Команда - Строка - команда прокси: "/send" (пакет заявок) или "send?params=..." (одно сообщение).
//  ТелоСтрокой - Строка - тело HTTP-запроса: JSON {guid, message}, message - URL-кодированный пакет FIX.
//
Процедура ЗаписатьВызовПроксиFIX(Команда, ТелоСтрокой) Экспорт

	НачалоЗаписи = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Каталог = КаталогВременныхФайлов() + "IMDEV-9529_FIX";
	СоздатьКаталог(Каталог);
	ИмяФайла = Каталог + ПолучитьРазделительПутиСервера()
		+ Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss") + "_" + Строка(Новый УникальныйИдентификатор) + ".json";

	ПараметрыЗапроса = ПараметрыЗапросаПроксиFIX(ТелоСтрокой);
	Сообщения = РаскодироватьСтроку(ПараметрыЗапроса.message, СпособКодированияСтроки.КодировкаURL);
	КоличествоЗаявок = СтрЧислоВхождений(Сообщения, Символ(1) + "35=D" + Символ(1));

	Данные = Новый Структура;
	Данные.Вставить("command",     Команда);
	Данные.Вставить("utc_ms",      НачалоЗаписи);
	Данные.Вставить("guid",        ПараметрыЗапроса.guid);
	Данные.Вставить("orders",      КоличествоЗаявок);
	Данные.Вставить("body_length", СтрДлина(ТелоСтрокой));
	Данные.Вставить("messages",    СтрЗаменить(Сообщения, Символ(1), "|"));

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл(ИмяФайла, "UTF-8");
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ЗаписьJSON.Закрыть();

	Комментарий = СтрШаблон(
		НСтр("ru = 'Команда %1, заявок 35=D: %2, длина тела %3, запись файла %4 мс, файл %5'"),
		Лев(Команда, 40), КоличествоЗаявок, СтрДлина(ТелоСтрокой),
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗаписи, ИмяФайла);
	ЗаписьЖурналаРегистрации("IMDEV-9529.ЗаглушкаFIX", УровеньЖурналаРегистрации.Информация, , , Комментарий);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаглушкаОтправкиFIXСлужебные

// IMDEV-9529. Заглушка отправки FIX для тестовой копии
//
// Список информационных баз, в которых работает заглушка отправки FIX. PROD в список не включается.
//
// Возвращаемое значение:
//  Массив из Строка - имена баз на сервере 1С (параметр Ref строки соединения).
//
Функция РазрешенныеБазыЗаглушкиFIX()

	Результат = Новый Массив;
	Результат.Добавить("AVC_PP_Retail_FO"); // тестовая копия PROD, розничное ДУ (Т-1)
	Результат.Добавить("AVC_PP_FO");        // тестовая копия PROD, обычное ДУ
	Результат.Добавить("WIN_FO_server");    // разработческая база ФО

	Возврат Результат;

КонецФункции

// IMDEV-9529. Заглушка отправки FIX для тестовой копии
//
// Разбирает тело запроса к прокси FIX. Тело собирает АдаптерFIX (СтрокаИзСтруктуры): JSON с полями guid и
// message. Если тело пустое или не разбирается как JSON, возвращает пустые значения; ошибка разбора
// записывается в журнал регистрации, запись файла заглушкой продолжается.
//
// Параметры:
//  ТелоСтрокой - Строка - тело HTTP-запроса к прокси.
//
// Возвращаемое значение:
//  Структура - параметры запроса:
//   * guid    - Строка - идентификатор адаптера для прокси.
//   * message - Строка - URL-кодированный пакет FIX.
//
Функция ПараметрыЗапросаПроксиFIX(ТелоСтрокой)

	Результат = Новый Структура("guid, message", "", "");
	Если Не ЗначениеЗаполнено(ТелоСтрокой) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоСтрокой);
		ЗаполнитьЗначенияСвойств(Результат, ПрочитатьJSON(ЧтениеJSON));
		ЧтениеJSON.Закрыть();
	Исключение
		ЗаписьЖурналаРегистрации("IMDEV-9529.ЗаглушкаFIX", УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.message = "";
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти
