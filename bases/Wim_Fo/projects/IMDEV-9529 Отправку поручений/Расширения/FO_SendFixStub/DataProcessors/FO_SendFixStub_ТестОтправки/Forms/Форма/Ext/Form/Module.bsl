
#Область ОбработчикиСобытийФормы

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Открывает форму только в тестовых базах (см. Адаптеры.ЗаглушкаОтправкиFIXВключена) и задает значения по
// умолчанию: период "Сегодня" (как в блоттере), не больше 1000 поручений, отправка фоновым заданием.
//
// Параметры:
//  Отказ - Булево - Истина, если база не тестовая.
//  СтандартнаяОбработка - Булево - не используется.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не Адаптеры.ЗаглушкаОтправкиFIXВключена() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'IMDEV-9529: обработка работает только в тестовых базах с заглушкой отправки FIX.'"), , , , Отказ);
		Возврат;
	КонецЕсли;

	Объект.Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.Сегодня);
	Объект.МаксимумПоручений = 1000;
	Объект.ФоновымЗаданием = Истина;
	Итог = НСтр("ru = 'Укажите период и нажмите ""Найти"".'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Заполняет список поручениями периода, не больше заданного числа, и запоминает отбор.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура НайтиПоручения(Команда)

	НайтиНаСервере();

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Подготавливает к отправке выделенные поручения после подтверждения пользователя.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Подготовить(Команда)

	Если Не ОтборАктуален() Тогда
		Возврат;
	КонецЕсли;

	Идентификаторы = ВыделенныеИдентификаторы();
	Если Не ЗначениеЗаполнено(Идентификаторы) Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Выделите поручения в списке.'"));
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Подготовить к отправке поручений: %1?
		|Статусы поручений в тестовой базе будут изменены на ""Проверено"", биржевые номера очищены.'"),
		Идентификаторы.Количество());
	Оповещение = Новый ОписаниеОповещения("ПодготовитьПослеВопроса", ЭтотОбъект, Идентификаторы);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Отправляет выделенные подготовленные поручения типовым распорядителем отправки. Если среди выделенных есть
// неподготовленные, спрашивает, отправлять ли только подготовленные.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Отправить(Команда)

	Если Не ОтборАктуален() Тогда
		Возврат;
	КонецЕсли;

	Идентификаторы = ВыделенныеИдентификаторы();
	Если Не ЗначениеЗаполнено(Идентификаторы) Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Выделите поручения в списке.'"));
		Возврат;
	КонецЕсли;

	Подготовленные = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Если Поручения.НайтиПоИдентификатору(Идентификатор).Подготовлено Тогда
			Подготовленные.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Подготовленные) Тогда
		ТекстПредупреждения = НСтр("ru = 'Среди выделенных нет подготовленных поручений. Сначала нажмите ""Подготовить"".'");
		ПоказатьПредупреждение( , ТекстПредупреждения);
		Возврат;
	КонецЕсли;

	Неподготовленных = Идентификаторы.Количество() - Подготовленные.Количество();
	Если Неподготовленных = 0 Тогда
		НачатьОтправку(Подготовленные);
		Возврат;
	КонецЕсли;

	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Среди выделенных строк не подготовлено: %1.
		|Отправить только подготовленные поручения (%2)?'"),
		Неподготовленных, Подготовленные.Количество());
	Оповещение = Новый ОписаниеОповещения("ОтправитьПослеВопроса", ЭтотОбъект, Подготовленные);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ТестОтправки

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Продолжение команды "Подготовить" после вопроса.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  Идентификаторы - Массив из Число - идентификаторы выделенных строк списка.
//
&НаКлиенте
Процедура ПодготовитьПослеВопроса(Ответ, Идентификаторы) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ПодготовитьНаСервере(Идентификаторы);

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Продолжение команды "Отправить" после вопроса об отправке только подготовленных поручений.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  Идентификаторы - Массив из Число - идентификаторы подготовленных строк.
//
&НаКлиенте
Процедура ОтправитьПослеВопроса(Ответ, Идентификаторы) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	НачатьОтправку(Идентификаторы);

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Запускает отправку. В режиме фонового задания ждет завершения длительной операции БСП с окном ожидания; в режиме
// текущего вызова результат заполняется сразу на сервере.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы подготовленных строк.
//
&НаКлиенте
Процедура НачатьОтправку(Идентификаторы)

	ДлительнаяОперация = НачатьОтправкуНаСервере(Идентификаторы);
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Отправка поручений...'");
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.РазрешитьОтмену = Ложь;
	Оповещение = Новый ОписаниеОповещения("ОтправкаЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Обработчик завершения длительной операции отправки.
//
// Параметры:
//  Результат - Структура, Неопределено - результат длительной операции БСП (Статус, ПодробноеПредставлениеОшибки).
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура ОтправкаЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ОписаниеОшибки = "";
	Если Результат = Неопределено Тогда
		ОписаниеОшибки = НСтр("ru = 'Ожидание отправки прервано.'");
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОписаниеОшибки = Результат.ПодробноеПредставлениеОшибки;
	КонецЕсли;

	ЗавершитьОтправкуНаСервере(ОписаниеОшибки);

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Проверяет, что после "Найти" отбор не менялся: команды работают только со списком, найденным по текущему отбору.
//
// Возвращаемое значение:
//  Булево - Истина, если отбор актуален.
//
&НаКлиенте
Функция ОтборАктуален()

	Если Не ЗначениеЗаполнено(КлючОтбора) Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Сначала нажмите ""Найти"".'"));
		Возврат Ложь;
	КонецЕсли;

	Если КлючОтбора <> КлючТекущегоОтбора(Объект.Период, Объект.МаксимумПоручений) Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Отбор изменен после поиска. Нажмите ""Найти"".'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Идентификаторы выделенных строк списка поручений.
//
// Возвращаемое значение:
//  Массив из Число
//
&НаКлиенте
Функция ВыделенныеИдентификаторы()

	Результат = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Поручения.ВыделенныеСтроки Цикл
		Результат.Добавить(Идентификатор);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Строковый ключ отбора: границы периода и ограничение числа поручений.
//
// Параметры:
//  Период - СтандартныйПериод
//  МаксимумПоручений - Число
//
// Возвращаемое значение:
//  Строка
//
&НаКлиентеНаСервереБезКонтекста
Функция КлючТекущегоОтбора(Период, МаксимумПоручений)

	Возврат Формат(Период.ДатаНачала, "ДФ=yyyyMMddHHmmss") + "-" + Формат(Период.ДатаОкончания, "ДФ=yyyyMMddHHmmss")
		+ "-" + Формат(МаксимумПоручений, "ЧН=0; ЧГ=0");

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Заполняет список поручениями по отбору формы.
//
&НаСервере
Процедура НайтиНаСервере()

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НайденныеПоручения = Обработки.FO_SendFixStub_ТестОтправки.НайтиПоручения(Объект.Период, Объект.МаксимумПоручений);
	Поручения.Загрузить(НайденныеПоручения);
	КлючОтбора = КлючТекущегоОтбора(Объект.Период, Объект.МаксимумПоручений);

	Итог = СтрШаблон(НСтр("ru = 'Найдено поручений: %1 (%2 мс). Выделите строки и нажмите ""Подготовить"".'"),
		Поручения.Количество(), ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс);

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Подготавливает поручения выделенных строк и обновляет в списке статус, отметку "Подготовлено" и результат.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы выделенных строк.
//
&НаСервере
Процедура ПодготовитьНаСервере(Знач Идентификаторы)

	СтрокиСписка = СтрокиПоИдентификаторам(Идентификаторы);
	МассивПоручений = ПорученияСтрок(СтрокиСписка);

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОшибкиПоручений = Обработки.FO_SendFixStub_ТестОтправки.ПодготовитьПоручения(МассивПоручений);
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Статусы = Обработки.FO_SendFixStub_ТестОтправки.СтатусыПорученийСтрокой(МассивПоручений);

	Ошибок = 0;
	Для Каждого СтрокаСписка Из СтрокиСписка Цикл
		ОписаниеОшибки = ОшибкиПоручений.Получить(СтрокаСписка.Поручение);
		СтрокаСписка.Подготовлено = Не ЗначениеЗаполнено(ОписаниеОшибки);
		СтрокаСписка.Статус = Статусы.Получить(СтрокаСписка.Поручение);
		Если СтрокаСписка.Подготовлено Тогда
			СтрокаСписка.Результат = НСтр("ru = 'Подготовлено'");
		Иначе
			СтрокаСписка.Результат = ОписаниеОшибки;
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;

	Итог = СтрШаблон(НСтр("ru = 'Подготовлено поручений: %1 из %2, ошибок: %3 (%4 мс).
		|Включите замер в отладчике, выделите подготовленные строки и нажмите ""Отправить"".'"),
		СтрокиСписка.Количество() - Ошибок, СтрокиСписка.Количество(), Ошибок, ДлительностьМс);

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Запускает отправку поручений выделенных строк и запоминает, что отправлялось. В режиме текущего вызова сервера
// сразу заполняет результат.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы подготовленных строк.
//
// Возвращаемое значение:
//  Структура, Неопределено - длительная операция БСП; Неопределено, если отправка выполнена в текущем вызове.
//
&НаСервере
Функция НачатьОтправкуНаСервере(Знач Идентификаторы)

	МассивПоручений = ПорученияСтрок(СтрокиПоИдентификаторам(Идентификаторы));
	ОтправляемыеПоручения.ЗагрузитьЗначения(МассивПоручений);

	Запуск = Обработки.FO_SendFixStub_ТестОтправки.НачатьОтправку(МассивПоручений, Объект.ФоновымЗаданием,
		УникальныйИдентификатор);
	АдресРезультатаРасш = Запуск.АдресРезультатаРасш;
	НачалоОтправки = Запуск.НачалоМс;

	Если Запуск.ДлительнаяОперация = Неопределено Тогда
		ЗавершитьОтправкуНаСервере("");
	КонецЕсли;

	Возврат Запуск.ДлительнаяОперация;

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Заполняет в списке статус и результат отправленных поручений и итог: число отправленных и отклоненных, время по
// часам формы и время ключевой операции "Отправка". Отправленные поручения снова требуют подготовки.
//
// Параметры:
//  ОписаниеОшибкиОперации - Строка - ошибка длительной операции, если была.
//
&НаСервере
Процедура ЗавершитьОтправкуНаСервере(Знач ОписаниеОшибкиОперации)

	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОтправки;
	МассивПоручений = ОтправляемыеПоручения.ВыгрузитьЗначения();
	РезультатОтправки = Обработки.FO_SendFixStub_ТестОтправки.РезультатОтправки(МассивПоручений,
		АдресРезультатаРасш, НачалоОтправки);

	Для Каждого Поручение Из МассивПоручений Цикл
		Сведения = РезультатОтправки.Поручения.Получить(Поручение);
		Для Каждого СтрокаСписка Из Поручения.НайтиСтроки(Новый Структура("Поручение", Поручение)) Цикл
			СтрокаСписка.Статус = Сведения.Статус;
			СтрокаСписка.Подготовлено = Ложь;
			СтрокаСписка.Результат = Сведения.Описание;
			Если Не ЗначениеЗаполнено(СтрокаСписка.Результат) Тогда
				СтрокаСписка.Результат = Сведения.Статус;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ТекстЗамера = НСтр("ru = 'запись ключевой операции ""Отправка"" не найдена (выключены замеры производительности?)'");
	Если РезультатОтправки.ВремяКлючевойОперации <> Неопределено Тогда
		ТекстЗамера = СтрШаблон(НСтр("ru = 'ключевая операция ""Отправка"": %1 с, вес %2'"),
			Формат(РезультатОтправки.ВремяКлючевойОперации, "ЧДЦ=3; ЧН=0"), РезультатОтправки.ВесКлючевойОперации);
	КонецЕсли;

	Итог = СтрШаблон(НСтр("ru = 'Отправка %1 поручений: отправлено %2, отклонено %3. Время по часам формы %4 мс; %5.'"),
		МассивПоручений.Количество(), РезультатОтправки.Отправлено, РезультатОтправки.Отклонено, ДлительностьМс,
		ТекстЗамера);

	ОписаниеОшибки = СокрЛП(ОписаниеОшибкиОперации + Символы.ПС + РезультатОтправки.ОписаниеОшибки);
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Итог = Итог + Символы.ПС + НСтр("ru = 'Ошибка:'") + " " + ОписаниеОшибки;
	КонецЕсли;

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Строки списка поручений по идентификаторам.
//
// Параметры:
//  Идентификаторы - Массив из Число
//
// Возвращаемое значение:
//  Массив из ДанныеФормыЭлементКоллекции
//
&НаСервере
Функция СтрокиПоИдентификаторам(Идентификаторы)

	Результат = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокаСписка = Поручения.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаСписка <> Неопределено Тогда
			Результат.Добавить(СтрокаСписка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Ссылки на поручения строк списка.
//
// Параметры:
//  СтрокиСписка - Массив из ДанныеФормыЭлементКоллекции
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.Поручение
//
&НаСервере
Функция ПорученияСтрок(СтрокиСписка)

	Результат = Новый Массив;
	Для Каждого СтрокаСписка Из СтрокиСписка Цикл
		Результат.Добавить(СтрокаСписка.Поручение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти
