#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Находит поручения для тестовой отправки: проведенные биржевые поручения с адаптером вида FIX, дата которых
// попадает в период (как отбор периода в блоттере - по дате поручения). Данные не изменяет.
//
// Параметры:
//  Период - СтандартныйПериод - период по дате поручения.
//  МаксимумПоручений - Число - не больше стольких поручений, первые по дате; 0 - без ограничения.
//
// Возвращаемое значение:
//  ТаблицаЗначений - поручения по возрастанию даты:
//   * Поручение - ДокументСсылка.Поручение
//   * Портфель - СправочникСсылка.Портфели
//   * Актив - СправочникСсылка.Активы
//   * Направление - ПеречислениеСсылка.ВидыОперацийСделки
//   * КоличествоЛотов - Число
//   * Цена - Число - цена в валюте расчетов.
//   * Статус - Строка - текущий статус поручения (СтатусыПоручений.СтатусСтрокой).
//
Функция НайтиПоручения(Знач Период, Знач МаксимумПоручений) Экспорт

	ПроверитьТестовуюБазу();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 999999999 РАЗРЕШЕННЫЕ
	|	Поручения.Ссылка КАК Поручение,
	|	Поручения.Портфель КАК Портфель,
	|	Поручения.Актив КАК Актив,
	|	Поручения.Направление КАК Направление,
	|	Поручения.КоличествоЛотов КАК КоличествоЛотов,
	|	Поручения.ЦенаВВалютеРасчетов КАК Цена,
	|	ЕСТЬNULL(СтатусыПоручений.СтатусСтрокой, """") КАК Статус
	|ИЗ
	|	Документ.Поручение КАК Поручения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РасширенияПоручений КАК РасширенияПоручений
	|		ПО Поручения.Ссылка = РасширенияПоручений.Поручение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПоручений КАК СтатусыПоручений
	|		ПО Поручения.Ссылка = СтатусыПоручений.Поручение
	|ГДЕ
	|	Поручения.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Поручения.Проведен
	|	И НЕ Поручения.Внебиржевая
	|	И РасширенияПоручений.Адаптер.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыАдаптеров.FIX)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поручения.Дата,
	|	Поручения.Ссылка";

	Если МаксимумПоручений > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 999999999", "ПЕРВЫЕ " + Формат(Цел(МаксимумПоручений), "ЧГ=0"));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 999999999 ", "");
	КонецЕсли;
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	КонецПериода = Период.ДатаОкончания;
	Если Не ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода = Дата(3999, 12, 31, 23, 59, 59);
	КонецЕсли;
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Приводит поручения в состояние "после успешной проверки лимитов", без расчета лимитов. По каждому поручению в
// своей транзакции: статус "Ожидает проверки" (типовые связи статусов снимают все прочие признаки: исполнение,
// отправку, отмену, "Проверка не пройдена"), очистка биржевого номера (регистр БиржевыеЗаявки), статус
// "Проверено" и, если в сеансе не включена ручная отправка, "Ожидает отправки" - как в
// ИсполнителиПолныеПрава.ЗаписатьСтатусыПоручений; снятие блокировки поручения. Документы поручений не изменяются.
// Статусы пишутся с мастер-ключом, поэтому блокировка поручения другим распорядителем не мешает.
// В конце обрабатываются поручения, сменившие статус (как в завершении распорядителя), чтобы эта работа не
// попала в последующую отправку в том же сеансе.
//
// Параметры:
//  Поручения - Массив из ДокументСсылка.Поручение - выделенные поручения.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ДокументСсылка.Поручение
//   * Значение - Строка - пустая строка при успехе, иначе описание ошибки.
//
Функция ПодготовитьПоручения(Знач Поручения) Экспорт

	ПроверитьТестовуюБазу();

	Результат = Новый Соответствие;
	МастерКлюч = АдаптерыКлиентСервер.МастерКлюч();
	СтатусыПоручений = РегистрыСведений.СтатусыПоручений;

	УстановитьПривилегированныйРежим(Истина);
	ОтправлятьТолькоВручную = ПолныеПрава.ОтправлятьПорученияТолькоВручную();

	Для Каждого Поручение Из Поручения Цикл
		НачатьТранзакцию();
		Попытка
			СтатусыПоручений.УстановитьОжидаетПроверки(Поручение, МастерКлюч);
			ОчиститьНомерБиржевой(Поручение);
			СтатусыПоручений.УстановитьПроверено(Поручение, МастерКлюч);
			Если Не ОтправлятьТолькоВручную Тогда
				СтатусыПоручений.УстановитьОжидаетОтправки(Поручение, МастерКлюч);
			КонецЕсли;
			РегистрыСведений.СтатусыПорученийБлокировки.РазблокироватьПоручение(Поручение);
			Результат.Вставить(Поручение, "");
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("IMDEV-9529.ТестОтправки", УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.Поручение, Поручение, ТекстОшибки);
			Результат.Вставить(Поручение, ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	ТорговаяЧасть.ОбработатьПорученияСменившиеСтатус();
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Запускает типовую отправку поручений так же, как блок отправки в Распорядители.ПроверкаИОтправка после проверки
// лимитов: переопределение адаптеров (РасширенияПоручений.ПереопределитьАдаптеры), параметры
// РаспорядителиВызовСервера.ПараметрыОтправки, запуск распорядителя Распорядители.Отправка через
// РаспорядителиВызовСервера.ВыполнитьРаспоряжение - фоновым заданием (длительная операция БСП) или в текущем вызове
// сервера. Распорядитель сам пишет ключевую операцию "Отправка". Сеть не вызывается: в тестовой базе адаптер FIX
// перехватывается заглушкой расширения.
//
// Параметры:
//  Поручения - Массив из ДокументСсылка.Поручение - подготовленные поручения.
//  ФоновымЗаданием - Булево - Истина: длительная операция БСП (как в блоттере); Ложь: в текущем вызове сервера.
//  ИдентификаторФормы - УникальныйИдентификатор - для временного хранилища и длительной операции.
//
// Возвращаемое значение:
//  Структура - запуск отправки:
//   * ДлительнаяОперация - Структура, Неопределено - см. ДлительныеОперации.ВыполнитьВФоне; Неопределено, если отправка
//                          выполнена в текущем вызове.
//   * АдресРезультатаРасш - Строка - адрес расширенного результата распорядителя (таблица РезультатОбработки).
//   * НачалоМс - Число - момент запуска, мс UTC (для поиска записи ключевой операции).
//
Функция НачатьОтправку(Знач Поручения, Знач ФоновымЗаданием, Знач ИдентификаторФормы) Экспорт

	ПроверитьТестовуюБазу();

	Результат = Новый Структура("ДлительнаяОперация, АдресРезультатаРасш, НачалоМс");
	Результат.НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	УстановитьПривилегированныйРежим(Истина);
	РегистрыСведений.РасширенияПоручений.ПереопределитьАдаптеры(Поручения);
	УстановитьПривилегированныйРежим(Ложь);

	Указания = РаспорядителиВызовСервера.ПараметрыОтправки();
	Указания.Поручения = Поручения;
	Указания.ИспользоватьФоновыеЗадания = ФоновымЗаданием;
	Указания.ИдентификаторФормы = ИдентификаторФормы;
	Указания.АдресРезультатаРасш = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
	Указания.Удалить("ФормаИнициатор");
	Результат.АдресРезультатаРасш = Указания.АдресРезультатаРасш;

	Запуск = РаспорядителиВызовСервера.ВыполнитьРаспоряжение(Указания);
	Если ФоновымЗаданием Тогда
		Результат.ДлительнаяОперация = Запуск;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Собирает результат завершенной отправки: результат обработки по поручениям из расширенного результата
// распорядителя, текущие статусы поручений и запись ключевой операции "Отправка", сделанную распорядителем после
// момента запуска. Данные не изменяет.
//
// Параметры:
//  Поручения - Массив из ДокументСсылка.Поручение - отправлявшиеся поручения.
//  АдресРезультатаРасш - Строка - см. НачатьОтправку.
//  НачалоМс - Число - см. НачатьОтправку.
//
// Возвращаемое значение:
//  Структура - результат:
//   * Поручения - Соответствие из КлючИЗначение - ключ ДокументСсылка.Поручение, значение Структура:
//      ** Статус - Строка - статус поручения после отправки.
//      ** Описание - Строка - описание из результата обработки распорядителя.
//      ** Отправлено - Булево - статус "Отправлено, ожидается подтверждение".
//   * Отправлено - Число - поручений в статусе "Отправлено, ожидается подтверждение".
//   * Отклонено - Число - остальные поручения.
//   * ОписаниеОшибки - Строка - ошибка распорядителя, если была.
//   * ВремяКлючевойОперации - Число, Неопределено - длительность ключевой операции "Отправка", с; Неопределено,
//                             если запись не найдена (например, выключены замеры производительности).
//   * ВесКлючевойОперации - Число, Неопределено - вес записи ключевой операции.
//
Функция РезультатОтправки(Знач Поручения, Знач АдресРезультатаРасш, Знач НачалоМс) Экспорт

	ПроверитьТестовуюБазу();

	Результат = Новый Структура;
	Результат.Вставить("Поручения", Новый Соответствие);
	Результат.Вставить("Отправлено", 0);
	Результат.Вставить("Отклонено", 0);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ВремяКлючевойОперации", Неопределено);
	Результат.Вставить("ВесКлючевойОперации", Неопределено);

	ОписанияПоручений = Новый Соответствие;
	РезультатРасш = ПолучитьИзВременногоХранилища(АдресРезультатаРасш);
	Если ТипЗнч(РезультатРасш) = Тип("Структура") Тогда
		Результат.ОписаниеОшибки = РезультатРасш.ОписаниеОшибки;
		Для Каждого СтрокаРезультата Из РезультатРасш.РезультатОбработки Цикл
			ОписанияПоручений.Вставить(СтрокаРезультата.Поручение, СтрокаРезультата.Описание);
		КонецЦикла;
	Иначе
		Результат.ОписаниеОшибки = НСтр("ru = 'Распорядитель не вернул результат обработки поручений'");
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	ТекущиеСтатусы = ТекущиеСтатусыПоручений(Поручения);
	Отправлено = Перечисления.СтатусыПоручений.ОтправленоОжидаетсяПодтверждение;
	Для Каждого Поручение Из Поручения Цикл
		СведенияПоручения = Новый Структура("Статус, Описание, Отправлено", "", "", Ложь);
		ДанныеСтатуса = ТекущиеСтатусы.Получить(Поручение);
		Если ДанныеСтатуса <> Неопределено Тогда
			СведенияПоручения.Статус = ДанныеСтатуса.СтатусСтрокой;
			СведенияПоручения.Отправлено = ДанныеСтатуса.Статус = Отправлено;
		КонецЕсли;
		Описание = ОписанияПоручений.Получить(Поручение);
		Если Описание <> Неопределено Тогда
			СведенияПоручения.Описание = Описание;
		КонецЕсли;
		ПоручениеОтправлено = СведенияПоручения.Отправлено;
		Результат.Поручения.Вставить(Поручение, СведенияПоручения);
		Если ПоручениеОтправлено Тогда
			Результат.Отправлено = Результат.Отправлено + 1;
		Иначе
			Результат.Отклонено = Результат.Отклонено + 1;
		КонецЕсли;
	КонецЦикла;

	ЗаписьЗамера = ЗаписьКлючевойОперацииОтправка(НачалоМс);
	Если ЗаписьЗамера <> Неопределено Тогда
		Результат.ВремяКлючевойОперации = ЗаписьЗамера.ВремяВыполнения;
		Результат.ВесКлючевойОперации = ЗаписьЗамера.ВесЗамера;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Текущие статусы поручений строкой, для обновления списка формы. Данные не изменяет.
//
// Параметры:
//  Поручения - Массив из ДокументСсылка.Поручение
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ ДокументСсылка.Поручение, значение Строка (СтатусыПоручений.СтатусСтрокой).
//
Функция СтатусыПорученийСтрокой(Знач Поручения) Экспорт

	ПроверитьТестовуюБазу();

	Результат = Новый Соответствие;
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого КлючИЗначение Из ТекущиеСтатусыПоручений(Поручения) Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение.СтатусСтрокой);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Вызывает исключение, если текущая база не тестовая (см. Адаптеры.ЗаглушкаОтправкиFIXВключена). Защищает от
// изменения статусов и отправки поручений обработкой в PROD.
//
Процедура ПроверитьТестовуюБазу() Экспорт

	Если Не Адаптеры.ЗаглушкаОтправкиFIXВключена() Тогда
		ВызватьИсключение НСтр("ru = 'IMDEV-9529: обработка работает только в тестовых базах с заглушкой отправки FIX.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ТестОтправкиСлужебные

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Очищает биржевой номер заявки поручения в регистре БиржевыеЗаявки (как команда "В Prelim" расширения
// FO_BlotterPrelim): с заполненным номером типовая проверка запрещает отправку. Внутренний номер не меняется.
//
// Параметры:
//  Поручение - ДокументСсылка.Поручение
//
Процедура ОчиститьНомерБиржевой(Поручение)

	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.БиржевыеЗаявки");
	ЭлементБлокировки.УстановитьЗначение("Поручение", Поручение);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаДанных.Заблокировать();

	НаборЗаписей = РегистрыСведений.БиржевыеЗаявки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Поручение.Установить(Поручение);
	НаборЗаписей.Прочитать();
	Если Не ЗначениеЗаполнено(НаборЗаписей) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.НомерБиржевой = "";
	КонецЦикла;
	НаборЗаписей.Записать();

КонецПроцедуры

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Читает текущие записи регистра СтатусыПоручений одним запросом. Вызывается в привилегированном режиме.
//
// Параметры:
//  Поручения - Массив из ДокументСсылка.Поручение
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ ДокументСсылка.Поручение, значение Структура:
//   * Статус - ПеречислениеСсылка.СтатусыПоручений
//   * СтатусСтрокой - Строка
//
Функция ТекущиеСтатусыПоручений(Поручения)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтатусыПоручений.Поручение КАК Поручение,
	|	СтатусыПоручений.Статус КАК Статус,
	|	СтатусыПоручений.СтатусСтрокой КАК СтатусСтрокой
	|ИЗ
	|	РегистрСведений.СтатусыПоручений КАК СтатусыПоручений
	|ГДЕ
	|	СтатусыПоручений.Поручение В (&Поручения)";
	Запрос.УстановитьПараметр("Поручения", Поручения);

	Результат = Новый Соответствие;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Поручение, Новый Структура("Статус, СтатусСтрокой", Выборка.Статус, Выборка.СтатусСтрокой));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// IMDEV-9529. Тест отправки поручений без проверки лимитов
//
// Последняя запись ключевой операции "Отправка" текущего сеанса или его фоновых заданий, начатая не раньше момента
// запуска отправки. Вызывается в привилегированном режиме.
//
// Параметры:
//  НачалоМс - Число - момент запуска отправки, мс UTC.
//
// Возвращаемое значение:
//  Структура, Неопределено - ВремяВыполнения (с) и ВесЗамера; Неопределено, если записи нет.
//
Функция ЗаписьКлючевойОперацииОтправка(НачалоМс)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 РАЗРЕШЕННЫЕ
	|	ЗамерыВремени.ВремяВыполнения КАК ВремяВыполнения,
	|	ЗамерыВремени.ВесЗамера КАК ВесЗамера
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК ЗамерыВремени
	|ГДЕ
	|	ЗамерыВремени.КлючеваяОперация = ЗНАЧЕНИЕ(Справочник.КлючевыеОперации.Отправка)
	|	И ЗамерыВремени.ДатаНачалаЗамера >= &НачалоМс
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗамерыВремени.ДатаНачалаЗамера УБЫВ";
	Запрос.УстановитьПараметр("НачалоМс", НачалоМс);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("ВремяВыполнения, ВесЗамера", Выборка.ВремяВыполнения, Выборка.ВесЗамера);

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
