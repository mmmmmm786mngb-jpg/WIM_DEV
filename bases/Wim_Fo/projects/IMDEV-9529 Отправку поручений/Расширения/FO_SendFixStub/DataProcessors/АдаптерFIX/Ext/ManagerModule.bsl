// IMDEV-9529. Заглушка отправки FIX для тестовой копии
//
// Заменяет сетевой вызов прокси FIX в тестовой базе (см. Адаптеры.ЗаглушкаОтправкиFIXВключена):
// - команды отправки "/send" и "send?params=..." не уходят в прокси: тело запроса записывается в JSON-файл
//   (Адаптеры.ЗаписатьВызовПроксиFIX), возвращается успешный ответ "{}";
// - остальные команды прокси (connect, disconnect, get, getinfo, getstatus, confirm) не выполняются:
//   Доклад.Отказ = Истина с описанием "вызов прокси отключен заглушкой".
// В тестовой базе типовой метод НАМЕРЕННО не вызывается: ни один HTTP-запрос к прокси не выполняется.
// Вне тестовых баз вызывает типовой метод через ПродолжитьВызов без изменений.
//
// Параметры:
//  Команда - Строка - команда прокси с параметрами строки запроса.
//  ТелоСтрокой - Строка - тело HTTP-запроса; пустое для команд без тела.
//  Доклад - Структура, Неопределено - контейнер результата (Адаптеры.КонтейнерРезультата): Отказ, Описание,
//           ПревышеноВремяОжидания, ОшибкаАвторизации.
//  Таймаут - Число - таймаут HTTP-соединения, с (в заглушке не используется).
//
// Возвращаемое значение:
//  Строка, Неопределено - "{}" для команд отправки; Неопределено для остальных команд.
//
&Вместо("ОтправитьФизически")
Функция FO_SendFixStub_ОтправитьФизически(Команда, ТелоСтрокой = "", Доклад = Неопределено, Таймаут = 2)

	Если Не Адаптеры.ЗаглушкаОтправкиFIXВключена() Тогда
		Возврат ПродолжитьВызов(Команда, ТелоСтрокой, Доклад, Таймаут);
	КонецЕсли;

	Доклад = Адаптеры.КонтейнерРезультата(Доклад);
	Если СтрНачинаетсяС(СтрЗаменить(Команда, "/", ""), "send") Тогда
		Адаптеры.ЗаписатьВызовПроксиFIX(Команда, ТелоСтрокой);
		Возврат "{}";
	КонецЕсли;

	Доклад.Отказ = Истина;
	Доклад.Описание = СтрШаблон(НСтр("ru = 'IMDEV-9529: вызов прокси %1 отключен заглушкой'"), Лев(Команда, 40));
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#КонецЕсли
