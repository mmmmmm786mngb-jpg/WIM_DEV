#Область ПрограммныйИнтерфейс

// IMDEV-9529. Замер сложения строк пакета FIX
//
// Повторяет накопление пакета FIX в Обработка.АдаптерFIX.ДополнитьПакет (ПакетСообщений = ПакетСообщений + Сообщение)
// и для сравнения - сборку того же пакета через массив и СтрСоединить. Ничего не записывает.
//
// Параметры:
//  КоличествоСообщений - Число - сколько сообщений добавить в пакет.
//  ДлинаСообщения - Число - длина одного сообщения, символов.
//
// Возвращаемое значение:
//  Структура - результат замера:
//   * МсСложение - Число - время накопления пакета сложением строк, мс.
//   * МсСтрСоединить - Число - время сборки того же пакета через массив и СтрСоединить, мс.
//   * ДлинаПакета - Число - длина собранного пакета, символов.
//
Функция Замер(КоличествоСообщений, ДлинаСообщения) Экспорт

	Сообщение = Лев(СтрЗаменить(Формат(0, "ЧЦ=" + ДлинаСообщения + "; ЧН=; ЧВН="), " ", "0"), ДлинаСообщения);
	Пока СтрДлина(Сообщение) < ДлинаСообщения Цикл
		Сообщение = Сообщение + "8=FIX.4.2|35=D|";
	КонецЦикла;
	Сообщение = Лев(Сообщение, ДлинаСообщения);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПакетСообщений = "";
	Для Номер = 1 По КоличествоСообщений Цикл
		ПакетСообщений = ПакетСообщений + Сообщение;
	КонецЦикла;
	МсСложение = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Части = Новый Массив;
	Для Номер = 1 По КоличествоСообщений Цикл
		Части.Добавить(Сообщение);
	КонецЦикла;
	ПакетСоединенный = СтрСоединить(Части);
	МсСтрСоединить = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Результат = Новый Структура;
	Результат.Вставить("МсСложение", МсСложение);
	Результат.Вставить("МсСтрСоединить", МсСтрСоединить);
	Результат.Вставить("ДлинаПакета", СтрДлина(ПакетСообщений) + СтрДлина(ПакетСоединенный) * 0);

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
