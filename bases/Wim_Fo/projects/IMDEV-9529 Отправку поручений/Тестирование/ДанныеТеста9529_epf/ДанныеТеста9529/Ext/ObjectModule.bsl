#Область ПрограммныйИнтерфейс

// IMDEV-9529. Тестовые данные для проверки обработки отправки на разработческой базе
//
// Записывает поручениям торговый счет и режим торгов (без проведения, ОбменДанными.Загрузка). Используется тестом
// test_processing_dev.py: у поручений разработческой базы эти реквизиты пусты, и типовая проверка перед отправкой
// отклоняет поручения. Тот же вызов возвращает исходные значения после теста. Вызывается фоновым заданием
// ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки: модуль объекта документа Поручение во внешнем
// соединении не инициализируется. Работает только в разработческой базе WIN_FO_server.
//
// Параметры:
//  Параметры - Массив из Структура - по строке на поручение:
//   * Поручение - ДокументСсылка.Поручение
//   * ТорговыйСчет - СправочникСсылка.ТорговыеСчета
//   * РежимТоргов - СправочникСсылка.РежимыТоргов
//  АдресХранилища - Строка, Неопределено - не используется.
//
Процедура ЗаполнитьРеквизитыПоручений(Параметры, АдресХранилища) Экспорт

	Если СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), НРег("Ref=""WIN_FO_server""")) = 0 Тогда
		ВызватьИсключение "IMDEV-9529: тестовые данные меняются только в разработческой базе WIN_FO_server";
	КонецЕсли;

	Для Каждого ДанныеПоручения Из Параметры Цикл
		ПоручениеОбъект = ДанныеПоручения.Поручение.ПолучитьОбъект();
		ПоручениеОбъект.ТорговыйСчет = ДанныеПоручения.ТорговыйСчет;
		ПоручениеОбъект.РежимТоргов = ДанныеПоручения.РежимТоргов;
		ПоручениеОбъект.ОбменДанными.Загрузка = Истина;
		ПоручениеОбъект.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
