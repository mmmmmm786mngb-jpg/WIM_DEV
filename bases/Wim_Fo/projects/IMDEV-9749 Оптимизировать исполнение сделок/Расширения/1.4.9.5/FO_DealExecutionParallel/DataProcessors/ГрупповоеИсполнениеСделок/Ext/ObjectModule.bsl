#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

&ИзменениеИКонтроль("СоздатьДокументыИсполнения")
Процедура FO_DealExecutionParallel_СоздатьДокументыИсполнения(РегламентноеЗадание = Ложь, ОбъектыНазначения = Неопределено) Экспорт

	Если РегламентноеЗадание Тогда
		ЗаполнитьТаблицуСделок();
	КонецЕсли;

	ДатаДокумента = ?(ЗначениеЗаполнено(НаДату), НаДату, ТекущаяДатаСеанса());

	СозданныеДокументы = Новый Массив;

#Удаление
	Для Каждого Стр Из Сделки Цикл

		нДокумент = Документы.ИсполнениеПоСделке.СоздатьДокумент();
		нДокумент.Дата = ДатаДокумента;
		ЗаполнитьЗначенияСвойств(нДокумент, Стр);
		нДокумент.Записать(РежимЗаписиДокумента.Проведение);

		СозданныеДокументы.Добавить(нДокумент.Ссылка);

	КонецЦикла;
#КонецУдаления
#Вставка
	ТекстОшибкиИсполнения = ИсполнитьСтрокиСделок(ДатаДокумента, СозданныеДокументы);
#КонецВставки

	Если СозданныеДокументы.Количество() И Не РегламентноеЗадание Тогда
		АдресРезультата = ПоместитьВоВременноеХранилище(СозданныеДокументы);
	КонецЕсли;

#Вставка
	Если ЗначениеЗаполнено(ТекстОшибкиИсполнения) Тогда
		ВызватьИсключение ТекстОшибкиИсполнения;
	КонецЕсли;
#КонецВставки

КонецПроцедуры

// Тело фонового потока исполнения сделок. Проводит переданные строки таблицы сделок документами
// ИсполнениеПоСделке без пересчета поручения; пересчет выполняет вызвавший поток после всех потоков.
// Результат кладет во временное хранилище.
//
// Параметры:
//  Параметры - Структура - параметры потока:
//   * Строки - Массив из Структура - поля строки табличной части Сделки
//   * ДатаДокумента - Дата - дата создаваемых документов
//  АдресХранилища - Строка - адрес временного хранилища для результата, см. ПровестиСтрокиИсполнения
//
Процедура ПровестиПорциюИсполнения(Параметры, АдресХранилища) Экспорт

	Результат = ПровестиСтрокиИсполнения(Параметры.Строки, Параметры.ДатаДокумента);
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПараллельноеИсполнениеСделок

// Проводит документы исполнения по строкам табличной части Сделки: в нескольких фоновых потоках или, если поток
// один, в текущем сеансе. Пересчет поручения внутри проведения отключен; после проведения всех строк один раз
// пересчитываются все поручения таблицы. Ошибки документов пишутся в журнал регистрации и не прерывают исполнение.
//
// Параметры:
//  ДатаДокумента - Дата - дата создаваемых документов
//  СозданныеДокументы - Массив из ДокументСсылка.ИсполнениеПоСделке - дополняется проведенными документами
//
// Возвращаемое значение:
//  Строка - текст ошибки для исключения после завершения замеров; пустая строка, если ошибок нет
//
Функция ИсполнитьСтрокиСделок(ДатаДокумента, СозданныеДокументы)

	Если Сделки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	НачалоИсполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СтрокиСделок = СтрокиСделокДляПроведения();
	ПорученияСделок = ПорученияСделок(Сделки.ВыгрузитьКолонку("Сделка"));
	Потоков = КоличествоПотоковИсполнения();

	Если Потоков > 1 Тогда
		Порции = РазложитьПоПотокам(СтрокиСделок, ПорученияСделок, Потоков);
		Результаты = ПровестиПорцииВФоне(Порции, ДатаДокумента);
	Иначе
		Результаты = Новый Массив;
		Результаты.Добавить(ПровестиСтрокиИсполнения(СтрокиСделок, ДатаДокумента));
	КонецЕсли;

	Итоги = ИтогиПотоков(Результаты, СозданныеДокументы);
	ЗаписатьОшибкиИсполнения(Итоги.Ошибки);
	МиллисекундыПроведения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоИсполнения;

	НачалоПересчета = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЧислоПоручений = ПересчитатьПоручения(ПорученияСделок);
	МиллисекундыПересчета = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПересчета;

	ШаблонИтога = НСтр("ru = 'Строк %1, потоков %2, проведено %3, ошибок %4, повторов при неуникальном номере %5,
		|поручений %6, проведение %7 мс, пересчет поручений %8 мс'");
	ТекстИтога = СтрШаблон(ШаблонИтога, СтрокиСделок.Количество(), Результаты.Количество(), Итоги.Проведено,
		Итоги.Ошибки.Количество(), Итоги.Коллизий, ЧислоПоручений, МиллисекундыПроведения, МиллисекундыПересчета);
	ИмяСобытия = ИмяСобытияИсполнения();
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.ИсполнениеПоСделке, , ТекстИтога);

	Если Итоги.Ошибки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ШаблонОшибки = НСтр("ru = 'Исполнение сделок: не проведено строк %1 из %2.
		|Подробности в журнале регистрации, событие ""%3"".'");
	Возврат СтрШаблон(ШаблонОшибки, СтрокиСделок.Количество() - Итоги.Проведено, СтрокиСделок.Количество(), ИмяСобытия);

КонецФункции

// Проводит строки таблицы сделок как цикл конфигурации, но с ОбновитьДанныеИсполнения = Ложь. Документ, не
// записанный из-за неуникального номера, записывается заново новым объектом: автонумерация платформы при
// параллельной записи изредка выдает двум сеансам один номер. Ошибка документа не прерывает обход строк.
//
// Параметры:
//  СтрокиСделок - Массив из Структура - поля строки табличной части Сделки
//  ДатаДокумента - Дата - дата создаваемых документов
//
// Возвращаемое значение:
//  Структура - результат:
//   * Документы - Массив из ДокументСсылка.ИсполнениеПоСделке - проведенные документы
//   * Коллизий - Число - отказов записи по неуникальному номеру, включая повторенные успешно
//   * Ошибки - Массив из Структура - строки, которые не удалось провести:
//      ** Сделка - ДокументСсылка.Сделка - сделка строки
//      ** Актив - СправочникСсылка.Активы - актив строки
//      ** Текст - Строка - подробное представление ошибки
//
Функция ПровестиСтрокиИсполнения(СтрокиСделок, ДатаДокумента)

	ПовторовПриКоллизии = 5;
	ПроведенныеДокументы = Новый Массив;
	Ошибки = Новый Массив;
	Коллизий = 0;

	Для Каждого СтрокаСделки Из СтрокиСделок Цикл
		НомерПовтора = 0;
		Пока Истина Цикл
			нДокумент = Документы.ИсполнениеПоСделке.СоздатьДокумент();
			нДокумент.Дата = ДатаДокумента;
			ЗаполнитьЗначенияСвойств(нДокумент, СтрокаСделки);
			нДокумент.ДополнительныеСвойства.Вставить("ОбновитьДанныеИсполнения", Ложь);
			Попытка
				нДокумент.Записать(РежимЗаписиДокумента.Проведение);
				ПроведенныеДокументы.Добавить(нДокумент.Ссылка);
				Прервать;
			Исключение
				СведенияОбОшибке = ИнформацияОбОшибке();
				ЭтоКоллизия = ЭтоКоллизияНомера(КраткоеПредставлениеОшибки(СведенияОбОшибке));
				Если ЭтоКоллизия Тогда
					Коллизий = Коллизий + 1;
				КонецЕсли;
				Если ЭтоКоллизия И НомерПовтора < ПовторовПриКоллизии Тогда
					НомерПовтора = НомерПовтора + 1;
					Продолжить;
				КонецЕсли;
				ОписаниеОшибки = Новый Структура;
				ОписаниеОшибки.Вставить("Сделка", СтрокаСделки.Сделка);
				ОписаниеОшибки.Вставить("Актив", СтрокаСделки.Актив);
				ОписаниеОшибки.Вставить("Текст", ПодробноеПредставлениеОшибки(СведенияОбОшибке));
				Ошибки.Добавить(ОписаниеОшибки);
				Прервать;
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Документы", ПроведенныеДокументы);
	Результат.Вставить("Коллизий", Коллизий);
	Результат.Вставить("Ошибки", Ошибки);
	Возврат Результат;

КонецФункции

// Раскладывает строки по поручениям, поручения - по потокам с весом по числу строк: крупные поручения первыми,
// каждое в самый легкий поток. Строки одного поручения не делятся между потоками: долг ведется по поручению.
//
// Параметры:
//  СтрокиСделок - Массив из Структура - поля строки табличной части Сделки
//  ПорученияСделок - Соответствие - ключ ДокументСсылка.Сделка, значение ДокументСсылка.Поручение
//  Потоков - Число - наибольшее число потоков
//
// Возвращаемое значение:
//  Массив из Массив - строки каждого потока, пустых порций нет
//
Функция РазложитьПоПотокам(СтрокиСделок, ПорученияСделок, Потоков)

	Группы = Новый Соответствие;
	Для Каждого СтрокаСделки Из СтрокиСделок Цикл
		Поручение = ПорученияСделок.Получить(СтрокаСделки.Сделка);
		СтрокиПоручения = Группы.Получить(Поручение);
		Если СтрокиПоручения = Неопределено Тогда
			СтрокиПоручения = Новый Массив;
			Группы.Вставить(Поручение, СтрокиПоручения);
		КонецЕсли;
		СтрокиПоручения.Добавить(СтрокаСделки);
	КонецЦикла;

	ТаблицаГрупп = Новый ТаблицаЗначений;
	ТаблицаГрупп.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	ТаблицаГрупп.Колонки.Добавить("Строки");
	Для Каждого Группа Из Группы Цикл
		НоваяГруппа = ТаблицаГрупп.Добавить();
		НоваяГруппа.Вес = Группа.Значение.Количество();
		НоваяГруппа.Строки = Группа.Значение;
	КонецЦикла;
	ТаблицаГрупп.Сортировать("Вес Убыв");

	ЧислоПорций = Мин(Потоков, ТаблицаГрупп.Количество());
	Порции = Новый Массив;
	ВесаПорций = Новый Массив;
	Для НомерПорции = 1 По ЧислоПорций Цикл
		Порции.Добавить(Новый Массив);
		ВесаПорций.Добавить(0);
	КонецЦикла;

	Для Каждого Группа Из ТаблицаГрупп Цикл
		ИндексЛегкой = 0;
		Для Индекс = 1 По ВесаПорций.ВГраница() Цикл
			Если ВесаПорций[Индекс] < ВесаПорций[ИндексЛегкой] Тогда
				ИндексЛегкой = Индекс;
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаСделки Из Группа.Строки Цикл
			Порции[ИндексЛегкой].Добавить(СтрокаСделки);
		КонецЦикла;
		ВесаПорций[ИндексЛегкой] = ВесаПорций[ИндексЛегкой] + Группа.Вес;
	КонецЦикла;

	Возврат Порции;

КонецФункции

// Запускает по фоновому заданию на каждую порцию и ждет все задания. Задание, которое не завершилось успешно,
// дает в результате Неопределено и описание в журнале регистрации.
//
// Параметры:
//  Порции - Массив из Массив - строки каждого потока
//  ДатаДокумента - Дата - дата создаваемых документов
//
// Возвращаемое значение:
//  Массив из Структура, Неопределено - результаты потоков, см. ПровестиСтрокиИсполнения
//
Функция ПровестиПорцииВФоне(Порции, ДатаДокумента)

	Запуски = Новый Массив;
	Для НомерПорции = 1 По Порции.Количество() Цикл
		ПараметрыПорции = Новый Структура;
		ПараметрыПорции.Вставить("Строки", Порции[НомерПорции - 1]);
		ПараметрыПорции.Вставить("ДатаДокумента", ДатаДокумента);

		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("ИмяОбработки", Метаданные().Имя);
		ПараметрыЗадания.Вставить("ИмяМетода", "ПровестиПорциюИсполнения");
		ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыПорции);
		ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Ложь);

		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = СтрШаблон(НСтр("ru = 'Исполнение сделок, поток %1 из %2'"),
			НомерПорции, Порции.Количество());
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		ПараметрыВыполнения.ОжидатьЗавершение = 0;

		Запуск = ДлительныеОперации.ВыполнитьВФоне("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			ПараметрыЗадания, ПараметрыВыполнения);
		Запуск.Вставить("НомерПотока", НомерПорции);
		Запуски.Добавить(Запуск);
	КонецЦикла;

	Результаты = Новый Массив;
	Для Каждого Запуск Из Запуски Цикл
		ТекстОшибки = ОшибкаЗавершенияПотока(Запуск);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстСобытия = СтрШаблон(НСтр("ru = 'Поток %1 не завершился успешно: %2'"), Запуск.НомерПотока, ТекстОшибки);
			ЗаписьЖурналаРегистрации(ИмяСобытияИсполнения(), УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ИсполнениеПоСделке, , ТекстСобытия);
			Результаты.Добавить(Неопределено);
		Иначе
			Результаты.Добавить(ПолучитьИзВременногоХранилища(Запуск.АдресРезультата));
		КонецЕсли;
	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Ждет завершения фонового задания потока и возвращает текст ошибки, если задание не завершилось успешно.
// Ожидание без ограничения времени, как у последовательного цикла конфигурации: итоговый пересчет поручений
// допустим только после того, как поток перестал проводить документы. Аварийное завершение или отмена задания
// потока прерывают ожидание.
//
// Параметры:
//  Запуск - Структура - результат ДлительныеОперации.ВыполнитьВФоне
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка, если задание завершилось успешно
//
Функция ОшибкаЗавершенияПотока(Запуск)

	Если Запуск.Статус = "Ошибка" Тогда
		Возврат Запуск.ПодробноеПредставлениеОшибки;
	КонецЕсли;
	Если Запуск.Статус <> "Выполняется" Тогда
		Возврат "";
	КонецЕсли;

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Запуск.ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		Возврат НСтр("ru = 'фоновое задание не найдено'");
	КонецЕсли;
	Задание = Задание.ОжидатьЗавершенияВыполнения();
	Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Возврат "";
	ИначеЕсли Задание.ИнформацияОбОшибке <> Неопределено Тогда
		Возврат ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	Иначе
		Возврат Строка(Задание.Состояние);
	КонецЕсли;

КонецФункции

// Сводит результаты потоков: дополняет список созданных документов, суммирует повторы при неуникальном номере,
// собирает ошибки строк. Поток без результата добавляет ошибку без сделки.
//
// Параметры:
//  Результаты - Массив из Структура, Неопределено - результаты потоков
//  СозданныеДокументы - Массив из ДокументСсылка.ИсполнениеПоСделке - дополняется проведенными документами
//
// Возвращаемое значение:
//  Структура - итог:
//   * Проведено - Число - проведено документов во всех потоках
//   * Коллизий - Число - отказов по неуникальному номеру во всех потоках
//   * Ошибки - Массив из Структура - см. ПровестиСтрокиИсполнения
//
Функция ИтогиПотоков(Результаты, СозданныеДокументы)

	Проведено = 0;
	Коллизий = 0;
	Ошибки = Новый Массив;
	Для Каждого Результат Из Результаты Цикл
		Если ТипЗнч(Результат) <> Тип("Структура") Тогда
			ОписаниеОшибки = Новый Структура("Сделка, Актив, Текст", Неопределено, Неопределено,
				НСтр("ru = 'Поток не вернул результат, его документы не учтены в списке созданных'"));
			Ошибки.Добавить(ОписаниеОшибки);
			Продолжить;
		КонецЕсли;
		Для Каждого ПроведенныйДокумент Из Результат.Документы Цикл
			СозданныеДокументы.Добавить(ПроведенныйДокумент);
		КонецЦикла;
		Проведено = Проведено + Результат.Документы.Количество();
		Коллизий = Коллизий + Результат.Коллизий;
		Для Каждого ОписаниеОшибки Из Результат.Ошибки Цикл
			Ошибки.Добавить(ОписаниеОшибки);
		КонецЦикла;
	КонецЦикла;

	Итоги = Новый Структура;
	Итоги.Вставить("Проведено", Проведено);
	Итоги.Вставить("Коллизий", Коллизий);
	Итоги.Вставить("Ошибки", Ошибки);
	Возврат Итоги;

КонецФункции

// Пересчитывает процент, объем и расчетный статус всех поручений таблицы сделок одним вызовом на пачку
// из 1 000 поручений. Пересчет считает от текущего состояния, поэтому включает и поручения строк с ошибкой.
//
// Параметры:
//  ПорученияСделок - Соответствие - ключ ДокументСсылка.Сделка, значение ДокументСсылка.Поручение
//
// Возвращаемое значение:
//  Число - пересчитано поручений
//
Функция ПересчитатьПоручения(ПорученияСделок)

	РазмерПачки = 1000;
	Учтенные = Новый Соответствие;
	Пачка = Новый Массив;
	Всего = 0;
	Для Каждого Элемент Из ПорученияСделок Цикл
		Поручение = Элемент.Значение;
		Если Не ЗначениеЗаполнено(Поручение) Или Учтенные.Получить(Поручение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(Поручение, Истина);
		Пачка.Добавить(Поручение);
		Всего = Всего + 1;
		Если Пачка.Количество() = РазмерПачки Тогда
			РегистрыСведений.РасширенияПоручений.ОбновитьДанныеИсполнения(Пачка);
			Пачка = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Пачка) Тогда
		РегистрыСведений.РасширенияПоручений.ОбновитьДанныеИсполнения(Пачка);
	КонецЕсли;
	Возврат Всего;

КонецФункции

// Пишет в журнал регистрации по событию на каждую непроведенную строку; после 100 событий пишет одно итоговое.
//
// Параметры:
//  Ошибки - Массив из Структура - см. ПровестиСтрокиИсполнения
//
Процедура ЗаписатьОшибкиИсполнения(Ошибки)

	НаибольшееЧислоСобытий = 100;
	ИмяСобытия = ИмяСобытияИсполнения();
	ШаблонСобытия = НСтр("ru = 'Не удалось провести документ исполнения по сделке. Актив: %1
		|%2'");
	Для Индекс = 0 По Мин(Ошибки.ВГраница(), НаибольшееЧислоСобытий - 1) Цикл
		ОписаниеОшибки = Ошибки[Индекс];
		ТекстСобытия = СтрШаблон(ШаблонСобытия, ОписаниеОшибки.Актив, ОписаниеОшибки.Текст);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ИсполнениеПоСделке, ОписаниеОшибки.Сделка, ТекстСобытия);
	КонецЦикла;
	Если Ошибки.Количество() > НаибольшееЧислоСобытий Тогда
		ТекстСобытия = СтрШаблон(НСтр("ru = 'Не проведено строк: %1, в журнал записаны первые %2.'"),
			Ошибки.Количество(), НаибольшееЧислоСобытий);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ИсполнениеПоСделке, , ТекстСобытия);
	КонецЕсли;

КонецПроцедуры

// Строки табличной части Сделки в виде структур с теми же полями: такие строки передаются в фоновые задания.
//
// Возвращаемое значение:
//  Массив из Структура - поля строки табличной части без номера строки
//
Функция СтрокиСделокДляПроведения()

	Таблица = Сделки.Выгрузить();
	ИменаКолонок = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.Имя <> "НомерСтроки" Тогда
			ИменаКолонок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	СписокПолей = СтрСоединить(ИменаКолонок, ",");

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаСделки = Новый Структура(СписокПолей);
		ЗаполнитьЗначенияСвойств(СтрокаСделки, СтрокаТаблицы);
		Результат.Добавить(СтрокаСделки);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Поручения сделок таблицы одним запросом.
//
// Параметры:
//  СписокСделок - Массив из ДокументСсылка.Сделка - сделки строк таблицы
//
// Возвращаемое значение:
//  Соответствие - ключ ДокументСсылка.Сделка, значение ДокументСсылка.Поручение
//
Функция ПорученияСделок(СписокСделок)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сделки", СписокСделок);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сделки.Ссылка КАК Сделка,
	|	Сделки.Поручение КАК Поручение
	|ИЗ
	|	Документ.Сделка КАК Сделки
	|ГДЕ
	|	Сделки.Ссылка В (&Сделки)";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Сделка, Выборка.Поручение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Число потоков исполнения: значение константы КоличествоПотоковИсполненияСделок, если такая константа есть
// в конфигурации и заполнена, иначе 6. Значение 1 - проведение в текущем сеансе с одним пересчетом в конце.
//
// Возвращаемое значение:
//  Число - число потоков, не меньше 1
//
Функция КоличествоПотоковИсполнения()

	ПотоковПоУмолчанию = 6;
	ИмяКонстанты = "КоличествоПотоковИсполненияСделок";
	Если Метаданные.Константы.Найти(ИмяКонстанты) = Неопределено Тогда
		Возврат ПотоковПоУмолчанию;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Значение = Константы[ИмяКонстанты].Получить();
	УстановитьПривилегированныйРежим(Ложь);

	Если ТипЗнч(Значение) <> Тип("Число") Или Значение < 1 Тогда
		Возврат ПотоковПоУмолчанию;
	КонецЕсли;
	Возврат Цел(Значение);

КонецФункции

// Признак отказа записи по неуникальному номеру документа: по тексту сообщения платформы на русском
// и английском языке.
//
// Параметры:
//  ТекстОшибки - Строка - краткое представление ошибки записи
//
// Возвращаемое значение:
//  Булево - Истина, если запись отклонена из-за неуникального номера
//
Функция ЭтоКоллизияНомера(ТекстОшибки)

	Текст = НРег(ТекстОшибки);
	Возврат СтрНайти(Текст, "не уникально") > 0 Или СтрНайти(Текст, "not unique") > 0;

КонецФункции

// Имя события журнала регистрации для итогов и ошибок исполнения сделок.
//
// Возвращаемое значение:
//  Строка - имя события
//
Функция ИмяСобытияИсполнения()

	Возврат НСтр("ru = 'Аванкор. Исполнение сделок. Параллельное проведение'");

КонецФункции

