#Область ОбработчикиСобытийФормы

// Заполняет глубину истории и имя базы без пароля.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ДнейИстории = 21;
    ИмяБазы = ИмяБазыБезПароля();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Собирает лог на сервере. Данные базы не меняются.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Собрать(Команда)

    Результат = "Выполняется сбор...";
    СобратьНаСервере();

КонецПроцедуры

// Сохраняет текст лога в файл на компьютере пользователя.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

    Если Не ЗначениеЗаполнено(Результат) Тогда
        ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала соберите лог");
        Возврат;
    КонецЕсли;

    ИмяФайла = "ExecutionPractice_" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt";
    ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресФайла(), ИмяФайла);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет сбор лог модулем объекта.
//
&НаСервере
Процедура СобратьНаСервере()

    Обработка = РеквизитФормыВЗначение("Объект");
    Результат = Обработка.СобратьЛог(ДатаРазбора, ДнейИстории);

КонецПроцедуры

// Помещает текст лога во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла в кодировке UTF-8
//
&НаСервере
Функция АдресФайла()

    ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Результат, "UTF-8", Ложь);
    Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

// Возвращает сервер и имя базы из строки соединения, без пользователя и пароля.
//
// Возвращаемое значение:
//  Строка - краткое имя базы
//
&НаСервере
Функция ИмяБазыБезПароля()

    СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
    Сервер = ЗначениеПараметраСоединения(СтрокаСоединения, "Srvr");
    Имя = ЗначениеПараметраСоединения(СтрокаСоединения, "Ref");
    Если Не ЗначениеЗаполнено(Имя) Тогда
        Имя = ЗначениеПараметраСоединения(СтрокаСоединения, "File");
    КонецЕсли;
    Если ЗначениеЗаполнено(Сервер) Тогда
        Возврат Сервер + "/" + Имя;
    КонецЕсли;
    Возврат Имя;

КонецФункции

// Возвращает значение одного параметра строки соединения.
//
// Параметры:
//  СтрокаСоединения - Строка - строка соединения информационной базы
//  ИмяПараметра - Строка - имя параметра, например Ref
//
// Возвращаемое значение:
//  Строка - значение параметра или пустая строка
//
&НаСервере
Функция ЗначениеПараметраСоединения(СтрокаСоединения, ИмяПараметра)

    Части = СтрРазделить(СтрокаСоединения, ";", Ложь);
    Префикс = НРег(ИмяПараметра) + "=";
    Для Каждого Часть Из Части Цикл
        Фрагмент = СокрЛП(Часть);
        Если СтрНачинаетсяС(НРег(Фрагмент), Префикс) Тогда
            Значение = Сред(Фрагмент, СтрДлина(Префикс) + 1);
            Возврат СтрЗаменить(СтрЗаменить(Значение, """", ""), "'", "");
        КонецЕсли;
    КонецЦикла;
    Возврат "";

КонецФункции

#КонецОбласти
