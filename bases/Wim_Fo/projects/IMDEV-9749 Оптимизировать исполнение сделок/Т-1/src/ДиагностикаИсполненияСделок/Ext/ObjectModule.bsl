Функция ПоследнийДеньИсполнения(НачалоИстории)

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    НАЧАЛОПЕРИОДА(Исп.Дата, ДЕНЬ) КАК День
        |ИЗ
        |    Документ.ИсполнениеПоСделке КАК Исп
        |ГДЕ
        |    Исп.Дата >= &Начало
        |    И НЕ Исп.ПометкаУдаления
        |УПОРЯДОЧИТЬ ПО
        |    День УБЫВ";
    Запрос.УстановитьПараметр("Начало", НачалоИстории);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.День;
    КонецЕсли;
    Возврат Дата(1, 1, 1);

КонецФункции

Функция ПараметрыЗапроса(День, КонецДня)

    Параметры = Новый Структура;
    Параметры.Вставить("Начало", День);
    Параметры.Вставить("День", День);
    Параметры.Вставить("КонецДня", КонецДня);
    Возврат Параметры;

КонецФункции

Функция ИмяБазыБезПароля()

    СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
    Сервер = ЗначениеПараметраСоединения(СтрокаСоединения, "Srvr");
    Имя = ЗначениеПараметраСоединения(СтрокаСоединения, "Ref");
    Если Не ЗначениеЗаполнено(Имя) Тогда
        Имя = ЗначениеПараметраСоединения(СтрокаСоединения, "File");
    КонецЕсли;
    Если ЗначениеЗаполнено(Сервер) Тогда
        Возврат Сервер + "/" + Имя;
    КонецЕсли;
    Возврат Имя;

КонецФункции

Функция ЗначениеПараметраСоединения(СтрокаСоединения, ИмяПараметра)

    Части = СтрРазделить(СтрокаСоединения, ";", Ложь);
    Префикс = НРег(ИмяПараметра) + "=";
    Для Каждого Часть Из Части Цикл
        Фрагмент = СокрЛП(Часть);
        Если СтрНачинаетсяС(НРег(Фрагмент), Префикс) Тогда
            Значение = Сред(Фрагмент, СтрДлина(Префикс) + 1);
            Возврат СтрЗаменить(СтрЗаменить(Значение, """", ""), "'", "");
        КонецЕсли;
    КонецЦикла;
    Возврат "";

КонецФункции

Процедура ВывестиЗапрос(Лог, Заголовок, ТекстЗапроса, Параметры, МаксимумСтрок)

    Лог.Добавить("");
    Лог.Добавить("--- " + Заголовок);
    Запрос = Новый Запрос(ТекстЗапроса);
    Для Каждого Параметр Из Параметры Цикл
        Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
    КонецЦикла;
    Попытка
        НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Таблица = Запрос.Выполнить().Выгрузить();
        Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса;
    Исключение
        ДобавитьОшибку(Лог, ИнформацияОбОшибке());
        Возврат;
    КонецПопытки;
    Лог.Добавить("Время запроса, мс: " + ФорматЧисла(Длительность) + "; строк: " + ФорматЧисла(Таблица.Количество()));
    Имена = Новый Массив;
    Для Каждого Колонка Из Таблица.Колонки Цикл
        Имена.Добавить(Колонка.Имя);
    КонецЦикла;
    Лог.Добавить(СтрСоединить(Имена, " | "));
    Номер = 0;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        Номер = Номер + 1;
        Если Номер > МаксимумСтрок Тогда
            Лог.Добавить("... еще строк: " + ФорматЧисла(Таблица.Количество() - МаксимумСтрок));
            Прервать;
        КонецЕсли;
        Значения = Новый Массив;
        Для Каждого Колонка Из Таблица.Колонки Цикл
            Значения.Добавить(ЗначениеСтрокой(СтрокаТаблицы[Колонка.Имя]));
        КонецЦикла;
        Лог.Добавить(СтрСоединить(Значения, " | "));
    КонецЦикла;

КонецПроцедуры

Функция ЗначениеСтрокой(Значение)

    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Если ТипЗнч(Значение) = Тип("Число") Тогда
        Возврат Формат(Значение, "ЧГ=0; ЧН=0");
    КонецЕсли;
    Если ТипЗнч(Значение) = Тип("Дата") Тогда
        Возврат Формат(Значение, "ДФ=yyyy-MM-dd HH:mm:ss; ДП=");
    КонецЕсли;
    Возврат Строка(Значение);

КонецФункции

Функция ФорматЧисла(Значение)

    Возврат Формат(Значение, "ЧГ=0; ЧН=0");

