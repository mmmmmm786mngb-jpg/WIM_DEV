// Снимок практики исполнения сделок на копии Т-1. Только чтение: обработка ничего не записывает и не проводит.
// Лог нужен, чтобы по одному дню поставки увидеть источник (сделки и плановую позицию), документы
// ИсполнениеПоСделке и что они записали в регистры.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Собирает лог практики исполнения за один день поставки и короткую историю вокруг него.
//
// Параметры:
//  ДатаРазбора - Дата - день поставки; пустая дата заменяется последним днем с документами исполнения
//  ДнейИстории - Число - глубина списка дней, если дата не задана и для таблицы объемов
//
// Возвращаемое значение:
//  Строка - текст лога
//
// Пример:
//  Текст = СобратьЛог('20261027', 21);
//
Функция СобратьЛог(ДатаРазбора, ДнейИстории = 21) Экспорт

    Лог = Новый Массив;
    НачалоСбора = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Если ДнейИстории <= 0 Тогда
        ДнейИстории = 21;
    КонецЕсли;
    НачалоИстории = НачалоДня(ТекущаяДатаСеанса()) - ДнейИстории * 86400;

    Попытка
        УстановитьПривилегированныйРежим(Истина);
    Исключение
        Лог.Добавить("Привилегированный режим не установлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    ДобавитьРаздел(Лог, "0. База");
    Попытка
        РазделБаза(Лог);
    Исключение
        ДобавитьОшибку(Лог, ИнформацияОбОшибке());
    КонецПопытки;

    ДобавитьРаздел(Лог, "1. Документы ИсполнениеПоСделке по дням");
    Попытка
        РазделПоДням(Лог, НачалоИстории);
    Исключение
        ДобавитьОшибку(Лог, ИнформацияОбОшибке());
    КонецПопытки;

    День = НачалоДня(ДатаРазбора);
    Если Не ЗначениеЗаполнено(День) Тогда
        День = ПоследнийДеньИсполнения(НачалоИстории);
    КонецЕсли;
    Если Не ЗначениеЗаполнено(День) Тогда
        Лог.Добавить("За указанную историю документов исполнения нет. Укажите дату поставки вручную.");
        Возврат СтрСоединить(Лог, Символы.ПС);
    КонецЕсли;
    КонецДня = КонецДня(День);
    Лог.Добавить("");
    Лог.Добавить("День разбора (дата документа исполнения и дата поставки сделки): "
        + Формат(День, "ДФ=yyyy-MM-dd"));

    ДобавитьРаздел(Лог, "2. Что подлежало исполнению");
    Попытка
        РазделИсточник(Лог, День, КонецДня);
    Исключение
        ДобавитьОшибку(Лог, ИнформацияОбОшибке());
    КонецПопытки;

    ДобавитьРаздел(Лог, "3. Как нарезаны документы исполнения");
    Попытка
        РазделНарезка(Лог, День, КонецДня);
    Исключение
        ДобавитьОшибку(Лог, ИнформацияОбОшибке());
    КонецПопытки;

    ДобавитьРаздел(Лог, "4. Что записали регистры");
    Попытка
        РазделРегистры(Лог, День, КонецДня);
    Исключение
        ДобавитьОшибку(Лог, ИнформацияОбОшибке());
    КонецПопытки;

    ДобавитьРаздел(Лог, "5. Статус и процент поручений этого дня");
    Попытка
        РазделПоручения(Лог, День, КонецДня);
    Исключение
        ДобавитьОшибку(Лог, ИнформацияОбОшибке());
    КонецПопытки;

    ДобавитьРаздел(Лог, "6. Пример поручений с наибольшим числом документов");
    Попытка
        РазделПример(Лог, День, КонецДня);
    Исключение
        ДобавитьОшибку(Лог, ИнформацияОбОшибке());
    КонецПопытки;

    Лог.Добавить("");
    Лог.Добавить("Сбор, мс: " + ФорматЧисла(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСбора));
    Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РазделБаза(Лог)

    Лог.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Синоним);
    Лог.Добавить("Версия конфигурации: " + Метаданные.Версия);
    Лог.Добавить("База: " + ИмяБазыБезПароля());
    Лог.Добавить("Собрано: " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Попытка
        Лог.Добавить("GetListOfDeals: " + ?(ПолныеПрава.ИспользоватьМетодАpi_GetListOfDeals(), "включен", "выключен"));
    Исключение
        Лог.Добавить("GetListOfDeals: не прочитан, " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    ВывестиЗадание(Лог);

КонецПроцедуры

Процедура ВывестиЗадание(Лог)

    Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.АванкорИсполнениеСделок);
    Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
    Если Задания.Количество() = 0 Тогда
        Лог.Добавить("Задание АванкорИсполнениеСделок: не найдено");
        Возврат;
    КонецЕсли;
    Задание = Задания[0];
    Последнее = Задание.ПоследнееЗадание;
    ТекстПоследнего = "нет";
    Если Последнее <> Неопределено Тогда
        ТекстПоследнего = Формат(Последнее.Начало, "ДФ=yyyy-MM-dd HH:mm:ss");
    КонецЕсли;
    Лог.Добавить("Задание АванкорИсполнениеСделок, включено: " + Строка(Задание.Использование)
        + "; последнее: " + ТекстПоследнего);

КонецПроцедуры

Процедура РазделПоДням(Лог, НачалоИстории)

    ВывестиЗапрос(Лог, "Документы по дате документа",
        "ВЫБРАТЬ
        |    НАЧАЛОПЕРИОДА(Исп.Дата, ДЕНЬ) КАК День,
        |    КОЛИЧЕСТВО(*) КАК Документов,
        |    СУММА(ВЫБОР КОГДА Исп.Проведен ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Проведено,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Сделка) КАК Сделок,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Сделка.Поручение) КАК Поручений
        |ИЗ
        |    Документ.ИсполнениеПоСделке КАК Исп
        |ГДЕ
        |    Исп.Дата >= &Начало
        |    И НЕ Исп.ПометкаУдаления
        |СГРУППИРОВАТЬ ПО
        |    НАЧАЛОПЕРИОДА(Исп.Дата, ДЕНЬ)
        |УПОРЯДОЧИТЬ ПО
        |    День",
        ПараметрыЗапроса(НачалоИстории, Неопределено), 40);

КонецПроцедуры

Процедура РазделИсточник(Лог, День, КонецДня)

    ВывестиЗапрос(Лог, "Сделки с датой поставки в этот день",
        "ВЫБРАТЬ
        |    КОЛИЧЕСТВО(*) КАК СделокПоставка,
        |    СУММА(ВЫБОР
        |        КОГДА Сделки.Проведен ТОГДА 1
        |        ИНАЧЕ 0
        |    КОНЕЦ) КАК Проведено,
        |    СУММА(ВЫБОР
        |        КОГДА Сделки.Проведен
        |            И (Сделки.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.ВалютныйРынок)
        |                ИЛИ НЕ Сделки.Внебиржевая
        |                    И НЕ ЕСТЬNULL(Сделки.Поручение.Биржа.Внебиржевая, ЛОЖЬ))
        |            ТОГДА 1
        |        ИНАЧЕ 0
        |    КОНЕЦ) КАК ПроходятФильтрНочи,
        |    СУММА(ВЫБОР
        |        КОГДА Сделки.Поручение = ЗНАЧЕНИЕ(Документ.Поручение.ПустаяСсылка) ТОГДА 1
        |        ИНАЧЕ 0
        |    КОНЕЦ) КАК БезПоручения
        |ИЗ
        |    Документ.Сделка КАК Сделки
        |ГДЕ
        |    Сделки.ДатаПоставки = &День
        |    И НЕ Сделки.ПометкаУдаления",
        ПараметрыЗапроса(День, КонецДня), 5);

    ВывестиЗапрос(Лог, "Документы исполнения в этот день",
        "ВЫБРАТЬ
        |    КОЛИЧЕСТВО(*) КАК Документов,
        |    СУММА(ВЫБОР КОГДА Исп.Проведен ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Проведено,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Сделка) КАК Сделок,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Сделка.Поручение) КАК Поручений,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Портфель) КАК Портфелей,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Портфель.Учредитель) КАК Учредителей,
        |    СУММА(ВЫБОР
        |        КОГДА Исп.Сделка.Поручение = ЗНАЧЕНИЕ(Документ.Поручение.ПустаяСсылка) ТОГДА 1
        |        ИНАЧЕ 0
        |    КОНЕЦ) КАК ДокументовБезПоручения
        |ИЗ
        |    Документ.ИсполнениеПоСделке КАК Исп
        |ГДЕ
        |    Исп.Дата МЕЖДУ &День И &КонецДня
        |    И НЕ Исп.ПометкаУдаления",
        ПараметрыЗапроса(День, КонецДня), 5);

    ВывестиЗапрос(Лог, "Сделки поставки без документа исполнения",
        "ВЫБРАТЬ
        |    КОЛИЧЕСТВО(*) КАК СделокБезИсполнения
        |ИЗ
        |    Документ.Сделка КАК Сделки
        |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеПоСделке КАК Исп
        |        ПО Исп.Сделка = Сделки.Ссылка
        |            И НЕ Исп.ПометкаУдаления
        |            И Исп.Дата МЕЖДУ &День И &КонецДня
        |ГДЕ
        |    Сделки.ДатаПоставки = &День
        |    И Сделки.Проведен
        |    И НЕ Сделки.ПометкаУдаления
        |    И (Сделки.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.ВалютныйРынок)
        |        ИЛИ НЕ Сделки.Внебиржевая
        |            И НЕ ЕСТЬNULL(Сделки.Поручение.Биржа.Внебиржевая, ЛОЖЬ))
        |    И Исп.Ссылка ЕСТЬ NULL",
        ПараметрыЗапроса(День, КонецДня), 5);

    ВывестиЗапрос(Лог, "Остаток плановой позиции на конец дня по сделкам этой поставки",
        "ВЫБРАТЬ
        |    Сделки.Ссылка КАК Сделка
        |ПОМЕСТИТЬ ВТ_Сделки
        |ИЗ
        |    Документ.Сделка КАК Сделки
        |ГДЕ
        |    Сделки.ДатаПоставки = &День
        |    И Сделки.Проведен
        |    И НЕ Сделки.ПометкаУдаления
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |    КОЛИЧЕСТВО(*) КАК СтрокОстатка,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Остатки.Сделка) КАК Сделок,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Остатки.Портфель) КАК Портфелей,
        |    СУММА(Остатки.КоличествоОстаток) КАК Количество,
        |    СУММА(Остатки.СуммаОстаток) КАК Сумма
        |ИЗ
        |    РегистрНакопления.ПлановаяПозиция.Остатки(&КонецДня, Сделка В
        |        (ВЫБРАТЬ ВТ_Сделки.Сделка ИЗ ВТ_Сделки КАК ВТ_Сделки)) КАК Остатки
        |ГДЕ
        |    Остатки.КоличествоОстаток <> 0",
        ПараметрыЗапроса(День, КонецДня), 5);

КонецПроцедуры

Процедура РазделНарезка(Лог, День, КонецДня)

    ВывестиЗапрос(Лог, "Документы по виду актива",
        "ВЫБРАТЬ
        |    Исп.Актив.ВидАктива КАК ВидАктива,
        |    КОЛИЧЕСТВО(*) КАК Документов,
        |    СУММА(Исп.Количество) КАК Количество
        |ИЗ
        |    Документ.ИсполнениеПоСделке КАК Исп
        |ГДЕ
        |    Исп.Дата МЕЖДУ &День И &КонецДня
        |    И Исп.Проведен
        |    И НЕ Исп.ПометкаУдаления
        |СГРУППИРОВАТЬ ПО
        |    Исп.Актив.ВидАктива
        |УПОРЯДОЧИТЬ ПО
        |    Документов УБЫВ",
        ПараметрыЗапроса(День, КонецДня), 20);

    ВывестиЗапрос(Лог, "Сколько документов на одну сделку",
        "ВЫБРАТЬ
        |    Исп.Сделка КАК Сделка,
        |    КОЛИЧЕСТВО(*) КАК Документов
        |ПОМЕСТИТЬ ВТ_Сделки
        |ИЗ
        |    Документ.ИсполнениеПоСделке КАК Исп
        |ГДЕ
        |    Исп.Дата МЕЖДУ &День И &КонецДня
        |    И НЕ Исп.ПометкаУдаления
        |СГРУППИРОВАТЬ ПО
        |    Исп.Сделка
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |    ВТ_Сделки.Документов КАК ДокументовНаСделку,
        |    КОЛИЧЕСТВО(*) КАК Сделок
        |ИЗ
        |    ВТ_Сделки КАК ВТ_Сделки
        |СГРУППИРОВАТЬ ПО
        |    ВТ_Сделки.Документов
        |УПОРЯДОЧИТЬ ПО
        |    ДокументовНаСделку",
        ПараметрыЗапроса(День, КонецДня), 20);

    ВывестиЗапрос(Лог, "Сколько документов на одно поручение",
        "ВЫБРАТЬ
        |    Исп.Сделка.Поручение КАК Поручение,
        |    КОЛИЧЕСТВО(*) КАК Документов
        |ПОМЕСТИТЬ ВТ_Поручения
        |ИЗ
        |    Документ.ИсполнениеПоСделке КАК Исп
        |ГДЕ
        |    Исп.Дата МЕЖДУ &День И &КонецДня
        |    И НЕ Исп.ПометкаУдаления
        |    И Исп.Сделка.Поручение <> ЗНАЧЕНИЕ(Документ.Поручение.ПустаяСсылка)
        |СГРУППИРОВАТЬ ПО
        |    Исп.Сделка.Поручение
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |    ВТ_Поручения.Документов КАК ДокументовНаПоручение,
        |    КОЛИЧЕСТВО(*) КАК Поручений
        |ИЗ
        |    ВТ_Поручения КАК ВТ_Поручения
        |СГРУППИРОВАТЬ ПО
        |    ВТ_Поручения.Документов
        |УПОРЯДОЧИТЬ ПО
        |    ДокументовНаПоручение",
        ПараметрыЗапроса(День, КонецДня), 30);

    ВывестиЗапрос(Лог, "Поручения с несколькими портфелями или учредителями",
        "ВЫБРАТЬ
        |    Исп.Сделка.Поручение КАК Поручение,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Портфель) КАК Портфелей,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Портфель.Учредитель) КАК Учредителей
        |ПОМЕСТИТЬ ВТ_Разрез
        |ИЗ
        |    Документ.ИсполнениеПоСделке КАК Исп
        |ГДЕ
        |    Исп.Дата МЕЖДУ &День И &КонецДня
        |    И НЕ Исп.ПометкаУдаления
        |    И Исп.Сделка.Поручение <> ЗНАЧЕНИЕ(Документ.Поручение.ПустаяСсылка)
        |СГРУППИРОВАТЬ ПО
        |    Исп.Сделка.Поручение
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |    КОЛИЧЕСТВО(*) КАК Поручений,
        |    СУММА(ВЫБОР КОГДА ВТ_Разрез.Портфелей > 1 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК НесколькоПортфелей,
        |    СУММА(ВЫБОР КОГДА ВТ_Разрез.Учредителей > 1 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК НесколькоУчредителей,
        |    МАКСИМУМ(ВТ_Разрез.Портфелей) КАК МаксимумПортфелей
        |ИЗ
        |    ВТ_Разрез КАК ВТ_Разрез",
        ПараметрыЗапроса(День, КонецДня), 5);

    ВывестиЗапрос(Лог, "Режим поручения: один портфель в шапке или таблица распределения",
        "ВЫБРАТЬ
        |    Исп.Сделка.Поручение.ЗаполнениеПоПортфелю КАК ЗаполнениеПоПортфелю,
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Сделка.Поручение) КАК Поручений
        |ИЗ
        |    Документ.ИсполнениеПоСделке КАК Исп
        |ГДЕ
        |    Исп.Дата МЕЖДУ &День И &КонецДня
        |    И НЕ Исп.ПометкаУдаления
        |    И Исп.Сделка.Поручение <> ЗНАЧЕНИЕ(Документ.Поручение.ПустаяСсылка)
        |СГРУППИРОВАТЬ ПО
        |    Исп.Сделка.Поручение.ЗаполнениеПоПортфелю",
        ПараметрыЗапроса(День, КонецДня), 5);

КонецПроцедуры

Процедура РазделРегистры(Лог, День, КонецДня)

    ВывестиЗапрос(Лог, "Плановая позиция, кто писал по сделкам этой поставки",
        "ВЫБРАТЬ
        |    Сделки.Ссылка КАК Сделка
        |ПОМЕСТИТЬ ВТ_Сделки
        |ИЗ
        |    Документ.Сделка КАК Сделки
        |ГДЕ
        |    Сделки.ДатаПоставки = &День
        |    И НЕ Сделки.ПометкаУдаления
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |    ВЫБОР
        |        КОГДА Движения.Регистратор ССЫЛКА Документ.Сделка ТОГДА ""Сделка""
        |        КОГДА Движения.Регистратор ССЫЛКА Документ.ИсполнениеПоСделке ТОГДА ""ИсполнениеПоСделке""
