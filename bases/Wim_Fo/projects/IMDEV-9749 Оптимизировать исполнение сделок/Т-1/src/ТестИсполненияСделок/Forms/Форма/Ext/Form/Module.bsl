#КонецОбласти

#Область Логи

// Собирает в один текст: состояние базы и расширения, все этапы, сравнение снимков и сами снимки.
//
// Параметры:
//  Ночь - Дата - день поставки
//  ИдентификаторФормы - УникальныйИдентификатор - владелец временного хранилища
//
// Возвращаемое значение:
//  Структура - Адрес (Строка, адрес текста во временном хранилище), ИмяФайла (Строка), Текст (Строка, итог для журнала)
//
&НаСервереБезКонтекста
Функция СобратьЛогиНаСервере(Ночь, ИдентификаторФормы)

	Данные = ЗагрузитьДанные(Ночь);
	Строки = Новый Массив;
	Строки.Добавить("======== Тест исполнения сделок IMDEV-9749");
	Строки.Добавить("Конфигурация: " + Метаданные.Синоним + ", версия " + Метаданные.Версия);
	Строки.Добавить("База: " + СтрокаСоединенияИнформационнойБазы());
	Строки.Добавить("Собрано: " + ТекущаяДатаСеанса());
	Строки.Добавить("Ночь (день поставки): " + Формат(Ночь, "ДФ=dd.MM.yyyy"));
	Строки.Добавить(СостояниеРасширения().Описание);
	Строки.Добавить(СчетчикиНочи(Ночь));

	Строки.Добавить("");
	Строки.Добавить("======== Этапы");
	Для Каждого Этап Из Данные.Этапы Цикл
		Строки.Добавить("--- " + Этап.Время + " " + Этап.Вид);
		Строки.Добавить(Этап.Текст);
	КонецЦикла;

	Строки.Добавить("");
	Строки.Добавить("======== Сравнение снимков");
	Для Левый = 0 По Данные.Снимки.ВГраница() Цикл
		Для Правый = Левый + 1 По Данные.Снимки.ВГраница() Цикл
			Строки.Добавить(СравнитьСнимки(Данные.Снимки[Левый], Данные.Снимки[Правый]));
		КонецЦикла;
	КонецЦикла;

	Строки.Добавить("");
	Строки.Добавить("======== Снимки");
	Для Каждого Снимок Из Данные.Снимки Цикл
		Строки.Добавить("--- " + Снимок.Метка + " (" + Снимок.Время + ")");
		Строки.Добавить(Снимок.Сводка);
		Строки.Добавить(Снимок.Текст);
	КонецЦикла;

	ИмяФайла = СтрШаблон("ТестИсполнения_%1_%2.txt", Формат(Ночь, "ДФ=yyyyMMdd"), Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmm"));
	Адрес = ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Строки, Символы.ПС)),
		ИдентификаторФормы);
	Текст = СтрШаблон("Логи собраны: этапов %1, снимков %2. Файл %3.", Данные.Этапы.Количество(),
		Данные.Снимки.Количество(), ИмяФайла);
	Возврат Новый Структура("Адрес, ИмяФайла, Текст", Адрес, ИмяФайла, Текст);

КонецФункции

&НаСервереБезКонтекста
Функция СравнитьСнимки(Левый, Правый)

	ЛевыеСтроки = СтрокиСнимкаПоКлючу(Левый.Текст);
	ПравыеСтроки = СтрокиСнимкаПоКлючу(Правый.Текст);
	Расхождения = Новый Массив;
	Поручений = 0;
	Сделок = 0;
	Для Каждого Элемент Из ЛевыеСтроки Цикл
		Если ПравыеСтроки.Получить(Элемент.Ключ) <> Элемент.Значение Тогда
			Расхождения.Добавить("  L: " + Элемент.Значение + Символы.ПС + "  R: " + ПравыеСтроки.Получить(Элемент.Ключ));
			Если СтрНачинаетсяС(Элемент.Ключ, "O|") Тогда
				Поручений = Поручений + 1;
			Иначе
				Сделок = Сделок + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из ПравыеСтроки Цикл
		Если ЛевыеСтроки.Получить(Элемент.Ключ) = Неопределено Тогда
			Расхождения.Добавить("  L: нет" + Символы.ПС + "  R: " + Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("--- %1 <-> %2: расхождений %3 (поручений %4, сделок %5)", Левый.Метка, Правый.Метка,
		Расхождения.Количество(), Поручений, Сделок));
	Для Индекс = 0 По Мин(Расхождения.ВГраница(), 29) Цикл
		Строки.Добавить(Расхождения[Индекс]);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция СтрокиСнимкаПоКлючу(Текст)

	Результат = Новый Соответствие;
	Для Каждого СтрокаСнимка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Части = СтрРазделить(СтрокаСнимка, "|");
		Если Части.Количество() > 1 Тогда
			Результат.Вставить(Части[0] + "|" + Части[1], СтрокаСнимка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

