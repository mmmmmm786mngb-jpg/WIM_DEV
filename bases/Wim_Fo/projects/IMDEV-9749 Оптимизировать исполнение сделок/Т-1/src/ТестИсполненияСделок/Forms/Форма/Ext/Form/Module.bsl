Функция ЧислоДокументовНочи(Ночь)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(Ночь));
	Запрос.УстановитьПараметр("Конец", КонецДня(Ночь));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Исполнения.Ссылка) КАК Документов
	|ИЗ
	|	Документ.ИсполнениеПоСделке КАК Исполнения
	|ГДЕ
	|	Исполнения.Дата МЕЖДУ &Начало И &Конец";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Документов;

КонецФункции

&НаСервереБезКонтекста
Функция СчетчикиНочи(Ночь)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("День", НачалоДня(Ночь));
	Запрос.УстановитьПараметр("КонецДня", Новый Граница(КонецДня(Ночь), ВидГраницы.Включая));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сделки.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Сделки.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.ВалютныйРынок)
	|				ИЛИ НЕ Сделки.Внебиржевая
	|					И НЕ ЕСТЬNULL(Сделки.Поручение.Биржа.Внебиржевая, ЛОЖЬ)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПроходитФильтр
	|ПОМЕСТИТЬ ВТ_Сделки
	|ИЗ
	|	Документ.Сделка КАК Сделки
	|ГДЕ
	|	Сделки.ДатаПоставки = &День
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ВТ_Сделки.Ссылка) КАК Сделок,
	|	ЕСТЬNULL(СУММА(ВТ_Сделки.ПроходитФильтр), 0) КАК ПроходятФильтр
	|ИЗ
	|	ВТ_Сделки КАК ВТ_Сделки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ План.Сделка) КАК Сделок
	|ИЗ
	|	РегистрНакопления.ПлановаяПозиция.Остатки(
	|			&КонецДня,
	|			Сделка В
	|				(ВЫБРАТЬ
	|					ВТ_Сделки.Ссылка КАК Ссылка
	|				ИЗ
	|					ВТ_Сделки КАК ВТ_Сделки)) КАК План";
	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаСделок = Результаты[1].Выбрать();
	ВыборкаСделок.Следующий();
	ВыборкаПлана = Результаты[2].Выбрать();
	ВыборкаПлана.Следующий();
	Возврат СтрШаблон("Ночь %1: документов исполнения %2; сделок с поставкой %3, проходят фильтр ночи %4; сделок с остатком плановой позиции %5.",
		Формат(Ночь, "ДЛФ=D"), ЧислоДокументовНочи(Ночь), ВыборкаСделок.Сделок, ВыборкаСделок.ПроходятФильтр,
		ВыборкаПлана.Сделок);

