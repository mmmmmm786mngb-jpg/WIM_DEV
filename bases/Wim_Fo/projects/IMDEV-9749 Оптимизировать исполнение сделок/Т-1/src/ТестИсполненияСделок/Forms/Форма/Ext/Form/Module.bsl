	Запрос.УстановитьПараметр("С", НачалоДня(ТекущаяДатаСеанса()) - 21 * 86400);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Исполнения.Дата) КАК Дата
	|ИЗ
