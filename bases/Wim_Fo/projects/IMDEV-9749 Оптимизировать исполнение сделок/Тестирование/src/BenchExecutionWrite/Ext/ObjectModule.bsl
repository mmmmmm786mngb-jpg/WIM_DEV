#Область ОписаниеПеременных

Перем Лог;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Описание: Замер настоящего вызова РегистрыСведений.РасширенияПоручений.ОбновитьДанныеИсполнения вместе с записью
// (РасширенияПоручений, ЗаписатьСтатус в СтатусыПоручений). Три группы тестовых поручений по Количество штук:
// группа 1 - по одному поручению за вызов (как сейчас в проведении), группа 2 - один список, группа 3 - пачки по 500.
// У тестовых поручений статус "Исполнена", расчетный статус Ready, задолженностей нет: пересчет переводит расчетный
// статус в Accounting, как в конце ночи. После замера тестовые документы и записи регистров удаляются.
//
// Параметры:
//  Параметры - Структура - ПутьЛога (Строка), Количество (Число, по умолчанию 1000)
//  АдресХранилища - Строка - адрес временного хранилища для текста результата
//
Процедура ВыполнитьТест(Параметры, АдресХранилища) Экспорт

    Лог = Новый Массив;
    Добавить("Старт " + Формат(ТекущаяДатаСеанса(), "ДФ='yyyy-MM-dd HH:mm:ss'"));
    Добавить("Замер ОбновитьДанныеИсполнения с записью: по одному поручению, одним списком, пачками по 500.");

    Количество = 1000;
    Если Параметры.Свойство("Количество") И ЗначениеЗаполнено(Параметры.Количество) Тогда
        Количество = Параметры.Количество;
    КонецЕсли;

    Попытка
        ЗамеритьЗапись(Количество);
    Исключение
        Добавить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Попытка
        УдалитьТестовые();
    Исключение
        Добавить("Удаление: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Добавить("Конец " + Формат(ТекущаяДатаСеанса(), "ДФ='yyyy-MM-dd HH:mm:ss'"));
    Текст = СтрСоединить(Лог, Символы.ПС);
    Если ЗначениеЗаполнено(АдресХранилища) Тогда
        ПоместитьВоВременноеХранилище(Текст, АдресХранилища);
    КонецЕсли;
    Если Параметры.Свойство("ПутьЛога") И ЗначениеЗаполнено(Параметры.ПутьЛога) Тогда
        Запись = Новый ЗаписьТекста(Параметры.ПутьЛога, КодировкаТекста.UTF8);
        Запись.Записать(Текст);
        Запись.Закрыть();
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗамеритьЗапись(Количество)

    УдалитьТестовые();

    Образец = ОбразецПоручения();
    ДатаДокумента = Дата(2026, 10, 31, 12, 0, 0);
    Группы = Новый Массив;
    НачалоСоздания = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Для НомерГруппы = 1 По 3 Цикл
        Поручения = Новый Массив;
        Для Индекс = 0 По Количество - 1 Цикл
            Поручения.Добавить(СоздатьПоручение(Образец, ДатаДокумента, Индекс));
        КонецЦикла;
        Группы.Добавить(Поручения);
        Добавить("Создана группа " + Строка(НомерГруппы) + ": " + Строка(Количество) + " поручений, "
            + ФорматСекунд(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСоздания) + " с от начала");
    КонецЦикла;
    Добавить("Задолженностей у тестовых поручений: " + Строка(ЧислоЗадолженностей(Группы[0])));
    Добавить("Расчетные статусы до пересчета: " + РаспределениеСтатусов());

    // Прогрев: тот же вызов на пустом списке и чтение регистров
    РегистрыСведений.РасширенияПоручений.ОбновитьДанныеИсполнения(Новый Массив);

    Добавить("--- Группа 1: по одному поручению за вызов (как сейчас в проведении каждого документа)");
    СуммаСоСменой = ЗамеритьПоОдному(Группы[0], "со сменой расчетного статуса");
    СуммаБезСмены = ЗамеритьПоОдному(Группы[0], "без смены расчетного статуса (повторный вызов)");
    УстановитьСтатусReady(Группы[0]);
    СуммаСоСменой2 = ЗамеритьПоОдному(Группы[0], "со сменой расчетного статуса, повтор");

    Добавить("--- Группа 2: один вызов на весь список");
    СуммаСписка = ЗамеритьСписком(Группы[1], Количество, "со сменой расчетного статуса");
    СуммаСпискаБезСмены = ЗамеритьСписком(Группы[1], Количество, "без смены расчетного статуса (повторный вызов)");

    Добавить("--- Группа 3: пачками по 500");
    СуммаПачек = ЗамеритьСписком(Группы[2], 500, "со сменой расчетного статуса");

    Добавить("--- Итог на одно поручение");
    Добавить("По одному, со сменой статуса: " + ФорматМс(СуммаСоСменой / Количество) + " мс (повтор "
        + ФорматМс(СуммаСоСменой2 / Количество) + " мс)");
    Добавить("По одному, без смены статуса: " + ФорматМс(СуммаБезСмены / Количество) + " мс");
    Добавить("Один список, со сменой статуса: " + ФорматМс(СуммаСписка / Количество) + " мс");
    Добавить("Один список, без смены статуса: " + ФорматМс(СуммаСпискаБезСмены / Количество) + " мс");
    Добавить("Пачки по 500, со сменой статуса: " + ФорматМс(СуммаПачек / Количество) + " мс");

    Добавить("--- Регресс записи: группы 1, 2, 3 по одинаковым номерам поручений");
    СравнитьГруппы(Группы, Количество);
    Добавить("Расчетные статусы после пересчета: " + РаспределениеСтатусов());

КонецПроцедуры

Функция ЗамеритьПоОдному(Поручения, Описание)

    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Для Каждого Поручение Из Поручения Цикл
        РегистрыСведений.РасширенияПоручений.ОбновитьДанныеИсполнения(
            ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Поручение));
    КонецЦикла;
    Сумма = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
    Добавить("По одному, " + Описание + ": " + Строка(Поручения.Количество()) + " вызовов, " + ФорматСекунд(Сумма) + " с");
    Возврат Сумма;

КонецФункции

Функция ЗамеритьСписком(Поручения, РазмерПачки, Описание)

    Пачки = Новый Массив;
    Пачка = Новый Массив;
    Для Каждого Поручение Из Поручения Цикл
        Пачка.Добавить(Поручение);
        Если Пачка.Количество() = РазмерПачки Тогда
            Пачки.Добавить(Пачка);
            Пачка = Новый Массив;
        КонецЕсли;
    КонецЦикла;
    Если Пачка.Количество() > 0 Тогда
        Пачки.Добавить(Пачка);
    КонецЕсли;

    Замеры = Новый Массив;
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Для Каждого Пачка Из Пачки Цикл
        НачалоПачки = ТекущаяУниверсальнаяДатаВМиллисекундах();
        РегистрыСведений.РасширенияПоручений.ОбновитьДанныеИсполнения(Пачка);
        Замеры.Добавить(ФорматСекунд(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПачки));
    КонецЦикла;
    Сумма = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
    Добавить("Списком по " + Строка(РазмерПачки) + ", " + Описание + ": " + Строка(Пачки.Количество()) + " вызовов, "
        + ФорматСекунд(Сумма) + " с (по вызовам: " + СтрСоединить(Замеры, ", ") + " с)");
    Возврат Сумма;

КонецФункции

Процедура СравнитьГруппы(Группы, Количество)

    Значения = Новый Массив;
    Для Каждого Поручения Из Группы Цикл
        Значения.Добавить(ПрочитатьРезультат(Поручения));
    КонецЦикла;

    Расхождения = 0;
    НетЗаписи = 0;
    Пример = "";
    Для Индекс = 0 По Количество - 1 Цикл
        Эталон = Значения[0].Получить(Группы[0][Индекс]);
        Для НомерГруппы = 1 По 2 Цикл
            Сравниваемое = Значения[НомерГруппы].Получить(Группы[НомерГруппы][Индекс]);
            Если Эталон = Неопределено Или Сравниваемое = Неопределено Тогда
                НетЗаписи = НетЗаписи + 1;
            ИначеЕсли Эталон <> Сравниваемое Тогда
                Расхождения = Расхождения + 1;
                Если Пример = "" Тогда
                    Пример = "номер " + Строка(Индекс) + ": " + Эталон + " / " + Сравниваемое;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Различные = Новый Соответствие;
    Для Каждого Элемент Из Значения[0] Цикл
        Различные.Вставить(Элемент.Значение, Истина);
    КонецЦикла;
    Если ЗначениеЗаполнено(Пример) Тогда
        Пример = " (" + Пример + ")";
    КонецЕсли;
    Добавить("Сравнено пар: " + Строка(Количество * 2) + ", нет записи " + Строка(НетЗаписи)
        + ", расхождений " + Строка(Расхождения) + Пример);
    Добавить("Различных наборов статус/исполнение/объем/НКД в группе 1: " + Строка(Различные.Количество()));
    Если НетЗаписи = 0 И Расхождения = 0 Тогда
        Добавить("Регресс записи: совпало");
    Иначе
        Добавить("Регресс записи: ЕСТЬ РАСХОЖДЕНИЯ");
    КонецЕсли;

КонецПроцедуры

Функция ПрочитатьРезультат(Поручения)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Поручения", Поручения);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Расш.Поручение КАК Поручение,
    |    Расш.Исполнение КАК Исполнение,
    |    Расш.Объем КАК Объем,
    |    Расш.НКД КАК НКД,
    |    Расш.ОбъемБезНКД КАК ОбъемБезНКД,
    |    ЕСТЬNULL(Статусы.СтатусРасш, ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийБлоттер.ПустаяСсылка)) КАК СтатусРасш
    |ИЗ
    |    РегистрСведений.РасширенияПоручений КАК Расш
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПоручений КАК Статусы
    |        ПО Расш.Поручение = Статусы.Поручение
    |ГДЕ
    |    Расш.Поручение В (&Поручения)";
    Результат = Новый Соответствие;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Результат.Вставить(Выборка.Поручение, Строка(Выборка.СтатусРасш) + "/"
            + Формат(Выборка.Исполнение, "ЧДЦ=4; ЧРД=.; ЧГ=0") + "/"
            + Формат(Выборка.Объем, "ЧДЦ=2; ЧРД=.; ЧГ=0") + "/"
            + Формат(Выборка.НКД, "ЧДЦ=2; ЧРД=.; ЧГ=0") + "/"
            + Формат(Выборка.ОбъемБезНКД, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
    КонецЦикла;
    Возврат Результат;

КонецФункции

Функция СоздатьПоручение(Образец, ДатаДокумента, Индекс)

    Остаток = ОстатокОтДеления(Индекс, 20);
    ДокументОбъект = Документы.Поручение.СоздатьДокумент();
    ДокументОбъект.Дата = ДатаДокумента;
    ДокументОбъект.Актив = Образец.Актив;
    ДокументОбъект.ВалютаРасчетов = Образец.ВалютаРасчетов;
    ДокументОбъект.ТипПортфеля = Образец.ТипПортфеля;
    ДокументОбъект.Портфель = Образец.Портфель;
    ДокументОбъект.СчетУчета = Образец.СчетУчета;
    Если Остаток = 0 Тогда
        ДокументОбъект.ВидОперации = Образец.ВидРепо;
        ДокументОбъект.Направление = Образец.Покупка;
        ДокументОбъект.Количество = 5 + ОстатокОтДеления(Индекс, 4);
        ДокументОбъект.ЗаполнениеПоСумме = Истина;
        ДокументОбъект.СуммаПоручения = 1000 + Индекс;
        ДокументОбъект.ЦенаВВалютеРасчетов = 0;
    Иначе
        ДокументОбъект.ВидОперации = Образец.ВидСделка;
        Если Остаток <= 3 Тогда
            ДокументОбъект.Направление = Образец.Продажа;
        Иначе
            ДокументОбъект.Направление = Образец.Покупка;
        КонецЕсли;
        ДокументОбъект.Количество = 10 + ОстатокОтДеления(Индекс, 50);
        ДокументОбъект.ЦенаВВалютеРасчетов = 100 + ОстатокОтДеления(Индекс, 17);
        ДокументОбъект.ЗаполнениеПоСумме = Ложь;
        ДокументОбъект.СуммаПоручения = ДокументОбъект.Количество * ДокументОбъект.ЦенаВВалютеРасчетов;
    КонецЕсли;
    ДокументОбъект.Купон = 1;
    ДокументОбъект.КурсПересчетов = 1;
    ДокументОбъект.КомментарийКлиента = Маркер();
    Строка = ДокументОбъект.РаспределениеПоПортфелям.Добавить();
    Строка.Портфель = Образец.Портфель;
    Строка.ТипПортфеля = Образец.ТипПортфеля;
    Строка.Количество = ДокументОбъект.Количество;
    Строка.СчетУчета = Образец.СчетУчета;
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Проведен = Истина;
    ДокументОбъект.Записать();
    Ссылка = ДокументОбъект.Ссылка;

    Если ОстатокОтДеления(Индекс, 7) = 0 Тогда
        ЗаписатьПрогноз(Ссылка, Образец, ДатаДокумента, 5);
    КонецЕсли;
    УстановитьСтатусReady(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка));

    Возврат Ссылка;

КонецФункции

Процедура УстановитьСтатусReady(Поручения)

    Для Каждого Поручение Из Поручения Цикл
        Набор = РегистрыСведений.СтатусыПоручений.СоздатьНаборЗаписей();
        Набор.Отбор.Поручение.Установить(Поручение);
        Запись = Набор.Добавить();
        Запись.Поручение = Поручение;
        Запись.Исполнена = Истина;
        Запись.Статус = Перечисления.СтатусыПоручений.Исполнена;
        Запись.СтатусРасш = Перечисления.СтатусыПорученийБлоттер.Ready;
        Запись.ДатаСтатуса = ТекущаяДатаСеанса();
        Набор.ОбменДанными.Загрузка = Истина;
        Набор.Записать();
    КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьПрогноз(Поручение, Образец, ДатаДокумента, Количество)

    Набор = РегистрыНакопления.ПрогнозПоПоручению.СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Поручение);
    Движение = Набор.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.Период = ДатаДокумента;
    Движение.Портфель = Образец.Портфель;
    Движение.Актив = Образец.Актив;
    Движение.Поручение = Поручение;
    Движение.ТипПортфеля = Образец.ТипПортфеля;
    Движение.СчетУчета = Образец.СчетУчета;
    Движение.Количество = Количество;
    Движение.Сумма = Количество;
    Набор.ОбменДанными.Загрузка = Истина;
    Набор.Записать();

КонецПроцедуры

Функция ОбразецПоручения()

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Поручения.Актив КАК Актив,
    |    Поручения.ВалютаРасчетов КАК ВалютаРасчетов,
    |    Поручения.Портфель КАК Портфель,
    |    Поручения.СчетУчета КАК СчетУчета
    |ИЗ
    |    Документ.Поручение КАК Поручения
    |ГДЕ
    |    Поручения.Актив <> ЗНАЧЕНИЕ(Справочник.Активы.ПустаяСсылка)
    |    И Поручения.ВалютаРасчетов <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
    |    И Поручения.Портфель <> ЗНАЧЕНИЕ(Справочник.Портфели.ПустаяСсылка)";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "Нет поручения-образца";
    КонецЕсли;
    Образец = Новый Структура;
    Образец.Вставить("Актив", Выборка.Актив);
    Образец.Вставить("ВалютаРасчетов", Выборка.ВалютаРасчетов);
    Образец.Вставить("Портфель", Выборка.Портфель);
    Образец.Вставить("СчетУчета", Выборка.СчетУчета);
    Образец.Вставить("ТипПортфеля", Перечисления.ТипыПортфелей.АктивыДляПерепродажи);
    Образец.Вставить("ВидСделка", Перечисления.ВидыПоручений.Сделка);
    Образец.Вставить("ВидРепо", Перечисления.ВидыПоручений.РЕПО);
    Образец.Вставить("Покупка", Перечисления.ВидыОперацийСделки.Покупка);
    Образец.Вставить("Продажа", Перечисления.ВидыОперацийСделки.Продажа);
    Возврат Образец;

КонецФункции

Функция ЧислоЗадолженностей(Поручения)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Поручения", Поручения);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    КОЛИЧЕСТВО(*) КАК Строк
    |ИЗ
    |    (ВЫБРАТЬ
    |        Т.Поручение КАК Поручение
    |    ИЗ
    |        РегистрНакопления.ЗадолженностьПоБумаге.Остатки(, Поручение В (&Поручения)) КАК Т
    |
    |    ОБЪЕДИНИТЬ ВСЕ
    |
    |    ВЫБРАТЬ
    |        Т.Поручение
    |    ИЗ
    |        РегистрНакопления.ЗадолженностьПоВалюте.Остатки(, Поручение В (&Поручения)) КАК Т) КАК Т";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Строк;

КонецФункции

Функция РаспределениеСтатусов()

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Маркер", Маркер());
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Статусы.СтатусРасш КАК СтатусРасш,
    |    КОЛИЧЕСТВО(*) КАК Поручений
    |ИЗ
    |    РегистрСведений.СтатусыПоручений КАК Статусы
    |ГДЕ
    |    Статусы.Поручение.КомментарийКлиента = &Маркер
    |
    |СГРУППИРОВАТЬ ПО
    |    Статусы.СтатусРасш";
    Части = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Части.Добавить(Строка(Выборка.СтатусРасш) + " " + Строка(Выборка.Поручений));
    КонецЦикла;
    Если Не ЗначениеЗаполнено(Части) Тогда
        Возврат "нет записей";
    КонецЕсли;
    Возврат СтрСоединить(Части, ", ");

КонецФункции

Процедура УдалитьТестовые()

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Маркер", Маркер());
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Поручения.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.Поручение КАК Поручения
    |ГДЕ
    |    Поручения.КомментарийКлиента = &Маркер";
    Поручения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    ОшибокИстории = 0;
    Для Каждого Поручение Из Поручения Цикл
        Набор = РегистрыСведений.РасширенияПоручений.СоздатьНаборЗаписей();
        Набор.Отбор.Поручение.Установить(Поручение);
        Набор.ОбменДанными.Загрузка = Истина;
        Набор.Записать();

        Набор = РегистрыСведений.СтатусыПоручений.СоздатьНаборЗаписей();
        Набор.Отбор.Поручение.Установить(Поручение);
        Набор.ОбменДанными.Загрузка = Истина;
        Набор.Записать();
        Попытка
            КлючЗаписи = РегистрыСведений.СтатусыПоручений.СоздатьКлючЗаписи(Новый Структура("Поручение", Поручение));
            ИсторияДанных.УдалитьВерсии(КлючЗаписи);
        Исключение
            ОшибокИстории = ОшибокИстории + 1;
        КонецПопытки;

        Набор = РегистрыНакопления.ПрогнозПоПоручению.СоздатьНаборЗаписей();
        Набор.Отбор.Регистратор.Установить(Поручение);
        Набор.ОбменДанными.Загрузка = Истина;
        Набор.Записать();

        Объект = Поручение.ПолучитьОбъект();
        Если Объект <> Неопределено Тогда
            Объект.ОбменДанными.Загрузка = Истина;
            Объект.Удалить();
        КонецЕсли;
    КонецЦикла;
    Текст = "Удалено поручений " + Строка(Поручения.Количество()) + " с записями регистров за "
        + ФорматСекунд(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) + " с";
    Если ОшибокИстории > 0 Тогда
        Текст = Текст + ", версии истории не удалены: " + Строка(ОшибокИстории);
    КонецЕсли;
    Добавить(Текст);

КонецПроцедуры

Функция Маркер()
    Возврат "TEXECW";
КонецФункции

Функция ОстатокОтДеления(Значение, Делитель)
    Возврат Значение - Цел(Значение / Делитель) * Делитель;
КонецФункции

Функция ФорматСекунд(Миллисекунды)
    Возврат Формат(Миллисекунды / 1000, "ЧДЦ=1; ЧРД=.; ЧН=0; ЧГ=0");
КонецФункции

Функция ФорматМс(Миллисекунды)
    Возврат Формат(Миллисекунды, "ЧДЦ=1; ЧРД=.; ЧН=0; ЧГ=0");
КонецФункции

Процедура Добавить(Текст)
    Лог.Добавить(Текст);
КонецПроцедуры

#КонецОбласти
