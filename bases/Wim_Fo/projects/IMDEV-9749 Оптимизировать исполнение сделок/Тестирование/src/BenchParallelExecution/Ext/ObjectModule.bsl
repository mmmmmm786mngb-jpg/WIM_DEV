#Область ПрограммныйИнтерфейс

// Описание: Создает тестовые поручения, сделки, приход плановой позиции и долга по образцу ночи обычного ФО.
// У каждой сделки две ноги: бумага и рубли. После создания пересчитывает поручения, чтобы до ночи
// у них были записи расширения и расчетный статус, как на рабочей базе.
//
// Параметры:
//  Параметры - Структура - ПутьЛога, Маркер (префикс номеров сделок), ДеньПоставки (строка ГГГГММДД),
//              СделокПоПоручениям (строка чисел через запятую), ЧислоПортфелей
//  АдресХранилища - Строка - адрес временного хранилища для текста лога
//
Процедура Подготовить(Параметры, АдресХранилища) Экспорт

    Лог = Новый Массив;
    ПутьЛога = Параметры.ПутьЛога;
    Добавить(Лог, ПутьЛога, "Старт подготовки " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Попытка
        ПодготовитьДанные(Параметры, Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, "ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Завершить(Лог, ПутьЛога, АдресХранилища);

КонецПроцедуры

// Описание: Выполняет ночное исполнение по тестовым сделкам одним из вариантов и пишет снимок итога.
// A - процедура конфигурации СоздатьДокументыИсполнения без изменений (пересчет поручения в каждом проведении).
// B - тот же цикл, пересчет внутри проведения отключен, после цикла один пересчет списком пачками по 1000.
// C - как B, но документы проводятся в фоновых потоках, все строки одного поручения в одном потоке.
//
// Параметры:
//  Параметры - Структура - ПутьЛога, ПутьСнимка, Маркер, ДеньПоставки (строка ГГГГММДД), Вариант,
//              Потоков (для C), ПутьОбработки (файл этой обработки на сервере, для фоновых потоков)
//  АдресХранилища - Строка - адрес временного хранилища для текста лога
//
Процедура ВыполнитьВариант(Параметры, АдресХранилища) Экспорт

    Лог = Новый Массив;
    ПутьЛога = Параметры.ПутьЛога;
    Добавить(Лог, ПутьЛога, "Старт варианта " + Параметры.Вариант + " "
        + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Попытка
        ИсполнитьНочь(Параметры, Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, "ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Попытка
        ЗаписатьСнимок(Параметры.Маркер, Параметры.ПутьСнимка, Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, "ОШИБКА снимка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Завершить(Лог, ПутьЛога, АдресХранилища);

КонецПроцедуры

// Описание: Возвращает тестовые данные в состояние до ночи: удаляет документы исполнения тестовых сделок
// вместе с движениями (в фоновых потоках), записывает исходный статус поручений и пересчитывает их списком.
// Сделки, поручения, приход плановой позиции и долга не трогает.
//
// Параметры:
//  Параметры - Структура - ПутьЛога, Маркер, Потоков, ПутьОбработки
//  АдресХранилища - Строка - адрес временного хранилища для текста лога
//
Процедура Сбросить(Параметры, АдресХранилища) Экспорт

    Лог = Новый Массив;
    ПутьЛога = Параметры.ПутьЛога;
    Добавить(Лог, ПутьЛога, "Старт сброса " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Попытка
        УдалитьИсполнения(Параметры, Лог, ПутьЛога);
        Поручения = ПорученияТеста(Параметры.Маркер);
        Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Для Каждого Поручение Из Поручения Цикл
            ЗаписатьИсходныйСтатус(Поручение);
        КонецЦикла;
        ОбновитьИтогово(Поручения);
        Добавить(Лог, ПутьЛога, "Исходный статус и пересчет поручений: " + Строка(Поручения.Количество())
            + " за " + СекундыТекста((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000));
        ЗаписатьСчетчики(Параметры.Маркер, Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, "ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Завершить(Лог, ПутьЛога, АдресХранилища);

КонецПроцедуры

// Описание: Удаляет все тестовые данные маркера: документы исполнения, сделки, поручения и их движения,
// записи статуса и расширения поручений. Удаление идет в фоновых потоках, в конце пишутся остатки счетчиков.
//
// Параметры:
//  Параметры - Структура - ПутьЛога, Маркер, Потоков, ПутьОбработки
//  АдресХранилища - Строка - адрес временного хранилища для текста лога
//
Процедура УдалитьВсе(Параметры, АдресХранилища) Экспорт

    Лог = Новый Массив;
    ПутьЛога = Параметры.ПутьЛога;
    Добавить(Лог, ПутьЛога, "Старт удаления " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Попытка
        УдалитьИсполнения(Параметры, Лог, ПутьЛога);
        Поручения = ПорученияТеста(Параметры.Маркер);
        УдалитьПорциями("Сделки", СделкиТеста(Параметры.Маркер), Параметры, Лог, ПутьЛога);
        УдалитьПорциями("Поручения", Поручения, Параметры, Лог, ПутьЛога);
        ЗаписатьСчетчики(Параметры.Маркер, Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, "ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Завершить(Лог, ПутьЛога, АдресХранилища);

КонецПроцедуры

// Описание: Тело фонового потока проведения. Проводит переданные строки как ночной цикл, но с отключенным
// пересчетом поручения. Ошибка документа не прерывает поток, она считается и попадает в результат.
// Результат кладет во временное хранилище.
//
// Параметры:
//  Параметры - Структура - Строки (Массив из Структура полей строки таблицы сделок), ДатаДокумента, НомерПотока
//  АдресХранилища - Строка - адрес результата, см. ПровестиСтрокиБезПересчета
//
Процедура ПровестиПорцию(Параметры, АдресХранилища) Экспорт

    Результат = ПровестиСтрокиБезПересчета(Параметры.Строки, Параметры.ДатаДокумента, Параметры.Повторов);
    Результат.Вставить("НомерПотока", Параметры.НомерПотока);
    ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

// Описание: Тело фонового потока удаления тестовых объектов одного вида вместе с их движениями.
//
// Параметры:
//  Параметры - Структура - Вид ("Исполнения", "Сделки", "Поручения"), Ссылки (Массив), НомерПотока
//  АдресХранилища - Строка - адрес результата: Структура с полями Обработано, ЧислоОшибок, Ошибки, НомерПотока
//
Процедура УдалитьПорцию(Параметры, АдресХранилища) Экспорт

    Обработано = 0;
    ЧислоОшибок = 0;
    Ошибки = Новый Массив;
    Для Каждого Ссылка Из Параметры.Ссылки Цикл
        Попытка
            Если Параметры.Вид = "Исполнения" Тогда
                ОчиститьДвиженияИсполнения(Ссылка);
            ИначеЕсли Параметры.Вид = "Сделки" Тогда
                ОчиститьНаборНакопления("ПлановаяПозиция", Ссылка);
                ОчиститьНаборНакопления("ЗадолженностьПоБумаге", Ссылка);
                ОчиститьНаборНакопления("ЗадолженностьПоВалюте", Ссылка);
            Иначе
                ОчиститьНезависимыйРегистр("РасширенияПоручений", Ссылка);
                ОчиститьНезависимыйРегистр("СтатусыПоручений", Ссылка);
                ОчиститьНаборНакопления("ПрогнозПоПоручению", Ссылка);
            КонецЕсли;
            УдалитьДокумент(Ссылка);
            Обработано = Обработано + 1;
        Исключение
            ЧислоОшибок = ЧислоОшибок + 1;
            Если Ошибки.Количество() < 10 Тогда
                Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
            КонецЕсли;
        КонецПопытки;
    КонецЦикла;
    Результат = Новый Структура;
    Результат.Вставить("Обработано", Обработано);
    Результат.Вставить("ЧислоОшибок", ЧислоОшибок);
    Результат.Вставить("Ошибки", Ошибки);
    Результат.Вставить("НомерПотока", Параметры.НомерПотока);
    ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

#КонецОбласти

#Область Подготовка

Процедура ПодготовитьДанные(Параметры, Лог, ПутьЛога)

    Маркер = Параметры.Маркер;
    ДеньПоставки = Дата(Параметры.ДеньПоставки);
    МоментОстатка = ДеньПоставки + 12 * 3600;
    СделокПоПоручениям = СтрРазделить(Параметры.СделокПоПоручениям, ",", Ложь);
    Образец = ОбразецДанных(Параметры.ЧислоПортфелей);
    Добавить(Лог, ПутьЛога, "Поручений " + Строка(СделокПоПоручениям.Количество()) + ", портфелей "
        + Строка(Образец.Портфели.Количество()) + ", бумаг " + Строка(Образец.Бумаги.Количество())
        + ", GetListOfDeals: " + ПредставлениеФлага(ФлагОбмена()));

    Если ЗначениеЗаполнено(СделкиТеста(Маркер)) Тогда
        ВызватьИсключение "Тестовые сделки маркера " + Маркер + " уже есть, сначала удалить";
    КонецЕсли;

    Поручения = Новый Массив;
    ВсегоСделок = 0;
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Для НомерПоручения = 0 По СделокПоПоручениям.ВГраница() Цикл
        ЧислоСделок = Число(СделокПоПоручениям[НомерПоручения]);
        Портфель = Образец.Портфели[ОстатокОтДеления(НомерПоручения, Образец.Портфели.Количество())];
        Бумага = Образец.Бумаги[ОстатокОтДеления(НомерПоручения, Образец.Бумаги.Количество())];
        Покупка = ОстатокОтДеления(НомерПоручения, 2) = 0;
        Если Покупка Тогда
            ЗнакБумаги = 1;
        Иначе
            ЗнакБумаги = -1;
        КонецЕсли;
        Цена = 100 + ОстатокОтДеления(НомерПоручения, 50);

        Количества = Новый Массив;
        КоличествоПоручения = 0;
        Для НомерСделки = 0 По ЧислоСделок - 1 Цикл
            КоличествоСделки = 1 + ОстатокОтДеления(НомерПоручения * 7 + НомерСделки * 13, 30);
            Количества.Добавить(КоличествоСделки);
            КоличествоПоручения = КоличествоПоручения + КоличествоСделки;
        КонецЦикла;

        Ключ = Маркер + "-" + Формат(НомерПоручения, "ЧЦ=5; ЧВН=; ЧГ=0; ЧН=00000");
        Поручение = СоздатьПоручение(Образец, МоментОстатка, Портфель, Бумага, Покупка, КоличествоПоручения,
            Цена, Ключ);
        Поручения.Добавить(Поручение);

        Для НомерСделки = 0 По Количества.ВГраница() Цикл
            КоличествоСделки = Количества[НомерСделки];
            НомерСделкиТекст = Ключ + "-" + Формат(НомерСделки, "ЧЦ=4; ЧВН=; ЧГ=0; ЧН=0000");
            Сделка = СоздатьСделку(Образец, ДеньПоставки, МоментОстатка, Поручение, Бумага, Покупка,
                КоличествоСделки, Цена, НомерСделкиТекст);
            КоличествоБумаги = ЗнакБумаги * КоличествоСделки;
            КоличествоДенег = -ЗнакБумаги * КоличествоСделки * Цена;
            ЗаписатьДвиженияСделки(Образец, Сделка, Поручение, Портфель, Бумага, КоличествоБумаги, КоличествоДенег,
                МоментОстатка);
            ВсегоСделок = ВсегоСделок + 1;
        КонецЦикла;

        Если ОстатокОтДеления(НомерПоручения + 1, 100) = 0 Тогда
            Добавить(Лог, ПутьЛога, "Создано поручений " + Строка(НомерПоручения + 1) + ", сделок "
                + Строка(ВсегоСделок) + " за "
                + СекундыТекста((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000));
        КонецЕсли;
    КонецЦикла;
    Добавить(Лог, ПутьЛога, "Создано поручений " + Строка(Поручения.Количество()) + ", сделок " + Строка(ВсегоСделок)
        + " за " + СекундыТекста((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000));

    НачалоПересчета = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Для Каждого Поручение Из Поручения Цикл
        ЗаписатьИсходныйСтатус(Поручение);
    КонецЦикла;
    ОбновитьИтогово(Поручения);
    Добавить(Лог, ПутьЛога, "Исходный статус и пересчет поручений до ночи: "
        + СекундыТекста((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПересчета) / 1000));

    Обработка = Обработки.ГрупповоеИсполнениеСделок.Создать();
    Обработка.НаДату = ДеньПоставки + 23 * 3600 + 55 * 60;
    Обработка.ЗаполнитьТаблицуСделок();
    Добавить(Лог, ПутьЛога, "Строк таблицы ночи: " + Строка(Обработка.Сделки.Количество())
        + ", ожидается " + Строка(ВсегоСделок * 2));
    ЗаписатьСчетчики(Маркер, Лог, ПутьЛога);

КонецПроцедуры

Функция ОбразецДанных(ЧислоПортфелей)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ЧислоПортфелей", ЧислоПортфелей);
    Виды = Новый Массив;
    Виды.Добавить("Облигации");
    Виды.Добавить("Обыкновенные акции ПАО РФ");
    Виды.Добавить("Привилегированные акции ПАО РФ");
    Виды.Добавить("Гос. ц/б  РФ");
    Запрос.УстановитьПараметр("Виды", Виды);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Портфели.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.Портфели КАК Портфели
    |ГДЕ
    |    НЕ Портфели.ПометкаУдаления
    |    И Портфели.Наименование ПОДОБНО ""T9532%""
    |
    |УПОРЯДОЧИТЬ ПО
    |    Портфели.Наименование
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ ПЕРВЫЕ 12
    |    Активы.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.Активы КАК Активы
    |ГДЕ
    |    НЕ Активы.ПометкаУдаления
    |    И Активы.ВидАктива.Наименование В (&Виды)
    |
    |УПОРЯДОЧИТЬ ПО
    |    Активы.Наименование
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ ПЕРВЫЕ 1
    |    Активы.Ссылка КАК Ссылка,
    |    Активы.Объект КАК Валюта
    |ИЗ
    |    Справочник.Активы КАК Активы
    |ГДЕ
    |    Активы.ВидАктива = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыАктивов.Валюты)
    |    И Активы.Наименование = ""RUB""
    |    И НЕ Активы.ПометкаУдаления
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ ПЕРВЫЕ 1
    |    Счета.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.СчетаУчетаЕПС КАК Счета
    |ГДЕ
    |    НЕ Счета.ПометкаУдаления
    |
    |УПОРЯДОЧИТЬ ПО
    |    Счета.Код";
    Результаты = Запрос.ВыполнитьПакет();

    Портфели = Новый Массив;
    Выборка = Результаты[0].Выбрать();
    Пока Выборка.Следующий() И Портфели.Количество() < ЧислоПортфелей Цикл
        Портфели.Добавить(Выборка.Ссылка);
    КонецЦикла;
    Бумаги = Результаты[1].Выгрузить().ВыгрузитьКолонку("Ссылка");
    ВыборкаРубля = Результаты[2].Выбрать();
    Если Не ЗначениеЗаполнено(Портфели) Или Не ЗначениеЗаполнено(Бумаги) Или Не ВыборкаРубля.Следующий() Тогда
        ВызватьИсключение "На стенде нет тестовых портфелей T9532, бумаг или актива RUB";
    КонецЕсли;
    ВыборкаСчета = Результаты[3].Выбрать();
    Если ВыборкаСчета.Следующий() Тогда
        СчетУчета = ВыборкаСчета.Ссылка;
    Иначе
        СчетУчета = Справочники.СчетаУчетаЕПС.ПустаяСсылка();
    КонецЕсли;

    Образец = Новый Структура;
    Образец.Вставить("Портфели", Портфели);
    Образец.Вставить("Бумаги", Бумаги);
    Образец.Вставить("Рубль", ВыборкаРубля.Ссылка);
    Образец.Вставить("ВалютаРасчетов", ВыборкаРубля.Валюта);
    Образец.Вставить("СчетУчета", СчетУчета);
    Образец.Вставить("ТипПортфеля", Перечисления.ТипыПортфелей.АктивыДляПерепродажи);
    Образец.Вставить("ВидСделка", Перечисления.ВидыПоручений.Сделка);
    Возврат Образец;

КонецФункции

Функция СоздатьПоручение(Образец, ДатаДокумента, Портфель, Бумага, Покупка, Количество, Цена, Ключ)

    ДокументОбъект = Документы.Поручение.СоздатьДокумент();
    ДокументОбъект.Дата                 = ДатаДокумента;
    ДокументОбъект.Актив                = Бумага;
    ДокументОбъект.ВалютаРасчетов       = Образец.ВалютаРасчетов;
    ДокументОбъект.ТипПортфеля          = Образец.ТипПортфеля;
    ДокументОбъект.Портфель             = Портфель;
    ДокументОбъект.СчетУчета            = Образец.СчетУчета;
    ДокументОбъект.ВидОперации          = Образец.ВидСделка;
    ДокументОбъект.Направление          = НаправлениеСделки(Покупка);
    ДокументОбъект.Количество           = Количество;
    ДокументОбъект.СуммаПоручения       = Количество * Цена;
    ДокументОбъект.ЗаполнениеПоСумме    = Ложь;
    ДокументОбъект.ЗаполнениеПоПортфелю = Истина;
    ДокументОбъект.ЦенаВВалютеРасчетов  = Цена;
    ДокументОбъект.КурсПересчетов       = 1;
    ДокументОбъект.КомментарийКлиента   = Ключ;
    СтрокаРаспределения = ДокументОбъект.РаспределениеПоПортфелям.Добавить();
    СтрокаРаспределения.Портфель    = Портфель;
    СтрокаРаспределения.ТипПортфеля = Образец.ТипПортфеля;
    СтрокаРаспределения.Количество  = Количество;
    СтрокаРаспределения.СчетУчета   = Образец.СчетУчета;
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Проведен = Истина;
    ДокументОбъект.Записать();
    Возврат ДокументОбъект.Ссылка;

КонецФункции

Функция СоздатьСделку(Образец, ДеньПоставки, ДатаДокумента, Поручение, Бумага, Покупка, Количество, Цена, НомерСделки)

    ДокументОбъект = Документы.Сделка.СоздатьДокумент();
    ДокументОбъект.Дата           = ДатаДокумента;
    ДокументОбъект.ДатаПоставки   = ДеньПоставки;
    ДокументОбъект.Актив          = Бумага;
    ДокументОбъект.ВалютаРасчетов = Образец.ВалютаРасчетов;
    ДокументОбъект.Поручение      = Поручение;
    ДокументОбъект.ВидОперации    = Образец.ВидСделка;
    ДокументОбъект.Направление    = НаправлениеСделки(Покупка);
    ДокументОбъект.Внебиржевая    = Ложь;
    ДокументОбъект.Количество     = Количество;
    ДокументОбъект.Цена           = Цена;
    ДокументОбъект.Сумма          = Количество * Цена;
    ДокументОбъект.НомерСделки    = НомерСделки;
    ДокументОбъект.УстановитьНовыйНомер();
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Проведен = Истина;
    ДокументОбъект.Записать();
    Возврат ДокументОбъект.Ссылка;

КонецФункции

Функция НаправлениеСделки(Покупка)

    Если Покупка Тогда
        Возврат Перечисления.ВидыОперацийСделки.Покупка;
    КонецЕсли;
    Возврат Перечисления.ВидыОперацийСделки.Продажа;

КонецФункции

// Приход плановой позиции по двум ногам сделки и приход долга поручения по бумаге и по валюте.
// Знаки совпадают с плановой позицией: исполнение спишет долг тем же количеством, и к концу ночи он станет нулем.
Процедура ЗаписатьДвиженияСделки(Образец, Сделка, Поручение, Портфель, Бумага, КоличествоБумаги, КоличествоДенег, Период)

    Набор = РегистрыНакопления.ПлановаяПозиция.СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Сделка);
    ДобавитьПриходПлана(Набор, Образец, Период, Портфель, Бумага, Сделка, КоличествоБумаги, КоличествоДенег);
    ДобавитьПриходПлана(Набор, Образец, Период, Портфель, Образец.Рубль, Сделка, КоличествоДенег, КоличествоДенег);
    Набор.ОбменДанными.Загрузка = Истина;
    Набор.Записать();

    ЗаписатьПриходДолга("ЗадолженностьПоБумаге", Сделка, Поручение, Период, КоличествоБумаги);
    ЗаписатьПриходДолга("ЗадолженностьПоВалюте", Сделка, Поручение, Период, КоличествоДенег);

КонецПроцедуры

Процедура ДобавитьПриходПлана(Набор, Образец, Период, Портфель, Актив, Сделка, Количество, Сумма)

    Движение = Набор.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.Период      = Период;
    Движение.Портфель    = Портфель;
    Движение.Актив       = Актив;
    Движение.Сделка      = Сделка;
    Движение.ТипПортфеля = Образец.ТипПортфеля;
    Движение.СчетУчета   = Образец.СчетУчета;
    Движение.Количество  = Количество;
    Движение.Сумма       = Сумма;

КонецПроцедуры

Процедура ЗаписатьПриходДолга(ИмяРегистра, Регистратор, Поручение, Период, Количество)

    Набор = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Регистратор);
    Движение = Набор.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.Период      = Период;
    Движение.Поручение   = Поручение;
    Движение.Количество  = Количество;
    Набор.ОбменДанными.Загрузка = Истина;
    Набор.Записать();

КонецПроцедуры

Процедура ЗаписатьИсходныйСтатус(Поручение)

    Набор = РегистрыСведений.СтатусыПоручений.СоздатьНаборЗаписей();
    Набор.Отбор.Поручение.Установить(Поручение);
