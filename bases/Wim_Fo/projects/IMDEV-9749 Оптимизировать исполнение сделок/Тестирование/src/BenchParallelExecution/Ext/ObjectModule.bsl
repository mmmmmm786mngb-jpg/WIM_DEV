Функция ПорученияТеста(Маркер)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Маска", Маркер + "-%");
    Запрос.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    Сделки.Поручение КАК Поручение
    |ИЗ
    |    Документ.Сделка КАК Сделки
    |ГДЕ
    |    Сделки.НомерСделки ПОДОБНО &Маска
    |    И Сделки.Поручение <> ЗНАЧЕНИЕ(Документ.Поручение.ПустаяСсылка)";
    РезультатЗапроса = Запрос.Выполнить();
    Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Поручение");

