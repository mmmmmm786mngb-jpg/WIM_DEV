#КонецОбласти

#Область СценарииРисков

// Описание: Закрывает строки таблицы рисков по трем сценариям. Сначала поштучный пересчет
// сравнивается с одним пересчетом списком, включая РЕПО со строкой активов в РЕПО.
// Затем те же сценарии проводятся в 6 потоках с отложенным пересчетом и сравниваются
// с поштучным контролем. Данные маркера удаляются.
//
// Параметры:
//  Параметры - Структура - ПутьЛога, Маркер, ПутьОбработки (файл обработки для потоков)
//  АдресХранилища - Строка - адрес временного хранилища для текста лога
//
Процедура ПрогнатьРиски(Параметры, АдресХранилища) Экспорт

    Лог = Новый Массив;
    ПутьЛога = Параметры.ПутьЛога;
    Маркер = Параметры.Маркер;
    Добавить(Лог, ПутьЛога, "Старт сценариев " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Попытка
        УдалитьДанныеМаркера(Маркер, Лог, ПутьЛога);
        Образец = ОбразецДанных(2);
        День = Дата(2099, 6, 21);
        Момент = День + 12 * 3600;
        ДатаИсполнения = День + 23 * 3600 + 55 * 60;
        Сценарии = Новый Массив;
        Сценарии.Добавить("REPO");
        Сценарии.Добавить("REPOA");
        Сценарии.Добавить("SUM");
        Сценарии.Добавить("MULTI");
        Для Каждого ИмяСценария Из Сценарии Цикл
            ПрогнатьСценарий(ИмяСценария, Образец, Маркер, Момент, День, ДатаИсполнения, Лог, ПутьЛога);
        КонецЦикла;
        ПрогнатьПараллельныеСценарии(Параметры, Образец, Маркер, Момент, День, ДатаИсполнения, Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, "ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Попытка
        УдалитьДанныеМаркера(Маркер, Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, "ОШИБКА удаления: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    Завершить(Лог, ПутьЛога, АдресХранилища);

КонецПроцедуры

Процедура ПрогнатьСценарий(ИмяСценария, Образец, Маркер, Момент, День, ДатаИсполнения, Лог, ПутьЛога)

    Добавить(Лог, ПутьЛога, "---- " + ИмяСценария);
    Поштучно = СоздатьВеткуСценария(ИмяСценария, "SEQ", Образец, Маркер, Момент, День);
    Отложенно = СоздатьВеткуСценария(ИмяСценария, "DEF", Образец, Маркер, Момент, День);
    ЗаписатьИсходныйСтатус(Поштучно.Поручение);
    ЗаписатьИсходныйСтатус(Отложенно.Поручение);
    Поручения = Новый Массив;
    Поручения.Добавить(Поштучно.Поручение);
    Поручения.Добавить(Отложенно.Поручение);
    ОбновитьИтогово(Поручения);
    Добавить(Лог, ПутьЛога, "До ночи, поштучная ветка: " + ТекстИтога(СнятьИтог(Поштучно.Поручение, Поштучно.Сделки)));
    Добавить(Лог, ПутьЛога, "До ночи, отложенная ветка: " + ТекстИтога(СнятьИтог(Отложенно.Поручение, Отложенно.Сделки)));

    ПровестиДокументыВетки(Поштучно.Строки, ДатаИсполнения, Ложь);
    ПровестиДокументыВетки(Отложенно.Строки, ДатаИсполнения, Истина);
    ОбновитьИтогово(ЗначениеВМассиве(Отложенно.Поручение));

    ИтогПоштучно = СнятьИтог(Поштучно.Поручение, Поштучно.Сделки);
    ИтогОтложенно = СнятьИтог(Отложенно.Поручение, Отложенно.Сделки);
    Добавить(Лог, ПутьЛога, "После, поштучно:   " + ТекстИтога(ИтогПоштучно));
    Добавить(Лог, ПутьЛога, "После, отложенно:  " + ТекстИтога(ИтогОтложенно));
    Добавить(Лог, ПутьЛога, "Сравнение: " + ТекстСравнения(ИтогПоштучно, ИтогОтложенно));

КонецПроцедуры

Функция СоздатьВеткуСценария(ИмяСценария, Режим, Образец, Маркер, Момент, День, Суффикс = "")

    ЭтоРепо = ИмяСценария = "REPO" Или ИмяСценария = "REPOA";
    ПоСумме = ИмяСценария = "SUM";
    ДваПортфеля = ИмяСценария = "MULTI";
    Если ДваПортфеля Тогда
        ЧислоСделок = 3;
        Цена = 100;
        КоличествоНаСделку = 10;
    Иначе
        ЧислоСделок = 5;
        Цена = 100;
        КоличествоНаСделку = 10;
    КонецЕсли;
    Портфель1 = Образец.Портфели[0];
    Портфель2 = Образец.Портфели[1];
    Бумага = Образец.Бумаги[0];
    КоличествоПоручения = ЧислоСделок * КоличествоНаСделку;
    Ключ = Маркер + "-" + ИмяСценария + "-" + Режим + Суффикс;

    ПоручениеОбъект = Документы.Поручение.СоздатьДокумент();
    ПоручениеОбъект.Дата                 = Момент;
    ПоручениеОбъект.Актив                = Бумага;
    ПоручениеОбъект.ВалютаРасчетов       = Образец.ВалютаРасчетов;
    ПоручениеОбъект.ТипПортфеля          = Образец.ТипПортфеля;
    ПоручениеОбъект.Портфель             = Портфель1;
    ПоручениеОбъект.СчетУчета            = Образец.СчетУчета;
    Если ЭтоРепо Тогда
        ПоручениеОбъект.ВидОперации = Перечисления.ВидыПоручений.РЕПО;
    Иначе
        ПоручениеОбъект.ВидОперации = Перечисления.ВидыПоручений.Сделка;
    КонецЕсли;
    ПоручениеОбъект.Направление          = НаправлениеСделки(Истина);
    ПоручениеОбъект.Количество           = КоличествоПоручения;
    ПоручениеОбъект.СуммаПоручения       = КоличествоПоручения * Цена;
    ПоручениеОбъект.ЗаполнениеПоСумме    = ПоСумме;
    ПоручениеОбъект.ЗаполнениеПоПортфелю = Не ДваПортфеля;
    ПоручениеОбъект.ЦенаВВалютеРасчетов  = Цена;
    ПоручениеОбъект.КурсПересчетов       = 1;
    ПоручениеОбъект.КомментарийКлиента   = Ключ;
    Если ДваПортфеля Тогда
        ДобавитьСтрокуРаспределения(ПоручениеОбъект, Портфель1, Образец, ЧислоСделок * 6);
        ДобавитьСтрокуРаспределения(ПоручениеОбъект, Портфель2, Образец, ЧислоСделок * 4);
    Иначе
        ДобавитьСтрокуРаспределения(ПоручениеОбъект, Портфель1, Образец, КоличествоПоручения);
    КонецЕсли;
    ПоручениеОбъект.ОбменДанными.Загрузка = Истина;
    ПоручениеОбъект.Проведен = Истина;
    ПоручениеОбъект.Записать();
    Поручение = ПоручениеОбъект.Ссылка;

    ОстатокДляПроцента = КоличествоПоручения * 2 / 5;
    Если ЭтоРепо Тогда
        ЗаписатьОстатокПоручения("ПланПоПоручению", Поручение, Бумага, Момент, ОстатокДляПроцента, 0,
            Портфель1, Образец);
    Иначе
        ЗаписатьОстатокПоручения("ПрогнозПоПоручению", Поручение, Бумага, Момент, ОстатокДляПроцента,
            ОстатокДляПроцента * Цена, Портфель1, Образец);
    КонецЕсли;

    Строки = Новый Массив;
    Сделки = Новый Массив;
    Для НомерСделки = 0 По ЧислоСделок - 1 Цикл
        НомерТекст = Ключ + "-" + Формат(НомерСделки, "ЧЦ=4; ЧВН=; ЧГ=0; ЧН=0000");
        Сделка = СоздатьСделкуСценария(Образец, День, Момент, Поручение, Бумага, КоличествоНаСделку, Цена,
            НомерТекст, ЭтоРепо);
        Сделки.Добавить(Сделка);
        Если ДваПортфеля Тогда
            ДобавитьНоги(Строки, Образец, Сделка, Портфель1, Бумага, 6, Цена);
            ДобавитьНоги(Строки, Образец, Сделка, Портфель2, Бумага, 4, Цена);
        Иначе
            ДобавитьНоги(Строки, Образец, Сделка, Портфель1, Бумага, КоличествоНаСделку, Цена);
        КонецЕсли;
        ЗаписатьНогиСделки(Образец, Сделка, Поручение, Строки, Момент);
    КонецЦикла;
    Если ИмяСценария = "REPOA" Тогда
        ЗаписатьАктивРепо(Образец, Поручение, Портфель1, Бумага, Ключ + "-ASSET", Момент);
    КонецЕсли;

    Ветка = Новый Структура;
    Ветка.Вставить("Поручение", Поручение);
    Ветка.Вставить("Сделки", Сделки);
    Ветка.Вставить("Строки", Строки);
    Возврат Ветка;

КонецФункции

Процедура ДобавитьСтрокуРаспределения(ПоручениеОбъект, Портфель, Образец, Количество)

    СтрокаРаспределения = ПоручениеОбъект.РаспределениеПоПортфелям.Добавить();
    СтрокаРаспределения.Портфель    = Портфель;
    СтрокаРаспределения.ТипПортфеля = Образец.ТипПортфеля;
    СтрокаРаспределения.Количество  = Количество;
    СтрокаРаспределения.СчетУчета   = Образец.СчетУчета;

КонецПроцедуры

Функция СоздатьСделкуСценария(Образец, День, Момент, Поручение, Бумага, Количество, Цена, НомерСделки, ЭтоРепо)

    ДокументОбъект = Документы.Сделка.СоздатьДокумент();
    ДокументОбъект.Дата           = Момент;
    ДокументОбъект.ДатаПоставки   = День;
    ДокументОбъект.Актив          = Бумага;
    ДокументОбъект.ВалютаРасчетов = Образец.ВалютаРасчетов;
    ДокументОбъект.Поручение      = Поручение;
    Если ЭтоРепо Тогда
        ДокументОбъект.ВидОперации = Перечисления.ВидыПоручений.РЕПО;
    Иначе
        ДокументОбъект.ВидОперации = Перечисления.ВидыПоручений.Сделка;
    КонецЕсли;
    ДокументОбъект.Направление    = НаправлениеСделки(Истина);
    ДокументОбъект.Внебиржевая    = Ложь;
    ДокументОбъект.Количество     = Количество;
    ДокументОбъект.Цена           = Цена;
    ДокументОбъект.Сумма          = Количество * Цена;
    ДокументОбъект.НомерСделки    = НомерСделки;
    ДокументОбъект.УстановитьНовыйНомер();
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Проведен = Истина;
    ДокументОбъект.Записать();
    Возврат ДокументОбъект.Ссылка;

КонецФункции

Процедура ДобавитьНоги(Строки, Образец, Сделка, Портфель, Бумага, Количество, Цена)

    СуммаДенег = -Количество * Цена;
    Строки.Добавить(СтрокаИсполнения(Сделка, Портфель, Бумага, Образец, Количество, СуммаДенег));
    Строки.Добавить(СтрокаИсполнения(Сделка, Портфель, Образец.Рубль, Образец, СуммаДенег, СуммаДенег));

КонецПроцедуры

Процедура ЗаписатьНогиСделки(Образец, Сделка, Поручение, Строки, Период)

    НаборПлана = РегистрыНакопления.ПлановаяПозиция.СоздатьНаборЗаписей();
    НаборПлана.Отбор.Регистратор.Установить(Сделка);
    ДолгБумаги = 0;
    ДолгВалюты = 0;
    Для Каждого СтрокаДанных Из Строки Цикл
        Если СтрокаДанных.Сделка <> Сделка Тогда
            Продолжить;
        КонецЕсли;
        Движение = НаборПлана.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Период      = Период;
        Движение.Портфель    = СтрокаДанных.Портфель;
        Движение.Актив       = СтрокаДанных.Актив;
        Движение.Сделка      = Сделка;
        Движение.ТипПортфеля = Образец.ТипПортфеля;
        Движение.СчетУчета   = Образец.СчетУчета;
        Движение.Количество  = СтрокаДанных.Количество;
        Движение.Сумма       = СтрокаДанных.Сумма;
        Если СтрокаДанных.Актив = Образец.Рубль Тогда
            ДолгВалюты = ДолгВалюты + СтрокаДанных.Количество;
        Иначе
            ДолгБумаги = ДолгБумаги + СтрокаДанных.Количество;
        КонецЕсли;
    КонецЦикла;
    НаборПлана.ОбменДанными.Загрузка = Истина;
    НаборПлана.Записать();
    ЗаписатьПриходДолга("ЗадолженностьПоБумаге", Сделка, Поручение, Период, ДолгБумаги);
    ЗаписатьПриходДолга("ЗадолженностьПоВалюте", Сделка, Поручение, Период, ДолгВалюты);

КонецПроцедуры

Функция СтрокаИсполнения(Сделка, Портфель, Актив, Образец, Количество, Сумма)

    СтрокаДанных = Новый Структура;
    СтрокаДанных.Вставить("Сделка", Сделка);
    СтрокаДанных.Вставить("Портфель", Портфель);
    СтрокаДанных.Вставить("Актив", Актив);
    СтрокаДанных.Вставить("Количество", Количество);
    СтрокаДанных.Вставить("Сумма", Сумма);
    СтрокаДанных.Вставить("ТипПортфеля", Образец.ТипПортфеля);
    СтрокаДанных.Вставить("СчетУчета", Образец.СчетУчета);
    Возврат СтрокаДанных;

КонецФункции

Процедура ЗаписатьОстатокПоручения(ИмяРегистра, Поручение, Актив, Период, Количество, Сумма, Портфель, Образец)

    Набор = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Поручение);
    Движение = Набор.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.Период      = Период;
    Движение.Поручение   = Поручение;
    Движение.Актив       = Актив;
    Движение.Количество  = Количество;
    Если ИмяРегистра = "ПрогнозПоПоручению" Тогда
        Движение.Сумма       = Сумма;
        Движение.Портфель    = Портфель;
        Движение.ТипПортфеля = Образец.ТипПортфеля;
        Движение.СчетУчета   = Образец.СчетУчета;
    КонецЕсли;
    Набор.ОбменДанными.Загрузка = Истина;
    Набор.Записать();

КонецПроцедуры

Процедура ПровестиДокументыВетки(Строки, ДатаДокумента, ОтложитьПересчет)

    Для Каждого СтрокаДанных Из Строки Цикл
        ДокументОбъект = Документы.ИсполнениеПоСделке.СоздатьДокумент();
        ДокументОбъект.Дата = ДатаДокумента;
        ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаДанных);
        Если ОтложитьПересчет Тогда
            ДокументОбъект.ДополнительныеСвойства.Вставить("ОбновитьДанныеИсполнения", Ложь);
        КонецЕсли;
        ДокументОбъект.УстановитьНовыйНомер();
        ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
    КонецЦикла;

КонецПроцедуры

Функция СнятьИтог(Поручение, Сделки)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Поручение", Поручение);
    Запрос.УстановитьПараметр("Сделки", Сделки);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ЕСТЬNULL(Расш.Исполнение, 0) КАК Процент,
    |    ЕСТЬNULL(Расш.Объем, 0) КАК Объем,
    |    ПРЕДСТАВЛЕНИЕ(Статусы.Статус) КАК Статус,
    |    ПРЕДСТАВЛЕНИЕ(Статусы.СтатусРасш) КАК СтатусРасш
    |ИЗ
    |    Документ.Поручение КАК Поручения
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасширенияПоручений КАК Расш
    |        ПО Поручения.Ссылка = Расш.Поручение
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПоручений КАК Статусы
    |        ПО Поручения.Ссылка = Статусы.Поручение
    |ГДЕ
    |    Поручения.Ссылка = &Поручение
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Долг
    |ИЗ
    |    РегистрНакопления.ЗадолженностьПоБумаге.Остатки(, Поручение = &Поручение) КАК Остатки
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Долг
    |ИЗ
    |    РегистрНакопления.ЗадолженностьПоВалюте.Остатки(, Поручение = &Поручение) КАК Остатки
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    ЕСТЬNULL(СУММА(ВЫБОР КОГДА Остатки.КоличествоОстаток <> 0 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Строк,
    |    ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
    |ИЗ
    |    РегистрНакопления.ПлановаяПозиция.Остатки(, Сделка В (&Сделки)) КАК Остатки
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    КОЛИЧЕСТВО(*) КАК Документов
    |ИЗ
    |    Документ.ИсполнениеПоСделке КАК Исполнения
    |ГДЕ
    |    Исполнения.Сделка В (&Сделки)
    |    И Исполнения.Проведен
    |    И НЕ Исполнения.ПометкаУдаления";
    Результаты = Запрос.ВыполнитьПакет();
    Выборка = Результаты[0].Выбрать();
    Итог = Новый Структура;
    Если Выборка.Следующий() Тогда
        Итог.Вставить("Процент", ЕстьNullЧисло(Выборка.Процент));
        Итог.Вставить("Объем", ЕстьNullЧисло(Выборка.Объем));
        Итог.Вставить("Статус", Строка(Выборка.Статус));
        Итог.Вставить("СтатусРасш", Строка(Выборка.СтатусРасш));
    Иначе
        Итог.Вставить("Процент", 0);
        Итог.Вставить("Объем", 0);
        Итог.Вставить("Статус", "");
        Итог.Вставить("СтатусРасш", "");
    КонецЕсли;
    Итог.Вставить("ДолгБумаги", ЧислоПоляВыборки(Результаты[1], "Долг"));
    Итог.Вставить("ДолгВалюты", ЧислоПоляВыборки(Результаты[2], "Долг"));
    Итог.Вставить("ПланСтрок", ЧислоПоляВыборки(Результаты[3], "Строк"));
    Итог.Вставить("ПланКоличество", ЧислоПоляВыборки(Результаты[3], "Количество"));
    Итог.Вставить("Документов", ЧислоПоляВыборки(Результаты[4], "Документов"));
    Возврат Итог;

КонецФункции

Функция ТекстИтога(Итог)

    Возврат "документов " + Строка(Итог.Документов)
        + ", процент " + ЧислоТекстом(Итог.Процент)
        + ", объем " + ЧислоТекстом(Итог.Объем)
        + ", статус " + Итог.Статус + " / " + Итог.СтатусРасш
        + ", долг бумага " + ЧислоТекстом(Итог.ДолгБумаги)
        + ", долг валюта " + ЧислоТекстом(Итог.ДолгВалюты)
        + ", план строк " + Строка(Итог.ПланСтрок)
        + ", план количество " + ЧислоТекстом(Итог.ПланКоличество);

КонецФункции

Функция ТекстСравнения(Левый, Правый)

    Расхождения = Новый Массив;
    СравнитьПоле(Расхождения, "документов", Левый.Документов, Правый.Документов);
    СравнитьПоле(Расхождения, "процент", Левый.Процент, Правый.Процент);
    СравнитьПоле(Расхождения, "объем", Левый.Объем, Правый.Объем);
    СравнитьПоле(Расхождения, "статус", Левый.Статус, Правый.Статус);
    СравнитьПоле(Расхождения, "статус расч", Левый.СтатусРасш, Правый.СтатусРасш);
    СравнитьПоле(Расхождения, "долг бумага", Левый.ДолгБумаги, Правый.ДолгБумаги);
    СравнитьПоле(Расхождения, "долг валюта", Левый.ДолгВалюты, Правый.ДолгВалюты);
    СравнитьПоле(Расхождения, "план строк", Левый.ПланСтрок, Правый.ПланСтрок);
    СравнитьПоле(Расхождения, "план количество", Левый.ПланКоличество, Правый.ПланКоличество);
    Если Расхождения.Количество() = 0 Тогда
        Возврат "совпало";
    КонецЕсли;
    Возврат "РАСХОЖДЕНИЕ: " + СтрСоединить(Расхождения, "; ");

КонецФункции

Процедура СравнитьПоле(Расхождения, Имя, Левое, Правое)

    Если Левое <> Правое Тогда
        Расхождения.Добавить(Имя);
    КонецЕсли;

КонецПроцедуры

Функция ЧислоПоляВыборки(РезультатЗапроса, ИмяПоля)

    Выборка = РезультатЗапроса.Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат ЕстьNullЧисло(Выборка[ИмяПоля]);
    КонецЕсли;
    Возврат 0;

КонецФункции

Функция ЗначениеВМассиве(Значение)

    Массив = Новый Массив;
    Массив.Добавить(Значение);
    Возврат Массив;

КонецФункции

Процедура ЗаписатьАктивРепо(Образец, Поручение, Портфель, Бумага, НомерСделки, Момент)

    ДокументОбъект = Документы.СделкаРЕПО.СоздатьДокумент();
    ДокументОбъект.Дата = Момент;
    ДокументОбъект.Поручение = Поручение;
    ДокументОбъект.Актив = Бумага;
    ДокументОбъект.Портфель = Портфель;
    ДокументОбъект.НомерСделки = НомерСделки;
    ДокументОбъект.УстановитьНовыйНомер();
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Проведен = Истина;
    ДокументОбъект.Записать();

    Набор = РегистрыСведений.АктивыВРЕПО.СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
    Запись = Набор.Добавить();
    Запись.ДатаРасчетов = НачалоДня(ТекущаяДатаСеанса());
    Запись.Портфель = Портфель;
    Запись.Актив = Бумага;
    Запись.Сделка = ДокументОбъект.Ссылка;
    Запись.ТипПортфеля = Образец.ТипПортфеля;
    Запись.СчетУчета = Образец.СчетУчета;
    Запись.Количество = 1;
    Набор.ОбменДанными.Загрузка = Истина;
    Набор.Записать();

КонецПроцедуры

Процедура ПрогнатьПараллельныеСценарии(Параметры, Образец, Маркер, Момент, День, ДатаИсполнения, Лог, ПутьЛога)

    Добавить(Лог, ПутьЛога, "---- PARALLEL");
    Если Не Параметры.Свойство("ПутьОбработки") Или Не ЗначениеЗаполнено(Параметры.ПутьОбработки) Тогда
        Добавить(Лог, ПутьЛога, "ОШИБКА: не передан путь обработки, потоки не запущены");
        Возврат;
    КонецЕсли;

    Имена = Новый Массив;
    Имена.Добавить("REPO");
    Имена.Добавить("REPOA");
    Имена.Добавить("SUM");
    Имена.Добавить("SUM");
    Имена.Добавить("MULTI");
    Имена.Добавить("MULTI");

    Контроль = Новый Массив;
    Потоки = Новый Массив;
    ПорученияДо = Новый Массив;
    Для Индекс = 0 По Имена.ВГраница() Цикл
        Суффикс = Формат(Индекс, "ЧГ=0");
        ВеткаКонтроля = СоздатьВеткуСценария(Имена[Индекс], "PSEQ", Образец, Маркер, Момент, День, Суффикс);
        ВеткаПотока = СоздатьВеткуСценария(Имена[Индекс], "PPAR", Образец, Маркер, Момент, День, Суффикс);
        ЗаписатьИсходныйСтатус(ВеткаКонтроля.Поручение);
        ЗаписатьИсходныйСтатус(ВеткаПотока.Поручение);
        ПорученияДо.Добавить(ВеткаКонтроля.Поручение);
        ПорученияДо.Добавить(ВеткаПотока.Поручение);
        Контроль.Добавить(ВеткаКонтроля);
        Потоки.Добавить(ВеткаПотока);
    КонецЦикла;
    ОбновитьИтогово(ПорученияДо);

    Для Каждого Ветка Из Контроль Цикл
        ПровестиДокументыВетки(Ветка.Строки, ДатаИсполнения, Ложь);
    КонецЦикла;

    СтрокиПотоков = Новый Массив;
    ПорученияСделок = Новый Соответствие;
    ПорученияПотоков = Новый Массив;
    Для Каждого Ветка Из Потоки Цикл
        ПорученияПотоков.Добавить(Ветка.Поручение);
        Для Каждого СтрокаДанных Из Ветка.Строки Цикл
            СтрокиПотоков.Добавить(СтрокаДанных);
        КонецЦикла;
        Для Каждого Сделка Из Ветка.Сделки Цикл
            ПорученияСделок.Вставить(Сделка, Ветка.Поручение);
        КонецЦикла;
    КонецЦикла;

    ПараметрыПотоков = Новый Структура;
    ПараметрыПотоков.Вставить("Вариант", "D");
    ПараметрыПотоков.Вставить("Потоков", 6);
    ПараметрыПотоков.Вставить("ПутьОбработки", Параметры.ПутьОбработки);
    Результаты = ПровестиВПотоках(СтрокиПотоков, ПорученияСделок, ДатаИсполнения, ПараметрыПотоков, Лог, ПутьЛога);
    ИтогиПотоков(Результаты, Лог, ПутьЛога);
    ОбновитьИтогово(ПорученияПотоков);

    Для Индекс = 0 По Имена.ВГраница() Цикл
        ИтогКонтроля = СнятьИтог(Контроль[Индекс].Поручение, Контроль[Индекс].Сделки);
        ИтогПотока = СнятьИтог(Потоки[Индекс].Поручение, Потоки[Индекс].Сделки);
        Добавить(Лог, ПутьЛога, Имена[Индекс] + " " + Формат(Индекс, "ЧГ=0")
            + " контроль: " + ТекстИтога(ИтогКонтроля));
        Добавить(Лог, ПутьЛога, Имена[Индекс] + " " + Формат(Индекс, "ЧГ=0")
            + " потоки:   " + ТекстИтога(ИтогПотока));
        Добавить(Лог, ПутьЛога, "Сравнение " + Имена[Индекс] + " " + Формат(Индекс, "ЧГ=0") + ": "
            + ТекстСравнения(ИтогКонтроля, ИтогПотока));
    КонецЦикла;

КонецПроцедуры

Процедура УдалитьДанныеМаркера(Маркер, Лог, ПутьЛога)

    Исполнения = ИсполненияМаркера(Маркер);
    Для Каждого Ссылка Из Исполнения Цикл
        ОчиститьДвиженияИсполнения(Ссылка);
        УдалитьДокумент(Ссылка);
    КонецЦикла;
    Сделки = СделкиТеста(Маркер);
    Для Каждого Ссылка Из Сделки Цикл
        ОчиститьНаборНакопления("ПлановаяПозиция", Ссылка);
        ОчиститьНаборНакопления("ЗадолженностьПоБумаге", Ссылка);
        ОчиститьНаборНакопления("ЗадолженностьПоВалюте", Ссылка);
        УдалитьДокумент(Ссылка);
    КонецЦикла;
    СделкиРепо = СделкиРепоМаркера(Маркер);
    Для Каждого Ссылка Из СделкиРепо Цикл
        ОчиститьНаборРегистраСведений("АктивыВРЕПО", Ссылка);
        УдалитьДокумент(Ссылка);
    КонецЦикла;
    Поручения = ПорученияПоКомментарию(Маркер);
    Для Каждого Ссылка Из Поручения Цикл
        ОчиститьНаборНакопления("ПрогнозПоПоручению", Ссылка);
        ОчиститьНаборНакопления("ПланПоПоручению", Ссылка);
        ОчиститьНезависимыйРегистр("СтатусыПоручений", Ссылка);
        ОчиститьНезависимыйРегистр("РасширенияПоручений", Ссылка);
        УдалитьДокумент(Ссылка);
    КонецЦикла;
    Добавить(Лог, ПутьЛога, "Удалено исполнений " + Строка(Исполнения.Количество())
        + ", сделок " + Строка(Сделки.Количество()) + ", сделок РЕПО " + Строка(СделкиРепо.Количество())
        + ", поручений " + Строка(Поручения.Количество()));

КонецПроцедуры

Функция ИсполненияМаркера(Маркер)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Маска", Маркер + "-%");
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Исполнения.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.ИсполнениеПоСделке КАК Исполнения
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделки
    |        ПО Исполнения.Сделка = Сделки.Ссылка
    |ГДЕ
    |    Сделки.НомерСделки ПОДОБНО &Маска";
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

