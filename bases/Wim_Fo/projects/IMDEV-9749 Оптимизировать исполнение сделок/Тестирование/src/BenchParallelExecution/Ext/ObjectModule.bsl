#Область Служебные

Функция ФлагОбмена()

    Попытка
        Возврат ПолныеПрава.ИспользоватьМетодАpi_GetListOfDeals();
    Исключение
        Возврат Неопределено;
    КонецПопытки;

КонецФункции

Функция ПредставлениеФлага(Значение)

    Если Значение = Неопределено Тогда
        Возврат "не прочитан";
    ИначеЕсли Значение Тогда
        Возврат "включен";
    КонецЕсли;
    Возврат "выключен";

КонецФункции

Функция ЧислоТекстом(Значение)
    Возврат Формат(Значение, "ЧДЦ=4; ЧРД=.; ЧГ=0; ЧН=0");
КонецФункции

Функция ЕстьNullЧисло(Значение)

    Если Значение = Null Тогда
        Возврат 0;
    КонецЕсли;
    Возврат Значение;

КонецФункции

Функция ОстатокОтДеления(Значение, Делитель)
    Возврат Значение - Цел(Значение / Делитель) * Делитель;
КонецФункции

Функция Сумма(Значения)

    Итог = 0;
    Для Каждого Значение Из Значения Цикл
        Итог = Итог + Значение;
    КонецЦикла;
    Возврат Итог;

КонецФункции

Функция Максимум(Значения)

    Итог = 0;
    Для Каждого Значение Из Значения Цикл
        Итог = Макс(Итог, Значение);
    КонецЦикла;
    Возврат Итог;

КонецФункции

Функция Медиана(Значения)

    Если Значения.Количество() = 0 Тогда
        Возврат 0;
    КонецЕсли;
    Список = Новый СписокЗначений;
    Список.ЗагрузитьЗначения(Значения);
    Список.СортироватьПоЗначению();
    Возврат Список[Цел(Список.Количество() / 2)].Значение;

КонецФункции

Функция СекундыТекста(Секунды)
    Возврат Формат(Секунды, "ЧДЦ=1; ЧРД=.; ЧГ=0; ЧН=0") + " с";
КонецФункции

Функция МиллисекундыТекста(Миллисекунды)
    Возврат Формат(Миллисекунды, "ЧДЦ=0; ЧРД=.; ЧГ=0; ЧН=0") + " мс";
КонецФункции

Процедура Завершить(Лог, ПутьЛога, АдресХранилища)

    Добавить(Лог, ПутьЛога, "Конец " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Если ЗначениеЗаполнено(АдресХранилища) Тогда
        ПоместитьВоВременноеХранилище(СтрСоединить(Лог, Символы.ПС), АдресХранилища);
    КонецЕсли;

КонецПроцедуры

Процедура Добавить(Лог, ПутьЛога, Текст)

    Лог.Добавить(Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss") + " " + Текст);
    Если ЗначениеЗаполнено(ПутьЛога) Тогда
        ЗаписатьФайл(ПутьЛога, СтрСоединить(Лог, Символы.ПС));
    КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьФайл(Путь, Текст)

    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
    Запись.Записать(Текст);
    Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
