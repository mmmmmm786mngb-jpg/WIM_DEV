КонецФункции

Процедура ПроверитьПоследовательность(Лог, ПутьЛога)

    Маркер = "TSEQ";
    УдалитьТестовые(Лог, ПутьЛога, Маркер);
    Образец = ОбразецПоручения();
    ИмяДолга = ИмяРегистраДолга(Образец.Актив);
    Добавить(Лог, ПутьЛога, "Долг пишется в " + ИмяДолга);
    День = Дата(2099, 3, 16);
    Момент = Дата(2099, 3, 16, 12, 0, 0);
    НаДату = Дата(2099, 3, 16, 23, 55, 0);
    ЧислоПоручений = 3;
    СделокНаПоручение = 4;
    КоличествоШтуки = 10;

    Поручения = Новый Массив;
    ПакетыСделок = Новый Массив;
    Для НомерПоручения = 0 По ЧислоПоручений - 1 Цикл
        Поручение = СоздатьПоручение(Образец, Момент, НомерПоручения, Маркер);
        СделкиПоручения = Новый Массив;
        ПерваяСделка = Неопределено;
        Для НомерСделки = 0 По СделокНаПоручение - 1 Цикл
            Индекс = НомерПоручения * 10 + НомерСделки;
            Сделка = СоздатьСделку(Образец, День, Индекс, Маркер, Поручение);
            ЗаписатьПриходПлановойПозиции(Образец, Момент, Сделка);
            Если ПерваяСделка = Неопределено Тогда
                ПерваяСделка = Сделка;
            КонецЕсли;
            СделкиПоручения.Добавить(Сделка);
        КонецЦикла;
        ЗаписатьПриходДолга(ИмяДолга, ПерваяСделка, Поручение, Момент, КоличествоШтуки * СделокНаПоручение);
        Поручения.Добавить(Поручение);
        ПакетыСделок.Добавить(СделкиПоручения);
    КонецЦикла;

    Добавить(Лог, ПутьЛога, "--- Поштучно, пересчет на каждом проведении");
    СброситьПроведение(Поручения, Маркер);
    ФиналПоштучно = Новый Соответствие;
    ПроцентМенялся = 0;
    СтатусМенялся = 0;
    Для ИндексПоручения = 0 По Поручения.ВГраница() Цикл
        ПредыдущийПроцент = "";
        ПредыдущийСтатус = "";
        СделкиПоручения = ПакетыСделок[ИндексПоручения];
        Для ИндексСделки = 0 По СделкиПоручения.ВГраница() Цикл
            ПровестиИсполнение(Образец, СделкиПоручения[ИндексСделки], НаДату, КоличествоШтуки, Истина);
            Снимок = СнимокПоручения(Поручения[ИндексПоручения]);
            Добавить(Лог, ПутьЛога, "Поручение " + Строка(ИндексПоручения) + " после сделки "
                + Строка(ИндексСделки) + ": долг="
                + Формат(ОстатокДолга(Поручения[ИндексПоручения], ИмяДолга), "ЧГ=0")
                + "; " + Снимок);
            Если ИндексСделки > 0 И ПредыдущийПроцент <> ПроцентИзСнимка(Снимок) Тогда
                ПроцентМенялся = ПроцентМенялся + 1;
            КонецЕсли;
            Если ИндексСделки > 0 И ПредыдущийСтатус <> СтатусИзСнимка(Снимок) Тогда
                СтатусМенялся = СтатусМенялся + 1;
            КонецЕсли;
            ПредыдущийПроцент = ПроцентИзСнимка(Снимок);
            ПредыдущийСтатус = СтатусИзСнимка(Снимок);
        КонецЦикла;
        ФиналПоштучно.Вставить(Поручения[ИндексПоручения], СнимокПоручения(Поручения[ИндексПоручения]));
    КонецЦикла;
    Добавить(Лог, ПутьЛога, "Смен процента между сделками одного поручения: " + Строка(ПроцентМенялся));
    Добавить(Лог, ПутьЛога, "Смен статуса между сделками одного поручения: " + Строка(СтатусМенялся));

    Добавить(Лог, ПутьЛога, "--- Пересчет один раз до проведений");
    СброситьПроведение(Поручения, Маркер);
    РегистрыСведений.РасширенияПоручений.ОбновитьДанныеИсполнения(Поручения);
    ДоПроведения = Снимки(Поручения);
    Для ИндексПоручения = 0 По Поручения.ВГраница() Цикл
        ПровестиИсполнение(Образец, ПакетыСделок[ИндексПоручения][0], НаДату, КоличествоШтуки, Ложь);
        ПровестиИсполнение(Образец, ПакетыСделок[ИндексПоручения][1], НаДату, КоличествоШтуки, Ложь);
        ПровестиИсполнение(Образец, ПакетыСделок[ИндексПоручения][2], НаДату, КоличествоШтуки, Ложь);
        ПровестиИсполнение(Образец, ПакетыСделок[ИндексПоручения][3], НаДату, КоличествоШтуки, Ложь);
    КонецЦикла;
    ПослеРаннегоПересчета = Снимки(Поручения);
    РасхожденияРанние = СравнитьСнимки(Лог, ПутьЛога, "До проведений против финала поштучно", ДоПроведения, ФиналПоштучно);
    РасхожденияРанниеПосле = СравнитьСнимки(Лог, ПутьЛога, "После проведений без повторного пересчета против финала поштучно", ПослеРаннегоПересчета, ФиналПоштучно);

    Добавить(Лог, ПутьЛога, "--- Пересчет один раз после всех проведений");
    СброситьПроведение(Поручения, Маркер);
    Для ИндексПоручения = 0 По Поручения.ВГраница() Цикл
        Для ИндексСделки = 0 По ПакетыСделок[ИндексПоручения].ВГраница() Цикл
            ПровестиИсполнение(Образец, ПакетыСделок[ИндексПоручения][ИндексСделки], НаДату, КоличествоШтуки, Ложь);
        КонецЦикла;
    КонецЦикла;
    РегистрыСведений.РасширенияПоручений.ОбновитьДанныеИсполнения(Поручения);
    ФиналСписком = Снимки(Поручения);
    РасхожденияФинала = СравнитьСнимки(Лог, ПутьЛога, "Финал списком после проведений против финала поштучно", ФиналСписком, ФиналПоштучно);

    Если РасхожденияФинала = 0 И РасхожденияРанние > 0 Тогда
        Добавить(Лог, ПутьЛога, "Итог: одно чтение после всех проведений совпало с поштучным. Одно чтение до проведений не совпало.");
    ИначеЕсли РасхожденияФинала = 0 И РасхожденияРанние = 0 Тогда
        Добавить(Лог, ПутьЛога, "Итог: финал совпал и с чтением до проведений. Последовательное проведение этот срез не меняло.");
    Иначе
        Добавить(Лог, ПутьЛога, "Итог: финал списком после проведений НЕ совпал с поштучным.");
    КонецЕсли;
    Добавить(Лог, ПутьЛога, "Расхождений раннего пересчета после документов без повторного пересчета: " + Строка(РасхожденияРанниеПосле));

КонецПроцедуры

Процедура СброситьПроведение(Поручения, Маркер)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Маска", Маркер + "%");
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Исполнения.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.ИсполнениеПоСделке КАК Исполнения
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделки
    |        ПО Исполнения.Сделка = Сделки.Ссылка
    |ГДЕ
    |    Сделки.НомерСделки ПОДОБНО &Маска";
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ОчиститьДвиженияИсполнения(Выборка.Ссылка);
        УдалитьДокумент(Выборка.Ссылка);
    КонецЦикла;
    Для Каждого Поручение Из Поручения Цикл
        ОчиститьНезависимыйРегистр("РасширенияПоручений", Поручение);
        ЗаписатьИсходныйСтатус(Поручение);
    КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьИсходныйСтатус(Поручение)

    Набор = РегистрыСведений.СтатусыПоручений.СоздатьНаборЗаписей();
    Набор.Отбор.Поручение.Установить(Поручение);
    Запись = Набор.Добавить();
    Запись.Поручение = Поручение;
    Запись.Исполнена = Истина;
    Запись.СтатусРасш = Перечисления.СтатусыПорученийБлоттер.Work;
    Набор.Записать();

КонецПроцедуры

Процедура ЗаписатьПриходДолга(ИмяРегистра, Регистратор, Поручение, Период, Количество)

    Набор = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Регистратор);
    Движение = Набор.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.Период = Период;
    Движение.Поручение = Поручение;
    Движение.Количество = Количество;
    Набор.Записать();

КонецПроцедуры

Процедура ПровестиИсполнение(Образец, Сделка, НаДату, Количество, Пересчитывать)

    ДокументОбъект = Документы.ИсполнениеПоСделке.СоздатьДокумент();
    ДокументОбъект.Дата = НаДату;
    ДокументОбъект.Портфель = Образец.Портфель;
    ДокументОбъект.Актив = Образец.Актив;
    ДокументОбъект.Сделка = Сделка;
    ДокументОбъект.СчетУчета = Образец.СчетУчета;
    ДокументОбъект.ТипПортфеля = Образец.ТипПортфеля;
    ДокументОбъект.Количество = Количество;
    Если Не Пересчитывать Тогда
        ДокументОбъект.ДополнительныеСвойства.Вставить("ОбновитьДанныеИсполнения", Ложь);
    КонецЕсли;
    ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

Функция ИмяРегистраДолга(Актив)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Актив", Актив);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Активы.ВидАктива = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыАктивов.Валюты) КАК ЭтоВалюта
    |ИЗ
    |    Справочник.Активы КАК Активы
    |ГДЕ
    |    Активы.Ссылка = &Актив";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Если Выборка.ЭтоВалюта Тогда
        Возврат "ЗадолженностьПоВалюте";
    КонецЕсли;
    Возврат "ЗадолженностьПоБумаге";

КонецФункции

Функция Снимки(Поручения)

    Результат = Новый Соответствие;
    Для Каждого Поручение Из Поручения Цикл
        Результат.Вставить(Поручение, СнимокПоручения(Поручение));
    КонецЦикла;
    Возврат Результат;

КонецФункции

Функция СнимокПоручения(Поручение)

    Статус = "";
    Исполнение = "";
    Объем = "";
    МенеджерСтатуса = РегистрыСведений.СтатусыПоручений.СоздатьМенеджерЗаписи();
    МенеджерСтатуса.Поручение = Поручение;
    МенеджерСтатуса.Прочитать();
    Если МенеджерСтатуса.Выбран() Тогда
        Статус = Строка(МенеджерСтатуса.СтатусРасш);
    КонецЕсли;
    МенеджерРасширения = РегистрыСведений.РасширенияПоручений.СоздатьМенеджерЗаписи();
    МенеджерРасширения.Поручение = Поручение;
    МенеджерРасширения.Прочитать();
    Если МенеджерРасширения.Выбран() Тогда
        Исполнение = Формат(МенеджерРасширения.Исполнение, "ЧДЦ=4; ЧРД=.; ЧГ=0");
        Объем = Формат(МенеджерРасширения.Объем, "ЧДЦ=2; ЧРД=.; ЧГ=0");
    КонецЕсли;
    Возврат "статус=" + Статус
        + "; исполнение=" + Исполнение
        + "; объем=" + Объем;

КонецФункции

Функция ОстатокДолга(Поручение, ИмяДолга)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Поручение", Поручение);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ЕСТЬNULL(СУММА(Ост.КоличествоОстаток), 0) КАК Количество
    |ИЗ
    |    РегистрНакопления." + ИмяДолга + ".Остатки(, Поручение = &Поручение) КАК Ост";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Количество;

КонецФункции

Функция ПроцентИзСнимка(Снимок)
    Возврат ЧастьСнимка(Снимок, "исполнение=");
КонецФункции

Функция СтатусИзСнимка(Снимок)
    Возврат ЧастьСнимка(Снимок, "статус=");
КонецФункции

Функция ЧастьСнимка(Снимок, Ключ)

    Позиция = СтрНайти(Снимок, Ключ);
    Если Позиция = 0 Тогда
        Возврат "";
    КонецЕсли;
    Хвост = Сред(Снимок, Позиция + СтрДлина(Ключ));
    Граница = СтрНайти(Хвост, ";");
    Если Граница = 0 Тогда
        Возврат Хвост;
    КонецЕсли;
    Возврат Лев(Хвост, Граница - 1);

КонецФункции

Функция СравнитьСнимки(Лог, ПутьЛога, Заголовок, Левые, Правые)

    Расхождения = 0;
    Для Каждого Элемент Из Правые Цикл
        Левое = Левые.Получить(Элемент.Ключ);
        Если Левое <> Элемент.Значение Тогда
            Расхождения = Расхождения + 1;
            Добавить(Лог, ПутьЛога, Заголовок + ": " + Строка(Левое) + " <> " + Строка(Элемент.Значение));
        КонецЕсли;
    КонецЦикла;
    Если Расхождения = 0 Тогда
        Добавить(Лог, ПутьЛога, Заголовок + ": совпало");
    Иначе
        Добавить(Лог, ПутьЛога, Заголовок + ": расхождений " + Строка(Расхождения));
    КонецЕсли;
    Возврат Расхождения;

КонецФункции

Процедура ПроверитьСменуПроцента(Лог, ПутьЛога)

    Маркер = "TPRC";
    УдалитьТестовые(Лог, ПутьЛога, Маркер);
    Добавить(Лог, ПутьЛога, "--- Процент и объем меняются между сделками одного поручения");
    Образец = ОбразецПоручения();
    ИмяДолга = ИмяРегистраДолга(Образец.Актив);
    День = Дата(2099, 3, 17);
    Момент = Дата(2099, 3, 17, 12, 0, 0);
    НаДату = Дата(2099, 3, 17, 23, 55, 0);
    Поручение = СоздатьПоручение(Образец, Момент, 0, Маркер);
    УстановитьКоличествоПоручения(Поручение, 40, 100);
    СделкиПоручения = Новый Массив;
    ПерваяСделка = Неопределено;
    Для НомерСделки = 0 По 3 Цикл
        Сделка = СоздатьСделку(Образец, День, НомерСделки, Маркер, Поручение);
        ЗаписатьПриходПлановойПозиции(Образец, Момент, Сделка);
        Если ПерваяСделка = Неопределено Тогда
            ПерваяСделка = Сделка;
        КонецЕсли;
        СделкиПоручения.Добавить(Сделка);
    КонецЦикла;
    ЗаписатьПриходДолга(ИмяДолга, ПерваяСделка, Поручение, Момент, 40);

    Прогнозы = Новый Массив;
    Прогнозы.Добавить(30);
    Прогнозы.Добавить(20);
    Прогнозы.Добавить(10);
    Прогнозы.Добавить(0);
    Цены = Новый Массив;
    Цены.Добавить(100);
    Цены.Добавить(110);
    Цены.Добавить(120);
    Цены.Добавить(130);

    Поручения = Новый Массив;
    Поручения.Добавить(Поручение);
    СброситьПроведение(Поручения, Маркер);
    Для ИндексСделки = 0 По 3 Цикл
        УстановитьПрогноз(Поручение, Образец, Момент, Прогнозы[ИндексСделки]);
        УстановитьКоличествоПоручения(Поручение, 40, Цены[ИндексСделки]);
        ПровестиИсполнение(Образец, СделкиПоручения[ИндексСделки], НаДату, 10, Истина);
        Добавить(Лог, ПутьЛога, "После сделки " + Строка(ИндексСделки) + ": " + СнимокПоручения(Поручение));
    КонецЦикла;
    ФиналПоштучно = СнимокПоручения(Поручение);

    СброситьПроведение(Поручения, Маркер);
    УстановитьПрогноз(Поручение, Образец, Момент, 0);
    УстановитьКоличествоПоручения(Поручение, 40, 130);
    Для ИндексСделки = 0 По 3 Цикл
        ПровестиИсполнение(Образец, СделкиПоручения[ИндексСделки], НаДату, 10, Ложь);
    КонецЦикла;
    РегистрыСведений.РасширенияПоручений.ОбновитьДанныеИсполнения(Поручения);
    ФиналСписком = СнимокПоручения(Поручение);
    Добавить(Лог, ПутьЛога, "Финал поштучно: " + ФиналПоштучно);
    Добавить(Лог, ПутьЛога, "Финал списком после проведений: " + ФиналСписком);
    Если ФиналПоштучно = ФиналСписком Тогда
        Добавить(Лог, ПутьЛога, "Итог смены процента: финал совпал");
    Иначе
        Добавить(Лог, ПутьЛога, "Итог смены процента: финал НЕ совпал");
    КонецЕсли;

КонецПроцедуры

Процедура УстановитьКоличествоПоручения(Поручение, Количество, Цена)

    ДокументОбъект = Поручение.ПолучитьОбъект();
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Количество = Количество;
    ДокументОбъект.ЦенаВВалютеРасчетов = Цена;
    ДокументОбъект.СуммаПоручения = Количество * Цена;
    Если ДокументОбъект.РаспределениеПоПортфелям.Количество() > 0 Тогда
        ДокументОбъект.РаспределениеПоПортфелям[0].Количество = Количество;
    КонецЕсли;
    ДокументОбъект.Записать();

КонецПроцедуры

Процедура УстановитьПрогноз(Поручение, Образец, Период, Количество)

    Набор = РегистрыНакопления.ПрогнозПоПоручению.СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Поручение);
    Если Количество <> 0 Тогда
        Движение = Набор.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Период = Период;
        Движение.Портфель = Образец.Портфель;
        Движение.Актив = Образец.Актив;
        Движение.Поручение = Поручение;
        Движение.ТипПортфеля = Образец.ТипПортфеля;
        Движение.СчетУчета = Образец.СчетУчета;
        Движение.Количество = Количество;
        Движение.Сумма = Количество;
    КонецЕсли;
    Набор.Записать();

КонецПроцедуры

Процедура УдалитьТестовые(Лог, ПутьЛога, Маркер = "TREG")

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Маркер", Маркер);
    Запрос.УстановитьПараметр("Маска", Маркер + "%");
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Исполнения.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.ИсполнениеПоСделке КАК Исполнения
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделки
    |        ПО Исполнения.Сделка = Сделки.Ссылка
    |ГДЕ
    |    Сделки.НомерСделки ПОДОБНО &Маска
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    Сделки.Ссылка КАК Ссылка,
    |    Сделки.Поручение КАК Поручение
    |ИЗ
    |    Документ.Сделка КАК Сделки
    |ГДЕ
    |    Сделки.НомерСделки ПОДОБНО &Маска";
    Результаты = Запрос.ВыполнитьПакет();
    Исполнения = Результаты[0].Выгрузить();
    Сделки = Результаты[1].Выгрузить();
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Для Каждого Строка Из Исполнения Цикл
        ОчиститьДвиженияИсполнения(Строка.Ссылка);
        УдалитьДокумент(Строка.Ссылка);
    КонецЦикла;
    Для Каждого Строка Из Сделки Цикл
        ОчиститьНаборНакопления("ПлановаяПозиция", Строка.Ссылка);
        ОчиститьНаборНакопления("ЗадолженностьПоБумаге", Строка.Ссылка);
        ОчиститьНаборНакопления("ЗадолженностьПоВалюте", Строка.Ссылка);
        Если ЗначениеЗаполнено(Строка.Поручение) Тогда
            ОчиститьНезависимыйРегистр("РасширенияПоручений", Строка.Поручение);
            ОчиститьНезависимыйРегистр("СтатусыПоручений", Строка.Поручение);
            ОчиститьНаборНакопления("ПрогнозПоПоручению", Строка.Поручение);
            УдалитьДокумент(Строка.Поручение);
        КонецЕсли;
        УдалитьДокумент(Строка.Ссылка);
    КонецЦикла;
    Секунды = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
    Добавить(Лог, ПутьЛога, "Удалено исполнений " + Строка(Исполнения.Количество())
        + ", сделок " + Строка(Сделки.Количество()) + " за " + СекундыТекста(Секунды));

КонецПроцедуры

Процедура ОчиститьДвиженияИсполнения(Регистратор)

    ОчиститьНаборНакопления("ПлановаяПозиция", Регистратор);
    ОчиститьНаборНакопления("ЗадолженностьПоБумаге", Регистратор);
    ОчиститьНаборНакопления("ЗадолженностьПоВалюте", Регистратор);
    Набор = РегистрыСведений.СделкиДляОбмена.СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Регистратор);
    Набор.ОбменДанными.Загрузка = Истина;
    Набор.Записать();

КонецПроцедуры

Процедура ОчиститьНаборНакопления(ИмяРегистра, Регистратор)

    Набор = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Регистратор);
    Набор.ОбменДанными.Загрузка = Истина;
    Набор.Записать();

КонецПроцедуры

Процедура ОчиститьНезависимыйРегистр(ИмяРегистра, Поручение)

    Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
    Набор.Отбор.Поручение.Установить(Поручение);
    Набор.ОбменДанными.Загрузка = Истина;
    Набор.Записать();

КонецПроцедуры

Процедура УдалитьДокумент(Ссылка)

    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Объект.ОбменДанными.Загрузка = Истина;
    Объект.Удалить();

КонецПроцедуры

Функция ОстатокОтДеления(Значение, Делитель)
    Возврат Значение - Цел(Значение / Делитель) * Делитель;
КонецФункции

Функция Сумма(Значения)

    Итог = 0;
    Для Каждого Значение Из Значения Цикл
        Итог = Итог + Значение;
    КонецЦикла;
    Возврат Итог;

КонецФункции

Функция Медиана(Значения)

    Если Значения.Количество() = 0 Тогда
        Возврат 0;
    КонецЕсли;
    Копия = Новый Массив;
    Для Каждого Значение Из Значения Цикл
        Копия.Добавить(Значение);
    КонецЦикла;
    Для Левый = 0 По Копия.ВГраница() Цикл
        Для Правый = 0 По Копия.ВГраница() - 1 Цикл
            Если Копия[Правый] > Копия[Правый + 1] Тогда
                Буфер = Копия[Правый];
                Копия[Правый] = Копия[Правый + 1];
                Копия[Правый + 1] = Буфер;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Копия[Цел(Копия.Количество() / 2)];

КонецФункции

Функция СекундыТекста(Секунды)
    Возврат Формат(Секунды, "ЧДЦ=1; ЧРД=.; ЧГ=0") + " с";
КонецФункции

Функция МиллисекундыТекста(Миллисекунды)
    Возврат Формат(Миллисекунды, "ЧДЦ=0; ЧРД=.; ЧГ=0") + " мс";
КонецФункции

Процедура Добавить(Лог, ПутьЛога, Текст)

    Лог.Добавить(Текст);
    Если ЗначениеЗаполнено(ПутьЛога) Тогда
        ЗаписатьФайл(ПутьЛога, СтрСоединить(Лог, Символы.ПС));
    КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьФайл(Путь, Текст)

    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
    Запись.Записать(Текст);
    Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
