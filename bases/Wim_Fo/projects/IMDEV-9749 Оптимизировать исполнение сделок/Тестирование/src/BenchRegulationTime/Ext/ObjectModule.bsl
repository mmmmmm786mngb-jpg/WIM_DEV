#Область ПрограммныйИнтерфейс

// Описание: Готовит сделки с остатком плановой позиции, выполняет заполнение и проведение
// как регламент исполнения и пишет доли времени по шагам.
//
// Параметры:
//  Параметры - Структура - ПутьЛога, файл результата на сервере
//  АдресХранилища - Строка - адрес временного хранилища для того же текста
//
Процедура ВыполнитьТест(Параметры, АдресХранилища) Экспорт

    Лог = Новый Массив;
    ПутьЛога = "";
    Если Параметры.Свойство("ПутьЛога") Тогда
        ПутьЛога = Параметры.ПутьЛога;
    КонецЕсли;
    Добавить(Лог, ПутьЛога, "Старт " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Добавить(Лог, ПутьЛога, "Регламентное проведение ИсполнениеПоСделке. Чтения и записи вместе.");

    Попытка
        ПровестиРегламент(Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Попытка
        УдалитьТестовые(Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, "Удаление: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Текст = СтрСоединить(Лог, Символы.ПС);
    Если ЗначениеЗаполнено(АдресХранилища) Тогда
        ПоместитьВоВременноеХранилище(Текст, АдресХранилища);
    КонецЕсли;
    Если ЗначениеЗаполнено(ПутьЛога) Тогда
        ЗаписатьФайл(ПутьЛога, Текст);
    КонецЕсли;

КонецПроцедуры

// Описание: Проверяет, совпадает ли итог пересчета после всех проведений одного поручения
// с поштучным пересчетом и с пересчетом до проведений.
//
// Параметры:
//  Параметры - Структура - ПутьЛога, файл результата на сервере
//  АдресХранилища - Строка - адрес временного хранилища для того же текста
//
Процедура ВыполнитьРегрессПоследовательности(Параметры, АдресХранилища) Экспорт

    Лог = Новый Массив;
    ПутьЛога = "";
    Если Параметры.Свойство("ПутьЛога") Тогда
        ПутьЛога = Параметры.ПутьЛога;
    КонецЕсли;
    Добавить(Лог, ПутьЛога, "Старт " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Добавить(Лог, ПутьЛога, "Несколько сделок на одно поручение: поштучный пересчет, пересчет до проведений, пересчет после всех проведений.");

    Попытка
        ПроверитьПоследовательность(Лог, ПутьЛога);
        ПроверитьСменуПроцента(Лог, ПутьЛога);
    Исключение
        Добавить(Лог, ПутьЛога, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Попытка
        УдалитьТестовые(Лог, ПутьЛога, "TSEQ");
        УдалитьТестовые(Лог, ПутьЛога, "TPRC");
    Исключение
        Добавить(Лог, ПутьЛога, "Удаление: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Текст = СтрСоединить(Лог, Символы.ПС);
    Если ЗначениеЗаполнено(АдресХранилища) Тогда
        ПоместитьВоВременноеХранилище(Текст, АдресХранилища);
    КонецЕсли;
    Если ЗначениеЗаполнено(ПутьЛога) Тогда
        ЗаписатьФайл(ПутьЛога, Текст);
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПровестиРегламент(Лог, ПутьЛога)

    КоличествоДокументов = 200;
    Маркер = "TREG";
    УдалитьТестовые(Лог, ПутьЛога);

    Образец = ОбразецПоручения();
    ДеньПоставки = Дата(2099, 3, 15);
    МоментОстатка = Дата(2099, 3, 15, 12, 0, 0);
    НаДату = Дата(2099, 3, 15, 23, 55, 0);
    Добавить(Лог, ПутьЛога, "Дата поставки 2099-03-15, документов " + Строка(КоличествоДокументов));
    Добавить(Лог, ПутьЛога, "GetListOfDeals: " + ПредставлениеФлага(ФлагОбмена()));

    Поручения = Новый Массив;
    Сделки = Новый Массив;
    НачалоСоздания = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Для Индекс = 0 По КоличествоДокументов - 1 Цикл
        Поручение = СоздатьПоручение(Образец, МоментОстатка, Индекс, Маркер);
        Сделка = СоздатьСделку(Образец, ДеньПоставки, Индекс, Маркер, Поручение);
        ЗаписатьПриходПлановойПозиции(Образец, МоментОстатка, Сделка);
        Поручения.Добавить(Поручение);
        Сделки.Добавить(Сделка);
        Если ОстатокОтДеления(Индекс + 1, 50) = 0 Тогда
            Секунды = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСоздания) / 1000;
            Добавить(Лог, ПутьЛога, "Подготовлено " + Строка(Индекс + 1) + " за " + СекундыТекста(Секунды));
        КонецЕсли;
    КонецЦикла;

    ОстатокПробы = ОстатокПоСделке(Сделки[0], КонецДня(НаДату));
    Добавить(Лог, ПутьЛога, "Остаток плановой позиции по первой сделке: " + Строка(ОстатокПробы));
    Если ОстатокПробы = 0 Тогда
        ВызватьИсключение "Приход плановой позиции не виден в остатках, проведение регламента не запускалось";
    КонецЕсли;

    ЧтениеОстатка = МедианаЗамераЧтенияОстатка(Образец, Сделки[0]);
    Добавить(Лог, ПутьЛога, "Чтение остатка по ключу, медиана: " + МиллисекундыТекста(ЧтениеОстатка));

    Обработка = Обработки.ГрупповоеИсполнениеСделок.Создать();
    Обработка.НаДату = НаДату;
    НачалоЗаполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Обработка.ЗаполнитьТаблицуСделок();
    МиллисекундыЗаполнения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗаполнения;
    СтрокиРегламента = Обработка.Сделки.Количество();
    Добавить(Лог, ПутьЛога, "ЗаполнитьТаблицуСделок: " + МиллисекундыТекста(МиллисекундыЗаполнения)
        + ", строк " + Строка(СтрокиРегламента));
    Если СтрокиРегламента = 0 Тогда
        ВызватьИсключение "Регламент не отобрал ни одной строки";
    КонецЕсли;

    ВременаПолные = Новый Массив;
    ВременаБезПересчета = Новый Массив;
    ГраницаПолных = Цел(СтрокиРегламента / 2);
    Если ГраницаПолных < 1 Тогда
        ГраницаПолных = СтрокиРегламента;
    КонецЕсли;
    Ошибки = 0;
    Индекс = 0;
    Для Каждого СтрокаРегламента Из Обработка.Сделки Цикл
        ДокументОбъект = Документы.ИсполнениеПоСделке.СоздатьДокумент();
        ДокументОбъект.Дата = НаДату;
        ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаРегламента);
        ПолныйПересчет = Индекс < ГраницаПолных;
        Если Не ПолныйПересчет Тогда
            ДокументОбъект.ДополнительныеСвойства.Вставить("ОбновитьДанныеИсполнения", Ложь);
        КонецЕсли;
        НачалоПроведения = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Попытка
            ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
            Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроведения;
            Если ПолныйПересчет Тогда
                ВременаПолные.Добавить(Длительность);
            Иначе
                ВременаБезПересчета.Добавить(Длительность);
            КонецЕсли;
        Исключение
            Ошибки = Ошибки + 1;
            Добавить(Лог, ПутьЛога, "Ошибка проведения " + Строка(Индекс) + ": "
                + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
            Если Ошибки >= 3 Тогда
                ВызватьИсключение;
            КонецЕсли;
        КонецПопытки;
        Индекс = Индекс + 1;
        Если ОстатокОтДеления(Индекс, 20) = 0 Тогда
            Добавить(Лог, ПутьЛога, "Проведено " + Строка(Индекс) + " из " + Строка(СтрокиРегламента));
        КонецЕсли;
    КонецЦикла;

    Добавить(Лог, ПутьЛога, "Полный регламент, документов " + Строка(ВременаПолные.Количество())
        + ", медиана " + МиллисекундыТекста(Медиана(ВременаПолные))
        + ", сумма " + СекундыТекста(Сумма(ВременаПолные) / 1000));
    Добавить(Лог, ПутьЛога, "Без пересчета поручения, документов " + Строка(ВременаБезПересчета.Количество())
        + ", медиана " + МиллисекундыТекста(Медиана(ВременаБезПересчета))
        + ", сумма " + СекундыТекста(Сумма(ВременаБезПересчета) / 1000));
    СобратьДоли(Лог, ПутьЛога, МиллисекундыЗаполнения, ЧтениеОстатка, ВременаПолные, ВременаБезПересчета);

КонецПроцедуры

Процедура СобратьДоли(Лог, ПутьЛога, МиллисекундыЗаполнения, ЧтениеОстатка, ВременаПолные, ВременаБезПересчета)

    Если ВременаПолные.Количество() = 0 Тогда
        Добавить(Лог, ПутьЛога, "Нет успешных полных проведений");
        Возврат;
    КонецЕсли;

    МедианаПолная = Медиана(ВременаПолные);
    МедианаБезПересчета = Медиана(ВременаБезПересчета);
    Количество = ВременаПолные.Количество();
    СуммаПолных = Сумма(ВременаПолные);
    Если МедианаПолная > 0 И МедианаБезПересчета > 0 И МедианаБезПересчета < МедианаПолная Тогда
        ДоляБезПересчета = МедианаБезПересчета / МедианаПолная;
    Иначе
        ДоляБезПересчета = 1;
    КонецЕсли;
    МиллисекундыДвижений = СуммаПолных * ДоляБезПересчета;
    МиллисекундыПересчета = СуммаПолных - МиллисекундыДвижений;
    МиллисекундыЧтения = Мин(ЧтениеОстатка * Количество, МиллисекундыДвижений);
    МиллисекундыЗаписи = МиллисекундыДвижений - МиллисекундыЧтения;
    Итого = МиллисекундыЗаполнения + СуммаПолных;

    Добавить(Лог, ПутьЛога, "--- Доли регламента на " + Строка(Количество) + " документах с пересчетом");
    СтрокаДоли(Лог, ПутьЛога, "Заполнение таблицы сделок", МиллисекундыЗаполнения, Итого);
    СтрокаДоли(Лог, ПутьЛога, "Чтение остатка плановой позиции", МиллисекундыЧтения, Итого);
    СтрокаДоли(Лог, ПутьЛога, "Запись документа и движений", МиллисекундыЗаписи, Итого);
    СтрокаДоли(Лог, ПутьЛога, "Пересчет поручения внутри проведения", МиллисекундыПересчета, Итого);
    Добавить(Лог, ПутьЛога, "Итого регламент: " + СекундыТекста(Итого / 1000));
    Добавить(Лог, ПутьЛога, "На один документ с пересчетом, медиана: " + МиллисекундыТекста(МедианаПолная));

КонецПроцедуры

Процедура СтрокаДоли(Лог, ПутьЛога, Имя, Миллисекунды, Итого)

    Если Итого > 0 Тогда
        Процент = Окр(Миллисекунды / Итого * 100, 1);
    Иначе
        Процент = 0;
    КонецЕсли;
    Добавить(Лог, ПутьЛога, Имя + ": " + СекундыТекста(Миллисекунды / 1000)
        + " (" + Формат(Процент, "ЧДЦ=1; ЧРД=.; ЧГ=0") + "%)");

КонецПроцедуры

Функция МедианаЗамераЧтенияОстатка(Образец, Сделка)

    Замеры = Новый Массив;
    Для НомерЗамера = 1 По 5 Цикл
        Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
        ПрочитатьОстатокКлюча(Образец, Сделка);
        Замеры.Добавить(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
    КонецЦикла;
    Возврат Медиана(Замеры);

КонецФункции

Процедура ПрочитатьОстатокКлюча(Образец, Сделка)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Портфель", Образец.Портфель);
    Запрос.УстановитьПараметр("Актив", Образец.Актив);
    Запрос.УстановитьПараметр("Сделка", Сделка);
    Запрос.УстановитьПараметр("СчетУчета", Образец.СчетУчета);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Ост.Сделка КАК Сделка,
    |    Ост.КоличествоОстаток КАК КоличествоОстаток
    |ИЗ
    |    РегистрНакопления.ПлановаяПозиция.Остатки(
    |        ,
    |        Портфель = &Портфель
    |            И Актив = &Актив
    |            И Сделка = &Сделка
    |            И СчетУчета = &СчетУчета) КАК Ост";
    Запрос.Выполнить();

КонецПроцедуры

Функция ОстатокПоСделке(Сделка, ДатаОстатка)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Сделка", Сделка);
    Запрос.УстановитьПараметр("ДатаОстатка", ДатаОстатка);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ЕСТЬNULL(СУММА(Ост.КоличествоОстаток), 0) КАК Количество
    |ИЗ
    |    РегистрНакопления.ПлановаяПозиция.Остатки(&ДатаОстатка, Сделка = &Сделка) КАК Ост";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Количество;

КонецФункции

Функция СоздатьПоручение(Образец, ДатаДокумента, Индекс, Маркер)

    ДокументОбъект = Документы.Поручение.СоздатьДокумент();
    ДокументОбъект.Дата = ДатаДокумента;
    ДокументОбъект.Актив = Образец.Актив;
    ДокументОбъект.ВалютаРасчетов = Образец.ВалютаРасчетов;
    ДокументОбъект.ТипПортфеля = Образец.ТипПортфеля;
    ДокументОбъект.Портфель = Образец.Портфель;
    ДокументОбъект.СчетУчета = Образец.СчетУчета;
    ДокументОбъект.ВидОперации = Образец.ВидСделка;
    ДокументОбъект.Направление = Образец.Покупка;
    ДокументОбъект.Количество = 10;
    ДокументОбъект.СуммаПоручения = 1000;
    ДокументОбъект.ЗаполнениеПоСумме = Ложь;
    ДокументОбъект.ЦенаВВалютеРасчетов = 100;
    ДокументОбъект.Купон = 1;
    ДокументОбъект.КурсПересчетов = 1;
    ДокументОбъект.КомментарийКлиента = Маркер;
    Строка = ДокументОбъект.РаспределениеПоПортфелям.Добавить();
    Строка.Портфель = Образец.Портфель;
    Строка.ТипПортфеля = Образец.ТипПортфеля;
    Строка.Количество = 10;
    Строка.СчетУчета = Образец.СчетУчета;
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Проведен = Истина;
    ДокументОбъект.Записать();
    Возврат ДокументОбъект.Ссылка;

КонецФункции

Функция СоздатьСделку(Образец, ДеньПоставки, Индекс, Маркер, Поручение)

    ДокументОбъект = Документы.Сделка.СоздатьДокумент();
    ДокументОбъект.Дата = ДеньПоставки;
    ДокументОбъект.ДатаПоставки = ДеньПоставки;
    ДокументОбъект.Актив = Образец.Актив;
    ДокументОбъект.Поручение = Поручение;
    ДокументОбъект.ВидОперации = Образец.ВидСделка;
    ДокументОбъект.Внебиржевая = Ложь;
    ДокументОбъект.Количество = 10;
    ДокументОбъект.НомерСделки = Маркер + "-" + Формат(Индекс, "ЧЦ=4; ЧВН=; ЧГ=0");
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Записать();
    Возврат ДокументОбъект.Ссылка;

КонецФункции

Процедура ЗаписатьПриходПлановойПозиции(Образец, МоментОстатка, Сделка)

    Набор = РегистрыНакопления.ПлановаяПозиция.СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Сделка);
    Движение = Набор.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.Период = МоментОстатка;
    Движение.Портфель = Образец.Портфель;
    Движение.Актив = Образец.Актив;
    Движение.Сделка = Сделка;
    Движение.ТипПортфеля = Образец.ТипПортфеля;
    Движение.СчетУчета = Образец.СчетУчета;
    Движение.Количество = 10;
    Движение.Сумма = 1000;
    Набор.Записать();

КонецПроцедуры

Функция ОбразецПоручения()

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Поручения.Актив КАК Актив,
    |    Поручения.ВалютаРасчетов КАК ВалютаРасчетов
    |ИЗ
    |    Документ.Поручение КАК Поручения
    |ГДЕ
    |    Поручения.Актив <> ЗНАЧЕНИЕ(Справочник.Активы.ПустаяСсылка)
    |    И Поручения.ВалютаРасчетов <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "Нет поручения с активом и валютой";
    КонецЕсли;

    ЗапросПортфеля = Новый Запрос;
    ЗапросПортфеля.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Портфели.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.Портфели КАК Портфели
    |ГДЕ
    |    НЕ Портфели.ПометкаУдаления";
    ВыборкаПортфеля = ЗапросПортфеля.Выполнить().Выбрать();
    Если Не ВыборкаПортфеля.Следующий() Тогда
        ВызватьИсключение "Нет портфеля для остатка плановой позиции";
    КонецЕсли;

    ЗапросСчета = Новый Запрос;
    ЗапросСчета.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Счета.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.СчетаУчетаЕПС КАК Счета
    |ГДЕ
    |    НЕ Счета.ПометкаУдаления";
    ВыборкаСчета = ЗапросСчета.Выполнить().Выбрать();
    Если ВыборкаСчета.Следующий() Тогда
        СчетУчета = ВыборкаСчета.Ссылка;
    Иначе
        СчетУчета = Справочники.СчетаУчетаЕПС.ПустаяСсылка();
    КонецЕсли;

    Образец = Новый Структура;
    Образец.Вставить("Актив", Выборка.Актив);
    Образец.Вставить("ВалютаРасчетов", Выборка.ВалютаРасчетов);
    Образец.Вставить("Портфель", ВыборкаПортфеля.Ссылка);
    Образец.Вставить("СчетУчета", СчетУчета);
    Образец.Вставить("ТипПортфеля", Перечисления.ТипыПортфелей.АктивыДляПерепродажи);
    Образец.Вставить("ВидСделка", Перечисления.ВидыПоручений.Сделка);
    Образец.Вставить("Покупка", Перечисления.ВидыОперацийСделки.Покупка);
    Возврат Образец;

КонецФункции

