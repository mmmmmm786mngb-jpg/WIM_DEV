#Область ПрограммныйИнтерфейс

// Описание: Создает 1000 тестовых поручений и сделок, сравнивает поштучное и списочное
// чтение процента исполнения и удаляет тестовые документы.
//
// Параметры:
//  Параметры - Структура - ПутьЛога, строка, куда записать текст результата
//  АдресХранилища - Строка - адрес временного хранилища для того же текста
//
Процедура ВыполнитьТест(Параметры, АдресХранилища) Экспорт

    Лог = Новый Массив;
    Добавить(Лог, "Старт " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
    Добавить(Лог, "Чтение ОбновитьДанныеИсполнения: 1000 отдельных вызовов и один список. Проведение исполнения не выполняется.");

    Попытка
        СравнитьЧтение(Лог);
    Исключение
        Добавить(Лог, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Попытка
        УдалитьТестовые(Лог);
    Исключение
        Добавить(Лог, "Удаление: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Текст = СтрСоединить(Лог, Символы.ПС);
    Если ЗначениеЗаполнено(АдресХранилища) Тогда
        ПоместитьВоВременноеХранилище(Текст, АдресХранилища);
    КонецЕсли;
    Если Параметры.Свойство("ПутьЛога") И ЗначениеЗаполнено(Параметры.ПутьЛога) Тогда
        Запись = Новый ЗаписьТекста(Параметры.ПутьЛога, КодировкаТекста.UTF8);
        Запись.Записать(Текст);
        Запись.Закрыть();
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СравнитьЧтение(Лог)

    КоличествоДокументов = 1000;
    Маркер = "TEXEC1000";
    УдалитьТестовые(Лог);

    Образец = ОбразецПоручения();
    ДатаДокумента = Дата(2026, 10, 31, 12, 0, 0);
    Поручения = Новый Массив;
    ПрогнозВключен = Истина;
    ОстатковПрогноза = 0;
    НачалоСоздания = ТекущаяУниверсальнаяДатаВМиллисекундах();

    Для Индекс = 0 По КоличествоДокументов - 1 Цикл
        Ссылка = СоздатьПоручение(Образец, ДатаДокумента, Индекс, Маркер);
        СоздатьСделку(Образец, ДатаДокумента, Индекс, Маркер, Ссылка);
        Если Индекс >= 800 И Индекс < 950 И ПрогнозВключен Тогда
            Попытка
                ЗаписатьПрогноз(Ссылка, Образец, ДатаДокумента, 5);
                ОстатковПрогноза = ОстатковПрогноза + 1;
            Исключение
                ПрогнозВключен = Ложь;
                Добавить(Лог, "Остаток прогноза не записан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
            КонецПопытки;
        КонецЕсли;
        Поручения.Добавить(Ссылка);
        Если Индекс = 0 Или ОстатокОтДеления(Индекс + 1, 200) = 0 Тогда
            Секунды = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСоздания) / 1000;
            Добавить(Лог, "Создано " + Строка(Индекс + 1) + " за " + Формат(Секунды, "ЧДЦ=1; ЧРД=.; ЧГ=0") + " с");
        КонецЕсли;
    КонецЦикла;

    Добавить(Лог, "Проведенных среди тестовых: " + Строка(ЧислоПроведенных(Маркер)) + ", остатков прогноза " + Строка(ОстатковПрогноза));

    Добавить(Лог, "--- Поштучное чтение");
    ПрочитатьИсполнение(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Поручения[0]));
    Поштучно = Новый Соответствие;
    СуммаМиллисекунд = 0;
    НачалоПоштучно = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Для Индекс = 0 По Поручения.ВГраница() Цикл
        НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Таблица = ПрочитатьИсполнение(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Поручения[Индекс]));
        СуммаМиллисекунд = СуммаМиллисекунд + (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова);
        Для Каждого Строка Из Таблица Цикл
            Поштучно.Вставить(Строка.Поручение, ЗначенияСтроки(Строка));
        КонецЦикла;
        Если ОстатокОтДеления(Индекс + 1, 200) = 0 Тогда
            Добавить(Лог, "Прочитано по одному " + Строка(Индекс + 1) + ", сумма " + Формат(СуммаМиллисекунд / 1000, "ЧДЦ=1; ЧРД=.; ЧГ=0") + " с");
        КонецЕсли;
    КонецЦикла;
    СекундыПоштучно = (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПоштучно) / 1000;
    Добавить(Лог, "1000 отдельных вызовов: " + Формат(СекундыПоштучно, "ЧДЦ=1; ЧРД=.; ЧГ=0") + " с");

    Добавить(Лог, "--- Один вызов на все поручения");
    ПрочитатьИсполнение(Поручения);
    ЗамерыСписка = Новый Массив;
    ТаблицаСписка = Неопределено;
    Для НомерЗамера = 1 По 3 Цикл
        НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
        ТаблицаСписка = ПрочитатьИсполнение(Поручения);
        ЗамерыСписка.Добавить(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова);
    КонецЦикла;
    МедианаСписка = Медиана(ЗамерыСписка);
    Добавить(Лог, "Список из 1000: медиана " + Формат(МедианаСписка, "ЧДЦ=1; ЧРД=.; ЧГ=0") + " мс, замеры "
        + Формат(ЗамерыСписка[0], "ЧГ=0") + ", " + Формат(ЗамерыСписка[1], "ЧГ=0") + ", " + Формат(ЗамерыСписка[2], "ЧГ=0"));
    Если МедианаСписка > 0 Тогда
        Добавить(Лог, "Ускорение чтения: " + Формат(СекундыПоштучно * 1000 / МедианаСписка, "ЧДЦ=0; ЧГ=0")
            + " раз (" + Формат(СекундыПоштучно, "ЧДЦ=1; ЧРД=.; ЧГ=0") + " с против "
            + Формат(МедианаСписка, "ЧДЦ=1; ЧРД=.; ЧГ=0") + " мс)");
    КонецЕсли;

    Списком = Новый Соответствие;
    Для Каждого Строка Из ТаблицаСписка Цикл
        Списком.Вставить(Строка.Поручение, ЗначенияСтроки(Строка));
    КонецЦикла;
    СравнитьКарты(Лог, Поштучно, Списком, КоличествоДокументов);

КонецПроцедуры

Функция СоздатьПоручение(Образец, ДатаДокумента, Индекс, Маркер)

    ПрофильДокумента = Профиль(Индекс);
    ДокументОбъект = Документы.Поручение.СоздатьДокумент();
    ДокументОбъект.Дата = ДатаДокумента;
    ДокументОбъект.Актив = Образец.Актив;
    ДокументОбъект.ВалютаРасчетов = Образец.ВалютаРасчетов;
    ДокументОбъект.ТипПортфеля = Образец.ТипПортфеля;
    ДокументОбъект.Портфель = Образец.Портфель;
    ДокументОбъект.СчетУчета = Образец.СчетУчета;
    Если ПрофильДокумента.Вид = "repo" Тогда
        ДокументОбъект.ВидОперации = Образец.ВидРепо;
    Иначе
        ДокументОбъект.ВидОперации = Образец.ВидСделка;
    КонецЕсли;
    Если ПрофильДокумента.Вид = "sell" Тогда
        ДокументОбъект.Направление = Образец.Продажа;
    Иначе
        ДокументОбъект.Направление = Образец.Покупка;
    КонецЕсли;
    ДокументОбъект.Количество = ПрофильДокумента.Количество;
    Если ПрофильДокумента.ПоСумме Тогда
        ДокументОбъект.СуммаПоручения = 1000 + Индекс;
    Иначе
        ДокументОбъект.СуммаПоручения = ПрофильДокумента.Количество * ПрофильДокумента.Цена;
    КонецЕсли;
    ДокументОбъект.ЗаполнениеПоСумме = ПрофильДокумента.ПоСумме;
    ДокументОбъект.ЦенаВВалютеРасчетов = ПрофильДокумента.Цена;
    ДокументОбъект.Купон = 1;
    ДокументОбъект.КурсПересчетов = 1;
    ДокументОбъект.КомментарийКлиента = Маркер;
    Строка = ДокументОбъект.РаспределениеПоПортфелям.Добавить();
    Строка.Портфель = Образец.Портфель;
    Строка.ТипПортфеля = Образец.ТипПортфеля;
    Строка.Количество = ПрофильДокумента.Количество;
    Строка.СчетУчета = Образец.СчетУчета;
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Проведен = ПрофильДокумента.Проводить;
    ДокументОбъект.Записать();
    Возврат ДокументОбъект.Ссылка;

КонецФункции

Процедура СоздатьСделку(Образец, ДатаДокумента, Индекс, Маркер, Поручение)

    ДокументОбъект = Документы.Сделка.СоздатьДокумент();
    ДокументОбъект.Дата = ДатаДокумента;
    ДокументОбъект.ДатаПоставки = ДатаДокумента;
    ДокументОбъект.Актив = Образец.Актив;
    ДокументОбъект.Поручение = Поручение;
    ДокументОбъект.ВидОперации = Образец.ВидСделка;
    ДокументОбъект.Внебиржевая = Ложь;
    ДокументОбъект.Количество = 10;
    ДокументОбъект.НомерСделки = Маркер + "-" + Формат(Индекс, "ЧЦ=4; ЧВН=; ЧГ=0");
    ДокументОбъект.ОбменДанными.Загрузка = Истина;
    ДокументОбъект.Записать();

КонецПроцедуры

Процедура ЗаписатьПрогноз(Поручение, Образец, ДатаДокумента, Количество)

    Набор = РегистрыНакопления.ПрогнозПоПоручению.СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Поручение);
    Движение = Набор.Добавить();
    Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
    Движение.Период = ДатаДокумента;
    Движение.Портфель = Образец.Портфель;
    Движение.Актив = Образец.Актив;
    Движение.Поручение = Поручение;
    Движение.ТипПортфеля = Образец.ТипПортфеля;
    Движение.СчетУчета = Образец.СчетУчета;
    Движение.Количество = Количество;
    Движение.Сумма = Количество;
    Набор.Записать();

КонецПроцедуры

Функция Профиль(Индекс)

    Результат = Новый Структура;
    Если Индекс < 100 Тогда
        Результат.Вставить("Вид", "draft");
        Результат.Вставить("Количество", 10 + ОстатокОтДеления(Индекс, 7));
        Результат.Вставить("Цена", 0);
        Результат.Вставить("ПоСумме", Ложь);
        Результат.Вставить("Проводить", Ложь);
    ИначеЕсли Индекс < 800 Тогда
        Результат.Вставить("Вид", "buy");
        Результат.Вставить("Количество", 10 + ОстатокОтДеления(Индекс, 50));
        Результат.Вставить("Цена", 100 + ОстатокОтДеления(Индекс, 17));
        Результат.Вставить("ПоСумме", Ложь);
        Результат.Вставить("Проводить", Истина);
    ИначеЕсли Индекс < 950 Тогда
        Результат.Вставить("Вид", "sell");
        Результат.Вставить("Количество", 20 + ОстатокОтДеления(Индекс, 10));
        Результат.Вставить("Цена", 50 + ОстатокОтДеления(Индекс, 9));
        Результат.Вставить("ПоСумме", Ложь);
        Результат.Вставить("Проводить", Истина);
    Иначе
        Результат.Вставить("Вид", "repo");
        Результат.Вставить("Количество", 5 + ОстатокОтДеления(Индекс, 4));
        Результат.Вставить("Цена", 0);
        Результат.Вставить("ПоСумме", Истина);
        Результат.Вставить("Проводить", Истина);
    КонецЕсли;
    Возврат Результат;

КонецФункции

Функция ОбразецПоручения()

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Поручения.Актив КАК Актив,
    |    Поручения.ВалютаРасчетов КАК ВалютаРасчетов,
    |    Поручения.Портфель КАК Портфель,
    |    Поручения.СчетУчета КАК СчетУчета
    |ИЗ
    |    Документ.Поручение КАК Поручения
    |ГДЕ
    |    Поручения.Актив <> ЗНАЧЕНИЕ(Справочник.Активы.ПустаяСсылка)
    |    И Поручения.ВалютаРасчетов <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)";
    Выборка = Запрос.Выполнить().Выбрать();
    Если Не Выборка.Следующий() Тогда
        ВызватьИсключение "Нет поручения-образца";
    КонецЕсли;
    Образец = Новый Структура;
    Образец.Вставить("Актив", Выборка.Актив);
    Образец.Вставить("ВалютаРасчетов", Выборка.ВалютаРасчетов);
    Образец.Вставить("Портфель", Выборка.Портфель);
    Образец.Вставить("СчетУчета", Выборка.СчетУчета);
    Образец.Вставить("ТипПортфеля", Перечисления.ТипыПортфелей.АктивыДляПерепродажи);
    Образец.Вставить("ВидСделка", Перечисления.ВидыПоручений.Сделка);
    Образец.Вставить("ВидРепо", Перечисления.ВидыПоручений.РЕПО);
    Образец.Вставить("Покупка", Перечисления.ВидыОперацийСделки.Покупка);
    Образец.Вставить("Продажа", Перечисления.ВидыОперацийСделки.Продажа);
    Возврат Образец;

КонецФункции

Функция ПрочитатьИсполнение(Поручения)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Поручения", Поручения);
    Запрос.УстановитьПараметр("ПорученияОтменяемые", Новый Массив);
    Запрос.Текст = ТекстЧтенияИсполнения();
    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ТекстЧтенияИсполнения()

    Возврат
    "ВЫБРАТЬ
    |    Т.Ссылка КАК Поручение,
    |    Т.ВидОперации КАК ВидОперации,
    |    Т.Актив КАК Актив,
    |    ВЫБОР
    |        КОГДА Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.ВалютныйРынок)
    |            ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(Т.Актив КАК Справочник.Активы).Объект КАК Справочник.ВалютныеПары).БазоваяВалюта
    |        ИНАЧЕ НЕОПРЕДЕЛЕНО
    |    КОНЕЦ КАК БазовыйАктив,
    |    Т.Проведен
    |        И НЕ Т.Ссылка В (&ПорученияОтменяемые) КАК Проведен,
    |    Т.ЗаполнениеПоСумме КАК ЗаполнениеПоСумме,
    |    Т.СуммаПоручения КАК СуммаПоручения,
    |    Т.Количество КАК Количество,
    |    ВЫБОР
    |        КОГДА Т.Направление = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделки.Продажа)
    |            ТОГДА -1
    |        ИНАЧЕ 1
    |    КОНЕЦ КАК Множитель
    |ПОМЕСТИТЬ ВТ_Вх
    |ИЗ
    |    Документ.Поручение КАК Т
    |ГДЕ
    |    Т.Ссылка В (&Поручения)
    |    И Т.ПометкаУдаления = ЛОЖЬ
    |ИНДЕКСИРОВАТЬ ПО
    |    Поручение,
    |    Актив
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    Т.Поручение КАК Поручение,
    |    Т.ВидОперации КАК ВидОперации,
    |    Т.ЗаполнениеПоСумме КАК ЗаполнениеПоСумме,
    |    0 КАК Исполнение
    |ПОМЕСТИТЬ ВТ_Исп
    |ИЗ
    |    ВТ_Вх КАК Т
    |ГДЕ
    |    НЕ Т.Проведен
    |
    |ОБЪЕДИНИТЬ
    |
    |ВЫБРАТЬ
    |    Т.Поручение,
    |    Т.ВидОперации,
    |    Т.ЗаполнениеПоСумме,
    |    ВЫБОР
    |        КОГДА Т.ЗаполнениеПоСумме
    |                И Т.СуммаПоручения <> 0
    |            ТОГДА (Т.СуммаПоручения - Т.Множитель * ЕСТЬNULL(Остатки.СуммаОстаток, 0)) / Т.СуммаПоручения
    |        КОГДА НЕ Т.ЗаполнениеПоСумме
    |                И Т.Количество <> 0
    |            ТОГДА (Т.Количество - Т.Множитель * ЕСТЬNULL(Остатки.КоличествоОстаток, 0)) / Т.Количество
    |        ИНАЧЕ 0
    |    КОНЕЦ
    |ИЗ
    |    ВТ_Вх КАК Т
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПрогнозПоПоручению.Остатки(, Поручение В (&Поручения)) КАК Остатки
    |        ПО Т.Поручение = Остатки.Поручение
    |            И Т.Актив = Остатки.Актив
    |ГДЕ
    |    Т.Проведен
    |    И Т.ВидОперации В (
    |        ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.Сделка),
    |        ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.НеторговоеПоручение),
    |        ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.ОткрытиеДепозита),
    |        ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.Фьючерсы))
    |
    |ОБЪЕДИНИТЬ
    |
    |ВЫБРАТЬ
    |    Т.Поручение,
    |    Т.ВидОперации,
    |    Т.ЗаполнениеПоСумме,
    |    ВЫБОР
    |        КОГДА Т.ЗаполнениеПоСумме
    |                И Т.СуммаПоручения <> 0
    |            ТОГДА (Т.СуммаПоручения - Т.Множитель * ЕСТЬNULL(Остатки.СуммаОстаток, 0)) / Т.СуммаПоручения
    |        КОГДА НЕ Т.ЗаполнениеПоСумме
    |                И Т.Количество <> 0
    |            ТОГДА (Т.Количество - Т.Множитель * ЕСТЬNULL(Остатки.КоличествоОстаток, 0)) / Т.Количество
    |        ИНАЧЕ 0
    |    КОНЕЦ
    |ИЗ
    |    ВТ_Вх КАК Т
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПрогнозПоПоручению.Остатки(, Поручение В (&Поручения)) КАК Остатки
    |        ПО Т.Поручение = Остатки.Поручение
    |            И Т.БазовыйАктив = Остатки.Актив
    |ГДЕ
    |    Т.Проведен
    |    И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.ВалютныйРынок)
    |
    |ОБЪЕДИНИТЬ
    |
    |ВЫБРАТЬ
    |    Т.Поручение,
    |    Т.ВидОперации,
    |    Т.ЗаполнениеПоСумме,
    |    ВЫБОР
    |        КОГДА Т.ЗаполнениеПоСумме
    |                И Т.СуммаПоручения <> 0
    |            ТОГДА (Т.СуммаПоручения - ЕСТЬNULL(Остатки.КоличествоОстаток, 0)) / Т.СуммаПоручения
    |        КОГДА НЕ Т.ЗаполнениеПоСумме
    |                И Т.Количество <> 0
    |            ТОГДА (Т.Количество - ЕСТЬNULL(Остатки.КоличествоОстаток, 0)) / Т.Количество
    |        ИНАЧЕ 0
    |    КОНЕЦ
    |ИЗ
    |    ВТ_Вх КАК Т
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПланПоПоручению.Остатки(, Поручение В (&Поручения)) КАК Остатки
    |        ПО Т.Поручение = Остатки.Поручение
    |            И Т.Актив = Остатки.Актив
    |ГДЕ
    |    Т.Проведен
    |    И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.РЕПО)
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    Т.Ссылка КАК Поручение,
    |    СУММА(ВЫРАЗИТЬ(Т.Ссылка.ЦенаВВалютеРасчетов * Т.Количество КАК ЧИСЛО(22, 2))) КАК Объем,
    |    СУММА(ВЫРАЗИТЬ(Т.Ссылка.Купон * Т.Ссылка.КурсПересчетов * Т.Количество КАК ЧИСЛО(22, 2))) КАК НКД
    |ПОМЕСТИТЬ ВТ_Объемы
    |ИЗ
    |    Документ.Поручение.РаспределениеПоПортфелям КАК Т
    |ГДЕ
    |    Т.Ссылка В (&Поручения)
    |    И ВЫБОР
    |        КОГДА Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.РЕПО)
    |                И Т.Ссылка.ЗаполнениеПоСумме
    |            ТОГДА ЛОЖЬ
    |        ИНАЧЕ Т.Ссылка.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.НеторговоеПоручение)
    |    КОНЕЦ
    |СГРУППИРОВАТЬ ПО
    |    Т.Ссылка
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |    Т.Ссылка,
    |    СУММА(ВЫРАЗИТЬ(Т.Ссылка.СуммаПоручения КАК ЧИСЛО(22, 2))),
    |    СУММА(ВЫРАЗИТЬ(Т.Ссылка.Купон * Т.Ссылка.КурсПересчетов * Т.Количество КАК ЧИСЛО(22, 2)))
    |ИЗ
    |    Документ.Поручение.РаспределениеПоПортфелям КАК Т
    |ГДЕ
    |    Т.Ссылка В (&Поручения)
    |    И Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.НеторговоеПоручение)
    |СГРУППИРОВАТЬ ПО
    |    Т.Ссылка
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    Исп.Поручение КАК Поручение,
    |    ВЫРАЗИТЬ(Исп.Исполнение КАК ЧИСЛО(15, 4)) КАК Исполнение,
    |    ВЫБОР
    |        КОГДА Исп.ЗаполнениеПоСумме
    |                И Исп.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.РЕПО)
    |            ТОГДА ВЫРАЗИТЬ(Исп.Поручение КАК Документ.Поручение).СуммаПоручения
    |        ИНАЧЕ ЕСТЬNULL(Объемы.Объем, 0)
    |    КОНЕЦ КАК Объем
    |ИЗ
    |    ВТ_Исп КАК Исп
    |        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Объемы КАК Объемы
    |        ПО Исп.Поручение = Объемы.Поручение";

КонецФункции

Функция ЗначенияСтроки(Строка)

    Значения = Новый Структура;
    Значения.Вставить("Исполнение", Окр(Строка.Исполнение, 4));
    Значения.Вставить("Объем", Окр(Строка.Объем, 2));
    Возврат Значения;

КонецФункции

Процедура СравнитьКарты(Лог, Поштучно, Списком, КоличествоДокументов)

    ТолькоПоштучно = 0;
    ТолькоСписком = 0;
    Расхождения = 0;
    Различные = Новый Соответствие;
    Для Каждого Элемент Из Поштучно Цикл
        Правое = Списком.Получить(Элемент.Ключ);
        Если Правое = Неопределено Тогда
            ТолькоПоштучно = ТолькоПоштучно + 1;
            Продолжить;
        КонецЕсли;
        Если Элемент.Значение.Исполнение <> Правое.Исполнение Или Элемент.Значение.Объем <> Правое.Объем Тогда
            Расхождения = Расхождения + 1;
        КонецЕсли;
        Различные.Вставить(Формат(Элемент.Значение.Исполнение, "ЧДЦ=4; ЧРД=.; ЧГ=0") + "/"
            + Формат(Элемент.Значение.Объем, "ЧДЦ=2; ЧРД=.; ЧГ=0"), Истина);
    КонецЦикла;
    Для Каждого Элемент Из Списком Цикл
        Если Поштучно.Получить(Элемент.Ключ) = Неопределено Тогда
            ТолькоСписком = ТолькоСписком + 1;
        КонецЕсли;
    КонецЦикла;
    Добавить(Лог, "Поштучно поручений " + Строка(Поштучно.Количество()) + ", списком " + Строка(Списком.Количество()));
    Добавить(Лог, "Только в поштучном " + Строка(ТолькоПоштучно) + ", только в списке " + Строка(ТолькоСписком)
        + ", расхождений чисел " + Строка(Расхождения));
    Добавить(Лог, "Различных пар исполнение/объем: " + Строка(Различные.Количество()));
    Совпало = ТолькоПоштучно = 0 И ТолькоСписком = 0 И Расхождения = 0 И Поштучно.Количество() = КоличествоДокументов;
    Если Совпало Тогда
        Добавить(Лог, "Регресс чтения: совпало");
    Иначе
        Добавить(Лог, "Регресс чтения: ЕСТЬ РАСХОЖДЕНИЯ");
    КонецЕсли;

КонецПроцедуры

Функция ЧислоПроведенных(Маркер)

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Маркер", Маркер);
    Запрос.Текст =
    "ВЫБРАТЬ
    |    КОЛИЧЕСТВО(*) КАК Проведенных
    |ИЗ
    |    Документ.Поручение КАК Поручения
    |ГДЕ
    |    Поручения.КомментарийКлиента = &Маркер
    |    И Поручения.Проведен";
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Проведенных;

КонецФункции

Процедура УдалитьТестовые(Лог)

    Маркер = "TEXEC1000";
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Маркер", Маркер);
    Запрос.УстановитьПараметр("Маска", Маркер + "%");
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Поручения.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.Поручение КАК Поручения
    |ГДЕ
    |    Поручения.КомментарийКлиента = &Маркер
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    Сделки.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.Сделка КАК Сделки
    |ГДЕ
    |    Сделки.НомерСделки ПОДОБНО &Маска";
    Результаты = Запрос.ВыполнитьПакет();
    Поручения = Результаты[0].Выгрузить();
    Сделки = Результаты[1].Выгрузить();
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Для Каждого Строка Из Поручения Цикл
        Набор = РегистрыНакопления.ПрогнозПоПоручению.СоздатьНаборЗаписей();
        Набор.Отбор.Регистратор.Установить(Строка.Ссылка);
        Набор.ОбменДанными.Загрузка = Истина;
        Набор.Записать();
        Объект = Строка.Ссылка.ПолучитьОбъект();
        Если Объект <> Неопределено Тогда
            Объект.ОбменДанными.Загрузка = Истина;
            Объект.Удалить();
        КонецЕсли;
    КонецЦикла;
    Для Каждого Строка Из Сделки Цикл
        Объект = Строка.Ссылка.ПолучитьОбъект();
        Если Объект <> Неопределено Тогда
            Объект.ОбменДанными.Загрузка = Истина;
            Объект.Удалить();
        КонецЕсли;
    КонецЦикла;
    Секунды = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
    Добавить(Лог, "Удалено поручений " + Строка(Поручения.Количество()) + ", сделок " + Строка(Сделки.Количество())
        + " за " + Формат(Секунды, "ЧДЦ=1; ЧРД=.; ЧГ=0") + " с");

КонецПроцедуры

Функция ОстатокОтДеления(Значение, Делитель)
    Возврат Значение - Цел(Значение / Делитель) * Делитель;
КонецФункции

Функция Медиана(Значения)

    Если Значения.Количество() = 0 Тогда
        Возврат 0;
    КонецЕсли;
    Копия = Новый Массив;
    Для Каждого Значение Из Значения Цикл
        Копия.Добавить(Значение);
    КонецЦикла;
    // Три замера: среднее из отсортированных, средний элемент.
    Для Левый = 0 По Копия.ВГраница() Цикл
        Для Правый = 0 По Копия.ВГраница() - 1 Цикл
            Если Копия[Правый] > Копия[Правый + 1] Тогда
                Буфер = Копия[Правый];
                Копия[Правый] = Копия[Правый + 1];
                Копия[Правый + 1] = Буфер;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Копия[Цел(Копия.Количество() / 2)];

КонецФункции

Процедура Добавить(Лог, Текст)
    Лог.Добавить(Текст);
КонецПроцедуры

#КонецОбласти
