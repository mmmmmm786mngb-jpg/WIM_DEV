#Область СлужебныйПрограммныйИнтерфейс

&ИзменениеИКонтроль("ПланОбработкиПроверки")
Функция FO_LimitCheckOpt_ПланОбработкиПроверки(ПланПроверки, Вместилище, ЛимитыПоТипам,
	Знач ПотоковОбработкиПроверки) Экспорт

	ЗапланированоПроверок = ПланПроверки.Количество();
	ПотоковОбработкиПроверки = ?(ЗначениеЗаполнено(ПотоковОбработкиПроверки), ПотоковОбработкиПроверки, 1);
	КоличествоНаЗадание = Макс(Окр((ЗапланированоПроверок / ПотоковОбработкиПроверки) + 0.5, 0, 0), 10);
	ДатаЗаписи = ТекущаяДатаСеанса();

	Результат = Новый Структура();
	Результат.Вставить("НомераИсполнителей", ЗначениеВМассиве(0));
	Результат.Вставить("ЗапланированоПроверок", ЗапланированоПроверок);
	Результат.Вставить("НаборыДанных", Новый Массив());
	Результат.Вставить("ГруппыПортфелей", Новый Массив());
	Результат.Вставить("Портфели", Новый Массив());
	Результат.Вставить("Лимиты", Новый Массив());

	ПланПроверки.Колонки.Добавить("Вместилище", Новый ОписаниеТипов("УникальныйИдентификатор"));
	ПланПроверки.Колонки.Добавить("АвтоНомер", Новый ОписаниеТипов("Число"));
	ПланПроверки.Колонки.Добавить("НомерИсполнителя", Новый ОписаниеТипов("Число"));
	ПланПроверки.Колонки.Добавить("ДатаЗаписи", Новый ОписаниеТипов("Дата"));

	ПланПроверки = ОтобранныеСтрокиПланаПроверки(ПланПроверки, ЛимитыПоТипам.Стандарт);
#Вставка
	// Проверка поручений: план раздается заданиям с учетом наборов данных, чтобы временная таблица
	// набора строилась в одном-двух заданиях, а не в каждом; строки лимитов по алгоритму - по кругу.
	НомераПоНаборам = НомераИсполнителейПоНаборам(ПланПроверки, ПотоковОбработкиПроверки,
		КоличествоНаЗадание);
#КонецВставки

	АвтоНомер = 0;
	НомерИсполнителя = 0;
	КоличествоИсполнителя = 0;
	Для Каждого Строка Из ПланПроверки Цикл
		Строка.Вместилище = Вместилище;
		Строка.АвтоНомер = АвтоНомер;
		Строка.НомерИсполнителя = НомерИсполнителя;
#Вставка
		Если НомераПоНаборам <> Неопределено Тогда
			Строка.НомерИсполнителя = НомерИсполнителяСтроки(НомераПоНаборам, Строка.НаборДанных,
				Строка.Лимит);
		КонецЕсли;
#КонецВставки
		Строка.ДатаЗаписи = ДатаЗаписи;

		Результат.НаборыДанных.Добавить(Строка.НаборДанных);
		Результат.ГруппыПортфелей.Добавить(Строка.ГруппаПортфелей);
		Результат.Портфели.Добавить(Строка.Портфель);
		Результат.Лимиты.Добавить(Строка.Лимит);

	 	АвтоНомер = АвтоНомер + 1;
	 	КоличествоИсполнителя = КоличествоИсполнителя + 1;
		Если КоличествоИсполнителя > КоличествоНаЗадание Тогда
			НомерИсполнителя = НомерИсполнителя + 1;
			Результат.НомераИсполнителей.Добавить(НомерИсполнителя);
			КоличествоИсполнителя = 0;
		КонецЕсли;
	КонецЦикла;
#Вставка
	Если НомераПоНаборам <> Неопределено Тогда
		Результат.НомераИсполнителей = НомераПоНаборам.НомераИсполнителей;
	КонецЕсли;
#КонецВставки

	Набор = РегистрыСведений.КэшВмПланПроверки.СоздатьНаборЗаписей();
	Набор.Отбор.Вместилище.Установить(Вместилище);
	Набор.Загрузить(ПланПроверки);
	Набор.Записать();

	Результат.Лимиты = СвернутьМассив(Результат.Лимиты);
	Результат.Портфели = СвернутьМассив(Результат.Портфели);
	Результат.ГруппыПортфелей = СвернутьМассив(Результат.ГруппыПортфелей);
	Результат.НаборыДанных = СвернутьМассив(Результат.НаборыДанных);
	УдалитьВсеВхождения(Результат.ГруппыПортфелей, Справочники.ГруппыПортфелей.ПустаяСсылка());
	УдалитьВсеВхождения(Результат.НаборыДанных, Справочники.НаборыДанныхДляПроверкиЛимитов.ПустаяСсылка());

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область НарезкаПланаПроверкиПоЗаданиям

// Раскладывает строки плана проверки поручений по заданиям обработки проверки.
//
// Строки лимитов по алгоритму проверяются в задании отдельным вызовом внешней обработки на каждую строку
// (РаботаСЛимитамиОбработкаВнешних, Пакетно = Ложь) и не требуют таблиц наборов, но стоят дорого. Штатная нарезка
// отдает их, идущих в плане рядом, одному заданию. Здесь они раздаются по кругу, по одной строке на задание.
//
// Остальные строки раскладываются с учетом наборов данных. Задание строит временную таблицу набора
// (ДобавитьВТ_ТаблицаНабораДанных: статика активов, рейтинги, позиции всех портфелей вместилища по набору) один раз
// на каждый свой набор; штатная нарезка по числу строк не учитывает наборы, и каждое задание строит таблицы
// многих наборов. Два режима, по размеру штатного куска (строк плана / потоков):
// - кусок мельче МинимумСтрокЧастиНабора(): набор режется на части не больше минимальной
//   части, части раскладываются от крупных к мелким в наименее загруженное задание. Мелкие наборы остаются
//   целыми, крупные делятся, чтобы одно задание не получало непропорционально большой набор;
// - кусок не мельче минимальной части: номера выдаются так, как если бы строки шли по наборам (набор за
//   набором, внутри набора - в порядке обхода плана), и эта последовательность режется подряд штатными
//   кусками КоличествоНаЗадание + 1 (по строкам без лимитов по алгоритму). Заданий не больше, чем потоков, а
//   построений таблиц наборов не больше, чем заданий + наборов - 1.
// Номеров не больше, чем потоков: задание обработки проверки берет только первый номер из выданных ему
// (Параметры.Данные[0]).
//
// Применяется только к плану с поручениями (предконтроль); регламентная проверка портфелей идет штатно.
//
// Параметры:
//  ПланПроверки - ТаблицаЗначений - строки плана после отбора стандартных лимитов (колонки
//                 НаборДанных, Поручение, Лимит)
//  ПотоковОбработкиПроверки - Число - число потоков обработки проверки, не меньше 1
//  КоличествоНаЗадание - Число - штатный параметр нарезки ПланОбработкиПроверки: номер задания меняется
//                        после КоличествоНаЗадание + 1 строк. Если в плане есть лимиты по алгоритму, в режиме
//                        подряд пересчитывается тем же правилом по строкам без них
//
// Возвращаемое значение:
//  Неопределено - применять штатную нумерацию;
//  Структура - раскладка, используется НомерИсполнителяСтроки:
//   * ЧастиПоНаборам - Соответствие из КлючИЗначение - ключ: СправочникСсылка.НаборыДанныхДляПроверкиЛимитов,
//                      значение: Структура:
//      ** РазмерЧасти - Число - строк плана в части набора (режим частей)
//      ** Номера - Массив из Число - номер исполнителя каждой части (режим частей)
//      ** Смещение - Число - позиция первой строки набора в последовательности по наборам (режим подряд)
//      ** Выдано - Число - строк набора, которым уже выдан номер
//   * НомераИсполнителей - Массив из Число - номера исполнителей от 0 без пропусков
//   * РазмерКуска - Число - строк на задание в режиме подряд; 0 - режим частей
//   * ЛимитыПоАлгоритму - Соответствие из КлючИЗначение - ключ: СправочникСсылка.Лимиты, значение: Истина
//   * ИсполнителейАлгоритмов - Число - по скольким заданиям по кругу раздаются строки лимитов по алгоритму
//   * ВыданоАлгоритмов - Число - строк лимитов по алгоритму, которым уже выдан номер
//
Функция НомераИсполнителейПоНаборам(ПланПроверки, ПотоковОбработкиПроверки, КоличествоНаЗадание)

	Если ПотоковОбработкиПроверки <= 1
		Или ПланПроверки.Колонки.Найти("Поручение") = Неопределено
		Или ПланПроверки.Колонки.Найти("НаборДанных") = Неопределено
		Или ПланПроверки.Колонки.Найти("Лимит") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЛимитыПоАлгоритму = ОтобратьЛимитыПоАлгоритму(ПланПроверки.ВыгрузитьКолонку("Лимит"));

	СтрокиПоНаборам = ПланПроверки.Скопировать(, "НаборДанных, Поручение, Лимит");
	СтрокиПоНаборам.Колонки.Добавить("ЕстьПоручение", Новый ОписаниеТипов("Число"));
	СтрокиПоНаборам.Колонки.Добавить("ПоАлгоритму", Новый ОписаниеТипов("Число"));
	СтрокиПоНаборам.Колонки.Добавить("Строк", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из СтрокиПоНаборам Цикл
		Строка.Строк = 1;
		Если ЗначениеЗаполнено(Строка.Поручение) Тогда
			Строка.ЕстьПоручение = 1;
		КонецЕсли;
		Если ЛимитыПоАлгоритму[Строка.Лимит] <> Неопределено Тогда
			Строка.ПоАлгоритму = 1;
		КонецЕсли;
	КонецЦикла;
	Если СтрокиПоНаборам.Итог("ЕстьПоручение") = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтрокАлгоритмов = СтрокиПоНаборам.Итог("ПоАлгоритму");

	СтрокиПоНаборам.Свернуть("НаборДанных, ПоАлгоритму", "Строк");
	Для Каждого Строка Из СтрокиПоНаборам.НайтиСтроки(Новый Структура("ПоАлгоритму", 1)) Цикл
		СтрокиПоНаборам.Удалить(Строка);
	КонецЦикла;
	Если СтрокАлгоритмов = 0 И СтрокиПоНаборам.Количество() <= 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДоляПотока = Цел((ПланПроверки.Количество() + ПотоковОбработкиПроверки - 1) / ПотоковОбработкиПроверки);
	Если ДоляПотока >= МинимумСтрокЧастиНабора() Тогда
		// Штатные куски крупные: раскладка частями дала бы заданиям неравную нагрузку, поэтому размер куска
		// остается штатным, а в кусок попадают строки подряд идущих наборов.
		КоличествоНаЗаданиеОбычных = КоличествоНаЗадание;
		Если СтрокАлгоритмов > 0 Тогда
			// Куски режутся по строкам без лимитов по алгоритму тем же правилом, что штатный КоличествоНаЗадание:
			// строки алгоритмов раздаются отдельно и не должны укорачивать последние куски.
			СтрокОбычных = ПланПроверки.Количество() - СтрокАлгоритмов;
			КоличествоНаЗаданиеОбычных = Макс(Окр((СтрокОбычных / ПотоковОбработкиПроверки) + 0.5, 0, 0), 10);
		КонецЕсли;
		Результат = НомераПодрядПоНаборам(СтрокиПоНаборам, КоличествоНаЗаданиеОбычных);
	Иначе
		Результат = НомераПоЧастямНаборов(СтрокиПоНаборам, ПотоковОбработкиПроверки);
	КонецЕсли;

	ИсполнителейАлгоритмов = Мин(ПотоковОбработкиПроверки,
		Макс(Результат.НомераИсполнителей.Количество(), СтрокАлгоритмов));
	Для Номер = Результат.НомераИсполнителей.Количество() По ИсполнителейАлгоритмов - 1 Цикл
		Результат.НомераИсполнителей.Добавить(Номер);
	КонецЦикла;
	Результат.Вставить("ЛимитыПоАлгоритму", ЛимитыПоАлгоритму);
	Результат.Вставить("ИсполнителейАлгоритмов", ИсполнителейАлгоритмов);
	Результат.Вставить("ВыданоАлгоритмов", 0);

	Возврат Результат;

КонецФункции

// Лимиты плана со способом настройки "по алгоритму": их проверяет внешняя обработка, а не запрос по таблице набора.
//
// Параметры:
//  Лимиты - Массив из СправочникСсылка.Лимиты - лимиты строк плана, возможны повторы
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: СправочникСсылка.Лимиты, значение: Истина
//
Функция ОтобратьЛимитыПоАлгоритму(Лимиты)

	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лимиты.Ссылка КАК Лимит
	|ИЗ
	|	Справочник.Лимиты КАК Лимиты
	|ГДЕ
	|	Лимиты.Ссылка В (&Лимиты)
	|	И Лимиты.СпособНастройкиЛимита = ЗНАЧЕНИЕ(Перечисление.СпособыНастройкиЛимита.ПоАлгоритму)";
	Запрос.УстановитьПараметр("Лимиты", СвернутьМассив(Лимиты));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Лимит, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Раскладка малого плана: наборы режутся на части не больше минимальной части, части раскладываются по
// заданиям от крупных к мелким в наименее загруженное задание.
//
// Параметры:
//  СтрокиПоНаборам - ТаблицаЗначений - строки плана без лимитов по алгоритму, свернутые по наборам
//                    (колонки НаборДанных, Строк)
//  ПотоковОбработкиПроверки - Число - число потоков обработки проверки
//
// Возвращаемое значение:
//  Структура - см. НомераИсполнителейПоНаборам, режим частей
//
Функция НомераПоЧастямНаборов(СтрокиПоНаборам, ПотоковОбработкиПроверки)

	РазмерЧастиПредельный = МинимумСтрокЧастиНабора();

	Части = Новый ТаблицаЗначений;
	Части.Колонки.Добавить("НаборДанных");
	Части.Колонки.Добавить("НомерЧасти", Новый ОписаниеТипов("Число"));
	Части.Колонки.Добавить("Строк", Новый ОписаниеТипов("Число"));
	ЧастиПоНаборам = Новый Соответствие;
	Для Каждого Строка Из СтрокиПоНаборам Цикл
		КоличествоЧастей = Цел((Строка.Строк + РазмерЧастиПредельный - 1) / РазмерЧастиПредельный);
		РазмерЧасти = Цел((Строка.Строк + КоличествоЧастей - 1) / КоличествоЧастей);
		ОписаниеЧастей = Новый Структура("РазмерЧасти, Номера, Выдано", РазмерЧасти, Новый Массив, 0);
		ЧастиПоНаборам.Вставить(Строка.НаборДанных, ОписаниеЧастей);
		Остаток = Строка.Строк;
		Для НомерЧасти = 0 По КоличествоЧастей - 1 Цикл
			ОписаниеЧастей.Номера.Добавить(0);
			Часть = Части.Добавить();
			Часть.НаборДанных = Строка.НаборДанных;
			Часть.НомерЧасти = НомерЧасти;
			Часть.Строк = Мин(РазмерЧасти, Остаток);
			Остаток = Остаток - Часть.Строк;
		КонецЦикла;
	КонецЦикла;
	Части.Сортировать("Строк Убыв");

	КоличествоИсполнителей = Мин(ПотоковОбработкиПроверки, Части.Количество());
	Нагрузка = Новый Массив;
	НомераИсполнителей = Новый Массив;
	Для Номер = 0 По КоличествоИсполнителей - 1 Цикл
		Нагрузка.Добавить(0);
		НомераИсполнителей.Добавить(Номер);
	КонецЦикла;

	Для Каждого Часть Из Части Цикл
		НомерМинимальный = 0;
		Для Номер = 1 По КоличествоИсполнителей - 1 Цикл
			Если Нагрузка[Номер] < Нагрузка[НомерМинимальный] Тогда
				НомерМинимальный = Номер;
			КонецЕсли;
		КонецЦикла;
		ЧастиПоНаборам[Часть.НаборДанных].Номера[Часть.НомерЧасти] = НомерМинимальный;
		Нагрузка[НомерМинимальный] = Нагрузка[НомерМинимальный] + Часть.Строк;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ЧастиПоНаборам", ЧастиПоНаборам);
	Результат.Вставить("НомераИсполнителей", НомераИсполнителей);
	Результат.Вставить("РазмерКуска", 0);

	Возврат Результат;

КонецФункции

// Раскладка большого плана: строки нумеруются так, как если бы шли набор за набором, и режутся подряд
// штатными кусками. Кусок из подряд идущих строк такой последовательности задевает один набор, на стыке -
// соседние, поэтому задание строит таблицы одного-двух наборов вместо всех.
//
// Параметры:
//  СтрокиПоНаборам - ТаблицаЗначений - строки плана без лимитов по алгоритму, свернутые по наборам
//                    (колонки НаборДанных, Строк)
//  КоличествоНаЗадание - Число - см. НомераИсполнителейПоНаборам
//
// Возвращаемое значение:
//  Структура - см. НомераИсполнителейПоНаборам, режим подряд
//
Функция НомераПодрядПоНаборам(СтрокиПоНаборам, КоличествоНаЗадание)

	РазмерКуска = КоличествоНаЗадание + 1;

	ЧастиПоНаборам = Новый Соответствие;
	Смещение = 0;
	Для Каждого Строка Из СтрокиПоНаборам Цикл
		ЧастиПоНаборам.Вставить(Строка.НаборДанных, Новый Структура("Смещение, Выдано", Смещение, 0));
		Смещение = Смещение + Строка.Строк;
	КонецЦикла;

	НомераИсполнителей = Новый Массив;
	Для Номер = 0 По Цел((Смещение - 1) / РазмерКуска) Цикл
		НомераИсполнителей.Добавить(Номер);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("ЧастиПоНаборам", ЧастиПоНаборам);
	Результат.Вставить("НомераИсполнителей", НомераИсполнителей);
	Результат.Вставить("РазмерКуска", РазмерКуска);

	Возврат Результат;

КонецФункции

// Выдает номер исполнителя очередной строке плана по раскладке НомераИсполнителейПоНаборам:
// строка лимита по алгоритму получает следующий номер по кругу; строки остальных лимитов заполняют части своего
// набора по очереди (режим частей) или занимают позиции набора в последовательности по наборам (режим подряд).
//
// Параметры:
//  НомераПоНаборам - Структура - см. НомераИсполнителейПоНаборам
//  НаборДанных - СправочникСсылка.НаборыДанныхДляПроверкиЛимитов - набор строки плана
//  Лимит - СправочникСсылка.Лимиты - лимит строки плана
//
// Возвращаемое значение:
//  Число - номер исполнителя строки
//
Функция НомерИсполнителяСтроки(НомераПоНаборам, НаборДанных, Лимит)

	Если НомераПоНаборам.ЛимитыПоАлгоритму[Лимит] <> Неопределено Тогда
		// Круг идет от последнего задания: в режиме подряд последний кусок самый короткий.
		НомерИсполнителя = НомераПоНаборам.ИсполнителейАлгоритмов - 1
			- НомераПоНаборам.ВыданоАлгоритмов % НомераПоНаборам.ИсполнителейАлгоритмов;
		НомераПоНаборам.ВыданоАлгоритмов = НомераПоНаборам.ВыданоАлгоритмов + 1;
		Возврат НомерИсполнителя;
	КонецЕсли;

	ОписаниеЧастей = НомераПоНаборам.ЧастиПоНаборам[НаборДанных];
	Если НомераПоНаборам.РазмерКуска > 0 Тогда
		НомерИсполнителя = Цел((ОписаниеЧастей.Смещение + ОписаниеЧастей.Выдано) / НомераПоНаборам.РазмерКуска);
	Иначе
		НомерЧасти = Мин(Цел(ОписаниеЧастей.Выдано / ОписаниеЧастей.РазмерЧасти), ОписаниеЧастей.Номера.ВГраница());
		НомерИсполнителя = ОписаниеЧастей.Номера[НомерЧасти];
	КонецЕсли;
	ОписаниеЧастей.Выдано = ОписаниеЧастей.Выдано + 1;

	Возврат НомерИсполнителя;

КонецФункции

// Наименьший размер части набора данных в строках плана. Меньшие наборы не делятся: повторное
// построение таблицы набора в другом задании стоит дороже, чем расчет такой части в одном задании.
//
// Возвращаемое значение:
//  Число - строк плана
//
Функция МинимумСтрокЧастиНабора()

	Возврат 50;

КонецФункции

#КонецОбласти

#КонецОбласти
