#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

&ИзменениеИКонтроль("СведенияОПорогах")
Функция FO_LimitCheckOpt_СведенияОПорогах(Параметры, Вместилище, Исполнитель) Экспорт

	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("Вместилище", Новый ОписаниеТипов("УникальныйИдентификатор"));
	Результат.Колонки.Добавить("Исполнитель", Новый ОписаниеТипов("УникальныйИдентификатор"));
	Результат.Колонки.Добавить("Лимит", Новый ОписаниеТипов("СправочникСсылка.Лимиты"));
	Результат.Колонки.Добавить("Сведения", Новый ОписаниеТипов("ХранилищеЗначения"));
	Результат.Колонки.Добавить("ДатаЗаписи", Новый ОписаниеТипов("Дата"));

	Шапка = Новый Структура("Вместилище, Исполнитель, ДатаЗаписи", Вместилище, Исполнитель, ТекущаяДатаСеанса());
	ТаблицыНастроекПорогов = НовыеТаблицыНастроекПорогов(Параметры);

	Запрос = Новый Запрос();
#Удаление
	Запрос.Текст = ТекстЗапросаПолученияПорогов();
#КонецУдаления
#Вставка
	// Пары "лимит - портфель" берутся из плана проверки, а не из всех портфелей x все лимиты:
	// на обычном ФО штатный текст строит 2,1 млн структур при 374 тыс. строк плана.
	Запрос.Текст = ТекстЗапросаПолученияПороговПоПлану(Вместилище, Параметры.Лимиты);
	Запрос.УстановитьПараметр("Вместилище", Вместилище);
#КонецВставки
	ПортфельПустаяСсылка = Справочники.Портфели.ПустаяСсылка();
	НастройкиПороговПустаяСсылка = Справочники.НастройкиПороговДляПроверкиЛимитов.ПустаяСсылка();
	Запрос.УстановитьПараметр("Лимиты", Параметры.Лимиты);
	Запрос.УстановитьПараметр("ЛимитыРасширеннаяПроверка", ТаблицыНастроекПорогов.ЛимитыРасширеннаяПроверка);
	Запрос.УстановитьПараметр("Портфели", Параметры.Портфели);
	Запрос.УстановитьПараметр("Период", Параметры.Период);
	Запрос.УстановитьПараметр("ПортфельПустаяСсылка", ПортфельПустаяСсылка);
	Запрос.УстановитьПараметр("НастройкиПороговПустаяСсылка", НастройкиПороговПустаяСсылка);
	Запрос.УстановитьПараметр("ТаблицаРеквизитовНастроекКэш", ТаблицыНастроекПорогов.ТаблицаРеквизитовНастроекКэш);
	Запрос.УстановитьПараметр("ТаблицаПороговКэш", ТаблицыНастроекПорогов.ТаблицаПороговКэш);
	Запрос.УстановитьПараметр("ТаблицаПороговКэшИмеетЗаписи", ЗначениеЗаполнено(ТаблицыНастроекПорогов.ТаблицаПороговКэш));
	Запрос.УстановитьПараметр("ВидСравненияНеИспользуется", Справочники.НастройкиПороговДляПроверкиЛимитов.ВидСравненияНеИспользуется());

	ОбщегоНазначенияАванкор.ДобавитьВЛогОтладки(Запрос, "СведенияОПорогах()");

	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ТаблицыНастроекПорогов = Неопределено;

	ВыборкаРеквизитовНастроекИзКэша = РезультатыЗапроса[РезультатыЗапроса.ВГраница() - 1].Выбрать();

	ШаблонТаблицыПорогов = Справочники.НастройкиПороговДляПроверкиЛимитов.СоздатьЭлемент().СложныеПороги.Выгрузить();
	ШаблонТаблицыПорогов.Колонки.Удалить(ШаблонТаблицыПорогов.Колонки.Найти("УКР"));

	ВыборкаПоЛимитам = РезультатыЗапроса[РезультатыЗапроса.ВГраница()].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоЛимитам.Следующий() Цикл
		РезультатыПоЛимиту = Новый Соответствие;

		ВыборкаПоПортфелям = ВыборкаПоЛимитам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоПортфелям.Следующий() Цикл

			Портфель = ВыборкаПоПортфелям.Портфель;
			СведенияОПорогахПоПортфелю = РезультатыПоЛимиту[Портфель];
			Если ЗначениеЗаполнено(СведенияОПорогахПоПортфелю) Тогда
				Продолжить;
			КонецЕсли;

			СведенияОПорогахПоПортфелю = НовыеСведенияОПорогах();
			РеквизитыНастроекПорогов = НовыеРеквизитыНастроек();
			СведенияОПорогахПоПортфелю.Вставить("РеквизитыНастроекПорогов", РеквизитыНастроекПорогов);

			ВыборкаПоПорогам = ВыборкаПоПортфелям.Выбрать();
			КоличествоПорогов = ВыборкаПоПорогам.Количество();
			ВыборкаПоПорогам.Следующий();
			НастройкаПорогов = ВыборкаПоПорогам.НастройкаПорогов;
			Если КоличествоПорогов = 0 Или КоличествоПорогов = 1 И Не ЗначениеЗаполнено(НастройкаПорогов) Тогда
				СведенияОПорогахПоПортфелю.ПорогиНайдены = Ложь;
				РезультатыПоЛимиту.Вставить(Портфель, СведенияОПорогахПоПортфелю);
				Продолжить;
			КонецЕсли;

			ВыборкаРеквизитовНастроекИзКэша.Сбросить();
			Если ВыборкаРеквизитовНастроекИзКэша.НайтиСледующий(НастройкаПорогов, "НастройкаПорогов") Тогда
				ЗаполнитьЗначенияСвойств(РеквизитыНастроекПорогов, ВыборкаРеквизитовНастроекИзКэша);
			Иначе
				ЗаполнитьЗначенияСвойств(РеквизитыНастроекПорогов, ВыборкаПоПорогам);
			КонецЕсли;

			Если КоличествоПорогов = 1 Тогда
				ЗаполнитьЗначенияСвойств(СведенияОПорогахПоПортфелю, ВыборкаПоПорогам);
			Иначе
				ТаблицаПорогов = ШаблонТаблицыПорогов.Скопировать();
				ВыборкаПоПорогам.Сбросить();
				Пока ВыборкаПоПорогам.Следующий() Цикл
					Строка = ТаблицаПорогов.Добавить();
					ЗаполнитьЗначенияСвойств(Строка, ВыборкаПоПорогам);
				КонецЦикла;
				СведенияОПорогахПоПортфелю.РасширеннаяУстановкаПорогов = Истина;
				СведенияОПорогахПоПортфелю.ТаблицаПорогов = ТаблицаПорогов;
			КонецЕсли;

			РезультатыПоЛимиту.Вставить(Портфель, СведенияОПорогахПоПортфелю);
		КонецЦикла;

		Строка = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Шапка);
		Строка.Лимит = ВыборкаПоЛимитам.Лимит;
		Строка.Сведения = Новый ХранилищеЗначения(РезультатыПоЛимиту);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СведенияОПорогахПоПарамПлана

// Возвращает текст пакета ТекстЗапросаПолученияПорогов, в котором первый запрос пакета
// (ВТ_ПортфелиЛимиты - каждый портфель проверки с каждым лимитом задания) заменен на пары
// "лимит - портфель" из плана проверки КэшВмПланПроверки по Вместилищу и пустой портфель
// каждого лимита. Остальные запросы пакета не меняются.
//
// Основа пар - строки плана, а не записи регистра ПорогиЛимитов: портфель без собственной
// записи порогов получает порог пустого портфеля лимита так же, как в штатном тексте.
// Пустой портфель остается на каждый лимит: для строк плана по группе портфелей потребитель
// (ПроверкаЛимитов.КэшВмКратко) берет сведения именно по нему.
//
// Возвращает штатный текст без изменений, если плана по Вместилищу для лимитов задания нет
// или первый запрос штатного текста изменился и замена небезопасна.
//
// Параметры:
//  Вместилище - УникальныйИдентификатор - идентификатор распорядителя проверки,
//               с ним записан план в РаботаСЛимитами.ПланОбработкиПроверки
//  Лимиты - Массив из СправочникСсылка.Лимиты - лимиты задания чтения сведений о порогах
//
// Возвращаемое значение:
//  Строка - текст пакета запроса; в варианте по плану использует параметр &Вместилище
//
Функция ТекстЗапросаПолученияПороговПоПлану(Вместилище, Лимиты)

	ТекстШтатный = ТекстЗапросаПолученияПорогов();

	ГраницаПервогоЗапроса = СтрНайти(ТекстШтатный, ";");
	Если ГраницаПервогоЗапроса = 0 Тогда
		Возврат ТекстШтатный;
	КонецЕсли;

	ПервыйЗапрос = Лев(ТекстШтатный, ГраницаПервогоЗапроса - 1);
	Если СтрНайти(ПервыйЗапрос, "ПОМЕСТИТЬ ВТ_ПортфелиЛимиты") = 0
		Или СтрНайти(ПервыйЗапрос, "ПО (ИСТИНА)") = 0 Тогда
		Возврат ТекстШтатный;
	КонецЕсли;

	Если Не ЕстьПланПроверки(Вместилище, Лимиты) Тогда
		Возврат ТекстШтатный;
	КонецЕсли;

	Возврат ТекстПарЛимитПортфельПоПлану() + Сред(ТекстШтатный, ГраницаПервогоЗапроса);

КонецФункции

// Проверяет, записан ли план проверки по Вместилищу хотя бы для одного лимита задания.
//
// Параметры:
//  Вместилище - УникальныйИдентификатор - идентификатор распорядителя проверки
//  Лимиты - Массив из СправочникСсылка.Лимиты - лимиты задания чтения сведений о порогах
//
// Возвращаемое значение:
//  Булево - Истина, если в КэшВмПланПроверки есть строки плана
//
Функция ЕстьПланПроверки(Вместилище, Лимиты)

	// Без РАЗРЕШЕННЫЕ, как в штатном тексте пакета: чтение сведений о порогах выполняется
	// в привилегированном режиме, а отбрасывание строк плана дало бы ложное "Не заданы пороги".
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	План.Лимит КАК Лимит
	|ИЗ
	|	РегистрСведений.КэшВмПланПроверки КАК План
	|ГДЕ
	|	План.Лимит В (&Лимиты)
	|	И План.Вместилище = &Вместилище";
	Запрос.УстановитьПараметр("Лимиты", Лимиты);
	Запрос.УстановитьПараметр("Вместилище", Вместилище);

	РезультатЗапроса = Запрос.Выполнить();

	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

// Возвращает первый запрос пакета: пары "лимит - портфель" из плана проверки и пустой
// портфель каждого лимита, с теми же колонками и той же временной таблицей ВТ_ПортфелиЛимиты,
// что и штатный первый запрос. Без завершающей точки с запятой.
//
// Возвращаемое значение:
//  Строка - текст первого запроса пакета
//
Функция ТекстПарЛимитПортфельПоПлану()

	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	План.Портфель КАК Портфель,
	|	План.Лимит КАК Лимит
	|ПОМЕСТИТЬ ВТ_ПортфелиЛимиты
	|ИЗ
	|	РегистрСведений.КэшВмПланПроверки КАК План
	|ГДЕ
	|	План.Вместилище = &Вместилище
	|	И План.Лимит В (&Лимиты)
	|	И План.Портфель В (&Портфели)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.Портфели.ПустаяСсылка),
	|	Лимиты.Ссылка
	|ИЗ
	|	Справочник.Лимиты КАК Лимиты
	|ГДЕ
	|	Лимиты.Ссылка В (&Лимиты)
	|";

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
