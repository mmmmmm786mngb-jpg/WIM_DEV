#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

&ИзменениеИКонтроль("ИсполнитьРаспоряжение")
Функция FO_CheckProc_ИсполнитьРаспоряжение(Распорядитель, Распоряжение, ТолькоНужное = Неопределено)

	ИсполнителиРаспоряжения = Новый Соответствие();
	Исполнитель = Распоряжение.Исполнитель;
	КоличествоПотоков = Распоряжение.КоличествоПотоков;
	КоличествоНаЗадание = Распоряжение.КоличествоМинимальноеНаЗадание;

	РаспорядительВсп = Распорядитель;
	Если ТолькоНужное <> Неопределено Тогда
		Идентификатор = Распорядитель.Идентификатор;
		РаспорядительВсп = Распорядитель(Распорядитель.Вид, Распорядитель.Кэш.Параметры, Идентификатор);
		Для Каждого Ключ Из СтрРазделить("Таблицы, Соответствия, Показатели, Массивы", ", ", Ложь) Цикл
			Для Каждого КлючЗначение Из Распорядитель.Кэш[Ключ] Цикл
				Если ТолькоНужное.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
					РаспорядительВсп.Кэш[Ключ].Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Параметры = Новый Структура("Распорядитель", РаспорядительВсп);
	Если КоличествоПотоков = 0 Тогда
		АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);
		Параметры.Вставить("Данные", Распоряжение.Данные);
		Параметры.Вставить("ПланВСекундах", 0);
		Параметры.Вставить("ЗамерИнициализацияИсполнителя", ЗамерИсполнителя(Перечисления.ВидыКлючейЗамеров.ИнициализацияИсполнителя));
		//@skip-check server-execution-safe-mode
		Выполнить("АдресРезультата = " + Исполнитель.Метод + "(Параметры, АдресРезультата)");
		ИсполнителиРаспоряжения.Вставить(Новый УникальныйИдентификатор(), АдресРезультата);

	ИначеЕсли Исполнитель.МетодРаспределенияИспользовать Тогда
		//@skip-check server-execution-safe-mode
		Выполнить("ИсполнителиРаспоряжения = " + Исполнитель.МетодРаспределения + "(РаспорядительВсп, Распоряжение)");

	Иначе
		Количество = Распоряжение.Данные.Количество();
#Удаление
		КоличествоНаЗадание = Макс(Окр((Количество / КоличествоПотоков) + 0.5, 0, 0), КоличествоНаЗадание);
#КонецУдаления
#Вставка
		Если Исполнитель.Метод = "Исполнители.ПроверкаИОтправка_ОбработкаПроверки" Тогда
			КоличествоНаЗадание = 1;
		Иначе
			КоличествоНаЗадание = Макс(Окр((Количество / КоличествоПотоков) + 0.5, 0, 0), КоличествоНаЗадание);
		КонецЕсли;
#КонецВставки

		Счетчик = 0;
		Пока Счетчик < Количество Цикл
			МассивДанных = Новый Массив();
			Пока Счетчик < Количество И МассивДанных.Количество() < КоличествоНаЗадание Цикл
				МассивДанных.Добавить(Распоряжение.Данные[Счетчик]);
				Счетчик = Счетчик + 1;
			КонецЦикла;
			АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);
			Параметры.Вставить("Данные", МассивДанных);
			Параметры.Вставить("ПланВСекундах", 0);
			Параметры.Вставить("ЗамерИнициализацияИсполнителя", ЗамерИсполнителя(Перечисления.ВидыКлючейЗамеров.ИнициализацияИсполнителя));
			Если ТипЗнч(Распоряжение.Данные) = Тип("ТаблицаЗначений") Тогда
				Параметры.Вставить("Данные", Распоряжение.Данные.Скопировать(МассивДанных));
			КонецЕсли;
			МассивПараметров = ЗначениеВМассиве(Параметры);
			МассивПараметров.Добавить(АдресРезультата);
			ЗамерПорождениеИсполнителя = ЗамерИсполнителя(Перечисления.ВидыКлючейЗамеров.ПорождениеИсполнителя);
			Задание = ФоновыеЗадания.Выполнить(Исполнитель.Метод, МассивПараметров, , Исполнитель.Наименование);
			ЗавершитьЗамер(ЗамерПорождениеИсполнителя, Распорядитель.Кэш.Таблицы.Замеры);
			ИсполнителиРаспоряжения.Вставить(Задание, АдресРезультата);
		КонецЦикла;

	КонецЕсли;

	Если Распоряжение.СжечьПослеПрочтения = Истина Тогда
		Распоряжение = Неопределено;
	КонецЕсли;

	Возврат ИсполнителиРаспоряжения;

КонецФункции

#КонецОбласти

#КонецЕсли
