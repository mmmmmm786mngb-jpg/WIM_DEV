
&НаКлиенте
Процедура ВPrelimДляПроверки(Команда)

	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите поручения в списке.");
		Возврат;
	КонецЕсли;

	Поручения = Новый Массив;
	Для Каждого СтрокаСписка Из ВыделенныеСтроки Цикл
		Поручения.Добавить(СтрокаСписка);
	КонецЦикла;

	Текст = ВPrelimДляПроверкиНаСервере(Поручения);
	Элементы.Список.Обновить();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

// Описание: Переводит выделенные поручения в статус ожидания проверки (Prelim на блоттере)
// Сбрасывает признаки исполнения и биржевой номер, иначе кнопка Проверить эти строки не берет
//
// Параметры:
//  ВыделенныеСтроки - Массив - ключи выделенных строк списка блоттера
//
// Возвращаемое значение:
//  Строка - сколько поручений переведено
//
&НаСервере
Функция ВPrelimДляПроверкиНаСервере(ВыделенныеСтроки)

	УстановитьПривилегированныйРежим(Истина);

	Ключ = АдаптерыКлиентСервер.МастерКлюч();
	Количество = 0;

	Для Каждого СтрокаСписка Из ВыделенныеСтроки Цикл

		Поручение = СтрокаСписка;
		Если ТипЗнч(Поручение) <> Тип("ДокументСсылка.Поручение") Тогда
			Продолжить;
		КонецЕсли;

		РегистрыСведений.СтатусыПоручений.УстановитьОжидаетПроверки(Поручение, Ключ);
		СброситьПризнакиИсполнения(Поручение);
		ОчиститьНомерБиржевой(Поручение);
		Количество = Количество + 1;

	КонецЦикла;

	Возврат "В Prelim переведено поручений: " + Формат(Количество, "ЧГ=0;");

КонецФункции

// Описание: Снимает признаки исполнения, чтобы статус блоттера не вернулся в Ready
//
// Параметры:
//  Поручение - ДокументСсылка.Поручение - поручение из выделенной строки
//
Процедура СброситьПризнакиИсполнения(Поручение)

	Запись = РегистрыСведений.СтатусыПоручений.СоздатьМенеджерЗаписи();
	Запись.Поручение = Поручение;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Возврат;
	КонецЕсли;

	Запись.Исполнена = Ложь;
	Запись.ИсполненоЧастично = Ложь;
	Запись.НаИсполнении = Ложь;
	Запись.Отправлено = Ложь;
	Запись.СнятОстаток = Ложь;
	Запись.СтатусРасш = Перечисления.СтатусыПорученийБлоттер.Prelim;
	Запись.Записать();

КонецПроцедуры

// Описание: Очищает биржевой номер заявки, иначе проверка отказывает из-за уже отправленного поручения
//
// Параметры:
//  Поручение - ДокументСсылка.Поручение - поручение из выделенной строки
//
Процедура ОчиститьНомерБиржевой(Поручение)

	Набор = РегистрыСведений.БиржевыеЗаявки.СоздатьНаборЗаписей();
	Набор.Отбор.Поручение.Установить(Поручение);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из Набор Цикл
		Запись.НомерБиржевой = "";
	КонецЦикла;
	Набор.Записать();

КонецПроцедуры
