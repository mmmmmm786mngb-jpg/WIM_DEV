#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#Область ПроверкаИОтправка

&ИзменениеИКонтроль("ПроверкаИОтправка_ОбработкаПроверки")
Функция FO_LimitShare_ПроверкаИОтправка_ОбработкаПроверки(Параметры, АдресРезультата = Неопределено)

	УстановитьПривилегированныйРежим(Истина);

	#Область Переменные
	Результат = ИсполнителиСлужебный.СтруктураРезультатаИсполнителей();
	ЗавершитьЗамер(Параметры.ЗамерИнициализацияИсполнителя, Результат.Таблицы.Замеры);

	Результат.Таблицы.Вставить("Замеры", ИсполнителиСлужебный.ШаблонТаблицыЗамеров());
	Результат.Таблицы.Вставить("КэшВмКраткоПоручения", РаботаСЛимитами.КэшВмКраткоПоручения());
	Результат.Соответствия.Вставить("Базисы", Новый Соответствие());

	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	Менеджер = Запрос.МенеджерВременныхТаблиц;

	Распорядитель = ФактРаспорядитель(Параметры.Распорядитель);
	Вместилище = Распорядитель.Идентификатор;
	Исполнитель = Новый УникальныйИдентификатор();
	Кэш = Распорядитель.Кэш;
	ДатаПроверки = Кэш.Параметры.ДатаПроверки;
	Шапка = РаботаСЛимитами.ШапкаИсполнителяПроверки(Вместилище, Исполнитель, Кэш.Параметры);
	РеквизитыПоручений = Кэш.Соответствия.РеквизитыПоручений;
	НекорректныеЛимиты = Кэш.Соответствия.НекорректныеЛимиты;
	СтоимостиАктивовПортфелей = Кэш.Соответствия.СтоимостиАктивовПортфелей;
	ПортфелиГрупп = Кэш.Соответствия.ПортфелиГрупп;
	НастройкиЛимитов = Кэш.Соответствия.НастройкиЛимитов;
	ДанныеПолейУсловийОтбора = Кэш.Соответствия.ДанныеПолейУсловийОтбора;
	ДанныеДеноминаций = Новый Соответствие();
	ОбъемыОблигаций = Новый Соответствие();
	ДанныеКапитализаций = Новый Соответствие();
	ПоляУсловийОтбора = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("#Т.Портфель");
	НаборДанныхТекущий = Неопределено;
#Вставка
	КэшБазисовПачки = Новый Соответствие;
	КэшРезультатовПачки = Новый Соответствие;
	КэшСуммПачки = Новый Соответствие;
#КонецВставки
	Толкования = РаботаСЛимитами.Толкования();
	ПланСырой = РегистрыСведений.КэшВмПланПроверки.ПланПроверкиИсполнителя(Вместилище, Параметры.Данные[0]);
	#КонецОбласти

	#Область ПроектВместилище
	ЗеленаяЗона = Перечисления.ЗоныПроверкиЛимитов.ПустаяСсылка();
	ЖелтаяЗона = Перечисления.ЗоныПроверкиЛимитов.Желтая;
	КраснаяЗона = Перечисления.ЗоныПроверкиЛимитов.Красная;

	Зоны = Новый Соответствие();
	Зоны.Вставить(0, ЗеленаяЗона); Зоны.Вставить(1, ЖелтаяЗона); Зоны.Вставить(2, КраснаяЗона);

	ЗоныЧислом = Новый Соответствие();
	ЗоныЧислом.Вставить(ЗеленаяЗона, 0); ЗоныЧислом.Вставить(ЖелтаяЗона, 1); ЗоныЧислом.Вставить(КраснаяЗона, 2);

	Кэш.Вставить("ЖелтаяЗона", ЖелтаяЗона);
	Кэш.Вставить("КраснаяЗона", КраснаяЗона);
	Кэш.Вставить("Зоны", Зоны);
	Кэш.Вставить("ЗоныЧислом", ЗоныЧислом);

	КэшВмДетальноШаблон = КэшВмДетальноШаблон();
	КэшВмКраткоШаблон = КэшВмКраткоШаблон();
	КэшВмКраткоЭмитентыШаблон = КэшВмКраткоЭмитентыШаблон();

	КэшВм = Новый Структура();
	КэшВм.Вставить("Кратко", КэшВмКраткоШаблон(Истина));
	КэшВм.Вставить("КраткоЭмитенты", КэшВмКраткоЭмитентыШаблон.Скопировать());
	КэшВм.Вставить("Детально", КэшВмДетальноШаблон.Скопировать());
	КэшВм.Вставить("Счетчик", РаботаСЛимитами.СчетчикВм(Шапка, Распорядитель.Вес));
	КэшВм.Вставить("Шапка", Шапка);
	КэшВм.Вставить("Замеры");

	Окружение = РаботаСЛимитами.Окружение(Менеджер, Вместилище);
	Окружение.ОписанияНаборов = Кэш.Соответствия.ОписанияНаборов;
	Окружение.РеквизитыНаборов = Кэш.Соответствия.РеквизитыНаборовДанных;
	Окружение.ДанныеНаборов = Кэш.Соответствия.ДанныеНаборовДанных;
	#КонецОбласти

	#Область _
	Лимиты = Новый Массив();
	Необходимое = Новый Структура("РеквизитыПоручений, НекорректныеЛимиты", РеквизитыПоручений, НекорректныеЛимиты);
	ПланВнутренниеВнешние = РаботаСЛимитами.ОбработатьПланПредварительно(ПланСырой, КэшВм, Необходимое);
	ПланВнутренние = РаботаСЛимитами.ОбработатьПланПоВнешнимЛимитам(ПланВнутренниеВнешние, КэшВм, Кэш, Ложь);
	ПланВнутренниеПоЛимитам = РаботаСЛимитами.ПланВнутренниеПоЛимитам(ПланВнутренние, Лимиты);

	ВидыБазисовЛимитов = ИсполнителиПолныеПрава.ВидыБазисовЛимитов(Лимиты);
	ВеличиныОттока = ИсполнителиПолныеПрава.ВеличиныОттокаПаев(Кэш.Массивы.Портфели, Шапка.ДатаФактПозиции);
	ГарантийныеОбеспечения = ИсполнителиПолныеПрава.ГарантийныеОбеспечения(Кэш.Массивы.Портфели, Шапка.ДатаФактПозиции);
	#КонецОбласти

	#Область ПоляУсловийОтбора
	Для Каждого Лимит Из Лимиты Цикл
		Если ДанныеПолейУсловийОтбора[Лимит] <> Неопределено Тогда
			ДополнитьМассив(ПоляУсловийОтбора, ДанныеПолейУсловийОтбора[Лимит].ПоляУсловийОтбора);
		КонецЕсли;
	КонецЦикла;
	ПоляУсловийОтбора = СвернутьМассив(ПоляУсловийОтбора);
	#КонецОбласти

	Для Каждого Лимит Из Лимиты Цикл
		ПараметрыИсх = НастройкиЛимитов[Лимит];
		Если ПараметрыИсх = Неопределено Тогда
			// Для внешних лимитов настройки могут отсутствовать в кэше
			// Пропускаем такие лимиты, так как они обрабатываются отдельно
			Продолжить;
		КонецЕсли;
		НаборДанных = ПараметрыИсх.НаборДанныхДляПроверкиЛимитов;

		ПараметрыИсх.Вставить("СведенияОПорогах", Неопределено);
		Если ПараметрыИсх.ВидЛимита = Перечисления.ВидыЛимитов.Структура Тогда
			Вариант = ПараметрыИсх.ВариантПроверкиПорога;
			ПараметрыИсх.ВариантПроверкиПорога = ПроверкаЛимитовПовтИсп.ПараметрыВариантаПроверкиПорога(Вариант, ДатаПроверки);
			ПараметрыИсх.ВариантПроверкиПорога.Вставить("ИспользоватьПорогиПоручения", Кэш.Параметры.ЭтоПретрейд);
			ПараметрыИсх.СведенияОПорогах = РегистрыСведений.КэшВмПороги.СведенияОПорогах(Лимит, Вместилище);
		КонецЕсли;

		РеквизитыНабора = Окружение.РеквизитыНаборов[НаборДанных];
		ОписаниеНабора = РаботаСЛимитами.ОписаниеНабораОкружения(Окружение, НаборДанных);
		ИсточникПоручение = РеквизитыНабора.ВидИсточникаДанных = Перечисления.ВидыОсновныхИсточниковДанных.Поручение;

		ПараметрыИсх.Вставить("РеквизитыНабораДанных", РеквизитыНабора);
		ПараметрыИсх.Вставить("Лимит", Лимит);
		ПараметрыИсх.Вставить("Вместилище", Шапка.Вместилище);
		ПараметрыИсх.Вставить("ДатаПроверки", Шапка.ДатаПроверки);
		ПараметрыИсх.Вставить("ДатаФактПозиции", Шапка.ДатаФактПозиции);
		ПараметрыИсх.Вставить("ИспользоватьДатуАктуальности", Шапка.ИспользоватьДатуАктуальности);
		ПараметрыИсх.Вставить("ВремяВыполнения", ТекущаяДатаСеанса());
		ПараметрыИсх.Вставить("ЗамерЗатраты_а83", ТекущаяУниверсальнаяДатаВМиллисекундах());
		ПараметрыИсх.Вставить("ДатаОграниченияПлановойПозиции", Кэш.Параметры.ДатаОграниченияПлановойПозиции);
		ПараметрыИсх.Вставить("ВыводитьПредупрежденияПриПретрейде", Кэш.Параметры.ВыводитьПредупрежденияПриПретрейде);
		ПараметрыИсх.Вставить("ИспользоватьПорогиПоручения", Кэш.Параметры.ЭтоПретрейд);
		ПараметрыИсх.Вставить("ЭтоПретрейд", Кэш.Параметры.ЭтоПретрейд);
		ПараметрыИсх.Вставить("ВидЛимитаБенефициара", ПараметрыИсх.ВидЛимита);
		ПараметрыИсх.Вставить("ВидыБазисовЛимита", ВидыБазисовЛимитов[Лимит]);
		ПараметрыИсх.Вставить("ОбъектыПроверкиПоручения", Неопределено);
		ПараметрыИсх.Вставить("Базисы", Результат.Соответствия.Базисы);
		ПараметрыИсх.Вставить("Кэш", Кэш);

		#Область ТекущийНабор
		Если НаборДанных <> НаборДанныхТекущий Тогда
			Если НаборДанныхТекущий <> Неопределено Тогда
				РаботаСЛимитами.УдалитьВременныеТаблицы(Запрос, Толкования.ОсновныеТаблицы);
			КонецЕсли;

			ДанныеНабора = Окружение.ДанныеНаборов[НаборДанных];
			Если ТипЗнч(ДанныеНабора) = Тип("ХранилищеЗначения") Тогда
				ДанныеНабора = ДанныеНабора.Получить();
				Окружение.ДанныеНаборов.Вставить(НаборДанных, ДанныеНабора);
			КонецЕсли;

			ТаблицаОшибокРепрайсинга = ДанныеНабора.ТаблицаОшибокРепрайсинга;
			Если Не ЗначениеЗаполнено(ТаблицаОшибокРепрайсинга) Тогда
				ТаблицаОшибокРепрайсинга = Новый ТаблицаЗначений();
				ТаблицаОшибокРепрайсинга.Колонки.Добавить("Актив", Новый ОписаниеТипов("СправочникСсылка.Активы"));
			КонецЕсли;
			ЕстьОшибкиРепрайсинга = ТаблицаОшибокРепрайсинга.Количество() > 0;

			Если ИсточникПоручение Тогда
				УсловияОтбораКонтекста = "#Т.Поручение В (&Поручение_b481) И #Т.Портфель В (&Портфели_b481)";

				КэшТаблицаНабора = ДанныеНабора.ОбъединеннаяТаблицаЗначений;
				МассивПолейВыборки = ИсполнителиСлужебный.МассивПолейВыборки(КэшТаблицаНабора.Колонки);
				ВыборкаПолей = ИсполнителиСлужебный.ВыборкаПолей(МассивПолейВыборки);
				ВыборкаПолейТекущая = ИсполнителиСлужебный.ЗадатьИмяИсточника(ВыборкаПолей, "Т");
				ВыборкаИндексов = ВыборкаИндексов(ПоляУсловийОтбора, КэшТаблицаНабора.Колонки);
				ВыборкаИндексовТекущая = ИсполнителиСлужебный.ЗадатьИмяИсточника(ВыборкаИндексов, "Т");

				Запрос.Текст = ТекстЗапросаПомещенияДанныхНаборов();
				Запрос.УстановитьПараметр("ОбъединеннаяТаблицаЗначений", КэшТаблицаНабора);
				Запрос.УстановитьПараметр("ТаблицаОшибокРепрайсинга", ТаблицаОшибокРепрайсинга);
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыборкаПолей", ВыборкаПолейТекущая);
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыборкаИндексов", ВыборкаИндексовТекущая);
				Запрос.Выполнить(); //@skip-check query-in-loop

			Иначе
				УсловияОтбораКонтекста = "#Т.Портфель В (&Портфели_b481)";

				Секрет = ДанныеНабора.Секрет;
				Секрет = РаботаСЛимитами.Секрет(Секрет.Дата, Секрет.РеквизитыНабора, Секрет.БиржиКотировок, Вместилище);
				Если Менеджер.Таблицы.Найти("ВТ_ТаблицаНабораДанных" + ОписаниеНабора.КлючНабора) = Неопределено Тогда
					КэшТаблицаНабора = РегистрыСведений.КэшВмПозиция.СоздатьНаборЗаписей().Выгрузить();
					ВыборкаИндексов = ВыборкаИндексов(ПоляУсловийОтбора, КэшТаблицаНабора.Колонки);
					ВыборкаИндексовТекущая = ИсполнителиСлужебный.ЗадатьИмяИсточника(ВыборкаИндексов, "Т");
					РаботаСЛимитами.ДобавитьВТ_ТаблицаНабораДанных(Секрет, Менеджер, ВыборкаИндексовТекущая);
				КонецЕсли;

				Запрос.Текст =
				"ВЫБРАТЬ
				|	Т.Актив КАК Актив,
				|	ИСТИНА КАК Отказ
				|ПОМЕСТИТЬ ВТ_ТаблицаОшибокРепрайсинга
				|ИЗ
				|	&ТаблицаОшибокРепрайсинга КАК Т
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	Т.Актив";
				Запрос.УстановитьПараметр("ТаблицаОшибокРепрайсинга", ТаблицаОшибокРепрайсинга);
				Запрос.Выполнить(); //@skip-check query-in-loop

				ДанныеДеноминаций.Вставить(НаборДанных, РаботаСЛимитами.ДанныеДеноминации(Секрет, Менеджер));
				ДанныеКапитализаций.Вставить(НаборДанных, РаботаСЛимитами.ДанныеКапитализации(Секрет));
				ОбъемыОблигаций.Вставить(НаборДанных, РаботаСЛимитами.ОбъемыОблигаций(Секрет));
			КонецЕсли;

			ИмяВТНабора = "ВТ_ТаблицаНабораДанных" + ?(ИсточникПоручение, "", ОписаниеНабора.КлючНабора);
			Кэш.Соответствия.Вставить("ВхожденияВРаскрытие",
				ПроверкаЛимитов.ВхожденияВРаскрытие(Запрос, ИмяВТНабора, ДанныеНабора.ЕстьРаскрытие));

			НаборДанныхТекущий = НаборДанных;
		КонецЕсли;
		#КонецОбласти

		Для Каждого ПоГруппеПортфелей Из ПланВнутренниеПоЛимитам[Лимит] Цикл
			ПорцияДанных = ПоГруппеПортфелей.Значение;

			#Область УсловияОтбора
			УсловияОтбораПоМодификатору = УсловияОтбораПоМодификатору(ПараметрыИсх);
			УсловияОтбора = ?(УсловияОтбораПоМодификатору <> "", УсловияОтбораПоМодификатору, ПараметрыИсх.УсловияОтбораОсновные);
			УсловияОтбора = УсловияОтбораКонтекста + ?(ЗначениеЗаполнено(УсловияОтбора), " И ", "") + УсловияОтбора;
			#КонецОбласти

			ПараметрыИсх.Вставить("Исполнитель", Новый УникальныйИдентификатор());
			ПараметрыИсх.Вставить("УсловияОтбора", УсловияОтбора);
			ПараметрыИсх.Вставить("ВыборкаПолей", ВыборкаПолей);
			ПараметрыИсх.Вставить("УсловияОтбораКонтекста", УсловияОтбораКонтекста);
			ПараметрыИсх.Вставить("ИмяОсновнойТаблицы", "ВТ_ТаблицаНабораДанных" + ?(ИсточникПоручение, "", ОписаниеНабора.КлючНабора));

			ПортфелиПорции = Новый Массив();
			ПорученияПорции = Новый Массив();
			БазисыПорции = Новый Соответствие();
			ПорученияПортфелиПорции = ПорученияПортфелиПорцииШаблон();

			Для Каждого Строка Из ПорцияДанных Цикл
				#Область ПортфелиИГруппы
				Фокус = Строка.Фокус;
				ПортфелиГруппы = ЗначениеВМассиве(Фокус);
				Если Строка.ПоГруппе Тогда
					ПортфелиГруппы = ПортфелиГрупп[Фокус];
				КонецЕсли;
				ДополнитьМассив(ПортфелиПорции, ПортфелиГруппы, Истина);

				ПорученияПорции.Добавить(Строка.Поручение);
				Для Каждого ПортфельГруппы Из ПортфелиГруппы Цикл
					СтрокаВсп = ПорученияПортфелиПорции.Добавить();
					СтрокаВсп.Поручение = Строка.Поручение;
					СтрокаВсп.ГруппаПортфелей = Фокус;
					СтрокаВсп.Портфель = ПортфельГруппы;
					СтрокаВсп.Фокус = Фокус;
				КонецЦикла;
				#КонецОбласти

				#Область Базисы
#Вставка
				КлючБазисаПачки = FO_LimitShare_КлючБазиса(НаборДанныхТекущий, Фокус, ПараметрыИсх);
				СохраненныйБазис = КэшБазисовПачки.Получить(КлючБазисаПачки);
				Если СохраненныйБазис <> Неопределено Тогда
					БазисыПорции.Вставить(Фокус, FO_LimitShare_КопияСтруктуры(СохраненныйБазис));
					Продолжить;
				КонецЕсли;
#КонецВставки
				Запрос.УстановитьПараметр("Портфели_b481", ПортфелиГруппы);
				Базис = СтоимостиАктивовПортфелей[НаборДанныхТекущий][Фокус];
				Если ПараметрыИсх.ВидЛимита = Перечисления.ВидыЛимитов.Структура Тогда
					ВидыБазисов = Перечисления.ВидыБазисовДляПроверкиЛимитов;
					Базис = ?(Базис <> Неопределено, Базис, ИсполнителиСлужебный.ПустаяОсноваБазисов());
					Для Каждого КлючЗначение Из ПараметрыИсх.ВидыБазисовЛимита Цикл
						Базис.Вставить(КлючЗначение.Ключ, 0);
					КонецЦикла;

					Добавляемые = ПроверкаЛимитовСлужебный.БазисыОтАктивов(Запрос, ПараметрыИсх);
					Если ЗначениеЗаполнено(Добавляемые) Тогда
						ЗаполнитьЗначенияСвойств(Базис, Добавляемые);
					КонецЕсли;

					Если ПараметрыИсх.ВидыБазисовЛимита.Свойство(XMLСтрока(ВидыБазисов.РыночнаяСтоимость)) Тогда
						РыночнаяСтоимость = РаботаСЛимитами.РыночнаяСтоимость(Запрос, ПараметрыИсх);
						ЗаполнитьЗначенияСвойств(Базис, РыночнаяСтоимость);
					КонецЕсли;

					Если ПараметрыИсх.ВидыБазисовЛимита.Свойство(XMLСтрока(ВидыБазисов.ОбъемОблигацийЭмитентаВОбращении)) Тогда
						Добавляемые = ОбъемыОблигаций[НаборДанныхТекущий];
						Если ЗначениеЗаполнено(Добавляемые) Тогда
							ЗаполнитьЗначенияСвойств(Базис, Добавляемые);
						КонецЕсли;
					КонецЕсли;

					Если ПараметрыИсх.ВидыБазисовЛимита.Свойство(XMLСтрока(ВидыБазисов.УниверсальныйДеноминатор)) Тогда
						Добавляемые = ДанныеДеноминаций[НаборДанныхТекущий][Фокус];
						Если ЗначениеЗаполнено(Добавляемые) Тогда
							ЗаполнитьЗначенияСвойств(Базис, Добавляемые);
						КонецЕсли;
					КонецЕсли;

					Если ПараметрыИсх.ВидыБазисовЛимита.Свойство(XMLСтрока(ВидыБазисов.КапитализацияЭмитентов)) Тогда
						Добавляемые = ДанныеКапитализаций[НаборДанныхТекущий];
						Если ЗначениеЗаполнено(Добавляемые) Тогда
							ЗаполнитьЗначенияСвойств(Базис, Добавляемые);
						КонецЕсли;
					КонецЕсли;

					Если ПараметрыИсх.ВидыБазисовЛимита.Свойство(XMLСтрока(ВидыБазисов.ВеличинаОттока)) Тогда
						Добавляемые = ВеличиныОттока[Фокус];
						Если ЗначениеЗаполнено(Добавляемые) Тогда
							ЗаполнитьЗначенияСвойств(Базис, Добавляемые);
						КонецЕсли;
					КонецЕсли;

					Если ПараметрыИсх.ВидыБазисовЛимита.Свойство(XMLСтрока(ВидыБазисов.ГарантийноеОбеспечение)) Тогда
						ТаблицаЗначений = ГарантийныеОбеспечения.СкопироватьКолонки();
						Для Каждого СтрокаИзОбщихДанных Из ГарантийныеОбеспечения Цикл
							Если ПортфелиГруппы.Найти(СтрокаИзОбщихДанных.Портфель) <> Неопределено Тогда
								СтрокаНовая = ТаблицаЗначений.Добавить();
								ЗаполнитьЗначенияСвойств(СтрокаНовая, СтрокаИзОбщихДанных);
							КонецЕсли;
						КонецЦикла;
						Добавляемые = Новый Структура(XMLСтрока(ВидыБазисов.ГарантийноеОбеспечение), ТаблицаЗначений);
						ЗаполнитьЗначенияСвойств(Базис, Добавляемые);
					КонецЕсли;
				КонецЕсли;
#Вставка
				Если FO_LimitShare_МожноКэшироватьБазис(ПараметрыИсх, ИсточникПоручение)
					И ТипЗнч(Базис) = Тип("Структура") Тогда
					КэшБазисовПачки.Вставить(КлючБазисаПачки, FO_LimitShare_КопияСтруктуры(Базис));
				КонецЕсли;
#КонецВставки
				БазисыПорции.Вставить(Фокус, Базис);
				#КонецОбласти
			КонецЦикла;

			//@skip-check query-in-loop
			Если ПараметрыИсх.ИспользоватьПулДанныхИзМодификатора И ЗначениеЗаполнено(ПараметрыИсх.Модификатор) Тогда
				ПараметрыЗапросаМодификатора = СобратьПараметрыЗапросаСМодификатора(ПараметрыИсх.Модификатор);
				ЗаполнитьПараметрыЗапроса(Запрос, ПараметрыЗапросаМодификатора, КлючЗапроса().Основного);
				ЗаполнитьПараметрыЗапроса(Запрос, ПараметрыИсх.ПараметрыЗапросов, КлючЗапроса().Квалификатора);

			Иначе
				ЗаполнитьПараметрыЗапроса(Запрос, ПараметрыИсх.ПараметрыЗапросов);

			КонецЕсли;

			Запрос.УстановитьПараметр("Портфели_b481", ПортфелиПорции);
			Запрос.УстановитьПараметр("Поручение_b481", ПорученияПорции);
			Запрос.УстановитьПараметр("ПустаяСтрока", "");
			Запрос.УстановитьПараметр("ПоручениеПустаяСсылка", Документы.Поручение.ПустаяСсылка());
			Запрос.УстановитьПараметр("Вместилище", Вместилище);
			Запрос.УстановитьПараметр("Исполнитель", ПараметрыИсх.Исполнитель);
			Запрос.УстановитьПараметр("ПорученияПортфелиПорции", ПорученияПортфелиПорции);
			Запрос.УстановитьПараметр("ЗеленаяЗона", ЗеленаяЗона);
			Запрос.УстановитьПараметр("ЖелтаяЗона", ЖелтаяЗона);
			Запрос.УстановитьПараметр("КраснаяЗона", КраснаяЗона);

			ПараметрыИсх.Вставить("ИмяОсновнойТаблицы", "ВТ_ТаблицаНабораДанных" + ?(ИсточникПоручение, "", ОписаниеНабора.КлючНабора));
			ПараметрыИсх.Вставить("ЕстьОшибкиРепрайсинга", ЕстьОшибкиРепрайсинга);
			ПараметрыИсх.Вставить("СписокПортфелей", ПортфелиПорции);
			ПараметрыИсх.Вставить("НаборДанныхТекущий", НаборДанныхТекущий);
			ПараметрыИсх.Вставить("КэшВмКратко", КэшВмКраткоШаблон.Скопировать());
			ПараметрыИсх.Вставить("КэшВмКраткоЭмитенты", КэшВмКраткоЭмитентыШаблон.Скопировать());
			ПараметрыИсх.Вставить("КэшВмДетально", КэшВмДетальноШаблон.Скопировать());
			ПараметрыИсх.Вставить("БазисыПорции", БазисыПорции);
			ПараметрыИсх.Вставить("ЗамерНачало_а83", ТекущаяУниверсальнаяДатаВМиллисекундах());

#Вставка
			БыстрыйСтруктурный = FO_LimitShare_ЭтоБыстрыйСтруктурный(ПараметрыИсх, ИсточникПоручение);
			Если Не БыстрыйСтруктурный Тогда
				КлючПроверкиПачки = FO_LimitShare_КлючПроверки(ПараметрыИсх, ПорцияДанных, НаборДанныхТекущий);
				ГотовыйРезультат = КэшРезультатовПачки.Получить(КлючПроверкиПачки);
			Иначе
				КлючПроверкиПачки = "";
				ГотовыйРезультат = Неопределено;
			КонецЕсли;
#КонецВставки
			Попытка
				ЗамерПроверкиЛимита = ЗамерИсполнителя(Перечисления.ВидыКлючейЗамеров.ПроверкаЛимита, Лимит);
				Окружение.ТекущийУровеньВложенности = 0;
#Удаление
				ПроверкаЛимитов.Проверить(Запрос, ПараметрыИсх, Окружение);
#КонецУдаления
#Вставка
				Если БыстрыйСтруктурный И FO_LimitShare_ЗаполнитьСтруктурныйРезультат(Запрос, ПараметрыИсх, ПорцияДанных, КэшСуммПачки, Вместилище) Тогда
					// Суммы одного набора уже посчитаны, порог лимита применяется отдельно.
				ИначеЕсли ГотовыйРезультат = Неопределено Тогда
					ПроверкаЛимитов.Проверить(Запрос, ПараметрыИсх, Окружение);
					FO_LimitShare_ЗапомнитьРезультат(КэшРезультатовПачки, КлючПроверкиПачки, ПараметрыИсх);
				Иначе
					FO_LimitShare_ПодставитьРезультат(ПараметрыИсх, ГотовыйРезультат);
				КонецЕсли;
#КонецВставки

			Исключение
				Описание = ОписаниеОшибки();
				ПараметрыИсх.КэшВмКратко.Очистить();
				ПараметрыИсх.КэшВмКраткоЭмитенты.Очистить();
				ПараметрыИсх.КэшВмДетально.Очистить();

				Для Каждого Строка Из ПорцияДанных Цикл
					СтрокаКратко = РаботаСЛимитами.ДополнитьОтказом(ПараметрыИсх.КэшВмКратко, Вместилище, Описание);
					СтрокаКратко.Исполнитель = ПараметрыИсх.Исполнитель;
					ЗаполнитьЗначенияСвойств(СтрокаКратко, Строка);
				КонецЦикла;

			КонецПопытки;

			Если Шапка.ПроверкаПоручений Тогда
				Колонки = "Поручение, Лимит, Зона, Отказ";
				ТаблицаЗначений = ПараметрыИсх.КэшВмКратко.Скопировать(, Колонки); ТаблицаЗначений.Свернуть(Колонки);
				ДополнитьТаблицу(Результат.Таблицы.КэшВмКраткоПоручения, ТаблицаЗначений);
			КонецЕсли;

			РаботаСЛимитами.ЗаписатьПорциюРезультатов(ПараметрыИсх);
			РаботаСЛимитами.УдалитьВременныеТаблицыСлужебные(Менеджер);
			РаботаСЛимитами.ОбработатьСчетчик(КэшВм.Счетчик, ПорцияДанных.Количество());
			ЗавершитьЗамер(ЗамерПроверкиЛимита, Результат.Таблицы.Замеры);
		КонецЦикла;

		НастройкиЛимитов[Лимит] = Неопределено;
	КонецЦикла;

	ВыполнитьЗаписьРезультатовПроверки(КэшВм, Результат, Шапка, Вместилище, Исполнитель);
	ПодготовитьЗавершение(Результат);

	Возврат Результат(Результат, АдресРезультата);

КонецФункции

#КонецОбласти

#КонецОбласти


#Область FO_LimitShare

// Описание: Ключ повторного использования базиса одного набора и фокуса
//
// Параметры:
//  НаборДанных - СправочникСсылка.НаборыДанныхДляПроверкиЛимитов - текущий набор
//  Фокус - СправочникСсылка.Портфели - портфель или группа порции
//  ПараметрыИсх - Структура - параметры лимита
//
// Возвращаемое значение:
//  Строка - ключ кэша
//
Функция FO_LimitShare_КлючБазиса(НаборДанных, Фокус, ПараметрыИсх)

    КлючиВидов = "";
    Если ПараметрыИсх.Свойство("ВидыБазисовЛимита") И ТипЗнч(ПараметрыИсх.ВидыБазисовЛимита) = Тип("Структура") Тогда
        Для Каждого КлючЗначение Из ПараметрыИсх.ВидыБазисовЛимита Цикл
            КлючиВидов = КлючиВидов + КлючЗначение.Ключ + ";";
        КонецЦикла;
    КонецЕсли;

    Возврат Строка(НаборДанных.УникальныйИдентификатор()) + "|" + Строка(Фокус.УникальныйИдентификатор()) + "|" + КлючиВидов;

КонецФункции

// Описание: Базис кэшируется только у структурных лимитов пост-контроля
//
// Параметры:
//  ПараметрыИсх - Структура - параметры лимита
//  ИсточникПоручение - Булево - источник набора это поручение
//
// Возвращаемое значение:
//  Булево - Истина, если базис можно сохранить
//
Функция FO_LimitShare_МожноКэшироватьБазис(ПараметрыИсх, ИсточникПоручение)

    Если ИсточникПоручение Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат ПараметрыИсх.ВидЛимита = Перечисления.ВидыЛимитов.Структура;

КонецФункции

// Описание: Копия структуры базиса, таблицы значений копируются отдельно
//
// Параметры:
//  Источник - Структура - исходный базис
//
// Возвращаемое значение:
//  Структура - независимая копия
//
Функция FO_LimitShare_КопияСтруктуры(Источник)

    Копия = Новый Структура;
    Для Каждого КлючЗначение Из Источник Цикл
        Значение = КлючЗначение.Значение;
        Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
            Значение = Значение.Скопировать();
        КонецЕсли;
        Копия.Вставить(КлючЗначение.Ключ, Значение);
    КонецЦикла;

    Возврат Копия;

КонецФункции

// Описание: Ключ одинаковой проверки: условия, пороги и состав порции без ссылки на лимит
//
// Параметры:
//  ПараметрыИсх - Структура - параметры лимита
//  ПорцияДанных - ТаблицаЗначений - строки порции
//  НаборДанных - СправочникСсылка.НаборыДанныхДляПроверкиЛимитов - текущий набор
//
// Возвращаемое значение:
//  Строка - ключ кэша результата
//
Функция FO_LimitShare_КлючПроверки(ПараметрыИсх, ПорцияДанных, НаборДанных)

    Части = Новый Массив;
    Части.Добавить(XMLСтрока(ПараметрыИсх.ВидЛимита));
    Части.Добавить(Строка(НаборДанных.УникальныйИдентификатор()));
    Части.Добавить(ПараметрыИсх.УсловияОтбора);
    Если ПараметрыИсх.Свойство("ВариантПроверкиПорога") И ТипЗнч(ПараметрыИсх.ВариантПроверкиПорога) = Тип("Структура") Тогда
        Если ПараметрыИсх.ВариантПроверкиПорога.Свойство("Вариант") И ЗначениеЗаполнено(ПараметрыИсх.ВариантПроверкиПорога.Вариант) Тогда
            Части.Добавить(XMLСтрока(ПараметрыИсх.ВариантПроверкиПорога.Вариант));
        КонецЕсли;
    КонецЕсли;
    Части.Добавить(FO_LimitShare_ОтпечатокПорогов(ПараметрыИсх.Лимит));
    Для Каждого СтрокаПорции Из ПорцияДанных Цикл
        Части.Добавить(Строка(СтрокаПорции.Фокус.УникальныйИдентификатор()));
        Если ЗначениеЗаполнено(СтрокаПорции.Поручение) Тогда
            Части.Добавить(Строка(СтрокаПорции.Поручение.УникальныйИдентификатор()));
        КонецЕсли;
    КонецЦикла;

    Возврат СтрСоединить(Части, "|");

КонецФункции

// Описание: Числовые пороги лимита, чтобы лимиты с разными порогами не делили один результат
//
// Параметры:
//  Лимит - СправочникСсылка.Лимиты - лимит порции
//
// Возвращаемое значение:
//  Строка - отпечаток порогов
//
Функция FO_LimitShare_ОтпечатокПорогов(Лимит)

    ЗапросПорогов = Новый Запрос;
    ЗапросПорогов.Текст =
    "ВЫБРАТЬ
    |	Пороги.Портфель КАК Портфель,
    |	Строки.НомерСтроки КАК НомерСтроки,
    |	Строки.МинДоляЖелтаяЗона КАК МинДоляЖелтаяЗона,
    |	Строки.МаксДоляЖелтаяЗона КАК МаксДоляЖелтаяЗона,
    |	Строки.МинДоляКраснаяЗона КАК МинДоляКраснаяЗона,
    |	Строки.МаксДоляКраснаяЗона КАК МаксДоляКраснаяЗона,
    |	Строки.МинДоляПоручение КАК МинДоляПоручение,
    |	Строки.МаксДоляПоручение КАК МаксДоляПоручение
    |ИЗ
    |	РегистрСведений.ПорогиЛимитов.СрезПоследних(, Лимит = &Лимит) КАК Пороги
    |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиПороговДляПроверкиЛимитов.СложныеПороги КАК Строки
    |		ПО Пороги.НастройкаПороговДляПроверкиЛимитов = Строки.Ссылка
    |УПОРЯДОЧИТЬ ПО
    |	Портфель,
    |	НомерСтроки";
    ЗапросПорогов.УстановитьПараметр("Лимит", Лимит);
    Выборка = ЗапросПорогов.Выполнить().Выбрать();
    Части = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Части.Добавить(Строка(Выборка.Портфель) + ":"
            + Строка(Выборка.МинДоляЖелтаяЗона) + ":"
            + Строка(Выборка.МаксДоляЖелтаяЗона) + ":"
            + Строка(Выборка.МинДоляКраснаяЗона) + ":"
            + Строка(Выборка.МаксДоляКраснаяЗона) + ":"
            + Строка(Выборка.МинДоляПоручение) + ":"
            + Строка(Выборка.МаксДоляПоручение));
    КонецЦикла;

    Возврат СтрСоединить(Части, ";");

КонецФункции

// Описание: Сохраняет таблицы результата проверки для лимитов с тем же ключом
//
// Параметры:
//  Кэш - Соответствие - кэш результатов порции
//  Ключ - Строка - ключ проверки
//  ПараметрыИсх - Структура - заполненные таблицы результата
//
Процедура FO_LimitShare_ЗапомнитьРезультат(Кэш, Ключ, ПараметрыИсх)

    Пакет = Новый Структура;
    Пакет.Вставить("Кратко", ПараметрыИсх.КэшВмКратко.Скопировать());
    Пакет.Вставить("Эмитенты", ПараметрыИсх.КэшВмКраткоЭмитенты.Скопировать());
    Пакет.Вставить("Детально", ПараметрыИсх.КэшВмДетально.Скопировать());
    Кэш.Вставить(Ключ, Пакет);

КонецПроцедуры

// Описание: Подставляет сохраненный результат и меняет лимит и идентификаторы
//
// Параметры:
//  ПараметрыИсх - Структура - параметры текущей порции
//  ГотовыйРезультат - Структура - таблицы ранее проверенного лимита
//
Процедура FO_LimitShare_ПодставитьРезультат(ПараметрыИсх, ГотовыйРезультат)

    СоответствиеИдентификаторов = Новый Соответствие;
    ПараметрыИсх.КэшВмКратко = FO_LimitShare_КлонТаблицы(
        ГотовыйРезультат.Кратко, ПараметрыИсх.Лимит, ПараметрыИсх.Исполнитель, СоответствиеИдентификаторов);
    ПараметрыИсх.КэшВмКраткоЭмитенты = FO_LimitShare_КлонТаблицы(
        ГотовыйРезультат.Эмитенты, ПараметрыИсх.Лимит, ПараметрыИсх.Исполнитель, СоответствиеИдентификаторов);
    ПараметрыИсх.КэшВмДетально = FO_LimitShare_КлонТаблицы(
        ГотовыйРезультат.Детально, ПараметрыИсх.Лимит, ПараметрыИсх.Исполнитель, СоответствиеИдентификаторов);

КонецПроцедуры

// Описание: Копия таблицы результата с новым лимитом и новыми идентификаторами
//
// Параметры:
//  Таблица - ТаблицаЗначений - исходные строки
//  Лимит - СправочникСсылка.Лимиты - лимит, которому принадлежит копия
//  Исполнитель - УникальныйИдентификатор - исполнитель текущей порции
//  СоответствиеИдентификаторов - Соответствие - старый идентификатор и новый
//
// Возвращаемое значение:
//  ТаблицаЗначений - копия
//
Функция FO_LimitShare_КлонТаблицы(Таблица, Лимит, Исполнитель, СоответствиеИдентификаторов)

    Копия = Таблица.Скопировать();
    ЕстьЛимит = Копия.Колонки.Найти("Лимит") <> Неопределено;
    ЕстьОписание = Копия.Колонки.Найти("Описание") <> Неопределено;
    ЕстьИдентификатор = Копия.Колонки.Найти("Идентификатор") <> Неопределено;
    ЕстьИсполнитель = Копия.Колонки.Найти("Исполнитель") <> Неопределено;
    ИсходныйЛимит = Неопределено;
    Если ЕстьЛимит И Копия.Количество() > 0 Тогда
        ИсходныйЛимит = Копия[0].Лимит;
    КонецЕсли;
    Для Каждого СтрокаКопии Из Копия Цикл
        Если ЕстьИдентификатор Тогда
            НовыйИдентификатор = СоответствиеИдентификаторов.Получить(СтрокаКопии.Идентификатор);
            Если НовыйИдентификатор = Неопределено Тогда
                НовыйИдентификатор = Новый УникальныйИдентификатор;
                СоответствиеИдентификаторов.Вставить(СтрокаКопии.Идентификатор, НовыйИдентификатор);
            КонецЕсли;
            СтрокаКопии.Идентификатор = НовыйИдентификатор;
        КонецЕсли;
        Если ЕстьИсполнитель Тогда
            СтрокаКопии.Исполнитель = Исполнитель;
        КонецЕсли;
        Если ЕстьЛимит Тогда
            СтрокаКопии.Лимит = Лимит;
        КонецЕсли;
        Если ЕстьОписание И ИсходныйЛимит <> Неопределено И ТипЗнч(СтрокаКопии.Описание) = Тип("Строка") Тогда
            СтрокаКопии.Описание = СтрЗаменить(СтрокаКопии.Описание, Строка(ИсходныйЛимит), Строка(Лимит));
        КонецЕсли;
    КонецЦикла;

    Возврат Копия;

КонецФункции

// Описание: Структурный лимит процента от РСА без модификатора считается по суммам набора
//
// Параметры:
//  ПараметрыИсх - Структура - параметры лимита
//  ИсточникПоручение - Булево - источник набора это поручение
//
// Возвращаемое значение:
//  Булево - Истина, если лимит можно посчитать без повторного прохода проверки
//
Функция FO_LimitShare_ЭтоБыстрыйСтруктурный(ПараметрыИсх, ИсточникПоручение)

	Если ИсточникПоручение Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПараметрыИсх.ВидЛимита <> Перечисления.ВидыЛимитов.Структура Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПараметрыИсх.Свойство("ИспользоватьПулДанныхИзМодификатора")
		И ПараметрыИсх.ИспользоватьПулДанныхИзМодификатора Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПараметрыИсх.Свойство("ВариантПроверкиПорога")
		Или ТипЗнч(ПараметрыИсх.ВариантПроверкиПорога) <> Тип("Структура")
		Или Не ПараметрыИсх.ВариантПроверкиПорога.Свойство("Вариант") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПараметрыИсх.ВариантПроверкиПорога.Вариант = Перечисления.ВариантыПроверкиПороговЛимитов.ПроцентОтРСА;

КонецФункции

// Описание: Заполняет краткий результат структурного лимита по уже прочитанному набору
//
// Параметры:
//  Запрос - Запрос - запрос порции с временными таблицами набора
//  ПараметрыИсх - Структура - параметры лимита
//  ПорцияДанных - ТаблицаЗначений - строки порции
//  КэшСумм - Соответствие - суммы набора по портфелю и виду актива
//  Вместилище - УникальныйИдентификатор - вместилище прогона
//
// Возвращаемое значение:
//  Булево - Истина, если строки результата записаны в параметры
//
Функция FO_LimitShare_ЗаполнитьСтруктурныйРезультат(Запрос, ПараметрыИсх, ПорцияДанных, КэшСумм, Вместилище)

	Условия = FO_LimitShare_УсловияСтруктуры(ПараметрыИсх.УсловияОтбораОсновные, Запрос);
	Если Условия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяТаблицы = ПараметрыИсх.ИмяОсновнойТаблицы;
	Если Не СтрНачинаетсяС(ИмяТаблицы, "ВТ_ТаблицаНабораДанных") Тогда
		Возврат Ложь;
	КонецЕсли;

	Суммы = FO_LimitShare_СуммыНабора(Запрос, ИмяТаблицы, КэшСумм);
	Если Суммы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяРСА = XMLСтрока(Перечисления.ВидыБазисовДляПроверкиЛимитов.РСА);
	Решения = Новый Массив;
	Для Каждого СтрокаПорции Из ПорцияДанных Цикл
		Фокус = СтрокаПорции.Фокус;
		Факт = FO_LimitShare_ФактПортфеля(Суммы, Фокус, Условия);
		БазисЧисло = 0;
		Описание = "Позиция 0";
		Зона = Перечисления.ЗоныПроверкиЛимитов.ПустаяСсылка();
		Если Факт <> 0 Тогда
			Основа = ПараметрыИсх.БазисыПорции.Получить(Фокус);
			Если ТипЗнч(Основа) <> Тип("Структура") Или Не Основа.Свойство(ИмяРСА) Или Не ЗначениеЗаполнено(Основа[ИмяРСА]) Тогда
				Возврат Ложь;
			КонецЕсли;
			БазисЧисло = Основа[ИмяРСА];
			Сведения = FO_LimitShare_СведенияПортфеля(ПараметрыИсх, Фокус);
			Если Сведения = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			Процент = ПроверкаЛимитов.ПроцентОтСуммы(Факт, БазисЧисло);
			Зона = FO_LimitShare_ЗонаПоПроценту(Процент, Сведения);
			Если Зона = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			Если Зона = Перечисления.ЗоныПроверкиЛимитов.Красная Тогда
				Описание = "Есть нарушения; ";
			ИначеЕсли Зона = Перечисления.ЗоныПроверкиЛимитов.Желтая Тогда
				Описание = "Есть предупреждения; ";
			Иначе
				Описание = "";
				Зона = Перечисления.ЗоныПроверкиЛимитов.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		Решение = Новый Структура("СтрокаПорции, Базис, Зона, Описание", СтрокаПорции, БазисЧисло, Зона, Описание);
		Решения.Добавить(Решение);
	КонецЦикла;

	Таблица = ПараметрыИсх.КэшВмКратко;
	Таблица.Очистить();
	Для Каждого Решение Из Решения Цикл
		СтрокаКратко = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКратко, Решение.СтрокаПорции);
		СтрокаКратко.Лимит = ПараметрыИсх.Лимит;
		СтрокаКратко.Исполнитель = ПараметрыИсх.Исполнитель;
		СтрокаКратко.Вместилище = Вместилище;
		СтрокаКратко.НаборДанных = ПараметрыИсх.НаборДанныхТекущий;
		СтрокаКратко.Идентификатор = Новый УникальныйИдентификатор;
		СтрокаКратко.Отказ = Ложь;
		СтрокаКратко.Базис = Решение.Базис;
		СтрокаКратко.Зона = Решение.Зона;
		СтрокаКратко.Описание = Решение.Описание;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция FO_LimitShare_УсловияСтруктуры(ТекстУсловий, Запрос)

	Если Не ЗначениеЗаполнено(ТекстУсловий) Или СтрНайти(ТекстУсловий, " ИЛИ ") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Остаток = ТекстУсловий;
	Условия = Новый Массив;
	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, " И ");
		Если Позиция = 0 Тогда
			Фрагмент = Остаток;
			Остаток = "";
		Иначе
			Фрагмент = Лев(Остаток, Позиция - 1);
			Остаток = Сред(Остаток, Позиция + 3);
		КонецЕсли;
		ПозицияПоля = СтрНайти(Фрагмент, "#Т.");
		Если ПозицияПоля > 0 Тогда
			Хвост = Сред(Фрагмент, ПозицияПоля + 3);
			ПозицияПробела = СтрНайти(Хвост, " ");
			Если ПозицияПробела = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			ИмяПоля = Лев(Хвост, ПозицияПробела - 1);
			Если ИмяПоля <> "ВидАктива" И ИмяПоля <> "ВалютаНоминала" Тогда
				Возврат Неопределено;
			КонецЕсли;
			Если СтрНайти(Хвост, "В ИЕРАРХИИ") > 0 Тогда
				ВидСравнения = "Иерархия";
			ИначеЕсли СтрНайти(Хвост, "<>") > 0 Тогда
				ВидСравнения = "НеРавно";
			ИначеЕсли СтрНайти(Хвост, "=") > 0 Тогда
				ВидСравнения = "Равно";
			Иначе
				Возврат Неопределено;
			КонецЕсли;
			ИмяПараметра = FO_LimitShare_ИмяПараметра(Хвост);
			Значение = FO_LimitShare_ЗначениеПараметра(Запрос, ИмяПараметра);
			Если Не ЗначениеЗаполнено(ИмяПараметра) Или Значение = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Условие = Новый Структура("Поле, Вид, Значение", ИмяПоля, ВидСравнения, Значение);
			Условия.Добавить(Условие);
		КонецЕсли;
		Если ПустаяСтрока(Остаток) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Условия.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Условия;

КонецФункции

Функция FO_LimitShare_ИмяПараметра(Хвост)

	Позиция = СтрНайти(Хвост, "&");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Имя = "";
	Для Индекс = Позиция + 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Индекс, 1);
		Если Символ = "_" Или (Символ >= "0" И Символ <= "9") Или (Символ >= "A" И Символ <= "Z")
			Или (Символ >= "a" И Символ <= "z") Или (Символ >= "А" И Символ <= "Я") Или (Символ >= "а" И Символ <= "я") Тогда
			Имя = Имя + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Имя;

КонецФункции

Функция FO_LimitShare_ЗначениеПараметра(Запрос, ИмяПараметра)

	Если ПустаяСтрока(ИмяПараметра) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ПараметрЗапроса Из Запрос.Параметры Цикл
		Если ПараметрЗапроса.Имя = ИмяПараметра Тогда
			Возврат ПараметрЗапроса.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция FO_LimitShare_СуммыНабора(Запрос, ИмяТаблицы, КэшСумм)

	Найденные = КэшСумм.Получить(ИмяТаблицы);
	Если Найденные <> Неопределено Тогда
		Возврат Найденные;
	КонецЕсли;

	ЗапросСумм = Новый Запрос;
	ЗапросСумм.МенеджерВременныхТаблиц = Запрос.МенеджерВременныхТаблиц;
	ЗапросСумм.Текст =
	"ВЫБРАТЬ
	|	Т.Портфель КАК Портфель,
	|	Т.ВидАктива КАК ВидАктива,
	|	Т.ВалютаНоминала КАК ВалютаНоминала,
	|	СУММА(Т.ОбщаяСтоимость) КАК Стоимость
	|ИЗ
	|	" + ИмяТаблицы + " КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.Портфель,
	|	Т.ВидАктива,
	|	Т.ВалютаНоминала";
	Таблица = ЗапросСумм.Выполнить().Выгрузить();
	КэшСумм.Вставить(ИмяТаблицы, Таблица);

	Возврат Таблица;

КонецФункции

Функция FO_LimitShare_ФактПортфеля(Суммы, Фокус, Условия)

	Факт = 0;
	Для Каждого СтрокаСумм Из Суммы Цикл
		Если СтрокаСумм.Портфель <> Фокус Тогда
			Продолжить;
		КонецЕсли;
		Если FO_LimitShare_СтрокаПодходит(СтрокаСумм, Условия) Тогда
			Факт = Факт + СтрокаСумм.Стоимость;
		КонецЕсли;
	КонецЦикла;

	Возврат Факт;

КонецФункции

Функция FO_LimitShare_СтрокаПодходит(СтрокаСумм, Условия)

	Для Каждого Условие Из Условия Цикл
		Если Условие.Поле = "ВидАктива" Тогда
			ЗначениеСтроки = СтрокаСумм.ВидАктива;
		Иначе
			ЗначениеСтроки = СтрокаСумм.ВалютаНоминала;
		КонецЕсли;
		Если Условие.Вид = "Равно" И ЗначениеСтроки <> Условие.Значение Тогда
			Возврат Ложь;
		ИначеЕсли Условие.Вид = "НеРавно" И ЗначениеСтроки = Условие.Значение Тогда
			Возврат Ложь;
		ИначеЕсли Условие.Вид = "Иерархия" Тогда
			Совпадает = ЗначениеСтроки = Условие.Значение;
			Если Не Совпадает И ЗначениеЗаполнено(ЗначениеСтроки) Тогда
				Совпадает = ЗначениеСтроки.ПринадлежитЭлементу(Условие.Значение);
			КонецЕсли;
			Если Не Совпадает Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция FO_LimitShare_СведенияПортфеля(ПараметрыИсх, Фокус)

	Если Не ПараметрыИсх.Свойство("СведенияОПорогах") Или ТипЗнч(ПараметрыИсх.СведенияОПорогах) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сведения = ПараметрыИсх.СведенияОПорогах.Получить(Фокус);
	Если Сведения = Неопределено Тогда
		Сведения = ПараметрыИсх.СведенияОПорогах.Получить(Справочники.Портфели.ПустаяСсылка());
	КонецЕсли;
	Если ТипЗнч(Сведения) <> Тип("Структура") Или Не Сведения.Свойство("МаксДоляКраснаяЗона") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Сведения.Свойство("ИспользоватьПорогиПоручения") И Сведения.ИспользоватьПорогиПоручения Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Сведения.Свойство("ПорогиНеЗаполнены") И Сведения.ПорогиНеЗаполнены Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Сведения.Свойство("РасширеннаяУстановкаПорогов") И Сведения.РасширеннаяУстановкаПорогов Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сведения;

КонецФункции

Функция FO_LimitShare_ЗонаПоПроценту(ПроцентФакта, Настройки)

	Если ПроцентФакта > Настройки.МаксДоляКраснаяЗона
		И (Не Настройки.МаксДоляКраснаяЗона = 0 Или Настройки.НулевойПорогКраснаяЗона) Тогда
		Возврат Перечисления.ЗоныПроверкиЛимитов.Красная;
	ИначеЕсли ПроцентФакта < Настройки.МинДоляКраснаяЗона И Не Настройки.МинДоляКраснаяЗона = 0 Тогда
		Возврат Перечисления.ЗоныПроверкиЛимитов.Красная;
	ИначеЕсли ПроцентФакта > Настройки.МаксДоляЖелтаяЗона
		И (Не Настройки.МаксДоляЖелтаяЗона = 0 Или Настройки.НулевойПорогЖелтаяЗона) Тогда
		Возврат Перечисления.ЗоныПроверкиЛимитов.Желтая;
	ИначеЕсли ПроцентФакта < Настройки.МинДоляЖелтаяЗона И Не Настройки.МинДоляЖелтаяЗона = 0 Тогда
		Возврат Перечисления.ЗоныПроверкиЛимитов.Желтая;
	КонецЕсли;

	Возврат Перечисления.ЗоныПроверкиЛимитов.ПустаяСсылка();

