// Описание: Запускает проверку лимитов на сервере и записывает сводку замеров
//
// Параметры:
// ПараметрыПроверки - Структура - параметры Распорядители.ПроверкаИОтправка
//
Процедура Запустить(ПараметрыПроверки) Экспорт

	ПараметрыСеанса.FO_LimitProfile_Сводка = "";
	Добавить("старт", ПараметрыПроверки.Портфели.Количество());
	Распорядители.ПроверкаИОтправка(ПараметрыПроверки);
	ЗаписатьСводку();

КонецПроцедуры

// Описание: Добавляет длительность одного вызова алгоритма в сводку сеанса
//
// Параметры:
// Имя - Строка - имя алгоритма
// Миллисекунды - Число - длительность вызова
//
Процедура Добавить(Имя, Миллисекунды) Экспорт

	Суммы = РазобратьСводку(ПараметрыСеанса.FO_LimitProfile_Сводка);
	СтрокаСуммы = Суммы.Получить(Имя);
	Если СтрокаСуммы = Неопределено Тогда
		Сумма = 0;
		Вызовы = 0;
	Иначе
		Части = СтрРазделить(СтрокаСуммы, "|", Ложь);
		Сумма = Число(Части[0]);
		Вызовы = Число(Части[1]);
	КонецЕсли;
	Суммы.Вставить(Имя, Формат(Сумма + Миллисекунды, "ЧН=0; ЧГ=0") + "|" + Формат(Вызовы + 1, "ЧН=0; ЧГ=0"));
	ПараметрыСеанса.FO_LimitProfile_Сводка = СобратьСводку(Суммы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьСводку(Текст)

	Суммы = Новый Соответствие;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Позиция = СтрНайти(Строка, Символы.Таб);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Суммы.Вставить(Лев(Строка, Позиция - 1), Сред(Строка, Позиция + 1));
	КонецЦикла;
	Возврат Суммы;

КонецФункции

Функция СобратьСводку(Суммы)

	Части = Новый Массив;
	Для Каждого КлючЗначение Из Суммы Цикл
		Части.Добавить(КлючЗначение.Ключ + Символы.Таб + КлючЗначение.Значение);
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Процедура ЗаписатьСводку()

	Суммы = РазобратьСводку(ПараметрыСеанса.FO_LimitProfile_Сводка);
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Таблица.Колонки.Добавить("Миллисекунды", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0)));
	Таблица.Колонки.Добавить("Вызовы", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Для Каждого КлючЗначение Из Суммы Цикл
		Части = СтрРазделить(КлючЗначение.Значение, "|", Ложь);
		Строка = Таблица.Добавить();
		Строка.Имя = КлючЗначение.Ключ;
		Строка.Миллисекунды = Число(Части[0]);
		Строка.Вызовы = Число(Части[1]);
	КонецЦикла;
	Таблица.Сортировать("Миллисекунды Убыв");

	КаталогОтчета = "C:\1c\Cursor_1c\WIM_DEV\bases\Wim_Fo\projects\IMDEV-Я Оптимизация Аванкор Фронт-офис\Тестирование\reports";
	Запись = Новый ЗаписьТекста(КаталогОтчета + "\fo_profile_server.txt", КодировкаТекста.UTF8);
	Журнал = Новый ЗаписьТекста("C:\1c\Cursor_1c\WIM_DEV\debug-821a43.log", КодировкаТекста.UTF8, Символы.ПС, Истина);
	Запись.ЗаписатьСтроку("algorithm	ms	calls	ms_per_call");
	Для Каждого Строка Из Таблица Цикл
		НаВызов = 0;
		Если Строка.Вызовы > 0 Тогда
			НаВызов = Окр(Строка.Миллисекунды / Строка.Вызовы, 1);
		КонецЕсли;
		Запись.ЗаписатьСтроку(Строка.Имя + Символы.Таб + Формат(Строка.Миллисекунды, "ЧН=0; ЧГ=0")
			+ Символы.Таб + Формат(Строка.Вызовы, "ЧН=0; ЧГ=0")
			+ Символы.Таб + Формат(НаВызов, "ЧН=0; ЧГ=0; ЧРД=."));
		Журнал.ЗаписатьСтроку("{""sessionId"":""821a43"",""hypothesisId"":""profile"",""location"":""FO_LimitProfile"",""message"":"""
			+ Строка.Имя + """,""data"":{""ms"":" + Формат(Строка.Миллисекунды, "ЧН=0; ЧГ=0")
			+ ",""calls"":" + Формат(Строка.Вызовы, "ЧН=0; ЧГ=0")
			+ ",""msPerCall"":" + Формат(НаВызов, "ЧН=0; ЧГ=0; ЧРД=.")
			+ "},""timestamp"":" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧН=0; ЧГ=0") + "}");
	КонецЦикла;
	Запись.Закрыть();
	Журнал.Закрыть();

КонецПроцедуры

