#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Описание: Не проверяет готовность адаптеров и не вызывает QUIK, FIX и создание сделок
//
// Параметры:
//  ПараметрыВх - Структура - параметры отправки поручений
//  АдресРезультата - Строка - адрес временного хранилища результата
//
// Возвращаемое значение:
//  Структура - отказ без обращения к внешним системам
//
&Вместо("Отправка")
Функция FO_CheckSafe_Отправка(ПараметрыВх, АдресРезультата = Неопределено)

	Распорядитель = Распорядитель(Виды().Отправка, ПараметрыВх);
	Результат = РезультатРаспорядителя(ПараметрыВх, Распорядитель.Идентификатор);
	Поручения = ПараметрыВх.Поручения;
	Навигатор = Новый Соответствие;
	Кэш = Распорядитель.Кэш;
	Кэш.Таблицы.РезультатОбработки = Адаптеры.РезультатОбработкиПоручений(Поручения, Навигатор);

	ТекстОтказ = "FO_CheckSafe: отправка во внешние системы не выполнялась";
	Уровни = Адаптеры.УровниВажности();
	Для Каждого КлючЗначение Из Навигатор Цикл
		Указатель = КлючЗначение.Значение;
		Указатель.Описание = ТекстОтказ;
		Адаптеры.ОбработатьУказатель(Указатель, Уровни.Ошибка, Истина);
	КонецЦикла;

	Результат.Отказ = Истина;
	Результат.Описание = ТекстОтказ;
	ЗаписьЖурналаРегистрации("FO_CheckSafe", УровеньЖурналаРегистрации.Предупреждение, , , ТекстОтказ);

	ПодготовитьЗавершение(Распорядитель);
	Возврат Результат(Результат, Распорядитель, АдресРезультата);

КонецФункции

#КонецОбласти

#КонецЕсли
