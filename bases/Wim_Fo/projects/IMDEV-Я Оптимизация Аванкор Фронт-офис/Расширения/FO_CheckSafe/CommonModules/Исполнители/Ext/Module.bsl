#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

#Область Отправка

// Описание: Не передает поручения в QUIK, FIX и другие адаптеры и не создает по ним сделки
//
// Параметры:
//  Параметры - Структура - параметры исполнителя отправки
//  АдресРезультата - Строка - адрес временного хранилища результата
//
// Возвращаемое значение:
//  Структура - результат исполнителя с отказом, без обращения к адаптеру
//
&Вместо("Отправка_ОтправкаПоручений")
Функция FO_CheckSafe_Отправка_ОтправкаПоручений(Знач Параметры, АдресРезультата = Неопределено)

	УстановитьПривилегированныйРежим(Истина);
	Результат = ИсполнителиСлужебный.СтруктураРезультатаИсполнителей();
	Результат.Отказ = Истина;
	Результат.Описание = "FO_CheckSafe: отправка во внешние системы не выполнялась";
	ПодготовитьЗавершение(Результат);
	ЗаписьЖурналаРегистрации("FO_CheckSafe", УровеньЖурналаРегистрации.Предупреждение, , , Результат.Описание);

	Возврат Результат(Результат, АдресРезультата);

КонецФункции

#КонецОбласти

#Область Отмена

