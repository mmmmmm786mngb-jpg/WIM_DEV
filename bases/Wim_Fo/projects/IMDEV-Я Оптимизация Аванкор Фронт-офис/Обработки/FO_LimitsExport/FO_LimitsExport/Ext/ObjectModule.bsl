
#Область ПрограммныйИнтерфейс

// Описание: Выгружает справочник Лимиты и документы УстановкаЛимитов в JSON
//
// Параметры:
//  Каталог - Строка - каталог, в который записываются index.json, installations.json и limits
//
// Возвращаемое значение:
//  Строка - краткий итог выгрузки
//
// Пример:
//  Текст = Обработка.ВыгрузитьЛимиты("C:\export\limits");
//
Функция ВыгрузитьЛимиты(Каталог) Экспорт

    Если Не ЗначениеЗаполнено(Каталог) Тогда
        ВызватьИсключение "Не указан каталог выгрузки";
    КонецЕсли;

    КаталогЛимитов = ОбъединитьКаталог(Каталог, "limits");
    СоздатьКаталог(КаталогЛимитов);

    КэшКарточек = Новый Соответствие;
    Ошибки = Новый Массив;
    Оглавление = Новый Массив;
    КоличествоЭлементов = 0;
    КоличествоГрупп = 0;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Лимиты.Ссылка КАК Ссылка,
    |    Лимиты.Код КАК Код,
    |    Лимиты.Наименование КАК Наименование,
    |    Лимиты.ЭтоГруппа КАК ЭтоГруппа,
    |    Лимиты.ПометкаУдаления КАК ПометкаУдаления,
    |    Лимиты.Родитель КАК Родитель,
    |    Лимиты.ВидЛимита КАК ВидЛимита,
    |    Лимиты.КлассЛимита КАК КлассЛимита,
    |    Лимиты.Тестовый КАК Тестовый,
    |    Лимиты.Подтвержден КАК Подтвержден,
    |    Лимиты.СпособНастройкиЛимита КАК СпособНастройкиЛимита,
    |    Лимиты.НаборДанныхДляПроверкиЛимитов КАК НаборДанныхДляПроверкиЛимитов
    |ИЗ
    |    Справочник.Лимиты КАК Лимиты
    |УПОРЯДОЧИТЬ ПО
    |    Лимиты.ЭтоГруппа УБЫВ,
    |    Лимиты.Наименование";

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл

        СтрокаОглавления = Новый Структура;
        СтрокаОглавления.Вставить("Код", Выборка.Код);
        СтрокаОглавления.Вставить("Наименование", Выборка.Наименование);
        СтрокаОглавления.Вставить("ЭтоГруппа", Выборка.ЭтоГруппа);
        СтрокаОглавления.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
        СтрокаОглавления.Вставить("Родитель", ПреобразоватьЗначение(Выборка.Родитель, 0));
        СтрокаОглавления.Вставить("УникальныйИдентификатор", Строка(Выборка.Ссылка.УникальныйИдентификатор()));

        Если Выборка.ЭтоГруппа Тогда
            КоличествоГрупп = КоличествоГрупп + 1;
            СтрокаОглавления.Вставить("Файл", "");
            Оглавление.Добавить(СтрокаОглавления);
            Продолжить;
        КонецЕсли;

        СтрокаОглавления.Вставить("ВидЛимита", ПреобразоватьЗначение(Выборка.ВидЛимита, 0));
        СтрокаОглавления.Вставить("КлассЛимита", ПреобразоватьЗначение(Выборка.КлассЛимита, 0));
        СтрокаОглавления.Вставить("Тестовый", Выборка.Тестовый);
        СтрокаОглавления.Вставить("Подтвержден", Выборка.Подтвержден);
        СтрокаОглавления.Вставить("СпособНастройкиЛимита", ПреобразоватьЗначение(Выборка.СпособНастройкиЛимита, 0));
        СтрокаОглавления.Вставить("НаборДанных", ПреобразоватьЗначение(Выборка.НаборДанныхДляПроверкиЛимитов, 0));

        ИмяФайла = ИмяФайлаЛимита(Выборка.Код, Выборка.Ссылка.УникальныйИдентификатор());
        СтрокаОглавления.Вставить("Файл", "limits/" + ИмяФайла);

        Попытка
            Описание = ОписаниеЛимита(Выборка.Ссылка, КэшКарточек);
            ЗаписатьФайлJSON(ОбъединитьКаталог(КаталогЛимитов, ИмяФайла), Описание);
            КоличествоЭлементов = КоличествоЭлементов + 1;
        Исключение
            ТекстОшибки = Выборка.Наименование + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
            Ошибки.Добавить(ТекстОшибки);
            СтрокаОглавления.Вставить("Ошибка", ТекстОшибки);
        КонецПопытки;

        Оглавление.Добавить(СтрокаОглавления);

    КонецЦикла;

    КоличествоДокументов = ВыгрузитьУстановки(Каталог, Ошибки);

    ОглавлениеФайл = Новый Структура;
    ОглавлениеФайл.Вставить("Конфигурация", Метаданные.Имя);
    ОглавлениеФайл.Вставить("ВерсияКонфигурации", Метаданные.Версия);
    ОглавлениеФайл.Вставить("ДатаВыгрузки", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
    ОглавлениеФайл.Вставить("КоличествоЭлементов", КоличествоЭлементов);
    ОглавлениеФайл.Вставить("КоличествоГрупп", КоличествоГрупп);
    ОглавлениеФайл.Вставить("КоличествоДокументовУстановок", КоличествоДокументов);
    ОглавлениеФайл.Вставить("Ошибки", Ошибки);
    ОглавлениеФайл.Вставить("Лимиты", Оглавление);
    ЗаписатьФайлJSON(ОбъединитьКаталог(Каталог, "index.json"), ОглавлениеФайл);

    Возврат СтрШаблон(
        "Выгружено элементов: %1, групп: %2, документов установок: %3, ошибок: %4. Каталог: %5",
        КоличествоЭлементов,
        КоличествоГрупп,
        КоличествоДокументов,
        Ошибки.Количество(),
        Каталог);

КонецФункции

// Описание: Собирает JSON-выгрузку во временном каталоге сервера и возвращает ее архивом
// Файлы не пишутся в каталог пользователя: его видит только клиентский компьютер
//
// Возвращаемое значение:
//  Структура - Описание, КаталогСервера, Архив (ДвоичныеДанные)
//
Функция СобратьАрхивВыгрузки() Экспорт

    Идентификатор = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
    КаталогСервера = ОбъединитьКаталог(КаталогВременныхФайлов(), "FO_LimitsExport_" + Идентификатор);
    СоздатьКаталог(КаталогСервера);

    Попытка
        Описание = ВыгрузитьЛимиты(КаталогСервера);
        ЗаписьАрхива = Новый ЗаписьZipФайла;
        ЗаписьАрхива.Добавить(
            ОбъединитьКаталог(КаталогСервера, "*"),
            РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
            РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
        Архив = ЗаписьАрхива.ПолучитьДвоичныеДанные();
    Исключение
        УдалитьКаталогВыгрузки(КаталогСервера);
        ВызватьИсключение;
    КонецПопытки;

    Результат = Новый Структура;
    Результат.Вставить("Описание", Описание);
    Результат.Вставить("КаталогСервера", КаталогСервера);
    Результат.Вставить("Архив", Архив);
    Возврат Результат;

КонецФункции

// Описание: Распаковывает архив выгрузки в указанный каталог и удаляет временный zip
//
// Параметры:
//  Архив - ДвоичныеДанные - zip с index.json, installations.json и каталогом limits
//  Каталог - Строка - каталог на том компьютере, где выполняется процедура
//
Процедура РаспаковатьАрхивВКаталог(Архив, Каталог) Экспорт

    Если Не ЗначениеЗаполнено(Каталог) Тогда
        ВызватьИсключение "Не указан каталог выгрузки";
    КонецЕсли;

    СоздатьКаталог(Каталог);
    ИмяАрхива = ОбъединитьКаталог(Каталог, "limits_export.zip");
    Архив.Записать(ИмяАрхива);

    ЧтениеАрхива = Новый ЧтениеZipФайла(ИмяАрхива);
    ЧтениеАрхива.ИзвлечьВсе(Каталог, РежимВосстановленияПутейФайловZIP.Восстанавливать);
    ЧтениеАрхива.Закрыть();
    УдалитьФайлы(ИмяАрхива);

КонецПроцедуры

// Описание: Собирает архив на сервере и распаковывает его в переданный каталог
// Нужен, когда вызов идет из того же процесса, где виден каталог
//
// Параметры:
//  Каталог - Строка - каталог для json-файлов
//
// Возвращаемое значение:
//  Строка - итог выгрузки с подставленным каталогом
//
Функция ВыгрузитьЛимитыАрхивом(Каталог) Экспорт

    Результат = СобратьАрхивВыгрузки();
    Попытка
        РаспаковатьАрхивВКаталог(Результат.Архив, Каталог);
    Исключение
        УдалитьКаталогВыгрузки(Результат.КаталогСервера);
        ВызватьИсключение;
    КонецПопытки;

    УдалитьКаталогВыгрузки(Результат.КаталогСервера);
    Возврат СтрЗаменить(Результат.Описание, Результат.КаталогСервера, Каталог);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеЛимита(Ссылка, КэшКарточек)

    Описание = КарточкаОбъекта(Ссылка, КэшКарточек, 0);
    Связанные = Новый Структура;
    ИменаСвязей = СтрРазделить(
        "НаборДанныхДляПроверкиЛимитов,Модификатор,ВариантПроверкиПорога,КлассЛимита,Алгоритм,ХранилищеСсылок",
        ",",
        Ложь);
    Объект = Ссылка.ПолучитьОбъект();

    Для Каждого ИмяСвязи Из ИменаСвязей Цикл
        ЗначениеСвязи = Объект[ИмяСвязи];
        Если ЗначениеЗаполнено(ЗначениеСвязи) Тогда
            Связанные.Вставить(ИмяСвязи, КарточкаОбъекта(ЗначениеСвязи, КэшКарточек, 0));
        КонецЕсли;
    КонецЦикла;

    Описание.Вставить("Связанные", Связанные);
    Возврат Описание;

КонецФункции

Функция ВыгрузитьУстановки(Каталог, Ошибки)

    ДокументыУстановок = Новый Соответствие;
    ПорядокДокументов = Новый Массив;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Установка.Ссылка КАК Ссылка,
    |    Установка.Номер КАК Номер,
    |    Установка.Дата КАК Дата,
    |    Установка.Проведен КАК Проведен,
    |    Установка.Подтвержден КАК Подтвержден,
    |    Установка.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
    |    Установка.ОбъектНазначения КАК ОбъектНазначения,
    |    Установка.ВидОперации КАК ВидОперации,
    |    Установка.КлассЛимита КАК КлассЛимита,
    |    Строки.НомерСтроки КАК НомерСтроки,
    |    Строки.Лимит КАК Лимит,
    |    Строки.НастройкиЛимита КАК НастройкиЛимита,
    |    Строки.НастройкиУстановлены КАК НастройкиУстановлены
    |ИЗ
    |    Документ.УстановкаЛимитов.Лимиты КАК Строки
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УстановкаЛимитов КАК Установка
    |        ПО Строки.Ссылка = Установка.Ссылка
    |ГДЕ
    |    Установка.ПометкаУдаления = ЛОЖЬ
    |
    |УПОРЯДОЧИТЬ ПО
    |    Установка.Дата,
    |    Установка.Ссылка,
    |    Строки.НомерСтроки";

    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл

        КлючДокумента = Строка(Выборка.Ссылка.УникальныйИдентификатор());
        ОписаниеДокумента = ДокументыУстановок.Получить(КлючДокумента);
        Если ОписаниеДокумента = Неопределено Тогда
            ОписаниеДокумента = Новый Структура;
            ОписаниеДокумента.Вставить("Номер", Выборка.Номер);
            ОписаниеДокумента.Вставить("Дата", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
            ОписаниеДокумента.Вставить("Проведен", Выборка.Проведен);
            ОписаниеДокумента.Вставить("Подтвержден", Выборка.Подтвержден);
            ОписаниеДокумента.Вставить("ДатаОкончанияДействия", Формат(Выборка.ДатаОкончанияДействия, "ДФ=yyyy-MM-ddTHH:mm:ss"));
            ОписаниеДокумента.Вставить("ОбъектНазначения", ПреобразоватьЗначение(Выборка.ОбъектНазначения, 0));
            ОписаниеДокумента.Вставить("ВидОперации", ПреобразоватьЗначение(Выборка.ВидОперации, 0));
            ОписаниеДокумента.Вставить("КлассЛимита", ПреобразоватьЗначение(Выборка.КлассЛимита, 0));
            ОписаниеДокумента.Вставить("УникальныйИдентификатор", КлючДокумента);
            ОписаниеДокумента.Вставить("Лимиты", Новый Массив);
            ОписаниеДокумента.Вставить("ИсключаемыеПортфели", Новый Массив);
            ДокументыУстановок.Вставить(КлючДокумента, ОписаниеДокумента);
            ПорядокДокументов.Добавить(ОписаниеДокумента);
        КонецЕсли;

        СтрокаЛимита = Новый Структура;
        СтрокаЛимита.Вставить("НомерСтроки", Выборка.НомерСтроки);
        СтрокаЛимита.Вставить("Лимит", ПреобразоватьЗначение(Выборка.Лимит, 0));
        СтрокаЛимита.Вставить("НастройкиУстановлены", Выборка.НастройкиУстановлены);
        СтрокаЛимита.Вставить("Настройки", ПреобразоватьЗначение(Выборка.НастройкиЛимита, 0));
        ОписаниеДокумента.Лимиты.Добавить(СтрокаЛимита);

    КонецЦикла;

    ЗапросИсключений = Новый Запрос;
    ЗапросИсключений.Текст =
    "ВЫБРАТЬ
    |    Строки.Ссылка КАК Ссылка,
    |    Строки.НомерСтроки КАК НомерСтроки,
    |    Строки.Портфель КАК Портфель,
    |    Строки.Лимит КАК Лимит
    |ИЗ
    |    Документ.УстановкаЛимитов.ИсключаемыеПортфели КАК Строки
    |ГДЕ
    |    Строки.Ссылка.ПометкаУдаления = ЛОЖЬ";

    ВыборкаИсключений = ЗапросИсключений.Выполнить().Выбрать();
    Пока ВыборкаИсключений.Следующий() Цикл
        ОписаниеДокумента = ДокументыУстановок.Получить(Строка(ВыборкаИсключений.Ссылка.УникальныйИдентификатор()));
        Если ОписаниеДокумента = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        СтрокаИсключения = Новый Структура;
        СтрокаИсключения.Вставить("НомерСтроки", ВыборкаИсключений.НомерСтроки);
        СтрокаИсключения.Вставить("Портфель", ПреобразоватьЗначение(ВыборкаИсключений.Портфель, 0));
        СтрокаИсключения.Вставить("Лимит", ПреобразоватьЗначение(ВыборкаИсключений.Лимит, 0));
        ОписаниеДокумента.ИсключаемыеПортфели.Добавить(СтрокаИсключения);
    КонецЦикла;

    ФайлУстановок = Новый Структура;
    ФайлУстановок.Вставить("Документы", ПорядокДокументов);
    Попытка
        ЗаписатьФайлJSON(ОбъединитьКаталог(Каталог, "installations.json"), ФайлУстановок);
    Исключение
        Ошибки.Добавить("installations.json: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    Возврат ПорядокДокументов.Количество();

КонецФункции

Функция КарточкаОбъекта(Ссылка, КэшКарточек, Глубина)

    Ключ = Строка(Ссылка.УникальныйИдентификатор());
    ГотоваяКарточка = КэшКарточек.Получить(Ключ);
    Если ГотоваяКарточка <> Неопределено Тогда
        Возврат ГотоваяКарточка;
    КонецЕсли;

    Описание = ОписаниеСсылки(Ссылка);
    Объект = Ссылка.ПолучитьОбъект();
    Если Объект = Неопределено Тогда
        Описание.Вставить("ОбъектНеНайден", Истина);
        КэшКарточек.Вставить(Ключ, Описание);
        Возврат Описание;
    КонецЕсли;

    МетаданныеОбъекта = Ссылка.Метаданные();
    Описание.Вставить("ПометкаУдаления", Объект.ПометкаУдаления);

    Если Метаданные.Справочники.Содержит(МетаданныеОбъекта) Тогда
        Описание.Вставить("Код", Объект.Код);
        Описание.Вставить("Наименование", Объект.Наименование);
        Описание.Вставить("ЭтоГруппа", Объект.ЭтоГруппа);
    ИначеЕсли Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
        Описание.Вставить("Номер", Объект.Номер);
        Описание.Вставить("Дата", Формат(Объект.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
    КонецЕсли;

    Реквизиты = Новый Структура;
    Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
        Реквизиты.Вставить(Реквизит.Имя, ПреобразоватьРеквизит(Реквизит.Имя, Объект[Реквизит.Имя], Глубина + 1));
    КонецЦикла;
    Описание.Вставить("Реквизиты", Реквизиты);

    ТабличныеЧасти = Новый Структура;
    Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
        Если ТабличнаяЧасть.Имя = "НаборыЗначенийДоступа" Тогда
            Продолжить;
        КонецЕсли;
        Строки = Новый Массив;
        Для Каждого СтрокаТаблицы Из Объект[ТабличнаяЧасть.Имя] Цикл
            СтрокаОписания = Новый Структура;
            СтрокаОписания.Вставить("НомерСтроки", СтрокаТаблицы.НомерСтроки);
            Для Каждого Колонка Из ТабличнаяЧасть.Реквизиты Цикл
                СтрокаОписания.Вставить(
                    Колонка.Имя,
                    ПреобразоватьРеквизит(Колонка.Имя, СтрокаТаблицы[Колонка.Имя], Глубина + 1));
            КонецЦикла;
            Строки.Добавить(СтрокаОписания);
        КонецЦикла;
        ТабличныеЧасти.Вставить(ТабличнаяЧасть.Имя, Строки);
    КонецЦикла;
    Описание.Вставить("ТабличныеЧасти", ТабличныеЧасти);

    КэшКарточек.Вставить(Ключ, Описание);
    Возврат Описание;

КонецФункции

Функция ПреобразоватьРеквизит(Имя, Значение, Глубина)

    Если ЭтоСтрокаНастроек(Имя) И ТипЗнч(Значение) = Тип("Строка") Тогда
        Возврат РазобратьСтрокуНастроек(Значение, Глубина);
    КонецЕсли;

    Возврат ПреобразоватьЗначение(Значение, Глубина);

КонецФункции

Функция ЭтоСтрокаНастроек(Имя)

    Возврат Имя = "НастройкиПодготовкиСпискаАктивов"
        Или Имя = "Квалификатор"
        Или Имя = "НастройкиДеноминатора"
        Или Имя = "УдалитьУсловияОтбораДляДополнения";

КонецФункции

Функция РазобратьСтрокуНастроек(Текст, Глубина)

    Если Не ЗначениеЗаполнено(Текст) Тогда
        Возврат Текст;
    КонецЕсли;

    Попытка
        Разобранное = ЗначениеИзСтрокиВнутр(Текст);
    Исключение
        Возврат Текст;
    КонецПопытки;

    Если ТипЗнч(Разобранное) = Тип("Строка") Или Разобранное = Неопределено Тогда
        Возврат Текст;
    КонецЕсли;

    Описание = Новый Структура;
    Описание.Вставить("Вид", "СтрокаВнутр");
    Если ТипЗнч(Разобранное) = Тип("ХранилищеЗначения") Тогда
        Описание.Вставить("Значение", ПреобразоватьЗначение(Разобранное.Получить(), Глубина + 1));
    Иначе
        Описание.Вставить("Значение", ПреобразоватьЗначение(Разобранное, Глубина + 1));
    КонецЕсли;

    Возврат Описание;

КонецФункции

Функция ПреобразоватьЗначение(Значение, Глубина)

    Если Глубина > 12 Тогда
        Возврат Строка(ТипЗнч(Значение));
    КонецЕсли;

    ТипЗначения = ТипЗнч(Значение);

    Если Значение = Неопределено Или ТипЗначения = Тип("Null") Тогда
        Возврат Неопределено;
    ИначеЕсли ТипЗначения = Тип("Строка")
        Или ТипЗначения = Тип("Число")
        Или ТипЗначения = Тип("Булево") Тогда
        Возврат Значение;
    ИначеЕсли ТипЗначения = Тип("Дата") Тогда
        Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
    ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Или ТипЗначения = Тип("Тип") Тогда
        Возврат Строка(Значение);
    ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда
        Возврат ОписаниеХранилища(Значение, Глубина);
    ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
        Возврат ОписаниеДвоичныхДанных(Значение);
    ИначеЕсли ТипЗначения = Тип("НастройкиКомпоновкиДанных") Тогда
        Возврат ОписаниеНастроекКомпоновки(Значение, Глубина);
    ИначеЕсли ТипЗначения = Тип("МакетКомпоновкиДанных") Тогда
        Возврат ОписаниеБезСодержимого("МакетКомпоновкиДанных");
    ИначеЕсли ТипЗначения = Тип("СхемаКомпоновкиДанных") Тогда
        Возврат ОписаниеСхемы(Значение);
    ИначеЕсли ТипЗначения = Тип("ПолеКомпоновкиДанных") Или ТипЗначения = Тип("ПараметрКомпоновкиДанных") Тогда
        Возврат Строка(Значение);
    ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
        Возврат ОписаниеПеречисления(Значение);
    ИначеЕсли ЭтоСсылка(ТипЗначения) Тогда
        Возврат ОписаниеСсылки(Значение);
    ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
        Возврат ОписаниеСтруктуры(Значение, Глубина);
    ИначеЕсли ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
        Возврат ОписаниеСоответствия(Значение, Глубина);
    ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
        Возврат ОписаниеМассива(Значение, Глубина);
    ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
        Возврат ОписаниеСпискаЗначений(Значение, Глубина);
    ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
        Возврат ОписаниеТаблицыЗначений(Значение, Глубина);
    КонецЕсли;

    Возврат Строка(Значение);

КонецФункции

Функция ОписаниеХранилища(Хранилище, Глубина)

    ВнутреннееЗначение = Хранилище.Получить();
    Описание = Новый Структура;
    Описание.Вставить("Вид", "ХранилищеЗначения");
    Описание.Вставить("ТипЗначения", Строка(ТипЗнч(ВнутреннееЗначение)));
    Описание.Вставить("Значение", ПреобразоватьЗначение(ВнутреннееЗначение, Глубина + 1));
    Возврат Описание;

КонецФункции

Функция ОписаниеДвоичныхДанных(Данные)

    Описание = Новый Структура;
    Описание.Вставить("Вид", "ДвоичныеДанные");
    Описание.Вставить("Размер", Данные.Размер());
    Возврат Описание;

КонецФункции

Функция ОписаниеБезСодержимого(Вид)

    Описание = Новый Структура;
    Описание.Вставить("Вид", Вид);
    Описание.Вставить("Примечание", "Содержимое в JSON не разворачивается");
    Возврат Описание;

КонецФункции

Функция ОписаниеНастроекКомпоновки(Настройки, Глубина)

    Описание = Новый Структура;
    Описание.Вставить("Вид", "НастройкиКомпоновкиДанных");
    Описание.Вставить("Отбор", ОписаниеЭлементовОтбора(Настройки.Отбор.Элементы, Глубина));
    Описание.Вставить("Выбор", ОписаниеВыбора(Настройки.Выбор.Элементы, Глубина));
    Описание.Вставить("Порядок", ОписаниеПорядка(Настройки.Порядок.Элементы));
    Описание.Вставить("Параметры", ОписаниеПараметровКомпоновки(Настройки.ПараметрыДанных.Элементы, Глубина));
    Возврат Описание;

КонецФункции

Функция ОписаниеЭлементовОтбора(Элементы, Глубина)

    Результат = Новый Массив;
    Для Каждого Элемент Из Элементы Цикл
        Описание = Новый Структура;
        Описание.Вставить("Использование", Элемент.Использование);
        Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
            Описание.Вставить("Вид", "Группа");
            Описание.Вставить("ТипГруппы", Строка(Элемент.ТипГруппы));
            Описание.Вставить("Элементы", ОписаниеЭлементовОтбора(Элемент.Элементы, Глубина));
        Иначе
            Описание.Вставить("Вид", "Элемент");
            Описание.Вставить("ЛевоеЗначение", ПреобразоватьЗначение(Элемент.ЛевоеЗначение, Глубина + 1));
            Описание.Вставить("ВидСравнения", Строка(Элемент.ВидСравнения));
            Описание.Вставить("ПравоеЗначение", ПреобразоватьЗначение(Элемент.ПравоеЗначение, Глубина + 1));
        КонецЕсли;
        Результат.Добавить(Описание);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ОписаниеВыбора(Элементы, Глубина)

    Результат = Новый Массив;
    Для Каждого Элемент Из Элементы Цикл
        Описание = Новый Структура;
        ТипЭлемента = ТипЗнч(Элемент);
        Если ТипЭлемента = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
            Описание.Вставить("Вид", "Группа");
            Описание.Вставить("Использование", Элемент.Использование);
            Описание.Вставить("Элементы", ОписаниеВыбора(Элемент.Элементы, Глубина));
        ИначеЕсли ТипЭлемента = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
            Описание.Вставить("Вид", "Поле");
            Описание.Вставить("Использование", Элемент.Использование);
            Описание.Вставить("Поле", Строка(Элемент.Поле));
        ИначеЕсли ТипЭлемента = Тип("АвтоВыбранноеПолеКомпоновкиДанных") Тогда
            Описание.Вставить("Вид", "Авто");
            Описание.Вставить("Использование", Элемент.Использование);
        Иначе
            Описание.Вставить("Вид", Строка(ТипЭлемента));
        КонецЕсли;
        Результат.Добавить(Описание);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ОписаниеПорядка(Элементы)

    Результат = Новый Массив;
    Для Каждого Элемент Из Элементы Цикл
        Описание = Новый Структура;
        Описание.Вставить("Поле", Строка(Элемент.Поле));
        Описание.Вставить("ТипУпорядочивания", Строка(Элемент.ТипУпорядочивания));
        Описание.Вставить("Использование", Элемент.Использование);
        Результат.Добавить(Описание);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ОписаниеПараметровКомпоновки(Элементы, Глубина)

    Результат = Новый Массив;
    Для Каждого Элемент Из Элементы Цикл
        Описание = Новый Структура;
        Описание.Вставить("Параметр", Строка(Элемент.Параметр));
        Описание.Вставить("Использование", Элемент.Использование);
        Описание.Вставить("Значение", ПреобразоватьЗначение(Элемент.Значение, Глубина + 1));
        Результат.Добавить(Описание);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ОписаниеСхемы(Схема)

    Наборы = Новый Массив;
    ДобавитьНаборыСхемы(Наборы, Схема.НаборыДанных);
    Описание = Новый Структура;
    Описание.Вставить("Вид", "СхемаКомпоновкиДанных");
    Описание.Вставить("НаборыДанных", Наборы);
    Возврат Описание;

КонецФункции

Процедура ДобавитьНаборыСхемы(Приемник, Коллекция)

    Для Каждого Набор Из Коллекция Цикл
        Описание = Новый Структура;
        Описание.Вставить("Имя", Набор.Имя);
        Описание.Вставить("Тип", Строка(ТипЗнч(Набор)));
        Если ТипЗнч(Набор) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
            Описание.Вставить("Запрос", Набор.Запрос);
        ИначеЕсли ТипЗнч(Набор) = Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных") Тогда
            Вложенные = Новый Массив;
            ДобавитьНаборыСхемы(Вложенные, Набор.НаборыДанных);
            Описание.Вставить("Наборы", Вложенные);
        КонецЕсли;
        Приемник.Добавить(Описание);
    КонецЦикла;

КонецПроцедуры

Функция ОписаниеСтруктуры(Значение, Глубина)

    Описание = Новый Структура;
    Для Каждого КлючИЗначение Из Значение Цикл
        Описание.Вставить(КлючИЗначение.Ключ, ПреобразоватьЗначение(КлючИЗначение.Значение, Глубина + 1));
    КонецЦикла;

    Возврат Описание;

КонецФункции

Функция ОписаниеСоответствия(Значение, Глубина)

    Результат = Новый Массив;
    Для Каждого КлючИЗначение Из Значение Цикл
        Пара = Новый Структура;
        Пара.Вставить("Ключ", ПреобразоватьЗначение(КлючИЗначение.Ключ, Глубина + 1));
        Пара.Вставить("Значение", ПреобразоватьЗначение(КлючИЗначение.Значение, Глубина + 1));
        Результат.Добавить(Пара);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ОписаниеМассива(Значение, Глубина)

    Результат = Новый Массив;
    Для Каждого Элемент Из Значение Цикл
        Результат.Добавить(ПреобразоватьЗначение(Элемент, Глубина + 1));
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ОписаниеСпискаЗначений(Значение, Глубина)

    Результат = Новый Массив;
    Для Каждого Элемент Из Значение Цикл
        Описание = Новый Структура;
        Описание.Вставить("Значение", ПреобразоватьЗначение(Элемент.Значение, Глубина + 1));
        Описание.Вставить("Представление", Элемент.Представление);
        Результат.Добавить(Описание);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ОписаниеТаблицыЗначений(Значение, Глубина)

    Результат = Новый Массив;
    ИменаКолонок = Новый Массив;
    Для Каждого Колонка Из Значение.Колонки Цикл
        ИменаКолонок.Добавить(Колонка.Имя);
    КонецЦикла;

    Для Каждого СтрокаТаблицы Из Значение Цикл
        Описание = Новый Структура;
        Для Каждого ИмяКолонки Из ИменаКолонок Цикл
            Описание.Вставить(ИмяКолонки, ПреобразоватьЗначение(СтрокаТаблицы[ИмяКолонки], Глубина + 1));
        КонецЦикла;
        Результат.Добавить(Описание);
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ОписаниеСсылки(Ссылка)

    МетаданныеСсылки = Ссылка.Метаданные();
    Описание = Новый Структура;
    Описание.Вставить("Тип", МетаданныеСсылки.ПолноеИмя());
    Описание.Вставить("Представление", Строка(Ссылка));
    Описание.Вставить("УникальныйИдентификатор", Строка(Ссылка.УникальныйИдентификатор()));
    Описание.Вставить("Пустая", Не ЗначениеЗаполнено(Ссылка));
    Возврат Описание;

КонецФункции

Функция ОписаниеПеречисления(Значение)

    МетаданныеЗначения = Значение.Метаданные();
    Описание = Новый Структура;
    Описание.Вставить("Тип", МетаданныеЗначения.ПолноеИмя());
    Описание.Вставить("Представление", Строка(Значение));
    ИмяЗначения = "";
    Если ЗначениеЗаполнено(Значение) Тогда
        Индекс = Перечисления[МетаданныеЗначения.Имя].Индекс(Значение);
        Если Индекс >= 0 Тогда
            ИмяЗначения = МетаданныеЗначения.ЗначенияПеречисления[Индекс].Имя;
        КонецЕсли;
    КонецЕсли;
    Описание.Вставить("Имя", ИмяЗначения);
    Возврат Описание;

КонецФункции

Функция ЭтоСсылка(ТипЗначения)

    Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
        Или Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
        Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)
        Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения)
        Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения)
        Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗначения)
        Или Задачи.ТипВсеСсылки().СодержитТип(ТипЗначения)
        Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗначения);

КонецФункции

Функция ИмяФайлаЛимита(Код, Идентификатор)

    БезопасныйКод = "";
    Для Индекс = 1 По СтрДлина(Код) Цикл
        Символ = Сред(Код, Индекс, 1);
        Если ЭтоДопустимыйСимволИмени(Символ) Тогда
            БезопасныйКод = БезопасныйКод + Символ;
        Иначе
            БезопасныйКод = БезопасныйКод + "_";
        КонецЕсли;
    КонецЦикла;

    Если Не ЗначениеЗаполнено(БезопасныйКод) Тогда
        БезопасныйКод = "limit";
    КонецЕсли;

    Возврат БезопасныйКод + "_" + Строка(Идентификатор) + ".json";

КонецФункции

Функция ЭтоДопустимыйСимволИмени(Символ)

    КодСимвола = КодСимвола(Символ);
    Возврат (КодСимвола >= 48 И КодСимвола <= 57)
        Или (КодСимвола >= 65 И КодСимвола <= 90)
        Или (КодСимвола >= 97 И КодСимвола <= 122)
        Или (КодСимвола >= 1040 И КодСимвола <= 1103)
        Или КодСимвола = 1025
        Или КодСимвола = 1105
        Или Символ = "_"
        Или Символ = "-";

КонецФункции

Функция ОбъединитьКаталог(Каталог, Имя)

    Если Не ЗначениеЗаполнено(Каталог) Тогда
        Возврат Имя;
    КонецЕсли;

    ПоследнийСимвол = Прав(Каталог, 1);
    Если ПоследнийСимвол = "\" Или ПоследнийСимвол = "/" Тогда
        Возврат Каталог + Имя;
    КонецЕсли;

    Возврат Каталог + "\" + Имя;

КонецФункции

// Описание: Удаляет временный каталог выгрузки на сервере после переноса архива клиенту
//
// Параметры:
//  Каталог - Строка - каталог внутри каталога временных файлов сервера
//
Процедура УдалитьКаталогВыгрузки(Каталог) Экспорт

    Если Не ЭтоВременныйКаталогВыгрузки(Каталог) Тогда
        ВызватьИсключение "Удалять можно только временный каталог выгрузки лимитов";
    КонецЕсли;

    ФайлКаталога = Новый Файл(Каталог);
    Если Не ФайлКаталога.Существует() Тогда
        Возврат;
    КонецЕсли;

    УдалитьФайлыВКаталоге(Каталог);
    Оболочка = Новый COMОбъект("Scripting.FileSystemObject");
    Оболочка.DeleteFolder(Каталог, Истина);

    ФайлПослеУдаления = Новый Файл(Каталог);
    Если ФайлПослеУдаления.Существует() Тогда
        ВызватьИсключение "Временный каталог сервера не удален: " + Каталог;
    КонецЕсли;

КонецПроцедуры

Функция ЭтоВременныйКаталогВыгрузки(Каталог)

    Основа = КаталогВременныхФайлов();
    Если Прав(Основа, 1) <> "\" И Прав(Основа, 1) <> "/" Тогда
        Основа = Основа + "\";
    КонецЕсли;

    Возврат СтрНачинаетсяС(Каталог, Основа) И СтрНайти(Каталог, "FO_LimitsExport_") > 0;

КонецФункции

Процедура УдалитьФайлыВКаталоге(Каталог)

    НайденныеФайлы = НайтиФайлы(Каталог, "*", Истина);
    Индекс = НайденныеФайлы.ВГраница();
    Пока Индекс >= 0 Цикл
        НайденныйФайл = НайденныеФайлы[Индекс];
        Если Не НайденныйФайл.ЭтоКаталог() Тогда
            УдалитьФайлы(НайденныйФайл.ПолноеИмя);
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьФайлJSON(ИмяФайла, Данные)

    ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");

    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(ИмяФайла, КодировкаТекста.UTF8, Ложь, ПараметрыЗаписи);
    ЗаписатьJSON(Запись, Данные);
    Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
