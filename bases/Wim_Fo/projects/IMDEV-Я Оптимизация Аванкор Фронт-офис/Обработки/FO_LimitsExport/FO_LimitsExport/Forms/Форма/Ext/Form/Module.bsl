
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КаталогВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    КаталогВыгрузки = ВыбратьКаталог(КаталогВыгрузки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)

    Если Не ЗначениеЗаполнено(КаталогВыгрузки) Тогда
        КаталогВыгрузки = ВыбратьКаталог(КаталогВыгрузки);
    КонецЕсли;

    Если Не ЗначениеЗаполнено(КаталогВыгрузки) Тогда
        Возврат;
    КонецЕсли;

    РезультатСервера = ПодготовитьАрхивНаСервере();
    Попытка
        РаспаковатьАрхив(РезультатСервера.Архив, КаталогВыгрузки);
    Исключение
        УдалитьВременныйКаталогНаСервере(РезультатСервера.КаталогСервера);
        ВызватьИсключение;
    КонецПопытки;

    УдалитьВременныйКаталогНаСервере(РезультатСервера.КаталогСервера);
    РезультатВыгрузки = СтрЗаменить(РезультатСервера.Описание, РезультатСервера.КаталогСервера, КаталогВыгрузки);
    ПоказатьПредупреждение(, РезультатВыгрузки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ВыбратьКаталог(ТекущийКаталог)

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Заголовок = "Каталог выгрузки лимитов";
    Диалог.Каталог = ТекущийКаталог;
    Если Диалог.Выбрать() Тогда
        Возврат Диалог.Каталог;
    КонецЕсли;

    Возврат ТекущийКаталог;

КонецФункции

&НаКлиенте
Процедура РаспаковатьАрхив(Архив, Каталог)

    СоздатьКаталог(Каталог);
    ИмяАрхива = Каталог;
    Если Прав(ИмяАрхива, 1) <> "\" И Прав(ИмяАрхива, 1) <> "/" Тогда
        ИмяАрхива = ИмяАрхива + "\";
    КонецЕсли;
    ИмяАрхива = ИмяАрхива + "limits_export.zip";

    Архив.Записать(ИмяАрхива);
    ЧтениеАрхива = Новый ЧтениеZipФайла(ИмяАрхива);
    ЧтениеАрхива.ИзвлечьВсе(Каталог, РежимВосстановленияПутейФайловZIP.Восстанавливать);
    ЧтениеАрхива.Закрыть();
    УдалитьФайлы(ИмяАрхива);

КонецПроцедуры

&НаСервере
Функция ПодготовитьАрхивНаСервере()

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Возврат ОбработкаОбъект.СобратьАрхивВыгрузки();

КонецФункции

&НаСервере
Процедура УдалитьВременныйКаталогНаСервере(Каталог)

    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    ОбработкаОбъект.УдалитьКаталогВыгрузки(Каталог);

КонецПроцедуры

#КонецОбласти
