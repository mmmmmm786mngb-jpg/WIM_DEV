Функция ТаблицаИтоговСверки(Сверка)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Показатель'"));
	Таблица.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Значение'"));
	ДобавитьПоказатель(Таблица, НСтр("ru = 'Совпало'"), Сверка.Совпало);
	ДобавитьПоказатель(Таблица, НСтр("ru = 'Различается'"), Сверка.Различается);
	ДобавитьПоказатель(Таблица, НСтр("ru = 'Только было'"), Сверка.ТолькоА);
	ДобавитьПоказатель(Таблица, НСтр("ru = 'Только стало'"), Сверка.ТолькоБ);
	Для Каждого КлючЗначение Из Сверка.ПоПолям Цикл
		ДобавитьПоказатель(Таблица, НСтр("ru = 'Различий в поле '") + КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	ДобавитьПоказатель(Таблица, НСтр("ru = 'Поручений совпало'"), Сверка.ПорученийСовпало);
	ДобавитьПоказатель(Таблица, НСтр("ru = 'Поручений различается'"), Сверка.ПорученийРазличается);

	Возврат Таблица;

КонецФункции

Функция ТаблицаЗон(СтрокиА, СтрокиБ)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Зона", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Зона'"));
	Таблица.Колонки.Добавить("Было", Новый ОписаниеТипов("Число"), НСтр("ru = 'Было'"));
	Таблица.Колонки.Добавить("Стало", Новый ОписаниеТипов("Число"), НСтр("ru = 'Стало'"));
	ДобавитьСтрокиПоЗонам(Таблица, СтрокиА, "Было");
	ДобавитьСтрокиПоЗонам(Таблица, СтрокиБ, "Стало");
	Таблица.Сортировать("Зона");

	Возврат Таблица;

КонецФункции

Процедура ДобавитьСтрокиПоЗонам(Таблица, Строки, ИмяКолонки)

	Для Каждого СтрокаРезультата Из Строки Цикл
		ИмяЗоны = ПредставлениеЗоны(СтрокаРезультата.Зона);
		Если СтрокаРезультата.Отказ Тогда
			ИмяЗоны = ИмяЗоны + НСтр("ru = ', отказ'");
		КонецЕсли;
		СтрокаЗоны = Таблица.Найти(ИмяЗоны, "Зона");
		Если СтрокаЗоны = Неопределено Тогда
			СтрокаЗоны = Таблица.Добавить();
			СтрокаЗоны.Зона = ИмяЗоны;
		КонецЕсли;
		СтрокаЗоны[ИмяКолонки] = СтрокаЗоны[ИмяКолонки] + 1;
	КонецЦикла;

КонецПроцедуры

Функция ТаблицаЗамеров(ЗамерыА, ЗамерыБ)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Операция", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Операция'"));
	Таблица.Колонки.Добавить("Было", Новый ОписаниеТипов("Число"), НСтр("ru = 'Было'"));
	Таблица.Колонки.Добавить("Стало", Новый ОписаниеТипов("Число"), НСтр("ru = 'Стало'"));
	Таблица.Колонки.Добавить("Разница", Новый ОписаниеТипов("Число"), НСтр("ru = 'Разница'"));
	ДобавитьЗамеры(Таблица, ЗамерыА, "Было");
	ДобавитьЗамеры(Таблица, ЗамерыБ, "Стало");
	Для Каждого СтрокаЗамера Из Таблица Цикл
		СтрокаЗамера.Разница = СтрокаЗамера.Стало - СтрокаЗамера.Было;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Процедура ДобавитьЗамеры(Таблица, Замеры, ИмяКолонки)

	Для Каждого Замер Из Замеры Цикл
		СтрокаЗамера = Таблица.Найти(Замер.Операция, "Операция");
		Если СтрокаЗамера = Неопределено Тогда
			СтрокаЗамера = Таблица.Добавить();
			СтрокаЗамера.Операция = Замер.Операция;
		КонецЕсли;
		СтрокаЗамера[ИмяКолонки] = СтрокаЗамера[ИмяКолонки] + Замер.Секунд;
	КонецЦикла;

КонецПроцедуры

// Ширины колонок отчета под самые длинные таблицы: паспорт (показатель, два значения) и расхождения (вид, лимит,
// портфель, поручение, набор данных, поле, было, стало).
//
// Параметры:
//  Документ - ТабличныйДокумент - отчет сверки
//
Процедура УстановитьШириныКолонок(Документ)

	Ширины = СтрРазделить("34,30,30,34,28,22,40,40", ",");
	Для НомерКолонки = 1 По Ширины.Количество() Цикл
		Документ.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки = Число(Ширины[НомерКолонки - 1]);
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиЗаголовок(Вывод, Текст)

	Вывод.НомерСтроки = Вывод.НомерСтроки + 2;
	Ячейка = Вывод.Документ.Область(Вывод.НомерСтроки, 1, Вывод.НомерСтроки, 1);
	Ячейка.Текст = Текст;
	Ячейка.Шрифт = Новый Шрифт(, 11, Истина);

КонецПроцедуры

Процедура ВывестиТекст(Вывод, Текст)

	Для Каждого Часть Из СтрРазделить(Текст, Символы.ПС) Цикл
		Вывод.НомерСтроки = Вывод.НомерСтроки + 1;
		Вывод.Документ.Область(Вывод.НомерСтроки, 1, Вывод.НомерСтроки, 1).Текст = Часть;
	КонецЦикла;

КонецПроцедуры

Процедура ВывестиТаблицу(Вывод, Таблица)

	Вывод.НомерСтроки = Вывод.НомерСтроки + 1;
	Для НомерКолонки = 0 По Таблица.Колонки.Количество() - 1 Цикл
		Колонка = Таблица.Колонки[НомерКолонки];
		Ячейка = Вывод.Документ.Область(Вывод.НомерСтроки, НомерКолонки + 1, Вывод.НомерСтроки, НомерКолонки + 1);
		Если ЗначениеЗаполнено(Колонка.Заголовок) Тогда
			Ячейка.Текст = Колонка.Заголовок;
		Иначе
			Ячейка.Текст = Колонка.Имя;
		КонецЕсли;
		Ячейка.Шрифт = Новый Шрифт(, , Истина);
		Ячейка.ЦветФона = WebЦвета.СветлоСерый;
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Вывод.НомерСтроки = Вывод.НомерСтроки + 1;
		Для НомерКолонки = 0 По Таблица.Колонки.Количество() - 1 Цикл
			Ячейка = Вывод.Документ.Область(Вывод.НомерСтроки, НомерКолонки + 1, Вывод.НомерСтроки, НомерКолонки + 1);
			Ячейка.Текст = ПредставлениеЗначения(СтрокаТаблицы[НомерКолонки]);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоказатель(Таблица, Показатель, Значение)

	СтрокаПоказателя = Таблица.Добавить();
	СтрокаПоказателя.Показатель = Показатель;
	СтрокаПоказателя.Значение   = ЧислоСтрокой(Значение);

