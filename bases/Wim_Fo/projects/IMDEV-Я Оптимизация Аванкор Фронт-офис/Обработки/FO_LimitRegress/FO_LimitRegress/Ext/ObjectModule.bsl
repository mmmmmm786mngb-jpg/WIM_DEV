#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Описание обработки для подсистемы БСП "Дополнительные отчеты и обработки".
//
// Возвращаемое значение:
//  Структура - см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Функция СведенияОВнешнейОбработке() Экспорт

	МетаданныеОбработки = Метаданные();

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.БезопасныйРежим = Истина;

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = МетаданныеОбработки.Представление();
	НоваяКоманда.Идентификатор = МетаданныеОбработки.Имя;
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Последние проверки лимитов (регламент по портфелям и проверки поручений) по описаниям вместилищ.
// Вид проверки и число проверок берутся из текста описания ("Объектов: N; Проверок: M" или
// "Поручений: N; Проверок: M"), без чтения строк результата: на больших базах пересчет строк долгий.
// Ничего не записывает.
//
// Параметры:
//  Количество - Число - сколько последних проверок вернуть
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Вместилище - УникальныйИдентификатор - идентификатор проверки
//   * Дата - Дата - начало проверки
//   * ДатаПроверки - Дата - дата, на которую проверялись лимиты
//   * ВидПроверки - Строка - "Поручения", "Портфели", "Архив" (результат упакован, вид определяется при снимке)
//                            или "Нет строк" (проверка без строк результата, например отказ до проверки)
//   * Строк - Число - число проверок из описания проверки (0, если в описании его нет)
//   * Архив - Булево - результат упакован в описание вместилища
//   * Отказ - Булево - проверка завершилась отказом
//   * Тестирование - Булево - проверка в режиме тестирования
//   * Описание - Строка - описание проверки
//
Функция ПоследниеПроверки(Количество = 50) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Вместилище", Новый ОписаниеТипов("УникальныйИдентификатор"));
	Результат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ДатаПроверки", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ВидПроверки", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Строк", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Архив", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Отказ", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Тестирование", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
	|	Описания.Вместилище КАК Вместилище,
	|	Описания.Дата КАК Дата,
	|	Описания.ДатаПроверки КАК ДатаПроверки,
	|	Описания.Архив КАК Архив,
	|	Описания.Отказ КАК Отказ,
	|	Описания.Тестирование КАК Тестирование,
	|	ПОДСТРОКА(Описания.Описание, 1, 300) КАК Описание
	|ИЗ
	|	РегистрСведений.КэшВмОписания КАК Описания
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 50", "ПЕРВЫЕ " + Формат(Количество, "ЧГ="));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Строк = ЧислоПослеМетки(Выборка.Описание, "Проверок:");
		Если СтрНачинаетсяС(Выборка.Описание, "Поручений:") Тогда
			Строка.ВидПроверки = ВидПроверкиПоручения();
		ИначеЕсли СтрНачинаетсяС(Выборка.Описание, "Объектов:") Тогда
			Строка.ВидПроверки = ВидПроверкиПортфели();
		ИначеЕсли Выборка.Архив Тогда
			Строка.ВидПроверки = НСтр("ru = 'Архив'");
		Иначе
			Строка.ВидПроверки = НСтр("ru = 'Нет строк'");
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Снимок результата проверки для фонового задания: помещает во временное хранилище структуру с двоичными данными
// файла снимка, предлагаемым именем файла и текстом паспорта.
//
// Параметры:
//  Параметры - Структура:
//   * Вместилище - УникальныйИдентификатор - идентификатор проверки
//  АдресХранилища - Строка - адрес результата
//
Процедура СнятьСнимокВФоне(Параметры, АдресХранилища) Экспорт

	ПоместитьВоВременноеХранилище(РезультатСнимка(Параметры.Вместилище), АдресХранилища);

КонецПроцедуры

// Снимок результата проверки: двоичные данные файла, имя файла и текст паспорта.
//
// Параметры:
//  Вместилище - УникальныйИдентификатор - идентификатор проверки
//
// Возвращаемое значение:
//  Структура:
//   * ДвоичныеДанные - ДвоичныеДанные - содержимое файла снимка
//   * ИмяФайла - Строка - предлагаемое имя файла
//   * Паспорт - Строка - текст паспорта снимка
//
Функция РезультатСнимка(Вместилище) Экспорт

	Снимок = СнимокПроверки(Вместилище);

	Результат = Новый Структура;
	Результат.Вставить("ДвоичныеДанные", ДвоичныеДанныеСнимка(Снимок));
	Результат.Вставить("ИмяФайла", ИмяФайлаСнимка(Снимок.Паспорт));
	Результат.Вставить("Паспорт", ПредставлениеПаспорта(Снимок.Паспорт));

	Возврат Результат;

КонецФункции

// Сверка двух снимков для фонового задания: помещает во временное хранилище результат, см. РезультатСверки.
//
// Параметры:
//  Параметры - Структура:
//   * ДанныеА - ДвоичныеДанные - файл снимка "было"
//   * ДанныеБ - ДвоичныеДанные - файл снимка "стало"
//  АдресХранилища - Строка - адрес результата
//
Процедура СверитьВФоне(Параметры, АдресХранилища) Экспорт

	ПоместитьВоВременноеХранилище(РезультатСверки(Параметры.ДанныеА, Параметры.ДанныеБ), АдресХранилища);

КонецПроцедуры

// Сверка двух файлов снимков.
//
// Параметры:
//  ДанныеА - ДвоичныеДанные - снимок "было"
//  ДанныеБ - ДвоичныеДанные - снимок "стало"
//
// Возвращаемое значение:
//  Структура:
//   * Итог - Строка - краткий итог сверки
//   * Отчет - ТабличныйДокумент - отчет сверки
//   * НетРасхождений - Булево - Истина, если результаты совпали
//   * Замеры - ТаблицаЗначений - время шагов проверки: Операция, Было, Стало, Разница (секунд)
//
Функция РезультатСверки(ДанныеА, ДанныеБ) Экспорт

	СнимокА = СнимокИзДвоичныхДанных(ДанныеА);
	СнимокБ = СнимокИзДвоичныхДанных(ДанныеБ);
	Сверка = СверитьСнимки(СнимокА, СнимокБ);

	Результат = Новый Структура;
	Результат.Вставить("Итог", ТекстИтога(Сверка));
	Результат.Вставить("Отчет", ОтчетСверки(СнимокА, СнимокБ, Сверка));
	Результат.Вставить("НетРасхождений", Сверка.НетРасхождений);
	Результат.Вставить("Замеры", ТаблицаЗамеров(СнимокА.Замеры, СнимокБ.Замеры));

	Возврат Результат;

КонецФункции

// Снимок результата проверки лимитов: паспорт, строки результата по каждой паре "лимит - фокус - поручение -
// набор", итог по поручениям (для проверки поручений) и замеры времени шагов. Все ссылки хранятся как уникальные
// идентификаторы и представления, снимок не зависит от базы. Читает активные регистры кэша или архив вместилища.
//
// Параметры:
//  Вместилище - УникальныйИдентификатор - идентификатор проверки
//
// Возвращаемое значение:
//  Структура:
//   * Формат - Строка - "FO_LimitRegress"
//   * ВерсияФормата - Число
//   * Паспорт - Структура - см. ПаспортПроверки
//   * Строки - ТаблицаЗначений - см. НоваяТаблицаСтрок
//   * Поручения - ТаблицаЗначений - см. НоваяТаблицаПоручений
//   * Замеры - ТаблицаЗначений - колонки Операция, Секунд, Вес
//
Функция СнимокПроверки(Вместилище) Экспорт

	ДанныеОписания = ДанныеОписанияВместилища(Вместилище);
	Если ДанныеОписания = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Проверка %1 не найдена в описаниях вместилищ.'"), Вместилище);
	КонецЕсли;

	Строки = СтрокиРезультата(Вместилище, ДанныеОписания);
	Замеры = ЗамерыПроверки(ДанныеОписания.Дата, Строки.Количество());

	ЕстьПоручения = Строки.НайтиСтроки(Новый Структура("ЕстьПоручение", Истина)).Количество() > 0;
	Строки.Колонки.Удалить("ЕстьПоручение");
	Если ЕстьПоручения Тогда
		Поручения = ИтогиПоПоручениям(Строки, ДанныеОписания.Дата, Замеры);
		ВидПроверки = ВидПроверкиПоручения();
	Иначе
		Поручения = НоваяТаблицаПоручений();
		ВидПроверки = ВидПроверкиПортфели();
	КонецЕсли;

	Паспорт = ПаспортПроверки(Вместилище, ДанныеОписания, ВидПроверки, Строки, Поручения);

	Снимок = Новый Структура;
	Снимок.Вставить("Формат", ФорматСнимка());
	Снимок.Вставить("ВерсияФормата", 1);
	Снимок.Вставить("Паспорт", Паспорт);
	Снимок.Вставить("Строки", Строки);
	Снимок.Вставить("Поручения", Поручения);
	Снимок.Вставить("Замеры", Замеры.Таблица);

	Возврат Снимок;

КонецФункции

// Двоичные данные файла снимка. Файл - внутренняя строка структуры с форматом, паспортом и сжатым хранилищем
// снимка: паспорт читается без распаковки строк результата.
//
// Параметры:
//  Снимок - Структура - см. СнимокПроверки
//
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция ДвоичныеДанныеСнимка(Снимок) Экспорт

	Файл = Новый Структура;
	Файл.Вставить("Формат", ФорматСнимка());
	Файл.Вставить("ВерсияФормата", Снимок.ВерсияФормата);
	Файл.Вставить("Паспорт", Снимок.Паспорт);
	Файл.Вставить("Данные", Новый ХранилищеЗначения(Снимок, Новый СжатиеДанных(9)));

	Возврат ПолучитьДвоичныеДанныеИзСтроки(ЗначениеВСтрокуВнутр(Файл), КодировкаТекста.UTF8);

КонецФункции

// Восстанавливает снимок из двоичных данных файла.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла снимка
//
// Возвращаемое значение:
//  Структура - см. СнимокПроверки
//
Функция СнимокИзДвоичныхДанных(ДвоичныеДанные) Экспорт

	Возврат ФайлСнимка(ДвоичныеДанные).Данные.Получить();

КонецФункции

// Текст паспорта снимка из файла без распаковки строк результата.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла снимка
//
// Возвращаемое значение:
//  Строка
//
Функция ПаспортФайлаСнимка(ДвоичныеДанные) Экспорт

	Возврат ПредставлениеПаспорта(ФайлСнимка(ДвоичныеДанные).Паспорт);

КонецФункции

// Сверка двух снимков по ключу "лимит - фокус - поручение - набор - номер повтора": строки только в одном
// снимке и различия по каждому сравниваемому полю; итоги по поручениям; сводка по зонам; сопоставимость паспортов.
//
// Параметры:
//  СнимокА - Структура - снимок "было", см. СнимокПроверки
//  СнимокБ - Структура - снимок "стало"
//
// Возвращаемое значение:
//  Структура:
//   * НетРасхождений - Булево
//   * Совпало - Число - строк результата без различий
//   * ТолькоА - Число
//   * ТолькоБ - Число
//   * Различается - Число - строк с различием хотя бы в одном поле
//   * ПоПолям - Соответствие из КлючИЗначение - ключ: имя поля, значение: число различий
//   * Расхождения - ТаблицаЗначений - см. НоваяТаблицаРасхождений
//   * ПорученийСовпало - Число
//   * ПорученийРазличается - Число
//   * Предупреждения - Массив из Строка - несопоставимость паспортов
//
Функция СверитьСнимки(СнимокА, СнимокБ) Экспорт

	Сверка = Новый Структура;
	Сверка.Вставить("Совпало", 0);
	Сверка.Вставить("ТолькоА", 0);
	Сверка.Вставить("ТолькоБ", 0);
	Сверка.Вставить("Различается", 0);
	Сверка.Вставить("ПоПолям", Новый Соответствие);
	Сверка.Вставить("Расхождения", НоваяТаблицаРасхождений());
	Сверка.Вставить("ПорученийСовпало", 0);
	Сверка.Вставить("ПорученийРазличается", 0);
	Сверка.Вставить("Предупреждения", ПредупрежденияСопоставимости(СнимокА.Паспорт, СнимокБ.Паспорт));

	СверитьСтроки(СнимокА.Строки, СнимокБ.Строки, Сверка);
	СверитьПоручения(СнимокА.Поручения, СнимокБ.Поручения, Сверка);

	Сверка.Вставить("НетРасхождений", Сверка.ТолькоА = 0 И Сверка.ТолькоБ = 0 И Сверка.Различается = 0
		И Сверка.ПорученийРазличается = 0);

	Возврат Сверка;

КонецФункции

// Двоичные данные табличного документа в формате Excel (xlsx), без записи на диск сервера.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент
//
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция ДвоичныеДанныеXLSX(ТабличныйДокумент) Экспорт

	Поток = Новый ПотокВПамяти;
	ТабличныйДокумент.Записать(Поток, ТипФайлаТабличногоДокумента.XLSX);

	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Снимок

Функция ДанныеОписанияВместилища(Вместилище)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Описания.Дата КАК Дата,
	|	Описания.ДатаПроверки КАК ДатаПроверки,
	|	Описания.Описание КАК Описание,
	|	Описания.Отказ КАК Отказ,
	|	Описания.Тестирование КАК Тестирование,
	|	Описания.Версия КАК Версия,
	|	Описания.Архив КАК Архив,
	|	Описания.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.КэшВмОписания КАК Описания
	|ГДЕ
	|	Описания.Вместилище = &Вместилище";
	Запрос.УстановитьПараметр("Вместилище", Вместилище);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Дата, ДатаПроверки, Описание, Отказ, Тестирование, Версия, Архив, Значение");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);

	Возврат Результат;

КонецФункции

// Строки результата проверки из регистра КэшВмКратко или из архива вместилища, с представлениями ссылок.
//
Функция СтрокиРезультата(Вместилище, ДанныеОписания)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Вместилище", Вместилище);

	Если ДанныеОписания.Архив Тогда
		Архив = ДанныеОписания.Значение.Получить();
		ТаблицаАрхива = Архив.КэшВмКратко.Скопировать(Новый Структура("Вместилище", Вместилище),
			ИменаКолонокСтрок());
		Запрос.УстановитьПараметр("ТаблицаАрхива", ТаблицаАрхива);
		НачалоТекста = "ВЫБРАТЬ";
		ИсточникТекста =
		"ИЗ
		|	&ТаблицаАрхива КАК Кратко";
	Иначе
		НачалоТекста = "ВЫБРАТЬ РАЗРЕШЕННЫЕ";
		ИсточникТекста =
		"ИЗ
		|	РегистрСведений.КэшВмКратко КАК Кратко
		|ГДЕ
		|	Кратко.Вместилище = &Вместилище";
	КонецЕсли;

	ТекстПолей =
	"	Кратко.Лимит КАК Лимит,
	|	Кратко.Фокус КАК Фокус,
	|	Кратко.Поручение КАК Поручение,
	|	Кратко.НаборДанных КАК НаборДанных,
	|	Кратко.Зона КАК Зона,
	|	Кратко.ЗонаПорогов КАК ЗонаПорогов,
	|	Кратко.Отказ КАК Отказ,
	|	Кратко.Описание КАК Описание,
	|	Кратко.Базис КАК Базис,
	|	Кратко.ПроцентПорогаМакс КАК ПроцентПорогаМакс,
	|	Кратко.ПроцентПорогаМаксНулевой КАК ПроцентПорогаМаксНулевой,
	|	Кратко.ПроцентПорогаМин КАК ПроцентПорогаМин,
	|	Кратко.ФиксированнаяСуммаМакс КАК ФиксированнаяСуммаМакс,
	|	Кратко.ФиксированнаяСуммаМаксНулевой КАК ФиксированнаяСуммаМаксНулевой,
	|	Кратко.ФиксированнаяСуммаМин КАК ФиксированнаяСуммаМин,
	|	Кратко.ФиксированноеКоличествоМакс КАК ФиксированноеКоличествоМакс,
	|	Кратко.ФиксированноеКоличествоМаксНулевой КАК ФиксированноеКоличествоМаксНулевой,
	|	Кратко.ФиксированноеКоличествоМин КАК ФиксированноеКоличествоМин,
	|	Кратко.ПустаяПозиция КАК ПустаяПозиция,
	|	Кратко.ОшибкаСбораДанных КАК ОшибкаСбораДанных,
	|	Кратко.ПроверкаПропущена КАК ПроверкаПропущена
	|ПОМЕСТИТЬ ВТ_Кратко";

	Запрос.Текст = НачалоТекста + Символы.ПС + ТекстПолей + Символы.ПС + ИсточникТекста;
	Запрос.Выполнить();

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кратко.*,
	|	ПРЕДСТАВЛЕНИЕ(Кратко.Лимит) КАК ЛимитПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Кратко.Фокус) КАК ФокусПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Кратко.Поручение) КАК ПоручениеПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Кратко.НаборДанных) КАК НаборДанныхПредставление
	|ИЗ
	|	ВТ_Кратко КАК Кратко";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Строки = НоваяТаблицаСтрок();
	Строки.Колонки.Добавить("ЕстьПоручение", Новый ОписаниеТипов("Булево"));
	ПоляЧисел = ЧисловыеПоля();
	ПоляБулево = БулевыПоля();
	Пока Выборка.Следующий() Цикл
		Строка = Строки.Добавить();
		Строка.ЛимитИд = ИдентификаторСсылки(Выборка.Лимит);
		Строка.Лимит = Выборка.ЛимитПредставление;
		Строка.ФокусИд = ИдентификаторФокуса(Выборка.Фокус);
		Строка.Фокус = Выборка.ФокусПредставление;
		Строка.ПоручениеИд = ИдентификаторСсылки(Выборка.Поручение);
		Строка.Поручение = Выборка.ПоручениеПредставление;
		Строка.ЕстьПоручение = ЗначениеЗаполнено(Выборка.Поручение);
		Строка.НаборДанныхИд = ИдентификаторСсылки(Выборка.НаборДанных);
		Строка.НаборДанных = Выборка.НаборДанныхПредставление;
		Строка.Зона = ИмяЗоны(Выборка.Зона);
		Строка.ЗонаПорогов = ИмяЗоны(Выборка.ЗонаПорогов);
		Строка.Отказ = Выборка.Отказ;
		Строка.Описание = Лев(Выборка.Описание, 1000);
		Строка.ОписаниеКонтроль = КонтрольнаяСуммаТекста(Выборка.Описание);
		Строка.ОписаниеДлина = СтрДлина(Выборка.Описание);
		Для Каждого Поле Из ПоляЧисел Цикл
			Если ТипЗнч(Выборка[Поле]) = Тип("Число") Тогда
				Строка[Поле] = Выборка[Поле];
			КонецЕсли;
		КонецЦикла;
		Для Каждого Поле Из ПоляБулево Цикл
			Строка[Поле] = Выборка[Поле];
		КонецЦикла;
		Строка.КлючОснова = Строка.ЛимитИд + "|" + Строка.ФокусИд + "|" + Строка.ПоручениеИд + "|"
			+ Строка.НаборДанныхИд;
	КонецЦикла;

	ПронумероватьПовторыКлюча(Строки);

	Возврат Строки;

КонецФункции

// Строки с одинаковой основой ключа получают номер повтора после упорядочивания по значениям полей, чтобы
// одинаковые наборы повторов в двух снимках сопоставлялись независимо от порядка записи.
//
Процедура ПронумероватьПовторыКлюча(Строки)

	Строки.Сортировать("КлючОснова, Зона, ЗонаПорогов, ОписаниеКонтроль, Базис");
	КлючПредыдущий = Неопределено;
	Номер = 0;
	Для Каждого Строка Из Строки Цикл
		Если Строка.КлючОснова = КлючПредыдущий Тогда
			Номер = Номер + 1;
		Иначе
			Номер = 0;
			КлючПредыдущий = Строка.КлючОснова;
		КонецЕсли;
		Строка.Ключ = Строка.КлючОснова + "#" + Формат(Номер, "ЧН=0; ЧГ=");
	КонецЦикла;

КонецПроцедуры

// Итог по каждому поручению проверки: последнее событие "Проверка поручений" в интервале проверки (текст, который
// показывает окно результата обработки поручений) и статус поручения на момент снимка.
//
Функция ИтогиПоПоручениям(Строки, НачалоПроверки, Замеры)

	Поручения = НоваяТаблицаПоручений();

	Представления = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Если ЗначениеЗаполнено(Строка.ПоручениеИд) Тогда
			Представления.Вставить(Строка.ПоручениеИд, Строка.Поручение);
		КонецЕсли;
	КонецЦикла;
	Ссылки = Новый Массив;
	Для Каждого КлючЗначение Из Представления Цикл
		Ссылки.Добавить(Документы.Поручение.ПолучитьСсылку(Новый УникальныйИдентификатор(КлючЗначение.Ключ)));
	КонецЦикла;

	КонецПроверки = НачалоПроверки + Макс(Замеры.Секунд, 0) + 120;
	Если Замеры.Секунд = 0 Тогда
		КонецПроверки = НачалоПроверки + 4 * 3600;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	События.Поручение КАК Поручение,
	|	События.Дата КАК Дата,
	|	События.Миллисекунды КАК Миллисекунды,
	|	События.Описание КАК Описание
	|ИЗ
	|	РегистрСведений.СобытияПоручений КАК События
	|ГДЕ
	|	События.Поручение В (&Поручения)
	|	И События.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийПоручения.ПроверкаПоручений)
	|	И События.Дата МЕЖДУ &Начало И &Конец
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Миллисекунды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Статусы.Поручение КАК Поручение,
	|	ПРЕДСТАВЛЕНИЕ(Статусы.Статус) КАК Статус
	|ИЗ
	|	РегистрСведений.СтатусыПоручений КАК Статусы
	|ГДЕ
	|	Статусы.Поручение В (&Поручения)";
	Запрос.УстановитьПараметр("Поручения", Ссылки);
	Запрос.УстановитьПараметр("Начало", НачалоПроверки - 60);
	Запрос.УстановитьПараметр("Конец", КонецПроверки);
	Результаты = Запрос.ВыполнитьПакет();

	Итоги = Новый Соответствие;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Итоги.Вставить(ИдентификаторСсылки(Выборка.Поручение), Выборка.Описание);
	КонецЦикла;
	Статусы = Новый Соответствие;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Статусы.Вставить(ИдентификаторСсылки(Выборка.Поручение), Выборка.Статус);
	КонецЦикла;

	Для Каждого КлючЗначение Из Представления Цикл
		Строка = Поручения.Добавить();
		Строка.ПоручениеИд = КлючЗначение.Ключ;
		Строка.Поручение = КлючЗначение.Значение;
		ТекстИтога = Итоги[КлючЗначение.Ключ];
		Если ТекстИтога = Неопределено Тогда
			ТекстИтога = "";
		КонецЕсли;
		Строка.Итог = Лев(ТекстИтога, 1000);
		Строка.ИтогКонтроль = КонтрольнаяСуммаТекста(ТекстИтога);
		Строка.Статус = Статусы[КлючЗначение.Ключ];
	КонецЦикла;
	Поручения.Сортировать("ПоручениеИд");

	Возврат Поручения;

КонецФункции

// Замеры времени проверки по регистру "Замеры времени": замер "Проверка", начавшийся рядом с началом проверки
// (при нескольких - с весом, равным числу строк), и замеры шагов того же сеанса внутри него.
//
// Возвращаемое значение:
//  Структура:
//   * Таблица - ТаблицаЗначений - колонки Операция, Секунд, Вес
//   * Секунд - Число - длительность замера "Проверка", 0 - не найден
//
Функция ЗамерыПроверки(НачалоПроверки, Строк)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Операция", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Секунд", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	Результат = Новый Структура("Таблица, Секунд", Таблица, 0);

	НачалоUTC = УниверсальноеВремя(НачалоПроверки, ЧасовойПоясСеанса());
	НачалоМс = (НачалоUTC - Дата(1, 1, 1)) * 1000;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Замеры.НомерСеанса КАК НомерСеанса,
	|	Замеры.ДатаНачалаЗамера КАК ДатаНачалаЗамера,
	|	Замеры.ДатаОкончания КАК ДатаОкончания,
	|	Замеры.ВремяВыполнения КАК ВремяВыполнения,
	|	Замеры.ВесЗамера КАК ВесЗамера
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Замеры
	|ГДЕ
	|	Замеры.КлючеваяОперация = ЗНАЧЕНИЕ(Справочник.КлючевыеОперации.Проверка)
	|	И Замеры.ДатаЗаписиНачалоЧаса МЕЖДУ &ЧасОт И &ЧасДо
	|	И Замеры.ДатаНачалаЗамера МЕЖДУ &МсОт И &МсДо";
	Запрос.УстановитьПараметр("ЧасОт", НачалоЧаса(НачалоUTC) - 3600);
	Запрос.УстановитьПараметр("ЧасДо", НачалоЧаса(НачалоUTC) + 12 * 3600);
	Запрос.УстановитьПараметр("МсОт", НачалоМс - 300000);
	Запрос.УстановитьПараметр("МсДо", НачалоМс + 300000);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Лучший = Неопределено;
	ЛучшаяОценка = 0;
	Пока Выборка.Следующий() Цикл
		Оценка = Макс(Выборка.ДатаНачалаЗамера - НачалоМс, НачалоМс - Выборка.ДатаНачалаЗамера);
		Если Выборка.ВесЗамера <> Строк Тогда
			Оценка = Оценка + 1000000000;
		КонецЕсли;
		Если Лучший = Неопределено Или Оценка < ЛучшаяОценка Тогда
			Лучший = Новый Структура("НомерСеанса, ДатаНачалаЗамера, ДатаОкончания, ВремяВыполнения, ВесЗамера");
			ЗаполнитьЗначенияСвойств(Лучший, Выборка);
			ЛучшаяОценка = Оценка;
		КонецЕсли;
	КонецЦикла;
	Если Лучший = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Секунд = Лучший.ВремяВыполнения;

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПРЕДСТАВЛЕНИЕ(Замеры.КлючеваяОперация) КАК Операция,
	|	Замеры.ВремяВыполнения КАК Секунд,
	|	Замеры.ВесЗамера КАК Вес
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Замеры
	|ГДЕ
	|	Замеры.НомерСеанса = &НомерСеанса
	|	И Замеры.ДатаЗаписиНачалоЧаса МЕЖДУ &ЧасОт И &ЧасДо
	|	И Замеры.ДатаНачалаЗамера МЕЖДУ &МсОт И &МсДо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Замеры.ДатаНачалаЗамера";
	Запрос.УстановитьПараметр("НомерСеанса", Лучший.НомерСеанса);
	Запрос.УстановитьПараметр("МсОт", Лучший.ДатаНачалаЗамера);
	Запрос.УстановитьПараметр("МсДо", Макс(Лучший.ДатаОкончания, Лучший.ДатаНачалаЗамера));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Выборка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПаспортПроверки(Вместилище, ДанныеОписания, ВидПроверки, Строки, Поручения)

	Паспорт = Новый Структура;
	Паспорт.Вставить("Вместилище", Строка(Вместилище));
	Паспорт.Вставить("ВидПроверки", ВидПроверки);
	Паспорт.Вставить("НачалоПроверки", ДанныеОписания.Дата);
	Паспорт.Вставить("ДатаПроверки", ДанныеОписания.ДатаПроверки);
	Паспорт.Вставить("Отказ", ДанныеОписания.Отказ);
	Паспорт.Вставить("Тестирование", ДанныеОписания.Тестирование);
	Паспорт.Вставить("Архив", ДанныеОписания.Архив);
	Паспорт.Вставить("ВерсияКонфигурации", Метаданные.Версия);
	Паспорт.Вставить("ВерсияВместилища", ДанныеОписания.Версия);
	Паспорт.Вставить("РасширенияСеансаСнимка", АктивныеРасширения());
	Паспорт.Вставить("Строк", Строки.Количество());
	Паспорт.Вставить("Поручений", Поручения.Количество());
	Паспорт.Вставить("ДатаСнимка", ТекущаяДатаСеанса());
	Паспорт.Вставить("ВерсияОбработки", ВерсияОбработки());

	Возврат Паспорт;

КонецФункции

// Имена и версии расширений, активных в сеансе снимка. Список расширений читается только при наличии прав на
// администрирование расширений; без них возвращается пояснение, снимок при этом снимается.
//
// Возвращаемое значение:
//  Строка
//
Функция АктивныеРасширения()

	Попытка
		СписокРасширений = РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.СеансАктивные);
	Исключение
		Возврат НСтр("ru = 'нет прав на чтение списка расширений'");
	КонецПопытки;

	Имена = Новый Массив;
	Для Каждого Расширение Из СписокРасширений Цикл
		Если ЗначениеЗаполнено(Расширение.Версия) Тогда
			Имена.Добавить(Расширение.Имя + " " + Расширение.Версия);
		Иначе
			Имена.Добавить(Расширение.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Имена, ", ");

КонецФункции

// Структура файла снимка с проверкой формата, см. ДвоичныеДанныеСнимка.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла снимка
//
// Возвращаемое значение:
//  Структура - Формат, ВерсияФормата, Паспорт, Данные
//
Функция ФайлСнимка(ДвоичныеДанные)

	НеверныйФормат = НСтр("ru = 'Файл не является снимком проверки лимитов.'");
	Попытка
		Файл = ЗначениеИзСтрокиВнутр(ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8));
	Исключение
		ВызватьИсключение НеверныйФормат;
	КонецПопытки;

	Если ТипЗнч(Файл) <> Тип("Структура") Или Не Файл.Свойство("Формат") Или Файл.Формат <> ФорматСнимка() Тогда
		ВызватьИсключение НеверныйФормат;
	КонецЕсли;

	Возврат Файл;

КонецФункции

Функция ИмяФайлаСнимка(Паспорт)

	Возврат СтрШаблон("Снимок_%1_%2_%3стр.flr", Паспорт.ВидПроверки,
		Формат(Паспорт.НачалоПроверки, "ДФ=yyyyMMdd_HHmmss"), Формат(Паспорт.Строк, "ЧГ="));

КонецФункции

Функция ПредставлениеПаспорта(Паспорт)

	Поручений = "";
	Если Паспорт.Поручений > 0 Тогда
		Поручений = СтрШаблон(НСтр("ru = ', поручений %1'"), Паспорт.Поручений);
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Проверка: %1, начало %2, строк %3%4'"), Паспорт.ВидПроверки,
		Формат(Паспорт.НачалоПроверки, "ДЛФ=DT"), Формат(Паспорт.Строк, "ЧГ=3,0; ЧН=0"), Поручений));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Дата проверки лимитов: %1; конфигурация %2'"),
		Формат(Паспорт.ДатаПроверки, "ДЛФ=D; ДП='не указана'"), Паспорт.ВерсияКонфигурации));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Расширения сеанса снимка: %1'"), Паспорт.РасширенияСеансаСнимка));
	Если Паспорт.Отказ Тогда
		Части.Добавить(НСтр("ru = 'Проверка завершилась отказом'"));
	КонецЕсли;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Сверка

// Сопоставляет строки двух снимков по ключу и накапливает в структуре сверки счетчики и расхождения по полям.
// Одинаковые значения сравниваются напрямую, функция сравнения с допуском вызывается только для различающихся.
//
// Параметры:
//  СтрокиА - ТаблицаЗначений - строки снимка "было", см. НоваяТаблицаСтрок
//  СтрокиБ - ТаблицаЗначений - строки снимка "стало"
//  Сверка - Структура - см. СверитьСнимки
//
Процедура СверитьСтроки(СтрокиА, СтрокиБ, Сверка)

	Поля = СравниваемыеПоля();
	ИндексБ = Новый Соответствие;
	Для Каждого СтрокаБ Из СтрокиБ Цикл
		ИндексБ.Вставить(СтрокаБ.Ключ, СтрокаБ);
	КонецЦикла;
	Сопоставленные = Новый Соответствие;

	Для Каждого СтрокаА Из СтрокиА Цикл
		СтрокаБ = ИндексБ[СтрокаА.Ключ];
		Если СтрокаБ = Неопределено Тогда
			Сверка.ТолькоА = Сверка.ТолькоА + 1;
			ДобавитьРасхождение(Сверка, НСтр("ru = 'Только было'"), СтрокаА, "", ОписаниеСтроки(СтрокаА), "");
			Продолжить;
		КонецЕсли;
		Сопоставленные.Вставить(СтрокаА.Ключ, Истина);

		ЕстьРазличие = Ложь;
		Для Каждого Поле Из Поля Цикл
			Если СтрокаА[Поле] = СтрокаБ[Поле] Или ЧислаРавны(СтрокаА[Поле], СтрокаБ[Поле]) Тогда
				Продолжить;
			КонецЕсли;
			ЕстьРазличие = Истина;
			ДобавитьРазличиеПоля(Сверка, СтрокаА, Поле, ЗначениеПоля(СтрокаА, Поле), ЗначениеПоля(СтрокаБ, Поле));
		КонецЦикла;
		Если Не ОписанияРавны(СтрокаА, СтрокаБ) Тогда
			ЕстьРазличие = Истина;
			ДобавитьРазличиеПоля(Сверка, СтрокаА, "Описание", СтрокаА.Описание, СтрокаБ.Описание);
		КонецЕсли;

		Если ЕстьРазличие Тогда
			Сверка.Различается = Сверка.Различается + 1;
		Иначе
			Сверка.Совпало = Сверка.Совпало + 1;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаБ Из СтрокиБ Цикл
		Если Сопоставленные[СтрокаБ.Ключ] = Неопределено Тогда
			Сверка.ТолькоБ = Сверка.ТолькоБ + 1;
			ДобавитьРасхождение(Сверка, НСтр("ru = 'Только стало'"), СтрокаБ, "", "", ОписаниеСтроки(СтрокаБ));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Сравнивает итог проверки и статус каждого поручения, которое есть в обоих снимках.
//
// Параметры:
//  ПорученияА - ТаблицаЗначений - поручения снимка "было", см. НоваяТаблицаПоручений
//  ПорученияБ - ТаблицаЗначений - поручения снимка "стало"
//  Сверка - Структура - см. СверитьСнимки
//
Процедура СверитьПоручения(ПорученияА, ПорученияБ, Сверка)

	ИндексБ = Новый Соответствие;
	Для Каждого СтрокаБ Из ПорученияБ Цикл
		ИндексБ.Вставить(СтрокаБ.ПоручениеИд, СтрокаБ);
	КонецЦикла;

	Для Каждого СтрокаА Из ПорученияА Цикл
		СтрокаБ = ИндексБ[СтрокаА.ПоручениеИд];
		Если СтрокаБ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИтогРавен = СтрокаА.ИтогКонтроль = СтрокаБ.ИтогКонтроль И СтрокаА.Итог = СтрокаБ.Итог;
		Если ИтогРавен И СтрокаА.Статус = СтрокаБ.Статус Тогда
			Сверка.ПорученийСовпало = Сверка.ПорученийСовпало + 1;
			Продолжить;
		КонецЕсли;
		Сверка.ПорученийРазличается = Сверка.ПорученийРазличается + 1;
		Если СтрокаА.Статус <> СтрокаБ.Статус Тогда
			ДобавитьРасхождениеПоручения(Сверка, СтрокаА, НСтр("ru = 'Статус поручения'"), СтрокаА.Статус,
				СтрокаБ.Статус);
		КонецЕсли;
		Если Не ИтогРавен Тогда
			ДобавитьРасхождениеПоручения(Сверка, СтрокаА, НСтр("ru = 'Итог проверки поручения'"), СтрокаА.Итог,
				СтрокаБ.Итог);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Равенство чисел с допуском на округление; для значений других типов - Ложь.
//
// Параметры:
//  ЗначениеА - Произвольный
//  ЗначениеБ - Произвольный
//
// Возвращаемое значение:
//  Булево
//
Функция ЧислаРавны(ЗначениеА, ЗначениеБ)

	Если ТипЗнч(ЗначениеА) <> Тип("Число") Или ТипЗнч(ЗначениеБ) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Макс(ЗначениеА - ЗначениеБ, ЗначениеБ - ЗначениеА) <= ДопускЧисел();

КонецФункции

// Равенство текстов описания строки результата: по контрольной сумме и длине полного текста и по сохраненной
// в снимке части текста.
//
// Параметры:
//  СтрокаА - СтрокаТаблицыЗначений - см. НоваяТаблицаСтрок
//  СтрокаБ - СтрокаТаблицыЗначений
//
// Возвращаемое значение:
//  Булево
//
Функция ОписанияРавны(СтрокаА, СтрокаБ)

	Возврат СтрокаА.ОписаниеКонтроль = СтрокаБ.ОписаниеКонтроль И СтрокаА.ОписаниеДлина = СтрокаБ.ОписаниеДлина
		И СтрокаА.Описание = СтрокаБ.Описание;

КонецФункции

Процедура ДобавитьРазличиеПоля(Сверка, Строка, Поле, ЗначениеА, ЗначениеБ)

	Сверка.ПоПолям.Вставить(Поле, ЧислоИлиНоль(Сверка.ПоПолям[Поле]) + 1);
	Если Поле = "Зона" Или Поле = "ЗонаПорогов" Тогда
		ДобавитьРасхождение(Сверка, НСтр("ru = 'Различие'"), Строка, Поле, ПредставлениеЗоны(ЗначениеА),
			ПредставлениеЗоны(ЗначениеБ));
	Иначе
		ДобавитьРасхождение(Сверка, НСтр("ru = 'Различие'"), Строка, Поле, ЗначениеА, ЗначениеБ);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьРасхождение(Сверка, Вид, Строка, Поле, ЗначениеА, ЗначениеБ)

	Если Сверка.Расхождения.Количество() >= ПределРасхождений() Тогда
		Возврат;
	КонецЕсли;

	Расхождение = Сверка.Расхождения.Добавить();
	Расхождение.Вид         = Вид;
	Расхождение.Лимит       = Строка.Лимит;
	Расхождение.Фокус       = Строка.Фокус;
	Расхождение.Поручение   = Строка.Поручение;
	Расхождение.НаборДанных = Строка.НаборДанных;
	Расхождение.Поле        = Поле;
	Расхождение.Было        = ЗначениеА;
	Расхождение.Стало       = ЗначениеБ;

КонецПроцедуры

Процедура ДобавитьРасхождениеПоручения(Сверка, СтрокаПоручения, Поле, ЗначениеА, ЗначениеБ)

	Если Сверка.Расхождения.Количество() >= ПределРасхождений() Тогда
		Возврат;
	КонецЕсли;

	Расхождение = Сверка.Расхождения.Добавить();
	Расхождение.Вид       = НСтр("ru = 'Поручение'");
	Расхождение.Поручение = СтрокаПоручения.Поручение;
	Расхождение.Поле      = Поле;
	Расхождение.Было      = ЗначениеА;
	Расхождение.Стало     = ЗначениеБ;

КонецПроцедуры

// Признаки несопоставимости снимков: разный вид проверки, дата проверки лимитов, число строк, версия
// конфигурации. Сверка при этом выполняется, признаки выводятся в итог как предупреждения.
//
// Параметры:
//  ПаспортА - Структура - см. ПаспортПроверки
//  ПаспортБ - Структура
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ПредупрежденияСопоставимости(ПаспортА, ПаспортБ)

	Предупреждения = Новый Массив;
	Если ПаспортА.ВидПроверки <> ПаспортБ.ВидПроверки Тогда
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Разный вид проверки: %1 и %2.'"),
			ПаспортА.ВидПроверки, ПаспортБ.ВидПроверки));
	КонецЕсли;
	Если НачалоДня(ПаспортА.ДатаПроверки) <> НачалоДня(ПаспортБ.ДатаПроверки) Тогда
		Предупреждения.Добавить(СтрШаблон(
			НСтр("ru = 'Разная дата проверки лимитов: %1 и %2 - данные могли измениться.'"),
			Формат(ПаспортА.ДатаПроверки, "ДЛФ=D"), Формат(ПаспортБ.ДатаПроверки, "ДЛФ=D")));
	КонецЕсли;
	Если ПаспортА.Строк <> ПаспортБ.Строк Тогда
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Разное число строк результата: %1 и %2.'"),
			Формат(ПаспортА.Строк, "ЧГ=3,0; ЧН=0"), Формат(ПаспортБ.Строк, "ЧГ=3,0; ЧН=0")));
	КонецЕсли;
	Если ПаспортА.ВерсияКонфигурации <> ПаспортБ.ВерсияКонфигурации Тогда
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Разная версия конфигурации: %1 и %2.'"),
			ПаспортА.ВерсияКонфигурации, ПаспортБ.ВерсияКонфигурации));
	КонецЕсли;

	Возврат Предупреждения;

КонецФункции

Функция ТекстИтога(Сверка)

	Части = Новый Массив;
	Если Сверка.НетРасхождений Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Регресса нет: совпали все %1 строк результата.'"),
			ЧислоСтрокой(Сверка.Совпало)));
	Иначе
		Части.Добавить(СтрШаблон(
			НСтр("ru = 'Есть расхождения: совпало %1, различается %2, только было %3, только стало %4.'"),
			ЧислоСтрокой(Сверка.Совпало), ЧислоСтрокой(Сверка.Различается), ЧислоСтрокой(Сверка.ТолькоА),
			ЧислоСтрокой(Сверка.ТолькоБ)));
	КонецЕсли;
	Если Сверка.ПорученийСовпало + Сверка.ПорученийРазличается > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Итоги по поручениям: совпало %1, различается %2.'"),
			ЧислоСтрокой(Сверка.ПорученийСовпало), ЧислоСтрокой(Сверка.ПорученийРазличается)));
	КонецЕсли;
	Для Каждого Предупреждение Из Сверка.Предупреждения Цикл
		Части.Добавить(НСтр("ru = 'Внимание: '") + Предупреждение);
	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

#КонецОбласти

#Область ОтчетСверки

// Отчет сверки: итог, паспорта, счетчики, сводка по зонам, время шагов и таблица расхождений.
//
// Параметры:
//  СнимокА - Структура - см. СнимокПроверки
//  СнимокБ - Структура
//  Сверка - Структура - см. СверитьСнимки
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция ОтчетСверки(СнимокА, СнимокБ, Сверка)

	Вывод = Новый Структура("Документ, НомерСтроки", Новый ТабличныйДокумент, 0);
	Вывод.Документ.ИмяПараметровПечати = "FO_LimitRegress";

	ВывестиЗаголовок(Вывод, НСтр("ru = 'Сверка результатов проверки лимитов'"));
	ВывестиТекст(Вывод, ТекстИтога(Сверка));

	ВывестиЗаголовок(Вывод, НСтр("ru = 'Паспорта снимков'"));
	ВывестиТаблицу(Вывод, ТаблицаПаспортов(СнимокА.Паспорт, СнимокБ.Паспорт));

	ВывестиЗаголовок(Вывод, НСтр("ru = 'Строки результата'"));
	ВывестиТаблицу(Вывод, ТаблицаИтоговСверки(Сверка));

	ВывестиЗаголовок(Вывод, НСтр("ru = 'Строки по зонам'"));
	ВывестиТаблицу(Вывод, ТаблицаЗон(СнимокА.Строки, СнимокБ.Строки));

	ВывестиЗаголовок(Вывод, НСтр("ru = 'Время шагов проверки, секунд'"));
	ВывестиТаблицу(Вывод, ТаблицаЗамеров(СнимокА.Замеры, СнимокБ.Замеры));

	ВывестиЗаголовок(Вывод, СтрШаблон(НСтр("ru = 'Расхождения (выводится не больше %1)'"),
		ЧислоСтрокой(ПределРасхождений())));
	Если Сверка.Расхождения.Количество() = 0 Тогда
		ВывестиТекст(Вывод, НСтр("ru = 'Расхождений нет.'"));
	Иначе
		ВывестиТаблицу(Вывод, Сверка.Расхождения);
	КонецЕсли;

	УстановитьШириныКолонок(Вывод.Документ);
	Вывод.Документ.АвтоМасштаб = Истина;

	Возврат Вывод.Документ;

КонецФункции

Функция ТаблицаПаспортов(ПаспортА, ПаспортБ)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Показатель'"));
	Таблица.Колонки.Добавить("Было", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Было'"));
	Таблица.Колонки.Добавить("Стало", Новый ОписаниеТипов("Строка"), НСтр("ru = 'Стало'"));
	Заголовки = ЗаголовкиПаспорта();
	Для Каждого КлючЗначение Из ПаспортА Цикл
		СтрокаПаспорта = Таблица.Добавить();
		СтрокаПаспорта.Показатель = ЗначениеСвойства(Заголовки, КлючЗначение.Ключ);
		Если Не ЗначениеЗаполнено(СтрокаПаспорта.Показатель) Тогда
			СтрокаПаспорта.Показатель = КлючЗначение.Ключ;
		КонецЕсли;
		СтрокаПаспорта.Было       = ПредставлениеЗначения(КлючЗначение.Значение);
		СтрокаПаспорта.Стало      = ПредставлениеЗначения(ЗначениеСвойства(ПаспортБ, КлючЗначение.Ключ));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ЗаголовкиПаспорта()

	Заголовки = Новый Структура;
	Заголовки.Вставить("Вместилище", НСтр("ru = 'Идентификатор проверки'"));
	Заголовки.Вставить("ВидПроверки", НСтр("ru = 'Вид проверки'"));
	Заголовки.Вставить("НачалоПроверки", НСтр("ru = 'Начало проверки'"));
	Заголовки.Вставить("ДатаПроверки", НСтр("ru = 'Дата проверки лимитов'"));
	Заголовки.Вставить("Отказ", НСтр("ru = 'Отказ'"));
	Заголовки.Вставить("Тестирование", НСтр("ru = 'Режим тестирования'"));
	Заголовки.Вставить("Архив", НСтр("ru = 'Снят из архива'"));
	Заголовки.Вставить("ВерсияКонфигурации", НСтр("ru = 'Версия конфигурации'"));
	Заголовки.Вставить("ВерсияВместилища", НСтр("ru = 'Версия, записавшая результат'"));
