// Число, записанное в тексте после метки: "Объектов: 3 100; Проверок: 75 020" -> 75020 для метки "Проверок:".
// Пробелы внутри числа (в том числе неразрывные) пропускаются, чтение идет до первого другого символа.
//
// Параметры:
//  Текст - Строка - описание проверки
//  Метка - Строка - текст перед числом
//
// Возвращаемое значение:
//  Число - 0, если метки нет
//
Функция ЧислоПослеМетки(Текст, Метка)

	Позиция = СтрНайти(Текст, Метка);
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Цифры = "";
	Для Номер = Позиция + СтрДлина(Метка) По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Номер, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли Символ = " " Или Символ = Символы.НПП Тогда
			Продолжить;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Цифры = "" Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(Цифры);

КонецФункции

