Функция ИдентификаторФокуса(Фокус)

	Если Не ЗначениеЗаполнено(Фокус) Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Фокус) = Тип("СправочникСсылка.ГруппыПортфелей") Тогда
		Возврат "Г:" + Строка(Фокус.УникальныйИдентификатор());
	КонецЕсли;

	Возврат "П:" + Строка(Фокус.УникальныйИдентификатор());

