#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка") Тогда
		ДополнительнаяОбработкаСсылка = Параметры.ДополнительнаяОбработкаСсылка;
	КонецЕсли;

	КоличествоПроверок = 30;
	ЗаполнитьПроверки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФайлАНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайлСнимка("А");

КонецПроцедуры

&НаКлиенте
Процедура ФайлБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайлСнимка("Б");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПроверки

&НаКлиенте
Процедура ПроверкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	НачатьСнимок();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьПроверки();

КонецПроцедуры

&НаКлиенте
Процедура СнятьСнимок(Команда)

	НачатьСнимок();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлА(Команда)

	ВыбратьФайлСнимка("А");

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлБ(Команда)

	ВыбратьФайлСнимка("Б");

КонецПроцедуры

&НаКлиенте
Процедура Сверить(Команда)

	Если Не ЗначениеЗаполнено(АдресА) Или Не ЗначениеЗаполнено(АдресБ) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите оба файла снимков: ""было"" и ""стало"".'"));
		Возврат;
	КонецЕсли;

	Операция = НачатьСверкуНаСервере();
	ОжидатьОперацию(Операция, "СверкаЗавершение", НСтр("ru = 'Сверка снимков'"));

КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьОтчет(Команда)

	Если ПустаяСтрока(ИтогСверки) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала выполните сверку.'"));
		Возврат;
	КонецЕсли;

	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Сохранение отчета сверки'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Книга Excel (*.xlsx)|*.xlsx'");
	Ждать ПолучитьФайлССервераАсинх(АдресОтчетаXLSX(), "Сверка проверки лимитов.xlsx", ПараметрыДиалога);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Снимок

// Запускает снятие снимка выбранной проверки: в фоне, если обработка подключена в справочнике дополнительных
// обработок, иначе в текущем серверном вызове.
//
&НаКлиенте
Процедура НачатьСнимок()

	ТекущиеДанные = Элементы.Проверки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите проверку в списке.'"));
		Возврат;
	КонецЕсли;

	Операция = НачатьСнимокНаСервере(ТекущиеДанные.Вместилище);
	ОжидатьОперацию(Операция, "СнимокЗавершение", НСтр("ru = 'Снимок результата проверки'"));

КонецПроцедуры

// Сохраняет файл снимка на компьютер пользователя после завершения снятия снимка.
//
// Параметры:
//  Результат - Структура, Неопределено - результат длительной операции, см. ДлительныеОперацииКлиент.ОжидатьЗавершение
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Асинх Процедура СнимокЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Не ОперацияВыполнена(Результат) Тогда
		Возврат;
	КонецЕсли;

	ФайлСнимка = ПодготовитьФайлСнимка(Результат.АдресРезультата);

	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Сохранение снимка проверки'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Снимок проверки лимитов (*.flr)|*.flr'");
	Ждать ПолучитьФайлССервераАсинх(ФайлСнимка.Адрес, ФайлСнимка.ИмяФайла, ПараметрыДиалога);

КонецПроцедуры

&НаСервере
Функция НачатьСнимокНаСервере(Знач Вместилище)

	ПараметрыСнимка = Новый Структура("Вместилище", Вместилище);

	Возврат НачатьОперацию("СнятьСнимокВФоне", ПараметрыСнимка, НСтр("ru = 'Снимок результата проверки лимитов'"));

КонецФункции

// Переносит двоичные данные снимка в отдельный адрес временного хранилища формы для получения файла и
// выводит паспорт снимка.
//
// Параметры:
//  АдресРезультата - Строка - адрес результата, см. ОбработкаОбъект.FO_LimitRegress.РезультатСнимка
//
// Возвращаемое значение:
//  Структура:
//   * Адрес - Строка - адрес двоичных данных файла
//   * ИмяФайла - Строка
//
&НаСервере
Функция ПодготовитьФайлСнимка(Знач АдресРезультата)

	РезультатСнимка = ПолучитьИзВременногоХранилища(АдресРезультата);
	ПаспортСнимка = РезультатСнимка.Паспорт;

	ФайлСнимка = Новый Структура;
	ФайлСнимка.Вставить("Адрес", ПоместитьВоВременноеХранилище(РезультатСнимка.ДвоичныеДанные, УникальныйИдентификатор));
	ФайлСнимка.Вставить("ИмяФайла", РезультатСнимка.ИмяФайла);

	Возврат ФайлСнимка;

КонецФункции

&НаСервере
Процедура ЗаполнитьПроверки()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Проверки.Загрузить(ОбработкаОбъект.ПоследниеПроверки(Макс(КоличествоПроверок, 1)));

КонецПроцедуры

#КонецОбласти

#Область Сверка

// Помещает выбранный файл снимка во временное хранилище формы и показывает его паспорт.
//
// Параметры:
//  Сторона - Строка - "А" для снимка "было", "Б" для снимка "стало"
//
&НаКлиенте
Асинх Процедура ВыбратьФайлСнимка(Сторона)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = НСтр("ru = 'Выбор снимка проверки'");
	ПараметрыДиалога.Фильтр = НСтр("ru = 'Снимок проверки лимитов (*.flr)|*.flr|Все файлы (*.*)|*.*'");
	ПараметрыДиалога.МножественныйВыбор = Ложь;

	ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);
	Если ТипЗнч(ОписаниеФайла) <> Тип("ОписаниеПомещенногоФайла") Или ОписаниеФайла.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	ПрочитатьПаспортФайла(Сторона, ОписаниеФайла.Адрес, ОписаниеФайла.СсылкаНаФайл.Имя);

КонецПроцедуры

&НаСервере
Процедура ПрочитатьПаспортФайла(Знач Сторона, Знач Адрес, Знач ИмяФайла)

	Паспорт = РеквизитФормыВЗначение("Объект").ПаспортФайлаСнимка(ПолучитьИзВременногоХранилища(Адрес));

	ЭтотОбъект["Файл" + Сторона] = ИмяФайла;
	ЭтотОбъект["Адрес" + Сторона] = Адрес;
	ЭтотОбъект["Паспорт" + Сторона] = Паспорт;
	ОчиститьРезультатСверки();

КонецПроцедуры

&НаСервере
Функция НачатьСверкуНаСервере()

	ОчиститьРезультатСверки();

	ПараметрыСверки = Новый Структура;
	ПараметрыСверки.Вставить("ДанныеА", ПолучитьИзВременногоХранилища(АдресА));
	ПараметрыСверки.Вставить("ДанныеБ", ПолучитьИзВременногоХранилища(АдресБ));

	Возврат НачатьОперацию("СверитьВФоне", ПараметрыСверки, НСтр("ru = 'Сверка снимков проверки лимитов'"));

КонецФункции

// Выводит итог и отчет сверки после завершения длительной операции.
//
// Параметры:
//  Результат - Структура, Неопределено - результат длительной операции, см. ДлительныеОперацииКлиент.ОжидатьЗавершение
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура СверкаЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Не ОперацияВыполнена(Результат) Тогда
		Возврат;
	КонецЕсли;

	ВывестиРезультатСверки(Результат.АдресРезультата);

КонецПроцедуры

&НаСервере
Процедура ВывестиРезультатСверки(Знач АдресРезультата)

	РезультатСверки = ПолучитьИзВременногоХранилища(АдресРезультата);
	ИтогСверки = РезультатСверки.Итог;
	Отчет = РезультатСверки.Отчет;
	Замеры.Загрузить(РезультатСверки.Замеры);

КонецПроцедуры

&НаСервере
Процедура ОчиститьРезультатСверки()

	ИтогСверки = "";
	Отчет = Новый ТабличныйДокумент;
	Замеры.Очистить();

КонецПроцедуры

&НаСервере
Функция АдресОтчетаXLSX()

	ДвоичныеДанные = РеквизитФормыВЗначение("Объект").ДвоичныеДанныеXLSX(Отчет);

	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти

#Область ДлительныеОперации

// Запускает экспортную процедуру модуля объекта обработки. Обработка из справочника дополнительных обработок
// выполняется фоновым заданием БСП; открытая из файла - в текущем серверном вызове, с тем же форматом результата.
//
// Параметры:
//  ИмяМетода - Строка - экспортная процедура модуля объекта с параметрами (Параметры, АдресХранилища)
//  ПараметрыМетода - Структура - параметры процедуры
//  Наименование - Строка - наименование фонового задания
//
// Возвращаемое значение:
//  Структура - см. ДлительныеОперации.ВыполнитьВФоне
//
&НаСервере
Функция НачатьОперацию(ИмяМетода, ПараметрыМетода, Наименование)

	Если Не ЗначениеЗаполнено(ДополнительнаяОбработкаСсылка) Тогда
		АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Если ИмяМетода = "СнятьСнимокВФоне" Тогда
			ОбработкаОбъект.СнятьСнимокВФоне(ПараметрыМетода, АдресРезультата);
		Иначе
			ОбработкаОбъект.СверитьВФоне(ПараметрыМетода, АдресРезультата);
		КонецЕсли;
		Возврат Новый Структура("Статус, АдресРезультата", "Выполнено", АдресРезультата);
	КонецЕсли;

	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
	ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
	ПараметрыЗадания.Вставить("ИмяОбработки", "");
	ПараметрыЗадания.Вставить("ИмяМетода", ИмяМетода);
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыМетода);

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = Наименование;

	Возврат ДлительныеОперации.ВыполнитьВФоне("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
		ПараметрыЗадания, ПараметрыВыполнения);

КонецФункции

&НаКлиенте
Процедура ОжидатьОперацию(Операция, ИмяОбработчика, ТекстОжидания)

	Оповещение = Новый ОписаниеОповещения(ИмяОбработчика, ЭтотОбъект);
	Если Операция.Статус = "Выполнено" Тогда
		ВыполнитьОбработкуОповещения(Оповещение, Операция);
		Возврат;
	КонецЕсли;

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = ТекстОжидания;
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Функция ОперацияВыполнена(Результат)

	Если Результат = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
		Возврат Ложь;
	КонецЕсли;

	Возврат Результат.Статус = "Выполнено";

КонецФункции

#КонецОбласти

#КонецОбласти
