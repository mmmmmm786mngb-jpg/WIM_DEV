Процедура ВыполнитьКоманду(Знач ИдентификаторКоманды, Знач ПараметрыВыполненияКоманды) Экспорт
	
	Перем ТекстОшибки;
	
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда
		Возврат;
	КонецЕсли;

	// IMDEV-9530: замер всей загрузки TCRIS (ключевая операция ЗагрузкаTCRIS)
	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	ЗагрузитьTCRIS();
	// IMDEV-9530: общий замер, вес - контрагенты с записанным TCRIS; при недоступности Rates не пишется
	Если НЕ ПоказателиЗамера.Сбой Тогда
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗагрузкаTCRIS", НачалоЗамера,
			Макс(ПоказателиЗамера.Записано, 1), КомментарийЗамера());
	КонецЕсли;
	
	
КонецПроцедуры // ВыполнитьКоманду()

