Функция ПрочитатьДанныеизRates(Соединение)
	
	CommandSQL = Новый COMОбъект("ADODB.Command");
	CommandSQL.ActiveConnection = Соединение;
	CommandSQL.CommandType = 1;
		
	//ЗапросSQL = "SELECT	
	//|CASE 
	//| WHEN [Rater] = 'ЭКСПЕРТ РА' then 1
	//| when [Rater] = 'АКРА' THEN 2
	//| else
	//| 3
	//| end as prioritet,
	//| CASE 
	//| WHEN [Rater] = 'АКРА' THEN 'AKRA' 
	//| WHEN [Rater] = 'ЭКСПЕРТ РА' THEN  
	//| CASE 
	//| WHEN [Rating] LIKE 'ru%' THEN 'EXPERT_RA_NEW' 
	//| ELSE 'EXPERT_RA' 
	//| END 
	//| ELSE [Rater] 
	//| END [Rater]
	//| ,[IssuerName]
	//| ,[IssuerINN]
	//| ,CASE 
	//| WHEN [DateCanceled] = '1900-01-01' THEN  
	//| replace([Rating], ' ', '')  
	//| ELSE 'NR' 
	//| END [Rating]
	//| , CASE 
	//| WHEN [Rater] = 'НКР' THEN 10
	//| WHEN [Rater] = 'АКРА' and [RatingSubLev] = 0 THEN 11
	//| ELSE [RatingSubLev] 
	//| END [RatingSubLev]
	//| ,[DateUpdated]
	//| ,[AsOfDate]
	//| FROM [dbo].[PRIME_IssuerRating]
	//| WHERE [AsOfDate] in ('2021-12-06') and IssuerINN != ''and Rating != 'отз'
	////| WHERE [AsOfDate] in (select MAX([AsOfDate]) from [dbo].[PRIME_IssuerRating] where [Rater] IN ('АКРА','ЭКСПЕРТ РА')) and IssuerINN != '' and Rating != 'отз'
	//| order by  [IssuerINN], prioritet, [RatingSubLev]";
	
	ЗапросSQL = "SELECT	
	|CASE 
	| WHEN [Rater] = 'ЭКСПЕРТ РА' then 1
	| when [Rater] = 'АКРА' THEN 2
	| else
	| 3
	| end as prioritet,
	| CASE 
	| WHEN [Rater] = 'АКРА' THEN 'AKRA' 
	| WHEN [Rater] = 'ЭКСПЕРТ РА' THEN  
	| CASE 
	| WHEN [Rating] LIKE 'ru%' THEN 'EXPERT_RA_NEW' 
	| ELSE 'EXPERT_RA' 
	| END 
	| ELSE [Rater] 
	| END [Rater]
	| ,[IssuerName]
	| ,[IssuerINN]
	| ,CASE 
	| WHEN [DateCanceled] = '1900-01-01' THEN  
	| replace([Rating], ' ', '')  
	| ELSE 'NR' 
	| END [Rating]
	| , CASE 
	| WHEN [Rater] = 'НКР' THEN 10
	| WHEN [Rater] = 'АКРА' and [RatingSubLev] = 0 THEN 11
	| ELSE [RatingSubLev] 
	| END [RatingSubLev]
	| ,[DateUpdated]
	| ,[AsOfDate]
	| FROM [dbo].[PRIME_IssuerRating]
	| WHERE [AsOfDate] in (select MAX([AsOfDate]) from [dbo].[PRIME_IssuerRating] where [Rater] IN ('АКРА','ЭКСПЕРТ РА'))
	//|WHERE [AsOfDate] in ('"+2021-12-06+"') 
	| and IssuerINN != ''
	| and Rating != 'отз'
	| and (  [Rater] = 'АКРА' or [Rater] = 'ЭКСПЕРТ РА' or [Rating] LIKE 'ru%' or [Rater] = 'НКР') 
	| order by  [IssuerINN], prioritet, [RatingSubLev]";
	
	Попытка
		CommandSQL.CommandText = ЗапросSQL;
		НаборЗаписей = CommandSQL.Execute();
	Исключение
		Сообщить("Ошибка получения данных контрагента: "+ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Rater", НОвый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(20)));
	ТЗ.Колонки.Добавить("IssuerName", НОвый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(20)));
	ТЗ.Колонки.Добавить("IssuerINN", НОвый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(20)));
	ТЗ.Колонки.Добавить("Rating", НОвый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(20)));
	ТЗ.Колонки.Добавить("RatingSubLev", НОвый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	ТЗ.Колонки.Добавить("DateUpdated", НОвый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТЗ.Колонки.Добавить("AsOfDate", НОвый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТЗ.Колонки.Добавить("prioritet", НОвый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	
	Пока НаборЗаписей.EOF() = 0 Цикл
		НоваяСтрока = ТЗ.Добавить();		
		НоваяСтрока.Rater = НаборЗаписей.Fields("Rater").Value;
		НоваяСтрока.IssuerName = НаборЗаписей.Fields("IssuerName").Value;
		НоваяСтрока.IssuerINN = НаборЗаписей.Fields("IssuerINN").Value;
		НоваяСтрока.Rating = НаборЗаписей.Fields("Rating").Value;
		НоваяСтрока.RatingSubLev = ПреобразоватьКЧислу(НаборЗаписей.Fields("RatingSubLev").Value);
		НоваяСтрока.DateUpdated = НаборЗаписей.Fields("DateUpdated").Value; 
		НоваяСтрока.AsOfDate = НаборЗаписей.Fields("AsOfDate").Value;
		НоваяСтрока.prioritet = НаборЗаписей.Fields("prioritet").Value;
		
		
		НаборЗаписей.MoveNext();
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции

Функция СопоставитьКонтрагентов(ТЗ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВходнаяТЗ.Rater КАК Rater,
	|	ВходнаяТЗ.IssuerName КАК IssuerName,
	|	ВходнаяТЗ.IssuerINN КАК IssuerINN,
	|	ВходнаяТЗ.Rating КАК Rating,
	|	ВходнаяТЗ.RatingSubLev КАК RatingSubLev,
	|	ВходнаяТЗ.DateUpdated КАК DateUpdated,
	|	ВходнаяТЗ.AsOfDate КАК AsOfDate,
	|	ВходнаяТЗ.prioritet КАК prioritet
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ВходнаяТЗ КАК ВходнаяТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Rater КАК Rater,
	|	ВТ.IssuerName КАК IssuerName,
	|	ВТ.IssuerINN КАК IssuerINN,
	|	ВТ.Rating КАК Rating,
	|	ВТ.RatingSubLev КАК RatingSubLev,
	|	ВТ.DateUpdated КАК DateUpdated,
	|	ВТ.AsOfDate КАК AsOfDate,
	|	ВТ.prioritet КАК prioritet
	|ПОМЕСТИТЬ ВТ3
	|ИЗ
	|	ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ3.Rater КАК Rater,
	|	ВТ3.IssuerName КАК IssuerName,
	|	ВТ3.IssuerINN КАК IssuerINN,
	|	ВТ3.Rating КАК Rating,
	|	ВТ3.RatingSubLev КАК RatingSubLev,
	|	ВТ3.DateUpdated КАК DateUpdated,
	|	ВТ3.AsOfDate КАК AsOfDate,
	|	ВТ3.prioritet КАК prioritet,
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ3 КАК ВТ3
	|		ПО Контрагенты.ИНН = ВТ3.IssuerINN
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И НЕ Контрагенты.ИНН = """"";
	
	Запрос.УстановитьПараметр("ВходнаяТЗ", ТЗ);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса; 
	
КонецФункции

Процедура ЗаполнитьДанныеПоКонтрагенту(Контрагент, Свойство, Значение)
	
	    НоваяЗапись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		НоваяЗапись.Объект = Контрагент;
		НоваяЗапись.Свойство = Свойство;
		НоваяЗапись.Значение = Значение;
		
		НоваяЗапись.Записать(Истина);
		
КонецПроцедуры

Процедура ЗагрузитьTCRIS() Экспорт
	
	// IMDEV-9530: замер шага чтения из Rates
	НачалоШага = ОценкаПроизводительности.НачатьЗамерВремени();
	Соединение = ПодключитьсяКRates();
	тз_из_rates = ПрочитатьДанныеизRates(Соединение);
	// IMDEV-9530: шаг чтения, вес - строки Rates; Rates недоступна (данных нет) - сбой, замеры не пишутся
	ПоказателиЗамера.Сбой = ТипЗнч(тз_из_rates) <> Тип("ТаблицаЗначений");
	Если НЕ ПоказателиЗамера.Сбой Тогда
		ПоказателиЗамера.СтрокRates = тз_из_rates.Количество();
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗагрузкаTCRIS.ЧтениеRates", НачалоШага,
			Макс(ПоказателиЗамера.СтрокRates, 1), "Строк из Rates: " + Формат(ПоказателиЗамера.СтрокRates, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	НачалоШага = ОценкаПроизводительности.НачатьЗамерВремени();
	ИтоговаяТЗ = СопоставитьКонтрагентов(тз_из_rates);
	
	ИтоговаяТЗ.Сортировать("Контрагент, prioritet");
	// IMDEV-9530: шаг сопоставления контрагентов по ИНН, вес - сопоставленные строки
	ПоказателиЗамера.Сопоставлено = ИтоговаяТЗ.Количество();
	Если НЕ ПоказателиЗамера.Сбой Тогда
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗагрузкаTCRIS.Сопоставление", НачалоШага,
			Макс(ПоказателиЗамера.Сопоставлено, 1), "Строк из Rates: " + Формат(ПоказателиЗамера.СтрокRates, "ЧН=0; ЧГ=0")
			+ "; Сопоставлено: " + Формат(ПоказателиЗамера.Сопоставлено, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	НачалоШага = ОценкаПроизводительности.НачатьЗамерВремени();
	Свойство_TCRIS = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("TCRIS");
	ПредКонтрагент = Неопределено;
	Для Каждого Стр из ИтоговаяТЗ Цикл
		НужнКонтрагент = Стр.Контрагент;
		Если НужнКонтрагент = ПредКонтрагент Тогда
			Продолжить;
		КонецЕсли;
		ПредКонтрагент = НужнКонтрагент;
		
		//TCRIS = ?(СтрНайти(Стр.Rater, "EXPERT_RA") = 0, 0, Стр.RatingSubLev);
		TCRIS = Стр.RatingSubLev;
		ЗаполнитьДанныеПоКонтрагенту(НужнКонтрагент, Свойство_TCRIS, TCRIS);
		// IMDEV-9530: контрагенты с записанным TCRIS для веса замера
		ПоказателиЗамера.Записано = ПоказателиЗамера.Записано + 1;
	КонецЦикла;
	// IMDEV-9530: шаг записи сведения TCRIS, вес - контрагенты
	Если НЕ ПоказателиЗамера.Сбой Тогда
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗагрузкаTCRIS.Запись", НачалоШага,
			Макс(ПоказателиЗамера.Записано, 1), КомментарийЗамера());
	КонецЕсли;
	
	 
КонецПроцедуры

#Область ЗамерыПроизводительности

// IMDEV-9530: комментарий замера загрузки TCRIS в формате "Показатель: значение; ...".
//
// Возвращаемое значение:
//  Строка - показатели из переменной модуля ПоказателиЗамера
//
Функция КомментарийЗамера()
	
	Возврат "Строк из Rates: " + Формат(ПоказателиЗамера.СтрокRates, "ЧН=0; ЧГ=0")
		+ "; Сопоставлено: " + Формат(ПоказателиЗамера.Сопоставлено, "ЧН=0; ЧГ=0")
		+ "; Контрагентов: " + Формат(ПоказателиЗамера.Записано, "ЧН=0; ЧГ=0");
	
КонецФункции

#КонецОбласти

// IMDEV-9530: начальные показатели замера загрузки TCRIS
ПоказателиЗамера = Новый Структура("СтрокRates, Сопоставлено, Записано, Сбой", 0, 0, 0, Ложь);
