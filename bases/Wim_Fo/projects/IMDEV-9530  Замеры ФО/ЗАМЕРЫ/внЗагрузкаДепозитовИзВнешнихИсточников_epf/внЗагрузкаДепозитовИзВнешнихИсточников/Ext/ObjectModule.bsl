Процедура ЗаполнитьДепозитыКалипсо(Лог)
	
	СписокДепозитовCalipso.Очистить();
	
	ЗапросКалипсо = "
	|SELECT abs([Pricer_CURRENT_NOTIONAL]+[Pricer_ACCRUAL_BO]*(-1)) as MV
    |  ,[TradeId] as MX_Code
    |  ,'CALIPSO' as [Source]
    |  ,case when [ProductDescription] like 'Deposit%' then [ProcessingOrg_ShortName] else [CounterParty_ShortName] end as ContrPartyName
    |  ,[Currency] as Fund
    |  ,case when [ProductDescription] like 'Deposit%' then [CounterParty_ShortName] else [ProcessingOrg_ShortName] end as BenefitID
    |  ,case when [ProductDescription] like 'Deposit%' then [CounterParty_FullName] else [ProcessingOrg_FullName] end as BenefitName
    |  ,abs([Pricer_CURRENT_NOTIONAL]) as Qty
    |  ,[FixedRate] as InterestRate
    |  ,[TradeDate] as OpenDate
    |  ,[MaturityDate] as MaturityDate
	|  
	|  --,[Pricer_CURRENT_NOTIONAL]
	|  --,[Pricer_ACCRUAL_BO]
	|  --,*
	|  --, TradeId
	|  --, MirrorTradeId
	|  FROM [dbo].[t_Calipso_LoanDeposit] cld
	|  where 1=1
	|  --and [Pricer_CURRENT_NOTIONAL]>0
	|  and [CounterParty_ShortName] <> [ProcessingOrg_ShortName]
	|  and [DatePosition] = (select MAX([DatePosition]) from [dbo].[t_Calipso_LoanDeposit])
	|  and not exists(select 1 FROM [dbo].[t_Calipso_LoanDeposit]
	|					where 1=1
	|						and [CounterParty_ShortName] <> [ProcessingOrg_ShortName]
	|						and [DatePosition] = (select MAX([DatePosition]) from [dbo].[t_Calipso_LoanDeposit])
	|						and cld.[MirrorTradeId] = [TradeId]
	|						and ProductDescription like 'Loan%'
	|						)";	
	
	Попытка
		
		ConnectionSQL = Новый COMОбъект("ADODB.Connection");
		
		ServerName = "AMDBRATES\DBMVTBAM01";
		DSN = "MasterData";
		UID = "svc_ratesuploader"; 
		PWD = "5E-20-5A-2D-5C-B9";
	
		ConnectString = "Provider=SQLOLEDB;" + "Data Source=" +ServerName + ";Initial Catalog=" + DSN + ";UID=" + UID + ";PWD=" + PWD;
					
		ConnectionSQL.ConnectionString = ConnectString;
		ConnectionSQL.ConnectionTimeOut = 15;
		ConnectionSQL.CommandTimeout = 30;
		ConnectionSQL.Open();
		
	Исключение
		
		Сообщить("Ошибка подключения к серверу ["+ServerName+"]: "+ОписаниеОшибки());
		Возврат ;
		
	КонецПопытки;
	
	CommandSQL = Новый COMОбъект("ADODB.Command");
	CommandSQL.ActiveConnection = ConnectionSQL;
	CommandSQL.CommandText = ЗапросКалипсо;
	CommandSQL.CommandType = 1;
	
	Успешно = Истина;
	Попытка
		НаборЗаписей = CommandSQL.Execute();
	Исключение
		Сообщить("Ошибка выполнения команды: "+ОписаниеОшибки());
		Сообщить("Текст команды:");
		Сообщить(ЗапросКалипсо);
		Успешно = Ложь;
	КонецПопытки;
	
	Если НЕ Успешно Тогда
		Возврат;
	КонецЕсли;
	
	Пока НаборЗаписей.EOF() = 0 Цикл
		
		MV = НаборЗаписей.Fields("MV").Value;
		MX_Code = НаборЗаписей.Fields("MX_Code").Value;
		Валюта = НаборЗаписей.Fields("Fund").Value;
		
		Строка = СписокДепозитовCalipso.Добавить();
		Строка.КодМестаХранения = Формат(MX_Code, "ЧГ=");
		Строка.BenefitID = НаборЗаписей.Fields("BenefitID").Value;
		Строка.BenefitName = НаборЗаписей.Fields("BenefitName").Value;
		Строка.СтрокаBase36 = КонвертацияBase36(MX_Code);
		Строка.МаскаПоиска = "-D" + СокрЛП(Строка.СтрокаBase36) + "-";
		Строка.СубПортфель = НайтиСубПортфельПоМаске(Строка.МаскаПоиска);
		Попытка
			Строка.РыночнаяСтоимость = Число(MV);;
		Исключение	
		КонецПопытки;
		Попытка
			Строка.Qty = Число(НаборЗаписей.Fields("Qty").Value);
		Исключение	
		КонецПопытки;
		Строка.ContrPartyName = НаборЗаписей.Fields("ContrPartyName").Value;
		Строка.Валюта = Справочники.Валюты.НайтиПоНаименованию(Валюта);
		
		Строка.СуммаНачисленныхПроцентов = Строка.РыночнаяСтоимость  - Строка.Qty;
		
		НаборЗаписей.MoveNext();
		
	КонецЦикла;
		
	ConnectionSQL = Неопределено;
	
КонецПроцедуры

Процедура ОбработатьОтвет(ВидИсточника, Ответ)
	
	Если ТипЗнч(Ответ.deposit) = Тип("ОбъектXDTO") Тогда
		ПрочитатьДепозит(ВидИсточника, Ответ.deposit);
	Иначе
		Для Каждого ЭлементОтвета из Ответ.deposit Цикл
			ПрочитатьДепозит(ВидИсточника, ЭлементОтвета);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьДепозит(ВидИсточника, Данные)
	
	Если ВидИсточника = "ДУ" Тогда
		
		СтрокаТЧ = СписокДепозитовДУ.Добавить();
		СтрокаТЧ.ИД = Данные.id; 
		СтрокаТЧ.Имя = Данные.name;
		СтрокаТЧ.РыночнаяСтоимость = Данные.marketvalue;
		СтрокаТЧ.ПроцентыДень = Данные.day_interest;
		СтрокаТЧ.Тело = Данные.initialvalue;
		СтрокаТЧ.ТекущаяСтоимость = Данные.currentvalue;
		СтрокаТЧ.Валюта = Справочники.Валюты.НайтиПоНаименованию(Данные.currency);
		СтрокаТЧ.ДатаНачала = Данные.datestart;
		СтрокаТЧ.ДатаОкончания = Данные.datematurity;
		СтрокаТЧ.Ставка = Данные.interest;
		Портфель = НайтиПортфель(Данные.agreements_prefix);
		СтрокаТЧ.МестоХранения = НайтиМестоХранения(СтрокаТЧ.ИД, Портфель);
		Если ЗначениеЗаполнено(СтрокаТЧ.МестоХранения) Тогда
			СтрокаТЧ.СубПортфель = НайтиСубПортфель(СтрокаТЧ.МестоХранения);
		Иначе
			ДОбавитьВСопоставление(Данные, "ДУ");
		КонецЕсли;
		СтрокаТЧ.СуммаНачисленныхПроцентов = СтрокаТЧ.РыночнаяСтоимость - СтрокаТЧ.Тело;
		
	ИначеЕсли ВидИсточника = "ПИФ" Тогда
		
		СтрокаТЧ = СписокДепозитовПИФ.Добавить();
		СтрокаТЧ.ИД = Данные.id; 
		СтрокаТЧ.Имя = Данные.name;
		СтрокаТЧ.РыночнаяСтоимость = Данные.marketvalue;
		СтрокаТЧ.ПроцентыДень = Данные.day_interest;
		СтрокаТЧ.Тело = Данные.initialvalue;
		СтрокаТЧ.ТекущаяСтоимость = Данные.currentvalue;
		СтрокаТЧ.Валюта = Справочники.Валюты.НайтиПоНаименованию(Данные.currency);
		СтрокаТЧ.ДатаНачала = Данные.datestart;
		СтрокаТЧ.ДатаОкончания = Данные.datematurity;
		СтрокаТЧ.Ставка = Данные.interest;
		СтрокаТЧ.МестоХранения = НайтиМестоХранения(СтрокаТЧ.ИД); 
		
		Если ЗначениеЗаполнено(СтрокаТЧ.МестоХранения) Тогда
			СтрокаТЧ.СубПортфель = НайтиСубПортфель(СтрокаТЧ.МестоХранения);
		Иначе
			ДОбавитьВСопоставление(Данные, "ПИФ");
		КонецЕсли;
		СтрокаТЧ.СуммаНачисленныхПроцентов = СтрокаТЧ.РыночнаяСтоимость - СтрокаТЧ.Тело;
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеПозиции

Процедура ЗаписатьСтавкуДепозита(МестоХранения, Ставка)
	
	Если ТипЗнч(МестоХранения.Объект)=Тип("СправочникСсылка.БанковскиеСчета") И ЗначениеЗаполнено(МестоХранения.Объект) Тогда
		БСОбъект = МестоХранения.Объект.ПолучитьОбъект();
		БСОбъект.ПроцентнаяСтавка = Ставка;
		БСОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура ОчиститьДепозиты() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка КАК БанковскийСчет,
		|	МестаХранения.Ссылка КАК МестоХранения
		|ПОМЕСТИТЬ ВТ_Депозиты
		|ИЗ
		|	Справочник.МестаХранения КАК МестаХранения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПО МестаХранения.Объект = БанковскиеСчета.Ссылка
		|ГДЕ
		|	БанковскиеСчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФактическаяПозиция.МестоХранения КАК МестоХранения
		|ИЗ
		|	РегистрСведений.ФактическаяПозиция КАК ФактическаяПозиция
		|ГДЕ
		|	ФактическаяПозиция.Дата = &Дата
		|	И ФактическаяПозиция.МестоХранения В
		|			(ВЫБРАТЬ
		|				Депозиты.МестоХранения КАК МестоХранения
		|			ИЗ
		|				ВТ_Депозиты КАК Депозиты)";
	
	Запрос.УстановитьПараметр("Дата", ДатаЗапроса);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Набор = РегистрыСведений.ФактическаяПозиция.СоздатьНаборЗаписей();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Набор.Отбор.Дата.Установить(ДатаЗапроса);
		Набор.Отбор.МестоХранения.Установить(ВыборкаДетальныеЗаписи.МестоХранения);
		Набор.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьФактическуюПозицию(ЛогОбновления) Экспорт
	
