			Сообщение = "CALIPSO - " + СокрЛП(СтрокаТЧ.BenefitID) + " " + СокрП(СтрокаТЧ.BenefitName) + " - " + СокрЛП(СтрокаТЧ.КодМестаХранения)
				+ "/" + СокрЛП(СтрокаТЧ.СтрокаBase36) +  " - " + СокрЛП(СтрокаТЧ.ContrPartyName) +  " - " + формат(СтрокаТЧ.РыночнаяСтоимость, "ЧРД=.; ЧГ=")
				+ " (" + Формат(СтрокаТЧ.Qty, "ЧРД=.; ЧГ=") + ") " + СтрокаТЧ.Валюта.Наименование;
			Если СтрокаТЧ.СуммаНачисленныхПроцентов <= 0 Тогда
				Сообщение = "!!! Отрицательный или нулевой процент " + Сообщение;
			КонецЕсли;
			МассивОК.Добавить(Сообщение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	//IMAPPS-17897
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(МассивОк);
	Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	МассивОк = Список.ВыгрузитьЗначения();
	//IMAPPS-17897 
	
	//IMAPPS-35483++
	СписокТекущихДепозитовФО = ПолучитьДепозитыФО_КУдалению(ДатаЗапроса, СписокДепозитовДУ, СписокДепозитовПИФ, СписокДепозитовCalipso); 
	
	Пока СписокТекущихДепозитовФО.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ВТБ_ФактическаяПозицияДепозитов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Субпортфель.Установить(СписокТекущихДепозитовФО.Субпортфель);  
		НаборЗаписей.Отбор.Дата.Установить(ДатаЗапроса);
		НаборЗаписей.Отбор.МестоХранения.Установить(СписокТекущихДепозитовФО.МестоХранения);

		НаборЗаписей.Прочитать();
		НаборЗаписей.Удалить(0);
		НаборЗаписей.Записать();
		
		Сообщение = "Удален депозит по субпортфелю "+СписокТекущихДепозитовФО.Субпортфель + " на сумму " + СписокТекущихДепозитовФО.Стоимость; 
		Сообщить(Сообщение);
		МассивНеОК.Добавить(Сообщение);

	КонецЦикла;
	
	//IMAPPS-35483--
	
	Если ЗначениеЗаполнено(ОбработкаПерерасчетаСтоимости) Тогда
		ТаблицаПортфелей.Свернуть("Портфель");
		МассивПортфелей = ТаблицаПортфелей.ВыгрузитьКолонку("Портфель");
		ДатаНачала = ТекущаяДатаСеанса();
		ИдентификаторСеанса = Новый УникальныйИдентификатор;
		ПоВсемПортфелям = Ложь;
		ВыполнитьПерерасчетРСА(ИдентификаторСеанса, ДатаЗапроса, МассивПортфелей, ПоВсемПортфелям);
		
		АванкорВыполнениеРегламентныхЗаданий.Пауза(10);
		
		ДатаОкончания = ТекущаяДатаСеанса();
		ВыполнитьРассылкуПоПерерасчетуРСА(ИдентификаторСеанса, ДатаНачала, ДатаОкончания);
	Иначе
		Сообщение = "В настройках не указана обработка Пересчета стоимости фактической позиции и РСА. Пересчет не был запущен.";
		МассивНеОК.Добавить(Сообщение);
	КонецЕсли;
	
	ЛогОбновления.Вставить("НеОбновлено", МассивНеОК);
	ЛогОбновления.Вставить("Обновлено", МассивОк);
	
КонецПроцедуры

Функция ВернутьАктив(Валюта)
	
	Актив = Справочники.Активы.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Активы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Активы КАК Активы
	               |ГДЕ
	               |	Активы.Объект = &Объект
	               |	И НЕ Активы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Объект", Валюта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Актив = Выборка.Ссылка;		
	КонецЕсли;
	
	Возврат Актив;
	
