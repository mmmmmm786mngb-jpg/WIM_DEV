Процедура ЗаполнитьДепозитыДУ(Лог) 
	
	ЕстьОшибки = Ложь;
	ОписаниеОшибки = "";
	СписокДепозитовДУ.Очистить();
	
	Попытка
		ОпределениеWS = Новый WSОпределения(ВебСервисДУ, Логин, Пароль);
	Исключение
		ЕстьОшибки = Истина;
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Если ЕстьОшибки Тогда
		Лог.Добавить(ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ФабрикаСервиса = ОпределениеWS.ФабрикаXDTO;
	
	Прокси = Новый WSПрокси(ОпределениеWS, ОпределениеWS.Сервисы[0].URIПространстваИмен, ОпределениеWS.Сервисы[0].Имя, ОпределениеWS.Сервисы[0].ТочкиПодключения[0].Имя);
	Ответ = Прокси.getDeposits(ДатаЗапроса);
	
	Если ТипЗнч(Ответ) <> Тип("ОбъектXDTO") Тогда
		Лог.Добавить("Ошибка получения данных!");
		Возврат;
	КонецЕсли;	
	
	Если НЕ ПроверитьНаличиеБлока(Ответ, "deposit") Тогда
		Лог.Добавить("Нет блока с депозитами!");
		Возврат;		
	КонецЕсли;
	
	ОбработатьОтвет("ДУ", Ответ);

	Лог.Добавить("Заполненые депозиты из АванкорДУ");
	
КонецПроцедуры

