			запись.Портфель = СтрокаТЧ.СубПортфель.Портфель;
			Запись.Количество = СтрокаТЧ.Тело;
			Запись.Стоимость = СтрокаТЧ.Тело;
			Запись.Задолженность = 0;
			ЗАпись.НКД = СтрокаТЧ.СуммаНачисленныхПроцентов;
			Запись.СуммаДенежныхСредствСЗадолженностью = СтрокаТЧ.РыночнаяСтоимость;
			
			Набор.Записать(Истина);
			
			Сообщение = "AVAN_DU " + СокрЛП(СтрокаТЧ.ИД) + " " + СокрП(СтрокаТЧ.Имя) + " - " + формат(СтрокаТЧ.РыночнаяСтоимость, "ЧРД=.; ЧГ=") + " (" + формат(СтрокаТЧ.Тело, "ЧРД=.; ЧГ=") + ") " + СтрокаТЧ.Валюта.Наименование;
			Если СтрокаТЧ.СуммаНачисленныхПроцентов <= 0 Тогда
