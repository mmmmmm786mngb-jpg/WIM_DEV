#Область Рассылка

Процедура ЗапуститьРассылкуПисьма(ЛогОбновления) Экспорт
	
	Если ПочтовыйЛогин.Пустая() или СписокРассылки.Количество() = 0 Тогда
		Возврат
	КонецЕсли;
	
	ТекстСообщения = "";
	КолвоСтрок = ЛогОбновления.КоличествоСтрок();
	Для Сч = 1 по КолвоСтрок цикл
		ТекущаяСтрока = ЛогОбновления.ПолучитьСтроку(Сч);
		ТекстСообщения = ТекстСообщения + ТекущаяСтрока + "<br>";	
	КонецЦикла;	
	
	Префикс = "{OK}";
	Если СписокДепозитовДУ.Количество() = 0 И СписокДепозитовПИФ.Количество() = 0 И СписокДепозитовCalipso.Количество() = 0 Тогда
		Префикс = "{FAIL}";
	ИначеЕсли СписокДепозитовДУ.Количество() = 0 или СписокДепозитовПИФ.Количество() = 0 ИЛИ СписокДепозитовCalipso.Количество() = 0 Тогда
		Префикс = "{WARN}";
	КонецЕсли;
		
	ТемаСообщения = Префикс + " Аванкор ФО: Обновление депозитов (" + Формат(ДатаЗапроса, "ДФ=yyyy-MM-dd; ДП=") + ")";
	ТелоПисьма = "";
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Вложения, Важность");
	Кому = Новый Массив;
	Для каждого ТекЯщик из СписокРассылки Цикл
		Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.ПочтовыйЯщик));
	КонецЦикла;		
		
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тело = ТекстСообщения;
	ПараметрыПисьма.ТипТекста = "HTML";
	//ПараметрыПисьма.ТипТекста = "ТекстСообщения";
			
	ПараметрыПисьма.Тема = ТемаСообщения + ПропискаРассылки("r142");
	Если Префикс = "{OK}" Тогда
		ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Обычная;
	Иначе
		ПараметрыПисьма.Важность = ВажностьИнтернетПочтовогоСообщения.Высокая;	
	КонецЕсли;
	
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(ПочтовыйЛогин, ПараметрыПисьма);
		текстРассылки = "Рассылка завершена";
	Исключение
		
		Ошибка = ОписаниеОшибки();
		Сообщить(Ошибка);
		
		текстРассылки = "Рассылка не удалась: "+ПочтовыйЛогин;
		
	КонецПопытки;
	
КонецПроцедуры

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()


