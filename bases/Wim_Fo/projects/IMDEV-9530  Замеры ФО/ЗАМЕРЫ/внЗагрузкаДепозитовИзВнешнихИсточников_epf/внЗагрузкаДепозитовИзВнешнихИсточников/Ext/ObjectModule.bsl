Функция НайтиМестоХранения(ИДДепозита, Портфель = Неопределено)
	
	МестоХранения = Справочники.МестаХранения.ПустаяСсылка();
	
	Запрос = Новый Запрос; 
	
	// IMAPPS-26353 ++
	//Если  Портфель = Неопределено Тогда
	Если НЕ ЗначениеЗаполнено(Портфель) Тогда
	// IMAPPS-26353 --
		Запрос.Текст = "ВЫБРАТЬ
		               |	ДополнительныеСведения.Объект КАК Объект,
		               |	ДополнительныеСведения.Свойство КАК Свойство,
		               |	ДополнительныеСведения.Значение КАК Значение
		               |ИЗ
		               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		               |ГДЕ
		               |	ДополнительныеСведения.Объект ССЫЛКА Справочник.МестаХранения
		               |	И ДополнительныеСведения.Свойство = &Свойство
		               |	И ДополнительныеСведения.Значение = &Значение";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	ДополнительныеСведения.Объект КАК Объект,
		               |	ДополнительныеСведения.Свойство КАК Свойство,
		               |	ДополнительныеСведения.Значение КАК Значение
		               |ПОМЕСТИТЬ ВТ_МХпоДопСвойству
		               |ИЗ
		               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		               |ГДЕ
		               |	ДополнительныеСведения.Объект ССЫЛКА Справочник.МестаХранения
		               |	И ДополнительныеСведения.Свойство = &Свойство
		               |	И ДополнительныеСведения.Значение = &Значение
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_МХпоДопСвойству.Объект КАК Объект
		               |ИЗ
		               |	ВТ_МХпоДопСвойству КАК ВТ_МХпоДопСвойству
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Субпортфели КАК Субпортфели
		               |		ПО ВТ_МХпоДопСвойству.Объект = Субпортфели.МестоХранения
		               |ГДЕ
		               |	Субпортфели.Портфель = &Портфель";
		Запрос.УстановитьПараметр("Портфель", Портфель);
	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("ИдентификаторДепозита"));
	Запрос.УстановитьПараметр("Значение", ИДДепозита);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		МестоХранения = Выборка.Объект;
	КонецЕсли;
	
	Возврат МестоХранения;	
	
КонецФункции

Функция НайтиПортфель(agreements_prefix)
	
	ДлиннаКода = СтрДлина(agreements_prefix);
	Если ДлиннаКода<4 Тогда
		КолДобавить = 4 - ДлиннаКода;
		Для Сч=1 По КолДобавить Цикл
			agreements_prefix = "0" + agreements_prefix
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Портфели.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Портфели КАК Портфели
		|ГДЕ
		|	Портфели.КодПортфеля ПОДОБНО ""%"" + &КодПортфеля + ""%""";
	
	Запрос.УстановитьПараметр("КодПортфеля", agreements_prefix);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Портфели.ПустаяСсылка();
	
КонецФункции

