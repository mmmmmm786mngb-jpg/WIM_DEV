		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.МестоХранения) ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.СубПортфель) Тогда
			
			Сообщение = "AVAN_DU " + СокрЛП(СтрокаТЧ.ИД) + " " + СокрП(СтрокаТЧ.Имя) + " - " + формат(СтрокаТЧ.РыночнаяСтоимость, "ЧРД=.; ЧГ=") + " (" + формат(СтрокаТЧ.Тело, "ЧРД=.; ЧГ=") + ") " + СтрокаТЧ.Валюта.Наименование;
			МассивНеОК.Добавить(Сообщение);
			Продолжить;
			
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПортфелей.Добавить();
		НоваяСтрока.Портфель = СтрокаТЧ.СубПортфель.Портфель;
		
		//IMDEV-4575
		ЗаписатьСтавкуДепозита(СтрокаТЧ.МестоХранения, СтрокаТЧ.Ставка);
		
		Набор = РегистрыСведений.ВТБ_ФактическаяПозицияДепозитов.СоздатьНаборЗаписей();
		Набор.Отбор.Дата.Установить(ДатаЗапроса);
		Набор.Отбор.МестоХранения.Установить(СтрокаТЧ.МестоХранения);
		Набор.Прочитать();
		
		Если Набор.Количество() = 0 Тогда
			
