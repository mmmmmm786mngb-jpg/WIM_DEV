&НаСервере
Процедура ОбновитьПозициюНаСервере()
	
	Лог = Неопределено;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Если Объект.ОчищатьДепозитыПередЗагрузкой=Истина Тогда
		ОбработкаОбъект.ОчиститьДепозиты();
	КонецЕсли;
	
	ОбработкаОбъект.ОбновитьФактическуюПозицию(Лог);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	ЛогОбновления.ДобавитьСтроку("Updated:");
	для Каждого Элемент из Лог.Обновлено Цикл
		ЛогОбновления.ДобавитьСтроку(Элемент);	
	КонецЦикла;
	
	ЛогОбновления.ДобавитьСтроку(Символы.ПС);
	
	ЛогОбновления.ДобавитьСтроку("Not Found:");
	для Каждого Элемент из Лог.НеОбновлено Цикл
		ЛогОбновления.ДобавитьСтроку(Элемент);	
	КонецЦикла;
	
	Если Лог.НеОбновлено.Количество() или Лог.НеОбновлено.Количество() Тогда
		РассылкаГотова = Истина;	
	КонецЕсли;
	
	Сообщить("Позиция обновлена");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПозицию(Команда)
	ОбновитьПозициюНаСервере();
КонецПроцедуры

