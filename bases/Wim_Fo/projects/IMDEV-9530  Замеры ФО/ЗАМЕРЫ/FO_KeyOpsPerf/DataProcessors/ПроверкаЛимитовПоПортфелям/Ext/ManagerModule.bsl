#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Замер постконтроля лимитов (ключевая операция ПроверкаЛимитов.ПостКонтроль): вся процедура задания - сбор
// портфелей из настройки, проверка и постановка лимитных ведомостей в очередь рассылки. Вес - число проверяемых
// портфелей. Отдельный ключ отделяет постконтроль от предконтроля поручений: внутренний замер
// Распорядители.ПроверкаИОтправка у обоих пишется с одним ключом "Проверка". Замер пишется и при досрочном
// завершении (в настройке нет портфелей, все портфели неактивны). Отказ проверки и пустая настройка отмечаются
// признаком ошибки замера. Логика проверки не меняется.
//
// Параметры:
//  РазмерПорции - Число - как в оригинале
//
&ИзменениеИКонтроль("ПроверкаПоЛимитамПоРасписанию")
Процедура FO_KeyOpsPerf_ПроверкаПоЛимитамПоРасписанию(РазмерПорции = 500) Экспорт

#Вставка
	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
#КонецВставки
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ПроверкаПоЛимитам);
	ТочкаВхода = Метаданные.Обработки.ПроверкаЛимитовПоПортфелям.ПолноеИмя();
	Настройки = ПолучитьНастройки();
	ТекущаяДата = ТекущаяДатаСеанса();
	ФокусСписок = СвойствоСтруктуры(Настройки, "СписокПортфелейГруппПортфелей");

	ДатаСоСмещением = НачалоДня(ТекущаяДата);
	Смещение = Настройки.Смещение;
	Если Смещение < 0 Тогда
		КалендарьСмещенияФактическеойПозиции = ПолныеПрава.ПолучитьКалендарьСмещениеФактическойПозиции();
		Если ЗначениеЗаполнено(КалендарьСмещенияФактическеойПозиции) Тогда
			ДатаСоСмещением = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(
				КалендарьСмещенияФактическеойПозиции, ДатаСоСмещением, Смещение);
		Иначе
			ДатаСоСмещением = ТекущаяДата + Смещение * 86400;
		КонецЕсли;
	КонецЕсли;

	Если ФокусСписок.Количество() = 0 Тогда
		Текст = НСтр("ru = 'Не удалось выполнить рассылку лимитных ведомостей. В настройках рассылки не установлены портфели/ группы портфелей';
		|en = 'It was not possible to make a mailing list. In the mailing settings, portfolio/ portfolio groups are not installed'");
		ЖурналРегистрации.ЗаписатьОшибкуЛимиты(Текст, "Проверка лимитов по расписанию: " + ТочкаВхода);
#Вставка
		ЗакончитьЗамерПостКонтроля(НачалоЗамера, ФокусСписок, Неопределено, ДатаСоСмещением, Неопределено, Истина);
#КонецВставки
		Возврат;
	КонецЕсли;

	Портфели = Новый Массив;
	Для Каждого Элемент Из ФокусСписок Цикл
		Если ТипЗнч(Элемент.Значение) = Тип("СправочникСсылка.Портфели") Тогда
			Портфели.Добавить(Элемент.Значение);
			Продолжить;
		КонецЕсли;

		//@skip-check bsl-legacy-check-string-literal
		ВсеПортфели = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.Значение, "ВсеПортфели");
		Если ВсеПортфели Тогда
			Группа = Элемент.Значение;
			СписокГруппы = Справочники.ГруппыПортфелей.СоставПулаПоГруппеПортфелей(Группа, ТекущаяДата);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Портфели, СписокГруппы, Истина);

		Иначе
			//@skip-check bsl-legacy-check-string-literal
			РеквизитыГруппы = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Элемент.Значение, "Пул, Список");
			Если РеквизитыГруппы.Пул Тогда
				Портфели.Добавить(Элемент.Значение);
			Иначе
				ВыборкаПортфелей = РеквизитыГруппы.Список.Выбрать();
				Пока ВыборкаПортфелей.Следующий() Цикл
					Портфели.Добавить(ВыборкаПортфелей.Портфель);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Портфели = РегистрыСведений.НеактивныеПортфели.ИсключитьНеактивныеИзСписка(Портфели);

	Если Портфели.Количество() = 0 Тогда
#Вставка
		ЗакончитьЗамерПостКонтроля(НачалоЗамера, ФокусСписок, Портфели, ДатаСоСмещением, Неопределено, Ложь);
#КонецВставки
		Возврат;
	КонецЕсли;

	СоставПозиции = Новый Массив();
	НастройкиПроверки = ПолучитьНастройки();
	Если СвойствоСтруктуры(НастройкиПроверки, "ИзменитьСоставПозиции", Ложь) Тогда
		СоставПозиции = СвойствоСтруктуры(НастройкиПроверки, "СоставПозиции", Новый Массив());
	КонецЕсли;

	ПараметрыИсх = РаспорядителиВызовСервера.ПараметрыПроверки(КонецДня(ДатаСоСмещением));
	ПараметрыИсх.ИспользоватьДатуАктуальности = Настройки.ИспользоватьДатуАктуальности;
	ПараметрыИсх.Портфели = Портфели;
	ПараметрыИсх.СоставПозиции = СоставПозиции;

	РезультатПроверки = Распорядители.ПроверкаИОтправка(ПараметрыИсх);
	Если РезультатПроверки.Отказ Тогда
#Вставка
		ЗакончитьЗамерПостКонтроля(НачалоЗамера, ФокусСписок, Портфели, ДатаСоСмещением, ПараметрыИсх, Истина);
#КонецВставки
		ВызватьИсключение РезультатПроверки.Описание;
	КонецЕсли;

	ИсполнителиПолныеПрава.ДополнитьОчередьНаРассылку(ПараметрыИсх.Вместилище);
#Вставка

	ЗакончитьЗамерПостКонтроля(НачалоЗамера, ФокусСписок, Портфели, ДатаСоСмещением, ПараметрыИсх, Ложь);
#КонецВставки

КонецПроцедуры

#КонецОбласти

#Область ЗамерыПостКонтроля

// Записывает замер ключевой операции ПроверкаЛимитов.ПостКонтроль. Вес - число портфелей проверки после
// исключения неактивных; если портфелей нет - 1.
//
// Параметры:
//  НачалоЗамера - Число - время начала процедуры в миллисекундах из НачатьЗамерВремени
//  ФокусСписок - СписокЗначений - группы портфелей и портфели из настройки рассылки
//  Портфели - Массив из СправочникСсылка.Портфели, Неопределено - портфели проверки; Неопределено, если список
//             еще не собран
//  ДатаПроверки - Дата - дата проверки с учетом смещения из настройки
//  ПараметрыПроверки - Структура, Неопределено - параметры Распорядители.ПроверкаИОтправка; Неопределено, если
//                      проверка не запускалась
//  ВыполненСОшибкой - Булево - отказ проверки или пустая настройка рассылки
//
Процедура ЗакончитьЗамерПостКонтроля(НачалоЗамера, ФокусСписок, Портфели, ДатаПроверки, ПараметрыПроверки,
	ВыполненСОшибкой)

	КоличествоПортфелей = 0;
	Если Портфели <> Неопределено Тогда
		КоличествоПортфелей = Портфели.Количество();
	КонецЕсли;

	ЧастиКомментария = Новый Массив;
	ЧастиКомментария.Добавить("Групп и портфелей в настройке: " + Формат(ФокусСписок.Количество(), "ЧН=0; ЧГ=0"));
	ЧастиКомментария.Добавить("Портфелей: " + Формат(КоличествоПортфелей, "ЧН=0; ЧГ=0"));
	Если ПараметрыПроверки = Неопределено Тогда
		ЧастиКомментария.Добавить("Проверка не выполнялась");
	ИначеЕсли ПараметрыПроверки.ИспользоватьФоновыеЗадания Тогда
		ЧастиКомментария.Добавить("Фоновые задания: Да");
		ЧастиКомментария.Добавить("Потоков проверки: "
			+ Формат(ПолныеПрава.ПотоковНаСеансПроверкиЛимитов(), "ЧН=0; ЧГ=0"));
	Иначе
		ЧастиКомментария.Добавить("Фоновые задания: Нет");
		ЧастиКомментария.Добавить("Потоков проверки: 1");
	КонецЕсли;
	ЧастиКомментария.Добавить("Дата проверки: " + Формат(ДатаПроверки, "ДФ=dd.MM.yyyy"));

	ОценкаПроизводительности.ЗакончитьЗамерВремени("ПроверкаЛимитов.ПостКонтроль", НачалоЗамера,
		Макс(КоличествоПортфелей, 1), СтрСоединить(ЧастиКомментария, "; "), ВыполненСОшибкой);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
