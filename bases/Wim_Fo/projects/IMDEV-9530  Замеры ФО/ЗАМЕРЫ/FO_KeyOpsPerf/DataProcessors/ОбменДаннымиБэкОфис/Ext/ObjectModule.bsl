// Записывает замер раздела пакета обмена и начинает отсчет времени следующего раздела.
// Замер пишется, только если замеры производительности включены и раздел пакета не пустой: диспетчеры вызывают
// обработчики всех разделов на каждый пакет, и записи по пустым разделам засорили бы регистр замеров.
// Вес - число разных портфелей раздела; для документов котировок - число котировок в них; для остальных разделов
// без портфеля - число строк.
//
// Параметры:
//  ВидРаздела - Строка - группа разделов пакета: "РегистрыСведений", "Справочники" или "Документы"
//  ИмяРаздела - Строка - имя свойства раздела в объекте XDTO группы
//  ОбъектРазделов - ОбъектXDTO - группа разделов пакета, содержащая раздел
//  НачалоЗамера - Число - время начала раздела в миллисекундах из НачатьЗамерВремени; на выходе - время начала
//                 следующего раздела
//  ИмяЗамера - Строка - имя замера, если оно отличается от имени раздела
//
Процедура ЗакончитьЗамерРазделаПакета(ВидРаздела, ИмяРаздела, ОбъектРазделов, НачалоЗамера, ИмяЗамера = "")

	Если ЗначениеЗаполнено(НачалоЗамера) Тогда
		ЭлементыРаздела = мПроводникXDTO.ОбъектыСписка(ОбъектРазделов, ИмяРаздела);
		КоличествоСтрок = ЭлементыРаздела.Количество();
		Если КоличествоСтрок > 0 Тогда
			ЭтоСправочникПортфелей = (ВидРаздела = "Справочники" И ИмяРаздела = "Портфели");
			КоличествоПортфелей = КоличествоПортфелейСписка(ЭлементыРаздела, ЭтоСправочникПортфелей);
			КоличествоКотировок = 0;
			Если ВидРаздела = "Документы" И ИмяРаздела = "КотировкиЦБНаБирже" Тогда
				КоличествоКотировок = КоличествоКотировокДокументов(ЭлементыРаздела);
			КонецЕсли;
			Если КоличествоПортфелей > 0 Тогда
				ВесЗамера = КоличествоПортфелей;
			ИначеЕсли КоличествоКотировок > 0 Тогда
				ВесЗамера = КоличествоКотировок;
			Иначе
				ВесЗамера = КоличествоСтрок;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ИмяЗамера) Тогда
				ИмяЗамера = ИмяРаздела;
			КонецЕсли;
			Комментарий = СтрШаблон("Строк: %1; Портфелей: %2; Пакет: %3",
				Формат(КоличествоСтрок, "ЧН=0; ЧГ=0"), Формат(КоличествоПортфелей, "ЧН=0; ЧГ=0"),
				ИдентификаторПакетаЗамера());
			Если КоличествоКотировок > 0 Тогда
				Комментарий = Комментарий + "; Котировок: " + Формат(КоличествоКотировок, "ЧН=0; ЧГ=0");
			КонецЕсли;
			ОценкаПроизводительности.ЗакончитьЗамерВремени("ОбменБэкОфис." + ВидРаздела + "." + ИмяЗамера,
				НачалоЗамера, ВесЗамера, Комментарий);
		КонецЕсли;
	КонецЕсли;

	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();

КонецПроцедуры

// Записывает замер операций после обмена (внешняя обработка из константы "Операции после обмена").
// Если обработка не задана, операций нет и замер не пишется.
//
// Параметры:
//  НачалоЗамера - Число - время начала операций в миллисекундах из НачатьЗамерВремени
//
Процедура ЗакончитьЗамерОперацийПослеОбмена(НачалоЗамера)

	Если ЗначениеЗаполнено(НачалоЗамера) И ЗначениеЗаполнено(ПолныеПрава.ОперацииПослеОбмена()) Тогда
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ОбменБэкОфис.ОперацииПослеОбмена", НачалоЗамера, 1,
			"Пакет: " + ИдентификаторПакетаЗамера());
	КонецЕсли;

КонецПроцедуры

// Записывает замер загрузки пакета целиком: проверка, разделы, операции после обмена, запись лога сервиса.
// Вес - число разных портфелей во всех разделах пакета, где есть портфель; если портфелей нет - число строк.
// Пакет, загруженный с ошибкой, отмечается признаком ошибки замера.
//
// Параметры:
//  ОбъектЗапрос - ОбъектXDTO - пакет, полученный веб-сервисом
//  НачалоЗамера - Число - время начала загрузки пакета в миллисекундах из НачатьЗамерВремени
//
Процедура ЗакончитьЗамерПакета(ОбъектЗапрос, НачалоЗамера)

	Если Не ЗначениеЗаполнено(НачалоЗамера) Тогда
		Возврат;
	КонецЕсли;

	ПортфелиПакета = Новый Соответствие;
	КоличествоСтрок = 0;
	КоличествоРазделов = 0;
	Для Каждого ВидРаздела Из СтрРазделить("Справочники,Документы,РегистрыСведений", ",") Цикл
		ОбъектРазделов = мПроводникXDTO.ЗначениеСвойства(ОбъектЗапрос, ВидРаздела);
		Если ОбъектРазделов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СвойстваРазделов = ОбъектРазделов.Свойства();
		Для Индекс = 0 По СвойстваРазделов.Количество() - 1 Цикл
			ИмяРаздела = СвойстваРазделов.Получить(Индекс).Имя;
			ЭлементыРаздела = мПроводникXDTO.ОбъектыСписка(ОбъектРазделов, ИмяРаздела);
			Если ЭлементыРаздела.Количество() > 0 Тогда
				КоличествоРазделов = КоличествоРазделов + 1;
				КоличествоСтрок = КоличествоСтрок + ЭлементыРаздела.Количество();
				ЭтоСправочникПортфелей = (ВидРаздела = "Справочники" И ИмяРаздела = "Портфели");
				КоличествоПортфелейСписка(ЭлементыРаздела, ЭтоСправочникПортфелей, ПортфелиПакета);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	КоличествоПортфелей = ПортфелиПакета.Количество();
	Если КоличествоПортфелей > 0 Тогда
		ВесЗамера = КоличествоПортфелей;
	ИначеЕсли КоличествоСтрок > 0 Тогда
		ВесЗамера = КоличествоСтрок;
	Иначе
		ВесЗамера = 1;
	КонецЕсли;

	КодОтвета = мОбъектОтвет.СтатусОтвета.Код;
	Комментарий = СтрШаблон("Портфелей: %1; Строк: %2; Разделов: %3; Код ответа: %4; Пакет: %5",
		Формат(КоличествоПортфелей, "ЧН=0; ЧГ=0"), Формат(КоличествоСтрок, "ЧН=0; ЧГ=0"),
		Формат(КоличествоРазделов, "ЧН=0; ЧГ=0"), КодОтвета, ИдентификаторПакетаЗамера());
	ОценкаПроизводительности.ЗакончитьЗамерВремени("ОбменБэкОфис.Пакет", НачалоЗамера, ВесЗамера, Комментарий,
		КодОтвета <> КодыОшибок().НетОшибок);

КонецПроцедуры

// Считает разные портфели в строках раздела пакета по внешнему коду портфеля, без обращения к базе.
// Портфель берется из свойства строки "Портфель", из свойства "Объект.Портфель" (дополнительные сведения) или
// из самой строки, если раздел - справочник портфелей. Строки раздела без портфеля дают 0.
//
// Параметры:
//  ЭлементыРаздела - СписокXDTO, Массив - строки раздела пакета
//  ЭтоСправочникПортфелей - Булево - строки раздела сами являются портфелями
//  ПортфелиПакета - Соответствие, Неопределено - если передано, в него добавляются внешние коды портфелей раздела
//
// Возвращаемое значение:
//  Число - количество разных портфелей в разделе
//
Функция КоличествоПортфелейСписка(ЭлементыРаздела, ЭтоСправочникПортфелей = Ложь, ПортфелиПакета = Неопределено)

	Если ЭлементыРаздела.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Если ЭтоСправочникПортфелей Тогда
		СпособЧтения = "Строка";
	Иначе
		СпособЧтения = СпособЧтенияПортфеляСтроки(ЭлементыРаздела.Получить(0));
		Если Не ЗначениеЗаполнено(СпособЧтения) Тогда
			Возврат 0;
		КонецЕсли;
	КонецЕсли;

	ПортфелиРаздела = Новый Соответствие;
	Для Каждого Элемент Из ЭлементыРаздела Цикл
		ПортфельXDTO = ПортфельСтрокиXDTO(Элемент, СпособЧтения);
		Если ПортфельXDTO = Неопределено Или Не ЗначениеЗаполнено(ПортфельXDTO.ВнешнийКод) Тогда
			Продолжить;
		КонецЕсли;
		ПортфелиРаздела.Вставить(ПортфельXDTO.ВнешнийКод, Истина);
		Если ПортфелиПакета <> Неопределено Тогда
			ПортфелиПакета.Вставить(ПортфельXDTO.ВнешнийКод, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат ПортфелиРаздела.Количество();

КонецФункции

// Считает котировки в документах котировок пакета: один документ содержит котировки всех ценных бумаг на дату.
//
// Параметры:
//  ЭлементыРаздела - СписокXDTO, Массив - документы КотировкаЦБНаБирже раздела пакета
//
// Возвращаемое значение:
//  Число - количество строк котировок во всех документах раздела
//
Функция КоличествоКотировокДокументов(ЭлементыРаздела)

	КоличествоКотировок = 0;
	Для Каждого Документ Из ЭлементыРаздела Цикл
		КоличествоКотировок = КоличествоКотировок + мПроводникXDTO.ОбъектыСписка(Документ, "Котировки").Количество();
	КонецЦикла;

	Возврат КоличествоКотировок;

КонецФункции

// Определяет по строке раздела пакета, где в ней указан портфель.
//
// Параметры:
//  Элемент - ОбъектXDTO - строка раздела пакета
//
// Возвращаемое значение:
//  Строка - "Портфель" (свойство строки), "Объект" (свойство Объект.Портфель) или пустая строка, если портфеля нет
//
Функция СпособЧтенияПортфеляСтроки(Элемент)

	Если ТипЗнч(Элемент) <> Тип("ОбъектXDTO") Тогда
		Возврат "";
	КонецЕсли;

	Если мПроводникXDTO.ЕстьСвойство(Элемент, "Портфель") Тогда
		Возврат "Портфель";
	КонецЕсли;

	Если мПроводникXDTO.ЕстьСвойство(Элемент, "Объект") Тогда
		ОбъектСтроки = Элемент.Объект;
		Если ТипЗнч(ОбъектСтроки) = Тип("ОбъектXDTO") И мПроводникXDTO.ЕстьСвойство(ОбъектСтроки, "Портфель") Тогда
			Возврат "Объект";
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает портфель строки раздела пакета способом, определенным СпособЧтенияПортфеляСтроки.
//
// Параметры:
//  Элемент - ОбъектXDTO - строка раздела пакета
//  СпособЧтения - Строка - "Портфель", "Объект" или "Строка" (строка раздела сама является портфелем)
//
// Возвращаемое значение:
//  ОбъектXDTO, Неопределено - портфель со свойством ВнешнийКод; Неопределено, если в строке портфель не указан
//
Функция ПортфельСтрокиXDTO(Элемент, СпособЧтения)

	Если СпособЧтения = "Строка" Тогда
		Возврат Элемент;
	ИначеЕсли СпособЧтения = "Портфель" Тогда
		Возврат Элемент.Портфель;
	ИначеЕсли СпособЧтения = "Объект" И Элемент.Объект <> Неопределено Тогда
		Возврат Элемент.Объект.Портфель;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Возвращает уникальный идентификатор пакета из заголовка ответа: по нему записи замеров разделов связываются
// с замером пакета.
//
// Возвращаемое значение:
//  Строка - идентификатор пакета; пустая строка, если ответ еще не сформирован
//
Функция ИдентификаторПакетаЗамера()

	Если мОбъектОтвет = Неопределено Или мОбъектОтвет.Заголовок = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(мОбъектОтвет.Заголовок.УникальныйИдентификаторЗапроса);

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
