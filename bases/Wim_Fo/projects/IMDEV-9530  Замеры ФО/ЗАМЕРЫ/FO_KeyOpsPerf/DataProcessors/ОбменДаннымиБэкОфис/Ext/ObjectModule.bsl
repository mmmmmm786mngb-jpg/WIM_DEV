#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Замер загрузки пакета веб-сервиса целиком (ключ ОбменБэкОфис.Пакет) и операций после обмена
// (ОбменБэкОфис.ОперацииПослеОбмена). Логика загрузки не меняется.
//
// Параметры:
//  ОбъектЗапрос - ОбъектXDTO - пакет, полученный веб-сервисом
//
// Возвращаемое значение:
//  ОбъектXDTO - ответ на пакет, как в оригинале
//
&ИзменениеИКонтроль("ЗагрузитьПакет")
Функция FO_KeyOpsPerf_ЗагрузитьПакет(ОбъектЗапрос) Экспорт

#Вставка
	НачалоЗамераПакета = ОценкаПроизводительности.НачатьЗамерВремени();
#КонецВставки
	мОбъектОтвет = ОбъектОтветПослеПредварительнойВалидацииЗапроса(ОбъектЗапрос, "ПакетОтвет");
	Если мОбъектОтвет.СтатусОтвета.Код = КодыОшибок().НетОшибок Тогда
		мДатаВыгрузкиИзВнешнейСистемы = ОбъектЗапрос.Заголовок.ДатаВыгрузки;
		мИспользоватьЧастичнуюЗагрузкуПозиции = Не ОбъектЗапрос.ИспользоватьЧастичнуюЗагрузкуПозиции = Неопределено
			И ОбъектЗапрос.ИспользоватьЧастичнуюЗагрузкуПозиции = Истина;
		мДоступнаНеполнаяПозиция = Не ОбъектЗапрос.ДоступнаНеполнаяПозиция = Неопределено
			И ОбъектЗапрос.ДоступнаНеполнаяПозиция = Истина;

		мНеосновнаяБаза = Не ОбъектЗапрос.НеосновнаяБаза = Неопределено
			И ОбъектЗапрос.НеосновнаяБаза = Истина;

		мПривязыватьБрокерскиеСчета = Не ОбъектЗапрос.ПривязыватьБрокерскиеСчета = Неопределено
			И ОбъектЗапрос.ПривязыватьБрокерскиеСчета = Истина;

		мЗаполнениеПоАктиву = Не ОбъектЗапрос.ЗаполнениеПоАктиву = Неопределено
			И ОбъектЗапрос.ЗаполнениеПоАктиву = Истина;

		мЗагружатьВсеСделкиРЕПО = Не ОбъектЗапрос.ЗагружатьВсеСделкиРЕПО = Неопределено
			И ОбъектЗапрос.ЗагружатьВсеСделкиРЕПО = Истина;

		ЗаполнитьНаборКлючейПоиска(ОбъектЗапрос);

		ЗагрузитьДанные(ОбъектЗапрос);
		ОбработатьКэшНенайденныхЭлементов();
#Вставка
		НачалоЗамераОпераций = ОценкаПроизводительности.НачатьЗамерВремени();
#КонецВставки
		ВыполнитьОперацииПослеОбмена(ОбъектЗапрос);
#Вставка
		ЗакончитьЗамерОперацийПослеОбмена(НачалоЗамераОпераций);
#КонецВставки
	КонецЕсли;

	мОбъектОтвет.Заголовок.ДатаВыполнения = ТекущаяДатаСеанса();
	ЛогироватьСервис(ПараметрыЛогированияПоОбъекту(мОбъектОтвет));

#Вставка
	ЗакончитьЗамерПакета(ОбъектЗапрос, НачалоЗамераПакета);
#КонецВставки

	Возврат мОбъектОтвет;

КонецФункции

#КонецОбласти

#КонецЕсли

