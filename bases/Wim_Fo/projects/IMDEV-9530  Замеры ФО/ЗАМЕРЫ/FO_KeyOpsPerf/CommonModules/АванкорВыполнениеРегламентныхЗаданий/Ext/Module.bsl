#Область СлужебныйПрограммныйИнтерфейс

// Замер упаковки данных (ключевая операция УпаковкаДанных): отдельная запись на каждый шаг и итог всей
// процедуры. Вес 1: шаги не возвращают число обработанных записей. Логика упаковки не меняется.
//
&ИзменениеИКонтроль("УпаковкаДанных")
Процедура FO_KeyOpsPerf_УпаковкаДанных() Экспорт

	УстановитьПривилегированныйРежим(Истина);

#Вставка
	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	НачалоШага = НачалоЗамера;
#КонецВставки
	РегистрыСведений.КэшВмОписания.Упаковать();
#Вставка
	ЗакончитьЗамерШагаУпаковки("КэшВмОписания", НачалоШага);
#КонецВставки
	РегистрыСведений.КэшВмОписания.ОчиститьСлужебныеКэши();
#Вставка
	ЗакончитьЗамерШагаУпаковки("ОчиститьСлужебныеКэши", НачалоШага);
#КонецВставки

	Обработки.ВоркбенчУтилиты.ОчиститьДанныеНеактивныхСеансов();
#Вставка
	ЗакончитьЗамерШагаУпаковки("ОчиститьДанныеНеактивныхСеансов", НачалоШага);
#КонецВставки

	КоличествоАктивныхТорговыхДат = ТорговаяЧастьНастройки.КоличествоАктивныхТорговыхДат();
	Если ЗначениеЗаполнено(КоличествоАктивныхТорговыхДат) Тогда
#Вставка
		НачалоШага = ОценкаПроизводительности.НачатьЗамерВремени();
#КонецВставки
		РегистрыСведений.БиржевыеТранзакции.Сократить(КоличествоАктивныхТорговыхДат);
#Вставка
		ЗакончитьЗамерШагаУпаковки("Сократить.БиржевыеТранзакции", НачалоШага, КоличествоАктивныхТорговыхДат);
#КонецВставки
		РегистрыСведений.БиржевыеТранзакцииНеторговые.Сократить(КоличествоАктивныхТорговыхДат);
#Вставка
		ЗакончитьЗамерШагаУпаковки("Сократить.БиржевыеТранзакцииНеторговые", НачалоШага, КоличествоАктивныхТорговыхДат);
#КонецВставки
		РегистрыСведений.БиржевыеЗаявкиВнешние.Сократить(КоличествоАктивныхТорговыхДат);
#Вставка
		ЗакончитьЗамерШагаУпаковки("Сократить.БиржевыеЗаявкиВнешние", НачалоШага, КоличествоАктивныхТорговыхДат);
#КонецВставки
		РегистрыСведений.СообщенияАдаптеров.Сократить(КоличествоАктивныхТорговыхДат);
#Вставка
		ЗакончитьЗамерШагаУпаковки("Сократить.СообщенияАдаптеров", НачалоШага, КоличествоАктивныхТорговыхДат);
#КонецВставки
		РегистрыСведений.СведенияОБиржевыхДисконтах.Сократить(КоличествоАктивныхТорговыхДат);
#Вставка
		ЗакончитьЗамерШагаУпаковки("Сократить.СведенияОБиржевыхДисконтах", НачалоШага, КоличествоАктивныхТорговыхДат);
#КонецВставки

	Иначе
		ИмяСобытия = НСтр("ru = 'Упаковка данных'");
		Примечание = НСтр("ru = 'В настройках торговой части не указано количество активных торговых дат,
		|очистка обработанных данных не будет выполнена. Рекомендованное значение для данной настройки 7-14 дней.'");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Примечание, , , СтрЗаменить(Примечание, Символы.ПС, " "));

	КонецЕсли;
#Вставка

	ОценкаПроизводительности.ЗакончитьЗамерВремени("УпаковкаДанных", НачалоЗамера, 1,
		"Активных торговых дат: " + Формат(КоличествоАктивныхТорговыхДат, "ЧН=0; ЧГ=0"));
#КонецВставки

КонецПроцедуры

#Область ЗамерыУпаковкиДанных

// Записывает замер шага упаковки данных (ключ УпаковкаДанных.<Шаг>, вес 1) и начинает отсчет следующего шага.
//
// Параметры:
//  ИмяШага - Строка - имя шага в ключе замера
//  НачалоШага - Число - время начала шага в миллисекундах из НачатьЗамерВремени; на выходе - время начала
//               следующего шага
//  КоличествоАктивныхТорговыхДат - Число, Неопределено - глубина сокращения регистра, пишется в комментарий
//
Процедура ЗакончитьЗамерШагаУпаковки(ИмяШага, НачалоШага, КоличествоАктивныхТорговыхДат = Неопределено)

	КомментарийЗамера = Неопределено;
	Если КоличествоАктивныхТорговыхДат <> Неопределено Тогда
		КомментарийЗамера = "Активных торговых дат: " + Формат(КоличествоАктивныхТорговыхДат, "ЧН=0; ЧГ=0");
	КонецЕсли;
	ОценкаПроизводительности.ЗакончитьЗамерВремени("УпаковкаДанных." + ИмяШага, НачалоШага, 1, КомментарийЗамера);
	НачалоШага = ОценкаПроизводительности.НачатьЗамерВремени();

КонецПроцедуры

#КонецОбласти

#КонецОбласти
