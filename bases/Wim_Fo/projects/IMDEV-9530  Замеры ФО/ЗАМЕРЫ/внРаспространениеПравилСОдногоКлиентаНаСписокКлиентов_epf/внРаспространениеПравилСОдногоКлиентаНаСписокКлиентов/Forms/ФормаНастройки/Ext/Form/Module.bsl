
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ДопОбработка", ДопОбработка);
	
	Объект.СписокСервисныхПользователей.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Пользователи");
	Объект.СписокТиповКлиентовКомплаенс.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ТипыКлиентов");
	Объект.СписокТиповКлиентовРиски.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ТипыКлиентов");
	
	Настройки = ДопОбработка.ХранилищеНастроек.Получить();
	
	Если ТипЗнч(Настройки) = Тип("ХранилищеЗначения") Тогда
		Настройки = Настройки.Получить();
		Если ТипЗнч(Настройки) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Объект, Настройки);
		КонецЕсли;
	ИначеЕсли ТипЗнч(Настройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект, Настройки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	Если ПроверитьЗаполнение() Тогда
		СохранитьНаСервере();
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Процедура СохранитьНаСервере()
	
	Настройки = Новый Структура;
	Настройки.Вставить("Дата_распространения_правил_комплаенс", Объект.Дата_распространения_правил_комплаенс);
	Настройки.Вставить("Дата_распространения_правил_риски", Объект.Дата_распространения_правил_риски);
	Настройки.Вставить("Эталонный_портфель_лимитов", Объект.Эталонный_портфель_лимитов);
	Настройки.Вставить("Эталонный_портфель_лимитов_комплаенс", Объект.Эталонный_портфель_лимитов_комплаенс);
	Настройки.Вставить("Эталонный_портфель_лимитов_риски", Объект.Эталонный_портфель_лимитов_риски);
	Настройки.Вставить("КлассЛимитовКомплаенс", Объект.КлассЛимитовКомплаенс);
	Настройки.Вставить("КлассЛимитовРиски", Объект.КлассЛимитовРиски);
	Настройки.Вставить("НастройкаРассылкиКомплаенс", Объект.НастройкаРассылкиКомплаенс);
	Настройки.Вставить("НастройкаРассылкиРиски", Объект.НастройкаРассылкиРиски);
	Настройки.Вставить("ДатаАвтоустановкиЛимитовКомплаенс", Объект.ДатаАвтоустановкиЛимитовКомплаенс);
	Настройки.Вставить("ВнешнийКодЭталонногоПортфеляКомплаенс", Объект.ВнешнийКодЭталонногоПортфеляКомплаенс);
	Настройки.Вставить("ЛимитыЗаведеныКомплаенс", Объект.ЛимитыЗаведеныКомплаенс);
	Настройки.Вставить("ДатаАвтоустановкиЛимитовРиски", Объект.ДатаАвтоустановкиЛимитовРиски);
	Настройки.Вставить("ВнешнийКодЭталонногоПортфеляРиски", Объект.ВнешнийКодЭталонногоПортфеляРиски);
	Настройки.Вставить("ЛимитыЗаведеныРиски", Объект.ЛимитыЗаведеныРиски);
	Настройки.Вставить("СписокСервисныхПользователей", Объект.СписокСервисныхПользователей);
	Настройки.Вставить("СписокТиповКлиентовКомплаенс", Объект.СписокТиповКлиентовКомплаенс);
	Настройки.Вставить("СписокТиповКлиентовРиски", Объект.СписокТиповКлиентовРиски);
	Настройки.Вставить("НастройкаРассылкиПриУспешномАвтораспространении", Объект.НастройкаРассылкиПриУспешномАвтораспространении);
	Настройки.Вставить("ЭтоБазаРозничногоДУ", Объект.ЭтоБазаРозничногоДУ);
	
	ОбработкаОбъект = ДопОбработка.ПолучитьОбъект();
	ОбработкаОбъект.ХранилищеНастроек = Новый ХранилищеЗначения(Настройки);
	ОбработкаОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти