// Тестовая обработка IMDEV-9530 для разработческой ФО: подготовка тестовых данных и запуск внешних обработок этапа 4
// теми же вызовами, что выполняют их точки входа: торговые поручения РОСТ - команда регламентного задания, форма
// и фоновые потоки формы; распространение правил - обработка "Операции после обмена"; неторговые поручения РОСТ -
// команда регламентного задания. Запускается фоновым заданием ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки
// (метод ВыполнитьСценарий), потому что модули документа Поручение и общих модулей распорядителей во внешнем соединении
// не компилируются. В рабочие базы не передается.

#Область ПрограммныйИнтерфейс

// Сведения для регистрации в справочнике дополнительных обработок.
//
// Возвращаемое значение:
//  Структура - см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.1.1.12");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "T9530 тест обработок РОСТ";
	Команда.Идентификатор = "ВыполнитьСценарий";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();

	Возврат ПараметрыРегистрации;

КонецФункции

// Выполняет сценарий теста и помещает результат во временное хранилище.
//
// Параметры:
//  Параметры - Структура - параметры сценария:
//   * Сценарий - Строка - подготовка данных ("Данные", "Купоны", "Статусы", "Сведения", "ГотовностьПоручений",
//                "УстановкиЛимитов"), другие обработки этапа ("Распространение", "Неторговые"), процедура потока
//                ("Поток") или сценарий обработки торговых поручений РОСТ: "Покупка.Команда", "Продажа.Команда",
//                "Покупка.Форма", "Продажа.Форма", "Реинвест.Форма", "Реинвест.Потоки", "Блокировки.Потоки"
//   * остальные поля - по сценарию, см. процедуры области СлужебныеПроцедурыИФункции
//  АдресРезультата - Строка - адрес временного хранилища для результата (Структура: Лог, Ошибка, Поручения,
//                    КоличествоПоручений, ВажностьОшибки, Даты)
//
Процедура ВыполнитьСценарий(Параметры, АдресРезультата) Экспорт

	Если Параметры.Сценарий = "Поток" Тогда
		ВыполнитьПоток(Параметры, АдресРезультата);
		Возврат;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Лог", "");
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Поручения", Новый Массив);
	Результат.Вставить("КоличествоПоручений", 0);
	Результат.Вставить("ВажностьОшибки", 0);
	Результат.Вставить("Даты", Новый Структура);
	Результат.Вставить("Потоки", Новый Массив);

	Попытка
		Если Параметры.Сценарий = "Данные" Тогда
			ПодготовитьДанные(Параметры, Результат);
		ИначеЕсли Параметры.Сценарий = "Купоны" Тогда
			СоздатьКупонноеРасписание(Параметры, Результат);
		ИначеЕсли Параметры.Сценарий = "Статусы" Тогда
			Для Каждого Портфель Из Параметры.Портфели Цикл
				УстановитьСтатус(Портфель, Параметры.Свойство, Параметры.Статус, Параметры.СвойствоДата);
			КонецЦикла;
		ИначеЕсли Параметры.Сценарий = "ГотовностьПоручений" Тогда
			УстановитьГотовностьПоручений(Параметры.Поручения);
		ИначеЕсли Параметры.Сценарий = "Сведения" Тогда
			Для Каждого Запись Из Параметры.Записи Цикл
				ЗаписатьСведение(Запись.Объект, Запись.Свойство, Запись.Значение);
			КонецЦикла;
		ИначеЕсли Параметры.Сценарий = "УстановкиЛимитов" Тогда
			СоздатьУстановкиЛимитов(Параметры.Документы, Результат);
		ИначеЕсли Параметры.Сценарий = "Распространение" Тогда
			ВыполнитьРаспространениеПравил(Параметры, Результат);
		ИначеЕсли Параметры.Сценарий = "Неторговые" Тогда
			ВыполнитьЗагрузкуНеторговых(Параметры, Результат);
		Иначе
			ВыполнитьСценарийРОСТ(Параметры, Результат);
		КонецЕсли;
	Исключение
		Результат.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СценарииРОСТ

// Вызывает обработку РОСТ так же, как ее вызывают точки входа. Один экземпляр обработки на сценарий: форма
// между серверными вызовами пересоздает объект из реквизита формы, но переменная модуля с описанием замера
// после каждой точки входа очищается, поэтому один экземпляр поведение не меняет.
//
// Параметры:
//  Параметры - Структура:
//   * ОбработкаСсылка - СправочникСсылка.ДополнительныеОтчетыИОбработки - обработка РОСТ
//   * ЭтоТест - Булево - тестовый режим обработки (цена из регистра котировок вместо стакана)
//   * ДатаКупона - Дата - дата купона для реинвестирования
//   * Портфели - Массив из СправочникСсылка.Портфели - портфели, отмечаемые в списке реинвестирования формы
//   * ПередаватьПортфелейВПакете - Булево - форма версии с замерами передает потокам размер пакета
//  Результат - Структура - см. ВыполнитьСценарий
//
Процедура ВыполнитьСценарийРОСТ(Параметры, Результат)

	Ссылка = Параметры.ОбработкаСсылка;
	Обработка = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Ссылка);
	Обработка.ЭтоТест = Параметры.ЭтоТест;

	ПараметрыВыполнения = Новый Структура("ДополнительнаяОбработкаСсылка", Ссылка);
	Обработка.УстановитьНастройки(ПараметрыВыполнения);

	ТекстОшибки = "";
	ВажностьОшибки = 0;
	КоличествоПоручений = 0;

	// Ошибка точки входа обработки РОСТ - результат сценария (лог и состояние данных нужны и в этом случае).
	Попытка
		ВызватьТочкуВходаРОСТ(Обработка, Параметры, Результат, ТекстОшибки, ВажностьОшибки, КоличествоПоручений);
	Исключение
		Результат.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Результат.Лог = Обработка.Лог.ПолучитьТекст();
	Результат.КоличествоПоручений = КоличествоПоручений;
	Результат.ВажностьОшибки = ВажностьОшибки;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Результат.Лог = Результат.Лог + Символы.ПС + "[ТекстОшибки] " + ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

// Вызывает точку входа обработки РОСТ по сценарию.
//
// Параметры:
//  Обработка - ВнешняяОбработкаОбъект - обработка РОСТ с установленными настройками
//  Параметры - Структура - см. ВыполнитьСценарийРОСТ
//  Результат - Структура - см. ВыполнитьСценарий
//  ТекстОшибки - Строка - выходной параметр точек входа: текст ошибок
//  ВажностьОшибки - Число - выходной параметр точек входа: 0, 1 или 2
//  КоличествоПоручений - Число - выходной параметр точек входа: поручения, переданные на отправку
//
Процедура ВызватьТочкуВходаРОСТ(Обработка, Параметры, Результат, ТекстОшибки, ВажностьОшибки, КоличествоПоручений)

	ПараметрыВыполнения = Новый Структура("ДополнительнаяОбработкаСсылка", Параметры.ОбработкаСсылка);
	Сценарий = Параметры.Сценарий;

	Если Сценарий = "Покупка.Команда" Тогда
		Обработка.ВыполнитьКоманду("ФоновоеВыполнениеПокупка", ПараметрыВыполнения);

	ИначеЕсли Сценарий = "Продажа.Команда" Тогда
		Обработка.ВыполнитьКоманду("ФоновоеВыполнениеПродажа", ПараметрыВыполнения);

	ИначеЕсли Сценарий = "Покупка.Форма" Тогда
		// Кнопки "Обновить список" и "Создать и отправить поручения" закладки покупки.
		Обработка.ОбновитьСписокПортфелейПокупка(ТекстОшибки, ВажностьОшибки);
		Обработка.СоздатьОтправитьПорученияПокупка(КоличествоПоручений, ТекстОшибки, ВажностьОшибки);
		Обработка.ОбновитьСписокПортфелейПокупка(ТекстОшибки, ВажностьОшибки);

	ИначеЕсли Сценарий = "Продажа.Форма" Тогда
		// Кнопки "Получить список на расторжение" и "Создать поручения продажа".
		Обработка.ЗаполнитьСписокПродажаАктивов(Истина, ТекстОшибки, ВажностьОшибки);
		Обработка.СоздатьПорученияПродажа(КоличествоПоручений, ТекстОшибки, ВажностьОшибки);
		Обработка.ЗаполнитьСписокПродажаАктивов(Истина, ТекстОшибки, ВажностьОшибки);

	ИначеЕсли Сценарий = "Реинвест.Форма" Тогда
		Обработка.РеинвестОбновитьСписокПотфелей(Параметры.ДатаКупона, Истина, 0, 0, ТекстОшибки, ВажностьОшибки);
		Для Каждого СтрокаСписка Из Обработка.СписокПортфелейРеинвестирование Цикл
			СтрокаСписка.Пометка = Параметры.Портфели.Найти(СтрокаСписка.Портфель) <> Неопределено;
		КонецЦикла;
		Обработка.РеинвестСоздатьИОтправитьОрдера(КоличествоПоручений, ТекстОшибки, ВажностьОшибки);
		Обработка.РеинвестОбновитьСписокПотфелей(Параметры.ДатаКупона, Истина, 0, 0, ТекстОшибки, ВажностьОшибки);

	ИначеЕсли Сценарий = "Реинвест.Потоки" Тогда
		Обработка.РеинвестОбновитьСписокПотфелей(Параметры.ДатаКупона, Истина, 0, 0, ТекстОшибки, ВажностьОшибки);
		ВыполнитьПотокиФормы(Обработка, Параметры, Результат, "РеинвестСоздатьОрдера",
			Обработка.СписокПортфелейРеинвестирование);

	ИначеЕсли Сценарий = "Блокировки.Потоки" Тогда
		Обработка.БлокировкиПродажиОбновитьСписокПотфелей("LQDT", Истина, ТекстОшибки, ВажностьОшибки);
		ВыполнитьПотокиФормы(Обработка, Параметры, Результат, "БлокировкиПродажиСоздатьОрдера",
			Обработка.СписокПортфелейПродажиПодБлокировки);

	Иначе
		ВызватьИсключение "Неизвестный сценарий " + Сценарий;
	КонецЕсли;

КонецПроцедуры

// Повторяет кнопки формы "Создать поручения в потоке" (реинвестирование) и "Отправить пачку поручений" (продажи
// под блокировки): отмечает все строки, распределяет их по 10 потокам с ограничением ПорученийВПакете = 200,
// запускает фоновые задания с процедурой потока и отправляет поручения, созданные потоками, одной пачкой.
// Отличие от формы: процедура потока выполняется в тестовом режиме (см. ВыполнитьПоток).
//
// Параметры:
//  Обработка - ВнешняяОбработкаОбъект - обработка РОСТ с заполненным списком
//  Параметры - Структура - см. ВыполнитьСценарийРОСТ
//  Результат - Структура - см. ВыполнитьСценарий
//  ИмяМетода - Строка - процедура потока модуля объекта обработки РОСТ
//  СписокПортфелей - ТабличнаяЧасть - список закладки формы
//
Процедура ВыполнитьПотокиФормы(Обработка, Параметры, Результат, ИмяМетода, СписокПортфелей)

	КоличествоПотоков = 10;
	ПорученийВПакете = 200;
	ЭтоБлокировки = ИмяМетода = "БлокировкиПродажиСоздатьОрдера";

	ПортфелейОтмечено = 0;
	НомерТекПотока = 1;
	Для Каждого СтрокаТабл Из СписокПортфелей Цикл
		СтрокаТабл.Пометка = Истина;
		СтрокаТабл.НомерПотока = 0;
		Если ЗначениеЗаполнено(СтрокаТабл.Поручение) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоБлокировки И СтрокаТабл.ОстатокДС > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоБлокировки И СтрокаТабл.СуммаРеинвестирования <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ПортфелейОтмечено < ПорученийВПакете Тогда
			СтрокаТабл.НомерПотока = НомерТекПотока;
			ПортфелейОтмечено = ПортфелейОтмечено + 1;
			Если НомерТекПотока = КоличествоПотоков Тогда
				НомерТекПотока = 1;
			Иначе
				НомерТекПотока = НомерТекПотока + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Задания = Новый Массив;
	Для НомерПотока = 1 По КоличествоПотоков Цикл

		ПортфелиСписок = Новый Массив;
		Для Каждого СтрокаТаб Из СписокПортфелей.НайтиСтроки(Новый Структура("НомерПотока", НомерПотока)) Цикл
			Если ЭтоБлокировки Тогда
				Если СтрокаТаб.ОстатокДС >= 0 Тогда
					Продолжить;
				КонецЕсли;
				НовСтрока = Новый Структура("Портфель,СубПортфель,Актив,СуммаПоручения,ОстатокЦБ,Поручение");
				ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТаб);
				НовСтрока.СуммаПоручения = -СтрокаТаб.ОстатокДС * (1 + Обработка.ПроцентКомиссияБрокер / 100);
			Иначе
				НовСтрока = Новый Структура("Портфель,СубПортфель,Актив,СуммаРеинвестирования,Поручение");
				ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТаб);
			КонецЕсли;
			ПортфелиСписок.Добавить(НовСтрока);
		КонецЦикла;

		Если Не ЗначениеЗаполнено(ПортфелиСписок) Тогда
			Продолжить;
		КонецЕсли;

		ПараметрыПотока = Новый Структура;
		ПараметрыПотока.Вставить("ПортфелиСписок", Новый ФиксированныйМассив(ПортфелиСписок));
		ПараметрыПотока.Вставить("НомерПотока", НомерПотока);
		ПараметрыПотока.Вставить("ОбработкаСсылка", Параметры.ОбработкаСсылка);
		Если Параметры.ПередаватьПортфелейВПакете Тогда
			ПараметрыПотока.Вставить("ПортфелейВПакете", ПортфелейОтмечено);
		КонецЕсли;

		ПараметрыВызова = Новый Структура;
		ПараметрыВызова.Вставить("Сценарий", "Поток");
		ПараметрыВызова.Вставить("ОбработкаСсылка", Параметры.ОбработкаСсылка);
		ПараметрыВызова.Вставить("ЭтоТест", Параметры.ЭтоТест);
		ПараметрыВызова.Вставить("ИмяМетода", ИмяМетода);
		ПараметрыВызова.Вставить("ПараметрыПотока", ПараметрыПотока);

		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("ИмяОбработки", Метаданные().Имя);
		ПараметрыЗадания.Вставить("ИмяМетода", "ВыполнитьСценарий");
		ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыВызова);
		ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
		ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", Параметры.ТестоваяОбработкаСсылка);

		АдресПотока = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(ПараметрыЗадания);
		ПараметрыМетода.Добавить(АдресПотока);
		Если ЭтоБлокировки Тогда
			Префикс = "ПродажиПодБлокировки#";
		Иначе
			Префикс = "ПродажиРеинвестирование#";
		КонецЕсли;
		Задание = ФоновыеЗадания.Выполнить("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			ПараметрыМетода, , Префикс + НомерПотока);
		Задания.Добавить(Новый Структура("Задание, Адрес, НомерПотока, Портфели", Задание, АдресПотока, НомерПотока,
			ПортфелиСписок.Количество()));

	КонецЦикла;

	ПорученияНаОтправку = Новый Массив;
	Для Каждого ОписаниеЗадания Из Задания Цикл
		ОписаниеЗадания.Задание.ОжидатьЗавершенияВыполнения(1800);
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ОписаниеЗадания.Задание.УникальныйИдентификатор);
		СведенияПотока = Новый Структура("НомерПотока, Портфели, Состояние, Ошибка, Поручений, Лог",
			ОписаниеЗадания.НомерПотока, ОписаниеЗадания.Портфели, Строка(Задание.Состояние), "", 0, "");
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			СведенияПотока.Ошибка = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
		СтруктураОтвета = ПолучитьИзВременногоХранилища(ОписаниеЗадания.Адрес);
		Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
			СведенияПотока.Поручений = СтруктураОтвета.ПорученияНаОтправку.Количество();
			СведенияПотока.Лог = СтруктураОтвета.Лог;
			Для Каждого Поручение Из СтруктураОтвета.ПорученияНаОтправку Цикл
				ПорученияНаОтправку.Добавить(Поручение);
			КонецЦикла;
		КонецЕсли;
		Результат.Потоки.Добавить(СведенияПотока);
	КонецЦикла;

	// Кнопка формы "Отправить пачку поручений" (ОтправитьПачкуПорученийНаСервере).
	Если ЗначениеЗаполнено(ПорученияНаОтправку) Тогда
		Обработка.ОтправитьПоручения(ПорученияНаОтправку);
	КонецЕсли;
	Результат.Поручения = ПорученияНаОтправку;

КонецПроцедуры

// Процедура фонового потока: создает обработку РОСТ из справочника, включает тестовый режим и вызывает процедуру
// потока так же, как ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки.
//
// Параметры:
//  Параметры - Структура - ОбработкаСсылка, ЭтоТест, ИмяМетода, ПараметрыПотока
//  АдресРезультата - Строка - адрес, куда процедура потока помещает свой ответ
//
Процедура ВыполнитьПоток(Параметры, АдресРезультата)

	Обработка = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Параметры.ОбработкаСсылка);
	Обработка.ЭтоТест = Параметры.ЭтоТест;

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(Параметры.ПараметрыПотока);
	ПараметрыМетода.Добавить(АдресРезультата);
	ОбщегоНазначения.ВыполнитьМетодОбъекта(Обработка, Параметры.ИмяМетода, ПараметрыМетода);

КонецПроцедуры

#КонецОбласти

#Область ДругиеОбработки

// Вызывает распространение правил лимитов так же, как обработка "Операции после обмена" при признаке обмена
// ТребуетсяРаспространениеПравил: объект обработки из справочника и метод ВыполнитьРаспространениеПравилПослеОбмена.
//
// Параметры:
//  Параметры - Структура - ОбработкаСсылка (СправочникСсылка.ДополнительныеОтчетыИОбработки)
//  Результат - Структура - см. ВыполнитьСценарий; Лог - текстовый лог последнего класса лимитов
//
Процедура ВыполнитьРаспространениеПравил(Параметры, Результат)

	Обработка = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Параметры.ОбработкаСсылка);
	Попытка
		Обработка.ВыполнитьРаспространениеПравилПослеОбмена(Параметры.ОбработкаСсылка);
	Исключение
		Результат.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Результат.Лог = Обработка.ТекстовыйЛог.ПолучитьТекст();

КонецПроцедуры

// Выполняет команду регламентного задания загрузки неторговых поручений РОСТ.
//
// Параметры:
//  Параметры - Структура - ОбработкаСсылка, ЭтоТест (сумма на брокерском счете без обращения к адаптеру)
//  Результат - Структура - см. ВыполнитьСценарий
//
Процедура ВыполнитьЗагрузкуНеторговых(Параметры, Результат)

	Обработка = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Параметры.ОбработкаСсылка);
	Обработка.ЭтоТест = Параметры.ЭтоТест;
	Попытка
		Обработка.ВыполнитьКоманду("ФоновоеВыполнение",
			Новый Структура("ДополнительнаяОбработкаСсылка", Параметры.ОбработкаСсылка));
	Исключение
		Результат.Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Результат.Лог = Обработка.Лог.ПолучитьТекст();

КонецПроцедуры

#КонецОбласти

#Область ТестовыеДанные

// Создает данные портфелей одной версии обработки: неторговые поручения ввода и вывода текущего дня,
// фактическую позицию на даты, которые обработка читает в тестовом режиме, и статусы портфелей.
//
// Параметры:
//  Параметры - Структура:
//   * Портфели - Массив из Структура - Портфель, Субпортфель, МестоХранения, Группа ("П", "К", "С", "Р", "Б", "Ф"),
//                Активен (Булево - ставить статус сразу), Сумма (Число - ввод, вывод или купонная позиция)
//   * Свойство, СвойствоДата - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - статус и дата статуса
//   * Статусы - Структура - ЗначенияСвойствОбъектов по ключам Поиск, Расторжение, Окончание
//   * АктивРубли, АктивОблигация, АктивЛиквидность - СправочникСсылка.Активы
//   * АктивыПродажи - Массив из СправочникСсылка.Активы
//  Результат - Структура - см. ВыполнитьСценарий; в Даты - даты позиций
//
Процедура ПодготовитьДанные(Параметры, Результат)

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	ДатаПродажи = НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, Сегодня, -1));
	ДатаРеинвест = НачалоДня(Сегодня - 1);
	ДатаБлокировки = НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(
		Справочники.ПроизводственныеКалендари.ТорговыйКалендарьММВБ, Сегодня, -1));
	Результат.Даты = Новый Структура("Сегодня, Продажа, Реинвест, Блокировки", Сегодня, ДатаПродажи, ДатаРеинвест,
		ДатаБлокировки);

	Для Каждого Строка Из Параметры.Портфели Цикл

		Если Строка.Группа = "П" Или Строка.Группа = "К" Тогда
			Результат.Поручения.Добавить(СоздатьНеторговоеПоручение(Строка, Параметры.АктивРубли,
				Перечисления.ВидыОперацийНеторговыхПоручений.Ввод));
			Статус = Параметры.Статусы.Поиск;

		ИначеЕсли Строка.Группа = "С" Тогда
			Позиция = Новый Соответствие;
			Номер = 0;
			Для Каждого Актив Из Параметры.АктивыПродажи Цикл
				Номер = Номер + 1;
				Позиция.Вставить(Актив, Строка.Сумма * Номер);
			КонецЦикла;
			ЗаписатьФактическуюПозицию(Строка, ДатаПродажи, Позиция);
			Статус = Параметры.Статусы.Расторжение;

		ИначеЕсли Строка.Группа = "Р" Или Строка.Группа = "Ф" Тогда
			Позиция = Новый Соответствие;
			Позиция.Вставить(Параметры.АктивОблигация, Строка.Сумма);
			Позиция.Вставить(Параметры.АктивРубли, 10000000);
			ЗаписатьФактическуюПозицию(Строка, ДатаРеинвест, Позиция);
			Статус = Параметры.Статусы.Окончание;

		ИначеЕсли Строка.Группа = "Б" Тогда
			Позиция = Новый Соответствие;
			Позиция.Вставить(Параметры.АктивЛиквидность, 100000);
			ЗаписатьФактическуюПозицию(Строка, ДатаБлокировки, Позиция);
			Результат.Поручения.Добавить(СоздатьНеторговоеПоручение(Строка, Параметры.АктивРубли,
				Перечисления.ВидыОперацийНеторговыхПоручений.Вывод));
			Статус = Параметры.Статусы.Окончание;

		Иначе
			ВызватьИсключение "Неизвестная группа портфелей " + Строка.Группа;
		КонецЕсли;

		Если Строка.Активен Тогда
			УстановитьСтатус(Строка.Портфель, Параметры.Свойство, Статус, Параметры.СвойствоДата);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Создает и проводит неторговое поручение текущего дня в рублях по образцу ЗаписатьНеторговоеПоручение
// обработки РОСТ.
//
// Параметры:
//  Строка - Структура - см. ПодготовитьДанные (Портфель, Субпортфель, МестоХранения, Сумма)
//  АктивРубли - СправочникСсылка.Активы - актив валюты RUB
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийНеторговыхПоручений - Ввод или Вывод
//
// Возвращаемое значение:
//  ДокументСсылка.Поручение
//
Функция СоздатьНеторговоеПоручение(Строка, АктивРубли, ВидОперации)

	ЭтоВвод = ВидОперации = Перечисления.ВидыОперацийНеторговыхПоручений.Ввод;

	ДокументПоручение = Документы.Поручение.СоздатьДокумент();
	ДокументПоручение.Дата = ТекущаяДатаСеанса();
	ДокументПоручение.ВидОперации = Перечисления.ВидыПоручений.НеторговоеПоручение;
	ДокументПоручение.ВидОперацииНеторговогоПоручения = ВидОперации;
	ДокументПоручение.Актив = АктивРубли;
	ДокументПоручение.ВалютаРасчетов = Справочники.Валюты.RUB;
	ДокументПоручение.Внебиржевая = Истина;
	ДокументПоручение.ЗаполнениеПоПортфелю = Истина;
	ДокументПоручение.Портфель = Строка.Портфель;
	ДокументПоручение.Субпортфель = Строка.Субпортфель;
	ДокументПоручение.СубпортфельЦБ = Строка.Субпортфель;
	ДокументПоручение.МестоХранения = Строка.МестоХранения;
	ДокументПоручение.Количество = Строка.Сумма;
	ДокументПоручение.ВысокийПриоритет = Ложь;
	ДокументПоручение.ДатаОплаты = ТекущаяДатаСеанса();
	ДокументПоручение.ДатаПоставки = ТекущаяДатаСеанса();
	Если ЭтоВвод Тогда
		ДокументПоручение.Направление = Перечисления.ВидыОперацийСделки.Покупка;
	Иначе
		ДокументПоручение.Направление = Перечисления.ВидыОперацийСделки.Продажа;
	КонецЕсли;
	ДокументПоручение.РежимFOP = Перечисления.РежимыFOP.PREPAYMENT;
	ДокументПоручение.Срочность = 1;
	ДокументПоручение.СуммаПоручения = Строка.Сумма;
	ДокументПоручение.ТипРасчетовПоВнебиржевойСделке = Перечисления.ТипыРасчетовПоВнебиржевымСделкам.FOP;
	ДокументПоручение.УсловиеИсполнения = Перечисления.УсловияИсполненияОрдеровНаБирже.PUT_IN_QUEUE;
	ДокументПоручение.Комментарий = "IMDEV-9530 тест: " + ВидОперации;

	НСтрРаспределение = ДокументПоручение.РаспределениеПоПортфелям.Добавить();
	НСтрРаспределение.Портфель = Строка.Портфель;
	НСтрРаспределение.Количество = Строка.Сумма;
	НСтрРаспределение.Субпортфель = Строка.Субпортфель;
	НСтрРаспределение.СубпортфельЦБ = Строка.Субпортфель;
	НСтрРаспределение.МестоХранения = Строка.МестоХранения;
	НСтрРаспределение.МестоХраненияЦБ = Строка.МестоХранения;

	ДокументПоручение.Записать(РежимЗаписиДокумента.Проведение);

	Возврат ДокументПоручение.Ссылка;

КонецФункции

// Записывает фактическую позицию портфеля на дату (замещает записи портфеля на эту дату).
//
// Параметры:
//  Строка - Структура - см. ПодготовитьДанные (Портфель, Субпортфель, МестоХранения)
//  Дата - Дата - дата позиции
//  Позиция - Соответствие - ключ СправочникСсылка.Активы, значение Число (количество)
//
Процедура ЗаписатьФактическуюПозицию(Строка, Дата, Позиция)

	НаборЗаписей = РегистрыСведений.ФактическаяПозиция.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Дата.Установить(Дата);
	НаборЗаписей.Отбор.Портфель.Установить(Строка.Портфель);
	Для Каждого ЭлементПозиции Из Позиция Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.Дата = Дата;
		Запись.Портфель = Строка.Портфель;
		Запись.Субпортфель = Строка.Субпортфель;
		Запись.МестоХранения = Строка.МестоХранения;
		Запись.Актив = ЭлементПозиции.Ключ;
		Запись.Количество = ЭлементПозиции.Значение;
		Запись.Стоимость = ЭлементПозиции.Значение;
	КонецЦикла;
	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// Записывает статус портфеля и дату статуса так же, как ОбновитьСтатусПоПортфелю обработки РОСТ (без истории).
//
// Параметры:
//  Портфель - СправочникСсылка.Портфели
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - статус портфеля
//  Статус - СправочникСсылка.ЗначенияСвойствОбъектов
//  СвойствоДата - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - дата статуса
//
Процедура УстановитьСтатус(Портфель, Свойство, Статус, СвойствоДата)

	ЗаписьВРегистр = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	ЗаписьВРегистр.Объект = Портфель;
	ЗаписьВРегистр.Свойство = Свойство;
	ЗаписьВРегистр.Значение = Статус;
	ЗаписьВРегистр.Записать(Истина);

	ЗаписьВРегистр = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	ЗаписьВРегистр.Объект = Портфель;
	ЗаписьВРегистр.Свойство = СвойствоДата;
	ЗаписьВРегистр.Значение = ТекущаяДатаСеанса();
	ЗаписьВРегистр.Записать(Истина);

КонецПроцедуры

// Записывает значение дополнительного сведения объекта (замещает прежнее значение).
//
// Параметры:
//  Объект - ЛюбаяСсылка - владелец сведения
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения
//  Значение - Произвольный
//
Процедура ЗаписатьСведение(Объект, Свойство, Значение)

	ЗаписьВРегистр = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	ЗаписьВРегистр.Объект = Объект;
	ЗаписьВРегистр.Свойство = Свойство;
	ЗаписьВРегистр.Значение = Значение;
	ЗаписьВРегистр.Записать(Истина);

КонецПроцедуры

// Создает и проводит установки лимитов по портфелю копированием образцов: эталонному портфелю и портфелю,
// у которого установка лимитов уже есть. Число лимитов копии ограничивается, чтобы проведение было быстрым.
//
// Параметры:
//  Документы - Массив из Структура - Образец (ДокументСсылка.УстановкаЛимитов), Портфель (СправочникСсылка.Портфели),
//              ЧислоЛимитов (Число)
//  Результат - Структура - см. ВыполнитьСценарий; в Поручения - созданные документы
//
Процедура СоздатьУстановкиЛимитов(Документы, Результат)

	Для Каждого Описание Из Документы Цикл
		Документ = Описание.Образец.Скопировать();
		Документ.Дата = ТекущаяДатаСеанса();
		Документ.ОбъектНазначения = Описание.Портфель;
		Документ.ИсключаемыеПортфели.Очистить();
		Пока Документ.Лимиты.Количество() > Описание.ЧислоЛимитов Цикл
			Документ.Лимиты.Удалить(Документ.Лимиты.Количество() - 1);
		КонецЦикла;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Поручения.Добавить(Документ.Ссылка);
	КонецЦикла;

КонецПроцедуры

// Ставит поручениям статус блоттера Ready - так адаптер отмечает исполненное поручение ОФЗ, после чего покупка
// переходит ко второму этапу (акции и ликвидность).
//
// Параметры:
//  Поручения - Массив из ДокументСсылка.Поручение
//
Процедура УстановитьГотовностьПоручений(Поручения)

	Для Каждого Поручение Из Поручения Цикл
		ЗаписьСтатуса = РегистрыСведений.СтатусыПоручений.СоздатьМенеджерЗаписи();
		ЗаписьСтатуса.Поручение = Поручение;
		ЗаписьСтатуса.Прочитать();
		ЗаписьСтатуса.Поручение = Поручение;
		ЗаписьСтатуса.СтатусРасш = Перечисления.СтатусыПорученийБлоттер.Ready;
		ЗаписьСтатуса.СтатусСтрокой = "Ready";
		ЗаписьСтатуса.ДатаСтатуса = ТекущаяДатаСеанса();
		ЗаписьСтатуса.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Создает и проводит купонное расписание тестовой облигации: полугодовые купоны, один из них выплачивается
// в дату купона реинвестирования.
//
// Параметры:
//  Параметры - Структура:
//   * Облигация - СправочникСсылка.Облигации
//   * ДатаКупона - Дата - дата выплаты одного из купонов
//   * РазмерКупона - Число - купон в рублях на одну облигацию
//   * КупоновВперед - Число - купонов после даты купона
//  Результат - Структура - см. ВыполнитьСценарий
//
Процедура СоздатьКупонноеРасписание(Параметры, Результат)

	Документ = Документы.КупонноеРасписание.СоздатьДокумент();
	Документ.Дата = ДобавитьМесяц(НачалоДня(Параметры.ДатаКупона), -12);
	Документ.Облигация = Параметры.Облигация;
	Документ.Ответственный = Пользователи.ТекущийПользователь();
	Документ.Комментарий = "IMDEV-9530 тест реинвестирования";

	НачалоПериода = ДобавитьМесяц(НачалоДня(Параметры.ДатаКупона), -6);
	Для НомерКупона = 1 По Параметры.КупоновВперед + 1 Цикл
		ОкончаниеПериода = ДобавитьМесяц(НачалоПериода, 6);
		Купон = Документ.Купоны.Добавить();
		Купон.НомерКупонногоПериода = НомерКупона;
		Купон.ДатаНачалаКупонногоПериода = НачалоПериода;
		Купон.ДатаОкончанияКупонногоПериода = ОкончаниеПериода;
		Купон.КолДнейВКупонномПериоде = (ОкончаниеПериода - НачалоПериода) / 86400;
		Купон.РазмерДоходаВРублях = Параметры.РазмерКупона;
		Купон.ДатаФиксацииРеестраВладельцевЦБ = ОкончаниеПериода - 86400;
		Купон.ДатаВыплатыКупонногоДохода = ОкончаниеПериода;
		НачалоПериода = ОкончаниеПериода;
	КонецЦикла;

	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Результат.Поручения.Добавить(Документ.Ссылка);

КонецПроцедуры

