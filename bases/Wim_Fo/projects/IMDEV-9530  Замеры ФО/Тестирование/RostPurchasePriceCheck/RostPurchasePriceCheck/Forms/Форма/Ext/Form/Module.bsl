    СформироватьНаСервере();

КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьЛог(Команда)

    Если Поручения.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Сначала сформируйте отчет.");
        Возврат;
    КонецЕсли;

    ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов;
    ПараметрыДиалога.Заголовок = "Сохранить подробный лог";
    Ждать ПолучитьФайлССервераАсинх(АдресЛогаНаСервере(), ИмяФайлаЛога(), ПараметрыДиалога);

КонецПроцедуры

// Описание: Собирает поручения покупки за период и раскладывает их по запускам регламента
//
// Запуск - пачка поручений, между которыми прошло не больше РазрывЗапускаСекунд.
// В сравнение котировок входят только проведенные поручения без пометки удаления.
//
&НаСервере
Процедура СформироватьНаСервере()

    Итоги.Очистить();
    Поручения.Очистить();

    Если Не ЗначениеЗаполнено(Период.ДатаНачала) Или Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
        СообщитьПользователю("Укажите период.");
        Возврат;
    КонецЕсли;

    Если Период.ДатаНачала > Период.ДатаОкончания Тогда
        СообщитьПользователю("Начало периода позже его окончания.");
        Возврат;
    КонецЕсли;

    Запуски = ЗапускиПоручений(ВыбратьПоручения());
    Для Каждого Запуск Из Запуски Цикл
        ВывестиЗапуск(Запуск);
    КонецЦикла;

    СообщитьПользователю(ТекстСводки(Запуски));

КонецПроцедуры

// Описание: Возвращает адрес двоичных данных JSON во временном хранилище
//
// Возвращаемое значение:
// Строка - адрес во временном хранилище
//
&НаСервере
Функция АдресЛогаНаСервере()

    Текст = ТекстЛога();
    ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8);
    Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

&НаСервере
Функция ИмяФайлаЛога()

    Возврат "rost_purchase_prices_" + Формат(Период.ДатаНачала, "ДФ=yyyyMMdd") + ".json";

КонецФункции

&НаСервере
Функция ВыбратьПоручения()

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Поручение.Ссылка КАК Поручение,
    |    Поручение.Дата КАК Дата,
    |    Поручение.Номер КАК Номер,
    |    Поручение.Портфель КАК Портфель,
    |    Поручение.Портфель.КодПортфеля КАК КодПортфеля,
    |    Поручение.Портфель.Наименование КАК ПортфельНаименование,
    |    Поручение.Актив КАК Актив,
    |    Поручение.Актив.КраткоеНаименование КАК КодАктива,
    |    Поручение.Актив.ISIN КАК ISIN,
    |    Поручение.Актив.Наименование КАК АктивНаименование,
    |    Поручение.Котировка КАК Котировка,
    |    Поручение.ЦенаВВалютеРасчетов КАК Цена,
    |    Поручение.Количество КАК Количество,
    |    Поручение.СуммаПоручения КАК Сумма,
    |    Поручение.Проведен КАК Проведен,
    |    Поручение.ПометкаУдаления КАК ПометкаУдаления,
    |    Поручение.Ответственный.Наименование КАК Ответственный
    |ИЗ
    |    Документ.Поручение КАК Поручение
    |ГДЕ
    |    Поручение.Дата МЕЖДУ &Начало И &Конец
    |    И Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.Сделка)
    |    И Поручение.Биржа = ЗНАЧЕНИЕ(Справочник.Биржи.ММВБ)
    |    И (НЕ &ОтборПоОтветственному
    |        ИЛИ Поручение.Ответственный = &Ответственный)
    |
    |УПОРЯДОЧИТЬ ПО
    |    Дата,
    |    Номер";

    Запрос.УстановитьПараметр("Начало", Период.ДатаНачала);
    Запрос.УстановитьПараметр("Конец", КонецДня(Период.ДатаОкончания));
    Запрос.УстановитьПараметр("ОтборПоОтветственному", ЗначениеЗаполнено(Ответственный));
    Запрос.УстановитьПараметр("Ответственный", Ответственный);

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Описание: Делит выборку поручений на запуски регламента по паузе между документами
//
// Параметры:
// ТаблицаПоручений - ТаблицаЗначений - поручения периода в порядке даты
//
// Возвращаемое значение:
// Массив - элементы Структура(Номер, Начало, Окончание, Поручения, Бумаги)
//
&НаСервере
Функция ЗапускиПоручений(ТаблицаПоручений)

    Запуски = Новый Массив;
    Текущий = Неопределено;
    ПредыдущаяДата = Неопределено;
    Порог = ПорогРазрыва();

    Для Каждого Строка Из ТаблицаПоручений Цикл

        Если Текущий = Неопределено Или Строка.Дата - ПредыдущаяДата > Порог Тогда
            Текущий = НовыйЗапуск(Запуски.Количество() + 1, Строка.Дата);
            Запуски.Добавить(Текущий);
        КонецЕсли;

        Текущий.Окончание = Строка.Дата;
        Текущий.Поручения.Добавить(Строка);
        ПредыдущаяДата = Строка.Дата;

        Если Не УчаствуетВСравнении(Строка) Тогда
            Продолжить;
        КонецЕсли;

        Бумага = БумагаЗапуска(Текущий, Строка);
        Бумага.Поручений = Бумага.Поручений + 1;
        Если Бумага.Котировки[Строка.Котировка] = Неопределено Тогда
            Бумага.Котировки.Вставить(Строка.Котировка, Истина);
            Бумага.РазныхЦен = Бумага.РазныхЦен + 1;
        КонецЕсли;
        Если Бумага.Поручений = 1 Или Строка.Котировка < Бумага.КотировкаМин Тогда
            Бумага.КотировкаМин = Строка.Котировка;
        КонецЕсли;
        Если Бумага.Поручений = 1 Или Строка.Котировка > Бумага.КотировкаМакс Тогда
            Бумага.КотировкаМакс = Строка.Котировка;
        КонецЕсли;

    КонецЦикла;

    Возврат Запуски;

КонецФункции

&НаСервере
Процедура ВывестиЗапуск(Запуск)

    Если Запуск.Бумаги.Количество() = 0 Тогда
        СтрокаИтога = Итоги.Добавить();
        СтрокаИтога.НомерЗапуска = Запуск.Номер;
        СтрокаИтога.Начало = Запуск.Начало;
        СтрокаИтога.Окончание = Запуск.Окончание;
        СтрокаИтога.ТекстИтога = "Нет поручений для сравнения";
    КонецЕсли;

    Для Каждого Бумага Из Запуск.Бумаги Цикл
        СтрокаИтога = Итоги.Добавить();
        СтрокаИтога.НомерЗапуска = Запуск.Номер;
        СтрокаИтога.Начало = Запуск.Начало;
        СтрокаИтога.Окончание = Запуск.Окончание;
        СтрокаИтога.Актив = Бумага.Актив;
        СтрокаИтога.Поручений = Бумага.Поручений;
        СтрокаИтога.КотировкаМин = Бумага.КотировкаМин;
        СтрокаИтога.КотировкаМакс = Бумага.КотировкаМакс;
        СтрокаИтога.ПроцентОтклонения = ПроцентОтклонения(Бумага);
        СтрокаИтога.РазныхЦен = Бумага.РазныхЦен;
        СтрокаИтога.ТекстИтога = ТекстИтогаБумаги(Бумага);
    КонецЦикла;

    Для Каждого Строка Из Запуск.Поручения Цикл
        СтрокаПоручения = Поручения.Добавить();
        СтрокаПоручения.НомерЗапуска = Запуск.Номер;
        СтрокаПоручения.Дата = Строка.Дата;
        СтрокаПоручения.Номер = Строка.Номер;
        СтрокаПоручения.Поручение = Строка.Поручение;
        СтрокаПоручения.Портфель = Строка.Портфель;
        СтрокаПоручения.КодПортфеля = Строка.КодПортфеля;
        СтрокаПоручения.Актив = Строка.Актив;
        СтрокаПоручения.КодАктива = Строка.КодАктива;
        СтрокаПоручения.Котировка = Строка.Котировка;
        СтрокаПоручения.Цена = Строка.Цена;
        СтрокаПоручения.Количество = Строка.Количество;
        СтрокаПоручения.Сумма = Строка.Сумма;
        СтрокаПоручения.Проведен = Строка.Проведен;
        СтрокаПоручения.ПометкаУдаления = Строка.ПометкаУдаления;
        СтрокаПоручения.ВСравнении = УчаствуетВСравнении(Строка);
        СтрокаПоручения.Примечание = ПримечаниеПоручения(Строка);
        СтрокаПоручения.Ответственный = Строка.Ответственный;
    КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ТекстЛога()

    Запуски = ЗапускиПоручений(ВыбратьПоручения());

    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON);
    Запись.ЗаписатьНачалоОбъекта();
    Запись.ЗаписатьИмяСвойства("comment");
    Запись.ЗаписатьЗначение(
        "Лог проверки цен покупки РОСТ. Одна итерация - пачка поручений с паузой не больше gapSeconds. "
        + "Сравнивается котировка одной бумаги внутри итерации. Помеченные на удаление не сравниваются.");
    Запись.ЗаписатьИмяСвойства("periodStart");
    Запись.ЗаписатьЗначение(ФорматДаты(Период.ДатаНачала));
    Запись.ЗаписатьИмяСвойства("periodEnd");
    Запись.ЗаписатьЗначение(ФорматДаты(Период.ДатаОкончания));
    Запись.ЗаписатьИмяСвойства("responsible");
    Запись.ЗаписатьЗначение(Строка(Ответственный));
    Запись.ЗаписатьИмяСвойства("gapSeconds");
    Запись.ЗаписатьЗначение(ПорогРазрыва());
    Запись.ЗаписатьИмяСвойства("generatedAt");
    Запись.ЗаписатьЗначение(ФорматДаты(ТекущаяДатаСеанса()));
    Запись.ЗаписатьИмяСвойства("iterations");
    Запись.ЗаписатьНачалоМассива();

    Для Каждого Запуск Из Запуски Цикл
        ЗаписатьЗапуск(Запись, Запуск);
    КонецЦикла;

    Запись.ЗаписатьКонецМассива();
    Запись.ЗаписатьКонецОбъекта();
    Возврат Запись.Закрыть();

КонецФункции

&НаСервере
Процедура ЗаписатьЗапуск(Запись, Запуск)

    РазныхБумаг = 0;
    Сравниваемых = 0;
    Для Каждого Бумага Из Запуск.Бумаги Цикл
        Сравниваемых = Сравниваемых + Бумага.Поручений;
        Если Бумага.РазныхЦен > 1 Тогда
            РазныхБумаг = РазныхБумаг + 1;
        КонецЕсли;
    КонецЦикла;

    Запись.ЗаписатьНачалоОбъекта();
    Запись.ЗаписатьИмяСвойства("index");
    Запись.ЗаписатьЗначение(Запуск.Номер);
    Запись.ЗаписатьИмяСвойства("startedAt");
    Запись.ЗаписатьЗначение(ФорматДаты(Запуск.Начало));
    Запись.ЗаписатьИмяСвойства("finishedAt");
    Запись.ЗаписатьЗначение(ФорматДаты(Запуск.Окончание));
    Запись.ЗаписатьИмяСвойства("ordersTotal");
    Запись.ЗаписатьЗначение(Запуск.Поручения.Количество());
    Запись.ЗаписатьИмяСвойства("ordersCompared");
    Запись.ЗаписатьЗначение(Сравниваемых);
    Запись.ЗаписатьИмяСвойства("assetsWithDifferentPrices");
    Запись.ЗаписатьЗначение(РазныхБумаг);

    Запись.ЗаписатьИмяСвойства("assets");
    Запись.ЗаписатьНачалоМассива();
    Для Каждого Бумага Из Запуск.Бумаги Цикл
        Запись.ЗаписатьНачалоОбъекта();
        Запись.ЗаписатьИмяСвойства("asset");
        Запись.ЗаписатьЗначение(Бумага.Наименование);
        Запись.ЗаписатьИмяСвойства("assetCode");
        Запись.ЗаписатьЗначение(Бумага.Код);
        Запись.ЗаписатьИмяСвойства("isin");
        Запись.ЗаписатьЗначение(Бумага.ISIN);
        Запись.ЗаписатьИмяСвойства("ordersCompared");
        Запись.ЗаписатьЗначение(Бумага.Поручений);
        Запись.ЗаписатьИмяСвойства("distinctQuotes");
        Запись.ЗаписатьЗначение(Бумага.РазныхЦен);
        Запись.ЗаписатьИмяСвойства("minQuote");
        Запись.ЗаписатьЗначение(Бумага.КотировкаМин);
        Запись.ЗаписатьИмяСвойства("maxQuote");
        Запись.ЗаписатьЗначение(Бумага.КотировкаМакс);
        Запись.ЗаписатьИмяСвойства("deviationPercent");
        Запись.ЗаписатьЗначение(ПроцентОтклонения(Бумага));
        Запись.ЗаписатьИмяСвойства("verdict");
        Запись.ЗаписатьЗначение(ТекстИтогаБумаги(Бумага));
        Запись.ЗаписатьКонецОбъекта();
    КонецЦикла;
    Запись.ЗаписатьКонецМассива();

    Запись.ЗаписатьИмяСвойства("orders");
    Запись.ЗаписатьНачалоМассива();
    Для Каждого Строка Из Запуск.Поручения Цикл
        Запись.ЗаписатьНачалоОбъекта();
        Запись.ЗаписатьИмяСвойства("date");
        Запись.ЗаписатьЗначение(ФорматДаты(Строка.Дата));
        Запись.ЗаписатьИмяСвойства("number");
        Запись.ЗаписатьЗначение(Строка.Номер);
        Запись.ЗаписатьИмяСвойства("uuid");
        Запись.ЗаписатьЗначение(Строка(Строка.Поручение.УникальныйИдентификатор()));
        Запись.ЗаписатьИмяСвойства("portfolio");
        Запись.ЗаписатьЗначение(Строка.ПортфельНаименование);
        Запись.ЗаписатьИмяСвойства("portfolioCode");
        Запись.ЗаписатьЗначение(Строка.КодПортфеля);
        Запись.ЗаписатьИмяСвойства("asset");
        Запись.ЗаписатьЗначение(Строка.АктивНаименование);
        Запись.ЗаписатьИмяСвойства("assetCode");
        Запись.ЗаписатьЗначение(Строка.КодАктива);
        Запись.ЗаписатьИмяСвойства("isin");
        Запись.ЗаписатьЗначение(Строка.ISIN);
        Запись.ЗаписатьИмяСвойства("quote");
        Запись.ЗаписатьЗначение(Строка.Котировка);
        Запись.ЗаписатьИмяСвойства("price");
        Запись.ЗаписатьЗначение(Строка.Цена);
        Запись.ЗаписатьИмяСвойства("quantity");
        Запись.ЗаписатьЗначение(Строка.Количество);
        Запись.ЗаписатьИмяСвойства("amount");
        Запись.ЗаписатьЗначение(Строка.Сумма);
        Запись.ЗаписатьИмяСвойства("posted");
        Запись.ЗаписатьЗначение(Строка.Проведен);
        Запись.ЗаписатьИмяСвойства("deletionMark");
        Запись.ЗаписатьЗначение(Строка.ПометкаУдаления);
        Запись.ЗаписатьИмяСвойства("includedInComparison");
        Запись.ЗаписатьЗначение(УчаствуетВСравнении(Строка));
        Запись.ЗаписатьИмяСвойства("note");
        Запись.ЗаписатьЗначение(ПримечаниеПоручения(Строка));
        Запись.ЗаписатьИмяСвойства("responsible");
        Запись.ЗаписатьЗначение(Строка.Ответственный);
        Запись.ЗаписатьКонецОбъекта();
    КонецЦикла;
    Запись.ЗаписатьКонецМассива();
    Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

&НаСервере
Функция НовыйЗапуск(Номер, ДатаНачала)

    Запуск = Новый Структура;
    Запуск.Вставить("Номер", Номер);
    Запуск.Вставить("Начало", ДатаНачала);
    Запуск.Вставить("Окончание", ДатаНачала);
    Запуск.Вставить("Поручения", Новый Массив);
    Запуск.Вставить("Бумаги", Новый Массив);
    Запуск.Вставить("ИндексБумаг", Новый Соответствие);
    Возврат Запуск;

КонецФункции

&НаСервере
Функция БумагаЗапуска(Запуск, Строка)

    Бумага = Запуск.ИндексБумаг[Строка.Актив];
    Если Бумага <> Неопределено Тогда
        Возврат Бумага;
    КонецЕсли;

    Бумага = Новый Структура;
    Бумага.Вставить("Актив", Строка.Актив);
    Бумага.Вставить("Код", Строка.КодАктива);
    Бумага.Вставить("ISIN", Строка.ISIN);
    Бумага.Вставить("Наименование", Строка.АктивНаименование);
    Бумага.Вставить("Поручений", 0);
    Бумага.Вставить("РазныхЦен", 0);
    Бумага.Вставить("КотировкаМин", 0);
    Бумага.Вставить("КотировкаМакс", 0);
    Бумага.Вставить("Котировки", Новый Соответствие);
    Запуск.Бумаги.Добавить(Бумага);
    Запуск.ИндексБумаг.Вставить(Строка.Актив, Бумага);
    Возврат Бумага;

КонецФункции

&НаСервере
Функция УчаствуетВСравнении(Строка)

    Возврат Строка.Проведен И Не Строка.ПометкаУдаления;

КонецФункции

&НаСервере
Функция ПримечаниеПоручения(Строка)

    Если Строка.ПометкаУдаления Тогда
        Возврат "Помечено на удаление, в сравнение не входит";
    КонецЕсли;

    Если Не Строка.Проведен Тогда
        Возврат "Не проведено, в сравнение не входит";
    КонецЕсли;

    Возврат "";

КонецФункции

&НаСервере
Функция ТекстИтогаБумаги(Бумага)

    Если Бумага.Поручений = 0 Тогда
        Возврат "Нет поручений для сравнения";
    ИначеЕсли Бумага.Поручений = 1 Тогда
        Возврат "Одна заявка";
    ИначеЕсли Бумага.РазныхЦен = 1 Тогда
        Возврат "Одинаковая";
    КонецЕсли;

    Возврат "Разные цены";

КонецФункции

// Описание: Считает, на сколько процентов максимальная котировка выше минимальной
// Отклонение заполняется, когда у бумаги внутри запуска больше одной цены и минимум не ноль
//
// Параметры:
// Бумага - Структура - итог по бумаге запуска: КотировкаМин, КотировкаМакс, РазныхЦен
//
// Возвращаемое значение:
// Число - (максимум - минимум) / минимум * 100; 0, если цены совпали или минимум равен нулю
//
&НаСервере
Функция ПроцентОтклонения(Бумага)

    Если Бумага.РазныхЦен <= 1 Или Бумага.КотировкаМин = 0 Тогда
        Возврат 0;
    КонецЕсли;

    Возврат (Бумага.КотировкаМакс - Бумага.КотировкаМин) / Бумага.КотировкаМин * 100;

КонецФункции

&НаСервере
Функция ТекстСводки(Запуски)

    Если Запуски.Количество() = 0 Тогда
        Возврат "За период поручений покупки на ММВБ не найдено.";
    КонецЕсли;

    РазныхБумаг = 0;
    Для Каждого Запуск Из Запуски Цикл
        Для Каждого Бумага Из Запуск.Бумаги Цикл
            Если Бумага.РазныхЦен > 1 Тогда
                РазныхБумаг = РазныхБумаг + 1;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Возврат СтрШаблон("Запусков: %1. Бумаг с разными котировками внутри запуска: %2.",
        Формат(Запуски.Количество(), "ЧГ=0"), Формат(РазныхБумаг, "ЧГ=0"));

КонецФункции

&НаСервере
Функция ПорогРазрыва()

    Если РазрывЗапускаСекунд < 1 Тогда
        Возврат 180;
    КонецЕсли;

    Возврат РазрывЗапускаСекунд;

КонецФункции

&НаСервере
Функция ФорматДаты(Дата)

    Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");

КонецФункции

&НаСервере
Процедура СообщитьПользователю(Текст)

    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Текст;
    Сообщение.Сообщить();

КонецПроцедуры
