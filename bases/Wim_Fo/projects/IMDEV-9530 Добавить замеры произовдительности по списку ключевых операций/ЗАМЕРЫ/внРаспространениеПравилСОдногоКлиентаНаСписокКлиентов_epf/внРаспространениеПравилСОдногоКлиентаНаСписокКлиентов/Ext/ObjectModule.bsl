Функция ПолучитьПорогиЛимитовЭталонногоПортфеля(ЭталонныйПортфель, Портфель, Лимиты)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПорогиЛимитовСрезПоследних.Период КАК Период,
		|	ПорогиЛимитовСрезПоследних.Лимит КАК Лимит,
		|	ПРЕДСТАВЛЕНИЕ(ПорогиЛимитовСрезПоследних.Лимит) КАК ЛимитПредставление,
		|	ПорогиЛимитовСрезПоследних.НастройкаПороговДляПроверкиЛимитов КАК НастройкаПороговДляПроверкиЛимитов,
		|	ПРЕДСТАВЛЕНИЕ(ПорогиЛимитовСрезПоследних.НастройкаПороговДляПроверкиЛимитов) КАК НастройкаПороговДляПроверкиЛимитовПредставление
		|ПОМЕСТИТЬ ЭталонныеПороги
		|ИЗ
		|	РегистрСведений.ПорогиЛимитов.СрезПоследних(
		|			&Дата,
		|			Портфель = &ЭталонныйПортфель
		|				И Лимит В (&Лимиты)) КАК ПорогиЛимитовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПорогиЛимитовСрезПоследних.Период КАК Период,
		|	ПорогиЛимитовСрезПоследних.Лимит КАК Лимит,
		|	ПРЕДСТАВЛЕНИЕ(ПорогиЛимитовСрезПоследних.Лимит) КАК ЛимитПредставление,
		|	ПорогиЛимитовСрезПоследних.НастройкаПороговДляПроверкиЛимитов КАК НастройкаПороговДляПроверкиЛимитов,
		|	ПРЕДСТАВЛЕНИЕ(ПорогиЛимитовСрезПоследних.НастройкаПороговДляПроверкиЛимитов) КАК НастройкаПороговДляПроверкиЛимитовПредставление
		|ПОМЕСТИТЬ ДействующиеПороги
		|ИЗ
		|	РегистрСведений.ПорогиЛимитов.СрезПоследних(
		|			&Дата,
		|			Портфель = &Портфель
		|				И Лимит В (&Лимиты)) КАК ПорогиЛимитовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ДействующиеПороги.Период, ЭталонныеПороги.Период) КАК Период,
		|	ЭталонныеПороги.Лимит КАК Лимит,
		|	ЕСТЬNULL(ДействующиеПороги.НастройкаПороговДляПроверкиЛимитов, ЭталонныеПороги.НастройкаПороговДляПроверкиЛимитов) КАК НастройкаПороговДляПроверкиЛимитов,
		|	ЕСТЬNULL(ДействующиеПороги.Лимит, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО КАК ДействующийПорогОтсутствует
		|ПОМЕСТИТЬ НастройкиПорогов
		|ИЗ
		|	ЭталонныеПороги КАК ЭталонныеПороги
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДействующиеПороги КАК ДействующиеПороги
		|		ПО ЭталонныеПороги.Лимит = ДействующиеПороги.Лимит
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкиПорогов.Период КАК Период,
		|	НастройкиПорогов.Лимит КАК Лимит,
		|	НастройкиПорогов.Лимит.Наименование КАК ЛимитНаименование,
		|	НастройкиПорогов.НастройкаПороговДляПроверкиЛимитов КАК НастройкаПороговДляПроверкиЛимитов,
		|	НастройкиПорогов.ДействующийПорогОтсутствует КАК ДействующийПорогОтсутствует,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МинДоляЖелтаяЗона, 0) КАК ПредупреждениеМин,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МаксДоляЖелтаяЗона, 0) КАК ПредупреждениеМакс,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МинСуммаЖелтаяЗона, 0) КАК ПредупреждениеМинСумма,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МаксСуммаЖелтаяЗона, 0) КАК ПредупреждениеМаксСумма,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МинДоляКраснаяЗона, 0) КАК НарушениеМин,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МаксДоляКраснаяЗона, 0) КАК НарушениеМакс,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МинДоляКраснаяЗона, 0) КАК НарушениеМинСумма,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МаксДоляКраснаяЗона, 0) КАК НарушениеМаксСумма,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МинДоляПоручение, 0) КАК ПоручениеМин,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МаксДоляПоручение, 0) КАК ПоручениеМакс,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МинСуммаПоручение, 0) КАК ПоручениеМинСумма,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.МаксСуммаПоручение, 0) КАК ПоручениеМаксСумма,
		|	ЕСТЬNULL(НастройкиПороговДляПроверкиЛимитовСложныеПороги.Ссылка.ИспользоватьРасширеннуюУстановкуПорогов, ИСТИНА) КАК ИспользоватьРасширеннуюУстановкуПорогов
		|ИЗ
		|	НастройкиПорогов КАК НастройкиПорогов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиПороговДляПроверкиЛимитов.СложныеПороги КАК НастройкиПороговДляПроверкиЛимитовСложныеПороги
		|		ПО НастройкиПорогов.НастройкаПороговДляПроверкиЛимитов = НастройкиПороговДляПроверкиЛимитовСложныеПороги.Ссылка
		|			И (НастройкиПорогов.НастройкаПороговДляПроверкиЛимитов.ИспользоватьРасширеннуюУстановкуПорогов = ЛОЖЬ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	NULL,
		|	Лимиты.Ссылка,
		|	Лимиты.Наименование,
		|	NULL,
		|	ЛОЖЬ,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	ЛОЖЬ
		|ИЗ
		|	Справочник.Лимиты КАК Лимиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиПорогов КАК НастройкиПорогов
		|		ПО (НастройкиПорогов.Лимит = Лимиты.Ссылка)
		|ГДЕ
		|	Лимиты.Ссылка В(&Лимиты)
		|	И НастройкиПорогов.Лимит ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛимитНаименование";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Портфель", Портфель);
	Запрос.УстановитьПараметр("ЭталонныйПортфель", ЭталонныйПортфель);
	Запрос.УстановитьПараметр("Лимиты", Лимиты);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура УстановитьПризнакСтратегии_УстановкаЛимитов(УстановкаЛимитов, Стратегия)
	
	НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(УстановкаЛимитов);
	НаборЗаписей.Отбор.Свойство.Установить(Эталонный_портфель_лимитов);
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Объект = УстановкаЛимитов;
	НоваяЗапись.Свойство = Эталонный_портфель_лимитов;
	НоваяЗапись.Значение = Стратегия;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура УстановитьДатуРаспространенияПравил(Портфель, Дата_распространения_правил)
	
	НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Портфель);
	НаборЗаписей.Отбор.Свойство.Установить(Дата_распространения_правил);
	
	НоваяЗапись = НаборЗаписей.Добавить();
