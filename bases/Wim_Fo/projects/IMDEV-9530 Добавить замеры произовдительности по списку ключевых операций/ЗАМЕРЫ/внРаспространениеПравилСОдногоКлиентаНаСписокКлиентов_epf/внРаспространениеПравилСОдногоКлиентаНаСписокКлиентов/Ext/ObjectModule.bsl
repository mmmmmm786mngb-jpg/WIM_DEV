Функция ВыполняетсяПодСервиснымПользователем()
	
	Для каждого ТекСервПользователь Из СписокСервисныхПользователей Цикл
		Если ТекСервПользователь.Значение = ПараметрыСеанса.ТекущийПользователь Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция РассылкаСообщенияПоУстановкам(Знач НастройкаРассылки, Знач ТемаСообщения, Знач ТекстСообщения, Знач ЕстьОшибки, Знач ЕстьПредупреждения)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НастройкаРассылки.СписокАдресов.Найти(Истина, "ВключенВРассылку") = Неопределено
		И НастройкаРассылки.СписокПользователей.Найти(Истина, "ВключенВРассылку") = Неопределено Тогда
			Возврат "Не установлен список рассылки";
	КонецЕсли;
	
	ПочтаОтправки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаРассылки, "УчетнаяЗаписьЭлектроннойПочты");
	
	Если Не ЗначениеЗаполнено(ПочтаОтправки) Тогда
		ПочтаОтправки = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
	КонецЕсли;
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
	ПараметрыПисьма.Тема = ?(ЕстьОшибки, "{FAIL} ", ?(ЕстьПредупреждения, "{WARN} ", "{OK} ")) + ТемаСообщения + ПропискаРассылки("r306");
	ПараметрыПисьма.Важность = ?(ЕстьОшибки Или ЕстьПредупреждения, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
	
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;
	
	СписокАдресов = "";
	Если НастройкаРассылки.РежимРассылки = 0 Тогда
		Для Каждого СтрТЧ Из НастройкаРассылки.СписокАдресов Цикл
			Если СтрТЧ.ВключенВРассылку Тогда
				СписокАдресов = СписокАдресов + СтрТЧ.Адрес + ",";
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого СтрТЧ Из НастройкаРассылки.СписокПользователей Цикл
			Если СтрТЧ.ВключенВРассылку Тогда
				Адрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(СтрТЧ.Пользователь, Справочники.ВидыКонтактнойИнформации.EmailПользователя, ТекущаяДата());
				СписокАдресов = СписокАдресов + Адрес + ",";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыПисьма.Кому = СписокАдресов;
	ПараметрыПисьма.Тело = ТекстСообщения;
	
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(ПочтаОтправки, ПараметрыПисьма);
		текстРассылки = "Рассылка завершена";
	Исключение
		текстРассылки = ПараметрыПисьма.Тема + Символы.ПС + "Рассылка не удалась: " + Символы.ПС + ОписаниеОшибки();
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Для Каждого Элемент Из Сообщения Цикл
			текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
		КонецЦикла;
		ЗаписьЖурналаРегистрации(СведенияОВнешнейОбработке().Наименование, УровеньЖурналаРегистрации.Ошибка,,, текстРассылки);
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат текстРассылки;
	
КонецФункции

Процедура НайтиПортфелиБезУстановокЛимитов(ДатаНачала, ДатаОкончания, КлассЛимитов, ТекстСообщения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Портфели.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ т
		|ИЗ
		|	Справочник.Портфели КАК Портфели
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДействующиеЛимитыПоПортфелю.СрезПоследних(
		|				&ДатаОкончания,
		|				КлассЛимита = &КлассЛимита
		|					И Регистратор ССЫЛКА Документ.УстановкаЛимитов
		|					И Регистратор.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДействующиеЛимитыПоПортфелюСрезПоследних
		|		ПО (ДействующиеЛимитыПоПортфелюСрезПоследних.Портфель = Портфели.Ссылка)
		|ГДЕ
		|	ДействующиеЛимитыПоПортфелюСрезПоследних.Портфель ЕСТЬ NULL
		|	И Портфели.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВерсииОбъектов.Объект КАК Объект,
		|	ВЫРАЗИТЬ(ВерсииОбъектов.Объект КАК Справочник.Портфели).Наименование КАК Наименование,
		|	ВЫРАЗИТЬ(ВерсииОбъектов.Объект КАК Справочник.Портфели).НомерДоговора КАК НомерДоговора,
		|	ВЫРАЗИТЬ(ВерсииОбъектов.Объект КАК Справочник.Портфели).Учредитель.Наименование КАК УчредительНаименование
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|ГДЕ
		|	ВерсииОбъектов.Объект В
		|			(ВЫБРАТЬ
		|				т.Ссылка
		|			ИЗ
		|				т КАК т)
		|	И ВерсииОбъектов.НомерВерсии = 1
		|	И ВерсииОбъектов.ДатаВерсии МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерДоговора,
		|	Наименование";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("КлассЛимита", КлассЛимитов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДобавитьТекстСообщения(ТекстСообщения, "" + СокрЛП(Выборка.Наименование) + " - ДУ " + СокрЛП(Выборка.НомерДоговора) + " (" + СокрЛП(Выборка.УчредительНаименование) + ")" + Символы.ПС);
		ЕстьПредупреждения = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьТекстСообщения(ТекстСообщения, ДобавляемыйТекст)
	
	ТекстСообщения = ?(ЗначениеЗаполнено(ТекстСообщения), ТекстСообщения + Символы.ПС + ДобавляемыйТекст, ДобавляемыйТекст);
	
КонецПроцедуры

