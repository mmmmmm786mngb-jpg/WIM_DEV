&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	
	ПараметрыНастроек = Новый Структура;
	ПараметрыНастроек.Вставить("ДопОбработка", ДополнительнаяОбработка);
	ОткрытьФорму("ВнешняяОбработка.ЗагрузкаНеторговыхПорученийРОСТ.Форма.ФормаНастроек", ПараметрыНастроек, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДополнительнаяОбработка = ОбработкаОбъект.ДополнительнаяОбработкаСсылка();

КонецПроцедуры

&НаСервере
Функция СоздатьПорученияНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	
	//Установить настройки
	ПараметрыВыполнения = Новый Структура;
	ДопОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", Об.Метаданные().Имя);
	ПараметрыВыполнения.Вставить("ДополнительнаяОбработкаСсылка",ДопОбработкаСсылка);
	Об.УстановитьНастройки(ПараметрыВыполнения);
	
	ТабДок = Новый ТабличныйДокумент;
	ВажностьОшибки = 0;
	КоличествоЗаписей = Об.СоздатьПоручения(НачалоДня(ТекущаяДата()), ТабДок, ВажностьОшибки);
	
	Если ВажностьОшибки = 2 Тогда
		Сообщить("В процессе создания неторговых поручений произошли ошибки. Подробности см. в логе ошибок")
	КонецЕсли;
	
	
	Возврат ТабДок
	
КонецФункции

&НаКлиенте
Процедура СоздатьПоручения(Команда)
	
	РезультатОбработки = СоздатьПорученияНаСервере();

КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуДСБрокерНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	
	//Установить настройки
	ПараметрыВыполнения = Новый Структура;
	ДопОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", Об.Метаданные().Имя);
	ПараметрыВыполнения.Вставить("ДополнительнаяОбработкаСсылка",ДопОбработкаСсылка);
	Об.УстановитьНастройки(ПараметрыВыполнения);
	
	ТекстЛог = "";
	ВажностьОшибки = 0;
	СуммаНаБрокере = Об.ПолучитьСуммуДСБрокер(ТекстЛог, ВажностьОшибки);
	
	Если ВажностьОшибки = 2 Тогда
		Сообщить("В процессе создания неторговых поручений произошли ошибки. Подробности см. в логе ошибок")
	КонецЕсли;
	
	
	Возврат СуммаНаБрокере;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьСуммуДСБрокер(Команда)
	
	СуммаНаБрокере = ПолучитьСуммуДСБрокерНаСервере();
	Сообщить(" "+ТекущаяДата()+" Сумма на брокере: "+СуммаНаБрокере);
	
КонецПроцедуры
