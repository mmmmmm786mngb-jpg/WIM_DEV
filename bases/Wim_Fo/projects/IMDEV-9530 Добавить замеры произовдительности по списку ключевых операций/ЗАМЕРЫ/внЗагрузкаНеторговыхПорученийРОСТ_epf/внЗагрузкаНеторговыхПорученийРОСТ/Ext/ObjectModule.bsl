Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	// Реализация логики команды
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда Возврат; КонецЕсли;
	
	Лог.Очистить();
	
	ВажностьОшибки = 0;
	ТекстОшибки = "";
	
	Попытка 
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	Исключение
		ВажностьОшибки = 2;
		Лог.ДобавитьСтроку("Ошибка получения настроек отчета: " + ОписаниеОшибки());
	КонецПопытки;
	
	РасчетНаДату = НачалоДня(ТекущаяДатаСеанса());
	
	Если не КалендарьБиржи.Пустая() Тогда
		
		СледРабочийДень0 = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(КалендарьБиржи, РасчетНаДату, 0);
		Если РасчетНаДату <> НачалоДня(СледРабочийДень0) Тогда
			// не рабочий день.
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		
		ДанныеОтчета = Новый ТабличныйДокумент;
		КоличествоЗаписей = СоздатьПоручения(РасчетНаДату, ДанныеОтчета, ВажностьОшибки);
	
		РассылкаОтчета(ДанныеОтчета, КоличествоЗаписей, ВажностьОшибки);
	Исключение
		ВажностьОшибки = 2;
		Лог.ДобавитьСтроку("Ошибка рассылки отчета по почте: " + ОписаниеОшибки());
	КонецПопытки;

	ТекстЛога = Лог.ПолучитьТекст();
	Если ВажностьОшибки = 2 Тогда
		
		Описание = "Расчет произведен с ошибками: " + ТекстЛога; 
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			Описание
		);
	Иначе
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Информация,,,
			"Расчет произведен успешно!"
		);
	КонецЕсли;
	
КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды) Экспорт
		
	ДопОбработка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
	
	НастройкиВыполнения = Неопределено;
	ХранилищеНастроек = ДопОбработка.ХранилищеНастроек;
	
	Если ТипЗнч(ХранилищеНастроек) = Тип("ХранилищеЗначения") Тогда
		НастройкиВыполнения = ХранилищеНастроек.Получить();
	КонецЕсли;
	
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда  
		Возврат "<Настройки не установлены>"; 
	КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда  
		Возврат; 
	КонецЕсли;
 
	Настройки.Свойство("АдресWS", АдресWS);
	Настройки.Свойство("Логин", Логин);
	Настройки.Свойство("Пароль", Пароль);

	Настройки.Свойство("КалендарьБиржи", КалендарьБиржи);
	Настройки.Свойство("НеКонтролироватьДостаточностьДС", НеКонтролироватьДостаточностьДС);
	Настройки.Свойство("АдаптерFIX", АдаптерFIX);
	Настройки.Свойство("КодСчетаБрокер", КодСчетаБрокер);

	Настройки.Свойство("ДопРеквизитСтатусПортфеля", ДопРеквизитСтатусПортфеля);
	Настройки.Свойство("СтатусДляПоиска", СтатусДляПоиска);
	Настройки.Свойство("СтатусДСОтправленыБрокеру", СтатусДСОтправленыБрокеру);
