Функция ПолучитьСуммуКупоны(НаДату)
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("НаДату", НачалоДня(НаДату));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Актив КАК Актив,
	|	т.Актив.Объект КАК АктивОбъект,
	|	СУММА(т.Количество) КАК Количество
	|ПОМЕСТИТЬ втАктивы
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК т
	|ГДЕ
	|	т.Дата = &НаДату
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Актив,
	|	т.Актив.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Облигация КАК Облигация,
	|	т.Документ КАК Документ
	|ПОМЕСТИТЬ втКупоны
	|ИЗ
	|	РегистрСведений.КупонноеРасписаниеПоОблигациям.СрезПоследних(
	|			КОНЕЦПЕРИОДА(&НаДату, ДЕНЬ),
	|			Облигация В
	|				(ВЫБРАТЬ
	|					т.АктивОбъект
	|				ИЗ
	|					втАктивы КАК т)) КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втКупоны.Облигация КАК Облигация,
	|	втАктивы.Количество КАК Количество,
	|	ЕСТЬNULL(тКупоны.РазмерДоходаВРублях, 0) * ЕСТЬNULL(втАктивы.Количество, 0) КАК СуммаКупонов
	|ИЗ
	|	втКупоны КАК втКупоны
	|		ЛЕВОЕ СОЕДИНЕНИЕ втАктивы КАК втАктивы
	|		ПО втКупоны.Облигация = втАктивы.АктивОбъект
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КупонноеРасписание.Купоны КАК тКупоны
	|		ПО втКупоны.Документ = тКупоны.Ссылка
	|ГДЕ
	|	тКупоны.ДатаОкончанияКупонногоПериода = &НаДату
	|ИТОГИ
	|	СУММА(СуммаКупонов)
	|ПО
	|	ОБЩИЕ";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	СуммаКупоны = 0;
	Если Выборка.Следующий() Тогда
		СуммаКупоны = Выборка.СуммаКупонов;
	КонецЕсли;
	
	Возврат СуммаКупоны;
	
КонецФункции

Функция ПолучитьСуммуСделкиПродажи(НаДату)
	
	ПродажиНачПериод = НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(КалендарьБиржи, НаДату, -1));
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ПродажиНачПериод", ПродажиНачПериод);
	Запрос.УстановитьПараметр("ПродажиКонПериод", КонецДня(ПродажиНачПериод));
	Запрос.УстановитьПараметр("Направление", Перечисления.ВидыОперацийСделки.Продажа);
	Запрос.УстановитьПараметр("СтатусДСВыведены", СтатусДСВыведены);
	Запрос.УстановитьПараметр("СвСтатусПортфеля", ДопРеквизитСтатусПортфеля);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.СуммаРасчетов КАК СуммаСделки
	|ИЗ
	|	Документ.Сделка.РаспределениеПоПортфелям КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДСведения
	|		ПО т.Портфель = ДСведения.Объект
	|			И (ДСведения.Свойство = &СвСтатусПортфеля)
	|ГДЕ
	|	т.Ссылка.Дата МЕЖДУ &ПродажиНачПериод И &ПродажиКонПериод
	|	И т.Ссылка.Проведен
	|	и т.Ссылка.Направление = &Направление
	|	И ДСведения.Значение <> &СтатусДСВыведены
	|ИТОГИ
	|	СУММА(СуммаСделки)
	|ПО
	|	ОБЩИЕ";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	СуммаСделки = 0;
	Если Выборка.Следующий() Тогда
		СуммаСделки = Выборка.СуммаСделки;
	КонецЕсли;
	
	Возврат СуммаСделки;
	
КонецФункции 

Функция ПолучитьСуммуСделкиПодПокупки(НаДату) 
	
	списСтатусы = новый Массив;
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("НачПериод", НачалоДня(НаДату));
	Запрос.УстановитьПараметр("НаДату", КонецДня(НаДату));
	Запрос.УстановитьПараметр("Направление", Перечисления.ВидыОперацийСделки.Покупка);
	Запрос.УстановитьПараметр("СтатусыФормированиеПоручений", списСтатусы);
	Запрос.УстановитьПараметр("СвСтатусПортфеля", ДопРеквизитСтатусПортфеля);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Портфель КАК Портфель,
	|	т.СуммаПоручения КАК СуммаСделки
	|ИЗ
	|	Документ.Поручение КАК т
	|ГДЕ
	|	т.Дата >= &НачПериод
	|	И т.Дата <= &НаДату
	|	И т.Проведен
	|	И т.ВидОперацииНеторговогоПоручения = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНеторговыхПоручений.Ввод)
	|ИТОГИ
	|	СУММА(СуммаСделки)
	|ПО
	|	ОБЩИЕ";
	
	//"ВЫБРАТЬ
	//|	т.Портфель КАК Портфель,
	//|	т.СуммаПоручения КАК СуммаПоручения
	//|ПОМЕСТИТЬ втДС_ПодПокупки
	//|ИЗ
	//|	Документ.Поручение КАК т
	//|ГДЕ
	//|	т.Дата >= &НачПериод
	//|	И т.Дата <= &НаДату
	//|	И т.Проведен
	//|	И т.ВидОперацииНеторговогоПоручения = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНеторговыхПоручений.Ввод)
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	т.Портфель КАК Портфель,
	//|	т.СуммаОстаток КАК СуммаСделки
	//|ПОМЕСТИТЬ втПокупкаИсполнена
	//|ИЗ
	//|	РегистрНакопления.ПлановаяПозиция.Остатки(&НаДату, Актив.ВидАктива = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыАктивов.Валюты)) КАК т
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДСведения
	//|		ПО т.Портфель = ДСведения.Объект
	//|			И (ДСведения.Свойство = &СвСтатусПортфеля)
	//|ГДЕ
	//|	т.Сделка.Направление = &Направление
	//|	//И ДСведения.Значение В(&СтатусыФормированиеПоручений)
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	т1.Портфель КАК Портфель,
	//|	т1.СуммаПоручения + ЕСТЬNULL(т2.СуммаСделки, 0) КАК СуммаСделки
	//|ИЗ
	//|	втДС_ПодПокупки КАК т1
	//|		ЛЕВОЕ СОЕДИНЕНИЕ втПокупкаИсполнена КАК т2
	//|		ПО т1.Портфель = т2.Портфель
	//|ИТОГИ
	//|	СУММА(СуммаСделки)
	//|ПО
	//|	ОБЩИЕ";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	СуммаСделки = 0;
	Если Выборка.Следующий() Тогда
		СуммаСделки = Выборка.СуммаСделки;
	КонецЕсли;
	
	Возврат СуммаСделки;
	
КонецФункции 

Функция ПолучитьСуммуДСБрокер(ТекстЛог, ВажностьОшибки) Экспорт 
	
	Если ЭтоТест Тогда
		Возврат 12000000;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Позиция", Новый Соответствие);
	Результат.Вставить("Описание", "");
	Результат.Вставить("Источник", "");
	Результат.Вставить("Журнал", "");
	Результат.Вставить("Отказ", Ложь);    
	
	СуммаБрокер = 0;
	
	ПараметрыАдаптера = Адаптеры.ПараметрыАдаптера(АдаптерFIX);
	ЗаполнитьЗначенияСвойств(ПараметрыАдаптера, Справочники.Адаптеры.БезопасныеНастройки(АдаптерFIX));
	
	КодыКлиентов = Новый ТаблицаЗначений();
	КодыКлиентов.Колонки.Добавить("БрокерскийСчет", Новый ОписаниеТипов("СправочникСсылка.МестаХранения"));
	КодыКлиентов.Колонки.Добавить("PartyIDSource", Новый ОписаниеТипов("Строка"));
	КодыКлиентов.Колонки.Добавить("PartyID", Новый ОписаниеТипов("Строка"));
	КодыКлиентов.Колонки.Добавить("PartyRole", Новый ОписаниеТипов("Строка"));

	МенеджерыАдаптеров = Справочники.Адаптеры.Менеджеры();
	Менеджер = МенеджерыАдаптеров[ПараметрыАдаптера.Вид];

	Строка = КодыКлиентов.Добавить();
	Строка.PartyIDSource = "D";
	Строка.PartyID = КодСчетаБрокер;  //код клиента	UAT 9U056/9U0078	8U041/8U0046
	Строка.PartyRole = "3";

	Указания = Новый Структура("ПараметрыАдаптера, КодыКлиентов", ПараметрыАдаптера, КодыКлиентов);
	Позиция = Менеджер.Позиция(Указания, Результат);

	Если Позиция.Количество() = 0 Тогда
		Если Результат.Описание <> "" Тогда
			ЭтотОбъект.Лог.ДобавитьСтроку("Сообщения менеджера адаптера (позиция): "+Результат.Описание);
		КонецЕсли;
		
		ЭтотОбъект.Лог.ДобавитьСтроку(НСтр("ru = 'Данные не были получены.';en = 'No data received.'"));
		ВажностьОшибки = 2;
	КонецЕсли; 
	
	Для Каждого СтрокаВх Из Позиция Цикл
		Если СтрокаВх.type <> "money" Тогда
			Продолжить;
		КонецЕсли;
		
		КодКлиента = СтрокаВх.client_code;
		//Если ПустаяСтрока(КодКлиента) Тогда
		//	ДобавитьЗаписьЖурнала(НСтр("ru = 'Не удалось разобрать код клиента.'"));
		//	Продолжить;
		//КонецЕсли;

		СуммаБрокер = СуммаБрокер + СтрокаВх.curr_bal - СтрокаВх.locked; 
	КонецЦикла;
	
	Возврат СуммаБрокер;
КонецФункции

Функция ПроверитьОбновитьСтатусДСВыведены(РасчетНаДату, ТабДок, ВажностьОшибки) Экспорт
	
	КоличествоЗаписей = 0;
	
	Макет = ПолучитьМакет("МакетОтчета");
	ТекОбласть = Макет.ПолучитьОбласть("НовыйСтатусШапка");
	
	ТабДок.Вывести(ТекОбласть);
		
	ТекОбласть = Макет.ПолучитьОбласть("НовыйСтатусСтрока");
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101"));
	Запрос.УстановитьПараметр("СвСтатусПортфеля", ДопРеквизитСтатусПортфеля);
	Запрос.УстановитьПараметр("СвДатаСтатусаПортфеля", ДопРеквизитДатаОперации);
	Запрос.УстановитьПараметр("СтатусПоданыПорученияНаВывод", СтатусПоданоПоручениеНаВыводДС_СБрокера);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Объект КАК Портфель,
	|	т.Значение КАК ТекСтатус,
	|	isnull(т2.Значение, &ПустаяДата) КАК ДатаСтатуса
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК т2
	|		ПО т.Объект = т2.Объект
	|			И &СвДатаСтатусаПортфеля = т2.Свойство
	|ГДЕ
	|	т.Свойство = &СвСтатусПортфеля
	|	И т.Значение = &СтатусПоданыПорученияНаВывод
	|	И т.Объект ССЫЛКА Справочник.Портфели";
	
	ВыборкаПортфели = Запрос.Выполнить().Выбрать();
	
	ТекДата = ТекущаяДата();
	
	Пока ВыборкаПортфели.Следующий() Цикл
		
		Если (ТекДата - ВыборкаПортфели.ДатаСтатуса) > 30 * 60 Тогда
			
			КоличествоЗаписей = КоличествоЗаписей + 1;
			
			//прошло более 30 мин с подачи поручения на вывод, в новый статус переводим автоматически
			ОбновитьСтатусПоПортфелю(ВыборкаПортфели.Портфель, СтатусДСВыведены);

			ТекОбласть.Параметры.Номер  =  КоличествоЗаписей;   
			ТекОбласть.Параметры.Портфель = ВыборкаПортфели.Портфель; 
			ТекОбласть.Параметры.НовыйСтатус = СтатусДСВыведены; 
			
			ТабДок.Вывести(ТекОбласть);
		КонецЕсли;
		
	КонецЦикла;
	
	ТекОбласть = Макет.ПолучитьОбласть("НовыйСтатусПодвал");
	ТабДок.Вывести(ТекОбласть);
	
	Возврат КоличествоЗаписей
		
КонецФункции

Функция СоздатьПоручения(РасчетНаДату, ТабДок, ВажностьОшибки) Экспорт
	
	ТекстОшибки = ""; 
	
	ТабДокНовыйСтатус = новый ТабличныйДокумент;
	КолвоПортфелей = ПроверитьОбновитьСтатусДСВыведены(РасчетНаДату, ТабДокНовыйСтатус, ВажностьОшибки);
	
	Если КолвоПортфелей > 0 Тогда
		ТабДок.Вывести(ТабДокНовыйСтатус);
	КонецЕсли;
	
	СуммаНаБрокере = ПолучитьСуммуДСБрокер(ТекстОшибки, ВажностьОшибки);
	СуммаПогашенногоКупона = ПолучитьСуммуКупоны(РасчетНаДату);
	СуммаСделкиПродажи = ПолучитьСуммуСделкиПродажи(РасчетНаДату);
	СуммаСделкиПодПокупки = ПолучитьСуммуСделкиПодПокупки(РасчетНаДату);
	СвободныйОстаток = СуммаНаБрокере - СуммаСделкиПродажи - СуммаСделкиПодПокупки;
		
	КоличествоЗаписей = 0;
	
	ПорученияНаОтправку = Новый Массив();
	
	Макет = ПолучитьМакет("МакетОтчета");
	ТекОбласть = Макет.ПолучитьОбласть("Шапка");
	ТекОбласть.Параметры.СуммаНаБрокере = СуммаНаБрокере;
	ТекОбласть.Параметры.СуммаСделкиПродажи = СуммаСделкиПродажи;
	ТекОбласть.Параметры.СуммаСделкиПодПокупки = СуммаСделкиПодПокупки;
	ТекОбласть.Параметры.СвободныйОстаток = СвободныйОстаток; 
	
	ТабДок.Вывести(ТекОбласть);
		
	ТекОбласть = Макет.ПолучитьОбласть("СтрокаТаблицы");	
	
	Попытка
		ТаблицаПортфелей = ПолучитьПортфелиДляСозданияПоручений();
	Исключение
		ВажностьОшибки = 2;
		ЭтотОбъект.Лог.ДобавитьСтроку("Возникла ошибка при формировании таблицы портфелей. Список портфелей не сформирован.");
		Возврат КоличествоЗаписей;
	КонецПопытки;
	
	Если ТаблицаПортфелей = Неопределено Тогда
		ВажностьОшибки = 1;
		ЭтотОбъект.Лог.ДобавитьСтроку("Не найдено портфелей для создания поручений.");
		Возврат КоличествоЗаписей
	КонецЕсли;
	
	СуммаИтогоСформированно = 0; 
	СуммаОжидаетПоступленияНаБрокСчет  =  0;
	
	флСервисОтказ = Ложь;
	тхтСервисОтказ = "";
	Сервис1СДО = СервисИнит(флСервисОтказ, тхтСервисОтказ);
	
	Если флСервисОтказ Тогда
		ВажностьОшибки = 2;
		ЭтотОбъект.Лог.ДобавитьСтроку(тхтСервисОтказ);
		Возврат КоличествоЗаписей;
	КонецЕсли;
	
	НПП = 0;
	
	Для Каждого ТекСтр Из ТаблицаПортфелей Цикл
		
		флСервисОтказ = Ложь;
		тхтСервисОтказ = "";
		СтруктураПортфель = ПолучитьСуммуПортфеля(Сервис1СДО, ТекСтр.НомерДоговора, флСервисОтказ, тхтСервисОтказ);
		
		Если флСервисОтказ Тогда 
			ВажностьОшибки = 2;
			ЭтотОбъект.Лог.ДобавитьСтроку("Портфель: " + ТекСтр.Портфель + тхтСервисОтказ);
			Продолжить;
		КонецЕсли;
				
		Если СтруктураПортфель.Сумма > 0 Тогда 
			
			Если не СтруктураПортфель.НаБрокере Тогда
				
				НПП = НПП + 1; 
				ТекОбласть.Параметры.Номер  =  НПП;   
				ТекОбласть.Параметры.Портфель = ТекСтр.Портфель; 
				ТекОбласть.Параметры.Сумма = СтруктураПортфель.Сумма;
				ТекОбласть.Параметры.Поручение = "Поручение не сформировано, ДС поступили на ЕРС, на брокерский счет не отправлены"; 
				
				Если ВажностьОшибки < 1 Тогда
					ВажностьОшибки = 1;
				КонецЕсли;
				
				ТабДок.Вывести(ТекОбласть);
				
			Иначе
				
				Если СтруктураПортфель.Сумма <= СвободныйОстаток или НеКонтролироватьДостаточностьДС Тогда
			
					Если ЗначениеЗаполнено(ТекСтр.СсылкаНаПоручение) Тогда
						//|	МАКСИМУМ(Поручение.Ссылка) КАК СсылкаНаПоручение,
						//|	СУММА(Поручение.СуммаПоручения) КАК СуммаПоручения
						НПП = НПП + 1; 
						ТекОбласть.Параметры.Номер  =  НПП;   
						ТекОбласть.Параметры.Портфель = ТекСтр.Портфель; 
						ТекОбласть.Параметры.Сумма = СтруктураПортфель.Сумма;
						ТекОбласть.Параметры.Поручение = СтрШаблон("Для портфеля уже есть поручение: %1 на сумма %2", ТекСтр.СсылкаНаПоручение, ТекСтр.СуммаПоручения); 
						
						Если ВажностьОшибки < 1 Тогда
							ВажностьОшибки = 1;
						КонецЕсли;
						
						ТабДок.Вывести(ТекОбласть);
					Иначе
						СуммаОжидаетПоступленияНаБрокСчет = СуммаОжидаетПоступленияНаБрокСчет + СтруктураПортфель.Сумма;
					
						НачатьТранзакцию();  //2 действия в транзакции - создание поручения и обновление данных доп сведений
						
						Попытка 
							
							Поручение = ЗаписатьПоручение(ТекСтр.Портфель, СтруктураПортфель.Сумма);
							ЗаписатьСЧА(ТекСтр.Портфель, СтруктураПортфель.Сумма);
							ОбновитьСтатусПоПортфелю(ТекСтр.Портфель, СтатусДляПеревода);
							
							УстановитьПризнакДатаПересчетаРСА(ТекСтр.Портфель);
							УстановитьПризнакПозицияВыгружена(ТекСтр.Портфель);
											
							ЗафиксироватьТранзакцию();
							
						Исключение
							ОтменитьТранзакцию();
							ВажностьОшибки = 2;
							ЭтотОбъект.Лог.ДобавитьСтроку("Портфель: " +ТекСтр.Портфель+" Ошибка: "+ ОписаниеОшибки());
							Продолжить
						КонецПопытки;
						
						//Заполнить Табдок при удачном 
						КоличествоЗаписей = КоличествоЗаписей + 1;
						
				
						НПП = НПП + 1; 
						ТекОбласть.Параметры.Номер  =  НПП;   
						ТекОбласть.Параметры.Портфель = ТекСтр.Портфель; 
						ТекОбласть.Параметры.Сумма = СтруктураПортфель.Сумма;
						ТекОбласть.Параметры.Поручение = Поручение; 
						
						СуммаИтогоСформированно = СуммаИтогоСформированно + СтруктураПортфель.Сумма;
						СвободныйОстаток = СвободныйОстаток - СтруктураПортфель.Сумма;
						
						ТабДок.Вывести(ТекОбласть);
						
						ПорученияНаОтправку.Добавить(Поручение);
						
					КонецЕсли;
					
				Иначе
					
					Если ТекСтр.СтатусПортфеля <> СтатусДСОтправленыБрокеру Тогда
						ОбновитьСтатусПоПортфелю(ТекСтр.Портфель, СтатусДСОтправленыБрокеру);
					КонецЕсли;
					
					СуммаОжидаетПоступленияНаБрокСчет = СуммаОжидаетПоступленияНаБрокСчет + СтруктураПортфель.Сумма;
				
				
					НПП = НПП + 1; 
					ТекОбласть.Параметры.Номер  =  НПП;   
					ТекОбласть.Параметры.Портфель = ТекСтр.Портфель; 
					ТекОбласть.Параметры.Сумма = СтруктураПортфель.Сумма;
					ТекОбласть.Параметры.Поручение = "Поручение не сформировано, недостаточно средств на счете: " + КодСчетаБрокер; 
					
					Если ВажностьОшибки < 1 Тогда
						ВажностьОшибки = 1;
					КонецЕсли;
					
					ТабДок.Вывести(ТекОбласть);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекОбласть = Макет.ПолучитьОбласть("Подвал");
	ТекОбласть.Параметры.СуммаИтогоОсталось = СуммаОжидаетПоступленияНаБрокСчет - СуммаИтогоСформированно;
	ТекОбласть.Параметры.СуммаИтогоСформированно = СуммаИтогоСформированно; 
	ТекОбласть.Параметры.СуммаОжидаетПоступленияНаБрокСчет  =  СуммаОжидаетПоступленияНаБрокСчет;   
	ТабДок.Вывести(ТекОбласть);
	
	Возврат КоличествоЗаписей
		
КонецФункции

Функция ПолучитьПортфелиДляСозданияПоручений()
	
	списСтатусыДляПроверки = Новый Массив;
	списСтатусыДляПроверки.Добавить(СтатусДляПоиска);
	списСтатусыДляПроверки.Добавить(СтатусДСОтправленыБрокеру);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеСведения.Объект КАК Портфель,
		|	ДополнительныеСведения.Значение КАК СтатусПортфеля,
		|	ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Справочник.Портфели).НомерДоговора КАК НомерДоговора,
		|	ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Справочник.Портфели).КодПортфеля КАК КодПортфеля
		|ПОМЕСТИТЬ ВТ_Портфели
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Свойство = &Свойство
		|	И ДополнительныеСведения.Значение В(&Значение)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Портфели.Портфель КАК Портфель,
		|	ВТ_Портфели.СтатусПортфеля КАК СтатусПортфеля,
		|	ВТ_Портфели.НомерДоговора КАК НомерДоговора,
		|	ВТ_Портфели.КодПортфеля КАК КодПортфеля,
		|	МАКСИМУМ(Поручение.Ссылка) КАК СсылкаНаПоручение,
		|	СУММА(Поручение.СуммаПоручения) КАК СуммаПоручения
		|ИЗ
		|	ВТ_Портфели КАК ВТ_Портфели
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Поручение КАК Поручение
		|		ПО ВТ_Портфели.Портфель = Поручение.Портфель
		|			И (Поручение.Проведен)
		|			И (Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.НеторговоеПоручение))
		|			И (Поручение.ВидОперацииНеторговогоПоручения = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНеторговыхПоручений.Ввод))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Портфели.Портфель,
		|	ВТ_Портфели.СтатусПортфеля,
		|	ВТ_Портфели.НомерДоговора,
		|	ВТ_Портфели.КодПортфеля";
	//ДокументПоручение.ВидОперации = Перечисления.ВидыПоручений.НеторговоеПоручение;
	//ДокументПоручение.ВидОперацииНеторговогоПоручения = Перечисления.ВидыОперацийНеторговыхПоручений.Ввод;
	
	Запрос.УстановитьПараметр("Значение", списСтатусыДляПроверки);
	Запрос.УстановитьПараметр("Свойство", ДопРеквизитСтатусПортфеля);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено
	Иначе
		Возврат РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
	
КонецФункции

Функция СписокСубпортфелейБрокерПоПортфелю(Портфель) Экспорт

	Запрос = Новый Запрос(
