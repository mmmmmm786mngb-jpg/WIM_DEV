//КОМАНДЫ ФОРМЫ/////////////////////////////////////////////////

&НаКлиенте
Процедура ЗапроскСервису(Команда)
	
	Отказ = Ложь;
	ЗапросКСервисуНаСервере(Отказ);
	
	Если Отказ Тогда
		Сообщить("Во время загрузки произошли ошибки", СтатусСообщения.Важное);
	Иначе
		Сообщить("Чтение успешно завершено", СтатусСообщения.Информация);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗапросКСервисуНаСервере(Отказ)
	
	Объект.СписокЗагрузки.Очистить();
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.ЗагрузитьОбъекты();
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	ЗагрузитьНаСервере();
	
	Объект.Лог.ОтображатьГруппировки = Ложь;
	Объект.Лог.ОтображатьСетку 		= Ложь;
	Объект.Лог.ОтображатьЗаголовки 	= Ложь;
	Объект.Лог.Защита				= Истина;
//	Объект.Лог.Показать();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
    ТекОбъект.СоздатьОбъекты();
	ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗаПериодПоДнямНаСервере()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Нач = Объект.ДатаНачала;
	Кон = Объект.ДатаОкончания;
	Тек = Нач;
	
	Пока Тек <= Кон Цикл
		
		ТекОбъект.СписокЗагрузки.Очистить();
		ТекОбъект.ДатаНачала = Тек;
		ТекОбъект.ДатаОкончания = Тек;
		
		ТекОбъект.ЗагрузитьОбъекты();
	    ТекОбъект.СоздатьОбъекты();
		
		Тек = Тек + 24*3600;
	КонецЦикла;
	Объект.ДатаНачала = Нач;
	Объект.ДатаОкончания = Кон;
	ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗаПериодПоДням(Команда)
	ЗагрузитьЗаПериодПоДнямНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	
	ПараметрыНастроек = Новый Структура;
	ПараметрыНастроек.Вставить("ДопОбработка", ДополнительнаяОбработка);
	ОткрытьФорму("ВнешняяОбработка.внЗагрузкаКотировок.Форма.ФормаНастроек", ПараметрыНастроек, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДополнительнаяОбработка = ОбработкаОбъект.ДополнительнаяОбработкаСсылка();
	
КонецПроцедуры



