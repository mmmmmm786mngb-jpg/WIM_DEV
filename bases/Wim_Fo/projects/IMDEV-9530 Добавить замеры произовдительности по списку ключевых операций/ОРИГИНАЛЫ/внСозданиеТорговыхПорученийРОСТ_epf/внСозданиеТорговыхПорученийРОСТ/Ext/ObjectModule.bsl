	|	</head>
	|	<body style=""font-family:Arial, Helvetica, sans-serif;color:black;"">
	|		" + СформироватьСтрокуПисьма(ТекстПисьма) + "
	|	</body>
	|</html>";
		
	Возврат ТелоПисьма;
	
КонецФункции // СформироватьТелоПисьма()

// Сохраняет ТабличныйДокумент или ПакетОтображаемыхДокументов в файл на диске
//
// Параметры:
//  ТабличныйДокумент  	- ТабличныйДокумент или ПакетОтображаемыхДокументов - документ для сохранения
//  ТипФайла  			- Строка - тип файла (xlsx, pdf и т.д.)
//  ПутьКФайлу			- Строка - Полный путь к файлу на диске или пустая строка для временного файла
//	ТекстОшибки			- Строка - Для сохранения текста ошибки
//
// Возвращаемое значение:
//	Строка - Путь к Файлу на диске, в случае успешной записи или
//  Неопределено - в случае ошибки
//
Функция СохранитьТабличныйДокументВФайл(Знач ТабличныйДокумент, Знач ПутьКФайлу, Знач ТипФайла="xlsx", ТекстОшибки="")
	
	Попытка
		Если ТипЗнч(ТабличныйДокумент)=Тип("ТабличныйДокумент") Тогда 
			ТипТабДокумента = ТипФайлаТабличногоДокумента[ТипФайла];
		ИначеЕсли ТипЗнч(ТабличныйДокумент)=Тип("ПакетОтображаемыхДокументов") Тогда
			ТипТабДокумента =  ТипФайлаПакетаОтображаемыхДокументов[ТипФайла];
		Иначе
			ТекстОшибки = СтрШаблон("Тип документа ""%2"" не поддерживается для сохранения в %1 (%3)", ТипЗнч(ТабличныйДокумент), ВРег(ТипФайла), ПутьКФайлу);
			Возврат Ложь;
		КонецЕсли;
	Исключение
		ТекстОшибки = СтрШаблон("Тип файла %1 не применим для сохранения типа документа ""%2"" (%3)", ВРег(ТипФайла), ТипЗнч(ТабличныйДокумент), ПутьКФайлу);
		Возврат Ложь;		
	КонецПопытки;

	Попытка
		ТабличныйДокумент.Записать(ПутьКФайлу, ТипТабДокумента);
	Исключение
		ТекстОшибки = "Произошла ошибка при сохранении файла: " + ОписаниеОшибки();		
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Помещает файл во временное хранилище
//
// Возрвщаемое значение:
//	 Строка - Адрес во временном хранилище
//
Функция ПоместитьФайлВоВременноеХранилище(Знач ПутьКФайлу, ТекстОшибки="")
	
	Попытка	
		ДвоичныеДанные 	= Новый ДвоичныеДанные(ПутьКФайлу);
		АдресВХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	Исключение
		ТекстОшибки = "Произошла ошибка при помещении файла во временное хранилище: " + ОписаниеОшибки();		
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат АдресВХранилище;
	
КонецФункции

// Записывает табличный документ или пакет в файл с указанным типом на диск и во временное хранилище
// Возрвщаемое значение - Структура: АдресВХранилище, ПутьКФайлу
Функция ПоместитьТабДокВоВременноеХранилище(Знач ТабличныйДокумент, ТипФайла="xlsx", ТекстОшибки="")
	
	АдресВХранилище = Неопределено;
	
	Попытка
		ПутьКФайлу = ПолучитьИмяВременногоФайла(ТипФайла);
	Исключение
		ТекстОшибки = "Ошибка при получении имени временного файла: " + ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;
	
	Если СохранитьТабличныйДокументВФайл(ТабличныйДокумент, ПутьКФайлу, ТипФайла, ТекстОшибки) Тогда
		АдресВХранилище = ПоместитьФайлВоВременноеХранилище(ПутьКФайлу, ТекстОшибки);
	КонецЕсли;
	
	Попытка
		УдалитьФайлы(ПутьКФайлу);
	Исключение
	КонецПопытки;	
	
	Возврат АдресВХранилище;

КонецФункции // ПоместитьТабДокВоВременноеХранилище()

Процедура УдалитьВременныеФайлы(Знач МассивФайлов)
	Перем Файл;
	
	Для Каждого ТекФайл Из МассивФайлов Цикл
		Попытка
			Если ЗначениеЗаполнено(ТекФайл) Тогда
				Файл = Новый Файл(ТекФайл);
				Если Файл.Существует() Тогда
					УдалитьФайлы(ТекФайл);
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры // УдалитьВременныеФайлы()

Функция ПрефиксПисьма(Знач ВажностьОшибки)
	Перем ПрефиксПисьма;
	
	Если ВажностьОшибки = 1 Тогда
		ПрефиксПисьма = "{WARN}";
		
	ИначеЕсли ВажностьОшибки = 2 Тогда
		ПрефиксПисьма = "{FAIL}";
		
	Иначе
		ПрефиксПисьма = "{OK}";
	КонецЕсли;
	
	Возврат ПрефиксПисьма;
КонецФункции // ПрефиксПисьма()

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

Функция СтрКолонкаЛев(СтрокаЗнч, ДлинаЗнч)
	
	СтрокаПробел = "";
	сч = СтрДлина(СтрокаЗнч);
	Пока сч < ДлинаЗнч Цикл
		СтрокаПробел = СтрокаПробел + " ";
		сч = сч + 1;
	КонецЦикла;
	
	Возврат СтрокаЗнч + СтрокаПробел;
КонецФункции

Функция СтрКолонкаПрав(СтрокаЗнч, ДлинаЗнч)
	
	СтрокаПробел = "";
	сч = СтрДлина(СтрокаЗнч);
	Пока сч < ДлинаЗнч Цикл
		СтрокаПробел = СтрокаПробел + " ";
		сч = сч + 1;
	КонецЦикла;
	
	Возврат СтрокаПробел + СтрокаЗнч;
КонецФункции

