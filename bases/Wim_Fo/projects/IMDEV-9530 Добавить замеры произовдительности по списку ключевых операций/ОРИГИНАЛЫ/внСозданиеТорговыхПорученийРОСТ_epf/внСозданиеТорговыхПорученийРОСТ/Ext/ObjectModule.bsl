Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Лог.Очистить();
	
	ВажностьОшибки = 0;
	ТекстОшибки = "";  
	
	КоличествоПоручений = 0;
	
	Попытка 
		ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	Исключение
		ВажностьОшибки = 2;
		ТекстОшибки = ТекстОшибки + Символы.ПС + "Ошибка получения настроек отчета: " + ОписаниеОшибки();
		Лог.ДобавитьСтроку("[err] Ошибка получения настроек отчета: " + ОписаниеОшибки());
	КонецПопытки;
	
	// Реализация логики команды
	Если ИдентификаторКоманды = "ФоновоеВыполнениеПокупка" Тогда 
		
		Если не ВыключитьПокупки Тогда
			ОбновитьСписокПортфелейПокупка(ТекстОшибки, ВажностьОшибки);
			СоздатьОтправитьПорученияПокупка(КоличествоПоручений, ТекстОшибки, ВажностьОшибки);
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "ФоновоеВыполнениеПродажа" Тогда
		
		Если не ВыключитьПродажи Тогда
			ЗаполнитьСписокПродажаАктивов(Истина, ТекстОшибки, ВажностьОшибки);
			СоздатьПорученияПродажа(КоличествоПоручений, ТекстОшибки, ВажностьОшибки);
		КонецЕсли;
		
	Иначе
		Возврат; 
	КонецЕсли;
	
		
	Попытка	
		РассылкаОтчета(КоличествоПоручений, ТекстОшибки, ВажностьОшибки);
	Исключение
		ВажностьОшибки = 2;
		Лог.ДобавитьСтроку("[err] Ошибка рассылки отчета по почте: " + ОписаниеОшибки());
	КонецПопытки;

	Префикс = ПрефиксПисьма(ВажностьОшибки);
	ТекстЛога = Лог.ПолучитьТекст();
	Если ВажностьОшибки = 2 Тогда
		
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки
		);    
		
	КонецЕсли;
	

	
КонецПроцедуры

Функция УстановитьНастройки(ПараметрыВыполненияКоманды) Экспорт
	
	ДопОбработка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
	
	НастройкиВыполнения = Неопределено;
	ХранилищеНастроек = ДопОбработка.ХранилищеНастроек;
	
	Если ТипЗнч(ХранилищеНастроек) = Тип("ХранилищеЗначения") Тогда
		НастройкиВыполнения = ХранилищеНастроек.Получить();
	КонецЕсли;
	
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда  
		Возврат "<Настройки не установлены>"; 
	КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
	
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда  
		Возврат; 
	КонецЕсли;
	
	Настройки.Свойство("ДопРеквизитСтатусПортфеля", ДопРеквизитСтатусПортфеля);
	Настройки.Свойство("СтатусДляПоиска", СтатусДляПоиска);
	Настройки.Свойство("СтатусДляПеревода", СтатусДляПеревода);
	Настройки.Свойство("СтатусОкончаниеОбработки", СтатусОкончаниеОбработки);
	Настройки.Свойство("ДопРеквизитДатаОперации", ДопРеквизитДатаОперации);
	Настройки.Свойство("АктивРубли", АктивРубли);
	
	Настройки.Свойство("СтатусРасторжениеИнициировано", СтатусРасторжениеИнициировано);
	Настройки.Свойство("СтатусОрдераНаПродажуСформированы", СтатусОрдераНаПродажуСформированы);
	Настройки.Свойство("СтатусОрдераНаПродажуОтправлены", СтатусОрдераНаПродажуОтправлены);
	Настройки.Свойство("СтатусОрдераНаПродажуИсполнены", СтатусОрдераНаПродажуИсполнены);
	Настройки.Свойство("СтатусПорученияНаВыводПоданы", СтатусПорученияНаВыводПоданы);
	Настройки.Свойство("СтатусПорученияНаВыводИсполнены", СтатусПорученияНаВыводИсполнены);
	Настройки.Свойство("СтатусОрдераНаРеИнвСформированы", СтатусОрдераНаРеИнвСформированы);
	
	Настройки.Свойство("АвторЗаявок", АвторЗаявок);
	
	Настройки.Свойство("АктивВимЛиквидность", АктивВимЛиквидность);
	Настройки.Свойство("ПроцентКомиссияБрокер", ПроцентКомиссияБрокер);
	
	Настройки.Свойство("КонтрольПоЦенеЗакрытия", КонтрольПоЦенеЗакрытия);	
	Настройки.Свойство("ВыключитьПокупки", ВыключитьПокупки);	
	Настройки.Свойство("ВыключитьПродажи", ВыключитьПродажи);	
	
	Настройки.Свойство("АдресWS", АдресWS);
	Настройки.Свойство("ЛогинWS", ЛогинWS);
	Настройки.Свойство("ПарольWS", ПарольWS);
	
	Почта = Неопределено;
	Если Настройки.Свойство("ПочтовыйЛогин", ПочтовыйЛогин) Тогда 
		Ящики = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.СписокРассылки);
		СписокРассылки.Загрузить(Ящики.Получить());
	КонецЕсли;
	
	Если Настройки.Свойство("НастройкаСтратегий") Тогда
		спНастройкиСтратегии = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.НастройкаСтратегий);
		НастройкаСтратегий.Загрузить(спНастройкиСтратегии.Получить());
	КонецЕсли;
	
	//ПредставлениеНастроек = "Период с:"+Формат(ДатаНачала,"ДФ=dd.MM.yyyy") + " по:"+Формат(ДатаОкончания,"ДФ=dd.MM.yyyy") + " ";
	ПредставлениеНастроек = "Представление настроек";
	
КонецПроцедуры

