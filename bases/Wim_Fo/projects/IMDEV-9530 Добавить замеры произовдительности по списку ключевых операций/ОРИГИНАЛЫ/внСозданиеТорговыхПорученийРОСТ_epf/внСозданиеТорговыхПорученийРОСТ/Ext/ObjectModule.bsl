Функция УстановитьПараметры(ЗаголовокНастроек) Экспорт
	
	Значения = Новый Структура();      
	Значения.Вставить("ПочтовыйЛогин", ЭтотОбъект.ПочтовыйЛогин);
	
	Значения.Вставить("ДопРеквизитСтатусПортфеля", ЭтотОбъект.ДопРеквизитСтатусПортфеля);
	Значения.Вставить("СтатусДляПоиска", ЭтотОбъект.СтатусДляПоиска);
	Значения.Вставить("СтатусДляПеревода", ЭтотОбъект.СтатусДляПеревода);
	Значения.Вставить("СтатусОкончаниеОбработки", ЭтотОбъект.СтатусОкончаниеОбработки);
	Значения.Вставить("ДопРеквизитДатаОперации",ЭтотОбъект.ДопРеквизитДатаОперации);
	Значения.Вставить("АктивРубли",ЭтотОбъект.АктивРубли);
	
	Значения.Вставить("СтатусРасторжениеИнициировано", ЭтотОбъект.СтатусРасторжениеИнициировано);
	Значения.Вставить("СтатусОрдераНаПродажуСформированы", ЭтотОбъект.СтатусОрдераНаПродажуСформированы);
	Значения.Вставить("СтатусОрдераНаПродажуОтправлены", ЭтотОбъект.СтатусОрдераНаПродажуОтправлены);
	Значения.Вставить("СтатусОрдераНаПродажуИсполнены", ЭтотОбъект.СтатусОрдераНаПродажуИсполнены);
	Значения.Вставить("СтатусПорученияНаВыводПоданы", ЭтотОбъект.СтатусПорученияНаВыводПоданы);
	Значения.Вставить("СтатусПорученияНаВыводИсполнены", ЭтотОбъект.СтатусПорученияНаВыводИсполнены);
	Значения.Вставить("СтатусОрдераНаРеИнвСформированы", ЭтотОбъект.СтатусОрдераНаРеИнвСформированы);
	
	Значения.Вставить("АвторЗаявок", ЭтотОбъект.АвторЗаявок);
	
	Значения.Вставить("АктивВимЛиквидность", ЭтотОбъект.АктивВимЛиквидность);
	Значения.Вставить("ПроцентКомиссияБрокер",ЭтотОбъект.ПроцентКомиссияБрокер);
	
	Значения.Вставить("КонтрольПоЦенеЗакрытия",ЭтотОбъект.КонтрольПоЦенеЗакрытия);
	Значения.Вставить("ВыключитьПокупки",ЭтотОбъект.ВыключитьПокупки);
	Значения.Вставить("ВыключитьПродажи",ЭтотОбъект.ВыключитьПродажи);
	
	Значения.Вставить("АдресWS", ЭтотОбъект.АдресWS);
	Значения.Вставить("ЛогинWS", ЭтотОбъект.ЛогинWS);
	Значения.Вставить("ПарольWS", ЭтотОбъект.ПарольWS);
	
	Значения.Вставить("СписокРассылки", XMLСтрока(Новый ХранилищеЗначения(ЭтотОбъект.СписокРассылки.Выгрузить())));
	Значения.Вставить("НастройкаСтратегий", XMLСтрока(Новый ХранилищеЗначения(ЭтотОбъект.НастройкаСтратегий.Выгрузить())));
	
	ПредставлениеПочты = ?(ЭтотОбъект.СписокРассылки.Количество()>0, ", Установлен список рассылки","");
	
	ЗаголовокНастроек = СокрЛП(ПредставлениеПочты);
	
	Возврат Значения;
	
КонецФункции

