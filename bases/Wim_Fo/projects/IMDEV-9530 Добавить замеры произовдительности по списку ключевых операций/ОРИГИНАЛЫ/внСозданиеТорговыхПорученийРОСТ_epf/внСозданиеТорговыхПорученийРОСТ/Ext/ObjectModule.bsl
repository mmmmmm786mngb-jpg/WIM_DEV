Процедура ЗагрузитьНастройки(ПараметрыРегистрации) Экспорт
	
	ВерсияПрименения = "1.00";
	ТекущаяРегистрация = СведенияОВнешнейОбработке();
	
	Если ВерсияПрименения = ТекущаяРегистрация.Версия Тогда
		
		ПараметрыРегистрации.Вставить("ЗагружатьНастройки", Истина);
		
		НастройкиПоУмолчанию(ЭтотОбъект);
		
		ЗаголовокНастроек = "";
		ЗначенияПараметров = УстановитьПараметры(ЗаголовокНастроек);
		
		ПараметрыРегистрации.Вставить("Настройки", Новый Структура("Значения, ЗаголовокНастроек", ЗначенияПараметров, ЗаголовокНастроек));
		
	КонецЕсли;
	
