Функция ПолучитьБиржуПоКодуКРИМС(вхКодКримс)
	
	Ответ = Справочники.Биржи.ПустаяСсылка();
	
	Если СокрЛП(вхКодКримс) = "" Тогда
		Возврат Ответ;
	КонецЕсли;
	
	Если КэшКодыБиржКримс = Неопределено Тогда
		КэшКодыБиржКримс = новый Соответствие;
		
		Макет = ПолучитьМакет("СоотвКодыБирж");
		НомТекСтроки = 1;
		флЧитать = Истина;
		тз = новый ТаблицаЗначений;
		тз.Колонки.Добавить("КодБлум", ОбщегоНазначения.ОписаниеТипаСтрока(15));
		тз.Колонки.Добавить("КодКРИМС", ОбщегоНазначения.ОписаниеТипаСтрока(15));
		Пока флЧитать Цикл
			НомТекСтроки = НомТекСтроки+1;
			
			стрКодБлум = СокрЛП(Макет.Область(НомТекСтроки, 1).Текст);
			стрКодКРИМС = СокрЛП(Макет.Область(НомТекСтроки, 2).Текст);
			
			Если стрКодБлум = "" Тогда
				флЧитать = ложь;
				Продолжить;
			КонецЕсли;
			
			нов = тз.Добавить();
			нов.КодБлум = стрКодБлум;
			нов.КодКРИМС = стрКодКРИМС;
			
		КонецЦикла;
		
		Запрос = новый Запрос;
		Запрос.УстановитьПараметр("тз", тз);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	т.КодБлум,
		|	т.КодКРИМС
		|ПОМЕСТИТЬ втКоды
		|ИЗ
		|	&тз КАК т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(т.Ссылка, ЗНАЧЕНИЕ(Справочник.Биржи.ПустаяСсылка)) КАК Биржа,
		|	втКоды.КодКРИМС
		|ИЗ
		|	втКоды КАК втКоды
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Биржи КАК т
		|		ПО втКоды.КодБлум = т.КодBloomberg
		|ГДЕ
		|	НЕ т.ПометкаУдаления";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			КэшКодыБиржКримс.Вставить(Выборка.КодКРИМС, Выборка.Биржа);
		КонецЦикла;
		сММВБ = Справочники.Биржи.НайтиПоКоду("ММВБ");
		КэшКодыБиржКримс.Вставить("MIC",  сММВБ);
		КэшКодыБиржКримс.Вставить("MIC1", сММВБ);
		КэшКодыБиржКримс.Вставить("MIC2", сММВБ);
		КэшКодыБиржКримс.Вставить("MICM", сММВБ);
		
	КонецЕсли;
	
	Ответ = КэшКодыБиржКримс[вхКодКримс];
	Если Ответ = Неопределено Тогда
		Ответ = Справочники.Биржи.ПустаяСсылка();
		КэшКодыБиржКримс.Вставить(вхКодКримс, Ответ);
	КонецЕсли;
	
	Возврат Ответ;
КонецФункции

Функция ПолучитьСписокБирж(ОбъектСсылка)
	
	Запрос = новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	т.КодБиржи,
	|	т.БиржаЛистинга,
	|	т.КодЦБ,
	|	т.ИспользоватьДляCRIMS
	|ИЗ
	|	(ВЫБРАТЬ
	|		т.Код КАК КодБиржи,
	|		ЕСТЬNULL(тт.БиржаЛистинга, Биржи.Ссылка) КАК БиржаЛистинга,
	|		ЕСТЬNULL(тт.КодЦБ, """") КАК КодЦБ,
	|		ЕСТЬNULL(тт.ИспользоватьДляCRIMS, ЛОЖЬ) КАК ИспользоватьДляCRIMS
	|	ИЗ
	|		Справочник.Акции.БиржиЛистингаBloomberg КАК т
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции.БиржиЛистинга КАК тт
	|			ПО т.Код = тт.БиржаЛистинга.КодBloomberg
	|				И т.Ссылка = тт.Ссылка
	|				И (ПОДСТРОКА(тт.БиржаЛистинга.ВнешнийКод, 3, 3) = ""_00"")
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				т.Ссылка КАК Ссылка,
	|				т.КодBloomberg КАК КодBloomberg
	|			ИЗ
	|				Справочник.Биржи КАК т
	|			ГДЕ
	|				ПОДСТРОКА(т.ВнешнийКод, 3, 3) = ""_00"") КАК Биржи
	|			ПО т.Код = Биржи.КодBloomberg
	|	ГДЕ
	|		т.Ссылка = &ОбъектСсылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		т.БиржаЛистинга.КодBloomberg,
	|		т.БиржаЛистинга,
	|		т.КодЦБ,
	|		т.ИспользоватьДляCRIMS
	|	ИЗ
	|		Справочник.Акции.БиржиЛистинга КАК т
	|	ГДЕ
	|		т.Ссылка = &ОбъектСсылка
	|		И т.ИспользоватьДляCRIMS) КАК т";
	
	Запрос.УстановитьПараметр("ОбъектСсылка" ,ОбъектСсылка);
	ИмяТбл = "Справочник.Акции";
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ДепозитарныеРасписки") Тогда
		ИмяТбл = "Справочник.ДепозитарныеРасписки";
	ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ПаиПИФ") Тогда
		ИмяТбл = "Справочник.ПаиПИФ";
	ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.Облигации") Тогда
		ИмяТбл = "Справочник.Облигации";
	ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.СтруктурныеНоты") Тогда
		ИмяТбл = "Справочник.СтруктурныеНоты";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Акции", ИмяТбл);	
		
	спис = Запрос.Выполнить().Выгрузить();
	
	Возврат спис;
КонецФункции

Функция ИмяОбъектаПоПредставлению(Наименование)
	
	СтрокаВозврата = Строка(Наименование);
	
	СтрокаУдаляемыхСимволов = "( ) , : ; * ! "" № ' #  % : ^ ? & -";                
	МассивУдаляемыхСимволов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаУдаляемыхСимволов, " ");
	
	Для Каждого Символ Из МассивУдаляемыхСимволов Цикл
		СтрокаВозврата = СтрЗаменить(СтрокаВозврата, Символ, "");
	КонецЦикла;
	
	СтрокаВозврата = СтрЗаменить(СтрокаВозврата, " ", "");
	СтрокаВозврата = СтрЗаменить(СтрокаВозврата, ".", "");

	Возврат СтрокаВозврата;
КонецФункции

