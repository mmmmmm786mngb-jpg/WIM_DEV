	МассивФайлов.Добавить(Новый Структура("ИмяФайла, АдресФайлаВоВременномХранилище", ИмяФайла, АдресФайлаЗапроса)); 
	
	ТекстовыйДокументПоСхеме = ТекстовыйДокументПоСхеме(КореньXDTO, Определение.ФабрикаXDTO); 
