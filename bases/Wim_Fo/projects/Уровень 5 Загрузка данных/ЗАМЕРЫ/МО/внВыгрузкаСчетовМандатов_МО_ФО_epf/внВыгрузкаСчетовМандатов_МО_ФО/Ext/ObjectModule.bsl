// Заполняет табличные части обработки на основании переданного отбора
//
// Параметры:
//  Отбор  - Структура - Структура содержащая массив объектов обработки
//                 		[ЦенныеБумаги] - Массив - Массив элементов справочника мандатов
//						[СчетаМандатов] - Массив - массив элементов справочника счета мандатов
//
Процедура Заполнить(Узел) Экспорт
	
	// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
	ВремяНачала = ОценкаПроизводительности.НачатьЗамерВремени();
	// - FVasiliev IMDEV-8972 09.06.2026
	
	Если ОтборМандат Тогда
		ЗаполнитьСписокМандатДляОтбора();
	КонецЕсли;
	
	ТекстовыйЛог.ДобавитьСтроку("* ------ Заполнение табличных частей ------ *");
	ЗаполнитьМандаты(Узел);
	ЗаполнитьСчетаМандатов(Узел);
	ЗаполнитьБанковскиеСчета(Узел);
	ЗаполнитьБрокерскиеСчета(Узел);
	ЗаполнитьСчетаДЕПО(Узел);
	
	// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
	Вес = Мандаты.Количество();
	ОценкаПроизводительности.ЗакончитьЗамерВремени("внВыгрузкаСчетовМандатов_МО_ФО_Заполнить_" + Узел + "_Сервер", ВремяНачала, Вес);
	// - FVasiliev IMDEV-8972 09.06.2026
	
КонецПроцедуры // Заполнить()

Процедура ПроверитьУсловиеМандатыОтбор(Условие, ДобавитьИ, ПолеМандат)
    Если СписМандатОтбор.Количество() Тогда
		Условие = Условие+?(ДобавитьИ, " И ", "")+""+ПолеМандат+" В (&СписМандатОтбор)";
	КонецЕсли;	                                           
КонецПроцедуры

Процедура ЗаполнитьСчетаМандатов(Узел) Экспорт
	
	УзелОбмена = Узел;

	ТекстовыйЛог.ДобавитьСтроку(" * Заполняем табличную часть ""Счета мандатов"" * ");

	СчетаМандатов.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетаМандатовИзменения.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВтИзменения
	|ИЗ
	|	Справочник.СчетаМандатов.Изменения КАК СчетаМандатовИзменения
	|ГДЕ
	|	СчетаМандатовИзменения.Узел = &Узел
	|	И СчетаМандатовИзменения.Ссылка.Стратегия.РозничноеДУ = &РозничноеДУ
	|	&УсловиеОтбора
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаМандатов.Ссылка,
	|	СчетаМандатов.Владелец,
	|	СчетаМандатов.Наименование,
	|	СчетаМандатов.ВидСчетаМандата,
	|	СчетаМандатов.КодСчета,
	|	СчетаМандатов.МестоХранения,
	|	СчетаМандатов.Пул,
	|	СчетаМандатов.Стратегия,
	|	СчетаМандатов.Владелец.СчетНРД КАК СчетНРД,
	|	СчетаМандатов.ПометкаУдаления
	|ИЗ
	|	ВтИзменения КАК ВтИзменения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаМандатов КАК СчетаМандатов
	|		ПО ВтИзменения.Ссылка = СчетаМандатов.Ссылка";
//	|ГДЕ
//	|	НЕ СчетаМандатов.КодСчета ПОДОБНО ""______-___-T_____-__"""; // исключаем транзитные счета
	
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("РозничноеДУ", РозничноеДУ);
    
    Условие = "";
    Если ОтборМандат Тогда
		ПроверитьУсловиеМандатыОтбор(Условие, Истина, "СчетаМандатовИзменения.Ссылка.Владелец");
	    Запрос.УстановитьПараметр("СписМандатОтбор", СписМандатОтбор);
	КонецЕсли;
    Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", Условие);
    
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда Возврат; КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрокаТЧ = СчетаМандатов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, Выборка);
		НоваяСтрокаТЧ.Ссылка = Выборка.Ссылка;
		НоваяСтрокаТЧ.Ref = Выборка.Ссылка.УникальныйИдентификатор();
		НоваяСтрокаТЧ.Выгружать = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьМандаты(Узел) Экспорт
	
	УзелОбмена = Узел;

	ТекстовыйЛог.ДобавитьСтроку(" * Заполняем табличную часть ""Мандаты"" * ");
	
	Мандаты.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МандатыИзменения.Ссылка КАК СсылкаМандат,
	|	ЗНАЧЕНИЕ(Документ.ФинансовыеПланы.ПустаяСсылка) КАК ФинПлан
	|ПОМЕСТИТЬ ВтИзменения
	|ИЗ
	|	Справочник.Мандаты.Изменения КАК МандатыИзменения
	|ГДЕ
	|	МандатыИзменения.Узел = &Узел
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ФинансовыеПланыИзменения.Ссылка.Мандат,
	|	ФинансовыеПланыИзменения.Ссылка
	|ИЗ
