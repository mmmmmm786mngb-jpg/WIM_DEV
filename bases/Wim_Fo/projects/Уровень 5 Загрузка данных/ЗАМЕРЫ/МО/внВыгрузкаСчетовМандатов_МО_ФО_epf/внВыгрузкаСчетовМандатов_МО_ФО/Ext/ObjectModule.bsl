Функция ПолучитьКодЭталонногоПортфеляПоМандату(Мандат)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФинПлан.Мандат КАК Мандат,
	|	ФинПлан.ФинансовыйПлан КАК ФинПлан
	|ПОМЕСТИТЬ втФинПланы
	|ИЗ
	|	РегистрСведений.ДействующиеФинПланы.СрезПоследних(&Дата, Мандат = &Мандат) КАК ФинПлан
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтратегииФинПлана.Стратегия
	|ПОМЕСТИТЬ втСтратегии
	|ИЗ
	|	втФинПланы КАК втФинПланы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы.СоставСтратегий КАК СтратегииФинПлана
	|		ПО втФинПланы.ФинПлан = СтратегииФинПлана.Ссылка
	|ГДЕ
	|	СтратегииФинПлана.Стратегия <> ЗНАЧЕНИЕ(Справочник.Стратегии.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВИМ_НастройкиПоСтратегиямРозничногоДУСрезПоследних.КодЭталонногоПортфеляФО
	|ИЗ
	|	РегистрСведений.ВИМ_НастройкиПоСтратегиямРозничногоДУ.СрезПоследних(
	|			&Дата,
	|			Стратегия В
	|				(ВЫБРАТЬ
	|					втСтратегии.Стратегия
	|				ИЗ
	|					втСтратегии КАК втСтратегии)) КАК ВИМ_НастройкиПоСтратегиямРозничногоДУСрезПоследних";
	
	Запрос.УстановитьПараметр("Мандат", Мандат);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Количество() > 1 Тогда
		Возврат "";
	ИначеЕсли Выборка.Следующий() Тогда
		Возврат Выборка.КодЭталонногоПортфеляФО;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ВыполнитьРаспространениеПравил(ФабрикаСервиса, Прокси)

	СтруктураПакета = Новый Структура("Справочники, Документы, РегистрыСведений, Рейтинг, ДатаВыгрузки", Ложь, Ложь, Ложь, Ложь, ТекущаяДатаСеанса());
	ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
	
	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("ТребуетсяРаспространениеПравил", Истина);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ПараметрыОбмена);
	Комментарий = ЗаписьJSON.Закрыть();
	
	ПакетХДТО.Заголовок.Комментарий = Комментарий;
	
	Если вклОтладка Тогда
		обЗапись = Новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ПакетХДТО);
		ТекстовыйЛог.ДобавитьСтроку(обЗапись.Закрыть());
	КонецЕсли;
	
	Ответ = СтендОтветПубликации(ПакетХДТО);
	
	Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, Ложь, Неопределено);
	Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
		ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтатусПортфелей(Прокси, ФабрикаСервиса, МассивВнешнихКодов, Отказ, тхтОшибки)
	
	СтруктураПакета = Новый Структура("Справочники, Документы, РегистрыСведений, Рейтинг", Истина, Ложь, Ложь, Ложь);
	ПакетХДТО = хдтоСформироватьПакет(ФабрикаСервиса, СтруктураПакета, "http://avancore.ru/xsd");
	
	ПакетПараметрыЗапроса = хдтоСоздатьПакетПараметрыЗапроса(МассивВнешнихКодов, ФабрикаСервиса, "http://avancore.ru/xsd");
	
	Ответ = Прокси.GetDataOnRequest("ПолучитьСтатусПортфелей", ПакетПараметрыЗапроса);
	
	Рез = ОбработатьОтветЗапроса(Ответ, ФабрикаСервиса, вклОтладка);
	
	Если Рез.ЕстьОшибки Тогда
		ВызватьИсключение "Ошибка получения статусов портфелей из ФО" + Символы.ПС + Рез.ТекстОшибки;
	КонецЕсли;
	
	Возврат Рез.СтатусПортфелей;
	
КонецФункции

Функция хдтоСформироватьПакет(ФабрикаСервиса, СтруктураПакета, ПространствоИменСервиса)
	
	обПакет = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "Пакет"));
	Если СтруктураПакета.Справочники Тогда
		обПакет.Справочники = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("Справочники").Тип);
	КонецЕсли;
	Если СтруктураПакета.Документы Тогда
		обПакет.Документы = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("Документы").Тип);
	КонецЕсли;
	Если СтруктураПакета.РегистрыСведений Тогда
		обПакет.РегистрыСведений = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("РегистрыСведений").Тип);
	КонецЕсли;
	Если СтруктураПакета.Рейтинг Тогда
		обПакет.Рейтинг = ФабрикаСервиса.Создать(обПакет.Свойства().Получить("Рейтинг").Тип);
	КонецЕсли;
	
	обПакет.Заголовок = ФабрикаСервиса.Создать(ФабрикаСервиса.Тип(ПространствоИменСервиса, "Заголовок"));
	обПакет.Заголовок.УникальныйИдентификатор = СокрЛП(новый УникальныйИдентификатор());
	обПакет.Заголовок.ДатаВыполнения = ТекущаяДата();
	обПакет.Заголовок.ИдентификаторСистемы = "МО 1.0";
	обПакет.Заголовок.ИмяПользователя = "Сервис";
	ДатаВыгрузки = Неопределено;
	СтруктураПакета.Свойство("ДатаВыгрузки", ДатаВыгрузки);
	обПакет.Заголовок.ДатаВыгрузки = ?(ДатаВыгрузки=Неопределено, ТекущаяДата(), ДатаВыгрузки);
	
	обПакет.ИспользоватьЧастичнуюЗагрузкуПозиции = Истина;
	обПакет.ДоступнаНеПолнаяПозиция = Истина;
	Возврат обПакет;
	
КонецФункции

Функция хдтоСоздатьПакетПараметрыЗапроса(МассивВнешнихКодов, ФабрикаСервиса, ПространствоИменСервиса)
	
	типЗапросУниверсальныхДанных = ФабрикаСервиса.Тип(ПространствоИменСервиса, "ЗапросУниверсальныхДанных");
	обХДТОЗапрос = ФабрикаСервиса.Создать(типЗапросУниверсальныхДанных);
	
	типЗаголовок = ФабрикаСервиса.Тип(ПространствоИменСервиса, "Заголовок");
	обХДТОЗапрос.Заголовок = ФабрикаСервиса.Создать(типЗаголовок);
	обХДТОЗапрос.Заголовок.УникальныйИдентификатор = "333";
	обХДТОЗапрос.Заголовок.ДатаВыполнения = ТекущаяДатаСеанса();
	обХДТОЗапрос.Заголовок.ИдентификаторСистемы = "МО";
	обХДТОЗапрос.Заголовок.ИмяПользователя = "сп";
	
	типПараметры = обХДТОЗапрос.Тип().Свойства.Получить("Параметры").Тип;
	
	//СписокКодовМандатов
	обХДТОПараметры = ФабрикаСервиса.Создать(типПараметры);
	обХДТОПараметры.Ключ = "СписокВнешнихКодов";
	типЗначения = обХДТОПараметры.Тип().Свойства.Получить("Значения").Тип;
	
	Для каждого ВнешнийКод Из МассивВнешнихКодов Цикл
		обХДТОЗначения = ФабрикаСервиса.Создать(типЗначения);
		обХДТОЗначения.Значение = ВнешнийКод;
		обХДТОПараметры.Значения.Добавить(обХДТОЗначения);
	КонецЦикла;
	
	обХДТОЗапрос.Параметры.Добавить(обХДТОПараметры);
	
	Возврат обХДТОЗапрос;
	
КонецФункции

Функция ОбработатьОтветЗапроса(ОтветXDTO, ФабрикаСервиса, вклОтладка = Ложь)
	
	СтатусПортфелей = Новый Соответствие;
	
	Результат = Новый Структура("ЕстьОшибки, ТекстОшибки, СтатусПортфелей", Ложь, "", СтатусПортфелей);
	
	Если ОтветXDTO.СтатусОтвета.Код <> 0 тогда
		Результат.ТекстОшибки = "Внутренняя ошибка сервиса: "+ ОтветXDTO.СтатусОтвета.Описание;
		Результат.ЕстьОшибки = Истина;
	КонецЕсли;
	
	Для Каждого хдтоОтвеСообщение Из ОтветXDTO.СтатусОтвета.Сообщения Цикл
		Результат.ТекстОшибки = Результат.ТекстОшибки + Символы.ПС + "СтатусОтвета.Сообщения: "+ ?(хдтоОтвеСообщение.ЭтоОшибка, "err", "inf") + " [" + хдтоОтвеСообщение.Код + "] " + хдтоОтвеСообщение.Описание;
	КонецЦикла;
	
	Для каждого ТекСтрока Из ОтветXDTO.Строка Цикл
		Для Каждого ТекПоказатель Из ТекСтрока.Показатель Цикл
			Мандат = Справочники.Мандаты.НайтиПоРеквизиту("КодМандата", ТекПоказатель.Значение);
			Если ЗначениеЗаполнено(Мандат) Тогда
				СтатусПортфелей.Вставить(Мандат, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Результат.СтатусПортфелей = СтатусПортфелей;
	
	Если вклОтладка Тогда
		обЗапись = новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ОтветXDTO);
		Результат.Вставить("ТекстОтвета", обЗапись.Закрыть());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

