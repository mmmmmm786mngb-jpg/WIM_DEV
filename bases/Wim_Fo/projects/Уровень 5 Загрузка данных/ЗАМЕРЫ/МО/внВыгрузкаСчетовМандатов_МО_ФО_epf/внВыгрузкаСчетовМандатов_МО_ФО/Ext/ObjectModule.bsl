		Заголовок = "Файл ответа сервиса:" + СокрЛП(ИмяФайла);
	Иначе
		Заголовок = "Файл запроса сервиса:" + СокрЛП(ИмяФайла);
	КонецЕсли;
	ОбщегоНазначенияМО.ДобавитьВЛогОтладки(ТекстовыйДокументПоСхеме, Заголовок);
	
