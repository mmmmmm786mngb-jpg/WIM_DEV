					ПроцедурыФункцииОбмена_МО_ФО.хдтоДобавитьВПакетВалюта(ПакетХДТО, Выборка.Ссылка, ФабрикаСервиса, Отказ, тхтОшибки);
					списСсылкиУдалитьИзУзла.Добавить(Выборка.Ссылка);
					ЖурналОбмена.ДобавитьСтроку("	Объект выгружен.");
				ИначеЕсли Выборка.ИмяТаблицы = "Стратегия" Тогда
					ПроцедурыФункцииОбмена_МО_ФО.хдтоДобавитьВПакетСтратегия(ПакетХДТО, Выборка.Ссылка, ФабрикаСервиса, Отказ, тхтОшибки);
					списСсылкиУдалитьИзУзла.Добавить(Выборка.Ссылка);
