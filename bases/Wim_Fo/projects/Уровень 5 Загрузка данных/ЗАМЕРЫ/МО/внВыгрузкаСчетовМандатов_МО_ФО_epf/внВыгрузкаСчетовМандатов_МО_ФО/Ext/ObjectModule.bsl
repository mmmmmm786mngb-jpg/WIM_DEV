Функция GUID(Значение)
	
	Результат = "";
	
	Если не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Найти(Строка(Значение), "ВнешняяОбработкаТабличнаяЧастьСтрока") > 0 Тогда
		Результат = Значение.Ref;
	Иначе
		Результат = Значение.УникальныйИдентификатор();
	КонецЕсли;
	
	Возврат Строка(Результат);
	
КонецФункции

