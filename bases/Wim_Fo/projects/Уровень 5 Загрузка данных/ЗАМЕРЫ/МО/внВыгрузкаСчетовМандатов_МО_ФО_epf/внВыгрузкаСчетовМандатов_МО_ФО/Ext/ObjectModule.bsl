Функция МассивФинансовыхПлановИзмененных(Узел)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФинансовыеПланыИзменения.Ссылка
	|ИЗ
	|	Документ.ФинансовыеПланы.Изменения КАК ФинансовыеПланыИзменения
	|ГДЕ
	|	ФинансовыеПланыИзменения.Узел = &Узел";
	
	Запрос.УстановитьПараметр("Узел", Узел);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат Результат; 
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Найти(Строка(Выборка.Ссылка), "Объект не найден") > 0 Тогда Продолжить; КонецЕсли; // Событие "Удаление объекта" пропускаем
		
		Результат.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаФинансовыеПланы() Экспорт
	
	Возврат
	
	"ВЫБРАТЬ
	|	ДействующиеФинПланы.Мандат КАК Мандат,
	|	МИНИМУМ(ДействующиеФинПланы.Период) КАК Период
	|ПОМЕСТИТЬ СледующиеФинПланыМандатов
	|ИЗ
	|	РегистрСведений.ДействующиеФинПланы КАК ДействующиеФинПланы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ФинансовыеПланы КАК ФинансовыеПланы
	|		ПО ДействующиеФинПланы.Мандат = ФинансовыеПланы.Мандат
	|			И ДействующиеФинПланы.Период > ФинансовыеПланы.Дата
	|ГДЕ
	|	ФинансовыеПланы.Ссылка В(&СписокИзмененных)
	|	&УсловиеОтбора
	|
	|СГРУППИРОВАТЬ ПО
	|	ДействующиеФинПланы.Мандат
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Мандат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФинансовыеПланы.Ссылка,
	|	ФинансовыеПланы.Номер,
	|	ФинансовыеПланы.Дата КАК ДатаНачала,
	|	ВЫБОР
	|		КОГДА СледующиеФинПланыМандатов.Период ЕСТЬ NULL 
	|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	|		ИНАЧЕ ДОБАВИТЬКДАТЕ(СледующиеФинПланыМандатов.Период, ДЕНЬ, -1)
	|	КОНЕЦ КАК ДатаОкончания,
	|	ФинансовыеПланы.Бенчмарк,
	|	ФинансовыеПланы.Валюта,
	|	ФинансовыеПланы.НовыйОтчетныйПериод,
	|	ФинансовыеПланы.ЦелеваяДоходность,
	|	ФинансовыеПланы.ОжидаемаяДоходность,
	|	ФинансовыеПланы.Мандат,
	|	ФинансовыеПланы.СоставСтратегий.(
	|		Ссылка,
	|		НомерСтроки,
	|		Стратегия,
	|		Вес,
	|		Бенчмарк
	|	)
	|ИЗ
	|	Документ.ФинансовыеПланы КАК ФинансовыеПланы
	|		ЛЕВОЕ СОЕДИНЕНИЕ СледующиеФинПланыМандатов КАК СледующиеФинПланыМандатов
	|		ПО ФинансовыеПланы.Мандат = СледующиеФинПланыМандатов.Мандат
	|ГДЕ
	|	ФинансовыеПланы.Ссылка В(&СписокИзмененных)
	|	&УсловиеОтбора";

	
КонецФункции

// Производит выгрзуку данных для web-service из табличных частей обработки
//
Процедура Выгрузить(ИмяТабЧасти) Экспорт
	
	// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
	ВремяНачала = ОценкаПроизводительности.НачатьЗамерВремени();
	// - FVasiliev IMDEV-8972 09.06.2026
	
	Макет = ПолучитьМакет("Макет");
	
	СписокВыгруженныхСсылок = Новый Соответствие;
	
	Если ВыгрузитьПоУзлу Тогда
		ВыгрузитьПоУзлу();
		Возврат;
	КонецЕсли;
	
	// Стенд: публикация ФО не вызывается. Ключ пишется, если есть строки к выгрузке.
	ЕстьСтрокиСтенда = Ложь;
	Для Каждого СтрокаСтенда Из ЭтотОбъект[ИмяТабЧасти] Цикл
		Если СтрокаСтенда.Выгружать Тогда
			ЕстьСтрокиСтенда = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьСтрокиСтенда Тогда
		Возврат;
	КонецЕсли;
	Вес = 1;
	ОценкаПроизводительности.ЗакончитьЗамерВремени("внВыгрузкаСчетовМандатов_МО_ФО_Выгрузить_" + ИмяТабЧасти + "_Сервер", ВремяНачала, Вес);
	Возврат;
		
	ТекстовыйЛог.ДобавитьСтроку("|------------- Начало выгрузки -------------|");
	ТекстовыйЛог.ДобавитьСтроку("Узел обмена: " + УзелОбмена + Символы.ПС);
	
	СтруктураСервиса = ПолучитьОпределениеСервиса();
	Если СтруктураСервиса.ЕстьОшибки Тогда
		//Сообщить(СтруктураСервиса.ОписаниеОшибки);
		ТекстовыйЛог.ДобавитьСтроку(СтруктураСервиса.ОписаниеОшибки);
		ЕстьОшибки = истина;
		Возврат;
	КонецЕсли;
	
	Определение = СтруктураСервиса.ОпределениеWS;
	Прокси = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
	
	Отказ = Ложь;
	тхтОшибки = "";
	
	ТабДокВыгруженные = Новый ТабличныйДокумент;
	ТабДокНевыгруженные = Новый ТабличныйДокумент;
	
	ОблЗаголовокВыгружены = Макет.ПолучитьОбласть("ЗаголовокВыгруженыСубпортфели");
	ТабДокВыгруженные.Вывести(ОблЗаголовокВыгружены);
	ОблЗаголовокНевыгружены = Макет.ПолучитьОбласть("ЗаголовокНевыгруженыСубпортфели");
	ТабДокНевыгруженные.Вывести(ОблЗаголовокНевыгружены);
	
	ОблВыгружены = Макет.ПолучитьОбласть("ВыгруженыСубпортфели");
	ОблНевыгружены = Макет.ПолучитьОбласть("НевыгруженыСубпортфели");
	
	Попытка
		
		ТекстовыйЛог.ДобавитьСтроку(" * Заполнение данных XDTO для "+ИмяТабЧасти+" * ");
		ФабрикаСервиса = Определение.ФабрикаXDTO;
		
		Если РозничноеДУ Тогда
			
			МассивВнешнихКодов = Новый Массив;
			
			Для каждого СтрокаТаблицы Из ЭтотОбъект[ИмяТабЧасти] Цикл
				Если Не СтрокаТаблицы.Выгружать Тогда
					Продолжить;
				КонецЕсли;
				Если ИмяТабЧасти = "СчетаМандатов" Тогда
					МассивВнешнихКодов.Добавить(СтрокаТаблицы.Владелец.КодМандата);
				ИначеЕсли ИмяТабЧасти = "Мандаты" Тогда
					МассивВнешнихКодов.Добавить(СтрокаТаблицы.Ссылка.КодМандата);
				КонецЕсли;
			КонецЦикла;
			
			СтатусПортфелей = ПолучитьСтатусПортфелей(Прокси, ФабрикаСервиса, МассивВнешнихКодов, Отказ, тхтОшибки);
		КонецЕсли;
		
		ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
		
		флЕстьДанные = Ложь;
		списУдалитьРегистрацию = Новый Массив;
		
		Для каждого СтрокаТаблицы Из ЭтотОбъект[ИмяТабЧасти] Цикл
			
			Выгружать = Истина;
			тхтОшибки = "";
			
			Если ИмяТабЧасти = "СчетаМандатов" Тогда
				Если Не СтрокаТаблицы.Выгружать Тогда
					Продолжить;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.КодСчета) Тогда
					тхтОшибки = "Не заполнен код счета. ";
					Выгружать = Ложь;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.МестоХранения) Тогда
					тхтОшибки = "Не заполнено место хранения. ";
					Выгружать = Ложь;
				КонецЕсли;
				
				Если СтрокаТаблицы.ПометкаУдаления Тогда
					тхтОшибки = тхтОшибки + Символы.ПС + "Помечен на удаление. ";
					Выгружать = Ложь;
					списУдалитьРегистрацию.Добавить(СтрокаТаблицы.Ссылка);
				КонецЕсли;
				
				Если Выгружать Тогда
					ДопСведения = Новый Соответствие;
					Если РозничноеДУ Тогда
						Если СтатусПортфелей.Получить(СтрокаТаблицы.Владелец) = Неопределено Тогда
							ДопСведения.Вставить("Статус Портфеля  (RetailDU)", "1. Новый портфель. Проверить ДС");
						КонецЕсли;
					КонецЕсли;
					
					КодЭталонногоПортфеляФО = ПолучитьКодЭталонногоПортфеляПоМандату(СтрокаТаблицы.Ссылка.Владелец);
					
					Если ЗначениеЗаполнено(КодЭталонногоПортфеляФО) Тогда
						ДопСведения.Вставить("Внешний код эталонного портфеля (комплаенс)", КодЭталонногоПортфеляФО);
						ДопСведения.Вставить("Внешний код эталонного портфеля (риски)", КодЭталонногоПортфеляФО);
					КонецЕсли;
					
					ПроцедурыФункцииОбмена_МО_ФО.хдтоДобавитьВПакетСубпортфель(ПакетХДТО, СтрокаТаблицы.Ссылка, ФабрикаСервиса, Отказ, тхтОшибки, ДопСведения);
				КонецЕсли;
				
				флЕстьДанные = Истина;
				
			ИначеЕсли ИмяТабЧасти = "Мандаты" Тогда
				Если Не СтрокаТаблицы.Выгружать Тогда
					Продолжить;
				КонецЕсли;
				
				ДопСведения = Новый Соответствие;
				Если РозничноеДУ Тогда
					Если СтатусПортфелей.Получить(СтрокаТаблицы.Ссылка) = Неопределено Тогда
						ДопСведения.Вставить("Статус Портфеля  (RetailDU)", "1. Новый портфель. Проверить ДС");
					КонецЕсли;
				КонецЕсли;
				
				КодЭталонногоПортфеляФО = ПолучитьКодЭталонногоПортфеляПоМандату(СтрокаТаблицы.Ссылка);
				
				Если ЗначениеЗаполнено(КодЭталонногоПортфеляФО) Тогда
					ДопСведения.Вставить("Внешний код эталонного портфеля (комплаенс)", КодЭталонногоПортфеляФО);
					ДопСведения.Вставить("Внешний код эталонного портфеля (риски)", КодЭталонногоПортфеляФО);
				КонецЕсли;
				
				ПроцедурыФункцииОбмена_МО_ФО.хдтоДобавитьВПакетПортфель(ПакетХДТО, СтрокаТаблицы.Ссылка, ДопСведения, ФабрикаСервиса, Отказ, тхтОшибки);
				Если ЗначениеЗаполнено(СтрокаТаблицы.ФинПлан) Тогда	
					списУдалитьРегистрацию.Добавить(СтрокаТаблицы.ФинПлан);
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаТаблицы.Ссылка) Тогда	
					списУдалитьРегистрацию.Добавить(СтрокаТаблицы.Ссылка);
				КонецЕсли;
				
				флЕстьДанные = Истина;
				
			КонецЕсли;
			
			Если СписокВыгруженныхСсылок[СтрокаТаблицы.Ссылка] <> Неопределено
				Или ПроцедурыФункцииОбмена_МО_ФО.СписокВыгруженныхСсылок[СтрокаТаблицы.Ссылка] <> Неопределено Тогда
					ОблВыгружены.Параметры.Заполнить(СтрокаТаблицы);
					ОблВыгружены.Параметры.Ошибки = тхтОшибки;
					ТабДокВыгруженные.Вывести(ОблВыгружены);
					списУдалитьРегистрацию.Добавить(СтрокаТаблицы.Ссылка);
			Иначе
				ОблНевыгружены.Параметры.Заполнить(СтрокаТаблицы);
				ОблНевыгружены.Параметры.Причина = тхтОшибки;
				ТабДокНевыгруженные.Вывести(ОблНевыгружены);
			КонецЕсли;
			
		КонецЦикла;
		
		Если не флЕстьДанные Тогда
			ТекстовыйЛог.ДобавитьСтроку(" Нет данных для выгрузки. ");
			Возврат;
		КонецЕсли;
		
		Если НЕ ВалидацияДанныхXDTO(ФабрикаСервиса, ПакетХДТО) Тогда 
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		ТекстовыйЛог.ДобавитьСтроку(" * Выгрузка " + ИмяТабЧасти + " * ");
		
		Если вклОтладка Тогда
			обЗапись = новый ЗаписьXML;
			обЗапись.УстановитьСтроку("UTF-8");
			ФабрикаСервиса.ЗаписатьXML(обЗапись, ПакетХДТО);
			ТекстовыйЛог.ДобавитьСтроку(обЗапись.Закрыть());
		КонецЕсли;
		
		Ответ = СтендОтветПубликации(ПакетХДТО);
		
		Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, вклОтладка, Неопределено);
		Если Рез.ЕстьОшибки Тогда
			ТекстовыйЛог.ДобавитьСтроку(" * Ошибки: * ");
			ЕстьОшибки = Рез.ЕстьОшибки;
		ИНаче
			УдалитьРегистрациюИзУзлаОбмена(списУдалитьРегистрацию);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
			ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
		КонецЕсли;
		
		Если вклОтладка Тогда
			ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОтвета);
		КонецЕсли;
		
		Если Не Рез.ЕстьОшибки Тогда
			ТекстовыйЛог.ДобавитьСтроку(" * Выгрузка - успешно *");
		КонецЕсли;
		
		ВыполнитьРаспространениеПравил(ФабрикаСервиса, Прокси);
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		ТекстовыйЛог.ДобавитьСтроку(ОписаниеОшибки);
		ЕстьОшибки = Истина;
		
	КонецПопытки;
	
	ОблШапка = Макет.ПолучитьОбласть("Шапка");
	ОблШапка.Параметры.Заголовок = ТекстовыйЛог.ПолучитьТекст();
	
	ЖурналОбменаТабДок.Вывести(ОблШапка);
	ЖурналОбменаТабДок.Вывести(ТабДокВыгруженные);
	ЖурналОбменаТабДок.Вывести(ТабДокНевыгруженные);
	
	// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
	Вес = ЭтотОбъект[ИмяТабЧасти].Количество();
	ОценкаПроизводительности.ЗакончитьЗамерВремени("внВыгрузкаСчетовМандатов_МО_ФО_Выгрузить_" + ИмяТабЧасти + "_Сервер", ВремяНачала, Вес);
	// - FVasiliev IMDEV-8972 09.06.2026
	
КонецПроцедуры // Выгрузить()

Функция ВыборкаИзмененийПоУзлу(Узел) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка,
	|	""Субпортфель"" КАК ИмяТаблицы,
	|	т.Ссылка.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.СчетаМандатов.Изменения КАК т
	|ГДЕ
	|	т.Узел = &Узел
	|	И т.Ссылка.Стратегия.РозничноеДУ = &РозничноеДУ
	|	&УсловиеОтбора";
	
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("РозничноеДУ", РозничноеДУ);
	
	Условие = "";
	Если ОтборМандат Тогда
		ПроверитьУсловиеМандатыОтбор(Условие, Истина, "т.Ссылка.Владелец");
		Запрос.УстановитьПараметр("СписМандатОтбор", СписМандатОтбор);
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", Условие);
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
КонецФункции

Процедура ВыгрузитьПоУзлу() Экспорт
		
	Макет = ПолучитьМакет("Макет");
	ТекстовыйЛог.ДобавитьСтроку("|------------- Начало выгрузки -------------|");
	
	СтруктураСервиса = ПолучитьОпределениеСервиса();
	Если СтруктураСервиса.ЕстьОшибки Тогда
		
		ЕстьОшибки = Истина;
		ТекстовыйЛог.ДобавитьСтроку(СтруктураСервиса.ОписаниеОшибки);
		ОблШапка = Макет.ПолучитьОбласть("Шапка");
		Для Сч = 1 По ТекстовыйЛог.КоличествоСтрок() Цикл
			сс = ТекстовыйЛог.ПолучитьСтроку(Сч);
			Если сс <> "" Тогда
				ОблШапка.Параметры.Заголовок = сс;
				ЖурналОбменаТабДок.Вывести(ОблШапка);
			КонецЕсли;
		КонецЦикла;
		
		ТекстовыйЛог.ДобавитьСтроку("|------------- Завершено с ошибками -------------|");
		//Сообщить(СтруктураСервиса.ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Определение = СтруктураСервиса.ОпределениеWS;
	Прокси = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
	
	Отказ = Ложь;
	
	ТабДокВыгруженныеСубпортфели = Новый ТабличныйДокумент;
	ТабДокНевыгруженныеСубпортфели = Новый ТабличныйДокумент;
	
	ОблЗаголовокВыгруженыСубпортфели = Макет.ПолучитьОбласть("ЗаголовокВыгруженыСубпортфели");
	ТабДокВыгруженныеСубпортфели.Вывести(ОблЗаголовокВыгруженыСубпортфели);
	ОблЗаголовокНевыгруженыСубпортфели = Макет.ПолучитьОбласть("ЗаголовокНевыгруженыСубпортфели");
	ТабДокНевыгруженныеСубпортфели.Вывести(ОблЗаголовокНевыгруженыСубпортфели);
	
	ОблВыгруженыСубпортфели = Макет.ПолучитьОбласть("ВыгруженыСубпортфели");
	ОблНевыгруженыСубпортфели = Макет.ПолучитьОбласть("НевыгруженыСубпортфели");
	
	Попытка
		
		тхтОшибки = "";
		ТекстовыйЛог.ДобавитьСтроку(" * Заполнение данных XDTO * ");
		ФабрикаСервиса = Определение.ФабрикаXDTO;
		
		ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
		
		РезультатЗапроса = ВыборкаИзмененийПоУзлу(УзелОбмена);
		списСсылкиУдалитьИзУзла = новый Массив;
		сч = 0;
		счСсылок = 0;
		ТекстовыйЛог.ДобавитьСтроку(" * Выгрузка справочников * ");
		ЖурналОбмена.ДобавитьСтроку(" Список объектов для выгрузки");
		
		флПолученаНоваяСтрока = не РезультатЗапроса.Пустой();
		Выборка = РезультатЗапроса.Выбрать();
		
		Если РозничноеДУ И флПолученаНоваяСтрока = Истина Тогда
			
			МассивВнешнихКодов = Новый Массив;
			
			Пока Выборка.Следующий() Цикл
				Если Выборка.ИмяТаблицы = "Субпортфель" Тогда
					МассивВнешнихКодов.Добавить(Выборка.Ссылка.Владелец.КодМандата);
				ИначеЕсли Выборка.ИмяТаблицы = "Портфель" Тогда
					МассивВнешнихКодов.Добавить(Выборка.Ссылка.КодМандата);
				КонецЕсли;
			КонецЦикла;
			
			Выборка.Сбросить();
			СтатусПортфелей = ПолучитьСтатусПортфелей(Прокси, ФабрикаСервиса, МассивВнешнихКодов, Отказ, тхтОшибки);
		КонецЕсли;
		
		Пока флПолученаНоваяСтрока = Истина Цикл
			
			тхтОшибки = "";
			
			флПолученаНоваяСтрока = Выборка.Следующий();
			
			Если ЗначениеЗаполнено(Выборка.Ссылка) и флПолученаНоваяСтрока Тогда
				
				Если Выборка.ПометкаУдаления = Истина Тогда
					списСсылкиУдалитьИзУзла.Добавить(Выборка.Ссылка);
					Продолжить;
				КонецЕсли;
				
				сч = сч + 1;
				счСсылок = счСсылок + 1;
				
				ЖурналОбмена.ДобавитьСтроку("Добавлен вид справочника: " + Выборка.ИмяТаблицы + " --> " + "Объект: " + Выборка.Ссылка);
				
				Если Выборка.ИмяТаблицы = "Портфель" Тогда
					
					ДопСведения = Новый Соответствие;
					Если РозничноеДУ Тогда
						Если СтатусПортфелей.Получить(Выборка.Ссылка) = Неопределено Тогда
							ДопСведения.Вставить("Статус Портфеля  (RetailDU)", "1. Новый портфель. Проверить ДС");
						КонецЕсли;
					КонецЕсли;
					
					КодЭталонногоПортфеляФО = ПолучитьКодЭталонногоПортфеляПоМандату(Выборка.Ссылка);
					
					Если ЗначениеЗаполнено(КодЭталонногоПортфеляФО) Тогда
						ДопСведения.Вставить("Внешний код эталонного портфеля (комплаенс)", КодЭталонногоПортфеляФО);
						ДопСведения.Вставить("Внешний код эталонного портфеля (риски)", КодЭталонногоПортфеляФО);
					КонецЕсли;
					
					ПроцедурыФункцииОбмена_МО_ФО.хдтоДобавитьВПакетПортфель(ПакетХДТО, Выборка.Ссылка, ДопСведения, ФабрикаСервиса, Отказ, тхтОшибки);
					списСсылкиУдалитьИзУзла.Добавить(Выборка.Ссылка);
					ЖурналОбмена.ДобавитьСтроку("	Объект выгружен.");
				ИначеЕсли Выборка.ИмяТаблицы = "Субпортфель" Тогда
					Выгружать = Истина;
					Если не ЗначениеЗаполнено(Выборка.Ссылка.КодСчета) Тогда
						тхтОшибки = "Не заполнен код счета. ";
						Выгружать = Ложь;
					КонецЕсли;
					
					Если Выгружать = Истина Тогда
					
						ДопСведения = Новый Соответствие;
						Если РозничноеДУ Тогда
							Если СтатусПортфелей.Получить(Выборка.Ссылка.Владелец) = Неопределено Тогда
								ДопСведения.Вставить("Статус Портфеля  (RetailDU)", "1. Новый портфель. Проверить ДС");
							КонецЕсли;
						КонецЕсли;
						
						КодЭталонногоПортфеляФО = ПолучитьКодЭталонногоПортфеляПоМандату(Выборка.Ссылка.Владелец);
						
