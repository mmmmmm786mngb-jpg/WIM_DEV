Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды <> "ФоноваяВыгрузка" Тогда Возврат; КонецЕсли;
	
	// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
	ВремяНачала = ОценкаПроизводительности.НачатьЗамерВремени();
	Узел = "";
	// - FVasiliev IMDEV-8972 09.06.2026
	
	Если ТипЗнч(ПараметрыВыполненияКоманды) = Тип("Структура") тогда
		Если ПараметрыВыполненияКоманды.Свойство("Узел") Тогда
			ПараметрыВыполненияКоманды.Вставить("Узел", ПараметрыВыполненияКоманды.Узел);
			// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
			Узел = ПараметрыВыполненияКоманды.Узел;
			// - FVasiliev IMDEV-8972 09.06.2026
		КонецЕсли;
	КонецЕсли;
	
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	// По расписанию выгружаем счета мандатов только по стратегиям с флагом "Розничное ДУ" = Истина
	РозничноеДУ = Истина;
	
	Попытка
		ОписаниеОбменов.ВыполнитьКомандуПоОбменам(ЭтотОбъект, ИдентификаторКоманды, ПараметрыВыполненияКоманды, ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка.БезопасныйРежим);
	Исключение
	КонецПопытки;
	
	Если СписокРассылки.Количество() > 0 И ЗначениеЗаполнено(ПочтовыйЛогин) И счСсылок > 0 Тогда
		СформироватьИОтправитьПисьмо();
	КонецЕсли;
	
	// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
	Вес = Мандаты.Количество();
	ОценкаПроизводительности.ЗакончитьЗамерВремени("внВыгрузкаСчетовМандатов_МО_ФО_ВыполнитьКоманду_" + Узел + "_Сервер", ВремяНачала, Вес);
	// - FVasiliev IMDEV-8972 09.06.2026
	
КонецПроцедуры

Процедура СформироватьИОтправитьПисьмо()
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
	
	ИмяВрФайла = ПолучитьИмяВременногоФайла("html");
	ЖурналОбменаТабДок.Записать(ИмяВрФайла, ТипФайлаТабличногоДокумента.HTML5);
	Файл = Новый ЧтениеТекста(ИмяВрФайла);
	
	ТелоПисьма = Файл.Прочитать();
	
	Файл.Закрыть();
	
	Кому = Новый Массив;
	Для каждого ТекЯщик из СписокРассылки Цикл
		Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
	КонецЦикла;
	
	ФлагРезультатаВТеме = "{OK} ";
	Если ЕстьОшибки Тогда
		ФлагРезультатаВТеме = "{FAIL} ";
	КонецЕсли;
	
	ТемаСообщения = "Выгрузка счетов мандатов из МО во Фронт-офис";
	
	ПараметрыПисьма.Кому = Кому;
	ПараметрыПисьма.Тема = ФлагРезультатаВТеме + ТемаСообщения + ПропискаРассылки("r157");
	ПараметрыПисьма.Важность = ?(ЕстьОшибки, ВажностьИнтернетПочтовогоСообщения.Наивысшая, ВажностьИнтернетПочтовогоСообщения.Обычная);
	ПараметрыПисьма.Тело = ТелоПисьма;
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
	ПараметрыПисьма.Важность	 = ?(ЕстьОшибки, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
	
	РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
	
	УдалитьФайлы(ИмяВрФайла);
	
КонецПроцедуры

#КонецОбласти

