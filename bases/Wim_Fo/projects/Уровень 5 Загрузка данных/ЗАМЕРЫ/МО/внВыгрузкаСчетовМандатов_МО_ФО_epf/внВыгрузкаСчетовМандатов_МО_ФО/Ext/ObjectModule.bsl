				Если тхтОшибки <> "" Тогда
					ТекстовыйЛог.ДобавитьСтроку(тхтОшибки);
				КонецЕсли;
			КонецЕсли;
			
			Если сч>30 или не флПолученаНоваяСтрока Тогда
