
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДополнительнаяОбработкаСсылка = Неопределено;
	Если Параметры.Свойство("НастройкиАлгоритма") И ТипЗнч(Параметры.НастройкиАлгоритма) = Тип("Структура") Тогда
		// открывается из дополнительных обработок с ранее сохраненными настройками (гиперссылка "установить настройки")
		Настройки 			= Параметры.НастройкиАлгоритма;
		ОбработкаОбъект 	= РеквизитФормыВЗначение("Объект");
		ОбработкаОбъект.УстановитьПользовательскиеНастройки(Настройки);
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	ИначеЕсли Параметры.Свойство("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка) Тогда
		// открывается из формы пользовательских обработок в разделах
		НастройкиИзБазы = ДополнительнаяОбработкаСсылка.ХранилищеНастроек.Получить();
		ОбработкаОбъект 	= РеквизитФормыВЗначение("Объект");
		ОбработкаОбъект.УстановитьПользовательскиеНастройки(НастройкиИзБазы);
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	Иначе
		// открывается как внешняя обработка через Открыть 
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ОбработкаОбъект.Метаданные().Имя);
		Если НЕ ДополнительнаяОбработкаСсылка.Пустая() Тогда
			НастройкиИзБазы = ДополнительнаяОбработкаСсылка.ХранилищеНастроек.Получить();
			ОбработкаОбъект.УстановитьПользовательскиеНастройки(НастройкиИзБазы);
			ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Заполнение табличной части
&НаКлиенте
Процедура Заполнить(Команда)
	
	ВажностьОшибки = 0;
	ЗаполнитьНаСервере(ВажностьОшибки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере(ВажностьОшибки)
		
	Объект.ТекстовыйЛог.Очистить();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.Заполнить(ВажностьОшибки);
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

// Выгрзука через сервис
&НаКлиенте
Процедура Опубликовать(Команда)
	
	ВажностьОшибки = 0;
	ОпубликоватьНаСервере(ВажностьОшибки);  
	Если ВажностьОшибки > 0 Тогда
		ВывестиЛог();
	Иначе
		Сообщить("Успешно выполнено");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОпубликоватьНаСервере(ВажностьОшибки)
	
	Объект.ТекстовыйЛог.Очистить();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.Опубликовать(ВажностьОшибки);
	
КонецПроцедуры

// Вывод лога
&НаКлиенте
Процедура Лог(Команда)
	
	ВывестиЛог();
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиЛог()

	Лог = Объект.ТекстовыйЛог.ПолучитьТекст();
	Если НЕ ПустаяСтрока(Лог) Тогда
		ЛогВывода = Новый ТекстовыйДокумент;
		ЛогВывода.УстановитьТекст(Лог);
		ЛогВывода.Показать("Лог работы сервиса");
	КонецЕсли; 

КонецПроцедуры // ВывестиЛог()
 
// Настройки
&НаСервере
Процедура НастройкиПоУмолчаниюНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.НастройкиПоУмолчанию(ОбработкаОбъект);	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура НастройкиПоУмолчанию(Команда)
	
	НастройкиПоУмолчаниюНаСервере();
	
КонецПроцедуры // НастройкиПоУмолчанию()

&НаСервере
Процедура ТестКомандыВыполнитьБСПНаСервере()
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("ПараметрыДополнительнойОбработки", Неопределено);
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ВыполнитьКоманду("ФоновоеВыполнение", ПараметрыВыполненияКоманды);

КонецПроцедуры

&НаКлиенте
Процедура ТестКомандыВыполнитьБСП(Команда)
	ТестКомандыВыполнитьБСПНаСервере();
КонецПроцедуры
