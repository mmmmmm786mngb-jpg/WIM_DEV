		|	ВТ_КотировкаРезультат.Биржа.Наименование";
	
	ДатаПред = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, ДатаЗаполнения, -1);
	
	Запрос.УстановитьПараметр("Актив", ЭтотОбъект.Актив);
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаЗаполнения));
	Запрос.УстановитьПараметр("Дата1", КонецДня(ДатаПред));
	Запрос.УстановитьПараметр("Дата2", КонецДня(ДатаПред) - 1*24*60*60);
	Запрос.УстановитьПараметр("Дата13", КонецДня(ДатаЗаполнения) - 13*24*60*60);
	
	Запрос.УстановитьПараметр("БиржаММВБ", Справочники.Биржи.НайтиПоНаименованию("ММВБ"));
	Запрос.УстановитьПараметр("БиржаOTC", Справочники.Биржи.НайтиПоНаименованию("OTC"));
	Запрос.УстановитьПараметр("БиржаРТС", Справочники.Биржи.НайтиПоНаименованию("РТС"));
	Запрос.УстановитьПараметр("СтранаВыпуска", Справочники.СтраныМира.НайтиПоКоду("643"));
	
	ПросроченныеКотировки = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из ПросроченныеКотировки Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Актив", Строка.Актив);
		
		НайденныеКотировки = КотировкиММВБ.НайтиСтроки(Отбор);
		
		Если НайденныеКотировки.Количество() > 0 Тогда
			
			ЦенаНРД = ПолучитьЦенуНРД2(Строка.Актив, ДатаЗаполнения);
			Если НЕ ЦенаНРД = Неопределено Тогда
				НайденныеКотировки[0].РыночнаяЦена = ЦенаНРД;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Котировки.Загрузить(КотировкиММВБ);
	
	ТекстовыйЛог.ДобавитьСтроку(СтрШаблон("Количество всего: %1", Котировки.Количество()));
	
	// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
	Если НЕ ЕстьЗамер = Истина Тогда
		Вес = Котировки.Количество();
		ОценкаПроизводительности.ЗакончитьЗамерВремени("внВыгрузкаКотировокМО_ФО_Заполнить_Сервер", ВремяНачала, Вес);
	КонецЕсли;
	// - FVasiliev IMDEV-8972 09.06.2026
	
КонецПроцедуры // Заполнить()

// Возвращает цену расчетного центра НРД2
Функция ПолучитьЦенуНРД2(Актив, ДатаЗаполнения)
	ЦенаНРД = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КотировкиЦБНаБиржеСрезПоследних.Актив КАК Актив,
		|	КотировкиЦБНаБиржеСрезПоследних.Актив.ВнешнийКод КАК ВнешнийКод,
		|	КотировкиЦБНаБиржеСрезПоследних.Актив.ВидАктива.Родитель КАК ВидЦБ,
		|	КотировкиЦБНаБиржеСрезПоследних.Биржа КАК Биржа,
		|	ВЫРАЗИТЬ(КотировкиЦБНаБиржеСрезПоследних.ПризнаваемаяКотировка КАК ЧИСЛО(18, 6)) КАК РыночнаяЦена,
		|	ВЫБОР
		|		КОГДА КотировкиЦБНаБиржеСрезПоследних.Биржа.Код <> ""BVAL""
		|			ТОГДА 1
		|		ИНАЧЕ КотировкиЦБНаБиржеСрезПоследних.Биржа.Код
		|	КОНЕЦ КАК Код,
		|	КотировкиЦБНаБиржеСрезПоследних.Актив.Объект.ДатаПогашения КАК АктивОбъектДатаВыпуска
		|ИЗ
		|	РегистрСведений.КотировкиЦБНаБирже.СрезПоследних(
		|			&ДатаКотировки,
		|			Актив = &Актив
		|				И ПризнаваемаяКотировка > 0
		|				И Биржа = &Биржа) КАК КотировкиЦБНаБиржеСрезПоследних
		|ГДЕ
		|	КотировкиЦБНаБиржеСрезПоследних.Актив.Наименование <> ""Технический актив""
		|	И (КотировкиЦБНаБиржеСрезПоследних.Актив.Объект.ДатаПогашения >= &ДатаКотировки
		|			ИЛИ КотировкиЦБНаБиржеСрезПоследних.Актив.Объект.ДатаПогашения ЕСТЬ NULL)
		|	И КотировкиЦБНаБиржеСрезПоследних.Актив.ВидАктива.Код <> ""ОбезличенныеМеталлическиеСчета""";
	
	Запрос.УстановитьПараметр("Актив", Актив);
	Запрос.УстановитьПараметр("Биржа", Справочники.Биржи.ПолучитьСсылку(Новый УникальныйИдентификатор("febd0a13-0043-11e8-84eb-005056b100fc"))); //РасчетныеНРД2
	Запрос.УстановитьПараметр("ДатаКотировки", ДатаЗаполнения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЦенаНРД = Выборка.РыночнаяЦена;
	КонецЦикла;
	
	Возврат ЦенаНРД;
	
КонецФункции

