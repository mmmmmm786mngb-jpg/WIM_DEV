Процедура ВыполнитьПерерасчетРСАПоВсемПортфелям(ФабрикаСервиса, Прокси, ИдентификаторСеанса, ДатаЗаполнения)
	
	Дата = КонецДня(ДатаЗаполнения) + 1;
	
	ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
	
	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("ТребуетсяПерерасчетРСА", Истина);
	ПараметрыОбмена.Вставить("ТребуетсяПерерасчетРСАДата", Дата);
	ПараметрыОбмена.Вставить("ТребуетсяПерерасчетРСАПоВсемПортфелям", Истина);
	ПараметрыОбмена.Вставить("ТребуетсяПерерасчетРСАИдентификаторСеанса", Строка(ИдентификаторСеанса));
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ПараметрыОбмена);
	Комментарий = ЗаписьJSON.Закрыть();
	
	ПакетХДТО.Заголовок.Комментарий = Комментарий;
	
	Если вклОтладка Тогда
		обЗапись = Новый ЗаписьXML;
		обЗапись.УстановитьСтроку("UTF-8");
		ФабрикаСервиса.ЗаписатьXML(обЗапись, ПакетХДТО);
		ТекстовыйЛог.ДобавитьСтроку(обЗапись.Закрыть());
	КонецЕсли;
	
	Ответ = СтендОтветПубликации(ПакетХДТО);
	
	Рез = ПроцедурыФункцииОбмена_МО_ФО.ОбработатьОтвет(Ответ, ФабрикаСервиса, Ложь, Неопределено);
	Если ЗначениеЗаполнено(Рез.ТекстОшибки) Тогда
		ТекстовыйЛог.ДобавитьСтроку(Рез.ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

