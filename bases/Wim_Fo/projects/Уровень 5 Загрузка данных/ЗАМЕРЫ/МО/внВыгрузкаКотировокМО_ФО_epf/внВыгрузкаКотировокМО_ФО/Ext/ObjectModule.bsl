Функция СформироватьСтрокуПисьма(Знач СтрокаСообщение)
		
	СтрокаФормат = "<p>" + СтрЗаменить(СокрЛП(СтрокаСообщение), Символы.ПС, "</p><p>") + "</p>";
	Возврат СтрЗаменить(СтрокаФормат, "<p></p>", "<p>&nbsp;</p>");
	
КонецФункции

Функция ПрефиксПисьма(Знач ВажностьОшибки, Знач ЭтоОтчет = Ложь)
	Перем ПрефиксПисьма;
	
	Если ВажностьОшибки = 1 Тогда
		ПрефиксПисьма = "{WARN} ";
		
	ИначеЕсли ВажностьОшибки = 2 Тогда
		ПрефиксПисьма = "{FAIL} ";
		
	Иначе
		ПрефиксПисьма = ?(ЭтоОтчет, "", "{OK} ");
	КонецЕсли;
	
	Возврат ПрефиксПисьма;
КонецФункции // ПрефиксПисьма()

Функция ПропискаРассылки(Знач НомерРассылки)
