	КонецПопытки;
	Если ТекущийРабочийДень = Неопределено Тогда 
		 ТекущийРабочийДень = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(ПроизводственныйКалендарь, Период, -1)
	КонецЕсли;
	//}IMAPPS-21479
	ФабрикаСервиса = Определение.ФабрикаXDTO;
	
	ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
	
	типХДТО_Котировки = ФабрикаСервиса.Тип(ПроцедурыФункцииОбмена_МО_ФО.ПолучитьПространствоИменСервиса(), "КотировкаЦБНаБирже");
	обХДТО_Котировки = ФабрикаСервиса.Создать(типХДТО_Котировки);
	
	типХДТО_ФинПкли = ФабрикаСервиса.Тип(ПроцедурыФункцииОбмена_МО_ФО.ПолучитьПространствоИменСервиса(), "ФинансовыеПоказателиОблигаций");
	
	типХДТО_ИсторияНСО = ФабрикаСервиса.Тип(ПроцедурыФункцииОбмена_МО_ФО.ПолучитьПространствоИменСервиса(), "ИсторияНоминальнойСтоимостиОблигаций");
	
	обХДТО_Котировки.Дата = Период;
	обХДТО_Котировки.Биржа = ПроцедурыФункцииОбмена_МО_ФО.хдтоБиржаПоиск(ссБиржа, ФабрикаСервиса);
	обХДТО_Котировки.Проведен = Истина;
	
	типХДТО_Строка = обХДТО_Котировки.Свойства().Получить("Котировки").Тип;
	кешВыгруженныеАктивы = Новый Соответствие;
	
	ВыгруженоВсего = 0;
	ВыгруженоЗаПредыдущийРабочийДень = 0;
	
	Для каждого СтрокаТаблицы Из Котировки Цикл
		
		ВнешКод = СокрЛП(СтрокаТаблицы.Актив.ВнешнийКод);
		Если ВнешКод = "" Тогда
			ТекстовыйЛог.ДобавитьСтроку("Для "+СтрокаТаблицы.Актив+" не заполнен внешний код, актив пропущен.");
			Продолжить;
		КонецЕсли;
		
		Если кешВыгруженныеАктивы[ВнешКод] <> Неопределено Тогда
			ТекстовыйЛог.ДобавитьСтроку("Для "+СтрокаТаблицы.Актив+", внешний код: "+ВнешКод+" уже выгружен, актив пропущен.");
			Продолжить;
		КонецЕсли;
		
		Если НенайденныеАктивы[ВнешКод] <> Неопределено Тогда
			ТекстовыйЛог.ДобавитьСтроку("Актив "+СтрокаТаблицы.Актив+" не найден в базе-приемнике, актив пропущен.");
			Продолжить;
		КонецЕсли;
		
		СтрокаXDTO = ФабрикаСервиса.Создать(типХДТО_Строка);
		СтрокаXDTO.Актив  = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПоиск(СтрокаТаблицы.Актив, ФабрикаСервиса);
		СтрокаXDTO.Валюта = ПроцедурыФункцииОбмена_МО_ФО.хдтоВалютаПоиск(СтрокаТаблицы.Валюта, ФабрикаСервиса);
		СтрокаXDTO.ПризнаваемаяКотировка = СтрокаТаблицы.РыночнаяЦена;
		СтрокаXDTO.НКД = СтрокаТаблицы.НКД;
		обХДТО_Котировки.Котировки.Добавить(СтрокаXDTO);
		
		обХДТО_ФинПкли = ФабрикаСервиса.Создать(типХДТО_ФинПкли);
		обХДТО_ФинПкли.Период = Период;
		обХДТО_ФинПкли.Актив  = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПоиск(СтрокаТаблицы.Актив, ФабрикаСервиса);
		обХДТО_ФинПкли.Доходность = СтрокаТаблицы.Доходность;
		обХДТО_ФинПкли.Дюрация = СтрокаТаблицы.ДюрацияНРД;
		обХДТО_ФинПкли.ДюрацияМод = СтрокаТаблицы.ДюрацияМод;
		ПакетХДТО.РегистрыСведений.ФинансовыеПоказателиОблигаций.Добавить(обХДТО_ФинПкли);
		
		Если СтрокаТаблицы.НоминальнаяСтоимостьИндексируемойОблигации <> 0 Тогда
			
			обХДТО_ИсторияНСО = ФабрикаСервиса.Создать(типХДТО_ИсторияНСО);
			обХДТО_ИсторияНСО.Период = Период;
			обХДТО_ИсторияНСО.Актив  = ПроцедурыФункцииОбмена_МО_ФО.хдтоАктивПозицияПоиск(СтрокаТаблицы.Актив, ФабрикаСервиса);
			обХДТО_ИсторияНСО.НоминальнаяСтоимость = СтрокаТаблицы.НоминальнаяСтоимостьИндексируемойОблигации;
			ПакетХДТО.РегистрыСведений.ИсторияНоминальнойСтоимостиОблигаций.Добавить(обХДТО_ИсторияНСО);
			
		КонецЕсли;
		
		кешВыгруженныеАктивы.Вставить(ВнешКод, Истина);
		
		ВыгруженоВсего = ВыгруженоВсего + 1;
		Если НачалоДня(ПредыдущийРабочийДень) = НачалоДня(СтрокаТаблицы.Период) Тогда
			ВыгруженоЗаПредыдущийРабочийДень = ВыгруженоЗаПредыдущийРабочийДень + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ПроцентВыгруженных = ?(ВыгруженоВсего = 0, 0, Окр(ВыгруженоЗаПредыдущийРабочийДень / ВыгруженоВсего * 100, 2));
	
	Если НенайденныеАктивы.Количество() > 0 Тогда
		ТекстовыйЛог.ДобавитьСтроку("Повторная выгрузка:");
	КонецЕсли;
	
	ТекстовыйЛог.ДобавитьСтроку("Всего выгружено котировок за дату "+Формат(ТекущийРабочийДень,"ДФ=dd.MM.yyyy")+": " + ВыгруженоВсего + ". Не обновились котировки с прошлого дня("+Формат(ПредыдущийРабочийДень,"ДФ=dd.MM.yyyy")+"): " + ВыгруженоЗаПредыдущийРабочийДень
		+ ". Соотношение, %: " + ПроцентВыгруженных);
		
	Если ПроцентВыгруженных < 90 Тогда
		ВажностьОшибки = 1;
	КонецЕсли;
	
	ПакетХДТО.Документы.КотировкиЦБНаБирже.Добавить(обХДТО_Котировки);
	
	Возврат ПакетХДТО;
	
КонецФункции // СформироватьОбъектЗапросаXDTOПоТабличнойЧасти()

Функция СформироватьОбъектЗапросаXDTOБезНенайденныхАктивов(Определение, ОтветXDTO, ВажностьОшибки)
	
	ЕстьНенайденныеАктивы = Ложь;
	
	НенайденныеЭлементы = Неопределено;
	Если ОтветXDTO.Свойства().Получить("НенайденныеЭлементы") <> Неопределено Тогда
		НенайденныеЭлементы = ОтветXDTO.Получить("НенайденныеЭлементы");
	КонецЕсли;
	
	Если НенайденныеЭлементы <> Неопределено Тогда
		
		НенайденныеАктивы = Новый Соответствие;
		
		Для каждого обПоиск Из НенайденныеЭлементы.Активы Цикл
			НенайденныеАктивы.Вставить(обПоиск.Актив.ВнешнийКод, Истина);
			ЕстьНенайденныеАктивы = Истина;
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьНенайденныеАктивы = Истина Тогда
		ПакетХДТО = СформироватьОбъектЗапросаXDTOПоТабличнойЧасти(Определение, ВажностьОшибки, НенайденныеАктивы);
	Иначе
		ФабрикаСервиса = Определение.ФабрикаXDTO;
		ПакетХДТО = ПроцедурыФункцииОбмена_МО_ФО.хдтоСформироватьПакет(ФабрикаСервиса);
	КонецЕсли;
	
	Возврат ПакетХДТО;
	
КонецФункции

// Возвращает таблицу ценных бумаг к выгрузкеj
Функция ПодготовитьТаблицуЦенныеБумагиКВыгрузке()

	МассивРезультат = Новый Массив;
	Для каждого СтрокаТаблицы Из Котировки Цикл	
		СтрокаКотировка = Новый Структура;
		СтрокаКотировка.Вставить("Актив", СтрокаТаблицы.ВнешнийКод);
		Если СтрокаТаблицы.РыночнаяЦена > 0 Тогда
			СтрокаКотировка.Вставить("ПризнаваемаяКотировка", СтрокаТаблицы.РыночнаяЦена);
		КонецЕсли;
		МассивРезультат.Добавить(СтрокаКотировка);
	КонецЦикла; 
	
	Возврат МассивРезультат;
	
КонецФункции // ПодготовитьТаблицуЦенныеБумагиКВыгрузке()

