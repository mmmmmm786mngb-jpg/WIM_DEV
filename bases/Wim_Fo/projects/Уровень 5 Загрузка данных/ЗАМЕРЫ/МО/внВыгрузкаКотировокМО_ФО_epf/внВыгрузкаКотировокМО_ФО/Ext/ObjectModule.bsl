#Область РассылкаПоПочте

// Выполняет отправление е-письма через функцию в БСП 
// РаботаСПочтовымиСообщениями.ОтправитьСообщение(УчетнаяЗапись, ПараметрыПисьма)
//
// Параметры:
//  ПараметрыРассылки - Структура - структура с параметрами рассылки
//  	ТекстПисьма  		- Строка - тело письма
//      ТемаПисьма  		- Строка - тема письма
//      ТаблицаВложений 	- ТаблицаЗначений - поля: 
//			ИмяФайла 			- Строка - имя файла с расширением, как оно будет отображаться в прикреплении к письму
//			АдресВХранилище 	- Строка - адрес во временном хранилище с двоичными данными файла 
//      СписокПолучателей 	- список email-ов получателей рассылки - варианты параметра:	
//							- ТаблицаЗначений - поля:
//			ПочтовыйЯщик 		- Строка - e-mail получателя
//			Представление 		- Строка - представление e-mail получателя
//			КакКопия			- Булево - признак отправки письма адресату как копии
//							- Строка - Список получателей строкой, через запятую
//		ТипТекста  			- Тип текста письма - варианты параметра:
//							- Перечисления.ТипыТекстовЭлектронныхПисем, ТипТекстаПочтовогоСообщения, Строка 
//  УчетнаяЗапись - Справочники.УчетныеЗаписиЭлектроннойПочты - учетная запись с почтой отправителя
//  ВажностьОшибки - Число - 0,1,2
// Возвращаемое значение: 
//  ТекстОшибки - Строка   		- в случае ошибки
//				- Неопределено 	- в случае успешной отправки
//
Функция ОтправитьПисьмо(Знач ПараметрыРассылки, Знач УчетнаяЗапись, Знач ВажностьОшибки = 0)
	
	ТекстПисьма 	= ПараметрыРассылки.ТекстПисьма;
	ТемаПисьма 		= ПараметрыРассылки.ТемаПисьма;

	Вложения = Новый Соответствие();
	ТаблицаВложений = Новый ТаблицаЗначений;
	Если ПараметрыРассылки.Свойство("ТаблицаВложений", ТаблицаВложений) Тогда
		Если ТипЗнч(ТаблицаВложений) = Тип("ТаблицаЗначений") Тогда
			Для Каждого текВложение Из ТаблицаВложений Цикл
				Вложения.Вставить(текВложение.ИмяФайла, текВложение.АдресВХранилище);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Кому 		= Новый Массив();
	Копия 		= Новый Массив();
	СписокПолучателей = Неопределено;
	Если ПараметрыРассылки.Свойство("СписокПолучателей", СписокПолучателей) Тогда
		Если ТипЗнч(СписокПолучателей) = Тип("ТаблицаЗначений") Тогда
			Для Каждого ТекЯщик Из СписокПолучателей Цикл
				Если ТекЯщик.КакКопия Тогда
					Копия.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
				Иначе
					Кому.Добавить(Новый Структура("Адрес, Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(СписокПолучателей) = Тип("Строка") Тогда
			Кому = СписокПолучателей;
		КонецЕсли;	
	КонецЕсли;
	
	ТипТекста = "HTML";
	Если НЕ ПараметрыРассылки.Свойство("ТипТекста", ТипТекста) Тогда
		ТипТекста = "HTML"; 
	КонецЕсли;
		
	ПараметрыПисьма = Новый Структура("Кому, Копии, Тема, Тело, ТипТекста, Вложения, Важность");
	ПараметрыПисьма.Вложения	 = Вложения;
	ПараметрыПисьма.Кому		 = Кому;
	ПараметрыПисьма.Копии		 = Копия;
	ПараметрыПисьма.Тема		 = ТемаПисьма;
	ПараметрыПисьма.Тело		 = ТекстПисьма;
	ПараметрыПисьма.ТипТекста	 = ТипТекста;
	ПараметрыПисьма.Важность	 = ?(ВажностьОшибки > 0, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);

	ТекстОшибки = Неопределено;
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьСообщение(УчетнаяЗапись, ПараметрыПисьма);
	Исключение
		ТекстОшибки = ОписаниеОшибки();	
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Произошла ошибка при отправке почтового сообщения! " + ТекстОшибки);
	КонецПопытки;	
		
	Возврат ТекстОшибки;
	
КонецФункции // ОтправитьПисьмо()

Функция СформироватьТелоПисьма(Знач ТекстПисьма)
	
	ТелоПисьма = "
	|<html>
