Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда Возврат; КонецЕсли;
	
	// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
	ВремяНачала = ОценкаПроизводительности.НачатьЗамерВремени();
	Вес = 0;
	ЕстьЗамер = Истина;
	// - FVasiliev IMDEV-8972 09.06.2026

	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	Период = НачалоДня(ТекущаяДата())-1;
	
	ТекстовыйЛог.Очистить();
	ВажностьОшибки = 0;
	ТекстовыйЛог.ДобавитьСтроку(СтрШаблон("[%1] Начало обработки", ТекущаяДатаСеанса()));
	
	Попытка
		Заполнить(ВажностьОшибки);
		Опубликовать(ВажностьОшибки);
	Исключение
		ТекстОшибки = "Ошибка при выполнении команды обработки: " + ОписаниеОшибки() + Символы.ПС;	
		ТекстовыйЛог.ДобавитьСтроку(ТекстОшибки);
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Описание ошибки: " + ТекстОшибки);
		ВажностьОшибки = 2;
	КонецПопытки;
	
	ТекстовыйЛог.ДобавитьСтроку(СтрШаблон("[%1] Окончание обработки", ТекущаяДатаСеанса()));
	
	//Если ВажностьОшибки = 0 Тогда 
	//	Возврат; 
	//КонецЕсли;
	//	
	#Область ПисьмоОбОшибке
	Попытка 
		СписокПолучателей = ЭтотОбъект.СписокРассылки.Выгрузить();
		Если СписокПолучателей.Количество() > 0 И НЕ ЭтотОбъект.ПочтовыйЛогин.Пустая() Тогда			
			ПараметрыРассылки = Новый Структура();
			ТемаЗаголовок 	= "Выгрузка котировок МO -> ФО";
			ТемаПисьма 		= ПрефиксПисьма(ВажностьОшибки) + СтрШаблон("Аванкор MO: %1", ТемаЗаголовок) + ПропискаРассылки("r133");
			ТекстПисьма		= ЭтотОбъект.ТекстовыйЛог.ПолучитьТекст();
 			ТекстПисьма 	= СформироватьТелоПисьма(ТекстПисьма);
			
			ПараметрыРассылки.Вставить("ТемаПисьма", 		ТемаПисьма);
			ПараметрыРассылки.Вставить("ТекстПисьма", 		ТекстПисьма);
			ПараметрыРассылки.Вставить("СписокПолучателей", СписокПолучателей);
			
			ОтправитьПисьмо(ПараметрыРассылки, ЭтотОбъект.ПочтовыйЛогин, ВажностьОшибки);
		КонецЕсли;
	Исключение
		ТекстОшибки = ТекстОшибки + Символы.ПС + "Ошибка при отправке письма об ошибке: " + ОписаниеОшибки() + Символы.ПС;	
		ЗаписьЖурналаРегистрации(
			"Дополнительные отчеты и обработки." + Метаданные().Представление(),
			УровеньЖурналаРегистрации.Ошибка,,,
			"Описание ошибки: " + ТекстОшибки);
		Сообщить(ТекстОшибки);
		ВажностьОшибки = 2;
	КонецПопытки;
	
	#КонецОбласти
	
	// + FVasiliev IMDEV-8972 09.06.2026 Оценка производительности
	Вес = Котировки.Количество();
	ОценкаПроизводительности.ЗакончитьЗамерВремени("внВыгрузкаКотировокМО_ФО_ВыполнитьКоманду_Сервер", ВремяНачала, Вес);
	ЕстьЗамер = Неопределено;
	// - FVasiliev IMDEV-8972 09.06.2026
	
КонецПроцедуры

