Функция УстановитьПараметры(ЗаголовокНастроек) Экспорт
	
	Значения = Новый Структура();
	Значения.Вставить("НастройкаРассылки", ЭтотОбъект.НастройкаРассылки);
	Значения.Вставить("СервисИсточник", ЭтотОбъект.СервисИсточник);
	
	ПредставлениеПочты = ?(ЭтотОбъект.НастройкаРассылки.СписокАдресов.Количество()>0, ", Установлен список рассылки","");
	ЗаголовокНастроек = СокрЛП(ПредставлениеПочты);
	
	Возврат Значения;
	
КонецФункции

