Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда 
		Возврат "<Настройки не установлены>"; 
	КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек);
	
	Возврат "Настройки установлены";
	
КонецФункции

Функция СоставПоДатеИндексу(Дата, Индекс)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",Дата);
	Запрос.УстановитьПараметр("Индекс",Индекс);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УстановкаСоставаИндекса.Ссылка
	               |ИЗ
	               |	Документ.УстановкаСоставаИндекса КАК УстановкаСоставаИндекса
	               |ГДЕ
	               |	НАЧАЛОПЕРИОДА(УстановкаСоставаИндекса.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	               |	И УстановкаСоставаИндекса.Индекс = &Индекс
	               |	И НЕ УстановкаСоставаИндекса.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Текдок = Выборка.Ссылка.ПолучитьОбъект();
		//ТекДок.Комментарий = ПАТЕРН_ОТБОРА;
		ТекДок.СоставИндекса.Очистить();
	Иначе
		ТекДок = Документы.УстановкаСоставаИндекса.СоздатьДокумент();
		Текдок.Индекс = Индекс;
		ТекДок.Дата = Дата;
		//ТекДок.Комментарий = ПАТЕРН_ОТБОРА;
		Возврат ТекДок;                                                                   
	КонецЕсли;
	
	Возврат ТекДок;
	       
КонецФункции

