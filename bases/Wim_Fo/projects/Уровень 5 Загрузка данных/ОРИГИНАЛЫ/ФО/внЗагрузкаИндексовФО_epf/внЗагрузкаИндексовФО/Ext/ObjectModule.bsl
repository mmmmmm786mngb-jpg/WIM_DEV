Функция ВалютаПокоду(КодВалюты, КэшВалют)
	
	ссВалюта = КэшВалют[КодВалюты];
	
	Если ссВалюта = Неопределено Тогда
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("КодВалюты", КодВалюты);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	т.Ссылка
		|ИЗ
		|	Справочник.Валюты КАК т
		|ГДЕ
		|	т.Наименование = &КодВалюты";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ссВалюта = Выборка.Ссылка;
		Иначе
			ссВалюта = Справочники.Валюты.ПустаяСсылка();
		КонецЕсли;
		КэшВалют.Вставить(КодВалюты, ссВалюта);
	КонецЕсли;
	
	Возврат ссВалюта;
	
КонецФункции

Функция АктивыПоТикеру(КодЦБ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	АкцииБиржиЛистинга.Ссылка КАК Актив,
	               |	АкцииБиржиЛистинга.Тикер КАК Тикер,
	               |	АкцииБиржиЛистинга.Биржа КАК Биржа
	               |ИЗ
	               |	Справочник.Акции.БиржиЛистинга КАК АкцииБиржиЛистинга
	               |ГДЕ
	               |	АкцииБиржиЛистинга.Тикер = &КодЦБ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ОблигацииБиржиЛистинга.Ссылка,
	               |	ОблигацииБиржиЛистинга.Тикер,
	               |	ОблигацииБиржиЛистинга.Биржа
	               |ИЗ
	               |	Справочник.Облигации.БиржиЛистинга КАК ОблигацииБиржиЛистинга
	               |ГДЕ
	               |	ОблигацииБиржиЛистинга.Тикер = &КодЦБ";
	
	Запрос.УстановитьПараметр("КодЦБ", КодЦБ);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда Возврат Справочники.Активы.ПустаяСсылка(); КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Актив = АктивСервер.ПолучитьАктивПоОбъекту(Выборка.Актив);
	
	Возврат Актив;
	
КонецФункции

Функция ДанныеЧерезСервис(Определение, Корень)
	
	Прокси = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
	
	Прокси.IndexValue(Корень);
	
	Возврат Корень;
