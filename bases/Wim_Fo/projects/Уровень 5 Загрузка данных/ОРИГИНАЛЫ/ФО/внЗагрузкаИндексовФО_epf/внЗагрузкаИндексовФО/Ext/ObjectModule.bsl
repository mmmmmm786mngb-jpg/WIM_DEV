Функция ТестовыеДанные(Фабрика, Корень_ТИП)
	
	ФайлПример = ПолучитьИмяВременногоФайла("xml");
	
	Пример = ПолучитьМакет("ПримерОтвета");
	Пример.Записать(ФайлПример, КодировкаТекста.UTF8);
	
	Чтение	= Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлПример);
	
	Корень = Фабрика.ПрочитатьXML(Чтение, Корень_ТИП);
	
	Возврат Корень;
	
КонецФункции

Процедура ПрочитатьОбъекты(Знач Объекты, Отказ = Ложь)
	Если ЭтотОбъект.СервисИсточник = 0 Тогда
		ПрочитатьОбъектыAPI(Объекты, Отказ);
	Иначе
		ПрочитатьОбъектыTIB(Объекты, Отказ);
	КонецЕсли;
КонецПроцедуры // ПрочитатьОбъекты()

Процедура ПрочитатьОбъектыAPI(Знач Объекты, Отказ = Ложь)
	Перем КэшВалют;
	
	КэшВалют = Новый Соответствие();
	
	// Данные индексов
	Для Каждого ТекЗначение Из Объекты.IndexData Цикл
		НоваяСтрока = ЭтотОбъект.ДанныеИндексов.Добавить();
		НоваяСтрока.ДатаИндекса	 = ТекЗначение.IndexDate;
		НоваяСтрока.Открытие	 = КакЧисло(ТекЗначение.Open);
		НоваяСтрока.Максимум	 = КакЧисло(ТекЗначение.Maximum);
		НоваяСтрока.Минимум		 = КакЧисло(ТекЗначение.Minimum);
		НоваяСтрока.Закрытие	 = КакЧисло(ТекЗначение.Close);
		НоваяСтрока.Объем		 = КакЧисло(ТекЗначение.Volume);
		НоваяСтрока.Дюрация		 = КакЧисло(ТекЗначение.Duration);
		НоваяСтрока.Доходность	 = КакЧисло(ТекЗначение.Yield);
		НоваяСтрока.КодИндекса	 = ТекЗначение.Index;
		НоваяСтрока.Индекс		 = ИндексПокоду(СокрЛП(ТекЗначение.Index));
		НоваяСтрока.Валюта		 = ВалютаПокоду(СокрЛП(ТекЗначение.Currency), КэшВалют);
	КонецЦикла;
	
	// Составы индексов
	Для Каждого ТекСостав Из Объекты.IndexComposition Цикл
		ТекКодИндекса 	= ТекСостав.Index;
		ТекИндекс 		= ИндексПокоду(ТекКодИндекса);
		ДатаИндекса 	= ТекСостав.IndexDate;
		
		Для Каждого ТекЗначение Из ТекСостав.IndexStructure Цикл
			НоваяСтрока = ЭтотОбъект.СоставыИндексов.Добавить();
			НоваяСтрока.Тикер			 = ТекЗначение.Ticker;
			НоваяСтрока.Вес				 = КакЧисло(ТекЗначение.Weight);
			НоваяСтрока.FreeFloat		 = КакЧисло(ТекЗначение.FreeFloat);
			НоваяСтрока.ВесКоэффициента	 = КакЧисло(ТекЗначение.CoeffWeight);
			НоваяСтрока.ОбъемЭмиссии	 = КакЧисло(ТекЗначение.EmissionVolume);
			НоваяСтрока.Qo				 = КакЧисло(ТекЗначение.Qo);
			НоваяСтрока.Капитализация	 = КакЧисло(ТекЗначение.Capitalization);
			НоваяСтрока.Индекс			 = ТекИндекс;
			НоваяСтрока.КодИндекса		 = ТекКодИндекса;
			НоваяСтрока.Дата			 = ДатаИндекса;
			НоваяСтрока.Актив			 = АктивыПоТикеру(ТекЗначение.Ticker);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры // ПрочитатьОбъектыAPI()

Процедура ПрочитатьОбъектыTIB(Объекты, Отказ = Ложь)
	
	КэшВалют = новый Соответствие;
	//Данные индексов
	Для каждого ТекЗначение из Объекты.ДанныеИндекса Цикл
		НоваяСтрока = ДанныеИндексов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекЗначение);
		
		НоваяСтрока.КодИндекса = ТекЗначение.Индекс;
		НоваяСтрока.Индекс = ИндексПокоду(СокрЛП(ТекЗначение.Индекс));
		НоваяСтрока.Валюта = ВалютаПокоду(СокрЛП(ТекЗначение.Валюта), КэшВалют);
	Конеццикла;
	
	//Составы индексов
	Для каждого ТекСостав из Объекты.СоставыИндексов Цикл
		ТекКодИндекса 	= ТекСостав.Индекс;
		ТекИндекс 		= ИндексПокоду(ТекКодИндекса);
		ДатаИндекса 	= ТекСостав.ДатаИндекса;
		
		Для каждого ТекЗначение из ТекСостав.СтруктураИндекса Цикл
			НоваяСтрока = СоставыИндексов.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекЗначение);
			НоваяСтрока.Индекс 		= ТекИндекс;
			НоваяСтрока.КодИндекса 	= ТекКодИндекса;
			НоваяСтрока.Дата 		= ДатаИндекса;
			НоваяСтрока.Актив 		= АктивыПоТикеру(ТекЗначение.Тикер);
		Конеццикла;
	Конеццикла;
	
	Если Отказ тогда Возврат; КонецЕсли;
	
КонецПроцедуры // ПрочитатьОбъектыTIB()

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

Функция РассылкаСообщения(Знач ТемаСообщения, Знач ТекстСообщения, Знач ЕстьОшибки, Знач ЕстьПредупреждения)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НастройкаРассылки.СписокАдресов.Найти(Истина, "ВключенВРассылку") = Неопределено
		И НастройкаРассылки.СписокПользователей.Найти(Истина, "ВключенВРассылку") = Неопределено Тогда
			Возврат "Не установлен список рассылки";
	КонецЕсли;
	
	ПочтаОтправки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаРассылки, "УчетнаяЗаписьЭлектроннойПочты");
	
	Если Не ЗначениеЗаполнено(ПочтаОтправки) Тогда
		ПочтаОтправки = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
	КонецЕсли;
		
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
	ПараметрыПисьма.Тема = ?(ЕстьОшибки, "{FAIL} ", ?(ЕстьПредупреждения, "{WARN} ", "{OK} ")) + ТемаСообщения + ПропискаРассылки("r273");
	ПараметрыПисьма.Тело = ТекстСообщения;
	ПараметрыПисьма.Важность = ?(ЕстьОшибки Или ЕстьПредупреждения, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
	
	ПараметрыПисьма.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;
	
	СписокАдресов = "";
	Если НастройкаРассылки.РежимРассылки = 0 Тогда
		Для Каждого СтрТЧ Из НастройкаРассылки.СписокАдресов Цикл
			Если СтрТЧ.ВключенВРассылку Тогда
				СписокАдресов = СписокАдресов + СтрТЧ.Адрес + ",";
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого СтрТЧ Из НастройкаРассылки.СписокПользователей Цикл
			Если СтрТЧ.ВключенВРассылку Тогда
				Адрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(СтрТЧ.Пользователь, Справочники.ВидыКонтактнойИнформации.EmailПользователя, ТекущаяДата());
				СписокАдресов = СписокАдресов + Адрес + ",";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыПисьма.Кому = СписокАдресов;
	
	ПараметрыПисьма.Тело = ТекстСообщения;
	
	Попытка
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(ПочтаОтправки, ПараметрыПисьма);
		текстРассылки = "Рассылка завершена";
	Исключение
		текстРассылки = "Рассылка не удалась: "; 
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Для Каждого Элемент Из Сообщения Цикл
			текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
		КонецЦикла;
		ЗаписьЖурналаРегистрации(СведенияОВнешнейОбработке().Наименование, УровеньЖурналаРегистрации.Ошибка, , текстРассылки);
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат текстРассылки;
	
КонецФункции

#КонецОбласти

#Область ЗамерыПроизводительности

// IMDEV-9530: число индексов в запросе, записей данных индексов и записей состава для замеров чтения
// и записи. Заполняет переменную модуля ПоказателиЗамера по СписокИндексов, ДанныеИндексов, СоставыИндексов.
//
Процедура ЗаполнитьКоличествоЗаписейЗамера()
	
	ПоказателиЗамера.Индексов = СписокИндексов.Количество();
	ПоказателиЗамера.Записей = ДанныеИндексов.Количество();
	ПоказателиЗамера.ЗаписейСостава = СоставыИндексов.Количество();
	
КонецПроцедуры

// IMDEV-9530: комментарий замера загрузки индексов в формате "Показатель: значение; ...".
//
// Возвращаемое значение:
//  Строка - показатели из переменной модуля ПоказателиЗамера и источник из реквизита СервисИсточник
//
Функция КомментарийЗамера()
	
	Если СервисИсточник = 0 Тогда
		Источник = "MICROAPI";
	Иначе
		Источник = "TIBCO";
	КонецЕсли;
	
	Возврат "Индексов: " + Формат(ПоказателиЗамера.Индексов, "ЧН=0; ЧГ=0")
		+ "; Записей: " + Формат(ПоказателиЗамера.Записей, "ЧН=0; ЧГ=0")
		+ "; Записей состава: " + Формат(ПоказателиЗамера.ЗаписейСостава, "ЧН=0; ЧГ=0")
		+ "; Источник: " + Источник;
	
КонецФункции

