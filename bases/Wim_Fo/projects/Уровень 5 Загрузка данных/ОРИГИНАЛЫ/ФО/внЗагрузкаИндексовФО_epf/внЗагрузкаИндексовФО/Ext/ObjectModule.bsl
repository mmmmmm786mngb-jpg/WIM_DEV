Функция ЗаполнитьСписокИндексов() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Индексы.Ссылка КАК Индекс
	|ИЗ
	|	Справочник.Индексы КАК Индексы
	|ГДЕ
	|	НЕ Индексы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Индекс
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокИндексов.Добавить(Выборка.Индекс);
	КонецЦикла;
