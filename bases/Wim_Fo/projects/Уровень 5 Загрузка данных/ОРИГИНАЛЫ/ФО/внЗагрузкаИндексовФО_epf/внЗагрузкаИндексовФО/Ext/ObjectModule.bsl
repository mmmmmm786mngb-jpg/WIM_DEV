Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.1.1.12");
	
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.04";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = НСтр("ru = 'Загрузить индексы'");
	НоваяКоманда.Идентификатор = "ЗаполнитьWEB_VTB";
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = НСтр("ru = 'Загрузить индексы (в фоне)'");
	НоваяКоманда.Идентификатор = "ФоновоеВыполнение";
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда Возврат; КонецЕсли;
	
	// IMDEV-9530: замер всей загрузки индексов (ключевая операция ЗагрузкаИндексов)
	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	
	// Настройки
	ДополнительнаяОбработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ЭтотОбъект.Метаданные().Имя);
	Настройки = ДополнительнаяОбработка.ХранилищеНастроек.Получить();
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		УстановитьПользовательскиеНастройки(Настройки);
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	ЕстьПредупреждения = Ложь;
	
	ЭтотОбъект.ДатаНачала 		= НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, ТекущаяДата(), -1));
	ЭтотОбъект.ДатаОкончания 	= КонецДня(ЭтотОбъект.ДатаНачала);
	
	ТекстСообщения = "Источник: " + ?(ЭтотОбъект.СервисИсточник = 0, "MICROAPI", "TIBCO") + Символы.ПС;
	
	ТекстСообщения = ТекстСообщения + Символы.ПС + "СТАРТ " + ТекущаяДата() + Символы.ПС;
	Попытка
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + " Чтение...";
		ЗагрузитьОбъекты(ЕстьОшибки, ТекстСообщения, "");
		
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + " Запись...";
		СоздатьОбъекты(ЕстьОшибки, ЕстьПредупреждения, ТекстСообщения);
	Исключение
		ЕстьОшибки = Истина;
		ТекстСообщения = ТекстСообщения + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
	
	ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + ?(ЕстьОшибки, " Ошибка.",  " Успех!");
	ТекстСообщения = ТекстСообщения + Символы.ПС + Символы.ПС + "ФИНИШ " + ТекущаяДата();
	
	Тема = "Аванкор ФО: Загрузка индексов с " + Формат(ЭтотОбъект.ДатаНачала, "ДФ=yyyy-MM-dd; ДП=") + " по " + Формат(ЭтотОбъект.ДатаОкончания, "ДФ=yyyy-MM-dd; ДП=");
	РассылкаСообщения(
		Тема,
		ТекстСообщения,
		ЕстьОшибки,
		ЕстьПредупреждения
	);
	
	// IMDEV-9530: общий замер; при ошибке загрузки (ЕстьОшибки) не пишется, предупреждения сбоем не считаются
	Если НЕ ЕстьОшибки Тогда
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗагрузкаИндексов", НачалоЗамера,
			Макс(ПоказателиЗамера.Записей, 1), КомментарийЗамера());
	КонецЕсли;
	
КонецПроцедуры

