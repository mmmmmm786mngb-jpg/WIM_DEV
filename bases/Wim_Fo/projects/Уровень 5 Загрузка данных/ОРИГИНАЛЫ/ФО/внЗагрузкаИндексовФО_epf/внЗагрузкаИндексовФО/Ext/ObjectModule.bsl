Функция СериализоватьЗначениеВJSON(Знач Значение)
	Перем ЗаписьДанныхJSON, НастройкаСериализации;
	
	ЗаписьДанныхJSON = Новый ЗаписьJSON();
	ЗаписьДанныхJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON());
	
	НастройкаСериализации = Новый НастройкиСериализацииJSON();
	НастройкаСериализации.ВариантЗаписиДаты					 = ВариантЗаписиДатыJSON.ЛокальнаяДата;
	НастройкаСериализации.ФорматСериализацииДаты			 = ФорматДатыJSON.ISO;
	НастройкаСериализации.СериализовыватьМассивыКакОбъекты	 = Ложь;
	
	ЗаписатьJSON(ЗаписьДанныхJSON, Значение, НастройкаСериализации);
	
	Возврат ЗаписьДанныхJSON.Закрыть();
КонецФункции // СериализоватьЗначениеВJSON()

Функция ДесериализоватьЗначениеИзJSON(Знач ДанныеJSON, Знач ИменаСвойствСоЗначениямиДата = "", Знач Кодировка = "UTF-8")
	Перем ЧтениеДанныхJSON, Результат;
	
	ЧтениеДанныхJSON = Новый ЧтениеJSON();
	Если ТипЗнч(ДанныеJSON) = Тип("ДвоичныеДанные") Тогда
		ЧтениеДанныхJSON.ОткрытьПоток(ДанныеJSON.ОткрытьПотокДляЧтения(), Кодировка);
		
	ИначеЕсли ТипЗнч(ДанныеJSON) = Тип("Строка") Тогда
		ЧтениеДанныхJSON.УстановитьСтроку(ДанныеJSON);
		
	Иначе
		ЧтениеДанныхJSON.ОткрытьПоток(ДанныеJSON, Кодировка);
		
	КонецЕсли;
	
	Результат = ПрочитатьJSON(
		ЧтениеДанныхJSON,
		Ложь,
		ИменаСвойствСоЗначениямиДата
	);
	
	ЧтениеДанныхJSON.Закрыть();

	Возврат Результат;
КонецФункции // ДесериализоватьЗначениеИзJSON()

Функция КакЧисло(Знач ЧислоСтрокой)
	Перем Результат, ТипЧисло, ПозицияЕ, ЧислоДоЕ, ЧислоПослеЕ;
	
	ЧислоСтрокой = СокрЛП(ВРег(ЧислоСтрокой));
	ЧислоСтрокой = СокрЛП(СтрЗаменить(ЧислоСтрокой, Символы.НПП, ""));
	ЧислоСтрокой = СокрЛП(СтрЗаменить(ЧислоСтрокой, " ", ""));
	
	Результат = 0;
	
	Если ПустаяСтрока(ЧислоСтрокой) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если СтрДлина(ЧислоСтрокой) > 0 Тогда
		ТипЧисло = Новый ОписаниеТипов("Число");
		
		ПозицияЕ = СтрНайти(ЧислоСтрокой, "E");
		Если ПозицияЕ = 0 Тогда
			// Ведущие нули
			Позиция = 1;
			Пока Сред(ЧислоСтрокой, Позиция, 1) = "0" Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			ЧислоСтрокой = Сред(ЧислоСтрокой, Позиция);
			
			Результат = ТипЧисло.ПривестиЗначение(ЧислоСтрокой);
		Иначе
			ЧислоДоЕ	 = ТипЧисло.ПривестиЗначение(Лев(ЧислоСтрокой, ПозицияЕ - 1));
			ЧислоПослеЕ	 = ТипЧисло.ПривестиЗначение(Сред(ЧислоСтрокой, ПозицияЕ + 1));
			
			Результат = ЧислоДоЕ * Pow(10, ЧислоПослеЕ);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции // КакЧисло()

Функция ПолучитьДанныеИзСервиса(Знач ВнешнийСервис, Знач АдресРесурса, Знач ТелоЗапроса, Знач Таймаут = 120)
	Перем СтруктураURI, Хост, Порт, Протокол, Пользователь, Пароль, ЗащищенноеСоединение, Прокси, ИспользоватьАутентификациюОС;
	Перем СоединениеHTTP, ЗапросHTTP, ОтветHTTP;
	Перем Результат;
	
	Результат = Новый Структура("Данные, ЗапросВыполнен, ТекстОшибки", Неопределено, Ложь, "");
	
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(ВнешнийСервис.Адрес);
	
	Хост		 = СтруктураURI.Хост;
	Порт		 = СтруктураURI.Порт;
	Протокол	 = СтруктураURI.Схема;
	Прокси		 = Неопределено;
	Пользователь = Неопределено;
	Пароль		 = Неопределено;
	ИспользоватьАутентификациюОС = Ложь;
	
	Если ПустаяСтрока(Протокол) Тогда 
		Протокол = "http";
	КонецЕсли;
	
	Если (Протокол = "https") Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
		
	Иначе
		ЗащищенноеСоединение = Неопределено;
		
	КонецЕсли;
	
	ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса);
	ЗапросHTTP.Заголовки.Вставить("Accept-Charset", "UTF-8");
	ЗапросHTTP.Заголовки.Вставить("Cache-Control", "no-cache");
	ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json");
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
	
	Попытка
		СоединениеHTTP = Новый HTTPСоединение(
			Хост,
			Порт,
			Пользователь,
			Пароль,
			Прокси,
			Таймаут,
			ЗащищенноеСоединение,
			ИспользоватьАутентификациюОС
		);
		
		ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
	Исключение
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось установить соединение с сервером %1:%2 с ошибкой:
			|%3'"),
			Хост,
			Формат(Порт, "ЧН=<пусто>; ЧГ="),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		
		Возврат Результат;
	КонецПопытки;
	
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Запрос ""%1"" не выполнен. Код состояния: %2'"),
			ЗапросHTTP.АдресРесурса,
			ОтветHTTP.КодСостояния
		) + Символы.ПС + Прав(СокрЛП(ОтветHTTP.ПолучитьТелоКакСтроку()), 256);
		
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЗапросВыполнен = (ОтветHTTP.КодСостояния = 200);
	Результат.Данные		 = ДесериализоватьЗначениеИзJSON(ОтветHTTP.ПолучитьТелоКакСтроку(), "IndexDate");
	
	Возврат Результат;
КонецФункции // ПолучитьДанныеИзСервиса()

Процедура ЗагрузитьОбъекты(Отказ = Ложь, ТекстОшибки = "", Знач СписокИнд = "") Экспорт
	// IMDEV-9530: замер шага чтения индексов
	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	ЭтотОбъект.ДанныеИндексов.Очистить();
	ЭтотОбъект.СоставыИндексов.Очистить();
	
	Если ЭтотОбъект.СервисИсточник = 0 Тогда
		ЗагрузитьОбъектыAPI(Отказ, ТекстОшибки, СписокИнд);
	Иначе
		ЗагрузитьОбъектыTIB(Отказ, ТекстОшибки, СписокИнд);
	КонецЕсли;
	
	// IMDEV-9530: шаг чтения, вес - записи данных индексов; при ошибке (Отказ) замер не пишется
	Если НЕ Отказ Тогда
		ЗаполнитьКоличествоЗаписейЗамера();
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗагрузкаИндексов.Чтение", НачалоЗамера,
			Макс(ПоказателиЗамера.Записей, 1), КомментарийЗамера());
	КонецЕсли;
КонецПроцедуры // ЗагрузитьОбъекты()

Процедура ЗагрузитьОбъектыAPI(Отказ = Ложь, ТекстОшибки = "", Знач СписокИнд = "") Экспорт
	Перем ВнешнийСервис;
	Перем ПараметрыЗапроса, МассивИндексов, Индексы;
	Перем Результат;
	
	ВнешнийСервис = ПрочитатьВнешнийСервис();
	Если ВнешнийСервис = Неопределено Тогда
		Сообщить("Не удалось получить параметры внешнего сервиса!", СтатусСообщения.ОченьВажное);
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	Если СписокИнд = "" Тогда
		ЗаполнитьСписокИндексов();
	КонецЕсли;
	
	МассивИндексов = Новый Массив();
	
	Для Каждого Стр Из ЭтотОбъект.СписокИндексов Цикл
		МассивИндексов.Добавить(СокрЛП(Строка(Стр.Значение.КодИндекса)));
	КонецЦикла;
	
	Индексы = СтрСоединить(МассивИндексов, ",");
	Индексы = Индексы + ?(НЕ СтрЗаканчиваетсяНа(Индексы, ","), ",", "");
	
	ПараметрыЗапроса = Новый Структура(
		"DateFrom, DateTo, Indexes",
		Формат(ЭтотОбъект.ДатаНачала, "ДФ=yyyy-MM-dd; ДП="),
		Формат(ЭтотОбъект.ДатаОкончания, "ДФ=yyyy-MM-dd; ДП="),
		Индексы
	);
	
	Результат = ПолучитьДанныеИзСервиса(ВнешнийСервис, "/getIndexValue", СериализоватьЗначениеВJSON(ПараметрыЗапроса));
	
	Если НЕ Результат.ЗапросВыполнен Тогда
		Сообщить("Не удалось получить данные из внешнего сервиса! Текст ошибки: " + Результат.ТекстОшибки, СтатусСообщения.ОченьВажное);
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	ПрочитатьОбъекты(Результат["Данные"]);
КонецПроцедуры // ЗагрузитьОбъектыAPI()

Процедура ЗагрузитьОбъектыTIB(Отказ = Ложь, ТекстОшибки = "",СписокИнд="") Экспорт
	ОсновноеПространствоИмен = "http://www.avancore.ru/indexes"; 
	
	Попытка 
		Определение = Новый WSОпределения("http://amaptibco:8881/");
		//Определение = Новый WSОпределения("http://dmsk6219:8881/");
		
		Фабрика = Определение.ФабрикаXDTO;
		
		Корень_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "Корень");
		Условия_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "УсловиеИндекса");
		Корень 		= Фабрика.Создать(Корень_ТИП);
		Условия 	= Фабрика.Создать(Условия_ТИП);
		
		Условия.DateFrom 	= ДатаНачала;
		Условия.DateTo 		= ДатаОкончания;
		
		Если СписокИнд = "" Тогда
			ЗаполнитьСписокИндексов();
		КонецЕсли;
		
		МассивИндексов = Новый Массив;
			
		Для Каждого Стр Из СписокИндексов Цикл
			МассивИндексов.Добавить(СокрЛП(Строка(Стр.Значение.КодИндекса)));
		КонецЦикла;
			
		Индексы = СтрСоединить(МассивИндексов, ",");
		Индексы = Индексы + ?(НЕ СтрЗаканчиваетсяНа(Индексы, ","), ",", "");
			
		Условия.IndexList = Индексы;
		
		Корень.УсловиеИндекса = Условия;
		
		Если ТестовыйРежим тогда
			Ответ = ТестовыеДанные(Фабрика, Корень_ТИП);
		Иначе
			Ответ = ДанныеЧерезСервис(Определение, Корень);
		КонецЕсли;
		
	Исключение
		ТекстОшибки = ""+ОписаниеОшибки();
		сообщить(ТекстОшибки);
		Отказ = Истина;
		
	КонецПопытки;
	
	Если Отказ=Истина Тогда возврат; КонецЕсли;
	
	ПрочитатьОбъекты(Ответ);
	
КонецПроцедуры // ЗагрузитьОбъектыTIB()

Процедура СоздатьОбъекты(Отказ, ЕстьПредупреждения, ТекстСообщения = "") Экспорт
	
	// IMDEV-9530: замер шага записи индексов; показатели - до очистки таблиц при записи
	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	ЗаполнитьКоличествоЗаписейЗамера();
	
	СоздатьДанныеИндексов(Отказ, ЕстьПредупреждения, ТекстСообщения);
	СоздатьСоставыИндексов(Отказ, ЕстьПредупреждения, ТекстСообщения);
	
	// IMDEV-9530: шаг записи, вес - записи данных индексов; после ошибки чтения (Отказ) замер не пишется
	Если НЕ Отказ Тогда
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗагрузкаИндексов.Запись", НачалоЗамера,
			Макс(ПоказателиЗамера.Записей, 1), КомментарийЗамера());
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьДанныеИндексов(Отказ = Ложь, ЕстьПредупреждения = Ложь, ТекстСообщения = "") Экспорт
	
//	МассивУдаляемых = Новый Массив;

	Лог = Новый ТабличныйДокумент;
	Лог.ОтображатьГруппировки 	= Ложь;
	Лог.ОтображатьСетку 		= Ложь;
	Лог.ОтображатьЗаголовки 	= Ложь;

	Макет = ПолучитьМакет("Лог");
	Заголовок = Макет.ПолучитьОбласть("Заголовок");
	Лог.Вывести(Заголовок);
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.ДатаНачала 			= ДатаНачала;
	Шапка.Параметры.ДатаОкончания 		= ДатаОкончания;
	Шапка.Параметры.ДатаФормирования 	= ТекущаяДата();
	Лог.Вывести(Шапка);
	
	ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	Лог.Вывести(ЗаголовокТаблицы);
	
	СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы");
	
	Счетчик = 0;
	
	Для каждого ТекДанные из ДанныеИндексов Цикл
		Если ТекДанные.Индекс.Пустая() тогда Продолжить; КонецЕсли;
		
		Счетчик = Счетчик+1;
		
		НоваяЗапись = РегистрыСведений.ДанныеИндекса.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДанные);
		НоваяЗапись.ДатаИндекса = ТекДанные.ДатаИндекса;
		
		НоваяЗапись.Комментарий = ПАТЕРН_ОТБОРА;
		
		НоваяЗапись.Записать();
		
		СтрокаТаблицы.Параметры.Заполнить(ТекДанные);
		Лог.Вывести(СтрокаТаблицы);
		
	//	МассивУдаляемых.Добавить(ТекДанные);
	Конеццикла;
	
	//Для каждого Элемент из МассивУдаляемых Цикл
	//	ДанныеИндексов.Удалить(Элемент);
	//	
	//Конеццикла;
	
	Если Счетчик = 0 Тогда
		ЕстьПредупреждения = Истина;
	КонецЕсли;
	
	ТекстСообщения = ТекстСообщения + "
	|Заполнение регистра ""Данные индекса""
	|прочитано записей: "+ДанныеИндексов.Количество() + "
	|записано записей: "+Счетчик;
	
	ДанныеИндексов.Очистить();
	
	Сообщить("Импорт данных индексов завершен", СтатусСообщения.Информация);
	
КонецПроцедуры

Процедура СоздатьСоставыИндексов(Отказ = Ложь, ЕстьПредупреждения = Ложь, ТекстСообщения = "") Экспорт
	
	Если Отказ Тогда Возврат; Конецесли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Источник", СоставыИндексов.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ Составы
	|ИЗ
	|	&Источник КАК Источник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	Составы КАК Составы
	|ИТОГИ
	|	
	|ПО
	|	Составы.Дата,
	|	Составы.Индекс";
	
	ГруппаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Счетчик = 0;
	СчетчикПрочитаноЗаписей = 0;
	СчетчикЗаписаноЗаписей = 0;
	Пока ГруппаДата.Следующий() Цикл
		
		ГруппаИндекс = ГруппаДата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ГруппаИндекс.Следующий() Цикл
			Если ГруппаИндекс.Индекс.Пустая() Тогда Продолжить; КонецЕсли;
			
			ТекДок = СоставПоДатеИндексу(ГруппаДата.Дата, ГруппаИндекс.Индекс);
			
			Счетчик = Счетчик+1;
			
			Детали = ГруппаИндекс.Выбрать();
			Пока Детали.Следующий() Цикл
				
				СчетчикПрочитаноЗаписей = СчетчикПрочитаноЗаписей+1;
				
				Если ЗначениеЗаполнено(Детали.Актив) Тогда
					СчетчикЗаписаноЗаписей = СчетчикЗаписаноЗаписей+1;
					
					НоваяСтрока = ТекДок.СоставИндекса.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Детали);
				КонецЕсли;
				
			Конеццикла;
			
			Сообщение = Новый СообщениеПользователю;
			
			Попытка
				ТекДок.Записать(РежимЗаписиДокумента.Проведение);
				Сообщение.Текст = "Проведен документ: " + ТекДок.Ссылка;

			Исключение
				ТекстОшибки = "Не удалось провести документ: "+ТекДок+ " "+ОписаниеОшибки()+" .Документ записан";
				ТекДок.Записать(РежимЗаписиДокумента.Запись);
				Сообщение.Текст = ТекстОшибки;
				
			КонецПопытки;
			
			Сообщение.КлючДанных = ТекДок.Ссылка;
			Сообщение.Сообщить();
			
		КонецЦикла;
	Конеццикла;
	
	Если Счетчик = 0 Тогда
		ЕстьПредупреждения = Истина;
	КонецЕсли;
	
	ТекстСообщения = ТекстСообщения + "
	|Создание(перезаполнение) документов ""Установка состава индекса""
	|создано документов: "+Счетчик + "
	|прочитано записей: "+СчетчикПрочитаноЗаписей + "
	|записано записей: "+СчетчикЗаписаноЗаписей;
	
	СоставыИндексов.Очистить();
КонецПроцедуры

#КонецОбласти

