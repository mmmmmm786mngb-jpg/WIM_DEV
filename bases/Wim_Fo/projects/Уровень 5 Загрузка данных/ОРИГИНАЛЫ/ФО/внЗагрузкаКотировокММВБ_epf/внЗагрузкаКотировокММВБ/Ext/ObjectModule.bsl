		ТекстСравненияОбновившихся = ТекстСравненияОбновившихся();
		ЗадачаОписание = ЗадачаОписание + Символы.ПС + ТекстСравненияОбновившихся;
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекстСравненияОбновившихся;
		//IMAPPS-21377--		
