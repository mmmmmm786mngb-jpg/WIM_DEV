//IMAPPS-21377++
Функция ТекстСравненияОбновившихся()
	//Получим текущий срез котировок и сверим сколько сейчас загружено, а сколько за прошлые периоды
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА КотировкиЦБНаБиржеСрезПоследних.Период = &ПредыдущийРабочийДень
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоПредыдущийРабочийДень,
	|	СУММА(ВЫБОР
	|			КОГДА КотировкиЦБНаБиржеСрезПоследних.Период = &Период
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Количество
	|ИЗ
	|	РегистрСведений.КотировкиЦБНаБирже.СрезПоследних(&Период, НЕ Биржа = &Биржа) КАК КотировкиЦБНаБиржеСрезПоследних";
	
	ПредыдущийРабочийДень = КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(, ДатаНачала, -1);
	
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень",ПредыдущийРабочийДень);
	Запрос.УстановитьПараметр("Период",ДатаНачала);
	Запрос.УстановитьПараметр("Биржа",ОсновнаяБиржаРепрайсинга);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	
	ВыгруженоВсего = 0;
	ВыгруженоЗаПредыдущийРабочийДень = 0;
	Если Выборка.Следующий() и не Выборка.Количество = NULL Тогда
		ВыгруженоВсего = Выборка.Количество;
		ВыгруженоЗаПредыдущийРабочийДень = Выборка.КоличествоПредыдущийРабочийДень;
	КонецЕсли;
	
	ПроцентВыгруженных = ?(ВыгруженоВсего = 0, 0, Окр(ВыгруженоЗаПредыдущийРабочийДень / ВыгруженоВсего * 100, 2));
	
	Возврат "Всего загружено котировок: " + ВыгруженоВсего + ". Не обновились котировки с прошлого рабочего дня: " + ВыгруженоЗаПредыдущийРабочийДень
		+ ". Соотношение, %: " + ПроцентВыгруженных
	
	
КонецФункции
