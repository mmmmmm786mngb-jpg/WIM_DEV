		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + " Чтение...";
		ЗагрузитьОбъекты(Отказ, ТекстСообщения);
		
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяДата() + " Запись...";
		СоздатьОбъекты(Отказ, ТекстСообщения);
