	//			НоваяСтрока.ВалютаКотировки = Справочники.Валюты.RUB;
	//		иначе
	//			НоваяСтрока.ВалютаКотировки = НоваяСтрока.Актив.Объект.ВалютаНоминальнойСтоимости;
	//		КонецЕсли;
	//		
	//	КонецЕсли;
	//КонецЕсли;
	//
	//// НоваяСтрока.Валюта = Детали.ВалютаКотировки;
	//Если НоваяСтрока.Актив.ВидАктива.Родитель = ПланыВидовХарактеристик.ВидыАктивов.Облигации и Биржа.Иностранная = истина Тогда
	//	НоваяСтрока.ВалютаКотировки = НоваяСтрока.Актив.Объект.ВалютаНоминальнойСтоимости;
	//КонецЕсли; 
	////НоваяСтрока.НомерМетодаРасчета = ТекКотировка.method_number;

	СтрокаТаблицыЛога.Параметры.Заполнить(ТекКотировка);
	СтрокаТаблицыЛога.Параметры.Актив = Тикер;
	СтрокаТаблицыЛога.Параметры.АктивРасшифровка = Актив;
	СтрокаТаблицыЛога.Параметры.ВалютаКотировки = НоваяСтрока.ВалютаКотировки.Наименование;
	СтрокаТаблицыЛога.Параметры.Дата = ДатаДок;
	СтрокаТаблицыЛога.Параметры.Биржа = БиржаКод;
	СтрокаТаблицыЛога.Параметры.БиржаРасшифровка = Биржа;
	СтрокаТаблицыЛога.Параметры.Статус = "";
	
	Если НоваяСтрока.Биржа_Код = "ММВБ" Тогда
		Если ЗначениеЗаполнено(НоваяСтрока.РыночнаяЦена2) тогда
			НоваяСтрока.ПризнаваемаяКотировка = НоваяСтрока.РыночнаяЦена2;
			СтрокаТаблицыЛога.Параметры.ПризнаваемаяКотировка = СтрокаТаблицыЛога.Параметры.РыночнаяЦена2;
		ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.РыночнаяЦена3) тогда
		    НоваяСтрока.ПризнаваемаяКотировка = НоваяСтрока.РыночнаяЦена3;
			СтрокаТаблицыЛога.Параметры.ПризнаваемаяКотировка = СтрокаТаблицыЛога.Параметры.РыночнаяЦена3;
		Иначе
			НоваяСтрока.ПризнаваемаяКотировка = НоваяСтрока.ПризнаваемаяКотировка;
			СтрокаТаблицыЛога.Параметры.ПризнаваемаяКотировка = СтрокаТаблицыЛога.Параметры.ПризнаваемаяКотировка;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

Функция РассылкаСообщения(Знач ТемаСообщения, Знач ТекстСообщения, Знач ЕстьОшибки)
	
	Если СписокРассылки.Количество()>0 и НЕ ПочтовыйЛогин.Пустая() тогда
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность, ИмяОтправителя");
		ПараметрыПисьма.Тема = ?(ЕстьОшибки, "{FAIL} ", "{OK} ") + ТемаСообщения + ПропискаРассылки("r195");
		ПараметрыПисьма.Тело = ТекстСообщения;
		ПараметрыПисьма.Важность = ?(ЕстьОшибки, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылки Цикл
			Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
		
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.ТипТекста = "HTML";
		ПараметрыПисьма.Тело = РассылкаСообщенияТаблица(ТекстСообщения);
		
		Попытка
			Письмо = РаботаСПочтовымиСообщениями.ПодготовитьПисьмо(ПочтовыйЛогин,ПараметрыПисьма);
			РаботаСПочтовымиСообщениями.ОтправитьПисьмо(ПочтовыйЛогин, Письмо);
			текстРассылки = "Рассылка завершена";
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			текстРассылки = "Рассылка не удалась: "; 
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Для Каждого Элемент из Сообщения Цикл
				текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
			КонецЦикла;
			
			текстРассылки = текстРассылки + Символы.ПС + ОписаниеОшибки;
			
		КонецПопытки;
		
		Возврат текстРассылки;
	КонецЕсли;
	
	Возврат "Не установлен список рассылки";
КонецФункции

Функция РассылкаСообщенияТаблица(ТекстСообщения)
	Х =	"";
	Х =	Х + "<html><head><meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" /></head>"+
	"<body style=""font-family:Arial, Helvetica, sans-serif;color:black;"">"+
	"<b>"+ТекстСообщения+"</b><br/><br/>";
	Х =	Х + "<table BORDERCOLOR=""Black"" border-style= ""solid"" border-collapse =""collapse"" border=""1"">"+
	"<tr>"+
	"<th align=""center"" bgcolor=""#C0C0C0"">Дата</th>"+
	"<th align=""center"" bgcolor=""#C0C0C0"">Биржа</th>"+
	"<th align=""center"" bgcolor=""#C0C0C0"">Загружено объектов</th>"+
	"</tr>";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КотировкиЦБНаБиржеКотировки.Ссылка.Дата КАК Дата,
	|	КотировкиЦБНаБиржеКотировки.Ссылка.Биржа КАК Биржа,
	|	КОЛИЧЕСТВО(КотировкиЦБНаБиржеКотировки.НомерСтроки) КАК Колво
	|ИЗ
	|	Документ.КотировкиЦБНаБирже.Котировки КАК КотировкиЦБНаБиржеКотировки
	|ГДЕ
	|	КотировкиЦБНаБиржеКотировки.Ссылка.Проведен = ИСТИНА
	|	И КотировкиЦБНаБиржеКотировки.Ссылка.Дата МЕЖДУ &Дата1 И &Дата2
	|	И НЕ КотировкиЦБНаБиржеКотировки.Ссылка.Биржа = &ОсновнаяБиржаРепрайсинга //IMAPPS-21377
	|
	|СГРУППИРОВАТЬ ПО
	|	КотировкиЦБНаБиржеКотировки.Ссылка.Биржа,
	|	КотировкиЦБНаБиржеКотировки.Ссылка.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Биржа";
	Запрос.УстановитьПараметр("Дата1", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("Дата2", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ОсновнаяБиржаРепрайсинга", ОсновнаяБиржаРепрайсинга); //IMAPPS-21377
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Х =	Х + "<tr>"+
		"<td>"+Формат(ВыборкаДетальныеЗаписи.Дата,"ДФ=dd.MM.yyyy")+"</td>"+
		"<td>"+ВыборкаДетальныеЗаписи.Биржа+"</td>"+
		"<td>"+Строка(ВыборкаДетальныеЗаписи.Колво)+"</td>"+
		"</tr>"+Символы.ПС;
	КонецЦикла;
	
	Х =	Х + "</table>";
	Х =	Х + "</body></html>";
	
	Возврат Х;
КонецФункции

#Область ЗамерыПроизводительности

// IMDEV-9530: число котировок к загрузке и котировок с найденным активом для замеров чтения и записи.
// Заполняет Котировок и Активов в переменной модуля ПоказателиЗамера по табличной части СписокЗагрузки.
//
Процедура ЗаполнитьКоличествоКотировокЗамера()
	
	ПоказателиЗамера.Котировок = СписокЗагрузки.Количество();
	БезАктива = СписокЗагрузки.НайтиСтроки(Новый Структура("Актив", Справочники.Активы.ПустаяСсылка()));
	ПоказателиЗамера.Активов = ПоказателиЗамера.Котировок - БезАктива.Количество();
	
КонецПроцедуры

// IMDEV-9530: комментарий замера загрузки котировок в формате "Показатель: значение; ...".
//
// Параметры:
//  СДокументами - Булево - вывести число записанных документов котировок
//  СПериодом    - Булево - вывести период загрузки
//
// Возвращаемое значение:
//  Строка - показатели из переменной модуля ПоказателиЗамера и период из реквизитов обработки
//
Функция КомментарийЗамера(СДокументами, СПериодом)
	
	Части = Новый Массив;
	Части.Добавить("Котировок: " + Формат(ПоказателиЗамера.Котировок, "ЧН=0; ЧГ=0"));
	Части.Добавить("Активов: " + Формат(ПоказателиЗамера.Активов, "ЧН=0; ЧГ=0"));
	Если СДокументами Тогда
		Части.Добавить("Документов: " + Формат(ПоказателиЗамера.Документов, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Если СПериодом Тогда
		Части.Добавить("Период: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Возврат СтрСоединить(Части, "; ");
	
КонецФункции

