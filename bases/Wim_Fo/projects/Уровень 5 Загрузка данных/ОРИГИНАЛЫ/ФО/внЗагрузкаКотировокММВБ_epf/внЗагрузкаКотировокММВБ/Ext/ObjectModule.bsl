Процедура ПрочитатьКотировки(ДокументыКотировок, Отказ = Ложь)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицыЛога = Макет.ПолучитьОбласть("СтрокаТаблицы");
	
	СписокЗагрузки.Очистить();
	
	таб = СписокЗагрузки.Выгрузить();
	таб.Очистить();
	таб.Колонки.Добавить("Валюта_Код", ОбщегоНазначения.ОписаниеТипаСтрока(3));
	
	Для каждого ТекДок из ДокументыКотировок Цикл
		
		БиржаКод 	= ТекДок.Биржа.Наименование;
		ДатаДок 	= ТекДок.Дата;
		Если не БиржаКод = "ММВБ" Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ТекКотировка из ТекДок.Состав.СтрокаКотировок Цикл
			НовСтрока = таб.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, ТекКотировка);
			НовСтрока.Дата 		= ДатаДок;
			НовСтрока.Биржа_Код = БиржаКод;
			НовСтрока.Актив_Код = ТекКотировка.Актив.КодЦБнаММВБ;
			НовСтрока.Валюта_Код = ТекКотировка.ВалютаКотировки.КодВалюты;
			
			НовСтрока.УровеньКотировальногоЛиста = УровеньПоКоду(ТекКотировка.УровеньКотировальногоЛиста);
	
		Конеццикла;
		
	Конеццикла;
	
	Выборка = ДополнитьТаблицуСсылками(таб);
	
	Повтор = Ложь;
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Актив) тогда 
			ДобавитьКотировку(Выборка, Выборка.Дата, Выборка.Тикер, Выборка.Биржа_Код, Выборка.Актив, Выборка.Биржа, СтрокаТаблицыЛога);
			Если Повтор = Истина тогда
				СтрокаТаблицыЛога.Параметры.Статус = "Повтор котировки";
			КонецЕсли;
		Иначе
			ДобавитьКотировку(Выборка, Выборка.Дата, Выборка.Тикер, Выборка.Биржа_Код, , ,СтрокаТаблицыЛога);
			СтрокаТаблицыЛога.Параметры.Статус = "Актив не найден";
		КонецЕсли;
		
		Лог.Вывести(СтрокаТаблицыЛога);
		
	Конеццикла;
	
КонецПроцедуры 

