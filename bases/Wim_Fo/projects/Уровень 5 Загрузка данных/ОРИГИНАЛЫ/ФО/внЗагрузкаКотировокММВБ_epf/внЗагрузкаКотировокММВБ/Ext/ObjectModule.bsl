Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	
	ДатаНачала 		= НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(,ТекущаяДата(),-1));
	ДатаОкончания 	= КонецДня(ТекущаяДата()-60*60*24);
	
	ДопОбработка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
	
	НастройкиВыполнения = Неопределено;
	ХранилищеНастроек = ДопОбработка.ХранилищеНастроек;
	
	Если ТипЗнч(ХранилищеНастроек) = Тип("ХранилищеЗначения") Тогда
		НастройкиВыполнения = ХранилищеНастроек.Получить();
	КонецЕсли;
	
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда  
		Возврат "<Настройки не установлены>"; 
	КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда  
		Возврат; 
	КонецЕсли;

	Настройки.Свойство("ОбработкаЗагрузкиАктивов", ОбработкаЗагрузкиАктивов);
	Настройки.Свойство("КомандаЗагрузкиАктивов", КомандаЗагрузкиАктивов); 
	
	//IMAPPS-21377++
	Настройки.Свойство("ОсновнаяБиржаРепрайсинга", ОсновнаяБиржаРепрайсинга);
	//IMAPPS-21377--
	
	Почта = Неопределено;
	Если Настройки.Свойство("ПочтовыйЛогин", ПочтовыйЛогин) Тогда 
		Ящики = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.СписокРассылки);
		СписокРассылки.Загрузить(Ящики.Получить());
	КонецЕсли;
	ПредставлениеНастроек = "Период с:"+Формат(ДатаНачала,"ДФ=dd.MM.yyyy") + " по:"+Формат(ДатаОкончания,"ДФ=dd.MM.yyyy") + " ";

КонецПроцедуры

#Область DevOps

Процедура ЗагрузитьНастройки(ПараметрыРегистрации) Экспорт
	
	ВерсияПрименения = "2.40";
	ТекущаяРегистрация = СведенияОВнешнейОбработке();
	
	Если ВерсияПрименения = ТекущаяРегистрация.Версия Тогда
		
		ПараметрыРегистрации.Вставить("ЗагружатьНастройки", Истина);
		
		НастройкиПоУмолчанию(ЭтотОбъект);
		
		ЗаголовокНастроек = "";
		ЗначенияПараметров = УстановитьПараметры(ЗаголовокНастроек);
		
		ПараметрыРегистрации.Вставить("Настройки", Новый Структура("Значения, ЗаголовокНастроек", ЗначенияПараметров, ЗаголовокНастроек));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура НастройкиПоУмолчанию(Объект) Экспорт
	
	Объект.ПочтовыйЛогин = Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты;
	
	Объект.СписокРассылки.Очистить();
	
	НоваяПочта = Объект.СписокРассылки.Добавить();
	НоваяПочта.ПочтовыйЯщик = "VTBAMMiddleoffice@vtbcapital.com";
	
	НоваяПочта = Объект.СписокРассылки.Добавить();
	НоваяПочта.ПочтовыйЯщик = "IMAppSupport@vtbcapital.com";
	
	Объект.ОбработкаЗагрузкиАктивов = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	Объект.КомандаЗагрузкиАктивов = "";
	Объект.ТестовыйРежим = Ложь;
	
	//IMAPPS-21377++
	Объект.ОсновнаяБиржаРепрайсинга = Справочники.Биржи.НайтиПоНаименованию("ОсновнаяБиржаРепрайсинга");
	//IMAPPS-21377--
		
КонецПроцедуры

Функция УстановитьПараметры(ЗаголовокНастроек) Экспорт
	
	Значения = Новый Структура();      
	Значения.Вставить("ПочтовыйЛогин", ЭтотОбъект.ПочтовыйЛогин);
	Значения.Вставить("ОбработкаЗагрузкиАктивов", ЭтотОбъект.ОбработкаЗагрузкиАктивов);
	Значения.Вставить("КомандаЗагрузкиАктивов", ЭтотОбъект.КомандаЗагрузкиАктивов);
	Значения.Вставить("ТестовыйРежим", ЭтотОбъект.ТестовыйРежим);
	Значения.Вставить("СписокРассылки", XMLСтрока(Новый ХранилищеЗначения(ЭтотОбъект.СписокРассылки.Выгрузить())));
	
	//IMAPPS-21377++
	Значения.Вставить("ОсновнаяБиржаРепрайсинга", ЭтотОбъект.ОсновнаяБиржаРепрайсинга);
	//IMAPPS-21377--
	
	ПредставлениеПочты = ?(ЭтотОбъект.СписокРассылки.Количество()>0, ", Установлен список рассылки","");
	
	ЗаголовокНастроек = СокрЛП(ПредставлениеПочты);
	
	Возврат Значения;
	
КонецФункции

#КонецОбласти

//ПРОЦЕДУРЫ ОБЩЕГО НАЗНАЧЕНИЯ//////////////////////////////////////////////////////////////

Функция АктивыПоТикеру(Знач КодЦБ, Знач БиржаКод)
	Перем БиржаНРД;
	Перем Запрос, Результат, Выборка;
	Перем Тикер;
	
	Запрос = Новый Запрос();
	
	Если Найти(ВРег(БиржаКод), ВРег("РасчетныеНРД")) > 0 Тогда
		//Чтобы не заставлять пользователей проставлять тиккеры для ЦЦЦ, ищем  по ISIN
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Активы.Ссылка.Объект КАК Актив,
		|	Активы.Объект.ISIN КАК КодЦБ,
		|	&БиржаНРД КАК БиржаЛистинга
		|ИЗ
		|	Справочник.Активы КАК Активы
		|ГДЕ
		|	НЕ Активы.ПометкаУдаления
		|	И Активы.Объект.ISIN = &КодЦБ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Актив,
		|	КодЦБ,
		|	БиржаЛистинга";
		
		Запрос.УстановитьПараметр("БиржаНРД", БиржаНРД);
		
	ИначеЕсли Найти(ВРег(КодЦБ), ВРег("@BVAL Corp ")) > 0 Тогда
		//XS1057929645@BVAL Corp
		//XS1057929645@BVAL Corp USD

		Тикер = Лев(КодЦБ, Найти(КодЦБ, "@BVAL") - 1);
		
		//Чтобы не заставлять пользователей проставлять тиккеры для ЦЦЦ, ищем  по ISIN
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Активы.Объект КАК Актив,
		|	Активы.Объект.ISIN КАК КодЦБ,
		|	&Биржа КАК БиржаЛистинга
		|ИЗ
		|	Справочник.Активы КАК Активы
		|ГДЕ
		|	НЕ Активы.ПометкаУдаления
		|	И Активы.Объект.ISIN = &КодЦБ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Актив,
		|	КодЦБ,
		|	БиржаЛистинга";
		
		Запрос.УстановитьПараметр("Биржа", Справочники.Биржи.НайтиПоКоду("BVAL"));
	Иначе
		Тикер = ПолучитьМассивКодовЦБ(КодЦБ);
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АкцииБиржиЛистинга.Ссылка КАК Актив,
		|	АкцииБиржиЛистинга.Тикер КАК КодЦБ,
		|	АкцииБиржиЛистинга.Биржа КАК БиржаЛистинга
		|ИЗ
		|	Справочник.Акции.БиржиЛистинга КАК АкцииБиржиЛистинга
		|ГДЕ
		|	АкцииБиржиЛистинга.Тикер В(&КодЦБ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ОблигацииБиржиЛистинга.Ссылка,
		|	ОблигацииБиржиЛистинга.Тикер,
		|	ОблигацииБиржиЛистинга.Биржа
		|ИЗ
		|	Справочник.Облигации.БиржиЛистинга КАК ОблигацииБиржиЛистинга
		|ГДЕ
		|	ОблигацииБиржиЛистинга.Тикер В(&КодЦБ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	СтруктурныеНотыБиржиЛистинга.Ссылка,
		|	СтруктурныеНотыБиржиЛистинга.Тикер,
		|	СтруктурныеНотыБиржиЛистинга.Биржа
		|ИЗ
		|	Справочник.СтруктурныеНоты.БиржиЛистинга КАК СтруктурныеНотыБиржиЛистинга
		|ГДЕ
		|	СтруктурныеНотыБиржиЛистинга.Тикер В(&КодЦБ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ДепозитарныеРаспискиБиржиЛистинга.Ссылка,
		|	ДепозитарныеРаспискиБиржиЛистинга.Тикер,
		|	ДепозитарныеРаспискиБиржиЛистинга.Биржа
		|ИЗ
		|	Справочник.ДепозитарныеРасписки.БиржиЛистинга КАК ДепозитарныеРаспискиБиржиЛистинга
		|ГДЕ
		|	ДепозитарныеРаспискиБиржиЛистинга.Тикер В(&КодЦБ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ПаиПиф.Ссылка,
		|	ПаиПиф.Тикер,
		|	ПаиПиф.Биржа
		|ИЗ
		|	Справочник.ПаиПИФ.БиржиЛистинга КАК ПаиПиф
		|ГДЕ
		|	ПаиПиф.Тикер В(&КодЦБ)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ОбезличенныеМеталлическиеСчета.Ссылка,
		|	ОбезличенныеМеталлическиеСчета.Наименование,
		|	Биржи.Ссылка
		|ИЗ
		|	Справочник.ОбезличенныеМеталлическиеСчета КАК ОбезличенныеМеталлическиеСчета,
		|	Справочник.Биржи КАК Биржи
		|ГДЕ
		|	ОбезличенныеМеталлическиеСчета.Наименование В(&КодЦБ)
		|	И Биржи.Наименование = ""CBR_METALL""
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	СрочныеКонтракты.Ссылка,
		|	СрочныеКонтракты.Тикер,
		|	СрочныеКонтракты.Биржа
		|ИЗ
		|	Справочник.СрочныеКонтракты.БиржиЛистинга КАК СрочныеКонтракты
		|ГДЕ
		|	СрочныеКонтракты.Тикер В(&КодЦБ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	т.Ссылка,
		|	т.КодЦБ_НаММВБ,
		|	ЗНАЧЕНИЕ(Справочник.Биржи.ММВБ)
		|ИЗ
		|	Справочник.ДрагоценныеМеталлы КАК т
		|ГДЕ
		|	т.КодЦБ_НаММВБ В(&КодЦБ)";

	КонецЕсли;
	
	Запрос.УстановитьПараметр("КодЦБ", Тикер);
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Возврат Выборка;
КонецФункции // АктивыПоТикеру()

Функция КотировкиПоБиржеИДате(Знач Биржа, Знач Дата)
	Перем Запрос, Результат;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Биржа", Биржа);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КотировкиЦБНаБирже.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КотировкиЦБНаБирже КАК КотировкиЦБНаБирже
	|ГДЕ
	|	КотировкиЦБНаБирже.Биржа = &Биржа
	|	И КотировкиЦБНаБирже.Дата >= НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	|	И КотировкиЦБНаБирже.Дата < НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, ДЕНЬ, 1), ДЕНЬ)
	|	И НЕ КотировкиЦБНаБирже.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	КотировкиЦБНаБирже.Дата,
	|	Ссылка";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		НовыйДок = Документы.КотировкиЦБНаБирже.СоздатьДокумент();
		НовыйДок.Дата	 = Дата;
		НовыйДок.Биржа	 = Биржа;
		
		Возврат НовыйДок;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	// DV 29/04/14
	Если ЗначениеЗаполнено(Актив) Тогда
		Возврат DV_UpdateDoc(Актив,Выборка.Ссылка);
	КонецЕсли;
	
	Док = Выборка.Ссылка.ПолучитьОбъект();
	Док.Котировки.Очистить();
	
	Возврат Док;
КонецФункции // КотировкиПоБиржеИДате()

Функция УровеньПоКоду(Код)
	
	Если НЕ ЗначениеЗаполнено(Код) тогда Возврат Справочники.УровниКотировальногоЛиста.ПустаяСсылка() КонецЕсли;
	
	Элемент =  Справочники.УровниКотировальногоЛиста.НайтиПоКоду(Код, Истина);
	Если Элемент.Пустая() тогда
		НовыйЭлемент = Справочники.УровниКотировальногоЛиста.СоздатьЭлемент();
		НовыйЭлемент.Код = Код;
		НовыйЭлемент.Записать();
		Элемент = НовыйЭлемент.Ссылка;
	КонецЕсли;
	
	Возврат Элемент;
КонецФункции

//ПРОЦЕДУРЫ ЗАГРУЗКИ///////////////////////////////////////////////////////////////////////

Функция ЗагрузитьОбъекты(Отказ=Ложь, ТекстОшибки="") Экспорт
	
	// IMDEV-9530: замер шага чтения котировок
	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	
	Лог = Новый ТабличныйДокумент;
	
	Ошибка = Макет.ПолучитьОбласть("Ошибка");
	Заголовок = Макет.ПолучитьОбласть("Заголовок");
	Лог.Вывести(Заголовок);
	
	Шапка 	= Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.ДатаНачала 			= ДатаНачала;
	Шапка.Параметры.ДатаОкончания 		= ДатаОкончания;
	Шапка.Параметры.ДатаФормирования 	= ТекущаяДата();
	Лог.Вывести(Шапка);
	
	ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	Лог.Вывести(ЗаголовокТаблицы);
	
	
	ОсновноеПространствоИмен = "http://www.avancore.ru/quotes"; 
	Попытка 
		
		Определение = Новый WSОпределения("http://amaptibco:8882/",,,, 120);  // АХТУНГ
		//Определение = Новый WSОпределения("http://smsk02ap209u:8882/",,,, 120);  Сообщить("Подключение к ТЕСТу");
		
		Фабрика = Определение.ФабрикаXDTO;
		
	Исключение
		ТекстОшибки = "Ошибка подключения:"+ОписаниеОшибки();
		сообщить(ТекстОшибки);
		Отказ = Истина;
		
		Ошибка.Параметры.ОписаниеОшибки = ТекстОшибки;
		Лог.Вывести(Ошибка);
		
	КонецПопытки;
	
	Если Отказ=Истина тогда 
		Возврат Лог;
	КонецЕсли;
	
	Попытка
		
		Корень_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "Корень");
		Условия_ТИП	= Фабрика.Тип(ОсновноеПространствоИмен, "УсловиеКотировок");
		Корень 		= Фабрика.Создать(Корень_ТИП);
		Условия 	= Фабрика.Создать(Условия_ТИП);
		
		Условия.DateFrom	 = ДатаНачала;
		Условия.DateTo		 = ДатаОкончания;
		Условия.StockCode	 = StockCode(Актив);
		Условия.NEED_DAY_SESSION = Ложь;
		
		Корень.УсловиеКотировок = Условия;
		
		Если ТестовыйРежим Тогда
			Ответ  = ТестоваяЗагрузка(Фабрика, Корень_ТИП);
		Иначе
			Ответ = ЗагрузкаЧерезСервис(Определение,Корень);
		КонецЕсли;
		
	Исключение
		ТекстОшибки = "Ошибка подключения:"+ОписаниеОшибки();
		сообщить(ТекстОшибки);
		Отказ = Истина;
		
		Ошибка.Параметры.ОписаниеОшибки = ТекстОшибки;
		Лог.Вывести(Ошибка);
	КонецПопытки;
	
	
	Если Отказ=Истина тогда 
		возврат Лог;
	КонецЕсли;
	
	ПрочитатьКотировки(Ответ.ДокументКотировок);
	
	// IMDEV-9530: шаг чтения, вес - котировки к загрузке; при ошибке (Отказ) выход выше, замер не пишется
	ЗаполнитьКоличествоКотировокЗамера();
	ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗагрузкаКотировокММВБ.Чтение", НачалоЗамера,
		Макс(ПоказателиЗамера.Котировок, 1), КомментарийЗамера(Ложь, Истина));
	
	Возврат Лог;
КонецФункции

Функция ЗагрузкаЧерезСервис(Определение, Корень)
	
	Прокси = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен, Определение.Сервисы[0].Имя, Определение.Сервисы[0].ТочкиПодключения[0].Имя);
	
	Прокси.StockPrice(Корень);
	
	Возврат Корень;
	
КонецФункции

Функция ТестоваяЗагрузка(Фабрика, Корень_ТИП)
	
	ФайлПример = ПолучитьИмяВременногоФайла("xml");
	
	Пример = ПолучитьМакет("ПримерОтвета");
	Пример.Записать(ФайлПример,КодировкаТекста.UTF8 );
	
	Чтение	= Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлПример);
	
	Корень 		= Фабрика.ПрочитатьXML(Чтение, Корень_ТИП);
	
	Возврат Корень;
	
КонецФункции

Процедура СоздатьОбъекты(Отказ = Ложь, ТекстОшибки = "") Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// IMDEV-9530: замер шага записи котировок
	НачалоЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	ЗаполнитьКоличествоКотировокЗамера();
	ПоказателиЗамера.Документов = 0;
	ПоказателиЗамера.Непроведенных = 0;
	
	ЗаголовоДокументов = Макет.ПолучитьОбласть("ЗаголовокКСозданиюДокументов");
	Лог.Вывести(ЗаголовоДокументов);
	СтрокаЛога = Макет.ПолучитьОбласть("СтрокаДокументов");
	
	МассивУдаления = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Источник", СписокЗагрузки.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ Котировки
	|ИЗ
	|	&Источник КАК Источник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	Котировки КАК Котировки
	|ИТОГИ
	|	
	|ПО
	|	Котировки.Дата,
	|	Котировки.Биржа";
	
	ГруппаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ГруппаДата.Следующий() Цикл
		ГруппаБиржи = ГруппаДата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ГруппаБиржи.Следующий() Цикл
			Если ГруппаБиржи.Биржа.Пустая() Тогда
				Продолжить;
			КонецЕсли;
			
			Док = КотировкиПоБиржеИДате(ГруппаБиржи.Биржа, ГруппаДата.Дата);
			
			Детали = ГруппаБиржи.Выбрать();
			Пока Детали.Следующий() Цикл
				Если Детали.Актив.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				НайдСтроки = Док.Котировки.НайтиСтроки(Новый Структура("Актив",Детали.Актив));
				Если НайдСтроки.Количество() = 0 Тогда
					НоваяСтрока = Док.Котировки.Добавить();
				Иначе
					НоваяСтрока = НайдСтроки[0];
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Детали);
				НоваяСтрока.Валюта		 = Детали.ВалютаКотировки;
				НоваяСтрока.ЦенаСпроса	 = Детали.BID;          // DV 15/04/14
				НоваяСтрока.Актив			 = Детали.Актив;
				//vns 02.08.2017
				//НоваяСтрока.YIELDATWAP = Детали.YIELDATWAP;
				//НоваяСтрока.YIELDCLOSE = Детали.YIELDCLOSE;
			Конеццикла;
			
			Если Док.Котировки.Количество() = 0 тогда
				Продолжить;
			КонецЕсли;
			
			Отказ = Ложь;
			
			Попытка
				Док.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Отказ 		= Истина;
				ТекстОшибки = "Не удалось провести:"+ Док+ " Документ будет записан";
				Док.записать(РежимЗаписиДокумента.Запись);
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстОшибки;
				Сообщение.КлючДанных = Док.Ссылка;
				Сообщение.Сообщить();
			КонецПопытки;
			// IMDEV-9530: записанные и непроведенные документы котировок для замера; Отказ сбрасывается перед каждым
			// документом, поэтому непроведенный документ запоминается отдельно
			ПоказателиЗамера.Документов = ПоказателиЗамера.Документов + 1;
			Если Отказ Тогда
				ПоказателиЗамера.Непроведенных = ПоказателиЗамера.Непроведенных + 1;
			КонецЕсли;
			
			СтрокаЛога.Параметры.Документ = Док.Ссылка;
			Лог.Вывести(СтрокаЛога);
		КонецЦикла;
	КонецЦикла;
	
	// IMDEV-9530: шаг записи, вес - котировки; если хотя бы один документ не проведен, замер не пишется
	Если НЕ Отказ И ПоказателиЗамера.Непроведенных = 0 Тогда
		ОценкаПроизводительности.ЗакончитьЗамерВремени("ЗагрузкаКотировокММВБ.Запись", НачалоЗамера,
			Макс(ПоказателиЗамера.Котировок, 1), КомментарийЗамера(Истина, Ложь));
	КонецЕсли;
	
	СписокЗагрузки.Очистить();
	
	Сообщить("Создание документов завершено", СтатусСообщения.Информация);
	
КонецПроцедуры

Функция ПолучитьМассивКодовЦБ(Знач КодЦБ)
	Перем МассивКодовЦБ;
	Перем ЭтоISIN, Концовка;
	
	КодЦБ = СокрЛП(КодЦБ);
	
	МассивКодовЦБ = Новый Массив();
	МассивКодовЦБ.Добавить(КодЦБ);
	
	ЭтоISIN = СтрДлина(КодЦБ) = 12 И СтрНайти(КодЦБ, " ") = 0 И СтрНайти(КодЦБ, Символы.НПП) = 0;  // у ISIN'ов нет пробелов и он длиной 12 символов!
	
	Если НЕ ЭтоISIN Тогда
		Концовка = " USD";
		
		Если СтрЗаканчиваетсяНа(ВРег(КодЦБ), Концовка) Тогда
			// если есть Концовка - выкусываем её
			МассивКодовЦБ.Добавить(СокрП(Лев(КодЦБ, СтрДлина(КодЦБ) - СтрДлина(Концовка))));
		Иначе
			// если нет Концовки - добавляем её
			МассивКодовЦБ.Добавить(КодЦБ + Концовка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат МассивКодовЦБ;
КонецФункции // ПолучитьМассивКодовЦБ()

Функция StockCode(Знач Актив)
	Перем Запрос, Выборка;
	Перем МассивТикеров, Тикеры, ISIN, КодЦБ;
	
	Если НЕ ЗначениеЗаполнено(Актив) Тогда
		Возврат "";
	КонецЕсли;
	
	МассивТикеров = Новый Массив();
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", Актив.Объект);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	БиржиЛистинга.КодЦБ КАК КодЦБ
	|ИЗ
	|	Справочник.Акции.БиржиЛистинга КАК БиржиЛистинга
	|ГДЕ
	|	БиржиЛистинга.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	БиржиЛистинга.КодЦБ
	|ИЗ
	|	Справочник.Облигации.БиржиЛистинга КАК БиржиЛистинга
	|ГДЕ
	|	БиржиЛистинга.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	БиржиЛистинга.КодЦБ
	|ИЗ
	|	Справочник.СтруктурныеНоты.БиржиЛистинга КАК БиржиЛистинга
	|ГДЕ
	|	БиржиЛистинга.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	БиржиЛистинга.КодЦБ
	|ИЗ
	|	Справочник.ДепозитарныеРасписки.БиржиЛистинга КАК БиржиЛистинга
	|ГДЕ
	|	БиржиЛистинга.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	БиржиЛистинга.КодЦБ
	|ИЗ
	|	Справочник.ПаиПИФ.БиржиЛистинга КАК БиржиЛистинга
	|ГДЕ
	|	БиржиЛистинга.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СрочныеКонтракты.Код
	|ИЗ
	|	Справочник.СрочныеКонтракты КАК СрочныеКонтракты
	|ГДЕ
	|	СрочныеКонтракты.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДрагоценныеМеталлыБиржиЛистинга.КодЦБ
	|ИЗ
	|	Справочник.ДрагоценныеМеталлы.БиржиЛистинга КАК ДрагоценныеМеталлыБиржиЛистинга
	|ГДЕ
	|	ДрагоценныеМеталлыБиржиЛистинга.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КодЦБ = ВРег(СокрП(Выборка.КодЦБ));
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			МассивТикеров,
			ПолучитьМассивКодовЦБ(КодЦБ),
			Ложь
		);
	КонецЦикла;
	
	Если ТипЗнч(Актив.Объект) = Тип("СправочникСсылка.СрочныеКонтракты") Тогда
		// IMAPPS-15304: здесь никаких концовок не нужно!
	ИначеЕсли ТипЗнч(Актив.Объект) = Тип("СправочникСсылка.ДрагоценныеМеталлы") Тогда
		// IMDEV-3563 здесь никаких концовок не нужно!			
	Иначе
		ISIN = ВРег(СокрП(Актив.Объект.ISIN));
		
		МассивТикеров.Добавить(ISIN + "НРД");  // ИКФ: в биржах листинга и базе rates фактов наличия таких тикеров не нашел!
		МассивТикеров.Добавить(ISIN + "@BVAL CORP USD");
		// MPazhukov IMAPPS-10821
		МассивТикеров.Добавить(ISIN + "@MICB Corp");
		МассивТикеров.Добавить(ISIN + "@EXCH Corp");
		МассивТикеров.Добавить(ISIN + "@FRNK Corp");
		МассивТикеров.Добавить(ISIN + "@STGT Corp");
		МассивТикеров.Добавить(ISIN + "@LUX Corp");
		// MPazhukov IMAPPS-10821
		МассивТикеров = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивТикеров);
	КонецЕсли;
	
	Тикеры = СтрСоединить(МассивТикеров, ",");
	Тикеры = Тикеры + ?(НЕ СтрЗаканчиваетсяНа(Тикеры, ","), ",", "");
	
	Возврат Тикеры;
КонецФункции // StockCode()

Функция DV_UpdateDoc(Актив,Док)
	
	НовыйДок = Док.ПолучитьОбъект();
	НовыйДок.Проведен = Ложь;
	
	Запрос = Новый Запрос;
	//	IMAPPS-1880
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КотировкиЦБНаБиржеКотировки.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.КотировкиЦБНаБирже.Котировки КАК КотировкиЦБНаБиржеКотировки
	|ГДЕ
	|	КотировкиЦБНаБиржеКотировки.Ссылка = &Ссылка
	|	И КотировкиЦБНаБиржеКотировки.ЦБ = &ЦБ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки УБЫВ";
	
	Запрос.УстановитьПараметр("Ссылка", Док);
	Запрос.УстановитьПараметр("ЦБ", Актив);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовыйДок.Котировки.Удалить(НовыйДок.Котировки[ВыборкаДетальныеЗаписи.НомерСтроки-1]);
	КонецЦикла;
	
	НовыйДок.Записать(РежимЗаписиДокумента.Запись);
	Возврат НовыйДок;
	
КонецФункции

