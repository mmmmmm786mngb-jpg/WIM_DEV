
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	об = РеквизитФормыВЗначение("Объект");
	
	ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", об.Метаданные().Имя);
	Если НЕ ДополнительнаяОбработкаСсылка.Пустая() Тогда
		НастройкиИзБазы = ДополнительнаяОбработкаСсылка.ХранилищеНастроек.Получить();
		об.УстановитьПользовательскиеНастройки(НастройкиИзБазы);
		ЗначениеВРеквизитФормы(об, "Объект");
	Иначе 
		Объект.АдресWS = "http://amapfront/PROD_AVC_FO-DL/ws/avancore_ws.1cws?wsdl";	
	КонецЕсли;
	
	Заголовок = "Версия v."+об.СведенияОВнешнейОбработке().Версия;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыгрузитьИзмененияСразу(Команда)
	
	ПоказатьЛог = Ложь;
	
	ВыгрузитьДанныеНаСервере("", Истина);
	
	//Если ПоказатьЛог Тогда
		ЖурналОбмена = ЖурналОбменаСервера();
		ЖурналОбмена.Показать("Журнал обмена");
	//Иначе
		Сообщить("Успешно выполнено");
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСчета(Команда)
	
	ВыгрузитьДанныеНаСервере("СчетаМандатов", Ложь);
	
	ЖурналОбмена = ЖурналОбменаСервера();
	Если ЖурналОбмена.ВысотаТаблицы <> 0 Тогда
		ЖурналОбмена.Показать("Журнал обмена");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСчета(Команда)
	Если Объект.ОтборМандат Тогда
		Если Не ЗначениеЗаполнено(Объект.УК) Тогда
			ПоказатьПредупреждение(, "Установлен отбор по мандатам. Требуется выбрать УК.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьНаСервере("СчетаМандатов");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуСчетаПортфедя(Команда)
	УстановитьПометкуНаСервере("СчетаМандатов", Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкуСчетаПортфеля(Команда)
	УстановитьПометкуНаСервере("СчетаМандатов", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуМандаты(Команда)
	УстановитьПометкуНаСервере("Мандаты", Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкуМандаты(Команда)
	УстановитьПометкуНаСервере("Мандаты", Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Функция ТекстовыйЛогСервера()
	
	Результат = РеквизитФормыВЗначение("Объект").ТекстовыйЛог;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЖурналОбменаСервера()
	
	Результат = РеквизитФормыВЗначение("Объект").ЖурналОбменаТабДок;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНаСервере(ИмяТабЧасти)
	
	Отказ = Ложь;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если ИмяТабЧасти = "СчетаМандатов" Тогда
		Если Объект.ОтборМандат Тогда
			ОбработкаОбъект.ЗаполнитьСписокМандатДляОтбора();
		КонецЕсли;
		ОбработкаОбъект.СчетаМандатов.Очистить();
		ОбработкаОбъект.ЗаполнитьСчетаМандатов(ОбработкаОбъект.УзелОбмена);
	ИначеЕсли ИмяТабЧасти = "Мандаты" Тогда
		ОбработкаОбъект.Мандаты.Очистить();
		ОбработкаОбъект.ЗаполнитьМандаты(ОбработкаОбъект.УзелОбмена);		
	КонецЕсли;
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьДанныеНаСервере(ИмяТабЧасти, флСразу)

	Если Объект[ИмяТабЧасти].Количество() = 0 Тогда
		Сообщить("Нет данных для выгрузки");
		Возврат;
	КонецЕсли;
	
	Объект.ВыгрузитьПоУзлу = флСразу;
	Объект.ТекстовыйЛог.Очистить();
	Объект.ЖурналОбмена.Очистить();
	Объект.ЖурналОбменаТабДок.Очистить();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.Выгрузить(ИмяТабЧасти);
	ПоказатьЛог = ОбработкаОбъект.ЕстьОшибки;
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПометкуНаСервере(ИмяТЧ, Пометка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Для Каждого СтрокаТЧ Из ОбработкаОбъект[ИмяТЧ] Цикл
		СтрокаТЧ.Выгружать = Пометка;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура ОтладкаНаСервере()
	Объект.ТекстовыйЛог.Очистить();
	Объект.ЖурналОбмена.Очистить();
	Объект.ЖурналОбменаТабДок.Очистить();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ВыгрузитьПоУзлу();
	ПоказатьЛог = ОбработкаОбъект.ЕстьОшибки;
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура Отладка(Команда)
	ОтладкаНаСервере();
	
	ЖурналОбмена = ЖурналОбменаСервера();
	Если ЖурналОбмена.ВысотаТаблицы <> 0 Тогда
		ЖурналОбмена.Показать("Журнал обмена");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМандаты(Команда)

	ЗаполнитьНаСервере("Мандаты");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьМандаты(Команда)
	
	ВыгрузитьДанныеНаСервере("Мандаты", Ложь);
	
	ЖурналОбмена = ЖурналОбменаСервера();
	Если ЖурналОбмена.ВысотаТаблицы <> 0 Тогда
		ЖурналОбмена.Показать("Журнал обмена");
	КонецЕсли;	
КонецПроцедуры

