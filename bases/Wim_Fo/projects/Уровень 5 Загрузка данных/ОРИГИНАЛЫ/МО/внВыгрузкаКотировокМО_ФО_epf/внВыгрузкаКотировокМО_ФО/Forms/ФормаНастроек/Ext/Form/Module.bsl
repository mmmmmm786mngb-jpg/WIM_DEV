
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДополнительнаяОбработкаСсылка = Неопределено;
	Если Параметры.Свойство("НастройкиАлгоритма") И ТипЗнч(Параметры.НастройкиАлгоритма) = Тип("Структура") Тогда
		// открывается из дополнительных обработок с ранее сохраненными настройками (гиперссылка "установить настройки")
		Настройки 			= Параметры.НастройкиАлгоритма;
		ОбработкаОбъект 	= РеквизитФормыВЗначение("Объект");
		ОбработкаОбъект.УстановитьПользовательскиеНастройки(Настройки);
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	ИначеЕсли Параметры.Свойство("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка) Тогда
		// открывается из формы пользовательских обработок в разделах
		НастройкиИзБазы = ДополнительнаяОбработкаСсылка.ХранилищеНастроек.Получить();
		ОбработкаОбъект 	= РеквизитФормыВЗначение("Объект");
		ОбработкаОбъект.УстановитьПользовательскиеНастройки(НастройкиИзБазы);
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	Иначе
		// открывается как внешняя обработка через Открыть 
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ОбработкаОбъект.Метаданные().Имя);
		Если НЕ ДополнительнаяОбработкаСсылка.Пустая() Тогда
			НастройкиИзБазы = ДополнительнаяОбработкаСсылка.ХранилищеНастроек.Получить();
			ОбработкаОбъект.УстановитьПользовательскиеНастройки(НастройкиИзБазы);
			ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#Область УстановкаПараметров

&НаКлиенте
Процедура УстановитьНастройки(Команда)
	
	ЭтаФорма.Заголовок = "";	
	ЗначенияПараметров = УстановитьНастройкиСервер(ЭтаФорма.Заголовок);
	ОповеститьОВыборе(Новый Структура("Значения, ЗаголовокНастроек", ЗначенияПараметров, ЭтаФорма.Заголовок));
	
КонецПроцедуры // Установить()

&НаСервере
Функция УстановитьНастройкиСервер(Заголовок)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЗначенияПараметров = ОбработкаОбъект.УстановитьПараметры(Заголовок);	

	Возврат ЗначенияПараметров;
	
КонецФункции // УстановитьПараметры()

&НаСервере
Процедура НастройкиПоУмолчаниюНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.НастройкиПоУмолчанию(ОбработкаОбъект);	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура НастройкиПоУмолчанию(Команда)
	
	НастройкиПоУмолчаниюНаСервере();
	
КонецПроцедуры // НастройкиПоУмолчанию()

#КонецОбласти
