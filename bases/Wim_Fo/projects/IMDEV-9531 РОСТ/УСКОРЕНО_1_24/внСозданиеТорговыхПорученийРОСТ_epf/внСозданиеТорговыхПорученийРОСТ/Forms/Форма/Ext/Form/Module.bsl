Процедура ПриОткрытии(Отказ)
	
	ПорученийВПакете = 200;
	ВариантПродажи = "LQDT";
	УправлениеЭтойФормой();
	СписокПорученийНаОтправку = новый Массив;
	СписокПорученийНаОтправкуПодБлок = новый Массив;
	//++ IMDEV-9531
	ЗапускСФормыИдет = Ложь;
	ОшибкиЗапуска = Ложь;

	// Форма открыта во время запуска (своего прежнего или другого трейдера): оповещение о его завершении
	// эта форма не получит, поэтому задания проверяются по таймеру, кнопки включаются, когда их не осталось.
	Если ЕстьАктивныеЗапуски() Тогда
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеДругихЗапусков", 5);
	КонецЕсли;
	//-- IMDEV-9531

КонецПроцедуры

&НаКлиенте
Процедура РеинвестФлагиУстановитьСледПакет(Команда)
	
	Выбрано = 0;
	
	Для каждого СтрокаТаб Из Объект.СписокПортфелейРеинвестирование Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаб.Поручение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выбрано >= ПорученийВПакете Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаТаб.Пометка = Истина;
		Выбрано = Выбрано + 1;
	КонецЦикла;
	
КонецПроцедуры

