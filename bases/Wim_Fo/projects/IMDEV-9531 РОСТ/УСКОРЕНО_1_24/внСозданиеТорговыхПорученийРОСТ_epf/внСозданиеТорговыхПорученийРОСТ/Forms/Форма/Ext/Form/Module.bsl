&НаСервере
Функция БлокировкиПродажиСоздатьПорученияВФонеНаСервере(УникальныйИдентификатор, НомерПотока, РазмерПакета, ВсегоПотоков)
	
	Если ДополнительнаяОбработка.Пустая() Тогда
		Сообщить("Не определена обработка для определения настроек!");
	КонецЕсли;
	
	АдресВХранилище = ПоместитьВоВременноеХранилище(Неопределено);
	ПортфелиСписок = новый Массив;
	
	СписСтрок = Объект.СписокПортфелейПродажиПодБлокировки.НайтиСтроки(новый Структура("НомерПотока", НомерПотока));
	
	Для Каждого СтрокаТаб Из СписСтрок Цикл
		
		Если СтрокаТаб.ОстатокДС < 0 Тогда
			НовСтрока = новый Структура("Портфель,СубПортфель,Актив,СуммаПоручения,ОстатокЦБ,Поручение");
			ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТаб);
			НовСтрока.СуммаПоручения = - СтрокаТаб.ОстатокДС;
			НовСтрока.СуммаПоручения = НовСтрока.СуммаПоручения * (1 + Объект.ПроцентКомиссияБрокер / 100);
			ПортфелиСписок.Добавить(НовСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	РазмерПакета = ПортфелиСписок.Количество();
	
	Если РазмерПакета = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ПродажиПодБлокировки#" + НомерПотока;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина; 
	ПараметрыВыполнения.Вставить("АдресРезультата", АдресВХранилище);
	
	ПараметрыПроцедурыМодуляОбъекта = Новый Структура;
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ПортфелиСписок", новый ФиксированныйМассив(ПортфелиСписок));   
	ПараметрыПроцедурыМодуляОбъекта.Вставить("НомерПотока", НомерПотока);   
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ОбработкаСсылка", ДополнительнаяОбработка);   
	// IMDEV-9530: размер пакета на запуск для комментария замера потока - портфели, распределенные по потокам
	// в этом нажатии кнопки (номер потока больше нуля); реквизит ПорученийВПакете - только верхняя граница
	ПортфелейВПакете = 0;
	Для Каждого СтрокаПакета Из Объект.СписокПортфелейПродажиПодБлокировки Цикл
		Если СтрокаПакета.НомерПотока > 0 Тогда
			ПортфелейВПакете = ПортфелейВПакете + 1;
		КонецЕсли;
	КонецЦикла;
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ПортфелейВПакете", ПортфелейВПакете);
	//++ IMDEV-9531
	// Поток передает цены поручений на форму
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ПоказыватьЦеныВРаботе", Истина);
	//-- IMDEV-9531
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяОбработки", 		"ВнешняяОбработка.СозданиеТорговыхПорученийРОСТ");
	ПараметрыЗадания.Вставить("ИмяМетода", 			"БлокировкиПродажиСоздатьОрдера");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", 	ПараметрыПроцедурыМодуляОбъекта);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", 	Истина);
	ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработка);
	
	ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки";
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения);
	
	Возврат ДлительнаяОперация;	
	
КонецФункции

&НаКлиенте
Процедура БлокировкиПродажиОтправитьПачкуПоручений(Команда)

	//++ IMDEV-9531
	// Один запуск с формы за раз (по всей базе)
	Если Не МожноНачатьЗапуск() Тогда
	//-- IMDEV-9531
		Возврат;
	КонецЕсли;

	СписокПорученийНаОтправкуПодБлок = новый Массив;
	
	СделокОтправлено = 0;
	ПортфелейОтмечено = 0;
	КоличествоПотоков = 10;
	КоличествоПорученй = Объект.СписокПортфелейПродажиПодБлокировки.Количество();
	КолвоСделокНаПоток = Цел(КоличествоПорученй/КоличествоПотоков);
	
	НомерТекПотока = 1;
	
	Для каждого СтрокаТабл Из Объект.СписокПортфелейПродажиПодБлокировки Цикл
		
		СтрокаТабл.НомерПотока = 0;
		
		Если не СтрокаТабл.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТабл.ОстатокДС > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТабл.Поручение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПортфелейОтмечено < ПорученийВПакете Тогда
			СтрокаТабл.НомерПотока = НомерТекПотока;
			ПортфелейОтмечено = ПортфелейОтмечено + 1;
			
			НомерТекПотока = ?(НомерТекПотока = КоличествоПотоков, 1, НомерТекПотока + 1);
		Иначе
			СтрокаТабл.НомерПотока = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	//++ IMDEV-9531
	// Очищается список заданий блокировок (было: список заданий реинвестирования)
	СписокЗаданийПродажиБлоки.Очистить();
	
	НачатьПоказЦенВРаботе();
	//-- IMDEV-9531
	
	Для сч = 1 по КоличествоПотоков Цикл
		
		Задание = БлокировкиПродажиСоздатьПорученияВФонеНаСервере(УникальныйИдентификатор, Сч, КолвоСделокНаПоток, КоличествоПотоков);
		
		Если Задание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		НастройкиОжидания.ВыводитьОкноОжидания = Ложь;
		//++ IMDEV-9531
		// Цены потока на форму через прогресс длительной операции
		НастройкиОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ПрогрессЦенВРаботе", ЭтотОбъект);
		НастройкиОжидания.ВыводитьПрогрессВыполнения = Истина;
		//-- IMDEV-9531
		НастройкиОжидания.Интервал = 3;

		//++ IMDEV-9531
		// Номер потока - для отметки завершения потока, в том числе с ошибкой
		//-- IMDEV-9531
		ОповещениеОЗавершении = Новый ОписаниеОповещения(
			"ПослеЗавершенияСозданияПорученийПродажиБлок", 
			//++ IMDEV-9531
			ЭтотОбъект, сч);
			//-- IMDEV-9531

		Если Задание.Статус = "Ошибка" Тогда
			Сообщить("Ошибка создания задания ""Продажи под блокировки"", детали в логе ");
			Объект.Лог.ДобавитьСтроку("[err] ошибка создания задания "+сч);
			Объект.Лог.ДобавитьСтроку(Задание.ПодробноеПредставлениеОшибки);
		Иначе
			ДлительныеОперацииКлиент.ОжидатьЗавершение(Задание, ОповещениеОЗавершении, НастройкиОжидания);
			НовСтрока = СписокЗаданийПродажиБлоки.Добавить();
			НовСтрока.Ид = сч;
			НовСтрока.ДатаСтарт = ТекущаяДата();
			НовСтрока.Стартовано = 1;
			НовСтрока.Завершено = 0;
			НовСтрока.ИдентификаторЗадания = Задание.ИдентификаторЗадания;
			//++ IMDEV-9531
			// На время запуска недоступны все четыре кнопки
			Если ЗапускСФормыИдет <> Истина Тогда
				НачатьЗапускСФормы();
			КонецЕсли;
			//-- IMDEV-9531
		КонецЕсли;

	КонецЦикла;

	//++ IMDEV-9531
	Если ЗапускСФормыИдет <> Истина Тогда
		ЗавершитьПоказЦенВРаботе("Потоки не запущены: нет отмеченных портфелей или ошибка создания заданий");
	КонецЕсли;
	//-- IMDEV-9531

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗавершенияСозданияПорученийПродажиБлок(Задание, НомерПотока) Экспорт //++ IMDEV-9531

	//++ IMDEV-9531
	// Поток отмечается по номеру, пачка отправляется один раз - когда завершены все потоки запуска
	// (см. ПослеЗавершенияСозданияПорученийРеинвестирование).
	ВсеПотокиЗавершены = ОтметитьЗавершениеПотока(СписокЗаданийПродажиБлоки, НомерПотока);
	//-- IMDEV-9531

	Если Задание = Неопределено Тогда
		//++ IMDEV-9531
		ОшибкиЗапуска = Истина;
		//-- IMDEV-9531
		Сообщить("Ошибка завершения задания неопределено???");
		Объект.Лог.ДобавитьСтроку("Ошибка завершения задания ""Продажи под блокировки"" неопределено???");
	//++ IMDEV-9531
	Иначе
		ДобавитьРезультатПотока(Задание, СписокПорученийНаОтправкуПодБлок);
	КонецЕсли;

	Если Не ВсеПотокиЗавершены Тогда
	//-- IMDEV-9531
		Возврат;
	КонецЕсли;

	//++ IMDEV-9531
	// Этап отправки показывается до серверного вызова (см. ПослеЗавершенияСозданияПорученийРеинвестирование)
	ПоказатьЭтапОтправкиПачки(СписокПорученийНаОтправкуПодБлок.Количество());
	ПодключитьОбработчикОжидания("ОтправитьПачкуПродажПодБлокировки", 0.1, Истина);
	//-- IMDEV-9531

КонецПроцедуры

&НаКлиенте
Процедура БлокировкиПродажиФлагиСнятьВсе(Команда)
	
	Для каждого СтрокаТаб Из Объект.СписокПортфелейПродажиПодБлокировки Цикл
		СтрокаТаб.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура БлокировкиПродажиВлагиУстановитьВсе(Команда)
	
	Для каждого СтрокаТаб Из Объект.СписокПортфелейПродажиПодБлокировки Цикл
		СтрокаТаб.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьРасхожденияАллокацииНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработка);
	Об.УстановитьНастройки(ПараметрыВыполнения);
	
	ТекстОшибки = "";
	ВажностьОшибки = 0;
	Об.ПолучитьРасхожденияАллокации(ДатаТестирования, ТекстОшибки, ВажностьОшибки);
	ЗначениеВРеквизитФормы(Об, "Объект");
	
	Сообщить("Результат тестирования в логе.")
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьРАсхожденияАллокации(Команда)
	ПолучитьРАсхожденияАллокацииНаСервере();
КонецПроцедуры

#Область IMDEV_9531

#Область ЗакрытиеФормы

// Закрытие формы во время запуска с формы отменяет его фоновые задания (БСП отменяет длительные
// операции закрытой формы) - запуск обрывается на середине. Поэтому закрытие подтверждается вопросом; при
// завершении работы программы выводится предупреждение.
//
// Параметры:
//  Отказ - Булево - отказ от закрытия
//  ЗавершениеРаботы - Булево - закрытие при завершении работы программы
//  ТекстПредупреждения - Строка - текст предупреждения при завершении работы
//  СтандартнаяОбработка - Булево - не используется
//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗапускСФормыИдет <> Истина Или ЗакрытиеВоВремяЗапускаПодтверждено = Истина Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = ТекстВопросаЗакрытияВоВремяЗапуска();
		Возврат;
	КонецЕсли;
	ПодтвердитьЗакрытиеВоВремяЗапуска();

КонецПроцедуры

// Вопрос о закрытии формы во время запуска; при ответе "Да" форма закрывается.
//
&НаКлиенте
Асинх Процедура ПодтвердитьЗакрытиеВоВремяЗапуска()

	Ответ = Ждать ВопросАсинх(ТекстВопросаЗакрытияВоВремяЗапуска(), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗакрытиеВоВремяЗапускаПодтверждено = Истина;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

// Текст вопроса о закрытии формы во время запуска.
//
// Возвращаемое значение:
//  Строка
//
&НаКлиентеНаСервереБезКонтекста
Функция ТекстВопросаЗакрытияВоВремяЗапуска()

	Возврат "Идет запуск: создание и проверка поручений. Если закрыть форму, запуск прервется - часть портфелей "
		+ "останется без поручений. Закрыть форму?";

КонецФункции

#КонецОбласти

#Область ЗапускиСФормы

// Есть ли в базе активный запуск обработки с формы: покупка или продажа в фоне, потоки
// реинвестирования или продаж под блокировки. Проверка по всей базе, без отбора по пользователю: запуск одного
// трейдера закрывает кнопки остальным, чтобы проверка лимитов не шла параллельно по одним портфелям.
//
// Возвращаемое значение:
//  Булево
//
&НаСервереБезКонтекста
Функция ЕстьАктивныеЗапуски()

	ИменаЗаданий = СтрРазделить("ПродажиРеинвестирование,ПродажиПодБлокировки,РОСТ.ПокупкаИзФормы,РОСТ.ПродажаИзФормы", ",");

	// Без права администрирования платформа возвращает только задания текущего пользователя; читаются только
	// наименования активных заданий.
	УстановитьПривилегированныйРежим(Истина);
	АктивныеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно));
	УстановитьПривилегированныйРежим(Ложь);

	Для Каждого Задание Из АктивныеЗадания Цикл
		Для Каждого ИмяЗадания Из ИменаЗаданий Цикл
			Если СтрНайти(Задание.Наименование, ИмяЗадания) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Доступность четырех кнопок запуска: покупка, продажа, реинвестирование в потоках, продажи под
// блокировки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - эта форма
//  Доступность - Булево
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКнопокЗапуска(Форма, Доступность)

	Форма.Элементы.СписокПортфелейПокупкаСоздатьОтправитьПорученияПокупка.Доступность = Доступность;
	Форма.Элементы.СоздатьПорученияПродажа.Доступность = Доступность;
	Форма.Элементы.СписокПортфелейРеинвестированиеРеинвестСоздатьПорученияВПотоке.Доступность = Доступность;
	Форма.Элементы.СписокПортфелейПродажиПодБлокировкиБлокировкиПродажиОтправитьПачкуПоручений.Доступность = Доступность;

КонецПроцедуры

// Обработчик ожидания формы, открытой во время запуска: включает кнопки, когда активных запусков нет.
//
&НаКлиенте
Процедура ПроверитьЗавершениеДругихЗапусков() Экспорт

	Если ЗапускСФормыИдет = Истина Или ЕстьАктивныеЗапуски() Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ПроверитьЗавершениеДругихЗапусков");
	УстановитьДоступностьКнопокЗапуска(ЭтотОбъект, Истина);

КонецПроцедуры

// Проверяет, что запуск с формы можно начать: на этой форме запуск не идет и в базе нет активных
// запусков обработки с формы (см. ЕстьАктивныеЗапуски). Иначе сообщает пользователю.
//
// Возвращаемое значение:
//  Булево - Истина, если запуск можно начать
//
&НаКлиенте
Функция МожноНачатьЗапуск()

	Если ЗапускСФормыИдет = Истина Или ЕстьАктивныеЗапуски() Тогда
		Сообщить("Дождитесь завершения текущего запуска: покупки, продажи, реинвестирования или продаж под блокировки");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Отмечает начало запуска с формы: недоступны все четыре кнопки запуска.
//
&НаКлиенте
Процедура НачатьЗапускСФормы()

	ЗапускСФормыИдет = Истина;
	ОшибкиЗапуска = Ложь;
	УстановитьДоступностьКнопокЗапуска(ЭтотОбъект, Ложь);

КонецПроцедуры

// Завершает запуск с формы: итог в строке хода, кнопки запуска снова доступны.
//
// Параметры:
//  Итог - Строка - итог для строки хода; по умолчанию "Поручения отправлены" или, если в запуске были ошибки,
//         "Завершено с ошибками, см. лог"
//
&НаКлиенте
Процедура ЗакончитьЗапускСФормы(Знач Итог = "")

	Если Не ЗначениеЗаполнено(Итог) Тогда
		Если ОшибкиЗапуска = Истина Тогда
			Итог = "Завершено с ошибками, см. лог";
		Иначе
			Итог = "Поручения отправлены";
		КонецЕсли;
	КонецЕсли;

	ЗавершитьПоказЦенВРаботе(Итог);
	ЗапускСФормыИдет = Ложь;
	УстановитьДоступностьКнопокЗапуска(ЭтотОбъект, Истина);

КонецПроцедуры

// Запускает продажу или покупку кнопкой формы в фоновом задании и показывает цены в работе.
//
// Форма не блокируется: кнопки запуска недоступны до завершения задания, таблица "Цены в работе" обновляется
// по прогрессу длительной операции, сообщения задания выводятся по мере получения.
//
// Параметры:
//  ИмяМетода - Строка - процедура модуля объекта: "ПродажаИзФормы" или "ПокупкаИзФормы"
//
&НаКлиенте
Процедура ЗапуститьИзФормыВФоне(ИмяМетода)

	// Один запуск с формы за раз (по всей базе)
	Если Не МожноНачатьЗапуск() Тогда
		Возврат;
	КонецЕсли;

	Задание = ЗапуститьИзФормыВФонеНаСервере(ИмяМетода);
	Если Задание.Статус = "Ошибка" Тогда
		Сообщить("Ошибка создания фонового задания, детали в логе");
		Объект.Лог.ДобавитьСтроку("[err] ошибка создания задания " + ИмяМетода);
		Объект.Лог.ДобавитьСтроку(Задание.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	НачатьПоказЦенВРаботе();
	НачатьЗапускСФормы();

	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ВыводитьОкноОжидания = Ложь;
	НастройкиОжидания.ВыводитьСообщения = Истина;
	НастройкиОжидания.ВыводитьПрогрессВыполнения = Истина;
	НастройкиОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ПрогрессЦенВРаботе", ЭтотОбъект);
	НастройкиОжидания.Интервал = 1;

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеЗавершенияЗапускаИзФормы", ЭтотОбъект, ИмяМетода);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Задание, ОповещениеОЗавершении, НастройкиОжидания);

КонецПроцедуры

// Запускает процедуру модуля объекта ПродажаИзФормы или ПокупкаИзФормы в фоновом задании.
//
// Параметры:
//  ИмяМетода - Строка - "ПродажаИзФормы" или "ПокупкаИзФормы"
//
// Возвращаемое значение:
//  Структура - см. ДлительныеОперации.ВыполнитьВФоне
//
&НаСервере
Функция ЗапуститьИзФормыВФонеНаСервере(Знач ИмяМетода)

	Если ДополнительнаяОбработка.Пустая() Тогда
		Сообщить("Не определена обработка для определения настроек!");
	КонецЕсли;

	ПараметрыПроцедурыМодуляОбъекта = Новый Структура;
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ОбработкаСсылка", ДополнительнаяОбработка);
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ПоказыватьЦеныВРаботе", Истина);
	Если ИмяМетода = "ПродажаИзФормы" Тогда
		ПараметрыПроцедурыМодуляОбъекта.Вставить("СписокПортфелей", Объект.СписокПортфелейПродажа.Выгрузить());
		ПараметрыПроцедурыМодуляОбъекта.Вставить("НеПоказыватьПортфелиСПоручениями", НеПоказыватьПортфелиСПоручениями);
	Иначе
		ПараметрыПроцедурыМодуляОбъекта.Вставить("СписокПортфелей", Объект.СписокПортфелейПокупка.Выгрузить());
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "РОСТ." + ИмяМетода;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;

	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяОбработки", 		"ВнешняяОбработка.СозданиеТорговыхПорученийРОСТ");
	ПараметрыЗадания.Вставить("ИмяМетода", 			ИмяМетода);
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", 	ПараметрыПроцедурыМодуляОбъекта);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", 	Истина);
	ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработка);

	ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки";

	Возврат ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения);

КонецФункции

// Завершение фоновой продажи или покупки: список портфелей и лог из результата задания.
//
// Параметры:
//  Задание - Структура, Неопределено - см. ДлительныеОперацииКлиент.ОжидатьЗавершение; Неопределено - задание отменено
//  ИмяМетода - Строка - "ПродажаИзФормы" или "ПокупкаИзФормы"
//
&НаКлиенте
Процедура ПослеЗавершенияЗапускаИзФормы(Задание, ИмяМетода) Экспорт

	Если Задание = Неопределено Тогда
		ЗакончитьЗапускСФормы("Задание отменено");
		Возврат;
	КонецЕсли;

	ВывестиСообщенияЗадания(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Задание, "Сообщения"));

	Если Задание.Статус = "Ошибка" Тогда
		ЗакончитьЗапускСФормы("Ошибка выполнения");
		Сообщить("Ошибка выполнения фонового задания, детали в логе");
		Объект.Лог.ДобавитьСтроку("[err] ошибка выполнения задания " + ИмяМетода);
		Объект.Лог.ДобавитьСтроку(Задание.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	ВажностьОшибки = ЗагрузитьРезультатЗапускаИзФормы(Задание.АдресРезультата, ИмяМетода);
	Если ВажностьОшибки = 2 Тогда
		ОшибкиЗапуска = Истина;
	КонецЕсли;
	ЗакончитьЗапускСФормы();

	Если ВажностьОшибки = 2 Тогда
		Если ИмяМетода = "ПродажаИзФормы" Тогда
			Сообщить("В процессе создания поручений произошли ошибки. Подробности см. в логе ошибок");
		Иначе
			Сообщить("В процессе создания неторговых поручений произошли ошибки. Подробности см. в логе ошибок");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Переносит результат фоновой продажи или покупки в форму.
//
// Параметры:
//  АдресРезультата - Строка - адрес временного хранилища, см. РезультатЗапускаИзФормы модуля объекта
//  ИмяМетода - Строка - "ПродажаИзФормы" или "ПокупкаИзФормы"
//
// Возвращаемое значение:
//  Число - важность ошибки запуска: 2 - были ошибки
//
&НаСервере
Функция ЗагрузитьРезультатЗапускаИзФормы(Знач АдресРезультата, Знач ИмяМетода)

	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Объект.Лог.ДобавитьСтроку("[err] Ошибка получения результата из: " + АдресРезультата);
		Возврат 2;
	КонецЕсли;

	Если ИмяМетода = "ПродажаИзФормы" Тогда
		Объект.СписокПортфелейПродажа.Загрузить(Результат.СписокПортфелей);
	Иначе
		Объект.СписокПортфелейПокупка.Загрузить(Результат.СписокПортфелей);
	КонецЕсли;
	Объект.Лог.ДобавитьСтроку(СокрП(Результат.Лог));

	Возврат Результат.ВажностьОшибки;

КонецФункции

// Выводит сообщения фонового задания пользователю.
//
// Параметры:
//  Сообщения - ФиксированныйМассив из СообщениеПользователю, Неопределено
//
&НаКлиенте
Процедура ВывестиСообщенияЗадания(Сообщения)

	Если Сообщения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Сообщение Из Сообщения Цикл
		Сообщение.Сообщить();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПотокиИОтправкаПачки

// Отмечает поток формы завершенным и сообщает, завершены ли все потоки запуска.
//
// Поток отмечается и при ошибке задания: иначе пачка не отправится. Повторное оповещение того же потока
// ничего не меняет.
//
// Параметры:
//  СписокЗаданий - ДанныеФормыКоллекция - СписокЗаданийРеинвест или СписокЗаданийПродажиБлоки
//  НомерПотока - Число - номер потока (колонка Ид)
//
// Возвращаемое значение:
//  Булево - Истина, если этим оповещением завершился последний поток запуска
//
&НаКлиенте
Функция ОтметитьЗавершениеПотока(СписокЗаданий, НомерПотока)

	НайденныеСтроки = СписокЗаданий.НайтиСтроки(Новый Структура("Ид", НомерПотока));
	Если Не ЗначениеЗаполнено(НайденныеСтроки) Или НайденныеСтроки[0].Завершено = 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	НайденныеСтроки[0].Завершено = 1;
	НайденныеСтроки[0].ДатаФиниш = ТекущаяДата();

	Возврат СписокЗаданий.Итог("Стартовано") = СписокЗаданий.Итог("Завершено");

КонецФункции

// Переносит лог и поручения потока в форму; при ошибке потока пишет ее в лог.
//
// Параметры:
//  Задание - Структура - см. ДлительныеОперацииКлиент.ОжидатьЗавершение
//  ПорученияНаОтправку - Массив из ДокументСсылка.Поручение - пачка запуска, дополняется поручениями потока
//
&НаКлиенте
Процедура ДобавитьРезультатПотока(Задание, ПорученияНаОтправку)

	СтруктураОтвета = ПолучитьИзВременногоХранилища(Задание.АдресРезультата);
	Если СтруктураОтвета = Неопределено Тогда
		ОшибкиЗапуска = Истина;
		Объект.Лог.ДобавитьСтроку("[err] Ошибка получения результата потока из: " + Задание.АдресРезультата);
		Если Задание.Статус = "Ошибка" Тогда
			Объект.Лог.ДобавитьСтроку(Задание.ПодробноеПредставлениеОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Объект.Лог.ДобавитьСтроку(СокрЛП(СтруктураОтвета.Лог));
	Если СтруктураОтвета.ВажностьОшибки = 2 Тогда
		ОшибкиЗапуска = Истина;
	КонецЕсли;
	Для Каждого ПоручениеСсылка Из СтруктураОтвета.ПорученияНаОтправку Цикл
		ПорученияНаОтправку.Добавить(ПоручениеСсылка);
	КонецЦикла;

КонецПроцедуры

// Строка хода перед отправкой пачки после потоков; обновление таблицы по таймеру останавливается,
// чтобы строка не перезаписалась до отправки.
//
// Параметры:
//  КоличествоПоручений - Число - поручений в пачке
//
&НаКлиенте
Процедура ПоказатьЭтапОтправкиПачки(КоличествоПоручений)

	ОтключитьОбработчикОжидания("ОбновитьВозрастЦенВРаботе");
	ОбновитьТаблицуЦенВРаботе();
	ЭтапЦенВРаботе = СтрШаблон("Проверка лимитов и отправка: %1 поручений", Формат(КоличествоПоручений, "ЧН=0; ЧГ=0"));

КонецПроцедуры

// Отправка пачки потоков реинвестирования (обработчик ожидания после завершения всех потоков).
//
&НаКлиенте
Процедура ОтправитьПачкуРеинвестирования() Экспорт

	ОтправитьПачкуПорученийНаСервере(СписокПорученийНаОтправку);
	Сообщить("Создание и отправка поручений на реинвестирование купона завершено!");
	РеинвестОбновитьСписокПотфелейНаСервере();
	СписокЗаданийРеинвест.Очистить();
	ЗакончитьЗапускСФормы();

КонецПроцедуры

// Отправка пачки потоков продаж под блокировки (обработчик ожидания после завершения всех потоков).
//
&НаКлиенте
Процедура ОтправитьПачкуПродажПодБлокировки() Экспорт

	ОтправитьПачкуПорученийНаСервере(СписокПорученийНаОтправкуПодБлок);
	Сообщить("Создание и отправка поручений под блокировки завершено!");
	БлокировкиПродажиОбновитьСписокПортфелейНаСервере();
	СписокЗаданийПродажиБлоки.Очистить();
	ЗакончитьЗапускСФормы();

КонецПроцедуры

#КонецОбласти

#Область ЦеныВРаботе

// Очищает таблицу "Цены в работе" перед фоновым запуском и включает обновление возраста цен.
//
&НаКлиенте
Процедура НачатьПоказЦенВРаботе()

	ДанныеЦенВРаботе = Новый Соответствие;
	ЦеныВРаботе.Очистить();
	ЭтапЦенВРаботе = "Запуск";
	ПодключитьОбработчикОжидания("ОбновитьВозрастЦенВРаботе", 1);

КонецПроцедуры

// Останавливает обновление таблицы "Цены в работе"; последние цены остаются на форме.
//
// Параметры:
//  Итог - Строка - итог запуска для строки хода
//
&НаКлиенте
Процедура ЗавершитьПоказЦенВРаботе(Итог)

	ОтключитьОбработчикОжидания("ОбновитьВозрастЦенВРаботе");
	ВсегоПоручений = ОбновитьТаблицуЦенВРаботе();
	ЭтапЦенВРаботе = СтрШаблон("%1. Поручений создано: %2", Итог, Формат(ВсегоПоручений, "ЧН=0; ЧГ=0"));

КонецПроцедуры

// Оповещение о прогрессе фонового задания продажи, покупки или потока формы.
//
// Параметры:
//  Прогресс - Структура, Неопределено - см. ДлительныеОперацииКлиент.ПараметрыОжидания, ОповещениеОПрогрессеВыполнения
//  ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура ПрогрессЦенВРаботе(Прогресс, ДополнительныеПараметры) Экспорт

	Если Прогресс = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВывестиСообщенияЗадания(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Прогресс, "Сообщения"));

	Данные = Неопределено;
	ПрогрессЗадания = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Прогресс, "Прогресс");
	Если ТипЗнч(ПрогрессЗадания) <> Тип("Структура")
		Или Не ПрогрессЗадания.Свойство("ДополнительныеПараметры", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеЦенВРаботе = Неопределено Тогда
		ДанныеЦенВРаботе = Новый Соответствие;
	КонецЕсли;
	ДанныеЦенВРаботе.Вставить(Данные.НомерПотока, Новый Структура("Этап, Цены, Принято",
		Данные.Этап, Данные.Цены, ТекущаяУниверсальнаяДатаВМиллисекундах()));
	ОбновитьТаблицуЦенВРаботе();

КонецПроцедуры

// Обработчик ожидания: каждую секунду пересчитывает возраст цен в таблице "Цены в работе".
//
&НаКлиенте
Процедура ОбновитьВозрастЦенВРаботе() Экспорт

	ОбновитьТаблицуЦенВРаботе();

КонецПроцедуры

// Строит таблицу "Цены в работе" и строку хода из последних цен запуска или потоков.
//
// Строка таблицы - бумага и направление. У потоков реинвестирования и продаж под блокировки свои цены одной
// бумаги: в таблице показывается самая свежая, поручения суммируются. Возраст цены - возраст в момент сообщения
// плюс время, прошедшее после его получения.
//
// Возвращаемое значение:
//  Число - поручений создано во всех потоках
//
&НаКлиенте
Функция ОбновитьТаблицуЦенВРаботе()

	ЦеныВРаботе.Очистить();
	ВсегоПоручений = 0;
	// До первого сообщения задания строка хода остается "Запуск".
	Если ДанныеЦенВРаботе = Неопределено Или ДанныеЦенВРаботе.Количество() = 0 Тогда
		Возврат ВсегоПоручений;
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПотоковСоздали = 0;
	Этап = "";
	Для Каждого ЭлементДанных Из ДанныеЦенВРаботе Цикл
		ДанныеПотока = ЭлементДанных.Значение;
		Этап = ДанныеПотока.Этап;
		Если Этап = "Поручения потока созданы" Тогда
			ПотоковСоздали = ПотоковСоздали + 1;
		КонецЕсли;
		Прошло = Цел((Сейчас - ДанныеПотока.Принято) / 1000);

		Для Каждого ОписаниеЦены Из ДанныеПотока.Цены Цикл
			Возраст = ОписаниеЦены.ВозрастСек + Прошло;
			ВсегоПоручений = ВсегоПоручений + ОписаниеЦены.Поручений;
			Отбор = Новый Структура("Актив, Направление", ОписаниеЦены.Актив, ОписаниеЦены.Направление);
			НайденныеСтроки = ЦеныВРаботе.НайтиСтроки(Отбор);
			Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
				СтрокаЦены = ЦеныВРаботе.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаЦены, ОписаниеЦены);
				СтрокаЦены.ВозрастСек = Возраст;
				Продолжить;
			КонецЕсли;
			СтрокаЦены = НайденныеСтроки[0];
			СтрокаЦены.Поручений = СтрокаЦены.Поручений + ОписаниеЦены.Поручений;
			Если Возраст < СтрокаЦены.ВозрастСек Тогда
				ЗаполнитьЗначенияСвойств(СтрокаЦены, ОписаниеЦены, "Цена, Источник, ВремяЦены, ПорученийПоЦене");
				СтрокаЦены.ВозрастСек = Возраст;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ВсегоПорученийСтрокой = Формат(ВсегоПоручений, "ЧН=0; ЧГ=0");
	Если ДанныеЦенВРаботе.Получить(0) <> Неопределено Тогда
		ЭтапЦенВРаботе = СтрШаблон("%1. Поручений создано: %2", Этап, ВсегоПорученийСтрокой);
	Иначе
		ЭтапЦенВРаботе = СтрШаблон("Создание поручений в потоках: завершили %1 из %2. Поручений создано: %3",
			ПотоковСоздали, ДанныеЦенВРаботе.Количество(), ВсегоПорученийСтрокой);
	КонецЕсли;

	Возврат ВсегоПоручений;

КонецФункции

#КонецОбласти

#КонецОбласти
