&НаСервере
Функция ПроверитьЕстьАктивныеЗаданияПоОперации(Знач СписокЗаданий)
	
	ЗаданиеУжеЗапущено = Ложь;
	Для каждого СтрокаЗадание Из СписокЗаданий Цикл
		Если ЗначениеЗаполнено(СтрокаЗадание.ИдентификаторЗадания) Тогда
			Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(СтрокаЗадание.ИдентификаторЗадания);
			Если Задание <> Неопределено
				И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				ЗаданиеУжеЗапущено = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗаданиеУжеЗапущено;
КонецФункции

&НаСервере
Процедура УстановитьДоступностьКнопокПоАктивныиЗаданиям()
	
	ЕстьАктивныеЗаданияПродажиПодБлокировки = Ложь;
	ЕстьАктивныеЗаданияРеинвестирования = Ложь;
	
	СписокЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно));
	Для каждого СтрокаЗадание Из СписокЗаданий Цикл
		//Сообщить(СтрШаблон("Наименование: %1. ", СтрокаЗадание.Наименование));
		Если СтрНайти(СтрокаЗадание.Наименование , "ПродажиПодБлокировки") > 0 Тогда
			ЕстьАктивныеЗаданияПродажиПодБлокировки = Истина;
		ИначеЕсли СтрНайти(СтрокаЗадание.Наименование , "ПродажиРеинвестирование") > 0 Тогда
			ЕстьАктивныеЗаданияРеинвестирования = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.СписокПортфелейПродажиПодБлокировкиБлокировкиПродажиОтправитьПачкуПоручений.Доступность = Не ЕстьАктивныеЗаданияПродажиПодБлокировки;
	Элементы.СписокПортфелейРеинвестированиеРеинвестСоздатьПорученияВПотоке.Доступность = не ЕстьАктивныеЗаданияРеинвестирования;
	
КонецПроцедуры


&НаСервере
Функция РеинвестСоздатьПорученияВФонеНаСервере(УникальныйИдентификатор, НомерПотока, РазмерПакета, ВсегоПотоков)
	
	Если ДополнительнаяОбработка.Пустая() Тогда
		Сообщить("Не определена обработка для определения настроек!");
	КонецЕсли;
	
	АдресВХранилище = ПоместитьВоВременноеХранилище(Неопределено);
	ПортфелиСписок = новый Массив;
	
	//НомСтарт = (НомерПотока - 1) * РазмерПакета; 
	//НомФиниш = ?(НомерПотока = ВсегоПотоков, Объект.СписокПортфелейРеинвестирование.Количество() - 1, НомерПотока * РазмерПакета); 
	//
	//Если НомФиниш > (Объект.СписокПортфелейРеинвестирование.Количество() -1) Тогда
	//	НомФиниш = Объект.СписокПортфелейРеинвестирование.Количество() -1;
	//КонецЕсли;
	СписСтрок = Объект.СписокПортфелейРеинвестирование.НайтиСтроки(новый Структура("НомерПотока", НомерПотока));
	
	Для Каждого СтрокаТаб Из СписСтрок Цикл
		
		//СтрокаТаб = Объект.СписокПортфелейРеинвестирование.Получить(Сч);
		//Если СтрокаТаб = Неопределено Тогда
		//	Продолжить;
		//КонецЕсли;
		//
		//Если не СтрокаТаб.Пометка Тогда 
		//	Продолжить;
		//КонецЕсли;
		
		НовСтрока = новый Структура("Портфель,СубПортфель,Актив,СуммаРеинвестирования,Поручение");
		ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТаб);
		ПортфелиСписок.Добавить(НовСтрока);
		
	КонецЦикла;
	
	РазмерПакета = ПортфелиСписок.Количество();
	
	Если РазмерПакета = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ПродажиРеинвестирование#" + НомерПотока;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина; 
	ПараметрыВыполнения.Вставить("АдресРезультата", АдресВХранилище);
	
	ПараметрыПроцедурыМодуляОбъекта = Новый Структура;
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ПортфелиСписок", новый ФиксированныйМассив(ПортфелиСписок));   
	ПараметрыПроцедурыМодуляОбъекта.Вставить("НомерПотока", НомерПотока);   
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ОбработкаСсылка", ДополнительнаяОбработка);   
	// IMDEV-9530: размер пакета на запуск для комментария замера потока - портфели, распределенные по потокам
	// в этом нажатии кнопки (номер потока больше нуля); реквизит ПорученийВПакете - только верхняя граница
	ПортфелейВПакете = 0;
	Для Каждого СтрокаПакета Из Объект.СписокПортфелейРеинвестирование Цикл
		Если СтрокаПакета.НомерПотока > 0 Тогда
			ПортфелейВПакете = ПортфелейВПакете + 1;
		КонецЕсли;
	КонецЦикла;
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ПортфелейВПакете", ПортфелейВПакете);
	// IMDEV-9531: поток передает цены поручений на форму
	ПараметрыПроцедурыМодуляОбъекта.Вставить("ПоказыватьЦеныВРаботе", Истина);
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяОбработки", 		"ВнешняяОбработка.СозданиеТорговыхПорученийРОСТ");
	ПараметрыЗадания.Вставить("ИмяМетода", 			"РеинвестСоздатьОрдера");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", 	ПараметрыПроцедурыМодуляОбъекта);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", 	Истина);
	ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработка);
	
	ВыполняемыйМетод = "ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки";
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(ВыполняемыйМетод, ПараметрыЗадания, ПараметрыВыполнения);
	
	Возврат ДлительнаяОперация;	
	
КонецФункции

&НаКлиенте
Процедура РеинвестСоздатьПорученияВПотоке(Команда)
	
	Если ПроверитьЕстьАктивныеЗаданияПоОперации(СписокЗаданийРеинвест) Тогда
		Сообщить("Задание уже запупщено");
		Возврат;
	КонецЕсли;

	СписокПорученийНаОтправку = новый Массив;
	
	СделокОтправлено = 0;
	ПортфелейОтмечено = 0;
	КоличествоПотоков = 10;
	КоличествоПорученй = Объект.СписокПортфелейРеинвестирование.Количество();
	КолвоСделокНаПоток = Цел(КоличествоПорученй/КоличествоПотоков);
	
	НомерТекПотока = 1;
	
	Для каждого СтрокаТабл Из Объект.СписокПортфелейРеинвестирование Цикл
		
		СтрокаТабл.НомерПотока = 0;
		
		Если не СтрокаТабл.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТабл.Поручение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТабл.СуммаРеинвестирования <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПортфелейОтмечено < ПорученийВПакете Тогда
			СтрокаТабл.НомерПотока = НомерТекПотока;
			ПортфелейОтмечено = ПортфелейОтмечено + 1;
			
			НомерТекПотока = ?(НомерТекПотока = КоличествоПотоков, 1, НомерТекПотока + 1);
		Иначе
			СтрокаТабл.НомерПотока = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	СписокЗаданийРеинвест.Очистить();
	
	НачатьПоказЦенВРаботе();
	
	Для сч = 1 по КоличествоПотоков Цикл
		
		Задание = РеинвестСоздатьПорученияВФонеНаСервере(УникальныйИдентификатор, Сч, КолвоСделокНаПоток, КоличествоПотоков);
		
		Если Задание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		НастройкиОжидания.ВыводитьОкноОжидания = Ложь;
		// IMDEV-9531: цены потока на форму через прогресс длительной операции
		НастройкиОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ПрогрессЦенВРаботе", ЭтотОбъект);
		НастройкиОжидания.ВыводитьПрогрессВыполнения = Истина;
		НастройкиОжидания.Интервал = 3;

		ОповещениеОЗавершении = Новый ОписаниеОповещения(
			"ПослеЗавершенияСозданияПорученийРеинвестирование", 
			ЭтотОбъект);

		Если Задание.Статус = "Ошибка" Тогда
			Сообщить("Ошибка создания задания, детали в логе ");
			Объект.Лог.ДобавитьСтроку("[err] ошибка создания задания "+сч);
			Объект.Лог.ДобавитьСтроку(Задание.ПодробноеПредставлениеОшибки);
		Иначе
			ДлительныеОперацииКлиент.ОжидатьЗавершение(Задание, ОповещениеОЗавершении, НастройкиОжидания);
			НовСтрока = СписокЗаданийРеинвест.Добавить();
			НовСтрока.Ид = сч;
			НовСтрока.ДатаСтарт = ТекущаяДата();
			НовСтрока.Стартовано = 1;
			НовСтрока.Завершено = 0;
			НовСтрока.ИдентификаторЗадания = Задание.ИдентификаторЗадания;
			
			Элементы.СписокПортфелейРеинвестированиеРеинвестСоздатьПорученияВПотоке.Доступность = Ложь;
		КонецЕсли; 
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗавершенияСозданияПорученийРеинвестирование(Задание, ДополнительныеПараметры) Экспорт 

	ЕстьАктивныеЗадания = ПроверитьЕстьАктивныеЗаданияПоОперации(СписокЗаданийРеинвест);
	Элементы.СписокПортфелейРеинвестированиеРеинвестСоздатьПорученияВПотоке.Доступность = не ЕстьАктивныеЗадания;
	
	Если Задание = Неопределено Тогда
		Сообщить("Ошибка завершения задания ""поручения на реинвестирование"" неопределено???");
		Объект.Лог.ДобавитьСтроку("Ошибка завершения задания ""поручения на реинвестирование"" неопределено???");
		Возврат;
	КонецЕсли;
	
	СтруктураОтвета = ПолучитьИзВременногоХранилища(Задание.АдресРезультата);
	
	Если СтруктураОтвета = Неопределено Тогда
		Объект.Лог.ДобавитьСтроку("Ошибка получения результат из: " + Задание.АдресРезультата);
	Иначе
		Объект.Лог.ДобавитьСтроку(СокрЛП(СтруктураОтвета.Лог));
		Если СтруктураОтвета.НомерПотока <= СписокЗаданийРеинвест.Количество() Тогда
			СтрокаЗадания = СписокЗаданийРеинвест.Получить(СтруктураОтвета.НомерПотока-1);
			СтрокаЗадания.ДатаФиниш = ТекущаяДата();
			СтрокаЗадания.Завершено = 1;
		КонецЕсли;
		
		Для каждого ПоручениеСсылка Из СтруктураОтвета.ПорученияНаОтправку Цикл
			СписокПорученийНаОтправку.Добавить(ПоручениеСсылка);
		КонецЦикла;
	КонецЕсли;
	
	Если СписокЗаданийРеинвест.Итог("Стартовано") = СписокЗаданийРеинвест.Итог("Завершено") Тогда
		ОтправитьПачкуПорученийНаСервере(СписокПорученийНаОтправку);
		Сообщить("Создание и отправка поручений на реинвестирование купона завершено!");
		ЗавершитьПоказЦенВРаботе("Поручения отправлены");
		РеинвестОбновитьСписокПотфелейНаСервере();
	КонецЕсли;
	
	Если не ЕстьАктивныеЗадания Тогда
		СписокЗаданийРеинвест.Очистить();
	КонецЕсли;
	
КонецПроцедуры

