// IMDEV-9531: служебная обработка для копии ПРОД (Т-1). Почему ручная продажа РОСТ не использовала кеш цены стакана:
// какая версия обработки создавала поручения (по комментарию замеров: версии 1.24 и новее пишут "Кеш стакана: N с"),
// в каком сеансе и с какого момента этот сеанс работал, какие карточки обработки РОСТ зарегистрированы и какая
// версия в них загружена, когда загружалась (история версий карточки). Данные не меняет.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Собирает сведения за период. Каждый раздел выполняется отдельно: ошибка раздела пишется в "ошибки",
// остальные разделы выполняются.
//
// Параметры:
//  ДнейИстории - Число - глубина анализа замеров, дней до сегодня
//
// Возвращаемое значение:
//  Структура - результат из строк, чисел, булевых значений, структур и массивов (пригоден для ЗаписатьJSON)
//
Функция Анализ(ДнейИстории) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("версия_анализа", "1.0");
	Результат.Вставить("ошибки", Новый Массив);

	Дней = ДнейИстории;
	Если Дней <= 0 Тогда
		Дней = 7;
	КонецЕсли;
	Начало = НачалоДня(ТекущаяДатаСеанса()) - Дней * 86400;

	Попытка
		Результат.Вставить("база", СведенияОБазе(Начало));
	Исключение
		ДобавитьОшибку(Результат, "база");
	КонецПопытки;
	Попытка
		Результат.Вставить("карточки_РОСТ", КарточкиРОСТ());
	Исключение
		ДобавитьОшибку(Результат, "карточки_РОСТ");
	КонецПопытки;
	Попытка
		Результат.Вставить("история_карточек", ИсторияКарточек());
	Исключение
		ДобавитьОшибку(Результат, "история_карточек");
	КонецПопытки;

	Запуски = Новый Массив;
	Попытка
		Запуски = ЗапускиРОСТ(Начало);
		Результат.Вставить("запуски", Запуски);
	Исключение
		ДобавитьОшибку(Результат, "запуски");
	КонецПопытки;
	Попытка
		Результат.Вставить("цены_по_дням", ЦеныПоДням(Начало));
	Исключение
		ДобавитьОшибку(Результат, "цены_по_дням");
	КонецПопытки;
	Попытка
		Результат.Вставить("сеансы", СведенияОСеансах(Запуски, Начало - 30 * 86400));
	Исключение
		ДобавитьОшибку(Результат, "сеансы");
	КонецПопытки;

	Результат.Вставить("справка", Справка());
	Возврат Результат;

КонецФункции

// Текст результата анализа для формы: разделы и значения с отступами.
//
// Параметры:
//  Результат - Структура - см. Анализ
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстРезультата(Результат) Экспорт

	Строки = Новый Массив;
	ВывестиЗначение(Строки, Результат, "");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

