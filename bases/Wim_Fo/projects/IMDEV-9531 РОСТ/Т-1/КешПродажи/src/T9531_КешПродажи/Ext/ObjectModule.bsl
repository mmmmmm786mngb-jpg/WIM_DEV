#Область Вспомогательные

// Ключевые операции РОСТ: верхнего уровня, шаги цены и соответствие ссылки имени операции.
//
// Возвращаемое значение:
//  Структура:
//   * Верхние - Массив из СправочникСсылка.КлючевыеОперации
//   * Цены - Массив из СправочникСсылка.КлючевыеОперации - шаги ЦенаИзСтакана и ЦенаИзКеша
//   * Имена - Соответствие - ссылка -> имя без префикса "СозданиеТорговыхПорученийРОСТ."
//
Функция КлючевыеОперацииРОСТ()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Операции.Ссылка КАК Ссылка,
	|	Операции.Имя КАК Имя
	|ИЗ
	|	Справочник.КлючевыеОперации КАК Операции
	|ГДЕ
	|	Операции.Имя ПОДОБНО ""СозданиеТорговыхПорученийРОСТ.%""";

	Результат = Новый Структура("Верхние, Цены, Имена", Новый Массив, Новый Массив, Новый Соответствие);
	Префикс = "СозданиеТорговыхПорученийРОСТ.";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = Сред(Выборка.Имя, СтрДлина(Префикс) + 1);
		Результат.Имена.Вставить(Выборка.Ссылка, Имя);
		Если СтрНайти(Имя, ".") = 0 Тогда
			Результат.Верхние.Добавить(Выборка.Ссылка);
		ИначеЕсли СтрЗаканчиваетсяНа(Имя, ".ЦенаИзСтакана") Или СтрЗаканчиваетсяНа(Имя, ".ЦенаИзКеша") Тогда
			Результат.Цены.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дополняет сведения карточки размером, MD5 и версией загруженной обработки. Ошибка подключения пишется в
// сведения карточки.
//
// Параметры:
//  Карточка - Структура - сведения карточки
//  Ссылка - СправочникСсылка.ДополнительныеОтчетыИОбработки
//
Процедура ДополнитьСведениямиОбработки(Карточка, Ссылка)

	Попытка
		ДвоичныеДанные = Ссылка.ПолучитьОбъект().ХранилищеОбработки.Получить();
		Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
			Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
			Хеш.Добавить(ДвоичныеДанные);
			Карточка.Вставить("размер_байт", ДвоичныеДанные.Размер());
			Карточка.Вставить("md5", ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
		КонецЕсли;
	Исключение
		Карточка.Вставить("ошибка_данных", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		ОбъектОбработки = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Ссылка);
		Карточка.Вставить("версия_загруженной_обработки", ОбъектОбработки.СведенияОВнешнейОбработке().Версия);
	Исключение
		Карточка.Вставить("ошибка_подключения", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Поле "ДопИнф" из комментария замера в формате JSON; если разобрать не удалось - комментарий целиком.
//
// Параметры:
//  Комментарий - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ДополнительнаяИнформация(Комментарий)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Комментарий);
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ДопИнф") Тогда
			Возврат Строка(Данные.ДопИнф);
		КонецЕсли;
	Исключение
		// Комментарий не в формате JSON: возвращается как есть.
	КонецПопытки;
	Возврат Комментарий;

КонецФункции

Процедура ДобавитьОшибку(Результат, Раздел)

	Результат.ошибки.Добавить(Раздел + ": " + Лев(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), 1000));

КонецПроцедуры

Процедура ВывестиЗначение(Строки, Значение, Отступ)

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент.Значение) = Тип("Структура") Или ТипЗнч(Элемент.Значение) = Тип("Массив") Тогда
				Строки.Добавить(Отступ + Элемент.Ключ + ":");
				ВывестиЗначение(Строки, Элемент.Значение, Отступ + "    ");
			Иначе
				Строки.Добавить(Отступ + Элемент.Ключ + ": " + ЗначениеСтрокой(Элемент.Значение));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Строки.Добавить(Отступ + "(пусто)");
		КонецЕсли;
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент) = Тип("Структура") Тогда
				Строки.Добавить(Отступ + "-");
				ВывестиЗначение(Строки, Элемент, Отступ + "    ");
			Иначе
				Строки.Добавить(Отступ + "- " + ЗначениеСтрокой(Элемент));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Строки.Добавить(Отступ + ЗначениеСтрокой(Значение));
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеСтрокой(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") И Значение Тогда
		Возврат "да";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат "нет";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

