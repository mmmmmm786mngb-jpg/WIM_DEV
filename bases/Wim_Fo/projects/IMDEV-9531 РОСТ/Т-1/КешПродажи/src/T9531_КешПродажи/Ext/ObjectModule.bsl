// Строка соединения, конфигурация, платформа, пользователь, время запуска и начало периода.
//
// Параметры:
//  Начало - Дата - начало периода анализа
//
// Возвращаемое значение:
//  Структура
//
Функция СведенияОБазе(Начало)

	СистемнаяИнформация = Новый СистемнаяИнформация;
	Сведения = Новый Структура;
	Сведения.Вставить("строка_соединения", СтрокаСоединенияИнформационнойБазы());
	Сведения.Вставить("конфигурация", Метаданные.Синоним + " " + Метаданные.Версия);
	Сведения.Вставить("платформа", СистемнаяИнформация.ВерсияПриложения);
	Сведения.Вставить("пользователь", ИмяПользователя());
	Сведения.Вставить("время_запуска", Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Сведения.Вставить("период_с", Формат(Начало, "ДФ=dd.MM.yyyy"));
	Возврат Сведения;

КонецФункции

// Карточки дополнительных обработок поручений РОСТ (по имени объекта и наименованию): реквизиты карточки и версия
// загруженной в нее обработки (СведенияОВнешнейОбработке), размер и MD5 двоичных данных обработки.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция КарточкиРОСТ()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Обработки.Ссылка КАК Ссылка,
	|	Обработки.Наименование КАК Наименование,
	|	Обработки.ИмяОбъекта КАК ИмяОбъекта,
	|	Обработки.Версия КАК Версия,
	|	Обработки.ИмяФайла КАК ИмяФайла,
	|	Обработки.Вид КАК Вид,
	|	Обработки.Публикация КАК Публикация,
	|	Обработки.ПометкаУдаления КАК ПометкаУдаления,
	|	Обработки.БезопасныйРежим КАК БезопасныйРежим
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	(Обработки.ИмяОбъекта ПОДОБНО ""%Поручен%РОСТ%""
	|			ИЛИ Обработки.Наименование ПОДОБНО ""%поручений РОСТ%"")
	|	И НЕ Обработки.ЭтоГруппа";

	Карточки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карточка = Новый Структура;
		Карточка.Вставить("наименование", Выборка.Наименование);
		Карточка.Вставить("имя_объекта", Выборка.ИмяОбъекта);
		Карточка.Вставить("версия_в_карточке", Выборка.Версия);
		Карточка.Вставить("имя_файла", Выборка.ИмяФайла);
		Карточка.Вставить("вид", Строка(Выборка.Вид));
		Карточка.Вставить("публикация", Строка(Выборка.Публикация));
		Карточка.Вставить("пометка_удаления", Выборка.ПометкаУдаления);
		Карточка.Вставить("безопасный_режим", Выборка.БезопасныйРежим);
		Карточка.Вставить("уникальный_идентификатор", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		ДополнитьСведениямиОбработки(Карточка, Выборка.Ссылка);
		Карточки.Добавить(Карточка);
	КонецЦикла;
	Возврат Карточки;

КонецФункции

// История версий карточек РОСТ (подсистема версионирования объектов): номер, дата, автор версии.
// Пусто, если версионирование справочника дополнительных обработок выключено.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция ИсторияКарточек()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Обработки.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТКарточки
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	(Обработки.ИмяОбъекта ПОДОБНО ""%Поручен%РОСТ%""
	|			ИЛИ Обработки.Наименование ПОДОБНО ""%поручений РОСТ%"")
	|	И НЕ Обработки.ЭтоГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Версии.Объект КАК Объект,
	|	Версии.НомерВерсии КАК НомерВерсии,
	|	Версии.ДатаВерсии КАК ДатаВерсии,
	|	Версии.АвторВерсии КАК АвторВерсии
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК Версии
	|ГДЕ
	|	Версии.Объект В
	|			(ВЫБРАТЬ
	|				ВТКарточки.Ссылка
	|			ИЗ
	|				ВТКарточки КАК ВТКарточки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Версии.ДатаВерсии УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТКарточки";

	История = Новый Массив;
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() И История.Количество() < 30 Цикл
		Версия = Новый Структура;
		Версия.Вставить("карточка", Строка(Выборка.Объект));
		Версия.Вставить("номер", Выборка.НомерВерсии);
		Версия.Вставить("дата", Формат(Выборка.ДатаВерсии, "ДФ='dd.MM.yyyy HH:mm:ss'"));
		Версия.Вставить("автор", Строка(Выборка.АвторВерсии));
		История.Добавить(Версия);
	КонецЦикла;
	Возврат История;

КонецФункции

// Запуски РОСТ за период по замерам ключевых операций верхнего уровня (покупка, продажа, реинвестирование,
// продажа под блокировки, отправка пачки): время, сеанс, пользователь, длительность, комментарий и признак кода
// версии 1.24 и новее ("Кеш стакана: N с" в комментарии).
//
// Параметры:
//  Начало - Дата - начало периода
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция ЗапускиРОСТ(Начало)

	Операции = КлючевыеОперацииРОСТ();
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Операции", Операции.Верхние);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Замеры.КлючеваяОперация КАК КлючеваяОперация,
	|	Замеры.НомерСеанса КАК НомерСеанса,
	|	Замеры.ДатаЗаписи КАК ДатаЗаписи,
	|	Замеры.ВремяВыполнения КАК ВремяВыполнения,
	|	Замеры.ВесЗамера КАК ВесЗамера,
	|	Замеры.Пользователь КАК Пользователь,
	|	Замеры.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Замеры
	|ГДЕ
	|	Замеры.ДатаЗаписиНачалоЧаса >= &Начало
	|	И Замеры.КлючеваяОперация В (&Операции)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Замеры.ДатаЗаписи";

	Запуски = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Комментарий = Выборка.Комментарий;
		Запуск = Новый Структура;
		Запуск.Вставить("время", Формат(Выборка.ДатаЗаписи, "ДФ='dd.MM.yyyy HH:mm:ss'"));
		Запуск.Вставить("операция", Операции.Имена[Выборка.КлючеваяОперация]);
		Запуск.Вставить("сеанс", Выборка.НомерСеанса);
		Запуск.Вставить("пользователь", Выборка.Пользователь);
		Запуск.Вставить("секунд", Окр(Выборка.ВремяВыполнения, 1));
		Запуск.Вставить("вес", Выборка.ВесЗамера);
		Запуск.Вставить("код_1_24_и_новее", СтрНайти(Комментарий, "Кеш стакана") > 0);
		Запуск.Вставить("комментарий", ДополнительнаяИнформация(Комментарий));
		Запуски.Добавить(Запуск);
	КонецЦикла;
	Возврат Запуски;

КонецФункции

// Число запросов цены стакана и цен из кеша по дням и операциям (веса шагов ЦенаИзСтакана и ЦенаИзКеша).
//
// Параметры:
//  Начало - Дата - начало периода
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция ЦеныПоДням(Начало)

	Операции = КлючевыеОперацииРОСТ();
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Операции", Операции.Цены);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаЗаписи, ДЕНЬ) КАК День,
	|	Замеры.КлючеваяОперация КАК КлючеваяОперация,
	|	КОЛИЧЕСТВО(*) КАК Записей,
	|	СУММА(Замеры.ВесЗамера) КАК Вес,
	|	СУММА(Замеры.ВремяВыполнения * Замеры.ВесЗамера) КАК Секунд
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Замеры
	|ГДЕ
	|	Замеры.ДатаЗаписиНачалоЧаса >= &Начало
	|	И Замеры.КлючеваяОперация В (&Операции)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаЗаписи, ДЕНЬ),
	|	Замеры.КлючеваяОперация
	|
	|УПОРЯДОЧИТЬ ПО
	|	День";

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("день", Формат(Выборка.День, "ДФ=dd.MM.yyyy"));
		Строка.Вставить("шаг", Операции.Имена[Выборка.КлючеваяОперация]);
		Строка.Вставить("записей", Выборка.Записей);
		Строка.Вставить("цен", Выборка.Вес);
		Строка.Вставить("секунд", Окр(Выборка.Секунд, 1));
		Строки.Добавить(Строка);
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Сеансы, в которых были запуски РОСТ: первый и последний замер сеанса по всем ключевым операциям (оценка
// времени начала сеанса), число запусков кодом 1.24 и новее и более старым кодом.
//
// Параметры:
//  Запуски - Массив из Структура - см. ЗапускиРОСТ
//  НачалоПоиска - Дата - с какой даты искать первые замеры сеансов
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция СведенияОСеансах(Запуски, НачалоПоиска)

	Сеансы = Новый Соответствие;
	Номера = Новый Массив;
	Для Каждого Запуск Из Запуски Цикл
		Сведения = Сеансы[Запуск.сеанс];
		Если Сведения = Неопределено Тогда
			Сведения = Новый Структура("сеанс, пользователь, запусков_новым_кодом, запусков_старым_кодом, операции",
				Запуск.сеанс, Запуск.пользователь, 0, 0, Новый Соответствие);
			Сеансы.Вставить(Запуск.сеанс, Сведения);
			Номера.Добавить(Запуск.сеанс);
		КонецЕсли;
		Если Запуск.код_1_24_и_новее Тогда
			Сведения.запусков_новым_кодом = Сведения.запусков_новым_кодом + 1;
		Иначе
			Сведения.запусков_старым_кодом = Сведения.запусков_старым_кодом + 1;
		КонецЕсли;
		Сведения.операции.Вставить(Запуск.операция, Истина);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоПоиска);
	Запрос.УстановитьПараметр("Сеансы", Номера);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Замеры.НомерСеанса КАК НомерСеанса,
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаЗаписи, ДЕНЬ) КАК День,
	|	МИНИМУМ(Замеры.ДатаЗаписи) КАК ПервыйЗамер,
	|	МАКСИМУМ(Замеры.ДатаЗаписи) КАК ПоследнийЗамер,
	|	КОЛИЧЕСТВО(*) КАК Замеров
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Замеры
	|ГДЕ
	|	Замеры.ДатаЗаписиНачалоЧаса >= &Начало
	|	И Замеры.НомерСеанса В (&Сеансы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Замеры.НомерСеанса,
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаЗаписи, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСеанса,
	|	День";
	Границы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Граница = Границы[Выборка.НомерСеанса];
		Если Граница = Неопределено Тогда
			Граница = Новый Структура("ПервыйЗамер, ПоследнийЗамер, Замеров, ПоДням",
				Выборка.ПервыйЗамер, Выборка.ПоследнийЗамер, 0, Новый Массив);
			Границы.Вставить(Выборка.НомерСеанса, Граница);
		КонецЕсли;
		Граница.ПервыйЗамер = Мин(Граница.ПервыйЗамер, Выборка.ПервыйЗамер);
		Граница.ПоследнийЗамер = Макс(Граница.ПоследнийЗамер, Выборка.ПоследнийЗамер);
		Граница.Замеров = Граница.Замеров + Выборка.Замеров;
		Граница.ПоДням.Добавить(Формат(Выборка.День, "ДФ=dd.MM") + ": " + Формат(Выборка.Замеров, "ЧН=0; ЧГ=0")
			+ " (" + Формат(Выборка.ПервыйЗамер, "ДФ=HH:mm") + "-" + Формат(Выборка.ПоследнийЗамер, "ДФ=HH:mm") + ")");
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Номер Из Номера Цикл
		Сведения = Сеансы[Номер];
		Строка = Новый Структура;
		Строка.Вставить("сеанс", Номер);
		Строка.Вставить("пользователь", Сведения.пользователь);
		Строка.Вставить("запусков_кодом_1_24_и_новее", Сведения.запусков_новым_кодом);
		Строка.Вставить("запусков_кодом_до_1_24", Сведения.запусков_старым_кодом);
		ИменаОпераций = Новый Массив;
		Для Каждого Элемент Из Сведения.операции Цикл
			ИменаОпераций.Добавить(Элемент.Ключ);
		КонецЦикла;
		Строка.Вставить("операции", СтрСоединить(ИменаОпераций, ", "));
		Граница = Границы[Номер];
		Если Граница <> Неопределено Тогда
			Строка.Вставить("первый_замер_сеанса", Формат(Граница.ПервыйЗамер, "ДФ='dd.MM.yyyy HH:mm:ss'"));
			Строка.Вставить("последний_замер_сеанса", Формат(Граница.ПоследнийЗамер, "ДФ='dd.MM.yyyy HH:mm:ss'"));
			Строка.Вставить("замеров_сеанса", Граница.Замеров);
			Строка.Вставить("замеров_по_дням", СтрСоединить(Граница.ПоДням, "; "));
		КонецЕсли;
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

