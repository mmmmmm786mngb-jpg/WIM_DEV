#Область ОбработчикиСобытийФормы

// Заполняет параметры по умолчанию: глубина анализа 7 дней, строка соединения базы.
//
// Параметры:
//  Отказ - Булево - не используется
//  СтандартнаяОбработка - Булево - не используется
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДнейИстории      = 7;
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Собирает сведения о запусках РОСТ и кеше цены и показывает результат текстом. Данные базы не меняются.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Анализ(Команда)

	Результат = "Выполняется анализ...";
	АнализНаСервере();

КонецПроцедуры

// Предлагает сохранить результат последнего анализа в файл JSON.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(РезультатJSON) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала выполните анализ");
		Возврат;
	КонецЕсли;

	ИмяФайла = "T1_кеш_продажи_РОСТ_" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=dd.MM.yyyy") + ".json";
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресФайлаJSON(), ИмяФайла);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет анализ обработки и заполняет реквизиты Результат (текст) и РезультатJSON.
//
&НаСервере
Процедура АнализНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = Обработка.Анализ(ДнейИстории);
	Результат = Обработка.ТекстРезультата(Данные);
	РезультатJSON = Обработка.JSONРезультата(Данные);

КонецПроцедуры

// Помещает JSON результата во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла (UTF-8 без BOM)
//
&НаСервере
Функция АдресФайлаJSON()

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(РезультатJSON, "UTF-8", Ложь);
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
