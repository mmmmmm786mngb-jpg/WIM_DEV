		+ "НумераторыСделок.НовыеИдентификаторы(Нумератор, ПланОбработки.Количество()) и "
		+ "РаботаСТорговойЧастьюСлужебный.НомераНовыхЗаявок(...) (модуль Распорядители).");
	Справка.Добавить("Внутренний номер заявки (НомерВнутренний) выдается отдельно - константа ПоследнийНомерЗаявки "
		+ "(РаботаСТорговойЧастьюПолныеПрава), хранится в регистрах ИсторияВнутреннихНомеровЗаявок и БиржевыеЗаявки.");
	Возврат Справка;

КонецФункции

Функция Выводы(Результат)

	Выводы = Новый Массив;
	Если Результат.Свойство("идентификатор_ряд") Тогда
		Ряд = Результат.идентификатор_ряд;
		Выводы.Добавить(СтрШаблон("Поручение.Идентификатор за период: номеров %1, диапазон %2 - %3, недостает номеров %4 "
			+ "(пропусков %5, наибольший %6), повторов %7.", Ряд.номеров, Ряд.минимум, Ряд.максимум,
			Ряд.недостает_номеров, Ряд.пропусков, Ряд.наибольший_пропуск, Ряд.повторяющихся_значений));
	КонецЕсли;
	Если Результат.Свойство("внутренний_номер_история") Тогда
		Ряд = Результат.внутренний_номер_история;
		Выводы.Добавить(СтрШаблон("Внутренний номер заявки (история) за период: номеров %1, недостает номеров %2 "
			+ "(пропусков %3), повторов %4, поручений со сменой номера %5.", Ряд.номеров, Ряд.недостает_номеров,
			Ряд.пропусков, Ряд.повторяющихся_значений, Ряд.поручений_со_сменой_номера));
	КонецЕсли;
	Возврат Выводы;

КонецФункции

#КонецОбласти

#Область Вспомогательные

// Анализ упорядоченного по возрастанию ряда номеров: число, диапазон, пропуски и недостающие номера, наибольшие
// пропуски (до 10), число повторяющихся значений.
Функция АнализРяда(Номера)

	Сведения = Новый Структура;
	Сведения.Вставить("номеров", Ч(Номера.Количество()));
	Если Номера.Количество() = 0 Тогда
		Сведения.Вставить("минимум", "0");
		Сведения.Вставить("максимум", "0");
		Сведения.Вставить("недостает_номеров", "0");
		Сведения.Вставить("пропусков", "0");
		Сведения.Вставить("наибольший_пропуск", "0");
		Сведения.Вставить("повторяющихся_значений", "0");
		Сведения.Вставить("наибольшие_пропуски", Новый Массив);
		Возврат Сведения;
	КонецЕсли;

	Пропуски = Новый ТаблицаЗначений;
	Пропуски.Колонки.Добавить("От");
	Пропуски.Колонки.Добавить("До");
	Пропуски.Колонки.Добавить("Размер");
	Недостает = 0;
	Повторов = 0;
	Предыдущий = Номера[0];
	Для Индекс = 1 По Номера.Количество() - 1 Цикл
		Текущий = Номера[Индекс];
		Если Текущий = Предыдущий Тогда
			Повторов = Повторов + 1;
		ИначеЕсли Текущий > Предыдущий + 1 Тогда
			Строка = Пропуски.Добавить();
			Строка.От = Предыдущий + 1;
			Строка.До = Текущий - 1;
			Строка.Размер = Текущий - Предыдущий - 1;
			Недостает = Недостает + Строка.Размер;
		КонецЕсли;
		Предыдущий = Текущий;
	КонецЦикла;

	Пропуски.Сортировать("Размер Убыв");
	Наибольшие = Новый Массив;
	Для Каждого Строка Из Пропуски Цикл
		Если Наибольшие.Количество() >= 10 Тогда
			Прервать;
		КонецЕсли;
		Наибольшие.Добавить(Ч(Строка.От) + " - " + Ч(Строка.До) + ": " + Ч(Строка.Размер));
	КонецЦикла;

	Наибольший = 0;
	Если Пропуски.Количество() > 0 Тогда
		Наибольший = Пропуски[0].Размер;
	КонецЕсли;
	Сведения.Вставить("минимум", Ч(Номера[0]));
	Сведения.Вставить("максимум", Ч(Номера[Номера.Количество() - 1]));
	Сведения.Вставить("недостает_номеров", Ч(Недостает));
	Сведения.Вставить("пропусков", Ч(Пропуски.Количество()));
	Сведения.Вставить("наибольший_пропуск", Ч(Наибольший));
	Сведения.Вставить("повторяющихся_значений", Ч(Повторов));
	Сведения.Вставить("наибольшие_пропуски", Наибольшие);
	Возврат Сведения;

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция Ч(Значение)

	Возврат Формат(ЧислоИлиНоль(Значение), "ЧН=0; ЧГ=0");

КонецФункции

Процедура ДобавитьОшибку(Результат, Раздел)

	Результат.ошибки.Добавить(Раздел + ": " + Лев(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), 1000));

КонецПроцедуры

Процедура ВывестиЗначение(Строки, Значение, Отступ)

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент.Значение) = Тип("Структура") Или ТипЗнч(Элемент.Значение) = Тип("Массив") Тогда
				Строки.Добавить(Отступ + Элемент.Ключ + ":");
				ВывестиЗначение(Строки, Элемент.Значение, Отступ + "    ");
			Иначе
				Строки.Добавить(Отступ + Элемент.Ключ + ": " + ЗначениеСтрокой(Элемент.Значение));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Строки.Добавить(Отступ + "(пусто)");
		КонецЕсли;
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент) = Тип("Структура") Тогда
				Строки.Добавить(Отступ + "-");
				ВывестиЗначение(Строки, Элемент, Отступ + "    ");
			Иначе
				Строки.Добавить(Отступ + "- " + ЗначениеСтрокой(Элемент));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Строки.Добавить(Отступ + ЗначениеСтрокой(Значение));
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеСтрокой(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") И Значение Тогда
		Возврат "да";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат "нет";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

