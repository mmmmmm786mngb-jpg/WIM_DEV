// IMDEV-9531: служебная обработка для копии ПРОД (Т-1). Анализ нумерации поручений: сплошной ли ряд
// Поручение.Идентификатор (выдает регистр "Нумераторы сделок") и внутреннего номера заявки (константа "Последний
// номер заявки", регистры "История внутренних номеров заявок" и "Биржевые заявки"). Данные не меняет.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Собирает анализ нумерации поручений за период. Каждый раздел выполняется отдельно: ошибка раздела пишется в
// "ошибки", остальные разделы выполняются.
//
// Параметры:
//  ДнейИстории - Число - глубина анализа, дней до сегодня
//
// Возвращаемое значение:
//  Структура - результат из строк, чисел, булевых значений, структур и массивов (пригоден для ЗаписатьJSON)
//
Функция Анализ(ДнейИстории) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("версия_анализа", "1.0");
	Результат.Вставить("ошибки", Новый Массив);

	Дней = ДнейИстории;
	Если Дней <= 0 Тогда
		Дней = 30;
	КонецЕсли;
	Начало = НачалоДня(ТекущаяДатаСеанса()) - Дней * 86400;

	Попытка
		Результат.Вставить("база", СведенияОБазе(Начало));
	Исключение
		ДобавитьОшибку(Результат, "база");
	КонецПопытки;
	Попытка
		Результат.Вставить("нумераторы", СведенияОНумераторах());
	Исключение
		ДобавитьОшибку(Результат, "нумераторы");
	КонецПопытки;
	Попытка
		Результат.Вставить("идентификатор_по_дням", ИдентификаторПоДням(Начало));
	Исключение
		ДобавитьОшибку(Результат, "идентификатор_по_дням");
	КонецПопытки;
	Попытка
		Результат.Вставить("идентификатор_ряд", РядИдентификаторов(Начало));
	Исключение
		ДобавитьОшибку(Результат, "идентификатор_ряд");
	КонецПопытки;
	Попытка
		Результат.Вставить("внутренний_номер_история", РядВнутреннихНомеров(Начало));
	Исключение
		ДобавитьОшибку(Результат, "внутренний_номер_история");
	КонецПопытки;
	Попытка
		Результат.Вставить("биржевые_заявки", СведенияОБиржевыхЗаявках(Начало));
	Исключение
		ДобавитьОшибку(Результат, "биржевые_заявки");
	КонецПопытки;
	Попытка
		Результат.Вставить("образцы_поручений", ОбразцыПоручений(Начало));
	Исключение
		ДобавитьОшибку(Результат, "образцы_поручений");
	КонецПопытки;

	Результат.Вставить("справка", Справка());
	Результат.Вставить("выводы", Выводы(Результат));
	Возврат Результат;

КонецФункции

// Текст результата анализа для формы: разделы и значения с отступами.
//
// Параметры:
//  Результат - Структура - см. Анализ
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстРезультата(Результат) Экспорт

	Строки = Новый Массив;
	ВывестиЗначение(Строки, Результат, "");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// JSON результата анализа с отступами.
//
// Параметры:
//  Результат - Структура - см. Анализ
//
// Возвращаемое значение:
//  Строка
//
Функция JSONРезультата(Результат) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, Результат);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Разделы

Функция СведенияОБазе(Начало)

	СистемнаяИнформация = Новый СистемнаяИнформация;
	Сведения = Новый Структура;
	Сведения.Вставить("строка_соединения", СтрокаСоединенияИнформационнойБазы());
	Сведения.Вставить("конфигурация", Метаданные.Синоним + " " + Метаданные.Версия);
	Сведения.Вставить("платформа", СистемнаяИнформация.ВерсияПриложения);
	Сведения.Вставить("пользователь", ИмяПользователя());
	Сведения.Вставить("время_запуска", Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Сведения.Вставить("период_с", Формат(Начало, "ДФ=dd.MM.yyyy"));
	Сведения.Вставить("тип_Поручение_Идентификатор",
		Строка(Метаданные.Документы.Поручение.Реквизиты.Идентификатор.Тип));
	Возврат Сведения;

КонецФункции

// Счетчики нумераторов, максимальные выданные номера документов и константа внутреннего номера заявки.
Функция СведенияОНумераторах()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Нумераторы.ВидОбъекта КАК ВидОбъекта,
	|	Нумераторы.Идентификатор КАК Счетчик
	|ИЗ
	|	РегистрСведений.НумераторыСделок КАК Нумераторы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""Поручение"" КАК Документ,
	|	МАКСИМУМ(Поручения.Идентификатор) КАК МаксИдентификатор,
	|	КОЛИЧЕСТВО(Поручения.Ссылка) КАК Документов
	|ИЗ
	|	Документ.Поручение КАК Поручения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Сделка"",
	|	МАКСИМУМ(Сделки.Идентификатор),
	|	КОЛИЧЕСТВО(Сделки.Ссылка)
	|ИЗ
	|	Документ.Сделка КАК Сделки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""СделкаРЕПО"",
	|	МАКСИМУМ(СделкиРЕПО.Идентификатор),
	|	КОЛИЧЕСТВО(СделкиРЕПО.Ссылка)
	|ИЗ
	|	Документ.СделкаРЕПО КАК СделкиРЕПО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(История.НомерВнутренний) КАК МаксИстория
	|ИЗ
	|	РегистрСведений.ИсторияВнутреннихНомеровЗаявок КАК История
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Заявки.НомерВнутренний) КАК МаксЗаявки
	|ИЗ
	|	РегистрСведений.БиржевыеЗаявки КАК Заявки";
	Пакет = Запрос.ВыполнитьПакет();

	Сведения = Новый Структура;
	Счетчики = Новый Массив;
	Для Каждого Строка Из Пакет[0].Выгрузить() Цикл
		Счетчики.Добавить(Строка(Строка.ВидОбъекта) + ": " + Число(Строка.Счетчик));
	КонецЦикла;
	Сведения.Вставить("регистр_нумераторы_сделок", Счетчики);
	СписокДокументов = Новый Массив;
	Для Каждого Строка Из Пакет[1].Выгрузить() Цикл
		СписокДокументов.Добавить(СтрШаблон("%1: документов %2; максимальный Идентификатор %3", Строка.Документ,
			Формат(Строка.Документов, "ЧН=0; ЧГ=0"), Формат(ЧислоИлиНоль(Строка.МаксИдентификатор), "ЧН=0; ЧГ=0")));
	КонецЦикла;
	Сведения.Вставить("документы_максимальный_идентификатор", СписокДокументов);
	Сведения.Вставить("константа_последний_номер_заявки", Формат(Константы.ПоследнийНомерЗаявки.Получить(), "ЧН=0; ЧГ=0"));
	Сведения.Вставить("история_внутренних_номеров_максимум", Формат(ЧислоИлиНоль(Пакет[2].Выгрузить()[0].МаксИстория),
		"ЧН=0; ЧГ=0"));
	Сведения.Вставить("биржевые_заявки_внутренний_номер_максимум", Формат(ЧислоИлиНоль(Пакет[3].Выгрузить()[0].МаксЗаявки),
		"ЧН=0; ЧГ=0"));
	Возврат Сведения;

КонецФункции

// Поручения по дням: число, помеченные на удаление, без идентификатора, диапазон идентификаторов и пропуски внутри
// дня (номера выдаются по времени создания, поэтому диапазоны дней не перекрываются).
Функция ИдентификаторПоДням(Начало)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Поручения.Дата, ДЕНЬ) КАК День,
	|	КОЛИЧЕСТВО(Поручения.Ссылка) КАК Поручений,
	|	СУММА(ВЫБОР
	|			КОГДА Поручения.ПометкаУдаления
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПомеченоНаУдаление,
	|	СУММА(ВЫБОР
	|			КОГДА Поручения.Идентификатор = 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК БезИдентификатора,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Поручения.Идентификатор > 0
	|				ТОГДА Поручения.Идентификатор
	|		КОНЕЦ) КАК МинИдентификатор,
	|	МАКСИМУМ(Поручения.Идентификатор) КАК МаксИдентификатор,
	|	СУММА(ВЫБОР
	|			КОГДА Поручения.Идентификатор > 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СИдентификатором
	|ИЗ
	|	Документ.Поручение КАК Поручения
	|ГДЕ
	|	Поручения.Дата >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Поручения.Дата, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	День";
	Дни = Новый Массив;
	Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
		Мин = ЧислоИлиНоль(Строка.МинИдентификатор);
		Макс = ЧислоИлиНоль(Строка.МаксИдентификатор);
		Пропусков = 0;
		Если Макс > 0 Тогда
			Пропусков = Макс - Мин + 1 - Строка.СИдентификатором;
		КонецЕсли;
		Дни.Добавить(СтрШаблон("%1: поручений %2; помечено на удаление %3; без идентификатора %4; Идентификатор %5 - %6; "
			+ "недостает номеров %7", Формат(Строка.День, "ДФ=dd.MM.yyyy"), Ч(Строка.Поручений),
			Ч(Строка.ПомеченоНаУдаление), Ч(Строка.БезИдентификатора), Ч(Мин), Ч(Макс), Ч(Пропусков)));
	КонецЦикла;
	Возврат Дни;

КонецФункции

// Ряд Поручение.Идентификатор за период целиком: пропуски, наибольшие пропуски, повторы.
Функция РядИдентификаторов(Начало)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поручения.Идентификатор КАК Номер
	|ИЗ
	|	Документ.Поручение КАК Поручения
	|ГДЕ
	|	Поручения.Дата >= &Начало
	|	И Поручения.Идентификатор > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 10
	|	Поручения.Идентификатор КАК Номер,
	|	КОЛИЧЕСТВО(Поручения.Ссылка) КАК Поручений
	|ИЗ
	|	Документ.Поручение КАК Поручения
	|ГДЕ
	|	Поручения.Дата >= &Начало
	|	И Поручения.Идентификатор > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Поручения.Идентификатор
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(Поручения.Ссылка) > 1
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер";
	Пакет = Запрос.ВыполнитьПакет();
	Сведения = АнализРяда(Пакет[0].Выгрузить().ВыгрузитьКолонку("Номер"));
	Повторы = Новый Массив;
	Для Каждого Строка Из Пакет[1].Выгрузить() Цикл
		Повторы.Добавить(Ч(Строка.Номер) + ": поручений " + Ч(Строка.Поручений));
	КонецЦикла;
	Сведения.Вставить("повторы_первые_10", Повторы);
	Возврат Сведения;

КонецФункции

// Ряд внутренних номеров заявок по истории (поручения периода): пропуски, повторы, смены номера.
Функция РядВнутреннихНомеров(Начало)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	История.Поручение КАК Поручение,
	|	История.НомерВнутренний КАК Номер,
	|	История.ПричинаСмены КАК ПричинаСмены
	|ПОМЕСТИТЬ ВТ_История
	|ИЗ
	|	РегистрСведений.ИсторияВнутреннихНомеровЗаявок КАК История
	|ГДЕ
	|	История.Поручение.Дата >= &Начало
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_История.Номер КАК Номер
	|ИЗ
	|	ВТ_История КАК ВТ_История
	|ГДЕ
	|	ВТ_История.Номер > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_История.Поручение КАК Поручение,
	|	КОЛИЧЕСТВО(ВТ_История.Номер) КАК Номеров
	|ПОМЕСТИТЬ ВТ_НомеровНаПоручение
	|ИЗ
	|	ВТ_История КАК ВТ_История
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_История.Поручение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ВТ_НомеровНаПоручение.Поручение) КАК Поручений,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_НомеровНаПоручение.Номеров > 1
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СоСменойНомера
	|ИЗ
	|	ВТ_НомеровНаПоручение КАК ВТ_НомеровНаПоручение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_История.ПричинаСмены КАК ПричинаСмены,
	|	КОЛИЧЕСТВО(ВТ_История.Номер) КАК Записей
	|ИЗ
	|	ВТ_История КАК ВТ_История
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_История.ПричинаСмены";
	Пакет = Запрос.ВыполнитьПакет();
	Сведения = АнализРяда(Пакет[1].Выгрузить().ВыгрузитьКолонку("Номер"));
	Итоги = Пакет[3].Выгрузить()[0];
	Сведения.Вставить("поручений_с_номером", Ч(ЧислоИлиНоль(Итоги.Поручений)));
	Сведения.Вставить("поручений_со_сменой_номера", Ч(ЧислоИлиНоль(Итоги.СоСменойНомера)));
	Причины = Новый Массив;
	Для Каждого Строка Из Пакет[4].Выгрузить() Цикл
		Представление = "<не указана>";
		Если ЗначениеЗаполнено(Строка.ПричинаСмены) Тогда
			Представление = Строка(Строка.ПричинаСмены);
		КонецЕсли;
		Причины.Добавить(Представление + ": " + Ч(Строка.Записей));
	КонецЦикла;
	Сведения.Вставить("причины_смены", Причины);
	Возврат Сведения;

КонецФункции

// Биржевые заявки поручений периода: внутренний номер (ряд), заполненность внешнего и биржевого номера, адаптеры.
Функция СведенияОБиржевыхЗаявках(Начало)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявки.Поручение КАК Поручение,
	|	Заявки.Адаптер КАК Адаптер,
	|	Заявки.НомерВнутренний КАК НомерВнутренний,
	|	Заявки.НомерВнешний КАК НомерВнешний,
	|	Заявки.НомерБиржевой КАК НомерБиржевой
	|ПОМЕСТИТЬ ВТ_Заявки
	|ИЗ
	|	РегистрСведений.БиржевыеЗаявки КАК Заявки
	|ГДЕ
	|	Заявки.Поручение.Дата >= &Начало
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заявки.НомерВнутренний КАК Номер
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|ГДЕ
	|	ВТ_Заявки.НомерВнутренний > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ВТ_Заявки.Поручение) КАК Записей,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Заявки.НомерВнешний > 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СВнешним,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Заявки.НомерБиржевой <> """"
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СБиржевым
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заявки.Адаптер КАК Адаптер,
	|	КОЛИЧЕСТВО(ВТ_Заявки.Поручение) КАК Записей
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Заявки.Адаптер";
	Пакет = Запрос.ВыполнитьПакет();
	Сведения = Новый Структура;
	Сведения.Вставить("внутренний_номер_ряд", АнализРяда(Пакет[1].Выгрузить().ВыгрузитьКолонку("Номер")));
	Итоги = Пакет[2].Выгрузить()[0];
	Сведения.Вставить("записей", Ч(ЧислоИлиНоль(Итоги.Записей)));
	Сведения.Вставить("с_внешним_номером", Ч(ЧислоИлиНоль(Итоги.СВнешним)));
	Сведения.Вставить("с_биржевым_номером", Ч(ЧислоИлиНоль(Итоги.СБиржевым)));
	СписокАдаптеров = Новый Массив;
	Для Каждого Строка Из Пакет[3].Выгрузить() Цикл
		СписокАдаптеров.Добавить(Строка(Строка.Адаптер) + ": " + Ч(Строка.Записей));
	КонецЦикла;
	Сведения.Вставить("адаптеры", СписокАдаптеров);
	Возврат Сведения;

КонецФункции

// Последние поручения периода: номер документа, Идентификатор, номера биржевой заявки (если есть).
Функция ОбразцыПоручений(Начало)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 15
	|	Поручения.Ссылка КАК Ссылка,
	|	Поручения.Дата КАК Дата,
	|	Поручения.Номер КАК НомерДокумента,
	|	Поручения.Идентификатор КАК Идентификатор,
	|	Поручения.ПометкаУдаления КАК ПометкаУдаления,
	|	Заявки.НомерВнутренний КАК НомерВнутренний,
	|	Заявки.НомерВнешний КАК НомерВнешний,
	|	Заявки.НомерБиржевой КАК НомерБиржевой,
	|	Заявки.Адаптер КАК Адаптер
	|ИЗ
	|	Документ.Поручение КАК Поручения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.БиржевыеЗаявки КАК Заявки
	|		ПО Поручения.Ссылка = Заявки.Поручение
	|ГДЕ
	|	Поручения.Дата >= &Начало
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поручения.Дата УБЫВ";
	Образцы = Новый Массив;
	Для Каждого Строка Из Запрос.Выполнить().Выгрузить() Цикл
		Образцы.Добавить(СтрШаблон("%1 N %2: Идентификатор %3; НомерВнутренний %4; НомерВнешний %5; НомерБиржевой %6; "
			+ "адаптер %7; помечен на удаление %8", Формат(Строка.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'"),
			СокрЛП(Строка.НомерДокумента), Ч(Строка.Идентификатор), Ч(ЧислоИлиНоль(Строка.НомерВнутренний)),
			Ч(ЧислоИлиНоль(Строка.НомерВнешний)), Строка(Строка.НомерБиржевой), Строка(Строка.Адаптер),
			ЗначениеСтрокой(Строка.ПометкаУдаления)));
	КонецЦикла;
	Возврат Образцы;

КонецФункции

Функция Справка()

	Справка = Новый Массив;
	Справка.Добавить("Поручение.Идентификатор выдает РегистрыСведений.НумераторыСделок.НовыеИдентификаторы (вид "
		+ "объекта Поручение, одна запись регистра на базу) при первой записи поручения, если Идентификатор пуст и не "
		+ "передан в ДополнительныеСвойства.Идентификатор (Документ.Поручение, ЗаписатьСКонтролем).");
