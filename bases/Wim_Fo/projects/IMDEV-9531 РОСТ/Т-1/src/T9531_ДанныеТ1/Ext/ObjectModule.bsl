// Контекст прогона: настройки и версия зарегистрированной РОСТ, начало окна замеров (миллисекунды UTC).
Функция КонтекстПрогона()

	Контекст = Новый Структура("Настройки, ЭлементРОСТ", Неопределено, Неопределено);
	СведенияОРОСТ(Контекст);
	Если Контекст.Настройки = Неопределено Тогда
		ВызватьИсключение "Не найдена зарегистрированная обработка ""Создание торговых поручений РОСТ"" с настройками";
	КонецЕсли;
	Контекст.Вставить("ВерсияРОСТ", Строка(Контекст.ЭлементРОСТ.Версия));
	Контекст.Вставить("Сегодня", НачалоДня(ТекущаяДатаСеанса()));
	Контекст.Вставить("Автор", ЗначениеНастройки(Контекст.Настройки, "АвторЗаявок"));
	Контекст.Вставить("LQDT", ЗначениеНастройки(Контекст.Настройки, "АктивВимЛиквидность"));

	НачалоДняМс = (УниверсальноеВремя(Контекст.Сегодня) - Дата(1, 1, 1)) * 1000;
	НачалоОкна = ХранилищеОбщихНастроек.Загрузить(КлючХранилища(), "НачалоОкна");
	Если ТипЗнч(НачалоОкна) <> Тип("Число") Или НачалоОкна < НачалоДняМс Тогда
		НачалоОкна = НачалоДняМс;
	КонецЕсли;
	Контекст.Вставить("НачалоОкна", НачалоОкна);
	Возврат Контекст;

КонецФункции

Функция ПорученияЗаСегодня(Контекст)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сегодня", Контекст.Сегодня);
	Запрос.УстановитьПараметр("Автор", Контекст.Автор);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	п.Ссылка КАК Ссылка,
	|	п.Дата КАК Дата,
	|	п.Портфель КАК Портфель,
	|	п.Портфель.ВнешнийКод КАК КодПортфеля,
	|	п.Актив КАК Актив,
	|	п.Направление КАК Направление,
	|	п.Количество КАК Количество,
	|	п.ЦенаВВалютеРасчетов КАК Цена,
	|	п.СуммаПоручения КАК Сумма,
	|	п.Проведен КАК Проведен
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата >= &Сегодня
	|	И НЕ п.ПометкаУдаления
	|	И п.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.Сделка)
	|	И п.Ответственный = &Автор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция КатегорияПоручения(Строка, LQDT)

	Если Строка.Направление = Перечисления.ВидыОперацийСделки.Покупка Тогда
		Возврат "реинвест";
	ИначеЕсли Строка.Актив = LQDT Тогда
		Возврат "блокировки";
	КонецЕсли;
	Возврат "прочее";

КонецФункции

Функция ПорученияПрогона(Контекст)

	Поручения = Новый Массив;
	Для Каждого Строка Из ПорученияЗаСегодня(Контекст) Цикл
		Поручение = Новый Структура;
		Поручение.Вставить("категория", КатегорияПоручения(Строка, Контекст.LQDT));
		Поручение.Вставить("портфель", Строка(Строка.КодПортфеля));
		Поручение.Вставить("актив", Строка(Строка.Актив));
		Поручение.Вставить("количество", Строка.Количество);
		Поручение.Вставить("цена", Строка.Цена);
		Поручение.Вставить("сумма", Строка.Сумма);
		Поручение.Вставить("проведен", Строка.Проведен);
		Поручение.Вставить("время", Формат(Строка.Дата, "ДФ=HH:mm:ss"));
		Поручения.Добавить(Поручение);
	КонецЦикла;
	Возврат Поручения;

КонецФункции

Функция ЗамерыПрогона(НачалоОкна)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоОкна);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	з.КлючеваяОперация.Имя КАК Операция,
	|	з.ДатаНачалаЗамера КАК Начало,
	|	з.ВремяВыполнения КАК Время,
	|	з.ВесЗамера КАК Вес
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК з
	|ГДЕ
	|	з.ДатаНачалаЗамера >= &Начало
	|	И з.КлючеваяОперация.Имя ПОДОБНО ""СозданиеТорговыхПорученийРОСТ.%""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Начало";
	Замеры = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Замер = Новый Структура;
		Замер.Вставить("операция", СтрЗаменить(Выборка.Операция, "СозданиеТорговыхПорученийРОСТ.", ""));
		Замер.Вставить("начало", Выборка.Начало);
		Замер.Вставить("время", Выборка.Время);
		Замер.Вставить("вес", Выборка.Вес);
		Замеры.Добавить(Замер);
	КонецЦикла;
	Возврат Замеры;

КонецФункции

// Время операции формы по замерам: от начала первого замера операции (потоки) до конца последнего замера этой
// операции или отправки пачки, начатого до первого замера другой операции формы. Также считает отправки пачки,
// потоки, запросы цены и цены из кеша (вес шагов ЦенаИзСтакана и ЦенаИзКеша), время проверки лимитов (шаг
// ПроверкаИОтправка: время шага - среднее на единицу веса), среднее время записи и проведения поручения (рост этих
// шагов при параллельной работе потоков - ожидание блокировок).
Функция ВремяОперации(Замеры, Операция)

	Начало = Неопределено;
	НачалоДругой = Неопределено;
	Для Каждого Замер Из Замеры Цикл
		ИмяОперации = СтрРазделить(Замер.операция, ".")[0];
		ЭтоОперацияФормы = ИмяОперации = "Реинвестирование" Или ИмяОперации = "ПродажаПодБлокировки";
		Если ИмяОперации = Операция И Начало = Неопределено Тогда
			Начало = Замер.начало;
		ИначеЕсли Начало <> Неопределено И НачалоДругой = Неопределено И ЭтоОперацияФормы И ИмяОперации <> Операция Тогда
			НачалоДругой = Замер.начало;
		КонецЕсли;
	КонецЦикла;

	Сведения = Новый Структура("секунд, отправок_пачки, потоков, запросов_цены, цен_из_кеша, проверка_лимитов_с",
		0, 0, 0, 0, 0, 0);
	Сведения.Вставить("запись_поручения_ср_с", 0);
	Сведения.Вставить("проведение_с_ценой_ср_с", 0);
	Запись = Новый Структура("время, вес", 0, 0);
	Проведение = Новый Структура("время, вес", 0, 0);
	Если Начало = Неопределено Тогда
		Возврат Сведения;
	КонецЕсли;

	Конец = Начало;
	Для Каждого Замер Из Замеры Цикл
		Если Замер.начало < Начало Или НачалоДругой <> Неопределено И Замер.начало >= НачалоДругой Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(Замер.операция, ".");
		Если Части[0] <> Операция И Части[0] <> "ОтправкаПачки" Тогда
			Продолжить;
		КонецЕсли;
		Если Части.Количество() = 1 Тогда
			Конец = Макс(Конец, Замер.начало + Замер.время * 1000);
			Если Части[0] = "ОтправкаПачки" Тогда
				Сведения.отправок_пачки = Сведения.отправок_пачки + 1;
			Иначе
				Сведения.потоков = Сведения.потоков + 1;
			КонецЕсли;
		ИначеЕсли Части[1] = "ЦенаИзСтакана" Тогда
			Сведения.запросов_цены = Сведения.запросов_цены + Замер.вес;
		ИначеЕсли Части[1] = "ЦенаИзКеша" Тогда
			Сведения.цен_из_кеша = Сведения.цен_из_кеша + Замер.вес;
		ИначеЕсли Части[1] = "ПроверкаИОтправка" Тогда
			Сведения.проверка_лимитов_с = Сведения.проверка_лимитов_с + Замер.время * Замер.вес;
		ИначеЕсли Части[1] = "ЗаписьПоручения" Тогда
			Запись.время = Запись.время + Замер.время * Замер.вес;
			Запись.вес = Запись.вес + Замер.вес;
		ИначеЕсли Части[1] = "ПроведениеСЦеной" Тогда
			Проведение.время = Проведение.время + Замер.время * Замер.вес;
			Проведение.вес = Проведение.вес + Замер.вес;
		КонецЕсли;
	КонецЦикла;
	Сведения.секунд = Окр((Конец - Начало) / 1000, 1);
	Сведения.проверка_лимитов_с = Окр(Сведения.проверка_лимитов_с, 1);
	Если Запись.вес > 0 Тогда
		Сведения.запись_поручения_ср_с = Окр(Запись.время / Запись.вес, 3);
	КонецЕсли;
	Если Проведение.вес > 0 Тогда
		Сведения.проведение_с_ценой_ср_с = Окр(Проведение.время / Проведение.вес, 3);
	КонецЕсли;
	Возврат Сведения;

КонецФункции

// Сводка прогона для формы и JSON: поручения по категориям, число замеров, время операций по замерам.
Функция СводкаПрогона(Прогон)

	Сводка = Новый Структура;
	Сводка.Вставить("метка", Прогон.метка);
	Сводка.Вставить("время_фиксации", Прогон.время_фиксации);
	Сводка.Вставить("версия_РОСТ", Прогон.версия_РОСТ);
	Поручения = Новый Структура;
	Для Каждого Поручение Из Прогон.поручения Цикл
		Если Не Поручения.Свойство(Поручение.категория) Тогда
			Поручения.Вставить(Поручение.категория, Новый Структура("поручений, проведено, сумма, первое, последнее",
				0, 0, 0, Поручение.время, ""));
		КонецЕсли;
		Данные = Поручения[Поручение.категория];
		Данные.поручений = Данные.поручений + 1;
		Если Поручение.проведен Тогда
			Данные.проведено = Данные.проведено + 1;
		КонецЕсли;
		Данные.сумма = Данные.сумма + Поручение.сумма;
		Данные.последнее = Поручение.время;
	КонецЦикла;
	Сводка.Вставить("поручения", Поручения);
	Сводка.Вставить("замеров", Прогон.замеры.Количество());
	Время = Новый Структура;
	Время.Вставить("реинвест", ВремяОперации(Прогон.замеры, "Реинвестирование"));
	Время.Вставить("блокировки", ВремяОперации(Прогон.замеры, "ПродажаПодБлокировки"));
	Сводка.Вставить("время_по_замерам", Время);
	Если Прогон.Свойство("удалено_нет_денег") Тогда
		Сводка.Вставить("удалено_нет_денег", Прогон.удалено_нет_денег);
	КонецЕсли;
	Шаги = Новый Структура;
	Для Каждого Операция Из СтрРазделить("Реинвестирование,ПродажаПодБлокировки,ОтправкаПачки", ",") Цикл
		Шаги.Вставить(Операция, ШагиОперации(Прогон.замеры, Операция));
	КонецЦикла;
	Сводка.Вставить("шаги_замеров", Шаги);
	Если Прогон.Свойство("журнал") И Прогон.журнал.Свойство("записи") Тогда
		Сводка.Вставить("журнал_сводка", СводкаЖурнала(Прогон.журнал));
		Сводка.Вставить("журнал_ошибки_потоков", Прогон.журнал.ошибки_в_логах_потоков);
		Сводка.Вставить("журнал_строк_не_хватает_ДС", Прогон.журнал.строк_не_хватает_ДС);
		Сводка.Вставить("журнал_записи", Прогон.журнал.записи);
	ИначеЕсли Прогон.Свойство("журнал") Тогда
		Сводка.Вставить("журнал", Прогон.журнал);
	КонецЕсли;
	Возврат Сводка;

КонецФункции

Функция СравнениеПоручений(ПрогонА, ПрогонБ)

	ПоКлючуБ = Новый Соответствие;
	Для Каждого Поручение Из ПрогонБ.поручения Цикл
		ПоКлючуБ.Вставить(КлючПоручения(Поручение), Поручение);
	КонецЦикла;

	Итоги = Новый Структура;
	Найденные = Новый Соответствие;
	Для Каждого ПоручениеА Из ПрогонА.поручения Цикл
		Итог = ИтогКатегории(Итоги, ПоручениеА.категория);
		Ключ = КлючПоручения(ПоручениеА);
		ПоручениеБ = ПоКлючуБ[Ключ];
		Если ПоручениеБ = Неопределено Тогда
			Итог.только_в_первом = Итог.только_в_первом + 1;
			Продолжить;
		КонецЕсли;
		Найденные.Вставить(Ключ, Истина);
		Итог.в_обоих = Итог.в_обоих + 1;
		Различия = Новый Массив;
		Для Каждого Поле Из СтрРазделить("количество,цена,сумма", ",") Цикл
			Если ПоручениеА[Поле] <> ПоручениеБ[Поле] Тогда
				Различия.Добавить(Поле + " " + ПоручениеА[Поле] + " / " + ПоручениеБ[Поле]);
			КонецЕсли;
		КонецЦикла;
		Если Различия.Количество() = 0 Тогда
			Итог.совпали = Итог.совпали + 1;
		Иначе
			Итог.расхождений = Итог.расхождений + 1;
			Если Итог.примеры.Количество() < 10 Тогда
				Итог.примеры.Добавить(ПоручениеА.портфель + " " + ПоручениеА.актив + ": " + СтрСоединить(Различия, "; "));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ПоручениеБ Из ПрогонБ.поручения Цикл
		Если Найденные[КлючПоручения(ПоручениеБ)] = Неопределено Тогда
			Итог = ИтогКатегории(Итоги, ПоручениеБ.категория);
			Итог.только_во_втором = Итог.только_во_втором + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итоги;

КонецФункции

Функция ИтогКатегории(Итоги, Категория)

	Если Не Итоги.Свойство(Категория) Тогда
		Итоги.Вставить(Категория, Новый Структура("в_обоих, совпали, расхождений, только_в_первом, только_во_втором, примеры",
			0, 0, 0, 0, 0, Новый Массив));
	КонецЕсли;
	Возврат Итоги[Категория];

КонецФункции

Функция КлючПоручения(Поручение)

	Возврат Поручение.категория + "|" + Поручение.портфель + "|" + Поручение.актив;

КонецФункции

Функция СравнениеВремени(ПрогонА, ПрогонБ)

	Время = Новый Структура;
	Для Каждого Операция Из СтрРазделить("Реинвестирование,ПродажаПодБлокировки", ",") Цикл
		ВремяА = ВремяОперации(ПрогонА.замеры, Операция);
		ВремяБ = ВремяОперации(ПрогонБ.замеры, Операция);
		Сведения = Новый Структура;
		Сведения.Вставить("секунд", Формат(ВремяА.секунд, "ЧН=0; ЧГ=0") + " / " + Формат(ВремяБ.секунд, "ЧН=0; ЧГ=0"));
		Если ВремяБ.секунд > 0 Тогда
			Сведения.Вставить("ускорение_раз", Окр(ВремяА.секунд / ВремяБ.секунд, 2));
		КонецЕсли;
		Сведения.Вставить("отправок_пачки", Формат(ВремяА.отправок_пачки, "ЧН=0") + " / "
			+ Формат(ВремяБ.отправок_пачки, "ЧН=0"));
		Сведения.Вставить("запросов_цены", Формат(ВремяА.запросов_цены, "ЧН=0; ЧГ=0") + " / "
			+ Формат(ВремяБ.запросов_цены, "ЧН=0; ЧГ=0"));
		Сведения.Вставить("проверка_лимитов_с", Формат(ВремяА.проверка_лимитов_с, "ЧН=0; ЧГ=0") + " / "
			+ Формат(ВремяБ.проверка_лимитов_с, "ЧН=0; ЧГ=0"));
		Сведения.Вставить("запись_поручения_ср_с", Формат(ВремяА.запись_поручения_ср_с, "ЧН=0; ЧГ=0") + " / "
			+ Формат(ВремяБ.запись_поручения_ср_с, "ЧН=0; ЧГ=0"));
		Сведения.Вставить("проведение_с_ценой_ср_с", Формат(ВремяА.проведение_с_ценой_ср_с, "ЧН=0; ЧГ=0") + " / "
			+ Формат(ВремяБ.проведение_с_ценой_ср_с, "ЧН=0; ЧГ=0"));
		Время.Вставить(Операция, Сведения);
	КонецЦикла;
	Время.Вставить("порядок_значений", ПрогонА.метка + " / " + ПрогонБ.метка);
	Возврат Время;

КонецФункции

// Возвращает статус портфелей поручений к значению из истории статусов на момент перед первым поручением.
// Портфели без записи истории до этого момента не меняются.
Функция ВосстановитьСтатусы(Контекст, Поручения)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портфели", Поручения.ВыгрузитьКолонку("Портфель"));
	Запрос.УстановитьПараметр("НаДату", Поручения[0].Дата - 1);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	История.Портфель КАК Портфель,
	|	История.СтатусПортфеля КАК Статус,
	|	История.Период КАК Период
	|ИЗ
	|	РегистрСведений.ВТБ_СтатусыПортфелей.СрезПоследних(&НаДату, Портфель В (&Портфели)) КАК История";
	Свойство = ЗначениеНастройки(Контекст.Настройки, "ДопРеквизитСтатусПортфеля");
	СвойствоДата = ЗначениеНастройки(Контекст.Настройки, "ДопРеквизитДатаОперации");
	Восстановлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписатьСведение(Выборка.Портфель, Свойство, Выборка.Статус);
		ЗаписатьСведение(Выборка.Портфель, СвойствоДата, Выборка.Период);
		Восстановлено = Восстановлено + 1;
	КонецЦикла;
	Возврат Восстановлено;

КонецФункции

Процедура ЗаписатьСведение(Объект, Свойство, Значение)

	Запись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	Запись.Объект = Объект;
	Запись.Свойство = Свойство;
	Запись.Значение = Значение;
	Запись.Записать(Истина);

КонецПроцедуры

#КонецОбласти

#Область ПодробностиПрогона

// Дата сеанса начала окна прогона по миллисекундам UTC от 01.01.0001.
Функция ДатаОкна(НачалоОкна)

	Возврат МестноеВремя(Дата(1, 1, 1) + Цел(НачалоОкна / 1000));

КонецФункции

// Поручения автора заявок РОСТ, созданные в окне прогона и помеченные на удаление: обработка помечает так
// поручения, количество которых после цены оказалось 0 (не хватает денег).
Функция УдаленныеПорученияПрогона(Контекст)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", ДатаОкна(Контекст.НачалоОкна));
	Запрос.УстановитьПараметр("Автор", Контекст.Автор);
	Запрос.УстановитьПараметр("LQDT", Контекст.LQDT);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА п.Направление = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделки.Покупка)
	|			ТОГДА ""реинвест""
	|		КОГДА п.Актив = &LQDT
	|			ТОГДА ""блокировки""
	|		ИНАЧЕ ""прочее""
	|	КОНЕЦ КАК Категория,
	|	КОЛИЧЕСТВО(п.Ссылка) КАК Поручений
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата >= &Начало
	|	И п.ПометкаУдаления
	|	И п.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.Сделка)
	|	И п.Ответственный = &Автор
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА п.Направление = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделки.Покупка)
	|			ТОГДА ""реинвест""
	|		КОГДА п.Актив = &LQDT
	|			ТОГДА ""блокировки""
	|		ИНАЧЕ ""прочее""
	|	КОНЕЦ";
	Удаленные = Новый Структура;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Удаленные.Вставить(Выборка.Категория, Выборка.Поручений);
	КонецЦикла;
	Возврат Удаленные;

КонецФункции

// Журнал хода сборок РОСТ для Т-1 (события "IMDEV-9531.Т1.*") с начала окна прогона: записи без логов потоков,
// из логов потоков - строки ошибок и число строк "не хватает ДС".
Функция ЖурналПрогона(Контекст)

	События = Новый Массив;
	Для Каждого Имя Из СтрРазделить("ПотокСтарт,ПотокХод,ПотокФиниш,ПотокЛог,ПачкаСтарт,ПачкаФиниш,ПотокЗавершениеФорма",
		",") Цикл
		События.Добавить("IMDEV-9531.Т1." + Имя);
	КонецЦикла;
	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", ДатаОкна(Контекст.НачалоОкна));
	Отбор.Вставить("Событие", События);
	Журнал = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Журнал, Отбор);
	Журнал.Сортировать("Дата");

	Записи = Новый Массив;
	Ошибки = Новый Массив;
	НетДенег = 0;
	Для Каждого Запись Из Журнал Цикл
		Событие = СтрЗаменить(Строка(Запись.Событие), "IMDEV-9531.Т1.", "");
		Комментарий = Строка(Запись.Комментарий);
		Если Событие = "ПотокЛог" Тогда
			Строки = СтрРазделить(Комментарий, Символы.ПС, Ложь);
			Для Каждого СтрокаЛога Из Строки Цикл
				Если СтрНайти(СтрокаЛога, "не хватает ДС") > 0 Тогда
					НетДенег = НетДенег + 1;
				ИначеЕсли СтрНайти(СтрокаЛога, "[err]") > 0 И Ошибки.Количество() < 30 Тогда
					Ошибки.Добавить(Строки[0] + ": " + Лев(СтрокаЛога, 500));
				КонецЕсли;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Записи.Добавить(Формат(Запись.Дата, "ДФ=HH:mm:ss") + " " + Событие + ": " + Лев(СокрЛП(Комментарий), 700));
	КонецЦикла;

	Сведения = Новый Структура;
	Сведения.Вставить("записи", Записи);
	Сведения.Вставить("ошибки_в_логах_потоков", Ошибки);
	Сведения.Вставить("строк_не_хватает_ДС", НетДенег);
	Возврат Сведения;

КонецФункции

// Сводка журнала прогона: число стартов и финишей потоков по операциям, статусы потоков на форме, отправки пачки.
Функция СводкаЖурнала(Журнал)

	Счетчики = Новый Соответствие;
	Для Каждого Запись Из Журнал.записи Цикл
		Части = СтрРазделить(Сред(Запись, 10), ":");
		Событие = СокрЛП(Части[0]);
		Если Событие = "ПотокХод" Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Событие;
		Если Событие = "ПотокСтарт" Или Событие = "ПотокФиниш" Тогда
			Ключ = Событие + " " + СокрЛП(СтрРазделить(Части[1], ";")[0]);
		ИначеЕсли Событие = "ПотокЗавершениеФорма" И Части.Количество() > 2 Тогда
			Ключ = Событие + " " + СокрЛП(СтрРазделить(Части[2], Символы.ПС)[0]);
		КонецЕсли;
		Счетчики.Вставить(Ключ, ЧислоИлиНоль(Счетчики[Ключ]) + 1);
	КонецЦикла;
	Сводка = Новый Массив;
	Для Каждого Элемент Из Счетчики Цикл
		Сводка.Добавить(Элемент.Ключ + ": " + Формат(Элемент.Значение, "ЧН=0; ЧГ=0"));
	КонецЦикла;
	Возврат Сводка;

КонецФункции

// Шаги замеров операции: всего, вызовов, среднее на вызов (время шага в замере - среднее на единицу веса),
// а также длительность потоков (мин и макс) и отправок пачки.
Функция ШагиОперации(Замеры, Операция)

	Шаги = Новый Соответствие;
	Потоки = Новый Массив;
	Для Каждого Замер Из Замеры Цикл
		Части = СтрРазделить(Замер.операция, ".");
		Если Части[0] <> Операция Тогда
			Продолжить;
		КонецЕсли;
		Если Части.Количество() = 1 Тогда
			Потоки.Добавить(Замер.время);
			Продолжить;
		КонецЕсли;
		Данные = Шаги[Части[1]];
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("время, вес", 0, 0);
			Шаги.Вставить(Части[1], Данные);
		КонецЕсли;
		Данные.время = Данные.время + Замер.время * Замер.вес;
		Данные.вес = Данные.вес + Замер.вес;
	КонецЦикла;

	Сведения = Новый Структура;
	Сведения.Вставить("записей_операции", Потоки.Количество());
	Если Потоки.Количество() > 0 Тогда
		Минимум = Потоки[0];
		Максимум = Потоки[0];
		Для Каждого Длительность Из Потоки Цикл
			Минимум = Мин(Минимум, Длительность);
			Максимум = Макс(Максимум, Длительность);
		КонецЦикла;
		Сведения.Вставить("длительность_мин_с", Окр(Минимум, 1));
		Сведения.Вставить("длительность_макс_с", Окр(Максимум, 1));
	КонецЕсли;
	Список = Новый Массив;
	Для Каждого Элемент Из Шаги Цикл
		Среднее = 0;
		Если Элемент.Значение.вес > 0 Тогда
			Среднее = Элемент.Значение.время / Элемент.Значение.вес;
		КонецЕсли;
		Список.Добавить(СтрШаблон("%1: всего %2 с; вызовов %3; среднее %4 с", Элемент.Ключ,
			Формат(Элемент.Значение.время, "ЧДЦ=1; ЧН=0; ЧГ=0"), Формат(Элемент.Значение.вес, "ЧН=0; ЧГ=0"),
			Формат(Среднее, "ЧДЦ=3; ЧН=0; ЧГ=0")));
	КонецЦикла;
	Сведения.Вставить("шаги", Список);
	Возврат Сведения;

КонецФункции

