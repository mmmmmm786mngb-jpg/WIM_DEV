// IMDEV-9531: служебная обработка для копии ПРОД (Т-1). Диагностика данных для ручной проверки реинвестирования
// и продаж под блокировки обработки "Создание торговых поручений РОСТ" в тестовом режиме. Данные не меняет.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Собирает диагностику: какие реальные запуски реинвестирования и продаж под блокировки есть в базе и на каком
// шаге отбора обработки РОСТ (тестовый режим) отсеиваются портфели сейчас. Каждый раздел выполняется отдельно:
// ошибка раздела пишется в "ошибки", остальные разделы выполняются.
//
// Параметры:
//  ДатаКупона - Дата - дата выплаты купона для реинвестирования
//  ДнейИстории - Число - глубина поиска продаж под блокировки, дней
//
// Возвращаемое значение:
//  Структура - результат из строк, чисел, булевых значений, структур и массивов (пригоден для ЗаписатьJSON)
//
Функция Диагностика(ДатаКупона, ДнейИстории) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("версия_диагностики", "1.1");
	Результат.Вставить("ошибки", Новый Массив);

	Контекст = Новый Структура;
	Контекст.Вставить("Сегодня", НачалоДня(ТекущаяДата()));
	Контекст.Вставить("ДатаКупона", НачалоДня(ДатаКупона));
	Контекст.Вставить("ДнейИстории", ДнейИстории);
	Если ДнейИстории <= 0 Тогда
		Контекст.ДнейИстории = 60;
	КонецЕсли;
	Контекст.Вставить("Настройки", Неопределено);
	Контекст.Вставить("ЭлементРОСТ", Неопределено);

	Попытка
		Результат.Вставить("база", СведенияОБазе());
	Исключение
		ДобавитьОшибку(Результат, "база");
	КонецПопытки;

	Попытка
		Результат.Вставить("рост", СведенияОРОСТ(Контекст));
	Исключение
		ДобавитьОшибку(Результат, "рост");
	КонецПопытки;

	Попытка
		Результат.Вставить("даты", СведенияОДатах(Контекст));
	Исключение
		ДобавитьОшибку(Результат, "даты");
	КонецПопытки;

	Если Контекст.Настройки = Неопределено Тогда
		Результат.ошибки.Добавить("Настройки обработки РОСТ не найдены: разделы реинвестирования и блокировок пропущены");
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.Вставить("реинвест", СведенияОРеинвестировании(Контекст, Результат));
	Исключение
		ДобавитьОшибку(Результат, "реинвест");
	КонецПопытки;

	Попытка
		Результат.Вставить("поиск_даты_купона", ПоискДатыКупона(Контекст, Результат));
	Исключение
		ДобавитьОшибку(Результат, "поиск_даты_купона");
	КонецПопытки;

	Попытка
		Результат.Вставить("блокировки", СведенияОБлокировках(Контекст, Результат));
	Исключение
		ДобавитьОшибку(Результат, "блокировки");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Текст результата диагностики для формы: разделы и значения с отступами.
//
// Параметры:
//  Результат - Структура - см. Диагностика
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстРезультата(Результат) Экспорт

	Строки = Новый Массив;
	ВывестиЗначение(Строки, Результат, "");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// JSON результата диагностики с отступами.
//
// Параметры:
//  Результат - Структура - см. Диагностика
//
// Возвращаемое значение:
//  Строка
//
Функция JSONРезультата(Результат) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, Результат);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Разделы

Функция СведенияОБазе()

	Сведения = Новый Структура;
	Сведения.Вставить("строка_соединения", СтрокаСоединенияИнформационнойБазы());
	Сведения.Вставить("конфигурация", Метаданные.Синоним + " " + Метаданные.Версия);
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Сведения.Вставить("платформа", СистемнаяИнформация.ВерсияПриложения);
	Сведения.Вставить("пользователь", ИмяПользователя());
	Сведения.Вставить("время_запуска", Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Возврат Сведения;

КонецФункции

Функция СведенияОРОСТ(Контекст)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Ссылка КАК Ссылка,
	|	т.Наименование КАК Наименование,
	|	т.ИмяОбъекта КАК ИмяОбъекта,
	|	т.Версия КАК Версия,
	|	т.ПометкаУдаления КАК ПометкаУдаления,
	|	т.Публикация КАК Публикация,
	|	т.ХранилищеНастроек КАК ХранилищеНастроек
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК т
	|ГДЕ
	|	т.ИмяОбъекта = ""СозданиеТорговыхПорученийРОСТ""
	|
	|УПОРЯДОЧИТЬ ПО
	|	т.ПометкаУдаления,
	|	т.Наименование";

	Сведения = Новый Структура;
	Сведения.Вставить("элементы", Новый Массив);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Настройки = Неопределено;
		Если ТипЗнч(Выборка.ХранилищеНастроек) = Тип("ХранилищеЗначения") Тогда
			Настройки = Выборка.ХранилищеНастроек.Получить();
		КонецЕсли;
		ЕстьНастройки = ТипЗнч(Настройки) = Тип("Структура");

		Элемент = Новый Структура;
		Элемент.Вставить("наименование", Выборка.Наименование);
		Элемент.Вставить("имя_объекта", Выборка.ИмяОбъекта);
		Элемент.Вставить("версия", Выборка.Версия);
		Элемент.Вставить("пометка_удаления", Выборка.ПометкаУдаления);
		Элемент.Вставить("публикация", Строка(Выборка.Публикация));
		Элемент.Вставить("настройки", ЕстьНастройки);
		Сведения.элементы.Добавить(Элемент);

		Если Контекст.Настройки = Неопределено И ЕстьНастройки И Не Выборка.ПометкаУдаления Тогда
			Контекст.Настройки = Настройки;
			Контекст.ЭлементРОСТ = Выборка.Ссылка;
			Сведения.Вставить("выбран", Выборка.Наименование + " " + Выборка.Версия);
		КонецЕсли;
	КонецЦикла;

	Если Контекст.Настройки = Неопределено Тогда
		Возврат Сведения;
	КонецЕсли;

	Настройки = Контекст.Настройки;
	Значения = Новый Структура;
	Для Каждого Имя Из СтрРазделить("ДопРеквизитСтатусПортфеля,ДопРеквизитДатаОперации,АвторЗаявок,"
		+ "АктивВимЛиквидность,СтатусОкончаниеОбработки,СтатусРасторжениеИнициировано,"
		+ "СтатусОрдераНаПродажуСформированы,СтатусОрдераНаПродажуОтправлены,СтатусОрдераНаПродажуИсполнены,"
		+ "СтатусПорученияНаВыводПоданы,СтатусПорученияНаВыводИсполнены,СтатусОрдераНаРеИнвСформированы,"
		+ "СрокКешаЦеныСтаканаСек", ",") Цикл
		Значение = Неопределено;
		Если Настройки.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Значения.Вставить(Имя, Строка(Значение));
		Иначе
			Значения.Вставить(Имя, "<нет>");
		КонецЕсли;
	КонецЦикла;
	Сведения.Вставить("настройки", Значения);

	Возврат Сведения;

КонецФункции

Функция СведенияОДатах(Контекст)

	Сегодня = Контекст.Сегодня;
	// Те же даты, что в тестовом режиме обработки РОСТ.
	Контекст.Вставить("ПозицияРеинвест", НачалоДня(Сегодня - 1));
	Контекст.Вставить("ПозицияБлокировки", НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(
		Справочники.ПроизводственныеКалендари.ТорговыйКалендарьММВБ, Сегодня, -1)));

	Сведения = Новый Структура;
	Сведения.Вставить("сегодня", Д(Сегодня));
	Сведения.Вставить("позиция_реинвест_тестовый_режим", Д(Контекст.ПозицияРеинвест));
	Сведения.Вставить("позиция_блокировки_тестовый_режим", Д(Контекст.ПозицияБлокировки));
	Сведения.Вставить("дата_купона", Д(Контекст.ДатаКупона));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	т.Дата КАК Дата,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т.Портфель) КАК Портфелей
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК т
	|ГДЕ
	|	т.Дата МЕЖДУ &Начало И &Конец
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Запрос.УстановитьПараметр("Начало", Сегодня - 10 * 86400);
	Запрос.УстановитьПараметр("Конец", КонецДня(Сегодня + 86400));
	Сведения.Вставить("факт_позиция_портфелей_по_датам", ПоДатам(Запрос.Выполнить().Выгрузить(), "Портфелей"));

	Запрос.УстановитьПараметр("Начало", Контекст.ДатаКупона);
	Запрос.УстановитьПараметр("Конец", КонецДня(Контекст.ДатаКупона));
	Сведения.Вставить("факт_позиция_портфелей_на_дату_купона",
		ПоДатам(Запрос.Выполнить().Выгрузить(), "Портфелей"));

	Возврат Сведения;

КонецФункции

Функция СведенияОРеинвестировании(Контекст, Результат)

	Настройки = Контекст.Настройки;
	Сведения = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаКупона", Контекст.ДатаКупона);
	Запрос.УстановитьПараметр("КонецДняКупона", КонецДня(Контекст.ДатаКупона));
	Запрос.УстановитьПараметр("ПозицияНаДату", Контекст.ПозицияРеинвест);
	Запрос.УстановитьПараметр("Сегодня", Контекст.Сегодня);
	Запрос.УстановитьПараметр("Автор", ЗначениеНастройки(Настройки, "АвторЗаявок"));
	Запрос.УстановитьПараметр("СвойствоСтатус", ЗначениеНастройки(Настройки, "ДопРеквизитСтатусПортфеля"));

	// Облигации с выплатой купона в дату - как в отборе обработки РОСТ.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	р.Облигация КАК Облигация,
	|	к.РазмерДоходаВРублях КАК РазмерДоходаВРублях
	|ПОМЕСТИТЬ ВТ_Облигации
	|ИЗ
	|	РегистрСведений.КупонноеРасписаниеПоОблигациям.СрезПоследних(&КонецДняКупона, ) КАК р
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КупонноеРасписание.Купоны КАК к
	|		ПО р.Документ = к.Ссылка
	|			И (к.ДатаВыплатыКупонногоДохода = &ДатаКупона)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	а.Ссылка КАК Актив,
	|	о.РазмерДоходаВРублях КАК РазмерДоходаВРублях
	|ПОМЕСТИТЬ ВТ_Активы
	|ИЗ
	|	Справочник.Активы КАК а
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Облигации КАК о
	|		ПО а.Объект = о.Облигация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Актив КАК Актив,
	|	т.РазмерДоходаВРублях КАК РазмерДоходаВРублях
	|ИЗ
	|	ВТ_Активы КАК т";
	Активы = Запрос.Выполнить().Выгрузить();
	Список = Новый Массив;
	Для Каждого Строка Из Активы Цикл
		Список.Добавить(Строка(Строка.Актив) + "; купон на ед. " + Строка.РазмерДоходаВРублях);
	КонецЦикла;
	Сведения.Вставить("бумаги_с_купоном_в_дату", Список);

	// Реальные поручения реинвестирования в дату купона: покупки бумаг с купоном от автора заявок РОСТ.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	п.Ссылка КАК Ссылка,
	|	п.Портфель КАК Портфель,
	|	п.Актив КАК Актив,
	|	п.Проведен КАК Проведен,
	|	п.ПометкаУдаления КАК ПометкаУдаления
	|ПОМЕСТИТЬ ВТ_ПорученияКупона
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата МЕЖДУ &ДатаКупона И &КонецДняКупона
	|	И п.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.Сделка)
	|	И п.Направление = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделки.Покупка)
	|	И п.Ответственный = &Автор
	|	И п.Актив В
	|			(ВЫБРАТЬ
	|				т.Актив
	|			ИЗ
	|				ВТ_Активы КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(т.Ссылка) КАК Поручений,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т.Портфель) КАК Портфелей,
	|	СУММА(ВЫБОР
	|			КОГДА т.Проведен
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Проведено,
	|	СУММА(ВЫБОР
	|			КОГДА т.ПометкаУдаления
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПомеченоНаУдаление
	|ИЗ
	|	ВТ_ПорученияКупона КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	п.Ответственный КАК Ответственный,
	|	КОЛИЧЕСТВО(п.Ссылка) КАК Поручений
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата МЕЖДУ &ДатаКупона И &КонецДняКупона
	|	И п.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.Сделка)
	|	И п.Направление = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделки.Покупка)
	|	И п.Актив В
	|			(ВЫБРАТЬ
	|				т.Актив
	|			ИЗ
	|				ВТ_Активы КАК т)
	|
	|СГРУППИРОВАТЬ ПО
	|	п.Ответственный
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поручений УБЫВ";
	Пакет = Запрос.ВыполнитьПакет();
	Итоги = Пакет[1].Выгрузить()[0];
	Реальные = Новый Структура;
	Реальные.Вставить("поручений", Итоги.Поручений);
	Реальные.Вставить("портфелей", Итоги.Портфелей);
	Реальные.Вставить("проведено", ЧислоИлиНоль(Итоги.Проведено));
	Реальные.Вставить("помечено_на_удаление", ЧислоИлиНоль(Итоги.ПомеченоНаУдаление));
	Реальные.Вставить("покупки_бумаг_купона_по_ответственным", ПоЗначениям(Пакет[2].Выгрузить(), "Ответственный",
		"Поручений"));
	Сведения.Вставить("реальные_поручения_в_дату_купона", Реальные);

	// Состояние этих портфелей сейчас: позиция на дату тестового режима и на дату купона, статус, история статуса.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	т.Портфель КАК Портфель
	|ПОМЕСТИТЬ ВТ_Портфели
	|ИЗ
	|	ВТ_ПорученияКупона КАК т
	|ГДЕ
	|	НЕ т.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ф.Портфель) КАК Портфелей
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК ф
	|ГДЕ
	|	ф.Дата = &ПозицияНаДату
	|	И ф.Портфель В
	|			(ВЫБРАТЬ
	|				т.Портфель
	|			ИЗ
	|				ВТ_Портфели КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ф.Портфель) КАК Портфелей
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК ф
	|ГДЕ
	|	ф.Дата = &ПозицияНаДату
	|	И ф.Портфель В
	|			(ВЫБРАТЬ
	|				т.Портфель
	|			ИЗ
	|				ВТ_Портфели КАК т)
	|	И ф.Актив В
	|			(ВЫБРАТЬ
	|				т.Актив
	|			ИЗ
	|				ВТ_Активы КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ф.Портфель) КАК Портфелей
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК ф
	|ГДЕ
	|	ф.Дата = &ДатаКупона
	|	И ф.Портфель В
	|			(ВЫБРАТЬ
	|				т.Портфель
	|			ИЗ
	|				ВТ_Портфели КАК т)
	|	И ф.Актив В
	|			(ВЫБРАТЬ
	|				т.Актив
	|			ИЗ
	|				ВТ_Активы КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	с.Значение КАК Статус,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т.Портфель) КАК Портфелей
	|ИЗ
	|	ВТ_Портфели КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК с
	|		ПО т.Портфель = с.Объект
	|			И (с.Свойство = &СвойствоСтатус)
	|
	|СГРУППИРОВАТЬ ПО
	|	с.Значение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Портфелей УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 5
	|	т.Портфель.ВнешнийКод КАК Код
	|ИЗ
	|	ВТ_Портфели КАК т";
	Пакет = Запрос.ВыполнитьПакет();
	Портфели = Новый Структура;
	Портфели.Вставить("портфелей", Итоги.Портфелей);
	Портфели.Вставить("с_любой_позицией_на_дату_тестового_режима", Пакет[1].Выгрузить()[0].Портфелей);
	Портфели.Вставить("с_бумагой_купона_на_дату_тестового_режима", Пакет[2].Выгрузить()[0].Портфелей);
	Портфели.Вставить("с_бумагой_купона_на_дату_купона", Пакет[3].Выгрузить()[0].Портфелей);
	Портфели.Вставить("статусы_сейчас", ПоЗначениям(Пакет[4].Выгрузить(), "Статус", "Портфелей"));
	Портфели.Вставить("образцы_кодов", Пакет[5].Выгрузить().ВыгрузитьКолонку("Код"));
	Сведения.Вставить("портфели_реальных_поручений", Портфели);

	Попытка
		Сведения.Вставить("статусы_до_даты_купона", СтатусыИзИстории(Запрос, Контекст.ДатаКупона));
	Исключение
		ДобавитьОшибку(Результат, "реинвест.статусы_до_даты_купона");
	КонецПопытки;

	// Шаги отбора обработки РОСТ в тестовом режиме (позиция на вчера).
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ф.Портфель) КАК Портфелей
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК ф
	|ГДЕ
	|	ф.Дата = &ПозицияНаДату
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ф.Портфель КАК Портфель
	|ПОМЕСТИТЬ ВТ_Отбор
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК ф
	|ГДЕ
	|	ф.Дата = &ПозицияНаДату
	|	И ф.Количество > 0
	|	И ф.Актив В
	|			(ВЫБРАТЬ
	|				т.Актив
	|			ИЗ
	|				ВТ_Активы КАК т
	|			ГДЕ
	|				т.РазмерДоходаВРублях > 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	с.Значение КАК Статус,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т.Портфель) КАК Портфелей
	|ИЗ
	|	ВТ_Отбор КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК с
	|		ПО т.Портфель = с.Объект
	|			И (с.Свойство = &СвойствоСтатус)
	|
	|СГРУППИРОВАТЬ ПО
	|	с.Значение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Портфелей УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ п.Портфель) КАК Портфелей
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата >= &Сегодня
	|	И п.Проведен
	|	И п.Портфель В
	|			(ВЫБРАТЬ
	|				т.Портфель
	|			ИЗ
	|				ВТ_Отбор КАК т)
	|	И п.Актив В
	|			(ВЫБРАТЬ
	|				т.Актив
	|			ИЗ
	|				ВТ_Активы КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 5
	|	т.Портфель.ВнешнийКод КАК Код
	|ИЗ
	|	ВТ_Отбор КАК т";
	Пакет = Запрос.ВыполнитьПакет();
	Отбор = Новый Структура;
	Отбор.Вставить("дата_позиции", Д(Контекст.ПозицияРеинвест));
	Отбор.Вставить("портфелей_с_позицией", Пакет[0].Выгрузить()[0].Портфелей);
	Статусы = Пакет[2].Выгрузить();
	Отбор.Вставить("портфелей_с_бумагой_купона", Статусы.Итог("Портфелей"));
	Отбор.Вставить("статусы", ПоЗначениям(Статусы, "Статус", "Портфелей"));
	Отбор.Вставить("отсеяно_по_статусу", ОтсеяноПоСтатусу(Статусы, Настройки));
	Отбор.Вставить("с_поручениями_сегодня", Пакет[3].Выгрузить()[0].Портфелей);
	Отбор.Вставить("образцы_кодов", Пакет[4].Выгрузить().ВыгрузитьКолонку("Код"));
	Сведения.Вставить("отбор_тестового_режима", Отбор);

	Попытка
		Сведения.Вставить("список_обработки_РОСТ", СписокОбработкиРОСТ(Контекст, "Реинвест"));
	Исключение
		ДобавитьОшибку(Результат, "реинвест.список_обработки_РОСТ");
	КонецПопытки;

	Возврат Сведения;

КонецФункции

Функция СведенияОБлокировках(Контекст, Результат)

	Настройки = Контекст.Настройки;
	Сведения = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Начало", Контекст.Сегодня - Контекст.ДнейИстории * 86400);
	Запрос.УстановитьПараметр("Конец", КонецДня(Контекст.Сегодня));
	Запрос.УстановитьПараметр("Сегодня", Контекст.Сегодня);
	Запрос.УстановитьПараметр("КонецСегодня", КонецДня(Контекст.Сегодня));
	Запрос.УстановитьПараметр("ПозицияНаДату", Контекст.ПозицияБлокировки);
	Запрос.УстановитьПараметр("Автор", ЗначениеНастройки(Настройки, "АвторЗаявок"));
	Запрос.УстановитьПараметр("LQDT", ЗначениеНастройки(Настройки, "АктивВимЛиквидность"));
	Запрос.УстановитьПараметр("СвойствоСтатус", ЗначениеНастройки(Настройки, "ДопРеквизитСтатусПортфеля"));

	// История: продажи LQDT от автора заявок РОСТ по дням и поручения на вывод денег тех же портфелей в тот же день.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(п.Дата, ДЕНЬ) КАК День,
	|	п.Портфель КАК Портфель,
	|	КОЛИЧЕСТВО(п.Ссылка) КАК Поручений
	|ПОМЕСТИТЬ ВТ_Продажи
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ п.ПометкаУдаления
	|	И п.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.Сделка)
	|	И п.Направление = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделки.Продажа)
	|	И п.Ответственный = &Автор
	|	И п.Актив = &LQDT
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(п.Дата, ДЕНЬ),
	|	п.Портфель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(п.Дата, ДЕНЬ) КАК День,
	|	п.Портфель КАК Портфель,
	|	СУММА(п.СуммаПоручения) КАК Сумма
	|ПОМЕСТИТЬ ВТ_Выводы
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ п.ПометкаУдаления
	|	И п.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.НеторговоеПоручение)
	|	И п.ВидОперацииНеторговогоПоручения = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНеторговыхПоручений.Вывод)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(п.Дата, ДЕНЬ),
	|	п.Портфель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	пр.День КАК День,
	|	СУММА(пр.Поручений) КАК ПродажLQDT,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ пр.Портфель) КАК Портфелей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Выводы.Портфель) КАК СВыводомВТотЖеДень
	|ИЗ
	|	ВТ_Продажи КАК пр
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Выводы КАК Выводы
	|		ПО пр.День = Выводы.День
	|			И пр.Портфель = Выводы.Портфель
	|
	|СГРУППИРОВАТЬ ПО
	|	пр.День
	|
	|УПОРЯДОЧИТЬ ПО
	|	День";
	Дни = Запрос.Выполнить().Выгрузить();
	История = Новый Массив;
	ЛучшийДень = Неопределено;
	Для Каждого Строка Из Дни Цикл
		День = Новый Структура;
		День.Вставить("день", Д(Строка.День));
		День.Вставить("продаж_LQDT", Строка.ПродажLQDT);
		День.Вставить("портфелей", Строка.Портфелей);
		День.Вставить("с_выводом_в_тот_же_день", Строка.СВыводомВТотЖеДень);
		История.Добавить(День);
		Если ЛучшийДень = Неопределено Или Строка.СВыводомВТотЖеДень > ЛучшийДень.СВыводомВТотЖеДень Тогда
			ЛучшийДень = Строка;
		КонецЕсли;
	КонецЦикла;
	Сведения.Вставить("продажи_LQDT_по_дням", История);

	Если ЛучшийДень <> Неопределено Тогда
		ДатаПозицииДня = НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(
			Справочники.ПроизводственныеКалендари.ТорговыйКалендарьММВБ, ЛучшийДень.День, -1));
		Запрос.УстановитьПараметр("День", ЛучшийДень.День);
		Запрос.УстановитьПараметр("ДатаПозицииДня", ДатаПозицииДня);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	пр.Портфель КАК Портфель,
		|	Выводы.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТ_ПортфелиДня
		|ИЗ
		|	ВТ_Продажи КАК пр
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Выводы КАК Выводы
		|		ПО пр.День = Выводы.День
		|			И пр.Портфель = Выводы.Портфель
		|ГДЕ
		|	пр.День = &День
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ф.Портфель) КАК Портфелей
		|ИЗ
		|	РегистрСведений.ФактическаяПозиция КАК ф
		|ГДЕ
		|	ф.Дата = &ДатаПозицииДня
		|	И ф.Актив = &LQDT
		|	И ф.Портфель В
		|			(ВЫБРАТЬ
		|				т.Портфель
		|			ИЗ
		|				ВТ_ПортфелиДня КАК т)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(т.Сумма) КАК Сумма,
		|	МИНИМУМ(т.Сумма) КАК Минимум,
		|	МАКСИМУМ(т.Сумма) КАК Максимум
		|ИЗ
		|	ВТ_ПортфелиДня КАК т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 5
		|	т.Портфель.ВнешнийКод КАК Код
		|ИЗ
		|	ВТ_ПортфелиДня КАК т";
		Пакет = Запрос.ВыполнитьПакет();
		Суммы = Пакет[2].Выгрузить()[0];
		День = Новый Структура;
		День.Вставить("день", Д(ЛучшийДень.День));
		День.Вставить("портфелей_с_продажей_и_выводом", ЛучшийДень.СВыводомВТотЖеДень);
		День.Вставить("дата_позиции_того_дня", Д(ДатаПозицииДня));
		День.Вставить("с_LQDT_на_дату_позиции_того_дня", Пакет[1].Выгрузить()[0].Портфелей);
		День.Вставить("сумма_выводов", ЧислоИлиНоль(Суммы.Сумма));
		День.Вставить("вывод_мин", ЧислоИлиНоль(Суммы.Минимум));
		День.Вставить("вывод_макс", ЧислоИлиНоль(Суммы.Максимум));
		День.Вставить("образцы_кодов", Пакет[3].Выгрузить().ВыгрузитьКолонку("Код"));
		Сведения.Вставить("лучший_день", День);
	КонецЕсли;

	// Шаги отбора обработки РОСТ в тестовом режиме (позиция на прошлый торговый день, вывод на конец сегодня).
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ф.Портфель КАК Портфель
	|ПОМЕСТИТЬ ВТ_LQDT
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК ф
	|ГДЕ
	|	ф.Дата = &ПозицияНаДату
	|	И ф.Актив = &LQDT
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	б.Портфель КАК Портфель
	|ПОМЕСТИТЬ ВТ_Блок
	|ИЗ
	|	РегистрНакопления.ПрогнозПоПоручению.Остатки(
	|			&КонецСегодня,
	|			Актив.ВидАктива = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыАктивов.Валюты)
	|				И Поручение.ВидОперацииНеторговогоПоручения = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНеторговыхПоручений.Вывод)) КАК б
	|ГДЕ
	|	б.КоличествоОстаток < 0
	|	И б.Портфель В
	|			(ВЫБРАТЬ
	|				т.Портфель
	|			ИЗ
	|				ВТ_LQDT КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т.Портфель) КАК Портфелей
	|ИЗ
	|	ВТ_LQDT КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	с.Значение КАК Статус,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т.Портфель) КАК Портфелей
	|ИЗ
	|	ВТ_Блок КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК с
	|		ПО т.Портфель = с.Объект
	|			И (с.Свойство = &СвойствоСтатус)
	|
	|СГРУППИРОВАТЬ ПО
	|	с.Значение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Портфелей УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ п.Портфель) КАК Портфелей
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата >= &Сегодня
	|	И п.Проведен
	|	И п.Актив = &LQDT
	|	И п.Портфель В
	|			(ВЫБРАТЬ
	|				т.Портфель
	|			ИЗ
	|				ВТ_Блок КАК т)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(п.Ссылка) КАК Поручений
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата >= &Сегодня
	|	И НЕ п.ПометкаУдаления
	|	И п.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.НеторговоеПоручение)
	|	И п.ВидОперацииНеторговогоПоручения = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНеторговыхПоручений.Вывод)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 5
	|	т.Портфель.ВнешнийКод КАК Код
	|ИЗ
	|	ВТ_Блок КАК т";
	Пакет = Запрос.ВыполнитьПакет();
	Отбор = Новый Структура;
	Отбор.Вставить("дата_позиции", Д(Контекст.ПозицияБлокировки));
	Отбор.Вставить("портфелей_с_LQDT", Пакет[2].Выгрузить()[0].Портфелей);
	Статусы = Пакет[3].Выгрузить();
	Отбор.Вставить("с_отрицательным_прогнозом_вывода", Статусы.Итог("Портфелей"));
	Отбор.Вставить("статусы", ПоЗначениям(Статусы, "Статус", "Портфелей"));
	Отбор.Вставить("отсеяно_по_статусу", ОтсеяноПоСтатусу(Статусы, Настройки));
	Отбор.Вставить("с_поручениями_LQDT_сегодня", Пакет[4].Выгрузить()[0].Портфелей);
	Отбор.Вставить("поручений_на_вывод_сегодня_в_базе", Пакет[5].Выгрузить()[0].Поручений);
	Отбор.Вставить("образцы_кодов", Пакет[6].Выгрузить().ВыгрузитьКолонку("Код"));
	Сведения.Вставить("отбор_тестового_режима", Отбор);

	Попытка
		Сведения.Вставить("список_обработки_РОСТ", СписокОбработкиРОСТ(Контекст, "Блокировки"));
	Исключение
		ДобавитьОшибку(Результат, "блокировки.список_обработки_РОСТ");
	КонецПопытки;

	Возврат Сведения;

КонецФункции

#КонецОбласти

#Область Вспомогательные

// Список зарегистрированной обработки РОСТ в тестовом режиме - тот, что трейдер увидит по кнопке обновления.
// ДатаКупона - дата купона реинвестирования; не задана - Контекст.ДатаКупона.
Функция СписокОбработкиРОСТ(Контекст, Операция, ДатаКупона = Неопределено)

	Обработка = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Контекст.ЭлементРОСТ);
	Обработка.УстановитьНастройки(Новый Структура("ДополнительнаяОбработкаСсылка", Контекст.ЭлементРОСТ));
	Обработка.ЭтоТест = Истина;

	ТекстОшибки = "";
	ВажностьОшибки = 0;
	Если Операция = "Реинвест" Тогда
		Если ДатаКупона = Неопределено Тогда
			ДатаКупона = Контекст.ДатаКупона;
		КонецЕсли;
		Обработка.РеинвестОбновитьСписокПотфелей(ДатаКупона, Истина, 0, 0, ТекстОшибки, ВажностьОшибки);
		Таблица = Обработка.СписокПортфелейРеинвестирование;
	Иначе
		Обработка.БлокировкиПродажиОбновитьСписокПотфелей("LQDT", Истина, ТекстОшибки, ВажностьОшибки);
		Таблица = Обработка.СписокПортфелейПродажиПодБлокировки;
	КонецЕсли;

	Сведения = Новый Структура;
	Сведения.Вставить("строк", Таблица.Количество());
	Сведения.Вставить("ошибка", ТекстОшибки);
	Коды = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Коды.Добавить(Строка(Строка.Портфель.ВнешнийКод));
		Если Коды.Количество() = 5 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Сведения.Вставить("образцы_кодов", Коды);
	Возврат Сведения;

КонецФункции

// Ищет даты купона, по которым реинвестирование было на самом деле: дни с массовыми покупками облигаций
// автором заявок РОСТ и выплаты купона этих облигаций за 14 дней до покупки. Для каждой найденной даты купона
// (не больше пяти) показывает, сколько строк вернет обработка РОСТ в тестовом режиме.
//
// Параметры:
//  Контекст - Структура - см. Диагностика
//  Результат - Структура - для записи ошибок
//
// Возвращаемое значение:
//  Структура - * покупки_облигаций_по_дням - Массив из Строка; * списки_по_датам_купона - Массив из Строка
//
Функция ПоискДатыКупона(Контекст, Результат)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Контекст.Сегодня - Контекст.ДнейИстории * 86400);
	Запрос.УстановитьПараметр("Конец", КонецДня(Контекст.Сегодня));
	Запрос.УстановитьПараметр("Автор", ЗначениеНастройки(Контекст.Настройки, "АвторЗаявок"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(п.Дата, ДЕНЬ) КАК День,
	|	п.Актив КАК Актив,
	|	ВЫРАЗИТЬ(п.Актив.Объект КАК Справочник.Облигации) КАК Облигация,
	|	КОЛИЧЕСТВО(п.Ссылка) КАК Поручений,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ п.Портфель) КАК Портфелей
	|ПОМЕСТИТЬ ВТ_Покупки
	|ИЗ
	|	Документ.Поручение КАК п
	|ГДЕ
	|	п.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ п.ПометкаУдаления
	|	И п.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.Сделка)
	|	И п.Направление = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделки.Покупка)
	|	И п.Ответственный = &Автор
	|	И п.Актив.Объект ССЫЛКА Справочник.Облигации
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(п.Дата, ДЕНЬ),
	|	п.Актив,
	|	ВЫРАЗИТЬ(п.Актив.Объект КАК Справочник.Облигации)
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(п.Ссылка) >= 50
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	пок.День КАК День,
	|	пок.Актив КАК Актив,
	|	пок.Поручений КАК Поручений,
	|	пок.Портфелей КАК Портфелей,
	|	к.ДатаВыплатыКупонногоДохода КАК ДатаКупона
	|ИЗ
	|	ВТ_Покупки КАК пок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КупонноеРасписание.Купоны КАК к
	|		ПО (к.Ссылка.Облигация = пок.Облигация)
	|			И (НЕ к.Ссылка.ПометкаУдаления)
	|			И (к.РазмерДоходаВРублях > 0)
	|			И (к.ДатаВыплатыКупонногоДохода МЕЖДУ ДОБАВИТЬКДАТЕ(пок.День, ДЕНЬ, -14) И пок.День)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поручений УБЫВ,
	|	День";
	Таблица = Запрос.Выполнить().Выгрузить();

	Покупки = Новый Массив;
	ДатыКупона = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		ТекстКупона = "купона за 14 дней нет";
		Если ЗначениеЗаполнено(Строка.ДатаКупона) Тогда
			ТекстКупона = "купон " + Д(Строка.ДатаКупона);
			Если ДатыКупона.Найти(Строка.ДатаКупона) = Неопределено И ДатыКупона.Количество() < 5 Тогда
				ДатыКупона.Добавить(Строка.ДатаКупона);
			КонецЕсли;
		КонецЕсли;
		Если Покупки.Количество() < 30 Тогда
			Покупки.Добавить(СтрШаблон("%1: %2; поручений %3; портфелей %4; %5", Д(Строка.День), Строка(Строка.Актив),
				Формат(Строка.Поручений, "ЧН=0; ЧГ=0"), Формат(Строка.Портфелей, "ЧН=0; ЧГ=0"), ТекстКупона));
		КонецЕсли;
	КонецЦикла;

	Сведения = Новый Структура;
	Сведения.Вставить("покупки_облигаций_по_дням", Покупки);
	Списки = Новый Массив;
	Для Каждого ДатаКупонаКандидат Из ДатыКупона Цикл
		Попытка
			Список = СписокОбработкиРОСТ(Контекст, "Реинвест", ДатаКупонаКандидат);
			Списки.Добавить(Д(ДатаКупонаКандидат) + ": строк " + Формат(Список.строк, "ЧН=0; ЧГ=0"));
		Исключение
			ДобавитьОшибку(Результат, "поиск_даты_купона." + Д(ДатаКупонаКандидат));
		КонецПопытки;
	КонецЦикла;
	Сведения.Вставить("списки_по_датам_купона", Списки);
	Возврат Сведения;

КонецФункции

// Статусы портфелей ВТ_Портфели по истории статусов на начало дня. Регистр истории есть не во всех базах:
// при его отсутствии запрос падает, раздел пишется в ошибки.
Функция СтатусыИзИстории(Запрос, НаДату)

	Запрос.УстановитьПараметр("НаДату", НачалоДня(НаДату));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	История.СтатусПортфеля КАК Статус,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т.Портфель) КАК Портфелей
	|ИЗ
	|	ВТ_Портфели КАК т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВТБ_СтатусыПортфелей.СрезПоследних(
	|				&НаДату,
	|				Портфель В
	|					(ВЫБРАТЬ
	|						т.Портфель
	|					ИЗ
	|						ВТ_Портфели КАК т)) КАК История
	|		ПО т.Портфель = История.Портфель
	|
	|СГРУППИРОВАТЬ ПО
	|	История.СтатусПортфеля
	|
	|УПОРЯДОЧИТЬ ПО
	|	Портфелей УБЫВ";
	Возврат ПоЗначениям(Запрос.Выполнить().Выгрузить(), "Статус", "Портфелей");

КонецФункции

// Число портфелей, которые отбор обработки РОСТ отбрасывает по статусу: статус из исключенных или статуса нет
// (условие "НЕ Статус В (...)" при отсутствии статуса строку не пропускает).
Функция ОтсеяноПоСтатусу(Статусы, Настройки)

	Исключить = Новый Массив;
	Для Каждого Имя Из СтрРазделить("СтатусРасторжениеИнициировано,СтатусОрдераНаПродажуСформированы,"
		+ "СтатусОрдераНаПродажуОтправлены,СтатусОрдераНаПродажуИсполнены,СтатусПорученияНаВыводПоданы,"
		+ "СтатусПорученияНаВыводИсполнены", ",") Цикл
		Исключить.Добавить(ЗначениеНастройки(Настройки, Имя));
	КонецЦикла;

	Отсеяно = 0;
	Для Каждого Строка Из Статусы Цикл
		Если Строка.Статус = NULL Или Исключить.Найти(Строка.Статус) <> Неопределено Тогда
			Отсеяно = Отсеяно + Строка.Портфелей;
		КонецЕсли;
	КонецЦикла;
	Возврат Отсеяно;

КонецФункции

Функция ЗначениеНастройки(Настройки, Имя)

	Значение = Неопределено;
	Настройки.Свойство(Имя, Значение);
	Возврат Значение;

КонецФункции

Функция ПоДатам(Таблица, ИмяЧисла)

	Список = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Список.Добавить(Д(Строка.Дата) + ": " + Формат(Строка[ИмяЧисла], "ЧН=0; ЧГ=0"));
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция ПоЗначениям(Таблица, ИмяЗначения, ИмяЧисла)

	Список = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Значение = Строка[ИмяЗначения];
		Представление = "<нет>";
		Если Значение <> NULL Тогда
			Представление = Строка(Значение);
		КонецЕсли;
		Список.Добавить(Представление + ": " + Формат(Строка[ИмяЧисла], "ЧН=0; ЧГ=0"));
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция Д(Дата)

	Возврат Формат(Дата, "ДФ=dd.MM.yyyy");

КонецФункции

Процедура ДобавитьОшибку(Результат, Раздел)

	Результат.ошибки.Добавить(Раздел + ": " + Лев(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), 1000));

КонецПроцедуры

Процедура ВывестиЗначение(Строки, Значение, Отступ)

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент.Значение) = Тип("Структура") Или ТипЗнч(Элемент.Значение) = Тип("Массив") Тогда
				Строки.Добавить(Отступ + Элемент.Ключ + ":");
				ВывестиЗначение(Строки, Элемент.Значение, Отступ + "    ");
			Иначе
				Строки.Добавить(Отступ + Элемент.Ключ + ": " + ЗначениеСтрокой(Элемент.Значение));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Если Значение.Количество() = 0 Тогда
			Строки.Добавить(Отступ + "(пусто)");
		КонецЕсли;
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент) = Тип("Структура") Тогда
				Строки.Добавить(Отступ + "-");
				ВывестиЗначение(Строки, Элемент, Отступ + "    ");
			Иначе
				Строки.Добавить(Отступ + "- " + ЗначениеСтрокой(Элемент));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Строки.Добавить(Отступ + ЗначениеСтрокой(Значение));
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеСтрокой(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") И Значение Тогда
		Возврат "да";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат "нет";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
