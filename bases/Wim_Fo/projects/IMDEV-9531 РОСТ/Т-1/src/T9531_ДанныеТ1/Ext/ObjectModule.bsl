// IMDEV-9531: служебная обработка для копии ПРОД (Т-1). Диагностика данных для ручной проверки реинвестирования
// и продаж под блокировки обработки "Создание торговых поручений РОСТ" в тестовом режиме. Данные не меняет.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Собирает диагностику: какие реальные запуски реинвестирования и продаж под блокировки есть в базе и на каком
// шаге отбора обработки РОСТ (тестовый режим) отсеиваются портфели сейчас. Каждый раздел выполняется отдельно:
// ошибка раздела пишется в "ошибки", остальные разделы выполняются.
//
// Параметры:
//  ДатаКупона - Дата - дата выплаты купона для реинвестирования
//  ДнейИстории - Число - глубина поиска продаж под блокировки, дней
//
// Возвращаемое значение:
//  Структура - результат из строк, чисел, булевых значений, структур и массивов (пригоден для ЗаписатьJSON)
//
Функция Диагностика(ДатаКупона, ДнейИстории) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("версия_диагностики", "1.1");
	Результат.Вставить("ошибки", Новый Массив);

	Контекст = Новый Структура;
	Контекст.Вставить("Сегодня", НачалоДня(ТекущаяДата()));
	Контекст.Вставить("ДатаКупона", НачалоДня(ДатаКупона));
	Контекст.Вставить("ДнейИстории", ДнейИстории);
	Если ДнейИстории <= 0 Тогда
		Контекст.ДнейИстории = 60;
	КонецЕсли;
	Контекст.Вставить("Настройки", Неопределено);
	Контекст.Вставить("ЭлементРОСТ", Неопределено);

	Попытка
		Результат.Вставить("база", СведенияОБазе());
	Исключение
		ДобавитьОшибку(Результат, "база");
	КонецПопытки;

	Попытка
		Результат.Вставить("рост", СведенияОРОСТ(Контекст));
	Исключение
		ДобавитьОшибку(Результат, "рост");
	КонецПопытки;

	Попытка
		Результат.Вставить("даты", СведенияОДатах(Контекст));
	Исключение
		ДобавитьОшибку(Результат, "даты");
	КонецПопытки;

	Если Контекст.Настройки = Неопределено Тогда
		Результат.ошибки.Добавить("Настройки обработки РОСТ не найдены: разделы реинвестирования и блокировок пропущены");
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.Вставить("реинвест", СведенияОРеинвестировании(Контекст, Результат));
	Исключение
		ДобавитьОшибку(Результат, "реинвест");
	КонецПопытки;

	Попытка
		Результат.Вставить("поиск_даты_купона", ПоискДатыКупона(Контекст, Результат));
	Исключение
		ДобавитьОшибку(Результат, "поиск_даты_купона");
	КонецПопытки;

	Попытка
		Результат.Вставить("блокировки", СведенияОБлокировках(Контекст, Результат));
	Исключение
		ДобавитьОшибку(Результат, "блокировки");
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Текст результата диагностики для формы: разделы и значения с отступами.
//
// Параметры:
//  Результат - Структура - см. Диагностика
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстРезультата(Результат) Экспорт

	Строки = Новый Массив;
	ВывестиЗначение(Строки, Результат, "");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// JSON результата диагностики с отступами.
//
// Параметры:
//  Результат - Структура - см. Диагностика
//
// Возвращаемое значение:
//  Строка
//
Функция JSONРезультата(Результат) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, Результат);
