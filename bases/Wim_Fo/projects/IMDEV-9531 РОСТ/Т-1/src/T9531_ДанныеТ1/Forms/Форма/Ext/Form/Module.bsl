#Область ОбработчикиСобытийФормы

// Заполняет параметры по умолчанию: купон реинвестирования 16.09.2026, история блокировок 60 дней, метки прогонов.
//
// Параметры:
//  Отказ - Булево - не используется
//  СтандартнаяОбработка - Булево - не используется
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаКупона       = Дата(2026, 9, 16);
	ДнейИстории      = 60;
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	МеткаПрогона     = "1.18";
	МеткаА           = "1.18";
	МеткаБ           = "1.25";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Выполняет диагностику на сервере и показывает результат текстом. Данные базы не меняются.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Диагностика(Команда)

	Результат = "Выполняется диагностика...";
	ДиагностикаНаСервере();

КонецПроцедуры

// Предлагает сохранить результат последней диагностики в файл JSON.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(РезультатJSON) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала выполните диагностику");
		Возврат;
	КонецЕсли;

	ИмяФайла = "T1_диагностика_РОСТ_" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=dd.MM.yyyy") + ".json";
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресФайлаJSON(), ИмяФайла);

КонецПроцедуры

// Фиксирует прогон с меткой МеткаПрогона и показывает его сводку.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ЗафиксироватьПрогон(Команда)

	Если Не ЗначениеЗаполнено(МеткаПрогона) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите метку прогона, например 1.16 или 1.21", , "МеткаПрогона");
		Возврат;
	КонецЕсли;
	ВыполнитьНаСервере("Зафиксировать");

КонецПроцедуры

// После подтверждения помечает на удаление поручения РОСТ за сегодня и возвращает статусы портфелей.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Асинх Процедура СброситьПрогон(Команда)

	ТекстВопроса = "Пометить на удаление торговые поручения РОСТ за сегодня и вернуть статусы портфелей?" + Символы.ПС
		+ "База: " + СтрокаСоединения;
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьНаСервере("Сбросить");
	КонецЕсли;

КонецПроцедуры

// Сравнивает прогоны МеткаА и МеткаБ.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СравнитьПрогоны(Команда)

	ВыполнитьНаСервере("Сравнить");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет действие с прогонами и выводит результат текстом и в JSON. Ошибка выводится в поле результата.
//
// Параметры:
//  Действие - Строка - "Зафиксировать", "Сбросить" или "Сравнить"
//
&НаСервере
Процедура ВыполнитьНаСервере(Действие)

	Обработка = РеквизитФормыВЗначение("Объект");
	Попытка
		Если Действие = "Зафиксировать" Тогда
			Данные = Обработка.ЗафиксироватьПрогон(МеткаПрогона);
		ИначеЕсли Действие = "Сбросить" Тогда
			Данные = Обработка.СброситьПрогон();
		Иначе
			Данные = Обработка.СравнитьПрогоны(МеткаА, МеткаБ);
		КонецЕсли;
	Исключение
		Результат = Действие + ": ошибка" + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		РезультатJSON = "";
		Возврат;
	КонецПопытки;
	Результат = Действие + Символы.ПС + Обработка.ТекстРезультата(Данные);
	РезультатJSON = Обработка.JSONРезультата(Данные);

КонецПроцедуры

// Выполняет диагностику обработки и заполняет реквизиты Результат (текст) и РезультатJSON.
//
&НаСервере
Процедура ДиагностикаНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = Обработка.Диагностика(ДатаКупона, ДнейИстории);
	Результат = Обработка.ТекстРезультата(Данные);
	РезультатJSON = Обработка.JSONРезультата(Данные);

КонецПроцедуры

// Помещает JSON результата во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла (UTF-8 без BOM)
//
&НаСервере
Функция АдресФайлаJSON()

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(РезультатJSON, "UTF-8", Ложь);
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
