Процедура ОткрытьНастройки(Команда)
	
	ПараметрыНастроек = Новый Структура;
	ПараметрыНастроек.Вставить("ДопОбработка", ДополнительнаяОбработка);
	ОткрытьФорму("ВнешняяОбработка.СозданиеТорговыхПорученийРОСТ.Форма.ФормаНастроек", ПараметрыНастроек, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Функция СоздатьПорученияПродажаНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	
	//Установить настройки
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработка);
	Об.УстановитьНастройки(ПараметрыВыполнения);
	
	ТекстОшибки = "";
	ВажностьОшибки = 0;
	КоличествоПоручений = 0;
	
	Об.СоздатьПорученияПродажа(КоличествоПоручений, ТекстОшибки, ВажностьОшибки);
	Об.ЗаполнитьСписокПродажаАктивов(НеПоказыватьПортфелиСПоручениями, ТекстОшибки, ВажностьОшибки);
	
	ЗначениеВРеквизитФормы(Об, "Объект");
	
	Если ВажностьОшибки = 2 Тогда
		Сообщить("В процессе создания поручений произошли ошибки. Подробности см. в логе ошибок")
	КонецЕсли;
	
	Возврат 0;
КонецФункции

