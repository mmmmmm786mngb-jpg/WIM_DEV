&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДополнительнаяОбработка = ДополнительнаяОбработкаСсылка(ОбработкаОбъект);
	
	Если ДополнительнаяОбработка <> Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда
		ВосстановитьНастройки(ДополнительнаяОбработка, ОбработкаОбъект)
	КонецЕсли; 
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");

	УстановитьДоступностьКнопокПоАктивныиЗаданиям();
	
КонецПроцедуры

&НаСервере
Функция ДополнительнаяОбработкаСсылка(ОбработкаОбъект)

	ДополнительнаяОбработкаСсылка = Неопределено;
	
	Если Параметры.Свойство("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка) Тогда
		Если ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда
			ИмяОбработки = ОбработкаОбъект.Метаданные().Имя;
			ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбработки);
		КонецЕсли;
	Иначе
		ИмяОбработки = ОбработкаОбъект.Метаданные().Имя;
		ДополнительнаяОбработкаСсылка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", ИмяОбработки);
	КонецЕсли;
	
	Возврат ДополнительнаяОбработкаСсылка;

КонецФункции

&НаСервере
Процедура ВосстановитьНастройки(ДополнительнаяОбработкаСсылка, ОбработкаОбъект)

	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
	ОбработкаОбъект.УстановитьНастройки(ПараметрыВыполнения);

КонецПроцедуры

&НаСервере
Функция СоздатьПорученияНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	
	//Установить настройки
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработка);
	Об.УстановитьНастройки(ПараметрыВыполнения);
	
	ТабДок = Новый ТабличныйДокумент;
	ВажностьОшибки = 0;
	КоличествоЗаписей = Об.СоздатьПоручения(ТабДок,ВажностьОшибки);
	
	Если ВажностьОшибки = 2 Тогда
		Сообщить("В процессе создания неторговых поручений произошли ошибки. Подробности см. в логе ошибок")
	КонецЕсли;
	
	
	Возврат ТабДок
	
КонецФункции

&НаКлиенте
Процедура СоздатьПоручения(Команда)
	
	РезультатОбработки = СоздатьПорученияНаСервере();

КонецПроцедуры

