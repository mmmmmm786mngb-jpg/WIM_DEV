    |            И ОстаткиДепозитов.currency = ПроцентыЗаДень.currency";

КонецФункции

Функция КлючТаблицы(Таблица)

    Если Таблица = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Копия = Таблица.Скопировать();
    Копия.Сортировать("id, currency");
    Части = Новый Массив;

    Для Каждого СтрокаТаблицы Из Копия Цикл
        Части.Добавить(
            Строка(СтрокаТаблицы.id) + "~"
            + Строка(СтрокаТаблицы.currency) + "~"
            + Формат(СтрокаТаблицы.currentvalue, "ЧРД=.; ЧГ=0; ЧН=0") + "~"
            + Формат(СтрокаТаблицы.initialvalue, "ЧРД=.; ЧГ=0; ЧН=0") + "~"
            + Формат(СтрокаТаблицы.marketvalue, "ЧРД=.; ЧГ=0; ЧН=0") + "~"
            + Формат(СтрокаТаблицы.day_interest, "ЧРД=.; ЧГ=0; ЧН=0") + "~"
            + Формат(СтрокаТаблицы.interest, "ЧРД=.; ЧГ=0; ЧН=0") + "~"
            + Формат(СтрокаТаблицы.datestart, "ДФ=yyyyMMddHHmmss") + "~"
            + Формат(СтрокаТаблицы.datematurity, "ДФ=yyyyMMddHHmmss"));
    КонецЦикла;

    Ключ = СтрСоединить(Части, "#");
    Ключ = СтрЗаменить(Ключ, ";", ",");
    Ключ = СтрЗаменить(Ключ, "=", ":");
    Возврат Ключ;

КонецФункции

Функция ПустаяТаблицаДепозитов()

    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("id", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("source", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("name", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("marketvalue", Новый ОписаниеТипов("Число"));
    Таблица.Колонки.Добавить("currentvalue", Новый ОписаниеТипов("Число"));
    Таблица.Колонки.Добавить("initialvalue", Новый ОписаниеТипов("Число"));
    Таблица.Колонки.Добавить("currency", Новый ОписаниеТипов("Строка"));
    Таблица.Колонки.Добавить("datestart", Новый ОписаниеТипов("Дата"));
    Таблица.Колонки.Добавить("datematurity", Новый ОписаниеТипов("Дата"));
    Таблица.Колонки.Добавить("interest", Новый ОписаниеТипов("Число"));
    Таблица.Колонки.Добавить("day_interest", Новый ОписаниеТипов("Число"));
    Таблица.Колонки.Добавить("БанковскийСчет", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
    Возврат Таблица;

КонецФункции

Функция НазваниеБазы()

    СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
    ИндексБазы = СтрНайти(СтрокаСоединения, "Ref=");
    Если ИндексБазы = 0 Тогда
        Возврат СтрокаСоединения;
    КонецЕсли;

    Обрезка = Сред(СтрокаСоединения, ИндексБазы + 5);
    ИндексКонца = СтрНайти(Обрезка, """");
    Возврат Сред(Обрезка, 1, ИндексКонца - 1);

КонецФункции
