
// Собирает таблицу депозитов для ответа getDeposits. Отличается от функции конфигурации только частями
// ДатыВыдачи и ПервоначальныеСуммы: виртуальная таблица ДвиженияССубконто читается один раз во временную
// таблицу ДвиженияВыдачи, минимальный период выдачи и сумма проводки этого периода считаются по ней.
// Состав и значения строк ответа те же, что у функции конфигурации, включая две строки при двух проводках
// выдачи с одинаковым периодом. Данные не записывает.
//
// Параметры:
//  ДатаЗапроса - Дата - момент, на который строится ответ сервиса
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. ПустаяТаблицаДепозитов модуля веб-сервиса
//
&ИзменениеИКонтроль("ТаблицаДепозитов")
Функция ПИФД_ТаблицаДепозитов(ДатаЗапроса)
	
	ИмяБазы = НазваниеБазы();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаЗапроса", ДатаЗапроса);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("НаименованиеВалютыРегламентированногоУчета", ОбщегоНазначения.ПолучитьЗначениеРеквизита(ПараметрыСеанса.ВалютаРегл, "Наименование"));
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(УправленческийОстатки.Субконто1 КАК Справочник.БанковскиеСчета) КАК БанковскийСчет,
		|	ВЫРАЗИТЬ(УправленческийОстатки.Субконто1 КАК Справочник.БанковскиеСчета).Банк КАК Банк,
		|	ВЫРАЗИТЬ(УправленческийОстатки.Субконто1 КАК Справочник.БанковскиеСчета).НомерСчета КАК НомерСчета,
		|	ВЫРАЗИТЬ(УправленческийОстатки.Субконто1 КАК Справочник.БанковскиеСчета).ГодоваяПроцентнаяСтавка КАК interest,
		|	ВЫБОР
		|		КОГДА УправленческийОстатки.Счет.Валютный
		|			ТОГДА УправленческийОстатки.ВалютнаяСуммаОстатокДт
		|		ИНАЧЕ УправленческийОстатки.СуммаОстатокДт
		|	КОНЕЦ КАК currentvalue,
		|	ЕСТЬNULL(УправленческийОстатки.Валюта.Наименование, &НаименованиеВалютыРегламентированногоУчета) КАК currency,
		|	ВЫРАЗИТЬ(УправленческийОстатки.Субконто1 КАК Справочник.БанковскиеСчета).ДатаЗакрытия КАК datematurity
		|ПОМЕСТИТЬ ОстаткиДепозитов
		|ИЗ
		|	РегистрБухгалтерии.Управленческий.Остатки(
		|			&ДатаЗапроса,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Управленческий.РасчетныеСчета), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.ВалютныеСчета), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.СпециальныеСчета)),
		|			,
		|			ВЫРАЗИТЬ(Субконто1 КАК Справочник.БанковскиеСчета).НачислениеПроцентов = ИСТИНА
		|				И ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(Субконто1 КАК Справочник.БанковскиеСчета).ДатаЗакрытия = &ПустаяДата
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ КОНЕЦПЕРИОДА(ВЫРАЗИТЬ(Субконто1 КАК Справочник.БанковскиеСчета).ДатаЗакрытия, ДЕНЬ) >= КОНЕЦПЕРИОДА(&ДатаЗапроса, ДЕНЬ)
		|				КОНЕЦ) КАК УправленческийОстатки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БанковскийСчет,
		|	currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(УправленческийОбороты.КорСубконто1 КАК Справочник.БанковскиеСчета) КАК БанковскийСчет,
		|	ВЫБОР
		|		КОГДА УправленческийОбороты.Счет.Валютный
		|			ТОГДА УправленческийОбороты.ВалютнаяСуммаОборот
		|		ИНАЧЕ УправленческийОбороты.СуммаОборот
		|	КОНЕЦ КАК СуммаПроцентов,
		|	ЕСТЬNULL(УправленческийОбороты.Валюта.Наименование, &НаименованиеВалютыРегламентированногоУчета) КАК currency
		|ПОМЕСТИТЬ ПроцентыПоДепозитам
		|ИЗ
		|	РегистрБухгалтерии.Управленческий.Обороты(
		|			,
		|			&ДатаЗапроса,
		|			,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Управленческий.РасчетыПроцентыБанковскийДепозит),
		|			,
		|			ВЫРАЗИТЬ(КорСубконто1 КАК Справочник.БанковскиеСчета) В
		|				(ВЫБРАТЬ
		|					ОстаткиДепозитов.БанковскийСчет
		|				ИЗ
		|					ОстаткиДепозитов КАК ОстаткиДепозитов),
		|			КорСчет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Управленческий.ПроцентыДепозиты), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.Вспомогательный)),
		|			) КАК УправленческийОбороты
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БанковскийСчет,
		|	currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(УправленческийОбороты.КорСубконто1 КАК Справочник.БанковскиеСчета) КАК БанковскийСчет,
		|	ВЫБОР
		|		КОГДА УправленческийОбороты.Счет.Валютный
		|			ТОГДА УправленческийОбороты.ВалютнаяСуммаОборот
		|		ИНАЧЕ УправленческийОбороты.СуммаОборот
		|	КОНЕЦ КАК СуммаПроцентов,
		|	ЕСТЬNULL(УправленческийОбороты.Валюта.Наименование, &НаименованиеВалютыРегламентированногоУчета) КАК currency
		|ПОМЕСТИТЬ ПроцентыЗаДень
		|ИЗ
		|	РегистрБухгалтерии.Управленческий.Обороты(
		|			НАЧАЛОПЕРИОДА(&ДатаЗапроса, ДЕНЬ),
		|			КОНЕЦПЕРИОДА(&ДатаЗапроса, ДЕНЬ),
		|			День,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Управленческий.РасчетыПроцентыБанковскийДепозит),
		|			,
		|			ВЫРАЗИТЬ(КорСубконто1 КАК Справочник.БанковскиеСчета) В
		|				(ВЫБРАТЬ
		|					ОстаткиДепозитов.БанковскийСчет
		|				ИЗ
		|					ОстаткиДепозитов КАК ОстаткиДепозитов),
		|			КорСчет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Управленческий.ПроцентыДепозиты), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.Вспомогательный)),
		|			) КАК УправленческийОбороты
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БанковскийСчет,
		|	currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
#Удаление
		|ВЫБРАТЬ
		|	Движения.СубконтоДт1 КАК БанковскийСчет,
		|	ЕСТЬNULL(Движения.ВалютаДт.Наименование, &НаименованиеВалютыРегламентированногоУчета) КАК currency,
		|	МИНИМУМ(Движения.Период) КАК Период
		|ПОМЕСТИТЬ ДатыВыдачи
		|ИЗ
		|	РегистрБухгалтерии.Управленческий.ДвиженияССубконто(
		|			,
		|			&ДатаЗапроса,
		|			ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.БанковскиеСчета) В
		|					(ВЫБРАТЬ
		|						ОстаткиДепозитов.БанковскийСчет
		|					ИЗ
		|						ОстаткиДепозитов КАК ОстаткиДепозитов)
		|				И СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Управленческий.РасчетныеСчета), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.ВалютныеСчета), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.СпециальныеСчета)),
		|			,
		|			) КАК Движения
		|
		|СГРУППИРОВАТЬ ПО
		|	Движения.СубконтоДт1,
		|	ЕСТЬNULL(Движения.ВалютаДт.Наименование, &НаименованиеВалютыРегламентированногоУчета)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БанковскийСчет,
		|	currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыВыдачи.БанковскийСчет КАК БанковскийСчет,
		|	ДатыВыдачи.currency КАК currency,
		|	ВЫБОР
		|		КОГДА Движения.СчетДт.Валютный
		|			ТОГДА Движения.ВалютнаяСуммаДт
		|		ИНАЧЕ Движения.Сумма
		|	КОНЕЦ КАК initialvalue
		|ПОМЕСТИТЬ ПервоначальныеСуммы
		|ИЗ
		|	РегистрБухгалтерии.Управленческий.ДвиженияССубконто(
		|			,
		|			&ДатаЗапроса,
		|			ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.БанковскиеСчета) В
		|					(ВЫБРАТЬ
		|						ОстаткиДепозитов.БанковскийСчет
		|					ИЗ
		|						ОстаткиДепозитов КАК ОстаткиДепозитов)
		|				И СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Управленческий.РасчетныеСчета), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.ВалютныеСчета), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.СпециальныеСчета)),
		|			,
		|			) КАК Движения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатыВыдачи КАК ДатыВыдачи
		|		ПО Движения.Период = ДатыВыдачи.Период
		|			И Движения.СубконтоДт1 = ДатыВыдачи.БанковскийСчет
		|			И (ЕСТЬNULL(Движения.ВалютаДт.Наименование, &НаименованиеВалютыРегламентированногоУчета) = ДатыВыдачи.currency)
#КонецУдаления
#Вставка
		|ВЫБРАТЬ
		|	Движения.СубконтоДт1 КАК БанковскийСчет,
		|	ЕСТЬNULL(Движения.ВалютаДт.Наименование, &НаименованиеВалютыРегламентированногоУчета) КАК currency,
		|	Движения.Период КАК Период,
		|	ВЫБОР
		|		КОГДА Движения.СчетДт.Валютный
		|			ТОГДА Движения.ВалютнаяСуммаДт
		|		ИНАЧЕ Движения.Сумма
		|	КОНЕЦ КАК СуммаВыдачи
		|ПОМЕСТИТЬ ДвиженияВыдачи
		|ИЗ
		|	РегистрБухгалтерии.Управленческий.ДвиженияССубконто(
		|			,
		|			&ДатаЗапроса,
		|			ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.БанковскиеСчета) В
		|					(ВЫБРАТЬ
		|						ОстаткиДепозитов.БанковскийСчет
		|					ИЗ
		|						ОстаткиДепозитов КАК ОстаткиДепозитов)
		|				И СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Управленческий.РасчетныеСчета), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.ВалютныеСчета), ЗНАЧЕНИЕ(ПланСчетов.Управленческий.СпециальныеСчета)),
		|			,
		|			) КАК Движения
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БанковскийСчет,
		|	currency,
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДвиженияВыдачи.БанковскийСчет КАК БанковскийСчет,
		|	ДвиженияВыдачи.currency КАК currency,
		|	МИНИМУМ(ДвиженияВыдачи.Период) КАК Период
		|ПОМЕСТИТЬ ДатыВыдачи
		|ИЗ
		|	ДвиженияВыдачи КАК ДвиженияВыдачи
		|
		|СГРУППИРОВАТЬ ПО
		|	ДвиженияВыдачи.БанковскийСчет,
		|	ДвиженияВыдачи.currency
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БанковскийСчет,
		|	currency,
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыВыдачи.БанковскийСчет КАК БанковскийСчет,
		|	ДатыВыдачи.currency КАК currency,
		|	ДвиженияВыдачи.СуммаВыдачи КАК initialvalue
		|ПОМЕСТИТЬ ПервоначальныеСуммы
		|ИЗ
		|	ДвиженияВыдачи КАК ДвиженияВыдачи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатыВыдачи КАК ДатыВыдачи
		|		ПО ДвиженияВыдачи.Период = ДатыВыдачи.Период
		|			И ДвиженияВыдачи.БанковскийСчет = ДатыВыдачи.БанковскийСчет
		|			И ДвиженияВыдачи.currency = ДатыВыдачи.currency
#КонецВставки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БанковскийСчет,
		|	currency
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиДепозитов.БанковскийСчет,
		|	ОстаткиДепозитов.Банк КАК Банк,
		|	ОстаткиДепозитов.НомерСчета КАК НомерСчета,
		|	ОстаткиДепозитов.currency,
		|	ОстаткиДепозитов.currentvalue,
		|	ЕСТЬNULL(ПроцентыПоДепозитам.СуммаПроцентов, 0) КАК ПроцентыПоДепозиту,
		|	ЕСТЬNULL(ПроцентыПоДепозитам.СуммаПроцентов, 0) + ОстаткиДепозитов.currentvalue КАК marketvalue,
		|	ЕСТЬNULL(ДействующиеАлгоритмы.Алгоритм, 0) КАК Алгоритм,
		|	ДействующиеАлгоритмы.Период КАК datestart,
		|	ПервоначальныеСуммы.initialvalue,
		|	ОстаткиДепозитов.interest,
		|	ЕСТЬNULL(ПроцентыЗаДень.СуммаПроцентов, 0) КАК day_interest,
		|	ОстаткиДепозитов.datematurity
		|ИЗ
		|	ОстаткиДепозитов КАК ОстаткиДепозитов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПроцентыПоДепозитам КАК ПроцентыПоДепозитам
		|		ПО ОстаткиДепозитов.БанковскийСчет = ПроцентыПоДепозитам.БанковскийСчет
		|			И ОстаткиДепозитов.currency = ПроцентыПоДепозитам.currency
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АлгоритмыРасчетаПроцентов.СрезПоследних(&ДатаЗапроса, ) КАК ДействующиеАлгоритмы
		|		ПО ОстаткиДепозитов.БанковскийСчет = ДействующиеАлгоритмы.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПервоначальныеСуммы КАК ПервоначальныеСуммы
		|		ПО ОстаткиДепозитов.БанковскийСчет = ПервоначальныеСуммы.БанковскийСчет
		|			И ОстаткиДепозитов.currency = ПервоначальныеСуммы.currency
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПроцентыЗаДень КАК ПроцентыЗаДень
		|		ПО ОстаткиДепозитов.БанковскийСчет = ПроцентыЗаДень.БанковскийСчет
		|			И ОстаткиДепозитов.currency = ПроцентыЗаДень.currency";
	
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ТаблицаДепозитов = ПустаяТаблицаДепозитов();

	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаДепозитов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		
		НачальныйНоминал 	= 0;
		ДатаВозврата		= '00010101';
		ПроцентнаяСтавка	= 0;
		
		НоваяСтрока.id 				= Выборка.БанковскийСчет.УникальныйИдентификатор();
		НоваяСтрока.source 			= ИмяБазы;
		
		НоваяСтрока.name			= "Депозит_" + Выборка.Банк + "_" + Выборка.initialvalue + "_" + Формат(НоваяСтрока.datestart,"ДФ=dd.MM.yyyy") + "_"+Выборка.НомерСчета; 
		
	Конеццикла;
	
	Возврат ТаблицаДепозитов;
	
КонецФункции
