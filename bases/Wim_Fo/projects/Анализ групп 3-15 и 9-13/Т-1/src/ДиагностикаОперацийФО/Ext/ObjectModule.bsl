// Диагностика ключевых операций ФО (строки 3, 9, 13 и 15 списка ключевых операций) на копии Т-1.
// Только чтение: обработка не записывает данные базы. Результат - текст лога с агрегатами, временем запросов
// и настройками обработок (пароли, логины, адреса и списки рассылки скрыты).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Собирает лог диагностики.
//
// Параметры:
//  ДнейИстории - Число - глубина истории в днях
//  ЗамеритьСервисыДепозитов - Булево - вызвать getDeposits сервисов ДУ и ПИФ по адресам из настроек обработки
//                             загрузки депозитов и замерить время (данные не меняются, но запрос идет во внешние базы)
//
// Возвращаемое значение:
//  Строка - текст лога
//
Функция СобратьЛог(ДнейИстории, ЗамеритьСервисыДепозитов = Ложь) Экспорт

	Лог = Новый Массив;
	НачалоСбора = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Начало = НачалоДня(ТекущаяДатаСеанса()) - ДнейИстории * 86400;

	// Привилегированный режим нужен, чтобы ограничения доступа не скрыли строки агрегатов; в безопасном режиме
	// он недоступен, тогда запросы идут с правами пользователя.
	Попытка
		УстановитьПривилегированныйРежим(Истина);
	Исключение
		Лог.Добавить("Привилегированный режим не установлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ДобавитьРаздел(Лог, "0. Общие сведения");
	Попытка
		РазделОбщиеСведения(Лог, ДнейИстории, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "1. Замеры времени ключевых операций (регистр ЗамерыВремени)");
	Попытка
		РазделЗамеры(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "2. Регламентное задание и дополнительные обработки");
	Попытка
		РазделЗаданияИОбработки(Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "3. Строка 3. Установка лимитов (распространение правил)");
	Попытка
		РазделУстановкаЛимитов(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "4. Строка 15. Исполнение сделок");
	Попытка
		РазделИсполнениеСделок(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "5. Строка 9. Загрузка депозитов и пересчет РСА");
	Попытка
		РазделДепозиты(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;
	Попытка
		РазделПересчетРСА(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;
	Если ЗамеритьСервисыДепозитов Тогда
		Попытка
			ЗамерСервисовДепозитов(Лог);
		Исключение
			ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		КонецПопытки;
	Иначе
		Лог.Добавить("");
		Лог.Добавить("--- 5.11. Замер сервисов ДУ и ПИФ не выполнялся (флажок на форме выключен)");
	КонецЕсли;

	ДобавитьРаздел(Лог, "6. Строка 13. Загрузка неторговых поручений РОСТ");
	Попытка
		РазделНеторговыеПоручения(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "7. Журнал регистрации этой базы (на Т-1 - события самой Т-1, не ПРОД)");
	Попытка
		РазделЖурналРегистрации(Лог, ДнейИстории);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	Лог.Добавить("");
	Лог.Добавить("Сбор завершен за " + ФорматЧисла(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСбора) + " мс");

	УстановитьПривилегированныйРежим(Ложь);

	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Разделы

// Выводит дату сбора, конфигурацию, базу, расширения, константы замеров и классов лимитов,
// опцию версионирования объектов.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  ДнейИстории - Число - глубина истории в днях
//  Начало - Дата - начало периода
//
Процедура РазделОбщиеСведения(Лог, ДнейИстории, Начало)

	Лог.Добавить("Версия диагностики: 2 (28.10.2026)");
	Лог.Добавить("Дата сбора: " + ЗначениеСтрокой(ТекущаяДатаСеанса()));
	Лог.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);
	Лог.Добавить("База: " + ИмяБазы());
	Лог.Добавить("Глубина истории: " + ФорматЧисла(ДнейИстории) + " дн., с " + ЗначениеСтрокой(Начало));
	Лог.Добавить("Расширения конфигурации:");
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Лог.Добавить(СтрШаблон("  %1 %2; активно: %3; безопасный режим: %4", Расширение.Имя, Расширение.Версия,
			ЗначениеСтрокой(Расширение.Активно), Строка(Расширение.БезопасныйРежим)));
	КонецЦикла;

	Лог.Добавить("Константы и опции:");
	Для Каждого ИмяКонстанты Из СтрРазделить("ВыполнятьЗамерыПроизводительности,ПериодХраненияЗамеров,ИспользоватьКлассыЛимитов", ",") Цикл
		Попытка
			Лог.Добавить("  Константа " + ИмяКонстанты + " = " + ЗначениеСтрокой(Константы[ИмяКонстанты].Получить()));
		Исключение
			ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;
	Попытка
		Лог.Добавить("  Функциональная опция ИспользоватьВерсионированиеОбъектов = "
			+ ЗначениеСтрокой(ПолучитьФункциональнуюОпцию("ИспользоватьВерсионированиеОбъектов")));
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Журнал регистрации: события обработок строк 3, 9, 13, 15 и ошибки с ключевыми словами этих операций.
// Требует права ЖурналРегистрации; выгрузка ограничена 20000 событий.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  ДнейИстории - Число - глубина в днях
//
Процедура РазделЖурналРегистрации(Лог, ДнейИстории)

	События = Новый Массив;
	События.Добавить("Аванкор. Исполнение сделок");
	События.Добавить("РаспространениеПравил");
	События.Добавить("УдалениеБлокировок");
	События.Добавить("ФоновоеЗадание.ВыполнитьПерерасчет");
	События.Добавить("Регламентное задание: Рассылка поручений");

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", НачалоДня(ТекущаяДатаСеанса()) - ДнейИстории * 86400);
	Отбор.Вставить("Событие", События);
	ТаблицаСобытий = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(ТаблицаСобытий, Отбор, "Дата,Событие,Уровень,Комментарий", , 20000);
	Лог.Добавить("");
	Лог.Добавить("--- 7.1. События операций по дням (" + ФорматЧисла(ТаблицаСобытий.Количество()) + " событий)");
	ВывестиСводкуСобытий(Лог, ТаблицаСобытий);

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", НачалоДня(ТекущаяДатаСеанса()) - Мин(ДнейИстории, 7) * 86400);
	Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(ТаблицаОшибок, Отбор, "Дата,Событие,Уровень,Комментарий", , 20000);
	КлючевыеСлова = СтрРазделить("депозит,распространен,неторгов,исполнение сделок,исполнениепосделке,перерасчет", ",");
	Отобранные = ТаблицаОшибок.СкопироватьКолонки();
	Для Каждого СтрокаСобытия Из ТаблицаОшибок Цикл
		Текст = НРег(Строка(СтрокаСобытия.Событие) + " " + Строка(СтрокаСобытия.Комментарий));
		Для Каждого Слово Из КлючевыеСлова Цикл
			Если СтрНайти(Текст, Слово) > 0 Тогда
				ЗаполнитьЗначенияСвойств(Отобранные.Добавить(), СтрокаСобытия);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Лог.Добавить("");
	Лог.Добавить(СтрШаблон("--- 7.2. Ошибки за %1 дн. с ключевыми словами операций: %2 из %3 ошибок",
		Мин(ДнейИстории, 7), ФорматЧисла(Отобранные.Количество()), ФорматЧисла(ТаблицаОшибок.Количество())));
	ВывестиСводкуСобытий(Лог, Отобранные);
	Отобранные.Сортировать("Дата Убыв");
	Номер = 0;
	Для Каждого СтрокаСобытия Из Отобранные Цикл
		Номер = Номер + 1;
		Если Номер > 20 Тогда
			Прервать;
		КонецЕсли;
		Лог.Добавить(СтрШаблон("%1 | %2 | %3", ЗначениеСтрокой(СтрокаСобытия.Дата), СтрокаСобытия.Событие,
			СтрЗаменить(Лев(СтрокаСобытия.Комментарий, 300), Символы.ПС, " ")));
	КонецЦикла;

КонецПроцедуры

// Выводит число событий журнала по дню, событию и уровню.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  ТаблицаСобытий - ТаблицаЗначений - выгрузка журнала с колонками Дата, Событие, Уровень
//
Процедура ВывестиСводкуСобытий(Лог, ТаблицаСобытий)

	Сводка = Новый ТаблицаЗначений;
	Сводка.Колонки.Добавить("День");
	Сводка.Колонки.Добавить("Событие");
	Сводка.Колонки.Добавить("Уровень");
	Сводка.Колонки.Добавить("Событий");
	Для Каждого СтрокаСобытия Из ТаблицаСобытий Цикл
		НоваяСтрока = Сводка.Добавить();
		НоваяСтрока.День    = НачалоДня(СтрокаСобытия.Дата);
		НоваяСтрока.Событие = Строка(СтрокаСобытия.Событие);
		НоваяСтрока.Уровень = Строка(СтрокаСобытия.Уровень);
		НоваяСтрока.Событий = 1;
	КонецЦикла;
	Сводка.Свернуть("День, Событие, Уровень", "Событий");
	Сводка.Сортировать("День Убыв, Событие");
	ВывестиТаблицу(Лог, Сводка, 200);

КонецПроцедуры

// Временные XLS-файлы в каталоге временных файлов сервера: обработка распространения правил оставляет их после
// каждого письма. Файлы не удаляются, выводятся только число, объем и даты.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура ВывестиВременныеФайлы(Лог)

	Каталог = КаталогВременныхФайлов();
	Файлы = НайтиФайлы(Каталог, "*.xls", Ложь);
	Объем = 0;
	Старейший = Неопределено;
	Новейший = Неопределено;
	Для Каждого Файл Из Файлы Цикл
		Объем = Объем + Файл.Размер();
		Изменен = Файл.ПолучитьВремяИзменения();
		Если Старейший = Неопределено Или Изменен < Старейший Тогда
			Старейший = Изменен;
		КонецЕсли;
		Если Новейший = Неопределено Или Изменен > Новейший Тогда
			Новейший = Изменен;
		КонецЕсли;
	КонецЦикла;
	Лог.Добавить("");
	Лог.Добавить("--- 3.6. Файлы *.xls в каталоге временных файлов сервера 1С (этого рабочего процесса)");
	Лог.Добавить(СтрШаблон("Файлов: %1; объем: %2 КБ; самый старый: %3; самый новый: %4", ФорматЧисла(Файлы.Количество()),
		ФорматЧисла(Окр(Объем / 1024)), ЗначениеСтрокой(Старейший), ЗначениеСтрокой(Новейший)));

КонецПроцедуры

// Выводит итоги регистра ЗамерыВремени по ключам строк 3, 9, 13, 15: за период, по дням и самые
// долгие запуски.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделЗамеры(Лог, Начало)

	Параметры = Новый Структура("Начало", Начало);
	ОтборКлючей =
	"	И (Зам.КлючеваяОперация.Имя ПОДОБНО ""ЗагрузкаДепозитов%""
	|			ИЛИ Зам.КлючеваяОперация.Имя ПОДОБНО ""РаспространениеПравилЛимитов%""
	|			ИЛИ Зам.КлючеваяОперация.Имя ПОДОБНО ""ЗагрузкаНеторговыхПорученийРОСТ%""
	|			ИЛИ Зам.КлючеваяОперация.Имя ПОДОБНО ""ИсполнениеСделок%"")";

	ВывестиЗапрос(Лог, "1.1. Итоги по ключам за период (секунды)",
	"ВЫБРАТЬ
	|	Зам.КлючеваяОперация.Имя КАК Ключ,
	|	КОЛИЧЕСТВО(*) КАК Замеров,
	|	СУММА(Зам.ВремяВыполнения) КАК СуммаСек,
	|	СРЕДНЕЕ(Зам.ВремяВыполнения) КАК СреднееСек,
	|	МАКСИМУМ(Зам.ВремяВыполнения) КАК МаксСек,
	|	СУММА(Зам.ВесЗамера) КАК СуммаВеса,
	|	СУММА(ВЫБОР
	|			КОГДА Зам.ВыполненСОшибкой
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СОшибкой,
	|	МИНИМУМ(Зам.ДатаЗаписиЛокальная) КАК Первый,
	|	МАКСИМУМ(Зам.ДатаЗаписиЛокальная) КАК Последний
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Зам
	|ГДЕ
	|	Зам.ДатаЗаписиНачалоЧаса >= &Начало
	|" + ОтборКлючей + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Зам.КлючеваяОперация.Имя
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ключ", Параметры);

	ВывестиЗапрос(Лог, "1.2. По ключам и дням",
	"ВЫБРАТЬ
	|	Зам.КлючеваяОперация.Имя КАК Ключ,
	|	НАЧАЛОПЕРИОДА(Зам.ДатаЗаписиЛокальная, ДЕНЬ) КАК День,
	|	КОЛИЧЕСТВО(*) КАК Замеров,
	|	СУММА(Зам.ВремяВыполнения) КАК СуммаСек,
	|	МАКСИМУМ(Зам.ВремяВыполнения) КАК МаксСек,
	|	СУММА(Зам.ВесЗамера) КАК СуммаВеса
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Зам
	|ГДЕ
	|	Зам.ДатаЗаписиНачалоЧаса >= &Начало
	|" + ОтборКлючей + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Зам.КлючеваяОперация.Имя,
	|	НАЧАЛОПЕРИОДА(Зам.ДатаЗаписиЛокальная, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ключ,
	|	День", Параметры, 600);

	ВывестиЗапрос(Лог, "1.3. Самые долгие запуски операций (общие ключи)",
	"ВЫБРАТЬ ПЕРВЫЕ 40
	|	Зам.КлючеваяОперация.Имя КАК Ключ,
	|	Зам.ДатаЗаписиЛокальная КАК Записан,
	|	Зам.ВремяВыполнения КАК Сек,
	|	Зам.ВесЗамера КАК Вес,
	|	ПОДСТРОКА(Зам.Комментарий, 1, 300) КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Зам
	|ГДЕ
	|	Зам.ДатаЗаписиНачалоЧаса >= &Начало
	|	И Зам.КлючеваяОперация.Имя В (""ЗагрузкаДепозитов"", ""РаспространениеПравилЛимитов"", ""ЗагрузкаНеторговыхПорученийРОСТ"", ""ИсполнениеСделок"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ", Параметры);

КонецПроцедуры

// Выводит состояние регламентного задания исполнения сделок, константу ОперацииПослеОбмена
// и по каждой дополнительной обработке строк - версию, команды с регламентными заданиями
// и настройки (секретные скрыты).
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура РазделЗаданияИОбработки(Лог)

	Лог.Добавить("Регламентное задание АванкорИсполнениеСделок (на Т-1 расписание может быть отключено после восстановления копии):");
	Попытка
		Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.АванкорИсполнениеСделок);
		Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор) Цикл
			ВывестиЗадание(Лог, "  ", Задание);
		КонецЦикла;
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		Лог.Добавить("Константа ОперацииПослеОбмена: " + ЗначениеСтрокой(Константы.ОперацииПослеОбмена.Получить()));
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		ВывестиВключенныеЗадания(Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Обр.Ссылка КАК Ссылка,
	|	Обр.Наименование КАК Наименование,
	|	Обр.ИмяОбъекта КАК ИмяОбъекта,
	|	Обр.Версия КАК Версия,
	|	Обр.Публикация КАК Публикация,
	|	Обр.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обр
	|ГДЕ
	|	Обр.ИмяОбъекта В (&Имена)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИмяОбъекта,
	|	Версия");
	Запрос.УстановитьПараметр("Имена", ИменаОбработок());
	Выборка = Запрос.Выполнить().Выбрать();
	НеНайдены = ИменаОбработок();
	Пока Выборка.Следующий() Цикл
		Индекс = НеНайдены.Найти(Выборка.ИмяОбъекта);
		Если Индекс <> Неопределено Тогда
			НеНайдены.Удалить(Индекс);
		КонецЕсли;
		Лог.Добавить("");
		Лог.Добавить(СтрШаблон("Обработка %1 (%2), версия %3, публикация: %4, пометка удаления: %5",
			Выборка.ИмяОбъекта, Выборка.Наименование, Выборка.Версия, ЗначениеСтрокой(Выборка.Публикация),
			ЗначениеСтрокой(Выборка.ПометкаУдаления)));
		Попытка
			ВывестиКомандыОбработки(Лог, Выборка.Ссылка);
		Исключение
			ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		КонецПопытки;
		Попытка
			ВывестиНастройки(Лог, Выборка.Ссылка);
		Исключение
			ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;
	// Неторговая обработка РОСТ при загрузке через DevOps переименовывается: достаточно одного из двух имен.
	ИмяСПрефиксом = НеНайдены.Найти("внЗагрузкаНеторговыхПорученийРОСТ");
	ИмяБезПрефикса = НеНайдены.Найти("ЗагрузкаНеторговыхПорученийРОСТ");
	Если ИмяСПрефиксом = Неопределено Или ИмяБезПрефикса = Неопределено Тогда
		Индекс = НеНайдены.Найти("внЗагрузкаНеторговыхПорученийРОСТ");
		Если Индекс <> Неопределено Тогда
			НеНайдены.Удалить(Индекс);
		КонецЕсли;
		Индекс = НеНайдены.Найти("ЗагрузкаНеторговыхПорученийРОСТ");
		Если Индекс <> Неопределено Тогда
			НеНайдены.Удалить(Индекс);
		КонецЕсли;
	КонецЕсли;

	Лог.Добавить("");
	Если ЗначениеЗаполнено(НеНайдены) Тогда
		Лог.Добавить("Не найдены в справочнике дополнительных обработок (по имени объекта): "
			+ СтрСоединить(НеНайдены, ", "));
	Иначе
		Лог.Добавить("Все обработки строк найдены в справочнике дополнительных обработок");
	КонецЕсли;

КонецПроцедуры

// Выводит объем установок лимитов по портфелю, число лимитов в документах, записи порогов,
// версии лимитов и временные XLS-файлы сервера.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделУстановкаЛимитов(Лог, Начало)

	Параметры = Новый Структура("Начало", Начало);

	ВывестиЗапрос(Лог, "3.1. Документы УстановкаЛимитов по портфелю: по дням и классам",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Уст.Дата, ДЕНЬ) КАК День,
	|	Уст.КлассЛимита КАК КлассЛимита,
	|	КОЛИЧЕСТВО(*) КАК Документов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Уст.ОбъектНазначения) КАК Портфелей,
	|	СУММА(ВЫБОР
	|			КОГДА Уст.Проведен
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК НеПроведено
	|ИЗ
	|	Документ.УстановкаЛимитов КАК Уст
	|ГДЕ
	|	Уст.Дата >= &Начало
	|	И Уст.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЛимитов.ПоПортфелю)
	|	И НЕ Уст.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Уст.Дата, ДЕНЬ),
	|	Уст.КлассЛимита
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ", Параметры, 200);

	ВывестиЗапрос(Лог, "3.2. Число лимитов в документах УстановкаЛимитов по портфелю, по дням",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) КАК День,
	|	КОЛИЧЕСТВО(*) КАК Документов,
	|	СРЕДНЕЕ(Док.Лимитов) КАК ЛимитовСреднее,
	|	МАКСИМУМ(Док.Лимитов) КАК ЛимитовМакс
	|ИЗ
	|	(ВЫБРАТЬ
	|		Лим.Ссылка КАК Ссылка,
	|		Лим.Ссылка.Дата КАК Дата,
	|		КОЛИЧЕСТВО(*) КАК Лимитов
	|	ИЗ
	|		Документ.УстановкаЛимитов.Лимиты КАК Лим
	|	ГДЕ
	|		Лим.Ссылка.Дата >= &Начало
	|		И Лим.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЛимитов.ПоПортфелю)
	|		И НЕ Лим.Ссылка.ПометкаУдаления
	|
	|	СГРУППИРОВАТЬ ПО
	|		Лим.Ссылка,
	|		Лим.Ссылка.Дата) КАК Док
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ", Параметры);

	ВывестиЗапрос(Лог, "3.3. Документы УстановкаЛимитов по портфелю: по часам суток за период",
	"ВЫБРАТЬ
	|	ЧАС(Уст.Дата) КАК Час,
	|	КОЛИЧЕСТВО(*) КАК Документов
	|ИЗ
	|	Документ.УстановкаЛимитов КАК Уст
	|ГДЕ
	|	Уст.Дата >= &Начало
	|	И Уст.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЛимитов.ПоПортфелю)
	|	И НЕ Уст.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	ЧАС(Уст.Дата)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Час", Параметры);

	ВывестиЗапрос(Лог, "3.4. Записи ПорогиЛимитов по дням",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Пор.Период, ДЕНЬ) КАК День,
	|	КОЛИЧЕСТВО(*) КАК Порогов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Пор.Портфель) КАК Портфелей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Пор.Лимит) КАК Лимитов
	|ИЗ
	|	РегистрСведений.ПорогиЛимитов КАК Пор
	|ГДЕ
	|	Пор.Период >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Пор.Период, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ", Параметры);

	ВывестиЗапрос(Лог, "3.5. Версии элементов справочника Лимиты по дням (запись версий после распространения)",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Вер.ДатаВерсии, ДЕНЬ) КАК День,
	|	КОЛИЧЕСТВО(*) КАК Версий,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Вер.Объект) КАК Лимитов
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК Вер
	|ГДЕ
	|	Вер.Объект ССЫЛКА Справочник.Лимиты
	|	И Вер.ДатаВерсии >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Вер.ДатаВерсии, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ", Параметры);

	Попытка
		ВывестиВременныеФайлы(Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Выводит документы исполнения по дням и часам, объем сделок по дате поставки, неисполненные
// остатки и время запроса заполнения таблицы сделок за сегодня и вчера.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделИсполнениеСделок(Лог, Начало)

	Параметры = Новый Структура("Начало", Начало);

	ВывестиЗапрос(Лог, "4.1. Документы ИсполнениеПоСделке по дням и часам (при регламентном запуске время документа = время старта)",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Исп.Дата, ДЕНЬ) КАК День,
	|	ЧАС(Исп.Дата) КАК Час,
	|	КОЛИЧЕСТВО(*) КАК Документов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Сделка) КАК Сделок,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Портфель) КАК Портфелей
	|ИЗ
	|	Документ.ИсполнениеПоСделке КАК Исп
	|ГДЕ
	|	Исп.Дата >= &Начало
	|	И Исп.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Исп.Дата, ДЕНЬ),
	|	ЧАС(Исп.Дата)
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ,
	|	Час", Параметры, 300);

	ВывестиЗапрос(Лог, "4.2. Сделки по дате поставки (объем исполнения)",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Сд.ДатаПоставки, ДЕНЬ) КАК ДатаПоставки,
	|	КОЛИЧЕСТВО(*) КАК Сделок,
	|	СУММА(ВЫБОР
	|			КОГДА Сд.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.ВалютныйРынок)
	|					ИЛИ НЕ Сд.Внебиржевая
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК БиржевыхИВалютных
	|ИЗ
	|	Документ.Сделка КАК Сд
	|ГДЕ
	|	Сд.ДатаПоставки >= &Начало
	|	И Сд.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Сд.ДатаПоставки, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПоставки УБЫВ", Параметры);

	ПараметрыОстатков = Новый Структура("Начало, НаДату", Начало, ТекущаяДатаСеанса());
	ВывестиЗапрос(Лог, "4.3. Неисполненные остатки плановой позиции по сделкам с прошедшей датой поставки",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(Ост.Сделка КАК Документ.Сделка).ДатаПоставки, ДЕНЬ) КАК ДатаПоставки,
	|	ВЫРАЗИТЬ(Ост.Сделка КАК Документ.Сделка).Внебиржевая КАК Внебиржевая,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ост.Сделка) КАК Сделок,
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ост.Портфель) КАК Портфелей
	|ИЗ
	|	РегистрНакопления.ПлановаяПозиция.Остатки(&НаДату, Сделка ССЫЛКА Документ.Сделка) КАК Ост
	|ГДЕ
	|	ВЫРАЗИТЬ(Ост.Сделка КАК Документ.Сделка).ДатаПоставки >= &Начало
	|	И ВЫРАЗИТЬ(Ост.Сделка КАК Документ.Сделка).ДатаПоставки < НАЧАЛОПЕРИОДА(&НаДату, ДЕНЬ)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(Ост.Сделка КАК Документ.Сделка).ДатаПоставки, ДЕНЬ),
	|	ВЫРАЗИТЬ(Ост.Сделка КАК Документ.Сделка).Внебиржевая
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПоставки УБЫВ", ПараметрыОстатков);

	// Тот же запрос, что ГрупповоеИсполнениеСделок.ЗаполнитьТаблицуСделок без отбора по портфелям: время и объем.
	ТекстЗаполнения =
	"ВЫБРАТЬ
	|	Ост.Портфель КАК Портфель,
	|	Ост.Актив КАК Актив,
	|	Ост.МестоХранения КАК МестоХранения,
	|	Ост.Сделка КАК Сделка,
	|	Ост.Субпортфель КАК Субпортфель,
	|	Ост.ТипПортфеля КАК ТипПортфеля,
	|	Ост.КоличествоОстаток КАК Количество,
	|	Ост.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.ПлановаяПозиция.Остатки(&ДатаОстатков, ) КАК Ост
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Остатки.Сделка) КАК Сделок,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Остатки.Портфель) КАК Портфелей
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделки
	|		ПО ВТ_Остатки.Сделка = Сделки.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
	|		ПО ВТ_Остатки.Актив = Активы.Ссылка
	|ГДЕ
	|	Сделки.ДатаПоставки = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	|	И (Сделки.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.ВалютныйРынок)
	|			ИЛИ НЕ Сделки.Внебиржевая
	|				И НЕ ЕСТЬNULL(Сделки.Поручение.Биржа.Внебиржевая, ЛОЖЬ))";
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Для Сдвиг = 0 По 1 Цикл
		ДатаИсполнения = Сегодня - Сдвиг * 86400;
		ВывестиЗапрос(Лог, "4.4. Запрос заполнения таблицы сделок (как в 23:55) на " + Формат(ДатаИсполнения, "ДФ=dd.MM.yyyy"),
			ТекстЗаполнения, Новый Структура("Дата, ДатаОстатков", ДатаИсполнения, КонецДня(ДатаИсполнения)));
	КонецЦикла;

	ВывестиЗапрос(Лог, "4.3а. Неисполненные остатки: сделки (до 20)",
	"ВЫБРАТЬ
	|	Ост.Сделка КАК Сделка,
	|	Ост.Актив КАК Актив,
	|	Ост.КоличествоОстаток КАК Остаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.ПлановаяПозиция.Остатки(&НаДату, Сделка ССЫЛКА Документ.Сделка) КАК Ост
	|ГДЕ
	|	ВЫРАЗИТЬ(Ост.Сделка КАК Документ.Сделка).ДатаПоставки >= &Начало
	|	И ВЫРАЗИТЬ(Ост.Сделка КАК Документ.Сделка).ДатаПоставки < НАЧАЛОПЕРИОДА(&НаДату, ДЕНЬ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Сделка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 20
	|	ВТ_Остатки.Сделка КАК Сделка,
	|	ВЫРАЗИТЬ(ВТ_Остатки.Сделка КАК Документ.Сделка).ДатаПоставки КАК ДатаПоставки,
	|	ВЫРАЗИТЬ(ВТ_Остатки.Сделка КАК Документ.Сделка).ВидОперации КАК ВидОперации,
	|	ВЫРАЗИТЬ(ВТ_Остатки.Сделка КАК Документ.Сделка).Проведен КАК СделкаПроведена,
	|	ВТ_Остатки.Актив КАК Актив,
	|	ВТ_Остатки.Остаток КАК Остаток,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Исп.Ссылка) КАК ДокументовИсполнения
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеПоСделке КАК Исп
	|		ПО ВТ_Остатки.Сделка = Исп.Сделка
	|			И (Исп.Проведен)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Остатки.Сделка,
	|	ВЫРАЗИТЬ(ВТ_Остатки.Сделка КАК Документ.Сделка).ДатаПоставки,
	|	ВЫРАЗИТЬ(ВТ_Остатки.Сделка КАК Документ.Сделка).ВидОперации,
	|	ВЫРАЗИТЬ(ВТ_Остатки.Сделка КАК Документ.Сделка).Проведен,
	|	ВТ_Остатки.Актив,
	|	ВТ_Остатки.Остаток
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПоставки", ПараметрыОстатков);

	// Документы исполнения датируются временем старта, поэтому длительность ночного исполнения оценивается по времени
	// последнего обновления расширений и статусов поручений сделок: проведение документа обновляет их сразу.
	// Более поздние изменения поручения затирают ночное время, такие поручения в оценку не попадают.
	ТекстНочи =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НАЧАЛОПЕРИОДА(Исп.Дата, ДЕНЬ) КАК День,
	|	Исп.Дата КАК ДатаДокумента,
	|	Исп.Сделка.Поручение КАК Поручение
	|ПОМЕСТИТЬ ВТ_ПорученияНочи
	|ИЗ
	|	Документ.ИсполнениеПоСделке КАК Исп
	|ГДЕ
	|	Исп.Дата >= &Начало
	|	И Исп.Проведен
	|	И Исп.Сделка.Поручение <> ЗНАЧЕНИЕ(Документ.Поручение.ПустаяСсылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Поручение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ночь.День КАК День,
	|	Ночь.ДатаДокумента КАК ДатаДокумента,
	|	Ночь.Поручение КАК Поручение,
	|	ВЫБОР
	|		КОГДА Расш.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(Ночь.ДатаДокумента, МИНУТА, -15) И ДОБАВИТЬКДАТЕ(Ночь.ДатаДокумента, ЧАС, 8)
	|			ТОГДА Расш.Дата
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ДатаРасширения,
	|	ВЫБОР
	|		КОГДА Ст.ДатаСтатуса МЕЖДУ ДОБАВИТЬКДАТЕ(Ночь.ДатаДокумента, МИНУТА, -15) И ДОБАВИТЬКДАТЕ(Ночь.ДатаДокумента, ЧАС, 8)
	|			ТОГДА Ст.ДатаСтатуса
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ДатаСтатуса
	|ПОМЕСТИТЬ ВТ_ВремяНочи
	|ИЗ
	|	ВТ_ПорученияНочи КАК Ночь
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасширенияПоручений КАК Расш
	|		ПО Ночь.Поручение = Расш.Поручение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПоручений КАК Ст
	|		ПО Ночь.Поручение = Ст.Поручение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";

	ВывестиЗапрос(Лог, "4.5. Оценка длительности ночного исполнения по времени обновления поручений сделок",
	ТекстНочи +
	"ВЫБРАТЬ
	|	Время.День КАК День,
	|	МИНИМУМ(Время.ДатаДокумента) КАК ДатаДокументов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Время.Поручение) КАК Поручений,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА НЕ Время.ДатаРасширения ЕСТЬ NULL
	|				ТОГДА Время.Поручение
	|		КОНЕЦ) КАК ОбновленоНочью,
	|	МИНИМУМ(Время.ДатаРасширения) КАК РасширениеПервое,
	|	МАКСИМУМ(Время.ДатаРасширения) КАК РасширениеПоследнее,
	|	РАЗНОСТЬДАТ(МИНИМУМ(Время.ДатаДокумента), МАКСИМУМ(Время.ДатаРасширения), МИНУТА) КАК МинутПоРасширениям,
	|	МАКСИМУМ(Время.ДатаСтатуса) КАК СтатусПоследний,
	|	РАЗНОСТЬДАТ(МИНИМУМ(Время.ДатаДокумента), МАКСИМУМ(Время.ДатаСтатуса), МИНУТА) КАК МинутПоСтатусам
	|ИЗ
	|	ВТ_ВремяНочи КАК Время
	|
	|СГРУППИРОВАТЬ ПО
	|	Время.День
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ", Новый Структура("Начало", Начало));

	ВывестиЗапрос(Лог, "4.6. Ход ночного исполнения за 3 последних ночи: поручения по часу обновления расширения",
	ТекстНочи +
	"ВЫБРАТЬ
	|	Время.День КАК День,
	|	НАЧАЛОПЕРИОДА(Время.ДатаРасширения, ЧАС) КАК Час,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Время.Поручение) КАК Поручений
	|ИЗ
	|	ВТ_ВремяНочи КАК Время
	|ГДЕ
	|	НЕ Время.ДатаРасширения ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	Время.День,
	|	НАЧАЛОПЕРИОДА(Время.ДатаРасширения, ЧАС)
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ,
	|	Час", Новый Структура("Начало", НачалоДня(ТекущаяДатаСеанса()) - 3 * 86400));

КонецПроцедуры

// Выводит регистр депозитов ФО, данные для сопоставления депозитов, время запросов сопоставления,
// запуски пересчета РСА и портфели с признаком перерасчета.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделДепозиты(Лог, Начало)

	Параметры = Новый Структура("Начало", Начало);

	ВывестиЗапрос(Лог, "5.1. Регистр ВТБ_ФактическаяПозицияДепозитов по датам",
	"ВЫБРАТЬ
	|	Деп.Дата КАК Дата,
	|	КОЛИЧЕСТВО(*) КАК Записей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Деп.Портфель) КАК Портфелей,
	|	СУММА(Деп.Стоимость) КАК Стоимость
	|ИЗ
	|	РегистрСведений.ВТБ_ФактическаяПозицияДепозитов КАК Деп
	|ГДЕ
	|	Деп.Дата >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	Деп.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ", Параметры);

	ВывестиЗапрос(Лог, "5.2. Регистр ВТБ_ФактическаяПозицияДепозитов за все время (есть ли депозиты в базе вообще)",
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Записей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Деп.Портфель) КАК Портфелей,
	|	МИНИМУМ(Деп.Дата) КАК ПерваяДата,
	|	МАКСИМУМ(Деп.Дата) КАК ПоследняяДата
	|ИЗ
	|	РегистрСведений.ВТБ_ФактическаяПозицияДепозитов КАК Деп", Новый Структура);

	СвойствоИД = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("ИдентификаторДепозита");
	Лог.Добавить("");
	Лог.Добавить("Свойство ИдентификаторДепозита найдено: " + ЗначениеСтрокой(ЗначениеЗаполнено(СвойствоИД)));

	ВывестиЗапрос(Лог, "5.3. Места хранения с идентификатором депозита (сопоставление ДУ и ПИФ)",
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДопСв.Объект) КАК МестХранения,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Суб.Ссылка) КАК Субпортфелей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Суб.Портфель) КАК Портфелей
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДопСв
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Субпортфели КАК Суб
	|		ПО ДопСв.Объект = Суб.МестоХранения
	|			И (НЕ Суб.ПометкаУдаления)
	|ГДЕ
	|	ДопСв.Объект ССЫЛКА Справочник.МестаХранения
	|	И ДопСв.Свойство = &Свойство", Новый Структура("Свойство", СвойствоИД));

	ВывестиЗапрос(Лог, "5.4. Субпортфели с кодом счета вида ""-D...-"" (сопоставление Calipso)",
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Субпортфелей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Суб.Портфель) КАК Портфелей
	|ИЗ
	|	Справочник.Субпортфели КАК Суб
	|ГДЕ
	|	НЕ Суб.ПометкаУдаления
	|	И Суб.КодСчета ПОДОБНО ""%-D%-%""", Новый Структура);

	ЗамерыСопоставления(Лог, СвойствоИД);

	ВывестиЗапрос(Лог, "5.5. Запуски пересчета РСА (регистр ВТБ_ЛогиПересчетов): начало, конец, портфели",
	"ВЫБРАТЬ ПЕРВЫЕ 400
	|	МИНИМУМ(Лог.ДатаПересчета) КАК Начало,
	|	МАКСИМУМ(Лог.ДатаПересчета) КАК Конец,
	|	РАЗНОСТЬДАТ(МИНИМУМ(Лог.ДатаПересчета), МАКСИМУМ(Лог.ДатаПересчета), СЕКУНДА) КАК Секунд,
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лог.Портфель) > 0
	|			ТОГДА РАЗНОСТЬДАТ(МИНИМУМ(Лог.ДатаПересчета), МАКСИМУМ(Лог.ДатаПересчета), СЕКУНДА) * 1000
	|				/ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лог.Портфель)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК МсНаПортфель,
	|	Лог.ПересчетПоВсемПортфелям КАК ПоВсемПортфелям,
	|	КОЛИЧЕСТВО(*) КАК Записей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лог.Портфель) КАК Портфелей,
	|	СУММА(ВЫБОР
	|			КОГДА Лог.НовоеРСА <> Лог.СтароеРСА
	|					ИЛИ Лог.НовоеСЧА <> Лог.СтароеСЧА
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ИзмененоРСА_СЧА,
	|	СУММА(ВЫБОР
	|			КОГДА Лог.ТекстОшибки <> """"
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СОшибкой
	|ИЗ
	|	РегистрСведений.ВТБ_ЛогиПересчетов КАК Лог
	|ГДЕ
	|	Лог.ДатаПересчета >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	Лог.ИдентификаторСеанса,
	|	Лог.ПересчетПоВсемПортфелям
	|
	|УПОРЯДОЧИТЬ ПО
	|	Начало УБЫВ", Параметры, 400);

	ВывестиЗапрос(Лог, "5.6. Частые тексты ошибок пересчета РСА",
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	ПОДСТРОКА(Лог.ТекстОшибки, 1, 150) КАК Ошибка,
	|	КОЛИЧЕСТВО(*) КАК Записей
	|ИЗ
	|	РегистрСведений.ВТБ_ЛогиПересчетов КАК Лог
	|ГДЕ
	|	Лог.ДатаПересчета >= &Начало
	|	И Лог.ТекстОшибки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	ПОДСТРОКА(Лог.ТекстОшибки, 1, 150)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Записей УБЫВ", Параметры);

	Признак = НастройкаОбработки("внПерерасчетСтоимостиФактическойПозицииИ_РСА_СЧА", "ПризнакДляПерерасчетаПортфеля");
	Лог.Добавить("");
	Лог.Добавить("Свойство ПризнакДляПерерасчетаПортфеля из настроек обработки пересчета: " + ЗначениеСтрокой(Признак));
	Если ЗначениеЗаполнено(Признак) Тогда
		ВывестиЗапрос(Лог, "5.7. Портфели с признаком перерасчета сейчас (их берет пересчет при пустом списке портфелей)",
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Записей,
		|	СУММА(ВЫБОР
		|			КОГДА ДопСв.Значение = ИСТИНА
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СПризнакомИстина
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДопСв
		|ГДЕ
		|	ДопСв.Объект ССЫЛКА Справочник.Портфели
		|	И ДопСв.Свойство = &Свойство", Новый Структура("Свойство", Признак));
	КонецЕсли;

КонецПроцедуры

// Выводит сводку запусков пересчета РСА по часу старта (будни и выходные отдельно), объем фактической позиции
// по датам и события сервиса обмена по часам - для поиска того, кто запускает пересчеты.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделПересчетРСА(Лог, Начало)

	ВывестиЗапрос(Лог, "5.8. Пересчеты РСА за период: по часу старта, будни и выходные отдельно",
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДЕНЬНЕДЕЛИ(Запуски.Начало) > 5
	|			ТОГДА ""выходной""
	|		ИНАЧЕ ""будний""
	|	КОНЕЦ КАК ТипДня,
	|	ЧАС(Запуски.Начало) КАК ЧасСтарта,
	|	Запуски.ПоВсемПортфелям КАК ПоВсемПортфелям,
	|	КОЛИЧЕСТВО(*) КАК Запусков,
	|	СРЕДНЕЕ(Запуски.Секунд) КАК СреднееСек,
	|	МАКСИМУМ(Запуски.Секунд) КАК МаксСек,
	|	СРЕДНЕЕ(Запуски.Портфелей) КАК СреднееПортфелей,
	|	СУММА(Запуски.Изменено) КАК ИзмененоВсего,
	|	СУММА(Запуски.СОшибкой) КАК СОшибкойВсего
	|ИЗ
	|	(ВЫБРАТЬ
	|		МИНИМУМ(Лог.ДатаПересчета) КАК Начало,
	|		РАЗНОСТЬДАТ(МИНИМУМ(Лог.ДатаПересчета), МАКСИМУМ(Лог.ДатаПересчета), СЕКУНДА) КАК Секунд,
	|		Лог.ПересчетПоВсемПортфелям КАК ПоВсемПортфелям,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лог.Портфель) КАК Портфелей,
	|		СУММА(ВЫБОР
	|				КОГДА Лог.НовоеРСА <> Лог.СтароеРСА
	|						ИЛИ Лог.НовоеСЧА <> Лог.СтароеСЧА
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК Изменено,
	|		СУММА(ВЫБОР
	|				КОГДА Лог.ТекстОшибки <> """"
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК СОшибкой
	|	ИЗ
	|		РегистрСведений.ВТБ_ЛогиПересчетов КАК Лог
	|	ГДЕ
	|		Лог.ДатаПересчета >= &Начало
	|
	|	СГРУППИРОВАТЬ ПО
	|		Лог.ИдентификаторСеанса,
	|		Лог.ПересчетПоВсемПортфелям) КАК Запуски
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ДЕНЬНЕДЕЛИ(Запуски.Начало) > 5
	|			ТОГДА ""выходной""
	|		ИНАЧЕ ""будний""
	|	КОНЕЦ,
	|	ЧАС(Запуски.Начало),
	|	Запуски.ПоВсемПортфелям
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипДня,
	|	ЧасСтарта", Новый Структура("Начало", Начало), 200);

	НачалоПозиции = НачалоДня(ТекущаяДатаСеанса()) - 14 * 86400;
	ВывестиЗапрос(Лог, "5.9. Фактическая позиция по датам за 14 дней (объем, который пересчитывает пересчет РСА)",
	"ВЫБРАТЬ
	|	Поз.Дата КАК ДатаПозиции,
	|	КОЛИЧЕСТВО(*) КАК Записей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Поз.Портфель) КАК Портфелей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Поз.Актив) КАК Активов
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК Поз
	|ГДЕ
	|	Поз.Дата >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	Поз.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПозиции УБЫВ", Новый Структура("Начало", НачалоПозиции));

	НачалоСобытий = НачалоДня(ТекущаяДатаСеанса()) - 3 * 86400;
	ВывестиЗапрос(Лог, "5.10. События внешних сервисов (журнал обмена, если он включен) по часам за 3 дня",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Соб.Период, ЧАС) КАК Час,
	|	Соб.ИмяСервиса КАК ИмяСервиса,
	|	Соб.Тип КАК ТипСобытия,
	|	КОЛИЧЕСТВО(*) КАК Событий,
	|	СУММА(ВЫБОР
	|			КОГДА Соб.Комментарий ПОДОБНО ""%ерерасчет%""
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СУпоминаниемПерерасчета
	|ИЗ
	|	РегистрСведений.СобытияВнешнихСервисов КАК Соб
	|ГДЕ
	|	Соб.Период >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Соб.Период, ЧАС),
	|	Соб.ИмяСервиса,
	|	Соб.Тип
	|
	|УПОРЯДОЧИТЬ ПО
	|	Час", Новый Структура("Начало", НачалоСобытий), 400);

КонецПроцедуры

// Вызывает getDeposits сервисов ДУ и ПИФ по адресам и учетным данным из настроек обработки загрузки депозитов
// и выводит время получения описания сервиса, время ответа и число депозитов. Данные баз не меняются;
// адреса и учетные данные в лог не выводятся. Calipso не замеряется: его параметры заданы в коде обработки.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура ЗамерСервисовДепозитов(Лог)

	Лог.Добавить("");
	Лог.Добавить("--- 5.11. Замер сервисов депозитов ДУ и ПИФ (getDeposits на текущую дату)");
	Настройки = НастройкиОбработки("внЗагрузкаДепозитовИзВнешнихИсточников");
	Если Настройки = Неопределено Тогда
		Лог.Добавить("Настройки обработки загрузки депозитов не найдены");
		Возврат;
	КонецЕсли;

	Логин = ЗначениеНастройки(Настройки, "Логин");
	Пароль = ЗначениеНастройки(Настройки, "Пароль");
	Для Каждого Источник Из СтрРазделить("ДУ,ПИФ", ",") Цикл
		Адрес = ЗначениеНастройки(Настройки, "ВебСервис" + Источник);
		Если Не ЗначениеЗаполнено(Адрес) Тогда
			Лог.Добавить(Источник + ": адрес сервиса в настройках не задан");
			Продолжить;
		КонецЕсли;
		Попытка
			НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Определения = Новый WSОпределения(Адрес, Логин, Пароль, , 120);
			ВремяОпределения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
			Сервис = Определения.Сервисы[0];
			Прокси = Новый WSПрокси(Определения, Сервис.URIПространстваИмен, Сервис.Имя, Сервис.ТочкиПодключения[0].Имя,
				, 3600);
			Прокси.Пользователь = Логин;
			Прокси.Пароль = Пароль;
			НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Ответ = Прокси.getDeposits(ТекущаяДатаСеанса());
			ВремяОтвета = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
			Лог.Добавить(СтрШаблон("%1: описание сервиса %2 мс; getDeposits %3 мс; депозитов %4", Источник,
				ФорматЧисла(ВремяОпределения), ФорматЧисла(ВремяОтвета), ФорматЧисла(ЧислоДепозитов(Ответ))));
		Исключение
			Лог.Добавить(Источник + ": ошибка вызова: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Возвращает число депозитов в ответе getDeposits.
//
// Параметры:
//  Ответ - ОбъектXDTO, Неопределено - ответ сервиса
//
// Возвращаемое значение:
//  Число - число элементов deposit
//
Функция ЧислоДепозитов(Ответ)

	Если ТипЗнч(Ответ) <> Тип("ОбъектXDTO") Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Депозиты = Ответ.deposit;
	Исключение
		Возврат 0;
	КонецПопытки;
	Если ТипЗнч(Депозиты) = Тип("ОбъектXDTO") Тогда
		Возврат 1;
	ИначеЕсли ТипЗнч(Депозиты) = Тип("СписокXDTO") Тогда
		Возврат Депозиты.Количество();
	КонецЕсли;
	Возврат 0;

КонецФункции

// Выводит неторговые поручения, созданные обработкой РОСТ, их статусы, портфели по
// статусам из настроек и время двух запросов обработки.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделНеторговыеПоручения(Лог, Начало)

	Параметры = Новый Структура("Начало", Начало);
	ОтборПоручений =
	"	Пор.Дата >= &Начало
	|	И Пор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.НеторговоеПоручение)
	|	И Пор.ВидОперацииНеторговогоПоручения = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНеторговыхПоручений.Ввод)
	|	И ПОДСТРОКА(Пор.Комментарий, 1, 100) ПОДОБНО ""Создан автоматически обработой Загрузка неторговых%""";

	ВывестиЗапрос(Лог, "6.1. Поручения, созданные обработкой, по дням",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Пор.Дата, ДЕНЬ) КАК День,
	|	КОЛИЧЕСТВО(*) КАК Поручений,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Пор.Портфель) КАК Портфелей,
	|	СУММА(ВЫБОР
	|			КОГДА Пор.Проведен
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК НеПроведено,
	|	СУММА(Пор.СуммаПоручения) КАК Сумма
	|ИЗ
	|	Документ.Поручение КАК Пор
	|ГДЕ
	|" + ОтборПоручений + "
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Пор.Дата, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ", Параметры);

	ВывестиЗапрос(Лог, "6.2. Поручения, созданные обработкой, по часам суток",
	"ВЫБРАТЬ
	|	ЧАС(Пор.Дата) КАК Час,
	|	КОЛИЧЕСТВО(*) КАК Поручений
	|ИЗ
	|	Документ.Поручение КАК Пор
	|ГДЕ
	|" + ОтборПоручений + "
	|
	|СГРУППИРОВАТЬ ПО
	|	ЧАС(Пор.Дата)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Час", Параметры);

	ВывестиЗапрос(Лог, "6.3. Статусы этих поручений (отправляются ли они)",
	"ВЫБРАТЬ
	|	Ст.Статус КАК Статус,
	|	СУММА(ВЫБОР
	|			КОГДА Ст.Отправлено
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПризнакОтправлено,
	|	СУММА(ВЫБОР
	|			КОГДА Ст.Исполнена
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ПризнакИсполнена,
	|	КОЛИЧЕСТВО(*) КАК Поручений
	|ИЗ
	|	Документ.Поручение КАК Пор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПоручений КАК Ст
	|		ПО (Ст.Поручение = Пор.Ссылка)
	|ГДЕ
	|" + ОтборПоручений + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Ст.Статус", Параметры);

	ВывестиЗапрос(Лог, "6.7. Версии этих поручений за 7 дней: когда и кем они меняются (распроводятся)",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Вер.ДатаВерсии, ДЕНЬ) КАК День,
	|	ЧАС(Вер.ДатаВерсии) КАК Час,
	|	Вер.ТипВерсииОбъекта КАК ТипВерсии,
	|	Вер.АвторВерсии КАК Автор,
	|	КОЛИЧЕСТВО(*) КАК Версий,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Вер.Объект) КАК Поручений
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК Вер
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Поручение КАК Пор
	|		ПО Вер.Объект = Пор.Ссылка
	|ГДЕ
	|" + ОтборПоручений + "
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Вер.ДатаВерсии, ДЕНЬ),
	|	ЧАС(Вер.ДатаВерсии),
	|	Вер.ТипВерсииОбъекта,
	|	Вер.АвторВерсии
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ,
	|	Час", Новый Структура("Начало", НачалоДня(ТекущаяДатаСеанса()) - 7 * 86400), 200, "Автор");

	Настройки = НастройкиОбработки("внЗагрузкаНеторговыхПорученийРОСТ");
	Если Настройки = Неопределено Тогда
		Настройки = НастройкиОбработки("ЗагрузкаНеторговыхПорученийРОСТ");
	КонецЕсли;
	Если Настройки = Неопределено Тогда
		Лог.Добавить("");
		Лог.Добавить("Настройки неторговой обработки РОСТ не найдены ни под одним именем, разделы 6.4-6.6 пропущены");
		Возврат;
	КонецЕсли;

	ПараметрыСтатусов = Новый Структура("Свойство, СтатусДляПоиска, СтатусДСОтправленыБрокеру, СтатусДляПеревода, СтатусПоданоПоручениеНаВыводДС_СБрокера, СтатусДСВыведены");
	ПараметрыСтатусов.Свойство = ЗначениеНастройки(Настройки, "ДопРеквизитСтатусПортфеля");
	ИменаСтатусов = СтрРазделить("СтатусДляПоиска,СтатусДСОтправленыБрокеру,СтатусДляПеревода,"
		+ "СтатусПоданоПоручениеНаВыводДС_СБрокера,СтатусДСВыведены", ",");
	Для Каждого ИмяСтатуса Из ИменаСтатусов Цикл
		ПараметрыСтатусов[ИмяСтатуса] = ЗначениеНастройки(Настройки, ИмяСтатуса);
	КонецЦикла;

	ВывестиЗапрос(Лог, "6.4. Портфели по статусам из настроек (СтатусДляПоиска + СтатусДСОтправленыБрокеру = вызовы 1С:ДО на каждый запуск)",
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК ПортфелейСоСтатусом,
	|	СУММА(ВЫБОР
	|			КОГДА ДопСв.Значение = &СтатусДляПоиска
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтатусДляПоиска,
	|	СУММА(ВЫБОР
	|			КОГДА ДопСв.Значение = &СтатусДСОтправленыБрокеру
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтатусДСОтправленыБрокеру,
	|	СУММА(ВЫБОР
	|			КОГДА ДопСв.Значение = &СтатусДляПеревода
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтатусДляПеревода,
	|	СУММА(ВЫБОР
	|			КОГДА ДопСв.Значение = &СтатусПоданоПоручениеНаВыводДС_СБрокера
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтатусПоданоНаВывод,
	|	СУММА(ВЫБОР
	|			КОГДА ДопСв.Значение = &СтатусДСВыведены
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтатусДСВыведены
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДопСв
	|ГДЕ
	|	ДопСв.Объект ССЫЛКА Справочник.Портфели
	|	И ДопСв.Свойство = &Свойство", ПараметрыСтатусов);

	// Тексты запросов ПолучитьСуммуКупоны и ПолучитьПортфелиДляСозданияПоручений обработки 1.07 - замер их времени.
	ВывестиЗапрос(Лог, "6.5. Время запроса суммы купонов (ПолучитьСуммуКупоны, результат в обработке не используется)",
	"ВЫБРАТЬ
	|	т.Актив КАК Актив,
	|	т.Актив.Объект КАК АктивОбъект,
	|	СУММА(т.Количество) КАК Количество
	|ПОМЕСТИТЬ втАктивы
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК т
	|ГДЕ
	|	т.Дата = &НаДату
	|
	|СГРУППИРОВАТЬ ПО
	|	т.Актив,
	|	т.Актив.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Облигация КАК Облигация,
	|	т.Документ КАК Документ
	|ПОМЕСТИТЬ втКупоны
	|ИЗ
	|	РегистрСведений.КупонноеРасписаниеПоОблигациям.СрезПоследних(
	|			КОНЕЦПЕРИОДА(&НаДату, ДЕНЬ),
	|			Облигация В
	|				(ВЫБРАТЬ
	|					т.АктивОбъект КАК АктивОбъект
	|				ИЗ
	|					втАктивы КАК т)) КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	СУММА(ЕСТЬNULL(тКупоны.РазмерДоходаВРублях, 0) * ЕСТЬNULL(втАктивы.Количество, 0)) КАК СуммаКупонов
	|ИЗ
	|	втКупоны КАК втКупоны
	|		ЛЕВОЕ СОЕДИНЕНИЕ втАктивы КАК втАктивы
	|		ПО втКупоны.Облигация = втАктивы.АктивОбъект
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КупонноеРасписание.Купоны КАК тКупоны
	|		ПО втКупоны.Документ = тКупоны.Ссылка
	|ГДЕ
	|	тКупоны.ДатаОкончанияКупонногоПериода = &НаДату", Новый Структура("НаДату", ДатаПоследнейПозиции()));

	Статусы = Новый Массив;
	Статусы.Добавить(ПараметрыСтатусов.СтатусДляПоиска);
	Статусы.Добавить(ПараметрыСтатусов.СтатусДСОтправленыБрокеру);
	ВывестиЗапрос(Лог, "6.6. Время запроса отбора портфелей (ПолучитьПортфелиДляСозданияПоручений)",
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Портфель,
	|	ДополнительныеСведения.Значение КАК СтатусПортфеля
	|ПОМЕСТИТЬ ВТ_Портфели
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Свойство = &Свойство
	|	И ДополнительныеСведения.Значение В (&Значение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Портфели.Портфель) КАК Портфелей,
	|	КОЛИЧЕСТВО(Поручение.Ссылка) КАК ПорученийВводУНих
	|ИЗ
	|	ВТ_Портфели КАК ВТ_Портфели
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Поручение КАК Поручение
	|		ПО ВТ_Портфели.Портфель = Поручение.Портфель
	|			И (Поручение.Проведен)
	|			И (Поручение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыПоручений.НеторговоеПоручение))
	|			И (Поручение.ВидОперацииНеторговогоПоручения = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНеторговыхПоручений.Ввод))",
		Новый Структура("Свойство, Значение", ПараметрыСтатусов.Свойство, Статусы));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Замеряет время запросов сопоставления депозита в ФО (как в обработке загрузки депозитов)
// по 5 вызовов на образцах. Значения образцов в лог не выводятся.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  СвойствоИД - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство ИдентификаторДепозита
//
Процедура ЗамерыСопоставления(Лог, СвойствоИД)

	Лог.Добавить("");
	Лог.Добавить("--- 5.4а. Время запросов сопоставления депозита в ФО (на один депозит)");
	Если Не ЗначениеЗаполнено(СвойствоИД) Тогда
		Лог.Добавить("Свойство ИдентификаторДепозита не найдено, пропущено");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 5
	|	ДопСв.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДопСв
	|ГДЕ
	|	ДопСв.Объект ССЫЛКА Справочник.МестаХранения
	|	И ДопСв.Свойство = &Свойство");
	Запрос.УстановитьПараметр("Свойство", СвойствоИД);
	Образцы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значение");
	Если Образцы.Количество() = 0 Тогда
		Образцы.Добавить("00000000-0000-0000-0000-000000000000");
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект ССЫЛКА Справочник.МестаХранения
	|	И ДополнительныеСведения.Свойство = &Свойство
	|	И ДополнительныеСведения.Значение = &Значение");
	Запрос.УстановитьПараметр("Свойство", СвойствоИД);
	Времена = Новый Массив;
	Для Каждого Образец Из Образцы Цикл
		Запрос.УстановитьПараметр("Значение", Образец);
		НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Запрос.Выполнить();
		Времена.Добавить(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса);
	КонецЦикла;
	Лог.Добавить("НайтиМестоХранения: " + СводкаВремен(Времена));

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Портфели.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Портфели КАК Портфели
	|ГДЕ
	|	Портфели.КодПортфеля ПОДОБНО ""%"" + &КодПортфеля + ""%""");
	Времена = Новый Массив;
	Для Номер = 1 По 5 Цикл
		Запрос.УстановитьПараметр("КодПортфеля", Формат(Номер, "ЧЦ=4; ЧВН=; ЧГ=0"));
		НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Запрос.Выполнить();
		Времена.Добавить(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса);
	КонецЦикла;
	Лог.Добавить("НайтиПортфель (ПОДОБНО по коду портфеля): " + СводкаВремен(Времена));

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Субпортфели.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Субпортфели КАК Субпортфели
	|ГДЕ
	|	НЕ Субпортфели.ПометкаУдаления
	|	И Субпортфели.КодСчета ПОДОБНО ""%"" + &КодСчета + ""%""");
	Времена = Новый Массив;
	Для Номер = 1 По 5 Цикл
		Запрос.УстановитьПараметр("КодСчета", "-D" + Формат(Номер, "ЧГ=0") + "ZZ-");
		НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Запрос.Выполнить();
		Времена.Добавить(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса);
	КонецЦикла;
	Лог.Добавить("НайтиСубПортфельПоМаске (Calipso): " + СводкаВремен(Времена));

КонецПроцедуры

// Формирует строку со сводкой времени вызовов.
//
// Параметры:
//  Времена - Массив из Число - длительности вызовов в миллисекундах
//
// Возвращаемое значение:
//  Строка - число вызовов, среднее и максимум
//
Функция СводкаВремен(Времена)

	Сумма = 0;
	Максимум = 0;
	Для Каждого Время Из Времена Цикл
		Сумма = Сумма + Время;
		Максимум = Макс(Максимум, Время);
	КонецЦикла;
	Возврат СтрШаблон("%1 вызовов, среднее %2 мс, максимум %3 мс", Времена.Количество(),
		ФорматЧисла(Окр(Сумма / Макс(Времена.Количество(), 1))), ФорматЧисла(Максимум));

КонецФункции

// Возвращает последнюю дату фактической позиции не позже сегодняшней (на Т-1 позиция есть
// только до вчера).
//
// Возвращаемое значение:
//  Дата - дата позиции или начало текущего дня, если позиции нет
//
Функция ДатаПоследнейПозиции()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МАКСИМУМ(Поз.Дата) КАК Дата
	|ИЗ
	|	РегистрСведений.ФактическаяПозиция КАК Поз
	|ГДЕ
	|	Поз.Дата <= &НаДату");
	Запрос.УстановитьПараметр("НаДату", НачалоДня(ТекущаяДатаСеанса()));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Дата) Тогда
		Возврат Выборка.Дата;
	КонецЕсли;
	Возврат НачалоДня(ТекущаяДатаСеанса());

КонецФункции

// Выводит команды дополнительной обработки и состояние их регламентных заданий.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Обработка - СправочникСсылка.ДополнительныеОтчетыИОбработки - обработка
//
Процедура ВывестиКомандыОбработки(Лог, Обработка)

	Для Каждого Команда Из Обработка.Команды Цикл
		Лог.Добавить(СтрШаблон("  Команда %1: %2", Команда.Идентификатор, ЗначениеСтрокой(Команда.ВариантЗапуска)));
		Если Не ЗначениеЗаполнено(Команда.РегламентноеЗаданиеGUID) Тогда
			Лог.Добавить("    регламентное задание (расписание) не назначено");
		Иначе
			Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Команда.РегламентноеЗаданиеGUID);
			Если Задание = Неопределено Тогда
				Лог.Добавить("    регламентное задание по GUID не найдено");
			Иначе
				ВывестиЗадание(Лог, "    ", Задание);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Выводит использование, расписание и последнее выполнение регламентного задания.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Отступ - Строка - префикс строк
//  Задание - РегламентноеЗадание - задание
//
Процедура ВывестиЗадание(Лог, Отступ, Задание)

	Лог.Добавить(Отступ + "Использование: " + ЗначениеСтрокой(Задание.Использование));
	Лог.Добавить(Отступ + "Расписание: " + Строка(Задание.Расписание));
	Последнее = Задание.ПоследнееЗадание;
	Если Последнее = Неопределено Тогда
		Лог.Добавить(Отступ + "Последнее выполнение: нет данных");
	Иначе
		Лог.Добавить(СтрШаблон("%1Последнее выполнение: начало %2, конец %3, состояние %4", Отступ,
			ЗначениеСтрокой(Последнее.Начало), ЗначениеСтрокой(Последнее.Конец), Строка(Последнее.Состояние)));
	КонецЕсли;

КонецПроцедуры

// Выводит настройки дополнительной обработки из ХранилищеНастроек; секретные и адресные значения
// скрыты.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Обработка - СправочникСсылка.ДополнительныеОтчетыИОбработки - обработка
//
Процедура ВывестиНастройки(Лог, Обработка)

	Настройки = Обработка.ХранилищеНастроек.Получить();
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Лог.Добавить("  Настройки: " + Строка(ТипЗнч(Настройки)));
		Возврат;
	КонецЕсли;
	Лог.Добавить("  Настройки (секретные и адресные - скрыты):");
	Для Каждого КлючИЗначение Из Настройки Цикл
		Лог.Добавить("    " + КлючИЗначение.Ключ + " = " + ПредставлениеНастройки(КлючИЗначение.Ключ, КлючИЗначение.Значение));
	КонецЦикла;

КонецПроцедуры

// Возвращает представление значения настройки для лога; по имени настройки скрывает
// пароли, логины, адреса, почту и списки рассылки.
//
// Параметры:
//  Ключ - Строка - имя настройки
//  Значение - Произвольный - значение настройки
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ПредставлениеНастройки(Ключ, Значение)

	ИмяНастройки = НРег(Ключ);
	Для Каждого Признак Из СтрРазделить("пароль,password,pwd,логин,login,uid,адрес,url,почт,mail,рассылк,вебсервис,ws,кодсчета,сервер", ",") Цикл
		Если СтрНайти(ИмяНастройки, Признак) > 0 Тогда
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат "<задано, скрыто>";
			КонецЕсли;
			Возврат "<пусто>";
		КонецЕсли;
	КонецЦикла;

	Тип = ТипЗнч(Значение);
	Если Тип = Тип("ТаблицаЗначений") Или Тип = Тип("Массив") Или Тип = Тип("СписокЗначений") Тогда
		Возврат Строка(Тип) + ", элементов: " + Значение.Количество();
	ИначеЕсли Тип = Тип("Структура") Или Тип = Тип("Соответствие") Тогда
		Возврат Строка(Тип) + ", ключей: " + Значение.Количество();
	ИначеЕсли Тип = Тип("ХранилищеЗначения") Тогда
		Возврат "ХранилищеЗначения";
	ИначеЕсли Тип = Тип("Строка") Тогда
		Возврат """" + Лев(Значение, 200) + """";
	КонецЕсли;
	Возврат ЗначениеСтрокой(Значение) + " [" + Строка(Тип) + "]";

КонецФункции

// Возвращает настройки дополнительной обработки по имени объекта.
//
// Параметры:
//  ИмяОбъекта - Строка - имя объекта обработки
//
// Возвращаемое значение:
//  Структура, Неопределено - настройки или Неопределено, если обработки или настроек нет
//
Функция НастройкиОбработки(ИмяОбъекта)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обр
	|ГДЕ
	|	Обр.ИмяОбъекта = &ИмяОбъекта
	|	И НЕ Обр.ПометкаУдаления");
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Настройки = Выборка.Ссылка.ХранилищеНастроек.Получить();
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Возврат Настройки;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Возвращает одну настройку дополнительной обработки.
//
// Параметры:
//  ИмяОбъекта - Строка - имя объекта обработки
//  ИмяНастройки - Строка - имя настройки
//
// Возвращаемое значение:
//  Произвольный - значение или Неопределено
//
Функция НастройкаОбработки(ИмяОбъекта, ИмяНастройки)

	Возврат ЗначениеНастройки(НастройкиОбработки(ИмяОбъекта), ИмяНастройки);

КонецФункции

// Возвращает значение из структуры настроек.
//
// Параметры:
//  Настройки - Структура, Неопределено - настройки обработки
//  ИмяНастройки - Строка - имя настройки
//
// Возвращаемое значение:
//  Произвольный - значение или Неопределено
//
Функция ЗначениеНастройки(Настройки, ИмяНастройки)

	Значение = Неопределено;
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки.Свойство(ИмяНастройки, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Возвращает имена объектов дополнительных обработок строк 3, 9, 13 и пересчета РСА.
//
// Возвращаемое значение:
//  Массив из Строка - имена объектов
//
Функция ИменаОбработок()

	Имена = Новый Массив;
	Имена.Добавить("внЗагрузкаДепозитовИзВнешнихИсточников");
	Имена.Добавить("внЗагрузкаНеторговыхПорученийРОСТ");
	Имена.Добавить("ЗагрузкаНеторговыхПорученийРОСТ");
	Имена.Добавить("внРаспространениеПравилСОдногоКлиентаНаСписокКлиентов");
	Имена.Добавить("внОперацииПослеОбмена");
	Имена.Добавить("внПерерасчетСтоимостиФактическойПозицииИ_РСА_СЧА");
	Возврат Имена;

КонецФункции

// Выполняет запрос, выводит время выполнения, число строк и таблицу результата. Ошибка запроса
// выводится в лог и не прерывает сбор.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Заголовок - Строка - заголовок блока
//  ТекстЗапроса - Строка - текст запроса
//  Параметры - Структура - параметры запроса
//  МаксимумСтрок - Число - предел выводимых строк
//  КолонкаПользователя - Строка - колонка со ссылкой на пользователя, выводится маской (кроме служебных svc)
//
Процедура ВывестиЗапрос(Лог, Заголовок, ТекстЗапроса, Параметры, МаксимумСтрок = 100, КолонкаПользователя = "")

	Лог.Добавить("");
	Лог.Добавить("--- " + Заголовок);
	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Попытка
		НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Таблица = Запрос.Выполнить().Выгрузить();
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса;
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Лог.Добавить(СтрШаблон("Время запроса: %1 мс; строк: %2", ФорматЧисла(Длительность), ФорматЧисла(Таблица.Количество())));
	ВывестиТаблицу(Лог, Таблица, МаксимумСтрок, КолонкаПользователя);

КонецПроцедуры

// Выводит таблицу значений строками с разделителем " | ".
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Таблица - ТаблицаЗначений - данные
//  МаксимумСтрок - Число - предел выводимых строк
//  КолонкаПользователя - Строка - колонка, значения которой выводятся маской пользователя
//
Процедура ВывестиТаблицу(Лог, Таблица, МаксимумСтрок, КолонкаПользователя = "")

	Имена = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;
	Лог.Добавить(СтрСоединить(Имена, " | "));

	Номер = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Номер = Номер + 1;
		Если Номер > МаксимумСтрок Тогда
			Лог.Добавить("... еще строк: " + ФорматЧисла(Таблица.Количество() - МаксимумСтрок));
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если Колонка.Имя = КолонкаПользователя Тогда
				Значения.Добавить(МаскаПользователя(СтрокаТаблицы[Колонка.Имя]));
			Иначе
				Значения.Добавить(ЗначениеСтрокой(СтрокаТаблицы[Колонка.Имя]));
			КонецЕсли;
		КонецЦикла;
		Лог.Добавить(СтрСоединить(Значения, " | "));
	КонецЦикла;

КонецПроцедуры

// Возвращает представление пользователя для лога: служебные учетные записи (svc) - как есть, остальные - маской,
// чтобы в лог не попадали имена сотрудников.
//
// Параметры:
//  Значение - СправочникСсылка.Пользователи, Произвольный - автор
//
// Возвращаемое значение:
//  Строка - имя служебной учетной записи или "<пользователь>"
//
Функция МаскаПользователя(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "-";
	КонецЕсли;
	Представление = СокрЛП(Строка(Значение));
	Если СтрНайти(НРег(Представление), "svc") > 0 Тогда
		Возврат Представление;
	КонецЕсли;
	Возврат "<пользователь>";

КонецФункции

// Выводит все включенные регламентные задания базы: имя метаданных, наименование, расписание, последний запуск.
// На Т-1 состояние заданий берется из копии базы и может отличаться от ПРОД, если копию после восстановления
// перенастраивали.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура ВывестиВключенныеЗадания(Лог)

	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Новый Структура("Использование", Истина));
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Задание");
	Таблица.Колонки.Добавить("Наименование");
	Таблица.Колонки.Добавить("Расписание");
	Таблица.Колонки.Добавить("ПоследнийЗапуск");
	Для Каждого Задание Из Задания Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Задание      = Задание.Метаданные.Имя;
		НоваяСтрока.Наименование = Задание.Наименование;
		НоваяСтрока.Расписание   = Строка(Задание.Расписание);
		Последнее = Задание.ПоследнееЗадание;
		Если Последнее <> Неопределено Тогда
			НоваяСтрока.ПоследнийЗапуск = Последнее.Начало;
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("Задание, Наименование");
	Лог.Добавить("");
	Лог.Добавить("--- 2.0. Включенные регламентные задания базы: " + ФорматЧисла(Таблица.Количество()));
	ВывестиТаблицу(Лог, Таблица, 400);

КонецПроцедуры

// Возвращает представление значения для лога.
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ЗначениеСтрокой(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧРД=.");
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'; ДП=-");
	ИначеЕсли Тип = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Возвращает число без разделителей групп, ноль как "0".
//
// Параметры:
//  Значение - Число - число
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ФорматЧисла(Значение)

	Возврат Формат(Значение, "ЧН=0; ЧГ=0");

КонецФункции

// Возвращает имя информационной базы на сервере 1С из строки соединения.
//
// Возвращаемое значение:
//  Строка - имя базы или строка соединения целиком для файловой базы
//
Функция ИмяБазы()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Позиция = СтрНайти(СтрокаСоединения, "Ref=");
	Если Позиция = 0 Тогда
		Возврат СтрокаСоединения;
	КонецЕсли;
	Остаток = Сред(СтрокаСоединения, Позиция + 5);
	Возврат Лев(Остаток, СтрНайти(Остаток, """") - 1);

КонецФункции

// Добавляет заголовок раздела.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Заголовок - Строка - заголовок
//
Процедура ДобавитьРаздел(Лог, Заголовок)

	Лог.Добавить("");
	Лог.Добавить("==================== " + Заголовок);

КонецПроцедуры

// Добавляет в лог краткое представление ошибки.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Информация - ИнформацияОбОшибке - ошибка
//
Процедура ДобавитьОшибку(Лог, Информация)

	Лог.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(Информация));

КонецПроцедуры

#КонецОбласти

#КонецЕсли
