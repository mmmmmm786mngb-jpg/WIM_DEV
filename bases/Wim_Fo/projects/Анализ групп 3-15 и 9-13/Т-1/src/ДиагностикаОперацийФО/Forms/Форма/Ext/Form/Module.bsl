#Область ОбработчикиСобытийФормы

// Заполняет глубину истории по умолчанию и строку соединения базы.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДнейИстории      = 30;
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Собирает лог диагностики на сервере. Данные базы не меняются.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Собрать(Команда)

	Результат = "Выполняется сбор...";
	СобратьНаСервере();

КонецПроцедуры

// Сохраняет текст лога в файл на компьютере пользователя (UTF-8).
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(Результат) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала соберите лог");
		Возврат;
	КонецЕсли;

	ИмяФайла = "Диагностика_ФО_" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt";
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресФайла(), ИмяФайла);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет сбор лога модулем объекта и помещает текст в реквизит Результат.
//
&НаСервере
Процедура СобратьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.СобратьЛог(ДнейИстории, ЗамеритьСервисыДепозитов);

КонецПроцедуры

// Помещает текст лога во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла (UTF-8 без BOM)
//
&НаСервере
Функция АдресФайла()

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Результат, "UTF-8", Ложь);
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
