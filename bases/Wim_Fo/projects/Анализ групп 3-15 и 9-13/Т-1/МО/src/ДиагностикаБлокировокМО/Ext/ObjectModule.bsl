// Диагностика блокировок денежных средств МО и утренней выгрузки остатков МО - ФО на копии Т-1. С 21.10 выгрузка
// в розничный ФО идет вдвое дольше: на каждый мандат с остатком в регистре ДенежныеСредстваЗаблокированные
// обработка внВыгрузкаОстатковМО_ФО отправляет отдельный вызов DownloadOrders. Обработка показывает, когда и чем
// появились блокировки. Только чтение: данные базы не записываются. Имена мандатов и клиентов в лог не выводятся.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Собирает лог диагностики.
//
// Параметры:
//  ДнейИстории - Число - глубина истории в днях
//
// Возвращаемое значение:
//  Строка - текст лога
//
Функция СобратьЛог(ДнейИстории) Экспорт

	Лог = Новый Массив;
	НачалоСбора = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Начало = НачалоДня(ТекущаяДатаСеанса()) - ДнейИстории * 86400;

	// Привилегированный режим нужен, чтобы ограничения доступа не скрыли строки агрегатов и были видны
	// регламентные задания; в безопасном режиме он недоступен, тогда запросы идут с правами пользователя.
	Попытка
		УстановитьПривилегированныйРежим(Истина);
	Исключение
		Лог.Добавить("Привилегированный режим не установлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ДобавитьРаздел(Лог, "0. Общие сведения");
	Попытка
		РазделОбщиеСведения(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "1. Замеры выгрузки остатков МО - ФО по дням (регистр ЗамерыВремени)");
	Попытка
		РазделЗамерыВыгрузки(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "2. Блокировки денежных средств (регистр ДенежныеСредстваЗаблокированные)");
	Попытка
		РазделДвиженияБлокировок(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;
	Попытка
		РазделОстаткиБлокировок(Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "3. Документы БлокировкаРазблокировкаДС");
	Попытка
		РазделДокументыБлокировки(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "4. Дополнительные обработки блокировок и выгрузки, их регламентные задания");
	Попытка
		РазделОбработки(Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	Лог.Добавить("");
	Лог.Добавить("Сбор завершен за " + ФорматЧисла(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСбора) + " мс");

	УстановитьПривилегированныйРежим(Ложь);

	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Разделы

// Выводит дату сбора, конфигурацию, базу и период лога.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделОбщиеСведения(Лог, Начало)

	Лог.Добавить("Версия диагностики МО: 1 (28.10.2026)");
	Лог.Добавить("Дата сбора: " + ЗначениеСтрокой(ТекущаяДатаСеанса()));
	Лог.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);
	Лог.Добавить("База: " + ИмяБазы());
	Лог.Добавить("Период: с " + Формат(Начало, "ДФ=dd.MM.yyyy"));

КонецПроцедуры

// Выводит по дням замеры ключевых операций обработки внВыгрузкаОстатковМО_ФО: число замеров, сумму времени и веса.
// Вес замера Блокировки_Сервер - число строк блокировок, которые выгрузка отправляет в ФО поручениями.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделЗамерыВыгрузки(Лог, Начало)

	ВывестиЗапрос(Лог, "1.1. Замеры внВыгрузкаОстатковМО_ФО по дням и ключам (без ключей потоков и пачек)",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаЗаписиЛокальная, ДЕНЬ) КАК День,
	|	Замеры.КлючеваяОперация.Имя КАК Ключ,
	|	КОЛИЧЕСТВО(*) КАК Замеров,
	|	СУММА(Замеры.ВремяВыполнения) КАК СуммаСек,
	|	МАКСИМУМ(Замеры.ВремяВыполнения) КАК МаксСек,
	|	СУММА(Замеры.ВесЗамера) КАК СуммаВеса,
	|	МИНИМУМ(Замеры.ДатаЗаписиЛокальная) КАК Первый,
	|	МАКСИМУМ(Замеры.ДатаЗаписиЛокальная) КАК Последний
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Замеры
	|ГДЕ
	|	Замеры.ДатаЗаписиНачалоЧаса >= &Начало
	|	И Замеры.КлючеваяОперация.Имя ПОДОБНО ""внВыгрузкаОстатковМО%""
	|	И НЕ Замеры.КлючеваяОперация.Имя ПОДОБНО ""%поток%""
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаЗаписиЛокальная, ДЕНЬ),
	|	Замеры.КлючеваяОперация.Имя
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ключ,
	|	День", Новый Структура("Начало", Начало), 600);

КонецПроцедуры

// Выводит движения регистра блокировок по дням: вид движения, объект блокировки, тип регистратора, записи, мандаты
// и сумма. Показывает, в какой день и каким документом появились блокировки у массы мандатов.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделДвиженияБлокировок(Лог, Начало)

	ВывестиЗапрос(Лог, "2.1. Движения блокировок по дням (больше 10 записей за день)",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Блокировки.Период, ДЕНЬ) КАК День,
	|	Блокировки.ВидДвижения КАК ВидДвижения,
	|	Блокировки.ОбъектБлокировки КАК ОбъектБлокировки,
	|	ТИПЗНАЧЕНИЯ(Блокировки.Регистратор) КАК ТипРегистратора,
	|	КОЛИЧЕСТВО(*) КАК Записей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Блокировки.Мандат) КАК Мандатов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Блокировки.Регистратор) КАК Документов,
	|	СУММА(Блокировки.ВалютнаяСумма) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваЗаблокированные КАК Блокировки
	|ГДЕ
	|	Блокировки.Период >= &Начало
	|	И Блокировки.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Блокировки.Период, ДЕНЬ),
	|	Блокировки.ВидДвижения,
	|	Блокировки.ОбъектБлокировки,
	|	ТИПЗНАЧЕНИЯ(Блокировки.Регистратор)
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 10
	|
	|УПОРЯДОЧИТЬ ПО
	|	День,
	|	Записей УБЫВ", Новый Структура("Начало", Начало), 400);

КонецПроцедуры

// Выводит остатки блокировок на конец каждого из последних 15 дней по объекту блокировки: мандаты и строки
// (мандат, счет, валюта) - это то, что выгрузка отправляет в ФО поручениями-блокировками, и сумма. Затем остаток
// на текущий момент по типу мандата. Каждый день читается отдельным запросом по фиксированному списку дат:
// виртуальная таблица остатков принимает одну границу.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура РазделОстаткиБлокировок(Лог)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОстаткиБлокировок.ОбъектБлокировки КАК ОбъектБлокировки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиБлокировок.Мандат) КАК Мандатов,
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	СУММА(ОстаткиБлокировок.ВалютнаяСуммаОстаток) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваЗаблокированные.Остатки(&Граница, ) КАК ОстаткиБлокировок
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБлокировок.ОбъектБлокировки";

	Итог = Новый ТаблицаЗначений;
	Итог.Колонки.Добавить("НаКонецДня");
	Итог.Колонки.Добавить("ОбъектБлокировки");
	Итог.Колонки.Добавить("Мандатов");
	Итог.Колонки.Добавить("Строк");
	Итог.Колонки.Добавить("Сумма");
	НачалоЗапросов = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Для Сдвиг = 0 По 15 Цикл
		День = Сегодня - (15 - Сдвиг) * 86400;
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(День), ВидГраницы.Включая));
		Для Каждого СтрокаОстатка Из Запрос.Выполнить().Выгрузить() Цикл
			НоваяСтрока = Итог.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатка);
			НоваяСтрока.НаКонецДня = Формат(День, "ДФ=dd.MM.yyyy");
		КонецЦикла;
	КонецЦикла;
	Лог.Добавить("");
	Лог.Добавить("--- 2.2. Остатки блокировок на конец дня по объекту блокировки (16 запросов, "
		+ ФорматЧисла(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапросов) + " мс)");
	ВывестиТаблицу(Лог, Итог, 300);

	ВывестиЗапрос(Лог, "2.3. Остатки блокировок на текущий момент по типу мандата и объекту блокировки",
	"ВЫБРАТЬ
	|	ОстаткиБлокировок.Мандат.ТипМандата КАК ТипМандата,
	|	ОстаткиБлокировок.ОбъектБлокировки КАК ОбъектБлокировки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиБлокировок.Мандат) КАК Мандатов,
	|	КОЛИЧЕСТВО(*) КАК Строк,
	|	СУММА(ОстаткиБлокировок.ВалютнаяСуммаОстаток) КАК Сумма,
	|	МИНИМУМ(ОстаткиБлокировок.ВалютнаяСуммаОстаток) КАК МинСумма,
	|	МАКСИМУМ(ОстаткиБлокировок.ВалютнаяСуммаОстаток) КАК МаксСумма
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваЗаблокированные.Остатки(, ) КАК ОстаткиБлокировок
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБлокировок.Мандат.ТипМандата,
	|	ОстаткиБлокировок.ОбъектБлокировки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Мандатов УБЫВ", Новый Структура, 100);

КонецПроцедуры

// Выводит документы БлокировкаРазблокировкаДС за период по дням документа: вид операции, объект блокировки,
// проведение, пометку удаления, ручную корректировку, основание (текст), число документов и мандатов.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделДокументыБлокировки(Лог, Начало)

	ВывестиЗапрос(Лог, "3.1. Документы блокировки и разблокировки ДС по дням (больше 10 документов за день)",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ДокументыБлокировки.Дата, ДЕНЬ) КАК День,
	|	ДокументыБлокировки.ВидОперации КАК ВидОперации,
	|	ДокументыБлокировки.ОбъектБлокировка КАК ОбъектБлокировки,
	|	ДокументыБлокировки.Проведен КАК Проведен,
	|	ДокументыБлокировки.ПометкаУдаления КАК ПометкаУдаления,
	|	ДокументыБлокировки.РучнаяКорректировка КАК РучнаяКорректировка,
	|	ВЫРАЗИТЬ(ДокументыБлокировки.Основание КАК СТРОКА(100)) КАК Основание,
	|	КОЛИЧЕСТВО(*) КАК Документов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыБлокировки.Мандат) КАК Мандатов,
	|	МИНИМУМ(ДокументыБлокировки.Дата) КАК ПерваяДата,
	|	МАКСИМУМ(ДокументыБлокировки.Дата) КАК ПоследняяДата
	|ИЗ
	|	Документ.БлокировкаРазблокировкаДС КАК ДокументыБлокировки
	|ГДЕ
	|	ДокументыБлокировки.Дата >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ДокументыБлокировки.Дата, ДЕНЬ),
	|	ДокументыБлокировки.ВидОперации,
	|	ДокументыБлокировки.ОбъектБлокировка,
	|	ДокументыБлокировки.Проведен,
	|	ДокументыБлокировки.ПометкаУдаления,
	|	ДокументыБлокировки.РучнаяКорректировка,
	|	ВЫРАЗИТЬ(ДокументыБлокировки.Основание КАК СТРОКА(100))
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 10
	|
	|УПОРЯДОЧИТЬ ПО
	|	День,
	|	Документов УБЫВ", Новый Структура("Начало", Начало), 300);

КонецПроцедуры

// Выводит регистрацию дополнительных обработок, связанных с блокировками и выгрузкой в ФО: версия, публикация,
// пометка удаления, и по каждой команде - регламентное задание: использование, расписание, последний запуск.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура РазделОбработки(Лог)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Обработки.Ссылка КАК Ссылка,
	|	Обработки.ИмяОбъекта КАК ИмяОбъекта,
	|	Обработки.Версия КАК Версия,
	|	Обработки.Публикация КАК Публикация,
	|	Обработки.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	Обработки.ИмяОбъекта В (&ИменаОбработок)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИмяОбъекта");
	ИменаОбработок = СтрРазделить("внСозданиеБлокировокДСНаВыплатыНДФЛВУК,ВнОбнулениеОстаткаБлокировок,"
		+ "внВыгрузкаОстатковМО_ФО,внРаботаСПереводамиВнутриДня,внСверкаФОМО_ФО", ",");
	Запрос.УстановитьПараметр("ИменаОбработок", ИменаОбработок);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Обработка");
	Таблица.Колонки.Добавить("Версия");
	Таблица.Колонки.Добавить("Публикация");
	Таблица.Колонки.Добавить("ПометкаУдаления");
	Таблица.Колонки.Добавить("Команда");
	Таблица.Колонки.Добавить("ЗаданиеИспользуется");
	Таблица.Колонки.Добавить("Расписание");
	Таблица.Колонки.Добавить("ПоследнийЗапуск");
	Пока Выборка.Следующий() Цикл
		ОбработкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если Не ЗначениеЗаполнено(ОбработкаОбъект.Команды) Тогда
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьСтрокуОбработки(НоваяСтрока, Выборка);
			Продолжить;
		КонецЕсли;
		Для Каждого Команда Из ОбработкаОбъект.Команды Цикл
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьСтрокуОбработки(НоваяСтрока, Выборка);
			НоваяСтрока.Команда = Команда.Представление;
			ЗаполнитьЗаданиеКоманды(НоваяСтрока, Команда.РегламентноеЗаданиеGUID);
		КонецЦикла;
	КонецЦикла;

	Лог.Добавить("");
	Лог.Добавить("--- 4.1. Обработки " + СтрСоединить(ИменаОбработок, ", "));
	ВывестиТаблицу(Лог, Таблица, 100);

КонецПроцедуры

// Переносит в строку отчета реквизиты обработки.
//
// Параметры:
//  НоваяСтрока - СтрокаТаблицыЗначений - строка отчета
//  Выборка - ВыборкаИзРезультатаЗапроса - текущая обработка
//
Процедура ЗаполнитьСтрокуОбработки(НоваяСтрока, Выборка)

	НоваяСтрока.Обработка       = Выборка.ИмяОбъекта;
	НоваяСтрока.Версия          = Выборка.Версия;
	НоваяСтрока.Публикация      = Выборка.Публикация;
	НоваяСтрока.ПометкаУдаления = Выборка.ПометкаУдаления;

КонецПроцедуры

// Заполняет в строке отчета регламентное задание команды: использование, расписание и начало последнего запуска.
//
// Параметры:
//  НоваяСтрока - СтрокаТаблицыЗначений - строка отчета
//  ИдентификаторЗадания - УникальныйИдентификатор - идентификатор регламентного задания команды
//
Процедура ЗаполнитьЗаданиеКоманды(НоваяСтрока, ИдентификаторЗадания)

	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		НоваяСтрока.ЗаданиеИспользуется = "нет задания";
		Возврат;
	КонецЕсли;
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		НоваяСтрока.ЗаданиеИспользуется = "задание не найдено";
		Возврат;
	КонецЕсли;
	НоваяСтрока.ЗаданиеИспользуется = Задание.Использование;
	НоваяСтрока.Расписание = Строка(Задание.Расписание);
	Последнее = Задание.ПоследнееЗадание;
	Если Последнее <> Неопределено Тогда
		НоваяСтрока.ПоследнийЗапуск = Последнее.Начало;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет запрос, выводит время выполнения, число строк и таблицу результата. Ошибка запроса
// выводится в лог и не прерывает сбор.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Заголовок - Строка - заголовок блока
//  ТекстЗапроса - Строка - текст запроса
//  Параметры - Структура - параметры запроса
//  МаксимумСтрок - Число - предел выводимых строк
//  КолонкаПользователя - Строка - колонка со ссылкой на пользователя, выводится маской (кроме служебных svc)
//
Процедура ВывестиЗапрос(Лог, Заголовок, ТекстЗапроса, Параметры, МаксимумСтрок = 100, КолонкаПользователя = "")

	Лог.Добавить("");
	Лог.Добавить("--- " + Заголовок);
	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Попытка
		НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Таблица = Запрос.Выполнить().Выгрузить();
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса;
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Лог.Добавить(СтрШаблон("Время запроса: %1 мс; строк: %2", ФорматЧисла(Длительность), ФорматЧисла(Таблица.Количество())));
	ВывестиТаблицу(Лог, Таблица, МаксимумСтрок, КолонкаПользователя);

КонецПроцедуры

// Выводит таблицу значений строками с разделителем " | ".
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Таблица - ТаблицаЗначений - данные
//  МаксимумСтрок - Число - предел выводимых строк
//  КолонкаПользователя - Строка - колонка, значения которой выводятся маской пользователя
//
Процедура ВывестиТаблицу(Лог, Таблица, МаксимумСтрок, КолонкаПользователя = "")

	Имена = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;
	Лог.Добавить(СтрСоединить(Имена, " | "));

	Номер = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Номер = Номер + 1;
		Если Номер > МаксимумСтрок Тогда
			Лог.Добавить("... еще строк: " + ФорматЧисла(Таблица.Количество() - МаксимумСтрок));
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если Колонка.Имя = КолонкаПользователя Тогда
				Значения.Добавить(МаскаПользователя(СтрокаТаблицы[Колонка.Имя]));
			Иначе
				Значения.Добавить(ЗначениеСтрокой(СтрокаТаблицы[Колонка.Имя]));
			КонецЕсли;
		КонецЦикла;
		Лог.Добавить(СтрСоединить(Значения, " | "));
	КонецЦикла;

КонецПроцедуры

// Возвращает представление пользователя для лога: служебные учетные записи (svc) - как есть, остальные - маской,
// чтобы в лог не попадали имена сотрудников.
//
// Параметры:
//  Значение - СправочникСсылка.Пользователи, Произвольный - автор
//
// Возвращаемое значение:
//  Строка - имя служебной учетной записи или "<пользователь>"
//
Функция МаскаПользователя(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "-";
	КонецЕсли;
	Представление = СокрЛП(Строка(Значение));
	Если СтрНайти(НРег(Представление), "svc") > 0 Тогда
		Возврат Представление;
	КонецЕсли;
	Возврат "<пользователь>";

КонецФункции

// Возвращает представление значения для лога.
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ЗначениеСтрокой(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧРД=.");
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'; ДП=-");
	ИначеЕсли Тип = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Возвращает число без разделителей групп, ноль как "0".
//
// Параметры:
//  Значение - Число - число
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ФорматЧисла(Значение)

	Возврат Формат(Значение, "ЧН=0; ЧГ=0");

КонецФункции

// Возвращает имя информационной базы на сервере 1С из строки соединения.
//
// Возвращаемое значение:
//  Строка - имя базы или строка соединения целиком для файловой базы
//
Функция ИмяБазы()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Позиция = СтрНайти(СтрокаСоединения, "Ref=");
	Если Позиция = 0 Тогда
		Возврат СтрокаСоединения;
	КонецЕсли;
	Остаток = Сред(СтрокаСоединения, Позиция + 5);
	Возврат Лев(Остаток, СтрНайти(Остаток, """") - 1);

КонецФункции

// Добавляет заголовок раздела.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Заголовок - Строка - заголовок
//
Процедура ДобавитьРаздел(Лог, Заголовок)

	Лог.Добавить("");
	Лог.Добавить("==================== " + Заголовок);

КонецПроцедуры

// Добавляет в лог краткое представление ошибки.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Информация - ИнформацияОбОшибке - ошибка
//
Процедура ДобавитьОшибку(Лог, Информация)

	Лог.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(Информация));

КонецПроцедуры

#КонецОбласти

#КонецЕсли
