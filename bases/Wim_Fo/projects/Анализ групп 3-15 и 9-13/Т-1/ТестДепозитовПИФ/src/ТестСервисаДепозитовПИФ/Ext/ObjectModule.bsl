// Тест сервиса депозитов ПИФ (веб-сервис deposits, операция getDeposits) из базы ФО на копии Т-1: вызывает
// getDeposits по адресу и учетной записи из настроек обработки загрузки депозитов, замеряет время каждого вызова и
// выводит ответ построчно с контрольными суммами. Запускается до и после установки расширения в базе ПИФ; два лога
// сравниваются: время - ускорение, контрольные суммы и строки - регресс. Данные баз ФО и ПИФ не меняются. Адрес и
// учетная запись сервиса в лог не выводятся, наименование депозита - только контрольной суммой.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Вызывает getDeposits заданное число раз и собирает лог.
//
// Параметры:
//  ДатаЗапроса - Дата - дата, на которую запрашиваются депозиты; в прогонах до и после - одна и та же
//  ЧислоВызовов - Число - число вызовов подряд, 1-5
//  Метка - Строка - метка прогона (до, после), выводится в лог
//  АдресСервиса - Строка - адрес описания сервиса; пусто - из настроек обработки загрузки депозитов
//  Логин - Строка, Неопределено - учетная запись сервиса; Неопределено - из настроек обработки
//  Пароль - Строка, Неопределено - пароль учетной записи; Неопределено - из настроек обработки
//
// Возвращаемое значение:
//  Строка - текст лога
//
Функция СобратьЛог(ДатаЗапроса, ЧислоВызовов, Метка, АдресСервиса = "", Логин = Неопределено,
	Пароль = Неопределено) Экспорт

	Лог = Новый Массив;
	НачалоСбора = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Вызовов = Макс(1, Мин(5, ЧислоВызовов));

	// Привилегированный режим нужен для чтения настроек дополнительной обработки загрузки депозитов.
	Попытка
		УстановитьПривилегированныйРежим(Истина);
	Исключение
		Лог.Добавить("Привилегированный режим не установлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ДобавитьРаздел(Лог, "0. Общие сведения");
	Лог.Добавить("Версия теста: 1 (29.10.2026)");
	Лог.Добавить("Метка прогона: " + Метка);
	Лог.Добавить("Дата сбора: " + ЗначениеСтрокой(ТекущаяДатаСеанса()));
	Лог.Добавить("База: " + ИмяБазы());
	Лог.Добавить("Дата запроса getDeposits: " + Формат(ДатаЗапроса, "ДФ=dd.MM.yyyy"));
	Лог.Добавить("Число вызовов: " + ФорматЧисла(Вызовов));

	Подключение = ПараметрыПодключения(Лог, АдресСервиса, Логин, Пароль);
	Если Подключение = Неопределено Тогда
		Возврат СтрСоединить(Лог, Символы.ПС);
	КонецЕсли;

	Попытка
		ВыполнитьВызовы(Лог, Подключение, ДатаЗапроса, Вызовов, Метка);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	Лог.Добавить("");
	Лог.Добавить("Сбор завершен за " + ФорматЧисла(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСбора) + " мс");

	УстановитьПривилегированныйРежим(Ложь);

	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

// Возвращает адрес описания сервиса ПИФ из настроек обработки загрузки депозитов - для показа на форме.
//
// Возвращаемое значение:
//  Строка - адрес или пустая строка, если настроек нет
//
Функция АдресСервисаИзНастроек() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Адрес = ЗначениеНастройки(НастройкиОбработки("внЗагрузкаДепозитовИзВнешнихИсточников"), "ВебСервисПИФ");
	УстановитьПривилегированныйРежим(Ложь);
	Если ЗначениеЗаполнено(Адрес) Тогда
		Возврат Адрес;
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#Область ВызовыСервиса

// Определяет адрес и учетную запись сервиса ПИФ и выводит в лог их источник и отпечаток адреса: по отпечатку видно,
// что прогоны до и после шли к одному и тому же сервису.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  АдресСервиса - Строка - адрес, заданный явно, или пусто
//  Логин - Строка, Неопределено - учетная запись, заданная явно
//  Пароль - Строка, Неопределено - пароль, заданный явно
//
// Возвращаемое значение:
//  Структура, Неопределено - Адрес, Логин, Пароль; Неопределено, если адрес не найден
//
Функция ПараметрыПодключения(Лог, АдресСервиса, Логин, Пароль)

	Подключение = Новый Структура("Адрес, Логин, Пароль", АдресСервиса, Логин, Пароль);
	АдресИзНастроек = АдресСервисаИзНастроек();
	Если Не ЗначениеЗаполнено(АдресСервиса) Тогда
		ИсточникАдреса = "настройки обработки загрузки депозитов";
	ИначеЕсли АдресСервиса = АдресИзНастроек Тогда
		ИсточникАдреса = "форма, совпадает с настройками обработки загрузки депозитов";
	Иначе
		ИсточникАдреса = "форма, ОТЛИЧАЕТСЯ от настроек обработки загрузки депозитов";
	КонецЕсли;
	Источник = "заданы явно";
	Если Не ЗначениеЗаполнено(Подключение.Адрес) Или Подключение.Логин = Неопределено Тогда
		Настройки = НастройкиОбработки("внЗагрузкаДепозитовИзВнешнихИсточников");
		Если Настройки = Неопределено Тогда
			Лог.Добавить("ОШИБКА: настройки обработки загрузки депозитов не найдены");
			Возврат Неопределено;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Подключение.Адрес) Тогда
			Подключение.Адрес = ЗначениеНастройки(Настройки, "ВебСервисПИФ");
		КонецЕсли;
		Если Подключение.Логин = Неопределено Тогда
			Подключение.Логин = ЗначениеНастройки(Настройки, "Логин");
			Подключение.Пароль = ЗначениеНастройки(Настройки, "Пароль");
		КонецЕсли;
		Источник = "настройки обработки загрузки депозитов";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Подключение.Адрес) Тогда
		Лог.Добавить("ОШИБКА: адрес сервиса ПИФ не задан");
		Возврат Неопределено;
	КонецЕсли;

	Лог.Добавить("Адрес сервиса: " + ИсточникАдреса + "; учетная запись: " + Источник + "; отпечаток адреса: "
		+ Лев(КонтрольнаяСумма(Подключение.Адрес), 8));
	Возврат Подключение;

КонецФункции

// Получает описание сервиса, вызывает getDeposits заданное число раз и выводит время вызовов, сверку ответов между
// собой, итоговую строку для сравнения прогонов и ответ первого успешного вызова построчно.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Подключение - Структура - Адрес, Логин, Пароль
//  ДатаЗапроса - Дата - дата запроса
//  Вызовов - Число - число вызовов
//  Метка - Строка - метка прогона
//
Процедура ВыполнитьВызовы(Лог, Подключение, ДатаЗапроса, Вызовов, Метка)

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Определения = Новый WSОпределения(Подключение.Адрес, Подключение.Логин, Подключение.Пароль, , 120);
	ВремяОпределения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
	Сервис = Определения.Сервисы[0];
	Прокси = Новый WSПрокси(Определения, Сервис.URIПространстваИмен, Сервис.Имя, Сервис.ТочкиПодключения[0].Имя, ,
		3600);
	Прокси.Пользователь = Подключение.Логин;
	Прокси.Пароль = Подключение.Пароль;
	Лог.Добавить("Получение описания сервиса: " + ФорматЧисла(ВремяОпределения) + " мс");

	Вызовы = Новый ТаблицаЗначений;
	Вызовы.Колонки.Добавить("Вызов");
	Вызовы.Колонки.Добавить("ВремяМс");
	Вызовы.Колонки.Добавить("Депозитов");
	Вызовы.Колонки.Добавить("КонтрольнаяСуммаОтвета");
	Вызовы.Колонки.Добавить("СовпадаетСПервым");
	Вызовы.Колонки.Добавить("Ошибка");

	ПервыйОтвет = Неопределено;
	Для Номер = 1 По Вызовов Цикл
		СтрокаВызова = Вызовы.Добавить();
		СтрокаВызова.Вызов = Номер;
		НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			Ответ = Прокси.getDeposits(ДатаЗапроса);
			СтрокаВызова.ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
			Депозиты = ТаблицаДепозитов(Ответ);
		Исключение
			СтрокаВызова.ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
			СтрокаВызова.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Продолжить;
		КонецПопытки;
		СтрокаВызова.Депозитов = Депозиты.Таблица.Количество();
		СтрокаВызова.КонтрольнаяСуммаОтвета = Депозиты.КонтрольнаяСумма;
		Если ПервыйОтвет = Неопределено Тогда
			ПервыйОтвет = Депозиты;
			СтрокаВызова.СовпадаетСПервым = "-";
		ИначеЕсли Депозиты.КонтрольнаяСумма = ПервыйОтвет.КонтрольнаяСумма Тогда
			СтрокаВызова.СовпадаетСПервым = "Да";
		Иначе
			СтрокаВызова.СовпадаетСПервым = "НЕТ";
		КонецЕсли;
	КонецЦикла;

	ДобавитьРаздел(Лог, "1. Вызовы getDeposits");
	ВывестиТаблицу(Лог, Вызовы, 10);

	ДобавитьРаздел(Лог, "2. Итог для сравнения прогонов");
	Лог.Добавить(ИтоговаяСтрока(Вызовы, ПервыйОтвет, Метка));

	Если ПервыйОтвет = Неопределено Тогда
		Лог.Добавить("Ни один вызов не завершился успешно, ответ не выводится");
		Возврат;
	КонецЕсли;

	ДобавитьРаздел(Лог, "3. Ответ первого успешного вызова по депозитам (упорядочено по id)");
	Лог.Добавить("Наименование выводится контрольной суммой; КонтрольнаяСуммаСтроки считается по всем полям,"
		+ " включая наименование");
	ВывестиТаблицу(Лог, ПервыйОтвет.Таблица, 1000);

	ДобавитьРаздел(Лог, "4. Итоги по числовым полям ответа");
	ВывестиТаблицу(Лог, ИтогиЧисловыхПолей(ПервыйОтвет.Таблица), 50);

КонецПроцедуры

// Раскладывает ответ getDeposits в таблицу: по колонке на каждое поле депозита в порядке схемы сервиса и
// колонка КонтрольнаяСуммаСтроки. Значения - в каноническом XML-представлении, чтобы прогоны сравнивались
// независимо от формата чисел и дат.
//
// Параметры:
//  Ответ - ОбъектXDTO, Неопределено - ответ getDeposits
//
// Возвращаемое значение:
//  Структура - результат разбора:
//   * Таблица - ТаблицаЗначений - депозиты, упорядочены по id
//   * КонтрольнаяСумма - Строка - контрольная сумма всего ответа (по контрольным суммам строк в порядке id)
//
Функция ТаблицаДепозитов(Ответ)

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Депозит Из СписокДепозитов(Ответ) Цикл
		Если Таблица.Колонки.Количество() = 0 Тогда
			Для Каждого Свойство Из Депозит.Свойства() Цикл
				Таблица.Колонки.Добавить(Свойство.Имя);
			КонецЦикла;
			Таблица.Колонки.Добавить("КонтрольнаяСуммаСтроки");
		КонецЕсли;
		НоваяСтрока = Таблица.Добавить();
		Части = Новый Массив;
		Для Каждого Свойство Из Депозит.Свойства() Цикл
			Значение = КаноническоеЗначение(Депозит.Получить(Свойство));
			Части.Добавить(Свойство.Имя + "=" + Значение);
			Если Свойство.Имя = "name" Тогда
				НоваяСтрока[Свойство.Имя] = "#" + Лев(КонтрольнаяСумма(Значение), 10);
			Иначе
				НоваяСтрока[Свойство.Имя] = Значение;
			КонецЕсли;
		КонецЦикла;
		НоваяСтрока.КонтрольнаяСуммаСтроки = Лев(КонтрольнаяСумма(СтрСоединить(Части, "|")), 12);
	КонецЦикла;

	Если Таблица.Колонки.Найти("id") <> Неопределено Тогда
		Таблица.Сортировать("id, КонтрольнаяСуммаСтроки");
	КонецЕсли;
	СуммыСтрок = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СуммыСтрок.Добавить(СтрокаТаблицы.КонтрольнаяСуммаСтроки);
	КонецЦикла;
	Возврат Новый Структура("Таблица, КонтрольнаяСумма", Таблица,
		Лев(КонтрольнаяСумма(СтрСоединить(СуммыСтрок, ";")), 16));

КонецФункции

// Возвращает элементы deposit ответа getDeposits массивом: свойство deposit бывает одиночным объектом или списком.
//
// Параметры:
//  Ответ - ОбъектXDTO, Неопределено - ответ сервиса
//
// Возвращаемое значение:
//  Массив из ОбъектXDTO - депозиты ответа
//
Функция СписокДепозитов(Ответ)

	Результат = Новый Массив;
	Если ТипЗнч(Ответ) <> Тип("ОбъектXDTO") Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Депозиты = Ответ.deposit;
	Исключение
		Возврат Результат;
	КонецПопытки;
	Если ТипЗнч(Депозиты) = Тип("ОбъектXDTO") Тогда
		Результат.Добавить(Депозиты);
	ИначеЕсли ТипЗнч(Депозиты) = Тип("СписокXDTO") Тогда
		Для Каждого Депозит Из Депозиты Цикл
			Результат.Добавить(Депозит);
		КонецЦикла;
	Иначе
		Возврат Результат;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает каноническое строковое представление значения поля XDTO.
//
// Параметры:
//  Значение - Произвольный - значение свойства объекта XDTO
//
// Возвращаемое значение:
//  Строка - XML-представление значения, пустая строка для неопределенного
//
Функция КаноническоеЗначение(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("ЗначениеXDTO") Тогда
		Возврат Значение.ЛексическоеЗначение;
	ИначеЕсли ТипЗнч(Значение) = Тип("ОбъектXDTO") Тогда
		Возврат "<объект>";
	Иначе
		Возврат XMLСтрока(Значение);
	КонецЕсли;

КонецФункции

// Возвращает строку итога прогона в одном формате для сравнения: метка, число вызовов и успешных, время
// минимальное, среднее и максимальное, число депозитов и контрольная сумма ответа первого успешного вызова.
//
// Параметры:
//  Вызовы - ТаблицаЗначений - результаты вызовов
//  ПервыйОтвет - Структура, Неопределено - разбор первого успешного ответа
//  Метка - Строка - метка прогона
//
// Возвращаемое значение:
//  Строка - итоговая строка
//
Функция ИтоговаяСтрока(Вызовы, ПервыйОтвет, Метка)

	Времена = Новый Массив;
	Для Каждого СтрокаВызова Из Вызовы Цикл
		Если Не ЗначениеЗаполнено(СтрокаВызова.Ошибка) Тогда
			Времена.Добавить(СтрокаВызова.ВремяМс);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Времена) Тогда
		Минимум = Времена[0];
		Максимум = Времена[0];
		Сумма = 0;
		Для Каждого Время Из Времена Цикл
			Минимум = Мин(Минимум, Время);
			Максимум = Макс(Максимум, Время);
			Сумма = Сумма + Время;
		КонецЦикла;
		Среднее = Окр(Сумма / Времена.Количество());
	Иначе
		Минимум = 0;
		Максимум = 0;
		Среднее = 0;
	КонецЕсли;
	Депозитов = 0;
	Сумма = "-";
	Если ПервыйОтвет <> Неопределено Тогда
		Депозитов = ПервыйОтвет.Таблица.Количество();
		Сумма = ПервыйОтвет.КонтрольнаяСумма;
	КонецЕсли;
	Возврат СтрШаблон("ИТОГ | метка=%1 | вызовов=%2 | успешных=%3 | мин_мс=%4 | среднее_мс=%5 | макс_мс=%6"
		+ " | депозитов=%7 | контрольная_сумма=%8",
		Метка, ФорматЧисла(Вызовы.Количество()), ФорматЧисла(Времена.Количество()), ФорматЧисла(Минимум),
		ФорматЧисла(Среднее), ФорматЧисла(Максимум), ФорматЧисла(Депозитов), Сумма);

КонецФункции

// Считает по каждому числовому полю ответа сумму значений; поля, у которых не все значения - числа, пропускаются.
//
// Параметры:
//  Таблица - ТаблицаЗначений - депозиты ответа, значения - строки
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Поле, Сумма, Значений
//
Функция ИтогиЧисловыхПолей(Таблица)

	Итоги = Новый ТаблицаЗначений;
	Итоги.Колонки.Добавить("Поле");
	Итоги.Колонки.Добавить("Сумма");
	Итоги.Колонки.Добавить("Значений");
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.Имя = "id" Или Колонка.Имя = "name" Или Колонка.Имя = "КонтрольнаяСуммаСтроки" Тогда
			Продолжить;
		КонецЕсли;
		Сумма = 0;
		ВсеЧисла = Истина;
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Значение = СтрокаТаблицы[Колонка.Имя];
			Если Не ЭтоЧисло(Значение) Тогда
				ВсеЧисла = Ложь;
				Прервать;
			КонецЕсли;
			Сумма = Сумма + ОписаниеЧисла.ПривестиЗначение(Значение);
		КонецЦикла;
		Если ВсеЧисла И ЗначениеЗаполнено(Таблица) Тогда
			НоваяСтрока = Итоги.Добавить();
			НоваяСтрока.Поле = Колонка.Имя;
			НоваяСтрока.Сумма = Сумма;
			НоваяСтрока.Значений = Таблица.Количество();
		КонецЕсли;
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Проверяет, что строка - запись числа в XML-представлении (цифры, точка, минус).
//
// Параметры:
//  Значение - Строка - значение поля
//
// Возвращаемое значение:
//  Булево - Истина, если строка - число
//
Функция ЭтоЧисло(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если СтрНайти("0123456789.-", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Возвращает контрольную сумму MD5 строки в шестнадцатеричном виде.
//
// Параметры:
//  Текст - Строка - исходная строка
//
// Возвращаемое значение:
//  Строка - 32 шестнадцатеричных символа
//
Функция КонтрольнаяСумма(Текст)

	Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеширование.Добавить(Текст);
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает настройки дополнительной обработки по имени объекта.
//
// Параметры:
//  ИмяОбъекта - Строка - имя объекта обработки
//
// Возвращаемое значение:
//  Структура, Неопределено - настройки или Неопределено, если обработки или настроек нет
//
Функция НастройкиОбработки(ИмяОбъекта)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обр
	|ГДЕ
	|	Обр.ИмяОбъекта = &ИмяОбъекта
	|	И НЕ Обр.ПометкаУдаления");
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Настройки = Выборка.Ссылка.ХранилищеНастроек.Получить();
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Возврат Настройки;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Возвращает значение из структуры настроек.
//
// Параметры:
//  Настройки - Структура, Неопределено - настройки обработки
//  ИмяНастройки - Строка - имя настройки
//
// Возвращаемое значение:
//  Произвольный - значение или Неопределено
//
Функция ЗначениеНастройки(Настройки, ИмяНастройки)

	Значение = Неопределено;
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки.Свойство(ИмяНастройки, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Выводит таблицу значений строками с разделителем " | ".
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Таблица - ТаблицаЗначений - данные
//  МаксимумСтрок - Число - предел выводимых строк
//  КолонкаПользователя - Строка - колонка, значения которой выводятся маской пользователя
//
Процедура ВывестиТаблицу(Лог, Таблица, МаксимумСтрок, КолонкаПользователя = "")

	Имена = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;
	Лог.Добавить(СтрСоединить(Имена, " | "));

	Номер = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Номер = Номер + 1;
		Если Номер > МаксимумСтрок Тогда
			Лог.Добавить("... еще строк: " + ФорматЧисла(Таблица.Количество() - МаксимумСтрок));
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если Колонка.Имя = КолонкаПользователя Тогда
				Значения.Добавить(МаскаПользователя(СтрокаТаблицы[Колонка.Имя]));
			Иначе
				Значения.Добавить(ЗначениеСтрокой(СтрокаТаблицы[Колонка.Имя]));
			КонецЕсли;
		КонецЦикла;
		Лог.Добавить(СтрСоединить(Значения, " | "));
	КонецЦикла;

КонецПроцедуры

// Возвращает представление пользователя для лога: служебные учетные записи (svc) - как есть, остальные - маской,
// чтобы в лог не попадали имена сотрудников.
//
// Параметры:
//  Значение - СправочникСсылка.Пользователи, Произвольный - автор
//
// Возвращаемое значение:
//  Строка - имя служебной учетной записи или "<пользователь>"
//
Функция МаскаПользователя(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "-";
	КонецЕсли;
	Представление = СокрЛП(Строка(Значение));
	Если СтрНайти(НРег(Представление), "svc") > 0 Тогда
		Возврат Представление;
	КонецЕсли;
	Возврат "<пользователь>";

КонецФункции

// Возвращает представление значения для лога.
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ЗначениеСтрокой(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧРД=.");
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'; ДП=-");
	ИначеЕсли Тип = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Возвращает число без разделителей групп, ноль как "0".
//
// Параметры:
//  Значение - Число - число
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ФорматЧисла(Значение)

	Возврат Формат(Значение, "ЧН=0; ЧГ=0");

КонецФункции

// Возвращает имя информационной базы на сервере 1С из строки соединения.
//
// Возвращаемое значение:
//  Строка - имя базы или строка соединения целиком для файловой базы
//
Функция ИмяБазы()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Позиция = СтрНайти(СтрокаСоединения, "Ref=");
	Если Позиция = 0 Тогда
		Возврат СтрокаСоединения;
	КонецЕсли;
	Остаток = Сред(СтрокаСоединения, Позиция + 5);
	Возврат Лев(Остаток, СтрНайти(Остаток, """") - 1);

КонецФункции

// Добавляет заголовок раздела.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Заголовок - Строка - заголовок
//
Процедура ДобавитьРаздел(Лог, Заголовок)

	Лог.Добавить("");
	Лог.Добавить("==================== " + Заголовок);

КонецПроцедуры

// Добавляет в лог краткое представление ошибки.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Информация - ИнформацияОбОшибке - ошибка
//
Процедура ДобавитьОшибку(Лог, Информация)

	Лог.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(Информация));

КонецПроцедуры

