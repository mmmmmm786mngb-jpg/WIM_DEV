#Область ОбработчикиСобытийФормы

// Заполняет значения по умолчанию: дата запроса - текущая, два вызова, адрес сервиса депозитов ПИФ Т-1, строка
// соединения базы.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаЗапроса      = НачалоДня(ТекущаяДатаСеанса());
	ЧислоВызовов     = 2;
	Метка            = "до";
	АдресСервиса     = РеквизитФормыВЗначение("Объект").АдресСервисаПИФТ1();
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Вызывает сервис депозитов ПИФ и собирает лог на сервере. Данные базы не меняются.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Собрать(Команда)

	Если Не ЗначениеЗаполнено(АдресСервиса) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите адрес сервиса ПИФ", , "АдресСервиса");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Метка) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите метку прогона, например: до или после", , "Метка");
		Возврат;
	КонецЕсли;
	Результат = "Выполняется вызов сервиса...";
	СобратьНаСервере();

КонецПроцедуры

// Сохраняет текст лога в файл на компьютере пользователя (UTF-8), метка прогона попадает в имя файла.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(Результат) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала соберите лог");
		Возврат;
	КонецЕсли;

	ИмяФайла = "ТестДепозитовПИФ_" + Метка + "_" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt";
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресФайла(), ИмяФайла);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет вызовы сервиса модулем объекта и помещает текст лога в реквизит Результат.
//
&НаСервере
Процедура СобратьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.СобратьЛог(ДатаЗапроса, ЧислоВызовов, Метка, АдресСервиса);

КонецПроцедуры

// Помещает текст лога во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла (UTF-8 без BOM)
//
&НаСервере
Функция АдресФайла()

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Результат, "UTF-8", Ложь);
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
