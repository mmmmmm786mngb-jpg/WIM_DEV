#Область ОбработчикиСобытийФормы

// Заполняет дату запроса текущей датой, включает повтор исходного запроса и выводит строку соединения базы.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаЗапроса       = ТекущаяДатаСеанса();
	ПовторитьИсходный = Истина;
	СтрокаСоединения  = СтрокаСоединенияИнформационнойБазы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Собирает лог диагностики на сервере. Данные базы не меняются.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Собрать(Команда)

	Если Не ЗначениеЗаполнено(ДатаЗапроса) Тогда
		ПоказатьПредупреждение(, "Укажите дату запроса");
		Возврат;
	КонецЕсли;
	Результат = "Выполняется сбор...";
	СобратьНаСервере();

КонецПроцедуры

// Сохраняет текст лога в файл на компьютере пользователя (UTF-8).
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(Результат) Тогда
		ПоказатьПредупреждение(, "Сначала соберите лог");
		Возврат;
	КонецЕсли;

	// В базе ПИФ нет модуля ФайловаяСистемаКлиент; модальность в конфигурации разрешена.
	ИмяФайла = "Диагностика_ПИФ_депозиты_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmm") + ".txt";
	ПолучитьФайл(АдресФайла(), ИмяФайла, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет сбор лога модулем объекта и помещает текст в реквизит Результат.
//
&НаСервере
Процедура СобратьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.СобратьЛог(ДатаЗапроса, СокрЛП(ПользовательСервиса), ПовторитьИсходный, ПодсчетПроводок);

КонецПроцедуры

// Помещает текст лога во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла (UTF-8 без BOM)
//
&НаСервере
Функция АдресФайла()

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Результат, "UTF-8", Ложь);
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
