// IMDEV-9746. Сравнение версий обработки распространения правил лимитов на копии Т-1: рабочая версия из справочника
// дополнительных обработок и версия 1.17 (макет Версия117) на одних и тех же реальных клиентах.
// Перед каждым запуском клиент приводится к состоянию нового клиента: снимается проведение его установок лимитов по
// классам распространения, удаляются его пороги по лимитам этих классов и сведения автоустановки. Распространение
// вызывается так же, как из обработки "Операции после обмена"; письма отправляются по настройкам рассылки.
// На время теста рабочей обработке задаются настройки теста (только тип клиентов теста, текущий пользователь - в списке
// сервисных), на время запуска 1.17 - обработка 1.17. Исходное состояние сохраняется в хранилище общих настроек
// и возвращается в конце теста или командой восстановления. Клиенты в логе - только внешними кодами портфелей.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем Лог; // Массив из Строка - строки лога теста
Перем УчтенныеЗамеры; // Соответствие - замеры, уже отнесенные к запускам: ключевая операция -> сеанс -> начало замера

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает сведения для формы перед запуском: режим базы, версию рабочей обработки, адреса рассылок.
//
// Возвращаемое значение:
//  Структура:
//   * Режим - Строка - "обычный ФО" или "розница"
//   * ВерсияРабочей - Строка - версия рабочей обработки в справочнике
//   * АдресаРассылок - Строка - настройки рассылки, используемые обработкой, и их адресаты
//   * КлиентовНаЗапуск - Число - 1 для обычного ФО, 2 для розницы
//   * Ошибка - Строка - текст ошибки, если рабочая обработка или ее настройки не найдены
//
Функция СведенияДляФормы() Экспорт

	Результат = Новый Структура("Режим, ВерсияРабочей, АдресаРассылок, КлиентовНаЗапуск, Ошибка", "", "", "", 1, "");
	Попытка
		Контекст = КонтекстТеста();
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если Контекст.Розница Тогда
		Результат.Режим = "розница";
		Результат.КлиентовНаЗапуск = 2;
	Иначе
		Результат.Режим = "обычный ФО";
	КонецЕсли;
	Результат.ВерсияРабочей = Контекст.ВерсияРабочей;
	Результат.АдресаРассылок = АдресаРассылок(Контекст);
	Возврат Результат;

КонецФункции

// Подбирает клиентов для теста: недавно распространенные портфели, у которых по каждому классу распространения ровно
// одна действующая установка лимитов по самому портфелю, есть пороги, тип клиента входит в рабочий список типов,
// в обычном ФО у стратегии есть эталон с автосозданием установок, в рознице заполнены внешние коды эталонов.
//
// Параметры:
//  Количество - Число - сколько клиентов вернуть
//
// Возвращаемое значение:
//  Строка - строки "внешний код портфеля<TAB>дата автоустановки", новые сначала
//
Функция ПодобратьКлиентов(Количество) Экспорт

	Контекст = КонтекстТеста();
	КлассКомплаенс = Контекст.Классы[0];

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 300
	|	Сведения.Объект КАК Портфель,
	|	ВЫРАЗИТЬ(Сведения.Значение КАК Дата) КАК ДатаАвтоустановки
	|ПОМЕСТИТЬ ВТКандидаты
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Сведения
	|ГДЕ
	|	Сведения.Свойство = &СвойствоДата
	|	И Сведения.Объект ССЫЛКА Справочник.Портфели
	|	И ВЫРАЗИТЬ(Сведения.Значение КАК Дата) >= &НачалоПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаАвтоустановки УБЫВ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Портфель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Кандидаты.Портфель КАК Портфель,
	|	Кандидаты.ДатаАвтоустановки КАК ДатаАвтоустановки,
	|	ВЫРАЗИТЬ(Кандидаты.Портфель КАК Справочник.Портфели).ВнешнийКод КАК Код,
	|	ВЫРАЗИТЬ(Кандидаты.Портфель КАК Справочник.Портфели).ТипКлиента КАК ТипКлиента,
	|	ВЫРАЗИТЬ(Кандидаты.Портфель КАК Справочник.Портфели).ПометкаУдаления КАК ПометкаУдаления,
	|	ЕСТЬNULL(ЭталоныСтратегий.ПрименятьАвтосозданиеУстановокЛимитов, ЛОЖЬ) КАК Автосоздание
	|ИЗ
	|	ВТКандидаты КАК Кандидаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВТБ_ЭталонныйПортфельСтратегии КАК ЭталоныСтратегий
	|		ПО (ВЫРАЗИТЬ(Кандидаты.Портфель КАК Справочник.Портфели).Стратегия = ЭталоныСтратегий.Стратегия)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаАвтоустановки УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Действующие.Портфель КАК Портфель,
	|	Действующие.КлассЛимита КАК КлассЛимита,
	|	Действующие.Регистратор КАК Регистратор,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Действующие.Регистратор ССЫЛКА Документ.УстановкаЛимитов
	|					И ВЫРАЗИТЬ(Действующие.Регистратор КАК Документ.УстановкаЛимитов).ВидОперации
	|						= ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЛимитов.ПоПортфелю)
	|					И ВЫРАЗИТЬ(Действующие.Регистратор КАК Документ.УстановкаЛимитов).ОбъектНазначения
	|						= Действующие.Портфель
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ПоПортфелю
	|ИЗ
	|	РегистрСведений.ДействующиеЛимитыПоПортфелю КАК Действующие
	|ГДЕ
	|	Действующие.Портфель В
	|			(ВЫБРАТЬ
	|				Кандидаты.Портфель
	|			ИЗ
	|				ВТКандидаты КАК Кандидаты)
	|	И Действующие.КлассЛимита В(&Классы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Действующие.Портфель,
	|	Действующие.КлассЛимита,
	|	Действующие.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Пороги.Портфель КАК Портфель,
	|	КОЛИЧЕСТВО(*) КАК Порогов
	|ИЗ
	|	РегистрСведений.ПорогиЛимитов КАК Пороги
	|ГДЕ
	|	Пороги.Портфель В
	|			(ВЫБРАТЬ
	|				Кандидаты.Портфель
	|			ИЗ
	|				ВТКандидаты КАК Кандидаты)
	|	И Пороги.Лимит.КлассЛимита В(&Классы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Пороги.Портфель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Сведения.Объект КАК Портфель,
	|	Сведения.Свойство КАК Свойство
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Сведения
	|ГДЕ
	|	Сведения.Объект В
	|			(ВЫБРАТЬ
	|				Кандидаты.Портфель
	|			ИЗ
	|				ВТКандидаты КАК Кандидаты)
	|	И Сведения.Свойство В(&СвойстваНаличия)";
	Запрос.УстановитьПараметр("СвойствоДата", КлассКомплаенс.СвойствоДата);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ТекущаяДатаСеанса()) - 120 * 86400);
	Запрос.УстановитьПараметр("Классы", Контекст.СписокКлассов);
	Запрос.УстановитьПараметр("СвойстваНаличия", Контекст.СвойстваНаличия);
	Результаты = Запрос.ВыполнитьПакет();

	Регистраторы = Новый Соответствие;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоКлассам = Регистраторы[Выборка.Портфель];
		Если ПоКлассам = Неопределено Тогда
			ПоКлассам = Новый Соответствие;
			Регистраторы.Вставить(Выборка.Портфель, ПоКлассам);
		КонецЕсли;
		СписокРегистраторов = ПоКлассам[Выборка.КлассЛимита];
		Если СписокРегистраторов = Неопределено Тогда
			СписокРегистраторов = Новый Массив;
			ПоКлассам.Вставить(Выборка.КлассЛимита, СписокРегистраторов);
		КонецЕсли;
		СписокРегистраторов.Добавить(Выборка.ПоПортфелю);
	КонецЦикла;

	Пороги = Новый Соответствие;
	Выборка = Результаты[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Пороги.Вставить(Выборка.Портфель, Выборка.Порогов);
	КонецЦикла;

	Сведения = Новый Соответствие;
	Выборка = Результаты[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		ЕстьСвойства = Сведения[Выборка.Портфель];
		Если ЕстьСвойства = Неопределено Тогда
			ЕстьСвойства = Новый Соответствие;
			Сведения.Вставить(Выборка.Портфель, ЕстьСвойства);
		КонецЕсли;
		ЕстьСвойства.Вставить(Выборка.Свойство, Истина);
	КонецЦикла;

	Строки = Новый Массив;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() И Строки.Количество() < Количество Цикл
		Если Выборка.ПометкаУдаления Или Не ЗначениеЗаполнено(Пороги[Выборка.Портфель]) Тогда
			Продолжить;
		КонецЕсли;
		Если Не Контекст.Розница И Не Выборка.Автосоздание Тогда
			Продолжить;
		КонецЕсли;
		Если Не КлиентПодходит(Контекст, Выборка.ТипКлиента, Регистраторы[Выборка.Портфель],
			Сведения[Выборка.Портфель]) Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(Выборка.Код + Символы.Таб + Формат(Выборка.ДатаАвтоустановки, "ДФ=dd.MM.yyyy"));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Выполняет тест: по каждому запуску очищает клиентов запуска, вызывает распространение рабочей версией и версией 1.17
// (порядок чередуется), ждет фоновые задания, снимает замеры и состояние клиентов. В конце возвращает рабочей
// обработке исходные обработку и настройки, клиентам - исходный тип клиента.
//
// Параметры:
//  КодыКлиентов - Строка - внешние коды портфелей, по одному в начале строки (после кода - комментарий через TAB)
//  Запусков - Число - число запусков каждой версии
//  КлиентовНаЗапуск - Число - клиентов в одном запуске
//
// Возвращаемое значение:
//  Строка - текст лога
//
Функция ВыполнитьТест(КодыКлиентов, Запусков, КлиентовНаЗапуск) Экспорт

	Лог = Новый Массив;
	УчтенныеЗамеры = Новый Соответствие;
	НачалоТеста = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение "Тест выполняется пользователем с полными правами";
	КонецЕсли;
	Если ЗначениеЗаполнено(ХранилищеОбщихНастроек.Загрузить(КлючХранения(), "Исходное")) Тогда
		ВызватьИсключение
			"Есть несохраненное исходное состояние предыдущего теста: выполните ""Восстановить после сбоя""";
	КонецЕсли;

	Контекст = КонтекстТеста();
	Клиенты = ПортфелиПоКодам(КодыКлиентов);
	Нужно = Запусков * КлиентовНаЗапуск;
	Если Клиенты.Количество() < Нужно Тогда
		ВызватьИсключение СтрШаблон("Нужно клиентов: %1, указано: %2", Нужно, Клиенты.Количество());
	КонецЕсли;

	ВывестиЗаголовок(Контекст, Клиенты, Запусков, КлиентовНаЗапуск);

	Исходное = СохранитьИсходноеСостояние(Контекст, Клиенты);
	Снимки = Новый Соответствие;
	ИсходныеУстановки = Новый Соответствие;
	Замеры = Новый Массив;

	Попытка
		ТипТеста = ТипКлиентовТеста();
		ЗаписатьНастройкиТеста(Контекст, ТипТеста);
		ДобавитьРаздел("1. Исходное состояние клиентов");
		Для Индекс = 0 По Нужно - 1 Цикл
			Портфель = Клиенты[Индекс];
			Снимок = СнимокКлиента(Контекст, Портфель);
			Для Каждого Регистратор Из Снимок.Регистраторы Цикл
				ИсходныеУстановки.Вставить(Регистратор, Истина);
			КонецЦикла;
			ЗапомнитьСнимок(Снимки, Портфель, "исходное", Снимок);
			ВывестиСнимок(Портфель, "исходное", Снимок);
			УстановитьТипКлиента(Портфель, ТипТеста);
		КонецЦикла;

		ДобавитьРаздел("2. Запуски");
		Для Запуск = 1 По Запусков Цикл
			КлиентыЗапуска = Новый Массив;
			Для Индекс = (Запуск - 1) * КлиентовНаЗапуск По Запуск * КлиентовНаЗапуск - 1 Цикл
				КлиентыЗапуска.Добавить(Клиенты[Индекс]);
			КонецЦикла;
			Для Каждого Версия Из ВерсииЗапуска(Запуск) Цикл
				Для Каждого Портфель Из КлиентыЗапуска Цикл
					ОчиститьКлиента(Контекст, Портфель, ИсходныеУстановки);
				КонецЦикла;
				Замер = ЗапуститьВерсию(Контекст, Исходное, Версия, Запуск, КлиентыЗапуска, Снимки);
				Замеры.Добавить(Замер);
			КонецЦикла;
		КонецЦикла;
	Исключение
		Лог.Добавить("");
		Лог.Добавить("ТЕСТ ПРЕРВАН: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ДобавитьРаздел("3. Восстановление рабочей обработки и типов клиентов");
	Восстановить(Исходное);

	ДобавитьРаздел("4. Сводка замеров");
	ВывестиСводку(Замеры);

	ДобавитьРаздел("5. Сверка состояния клиентов");
	ВывестиСверку(Клиенты, Нужно, Снимки);

	Лог.Добавить("");
	Лог.Добавить("Тест завершен за " + Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоТеста) / 1000,
		"ЧДЦ=0; ЧН=0; ЧГ=0") + " с");

	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

// Выполняет тест в фоновом задании (ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки): нужно для проверки
// на разработческой базе, где во внешнем соединении не компилируются модули объектов лимитов. Лог помещается во
// временное хранилище и в хранилище общих настроек (настройка "Лог"): первое фоновое задание после регистрации
// обработки иногда завершается без результата во временном хранилище, а повторять тест нельзя.
//
// Параметры:
//  Параметры - Структура - КодыКлиентов (Строка; пусто - подобрать), Запусков (Число), КлиентовНаЗапуск (Число)
//  АдресРезультата - Строка - адрес временного хранилища для текста лога
//
Процедура ВыполнитьТестВФоне(Параметры, АдресРезультата) Экспорт

	Попытка
		КодыКлиентов = Параметры.КодыКлиентов;
		Если Не ЗначениеЗаполнено(КодыКлиентов) Тогда
			КодыКлиентов = ПодобратьКлиентов(Параметры.Запусков * Параметры.КлиентовНаЗапуск);
		КонецЕсли;
		Текст = ВыполнитьТест(КодыКлиентов, Параметры.Запусков, Параметры.КлиентовНаЗапуск);
	Исключение
		Текст = "ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ХранилищеОбщихНастроек.Сохранить(КлючХранения(), "Лог", Текст);
	ПоместитьВоВременноеХранилище(Текст, АдресРезультата);

КонецПроцедуры

// Возвращает рабочей обработке и клиентам исходное состояние, сохраненное тестом, если тест не завершился сам
// (например, прерван сеанс).
//
// Возвращаемое значение:
//  Строка - что восстановлено
//
Функция ВосстановитьПослеСбоя() Экспорт

	Лог = Новый Массив;
	Исходное = ХранилищеОбщихНастроек.Загрузить(КлючХранения(), "Исходное");
	Если ТипЗнч(Исходное) <> Тип("Структура") Тогда
		Возврат "Сохраненного исходного состояния нет: восстанавливать нечего";
	КонецЕсли;
	Восстановить(Исходное);
	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Контекст

// Читает рабочую обработку распространения (по наименованию, как подписки ВТБ_Прод) и ее настройки.
//
// Возвращаемое значение:
//  Структура:
//   * Обработка - СправочникСсылка.ДополнительныеОтчетыИОбработки - рабочая обработка
//   * ВерсияРабочей - Строка
//   * Настройки - Структура - настройки рабочей обработки
//   * Розница - Булево - ЭтоБазаРозничногоДУ
//   * Классы - Массив из Структура - классы распространения, см. ОписаниеКласса
//   * СписокКлассов - Массив из СправочникСсылка.КлассыЛимитов
//   * ОчищаемыеСвойства - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения
//   * СвойстваСнимка - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения
//   * СвойстваНаличия - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - внешние коды
//     эталонов розницы, без которых клиент не подходит для теста
//
Функция КонтекстТеста()

	Обработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(ИмяРабочейОбработки(), Истина);
	Если Обработка.Пустая() Тогда
		ВызватьИсключение "Не найдена обработка """ + ИмяРабочейОбработки() + """";
	КонецЕсли;
	Настройки = Обработка.ХранилищеНастроек.Получить();
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ВызватьИсключение "У обработки """ + ИмяРабочейОбработки() + """ нет настроек";
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("Обработка", Обработка);
	Контекст.Вставить("ВерсияРабочей", Обработка.Версия);
	Контекст.Вставить("Настройки", Настройки);
	Контекст.Вставить("Розница", ЗначениеНастройки(Настройки, "ЭтоБазаРозничногоДУ") = Истина);

	Классы = Новый Массив;
	Классы.Добавить(ОписаниеКласса(Настройки, "комплаенс", "Комплаенс", "_комплаенс"));
	Если Контекст.Розница Тогда
		Классы.Добавить(ОписаниеКласса(Настройки, "риски", "Риски", "_риски"));
	КонецЕсли;
	Контекст.Вставить("Классы", Классы);

	СписокКлассов = Новый Массив;
	ОчищаемыеСвойства = Новый Массив;
	СвойстваСнимка = Новый Массив;
	СвойстваНаличия = Новый Массив;
	Для Каждого Класс Из Классы Цикл
		Если Не ЗначениеЗаполнено(Класс.Класс) Тогда
			ВызватьИсключение "В настройках не заполнен класс лимитов (" + Класс.Имя + ")";
		КонецЕсли;
		СписокКлассов.Добавить(Класс.Класс);
		Для Каждого Свойство Из Класс.Очищаемые Цикл
			ОчищаемыеСвойства.Добавить(Свойство);
			СвойстваСнимка.Добавить(Свойство);
		КонецЦикла;
		Если Контекст.Розница Тогда
			СвойстваСнимка.Добавить(Класс.СвойствоВнешнийКод);
			СвойстваНаличия.Добавить(Класс.СвойствоВнешнийКод);
		КонецЕсли;
	КонецЦикла;
	Контекст.Вставить("СписокКлассов", СписокКлассов);
	Контекст.Вставить("ОчищаемыеСвойства", ОчищаемыеСвойства);
	Контекст.Вставить("СвойстваСнимка", СвойстваСнимка);
	Контекст.Вставить("СвойстваНаличия", СвойстваНаличия);
	Возврат Контекст;

КонецФункции

// Описание класса распространения по настройкам обработки.
//
// Параметры:
//  Настройки - Структура - настройки рабочей обработки
//  Имя - Строка - "комплаенс" или "риски"
//  Суффикс - Строка - суффикс имен настроек: "Комплаенс" или "Риски"
//  СуффиксСвойств - Строка - суффикс имен настроек свойств: "_комплаенс" или "_риски"
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка
//   * Класс - СправочникСсылка.КлассыЛимитов
//   * СвойствоДата - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - дата автоустановки
//   * СвойствоВнешнийКод - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения
//   * Очищаемые - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - сведения, которые
//     обработка заполняет при распространении (в рознице внешний код эталона - входные данные, он не очищается)
//   * ТипыКлиентов - СписокЗначений - рабочий список типов клиентов класса
//
Функция ОписаниеКласса(Настройки, Имя, Суффикс, СуффиксСвойств)

	Класс = Новый Структура;
	Класс.Вставить("Имя", Имя);
	Класс.Вставить("Класс", ЗначениеНастройки(Настройки, "КлассЛимитов" + Суффикс));
	Класс.Вставить("СвойствоДата", ЗначениеНастройки(Настройки, "ДатаАвтоустановкиЛимитов" + Суффикс));
	Класс.Вставить("СвойствоВнешнийКод", ЗначениеНастройки(Настройки, "ВнешнийКодЭталонногоПортфеля" + Суффикс));
	Класс.Вставить("ТипыКлиентов", ЗначениеНастройки(Настройки, "СписокТиповКлиентов" + Суффикс));

	Очищаемые = Новый Массив;
	ИменаСвойств = Новый Массив;
	ИменаСвойств.Добавить("ДатаАвтоустановкиЛимитов" + Суффикс);
	ИменаСвойств.Добавить("Эталонный_портфель_лимитов" + СуффиксСвойств);
	ИменаСвойств.Добавить("Дата_распространения_правил" + СуффиксСвойств);
	ИменаСвойств.Добавить("ЛимитыЗаведены" + Суффикс);
	Если ЗначениеНастройки(Настройки, "ЭтоБазаРозничногоДУ") <> Истина Тогда
		ИменаСвойств.Добавить("ВнешнийКодЭталонногоПортфеля" + Суффикс);
	КонецЕсли;
	Для Каждого ИмяСвойства Из ИменаСвойств Цикл
		Свойство = ЗначениеНастройки(Настройки, ИмяСвойства);
		Если Не ЗначениеЗаполнено(Свойство) Тогда
			ВызватьИсключение "В настройках не заполнено свойство " + ИмяСвойства;
		КонецЕсли;
		Очищаемые.Добавить(Свойство);
	КонецЦикла;
	Класс.Вставить("Очищаемые", Очищаемые);
	Возврат Класс;

КонецФункции

// Проверяет, что клиент подходит для теста: тип клиента в рабочих списках классов, по каждому классу ровно одна
// действующая установка лимитов по самому портфелю, в рознице заполнены внешние коды эталонов.
//
// Параметры:
//  Контекст - Структура - см. КонтекстТеста
//  ТипКлиента - СправочникСсылка.ТипыКлиентов
//  Регистраторы - Соответствие, Неопределено - ключ: класс лимитов, значение: Массив из Булево - по каждому
//                 регистратору действующих лимитов класса: Истина, если это установка лимитов по самому портфелю
//  Сведения - Соответствие, Неопределено - ключ: свойство из СвойстваНаличия, значение: Истина
//
// Возвращаемое значение:
//  Булево
//
Функция КлиентПодходит(Контекст, ТипКлиента, Регистраторы, Сведения)

	Если Регистраторы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Класс Из Контекст.Классы Цикл
		Если ТипЗнч(Класс.ТипыКлиентов) <> Тип("СписокЗначений")
			Или Класс.ТипыКлиентов.НайтиПоЗначению(ТипКлиента) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		СписокРегистраторов = Регистраторы[Класс.Класс];
		Если СписокРегистраторов = Неопределено Или СписокРегистраторов.Количество() <> 1 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Не СписокРегистраторов[0] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Свойство Из Контекст.СвойстваНаличия Цикл
		Если Сведения = Неопределено Или Сведения[Свойство] <> Истина Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Проверяет, что регистратор действующих лимитов - установка лимитов по самому портфелю (а не по группе портфелей).
//
// Параметры:
//  Регистратор - ДокументСсылка - регистратор записи ДействующиеЛимитыПоПортфелю
//  Портфель - СправочникСсылка.Портфели
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоУстановкаПоПортфелю(Регистратор, Портфель)

	Если ТипЗнч(Регистратор) <> Тип("ДокументСсылка.УстановкаЛимитов") Тогда
		Возврат Ложь;
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Регистратор, "ВидОперации, ОбъектНазначения");
	Возврат Реквизиты.ВидОперации = Перечисления.ВидыОперацийУстановкиЛимитов.ПоПортфелю
		И Реквизиты.ОбъектНазначения = Портфель;

КонецФункции

// Находит портфели по внешним кодам в начале строк текста.
//
// Параметры:
//  КодыКлиентов - Строка - внешние коды портфелей, по одному в начале строки
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Портфели - в порядке строк
//
Функция ПортфелиПоКодам(КодыКлиентов)

	Результат = Новый Массив;
	Для Каждого Строка Из СтрРазделить(КодыКлиентов, Символы.ПС, Ложь) Цикл
		Код = СокрЛП(СтрРазделить(СтрЗаменить(Строка, Символы.Таб, " "), " ", Ложь)[0]);
		Если Не ЗначениеЗаполнено(Код) Тогда
			Продолжить;
		КонецЕсли;
		Портфель = Справочники.Портфели.НайтиПоРеквизиту("ВнешнийКод", Код);
		Если Портфель.Пустая() Тогда
			ВызватьИсключение "Не найден портфель с внешним кодом " + Код;
		КонецЕсли;
		Если Результат.Найти(Портфель) <> Неопределено Тогда
			ВызватьИсключение "Портфель указан дважды: " + Код;
		КонецЕсли;
		Результат.Добавить(Портфель);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Адресаты рассылок, которые использует обработка в этом режиме базы (как в РассылкаСообщения обработки).
//
// Параметры:
//  Контекст - Структура - см. КонтекстТеста
//
// Возвращаемое значение:
//  Строка - по строке на настройку рассылки
//
Функция АдресаРассылок(Контекст)

	ИменаНастроек = Новый Массив;
	ИменаНастроек.Добавить("НастройкаРассылкиКомплаенс");
	Если Контекст.Розница Тогда
		ИменаНастроек.Добавить("НастройкаРассылкиРиски");
	Иначе
		ИменаНастроек.Добавить("НастройкаРассылкиПриУспешномАвтораспространении");
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого ИмяНастройки Из ИменаНастроек Цикл
		НастройкаРассылки = ЗначениеНастройки(Контекст.Настройки, ИмяНастройки);
		Если Не ЗначениеЗаполнено(НастройкаРассылки) Тогда
			Строки.Добавить(ИмяНастройки + ": не заполнена");
			Продолжить;
		КонецЕсли;
		Адреса = Новый Массив;
		Если НастройкаРассылки.РежимРассылки = 0 Тогда
			Для Каждого СтрокаАдреса Из НастройкаРассылки.СписокАдресов Цикл
				Если СтрокаАдреса.ВключенВРассылку Тогда
					Адреса.Добавить(СтрокаАдреса.Адрес);
				КонецЕсли;
			КонецЦикла;
		Иначе
			Для Каждого СтрокаПользователя Из НастройкаРассылки.СписокПользователей Цикл
				Если СтрокаПользователя.ВключенВРассылку Тогда
					Адреса.Добавить(УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
						СтрокаПользователя.Пользователь, Справочники.ВидыКонтактнойИнформации.EmailПользователя,
						ТекущаяДатаСеанса()));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Строки.Добавить(СтрШаблон("%1 (""%2""): %3", ИмяНастройки, НастройкаРассылки, СтрСоединить(Адреса, ", ")));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область ПодготовкаИВосстановление

// Сохраняет исходные обработку, настройки и версию рабочей обработки и типы клиентов в хранилище общих настроек.
//
// Параметры:
//  Контекст - Структура - см. КонтекстТеста
//  Клиенты - Массив из СправочникСсылка.Портфели
//
// Возвращаемое значение:
//  Структура - Обработка (СправочникСсылка), ХранилищеОбработки, ХранилищеНастроек (ХранилищеЗначения),
//              Версия (Строка), Типы (Соответствие: портфель - исходный тип клиента)
//
Функция СохранитьИсходноеСостояние(Контекст, Клиенты)

	Объект = Контекст.Обработка.ПолучитьОбъект();
	Типы = Новый Соответствие;
	Для Каждого Портфель Из Клиенты Цикл
		Типы.Вставить(Портфель, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Портфель, "ТипКлиента"));
	КонецЦикла;
	Исходное = Новый Структура;
	Исходное.Вставить("Обработка", Контекст.Обработка);
	Исходное.Вставить("ХранилищеОбработки", Объект.ХранилищеОбработки);
	Исходное.Вставить("ХранилищеНастроек", Объект.ХранилищеНастроек);
	Исходное.Вставить("Версия", Объект.Версия);
	Исходное.Вставить("Типы", Типы);
	ХранилищеОбщихНастроек.Сохранить(КлючХранения(), "Исходное", Исходное);
	Возврат Исходное;

КонецФункции

// Возвращает рабочей обработке исходные обработку, настройки и версию, клиентам - исходный тип клиента; после
// успешного восстановления удаляет сохраненное состояние.
//
// Параметры:
//  Исходное - Структура - см. СохранитьИсходноеСостояние
//
Процедура Восстановить(Исходное)

	Ошибок = 0;
	Попытка
		Объект = Исходное.Обработка.ПолучитьОбъект();
		Объект.ХранилищеОбработки = Исходное.ХранилищеОбработки;
		Объект.ХранилищеНастроек = Исходное.ХранилищеНастроек;
		Объект.Версия = Исходное.Версия;
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		Лог.Добавить("Рабочей обработке возвращены обработка версии " + Исходное.Версия + " и исходные настройки");
	Исключение
		Ошибок = Ошибок + 1;
		Лог.Добавить("ОШИБКА восстановления рабочей обработки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Для Каждого Элемент Из Исходное.Типы Цикл
		Попытка
			УстановитьТипКлиента(Элемент.Ключ, Элемент.Значение);
		Исключение
			Ошибок = Ошибок + 1;
			Лог.Добавить("ОШИБКА восстановления типа клиента " + КодПортфеля(Элемент.Ключ) + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Лог.Добавить("Клиентам возвращен исходный тип клиента: " + Формат(Исходное.Типы.Количество(), "ЧН=0; ЧГ=0"));

	Если Ошибок = 0 Тогда
		ХранилищеОбщихНастроек.Удалить(КлючХранения(), "Исходное", ИмяПользователя());
	Иначе
		Лог.Добавить("Сохраненное исходное состояние оставлено для команды ""Восстановить после сбоя""");
	КонецЕсли;

КонецПроцедуры

// Записывает рабочей обработке настройки теста: в списках типов клиентов - только тип клиентов теста, текущий
// пользователь - в списке сервисных (как svc_web при распространении после обмена на ПРОД).
//
// Параметры:
//  Контекст - Структура - см. КонтекстТеста
//  ТипТеста - СправочникСсылка.ТипыКлиентов
//
Процедура ЗаписатьНастройкиТеста(Контекст, ТипТеста)

	НастройкиТеста = Новый Структура;
	Для Каждого Элемент Из Контекст.Настройки Цикл
		НастройкиТеста.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Для Каждого ИмяСписка Из СтрРазделить("СписокТиповКлиентовКомплаенс,СписокТиповКлиентовРиски", ",") Цикл
		Типы = Новый СписокЗначений;
		Типы.Добавить(ТипТеста);
		НастройкиТеста.Вставить(ИмяСписка, Типы);
	КонецЦикла;

	Сервисные = Новый СписокЗначений;
	Исходные = ЗначениеНастройки(Контекст.Настройки, "СписокСервисныхПользователей");
	Если ТипЗнч(Исходные) = Тип("СписокЗначений") Тогда
		Сервисные = Исходные.Скопировать();
	КонецЕсли;
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	Если Сервисные.НайтиПоЗначению(ТекущийПользователь) = Неопределено Тогда
		Сервисные.Добавить(ТекущийПользователь);
	КонецЕсли;
	НастройкиТеста.Вставить("СписокСервисныхПользователей", Сервисные);

	Объект = Контекст.Обработка.ПолучитьОбъект();
	Объект.ХранилищеНастроек = Новый ХранилищеЗначения(НастройкиТеста);
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Лог.Добавить("Рабочей обработке записаны настройки теста: типы клиентов - """ + ТипТеста
		+ """, текущий пользователь - в списке сервисных");

КонецПроцедуры

// Приводит клиента к состоянию нового клиента по классам распространения: снимает проведение исходных установок
// лимитов (установки, созданные тестом, помечает на удаление), удаляет пороги по лимитам классов и сведения,
// которые заполняет распространение. Пороги и сведения удаляются без обработчиков регистров (ОбменДанными.Загрузка),
// чтобы очистка не попадала в замеры и не запускала подписки.
//
// Параметры:
//  Контекст - Структура - см. КонтекстТеста
//  Портфель - СправочникСсылка.Портфели
//  ИсходныеУстановки - Соответствие - ключ: установка лимитов, проведенная до теста
//
Процедура ОчиститьКлиента(Контекст, Портфель, ИсходныеУстановки)

	Снимок = СнимокКлиента(Контекст, Портфель);
	Для Каждого Регистратор Из Снимок.Регистраторы Цикл
		Если Не ЭтоУстановкаПоПортфелю(Регистратор, Портфель) Тогда
			ВызватьИсключение СтрШаблон("У клиента %1 действующие лимиты по документу ""%2"" - это не установка по
				|портфелю, очистка не выполняется", КодПортфеля(Портфель), Регистратор);
		КонецЕсли;
		Документ = Регистратор.ПолучитьОбъект();
		Если ИсходныеУстановки[Регистратор] = Истина Тогда
			Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе
			Документ.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Лимит Из Снимок.ЛимитыПорогов Цикл
		Набор = РегистрыСведений.ПорогиЛимитов.СоздатьНаборЗаписей();
		Набор.Отбор.Портфель.Установить(Портфель);
		Набор.Отбор.Лимит.Установить(Лимит);
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

	Для Каждого Свойство Из Контекст.ОчищаемыеСвойства Цикл
		Набор = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Портфель);
		Набор.Отбор.Свойство.Установить(Свойство);
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

// Тип клиентов теста "T9746 тест" (создается при отсутствии).
//
// Возвращаемое значение:
//  СправочникСсылка.ТипыКлиентов
//
Функция ТипКлиентовТеста()

	ТипТеста = Справочники.ТипыКлиентов.НайтиПоНаименованию("T9746 тест", Истина);
	Если ТипТеста.Пустая() Тогда
		Объект = Справочники.ТипыКлиентов.СоздатьЭлемент();
		Объект.Наименование = "T9746 тест";
		Объект.Записать();
		ТипТеста = Объект.Ссылка;
	КонецЕсли;
	Возврат ТипТеста;

КонецФункции

// Устанавливает портфелю тип клиента, если он отличается.
//
// Параметры:
//  Портфель - СправочникСсылка.Портфели
//  ТипКлиента - СправочникСсылка.ТипыКлиентов
//
Процедура УстановитьТипКлиента(Портфель, ТипКлиента)

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Портфель, "ТипКлиента") = ТипКлиента Тогда
		Возврат;
	КонецЕсли;
	Объект = Портфель.ПолучитьОбъект();
	Объект.ТипКлиента = ТипКлиента;
	Объект.Записать();

КонецПроцедуры

#КонецОбласти

#Область Запуск

// Порядок версий в запуске: нечетный запуск - рабочая, затем 1.17; четный - наоборот (прогрев сервера не дает
// преимущества одной версии).
//
// Параметры:
//  Запуск - Число - номер запуска
//
// Возвращаемое значение:
//  Массив из Строка - "рабочая", "1.17"
//
Функция ВерсииЗапуска(Запуск)

	Версии = Новый Массив;
	Если Запуск % 2 = 1 Тогда
		Версии.Добавить("рабочая");
		Версии.Добавить("1.17");
	Иначе
		Версии.Добавить("1.17");
		Версии.Добавить("рабочая");
	КонецЕсли;
	Возврат Версии;

КонецФункции

// Загружает версию в рабочую обработку, вызывает распространение как обработка "Операции после обмена", ждет фоновые
// задания распространения и записи версий лимитов, снимает замеры и состояние клиентов запуска.
//
// Параметры:
//  Контекст - Структура - см. КонтекстТеста
//  Исходное - Структура - см. СохранитьИсходноеСостояние
//  Версия - Строка - "рабочая" или "1.17"
//  Запуск - Число - номер запуска
//  КлиентыЗапуска - Массив из СправочникСсылка.Портфели
//  Снимки - Соответствие - см. ЗапомнитьСнимок, дополняется
//
// Возвращаемое значение:
//  Структура - Версия, Запуск, ДлительностьМс, КлючеваяОперацияС, ЗаданияС, ВерсийЛимитов, ОшибокЖурнала, Ошибка
//
Функция ЗапуститьВерсию(Контекст, Исходное, Версия, Запуск, КлиентыЗапуска, Снимки)

	Объект = Контекст.Обработка.ПолучитьОбъект();
	Если Версия = "1.17" Тогда
		Объект.ХранилищеОбработки = Новый ХранилищеЗначения(ПолучитьМакет("Версия117"));
		Объект.Версия = "1.17";
	Иначе
		Объект.ХранилищеОбработки = Исходное.ХранилищеОбработки;
		Объект.Версия = Исходное.Версия;
	КонецЕсли;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

	Коды = Новый Массив;
	Лимиты = Новый Массив;
	Для Каждого Портфель Из КлиентыЗапуска Цикл
		Коды.Добавить(КодПортфеля(Портфель));
		Для Каждого Лимит Из Снимки[Портфель]["исходное"].ЛимитыПорогов Цикл
			Лимиты.Добавить(Лимит);
		КонецЦикла;
	КонецЦикла;

	Замер = Новый Структура("Версия, Запуск, ДлительностьМс, КлючеваяОперацияС, ЗаданияС, ВерсийЛимитов, ОшибокЖурнала,
		|Ошибка", Версия, Запуск, 0, 0, 0, 0, 0, "");
	Лог.Добавить("");
	Лог.Добавить(СтрШаблон("Запуск %1, версия %2, клиенты: %3", Запуск, Версия, СтрСоединить(Коды, ", ")));

	ИзвестныеЗадания = ЗаданияРаспространения(Неопределено);
	// Журнал регистрации и фоновые задания датируются временем сервера, замеры и версии - временем сеанса.
	НачалоСервер = ТекущаяДата();
	НачалоСеанса = ТекущаяДатаСеанса();

	ОбъектРаспространения = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Контекст.Обработка);
	ВерсияОбъекта = ОбъектРаспространения.СведенияОВнешнейОбработке().Версия;
	Лог.Добавить("  подключена обработка версии " + ВерсияОбъекта);
	Если Версия = "1.17" И ВерсияОбъекта <> "1.17" Или Версия <> "1.17" И ВерсияОбъекта = "1.17" Тогда
		Замер.Ошибка = "подключена не та версия обработки: " + ВерсияОбъекта;
	КонецЕсли;

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ОбъектРаспространения.ВыполнитьРаспространениеПравилПослеОбмена(Контекст.Обработка);
	Исключение
		Замер.Ошибка = Замер.Ошибка + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Замер.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Лог.Добавить("  распространение: " + ФорматМс(Замер.ДлительностьМс) + " с" + ТекстОшибки(Замер.Ошибка));

	Задания = ДождатьсяЗаданий(ИзвестныеЗадания, 900);
	Для Каждого Задание Из Задания Цикл
		Длительность = 0;
		Если ЗначениеЗаполнено(Задание.Конец) Тогда
			Длительность = Задание.Конец - Задание.Начало;
		КонецЕсли;
		Замер.ЗаданияС = Замер.ЗаданияС + Длительность;
		ТекстЗадания = СтрШаблон("  фоновое задание ""%1"": %2 с, %3", Задание.Наименование, Длительность,
			Задание.Состояние);
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ТекстЗадания = ТекстЗадания + ", " + КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
		Лог.Добавить(ТекстЗадания);
	КонецЦикла;

	Для Каждого Операция Из КлючевыеОперации(НачалоСеанса) Цикл
		Лог.Добавить(СтрШаблон("  замер %1: %2 с, вес %3, %4", Операция.Ключ,
			Формат(Операция.Время, "ЧДЦ=3; ЧН=0; ЧГ=0"), Операция.Вес, Операция.Комментарий));
		Если Операция.Ключ = "РаспространениеПравилЛимитов" Тогда
			Замер.КлючеваяОперацияС = Замер.КлючеваяОперацияС + Операция.Время;
		КонецЕсли;
	КонецЦикла;

	Замер.ВерсийЛимитов = ВерсийЛимитов(Лимиты, НачалоСеанса);
	Лог.Добавить("  версий лимитов записано: " + Замер.ВерсийЛимитов);

	Ошибки = ОшибкиЖурнала(НачалоСервер);
	Замер.ОшибокЖурнала = Ошибки.Количество();
	Лог.Добавить("  ошибок в журнале регистрации: " + Замер.ОшибокЖурнала);
	Для Каждого ТекстОшибкиЖурнала Из Ошибки Цикл
		Лог.Добавить("    " + ТекстОшибкиЖурнала);
	КонецЦикла;

	Для Каждого Портфель Из КлиентыЗапуска Цикл
		Снимок = СнимокКлиента(Контекст, Портфель);
		ЗапомнитьСнимок(Снимки, Портфель, Версия, Снимок);
		ВывестиСнимок(Портфель, Версия, Снимок);
	КонецЦикла;

	Возврат Замер;

КонецФункции

// Фоновые задания распространения правил (подписки ВТБ_Прод) и записи версий лимитов.
//
// Параметры:
//  Известные - Соответствие, Неопределено - задания, которые не нужно возвращать (ключ - уникальный идентификатор)
//
// Возвращаемое значение:
//  Соответствие - ключ: УникальныйИдентификатор задания, значение: ФоновоеЗадание
//
Функция ЗаданияРаспространения(Известные)

	Результат = Новый Соответствие;
	Для Каждого Наименование Из СтрРазделить("Запись версий лимитов;" + ИмяРабочейОбработки(), ";") Цикл
		Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Наименование", Наименование)) Цикл
			Если Известные = Неопределено Или Известные[Задание.УникальныйИдентификатор] = Неопределено Тогда
				Результат.Вставить(Задание.УникальныйИдентификатор, Задание);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ждет завершения фоновых заданий, запущенных после снимка известных заданий (включая запущенные самими заданиями).
//
// Параметры:
//  Известные - Соответствие - см. ЗаданияРаспространения
//  ТаймаутС - Число - общее время ожидания, секунд
//
// Возвращаемое значение:
//  Массив из ФоновоеЗадание - новые задания в порядке начала, с актуальным состоянием
//
Функция ДождатьсяЗаданий(Известные, ТаймаутС)

	Окончание = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутС * 1000;
	Пока Истина Цикл
		Активных = 0;
		Новые = ЗаданияРаспространения(Известные);
		Для Каждого Элемент Из Новые Цикл
			Если Элемент.Значение.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				Активных = Активных + 1;
				Осталось = Макс(1, Цел((Окончание - ТекущаяУниверсальнаяДатаВМиллисекундах()) / 1000));
				Элемент.Значение.ОжидатьЗавершенияВыполнения(Осталось);
			КонецЕсли;
		КонецЦикла;
		Если Активных = 0 Или ТекущаяУниверсальнаяДатаВМиллисекундах() >= Окончание Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Задание");
	Таблица.Колонки.Добавить("Начало", Новый ОписаниеТипов("Дата"));
	Для Каждого Элемент Из ЗаданияРаспространения(Известные) Цикл
		СтрокаЗадания = Таблица.Добавить();
		СтрокаЗадания.Задание = Элемент.Значение;
		СтрокаЗадания.Начало = Элемент.Значение.Начало;
	КонецЦикла;
	Таблица.Сортировать("Начало");
	Возврат Таблица.ВыгрузитьКолонку("Задание");

КонецФункции

// Ключевые операции распространения правил лимитов, записанные с начала запуска и не отнесенные к предыдущим
// запускам (дата записи замера грубее длительности запуска, поэтому замеры отбираются по признаку "уже учтен").
//
// Параметры:
//  НачалоСеанса - Дата - начало запуска (время сеанса)
//
// Возвращаемое значение:
//  Массив из Структура - Ключ (Строка), Время (Число, с), Вес (Число), Комментарий (Строка)
//
Функция КлючевыеОперации(НачалоСеанса)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КлючевыеОперации.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	Справочник.КлючевыеОперации КАК КлючевыеОперации
	|ГДЕ
	|	КлючевыеОперации.Имя ПОДОБНО ""РаспространениеПравилЛимитов%""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Замеры.КлючеваяОперация КАК КлючеваяОперация,
	|	Замеры.НомерСеанса КАК НомерСеанса,
	|	Замеры.ДатаНачалаЗамера КАК ДатаНачалаЗамера,
	|	Замеры.КлючеваяОперация.Имя КАК Ключ,
	|	Замеры.ВремяВыполнения КАК Время,
	|	Замеры.ВесЗамера КАК Вес,
	|	Замеры.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Замеры
	|ГДЕ
	|	Замеры.КлючеваяОперация В
	|			(ВЫБРАТЬ
	|				Ключи.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТКлючи КАК Ключи)
	|	И Замеры.ДатаЗаписиЛокальная >= &Начало
	|
	|УПОРЯДОЧИТЬ ПО
	|	Замеры.ДатаНачалаЗамера";
	Запрос.УстановитьПараметр("Начало", НачалоСеанса);
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоСеансам = УчтенныеЗамеры[Выборка.КлючеваяОперация];
		Если ПоСеансам = Неопределено Тогда
			ПоСеансам = Новый Соответствие;
			УчтенныеЗамеры.Вставить(Выборка.КлючеваяОперация, ПоСеансам);
		КонецЕсли;
		НачалаЗамеров = ПоСеансам[Выборка.НомерСеанса];
		Если НачалаЗамеров = Неопределено Тогда
			НачалаЗамеров = Новый Соответствие;
			ПоСеансам.Вставить(Выборка.НомерСеанса, НачалаЗамеров);
		КонецЕсли;
		Если НачалаЗамеров[Выборка.ДатаНачалаЗамера] = Истина Тогда
			Продолжить;
		КонецЕсли;
		НачалаЗамеров.Вставить(Выборка.ДатаНачалаЗамера, Истина);
		Результат.Добавить(Новый Структура("Ключ, Время, Вес, Комментарий", Выборка.Ключ, Выборка.Время, Выборка.Вес,
			Строка(Выборка.Комментарий)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Число версий лимитов, записанных с начала запуска.
//
// Параметры:
//  Лимиты - Массив из СправочникСсылка.Лимиты - лимиты с порогами клиентов запуска
//  НачалоСеанса - Дата - начало запуска (время сеанса)
//
// Возвращаемое значение:
//  Число
//
Функция ВерсийЛимитов(Лимиты, НачалоСеанса)

	Если Лимиты.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Версий
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК Версии
	|ГДЕ
	|	Версии.Объект В(&Лимиты)
	|	И Версии.ДатаВерсии >= &Начало";
	Запрос.УстановитьПараметр("Лимиты", Лимиты);
	Запрос.УстановитьПараметр("Начало", НачалоСеанса);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Версий;

КонецФункции

// Ошибки журнала регистрации с начала запуска (не больше 20, комментарий - до 300 символов).
//
// Параметры:
//  НачалоСервер - Дата - начало запуска (время сервера)
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ОшибкиЖурнала(НачалоСервер)

	Таблица = Новый ТаблицаЗначений;
	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", НачалоСервер);
	Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
	ВыгрузитьЖурналРегистрации(Таблица, Отбор, , , 20);
	Результат = Новый Массив;
	Для Каждого СтрокаЖурнала Из Таблица Цикл
		Комментарий = СтрЗаменить(Строка(СтрокаЖурнала.Комментарий), Символы.ПС, " ");
		Результат.Добавить(СтрокаЖурнала.Событие + ": " + Лев(Комментарий, 300));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СостояниеКлиентов

// Состояние клиента по классам распространения: действующие установки лимитов, пороги и сведения распространения.
//
// Параметры:
//  Контекст - Структура - см. КонтекстТеста
//  Портфель - СправочникСсылка.Портфели
//
// Возвращаемое значение:
//  Структура:
//   * Установки - Массив из Строка - "класс: лимиты через ;" по каждой действующей установке, отсортировано
//   * Пороги - Массив из Строка - "лимит / настройка порогов", отсортировано
//   * Сведения - Массив из Строка - "свойство = значение" (даты - "заполнена"), отсортировано
//   * Регистраторы - Массив из ДокументСсылка - регистраторы действующих лимитов по классам
//   * ЛимитыПорогов - Массив из СправочникСсылка.Лимиты - лимиты классов, по которым у клиента есть пороги
//
Функция СнимокКлиента(Контекст, Портфель)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Действующие.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТРегистраторы
	|ИЗ
	|	РегистрСведений.ДействующиеЛимитыПоПортфелю КАК Действующие
	|ГДЕ
	|	Действующие.Портфель = &Портфель
	|	И Действующие.КлассЛимита В(&Классы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Регистраторы.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(ЛимитыУстановки.Ссылка.КлассЛимита) КАК Класс,
	|	ПРЕДСТАВЛЕНИЕ(ЛимитыУстановки.Лимит) КАК Лимит
	|ИЗ
	|	ВТРегистраторы КАК Регистраторы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстановкаЛимитов.Лимиты КАК ЛимитыУстановки
	|		ПО Регистраторы.Регистратор = ЛимитыУстановки.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Пороги.Лимит КАК Лимит,
	|	ПРЕДСТАВЛЕНИЕ(Пороги.Лимит) КАК ЛимитПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Пороги.НастройкаПороговДляПроверкиЛимитов) КАК Настройка
	|ИЗ
	|	РегистрСведений.ПорогиЛимитов КАК Пороги
	|ГДЕ
	|	Пороги.Портфель = &Портфель
	|	И Пороги.Лимит.КлассЛимита В(&Классы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(Сведения.Свойство) КАК Свойство,
	|	Сведения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Сведения
	|ГДЕ
	|	Сведения.Объект = &Портфель
	|	И Сведения.Свойство В(&Свойства)";
	Запрос.УстановитьПараметр("Портфель", Портфель);
	Запрос.УстановитьПараметр("Классы", Контекст.СписокКлассов);
	Запрос.УстановитьПараметр("Свойства", Контекст.СвойстваСнимка);
	Результаты = Запрос.ВыполнитьПакет();

	Снимок = Новый Структура("Установки, Пороги, Сведения, Регистраторы, ЛимитыПорогов");
	Снимок.Регистраторы = Новый Массив;
	ЛимитыУстановок = Новый Соответствие;
	КлассыУстановок = Новый Соответствие;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Снимок.Регистраторы.Найти(Выборка.Регистратор) = Неопределено Тогда
			Снимок.Регистраторы.Добавить(Выборка.Регистратор);
			ЛимитыУстановок.Вставить(Выборка.Регистратор, Новый Массив);
			КлассыУстановок.Вставить(Выборка.Регистратор, Выборка.Класс);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Лимит) Тогда
			ЛимитыУстановок[Выборка.Регистратор].Добавить(Выборка.Лимит);
		КонецЕсли;
	КонецЦикла;
	Установки = Новый Массив;
	Для Каждого Регистратор Из Снимок.Регистраторы Цикл
		ЛимитыУстановки = Отсортированные(ЛимитыУстановок[Регистратор]);
		Установки.Добавить(КлассыУстановок[Регистратор] + ": " + СтрСоединить(ЛимитыУстановки, "; "));
	КонецЦикла;
	Снимок.Установки = Отсортированные(Установки);

	Пороги = Новый Массив;
	Снимок.ЛимитыПорогов = Новый Массив;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Пороги.Добавить(Выборка.ЛимитПредставление + " / " + Выборка.Настройка);
		Если Снимок.ЛимитыПорогов.Найти(Выборка.Лимит) = Неопределено Тогда
			Снимок.ЛимитыПорогов.Добавить(Выборка.Лимит);
		КонецЕсли;
	КонецЦикла;
	Снимок.Пороги = Отсортированные(Пороги);

	Сведения = Новый Массив;
	Выборка = Результаты[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Сведения.Добавить(Выборка.Свойство + " = " + ЗначениеСведения(Выборка.Значение));
	КонецЦикла;
	Снимок.Сведения = Отсортированные(Сведения);
	Возврат Снимок;

КонецФункции

// Запоминает состояние клиента после этапа теста.
//
// Параметры:
//  Снимки - Соответствие - ключ: портфель, значение: Соответствие (ключ: этап - "исходное", "рабочая", "1.17";
//           значение: см. СнимокКлиента)
//  Портфель - СправочникСсылка.Портфели
//  Этап - Строка
//  Снимок - Структура - см. СнимокКлиента
//
Процедура ЗапомнитьСнимок(Снимки, Портфель, Этап, Снимок)

	ПоЭтапам = Снимки[Портфель];
	Если ПоЭтапам = Неопределено Тогда
		ПоЭтапам = Новый Соответствие;
		Снимки.Вставить(Портфель, ПоЭтапам);
	КонецЕсли;
	ПоЭтапам.Вставить(Этап, Снимок);

КонецПроцедуры

// Значение сведения для сверки: даты - только факт заполнения (они разные у запусков), портфели - кодом.
//
// Параметры:
//  Значение - Произвольный - значение дополнительного сведения
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеСведения(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат "заполнена";
		КонецЕсли;
		Возврат "пусто";
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Портфели") Тогда
		Возврат "портфель " + КодПортфеля(Значение);
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область ВыводЛога

// Выводит заголовок лога: база, режим, версии, клиенты по запускам.
//
// Параметры:
//  Контекст - Структура - см. КонтекстТеста
//  Клиенты - Массив из СправочникСсылка.Портфели
//  Запусков - Число
//  КлиентовНаЗапуск - Число
//
Процедура ВывестиЗаголовок(Контекст, Клиенты, Запусков, КлиентовНаЗапуск)

	Лог.Добавить("IMDEV-9746. Сравнение версий распространения правил лимитов на Т-1 (версия теста 1)");
	Лог.Добавить("Дата: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Лог.Добавить("База: " + ИмяБазы() + ", конфигурация " + Метаданные.Версия);
	Если Контекст.Розница Тогда
		Лог.Добавить("Режим: розница (классы комплаенс и риски)");
	Иначе
		Лог.Добавить("Режим: обычный ФО (класс комплаенс)");
	КонецЕсли;
	Лог.Добавить("Рабочая обработка: версия " + Контекст.ВерсияРабочей + "; новая: 1.17 (макет теста)");
	Лог.Добавить(СтрШаблон("Запусков на версию: %1, клиентов на запуск: %2", Запусков, КлиентовНаЗапуск));
	Для Запуск = 1 По Запусков Цикл
		Коды = Новый Массив;
		Для Индекс = (Запуск - 1) * КлиентовНаЗапуск По Запуск * КлиентовНаЗапуск - 1 Цикл
			Коды.Добавить(КодПортфеля(Клиенты[Индекс]));
		КонецЦикла;
		Лог.Добавить(СтрШаблон("  запуск %1: %2; порядок: %3", Запуск, СтрСоединить(Коды, ", "),
			СтрСоединить(ВерсииЗапуска(Запуск), " -> ")));
	КонецЦикла;

КонецПроцедуры

// Выводит состояние клиента: число установок, порогов, сведений и строки сведений.
//
// Параметры:
//  Портфель - СправочникСсылка.Портфели
//  Этап - Строка
//  Снимок - Структура - см. СнимокКлиента
//
Процедура ВывестиСнимок(Портфель, Этап, Снимок)

	Лог.Добавить(СтрШаблон("  клиент %1 (%2): установок %3, порогов %4, сведений %5", КодПортфеля(Портфель), Этап,
		Снимок.Установки.Количество(), Снимок.Пороги.Количество(), Снимок.Сведения.Количество()));
	Для Каждого СтрокаУстановки Из Снимок.Установки Цикл
		Лог.Добавить("    установка " + Лев(СтрокаУстановки, 200));
	КонецЦикла;
	Для Каждого СтрокаСведения Из Снимок.Сведения Цикл
		Лог.Добавить("    " + СтрокаСведения);
	КонецЦикла;

КонецПроцедуры

// Выводит по каждой версии время запусков (медиана, минимум, максимум), ключевую операцию, фоновые задания, версии
// лимитов и ошибки журнала, отношение медиан рабочей версии и 1.17.
//
// Параметры:
//  Замеры - Массив из Структура - см. ЗапуститьВерсию
//
Процедура ВывестиСводку(Замеры)

	Медианы = Новый Соответствие;
	Для Каждого Версия Из СтрРазделить("рабочая,1.17", ",") Цикл
		Длительности = Новый Массив;
		КлючеваяОперация = 0;
		Задания = 0;
		Версий = 0;
		ОшибокЖурнала = 0;
		Ошибок = 0;
		Для Каждого Замер Из Замеры Цикл
			Если Замер.Версия <> Версия Тогда
				Продолжить;
			КонецЕсли;
			Длительности.Добавить(Замер.ДлительностьМс);
			КлючеваяОперация = КлючеваяОперация + Замер.КлючеваяОперацияС;
			Задания = Задания + Замер.ЗаданияС;
			Версий = Версий + Замер.ВерсийЛимитов;
			ОшибокЖурнала = ОшибокЖурнала + Замер.ОшибокЖурнала;
			Если ЗначениеЗаполнено(Замер.Ошибка) Тогда
				Ошибок = Ошибок + 1;
			КонецЕсли;
		КонецЦикла;
		Если Длительности.Количество() = 0 Тогда
			Лог.Добавить(Версия + ": запусков нет");
			Продолжить;
		КонецЕсли;
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(Длительности);
		Список.СортироватьПоЗначению();
		Медиана = Список[Цел(Список.Количество() / 2)].Значение;
		Медианы.Вставить(Версия, Медиана);
		Лог.Добавить(СтрШаблон("%1: запусков %2, распространение медиана %3 с (мин %4, макс %5),
			|  ключевая операция всего %6 с, фоновые задания всего %7 с, версий лимитов %8, ошибок журнала %9,
			|  запусков с ошибкой %10", Версия,
			Длительности.Количество(), ФорматМс(Медиана), ФорматМс(Список[0].Значение),
			ФорматМс(Список[Список.Количество() - 1].Значение), Формат(КлючеваяОперация, "ЧДЦ=1; ЧН=0; ЧГ=0"), Задания,
			Версий, ОшибокЖурнала, Ошибок));
	КонецЦикла;
	Если ЗначениеЗаполнено(Медианы["рабочая"]) И ЗначениеЗаполнено(Медианы["1.17"]) Тогда
		Отношение = Медианы["рабочая"] / Медианы["1.17"];
		Лог.Добавить("Медиана рабочей версии / медиана 1.17 = " + Формат(Отношение, "ЧДЦ=1; ЧН=0"));
	КонецЕсли;

КонецПроцедуры

// Сверяет состояние каждого клиента после рабочей версии и после 1.17, а также после 1.17 с исходным.
//
// Параметры:
//  Клиенты - Массив из СправочникСсылка.Портфели
//  Нужно - Число - число клиентов теста
//  Снимки - Соответствие - см. ЗапомнитьСнимок
//
Процедура ВывестиСверку(Клиенты, Нужно, Снимки)

	Расхождений = 0;
	Для Индекс = 0 По Нужно - 1 Цикл
		Портфель = Клиенты[Индекс];
		ПоЭтапам = Снимки[Портфель];
		Если ПоЭтапам = Неопределено Или ПоЭтапам["рабочая"] = Неопределено Или ПоЭтапам["1.17"] = Неопределено Тогда
			Лог.Добавить("клиент " + КодПортфеля(Портфель) + ": нет результатов обеих версий");
			Расхождений = Расхождений + 1;
			Продолжить;
		КонецЕсли;
		Различия = РазличияСнимков(ПоЭтапам["рабочая"], ПоЭтапам["1.17"]);
		Если Различия.Количество() = 0 Тогда
			Лог.Добавить("клиент " + КодПортфеля(Портфель) + ": рабочая и 1.17 совпадают");
		Иначе
			Расхождений = Расхождений + 1;
			Лог.Добавить("клиент " + КодПортфеля(Портфель) + ": РАЗЛИЧИЯ рабочей (-) и 1.17 (+):");
			Для Каждого Различие Из Различия Цикл
				Лог.Добавить("    " + Различие);
			КонецЦикла;
		КонецЕсли;
		Различия = РазличияСнимков(ПоЭтапам["исходное"], ПоЭтапам["1.17"]);
		Если Различия.Количество() = 0 Тогда
			Лог.Добавить("    1.17 и исходное состояние совпадают");
		Иначе
			Лог.Добавить("    отличия 1.17 (+) от исходного состояния (-), для сведения:");
			Для Каждого Различие Из Различия Цикл
				Лог.Добавить("      " + Различие);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Лог.Добавить(СтрШаблон("Итог сверки: клиентов %1, с различиями рабочей и 1.17: %2", Нужно, Расхождений));

КонецПроцедуры

// Различия двух состояний клиента по установкам, порогам и сведениям.
//
// Параметры:
//  Было - Структура - см. СнимокКлиента
//  Стало - Структура - см. СнимокКлиента
//
// Возвращаемое значение:
//  Массив из Строка - "- раздел: строка" (есть только в Было), "+ раздел: строка" (есть только в Стало)
//
Функция РазличияСнимков(Было, Стало)

	Результат = Новый Массив;
	Для Каждого Раздел Из СтрРазделить("Установки,Пороги,Сведения", ",") Цикл
		Для Каждого Строка Из Было[Раздел] Цикл
			Если Стало[Раздел].Найти(Строка) = Неопределено Тогда
				Результат.Добавить("- " + Раздел + ": " + Лев(Строка, 300));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Строка Из Стало[Раздел] Цикл
			Если Было[Раздел].Найти(Строка) = Неопределено Тогда
				Результат.Добавить("+ " + Раздел + ": " + Лев(Строка, 300));
			КонецЕсли;
		КонецЦикла;
		Если Было[Раздел].Количество() <> Стало[Раздел].Количество() Тогда
			Результат.Добавить(СтрШаблон("  %1: строк было %2, стало %3", Раздел, Было[Раздел].Количество(),
				Стало[Раздел].Количество()));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Добавляет в лог заголовок раздела.
//
// Параметры:
//  Заголовок - Строка
//
Процедура ДобавитьРаздел(Заголовок)

	Лог.Добавить("");
	Лог.Добавить("=== " + Заголовок + " ===");

КонецПроцедуры

#КонецОбласти

