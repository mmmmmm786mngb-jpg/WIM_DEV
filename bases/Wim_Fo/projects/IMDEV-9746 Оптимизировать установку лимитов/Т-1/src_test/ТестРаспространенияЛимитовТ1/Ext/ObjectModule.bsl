//
// Возвращаемое значение:
//  Строка
//
Функция КлючХранения()

	Возврат "IMDEV-9746 тест распространения Т-1";

КонецФункции

// Возвращает значение из структуры настроек.
//
// Параметры:
//  Настройки - Структура - настройки обработки
//  ИмяНастройки - Строка - имя настройки
//
// Возвращаемое значение:
//  Произвольный - значение или Неопределено
//
Функция ЗначениеНастройки(Настройки, ИмяНастройки)

	Значение = Неопределено;
	Настройки.Свойство(ИмяНастройки, Значение);
	Возврат Значение;

КонецФункции

// Внешний код портфеля для лога (наименование клиента в лог не выводится).
//
// Параметры:
//  Портфель - СправочникСсылка.Портфели
//
// Возвращаемое значение:
//  Строка
//
Функция КодПортфеля(Портфель)

	Возврат СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Портфель, "ВнешнийКод"));

КонецФункции

// Массив строк, отсортированный по возрастанию.
//
// Параметры:
//  Строки - Массив из Строка
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Отсортированные(Строки)

	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Строки);
	Список.СортироватьПоЗначению();
	Возврат Список.ВыгрузитьЗначения();

КонецФункции

// Миллисекунды в секундах с двумя знаками.
//
// Параметры:
//  Миллисекунды - Число
//
// Возвращаемое значение:
//  Строка
//
Функция ФорматМс(Миллисекунды)

	Возврат Формат(Миллисекунды / 1000, "ЧДЦ=2; ЧН=0; ЧГ=0");

КонецФункции

// Текст ошибки для строки лога (пусто, если ошибки нет).
//
// Параметры:
//  Ошибка - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОшибки(Ошибка)

	Если ЗначениеЗаполнено(Ошибка) Тогда
		Возврат ", ОШИБКА: " + Ошибка;
	КонецЕсли;
	Возврат "";

КонецФункции

// Имя информационной базы на сервере из строки соединения.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяБазы()

	Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";", Ложь) Цикл
		Если СтрНачинаетсяС(ВРег(СокрЛП(Часть)), "REF=") Тогда
			Возврат СтрЗаменить(Сред(СокрЛП(Часть), 5), """", "");
		КонецЕсли;
	КонецЦикла;
	Возврат СтрокаСоединенияИнформационнойБазы();

КонецФункции

#КонецОбласти

#КонецЕсли
