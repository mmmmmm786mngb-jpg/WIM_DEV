#Область ОбработчикиСобытийФормы

// Заполняет режим базы, версию рабочей обработки, адресатов рассылок, число запусков и подбирает клиентов.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Обработка = РеквизитФормыВЗначение("Объект");
	Сведения = Обработка.СведенияДляФормы();
	Если ЗначениеЗаполнено(Сведения.Ошибка) Тогда
		Режим = "ошибка: " + Сведения.Ошибка;
		Возврат;
	КонецЕсли;
	Режим            = Сведения.Режим;
	ВерсияРабочей    = Сведения.ВерсияРабочей;
	АдресаРассылок   = Сведения.АдресаРассылок;
	Запусков         = 3;
	КлиентовНаЗапуск = Сведения.КлиентовНаЗапуск;
	ПодобратьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Подбирает клиентов для теста заново (число - запусков на клиентов на запуск).
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Подобрать(Команда)

	ПодобратьНаСервере();

КонецПроцедуры

// Выполняет тест после проверки, что адреса рассылок проверены.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ЗапуститьТест(Команда)

	Если Не АдресаПроверены Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Проверьте адресатов рассылок и отметьте ""Адреса проверены"": письма теста отправляются по-настоящему");
		Возврат;
	КонецЕсли;
	Если Запусков = 0 Или КлиентовНаЗапуск = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите число запусков и клиентов на запуск");
		Возврат;
	КонецЕсли;
	Результат = "Выполняется тест...";
	ВыполнитьНаСервере();

КонецПроцедуры

// Возвращает рабочей обработке и клиентам исходное состояние, если тест не завершился сам.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Восстановить(Команда)

	ВосстановитьНаСервере();

КонецПроцедуры

// Сохраняет текст лога в файл на компьютере пользователя (UTF-8).
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(Результат) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала выполните тест");
		Возврат;
	КонецЕсли;

	ИмяФайла = "Тест_распространения_9746_" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt";
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресФайла(), ИмяФайла);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подбирает клиентов модулем объекта в реквизит Клиенты.
//
&НаСервере
Процедура ПодобратьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Клиенты = Обработка.ПодобратьКлиентов(Запусков * КлиентовНаЗапуск);
	Если Не ЗначениеЗаполнено(Клиенты) Тогда
		ОбщегоНазначения.СообщитьПользователю("Подходящих клиентов не найдено: укажите коды портфелей вручную");
	КонецЕсли;

КонецПроцедуры

// Выполняет тест модулем объекта и помещает лог в реквизит Результат.
//
&НаСервере
Процедура ВыполнитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Попытка
		Результат = Обработка.ВыполнитьТест(Клиенты, Запусков, КлиентовНаЗапуск);
	Исключение
		Результат = "ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Восстанавливает исходное состояние модулем объекта и выводит итог в реквизит Результат.
//
&НаСервере
Процедура ВосстановитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ВосстановитьПослеСбоя();

КонецПроцедуры

// Помещает текст лога во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла (UTF-8 без BOM)
//
&НаСервере
Функция АдресФайла()

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Результат, "UTF-8", Ложь);
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
