// IMDEV-9746. Диагностика лимитов на копии Т-1 для решения по доработке обработки распространения правил лимитов.
// Только чтение: обработка не записывает данные базы. Собирает: классы лимитов и расширенное подтверждение, настройки
// обработки распространения, лимиты эталонных установок и число портфелей с порогами по ним, наличие порогов недавно
// распространенных клиентов в кэше настроек лимитов, время тяжелых частей версии и кэша лимита (без записи).
// Имена сотрудников в лог не выводятся (только служебные учетные записи svc).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Собирает лог диагностики.
//
// Параметры:
//  ДнейИстории - Число - глубина истории в днях для недавно распространенных клиентов и версий лимитов
//  ИмяОбъекта - Строка - имя объекта обработки распространения в справочнике дополнительных обработок, чьи настройки
//               читаются; пусто - рабочая обработка внРаспространениеПравилСОдногоКлиентаНаСписокКлиентов
//
// Возвращаемое значение:
//  Строка - текст лога
//
Функция СобратьЛог(ДнейИстории = 30, ИмяОбъекта = "") Экспорт

	Лог = Новый Массив;
	НачалоСбора = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Начало = НачалоДня(ТекущаяДатаСеанса()) - ДнейИстории * 86400;

	// Привилегированный режим нужен, чтобы ограничения доступа не скрыли строки агрегатов; в безопасном режиме
	// он недоступен, тогда запросы идут с правами пользователя.
	Попытка
		УстановитьПривилегированныйРежим(Истина);
	Исключение
		Лог.Добавить("Привилегированный режим не установлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Настройки = НастройкиРаспространения(ИмяОбъекта);

	ДобавитьРаздел(Лог, "0. Общие сведения");
	Попытка
		РазделОбщиеСведения(Лог, ДнейИстории, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "1. Классы лимитов");
	Попытка
		РазделКлассыЛимитов(Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "2. Настройки обработки распространения правил");
	Попытка
		РазделНастройки(Лог, Настройки);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "3. Лимиты эталонных установок и число портфелей с порогами по ним");
	Лимиты = Неопределено;
	Попытка
		Лимиты = РазделЛимитыЭталонов(Лог, Настройки);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "4. Пороги недавно распространенных клиентов в кэше настроек лимитов");
	Попытка
		РазделКэшНовыхКлиентов(Лог, Настройки, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "5. Время тяжелых частей записи порога (версия и кэш лимита) без записи в базу");
	Попытка
		РазделВремяВерсииИКэша(Лог, Лимиты);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "6. Повторные установки лимитов по портфелю и классу за период");
	Попытка
		РазделПовторныеУстановки(Лог, Начало);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	Лог.Добавить("");
	Лог.Добавить("Сбор завершен за " + ФорматЧисла(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСбора) + " мс");

	УстановитьПривилегированныйРежим(Ложь);

	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

// Собирает лог в фоновом задании (ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки): нужно для проверки
// на разработческой базе, где во внешнем соединении не компилируется модуль объекта справочника Лимиты.
//
// Параметры:
//  Параметры - Структура - ДнейИстории (Число), ИмяОбъекта (Строка)
//  АдресРезультата - Строка - адрес временного хранилища для текста лога
//
Процедура СобратьЛогВФоне(Параметры, АдресРезультата) Экспорт

	ПоместитьВоВременноеХранилище(СобратьЛог(Параметры.ДнейИстории, Параметры.ИмяОбъекта), АдресРезультата);

КонецПроцедуры

#КонецОбласти

#Область Разделы

// Выводит дату сбора, конфигурацию, базу, константу классов лимитов, опцию и настройки версионирования лимитов,
// установок лимитов и портфелей, число версий лимитов за период (с данными и без данных).
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  ДнейИстории - Число - глубина истории в днях
//  Начало - Дата - начало периода
//
Процедура РазделОбщиеСведения(Лог, ДнейИстории, Начало)

	Лог.Добавить("Версия диагностики: 1 (03.11.2026)");
	Лог.Добавить("Дата сбора: " + ЗначениеСтрокой(ТекущаяДатаСеанса()));
	Лог.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);
	Лог.Добавить("База: " + ИмяБазы());
	Лог.Добавить("Глубина истории: " + ФорматЧисла(ДнейИстории) + " дн., с " + ЗначениеСтрокой(Начало));
	Попытка
		Лог.Добавить("Константа ИспользоватьКлассыЛимитов = " + ЗначениеСтрокой(Константы.ИспользоватьКлассыЛимитов.Получить()));
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;
	Лог.Добавить("Функциональная опция ИспользоватьВерсионированиеОбъектов = "
		+ ЗначениеСтрокой(ПолучитьФункциональнуюОпцию("ИспользоватьВерсионированиеОбъектов")));

	ВывестиЗапрос(Лог, "0.1. Настройки версионирования лимитов, установок лимитов и портфелей",
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(НастройкиВерсий.ТипОбъекта КАК Справочник.ИдентификаторыОбъектовМетаданных).ПолноеИмя КАК Объект,
	|	НастройкиВерсий.Вариант КАК Вариант
	|ИЗ
	|	РегистрСведений.НастройкиВерсионированияОбъектов КАК НастройкиВерсий
	|ГДЕ
	|	ВЫРАЗИТЬ(НастройкиВерсий.ТипОбъекта КАК Справочник.ИдентификаторыОбъектовМетаданных).ПолноеИмя В (&Имена)",
		Новый Структура("Имена", СтрРазделить("Справочник.Лимиты,Документ.УстановкаЛимитов,Справочник.Портфели", ",")));

	ВывестиЗапрос(Лог, "0.2. Версии элементов справочника Лимиты за период: с данными и без данных версии",
	"ВЫБРАТЬ
	|	ВерсииОбъектов.ЕстьДанныеВерсии КАК ЕстьДанные,
	|	КОЛИЧЕСТВО(*) КАК Версий,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВерсииОбъектов.Объект) КАК Лимитов
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект ССЫЛКА Справочник.Лимиты
	|	И ВерсииОбъектов.ДатаВерсии >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	ВерсииОбъектов.ЕстьДанныеВерсии",
		Новый Структура("Начало", Начало));

КонецПроцедуры

// Выводит классы лимитов: признак расширенного подтверждения, число лимитов и подтвержденных лимитов, и признак
// "проверка лимитов берет пороги из кэша" (классы лимитов используются и у класса расширенное подтверждение).
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура РазделКлассыЛимитов(Лог)

	ВывестиЗапрос(Лог, "1.1. Классы лимитов",
	"ВЫБРАТЬ
	|	КлассыЛимитов.Наименование КАК Класс,
	|	КлассыЛимитов.РасширенноеПодтверждение КАК РасширенноеПодтверждение,
	|	КОЛИЧЕСТВО(Лимиты.Ссылка) КАК Лимитов,
	|	СУММА(ВЫБОР
	|			КОГДА Лимиты.Подтвержден
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Подтверждено
	|ИЗ
	|	Справочник.КлассыЛимитов КАК КлассыЛимитов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лимиты КАК Лимиты
	|		ПО (Лимиты.КлассЛимита = КлассыЛимитов.Ссылка)
	|			И (НЕ Лимиты.ПометкаУдаления)
	|ГДЕ
	|	НЕ КлассыЛимитов.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	КлассыЛимитов.Наименование,
	|	КлассыЛимитов.РасширенноеПодтверждение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Класс", Новый Структура);

КонецПроцедуры

// Выводит настройки обработки распространения, которые влияют на решение: режим розницы, классы лимитов и их
// расширенное подтверждение, сервисные пользователи (служебные учетные записи по имени, остальные маской),
// типы клиентов.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Настройки - Структура, Неопределено - настройки обработки распространения
//
Процедура РазделНастройки(Лог, Настройки)

	Если Настройки = Неопределено Тогда
		Лог.Добавить("Обработка внРаспространениеПравилСОдногоКлиентаНаСписокКлиентов не найдена или без настроек");
		Возврат;
	КонецЕсли;
	Лог.Добавить("ЭтоБазаРозничногоДУ = " + ЗначениеСтрокой(ЗначениеНастройки(Настройки, "ЭтоБазаРозничногоДУ")));
	Для Каждого ИмяКласса Из СтрРазделить("КлассЛимитовКомплаенс,КлассЛимитовРиски", ",") Цикл
		Класс = ЗначениеНастройки(Настройки, ИмяКласса);
		Расширенное = Неопределено;
		Если ЗначениеЗаполнено(Класс) Тогда
			Расширенное = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Класс, "РасширенноеПодтверждение");
		КонецЕсли;
		Лог.Добавить(СтрШаблон("%1 = %2; РасширенноеПодтверждение = %3", ИмяКласса, ЗначениеСтрокой(Класс),
			ЗначениеСтрокой(Расширенное)));
	КонецЦикла;

	СервисныеПользователи = ЗначениеНастройки(Настройки, "СписокСервисныхПользователей");
	Имена = Новый Массив;
	Если ТипЗнч(СервисныеПользователи) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент Из СервисныеПользователи Цикл
			Имена.Добавить(МаскаПользователя(Элемент.Значение));
		КонецЦикла;
	КонецЕсли;
	Лог.Добавить("СписокСервисныхПользователей (" + ФорматЧисла(Имена.Количество()) + "): " + СтрСоединить(Имена, ", "));

	Для Каждого ИмяСписка Из СтрРазделить("СписокТиповКлиентовКомплаенс,СписокТиповКлиентовРиски", ",") Цикл
		Типы = ЗначениеНастройки(Настройки, ИмяСписка);
		Значения = Новый Массив;
		Если ТипЗнч(Типы) = Тип("СписокЗначений") Тогда
			Для Каждого Элемент Из Типы Цикл
				Значения.Добавить(ЗначениеСтрокой(Элемент.Значение));
			КонецЦикла;
		КонецЕсли;
		Лог.Добавить(ИмяСписка + ": " + СтрСоединить(Значения, ", "));
	КонецЦикла;

КонецПроцедуры

// Выводит лимиты действующих установок эталонных портфелей (эталоны - значения сведений "эталонный портфель лимитов"
// из настроек обработки) и по каждому лимиту - число записей и портфелей в регистре ПорогиЛимитов. Время записи
// одного порога в обычном ФО растет с числом портфелей с порогом по лимиту.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Настройки - Структура, Неопределено - настройки обработки распространения
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - лимиты эталонов: Лимит, Класс, Расширенное, Подтвержден, Записей, Портфелей
//
Функция РазделЛимитыЭталонов(Лог, Настройки)

	Свойства = СвойстваНастроек(Настройки, "Эталонный_портфель_лимитов_комплаенс,Эталонный_портфель_лимитов_риски");
	Если Не ЗначениеЗаполнено(Свойства) Тогда
		Лог.Добавить("В настройках нет свойств эталонного портфеля лимитов");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Сведения.Значение КАК Справочник.Портфели) КАК Эталон
	|ПОМЕСТИТЬ ВТЭталоны
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Сведения
	|ГДЕ
	|	Сведения.Свойство В(&Свойства)
	|	И Сведения.Значение ССЫЛКА Справочник.Портфели
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Эталон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Срез.Регистратор КАК Установка
	|ПОМЕСТИТЬ ВТУстановки
	|ИЗ
	|	РегистрСведений.ДействующиеЛимитыПоПортфелю.СрезПоследних(
	|			,
	|			Портфель В
	|					(ВЫБРАТЬ
	|						ВТЭталоны.Эталон
	|					ИЗ
	|						ВТЭталоны КАК ВТЭталоны)
	|				И Регистратор ССЫЛКА Документ.УстановкаЛимитов) КАК Срез
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиЛимитов.Лимит КАК Лимит
	|ПОМЕСТИТЬ ВТЛимиты
	|ИЗ
	|	Документ.УстановкаЛимитов.Лимиты КАК СтрокиЛимитов
	|ГДЕ
	|	СтрокиЛимитов.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТУстановки.Установка
	|			ИЗ
	|				ВТУстановки КАК ВТУстановки)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Лимит
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Пороги.Лимит КАК Лимит,
	|	КОЛИЧЕСТВО(*) КАК Записей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Пороги.Портфель) КАК Портфелей
	|ПОМЕСТИТЬ ВТПороги
	|ИЗ
	|	РегистрСведений.ПорогиЛимитов КАК Пороги
	|ГДЕ
	|	Пороги.Лимит В
	|			(ВЫБРАТЬ
	|				ВТЛимиты.Лимит
	|			ИЗ
	|				ВТЛимиты КАК ВТЛимиты)
	|
	|СГРУППИРОВАТЬ ПО
	|	Пороги.Лимит
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Эталонов
	|ИЗ
	|	ВТЭталоны КАК ВТЭталоны
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Установок
	|ИЗ
	|	ВТУстановки КАК ВТУстановки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЛимиты.Лимит КАК Лимит,
	|	ВТЛимиты.Лимит.КлассЛимита КАК Класс,
	|	ВТЛимиты.Лимит.КлассЛимита.РасширенноеПодтверждение КАК Расширенное,
	|	ВТЛимиты.Лимит.Подтвержден КАК Подтвержден,
	|	ЕСТЬNULL(ВТПороги.Записей, 0) КАК Записей,
	|	ЕСТЬNULL(ВТПороги.Портфелей, 0) КАК Портфелей
	|ИЗ
	|	ВТЛимиты КАК ВТЛимиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПороги КАК ВТПороги
	|		ПО ВТЛимиты.Лимит = ВТПороги.Лимит
	|
	|УПОРЯДОЧИТЬ ПО
	|	Портфелей УБЫВ";
	Запрос.УстановитьПараметр("Свойства", Свойства);

	НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Результаты = Запрос.ВыполнитьПакет();
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса;
	Эталонов = Результаты[Результаты.ВГраница() - 2].Выгрузить()[0].Эталонов;
	Установок = Результаты[Результаты.ВГраница() - 1].Выгрузить()[0].Установок;
	Лимиты = Результаты[Результаты.ВГраница()].Выгрузить();

	Лог.Добавить(СтрШаблон("Время запроса: %1 мс; эталонных портфелей: %2; действующих установок эталонов: %3; лимитов: %4",
		ФорматЧисла(Длительность), ФорматЧисла(Эталонов), ФорматЧисла(Установок),
		ФорматЧисла(Лимиты.Количество())));

	Сводка = Новый ТаблицаЗначений;
	Сводка.Колонки.Добавить("Класс");
	Сводка.Колонки.Добавить("Расширенное");
	Сводка.Колонки.Добавить("Лимитов");
	Сводка.Колонки.Добавить("Подтверждено");
	Сводка.Колонки.Добавить("ПортфелейМин");
	Сводка.Колонки.Добавить("ПортфелейМедиана");
	Сводка.Колонки.Добавить("ПортфелейСреднее");
	Сводка.Колонки.Добавить("ПортфелейМакс");
	Классы = Лимиты.Скопировать(, "Класс, Расширенное");
	Классы.Свернуть("Класс, Расширенное");
	Для Каждого СтрокаКласса Из Классы Цикл
		Строки = Лимиты.НайтиСтроки(Новый Структура("Класс", СтрокаКласса.Класс));
		Значения = Новый Массив;
		Подтверждено = 0;
		Для Каждого СтрокаЛимита Из Строки Цикл
			Значения.Добавить(СтрокаЛимита.Портфелей);
			Если СтрокаЛимита.Подтвержден Тогда
				Подтверждено = Подтверждено + 1;
			КонецЕсли;
		КонецЦикла;
		НоваяСтрока = Сводка.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКласса);
		НоваяСтрока.Лимитов          = Строки.Количество();
		НоваяСтрока.Подтверждено     = Подтверждено;
		НоваяСтрока.ПортфелейМин     = Минимум(Значения);
		НоваяСтрока.ПортфелейМедиана = Медиана(Значения);
		НоваяСтрока.ПортфелейСреднее = Окр(Сумма(Значения) / Макс(Значения.Количество(), 1));
		НоваяСтрока.ПортфелейМакс    = Максимум(Значения);
	КонецЦикла;
	Лог.Добавить("");
	Лог.Добавить("--- 3.1. Сводка по классам: портфелей с порогом на один лимит эталона");
	ВывестиТаблицу(Лог, Сводка, 20);

	Лог.Добавить("");
	Лог.Добавить("--- 3.2. Лимиты эталонов с наибольшим числом портфелей с порогом");
	ВывестиТаблицу(Лог, Лимиты, 25);

	Возврат Лимиты;

КонецФункции

// Проверяет, есть ли пороги недавно распространенных клиентов (дата распространения правил за период) в таблице
// порогов кэша настроек лимита (КэшНастроекЛимитов.Настройки, ПорогиЛимита). Для лимитов классов с расширенным
// подтверждением проверка лимитов берет пороги только из кэша; для остальных - из регистра ПорогиЛимитов.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Настройки - Структура, Неопределено - настройки обработки распространения
//  Начало - Дата - начало периода
//
Процедура РазделКэшНовыхКлиентов(Лог, Настройки, Начало)

	Свойства = СвойстваНастроек(Настройки, "Дата_распространения_правил_комплаенс,Дата_распространения_правил_риски");
	Если Не ЗначениеЗаполнено(Свойства) Тогда
		Лог.Добавить("В настройках нет свойств даты распространения правил");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Сведения.Объект КАК Портфель,
	|	МАКСИМУМ(ВЫРАЗИТЬ(Сведения.Значение КАК Дата)) КАК ДатаРаспространения
	|ПОМЕСТИТЬ ВТКлиенты
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Сведения
	|ГДЕ
	|	Сведения.Свойство В(&Свойства)
	|	И Сведения.Объект ССЫЛКА Справочник.Портфели
	|	И ВЫРАЗИТЬ(Сведения.Значение КАК Дата) >= &Начало
	|
	|СГРУППИРОВАТЬ ПО
	|	Сведения.Объект
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаРаспространения УБЫВ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Портфель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Пороги.Портфель КАК Портфель,
	|	Пороги.Лимит КАК Лимит,
	|	Пороги.Лимит.КлассЛимита.РасширенноеПодтверждение КАК Расширенное
	|ИЗ
	|	РегистрСведений.ПорогиЛимитов КАК Пороги
	|ГДЕ
	|	Пороги.Портфель В
	|			(ВЫБРАТЬ
	|				ВТКлиенты.Портфель
	|			ИЗ
	|				ВТКлиенты КАК ВТКлиенты)";
	Запрос.УстановитьПараметр("Свойства", Свойства);
	Запрос.УстановитьПараметр("Начало", Начало);
	Пары = Запрос.Выполнить().Выгрузить();

	Лимиты = Пары.Скопировать(, "Лимит");
	Лимиты.Свернуть("Лимит");
	ПортфелиКэша = Новый Соответствие;
	СостояниеКэша = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кэш.Лимит КАК Лимит,
	|	Кэш.Настройки КАК Настройки
	|ИЗ
	|	РегистрСведений.КэшНастроекЛимитов КАК Кэш
	|ГДЕ
	|	Кэш.Лимит В(&Лимиты)";
	Запрос.УстановитьПараметр("Лимиты", Лимиты.ВыгрузитьКолонку("Лимит"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НастройкиЛимита = Неопределено;
		Если ТипЗнч(Выборка.Настройки) = Тип("ХранилищеЗначения") Тогда
			НастройкиЛимита = Выборка.Настройки.Получить();
		КонецЕсли;
		ТаблицаПорогов = Неопределено;
		Если ТипЗнч(НастройкиЛимита) = Тип("Структура") Тогда
			НастройкиЛимита.Свойство("ПорогиЛимита", ТаблицаПорогов);
		КонецЕсли;
		Если ТипЗнч(ТаблицаПорогов) = Тип("ТаблицаЗначений") И ТаблицаПорогов.Колонки.Найти("Портфель") <> Неопределено Тогда
			Портфели = Новый Соответствие;
			Для Каждого СтрокаПорога Из ТаблицаПорогов Цикл
				Портфели.Вставить(СтрокаПорога.Портфель, Истина);
			КонецЦикла;
			ПортфелиКэша.Вставить(Выборка.Лимит, Портфели);
			СостояниеКэша.Вставить(Выборка.Лимит, "есть таблица порогов");
		Иначе
			СостояниеКэша.Вставить(Выборка.Лимит, "нет таблицы порогов");
		КонецЕсли;
	КонецЦикла;

	Итоги = Новый ТаблицаЗначений;
	Итоги.Колонки.Добавить("Расширенное");
	Итоги.Колонки.Добавить("СостояниеКэша");
	Итоги.Колонки.Добавить("ПарПортфельЛимит");
	Итоги.Колонки.Добавить("ПортфельВКэше");
	Итоги.Колонки.Добавить("ПортфеляНетВКэше");
	Для Каждого Пара Из Пары Цикл
		Состояние = СостояниеКэша[Пара.Лимит];
		Если Состояние = Неопределено Тогда
			Состояние = "нет записи кэша";
		КонецЕсли;
		Строки = Итоги.НайтиСтроки(Новый Структура("Расширенное, СостояниеКэша", Пара.Расширенное, Состояние));
		Если Строки.Количество() = 0 Тогда
			СтрокаИтога = Итоги.Добавить();
			СтрокаИтога.Расширенное      = Пара.Расширенное;
			СтрокаИтога.СостояниеКэша    = Состояние;
			СтрокаИтога.ПарПортфельЛимит = 0;
			СтрокаИтога.ПортфельВКэше    = 0;
			СтрокаИтога.ПортфеляНетВКэше = 0;
		Иначе
			СтрокаИтога = Строки[0];
		КонецЕсли;
		СтрокаИтога.ПарПортфельЛимит = СтрокаИтога.ПарПортфельЛимит + 1;
		Портфели = ПортфелиКэша[Пара.Лимит];
		Если Портфели <> Неопределено И Портфели[Пара.Портфель] = Истина Тогда
			СтрокаИтога.ПортфельВКэше = СтрокаИтога.ПортфельВКэше + 1;
		ИначеЕсли Портфели <> Неопределено Тогда
			СтрокаИтога.ПортфеляНетВКэше = СтрокаИтога.ПортфеляНетВКэше + 1;
		КонецЕсли;
	КонецЦикла;

	Клиенты = Пары.Скопировать(, "Портфель");
	Клиенты.Свернуть("Портфель");
	Лог.Добавить(СтрШаблон("Клиентов с порогами и датой распространения за период (не более 200 последних): %1; пар "
		+ "портфель-лимит с порогом: %2; лимитов: %3", ФорматЧисла(Клиенты.Количество()),
		ФорматЧисла(Пары.Количество()), ФорматЧисла(Лимиты.Количество())));
	Лог.Добавить("");
	Лог.Добавить("--- 4.1. Есть ли порог клиента в таблице порогов кэша настроек лимита");
	ВывестиТаблицу(Лог, Итоги, 20);

КонецПроцедуры

// Замеряет без записи в базу время тяжелых частей записи одного порога в обычном ФО для лимитов эталонов с наибольшим
// числом портфелей с порогом: таблица порогов лимита по всем портфелям (запрос), сериализация объекта лимита,
// контрольная сумма данных версии (как при создании версии), сжатие данных версии (как при записи версии с данными),
// расчет настроек лимита для кэша. Ничего не записывает.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Лимиты - ТаблицаЗначений, Неопределено - лимиты эталонов из раздела 3 (упорядочены по числу портфелей)
//
Процедура РазделВремяВерсииИКэша(Лог, Лимиты)

	Если Лимиты = Неопределено Или Лимиты.Количество() = 0 Тогда
		Лог.Добавить("Нет лимитов эталонов (раздел 3)");
		Возврат;
	КонецЕсли;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Лимит");
	Таблица.Колонки.Добавить("Портфелей");
	Таблица.Колонки.Добавить("ЗапросПороговМс");
	Таблица.Колонки.Добавить("СериализацияМс");
	Таблица.Колонки.Добавить("КонтрольнаяСуммаМс");
	Таблица.Колонки.Добавить("СжатиеМс");
	Таблица.Колонки.Добавить("РасчетКэшаМс");
	Таблица.Колонки.Добавить("ОценкаНаПорогМс");

	Для Индекс = 0 По Мин(5, Лимиты.Количество()) - 1 Цикл
		Лимит = Лимиты[Индекс].Лимит;
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Лимит     = Лимит;
		НоваяСтрока.Портфелей = Лимиты[Индекс].Портфелей;
		Попытка
			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ТаблицаПорогов = РегистрыСведений.ПорогиЛимитов.СписокНастроекПороговПоЛимиту(Лимит);
			НоваяСтрока.ЗапросПороговМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ДанныеВерсии = Новый Структура;
			ДанныеВерсии.Вставить("Объект", ВерсионированиеОбъектов.СериализоватьОбъект(Лимит.ПолучитьОбъект()));
			ДанныеВерсии.Вставить("НастройкиПороговДляПроверкиЛимитов", ТаблицаПорогов);
			НоваяСтрока.СериализацияМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ВерсионированиеОбъектов.КонтрольнаяСумма(ДанныеВерсии);
			НоваяСтрока.КонтрольнаяСуммаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Хранилище = Новый ХранилищеЗначения(ДанныеВерсии, Новый СжатиеДанных(9));
			НоваяСтрока.СжатиеМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			НастройкиЛимита = Справочники.Лимиты.НастройкиВнутреннейПроверкиЛимита_Расчет(Лимит);
			Хранилище = Новый ХранилищеЗначения(НастройкиЛимита);
			НоваяСтрока.РасчетКэшаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

			// Запись порога: заполнение прошлой версии (запрос порогов, сериализация, сжатие), новая версия (дважды
			// данные версии с контрольной суммой), кэш (расчет настроек).
			НоваяСтрока.ОценкаНаПорогМс = НоваяСтрока.ЗапросПороговМс + НоваяСтрока.СериализацияМс + НоваяСтрока.СжатиеМс
				+ 2 * (НоваяСтрока.ЗапросПороговМс + НоваяСтрока.СериализацияМс + НоваяСтрока.КонтрольнаяСуммаМс)
				+ НоваяСтрока.РасчетКэшаМс;
		Исключение
			ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;
	Лог.Добавить("Оценка на порог = заполнение прошлой версии + 2 x данные новой версии + расчет кэша (без записи в базу)");
	ВывестиТаблицу(Лог, Таблица, 10);

КонецПроцедуры

// Выводит портфели, у которых за период создано больше одной установки лимитов по портфелю одного класса в один день.
// При записи сведения "эталонный портфель лимитов" подписка запускает фоновое распространение; если служебный
// пользователь обмена не в списке сервисных, фоновое задание может создать установку параллельно с основной.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Начало - Дата - начало периода
//
Процедура РазделПовторныеУстановки(Лог, Начало)

	ВывестиЗапрос(Лог, "6.1. Портфель и класс с несколькими проведенными установками по портфелю за один день",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Установки.Дата, ДЕНЬ) КАК День,
	|	Установки.КлассЛимита КАК Класс,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Установки.ОбъектНазначения) КАК Портфелей,
	|	КОЛИЧЕСТВО(*) КАК Установок
	|ПОМЕСТИТЬ ВТДни
	|ИЗ
	|	Документ.УстановкаЛимитов КАК Установки
	|ГДЕ
	|	Установки.Дата >= &Начало
	|	И Установки.Проведен
	|	И Установки.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийУстановкиЛимитов.ПоПортфелю)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Установки.Дата, ДЕНЬ),
	|	Установки.КлассЛимита,
	|	Установки.ОбъектНазначения
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДни.День КАК День,
	|	ВТДни.Класс КАК Класс,
	|	СУММА(ВТДни.Портфелей) КАК Портфелей,
	|	СУММА(ВТДни.Установок) КАК Установок
	|ИЗ
	|	ВТДни КАК ВТДни
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДни.День,
	|	ВТДни.Класс
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ", Новый Структура("Начало", Начало), 40);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает настройки обработки распространения правил из справочника дополнительных обработок.
//
// Параметры:
//  ИмяОбъекта - Строка - имя объекта обработки; пусто - внРаспространениеПравилСОдногоКлиентаНаСписокКлиентов
//
// Возвращаемое значение:
//  Структура, Неопределено - настройки
//
Функция НастройкиРаспространения(ИмяОбъекта)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	Обработки.ИмяОбъекта = &ИмяОбъекта
	|	И НЕ Обработки.ПометкаУдаления");
	Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
		Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Иначе
		Запрос.УстановитьПараметр("ИмяОбъекта", "внРаспространениеПравилСОдногоКлиентаНаСписокКлиентов");
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Настройки = Выборка.Ссылка.ХранилищеНастроек.Получить();
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Возврат Настройки;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Возвращает заполненные значения настроек с указанными именами.
//
// Параметры:
//  Настройки - Структура, Неопределено - настройки обработки
//  Имена - Строка - имена настроек через запятую
//
// Возвращаемое значение:
//  Массив - заполненные значения
//
Функция СвойстваНастроек(Настройки, Имена)

	Результат = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Значение = ЗначениеНастройки(Настройки, Имя);
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает значение из структуры настроек.
//
// Параметры:
//  Настройки - Структура, Неопределено - настройки обработки
//  ИмяНастройки - Строка - имя настройки
//
// Возвращаемое значение:
//  Произвольный - значение или Неопределено
//
Функция ЗначениеНастройки(Настройки, ИмяНастройки)

	Значение = Неопределено;
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки.Свойство(ИмяНастройки, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Минимум массива чисел (0 для пустого).
//
// Параметры:
//  Значения - Массив из Число
//
// Возвращаемое значение:
//  Число
//
Функция Минимум(Значения)

	Если Значения.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Результат = Значения[0];
	Для Каждого Значение Из Значения Цикл
		Результат = Мин(Результат, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Максимум массива чисел (0 для пустого).
//
// Параметры:
//  Значения - Массив из Число
//
// Возвращаемое значение:
//  Число
//
Функция Максимум(Значения)

	Результат = 0;
	Для Каждого Значение Из Значения Цикл
		Результат = Макс(Результат, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сумма массива чисел.
//
// Параметры:
//  Значения - Массив из Число
//
// Возвращаемое значение:
//  Число
//
Функция Сумма(Значения)

	Результат = 0;
	Для Каждого Значение Из Значения Цикл
		Результат = Результат + Значение;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Медиана массива чисел (0 для пустого).
//
// Параметры:
//  Значения - Массив из Число
//
// Возвращаемое значение:
//  Число
//
Функция Медиана(Значения)

	Если Значения.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Значения);
	Список.СортироватьПоЗначению();
	Возврат Список[Цел(Список.Количество() / 2)].Значение;

КонецФункции

// Выполняет запрос, выводит время выполнения, число строк и таблицу результата. Ошибка запроса
// выводится в лог и не прерывает сбор.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Заголовок - Строка - заголовок блока
//  ТекстЗапроса - Строка - текст запроса
//  Параметры - Структура - параметры запроса
//  МаксимумСтрок - Число - предел выводимых строк
//
Процедура ВывестиЗапрос(Лог, Заголовок, ТекстЗапроса, Параметры, МаксимумСтрок = 100)

	Лог.Добавить("");
	Лог.Добавить("--- " + Заголовок);
	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Попытка
		НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Таблица = Запрос.Выполнить().Выгрузить();
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса;
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Лог.Добавить(СтрШаблон("Время запроса: %1 мс; строк: %2", ФорматЧисла(Длительность), ФорматЧисла(Таблица.Количество())));
	ВывестиТаблицу(Лог, Таблица, МаксимумСтрок);

КонецПроцедуры

// Выводит таблицу значений строками с разделителем " | ".
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Таблица - ТаблицаЗначений - данные
//  МаксимумСтрок - Число - предел выводимых строк
//
Процедура ВывестиТаблицу(Лог, Таблица, МаксимумСтрок)

	Имена = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;
	Лог.Добавить(СтрСоединить(Имена, " | "));

	Номер = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Номер = Номер + 1;
		Если Номер > МаксимумСтрок Тогда
			Лог.Добавить("... еще строк: " + ФорматЧисла(Таблица.Количество() - МаксимумСтрок));
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значения.Добавить(ЗначениеСтрокой(СтрокаТаблицы[Колонка.Имя]));
		КонецЦикла;
		Лог.Добавить(СтрСоединить(Значения, " | "));
	КонецЦикла;

КонецПроцедуры

// Возвращает представление пользователя для лога: служебные учетные записи (svc) - как есть, остальные - маской,
// чтобы в лог не попадали имена сотрудников.
//
// Параметры:
//  Значение - СправочникСсылка.Пользователи, Произвольный - пользователь
//
// Возвращаемое значение:
//  Строка - имя служебной учетной записи или "<пользователь>"
//
Функция МаскаПользователя(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "-";
	КонецЕсли;
	Представление = СокрЛП(Строка(Значение));
	Если СтрНайти(НРег(Представление), "svc") > 0 Тогда
		Возврат Представление;
	КонецЕсли;
	Возврат "<пользователь>";

КонецФункции

// Возвращает представление значения для лога.
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ЗначениеСтрокой(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧРД=.");
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'; ДП=-");
	ИначеЕсли Тип = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Возвращает число без разделителей групп, ноль как "0".
//
// Параметры:
//  Значение - Число - число
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ФорматЧисла(Значение)

	Возврат Формат(Значение, "ЧН=0; ЧГ=0");

КонецФункции

// Возвращает имя информационной базы на сервере 1С из строки соединения.
//
// Возвращаемое значение:
//  Строка - имя базы или строка соединения целиком для файловой базы
//
Функция ИмяБазы()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Позиция = СтрНайти(СтрокаСоединения, "Ref=");
	Если Позиция = 0 Тогда
		Возврат СтрокаСоединения;
	КонецЕсли;
	Остаток = Сред(СтрокаСоединения, Позиция + 5);
	Возврат Лев(Остаток, СтрНайти(Остаток, """") - 1);

КонецФункции

// Добавляет заголовок раздела.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Заголовок - Строка - заголовок
//
Процедура ДобавитьРаздел(Лог, Заголовок)

	Лог.Добавить("");
	Лог.Добавить("==================== " + Заголовок);

КонецПроцедуры

// Добавляет в лог краткое представление ошибки.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Информация - ИнформацияОбОшибке - ошибка
//
Процедура ДобавитьОшибку(Лог, Информация)

	Лог.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(Информация));

КонецПроцедуры

#КонецОбласти

#КонецЕсли
