#Область ОбработчикиСобытийФормы

// Заполняет строку соединения базы для контроля, в какой базе формируется отчет.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Читает депозиты Calipso (на сервере 1С или на компьютере пользователя), ищет их в ФО так же, как ежедневная
// загрузка депозитов, и формирует отчет HTML. Данные базы не меняются.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Сформировать(Команда)

	ТекстHTML = "";
	Результат = "Выполняется чтение депозитов Calipso...";
	ЧтениеНаКлиенте = Неопределено;
	Если ЧитатьСКомпьютераПользователя Тогда
#Если ВебКлиент Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			"Подключение с компьютера пользователя доступно только в тонком клиенте Windows");
		Возврат;
#Иначе
		ЧтениеНаКлиенте = ПрочитатьCalipsoНаКлиенте(ПараметрыЧтенияCalipso());
#КонецЕсли
	КонецЕсли;
	СформироватьНаСервере(ЧтениеНаКлиенте);

КонецПроцедуры

// Сохраняет отчет HTML в файл на компьютере пользователя (UTF-8).
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьHTML(Команда)

	Если Не ЗначениеЗаполнено(ТекстHTML) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала сформируйте отчет");
		Возврат;
	КонецЕсли;

	ИмяФайла = "Депозиты_Calipso_" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".html";
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресФайла(), ИмяФайла);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает депозиты (если они не прочитаны на клиенте) и формирует отчет модулем объекта.
//
// Параметры:
//  ЧтениеНаКлиенте - Структура, Неопределено - результат чтения на клиенте: Строки, Ошибка; Неопределено - читать
//                    на сервере 1С
//
&НаСервере
Процедура СформироватьНаСервере(ЧтениеНаКлиенте)

	Обработка = РеквизитФормыВЗначение("Объект");
	Если ЧтениеНаКлиенте = Неопределено Тогда
		Чтение = Обработка.ПрочитатьДепозитыCalipso();
		Чтение.Вставить("Способ", "с сервера 1С");
	Иначе
		Чтение = ЧтениеНаКлиенте;
		Чтение.Вставить("Способ", "с компьютера пользователя");
	КонецЕсли;

	Отчет = Обработка.СформироватьОтчет(Чтение);
	ТекстHTML = Отчет.HTML;
	Результат = Отчет.Сводка;

КонецПроцедуры

// Возвращает параметры подключения к SQL-серверу Calipso и текст запроса для чтения на клиенте.
//
// Возвращаемое значение:
//  Структура - см. ПараметрыЧтенияCalipso модуля объекта
//
&НаСервере
Функция ПараметрыЧтенияCalipso()

	Возврат РеквизитФормыВЗначение("Объект").ПараметрыЧтенияCalipso();

КонецФункции

#Если Не ВебКлиент Тогда

// Читает депозиты Calipso с компьютера пользователя тем же запросом, что и на сервере. Повторяет
// ПрочитатьДепозитыCalipso модуля объекта: модуль объекта на клиенте управляемого приложения недоступен.
//
// Параметры:
//  Параметры - Структура - СтрокаПодключения, Сервер, ТаймаутПодключения, ТаймаутКоманды, ТекстЗапроса
//
// Возвращаемое значение:
//  Структура - Строки (Массив из Структура - поля строки результата запроса), Ошибка (Строка)
//
&НаКлиенте
Функция ПрочитатьCalipsoНаКлиенте(Параметры)

	Чтение = Новый Структура("Строки, Ошибка", Новый Массив, "");
	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionString = Параметры.СтрокаПодключения;
		Соединение.ConnectionTimeOut = Параметры.ТаймаутПодключения;
		Соединение.CommandTimeout = Параметры.ТаймаутКоманды;
		Соединение.Open();
	Исключение
		Чтение.Ошибка = "Ошибка подключения к серверу " + Параметры.Сервер + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Чтение;
	КонецПопытки;

	Попытка
		Команда = Новый COMОбъект("ADODB.Command");
		Команда.ActiveConnection = Соединение;
		Команда.CommandText = Параметры.ТекстЗапроса;
		Команда.CommandType = 1;
		Набор = Команда.Execute();
		Пока Набор.EOF() = 0 Цикл
			Поля = Новый Структура;
			Для Индекс = 0 По Набор.Fields.Count - 1 Цикл
				Поле = Набор.Fields.Item(Индекс);
				Поля.Вставить(Поле.Name, ПримитивноеЗначение(Поле.Value));
			КонецЦикла;
			Чтение.Строки.Добавить(Поля);
			Набор.MoveNext();
		КонецЦикла;
	Исключение
		Чтение.Ошибка = "Ошибка выполнения запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		Соединение.Close();
	Исключение
		// Соединение закрывается при освобождении объекта, ошибка закрытия на результат не влияет.
	КонецПопытки;

	Возврат Чтение;

КонецФункции

// Приводит значение поля ADODB к типу, который передается на сервер: строка, число, дата, булево.
//
// Параметры:
//  Значение - Произвольный - значение поля
//
// Возвращаемое значение:
//  Строка, Число, Дата, Булево, Неопределено - значение
//
&НаКлиенте
Функция ПримитивноеЗначение(Значение)

	Тип = ТипЗнч(Значение);
	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Тип = Тип("Строка") Или Тип = Тип("Число") Или Тип = Тип("Дата") Или Тип = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

#КонецЕсли

// Помещает отчет HTML во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла (UTF-8 без BOM)
//
&НаСервере
Функция АдресФайла()

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстHTML, "UTF-8", Ложь);
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
