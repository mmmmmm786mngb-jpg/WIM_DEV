// Разовый отчет для бизнеса по депозитам Calipso (IMDEV-9742): читает депозиты из SQL-таблицы Calipso тем же
// запросом и с тем же подключением, что ежедневная загрузка депозитов (внЗагрузкаДепозитовИзВнешнихИсточников 1.19),
// ищет каждый депозит в ФО по тем же правилам (валюта, актив, субпортфель по маске кода счета) и формирует HTML:
// какие депозиты получены, что и в каких полях ФО ищется, найдено или нет. Данные ФО и Calipso не меняются.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает параметры подключения к SQL-серверу Calipso и текст запроса - как в обработке загрузки депозитов 1.19.
//
// Возвращаемое значение:
//  Структура - параметры:
//   * Сервер - Строка - имя SQL-сервера
//   * СтрокаПодключения - Строка - строка подключения ADODB
//   * ТаймаутПодключения - Число - секунды
//   * ТаймаутКоманды - Число - секунды
//   * ТекстЗапроса - Строка - запрос к таблице депозитов Calipso
//
Функция ПараметрыЧтенияCalipso() Экспорт

	// Сервер, база и учетная запись - как в ЗаполнитьДепозитыКалипсо обработки загрузки депозитов 1.19.
	Сервер = "AMDBRATES\DBMVTBAM01";
	СтрокаПодключения = "Provider=SQLOLEDB;Data Source=" + Сервер + ";Initial Catalog=MasterData;"
		+ "UID=svc_ratesuploader;PWD=5E-20-5A-2D-5C-B9";

	Параметры = Новый Структура;
	Параметры.Вставить("Сервер", Сервер);
	Параметры.Вставить("СтрокаПодключения", СтрокаПодключения);
	Параметры.Вставить("ТаймаутПодключения", 15);
	Параметры.Вставить("ТаймаутКоманды", 30);
	Параметры.Вставить("ТекстЗапроса", ТекстЗапросаCalipso());
	Возврат Параметры;

КонецФункции

// Читает депозиты Calipso на сервере 1С.
//
// Возвращаемое значение:
//  Структура - Строки (Массив из Структура - поля строки результата запроса), Ошибка (Строка)
//
Функция ПрочитатьДепозитыCalipso() Экспорт

	Параметры = ПараметрыЧтенияCalipso();
	Чтение = Новый Структура("Строки, Ошибка", Новый Массив, "");
	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionString = Параметры.СтрокаПодключения;
		Соединение.ConnectionTimeOut = Параметры.ТаймаутПодключения;
		Соединение.CommandTimeout = Параметры.ТаймаутКоманды;
		Соединение.Open();
	Исключение
		Чтение.Ошибка = "Ошибка подключения к серверу " + Параметры.Сервер + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Чтение;
	КонецПопытки;

	Попытка
		Команда = Новый COMОбъект("ADODB.Command");
		Команда.ActiveConnection = Соединение;
		Команда.CommandText = Параметры.ТекстЗапроса;
		Команда.CommandType = 1;
		Набор = Команда.Execute();
		Пока Набор.EOF() = 0 Цикл
			Поля = Новый Структура;
			Для Индекс = 0 По Набор.Fields.Count - 1 Цикл
				Поле = Набор.Fields.Item(Индекс);
				Поля.Вставить(Поле.Name, ПримитивноеЗначение(Поле.Value));
			КонецЦикла;
			Чтение.Строки.Добавить(Поля);
			Набор.MoveNext();
		КонецЦикла;
	Исключение
		Чтение.Ошибка = "Ошибка выполнения запроса: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Попытка
		Соединение.Close();
	Исключение
		// Соединение закрывается при освобождении объекта, ошибка закрытия на результат не влияет.
	КонецПопытки;

	Возврат Чтение;

КонецФункции

// Ищет депозиты в ФО по правилам загрузки депозитов 1.19 и формирует отчет.
//
// Параметры:
//  Чтение - Структура - результат чтения Calipso:
//   * Строки - Массив из Структура - поля строк запроса (MX_Code, Fund, Qty, BenefitID и другие)
//   * Ошибка - Строка - текст ошибки чтения или пустая строка
//   * Способ - Строка - откуда выполнено подключение к Calipso
//
// Возвращаемое значение:
//  Структура - HTML (Строка - отчет для бизнеса, пусто при ошибке чтения), Сводка (Строка - краткий текст для формы),
//              Депозитов, Найдено (Число)
//
Функция СформироватьОтчет(Чтение) Экспорт

	Отчет = Новый Структура("HTML, Сводка, Депозитов, Найдено", "", "", 0, 0);
	Способ = "";
	Чтение.Свойство("Способ", Способ);
	Если ЗначениеЗаполнено(Чтение.Ошибка) Тогда
		Если Способ = "с сервера 1С" Тогда
			Подсказка = "Включите флажок подключения с компьютера пользователя и сформируйте отчет снова.";
		Иначе
			Подсказка = "С этого компьютера SQL-сервер Calipso недоступен. Выключите флажок, чтобы подключиться"
				+ " с сервера 1С, или запустите обработку на компьютере с доступом к Calipso.";
		КонецЕсли;
		Отчет.Сводка = Чтение.Ошибка + Символы.ПС + Символы.ПС + "Подключение к Calipso выполнялось " + Способ + ". "
			+ Подсказка;
		Возврат Отчет;
	КонецЕсли;

	Депозиты = СопоставитьДепозиты(Чтение.Строки);
	Отчет.Депозитов = Депозиты.Количество();
	Отчет.Найдено = Депозиты.НайтиСтроки(Новый Структура("Найден", Истина)).Количество();
	Отчет.HTML = ТекстHTML(Депозиты, Отчет);
	Отчет.Сводка = ТекстСводки(Депозиты, Отчет, Способ);
	Возврат Отчет;

КонецФункции

#КонецОбласти

#Область Сопоставление

// Возвращает текст запроса к Calipso: тот же отбор строк, что в обработке загрузки депозитов 1.19, плюс поля
// ProductDescription и DatePosition для описания сделки (на состав строк не влияют).
//
// Возвращаемое значение:
//  Строка - текст запроса SQL
//
Функция ТекстЗапросаCalipso()

	Возврат
	"SELECT abs([Pricer_CURRENT_NOTIONAL]+[Pricer_ACCRUAL_BO]*(-1)) as MV
	|  ,[TradeId] as MX_Code
	|  ,'CALIPSO' as [Source]
	|  ,case when [ProductDescription] like 'Deposit%' then [ProcessingOrg_ShortName] else [CounterParty_ShortName] end as ContrPartyName
	|  ,[Currency] as Fund
	|  ,case when [ProductDescription] like 'Deposit%' then [CounterParty_ShortName] else [ProcessingOrg_ShortName] end as BenefitID
	|  ,case when [ProductDescription] like 'Deposit%' then [CounterParty_FullName] else [ProcessingOrg_FullName] end as BenefitName
	|  ,abs([Pricer_CURRENT_NOTIONAL]) as Qty
	|  ,[FixedRate] as InterestRate
	|  ,[TradeDate] as OpenDate
	|  ,[MaturityDate] as MaturityDate
	|  ,[ProductDescription] as ProductDescription
	|  ,[DatePosition] as DatePosition
	|  FROM [dbo].[t_Calipso_LoanDeposit] cld
	|  where 1=1
	|  and [CounterParty_ShortName] <> [ProcessingOrg_ShortName]
	|  and [DatePosition] = (select MAX([DatePosition]) from [dbo].[t_Calipso_LoanDeposit])
	|  and not exists(select 1 FROM [dbo].[t_Calipso_LoanDeposit]
	|					where 1=1
	|						and [CounterParty_ShortName] <> [ProcessingOrg_ShortName]
	|						and [DatePosition] = (select MAX([DatePosition]) from [dbo].[t_Calipso_LoanDeposit])
	|						and cld.[MirrorTradeId] = [TradeId]
	|						and ProductDescription like 'Loan%'
	|						)";

КонецФункции

// Ищет каждый депозит в ФО по шагам загрузки депозитов 1.19: номер сделки в 36-ричной записи, маска "-D<код>-",
// субпортфель по вхождению маски в код счета (без помеченных на удаление), валюта по наименованию, актив валюты.
//
// Параметры:
//  Строки - Массив из Структура - строки запроса Calipso
//
// Возвращаемое значение:
//  ТаблицаЗначений - депозиты с результатом поиска, упорядочены по номеру сделки
//
Функция СопоставитьДепозиты(Строки)

	Депозиты = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("НомерСделки, Порядок, Продукт, КлиентКод, КлиентНаименование, Контрагент,"
		+ " ВалютаCalipso, Номинал, Ставка, ДатаСделки, ДатаПогашения, ДатаПозиции, Код36, Маска, ВалютаНайдена,"
		+ " АктивНайден, Субпортфель, Портфель, КодСчета, СовпаденийСубпортфелей, СовпаденийУдаленных, Найден,"
		+ " Результат", ",") Цикл
		Депозиты.Колонки.Добавить(СокрЛП(Имя));
	КонецЦикла;

	Для Каждого Поля Из Строки Цикл
		Депозит = Депозиты.Добавить();
		Депозит.Найден = Ложь;
		НомерСделки =ЗначениеПоля(Поля, "MX_Code");
		Депозит.НомерСделки = ?(ТипЗнч(НомерСделки) = Тип("Число"), Формат(НомерСделки, "ЧГ=0"),
			СокрЛП(Строка(НомерСделки)));
		Депозит.Порядок = ЧислоИлиНоль(НомерСделки);
		Депозит.Продукт = ЗначениеПоля(Поля, "ProductDescription");
		Депозит.КлиентКод = ЗначениеПоля(Поля, "BenefitID");
		Депозит.КлиентНаименование = ЗначениеПоля(Поля, "BenefitName");
		Депозит.Контрагент = ЗначениеПоля(Поля, "ContrPartyName");
		Депозит.ВалютаCalipso = ЗначениеПоля(Поля, "Fund");
		Депозит.Номинал = ЗначениеПоля(Поля, "Qty");
		Депозит.Ставка = ЗначениеПоля(Поля, "InterestRate");
		Депозит.ДатаСделки = ЗначениеПоля(Поля, "OpenDate");
		Депозит.ДатаПогашения = ЗначениеПоля(Поля, "MaturityDate");
		Депозит.ДатаПозиции = ЗначениеПоля(Поля, "DatePosition");

		Попытка
			Депозит.Код36 = КонвертацияBase36(НомерСделки);
		Исключение
			Депозит.Код36 = "";
		КонецПопытки;
		Депозит.Маска = "-D" + СокрЛП(Депозит.Код36) + "-";

		Валюта = Справочники.Валюты.ПустаяСсылка();
		Если ЗначениеЗаполнено(Депозит.ВалютаCalipso) Тогда
			Валюта = Справочники.Валюты.НайтиПоНаименованию(Депозит.ВалютаCalipso);
		КонецЕсли;
		Депозит.ВалютаНайдена = ЗначениеЗаполнено(Валюта);
		Депозит.АктивНайден = Депозит.ВалютаНайдена И ЗначениеЗаполнено(АктивВалюты(Валюта));

		НайтиСубпортфель(Депозит);

		Если Не ЗначениеЗаполнено(Депозит.Код36) Тогда
			Депозит.Результат = "Номер сделки не удалось перевести в 36-ричную запись, поиск не выполняется";
		ИначеЕсли Не Депозит.АктивНайден Тогда
			Депозит.Результат = ?(Депозит.ВалютаНайдена, "В ФО не найден актив для валюты",
				"В ФО не найдена валюта с наименованием """ + Депозит.ВалютаCalipso + """")
				+ ": депозит пропускается";
		ИначеЕсли ЗначениеЗаполнено(Депозит.Субпортфель) Тогда
			Депозит.Найден = Истина;
			Депозит.Результат = "Найден: портфель " + Депозит.Портфель + ", субпортфель " + Депозит.Субпортфель
				+ ", код счета " + Депозит.КодСчета;
			Если Депозит.СовпаденийСубпортфелей > 1 Тогда
				Депозит.Результат = Депозит.Результат + " (подходят " + Формат(Депозит.СовпаденийСубпортфелей, "ЧГ=0")
					+ " субпортфеля, берется первый)";
			КонецЕсли;
		Иначе
			Депозит.Результат = "Не найден: в ФО нет субпортфеля, код счета которого содержит " + Депозит.Маска;
			Если Депозит.СовпаденийУдаленных > 0 Тогда
				Депозит.Результат = Депозит.Результат + " (есть только помеченный на удаление: "
					+ Депозит.Субпортфель + ")";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Депозиты.Сортировать("Порядок, НомерСделки");
	Возврат Депозиты;

КонецФункции

// Ищет субпортфель по маске так же, как НайтиСубПортфельПоМаске загрузки депозитов 1.19: код счета содержит маску,
// помеченные на удаление не учитываются, берется первый. Дополнительно считает число подходящих субпортфелей и
// помеченных на удаление совпадений - чтобы объяснить результат. Заполняет Субпортфель, Портфель, КодСчета и счетчики.
//
// Параметры:
//  Депозит - СтрокаТаблицыЗначений - строка депозита с заполненной маской
//
Процедура НайтиСубпортфель(Депозит)

	Депозит.СовпаденийСубпортфелей = 0;
	Депозит.СовпаденийУдаленных = 0;
	Депозит.Субпортфель = "";
	Депозит.Портфель = "";
	Депозит.КодСчета = "";
	Если Не ЗначениеЗаполнено(Депозит.Код36) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Субпортфели.Ссылка КАК Ссылка,
	|	Субпортфели.ПометкаУдаления КАК ПометкаУдаления,
	|	Субпортфели.КодСчета КАК КодСчета,
	|	Субпортфели.Портфель КАК Портфель,
	|	Субпортфели.Портфель.КодПортфеля КАК КодПортфеля
	|ИЗ
	|	Справочник.Субпортфели КАК Субпортфели
	|ГДЕ
	|	Субпортфели.КодСчета ПОДОБНО ""%"" + &КодСчета + ""%""");
	Запрос.УстановитьПараметр("КодСчета", Депозит.Маска);
	Выборка = Запрос.Выполнить().Выбрать();
	ПервыйУдаленный = "";
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Депозит.СовпаденийУдаленных = Депозит.СовпаденийУдаленных + 1;
			Если Не ЗначениеЗаполнено(ПервыйУдаленный) Тогда
				ПервыйУдаленный = Строка(Выборка.Ссылка) + ", код счета " + СокрЛП(Выборка.КодСчета);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Депозит.СовпаденийСубпортфелей = Депозит.СовпаденийСубпортфелей + 1;
		Если Депозит.СовпаденийСубпортфелей = 1 Тогда
			Депозит.Субпортфель = Строка(Выборка.Ссылка);
			Депозит.Портфель = СокрЛП(Строка(Выборка.Портфель));
			Если ЗначениеЗаполнено(Выборка.КодПортфеля) Тогда
				Депозит.Портфель = Депозит.Портфель + " (код " + СокрЛП(Выборка.КодПортфеля) + ")";
			КонецЕсли;
			Депозит.КодСчета = СокрЛП(Выборка.КодСчета);
		КонецЕсли;
	КонецЦикла;
	Если Депозит.СовпаденийСубпортфелей = 0 Тогда
		Депозит.Субпортфель = ПервыйУдаленный;
	КонецЕсли;

КонецПроцедуры

// Возвращает актив валюты так же, как ВернутьАктив загрузки депозитов 1.19.
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты - валюта
//
// Возвращаемое значение:
//  СправочникСсылка.Активы - актив или пустая ссылка
//
Функция АктивВалюты(Валюта)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Активы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Активы КАК Активы
	|ГДЕ
	|	Активы.Объект = &Объект
	|	И НЕ Активы.ПометкаУдаления");
	Запрос.УстановитьПараметр("Объект", Валюта);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Активы.ПустаяСсылка();

КонецФункции

// Переводит номер сделки в 36-ричную запись (цифры 0-9, буквы A-Z) так же, как КонвертацияBase36 загрузки
// депозитов 1.19.
//
// Параметры:
//  НомерСделки - Число, Строка - номер сделки Calipso
//
// Возвращаемое значение:
//  Строка - запись номера; пустая строка для нуля
//
Функция КонвертацияBase36(НомерСделки)

	Алфавит = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Остаток = Число(НомерСделки);
	Результат = "";
	Пока Остаток <> 0 Цикл
		Результат = Сред(Алфавит, Цел(Остаток % 36) + 1, 1) + Результат;
		Остаток = Цел(Остаток / 36);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ФормированиеОтчета

// Формирует HTML-отчет для бизнеса.
//
// Параметры:
//  Депозиты - ТаблицаЗначений - см. СопоставитьДепозиты
//  Отчет - Структура - Депозитов, Найдено
//
// Возвращаемое значение:
//  Строка - документ HTML
//
Функция ТекстHTML(Депозиты, Отчет)

	Части = Новый Массив;
	Части.Добавить("<!DOCTYPE html>
	|<html lang=""ru""><head><meta charset=""utf-8"">
	|<title>Депозиты Calipso: поиск в портфелях Фронт-офиса</title>
	|<style>
	|body{font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1f1f1f;margin:24px;line-height:1.45}
	|h1{font-size:22px;margin:0 0 6px 0}h2{font-size:17px;margin:26px 0 8px 0}
	|.meta{color:#555;margin:0 0 16px 0}
