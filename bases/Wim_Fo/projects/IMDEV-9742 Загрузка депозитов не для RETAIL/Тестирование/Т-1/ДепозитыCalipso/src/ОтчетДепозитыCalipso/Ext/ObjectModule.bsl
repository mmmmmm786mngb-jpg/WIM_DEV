// Формирует краткий текст результата для формы.
//
// Параметры:
//  Депозиты - ТаблицаЗначений - см. СопоставитьДепозиты
//  Отчет - Структура - Депозитов, Найдено
//  Способ - Строка - откуда выполнено подключение к Calipso
//
// Возвращаемое значение:
//  Строка - текст
//
Функция ТекстСводки(Депозиты, Отчет, Способ)

	Строки = Новый Массив;
	Строки.Добавить("Депозитов Calipso: " + Формат(Отчет.Депозитов, "ЧН=0; ЧГ=0") + "; найдено в ФО: "
		+ Формат(Отчет.Найдено, "ЧН=0; ЧГ=0") + "; не найдено: " + Формат(Отчет.Депозитов - Отчет.Найдено, "ЧН=0; ЧГ=0"));
	Строки.Добавить("Подключение к Calipso: " + Способ);
	Строки.Добавить("");
	Для Каждого Депозит Из Депозиты Цикл
		Строки.Добавить(Депозит.НомерСделки + " | " + Депозит.Маска + " | " + Депозит.Результат);
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить("Сохраните отчет кнопкой ""Сохранить отчет (HTML)"".");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает ячейку таблицы HTML.
//
// Параметры:
//  Значение - Произвольный - значение ячейки
//  Класс - Строка - класс стиля ячейки
//
// Возвращаемое значение:
//  Строка - фрагмент HTML
//
Функция Ячейка(Значение, Класс = "")

	Текст = ?(Значение = Неопределено Или Значение = Null, "", СокрЛП(Строка(Значение)));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Текст = "-";
	КонецЕсли;
	Возврат "<td" + ?(ЗначениеЗаполнено(Класс), " class=""" + Класс + """", "") + ">" + Экранировать(Текст) + "</td>";

КонецФункции

// Заменяет служебные символы HTML.
//
// Параметры:
//  Текст - Строка - исходный текст
//
// Возвращаемое значение:
//  Строка - текст для вставки в HTML
//
Функция Экранировать(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат СтрЗаменить(Результат, """", "&quot;");

КонецФункции

// Возвращает сумму с двумя знаками после запятой и разделителями групп.
//
// Параметры:
//  Значение - Число, Строка, Неопределено - сумма
//
// Возвращаемое значение:
//  Строка - представление
//
Функция СуммаСтрокой(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧДЦ=2; ЧН=0,00");
	КонецЕсли;
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

// Возвращает ставку в том виде, в каком она хранится в Calipso, без округления.
//
// Параметры:
//  Значение - Число, Строка, Неопределено - ставка
//
// Возвращаемое значение:
//  Строка - представление
//
Функция СтавкаСтрокой(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧН=0");
	КонецЕсли;
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

// Возвращает дату в виде дд.ММ.гггг. Строковую дату из SQL вида гггг-ММ-дд (тип date через SQLOLEDB приходит
// строкой) переставляет в дд.ММ.гггг, другую строку возвращает первыми 10 символами.
//
// Параметры:
//  Значение - Дата, Строка, Неопределено - дата
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ДатаСтрокой(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy; ДП=-");
	ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Текст = Лев(СокрЛП(Значение), 10);
	Если СтрДлина(Текст) = 10 И Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-" Тогда
		Возврат Сред(Текст, 9, 2) + "." + Сред(Текст, 6, 2) + "." + Лев(Текст, 4);
	КонецЕсли;
	Возврат Текст;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает значение поля строки Calipso; Неопределено, если поля нет.
//
// Параметры:
//  Поля - Структура - поля строки
//  Имя - Строка - имя поля
//
// Возвращаемое значение:
//  Произвольный - значение
//
Функция ЗначениеПоля(Поля, Имя)

	Значение = Неопределено;
	Поля.Свойство(Имя, Значение);
	Возврат Значение;

КонецФункции

// Приводит значение к числу; при ошибке - 0.
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Число - число
//
Функция ЧислоИлиНоль(Значение)

	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Приводит значение поля ADODB к строке, числу, дате или булеву.
//
// Параметры:
//  Значение - Произвольный - значение поля
//
// Возвращаемое значение:
//  Строка, Число, Дата, Булево, Неопределено - значение
//
Функция ПримитивноеЗначение(Значение)

	Тип = ТипЗнч(Значение);
	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Тип = Тип("Строка") Или Тип = Тип("Число") Или Тип = Тип("Дата") Или Тип = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Возвращает имя информационной базы на сервере 1С из строки соединения.
//
// Возвращаемое значение:
//  Строка - имя базы или строка соединения целиком для файловой базы
//
Функция ИмяБазы()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Позиция = СтрНайти(СтрокаСоединения, "Ref=");
	Если Позиция = 0 Тогда
		Возврат СтрокаСоединения;
	КонецЕсли;
	Остаток = Сред(СтрокаСоединения, Позиция + 5);
	Возврат Лев(Остаток, СтрНайти(Остаток, """") - 1);

КонецФункции

#КонецОбласти

#КонецЕсли
