	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СчетаМандатов.Ссылка КАК Ссылка
ИЗ
	Справочник.СчетаМандатов КАК СчетаМандатов
ГДЕ
	1 = 1
	И СчетаМандатов.Наименование &lt;&gt; "Счет мандата не определен"
	И ЕСТЬNULL(СчетаМандатов.МестоХранения.ВидБанковскогоСчета, "") &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
	И (СчетаМандатов.ВидСчетаМандата.Наименование = "Брокерский"
				И СчетаМандатов.Владелец.ТипМандата.Ссылка В (ЗНАЧЕНИЕ(Перечисление.ТипыМандата.V), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Y), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Q), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.H))
			ИЛИ НЕ СчетаМандатов.Владелец.ТипМандата.Ссылка В (ЗНАЧЕНИЕ(Перечисление.ТипыМандата.V), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Y), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.Q), ЗНАЧЕНИЕ(Перечисление.ТипыМандата.H)))</query>
	</dataSet>
