// Включает или выключает привилегированный режим, чтобы ограничения доступа не скрыли строки блокировок и были
// видны фоновые задания других пользователей. В безопасном режиме режим недоступен - тогда чтение идет с правами
// пользователя, а в лог выводится причина.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Включить - Булево - включить или выключить
//
Процедура УстановитьПривилегированныйРежимЗамера(Лог, Включить)

	Попытка
		УстановитьПривилегированныйРежим(Включить);
	Исключение
		Если Включить Тогда
			Лог.Добавить("Привилегированный режим не установлен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Выполняет запрос и выводит время, число строк и таблицу результата. Ошибка запроса выводится в лог.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Заголовок - Строка - заголовок блока
//  ТекстЗапроса - Строка - текст запроса
//  Параметры - Структура - параметры запроса
//  МаксимумСтрок - Число - предел выводимых строк
//
Процедура ВывестиЗапрос(Лог, Заголовок, ТекстЗапроса, Параметры, МаксимумСтрок)

	Лог.Добавить("");
	Лог.Добавить("--- " + Заголовок);
	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Попытка
		НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
		РезультатЗапроса = Запрос.Выполнить();
		Таблица = РезультатЗапроса.Выгрузить();
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса;
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Лог.Добавить(СтрШаблон("Время запроса: %1 мс; строк: %2", ФорматЧисла(Длительность), ФорматЧисла(Таблица.Количество())));
	ВывестиТаблицу(Лог, Таблица, МаксимумСтрок);

КонецПроцедуры

// Выводит таблицу значений строками с разделителем " | ".
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Таблица - ТаблицаЗначений - данные
//  МаксимумСтрок - Число - предел выводимых строк
//
Процедура ВывестиТаблицу(Лог, Таблица, МаксимумСтрок)

	Имена = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;
	Лог.Добавить(СтрСоединить(Имена, " | "));

	Номер = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Номер = Номер + 1;
		Если Номер > МаксимумСтрок Тогда
			Лог.Добавить("... еще строк: " + ФорматЧисла(Таблица.Количество() - МаксимумСтрок));
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значения.Добавить(ЗначениеСтрокой(СтрокаТаблицы[Колонка.Имя]));
		КонецЦикла;
		Лог.Добавить(СтрСоединить(Значения, " | "));
	КонецЦикла;

КонецПроцедуры

// Возвращает представление значения для лога.
//
// Параметры:
//  Значение - Произвольный - значение
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ЗначениеСтрокой(Значение)

	Если Значение = Null Или Значение = Неопределено Тогда
		Возврат "-";
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧРД=.");
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'; ДП=-");
	ИначеЕсли Тип = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Возвращает число без разделителей групп, ноль как "0".
//
// Параметры:
//  Значение - Число - число
//
// Возвращаемое значение:
//  Строка - представление
//
Функция ФорматЧисла(Значение)

	Возврат Формат(Значение, "ЧН=0; ЧГ=0");

КонецФункции

// Возвращает имя информационной базы на сервере 1С из строки соединения.
//
// Возвращаемое значение:
//  Строка - сервер и имя базы или строка соединения целиком для файловой базы
//
Функция ИмяБазы()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Позиция = СтрНайти(СтрокаСоединения, "Ref=");
	Если Позиция = 0 Тогда
		Возврат СтрокаСоединения;
	КонецЕсли;
	Остаток = Сред(СтрокаСоединения, Позиция + 5);
	Возврат Лев(Остаток, СтрНайти(Остаток, """") - 1);

КонецФункции

// Добавляет заголовок раздела.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Заголовок - Строка - заголовок
//
Процедура ДобавитьРаздел(Лог, Заголовок)

	Лог.Добавить("");
	Лог.Добавить("==================== " + Заголовок);

КонецПроцедуры

// Добавляет в лог краткое представление ошибки.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Информация - ИнформацияОбОшибке - ошибка
//
Процедура ДобавитьОшибку(Лог, Информация)

	Лог.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(Информация));

КонецПроцедуры

#КонецОбласти

#КонецЕсли
