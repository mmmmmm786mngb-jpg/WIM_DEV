// Замеры отправки поручений-блокировок МО - ФО на копии Т-1 (IMDEV-9744). На выборке мандатов с блокировками ДС
// сравнивает отправку блокировок в ФО отдельным вызовом DownloadOrders на мандат (как в 1.42) и одним вызовом на пакет
// мандатов (как в 1.43), отдельно для создания новых поручений и для повторной отправки уже существующих. На второй
// выборке проверяет, как часто ответ ФО на пакет содержит ошибки: тогда 1.43 отправляет пакет повторно по мандатам.
//
// В МО обработка ничего не записывает, кроме событий журнала регистрации. В ФО создает поручения-блокировки:
// с реальными кодами текущего дня LOCK:<код счета>:<дата> (их же создает утренняя выгрузка) и с тестовыми кодами
// LOCK:<код счета>:T9744C<серия><время>, которые в конце замера отправляются с пометкой удаления.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает параметры замера по умолчанию.
//
// Возвращаемое значение:
//  Структура - параметры замера:
//   * АдресФО - Строка - часть адреса веб-сервиса ФО Т-1; по ней находится ровно один элемент внешних
//       информационных баз, который подготовка добавляет в параметры как ВнешняяИБ
//   * МандатовВЗамере - Число - мандатов в выборке сравнения вариантов
//   * РазмерПакета - Число - мандатов в пакете, как в настройке узла выгрузки
//   * МалыйПакет - Число - мандатов в малом пакете (0 - серия не выполняется)
//   * МандатовПроверкиОшибок - Число - мандатов в выборке проверки ошибок пакетов (0 - проверка не выполняется)
//   * МандатовВШагеПроверки - Число - мандатов проверки ошибок на один серверный вызов
//   * СоздаватьТестовыеПоручения - Булево - выполнять серии создания поручений с тестовыми кодами
//   * ПовторКак143 - Булево - при ошибке в ответе на пакет отправлять его повторно по мандатам, как 1.43
//   * ПометитьТестовые - Булево - в конце отправить тестовые поручения с пометкой удаления
//   * ПрефиксКодаМандата - Строка - отбор мандатов по началу кода (пусто - все мандаты с блокировками)
//   * ПотоковВыгрузки - Число - потоков утренней выгрузки, для оценки полного времени
//
Функция ПараметрыПоУмолчанию() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("АдресФО", "AVC_PP_RETAIL_FO");
	Параметры.Вставить("МандатовВЗамере", 100);
	Параметры.Вставить("РазмерПакета", 50);
	Параметры.Вставить("МалыйПакет", 10);
	Параметры.Вставить("МандатовПроверкиОшибок", 500);
	Параметры.Вставить("МандатовВШагеПроверки", 250);
	Параметры.Вставить("СоздаватьТестовыеПоручения", Истина);
	Параметры.Вставить("ПовторКак143", Истина);
	Параметры.Вставить("ПометитьТестовые", Истина);
	Параметры.Вставить("ПрефиксКодаМандата", "");
	Параметры.Вставить("ПотоковВыгрузки", 8);
	Возврат Параметры;

КонецФункции

// Собирает сведения о базе и прошлых прогонах выгрузки, выбирает мандаты с блокировками и составляет план шагов.
// В ФО ничего не отправляет, проверяет только подключение к веб-сервису.
//
// Параметры:
//  Параметры - Структура - см. ПараметрыПоУмолчанию
//
// Возвращаемое значение:
//  Структура - результат подготовки:
//   * Лог - Строка - текст лога подготовки
//   * Шаги - Массив из Структура - шаги замера, значения примитивных типов (передаются на клиент):
//      ** Номер - Число
//      ** Вид - Строка - "Отправка", "Пометка" или "Итоги"
//      ** Серия - Строка - имя серии для итоговой таблицы
//      ** Группа - Строка - "З" - выборка сравнения, "П" - выборка проверки ошибок
//      ** Первый, Последний - Число - диапазон индексов мандатов группы
//      ** Режим - Строка - "ПоМандату" или "Пакет"
//      ** РазмерПакета - Число
//      ** Суффикс - Строка - окончание кода поручения после кода счета: дата дня или тестовый суффикс
//      ** Суффиксы - Строка - тестовые суффиксы через запятую, для шага "Пометка"
//      ** Повтор143 - Булево - при ошибке в ответе на пакет отправлять повторно по мандатам
//      ** Детали - Булево - выводить в лог каждый вызов
//      ** СобиратьОшибки - Булево - учитывать ошибки пакетов в итоге проверки
//   * Данные - Структура, Неопределено - данные замера для ВыполнитьШаг; Неопределено, если замер невозможен
//
Функция ПодготовитьЗамер(Параметры) Экспорт

	Лог = Новый Массив;
	Результат = Новый Структура("Лог, Шаги, Данные", "", Новый Массив, Неопределено);
	УстановитьПривилегированныйРежимЗамера(Лог, Истина);

	ДобавитьРаздел(Лог, "0. Общие сведения");
	Лог.Добавить("Версия обработки замера: " + ВерсияОбработки());
	Лог.Добавить("Дата: " + ЗначениеСтрокой(ТекущаяДатаСеанса()));
	Лог.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);
	Лог.Добавить("База МО: " + ИмяБазы());
	Лог.Добавить("Параметры: " + ПредставлениеПараметров(Параметры));

	ТекстОшибки = "";
	Параметры.Вставить("ВнешняяИБ", НайтиВнешнююИБ(Параметры.АдресФО, ТекстОшибки));
	Если Параметры.ВнешняяИБ = Неопределено Или Не АдресФОДопустим(Параметры.ВнешняяИБ, ТекстОшибки) Тогда
		Лог.Добавить("ЗАМЕР НЕ ВЫПОЛНЯЕТСЯ: " + ТекстОшибки);
		Результат.Лог = СтрСоединить(Лог, Символы.ПС);
		Возврат Результат;
	КонецЕсли;
	Лог.Добавить("Веб-сервис ФО: " + Параметры.ВнешняяИБ.АдресWebСервиса + " / " + Параметры.ВнешняяИБ.ИмяWebСервиса);

	НачалоПодключения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Контекст = КонтекстОтправки(Параметры.ВнешняяИБ, ТекущаяДатаСеанса(), ТекстОшибки);
	Если Контекст = Неопределено Тогда
		Лог.Добавить("ЗАМЕР НЕ ВЫПОЛНЯЕТСЯ: " + ТекстОшибки);
		Результат.Лог = СтрСоединить(Лог, Символы.ПС);
		Возврат Результат;
	КонецЕсли;
	Лог.Добавить("Подключение к веб-сервису ФО: " + ФорматЧисла(ТекущаяУниверсальнаяДатаВМиллисекундах()
		- НачалоПодключения) + " мс");

	ДобавитьРаздел(Лог, "1. Замеры выгрузки остатков МО - ФО за сегодня и вчера (регистр ЗамерыВремени)");
	Попытка
		РазделЗамерыВыгрузки(Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "2. Фоновые задания выгрузки за сегодня и вчера");
	Попытка
		РазделФоновыеЗадания(Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "3. Обработка выгрузки в дополнительных обработках");
	Попытка
		РазделОбработкаВыгрузки(Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ДобавитьРаздел(Лог, "4. Блокировки ДС к отправке и выборки мандатов");
	Данные = НовыеДанныеЗамера(Параметры, Контекст.ДатаДляФронт);
	Попытка
		ЗаполнитьБлокировки(Данные, Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
		УстановитьПривилегированныйРежимЗамера(Лог, Ложь);
		Результат.Лог = СтрСоединить(Лог, Символы.ПС);
		Возврат Результат;
	КонецПопытки;

	Если Данные.МандатовЗамера = 0 Тогда
		Лог.Добавить("ЗАМЕР НЕ ВЫПОЛНЯЕТСЯ: нет мандатов с блокировками");
		УстановитьПривилегированныйРежимЗамера(Лог, Ложь);
		Результат.Лог = СтрСоединить(Лог, Символы.ПС);
		Возврат Результат;
	КонецЕсли;

	ДобавитьРаздел(Лог, "5. План шагов");
	Результат.Шаги = ПланШагов(Данные);
	Для Каждого Шаг Из Результат.Шаги Цикл
		Лог.Добавить(ПредставлениеШага(Шаг, Данные));
	КонецЦикла;

	УстановитьПривилегированныйРежимЗамера(Лог, Ложь);
	Результат.Данные = Данные;
	Результат.Лог = СтрСоединить(Лог, Символы.ПС);
	Возврат Результат;

КонецФункции

// Выполняет один шаг замера: отправку блокировок выборки в ФО, пометку тестовых поручений или вывод итогов.
// Ошибки отправки выводятся в лог и не прерывают замер.
//
// Параметры:
//  Шаг - Структура - шаг из ПодготовитьЗамер
//  Данные - Структура - данные замера из ПодготовитьЗамер, дополняются итогами шага
//
// Возвращаемое значение:
//  Строка - текст лога шага
//
Функция ВыполнитьШаг(Шаг, Данные) Экспорт

	Лог = Новый Массив;
	ДобавитьРаздел(Лог, ПредставлениеШага(Шаг, Данные));
	Лог.Добавить("Начало: " + ЗначениеСтрокой(ТекущаяДатаСеанса()));

	Если Шаг.Вид = "Итоги" Тогда
		ВывестиИтоги(Лог, Данные);
		Возврат Символы.ПС + СтрСоединить(Лог, Символы.ПС);
	КонецЕсли;

	Попытка
		ВыполнитьОтправку(Шаг, Данные, Лог);
	Исключение
		ДобавитьОшибку(Лог, ИнформацияОбОшибке());
	КонецПопытки;

	ТекстШага = СтрСоединить(Лог, Символы.ПС);
	ЗаписьЖурналаРегистрации("IMDEV-9744.ЗамерБлокировок", УровеньЖурналаРегистрации.Информация, , ,
		Лог[Лог.ВГраница()]);
	Возврат Символы.ПС + ТекстШага;

КонецФункции

#КонецОбласти

#Область Подготовка

// Находит элемент внешних информационных баз, адрес веб-сервиса которого содержит заданную строку. Элемент должен
// быть один, иначе замер не выполняется: выбор между несколькими базами ФО остается за пользователем.
//
// Параметры:
//  АдресФО - Строка - часть адреса веб-сервиса ФО, без учета регистра
//  ТекстОшибки - Строка - причина, по которой элемент не выбран, заполняется
//
// Возвращаемое значение:
//  СправочникСсылка.ВнешниеИнформационныеБазы, Неопределено - элемент или Неопределено
//
Функция НайтиВнешнююИБ(АдресФО, ТекстОшибки)

	Если Не ЗначениеЗаполнено(СокрЛП(АдресФО)) Тогда
		ТекстОшибки = "не задана часть адреса веб-сервиса ФО";
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВнешниеБазы.Ссылка КАК Ссылка,
	|	ВнешниеБазы.АдресWebСервиса КАК АдресWebСервиса
	|ИЗ
	|	Справочник.ВнешниеИнформационныеБазы КАК ВнешниеБазы
	|ГДЕ
	|	НЕ ВнешниеБазы.ПометкаУдаления");
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Найденные = Новый Массив;
	Адреса = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если СтрНайти(НРег(Выборка.АдресWebСервиса), НРег(СокрЛП(АдресФО))) > 0 Тогда
			Найденные.Добавить(Выборка.Ссылка);
			Адреса.Добавить(Выборка.АдресWebСервиса);
		КонецЕсли;
	КонецЦикла;

	Если Найденные.Количество() <> 1 Тогда
		СписокАдресов = СтрСоединить(Адреса, ", ");
		ТекстОшибки = СтрШаблон("адрес веб-сервиса, содержащий ""%1"", есть у %2 элементов внешних информационных баз "
			+ "(нужен ровно один): %3", АдресФО, Найденные.Количество(), СписокАдресов);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Найденные[0];

КонецФункции

// Проверяет, что веб-сервис ФО не похож на ПРОД.
//
// Параметры:
//  ВнешняяИБ - СправочникСсылка.ВнешниеИнформационныеБазы - веб-сервис ФО
//  ТекстОшибки - Строка - причина отказа, заполняется
//
// Возвращаемое значение:
//  Булево - Истина, если замер можно выполнять
//
Функция АдресФОДопустим(ВнешняяИБ, ТекстОшибки)

	Адрес = НРег(ВнешняяИБ.АдресWebСервиса);
	Для Каждого Признак Из СтрРазделить("amapfront,ammgavancore,prod", ",") Цикл
		Если СтрНайти(Адрес, Признак) > 0 Тогда
			ТекстОшибки = СтрШаблон("адрес веб-сервиса ФО похож на ПРОД (%1): %2", Признак, ВнешняяИБ.АдресWebСервиса);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Выводит замеры ключевых операций обработки выгрузки за сегодня и вчера по ключам, включая ключи потоков и пачек.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура РазделЗамерыВыгрузки(Лог)

	ВывестиЗапрос(Лог, "1.1. Замеры по дням и ключам",
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаЗаписиЛокальная, ДЕНЬ) КАК День,
	|	Замеры.КлючеваяОперация.Имя КАК Ключ,
	|	КОЛИЧЕСТВО(*) КАК Замеров,
	|	СУММА(Замеры.ВремяВыполнения) КАК СуммаСек,
	|	МАКСИМУМ(Замеры.ВремяВыполнения) КАК МаксСек,
	|	СУММА(Замеры.ВесЗамера) КАК СуммаВеса,
	|	МИНИМУМ(Замеры.ДатаЗаписиЛокальная) КАК Первый,
	|	МАКСИМУМ(Замеры.ДатаЗаписиЛокальная) КАК Последний
	|ИЗ
	|	РегистрСведений.ЗамерыВремени КАК Замеры
	|ГДЕ
	|	Замеры.ДатаЗаписиНачалоЧаса >= &Начало
	|	И Замеры.КлючеваяОперация.Имя ПОДОБНО ""внВыгрузкаОстатковМО%""
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Замеры.ДатаЗаписиЛокальная, ДЕНЬ),
	|	Замеры.КлючеваяОперация.Имя
	|
	|УПОРЯДОЧИТЬ ПО
	|	День,
	|	Первый", Новый Структура("Начало", НачалоДня(ТекущаяДатаСеанса()) - 86400), 300);

КонецПроцедуры

// Выводит фоновые задания выгрузки и обменов за сегодня и вчера: наименование, начало, конец, длительность, состояние.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура РазделФоновыеЗадания(Лог)

	Граница = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Наименование");
	Таблица.Колонки.Добавить("Начало");
	Таблица.Колонки.Добавить("Конец");
	Таблица.Колонки.Добавить("Секунд");
	Таблица.Колонки.Добавить("Состояние");
	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания() Цикл
		Если Задание.Начало < Граница Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Задание.Наименование, "МО-ФО") = 0 И СтрНайти(Задание.ИмяМетода, "ОписаниеОбменов") = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Наименование = Лев(Задание.Наименование, 60);
		НоваяСтрока.Начало       = Задание.Начало;
		НоваяСтрока.Конец        = Задание.Конец;
		Если ЗначениеЗаполнено(Задание.Конец) Тогда
			НоваяСтрока.Секунд = Задание.Конец - Задание.Начало;
		КонецЕсли;
		НоваяСтрока.Состояние = Задание.Состояние;
	КонецЦикла;
	Таблица.Сортировать("Начало");
	Лог.Добавить("");
	Лог.Добавить("--- 2.1. Задания (наименование содержит МО-ФО или метод обменов)");
	ВывестиТаблицу(Лог, Таблица, 200);

КонецПроцедуры

// Выводит версию обработки внВыгрузкаОстатковМО_ФО в дополнительных обработках.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура РазделОбработкаВыгрузки(Лог)

	ВывестиЗапрос(Лог, "3.1. Версия обработки выгрузки",
	"ВЫБРАТЬ
	|	Обработки.ИмяОбъекта КАК ИмяОбъекта,
	|	Обработки.Версия КАК Версия,
	|	Обработки.Публикация КАК Публикация,
	|	Обработки.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	Обработки.ИмяОбъекта = ""внВыгрузкаОстатковМО_ФО""", Новый Структура, 10);

КонецПроцедуры

// Создает структуру данных замера.
//
// Параметры:
//  Параметры - Структура - см. ПараметрыПоУмолчанию
//  ДатаДляФронт - Дата - дата поручений, начало текущего дня
//
// Возвращаемое значение:
//  Структура - данные замера:
//   * Параметры - Структура - параметры замера
//   * ДатаДляФронт - Дата
//   * Блокировки - ТаблицаЗначений - строки блокировок выборок: Группа, ИндексМандата, Мандат, СчетМандата, КодСчета,
//       Валюта, Количество
//   * ВсегоМандатов, ВсегоСтрок - Число - мандаты и строки блокировок к отправке во всей базе
//   * МандатовЗамера, МандатовПроверки - Число - мандаты в выборках
//   * Итоги - ТаблицаЗначений - итоги шагов отправки
//   * ОшибкиПроверки - Соответствие - тип ошибки и число строк ошибок в проверке пакетов
//   * ПримерыОшибок - Соответствие - тип ошибки и массив примеров
//
Функция НовыеДанныеЗамера(Параметры, ДатаДляФронт)

	Итоги = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Номер,Серия,Вид,Мандатов,Блокировок,Поручений,Пропущено,Вызовов,ВсегоМс,СборкаМс,"
		+ "ВызовМс,РазборМс,ПакетовСОшибками,МандатовВПакетахСОшибками,ПовторныхВызовов,ПовторМс,Незагружено,"
		+ "Исключений,МаксКб", ",") Цикл
		Итоги.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("Параметры", Параметры);
	Данные.Вставить("ДатаДляФронт", ДатаДляФронт);
	Данные.Вставить("Блокировки", Неопределено);
	Данные.Вставить("ВсегоМандатов", 0);
	Данные.Вставить("ВсегоСтрок", 0);
	Данные.Вставить("МандатовЗамера", 0);
	Данные.Вставить("МандатовПроверки", 0);
	Данные.Вставить("Итоги", Итоги);
	Данные.Вставить("ОшибкиПроверки", Новый Соответствие);
	Данные.Вставить("ПримерыОшибок", Новый Соответствие);
	Возврат Данные;

КонецФункции

// Читает блокировки ДС к отправке тем же отбором, что обработка выгрузки 1.42 (остатки блокировок на начало дня по
// счетам, у которых вчера были остатки ДС, ЦБ или доходов к получению), выбирает мандаты выборок сравнения и проверки
// равномерно по коду мандата и выводит сведения в лог.
//
// Параметры:
//  Данные - Структура - см. НовыеДанныеЗамера, заполняется
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура ЗаполнитьБлокировки(Данные, Лог)

	Параметры = Данные.Параметры;
	Запрос = Новый Запрос(ТекстЗапросаБлокировок());
	Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ТекущаяДатаСеанса() - 86400));
	Запрос.УстановитьПараметр("НачалоДня", Данные.ДатаДляФронт);
	Запрос.УстановитьПараметр("МаскаКодаМандата", Параметры.ПрефиксКодаМандата + "%");

	НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РезультатЗапроса = Запрос.Выполнить();
	Таблица = РезультатЗапроса.Выгрузить();
	Лог.Добавить(СтрШаблон("Запрос блокировок: %1 мс, строк %2", ФорматЧисла(ТекущаяУниверсальнаяДатаВМиллисекундах()
		- НачалоЗапроса), ФорматЧисла(Таблица.Количество())));

	// На разработческой базе остатков блокировок нет: проверка через внешнее соединение передает готовые строки
	// (колонки запроса, порядок по коду мандата). Форма этот параметр не передает.
	Если Параметры.Свойство("ТаблицаБлокировок") И Параметры.ТаблицаБлокировок <> Неопределено Тогда
		Таблица = Параметры.ТаблицаБлокировок;
		Лог.Добавить("Блокировки переданы параметром ТаблицаБлокировок: строк " + ФорматЧисла(Таблица.Количество()));
	КонецЕсли;

	СтрокиМандатов = Новый Массив;
	ТекущийМандат = Неопределено;
	МаксСтрокНаМандат = 0;
	ДлинныхРеальныхКодов = 0;
	МаксДлинаКода = 0;
	ДлинаРеальногоСуффикса = СтрДлина(РеальныйСуффикс(Данные.ДатаДляФронт));
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.Мандат <> ТекущийМандат Тогда
			ТекущийМандат = СтрокаТаблицы.Мандат;
			СтрокиМандата = Новый Массив;
			СтрокиМандатов.Добавить(СтрокиМандата);
		КонецЕсли;
		СтрокиМандата.Добавить(СтрокаТаблицы);
		МаксСтрокНаМандат = Макс(МаксСтрокНаМандат, СтрокиМандата.Количество());
		ДлинаКода = СтрДлина("LOCK:" + СтрокаТаблицы.КодСчета + ":") + ДлинаРеальногоСуффикса;
		МаксДлинаКода = Макс(МаксДлинаКода, ДлинаКода);
		Если ДлинаКода > ДлинаКодаПорученияФО() Тогда
			ДлинныхРеальныхКодов = ДлинныхРеальныхКодов + 1;
		КонецЕсли;
	КонецЦикла;

	Данные.ВсегоМандатов = СтрокиМандатов.Количество();
	Данные.ВсегоСтрок = Таблица.Количество();
	Лог.Добавить(СтрШаблон("Всего к отправке: мандатов %1, строк (поручений) %2, максимум строк на мандат %3",
		ФорматЧисла(Данные.ВсегоМандатов), ФорматЧисла(Данные.ВсегоСтрок), ФорматЧисла(МаксСтрокНаМандат)));
	Лог.Добавить(СтрШаблон("Код поручения: максимальная длина %1 при длине реквизита ФО %2; длиннее реквизита: %3 строк",
		ФорматЧисла(МаксДлинаКода), ФорматЧисла(ДлинаКодаПорученияФО()), ФорматЧисла(ДлинныхРеальныхКодов)));

	ИндексыЗамера = РавномернаяВыборка(Данные.ВсегоМандатов, Параметры.МандатовВЗамере, Новый Соответствие);
	ИсключаемыеИндексы = Новый Соответствие;
	Для Каждого Индекс Из ИндексыЗамера Цикл
		ИсключаемыеИндексы.Вставить(Индекс, Истина);
	КонецЦикла;
	ИндексыПроверки = РавномернаяВыборка(Данные.ВсегоМандатов, Параметры.МандатовПроверкиОшибок, ИсключаемыеИндексы);

	Блокировки = Таблица.СкопироватьКолонки();
	Блокировки.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1)));
	Блокировки.Колонки.Добавить("ИндексМандата", Новый ОписаниеТипов("Число"));
	ДобавитьМандатыВыборки(Блокировки, СтрокиМандатов, ИндексыЗамера, "З");
	ДобавитьМандатыВыборки(Блокировки, СтрокиМандатов, ИндексыПроверки, "П");
	Блокировки.Индексы.Добавить("Группа");
	Данные.Блокировки = Блокировки;
	Данные.МандатовЗамера = ИндексыЗамера.Количество();
	Данные.МандатовПроверки = ИндексыПроверки.Количество();

	Лог.Добавить(СтрШаблон("Выборка сравнения: мандатов %1, поручений %2", ФорматЧисла(Данные.МандатовЗамера),
		ФорматЧисла(Блокировки.НайтиСтроки(Новый Структура("Группа", "З")).Количество())));
	Лог.Добавить(СтрШаблон("Выборка проверки ошибок пакетов: мандатов %1, поручений %2",
		ФорматЧисла(Данные.МандатовПроверки),
		ФорматЧисла(Блокировки.НайтиСтроки(Новый Структура("Группа", "П")).Количество())));
	Лог.Добавить("Дата поручений: " + Формат(Данные.ДатаДляФронт, "ДФ=dd.MM.yyyy") + ", код вида LOCK:<код счета>:"
		+ РеальныйСуффикс(Данные.ДатаДляФронт));

КонецПроцедуры

// Возвращает текст запроса блокировок к отправке. Отбор счетов повторяет запрос обработки выгрузки
// (ПолучитьТекстЗапросаДляФоновогоЗадания), остатки блокировок - функцию БлокировкиНаДату.
//
// Возвращаемое значение:
//  Строка - текст запроса
//
Функция ТекстЗапросаБлокировок()

	Возврат
	"ВЫБРАТЬ
	|	ДенежныеСредстваОстатки.СчетМандата КАК СчетМандата
	|ПОМЕСТИТЬ ВТ_СчетаСОстатками
	|ИЗ
	|	РегистрНакопления.ДенежныеСредства.Остатки(&ДатаОстатков, ) КАК ДенежныеСредстваОстатки
	|ГДЕ
	|	ДенежныеСредстваОстатки.СчетМандата.Наименование <> ""Счет мандата не определен""
	|	И ЕСТЬNULL(ДенежныеСредстваОстатки.СчетМандата.МестоХранения.ВидБанковскогоСчета, """") <> ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЦенныеБумагиОстатки.СчетМандата
	|ИЗ
	|	РегистрНакопления.ЦенныеБумаги.Остатки(&ДатаОстатков, ) КАК ЦенныеБумагиОстатки
	|ГДЕ
	|	ЦенныеБумагиОстатки.СчетМандата.Наименование <> ""Счет мандата не определен""
	|	И ЕСТЬNULL(ЦенныеБумагиОстатки.СчетМандата.МестоХранения.ВидБанковскогоСчета, """") <> ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДоходыКПолучениюОстатки.СчетМандата
	|ИЗ
	|	РегистрНакопления.ДоходыКПолучению.Остатки(&ДатаОстатков, ) КАК ДоходыКПолучениюОстатки
	|ГДЕ
	|	ДоходыКПолучениюОстатки.СчетМандата.Наименование <> ""Счет мандата не определен""
	|	И ЕСТЬNULL(ДоходыКПолучениюОстатки.СчетМандата.МестоХранения.ВидБанковскогоСчета, """") <> ЗНАЧЕНИЕ(Перечисление.ВидБанковскогоСчета.Депозитный)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетМандата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиБлокировок.Мандат КАК Мандат,
	|	ОстаткиБлокировок.Мандат.КодМандата КАК КодМандата,
	|	ОстаткиБлокировок.СчетМандата КАК СчетМандата,
	|	ОстаткиБлокировок.СчетМандата.КодСчета КАК КодСчета,
	|	ОстаткиБлокировок.Валюта КАК Валюта,
	|	СУММА(ОстаткиБлокировок.ВалютнаяСуммаОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваЗаблокированные.Остатки(
	|			&НачалоДня,
	|			Мандат <> ЗНАЧЕНИЕ(Справочник.Мандаты.НеОпределен)
	|				И (Мандат.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ Мандат.ДатаОкончания > &НачалоДня)
	|				И Мандат.КодМандата ПОДОБНО &МаскаКодаМандата
	|				И СчетМандата В
	|					(ВЫБРАТЬ
	|						ВТ_СчетаСОстатками.СчетМандата
	|					ИЗ
	|						ВТ_СчетаСОстатками КАК ВТ_СчетаСОстатками)) КАК ОстаткиБлокировок
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБлокировок.Мандат,
	|	ОстаткиБлокировок.Мандат.КодМандата,
	|	ОстаткиБлокировок.СчетМандата,
	|	ОстаткиБлокировок.СчетМандата.КодСчета,
	|	ОстаткиБлокировок.Валюта,
	|	ОстаткиБлокировок.Актив
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодМандата,
	|	Мандат,
	|	КодСчета";

КонецФункции

// Возвращает индексы равномерной выборки из диапазона 0..Всего-1 без исключаемых индексов.
//
// Параметры:
//  Всего - Число - размер диапазона
//  Количество - Число - нужное число индексов
//  Исключаемые - Соответствие - индексы, которые не выбираются
//
// Возвращаемое значение:
//  Массив из Число - индексы по возрастанию
//
Функция РавномернаяВыборка(Всего, Количество, Исключаемые)

	Доступные = Новый Массив;
	Для Индекс = 0 По Всего - 1 Цикл
		Если Исключаемые.Получить(Индекс) = Неопределено Тогда
			Доступные.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Если Количество <= 0 Или Не ЗначениеЗаполнено(Доступные) Тогда
		Возврат Результат;
	КонецЕсли;
	Шаг = Макс(1, Цел(Доступные.Количество() / Количество));
	Позиция = 0;
	Пока Позиция < Доступные.Количество() И Результат.Количество() < Количество Цикл
		Результат.Добавить(Доступные[Позиция]);
		Позиция = Позиция + Шаг;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Переносит строки блокировок выбранных мандатов в таблицу выборок с номером мандата внутри группы.
//
// Параметры:
//  Блокировки - ТаблицаЗначений - строки выборок, дополняются
//  СтрокиМандатов - Массив из Массив - строки результата запроса по мандатам
//  Индексы - Массив из Число - индексы выбранных мандатов
//  Группа - Строка - "З" или "П"
//
Процедура ДобавитьМандатыВыборки(Блокировки, СтрокиМандатов, Индексы, Группа)

	Для НомерВГруппе = 0 По Индексы.ВГраница() Цикл
		Для Каждого СтрокаМандата Из СтрокиМандатов[Индексы[НомерВГруппе]] Цикл
			НоваяСтрока = Блокировки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМандата);
			НоваяСтрока.Группа = Группа;
			НоваяСтрока.ИндексМандата = НомерВГруппе;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Составляет план шагов. Серии с реальными и тестовыми кодами чередуются, варианты повторяются в обратном порядке,
// чтобы прогрев ФО и порядок запуска не давали преимущества одному варианту.
//
// Параметры:
//  Данные - Структура - см. НовыеДанныеЗамера
//
// Возвращаемое значение:
//  Массив из Структура - шаги, см. ПодготовитьЗамер
//
Функция ПланШагов(Данные)

	Параметры = Данные.Параметры;
	Пакет = Параметры.РазмерПакета;
	ПоследнийЗамера = Данные.МандатовЗамера - 1;
	Реальный = РеальныйСуффикс(Данные.ДатаДляФронт);
	Время = Формат(ТекущаяДатаСеанса(), "ДФ=HHmmss");
	ИмяПакета = "пакет " + ФорматЧисла(Пакет);
	Повтор143 = Параметры.ПовторКак143;
	Шаги = Новый Массив;
	Суффиксы = Новый Массив;

	ДобавитьШаг(Шаги, "Прогрев: " + ИмяПакета + ", реальные коды", "З", 0, ПоследнийЗамера, "Пакет", Пакет, Реальный,
		Ложь, Ложь);
	ДобавитьШаг(Шаги, "Повтор: по мандату", "З", 0, ПоследнийЗамера, "ПоМандату", 1, Реальный, Ложь, Истина);
	ДобавитьШаг(Шаги, "Повтор: " + ИмяПакета, "З", 0, ПоследнийЗамера, "Пакет", Пакет, Реальный, Повтор143, Истина);

	Если Параметры.СоздаватьТестовыеПоручения Тогда
		ДобавитьШагСоздания(Шаги, Суффиксы, "Создание: по мандату", ПоследнийЗамера, "ПоМандату", 1, Время, Ложь);
		ДобавитьШагСоздания(Шаги, Суффиксы, "Создание: " + ИмяПакета, ПоследнийЗамера, "Пакет", Пакет, Время, Повтор143);
		Если Параметры.МалыйПакет > 0 Тогда
			ДобавитьШагСоздания(Шаги, Суффиксы, "Создание: пакет " + ФорматЧисла(Параметры.МалыйПакет),
				ПоследнийЗамера, "Пакет", Параметры.МалыйПакет, Время, Повтор143);
		КонецЕсли;
	КонецЕсли;

	ДобавитьШаг(Шаги, "Повтор: " + ИмяПакета, "З", 0, ПоследнийЗамера, "Пакет", Пакет, Реальный, Повтор143, Истина);
	ДобавитьШаг(Шаги, "Повтор: по мандату", "З", 0, ПоследнийЗамера, "ПоМандату", 1, Реальный, Ложь, Истина);

	Если Параметры.СоздаватьТестовыеПоручения Тогда
		ДобавитьШагСоздания(Шаги, Суффиксы, "Создание: " + ИмяПакета, ПоследнийЗамера, "Пакет", Пакет, Время, Повтор143);
		ДобавитьШагСоздания(Шаги, Суффиксы, "Создание: по мандату", ПоследнийЗамера, "ПоМандату", 1, Время, Ложь);
	КонецЕсли;

	// ФО не изменяет существующее поручение и не возвращает по нему ошибок, поэтому частоту ошибок первого прогона
	// дня показывает только создание: при разрешенных тестовых поручениях проверка идет на тестовых кодах.
	СуффиксПроверки = Реальный;
	ИмяКодовПроверки = ", реальные коды";
	Если Параметры.СоздаватьТестовыеПоручения Тогда
		СуффиксПроверки = "T9744P01" + Время;
		ИмяКодовПроверки = ", тестовые коды";
	КонецЕсли;
	МандатовВШаге = Макс(Пакет, Параметры.МандатовВШагеПроверки);
	Начало = 0;
	Пока Начало < Данные.МандатовПроверки Цикл
		Конец = Мин(Начало + МандатовВШаге, Данные.МандатовПроверки) - 1;
		Шаг = ДобавитьШаг(Шаги, "Проверка ошибок: " + ИмяПакета + ИмяКодовПроверки, "П", Начало, Конец, "Пакет", Пакет,
			СуффиксПроверки, Ложь, Ложь);
		Шаг.СобиратьОшибки = Истина;
		Начало = Конец + 1;
	КонецЦикла;

	Если Параметры.ПометитьТестовые И ЗначениеЗаполнено(Суффиксы) Тогда
		Шаг = ДобавитьШаг(Шаги, "Пометка удаления тестовых поручений: " + ИмяПакета, "З", 0, ПоследнийЗамера, "Пакет",
			Пакет, "", Ложь, Ложь);
		Шаг.Вид = "Пометка";
		Шаг.Суффиксы = СтрСоединить(Суффиксы, ",");
	КонецЕсли;
	Если Параметры.ПометитьТестовые И СуффиксПроверки <> Реальный И Данные.МандатовПроверки > 0 Тогда
		Шаг = ДобавитьШаг(Шаги, "Пометка удаления тестовых поручений проверки: " + ИмяПакета, "П", 0,
			Данные.МандатовПроверки - 1, "Пакет", Пакет, "", Ложь, Ложь);
		Шаг.Вид = "Пометка";
		Шаг.Суффиксы = СуффиксПроверки;
	КонецЕсли;

	Шаг = ДобавитьШаг(Шаги, "Итоги", "", 0, -1, "", 0, "", Ложь, Ложь);
	Шаг.Вид = "Итоги";

	Возврат Шаги;

КонецФункции

// Добавляет в план шаг создания поручений с новым тестовым суффиксом кода.
//
// Параметры:
//  Шаги - Массив из Структура - план, дополняется
//  Суффиксы - Массив из Строка - тестовые суффиксы, дополняется
//  Серия - Строка - имя серии
//  ПоследнийЗамера - Число - индекс последнего мандата выборки сравнения
//  Режим - Строка - "ПоМандату" или "Пакет"
//  РазмерПакета - Число - мандатов в пакете
//  Время - Строка - время подготовки HHmmss, делает суффиксы уникальными между запусками
//  Повтор143 - Булево - повторная отправка пакета по мандатам при ошибке
//
Процедура ДобавитьШагСоздания(Шаги, Суффиксы, Серия, ПоследнийЗамера, Режим, РазмерПакета, Время, Повтор143)

	Суффикс = "T9744C" + Формат(Суффиксы.Количество() + 1, "ЧЦ=2; ЧВН=; ЧГ=0") + Время;
	Суффиксы.Добавить(Суффикс);
	ДобавитьШаг(Шаги, Серия, "З", 0, ПоследнийЗамера, Режим, РазмерПакета, Суффикс, Повтор143, Истина);

КонецПроцедуры

// Добавляет шаг отправки в план.
//
// Параметры:
//  Шаги - Массив из Структура - план, дополняется
//  Серия - Строка - имя серии
//  Группа - Строка - "З" или "П"
//  Первый, Последний - Число - диапазон индексов мандатов группы
//  Режим - Строка - "ПоМандату" или "Пакет"
//  РазмерПакета - Число - мандатов в пакете
//  Суффикс - Строка - окончание кода поручения
//  Повтор143 - Булево - повторная отправка пакета по мандатам при ошибке
//  Детали - Булево - выводить каждый вызов
//
// Возвращаемое значение:
//  Структура - добавленный шаг, см. ПодготовитьЗамер
//
Функция ДобавитьШаг(Шаги, Серия, Группа, Первый, Последний, Режим, РазмерПакета, Суффикс, Повтор143, Детали)

	Шаг = Новый Структура;
	Шаг.Вставить("Номер", Шаги.Количество() + 1);
	Шаг.Вставить("Вид", "Отправка");
	Шаг.Вставить("Серия", Серия);
	Шаг.Вставить("Группа", Группа);
	Шаг.Вставить("Первый", Первый);
	Шаг.Вставить("Последний", Последний);
	Шаг.Вставить("Режим", Режим);
	Шаг.Вставить("РазмерПакета", РазмерПакета);
	Шаг.Вставить("Суффикс", Суффикс);
	Шаг.Вставить("Суффиксы", "");
	Шаг.Вставить("Повтор143", Повтор143);
	Шаг.Вставить("Детали", Детали);
	Шаг.Вставить("СобиратьОшибки", Ложь);
	Шаги.Добавить(Шаг);
	Возврат Шаг;

КонецФункции

#КонецОбласти

#Область Отправка

// Отправляет блокировки мандатов шага в ФО по мандату или пакетами, выводит вызовы и итог шага, добавляет строку итогов.
//
// Параметры:
//  Шаг - Структура - шаг, см. ПодготовитьЗамер
//  Данные - Структура - данные замера, дополняются итогами
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура ВыполнитьОтправку(Шаг, Данные, Лог)

	ТекстОшибки = "";
	НачалоПодключения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Контекст = КонтекстОтправки(Данные.Параметры.ВнешняяИБ, Данные.ДатаДляФронт, ТекстОшибки);
	Если Контекст = Неопределено Тогда
		Лог.Добавить("ОШИБКА: " + ТекстОшибки);
		Возврат;
	КонецЕсли;
	Лог.Добавить("Подключение к веб-сервису: " + ФорматЧисла(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПодключения)
		+ " мс (не входит в итог шага)");

	Мандаты = МандатыШага(Шаг, Данные.Блокировки);
	Итог = Данные.Итоги.Добавить();
	Итог.Номер = Шаг.Номер;
	Итог.Серия = Шаг.Серия;
	Итог.Вид = Шаг.Вид;
	Для Каждого ИмяКолонки Из СтрРазделить("Мандатов,Блокировок,Поручений,Пропущено,Вызовов,ВсегоМс,СборкаМс,ВызовМс,РазборМс,"
		+ "ПакетовСОшибками,МандатовВПакетахСОшибками,ПовторныхВызовов,ПовторМс,Незагружено,Исключений,МаксКб", ",") Цикл
		Итог[ИмяКолонки] = 0;
	КонецЦикла;
	Итог.Мандатов = Мандаты.Количество();
	ОшибкиШага = Новый Соответствие;

	Суффиксы = Новый Массив;
	Если Шаг.Вид = "Пометка" Тогда
		Суффиксы = СтрРазделить(Шаг.Суффиксы, ",");
	Иначе
		Суффиксы.Добавить(Шаг.Суффикс);
	КонецЕсли;
	Для Каждого Мандат Из Мандаты Цикл
		Итог.Блокировок = Итог.Блокировок + Мандат.Строки.Количество() * Суффиксы.Количество();
	КонецЦикла;

	НачалоШага = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Каждого Суффикс Из Суффиксы Цикл
		Если Шаг.Режим = "ПоМандату" Тогда
			Для Каждого Мандат Из Мандаты Цикл
				ОтправитьИУчесть(Контекст, Мандат.Строки, Суффикс, Шаг, Итог, ОшибкиШага, Лог, 1, Ложь);
			КонецЦикла;
		Иначе
			ОтправитьПакетами(Контекст, Мандаты, Суффикс, Шаг, Итог, ОшибкиШага, Лог);
		КонецЕсли;
	КонецЦикла;
	Итог.ВсегоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоШага;

	ОшибкиПроверки = Неопределено;
	Если Шаг.СобиратьОшибки Тогда
		ОшибкиПроверки = Данные.ОшибкиПроверки;
	КонецЕсли;
	Лог.Добавить(ПредставлениеОшибок(ОшибкиШага, Данные.ПримерыОшибок, ОшибкиПроверки));
	Лог.Добавить(ПредставлениеИтогаШага(Итог));

КонецПроцедуры

// Отправляет мандаты шага пакетами по РазмерПакета. Если ответ на пакет содержит ошибки и задан Повтор143, пакет
// отправляется повторно по мандатам - так делает обработка 1.43.
//
// Параметры:
//  Контекст - Структура - см. КонтекстОтправки
//  Мандаты - Массив из Структура - мандаты шага, см. МандатыШага
//  Суффикс - Строка - окончание кода поручения
//  Шаг - Структура - шаг
//  Итог - СтрокаТаблицыЗначений - итог шага, дополняется
//  ОшибкиШага - Соответствие - тип ошибки и число, дополняется
//  Лог - Массив из Строка - строки лога, дополняются
//
Процедура ОтправитьПакетами(Контекст, Мандаты, Суффикс, Шаг, Итог, ОшибкиШага, Лог)

	Позиция = 0;
	Пока Позиция < Мандаты.Количество() Цикл
		Конец = Мин(Позиция + Шаг.РазмерПакета, Мандаты.Количество()) - 1;
		СтрокиПакета = Новый Массив;
		Для Индекс = Позиция По Конец Цикл
			Для Каждого СтрокаБлокировки Из Мандаты[Индекс].Строки Цикл
				СтрокиПакета.Добавить(СтрокаБлокировки);
			КонецЦикла;
		КонецЦикла;

		ЕстьОшибки = ОтправитьИУчесть(Контекст, СтрокиПакета, Суффикс, Шаг, Итог, ОшибкиШага, Лог, Конец - Позиция + 1,
			Ложь);
		Если ЕстьОшибки Тогда
			Итог.ПакетовСОшибками = Итог.ПакетовСОшибками + 1;
			Итог.МандатовВПакетахСОшибками = Итог.МандатовВПакетахСОшибками + Конец - Позиция + 1;
			Если Шаг.Повтор143 Тогда
				НачалоПовтора = ТекущаяУниверсальнаяДатаВМиллисекундах();
				Для Индекс = Позиция По Конец Цикл
					ОтправитьИУчесть(Контекст, Мандаты[Индекс].Строки, Суффикс, Шаг, Итог, Неопределено, Лог, 1, Истина);
					Итог.ПовторныхВызовов = Итог.ПовторныхВызовов + 1;
				КонецЦикла;
				Итог.ПовторМс = Итог.ПовторМс + ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПовтора;
			КонецЕсли;
		КонецЕсли;
		Позиция = Конец + 1;
	КонецЦикла;

КонецПроцедуры

// Отправляет строки блокировок одним вызовом DownloadOrders, добавляет время и ошибки в итог шага и выводит вызов.
//
// Параметры:
//  Контекст - Структура - см. КонтекстОтправки
//  Строки - Массив из СтрокаТаблицыЗначений - строки блокировок
//  Суффикс - Строка - окончание кода поручения
//  Шаг - Структура - шаг
//  Итог - СтрокаТаблицыЗначений - итог шага, дополняется
//  ОшибкиШага - Соответствие, Неопределено - тип ошибки и число, дополняется; Неопределено - ошибки не учитываются
//  Лог - Массив из Строка - строки лога, дополняются
//  МандатовВВызове - Число - для вывода
//  ЭтоПовтор - Булево - повторная отправка после ошибки пакета, для вывода
//
// Возвращаемое значение:
//  Булево - ответ содержит ошибки или вызов завершился исключением
//
Функция ОтправитьИУчесть(Контекст, Строки, Суффикс, Шаг, Итог, ОшибкиШага, Лог, МандатовВВызове, ЭтоПовтор)

	Вызов = ОтправитьПоручения(Контекст, Строки, Суффикс, Шаг.Вид = "Пометка");
	Если Вызов.Поручений = 0 Тогда
		Итог.Пропущено = Итог.Пропущено + Вызов.Пропущено;
		Возврат Ложь;
	КонецЕсли;

	Итог.Вызовов    = Итог.Вызовов + 1;
	Итог.Поручений  = Итог.Поручений + Вызов.Поручений;
	Итог.Пропущено  = Итог.Пропущено + Вызов.Пропущено;
	Итог.СборкаМс   = Итог.СборкаМс + Вызов.СборкаМс;
	Итог.ВызовМс    = Итог.ВызовМс + Вызов.ВызовМс;
	Итог.РазборМс   = Итог.РазборМс + Вызов.РазборМс;
	Итог.Незагружено = Итог.Незагружено + Вызов.Незагружено;
	Итог.МаксКб     = Макс(Итог.МаксКб, Вызов.РазмерКб);
	Если ЗначениеЗаполнено(Вызов.Исключение) Тогда
		Итог.Исключений = Итог.Исключений + 1;
	КонецЕсли;

	Если ОшибкиШага <> Неопределено Тогда
		Для Каждого ЭлементОшибки Из Вызов.Ошибки Цикл
			Для Каждого Пример Из ЭлементОшибки.Значение.Примеры Цикл
				ДобавитьОшибкуВызова(ОшибкиШага, ЭлементОшибки.Ключ, Пример);
			КонецЦикла;
			ОшибкиШага[ЭлементОшибки.Ключ].Количество = ОшибкиШага[ЭлементОшибки.Ключ].Количество
				+ ЭлементОшибки.Значение.Количество - ЭлементОшибки.Значение.Примеры.Количество();
		КонецЦикла;
	КонецЕсли;

	Если Шаг.Детали Или ЗначениеЗаполнено(Вызов.Исключение) Тогда
		ВидВызова = "вызов";
		Если ЭтоПовтор Тогда
			ВидВызова = "повторный вызов";
		КонецЕсли;
		Лог.Добавить(СтрШаблон("  %1 %2: мандатов %3, поручений %4, сборка %5 мс, вызов %6 мс, разбор %7 мс, xml %8 Кб, "
			+ "ошибки %9", ВидВызова, ФорматЧисла(Итог.Вызовов), ФорматЧисла(МандатовВВызове),
			ФорматЧисла(Вызов.Поручений), ФорматЧисла(Вызов.СборкаМс), ФорматЧисла(Вызов.ВызовМс),
			ФорматЧисла(Вызов.РазборМс), ФорматЧисла(Вызов.РазмерКб), КраткоОшибкиВызова(Вызов)));
	КонецЕсли;

	Возврат Вызов.ЕстьОшибки;

КонецФункции

// Собирает пакет поручений-блокировок по строкам, отправляет его вызовом DownloadOrders и разбирает ответ так же, как
// обработка выгрузки (ОбработатьОтвет без регистрации ненайденных объектов к обмену).
//
// Параметры:
//  Контекст - Структура - см. КонтекстОтправки
//  Строки - Массив из СтрокаТаблицыЗначений - строки блокировок
//  Суффикс - Строка - окончание кода поручения
//  ЭтоПометка - Булево - отправить поручения непроведенными с пометкой удаления
//
// Возвращаемое значение:
//  Структура - результат вызова:
//   * Поручений, Пропущено - Число - отправлено поручений и пропущено строк с кодом длиннее реквизита ФО
//   * СборкаМс, ВызовМс, РазборМс, РазмерКб - Число
//   * ЕстьОшибки - Булево - ответ содержит ошибки по ОбработатьОтвет или вызов завершился исключением
//   * Незагружено - Число - элементов НезагруженныеПоручения в ответе
//   * Ошибки - Соответствие - тип ошибки и Структура (Количество, Примеры)
//   * Исключение - Строка - описание исключения вызова
//
Функция ОтправитьПоручения(Контекст, Строки, Суффикс, ЭтоПометка)

	Вызов = Новый Структура("Поручений, Пропущено, СборкаМс, ВызовМс, РазборМс, РазмерКб, ЕстьОшибки, Незагружено, "
		+ "Ошибки, Исключение", 0, 0, 0, 0, 0, 0, Ложь, 0, Новый Соответствие, "");

	НачалоСборки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пакет = Контекст.Помощник.хдтоСформироватьПакетПоручений(Контекст.Фабрика);
	Пакет.ЗапускатьПроверкуЛимитов = Ложь;
	ЭтоТестовыйКод = СтрНачинаетсяС(Суффикс, "T9744");
	Для Каждого СтрокаБлокировки Из Строки Цикл
		КодПоручения = "LOCK:" + СтрокаБлокировки.КодСчета + ":" + Суффикс;
		Если ЭтоТестовыйКод И СтрДлина(КодПоручения) > ДлинаКодаПорученияФО() Тогда
			Вызов.Пропущено = Вызов.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		ДобавитьПоручение(Контекст, Пакет, КодПоручения, СтрокаБлокировки, ЭтоПометка);
		Вызов.Поручений = Вызов.Поручений + 1;
	КонецЦикла;
	Вызов.СборкаМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСборки;
	Если Вызов.Поручений = 0 Тогда
		Возврат Вызов;
	КонецЕсли;

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Ответ = Контекст.Прокси.DownloadOrders(Пакет);
	Исключение
		Вызов.ВызовМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
		Вызов.Исключение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Вызов.ЕстьОшибки = Истина;
		ДобавитьОшибкуВызова(Вызов.Ошибки, "Исключение вызова DownloadOrders", Вызов.Исключение);
		Вызов.РазмерКб = РазмерПакетаКб(Контекст.Фабрика, Пакет);
		Возврат Вызов;
	КонецПопытки;
	Вызов.ВызовМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;

	НачалоРазбора = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Рез = Контекст.Помощник.ОбработатьОтвет(Ответ, Контекст.Фабрика, Ложь, Неопределено, Неопределено);
	Вызов.ЕстьОшибки = Рез.ЕстьОшибки;
	Для Каждого СтрокаОшибки Из СтрРазделить(Рез.ТекстОшибки, Символы.ПС, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(СтрокаОшибки)) Тогда
			ДобавитьОшибкуВызова(Вызов.Ошибки, ТипОшибки(СокрЛП(СтрокаОшибки)), СокрЛП(СтрокаОшибки));
		КонецЕсли;
	КонецЦикла;
	Если Ответ.Свойства().Получить("НезагруженныеПоручения") <> Неопределено Тогда
		Для Каждого Незагруженное Из Ответ.НезагруженныеПоручения Цикл
			Вызов.Незагружено = Вызов.Незагружено + 1;
			ТекстНезагрузки = Строка(Незагруженное.ОшибкаЗагрузки);
			ДобавитьОшибкуВызова(Вызов.Ошибки, "Не загружено: " + Лев(ТекстНезагрузки, 100),
				Строка(Незагруженное.ВнешнийКод) + " " + ТекстНезагрузки);
		КонецЦикла;
	КонецЕсли;
	Вызов.РазборМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоРазбора;
	Вызов.РазмерКб = РазмерПакетаКб(Контекст.Фабрика, Пакет);

	Возврат Вызов;

КонецФункции

// Добавляет в пакет поручение-блокировку. Повторяет хдтоДобавитьВПакетБлокировку обработки выгрузки 1.42: неторговое
// поручение "Вывод" по портфелю, валюте и счету мандата на сумму блокировки.
//
// Параметры:
//  Контекст - Структура - см. КонтекстОтправки
//  Пакет - ОбъектXDTO - пакет поручений, дополняется
//  КодПоручения - Строка - внешний код поручения
//  СтрокаБлокировки - СтрокаТаблицыЗначений - блокировка: Мандат, Валюта, СчетМандата, Количество
//  ЭтоПометка - Булево - поручение непроведенное с пометкой удаления
//
Процедура ДобавитьПоручение(Контекст, Пакет, КодПоручения, СтрокаБлокировки, ЭтоПометка)

	Фабрика = Контекст.Фабрика;
	Помощник = Контекст.Помощник;
	ОбъектПоручения = Фабрика.Создать(Фабрика.Тип(Контекст.ПространствоИмен, "Поручение"));
	ОбъектПоручения.Проведен = Не ЭтоПометка;
	ОбъектПоручения.ПометкаУдаления = ЭтоПометка;
	ОбъектПоручения.ВнешнийКод = КодПоручения;
	ОбъектПоручения.Дата = Контекст.ДатаДляФронт;
	ОбъектПоручения.Ответственный = Фабрика.Создать(Фабрика.Тип(Контекст.ПространствоИмен, "ПользовательПоиск"));
	ОбъектПоручения.Ответственный.Наименование = "svc_avancore";
	ОбъектПоручения.Актив = Помощник.хдтоАктивПозицияПоиск(СтрокаБлокировки.Валюта, Фабрика);

	Реквизиты = Фабрика.Создать(ОбъектПоручения.Свойства().Получить("РеквизитыПоВидуОперации").Тип);
	ОбъектПоручения.РеквизитыПоВидуОперации = Реквизиты;
	Неторговое = Фабрика.Создать(Реквизиты.Свойства().Получить("НеторговоеПоручение").Тип);
	Реквизиты.НеторговоеПоручение = Неторговое;
	Неторговое.ВидОперацииНеторговогоПоручения = "Вывод";
	Неторговое.Портфель        = Помощник.хдтоПорфельПоиск(СтрокаБлокировки.Мандат, Фабрика);
	Неторговое.ВалютаРасчетов  = Помощник.хдтоВалютаПоиск(СтрокаБлокировки.Валюта, Фабрика);
	Неторговое.СубпортфельЦБ   = Помощник.хдтоСубпортфельПоиск(СтрокаБлокировки.СчетМандата, Фабрика);
	Неторговое.МестоХраненияЦБ = Помощник.хдтоМестоХраненияПоиск(СтрокаБлокировки.СчетМандата.МестоХранения, Фабрика);
	Неторговое.Количество      = СтрокаБлокировки.Количество;
	Неторговое.СуммаПоручения  = СтрокаБлокировки.Количество;

	Пакет.Поручения.Добавить(ОбъектПоручения);

КонецПроцедуры

// Подключается к веб-сервису ФО тем же способом, что обработка выгрузки.
//
// Параметры:
//  ВнешняяИБ - СправочникСсылка.ВнешниеИнформационныеБазы - веб-сервис ФО
//  ДатаДляФронт - Дата - дата поручений
//  ТекстОшибки - Строка - описание ошибки подключения, заполняется
//
// Возвращаемое значение:
//  Структура, Неопределено - контекст отправки или Неопределено при ошибке подключения:
//   * Прокси - WSПрокси
//   * Фабрика - ФабрикаXDTO
//   * Помощник - ОбработкаОбъект.внПроцедурыИФункцииОбменаСФронтОфис
//   * ПространствоИмен - Строка
//   * ДатаДляФронт - Дата - начало дня
//
Функция КонтекстОтправки(ВнешняяИБ, ДатаДляФронт, ТекстОшибки)

	СтруктураСервиса = Справочники.ВнешниеИнформационныеБазы.УстановитьВнешнееСоединениеWS(ВнешняяИБ);
	Если СтруктураСервиса.Статус = "Ошибка" Тогда
		ТекстОшибки = СтруктураСервиса.ОписаниеОшибки;
		Возврат Неопределено;
	КонецЕсли;

	Помощник = Обработки.внПроцедурыИФункцииОбменаСФронтОфис.Создать();
	Контекст = Новый Структура;
	Контекст.Вставить("Прокси", СтруктураСервиса.ПроксиWS);
	Контекст.Вставить("Фабрика", СтруктураСервиса.ПроксиWS.ФабрикаXDTO);
	Контекст.Вставить("Помощник", Помощник);
	Контекст.Вставить("ПространствоИмен", Помощник.ПолучитьПространствоИменСервиса());
	Контекст.Вставить("ДатаДляФронт", НачалоДня(ДатаДляФронт));
	Возврат Контекст;

КонецФункции

// Возвращает мандаты шага с их строками блокировок в порядке выборки.
//
// Параметры:
//  Шаг - Структура - шаг: Группа, Первый, Последний
//  Блокировки - ТаблицаЗначений - строки выборок
//
// Возвращаемое значение:
//  Массив из Структура - мандаты:
//   * Индекс - Число - номер мандата в группе
//   * Строки - Массив из СтрокаТаблицыЗначений - строки блокировок мандата
//
Функция МандатыШага(Шаг, Блокировки)

	Мандаты = Новый Массив;
	ТекущийИндекс = -1;
	Для Каждого СтрокаБлокировки Из Блокировки.НайтиСтроки(Новый Структура("Группа", Шаг.Группа)) Цикл
		Если СтрокаБлокировки.ИндексМандата < Шаг.Первый Или СтрокаБлокировки.ИндексМандата > Шаг.Последний Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаБлокировки.ИндексМандата <> ТекущийИндекс Тогда
			ТекущийИндекс = СтрокаБлокировки.ИндексМандата;
			Мандат = Новый Структура("Индекс, Строки", ТекущийИндекс, Новый Массив);
			Мандаты.Добавить(Мандат);
		КонецЕсли;
		Мандат.Строки.Добавить(СтрокаБлокировки);
	КонецЦикла;
	Возврат Мандаты;

КонецФункции

// Возвращает тип строки ошибки ответа ФО: известное начало строки из ОбработатьОтвет или первые 50 символов.
//
// Параметры:
//  СтрокаОшибки - Строка - строка текста ошибок
//
// Возвращаемое значение:
//  Строка - тип ошибки
//
Функция ТипОшибки(СтрокаОшибки)

	Для Каждого Начало Из СтрРазделить("Внутренняя ошибка сервиса,СтатусОтвета.Сообщения,Не найден Актив,"
		+ "Не найден Контрагент,Не найден Портфель,Не найдена Валюта,Не найден Субпортфель,Документ,Регистр сведений,"
		+ "Справочник", ",") Цикл
		Если СтрНачинаетсяС(СтрокаОшибки, Начало) Тогда
			Возврат Начало;
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(СтрокаОшибки, 50);

КонецФункции

// Учитывает строку ошибки вызова.
//
// Параметры:
//  Ошибки - Соответствие - тип ошибки и Структура (Количество, Примеры), дополняется
//  Тип - Строка - тип ошибки
//  Пример - Строка - текст строки ошибки
//
Процедура ДобавитьОшибкуВызова(Ошибки, Тип, Пример)

	Сведения = Ошибки.Получить(Тип);
	Если Сведения = Неопределено Тогда
		Сведения = Новый Структура("Количество, Примеры", 0, Новый Массив);
		Ошибки.Вставить(Тип, Сведения);
	КонецЕсли;
	Сведения.Количество = Сведения.Количество + 1;
	Если Сведения.Примеры.Количество() < 3 Тогда
		Сведения.Примеры.Добавить(Лев(Пример, 200));
	КонецЕсли;

КонецПроцедуры

// Возвращает размер пакета в килобайтах по XML-представлению.
//
// Параметры:
//  Фабрика - ФабрикаXDTO - фабрика сервиса
//  Пакет - ОбъектXDTO - пакет поручений
//
// Возвращаемое значение:
//  Число - размер, Кб
//
Функция РазмерПакетаКб(Фабрика, Пакет)

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	Фабрика.ЗаписатьXML(ЗаписьXML, Пакет);
	Возврат Окр(СтрДлина(ЗаписьXML.Закрыть()) / 1024, 0);

КонецФункции

#КонецОбласти

#Область Итоги

// Выводит сводку по сериям, оценку полного объема блокировок и итог проверки ошибок пакетов.
//
// Параметры:
//  Лог - Массив из Строка - строки лога, дополняются
//  Данные - Структура - данные замера
//
Процедура ВывестиИтоги(Лог, Данные)

	Лог.Добавить("");
	Лог.Добавить("--- Итоги по шагам");
	ВывестиТаблицу(Лог, Данные.Итоги, 200);

	Сводка = Данные.Итоги.Скопировать(Новый Структура("Вид", "Отправка"));
	Сводка.Колонки.Добавить("Шагов");
	Сводка.ЗаполнитьЗначения(1, "Шагов");
	Для Каждого ИмяКолонки Из СтрРазделить("Шагов,Мандатов,Блокировок,Поручений,Вызовов,ВсегоМс,СборкаМс,ВызовМс,"
		+ "РазборМс,ПакетовСОшибками,ПовторныхВызовов,ПовторМс,Незагружено,Исключений", ",") Цикл
		Для Каждого СтрокаСводки Из Сводка Цикл
			СтрокаСводки[ИмяКолонки] = Число(СтрокаСводки[ИмяКолонки]);
		КонецЦикла;
	КонецЦикла;
	Сводка.Свернуть("Серия", "Шагов,Мандатов,Блокировок,Поручений,Вызовов,ВсегоМс,СборкаМс,ВызовМс,РазборМс,"
		+ "ПакетовСОшибками,ПовторныхВызовов,ПовторМс,Незагружено,Исключений");

	Таблица = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Серия,Шагов,Блокировок,Поручений,Вызовов,ВсегоСек,МсНаБлокировку,МсНаВызов,СборкаМс,"
		+ "ВызовМс,РазборМс,ПакетовСОшибками,ПовторныхВызовов,ПовторСек,ОценкаМинВсе1Поток,ОценкаМинВсеНаПотоки", ",") Цикл
		Таблица.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Потоков = Макс(1, Данные.Параметры.ПотоковВыгрузки);
	Для Каждого СтрокаСводки Из Сводка Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСводки);
		НоваяСтрока.ВсегоСек = Окр(СтрокаСводки.ВсегоМс / 1000, 1);
		НоваяСтрока.ПовторСек = Окр(СтрокаСводки.ПовторМс / 1000, 1);
		Если СтрокаСводки.Блокировок > 0 Тогда
			МсНаБлокировку = СтрокаСводки.ВсегоМс / СтрокаСводки.Блокировок;
			НоваяСтрока.МсНаБлокировку = Окр(МсНаБлокировку, 1);
			НоваяСтрока.ОценкаМинВсе1Поток = Окр(МсНаБлокировку * Данные.ВсегоСтрок / 60000, 1);
			НоваяСтрока.ОценкаМинВсеНаПотоки = Окр(МсНаБлокировку * Данные.ВсегоСтрок / 60000 / Потоков, 1);
		КонецЕсли;
		Если СтрокаСводки.Вызовов > 0 Тогда
			НоваяСтрока.МсНаВызов = Окр(СтрокаСводки.ВсегоМс / СтрокаСводки.Вызовов, 0);
		КонецЕсли;
	КонецЦикла;

	Лог.Добавить("");
	Лог.Добавить(СтрШаблон("--- Сводка по сериям. Оценка - время отправки всех %1 поручений-блокировок с той же скоростью "
		+ "в 1 поток и на %2 потоков (без учета конкуренции потоков за ФО)", ФорматЧисла(Данные.ВсегоСтрок),
		ФорматЧисла(Потоков)));
	ВывестиТаблицу(Лог, Таблица, 50);

	Пакетов = 0;
	ПакетовСОшибками = 0;
	Для Каждого СтрокаПроверки Из Данные.Итоги Цикл
		Если СтрНачинаетсяС(СтрокаПроверки.Серия, "Проверка ошибок") Тогда
			Пакетов = Пакетов + СтрокаПроверки.Вызовов;
			ПакетовСОшибками = ПакетовСОшибками + СтрокаПроверки.ПакетовСОшибками;
		КонецЕсли;
	КонецЦикла;
	Лог.Добавить("");
	Лог.Добавить("--- Проверка ошибок пакетов (при ошибке 1.43 отправляет пакет повторно по мандатам)");
	Если Пакетов = 0 Тогда
		Лог.Добавить("Проверка не выполнялась");
	Иначе
		Лог.Добавить(СтрШаблон("Пакетов %1, с ошибками %2 (%3 процента)", ФорматЧисла(Пакетов),
			ФорматЧисла(ПакетовСОшибками), ФорматДесятых(ПакетовСОшибками * 100 / Пакетов)));
		Для Каждого ЭлементОшибки Из Данные.ОшибкиПроверки Цикл
			Лог.Добавить(СтрШаблон("  %1: %2 строк", ЭлементОшибки.Ключ, ФорматЧисла(ЭлементОшибки.Значение)));
		КонецЦикла;
	КонецЕсли;

	Лог.Добавить("");
	Лог.Добавить("--- Примеры ошибок (до 3 на тип)");
	Для Каждого ЭлементПримеров Из Данные.ПримерыОшибок Цикл
		Для Каждого Пример Из ЭлементПримеров.Значение Цикл
			Лог.Добавить("  " + Пример);
		КонецЦикла;
	КонецЦикла;
	Лог.Добавить("");
	Лог.Добавить("Тестовые поручения в ФО: Документ.Поручение с ВнешнийКод ПОДОБНО ""LOCK:%:T9744%""");

КонецПроцедуры

// Возвращает строку итога шага.
//
// Параметры:
//  Итог - СтрокаТаблицыЗначений - итог шага
//
// Возвращаемое значение:
//  Строка - итог
//
Функция ПредставлениеИтогаШага(Итог)

	МсНаБлокировку = 0;
	Если Итог.Блокировок > 0 Тогда
		МсНаБлокировку = Итог.ВсегоМс / Итог.Блокировок;
	КонецЕсли;
	Объем = СтрШаблон("ИТОГ шага %1 (%2): мандатов %3, блокировок %4, отправлено поручений %5, вызовов %6, всего %7 с, "
		+ "на блокировку %8 мс; сборка %9 мс, вызовы %10 мс; ",
		Итог.Номер, Итог.Серия, ФорматЧисла(Итог.Мандатов), ФорматЧисла(Итог.Блокировок), ФорматЧисла(Итог.Поручений),
		ФорматЧисла(Итог.Вызовов), ФорматДесятых(Итог.ВсегоМс / 1000), ФорматДесятых(МсНаБлокировку),
		ФорматЧисла(Итог.СборкаМс), ФорматЧисла(Итог.ВызовМс));
	Ошибки = СтрШаблон("разбор %1 мс; пакетов с ошибками %2, повторных вызовов %3 (%4 с); не загружено %5, "
		+ "исключений %6, пропущено длинных кодов %7, макс. пакет %8 Кб", ФорматЧисла(Итог.РазборМс),
		ФорматЧисла(Итог.ПакетовСОшибками),
		ФорматЧисла(Итог.ПовторныхВызовов), ФорматДесятых(Итог.ПовторМс / 1000), ФорматЧисла(Итог.Незагружено),
		ФорматЧисла(Итог.Исключений), ФорматЧисла(Итог.Пропущено), ФорматЧисла(Итог.МаксКб));
	Возврат Объем + Ошибки;

КонецФункции

// Возвращает строку ошибок шага по типам, переносит примеры в общий список и учитывает ошибки проверки.
//
// Параметры:
//  ОшибкиШага - Соответствие - тип ошибки и Структура (Количество, Примеры)
//  ПримерыОшибок - Соответствие - тип ошибки и массив примеров, дополняется до 3 примеров на тип
//  ОшибкиПроверки - Соответствие, Неопределено - тип ошибки и число строк в проверке, дополняется
//
// Возвращаемое значение:
//  Строка - ошибки шага
//
Функция ПредставлениеОшибок(ОшибкиШага, ПримерыОшибок, ОшибкиПроверки)

	Если Не ЗначениеЗаполнено(ОшибкиШага) Тогда
		Возврат "Ошибок в ответах нет";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого ЭлементОшибки Из ОшибкиШага Цикл
		Количество = ЭлементОшибки.Значение.Количество;
		Части.Добавить(ЭлементОшибки.Ключ + ": " + ФорматЧисла(Количество));

		Примеры = ПримерыОшибок.Получить(ЭлементОшибки.Ключ);
		Если Примеры = Неопределено Тогда
			Примеры = Новый Массив;
			ПримерыОшибок.Вставить(ЭлементОшибки.Ключ, Примеры);
		КонецЕсли;
		Для Каждого Пример Из ЭлементОшибки.Значение.Примеры Цикл
			Если Примеры.Количество() < 3 Тогда
				Примеры.Добавить(Пример);
			КонецЕсли;
		КонецЦикла;

		Если ОшибкиПроверки <> Неопределено Тогда
			Было = ОшибкиПроверки.Получить(ЭлементОшибки.Ключ);
			Если Было = Неопределено Тогда
				Было = 0;
			КонецЕсли;
			ОшибкиПроверки.Вставить(ЭлементОшибки.Ключ, Было + Количество);
		КонецЕсли;
	КонецЦикла;
	Возврат "Ошибки в ответах (тип: строк): " + СтрСоединить(Части, "; ");

КонецФункции

// Возвращает краткое описание ошибок вызова для строки вызова и сохраняет примеры.
//
// Параметры:
//  Вызов - Структура - результат ОтправитьПоручения
//
// Возвращаемое значение:
//  Строка - "нет" или типы ошибок с числом строк
//
Функция КраткоОшибкиВызова(Вызов)

	Если Не Вызов.ЕстьОшибки И Не ЗначениеЗаполнено(Вызов.Ошибки) Тогда
		Возврат "нет";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого ЭлементОшибки Из Вызов.Ошибки Цикл
		Части.Добавить(ЭлементОшибки.Ключ + " x" + ФорматЧисла(ЭлементОшибки.Значение.Количество));
	КонецЦикла;
	Если Вызов.ЕстьОшибки Тогда
		Возврат "ДА: " + СтрСоединить(Части, "; ");
	КонецЕсли;
	Возврат "сообщения: " + СтрСоединить(Части, "; ");

КонецФункции

