// Возвращает описание шага для лога и состояния формы.
//
// Параметры:
//  Шаг - Структура - шаг
//  Данные - Структура - данные замера
//
// Возвращаемое значение:
//  Строка - описание
//
Функция ПредставлениеШага(Шаг, Данные)

	Если Шаг.Вид = "Итоги" Тогда
		Возврат СтрШаблон("Шаг %1. Итоги", Шаг.Номер);
	КонецЕсли;
	Если Шаг.Вид = "Пометка" Тогда
		Коды = "тестовые коды " + Шаг.Суффиксы;
	ИначеЕсли СтрНачинаетсяС(Шаг.Суффикс, "T9744") Тогда
		Коды = "тестовые коды " + Шаг.Суффикс;
	Иначе
		Коды = "реальные коды " + Шаг.Суффикс;
	КонецЕсли;
	Выборка = "проверки";
	Если Шаг.Группа = "З" Тогда
		Выборка = "сравнения";
	КонецЕсли;
	Повтор = "";
	Если Шаг.Повтор143 Тогда
		Повтор = ", при ошибке пакета повтор по мандатам (как 1.43)";
	КонецЕсли;
	Возврат СтрШаблон("Шаг %1. %2: выборка %3, мандаты %4-%5, %6%7", Шаг.Номер, Шаг.Серия, Выборка, Шаг.Первый + 1,
		Шаг.Последний + 1, Коды, Повтор);

КонецФункции

