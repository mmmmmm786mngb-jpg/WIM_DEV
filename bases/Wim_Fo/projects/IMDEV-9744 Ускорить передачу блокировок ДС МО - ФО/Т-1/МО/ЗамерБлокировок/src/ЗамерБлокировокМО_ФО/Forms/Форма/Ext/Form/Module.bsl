&НаКлиенте
Перем мШаги; // Массив из Структура - шаги замера, см. ПодготовитьЗамер модуля объекта
&НаКлиенте
Перем мИндексШага; // Число - индекс следующего шага в мШаги
&НаКлиенте
Перем мОстановить; // Булево - пользователь нажал "Остановить": выполняется только шаг итогов

#Область ОбработчикиСобытийФормы

// Заполняет параметры замера значениями по умолчанию.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Обработка = РеквизитФормыВЗначение("Объект");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Обработка.ПараметрыПоУмолчанию());
	Состояние = "Проверьте веб-сервис ФО (только Т-1) и нажмите ""Начать замер""";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Готовит замер на сервере и запускает шаги по одному через обработчик ожидания, чтобы форма показывала ход замера.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура НачатьЗамер(Команда)

	Если Не ЗначениеЗаполнено(АдресФО) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите часть адреса веб-сервиса ФО Т-1", , "АдресФО");
		Возврат;
	КонецЕсли;

	мОстановить = Ложь;
	Лог = "";
	Состояние = "Подготовка: выборка мандатов и блокировок...";
	мШаги = ПодготовитьНаСервере();
	Если Не ЗначениеЗаполнено(мШаги) Тогда
		Состояние = "Замер не начат, причина в логе";
		Возврат;
	КонецЕсли;

	мИндексШага = 0;
	Элементы.ФормаНачатьЗамер.Доступность = Ложь;
	Элементы.ФормаОстановить.Доступность = Истина;
	ПодключитьОбработчикОжидания("ВыполнитьОчереднойШаг", 0.1, Истина);

КонецПроцедуры

// Останавливает замер после текущего шага; итоги по выполненным шагам выводятся.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Остановить(Команда)

	мОстановить = Истина;
	Состояние = "Остановка после текущего шага...";

КонецПроцедуры

// Сохраняет лог в файл на компьютере пользователя (UTF-8) через диалог сохранения платформы.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(Лог) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Лог пуст");
		Возврат;
	КонецЕсли;

	ПолучитьФайл(АдресФайла(), ИмяФайла, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет очередной шаг замера и планирует следующий. После остановки выполняет только шаг итогов.
//
&НаКлиенте
Процедура ВыполнитьОчереднойШаг()

	Если мОстановить И мИндексШага < мШаги.ВГраница() Тогда
		мИндексШага = мШаги.ВГраница();
	КонецЕсли;

	Шаг = мШаги[мИндексШага];
	Состояние = СтрШаблон("Шаг %1 из %2: %3", Шаг.Номер, мШаги.Количество(), Шаг.Серия);
	ВыполнитьШагНаСервере(Шаг);
	мИндексШага = мИндексШага + 1;

	Если мИндексШага > мШаги.ВГраница() Тогда
		Элементы.ФормаНачатьЗамер.Доступность = Истина;
		Элементы.ФормаОстановить.Доступность = Ложь;
		Состояние = "Замер завершен. Сохраните лог в файл и пришлите его.";
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ВыполнитьОчереднойШаг", 0.1, Истина);

КонецПроцедуры

// Готовит замер модулем объекта: лог подготовки - в реквизит Лог, данные замера - во временное хранилище формы.
//
// Возвращаемое значение:
//  Массив из Структура - шаги замера; пустой массив, если замер невозможен
//
&НаСервере
Функция ПодготовитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	ПараметрыЗамера = Обработка.ПараметрыПоУмолчанию();
	Для Каждого Параметр Из Обработка.ПараметрыПоУмолчанию() Цикл
		ПараметрыЗамера.Вставить(Параметр.Ключ, ЭтотОбъект[Параметр.Ключ]);
	КонецЦикла;
	Результат = Обработка.ПодготовитьЗамер(ПараметрыЗамера);

	Лог = Результат.Лог;
	ИмяФайла = "Замер_блокировок_МО_ФО_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt";
	Если Результат.Данные <> Неопределено Тогда
		АдресДанных = ПоместитьВоВременноеХранилище(Результат.Данные, УникальныйИдентификатор);
	КонецЕсли;
	Возврат Результат.Шаги;

КонецФункции

// Выполняет шаг модулем объекта, дописывает лог шага и сохраняет данные замера.
//
// Параметры:
//  Шаг - Структура - шаг замера
//
&НаСервере
Процедура ВыполнитьШагНаСервере(Знач Шаг)

	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	Лог = Лог + Обработка.ВыполнитьШаг(Шаг, Данные);
	ПоместитьВоВременноеХранилище(Данные, АдресДанных);

КонецПроцедуры

// Помещает текст лога во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла (UTF-8)
//
&НаСервере
Функция АдресФайла()

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(Лог);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");
	ТекстовыйДокумент.Записать(ИмяВременногоФайла, КодировкаТекста.UTF8);
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), УникальныйИдентификатор);
	УдалитьФайлы(ИмяВременногоФайла);
	Возврат Адрес;

КонецФункции

#КонецОбласти
