#Область ОбработчикиСобытийФормы

// Заполняет глубину истории по умолчанию и строку соединения базы.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы
//  СтандартнаяОбработка - Булево - признак стандартной обработки
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДнейИстории      = 30;
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Собирает лог диагностики на сервере. Данные базы не меняются.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Собрать(Команда)

	Результат = "Выполняется сбор...";
	СобратьНаСервере();

КонецПроцедуры

// Сохраняет текст лога в файл на компьютере пользователя (UTF-8) через диалог сохранения платформы.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Если Не ЗначениеЗаполнено(Результат) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сначала соберите лог");
		Возврат;
	КонецЕсли;

	ПолучитьФайл(АдресФайла(), ИмяФайла, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет сбор лога модулем объекта, помещает текст в реквизит Результат и заполняет имя файла.
//
&НаСервере
Процедура СобратьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.СобратьЛог(ДнейИстории);
	ИмяФайла  = "Диагностика_МО_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmm") + ".txt";

КонецПроцедуры

// Помещает текст лога во временное хранилище формы.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных файла (UTF-8)
//
&НаСервере
Функция АдресФайла()

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(Результат);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");
	ТекстовыйДокумент.Записать(ИмяВременногоФайла, КодировкаТекста.UTF8);
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), УникальныйИдентификатор);
	УдалитьФайлы(ИмяВременногоФайла);
	Возврат Адрес;

КонецФункции

#КонецОбласти
