Функция ИмпортироватьНастройки(АдресВременногоХранилища, GuidОбъекта = "",Режим = "ПАКЕТНЫЙ") Экспорт
	ДвоичныеДанные_ = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);  // вытаскиваем на сервере из временного хранилища как двоичные данные
    ИмяВременногоФайла = СформироватьИмяВременногоФайла(GuidОбъекта);
	//ПолучитьИмяВременногоФайла("txt"); // получаем имя временного файла на сервере
    ДвоичныеДанные_.Записать(ИмяВременногоФайла);     
	
	СтруктураРезультат = ИмпортироватьНастройкиИзФайла(ИмяВременногоФайла, "UTF-8",Режим,GuidОбъекта);
	//ИмпортироватьНастройкиИзСтруктуры(СтруктураРезультат, Объект);
	Возврат(ИмпортироватьНастройкиИзСтруктуры(СтруктураРезультат));
КонецФункции

Функция СформироватьИмяВременногоФайла(GuidОбъекта)
	РасширениеФайла = ".txt";
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеФайла);
	ИмяВременногоФайлаБезРасширения = СтрЗаменить(ИмяВременногоФайла, РасширениеФайла, "");
	Возврат ИмяВременногоФайлаБезРасширения + "_" + GuidОбъекта + РасширениеФайла;
КонецФункции

Функция ИмпортироватьНастройкиИзФайла(ИмяВременногоФайла, Кодировка,Режим,GuidОбъекта) Экспорт
	тзРеквизиты = Новый ТаблицаЗначений;
	тзРеквизиты.Колонки.Добавить("Имя");
	тзРеквизиты.Колонки.Добавить("Тип");
	тзРеквизиты.Колонки.Добавить("Значение");
	
	СтруктураРезультат = Новый Структура();
	СтруктураРезультат.Вставить("Приемник", Неопределено);
	СтруктураРезультат.Вставить("Реквизиты", тзРеквизиты);
	СтруктураРезультат.Вставить("ТабличныеЧасти", Новый Соответствие);
	
	// Подготавливаем структуры обработки данных.
	НайденКонецФайла = Ложь;
	// Получаем исходные данные.
	Импорт_ТекстДляРазбора = ПрочитатьФайл(ИмяВременногоФайла, Кодировка, СтруктураРезультат.Приемник);
	
	Если Импорт_ТекстДляРазбора = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Файл загрузки не содержит данных!'");
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	
	// Заполняем первичные структуры данных.
	Импорт_КоличествоСтрок = СтрЧислоСтрок(Импорт_ТекстДляРазбора);
	Импорт_ТекущаяСтрока = 1;
	
	Тег = "";
	ИмяТЧ = "";
	Пока Импорт_ТекущаяСтрока <= Импорт_КоличествоСтрок Цикл
		Стр = ПолучитьСтрокуИмпорта(Импорт_ТекущаяСтрока, Импорт_КоличествоСтрок, Импорт_ТекстДляРазбора);
		
		Если Лев(Врег(СокрЛП(Стр)), 8) = "РЕКВИЗИТ" Тогда
			НоваяСтрокаРеквизитов = СтруктураРезультат.Реквизиты.Добавить();
			Если НЕ ЗагрузитьСекциюРеквизитов(Стр, НоваяСтрокаРеквизитов) Тогда
				Возврат Неопределено;
			КонецЕсли;
		ИначеЕсли Лев(Врег(СокрЛП(Стр)), 4) = "GUID" Тогда 
			Если Режим = "ПАКЕТНЫЙ" Тогда
				СтруктураРезультат.Вставить("GUID",Прав(Стр,СтрДлина(Стр)-(4+3)));
			Иначе  
				СтруктураРезультат.Вставить("GUID",GuidОбъекта);
			КонецЕсли;
		ИначеЕсли Лев(Врег(СокрЛП(Стр)), 7) = "СИНОНИМ" Тогда 			
			СтруктураРезультат.Вставить("СИНОНИМ",Прав(Стр,СтрДлина(Стр)-(7+3)));

		ИначеЕсли Лев(Врег(СокрЛП(Стр)), 15) = "[ТАБЛИЧНАЯЧАСТЬ" Тогда

			ИмяТЧ = "";
			Тег = "";
			Если РазобратьТеговуюСтроку(СтрЗаменить(Стр, "]", ""), Тег, ИмяТЧ) Тогда
				СтруктураРезультат.ТабличныеЧасти.Вставить(ИмяТЧ, Новый Массив);
			КонецЕсли;
		ИначеЕсли Лев(Врег(СокрЛП(Стр)), 22) = "[СТРОКАТАБЛИЧНОЙЧАСТИ]" Тогда
			тзРеквизитыСтрокиТЧ = Новый ТаблицаЗначений;
			тзРеквизитыСтрокиТЧ.Колонки.Добавить("Имя");
			тзРеквизитыСтрокиТЧ.Колонки.Добавить("Тип");
			тзРеквизитыСтрокиТЧ.Колонки.Добавить("Значение");
			СтруктураРезультат.ТабличныеЧасти[ИмяТЧ].Добавить(тзРеквизитыСтрокиТЧ);
		ИначеЕсли Лев(Врег(СокрЛП(Стр)), 8) = "СТРОКАТЧ" Тогда
			НоваяСтрокаТЧ = тзРеквизитыСтрокиТЧ.Добавить();
			Если НЕ ЗагрузитьСекциюРеквизитов(Стр, НоваяСтрокаТЧ) Тогда
				Возврат Неопределено;
			КонецЕсли;
		ИначеЕсли Лев(Врег(СокрЛП(Стр)), 10) = "КОНЕЦФАЙЛА" Тогда
			НайденКонецФайла = Истина;
			НомерСтроки = 0;
			
			Возврат СтруктураРезультат;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ НайденКонецФайла Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Файл настроек не соответствует стандарту (не найдена секция КонецФайла)!'");
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

//Процедура ИмпортироватьНастройкиИзСтруктуры(СтруктураНастроек, Объект) Экспорт
Функция ИмпортироватьНастройкиИзСтруктуры(СтруктураНастроек) Экспорт
	//Получаем объект обработки
	guidОбъекта = Неопределено;
	Синоним = Неопределено;
	Объект = Неопределено;
	Результат = Новый Структура;	
	СсылкаНаОбъект = Неопределено;

	Если СтруктураНастроек.Свойство("GUID", guidОбъекта) Тогда
		// Действия для получения объекта обработки.
		СсылкаНаОбъект = Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор(guidОбъекта));
	КонецЕсли;	
	Если НЕ ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) ИЛИ СсылкаНаОбъект =  Неопределено Тогда
		Результат.Вставить("Результат","Fail: Настройки не загружены для " + Синоним +", обработка не найдена. Загруите настройки вручную" );
		Сообщить (Результат.Результат);
		Возврат Результат;
    КонецЕсли;
		
	Объект = ДополнительныеОтчетыИОбработки.ПолучитьОбъектВнешнейОбработки(СсылкаНаОбъект);
	
	
	//Реквизиты
	КоллекцияРеквизитов = Неопределено;
	Если СтруктураНастроек.Свойство("Реквизиты", КоллекцияРеквизитов) И Объект <> Неопределено Тогда
		Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
			Попытка
				ЗагрузитьЗначениеРеквизита(Реквизит, Объект[Реквизит.Имя]);
			Исключение 
				Сообщить("не удалось загрузить значение реквизита " + Реквизит.Имя);
			КонецПопытки;
		КонецЦикла;	
	КонецЕсли;
	ДопОтчетОбъект = СсылкаНаОбъект.ПолучитьОбъект();	
	//ТабличныеЧасти
	КоллекцияТабличныхЧастей = Неопределено;
	Если СтруктураНастроек.Свойство("ТабличныеЧасти", КоллекцияТабличныхЧастей) И Объект <> Неопределено Тогда
		Для Каждого ТабличнаяЧасть Из КоллекцияТабличныхЧастей Цикл
			Если ТабличнаяЧасть.Ключ = "Команды" Тогда 
				
               	УстановитьПривилегированныйРежим(Истина);
                
				Для Каждого СтрокаТЧ Из ТабличнаяЧасть.Значение Цикл
					Задание = Неопределено;
					Для Каждого Реквизит Из СтрокаТЧ Цикл
						Если Реквизит.Имя = "Идентификатор" Тогда 
							Отбор = Новый Структура;
							Отбор.Вставить(Реквизит.Имя,Реквизит.Значение);
							СтрКоманда = ДопОтчетОбъект.Команды.НайтиСтроки(Отбор);
							Если  СтрКоманда.Количество()>0 Тогда
								КомандаОбработки = СтрКоманда[0];
								Если ЗначениеЗаполнено(КомандаОбработки.РегламентноеЗаданиеGUID) Тогда
									Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(КомандаОбработки.РегламентноеЗаданиеGUID)
								КонецЕсли;  
								
							КонецЕсли;
						ИначеЕсли Реквизит.Имя = "РегламентноеЗаданиеGUID" Тогда
							РегламентноеЗаданиеGUID = "";//Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"); 
							ЗагрузитьЗначениеРеквизита(Реквизит,РегламентноеЗаданиеGUID);
						ИначеЕсли Реквизит.Имя = "Использование" Тогда 
							Если  Задание = Неопределено и Реквизит.Значение = "Да" Тогда
								Если РегламентноеЗаданиеGUID <> "" и РегламентноеЗаданиеGUID<> "00000000-0000-0000-0000-000000000000" Тогда
									Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(РегламентноеЗаданиеGUID));
								Иначе	   
									Задание = СоздатьНовоеЗадание(
										ПредставлениеЗадания(ДопОтчетОбъект,КомандаОбработки));
									
									КомандаОбработки.РегламентноеЗаданиеGUID = 
										ПолучитьИдентификаторЗадания(
											Задание);  
									Задание.Наименование = Лев(Задание.Наименование,100);
		                            Задание.Использование =  Истина;
								КонецЕсли; 
								Если Задание = Неопределено Тогда 
									Задание = СоздатьНовоеЗадание(
										ПредставлениеЗадания(ДопОтчетОбъект,КомандаОбработки));
									
									КомандаОбработки.РегламентноеЗаданиеGUID = 
										ПолучитьИдентификаторЗадания(
											Задание);  
									Задание.Наименование = Лев(Задание.Наименование,100);
		                            Задание.Использование =  Истина;
	                              // 	
							  КонецЕсли;                            
						 	  
						  	Иначе
								Если НЕ Задание = Неопределено Тогда 
									Задание.Использование =  ?(Реквизит.Значение = "Да",Истина,Ложь)
								КонецЕсли;
							КонецЕсли;
						ИначеЕсли Реквизит.Имя = "Ключ" И НЕ Задание = Неопределено Тогда
							Задание.Ключ = Реквизит.Значение;
						ИначеЕсли Реквизит.Имя = "ИмяПользователя" И НЕ Задание = Неопределено Тогда
							Задание.ИмяПользователя = Реквизит.Значение;
						ИначеЕсли Реквизит.Имя = "Расписание" И НЕ Задание = Неопределено Тогда
							СтруктураРасписанияИзФайла = СтрокаВСтруктуру(Реквизит.Значение); 
							ЗаполнитьРасипсаниеПоСтруктуре(Задание.Расписание,СтруктураРасписанияИзФайла);
						КонецЕсли;
					КонецЦикла;	
					Если Не Задание = Неопределено Тогда 
						Задание.Записать();
					КонецЕсли;

				КонецЦикла;	
				УстановитьПривилегированныйРежим(Ложь);
			ИначеЕсли ТабличнаяЧасть.Ключ = "Разделы" Тогда 
	            ТабличнаяЧастьОбъект = ДопОтчетОбъект[ТабличнаяЧасть.Ключ];
			    ТабличнаяЧастьОбъект.Очистить();
				
				Для Каждого СтрокаТЧ Из ТабличнаяЧасть.Значение Цикл
					НоваяСтрока = ТабличнаяЧастьОбъект.Добавить();
					Для Каждого Реквизит Из СтрокаТЧ Цикл
						Попытка
							ЗагрузитьЗначениеРеквизита(Реквизит, НоваяСтрока[Реквизит.Имя]);
						Исключение
						КонецПопытки;
					КонецЦикла;	
				КонецЦикла;	

			Иначе
				ТабличнаяЧастьОбъект = Объект[ТабличнаяЧасть.Ключ];
				ТабличнаяЧастьОбъект.Очистить();
				
				Для Каждого СтрокаТЧ Из ТабличнаяЧасть.Значение Цикл
					НоваяСтрока = ТабличнаяЧастьОбъект.Добавить();
					Для Каждого Реквизит Из СтрокаТЧ Цикл
						Попытка
							ЗагрузитьЗначениеРеквизита(Реквизит, НоваяСтрока[Реквизит.Имя]);
						Исключение
						КонецПопытки;
					КонецЦикла;	
				КонецЦикла;	
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли; 
	ДопОтчетОбъект.Записать();
	
	//Загрузка настроек фоновых команд
		//Запись в хранилище настроек 
	Попытка
		ЗаписатьСтруктуруНастроекВСправочник(Объект, СсылкаНаОбъект);
		Результат.Вставить("Результат","ОК: Настройки загружены для " + Синоним);
		Результат.Вставить("Отказ",Ложь)
	Исключение
		Результат.Вставить("Результат","Fail: Настройки не загружены для " + Синоним);
		Результат.Вставить("Отказ",Истина)
	КонецПопытки;
		
	Возврат Результат

КонецФункции

Процедура ЗаписатьСтруктуруНастроекВСправочник(Объект, СсылкаНаОбъект) Экспорт
	ЗаголовокНастроек = "";
	ЗначенияПараметров = СоздатьСтрутктуруНостроек(Объект); //Объект.УстановитьПользовательскиеНастройки(ЗаголовокНастроек);//
	//УстановитьПараметры(ЗаголовокНастроек);
	СтруктураНастроек = Новый Структура("Значения, ЗаголовокНастроек", ЗначенияПараметров, ЗаголовокНастроек);
	СправочникОбъект = СсылкаНаОбъект.ПолучитьОбъект();
	СправочникОбъект.ХранилищеНастроек = Новый ХранилищеЗначения(СтруктураНастроек);
	СправочникОбъект.Записать();
КонецПроцедуры	            

Функция СоздатьСтрутктуруНостроек(Объект) Экспорт
	ЗначенияПараметров = Новый Структура;
	Для каждого реквизит из  Объект.Метаданные().Реквизиты Цикл
		ЗначенияПараметров.Вставить(реквизит.Имя,Объект[реквизит.Имя])	
	КонецЦикла;
	
	Для каждого ТЧ из  Объект.Метаданные().ТабличныеЧасти Цикл
		ЗначенияПараметров.Вставить(ТЧ.Имя,XMLСтрока(Новый ХранилищеЗначения(Объект[ТЧ.Имя].Выгрузить())))	
	КонецЦикла;
	
	Возврат ЗначенияПараметров;	
КонецФункции

Процедура ЗаполнитьРасипсаниеПоСтруктуре(Расписание,Структура)
	
	
	ЗаполнитьЗначенияСвойств(Расписание,Структура);
	Массив = Новый Массив;
	Расписание.ДетальныеРасписанияДня = Массив;
	Если НЕ Структура.DetailedDailySchedules = "" и Структура.DetailedDailySchedules.Количество() > 0 Тогда
		Для каждого эл ИЗ Структура.DetailedDailySchedules Цикл
			Массив.Добавить(эл);	
		КонецЦикла;
	     Расписание.ДетальныеРасписанияДня = Массив;
	КонецЕсли;
КонецПроцедуры


Функция СтрокаВСтруктуру(Строка)
	СоответсвиеАнгРекРус = Новый структура;
	СоответсвиеАнгРекРус.Вставить("CompletionTime","ВремяЗавершения");
	СоответсвиеАнгРекРус.Вставить("EndTime","ВремяКонца");
	СоответсвиеАнгРекРус.Вставить("BeginTime","ВремяНачала");
	СоответсвиеАнгРекРус.Вставить("EndDate","ДатаКонца");
	СоответсвиеАнгРекРус.Вставить("BeginDate","ДатаНачала");
	СоответсвиеАнгРекРус.Вставить("DayInMonth","ДеньВМесяце");
	СоответсвиеАнгРекРус.Вставить("WeekDayInMonth","ДеньНеделиВМесяце");
	СоответсвиеАнгРекРус.Вставить("DetailedDailySchedules","ДетальныеРасписанияДня");
	СоответсвиеАнгРекРус.Вставить("WeekDays","ДниНедели");
	СоответсвиеАнгРекРус.Вставить("CompletionInterval","ИнтервалЗавершения");
	СоответсвиеАнгРекРус.Вставить("Months","Месяцы");
	СоответсвиеАнгРекРус.Вставить("RepeatPause","ПаузаПовтора");
	СоответсвиеАнгРекРус.Вставить("WeeksPeriod","ПериодНедель");
	СоответсвиеАнгРекРус.Вставить("DaysRepeatPeriod","ПериодПовтораВТечениеДня");
	СоответсвиеАнгРекРус.Вставить("RepeatPeriodInDay","ПериодПовтораДней");

	РезультатСтруктура = Новый Структура;
	
	Пока СтрДлина(Строка)> 0 и НЕ Строка = "&"  Цикл
		ПодстракаРевизит = Лев(Строка,Найти(Строка,"&"));
		Строка = Прав(Строка,Стрдлина(Строка)-Стрдлина(ПодстракаРевизит));
		Ключ = Лев(ПодстракаРевизит,Найти(ПодстракаРевизит,"=")-1);
		Значение = Сред(ПодстракаРевизит,СтрДлина(Ключ)+2,Стрдлина(ПодстракаРевизит)-СтрДлина(Ключ)-2); 
		Если Найти(Значение,"#!!#") > 0 Тогда 
			ТипЗначения = Сред(Значение,Найти(Значение,"#!!#")+4,СтрДлина(Значение)-Найти(Значение,"#!!#")-7);
			Значение = Лев(Значение,Найти(Значение,"#!!#")-1);

			Если ТипЗначения = "Дата" Тогда
				Значение = Дата(Значение);
			ИначеЕсли ТипЗначения = "Число" Тогда
                Значение = Число(Значение);
			//Иначе
			//	Сообщить(ТипЗначения);
			КонецЕсли;
			Ключ = СоответсвиеАнгРекРус[Ключ];
		КонецЕсли;
		Если Найти(Значение,"^")>0 Тогда 
			РезультатСтруктура.Вставить(Ключ, СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Лев(Значение,СтрДлина(Значение)-1), "^"));
			Ключ = СоответсвиеАнгРекРус[Ключ];
		ИначеЕсли Найти(ПодстракаРевизит,"[ТАБЛИЧНАЯЧАСТЬ=DetailedDailySchedules]") > 0 Тогда     	
			Ключ = "DetailedDailySchedules";
			СтрокаЗначения = Сред(Строка,2,Найти(Строка,"&}"));
			Строка = Прав(Строка,Стрдлина(Строка)-Стрдлина(СтрокаЗначения)-1);
			Массив = Новый Массив;
			ЭлМассива = Неопределено;
			Пока СтрДлина(СтрокаЗначения)> 1 Цикл
				Если Лев(СтрокаЗначения,22) ="[СтрокаТабличнойЧасти]" Тогда 	
					Если не ЭлМассива = Неопределено тогда
						Массив.Добавить(ЭлМассива);
					КонецЕсли;
					ЭлМассива = Новый РасписаниеРегламентногоЗадания;
					СтрокаЗначения = Прав(СтрокаЗначения,СтрДлина(СтрокаЗначения)-22);	
					Продолжить;
				КонецЕсли;					
				ПодстракаРевизитРасписание = Лев(СтрокаЗначения,Найти(СтрокаЗначения,"&")-1);
				СтрокаЗначения = Прав(СтрокаЗначения,Стрдлина(СтрокаЗначения)-Стрдлина(ПодстракаРевизитРасписание)-1);
	            КлючРасписание = Лев(ПодстракаРевизитРасписание,Найти(ПодстракаРевизитРасписание,"=")-1);
				ЗначениеРасписание  = Сред(ПодстракаРевизитРасписание,СтрДлина(КлючРасписание)+2,Стрдлина(ПодстракаРевизитРасписание)-СтрДлина(КлючРасписание)-2);
				ТипЗначения = Сред(ЗначениеРасписание,Найти(ЗначениеРасписание,"#!!#")+4,СтрДлина(ЗначениеРасписание)-Найти(ЗначениеРасписание,"#!!#")-6);
			    ЗначениеРасписание = Лев(ЗначениеРасписание,Найти(ЗначениеРасписание,"#!!#")-1);

				Если ТипЗначения = "Дата" Тогда
					Значение = Дата(ЗначениеРасписание);  
					ЭлМассива[СоответсвиеАнгРекРус[КлючРасписание]] = ЗначениеРасписание	

				ИначеЕсли ТипЗначения = "Число" Тогда
	                Значение = Число(ЗначениеРасписание);
					ЭлМассива[СоответсвиеАнгРекРус[КлючРасписание]] = ЗначениеРасписание	
				//Иначе
				//	Сообщить(ТипЗначения);
				КонецЕсли;

							//ЭлМассива.Вставить(СоответсвиеАнгРекРус[КлючРасписание],ЗначениеРасписание);
					
			КонецЦикла;
			Массив.Добавить(ЭлМассива);
			РезультатСтруктура.Вставить("DetailedDailySchedules",Массив);
			
			
			
			
		Иначе
			РезультатСтруктура.Вставить(Ключ,Значение);
		КонецЕсли;
		//Строка = "";	
	КонецЦикла;
	
	
	Возврат РезультатСтруктура; 
	
КонецФункции

Функция ПрочитатьФайл(Файл, Кодировка, guidПриемник)
	ФайлЗагр = Новый Файл(Файл);
		
	Если НЕ ФайлЗагр.Существует() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Файла %1 не существует!'"), Файл);
		Сообщение.Сообщить();
		
		Возврат Неопределено;
	КонецЕсли;
	
	ПотокЧтения = Новый ТекстовыйДокумент();
	Попытка
		ПотокЧтения.Прочитать(Файл);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Файл не прочитан.'");
		Сообщение.Сообщить();
		
		Возврат Неопределено;
	КонецПопытки;
	
	ПотокЧтения.Прочитать(Файл, Кодировка);
	Если ПотокЧтения.КоличествоСтрок() < 1 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='В файле нет данных!'");
		Сообщение.Сообщить();
		
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ СокрЛП(ПотокЧтения.ПолучитьСтроку(1)) = "ФайлНастроекВнешнейОбработкиОтчета" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Указанный файл не является файлом настроек внешней обработки/отчета, или неверно указана кодировка!'");
		Сообщение.Сообщить();
		
		Возврат Неопределено;
	КонецЕсли;
	
	guidПриемник = ИзвлечьGuidИзИмениФайла(ФайлЗагр.ИмяБезРасширения);
	Возврат ПотокЧтения.ПолучитьТекст();
КонецФункции

Функция ИзвлечьGuidИзИмениФайла(ИмяФайлаБезРасширения) Экспорт
	Возврат Прав(ИмяФайлаБезРасширения, 36);
КонецФункции	

Функция ПолучитьСтрокуИмпорта(Импорт_ТекущаяСтрока, Импорт_КоличествоСтрок, Импорт_ТекстДляРазбора)
	Буфер = "";
	Пока ПустаяСтрока(Буфер) ИЛИ Лев(Буфер, 2) = "//" Цикл
		Если Импорт_ТекущаяСтрока > Импорт_КоличествоСтрок Тогда
			Возврат "";
		КонецЕсли;
		
		Буфер = СокрЛП(СтрПолучитьСтроку(Импорт_ТекстДляРазбора, Импорт_ТекущаяСтрока));
		Импорт_ТекущаяСтрока = Импорт_ТекущаяСтрока + 1;
	КонецЦикла;
	
	Возврат Буфер;
КонецФункции

Функция ЗагрузитьСекциюРеквизитов(СтрокаРазбора, СтрокаРеквизитов)
	Значение = "";
	Тег = "";
	РазобратьТеговуюСтроку(СтрокаРазбора, Тег, Значение);
	
	МассивПодстрок = РазложитьСтрокуВМассивПодстрок(Значение, "#!#", Ложь);
	СтрокаРеквизитов["Имя"] = МассивПодстрок[0];
	СтрокаРеквизитов["Тип"] = МассивПодстрок[1];
	СтрокаРеквизитов["Значение"] = МассивПодстрок[2];
	Возврат Истина;
КонецФункции

Функция РазобратьТеговуюСтроку(СтрокаРазбора, Тег, Значение)
	ПозицияПрисваивания = Найти(СтрокаРазбора, "=");
	Если ПозицияПрисваивания = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Тег = ВРЕГ(СокрЛП(Лев(СтрокаРазбора, ПозицияПрисваивания - 1)));
	Значение = СокрЛП(Сред(СтрокаРазбора, ПозицияПрисваивания + 1));
	
	Возврат НЕ ПустаяСтрока(Тег);
КонецФункции

Процедура ЗагрузитьЗначениеРеквизита(РеквизитИсточник, РеквизитПриемник)
	Если ЭтоСсылочныйТип(РеквизитИсточник.Тип) Тогда
		РеквизитИсточник.Тип = УчестьСсылочныйТип(РеквизитИсточник.Тип); //СтрЗаменить(РеквизитИсточник.Тип, "Справочник", "Справочники");
		УниверсальнаяЧастьСтроки = "РеквизитПриемник = " + РеквизитИсточник.Тип;
		Если СтрНайти(РеквизитИсточник.Тип, "Перечислен") = 0 Тогда
			Выполнить(УниверсальнаяЧастьСтроки + ".ПолучитьСсылку(Новый УникальныйИдентификатор("""+ РеквизитИсточник.Значение +"""))");
		Иначе
			Выполнить(УниверсальнаяЧастьСтроки + "[""" + РеквизитИсточник.Значение + """]");
		КонецЕсли;	
	ИначеЕсли ЭтоПростойТип(РеквизитИсточник.Тип) Тогда
		Если РеквизитИсточник.Тип = "Строка" Тогда
			РеквизитИсточник.Значение = УчестьМногоcтрочныйТекст(РеквизитИсточник.Тип, РеквизитИсточник.Значение, "Многострочный");
		КонецЕсли;
		
		РеквизитПриемник = РеквизитИсточник.Значение;
	ИначеЕсли РеквизитИсточник.Тип =  "Расписание задания" Тогда
	
	Иначе // Выгрузка значений нестандартных типов в Base64
		МногострочныйТекст = УчестьМногоcтрочныйТекст(РеквизитИсточник.Тип, РеквизитИсточник.Значение, "Многострочный");
		ДвоичныеДанные = Base64Значение(МногострочныйТекст);
		СтрокаСериализации = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные);   
		XMLЗначение(Тип("ХранилищеЗначения"), СтрокаСериализации);
		ХранилищеЗначения = XMLЗначение(Тип("ХранилищеЗначения"), СтрокаСериализации);
		РеквизитПриемник = ХранилищеЗначения.Получить();
	КонецЕсли;	
КонецПроцедуры

Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено)
	Результат = Новый Массив;
 
    // для обеспечения обратной совместимости
    Если ПропускатьПустыеСтроки = Неопределено Тогда
        ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
        Если ПустаяСтрока(Строка) Тогда 
            Если Разделитель = " " Тогда
                Результат.Добавить("");
            КонецЕсли;
            Возврат Результат;
        КонецЕсли;
    КонецЕсли;
    //
 
    Позиция = Найти(Строка, Разделитель);
    Пока Позиция > 0 Цикл
        Подстрока = Лев(Строка, Позиция - 1);
        Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
            Результат.Добавить(Подстрока);
        КонецЕсли;
        Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
        Позиция = Найти(Строка, Разделитель);
    КонецЦикла;
 
    Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
        Результат.Добавить(Строка);
    КонецЕсли;
 
    Возврат Результат;
КонецФункции

Функция УчестьСсылочныйТип(ИмяТипа)
	КопияИмениТипа = ИмяТипа;
	КопияИмениТипа = СтрЗаменить(КопияИмениТипа, "Справочник.", "Справочники.");
	КопияИмениТипа = СтрЗаменить(КопияИмениТипа, "Документ.", "Документы.");
	КопияИмениТипа = СтрЗаменить(КопияИмениТипа, "БизнесПроцесс.", "БизнесПроцессы.");
	КопияИмениТипа = СтрЗаменить(КопияИмениТипа, "Задача.", "Задачи.");
	КопияИмениТипа = СтрЗаменить(КопияИмениТипа, "ПланВидовХарактеристик.", "ПланыВидовХарактеристик.");
	КопияИмениТипа = СтрЗаменить(КопияИмениТипа, "Перечисление.", "Перечисления.");
	Возврат КопияИмениТипа;
КонецФункции

Функция ПреобразоватьМассивВСтроку(Массив,Разделитель = "")Экспорт
	
	СтрокаРезультат = "";
	
	Для каждого Элемент Из Массив Цикл
		СтрокаРезультат = СтрокаРезультат + Строка(Элемент) + Разделитель;  
	КонецЦикла;
	
	Возврат СтрокаРезультат;
	
КонецФункции

