КонецПроцедуры

// Описание: Готовит данные для открытия ФормаНастроек внешней обработки/отчета.
//
// Параметры:
//  СсылкаОбработки - СправочникСсылка.ДополнительныеОтчетыИОбработки - элемент справочника
//
// Возвращаемое значение:
//  Структура - Успех, ТекстОшибки, ИмяФормы, Настройки, ПередаватьНастройкиАлгоритма
//
Функция ПодготовитьОткрытиеФормыНастроек(Знач СсылкаОбработки) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("Настройки", Неопределено);
	Результат.Вставить("ПередаватьНастройкиАлгоритма", Истина);
	
	Если Не ЗначениеЗаполнено(СсылкаОбработки) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не выбран элемент справочника.'");
		Возврат Результат;
	КонецЕсли;
	
	ДанныеПодключения = ПодключитьИПроверитьФормуНастроек(СсылкаОбработки);
	Если Не ДанныеПодключения.Успех Тогда
		Результат.ТекстОшибки = ДанныеПодключения.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Хранилище = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаОбработки, "ХранилищеНастроек");
	Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
		Результат.Настройки = Хранилище.Получить();
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.ИмяФормы = ДанныеПодключения.ИмяФормы;
	
	Если ТипЗнч(Результат.Настройки) = Тип("Структура") Тогда
		Результат.ПередаватьНастройкиАлгоритма = МожноПередатьНастройкиАлгоритма(
			ДанныеПодключения.ОбъектВнешний,
			Результат.Настройки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Описание: Сохраняет структуру настроек в реквизит ХранилищеНастроек элемента справочника.
//
// Параметры:
//  СсылкаОбработки - СправочникСсылка.ДополнительныеОтчетыИОбработки - элемент справочника
//  Настройки - Структура - результат закрытия ФормаНастроек
//  ТекстОшибки - Строка - текст ошибки при неуспехе
//
// Возвращаемое значение:
//  Булево - Истина, если запись выполнена успешно
//
Функция СохранитьНастройкиФормыНастроек(Знач СсылкаОбработки, Знач Настройки, ТекстОшибки) Экспорт
	
	ТекстОшибки = "";
	
	Если Не ЗначениеЗаполнено(СсылкаОбработки) Тогда
		ТекстОшибки = НСтр("ru = 'Не выбран элемент справочника.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ТекстОшибки = НСтр("ru = 'Форма настроек не вернула структуру настроек.'");
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ОбъектСправочника = СсылкаОбработки.ПолучитьОбъект();
		ОбъектСправочника.ХранилищеНастроек = Новый ХранилищеЗначения(Настройки);
		ОбъектСправочника.Записать();
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось записать настройки:'")
			+ " "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Открытие настроек дополнительных обработок'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
			СсылкаОбработки,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Функция ПодключитьИПроверитьФормуНастроек(Знач СсылкаОбработки)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("ОбъектВнешний", Неопределено);
	
	ВидОбработки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаОбработки, "Вид");
	ЭтоОтчет = (ВидОбработки = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет
		Или ВидОбработки = Перечисления.ВидыДополнительныхОтчетовИОбработок.Отчет);
	
	ИмяПодключенногоОбъекта = ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(СсылкаОбработки);
	Если Не ЗначениеЗаполнено(ИмяПодключенногоОбъекта) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось подключить внешнюю обработку/отчет из справочника.'");
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоОтчет Тогда
		МенеджерОбъектов = ВнешниеОтчеты;
		ПрефиксИмениФормы = "ВнешнийОтчет.";
	Иначе
		МенеджерОбъектов = ВнешниеОбработки;
		ПрефиксИмениФормы = "ВнешняяОбработка.";
	КонецЕсли;
	
	ОбъектВнешний = МенеджерОбъектов.Создать(ИмяПодключенногоОбъекта);
	Если ОбъектВнешний.Метаданные().Формы.Найти("ФормаНастроек") = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У выбранной обработки/отчета нет формы с именем «ФормаНастроек».'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.ИмяФормы = ПрефиксИмениФормы + ИмяПодключенногоОбъекта + ".Форма.ФормаНастроек";
	Результат.ОбъектВнешний = ОбъектВнешний;
	Возврат Результат;
	
КонецФункции

Функция МожноПередатьНастройкиАлгоритма(Знач ОбъектВнешний, Знач Настройки)
	
	Если ОбъектВнешний = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		ОбъектВнешний.УстановитьПользовательскиеНастройки(Настройки);
		Возврат Истина;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ЭтоОшибкаНесовместимостиНастроек(ТекстОшибки) Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

Функция ЭтоОшибкаНесовместимостиНастроек(Знач ТекстОшибки)
	
	Текст = НРег(Строка(ТекстОшибки));
	Возврат СтрНайти(Текст, "слишком много фактических параметров") > 0
		Или СтрНайти(Текст, "недостаточно фактических параметров") > 0
		Или СтрНайти(Текст, "метод объекта не обнаружен") > 0
		Или СтрНайти(Текст, "procedure or function is not defined") > 0
		Или СтрНайти(Текст, "too many actual parameters") > 0;
	
КонецФункции

 Функция ПолучитьПараметрыРегистрации(Данные)
	
		ИмяФайла = Данные.ИмяФайла;
		
		ПараметрыРегистрации = Новый Структура;
		ПараметрыРегистрации.Вставить("ИмяФайла", "");
		ПараметрыРегистрации.Вставить("ПолноеИмя", ИмяФайла);
		ПараметрыРегистрации.Вставить("ЭтоОтчет", Неопределено);
		ПараметрыРегистрации.Вставить("ОтключатьКонфликтующие", Ложь);
		ПараметрыРегистрации.Вставить("ОтключатьПубликацию", Ложь);
		ПараметрыРегистрации.Вставить("Конфликтующие",  Новый СписокЗначений);
		ПараметрыРегистрации.Вставить("АдресДанныхОбработки", ""); 
		ПараметрыРегистрации.Вставить("АдресДанныхОбработки", ""); 

		
								
		//ФайлОбработки = Новый Файл(ИмяФайла);
		ПараметрыРегистрации.ИмяФайла = Данные.ИмяФайла;
		//СтруктураОписания = ОписаниеОбработкиИзФайла(ПутьКОписаниюОбработки + ФайлОбработки.ИмяБезРасширения + ".json");
		//ПутьКОписаниюОбработки 
		Если ВРег(Данные.Назначние) = "ERF" Тогда
			ПараметрыРегистрации.ЭтоОтчет = Истина;
		ИначеЕсли ВРег(Данные.Назначние) = "EPF" Тогда
			ПараметрыРегистрации.ЭтоОтчет = Ложь;  
		ИначеЕсли ВРег(Данные.Назначние) = "EXR" ИЛИ СтрНайти(Данные.НазначениеМетеданные,"ПланОбмена") > 0 Тогда	
			ПараметрыРегистрации.ЭтоОтчет = Ложь; 
			ИмяПланаОбмена = Прав(Данные.НазначениеМетеданные, СтрДлина(Данные.НазначениеМетеданные)- СтрНайти(Данные.НазначениеМетеданные,".") - 1);
			ПараметрыРегистрации.Вставить("ПланОбмена",ПланыОбмена[ИмяПланаОбмена].ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.ГУИД)));
		КонецЕсли;                                             
		ПараметрыРегистрации.Вставить("гуид",Данные.ГУИД);  
		ПараметрыРегистрации.АдресДанныхОбработки = Данные.ФайлЗагрузки; 
		Возврат ПараметрыРегистрации;
		
КонецФункции


Функция ЗарегистрироватьОбработку(ПараметрыРегистрации)
	
	Если ПараметрыРегистрации.ЭтоОтчет Тогда
		внОбработкаИмя = ВнешниеОтчеты.Подключить(ПараметрыРегистрации.АдресДанныхОбработки);
		внОбработкаОбъект = ВнешниеОтчеты.Создать(внОбработкаИмя);
	Иначе
		внОбработкаИмя = ВнешниеОбработки.Подключить(ПараметрыРегистрации.АдресДанныхОбработки);
		внОбработкаОбъект = ВнешниеОбработки.Создать(внОбработкаИмя);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КраткоеПредставлениеОшибки", "");
	Попытка
			ПараметрыРегистрацииВМодулеОбработки = внОбработкаОбъект.СведенияОВнешнейОбработке();
		СписокКопируемыхСвойств = Новый СписокЗначений();
		СписокКопируемыхСвойств.Добавить("ПереименоватьПриЗагрузке");
		СписокКопируемыхСвойств.Добавить("ПереформатироватьСтруктуруНастроекФин");
		СписокКопируемыхСвойств.Добавить("СтароеИмяФайла");
		СписокКопируемыхСвойств.Добавить("НовоеИмяФайла");
		Для Каждого КопируемоеСвойство Из СписокКопируемыхСвойств Цикл
			Если ПараметрыРегистрацииВМодулеОбработки.Свойство(КопируемоеСвойство.Значение) Тогда
				ПараметрыРегистрации.Вставить(КопируемоеСвойство.Значение, ПараметрыРегистрацииВМодулеОбработки[КопируемоеСвойство.Значение]);
			КонецЕсли;	
		КонецЦикла;	
	Исключение
		Результат.Вставить("КраткоеПредставлениеОшибки", "При попытке вызова методов переименования и загрузки настроек произошла ошибка: " + ОписаниеОшибки());
		Результат.Вставить("ИмяОбъектаЗанято", Ложь);
	КонецПопытки;	
	Если ПустаяСтрока(Результат.КраткоеПредставлениеОшибки) Тогда
		ИмяДляПоиска = ?(ПараметрыРегистрации.Свойство("ПереименоватьПриЗагрузке"), ПараметрыРегистрации.СтароеИмяФайла + РасширениеФайла(ПараметрыРегистрации.ЭтоОтчет), ПараметрыРегистрации.ИмяФайла);
		Сообщить(ИмяДляПоиска);
		пСиноним = внОбработкаОбъект.Метаданные().Синоним;
		СсылкаСправочника = Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрыРегистрации.гуид));
		
		
		Если СсылкаСправочника = Неопределено Тогда
			ВызватьИсключение "По синониму <" + пСиноним + "> внешней обработки в справочнике найдено более одной обработки! Загрузка отменена!";
		ИначеЕсли НЕ ОбщегоНазначения.СсылкаСуществует(СсылкаСправочника) Тогда
			ОбъектСправочника = Справочники.ДополнительныеОтчетыИОбработки.СоздатьЭлемент();  
			ОбъектСправочника.УстановитьСсылкуНового(СсылкаСправочника);
			ОбъектСправочника.Заполнить(Неопределено);
			ОбъектСправочника.ИспользоватьДляФормыОбъекта = Истина;
			ОбъектСправочника.ИспользоватьДляФормыСписка  = Истина;
			Сообщить("Обработка не найдена! Создан новый элемент справочника!");
		Иначе
			ОбъектСправочника = СсылкаСправочника.ПолучитьОбъект();
			Сообщить("Обработка найдена!");
		КонецЕсли;
		
		КомандыСохраненные = ОбъектСправочника.Команды.Выгрузить();
		
		Результат = ДополнительныеОтчетыИОбработки.ЗарегистрироватьОбработку(ОбъектСправочника, ПараметрыРегистрации);	
		
		Если Результат.ИмяОбъектаЗанято Тогда 
			Сообщить("Имя объекта"+Результат.ИмяОбъекта+ "занята другой обработкой" );  
			Результат.ТекстОшибки = "Имя объекта"+Результат.ИмяОбъекта+ "занята другой обработкой";
		КонецЕсли;
		
		Если ОбъектСправочника.Метаданные().ТабличныеЧасти.Найти("Разрешения") <> Неопределено Тогда
			АдресРазрешений = ПоместитьВоВременноеХранилище(ОбъектСправочника.Разрешения.Выгрузить());
		КонецЕсли;	
		
		ПереименоватьПриЗагрузке = Ложь;
		Если ПараметрыРегистрации.Свойство("ПереименоватьПриЗагрузке", ПереименоватьПриЗагрузке) И ПереименоватьПриЗагрузке Тогда
			ОбъектСправочника.ИмяФайла = ПараметрыРегистрации.НовоеИмяФайла + РасширениеФайла(ПараметрыРегистрации.ЭтоОтчет);
		КонецЕсли;
		
		ОбъектСправочника.Информация = пСиноним;
		Результат.Вставить("ОбъектСправочника", ОбъектСправочника);
		Результат.Вставить("КомандыСохраненные", КомандыСохраненные);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция РасширениеФайла(Знач ЭтоОтчет)
	Возврат ?(ЭтоОтчет, ".erf", ".epf");
КонецФункции



Процедура ЗаполнитьКомандыРегламентныеЗадания(РезультатРегистрации, КомандыСохраненные = Неопределено)
	
	РезультатРегистрации.ОбъектСправочника.Команды.Сортировать("Представление");
	
	ВидДополнительнаяОбработка = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ВидДополнительныйОтчет = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительныйОтчет();
		
	Для Каждого ЭлементКоманда Из РезультатРегистрации.ОбъектСправочника.Команды Цикл
		
		Если РезультатРегистрации.ОбъектСправочника.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка
			И ЭлементКоманда.ВариантЗапуска = Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода Тогда
			
			РегламентноеЗаданиеGUID = ЭлементКоманда.РегламентноеЗаданиеGUID;
			Если КомандыСохраненные <> Неопределено Тогда
				НайденнаяСтрока = КомандыСохраненные.Найти(ЭлементКоманда.Идентификатор, "Идентификатор");
				Если НайденнаяСтрока <> Неопределено Тогда
					РегламентноеЗаданиеGUID = НайденнаяСтрока.РегламентноеЗаданиеGUID;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(РегламентноеЗаданиеGUID) Тогда
				ЭлементКоманда.РегламентноеЗаданиеGUID = РегламентноеЗаданиеGUID;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры



 Функция ЗарегистрироватьОбработкуНаСервере(ПараметрыРегистрации)
	Перем Результат;
	Результат = "Успешно";  //По умолчанию успех.
	 
	//ПараметрыРегистрации.Вставить("КомандыСохраненные", Неопределено);
	// Вызов сервера                                                                   
	
	РезультатРегистрации = ЗарегистрироватьОбработку(ПараметрыРегистрации);
	Если РезультатРегистрации.Успех Тогда
		ПараметрыРегистрации.Вставить("GUID", РезультатРегистрации.ОбъектСправочника.Ссылка.УникальныйИдентификатор());
		ПараметрыРегистрации.Вставить("Информация", РезультатРегистрации.ОбъектСправочника.Информация);
	КонецЕсли;
	Если ПустаяСтрока(РезультатРегистрации.КраткоеПредставлениеОшибки) И РезультатРегистрации.Успех Тогда 

		// Обработка результата работы сервера
		Если РезультатРегистрации.Успех = Истина Тогда
			
			ЗаполнитьКомандыРегламентныеЗадания(РезультатРегистрации, РезультатРегистрации.КомандыСохраненные);

			РезультатРегистрации.ОбъектСправочника.ХранилищеОбработки = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(ПараметрыРегистрации.АдресДанныхОбработки), Новый СжатиеДанных(9));
			РезультатРегистрации.ОбъектСправочника.Записать();
			Возврат Результат;

		КонецЕсли;
	Иначе 
		Результат = РезультатРегистрации.КраткоеПредставлениеОшибки;

		// Разбор причины отказа загрузки обработки и отображение информации пользователю
		Если РезультатРегистрации.ИмяОбъектаЗанято = Ложь Тогда

			// Причина отказа в КраткоеПредставлениеОшибки
			Результат = РезультатРегистрации.КраткоеПредставлениеОшибки;

		ИначеЕсли РезультатРегистрации.Конфликтующие.Количество() > 0 Тогда 

			// Представление занявших объектов
			КоличествоКонфликтующих = РезультатРегистрации.Конфликтующие.Количество();
			ПредставлениеЗанявших = "";
			Для Каждого ЭлементСписка Из РезультатРегистрации.Конфликтующие Цикл
				ПредставлениеЗанявших = ПредставлениеЗанявших
				+ ?(ПредставлениеЗанявших = "", "", ", ")
				+ СокрЛП(ЭлементСписка.Представление);
				Если СтрДлина(ПредставлениеЗанявших) > 80 Тогда
					ПредставлениеЗанявших = Лев(ПредставлениеЗанявших, 70)
					+ "... ("
					+ Формат(КоличествоКонфликтующих, "ЧН=0; ЧГ=")
					+ " "
					+ НСтр("ru = 'шт'")
					+ ")";
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Имя ""%1"" уже занято другими дополнительными отчетами (обработками):
					|%2.'"),
				РезультатРегистрации.ИмяОбъекта,
				ПредставлениеЗанявших
			);

		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
 КонецФункции
 
 
Процедура ЗаписатьРезультатПодключения(ИмяФайла, Результат)
	
	Сообщить(Результат);
	
	Попытка
		ТекстовыйДокумент = Новый ЗаписьТекста(ИмяФайла, ,,Истина);
		ТекстовыйДокумент.ЗаписатьСтроку(Результат);
		ТекстовыйДокумент.Закрыть();
	Исключение
	    Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
КонецПроцедуры


 

Функция ЗагрузитьОбработки(ДанныеПоОбработка)Экспорт
	
	Ключи = Новый Соответствие;
	ТаблицаЗагрузки = Новый ТаблицаЗначений;
	ТаблицаЗагрузки.Колонки.Добавить("Ключ");
	ТаблицаЗагрузки.Колонки.Добавить("ФайлЗагрузки");
	ТаблицаЗагрузки.Колонки.Добавить("ФайлНастроек"); 
	ТаблицаЗагрузки.Колонки.Добавить("ПутьФайлНастроек");
	ТаблицаЗагрузки.Колонки.Добавить("ГУИД");   
	ТаблицаЗагрузки.Колонки.Добавить("НазначениеМетеданные"); 
	ТаблицаЗагрузки.Колонки.Добавить("Назначние"); 
	ТаблицаЗагрузки.Колонки.Добавить("ИмяФайла"); 
	ПутьКЛогу =  ПолучитьИмяВременногоФайла("txt");
	ПутьКЛогуДД = ПолучитьИзВременногоХранилища(ДанныеПоОбработка.ЛогФайл);
	ПутьКЛогуДД.Записать(ПутьКЛогу);
	
	
	
	Для каждого файл из ДанныеПоОбработка.Файлы Цикл
		
		СтрТЗ =  ТаблицаЗагрузки.Добавить();
		СтрТЗ.Ключ = ДанныеПоОбработка.КлючиПоиска.Получить(файл.Описание.JsonPath);  
		СтрТЗ.Гуид = файл.Описание.guid;
		СтрТЗ.ФайлЗагрузки = файл.Описание.ВременноеХранилищеФайл;
		Если файл.Описание.Свойство("Settings_Path") Тогда 
        	СтрТЗ.ПутьФайлНастроек = файл.Описание.Settings_Path; 
		Иначе
		     СтрТЗ.ПутьФайлНастроек = ""
		КонецЕсли;                      
		 
		Файл.Описание.Свойство("ВременноеХранилищеФайлНастроек",СтрТЗ.ФайлНастроек);
		
		СтрТЗ.НазначениеМетеданные = файл.Описание.Destination_Meta;
		СтрТЗ.Назначние = файл.Описание.Destination; 
		СтрТЗ.ИмяФайла = файл.Описание.file;
		
	КонецЦикла;
	ТаблицаКлючей = ТаблицаЗагрузки.Скопировать();
	ТаблицаКлючей.Свернуть("Ключ");
	Для каждого СтрКлюч из ТаблицаКлючей Цикл
		Результат = "Отказ" ;
    
		Отбор = Новый Структура;
		Отбор.Вставить("Ключ",СтрКлюч.Ключ);
		Строки = ТаблицаЗагрузки.НайтиСтроки(Отбор);
		
		//НачатьТранзакцию(); 
		ТекстОшибки = "";
		Для Каждого СтрОбработка из Строки Цикл 
			Если СтрНайти(ВРЕГ(СтрОбработка.НазначениеМетеданные),"ПЛАНОБМЕНА") > 0 Тогда 
				ЗагрузитьПравилаОбменаИзМакета(СтрОбработка.ФайлЗагрузки,,СтрОбработка.ГУИД,Результат);	
				Отказ = Не Результат;	
			Иначе
				ПараметрыРегистрации = ПолучитьПараметрыРегистрации(СтрОбработка); 
				
				Попытка
					Результат = ЗарегистрироватьОбработкуНаСервере(ПараметрыРегистрации);  
				Исключение 
					ТекстОшибки  = ТекстОшибки + Символы.ПС + "Не удалось зарегисрировать обработку" + СтрОбработка.ИмяФайла;
					Результат = "Отказ"
				КонецПопытки;
				Если НЕ Результат = "Успешно" Тогда
					ТекстОшибки  = ТекстОшибки + Символы.ПС + "Не удалось зарегисрировать обработку" + СтрОбработка.ИмяФайла;
				КонецЕсли;
				Если Результат = "Успешно" Тогда
					Отказ = Ложь; 
				Иначе
					Отказ = Истина;
				КонецЕсли;
				Если Не Отказ и Не СтрОбработка.ФайлНастроек = Неопределено и (НЕ ПустаяСтрока(СтрОбработка.ПутьФайлНастроек) И  НЕ СтрОбработка.ФайлНастроек = Неопределено) Тогда
					Результат = ИмпортироватьНастройки(СтрОбработка.ФайлНастроек, ПараметрыРегистрации.GUID);  
					Если Результат.Отказ Тогда
						ТекстОшибки	= ТекстОшибки + Символы.ПС + "Не удалось загрузить настройки:" + СтрОбработка.ПутьФайлНастроек; 
					КонецЕсли;	
					Отказ = Результат.Отказ;
				КонецЕсли;
				Если Отказ Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Отказ Тогда  
			//ЗафиксироватьТранзакцию();
			Для Каждого СтрОбработка из Строки Цикл  
				Если ВРЕГ(СтрОбработка.Назначние) = "EXR" Тогда                                                   
					ЗаписатьРезультатПодключения(ПутьКЛогу,"Успешно: загружены правила обмена "+СтрОбработка.ИмяФайла);
				Иначе
					ЗаписатьРезультатПодключения(ПутьКЛогу,"Успешно: загружена обработка "+СтрОбработка.ИмяФайла);
				КонецЕСли;
				Если НЕ СтрОбработка.ФайлНастроек = Неопределено  Тогда
					ЗаписатьРезультатПодключения(ПутьКЛогу,"Загружены настройки из файла "+СтрОбработка.ПутьФайлНастроек)    
				КонецЕсли;
			КонецЦикла
		Иначе         
			Для Каждого СтрОбработка из Строки Цикл 	
				ЗаписатьРезультатПодключения(ПутьКЛогу, "Ошибка: при загрузке файла "+СтрОбработка.ИмяФайла + ": "+ТекстОшибки);
			КонецЦикла;
			//ОтменитьТранзакцию();
		КонецЕсли;
		
	КонецЦикла;
	
	ПутьКЛогуДД = Новый ДвоичныеДанные(ПутьКЛогу);
	Возврат ПоместитьВоВременноеХранилище(ПутьКЛогуДД);
	
КонецФункции



// Преобразует объект XDTO в структуру
//
// Параметры:
// ОбъектXDTO - ОбъектXDTO - Объект XDTO.
//
// Возвращаемое значение:
// Структура - Структура объекта.
//
Функция ОбъектXDTOВСтруктуру(ОбъектXDTO, ПараметрыПреобразования = Неопределено) Экспорт
	
	Структура = Новый Структура;
	ТипОбъектаXDTO = ОбъектXDTO.Тип();
	
	Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл
		
		ИмяСвойства = Свойство.Имя; 
		
		ЗначениеСвойства = ОбъектXDTO[ИмяСвойства];
		// в сериализаторе глобальной фабрики перепутаны 2 свойства
		Если ИмяСвойства = "DaysRepeatPeriod" Тогда
			ИмяСвойства = "RepeatPeriodInDay"	
		ИначеЕсли ИмяСвойства = "RepeatPeriodInDay" Тогда
			ИмяСвойства = "DaysRepeatPeriod"	
		КонецЕсли;
		
		Если ТипЗнч(ЗначениеСвойства) = Тип("ОбъектXDTO") Тогда
			
			Структура.Вставить(ИмяСвойства, ОбъектXDTOВСтруктуру(ЗначениеСвойства, ПараметрыПреобразования));
			
		ИначеЕсли ТипЗнч(ЗначениеСвойства) = Тип("СписокXDTO") Тогда
			
			Структура.Вставить(ИмяСвойства, Новый Массив);
			Для Индекс = 0 По ЗначениеСвойства.Количество() - 1 Цикл
				
				ЭлементСписка = ЗначениеСвойства.Получить(Индекс);
				Если ТипЗнч(ЭлементСписка) = Тип("ОбъектXDTO") Тогда
					Структура[ИмяСвойства].Добавить(ОбъектXDTOВСтруктуру(ЭлементСписка, ПараметрыПреобразования));
				Иначе
					Структура[ИмяСвойства].Добавить(ЭлементСписка);
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Структура.Вставить(ИмяСвойства, ЗначениеСвойства);
			
			Если ПараметрыПреобразования <> Неопределено
				И ПараметрыПреобразования.НайтиИдентификаторы
				И Свойство.Тип = ПараметрыПреобразования.ТипUUID Тогда
				
				РезультатПоиска = ПараметрыПреобразования.ТипыИдентификаторов[ТипОбъектаXDTO];
				Если РезультатПоиска <> Неопределено
					И РезультатПоиска.ИмяПоля = ИмяСвойства Тогда
					ПараметрыПреобразования.Идентификаторы[РезультатПоиска.ИмяТаблицы].Вставить(ЗначениеСвойства, РезультатПоиска.ПустоеЗначение);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции


//	Процедура задает расписание регламентного задания для команды новой обработки/отчета
//	Параметры 
//		ИмяФайла - имя файла (с расширением !!! .epf / .erf) обработки как оно сохранено в БД в справочнике ДополнительныеОтчетыИОбработки
//		ИдентификаторКоманды - идентификатор команды, который задается в модуле обработки/отчета в блоке регистрации обработки
//  	ИмяПользователя - имя пользователя регламетного задания
//		СоздатьЗадание - по умолчанию - Ложь. Если задать - Истина, например если  требуется задать расписание для новой обработки отчета
//		- будет создано новое регламентное задание.
//  	Использование - по умолчанию - Истина. Если передать Ложь - расписание будет назначено, но задание не будет выполняться (будет выключено).
Процедура УстановитьРасписаниеКомандыОбработкиОтчета(ИмяФайла, ИдентификаторКоманды, ИмяПользователя, РасписаниеЗадания, СоздатьЗадание = Ложь, Использование = Истина) Экспорт
	НаименованиеПроцедуры = "ВТБ_DevOps.УстановитьРасписаниеКомандыОбработкиОтчета";
	СсылкаСправочника = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяФайла", ИмяФайла);	
	Если СсылкаСправочника <> Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда  // Обработка найдена
		СправочникОбъект = СсылкаСправочника.ПолучитьОбъект();
		ТаблицаКоманд = СправочникОбъект.Команды;
		СтрокаКоманды = ТаблицаКоманд.Найти(ИдентификаторКоманды, "Идентификатор");
		Если СтрокаКоманды <> Неопределено Тогда // Команда найдена
			Если ТипЗнч(РасписаниеЗадания) = Тип("РасписаниеРегламентногоЗадания") Тогда // Расписание задано корректно
				Задание = НайтиЗадание(СтрокаКоманды.РегламентноеЗаданиеGUID);
				
				Ошибка = Ложь;
				НачатьТранзакцию(); 
				Попытка
					Если СоздатьЗадание И Задание = Неопределено Тогда // Требуется создать задание и у команды нет заданий в БД
						// Создать и зарегистрировать
						Задание = СоздатьНовоеЗадание(ПредставлениеЗадания(СправочникОбъект, СтрокаКоманды));
						СтрокаКоманды.РегламентноеЗаданиеGUID = ПолучитьИдентификаторЗадания(Задание);
						СправочникОбъект.Записать();
					ИначеЕсли СоздатьЗадание И Задание <> Неопределено Тогда
						Ошибка = Истина;
						ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"У команды обработки/отчета с именем файла: <" + ИмяФайла + "> с идентификатором: <" + ИдентификаторКоманды + "> уже имеется регламентное задание с GUID: " + СтрокаКоманды.РегламентноеЗаданиеGUID);
					ИначеЕсли НЕ СоздатьЗадание И Задание = Неопределено Тогда
						Ошибка = Истина;
						ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"У команды обработки/отчета с именем файла: <" + ИмяФайла + "> с идентификатором: <" + ИдентификаторКоманды + "> не найдено регламентное задание.");
					КонецЕсли;	
					
					Если НЕ Ошибка Тогда // Запись расписания
						Задание.ИмяПользователя = ИмяПользователя;
						Задание.Расписание = РасписаниеЗадания;
						Задание.Использование = Использование;
						Задание.Записать();
					КонецЕсли;	
					
					ЗафиксироватьТранзакцию(); 
				Исключение 
					ОтменитьТранзакцию(); 
					ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Ошибка,,,"Для команды обработки/отчета с именем файла: <" + ИмяФайла + "> с идентификатором: <" + ИдентификаторКоманды + "> не удалось модицифировать расписание регламентного задание. Причина: " + ОписаниеОшибки());
				КонецПопытки;
			Иначе
				ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Для команды обработки/отчета с именем файла: <" + ИмяФайла + "> с идентификатором: <" + ИдентификаторКоманды + "> неправильно задано расписание.");
			КонецЕсли;		
		Иначе
			ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Не удалось найти команду обработки/отчета с именем файла: <" + ИмяФайла + "> с идентификатором: <" + ИдентификаторКоманды + ">");
		КонецЕсли;	
	Иначе
		ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Не удалось найти обработку/отчет с именем файла: <" + ИмяФайла + ">"); 
	КонецЕсли;	
КонецПроцедуры

// Процедура устанавливает таблицу разделов командного интерфейса для обработки / отчета
// Параметры
//		ИмяФайла - имя файла (с расширением !!! .epf / .erf) обработки как оно сохранено в БД в справочнике ДополнительныеОтчетыИОбработки
//		пТаблицаРазделов - ТаблицаЗначений Пример кода создания и заполнения таблицы ниже
//			ТаблицаРазделов = Новый ТаблицаЗначений();
//			ТаблицаРазделов.Колонки.Добавить("Раздел");
//			НовыйРаздел = ТаблицаРазделов.Добавить();
//			НовыйРаздел.Раздел = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Подсистемы.ОбменДанными);
Процедура УстановитьРазделыКомандногоИнтерфейсаОбработкиОтчета(ИмяФайла, пТаблицаРазделов) Экспорт
	НаименованиеПроцедуры = "ВТБ_DevOps.УстановитьРазделыКомандногоИнтерфейсаОбработкиОтчета";
	СсылкаСправочника = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяФайла", ИмяФайла);
	Если СсылкаСправочника <> Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда  // Обработка найдена
		СправочникОбъект = СсылкаСправочника.ПолучитьОбъект();
		ТаблицаРазделов = СправочникОбъект.Разделы;
		
		НачатьТранзакцию();
		Попытка
			Для Каждого СтрокаТаблицыРазделов Из пТаблицаРазделов Цикл // Проверка переданной таблицы разделов
				Если ТипЗнч(СтрокаТаблицыРазделов.Раздел) <> Тип("СправочникСсылка.ИдентификаторыОбъектовМетаданных") ИЛИ СтрокаТаблицыРазделов = Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка() Тогда
					ВызватьИсключение "Неправильно задан тип раздела таблицы разделов или передана пустая ссылка";
				ИначеЕсли ТаблицаРазделов.Найти(СтрокаТаблицыРазделов.Раздел, "Раздел") = Неопределено Тогда // В таблице нет такого раздела, добавляем
					НовыйРаздел = ТаблицаРазделов.Добавить();
					ЗаполнитьЗначенияСвойств(НовыйРаздел, СтрокаТаблицыРазделов);
				КонецЕсли;	
			КонецЦикла;
			СправочникОбъект.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Ошибка,,,"Для обработки/отчета с именем файла: <" + ИмяФайла + "> неправильно задана таблица разделов командного интерфейса. " + ОписаниеОшибки());
		КонецПопытки;	
	Иначе
		ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Не удалось найти обработку/отчет с именем файла: <" + ИмяФайла + ">"); 
	КонецЕсли;	
КонецПроцедуры

// Процедура загружает правила обмена в узел плана обмена "Источники обмена" из общего макета.
// Поиск узла плана обмена:
// 		Сначала анализируется передан ли guid. Если передан - получаем ссылку по guid.
//		Если guid не передан - поиск ведется по коду
// Параметры
//		ОбъектМетаданныхМакет - предопределенное значение объекта метаданных общий макет на встроенном языке
//			Пример: Метаданные.ОбщиеМакеты.ВТБ_поЗагрузкаТранзакцийДУ
//      КодУзлаПланаОбмена - Код узла плана обмена в виде строки
//      GUID_УзлаОбмена - GUID узла плана обмена в виде строки
Процедура ЗагрузитьПравилаОбменаИзМакета(ОбъектМетаданныхМакет, КодУзлаОбмена, GUID_УзлаОбмена = "",Результат = Ложь) Экспорт
	НаименованиеПроцедуры = "ЗагрузитьПравилаОбменаИзМакета";
	Если ТипЗнч(ОбъектМетаданныхМакет) = Тип("ОбъектМетаданных") Тогда // Передали параметр верного типа
		Если ТипЗнч(GUID_УзлаОбмена) = Тип("Строка") И НЕ ПустаяСтрока(GUID_УзлаОбмена) Тогда // получаем узел через GUID
			Попытка
				УзелОбменаСсылка = ПланыОбмена.ИсточникиОбмена.ПолучитьСсылку(Новый УникальныйИдентификатор(GUID_УзлаОбмена));						
			Исключение // могли передать какую то фигню в guid и это может вызвать исключение
				УзелОбменаСсылка = ПланыОбмена.ИсточникиОбмена.ПустаяСсылка();
				ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Ошибка в паре параметров код/guid узла обмена. Ожидается 1 обязательный параметр код либо guid. Тип - строка. Код: <" + Строка(КодУзлаОбмена) + ">, guid: <" + Строка(GUID_УзлаОбмена) + ">.");	
			КонецПопытки;	
		ИначеЕсли ТипЗнч(КодУзлаОбмена) = Тип("Строка") И НЕ ПустаяСтрока(КодУзлаОбмена) Тогда // получаем узел через поиск по коду
			УзелОбменаСсылка = ПланыОбмена.ИсточникиОбмена.НайтиПоКоду(КодУзлаОбмена);
		Иначе // ни код ни guid либо не переданы либо неверных типов
			ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Ошибка в паре параметров код/guid узла обмена. Ожидается 1 обязательный параметр код либо guid. Тип - строка. Код: <" + Строка(КодУзлаОбмена) + ">, guid: " + Строка(GUID_УзлаОбмена));
		КонецЕсли;
		
		Если УзелОбменаСсылка <> ПланыОбмена.ИсточникиОбмена.ПустаяСсылка() Тогда // узел обмена найден
			НачатьТранзакцию();
			Попытка
				ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
				МакетПравилОбмена = ПолучитьОбщийМакет(ОбъектМетаданныхМакет);
				МакетПравилОбмена.Записать(ИмяВременногоФайла, КодировкаТекста.UTF8);
				ПравилаКонвертации = Новый ДвоичныеДанные(ИмяВременногоФайла);
				
				УзелОбменаОбъект = УзелОбменаСсылка.ПолучитьОбъект();
				УзелОбменаОбъект.ПравилоКонвертации = Новый ХранилищеЗначения(ПравилаКонвертации);
				УзелОбменаОбъект.Записать();
				УдалитьФайлы(ИмяВременногоФайла);
				ЗафиксироватьТранзакцию();
				Результат = Истина;
			Исключение   
				Результат = Ложь;
				ОтменитьТранзакцию();
				ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Ошибка,,,"При загрузке правил обмена из макета произошла ошибка! Код узла: <" + КодУзлаОбмена + ">. Guid: <" + GUID_УзлаОбмена + "> Причина: " + ОписаниеОшибки());
			КонецПопытки;
		Иначе
			ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Не удалось найти узел плана обмена по переданной паре код/guid. Код: <" + КодУзлаОбмена + ">. Guid: <" + GUID_УзлаОбмена + ">");
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ОбъектМетаданныхМакет) = Тип("Строка") Тогда  
		Если ТипЗнч(GUID_УзлаОбмена) = Тип("Строка") И НЕ ПустаяСтрока(GUID_УзлаОбмена) Тогда // получаем узел через GUID
			Попытка
				УзелОбменаСсылка = ПланыОбмена.ИсточникиОбмена.ПолучитьСсылку(Новый УникальныйИдентификатор(GUID_УзлаОбмена));						
			Исключение // могли передать какую то фигню в guid и это может вызвать исключение
				УзелОбменаСсылка = ПланыОбмена.ИсточникиОбмена.ПустаяСсылка();
				ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Ошибка в параметре guid узла обмена. Ожидается обязательный параметр guid. Тип - строка. Код: guid: <" + Строка(GUID_УзлаОбмена) + ">.");	
			КонецПопытки;	
		Иначе // ни код ни guid либо не переданы либо неверных типов
			ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Ошибка в паре параметров код/guid узла обмена. Ожидается 1 обязательный параметр код либо guid. Тип - строка. Код: <" + Строка(КодУзлаОбмена) + ">, guid: " + Строка(GUID_УзлаОбмена));
		КонецЕсли;
		
		Если УзелОбменаСсылка <> ПланыОбмена.ИсточникиОбмена.ПустаяСсылка() Тогда // узел обмена найден
			НачатьТранзакцию();
			Попытка
				ПравилаКонвертации = ПолучитьИзВременногоХранилища(ОбъектМетаданныхМакет);
				
				УзелОбменаОбъект = УзелОбменаСсылка.ПолучитьОбъект();
				УзелОбменаОбъект.ПравилоКонвертации = Новый ХранилищеЗначения(ПравилаКонвертации);
				УзелОбменаОбъект.Записать();
				ЗафиксироватьТранзакцию();
				Результат = Истина;
			Исключение   
				Результат = Ложь;
				ОтменитьТранзакцию();
				ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Ошибка,,,"При загрузке правил обмена из макета произошла ошибка! Guid: <" + GUID_УзлаОбмена + "> Причина: " + ОписаниеОшибки());
			КонецПопытки;
		Иначе
			ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Не удалось найти узел плана обмена по переданной паре код/guid.  Guid: <" + GUID_УзлаОбмена + ">");
		КонецЕсли;	

	Иначе
		ЗаписьЖурналаРегистрации(НаименованиеПроцедуры, УровеньЖурналаРегистрации.Предупреждение,,,"Ошибка при передаче параметра - макета правил обмена. Ожидается тип <Метаданные.ОбщиеМакеты.ИмяМакета>");
	КонецЕсли;	
КонецПроцедуры

#Область ПроцедурыИФункцииДляСохраненияНастроек

#Область ВыгрузкаНастроек                                                          
//Функция ВыгрузитьНастройкиНаСервере(АдресВременногоХранилища, Объект, МетаданныеОбъекта) Экспорт
Функция ВыгрузитьНастройкиНаСервере(АдресВременногоХранилища, GUIDОбъекта) Экспорт 
   
	ДвоичныеДанные_ = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);  // вытаскиваем на сервере из временного хранилища как двоичные данные
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt"); // получаем имя временного файла на сервере
    ДвоичныеДанные_.Записать(ИмяВременногоФайла);     
	
	Разделитель = "#!#";

	Текст = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста.UTF8, Символы.ПС);
	Текст.ЗаписатьСтроку("ФайлНастроекВнешнейОбработкиОтчета");
		
	//ОбработкаОбъект = РеквизитФормыВЗначение("РеквизитОбъект");
	
	// Считываем настройки из хранилища в объект
	СсылкаНаОбъект = Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор(GUIDОбъекта)); 
	Текст.ЗаписатьСтроку("Guid"+Разделитель+GUIDОбъекта);
	Текст.ЗаписатьСтроку("Синоним"+Разделитель+СсылкаНаОбъект.Наименование);
	
	Текст.ЗаписатьСтроку("[Реквизиты]");

	Объект = ДополнительныеОтчетыИОбработки.ПолучитьОбъектВнешнейОбработки(СсылкаНаОбъект);
	МетаданныеОбъекта = Объект.Метаданные();
	//МетаданныеОбъектаСсылка = СсылкаНаОбъект.Метаданные();
	
	НастройкиИзБазы = СсылкаНаОбъект.ХранилищеНастроек.Получить(); 
	НастройкиПолучены = Ложь;
	Попытка 
		Заголовок = "";
		Объект.УстановитьПользовательскиеНастройки(НастройкиИзБазы,Заголовок); 
		НастройкиПолучены = Истина;//- проверить
	Исключение
	КонецПопытки;
	Если НЕ НастройкиПолучены Тогда
		Попытка
			УстановитьПользовательскиеНастройки(НастройкиИзБазы,Объект); //- проверить
		Исключение
		КонецПопытки;	
	КонецЕсли;	
	//Реквизиты 
	
	ЗаписатьСекциюРеквизитов(Объект, Текст, МетаданныеОбъекта.Реквизиты, "Реквизит");
						
	//Табличные части
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Текст.ЗаписатьСтроку("");
		ТабличнаяЧастьОбъект = Объект[ТабличнаяЧасть.Имя];
		Текст.ЗаписатьСтроку("[ТабличнаяЧасть=" + ТабличнаяЧасть.Имя + "]");
		Если ТабличнаяЧастьОбъект.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
				
		Для Каждого СтрокаТабличнойЧасти Из ТабличнаяЧастьОбъект Цикл
			Текст.ЗаписатьСтроку("");
			Текст.ЗаписатьСтроку("[СтрокаТабличнойЧасти]");
			ЗаписатьСекциюРеквизитов(СтрокаТабличнойЧасти, Текст, ТабличнаяЧасть.Реквизиты, "СтрокаТЧ");
		КонецЦикла;	
	КонецЦикла;
	РеквизитыКоманды = Новый Массив;
	реквизит = новый Структура;
	реквизит.Вставить("Имя","Идентификатор");
	РеквизитыКоманды.Добавить(реквизит);
	реквизит = новый Структура;
	реквизит.Вставить("Имя","РегламентноеЗаданиеGUID");
	РеквизитыКоманды.Добавить(реквизит);
	
	Если СсылкаНаОбъект.Команды.Количество()>0 Тогда
		Текст.ЗаписатьСтроку("");
		Текст.ЗаписатьСтроку("[ТабличнаяЧасть=Разделы]");
	КонецЕсли;       
    Для Каждого Раздел Из СсылкаНаОбъект.Разделы Цикл
		Текст.ЗаписатьСтроку("");
		Текст.ЗаписатьСтроку("[СтрокаТабличнойЧасти]");
		ЗаписатьСекциюРеквизитов(Раздел, Текст, СсылкаНаОбъект.Метаданные().ТабличныеЧасти.Разделы.Реквизиты, "СтрокаТЧ");
 	КонецЦикла;


	
	
	//настройки команды
	Если СсылкаНаОбъект.Команды.Количество()>0 Тогда
		Текст.ЗаписатьСтроку("");
		Текст.ЗаписатьСтроку("[ТабличнаяЧасть=Команды]");
	КонецЕсли;       
	
	Для Каждого Команда Из СсылкаНаОбъект.Команды Цикл
		Текст.ЗаписатьСтроку("");
		Текст.ЗаписатьСтроку("[СтрокаТабличнойЧасти]");
		ЗаписатьСекциюРеквизитов(Команда, Текст, РеквизитыКоманды, "СтрокаТЧ");
 	КонецЦикла;
	//настройки размещение 
	Текст.ЗаписатьСтроку("КонецФайла");
	Текст.Закрыть();
	
	// передаем заполненный на сервере файлик назад на клиент через временноехранилище:    
