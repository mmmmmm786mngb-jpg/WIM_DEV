	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные_, Новый УникальныйИдентификатор()); // кидаем двоичные данные во врем. хранилище
    //Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные_, ЭтаФорма.УникальныйИдентификатор); // кидаем двоичные данные во врем. хранилище
    Возврат Адрес;
