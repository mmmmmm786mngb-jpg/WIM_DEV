Процедура УстановитьПользовательскиеНастройки(НастройкиИзБазы,Объект)Экспорт
	ЗначенияНастроек = Новый Структура;
	Если ТипЗнч(НастройкиИзБазы) = Тип("Структура") Тогда 
		ЗаполнитьЗначенияСвойств(Объект,ЗначенияНастроек);

		Если НастройкиИзБазы.Свойство("Значения",ЗначенияНастроек) Тогда 
			Для Каждого Элемент из ЗначенияНастроек Цикл 
				Если ТипЗнч(Элемент.Значение) = Тип("Строка")Тогда
					Попытка      
						СтрокаСериализации = Элемент.Значение;   
						XMLЗначение(Тип("ХранилищеЗначения"), СтрокаСериализации);
						ХранилищеЗначения = XMLЗначение(Тип("ХранилищеЗначения"), СтрокаСериализации);
						РеквизитПриемник = ХранилищеЗначения.Получить();
						Если ТипЗнч(РеквизитПриемник) = Тип("ТаблицаЗначений") тогда
							Объект[Элемент.Ключ].Очистить();
							Для каждого стр из РеквизитПриемник Цикл
								СтрОб = Объект[Элемент.Ключ].Добавить();	
								ЗаполнитьЗначенияСвойств(СтрОб,стр);
								
							КонецЦикла;
						Иначе     
							Продолжить
						КонецЕсли;	
						
						
					Исключение
					Конецпопытки;
				Конецесли;
					//Сообщить(Элемент.Ключ + ": " + Элемент.Значение); 
			КонецЦикла;
			
						
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры


Функция СтруктураВСтроку(Структура) Экспорт
	Строка = "";

	//далее, простым перебором мы будем заполнять наше сообщение
	Для каждого Элемент Из Структура Цикл
		//добавим разделитель после предыдущего значения
		//Строка = Строка + "&";
		//добавим представление ключа и значения:
		Если ТипЗнч(Элемент.Значение) = Тип("ФиксированныйМассив") Тогда	
			Строка = Строка + Элемент.Ключ + "=" + ПреобразоватьМассивВСтроку(Элемент.Значение,"^");	
		ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("Массив") Тогда	
			СтрДДС = ""; 
			Если Элемент.Ключ = "DetailedDailySchedules" И Элемент.Значение.Количество()> 0 Тогда  
				СтрДДС = СтрДДС +"[ТАБЛИЧНАЯЧАСТЬ=DetailedDailySchedules]"+"&{"; 
				Для каждого эл из Элемент.Значение Цикл 
					СтрДДС = СтрДДС+"[СтрокаТабличнойЧасти]";	
					СтрДДС = СтрДДС + СтруктураВСтроку(эл);	                              
				КонецЦикла;
				Строка = Строка + СтрДДС+"}";
			Иначе
				Строка = Строка + Элемент.Ключ + "=" + ПреобразоватьМассивВСтроку(Элемент.Значение,"^");	
			КонецЕсли;
			
		Иначе	
			Строка = Строка + Элемент.Ключ + "=" + Строка(Элемент.Значение)+"#!!#"+ТипЗнч(Элемент.Значение)+"#!!#";
		КонецЕсли;  
		Строка = Строка + "&";
	КонецЦикла;

	Возврат Строка;
КонецФункции

Процедура ЗаписатьСекциюРеквизитов(Знач Объект, Текст, Реквизиты, ТегНачало)
	Разделитель = "#!#";   
	GUIDРегЗадания = Неопределено;
	Для Каждого Реквизит Из Реквизиты Цикл 
		
			ЗначениеРеквизита = Объект[Реквизит.Имя];
			Попытка
				Если НЕ ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
					Продолжить;
				КонецЕсли;	
			Исключение
			КонецПопытки;	
			
			Если Реквизит.Имя = "РегламентноеЗаданиеGUID" Тогда
				GUIDРегЗадания = Строка(ЗначениеРеквизита);
				ТипРеквизита = ТипЗнч("Строка");
				
			Иначе	
				ТипРеквизита = ТипЗнч(ЗначениеРеквизита);
	
			КонецЕсли;
			
			СтрокаРеквизита = ТегНачало + "=" + Реквизит.Имя + Разделитель;
							
			ТипПоМетаданным = Метаданные.НайтиПоТипу(ТипРеквизита);
			Если ТипПоМетаданным <> Неопределено Тогда
				ИмяТипа = ТипПоМетаданным.ПолноеИмя(); 
				СтрокаРеквизита = СтрокаРеквизита + ИмяТипа;
				Если ЭтоСсылочныйТип(ИмяТипа) Тогда
					Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
						СтрокаРеквизита = СтрокаРеквизита + Разделитель + ПолучитьУникальныйИдентификатор(ИмяТипа, ЗначениеРеквизита);
					КонецЕсли;	
				КонецЕсли;	
			ИначеЕсли ЭтоПростойТип(Строка(ТипРеквизита)) Тогда
				Если ТипРеквизита = Тип("Строка") Тогда
					ЗначениеРеквизита = УчестьМногоcтрочныйТекст(ТипРеквизита, ЗначениеРеквизита, "Однострочный");
				КонецЕсли;	
				
				СтрокаРеквизита = СтрокаРеквизита + ТипРеквизита;
				СтрокаРеквизита = СтрокаРеквизита + Разделитель + ЗначениеРеквизита;
			Иначе
				ХранилищеЗначения = Новый ХранилищеЗначения(ЗначениеРеквизита, Новый СжатиеДанных(9));
				СтрокаСериализации = XMLСтрока(ХранилищеЗначения);
				ДвоичнДанные = ПолучитьДвоичныеДанныеИзСтроки(СтрокаСериализации);
				СтрокаBase64 = Base64Строка(ДвоичнДанные);
				ЗначениеРеквизита = УчестьМногоcтрочныйТекст(ТипРеквизита, СтрокаBase64, "Однострочный");
				
				СтрокаРеквизита = СтрокаРеквизита + ТипРеквизита;
				СтрокаРеквизита = СтрокаРеквизита + Разделитель + ЗначениеРеквизита;
		КонецЕсли;
		Текст.ЗаписатьСтроку(СтрокаРеквизита);
	КонецЦикла;
	Если GUIDРегЗадания <> неопределено тогда
		РегламентноеЗадание = НайтиЗадание(Новый УникальныйИдентификатор(GUIDРегЗадания));
		Если РегламентноеЗадание <> Неопределено Тогда
			ПараметрыЗадания = ПолучитьПараметрыЗадания(РегламентноеЗадание);
			СтрокаРеквизита = ТегНачало + "=Использование" + Разделитель+ ТипЗнч(ПараметрыЗадания.Использование)+Разделитель+ПараметрыЗадания.Использование;
			Текст.ЗаписатьСтроку(СтрокаРеквизита);
			СтрокаРеквизита = ТегНачало + "=Ключ" + Разделитель+ ТипЗнч(РегламентноеЗадание.Ключ)+Разделитель+РегламентноеЗадание.Ключ;
			Текст.ЗаписатьСтроку(СтрокаРеквизита);
			СтрокаРеквизита = ТегНачало + "=ИмяПользователя" + Разделитель+ ТипЗнч(РегламентноеЗадание.ИмяПользователя)+Разделитель+РегламентноеЗадание.ИмяПользователя;
			Текст.ЗаписатьСтроку(СтрокаРеквизита);
			ЗначениеРеквизита = ПараметрыЗадания;// ПараметрыЗадания.Расписание; 
			НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);
            СтруктураРасписания = ОбъектXDTOВСтруктуру(НовыйСериализаторXDTO.ЗаписатьXDTO(ЗначениеРеквизита.Расписание)) ;
			ЗначениеРеквизита = СтруктураВСтроку(СтруктураРасписания);
		   	СтрокаРеквизита = ТегНачало + "=Расписание"+ Разделитель+ ТипЗнч(ПараметрыЗадания.Расписание)+ Разделитель + ЗначениеРеквизита;					
			
			Текст.ЗаписатьСтроку(СтрокаРеквизита);
		КонецЕсли;

	КонецЕсли;
КонецПроцедуры

Функция ЭтоСсылочныйТип(СтрокаТипа)
	Возврат СтрНайти(СтрокаТипа, ".") > 0;
КонецФункции

Функция ЭтоПростойТип(СтрокаТипа)
	МассивИменПростыхТипов = Новый Массив;
	МассивИменПростыхТипов.Добавить("Число");
	МассивИменПростыхТипов.Добавить("Дата");
	МассивИменПростыхТипов.Добавить("Строка");
	МассивИменПростыхТипов.Добавить("Булево");
	
	Результат = Ложь;
	Для Каждого СтрокаИмени Из МассивИменПростыхТипов Цикл
		Результат = СтрНайти(СтрокаИмени, СтрокаТипа) > 0;
		Если Результат Тогда
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ПолучитьУникальныйИдентификатор(Знач ИмяТипа, Знач ЗначениеРеквизита)
	Возврат ?(СтрНайти(ИмяТипа, "Перечислен") = 0, ЗначениеРеквизита.УникальныйИдентификатор(), ЗначениеРеквизита);
КонецФункции

Функция УчестьМногоcтрочныйТекст(Знач ТипРеквизита, Знач Текст, Знач НаправлениеПреобразования)
	Результат = Текст;
	Разделитель = "&#xD;";
	ВозвратКаретки = "&^&";
	Если ТипРеквизита = Тип("Строка")ИЛИ ТипРеквизита = "Строка" ИЛИ ТипРеквизита = Тип("Строка") ИЛИ ТипРеквизита = Тип("УникальныйИдентификатор") ИЛИ ТипРеквизита = Тип("ТабличныйДокумент") ИЛИ ТипРеквизита = "Табличный документ" ИЛИ ТипРеквизита = "Расписание задания"  Тогда
		Результат = ?(НаправлениеПреобразования = "Многострочный", СтрЗаменить(Текст, Разделитель, Символы.ПС), СтрЗаменить(Текст, Символы.ПС, Разделитель));
		Результат = ?(НаправлениеПреобразования = "Многострочный", СтрЗаменить(Результат, ВозвратКаретки, Символы.ВК), СтрЗаменить(Результат, Символы.ВК, ВозвратКаретки));
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
