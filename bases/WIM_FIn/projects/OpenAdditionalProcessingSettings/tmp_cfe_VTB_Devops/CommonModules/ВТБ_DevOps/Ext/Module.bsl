Функция ПредставлениеЗадания(СправочникОбъект, СтрокаКоманды)
	// '%1: %2 / Команда: %3'
	Возврат (
		СокрЛП(СправочникОбъект.Вид)
		+ ": "
		+ СокрЛП(СправочникОбъект.Наименование)
		+ " / "
		+ НСтр("ru = 'Команда'")
		+ ": "
		+ СокрЛП(СтрокаКоманды.Представление));
КонецФункции

