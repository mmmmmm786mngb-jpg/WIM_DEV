#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьСведенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ОбработатьРезультатНастроек(ВыбранноеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДополнительнаяОбработкаПриИзменении(Элемент)
	
	ОбновитьСведенияНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСведения(Команда)
	
	ОбновитьСведенияНаСервере();
	
КонецПроцедуры

// Описание: Открывает ФормаНастроек выбранной дополнительной обработки/отчета
// и сохраняет возвращенную структуру в реквизит ХранилищеНастроек элемента справочника.
//
&НаКлиенте
Процедура ОткрытьФормуНастроек(Команда)
	
	Если Не ЗначениеЗаполнено(ДополнительнаяОбработка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите элемент справочника «Дополнительные отчеты и обработки».'"));
		Возврат;
	КонецЕсли;
	
	ДанныеОткрытия = ПодготовитьОткрытиеНастроекНаСервере(ДополнительнаяОбработка);
	Если Не ДанныеОткрытия.Успех Тогда
		ПоказатьПредупреждение(, ДанныеОткрытия.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуНастроекЗавершение", ЭтотОбъект);
	ОткрытьФормуНастроекСПараметрами(ДанныеОткрытия, Оповещение, Не ДанныеОткрытия.ПередаватьНастройкиАлгоритма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьФормуНастроекСПараметрами(ДанныеОткрытия, Оповещение, Знач БезНастроекАлгоритма)
	
	ПараметрыФормы = Новый Структура;
	Если Не БезНастроекАлгоритма Тогда
		ПараметрыФормы.Вставить("НастройкиАлгоритма", ДанныеОткрытия.Настройки);
	КонецЕсли;
	
	Попытка
		ОткрытьФорму(
			ДанныеОткрытия.ИмяФормы,
			ПараметрыФормы,
			ЭтотОбъект,
			УникальныйИдентификатор,
			,
			,
			Оповещение);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Не БезНастроекАлгоритма И ЭтоОшибкаНесовместимостиНастроек(ТекстОшибки) Тогда
			ПоказатьПредупреждение(
				,
				НСтр("ru = 'Форма настроек не приняла сохраненные настройки (несовместимый метод УстановитьПользовательскиеНастройки).
				|Открываю форму без загрузки настроек из ХранилищеНастроек.
				|Можно задать параметры заново и сохранить — старые значения будут перезаписаны.'"));
			ОткрытьФормуНастроекСПараметрами(ДанныеОткрытия, Оповещение, Истина);
			Возврат;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Если БезНастроекАлгоритма И ТипЗнч(ДанныеОткрытия.Настройки) = Тип("Структура") Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Форма открыта без загрузки настроек'"),
			,
			НСтр("ru = 'В справочнике настройки есть, но форма обработки их не принимает одним параметром.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастроекЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОбработатьРезультатНастроек(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатНастроек(Результат)
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если Не СохранитьНастройкиНаСервере(ДополнительнаяОбработка, Результат, ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТекущиеНастройки = Результат;
	ОбновитьСведенияНаСервере();
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Настройки сохранены'"),
		,
		Строка(ДополнительнаяОбработка));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОшибкаНесовместимостиНастроек(Знач ТекстОшибки)
	
	Текст = НРег(Строка(ТекстОшибки));
	Возврат СтрНайти(Текст, "слишком много фактических параметров") > 0
		Или СтрНайти(Текст, "недостаточно фактических параметров") > 0
		Или СтрНайти(Текст, "метод объекта не обнаружен") > 0
		Или СтрНайти(Текст, "procedure or function is not defined") > 0
		Или СтрНайти(Текст, "too many actual parameters") > 0;
	
КонецФункции

&НаСервере
Процедура ОбновитьСведенияНаСервере()
	
	ПредставлениеНастроек = НСтр("ru = '<элемент не выбран>'");
	ЕстьФормаНастроек = Ложь;
	ТекущиеНастройки = Неопределено;
	
	Если Не ЗначениеЗаполнено(ДополнительнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ПолучитьСведенияОбОбработкеНаСервере(ДополнительнаяОбработка);
	ЕстьФормаНастроек = Данные.ЕстьФормаНастроек;
	ТекущиеНастройки = Данные.Настройки;
	
	Если Не Данные.ЕстьФормаНастроек Тогда
		ПредставлениеНастроек = НСтр("ru = 'У обработки нет формы ФормаНастроек'");
		Если ЗначениеЗаполнено(Данные.ТекстОшибки) Тогда
			ПредставлениеНастроек = Данные.ТекстОшибки;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПредставлениеНастроек = НСтр("ru = '<настройки не установлены>'");
	Если ТипЗнч(ТекущиеНастройки) = Тип("Структура") Тогда
		ЗначениеЗаголовка = Неопределено;
		Если ТекущиеНастройки.Свойство("ЗаголовокНастроек", ЗначениеЗаголовка)
			И ЗначениеЗаполнено(ЗначениеЗаголовка) Тогда
			ПредставлениеНастроек = Строка(ЗначениеЗаголовка);
		Иначе
			ПредставлениеНастроек = НСтр("ru = 'Настройки установлены (структура)'");
		КонецЕсли;
	ИначеЕсли ТекущиеНастройки <> Неопределено Тогда
		ПредставлениеНастроек = НСтр("ru = 'Настройки установлены'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСведенияОбОбработкеНаСервере(Знач СсылкаОбработки)
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьФормаНастроек", Ложь);
	Результат.Вставить("Настройки", Неопределено);
	Результат.Вставить("ТекстОшибки", "");
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаОбработки,
		"ПометкаУдаления, ХранилищеНастроек");
	
	Если Реквизиты.ПометкаУдаления Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Элемент помечен на удаление.'");
		Возврат Результат;
	КонецЕсли;
	
	Хранилище = Реквизиты.ХранилищеНастроек;
	Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
		Результат.Настройки = Хранилище.Получить();
	КонецЕсли;
	
	ДанныеПодключения = ПодключитьИПроверитьФормуНастроек(СсылкаОбработки);
	Если Не ДанныеПодключения.Успех Тогда
		Результат.ТекстОшибки = ДанныеПодключения.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЕстьФормаНастроек = Истина;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьОткрытиеНастроекНаСервере(Знач СсылкаОбработки)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("Настройки", Неопределено);
	Результат.Вставить("ПередаватьНастройкиАлгоритма", Истина);
	
	ДанныеПодключения = ПодключитьИПроверитьФормуНастроек(СсылкаОбработки);
	Если Не ДанныеПодключения.Успех Тогда
		Результат.ТекстОшибки = ДанныеПодключения.ТекстОшибки;
		Возврат Результат;
	КонецЕсли;
	
	Хранилище = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаОбработки, "ХранилищеНастроек");
	Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
		Результат.Настройки = Хранилище.Получить();
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.ИмяФормы = ДанныеПодключения.ИмяФормы;
	
	Если ТипЗнч(Результат.Настройки) = Тип("Структура") Тогда
		Результат.ПередаватьНастройкиАлгоритма = МожноПередатьНастройкиАлгоритма(
			ДанныеПодключения.ОбъектВнешний,
			Результат.Настройки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодключитьИПроверитьФормуНастроек(Знач СсылкаОбработки)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("ОбъектВнешний", Неопределено);
	
	ВидОбработки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаОбработки, "Вид");
	ЭтоОтчет = (ВидОбработки = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет
		Или ВидОбработки = Перечисления.ВидыДополнительныхОтчетовИОбработок.Отчет);
	
	ИмяПодключенногоОбъекта = ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(СсылкаОбработки);
	Если Не ЗначениеЗаполнено(ИмяПодключенногоОбъекта) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось подключить внешнюю обработку/отчет из справочника.'");
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоОтчет Тогда
		МенеджерОбъектов = ВнешниеОтчеты;
		ПрефиксИмениФормы = "ВнешнийОтчет.";
	Иначе
		МенеджерОбъектов = ВнешниеОбработки;
		ПрефиксИмениФормы = "ВнешняяОбработка.";
	КонецЕсли;
	
	ОбъектВнешний = МенеджерОбъектов.Создать(ИмяПодключенногоОбъекта);
	Если ОбъектВнешний.Метаданные().Формы.Найти("ФормаНастроек") = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У выбранной обработки/отчета нет формы с именем «ФормаНастроек».'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.ИмяФормы = ПрефиксИмениФормы + ИмяПодключенногоОбъекта + ".Форма.ФормаНастроек";
	Результат.ОбъектВнешний = ОбъектВнешний;
	Возврат Результат;
	
КонецФункции

// Описание: Проверяет, можно ли вызвать УстановитьПользовательскиеНастройки(Настройки)
// так, как это делает типовая ФормаНастроек при передаче Параметры.НастройкиАлгоритма.
//
&НаСервереБезКонтекста
Функция МожноПередатьНастройкиАлгоритма(Знач ОбъектВнешний, Знач Настройки)
	
	Если ОбъектВнешний = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		ОбъектВнешний.УстановитьПользовательскиеНастройки(Настройки);
		Возврат Истина;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ЭтоОшибкаНесовместимостиНастроек(ТекстОшибки) Тогда
			Возврат Ложь;
		КонецЕсли;
		// Иная ошибка внутри метода (данные и т.п.) - все же передаем настройки в форму.
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция СохранитьНастройкиНаСервере(Знач СсылкаОбработки, Знач Настройки, ТекстОшибки)
	
	ТекстОшибки = "";
	
	Если Не ЗначениеЗаполнено(СсылкаОбработки) Тогда
		ТекстОшибки = НСтр("ru = 'Не выбран элемент справочника.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ТекстОшибки = НСтр("ru = 'Форма настроек не вернула структуру настроек.'");
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ОбъектСправочника = СсылкаОбработки.ПолучитьОбъект();
		ОбъектСправочника.ХранилищеНастроек = Новый ХранилищеЗначения(Настройки);
		ОбъектСправочника.Записать();
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось записать настройки:'") + " " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Открытие настроек дополнительных обработок'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ДополнительныеОтчетыИОбработки,
			СсылкаОбработки,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
