&НаКлиенте 
Перем ВремяНачалаОбработки;


&НаСервере
Процедура ВыполнитьОбменДУ_ФинансыНаСервере(ТабДок)
	
	ПараметрыОбмена = Новый Структура("Интерактивно", Истина);
	
	СписокСтатейЗатратКомиссияБанка = СтатьиЗатратКомиссияБанка.ВыгрузитьЗначения();
	СписокСтатейЗатратДепозитарныеУслуги = СтатьиЗатратДепозитарныеУслуги.ВыгрузитьЗначения();
	СписокСтатейЗатратДивиденды = СтатьиЗатратДивиденды.ВыгрузитьЗначения();
	
	ПараметрыОбмена.Вставить("СписокСтатейЗатратКомиссияБанка", СписокСтатейЗатратКомиссияБанка);
	ПараметрыОбмена.Вставить("СписокСтатейЗатратДепозитарныеУслуги", СписокСтатейЗатратДепозитарныеУслуги);
	ПараметрыОбмена.Вставить("СписокСтатейЗатратДивиденды", СписокСтатейЗатратДивиденды);
	ПараметрыОбмена.Вставить("ДатаНачалаРегистрации", Объект.УзелОбмена.ДатаНачалаРегистрации);
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.ВыполнитьОбменДУ_Финансы(ПараметрыОбмена);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбменДУ_Финансы(Команда)
	
	ЕстьАктивныеЗадания = НаличиеАктивныхЗаданийВыгрузки();
	
	//{[+] Рефакторинг N.Filimonova 01.03.2022
	//Если ЕстьАктивныеЗадания И Не Объект.СтартоватьСделкиПриЗагрузке Тогда  
	Если ЕстьАктивныеЗадания Тогда
		ТекстПредупреждения = НСтр("ru = 'Есть активные фоновые задания по выгрузке в базу Финансы. 
								  |Попробуйте выполнить обмен позже.'");   
		
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Запуск обмена ДУ->ФИН'", ОбщегоНазначенияКлиентСервер), "Ошибка", ТекстПредупреждения, ТекущаяДата());    
			
	    Предупреждение(ТекстПредупреждения);
			
		Возврат; 
	Иначе   
		ВремяНачалаОбработки = ТекущаяДата();
		
		ТекстПредупреждения = НСтр("ru = 'Запущен фоновый обмен с базой Финансы.'");
		
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			НСтр("ru = 'Запуск обмена ДУ->ФИН'", ОбщегоНазначенияКлиентСервер), "Информация", ТекстПредупреждения, ТекущаяДата()); 
			
	    Предупреждение(ТекстПредупреждения);  
	КонецЕсли;   
	//} Рефакторинг N.Filimonova
	
	ТабДок = Неопределено;
	ВыполнитьОбменДУ_ФинансыНаСервере(ТабДок);    
	
	// мониторинг завершения обмена 
	ПодключитьОбработчикОжидания("МониторингЗавершенияОбмена", 60, Ложь);
	
КонецПроцедуры 

&НаКлиенте
Функция МониторингЗавершенияОбмена()
	//{[+] Рефакторинг N.Filimonova 24.08.2022
	
	Если НаличиеАктивныхЗаданийВыгрузки() = Ложь Тогда
	 ОтключитьОбработчикОжидания("МониторингЗавершенияОбмена"); 
	 
	 Сообщить("-----------------------------------------------------------------");
	 Сообщить("" + ВремяНачалаОбработки + " - Запущена обработка Обмен ДУ-Финансы 2.0");
	 Сообщить("" + ТекущаяДата() + " - Завершена обработка Обмен ДУ-Финансы 2.0");
	КонецЕсли;	
	
	//} Рефакторинг N.Filimonova
КонецФункции

&НаСервере
Функция НаличиеАктивныхЗаданийВыгрузки()
	//{[+] Рефакторинг N.Filimonova 01.03.2022
	
	ЕстьАктивныеЗадания = Истина;
	
	ОтборФонЗадан = Новый Структура;        
	ОтборФонЗадан.Вставить("Наименование", "Выгрузка в базу Финансы");
	ОтборФонЗадан.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	АктивныеФонЗадан = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборФонЗадан);
	
	Если АктивныеФонЗадан.Количество() = 0 Тогда 
		ЕстьАктивныеЗадания = Ложь;
	КонецЕсли;
	
	Возврат ЕстьАктивныеЗадания;
	
	//} Рефакторинг N.Filimonova
КонецФункции

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	//{[+] Рефакторинг N.Filimonova 01.03.2022 
	
	Настройки.Вставить("СписокРассылкиСтрокой", ЗначениеВСтрокуВнутр(Объект.СписокРассылки.Выгрузить()));
	
	//} Рефакторинг N.Filimonova
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)  
	//{[+] Рефакторинг N.Filimonova 01.03.2022     
	
	СписокРассылкиСтрокойИзНастроек = Настройки.Получить("СписокРассылкиСтрокой");
	
	Если СписокРассылкиСтрокойИзНастроек <> Неопределено 
		И ЗначениеЗаполнено(СписокРассылкиСтрокойИзНастроек) Тогда
		СписокРассылки = ЗначениеИзСтрокиВнутр(СписокРассылкиСтрокойИзНастроек);
		Объект.СписокРассылки.Загрузить(СписокРассылки);
	КонецЕсли;    
	
	//} Рефакторинг N.Filimonova
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьТранзакцииПриИзменении(Элемент)
	//{[+] Рефакторинг N.Filimonova 15.08.2022     
	Элементы.КоличествоОбъектовНаТранзакцию.Видимость = Объект.ИспользоватьТранзакции = Истина; 
	
	Если Объект.ИспользоватьТранзакции = Ложь Тогда 
		Объект.КоличествоОбъектовНаТранзакцию = 0;
	КонецЕсли;	
	//} Рефакторинг N.Filimonova
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ИспользоватьТранзакцииПриИзменении(Элементы.ИспользоватьТранзакции);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.НастройкиПоУмолчанию(ТекОбъект); 
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры



