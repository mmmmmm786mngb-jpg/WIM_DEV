// ОтфильтроватьПланРеглОперацийНаДень
//
// Описание:
//   Фильтрует план регламентных операций на один день согласно алгоритму раздела 6
//   окончательного технического задания IMDEV-8641.
//
//   Процедура снимает признак Выполнять = Ложь у части строк таблицы плана
//   (без удаления строк) при выполнении следующих условий:
//    - Значение константы "ПулРозницаДУ" заполнено;
//    - Все портфели в плане относятся к указанному пулу (однородность пула);
//    - Вид операции присутствует в регистре сведений "ВидыОптимизируемыхРегламентныхОперацийДУ".
//
//   Для каждой уникальной комбинации (ВидОперации + ВремяРеглОпераций + Родитель)
//   среди строк с Выполнять = Истина вызывается функция ПолучитьПортфелиДляСохраненияВыполненияВПлане(),
//   после чего выполняется корректировка признака выполнения через пакетный запрос
//   с левым соединением к временной таблице разрешенных портфелей.
//
// Назначение:
//   Заменить заглушку в модуле менеджера регистра сведений:
//   InformationRegisters.ВидыОптимизируемыхРегламентныхОперацийДУ.Ext.ManagerModule.bsl
//   (в области "ОтборПортфелейДляСохраненияВыполненияВПлане").
//
// Условия встраивания:
//   - В том же модуле должна быть реализована экспортная функция ПолучитьПортфелиДляСохраненияВыполненияВПлане()
//     и все её вспомогательные функции;
//   - Вызов производится из обработки "ГрупповоеВыполнениеЗакрытияПериодов" в области #Вставка;
//   - Константа "ПулРозницаДУ" читается исключительно через
//     ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты().
//
// Параметры:
//   День                     - Дата - день, для которого производится фильтрация плана
//                                    (соответствует переменной День в типовой процедуре);
//   тПланРеглОперацийПоДням  - ТаблицаЗначений - таблица плана регламентных операций на день.
//                                    Допускается изменение только колонки "Выполнять".
//                                    Состав колонок: Выполнять, Портфель, ВидОперации,
//                                    ВремяРеглОпераций, Родитель.
//
// Пример использования:
//   РегистрыСведений.ВидыОптимизируемыхРегламентныхОперацийДУ.
//       ОтфильтроватьПланРеглОперацийНаДень(День, тПланРеглОперацийПоДням);
//
Процедура ОтфильтроватьПланРеглОперацийНаДень(День, тПланРеглОперацийПоДням) Экспорт

    // --- 6.1 ПРОВЕРКА 1 ---
    ЗначениеКонстантыПулРозницаДУ = ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ПулРозницаДУ");
    Если Не ЗначениеЗаполнено(ЗначениеКонстантыПулРозницаДУ) Тогда
        Возврат;
    КонецЕсли;

    Если тПланРеглОперацийПоДням = Неопределено Или тПланРеглОперацийПоДням.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    // --- 6.2 ПРОВЕРКА 2 (запросом: есть ли портфель, у которого Пул <> эталона константы) ---
    ЗапросПроверкиПула = Новый Запрос;
    ЗапросПроверкиПула.Текст =
    "ВЫБРАТЬ
    |    План.Портфель КАК Портфель
    |ПОМЕСТИТЬ ВТ_ПланИсходный
    |ИЗ
    |    &ТаблицаПлана КАК План
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ ПЕРВЫЕ 1
    |    1 КАК ЕстьНарушениеПула
    |ИЗ
    |    ВТ_ПланИсходный КАК План
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Портфели КАК Портфели
    |        ПО План.Портфель = Портфели.Ссылка
    |ГДЕ
    |    Портфели.Пул <> &ЭталонПул";
    ЗапросПроверкиПула.УстановитьПараметр("ТаблицаПлана", тПланРеглОперацийПоДням);
    ЗапросПроверкиПула.УстановитьПараметр("ЭталонПул", ЗначениеКонстантыПулРозницаДУ);

    РезультатПроверкиПула = ЗапросПроверкиПула.Выполнить();
    Если Не РезультатПроверкиПула.Пустой() Тогда
        Возврат;
    КонецЕсли;

    // --- 6.3 Подготовка свода уникальных ключей операций для обработки ---
    // План один раз помещается в ВТ_План (один менеджер временных таблиц на цепочку запросов).
    // Уникальные ключи (ВидОперации, ВремяРеглОпераций, Родитель) по Выполнять = 1 и РС
    // помещаются в ВТ_СводДопустимыеКлючи; номер строки свода задаётся АВТОНОМЕРЗАПИСИ()
    // при создании ВТ_СводКлючиСНомеромСтроки (8.3.27+). Значение автономера в СУБД не
    // гарантируется с нуля и не используется как индекс ТЗ; сшивка через Соответствие.
    // Здесь же заполняются МассивПортфелей и День по строкам свода (для вызова в 6.4).

    ЗапросСводИПортфели = Новый Запрос;
    ЗапросСводИПортфели.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
    ЗапросСводИПортфели.УстановитьПараметр("ТаблицаПлана", тПланРеглОперацийПоДням);
    ЗапросСводИПортфели.Текст =
    "ВЫБРАТЬ
    |    План.Портфель          КАК Портфель,
    |    План.Выполнять         КАК Выполнять,
    |    План.ВидОперации       КАК ВидОперации,
    |    План.ВремяРеглОпераций КАК ВремяРеглОпераций,
    |    План.Родитель          КАК Родитель
    |ПОМЕСТИТЬ ВТ_План
    |ИЗ
    |    &ТаблицаПлана КАК План
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    План.ВидОперации       КАК ВидОперации,
    |    План.ВремяРеглОпераций КАК ВремяРеглОпераций,
    |    План.Родитель          КАК Родитель
    |ПОМЕСТИТЬ ВТ_СводДопустимыеКлючи
    |ИЗ
    |    ВТ_План КАК План
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВидыОптимизируемыхРегламентныхОперацийДУ КАК ОптВиды
    |        ПО План.ВидОперации = ОптВиды.ВидОперации
    |ГДЕ
    |    План.Выполнять = 1
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    АВТОНОМЕРЗАПИСИ() КАК НомерСтрокиСвода,
    |    Ключи.ВидОперации       КАК ВидОперации,
    |    Ключи.ВремяРеглОпераций КАК ВремяРеглОпераций,
    |    Ключи.Родитель          КАК Родитель
    |ПОМЕСТИТЬ ВТ_СводКлючиСНомеромСтроки
    |ИЗ
    |    ВТ_СводДопустимыеКлючи КАК Ключи
    |
    |УПОРЯДОЧИТЬ ПО
    |    Ключи.ВидОперации,
    |    Ключи.ВремяРеглОпераций,
    |    Ключи.Родитель";

    ЗапросСводИПортфели.Выполнить();

    ЗапросСводИПортфели.Текст =
    "ВЫБРАТЬ
    |    Свод.НомерСтрокиСвода   КАК НомерСтрокиСвода,
    |    Свод.ВидОперации        КАК ВидОперации,
    |    Свод.ВремяРеглОпераций  КАК ВремяРеглОпераций,
    |    Свод.Родитель           КАК Родитель
    |ИЗ
    |    ВТ_СводКлючиСНомеромСтроки КАК Свод
    |
    |УПОРЯДОЧИТЬ ПО
    |    Свод.НомерСтрокиСвода";

    ТЗСвод = ЗапросСводИПортфели.Выполнить().Выгрузить();

    Если ТЗСвод.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ЗапросСводИПортфели.Текст =
    "ВЫБРАТЬ
    |    Свод.НомерСтрокиСвода КАК НомерСтрокиСвода,
    |    План.Портфель         КАК Портфель
    |ИЗ
    |    ВТ_План КАК План
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СводКлючиСНомеромСтроки КАК Свод
    |        ПО План.ВидОперации = Свод.ВидОперации
    |            И План.ВремяРеглОпераций = Свод.ВремяРеглОпераций
    |            И План.Родитель = Свод.Родитель
    |ГДЕ
    |    План.Выполнять = 1
    |
    |СГРУППИРОВАТЬ ПО
    |    Свод.НомерСтрокиСвода,
    |    План.Портфель";

    ТЗПортфелиПоСтрокамСвода = ЗапросСводИПортфели.Выполнить().Выгрузить();

    СоответствиеНомерСтрокиСводаВИндексТз = Новый Соответствие;
    Для ИндексТз = 0 По ТЗСвод.Количество() - 1 Цикл
        СоответствиеНомерСтрокиСводаВИндексТз.Вставить(ТЗСвод[ИндексТз].НомерСтрокиСвода, ИндексТз);
    КонецЦикла;

    ТЗСвод.Колонки.Добавить("МассивПортфелей");
    ТЗСвод.Колонки.Добавить("День");

    ВремяОкончанияРабочегоДня = ПолныеПрава.ОкончаниеРабочегоДня();
    Для ИндексТз = 0 По ТЗСвод.Количество() - 1 Цикл

        СтрокаСводаВтз = ТЗСвод[ИндексТз];
        СтрокаСводаВтз.МассивПортфелей = Новый Массив;

        Если ЗначениеЗаполнено(СтрокаСводаВтз.Родитель) Тогда
            СтрокаСводаВтз.День = Дата(Формат(День, "ДФ=""ггггММдд""") + Формат(СтрокаСводаВтз.Родитель.ВремяРеглОпераций, "ДФ=""ЧЧммсс"""));
        Иначе
            СтрокаСводаВтз.День = Дата(Формат(День, "ДФ=""ггггММдд""") + Формат(ВремяОкончанияРабочегоДня, "ДФ=""ЧЧммсс"""));
        КонецЕсли;

    КонецЦикла;

    // Дубли портфеля по одной строке свода уже сняты в запросе (СГРУППИРОВАТЬ ПО НомерСтрокиСвода, Портфель).
    Для Каждого СтрокаПортфеля Из ТЗПортфелиПоСтрокамСвода Цикл

        ИндексТз = СоответствиеНомерСтрокиСводаВИндексТз.Получить(СтрокаПортфеля.НомерСтрокиСвода);
        Если ИндексТз <> Неопределено Тогда

            СтрокаСводаДляПортфеля = ТЗСвод[ИндексТз];
            СтрокаСводаДляПортфеля.МассивПортфелей.Добавить(СтрокаПортфеля.Портфель);

        КонецЕсли;

    КонецЦикла;

    КолонкаНомерСтрокиСвода = ТЗСвод.Колонки.Найти("НомерСтрокиСвода");
    Если КолонкаНомерСтрокиСвода <> Неопределено Тогда
        ТЗСвод.Колонки.Удалить(КолонкаНомерСтрокиСвода);
    КонецЕсли;

    // --- 6.4 Цикл по ТЗ свода; на каждой итерации --- 6.5 пакетный запрос корректировки ---
    Для Каждого СтрокаСвода Из ТЗСвод Цикл

        // В модуле менеджера РС: локальный вызов без префикса регистра.
        МассивПортфелейОставитьВПлане = ПолучитьПортфелиДляСохраненияВыполненияВПлане(
            СтрокаСвода.МассивПортфелей,
            СтрокаСвода.День,
            СтрокаСвода.ВидОперации);

        ЗапросКорректировки = Новый Запрос;
        ЗапросКорректировки.УстановитьПараметр("ТаблицаПлана", тПланРеглОперацийПоДням);
        ЗапросКорректировки.УстановитьПараметр("ВидОперацииСвода", СтрокаСвода.ВидОперации);
        ЗапросКорректировки.УстановитьПараметр("ВремяРеглОперацийСвода", СтрокаСвода.ВремяРеглОпераций);
        ЗапросКорректировки.УстановитьПараметр("РодительСвода", СтрокаСвода.Родитель);
        ЗапросКорректировки.УстановитьПараметр("РодительСводаПустой", Не ЗначениеЗаполнено(СтрокаСвода.Родитель));
        ЗапросКорректировки.УстановитьПараметр("МассивПортфелейОставить", МассивПортфелейОставитьВПлане);

        ЗапросКорректировки.Текст =
        "ВЫБРАТЬ
        |    План.Портфель КАК Портфель,
        |    План.Выполнять КАК Выполнять,
        |    План.ВидОперации КАК ВидОперации,
        |    План.ВремяРеглОпераций КАК ВремяРеглОпераций,
        |    План.Родитель КАК Родитель
        |ПОМЕСТИТЬ ВТ_ИсходныйПлан
        |ИЗ
        |    &ТаблицаПлана КАК План
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |    План.Портфель КАК Портфель,
        |    План.Выполнять КАК Выполнять,
        |    План.ВидОперации КАК ВидОперации,
        |    План.ВремяРеглОпераций КАК ВремяРеглОпераций,
        |    План.Родитель КАК Родитель,
        |    ВЫБОР
        |        КОГДА План.ВидОперации = &ВидОперацииСвода
        |            И План.ВремяРеглОпераций = &ВремяРеглОперацийСвода
        |            И (План.Родитель = &РодительСвода
        |                ИЛИ (&РодительСводаПустой
        |                    И (План.Родитель ЕСТЬ NULL
        |                        ИЛИ План.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыОперацийЗакрытияПериода.ПустаяСсылка))))
        |        ТОГДА ИСТИНА
        |        ИНАЧЕ ЛОЖЬ
        |    КОНЕЦ КАК ПотенциальноИзменяемаяСтрока
        |ПОМЕСТИТЬ ВТ_ТаблицаПлана1
        |ИЗ
        |    ВТ_ИсходныйПлан КАК План
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗЛИЧНЫЕ
        |    Портфели.Ссылка КАК Ссылка
        |ПОМЕСТИТЬ ВТ_Портфели
        |ИЗ
        |    Справочник.Портфели КАК Портфели
        |ГДЕ
        |    Портфели.Ссылка В (&МассивПортфелейОставить)
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |    П1.Портфель КАК Портфель,
        |    ВЫБОР
        |        КОГДА П1.Выполнять = 1
        |            И П1.ПотенциальноИзменяемаяСтрока
        |            И ПортфелиОставить.Ссылка ЕСТЬ NULL
        |        ТОГДА 0
        |        ИНАЧЕ П1.Выполнять
        |    КОНЕЦ КАК Выполнять,
        |    П1.ВидОперации КАК ВидОперации,
        |    П1.ВремяРеглОпераций КАК ВремяРеглОпераций,
        |    П1.Родитель КАК Родитель
        |ИЗ
        |    ВТ_ТаблицаПлана1 КАК П1
        |        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Портфели КАК ПортфелиОставить
        |        ПО П1.Портфель = ПортфелиОставить.Ссылка";

        НоваяТаблицаПлана = ЗапросКорректировки.Выполнить().Выгрузить();
        // Параметр тПланРеглОперацийПоДням передаётся по ссылке на объект ТаблицаЗначений: нельзя присваивать новую таблицу
        // переменной параметра — очистить исходную и заполнить строками результата запроса.
        тПланРеглОперацийПоДням.Очистить();
        Для Каждого СтрПлана Из НоваяТаблицаПлана Цикл
            НовСтр = тПланРеглОперацийПоДням.Добавить();
            ЗаполнитьЗначенияСвойств(НовСтр, СтрПлана);
        КонецЦикла;

    КонецЦикла;

КонецПроцедуры
