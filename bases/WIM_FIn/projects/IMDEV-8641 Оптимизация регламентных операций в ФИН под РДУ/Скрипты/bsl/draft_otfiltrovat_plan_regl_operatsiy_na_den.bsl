// Черновик для переноса в модуль менеджера РС "ВидыОптимизируемыхРегламентныхОперацийДУ".
//
// Описание:
//  Фильтрует план регламентных операций на один календарный день по разделу 6 ТЗ IMDEV-8641.
//  При выполнении условий снимает признак выполнения (колонка "Выполнять") у части строк плана
//  без удаления строк.
//
// Параметры:
//  День                     - Дата - день, для которого строится план (как в типовой обработке);
//  тПланРеглОперацийПоДням  - ТаблицаЗначений - таблица плана на день. Допускается изменение
//                             только колонки "Выполнять". Состав колонок: Выполнять, Портфель,
//                             ВидОперации, ВремяРеглОпераций, Родитель.
//
// Дополнение:
//  В модуле регистра должны быть доступны ПолучитьПортфелиДляСохраненияВыполненияВПлане() и зависимости.
//  Вызов — из обработки "ГрупповоеВыполнениеЗакрытияПериодов". Константа "ПулРозницаДУ" — только
//  через ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты().
//
// Пример:
//  РегистрыСведений.ВидыОптимизируемыхРегламентныхОперацийДУ.ОтфильтроватьПланРеглОперацийНаДень(
//      День, тПланРеглОперацийПоДням);
//
Процедура ОтфильтроватьПланРеглОперацийНаДень(День, тПланРеглОперацийПоДням) Экспорт

    // 6.1. Проверка константы "ПулРозницаДУ" и непустого плана.
    //      Ранний выход, если алгоритм неприменим или данных нет.
    ЗначениеКонстантыПулРозницаДУ = ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ПулРозницаДУ");

    Если Не ЗначениеЗаполнено(ЗначениеКонстантыПулРозницаДУ) Тогда
        Возврат;
    КонецЕсли;

    Если тПланРеглОперацийПоДням = Неопределено Или тПланРеглОперацийПоДням.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    // 6.2. Проверка однородности пула портфелей относительно константы.
    //      Таблица-параметр участвует только в первом подзапросе (ПОМЕСТИТЬ во временную таблицу);
    //      далее в пакете используются только ВТ (требование к использованию табличных параметров).
    ЗапросПроверкиПула = Новый Запрос;
    ЗапросПроверкиПула.Текст =
    "ВЫБРАТЬ
    |    План.Портфель КАК Портфель
    |ПОМЕСТИТЬ ВТ_ПланИсходный
    |ИЗ
    |    &ТаблицаПлана КАК План
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ ПЕРВЫЕ 1
    |    ИСТИНА КАК ЕстьНарушениеПула
    |ИЗ
    |    ВТ_ПланИсходный КАК План
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Портфели КАК Портфели
    |        ПО План.Портфель = Портфели.Ссылка
    |ГДЕ
    |    Портфели.Пул <> &ЭталонПул";

    ЗапросПроверкиПула.УстановитьПараметр("ТаблицаПлана", тПланРеглОперацийПоДням);
    ЗапросПроверкиПула.УстановитьПараметр("ЭталонПул", ЗначениеКонстантыПулРозницаДУ);

    РезультатПроверкиПула = ЗапросПроверкиПула.Выполнить();
    Если Не РезультатПроверкиПула.Пустой() Тогда
        Возврат;
    КонецЕсли;

    // 6.3. Подготовка свода уникальных ключей и списков портфелей для шага 6.4.
    //      План помещается во ВТ_План; допустимые ключи — по Выполнять = 1 и регистру оптимизируемых видов.
    //      Номер строки свода — АВТОНОМЕРЗАПИСИ() при ПОМЕСТИТЬ во ВТ_СводКлючиСНомеромСтроки; связь с ТЗ — через Соответствие.
    МенеджерВТ = Новый МенеджерВременныхТаблиц;

    ЗапросСвод = Новый Запрос;
    ЗапросСвод.МенеджерВременныхТаблиц = МенеджерВТ;
    ЗапросСвод.УстановитьПараметр("ТаблицаПлана", тПланРеглОперацийПоДням);

    ЗапросСвод.Текст =
    "ВЫБРАТЬ
    |    План.Портфель          КАК Портфель,
    |    План.Выполнять         КАК Выполнять,
    |    План.ВидОперации       КАК ВидОперации,
    |    План.ВремяРеглОпераций КАК ВремяРеглОпераций,
    |    План.Родитель          КАК Родитель
    |ПОМЕСТИТЬ ВТ_План
    |ИЗ
    |    &ТаблицаПлана КАК План
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    План.ВидОперации       КАК ВидОперации,
    |    План.ВремяРеглОпераций КАК ВремяРеглОпераций,
    |    План.Родитель          КАК Родитель
    |ПОМЕСТИТЬ ВТ_СводДопустимыеКлючи
    |ИЗ
    |    ВТ_План КАК План
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВидыОптимизируемыхРегламентныхОперацийДУ КАК ОптВиды
    |        ПО План.ВидОперации = ОптВиды.ВидОперации
    |ГДЕ
    |    План.Выполнять = 1
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    АВТОНОМЕРЗАПИСИ()       КАК НомерСтрокиСвода,
    |    Ключи.ВидОперации       КАК ВидОперации,
    |    Ключи.ВремяРеглОпераций КАК ВремяРеглОпераций,
    |    Ключи.Родитель          КАК Родитель
    |ПОМЕСТИТЬ ВТ_СводКлючиСНомеромСтроки
    |ИЗ
    |    ВТ_СводДопустимыеКлючи КАК Ключи
    |
    |УПОРЯДОЧИТЬ ПО
    |    Ключи.ВидОперации,
    |    Ключи.ВремяРеглОпераций,
    |    Ключи.Родитель";

    ЗапросСвод.Выполнить();

    ЗапросСвод.Текст =
    "ВЫБРАТЬ
    |    Свод.НомерСтрокиСвода   КАК НомерСтрокиСвода,
    |    Свод.ВидОперации        КАК ВидОперации,
    |    Свод.ВремяРеглОпераций  КАК ВремяРеглОпераций,
    |    Свод.Родитель           КАК Родитель
    |ИЗ
    |    ВТ_СводКлючиСНомеромСтроки КАК Свод
    |
    |УПОРЯДОЧИТЬ ПО
    |    Свод.НомерСтрокиСвода";

    ТЗСвод = ЗапросСвод.Выполнить().Выгрузить();

    Если ТЗСвод.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ЗапросСвод.Текст =
    "ВЫБРАТЬ
    |    Свод.НомерСтрокиСвода КАК НомерСтрокиСвода,
    |    План.Портфель         КАК Портфель
    |ИЗ
    |    ВТ_План КАК План
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СводКлючиСНомеромСтроки КАК Свод
    |        ПО План.ВидОперации = Свод.ВидОперации
    |            И План.ВремяРеглОпераций = Свод.ВремяРеглОпераций
    |            И План.Родитель = Свод.Родитель
    |ГДЕ
    |    План.Выполнять = 1
    |
    |СГРУППИРОВАТЬ ПО
    |    Свод.НомерСтрокиСвода,
    |    План.Портфель";

    ТЗПортфелиПоСтрокамСвода = ЗапросСвод.Выполнить().Выгрузить();

    СоответствиеНомерСтрокиВИндекс = Новый Соответствие;
    Для ИндексСтрокиТз = 0 По ТЗСвод.Количество() - 1 Цикл
        СоответствиеНомерСтрокиВИндекс.Вставить(ТЗСвод[ИндексСтрокиТз].НомерСтрокиСвода, ИндексСтрокиТз);
    КонецЦикла;

    ТЗСвод.Колонки.Добавить("МассивПортфелей");
    ТЗСвод.Колонки.Добавить("День");

    ШаблонДатыКалендаря = "ДФ=""ггггММдд""";
    ШаблонВремениСуток = "ДФ=""ЧЧммсс""";
    ЧастьДатыДня = Формат(День, ШаблонДатыКалендаря);
    ВремяОкончанияРабочегоДня = ПолныеПрава.ОкончаниеРабочегоДня();
    ЧастьВремениОкончанияДня = Формат(ВремяОкончанияРабочегоДня, ШаблонВремениСуток);

    // 6.3 (продолжение). Заполнение колонок "День" и "МассивПортфелей" в таблице свода.
    //      Момент для вызова ПолучитьПортфелиДляСохраненияВыполненияВПлане: дата из параметра День и время суток
    //      из родительской операции либо, при отсутствии родителя, окончание рабочего дня (типовая логика плана).
    Для Каждого СтрокаСвода Из ТЗСвод Цикл

        СтрокаСвода.МассивПортфелей = Новый Массив;

        Если ЗначениеЗаполнено(СтрокаСвода.Родитель) Тогда
            СтрокаСвода.День = Дата(ЧастьДатыДня + Формат(СтрокаСвода.Родитель.ВремяРеглОпераций, ШаблонВремениСуток));
        Иначе
            СтрокаСвода.День = Дата(ЧастьДатыДня + ЧастьВремениОкончанияДня);
        КонецЕсли;

    КонецЦикла;

    Для Каждого СтрокаПортфеля Из ТЗПортфелиПоСтрокамСвода Цикл

        ИндексСтрокиТз = СоответствиеНомерСтрокиВИндекс.Получить(СтрокаПортфеля.НомерСтрокиСвода);
        Если ИндексСтрокиТз <> Неопределено Тогда
            ТЗСвод[ИндексСтрокиТз].МассивПортфелей.Добавить(СтрокаПортфеля.Портфель);
        КонецЕсли;

    КонецЦикла;

    // 6.4. Корректировка колонки "Выполнять" плана по каждой строке свода (итерация по ТЗСвод).
    //
    //      Назначение:
    //          Для текущего вида операции и списка портфелей, которые нужно оставить в плане
    //          (ПолучитьПортфелиДляСохраненияВыполненияВПлане), снимается признак выполнения
    //          только у строк с Выполнять = 1, совпадающим ВидОперации и портфелем вне списка "оставить".
    //
    //      Пакет запроса (один текст на все итерации цикла):
    //          1) ВТ_ИсходныйПлан - снимок &ТаблицаПлана;
    //          2) ВТ_Портфели - ссылки из &МассивПортфелейОставить;
    //          3) результирующий ВЫБРАТЬ: ВТ_ИсходныйПлан ЛЕВОЕ ВТ_Портфели по Портфель,
    //             пересчет Выполнять в одном ВЫБОР без промежуточной ВТ плана.
    //
    //      Параметризация и производительность:
    //          Создается один объект Запрос; в цикле задаются только ВидОперацииСвода и МассивПортфелейОставить.
    //          Табличный параметр - копия плана (НоваяТаблицаПлана), в цикле подменяется результатом Выполнить().
    //          Табличный параметр используется только в первом подзапросе пакета; при каждом Выполнить()
    //          временные таблицы пересоздаются заново.
    ЗапросКорректировки = Новый Запрос;
    ЗапросКорректировки.Текст =
    "ВЫБРАТЬ
    |    План.Портфель КАК Портфель,
    |    План.Выполнять КАК Выполнять,
    |    План.ВидОперации КАК ВидОперации,
    |    План.ВремяРеглОпераций КАК ВремяРеглОпераций,
    |    План.Родитель КАК Родитель
    |ПОМЕСТИТЬ ВТ_ИсходныйПлан
    |ИЗ
    |    &ТаблицаПлана КАК План
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    Портфели.Ссылка КАК Ссылка
    |ПОМЕСТИТЬ ВТ_Портфели
    |ИЗ
    |    Справочник.Портфели КАК Портфели
    |ГДЕ
    |    Портфели.Ссылка В (&МассивПортфелейОставить)
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    П1.Портфель КАК Портфель,
    |    ВЫБОР
    |        КОГДА П1.Выполнять = 1
    |            И П1.ВидОперации = &ВидОперацииСвода
    |            И ПортфелиОставить.Ссылка ЕСТЬ NULL
    |        ТОГДА 0
    |        ИНАЧЕ П1.Выполнять
    |    КОНЕЦ КАК Выполнять,
    |    П1.ВидОперации КАК ВидОперации,
    |    П1.ВремяРеглОпераций КАК ВремяРеглОпераций,
    |    П1.Родитель КАК Родитель
    |ИЗ
    |    ВТ_ИсходныйПлан КАК П1
    |        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Портфели КАК ПортфелиОставить
    |        ПО П1.Портфель = ПортфелиОставить.Ссылка";

    НоваяТаблицаПлана = тПланРеглОперацийПоДням.Скопировать();

    Для Каждого СтрокаСвода Из ТЗСвод Цикл

        МассивПортфелейОставитьВПлане = ПолучитьПортфелиДляСохраненияВыполненияВПлане(
            СтрокаСвода.МассивПортфелей,
            СтрокаСвода.День,
            СтрокаСвода.ВидОперации);

        ЗапросКорректировки.УстановитьПараметр("ТаблицаПлана", НоваяТаблицаПлана);
        ЗапросКорректировки.УстановитьПараметр("ВидОперацииСвода", СтрокаСвода.ВидОперации);
        ЗапросКорректировки.УстановитьПараметр("МассивПортфелейОставить", МассивПортфелейОставитьВПлане);

        НоваяТаблицаПлана = ЗапросКорректировки.Выполнить().Выгрузить();

    КонецЦикла;

    // 6.4 (продолжение). Запись итогового буфера в таблицу плана вызывающего кода (тот же экземпляр по ссылке).
    //      В описании объекта ТаблицаЗначений нет метода Загрузить(Источник): Очистить и строки с ЗаполнитьЗначенияСвойств.
    //      Присваивание "тПланРеглОперацийПоДням = НоваяТаблицаПлана" не подходит для параметра процедуры.
    тПланРеглОперацийПоДням.Очистить();
    Для Каждого СтрокаНовая Из НоваяТаблицаПлана Цикл
        СтрокаПриемник = тПланРеглОперацийПоДням.Добавить();
        ЗаполнитьЗначенияСвойств(СтрокаПриемник, СтрокаНовая);
    КонецЦикла;

КонецПроцедуры
