// Черновик для переноса в модуль менеджера РС ВидыОптимизируемыхРегламентныхОперацийДУ (расширение).
// Контракт: см. imdev8641_development_brief.md,
// query_branch_nachislenie_procentov_bank_accounts.md,
// query_branch_perevod_nkd_emitenta_bu.md

// Возвращает массив портфелей, для которых нужно оставить выполнение операции в плане регламентных операций
// для поддерживаемых видов: начисление процентов по счетам и депозитам, перевод НКД эмитента (БУ),
// определение сделок с отклонением цен (БУ), погашение облигаций до переоценки (БУ),
// частичное погашение облигаций (БУ) — см. ветки ниже.
//
// Параметры:
//   МассивПортфелей - Массив из СправочникСсылка.Портфели
//   День            - Дата
//   ВидОперации     - СправочникСсылка.ВидыОперацийЗакрытияПериода
//
// Возвращаемое значение:
//   Массив - портфели, для которых следует оставить Выполнять = 1;
//            для иного вида операции - тот же МассивПортфелей, что на входе.
//
Функция ПолучитьПортфелиДляСохраненияВыполненияВПлане(МассивПортфелей, День, ВидОперации) Экспорт

    Если Не ЗначениеЗаполнено(МассивПортфелей) Тогда
        Возврат Новый Массив;
    ИначеЕсли ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.НачислениеПроцентовПоБанковскимСчетамПоГрафику Тогда
        Возврат ПортфелиДляНачисленияПроцентовПоБанковскимСчетамИДепозитам(МассивПортфелей, День);
    ИначеЕсли ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.ПереводНКДЭмитента_БУ Тогда
        Возврат ПортфелиДляПереводаНКДЭмитентаБу(МассивПортфелей, День);
    ИначеЕсли ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.ОпределениеСделокСОтклонениемЦен_БУ Тогда
        Возврат ПортфелиДляОпределенияСделокСОтклонениемЦенБу(МассивПортфелей, День);
    ИначеЕсли ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.ПогашениеОблигаций_БУ_ДоПереоценки Тогда
        Возврат ПортфелиДляПогашенияОблигацийБуДоПереоценки(МассивПортфелей, День);
    ИначеЕсли ВидОперации = Справочники.ВидыОперацийЗакрытияПериода.ЧастичноеПогашениеОблигаций_БУ Тогда
        Возврат ПортфелиДляЧастичногоПогашенияОблигацийБу(МассивПортфелей, День);
    Иначе
        // Для остальных видов возвращаем входной массив без изменений
        Возврат МассивПортфелей;
    КонецЕсли;

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Описание: Выполняет один пакетный запрос для отбора портфелей, по которым с высокой вероятностью
// понадобится выполнять начисление процентов по банковским счетам по графику (банковские счета и депозиты ЕПС).
// Запросы намеренно широкие: фиксируется минимальное основание подозревать, что расчёт по портфелю
// может понадобиться, а не полная эквивалентность всем проверкам типовой регламентной операции.
//
// Параметры:
// МассивПортфелей - Массив из СправочникСсылка.Портфели
// День - Дата
//
// Возвращаемое значение:
// Массив из СправочникСсылка.Портфели - портфели с таким основанием (подмножество входа или пустой массив)
//
Функция ПортфелиДляНачисленияПроцентовПоБанковскимСчетамИДепозитам(МассивПортфелей, День)

    ТекстЗапроса =
    "// 1. Банковские счета с признаком НачислениеПроцентов (БУ, ЕПС, УУ)
    |ВЫБРАТЬ
    |   Т.Портфель КАК Портфель
    |ПОМЕСТИТЬ ВТ_ПортфелиПоБанковскимСчетам
    |ИЗ
    |   (ВЫБРАТЬ
    |       Т.Портфель КАК Портфель,
    |       Т.Субконто1 КАК БанковскийСчет
    |   ИЗ
    |       РегистрБухгалтерии.Хозрасчетный.Обороты(
    |           &ДатаН, &ДатаК, Период,
    |           Счет В (&СчетаОстатков),
    |           &ВидыСубконтоХозрасчетные,
    |           Портфель В (&МассивПортфелей),
    |           ,
    |           ) КАК Т
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       Т.Портфель КАК Портфель,
    |       Т.Субконто1 КАК БанковскийСчет
    |   ИЗ
    |       РегистрБухгалтерии.Хозрасчетный.Остатки(
    |           &ДатаК,
    |           Счет В (&СчетаОстатков),
    |           &ВидыСубконтоХозрасчетные,
    |           Портфель В (&МассивПортфелей)
    |           ) КАК Т
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       Т.Портфель КАК Портфель,
    |       Т.Субконто1 КАК БанковскийСчет
    |   ИЗ
    |       РегистрБухгалтерии.ЕПС.Обороты(
    |           &ДатаН, &ДатаК, Период,
    |           Счет В (&СчетаОстатковЕПС),
    |           &ВидыСубконтоЕПС,
    |           Портфель В (&МассивПортфелей),
    |           ,
    |           ) КАК Т
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       Т.Портфель КАК Портфель,
    |       Т.Субконто1 КАК БанковскийСчет
    |   ИЗ
    |       РегистрБухгалтерии.ЕПС.Остатки(
    |           &ДатаК,
    |           Счет В (&СчетаОстатковЕПС),
    |           &ВидыСубконтоЕПС,
    |           Портфель В (&МассивПортфелей)
    |           ) КАК Т
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       Т.Портфель КАК Портфель,
    |       Т.МестоХранения КАК БанковскийСчет
    |   ИЗ
    |       РегистрНакопления.ДенежныеСредстваУправленческий.Обороты(
    |           &ДатаН, &ДатаК, ,
    |           Портфель В (&МассивПортфелей)
    |           ) КАК Т
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       Т.Портфель КАК Портфель,
    |       Т.МестоХранения КАК БанковскийСчет
    |   ИЗ
    |       РегистрНакопления.ДенежныеСредстваУправленческий.Остатки(
    |           &ДатаК,
    |           Портфель В (&МассивПортфелей)
    |           ) КАК Т
    |   ) КАК Т
    |ГДЕ
    |   ВЫРАЗИТЬ(Т.БанковскийСчет КАК Справочник.БанковскиеСчета).НачислениеПроцентов = ИСТИНА
    |
    |СГРУППИРОВАТЬ ПО
    |   Т.Портфель
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |// 2. Депозитные сделки (ЕПС): ОБЪЕДИНИТЬ ВСЕ (во внутреннем запросе — Портфель и Субконто1), уникальные портфели через РАЗЛИЧНЫЕ
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Вложенный.Портфель КАК Портфель
    |ПОМЕСТИТЬ ВТ_ПортфелиПоДепозитам
    |ИЗ
    |   (ВЫБРАТЬ
    |       ЕПСОбороты.Портфель КАК Портфель,
    |       ЕПСОбороты.Субконто1 КАК Субконто1
    |   ИЗ
    |       РегистрБухгалтерии.ЕПС.Обороты(
    |           &ДатаН, &ДатаК, Период,
    |           Счет В (&СчетаУчета), ,
    |           Портфель В (&МассивПортфелей), , ) КАК ЕПСОбороты
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       ЕПСОстатки.Портфель КАК Портфель,
    |       ЕПСОстатки.Субконто1 КАК Субконто1
    |   ИЗ
    |       РегистрБухгалтерии.ЕПС.Остатки(
    |           &ДатаОкончанияГраница,
    |           Счет В (&СчетаУчета), ,
    |           Портфель В (&МассивПортфелей)) КАК ЕПСОстатки) КАК Вложенный
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |// 3. Итоговое объединение (логическое ИЛИ)
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Т.Портфель КАК Портфель
    |ИЗ
    |   (ВЫБРАТЬ
    |       Портфель
    |   ИЗ
    |       ВТ_ПортфелиПоБанковскимСчетам
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       Портфель
    |   ИЗ
    |       ВТ_ПортфелиПоДепозитам) КАК Т";

    // ===================== Параметры =====================
    ДатаН = НачалоДня(День);
    ДатаК = КонецДня(День);

    МассивСчетов = Новый Массив;
    МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.РасчетныеСчета);
    МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.РасчетныеСчета_СделкиМНО);
    МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ТекущиеСчета);
    МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ТекущиеСчета_СделкиМНО);
    МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ДепозитныеСчетаВВалюте);
    МассивСчетов.Добавить(ПланыСчетов.Хозрасчетный.ДепозитныеСчетаВРублях);

    МассивВидовСубконтоХоз = Новый Массив;
    МассивВидовСубконтоХоз.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.БанковскиеСчета);

    МассивВидовСубконтоЕПС = Новый Массив;
    МассивВидовСубконтоЕПС.Добавить(ПланыВидовХарактеристик.ВидыСубконтоЕПС.БанковскиеСчета);

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапроса;

    Запрос.УстановитьПараметр("МассивПортфелей", МассивПортфелей);
    Запрос.УстановитьПараметр("ДатаН", ДатаН);
    Запрос.УстановитьПараметр("ДатаК", ДатаК);
    Запрос.УстановитьПараметр("ДатаОкончанияГраница", Новый Граница(ДатаК, ВидГраницы.Включая));
    Запрос.УстановитьПараметр("СчетаОстатков", МассивСчетов);
    Запрос.УстановитьПараметр("СчетаОстатковЕПС", ПланыСчетов.ЕПС.ВсеСчетаОстатковПоДепозитам());
    Запрос.УстановитьПараметр("ВидыСубконтоХозрасчетные", МассивВидовСубконтоХоз);
    Запрос.УстановитьПараметр("ВидыСубконтоЕПС", МассивВидовСубконтоЕПС);
    Запрос.УстановитьПараметр("СчетаУчета", ПланыСчетов.ЕПС.СчетаПоСтроке("20601.02, 20602.02, 20601.05"));

    Результат = Запрос.Выполнить();

    Если Результат.Пустой() Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Возврат Результат.Выгрузить().ВыгрузитьКолонку("Портфель");

КонецФункции

// Описание: По документам Сделка за операционный день определяет портфели, для которых с высокой вероятностью
// понадобится выполнять операцию закрытия периода с видом ОпределениеСделокСОтклонениемЦен_БУ
// (типовая Операция_0140_ОпределениеСделокСОтклонениемЦен). Достаточно факта наличия хотя бы одной
// проведённой сделки по портфелю в интервале суток — это минимальное основание подозревать необходимость
// проверки отклонений цен; детальный отбор по видам операций, активам и номиналу в типовом коде не повторяется.
// Используется при фильтрации плана регламентных операций аналогично другим веткам модуля.
//
// Параметры:
// МассивПортфелей - Массив из СправочникСсылка.Портфели - портфели из строк плана по данному виду операции
// День            - Дата - календарный день (в запросе — НачалоДня и КонецДня)
//
// Возвращаемое значение:
// Массив из СправочникСсылка.Портфели - портфели, по которым найдены проведённые сделки за день (подмножество
//     входа или пустой массив)
//
// Пример:
// ПортфелиОставить = ПортфелиДляОпределенияСделокСОтклонениемЦенБу(МассивПортфелейИзПлана, ДатаЗакрытия);
//
Функция ПортфелиДляОпределенияСделокСОтклонениемЦенБу(МассивПортфелей, День)

    ТекстЗапроса =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Сделка.Портфель КАК Портфель
    |ИЗ
    |   Документ.Сделка КАК Сделка
    |ГДЕ
    |   Сделка.Дата МЕЖДУ &НачалоДня И &КонецДня
    |   И Сделка.Портфель В (&МассивПортфелей)
    |   И Сделка.Проведен";

    ДатаН = НачалоДня(День);
    ДатаК = КонецДня(День);

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапроса;
    Запрос.УстановитьПараметр("МассивПортфелей", МассивПортфелей);
    Запрос.УстановитьПараметр("НачалоДня", ДатаН);
    Запрос.УстановитьПараметр("КонецДня", ДатаК);

    Результат = Запрос.Выполнить();

    Если Результат.Пустой() Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Возврат Результат.Выгрузить().ВыгрузитьКолонку("Портфель");

КонецФункции

// Описание: По остаткам регистра бухгалтерии Хозрасчетный на счёте «Облигации (тело)» на начало дня
// определяет портфели, для которых с высокой вероятностью понадобится операция закрытия периода с видом
// ПогашениеОблигаций_БУ_ДоПереоценки (типовая Операция_0058_ПогашениеОблигаций_ДоПереоценки).
// Критерий: положительный остаток по сумме Дт (БУ) по субконто «облигация», связь с Активы по объекту,
// и дата полного погашения облигации совпадает с датой среза остатков (параметр &Период).
// Справочно: в типовом коде перед заполнением документа часто стоит ранний выход, если
// Не Справочники.Облигации.ЕстьОблигацииКПогашениюПоДате(Дата,,,Портфель) — условие
// ЕстьСПолнымПогашением в запросе согласовано с идеей «есть облигации к погашению на дату»,
// но функцию в пакете не вызывает и не заменяет её полностью (см. реализацию ЕстьОблигацииКПогашениюПоДате).
// Не эквивалентен полной логике документа ПогашениеОблигаций (ЕПС, прочие проверки).
//
// Параметры:
// МассивПортфелей - Массив из СправочникСсылка.Портфели - портфели из строк плана по данному виду операции
// День            - Дата - дата среза остатков (в запросе — НачалоДня, как в типовом &Период)
//
// Возвращаемое значение:
// Массив из СправочникСсылка.Портфели - портфели с найденными остатками (подмножество входа или пустой массив)
//
// Пример:
// ПортфелиОставить = ПортфелиДляПогашенияОблигацийБуДоПереоценки(МассивПортфелейИзПлана, ДатаЗакрытия);
//
Функция ПортфелиДляПогашенияОблигацийБуДоПереоценки(МассивПортфелей, День)

    ТекстЗапроса =
    "ВЫБРАТЬ
    |   ХозрасчетныйОстатки.Портфель КАК Портфель,
    |   ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.Облигации) КАК Облигация,
    |   ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.Облигации).ДатаПогашения КАК ДатаПогашения,
    |   &Период = ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.Облигации).ДатаПогашения КАК ЕстьСПолнымПогашением
    |ПОМЕСТИТЬ Остатки_БУ
    |ИЗ
    |   РегистрБухгалтерии.Хозрасчетный.Остатки(
    |       &Период,
    |       Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОблигацииТело),
    |       ,
    |       Портфель В (&МассивПортфелей)) КАК ХозрасчетныйОстатки
    |ГДЕ
    |   ХозрасчетныйОстатки.СуммаОстатокДт > 0
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   Облигация
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Остатки_БУ.Портфель КАК Портфель
    |ИЗ
    |   Остатки_БУ КАК Остатки_БУ
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
    |       ПО Остатки_БУ.Облигация = Активы.Объект
    |           И Остатки_БУ.ЕстьСПолнымПогашением";

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапроса;
    Запрос.УстановитьПараметр("МассивПортфелей", МассивПортфелей);
    Запрос.УстановитьПараметр("Период", НачалоДня(День));

    Результат = Запрос.Выполнить();

    Если Результат.Пустой() Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Возврат Результат.Выгрузить().ВыгрузитьКолонку("Портфель");

КонецФункции

// Описание: Для операции закрытия периода с видом ЧастичноеПогашениеОблигаций_БУ (типовая ветка 0058)
// отбирает портфели, по которым одновременно выполняются два условия из типовой цепочки: есть остатки
// по счёту «Облигации (тело)» на начало дня (связь с Активы) и в таблице амортизации, возвращаемой
// Справочники.Облигации.ПолучитьДанныеАмортизации, есть строки с положительным остатком номинала.
// Список активов для амортизации формируется по остаткам в разрезе входных портфелей (как СписокАктивовПоОстаткам
// в типовом коде «по конкретным портфелям»), без вызова ЗаполнитьЦенныеБумагиЧастичноеПогашение и без отбора
// облигаций дефолтных эмитентов — это уже логика заполнения документа, а не минимального признака для плана.
//
// Параметры:
// МассивПортфелей - Массив из СправочникСсылка.Портфели - портфели из строк плана по данному виду операции
// День            - Дата - дата среза остатков и дата расчёта амортизации
//
// Возвращаемое значение:
// Массив из СправочникСсылка.Портфели - портфели, для которых найдены и остатки, и строки амортизации с
//     ОстатокНоминала > 0 (подмножество входа или пустой массив)
//
// Пример:
// ПортфелиОставить = ПортфелиДляЧастичногоПогашенияОблигацийБу(МассивПортфелейИзПлана, ДатаЗакрытия);
//
Функция ПортфелиДляЧастичногоПогашенияОблигацийБу(МассивПортфелей, День)

    ТекстЗапросаОстатки =
    "ВЫБРАТЬ
    |   ХозрасчетныйОстатки.Портфель КАК Портфель,
    |   ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.Облигации) КАК Облигация
    |ПОМЕСТИТЬ Остатки_БУ
    |ИЗ
    |   РегистрБухгалтерии.Хозрасчетный.Остатки(
    |       &Период,
    |       Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОблигацииТело),
    |       ,
    |       Портфель В (&МассивПортфелей)) КАК ХозрасчетныйОстатки
    |ГДЕ
    |   ХозрасчетныйОстатки.СуммаОстатокДт > 0
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   Облигация
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Остатки_БУ.Портфель КАК Портфель,
    |   Активы.Ссылка КАК Актив
    |ПОМЕСТИТЬ ВТ_ПортфельАктивПоОстаткам
    |ИЗ
    |   Остатки_БУ КАК Остатки_БУ
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
    |       ПО Остатки_БУ.Облигация = Активы.Объект
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ВТ_ПортфельАктивПоОстаткам.Портфель КАК Портфель,
    |   ВТ_ПортфельАктивПоОстаткам.Актив КАК Актив
    |ИЗ
    |   ВТ_ПортфельАктивПоОстаткам КАК ВТ_ПортфельАктивПоОстаткам";

    ЗапросОстатки = Новый Запрос;
    ЗапросОстатки.Текст = ТекстЗапросаОстатки;
    ЗапросОстатки.УстановитьПараметр("МассивПортфелей", МассивПортфелей);
    ЗапросОстатки.УстановитьПараметр("Период", НачалоДня(День));

    ТаблицаПортфельАктив = ЗапросОстатки.Выполнить().Выгрузить();

    Если ТаблицаПортфельАктив.Количество() = 0 Тогда
        Возврат Новый Массив;
    КонецЕсли;

    МассивАктивов = Новый Массив;
    УжеДобавленныеАктивы = Новый Соответствие;

    Для Каждого СтрокаПортфельАктив Из ТаблицаПортфельАктив Цикл

        Если УжеДобавленныеАктивы.Получить(СтрокаПортфельАктив.Актив) = Неопределено Тогда
            УжеДобавленныеАктивы.Вставить(СтрокаПортфельАктив.Актив, Истина);
            МассивАктивов.Добавить(СтрокаПортфельАктив.Актив);
        КонецЕсли;

    КонецЦикла;

    ТаблицаАмортизации = Справочники.Облигации.ПолучитьДанныеАмортизации(МассивАктивов, День, Истина);

    Если ТаблицаАмортизации = Неопределено Или ТаблицаАмортизации.Количество() = 0 Тогда
        Возврат Новый Массив;
    КонецЕсли;

    ТекстЗапросаАмортизация =
    "ВЫБРАТЬ
    |   ТаблицаПортфельАктив.Портфель КАК Портфель,
    |   ТаблицаПортфельАктив.Актив КАК Актив
    |ПОМЕСТИТЬ ВТ_ПортфельАктив
    |ИЗ
    |   &ТаблицаПортфельАктив КАК ТаблицаПортфельАктив
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   Актив
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ТаблицаАмортизации.Облигация КАК Облигация,
    |   ТаблицаАмортизации.НоминальнаяСтоимость КАК НоминальнаяСтоимость,
    |   ТаблицаАмортизации.ПроцентНоминала КАК ПроцентНоминала,
    |   ТаблицаАмортизации.СуммаПогашения КАК СуммаПогашения,
    |   ТаблицаАмортизации.ОстатокНоминала КАК ОстатокНоминала,
    |   ТаблицаАмортизации.КоэффициентАмортизации КАК КоэффициентАмортизации,
    |   ТаблицаАмортизации.Эмитент КАК Эмитент,
    |   ТаблицаАмортизации.Актив КАК Актив
    |ПОМЕСТИТЬ ВТ_АмортизацияТекущегоДня
    |ИЗ
    |   &ТаблицаАмортизации КАК ТаблицаАмортизации
    |ГДЕ
    |   ТаблицаАмортизации.ОстатокНоминала > 0
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   Актив
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Соответствие.Портфель КАК Портфель
    |ИЗ
    |   ВТ_АмортизацияТекущегоДня КАК АмортизацияТекущегоДня
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПортфельАктив КАК Соответствие
    |       ПО АмортизацияТекущегоДня.Актив = Соответствие.Актив";

    ЗапросАмортизация = Новый Запрос;
    ЗапросАмортизация.Текст = ТекстЗапросаАмортизация;
    ЗапросАмортизация.УстановитьПараметр("ТаблицаАмортизации", ТаблицаАмортизации);
    ЗапросАмортизация.УстановитьПараметр("ТаблицаПортфельАктив", ТаблицаПортфельАктив);

    Результат = ЗапросАмортизация.Выполнить();

    Если Результат.Пустой() Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Возврат Результат.Выгрузить().ВыгрузитьКолонку("Портфель");

КонецФункции

// Описание: По данным РСБУ определяет портфели, для которых с высокой вероятностью потребуется
// выполнять операцию закрытия периода с видом ПереводНКДЭмитента_БУ (погашение НКД в задолженность
// эмитента по бухгалтерскому учёту). Используется при фильтрации плана регламентных операций:
// по возвращённым портфелям признак Выполнять в плане оставляют, по остальным из того же вида — снимают.
// Один пакетный запрос объединяет четыре независимых критерия из типовой логики Документ.ПереводНКД
// (истекшие купоны и оферты, непогашенные купоны по НКД, структурные ноты, старые купоны по УКД);
// критерии связаны по портфелю логическим ИЛИ. Запросы намеренно широкие: фиксируется минимальное
// основание подозревать необходимость расчёта, а не полное совпадение со всеми проверками типовой операции.
// Подробнее о составе блоков и источниках — query_branch_perevod_nkd_emitenta_bu.md.
//
// Параметры:
// МассивПортфелей - Массив из СправочникСсылка.Портфели - портфели из строк плана по данному виду операции
// День            - Дата - операционный день (границы срезов в запросе задаются от него, см. параметры запроса)
//
// Возвращаемое значение:
// Массив из СправочникСсылка.Портфели - подмножество входного массива, по которым расчёт по смыслу ветки
//     оставляют в плане; пустой массив, если ни один портфель не прошёл объединённый критерий
//
// Пример:
// ПортфелиОставить = ПортфелиДляПереводаНКДЭмитентаБу(МассивПортфелейИзПлана, ДатаЗакрытия);
//
Функция ПортфелиДляПереводаНКДЭмитентаБу(МассивПортфелей, День)

    ТекстЗапроса =
    "// 1. Истекшие купоны / оферты (ЗаполнитьИстекшимиКупоннымиПериодамиРСБУ)
    |ВЫБРАТЬ
    |   ОстаткиОблигаций_БУ_НУ.Портфель КАК Портфель,
    |   ОстаткиОблигаций_БУ_НУ.Субконто1 КАК Облигация,
    |   Активы.Ссылка КАК Актив,
    |   ВЫБОР
    |       КОГДА ОстаткиОблигаций_БУ_НУ.СуммаОстаток > 0
    |               ИЛИ ОстаткиОблигаций_БУ_НУ.КоличествоОстаток > 0
    |           ТОГДА ИСТИНА
    |       ИНАЧЕ ЛОЖЬ
    |   КОНЕЦ КАК БУ,
    |   ВЫБОР
    |       КОГДА ОстаткиОблигаций_БУ_НУ.СуммаНУОстаток > 0
    |               ИЛИ ОстаткиОблигаций_БУ_НУ.КоличествоОстаток > 0
    |           ТОГДА ИСТИНА
    |       ИНАЧЕ ЛОЖЬ
    |   КОНЕЦ КАК НУ
    |ПОМЕСТИТЬ ВТ_НКД1_ОстаткиРСБУ
    |ИЗ
    |   РегистрБухгалтерии.Хозрасчетный.Остатки(&Дата, Счет = &СчетОблигаций, , Портфель В (&МассивПортфелей)) КАК ОстаткиОблигаций_БУ_НУ
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
    |       ПО ОстаткиОблигаций_БУ_НУ.Субконто1 = Активы.Объект
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   Актив
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ДатыОфертОблигаций.Период КАК Период,
    |   ДатыОфертОблигаций.Актив КАК Актив
    |ПОМЕСТИТЬ ВТ_НКД1_ДатыОфертОблигаций
    |ИЗ
    |   РегистрСведений.ДатыОфертОблигаций КАК ДатыОфертОблигаций
    |ГДЕ
    |   ДатыОфертОблигаций.ВидДаты = ЗНАЧЕНИЕ(Перечисление.ВидыДатОферты.ДатаОферты)
    |   И ДатыОфертОблигаций.Регистратор.ВидОферты В (ЗНАЧЕНИЕ(Перечисление.ВидыОферты.ДосрочноеПогашениеПоПравуЭмитента), ЗНАЧЕНИЕ(Перечисление.ВидыОферты.MCAL_BN))
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   Актив
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ВТ_НКД1_ОстаткиРСБУ.Портфель КАК Портфель,
    |   ВТ_НКД1_ОстаткиРСБУ.Облигация КАК Облигация,
    |   ВТ_НКД1_ОстаткиРСБУ.Актив КАК Актив,
    |   ВТ_НКД1_ОстаткиРСБУ.БУ КАК БУ,
    |   ВТ_НКД1_ОстаткиРСБУ.НУ КАК НУ,
    |   КупонныеПериоды.Ссылка КАК КупонныйПериод
    |ПОМЕСТИТЬ ВТ_НКД1_ПромежуточныйРезультат
    |ИЗ
    |   ВТ_НКД1_ОстаткиРСБУ КАК ВТ_НКД1_ОстаткиРСБУ
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КупонныеПериоды КАК КупонныеПериоды
    |       ПО ВТ_НКД1_ОстаткиРСБУ.Облигация = КупонныеПериоды.Владелец
    |ГДЕ
    |   НЕ КупонныеПериоды.ПометкаУдаления
    |   И (НАЧАЛОПЕРИОДА(КупонныеПериоды.ДатаОкончанияКупонногоПериода, ДЕНЬ) = &Дата
    |           ИЛИ КупонныеПериоды.ДатаОкончанияКупонногоПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
    |               И КупонныеПериоды.ДатаНачалаКупонногоПериода < &Дата)
    |   И (ВТ_НКД1_ОстаткиРСБУ.БУ = ИСТИНА
    |           ИЛИ ВТ_НКД1_ОстаткиРСБУ.НУ = ИСТИНА)
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |   ВТ_НКД1_ОстаткиРСБУ.Портфель,
    |   ВТ_НКД1_ОстаткиРСБУ.Облигация,
    |   ВТ_НКД1_ОстаткиРСБУ.Актив,
    |   ВТ_НКД1_ОстаткиРСБУ.БУ,
    |   ВТ_НКД1_ОстаткиРСБУ.НУ,
    |   КупонныеПериоды.Ссылка
    |ИЗ
    |   ВТ_НКД1_ДатыОфертОблигаций КАК ДатыОфертОблигаций
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НКД1_ОстаткиРСБУ КАК ВТ_НКД1_ОстаткиРСБУ
    |           ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КупонныеПериоды КАК КупонныеПериоды
    |           ПО ВТ_НКД1_ОстаткиРСБУ.Облигация = КупонныеПериоды.Владелец
    |       ПО ДатыОфертОблигаций.Актив = ВТ_НКД1_ОстаткиРСБУ.Актив
    |ГДЕ
    |   НЕ КупонныеПериоды.ПометкаУдаления
    |   И НАЧАЛОПЕРИОДА(КупонныеПериоды.ДатаОкончанияКупонногоПериода, ДЕНЬ) > &Дата
    |   И КупонныеПериоды.ДатаНачалаКупонногоПериода < &Дата
    |   И (ВТ_НКД1_ОстаткиРСБУ.БУ = ИСТИНА
    |           ИЛИ ВТ_НКД1_ОстаткиРСБУ.НУ = ИСТИНА)
    |   И НАЧАЛОПЕРИОДА(ДатыОфертОблигаций.Период, ДЕНЬ) = &Дата
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   ВТ_НКД1_ПромежуточныйРезультат.Портфель КАК Портфель
    |ПОМЕСТИТЬ ВТ_НКД1_Портфели
    |ИЗ
    |   ВТ_НКД1_ПромежуточныйРезультат КАК ВТ_НКД1_ПромежуточныйРезультат
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |// 2. Непогашенные купоны по НКД
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Вложенная.Портфель КАК Портфель
    |ПОМЕСТИТЬ ВТ_НКД2_Портфели
    |ИЗ
    |   (ВЫБРАТЬ
    |       НеПогашенныйКупон_РСБУ.Портфель КАК Портфель,
    |       ВЫБОР
    |           КОГДА НеПогашенныйКупон_РСБУ.СуммаОстаток > 0
    |               ТОГДА ИСТИНА
    |           ИНАЧЕ ЛОЖЬ
    |       КОНЕЦ КАК БУ,
    |       ВЫБОР
    |           КОГДА НеПогашенныйКупон_РСБУ.СуммаНУОстаток > 0
    |               ТОГДА ИСТИНА
    |           ИНАЧЕ ЛОЖЬ
    |       КОНЕЦ КАК НУ
    |   ИЗ
    |       РегистрБухгалтерии.Хозрасчетный.Остатки(&Дата, Счет В (&СчетаНКД), , Портфель В (&МассивПортфелей)) КАК НеПогашенныйКупон_РСБУ
    |           ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
    |           ПО НеПогашенныйКупон_РСБУ.Субконто1 = Активы.Объект
    |   ГДЕ
    |       (ВЫРАЗИТЬ(НеПогашенныйКупон_РСБУ.Субконто2 КАК Справочник.КупонныеПериоды).ДатаОкончанияКупонногоПериода < НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
    |               ИЛИ ВЫРАЗИТЬ(НеПогашенныйКупон_РСБУ.Субконто2 КАК Справочник.КупонныеПериоды).ДатаОкончанияКупонногоПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
    |                   И ВЫРАЗИТЬ(НеПогашенныйКупон_РСБУ.Субконто2 КАК Справочник.КупонныеПериоды).ДатаНачалаКупонногоПериода < НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ))) КАК Вложенная
    |ГДЕ
    |   Вложенная.БУ
    |       ИЛИ Вложенная.НУ
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |// 3. Структурные ноты
    |ВЫБРАТЬ
    |   ХозрасчетныйОстатки.Портфель КАК Портфель,
    |   ХозрасчетныйОстатки.Субконто1 КАК СтруктурнаяНота,
    |   Активы.Ссылка КАК Актив
    |ПОМЕСТИТЬ ВТ_НКД3_ОстаткиРСБУ
    |ИЗ
    |   РегистрБухгалтерии.Хозрасчетный.Остатки(&ДатаПолученияОстатков, Счет = &СчетУчетаСтруктурнаяНота, , Портфель В (&МассивПортфелей)) КАК ХозрасчетныйОстатки
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
    |       ПО ХозрасчетныйОстатки.Субконто1 = Активы.Объект
    |ГДЕ
    |   ХозрасчетныйОстатки.КоличествоОстаток > 0
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   Актив
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   КупонныеРасписанияСрезПоследних.Актив КАК Актив,
    |   КупонноеРасписаниеКупоны.РазмерДоходаВРублях КАК РазмерДоходаВРублях
    |ПОМЕСТИТЬ ВТ_НКД3_КупонныеПериодыСтруктурные
    |ИЗ
    |   Документ.КупонноеРасписание.Купоны КАК КупонноеРасписаниеКупоны
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КупонныеРасписания.СрезПоследних(&ДатаПолученияОстатков, ) КАК КупонныеРасписанияСрезПоследних
    |       ПО КупонноеРасписаниеКупоны.Ссылка = КупонныеРасписанияСрезПоследних.Документ
    |ГДЕ
    |   (НАЧАЛОПЕРИОДА(КупонноеРасписаниеКупоны.ДатаОкончанияКупонногоПериода, ДЕНЬ) = &Дата
    |           ИЛИ КупонноеРасписаниеКупоны.ДатаОкончанияКупонногоПериода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
    |               И КупонноеРасписаниеКупоны.ДатаНачалаКупонногоПериода < &Дата)
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   Актив
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   ВТ_НКД3_ОстаткиРСБУ.Портфель КАК Портфель
    |ПОМЕСТИТЬ ВТ_НКД3_Портфели
    |ИЗ
    |   ВТ_НКД3_ОстаткиРСБУ КАК ВТ_НКД3_ОстаткиРСБУ
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НКД3_КупонныеПериодыСтруктурные КАК ВТ_НКД3_КупонныеПериодыСтруктурные
    |       ПО ВТ_НКД3_ОстаткиРСБУ.Актив = ВТ_НКД3_КупонныеПериодыСтруктурные.Актив
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |// 4. Старые купоны по УКД
    |ВЫБРАТЬ
    |   ОстаткиУКД.Портфель КАК Портфель,
    |   ОстаткиУКД.Субконто1 КАК Облигация,
    |   ОстаткиУКД.Субконто2 КАК КупонныйПериод,
    |   Активы.Ссылка КАК Актив,
    |   ОстаткиУКД.СуммаОстаток КАК СуммаУКД
    |ПОМЕСТИТЬ ВТ_НКД4_ОстаткиРСБУУКД
    |ИЗ
    |   РегистрБухгалтерии.Хозрасчетный.Остатки(
    |           &Дата,
    |           Счет В (&СчетаУКД),
    |           ,
    |           Портфель В (&МассивПортфелей)) КАК ОстаткиУКД
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы
    |       ПО ОстаткиУКД.Субконто1 = Активы.Объект
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   КупонныйПериод
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   ВТ_НКД4_ОстаткиРСБУУКД.Портфель КАК Портфель
    |ПОМЕСТИТЬ ВТ_НКД4_Портфели
    |ИЗ
    |   ВТ_НКД4_ОстаткиРСБУУКД КАК ВТ_НКД4_ОстаткиРСБУУКД
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КупонныеПериоды КАК КупонныеПериоды
    |       ПО ВТ_НКД4_ОстаткиРСБУУКД.КупонныйПериод = КупонныеПериоды.Ссылка
    |ГДЕ
    |   НЕ КупонныеПериоды.ПометкаУдаления
    |   И КупонныеПериоды.ДатаОкончанияКупонногоПериода < &Дата
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |// Итог: объединение четырёх критериев (логическое ИЛИ)
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Объединение.Портфель КАК Портфель
    |ИЗ
    |   (ВЫБРАТЬ
    |       Портфель
    |   ИЗ
    |       ВТ_НКД1_Портфели
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       Портфель
    |   ИЗ
    |       ВТ_НКД2_Портфели
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       Портфель
    |   ИЗ
    |       ВТ_НКД3_Портфели
    |
    |   ОБЪЕДИНИТЬ ВСЕ
    |
    |   ВЫБРАТЬ
    |       Портфель
    |   ИЗ
    |       ВТ_НКД4_Портфели) КАК Объединение";

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапроса;

    ДатаСреза = НачалоДня(День);

    СчетаНКД = Новый Массив;
    СчетаНКД.Добавить(ПланыСчетов.Хозрасчетный.НачисленныйНКД);
    СчетаНКД.Добавить(ПланыСчетов.Хозрасчетный.НачисленныйНКД_58);
    СчетаНКД.Добавить(ПланыСчетов.Хозрасчетный.УплаченныйНКД_58);
    СчетаНКД.Добавить(ПланыСчетов.Хозрасчетный.УплаченныйНКД);

    СчетаУКД = Новый Массив;
    СчетаУКД.Добавить(ПланыСчетов.Хозрасчетный.УплаченныйНКД_58);
    СчетаУКД.Добавить(ПланыСчетов.Хозрасчетный.УплаченныйНКД);

    Запрос.УстановитьПараметр("МассивПортфелей", МассивПортфелей);
    Запрос.УстановитьПараметр("Дата", ДатаСреза);
    Запрос.УстановитьПараметр("ДатаПолученияОстатков", День);
    Запрос.УстановитьПараметр("СчетОблигаций", ПланыСчетов.Хозрасчетный.ОблигацииТело);
    Запрос.УстановитьПараметр("СчетУчетаСтруктурнаяНота", ПланыСчетов.Хозрасчетный.СтоимостьСтруктурнойНоты);
    Запрос.УстановитьПараметр("СчетаНКД", СчетаНКД);
    Запрос.УстановитьПараметр("СчетаУКД", СчетаУКД);

    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат Новый Массив;
    КонецЕсли;

    Возврат Результат.Выгрузить().ВыгрузитьКолонку("Портфель");

КонецФункции

#КонецОбласти
