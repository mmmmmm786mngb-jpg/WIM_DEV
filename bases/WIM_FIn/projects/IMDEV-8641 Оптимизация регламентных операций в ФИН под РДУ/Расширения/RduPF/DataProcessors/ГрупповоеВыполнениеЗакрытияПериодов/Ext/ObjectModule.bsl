
// Описание: Перехват &ИзменениеИКонтроль процедуры ВыполнитьМногопоточноеЗакрытиеПериодовПортфелей (IMDEV-8641).
// Тело совпадает с типовой реализацией; между расчётом плана и помещением в соответствие — маркер вставки для фильтрации плана.
//
// Параметры:
// ОжидатьЗавершения - Булево - передать в менеджер исполнителей при ожидании завершения;
// ДопПараметры - Структура, Неопределено - дополнительные параметры закрытия (как в типовой процедуре).
//
&ИзменениеИКонтроль("ВыполнитьМногопоточноеЗакрытиеПериодовПортфелей")
Процедура RduPF_ВыполнитьМногопоточноеЗакрытиеПериодовПортфелей(ОжидатьЗавершения = Ложь, ДопПараметры = Неопределено) Экспорт
	 
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;		
		ДопПараметры.Вставить("ИнтерактивныйЗапуск", Истина);
	КонецЕсли; 
	
	Если НЕ ДопПараметры.Свойство("НомерСеанса") Тогда
		ДопПараметры.Вставить("НомерСеанса", НомерСеансаИнформационнойБазы());
	КонецЕсли;

	Если НЕ ДопПараметры.Свойство("ИмяПользователя") Тогда
		ТекущийСеанс = ПолучитьТекущийСеансИнформационнойБазы();
		ИмяПользователя = ?(ТипЗнч(ТекущийСеанс.Пользователь) = Тип("ПользовательИнформационнойБазы"), ТекущийСеанс.Пользователь.Имя, "Пользователь не определен");
		ДопПараметры.Вставить("ИмяПользователя", ИмяПользователя);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("НастройкаРегулярногоЗакрытия") И ЗначениеЗаполнено(ДопПараметры.НастройкаРегулярногоЗакрытия) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДопПараметры.НастройкаРегулярногоЗакрытия, "ПаузаПовтора, КоличествоПортфелейНаПоток");
		ПаузаПовтора = ЗначенияРеквизитов.ПаузаПовтора;	
		КоличествоПортфелейНаПоток = ЗначенияРеквизитов.КоличествоПортфелейНаПоток;
		ДопПараметры.Вставить("ИнтерактивныйЗапуск", Ложь);

	КонецЕсли;
	
	ДопПараметры.Вставить("ГруппаОперацийПользователя", ГруппаОперацийПользователя);
	ДопПараметры.Вставить("ПаузаПовтора", ПаузаПовтора);
	ДопПараметры.Вставить("КоличествоПортфелейНаПоток", КоличествоПортфелейНаПоток);
	ДопПараметры.Вставить("GUIDМенеджераПотоков", Строка(Новый УникальныйИдентификатор)); 
	ДопПараметры.Вставить("ПропуститьПроверкуАктивностиРегламента", АванкорСерверПовтИсп.ЗначениеКонстанты("ПропуститьПроверкуАктивностиРегламента"));
	
	ТаблицаПериодов = ЭтотОбъект.ПериодыПортфелей.Выгрузить(,"РеглПериод, Портфель");
	
	ПланРеглОперацийПоДням = Новый Соответствие;
	
	ТаблицаДней = ЭтотОбъект.ПериодыПортфелей.Выгрузить(, "День");
	ТаблицаДней.Свернуть("День");
	
	Для Каждого СтрокаДня Из ТаблицаДней Цикл
		
		День = СтрокаДня.День;
		
		ОтборПоДню = Новый Структура("День", День);
		ТаблицаПортфелейЗаДень = ЭтотОбъект.ПериодыПортфелей.Выгрузить(ОтборПоДню, "Портфель");
		МассивПортфелейЗаДень = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТаблицаПортфелейЗаДень.ВыгрузитьКолонку("Портфель"));
		
		тПланРеглОперацийПоДням = РегистрыСведений.НастройкиЗакрытияПериода.ПланРеглОпераций(День,
																							МассивПортфелейЗаДень,
																							Неопределено);
		
		#Вставка
		// IMDEV-8641: фильтрация тПланРеглОперацийПоДням (РС ВидыОптимизируемыхРегламентныхОперацийДУ) — подключить на этапе внедрения РС.
		#КонецВставки
		
		ПланРеглОперацийПоДням.Вставить(День, тПланРеглОперацийПоДням);
		
	КонецЦикла;
	
	ДопПараметры.Вставить("ПланРеглОперацийПоДням", ПланРеглОперацийПоДням);
	
	РегистрыСведений.ОчередьЗакрытияПериода.ДобавитьПортфелиВОчередь(ТаблицаПериодов, ДопПараметры);
	ЗаполнитьДокументыЗакрытияПериодовДляМногопоточногоРежима(ДопПараметры);
	РегистрыСведений.ИсполнителиЗакрытияПериодов.СоздатьМенеджерИсполнителей(ДопПараметры, ОжидатьЗавершения);
			
КонецПроцедуры
