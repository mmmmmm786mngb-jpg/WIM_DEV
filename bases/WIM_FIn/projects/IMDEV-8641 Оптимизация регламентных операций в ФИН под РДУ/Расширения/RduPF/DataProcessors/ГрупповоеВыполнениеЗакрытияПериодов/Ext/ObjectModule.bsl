
// Описание: Перехват &ИзменениеИКонтроль процедуры ВыполнитьМногопоточноеЗакрытиеПериодовПортфелей (IMDEV-8641).
// Тело совпадает с типовой реализацией; между расчётом плана и помещением в соответствие — вызов фильтра плана (модуль менеджера РС ВидыОптимизируемыхРегламентныхОперацийДУ).
//
// Параметры:
// ОжидатьЗавершения - Булево - передать в менеджер исполнителей при ожидании завершения;
// ДопПараметры - Структура, Неопределено - дополнительные параметры закрытия (как в типовой процедуре).
//
&ИзменениеИКонтроль("ВыполнитьМногопоточноеЗакрытиеПериодовПортфелей")
Процедура RduPF_ВыполнитьМногопоточноеЗакрытиеПериодовПортфелей(ОжидатьЗавершения = Ложь, ДопПараметры = Неопределено) Экспорт
	 
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;		
		ДопПараметры.Вставить("ИнтерактивныйЗапуск", Истина);
	КонецЕсли; 
	
	Если НЕ ДопПараметры.Свойство("НомерСеанса") Тогда
		ДопПараметры.Вставить("НомерСеанса", НомерСеансаИнформационнойБазы());
	КонецЕсли;

	Если НЕ ДопПараметры.Свойство("ИмяПользователя") Тогда
		ТекущийСеанс = ПолучитьТекущийСеансИнформационнойБазы();
		ИмяПользователя = ?(ТипЗнч(ТекущийСеанс.Пользователь) = Тип("ПользовательИнформационнойБазы"), ТекущийСеанс.Пользователь.Имя, "Пользователь не определен");
		ДопПараметры.Вставить("ИмяПользователя", ИмяПользователя);
	КонецЕсли;
	
	Если ДопПараметры.Свойство("НастройкаРегулярногоЗакрытия") И ЗначениеЗаполнено(ДопПараметры.НастройкаРегулярногоЗакрытия) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДопПараметры.НастройкаРегулярногоЗакрытия, "ПаузаПовтора, КоличествоПортфелейНаПоток");
		ПаузаПовтора = ЗначенияРеквизитов.ПаузаПовтора;	
		КоличествоПортфелейНаПоток = ЗначенияРеквизитов.КоличествоПортфелейНаПоток;
		ДопПараметры.Вставить("ИнтерактивныйЗапуск", Ложь);

	КонецЕсли;
	
	ДопПараметры.Вставить("ГруппаОперацийПользователя", ГруппаОперацийПользователя);
	ДопПараметры.Вставить("ПаузаПовтора", ПаузаПовтора);
	ДопПараметры.Вставить("КоличествоПортфелейНаПоток", КоличествоПортфелейНаПоток);
	ДопПараметры.Вставить("GUIDМенеджераПотоков", Строка(Новый УникальныйИдентификатор)); 
	ДопПараметры.Вставить("ПропуститьПроверкуАктивностиРегламента", АванкорСерверПовтИсп.ЗначениеКонстанты("ПропуститьПроверкуАктивностиРегламента"));
	
	ТаблицаПериодов = ЭтотОбъект.ПериодыПортфелей.Выгрузить(,"РеглПериод, Портфель");
	
	ПланРеглОперацийПоДням = Новый Соответствие;
	
	ТаблицаДней = ЭтотОбъект.ПериодыПортфелей.Выгрузить(, "День");
	ТаблицаДней.Свернуть("День");
	
	Для Каждого СтрокаДня Из ТаблицаДней Цикл
		
		День = СтрокаДня.День;
		
		ОтборПоДню = Новый Структура("День", День);
		ТаблицаПортфелейЗаДень = ЭтотОбъект.ПериодыПортфелей.Выгрузить(ОтборПоДню, "Портфель");
		МассивПортфелейЗаДень = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТаблицаПортфелейЗаДень.ВыгрузитьКолонку("Портфель"));
		
		тПланРеглОперацийПоДням = РегистрыСведений.НастройкиЗакрытияПериода.ПланРеглОпераций(День,
																							МассивПортфелейЗаДень,
																							Неопределено);
		
		#Вставка
		РегистрыСведений.ВидыОптимизируемыхРегламентныхОперацийДУ.ОтфильтроватьПланРеглОперацийНаДень(День, тПланРеглОперацийПоДням);
		#КонецВставки
		
		ПланРеглОперацийПоДням.Вставить(День, тПланРеглОперацийПоДням);
		
	КонецЦикла;
	
	ДопПараметры.Вставить("ПланРеглОперацийПоДням", ПланРеглОперацийПоДням);
	
	РегистрыСведений.ОчередьЗакрытияПериода.ДобавитьПортфелиВОчередь(ТаблицаПериодов, ДопПараметры);
	ЗаполнитьДокументыЗакрытияПериодовДляМногопоточногоРежима(ДопПараметры);
	РегистрыСведений.ИсполнителиЗакрытияПериодов.СоздатьМенеджерИсполнителей(ДопПараметры, ОжидатьЗавершения);
			
КонецПроцедуры

&ИзменениеИКонтроль("СформироватьРеглОперацииПоГруппе")
Процедура RduPF_СформироватьРеглОперацииПоГруппе(Портфель, ДатаЗакрытия, ТекГруппа, Отказ, ДопПараметры)

	ПроверитьНаличиеДействующейУП(ДатаЗакрытия, Отказ, Портфель);

	СписокПортфелейИзМассива = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Портфель);
	//РеглОперацииПлан = РегистрыСведений.НастройкиЗакрытияПериода.ПланРеглОпераций(ДатаЗакрытия, СписокПортфелейИзМассива, ТекГруппа);

	Если ДопПараметры <> Неопределено
		И ДопПараметры.Свойство("ПланРеглОперацийПоДням")
		И ЗначениеЗаполнено(ДопПараметры.ПланРеглОперацийПоДням) Тогда

		ПланРеглОперацийПоДням = ДопПараметры.ПланРеглОперацийПоДням;
		тПланРеглОперацийПоДням = ПланРеглОперацийПоДням.Получить(ДатаЗакрытия);
		Если ЗначениеЗаполнено(тПланРеглОперацийПоДням) Тогда 

			Если ЗначениеЗаполнено(ТекГруппа) Тогда
				Отбор = Новый Структура("Портфель, Родитель", Портфель, ТекГруппа);	
			Иначе
				Отбор = Новый Структура("Портфель, Родитель", Портфель, Неопределено);
			КонецЕсли;

			МассивСтрокОтбора = тПланРеглОперацийПоДням.НайтиСтроки(Отбор);
			РеглОперацииПлан = тПланРеглОперацийПоДням.Скопировать(МассивСтрокОтбора);
		Иначе
			РеглОперацииПлан = РегистрыСведений.НастройкиЗакрытияПериода.ПланРеглОпераций(ДатаЗакрытия, СписокПортфелейИзМассива, ТекГруппа);
		КонецЕсли;

	Иначе
		РеглОперацииПлан = РегистрыСведений.НастройкиЗакрытияПериода.ПланРеглОпераций(ДатаЗакрытия, СписокПортфелейИзМассива, ТекГруппа);
	КонецЕсли;

	ГруппыРегламентныхОпераций = РеглОперацииПлан.Скопировать(,"Родитель");
	ГруппыРегламентныхОпераций.Свернуть("Родитель");
	ПомечатьВнеТранзакции = ОбщегоНазначенияДУПовтИсп.ПолучитьЗначениеКонстанты("ПомечатьНаУдалениеДокументыРеглОперацийВнеТранзакции");
	Для каждого ГруппаРегламентныхОпераций Из ГруппыРегламентныхОпераций Цикл

		Если Отказ Тогда
			Прервать;
		КонецЕсли;

		ВыполняемыйПлан = Неопределено;

		ОбщийПлан = РегламентноеЗакрытиеПериода.НайтиПланРегламентныхОперацийДУ(ДатаЗакрытия, Портфель, ГруппаРегламентныхОпераций.Родитель, Ложь, Истина);

		Если ПоВыбраннымАктивам Тогда
			Если Не ЗначениеЗаполнено(ОбщийПлан) Или Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбщийПлан, "Проведен") Тогда
				ТекстИсключения = СтрШаблон("Для выполнения регламентных операций по выбранным активам за период %1 по портфелю %2 должно быть выполнено полное закрытие периода по портфелю. Закройте данный период без отбора по активам",
				ФДата(ДатаЗакрытия), Портфель);

				ВызватьИсключение ТекстИсключения;		
			КонецЕсли;

			ВыполняемыйПлан = РегламентноеЗакрытиеПериода.НайтиПланРегламентныхОперацийДУ(ДатаЗакрытия, Портфель, ГруппаРегламентныхОпераций.Родитель, Истина, Истина);
			ДобавитьВыбранныеАктивы(ВыполняемыйПлан);		
		Иначе
			ВыполняемыйПлан = ОбщийПлан;
		КонецЕсли;		
        #Вставка
		
		РеглОперации = РеглОперацииПлан.Скопировать(Новый Структура("Родитель", ГруппаРегламентныхОпераций.Родитель));
		
		Если ВыполняемыйПлан = Неопределено Тогда
			ОперацииКВыполнению = РеглОперации.НайтиСтроки(Новый Структура("Выполнять", 1));
			Если ОперацииКВыполнению.Количество() = 0 Тогда // Если это новый план и в нем нет ни одной выполняемой операции то ничего не делаем !
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		#КонецВставки
		Если ВыполняемыйПлан = Неопределено Тогда
			ВыполняемыйПлан = ВыполняемыйПлан(ДатаЗакрытия);
		Иначе
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыполняемыйПлан, "Проведен") Тогда 
				ДокументОбъект = ВыполняемыйПлан.ПолучитьОбъект();
				ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Если ПомечатьВнеТранзакции Тогда
					Документы.ПланРегламентныхОперацийДУ.ПометитьНаУдалениеПодчиненныеДокументы(ВыполняемыйПлан);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
        #Удаление
		РеглОперации = РеглОперацииПлан.Скопировать(Новый Структура("Родитель", ГруппаРегламентныхОпераций.Родитель));
        #КонецУдаления
		Отказ = Не ФоновыеЗаданияСервер.СоздатьПланРегламентныхОперацийДУ(ДатаЗакрытия, Портфель, РеглОперации, ВыполняемыйПлан, ГруппаРегламентныхОпераций.Родитель, ДопПараметры);

		Если Отказ И ПовторноВыполнятьРеглОперациюПриОтказе Тогда			

			ТекстСообщения = "Повтор выполнения регламентного задания из-за отказа за " + ФДата(ДатаЗакрытия);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Отказ = Не ФоновыеЗаданияСервер.СоздатьПланРегламентныхОперацийДУ(ДатаЗакрытия, Портфель, РеглОперации, ВыполняемыйПлан, ГруппаРегламентныхОпераций.Родитель, ДопПараметры);

		КонецЕсли;		
	КонецЦикла; 

КонецПроцедуры
