#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПОДСИСТЕМА_ДОПОЛНИТЕЛЬНЫХ_ОТЧЕТОВ_И_ОБРАБОТОК

// Описание: Регистрация в подсистеме дополнительных отчетов и обработок БСП.
//
// Возвращаемое значение:
// Структура - параметры регистрации внешней обработки.
//
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.3.1.73");
	ПараметрыРегистрации.Версия = "1.0.0";
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Проверка подчиненных документов плана рег. операций (ДУ)'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Аналитика: наличие подчиненного документа ожидаемого типа по плану ПланРегламентныхОперацийДУ (критерий СвязанныеДокументы).'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = ПараметрыРегистрации.Наименование;
	Команда.Идентификатор = "SubordinateDocsPlanRegOperCheck";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Описание: Имена исполняемых процедур из белого списка ТЗ (соответствие operation_closure_procedure_document_map).
//
// Возвращаемое значение:
// Массив из Строка
//
Функция ТекстыПроцедурБелогоСписка() Экспорт

	Результат = Новый Массив;
	Результат.Добавить("Операция_0025_НачислениеПроцентовПоБанковскимСчетамПоГрафикуВыплат");
	Результат.Добавить("Операция_0050_ПереводНКДВЗадолженностьЭмитента");
	Результат.Добавить("Операция_0140_ОпределениеСделокСОтклонениемЦен");
	Результат.Добавить("Операция_0058_ПогашениеОблигаций_ДоПереоценки");
	Результат.Добавить("Операция_0058_ЧастичноеПогашениеОблигаций");
	Результат.Добавить("Операция_0032_НачислениеПроцентовПоЗаймамПоГрафикуВыплат");
	Результат.Добавить("Операция_0033_НачислениеПроцентовПоЗаймам");
	Результат.Добавить("Операция_0080_СписаниеПросроченныхОблигаций");
	Возврат Результат;

КонецФункции

// Описание: Ожидаемое имя объекта метаданных документа по строке ИсполняемаяПроцедура вида операции.
//
// Параметры:
//  ИмяПроцедуры - Строка - значение реквизита ИсполняемаяПроцедура справочника ВидыОперацийЗакрытияПериода.
//
// Возвращаемое значение:
//  Строка, Неопределено - имя документа в конфигурации или Неопределено, если процедура вне белого списка.
//
Функция ПолучитьОжидаемоеИмяТипаДокументаПоПроцедуре(ИмяПроцедуры) Экспорт

	Соответствие = СоответствиеПроцедурИИменДокументов();
	Возврат Соответствие.Получить(ИмяПроцедуры);

КонецФункции

// Описание: Ссылки видов операций, попадающих в белый список (по ИсполняемаяПроцедура).
//
// Возвращаемое значение:
// Массив из СправочникСсылка.ВидыОперацийЗакрытияПериода
//
Функция ПолучитьДопустимыеСсылкиВидовОпераций() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Виды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыОперацийЗакрытияПериода КАК Виды
	|ГДЕ
	|	НЕ Виды.ПометкаУдаления
	|	И Виды.ИсполняемаяПроцедура В (&СписокПроцедур)";
	Запрос.УстановитьПараметр("СписокПроцедур", ТекстыПроцедурБелогоСписка());
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Описание: Выполняет проверку наличия подчиненных документов ожидаемого типа по критерию СвязанныеДокументы.
// Для каждого портфеля отбора находит планы ПланРегламентныхОперацийДУ за сутки даты, объединяет подчиненные
// документы всех планов и считает документы с именем метаданных из белого списка по ИсполняемаяПроцедура вида операции.
//
// Параметры: нет (используются реквизиты и ТЧ объекта обработки).
//
Процедура ВыполнитьПроверку() Экспорт

	ЭтотОбъект.РезультатыПроверки.Очистить();

	Если Не ЗначениеЗаполнено(ЭтотОбъект.ДатаОперационногоДня) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите дату операционного дня.'");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЭтотОбъект.ВидОперации) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите вид операции закрытия периода.'");
	КонецЕсли;

	РеквизитыВида = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.ВидОперации, "ИсполняемаяПроцедура, ПометкаУдаления");
	Если РеквизитыВида.ПометкаУдаления Тогда
		ВызватьИсключение НСтр("ru = 'Выбранный вид операции помечен на удаление.'");
	КонецЕсли;

	ОжидаемоеИмяДокумента = ПолучитьОжидаемоеИмяТипаДокументаПоПроцедуре(РеквизитыВида.ИсполняемаяПроцедура);
	Если ОжидаемоеИмяДокумента = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Выбранный вид операции не входит в перечень обработки (белый список по ИсполняемаяПроцедура).'");
	КонецЕсли;

	МассивПортфелей = СобратьПортфелиДляПроверки();
	Если МассивПортфелей.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Укажите пул или добавьте портфели в список.'");
	КонецЕсли;

	ДатаНач = НачалоДня(ЭтотОбъект.ДатаОперационногоДня);
	ДатаКон = КонецДня(ЭтотОбъект.ДатаОперационногоДня);

	КэшСвязанных = Новый Соответствие;

	Для Каждого ПортфельСсылка Из МассивПортфелей Цикл

		СтрокаРез = ЭтотОбъект.РезультатыПроверки.Добавить();
		СтрокаРез.Портфель = ПортфельСсылка;
		СтрокаРез.ПулПортфеля = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПортфельСсылка, "Пул");

		Планы = ВыбратьПланыПортфеля(ПортфельСсылка, ДатаНач, ДатаКон);
		СтрокаРез.КоличествоПланов = Планы.Количество();

		КолПроведенных = 0;
		Для Каждого СтрПлан Из Планы Цикл
			Если СтрПлан.Проведен Тогда
				КолПроведенных = КолПроведенных + 1;
			КонецЕсли;
		КонецЦикла;
		СтрокаРез.КоличествоПроведенныхПланов = КолПроведенных;

		Если Планы.Количество() = 0 Тогда
			СтрокаРез.ДокументНайден = Ложь;
			СтрокаРез.КоличествоДокументов = 0;
			СтрокаРез.Комментарий = НСтр("ru = 'Нет планов ПланРегламентныхОперацийДУ на дату с учетом отбора.'");
			Продолжить;
		КонецЕсли;

		РезультатПоиска = НайтиДокументыОжидаемогоТипаПоПланам(Планы, ОжидаемоеИмяДокумента, КэшСвязанных);

		СтрокаРез.ДокументНайден = РезультатПоиска.КоличествоУникальных > 0;
		СтрокаРез.КоличествоДокументов = РезультатПоиска.КоличествоУникальных;
		СтрокаРез.ПервыйНайденныйДокумент = РезультатПоиска.ПервыйДокумент;
		СтрокаРез.ПланыСтрока = РезультатПоиска.ПланыПредставление;

	КонецЦикла;

КонецПроцедуры

// Описание: Формирует табличный документ по заполненной ТЧ РезультатыПроверки для сохранения в MXL.
//
// Возвращаемое значение:
// ТабличныйДокумент - таблица с заголовками и строками результата.
//
Функция СформироватьТабличныйДокументРезультата() Экспорт

	Таб = Новый ТабличныйДокумент;
	Заголовки = Новый Массив;
	Заголовки.Добавить(НСтр("ru = 'Портфель'"));
	Заголовки.Добавить(НСтр("ru = 'Пул'"));
	Заголовки.Добавить(НСтр("ru = 'Документ найден'"));
	Заголовки.Добавить(НСтр("ru = 'Количество документов'"));
	Заголовки.Добавить(НСтр("ru = 'Количество планов'"));
	Заголовки.Добавить(НСтр("ru = 'Проведено планов'"));
	Заголовки.Добавить(НСтр("ru = 'Первый документ'"));
	Заголовки.Добавить(НСтр("ru = 'Планы'"));
	Заголовки.Добавить(НСтр("ru = 'Комментарий'"));
	Для Индекс = 1 По Заголовки.Количество() Цикл
		Таб.Область(1, Индекс, 1, Индекс).Текст = Заголовки[Индекс - 1];
	КонецЦикла;

	НомерСтроки = 2;
	Для Каждого Стр Из ЭтотОбъект.РезультатыПроверки Цикл
		Таб.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = Строка(Стр.Портфель);
		Таб.Область(НомерСтроки, 2, НомерСтроки, 2).Текст = Строка(Стр.ПулПортфеля);
		Таб.Область(НомерСтроки, 3, НомерСтроки, 3).Текст = ?(Стр.ДокументНайден, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'"));
		Таб.Область(НомерСтроки, 4, НомерСтроки, 4).Текст = Формат(Стр.КоличествоДокументов, "ЧН=0; ЧГ=");
		Таб.Область(НомерСтроки, 5, НомерСтроки, 5).Текст = Формат(Стр.КоличествоПланов, "ЧН=0; ЧГ=");
		Таб.Область(НомерСтроки, 6, НомерСтроки, 6).Текст = Формат(Стр.КоличествоПроведенныхПланов, "ЧН=0; ЧГ=");
		Таб.Область(НомерСтроки, 7, НомерСтроки, 7).Текст = ?(ЗначениеЗаполнено(Стр.ПервыйНайденныйДокумент), Строка(Стр.ПервыйНайденныйДокумент), "");
		Таб.Область(НомерСтроки, 8, НомерСтроки, 8).Текст = Стр.ПланыСтрока;
		Таб.Область(НомерСтроки, 9, НомерСтроки, 9).Текст = Стр.Комментарий;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Возврат Таб;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоответствиеПроцедурИИменДокументов()

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Операция_0025_НачислениеПроцентовПоБанковскимСчетамПоГрафикуВыплат", "НачислениеПроцентовПоБанковскимСчетам");
	Соответствие.Вставить("Операция_0050_ПереводНКДВЗадолженностьЭмитента", "ПереводНКДВЗадолженностьЭмитента");
	Соответствие.Вставить("Операция_0140_ОпределениеСделокСОтклонениемЦен", "ОтклонениеЦенСделок");
	Соответствие.Вставить("Операция_0058_ПогашениеОблигаций_ДоПереоценки", "ПогашениеОблигаций");
	Соответствие.Вставить("Операция_0058_ЧастичноеПогашениеОблигаций", "ПогашениеОблигаций");
	Соответствие.Вставить("Операция_0032_НачислениеПроцентовПоЗаймамПоГрафикуВыплат", "РасчетПроцентовПоЗаймам");
	Соответствие.Вставить("Операция_0033_НачислениеПроцентовПоЗаймам", "РасчетПроцентовПоЗаймам");
	Соответствие.Вставить("Операция_0080_СписаниеПросроченныхОблигаций", "ДефолтнаяОперация");
	Возврат Соответствие;

КонецФункции

Функция СобратьПортфелиДляПроверки()

	Результат = Новый Массив;
	УжеДобавлен = Новый Соответствие;

	Если ЭтотОбъект.СписокПортфелей.Количество() > 0 Тогда

		Для Каждого Стр Из ЭтотОбъект.СписокПортфелей Цикл

			Если Не ЗначениеЗаполнено(Стр.Портфель) Тогда
				Продолжить;
			КонецЕсли;

			Если УжеДобавлен[Стр.Портфель] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Портфель, "ПометкаУдаления");
			Если ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;

			Если ЗначениеЗаполнено(ЭтотОбъект.Пул) Тогда
				ПулПортфеля = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Портфель, "Пул");
				Если ПулПортфеля <> ЭтотОбъект.Пул Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			УжеДобавлен.Вставить(Стр.Портфель, Истина);
			Результат.Добавить(Стр.Портфель);

		КонецЦикла;

	Иначе

		Если Не ЗначениеЗаполнено(ЭтотОбъект.Пул) Тогда
			Возврат Результат;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Портфели.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Портфели КАК Портфели
		|ГДЕ
		|	НЕ Портфели.ПометкаУдаления
		|	И Портфели.Пул = &Пул";
		Запрос.УстановитьПараметр("Пул", ЭтотОбъект.Пул);
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ВыбратьПланыПортфеля(ПортфельСсылка, ДатаНач, ДатаКон)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	План.Ссылка КАК Ссылка,
	|	План.Проведен КАК Проведен,
	|	План.Номер КАК Номер,
	|	План.Дата КАК Дата
	|ИЗ
	|	Документ.ПланРегламентныхОперацийДУ КАК План
	|ГДЕ
	|	План.Портфель = &Портфель
	|	И План.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И НЕ План.ПометкаУдаления
	|	И (&БезОтбораПоГруппе
	|			ИЛИ План.ГруппаОперацийПользователя = &ГруппаОпераций)";
	Запрос.УстановитьПараметр("Портфель", ПортфельСсылка);
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	БезОтбораПоГруппе = Не ЗначениеЗаполнено(ЭтотОбъект.ГруппаОпераций);
	Запрос.УстановитьПараметр("БезОтбораПоГруппе", БезОтбораПоГруппе);
	Запрос.УстановитьПараметр("ГруппаОпераций", ЭтотОбъект.ГруппаОпераций);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция НайтиДокументыОжидаемогоТипаПоПланам(ТаблицаПланов, ОжидаемоеИмяДокумента, КэшСвязанных)

	УникальныеДокументы = Новый Соответствие;
	ПервыйДокумент = Неопределено;
	ПланыСНаходками = Новый Соответствие;

	Для Каждого СтрПлан Из ТаблицаПланов Цикл

		СсылкаПлана = СтрПлан.Ссылка;
		Связанные = КэшСвязанных.Получить(СсылкаПлана);
		Если Связанные = Неопределено Тогда
			Связанные = КритерииОтбора.СвязанныеДокументы.Найти(СсылкаПлана);
			КэшСвязанных.Вставить(СсылкаПлана, Связанные);
		КонецЕсли;

		Если Связанные = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СвязанныйДокумент Из Связанные Цикл

			Мета = Метаданные.НайтиПоТипу(ТипЗнч(СвязанныйДокумент));
			Если Мета = Неопределено Или Мета.Имя <> ОжидаемоеИмяДокумента Тогда
				Продолжить;
			КонецЕсли;

			Если УникальныеДокументы[СвязанныйДокумент] = Неопределено Тогда
				УникальныеДокументы.Вставить(СвязанныйДокумент, Истина);
				Если ПервыйДокумент = Неопределено Тогда
					ПервыйДокумент = СвязанныйДокумент;
				КонецЕсли;
			КонецЕсли;

			ПланыСНаходками.Вставить(СсылкаПлана, Истина);

		КонецЦикла;

	КонецЦикла;

	МассивПредставленийПланов = Новый Массив;
	Для Каждого КлючИЗначение Из ПланыСНаходками Цикл
