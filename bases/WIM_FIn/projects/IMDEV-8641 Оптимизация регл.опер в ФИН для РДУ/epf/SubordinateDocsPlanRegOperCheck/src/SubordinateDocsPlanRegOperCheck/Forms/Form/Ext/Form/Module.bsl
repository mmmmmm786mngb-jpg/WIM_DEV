#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.ДатаОперационногоДня) Тогда
		Объект.ДатаОперационногоДня = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

	УстановитьПараметрыВыбораВидаОперации();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПроверку(Команда)

	ВыполнитьПроверкуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЭкспортMXL(Команда)

	Если Объект.РезультатыПроверки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет данных для выгрузки. Выполните проверку.'"));
		Возврат;
	КонецЕсли;

	АдресВХ = ПодготовитьMXLНаСервере(УникальныйИдентификатор);
	Если Не ЗначениеЗаполнено(АдресВХ) Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ЭкспортMXLПослеПолученияФайла", ЭтотОбъект);
	НачатьПолучениеФайлаССервера(Оповещение, АдресВХ, "SubordinateDocsPlanResult.mxl", УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ЭкспортMXLПослеПолученияФайла(ПолученноеИмяФайла, ДополнительныеПараметры) Экспорт

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьПараметрыВыбораВидаОперации()

	ДопустимыеСсылки = Объект.ПолучитьДопустимыеСсылкиВидовОпераций();
	Если ДопустимыеСсылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ДопустимыеСсылки)));
	Элементы.ВидОперации.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);

КонецПроцедуры

&НаСервере
Процедура ВыполнитьПроверкуНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");

	Попытка
		ОбъектОбработки.ВыполнитьПроверку();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");

КонецПроцедуры

&НаСервере
Функция ПодготовитьMXLНаСервере(УникальныйИдентФормы)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Таб = ОбъектОбработки.СформироватьТабличныйДокументРезультата();

	ИмяВременного = ПолучитьИмяВременногоФайла("mxl");

	Попытка
		Таб.Записать(ИмяВременного, ТипФайлаТабличногоДокумента.MXL);
		Двоичные = Новый ДвоичныеДанные(ИмяВременного);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "";
	КонецПопытки;

	Попытка
		УдалитьФайлы(ИмяВременного);
	Исключение
	КонецПопытки;

	Возврат ПоместитьВоВременноеХранилище(Двоичные, УникальныйИдентФормы);

КонецФункции

#КонецОбласти
