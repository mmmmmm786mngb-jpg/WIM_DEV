
&НаСервере
Функция СписокПриИзмененииНаСервере(ИдентификаторОбмена, ИдентификаторПотока)
	
	СообщенияПотока = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ExchDU_СостояниеОбъектовЗагрузки.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ExchDU_СостояниеОбъектовЗагрузки КАК ExchDU_СостояниеОбъектовЗагрузки
		|ГДЕ
		|	ExchDU_СостояниеОбъектовЗагрузки.ИдентификаторОбмена = &ИдентификаторОбмена
		|	И ExchDU_СостояниеОбъектовЗагрузки.ИдентификаторПотока = &ИдентификаторПотока
		|	И ExchDU_СостояниеОбъектовЗагрузки.Тип = ""Сообщения пользователю""";
	
	Запрос.УстановитьПараметр("ИдентификаторОбмена", ИдентификаторОбмена);
	Запрос.УстановитьПараметр("ИдентификаторПотока", ИдентификаторПотока);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СообщенияПотока = СообщенияПотока + Символы.ПС + ВыборкаДетальныеЗаписи.Комментарий;
	КонецЦикла;  
	
	Возврат СообщенияПотока;
	
КонецФункции

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) 
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	СообщенияПотока = СписокПриИзмененииНаСервере(ТекущаяСтрока.ИдентификаторОбмена, ТекущаяСтрока.ИдентификаторПотока);
	
	ЛогСообщенийПользователю = Новый ТекстовыйДокумент; 
	ЛогСообщенийПользователю.ДобавитьСтроку(СообщенияПотока);
	ЛогСообщенийПользователю.Показать("Сообщения потока"); 
	
КонецПроцедуры

