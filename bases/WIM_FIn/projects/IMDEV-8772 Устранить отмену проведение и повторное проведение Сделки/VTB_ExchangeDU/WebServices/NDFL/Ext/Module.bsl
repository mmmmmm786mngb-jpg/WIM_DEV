Функция ФормированиеЛогаЗагрузкиВТабДок(ИдентификаторОбмена) 
	
	Макет = ПолучитьОбщийМакет("ЛогОбмена_ДУ_ФИН");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОтображатьГруппировки 	= Ложь;
	ТабДокумент.ОтображатьСетку 		= Ложь;
	ТабДокумент.ОтображатьЗаголовки 	= Ложь;

	Заголовок = Макет.ПолучитьОбласть("Заголовок");
	ТабДокумент.Вывести(Заголовок);
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.ДатаФормирования = ТекущаяДата();
	ТабДокумент.Вывести(Шапка);
	
	ОбластьШапкаСправочники = Макет.ПолучитьОбласть("ШапкаСправочники");
	ТабДокумент.Вывести(ОбластьШапкаСправочники);
	
	СтруктураТиповОбъектов = ЗаполнениеСтруктурыТиповОбъектов();
	
	МассивВидовСправочников = СтруктураТиповОбъектов.МассивВидовСправочников;
	МассивВидовДокументов = СтруктураТиповОбъектов.МассивВидовДокументов;
	МассивВидовБП = СтруктураТиповОбъектов.МассивВидовБП;
	
	РезультатЗапроса = СостояниеОбъектов(ИдентификаторОбмена); 
	
	ТаблицаЗагруженныхОбъектов = РезультатЗапроса[0].Выгрузить();
	ТаблицаНеЗагруженныхОбъектов = РезультатЗапроса[1].Выгрузить();
	
	Для Каждого ВидСправочника из МассивВидовСправочников Цикл
		
		ОбластьСправочникВид = Макет.ПолучитьОбласть("СправочникВид");
		
		КолЗагруженных = 0;
		КолНеЗагруженных = 0;
		
		СтрокиОтбораЗагруженныхОбъектов = ТаблицаЗагруженныхОбъектов.НайтиСтроки(Новый Структура("Тип",ВидСправочника));
		КолЗагруженных = СтрокиОтбораЗагруженныхОбъектов.Количество();
		
		СтрокиОтбораНеЗагруженныхОбъектов = ТаблицаНеЗагруженныхОбъектов.НайтиСтроки(Новый Структура("Тип",ВидСправочника));
		КолНеЗагруженных = СтрокиОтбораНеЗагруженныхОбъектов.Количество();
		
		
		ОбластьСправочникВид.Параметры.Справочник = ВидСправочника;
		ОбластьСправочникВид.Параметры.КоличествоУспешно = КолЗагруженных;
		ОбластьСправочникВид.Параметры.КоличествоСОшибкой = КолНеЗагруженных;

		ТабДокумент.Вывести(ОбластьСправочникВид);
		
		Для Каждого СтрокаС_Ошибкой из СтрокиОтбораНеЗагруженныхОбъектов Цикл
			ОбластьСправочникОшибка = Макет.ПолучитьОбласть("СправочникОшибка");
			ОбластьСправочникОшибка.Параметры.Справочник = СтрокаС_Ошибкой.Представление;
			ТабДокумент.Вывести(ОбластьСправочникОшибка);
		КонецЦикла;
		
	КонецЦикла;
	
	
	ОбластьШапкаДокументы = Макет.ПолучитьОбласть("ШапкаДокументы");
	ТабДокумент.Вывести(ОбластьШапкаДокументы);

	Для Каждого ВидДокумента из МассивВидовДокументов Цикл
		
		ОбластьДокументВид = Макет.ПолучитьОбласть("ДокументВид");
		
		КолЗагруженных = 0;
		КолНеЗагруженных = 0;
				
		СтрокиОтбораЗагруженныхОбъектов = ТаблицаЗагруженныхОбъектов.НайтиСтроки(Новый Структура("Тип",ВидДокумента));
		КолЗагруженных = СтрокиОтбораЗагруженныхОбъектов.Количество();
		
		СтрокиОтбораНеЗагруженныхОбъектов = ТаблицаНеЗагруженныхОбъектов.НайтиСтроки(Новый Структура("Тип",ВидДокумента));
		КолНеЗагруженных = СтрокиОтбораНеЗагруженныхОбъектов.Количество();
		
		
		ОбластьДокументВид.Параметры.Документ = ВидДокумента;
		ОбластьДокументВид.Параметры.КоличествоУспешно = КолЗагруженных;
		ОбластьДокументВид.Параметры.КоличествоСОшибкой = КолНеЗагруженных;

		ТабДокумент.Вывести(ОбластьДокументВид);
		
		Для Каждого СтрокаЗагружено из СтрокиОтбораЗагруженныхОбъектов Цикл
			ОбластьДокументСтрока = Макет.ПолучитьОбласть("ДокументСтрока");
			ОбластьДокументСтрока.Параметры.Документ 	= СтрокаЗагружено.Представление;
			ОбластьДокументСтрока.Параметры.Статус 		= СтрокаЗагружено.Статус;
			ТабДокумент.Вывести(ОбластьДокументСтрока);
		КонецЦикла;

		Для Каждого СтрокаС_Ошибкой из СтрокиОтбораНеЗагруженныхОбъектов Цикл
			ОбластьДокументСтрока = Макет.ПолучитьОбласть("ДокументСтрока");
			ОбластьДокументСтрока.Параметры.Документ 	= СтрокаС_Ошибкой.Представление;
			ОбластьДокументСтрока.Параметры.Статус 	= СтрокаС_Ошибкой.Статус;
			ОбластьДокументСтрока.Параметры.ОписаниеОшибки = СтрокаС_Ошибкой.ОписаниеОшибки;
			ТабДокумент.Вывести(ОбластьДокументСтрока);
		КонецЦикла;
		
	КонецЦикла;
	
	ОбластьШапкаБП = Макет.ПолучитьОбласть("ШапкаБизнесПроцессы");
	ТабДокумент.Вывести(ОбластьШапкаБП);
	
	Для Каждого ВидБизнесПроцесса из МассивВидовБП Цикл
		
		ОбластьБизнесПроцессВид = Макет.ПолучитьОбласть("БизнесПроцессВид");
		
		КолЗагруженных = 0;
		КолНеЗагруженных = 0;
				
		СтрокиОтбораЗагруженныхОбъектов = ТаблицаЗагруженныхОбъектов.НайтиСтроки(Новый Структура("Тип",ВидБизнесПроцесса));
		КолЗагруженных = СтрокиОтбораЗагруженныхОбъектов.Количество();
		
		СтрокиОтбораНеЗагруженныхОбъектов = ТаблицаНеЗагруженныхОбъектов.НайтиСтроки(Новый Структура("Тип",ВидБизнесПроцесса));
		КолНеЗагруженных = СтрокиОтбораНеЗагруженныхОбъектов.Количество();
		
		
		ОбластьБизнесПроцессВид.Параметры.БизнесПроцесс = ВидБизнесПроцесса;
		ОбластьБизнесПроцессВид.Параметры.КоличествоУспешно = КолЗагруженных;
		ОбластьБизнесПроцессВид.Параметры.КоличествоСОшибкой = КолНеЗагруженных;

		ТабДокумент.Вывести(ОбластьБизнесПроцессВид);
		
		Для Каждого СтрокаЗагружено из СтрокиОтбораЗагруженныхОбъектов Цикл
			ОбластьБизнесПроцессСтрока = Макет.ПолучитьОбласть("БизнесПроцессСтрока");
			ОбластьБизнесПроцессСтрока.Параметры.БизнесПроцесс 	= СтрокаЗагружено.Представление;
			ОбластьБизнесПроцессСтрока.Параметры.Статус 		= СтрокаЗагружено.Статус;
			ОбластьОформления = ТабДокумент.Вывести(ОбластьБизнесПроцессСтрока);
            Если СтрокаЗагружено.Статус = "Изменен" Тогда
				ТабДокумент.Область(ОбластьОформления.Верх, ОбластьОформления.Лево, ОбластьОформления.Низ, ОбластьОформления.Лево).ЦветФона = WebЦвета.Красный;
			КонецЕсли; 
		КонецЦикла;

		Для Каждого СтрокаС_Ошибкой из СтрокиОтбораНеЗагруженныхОбъектов Цикл
			ОбластьБизнесПроцессСтрока = Макет.ПолучитьОбласть("БизнесПроцессСтрока");
			ОбластьБизнесПроцессСтрока.Параметры.БизнесПроцесс 	= СтрокаС_Ошибкой.Представление;
			ОбластьБизнесПроцессСтрока.Параметры.Статус 	= СтрокаС_Ошибкой.Статус;
			ОбластьБизнесПроцессСтрока.Параметры.ОписаниеОшибки = СтрокаС_Ошибкой.ОписаниеОшибки;
			ТабДокумент.Вывести(ОбластьБизнесПроцессСтрока);
		КонецЦикла;
		
	КонецЦикла;     
	
	СообщенияБазыПриемника = ПолучитьСообщенияПользователю(Истина);
	Для Каждого Сообщение ИЗ СообщенияБазыПриемника Цикл
		Область = Макет.ПолучитьОбласть("СтрокаСообщенияПользователю");
		Область.Параметры.СтрокаСообщенияПользователю = Сообщение.Текст;
		ТабДокумент.Вывести(Область);
	КонецЦикла;

	Возврат ТабДокумент;
	
КонецФункции  

Функция ПропискаРассылки(Знач НомерРассылки) 
	
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка; 
	
КонецФункции 

Функция ТаблицаЗначенийИзXDTO(ТаблицаXDTO)
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	Для каждого Колонка из ТаблицаXDTO.Columns Цикл
		ТаблицаРезультат.Колонки.Добавить(Колонка.Имя); 
	КонецЦикла;
	
	Для каждого Строка из ТаблицаXDTO Цикл
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция УстановитьСостояниеПотокаОбмена(ИдентификаторОбмена, ИдентификаторПотока, СтатусЗагрузки, СостояниеОбмена, ВременныйИдентификаторПотока = Неопределено, ПараметрыОбработкиXML = Неопределено)   
	
		Если ЗначениеЗаполнено(ВременныйИдентификаторПотока) Тогда  
			ТекущийИдентификаторПотока = ВременныйИдентификаторПотока;  
		Иначе
			ТекущийИдентификаторПотока = ИдентификаторПотока;  
		КонецЕсли;   
	
		ПотокОбмена = РегистрыСведений.ExchDU_ПотокиОбмена.СоздатьМенеджерЗаписи();
		
		ПотокОбмена.ИдентификаторОбмена = ИдентификаторОбмена;
		ПотокОбмена.ИдентификаторПотока = ТекущийИдентификаторПотока;  
		ПотокОбмена.Прочитать(); 
		
		Если Не ПотокОбмена.Выбран() Тогда
			ПотокОбмена.ИдентификаторОбмена = ИдентификаторОбмена;
			ПотокОбмена.ИдентификаторПотока = ТекущийИдентификаторПотока;
			ПотокОбмена.ДатаОбмена = ТекущаяДата();   
		Иначе	
			ПотокОбмена.ИдентификаторПотока = ИдентификаторПотока;
		КонецЕсли;
		
		ПотокОбмена.СтатусЗагрузки = СтатусЗагрузки;  
		ПотокОбмена.СостояниеОбработки  = СостояниеОбмена; 
		Если ЗначениеЗаполнено(ПараметрыОбработкиXML) Тогда
			ПотокОбмена.ПараметрыОбработки = Новый ХранилищеЗначения(ПараметрыОбработкиXML);
		КонецЕсли;
		
		ПотокОбмена.Записать();
		
КонецФункции		
		






