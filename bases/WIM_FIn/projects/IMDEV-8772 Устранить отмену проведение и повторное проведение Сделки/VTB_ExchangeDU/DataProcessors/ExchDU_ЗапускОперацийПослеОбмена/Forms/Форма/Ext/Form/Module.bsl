
&НаСервере
Функция ВыполнитьНаСервере()
	
	ОбъектМодуль = РеквизитФормыВЗначение("Объект");  
	ОбъектМодуль.ВыполнитьОбработку();
	
	Возврат ОбъектМодуль.Лог;
КонецФункции

&НаКлиенте
Процедура ВыполнитьОбработкуОбъетов(Команда)
	Если Не ЗначениеЗаполнено(Объект.ИдентификаторОбмена) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не заполнен Идентификатор обмена'");
		Сообщение.Сообщить(); 
		Возврат;
	КонецЕсли;
	
	ТаблДок = ВыполнитьНаСервере();
	ТаблДок.Показать();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВсеРегистры(Команда)   
	
	ОткрытьФорму("РегистрСведений.ExchDU_СписокБПНаУдаление.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);  
	ОткрытьФорму("РегистрСведений.ExchDU_СписокДокументовДляОтменыПроведения.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);  
	ОткрытьФорму("РегистрСведений.ExchDU_СписокДокументовДляПроведения.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);  
	ОткрытьФорму("РегистрСведений.ExchDU_СписокДокументовДляУдаления.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);  
	ОткрытьФорму("РегистрСведений.ExchDU_СписокЗавершенныхБП.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);  
	ОткрытьФорму("РегистрСведений.ExchDU_СписокИзмененныхБП.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);  
	ОткрытьФорму("РегистрСведений.ExchDU_СписокИзмененныхБПдляСтарта.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);  
	ОткрытьФорму("РегистрСведений.ExchDU_СписокНепроведенныхДокументов.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);  
	ОткрытьФорму("РегистрСведений.ExchDU_СписокНовыхБП.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);   
	ОткрытьФорму("РегистрСведений.ExchDU_СписокНовыхБПдляСтарта.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);  
	ОткрытьФорму("РегистрСведений.ExchDU_СписокНовыхБПНаУдаление.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый); 
	ОткрытьФорму("РегистрСведений.ExchDU_СписокНовыхЗавершенныхБП.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый); 
	ОткрытьФорму("РегистрСведений.ExchDU_СписокСправочниковКЗагрузке.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый);
	
	ОткрытьФорму("РегистрСведений.ExchDU_ПотокиОбмена.ФормаСписка",,,,,,,РежимОткрытияОкнаФормы.Независимый); 
	
КонецПроцедуры

&НаСервере
Процедура ИдентификаторОбменаНачалоВыбораНаСервере()
	
	ТаблицаДоступныхОбменов = ExchDU_ОбработкаОбъектовПослеЗагрузки.ДоступныеОбмены();       

	Для Каждого СтрокаОбмен Из ТаблицаДоступныхОбменов Цикл
		Элементы.ИдентификаторОбмена.СписокВыбора.Добавить(СтрокаОбмен.ИдентификаторОбмена, СтрокаОбмен.ИдентификаторОбмена + " -  " + Формат(СтрокаОбмен.ДатаОбмена, "ДФ=""дд.ММ.гг ' 'ЧЧ:мм"""));
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторОбменаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка) 
	Элементы.ИдентификаторОбмена.СписокВыбора.Очистить();
	ИдентификаторОбменаНачалоВыбораНаСервере();
КонецПроцедуры

