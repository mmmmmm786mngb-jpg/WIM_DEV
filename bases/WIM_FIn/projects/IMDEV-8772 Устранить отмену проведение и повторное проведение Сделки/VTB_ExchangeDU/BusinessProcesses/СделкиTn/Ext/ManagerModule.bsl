// IMDEV-8772
// Описание: Автоматически отменяет шаги бизнес-процесса с возможностью не отменять проведение документа Сделка.
// Используется в доработке IMDEV-8772 для исключения лишнего цикла проведения в БП СделкиTn.
//
// Параметры:
// БизнесПроцесс - БизнесПроцессСсылка - ссылка на бизнес-процесс, для которого выполняется отмена шагов.
// БезОтменыПроведенияСделки - Булево - если Истина, для документа типа Сделка отмена проведения не выполняется.
//
// Пример:
// ExchDU_ОтменитьШагиБизнесПроцессаАвтоматически(БПСсылка, Истина);
//
Процедура ExchDU_ОтменитьШагиБизнесПроцессаАвтоматически(БизнесПроцесс, БезОтменыПроведенияСделки = Ложь) Экспорт
	
	Если НЕ БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗнч(БизнесПроцесс)) Тогда 
		Возврат; 
	КонецЕсли;

	Если БизнесПроцесс.Пустая() Тогда 
		Возврат; 
	КонецЕсли;

	Ошибки = Неопределено;
	УстановитьПривилегированныйРежим(Истина);

	Если ДатыЗапретаИзменения.ИзменениеЗапрещено(БизнесПроцесс) Тогда
		Отказ = Истина;
		ОписаниеОшибки = "Установлена дата запрета";
		ТекстСообщения = "Не удалось отменить все шаги бизнес-процесса: " + БизнесПроцесс + " по причине: "+ ОписаниеОшибки;
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "", ТекстСообщения, "", , , );
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
		Возврат; 
	КонецЕсли;

	Отказ = Ложь;
	Если БизнесПроцесс.Завершен Тогда

		ОбъектБП = БизнесПроцесс.ПолучитьОбъект();
		Если ОбъектБП.Завершен = Истина Тогда
			ОбъектБП.Завершен = Ложь;
			ОбъектБП.ДатаЗавершения = '00010101';
			Попытка
				ОбъектБП.Записать();
			Исключение
				Отказ=Истина;			
				ОписаниеОшибки = Строка(ОписаниеОшибки());
				ТекстСообщения = Нстр("ru = 'Не удалось переоткрыть: " + БизнесПроцесс + " по причине: ';"+ ОписаниеОшибки);
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,"",ТекстСообщения,"",,,);
			КонецПопытки;
		КонецЕсли;

	КонецЕсли;

	Если Отказ Тогда Возврат; КонецЕсли;

	// Помечаем на удаление все задачи по бизнес-процессу за исключением точки маршрута "УстановкаНастроекБП".
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВнебиржеваяСделка.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ВнебиржеваяСделка КАК ВнебиржеваяСделка
	|ГДЕ
	|	ВнебиржеваяСделка.БизнесПроцесс = &БизнесПроцесс
	|	И НЕ ВнебиржеваяСделка.ПометкаУдаления";

	Запрос.УстановитьПараметр("БизнесПроцесс", БизнесПроцесс);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Попытка
			ТекЗадача = Выборка.Ссылка.ПолучитьОбъект();
			Если ТекЗадача.ТочкаМаршрута <> ТочкиМаршрута.УстановкаНастроекБП Тогда
				ТекЗадача.ПометкаУдаления 		= Истина;
				ТекЗадача.Выполнена 			= Истина;
				ТекЗадача.ОбменДанными.Загрузка = Истина;
			Иначе
				ТекЗадача.Выполнена = Ложь;
			КонецЕсли;
			ТекЗадача.Записать();
		Исключение
			Отказ = Истина;
			ОписаниеОшибки = Строка(ОписаниеОшибки());
			ТекстСообщения = Нстр("ru = 'Не удалось отменить задачу: " + Выборка.Ссылка + " по причине: ';"+ ОписаниеОшибки);
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,"",ТекстСообщения,"",,,);
		КонецПопытки;

	КонецЦикла;

	// Отменяем проведение у всех документов бизнес-процесса.
	МассивСсылок = КритерииОтбора.ДокументыПоБизнеспроцессам.Найти(БизнесПроцесс);
	Для каждого ТекДок Из МассивСсылок Цикл

		Если ТекДок.Проведен = Истина Тогда
			Попытка
				// IMDEV-8772 ++
				// В сценарии СделкиTn документ Сделка уже проведен ранее.
				// Пропускаем отмену проведения, чтобы исключить повторный цикл проведения.
				Если БезОтменыПроведенияСделки И ТипЗнч(ТекДок) = Тип("ДокументСсылка.Сделка") Тогда
					Продолжить;
				Иначе
					ДокОбъект  = ТекДок.ПолучитьОбъект();
					ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				// IMDEV-8772 --
			Исключение
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры
