Функция XML(Данные) Экспорт 
    
    ЗаписьXML = Новый ЗаписьXML();
    ЗаписьXML.УстановитьСтроку();
    СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Данные);
    
    Возврат ЗаписьXML.Закрыть();
    
КонецФункции

Функция ДанныеИзXML(Стр) Экспорт
    
    ЧтениеXML = Новый ЧтениеXML();
    ЧтениеXML.УстановитьСтроку(Стр);
    
    Возврат СериализаторXDTO.ПрочитатьXML(ЧтениеXML); 
    
КонецФункции

#Область ОптимизацияПоПортфелям

// Выполняет операции с документами в фоновом режиме с разбивкой по портфелям для больших объемов данных.
// Цель: Оптимизировать обработку больших данных, минимизировать таймауты и нагрузку на сервер.
//
// Параметры:
//  ДанныеXML          - Строка - XML-строка с таблицей документов.
//  ИдентификаторПотока - Строка - Уникальный идентификатор потока.
//  ПараметрыОбработки - Структура - Настройки обработки (ПорогПерекоса, МаксЗаданий, МаксВремяЗадания, МаксВремяОбщее, ПорогАктивныхЗаданий, ВыполнятьЗавершающиеДействия).
//
Процедура ВыполнениеОперацийСДокументамиБП(ДанныеXML, ИдентификаторПотока, ПараметрыОбработки = Неопределено) Экспорт
	
	// Установка параметров по умолчанию.
	Настройки = Новый Структура;
	Настройки.Вставить("ПорогПерекоса", 1000);
	Настройки.Вставить("МаксЗаданий", 15); // +++ Увеличен лимит до 15 заданий
	Настройки.Вставить("МаксВремяЗадания", 14400); // 4 часа
	Настройки.Вставить("МаксВремяОбщее", 12 * 3600); // 12 часов
	Настройки.Вставить("ПорогАктивныхЗаданий", 50);
	Настройки.Вставить("ВыполнятьЗавершающиеДействия", Истина);
	Если ПараметрыОбработки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Настройки, ПараметрыОбработки);
	КонецЕсли;
	
	// Преобразование XML в таблицу значений.
	ИмяСобытияЖР = "Портфели потока [" + ИдентификаторПотока + "]";
	Попытка
		ТЗДокументыБП = ДанныеИзXML(ДанныеXML);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , ,
		"Ошибка преобразования XML: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
	// Проверка количества активных фоновых заданий.
	АктивныеЗадания = 0;
	Попытка
		СостояниеФоновыхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно));
		АктивныеЗадания = СостояниеФоновыхЗаданий.Количество();
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , ,
		"Ошибка проверки активных фоновых заданий: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
	Если ТЗДокументыБП.Количество() < Настройки.ПорогПерекоса Или АктивныеЗадания >= Настройки.ПорогАктивныхЗаданий Тогда
		// Прямая обработка для малого объема данных или при высокой нагрузке сервера.
		Если АктивныеЗадания >= Настройки.ПорогАктивныхЗаданий Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Предупреждение, , ,
			"Слишком много активных фоновых заданий (" + АктивныеЗадания + "), используется последовательная обработка несмотря на " +
			"превышение порога в " + Настройки.ПорогПерекоса + " строк.");
		КонецЕсли;
		
		Для Каждого СтрокаДанные Из ТЗДокументыБП Цикл
			Попытка
				Выполнить("Выполнение_" + СтрокаДанные.ИмяОперации + "(СтрокаДанные)");
			Исключение
				ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , ,
				"Ошибка выполнения операции " + СтрокаДанные.ИмяОперации + ": " +
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
		КонецЦикла;
	Иначе
		// Проверка состояния сервера для определения допустимого количества заданий.
		ДопустимоеКоличествоЗаданий = Мин(Настройки.МаксЗаданий, Макс(5, 20 - АктивныеЗадания / 10));
		
		// Создание массива для отслеживания фоновых заданий.
		МассивФоновыхЗаданий = Новый Массив;
		
		// Массив для накопления заданий с ошибками.
		МассивЗаданийСОшибкой = Новый Массив;
		
		// Создание менеджера временных таблиц.
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		// Помещение таблицы во временную таблицу.
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Таблица.РегСвед КАК РегСвед,
		|	Таблица.Измерение КАК Измерение,
		|	Таблица.ИмяОперации КАК ИмяОперации,
		|	Таблица.ОбъектДляОперации КАК ОбъектДляОперации,
		|	Таблица.Портфель КАК Портфель,
		|	Таблица.ИдентификаторПотока КАК ИдентификаторПотока,
		|	Таблица.ПройденныеШаги КАК ПройденныеШаги
		|ПОМЕСТИТЬ ВТ_Документы
		|ИЗ
		|	&Таблица КАК Таблица";
		Запрос.УстановитьПараметр("Таблица", ТЗДокументыБП);
		Запрос.Выполнить();
		
		// Получение уникального списка портфелей через запрос.
		// Добавлен подсчет количества объектов по каждому портфелю и сортировка по убыванию количества
		// для запуска заданий от самых больших портфелей к самым маленьким - это позволит
		// запустить длительные операции раньше, потенциально сократив общее время ожидания завершения всех заданий.
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТ_Документы.Портфель КАК Портфель,
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	ВТ_Документы КАК ВТ_Документы
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Документы.Портфель
		|
		|УПОРЯДОЧИТЬ ПО
		|	Количество УБЫВ";
		ТЗПортфели = Запрос.Выполнить().Выгрузить();
		
		// Индексация таблицы для ускорения поиска.
		ТЗДокументыБП.Индексы.Добавить("Портфель");
		
		// Разделение данных по портфелям и запуск фоновых заданий.
		Для Каждого СтрПортфель Из ТЗПортфели Цикл
			// Фильтрация строк через запрос.
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ВТ_Документы.РегСвед КАК РегСвед,
			|	ВТ_Документы.Измерение КАК Измерение,
			|	ВТ_Документы.ИмяОперации КАК ИмяОперации,
			|	ВТ_Документы.ОбъектДляОперации КАК ОбъектДляОперации,
			|	ВТ_Документы.Портфель КАК Портфель,
			|	ВТ_Документы.ИдентификаторПотока КАК ИдентификаторПотока,
			|	ВТ_Документы.ПройденныеШаги КАК ПройденныеШаги
			|ИЗ
			|	ВТ_Документы КАК ВТ_Документы
			|ГДЕ
			|	ВТ_Документы.Портфель = &Портфель";
			Запрос.УстановитьПараметр("Портфель", СтрПортфель.Портфель);
			ТЗДокументыБППоПотоку = Запрос.Выполнить().Выгрузить();
			
			// Расчет динамической паузы.
			КоличествоОбъектов = СтрПортфель.Количество;
			Если КоличествоОбъектов <= 10 Тогда
				ПаузаСек = 0.1;
			ИначеЕсли КоличествоОбъектов >= 1000 Тогда
				ПаузаСек = 5;
			ИначеЕсли КоличествоОбъектов >= 100 Тогда
				ПаузаСек = 3;
			Иначе
				ПаузаСек = 0.1 + (КоличествоОбъектов - 10) * (3 - 0.1) / (100 - 10);
			КонецЕсли;
			ПаузаСек = Окр(ПаузаСек, 3);
			
			// Преобразование таблицы в XML для передачи в фоновое задание.
			Попытка
				ДанныеXMLПоПотоку = ExchDU_ОбработкаОбъектовПослеЗагрузки.XML(ТЗДокументыБППоПотоку);
			Исключение
				ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , СтрПортфель.Портфель,
				"Ошибка преобразования таблицы в XML для портфеля " + СтрПортфель.Портфель + ": " +
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			
			// Подготовка параметров для фонового задания.
			ПараметрыФоновогоЗадания = Новый Массив;
			ПараметрыФоновогоЗадания.Добавить(ДанныеXMLПоПотоку);
			
			// Запуск фонового задания.
			Попытка
				Задание = ФоновыеЗадания.Выполнить(
				"ExchDU_ОбработкаОбъектовПослеЗагрузки.ВыполнениеПоПортфелямОперацийСДокументамиБП",
				ПараметрыФоновогоЗадания,
				ИдентификаторПотока + "_" + Строка(СтрПортфель.Портфель),
				ИмяСобытияЖР + " (" + СтрПортфель.Портфель + ")");
			Исключение
				ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , СтрПортфель.Портфель,
				"Ошибка запуска фонового задания для портфеля " + СтрПортфель.Портфель + ": " +
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			
			// Логирование запуска.
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация, , СтрПортфель.Портфель,
			"Запущено фоновое задание для портфеля: " + СтрПортфель.Портфель + ", строк: " + КоличествоОбъектов +
			", ключ: " + ИдентификаторПотока + "_" + Строка(СтрПортфель.Портфель));
			
			// Добавление информации о задании.
			НоваяЗапись = Новый Структура;
			НоваяЗапись.Вставить("Портфель", СтрПортфель.Портфель);
			НоваяЗапись.Вставить("ФоновоеЗадание", Задание);
			НоваяЗапись.Вставить("Завершен", Ложь);
			НоваяЗапись.Вставить("Отказ", Ложь);
			НоваяЗапись.Вставить("ТекстОшибки", "");
			НоваяЗапись.Вставить("ПаузаСекунды", ПаузаСек);
			НоваяЗапись.Вставить("ВремяЗапуска", ТекущаяДатаСеанса());
			МассивФоновыхЗаданий.Добавить(НоваяЗапись);
			
			// Ожидание с учетом текущей нагрузки.
			ОжидатьЗавершенияФоновыхЗаданий(ИмяСобытияЖР, МассивФоновыхЗаданий, ДопустимоеКоличествоЗаданий, Настройки, МассивЗаданийСОшибкой);
			
		КонецЦикла;
		
		// Ожидание завершения всех заданий.
		ОжидатьЗавершенияФоновыхЗаданий(ИмяСобытияЖР, МассивФоновыхЗаданий, 0, Настройки, МассивЗаданийСОшибкой);
		
		// Проверка ошибок из накопленного массива.
		Для Каждого Задание Из МассивЗаданийСОшибкой Цикл
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , Задание.Портфель,
			"Фоновое задание для портфеля " + Задание.Портфель + " завершилось с ошибкой: " + Задание.ТекстОшибки);
		КонецЦикла;
		
		// Логирование завершения.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация, , ,
		"Завершена обработка документов по портфелям в фоновом режиме");
		
		// Очистка менеджера временных таблиц.
		МенеджерВременныхТаблиц.Закрыть();
	КонецЕсли;
	
	// Завершающие действия (если разрешены).
	Если Настройки.ВыполнятьЗавершающиеДействия Тогда
		// Установка статуса завершения.
		УстановкаСостоянияПотока(ИдентификаторПотока, Перечисления.ExchDU_СостояниеОбработки.Обработан);
		
		// Запуск сделок FX (IMDEV-5292, N.Filimonova, 17.11.2023).
		СтартСделокFX(ИдентификаторПотока);
	КонецЕсли;
	
КонецПроцедуры

// Ожидает завершения фоновых заданий с учетом текущей нагрузки сервера.
// Цель: Обеспечить завершение заданий с минимальной нагрузкой и обработкой ошибок.
//
// Параметры:
//  ИмяСобытияЖР               - Строка - Имя события для журнала регистрации.
//  МассивФоновыхЗаданий       - Массив - Массив структур с информацией о заданиях.
//  МаксКоличествоВОжидании    - Число - Максимум одновременно выполняемых заданий.
//  Настройки                  - Структура - Параметры обработки (МаксВремяЗадания, МаксВремяОбщее).
//  МассивЗаданийСОшибкой      - Массив - Массив для накопления заданий с ошибками (по ссылке).
//
Процедура ОжидатьЗавершенияФоновыхЗаданий(ИмяСобытияЖР,
	МассивФоновыхЗаданий,
	МаксКоличествоВОжидании,
	Настройки,
	МассивЗаданийСОшибкой = Неопределено)
	
	ОбщееВремяОжиданияЗавершенияФоновых = 0;
	
	Пока Истина Цикл
		КоличествоНеЗавершенных = 0;
		НовыйМассивФоновыхЗаданий = Новый Массив;
		
		// Проверка состояния каждого задания.
		Для Каждого ТекущееЗадание Из МассивФоновыхЗаданий Цикл
			Если ТекущееЗадание.Завершен Тогда
				Продолжить;
			КонецЕсли;
			
			КоличествоНеЗавершенных = КоличествоНеЗавершенных + 1;
			
			ЗаданиеЕстьОшибкиВыполнения = Ложь;
			ОписаниеОшибки = "";
			
			// Проверка времени выполнения задания.
			Если ТекущаяДатаСеанса() - ТекущееЗадание.ВремяЗапуска > Настройки.МаксВремяЗадания Тогда
				Попытка
					ТекущееЗадание.ФоновоеЗадание.Отменить();
					ЗаданиеЕстьОшибкиВыполнения = Истина;
					ОписаниеОшибки = "Задание превысило максимальное время выполнения (" + Настройки.МаксВремяЗадания + " сек).";
				Исключение
					ОписаниеОшибки = "Ошибка при попытке отмены задания: " +
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
			Иначе
				Попытка
					ЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(ТекущееЗадание.ФоновоеЗадание.УникальныйИдентификатор);
				Исключение
					ЗаданиеЕстьОшибкиВыполнения = Истина;
					ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
			КонецЕсли;
			
			// Обработка ошибок или завершения.
			Если ЗаданиеЕстьОшибкиВыполнения Тогда
				ТекущееЗадание.Завершен = Истина;
				ТекущееЗадание.Отказ = Истина;
				ТекущееЗадание.ТекстОшибки = ОписаниеОшибки;
			ИначеЕсли ЗаданиеВыполнено Тогда
				ТекущееЗадание.Завершен = Истина;
			КонецЕсли;
			
			// Логирование завершения.
			Если ТекущееЗадание.Завершен Тогда
				ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация, , ТекущееЗадание.Портфель,
				"Завершено фоновое задание для портфеля: " + ТекущееЗадание.Портфель +
				?(ТекущееЗадание.Отказ, " с ошибкой: " + ТекущееЗадание.ТекстОшибки, ""));
				
				// Добавление задания с ошибкой в массив.
				Если ТекущееЗадание.Отказ И МассивЗаданийСОшибкой <> Неопределено Тогда
					МассивЗаданийСОшибкой.Добавить(ТекущееЗадание);
				КонецЕсли;
			Иначе
				НовыйМассивФоновыхЗаданий.Добавить(ТекущееЗадание);
			КонецЕсли;
		КонецЦикла;
		
		// Обновление массива.
		МассивФоновыхЗаданий = НовыйМассивФоновыхЗаданий;
		
		// Проверка завершения.
		Если КоличествоНеЗавершенных < МаксКоличествоВОжидании Или КоличествоНеЗавершенных = 0 Тогда
			Прервать;
		КонецЕсли;
		
		// Расчет динамической паузы.
		МинПаузаСек = 3;
		Для Каждого ТекЗадание Из МассивФоновыхЗаданий Цикл
			Если ТекЗадание.ПаузаСекунды < МинПаузаСек Тогда
				МинПаузаСек = ТекЗадание.ПаузаСекунды;
			КонецЕсли;
		КонецЦикла;
		Если МинПаузаСек < 0.1 Тогда
			МинПаузаСек = 0.1;
		КонецЕсли;
		
		// Пауза.
		ВызватьПаузу(МинПаузаСек * 1000);
		ОбщееВремяОжиданияЗавершенияФоновых = ОбщееВремяОжиданияЗавершенияФоновых + МинПаузаСек;
		
		// Проверка общего времени.
		Если ОбщееВремяОжиданияЗавершенияФоновых > Настройки.МаксВремяОбщее Тогда
			Для Каждого ТекущееЗадание Из МассивФоновыхЗаданий Цикл
				Попытка
					ТекущееЗадание.ФоновоеЗадание.Отменить();
					ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , ТекущееЗадание.Портфель,
					"Задание для портфеля " + ТекущееЗадание.Портфель + " отменено из-за превышения времени ожидания.");
				Исключение
					ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка, , ТекущееЗадание.Портфель,
					"Ошибка отмены задания для портфеля " + ТекущееЗадание.Портфель + ": " +
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЦикла;
			ВызватьИсключение "Превышено максимальное время ожидания завершения фоновых заданий.";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Выполняет операции с документами для одного портфеля в фоновом режиме.
// Цель: Обеспечить атомарную обработку данных по портфелю с минимальными конфликтами.
//
// Параметры:
//  ДанныеXML - Строка - XML-строка с таблицей документов для портфеля.
//
Процедура ВыполнениеПоПортфелямОперацийСДокументамиБП(ДанныеXML) Экспорт
	
	// Получение таблицы из XML.
	Попытка
		ТаблицаБПДокументыПоПортфелю = ДанныеИзXML(ДанныеXML);
	Исключение
		ЗаписьЖурналаРегистрации("Обработка портфеля", УровеньЖурналаРегистрации.Ошибка, , ,
		"Ошибка преобразования XML в таблицу: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
	// Пакетная обработка строк (по 1000 строк) без транзакций.
	РазмерПакета = 1000;
	КоличествоСтрок = ТаблицаБПДокументыПоПортфелю.Количество();
	КоличествоПакетов = Цел((КоличествоСтрок + РазмерПакета - 1) / РазмерПакета);
	
	Для НомерПакета = 1 По КоличествоПакетов Цикл
		НачалоПакета = (НомерПакета - 1) * РазмерПакета;
		КонецПакета = Мин(НачалоПакета + РазмерПакета - 1, КоличествоСтрок - 1);
		
		// Обработка строк пакета без транзакции.
		Для Индекс = НачалоПакета По КонецПакета Цикл
			Попытка
				СтрокаДанные = ТаблицаБПДокументыПоПортфелю[Индекс];
				Выполнить("Выполнение_" + СтрокаДанные.ИмяОперации + "(СтрокаДанные)");
			Исключение
				ЗаписьЖурналаРегистрации("Обработка портфеля", УровеньЖурналаРегистрации.Ошибка, , ,
				"Ошибка обработки строки " + (Индекс + 1) + ": " +
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		
		// Логирование прогресса только для непустых пакетов и если пакетов больше одного.
		Если КоличествоПакетов > 1 И КонецПакета >= НачалоПакета Тогда
			ЗаписьЖурналаРегистрации("Обработка портфеля", УровеньЖурналаРегистрации.Информация, , ,
			"Обработан пакет №" + НомерПакета + ": " + (КонецПакета - НачалоПакета + 1) + 
			" строк, всего обработано: " + (КонецПакета + 1) + " из " + КоличествоСтрок + " строк");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
Процедура СтартСделокFX(ИдентификаторПотока)
//{[+] IMDEV-5292 N.Filimonova 17.11.2023
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ExchDU_СписокДокументовДляПроведения.ДокументДляПроведения КАК ДокументДляПроведения
		|ИЗ
		|	РегистрСведений.ExchDU_СписокДокументовДляПроведения КАК ExchDU_СписокДокументовДляПроведения
		|ГДЕ
		|	ExchDU_СписокДокументовДляПроведения.ДокументДляПроведения ССЫЛКА Документ.СделкаНаВалютномРынке
		|	И ExchDU_СписокДокументовДляПроведения.ИдентификаторПотока = &ИдентификаторПотока";
	
	Запрос.УстановитьПараметр("ИдентификаторПотока", ИдентификаторПотока);

	СделкиНаВалютномРынке = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументДляПроведения");
	
	ВнешняяОбработкаИсполненияСделокFX = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Исполнение сделок FX");	
	ОбъектОбработкиИсполнения = ДополнительныеОтчетыИОбработки.ПолучитьОбъектВнешнейОбработки(ВнешняяОбработкаИсполненияСделокFX); 
	
	Отказ = Ложь;
	ТекстСообщения = "";
	ТекстРассылки = "";
	БылиОшибки = Ложь;
	
	СозданныеДокументы = ОбъектОбработкиИсполнения.СоздатьПерезаполнитьОперацииПоДокументуОснованию(СделкиНаВалютномРынке, БылиОшибки, ТекстСообщения, Истина, Ложь, Ложь);
	
	Для Каждого ДокументСтруктура Из СозданныеДокументы Цикл 
		Документ = ДокументСтруктура.Документ; 
		Если Документ.Дата <= КонецДня(ТекущаяДата()) Тогда
			ДокументОбъект = Документ.ПолучитьОбъект();   
			ЗаписатьДокумент(ДокументОбъект, СозданныеДокументы, РежимЗаписиДокумента.Проведение, ТекстСообщения, БылиОшибки);
		КонецЕсли;
	КонецЦикла;   
	
	
	Если БылиОшибки Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
		Комментарий = "Во время исполнения плановых позиций произошла ошибка";
	Иначе
		Уровень = УровеньЖурналаРегистрации.Информация;
		Комментарий = "Исполнение плановых позиций выполнено успешно";
	КонецЕсли;
		
	// Запись в журнал регистрации
	Комментарий = Комментарий + Символы.ПС + Комментарий;
	ЗаписьЖурналаРегистрации("Запуск операций после обмена ДУ->ФИН. Фоновое исполнение сделок FX", Уровень, , , Комментарий);   
	
	Задача 					= Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
	Задача.Дата 			= ТекущаяДата();
	Задача.ВидОбмена 		= "Запуск операций после обмена ДУ->ФИН";
	Задача.Наименование 	= "Исполнение сделок FX" + Комментарий;
	Задача.Описание =  ТекстСообщения;
	Задача.ВыполнитьЗадачу();
	
	//} IMDEV-5292 N.Filimonova
КонецПроцедуры

