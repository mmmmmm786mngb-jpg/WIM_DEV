		КонецЕсли;
		// AVANCORE  - 31.10.2017 }
	КонецЕсли;
	// AVANCORE  - 13.07.2017 }	
	
	УстановкаСтатусаОбработкиОбъекта(СтрокаДанные, Ошибки, ТекстСообщенияОбОшибке); 

