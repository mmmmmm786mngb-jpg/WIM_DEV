Функция ПолучитьТекущиеШагиБП(БПСсылка, ЗавершенныеШаги)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БизнесПроцесс", БПСсылка);
	Запрос.УстановитьПараметр("ЗавершенныеШаги", ЗавершенныеШаги);  // AVANCORE  - 18.10.2017
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВнебиржеваяСделка.ТочкаМаршрута КАК ТочкаМаршрутаСсылка,
		|	ВнебиржеваяСделка.ДатаИсполнения,
		|	ВнебиржеваяСделка.ТочкаМаршрута.Представление КАК ТочкаМаршрута
		|ИЗ
		|	Задача.ВнебиржеваяСделка КАК ВнебиржеваяСделка
		|ГДЕ
		|	ВнебиржеваяСделка.БизнесПроцесс = &БизнесПроцесс
		|	И ВнебиржеваяСделка.Выполнена = &ЗавершенныеШаги  
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВнебиржеваяСделка.ДатаИсполнения";

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда 
		ТекущиеТочки = Новый Массив;
	КонецЕсли;
	
	ТаблицаТочек = Результат.Выгрузить();     // AVANCORE - 13.08.2017 
	ТекущиеТочки = ТаблицаТочек.ВыгрузитьКолонку("ТочкаМаршрута");
// AVANCORE  - 14.04.2017 }	

	Возврат ТекущиеТочки;
	
КонецФункции // ПолучитьТекущиеШагиБП()

Функция ПолучитьШагиБПДляЗакрытия(ТипБП)

	МассивШагов = Новый Массив;

	Если ТипБП = "ВнебиржеваяСделка" Тогда
		
		МассивШагов.Добавить("УстановкаНастроекБП");
		МассивШагов.Добавить("ОткрытиеПлановойПозиции");
		МассивШагов.Добавить("ПеречислитьАвансБрокер");
		МассивШагов.Добавить("ОплатаСделкиБанк");
		МассивШагов.Добавить("ОплатаКомиссииБрокера");
		МассивШагов.Добавить("ОплатаИнойКомиссии");
		МассивШагов.Добавить("Валютирование");
		МассивШагов.Добавить("РезервированиеРасходов");
		МассивШагов.Добавить("ОформитьДопРасходы");
		МассивШагов.Добавить("ОформитьСделку");
		
	ИначеЕсли ТипБП = "СделкиTn"  Тогда
		
		МассивШагов.Добавить("УстановкаНастроекБП");
		МассивШагов.Добавить("ОткрытиеПлановойПозиции");
		МассивШагов.Добавить("ОплатаСделки");
		МассивШагов.Добавить("ОплатаКомиссииБрокера");
		МассивШагов.Добавить("ОплатаКомиссииБиржи");
		МассивШагов.Добавить("Валютирование");
		МассивШагов.Добавить("ЗакрытиеПлановойПозиции");
		
	ИначеЕсли ТипБП = "СделкиРЕПО" Тогда
		
		МассивШагов.Добавить("УстановкаНастроекБП");
		МассивШагов.Добавить("ПерваяЧастьРЕПО");
		МассивШагов.Добавить("ОплатаКомиссииБиржиПерваяЧасть");
		МассивШагов.Добавить("ОплатаКомиссииБрокераПерваяЧасть");
		МассивШагов.Добавить("ОплатаПервойЧастиСделкиЧерезБрокера");
		МассивШагов.Добавить("ВтораяЧастьРЕПО");
		МассивШагов.Добавить("ОплатаКомиссииБиржиВтораяЧасть");
		МассивШагов.Добавить("ОплатаКомиссииБрокераВтораяЧасть");
		МассивШагов.Добавить("ОплатаВторойЧастиСделкиЧерезБрокера");
		
	// IMAPPS-32494 ++
	ИначеЕсли ТипБП = "СделкиНаСрочномРынке" Тогда
		
		МассивШагов.Добавить("УстановкаНастроекБП");
		МассивШагов.Добавить("ПроведениеСделкиНаСрочномРынке");
		МассивШагов.Добавить("ОплатаКомиссииБиржи");
		МассивШагов.Добавить("ОплатаКомиссииБрокера");
	// IMAPPS-32494 --
	
	КонецЕсли;
	
	Возврат МассивШагов;
	
КонецФункции // ПолучитьШагиБПДляЗакрытия()

Процедура Выполнение_СтартНовыхБАПослеЗагрузки(СтрокаДанные)
	
	БПСсылка 	= СтрокаДанные.ОбъектДляОперации;
	ТипБП 		= БПСсылка.Метаданные().Имя;
	Ошибки 		= Ложь; 

	Попытка
		
		БПОбъект = БПСсылка.ПолучитьОбъект();
		БПОбъект.Записать();
		Сообщить("Записан бизнес-процесс """+БПСсылка+""""+" "+ТекущаяДата());
		
	Исключение
		ТекстСообщенияОбОшибке = ("!!! Не удалось записать бизнес-процесс """+БПСсылка+""" по причине: "+ОписаниеОшибки());
		Сообщить(ТекстСообщенияОбОшибке);		
		Ошибки = Истина;
		
		////////// VTB-Borisov  - 18.04.2019 { 
		//////////какая-то непонятная ситуация когда в приемнике нет объекта по ссылке. 
		//////////пока делаем костыль
		////////Если Найти(ТекстСообщенияОбОшибке, "Объект не найден") <> 0 Тогда
		////////	Возврат;
		////////КонецЕсли;
		////////// VTB-Borisov  - 18.04.2019 }

	КонецПопытки;
	
	Если Не БПСсылка.ПометкаУдаления И Не Ошибки Тогда
		ТекстСообщенияОбОшибке = "";
		БизнесПроцессы[ТипБП].ВыполнитьШагБизнесПроцессаАвтоматически(БПСсылка,"Старт");
		// AVANCORE  - 18.10.2017 { 
		БизнесПроцессы[ТипБП].ВыполнитьШагБизнесПроцессаАвтоматически(БПСсылка,"УстановкаНастроекБП");
		ЗавершенныеШаги = Ложь;
		// AVANCORE  - 18.10.2017 } 
		
		ТекущиеТочки = ПолучитьТекущиеШагиБП(БПСсылка, ЗавершенныеШаги);

		Если ТипБП <> "СделкиРЕПО" Тогда
			Если ТекущиеТочки.Найти("Открытие плановой позиции") = Неопределено Тогда 
				ТекстСообщенияОбОшибке =ТекстСообщенияОбОшибке + Символы.ПС + "!!! Не удалось выполнить шаг бизнес-процесса """+БПСсылка+""" Старт";
				Сообщить(ТекстСообщенияОбОшибке);		
				Ошибки = Истина;
			КонецЕсли;
			
			
			Если ТипБП <> "ВнебиржеваяСделка" Тогда   
				БизнесПроцессы[ТипБП].ВыполнитьШагБизнесПроцессаАвтоматически(БПСсылка,"ОткрытиеПлановойПозиции");
				
				ТекущиеТочки = ПолучитьТекущиеШагиБП(БПСсылка, ЗавершенныеШаги);
				
				Если ТекущиеТочки.Найти("Перерегистрация ц/б") = Неопределено Тогда 
					ТекстСообщенияОбОшибке =ТекстСообщенияОбОшибке + Символы.ПС + "!!! Не удалось выполнить шаг бизнес-процесса """+БПСсылка+""" Открытие плановой позиции";
					Сообщить(ТекстСообщенияОбОшибке);		
					Ошибки = Истина;
				КонецЕсли;
			КонецЕсли;
				
		Иначе
			Если ТекущиеТочки.Найти("1-я часть РЕПО") = Неопределено Тогда 
				ТекстСообщенияОбОшибке =ТекстСообщенияОбОшибке + Символы.ПС + "!!! Не удалось выполнить шаг бизнес-процесса """+БПСсылка+""" Старт";
				Сообщить(ТекстСообщенияОбОшибке);		
				Ошибки = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	УстановкаСтатусаОбработкиОбъекта(СтрокаДанные, Ошибки, ТекстСообщенияОбОшибке);

КонецПроцедуры // Выполнение_СтартНовыхБАПослеЗагрузки()

Процедура Выполнение_ЗавершениеНовыхБППослеЗагрузки(СтрокаДанные)

	БПСсылка 	= СтрокаДанные.ОбъектДляОперации;
	ТипБП 		= БПСсылка.Метаданные().Имя;
	Ошибки	 	= Ложь; 

	Попытка
		БПОбъект = БПСсылка.ПолучитьОбъект();
		БПОбъект.Записать();
		Сообщить("Записан бизнес-процесс """+БПСсылка+""""+" "+ТекущаяДата());
	Исключение
		ТекстСообщенияОбОшибке = ("!!! Не удалось записать бизнес-процесс """+БПСсылка+""" по причине: "+ОписаниеОшибки());
		Сообщить(ТекстСообщенияОбОшибке);
		Ошибки = Истина;
		
		//////// VTB-Borisov  - 18.04.2019 { 
		////////какая-то непонятная ситуация когда в приемнике нет объекта по ссылке. 
		////////пока делаем костыль
		//////Если Найти(ТекстСообщенияОбОшибке, "Объект не найден") <> 0 Тогда
		//////	Возврат;
		//////КонецЕсли;
		//////// VTB-Borisov  - 18.04.2019 }

	КонецПопытки;
	
	// AVANCORE  - 31.10.2017 {
	
	МассивШагов = Новый Массив;
	
	Если Не БПСсылка.ПометкаУдаления И не Ошибки Тогда
		ТекстСообщенияОбОшибке = "";
		БизнесПроцессы[ТипБП].ВыполнитьШагБизнесПроцессаАвтоматически(БПСсылка,"Старт");
		Если НЕ БПСсылка.Стартован Тогда
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке + Символы.ПС + "!!! Не удалось выполнить шаг бизнес-процесса """+БПСсылка+""" " + "Старт";
			Сообщить(ТекстСообщенияОбОшибке);		
			Ошибки = Истина;
		КонецЕсли;
		
		// AVANCORE  - 31.10.2017 {

		МассивШагов = ПолучитьШагиБПДляЗакрытия(ТипБП);
			
		// AVANCORE  - 31.10.2017 }
		
		
		Для Каждого Шаг Из МассивШагов Цикл
			Если  Ошибки Тогда 
				Прервать; 
			КонецЕсли;
			
			Попытка
				БизнесПроцессы[ТипБП].ВыполнитьШагБизнесПроцессаАвтоматически(БПСсылка, Шаг);
			Исключение
				ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке + Символы.ПС + "!!! Не удалось выполнить шаг бизнес-процесса """+БПСсылка+""" " + Шаг;
				Сообщить(ТекстСообщенияОбОшибке);		
				Ошибки = Истина;
			КонецПопытки;
		КонецЦикла;
		Если Не Ошибки И НЕ БПСсылка.Завершен Тогда
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке + Символы.ПС + "!!! Не удалось завершить бизнес-процесс """+БПСсылка+"""";
			Сообщить(ТекстСообщенияОбОшибке);		
			Ошибки = Истина;
		КонецЕсли;
	КонецЕсли;
	// AVANCORE  - 31.10.2017 }
	
	УстановкаСтатусаОбработкиОбъекта(СтрокаДанные, Ошибки, ТекстСообщенияОбОшибке);

КонецПроцедуры // Выполнение_ЗавершениеНовыхБППослеЗагрузки()

