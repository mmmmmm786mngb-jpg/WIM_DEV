								<Value xsi:type="xs:string">НДФЛ Управление</Value>
							</Property>
							<Property name="ТекстЗапроса">
								<Value xsi:type="xs:string">// Описание: Единая таблица по табличным частям документа НачислениеНДФЛПоУправляющейКомпании за день.
// Параметры:
// &amp;НачалоДня - Дата
// &amp;КонецДня - Дата
// &amp;ПОВсемКлиентам - Булево
// &amp;Клиенты - Массив/СписокЗначений (СправочникСсылка.Контрагенты)
//
// Как задать период за 1 день:
// 1) Через дату:
//    &amp;НачалоДня = НачалоДня(&amp;ДатаСреза)
//    &amp;КонецДня = КонецДня(&amp;ДатаСреза)
//
// 2) Пример на фиксированную дату:
//    &amp;НачалоДня = НачалоДня('2026-04-30')
//    &amp;КонецДня = КонецДня('2026-04-30')
//
// Примеры:
// 1) По всем клиентам:
//    &amp;ПОВсемКлиентам = Истина
//    &amp;Клиенты = Неопределено
//
// 2) По списку клиентов:
//    &amp;ПОВсемКлиентам = Ложь
//    &amp;Клиенты = &lt;Массив или СписокЗначений ссылок на Контрагенты&gt;
ВЫБРАТЬ
	"НачислениеНДФЛПоУправляющейКомпании" КАК ВидДокумента,
	"Выводы" КАК ТабличнаяЧасть,
	ТЧ.Ссылка КАК Ссылка,
	ТЧ.Ссылка.Дата КАК ДатаДокумента,
	ТЧ.Ссылка.Номер КАК НомерДокумента,
	ТЧ.Портфель КАК Портфель,
	ТЧ.СуммаВывода КАК СуммаВывода,
	NULL КАК РаспределятьОбщиеРасходы,
	NULL КАК Закрытие,
	NULL КАК КодВычета,
	NULL КАК КодДохода,
	NULL КАК НалогооблагаемаяCумма,
	NULL КАК Ставка,
	NULL КАК ТипДохода,
	NULL КАК СуммаВычета,
	NULL КАК СуммаДохода,
	NULL КАК СуммаКЗачету,
	NULL КАК СуммаКУдержанию,
	NULL КАК СуммаРанееУдержанногоНДФЛ,
	NULL КАК ФинансовыйРезультат,
	NULL КАК ИзменениеФинРезультата,
	NULL КАК Пропорция,
	NULL КАК Система,
	NULL КАК Сумма
ИЗ
	Документ.НачислениеНДФЛПоУправляющейКомпании.Выводы КАК ТЧ
ГДЕ
	ТЧ.Ссылка.Дата МЕЖДУ &amp;НачалоДня И &amp;КонецДня
	И ТЧ.Ссылка.Проведен
	И (&amp;ПОВсемКлиентам
			ИЛИ ТЧ.Ссылка.Клиент В (&amp;Клиенты))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"НачислениеНДФЛПоУправляющейКомпании",
	"ОбщиеРасходы",
	ТЧ.Ссылка,
	ТЧ.Ссылка.Дата,
	ТЧ.Ссылка.Номер,
	ТЧ.Портфель,
	NULL,
	ТЧ.РаспределятьОбщиеРасходы,
	ТЧ.Закрытие,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL
ИЗ
	Документ.НачислениеНДФЛПоУправляющейКомпании.ОбщиеРасходы КАК ТЧ
ГДЕ
	ТЧ.Ссылка.Дата МЕЖДУ &amp;НачалоДня И &amp;КонецДня
	И ТЧ.Ссылка.Проведен
	И (&amp;ПОВсемКлиентам
			ИЛИ ТЧ.Ссылка.Клиент В (&amp;Клиенты))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"НачислениеНДФЛПоУправляющейКомпании",
