										</Property>
										<Property name="ТекстЗапроса">
											<Value xsi:type="xs:string">// Описание: Единая таблица по табличным частям документа НачислениеНДФЛПоПортфелю за день.
// Параметры:
// &amp;НачалоДня - Дата
// &amp;КонецДня - Дата
// &amp;ПОВсемКлиентам - Булево
// &amp;Клиенты - Массив/СписокЗначений (СправочникСсылка.Контрагенты)
//
// Как задать период за 1 день:
// 1) Через дату:
//    &amp;НачалоДня = НачалоДня(&amp;ДатаСреза)
//    &amp;КонецДня = КонецДня(&amp;ДатаСреза)
//
// 2) Пример на фиксированную дату:
//    &amp;НачалоДня = НачалоДня('2026-04-30')
//    &amp;КонецДня = КонецДня('2026-04-30')
//
// Примеры:
// 1) По всем клиентам:
//    &amp;ПОВсемКлиентам = Истина
//    &amp;Клиенты = Неопределено
//
// 2) По списку клиентов:
//    &amp;ПОВсемКлиентам = Ложь
//    &amp;Клиенты = &lt;Массив или СписокЗначений ссылок на Контрагенты&gt;
ВЫБРАТЬ
	"НачислениеНДФЛПоПортфелю" КАК ВидДокумента,
	"Начисления" КАК ТабличнаяЧасть,
	ТЧ.Ссылка КАК Ссылка,
	ТЧ.Ссылка.Дата КАК ДатаДокумента,
	ТЧ.Ссылка.Номер КАК НомерДокумента,  ТЧ.Ссылка.ПОртфель,
	NULL КАК ВидРасхода,
	ТЧ.КодДохода КАК КодДохода,
	ТЧ.КодВычета КАК КодВычета,
	ТЧ.НалогооблагаемаяCумма КАК НалогооблагаемаяCумма,
	ТЧ.Ставка КАК Ставка,
	ТЧ.ТипДохода КАК ТипДохода,
	ТЧ.СуммаВычета КАК СуммаВычета,
	ТЧ.СуммаДохода КАК СуммаДохода,
	NULL КАК СуммаРанееУдержанногоНДФЛ,
	NULL КАК СуммаКУдержанию,
	NULL КАК СуммаИсчисленногоНалога,
	NULL КАК УплаченныйНДФЛ,
	NULL КАК Сумма
ИЗ
	Документ.НачислениеНДФЛПоПортфелю.Начисления КАК ТЧ
ГДЕ
	ТЧ.Ссылка.Дата МЕЖДУ &amp;НачалоДня И &amp;КонецДня
	И ТЧ.Ссылка.Проведен
	И (&amp;ПОВсемКлиентам
			ИЛИ ТЧ.Ссылка.Портфель.Клиент В (&amp;Клиенты))  И ТЧ.КодДохода.Код  = "1531" И ТЧ.НалогооблагаемаяCумма &lt;&gt; 0

УПОРЯДОЧИТЬ ПО
	ВидДокумента,
	ТабличнаяЧасть,
	Ссылка,
	ДатаДокумента,
	НомерДокумента,
	ВидРасхода,
	КодДохода,
	КодВычета,
	НалогооблагаемаяCумма,
	Ставка,
	ТипДохода,
	СуммаВычета,
	СуммаДохода,
	СуммаРанееУдержанногоНДФЛ,
	СуммаКУдержанию,
	СуммаИсчисленногоНалога,
	УплаченныйНДФЛ,
	Сумма</Value>
