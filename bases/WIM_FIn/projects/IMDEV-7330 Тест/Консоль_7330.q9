	И ТЧ.Ссылка.Проведен
	И (&amp;ПОВсемКлиентам
			ИЛИ ТЧ.Ссылка.Клиент В (&amp;Клиенты))

УПОРЯДОЧИТЬ ПО
	ВидДокумента,
	ТабличнаяЧасть,
	Ссылка,
	ДатаДокумента,
	НомерДокумента,
	Портфель,
	СуммаВывода,
	РаспределятьОбщиеРасходы,
	Закрытие,
	КодВычета,
	КодДохода,
	НалогооблагаемаяCумма,
	Ставка,
	ТипДохода,
	СуммаВычета,
	СуммаДохода,
	СуммаКЗачету,
	СуммаКУдержанию,
