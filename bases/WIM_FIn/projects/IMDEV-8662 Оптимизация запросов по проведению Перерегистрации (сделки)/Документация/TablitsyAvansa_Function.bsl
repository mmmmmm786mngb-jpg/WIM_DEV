// Фрагмент модуля объекта документа Сделка: функция ТаблицыАванса.
// Назначение: вариант для сравнения с базовой конфигурацией (IMDEV-8662).
// Текст запроса: ВТ Реквизиты, ВТ доп. расходов, итоговое ОБЪЕДИНИТЬ — для получения ТаблицаДокумента достаточно Выполнить().Выгрузить().
// Запрос по ЗачетАвансов выполняется отдельно только при СпособЗачетаАвансов = ПоДокументу.

Функция ТаблицыАванса(Отказ)

    ТаблицыПроведенияАванса = Новый Структура;

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("СчетДопРасходов", ?(СчетУчетаДопРасходов.Пустая(), СчетУчетаРасчетовСКонтрагентом, СчетУчетаДопРасходов));
    Запрос.УстановитьПараметр("Ссылка", Ссылка);

    ТекстЗапроса =
    "ВЫБРАТЬ
    |   Реквизиты.Ссылка КАК Ссылка,
    |   Реквизиты.Контрагент КАК Контрагент,
    |   Реквизиты.ДоговорКонтрагента КАК ДоговорКонтрагента,
    |   Реквизиты.СчетУчетаРасчетовСКонтрагентом КАК СчетУчетаРасчетовСКонтрагентом,
    |   Реквизиты.СчетУчетаРасчетовПоАвансам КАК СчетУчетаРасчетовПоАвансам,
    |   Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
    |   Реквизиты.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
    |   Реквизиты.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
    |   ВЫРАЗИТЬ(Реквизиты.Сумма КАК ЧИСЛО(15, 2)) КАК СуммаВзаиморасчетов,
    |   ВЫРАЗИТЬ(Реквизиты.НКД КАК ЧИСЛО(15, 2)) КАК НКД
    |ПОМЕСТИТЬ Реквизиты
    |ИЗ
    |   Документ.Сделка КАК Реквизиты
    |ГДЕ
    |   Реквизиты.Ссылка = &Ссылка
    |   И Реквизиты.ДоговорКонтрагента <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   СделкаДопРасходы.НомерСтроки КАК НомерСтроки,
    |   ВЫРАЗИТЬ(СделкаДопРасходы.Стоимость КАК ЧИСЛО(15, 2)) КАК СуммаВзаиморасчетов,
    |   СделкаДопРасходы.Контрагент КАК Контрагент,
    |   СделкаДопРасходы.ДоговорКонтрагента КАК ДоговорКонтрагента,
    |   СделкаДопРасходы.ВалютаКомиссии КАК ВалютаКомиссии,
    |   СделкаДопРасходы.КурсКомиссии КАК КурсКомиссии,
    |   СделкаДопРасходы.КратностьКомиссии КАК КратностьКомиссии
    |ПОМЕСТИТЬ ТаблицаДанныхПоДопРасходам
    |ИЗ
    |   Документ.Сделка.ДопРасходы КАК СделкаДопРасходы
    |ГДЕ
    |   СделкаДопРасходы.Ссылка = &Ссылка
    |   И СделкаДопРасходы.ТолькоВЕПС = ЛОЖЬ
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ""Взаиморасчеты"" КАК ИмяТаблицы,
    |   0 КАК НомерСтроки,
    |   Реквизиты.Ссылка КАК ДокументРасчетов,
    |   Реквизиты.СчетУчетаРасчетовСКонтрагентом КАК СчетРасчетов,
    |   Реквизиты.СчетУчетаРасчетовПоАвансам КАК СчетАвансов,
    |   Реквизиты.Контрагент КАК Контрагент,
    |   Реквизиты.ДоговорКонтрагента КАК ДоговорКонтрагента,
    |   Реквизиты.ВалютаДокумента КАК ВалютаВзаиморасчетов,
    |   Реквизиты.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
    |   Реквизиты.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
    |   Реквизиты.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов
    |ИЗ
    |   Реквизиты
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |   ""НКД"" КАК ИмяТаблицы,
    |   0 КАК НомерСтроки,
    |   Реквизиты.Ссылка КАК ДокументРасчетов,
    |   Реквизиты.СчетУчетаРасчетовСКонтрагентом КАК СчетРасчетов,
    |   Реквизиты.СчетУчетаРасчетовПоАвансам КАК СчетАвансов,
    |   Реквизиты.Контрагент КАК Контрагент,
    |   Реквизиты.ДоговорКонтрагента КАК ДоговорКонтрагента,
    |   Реквизиты.ВалютаДокумента КАК ВалютаВзаиморасчетов,
    |   Реквизиты.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
    |   Реквизиты.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
    |   Реквизиты.НКД КАК СуммаВзаиморасчетов
    |ИЗ
    |   Реквизиты
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |   ""ДопРасходы"" КАК ИмяТаблицы,
    |   ТаблицаДанныхПоДопРасходам.НомерСтроки КАК НомерСтроки,
    |   Реквизиты.Ссылка КАК ДокументРасчетов,
    |   &СчетДопРасходов КАК СчетРасчетов,
    |   &СчетДопРасходов КАК СчетАвансов,
    |   ТаблицаДанныхПоДопРасходам.Контрагент КАК Контрагент,
    |   ТаблицаДанныхПоДопРасходам.ДоговорКонтрагента КАК ДоговорКонтрагента,
    |   ВЫБОР
    |       КОГДА ТаблицаДанныхПоДопРасходам.ВалютаКомиссии = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
    |           ТОГДА Реквизиты.ВалютаДокумента
    |       ИНАЧЕ ТаблицаДанныхПоДопРасходам.ВалютаКомиссии
    |   КОНЕЦ КАК ВалютаВзаиморасчетов,
    |   ВЫБОР
    |       КОГДА ТаблицаДанныхПоДопРасходам.ВалютаКомиссии = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
    |           ТОГДА Реквизиты.КурсВзаиморасчетов
    |       ИНАЧЕ ТаблицаДанныхПоДопРасходам.КурсКомиссии
    |   КОНЕЦ КАК КурсВзаиморасчетов,
    |   ВЫБОР
    |       КОГДА ТаблицаДанныхПоДопРасходам.ВалютаКомиссии = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
    |           ТОГДА Реквизиты.КратностьВзаиморасчетов
    |       ИНАЧЕ ТаблицаДанныхПоДопРасходам.КратностьКомиссии
    |   КОНЕЦ КАК КратностьВзаиморасчетов,
    |   ТаблицаДанныхПоДопРасходам.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов
    |ИЗ
    |   Реквизиты
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхПоДопРасходам КАК ТаблицаДанныхПоДопРасходам
    |       ПО ИСТИНА";

    Запрос.Текст = ТекстЗапроса;

    ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "" + Ссылка + "Документ.Сделка.МодульОбъекта:ТаблицыАванса");

    ТаблицыПроведенияАванса.Вставить("ТаблицаДокумента", Запрос.Выполнить().Выгрузить());

    Если СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда

        ЗапросДокументыАвансов = Новый Запрос;
        ЗапросДокументыАвансов.УстановитьПараметр("Ссылка", Ссылка);
        ЗапросДокументыАвансов.Текст =
        "ВЫБРАТЬ
        |   ТаблицаЗачетАвансов.НомерСтроки КАК НомерСтроки,
        |   РеквизитыШапки.СчетУчетаРасчетовПоАвансам КАК СчетАвансов,
        |   РеквизитыШапки.Контрагент КАК Контрагент,
        |   РеквизитыШапки.ДоговорКонтрагента КАК ДоговорКонтрагента,
        |   ТаблицаЗачетАвансов.ДокументАванса КАК ДокументАванса,
        |   ТаблицаЗачетАвансов.СуммаЗачета КАК СуммаЗачета
        |ИЗ
        |   Документ.Сделка.ЗачетАвансов КАК ТаблицаЗачетАвансов
        |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК РеквизитыШапки
        |       ПО ТаблицаЗачетАвансов.Ссылка = РеквизитыШапки.Ссылка
        |ГДЕ
        |   ТаблицаЗачетАвансов.Ссылка = &Ссылка
        |   И РеквизитыШапки.СпособЗачетаАвансов = ЗНАЧЕНИЕ(Перечисление.СпособыЗачетаАвансов.ПоДокументу)
        |
        |УПОРЯДОЧИТЬ ПО
        |   НомерСтроки";

        ТаблицыПроведенияАванса.Вставить("ТаблицаДокументыАвансов", ЗапросДокументыАвансов.Выполнить().Выгрузить());

    Иначе

        ПустаяТаблицаДокументыАвансов = Новый ТаблицаЗначений;
        ПустаяТаблицаДокументыАвансов.Колонки.Добавить("НомерСтроки");
        ПустаяТаблицаДокументыАвансов.Колонки.Добавить("СчетАвансов");
        ПустаяТаблицаДокументыАвансов.Колонки.Добавить("Контрагент");
        ПустаяТаблицаДокументыАвансов.Колонки.Добавить("ДоговорКонтрагента");
        ПустаяТаблицаДокументыАвансов.Колонки.Добавить("ДокументАванса");
        ПустаяТаблицаДокументыАвансов.Колонки.Добавить("СуммаЗачета");
        ТаблицыПроведенияАванса.Вставить("ТаблицаДокументыАвансов", ПустаяТаблицаДокументыАвансов);

    КонецЕсли;

    Возврат ТаблицыПроведенияАванса;

КонецФункции
