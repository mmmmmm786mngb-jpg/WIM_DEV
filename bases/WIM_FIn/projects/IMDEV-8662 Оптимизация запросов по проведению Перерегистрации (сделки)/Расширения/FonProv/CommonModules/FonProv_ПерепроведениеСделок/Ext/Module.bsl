#Область ПрограммныйИнтерфейс

// Описание: Перепроводит проведенные документы Сделка за период с отбором по портфелю и пулу портфеля.
// Документы выбираются запросом и упорядочиваются по полю МоментВремени.
//
// Параметры:
// Параметры - Структура - обязательные ключи: НачалоПериода (Дата), КонецПериода (Дата);
//   необязательные: Портфель (СправочникСсылка.Портфели), Пул (СправочникСсылка.Пул).
// АдресРезультата - Строка - адрес временного хранилища результата (передается подсистемой длительных операций БСП).
//
Процедура ПерепровестиСделки(Параметры, АдресРезультата) Экспорт

	ПредыдущийПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ПерепровестиСделкиВнутр(Параметры);
	Исключение
		УстановитьПривилегированныйРежим(ПредыдущийПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПредыдущийПривилегированныйРежим);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Выполняет перепроведение сделок (внутренняя реализация, вызывается в привилегированном режиме).
//
// Параметры:
// Параметры - Структура - см. описание процедуры ПерепровестиСделки.
//
Процедура ПерепровестиСделкиВнутр(Параметры)

	Если Параметры = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не переданы параметры перепроведения сделок.'");
	КонецЕсли;

	НачалоПериода = Неопределено;
	КонецПериода = Неопределено;
	Если Не Параметры.Свойство("НачалоПериода", НачалоПериода) Или Не ЗначениеЗаполнено(НачалоПериода) Тогда
		ВызватьИсключение НСтр("ru = 'Не указано начало периода.'");
	КонецЕсли;
	Если Не Параметры.Свойство("КонецПериода", КонецПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан конец периода.'");
	КонецЕсли;
	Если НачалоПериода > КонецПериода Тогда
		ВызватьИсключение НСтр("ru = 'Начало периода не может быть больше конца периода.'");
	КонецЕсли;

	ПортфельПараметр = Неопределено;
	Параметры.Свойство("Портфель", ПортфельПараметр);
	ПулПараметр = Неопределено;
	Параметры.Свойство("Пул", ПулПараметр);

	ОтборПортфельНеИспользуется = Не ЗначениеЗаполнено(ПортфельПараметр);
	ОтборПулНеИспользуется = Не ЗначениеЗаполнено(ПулПараметр);

	НачалоДняПериода = НачалоДня(НачалоПериода);
	КонецДняПериода = КонецДня(КонецПериода);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сделка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Сделка КАК Сделка
	|ГДЕ
	|	Сделка.Проведен
	|	И Сделка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И (&ОтборПортфельНеИспользуется
	|		ИЛИ Сделка.Портфель = &Портфель)
	|	И (&ОтборПулНеИспользуется
	|		ИЛИ Сделка.Портфель.Пул = &Пул)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сделка.МоментВремени";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДняПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДняПериода);
	Запрос.УстановитьПараметр("ОтборПортфельНеИспользуется", ОтборПортфельНеИспользуется);
	Запрос.УстановитьПараметр("Портфель", ПортфельПараметр);
	Запрос.УстановитьПараметр("ОтборПулНеИспользуется", ОтборПулНеИспользуется);
	Запрос.УстановитьПараметр("Пул", ПулПараметр);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	КоличествоСделок = 0;
	КоличествоОшибок = 0;
	ТекстыОшибок = Новый Массив;

	Пока Выборка.Следующий() Цикл
		КоличествоСделок = КоличествоСделок + 1;
		Попытка
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Сделка %1: %2'"),
				Строка(Выборка.Ссылка),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ТекстыОшибок.Добавить(ТекстОшибки);
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'FonProv.Перепроведение сделок'"),
				УровеньЖурналаРегистрации.Ошибка,
				,
				Выборка.Ссылка,
				ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	Если КоличествоОшибок > 0 Тогда
		Сводка = СтрСоединить(ТекстыОшибок, Символы.ПС);
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибки перепроведения сделок: %1 из %2. Подробности:%3%4'"),
			КоличествоОшибок,
			КоличествоСделок,
			Символы.ПС,
			Сводка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
