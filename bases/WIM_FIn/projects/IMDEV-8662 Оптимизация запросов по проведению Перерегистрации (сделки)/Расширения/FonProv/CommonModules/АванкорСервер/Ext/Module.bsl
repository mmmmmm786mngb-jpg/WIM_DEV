// IMDEV-8662, стр. Пауза
// Описание: Перехват процедуры Пауза общего модуля АванкорСервер.
// В фоновом контексте используется встроенный метод ВызватьПаузу (миллисекунды).
// В клиент-серверном вызове пауза выполняется через ПаузаБСП.
//
// Параметры:
// КолМС - Число - длительность паузы в миллисекундах.
//
&Вместо("Пауза")
Процедура FonProv_Пауза(КолМС) Экспорт

    ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
    ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();

    Если Не ФоновоеЗадание = Неопределено Тогда
        ВызватьПаузу(КолМС);
    Иначе
        Секунд = Цел(КолМС / 1000);
        Если Секунд <= 0 Тогда
            Секунд = 1;
        КонецЕсли;
        ПаузаБСП(Секунд);
    КонецЕсли;

КонецПроцедуры

// IMDEV-8662, стр. Пауза
// Описание: Реализация паузы через фоновое задание по аналогии с IMAPPS-31419.
//
// Параметры:
// Секунд - Число - длительность паузы в секундах.
//
Процедура ПаузаБСП(Секунд) Экспорт

    ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
    ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();

    Если ФоновоеЗадание = Неопределено Тогда
        Параметры = Новый Массив;
        КолМСДляФона = Цел(Секунд * 1000);
        Если КолМСДляФона <= 0 Тогда
            КолМСДляФона = 1;
        КонецЕсли;
        Параметры.Добавить(КолМСДляФона);

        ФоновоеЗадание = ФоновыеЗадания.Выполнить("АванкорСервер.Пауза", Параметры);
    КонецЕсли;

    Попытка
        ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Секунд);
    Исключение
        Возврат;
    КонецПопытки;

КонецПроцедуры
