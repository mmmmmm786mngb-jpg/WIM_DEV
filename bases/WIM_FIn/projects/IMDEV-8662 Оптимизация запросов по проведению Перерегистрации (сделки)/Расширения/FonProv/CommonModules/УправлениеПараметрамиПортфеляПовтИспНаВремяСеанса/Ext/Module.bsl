// Описание: Возвращает пустое значение по реквизиту «ТипЗначения» элемента ПВХ «Параметры портфеля».
// Повторное использование возвращаемых значений общего модуля (на время сеанса) кэширует результат по ссылке «Параметр».
//
// Параметры:
// Параметр - ПланВидовХарактеристикСсылка.ПараметрыПортфеля - элемент, для которого нужно пустое значение.
//
// Возвращаемое значение:
// Произвольный - пустое значение заданного типа.
//
Функция ПустоеЗначениеПараметраПортфеля(Параметр) Экспорт

	Возврат Параметр.ТипЗначения.ПривестиЗначение();

КонецФункции

// Описание: Перехват &ИзменениеИКонтроль функции СлужебныеПараметрыУчета (IMDEV-8662).
// В цикле подстановки пустых значений вызывается ПустоеЗначениеПараметраПортфеля для кэширования ПовтИсп на время сеанса.
//
&ИзменениеИКонтроль("СлужебныеПараметрыУчета")
Функция FonProv_СлужебныеПараметрыУчета(Портфель, Дата) Экспорт
	Перем Результат;

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗначенияПараметровПортфеляСрезПоследних.Параметр КАК Параметр,
		|	ЗначенияПараметровПортфеляСрезПоследних.Значение КАК Значение
		|ПОМЕСТИТЬ ВТ_ЗначенияПараметровУчета
		|ИЗ
		|	РегистрСведений.ЗначенияПараметровПортфеля.СрезПоследних(&ДатыУчетаПараметровПортфеля, Портфель = &Портфель) КАК ЗначенияПараметровПортфеляСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПараметрыПортфеля.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ВозможныеЗначенияПараметров
		|ИЗ
		|	ПланВидовХарактеристик.ПараметрыПортфеля КАК ПараметрыПортфеля
		|ГДЕ
		|	НЕ ПараметрыПортфеля.ЭтоГруппа
		|	И НЕ ПараметрыПортфеля.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВозможныеЗначенияПараметров.Ссылка КАК Параметр,
		|	ВТ_ВозможныеЗначенияПараметров.Ссылка.ИмяПредопределенныхДанных КАК ИмяПараметра,
		|	ЕСТЬNULL(ВТ_ЗначенияПараметровУчета.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
		|ИЗ
		|	ВТ_ВозможныеЗначенияПараметров КАК ВТ_ВозможныеЗначенияПараметров
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗначенияПараметровУчета КАК ВТ_ЗначенияПараметровУчета
		|		ПО ВТ_ВозможныеЗначенияПараметров.Ссылка = ВТ_ЗначенияПараметровУчета.Параметр";

	Запрос.УстановитьПараметр("ДатыУчетаПараметровПортфеля", Дата);
	Запрос.УстановитьПараметр("Портфель", Портфель);

	Результат = Запрос.Выполнить().Выгрузить();
	Отбор = Новый Структура;
	Отбор.Вставить("Значение", Неопределено);
	СтрокиСНеопределеннымЗначением = Результат.НайтиСтроки(Отбор);

	Для Каждого СтрокаТЗ Из СтрокиСНеопределеннымЗначением Цикл
		#Удаление
		СтрокаТЗ.Значение  = СтрокаТЗ.Параметр.ТипЗначения.ПривестиЗначение();
		#КонецУдаления
		#Вставка
		СтрокаТЗ.Значение  = УправлениеПараметрамиПортфеляПовтИспНаВремяСеанса.ПустоеЗначениеПараметраПортфеля(СтрокаТЗ.Параметр);
		#КонецВставки
	КонецЦикла;

	Возврат Результат;

КонецФункции
