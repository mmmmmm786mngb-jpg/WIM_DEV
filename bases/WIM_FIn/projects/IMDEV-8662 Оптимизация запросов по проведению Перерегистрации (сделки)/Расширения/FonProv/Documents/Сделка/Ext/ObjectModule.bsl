// Оптимизация IMDEV-8662 (строка ~1769): не меняем текст запроса ПолучитьСуммуОНВ.
// Ускорение достигается переносом вызова ПолучитьСуммуОНВ из этапа "подготовка параметров" в место фактического использования
// (СформироватьДвиженияРеализация) и добавлением проверки ЗначениеЗаполнено перед Итог("СуммаОНВ").

&ИзменениеИКонтроль("УстановкаДополнительныхПараметровПроведения")
Процедура FonProv_УстановкаДополнительныхПараметровПроведения(Отказ)
	
	МассивПараметров = Новый Массив;
	
	МассивПараметров.Добавить(ПВХ_Параметры.ПорогВключенияРасходовВСтоимость);
	МассивПараметров.Добавить(ПВХ_Параметры.МетодСписанияПоПартиям);
	МассивПараметров.Добавить(ПВХ_Параметры.ВестиРасчетыСБрокеромНа55);
	МассивПараметров.Добавить(ПВХ_Параметры.СчетВыручки);
	МассивПараметров.Добавить(ПВХ_Параметры.СчетСписанияСебестоимости);
	МассивПараметров.Добавить(ПВХ_Параметры.СчетКомиссийПриПродаже);
	МассивПараметров.Добавить(ПВХ_Параметры.УчетЧастичногоПогашенияОблигаций);
	МассивПараметров.Добавить(ПВХ_Параметры.ВестиУчетУКДНаСчете58);
	МассивПараметров.Добавить(ПВХ_Параметры.ВестиУчетНКДНаСчете58);
	МассивПараметров.Добавить(ПВХ_Параметры.НалоговыйУчетДопРасходов);
	МассивПараметров.Добавить(ПВХ_Параметры.УчитыватьПогрешностьОкрПриСписанииПереоценки);
	МассивПараметров.Добавить(ПВХ_Параметры.РаздельныйАналитическийУчетУКДиНКД);
	МассивПараметров.Добавить(ПВХ_Параметры.РаздельныйАналитическийУчетСебестоимости);
	МассивПараметров.Добавить(ПВХ_Параметры.УчетУКДПоВидуОбращаемостиЦБ);
	МассивПараметров.Добавить(ПВХ_Параметры.РаздельныйУчетДопРасходовВключенныхВСтоимость);
	МассивПараметров.Добавить(ПВХ_Параметры.ПереоцениватьВалютныеЦБПриПродажеПогашении);
	МассивПараметров.Добавить(ПВХ_Параметры.ПереоцениватьТолькоВалютныеОФЗ);
	МассивПараметров.Добавить(ПВХ_Параметры.ОтражатьКредиторскуюЗадолженностьПоВУ);
	МассивПараметров.Добавить(ПВХ_Параметры.НачислениеВзаиморасчетовПоСделкеВДатуСделкиУУ);
	МассивПараметров.Добавить(ПВХ_Параметры.НачислениеВзаиморасчетовПоДопРасходамВДатуОплатыУУ);
	МассивПараметров.Добавить(ПВХ_Параметры.ПроводитьСуммуДопРасходовТранзитомЧерезСчетЗатрат);
	МассивПараметров.Добавить(ПВХ_Параметры.ОтражатьПогашениеНКДКакРеализацию);
	МассивПараметров.Добавить(ПВХ_Параметры.РасходыПоУКДПризнаватьВМоментВыбытияОблигации);
	МассивПараметров.Добавить(ПВХ_Параметры.НеАнализироватьСтарыеКупоныПриПогашенииНКД);
	МассивПараметров.Добавить(ПВХ_Параметры.КассовыйМетодУчетаРасходовНУ);
	МассивПараметров.Добавить(ПВХ_Параметры.СуммуПоАдреснымСделкамОтражатьЧерезКонтрпартнера);
	
	ДатаПараметровУП = ?(ЭтоБизнесПроцесс(), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БизнесПроцессСделкаОснование, "Дата"), Дата);
	ЗначенияПараметров = РегистрыСведений.ЗначенияПараметровПортфеля.ЗначенияПараметровПортфеля(Портфель, МассивПараметров, ДатаПараметровУП);
	
	ВалютаРегл    = ОбщегоНазначенияДУ.ВалютаРеглУчета(Портфель);
	
	// Счет брокера
	ВестиРасчетыНаСчете55 = ЗначенияПараметров.Получить(ПВХ_Параметры.ВестиРасчетыСБрокеромНа55);
	Если ВестиРасчетыНаСчете55=Истина Тогда
		СчетРасчетовБрокера = ПС.РасчетыБрокераПоСделкам55;
	Иначе
		СчетРасчетовБрокера = ПС.РасчетыБрокераПоСделкам;
	КонецЕсли;
	
	Если Справочники.ТорговыеБанковскиеСчета.ЭтоТБС(Актив) Тогда
		СчетРасчетовБрокера = ?(ВидОперации = Перечисления.ВидыОперацийСделка.Поступление, ПС.РасчетыПоПокупкамТБС, ПС.РасчетыПоПродажамТБС);
		ОбъектПоАктиву = Неопределено;
		ПереоцениватьЦБПоКурсуПродажи = Ложь;
	Иначе
		РеквизитыАктива = ОбщегоНазначенияДУВызовСервера.ЗначенияРеквизитовОбъекта(Актив, "Объект, ТипАктиваЦБРФ"); 
		ОбъектПоАктиву 	= РеквизитыАктива.Объект;   
		ПереоцениватьЦБПоКурсуПродажи = ?(ЗначенияПараметров.Получить(ПВХ_Параметры.ПереоцениватьТолькоВалютныеОФЗ) = Истина,
            РеквизитыАктива.ТипАктиваЦБРФ = ПланыВидовХарактеристик.КлассификаторЦБ.ОблигацииИсполнительнойВластиРФ, 
			ЗначенияПараметров.Получить(ПВХ_Параметры.ПереоцениватьВалютныеЦБПриПродажеПогашении) = Истина И Не АктивСерверПовтИсп.ЭтоАкция(Актив) = Истина);
	КонецЕсли;
	
	#Удаление
	ТаблицаОНВ = ПолучитьСуммуОНВ();
	#КонецУдаления
	#Вставка
	// Явно Неопределено: запрос ПолучитьСуммуОНВ перенесен в СформироватьДвиженияРеализация (ленивый вызов только при ветке НУ с облигацией и параметром портфеля),
	// чтобы не дергать остатки Хозрасчетный для большинства сделок и портфелей, где ОНВ к проводке не попадает.
	ТаблицаОНВ = Неопределено;
	#КонецВставки
	
	УстановитьПараметрыОблигации(Отказ);
	УстановитьСуммуДопРасходовРСБУ(Отказ); 
	
	УстановитьФлагиПереоценки();
	
	ВестиТолькоБухгалтерскийУчет		   = ПолныеПрава.РежимТолькоБухгалтерскийУчет();
	ВестиПолныйУчет  					   = НЕ ВестиТолькоБухгалтерскийУчет;
	ВестиУчетКупонногоДоходаВРазрезеПартий = Константы.ВестиУчетКупонногоДоходаВРазрезеПартий.Получить(); 
	ВестиУчетПереоценкиВРазрезеПартий 	   = Константы.ВестиУчетПереоценкиВРазрезеПартий.Получить();
	
	ОтражатьКредиторскуюЗадолженностьПоВУ  = ЗначенияПараметров.Получить(ПВХ_Параметры.ОтражатьКредиторскуюЗадолженностьПоВУ) = Истина;
	
	СтатьяКурсовыеРазницы = Справочники.СтатьиДоходовИРасходов.КурсовыеРазницыПоВалютнымЦБ;
	
КонецПроцедуры

&ИзменениеИКонтроль("СформироватьДвиженияРеализация")
Процедура FonProv_СформироватьДвиженияРеализация(ДополнительныеПараметрыПроведения, Отказ)
	
	Если Отказ Тогда 
		Возврат;  
	КонецЕсли;
	
	ОтражатьВНалоговомУчете = Истина;
	
	СчетОНВ = ПланыСчетов.Хозрасчетный.ОНВ;
	ПроводкаПоОНВ = Ложь;
	
	СчетВыручки = ЗначенияПараметров.Получить(ПВХ_Параметры.СчетВыручки);
	Если НЕ ЗначениеЗаполнено(СчетВыручки) Тогда
		СчетВыручки = ПС.Выручка;
	КонецЕсли;
	
	СуммаОНВ = 0;
	
	СуммаРеглАванс = СуммаРеглПослеЗачетаАванса("Взаиморасчеты", 0);
	Если СуммаРеглАванс = 0 Тогда
		СуммаВалЦБ = СуммаВВалютеНоминальнойСтоимости;
		СуммаРегл = МодульВалютногоУчета.ПересчитатьВВалютуУчета(Сумма, ВалютаДокумента, ВалютаРегл, КурсВзаиморасчетов, КратностьВзаиморасчетов);
	Иначе
		СуммаВалЦБ = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(СуммаРеглАванс, ВалютаРегл, ВалютаЦБ,	1, КурсЦБ, 1, КратностьЦБ);
		СуммаРегл = СуммаРеглАванс;
	КонецЕсли;
	
	Если ЭтоВексель = Истина И ВалютаЦБ = Справочники.Валюты.RUB Тогда
		ТаблицаПроцентыКСписанию = ПараметрыПроведения.ТаблицаПроцентыКСписанию;
		ИтогиПоПроцентам = ТаблицаПроцентыКСписанию.Итог("СуммаОстаток");
		СуммаРегл = СуммаРегл - ИтогиПоПроцентам; 
		СуммаВалЦБ = СуммаВалЦБ - ИтогиПоПроцентам;
	КонецЕсли;
		
	Проводка = Движения.Хозрасчетный.Добавить();
	
	Проводка.Период 	= Дата;
	Проводка.Портфель 	= Портфель;
	Проводка.Сумма 		= СуммаРегл;
	Проводка.Содержание = "Реализация активов";
	
	Если ВнебиржеваяСделка ИЛИ ЗначениеЗаполнено(ПлановаяПозиция) ИЛИ СделкаНапрямуюСБиржей Тогда
		Проводка.СчетДт = СчетУчетаРасчетовСКонтрагентом;
	Иначе
		Проводка.СчетДт = СчетРасчетовБрокера;
	КонецЕсли;
	
	Если Проводка.СчетДт.Родитель = ПС.РасчетыБрокера ИЛИ Проводка.СчетДт.Родитель = ПС.РасчетыБрокера55 Тогда
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "БрокерскиеСчета" , МестоХранения);
	Иначе
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Контрагенты", ?(Адресная И ДополнительныеПараметрыПроведения.СуммуПоАдреснымСделкамОтражатьЧерезКонтрпартнера, Контрпартнер, Контрагент));
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Договоры", ДоговорКонтрагента);
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "БанковскиеСчета", БанковскийСчет); 
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Партии", СделкаОснование); 
	КонецЕсли;
	БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "ДокументыРасчетовСКонтрагентами", ?(ЗначениеЗаполнено(БизнесПроцесс), БизнесПроцесс, Ссылка));
	БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "СтатьиДвиженияДенежныхСредств" , СтатьяДвиженияДенежныхСредств);
	Если НЕ Справочники.ТорговыеБанковскиеСчета.ЭтоТБС(Актив) Тогда
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Векселя", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Актив, "Объект"));
	КонецЕсли;
	СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетДт);
	
	Если СвойстваСчетаДт.Валютный Тогда
		Проводка.ВалютаДт 			= ВалютаДокумента;
		Проводка.ВалютнаяСуммаДт 	= Сумма;
	КонецЕсли;
	
	Проводка.СчетКт = СчетВыручки;		
	СтатьяДоходаРасхода = ?(ПараметрыПроведения.ЭтопогашениеВекселя, Справочники.СтатьиДоходовИРасходов.ПогашениеИныхЦенныхБумаг, Справочники.СтатьиДоходовИРасходов.ПродажаАктивов);
	
	БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "ВидыОбращаемостиЦБ", ?(ЗначениеЗаполнено(ВидОбращаемости), ВидОбращаемости, АктивСервер.ПолучитьВидОбращаемости(Актив, Дата)));
	БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "ЦенныеБумаги", Актив);
	БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "СтатьиДоходовИРасходов", СтатьяДоходаРасхода);
	
	СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетКт);
	
	Если СвойстваСчетаКт.Количественный Тогда
		Проводка.КоличествоКт = Количество;
	КонецЕсли;
	
	Если ОтражатьВНалоговомУчете Тогда
		Если НУ И СвойстваСчетаДт.НалоговыйУчет Тогда
			Проводка.СуммаНУДт = СуммаРегл;
		КонецЕсли;
		Если НУ И СвойстваСчетаКт.НалоговыйУчет Тогда
			Проводка.СуммаНУКт = СуммаРегл;
			
			НужнаПроводкаОНВ = ЗначенияПараметров.Получить(ПланыВидовХарактеристик.ПараметрыПортфеля.УчетЧастичногоПогашенияОблигаций) = Перечисления.УчетЧастичногоПогашенияОблигаций.ВСоставеДоходов;
			Если ТипЗнч(ОбъектПоАктиву) = Тип("СправочникСсылка.Облигации") И НужнаПроводкаОНВ Тогда
				#Вставка
				Если БУ Тогда
					Если Не ЗначениеЗаполнено(ТаблицаОНВ) Тогда
						ТаблицаОНВ = ПолучитьСуммуОНВ();
					КонецЕсли;
				КонецЕсли;
				#КонецВставки
				#Удаление
				СуммаОНВ 	= ТаблицаОНВ.Итог("СуммаОНВ");
				#КонецУдаления
				#Вставка
				Если ЗначениеЗаполнено(ТаблицаОНВ) Тогда
					СуммаОНВ = ТаблицаОНВ.Итог("СуммаОНВ");
				Иначе
					СуммаОНВ = 0;
				КонецЕсли;
				#КонецВставки
				СуммаОНВ = ?(СуммаОНВ = Неопределено, 0, СуммаОНВ);
				Проводка.СуммаНУКт = Проводка.СуммаНУКт + СуммаОНВ;
				ПроводкаПоОНВ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// ОНВ
	Если ПроводкаПоОНВ И СуммаОНВ > 0 Тогда
		
		Проводка 			= Движения.Хозрасчетный.Добавить();                                                                     
		Проводка.Период 	= Дата;
		Проводка.Портфель 	= Портфель;
		
		Проводка.СчетКт 	= СчетОНВ;
		
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Облигации", ОбъектПоАктиву);
		
		Проводка.Сумма 		= СуммаОНВ; 
		
	КонецЕсли;
	
	
	Для каждого СтрокаТЗ Из ТаблицаСписанныеАктивы Цикл
		СтрокаТЗпродажи = ТаблицаПродажи.НайтиСтроки(Новый Структура("Партия", СтрокаТЗ.Партия));
		Если СтрокаТЗпродажи.Количество() > 0 Тогда
			СтрокаТЗпродажи[0].Валюта = ВалютаЦБ;
			СтрокаТЗпродажи[0].Выручка  = (СуммаРегл/Количество)*СтрокаТЗ.Количество;
			СтрокаТЗпродажи[0].ВалютнаяСуммаВыручки = (СуммаВалЦБ/Количество)*СтрокаТЗ.Количество;
		Иначе
			НоваяСтрокаТЗпродажи = ТаблицаПродажи.Добавить();
			НоваяСтрокаТЗпродажи.Портфель = Портфель;
			НоваяСтрокаТЗпродажи.Актив = Актив;
			НоваяСтрокаТЗпродажи.Партия = СтрокаТЗ.Партия;
			НоваяСтрокаТЗпродажи.Количество = СтрокаТЗ.Количество;
			НоваяСтрокаТЗпродажи.Валюта = ВалютаЦБ;
			НоваяСтрокаТЗпродажи.Выручка = (СуммаРегл/Количество)*СтрокаТЗ.Количество;
			НоваяСтрокаТЗпродажи.ВалютнаяСуммаВыручки = (СуммаВалЦБ/Количество)*СтрокаТЗ.Количество
		КонецЕсли;
	КонецЦикла;
	
	Движения.Хозрасчетный.Записывать = Истина;
	
КонецПроцедуры

// Описание: Формирует структуру таблиц для проведения по авансам (подготовка данных для зачета авансов по сделке).
// Перехват базовой функции ТаблицыАванса (расширение, IMDEV-8662): основной запрос строит временные таблицы
// по реквизитам шапки и строкам доп. расходов, итоговая часть объединяет взаиморасчеты, НКД и доп. расходы;
// таблица результата помещается в ключ ТаблицаДокумента через Выполнить().Выгрузить(). Отдельный запрос
// к табличной части ЗачетАвансов выполняется только при способе зачета ПоДокументу, иначе под ключом
// ТаблицаДокументыАвансов возвращается пустая таблица значений с набором колонок, ожидаемым вызывающим кодом.
//
// Параметры:
// Отказ - Булево - признак отказа в операции (сигнатура как у базового метода; в данной реализации не изменяется).
//
// Возвращаемое значение:
// Структура - ключи: ТаблицаДокумента (ТаблицаЗначений), ТаблицаДокументыАвансов (ТаблицаЗначений).
//
// Пример:
// ТаблицыПроведенияАванса = ТаблицыАванса(Отказ);
//
&Вместо("ТаблицыАванса")
Функция FonProv_ТаблицыАванса(Отказ)

	ТаблицыПроведенияАванса = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетДопРасходов", ?(СчетУчетаДопРасходов.Пустая(), СчетУчетаРасчетовСКонтрагентом, СчетУчетаДопРасходов));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	ТекстЗапроса =
	"ВЫБРАТЬ
	|   Реквизиты.Ссылка КАК Ссылка,
	|   Реквизиты.Контрагент КАК Контрагент,
	|   Реквизиты.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|   Реквизиты.СчетУчетаРасчетовСКонтрагентом КАК СчетУчетаРасчетовСКонтрагентом,
	|   Реквизиты.СчетУчетаРасчетовПоАвансам КАК СчетУчетаРасчетовПоАвансам,
	|   Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|   Реквизиты.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|   Реквизиты.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|   ВЫРАЗИТЬ(Реквизиты.Сумма КАК ЧИСЛО(15, 2)) КАК СуммаВзаиморасчетов,
	|   ВЫРАЗИТЬ(Реквизиты.НКД КАК ЧИСЛО(15, 2)) КАК НКД
	|ПОМЕСТИТЬ Реквизиты
	|ИЗ
	|   Документ.Сделка КАК Реквизиты
	|ГДЕ
	|   Реквизиты.Ссылка = &Ссылка
	|   И Реквизиты.ДоговорКонтрагента <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|   СделкаДопРасходы.НомерСтроки КАК НомерСтроки,
	|   ВЫРАЗИТЬ(СделкаДопРасходы.Стоимость КАК ЧИСЛО(15, 2)) КАК СуммаВзаиморасчетов,
	|   СделкаДопРасходы.Контрагент КАК Контрагент,
	|   СделкаДопРасходы.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|   СделкаДопРасходы.ВалютаКомиссии КАК ВалютаКомиссии,
	|   СделкаДопРасходы.КурсКомиссии КАК КурсКомиссии,
	|   СделкаДопРасходы.КратностьКомиссии КАК КратностьКомиссии
	|ПОМЕСТИТЬ ТаблицаДанныхПоДопРасходам
	|ИЗ
	|   Документ.Сделка.ДопРасходы КАК СделкаДопРасходы
	|ГДЕ
	|   СделкаДопРасходы.Ссылка = &Ссылка
	|   И СделкаДопРасходы.ТолькоВЕПС = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|   ""Взаиморасчеты"" КАК ИмяТаблицы,
	|   0 КАК НомерСтроки,
	|   Реквизиты.Ссылка КАК ДокументРасчетов,
	|   Реквизиты.СчетУчетаРасчетовСКонтрагентом КАК СчетРасчетов,
	|   Реквизиты.СчетУчетаРасчетовПоАвансам КАК СчетАвансов,
	|   Реквизиты.Контрагент КАК Контрагент,
	|   Реквизиты.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|   Реквизиты.ВалютаДокумента КАК ВалютаВзаиморасчетов,
	|   Реквизиты.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|   Реквизиты.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|   Реквизиты.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов
	|ИЗ
	|   Реквизиты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|   ""НКД"" КАК ИмяТаблицы,
	|   0 КАК НомерСтроки,
	|   Реквизиты.Ссылка КАК ДокументРасчетов,
	|   Реквизиты.СчетУчетаРасчетовСКонтрагентом КАК СчетРасчетов,
	|   Реквизиты.СчетУчетаРасчетовПоАвансам КАК СчетАвансов,
	|   Реквизиты.Контрагент КАК Контрагент,
	|   Реквизиты.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|   Реквизиты.ВалютаДокумента КАК ВалютаВзаиморасчетов,
	|   Реквизиты.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|   Реквизиты.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|   Реквизиты.НКД КАК СуммаВзаиморасчетов
	|ИЗ
	|   Реквизиты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|   ""ДопРасходы"" КАК ИмяТаблицы,
	|   ТаблицаДанныхПоДопРасходам.НомерСтроки КАК НомерСтроки,
	|   Реквизиты.Ссылка КАК ДокументРасчетов,
	|   &СчетДопРасходов КАК СчетРасчетов,
	|   &СчетДопРасходов КАК СчетАвансов,
	|   ТаблицаДанныхПоДопРасходам.Контрагент КАК Контрагент,
	|   ТаблицаДанныхПоДопРасходам.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|   ВЫБОР
	|       КОГДА ТаблицаДанныхПоДопРасходам.ВалютаКомиссии = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|           ТОГДА Реквизиты.ВалютаДокумента
	|       ИНАЧЕ ТаблицаДанныхПоДопРасходам.ВалютаКомиссии
	|   КОНЕЦ КАК ВалютаВзаиморасчетов,
	|   ВЫБОР
	|       КОГДА ТаблицаДанныхПоДопРасходам.ВалютаКомиссии = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|           ТОГДА Реквизиты.КурсВзаиморасчетов
	|       ИНАЧЕ ТаблицаДанныхПоДопРасходам.КурсКомиссии
	|   КОНЕЦ КАК КурсВзаиморасчетов,
	|   ВЫБОР
	|       КОГДА ТаблицаДанныхПоДопРасходам.ВалютаКомиссии = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|           ТОГДА Реквизиты.КратностьВзаиморасчетов
	|       ИНАЧЕ ТаблицаДанныхПоДопРасходам.КратностьКомиссии
	|   КОНЕЦ КАК КратностьВзаиморасчетов,
	|   ТаблицаДанныхПоДопРасходам.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов
	|ИЗ
	|   Реквизиты
	|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхПоДопРасходам КАК ТаблицаДанныхПоДопРасходам
	|       ПО ИСТИНА";

	Запрос.Текст = ТекстЗапроса;

	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "" + Ссылка + "Документ.Сделка.МодульОбъекта:ТаблицыАванса");

	ТаблицыПроведенияАванса.Вставить("ТаблицаДокумента", Запрос.Выполнить().Выгрузить());

	Если СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда

		ЗапросДокументыАвансов = Новый Запрос;
		ЗапросДокументыАвансов.УстановитьПараметр("Ссылка", Ссылка);
		ЗапросДокументыАвансов.Текст =
		"ВЫБРАТЬ
		|   ТаблицаЗачетАвансов.НомерСтроки КАК НомерСтроки,
		|   РеквизитыШапки.СчетУчетаРасчетовПоАвансам КАК СчетАвансов,
		|   РеквизитыШапки.Контрагент КАК Контрагент,
		|   РеквизитыШапки.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|   ТаблицаЗачетАвансов.ДокументАванса КАК ДокументАванса,
		|   ТаблицаЗачетАвансов.СуммаЗачета КАК СуммаЗачета
		|ИЗ
		|   Документ.Сделка.ЗачетАвансов КАК ТаблицаЗачетАвансов
		|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК РеквизитыШапки
		|       ПО ТаблицаЗачетАвансов.Ссылка = РеквизитыШапки.Ссылка
		|ГДЕ
		|   ТаблицаЗачетАвансов.Ссылка = &Ссылка
		|   И РеквизитыШапки.СпособЗачетаАвансов = ЗНАЧЕНИЕ(Перечисление.СпособыЗачетаАвансов.ПоДокументу)
		|
		|УПОРЯДОЧИТЬ ПО
		|   НомерСтроки";

		ТаблицыПроведенияАванса.Вставить("ТаблицаДокументыАвансов", ЗапросДокументыАвансов.Выполнить().Выгрузить());

	Иначе

		ПустаяТаблицаДокументыАвансов = Новый ТаблицаЗначений;
		ПустаяТаблицаДокументыАвансов.Колонки.Добавить("НомерСтроки");
		ПустаяТаблицаДокументыАвансов.Колонки.Добавить("СчетАвансов");
		ПустаяТаблицаДокументыАвансов.Колонки.Добавить("Контрагент");
		ПустаяТаблицаДокументыАвансов.Колонки.Добавить("ДоговорКонтрагента");
		ПустаяТаблицаДокументыАвансов.Колонки.Добавить("ДокументАванса");
		ПустаяТаблицаДокументыАвансов.Колонки.Добавить("СуммаЗачета");
		ТаблицыПроведенияАванса.Вставить("ТаблицаДокументыАвансов", ПустаяТаблицаДокументыАвансов);

	КонецЕсли;

	Возврат ТаблицыПроведенияАванса;

КонецФункции

// Описание: Возвращает текст запроса для получения остатков авансов без поля СуммаНУ.
//
// Параметры:
// ИспользуетсяСубконтоДокументы - Булево - признак использования субконто "Документы расчетов с контрагентами".
//
// Возвращаемое значение:
// Строка - текст запроса для Запрос.Текст.
//
&Вместо("ТекстЗапроса_ПолучитьАвансы")
Функция FonProv_ТекстЗапроса_ПолучитьАвансы(ИспользуетсяСубконтоДокументы)
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Остатки.Счет КАК Счет,
	               |	Остатки.Валюта КАК Валюта,
	               |	Остатки.Субконто1 КАК Контрагент,
	               |	Остатки.Субконто2 КАК ДоговорКонтрагента,
	               |	Остатки.Субконто3 КАК ДокументРасчетов,
	               |	Остатки.СуммаОстатокДт КАК СуммаОстатокДт,
	               |	ВЫБОР
	               |		КОГДА &ЭтоПоступление
	               |			ТОГДА 0
	               |		ИНАЧЕ Остатки.СуммаОстатокКт
	               |	КОНЕЦ КАК СуммаОстатокКт,
	               |	Остатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
	               |	ВЫБОР
	               |		КОГДА &ЭтоПоступление
	               |			ТОГДА 0
	               |		ИНАЧЕ Остатки.ВалютнаяСуммаОстатокКт
	               |	КОНЕЦ КАК ВалютнаяСуммаОстатокКт
	               |ПОМЕСТИТЬ ОстаткиАвансов
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.Остатки(
	               |			&МоментВремениОстатков,
	               |			Счет В (&СчетаАвансов),
	               |			&мВидыСубконто,
	               |			Портфель = &Портфель
	               |				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты) В (&Контрагент)
	               |				И ВЫРАЗИТЬ(Субконто2 КАК Справочник.ДоговорыКонтрагентов) В (&ДоговорКонтрагента)
	               |				И Валюта = &Валюта) КАК Остатки
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Счет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОстаткиАвансов.Счет КАК Счет,
	               |	ОстаткиАвансов.Валюта КАК Валюта,
	               |	ОстаткиАвансов.Контрагент КАК Контрагент,
	               |	ОстаткиАвансов.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ОстаткиАвансов.ДокументРасчетов КАК ДокументРасчетов,
	               |	ВЫБОР
	               |		КОГДА &ЭтоПоступление
	               |			ТОГДА ОстаткиАвансов.СуммаОстатокДт
	               |		ИНАЧЕ ОстаткиАвансов.СуммаОстатокКт
	               |	КОНЕЦ КАК СуммаБУ,
	               |	ВЫБОР
	               |		КОГДА &ЭтоПоступление
	               |			ТОГДА ОстаткиАвансов.ВалютнаяСуммаОстатокДт
	               |		ИНАЧЕ ОстаткиАвансов.ВалютнаяСуммаОстатокКт
	               |	КОНЕЦ КАК СуммаВзаиморасчетов,
	               |	ЛОЖЬ КАК ДопРасходы
	               |ИЗ
	               |	ОстаткиАвансов КАК ОстаткиАвансов
	               |ГДЕ
	               |	ОстаткиАвансов.Счет В(&СчетАвансовВзаиморасчетов)
	               |	И ВЫБОР
	               |			КОГДА &ЭтоПоступление
	               |				ТОГДА ОстаткиАвансов.ВалютнаяСуммаОстатокДт
	               |			ИНАЧЕ ОстаткиАвансов.ВалютнаяСуммаОстатокКт
	               |		КОНЕЦ > 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОстаткиАвансов.Счет,
	               |	ОстаткиАвансов.Валюта,
	               |	ОстаткиАвансов.Контрагент,
	               |	ОстаткиАвансов.ДоговорКонтрагента,
	               |	ОстаткиАвансов.ДокументРасчетов,
	               |	ОстаткиАвансов.СуммаОстатокДт,
	               |	ОстаткиАвансов.ВалютнаяСуммаОстатокДт,
	               |	ИСТИНА
	               |ИЗ
	               |	ОстаткиАвансов КАК ОстаткиАвансов
	               |ГДЕ
	               |	ОстаткиАвансов.Счет В(&СчетДопРасходов)
	               |	И ОстаткиАвансов.ВалютнаяСуммаОстатокДт > 0";
	
	Если ИспользуетсяСубконтоДокументы Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&мВидыСубконто", "");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.Субконто3", "Неопределено");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Описание: Возвращает пустую таблицу остатков авансов без колонки СуммаНУ.
//
// Возвращаемое значение:
// ТаблицаЗначений - таблица с колонками остатков авансов для зачета.
//
&ИзменениеИКонтроль("ПустаяТаблицаОстаткиАвансов")
Функция FonProv_ПустаяТаблицаОстаткиАвансов()
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("Счет");
	ПустаяТаблица.Колонки.Добавить("Валюта");
	ПустаяТаблица.Колонки.Добавить("Контрагент");
	ПустаяТаблица.Колонки.Добавить("ДоговорКонтрагента");
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов");
	ПустаяТаблица.Колонки.Добавить("СуммаВзаиморасчетов");
	ПустаяТаблица.Колонки.Добавить("СуммаБУ");
	#Удаление
	ПустаяТаблица.Колонки.Добавить("СуммаНУ");
	#КонецУдаления
	
	Возврат ПустаяТаблица;
	
КонецФункции

// Описание: Добавляет строки зачтенных авансов в таблицу взаиморасчетов без расчета по СуммаНУ.
//
// Параметры:
// ТаблицаВзаиморасчетов - ТаблицаЗначений - результирующая таблица взаиморасчетов.
// НераспределеннаяСумма - Число - остаток суммы к распределению.
// ОстаткиАвансов - Массив/ТаблицаЗначений - строки остатков авансов.
// СтрокаДокумента - СтрокаТаблицыЗначений - строка таблицы документа.
//
&ИзменениеИКонтроль("ДобавитьСтрокиЗачтенныхАвансов")
Процедура FonProv_ДобавитьСтрокиЗачтенныхАвансов(ТаблицаВзаиморасчетов, НераспределеннаяСумма, ОстаткиАвансов, СтрокаДокумента)
	
	Для каждого СтрокаОстатка Из ОстаткиАвансов Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ЗачитываемыйАванс = Мин(НераспределеннаяСумма, СтрокаОстатка.СуммаВзаиморасчетов);
		
		Если ЗачитываемыйАванс <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаВзаиморасчетов = ТаблицаВзаиморасчетов.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаВзаиморасчетов, СтрокаДокумента,"ИмяТаблицы, НомерСтроки, СчетРасчетов,СчетАвансов,Контрагент,ДоговорКонтрагента,ВалютаВзаиморасчетов");
		
		СтрокаВзаиморасчетов.ОстатокВзаиморасчетов 	= СтрокаОстатка.СуммаВзаиморасчетов;
		СтрокаВзаиморасчетов.СуммаВзаиморасчетов   	= ЗачитываемыйАванс;
		СтрокаВзаиморасчетов.ДокументРасчетов		= СтрокаОстатка.ДокументРасчетов;
		
		КоэффициентКурсаАванса 		= ?(СтрокаОстатка.СуммаВзаиморасчетов=0,1, Окр(СтрокаОстатка.СуммаБУ / СтрокаОстатка.СуммаВзаиморасчетов, 4));
		#Удаление
		КоэффициентКурсаАвансаНУ 	= ?(СтрокаОстатка.СуммаВзаиморасчетов=0,1, Окр(СтрокаОстатка.СуммаНУ / СтрокаОстатка.СуммаВзаиморасчетов, 4));
		#КонецУдаления
		
		СуммаРегл =  МодульВалютногоУчета.ПересчитатьВВалютуУчета(СтрокаВзаиморасчетов.СуммаВзаиморасчетов, СтрокаДокумента.ВалютаВзаиморасчетов,ВалютаРегл, СтрокаДокумента.КурсВзаиморасчетов, 
		СтрокаДокумента.КратностьВзаиморасчетов);
		
		КоэффициентРегл = ?(СтрокаОстатка.СуммаВзаиморасчетов = 0, 1,СуммаРегл / СтрокаВзаиморасчетов.СуммаВзаиморасчетов);
		
		СтрокаВзаиморасчетов.СуммаРеглПоКурсуАванса 	= Окр(ЗачитываемыйАванс * КоэффициентКурсаАванса, 2);
		СтрокаВзаиморасчетов.СуммаРегл             		= Окр(ЗачитываемыйАванс * КоэффициентРегл, 2);
		
		НераспределеннаяСумма = НераспределеннаяСумма - ЗачитываемыйАванс;
		
		СтрокаОстатка.СуммаВзаиморасчетов = СтрокаОстатка.СуммаВзаиморасчетов - СтрокаВзаиморасчетов.СуммаВзаиморасчетов;
		СтрокаОстатка.СуммаБУ             = СтрокаОстатка.СуммаБУ - СтрокаВзаиморасчетов.СуммаРеглПоКурсуАванса;
		
	КонецЦикла;
	
КонецПроцедуры
