#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		Объект.НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КонецПериода) Тогда
		Объект.КонецПериода = КонецМесяца(ТекущаяДатаСеанса());
	КонецЕсли;

	НачалоПериода = Объект.НачалоПериода;
	КонецПериода = Объект.КонецПериода;
	Портфель = Объект.Портфель;
	Пул = Объект.Пул;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Перепровести(Команда)

	Если Не ПараметрыПерепроведенияКорректны() Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Запуск перепроведения сделок в фоновом задании...'"));

	РезультатВыполнения = ЗапуститьПерепроведениеВФонеНаСервере();

	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		ПерепровестиПоказатьРезультат(РезультатВыполнения);
		Возврат;
	КонецЕсли;

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПерепровестиЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатВыполнения, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПараметрыПерепроведенияКорректны()

	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите начало периода.'"));
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КонецПериода) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите конец периода.'"));
		Возврат Ложь;
	КонецЕсли;

	Если НачалоПериода > КонецПериода Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Начало периода не может быть больше конца периода.'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ПерепровестиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ПерепровестиПоказатьРезультат(Результат);

КонецПроцедуры

// Описание: Показывает результат длительной операции: текст итога из временного хранилища при успехе, текст ошибки при сбое.
//
// Параметры:
// РезультатДлительнойОперации - Структура - значение, возвращаемое БСП в оповещение завершения (ОжидатьЗавершение).
//
&НаКлиенте
Процедура ПерепровестиПоказатьРезультат(РезультатДлительнойОперации)

	Если РезультатДлительнойОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если РезультатДлительнойОперации.Статус = "Выполнено" Тогда
		ТекстДляПользователя = ТекстРезультатаПерепроведенияНаСервере(РезультатДлительнойОперации);
		ПоказатьПредупреждение(, ТекстДляПользователя);
		Сообщить(ТекстДляПользователя);
	ИначеЕсли РезультатДлительнойОперации.Статус = "Ошибка" Тогда
		ТекстОшибки = РезультатДлительнойОперации.КраткоеПредставлениеОшибки;
		Если ЗначениеЗаполнено(РезультатДлительнойОперации.ПодробноеПредставлениеОшибки) Тогда
			ТекстОшибки = РезультатДлительнойОперации.ПодробноеПредставлениеОшибки;
		КонецЕсли;
		ПоказатьПредупреждение(, ТекстОшибки);
		Сообщить(ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

// Описание: Возвращает строку итога из временного хранилища по адресу из результата длительной операции БСП.
//
// Параметры:
// РезультатДлительнойОперации - Структура - результат из оповещения ОжидатьЗавершение.
//
// Возвращаемое значение:
// Строка - текст для ПоказатьПредупреждение.
//
&НаСервере
Функция ТекстРезультатаПерепроведенияНаСервере(Знач РезультатДлительнойОперации)

	АдресРезультата = Неопределено;
	Если Не РезультатДлительнойОперации.Свойство("АдресРезультата", АдресРезультата) Тогда
		Возврат НСтр("ru = 'Перепроведение сделок завершено.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АдресРезультата) Тогда
		Возврат НСтр("ru = 'Перепроведение сделок завершено.'");
	КонецЕсли;

	ДанныеРезультата = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ДанныеРезультата = Неопределено Тогда
		Возврат НСтр("ru = 'Перепроведение сделок завершено.'");
	КонецЕсли;

	Если ТипЗнч(ДанныеРезультата) = Тип("Структура") Тогда
		ТекстИтога = Неопределено;
		Если ДанныеРезультата.Свойство("ТекстИтога", ТекстИтога) И ЗначениеЗаполнено(ТекстИтога) Тогда
			Возврат ТекстИтога;
		КонецЕсли;
	КонецЕсли;

	Возврат Строка(ДанныеРезультата);

КонецФункции

&НаСервере
Функция ЗапуститьПерепроведениеВФонеНаСервере()

	Объект.НачалоПериода = НачалоПериода;
	Объект.КонецПериода = КонецПериода;
	Объект.Портфель = Портфель;
	Объект.Пул = Пул;

	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("НачалоПериода", НачалоПериода);
	ПараметрыПроцедуры.Вставить("КонецПериода", КонецПериода);
	ПараметрыПроцедуры.Вставить("Портфель", Портфель);
	ПараметрыПроцедуры.Вставить("Пул", Пул);

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'IMDEV-8662: перепроведение сделок (FonProv)'");

	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"FonProv_ПерепроведениеСделок.ПерепровестиСделки",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);

КонецФункции

#КонецОбласти
