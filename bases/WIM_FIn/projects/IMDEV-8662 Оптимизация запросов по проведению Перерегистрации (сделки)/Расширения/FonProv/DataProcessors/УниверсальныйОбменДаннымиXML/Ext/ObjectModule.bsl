// IMDEV-8662
//
// Описание: Перехват процедуры записи объекта в ИБ при загрузке обмена. Если при записи возникает
// конфликт уникальности или первичного ключа (два потока пишут один и тот же GUID), из текста ошибки
// извлекается идентификатор, ищется бизнес-процесс СделкиTn в базе. Объект считается полным, если
// одновременно заполнены Актив и Количество. Неполный входящий объект при таком конфликте
// игнорируется без исключения. Если в базе уже есть неполная запись с тем же GUID, она удаляется
// в режиме загрузки обмена и входящий объект записывается повторно. В остальных случаях поведение
// как в типовой обработке: протокол и исключение при отключенной отладке.
//
// Параметры:
// Объект - Произвольный - объект информационной базы, подлежащий записи.
// Тип - Произвольный - тип объекта в контексте обмена.
//
&ИзменениеИКонтроль("ЗаписатьОбъектВИБ")
Процедура FonProv_ЗаписатьОбъектВИБ(Объект, Тип)
		
	Попытка
		
		УстановитьОбменДаннымиЗагрузка(Объект);
		Объект.Записать();
		
	Исключение
		
		#Удаление
		СтрокаСообщенияОбОшибке = ЗаписатьИнформациюОбОшибкеВПротокол(26, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Объект, Тип);
		
		Если Не ФлагРежимОтладки Тогда
			ВызватьИсключение СтрокаСообщенияОбОшибке;
		КонецЕсли;
		#КонецУдаления
		#Вставка
		
		ДопустимыйТипОбъекта = Тип("БизнесПроцессОбъект.СделкиTn");
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Верх = ВРег(ТекстОшибки);
		ТипОбъекта = ТипЗнч(Объект);
		
		ЭтоСправочникСПараллельнойПолнойВыгрузкой =
			ТипОбъекта = Тип("СправочникОбъект.Облигации")
			Или ТипОбъекта = Тип("СправочникОбъект.Акции");
		ЭтоОшибкаКонкуренции =
			СтрНайти(Верх, "НЕСООТВЕТСТВИЯ ВЕРСИИ") > 0
			И СтрНайти(Верх, "ОТСУТСТВИЯ ЗАПИСИ БАЗЫ ДАННЫХ") > 0;
		
		Если ЭтоСправочникСПараллельнойПолнойВыгрузкой И ЭтоОшибкаКонкуренции Тогда
			Возврат;
		КонецЕсли;
		
		ЭтоОшибкаДубля = ТипОбъекта = ДопустимыйТипОбъекта И
			(СтрНайти(Верх, "PRIMARY KEY") > 0
				Или СтрНайти(Верх, "UNIQUE KEY") > 0
				Или СтрНайти(Верх, "UNIQUE CONSTRAINT") > 0
				Или СтрНайти(Верх, "НАРУШЕНИЕ ОГРАНИЧЕНИЯ UNIQUE") > 0
				Или СтрНайти(Верх, "НАРУШЕНИЕ ОГРАНИЧЕНИЯ PRIMARY KEY") > 0
				Или СтрНайти(Верх, "UNIQUE VIOLATION") > 0);
		
		ОбработалиДубль = Ложь;
		ТекстОшибкиПатчинга = "";
		
		Если ЭтоОшибкаДубля Тогда
			ПозицияНач = СтрНайти(Верх, "0X");
			Если ПозицияНач > 0 Тогда
				Hex = Сред(Верх, ПозицияНач + 2, 32);
				Hex = СтрЗаменить(Hex, " ", "");
				Если СтрДлина(Hex) = 32 Тогда
					GUIDСтрокой =
						НРег(Сред(Hex, 25, 8)) + "-" +
						НРег(Сред(Hex, 21, 4)) + "-" +
						НРег(Сред(Hex, 17, 4)) + "-" +
						НРег(Сред(Hex, 1, 4)) + "-" +
						НРег(Сред(Hex, 5, 12));
					
					Ссылка = БизнесПроцессы.СделкиTn.ПолучитьСсылку(Новый УникальныйИдентификатор(GUIDСтрокой));
					ОбъектВБ = Ссылка.ПолучитьОбъект();
					
					Если ТипЗнч(ОбъектВБ) = ДопустимыйТипОбъекта И Не ОбъектВБ.ЭтоНовый() Тогда
						ОбъектПолный = ЗначениеЗаполнено(Объект.Актив) И ЗначениеЗаполнено(Объект.Количество);
						ОбъектВБПолный = ЗначениеЗаполнено(ОбъектВБ.Актив) И ЗначениеЗаполнено(ОбъектВБ.Количество);
						
						Если Не ОбъектПолный Тогда
							ОбработалиДубль = Истина;
						ИначеЕсли Не ОбъектВБПолный Тогда
							Попытка
								УстановитьОбменДаннымиЗагрузка(ОбъектВБ);
								ОбъектВБ.Удалить();
								УстановитьОбменДаннымиЗагрузка(Объект);
								Объект.Записать();
								ОбработалиДубль = Истина;
							Исключение
								ТекстОшибкиПатчинга = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
								ОбработалиДубль = Ложь;
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ОбработалиДубль Тогда
			Возврат;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстОшибкиПатчинга) Тогда
			ТекстОшибки = ТекстОшибки + Символы.ПС + "После попытки патчинга ошибка такая:" + Символы.ПС + ТекстОшибкиПатчинга;
		КонецЕсли;
		
		СтрокаСообщенияОбОшибке = ЗаписатьИнформациюОбОшибкеВПротокол(26, ТекстОшибки, Объект, Тип);
		
		Если Не ФлагРежимОтладки Тогда
			ВызватьИсключение СтрокаСообщенияОбОшибке;
		КонецЕсли;
		
		#КонецВставки
		
	КонецПопытки;
	
КонецПроцедуры
