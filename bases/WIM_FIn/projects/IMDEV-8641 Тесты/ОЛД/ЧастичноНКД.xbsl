{
"ВерсияФормата": 2,
"Алгоритмы": [
{
"Имя": "Алгоритм",
"Текст": "",
"НаКлиенте": false,
"ИспользоватьОбработкуДляВыполненияКода": false,
"Переменные": [],
"Строки": [
{
"Имя": "ЧастичноеНКД",
"Текст": "Отказ = Ложь;\r\n\r\nЗапрос = Новый Запрос;\r\nЗапрос.Текст = \"\r\n|ВЫБРАТЬ\r\n|\u0009П.Ссылка КАК Портфель\r\n\r\n|ИЗ\r\n|\u0009Справочник.Портфели КАК П\r\n|ГДЕ\r\n|\u0009НЕ П.ПометкаУдаления\r\n|\u0009И П.Пул = &Пул\";\r\nЗапрос.УстановитьПараметр(\"Пул\", Справочники.Пул.ПустаяСсылка());\r\n//Запрос.УстановитьПараметр(\"Пул\", Справочники.Пул.НайтиПоНаименованию(\"Розничное ДУ\"));\r\n\r\nДень = Дата(\"20260206080012\");\r\nСообщить(\"Период = \" + День + \" ПУЛ = [\" + Запрос.Параметры.Пул + \"]\");\r\n//МассивПортфелей = Новый Массив;\r\n//Ду = Справочники.Портфели.НайтиПоНаименованию(\"ДУ 1230 (Гуслистый  Н.Н.)\");\r\n//МассивПортфелей.Добавить(ДУ);\r\n//Сообщить(ДУ);\r\n\r\nМассивПортфелей = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(\"Портфель\");\r\nСообщить(\"Портфелей к анализу = \" + МассивПортфелей.Количество());\r\n\r\nТекстЗапросаОстатки =\r\n    \"ВЫБРАТЬ\r\n    |   ХозрасчетныйОстатки.Портфель КАК Портфель,\r\n    |   ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.Облигации) КАК Облигация\r\n    |ПОМЕСТИТЬ Остатки_БУ\r\n    |ИЗ\r\n    |   РегистрБухгалтерии.Хозрасчетный.Остатки(\r\n    |       &Период,\r\n    |       Счет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОблигацииТело),\r\n    |       ,\r\n    |       Портфель В (&МассивПортфелей)) КАК ХозрасчетныйОстатки\r\n    |ГДЕ\r\n    |   ХозрасчетныйОстатки.СуммаОстатокДт > 0\r\n    |\r\n    |ИНДЕКСИРОВАТЬ ПО\r\n    |   Облигация\r\n    |;\r\n    |\r\n    |////////////////////////////////////////////////////////////////////////////////\r\n    |ВЫБРАТЬ РАЗЛИЧНЫЕ\r\n    |   Остатки_БУ.Портфель КАК Портфель,\r\n    |   Активы.Ссылка КАК Актив\r\n    |ПОМЕСТИТЬ ВТ_ПортфельАктивПоОстаткам\r\n    |ИЗ\r\n    |   Остатки_БУ КАК Остатки_БУ\r\n    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы\r\n    |       ПО Остатки_БУ.Облигация = Активы.Объект\r\n    |;\r\n    |\r\n    |////////////////////////////////////////////////////////////////////////////////\r\n    |ВЫБРАТЬ\r\n    |   ВТ_ПортфельАктивПоОстаткам.Портфель КАК Портфель,\r\n    |   ВТ_ПортфельАктивПоОстаткам.Актив КАК Актив\r\n    |ИЗ\r\n    |   ВТ_ПортфельАктивПоОстаткам КАК ВТ_ПортфельАктивПоОстаткам\";\r\n\r\n    ЗапросОстатки = Новый Запрос;\r\n    ЗапросОстатки.Текст = ТекстЗапросаОстатки;\r\n    ЗапросОстатки.УстановитьПараметр(\"МассивПортфелей\", МассивПортфелей);\r\n    ЗапросОстатки.УстановитьПараметр(\"Период\", НачалоДня(День));\r\n\r\n    ТаблицаПортфельАктив = ЗапросОстатки.Выполнить().Выгрузить();\r\n\r\n    Если ТаблицаПортфельАктив.Количество() = 0 Тогда\r\n\u0009\u0009//Возврат Новый Массив;\r\n\u0009\u0009Сообщить(\"Нет на остатке\");\r\n\u0009\u0009Отказ = Истина;\r\n\u0009Иначе\r\n\u0009 \r\n\u0009\u0009МассивАктивов = Новый Массив;\r\n\u0009\u0009УжеДобавленныеАктивы = Новый Соответствие;\r\n\u0009\u0009\r\n\u0009\u0009Для Каждого СтрокаПортфельАктив Из ТаблицаПортфельАктив Цикл\r\n\u0009\u0009\u0009\r\n\u0009\u0009\u0009Если УжеДобавленныеАктивы.Получить(СтрокаПортфельАктив.Актив) = Неопределено Тогда\r\n\u0009\u0009\u0009\u0009УжеДобавленныеАктивы.Вставить(СтрокаПортфельАктив.Актив, Истина);\r\n\u0009\u0009\u0009\u0009МассивАктивов.Добавить(СтрокаПортфельАктив.Актив);\r\n\u0009\u0009\u0009КонецЕсли;\r\n\u0009\u0009\u0009\r\n\u0009\u0009КонецЦикла;\r\n\u0009\u0009\r\n\u0009\u0009Сообщить(\"Активов к анализу амортизации = \" + МассивАктивов.Количество());\r\n\u0009\u0009\r\n\u0009\u0009ТаблицаАмортизации = Справочники.Облигации.ПолучитьДанныеАмортизации(МассивАктивов, День, Истина);\r\n\u0009\u0009\r\n\u0009\u0009Сообщить(\"Активов к ПОСЛЕ АНАЛИЗА амортизации = \" + ТаблицаАмортизации.Количество());\r\n\u0009\u0009\r\n\u0009\u0009Если ТаблицаАмортизации = Неопределено Или ТаблицаАмортизации.Количество() = 0 Тогда\r\n\u0009\u0009\u0009//Возврат Новый Массив;\r\n\u0009\u0009\u0009Сообщить(\"Нет амортизации\");\r\n\u0009\u0009\u0009Отказ = Истина;\r\n\u0009\u0009КонецЕсли;\r\n\u0009\r\n\u0009\r\n\u0009КонецЕсли;\r\n\r\nЕсли Не Отказ Тогда\r\n\u0009ТекстЗапросаАмортизация =\r\n    \"ВЫБРАТЬ\r\n    |   ТаблицаПортфельАктив.Портфель КАК Портфель,\r\n    |   ТаблицаПортфельАктив.Актив КАК Актив\r\n    |ПОМЕСТИТЬ ВТ_ПортфельАктив\r\n    |ИЗ\r\n    |   &ТаблицаПортфельАктив КАК ТаблицаПортфельАктив\r\n    |\r\n    |ИНДЕКСИРОВАТЬ ПО\r\n    |   Актив\r\n    |;\r\n    |\r\n    |////////////////////////////////////////////////////////////////////////////////\r\n    |ВЫБРАТЬ\r\n    |   ТаблицаАмортизации.Облигация КАК Облигация,\r\n    |   ТаблицаАмортизации.НоминальнаяСтоимость КАК НоминальнаяСтоимость,\r\n    |   ТаблицаАмортизации.ПроцентНоминала КАК ПроцентНоминала,\r\n    |   ТаблицаАмортизации.СуммаПогашения КАК СуммаПогашения,\r\n    |   ТаблицаАмортизации.ОстатокНоминала КАК ОстатокНоминала,\r\n    |   ТаблицаАмортизации.КоэффициентАмортизации КАК КоэффициентАмортизации,\r\n    |   ТаблицаАмортизации.Эмитент КАК Эмитент,\r\n    |   ТаблицаАмортизации.Актив КАК Актив\r\n    |ПОМЕСТИТЬ ВТ_АмортизацияТекущегоДня\r\n    |ИЗ\r\n    |   &ТаблицаАмортизации КАК ТаблицаАмортизации\r\n    |ГДЕ\r\n    |   ТаблицаАмортизации.ОстатокНоминала > 0\r\n    |\r\n    |ИНДЕКСИРОВАТЬ ПО\r\n    |   Актив\r\n    |;\r\n    |\r\n    |////////////////////////////////////////////////////////////////////////////////\r\n    |ВЫБРАТЬ РАЗЛИЧНЫЕ\r\n    |   Соответствие.Портфель КАК Портфель\r\n    |ИЗ\r\n    |   ВТ_АмортизацияТекущегоДня КАК АмортизацияТекущегоДня\r\n    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПортфельАктив КАК Соответствие\r\n    |       ПО АмортизацияТекущегоДня.Актив = Соответствие.Актив\";\r\n\r\n    ЗапросАмортизация = Новый Запрос;\r\n    ЗапросАмортизация.Текст = ТекстЗапросаАмортизация;\r\n    ЗапросАмортизация.УстановитьПараметр(\"ТаблицаАмортизации\", ТаблицаАмортизации);\r\n    ЗапросАмортизация.УстановитьПараметр(\"ТаблицаПортфельАктив\", ТаблицаПортфельАктив);\r\n\r\n    Результат = ЗапросАмортизация.Выполнить();\r\n\r\n    Если Результат.Пустой() Тогда\r\n        //Возврат Новый Массив;\r\n\u0009\u0009\u0009Сообщить(\"Возврат Новый Массив 3\");\r\n    КонецЕсли;\r\n\r\n\u0009МассивПортфелейРезультат = Результат.Выгрузить().ВыгрузитьКолонку(\"Портфель\");\r\n\u0009Сообщить(\"Портфелей к расчету = \" + МассивПортфелейРезультат.Количество());\r\n\u0009Для Каждого Портфель Из МассивПортфелейРезультат Цикл\r\n\u0009\u0009Сообщить(Портфель);\r\n\u0009КонецЦикла;\r\n\u0009\r\nИначе\r\n\u0009Сообщить(\"Нет данных к расчету\");\r\nКонецЕсли;\r\n\r\n// СТРУКТУРНЫЕ НОТЫ\r\nАктивыКПогашению = Справочники.СтруктурныеНоты.АктивыКПогашению(День);\r\nЕсли АктивыКПогашению.Количество() = 0 Тогда\r\n\u0009Сообщить(\"Нет Структурных нот к расчету\");\r\nИначе\r\n\u0009Сообщить(\"ЕСТЬ Структурные ноты к расчету\");\r\nКонецЕсли;\r\n\r\nТекстЗапроса =\r\n    \"ВЫБРАТЬ\r\n    |   ХозрасчетныйОстатки.Портфель КАК Портфель,\r\n    |   ВЫРАЗИТЬ(ХозрасчетныйОстатки.Субконто1 КАК Справочник.СтруктурныеНоты) КАК СтруктурнаяНота\r\n    |ПОМЕСТИТЬ ВТ_Остатки\r\n    |ИЗ\r\n    |   РегистрБухгалтерии.Хозрасчетный.Остатки(\r\n    |       &Период,\r\n    |       Счет = &СчетУчета,\r\n    |       ,\r\n    |       Портфель В (&МассивПортфелей)) КАК ХозрасчетныйОстатки\r\n    |ГДЕ\r\n    |   ХозрасчетныйОстатки.СуммаОстатокДт > 0\r\n    |\r\n    |ИНДЕКСИРОВАТЬ ПО\r\n    |   СтруктурнаяНота\r\n    |;\r\n    |\r\n    |////////////////////////////////////////////////////////////////////////////////\r\n    |ВЫБРАТЬ РАЗЛИЧНЫЕ\r\n    |   ВТ_Остатки.Портфель КАК Портфель\r\n    |ИЗ\r\n    |   ВТ_Остатки КАК ВТ_Остатки\r\n    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Активы КАК Активы\r\n    |       ПО ВТ_Остатки.СтруктурнаяНота = Активы.Объект\r\n    |ГДЕ\r\n    |   Активы.Ссылка В (&АктивыКПогашению)\";\r\n\r\n    Запрос = Новый Запрос;\r\n    Запрос.Текст = ТекстЗапроса;\r\n    Запрос.УстановитьПараметр(\"Период\", НачалоДня(День));\r\n    Запрос.УстановитьПараметр(\"МассивПортфелей\", МассивПортфелей);\r\n    Запрос.УстановитьПараметр(\"СчетУчета\", ПланыСчетов.Хозрасчетный.СтоимостьСтруктурнойНоты);\r\n    Запрос.УстановитьПараметр(\"АктивыКПогашению\", АктивыКПогашению);\r\n\r\n    Результат = Запрос.Выполнить();\r\n\r\n    Если Результат.Пустой() Тогда\r\n        Сообщить(\"Нет остатков по РСБУ Структурных нот к расчету\");\r\n    КонецЕсли;\r\n\r\n    МассивПортфелейНотРезультат = Результат.Выгрузить().ВыгрузитьКолонку(\"Портфель\");\r\n\u0009Сообщить(\"Портфелей НОТ к расчету = \" + МассивПортфелейНотРезультат.Количество());\r\n\u0009Для Каждого Портфель Из МассивПортфелейНотРезультат Цикл\r\n\u0009\u0009Сообщить(Портфель);\r\n\u0009КонецЦикла;",
"НаКлиенте": false,
"ИспользоватьОбработкуДляВыполненияКода": false,
"Переменные": [],
"Строки": []
}
]
}
]
}
