Функция ЕстьСтатикаДокументыДляОбмена(УзелОбменаТекущий)
	//{[+] IMDEV-3254 N.Filimonova 15.08.2022     
	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку(); 
	ЗапСообщения = ПланыОбмена.СоздатьЗаписьСообщения(); 
	ЗапСообщения.НачатьЗапись(ЗаписьXML, УзелОбменаТекущий);  
	
	МассивМетаданныхУзла = Новый Массив;
	
	Для Каждого Спр Из Метаданные.Справочники Цикл
		МассивМетаданныхУзла.Добавить(Спр);
	КонецЦикла; 
	
	Для Каждого Док Из Метаданные.Документы Цикл
		МассивМетаданныхУзла.Добавить(Док);
	КонецЦикла;   
	
	Для Каждого БизнесПроцесс Из Метаданные.БизнесПроцессы Цикл 
		
		Если БизнесПроцесс = Метаданные.БизнесПроцессы.СделкиTn Тогда
			Продолжить;
		КонецЕсли;	
		
		МассивМетаданныхУзла.Добавить(БизнесПроцесс);
	КонецЦикла;
	
	
	Выборка = ПланыОбмена.ВыбратьИзменения(УзелОбменаТекущий, ЗапСообщения.НомерСообщения, МассивМетаданныхУзла);  
	
	Если  Выборка.Следующий() Тогда  
		Возврат Истина;
	КонецЕсли; 
	
	Возврат Ложь;
	
	//} IMDEV-3254 N.Filimonova 
КонецФункции	

