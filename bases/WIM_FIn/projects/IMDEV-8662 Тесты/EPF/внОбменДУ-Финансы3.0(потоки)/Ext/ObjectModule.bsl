	ТабДокумент.Вывести(Заголовок);
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.ДатаФормирования = ТекущаяДата();
	ТабДокумент.Вывести(Шапка);
	
	Если Параметры.СписокСправочниковКЗагрузке.Количество() > 0 Тогда 
		ОбластьШапкаСправочники = Макет.ПолучитьОбласть("ШапкаСправочники");
