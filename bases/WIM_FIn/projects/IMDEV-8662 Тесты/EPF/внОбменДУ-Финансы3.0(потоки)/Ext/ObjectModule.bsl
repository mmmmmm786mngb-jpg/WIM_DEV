Процедура ОжидатьЗавершенияФоновыхЗаданий(ТаблицаФоновыхЗаданий, МаксимальноеКоличествоВОжидании = 0)
	
	ОбщееВремяОжиданияЗавершенияФоновых = 0;
	ПаузаСекундыОжиданияЗавершенияФоновых = 5;
	МаксимальноеВремяОжиданияЗавершенияФоновых = 12 * 3600; // 12 Часов
	
	Пока Истина Цикл
		
		Отбор = Новый Структура("Завершен", Ложь);
		СписокНеЗавершенных = ТаблицаФоновыхЗаданий.НайтиСтроки(Отбор);
		
		Если СписокНеЗавершенных.Количество() <= МаксимальноеКоличествоВОжидании Тогда
			Прервать;
		КонецЕсли;
		
		Если СписокНеЗавершенных.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Для каждого СтрокаФЗ Из ТаблицаФоновыхЗаданий Цикл
			
			Если СтрокаФЗ.Завершен Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаданиеЕстьОшибкиВыполнения = Ложь;
			ОписаниеОшибки = "";
			Попытка
				ЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(СтрокаФЗ.ФоновоеЗадание.УникальныйИдентификатор)
			Исключение
				ЗаданиеВыполнено = Ложь;
				ЗаданиеЕстьОшибкиВыполнения = Истина;
				ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			
			Если ЗаданиеЕстьОшибкиВыполнения Тогда
				// Либо были ошибки при выполнении задания
				// Либо ошибки при получении информации о выполнении задания
				СтрокаФЗ.Завершен = Истина;
				СтрокаФЗ.Отказ = Истина;
				СтрокаФЗ.ТекстОшибки = ОписаниеОшибки;
				
			ИначеЕсли ЗаданиеВыполнено Тогда
				СтрокаФЗ.Завершен = Истина;
			КонецЕсли;
			
			Если СтрокаФЗ.Завершен Тогда
				ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация, , , "Завершено фоновое задание по потоку " + СтрокаФЗ.НомерПотока);
			КонецЕсли;

		КонецЦикла;
		
		
		
		VTB_ОбщийМодуль.Пауза(ПаузаСекундыОжиданияЗавершенияФоновых);
		ОбщееВремяОжиданияЗавершенияФоновых = ОбщееВремяОжиданияЗавершенияФоновых + ПаузаСекундыОжиданияЗавершенияФоновых;
		
		Если ОбщееВремяОжиданияЗавершенияФоновых > МаксимальноеВремяОжиданияЗавершенияФоновых Тогда
			
			// Вызываем исключение
			ВызватьИсключение "Превышено время ожидания завершения выполнения фоновых заданий";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

