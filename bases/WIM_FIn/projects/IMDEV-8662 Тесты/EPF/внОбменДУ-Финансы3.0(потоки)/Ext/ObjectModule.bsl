// IMAPPS-31419++
Перем ИмяСобытияЖР;
Перем Отказ;
Перем ТекстОписаниеОшибки;
// IMAPPS-31419--

#Область ПОДСИСТЕМА_ДОПОЛНИТЕЛЬНЫХ_ОТЧЕТОВ_И_ОБРАБОТОК

Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид","ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение",Неопределено);  
	ПараметрыРегистрации.Вставить("Наименование", "Обмен ДУ-Финансы 3.0 многопоточно");
	ПараметрыРегистрации.Вставить("Версия", "3.27");
	ПараметрыРегистрации.Вставить("БезопасныйРежим",Ложь);
	ПараметрыРегистрации.Вставить("Информация","Обмен данными ДУ-Финансы 3.0 многопоточно");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд,
	"Выполнить обмен ДУ-Финансы 3.0 многопоточно",
	"ВыполнитьОбменДУ_Финансы",
	"ОткрытиеФормы");
	
	ДобавитьКоманду(ТаблицаКоманд,
	"Выполнить обмен ДУ-Финансы 3.0 многопоточно(фон.)",
	"ФоновоеВыполнение",
	"ВызовСерверногоМетода");

	// IMAPPS-30616 ++
	ДобавитьКоманду(ТаблицаКоманд,
	"Выполнить обмен ДУ-Финансы 3.0 многопоточно РГС (фон.)",
	"ФоновоеВыполнениеРГС",
	"ВызовСерверногоМетода");
	// IMAPPS-30616 --
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

#КонецОбласти

#Область ПРОЦЕДУРЫ_ОБМЕНА_ДАННЫМИ  

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	Перем Наименование;
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" И ИдентификаторКоманды <> "ФоновоеВыполнениеРГС" Тогда
		Возврат;
	КонецЕсли;
	//ЗаписьЖурналаРегистрации("обмен", УровеньЖурналаРегистрации.Информация, , ,  ИдентификаторКоманды);
	// IMAPPS-24804++
	ОтборФонЗадан = Новый Структура;        
	ОтборФонЗадан.Вставить("ИмяМетода", "VTB_ОбщийМодуль.ВыполнитьОбменДУ_Финансы");
	ОтборФонЗадан.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	Если ИдентификаторКоманды = "ФоновоеВыполнениеРГС" Тогда 
		ОтборФонЗадан.Вставить("Наименование", "Выгрузка в базу Финансы РГС");
	Иначе 
		ОтборФонЗадан.Вставить("Наименование", "Выгрузка в базу Финансы");
	КонецЕсли;
	// IMAPPS-30616
	АктивныеФонЗадан = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборФонЗадан);
	
	Если АктивныеФонЗадан.Количество() Тогда 
		Возврат;
	КонецЕсли;
	// IMAPPS-24804--
		
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	ДопОбработка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
	
	ПараметрыОбработки = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;

	ПараметрыВыполненияКоманды.Вставить("СписокСтатейЗатратКомиссияБанка", ЗначениеИзСтрокиВнутр(ПараметрыОбработки.Значения.КомиссияБанка));
	ПараметрыВыполненияКоманды.Вставить("СписокСтатейЗатратДепозитарныеУслуги", ЗначениеИзСтрокиВнутр(ПараметрыОбработки.Значения.ДепозитарныеУслуги));
	ПараметрыВыполненияКоманды.Вставить("СписокСтатейЗатратДивиденды", ЗначениеИзСтрокиВнутр(ПараметрыОбработки.Значения.Дивиденды));
	ПараметрыВыполненияКоманды.Вставить("ДатаНачалаРегистрации", УзелОбмена.ДатаНачалаРегистрации);  
	ПараметрыВыполненияКоманды.Вставить("Интерактивно", Ложь);  
	
	// IMAPPS-30616 ++
	Если ИдентификаторКоманды = "ФоновоеВыполнениеРГС" Тогда 
		ПараметрыВыполненияКоманды.Вставить("ОбменРГС", Истина);  
		ПараметрыВыполненияКоманды.Вставить("СписокДоговоров", ЗначениеИзСтрокиВнутр(ПараметрыОбработки.Значения.Договоры));  
	Иначе 
		ПараметрыВыполненияКоманды.Вставить("ОбменРГС", Ложь);  
		ПараметрыВыполненияКоманды.Вставить("СписокДоговоров", Новый Массив);  
	КонецЕсли;
	// IMAPPS-30616 --
	
	Задача = Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
	Задача.Дата 	= ТекущаяДата();
	
	Наименование = "Обмен ДУ-Финансы многопоточно 3.0 в фоновом режиме" + ?(ПараметрыВыполненияКоманды.ОбменРГС, " (РГС)", "");
	
	Задача.ВидОбмена 		= ДопОбработка;
	Задача.ВерсияОбработки 	= ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДопОбработка, "Версия");
	Задача.Наименование 	= Наименование;
	Задача.ПараметрыВыполнения = ПредставлениеНастроек;  
	
	Отказ = Ложь;
	
	// Реализация логики команды
	Попытка
		Выполнить("ВыполнитьОбменДУ_Финансы(ПараметрыВыполненияКоманды);");
		// IMAPPS-31419++
		Если ЗначениеЗаполнено(ТекстОписаниеОшибки) Тогда
			Задача.Описание = ТекстОписаниеОшибки;
		Иначе
			Задача.Описание = "Выполнено успешно";
		КонецЕсли;
		// IMAPPS-31419--
	Исключение
		Отказ = Истина;
		ЗаписьЖурналаРегистрации(ИмяСобытияЖР, , , , ОписаниеОшибки());
		Задача.Описание = "Ошибка обмена ДУ-Финансы: "+ ОписаниеОшибки();
	КонецПопытки;

	// IMAPPS-31419++
	Если СписокРассылки.Количество() > 0 и НЕ ПочтовыйЛогин.Пустая() тогда
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, Вложения, Важность");
		ПараметрыПисьма.Тема	 = ?(Отказ, "{FAIL} ", "{OK} ") + "Аванкор ДУ: " + Наименование + ПропискаРассылки("r0");
		ПараметрыПисьма.Важность = ?(Отказ, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
		ПараметрыПисьма.Тело	 =  Задача.Описание;
		ПараметрыПисьма.Вложения = Новый Массив;
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылки Цикл
			Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
		
		ПараметрыПисьма.Кому = Кому;
		
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
			текстРассылки = "Рассылка завершена";
		Исключение
			текстРассылки = "Рассылка не удалась: " + ОписаниеОшибки(); 
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Для Каждого Элемент из Сообщения Цикл
				  текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
			КонецЦикла;
		КонецПопытки;
		
	КонецЕсли;
	// IMAPPS-31419--

	Задача.ВыполнитьЗадачу();

КонецПроцедуры

Процедура ВыполнитьОбменДУ_Финансы(ПараметрыВыполненияКоманды) Экспорт 
	
	Если ПараметрыВыполненияКоманды.ОбменРГС Тогда 
		УзелОбменаТекущий = УзелОбменаРГС;
	Иначе 
		УзелОбменаТекущий = УзелОбмена;
	КонецЕсли;
	
	//{[+] IMDEV-3254 N.Filimonova 01.03.2022
	
	этоПоследнийПакет = Ложь;
	КоличествоПотоковФакт = 0;
	//СтруктураСделок = СделкиTnПоПортфелям(УзелОбмена);
	СтруктураСделок = СделкиTnПоПортфелям(УзелОбменаТекущий, ПараметрыВыполненияКоманды);   // IMAPPS-30616

	КоличествоСделок 				= СтруктураСделок.КоличествоСделок;
	ВыборкаСделкиTnПоПортфелям 		= СтруктураСделок.ВыборкаСделкиTnПоПортфелям;
	КоличествоПортфелей 			= ВыборкаСделкиTnПоПортфелям.Строки.Количество();  
	//ЕстьСтатикаДокументыДляОбмена 	= ЕстьСтатикаДокументыДляОбмена(УзелОбмена);
	ЕстьСтатикаДокументыДляОбмена 	= ЕстьСтатикаДокументыДляОбмена(УзелОбменаТекущий);  // IMAPPS-30616
		
	Если ЕстьСтатикаДокументыДляОбмена = Истина Тогда
		КоличествоПотоков 		= КоличествоПотоков - 1;
	КонецЕсли;	
	
	Если КоличествоПотоков = 0 Тогда
		КоличествоПотоков = 1;
	КонецЕсли;
	
	СделокНаПоток 				= Цел(КоличествоСделок/КоличествоПотоков)+1;
	ПулСделок 					= Новый Массив;
	ОбработаноСделок			= 0;   
	
	// IMAPPS-31419++
	МаксКоличествоФоновыхЗаданий = 10;
	
	ТаблицаФоновыхЗаданий = Новый ТаблицаЗначений;
	ТаблицаФоновыхЗаданий.Колонки.Добавить("Завершен", Новый ОписаниеТипов("Булево"));
	ТаблицаФоновыхЗаданий.Колонки.Добавить("Отказ", Новый ОписаниеТипов("Булево"));
	ТаблицаФоновыхЗаданий.Колонки.Добавить("ТекстОшибки", Новый ОписаниеТипов("Строка"));
	ТаблицаФоновыхЗаданий.Колонки.Добавить("ФоновоеЗадание");
	ТаблицаФоновыхЗаданий.Колонки.Добавить("НомерПотока", Новый ОписаниеТипов("Строка"));
	// IMAPPS-31419--
	
	ЗаполнениеПараметровВыполненияКоманды(ПараметрыВыполненияКоманды, УзелОбменаТекущий);
	
	// Выгрузка всех отбъектов кроме Сделок Tn+ одним пакетом в фоне 
	// Флаг необходимости рассылки присваивается в последнем потоке 
	Если КоличествоСделок = 0 И ЕстьСтатикаДокументыДляОбмена = Истина Тогда   
		КоличествоПотоковФакт = 1;  
		ПараметрыВыполненияКоманды.КоличествоПотоковФакт = КоличествоПотоковФакт;  
		ПараметрыВыполненияКоманды.Рассылка = Истина; 
		ПараметрыВыполненияКоманды.ЗапускОперацийПослеОбмена = Истина;
	КонецЕсли;	 
	
	Если ЕстьСтатикаДокументыДляОбмена = Истина Тогда  
		ПараметрыВыполненияКомандыXML = СтрокаXML(ПараметрыВыполненияКоманды);
		// IMAPPS-31419++
		// ВыполнитьФоновоеЗадание(ПараметрыВыполненияКомандыXML, ПараметрыВыполненияКоманды.ОбменРГС);
		Задание = ВыполнитьФоновоеЗадание(ПараметрыВыполненияКомандыXML, ПараметрыВыполненияКоманды.ОбменРГС);
		НоваяЗапись = ТаблицаФоновыхЗаданий.Добавить();
		НоваяЗапись.ФоновоеЗадание = Задание;
		НоваяЗапись.НомерПотока = ТаблицаФоновыхЗаданий.Количество();
		ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация, , , "Запущено фоновое задание по потоку " + НоваяЗапись.НомерПотока);
		// IMAPPS-31419--
	КонецЕсли;	
	
	// IMAPPS-24804++
	ТаблицаРаспределенияПоПортфелям = Новый ТаблицаЗначений;
	ТаблицаРаспределенияПоПортфелям.Колонки.Добавить("КоличествоСделок", Новый ОписаниеТипов("Число"));
	ТаблицаРаспределенияПоПортфелям.Колонки.Добавить("ПулСделок");
	
	Для Сч = 1 по КоличествоПотоков Цикл
		ТаблицаРаспределенияПоПортфелям.Добавить().ПулСделок = Новый Массив;
	КонецЦикла;
	
	ВыборкаСделкиTnПоПортфелям.Строки.Сортировать("Ссылка Убыв"); // Сортировка по количеству Сделок
	
	// Распределяем Сделки в по пулам таким образом, чтобы каждый пул содержал максимально одинаковое количество сделок
	// Для этого каждый последующий Портфель, отсортированный по убыванию, будем помещать в самый маленький пул, применяя сортировку на каждом шаге
	Для Каждого Портфель Из ВыборкаСделкиTnПоПортфелям.Строки Цикл
		ТаблицаРаспределенияПоПортфелям.Сортировать("КоличествоСделок");
		ТекСтрокаРаспределения = ТаблицаРаспределенияПоПортфелям.Получить(0);
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТекСтрокаРаспределения.ПулСделок, Портфель.Строки.ВыгрузитьКолонку("Ссылка"));
		ТекСтрокаРаспределения.КоличествоСделок = ТекСтрокаРаспределения.ПулСделок.Количество();
	КонецЦикла;
	
	// Далее просто вызываем фоновое по всем распределеным пулам
	Для каждого ТекСтрокаРаспределения из ТаблицаРаспределенияПоПортфелям Цикл
		
		КоличествоПотоковФакт = КоличествоПотоковФакт + 1;

			
		ПараметрыВыполненияКоманды.ЭтоПакетСделокTn = Истина;
		ПараметрыВыполненияКоманды.ПулСделок = ТекСтрокаРаспределения.ПулСделок;  
		
		этоПоследнийПакет = (ТаблицаРаспределенияПоПортфелям.Количество() - 1) = ТаблицаРаспределенияПоПортфелям.Индекс(ТекСтрокаРаспределения);
		ПараметрыВыполненияКоманды.Рассылка = этоПоследнийПакет;   
		ПараметрыВыполненияКоманды.ЗапускОперацийПослеОбмена = этоПоследнийПакет; 
		
		ПараметрыВыполненияКоманды.КоличествоПотоковФакт = КоличествоПотоковФакт;  

		ПараметрыВыполненияКомандыXML = СтрокаXML(ПараметрыВыполненияКоманды);
		
		// IMAPPS-31419++
		// ВыполнитьФоновоеЗадание(ПараметрыВыполненияКомандыXML, ПараметрыВыполненияКоманды.ОбменРГС);
		Задание = ВыполнитьФоновоеЗадание(ПараметрыВыполненияКомандыXML, ПараметрыВыполненияКоманды.ОбменРГС);
		НоваяЗапись = ТаблицаФоновыхЗаданий.Добавить();
		НоваяЗапись.ФоновоеЗадание = Задание;
		НоваяЗапись.НомерПотока = ТаблицаФоновыхЗаданий.Количество();
		ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация, , , "Запущено фоновое задание по потоку " + НоваяЗапись.НомерПотока);
		
		ОжидатьЗавершенияФоновыхЗаданий(ТаблицаФоновыхЗаданий, МаксКоличествоФоновыхЗаданий);
		// IMAPPS-31419--
		
		ПараметрыВыполненияКоманды.ПулСделок = Неопределено;
	
	КонецЦикла;
	
	// IMAPPS-31419++
	ОжидатьЗавершенияФоновыхЗаданий(ТаблицаФоновыхЗаданий);
	
	Для каждого ЗаписьФЗ Из ТаблицаФоновыхЗаданий Цикл
		Если ЗаписьФЗ.Отказ Тогда
			ТекстОписаниеОшибки = ТекстОписаниеОшибки + Символы.ПС + 
			ЗаписьФЗ.ТекстОшибки;
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	// IMAPPS-31419--
	
	// код снятия с узла документов не в списке договоров 
	
	//// Выгрузка сделок Tn+ пакетами в фоне
	//Для Каждого Портфель Из ВыборкаСделкиTnПоПортфелям.Строки Цикл
