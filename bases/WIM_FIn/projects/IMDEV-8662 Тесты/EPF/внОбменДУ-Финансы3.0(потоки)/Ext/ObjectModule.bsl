Функция КонвертироватьТаблицуИз_COM(Таблица_COM)
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	Для каждого Колонка из Таблица_COM.Columns Цикл
		ТаблицаРезультат.Колонки.Добавить(Колонка.Имя); 
	КонецЦикла;
	
	Для каждого Строка из Таблица_COM Цикл
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
		
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда 
		ПредставлениеНастроек = "<Настройки не установлены>";
		Возврат ПредставлениеНастроек; 
	КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	
	ПредставлениеНастроек = "";
	
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;

КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	
	Если Настройки.Свойство("Значения") Тогда 
		
		УзелОбмена						= Настройки.Значения.УзелОбмена;
		УзелОбменаРГС					= Настройки.Значения.УзелОбменаРГС;
		ВебСервис 						= Настройки.Значения.ВебСервис;
		ПользовательВебСервиса			= Настройки.Значения.ПользовательВебСервиса;
		ПарольВебСервиса				= Настройки.Значения.ПарольВебСервиса;
		ВебСервисРГС 					= Настройки.Значения.ВебСервисРГС;
		ПользовательВебСервисаРГС		= Настройки.Значения.ПользовательВебСервисаРГС;
		ПарольВебСервисаРГС				= Настройки.Значения.ПарольВебСервисаРГС;
		КоличествоПотоков				= Настройки.Значения.КоличествоПотоков;   
		Таймаут							= Настройки.Значения.Таймаут; 
		СтартоватьСделкиПриЗагрузке 	= Настройки.Значения.СтартоватьСделкиПриЗагрузке;
		ОчищатьСпискиДляОбработки 		= Настройки.Значения.ОчищатьСпискиДляОбработки;
		ИспользоватьТранзакции  		= Настройки.Значения.ИспользоватьТранзакции;
		КоличествоОбъектовНаТранзакцию 	= Настройки.Значения.КоличествоОбъектовНаТранзакцию;
		
		// IMAPPS-35434++
		Если Настройки.Значения.Свойство("ЗадержкаЗапускаФоновогоЗадания") Тогда
			ЗадержкаЗапускаФоновогоЗадания 	= Настройки.Значения.ЗадержкаЗапускаФоновогоЗадания;
		КонецЕсли;
		// IMAPPS-35434--
		
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) Тогда 
			ПочтовыйЛогин = Почта;
			
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"),Настройки.Значения.СписокРассылки);
			СписокРассылки.Загрузить(Ящики.Получить());
			
		КонецЕсли; 
		
		ПредставлениеНастроек = "УзелОбмена: " + УзелОбмена + " КоличествоПотоков: " + КоличествоПотоков + " Таймаут: " + Таймаут;

	КонецЕсли;
	
КонецПроцедуры

