	ТаблицаНеЗагруженныхОбъектов = КонвертироватьТаблицуИз_COM(Параметры.ТаблицаНеЗагруженныхОбъектов);
	
	ВсегоЗагружено 		= ТаблицаЗагруженныхОбъектов.Количество();
	ВсегоНеЗагрузилось 	= ТаблицаНеЗагруженныхОбъектов.Количество();
	ВсегоЗагружалось 	= ВсегоЗагружено + ВсегоНеЗагрузилось;
	
	
	МассивВидовСправочников = Новый Массив;
	
	МассивВидовСправочников.Добавить("ДоговорДУ");
	МассивВидовСправочников.Добавить("ДоговорыКонтрагентов");
	МассивВидовСправочников.Добавить("Контрагенты");
	МассивВидовСправочников.Добавить("БанковскиеСчета");
	МассивВидовСправочников.Добавить("СчетаДепо");
	МассивВидовСправочников.Добавить("ТорговыеКоды");
	МассивВидовСправочников.Добавить("АналитическиеСчета");
// AVANCORE  - 15.08.2017 { 
	МассивВидовСправочников.Добавить("Активы");
// AVANCORE  - 15.08.2017 } 

	МассивВидовДокументов = Новый Массив;
	
	МассивВидовДокументов.Добавить("ПоступлениеНаРасчетныйСчет");
	МассивВидовДокументов.Добавить("СписаниеСРасчетногоСчета");
	МассивВидовДокументов.Добавить("Сделка");
	МассивВидовДокументов.Добавить("СделкаНаСрочномРынке");
