"Текст": "Источник = БизнесПроцессы.СделкиTn.НайтиПоНомеру(\"5522-000000340\", Дата(\"20260416\"));\r\n/////////////////////////////////////////////////////////////////////////////////////////\r\nНачВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();\r\n\r\nМассивСсылок = КритерииОтбора.ДокументыПоБизнеспроцессам.Найти(Источник.Ссылка);\r\n\r\nКонВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();\r\nПрошло = КонВремя - НачВремя;\r\nСообщить(\"В РЕЛИЗЕ 2.8.1.0  По-старому = \" + Прошло);\r\n\r\n/////////////////////////////////////////////////////////////////////////////////////////\r\nНачВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();\r\n\r\nМассивСсылок = КритерииОтбора.ДокументыПоБизнеспроцессам.НайтиДокументы(Источник.Ссылка, Не Источник.ПометкаУдаления);\r\n\r\nКонВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();\r\nПрошло = КонВремя - НачВремя;\r\nСообщить(\"В РЕЛИЗЕ 2.8.1.3 По-новому (С ДОП ОТБОРОМ УДАЛЕНИЕ) !!! = \" + Прошло);\r\n\r\n/////////////////////////////////////////////////////////////////////////////////////////\r\nНачВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();\r\n\r\nМассивСсылок = КритерииОтбора.ДокументыПоБизнеспроцессам.НайтиДокументы(Источник.Ссылка);\r\n\r\nКонВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();\r\nПрошло = КонВремя - НачВремя;\r\nСообщить(\"В РЕЛИЗЕ 2.8.1.3  (УБРАЛ ОТБОР ПО ПОМЕТКЕ УДАЛЕНИЯ) = \" + Прошло);",
