{
"Имя": "Алгоритм1_полныйКаркас",
"Текст": "// Создание \"каркасной\" записи БП СделкиTn как при загрузке узла ссылки\r\n// (GUID + поля поиска: ВидОперации, НомерСделки, Дата, Номер, Портфель)\r\n\r\nСтрокаGUID = \"4c3b31ec-6d5b-4e5d-a9ef-2a16f7c0b8e4\";\r\nНаименованиеПортфеля = \"TEST_PORTFOLIO\";\r\n\r\n// 1. Портфель по наименованию\r\nЗапросПортфель = Новый Запрос(\r\n\"ВЫБРАТЬ ПЕРВЫЕ 1\r\n|   Портфели.Ссылка КАК Ссылка\r\n|ИЗ\r\n|   Справочник.Портфели КАК Портфели\r\n|ГДЕ\r\n|   Портфели.Наименование = &Наименование\");\r\nЗапросПортфель.УстановитьПараметр(\"Наименование\", НаименованиеПортфеля);\r\n\r\nВыборкаПортфель = ЗапросПортфель.Выполнить().Выбрать();\r\nЕсли Не ВыборкаПортфель.Следующий() Тогда\r\n    ВызватьИсключение \"Не найден портфель: \" + НаименованиеПортфеля;\r\nКонецЕсли;\r\nПортфель = ВыборкаПортфель.Ссылка;\r\n\r\n// 2. Фиксированный ВидОперации\r\nВидОперации = Перечисления.ВидыОперацийСделка.Продажа;\r\n\r\n// 3. Проверка, что по GUID еще нет объекта\r\nУИД = Новый УникальныйИдентификатор(СтрокаGUID);\r\nСсылкаБП = БизнесПроцессы.СделкиTn.ПолучитьСсылку(УИД);\r\n\r\nПопытка\r\n    СуществующийОбъект = СсылкаБП.ПолучитьОбъект();\r\n    Если Не СуществующийОбъект.ЭтоНовый() Тогда\r\n        ВызватьИсключение \"Объект с таким GUID уже существует: \" + СтрокаGUID;\r\n    КонецЕсли;\r\nИсключение\r\n    // Если получение объекта дало исключение, продолжаем создание\r\nКонецПопытки;\r\n\r\n// 4. Создание каркаса\r\nОбъектБП = БизнесПроцессы.СделкиTn.СоздатьБизнесПроцесс();\r\nОбъектБП.УстановитьСсылкуНового(СсылкаБП);\r\nОбъектБП.ОбменДанными.Загрузка = Истина;\r\n\r\n// Поля поиска из правила СделкиTn\r\nОбъектБП.ВидОперации = ВидОперации;\r\nОбъектБП.НомерСделки = \"TEST_DEAL_0001\";\r\nОбъектБП.Дата = ТекущаяДатаСеанса();\r\nОбъектБП.Номер = \"TEST-000001\";\r\nОбъектБП.Портфель = Портфель;\r\n\r\n// Прочие поля не заполняем\r\n//ОбъектБП.Записать();\r\n\r\n//Сообщить(\"Создан каркас СделкиTn: \" + Строка(ОбъектБП.Ссылка));",
"НаКлиенте": false,
"ИспользоватьОбработкуДляВыполненияКода": false,
"Переменные": [],
"Строки": [
{
"Имя": "Алгоритм_дубль",
"Текст": "СтрокаGUID = \"4c3b31ec-6d5b-4e5d-a9ef-2a16f7c0b8e4\";\r\n    НаименованиеПортфеля = \"TEST_PORTFOLIO\";\r\n\r\n    // 1. Ищем портфель\r\n    ЗапросПортфель = Новый Запрос(\r\n    \"ВЫБРАТЬ ПЕРВЫЕ 1\r\n    |   Портфели.Ссылка КАК Ссылка\r\n    |ИЗ\r\n    |   Справочник.Портфели КАК Портфели\r\n    |ГДЕ\r\n    |   Портфели.Наименование = &Наименование\");\r\n    ЗапросПортфель.УстановитьПараметр(\"Наименование\", НаименованиеПортфеля);\r\n\r\n    ВыборкаПортфель = ЗапросПортфель.Выполнить().Выбрать();\r\n    Если Не ВыборкаПортфель.Следующий() Тогда\r\n        ВызватьИсключение \"Не найден портфель: \" + НаименованиеПортфеля;\r\n    КонецЕсли;\r\n\r\n    Портфель = ВыборкаПортфель.Ссылка;\r\n    ВидОперации = Перечисления.ВидыОперацийСделка.Продажа;\r\n\r\n    // 2. Формируем объект-дубль с тем же GUID и полями поиска\r\n    УИД = Новый УникальныйИдентификатор(СтрокаGUID);\r\n    СсылкаБП = БизнесПроцессы.СделкиTn.ПолучитьСсылку(УИД);\r\n\r\n    Объект = БизнесПроцессы.СделкиTn.СоздатьБизнесПроцесс();\r\n    Объект.УстановитьСсылкуНового(СсылкаБП);\r\n    Объект.ОбменДанными.Загрузка = Истина;\r\n\r\n    // Поля поиска из правила СделкиTn\r\n    Объект.ВидОперации = ВидОперации;\r\n    Объект.НомерСделки = \"TEST_DEAL_0001\";\r\n    Объект.Дата = ТекущаяДатаСеанса();\r\n    Объект.Номер = \"TEST-000001\";\r\n    Объект.Портфель = Портфель;\r\n\r\n    // 3. Логика записи как в патче ЗаписатьОбъектВИБ\r\n    Попытка\r\n\r\n        Объект.Записать();\r\n        Сообщить(\"Запись выполнена без конфликта: \" + Строка(Объект.Ссылка));\r\n        ВызватьИсключение \"Запись выполнена без конфликта: \";\r\n\r\n    Исключение\r\n\r\n        ТекстОшибки = ОписаниеОшибки();\r\n        Верх = ВРег(ТекстОшибки);\r\n\r\n        ЭтоОшибкаДубля =\r\n            СтрНайти(Верх, \"PRIMARY KEY\") > 0\r\n            Или СтрНайти(Верх, \"UNIQUE KEY\") > 0\r\n            Или СтрНайти(Верх, \"UNIQUE CONSTRAINT\") > 0\r\n            Или СтрНайти(Верх, \"НАРУШЕНИЕ ОГРАНИЧЕНИЯ UNIQUE\") > 0\r\n            Или СтрНайти(Верх, \"НАРУШЕНИЕ ОГРАНИЧЕНИЯ PRIMARY KEY\") > 0\r\n            Или СтрНайти(Верх, \"UNIQUE VIOLATION\") > 0;\r\n\r\n        Если ЭтоОшибкаДубля Тогда\r\n\r\n            СсылкаОбъекта = Неопределено;\r\n            Попытка\r\n                СсылкаОбъекта = Объект.Ссылка;\r\n            Исключение\r\n            КонецПопытки;\r\n\u0009\u0009\u0009Сообщить(\"СсылкаОбъекта = \" + СсылкаОбъекта + \" ТИп ссылка = \" + ТипЗнч(СсылкаОбъекта));\r\n\u0009\u0009\u0009Сообщить(\"СсылкаОбъекта <> Неопределено - \" + СсылкаОбъекта <> Неопределено);\r\n            Если СсылкаОбъекта <> Неопределено\r\n                И Не СсылкаОбъекта.Пустая()\r\n                И ТипЗнч(СсылкаОбъекта) = Тип(\"БизнесПроцессСсылка.СделкиTn\") Тогда\r\n\u0009\u0009\u0009\u0009Сообщить(\"я тут\");\r\n                Попытка\r\n\r\n                    ОбъектВБ = СсылкаОбъекта.ПолучитьОбъект();\r\n\r\n                    Если ОбъектВБ <> Неопределено И Не ОбъектВБ.ЭтоНовый() Тогда\r\n\u0009\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009\u0009\u0009// Единый признак: объект в ИБ неполный (каркас)\r\n\u0009\u0009\u0009\u0009\u0009\u0009ЕстьБазаКаркаса =\r\n\u0009\u0009\u0009\u0009\u0009\u0009ЗначениеЗаполнено(ОбъектВБ.Портфель)\r\n\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Номер)\r\n\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Дата)\r\n\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.НомерСделки);\r\n\u0009\u0009\u0009\u0009\u0009\u0009ЕстьДанныеПолногоОбъекта =\r\n\u0009\u0009\u0009\u0009\u0009\u0009ЗначениеЗаполнено(ОбъектВБ.Актив)\r\n\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Количество)\r\n\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Цена)\r\n\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Сумма);\r\n\u0009\u0009\u0009\u0009\u0009\u0009ОбъектВИБНеполный = ЕстьБазаКаркаса И Не ЕстьДанныеПолногоОбъекта;\r\n\r\n                        Если Не ОбъектВИБНеполный Тогда\r\n                            Сообщить(\"Дубль PK: объект уже есть в БД, считаем успехом: \" + Строка(СсылкаОбъекта));\r\n                            ВызватьИсключение \"УЖЕ ЕСТЬ\";\r\n                        КонецЕсли;\r\n\r\n                        // Неполный объект: удалить и записать наш вариант заново\r\n                        //ОбъектВБ.ОбменДанными.Загрузка = Истина;\r\n                        //ОбъектВБ.Удалить();\r\n\r\n                        //Объект.ОбменДанными.Загрузка = Истина;\r\n                        //Объект.Записать();\r\n\r\n                        Сообщить(\"Дубль PK: каркас удален, объект перезаписан: \" + Строка(Объект.Ссылка));\r\n                        ВызватьИсключение \"ПЕРЕЗАПИСЬ\";\r\n\r\n                    КонецЕсли;\r\n\r\n                Исключение\r\n                    // Если здесь ошибка, отдаем исходное исключение ниже\r\n                КонецПопытки;\r\n\r\n            КонецЕсли;\r\n\r\n\u0009\u0009Иначе\r\n\u0009\u0009\u0009ВызватьИсключение \"Ошибка записи дубля СделкиTn: \" + ТекстОшибки;\r\n        КонецЕсли;\r\n\u0009\u0009\u0009\r\n\r\n\r\n    КонецПопытки;",
"НаКлиенте": false,
"ИспользоватьОбработкуДляВыполненияКода": false,
"Переменные": [],
"Строки": [
{
"Имя": "Алгоритм6",
"Текст": "Попытка\r\n\u0009п =1 /0;\r\nИсключение\r\n\u0009ВызватьИсключение \"вв\"\r\nКонецПопытки;\r\nСообщить(\"странно\");",
"НаКлиенте": false,
"ИспользоватьОбработкуДляВыполненияКода": false,
"Переменные": [],
"Строки": []
}
