{
"Имя": "Алгоритм_дубль11",
"Текст": "СтрокаGUID = \"4c3b31ec-6d5b-4e5d-a9ef-2a16f7c0b8e4\";\r\n    НаименованиеПортфеля = \"TEST_PORTFOLIO\";\r\n\r\n    // 1. Ищем портфель\r\n    ЗапросПортфель = Новый Запрос(\r\n    \"ВЫБРАТЬ ПЕРВЫЕ 1\r\n    |   Портфели.Ссылка КАК Ссылка\r\n    |ИЗ\r\n    |   Справочник.Портфели КАК Портфели\r\n    |ГДЕ\r\n    |   Портфели.Наименование = &Наименование\");\r\n    ЗапросПортфель.УстановитьПараметр(\"Наименование\", НаименованиеПортфеля);\r\n\r\n    ВыборкаПортфель = ЗапросПортфель.Выполнить().Выбрать();\r\n    Если Не ВыборкаПортфель.Следующий() Тогда\r\n        ВызватьИсключение \"Не найден портфель: \" + НаименованиеПортфеля;\r\n    КонецЕсли;\r\n\r\n    Портфель = ВыборкаПортфель.Ссылка;\r\n    ВидОперации = Перечисления.ВидыОперацийСделка.Продажа;\r\n\r\n    // 2. Формируем объект-дубль с тем же GUID и полями поиска\r\n    УИД = Новый УникальныйИдентификатор(СтрокаGUID);\r\n    СсылкаБП = БизнесПроцессы.СделкиTn.ПолучитьСсылку(УИД);\r\n\r\n    Объект = БизнесПроцессы.СделкиTn.СоздатьБизнесПроцесс();\r\n    Объект.УстановитьСсылкуНового(СсылкаБП);\r\n    Объект.ОбменДанными.Загрузка = Истина;\r\n\r\n    // Поля поиска из правила СделкиTn\r\n    Объект.ВидОперации = ВидОперации;\r\n    Объект.НомерСделки = \"TEST_DEAL_0001\";\r\n    Объект.Дата = ТекущаяДатаСеанса();\r\n    Объект.Номер = \"TEST-000001\";\r\n\u0009Объект.Портфель = Портфель;\r\n\u0009\r\n\u0009///////////////////////////////////////////////////////////////////////////////////\r\n\u0009\r\n\u0009\u0009Успех = Ложь;\r\n\u0009\u0009НужноПерезаписать = Ложь;\r\n\u0009\u0009СообщениеРезультат = \"\";\r\n\u0009\u0009\r\n\u0009\u0009// Попытка первичной записи дубля\r\n\u0009\u0009Попытка\r\n\u0009\u0009\u0009Объект.Записать();\r\n\u0009\u0009\u0009Успех = Истина;\r\n\u0009\u0009\u0009СообщениеРезультат = \"Запись выполнена без конфликта: \" + Строка(Объект.Ссылка);\r\n\u0009\u0009Исключение\r\n\u0009\u0009\u0009ТекстОшибки = ОписаниеОшибки();\r\n\u0009\u0009\u0009Верх = ВРег(ТекстОшибки);\r\n\u0009\u0009\u0009\r\n\u0009\u0009\u0009ЭтоОшибкаДубля =\r\n\u0009\u0009\u0009СтрНайти(Верх, \"PRIMARY KEY\") > 0\r\n\u0009\u0009\u0009Или СтрНайти(Верх, \"UNIQUE KEY\") > 0\r\n\u0009\u0009\u0009Или СтрНайти(Верх, \"UNIQUE CONSTRAINT\") > 0\r\n\u0009\u0009\u0009Или СтрНайти(Верх, \"НАРУШЕНИЕ ОГРАНИЧЕНИЯ UNIQUE\") > 0\r\n\u0009\u0009\u0009Или СтрНайти(Верх, \"НАРУШЕНИЕ ОГРАНИЧЕНИЯ PRIMARY KEY\") > 0\r\n\u0009\u0009\u0009Или СтрНайти(Верх, \"UNIQUE VIOLATION\") > 0;\r\n\u0009\u0009\u0009\r\n\u0009\u0009\u0009Если ЭтоОшибкаДубля Тогда\r\n\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009// Для теста используем ссылку, которую сами задали через УстановитьСсылкуНового\r\n\u0009\u0009\u0009\u0009СсылкаОбъекта = СсылкаБП;\r\n\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009Если ЗначениеЗаполнено(СсылкаОбъекта)\r\n\u0009\u0009\u0009\u0009\u0009И ТипЗнч(СсылкаОбъекта) = Тип(\"БизнесПроцессСсылка.СделкиTn\") Тогда\r\n\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009\u0009Попытка\r\n\u0009\u0009\u0009\u0009\u0009\u0009ОбъектВБ = СсылкаОбъекта.ПолучитьОбъект();\r\n\u0009\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009\u0009\u0009Если ОбъектВБ <> Неопределено И Не ОбъектВБ.ЭтоНовый() Тогда\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009// Единый признак: объект в ИБ неполный\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009ЕстьБазаКаркаса =\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009ЗначениеЗаполнено(ОбъектВБ.Портфель)\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Номер)\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Дата)\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.НомерСделки);\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009ЕстьДанныеПолногоОбъекта =\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009ЗначениеЗаполнено(ОбъектВБ.Актив)\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Количество)\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Цена)\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Сумма);\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009ОбъектВИБНеполный = ЕстьБазаКаркаса И Не ЕстьДанныеПолногоОбъекта;\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009Если ОбъектВИБНеполный Тогда\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009НужноПерезаписать = Истина;\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009Иначе\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009Успех = Истина;\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009СообщениеРезультат = \"Дубль PK: полный объект уже есть в БД, считаем успехом: \" + Строка(СсылкаОбъекта);\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009КонецЕсли;\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009\u0009\u0009Иначе\r\n\u0009\u0009\u0009\u0009\u0009\u0009\u0009СообщениеРезультат = \"После ошибки PK объект по GUID не найден в базе\";\r\n\u0009\u0009\u0009\u0009\u0009\u0009КонецЕсли;\r\n\u0009\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009\u0009Исключение\r\n\u0009\u0009\u0009\u0009\u0009\u0009СообщениеРезультат = \"Ошибка при чтении объекта из базы: \" + ОписаниеОшибки();\r\n\u0009\u0009\u0009\u0009\u0009КонецПопытки;\r\n\u0009\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009Иначе\r\n\u0009\u0009\u0009\u0009\u0009СообщениеРезультат = \"Ссылка невалидна: \" + Строка(СсылкаОбъекта);\r\n\u0009\u0009\u0009\u0009КонецЕсли;\r\n\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009Иначе\r\n\u0009\u0009\u0009\u0009СообщениеРезультат = \"Ошибка записи дубля СделкиTn: \" + ТекстОшибки;\r\n\u0009\u0009\u0009КонецЕсли;\r\n\u0009\u0009\u0009\r\n\u0009\u0009КонецПопытки;\r\n\u0009\u0009\r\n\u0009\u0009// Отдельный шаг перезаписи (если нужен)\r\n\u0009\u0009Если НужноПерезаписать Тогда\r\n\u0009\u0009\u0009Попытка\r\n\u0009\u0009\u0009\u0009//ОбъектВБ.ОбменДанными.Загрузка = Истина;\r\n\u0009\u0009\u0009\u0009//ОбъектВБ.Удалить();\r\n\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009//Объект.ОбменДанными.Загрузка = Истина;\r\n\u0009\u0009\u0009\u0009//Объект.Записать();\r\n\u0009\u0009\u0009\u0009\r\n\u0009\u0009\u0009\u0009Успех = Истина;\r\n\u0009\u0009\u0009\u0009СообщениеРезультат = \"Дубль PK: каркас удален, объект перезаписан: \" + Строка(Объект.Ссылка);\r\n\u0009\u0009\u0009Исключение\r\n\u0009\u0009\u0009\u0009СообщениеРезультат = \"Ошибка перезаписи каркаса: \" + ОписаниеОшибки();\r\n\u0009\u0009\u0009КонецПопытки;\r\n\u0009\u0009КонецЕсли;\r\n\u0009\u0009\r\n\u0009\u0009// Финальное сообщение\r\n\u0009\u0009Если Успех Тогда\r\n\u0009\u0009\u0009Сообщить(\"OK: \" + СообщениеРезультат);\r\n\u0009\u0009Иначе\r\n\u0009\u0009\u0009Сообщить(\"ERROR: \" + СообщениеРезультат);\r\n\u0009\u0009КонецЕсли;",
"НаКлиенте": false,
"ИспользоватьОбработкуДляВыполненияКода": false,
"Переменные": [],
"Строки": []
},
