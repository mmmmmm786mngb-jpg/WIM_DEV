"Имя": "Алгоритм_дубль12",
"Текст": "СтрокаGUID = \"4c3b31ec-6d5b-4e5d-a9ef-2a16f7c0b8e4\";\r\nНаименованиеПортфеля = \"TEST_PORTFOLIO\";\r\n\r\n// 1. Ищем портфель\r\nЗапросПортфель = Новый Запрос(\r\n\"ВЫБРАТЬ ПЕРВЫЕ 1\r\n|   Портфели.Ссылка КАК Ссылка\r\n|ИЗ\r\n|   Справочник.Портфели КАК Портфели\r\n|ГДЕ\r\n|   Портфели.Наименование = &Наименование\");\r\nЗапросПортфель.УстановитьПараметр(\"Наименование\", НаименованиеПортфеля);\r\n\r\nВыборкаПортфель = ЗапросПортфель.Выполнить().Выбрать();\r\nЕсли Не ВыборкаПортфель.Следующий() Тогда\r\n\u0009ВызватьИсключение \"Не найден портфель: \" + НаименованиеПортфеля;\r\nКонецЕсли;\r\n\r\nПортфель = ВыборкаПортфель.Ссылка;\r\nВидОперации = Перечисления.ВидыОперацийСделка.Продажа;\r\n\r\n// 2. Формируем объект-дубль с тем же GUID и полями поиска\r\nУИД = Новый УникальныйИдентификатор(СтрокаGUID);\r\nСсылкаБП = БизнесПроцессы.СделкиTn.ПолучитьСсылку(УИД);\r\n\r\nОбъект = БизнесПроцессы.СделкиTn.СоздатьБизнесПроцесс();\r\nОбъект.УстановитьСсылкуНового(СсылкаБП);\r\nОбъект.ОбменДанными.Загрузка = Истина;\r\n\r\n// Поля поиска из правила СделкиTn\r\nОбъект.ВидОперации = ВидОперации;\r\nОбъект.НомерСделки = \"TEST_DEAL_0001\";\r\nОбъект.Дата = ТекущаяДатаСеанса();\r\nОбъект.Номер = \"TEST-000001\";\r\nОбъект.Портфель = Портфель;\r\n\r\n///////////////////////////////////////////////////////////////////////////////////\r\nСсылкаОбъектаДляПроверки = СсылкаБП;\r\n\r\nПОРТФ = СсылкаБП.Портфель;\r\n\r\nСообщить(\"ЗначениеЗаполнено(СсылкаОбъектаДляПроверки) = \" + ЗначениеЗаполнено(СсылкаОбъектаДляПроверки));\r\nСообщить(\"ПОРТФ = \" +ПОРТФ);\r\n// Попытка первичной записи дубля\r\nПопытка\r\n\u0009Объект.Записать();\r\n\r\nИсключение\r\n    ИнфоОшибки = ИнформацияОбОшибке();\r\n\u0009ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОшибки);\r\n\u0009Сообщить(ТекстОшибки);\r\n    Верх = ВРег(ТекстОшибки);\r\n    ЭтоОшибкаДубля =\r\n        СтрНайти(Верх, \"PRIMARY KEY\") > 0\r\n        Или СтрНайти(Верх, \"UNIQUE KEY\") > 0\r\n        Или СтрНайти(Верх, \"UNIQUE CONSTRAINT\") > 0\r\n        Или СтрНайти(Верх, \"НАРУШЕНИЕ ОГРАНИЧЕНИЯ UNIQUE\") > 0\r\n        Или СтрНайти(Верх, \"НАРУШЕНИЕ ОГРАНИЧЕНИЯ PRIMARY KEY\") > 0\r\n        Или СтрНайти(Верх, \"UNIQUE VIOLATION\") > 0;\r\n    Если ЭтоОшибкаДубля Тогда\r\n        СсылкаОбъекта = Неопределено;\r\n        Попытка\r\n            СсылкаОбъекта = Объект.Ссылка;\r\n        Исключение\r\n            СсылкаОбъекта = Неопределено;\r\n\u0009\u0009КонецПопытки;\r\n\u0009\u0009///////////Сообщить(\"ЗначениеЗаполнено(СсылкаОбъекта) = \" + ЗначениеЗаполнено(СсылкаОбъекта));\r\n        Если Объект.ЭтоНовый()\r\n            И ТипЗнч(СсылкаОбъекта) = Тип(\"БизнесПроцессСсылка.СделкиTn\") Тогда\r\n            Попытка\r\n                ОбъектВБ = СсылкаОбъекта.ПолучитьОбъект();\r\n                Если ОбъектВБ <> Неопределено И Не ОбъектВБ.ЭтоНовый() Тогда\r\n                    ЕстьБазаКаркаса =\r\n                        ЗначениеЗаполнено(ОбъектВБ.Портфель)\r\n                        Или ЗначениеЗаполнено(ОбъектВБ.Номер)\r\n                        Или ЗначениеЗаполнено(ОбъектВБ.Дата)\r\n                        Или ЗначениеЗаполнено(ОбъектВБ.НомерСделки);\r\n                    ЕстьДанныеПолногоОбъекта =\r\n                        ЗначениеЗаполнено(ОбъектВБ.Актив)\r\n                        Или ЗначениеЗаполнено(ОбъектВБ.Количество)\r\n                        Или ЗначениеЗаполнено(ОбъектВБ.Цена)\r\n                        Или ЗначениеЗаполнено(ОбъектВБ.Сумма);\r\n                    ОбъектВИБНеполный = ЕстьБазаКаркаса И Не ЕстьДанныеПолногоОбъекта;\r\n                    Если Не ОбъектВИБНеполный Тогда\r\n\u0009\u0009\u0009\u0009\u0009\u0009//Возврат;\r\n\u0009\u0009\u0009\u0009\u0009\u0009ВызватьИсключение \"Возврат , оставляем то что в базе !\"\r\n                    КонецЕсли;\r\n                    //УстановитьОбменДаннымиЗагрузка(ОбъектВБ);\r\n                    //ОбъектВБ.Удалить();\r\n                    //УстановитьОбменДаннымиЗагрузка(Объект);\r\n                    //Объект.Записать();\r\n\u0009\u0009\u0009\u0009\u0009//Возврат;\r\n\u0009\u0009\u0009\u0009\u0009ВызватьИсключение \"Возврат , Перезаписываем !\"\r\n\u0009\u0009\u0009\u0009\u0009\r\n                КонецЕсли;\r\n            Исключение\r\n\u0009\u0009\u0009\u0009// Не удалось дообработать дубль, идем в штатную ошибку ниже.\r\n\u0009\u0009\u0009\u0009Сообщить(\"Не удалось дообработать дубль, идем в штатную ошибку ниже.\");\r\n            КонецПопытки;\r\n        КонецЕсли;\r\n\u0009КонецЕсли;\r\n\u0009\r\n\u0009Сообщить(\"Стандартная ошибка\");\r\n    //СтрокаСообщенияОбОшибке = ЗаписатьИнформациюОбОшибкеВПротокол(26, ТекстОшибки, Объект, Тип);\r\n    //Если Не ФлагРежимОтладки Тогда\r\n    //    ВызватьИсключение СтрокаСообщенияОбОшибке;\r\n    //КонецЕсли;\r\nКонецПопытки",
"НаКлиенте": false,
"ИспользоватьОбработкуДляВыполненияКода": false,
"Переменные": [],
"Строки": []
},
{
"Имя": "Алгоритм_дубль13",
"Текст": "СтрокаGUID = \"4c3b31ec-6d5b-4e5d-a9ef-2a16f7c0b8e4\";\r\nНаименованиеПортфеля = \"TEST_PORTFOLIO\";\r\n\r\n// 1. Ищем портфель\r\nЗапросПортфель = Новый Запрос(\r\n\"ВЫБРАТЬ ПЕРВЫЕ 1\r\n|   Портфели.Ссылка КАК Ссылка\r\n|ИЗ\r\n|   Справочник.Портфели КАК Портфели\r\n|ГДЕ\r\n|   Портфели.Наименование = &Наименование\");\r\nЗапросПортфель.УстановитьПараметр(\"Наименование\", НаименованиеПортфеля);\r\n\r\nВыборкаПортфель = ЗапросПортфель.Выполнить().Выбрать();\r\nЕсли Не ВыборкаПортфель.Следующий() Тогда\r\n\u0009ВызватьИсключение \"Не найден портфель: \" + НаименованиеПортфеля;\r\nКонецЕсли;\r\n\r\nПортфель = ВыборкаПортфель.Ссылка;\r\nВидОперации = Перечисления.ВидыОперацийСделка.Продажа;\r\n\r\n// 2. Формируем объект-дубль с тем же GUID и полями поиска\r\nУИД = Новый УникальныйИдентификатор(СтрокаGUID);\r\nСсылкаБП = БизнесПроцессы.СделкиTn.ПолучитьСсылку(УИД);\r\n\r\nОбъект = БизнесПроцессы.СделкиTn.СоздатьБизнесПроцесс();\r\nОбъект.УстановитьСсылкуНового(СсылкаБП);\r\nОбъект.ОбменДанными.Загрузка = Истина;\r\n\r\n// Поля поиска из правила СделкиTn\r\nОбъект.ВидОперации = ВидОперации;\r\nОбъект.НомерСделки = \"TEST_DEAL_0001\";\r\nОбъект.Дата = ТекущаяДатаСеанса();\r\nОбъект.Номер = \"TEST-000001\";\r\nОбъект.Портфель = Портфель;\r\nОбъект.Количество = 1;   \u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009\u0009//   !!! ПОЛНЫЙ ОБЪЕКТ !!!\r\nОбъект.Актив = Справочники.Активы.НайтиПоНаименованию(\"TestA\"); //   !!! ПОЛНЫЙ ОБЪЕКТ !!!\r\n\r\n///////////////////////////////////////////////////////////////////////////////////\r\n\r\n// Попытка первичной записи дубля\r\nПопытка\r\n\u0009Объект.Записать();\r\n\u0009\r\nИсключение\r\n\u0009\r\n\u0009ТекстОшибки = ВРег(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));\r\n\u0009//Сообщить(ТекстОшибки);\r\n\u0009\r\n\u0009//  ПОИСК Объекта в базе -------------------------------->>\r\n\u0009ОбъектВБ = Неопределено;\r\n\u0009ЭтоОшибкаДубля = СтрНайти(ТекстОшибки, \"PRIMARY KEY\") > 0;\r\n\u0009Если ЭтоОшибкаДубля Тогда\r\n\u0009\u0009// 1. Выделяем hex-ключ из текста ошибки\r\n\u0009\u0009МаркерНач = \"0X\";\r\n\u0009\u0009ПозицияНач = СтрНайти(ТекстОшибки, МаркерНач);\r\n\u0009\u0009Если ПозицияНач = 0 Тогда\r\n\u0009\u0009\u0009ЭтоОшибкаДубля = Ложь;\r\n\u0009\u0009\u0009//ВызватьИсключение \"В тексте ошибки не найден duplicate key в формате 0x...\";\r\n\u0009\u0009КонецЕсли;\r\n\u0009\u0009// Берем 32 hex-символа после 0x\r\n\u0009\u0009Hex = Сред(ТекстОшибки, ПозицияНач + 2, 32);\r\n\u0009\u0009Hex = СтрЗаменить(Hex, \" \", \"\");\r\n\u0009\u0009Если СтрДлина(Hex) <> 32 Тогда\r\n\u0009\u0009\u0009ЭтоОшибкаДубля = Ложь;\r\n\u0009\u0009\u0009//ВызватьИсключение \"Неверная длина hex-ключа duplicate key: \" + Hex;\r\n\u0009\u0009КонецЕсли;\r\n\u0009\u0009Если ЭтоОшибкаДубля Тогда\r\n\u0009\u0009\u0009// 2. Переводим SQL-hex в GUID-строку 1С\r\n\u0009\u0009\u0009GUIDСтрокой =\r\n\u0009\u0009\u0009НРег(Сред(Hex, 25, 8)) + \"-\" +\r\n\u0009\u0009\u0009НРег(Сред(Hex, 21, 4)) + \"-\" +\r\n\u0009\u0009\u0009НРег(Сред(Hex, 17, 4)) + \"-\" +\r\n\u0009\u0009\u0009НРег(Сред(Hex, 1, 4))  + \"-\" +\r\n\u0009\u0009\u0009НРег(Сред(Hex, 5, 12));\r\n\u0009\u0009\u0009Сообщить(\"GUID из duplicate key: \" + GUIDСтрокой);\r\n\u0009\u0009\u0009// 3. Получаем ссылку и объект из базы\r\n\u0009\u0009\u0009Ссылка = БизнесПроцессы.СделкиTn.ПолучитьСсылку(Новый УникальныйИдентификатор(GUIDСтрокой));\r\n\u0009\u0009\u0009ОбъектВБ = Ссылка.ПолучитьОбъект();\r\n\u0009\u0009\u0009Если ОбъектВБ.ЭтоНовый() Тогда\r\n\u0009\u0009\u0009\u0009//Сообщить(\"По GUID объект не найден в базе\");\r\n\u0009\u0009\u0009\u0009ЭтоОшибкаДубля = Ложь;\r\n\u0009\u0009\u0009Иначе\r\n\u0009\u0009\u0009\u0009Сообщить(\"Объект найден: \" + Строка(Ссылка));\r\n\u0009\u0009\u0009КонецЕсли;\r\n\u0009\u0009КонецЕсли;\r\n\u0009КонецЕсли;\r\n\u0009// ПОИСК Объекта в базе <<--------------------------------\r\n\u0009\r\n\u0009Если ЭтоОшибкаДубля Тогда\r\n//\u0009\u0009\r\n//\u0009\u0009ЕстьБазаКаркаса =\r\n//\u0009\u0009\u0009ЗначениеЗаполнено(ОбъектВБ.Портфель)\r\n//\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Номер)\r\n//\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Дата)\r\n//\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.НомерСделки);\r\n//\u0009\u0009ЕстьДанныеПолногоОбъекта =\r\n//\u0009\u0009\u0009ЗначениеЗаполнено(ОбъектВБ.Актив)\r\n//\u0009\u0009\u0009Или ЗначениеЗаполнено(ОбъектВБ.Количество);\r\n//\u0009\u0009ОбъектВИБНеполный = ЕстьБазаКаркаса И Не ЕстьДанныеПолногоОбъекта;\r\n//\u0009\u0009\r\n//\u0009\u0009Если ОбъектВИБНеполный Тогда\r\n//\u0009\u0009\u0009Сообщить(\"Возврат , Перезаписываем !\");\r\n//\u0009\u0009\u0009ОбъектВБ.ОбменДанными.Загрузка = Истина;\r\n//\u0009\u0009\u0009ОбъектВБ.Удалить();\r\n//\u0009\u0009\u0009Объект.ОбменДанными.Загрузка = Истина;\r\n//\u0009\u0009\u0009Объект.Записать();\r\n//\u0009\u0009Иначе\r\n//\u0009\u0009\u0009Сообщить(\"Возврат , оставляем то что в базе !\");\r\n//\u0009\u0009КонецЕсли;\r\n\u0009\u0009\r\n\u0009\u0009\r\n\u0009\u0009ОбъектПолный = ЗначениеЗаполнено(Объект.Актив) И ЗначениеЗаполнено(Объект.Количество);\r\n\u0009\u0009ОбъектВБПолный = ЗначениеЗаполнено(ОбъектВБ.Актив) И ЗначениеЗаполнено(ОбъектВБ.Количество);\r\n\u0009\u0009Если Не ОбъектПолный Тогда\r\n\u0009\u0009\u0009// Объект неполный ИЛИ оба неполные (второе уже входит в это условие)\r\n\u0009\u0009\u0009Сообщить(\"Возврат: не трогаем базу, ошибку не считаем [Объект неполный ИЛИ оба неполные]\");\r\n\r\n\u0009\u0009ИначеЕсли Не ОбъектВБПолный Тогда\r\n\u0009\u0009\u0009// Объект полный, в базе неполный - перезаписываем\r\n\u0009\u0009\u0009Сообщить(\"Перезаписываем: в базе неполный объект\");\r\n\u0009\u0009\u0009ОбъектВБ.ОбменДанными.Загрузка = Истина;\r\n\u0009\u0009\u0009ОбъектВБ.Удалить();\r\n\u0009\u0009\u0009Объект.ОбменДанными.Загрузка = Истина;\r\n\u0009\u0009\u0009Объект.Записать();\r\n\r\n\u0009\u0009Иначе\r\n\u0009\u0009\u0009// Оба полные - это уже конфликт данных, оставляем стандартную ошибку\r\n\u0009\u0009\u0009Сообщить(\"Оба полные: оставляем ошибку как в оригинале\");\r\n\u0009\u0009\u0009Сообщить(\"Стандартная обработка ошибки\");\r\n\u0009\u0009\u0009//\u0009\u0009СтрокаСообщенияОбОшибке = ЗаписатьИнформациюОбОшибкеВПротокол(26, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),\r\n\u0009\u0009\u0009//\u0009\u0009\u0009Объект, Тип);\r\n\u0009\u0009\u0009//\r\n\u0009\u0009\u0009//\u0009\u0009Если Не ФлагРежимОтладки Тогда\r\n\u0009\u0009\u0009//\u0009\u0009\u0009ВызватьИсключение СтрокаСообщенияОбОшибке;\r\n\u0009\u0009\u0009//\u0009\u0009КонецЕсли;\r\n\u0009\u0009КонецЕсли;\r\n\r\n\u0009Иначе\r\n\u0009\u0009Сообщить(\"Стандартная обработка ошибки\");\r\n\u0009\u0009//\u0009\u0009СтрокаСообщенияОбОшибке = ЗаписатьИнформациюОбОшибкеВПротокол(26, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),\r\n\u0009\u0009//\u0009\u0009\u0009Объект, Тип);\r\n\u0009\u0009//\r\n\u0009\u0009//\u0009\u0009Если Не ФлагРежимОтладки Тогда\r\n\u0009\u0009//\u0009\u0009\u0009ВызватьИсключение СтрокаСообщенияОбОшибке;\r\n\u0009\u0009//\u0009\u0009КонецЕсли;\r\n\u0009КонецЕсли;\r\n\u0009\r\nКонецПопытки",
"НаКлиенте": false,
"ИспользоватьОбработкуДляВыполненияКода": false,
"Переменные": [],
"Строки": []
},
