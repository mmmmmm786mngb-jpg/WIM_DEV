{
"Имя": "Алгоритм2",
"Текст": "ИмяБизнесПроцесса = \"СделкиTn\";\r\nСтрокаGUID = \"7f2e2f5a-9be8-4a77-8ff5-d8d6a9fc3c5e\";\r\n\r\nЕсли Метаданные.БизнесПроцессы.Найти(ИмяБизнесПроцесса) = Неопределено Тогда\r\n    ВызватьИсключение \"Не найден бизнес-процесс: \" + ИмяБизнесПроцесса;\r\nКонецЕсли;\r\n\r\nМенеджерБП = БизнесПроцессы[ИмяБизнесПроцесса];\r\nОбъектБП = МенеджерБП.СоздатьБизнесПроцесс();\r\n\r\n// Фиксируем ссылку с конкретным GUID\r\nСсылкаНового = МенеджерБП.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаGUID));\r\nОбъектБП.УстановитьСсылкуНового(СсылкаНового);\r\n\r\n// Режим загрузки как в УОД\r\nОбъектБП.ОбменДанными.Загрузка = Истина;\r\n\r\n// Для БП дата должна быть заполнена\r\nЕсли Не ЗначениеЗаполнено(ОбъектБП.Дата) Тогда\r\n    ОбъектБП.Дата = ТекущаяДатаСеанса();\r\nКонецЕсли;\r\n\r\n// Типичный \"каркас\" при записи по ссылке\r\nОбъектБП.ПометкаУдаления = Истина;\r\n\r\n// Если есть обязательные реквизиты конкретно у СделкиTn - заполните их перед записью\r\n// ОбъектБП.<ИмяРеквизита> = <Значение>;\r\n\r\n\r\nПОПЫТКА\r\n\u0009ОбъектБП.ОбменДанными\r\n\u0009ОбъектБП.Записать();\r\nИсключение\r\n\u0009\r\nКонецПопытки",
