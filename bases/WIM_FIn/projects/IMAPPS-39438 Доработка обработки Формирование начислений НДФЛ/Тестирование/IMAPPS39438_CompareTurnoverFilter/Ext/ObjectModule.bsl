#Область ОписаниеПеременных

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Описание: Сведения для подключения через БСП «Дополнительные отчеты и обработки».
//
// Возвращаемое значение:
// Структура - параметры регистрации дополнительной обработки
//
Функция СведенияОВнешнейОбработке() Экспорт

	МетаданныеОбработки = Метаданные();

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация =
		"IMAPPS-39438. Сравнение отсева пар клиент+УК: счета постановки Jira против широкого списка счетов доходов.";

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = МетаданныеОбработки.Представление();
	НоваяКоманда.Идентификатор = МетаданныеОбработки.Имя;
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Берет кандидатов как Заполнить варианта 2 обработки ФормированиеНачисленийНДФЛ
// и сравнивает, кого отсеет список счетов Jira и кого - широкий список счетов доходов.
//
// Параметры:
// ПараметрыСравнения - Структура - Период, Клиент, УправляющаяКомпания, флаги заполнения, строки счетов
//
// Возвращаемое значение:
// Структура - счетчики, вердикт и таблица отличий
//
Функция СравнитьОтсев(ПараметрыСравнения) Экспорт

	Результат = ПустойРезультатСравнения();

	Если Не ЗначениеЗаполнено(ПараметрыСравнения.Период.ДатаОкончания) Тогда
		Результат.Вердикт = "Укажите период заполнения (дату окончания).";
		Возврат Результат;
	КонецЕсли;

	СтрокаJira = СокрЛП(ПараметрыСравнения.СчетаJira);
	Если Не ЗначениеЗаполнено(СтрокаJira) Тогда
		СтрокаJira = СтрокаСчетовJiraПоУмолчанию();
	КонецЕсли;

	СтрокаШирокие = СокрЛП(ПараметрыСравнения.СчетаШирокие);
	Если Не ЗначениеЗаполнено(СтрокаШирокие) Тогда
		СтрокаШирокие = СтрокаСчетовШирокихПоУмолчанию();
	КонецЕсли;

	СчетаJira = ПланыСчетов.Хозрасчетный.СчетаПоСтроке(СтрокаJira);
	СчетаШирокие = ПланыСчетов.Хозрасчетный.СчетаПоСтроке(СтрокаШирокие);

	Если СчетаJira.Количество() = 0 Тогда
		Результат.Вердикт = "Не разобран список счетов постановки Jira.";
		Возврат Результат;
	КонецЕсли;

	Если СчетаШирокие.Количество() = 0 Тогда
		Результат.Вердикт = "Не разобран широкий список счетов.";
		Возврат Результат;
	КонецЕсли;

	ТаблицаКандидатов = КандидатыЗаполнитьВариант2(ПараметрыСравнения);
	Результат.КоличествоКандидатов = ТаблицаКандидатов.Количество();

	Если ТаблицаКандидатов.Количество() = 0 Тогда
		Результат.Вердикт = "Заполнить (вариант 2) не вернул ни одной пары клиент+УК.";
		Возврат Результат;
	КонецЕсли;

	НаборJira = СоответствиеСчетов(СчетаJira);
	НаборШирокие = СоответствиеСчетов(СчетаШирокие);

	ОборотыПар = ОборотыПарПоСчетам(
		ТаблицаКандидатов,
		ПараметрыСравнения.Период,
		ОбъединитьМассивыСчетов(СчетаJira, СчетаШирокие));

	КоличествоОтсевJira = 0;
	КоличествоОтсевШирокий = 0;
	КоличествоОбаОтсева = 0;

	Для Каждого СтрокаКандидата Из ТаблицаКандидатов Цикл

		КлючПары = КлючПарыКлиентУК(СтрокаКандидата.Клиент, СтрокаКандидата.УправляющаяКомпания);
		СведенияОборота = ОборотыПар.Получить(КлючПары);

		ЕстьJira = Ложь;
		ЕстьШирокий = Ложь;
		СчетаОборота = "";

		Если СведенияОборота <> Неопределено Тогда
			СчетаОборота = СведенияОборота.СчетаОборота;
			Для Каждого КодСчета Из СведенияОборота.КодыСчетов Цикл
				СсылкаСчета = СведенияОборота.СчетаПоКоду.Получить(КодСчета);
				Если НаборJira.Получить(СсылкаСчета) <> Неопределено Тогда
					ЕстьJira = Истина;
				КонецЕсли;
				Если НаборШирокие.Получить(СсылкаСчета) <> Неопределено Тогда
					ЕстьШирокий = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		ОтсевJira = Не ЕстьJira;
		ОтсевШирокий = Не ЕстьШирокий;

		Если ОтсевJira Тогда
			КоличествоОтсевJira = КоличествоОтсевJira + 1;
		КонецЕсли;
		Если ОтсевШирокий Тогда
			КоличествоОтсевШирокий = КоличествоОтсевШирокий + 1;
		КонецЕсли;
		Если ОтсевJira И ОтсевШирокий Тогда
			КоличествоОбаОтсева = КоличествоОбаОтсева + 1;
		КонецЕсли;

		Если ОтсевJira = ОтсевШирокий Тогда
			Продолжить;
		КонецЕсли;

		СтрокаОтличия = Результат.Отличия.Добавить();
		СтрокаОтличия.Клиент = СтрокаКандидата.Клиент;
		СтрокаОтличия.УправляющаяКомпания = СтрокаКандидата.УправляющаяКомпания;
		СтрокаОтличия.ОтсевJira = ОтсевJira;
		СтрокаОтличия.ОтсевШирокий = ОтсевШирокий;
		СтрокаОтличия.СчетаОборота = СчетаОборота;
		Если ОтсевJira И Не ОтсевШирокий Тогда
			СтрокаОтличия.ВидОтличия = "Отсекает только постановка (Jira)";
		Иначе
			СтрокаОтличия.ВидОтличия = "Отсекает только широкий список";
		КонецЕсли;

	КонецЦикла;

	Результат.КоличествоОтсевJira = КоличествоОтсевJira;
	Результат.КоличествоОтсевШирокий = КоличествоОтсевШирокий;
	Результат.КоличествоОбаОтсева = КоличествоОбаОтсева;
	Результат.КоличествоОтличий = Результат.Отличия.Количество();

	Результат.Вердикт =
		"Кандидатов Заполнить (вариант 2): " + Формат(Результат.КоличествоКандидатов, "ЧГ=")
		+ ". Отсев Jira: " + Формат(КоличествоОтсевJira, "ЧГ=")
		+ ". Отсев широкий: " + Формат(КоличествоОтсевШирокий, "ЧГ=")
		+ ". Оба отсекают (нет оборотов ни по одному списку): " + Формат(КоличествоОбаОтсева, "ЧГ=")
		+ ". Отличий в таблице: " + Формат(Результат.КоличествоОтличий, "ЧГ=") + ".";

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаСчетовJiraПоУмолчанию()

	Возврат "90.01, 91.01.02, 91.01.03, 91.01.04, 91.01.09, 91.01.99";

КонецФункции

Функция СтрокаСчетовШирокихПоУмолчанию()

	// Умолчание формы НДФЛ: префиксы 90.01 и 91.01 плюс выручка 91.03. Расходы 91.02 не входят.
	Возврат "90.01, 91.01, 91.03";

КонецФункции

Функция ПустойРезультатСравнения()

	Результат = Новый Структура;
	Результат.Вставить("Вердикт", "");
	Результат.Вставить("КоличествоКандидатов", 0);
	Результат.Вставить("КоличествоОтсевJira", 0);
	Результат.Вставить("КоличествоОтсевШирокий", 0);
	Результат.Вставить("КоличествоОбаОтсева", 0);
	Результат.Вставить("КоличествоОтличий", 0);
	Результат.Вставить("Отличия", НоваяТаблицаОтличий());

	Возврат Результат;

КонецФункции

Функция НоваяТаблицаОтличий()

	ТаблицаОтличий = Новый ТаблицаЗначений;
	ТипКонтрагент = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	ТаблицаОтличий.Колонки.Добавить("Клиент", ТипКонтрагент);
	ТаблицаОтличий.Колонки.Добавить("УправляющаяКомпания", ТипКонтрагент);
	ТаблицаОтличий.Колонки.Добавить("ВидОтличия", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(80)));
	ТаблицаОтличий.Колонки.Добавить("ОтсевJira", Новый ОписаниеТипов("Булево"));
	ТаблицаОтличий.Колонки.Добавить("ОтсевШирокий", Новый ОписаниеТипов("Булево"));
	ТаблицаОтличий.Колонки.Добавить("СчетаОборота", Новый ОписаниеТипов("Строка"));

	Возврат ТаблицаОтличий;

КонецФункции

Функция КандидатыЗаполнитьВариант2(ПараметрыСравнения)

	ОбработкаНДФЛ = Обработки.ФормированиеНачисленийНДФЛ.Создать();
	ОбработкаНДФЛ.ВариантЗаполнения = 2;
	ОбработкаНДФЛ.Период = ПараметрыСравнения.Период;
	ОбработкаНДФЛ.НалоговыйПериод = ПараметрыСравнения.НалоговыйПериод;
	ОбработкаНДФЛ.Клиент = ПараметрыСравнения.Клиент;
	ОбработкаНДФЛ.УправляющаяКомпания = ПараметрыСравнения.УправляющаяКомпания;
	ОбработкаНДФЛ.ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ =
		ПараметрыСравнения.ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ;
	ОбработкаНДФЛ.ФормироватьНачисленияПоЗакрытымПортфелям =
		ПараметрыСравнения.ФормироватьНачисленияПоЗакрытымПортфелям;
	ОбработкаНДФЛ.ФормироватьПоЗакрытымПортфелямСПоступлениемНКД =
		ПараметрыСравнения.ФормироватьПоЗакрытымПортфелямСПоступлениемНКД;
	ОбработкаНДФЛ.СхемаВыплаты = ПараметрыСравнения.СхемаВыплаты;
	ОбработкаНДФЛ.ЗаполнитьДокументамиНаДату();

	Возврат ОбработкаНДФЛ.ДатыДокументов.Выгрузить(, "Клиент, УправляющаяКомпания");

КонецФункции

Функция ОборотыПарПоСчетам(ТаблицаКандидатов, Период, СчетаОборотов)

	Результат = Новый Соответствие;
	Если ТаблицаКандидатов.Количество() = 0 Или СчетаОборотов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЧ.Клиент КАК Клиент,
	|	ТЧ.УправляющаяКомпания КАК УправляющаяКомпания
	|ПОМЕСТИТЬ ВТ_Пары
	|ИЗ
	|	&ДатыДокументов КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Портфель.Клиент КАК Клиент,
	|	ХозрасчетныйОбороты.Портфель.УправляющаяКомпания КАК УправляющаяКомпания,
	|	ХозрасчетныйОбороты.Счет КАК Счет,
	|	ХозрасчетныйОбороты.Счет.Код КАК КодСчета
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет В (&СчетаОборотов),
	|			,
	|			Портфель.Клиент В (&Клиенты)
	|				И Портфель.УправляющаяКомпания В (&УправляющиеКомпании),
	|			,
	|			) КАК ХозрасчетныйОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Пары КАК ВТ_Пары
	|		ПО ХозрасчетныйОбороты.Портфель.Клиент = ВТ_Пары.Клиент
	|			И ХозрасчетныйОбороты.Портфель.УправляющаяКомпания = ВТ_Пары.УправляющаяКомпания
	|ГДЕ
	|	Не (ХозрасчетныйОбороты.СуммаОборотДт = 0
	|			И ХозрасчетныйОбороты.СуммаОборотКт = 0)";

	Запрос.УстановитьПараметр("ДатыДокументов", ТаблицаКандидатов);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаОборотов", СчетаОборотов);
	Запрос.УстановитьПараметр("Клиенты", ТаблицаКандидатов.ВыгрузитьКолонку("Клиент"));
	Запрос.УстановитьПараметр("УправляющиеКомпании", ТаблицаКандидатов.ВыгрузитьКолонку("УправляющаяКомпания"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		КлючПары = КлючПарыКлиентУК(Выборка.Клиент, Выборка.УправляющаяКомпания);
		СведенияОборота = Результат.Получить(КлючПары);
		Если СведенияОборота = Неопределено Тогда
			СведенияОборота = Новый Структура;
			СведенияОборота.Вставить("КодыСчетов", Новый Массив);
			СведенияОборота.Вставить("СчетаПоКоду", Новый Соответствие);
			СведенияОборота.Вставить("СчетаОборота", "");
			Результат.Вставить(КлючПары, СведенияОборота);
		КонецЕсли;

		КодСчета = СокрЛП(Выборка.КодСчета);
		Если СведенияОборота.СчетаПоКоду.Получить(КодСчета) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СведенияОборота.СчетаПоКоду.Вставить(КодСчета, Выборка.Счет);
		СведенияОборота.КодыСчетов.Добавить(КодСчета);
		Если ЗначениеЗаполнено(СведенияОборота.СчетаОборота) Тогда
			СведенияОборота.СчетаОборота = СведенияОборота.СчетаОборота + ", " + КодСчета;
		Иначе
			СведенияОборота.СчетаОборота = КодСчета;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоответствиеСчетов(МассивСчетов)

	НаборСчетов = Новый Соответствие;
	Для Каждого Счет Из МассивСчетов Цикл
		НаборСчетов.Вставить(Счет, Истина);
	КонецЦикла;

	Возврат НаборСчетов;

КонецФункции

Функция ОбъединитьМассивыСчетов(ПервыйМассив, ВторойМассив)

	НаборСчетов = Новый Соответствие;
	Результат = Новый Массив;

	Для Каждого Счет Из ПервыйМассив Цикл
		Если НаборСчетов.Получить(Счет) = Неопределено Тогда
			НаборСчетов.Вставить(Счет, Истина);
			Результат.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Счет Из ВторойМассив Цикл
		Если НаборСчетов.Получить(Счет) = Неопределено Тогда
			НаборСчетов.Вставить(Счет, Истина);
			Результат.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КлючПарыКлиентУК(Клиент, УправляющаяКомпания)

	Возврат Строка(Клиент.УникальныйИдентификатор()) + "|" + Строка(УправляющаяКомпания.УникальныйИдентификатор());

КонецФункции

#КонецОбласти
