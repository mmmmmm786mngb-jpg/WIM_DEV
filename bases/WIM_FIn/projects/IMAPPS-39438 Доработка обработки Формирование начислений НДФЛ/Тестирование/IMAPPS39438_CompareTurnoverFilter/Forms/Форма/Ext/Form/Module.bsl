#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПериодЗаполнения.Вариант = ВариантСтандартногоПериода.ЭтотГод;
	НалоговыйПериод = Справочники.Периоды.ПериодПоДатам(
		Перечисления.Периодичность.Год,
		Дата(2026, 1, 1));

	СхемаВыплаты = 0;
	ФормироватьНачисленияПоЗакрытымПортфелям = Истина;
	ФормироватьПоЗакрытымПортфелямСПоступлениемНКД = Истина;
	СчетаJira = "90.01, 91.01.02, 91.01.03, 91.01.04, 91.01.09, 91.01.99";
	СчетаШирокие = "90.01, 91.01, 91.03";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СравнитьОтсев(Команда)

	Если Не ЗначениеЗаполнено(ПериодЗаполнения.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите период заполнения'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(УправляющаяКомпания) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите управляющую компанию'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НалоговыйПериод) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите налоговый период'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Заполнить вариант 2 и сравнение оборотов. Может занять несколько минут.'"));
	СравнитьОтсевНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СравнитьОтсевНаСервере()

	ПараметрыСравнения = Новый Структура;
	ПараметрыСравнения.Вставить("Период", ПериодЗаполнения);
	ПараметрыСравнения.Вставить("НалоговыйПериод", НалоговыйПериод);
	ПараметрыСравнения.Вставить("Клиент", Клиент);
	ПараметрыСравнения.Вставить("УправляющаяКомпания", УправляющаяКомпания);
	ПараметрыСравнения.Вставить("ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ",
		ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ);
	ПараметрыСравнения.Вставить("ФормироватьНачисленияПоЗакрытымПортфелям",
		ФормироватьНачисленияПоЗакрытымПортфелям);
	ПараметрыСравнения.Вставить("ФормироватьПоЗакрытымПортфелямСПоступлениемНКД",
		ФормироватьПоЗакрытымПортфелямСПоступлениемНКД);
	ПараметрыСравнения.Вставить("СхемаВыплаты", СхемаВыплаты);
	ПараметрыСравнения.Вставить("СчетаJira", СчетаJira);
	ПараметрыСравнения.Вставить("СчетаШирокие", СчетаШирокие);

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.СравнитьОтсев(ПараметрыСравнения);

	Вердикт = Результат.Вердикт;
	КоличествоКандидатов = Результат.КоличествоКандидатов;
	КоличествоОтсевJira = Результат.КоличествоОтсевJira;
	КоличествоОтсевШирокий = Результат.КоличествоОтсевШирокий;
	КоличествоОбаОтсева = Результат.КоличествоОбаОтсева;
	КоличествоОтличий = Результат.КоличествоОтличий;

	Отличия.Очистить();
	Для Каждого СтрокаИсточника Из Результат.Отличия Цикл
		ЗаполнитьЗначенияСвойств(Отличия.Добавить(), СтрокаИсточника);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
