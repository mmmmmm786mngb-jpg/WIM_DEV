#Область ПрограммныйИнтерфейс

// Описание: Создает изолированные тестовые данные IMAPPS-39438 и прогоняет
// заполнение обработки ФормированиеНачисленийНДФЛ (вариант 2) с флагом отбора по оборотам.
//
// Параметры:
// ПутьФайлаОтчета - Строка - полный путь JSON-отчета (создается каталог при необходимости)
//
// Возвращаемое значение:
// Структура - Текст протокола, Успех, КоличествоУспешных, КоличествоОшибок
//
Функция ВыполнитьАвтотест(ПутьФайлаОтчета) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Текст", "");
	Результат.Вставить("Json", "");
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КоличествоУспешных", 0);
	Результат.Вставить("КоличествоОшибок", 0);

	Протокол = Новый Массив;
	Тесты = Новый Массив;
	Контекст = Неопределено;

	Попытка
		Контекст = ПодготовитьТестовыеДанные(Протокол);
		ВыполнитьСценарии(Контекст, Тесты, Протокол);
	Исключение
		ТекстИсключения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Протокол.Добавить("КРИТИЧЕСКАЯ ОШИБКА: " + ТекстИсключения);
		ДобавитьТест(Тесты, "prepare_fixtures", Ложь, "подготовка данных", "исключение", ТекстИсключения, "");
	КонецПопытки;

	КоличествоУспешных = 0;
	КоличествоОшибок = 0;
	Для Каждого СтрокаТеста Из Тесты Цикл
		Если СтрокаТеста.Успех Тогда
			КоличествоУспешных = КоличествоУспешных + 1;
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
	КонецЦикла;

	Результат.КоличествоУспешных = КоличествоУспешных;
	Результат.КоличествоОшибок = КоличествоОшибок;
	Результат.Успех = (КоличествоОшибок = 0 И КоличествоУспешных > 0);
	Результат.Текст = СтрСоединить(Протокол, Символы.ПС);
	Результат.Json = СформироватьJsonОтчет(Результат, Тесты, Протокол);

	Попытка
		ЗаписатьJsonОтчет(ПутьФайлаОтчета, Результат.Json);
	Исключение
		Протокол.Добавить("Не удалось записать JSON на сервере: " + ОписаниеОшибки());
		Результат.Текст = СтрСоединить(Протокол, Символы.ПС);
	КонецПопытки;

	Попытка
		ЗаписатьJsonОтчет(КаталогВременныхФайлов() + "imapps39438_fin_test_result.json", Результат.Json);
	Исключение
		Протокол.Добавить("Не удалось записать JSON во временный каталог: " + ОписаниеОшибки());
		Результат.Текст = СтрСоединить(Протокол, Символы.ПС);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрефиксТеста()

	Возврат "IMAPPS39438T";

КонецФункции

Функция ПодготовитьТестовыеДанные(Протокол)

	Контекст = Новый Структура;
	Контекст.Вставить("Префикс", ПрефиксТеста());

	ОчиститьТестовыеДанные(Протокол);

	Контекст.Вставить("Счет9001", СчетПоКоду("90.01"));
	Контекст.Вставить("Счет910102", СчетПоКоду("91.01.02"));
	Контекст.Вставить("Счет9102", СчетПоКоду("91.02"));
	Контекст.Вставить("Счет9103", СчетПоКоду("91.03"));
	Контекст.Вставить("СчетКор", СчетКорреспонденции());

	Если Не ЗначениеЗаполнено(Контекст.Счет9001)
		Или Не ЗначениеЗаполнено(Контекст.СчетКор) Тогда
		ВызватьИсключение "Не найдены счета 90.01 и корреспонденция для проводок.";
	КонецЕсли;

	Контекст.Вставить("НалоговыйПериод", Справочники.Периоды.ПериодПоДатам(
		Перечисления.Периодичность.Год,
		Дата(2026, 1, 1)));

	Если Не ЗначениеЗаполнено(Контекст.НалоговыйПериод) Тогда
		ВызватьИсключение "Не удалось получить налоговый период 2026.";
	КонецЕсли;

	Контекст.Вставить("УК1", СоздатьКонтрагента(Контекст.Префикс + "_UK1", Истина, Ложь));
	Контекст.Вставить("УК2", СоздатьКонтрагента(Контекст.Префикс + "_UK2", Истина, Ложь));
	Контекст.Вставить("КлиентA", СоздатьКонтрагента(Контекст.Префикс + "_A", Ложь, Истина));
	Контекст.Вставить("КлиентB", СоздатьКонтрагента(Контекст.Префикс + "_B", Ложь, Истина));
	Контекст.Вставить("КлиентC", СоздатьКонтрагента(Контекст.Префикс + "_C", Ложь, Истина));
	Контекст.Вставить("КлиентD", СоздатьКонтрагента(Контекст.Префикс + "_D", Ложь, Истина));
	Контекст.Вставить("КлиентE", СоздатьКонтрагента(Контекст.Префикс + "_E", Ложь, Истина));
	Контекст.Вставить("КлиентF", СоздатьКонтрагента(Контекст.Префикс + "_F", Ложь, Истина));

	Контекст.Вставить("ПортфельA", СоздатьПортфель(Контекст.Префикс + "A", Контекст.КлиентA, Контекст.УК1, "I39438A"));
	Контекст.Вставить("ПортфельB", СоздатьПортфель(Контекст.Префикс + "B", Контекст.КлиентB, Контекст.УК1, "I39438B"));
	Контекст.Вставить("ПортфельC", СоздатьПортфель(Контекст.Префикс + "C", Контекст.КлиентC, Контекст.УК1, "I39438C"));
	Контекст.Вставить("ПортфельD", СоздатьПортфель(Контекст.Префикс + "D", Контекст.КлиентD, Контекст.УК1, "I39438D"));
	Контекст.Вставить("ПортфельE1", СоздатьПортфель(Контекст.Префикс + "E1", Контекст.КлиентE, Контекст.УК1, "I39438E"));
	Контекст.Вставить("ПортфельE2", СоздатьПортфель(Контекст.Префикс + "E2", Контекст.КлиентE, Контекст.УК2, "I39438F"));
	Контекст.Вставить("ПортфельF", СоздатьПортфель(Контекст.Префикс + "F", Контекст.КлиентF, Контекст.УК1, "I39438G"));

	СоздатьПроводку(Контекст.ПортфельA, Дата(2026, 1, 15), Контекст.СчетКор, Контекст.Счет9001, 10000);
	Если ЗначениеЗаполнено(Контекст.Счет9102) Тогда
		СоздатьПроводку(Контекст.ПортфельB, Дата(2026, 3, 10), Контекст.Счет9102, Контекст.СчетКор, 3000);
	КонецЕсли;
	Если ЗначениеЗаполнено(Контекст.Счет910102) Тогда
		СоздатьПроводку(Контекст.ПортфельC, Дата(2026, 9, 2), Контекст.СчетКор, Контекст.Счет910102, 5000);
	КонецЕсли;
	СоздатьПроводку(Контекст.ПортфельE1, Дата(2026, 2, 20), Контекст.СчетКор, Контекст.Счет9001, 7000);
	Если ЗначениеЗаполнено(Контекст.Счет9102) Тогда
		СоздатьПроводку(Контекст.ПортфельE2, Дата(2026, 2, 20), Контекст.Счет9102, Контекст.СчетКор, 4000);
	КонецЕсли;
	Если ЗначениеЗаполнено(Контекст.Счет9103) Тогда
		СоздатьПроводку(Контекст.ПортфельF, Дата(2026, 4, 5), Контекст.СчетКор, Контекст.Счет9103, 2000);
	КонецЕсли;

	Протокол.Добавить("Подготовлены контрагенты, портфели и проводки ОперацияБух с префиксом "
		+ Контекст.Префикс);
	Протокол.Добавить("Счета: 90.01=" + Строка(Контекст.Счет9001)
		+ "; 91.01.02=" + Строка(Контекст.Счет910102)
		+ "; 91.02=" + Строка(Контекст.Счет9102)
		+ "; 91.03=" + Строка(Контекст.Счет9103)
		+ "; кор=" + Строка(Контекст.СчетКор));

	Возврат Контекст;

КонецФункции

Процедура ВыполнитьСценарии(Контекст, Тесты, Протокол)

	ТекстЗапросаОтбора =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ХозрасчетныйОбороты.Портфель.Клиент КАК Клиент,
	|	ХозрасчетныйОбороты.Портфель.УправляющаяКомпания КАК УправляющаяКомпания
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, , Счет В (&СчетаОборотов), , , , ) КАК ХозрасчетныйОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Пары КАК ВТ_Пары
	|		ПО ХозрасчетныйОбороты.Портфель.Клиент = ВТ_Пары.Клиент
	|			И ХозрасчетныйОбороты.Портфель.УправляющаяКомпания = ВТ_Пары.УправляющаяКомпания
	|ГДЕ
	|	Не (ХозрасчетныйОбороты.СуммаОборотДт = 0
	|			И ХозрасчетныйОбороты.СуммаОборотКт = 0)";

	РеквизитФлага = Метаданные.Обработки.ФормированиеНачисленийНДФЛ.Реквизиты.Найти(
		"НеСоздаватьНДФЛПоКлиентамБезОборотов");
	ДобавитьТест(
		Тесты,
		"cfe_attribute",
		РеквизитФлага <> Неопределено,
		"реквизит НеСоздаватьНДФЛПоКлиентамБезОборотов есть",
		?(РеквизитФлага = Неопределено, "нет", "есть"),
		"Проверка, что расширение применено к обработке",
		"");

	Если РеквизитФлага = Неопределено Тогда
		Протокол.Добавить("Реквизит флага отсутствует: расширение не применено, сценарии отбора пропущены.");
		Возврат;
	КонецЕсли;

	ДобавитьТестЗаполнения(
		Тесты,
		Протокол,
		"A_flag_on_keep",
		Контекст,
		Контекст.КлиентA,
		Контекст.УК1,
		Дата(2026, 9, 1),
		Истина,
		"90.01, 91.01, 91.03",
		1,
		"Клиент A: выручка 90.01 15.01.2026, флаг включен, дата 01.09 — пара остается",
		ТекстЗапросаОтбора);

	ДобавитьТестЗаполнения(
		Тесты,
		Протокол,
		"A_flag_off",
		Контекст,
		Контекст.КлиентA,
		Контекст.УК1,
		Дата(2026, 9, 1),
		Ложь,
		"90.01, 91.01, 91.03",
		1,
		"Клиент A: флаг выключен — регрессия, пара остается",
		"");

	Если ЗначениеЗаполнено(Контекст.Счет9102) Тогда
		ДобавитьТестЗаполнения(
			Тесты,
			Протокол,
			"B_flag_on_drop_9102",
			Контекст,
			Контекст.КлиентB,
			Контекст.УК1,
			Дата(2026, 9, 1),
			Истина,
			"90.01, 91.01, 91.03",
			0,
			"Клиент B: только расход 91.02 — пара отсекается",
			ТекстЗапросаОтбора);

		ДобавитьТестЗаполнения(
			Тесты,
			Протокол,
			"B_flag_off_keep",
			Контекст,
			Контекст.КлиентB,
			Контекст.УК1,
			Дата(2026, 9, 1),
			Ложь,
			"90.01, 91.01, 91.03",
			1,
			"Клиент B: флаг выключен — пара остается несмотря на отсутствие доходов",
			"");
	Иначе
		ДобавитьТест(Тесты, "B_skip_no_9102", Истина, "пропуск", "пропуск",
			"Счет 91.02 не найден, сценарий расхода пропущен", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(Контекст.Счет910102) Тогда
		ДобавитьТестЗаполнения(
			Тесты,
			Протокол,
			"C_before_coupon",
			Контекст,
			Контекст.КлиентC,
			Контекст.УК1,
			Дата(2026, 9, 1),
			Истина,
			"90.01, 91.01, 91.03",
			0,
			"Клиент C: купон 91.01.02 только 02.09, заполнение на 01.09 — пара отсекается",
			ТекстЗапросаОтбора);

		ДобавитьТестЗаполнения(
			Тесты,
			Протокол,
			"C_on_coupon_date",
			Контекст,
			Контекст.КлиентC,
			Контекст.УК1,
			Дата(2026, 9, 2),
			Истина,
			"90.01, 91.01, 91.03",
			1,
			"Клиент C: заполнение на 02.09 — пара остается",
			ТекстЗапросаОтбора);
	КонецЕсли;

	ДобавитьТестЗаполнения(
		Тесты,
		Протокол,
		"D_flag_on_empty",
		Контекст,
		Контекст.КлиентD,
		Контекст.УК1,
		Дата(2026, 9, 1),
		Истина,
		"90.01, 91.01, 91.03",
		0,
		"Клиент D: нет проводок, флаг включен — пара отсекается",
		ТекстЗапросаОтбора);

	ДобавитьТестЗаполнения(
		Тесты,
		Протокол,
		"D_flag_off_empty",
		Контекст,
		Контекст.КлиентD,
		Контекст.УК1,
		Дата(2026, 9, 1),
		Ложь,
		"90.01, 91.01, 91.03",
		1,
		"Клиент D: нет проводок, флаг выключен — пара остается",
		"");

	ДобавитьТестЗаполнения(
		Тесты,
		Протокол,
		"E_uk1_keep",
		Контекст,
		Контекст.КлиентE,
		Контекст.УК1,
		Дата(2026, 9, 1),
		Истина,
		"90.01, 91.01, 91.03",
		1,
		"Клиент E / УК1: есть 90.01 — пара остается",
		ТекстЗапросаОтбора);

	ДобавитьТестЗаполнения(
		Тесты,
		Протокол,
		"E_uk2_drop",
		Контекст,
		Контекст.КлиентE,
		Контекст.УК2,
		Дата(2026, 9, 1),
		Истина,
		"90.01, 91.01, 91.03",
		0,
		"Клиент E / УК2: только 91.02 или нет доходов — пара отсекается, зерно клиент+УК",
		ТекстЗапросаОтбора);

	Если ЗначениеЗаполнено(Контекст.Счет9103) Тогда
		ДобавитьТестЗаполнения(
			Тесты,
			Протокол,
			"F_9103_keep",
			Контекст,
			Контекст.КлиентF,
			Контекст.УК1,
			Дата(2026, 9, 1),
			Истина,
			"90.01, 91.01, 91.03",
			1,
			"Клиент F: только 91.03 — пара остается (префикс/код из умолчания)",
			ТекстЗапросаОтбора);
	КонецЕсли;

	ДобавитьТестЗаполнения(
		Тесты,
		Протокол,
		"D_bad_accounts_keep",
		Контекст,
		Контекст.КлиентD,
		Контекст.УК1,
		Дата(2026, 9, 1),
		Истина,
		"НЕТТАКОГОСЧЕТА",
		1,
		"Неразобранный список счетов: фильтр не применяется, пара без оборотов остается",
		"");

КонецПроцедуры

Процедура ДобавитьТестЗаполнения(Тесты, Протокол, Имя, Контекст, Клиент, УК, ДатаОкончания,
	ФлагОтбора, СтрокаСчетов, ОжидалосьСтрок, Комментарий, ТекстЗапроса)

	Попытка
		ПолученоСтрок = ЗаполнитьИПосчитать(Контекст, Клиент, УК, ДатаОкончания, ФлагОтбора, СтрокаСчетов);
		Успех = (ПолученоСтрок = ОжидалосьСтрок);
		Протокол.Добавить(
			?(Успех, "OK ", "FAIL ")
			+ Имя
			+ ": ожидали "
			+ Формат(ОжидалосьСтрок, "ЧН=0; ЧГ=")
			+ ", получили "
			+ Формат(ПолученоСтрок, "ЧН=0; ЧГ=")
			+ ". "
			+ Комментарий);
		ДобавитьТест(
			Тесты,
			Имя,
			Успех,
			Формат(ОжидалосьСтрок, "ЧН=0; ЧГ="),
			Формат(ПолученоСтрок, "ЧН=0; ЧГ="),
			Комментарий,
			ТекстЗапроса);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Протокол.Добавить("FAIL " + Имя + ": " + ТекстОшибки);
		ДобавитьТест(Тесты, Имя, Ложь, Формат(ОжидалосьСтрок, "ЧН=0; ЧГ="), "исключение", ТекстОшибки, ТекстЗапроса);
	КонецПопытки;

КонецПроцедуры

Функция ЗаполнитьИПосчитать(Контекст, Клиент, УК, ДатаОкончания, ФлагОтбора, СтрокаСчетов)

	ОбработкаНДФЛ = Обработки.ФормированиеНачисленийНДФЛ.Создать();
	ОбработкаНДФЛ.ВариантЗаполнения = 2;
	ОбработкаНДФЛ.Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	ОбработкаНДФЛ.Период.ДатаНачала = Дата(2026, 1, 1);
	ОбработкаНДФЛ.Период.ДатаОкончания = ДатаОкончания;
	ОбработкаНДФЛ.НалоговыйПериод = Контекст.НалоговыйПериод;
	ОбработкаНДФЛ.Клиент = Клиент;
	ОбработкаНДФЛ.УправляющаяКомпания = УК;
	ОбработкаНДФЛ.ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ = Ложь;
	ОбработкаНДФЛ.ФормироватьНачисленияПоЗакрытымПортфелям = Истина;
	ОбработкаНДФЛ.НеСоздаватьДокументыПоКлиентамБезЦБ = Ложь;
	ОбработкаНДФЛ.НеСоздаватьНДФЛПоКлиентамБезОборотов = ФлагОтбора;
	ОбработкаНДФЛ.СчетаОборотовДляОтбораНДФЛ = СтрокаСчетов;
	ОбработкаНДФЛ.ЗаполнитьДокументамиНаДату();

	Возврат ОбработкаНДФЛ.ДатыДокументов.Количество();

КонецФункции

