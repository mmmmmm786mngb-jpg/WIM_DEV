Функция СчетКорреспонденции()

	Коды = СтрРазделить("76.05,76.09,76,62.01,62,51,58", ",", Ложь);
	Для Каждого КодСчета Из Коды Цикл
		Счет = СчетПоКоду(СокрЛП(КодСчета));
		Если ЗначениеЗаполнено(Счет) Тогда
			Возврат Счет;
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Хозрасчетный.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Не Хозрасчетный.ЗапретитьИспользоватьВПроводках
	|	И Не (Хозрасчетный.Код ПОДОБНО ""90%""
	|			Или Хозрасчетный.Код ПОДОБНО ""91%"")";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат ПланыСчетов.Хозрасчетный.ПустаяСсылка();

КонецФункции

Функция СформироватьJsonОтчет(Результат, Тесты, Протокол)

	ДанныеОтчета = Новый Структура;
	ДанныеОтчета.Вставить("База", "WIM_FIN");
	ДанныеОтчета.Вставить("Расширение", "IMAPPS39438_EmptyTurnover");
	ДанныеОтчета.Вставить("Дата", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	ДанныеОтчета.Вставить("Успех", Результат.Успех);
	ДанныеОтчета.Вставить("КоличествоУспешных", Результат.КоличествоУспешных);
	ДанныеОтчета.Вставить("КоличествоОшибок", Результат.КоличествоОшибок);
	ДанныеОтчета.Вставить("Протокол", СтрСоединить(Протокол, Символы.ПС));
	ДанныеОтчета.Вставить("Тесты", Тесты);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ДанныеОтчета);

	Возврат Запись.Закрыть();

КонецФункции

Процедура ЗаписатьJsonОтчет(ПутьФайлаОтчета, ТекстJson)

	Если Не ЗначениеЗаполнено(ПутьФайлаОтчета) Или Не ЗначениеЗаполнено(ТекстJson) Тогда
		Возврат;
	КонецЕсли;

	Каталог = Лев(ПутьФайлаОтчета, СтрНайти(ПутьФайлаОтчета, "\", НаправлениеПоиска.СКонца) - 1);
	Если ЗначениеЗаполнено(Каталог) Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

	ТекстДокумента = Новый ТекстовыйДокумент;
	ТекстДокумента.УстановитьТекст(ТекстJson);
	ТекстДокумента.Записать(ПутьФайлаОтчета, КодировкаТекста.UTF8);

КонецПроцедуры

