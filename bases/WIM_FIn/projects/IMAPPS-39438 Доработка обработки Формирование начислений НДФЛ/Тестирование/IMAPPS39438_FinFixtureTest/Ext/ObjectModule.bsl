	Тесты.Добавить(СтрокаТеста);

КонецПроцедуры

Процедура ОчиститьТестовыеДанные(Протокол)

	Префикс = ПрефиксТеста();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацияБух.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОперацияБух КАК ОперацияБух
	|ГДЕ
	|	ОперацияБух.Содержание ПОДОБНО &Префикс
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ОперацияБух.Ссылка
	|ИЗ
	|	Документ.ОперацияБух КАК ОперацияБух
	|ГДЕ
	|	ОперацияБух.Портфель.Наименование ПОДОБНО &Префикс";
	Запрос.УстановитьПараметр("Префикс", Префикс + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектДокумента = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектДокумента.Удалить();
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Портфели.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Портфели КАК Портфели
	|ГДЕ
	|	Портфели.Наименование ПОДОБНО &Префикс";
	Запрос.УстановитьПараметр("Префикс", Префикс + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектПортфеля = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектПортфеля.Удалить();
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование ПОДОБНО &Префикс";
	Запрос.УстановитьПараметр("Префикс", Префикс + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектКонтрагента = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектКонтрагента.Удалить();
	КонецЦикла;

	Протокол.Добавить("Очищены прежние данные с префиксом " + Префикс);

КонецПроцедуры

Функция СоздатьКонтрагента(Наименование, ЭтоУК, ЭтоКлиент)

	КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КонтрагентОбъект.Наименование = Наименование;
	Если ЭтоКлиент Тогда
		КонтрагентОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
		КонтрагентОбъект.КлиентДУ = Истина;
	Иначе
		КонтрагентОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
	КонецЕсли;
	Если ЭтоУК Тогда
		КонтрагентОбъект.УправляющаяКомпания = Истина;
	КонецЕсли;
	КонтрагентОбъект.Записать();

	Возврат КонтрагентОбъект.Ссылка;

КонецФункции

Функция СоздатьПортфель(Наименование, Клиент, УК, ПрефиксКода)

	ПортфельОбъект = Справочники.Портфели.СоздатьЭлемент();
	ПортфельОбъект.Наименование = Наименование;
	ПортфельОбъект.Клиент = Клиент;
	ПортфельОбъект.УправляющаяКомпания = УК;
	ПортфельОбъект.ДатаНачала = Дата(2025, 1, 1);
	ПортфельОбъект.Префикс = ПрефиксКода;
	ПортфельОбъект.ТипКлиентаДУ = Перечисления.ТипыКлиентовДУ.ФизическиеЛица;
	ПортфельОбъект.Записать();

	Возврат ПортфельОбъект.Ссылка;

КонецФункции

Процедура СоздатьПроводку(Портфель, ДатаПроводки, СчетДт, СчетКт, Сумма)

	ДокументОбъект = Документы.ОперацияБух.СоздатьДокумент();
	ДокументОбъект.Дата = ДатаПроводки;
	ДокументОбъект.Портфель = Портфель;
	ДокументОбъект.Содержание = ПрефиксТеста() + " " + Строка(Портфель);
	Проводка = ДокументОбъект.Движения.Хозрасчетный.Добавить();
	Проводка.СчетДт = СчетДт;
	Проводка.СчетКт = СчетКт;
	Проводка.Сумма = Сумма;
	ДокументОбъект.Движения.Хозрасчетный.Записывать = Истина;
	ДокументОбъект.Записать();

КонецПроцедуры

