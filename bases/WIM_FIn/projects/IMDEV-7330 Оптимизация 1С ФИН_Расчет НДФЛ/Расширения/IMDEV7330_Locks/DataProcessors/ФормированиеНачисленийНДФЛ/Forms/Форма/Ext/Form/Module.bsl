&НаСервере
&ИзменениеИКонтроль("УправлениеФормой")
Процедура IMDEV7330_Locks_УправлениеФормой()
	
	#Вставка
	IMDEV7330_Locks_ДобавитьВариантПоОтсутствующимНачислениям();
	#КонецВставки
	Элементы.Период.Видимость = Объект.ВариантЗаполнения <> 3;
	#Удаление
	Элементы.ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ.Видимость = Объект.ВариантЗаполнения = 2;
	Элементы.СоздаватьОплатуНДФЛ.Видимость = Объект.ВариантЗаполнения = 2;
	Элементы.СхемаВыплаты.Видимость = Объект.ВариантЗаполнения = 2;
	#КонецУдаления
	#Вставка
	Элементы.ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ.Видимость =
		Объект.ВариантЗаполнения = 2 Или Объект.ВариантЗаполнения = 4;
	Элементы.СоздаватьОплатуНДФЛ.Видимость = Объект.ВариантЗаполнения = 2;
	Элементы.СхемаВыплаты.Видимость =
		Объект.ВариантЗаполнения = 2 Или Объект.ВариантЗаполнения = 4;
	#КонецВставки
	Элементы.СчетДляОплатыНалогов.Видимость = Объект.СоздаватьОплатуНДФЛ;
	
КонецПроцедуры

// Описание: Добавляет пункт «По отсутствующим Начислениям НДФЛ» и группирует тумблер горизонтально.
//
Процедура IMDEV7330_Locks_ДобавитьВариантПоОтсутствующимНачислениям()
	
	Если Элементы.ВариантЗаполнения.СписокВыбора.НайтиПоЗначению(4) = Неопределено Тогда
		Элементы.ВариантЗаполнения.СписокВыбора.Добавить(4, НСтр("ru = 'По отсутствующим Начислениям НДФЛ'"));
	КонецЕсли;
	
	Элементы.ГруппаВариантЗаполнения.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Элементы.ГруппаВариантЗаполнения.РастягиватьПоГоризонтали = Истина;
	
КонецПроцедуры
