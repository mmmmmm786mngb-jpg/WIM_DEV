#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&ИзменениеИКонтроль("ОркестраторФормированияНДФЛ")
Процедура IMDEV7330_Locks_ОркестраторФормированияНДФЛ(Параметры, АдресРезультата) Экспорт
	
	СтрокаВхода = "";
	Если Параметры <> Неопределено И Параметры.Свойство("ПараметрыXML", СтрокаВхода) И ЗначениеЗаполнено(СтрокаВхода) Тогда
		Попытка
			Параметры = ДанныеИзXML(СтрокаВхода);
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru = 'IMDEV-7330. Формирование НДФЛ (оркестратор): ошибка разбора XML параметров ДО'"),
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			ВызватьИсключение НСтр("ru = 'NDFL_RDU: ошибка разбора XML параметров длительной операции.'")
				+ Символы.ПС + ТекстОшибки;
		КонецПопытки;
	КонецЕсли;
	
	ИдентификаторФормы = Неопределено;
	Если Не Параметры.Свойство("ИдентификаторФормы", ИдентификаторФормы) Или Не ЗначениеЗаполнено(ИдентификаторФормы) Тогда
		ВызватьИсключение НСтр("ru = 'NDFL_RDU: не передан ИдентификаторФормы в параметрах длительной операции.'");
	КонецЕсли;
	
	Снимок = Неопределено;
	Если Не Параметры.Свойство("Снимок", Снимок) Или Снимок = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'NDFL_RDU: не передан снимок обработки в параметрах длительной операции.'");
	КонецЕсли;
	
	// IMDEV-7330-5 Сначала итог во ВХ, потом исключение — чтобы обработчик ДО не затирал адрес ошибкой.
	ВызватьИсключениеПослеПолногоПровалаПачек = Ложь;
	ТекстИсключенияПолногоПровалаПачек = "";
	
	Попытка
		
		ИндексыСтрок = СобратьИндексыСтрокПоСнимку(Снимок);
		Если ИндексыСтрок.Количество() = 0 Тогда
			ТабПустой = Новый ТабличныйДокумент;
			ТекстНетСтрок = НСтр(
				"ru = 'Нет строк табличной части для формирования НДФЛ по текущим условиям (отбор по номерам строк, исключение клиентов без ЦБ и т.п.). Документы не создавались.'");
			ЗаписатьРезультатОркестратораВоВременноеХранилище(АдресРезультата, Истина, ТекстНетСтрок, ТабПустой,
				Снимок, Ложь, Новый Массив);
			Возврат;
		КонецЕсли;
		
		KИсх = Константы.ЧислоПараллельныхПачекФормированияНДФЛ.Получить();
		K = Макс(1, Цел(KИсх));
		K = Мин(K, 50);
		
		ПачкиИндексов = РазбитьСтрокиНаПачки(ИндексыСтрок, K, Снимок);
		
		Если ПачкиИндексов.Количество() <= 1 Тогда
			
			ОбъектОбработки = Обработки.ФормированиеНачисленийНДФЛ.Создать();
			ЗаполнитьОбъектОбработкиИзСнимка(ОбъектОбработки, Снимок);
			ТабличныйДокумент = Новый ТабличныйДокумент;
			ОбъектОбработки.СоздатьДокументы(ТабличныйДокумент);
			СнимокПосле = СнимокОбъектаОбработки(ОбъектОбработки);
			ЗаписатьРезультатОркестратораВоВременноеХранилище(АдресРезультата, Истина, "", ТабличныйДокумент,
				СнимокПосле, Ложь, Новый Массив);
			Возврат;
			
		КонецЕсли;
		
		ПрогрессНачальный = Новый Структура;
		ПрогрессНачальный.Вставить("ВсегоПачек", ПачкиИндексов.Количество());
		ПрогрессНачальный.Вставить("ВсегоСтрок", ИндексыСтрок.Количество());
		ПрогрессНачальный.Вставить("ЗавершеноПачек", 0);
		ПрогрессНачальный.Вставить("ОбработаноСтрок", 0);
		ПрогрессНачальный.Вставить("ТекстЭтапа", "");
		ПрогрессНачальный.Вставить("ВремяСтартаМС", ТекущаяУниверсальнаяДатаВМиллисекундах());
		ПрогрессНачальный.Вставить("ВремяСтартаТекст", Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss"));
		АдресПрогресса = ПоместитьВоВременноеХранилище(ПрогрессНачальный, ИдентификаторФормы);
		
		МассивИдентификаторовЗаданийПачек = Новый Массив;
		МассивПараметровПачек = Новый Массив;
		ВсегоПачек = ПачкиИндексов.Количество();
		НомерПачки = 0;
		Для Каждого ПачкаИндексов Из ПачкиИндексов Цикл
			НомерПачки = НомерПачки + 1;
			ПараметрыПачки = ПодготовитьПараметрыПачки(Снимок, НомерПачки, ВсегоПачек, ПачкаИндексов,
				ИдентификаторФормы, АдресПрогресса);
			МассивПараметровПачек.Добавить(ПараметрыПачки);
			
			ИдентификаторЗаданияПачки = ЗапуститьПачкуФормированияНДФЛЧерезБСП(ПараметрыПачки, НомерПачки, ВсегоПачек);
			МассивИдентификаторовЗаданийПачек.Добавить(ИдентификаторЗаданияПачки);
			#Вставка
			ПорогПаузыМеждуПачками = 1000;
			ПаузаМеждуЗапускамиПачекМс = 30000;
			Если НомерПачки < ВсегоПачек
				И ПачкаИндексов.Количество() > ПорогПаузыМеждуПачками Тогда
				АванкорСервер.Пауза(ПаузаМеждуЗапускамиПачекМс);
			КонецЕсли;
			#КонецВставки
		КонецЦикла;
		
		Если ОркестраторВыполнитьОжиданиеПачек(Снимок, АдресРезультата, АдресПрогресса, МассивИдентификаторовЗаданийПачек,
			ПачкиИндексов, ИдентификаторФормы) Тогда
			Возврат;
		КонецЕсли;
		
		СборПачек = ОркестраторСобратьРезультатыПачек(МассивПараметровПачек);
		РезультатыПачек = СборПачек.РезультатыПачек;
		УпавшиеПачки = СборПачек.УпавшиеПачки;
		
		ИтогСшивки = СшитьРезультатыПачекФормированияНДФЛ(РезультатыПачек);
		КоличествоУпавшихПачек = УпавшиеПачки.Количество();
		ПолныйПровалПачек = (КоличествоУпавшихПачек = ВсегоПачек) И (ВсегоПачек > 0);
		ЧастичныйУспехПачек = (КоличествоУпавшихПачек > 0) И (КоличествоУпавшихПачек < ВсегоПачек);
		
		ТекстОшибокПачек = ТекстОшибокПоУпавшимПачкам(МассивПараметровПачек, МассивИдентификаторовЗаданийПачек,
			УпавшиеПачки);
		
		Если Не ПустаяСтрока(ТекстОшибокПачек) Тогда
			ТабПреамбулаОшибок = ТабличныйДокументИзМногострочногоТекста(
				НСтр("ru = 'Сводка ошибок упавших пачек (в начале лога):'") + Символы.ПС + Символы.ПС + ТекстОшибокПачек);
			ТабОбъединенный = Новый ТабличныйДокумент;
			ТабОбъединенный.Вывести(ТабПреамбулаОшибок);
			ТабОбъединенный.Вывести(ИтогСшивки.ТабличныйДокумент);
			ИтогСшивки.ТабличныйДокумент = ТабОбъединенный;
		КонецЕсли;
		
		ТекстДиагностики = "";
		Если ПолныйПровалПачек Тогда
			ТекстДиагностики = НСтр("ru = 'Все пачки формирования НДФЛ завершились с ошибкой. См. объединенный лог.'");
		ИначеЕсли ЧастичныйУспехПачек Тогда
			ТекстДиагностики = НСтр("ru = 'Часть пачек завершилась с ошибкой. См. лог и список номеров пачек.'");
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстОшибокПачек) Тогда
			Если ПустаяСтрока(ТекстДиагностики) Тогда
				ТекстДиагностики = ТекстОшибокПачек;
			Иначе
				ТекстДиагностики = СокрЛП(ТекстДиагностики + Символы.ПС + Символы.ПС + ТекстОшибокПачек);
			КонецЕсли;
		КонецЕсли;
		
		Если КоличествоУпавшихПачек > 0 Тогда
			НомераСтроками = Новый Массив;
			Для Каждого НомерУпавшей Из УпавшиеПачки Цикл
				НомераСтроками.Добавить(Строка(НомерУпавшей));
			КонецЦикла;
			ТекстНомеров = СтрСоединить(НомераСтроками, ", ");
			Если ЗначениеЗаполнено(ТекстНомеров) Тогда
				СтрокаНомеров = СтрШаблон(НСтр("ru = 'Номера пачек с ошибкой (порядок запуска): %1.'"), ТекстНомеров);
				ТекстДиагностики = СокрЛП(ТекстДиагностики + Символы.ПС + СтрокаНомеров);
			КонецЕсли;
		КонецЕсли;
		
		УспехИтог = (КоличествоУпавшихПачек = 0);
		// IMDEV-7330-5 После нескольких пачек один снимок в форму не отдаём (избежать смешения частичных данных).
		ЗаписатьРезультатОркестратораВоВременноеХранилище(АдресРезультата, УспехИтог, ТекстДиагностики,
			ИтогСшивки.ТабличныйДокумент, Неопределено, ЧастичныйУспехПачек, УпавшиеПачки);
		
		Если ПолныйПровалПачек Тогда
			ВызватьИсключениеПослеПолногоПровалаПачек = Истина;
			ТекстИсключенияПолногоПровалаПачек = НСтр("ru = 'NDFL_RDU: все пачки формирования НДФЛ завершились с ошибкой.'");
			Если Не ПустаяСтрока(ТекстОшибокПачек) Тогда
				ТекстИсключенияПолногоПровалаПачек = СокрЛП(ТекстИсключенияПолногоПровалаПачек + Символы.ПС + Символы.ПС
					+ ТекстОшибокПачек);
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'IMDEV-7330. Формирование НДФЛ (оркестратор)'"),
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ТабОшибка = Новый ТабличныйДокумент;
		ЗаписатьРезультатОркестратораВоВременноеХранилище(АдресРезультата, Ложь, ТекстОшибки, ТабОшибка,
			Неопределено, Ложь, Новый Массив);
		
	КонецПопытки;
	
	Если ВызватьИсключениеПослеПолногоПровалаПачек Тогда
		ВызватьИсключение ТекстИсключенияПолногоПровалаПачек;
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли
