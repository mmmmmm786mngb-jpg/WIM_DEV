#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// IMDEV-7330: повтор запроса ОбщиеОбороты при блокировке и индексы ВТ санкций.

&ИзменениеИКонтроль("ОбщиеОбороты")
Функция IMDEV7330_Locks_ОбщиеОбороты(ПараметрыРасчета, ПрошлыйПериод = Ложь)
			
	// IMDEV-7330-3 Состав полей, собираемых в ПараметрыРасчета внутри этой функции для тяжёлого запроса ОбщиеОбороты:
	// несколько портфелей и табличные параметры.
	// 1) Портфели - Массив СправочникСсылка.Портфели; если ключа нет в структуре - массив из одного модуля Портфель.
	//    В запрос в параметр Портфель передаётся этот массив (в тексте - В(&Портфель)).
	// 2) РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета - ТаблицаЗначений (Портфель, РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета),
	//    заполняется в НастройкиРасчетаНУПоПортфелям из регистра ЗначенияПараметровПортфеля на Дата.
	// 3) СписокДокументовДляРасчетаДоходовРасходов - ТаблицаЗначений (Портфель, ДокументДляРасчетаДоходовРасходов):
	//    в ключ записывается поле СписокДокументов из Структуры результата перехвата СписокДокументовДляРасчетаДоходовРасходов.
	// 4) ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями - ТаблицаЗначений продаж для льгот по санкционным клиентам,
	//    формируется в ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями по массиву портфелей.

	// IMDEV-7330-3 Если задан внешний кэш оборотов по текущему портфелю, возвращаем готовую таблицу
	// до выполнения тяжёлого запроса к регистру Хозрасчетный.
	// Внешний кэш ставится в перехвате РассчитатьНДФЛ и снимается там же.
	Если ВнешнийКэшОборотов <> Неопределено Тогда
		КлючКэша = ?(ПрошлыйПериод, "ОбщиеОборотыПрошлыйГод", "ОбщиеОборотыТек");
		ТаблицаИзКэша = Неопределено;
		ВнешнийКэшОборотов.Свойство(КлючКэша, ТаблицаИзКэша);
		Если ТаблицаИзКэша <> Неопределено Тогда
			Возврат ТаблицаИзКэша;
		КонецЕсли;
	КонецЕсли;
			
	Запрос = Новый Запрос;
	Запрос.Текст = ОбщиеОборотыТекстЗапроса();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;	    
	
	// IMDEV-7330-3 Портфели: поддерживается массив; при старом вызове без ключа Портфели используется один реквизит Портфель модуля.
	Если ПараметрыРасчета.Свойство("Портфели") Тогда
		Портфели = ПараметрыРасчета.Портфели;
	Иначе
		Портфели = Новый Массив;
		Портфели.Добавить(Портфель);
		ПараметрыРасчета.Вставить("Портфели", Портфели);
	КонецЕсли;
	
	// IMDEV-7330 Нормализуем мультипортфельные параметры ДО установки периодов запроса.
	// Это важно, чтобы МинимальнаяДатаДокументов и связанные таблицы были рассчитаны на тот же набор портфелей.
	ДопПараметрыРасчета = Новый Структура;
	
	ДопПараметрыРасчета.Вставить("РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета",
		НастройкиРасчетаНУПоПортфелям(Портфели));
		
	ПреобразоватьВТаблицу = Истина;
	ДанныеСпискаДокументов = СписокДокументовДляРасчетаДоходовРасходов(ПараметрыРасчета, ПреобразоватьВТаблицу);
	ДопПараметрыРасчета.Вставить("СписокДокументовДляРасчетаДоходовРасходов", ДанныеСпискаДокументов.СписокДокументов);
	ДопПараметрыРасчета.Вставить("МинимальнаяДатаДокументов", ДанныеСпискаДокументов.МинимальнаяДатаДокументов);
	
	ДопПараметрыРасчета.Вставить("ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями",
		ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями(ПараметрыРасчета));
	
	Если ПрошлыйПериод Тогда
		Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ПараметрыРасчета.НачалоПериода-1));
		Запрос.УстановитьПараметр("КонецПериода", ПараметрыРасчета.НачалоПериода-1);
	Иначе	
		Запрос.УстановитьПараметр("НачалоПериода", ДопПараметрыРасчета.МинимальнаяДатаДокументов);
		Запрос.УстановитьПараметр("КонецПериода", МоментВремени());
	КонецЕсли;

	// IMDEV-7330 В параметр Портфель передаем Массив (используется в тексте запроса как В (&Портфель)).
	Запрос.УстановитьПараметр("ДатаРасчетаНДФЛ", Дата);
	Запрос.УстановитьПараметр("Портфель", Портфели);
	// IMDEV-7330 Передаем ТаблицаЗначений: (Портфель, РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета).
	Запрос.УстановитьПараметр("РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета", ДопПараметрыРасчета.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета);
	// IMDEV-7330 Передаем ТаблицаЗначений: (Портфель, ДокументДляРасчетаДоходовРасходов).
	Запрос.УстановитьПараметр("СписокДокументовДляРасчетаДоходовРасходов", ДопПараметрыРасчета.СписокДокументовДляРасчетаДоходовРасходов);
	// IMDEV-7330 Передаем ТаблицаЗначений с детализацией продаж по санкционным клиентам.
	Запрос.УстановитьПараметр("ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями", ДопПараметрыРасчета.ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями);
	Запрос.УстановитьПараметр("Выручка", ПланыСчетов.Хозрасчетный.Выручка);
	Запрос.УстановитьПараметр("РасчетыЦБПродажа", ПланыСчетов.Хозрасчетный.РасчетыЦБПродажа);
	Запрос.УстановитьПараметр("АкцииТело", ПланыСчетов.Хозрасчетный.АкцииТело);
	Запрос.УстановитьПараметр("Себестоимость", ПланыСчетов.Хозрасчетный.Себестоимость);
	Запрос.УстановитьПараметр("СчетаУчета", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("68.01, 90.01, 90.02, 91.01.02, 91.01.09, 91.02.02, 91.02.03, 91.02.04, 91.02.05, 91.02.06, 91.02.10, 91.02.11, 91.03, 91.04, 91.02.08"));
	Запрос.УстановитьПараметр("СчетаСрочныеКонтракты",ПланыСчетов.Хозрасчетный.СчетаПоСтроке("76.01.02,55.03.2"));
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "НачислениеНДФЛПоПортфелю.ОбщиеОбороты");
	
	#Удаление
	ОбщиеОбороты = Запрос.Выполнить().Выгрузить();
	#КонецУдаления
	#Вставка
	ОбщиеОбороты = ВыполнитьЗапросСПовторомПриБлокировке(
		Запрос, "НачислениеНДФЛПоПортфелю.ОбщиеОбороты").Выгрузить();
	#КонецВставки
	
	Возврат ОбщиеОбороты;		
	
КонецФункции

&ИзменениеИКонтроль("ОбщиеОборотыТекстЗапроса")
Функция IMDEV7330_Locks_ОбщиеОборотыТекстЗапроса()
	
	Возврат "////////////////////////////////////////////////////////////////////////////////
	        |// IMDEV-7330-1 -1 Первая ВТ: список документов расчета доходов/расходов по портфелям.
	        |ВЫБРАТЬ
	        |	СписокДокументовДляРасчетаДоходовРасходов.Портфель КАК Портфель,
	        |	СписокДокументовДляРасчетаДоходовРасходов.ДокументДляРасчетаДоходовРасходов КАК ДокументДляРасчетаДоходовРасходов
	        |ПОМЕСТИТЬ ВТ_СписокДокументовДляРасчетаДоходовРасходов
	        |ИЗ
	        |	&СписокДокументовДляРасчетаДоходовРасходов КАК СписокДокументовДляРасчетаДоходовРасходов
	        |
	        |// IMDEV-7330-1 -1 Индексация только по Портфель: по полю составного типа (несколько ДокументСсылка) индексировать нельзя.
	        |ИНДЕКСИРОВАТЬ ПО
	        |	Портфель
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |// IMDEV-7330-1 -1 Вторая ВТ: настройки расчета НУ по каждому портфелю.
	        |ВЫБРАТЬ
	        |	НастройкиРасчетаПоПортфелю.Портфель КАК Портфель,
	        |	НастройкиРасчетаПоПортфелю.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета КАК РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета
	        |ПОМЕСТИТЬ ВТ_НастройкиРасчетаПоПортфелю
	        |ИЗ
	        |	&РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета КАК НастройкиРасчетаПоПортфелю
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	Портфель
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	КорректировкаФинРезультата.Период КАК Период,
	        |	КорректировкаФинРезультата.Регистратор КАК Регистратор,
	        |	КорректировкаФинРезультата.Портфель КАК Портфель,
	        |	КорректировкаФинРезультата.Актив КАК Актив,
	        |	КорректировкаФинРезультата.ВидОбращаемости КАК ВидОбращаемости,
	        |	КорректировкаФинРезультата.КорректировкаВыручка КАК КорректировкаВыручка,
	        |	КорректировкаФинРезультата.КорректировкаСебестоимость КАК КорректировкаСебестоимость,
	        |	КорректировкаФинРезультата.КорректировкаКупонныйДоход КАК КорректировкаКупонныйДоход,
	        |	КорректировкаФинРезультата.Документ КАК Документ
	        |ПОМЕСТИТЬ ВТ_КорректировкаФинРезультата
	        |ИЗ
	        |	РегистрНакопления.КорректировкаФинРезультата КАК КорректировкаФинРезультата
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НастройкиРасчетаПоПортфелю КАК ВТ_НастройкиРасчетаПоПортфелю
	        |		ПО КорректировкаФинРезультата.Портфель = ВТ_НастройкиРасчетаПоПортфелю.Портфель
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СписокДокументовДляРасчетаДоходовРасходов КАК ВТ_СписокДокументовДляРасчетаДоходовРасходов
	        |		ПО КорректировкаФинРезультата.Портфель = ВТ_СписокДокументовДляРасчетаДоходовРасходов.Портфель
	        |			И КорректировкаФинРезультата.Документ = ВТ_СписокДокументовДляРасчетаДоходовРасходов.ДокументДляРасчетаДоходовРасходов
	        |ГДЕ
	        |	ЕСТЬNULL(ВТ_НастройкиРасчетаПоПортфелю.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета, ЛОЖЬ) = ЛОЖЬ
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |// IMDEV-7330-1 -1 Отбор оборотов теперь по списку портфелей и с выводом портфеля в результат.
	        |ВЫБРАТЬ
	        |	ВТ_АкцииРоссийскихЭмитентов.Портфель КАК Портфель,
	        |	ВТ_АкцииРоссийскихЭмитентов.Актив КАК Актив,
	        |	ВТ_АкцииРоссийскихЭмитентов.Партия КАК Партия,
	        |	ВТ_АкцииРоссийскихЭмитентов.ВыручкаОборот КАК ВыручкаОборот,
	        |	ВТ_АкцииРоссийскихЭмитентов.СебестоимостьОборот КАК СебестоимостьОборот,
	        |	ВТ_АкцииРоссийскихЭмитентов.ДопРасходыОборот КАК ДопРасходыОборот,
	        |	ВТ_АкцииРоссийскихЭмитентов.Регистратор КАК Регистратор
	        |ПОМЕСТИТЬ ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями
	        |ИЗ
	        |	&ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями КАК ВТ_АкцииРоссийскихЭмитентов
	#Вставка
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	Регистратор,
	        |	Портфель,
	        |	Актив,
	        |	Партия
	#КонецВставки
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |// IMDEV-7330-1 -1 Финальная выборка содержит поле Портфель для трассировки строки.
	        |ВЫБРАТЬ
	        |	ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями.Портфель КАК Портфель,
	        |	ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями.Актив КАК Актив,
	        |	СУММА(ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями.ВыручкаОборот) КАК ВыручкаОборот,
	        |	ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями.Регистратор КАК Регистратор
	        |ПОМЕСТИТЬ ВТ_ТаблицаВыручкиПоКлиентамПодСанкциями
	        |ИЗ
	        |	ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями КАК ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями.Актив,
	        |	ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями.Регистратор,
	        |	ВТ_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями.Портфель
	#Вставка
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	Регистратор,
	        |	Актив,
	        |	Портфель
	#КонецВставки
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ХозрасчетныйОбороты.Счет КАК Счет,
	        |	ХозрасчетныйОбороты.Субконто1 КАК Субконто1,
	        |	ХозрасчетныйОбороты.Субконто2 КАК Субконто2,
	        |	ХозрасчетныйОбороты.Субконто3 КАК Субконто3,
	        |	ХозрасчетныйОбороты.СуммаОборот КАК СуммаОборот,
	        |	ХозрасчетныйОбороты.СуммаНУОборот КАК СуммаНУОборот,
	        |	ХозрасчетныйОбороты.СуммаОборотДт КАК СуммаОборотДт,
	        |	ХозрасчетныйОбороты.СуммаНУОборотДт КАК СуммаНУОборотДт,
	        |	ХозрасчетныйОбороты.СуммаОборотКт КАК СуммаОборотКт,
	        |	ХозрасчетныйОбороты.СуммаНУОборотКт КАК СуммаНУОборотКт,
	        |	ХозрасчетныйОбороты.КорСчет КАК КорСчет,
	        |	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
	        |	ХозрасчетныйОбороты.Портфель КАК Портфель,
	        |	ХозрасчетныйОбороты.Регистратор.БизнесПроцесс КАК БизнесПроцесс
	        |ПОМЕСТИТЬ ВТ_Обороты_Хозрасчетный
	        |ИЗ
	        |	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, Регистратор, Счет В (&СчетаУчета), , Портфель В (&Портфель), , ) КАК ХозрасчетныйОбороты
	        |ГДЕ
	        |	НЕ ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПогашениеОблигаций
	        |	И НЕ ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.Сделка
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |// IMDEV-7330-1 -1 Ветки ОБЪЕДИНИТЬ (погашения, сделки с учетом льгот по санкциям): в списке полей есть Портфель
	        |// IMDEV-7330-1 -1 для единой схемы с последующими ОБЪЕДИНЕНИЯМИ (корректировки, РН Продажи, срочные контракты).
	        |
	        |ВЫБРАТЬ
	        |	ХозрасчетныйОбороты.Счет,
	        |	ХозрасчетныйОбороты.Субконто1,
	        |	ХозрасчетныйОбороты.Субконто2,
	        |	ХозрасчетныйОбороты.Субконто3,
	        |	ХозрасчетныйОбороты.СуммаОборот,
	        |	ХозрасчетныйОбороты.СуммаНУОборот,
	        |	ХозрасчетныйОбороты.СуммаОборотДт,
	        |	ХозрасчетныйОбороты.СуммаНУОборотДт,
	        |	ХозрасчетныйОбороты.СуммаОборотКт,
