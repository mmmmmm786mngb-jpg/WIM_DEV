	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НастройкиРасчетаПоПортфелю КАК ВТ_НастройкиРасчетаПоПортфелю
	        |		ПО ВТ_Обороты_Хозрасчетный_Срочныеконтракты.Портфель = ВТ_НастройкиРасчетаПоПортфелю.Портфель";
	
КонецФункции

// Описание: Определяет, что ошибка вызвана ожиданием блокировки СУБД, а не логикой расчёта.
//           Повторять имеет смысл только такие ошибки.
//
// Параметры:
//   ТекстОшибки - Строка - подробное представление ошибки (ПодробноеПредставлениеОшибки).
//
// Возвращаемое значение:
//   Булево - Истина, если текст содержит признак таймаута / конфликта блокировок.
//
Функция ЭтоОшибкаОжиданияБлокировки(ТекстОшибки)

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстВНижнемРегистре = НРег(ТекстОшибки);

	Маркеры = Новый Массив;
	Маркеры.Добавить("конфликт блокировок");
	Маркеры.Добавить("lock request time out");
	Маркеры.Добавить("native=1222");
	Маркеры.Добавить("превышено время ожидания");

	Для Каждого Маркер Из Маркеры Цикл
		Если СтрНайти(ТекстВНижнемРегистре, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Описание: Выполняет запрос с повторами при ошибке ожидания блокировки СУБД.
//           Вызывать только вне транзакции записи: повтор внутри прерванной транзакции бессмысленен.
//           При исчерпании попыток или при ошибке, не являющейся блокировкой, исключение
//           вызывается с полным текстом исходной ошибки платформы (SQLSTATE, native, стек 1С).
//
// Параметры:
//   Запрос       - Запрос - запрос с установленными параметрами и текстом.
//   ИмяОперации  - Строка - имя операции для журнала регистрации.
//   ЧислоПопыток - Число - максимум попыток, по умолчанию 3.
//
// Возвращаемое значение:
//   РезультатЗапроса - результат успешного Выполнить().
//
Функция ВыполнитьЗапросСПовторомПриБлокировке(Запрос, ИмяОперации, ЧислоПопыток = 3)

	ПаузыМеждуПопыткамиМс = Новый Массив;
	ПаузыМеждуПопыткамиМс.Добавить(60000);
	ПаузыМеждуПопыткамиМс.Добавить(180000);

	НомерПопытки = 0;

	Пока Истина Цикл

		НомерПопытки = НомерПопытки + 1;

		Попытка
			Возврат Запрос.Выполнить();
		Исключение

			ИнформацияОбОшибкеВыполнения = ИнформацияОбОшибке();
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибкеВыполнения);

			ЭтоБлокировка = ЭтоОшибкаОжиданияБлокировки(ТекстОшибки);
			ПопыткиИсчерпаны = (НомерПопытки >= ЧислоПопыток);

			ТекстИсключения = СтрШаблон(
				НСтр("ru = '%1 (попытка %2 из %3).%4%5'"),
				ИмяОперации,
				НомерПопытки,
				ЧислоПопыток,
				Символы.ПС,
				ТекстОшибки);

			Если Не ЭтоБлокировка Или ПопыткиИсчерпаны Тогда

				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Начисление НДФЛ. Повтор запроса после блокировки'"),
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Документы.НачислениеНДФЛПоПортфелю,
					,
					ТекстИсключения);

				ВызватьИсключение ТекстИсключения;

			КонецЕсли;

			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Начисление НДФЛ. Повтор запроса после блокировки'"),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.НачислениеНДФЛПоПортфелю,
				,
				ТекстИсключения);

			ИндексПаузы = Мин(НомерПопытки, ПаузыМеждуПопыткамиМс.Количество()) - 1;
			АванкорСервер.Пауза(ПаузыМеждуПопыткамиМс[ИндексПаузы]);

		КонецПопытки;

	КонецЦикла;

КонецФункции

#КонецЕсли
