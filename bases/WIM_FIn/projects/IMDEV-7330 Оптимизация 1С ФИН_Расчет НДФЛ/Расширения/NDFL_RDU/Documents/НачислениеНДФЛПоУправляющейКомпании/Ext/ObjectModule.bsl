// IMDEV-7330 Модуль объекта документа "НачислениеНДФЛПоУправляющейКомпании" (расширение NDFL_RDU).
// Заимствование: свойство ObjectModule объекта заимствовано из базовой конфигурации WIM_FIn
// (исходники: см. bases/WIM_FIn/source-path.txt, каталог Documents/НачислениеНДФЛПоУправляющейКомпании/Ext/ObjectModule.bsl).
// Типовая реализация в расширение не копируется — здесь только перехваты и вспомогательный код.
//
// IMDEV-7330-4 Типовая РассчитатьНДФЛ() без параметров: внешний кэш НКД устанавливает обработка
// ФормированиеНачисленийНДФЛ через Документы.НачислениеНДФЛПоУправляющейКомпании.NDFL_RDU_УстановитьВнешнийКэшНКДРасходов
// перед вызовом РассчитатьНДФЛ. Перехват снимает защёлку после ПродолжитьВызов и в Исключение
// (см. Документация/imdev7330_ndfl_uk_nkd_mass_precalc_byclient.html, контракт B).

// IMDEV-7330-4 Описание: Перехват типовой РассчитатьНДФЛ без параметров — гарантированный сброс
//           внешнего кэша НКД в ПараметрыСеанса.ОбщиеЗначения после расчёта или при ошибке,
//           чтобы кэш не «пережил» вызов и не исказил следующий расчёт в сеансе.
//
&НаСервере
&Вместо("РассчитатьНДФЛ")
Процедура NDFL_RDU_РассчитатьНДФЛ() Экспорт

	Попытка
		ПродолжитьВызов();
	Исключение
		Документы.НачислениеНДФЛПоУправляющейКомпании.NDFL_RDU_УстановитьВнешнийКэшНКДРасходов(Неопределено);
		ВызватьИсключение;
	КонецПопытки;

	Документы.НачислениеНДФЛПоУправляющейКомпании.NDFL_RDU_УстановитьВнешнийКэшНКДРасходов(Неопределено);

КонецПроцедуры

// IMDEV-7330 Описание: Исправление ошибки справки-расчета НДФЛ к удержанию при отсутствии строк
//           удержаний по типу дохода: типовой код обращался к СтрокаУдержания.Ставка после цикла,
//           когда НайтиСтроки вернул пустой массив (переменная цикла не является строкой таблицы).
//
// Параметры:
// ТаблицаНачислений - ТаблицаЗначений - см. типовую ЗаполнитьСправкуРасчетНДФЛКУдержанию
// ТаблицаДоходовПоПортфелям - ТаблицаЗначений - см. типовую ЗаполнитьСправкуРасчетНДФЛКУдержанию
// УдерживатьНДФЛ - Булево - см. типовую ЗаполнитьСправкуРасчетНДФЛКУдержанию
//
&НаСервере
&ИзменениеИКонтроль("ЗаполнитьСправкуРасчетНДФЛКУдержанию")
Процедура NDFL_RDU_ЗаполнитьСправкуРасчетНДФЛКУдержанию(ТаблицаНачислений, ТаблицаДоходовПоПортфелям, УдерживатьНДФЛ)
	
	Таблица = ТаблицаНачислений.Скопировать();
	Таблица.Свернуть("ТипДохода", "НалогооблагаемаяCумма");
		
	ОбластьШапка 	= МакетСправкиРасчет.ПолучитьОбласть("ШапкаНДФЛКУдержанию");
	ОбластьСтрока	= МакетСправкиРасчет.ПолучитьОбласть("СтрокаНДФЛКУдержанию");
	ОбластьИтого	= МакетСправкиРасчет.ПолучитьОбласть("ИтогоНДФЛКУдержанию");
	
	ТабДокСправкиРасчет.Вывести(ОбластьШапка);
	
	ИтогоНДФЛ = 0;
	
	Если УдерживатьНДФЛ Тогда    
		
		Для каждого СтрокаТаблицы Из Таблица Цикл 
			ТипДоходаИное = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы.ТипДохода, "Иное") = Истина;
			ОбластьСтрока.Параметры.Заполнить(СтрокаТаблицы);
			НайденныеСтроки = ТаблицаДоходовПоПортфелям.НайтиСтроки(Новый Структура("ТипДохода", СтрокаТаблицы.ТипДохода));
			НДФЛ = 0;
			Для Каждого СтрокаУдержания Из НайденныеСтроки Цикл
				Если Клиент.НеРезидент Тогда
					НДФЛ = НДФЛ + СтрокаУдержания.СуммаКУдержанию + СтрокаУдержания.СуммаРанееУдержанногоНДФЛ;	
				ИначеЕсли ТипДоходаИное Тогда	
					НДФЛ = НДФЛ + СтрокаУдержания.СуммаКУдержанию;	
				Иначе
					НДФЛ = НДФЛ + СтрокаУдержания.СуммаКУдержаниюПоСтавке13 + СтрокаУдержания.СуммаКУдержаниюПоСтавке15 + СтрокаУдержания.СуммаРанееУдержанногоНДФЛ;	
				КонецЕсли;
			КонецЦикла;
			#Удаление
			Ставка = Перечисления.НДФЛСтавки.КоэффициентДляРасчетовПоСтавке(СтрокаУдержания.Ставка);
			НДФЛ = Мин(Окр(Ставка*СтрокаТаблицы.НалогооблагаемаяCумма), НДФЛ); 
			#КонецУдаления
			#Вставка
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаУдержанияДляСтавки = НайденныеСтроки[НайденныеСтроки.Количество() - 1];
				Ставка = Перечисления.НДФЛСтавки.КоэффициентДляРасчетовПоСтавке(СтрокаУдержанияДляСтавки.Ставка);
			Иначе
				Ставка = 0;
			КонецЕсли;
			НДФЛ = Мин(Окр(Ставка*СтрокаТаблицы.НалогооблагаемаяCумма), НДФЛ); 
			#КонецВставки
			ОбластьСтрока.Параметры.НДФЛ = НДФЛ;
			ИтогоНДФЛ = ИтогоНДФЛ + НДФЛ;
			ТабДокСправкиРасчет.Вывести(ОбластьСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
	ОбластьИтого.Параметры.НДФЛ = ИтогоНДФЛ;																										
	ТабДокСправкиРасчет.Вывести(ОбластьИтого);
	
КонецПроцедуры
