// IMDEV-7330-1 Модуль менеджера документа "НачислениеНДФЛПоУправляющейКомпании" (расширение). П.1 плана оптимизации.
// IMDEV-7330-1 Оптимизация ТаблицаПродаж (ВТ регистраторов вместо длинного В()).
// IMDEV-7330-4 П.4 плана: объединение вызовов в ИнвестиционныйВычетУКД. Отличия от типовой конфигурации помечены префиксом IMDEV-7330-N в комментариях.

#Область СлужебныеПроцедурыИФункции

// IMDEV-7330-1 Описание: Перехват получения движений регистра РегистрНакопления.Продажи по
// массиву документов-регистраторов с предварительным помещением списка регистраторов
// во временную таблицу и ВНУТРЕННИМ СОЕДИНЕНИЕМ с регистром продаж.
//
// Цель оптимизации:
// На больших массивах регистраторов передача параметра "В (&Регистратор)"
// разворачивается СУБД в длинный IN-список, что блокирует использование
// индексов по полю Регистратор и приводит к деградации плана выполнения.
// Помещение регистраторов во временную таблицу с явной индексацией позволяет
// оптимизатору применить эффективное соединение MERGE/HASH JOIN и устойчиво
// работать при произвольном размере входного массива.
//
// Параметры:
//   Регистраторы - Массив - массив документов-регистраторов, по которым
//                           требуется получить движения регистра Продажи.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица движений регистра Продажи по переданным
//                     регистраторам с признаком Активность = Истина и колонками,
//                     совпадающими по составу и порядку с типовой реализацией.
//
&Вместо("ТаблицаПродаж")
Функция NDFL_RDU_ТаблицаПродаж(Регистраторы)

	Запрос = Новый Запрос;
	// IMDEV-7330-1 Флаги и имена типов для ветвления: типовой запрос "В (&Регистратор)" или ВТ + JOIN.
	ИспользоватьОптимизацию = Истина;
	ТипРегистратора = Неопределено;
	ПервыйРегистратор = Неопределено;
	ИмяТипаРегистратораВЗапросе = "";
	ИмяТипаСсылкиРегистратора = "";

	Если ТипЗнч(Регистраторы) <> Тип("Массив") Или Регистраторы.Количество() = 0 Тогда
		ИспользоватьОптимизацию = Ложь;
	Иначе
		Для Каждого Регистратор Из Регистраторы Цикл
			Если Регистратор = Неопределено Тогда
				ИспользоватьОптимизацию = Ложь;
				Прервать;
			КонецЕсли;

			ТекущийТипРегистратора = ТипЗнч(Регистратор);
			Если ТипРегистратора = Неопределено Тогда
				ТипРегистратора = ТекущийТипРегистратора;
				ПервыйРегистратор = Регистратор;
			ИначеЕсли ТекущийТипРегистратора <> ТипРегистратора Тогда
				ИспользоватьОптимизацию = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ИспользоватьОптимизацию Тогда
			ИмяТипаРегистратораВЗапросе = ПервыйРегистратор.Метаданные().ПолноеИмя();
			ИмяТипаСсылкиРегистратора = СтрЗаменить(ИмяТипаРегистратораВЗапросе, "Документ.", "ДокументСсылка.");
			Если Лев(ИмяТипаСсылкиРегистратора, СтрДлина("ДокументСсылка.")) <> "ДокументСсылка." Тогда
				ИспользоватьОптимизацию = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// IMDEV-7330-1 Ветка "как в типовой": не массив, пустой массив, смешанные типы регистраторов
	// или тип не Документ.* — оставляем текст с Продажи.Регистратор В(&Регистраторы).
	Если Не ИспользоватьОптимизацию Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Продажи.Регистратор КАК Регистратор,
			|	Продажи.Портфель КАК Портфель,
			|	Продажи.Актив КАК Актив,
			|	Продажи.Партия КАК Партия,
			|	Продажи.Количество КАК Количество,
			|	Продажи.ВалютнаяСуммаВыручки КАК ВалютнаяСуммаВыручки,
			|	Продажи.Выручка КАК Выручка,
			|	Продажи.Себестоимость КАК Себестоимость,
			|	Продажи.Переоценка КАК Переоценка,
			|	Продажи.ДопРасходы КАК ДопРасходы,
			|	Продажи.Партия.Дата КАК ДатаПартии
			|ИЗ
			|	РегистрНакопления.Продажи КАК Продажи
			|ГДЕ
			|	Продажи.Регистратор В(&Регистраторы)
			|	И Продажи.Активность";

		Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Иначе
		// IMDEV-7330-1 Оптимизированная ветка (однородный массив одного типа документа): типизированная ТЗ
		// регистраторов, ПОМЕСТИТЬ ВТ_Регистраторы, JOIN с ВЫРАЗИТЬ(Продажи.Регистратор КАК Документ.*).
		ТЗРегистраторы = Новый ТаблицаЗначений;
		ТЗРегистраторы.Колонки.Добавить("Регистратор", Новый ОписаниеТипов(ИмяТипаСсылкиРегистратора));

		Для Каждого Регистратор Из Регистраторы Цикл
			ТЗРегистраторы.Добавить().Регистратор = Регистратор;
		КонецЦикла;

		ТЗРегистраторы.Свернуть("Регистратор", "");

		Запрос.Текст =
			"ВЫБРАТЬ
			|	ВходнаяТаблица.Регистратор КАК Регистратор
			|ПОМЕСТИТЬ ВТ_Регистраторы
			|ИЗ
			|	&Регистраторы КАК ВходнаяТаблица
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Регистратор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Продажи.Регистратор КАК Регистратор,
			|	Продажи.Портфель КАК Портфель,
			|	Продажи.Актив КАК Актив,
			|	Продажи.Партия КАК Партия,
			|	Продажи.Количество КАК Количество,
			|	Продажи.ВалютнаяСуммаВыручки КАК ВалютнаяСуммаВыручки,
			|	Продажи.Выручка КАК Выручка,
			|	Продажи.Себестоимость КАК Себестоимость,
			|	Продажи.Переоценка КАК Переоценка,
			|	Продажи.ДопРасходы КАК ДопРасходы,
			|	Продажи.Партия.Дата КАК ДатаПартии
			|ИЗ
			|	ВТ_Регистраторы КАК ВТРегистраторы
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи КАК Продажи
			|		ПО ВТРегистраторы.Регистратор = ВЫРАЗИТЬ(Продажи.Регистратор КАК " + ИмяТипаРегистратораВЗапросе + ")
			|ГДЕ
			|	Продажи.Активность";

		Запрос.УстановитьПараметр("Регистраторы", ТЗРегистраторы);
	КонецЕсли;

	// IMDEV-7330-1 Имя в логе отладки изменено относительно типовой строки с документом "ПоПортфелю" - контекст УК.
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "НачислениеНДФЛПоУправляющейКомпании.ТаблицаПродаж");
	ТаблицаПродаж = Запрос.Выполнить().Выгрузить();

	Возврат ТаблицаПродаж;

КонецФункции

#КонецОбласти

// IMDEV-7330-4 Область: перехват ИнвестиционныйВычетУКД (см. типовую функцию в cf).
#Область ИнвестиционныйВычетУКД_IMDEV7330

// IMDEV-7330-4 Описание: Замена типовой реализации — один вызов РасходыПоНКДПоВидуОбращаемости вместо двух
// с последующим ДополнитьТаблицу по обращающимся и необращающимся видам ЦБ.
//
// Дополнительное описание:
// В перечислении ВидыОбращаемостиЦБ есть значения вне пары методов ОбращающиесяВиды / НеОбращающиесяВиды
// (например СделкаРЕПО, помеченные к удалению). Их намеренно не включаем: поведение совпадает
// с прежней парой вызовов. Убрать фильтр В(&ВидыОбращаемости) в самой РасходыПоНКДПоВидуОбращаемости нельзя
// без отдельного анализа влияния на инвестиционный вычет.
//
// Параметры:
// Клиент - см. вызывающую процедуру ОтразитьУКДиНКДВИнвестВычете, ссылка на клиента для отбора в запросе.
// Дата - Дата - дата расчета (конец периода в параметрах запроса).
//
// Возвращаемое значение:
// ТаблицаЗначений - объединение по регистраторам расходов НКД по УКД для обоих наборов видов обращаемости.
//
&Вместо("ИнвестиционныйВычетУКД")
Функция NDFL_RDU_ИнвестиционныйВычетУКД(Клиент, Дата)

	// IMDEV-7330-4 Один вызов РасходыПоНКДПоВидуОбращаемости с тем же супермножеством видов, что и массовый кэш НКД по УК.
	ВидыДляИнвестВычета = NDFL_RDU_ВидыОбращаемостиДляМассовогоКэшаНКДУК();

	УКДПоПартиям = РасходыПоНКДПоВидуОбращаемости(ВидыДляИнвестВычета, Клиент, Дата).ПоРегистраторам;

	Возврат УКДПоПартиям;

КонецФункции

#КонецОбласти

#Область IMDEV7330_4_МассовыйПредрасчетРасходовНКД

// IMDEV-7330-4 Описание: Супермножество видов обращаемости ЦБ для массового предрасчёта НКД по УК и для
//           NDFL_RDU_ИнвестиционныйВычетУКД (обращающиеся и необращающиеся виды, без прочих значений перечисления).
//
// Возвращаемое значение:
//   Массив - значения перечисления ВидыОбращаемостиЦБ (объединение ОбращающиесяВиды и НеОбращающиесяВиды).
//
Функция NDFL_RDU_ВидыОбращаемостиДляМассовогоКэшаНКДУК()

	ВидыНКД = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыНКД, Перечисления.ВидыОбращаемостиЦБ.ОбращающиесяВиды());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыНКД, Перечисления.ВидыОбращаемостиЦБ.НеОбращающиесяВиды());

	Возврат ВидыНКД;

КонецФункции

// IMDEV-7330-4 Описание: Составной ключ кэша расходов НКД по паре (Клиент, дата документа).
//
// Параметры:
//   Клиент - СправочникСсылка.Контрагенты - клиент портфеля.
//   Дата - Дата - дата расчёта (берётся КонецДня для совпадения с ключом при сборе пар в обработке).
//
// Возвращаемое значение:
//   Строка - уникальный ключ для Соответствия кэша.
//
Функция NDFL_RDU_КлючКэшаНКД(Клиент, Дата) Экспорт

	Возврат Строка(Клиент.УникальныйИдентификатор()) + "|" + Формат(КонецДня(Дата), "ДФ=yyyyMMdd");

КонецФункции

// IMDEV-7330-4 Описание: Группирует пары (Клиент, Дата) по дате (конец дня) для пакетного запроса по массиву клиентов.
//           Уникальность клиента внутри одной даты обеспечивается Соответствием (без вложенного цикла по массиву).
//
// Параметры:
//   МассивПарКлиентДата - Массив - элементы Структура("Клиент, Дата").
//
// Возвращаемое значение:
//   Соответствие - ключ Дата (КонецДня), значение Массив уникальных Клиент на эту дату.
//
Функция NDFL_RDU_РазложитьПарыПоДате(МассивПарКлиентДата)

	// Временное хранение: дата -> Структура(Массив клиентов, Соответствие уже добавленных ссылок).
	ПоДатеВрем = Новый Соответствие;

	Для Каждого Пара Из МассивПарКлиентДата Цикл

		ТекДата = КонецДня(Пара.Дата);
		ЗаписьДаты = ПоДатеВрем.Получить(ТекДата);
		Если ЗаписьДаты = Неопределено Тогда
			ЗаписьДаты = Новый Структура("Клиенты, УникальныеКлиенты", Новый Массив, Новый Соответствие);
			ПоДатеВрем.Вставить(ТекДата, ЗаписьДаты);
		КонецЕсли;

		Если ЗаписьДаты.УникальныеКлиенты.Получить(Пара.Клиент) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЗаписьДаты.УникальныеКлиенты.Вставить(Пара.Клиент, Истина);
		ЗаписьДаты.Клиенты.Добавить(Пара.Клиент);

	КонецЦикла;

	ПарыПоДате = Новый Соответствие;
	Для Каждого КлючИЗначение Из ПоДатеВрем Цикл
		ПарыПоДате.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение.Клиенты);
	КонецЦикла;

	Возврат ПарыПоДате;

КонецФункции

// IMDEV-7330-4 Описание: Выделяет из общей выгрузки пакета НКД строки одного клиента по колонке Клиент.
//
// Параметры:
//   ТаблицаИсточник - ТаблицаЗначений, Неопределено - ПоПартиям или ПоРегистраторам после NDFL_RDU_РасходыПоНКДПоКлиентамИДате.
//   Клиент - СправочникСсылка.Контрагенты - клиент для отбора.
//
// Возвращаемое значение:
//   ТаблицаЗначений - копия с отфильтрованными строками; если источник пустой или Неопределено — как передано.
//
Функция NDFL_RDU_СтрокиПоКлиенту(ТаблицаИсточник, Клиент)

	Если ТаблицаИсточник = Неопределено Или ТаблицаИсточник.Количество() = 0 Тогда
		Возврат ТаблицаИсточник;
	КонецЕсли;

	Если ТаблицаИсточник.Колонки.Найти("Клиент") = Неопределено Тогда
		Возврат ТаблицаИсточник.Скопировать();
	КонецЕсли;

	Результат = ТаблицаИсточник.Скопировать();
	Индекс = Результат.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Результат[Индекс].Клиент <> Клиент Тогда
			Результат.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// IMDEV-7330-4 Описание: Устанавливает или снимает внешний кэш НКД в ПараметрыСеанса.ОбщиеЗначения (модуль менеджера УК).
//
// Параметры:
//   ЗначениеКэша - Соответствие, Неопределено - полный кэш по ключам NDFL_RDU_КлючКэшаНКД или сброс.
//
Процедура NDFL_RDU_УстановитьВнешнийКэшНКДРасходов(ЗначениеКэша) Экспорт

	КлючКэша = "NDFL_RDU_КэшНКД";

	Если ПараметрыСеанса.ОбщиеЗначения = Неопределено Тогда
		ПараметрыСеанса.ОбщиеЗначения = Новый ХранилищеЗначения(Новый Соответствие);
	КонецЕсли;

	ОбщиеЗначения = ПараметрыСеанса.ОбщиеЗначения.Получить();
	Если ТипЗнч(ОбщиеЗначения) <> Тип("Соответствие") Тогда
		ОбщиеЗначения = Новый Соответствие;
	КонецЕсли;

	Если ЗначениеКэша = Неопределено Тогда
		Если ОбщиеЗначения.Получить(КлючКэша) <> Неопределено Тогда
			ОбщиеЗначения.Удалить(КлючКэша);
		КонецЕсли;
	Иначе
		ОбщиеЗначения.Вставить(КлючКэша, ЗначениеКэша);
	КонецЕсли;

	ПараметрыСеанса.ОбщиеЗначения = Новый ХранилищеЗначения(ОбщиеЗначения);

КонецПроцедуры

// IMDEV-7330-4 Описание: Возвращает внешний кэш НКД из ПараметрыСеанса.ОбщиеЗначения.
//
Функция NDFL_RDU_ПолучитьВнешнийКэшНКДРасходов() Экспорт

	КлючКэша = "NDFL_RDU_КэшНКД";
	Если ПараметрыСеанса.ОбщиеЗначения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбщиеЗначения = ПараметрыСеанса.ОбщиеЗначения.Получить();
	Если ТипЗнч(ОбщиеЗначения) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщиеЗначения.Получить(КлючКэша);

КонецФункции

// IMDEV-7330-4 Описание: Один пакетный запрос расходов НКД по массиву клиентов на дату (адаптация типовой РасходыПоНКДПоВидуОбращаемости).
//           Отличия от одиночного клиента: Портфель.Клиент В (&МассивКлиентов), в ВТ и итогах есть колонка Клиент;
//           в финальных блоках отбор ВидыОбращаемостиЦБ В(&ВидыОбращаемости) и СГРУППИРОВАТЬ ПО без поля вида (суммы по видам из параметра уже в Сумма).
//
// Параметры:
//   ВидыОбращаемости - Массив - обычно NDFL_RDU_ВидыОбращаемостиДляМассовогоКэшаНКДУК для согласованности с кэшем и ИнвестиционныйВычетУКД.
//   МассивКлиентов - Массив - уникальные СправочникСсылка.Контрагенты на одну дату пакета.
//   Дата - Дата - конец периода расчёта (КонецДня в параметрах запроса).
//
// Возвращаемое значение:
//   Структура - ключи ПоПартиям, ПоРегистраторам (ТаблицаЗначений с колонкой Клиент). Инверсия сумм при РасходыОтУКДУменьшаютДоходы — только для ПоПартиям, как в типовой.
//
Функция NDFL_RDU_РасходыПоНКДПоКлиентамИДате(ВидыОбращаемости, МассивКлиентов, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3 КАК Купон,
