#Область СлужебныеПроцедурыИФункции

// Описание: Перехват получения движений регистра РегистрНакопления.Продажи по
// массиву документов-регистраторов с предварительным помещением списка регистраторов
// во временную таблицу и ВНУТРЕННИМ СОЕДИНЕНИЕМ с регистром продаж.
//
// Цель оптимизации:
// На больших массивах регистраторов передача параметра "В (&Регистратор)"
// разворачивается СУБД в длинный IN-список, что блокирует использование
// индексов по полю Регистратор и приводит к деградации плана выполнения.
// Помещение регистраторов во временную таблицу с явной индексацией позволяет
// оптимизатору применить эффективное соединение MERGE/HASH JOIN и устойчиво
// работать при произвольном размере входного массива.
//
// Параметры:
//   Регистраторы - Массив - массив документов-регистраторов, по которым
//                           требуется получить движения регистра Продажи.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица движений регистра Продажи по переданным
//                     регистраторам с признаком Активность = Истина и колонками,
//                     совпадающими по составу и порядку с типовой реализацией.
//
&Вместо("ТаблицаПродаж")
Функция NDFL_RDU_ТаблицаПродаж(Регистраторы)

	// IMDEV-7330 Преобразуем входной массив в типизированную таблицу значений
	// с одной колонкой "Регистратор" - так временная таблица в запросе получит
	// предсказуемое имя поля и пригодную для индексирования структуру.
	ТЗРегистраторы = Новый ТаблицаЗначений;
	ТЗРегистраторы.Колонки.Добавить("Регистратор");
	Для Каждого Регистратор Из Регистраторы Цикл
		Если Регистратор = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТЗРегистраторы.Добавить().Регистратор = Регистратор;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВходнаяТаблица.Регистратор КАК Регистратор
		|ПОМЕСТИТЬ ВТ_Регистраторы
		|ИЗ
		|	&Регистраторы КАК ВходнаяТаблица
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Продажи.Регистратор КАК Регистратор,
		|	Продажи.Портфель КАК Портфель,
		|	Продажи.Актив КАК Актив,
		|	Продажи.Партия КАК Партия,
		|	Продажи.Количество КАК Количество,
		|	Продажи.ВалютнаяСуммаВыручки КАК ВалютнаяСуммаВыручки,
		|	Продажи.Выручка КАК Выручка,
		|	Продажи.Себестоимость КАК Себестоимость,
		|	Продажи.Переоценка КАК Переоценка,
		|	Продажи.ДопРасходы КАК ДопРасходы,
		|	Продажи.Партия.Дата КАК ДатаПартии
		|ИЗ
		|	РегистрНакопления.Продажи КАК Продажи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Регистраторы КАК ВТРегистраторы
		|		ПО Продажи.Регистратор = ВТРегистраторы.Регистратор
		|ГДЕ
		|	Продажи.Активность";

	Запрос.УстановитьПараметр("Регистраторы", ТЗРегистраторы);

	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "НачислениеНДФЛПоУправляющейКомпании.NDFL_RDU_ТаблицаПродаж");
	ТаблицаПродаж = Запрос.Выполнить().Выгрузить();

	Возврат ТаблицаПродаж;

КонецФункции

#КонецОбласти

#Область IMDEV7330_ИнвестиционныйВычетУКД

// Описание: Замена типовой реализации — один вызов РасходыПоНКДПоВидуОбращаемости вместо двух
// с последующим ДополнитьТаблицу по обращающимся и необращающимся видам ЦБ.
//
// Дополнительное описание:
// В перечислении ВидыОбращаемостиЦБ есть значения вне пары методов ОбращающиесяВиды / НеОбращающиесяВиды
// (например СделкаРЕПО, помеченные к удалению). Их намеренно не включаем: поведение совпадает
// с прежней парой вызовов. Убрать фильтр В(&ВидыОбращаемости) в самой РасходыПоНКДПоВидуОбращаемости нельзя
// без отдельного анализа влияния на инвестиционный вычет.
//
// Параметры:
// Клиент - см. вызывающую процедуру ОтразитьУКДиНКДВИнвестВычете, ссылка на клиента для отбора в запросе.
// Дата - Дата - дата расчета (конец периода в параметрах запроса).
//
// Возвращаемое значение:
// ТаблицаЗначений - объединение по регистраторам расходов НКД по УКД для обоих наборов видов обращаемости.
//
&Вместо("ИнвестиционныйВычетУКД")
Функция NDFL_RDU_ИнвестиционныйВычетУКД(Клиент, Дата)

	ВидыДляИнвестВычета = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыДляИнвестВычета, Перечисления.ВидыОбращаемостиЦБ.ОбращающиесяВиды());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыДляИнвестВычета, Перечисления.ВидыОбращаемостиЦБ.НеОбращающиесяВиды());

	УКДПоПартиям = РасходыПоНКДПоВидуОбращаемости(ВидыДляИнвестВычета, Клиент, Дата).ПоРегистраторам;

	Возврат УКДПоПартиям;

КонецФункции

#КонецОбласти
