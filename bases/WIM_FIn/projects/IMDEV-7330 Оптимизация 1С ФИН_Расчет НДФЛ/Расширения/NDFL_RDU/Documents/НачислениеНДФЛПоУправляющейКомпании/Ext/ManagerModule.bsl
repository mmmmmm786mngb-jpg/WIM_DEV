// IMDEV-7330-4 Описание: Массовый предрасчёт расходов НКД по уникальным парам (Клиент, Дата).
//           В запросе используется супермножество видов NDFL_RDU_ВидыОбращаемостиДляМассовогоКэшаНКДУК
//           (обращающиеся и необращающиеся). При попадании в кэш перехват РасходыПоНКДПоВидуОбращаемости возвращает ту же структуру по ссылке (без копирования таблиц).
//
// Параметры:
//   МассивПарКлиентДата - Массив - структуры с полями Клиент, Дата.
//
// Возвращаемое значение:
//   Соответствие - ключ NDFL_RDU_КлючКэшаНКД(Клиент, Дата), значение Структура ПоПартиям / ПоРегистраторам по одному клиенту.
//
Функция NDFL_RDU_ПолучитьРасходыПоНКДПоКлиентам(МассивПарКлиентДата) Экспорт

	Результат = Новый Соответствие;

	Если МассивПарКлиентДата = Неопределено Или МассивПарКлиентДата.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПарыПоДате = NDFL_RDU_РазложитьПарыПоДате(МассивПарКлиентДата);

	ВидыДляМассовогоКэшаНКД = NDFL_RDU_ВидыОбращаемостиДляМассовогоКэшаНКДУК();

	Для Каждого КлючИЗначение Из ПарыПоДате Цикл

		ТекДата = КлючИЗначение.Ключ;
		Клиенты = КлючИЗначение.Значение;

		СтруктураПакета = NDFL_RDU_РасходыПоНКДПоКлиентамИДате(ВидыДляМассовогоКэшаНКД, Клиенты, ТекДата);

		Для Каждого Клиент Из Клиенты Цикл

			КлючКД = NDFL_RDU_КлючКэшаНКД(Клиент, ТекДата);
			ПоКлиенту = Новый Структура;
			ПоКлиенту.Вставить("ПоПартиям", NDFL_RDU_СтрокиПоКлиенту(СтруктураПакета.ПоПартиям, Клиент));
			ПоКлиенту.Вставить("ПоРегистраторам", NDFL_RDU_СтрокиПоКлиенту(СтруктураПакета.ПоРегистраторам, Клиент));
			Результат.Вставить(КлючКД, ПоКлиенту);

		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// IMDEV-7330-4 Описание: Перехват РасходыПоНКДПоВидуОбращаемости — при установленном внешнем кэше возврат без тяжёлого запроса.
//           Возвращается срез из кэша по ключу NDFL_RDU_КлючКэшаНКД: та же Структура(ПоПартиям, ПоРегистраторам), что положил NDFL_RDU_ПолучитьРасходыПоНКДПоКлиентам.
//           Таблицы не копируются: вызывающий код не должен менять строки (иначе портится кэш в ПараметрыСеанса.ОбщиеЗначения).
//
// Параметры:
//   ВидыОбращаемости - Массив - при промахе кэша уходит в типовую; при попадании в кэш должен совпадать по смыслу с предрасчётом (супермножество видов).
//   Клиент - СправочникСсылка.Контрагенты - клиент расчёта.
//   Дата - Дата - дата расчёта (ключ кэша через КонецДня).
//
// Возвращаемое значение:
//   Структура - как у типовой РасходыПоНКДПоВидуОбращаемости; при кэше возможна лишняя колонка Клиент в таблицах.
//
&Вместо("РасходыПоНКДПоВидуОбращаемости")
Функция NDFL_RDU_РасходыПоНКДПоВидуОбращаемости(ВидыОбращаемости, Клиент, Дата)

	ВнешнийКэш = NDFL_RDU_ПолучитьВнешнийКэшНКДРасходов();
	Если ВнешнийКэш <> Неопределено Тогда
		КлючКД = NDFL_RDU_КлючКэшаНКД(Клиент, Дата);
		ПоКД = ВнешнийКэш.Получить(КлючКД);
		Если ПоКД <> Неопределено Тогда
			Возврат ПоКД;
		КонецЕсли;
	КонецЕсли;

	Возврат ПродолжитьВызов(ВидыОбращаемости, Клиент, Дата);

КонецФункции

#КонецОбласти
