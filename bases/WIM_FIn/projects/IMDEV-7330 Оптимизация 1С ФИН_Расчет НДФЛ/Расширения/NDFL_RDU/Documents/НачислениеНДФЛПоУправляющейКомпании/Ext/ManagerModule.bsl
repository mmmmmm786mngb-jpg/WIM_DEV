// IMDEV-7330-1 Модуль менеджера документа "НачислениеНДФЛПоУправляющейКомпании" (расширение). П.1 плана оптимизации.
// IMDEV-7330-1 Оптимизация ТаблицаПродаж (ВТ регистраторов вместо длинного В()).
// IMDEV-7330-4 П.4 плана: объединение вызовов в ИнвестиционныйВычетУКД. Отличия от типовой конфигурации помечены префиксом IMDEV-7330-N в комментариях.

#Область СлужебныеПроцедурыИФункции

// IMDEV-7330-1 Описание: Перехват получения движений регистра РегистрНакопления.Продажи по
// массиву документов-регистраторов с предварительным помещением списка регистраторов
// во временную таблицу и ВНУТРЕННИМ СОЕДИНЕНИЕМ с регистром продаж.
//
// Цель оптимизации:
// На больших массивах регистраторов передача параметра "В (&Регистратор)"
// разворачивается СУБД в длинный IN-список, что блокирует использование
// индексов по полю Регистратор и приводит к деградации плана выполнения.
// Помещение регистраторов во временную таблицу с явной индексацией позволяет
// оптимизатору применить эффективное соединение MERGE/HASH JOIN и устойчиво
// работать при произвольном размере входного массива.
//
// Параметры:
//   Регистраторы - Массив - массив документов-регистраторов, по которым
//                           требуется получить движения регистра Продажи.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица движений регистра Продажи по переданным
//                     регистраторам с признаком Активность = Истина и колонками,
//                     совпадающими по составу и порядку с типовой реализацией.
//
&Вместо("ТаблицаПродаж")
Функция NDFL_RDU_ТаблицаПродаж(Регистраторы)

	Запрос = Новый Запрос;
	// IMDEV-7330-1 Флаги и имена типов для ветвления: типовой запрос "В (&Регистратор)" или ВТ + JOIN.
	ИспользоватьОптимизацию = Истина;
	ТипРегистратора = Неопределено;
	ПервыйРегистратор = Неопределено;
	ИмяТипаРегистратораВЗапросе = "";
	ИмяТипаСсылкиРегистратора = "";

	Если ТипЗнч(Регистраторы) <> Тип("Массив") Или Регистраторы.Количество() = 0 Тогда
		ИспользоватьОптимизацию = Ложь;
	Иначе
		Для Каждого Регистратор Из Регистраторы Цикл
			Если Регистратор = Неопределено Тогда
				ИспользоватьОптимизацию = Ложь;
				Прервать;
			КонецЕсли;

			ТекущийТипРегистратора = ТипЗнч(Регистратор);
			Если ТипРегистратора = Неопределено Тогда
				ТипРегистратора = ТекущийТипРегистратора;
				ПервыйРегистратор = Регистратор;
			ИначеЕсли ТекущийТипРегистратора <> ТипРегистратора Тогда
				ИспользоватьОптимизацию = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ИспользоватьОптимизацию Тогда
			ИмяТипаРегистратораВЗапросе = ПервыйРегистратор.Метаданные().ПолноеИмя();
			ИмяТипаСсылкиРегистратора = СтрЗаменить(ИмяТипаРегистратораВЗапросе, "Документ.", "ДокументСсылка.");
			Если Лев(ИмяТипаСсылкиРегистратора, СтрДлина("ДокументСсылка.")) <> "ДокументСсылка." Тогда
				ИспользоватьОптимизацию = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// IMDEV-7330-1 Ветка "как в типовой": не массив, пустой массив, смешанные типы регистраторов
	// или тип не Документ.* — оставляем текст с Продажи.Регистратор В(&Регистраторы).
	Если Не ИспользоватьОптимизацию Тогда
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Продажи.Регистратор КАК Регистратор,
			|	Продажи.Портфель КАК Портфель,
			|	Продажи.Актив КАК Актив,
			|	Продажи.Партия КАК Партия,
			|	Продажи.Количество КАК Количество,
			|	Продажи.ВалютнаяСуммаВыручки КАК ВалютнаяСуммаВыручки,
			|	Продажи.Выручка КАК Выручка,
			|	Продажи.Себестоимость КАК Себестоимость,
			|	Продажи.Переоценка КАК Переоценка,
			|	Продажи.ДопРасходы КАК ДопРасходы,
			|	Продажи.Партия.Дата КАК ДатаПартии
			|ИЗ
			|	РегистрНакопления.Продажи КАК Продажи
			|ГДЕ
			|	Продажи.Регистратор В(&Регистраторы)
			|	И Продажи.Активность";

		Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
	Иначе
		// IMDEV-7330-1 Оптимизированная ветка (однородный массив одного типа документа): типизированная ТЗ
		// регистраторов, ПОМЕСТИТЬ ВТ_Регистраторы, JOIN с ВЫРАЗИТЬ(Продажи.Регистратор КАК Документ.*).
		ТЗРегистраторы = Новый ТаблицаЗначений;
		ТЗРегистраторы.Колонки.Добавить("Регистратор", Новый ОписаниеТипов(ИмяТипаСсылкиРегистратора));

		Для Каждого Регистратор Из Регистраторы Цикл
			ТЗРегистраторы.Добавить().Регистратор = Регистратор;
		КонецЦикла;

		ТЗРегистраторы.Свернуть("Регистратор", "");

		Запрос.Текст =
			"ВЫБРАТЬ
			|	ВходнаяТаблица.Регистратор КАК Регистратор
			|ПОМЕСТИТЬ ВТ_Регистраторы
			|ИЗ
			|	&Регистраторы КАК ВходнаяТаблица
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Регистратор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Продажи.Регистратор КАК Регистратор,
			|	Продажи.Портфель КАК Портфель,
			|	Продажи.Актив КАК Актив,
			|	Продажи.Партия КАК Партия,
			|	Продажи.Количество КАК Количество,
			|	Продажи.ВалютнаяСуммаВыручки КАК ВалютнаяСуммаВыручки,
			|	Продажи.Выручка КАК Выручка,
			|	Продажи.Себестоимость КАК Себестоимость,
			|	Продажи.Переоценка КАК Переоценка,
			|	Продажи.ДопРасходы КАК ДопРасходы,
			|	Продажи.Партия.Дата КАК ДатаПартии
			|ИЗ
			|	ВТ_Регистраторы КАК ВТРегистраторы
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи КАК Продажи
			|		ПО ВТРегистраторы.Регистратор = ВЫРАЗИТЬ(Продажи.Регистратор КАК " + ИмяТипаРегистратораВЗапросе + ")
			|ГДЕ
			|	Продажи.Активность";

		Запрос.УстановитьПараметр("Регистраторы", ТЗРегистраторы);
	КонецЕсли;

	// IMDEV-7330-1 Имя в логе отладки изменено относительно типовой строки с документом "ПоПортфелю" - контекст УК.
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "НачислениеНДФЛПоУправляющейКомпании.ТаблицаПродаж");
	ТаблицаПродаж = Запрос.Выполнить().Выгрузить();

	Возврат ТаблицаПродаж;

КонецФункции

#КонецОбласти

// IMDEV-7330-4 Область: перехват ИнвестиционныйВычетУКД (см. типовую функцию в cf).
#Область ИнвестиционныйВычетУКД_IMDEV7330

// IMDEV-7330-4 Описание: Замена типовой реализации — один вызов РасходыПоНКДПоВидуОбращаемости вместо двух
// с последующим ДополнитьТаблицу по обращающимся и необращающимся видам ЦБ.
//
// Дополнительное описание:
// В перечислении ВидыОбращаемостиЦБ есть значения вне пары методов ОбращающиесяВиды / НеОбращающиесяВиды
// (например СделкаРЕПО, помеченные к удалению). Их намеренно не включаем: поведение совпадает
// с прежней парой вызовов. Убрать фильтр В(&ВидыОбращаемости) в самой РасходыПоНКДПоВидуОбращаемости нельзя
// без отдельного анализа влияния на инвестиционный вычет.
//
// Параметры:
// Клиент - см. вызывающую процедуру ОтразитьУКДиНКДВИнвестВычете, ссылка на клиента для отбора в запросе.
// Дата - Дата - дата расчета (конец периода в параметрах запроса).
//
// Возвращаемое значение:
// ТаблицаЗначений - объединение по регистраторам расходов НКД по УКД для обоих наборов видов обращаемости.
//
&Вместо("ИнвестиционныйВычетУКД")
Функция NDFL_RDU_ИнвестиционныйВычетУКД(Клиент, Дата)

	// IMDEV-7330-4 Один набор видов обращаемости вместо двух последовательных вызовов + ДополнитьТаблицу в типовой.
	ВидыДляИнвестВычета = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыДляИнвестВычета, Перечисления.ВидыОбращаемостиЦБ.ОбращающиесяВиды());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыДляИнвестВычета, Перечисления.ВидыОбращаемостиЦБ.НеОбращающиесяВиды());

	УКДПоПартиям = РасходыПоНКДПоВидуОбращаемости(ВидыДляИнвестВычета, Клиент, Дата).ПоРегистраторам;

	Возврат УКДПоПартиям;

КонецФункции

#КонецОбласти
