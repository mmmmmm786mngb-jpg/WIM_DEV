	        |			ТОГДА ВТ_Обороты_Хозрасчетный_Срочныеконтракты.Субконто2
	        |		КОГДА ВТ_Обороты_Хозрасчетный_Срочныеконтракты.Субконто3 ССЫЛКА Справочник.СтатьиДоходовИРасходов
	        |			ТОГДА ВТ_Обороты_Хозрасчетный_Срочныеконтракты.Субконто3
	        |	КОНЕЦ,
	        |	ВТ_Обороты_Хозрасчетный_Срочныеконтракты.БизнесПроцесс
	        |ИЗ
	        |	ВТ_Обороты_Хозрасчетный_Срочныеконтракты КАК ВТ_Обороты_Хозрасчетный_Срочныеконтракты
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НастройкиРасчетаПоПортфелю КАК ВТ_НастройкиРасчетаПоПортфелю
	        |		ПО ВТ_Обороты_Хозрасчетный_Срочныеконтракты.Портфель = ВТ_НастройкиРасчетаПоПортфелю.Портфель";
	
КонецФункции

// IMDEV-7330 Описание: Перехватывает типовую процедуру РассчитатьНДФЛ для приёма внешнего кэша оборотов
//           по текущему портфелю и проброса его в перехват NDFL_RDU_ОбщиеОбороты через
//           модульную переменную NDFL_RDU_ВнешнийКэшОборотов.
//           Сама подмена тяжёлого запроса происходит в NDFL_RDU_ОбщиеОбороты:
//           когда типовая ПараметрыРасчета() дойдёт до вызова ОбщиеОбороты(...),
//           перехват вернёт таблицу из кэша до выполнения запроса к Хозрасчетному.
//
// Параметры:
//   ПараметрыРасчетаВнешн - Структура - готовый кэш оборотов по текущему портфелю.
//     Ключи:
//       * ОбщиеОборотыТек          - ТаблицаЗначений - обороты текущего периода;
//       * ОбщиеОборотыПрошлыйГод   - ТаблицаЗначений - обороты прошлого года.
//     Если Неопределено (по умолчанию) - режим без кэша, расчёт идёт по типовому пути.
//
// Пример (из обработки ФормированиеНачисленийНДФЛ):
//   ПарамВнешн = Новый Структура;
//   ПарамВнешн.Вставить("ОбщиеОборотыТек",        КэшПортфеля);
//   ПарамВнешн.Вставить("ОбщиеОборотыПрошлыйГод", КэшПрошлыйГод);
//   НачислениеНДФЛПоПортфелю.РассчитатьНДФЛ(ПарамВнешн);
//
&НаСервере
&Вместо("РассчитатьНДФЛ")
Процедура NDFL_RDU_РассчитатьНДФЛ(ПараметрыРасчетаВнешн = Неопределено) Экспорт
	
	NDFL_RDU_ВнешнийКэшОборотов = ПараметрыРасчетаВнешн;
	Попытка
		ПродолжитьВызов();
	Исключение
		// IMDEV-7330 Снимаем флаг внешнего кэша даже при ошибке расчёта,
		// иначе модульная переменная "переживёт" вызов и испортит следующий расчёт.
		NDFL_RDU_ВнешнийКэшОборотов = Неопределено;
		ВызватьИсключение;
	КонецПопытки;
	NDFL_RDU_ВнешнийКэшОборотов = Неопределено;
	
КонецПроцедуры

// IMDEV-7330 Описание: Приводит параметры расчета к мультипортфельному контракту для ОбщиеОбороты.
//           Для массива портфелей гарантирует табличные параметры:
//           1) РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета;
//           2) СписокДокументовДляРасчетаДоходовРасходов;
//           3) ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями.
//
// Параметры:
//   ПараметрыРасчетаНДФЛ - Структура - исходные параметры расчета.
//   Портфели - Массив - массив ссылок СправочникСсылка.Портфели.
//
// Возвращаемое значение:
//   Структура - нормализованные параметры расчета.
//
&НаСервере
Функция NDFL_RDU_НормализоватьПараметрыДляОбщихОборотов(ПараметрыРасчетаНДФЛ, Портфели)
	
	ПараметрыРасчетаНДФЛ.Вставить("Портфели", Портфели);
	
	ПараметрыРасчетаНДФЛ.Вставить("РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета",
		NDFL_RDU_НастройкиРасчетаНУПоПортфелям(Портфели));
	
	ПараметрыРасчетаНДФЛ.Вставить("СписокДокументовДляРасчетаДоходовРасходов",
		NDFL_RDU_СписокДокументовДляРасчетаДоходовРасходов(ПараметрыРасчетаНДФЛ));
	
	ПараметрыРасчетаНДФЛ.Вставить("ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями",
		NDFL_RDU_ТаблицаПродажДляРасчетаЛьготПоКлиентамПодСанкциями(ПараметрыРасчетаНДФЛ));
	
	Возврат ПараметрыРасчетаНДФЛ;
	
КонецФункции

// IMDEV-7330 Описание: Формирует ТаблицаЗначений настройки НУ по каждому портфелю.
//           Значение признака читается из регистра параметров портфеля на дату документа.
//
// Параметры:
//   Портфели - Массив - массив ссылок СправочникСсылка.Портфели.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки (Портфель, РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета).
//
&НаСервере
Функция NDFL_RDU_НастройкиРасчетаНУПоПортфелям(Портфели)
	
	ТаблицаНастроекНУ = Новый ТаблицаЗначений;
	ТаблицаНастроекНУ.Колонки.Добавить("Портфель",
		Новый ОписаниеТипов("СправочникСсылка.Портфели"));
	ТаблицаНастроекНУ.Колонки.Добавить("РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета",
		Новый ОписаниеТипов("Булево"));
	
	Если Портфели = Неопределено Или Портфели.Количество() = 0 Тогда
		Возврат ТаблицаНастроекНУ;
	КонецЕсли;
	
	ПараметрРасчетаНУ = ПланыВидовХарактеристик.ПараметрыПортфеля.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета;
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПараметрРасчетаНУ);
	
	Для Каждого ТекПортфель Из Портфели Цикл
		ЗначенияПараметров = РегистрыСведений.ЗначенияПараметровПортфеля.ЗначенияПараметровПортфеля(
			ТекПортфель,
			МассивПараметров,
			Дата);
		НоваяСтрока = ТаблицаНастроекНУ.Добавить();
		НоваяСтрока.Портфель = ТекПортфель;
		НоваяСтрока.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета = ЗначенияПараметров.Получить(ПараметрРасчетаНУ) = Истина;
	КонецЦикла;
	
	Возврат ТаблицаНастроекНУ;
	
КонецФункции

// IMDEV-7330 Описание: Подготавливает массовый кэш оборотов по массиву портфелей.
//           Один раз выполняет тяжёлый запрос NDFL_RDU_ОбщиеОбороты для текущего и прошлого
//           периодов на массиве портфелей и раскладывает результат в Соответствие
//           Портфель -> ТаблицаОборотов. Используется обработкой ФормированиеНачисленийНДФЛ
//           до основного цикла по клиентам/портфелям.
//
// Параметры:
//   МассивПортфелей - Массив из СправочникСсылка.Портфели - суперсет портфелей выборки.
//
// Возвращаемое значение:
//   Структура с ключами:
//     * ОборотыПоПортфелю          - Соответствие - ключ Портфель, значение ТаблицаЗначений;
//     * ОборотыПрошлыйГодПоПортфелю - Соответствие - ключ Портфель, значение ТаблицаЗначений.
//
// Пример:
//   ТехДок = НайтиСоздатьДокументПоПортфелю(Справочники.Портфели.ПустаяСсылка(), МаксДата);
//   Кэш = ТехДок.NDFL_RDU_ПолучитьОбщиеОборотыПоПортфелям(МассивПортфелей);
//
&НаСервере
Функция NDFL_RDU_ПолучитьОбщиеОборотыПоПортфелям(МассивПортфелей) Экспорт
	
	// IMDEV-7330 Шаг 1. Собираем типовую структуру ПараметрыРасчета и подставляем массив портфелей.
	//          Внутри типовой ПараметрыРасчета() уже вызовутся ОбщиеОбороты(...) - и вернутся
	//          сюда с пустым кэшем (NDFL_RDU_ВнешнийКэшОборотов = Неопределено), т.е. честно
	//          отработают по массиву портфелей. Для нас важно вызывать их РОВНО ДВА раза
	//          (текущий и прошлый период) на полном массиве, что и делает типовая функция.
	ПараметрыРасчета = ПараметрыРасчета();
	ПараметрыРасчета.Вставить("Портфели", МассивПортфелей);
	
	// IMDEV-7330 Шаг 2. Один проход - текущий период; второй - прошлый.
	//          Передаём в NDFL_RDU_ОбщиеОбороты структуру с ключом Портфели,
	//          результат уже содержит колонку Портфель.
	ТаблицаОборотов          = ОбщиеОбороты(ПараметрыРасчета);
	ТаблицаОборотовПрошлыйГод = ОбщиеОбороты(ПараметрыРасчета, Истина);
	
	Результат = Новый Структура;
	Результат.Вставить("ОборотыПоПортфелю",
		NDFL_RDU_РазложитьТаблицуОборотовПоПортфелю(ТаблицаОборотов));
	Результат.Вставить("ОборотыПрошлыйГодПоПортфелю",
		NDFL_RDU_РазложитьТаблицуОборотовПоПортфелю(ТаблицаОборотовПрошлыйГод));
	
	Возврат Результат;
	
КонецФункции

// IMDEV-7330 Описание: Раскладывает таблицу оборотов с колонкой Портфель в Соответствие
//           Портфель -> ТаблицаЗначений (с теми же колонками). Один проход по таблице.
//           Если входная таблица пустая или не содержит колонки Портфель - возвращает
//           пустое Соответствие.
//
// Параметры:
//   ТаблицаОборотов - ТаблицаЗначений - результат NDFL_RDU_ОбщиеОбороты по массиву портфелей,
//                                       обязательно с колонкой Портфель.
//
// Возвращаемое значение:
//   Соответствие - ключ СправочникСсылка.Портфели, значение ТаблицаЗначений с оборотами по нему.
//
&НаСервере
Функция NDFL_RDU_РазложитьТаблицуОборотовПоПортфелю(ТаблицаОборотов) Экспорт
	
	Результат = Новый Соответствие;
	Если ТаблицаОборотов = Неопределено
		Или ТаблицаОборотов.Колонки.Найти("Портфель") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаИсточника Из ТаблицаОборотов Цикл
		ТекПортфель = СтрокаИсточника.Портфель;
		ТЗПортфеля = Результат.Получить(ТекПортфель);
		Если ТЗПортфеля = Неопределено Тогда
			ТЗПортфеля = ТаблицаОборотов.СкопироватьКолонки();
			Результат.Вставить(ТекПортфель, ТЗПортфеля);
		КонецЕсли;
		НоваяСтрока = ТЗПортфеля.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточника);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

