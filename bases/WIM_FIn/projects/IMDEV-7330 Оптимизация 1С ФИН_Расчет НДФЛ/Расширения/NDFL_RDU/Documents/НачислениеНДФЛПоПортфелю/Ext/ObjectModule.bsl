// IMDEV-7330-3 Описание: Перехватывает типовую процедуру РассчитатьНДФЛ для приёма внешнего кэша оборотов
//           по текущему портфелю и передачи его в NDFL_RDU_ОбщиеОбороты через NDFL_RDU_ВнешнийКэшОборотов.
//           Пока кэш задан, перехват ОбщиеОбороты при совпадении ключа возвращает готовую таблицу значений
//           до запроса к регистру бухгалтерии, в том числе при вызовах из типовой ПараметрыРасчета внутри ПродолжитьВызов.
//
// Параметры:
//   ПараметрыРасчетаВнешн - Структура - готовый кэш оборотов по текущему портфелю.
//     Ключи:
//       * ОбщиеОборотыТек          - ТаблицаЗначений - обороты текущего периода;
//       * ОбщиеОборотыПрошлыйГод   - ТаблицаЗначений - обороты прошлого года.
//     Если Неопределено (по умолчанию) - режим без кэша, расчёт идёт по типовому пути.
//
// Пример вызова с готовыми оборотами:
//   ПарамВнешн = Новый Структура;
//   ПарамВнешн.Вставить("ОбщиеОборотыТек",        КэшПортфеля);
//   ПарамВнешн.Вставить("ОбщиеОборотыПрошлыйГод", КэшПрошлыйГод);
//   НачислениеНДФЛПоПортфелю.РассчитатьНДФЛ(ПарамВнешн);
//
&НаСервере
&Вместо("РассчитатьНДФЛ")
Процедура NDFL_RDU_РассчитатьНДФЛ(ПараметрыРасчетаВнешн = Неопределено) Экспорт
	
	NDFL_RDU_ВнешнийКэшОборотов = ПараметрыРасчетаВнешн;
	Попытка
		ПродолжитьВызов();
	Исключение
		// IMDEV-7330-3 Снимаем флаг внешнего кэша даже при ошибке расчёта,
		// иначе модульная переменная "переживёт" вызов и испортит следующий расчёт.
		NDFL_RDU_ВнешнийКэшОборотов = Неопределено;
		ВызватьИсключение;
	КонецПопытки;
	NDFL_RDU_ВнешнийКэшОборотов = Неопределено;
	
КонецПроцедуры

// IMDEV-7330-3 Описание: Формирует ТаблицаЗначений настройки НУ по каждому портфелю.
//           Значение признака РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета читается через
//           РегистрыСведений.ЗначенияПараметровПортфеля на дату документа (реквизит Дата объекта).
//
// Параметры:
//   Портфели - Массив - массив ссылок СправочникСсылка.Портфели.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки (Портфель, РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета).
//
&НаСервере
Функция NDFL_RDU_НастройкиРасчетаНУПоПортфелям(Портфели)
	
	ТаблицаНастроекНУ = Новый ТаблицаЗначений;
	ТаблицаНастроекНУ.Колонки.Добавить("Портфель",
		Новый ОписаниеТипов("СправочникСсылка.Портфели"));
	ТаблицаНастроекНУ.Колонки.Добавить("РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета",
		Новый ОписаниеТипов("Булево"));
	
	Если Портфели = Неопределено Или Портфели.Количество() = 0 Тогда
		Возврат ТаблицаНастроекНУ;
	КонецЕсли;
	
	ПараметрРасчетаНУ = ПланыВидовХарактеристик.ПараметрыПортфеля.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета;
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПараметрРасчетаНУ);
	
	Для Каждого ТекПортфель Из Портфели Цикл
		ЗначенияПараметров = РегистрыСведений.ЗначенияПараметровПортфеля.ЗначенияПараметровПортфеля(
			ТекПортфель,
			МассивПараметров,
			Дата);
		НоваяСтрока = ТаблицаНастроекНУ.Добавить();
		НоваяСтрока.Портфель = ТекПортфель;
		НоваяСтрока.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета = ЗначенияПараметров.Получить(ПараметрРасчетаНУ) = Истина;
	КонецЦикла;
	
	Возврат ТаблицаНастроекНУ;
	
КонецФункции

// IMDEV-7330-3 Описание: Подготавливает массовый кэш оборотов по массиву портфелей.
//           После вызова типовой ПараметрыРасчета() (внутри неё уже два вызова ОбщиеОбороты
//           для реквизита Портфель документа) в структуру добавляется Портфели и ещё дважды
//           вызывается перехваченная ОбщиеОбороты по полному массиву портфелей (текущий и прошлый год).
//           Результат раскладывается в соответствия и шаблоны колонок. Вызывается до типового цикла по табличной части ДатыДокументов.
//
// Параметры:
//   МассивПортфелей - Массив из СправочникСсылка.Портфели - полный набор портфелей выборки.
//
// Возвращаемое значение:
//   Структура с ключами:
//     * ОборотыПоПортфелю            - Соответствие - ключ Портфель, значение ТаблицаЗначений;
//     * ОборотыПрошлыйГодПоПортфелю  - Соответствие - ключ Портфель, значение ТаблицаЗначений;
//     * ШаблонОборотыТек             - ТаблицаЗначений - пустая таблица с колонками текущего периода;
//     * ШаблонОборотыПрошлыйГод      - ТаблицаЗначений - пустая таблица с колонками прошлого года.
//
// Пример:
//   ТехДок = НайтиСоздатьДокументПоПортфелю(Справочники.Портфели.ПустаяСсылка(), МаксДата);
//   Кэш = ТехДок.NDFL_RDU_ПолучитьОбщиеОборотыПоПортфелям(МассивПортфелей);
//
&НаСервере
Функция NDFL_RDU_ПолучитьОбщиеОборотыПоПортфелям(МассивПортфелей) Экспорт
	
	// IMDEV-7330-3 Шаг 1. Типовая ПараметрыРасчета(): внутри вызывает СписокДокументовДляРасчетаДоходовРасходов
	//          и дважды ОбщиеОбороты для одного реквизита Портфель документа (кэш внешний выключен).
	//          Затем добавляем в структуру ключ Портфели с массивом портфелей для пакетного пересчёта.
	ПараметрыРасчета = ПараметрыРасчета();
	ПараметрыРасчета.Вставить("Портфели", МассивПортфелей);
	
	// IMDEV-7330-3 Шаг 2. Повторно ОбщиеОбороты(Ложь) и ОбщиеОбороты(Истина) уже по полному массиву портфелей
	//          и нормализованными таблицами значений в параметрах; результат выгрузки содержит колонку Портфель.
	ТаблицаОборотов          = ОбщиеОбороты(ПараметрыРасчета);
	ТаблицаОборотовПрошлыйГод = ОбщиеОбороты(ПараметрыРасчета, Истина);
	
	Результат = Новый Структура;
	Результат.Вставить("ОборотыПоПортфелю",
		NDFL_RDU_РазложитьТаблицуОборотовПоПортфелю(ТаблицаОборотов));
	Результат.Вставить("ОборотыПрошлыйГодПоПортфелю",
		NDFL_RDU_РазложитьТаблицуОборотовПоПортфелю(ТаблицаОборотовПрошлыйГод));
	Результат.Вставить("ШаблонОборотыТек", ТаблицаОборотов.СкопироватьКолонки());
	Результат.Вставить("ШаблонОборотыПрошлыйГод", ТаблицаОборотовПрошлыйГод.СкопироватьКолонки());
	
	Возврат Результат;
	
КонецФункции

// IMDEV-7330-3 Описание: Раскладывает таблицу оборотов с колонкой Портфель в Соответствие
//           Портфель -> ТаблицаЗначений (с теми же колонками). Один проход по таблице.
//           Если входная таблица пустая или не содержит колонки Портфель - возвращает
//           пустое Соответствие.
//
// Параметры:
//   ТаблицаОборотов - ТаблицаЗначений - результат NDFL_RDU_ОбщиеОбороты по массиву портфелей,
//                                       обязательно с колонкой Портфель.
//
// Возвращаемое значение:
//   Соответствие - ключ СправочникСсылка.Портфели, значение ТаблицаЗначений с оборотами по нему.
//
&НаСервере
Функция NDFL_RDU_РазложитьТаблицуОборотовПоПортфелю(ТаблицаОборотов)
	
	Результат = Новый Соответствие;
	Если ТаблицаОборотов = Неопределено
		Или ТаблицаОборотов.Колонки.Найти("Портфель") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаИсточника Из ТаблицаОборотов Цикл
		ТекПортфель = СтрокаИсточника.Портфель;
		ТЗПортфеля = Результат.Получить(ТекПортфель);
		Если ТЗПортфеля = Неопределено Тогда
			ТЗПортфеля = ТаблицаОборотов.СкопироватьКолонки();
			Результат.Вставить(ТекПортфель, ТЗПортфеля);
		КонецЕсли;
		НоваяСтрока = ТЗПортфеля.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточника);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

