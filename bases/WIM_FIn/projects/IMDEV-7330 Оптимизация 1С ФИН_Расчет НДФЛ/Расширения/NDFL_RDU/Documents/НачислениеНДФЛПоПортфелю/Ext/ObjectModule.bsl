	        |			ТОГДА ВЫРАЗИТЬ(ВТ_Обороты_Хозрасчетный.Субконто2 КАК Справочник.Активы)
	        |		КОГДА ВТ_Обороты_Хозрасчетный.Субконто3 ССЫЛКА Справочник.Активы
	        |			ТОГДА ВЫРАЗИТЬ(ВТ_Обороты_Хозрасчетный.Субконто3 КАК Справочник.Активы)
	        |	КОНЕЦ КАК Актив,
	        |	ВЫБОР
	        |		КОГДА ЕСТЬNULL(ВТ_НастройкиРасчетаПоПортфелю.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета, ЛОЖЬ)
	        |			ТОГДА ВТ_Обороты_Хозрасчетный.СуммаНУОборот
	        |		ИНАЧЕ ВТ_Обороты_Хозрасчетный.СуммаОборот
	        |	КОНЕЦ КАК СуммаОборот,
	        |	ВЫБОР
	        |		КОГДА ЕСТЬNULL(ВТ_НастройкиРасчетаПоПортфелю.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета, ЛОЖЬ)
	        |			ТОГДА ВТ_Обороты_Хозрасчетный.СуммаНУОборотДт
	        |		ИНАЧЕ ВТ_Обороты_Хозрасчетный.СуммаОборотДт
	        |	КОНЕЦ КАК СуммаОборотДт,
	        |	ВЫБОР
	        |		КОГДА ЕСТЬNULL(ВТ_НастройкиРасчетаПоПортфелю.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета, ЛОЖЬ)
	        |			ТОГДА ВТ_Обороты_Хозрасчетный.СуммаНУОборотКт
	        |		ИНАЧЕ ВТ_Обороты_Хозрасчетный.СуммаОборотКт
	        |	КОНЕЦ КАК СуммаОборотКт,
	        |	ВЫБОР
	        |		КОГДА ВТ_Обороты_Хозрасчетный.Субконто1 ССЫЛКА Справочник.СтатьиДоходовИРасходов
	        |			ТОГДА ВТ_Обороты_Хозрасчетный.Субконто1
	        |		КОГДА ВТ_Обороты_Хозрасчетный.Субконто2 ССЫЛКА Справочник.СтатьиДоходовИРасходов
	        |			ТОГДА ВТ_Обороты_Хозрасчетный.Субконто2
	        |		КОГДА ВТ_Обороты_Хозрасчетный.Субконто3 ССЫЛКА Справочник.СтатьиДоходовИРасходов
	        |			ТОГДА ВТ_Обороты_Хозрасчетный.Субконто3
	        |	КОНЕЦ КАК СтатьяДоходовИРасходов,
