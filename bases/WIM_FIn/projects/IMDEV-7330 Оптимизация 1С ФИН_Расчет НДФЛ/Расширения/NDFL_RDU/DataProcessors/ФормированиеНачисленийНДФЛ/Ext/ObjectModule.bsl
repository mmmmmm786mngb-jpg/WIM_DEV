
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// IMDEV-7330 Модуль обработки «ФормированиеНачисленийНДФЛ» (расширение): перехваты
// СоздатьДокументы, СоздатьНачислениеНДФЛПоПортфелю, СоздатьНачислениеНДФЛПоУК и
// вспомогательные процедуры кэша оборотов. Отличия от типовой конфигурации помечены префиксом IMDEV-7330 в комментариях.

// IMDEV-7330 Модульные переменные расширения для массового предрасчёта оборотов.
//   NDFL_RDU_СтруктураКэшОборотов - результат NDFL_RDU_ПолучитьОбщиеОборотыПоПортфелям (расширение документа
//     НачислениеНДФЛПоПортфелю): Соответствия ОборотыПоПортфелю и ОборотыПрошлыйГодПоПортфелю, плюс шаблоны колонок
//     ШаблонОборотыТек и ШаблонОборотыПрошлыйГод для пустых выборок по портфелю; либо Неопределено - расчёт по портфелю
//     без предварительного кэша (как в типовой схеме: РассчитатьНДФЛ() без параметров).
Перем NDFL_RDU_СтруктураКэшОборотов;

#Область ПРОГРАММНЫЙ_ИНТЕРФЕЙС

// IMDEV-7330 Описание: Перехватывает типовую СоздатьДокументы для гарантированного сброса
//           модульных переменных кэша в начале и в конце прогона.
//           Подготовка кэша оборотов выполняется один раз до ПродолжитьВызов по отборам NDFL_RDU_СобратьПарыКлиентУКСУчетомОтборовДокументов
//           (номер строки, клиенты с ЦБ при соответствующих флагах обработки); сообщения по отфильтрованным строкам
//           по-прежнему формирует типовой цикл внутри ПродолжитьВызов.
//
// Параметры:
//   ТабличныйДокумент - ТабличныйДокумент - буфер для лога обработки.
//
&Вместо("СоздатьДокументы")
Процедура NDFL_RDU_СоздатьДокументы(ТабличныйДокумент) Экспорт
	
	// IMDEV-7330 Принудительный сброс кэша на старте: если объект обработки переиспользуется
	// между вызовами (типичная ситуация для управляемой формы), модульные переменные не должны
	// "переживать" предыдущий прогон.
	NDFL_RDU_СтруктураКэшОборотов = Неопределено;
	
	Попытка
		МассивПарКлиентУК = NDFL_RDU_СобратьПарыКлиентУКСУчетомОтборовДокументов();
		NDFL_RDU_ИнициализироватьКэшОборотовПоМассивуПар(МассивПарКлиентУК);
		ПродолжитьВызов(ТабличныйДокумент);
	Исключение
		NDFL_RDU_СтруктураКэшОборотов = Неопределено;
		ВызватьИсключение;
	КонецПопытки;
	
	NDFL_RDU_СтруктураКэшОборотов = Неопределено;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// IMDEV-7330 Описание: Перехватывает типовую СоздатьНачислениеНДФЛПоПортфелю для проброса кэша
//           оборотов в РассчитатьНДФЛ. Кэш подготавливается в NDFL_RDU_СоздатьДокументы
//           до входа в типовой цикл.
//           Если кэш не построен (см. NDFL_RDU_ИнициализироватьКэшОборотовПоМассивуПар: нет пар, 0 портфелей
//           после запроса или количество портфелей меньше порога) - идёт по старому пути с РассчитатьНДФЛ() без параметров.
//
// Параметры:
//   СтрокаДокументов - СтрокаТабличнойЧасти.ДатыДокументов - текущая обрабатываемая
//                                                            пара Клиент/УК/Дата.
//   СписокСообщений  - ТаблицаЗначений - аккумулятор сообщений лога обработки.
//
&Вместо("СоздатьНачислениеНДФЛПоПортфелю")
Процедура NDFL_RDU_СоздатьНачислениеНДФЛПоПортфелю(СтрокаДокументов, СписокСообщений)
	
	// IMDEV-7330 Без изменений: сохраняем типовое условие включения формирования
	// документов по портфелю через константу.
	Если Не Константы.НачислениеНДФЛПоПортфелю.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	СписокПортфелей = СписокПортфелей(СтрокаДокументов);
	
	Для каждого ТекПортфель Из СписокПортфелей Цикл
		
		НачислениеНДФЛПоПортфелю = НайтиСоздатьДокументПоПортфелю(ТекПортфель, СтрокаДокументов.Дата);
		
		// IMDEV-7330 Если кэш есть - формируем структуру по текущему портфелю
		// и передаём в РассчитатьНДФЛ. Иначе - старый путь без параметров.
		Если NDFL_RDU_СтруктураКэшОборотов = Неопределено Тогда
			НачислениеНДФЛПоПортфелю.РассчитатьНДФЛ();
		Иначе
			ОборотыТек = NDFL_RDU_СтруктураКэшОборотов.ОборотыПоПортфелю.Получить(ТекПортфель);
			ОборотыПрошл = NDFL_RDU_СтруктураКэшОборотов.ОборотыПрошлыйГодПоПортфелю.Получить(ТекПортфель);
			ПарамВнешн = Новый Структура;
			Если ОборотыТек = Неопределено Тогда
				// IMDEV-7330 В кэше нет среза по этому портфелю: передаём пустую ТЗ с колонками как у массовой выборки,
				// чтобы РассчитатьНДФЛ(ПарамВнешн) не дернул повторный тяжёлый запрос оборотов за этот портфель внутри расчёта.
				ОборотыТек = NDFL_RDU_ПустаяТаблицаОборотов(
					NDFL_RDU_СтруктураКэшОборотов.ОборотыПоПортфелю,
					NDFL_RDU_СтруктураКэшОборотов.ШаблонОборотыТек);
			КонецЕсли;
			Если ОборотыПрошл = Неопределено Тогда
				// IMDEV-7330 Аналогично текущему периоду: пустая ТЗ прошлого года с колонками из кэша.
				ОборотыПрошл = NDFL_RDU_ПустаяТаблицаОборотов(
					NDFL_RDU_СтруктураКэшОборотов.ОборотыПрошлыйГодПоПортфелю,
					NDFL_RDU_СтруктураКэшОборотов.ШаблонОборотыПрошлыйГод);
			КонецЕсли;
			ПарамВнешн.Вставить("ОбщиеОборотыТек",        ОборотыТек);
			ПарамВнешн.Вставить("ОбщиеОборотыПрошлыйГод", ОборотыПрошл);
			НачислениеНДФЛПоПортфелю.РассчитатьНДФЛ(ПарамВнешн);
		КонецЕсли;
		
		КлиентПортфеля = ОбщегоНазначенияДУПовтИсп.ЗначенияРеквизитовПортфеля(ТекПортфель).Клиент;
		ДатаСмертиНаступила = Справочники.Контрагенты.ДатаСмертиНаступила(КлиентПортфеля, НачислениеНДФЛПоПортфелю.Дата);
		
		Если ДатаСмертиНаступила Тогда
			РеквизитыКлиента = ОбщегоНазначенияДУПовтИсп.ЗначенияРеквизитовОбъекта(ТекПортфель, "Клиент.Наименование, Клиент.ДатаСмерти");
			ТекстСообщения = СтрШаблон("Внимание, по клиенту %1 установлена дата смерти %2. Дата документа ""Начисление НДФЛ по портфелю"" должна быть меньше этой даты. Документ не создан",
				РеквизитыКлиента.КлиентНаименование,
				Формат(РеквизитыКлиента.КлиентДатаСмерти, "ДЛФ=Д"));
			ДобавитьСообщение(СписокСообщений, ТекстСообщения, НачислениеНДФЛПоПортфелю.Ссылка, Истина);
			Продолжить;
		КонецЕсли;
		
		// IMDEV-7330 Без изменений: оставляем типовую схему записи (проведение, при ошибке - запись).
		Попытка
			НачислениеНДФЛПоПортфелю.Записать(РежимЗаписиДокумента.Проведение);
			ТекстСообщения = "Проведено начисление НДФЛ по портфелю " + ТекПортфель;
			ДобавитьСообщение(СписокСообщений, ТекстСообщения, НачислениеНДФЛПоПортфелю.Ссылка);
		Исключение
			НачислениеНДФЛПоПортфелю.Записать(РежимЗаписиДокумента.Запись);
			ТекстСообщения = "Не удалось провести начисление НДФЛ по портфелю " + ТекПортфель + ". " + ОписаниеОшибки();
			ДобавитьСообщение(СписокСообщений, ТекстСообщения, НачислениеНДФЛПоПортфелю.Ссылка, Истина);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// IMDEV-7330 Описание: Перехватывает типовую СоздатьНачислениеНДФЛПоУК и добавляет
//           защиту от записи "пустого" документа (без строк в табличных частях).
//           Если после расчета НДФЛ все расчетные таблицы пустые, документ не записывается.
//
// Параметры:
//   СтрокаДокументов - СтрокаТабличнойЧасти.ДатыДокументов - текущая строка отбора.
//   СписокСообщений  - ТаблицаЗначений - аккумулятор сообщений лога обработки.
//   СписокНачислений - Массив - список созданных документов для последующей оплаты.
//
&Вместо("СоздатьНачислениеНДФЛПоУК")
Процедура NDFL_RDU_СоздатьНачислениеНДФЛПоУК(СтрокаДокументов, СписокСообщений, СписокНачислений)
	
	НачислениеНДФЛПоУК = НайтиСоздатьДокументПоУК(СтрокаДокументов);
	НачислениеНДФЛПоУК.РассчитатьНДФЛ();
	
	// IMDEV-7330 Добавлено: документ не записываем, если после расчета нет строк ни в одной
	// расчетной табличной части.
	Если НачислениеНДФЛПоУК.Начисления.Количество() = 0
		И НачислениеНДФЛПоУК.Удержания.Количество() = 0
		И НачислениеНДФЛПоУК.ИнвестиционныйВычетПоПортфелям.Количество() = 0 Тогда
		ТекстСообщения = "Документ ""Начисление НДФЛ по УК"" не записан: отсутствуют данные для расчета";
		ДобавитьСообщение(СписокСообщений, ТекстСообщения, СтрокаДокументов.Клиент, Ложь, Истина);
		Возврат;
	КонецЕсли;
	
	// IMDEV-7330 Без изменений: сохраняем типовую проверку "не создавать без удержаний".
	Если НеСоздаватьДокументыБезУдержаний И НачислениеНДФЛПоУК.Удержания.Итог("СуммаКУдержанию") = 0 Тогда
		ТекстСообщения = СтрокаДокументов.СхемаРеинвестирования;
		ДобавитьСообщение(СписокСообщений, ТекстСообщения, СтрокаДокументов.Клиент, Ложь, Истина);
		Возврат;
	КонецЕсли;
	
	РеквизитыКлиента = ОбщегоНазначенияДУПовтИсп.ЗначенияРеквизитовОбъекта(СтрокаДокументов.Клиент, "ДатаСмерти, Наименование");
	
	Если ЗначениеЗаполнено(РеквизитыКлиента.ДатаСмерти) Тогда
		Если РеквизитыКлиента.ДатаСмерти <> '0001.01.01' И НачислениеНДФЛПоУК.Дата >= РеквизитыКлиента.ДатаСмерти Тогда
			ТекстСообщения = СтрШаблон("Внимание, по клиенту %1 установлена дата смерти %2. Дата документа ""Начисление НДФЛ по УК"" должна быть меньше этой даты. Документ не создан",
				РеквизитыКлиента.Наименование,
				Формат(РеквизитыКлиента.ДатаСмерти, "ДЛФ=Д"));
			ДобавитьСообщение(СписокСообщений, ТекстСообщения, НачислениеНДФЛПоУК.Ссылка, Истина);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// IMDEV-7330 Без изменений: оставляем типовую схему записи (проведение, при ошибке - запись).
	Попытка
		НачислениеНДФЛПоУК.Записать(РежимЗаписиДокумента.Проведение);
		ТекстСообщения = "Проведено начисление НДФЛ по клиенту " + СтрокаДокументов.Клиент;
		ДобавитьСообщение(СписокСообщений, ТекстСообщения, НачислениеНДФЛПоУК.Ссылка);
		Если СоздаватьОплатуНДФЛ Тогда
			СписокНачислений.Добавить(НачислениеНДФЛПоУК.Ссылка);
		КонецЕсли;
	Исключение
		НачислениеНДФЛПоУК.Записать();
		ТекстСообщения = "Не удалось провести начисление НДФЛ по клиенту " + СтрокаДокументов.Клиент + ". " + ОписаниеОшибки();
		ДобавитьСообщение(СписокСообщений, ТекстСообщения, НачислениеНДФЛПоУК.Ссылка, Истина);
	КонецПопытки;
	
КонецПроцедуры

// IMDEV-7330 Описание: Уникальные пары Клиент/УК для предрасчёта кэша по тем же правилам отбора строк ТЧ,
//           что и в начале итерации типовой СоздатьДокументы (номер строки, исключение клиентов без ЦБ при флаге).
//           Сообщение "Клиент выведен" здесь не пишется - его добавляет типовой код при обходе ДатыДокументов.
//
// Возвращаемое значение:
//   Массив - структуры с полями Клиент, УправляющаяКомпания.
//
&НаСервере
Функция NDFL_RDU_СобратьПарыКлиентУКСУчетомОтборовДокументов()
	
	ОтборПоНомеруСтроки = НомерСтрокиС <> 0 Или НомерСтрокиПо <> 0;
	
	КлиентыСЦБ = Неопределено;
	Если НеСоздаватьДокументыПоКлиентамБезЦБ Тогда
		КлиентыСЦБ = СписокКлиентовСЦБ();
	КонецЕсли;
	
	МассивПарКлиентУК = Новый Массив;
	УникПары = Новый Соответствие;
	
	Для каждого СтрокаДокументов Из ДатыДокументов Цикл
		
		Если ОтборПоНомеруСтроки Тогда
			Если НомерСтрокиС <> 0 И СтрокаДокументов.НомерСтроки < НомерСтрокиС Тогда
				Продолжить;
			ИначеЕсли НомерСтрокиПо <> 0 И СтрокаДокументов.НомерСтроки > НомерСтрокиПо Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		Если НеСоздаватьДокументыПоКлиентамБезЦБ И КлиентыСЦБ.Найти(СтрокаДокументов.Клиент) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = Строка(СтрокаДокументов.Клиент.УникальныйИдентификатор())
			+ "|" + Строка(СтрокаДокументов.УправляющаяКомпания.УникальныйИдентификатор());
		Если УникПары.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Пара = Новый Структура("Клиент, УправляющаяКомпания");
		Пара.Клиент = СтрокаДокументов.Клиент;
		Пара.УправляющаяКомпания = СтрокаДокументов.УправляющаяКомпания;
		МассивПарКлиентУК.Добавить(Пара);
		УникПары.Вставить(Ключ, Истина);
	КонецЦикла;
	
	Возврат МассивПарКлиентУК;
	
КонецФункции

// IMDEV-7330 Описание: Однократная инициализация модульного кэша оборотов по переданным парам
//           Клиент/УК. Если пар нет, после запроса нет портфелей или их число меньше ПорогМассовогоПредрасчета -
//           процедура выходит, NDFL_RDU_СтруктураКэшОборотов остаётся Неопределено (как после сброса в начале СоздатьДокументы).
//
// Параметры:
//   МассивПарКлиентУК - Массив - структуры с полями Клиент, УправляющаяКомпания.
//
&НаСервере
Процедура NDFL_RDU_ИнициализироватьКэшОборотовПоМассивуПар(МассивПарКлиентУК)
	
	// IMDEV-7330 Порог массового предрасчёта (сейчас 1): при Количество() < 1 (т.е. 0 портфелей) кэш не строим.
	//           При одном и более портфелях выполняется пакетный запрос оборотов по всему массиву.
	ПорогМассовогоПредрасчета = 1;
	
	Если МассивПарКлиентУК.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивПортфелей = NDFL_RDU_СписокПортфелейПоКлиентам(МассивПарКлиентУК);
	
	Если МассивПортфелей.Количество() < ПорогМассовогоПредрасчета Тогда
		Возврат;
	КонецЕсли;
	
	// IMDEV-7330 Технический объект документа в памяти: только для вызова NDFL_RDU_ПолучитьОбщиеОборотыПоПортфелям, в БД не записывается.
	//           Реквизит Портфель заполняем первым элементом массива портфелей: при вызове типовой ПараметрыРасчета()
	//           нужна непустая ссылка на портфель (иначе возможны ошибки при чтении реквизитов портфеля).
	ТехДокОбъект = Документы.НачислениеНДФЛПоПортфелю.СоздатьДокумент();
	ТехДокОбъект.Портфель = МассивПортфелей[0];
	ТехДокОбъект.Дата = КонецДня(Период.ДатаОкончания);
	ТехДокОбъект.НалоговыйПериод = НалоговыйПериод;
	ТехДокОбъект.Заполнить(Неопределено);
	ТехДокОбъект.Автор = ПараметрыСеанса.ТекущийПользователь;
	ТехДокОбъект.Комментарий = "#Создан автоматически";
	ТехДокОбъект.Система = ПланыОбмена.ОбменНДФЛ.ИмяСистемы();
	ТехДокОбъект.ОтключитьЛьготированиеПроцентныхДоходовОблигаций =
		ТехДокОбъект.НалоговыйПериод.ДатаНачала >= Дата(2021, 1, 1);

	NDFL_RDU_СтруктураКэшОборотов = ТехДокОбъект.NDFL_RDU_ПолучитьОбщиеОборотыПоПортфелям(МассивПортфелей);
	
КонецПроцедуры

// IMDEV-7330 Описание: Один запрос для всех пар Клиент/УК - возвращает уникальный массив портфелей
//           по физическим лицам без пометки удаления. Аналог СписокПортфелей, но через
//           табличный параметр &ПарыКлиентУК для пакетного отбора.
//
// Параметры:
//   МассивПарКлиентУК - Массив - массив структур с полями Клиент, УправляющаяКомпания.
//
// Возвращаемое значение:
//   Массив - уникальные ссылки на портфели (СправочникСсылка.Портфели).
//
&НаСервере
Функция NDFL_RDU_СписокПортфелейПоКлиентам(МассивПарКлиентУК)
	
	ТЗПары = Новый ТаблицаЗначений;
	ТЗПары.Колонки.Добавить("Клиент",
		Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТЗПары.Колонки.Добавить("УправляющаяКомпания",
		Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Для Каждого Пара Из МассивПарКлиентУК Цикл
		НоваяСтрока = ТЗПары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Пара);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пары.Клиент КАК Клиент,
	|	Пары.УправляющаяКомпания КАК УправляющаяКомпания
	|ПОМЕСТИТЬ ВТ_Пары
	|ИЗ
	|	&Пары КАК Пары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Портфели.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Портфели КАК Портфели
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Пары КАК Пары
	|		ПО Портфели.Клиент = Пары.Клиент
	|			И Портфели.УправляющаяКомпания = Пары.УправляющаяКомпания
	|ГДЕ
	|	НЕ Портфели.ПометкаУдаления
	|	И Портфели.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)";
	
	Запрос.УстановитьПараметр("Пары", ТЗПары);
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "NDFL_RDU_СписокПортфелейПоКлиентам");
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// IMDEV-7330 Описание: Возвращает пустую ТаблицаЗначений с теми же колонками, что и одна из таблиц
//           кэша. Используется когда по конкретному портфелю в кэше нет строк
//           (т.е. оборотов нет вообще), но нужно передать в РассчитатьНДФЛ корректный
//           объект ТаблицаЗначений вместо Неопределено.
//
// Параметры:
//   СоответствиеПортфельТаблица - Соответствие - Портфель -> ТаблицаЗначений из кэша.
//   ТаблицаШаблон - ТаблицаЗначений - шаблон колонок, если соответствие пустое.
//
// Возвращаемое значение:
//   ТаблицаЗначений - пустая таблица с колонками.
//
&НаСервере
Функция NDFL_RDU_ПустаяТаблицаОборотов(СоответствиеПортфельТаблица, ТаблицаШаблон = Неопределено)
	
	Для Каждого Элемент Из СоответствиеПортфельТаблица Цикл
		// IMDEV-7330 Берём первую попавшуюся таблицу как образец и копируем её колонки.
		Возврат Элемент.Значение.СкопироватьКолонки();
	КонецЦикла;
	
	Если ТаблицаШаблон <> Неопределено Тогда
		Возврат ТаблицаШаблон.СкопироватьКолонки();
	КонецЕсли;
	
	Возврат Новый ТаблицаЗначений;
	
КонецФункции

#КонецОбласти

#КонецЕсли
