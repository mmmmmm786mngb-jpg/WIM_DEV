// IMDEV-7330-5 Возвращает массив из одной пачки — копию ИндексыСтрок (откаты в NDFL_RDU_РазбитьСтрокиНаПачки при одной пачке).
//
// Параметры:
// ИндексыСтрок - Массив из Число - номера строк.
//
// Возвращаемое значение:
// Массив из Массив - один внутренний массив — копия ИндексыСтрок.
//
Функция NDFL_RDU_МассивПачекОднаКопияИндексовСтрок(ИндексыСтрок)
	
	Результат = Новый Массив;
	Копия = Новый Массив;
	Для Каждого Инд Из ИндексыСтрок Цикл
		Копия.Добавить(Инд);
	КонецЦикла;
	Результат.Добавить(Копия);
	Возврат Результат;
	
КонецФункции

// IMDEV-7330-5 До K непустых пачек номеров строк: без полной ТЧ — равномерное деление ИндексыСтрок на K блоков; с полной ТЧ — окна по 1..максНомерТЧ (один проход по ИндексыСтрок, порядок внутри пачки как при обходе ТЧ при неубывающих НомерСтроки).
// IMDEV-7330-5 После окон при наличии ТЧ в снимке — слияние соседних пачек при общем клиенте на границе.
//
// Параметры:
// ИндексыСтрок - Массив из Число - номера строк (ожидается порядок как после NDFL_RDU_СобратьИндексыСтрокПоСнимку).
// КоличествоПачекПользователя - Число - желаемое K; фактически не более 50 (как при запуске оркестратора).
// СнимокПолнойТЧ - Структура, Неопределено - снимок с ТЧ NDFL_RDU_ИмяТЧПарДляПараллельногоНДФЛ(); при Неопределено — деление только по ИндексыСтрок (совместимость).
//
// Возвращаемое значение:
// Массив из Массив - по элементу на непустую пачку; внутренний массив — номера строк ТЧ. Меньше двух строк в ИндексыСтрок — одна пачка (K не используется).
//
Функция NDFL_RDU_РазбитьСтрокиНаПачки(ИндексыСтрок, КоличествоПачекПользователя, СнимокПолнойТЧ = Неопределено)
	
	K = Макс(1, Цел(КоличествоПачекПользователя));
	K = Мин(K, 50);
	
	Если ИндексыСтрок.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Если ИндексыСтрок.Количество() < 2 Тогда
		Возврат NDFL_RDU_МассивПачекОднаКопияИндексовСтрок(ИндексыСтрок);
	КонецЕсли;
	
	ИмяТЧПар = NDFL_RDU_ИмяТЧПарДляПараллельногоНДФЛ();
	ТаблицаПарПолная = Неопределено;
	Если СнимокПолнойТЧ = Неопределено
		Или Не СнимокПолнойТЧ.Свойство(ИмяТЧПар, ТаблицаПарПолная)
		Или ТаблицаПарПолная = Неопределено Тогда
		
		Результат = Новый Массив;
		ЧислоСтрок = ИндексыСтрок.Количество();
		БазовыйРазмер = Цел(ЧислоСтрок / K);
		Остаток = ЧислоСтрок - БазовыйРазмер * K;
		ТекущийИндекс = 0;
		Для НомерОкна = 1 По K Цикл
			РазмерПачки = БазовыйРазмер + ?(НомерОкна <= Остаток, 1, 0);
			Если РазмерПачки <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Пачка = Новый Массив;
			Для Сч = 1 По РазмерПачки Цикл
				Если ТекущийИндекс >= ИндексыСтрок.Количество() Тогда
					Прервать;
				КонецЕсли;
				Пачка.Добавить(ИндексыСтрок[ТекущийИндекс]);
				ТекущийИндекс = ТекущийИндекс + 1;
			КонецЦикла;
			Если Пачка.Количество() > 0 Тогда
				Результат.Добавить(Пачка);
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
		
	КонецЕсли;
	
	ТаблицаДат = ТаблицаПарПолная;
	
	ПервыйНомер = ИндексыСтрок[0];
	МинНомерСтроки = ПервыйНомер;
	МаксНомерСтроки = ПервыйНомер;
	Для Индекс = 1 По ИндексыСтрок.Количество() - 1 Цикл
		НомерСтроки = ИндексыСтрок[Индекс];
		Если НомерСтроки < МинНомерСтроки Тогда
			МинНомерСтроки = НомерСтроки;
		КонецЕсли;
		Если НомерСтроки > МаксНомерСтроки Тогда
			МаксНомерСтроки = НомерСтроки;
		КонецЕсли;
	КонецЦикла;
	
	ДиапазонНомеров = МаксНомерСтроки - МинНомерСтроки + 1;
	Если МаксНомерСтроки <= 0 Или ДиапазонНомеров <= 0 Тогда
		Возврат NDFL_RDU_МассивПачекОднаКопияИндексовСтрок(ИндексыСтрок);
	КонецЕсли;
	
	РазмерОкна = Цел((ДиапазонНомеров + K - 1) / K);
	Если РазмерОкна <= 0 Тогда
		РазмерОкна = 1;
	КонецЕсли;
	
	БуферПоОкнам = Новый Массив;
	Для СчетИнициализацииОкна = 1 По K Цикл
		БуферПоОкнам.Добавить(Новый Массив);
	КонецЦикла;
	
	Для Каждого НомерСтроки Из ИндексыСтрок Цикл
		СмещениеОтМинимума = НомерСтроки - МинНомерСтроки;
		ИндексОкна = Цел(СмещениеОтМинимума / РазмерОкна) + 1;
		Если ИндексОкна > K Тогда
			ИндексОкна = K;
		КонецЕсли;
		БуферПоОкнам[ИндексОкна - 1].Добавить(НомерСтроки);
	КонецЦикла;
	
	ПачкиПоОкнам = Новый Массив;
	Для СчетСборкиОкна = 0 По K - 1 Цикл
		Если БуферПоОкнам[СчетСборкиОкна].Количество() > 0 Тогда
			ПачкиПоОкнам.Добавить(БуферПоОкнам[СчетСборкиОкна]);
		КонецЕсли;
	КонецЦикла;
	
	NDFL_RDU_СлитьСоседниеПачкиПоОбщемуКлиенту(ПачкиПоОкнам, ТаблицаДат);
	
	Если ПачкиПоОкнам.Количество() = 0 Тогда
		Возврат NDFL_RDU_МассивПачекОднаКопияИндексовСтрок(ИндексыСтрок);
	КонецЕсли;
	
	Возврат ПачкиПоОкнам;
	
КонецФункции

// IMDEV-7330-5 Сливает соседние пачки при общем клиенте на границе; одна карта НомерСтроки -> Клиент на всю ТЧ.
//
// Параметры:
// ПачкиПоОкнам - Массив - элементы: массивы номеров строк; изменяется на месте.
// ТаблицаДат - ТаблицаЗначений - полная ТЧ из снимка.
//
Процедура NDFL_RDU_СлитьСоседниеПачкиПоОбщемуКлиенту(ПачкиПоОкнам, ТаблицаДат)
	
	Если ПачкиПоОкнам.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	НомерСтрокиВКлиент = Новый Соответствие;
	Для Каждого СтрКарта Из ТаблицаДат Цикл
		НомерСтрокиВКлиент.Вставить(СтрКарта.НомерСтроки, СтрКарта.Клиент);
	КонецЦикла;
	
	Изменилось = Истина;
	Пока Изменилось Цикл
		Изменилось = Ложь;
		Инд = 0;
		Пока Инд < ПачкиПоОкнам.Количество() - 1 Цикл
			
			КлиентыЛевойПачки = Новый Соответствие;
			Для Каждого НомЛев Из ПачкиПоОкнам[Инд] Цикл
				КлиЛев = НомерСтрокиВКлиент.Получить(НомЛев);
				Если КлиЛев <> Неопределено Тогда
					КлиентыЛевойПачки.Вставить(КлиЛев, Истина);
				КонецЕсли;
			КонецЦикла;
			
			ЕстьОбщийКлиент = Ложь;
			Для Каждого НомПрав Из ПачкиПоОкнам[Инд + 1] Цикл
				КлиПрав = НомерСтрокиВКлиент.Получить(НомПрав);
				Если КлиПрав <> Неопределено И КлиентыЛевойПачки.Получить(КлиПрав) <> Неопределено Тогда
					ЕстьОбщийКлиент = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьОбщийКлиент Тогда
				Для Каждого Ном Из ПачкиПоОкнам[Инд + 1] Цикл
					ПачкиПоОкнам[Инд].Добавить(Ном);
				КонецЦикла;
				ПачкиПоОкнам.Удалить(Инд + 1);
				Изменилось = Истина;
			Иначе
				Инд = Инд + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// IMDEV-7330-5 Заполняет объект воркера из параметров одной пачки: шапка, строки ТЧ «ДатыДокументов», обнуление НомерСтрокиС/По в шапке.
// IMDEV-7330-5 В СтрокиДатыДокументов — вырезка из полной выгрузки по отбору строк пачки; колонку НомерСтроки в объект ТЧ не переносят (платформа нумерует сама).
//
// Параметры:
// ОбъектОбработки - ОбработкаОбъект.ФормированиеНачисленийНДФЛ - целевой экземпляр воркера.
// ПараметрыПачки - Структура - данные пачки (Шапка, СтрокиДатыДокументов, адреса ВХ; см. NDFL_RDU_ПодготовитьПараметрыПачки).
//
Процедура NDFL_RDU_ЗаполнитьОбработкуИзПараметровПачки(ОбъектОбработки, ПараметрыПачки) Экспорт
	
	Шапка = Неопределено;
	Если Не ПараметрыПачки.Свойство("Шапка", Шапка) Или Шапка = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'NDFL_RDU: в параметрах пачки нет шапки (Шапка).'");
	КонецЕсли;
	
	NDFL_RDU_ЗаполнитьОбъектОбработкиИзСнимка(ОбъектОбработки, Шапка);
	
	СтрокиДатыДокументов = Неопределено;
	Если Не ПараметрыПачки.Свойство("СтрокиДатыДокументов", СтрокиДатыДокументов)
		Или СтрокиДатыДокументов = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'NDFL_RDU: в параметрах пачки нет таблицы СтрокиДатыДокументов.'");
	КонецЕсли;
	
	ИмяТЧПар = NDFL_RDU_ИмяТЧПарДляПараллельногоНДФЛ();
	ОбъектОбработки[ИмяТЧПар].Очистить();
	Для Каждого Стр Из СтрокиДатыДокументов Цикл
		НоваяСтрока = ОбъектОбработки[ИмяТЧПар].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр, , "НомерСтроки");
	КонецЦикла;
	
	ОбъектОбработки.НомерСтрокиС = 0;
	ОбъектОбработки.НомерСтрокиПо = 0;
	
КонецПроцедуры

// IMDEV-7330-5 Сшивка только табличных документов логов пачек в один итоговый табличный документ для формы.
//           Поле СписокСообщений в структурах результатов пачек здесь не обрабатывается (в итог не входит).
//
// Параметры:
// РезультатыПачек - Массив - структуры результатов пачек (ожидается ТабличныйДокумент в каждой).
//
// Возвращаемое значение:
// Структура - поле ТабличныйДокумент: объединённый лог (остальные поля пачки не переносятся).
//
Функция NDFL_RDU_СшитьРезультатыПачекФормированияНДФЛ(РезультатыПачек)
	
	ИтогТаб = Новый ТабличныйДокумент;
	
	Для Каждого Рез Из РезультатыПачек Цикл
		Если Рез = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТД = Неопределено;
		Если Рез.Свойство("ТабличныйДокумент", ТД) И ТД <> Неопределено Тогда
			ИтогТаб.Вывести(ТД);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("ТабличныйДокумент", ИтогТаб);
	
КонецФункции

// IMDEV-7330-5 Служебная подготовка структуры параметров одной пачки для передачи во воркер.
//
// Параметры:
// ИсходныйСнимок - Структура - полный снимок обработки с формы.
// НомерПачки - Число - индекс пачки с 1.
// ВсегоПачек - Число - число пачек.
// СтрокиПачки - Массив - номера строк исходной ТЧ, входящие в пачку.
// ИдентификаторФормы - УникальныйИдентификатор - владелец ВХ.
// АдресПрогресса - Строка - адрес общей структуры прогресса (опционально).
//
// Возвращаемое значение:
// Структура - параметры для воркера NDFL_RDU_ВыполнитьПачкуФормированияНДФЛ (модуль объекта обработки, сериализация в XML).
//
Функция NDFL_RDU_ПодготовитьПараметрыПачки(ИсходныйСнимок, НомерПачки, ВсегоПачек, СтрокиПачки, ИдентификаторФормы,
	АдресПрогресса = "")
	
	ТаблицаИсходная = Неопределено;
	ИмяТЧПарДляПачки = NDFL_RDU_ИмяТЧПарДляПараллельногоНДФЛ();
	Если Не ИсходныйСнимок.Свойство(ИмяТЧПарДляПачки, ТаблицаИсходная) Тогда
		ТаблицаИсходная = Неопределено;
	КонецЕсли;
	Если ТаблицаИсходная = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'NDFL_RDU: в полном снимке отсутствует табличная часть для пачек (ожидается ДатыДокументов).'");
	КонецЕсли;
	
	ОтборНомеров = Новый Соответствие;
	Для Каждого Ном Из СтрокиПачки Цикл
		ОтборНомеров.Вставить(Ном, Истина);
	КонецЦикла;
	
	СтрокиДатыДокументов = ТаблицаИсходная.СкопироватьКолонки();
	Для Каждого Стр Из ТаблицаИсходная Цикл
		Если ОтборНомеров.Получить(Стр.НомерСтроки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Новая = СтрокиДатыДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Стр);
	КонецЦикла;
	
	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("АдресПрогресса", АдресПрогресса);
	ПараметрыЗапуска.Вставить("ИдентификаторФормы", ИдентификаторФормы);
	
	Шапка = NDFL_RDU_КлонироватьСнимок(ИсходныйСнимок);
	
	Результат = Новый Структура;
	Результат.Вставить("НомерПачки", НомерПачки);
	Результат.Вставить("ВсегоПачек", ВсегоПачек);
	Результат.Вставить("Шапка", Шапка);
	Результат.Вставить("СтрокиДатыДокументов", СтрокиДатыДокументов);
	Результат.Вставить("ПараметрыЗапуска", ПараметрыЗапуска);
	Результат.Вставить("ИдентификаторФормы", ИдентификаторФормы);
	Результат.Вставить("АдресРезультатаПачки", ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы));
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
