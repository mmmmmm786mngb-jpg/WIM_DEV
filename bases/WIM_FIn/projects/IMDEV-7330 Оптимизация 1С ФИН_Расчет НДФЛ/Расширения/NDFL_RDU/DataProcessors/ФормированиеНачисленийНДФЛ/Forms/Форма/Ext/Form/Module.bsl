#Область IMDEV7330_ПараллельноеФормированиеНДФЛ_Форма

// IMDEV-7330-П Модуль заимствованной формы обработки ФормированиеНачисленийНДФЛ: клиент/сервер формы, БСП ДлительныеОперации.
// IMDEV-7330-П ТЗ: Документация/imdev7330_ndfl_longops_n_batches_spec.html; план внедрения: imdev7330_parallel_ndfl_implementation_plan.md.
// IMDEV-7330-П Размещение логики по модулям:
// IMDEV-7330-П   форма (эта область) - подготовка параметров ДО, упаковка в XML (NDFL_RDU_ДанныеВXML менеджера), ДлительныеОперации.ВыполнитьВФоне,
// IMDEV-7330-П     строка метода: Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ОркестраторФормированияНДФЛ (вход: структура с полем ПараметрыXML);
// IMDEV-7330-П   ManagerModule.bsl - оркестратор, воркер, разбиение на пачки, сшивка лога (п. 5.2 ТЗ);
// IMDEV-7330-П   ObjectModule.bsl - перехват NDFL_RDU_СоздатьДокументы и кэш (без логики параллельности в теле перехвата).
// IMDEV-7330-П Комментарии по параллельному режиму - префикс // IMDEV-7330-П
//
// IMDEV-7330-П Перехват команды «Создать документы»: &Вместо("СоздатьДокументы"), процедура NDFL_RDU_СоздатьДокументы — иное имя, чтобы не дублировать базовую СоздатьДокументы при слиянии модулей.

#Область ОбработчикиКомандФормы

// Описание: Вместо типовой СоздатьДокументы — запуск длительной операции оркестратора (п. 5.2 ТЗ), без вызова СоздатьДокументыНаСервере из формы.
//
// Параметры:
// Команда - КомандаФормы - стандартный параметр обработчика команды.
//
&НаКлиенте
&Вместо("СоздатьДокументы")
Процедура NDFL_RDU_СоздатьДокументы(Команда)
	
	Если Объект.СоздаватьОплатуНДФЛ И Не ЗначениеЗаполнено(Объект.СчетДляОплатыНалогов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен счет для оплаты налогов");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Запуск формирования начислений НДФЛ...'"));
	
	РезультатЗапуска = NDFL_RDU_ЗапуститьПараллельноеФормированиеНаСервере();
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	NDFL_RDU_НачатьОжиданиеПараллельногоФормирования(РезультатЗапуска);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Запускает длительную операцию БСП на менеджере обработки: снимок реквизита «Объект» и идентификатор формы
// передаются в оркестратор в одной XML-строке (поле ПараметрыXML структуры вызова), распаковка — в NDFL_RDU_ОркестраторФормированияНДФЛ.
// Адрес результата ДО задаётся явно (ПараметрыВыполнения.АдресРезультата), как в форме РегламентныйПериод справочника РегламентныеПериоды (Wim_Du).
//
// Параметры:
// Нет.
//
// Возвращаемое значение:
// Структура, Неопределено - результат ДлительныеОперации.ВыполнитьВФоне (поля Статус, АдресРезультата и др.) либо Неопределено при ошибке подготовки.
//
// Пример:
// Результат = NDFL_RDU_ЗапуститьПараллельноеФормированиеНаСервере();
//
&НаСервере
Функция NDFL_RDU_ЗапуститьПараллельноеФормированиеНаСервере()
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Снимок = Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_СнимокОбъектаОбработки(ОбъектОбработки);
	
	ПараметрыОркестратора = Новый Структура;
	ПараметрыОркестратора.Вставить("Снимок", Снимок);
	ПараметрыОркестратора.Вставить("ИдентификаторФормы", УникальныйИдентификатор);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ПараметрыXML", Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеВXML(ПараметрыОркестратора));
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'IMDEV-7330: формирование начислений НДФЛ'");
	ПараметрыВыполнения.КлючФоновогоЗадания = "NDFL_RDU_" + Строка(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ОркестраторФормированияНДФЛ",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
КонецФункции

// Описание: Клиентское ожидание завершения длительной операции с окном БСП и оповещением о результате.
//
// Параметры:
// РезультатЗапуска - Структура - значение, возвращаемое NDFL_RDU_ЗапуститьПараллельноеФормированиеНаСервере.
//
// Пример:
// NDFL_RDU_НачатьОжиданиеПараллельногоФормирования(РезультатЗапуска);
//
&НаКлиенте
Процедура NDFL_RDU_НачатьОжиданиеПараллельногоФормирования(РезультатЗапуска)
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		NDFL_RDU_ОбработатьРезультатПараллельногоФормирования(РезультатЗапуска, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Ошибка" Тогда
		NDFL_RDU_ПоказатьОшибкуЗапускаДлительнойОперации(РезультатЗапуска);
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("NDFL_RDU_ОбработатьРезультатПараллельногоФормирования", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗапуска, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

// Описание: Оповещение завершения ДО: читает итог из ВХ, показывает лог, обновляет реквизит «Объект» формы при успехе.
//
// Параметры:
// Результат - Структура, Неопределено - результат из ДлительныеОперацииКлиент.ОжидатьЗавершение.
// ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура NDFL_RDU_ОбработатьРезультатПараллельногоФормирования(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		NDFL_RDU_ПоказатьОшибкуЗапускаДлительнойОперации(Результат);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Отменено" Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Формирование начислений НДФЛ отменено.'"));
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус <> "Выполнено" Тогда
		Возврат;
	КонецЕсли;
	
	АдресРезультата = "";
	Если Не Результат.Свойство("АдресРезультата", АдресРезультата) Или Не ЗначениеЗаполнено(АдресРезультата) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не получен адрес результата длительной операции.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Результат длительной операции: некорректный адрес временного хранилища.'"));
		Возврат;
	КонецЕсли;
	
	Итог = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если Итог = Неопределено Или ТипЗнч(Итог) <> Тип("Структура") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Результат длительной операции недоступен.'"));
		Возврат;
	КонецЕсли;
	
	Успешно = Истина;
	Итог.Свойство("Успешно", Успешно);
	
	ТекстДиагностики = "";
	Итог.Свойство("ТекстДиагностики", ТекстДиагностики);
	
	ЧастичныйУспех = Ложь;
	Итог.Свойство("ЧастичныйУспех", ЧастичныйУспех);
	
	ТабличныйДокумент = Неопределено;
	Если Не Итог.Свойство("ТабличныйДокумент", ТабличныйДокумент) Или ТипЗнч(ТабличныйДокумент) <> Тип("ТабличныйДокумент") Тогда
		АдресТабличногоДокумента = "";
		Если Итог.Свойство("АдресТабличногоДокумента", АдресТабличногоДокумента) И ЗначениеЗаполнено(АдресТабличногоДокумента)
			И ЭтоАдресВременногоХранилища(АдресТабличногоДокумента) Тогда
			ТабличныйДокумент = ПолучитьИзВременногоХранилища(АдресТабличногоДокумента);
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
		ТабличныйДокумент.Показать(НСтр("ru = 'Лог формирования начислений НДФЛ'"));
	КонецЕсли;
	
	АдресСнимкаОбъекта = "";
	Если Итог.Свойство("АдресСнимкаОбъекта", АдресСнимкаОбъекта) И ЗначениеЗаполнено(АдресСнимкаОбъекта) Тогда
		NDFL_RDU_ПрименитьСнимокОбъектаКФормеНаСервере(АдресСнимкаОбъекта);
	КонецЕсли;
	
	Если Не Успешно Или ЧастичныйУспех Тогда
		ТекстПредупреждения = ?(ЗначениеЗаполнено(ТекстДиагностики), ТекстДиагностики,
			НСтр("ru = 'Формирование НДФЛ завершено с предупреждениями или ошибками пачек.'"));
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;
	
	ОбновитьКоличествоСтрок();
	
КонецПроцедуры

// Описание: Загружает снимок обработки из ВХ в реквизит формы «Объект».
//
// Параметры:
// АдресСнимкаОбъекта - Строка - адрес во временном хранилище со структурой снимка.
//
&НаСервере
Процедура NDFL_RDU_ПрименитьСнимокОбъектаКФормеНаСервере(Знач АдресСнимкаОбъекта)
	
	Если Не ЗначениеЗаполнено(АдресСнимкаОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	Снимок = ПолучитьИзВременногоХранилища(АдресСнимкаОбъекта);
	Если Снимок = Неопределено Или ТипЗнч(Снимок) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ЗаполнитьОбъектОбработкиИзСнимка(ОбъектОбработки, Снимок);
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура NDFL_RDU_ПоказатьОшибкуЗапускаДлительнойОперации(РезультатЗапуска)
	
	ТекстОшибки = РезультатЗапуска.КраткоеПредставлениеОшибки;
	Если ЗначениеЗаполнено(РезультатЗапуска.ПодробноеПредставлениеОшибки) Тогда
		ТекстОшибки = РезультатЗапуска.ПодробноеПредставлениеОшибки;
	КонецЕсли;
	ПоказатьПредупреждение(, ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
