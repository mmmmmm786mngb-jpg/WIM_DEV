#Область IMDEV7330_ПараллельноеФормированиеНДФЛ_Форма

// IMDEV-7330 Модуль формы обработки «ФормированиеНачисленийНДФЛ» (расширение конфигурации NDFL_RDU).
//
// IMDEV-7330 Назначение:
//   Запуск и ожидание завершения длительной операции формирования начислений НДФЛ по команде «Создать документы»;
//   обмен с сервером через БСП «Длительные операции» (параметры в XML, результат во временном хранилище).
//
// IMDEV-7330 Размещение логики: снимок, оркестратор, разбиение на пачки и сшивка - модуль менеджера обработки;
//   воркер пачки и перехват типовой СоздатьДокументы - модуль объекта обработки.
//
// IMDEV-7330 Документация: Документация/imdev7330_ndfl_longops_n_batches_spec.html.

#Область ОбработчикиКомандФормы

// IMDEV-7330 Описание: Вместо типовой СоздатьДокументы - запуск длительной операции оркестратора (п. 5.2 ТЗ).
&НаКлиенте
&Вместо("СоздатьДокументы")
Процедура NDFL_RDU_СоздатьДокументы(Команда)
	
	Если Объект.СоздаватьОплатуНДФЛ И Не ЗначениеЗаполнено(Объект.СчетДляОплатыНалогов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен счет для оплаты налогов");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Запуск формирования начислений НДФЛ...'"));
	
	РезультатЗапуска = NDFL_RDU_ЗапуститьПараллельноеФормированиеНаСервере();
	Если РезультатЗапуска <> Неопределено Тогда
		NDFL_RDU_НачатьОжиданиеПараллельногоФормирования(РезультатЗапуска);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// IMDEV-7330 Описание: Запускает длительную операцию БСП на менеджере обработки.
&НаСервере
Функция NDFL_RDU_ЗапуститьПараллельноеФормированиеНаСервере()
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Снимок = Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_СнимокОбъектаОбработки(ОбъектОбработки);
	
	ПараметрыОркестратора = Новый Структура;
	ПараметрыОркестратора.Вставить("Снимок", Снимок);
	ПараметрыОркестратора.Вставить("ИдентификаторФормы", УникальныйИдентификатор);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ПараметрыXML",
		Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеВXML(ПараметрыОркестратора));
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'IMDEV-7330: формирование начислений НДФЛ'");
	ПараметрыВыполнения.КлючФоновогоЗадания = "NDFL_RDU_" + Строка(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ОркестраторФормированияНДФЛ",
		ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

// IMDEV-7330 Описание: Клиентское ожидание завершения длительной операции с окном БСП.
&НаКлиенте
Процедура NDFL_RDU_НачатьОжиданиеПараллельногоФормирования(РезультатЗапуска)
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.Статус = "Выполнено" Или РезультатЗапуска.Статус = "Ошибка" Тогда
		NDFL_RDU_ОбработатьРезультатПараллельногоФормирования(РезультатЗапуска, Неопределено);
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"NDFL_RDU_ОбработатьРезультатПараллельногоФормирования", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗапуска, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

// IMDEV-7330 Описание: Основной обработчик завершения длительной операции.
&НаКлиенте
Процедура NDFL_RDU_ОбработатьРезультатПараллельногоФормирования(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		NDFL_RDU_ПоказатьОшибкуЗапускаДлительнойОперации(Результат);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Отменено" Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Формирование начислений НДФЛ отменено.'"));
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус <> "Выполнено" Тогда
		Возврат;
	КонецЕсли;
	
	АдресРезультата = NDFL_RDU_АдресРезультатаДлительнойОперации(Результат);
	Если Не ЗначениеЗаполнено(АдресРезультата) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Результат длительной операции недоступен.'"));
		Возврат;
	КонецЕсли;
	
	РезультатНаКлиенте = NDFL_RDU_ОбработатьИтогДлительнойОперацииНаСервере(АдресРезультата, Истина);
	Если РезультатНаКлиенте = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Результат длительной операции недоступен.'"));
		Возврат;
	КонецЕсли;
	
	NDFL_RDU_ПоказатьТабличныйДокументЛогаПоАдресу(РезультатНаКлиенте.АдресТабличногоДокумента);
	
	// Вывод итогового сообщения
	Успешно = Истина;
	ЧастичныйУспех = Ложь;
	ТекстДиагностики = "";
	РезультатНаКлиенте.Свойство("Успешно", Успешно);
	РезультатНаКлиенте.Свойство("ЧастичныйУспех", ЧастичныйУспех);
	РезультатНаКлиенте.Свойство("ТекстДиагностики", ТекстДиагностики);
	
	Если Не Успешно Или ЧастичныйУспех Или ЗначениеЗаполнено(ТекстДиагностики) Тогда
		ТекстПредупреждения = ?(ЗначениеЗаполнено(ТекстДиагностики), ТекстДиагностики,
			НСтр("ru = 'Формирование НДФЛ завершено с предупреждениями или ошибками пачек.'"));
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;
	
	ОбновитьКоличествоСтрок();
	
КонецПроцедуры

// IMDEV-7330 Описание: Загружает снимок обработки в реквизит формы «Объект».
&НаСервере
Процедура NDFL_RDU_ПрименитьСнимокОбъектаКФормеНаСервере(Знач Итог)
	
	Если Итог = Неопределено Или ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СнимокОбъектаПосле = Неопределено;
	Если Итог.Свойство("СнимокОбъектаПосле", СнимокОбъектаПосле)
		И ТипЗнч(СнимокОбъектаПосле) = Тип("Структура") Тогда
		
		ОбъектОбработки = РеквизитФормыВЗначение("Объект");
		Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ЗаполнитьОбъектОбработкиИзСнимка(
			ОбъектОбработки, СнимокОбъектаПосле);
		ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	КонецЕсли;
	
КонецПроцедуры

// IMDEV-7330 Описание: Достаёт из структуры результата БСП адрес ВХ с итогом оркестратора (только строка, без чтения ВХ на клиенте).
//
// Параметры:
// РезультатДО - Структура - результат ДлительныеОперации (ожидание завершения).
//
// Возвращаемое значение:
// Строка - адрес временного хранилища; пустая строка, если адреса нет.
//
&НаКлиенте
Функция NDFL_RDU_АдресРезультатаДлительнойОперации(РезультатДО)
	
	АдресРезультата = "";
	Если РезультатДО = Неопределено Или ТипЗнч(РезультатДО) <> Тип("Структура") Тогда
		Возврат АдресРезультата;
	КонецЕсли;
	
	Если Не РезультатДО.Свойство("АдресРезультата", АдресРезультата)
		Или Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат АдресРезультата;
	
КонецФункции

// IMDEV-7330 Описание: На сервере читает итог из ВХ, разбирает XML (или старую структуру), применяет снимок к объекту формы;
// в ответ на клиент отдаёт только сериализуемые поля и отдельный адрес ВХ с табличным документом лога (без ТаблицаЗначений в снимке на клиенте).
//
// Параметры:
// АдресРезультата - Строка - адрес во временном хранилище, куда оркестратор поместил XML итога.
// ПрименятьСнимок - Булево - если Истина, заполнить реквизит формы «Объект» из СнимокОбъектаПосле; если Ложь (ошибка ДО), только диагностика и лог.
//
// Возвращаемое значение:
// Структура - Успешно, ЧастичныйУспех, ТекстДиагностики, АдресТабличногоДокумента; Неопределено при невозможности прочитать итог.
//
&НаСервере
Функция NDFL_RDU_ОбработатьИтогДлительнойОперацииНаСервере(Знач АдресРезультата, Знач ПрименятьСнимок)
	
	Если Не ЗначениеЗаполнено(АдресРезультата) Или Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначениеВХ = ПолучитьИзВременногоХранилища(АдресРезультата);
	Итог = Неопределено;
	
	Если ТипЗнч(ЗначениеВХ) = Тип("Строка") И ЗначениеЗаполнено(ЗначениеВХ) Тогда
		Попытка
			Итог = Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеИзXML(ЗначениеВХ);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	ИначеЕсли ТипЗнч(ЗначениеВХ) = Тип("Структура") Тогда
		Итог = ЗначениеВХ;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если Итог = Неопределено Или ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПрименятьСнимок Тогда
		NDFL_RDU_ПрименитьСнимокОбъектаКФормеНаСервере(Итог);
	КонецЕсли;
	
	Успешно = Истина;
	ЧастичныйУспех = Ложь;
	ТекстДиагностики = "";
	Итог.Свойство("Успешно", Успешно);
	Итог.Свойство("ЧастичныйУспех", ЧастичныйУспех);
	Итог.Свойство("ТекстДиагностики", ТекстДиагностики);
	
	АдресТабличногоДокумента = "";
	ТабличныйДокумент = Неопределено;
	Если Итог.Свойство("ТабличныйДокумент", ТабличныйДокумент)
		И ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
		АдресТабличногоДокумента = ПоместитьВоВременноеХранилище(ТабличныйДокумент, УникальныйИдентификатор);
	Иначе
		АдресИзИтога = "";
		Если Итог.Свойство("АдресТабличногоДокумента", АдресИзИтога)
			И ЭтоАдресВременногоХранилища(АдресИзИтога) Тогда
			АдресТабличногоДокумента = АдресИзИтога;
		КонецЕсли;
	КонецЕсли;
	
	РезультатНаКлиенте = Новый Структура;
	РезультатНаКлиенте.Вставить("Успешно", Успешно);
	РезультатНаКлиенте.Вставить("ЧастичныйУспех", ЧастичныйУспех);
	РезультатНаКлиенте.Вставить("ТекстДиагностики", ТекстДиагностики);
	РезультатНаКлиенте.Вставить("АдресТабличногоДокумента", АдресТабличногоДокумента);
	
	Возврат РезультатНаКлиенте;
	
КонецФункции

// IMDEV-7330 Описание: Показывает табличный документ лога по адресу во временном хранилище (получение на клиенте).
//
// Параметры:
// АдресТабличногоДокумента - Строка - адрес ВХ с ТабличныйДокумент.
//
&НаКлиенте
Процедура NDFL_RDU_ПоказатьТабличныйДокументЛогаПоАдресу(АдресТабличногоДокумента)
	
	Если Не ЗначениеЗаполнено(АдресТабличногоДокумента)
		Или Не ЭтоАдресВременногоХранилища(АдресТабличногоДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент = ПолучитьИзВременногоХранилища(АдресТабличногоДокумента);
	Если ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
		ТабличныйДокумент.Показать(НСтр("ru = 'Лог формирования начислений НДФЛ'"));
	КонецЕсли;
	
КонецПроцедуры

// IMDEV-7330 Описание: Обработка ошибки запуска длительной операции.
&НаКлиенте
Процедура NDFL_RDU_ПоказатьОшибкуЗапускаДлительнойОперации(РезультатЗапуска)
	
	АдресРезультата = NDFL_RDU_АдресРезультатаДлительнойОперации(РезультатЗапуска);
	Если ЗначениеЗаполнено(АдресРезультата) Тогда
		РезультатНаКлиенте = NDFL_RDU_ОбработатьИтогДлительнойОперацииНаСервере(АдресРезультата, Ложь);
		Если РезультатНаКлиенте <> Неопределено Тогда
			NDFL_RDU_ПоказатьТабличныйДокументЛогаПоАдресу(РезультатНаКлиенте.АдресТабличногоДокумента);
		КонецЕсли;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если РезультатЗапуска <> Неопределено И ТипЗнч(РезультатЗапуска) = Тип("Структура") Тогда
		
		РезультатЗапуска.Свойство("КраткоеПредставлениеОшибки", ТекстОшибки);
		Подробно = "";
		Если РезультатЗапуска.Свойство("ПодробноеПредставлениеОшибки", Подробно)
			И ЗначениеЗаполнено(Подробно) Тогда
			ТекстОшибки = Подробно;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		ТекстОшибки = НСтр("ru = 'Длительная операция завершилась с ошибкой.'");
	КонецЕсли;
	
	ПоказатьПредупреждение(, ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
