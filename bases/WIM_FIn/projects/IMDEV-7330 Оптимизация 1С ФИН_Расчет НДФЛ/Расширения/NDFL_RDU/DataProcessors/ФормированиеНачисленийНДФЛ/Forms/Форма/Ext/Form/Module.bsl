#Область IMDEV7330_ПараллельноеФормированиеНДФЛ_Форма

// IMDEV-7330-5 Модуль формы обработки «ФормированиеНачисленийНДФЛ» (расширение конфигурации NDFL_RDU). П.5 плана оптимизации.
//
// Назначение:
//   Запуск и ожидание завершения длительной операции формирования начислений НДФЛ
//   по команде «Создать документы» через механизм БСП «Длительные операции».
//
// Размещение логики:
//   - Оркестратор, разбиение на пачки, сшивка - модуль менеджера обработки.
//   - Воркер пачки и перехват СоздатьДокументы - модуль объекта обработки.
//
// Документация: Документация/imdev7330_ndfl_longops_n_batches_spec.html.

#Область ОбработчикиКомандФормы

// IMDEV-7330-5 Замена типовой процедуры СоздатьДокументы (п.5 плана: параллельное формирование через ДО БСП).
// Параллельная ДО не используется, если константа NDFL_RDU_ЧислоПараллельныхПачекФормированияНДФЛ = 0
// или на форме заполнен отбор «Клиент» (Объект.Клиент) — тогда синхронный вызов как в типовой форме;
// иначе длительная операция формирования начислений НДФЛ.
//
&НаКлиенте
&Вместо("СоздатьДокументы")
Процедура NDFL_RDU_СоздатьДокументы(Команда)
	
	Если Объект.СоздаватьОплатуНДФЛ И Не ЗначениеЗаполнено(Объект.СчетДляОплатыНалогов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен счет для оплаты налогов");
	ИначеЕсли ПроверитьЗаполнение() Тогда
		
		МоментСтартаСозданияДокументовМС = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		Если Не NDFL_RDU_ИспользоватьПараллельноеФормированиеНДФЛНаКлиенте() Тогда
			
			ТабличныйДокумент = Новый ТабличныйДокумент;
			СоздатьДокументыНаСервере(ТабличныйДокумент);
			ТабличныйДокумент.Показать("Лог формирования начислений НДФЛ");
			NDFL_RDU_СообщитьЗавершениеСозданияДокументовСРасчетомДлительности(МоментСтартаСозданияДокументовМС);
			
		Иначе
			
			Состояние(НСтр("ru = 'Запуск формирования начислений НДФЛ...'"));
			
			РезультатЗапуска = NDFL_RDU_ЗапуститьПараллельноеФормированиеНаСервере();
			Если РезультатЗапуска <> Неопределено Тогда
				NDFL_RDU_НачатьОжидание(РезультатЗапуска, МоментСтартаСозданияДокументовМС);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// IMDEV-7330-5 Описание: Читает константу расширения числа параллельных пачек (K). 0 — отключение параллельного режима на форме.
//
// Возвращаемое значение:
//   Число - значение константы NDFL_RDU_ЧислоПараллельныхПачекФормированияНДФЛ.
//
&НаСервереБезКонтекста
Функция NDFL_RDU_ЧислоПараллельныхПачекФормированияНДФЛНаСервере()
	
	Возврат Константы.NDFL_RDU_ЧислоПараллельныхПачекФормированияНДФЛ.Получить();
	
КонецФункции

// IMDEV-7330-5 Описание: Разрешено ли параллельное формирование (ДО БСП) с точки зрения формы.
//
// Возвращаемое значение:
//   Булево - Истина, если константа K > 0 и реквизит «Клиент» не заполнен; иначе Ложь (синхронный расчёт).
//
&НаКлиенте
Функция NDFL_RDU_ИспользоватьПараллельноеФормированиеНДФЛНаКлиенте()
	
	Результат = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Клиент) Тогда
		Результат = NDFL_RDU_ЧислоПараллельныхПачекФормированияНДФЛНаСервере() > 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// IMDEV-7330-5 Описание: Запускает на сервере длительную операцию оркестратора параллельного формирования НДФЛ (БСП).
//
// Возвращаемое значение:
//   Структура - результат ДлительныеОперации.ВыполнитьВФоне.
//
&НаСервере
Функция NDFL_RDU_ЗапуститьПараллельноеФормированиеНаСервере()
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Снимок = Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_СнимокОбъектаОбработки(ОбъектОбработки);
	
	ПараметрыОркестратора = Новый Структура;
	ПараметрыОркестратора.Вставить("Снимок", Снимок);
	ПараметрыОркестратора.Вставить("ИдентификаторФормы", УникальныйИдентификатор);
	
	ПараметрыПроцедуры = Новый Структура(
		"ПараметрыXML",
		Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеВXML(ПараметрыОркестратора));
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'IMDEV-7330: формирование начислений НДФЛ'");
	ПараметрыВыполнения.КлючФоновогоЗадания = "NDFL_RDU_" + Строка(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ОркестраторФормированияНДФЛ",
		ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

// IMDEV-7330-5 Описание: Подключает на клиенте ожидание завершения длительной операции (БСП, окно прогресса).
//
// Параметры:
//   МоментСтартаСозданияДокументовМС - Число - ТекущаяУниверсальнаяДатаВМиллисекундах() на момент команды «Создать документы» (для замера длительности).
//
&НаКлиенте
Процедура NDFL_RDU_НачатьОжидание(РезультатЗапуска, МоментСтартаСозданияДокументовМС)
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗамера = Новый Структура("МоментСтартаСозданияДокументовМС", МоментСтартаСозданияДокументовМС);
	
	// IMDEV-7330-5 Синхронное завершение ДО до подключения ожидания — сразу обрабатываем результат.
	Если РезультатЗапуска.Статус = "Выполнено" Или РезультатЗапуска.Статус = "Ошибка" Тогда
		NDFL_RDU_ОбработатьРезультат(РезультатЗапуска, ПараметрыЗамера);
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	Оповещение = Новый ОписаниеОповещения("NDFL_RDU_ОбработатьРезультат", ЭтотОбъект, ПараметрыЗамера);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗапуска, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

// IMDEV-7330-5 Описание: Обработчик завершения длительной операции (оповещение БСП ДлительныеОперацииКлиент).
//
// Параметры:
//   Результат - Структура - результат ожидания по контракту БСП «Длительные операции».
//   ДополнительныеПараметры - Структура, Неопределено - при вызове из NDFL_RDU_НачатьОжидание: ключ МоментСтартаСозданияДокументовМС (Число, мс UTC).
//
&НаКлиенте
Процедура NDFL_RDU_ОбработатьРезультат(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	МоментСтартаСозданияДокументовМС = 0;
	Если ДополнительныеПараметры <> Неопределено И ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Свойство("МоментСтартаСозданияДокументовМС", МоментСтартаСозданияДокументовМС);
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		NDFL_RDU_ПоказатьОшибку(Результат, МоментСтартаСозданияДокументовМС);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Отменено" Тогда
		ТекстОтмены = НСтр("ru = 'Формирование начислений НДФЛ отменено.'");
		ТекстДлительности = NDFL_RDU_ТекстДлительностиЗамераСозданияДокументов(МоментСтартаСозданияДокументовМС);
		Если ЗначениеЗаполнено(ТекстДлительности) Тогда
			ТекстОтмены = ТекстОтмены + Символы.ПС + СтрШаблон(НСтр("ru = 'Длительность до отмены (мин:сек): %1'"), ТекстДлительности);
		КонецЕсли;
		ПоказатьПредупреждение(, ТекстОтмены);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус <> "Выполнено" Тогда
		Возврат;
	КонецЕсли;
	
	РезультатНаКлиенте = NDFL_RDU_ОбработатьИтогНаСервере(Результат, Истина);
	Если РезультатНаКлиенте = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Результат длительной операции недоступен.'"));
		Возврат;
	КонецЕсли;
	
	NDFL_RDU_ПоказатьТабличныйДокументЛога(РезультатНаКлиенте.АдресТабличногоДокумента);
	
	// IMDEV-7330-5 Диагностика итога (ошибки пачек, частичный успех) после показа лога.
	Успешно = Истина;
	ЧастичныйУспех = Ложь;
	ТекстДиагностики = "";
	
	РезультатНаКлиенте.Свойство("Успешно", Успешно);
	РезультатНаКлиенте.Свойство("ЧастичныйУспех", ЧастичныйУспех);
	РезультатНаКлиенте.Свойство("ТекстДиагностики", ТекстДиагностики);
	
	Если Не Успешно Или ЧастичныйУспех Или ЗначениеЗаполнено(ТекстДиагностики) Тогда
		ТекстПредупреждения = ?(ЗначениеЗаполнено(ТекстДиагностики), ТекстДиагностики,
			НСтр("ru = 'Формирование НДФЛ завершено с предупреждениями или ошибками пачек.'"));
		ПоказатьПредупреждение(, ТекстПредупреждения);
	КонецЕсли;
	
	NDFL_RDU_СообщитьЗавершениеСозданияДокументовСРасчетомДлительности(МоментСтартаСозданияДокументовМС);
	
	ОбновитьКоличествоСтрок();
	
КонецПроцедуры

// IMDEV-7330-5 Описание: Читает итог длительной операции из ВХ, опционально применяет снимок к форме, возвращает данные для клиента.
//
// Параметры:
//   РезультатДО - Структура - результат выполнения ДлительныеОперации (ожидание завершения).
//   ПрименятьСнимок - Булево - если Истина - заполнить реквизит формы «Объект» из СнимокОбъектаПосле; если Ложь - только диагностика и лог.
//
// Возвращаемое значение:
//   Структура - поля для клиента: Успешно, ЧастичныйУспех, ТекстДиагностики, АдресТабличногоДокумента.
//               Неопределено при невозможности разобрать итог.
//
&НаСервере
Функция NDFL_RDU_ОбработатьИтогНаСервере(Знач РезультатДО, Знач ПрименятьСнимок = Истина)
	
	АдресРезультата = "";
	Если Не РезультатДО.Свойство("АдресРезультата", АдресРезультата)
		Или Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначениеВХ = ПолучитьИзВременногоХранилища(АдресРезультата);
	Итог = Неопределено;
	
	Если ТипЗнч(ЗначениеВХ) = Тип("Строка") И ЗначениеЗаполнено(ЗначениеВХ) Тогда
		Попытка
			Итог = Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеИзXML(ЗначениеВХ);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	ИначеЕсли ТипЗнч(ЗначениеВХ) = Тип("Структура") Тогда
		Итог = ЗначениеВХ;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если Итог = Неопределено Или ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПрименятьСнимок Тогда
		NDFL_RDU_ПрименитьСнимокОбъекта(Итог);
	КонецЕсли;
	
	РезультатКлиента = Новый Структура;
	РезультатКлиента.Вставить("Успешно", Истина);
	РезультатКлиента.Вставить("ЧастичныйУспех", Ложь);
	РезультатКлиента.Вставить("ТекстДиагностики", "");
	РезультатКлиента.Вставить("АдресТабличногоДокумента", "");
	
	Итог.Свойство("Успешно", РезультатКлиента.Успешно);
	Итог.Свойство("ЧастичныйУспех", РезультатКлиента.ЧастичныйУспех);
	Итог.Свойство("ТекстДиагностики", РезультатКлиента.ТекстДиагностики);
	
	// IMDEV-7330-5 Помещение табличного документа лога во ВХ формы для клиента (или перенос готового адреса из итога).
	ТабличныйДокумент = Неопределено;
	Если Итог.Свойство("ТабличныйДокумент", ТабличныйДокумент)
		И ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
		
		РезультатКлиента.АдресТабличногоДокумента = ПоместитьВоВременноеХранилище(
			ТабличныйДокумент, УникальныйИдентификатор);
		
	Иначе
		АдресИзИтога = "";
		Если Итог.Свойство("АдресТабличногоДокумента", АдресИзИтога)
			И ЭтоАдресВременногоХранилища(АдресИзИтога) Тогда
			РезультатКлиента.АдресТабличногоДокумента = АдресИзИтога;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатКлиента;
	
КонецФункции

// IMDEV-7330-5 Описание: Заполняет реквизит формы «Объект» из поля СнимокОбъектаПосле итога оркестратора.
//
&НаСервере
Процедура NDFL_RDU_ПрименитьСнимокОбъекта(Итог)
	
	Если Итог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СнимокПосле = Неопределено;
	Если Итог.Свойство("СнимокОбъектаПосле", СнимокПосле)
		И ТипЗнч(СнимокПосле) = Тип("Структура") Тогда
		
		ОбъектОбработки = РеквизитФормыВЗначение("Объект");
		Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ЗаполнитьОбъектОбработкиИзСнимка(
			ОбъектОбработки, СнимокПосле);
		
		ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	КонецЕсли;
	
КонецПроцедуры

// IMDEV-7330-5 Описание: Выводит табличный документ лога формирования НДФЛ из временного хранилища.
//
&НаКлиенте
Процедура NDFL_RDU_ПоказатьТабличныйДокументЛога(АдресТабличногоДокумента)
	
	Если Не ЗначениеЗаполнено(АдресТабличногоДокумента)
		Или Не ЭтоАдресВременногоХранилища(АдресТабличногоДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент = ПолучитьИзВременногоХранилища(АдресТабличногоДокумента);
	Если ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
		ТабличныйДокумент.Показать(НСтр("ru = 'Лог формирования начислений НДФЛ'"));
	КонецЕсли;
	
КонецПроцедуры

// IMDEV-7330-5 Описание: Сообщает об ошибке длительной операции; при наличии итога во ВХ показывает лог без смены снимка на форме.
//
// Параметры:
//   МоментСтартаСозданияДокументовМС - Число - для строки длительности до ошибки; 0 — не выводить длительность.
//
&НаКлиенте
Процедура NDFL_RDU_ПоказатьОшибку(Результат, МоментСтартаСозданияДокументовМС = 0)
	
	Адрес = "";
	Если Результат.Свойство("АдресРезультата", Адрес) И ЭтоАдресВременногоХранилища(Адрес) Тогда
		Данные = NDFL_RDU_ОбработатьИтогНаСервере(Результат, Ложь);
		Если Данные <> Неопределено Тогда
			NDFL_RDU_ПоказатьТабличныйДокументЛога(Данные.АдресТабличногоДокумента);
		КонецЕсли;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Результат.Свойство("КраткоеПредставлениеОшибки", ТекстОшибки);
		Подробно = "";
		Если Результат.Свойство("ПодробноеПредставлениеОшибки", Подробно)
			И ЗначениеЗаполнено(Подробно) Тогда
			ТекстОшибки = Подробно;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		ТекстОшибки = НСтр("ru = 'Длительная операция завершилась с ошибкой.'");
	КонецЕсли;
	
	ТекстДлительности = NDFL_RDU_ТекстДлительностиЗамераСозданияДокументов(МоментСтартаСозданияДокументовМС);
	Если ЗначениеЗаполнено(ТекстДлительности) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС + СтрШаблон(НСтр("ru = 'Длительность до ошибки (мин:сек): %1'"), ТекстДлительности);
	КонецЕсли;
	
	ПоказатьПредупреждение(, ТекстОшибки);
	
КонецПроцедуры

// IMDEV-7330-5 Описание: Строка «минуты:секунды» от метки старта (универсальное время, как у NDFL_RDU_СтрокаПрошедшихМинутСекунд в менеджере).
//
// Параметры:
//   МоментСтартаСозданияДокументовМС - Число - ТекущаяУниверсальнаяДатаВМиллисекундах() на момент команды.
//
// Возвращаемое значение:
//   Строка - пусто, если метка не задана; иначе формат как у NDFL_RDU_СтрокаПрошедшихМинутСекунд.
//
&НаКлиенте
Функция NDFL_RDU_ТекстДлительностиЗамераСозданияДокументов(МоментСтартаСозданияДокументовМС)
	
	Если МоментСтартаСозданияДокументовМС = Неопределено Или МоментСтартаСозданияДокументовМС = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	РазницаМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментСтартаСозданияДокументовМС;
	Если РазницаМС < 0 Тогда
		РазницаМС = 0;
	КонецЕсли;
	
	СекундыВсего = Цел(РазницаМС / 1000);
	Минуты = Цел(СекундыВсего / 60);
	СекундыОстаток = СекундыВсего % 60;
	
	Возврат СтрШаблон("%1:%2", Формат(Минуты, "ЧГ=0"), Формат(СекундыОстаток, "ЧЦ=2; ЧВН=; ЧГ=0"));
	
КонецФункции

// IMDEV-7330-5 Описание: Сообщение пользователю о завершении команды «Создать документы» и длительности замера с момента старта.
//
// Параметры:
//   МоментСтартаСозданияДокументовМС - Число - метка старта в миллисекундах (UTC).
//
&НаКлиенте
Процедура NDFL_RDU_СообщитьЗавершениеСозданияДокументовСРасчетомДлительности(МоментСтартаСозданияДокументовМС)
	
	ТекстДлительности = NDFL_RDU_ТекстДлительностиЗамераСозданияДокументов(МоментСтартаСозданияДокументовМС);
	Если ЗначениеЗаполнено(ТекстДлительности) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Формирование начислений НДФЛ завершено. Длительность (мин:сек): %1'"), ТекстДлительности);
	Иначе
		ТекстСообщения = НСтр("ru = 'Формирование начислений НДФЛ завершено.'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
