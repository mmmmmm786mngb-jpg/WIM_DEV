
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Описание: Оркестратор длительной операции отмены проведения документов начисления НДФЛ за дату
//           (до 10 параллельных фоновых пачек через БСП «Длительные операции»).
//
// Параметры:
//   Параметры - Структура - поле ПараметрыXML (строка) или поля ДатаОтменыПроведения, ИдентификаторФормы.
//   АдресРезультата - Строка - адрес ВХ итога ДО (XML-строка структуры итога).
//
Процедура NDFL_RDU_ОркестраторОтменыПроведенияНачисленийНДФЛ(Параметры, АдресРезультата) Экспорт
	
	СтрокаВхода = "";
	Если Параметры <> Неопределено И Параметры.Свойство("ПараметрыXML", СтрокаВхода) И ЗначениеЗаполнено(СтрокаВхода) Тогда
		Попытка
			Параметры = Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеИзXML(СтрокаВхода);
		Исключение
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru = 'NDFL_RDU. Отмена проведения НДФЛ (оркестратор): ошибка разбора XML'"),
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			ВызватьИсключение НСтр("ru = 'NDFL_RDU: ошибка разбора XML параметров длительной операции.'")
				+ Символы.ПС + ТекстОшибки;
		КонецПопытки;
	КонецЕсли;
	
	ИдентификаторФормы = Неопределено;
	Если Не Параметры.Свойство("ИдентификаторФормы", ИдентификаторФормы) Или Не ЗначениеЗаполнено(ИдентификаторФормы) Тогда
		ВызватьИсключение НСтр("ru = 'NDFL_RDU: не передан ИдентификаторФормы в параметрах длительной операции.'");
	КонецЕсли;
	
	ДатаОтменыПроведения = Неопределено;
	Если Не Параметры.Свойство("ДатаОтменыПроведения", ДатаОтменыПроведения)
		Или Не ЗначениеЗаполнено(ДатаОтменыПроведения) Тогда
		
		ВызватьИсключение НСтр("ru = 'NDFL_RDU: не передана дата отмены проведения.'");
	КонецЕсли;
	
	Попытка
		
		СсылкиДокументов = NDFL_RDU_СобратьПроведенныеСсылкиПоДате(ДатаОтменыПроведения);
		Если СсылкиДокументов.Количество() = 0 Тогда
			ИтогПустой = NDFL_RDU_СтруктураИтогаОтмены(Истина, НСтр(
				"ru = 'Проведенных документов «НачислениеНДФЛПоПортфелю» и «НачислениеНДФЛПоУправляющейКомпании» на выбранную дату не найдено.'"),
				0, 0, Ложь, Новый Массив);
			NDFL_RDU_ЗаписатьИтогОтменыВоВременноеХранилище(АдресРезультата, ИтогПустой);
			Возврат;
		КонецЕсли;
		
		МаксПотоков = NDFL_RDU_МаксимумПараллельныхПотоковОтмены();
		ПачкиСсылок = NDFL_RDU_РазбитьМассивСсылокНаПачки(СсылкиДокументов, МаксПотоков);
		
		Если ПачкиСсылок.Количество() = 1 Тогда
			
			АдресПачки = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
			ПараметрыОднойПачки = Новый Структура;
			ПараметрыОднойПачки.Вставить("НомерПачки", 1);
			ПараметрыОднойПачки.Вставить("МассивСсылок", ПачкиСсылок[0]);
			ПараметрыОднойПачки.Вставить("АдресРезультатаПачки", АдресПачки);
			
			ПараметрыВыполненияПроцедуры = Новый Структура;
			ПараметрыВыполненияПроцедуры.Вставить("ПараметрыXML",
				Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеВXML(ПараметрыОднойПачки));
			
			ОбработкаОбъект = Обработки.ОтменаПроведенияНачисленийНДФЛ.Создать();
			ОбработкаОбъект.NDFL_RDU_ВыполнитьПачкуОтменыПроведения(ПараметрыВыполненияПроцедуры, "");
			
			РезПачки = ПолучитьИзВременногоХранилища(АдресПачки);
			МассивОдного = Новый Массив;
			МассивОдного.Добавить(РезПачки);
			ИтогСинх = NDFL_RDU_СобратьИтогИзРезультатовПачекОтмены(МассивОдного);
			NDFL_RDU_ЗаписатьИтогОтменыВоВременноеХранилище(АдресРезультата, ИтогСинх);
			Возврат;
			
		КонецЕсли;
		
		ПрогрессНачальный = Новый Структура;
		ПрогрессНачальный.Вставить("ВсегоПачек", ПачкиСсылок.Количество());
		ПрогрессНачальный.Вставить("ВсегоДокументов", СсылкиДокументов.Количество());
		ПрогрессНачальный.Вставить("ЗавершеноПачек", 0);
		ПрогрессНачальный.Вставить("ОбработаноДокументов", 0);
		ПрогрессНачальный.Вставить("ТекстЭтапа", "");
		ПрогрессНачальный.Вставить("ВремяСтартаМС", ТекущаяУниверсальнаяДатаВМиллисекундах());
		ПрогрессНачальный.Вставить("ВремяСтартаТекст", Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss"));
		АдресПрогресса = ПоместитьВоВременноеХранилище(ПрогрессНачальный, ИдентификаторФормы);
		
		МассивИдентификаторовЗаданийПачек = Новый Массив;
		МассивПараметровПачек = Новый Массив;
		ВсегоПачек = ПачкиСсылок.Количество();
		НомерПачки = 0;
		Для Каждого ПачкаСсылок Из ПачкиСсылок Цикл
			НомерПачки = НомерПачки + 1;
			ПараметрыПачки = NDFL_RDU_ПодготовитьПараметрыПачкиОтмены(НомерПачки, ВсегоПачек, ПачкаСсылок, ИдентификаторФормы);
			МассивПараметровПачек.Добавить(ПараметрыПачки);
			ИдентификаторЗаданияПачки = NDFL_RDU_ЗапуститьПачкуОтменыПроведенияЧерезБСП(ПараметрыПачки, НомерПачки, ВсегоПачек);
			МассивИдентификаторовЗаданийПачек.Добавить(ИдентификаторЗаданияПачки);
		КонецЦикла;
		
		Если NDFL_RDU_ОркестраторВыполнитьОжиданиеПачекОтмены(АдресРезультата, АдресПрогресса, МассивИдентификаторовЗаданийПачек,
			ПачкиСсылок, ИдентификаторФормы) Тогда
			Возврат;
		КонецЕсли;
		
		СборПачек = NDFL_RDU_ОркестраторСобратьРезультатыПачекОтмены(МассивПараметровПачек);
		РезультатыПачек = СборПачек.РезультатыПачек;
		УпавшиеПачки = СборПачек.УпавшиеПачки;
		
		ИтогСшивки = NDFL_RDU_СобратьИтогИзРезультатовПачекОтмены(РезультатыПачек);
		
		КоличествоУпавшихПачек = УпавшиеПачки.Количество();
		ПолныйПровалПачек = (КоличествоУпавшихПачек = ВсегоПачек) И (ВсегоПачек > 0);
		ЧастичныйУспехПачек = (КоличествоУпавшихПачек > 0) И (КоличествоУпавшихПачек < ВсегоПачек);
		
		Если ПолныйПровалПачек Тогда
			ИтогСшивки.Успешно = Ложь;
			Если Не ЗначениеЗаполнено(ИтогСшивки.ТекстДиагностики) Тогда
				ИтогСшивки.ТекстДиагностики = НСтр("ru = 'Не удалось получить результат ни одной пачки (фоновые задания). См. журнал регистрации.'");
			КонецЕсли;
		ИначеЕсли ЧастичныйУспехПачек Тогда
			ИтогСшивки.ЧастичныйУспех = Истина;
			Если Не ЗначениеЗаполнено(ИтогСшивки.ТекстДиагностики) Тогда
				ИтогСшивки.ТекстДиагностики = НСтр("ru = 'Часть пачек не вернула результат. См. журнал регистрации.'");
			КонецЕсли;
		КонецЕсли;
		
		ИтогСшивки.Вставить("УпавшиеПачки", УпавшиеПачки);
		NDFL_RDU_ЗаписатьИтогОтменыВоВременноеХранилище(АдресРезультата, ИтогСшивки);
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'NDFL_RDU. Отмена проведения НДФЛ (оркестратор)'"),
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ИтогОшибка = NDFL_RDU_СтруктураИтогаОтмены(Ложь, ТекстОшибки, 0, 0, Ложь, Новый Массив);
		NDFL_RDU_ЗаписатьИтогОтменыВоВременноеХранилище(АдресРезультата, ИтогОшибка);
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Верхняя граница числа одновременных фоновых заданий отмены проведения.
//
// Возвращаемое значение:
//   Число - не больше 10.
//
Функция NDFL_RDU_МаксимумПараллельныхПотоковОтмены()
	
	Возврат 10;
	
КонецФункции

// Описание: Собирает ссылки проведенных документов двух видов за календарный день выбранной даты.
//
// Параметры:
//   ДатаОтменыПроведения - Дата - день отбора.
//
// Возвращаемое значение:
//   Массив - элементы: ДокументСсылка.НачислениеНДФЛПоПортфелю, ДокументСсылка.НачислениеНДФЛПоУправляющейКомпании.
//
Функция NDFL_RDU_СобратьПроведенныеСсылкиПоДате(Знач ДатаОтменыПроведения)
	
	ДатаНачала = НачалоДня(ДатаОтменыПроведения);
	ДатаКонца = КонецДня(ДатаОтменыПроведения);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.НачислениеНДФЛПоПортфелю КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И Док.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДокУК.Ссылка
	|ИЗ
	|	Документ.НачислениеНДФЛПоУправляющейКомпании КАК ДокУК
	|ГДЕ
	|	ДокУК.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И ДокУК.Проведен";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", ДатаКонца);
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Разбивает массив ссылок на не более чем МаксПачек непустых пачек с равномерным распределением.
//
// Параметры:
//   МассивСсылок - Массив - ссылки на документы.
//   МаксПачек - Число - верхняя граница числа пачек (потоков).
//
// Возвращаемое значение:
//   Массив - элементы: Массив ссылок по пачке.
//
Функция NDFL_RDU_РазбитьМассивСсылокНаПачки(Знач МассивСсылок, Знач МаксПачек)
	
	Результат = Новый Массив;
	Всего = МассивСсылок.Количество();
	Если Всего = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЧислоПачек = Мин(МаксПачек, Всего);
	БазовыйРазмер = Цел(Всего / ЧислоПачек);
	Остаток = Всего % ЧислоПачек;
	
	Индекс = 0;
	Для НомерПачки = 1 По ЧислоПачек Цикл
		
		РазмерПачки = БазовыйРазмер + ?(НомерПачки <= Остаток, 1, 0);
		Пачка = Новый Массив;
		Для Сч = 1 По РазмерПачки Цикл
			Пачка.Добавить(МассивСсылок[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		Результат.Добавить(Пачка);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Формирует параметры одной пачки для фонового вызова модуля объекта обработки.
//
Функция NDFL_RDU_ПодготовитьПараметрыПачкиОтмены(НомерПачки, ВсегоПачек, ПачкаСсылок, ИдентификаторФормы)
	
	АдресРезультатаПачки = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
	
	ПараметрыПачки = Новый Структура;
	ПараметрыПачки.Вставить("НомерПачки", НомерПачки);
	ПараметрыПачки.Вставить("ВсегоПачек", ВсегоПачек);
	ПараметрыПачки.Вставить("МассивСсылок", ПачкаСсылок);
	ПараметрыПачки.Вставить("АдресРезультатаПачки", АдресРезультатаПачки);
	
	Возврат ПараметрыПачки;
	
КонецФункции

// Описание: Запускает одну пачку через БСП (ВыполнитьПроцедуруМодуляОбъектаОбработки).
//
Функция NDFL_RDU_ЗапуститьПачкуОтменыПроведенияЧерезБСП(ПараметрыПачки, НомерПачки, ВсегоПачек)
	
	ПараметрыВыполненияПроцедуры = Новый Структура;
	ПараметрыВыполненияПроцедуры.Вставить("ПараметрыXML",
		Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеВXML(ПараметрыПачки));
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяОбработки", "ОтменаПроведенияНачисленийНДФЛ");
	ПараметрыЗадания.Вставить("ИмяМетода", "NDFL_RDU_ВыполнитьПачкуОтменыПроведения");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыВыполненияПроцедуры);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Ложь);
	
	УникальныйИдентификаторПараметровВыполнения = Новый УникальныйИдентификатор;
	ПараметрыВыполненияВФоне = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификаторПараметровВыполнения);
	ПараметрыВыполненияВФоне.КлючФоновогоЗадания = Строка(Новый УникальныйИдентификатор);
	ПараметрыВыполненияВФоне.НаименованиеФоновогоЗадания = СтрШаблон(
		НСтр("ru = 'NDFL_RDU: отмена проведения НДФЛ, пачка %1 из %2'"), НомерПачки, ВсегоПачек);
	ПараметрыВыполненияВФоне.ЗапуститьВФоне = Истина;
	ПараметрыВыполненияВФоне.ОжидатьЗавершение = 0;
	
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне(
		"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
		ПараметрыЗадания,
		ПараметрыВыполненияВФоне);
	
	Если РезультатВыполнения.Статус = "Ошибка" Тогда
		ВызватьИсключение РезультатВыполнения.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	Возврат РезультатВыполнения.ИдентификаторЗадания;
	
КонецФункции

Функция NDFL_RDU_ФоновоеЗаданиеПачкиОтменыПоИдентификатору(ИдентификаторЗадания)
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
КонецФункции

// Возвращаемое значение:
//   Булево - Истина, если пользователь отменил родительскую ДО (записан итог во ВХ).
//
Функция NDFL_RDU_ОркестраторВыполнитьОжиданиеПачекОтмены(АдресРезультата, АдресПрогресса, МассивИдентификаторовЗаданийПачек,
	ПачкиСсылок, ИдентификаторФормы)
	
	Пока Истина Цикл
		
		ЗаданиеРодителя = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
		Если ЗаданиеРодителя <> Неопределено
			И ЗаданиеРодителя.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
			
			NDFL_RDU_ОтменитьЗаданияПачекОтмены(МассивИдентификаторовЗаданийПачек);
			ИтогОтмены = NDFL_RDU_СтруктураИтогаОтмены(Ложь, НСтр("ru = 'Отмена проведения прервана по запросу пользователя.'"), 0, 0,
				Ложь, Новый Массив);
			NDFL_RDU_ЗаписатьИтогОтменыВоВременноеХранилище(АдресРезультата, ИтогОтмены);
			Возврат Истина;
			
		КонецЕсли;
		
		ВсеЗавершены = Истина;
		Для Каждого ИдентификаторЗаданияПачки Из МассивИдентификаторовЗаданийПачек Цикл
			Задание = NDFL_RDU_ФоновоеЗаданиеПачкиОтменыПоИдентификатору(ИдентификаторЗаданияПачки);
			Если Задание = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				ВсеЗавершены = Ложь;
				Попытка
					Задание.ОжидатьЗавершенияВыполнения(0.2);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		NDFL_RDU_ОбновитьПрогрессОтменыПоЗаданиям(АдресПрогресса, МассивИдентификаторовЗаданийПачек, ПачкиСсылок,
			ИдентификаторФормы);
		
		Если ВсеЗавершены Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура NDFL_RDU_ОтменитьЗаданияПачекОтмены(МассивИдентификаторовЗаданийПачек)
	
	Для Каждого ИдентификаторЗаданияПачки Из МассивИдентификаторовЗаданийПачек Цикл
		Задание = NDFL_RDU_ФоновоеЗаданиеПачкиОтменыПоИдентификатору(ИдентификаторЗаданияПачки);
		Если Задание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Попытка
				Задание.Отменить();
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'NDFL_RDU. Отмена фонового задания пачки отмены проведения'"),
					УровеньЖурналаРегистрации.Предупреждение, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура NDFL_RDU_ОбновитьПрогрессОтменыПоЗаданиям(АдресПрогресса, МассивИдентификаторовЗаданийПачек, ПачкиСсылок,
	ИдентификаторФормы)
	
	Прогресс = ПолучитьИзВременногоХранилища(АдресПрогресса);
	Если Прогресс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗавершеноПачек = 0;
	ОбработаноДокументов = 0;
	Номер = 0;
	Для Каждого ИдентификаторЗаданияПачки Из МассивИдентификаторовЗаданийПачек Цикл
		Номер = Номер + 1;
		Задание = NDFL_RDU_ФоновоеЗаданиеПачкиОтменыПоИдентификатору(ИдентификаторЗаданияПачки);
		ПачкаЗавершена = (Задание = Неопределено)
			Или Задание.Состояние <> СостояниеФоновогоЗадания.Активно;
		Если ПачкаЗавершена Тогда
			ЗавершеноПачек = ЗавершеноПачек + 1;
			Если Номер <= ПачкиСсылок.Количество() Тогда
				ОбработаноДокументов = ОбработаноДокументов + ПачкиСсылок[Номер - 1].Количество();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Прогресс.ЗавершеноПачек = ЗавершеноПачек;
	Прогресс.ОбработаноДокументов = ОбработаноДокументов;
	Процент = 0;
	Если Прогресс.ВсегоДокументов > 0 Тогда
		Процент = Окр(100 * ОбработаноДокументов / Прогресс.ВсегоДокументов, 0);
	КонецЕсли;
	
	ВремяСтартаМС = 0;
	Если Не Прогресс.Свойство("ВремяСтартаМС", ВремяСтартаМС) Тогда
		ВремяСтартаМС = 0;
	КонецЕсли;
	ВремяСтартаТекст = "";
	Если Не Прогресс.Свойство("ВремяСтартаТекст", ВремяСтартаТекст) Тогда
		ВремяСтартаТекст = "";
	КонецЕсли;
	
	ТекстПрошло = NDFL_RDU_СтрокаПрошедшихМинутСекундОтмены(ВремяСтартаМС);
	ТекстПачек = СтрШаблон(
		НСтр("ru = '%2Документов к отмене проведения: %1%2Завершено потоков %3 из %4%2Время старта: %5%2Прошло мин:сек %6'"),
		Прогресс.ВсегоДокументов,
		Символы.ПС,
		ЗавершеноПачек,
		Прогресс.ВсегоПачек,
		ВремяСтартаТекст,
		ТекстПрошло);
	Прогресс.ТекстЭтапа = ТекстПачек;
	ПоместитьВоВременноеХранилище(Прогресс, АдресПрогресса);
	ДлительныеОперации.СообщитьПрогресс(Процент, ТекстПачек);
	
КонецПроцедуры

Функция NDFL_RDU_СтрокаПрошедшихМинутСекундОтмены(ВремяСтартаМС)
	
	Если ВремяСтартаМС = Неопределено Или ВремяСтартаМС = 0 Тогда
		Возврат "0:00";
	КонецЕсли;
	
	РазницаМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяСтартаМС;
	Если РазницаМС < 0 Тогда
		РазницаМС = 0;
	КонецЕсли;
	
	СекундыВсего = Цел(РазницаМС / 1000);
	Минуты = Цел(СекундыВсего / 60);
	СекундыОстаток = СекундыВсего % 60;
	
	Возврат СтрШаблон("%1:%2", Формат(Минуты, "ЧГ=0"), Формат(СекундыОстаток, "ЧЦ=2; ЧВН=; ЧГ=0"));
	
КонецФункции

Функция NDFL_RDU_ОркестраторСобратьРезультатыПачекОтмены(МассивПараметровПачек)
	
	РезультатыПачек = Новый Массив;
	УпавшиеПачки = Новый Массив;
	Индекс = 0;
	Для Каждого ПараметрыПачки Из МассивПараметровПачек Цикл
		Индекс = Индекс + 1;
		АдресРезультатаПачки = "";
		ПараметрыПачки.Свойство("АдресРезультатаПачки", АдресРезультатаПачки);
		РезПачки = ПолучитьИзВременногоХранилища(АдресРезультатаПачки);
		
		УпалаПачка = Ложь;
		Если РезПачки = Неопределено Или ТипЗнч(РезПачки) <> Тип("Структура") Тогда
			УпалаПачка = Истина;
		Иначе
			РезультатыПачек.Добавить(РезПачки);
		КонецЕсли;
		
		Если УпалаПачка Тогда
			УпавшиеПачки.Добавить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("РезультатыПачек, УпавшиеПачки", РезультатыПачек, УпавшиеПачки);
	
КонецФункции

Функция NDFL_RDU_СобратьИтогИзРезультатовПачекОтмены(РезультатыПачек)
	
	ОтмененоВсего = 0;
	ПропущеноВсего = 0;
	ТекстыОшибок = Новый Массив;
	ЕстьОшибки = Ложь;
	
	Для Каждого Рез Из РезультатыПачек Цикл
		Если Рез = Неопределено Или ТипЗнч(Рез) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Число = 0;
		Если Рез.Свойство("ОтмененоДокументов", Число) Тогда
			ОтмененоВсего = ОтмененоВсего + Число;
		КонецЕсли;
		ЧислоПр = 0;
		Если Рез.Свойство("ПропущеноНеПроведенных", ЧислоПр) Тогда
			ПропущеноВсего = ПропущеноВсего + ЧислоПр;
		КонецЕсли;
		Флаг = Ложь;
		Если Рез.Свойство("ЕстьОшибка", Флаг) И Флаг Тогда
			ЕстьОшибки = Истина;
			ТекстОшибкиПачки = "";
			Рез.Свойство("ТекстОшибки", ТекстОшибкиПачки);
			Если ЗначениеЗаполнено(ТекстОшибкиПачки) Тогда
				ТекстыОшибок.Добавить(ТекстОшибкиПачки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ТекстДиагностики = "";
	Если ТекстыОшибок.Количество() > 0 Тогда
		ТекстДиагностики = СтрСоединить(ТекстыОшибок, Символы.ПС);
	КонецЕсли;
	
	Успешно = Не ЕстьОшибки;
	ЧастичныйУспех = ЕстьОшибки И ОтмененоВсего > 0;
	
	Если Не ЕстьОшибки Тогда
		ТекстДиагностики = СтрШаблон(НСтр("ru = 'Отменено проведения у документов: %1. Пропущено (уже не проведены): %2.'"),
			Формат(ОтмененоВсего, "ЧГ=0"),
			Формат(ПропущеноВсего, "ЧГ=0"));
	ИначеЕсли ЧастичныйУспех Тогда
		ТекстДиагностики = СтрШаблон(НСтр("ru = 'Частично выполнено. Отменено: %1. Пропущено: %2.%3%4'"),
			Формат(ОтмененоВсего, "ЧГ=0"),
			Формат(ПропущеноВсего, "ЧГ=0"),
			Символы.ПС,
			ТекстДиагностики);
	КонецЕсли;
	
	Возврат NDFL_RDU_СтруктураИтогаОтмены(Успешно, ТекстДиагностики, ОтмененоВсего, ПропущеноВсего, ЧастичныйУспех, Новый Массив);
	
КонецФункции

Функция NDFL_RDU_СтруктураИтогаОтмены(Успешно, ТекстДиагностики, ОтмененоДокументов, ПропущеноНеПроведенных, ЧастичныйУспех,
	УпавшиеПачки)
	
	Итог = Новый Структура;
	Итог.Вставить("Успешно", Успешно);
	Итог.Вставить("ТекстДиагностики", ТекстДиагностики);
	Итог.Вставить("ОтмененоДокументов", ОтмененоДокументов);
	Итог.Вставить("ПропущеноНеПроведенных", ПропущеноНеПроведенных);
	Итог.Вставить("ЧастичныйУспех", ЧастичныйУспех);
	Итог.Вставить("УпавшиеПачки", УпавшиеПачки);
	Возврат Итог;
	
КонецФункции

Процедура NDFL_RDU_ЗаписатьИтогОтменыВоВременноеХранилище(АдресРезультата, Итог)
	
	ПоместитьВоВременноеХранилище(Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеВXML(Итог), АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
