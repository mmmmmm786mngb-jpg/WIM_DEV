
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Описание: Выполняет отмену проведения для списка ссылок в фоне (пачка). Вызывается через
//           ДлительныеОперации.ВыполнитьВФоне("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки", ...).
//
// Параметры:
//   ПараметрыВыполнения - Структура - ожидается свойство ПараметрыXML (строка XML параметров пачки).
//   АдресХранилищаРезультата - Строка - адрес ВХ для признака успеха БСП (опционально).
//
Процедура NDFL_RDU_ВыполнитьПачкуОтменыПроведения(ПараметрыВыполнения, АдресХранилищаРезультата) Экспорт
	
	СтрокаXMLПараметровПачки = "";
	Если Не (ПараметрыВыполнения <> Неопределено
		И ТипЗнч(ПараметрыВыполнения) = Тип("Структура")
		И ПараметрыВыполнения.Свойство("ПараметрыXML", СтрокаXMLПараметровПачки)
		И ЗначениеЗаполнено(СтрокаXMLПараметровПачки)) Тогда
		
		Если ЗначениеЗаполнено(АдресХранилищаРезультата) Тогда
			ПоместитьВоВременноеХранилище(Ложь, АдресХранилищаРезультата);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПараметрыПачки = Неопределено;
	Попытка
		ПараметрыПачки = Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеИзXML(СтрокаXMLПараметровПачки);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'NDFL_RDU. Отмена проведения начислений НДФЛ (пачка): ошибка разбора XML'"),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если ЗначениеЗаполнено(АдресХранилищаРезультата) Тогда
			ПоместитьВоВременноеХранилище(Ложь, АдресХранилищаРезультата);
		КонецЕсли;
		Возврат;
	КонецПопытки;
	
	АдресРезультатаПачки = "";
	Если Не ПараметрыПачки.Свойство("АдресРезультатаПачки", АдресРезультатаПачки)
		Или Не ЗначениеЗаполнено(АдресРезультатаПачки) Тогда
		
		Если ЗначениеЗаполнено(АдресХранилищаРезультата) Тогда
			ПоместитьВоВременноеХранилище(Ложь, АдресХранилищаРезультата);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	МассивСсылок = Неопределено;
	Если Не ПараметрыПачки.Свойство("МассивСсылок", МассивСсылок) Или МассивСсылок = Неопределено Тогда
		МассивСсылок = Новый Массив;
	КонецЕсли;
	
	РезультатПачки = Новый Структура;
	РезультатПачки.Вставить("НомерПачки", 0);
	РезультатПачки.Вставить("ЕстьОшибка", Ложь);
	РезультатПачки.Вставить("ТекстОшибки", "");
	РезультатПачки.Вставить("ОтмененоДокументов", 0);
	РезультатПачки.Вставить("ПропущеноНеПроведенных", 0);
	РезультатПачки.Вставить("ТекстыОшибокПоДокументам", Новый Массив);
	
	ПараметрыПачки.Свойство("НомерПачки", РезультатПачки.НомерПачки);
	
	Попытка
		
		Для Каждого СсылкаДок Из МассивСсылок Цикл
			
			Если Не ЗначениеЗаполнено(СсылкаДок) Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				ДокОбъект = СсылкаДок.ПолучитьОбъект();
				Если ДокОбъект = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если Не ДокОбъект.Проведен Тогда
					РезультатПачки.ПропущеноНеПроведенных = РезультатПачки.ПропущеноНеПроведенных + 1;
					Продолжить;
				КонецЕсли;
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				РезультатПачки.ОтмененоДокументов = РезультатПачки.ОтмененоДокументов + 1;
			Исключение
				РезультатПачки.ЕстьОшибка = Истина;
				ТекстОдной = СтрШаблон(НСтр("ru = '%1: %2'"), Строка(СсылкаДок),
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				РезультатПачки.ТекстыОшибокПоДокументам.Добавить(ТекстОдной);
			КонецПопытки;
			
		КонецЦикла;
		
		Если РезультатПачки.ТекстыОшибокПоДокументам.Количество() > 0 Тогда
			РезультатПачки.ТекстОшибки = СтрСоединить(РезультатПачки.ТекстыОшибокПоДокументам, Символы.ПС);
		КонецЕсли;
		
	Исключение
		РезультатПачки.ЕстьОшибка = Истина;
		РезультатПачки.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'NDFL_RDU. Отмена проведения начислений НДФЛ (пачка)'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон(НСтр("ru = 'Пачка %1: %2'"), РезультатПачки.НомерПачки, РезультатПачки.ТекстОшибки));
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(РезультатПачки, АдресРезультатаПачки);
	
	Если ЗначениеЗаполнено(АдресХранилищаРезультата) Тогда
		// Истина: пачка отработала до конца; частичные ошибки по документам — в РезультатПачки (ЕстьОшибка, ТекстОшибки).
		ПоместитьВоВременноеХранилище(Истина, АдресХранилищаРезультата);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
