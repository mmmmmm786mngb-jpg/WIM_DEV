
#Область ОбработчикиСобытийФормы

// Описание: Устанавливает дату по умолчанию при открытии формы.
//
// Параметры:
//   Отказ - Булево - признак отказа от создания формы.
//   СтандартнаяОбработка - Булево - признак выполнения стандартной обработки.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ДатаОтменыПроведения) Тогда
		ДатаОтменыПроведения = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Описание: Запускает длительную операцию отмены проведения документов НДФЛ за выбранную дату.
//
&НаКлиенте
Процедура ОтменитьПроведение(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаОтменыПроведения) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату отбора документов.'"));
		Возврат;
	КонецЕсли;
	
	МоментСтартаМС = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Состояние(НСтр("ru = 'Запуск отмены проведения...'"));
	
	РезультатЗапуска = ЗапуститьОтменуПроведенияНаСервере();
	Если РезультатЗапуска <> Неопределено Тогда
		НачатьОжиданиеОтменыПроведения(РезультатЗапуска, МоментСтартаМС);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

// Описание: Завершение длительной операции отмены проведения (оповещение БСП).
//
// Параметры:
//   Результат - Структура - результат ожидания по контракту БСП «Длительные операции».
//   ДополнительныеПараметры - Структура, Неопределено - ключ МоментСтартаМС (Число).
//
&НаКлиенте
Процедура ОбработатьРезультатОтменыПроведения(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	МоментСтартаМС = 0;
	Если ДополнительныеПараметры <> Неопределено И ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Свойство("МоментСтартаМС", МоментСтартаМС);
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьОшибкуДлительнойОперацииОтмены(Результат, МоментСтартаМС);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Отменено" Тогда
		ТекстОтмены = НСтр("ru = 'Операция отмены проведения прервана.'");
		ТекстДлительности = ТекстДлительностиЗамера(МоментСтартаМС);
		Если ЗначениеЗаполнено(ТекстДлительности) Тогда
			ТекстОтмены = ТекстОтмены + Символы.ПС + СтрШаблон(НСтр("ru = 'Длительность до отмены (мин:сек): %1'"), ТекстДлительности);
		КонецЕсли;
		ПоказатьПредупреждение(, ТекстОтмены);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус <> "Выполнено" Тогда
		Возврат;
	КонецЕсли;
	
	ИтогНаКлиенте = ОбработатьИтогОтменыНаСервере(Результат);
	Если ИтогНаКлиенте = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Результат длительной операции недоступен.'"));
		Возврат;
	КонецЕсли;
	
	Успешно = Истина;
	ЧастичныйУспех = Ложь;
	ТекстДиагностики = "";
	ИтогНаКлиенте.Свойство("Успешно", Успешно);
	ИтогНаКлиенте.Свойство("ЧастичныйУспех", ЧастичныйУспех);
	ИтогНаКлиенте.Свойство("ТекстДиагностики", ТекстДиагностики);
	
	Если Не Успешно Или ЧастичныйУспех Тогда
		ТекстПредупреждения = ?(ЗначениеЗаполнено(ТекстДиагностики), ТекстДиагностики,
			НСтр("ru = 'Операция завершена с предупреждениями.'"));
		ПоказатьПредупреждение(, ТекстПредупреждения);
	ИначеЕсли ЗначениеЗаполнено(ТекстДиагностики) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстДиагностики);
	КонецЕсли;
	
	СообщитьЗавершениеСРасчетомДлительности(МоментСтартаМС);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание: Запускает на сервере длительную операцию оркестратора отмены проведения.
//
// Возвращаемое значение:
//   Структура - результат ДлительныеОперации.ВыполнитьВФоне.
//
&НаСервере
Функция ЗапуститьОтменуПроведенияНаСервере()
	
	ПараметрыОркестратора = Новый Структура;
	ПараметрыОркестратора.Вставить("ДатаОтменыПроведения", ДатаОтменыПроведения);
	ПараметрыОркестратора.Вставить("ИдентификаторФормы", УникальныйИдентификатор);
	
	ПараметрыПроцедуры = Новый Структура(
		"ПараметрыXML",
		Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеВXML(ПараметрыОркестратора));
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'NDFL_RDU: отмена проведения начислений НДФЛ'");
	ПараметрыВыполнения.КлючФоновогоЗадания = "NDFL_RDU_ОтменаПров_" + Строка(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.ОтменаПроведенияНачисленийНДФЛ.NDFL_RDU_ОркестраторОтменыПроведенияНачисленийНДФЛ",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
	
КонецФункции

// Описание: Подключает ожидание завершения длительной операции (БСП).
//
// Параметры:
//   РезультатЗапуска - Структура - результат ВыполнитьВФоне.
//   МоментСтартаМС - Число - метка времени старта (мс UTC).
//
&НаКлиенте
Процедура НачатьОжиданиеОтменыПроведения(РезультатЗапуска, МоментСтартаМС)
	
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗамера = Новый Структура("МоментСтартаМС", МоментСтартаМС);
	
	Если РезультатЗапуска.Статус = "Выполнено" Или РезультатЗапуска.Статус = "Ошибка" Тогда
		ОбработатьРезультатОтменыПроведения(РезультатЗапуска, ПараметрыЗамера);
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьРезультатОтменыПроведения", ЭтотОбъект, ПараметрыЗамера);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗапуска, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

// Описание: Читает итог длительной операции из временного хранилища.
//
// Параметры:
//   РезультатДО - Структура - результат выполнения ДлительныеОперации.
//
// Возвращаемое значение:
//   Структура - поля Успешно, ЧастичныйУспех, ТекстДиагностики, ОтмененоДокументов; Неопределено при ошибке разбора.
//
&НаСервере
Функция ОбработатьИтогОтменыНаСервере(Знач РезультатДО)
	
	АдресРезультата = "";
	Если Не РезультатДО.Свойство("АдресРезультата", АдресРезультата)
		Или Не ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначениеВХ = ПолучитьИзВременногоХранилища(АдресРезультата);
	Итог = Неопределено;
	
	Если ТипЗнч(ЗначениеВХ) = Тип("Строка") И ЗначениеЗаполнено(ЗначениеВХ) Тогда
		Попытка
			Итог = Обработки.ФормированиеНачисленийНДФЛ.NDFL_RDU_ДанныеИзXML(ЗначениеВХ);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	ИначеЕсли ТипЗнч(ЗначениеВХ) = Тип("Структура") Тогда
		Итог = ЗначениеВХ;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если Итог = Неопределено Или ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РезультатКлиента = Новый Структура;
	РезультатКлиента.Вставить("Успешно", Истина);
	РезультатКлиента.Вставить("ЧастичныйУспех", Ложь);
	РезультатКлиента.Вставить("ТекстДиагностики", "");
	РезультатКлиента.Вставить("ОтмененоДокументов", 0);
	
	Итог.Свойство("Успешно", РезультатКлиента.Успешно);
	Итог.Свойство("ЧастичныйУспех", РезультатКлиента.ЧастичныйУспех);
	Итог.Свойство("ТекстДиагностики", РезультатКлиента.ТекстДиагностики);
	Итог.Свойство("ОтмененоДокументов", РезультатКлиента.ОтмененоДокументов);
	
	Возврат РезультатКлиента;
	
КонецФункции

// Описание: Выводит ошибку длительной операции.
//
&НаКлиенте
Процедура ПоказатьОшибкуДлительнойОперацииОтмены(Результат, МоментСтартаМС = 0)
	
	ТекстОшибки = "";
	Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("КраткоеПредставлениеОшибки", ТекстОшибки);
		Подробно = "";
		Если Результат.Свойство("ПодробноеПредставлениеОшибки", Подробно)
			И ЗначениеЗаполнено(Подробно) Тогда
			ТекстОшибки = Подробно;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		ТекстОшибки = НСтр("ru = 'Длительная операция завершилась с ошибкой.'");
	КонецЕсли;
	
	ТекстДлительности = ТекстДлительностиЗамера(МоментСтартаМС);
	Если ЗначениеЗаполнено(ТекстДлительности) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС + СтрШаблон(НСтр("ru = 'Длительность до ошибки (мин:сек): %1'"), ТекстДлительности);
	КонецЕсли;
	
	ПоказатьПредупреждение(, ТекстОшибки);
	
КонецПроцедуры

// Описание: Форматирует длительность «мин:сек» от метки старта в миллисекундах.
//
&НаКлиенте
Функция ТекстДлительностиЗамера(МоментСтартаМС)
	
	Если МоментСтартаМС = Неопределено Или МоментСтартаМС = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	РазницаМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментСтартаМС;
	Если РазницаМС < 0 Тогда
		РазницаМС = 0;
	КонецЕсли;
	
	СекундыВсего = Цел(РазницаМС / 1000);
	Минуты = Цел(СекундыВсего / 60);
	СекундыОстаток = СекундыВсего % 60;
	
	Возврат СтрШаблон("%1:%2", Формат(Минуты, "ЧГ=0"), Формат(СекундыОстаток, "ЧЦ=2; ЧВН=; ЧГ=0"));
	
КонецФункции

// Описание: Сообщение пользователю о завершении и длительности.
//
&НаКлиенте
Процедура СообщитьЗавершениеСРасчетомДлительности(МоментСтартаМС)
	
	ТекстДлительности = ТекстДлительностиЗамера(МоментСтартаМС);
	Если ЗначениеЗаполнено(ТекстДлительности) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Отмена проведения завершена. Длительность (мин:сек): %1'"), ТекстДлительности);
	Иначе
		ТекстСообщения = НСтр("ru = 'Отмена проведения завершена.'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

#КонецОбласти
