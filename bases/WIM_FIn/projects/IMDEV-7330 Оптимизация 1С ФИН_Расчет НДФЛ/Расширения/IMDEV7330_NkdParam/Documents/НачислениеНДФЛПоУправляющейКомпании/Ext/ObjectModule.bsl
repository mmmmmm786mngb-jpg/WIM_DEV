#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// IMDEV-7330 Кэш расходов НКД параметром РассчитатьНДФЛ, без ПараметрыСеанса.ОбщиеЗначения.

Перем ВнешнийКэшНКД;

// Описание: Перехват РассчитатьНДФЛ: кэш с параметра в Перем, без сброса сеансового хранилища.
//
// Параметры:
// ВнешнийКэшНКДПараметр - Соответствие, Неопределено - кэш по КлючКэшаНКД или без предрасчёта
//
&ИзменениеИКонтроль("РассчитатьНДФЛ")
Процедура IMDEV7330_NkdParam_РассчитатьНДФЛ(ВнешнийКэшНКДПараметр = Неопределено) Экспорт

	#Вставка
	// IMDEV-7330 Кэш НКД: параметр в Перем модуля объекта расширения, без ХранилищеЗначения.
	ВнешнийКэшНКД = ВнешнийКэшНКДПараметр;
	#КонецВставки
	Если Не ПроверитьЗаполнениеУКИКлиента() Тогда            
	#Удаление
   		Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьВнешнийКэшНКДРасходов(Неопределено);
	#КонецУдаления
		Возврат;
	КонецЕсли; 
	
	ОчиститьДокумент();
	ИнициализироватьПеременные();	
	
	ЗаполнитьШапкуСправкиРасчета();
	
	Если Не НачислениеНДФЛПоПортфелю Тогда
		
		Если СписокПортфелей.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены портфели для расчета");  
			#Удаление
			Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьВнешнийКэшНКДРасходов(Неопределено);
			#КонецУдаления
			Возврат;
		КонецЕсли; 
				
		ПогашенныйКупонныйДоходУчитыватьВКодахДохода1530и1531 	= Константы.ПогашенныйКупонныйДоходУчитыватьВКодахДохода1530и1531.Получить();
		ДоходПоПаямУчитыватьВКодахДохода1530и1531 				= Константы.ДоходПоПаямУчитыватьВКодахДохода1530и1531.Получить();
		
		ТаблицаНачислений = Документы.НачислениеНДФЛПоУправляющейКомпании.ПустаяТаблицаНачислений();
				
		РасчетНДФЛ_СведенияИзВнешнейСистемы(ТаблицаНачислений);	
		ДанныеПрошлыхУК = ТаблицаНачислений.Скопировать();
		
		РасчетНДФЛ_ПоОбращающимсяЦБ(ТаблицаНачислений);
		РасчетНДФЛ_ПоНеОбращающимсяЦБ(ТаблицаНачислений);
		РасчетНДФЛ_ПоСрочнымКонтрактам(ТаблицаНачислений);
		РасчетНДФЛ_ПоДепозитам(ТаблицаНачислений);
		РасчетНДФЛ_ПоПогашеннымКупонам(ТаблицаНачислений);
		РасчетНДФЛ_ПоРЕПО(ТаблицаНачислений);
		РасчетНДФЛ_ПоОперациямСВалютой(ТаблицаНачислений);
		РасчетНДФЛ_ПоДивидендам(ТаблицаНачислений);
		Документы.НачислениеНДФЛПоУправляющейКомпании.ДополнитьТаблицуТипомДоходаИлиСтавкой(ТаблицаНачислений, Клиент);
		 			
	Иначе
		
		ТаблицаНачислений = Документы.НачислениеНДФЛПоУправляющейКомпании.НачисленияПоПортфелям(УправляющаяКомпания, Клиент, Дата, , СписокПортфелей);
	
	КонецЕсли;  
	
	НачисленияИзСтороннихСистем = Документы.НачислениеНДФЛПоУправляющейКомпании.НачисленияИзСтороннихСистем(УправляющаяКомпания, Клиент, Дата);  
	СуммаЛьготИзСтороннихСистем = Документы.НачислениеНДФЛПоПортфелю.СуммаЛьготИзСтороннихСистем(НачисленияИзСтороннихСистем); 
	ЛимитДляЛьгот 				= РегистрыСведений.ЛимитДляЛьготЦБВысокотехнологичногоСектора.ЛимитНаДату(Дата) - СуммаЛьготИзСтороннихСистем;

	Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьЛимитЛьготПоКодам_2792_2793(ТаблицаНачислений, ЛимитДляЛьгот);  
	
	РасчетНДФЛ_ИнвестиционныйВычет();
	Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьОбщийДоход(ТаблицаНачислений);
	Документы.НачислениеНДФЛПоУправляющейКомпании.УдалитьИсключаемыеКоды(ТаблицаНачислений);  
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(ТаблицаНачислений, "НачислениеНДФЛПоУправляющейКомпании: РассчитатьНДФЛ.ТаблицаНачислений");
	
	РассчитатьНДФЛПоНачислениям(ТаблицаНачислений, , ДанныеПрошлыхУК);  
	
	#Удаление
	Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьВнешнийКэшНКДРасходов(Неопределено);
	#КонецУдаления
	
КонецПроцедуры    


// Описание: Перехват РасчетНДФЛ_ИнвестиционныйВычет: передача ВнешнийКэшНКД в менеджер.
//
&ИзменениеИКонтроль("РасчетНДФЛ_ИнвестиционныйВычет")
Процедура IMDEV7330_NkdParam_РасчетНДФЛ_ИнвестиционныйВычет()
	
	НеУчитыватьИнвестВычет = НеУчитыватьИнвестВычет Или НеИспользуютсяИнвестВычетыПоПортфелям(СписокПортфелей, НалоговыйПериод, Дата); 
			
	Если Клиент.НеРезидент Или НеУчитыватьИнвестВычет Тогда
		ИнвестиционныйВычетПоПортфелям.Очистить();
		Возврат;
	КонецЕсли;      
	
	Если ВидОперации = Перечисления.ВидыОперацийНачислениеНДФЛ.ЗакрытыйИИС Тогда
		Возврат;
	КонецЕсли;
	
	#Удаление
	РезультатРасчетаИнвестиционногоВычета = Документы.НачислениеНДФЛПоУправляющейКомпании.РезультатРасчетаИнвестиционногоВычета(СписокПортфелей, УправляющаяКомпания, Клиент, НалоговыйПериод, Дата); 
	#КонецУдаления
	#Вставка
	// IMDEV-7330 Проброс кэша НКД из Перем объекта в менеджер.
	РезультатРасчетаИнвестиционногоВычета = Документы.НачислениеНДФЛПоУправляющейКомпании.РезультатРасчетаИнвестиционногоВычета(СписокПортфелей, УправляющаяКомпания, Клиент, НалоговыйПериод, Дата, ВнешнийКэшНКД); 
	#КонецВставки
	ИнвестиционныйВычет = РезультатРасчетаИнвестиционногоВычета.ИнвестиционныйВычет;
	РасшифровкаИнвестиционногоВычета = РезультатРасчетаИнвестиционногоВычета.РасшифровкаИнвестиционныйВычет;
	ТаблицаРасчета = РасшифровкаИнвестиционногоВычета.Расшифровка;
	
	ЗаполнитьСправкуРасчетПоИнвестиционнымВычетам(ТаблицаРасчета, РасшифровкаИнвестиционногоВычета);
	
	КодВычетаПоУмолчанию = Справочники.ВидыВычетовНДФЛ.Код618;
	ИнвестиционныйВычетПоПортфелямРасчет = РасшифровкаИнвестиционногоВычета.ИнвестиционныйВычетПоПортфелям;
	Для каждого СтрокаВычетаПоПортфелю Из ИнвестиционныйВычетПоПортфелямРасчет Цикл
		Если СтрокаВычетаПоПортфелю.Сумма > 0 Тогда
			НовСтрокаИнвестВычета = ИнвестиционныйВычетПоПортфелям.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаИнвестВычета, СтрокаВычетаПоПортфелю); 	
			НовСтрокаИнвестВычета.КодВычета = КодВычетаПоУмолчанию;
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры    


#КонецЕсли
