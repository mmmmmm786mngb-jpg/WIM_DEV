#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// IMDEV-7330 Проброс кэша НКД по стеку менеджера УК, отказ от ХранилищеЗначения.
// Диагностика 618 (версия расширения 1.0.0.2): события ЖР IMDEV-7330.Диагностика618 только для Платонова Д.В.

// Описание: Перехват РезультатРасчетаИнвестиционногоВычета - проброс ВнешнийКэшНКД.
//
// Параметры:
// СписокПортфелей - Массив - портфели расчёта
// УправляющаяКомпания - СправочникСсылка.УправляющиеКомпании
// Клиент - СправочникСсылка.Контрагенты
// НалоговыйПериод - СправочникСсылка.Периоды
// Дата - Дата - дата документа
// ВнешнийКэшНКД - Соответствие, Неопределено - кэш по КлючКэшаНКД
//
// Возвращаемое значение:
// Структура - типовой результат расчёта инвестиционного вычета
//
&ИзменениеИКонтроль("РезультатРасчетаИнвестиционногоВычета")
Функция IMDEV7330_NkdParam_РезультатРасчетаИнвестиционногоВычета(Знач СписокПортфелей, УправляющаяКомпания, Клиент, НалоговыйПериод, Дата, ВнешнийКэшНКД = Неопределено) Экспорт
		
	СписокПортфелейДляРасчетаИнвестВычета = СписокПортфелейДляРасчетаИнвестВычета(СписокПортфелей); 
	
	ТаблицаРасчетаВычета = РегистрыНакопления.ИнвестиционныйВычет.ТаблицаРасчетаВычета(СписокПортфелейДляРасчетаИнвестВычета, Дата);
	#Удаление
	ОтразитьУКДиНКДВИнвестВычете(ТаблицаРасчетаВычета, Клиент, Дата); 
	#КонецУдаления
	#Вставка
	// IMDEV-7330 Проброс внешнего кэша НКД.
	ОтразитьУКДиНКДВИнвестВычете(ТаблицаРасчетаВычета, Клиент, Дата, ВнешнийКэшНКД); 
	#КонецВставки
	ДополнитьИнвестВычетамиИзСтороннихСистем(ТаблицаРасчетаВычета, УправляющаяКомпания, Клиент, НалоговыйПериод);
	РезультатРасчетаИнвестиционногоВычета = РегистрыНакопления.ИнвестиционныйВычет.ИнвестиционныйВычет(ТаблицаРасчетаВычета);
	#Вставка
	// IMDEV-7330 Диагностика 618: итог после ИнвестиционныйВычет, только Платонов Д.В.
	Если IMDEV7330_NkdParam_ЭтоКлиентДиагностики618(Клиент) Тогда
		IMDEV7330_NkdParam_ЗаписатьИтогДиагностики618(Клиент, Дата, ВнешнийКэшНКД, РезультатРасчетаИнвестиционногоВычета);
	КонецЕсли;
	#КонецВставки
	Возврат РезультатРасчетаИнвестиционногоВычета;
	
КонецФункции  


// Описание: Перехват ОтразитьУКДиНКДВИнвестВычете - проброс ВнешнийКэшНКД.
//
&ИзменениеИКонтроль("ОтразитьУКДиНКДВИнвестВычете")
Процедура IMDEV7330_NkdParam_ОтразитьУКДиНКДВИнвестВычете(ТаблицаРасчетаВычета, Клиент, Дата, ВнешнийКэшНКД = Неопределено)
	
	#Вставка
	НуженЛог618 = IMDEV7330_NkdParam_ЭтоКлиентДиагностики618(Клиент);
	#КонецВставки
	
	Если Не ОбщегоНазначенияДУ.ЗначениеКонстанты("УчитыватьУКДиНКДПриРасчетеИнвестиционногоВычетаВНДФЛ") = Истина Тогда
		#Вставка
		Если НуженЛог618 Тогда
			IMDEV7330_NkdParam_ЗаписатьЖР618(
				"SKIP618 constant=off client=" + СокрЛП(Строка(Клиент))
					+ " date=" + Формат(Дата, "ДФ=yyyy-MM-dd"),
				Клиент);
		КонецЕсли;
		#КонецВставки
		Возврат;
	КонецЕсли;	
	
	ТаблицаПродаж = ТаблицаПродаж(ТаблицаРасчетаВычета.ВыгрузитьКолонку("ДокументПродажи"));
	
	ИнвестиционныйВычетНКДПриПогашенииИПродаже = ИнвестиционныйВычетНКДПриПогашении(ТаблицаРасчетаВычета, ТаблицаПродаж, Клиент, Дата);
	ИнвестиционныйВычетНКДПриПродаже = ИнвестиционныйВычетНКДПриПродаже(ТаблицаПродаж, Клиент, Дата);		
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ИнвестиционныйВычетНКДПриПродаже, ИнвестиционныйВычетНКДПриПогашенииИПродаже);
 	
	#Удаление
	ИнвестиционныйВычетУКД = ИнвестиционныйВычетУКД(Клиент, Дата);
	#КонецУдаления
	#Вставка
	// IMDEV-7330 Проброс внешнего кэша НКД.
	ИнвестиционныйВычетУКД = ИнвестиционныйВычетУКД(Клиент, Дата, ВнешнийКэшНКД);
	Если НуженЛог618 Тогда
		IMDEV7330_NkdParam_ЗаписатьЗаголовокДиагностики618(
			Клиент,
			Дата,
			ВнешнийКэшНКД,
			ТаблицаРасчетаВычета,
			ТаблицаПродаж,
			ИнвестиционныйВычетНКДПриПогашенииИПродаже,
			ИнвестиционныйВычетУКД);
	КонецЕсли;
	#КонецВставки
	
	Для каждого СтрВычета Из ТаблицаРасчетаВычета Цикл
		#Вставка
		СуммаРеализацииДо = СтрВычета.СуммаРеализации;
		СуммаПриобретенияДо = СтрВычета.СуммаПриобретения;
		#КонецВставки
		СтрокиПоПартии = ИнвестиционныйВычетНКДПриПогашенииИПродаже.НайтиСтроки(Новый Структура("Партия, Регистратор", СтрВычета.ДокументПокупки, СтрВычета.ДокументПродажи));
		Для каждого СтрокаПартии Из СтрокиПоПартии Цикл
			СтрВычета.СуммаРеализации = СтрВычета.СуммаРеализации + СтрокаПартии.Сумма;
			СтрВычета.НКД = СтрВычета.НКД + СтрокаПартии.Сумма;
		КонецЦикла; 
		
		СтрокиУКД = ИнвестиционныйВычетУКД.НайтиСтроки(Новый Структура("Партия, Регистратор", СтрВычета.ДокументПокупки, СтрВычета.ДокументПродажи));
		Для каждого СтрокаРасходаУКД Из СтрокиУКД Цикл
			УКД = Макс(СтрокаРасходаУКД.Сумма*-1,СтрокаРасходаУКД.Сумма);
			СтрВычета.СуммаПриобретения = СтрВычета.СуммаПриобретения + УКД;
			СтрВычета.УКД = СтрВычета.УКД + УКД;
		КонецЦикла;
		#Вставка
		Если НуженЛог618 Тогда
			IMDEV7330_NkdParam_ЗаписатьЛотДиагностики618(
				Клиент,
				Дата,
				ТаблицаРасчетаВычета.Индекс(СтрВычета) + 1,
				СтрВычета,
				СуммаРеализацииДо,
				СуммаПриобретенияДо,
				СтрокиПоПартии,
				СтрокиУКД);
		КонецЕсли;
		#КонецВставки
		
	КонецЦикла;
	
	#Вставка
	Если НуженЛог618 Тогда
		IMDEV7330_NkdParam_ЗаписатьНепривязанныйУКД618(Клиент, Дата, ТаблицаРасчетаВычета, ИнвестиционныйВычетУКД);
	КонецЕсли;
	#КонецВставки
	
КонецПроцедуры


// Описание: Перехват ИнвестиционныйВычетУКД - проброс ВнешнийКэшНКД.
//
&ИзменениеИКонтроль("ИнвестиционныйВычетУКД")
Функция IMDEV7330_NkdParam_ИнвестиционныйВычетУКД(Клиент, Дата, ВнешнийКэшНКД = Неопределено)	
	// IMDEV-7330-4 Один вызов с полным набором видов обращаемости, как при массовом предрасчёте расходов НКД по УК.
	ВидыДляИнвестВычета = ВидыОбращаемостиДляМассовогоКэшаНКДУК();

	#Удаление
	УКДПоПартиям = РасходыПоНКДПоВидуОбращаемости(ВидыДляИнвестВычета, Клиент, Дата).ПоРегистраторам;
	#КонецУдаления
	#Вставка
	// IMDEV-7330 Проброс внешнего кэша НКД в lookup расходов.
	УКДПоПартиям = РасходыПоНКДПоВидуОбращаемости(ВидыДляИнвестВычета, Клиент, Дата, ВнешнийКэшНКД).ПоРегистраторам;
	#КонецВставки

	Возврат УКДПоПартиям;
КонецФункции


// Описание: Перехват РасходыПоНКДПоВидуОбращаемости - lookup параметра вместо сеанса.
//
&ИзменениеИКонтроль("РасходыПоНКДПоВидуОбращаемости")
Функция IMDEV7330_NkdParam_РасходыПоНКДПоВидуОбращаемости(ВидыОбращаемости, Клиент, Дата, ВнешнийКэшНКД = Неопределено)
	
	#Удаление
	ВнешнийКэш = ПолучитьВнешнийКэшНКДРасходов();
	Если ВнешнийКэш <> Неопределено Тогда
		КлючКД = КлючКэшаНКД(Клиент, Дата);
		ПоКД = ВнешнийКэш.Получить(КлючКД);
		Если ПоКД <> Неопределено Тогда
			Возврат ПоКД;
		КонецЕсли;
	КонецЕсли;	
	#КонецУдаления
	#Вставка
	// IMDEV-7330 Lookup кэша из параметра, без ПараметрыСеанса.ОбщиеЗначения.
	Если ВнешнийКэшНКД <> Неопределено Тогда
		КлючКД = КлючКэшаНКД(Клиент, Дата);
		ПоКД = ВнешнийКэшНКД.Получить(КлючКД);
		Если ПоКД <> Неопределено Тогда
			Возврат ПоКД;
		КонецЕсли;
	КонецЕсли;
	#КонецВставки
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	ХозрасчетныйОборотыДтКт.СубконтоКт3 КАК Купон,
	 |	ХозрасчетныйОборотыДтКт.СубконтоКт2 КАК Облигация,
	 |	ХозрасчетныйОборотыДтКт.СуммаОборот КАК СуммаОборот
	 |ПОМЕСТИТЬ ОплаченныеКупоныЗаПериод
	 |ИЗ
	 |	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(&НачалоПериода, &КонецПериода, , СчетДт В (&СчетаДенежныхСредств), , СчетКт В (&РасчетыПоОблигациям), , Портфель.Клиент = &Клиент) КАК ХозрасчетныйОборотыДтКт
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ХозрасчетныйОбороты.Счет КАК Счет,
	 |	ХозрасчетныйОбороты.Субконто2 КАК ВидыОбращаемостиЦБ,
	 |	ХозрасчетныйОбороты.СуммаОборот КАК СуммаОборот,
	 |	ХозрасчетныйОбороты.СуммаНУОборот КАК СуммаНУОборот,
	 |	ХозрасчетныйОбороты.СуммаОборотДт КАК СуммаОборотДт,
	 |	ХозрасчетныйОбороты.СуммаНУОборотДт КАК СуммаНУОборотДт,
	 |	ХозрасчетныйОбороты.СуммаОборотКт КАК СуммаОборотКт,
	 |	ХозрасчетныйОбороты.СуммаНУОборотКт КАК СуммаНУОборотКт,
	 |	ХозрасчетныйОбороты.Субконто1 КАК Актив,
	 |	ХозрасчетныйОбороты.КорСчет КАК КорСчет,
	 |	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
	 |	ХозрасчетныйОбороты.Период КАК Период,
	 |	ХозрасчетныйОбороты.КорСубконто3 КАК Партия,
	 |	ХозрасчетныйОбороты.Субконто1.ВидАктива КАК ВидАктива,
	 |	ХозрасчетныйОбороты.Портфель КАК Портфель
	 |ПОМЕСТИТЬ ВТ_РасходыПоНКД
	 |ИЗ
	 |	РегистрБухгалтерии.Хозрасчетный.Обороты(&НачалоПериода, &КонецПериода, Регистратор, Счет В (&РасходыПоУплаченномуНКД), &ВидыСубконто, Портфель.Клиент = &Клиент, , ) КАК ХозрасчетныйОбороты
	 |ГДЕ
	 |	НЕ ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	 |
	 |ОБЪЕДИНИТЬ ВСЕ
	 |
	 |ВЫБРАТЬ
	 |	ХозрасчетныйОбороты.Счет,
	 |	ХозрасчетныйОбороты.Субконто2,
	 |	ХозрасчетныйОбороты.СуммаОборот,
	 |	ХозрасчетныйОбороты.СуммаНУОборот,
	 |	ХозрасчетныйОбороты.СуммаОборотДт,
	 |	ХозрасчетныйОбороты.СуммаНУОборотДт,
	 |	ХозрасчетныйОбороты.СуммаОборотКт,
	 |	ХозрасчетныйОбороты.СуммаНУОборотКт,
	 |	ХозрасчетныйОбороты.Субконто1,
	 |	ХозрасчетныйОбороты.КорСчет,
	 |	ХозрасчетныйОбороты.Регистратор,
	 |	ХозрасчетныйОбороты.Период,
	 |	ХозрасчетныйОбороты.КорСубконто3,
	 |	ХозрасчетныйОбороты.Субконто1.ВидАктива,
	 |	ХозрасчетныйОбороты.Портфель
	 |ИЗ
	 |	РегистрБухгалтерии.Хозрасчетный.Обороты(
	 |			,
	 |			&КонецПериода,
	 |			Регистратор,
	 |			Счет В (&РасходыПоУплаченномуНКД),
	 |			&ВидыСубконто,
	 |			Портфель.Клиент = &Клиент
	 |				И КорСубконто2 В
	 |					(ВЫБРАТЬ
	 |						ОплаченныеКупоныЗаПериод.Купон
	 |					ИЗ
	 |						ОплаченныеКупоныЗаПериод КАК ОплаченныеКупоныЗаПериод),
	 |			КорСчет В (&УплаченныйНКД),
	 |			) КАК ХозрасчетныйОбороты
	 |ГДЕ
	 |	ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	 |
	 |ОБЪЕДИНИТЬ ВСЕ
	 |
	 |ВЫБРАТЬ
	 |	ХозрасчетныйОбороты.Счет,
	 |	ХозрасчетныйОбороты.Субконто2,
	 |	ХозрасчетныйОбороты.СуммаОборот,
	 |	ХозрасчетныйОбороты.СуммаНУОборот,
	 |	ХозрасчетныйОбороты.СуммаОборотДт,
	 |	ХозрасчетныйОбороты.СуммаНУОборотДт,
	 |	ХозрасчетныйОбороты.СуммаОборотКт,
	 |	ХозрасчетныйОбороты.СуммаНУОборотКт,
	 |	ХозрасчетныйОбороты.Субконто1,
	 |	ХозрасчетныйОбороты.КорСчет,
	 |	ХозрасчетныйОбороты.Регистратор,
	 |	ХозрасчетныйОбороты.Период,
	 |	ХозрасчетныйОбороты.КорСубконто3,
	 |	ХозрасчетныйОбороты.Субконто1.ВидАктива,
	 |	ХозрасчетныйОбороты.Портфель
	 |ИЗ
	 |	РегистрБухгалтерии.Хозрасчетный.Обороты(
	 |			,
	 |			&КонецПериода,
	 |			Регистратор,
	 |			Счет В (&РасходыПоУплаченномуНКД),
	 |			&ВидыСубконто,
	 |			Портфель.Клиент = &Клиент
	 |				И КорСубконто3 В
	 |					(ВЫБРАТЬ
	 |						ОплаченныеКупоныЗаПериод.Купон
	 |					ИЗ
	 |						ОплаченныеКупоныЗаПериод КАК ОплаченныеКупоныЗаПериод),
	 |			КорСчет В (&РасчетыПоОблигациям),
	 |			) КАК ХозрасчетныйОбороты
	 |ГДЕ
	 |	ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ВТ_РасходыПоНКД.Счет КАК Счет,
	 |	ВТ_РасходыПоНКД.ВидыОбращаемостиЦБ КАК ВидыОбращаемостиЦБ,
	 |	ВТ_РасходыПоНКД.СуммаОборот КАК СуммаОборот,
	 |	ВЫБОР
	 |		КОГДА ЕСТЬNULL(ЗначенияПараметровПортфеляСрезПоследних.Значение, ЛОЖЬ) = ИСТИНА
	 |			ТОГДА ВТ_РасходыПоНКД.СуммаНУОборотДт
	 |		ИНАЧЕ ВТ_РасходыПоНКД.СуммаОборотДт
	 |	КОНЕЦ КАК СуммаОборотДт,
	 |	ВТ_РасходыПоНКД.СуммаОборотКт КАК СуммаОборотКт,
	 |	ВТ_РасходыПоНКД.Актив КАК Актив,
	 |	ВТ_РасходыПоНКД.КорСчет КАК КорСчет,
	 |	ВТ_РасходыПоНКД.Регистратор КАК Регистратор,
	 |	Облигации.Ссылка КАК Облигация,
	 |	Облигации.ДатаВыпуска КАК ДатаВыпуска,
	 |	Облигации.Эмитент.НеРезидент КАК ЭмитентНеРезидент,
	 |	Облигации.ВидАктива КАК ВидАктива,
	 |	Облигации.ВалютаНоминальнойСтоимости КАК ВалютаНоминальнойСтоимости,
	 |	ВТ_РасходыПоНКД.Актив В (&АктивыСЛьготируемымКДРоссийскихОрганизаций)
	 |		И ВТ_РасходыПоНКД.ВидыОбращаемостиЦБ В (&ОбращающиесяЦБ) КАК ЭтоЛьготируемаяОблигация,
	 |	ВТ_РасходыПоНКД.Актив В (&АктивыСЛьготируемымКДРоссийскихОрганизаций)
	 |		И ВТ_РасходыПоНКД.ВидыОбращаемостиЦБ В (&ОбращающиесяЦБ)
	 |		И (ВТ_РасходыПоНКД.Счет В (&ДоходыПоНКД)
	 |				И ВТ_РасходыПоНКД.КорСчет В (&РасчетыПоОблигациям)
	 |			ИЛИ ВТ_РасходыПоНКД.Счет В (&РасходыПоУплаченномуНКД)
	 |				И ВТ_РасходыПоНКД.КорСчет В (&УплаченныйНКД))
	 |		И ВТ_РасходыПоНКД.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента КАК ОтражатьСтрокуВ3023,
	 |	ВТ_РасходыПоНКД.Период КАК Период,
	 |	ВТ_РасходыПоНКД.Партия КАК Партия,
	 |	ВТ_РасходыПоНКД.Портфель КАК Портфель
	 |ПОМЕСТИТЬ РезультирующаяТаблица
	 |ИЗ
	 |	ВТ_РасходыПоНКД КАК ВТ_РасходыПоНКД
	 |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
	 |		ПО ВТ_РасходыПоНКД.Актив.Объект = Облигации.Ссылка
	 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПараметровПортфеля.СрезПоследних(
	 |				&КонецПериода,
	 |				Портфель.Клиент = &Клиент
	 |					И Параметр = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыПортфеля.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета)) КАК ЗначенияПараметровПортфеляСрезПоследних
	 |		ПО ВТ_РасходыПоНКД.Портфель = ЗначенияПараметровПортфеляСрезПоследних.Портфель
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	РезультирующаяТаблица.Актив КАК Актив,
	 |	СУММА(РезультирующаяТаблица.СуммаОборотДт) КАК Сумма,
	 |	РезультирующаяТаблица.Период КАК Период,
	 |	РезультирующаяТаблица.Партия КАК Партия,
	 |	РезультирующаяТаблица.Партия.Дата КАК ДатаПартии,
	 |	РезультирующаяТаблица.Регистратор КАК Регистратор
	 |ИЗ
	 |	РезультирующаяТаблица КАК РезультирующаяТаблица
	 |ГДЕ
	 |	РезультирующаяТаблица.Счет В(&РасходыПоУплаченномуНКД)
	 |	И РезультирующаяТаблица.ВидыОбращаемостиЦБ В(&ВидыОбращаемости)
	 |	И НЕ РезультирующаяТаблица.ОтражатьСтрокуВ3023
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	РезультирующаяТаблица.Актив,
	 |	РезультирующаяТаблица.Период,
	 |	РезультирующаяТаблица.Партия,
	 |	РезультирующаяТаблица.Партия.Дата,
	 |	РезультирующаяТаблица.Регистратор
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	РезультирующаяТаблица.Актив КАК Актив,
	 |	СУММА(РезультирующаяТаблица.СуммаОборотДт) КАК Сумма,
	 |	РезультирующаяТаблица.Период КАК Период,
	 |	РезультирующаяТаблица.Партия КАК Партия,
	 |	РезультирующаяТаблица.Партия.Дата КАК ДатаПартии
	 |ИЗ
	 |	РезультирующаяТаблица КАК РезультирующаяТаблица
	 |ГДЕ
	 |	РезультирующаяТаблица.Счет В(&РасходыПоУплаченномуНКД)
	 |	И РезультирующаяТаблица.ВидыОбращаемостиЦБ В(&ВидыОбращаемости)
	 |	И НЕ РезультирующаяТаблица.ОтражатьСтрокуВ3023
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	РезультирующаяТаблица.Актив,
	 |	РезультирующаяТаблица.Период,
	 |	РезультирующаяТаблица.Партия,
	 |	РезультирующаяТаблица.Партия.Дата";
		
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЦенныеБумаги);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВидыОбращаемостиЦБ);
	
	Запрос.УстановитьПараметр("РасчетыПоОблигациям", ПланыСчетов.Хозрасчетный.РасчетыПоОблигациям);
	Запрос.УстановитьПараметр("ДоходыПоНКД", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("91.01.02"));
	Запрос.УстановитьПараметр("РасходыПоУплаченномуНКД", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("91.02.02"));
	Запрос.УстановитьПараметр("УплаченныйНКД", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("76.05.1"));
	Запрос.УстановитьПараметр("АктивыСЛьготируемымКДРоссийскихОрганизаций", Новый Массив);	
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);	
	Запрос.УстановитьПараметр("АктивыСЛьготируемымКДРФИСоюзныхГосударств", Новый Массив);	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(Дата));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Дата));
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ОбращающиесяЦБ",Перечисления.ВидыОбращаемостиЦБ.ОбращающиесяВиды());
	ПС = ПланыСчетов.Хозрасчетный;
	СчетаДенежныхСредств = Новый Массив;
	СчетаДенежныхСредств.Добавить(ПС.РасчетныеСчета);
	СчетаДенежныхСредств.Добавить(ПС.ТекущиеСчета);
	СчетаДенежныхСредств.Добавить(ПС.ТранзитныеСчета);
	СчетаДенежныхСредств.Добавить(ПС.РасчетыБрокераПоСделкам55);
	СчетаДенежныхСредств.Добавить(ПС.РасчетыБрокераПоСделкам);

	Запрос.УстановитьПараметр("СчетаДенежныхСредств", СчетаДенежныхСредств);
	Запрос.УстановитьПараметр("ВидыОбращаемости", ВидыОбращаемости);

	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "НачислениеНДФЛПоПортфелю.РасходыПоНКДПоВидуОбращаемости");
	
	Пакет = Запрос.ВыполнитьПакет(); 
	
	РезультатЗапроса = Пакет[Пакет.Количество()-1].Выгрузить();
	Если Константы.РасходыОтУКДУменьшаютДоходы.Получить() = Истина Тогда
		Для каждого СтрокаРезультата Из РезультатЗапроса Цикл
			СтрокаРезультата.Сумма = -1*СтрокаРезультата.Сумма;
		КонецЦикла; 
	КонецЕсли;
	
	Возврат Новый Структура("ПоПартиям, ПоРегистраторам", РезультатЗапроса, Пакет[Пакет.Количество()-2].Выгрузить());

КонецФункции


// Описание: Признак клиента для точечной диагностики вычета 618 (Платонов Д.В.).
//
// Параметры:
// Клиент - СправочникСсылка.Контрагенты - клиент расчёта НДФЛ
//
// Возвращаемое значение:
// Булево - Истина, если пишем события IMDEV-7330.Диагностика618
//
Функция IMDEV7330_NkdParam_ЭтоКлиентДиагностики618(Клиент)
	
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяКлиента = СокрЛП(Строка(Клиент));
	Если СтрНайти(ИмяКлиента, "Платонов Дмитрий Вячеславович") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ИмяКлиента, "Платонов Д.В.") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Описание: Запись события диагностики 618 в журнал регистрации.
//
// Параметры:
// Комментарий - Строка - текст события
// Клиент - СправочникСсылка.Контрагенты, Неопределено - данные события
//
Процедура IMDEV7330_NkdParam_ЗаписатьЖР618(Комментарий, Клиент = Неопределено)
	
	ЗаписьЖурналаРегистрации(
		"IMDEV-7330.Диагностика618",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Справочники.Контрагенты,
		Клиент,
		Комментарий);
	
КонецПроцедуры

// Описание: Формат числа для строк диагностики 618.
