	 |	ВТ_РасходыПоНКД.Актив В (&АктивыСЛьготируемымКДРоссийскихОрганизаций)
	 |		И ВТ_РасходыПоНКД.ВидыОбращаемостиЦБ В (&ОбращающиесяЦБ) КАК ЭтоЛьготируемаяОблигация,
	 |	ВТ_РасходыПоНКД.Актив В (&АктивыСЛьготируемымКДРоссийскихОрганизаций)
	 |		И ВТ_РасходыПоНКД.ВидыОбращаемостиЦБ В (&ОбращающиесяЦБ)
	 |		И (ВТ_РасходыПоНКД.Счет В (&ДоходыПоНКД)
	 |				И ВТ_РасходыПоНКД.КорСчет В (&РасчетыПоОблигациям)
	 |			ИЛИ ВТ_РасходыПоНКД.Счет В (&РасходыПоУплаченномуНКД)
	 |				И ВТ_РасходыПоНКД.КорСчет В (&УплаченныйНКД))
	 |		И ВТ_РасходыПоНКД.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента КАК ОтражатьСтрокуВ3023,
	 |	ВТ_РасходыПоНКД.Период КАК Период,
	 |	ВТ_РасходыПоНКД.Партия КАК Партия,
	 |	ВТ_РасходыПоНКД.Портфель КАК Портфель
	 |ПОМЕСТИТЬ РезультирующаяТаблица
	 |ИЗ
	 |	ВТ_РасходыПоНКД КАК ВТ_РасходыПоНКД
	 |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
	 |		ПО ВТ_РасходыПоНКД.Актив.Объект = Облигации.Ссылка
	 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПараметровПортфеля.СрезПоследних(
	 |				&КонецПериода,
	 |				Портфель.Клиент = &Клиент
	 |					И Параметр = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПараметрыПортфеля.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета)) КАК ЗначенияПараметровПортфеляСрезПоследних
	 |		ПО ВТ_РасходыПоНКД.Портфель = ЗначенияПараметровПортфеляСрезПоследних.Портфель
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	РезультирующаяТаблица.Актив КАК Актив,
	 |	СУММА(РезультирующаяТаблица.СуммаОборотДт) КАК Сумма,
	 |	РезультирующаяТаблица.Период КАК Период,
	 |	РезультирующаяТаблица.Партия КАК Партия,
	 |	РезультирующаяТаблица.Партия.Дата КАК ДатаПартии,
	 |	РезультирующаяТаблица.Регистратор КАК Регистратор
	 |ИЗ
	 |	РезультирующаяТаблица КАК РезультирующаяТаблица
	 |ГДЕ
	 |	РезультирующаяТаблица.Счет В(&РасходыПоУплаченномуНКД)
	 |	И РезультирующаяТаблица.ВидыОбращаемостиЦБ В(&ВидыОбращаемости)
	 |	И НЕ РезультирующаяТаблица.ОтражатьСтрокуВ3023
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	РезультирующаяТаблица.Актив,
	 |	РезультирующаяТаблица.Период,
	 |	РезультирующаяТаблица.Партия,
	 |	РезультирующаяТаблица.Партия.Дата,
	 |	РезультирующаяТаблица.Регистратор
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	РезультирующаяТаблица.Актив КАК Актив,
	 |	СУММА(РезультирующаяТаблица.СуммаОборотДт) КАК Сумма,
	 |	РезультирующаяТаблица.Период КАК Период,
	 |	РезультирующаяТаблица.Партия КАК Партия,
	 |	РезультирующаяТаблица.Партия.Дата КАК ДатаПартии
	 |ИЗ
	 |	РезультирующаяТаблица КАК РезультирующаяТаблица
	 |ГДЕ
	 |	РезультирующаяТаблица.Счет В(&РасходыПоУплаченномуНКД)
	 |	И РезультирующаяТаблица.ВидыОбращаемостиЦБ В(&ВидыОбращаемости)
	 |	И НЕ РезультирующаяТаблица.ОтражатьСтрокуВ3023
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	РезультирующаяТаблица.Актив,
	 |	РезультирующаяТаблица.Период,
	 |	РезультирующаяТаблица.Партия,
	 |	РезультирующаяТаблица.Партия.Дата";
		
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЦенныеБумаги);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВидыОбращаемостиЦБ);
	
	Запрос.УстановитьПараметр("РасчетыПоОблигациям", ПланыСчетов.Хозрасчетный.РасчетыПоОблигациям);
	Запрос.УстановитьПараметр("ДоходыПоНКД", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("91.01.02"));
	Запрос.УстановитьПараметр("РасходыПоУплаченномуНКД", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("91.02.02"));
	Запрос.УстановитьПараметр("УплаченныйНКД", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("76.05.1"));
	Запрос.УстановитьПараметр("АктивыСЛьготируемымКДРоссийскихОрганизаций", Новый Массив);	
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);	
	Запрос.УстановитьПараметр("АктивыСЛьготируемымКДРФИСоюзныхГосударств", Новый Массив);	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(Дата));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Дата));
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ОбращающиесяЦБ",Перечисления.ВидыОбращаемостиЦБ.ОбращающиесяВиды());
	ПС = ПланыСчетов.Хозрасчетный;
	СчетаДенежныхСредств = Новый Массив;
	СчетаДенежныхСредств.Добавить(ПС.РасчетныеСчета);
	СчетаДенежныхСредств.Добавить(ПС.ТекущиеСчета);
	СчетаДенежныхСредств.Добавить(ПС.ТранзитныеСчета);
	СчетаДенежныхСредств.Добавить(ПС.РасчетыБрокераПоСделкам55);
	СчетаДенежныхСредств.Добавить(ПС.РасчетыБрокераПоСделкам);

	Запрос.УстановитьПараметр("СчетаДенежныхСредств", СчетаДенежныхСредств);
	Запрос.УстановитьПараметр("ВидыОбращаемости", ВидыОбращаемости);

	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "НачислениеНДФЛПоПортфелю.РасходыПоНКДПоВидуОбращаемости");
	
	Пакет = Запрос.ВыполнитьПакет(); 
	
	РезультатЗапроса = Пакет[Пакет.Количество()-1].Выгрузить();
	Если Константы.РасходыОтУКДУменьшаютДоходы.Получить() = Истина Тогда
		Для каждого СтрокаРезультата Из РезультатЗапроса Цикл
			СтрокаРезультата.Сумма = -1*СтрокаРезультата.Сумма;
		КонецЦикла; 
	КонецЕсли;
	
	Возврат Новый Структура("ПоПартиям, ПоРегистраторам", РезультатЗапроса, Пакет[Пакет.Количество()-2].Выгрузить());

КонецФункции


// Описание: Перехват РаспределитьПоПартиямСУчетомПродаж - стабильный FIFO перед раздачей остатка.
//
// Параметры:
// СтруктураРаспределения - Структура, СтрокаТаблицыЗначений - источник суммы распределения
// ТаблицаСПартиями - ТаблицаЗначений - партии продажи (порядок входа не используется)
// СвойствоСуммыРаспределения - Строка - имя колонки/свойства суммы (по умолчанию Сумма)
//
// Возвращаемое значение:
// ТаблицаЗначений - партии с распределённой суммой
//
&ИзменениеИКонтроль("РаспределитьПоПартиямСУчетомПродаж")
Функция IMDEV7330_NkdParam_РаспределитьПоПартиямСУчетомПродаж(СтруктураРаспределения, ТаблицаСПартиями, СвойствоСуммыРаспределения = "Сумма")

	ТаблицаПартий = ПустаяТаблицаПартий();
	ТаблицаПартий.Колонки.Добавить("Регистратор");
	
	#Вставка
	// IMDEV-7330 Остаток суммы относится на последнюю партию в стабильном FIFO-порядке.
	ТаблицаСПартиями.Сортировать("ДатаПартии, Партия, Актив, Регистратор");
	#КонецВставки
	
	НеРаспределенныйОстаток = ТаблицаСПартиями.Итог("Количество"); 
	НеРаспределеннаяСумма = СтруктураРаспределения[СвойствоСуммыРаспределения];
	ОбщийОстаток = ТаблицаСПартиями.Итог("Количество");
	
	Для каждого СтрокаОстатков Из ТаблицаСПартиями Цикл
		
		НоваяСтрокаПартии = ТаблицаПартий.Добавить();
		НоваяСтрокаПартии.Актив = СтрокаОстатков.Актив;
		НоваяСтрокаПартии.Партия = СтрокаОстатков.Партия;
		//НоваяСтрокаПартии.ВидОбращаемости = СтруткураРаспределения.ВидОбращаемости;
		НоваяСтрокаПартии.ДатаПартии = СтрокаОстатков.ДатаПартии;
		НоваяСтрокаПартии.Регистратор = СтрокаОстатков.Регистратор;
		
		Если НеРаспределенныйОстаток = СтрокаОстатков.Количество Тогда
			СуммаКУстановке = НеРаспределеннаяСумма;
		ИначеЕсли НеРаспределенныйОстаток = 0 Тогда 
			СуммаКУстановке = 0;
		Иначе	
			СуммаКУстановке = СтруктураРаспределения[СвойствоСуммыРаспределения] * СтрокаОстатков.Количество/ОбщийОстаток;	
		КонецЕсли;
		
		НоваяСтрокаПартии[СвойствоСуммыРаспределения] = СуммаКУстановке;
		НеРаспределеннаяСумма = НеРаспределеннаяСумма - СуммаКУстановке;
		НеРаспределенныйОстаток = НеРаспределенныйОстаток - СтрокаОстатков.Количество; 
	КонецЦикла; 
		
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(ТаблицаПартий, "НачислениеНДФЛПоПортфелю.РаспределитьНКДПоПартиям");

	Возврат ТаблицаПартий;
		
КонецФункции


// Описание: Перехват РаспределитьПревышениеПоТипуДохода - ветка шкалы по итогу кода, не по Найти.
//
// Параметры:
// ТаблицаНачислений - ТаблицаЗначений - начисления документа
// Параметры - Структура - тип дохода, ранее начисленный НДФЛ, порог
//
&ИзменениеИКонтроль("РаспределитьПревышениеПоТипуДохода")
Процедура IMDEV7330_NkdParam_РаспределитьПревышениеПоТипуДохода(ТаблицаНачислений, Параметры)
	
	ТипДохода13 = Параметры.ТипДохода13;
	ТипДохода15 = Параметры.ТипДохода15;
	РанееНачисленныйДоходПоДивидендам 	= Параметры.РанееНачисленныйДоходПоДивидендам;
	РанееНачисленныйДоходПоДивидендам13 = Параметры.РанееНачисленныйДоходПоДивидендам13;
	РанееНачисленныйНДФЛ = Параметры.РанееНачисленныйНДФЛ;
	ПревышениеНДФЛСчитатьОтНалогооблагаемойБазы = Параметры.ПревышениеНДФЛСчитатьОтНалогооблагаемойБазы;
	ЗачетПоСИДН = Параметры.ЗачетПоСИДН;
	
	Порог 		= РегистрыСведений.ПорогиПрогрессивнойШкалыПоНДФЛ.ПорогПоТипуДохода(ТипДохода13, Параметры.ДатаПорога);
	Ставка15 	= ТипДохода15.Ставка;  	
	
	ТаблицаПоТипуДохода = ТаблицаНачислений.Скопировать(Новый Структура("ТипДохода", ТипДохода13));   
	
	СуммаДохода 			= ТаблицаПоТипуДохода.Итог("СуммаДохода");
	СуммаКЗачету 			= ТаблицаПоТипуДохода.Итог("СуммаКЗачету");   
	
	НалогооблагаемаяCумма 	= ?(ПревышениеНДФЛСчитатьОтНалогооблагаемойБазы И Не ЗачетПоСИДН, СуммаДохода - СуммаКЗачету / 0.13, ТаблицаПоТипуДохода.Итог("НалогооблагаемаяCумма"));
	
	Превышение = НалогооблагаемаяCумма + РанееНачисленныйДоходПоДивидендам - Порог; 
	
	Если Окр(Превышение) >= 0 И ЗначениеЗаполнено(РанееНачисленныйНДФЛ) Тогда 
		СуммаДоходаПредшествующая = РанееНачисленныйНДФЛ.Итог("СуммаДоходаПредшествующая");	
		СуммаВычетаПредшествующая = РанееНачисленныйНДФЛ.Итог("СуммаВычетаПредшествующая");	
		ЭтоПервоеНачисление = СуммаДоходаПредшествующая = 0 И СуммаВычетаПредшествующая = 0;
		
		ИспользуемСтарыйМеханизм = ?(ЭтоПервоеНачисление, Истина, Ложь); 
		
		Если Не ПревышениеНДФЛСчитатьОтНалогооблагаемойБазы Тогда  
			ПревышениеБылоРанее = СуммаДоходаПредшествующая - СуммаВычетаПредшествующая - Порог > 0;
			Если Не ПревышениеБылоРанее Тогда // если превышение появилось только в текущем документе, используем старый механизм
			    ИспользуемСтарыйМеханизм = Истина;
			КонецЕсли; 
		КонецЕсли;
		
		РанееНачисленныйНДФЛПоКодам = РанееНачисленныйНДФЛ.Скопировать(Новый Структура("ТипДохода", ТипДохода13));	
    	РанееНачисленныйНДФЛПоКодам.Свернуть("КодДохода", "СуммаДоходаПредшествующая, СуммаВычетаПредшествующая");
		Для Каждого СтрокаРанееНачислено Из РанееНачисленныйНДФЛПоКодам Цикл  
			Если Не ЗначениеЗаполнено(СтрокаРанееНачислено.СуммаДоходаПредшествующая) И Не ЗначениеЗаполнено(СтрокаРанееНачислено.СуммаВычетаПредшествующая) Тогда
				Продолжить;
			КонецЕсли;
			
			#Удаление
			СтрокаНачислений = ТаблицаНачислений.Найти(СтрокаРанееНачислено.КодДохода, "КодДохода");  
			// если база уменьшилась, используем старый механизм
			Если СтрокаНачислений = Неопределено Тогда   
				ИспользуемСтарыйМеханизм = Истина;
				Прервать;
			КонецЕсли; 
			Если СтрокаНачислений.СуммаДохода < СтрокаРанееНачислено.СуммаДоходаПредшествующая Тогда
				ИспользуемСтарыйМеханизм = Истина;
				Прервать;
			КонецЕсли;
			Если СтрокаНачислений.СуммаВычета < СтрокаРанееНачислено.СуммаВычетаПредшествующая  Тогда
				ИспользуемСтарыйМеханизм = Истина;
				Прервать;
			КонецЕсли;
			#КонецУдаления
			#Вставка
			// IMDEV-7330 Ветку прогрессивной шкалы определяем по итогу кода дохода, а не по первой найденной строке.
			СтрокиКода = ТаблицаНачислений.НайтиСтроки(Новый Структура("КодДохода, ТипДохода",
				СтрокаРанееНачислено.КодДохода, ТипДохода13));
			Если СтрокиКода.Количество() > 1 Тогда
				ИспользуемСтарыйМеханизм = Истина;
				Прервать;
			КонецЕсли;
			СуммаДоходаПоКоду = 0;
			СуммаВычетаПоКоду = 0;
			Для Каждого СтрокаКода Из СтрокиКода Цикл
				СуммаДоходаПоКоду = СуммаДоходаПоКоду + СтрокаКода.СуммаДохода;
				СуммаВычетаПоКоду = СуммаВычетаПоКоду + СтрокаКода.СуммаВычета;
			КонецЦикла;
			Если СуммаДоходаПоКоду < СтрокаРанееНачислено.СуммаДоходаПредшествующая Тогда
				ИспользуемСтарыйМеханизм = Истина;
				Прервать;
			КонецЕсли;
			Если СуммаВычетаПоКоду < СтрокаРанееНачислено.СуммаВычетаПредшествующая Тогда
				ИспользуемСтарыйМеханизм = Истина;
				Прервать;
			КонецЕсли;
			#КонецВставки
		КонецЦикла;     
	Иначе
		ИспользуемСтарыйМеханизм = Истина;	
	КонецЕсли;               
	
	Если Окр(Превышение) >= 0 И ОКР(НалогооблагаемаяCумма) <> 0 И ПревышениеНДФЛСчитатьОтНалогооблагаемойБазы Тогда    
		Коэффициент13 = Макс((Порог - РанееНачисленныйДоходПоДивидендам)/ НалогооблагаемаяCумма, 0);
		Коэффициент15 = 1-Коэффициент13;
		Для Каждого СтрокаНачислений Из ТаблицаНачислений Цикл
			Если СтрокаНачислений.ТипДохода = ТипДохода13 Тогда  
				
				СуммаДоходаПоКоду 			= СтрокаНачислений.СуммаДохода;
				НалогооблагаемаяCуммаПоКоду = СтрокаНачислений.НалогооблагаемаяCумма;
				СуммаКЗачетуПоКоду 			= СтрокаНачислений.СуммаКЗачету;
				
				СтрокаНачислений.СуммаДохода 			= ОКР(СуммаДоходаПоКоду * Коэффициент13);
				СтрокаНачислений.НалогооблагаемаяCумма 	= ОКР(НалогооблагаемаяCуммаПоКоду * Коэффициент13, 2);
				СтрокаНачислений.СуммаКЗачету 			= ОКР(СуммаКЗачетуПоКоду * Коэффициент13);
				
				НоваяСтрока = ТаблицаНачислений.Добавить();
				НоваяСтрока.КодДохода				= СтрокаНачислений.КодДохода;
				НоваяСтрока.КодВычета 				= СтрокаНачислений.КодВычета;
				НоваяСтрока.ТипДохода 				= ТипДохода15;
				НоваяСтрока.Ставка 					= Ставка15;
				НоваяСтрока.КодВычета 				= СтрокаНачислений.КодВычета;
				НоваяСтрока.СуммаВычета 			= 0;         
				НоваяСтрока.СуммаДохода 			= ОКР(СуммаДоходаПоКоду * Коэффициент15);
				НоваяСтрока.НалогооблагаемаяCумма 	= ОКР(НалогооблагаемаяCуммаПоКоду * Коэффициент15, 2);
				НоваяСтрока.СуммаКЗачету 			= ОКР(СуммаКЗачетуПоКоду * Коэффициент15);
			КонецЕсли;
		КонецЦикла;		
		
	ИначеЕсли ИспользуемСтарыйМеханизм Тогда 		
		Для Каждого СтрокаНачислений Из ТаблицаНачислений Цикл
			
			Если Окр(Превышение) <=0 Тогда
				Прервать;
			КонецЕсли; 			
			
			Если СтрокаНачислений.ТипДохода = ТипДохода13 Тогда
				
				ПревышениеКРаспределению = Мин(СтрокаНачислений.НалогооблагаемаяCумма, Превышение);
				
				СтрокаНачислений.СуммаДохода = СтрокаНачислений.СуммаДохода - ПревышениеКРаспределению;
				СтрокаНачислений.НалогооблагаемаяCумма = СтрокаНачислений.НалогооблагаемаяCумма - ПревышениеКРаспределению;
				
				НоваяСтрока = ТаблицаНачислений.Добавить();
				НоваяСтрока.КодДохода = СтрокаНачислений.КодДохода;
				НоваяСтрока.КодВычета = СтрокаНачислений.КодВычета;
				НоваяСтрока.ТипДохода = ТипДохода15;
				НоваяСтрока.Ставка = Ставка15;
				НоваяСтрока.КодВычета = СтрокаНачислений.КодВычета;
				НоваяСтрока.СуммаДохода = ПревышениеКРаспределению;
				НоваяСтрока.СуммаВычета = 0;
				НоваяСтрока.НалогооблагаемаяCумма = ПревышениеКРаспределению;    
				
				Превышение = Превышение - ПревышениеКРаспределению;
				
			КонецЕсли;
			
		КонецЦикла; 
		
	Иначе         
		
		//В части 13% расчет должен повторять расчет в прошлом документе. 
		//В части 15% строки берут разницу "Общая сумма начислений - то, что распределили на13%".      
		
		Для Каждого СтрокаНачислений Из ТаблицаНачислений Цикл			
			Если СтрокаНачислений.ТипДохода = ТипДохода13 Тогда 
				
				СтрокаРанееНачислено 		= РанееНачисленныйНДФЛ.НайтиСтроки(Новый Структура("КодДохода, ТипДохода", СтрокаНачислений.КодДохода, СтрокаНачислений.ТипДохода));  
 
				СуммаДоходаКРаспределению 	= СтрокаНачислений.СуммаДохода - СтрокаРанееНачислено[0].СуммаДоходаПредшествующая;
				СуммаВычетаКРаспределению 	= СтрокаНачислений.СуммаВычета - СтрокаРанееНачислено[0].СуммаВычетаПредшествующая;
				
				СтрокаНачислений.СуммаДохода = СтрокаРанееНачислено[0].СуммаДоходаПредшествующая;
				СтрокаНачислений.СуммаВычета = СтрокаРанееНачислено[0].СуммаВычетаПредшествующая;
				СтрокаНачислений.НалогооблагаемаяCумма = СтрокаНачислений.СуммаДохода - СтрокаНачислений.СуммаВычета;      
				
				НоваяСтрока = ТаблицаНачислений.Добавить();
				НоваяСтрока.КодДохода = СтрокаНачислений.КодДохода;
				НоваяСтрока.КодВычета = СтрокаНачислений.КодВычета;
				НоваяСтрока.ТипДохода = ТипДохода15;
				НоваяСтрока.Ставка = Ставка15;
				НоваяСтрока.КодВычета = СтрокаНачислений.КодВычета;
				НоваяСтрока.СуммаДохода = СуммаДоходаКРаспределению;
				НоваяСтрока.СуммаВычета = СуммаВычетаКРаспределению;
				НоваяСтрока.НалогооблагаемаяCумма = НоваяСтрока.СуммаДохода - НоваяСтрока.СуммаВычета;    
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЕсли;

КонецПроцедуры


// Описание: Перехват РанееНачисленныйНДФЛ - свертка текущих начислений до полного соединения.
//
// Параметры:
// ТаблицаНачислений - ТаблицаЗначений - текущие начисления документа
// ПараметрыНачисления - Структура - клиент, УК, период, основание
//
// Возвращаемое значение:
// ТаблицаЗначений - текущие и предшествующие суммы по ключу кода
//
&ИзменениеИКонтроль("РанееНачисленныйНДФЛ")
Функция IMDEV7330_NkdParam_РанееНачисленныйНДФЛ(ТаблицаНачислений, ПараметрыНачисления) Экспорт
		
	Запрос = Новый Запрос;
	
	#Область ТекстЗапроса
	
	#Удаление
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.КодДохода КАК КодДохода,
	|	Таблица.КодВычета КАК КодВычета,
	|	Таблица.СуммаДохода КАК СуммаДохода,
	|	Таблица.СуммаВычета КАК СуммаВычета,
	|	Таблица.ТипДохода КАК ТипДохода,
	|	Таблица.Ставка КАК Ставка
	|ПОМЕСТИТЬ ВТ_Начисления
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Начисления.КодДохода КАК КодДохода,
	|	ВТ_Начисления.КодВычета КАК КодВычета,
	|	ВТ_Начисления.СуммаДохода КАК СуммаДохода,
	|	ВТ_Начисления.СуммаВычета КАК СуммаВычета,
	|	ВТ_Начисления.ТипДохода КАК ТипДохода,
	|	ВТ_Начисления.Ставка КАК Ставка
	|ПОМЕСТИТЬ ВТ_НачисленияПоДокументу
	|ИЗ
	|	ВТ_Начисления КАК ВТ_Начисления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.КодДохода КАК КодДохода,
	|	СУММА(НДФЛСведенияОДоходахПоУправляющейКомпании.СуммаДохода) КАК СуммаДохода,
	|	СУММА(НДФЛСведенияОДоходахПоУправляющейКомпании.СуммаВычета) КАК СуммаВычета,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.КодВычета КАК КодВычета,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.ТипДохода КАК ТипДохода,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка КАК Ставка
	|ПОМЕСТИТЬ ВТ_ПередыдущиеНачисления
	|ИЗ
	|	РегистрНакопления.НДФЛСведенияОДоходахПоУправляющейКомпании КАК НДФЛСведенияОДоходахПоУправляющейКомпании
	|ГДЕ
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.УправляющаяКомпания = &УправляющаяКомпания
	|	И НДФЛСведенияОДоходахПоУправляющейКомпании.Клиент = &Клиент
	|	И НДФЛСведенияОДоходахПоУправляющейКомпании.Период >= &НачалоПериода
	|	И НДФЛСведенияОДоходахПоУправляющейКомпании.Период < &КонецПериода
	|	И ВЫБОР
	|			КОГДА &ОснованиеНачислениеДивидендов
	|					И &НачислятьНДФЛПоУКПриПуловомПоступленииДивидендов
	|				ТОГДА ЛОЖЬ
	|			КОГДА &НачислятьНДФЛПоУКПриПуловомПоступленииДивидендов
	|				ТОГДА НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка <> &Ставка13Дивиденды
	|						И НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка <> &Ставка15Дивиденды
	|			КОГДА &ЭтоДоходПоПаям1530
	|				ТОГДА НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка <> &Ставка13Дивиденды
	|						И НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка <> &Ставка15Дивиденды
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И НЕ &ЭтоЗакрытиеИИС
	|	И НДФЛСведенияОДоходахПоУправляющейКомпании.НалоговыйПериод = &НалоговыйПериод
	|
	|СГРУППИРОВАТЬ ПО
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.КодВычета,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.КодДохода,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.ТипДохода,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.КодДохода, ВТ_ПередыдущиеНачисления.КодДохода) КАК КодДохода,
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.КодВычета, ВТ_ПередыдущиеНачисления.КодВычета) КАК КодВычета,
	|	СУММА(ЕСТЬNULL(ВТ_НачисленияПоДокументу.СуммаДохода, 0)) КАК СуммаДоходаПоДокументу,
	|	СУММА(ЕСТЬNULL(ВТ_НачисленияПоДокументу.СуммаВычета, 0)) КАК СуммаВычетаПоДокументу,
	|	СУММА(ЕСТЬNULL(ВТ_ПередыдущиеНачисления.СуммаДохода, 0)) КАК СуммаДоходаПредшествующая,
	|	СУММА(ЕСТЬNULL(ВТ_ПередыдущиеНачисления.СуммаВычета, 0)) КАК СуммаВычетаПредшествующая,
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.ТипДохода, ВТ_ПередыдущиеНачисления.ТипДохода) КАК ТипДохода,
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.Ставка, ВТ_ПередыдущиеНачисления.Ставка) КАК Ставка,
	|	СУММА(ЕСТЬNULL(ВТ_НачисленияПоДокументу.СуммаДохода, 0) - ЕСТЬNULL(ВТ_ПередыдущиеНачисления.СуммаДохода, 0)) КАК СуммаДохода
	|ИЗ
	|	ВТ_НачисленияПоДокументу КАК ВТ_НачисленияПоДокументу
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ПередыдущиеНачисления КАК ВТ_ПередыдущиеНачисления
	|		ПО ВТ_НачисленияПоДокументу.КодДохода = ВТ_ПередыдущиеНачисления.КодДохода
	|			И ВТ_НачисленияПоДокументу.КодВычета = ВТ_ПередыдущиеНачисления.КодВычета
	|			И ВТ_НачисленияПоДокументу.Ставка = ВТ_ПередыдущиеНачисления.Ставка
	|			И ВТ_НачисленияПоДокументу.ТипДохода = ВТ_ПередыдущиеНачисления.ТипДохода
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.КодДохода, ВТ_ПередыдущиеНачисления.КодДохода),
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.КодВычета, ВТ_ПередыдущиеНачисления.КодВычета),
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.ТипДохода, ВТ_ПередыдущиеНачисления.ТипДохода),
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.Ставка, ВТ_ПередыдущиеНачисления.Ставка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ставка,
	|	СуммаДохода
	|АВТОУПОРЯДОЧИВАНИЕ";
	#КонецУдаления
	#Вставка
	// IMDEV-7330 Перед соединением с ранее начисленным НДФЛ сворачиваем текущие начисления по ключу кода.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.КодДохода КАК КодДохода,
	|	Таблица.КодВычета КАК КодВычета,
	|	Таблица.СуммаДохода КАК СуммаДохода,
	|	Таблица.СуммаВычета КАК СуммаВычета,
	|	Таблица.ТипДохода КАК ТипДохода,
	|	Таблица.Ставка КАК Ставка
	|ПОМЕСТИТЬ ВТ_Начисления
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Начисления.КодДохода КАК КодДохода,
	|	ВТ_Начисления.КодВычета КАК КодВычета,
	|	СУММА(ВТ_Начисления.СуммаДохода) КАК СуммаДохода,
	|	СУММА(ВТ_Начисления.СуммаВычета) КАК СуммаВычета,
	|	ВТ_Начисления.ТипДохода КАК ТипДохода,
	|	ВТ_Начисления.Ставка КАК Ставка
	|ПОМЕСТИТЬ ВТ_НачисленияПоДокументу
	|ИЗ
	|	ВТ_Начисления КАК ВТ_Начисления
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Начисления.КодДохода,
	|	ВТ_Начисления.КодВычета,
	|	ВТ_Начисления.ТипДохода,
	|	ВТ_Начисления.Ставка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.КодДохода КАК КодДохода,
	|	СУММА(НДФЛСведенияОДоходахПоУправляющейКомпании.СуммаДохода) КАК СуммаДохода,
	|	СУММА(НДФЛСведенияОДоходахПоУправляющейКомпании.СуммаВычета) КАК СуммаВычета,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.КодВычета КАК КодВычета,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.ТипДохода КАК ТипДохода,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка КАК Ставка
	|ПОМЕСТИТЬ ВТ_ПередыдущиеНачисления
	|ИЗ
	|	РегистрНакопления.НДФЛСведенияОДоходахПоУправляющейКомпании КАК НДФЛСведенияОДоходахПоУправляющейКомпании
	|ГДЕ
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.УправляющаяКомпания = &УправляющаяКомпания
	|	И НДФЛСведенияОДоходахПоУправляющейКомпании.Клиент = &Клиент
	|	И НДФЛСведенияОДоходахПоУправляющейКомпании.Период >= &НачалоПериода
	|	И НДФЛСведенияОДоходахПоУправляющейКомпании.Период < &КонецПериода
	|	И ВЫБОР
	|			КОГДА &ОснованиеНачислениеДивидендов
	|					И &НачислятьНДФЛПоУКПриПуловомПоступленииДивидендов
	|				ТОГДА ЛОЖЬ
	|			КОГДА &НачислятьНДФЛПоУКПриПуловомПоступленииДивидендов
	|				ТОГДА НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка <> &Ставка13Дивиденды
	|						И НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка <> &Ставка15Дивиденды
	|			КОГДА &ЭтоДоходПоПаям1530
	|				ТОГДА НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка <> &Ставка13Дивиденды
	|						И НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка <> &Ставка15Дивиденды
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И НЕ &ЭтоЗакрытиеИИС
	|	И НДФЛСведенияОДоходахПоУправляющейКомпании.НалоговыйПериод = &НалоговыйПериод
	|
	|СГРУППИРОВАТЬ ПО
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.КодВычета,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.КодДохода,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.ТипДохода,
	|	НДФЛСведенияОДоходахПоУправляющейКомпании.Ставка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.КодДохода, ВТ_ПередыдущиеНачисления.КодДохода) КАК КодДохода,
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.КодВычета, ВТ_ПередыдущиеНачисления.КодВычета) КАК КодВычета,
	|	СУММА(ЕСТЬNULL(ВТ_НачисленияПоДокументу.СуммаДохода, 0)) КАК СуммаДоходаПоДокументу,
	|	СУММА(ЕСТЬNULL(ВТ_НачисленияПоДокументу.СуммаВычета, 0)) КАК СуммаВычетаПоДокументу,
	|	СУММА(ЕСТЬNULL(ВТ_ПередыдущиеНачисления.СуммаДохода, 0)) КАК СуммаДоходаПредшествующая,
	|	СУММА(ЕСТЬNULL(ВТ_ПередыдущиеНачисления.СуммаВычета, 0)) КАК СуммаВычетаПредшествующая,
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.ТипДохода, ВТ_ПередыдущиеНачисления.ТипДохода) КАК ТипДохода,
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.Ставка, ВТ_ПередыдущиеНачисления.Ставка) КАК Ставка,
	|	СУММА(ЕСТЬNULL(ВТ_НачисленияПоДокументу.СуммаДохода, 0) - ЕСТЬNULL(ВТ_ПередыдущиеНачисления.СуммаДохода, 0)) КАК СуммаДохода
	|ИЗ
	|	ВТ_НачисленияПоДокументу КАК ВТ_НачисленияПоДокументу
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ПередыдущиеНачисления КАК ВТ_ПередыдущиеНачисления
	|		ПО ВТ_НачисленияПоДокументу.КодДохода = ВТ_ПередыдущиеНачисления.КодДохода
	|			И ВТ_НачисленияПоДокументу.КодВычета = ВТ_ПередыдущиеНачисления.КодВычета
	|			И ВТ_НачисленияПоДокументу.Ставка = ВТ_ПередыдущиеНачисления.Ставка
	|			И ВТ_НачисленияПоДокументу.ТипДохода = ВТ_ПередыдущиеНачисления.ТипДохода
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.КодДохода, ВТ_ПередыдущиеНачисления.КодДохода),
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.КодВычета, ВТ_ПередыдущиеНачисления.КодВычета),
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.ТипДохода, ВТ_ПередыдущиеНачисления.ТипДохода),
	|	ЕСТЬNULL(ВТ_НачисленияПоДокументу.Ставка, ВТ_ПередыдущиеНачисления.Ставка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ставка,
	|	СуммаДохода
	|АВТОУПОРЯДОЧИВАНИЕ";
	#КонецВставки
	
	#КонецОбласти 
	
	НачислятьНДФЛПоУКПриПуловомПоступленииДивидендов 	= Константы.НачислятьНДФЛПоУКПриПуловомПоступленииДивидендов.Получить();       
	ДоходПоПаямУчитыватьВКодахДохода1530и1531 			= Константы.ДоходПоПаямУчитыватьВКодахДохода1530и1531.Получить();
	ОснованиеНачислениеДивидендов 						= ОснованиеНачислениеДивидендов(ПараметрыНачисления.ДокументОснование);
	ОснованиеНачислениеДивидендовПоПаям 				= ОснованиеНачислениеДивидендовПоПаям(ПараметрыНачисления.ДокументОснование);
	ЭтоДоходПоПаям1530									= ОснованиеНачислениеДивидендовПоПаям И ДоходПоПаямУчитыватьВКодахДохода1530и1531;
	ЭтоЗакрытиеИИС										= ПараметрыНачисления.ВидОперации = Перечисления.ВидыОперацийНачислениеНДФЛ.ЗакрытыйИИС;       
	
	Запрос.УстановитьПараметр("КонецПериода", Мин(ПараметрыНачисления.Дата, КонецДня(ПараметрыНачисления.НалоговыйПериод.ДатаОкончания)));
