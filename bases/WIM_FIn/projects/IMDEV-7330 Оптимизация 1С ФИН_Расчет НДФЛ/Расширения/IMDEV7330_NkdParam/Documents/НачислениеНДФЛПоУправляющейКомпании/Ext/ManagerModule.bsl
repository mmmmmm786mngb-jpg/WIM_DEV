// Описание: Представление ссылки лота для сравнения двух дампов ЖР.
//
// Параметры:
// ЗначениеКлюча - Произвольный - портфель, документ покупки или продажи
//
// Возвращаемое значение:
// Строка - представление и uid ссылки при возможности
//
Функция IMDEV7330_NkdParam_Ключ618(ЗначениеКлюча)
	
	Если Не ЗначениеЗаполнено(ЗначениеКлюча) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстКлюча = СокрЛП(Строка(ЗначениеКлюча));
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ЗначениеКлюча)) Тогда
		ТекстКлюча = ТекстКлюча + " uid=" + XMLСтрока(ЗначениеКлюча);
	КонецЕсли;
	
	Возврат ТекстКлюча;
	
КонецФункции

// Описание: Заголовок диагностики: кэш, объём УКД/НКД, число лотов.
//
Процедура IMDEV7330_NkdParam_ЗаписатьЗаголовокДиагностики618(
	Клиент,
	Дата,
	ВнешнийКэшНКД,
	ТаблицаРасчетаВычета,
	ТаблицаПродаж,
	ТаблицаНКД,
	ТаблицаУКД)
	
	ПараметрКэша = 0;
	ПопаданиеКэша = 0;
	Если ВнешнийКэшНКД <> Неопределено Тогда
		ПараметрКэша = 1;
		ЗначениеКэша = ВнешнийКэшНКД.Получить(КлючКэшаНКД(Клиент, Дата));
		Если ЗначениеКэша <> Неопределено Тогда
			ПопаданиеКэша = 1;
		КонецЕсли;
	КонецЕсли;
	
	УКДАбсВсего = 0;
	Для каждого СтрокаУКД Из ТаблицаУКД Цикл
		УКДАбсВсего = УКДАбсВсего + Макс(СтрокаУКД.Сумма * -1, СтрокаУКД.Сумма);
	КонецЦикла;
	
	СуммаНКДВсего = 0;
	Для каждого СтрокаНКД Из ТаблицаНКД Цикл
		СуммаНКДВсего = СуммаНКДВсего + СтрокаНКД.Сумма;
	КонецЦикла;
	
	Комментарий =
		"HDR618"
		+ " client=" + СокрЛП(Строка(Клиент))
		+ " date=" + Формат(Дата, "ДФ=yyyy-MM-dd")
		+ " cacheParam=" + Формат(ПараметрКэша, "ЧН=0;ЧГ=0")
		+ " cacheHit=" + Формат(ПопаданиеКэша, "ЧН=0;ЧГ=0")
		+ " lots=" + Формат(ТаблицаРасчетаВычета.Количество(), "ЧН=0;ЧГ=0")
		+ " sales=" + Формат(ТаблицаПродаж.Количество(), "ЧН=0;ЧГ=0")
		+ " nkdRows=" + Формат(ТаблицаНКД.Количество(), "ЧН=0;ЧГ=0")
		+ " nkdSum=" + IMDEV7330_NkdParam_Ч618(СуммаНКДВсего)
		+ " ukdRows=" + Формат(ТаблицаУКД.Количество(), "ЧН=0;ЧГ=0")
		+ " ukdAbs=" + IMDEV7330_NkdParam_Ч618(УКДАбсВсего);
	
	IMDEV7330_NkdParam_ЗаписатьЖР618(Комментарий, Клиент);
	
КонецПроцедуры

// Описание: Одна запись ЖР на лот ТаблицаРасчетаВычета после начисления НКД и УКД.
//
Процедура IMDEV7330_NkdParam_ЗаписатьЛотДиагностики618(
	Клиент,
	Дата,
	НомерЛота,
	СтрВычета,
	СуммаРеализацииДо,
	СуммаПриобретенияДо,
	СтрокиНКД,
	СтрокиУКД)
	
	СуммаНКД = 0;
	Для каждого СтрокаНКД Из СтрокиНКД Цикл
		СуммаНКД = СуммаНКД + СтрокаНКД.Сумма;
	КонецЦикла;
	
	СуммаУКДАбс = 0;
	Для каждого СтрокаУКД Из СтрокиУКД Цикл
		СуммаУКДАбс = СуммаУКДАбс + Макс(СтрокаУКД.Сумма * -1, СтрокаУКД.Сумма);
	КонецЦикла;
	
	ДоходОтПродажиЦБ = СтрВычета.СуммаРеализации - СтрВычета.ДопРасходы - СтрВычета.СуммаПриобретения;
	В618 = 0;
	Если ДоходОтПродажиЦБ > 0 Тогда
		В618 = 1;
	КонецЕсли;
	
	Комментарий =
		"LOT618"
		+ " n=" + Формат(НомерЛота, "ЧН=0;ЧГ=0")
		+ " date=" + Формат(Дата, "ДФ=yyyy-MM-dd")
		+ " pf=" + IMDEV7330_NkdParam_Ключ618(СтрВычета.Портфель)
		+ " buy=" + IMDEV7330_NkdParam_Ключ618(СтрВычета.ДокументПокупки)
		+ " sell=" + IMDEV7330_NkdParam_Ключ618(СтрВычета.ДокументПродажи)
		+ " asset=" + СокрЛП(Строка(СтрВычета.ЦеннаяБумага))
		+ " yrs=" + IMDEV7330_NkdParam_Ч618(СтрВычета.КоличествоЛет)
		+ " r0=" + IMDEV7330_NkdParam_Ч618(СуммаРеализацииДо)
		+ " a0=" + IMDEV7330_NkdParam_Ч618(СуммаПриобретенияДо)
		+ " exp=" + IMDEV7330_NkdParam_Ч618(СтрВычета.ДопРасходы)
		+ " nkdN=" + Формат(СтрокиНКД.Количество(), "ЧН=0;ЧГ=0")
		+ " nkdS=" + IMDEV7330_NkdParam_Ч618(СуммаНКД)
		+ " ukdN=" + Формат(СтрокиУКД.Количество(), "ЧН=0;ЧГ=0")
		+ " ukdS=" + IMDEV7330_NkdParam_Ч618(СуммаУКДАбс)
		+ " r1=" + IMDEV7330_NkdParam_Ч618(СтрВычета.СуммаРеализации)
		+ " a1=" + IMDEV7330_NkdParam_Ч618(СтрВычета.СуммаПриобретения)
		+ " nkd=" + IMDEV7330_NkdParam_Ч618(СтрВычета.НКД)
		+ " ukd=" + IMDEV7330_NkdParam_Ч618(СтрВычета.УКД)
		+ " gain=" + IMDEV7330_NkdParam_Ч618(ДоходОтПродажиЦБ)
		+ " in618=" + Формат(В618, "ЧН=0;ЧГ=0");
	
	IMDEV7330_NkdParam_ЗаписатьЖР618(Комментарий, Клиент);
	
КонецПроцедуры

// Описание: Строки УКД ПоРегистраторам, которые не попали ни в один лот вычета 3 года.
//
Процедура IMDEV7330_NkdParam_ЗаписатьНепривязанныйУКД618(Клиент, Дата, ТаблицаРасчетаВычета, ТаблицаУКД)
	
	НомерНепривязанной = 0;
	АбсНепривязанных = 0;
	
	Для каждого СтрокаУКД Из ТаблицаУКД Цикл
		
		Лоты = ТаблицаРасчетаВычета.НайтиСтроки(
			Новый Структура("ДокументПокупки, ДокументПродажи", СтрокаУКД.Партия, СтрокаУКД.Регистратор));
		Если Лоты.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НомерНепривязанной = НомерНепривязанной + 1;
		УКДАбс = Макс(СтрокаУКД.Сумма * -1, СтрокаУКД.Сумма);
		АбсНепривязанных = АбсНепривязанных + УКДАбс;
		
		Комментарий =
			"UNM618"
			+ " n=" + Формат(НомерНепривязанной, "ЧН=0;ЧГ=0")
			+ " date=" + Формат(Дата, "ДФ=yyyy-MM-dd")
			+ " party=" + IMDEV7330_NkdParam_Ключ618(СтрокаУКД.Партия)
			+ " reg=" + IMDEV7330_NkdParam_Ключ618(СтрокаУКД.Регистратор)
			+ " sumRaw=" + IMDEV7330_NkdParam_Ч618(СтрокаУКД.Сумма)
			+ " abs=" + IMDEV7330_NkdParam_Ч618(УКДАбс);
		
		IMDEV7330_NkdParam_ЗаписатьЖР618(Комментарий, Клиент);
		
	КонецЦикла;
	
	Комментарий =
		"UNMSUM618"
		+ " date=" + Формат(Дата, "ДФ=yyyy-MM-dd")
		+ " unmatchedN=" + Формат(НомерНепривязанной, "ЧН=0;ЧГ=0")
		+ " unmatchedAbs=" + IMDEV7330_NkdParam_Ч618(АбсНепривязанных);
	IMDEV7330_NkdParam_ЗаписатьЖР618(Комментарий, Клиент);
	
КонецПроцедуры

// Описание: Итог вычета 618 после ИнвестиционныйВычет, по портфелям.
//
Процедура IMDEV7330_NkdParam_ЗаписатьИтогДиагностики618(Клиент, Дата, ВнешнийКэшНКД, РезультатРасчета)
	
	ПараметрКэша = ?(ВнешнийКэшНКД = Неопределено, 0, 1);
	Расшифровка = РезультатРасчета.РасшифровкаИнвестиционныйВычет;
	
	Комментарий =
		"FIN618"
		+ " client=" + СокрЛП(Строка(Клиент))
		+ " date=" + Формат(Дата, "ДФ=yyyy-MM-dd")
		+ " cacheParam=" + Формат(ПараметрКэша, "ЧН=0;ЧГ=0")
		+ " vychet=" + IMDEV7330_NkdParam_Ч618(РезультатРасчета.ИнвестиционныйВычет)
		+ " limit=" + IMDEV7330_NkdParam_Ч618(Расшифровка.ПредельныйРазмер)
