// IMDEV-7330 Fix D-2: сброс сеансового кэша НКД перед ранними Возврат в РассчитатьНДФЛ.

// Описание: Перед ранними Возврат (незаполненный клиент/УК или пустой список портфелей)
//           сбрасывает внешний кэш НКД, чтобы он не «залипал» в ПараметрыСеанса.ОбщиеЗначения.
//
&ИзменениеИКонтроль("РассчитатьНДФЛ")
Процедура IMDEV7330_Fix_РассчитатьНДФЛ() Экспорт

	Если Не ПроверитьЗаполнениеУКИКлиента() Тогда
		#Вставка
		Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьВнешнийКэшНКДРасходов(Неопределено);
		#КонецВставки
		Возврат;
	КонецЕсли; 
	
	ОчиститьДокумент();
	ИнициализироватьПеременные();	
	
	ЗаполнитьШапкуСправкиРасчета();
	
	Если Не НачислениеНДФЛПоПортфелю Тогда
		
		Если СписокПортфелей.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены портфели для расчета");
			#Вставка
			Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьВнешнийКэшНКДРасходов(Неопределено);
			#КонецВставки
			Возврат;
		КонецЕсли; 
				
		ПогашенныйКупонныйДоходУчитыватьВКодахДохода1530и1531 	= Константы.ПогашенныйКупонныйДоходУчитыватьВКодахДохода1530и1531.Получить();
		ДоходПоПаямУчитыватьВКодахДохода1530и1531 				= Константы.ДоходПоПаямУчитыватьВКодахДохода1530и1531.Получить();
		
		ТаблицаНачислений = Документы.НачислениеНДФЛПоУправляющейКомпании.ПустаяТаблицаНачислений();
				
		РасчетНДФЛ_СведенияИзВнешнейСистемы(ТаблицаНачислений);	
		ДанныеПрошлыхУК = ТаблицаНачислений.Скопировать();
		
		РасчетНДФЛ_ПоОбращающимсяЦБ(ТаблицаНачислений);
		РасчетНДФЛ_ПоНеОбращающимсяЦБ(ТаблицаНачислений);
		РасчетНДФЛ_ПоСрочнымКонтрактам(ТаблицаНачислений);
		РасчетНДФЛ_ПоДепозитам(ТаблицаНачислений);
		РасчетНДФЛ_ПоПогашеннымКупонам(ТаблицаНачислений);
		РасчетНДФЛ_ПоРЕПО(ТаблицаНачислений);
		РасчетНДФЛ_ПоОперациямСВалютой(ТаблицаНачислений);
		РасчетНДФЛ_ПоДивидендам(ТаблицаНачислений);
		Документы.НачислениеНДФЛПоУправляющейКомпании.ДополнитьТаблицуТипомДоходаИлиСтавкой(ТаблицаНачислений, Клиент);
		 			
	Иначе
		
		ТаблицаНачислений = Документы.НачислениеНДФЛПоУправляющейКомпании.НачисленияПоПортфелям(УправляющаяКомпания, Клиент, Дата, , СписокПортфелей);
	
	КонецЕсли;  
	
	НачисленияИзСтороннихСистем = Документы.НачислениеНДФЛПоУправляющейКомпании.НачисленияИзСтороннихСистем(УправляющаяКомпания, Клиент, Дата);  
	СуммаЛьготИзСтороннихСистем = Документы.НачислениеНДФЛПоПортфелю.СуммаЛьготИзСтороннихСистем(НачисленияИзСтороннихСистем); 
	ЛимитДляЛьгот 				= РегистрыСведений.ЛимитДляЛьготЦБВысокотехнологичногоСектора.ЛимитНаДату(Дата) - СуммаЛьготИзСтороннихСистем;

	Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьЛимитЛьготПоКодам_2792_2793(ТаблицаНачислений, ЛимитДляЛьгот);  
	
	РасчетНДФЛ_ИнвестиционныйВычет();
	Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьОбщийДоход(ТаблицаНачислений);
	Документы.НачислениеНДФЛПоУправляющейКомпании.УдалитьИсключаемыеКоды(ТаблицаНачислений);  
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(ТаблицаНачислений, "НачислениеНДФЛПоУправляющейКомпании: РассчитатьНДФЛ.ТаблицаНачислений");
	
	РассчитатьНДФЛПоНачислениям(ТаблицаНачислений, , ДанныеПрошлыхУК);  
	
	Документы.НачислениеНДФЛПоУправляющейКомпании.УстановитьВнешнийКэшНКДРасходов(Неопределено);
	
КонецПроцедуры
