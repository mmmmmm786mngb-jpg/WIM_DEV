// Описание: Перехват типовой РасходыПоНКДПоВидуОбращаемости с ранним возвратом из внешнего кэша.
// Если в хранилище сеанса есть кэш по паре (Клиент, Дата), возвращаем результат до выполнения
// тяжёлого пакета запросов, отфильтровав строки по переданным видам обращаемости.
// При отсутствии кэша или отсутствии записи по ключу  - типовой путь через ПродолжитьВызов().
//
&Вместо("РасходыПоНКДПоВидуОбращаемости")
Функция NDFL_RDU_РасходыПоНКДПоВидуОбращаемости(ВидыОбращаемости, Клиент, Дата)

	ВнешнийКэш = NDFL_RDU_ПолучитьВнешнийКэшНКДРасходов();
	Если ВнешнийКэш <> Неопределено Тогда
		КлючКД = NDFL_RDU_КлючКэшаНКД(Клиент, КонецДня(Дата));
		ПоКД   = ВнешнийКэш.Получить(КлючКД);
		Если ПоКД <> Неопределено Тогда
			Возврат ПоКД;
		КонецЕсли;
	КонецЕсли;

	Возврат ПродолжитьВызов(ВидыОбращаемости, Клиент, Дата);

КонецФункции

// Описание: Группирует входной массив пар (Клиент, Дата) по дате (с приведением к КонецДня).
// Для каждой даты возвращает массив уникальных клиентов этой даты.
//
// Параметры:
//   МассивПарКлиентДата - Массив - элементы Структура("Клиент, Дата").
//
// Возвращаемое значение:
//   Соответствие - ключ Дата (КонецДня), значение Массив СправочникСсылка.Контрагенты.
//
&НаСервере
Функция NDFL_RDU_РазложитьПарыПоДате(МассивПарКлиентДата)

	ПарыПоДате       = Новый Соответствие;
	УникальностьПары = Новый Соответствие; // Соответствие(Дата + "|" + ИдКлиент) для антидубля.

	Для Каждого Пара Из МассивПарКлиентДата Цикл

		Дата    = КонецДня(Пара.Дата);
		Клиент  = Пара.Клиент;

		КлючПары = Формат(Дата, "ДФ=yyyyMMddHHmmss") + "|"
			+ Строка(Клиент.УникальныйИдентификатор());
		Если УникальностьПары.Получить(КлючПары) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УникальностьПары.Вставить(КлючПары, Истина);

		Клиенты = ПарыПоДате.Получить(Дата);
		Если Клиенты = Неопределено Тогда
			Клиенты = Новый Массив;
			ПарыПоДате.Вставить(Дата, Клиенты);
		КонецЕсли;
		Клиенты.Добавить(Клиент);

	КонецЦикла;

	Возврат ПарыПоДате;

КонецФункции

// Описание: Возвращает копию строк ТЗ для одного клиента (фильтр по полю Клиент)
// с удалением служебной колонки Клиент. Один проход по таблице.
//
&НаСервере
Функция NDFL_RDU_СтрокиПоКлиенту(ТЗ, Клиент)

	Если ТЗ.Колонки.Найти("Клиент") = Неопределено Тогда
		Возврат ТЗ.Скопировать();
	КонецЕсли;

	Результат = ТЗ.СкопироватьКолонки();
	Результат.Колонки.Удалить("Клиент");

	Для Каждого Стр Из ТЗ Цикл
		Если Стр.Клиент = Клиент Тогда
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Описание: Строковый ключ Соответствия для пары (Клиент, Дата). Используется и при
// заполнении кэша, и при коротком замыкании в перехвате РасходыПоНКДПоВидуОбращаемости.
//
&НаСервере
Функция NDFL_RDU_КлючКэшаНКД(Клиент, Дата) Экспорт

	Возврат Строка(Клиент.УникальныйИдентификатор())
		+ "|" + Формат(КонецДня(Дата), "ДФ=yyyyMMddHHmmss");

КонецФункции

#КонецОбласти

#Область IMDEV7330_ЗащёлкаВнешнегоКэшаНКД

// Описание: Установка/получение значения внешнего кэша расходов НКД на время сеанса.
// В модуле менеджера нет модульных переменных, поэтому сохраняем значение в
// ПараметрыСеанса.ОбщиеЗначения по ключу NDFL_RDU_КэшНКД.
//
&НаСервере
Процедура NDFL_RDU_УстановитьВнешнийКэшНКДРасходов(Знач Кэш) Экспорт
	КлючКэша = "NDFL_RDU_КэшНКД";

	Если ПараметрыСеанса.ОбщиеЗначения = Неопределено Тогда
		ПараметрыСеанса.ОбщиеЗначения = Новый ХранилищеЗначения(Новый Соответствие);
	КонецЕсли;

	ОбщиеЗначения = ПараметрыСеанса.ОбщиеЗначения.Получить();
	Если ТипЗнч(ОбщиеЗначения) <> Тип("Соответствие") Тогда
		ОбщиеЗначения = Новый Соответствие;
	КонецЕсли;

	Если Кэш = Неопределено Тогда
		Если ОбщиеЗначения.Получить(КлючКэша) <> Неопределено Тогда
			ОбщиеЗначения.Удалить(КлючКэша);
		КонецЕсли;
	Иначе
		ОбщиеЗначения.Вставить(КлючКэша, Кэш);
	КонецЕсли;

	ПараметрыСеанса.ОбщиеЗначения = Новый ХранилищеЗначения(ОбщиеЗначения);
КонецПроцедуры

&НаСервере
Функция NDFL_RDU_ПолучитьВнешнийКэшНКДРасходов() Экспорт
	КлючКэша = "NDFL_RDU_КэшНКД";

	Если ПараметрыСеанса.ОбщиеЗначения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбщиеЗначения = ПараметрыСеанса.ОбщиеЗначения.Получить();
	Если ТипЗнч(ОбщиеЗначения) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщиеЗначения.Получить(КлючКэша);
КонецФункции

#КонецОбласти

