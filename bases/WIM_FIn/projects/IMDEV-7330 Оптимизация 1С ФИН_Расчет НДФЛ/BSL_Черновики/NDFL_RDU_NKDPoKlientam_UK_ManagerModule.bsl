// Черновик для переноса в расширение NDFL_RDU: модуль менеджера документа НачислениеНДФЛПоУправляющейКомпании.
// Исходная логика  - в базовой конфигурации WIM_FIn (типовая функция РасходыПоНКДПоВидуОбращаемости).
//
// Назначение: массовый предрасчёт по массиву клиентов на одну дату  - один пакет запросов вместо
// многократных вызовов на пары (клиент и документ начисления). Задача IMDEV-7330.
//
// Состав:
//   1) NDFL_RDU_РасходыПоНКДПоКлиентамИДате  - массовый текст запроса с Портфель.Клиент В (...)
//                                              и колонкой Клиент в финальных группировках.
//   2) NDFL_RDU_РазложитьПарыПоДате           - группирует входной массив пар по дате.
//   3) NDFL_RDU_СтрокиПоКлиенту               - копия строк таблицы значений по отбору по клиенту.
//   4) NDFL_RDU_КлючКэшаНКД                   - строковый ключ соответствия кэша.
//   5) NDFL_RDU_ПолучитьРасходыПоНКДПоКлиентам - сбор кэша по датам и клиентам.
//   6) NDFL_RDU_РасходыПоНКДПоВидуОбращаемости - перехват: при наличии данных в кэше возврат без запроса (без копирования таблиц).
//
// Целевой файл расширения: модуль менеджера документа НачислениеНДФЛПоУправляющейКомпании.
// Значение кэша из перехвата РассчитатьНДФЛ хранится в ПараметрыСеанса.ОбщиеЗначения
// (хранилище значения со структурой соответствия, как в базовой конфигурации).

#Область IMDEV7330_МассовыйПредрасчётРасходовНКД

// Описание: Возвращает кэш расходов по НКД по массиву пар (Клиент, Дата).
// Один пакетный запрос на каждую уникальную дату по массиву клиентов этой даты.
//
// Параметры:
//   МассивПарКлиентДата - Массив - элементы Структура("Клиент, Дата"):
//                                  Клиент - СправочникСсылка.Контрагенты,
//                                  Дата   - Дата (используется КонецДня(Дата)).
//
// Возвращаемое значение:
//   Соответствие - ключ Строка (NDFL_RDU_КлючКэшаНКД(Клиент, Дата)),
//                  значение Структура("ПоПартиям, ПоРегистраторам") по этому клиенту
//                  с тем же набором колонок, что и тип. РасходыПоНКДПоВидуОбращаемости,
//                  но без фильтра по видам обращаемости (отбор по видам выполняется в перехвате
//                  NDFL_RDU_РасходыПоНКДПоВидуОбращаемости при обращении к кэшу).
//
&НаСервере
Функция NDFL_RDU_ПолучитьРасходыПоНКДПоКлиентам(МассивПарКлиентДата) Экспорт

	Результат = Новый Соответствие;

	Если МассивПарКлиентДата.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПарыПоДате = NDFL_RDU_РазложитьПарыПоДате(МассивПарКлиентДата);

	Для Каждого Эл Из ПарыПоДате Цикл
		ТекДата    = Эл.Ключ;
		КлиентыТЗ  = Эл.Значение; // Массив СправочникСсылка.Контрагенты на дату.

		Если КлиентыТЗ.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтруктураИтог = NDFL_RDU_РасходыПоНКДПоКлиентамИДате(КлиентыТЗ, ТекДата);

		Для Каждого Клиент Из КлиентыТЗ Цикл
			КлючКД    = NDFL_RDU_КлючКэшаНКД(Клиент, ТекДата);
			ПоКлиенту = Новый Структура;
			ПоКлиенту.Вставить("ПоПартиям",       NDFL_RDU_СтрокиПоКлиенту(СтруктураИтог.ПоПартиям, Клиент));
			ПоКлиенту.Вставить("ПоРегистраторам", NDFL_RDU_СтрокиПоКлиенту(СтруктураИтог.ПоРегистраторам, Клиент));
			Результат.Вставить(КлючКД, ПоКлиенту);
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Описание: Один пакетный запрос РасходыПоНКД по массиву клиентов и единой дате.
// Фильтрация по видам обращаемости не выполняется в тексте запроса  - кэш покрывает все три
// сценария вызова (обращающиеся, необращающиеся, объединение из NDFL_RDU_ИнвестиционныйВычетУКД).
//
// Параметры:
//   МассивКлиентов - Массив - СправочникСсылка.Контрагенты, фильтр для Портфель.Клиент.
//   Дата           - Дата   - дата документа начисления; используется
//                             НачалоПериода = НачалоГода(Дата),
//                             КонецПериода  = КонецДня(Дата).
//
// Возвращаемое значение:
//   Структура("ПоПартиям, ПоРегистраторам") - таблицы значений с колонкой Клиент.
//
&НаСервере
Функция NDFL_RDU_РасходыПоНКДПоКлиентамИДате(МассивКлиентов, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст = NDFL_RDU_РасходыПоНКДПоКлиентамИДатеТекстЗапроса();

	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЦенныеБумаги);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВидыОбращаемостиЦБ);

	ПС = ПланыСчетов.Хозрасчетный;
	СчетаДенежныхСредств = Новый Массив;
	СчетаДенежныхСредств.Добавить(ПС.РасчетныеСчета);
	СчетаДенежныхСредств.Добавить(ПС.ТекущиеСчета);
	СчетаДенежныхСредств.Добавить(ПС.ТранзитныеСчета);
	СчетаДенежныхСредств.Добавить(ПС.РасчетыБрокераПоСделкам55);
	СчетаДенежныхСредств.Добавить(ПС.РасчетыБрокераПоСделкам);

	Запрос.УстановитьПараметр("РасчетыПоОблигациям",                  ПС.РасчетыПоОблигациям);
	Запрос.УстановитьПараметр("ДоходыПоНКД",                          ПС.СчетаПоСтроке("91.01.02"));
	Запрос.УстановитьПараметр("РасходыПоУплаченномуНКД",              ПС.СчетаПоСтроке("91.02.02"));
	Запрос.УстановитьПараметр("УплаченныйНКД",                        ПС.СчетаПоСтроке("76.05.1"));
	Запрос.УстановитьПараметр("СчетаДенежныхСредств",                 СчетаДенежныхСредств);
	Запрос.УстановитьПараметр("ВидыСубконто",                         ВидыСубконто);
	Запрос.УстановитьПараметр("АктивыСЛьготируемымКДРоссийскихОрганизаций", Новый Массив);
	Запрос.УстановитьПараметр("ОбращающиесяЦБ",                       Перечисления.ВидыОбращаемостиЦБ.ОбращающиесяВиды());
	Запрос.УстановитьПараметр("НачалоПериода",                        НачалоГода(Дата));
	Запрос.УстановитьПараметр("КонецПериода",                         КонецДня(Дата));
	Запрос.УстановитьПараметр("МассивКлиентов",                       МассивКлиентов);

	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос,
		"НачислениеНДФЛПоУправляющейКомпании.NDFL_RDU_РасходыПоНКДПоКлиентамИДате");

	Пакет = Запрос.ВыполнитьПакет();

	ПоРегистраторам = Пакет[Пакет.Количество() - 2].Выгрузить();
	ПоПартиям       = Пакет[Пакет.Количество() - 1].Выгрузить();

	Если Константы.РасходыОтУКДУменьшаютДоходы.Получить() = Истина Тогда
		Для Каждого Стр Из ПоПартиям Цикл
			Стр.Сумма = -1 * Стр.Сумма;
		КонецЦикла;
		Для Каждого Стр Из ПоРегистраторам Цикл
			Стр.Сумма = -1 * Стр.Сумма;
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("ПоПартиям, ПоРегистраторам", ПоПартиям, ПоРегистраторам);

КонецФункции

// Описание: Текст массового запроса РасходыПоНКД по массиву клиентов и единой дате.
// Вынесен из NDFL_RDU_РасходыПоНКДПоКлиентамИДате для уменьшения длины метода и
// удобства правок текста запроса. Все параметры устанавливаются в вызывающей функции.
//
&НаСервере
Функция NDFL_RDU_РасходыПоНКДПоКлиентамИДатеТекстЗапроса()

	Возврат
	"ВЫБРАТЬ
	|	ХозрасчетныйОборотыДтКт.Портфель.Клиент КАК Клиент,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3 КАК Купон,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт2 КАК Облигация,
	|	ХозрасчетныйОборотыДтКт.СуммаОборот КАК СуммаОборот
	|ПОМЕСТИТЬ ОплаченныеКупоныЗаПериод
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			СчетДт В (&СчетаДенежныхСредств),
	|			,
	|			СчетКт В (&РасчетыПоОблигациям),
	|			,
	|			Портфель.Клиент В (&МассивКлиентов)) КАК ХозрасчетныйОборотыДтКт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Портфель.Клиент КАК Клиент,
	|	ХозрасчетныйОбороты.Счет КАК Счет,
	|	ХозрасчетныйОбороты.Субконто2 КАК ВидыОбращаемостиЦБ,
	|	ХозрасчетныйОбороты.СуммаОборот КАК СуммаОборот,
	|	ХозрасчетныйОбороты.СуммаНУОборот КАК СуммаНУОборот,
	|	ХозрасчетныйОбороты.СуммаОборотДт КАК СуммаОборотДт,
	|	ХозрасчетныйОбороты.СуммаНУОборотДт КАК СуммаНУОборотДт,
	|	ХозрасчетныйОбороты.СуммаОборотКт КАК СуммаОборотКт,
	|	ХозрасчетныйОбороты.СуммаНУОборотКт КАК СуммаНУОборотКт,
	|	ХозрасчетныйОбороты.Субконто1 КАК Актив,
	|	ХозрасчетныйОбороты.КорСчет КАК КорСчет,
	|	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
	|	ХозрасчетныйОбороты.Период КАК Период,
	|	ХозрасчетныйОбороты.КорСубконто3 КАК Партия,
	|	ХозрасчетныйОбороты.Субконто1.ВидАктива КАК ВидАктива,
	|	ХозрасчетныйОбороты.Портфель КАК Портфель
	|ПОМЕСТИТЬ ВТ_РасходыПоНКД
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В (&РасходыПоУплаченномуНКД),
	|			&ВидыСубконто,
	|			Портфель.Клиент В (&МассивКлиентов),
	|			,
	|			) КАК ХозрасчетныйОбороты
	|ГДЕ
	|	НЕ ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Портфель.Клиент,
	|	ХозрасчетныйОбороты.Счет,
	|	ХозрасчетныйОбороты.Субконто2,
	|	ХозрасчетныйОбороты.СуммаОборот,
	|	ХозрасчетныйОбороты.СуммаНУОборот,
	|	ХозрасчетныйОбороты.СуммаОборотДт,
	|	ХозрасчетныйОбороты.СуммаНУОборотДт,
	|	ХозрасчетныйОбороты.СуммаОборотКт,
	|	ХозрасчетныйОбороты.СуммаНУОборотКт,
	|	ХозрасчетныйОбороты.Субконто1,
	|	ХозрасчетныйОбороты.КорСчет,
	|	ХозрасчетныйОбороты.Регистратор,
	|	ХозрасчетныйОбороты.Период,
	|	ХозрасчетныйОбороты.КорСубконто3,
	|	ХозрасчетныйОбороты.Субконто1.ВидАктива,
	|	ХозрасчетныйОбороты.Портфель
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В (&РасходыПоУплаченномуНКД),
	|			&ВидыСубконто,
	|			Портфель.Клиент В (&МассивКлиентов)
	|				И КорСубконто2 В
	|					(ВЫБРАТЬ
	|						ОплаченныеКупоныЗаПериод.Купон
	|					ИЗ
	|						ОплаченныеКупоныЗаПериод КАК ОплаченныеКупоныЗаПериод
	|					ГДЕ
	|						ОплаченныеКупоныЗаПериод.Клиент = ХозрасчетныйОбороты.Портфель.Клиент),
	|			КорСчет В (&УплаченныйНКД),
	|			) КАК ХозрасчетныйОбороты
	|ГДЕ
	|	ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Портфель.Клиент,
	|	ХозрасчетныйОбороты.Счет,
	|	ХозрасчетныйОбороты.Субконто2,
	|	ХозрасчетныйОбороты.СуммаОборот,
	|	ХозрасчетныйОбороты.СуммаНУОборот,
	|	ХозрасчетныйОбороты.СуммаОборотДт,
	|	ХозрасчетныйОбороты.СуммаНУОборотДт,
	|	ХозрасчетныйОбороты.СуммаОборотКт,
	|	ХозрасчетныйОбороты.СуммаНУОборотКт,
	|	ХозрасчетныйОбороты.Субконто1,
	|	ХозрасчетныйОбороты.КорСчет,
	|	ХозрасчетныйОбороты.Регистратор,
	|	ХозрасчетныйОбороты.Период,
	|	ХозрасчетныйОбороты.КорСубконто3,
	|	ХозрасчетныйОбороты.Субконто1.ВидАктива,
	|	ХозрасчетныйОбороты.Портфель
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В (&РасходыПоУплаченномуНКД),
	|			&ВидыСубконто,
	|			Портфель.Клиент В (&МассивКлиентов)
	|				И КорСубконто3 В
	|					(ВЫБРАТЬ
	|						ОплаченныеКупоныЗаПериод.Купон
	|					ИЗ
	|						ОплаченныеКупоныЗаПериод КАК ОплаченныеКупоныЗаПериод
	|					ГДЕ
	|						ОплаченныеКупоныЗаПериод.Клиент = ХозрасчетныйОбороты.Портфель.Клиент),
	|			КорСчет В (&РасчетыПоОблигациям),
	|			) КАК ХозрасчетныйОбороты
	|ГДЕ
	|	ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РасходыПоНКД.Клиент КАК Клиент,
	|	ВТ_РасходыПоНКД.Счет КАК Счет,
	|	ВТ_РасходыПоНКД.ВидыОбращаемостиЦБ КАК ВидыОбращаемостиЦБ,
	|	ВТ_РасходыПоНКД.СуммаОборот КАК СуммаОборот,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ЗначенияПараметровПортфеляСрезПоследних.Значение, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ВТ_РасходыПоНКД.СуммаНУОборотДт
	|		ИНАЧЕ ВТ_РасходыПоНКД.СуммаОборотДт
	|	КОНЕЦ КАК СуммаОборотДт,
	|	ВТ_РасходыПоНКД.СуммаОборотКт КАК СуммаОборотКт,
	|	ВТ_РасходыПоНКД.Актив КАК Актив,
	|	ВТ_РасходыПоНКД.КорСчет КАК КорСчет,
	|	ВТ_РасходыПоНКД.Регистратор КАК Регистратор,
	|	Облигации.Ссылка КАК Облигация,
	|	Облигации.ДатаВыпуска КАК ДатаВыпуска,
	|	Облигации.Эмитент.НеРезидент КАК ЭмитентНеРезидент,
	|	Облигации.ВидАктива КАК ВидАктива,
	|	Облигации.ВалютаНоминальнойСтоимости КАК ВалютаНоминальнойСтоимости,
	|	ВТ_РасходыПоНКД.Актив В (&АктивыСЛьготируемымКДРоссийскихОрганизаций)
	|		И ВТ_РасходыПоНКД.ВидыОбращаемостиЦБ В (&ОбращающиесяЦБ) КАК ЭтоЛьготируемаяОблигация,
	|	ВТ_РасходыПоНКД.Актив В (&АктивыСЛьготируемымКДРоссийскихОрганизаций)
	|		И ВТ_РасходыПоНКД.ВидыОбращаемостиЦБ В (&ОбращающиесяЦБ)
	|		И (ВТ_РасходыПоНКД.Счет В (&ДоходыПоНКД)
	|				И ВТ_РасходыПоНКД.КорСчет В (&РасчетыПоОблигациям)
	|			ИЛИ ВТ_РасходыПоНКД.Счет В (&РасходыПоУплаченномуНКД)
	|				И ВТ_РасходыПоНКД.КорСчет В (&УплаченныйНКД))
	|		И ВТ_РасходыПоНКД.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента КАК ОтражатьСтрокуВ3023,
	|	ВТ_РасходыПоНКД.Период КАК Период,
	|	ВТ_РасходыПоНКД.Партия КАК Партия,
	|	ВТ_РасходыПоНКД.Портфель КАК Портфель
