	|	СУММА(РезультирующаяТаблица.СуммаОборотДтЛьготаЭмитентНерез) КАК СуммаЛьготаЭмитентНерез,
	|	РезультирующаяТаблица.Период КАК Период,
	|	РезультирующаяТаблица.Партия КАК Партия,
	|	РезультирующаяТаблица.Партия.Дата КАК ДатаПартии,
	|	РезультирующаяТаблица.Регистратор КАК Регистратор
	|ИЗ
	|	РезультирующаяТаблица КАК РезультирующаяТаблица
	|ГДЕ
	|	РезультирующаяТаблица.Счет В(&РасходыПоУплаченномуНКД)
	|	И РезультирующаяТаблица.ВидыОбращаемостиЦБ В(&ВидыОбращаемости)
	|	И (РезультирующаяТаблица.СуммаОборотДт <> 0
	|			ИЛИ РезультирующаяТаблица.СуммаОборотДтЛьгота <> 0
	|			ИЛИ РезультирующаяТаблица.СуммаОборотДтЛьготаЭмитентНерез <> 0)
	|	И НЕ РезультирующаяТаблица.ОтражатьСтрокуВ3023
	|
	|СГРУППИРОВАТЬ ПО
	|	РезультирующаяТаблица.Актив,
	|	РезультирующаяТаблица.Период,
	|	РезультирующаяТаблица.Партия,
	|	РезультирующаяТаблица.Партия.Дата,
	|	РезультирующаяТаблица.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РезультирующаяТаблица.Актив КАК Актив,
	|	СУММА(РезультирующаяТаблица.СуммаОборотДт) КАК Сумма,
	|	СУММА(РезультирующаяТаблица.СуммаОборотДтЛьгота) КАК СуммаЛьгота,
	|	РезультирующаяТаблица.Период КАК Период,
	|	РезультирующаяТаблица.Партия КАК Партия,
	|	РезультирующаяТаблица.Партия.Дата КАК ДатаПартии,
	|	СУММА(РезультирующаяТаблица.СуммаОборотДтЛьготаЭмитентНерез) КАК СуммаЛьготаЭмитентНерез
	|ИЗ
	|	РезультирующаяТаблица КАК РезультирующаяТаблица
	|ГДЕ
	|	РезультирующаяТаблица.Счет В(&РасходыПоУплаченномуНКД)
	|	И РезультирующаяТаблица.ВидыОбращаемостиЦБ В(&ВидыОбращаемости)
	|	И (РезультирующаяТаблица.СуммаОборотДт <> 0
	|			ИЛИ РезультирующаяТаблица.СуммаОборотДтЛьгота <> 0
	|			ИЛИ РезультирующаяТаблица.СуммаОборотДтЛьготаЭмитентНерез <> 0)
	|	И НЕ РезультирующаяТаблица.ОтражатьСтрокуВ3023
	|
	|СГРУППИРОВАТЬ ПО
	|	РезультирующаяТаблица.Актив,
	|	РезультирующаяТаблица.Период,
	|	РезультирующаяТаблица.Партия,
	|	РезультирующаяТаблица.Партия.Дата";
	
	#КонецОбласти
	
	// ==================== Параметры и постобработка — полностью как в оригинале ====================
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЦенныеБумаги);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВидыОбращаемостиЦБ);
	
	Запрос.УстановитьПараметр("РасчетыПоОблигациям", ПланыСчетов.Хозрасчетный.РасчетыПоОблигациям);
	Запрос.УстановитьПараметр("ДоходыПоНКД", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("91.01.02"));
	Запрос.УстановитьПараметр("РасходыПоУплаченномуНКД", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("91.02.02"));
	Запрос.УстановитьПараметр("УплаченныйНКД", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("76.05.1"));
	Запрос.УстановитьПараметр("АктивыСЛьготируемымКДРоссийскихОрганизаций", ПараметрыРасчета.АктивыСЛьготируемымКДРоссийскихОрганизаций);	
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);	
	Запрос.УстановитьПараметр("АктивыСЛьготируемымКДРФИСоюзныхГосударств", ПараметрыРасчета.АктивыСЛьготируемымКДРФИСоюзныхГосударств);	
	Запрос.УстановитьПараметр("АктивыСЛьготируемымКДРФ", ПараметрыРасчета.АктивыСЛьготируемымКДРФ);	
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыРасчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", МоментВремени());
	Запрос.УстановитьПараметр("Портфель", Портфель);
	Запрос.УстановитьПараметр("ОбращающиесяЦБ", ПараметрыРасчета.ОбращающиесяЦБ);
	Запрос.УстановитьПараметр("РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета", ПараметрыРасчета.РасчетСуммыНДФЛВыполнятьПоСуммамНалоговогоУчета);
	Запрос.УстановитьПараметр("СчетаДенежныхСредств", ПараметрыРасчета.СчетаДенежныхСредств);
	Запрос.УстановитьПараметр("ВидыОбращаемости", ВидыОбращаемости);
	Запрос.УстановитьПараметр("Дата_02082021", ПараметрыРасчета.Дата_02082021);
	Запрос.УстановитьПараметр("Дата_01012021", ПараметрыРасчета.Дата_01012021);
	Запрос.УстановитьПараметр("ОблигацииЭмитентовНерезидентов", ПараметрыРасчета.ОблигацииЭмитентовНерезидентов);
	
	ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Запрос, "НачислениеНДФЛПоПортфелю.РасходыПоНКДПоВидуОбращаемости");
	
	Пакет = Запрос.ВыполнитьПакет(); 
	
	РезультатЗапросаПоРегистраторам = Пакет[Пакет.Количество()-2].Выгрузить();
	
	РезультатЗапросаПоРегистраторам.Колонки.Добавить("Корректировка");
	
	КорректировкаФинРезультата = КорректировкаФинРезультатаКупонныйДоход(ПараметрыРасчета, ПараметрыРасчета.ОбращающиесяЦБ);
	
	Для каждого СтрокаКорректировки Из КорректировкаФинРезультата Цикл
		Если СтрокаКорректировки.КупонныйДоход = 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		ОтборКупонныйДоход = Новый Структура("Регистратор, Актив", СтрокаКорректировки.Регистратор, СтрокаКорректировки.Актив);
		СтрокиСКорректировкой = РезультатЗапросаПоРегистраторам.НайтиСтроки(ОтборКупонныйДоход);
		Коэффициэнты = Новый Массив;
		Для каждого СтрокаПартииКупонныйДоход Из СтрокиСКорректировкой Цикл
			Коэффициэнты.Добавить(СтрокаПартииКупонныйДоход.Сумма);
		КонецЦикла; 
		
		Корректировка = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаКорректировки.КупонныйДоход, Коэффициэнты);
		Если Не ЗначениеЗаполнено(Корректировка) Тогда
			Продолжить;			
		КонецЕсли;
		
		Для Индекс = 0 По Корректировка.Количество()-1 Цикл
			СтрокиСКорректировкой[Индекс].Корректировка = Корректировка[Индекс];
			СтрокиСКорректировкой[Индекс].Сумма = СтрокиСКорректировкой[Индекс].Сумма + СтрокиСКорректировкой[Индекс].Корректировка;
		КонецЦикла; 
		
	КонецЦикла;
	
	РезультатЗапросаПоПартиям = РезультатЗапросаПоРегистраторам.Скопировать();
	РезультатЗапросаПоПартиям.Свернуть("Актив, Период, Партия, ДатаПартии", "Сумма, СуммаЛьгота, СуммаЛьготаЭмитентНерез"); 
	
	Если ПараметрыРасчета.РасходыОтУКДУменьшаютДоходы Тогда
		Для каждого СтрокаРезультата Из РезультатЗапросаПоПартиям Цикл
			СтрокаРезультата.Сумма = -1*СтрокаРезультата.Сумма;
			СтрокаРезультата.СуммаЛьгота = -1*СтрокаРезультата.СуммаЛьгота;
			СтрокаРезультата.СуммаЛьготаЭмитентНерез = -1*СтрокаРезультата.СуммаЛьготаЭмитентНерез;
		КонецЦикла; 
	КонецЕсли;
	
	Возврат Новый Структура("ПоПартиям, ПоРегистраторам", РезультатЗапросаПоПартиям, РезультатЗапросаПоРегистраторам);

КонецФункции