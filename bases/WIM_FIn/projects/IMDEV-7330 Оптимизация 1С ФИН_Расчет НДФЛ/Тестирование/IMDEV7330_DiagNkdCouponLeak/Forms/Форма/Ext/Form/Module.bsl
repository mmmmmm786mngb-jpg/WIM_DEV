#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ДатаРасчета) Тогда
		ДатаРасчета = КонецДня(Дата(2026, 12, 31));
	КонецЕсли;

	ВариантЗаполнения = 2;
	ПериодЗаполнения.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	ПериодЗаполнения.ДатаНачала = НачалоГода(ДатаРасчета);
	ПериодЗаполнения.ДатаОкончания = КонецГода(ДатаРасчета);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиУтечку(Команда)

	Если Не ПроверитьКлиентаИДату() Тогда
		Возврат;
	КонецЕсли;

	НайтиУтечкуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СравнитьСПачкойУК(Команда)

	Если Не ПроверитьКлиентаИДату() Тогда
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Сравнение с клиентами УК за дату. Запрос может занять несколько минут.'"));
	СравнитьСПачкойУКНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СравнитьЗаполнитьVsОдин(Команда)

	Если Не ПроверитьКлиентаИДату() Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ПериодЗаполнения.ДатаНачала)
		Или Не ЗначениеЗаполнено(ПериодЗаполнения.ДатаОкончания) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите период Заполнить'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Заполнить + массовый НКД по всем, затем запрос только по клиенту. Может занять несколько минут.'"));
	СравнитьЗаполнитьVsОдинНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПроверитьКлиентаИДату()

	Если Не ЗначениеЗаполнено(Клиент) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите клиента'"));
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаРасчета) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату среза'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Процедура НайтиУтечкуНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПоказатьРезультатНаФорме(ОбработкаОбъект.ВыполнитьДиагностику(Клиент, ДатаРасчета));

КонецПроцедуры

&НаСервере
Процедура СравнитьСПачкойУКНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПоказатьРезультатНаФорме(ОбработкаОбъект.СравнитьСКлиентамиУКЗаДату(Клиент, ДатаРасчета));

КонецПроцедуры

&НаСервере
Процедура СравнитьЗаполнитьVsОдинНаСервере()

	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ВариантЗаполнения", ВариантЗаполнения);
	ПараметрыЗаполнения.Вставить("Период", ПериодЗаполнения);
	ПараметрыЗаполнения.Вставить("УправляющаяКомпания", УправляющаяКомпания);
	ПараметрыЗаполнения.Вставить("НеСоздаватьДокументыПоКлиентамБезЦБ", НеСоздаватьДокументыПоКлиентамБезЦБ);
	ПараметрыЗаполнения.Вставить("ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ",
		ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ);
	ПараметрыЗаполнения.Вставить("НомерСтрокиС", НомерСтрокиС);
	ПараметрыЗаполнения.Вставить("НомерСтрокиПо", НомерСтрокиПо);

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПоказатьРезультатНаФорме(ОбработкаОбъект.СравнитьЗаполнитьVsОдин(Клиент, ДатаРасчета, ПараметрыЗаполнения));

КонецПроцедуры

&НаСервере
Процедура ПоказатьРезультатНаФорме(Результат)

	Вердикт = Результат.Вердикт;
	СтрокОдин = Результат.СтрокОдин;
	СтрокМассовый = Результат.СтрокМассовый;
	СуммаМодулейОдин = Результат.СуммаМодулейОдин;
	СуммаМодулейМассовый = Результат.СуммаМодулейМассовый;
	ДельтаМодулей = Результат.ДельтаМодулей;
	КлиентовВСравнении = Результат.КлиентовВСравнении;

	ЗаполнитьТаблицуФормы(Партнеры, Результат.Партнеры);
	ЗаполнитьТаблицуФормы(ЛатентныеКупоны, Результат.ЛатентныеКупоны);
	ЗаполнитьТаблицуФормы(ЛишниеСтроки, Результат.ЛишниеСтроки);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуФормы(ТаблицаФормы, ТаблицаИсточник)

	ТаблицаФормы.Очистить();
	Если ТаблицаИсточник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаИсточника Из ТаблицаИсточник Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаФормы.Добавить(), СтрокаИсточника);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
