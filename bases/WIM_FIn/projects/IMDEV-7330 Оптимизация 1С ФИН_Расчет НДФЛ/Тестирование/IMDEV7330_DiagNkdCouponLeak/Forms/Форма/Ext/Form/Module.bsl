#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ДатаРасчета) Тогда
		ДатаРасчета = КонецДня(Дата(2026, 12, 31));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиУтечку(Команда)

	Если Не ЗначениеЗаполнено(Клиент) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите клиента'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаРасчета) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату расчёта'"));
		Возврат;
	КонецЕсли;

	НайтиУтечкуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НайтиУтечкуНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ВыполнитьДиагностику(Клиент, ДатаРасчета);

	Вердикт = Результат.Вердикт;
	СтрокОдин = Результат.СтрокОдин;
	СтрокМассовый = Результат.СтрокМассовый;
	СуммаМодулейОдин = Результат.СуммаМодулейОдин;
	СуммаМодулейМассовый = Результат.СуммаМодулейМассовый;
	ДельтаМодулей = Результат.ДельтаМодулей;

	ЗаполнитьТаблицуФормы(Партнеры, Результат.Партнеры);
	ЗаполнитьТаблицуФормы(ЛатентныеКупоны, Результат.ЛатентныеКупоны);
	ЗаполнитьТаблицуФормы(ЛишниеСтроки, Результат.ЛишниеСтроки);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуФормы(ТаблицаФормы, ТаблицаИсточник)

	ТаблицаФормы.Очистить();
	Если ТаблицаИсточник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаИсточника Из ТаблицаИсточник Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаФормы.Добавить(), СтрокаИсточника);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
