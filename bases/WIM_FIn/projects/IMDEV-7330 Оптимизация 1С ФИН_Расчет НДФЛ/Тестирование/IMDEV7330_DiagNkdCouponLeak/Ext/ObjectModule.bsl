Процедура СравнитьКэшНКД(Результат, Клиент, ДатаКонца, МассивПартнеров)

	ТаблицаОдин = ТаблицаНКДПоКлиентам(Результат, Клиент, ДатаКонца, Новый Массив);
	ТаблицаМасс = ТаблицаНКДПоКлиентам(Результат, Клиент, ДатаКонца, МассивПартнеров);
	СравнитьДвеТаблицыНКД(Результат, ТаблицаОдин, ТаблицаМасс);

КонецПроцедуры

Процедура СравнитьДвеТаблицыНКД(Результат, ТаблицаОдин, ТаблицаМасс)

	Результат.СтрокОдин = ТаблицаОдин.Количество();
	Результат.СтрокМассовый = ТаблицаМасс.Количество();
	Результат.СуммаМодулейОдин = СуммаМодулей(ТаблицаОдин);
	Результат.СуммаМодулейМассовый = СуммаМодулей(ТаблицаМасс);
	Результат.ДельтаМодулей = Результат.СуммаМодулейОдин - Результат.СуммаМодулейМассовый;

	СоответствиеОдин = СоответствиеПоКлючуНКД(ТаблицаОдин);
	СоответствиеМасс = СоответствиеПоКлючуНКД(ТаблицаМасс);

	ВсеКлючи = Новый Соответствие;
	Для Каждого КлючИЗначение Из СоответствиеОдин Цикл
		ВсеКлючи.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;
	Для Каждого КлючИЗначение Из СоответствиеМасс Цикл
		ВсеКлючи.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;

	Для Каждого КлючИЗначение Из ВсеКлючи Цикл
		СтрокаОдин = СоответствиеОдин.Получить(КлючИЗначение.Ключ);
		СтрокаМасс = СоответствиеМасс.Получить(КлючИЗначение.Ключ);
		СуммаОдин = 0;
		СуммаМасс = 0;
		Если СтрокаОдин <> Неопределено Тогда
			СуммаОдин = СтрокаОдин.Сумма;
		КонецЕсли;
		Если СтрокаМасс <> Неопределено Тогда
			СуммаМасс = СтрокаМасс.Сумма;
		КонецЕсли;
		Если СуммаОдин = СуммаМасс Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЛишняя = Результат.ЛишниеСтроки.Добавить();
		Если СтрокаОдин = Неопределено Тогда
			СтрокаЛишняя.ВидРасхождения = "Только в массовом";
			ЗаполнитьПредставлениеСтрокиНКД(СтрокаЛишняя, СтрокаМасс);
		ИначеЕсли СтрокаМасс = Неопределено Тогда
			СтрокаЛишняя.ВидРасхождения = "Только в одиночном";
			ЗаполнитьПредставлениеСтрокиНКД(СтрокаЛишняя, СтрокаОдин);
		Иначе
			СтрокаЛишняя.ВидРасхождения = "Сумма отличается";
			ЗаполнитьПредставлениеСтрокиНКД(СтрокаЛишняя, СтрокаОдин);
		КонецЕсли;
		СтрокаЛишняя.СуммаОдин = СуммаОдин;
		СтрокаЛишняя.СуммаМассовый = СуммаМасс;
	КонецЦикла;

КонецПроцедуры

Функция ТаблицаПоРегистраторамИзКэша(Кэш, КлючКлиента)

	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("Актив");
	ПустаяТаблица.Колонки.Добавить("Партия");
	ПустаяТаблица.Колонки.Добавить("Регистратор");
	ПустаяТаблица.Колонки.Добавить("Период");
	ПустаяТаблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Если Кэш = Неопределено Тогда
		Возврат ПустаяТаблица;
	КонецЕсли;

	ПоКлиенту = Кэш.Получить(КлючКлиента);
	Если ПоКлиенту = Неопределено Или ПоКлиенту.ПоРегистраторам = Неопределено Тогда
		Возврат ПустаяТаблица;
	КонецЕсли;

	Возврат ПоКлиенту.ПоРегистраторам;

КонецФункции

Функция СобратьПарыКлиентДатаИзОбъектаФормирования(Обр)

	ОтборПоНомеруСтроки = Обр.НомерСтрокиС <> 0 Или Обр.НомерСтрокиПо <> 0;

	КлиентыСЦБ = Неопределено;
	Если Обр.НеСоздаватьДокументыПоКлиентамБезЦБ Тогда
		КлиентыСЦБ = СписокКлиентовСЦБПоОбъектуФормирования(Обр);
	КонецЕсли;

	МенеджерУК = Документы.НачислениеНДФЛПоУправляющейКомпании;
	МассивПарКлиентДата = Новый Массив;
	УникКлючи = Новый Соответствие;

	Для Каждого СтрокаДокументов Из Обр.ДатыДокументов Цикл

		Если ОтборПоНомеруСтроки Тогда
			Если Обр.НомерСтрокиС <> 0 И СтрокаДокументов.НомерСтроки < Обр.НомерСтрокиС Тогда
				Продолжить;
			ИначеЕсли Обр.НомерСтрокиПо <> 0 И СтрокаДокументов.НомерСтроки > Обр.НомерСтрокиПо Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;

		Если Обр.НеСоздаватьДокументыПоКлиентамБезЦБ
			И КлиентыСЦБ.Найти(СтрокаДокументов.Клиент) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		КлючКэша = МенеджерУК.КлючКэшаНКД(СтрокаДокументов.Клиент, СтрокаДокументов.Дата);
		Если УникКлючи.Получить(КлючКэша) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УникКлючи.Вставить(КлючКэша, Истина);

		Пара = Новый Структура("Клиент, Дата");
		Пара.Клиент = СтрокаДокументов.Клиент;
		Пара.Дата = СтрокаДокументов.Дата;
		МассивПарКлиентДата.Добавить(Пара);

	КонецЦикла;

	Возврат МассивПарКлиентДата;

КонецФункции

Функция СписокКлиентовСЦБПоОбъектуФормирования(Обр)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Портфель.Клиент КАК Клиент
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Дата,
	|			Счет В (&СчетаУчетаЦБ),
	|			,
	|			Портфель.Клиент В (&Клиенты)
	|				И Портфель.ТипКлиентаДУ = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентовДУ.ФизическиеЛица)) КАК ХозрасчетныйОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОстатки.Портфель.Клиент";

	Запрос.УстановитьПараметр("Дата", Обр.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Клиенты", Обр.ДатыДокументов.ВыгрузитьКолонку("Клиент"));
	Запрос.УстановитьПараметр("СчетаУчетаЦБ", ПланыСчетов.Хозрасчетный.СчетаПоСтроке("58"));

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Клиент");

КонецФункции

Функция ТаблицаНКДПоКлиентам(Результат, Клиент, ДатаКонца, МассивПартнеров)

	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("Актив");
	ПустаяТаблица.Колонки.Добавить("Партия");
	ПустаяТаблица.Колонки.Добавить("Регистратор");
	ПустаяТаблица.Колонки.Добавить("Период");
	ПустаяТаблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	МассивПар = Новый Массив;
	ПараКлиента = Новый Структура("Клиент, Дата", Клиент, ДатаКонца);
	МассивПар.Добавить(ПараКлиента);
	Для Каждого Партнер Из МассивПартнеров Цикл
		МассивПар.Добавить(Новый Структура("Клиент, Дата", Партнер, ДатаКонца));
	КонецЦикла;

	Попытка
		Кэш = Документы.НачислениеНДФЛПоУправляющейКомпании.ПолучитьРасходыПоНКДПоКлиентам(МассивПар);
	Исключение
		Результат.ТекстОшибкиКэша = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Не ЗначениеЗаполнено(Результат.Вердикт) Тогда
			Результат.Вердикт = "Не удалось вызвать ПолучитьРасходыПоНКДПоКлиентам: " + Результат.ТекстОшибкиКэша;
		КонецЕсли;
		Возврат ПустаяТаблица;
	КонецПопытки;

	КлючКэша = Документы.НачислениеНДФЛПоУправляющейКомпании.КлючКэшаНКД(Клиент, ДатаКонца);
	ПоКлиенту = Кэш.Получить(КлючКэша);
	Если ПоКлиенту = Неопределено Или ПоКлиенту.ПоРегистраторам = Неопределено Тогда
		Возврат ПустаяТаблица;
	КонецЕсли;

	Возврат ПоКлиенту.ПоРегистраторам;

КонецФункции

Функция СуммаМодулей(Таблица)

	ИтогСуммы = 0;
	Если Таблица = Неопределено Тогда
		Возврат ИтогСуммы;
	КонецЕсли;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИтогСуммы = ИтогСуммы + Макс(-СтрокаТаблицы.Сумма, СтрокаТаблицы.Сумма);
	КонецЦикла;
	Возврат ИтогСуммы;

КонецФункции

Функция СоответствиеПоКлючуНКД(Таблица)

	РезультатСоответствие = Новый Соответствие;
	Если Таблица = Неопределено Тогда
		Возврат РезультатСоответствие;
	КонецЕсли;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		КлючСтроки = Строка(СтрокаТаблицы.Партия) + "|" + Строка(СтрокаТаблицы.Регистратор)
			+ "|" + Строка(СтрокаТаблицы.Актив) + "|" + Формат(СтрокаТаблицы.Период, "ДФ=yyyyMMddHHmmss");
		РезультатСоответствие.Вставить(КлючСтроки, СтрокаТаблицы);
	КонецЦикла;
	Возврат РезультатСоответствие;

КонецФункции

Процедура ЗаполнитьПредставлениеСтрокиНКД(СтрокаПриемника, СтрокаНКД)

	СтрокаПриемника.Актив = Строка(СтрокаНКД.Актив);
	СтрокаПриемника.Партия = Строка(СтрокаНКД.Партия);
	СтрокаПриемника.Регистратор = Строка(СтрокаНКД.Регистратор);
	СтрокаПриемника.Период = СтрокаНКД.Период;

КонецПроцедуры

#КонецОбласти
