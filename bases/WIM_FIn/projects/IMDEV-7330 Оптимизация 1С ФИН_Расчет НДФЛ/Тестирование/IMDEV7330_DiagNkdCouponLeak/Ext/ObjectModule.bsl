#Область ОписаниеПеременных

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Описание: Сведения для подключения через БСП «Дополнительные отчеты и обработки».
//
// Возвращаемое значение:
//   Структура - параметры регистрации дополнительной обработки
//
Функция СведенияОВнешнейОбработке() Экспорт

	МетаданныеОбработки = Метаданные();

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.2";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация =
		"IMDEV-7330. Диагностика утечки купонов: массовый запрос НКД подмешивает оплаченные купоны других клиентов пачки.";

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = МетаданныеОбработки.Представление();
	НоваяКоманда.Идентификатор = МетаданныеОбработки.Имя;
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Ищет купоны клиента в ПереводНКД, которые он сам не оплачивал; находит других
//           клиентов, оплативших эти купоны; сравнивает РасходыПоНКД один клиент vs вместе с партнёрами.
//
// Параметры:
//   Клиент - СправочникСсылка.Контрагенты - проверяемый клиент
//   ДатаРасчета - Дата - дата документа начисления НДФЛ по УК
//
// Возвращаемое значение:
//   Структура - Вердикт, числовые итоги и таблицы Партнеры, ЛатентныеКупоны, ЛишниеСтроки
//
Функция ВыполнитьДиагностику(Клиент, ДатаРасчета) Экспорт

	Результат = ПустойРезультатДиагностики();

	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Результат.Вердикт = "Укажите клиента.";
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаРасчета) Тогда
		Результат.Вердикт = "Укажите дату расчёта.";
		Возврат Результат;
	КонецЕсли;

	ДатаКонца = КонецДня(ДатаРасчета);
	ПараметрыСчетов = ПараметрыСчетовХозрасчетный();

	ТаблицаЛатентных = ЛатентныеКупоныКлиента(Клиент, ДатаКонца, ПараметрыСчетов);
	ЗаполнитьТаблицуЛатентных(Результат.ЛатентныеКупоны, ТаблицаЛатентных);

	МассивЛатентныхКупонов = Новый Массив;
	УникальныеКупоны = Новый Соответствие;
	Для Каждого СтрокаЛатент Из ТаблицаЛатентных Цикл
		Если Не ЗначениеЗаполнено(СтрокаЛатент.Купон) Тогда
			Продолжить;
		КонецЕсли;
		Если УникальныеКупоны.Получить(СтрокаЛатент.Купон) = Неопределено Тогда
			УникальныеКупоны.Вставить(СтрокаЛатент.Купон, Истина);
			МассивЛатентныхКупонов.Добавить(СтрокаЛатент.Купон);
		КонецЕсли;
	КонецЦикла;

	Если МассивЛатентныхКупонов.Количество() = 0 Тогда
		Результат.Вердикт =
			"У клиента нет строк ПереводНКДВЗадолженностьЭмитента с купоном, который он сам не оплачивал в периоде. "
			+ "Механизм ОплаченныеКупоныЗаПериод без привязки к клиенту для него не срабатывает. "
			+ "Ищите другую батч-зависимость (срез параметров портфеля, состав пачки в кэше оборотов).";
		СравнитьКэшНКД(Результат, Клиент, ДатаКонца, Новый Массив);
		Возврат Результат;
	КонецЕсли;

	ТаблицаПартнеров = ПартнерыПоКупонам(Клиент, ДатаКонца, ПараметрыСчетов, МассивЛатентныхКупонов);
	ЗаполнитьТаблицуПартнеров(Результат.Партнеры, ТаблицаПартнеров);

	МассивПартнеров = Новый Массив;
	УникальныеПартнеры = Новый Соответствие;
	Для Каждого СтрокаПартнер Из ТаблицаПартнеров Цикл
		Если Не ЗначениеЗаполнено(СтрокаПартнер.Клиент) Тогда
			Продолжить;
		КонецЕсли;
		Если УникальныеПартнеры.Получить(СтрокаПартнер.Клиент) = Неопределено Тогда
			УникальныеПартнеры.Вставить(СтрокаПартнер.Клиент, Истина);
			МассивПартнеров.Добавить(СтрокаПартнер.Клиент);
		КонецЕсли;
	КонецЦикла;

	СравнитьКэшНКД(Результат, Клиент, ДатаКонца, МассивПартнеров);
	Результат.КлиентовВСравнении = 1 + МассивПартнеров.Количество();

	Если МассивПартнеров.Количество() = 0 Тогда
		Результат.Вердикт =
			"Латентных купонов: " + Формат(МассивЛатентныхКупонов.Количество(), "ЧГ=0")
			+ " (вкладка «Латентные купоны»). Других клиентов, оплативших те же купоны за год, нет. "
			+ "Чужие оплаты эти купоны в IN-список массового запроса не добавят. "
			+ "Итоги ниже — клиент сам с собой, это ещё не пачка. "
			+ "Нажмите «Сравнить с клиентами УК за дату».";
		Возврат Результат;
	КонецЕсли;

	Если Результат.ДельтаМодулей = 0 И Результат.СтрокОдин = Результат.СтрокМассовый Тогда
		Результат.Вердикт =
			"Партнёры по купонам найдены (" + Формат(МассивПартнеров.Количество(), "ЧГ=0")
			+ " кл.), но ПоРегистраторам клиента совпали с одиночным запросом. "
			+ "Либо эти купоны не проходят фильтр ВидыОбращаемости / ОтражатьСтрокуВ3023, "
			+ "либо утечка в другой ветке. Смотрите вкладки «Клиенты-партнёры» и «Латентные купоны».";
	Иначе
		Результат.Вердикт =
			"ДОКАЗАНО: массовый запрос с партнёрами по купонам меняет расходы НКД клиента. "
			+ "Партнёров: " + Формат(МассивПартнеров.Количество(), "ЧГ=0")
			+ ". Строк один / с партнёрами: "
			+ Формат(Результат.СтрокОдин, "ЧГ=0") + " / " + Формат(Результат.СтрокМассовый, "ЧГ=0")
			+ ". Дельта суммы модулей (как в ИнвестиционныйВычетУКД): "
			+ Формат(Результат.ДельтаМодулей, "ЧДЦ=2; ЧН=0")
			+ ". Если эта дельта равна 8481.00 — это тот же эффект, что у Платонова в полном прогоне.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Описание: Сравнивает кэш НКД клиента в одиночном запросе и в запросе вместе со всеми
//           клиентами документов НачислениеНДФЛПоУправляющейКомпании на ту же дату.
//
// Параметры:
//   Клиент - СправочникСсылка.Контрагенты - проверяемый клиент
//   ДатаРасчета - Дата - дата документов УК
//
// Возвращаемое значение:
//   Структура - те же поля, что у ВыполнитьДиагностику
//
Функция СравнитьСКлиентамиУКЗаДату(Клиент, ДатаРасчета) Экспорт

	Результат = ПустойРезультатДиагностики();

	Если Не ЗначениеЗаполнено(Клиент) Или Не ЗначениеЗаполнено(ДатаРасчета) Тогда
		Результат.Вердикт = "Укажите клиента и дату.";
		Возврат Результат;
	КонецЕсли;

	ДатаКонца = КонецДня(ДатаРасчета);
	МассивДругих = КлиентыДокументовУКЗаДату(Клиент, ДатаКонца);

	Если МассивДругих.Количество() = 0 Тогда
		Результат.Вердикт =
			"На эту дату нет других проведённых/записанных документов «Начисление НДФЛ по УК». "
			+ "Дождитесь, пока пачка запишет документы, или укажите дату уже посчитанного прогона.";
		Возврат Результат;
	КонецЕсли;

	СравнитьКэшНКД(Результат, Клиент, ДатаКонца, МассивДругих);
	Результат.КлиентовВСравнении = 1 + МассивДругих.Количество();

	Если ЗначениеЗаполнено(Результат.ТекстОшибкиКэша) Тогда
		Возврат Результат;
	КонецЕсли;

	Если Результат.ДельтаМодулей = 0 И Результат.СтрокОдин = Результат.СтрокМассовый
		И Результат.ЛишниеСтроки.Количество() = 0 Тогда

		Результат.Вердикт =
			"Массовый запрос НКД по " + Формат(Результат.КлиентовВСравнении, "ЧГ=0")
			+ " клиентам УК за дату дал те же ПоРегистраторам, что одиночный. "
			+ "Для этого клиента кэш НКД от состава пачки не зависит. "
			+ "Расхождение документа ищите вне предрасчёта РасходыПоНКД (порядок записи, кэш оборотов, налог к зачёту).";
	Иначе
		Результат.Вердикт =
			"ДОКАЗАНО: массив клиентов меняет НКД. Клиентов в запросе: "
			+ Формат(Результат.КлиентовВСравнении, "ЧГ=0")
			+ ". Строк один / пачка: "
			+ Формат(Результат.СтрокОдин, "ЧГ=0") + " / " + Формат(Результат.СтрокМассовый, "ЧГ=0")
			+ ". Дельта суммы модулей: " + Формат(Результат.ДельтаМодулей, "ЧДЦ=2; ЧН=0")
			+ ". Смотрите вкладку «Лишние / пропавшие строки НКД».";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Описание: Заполняет ТЧ «Формирование начислений НДФЛ» штатным ЗаполнитьДатыДокументов
//           (клиент обработки формирования не заполняется). Строит пары (Клиент, Дата) как предрасчёт НКД.
//           Один вызов ПолучитьРасходыПоНКДПоКлиентам по всем парам, срез выбранного клиента;
//           второй вызов — только его пара. Сравниваются ПоРегистраторам.
//
// Параметры:
//   Клиент - СправочникСсылка.Контрагенты - кого вырезать из общего результата
//   ДатаРасчета - Дата - дата пары клиента (конец дня)
//   ПараметрыЗаполнения - Структура - ВариантЗаполнения, Период, УправляющаяКомпания,
//     НеСоздаватьДокументыПоКлиентамБезЦБ, ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ,
//     НомерСтрокиС, НомерСтрокиПо
//
// Возвращаемое значение:
//   Структура - те же поля, что у ВыполнитьДиагностику
//
Функция СравнитьЗаполнитьVsОдин(Клиент, ДатаРасчета, ПараметрыЗаполнения) Экспорт

	Результат = ПустойРезультатДиагностики();

	Если Не ЗначениеЗаполнено(Клиент) Или Не ЗначениеЗаполнено(ДатаРасчета) Тогда
		Результат.Вердикт = "Укажите клиента и дату среза.";
		Возврат Результат;
	КонецЕсли;

	Если ПараметрыЗаполнения = Неопределено
		Или Не ПараметрыЗаполнения.Свойство("Период")
		Или Не ЗначениеЗаполнено(ПараметрыЗаполнения.Период.ДатаНачала)
		Или Не ЗначениеЗаполнено(ПараметрыЗаполнения.Период.ДатаОкончания) Тогда
		Результат.Вердикт = "Укажите период Заполнить.";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Обр = Обработки.ФормированиеНачисленийНДФЛ.Создать();
		Обр.ВариантЗаполнения = ПараметрыЗаполнения.ВариантЗаполнения;
		Обр.Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
		Обр.Период.ДатаНачала = ПараметрыЗаполнения.Период.ДатаНачала;
		Обр.Период.ДатаОкончания = ПараметрыЗаполнения.Период.ДатаОкончания;
		Обр.УправляющаяКомпания = ПараметрыЗаполнения.УправляющаяКомпания;
		Обр.Клиент = Неопределено;
		Обр.НеСоздаватьДокументыПоКлиентамБезЦБ = ПараметрыЗаполнения.НеСоздаватьДокументыПоКлиентамБезЦБ;
		Обр.ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ =
			ПараметрыЗаполнения.ФормироватьНачисленияТолькоПоПортфелямСДвижениямиПоНДФЛ;
		Обр.НомерСтрокиС = ПараметрыЗаполнения.НомерСтрокиС;
		Обр.НомерСтрокиПо = ПараметрыЗаполнения.НомерСтрокиПо;
		Обр.ЗаполнитьДатыДокументов();
	Исключение
		Результат.Вердикт = "Ошибка ЗаполнитьДатыДокументов: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	СтрокТЧ = Обр.ДатыДокументов.Количество();
	МассивПар = СобратьПарыКлиентДатаИзОбъектаФормирования(Обр);

	Если МассивПар.Количество() = 0 Тогда
		Результат.Вердикт = "После Заполнить таблица пустая (строк ТЧ: " + Формат(СтрокТЧ, "ЧГ=0") + ").";
		Возврат Результат;
	КонецЕсли;

	ДатаИскомая = КонецДня(ДатаРасчета);
	ПараКлиента = Неопределено;
	ДатыКлиента = "";
	Для Каждого Пара Из МассивПар Цикл
		Если Пара.Клиент <> Клиент Тогда
			Продолжить;
		КонецЕсли;
		Если ДатыКлиента <> "" Тогда
			ДатыКлиента = ДатыКлиента + ", ";
		КонецЕсли;
		ДатыКлиента = ДатыКлиента + Формат(Пара.Дата, "ДФ=dd.MM.yyyy");
		Если КонецДня(Пара.Дата) = ДатаИскомая Тогда
			ПараКлиента = Пара;
		КонецЕсли;
	КонецЦикла;

	Если ПараКлиента = Неопределено Тогда
		Результат.Вердикт =
			"Заполнить: строк ТЧ " + Формат(СтрокТЧ, "ЧГ=0")
			+ ", уникальных пар (Клиент, Дата) " + Формат(МассивПар.Количество(), "ЧГ=0")
			+ ". Выбранного клиента с датой " + Формат(ДатаИскомая, "ДФ=dd.MM.yyyy") + " в парах нет.";
		Если ДатыКлиента <> "" Тогда
			Результат.Вердикт = Результат.Вердикт + " У этого клиента в Заполнить даты: " + ДатыКлиента + ".";
		КонецЕсли;
		Результат.КлиентовВСравнении = МассивПар.Количество();
		Возврат Результат;
	КонецЕсли;

	Попытка
		КэшПолный = Документы.НачислениеНДФЛПоУправляющейКомпании.ПолучитьРасходыПоНКДПоКлиентам(МассивПар);
	Исключение
		Результат.Вердикт = "Ошибка массового ПолучитьРасходыПоНКДПоКлиентам: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	КлючКлиента = Документы.НачислениеНДФЛПоУправляющейКомпании.КлючКэшаНКД(ПараКлиента.Клиент, ПараКлиента.Дата);
	ТаблицаМасс = ТаблицаПоРегистраторамИзКэша(КэшПолный, КлючКлиента);

	МассивОдин = Новый Массив;
	МассивОдин.Добавить(ПараКлиента);

	Попытка
		КэшОдин = Документы.НачислениеНДФЛПоУправляющейКомпании.ПолучитьРасходыПоНКДПоКлиентам(МассивОдин);
	Исключение
		Результат.Вердикт = "Ошибка одиночного ПолучитьРасходыПоНКДПоКлиентам: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	ТаблицаОдин = ТаблицаПоРегистраторамИзКэша(КэшОдин, КлючКлиента);
	СравнитьДвеТаблицыНКД(Результат, ТаблицаОдин, ТаблицаМасс);
	Результат.КлиентовВСравнении = МассивПар.Количество();

	Если Результат.ДельтаМодулей = 0 И Результат.СтрокОдин = Результат.СтрокМассовый
		И Результат.ЛишниеСтроки.Количество() = 0 Тогда

		Результат.Вердикт =
			"Срезы совпали. Заполнить: строк ТЧ " + Формат(СтрокТЧ, "ЧГ=0")
			+ ", пар в массовом запросе " + Формат(МассивПар.Количество(), "ЧГ=0")
			+ ". ПоРегистраторам клиента в общей выгрузке те же, что в запросе только по нему. "
			+ "Состав Заполнить этот кэш НКД не портит.";
	Иначе
		Результат.Вердикт =
			"ДОКАЗАНО: массовый запрос по Заполнить меняет НКД клиента. Строк ТЧ "
			+ Формат(СтрокТЧ, "ЧГ=0") + ", пар " + Формат(МассивПар.Количество(), "ЧГ=0")
			+ ". Строк один / в общем запросе: "
			+ Формат(Результат.СтрокОдин, "ЧГ=0") + " / " + Формат(Результат.СтрокМассовый, "ЧГ=0")
			+ ". Дельта суммы модулей: " + Формат(Результат.ДельтаМодулей, "ЧДЦ=2; ЧН=0")
			+ ". Вкладка «Лишние / пропавшие строки НКД».";
	КонецЕсли;

	Возврат Результат;

