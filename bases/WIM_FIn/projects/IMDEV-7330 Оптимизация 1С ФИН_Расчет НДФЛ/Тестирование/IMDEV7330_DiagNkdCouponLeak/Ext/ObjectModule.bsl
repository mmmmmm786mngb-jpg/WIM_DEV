Функция ЛатентныеКупоныКлиента(Клиент, ДатаКонца, ПараметрыСчетов)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3 КАК Купон
	|ПОМЕСТИТЬ КупоныКлиента
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			СчетДт В (&СчетаДенежныхСредств),
	|			,
	|			СчетКт В (&РасчетыПоОблигациям),
	|			,
	|			Портфель.Клиент = &Клиент) КАК ХозрасчетныйОборотыДтКт
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
	|	ХозрасчетныйОбороты.Субконто1 КАК Актив,
	|	ХозрасчетныйОбороты.КорСубконто3 КАК Партия,
	|	ХозрасчетныйОбороты.КорСубконто2 КАК Купон,
	|	""КорСубконто2"" КАК ВидСвязи,
	|	ХозрасчетныйОбороты.СуммаОборотДт КАК СуммаОборотДт
	|ПОМЕСТИТЬ ПереводыКлиента
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В (&РасходыПоУплаченномуНКД),
	|			&ВидыСубконто,
	|			Портфель.Клиент = &Клиент,
	|			КорСчет В (&УплаченныйНКД),
	|			) КАК ХозрасчетныйОбороты
	|ГДЕ
	|	ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Регистратор,
	|	ХозрасчетныйОбороты.Субконто1,
	|	ХозрасчетныйОбороты.КорСубконто3,
	|	ХозрасчетныйОбороты.КорСубконто3,
	|	""КорСубконто3"",
	|	ХозрасчетныйОбороты.СуммаОборотДт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В (&РасходыПоУплаченномуНКД),
	|			&ВидыСубконто,
	|			Портфель.Клиент = &Клиент,
	|			КорСчет В (&РасчетыПоОблигациям),
	|			) КАК ХозрасчетныйОбороты
	|ГДЕ
	|	ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПереводыКлиента.Купон КАК Купон,
	|	ПереводыКлиента.ВидСвязи КАК ВидСвязи,
	|	ПереводыКлиента.Регистратор КАК Регистратор,
	|	ПереводыКлиента.Актив КАК Актив,
	|	ПереводыКлиента.Партия КАК Партия,
	|	ПереводыКлиента.СуммаОборотДт КАК СуммаОборотДт
	|ИЗ
	|	ПереводыКлиента КАК ПереводыКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ КупоныКлиента КАК КупоныКлиента
	|		ПО ПереводыКлиента.Купон = КупоныКлиента.Купон
	|ГДЕ
	|	КупоныКлиента.Купон ЕСТЬ NULL";

	УстановитьПараметрыЗапросаНКД(Запрос, Клиент, ДатаКонца, ПараметрыСчетов);
	Таблица = Запрос.Выполнить().Выгрузить();

	Индекс = Таблица.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Не ЗначениеЗаполнено(Таблица[Индекс].Купон) Тогда
			Таблица.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ПартнерыПоКупонам(Клиент, ДатаКонца, ПараметрыСчетов, МассивЛатентныхКупонов)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОборотыДтКт.Портфель.Клиент КАК Клиент,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3 КАК Купон,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт2 КАК Облигация,
	|	СУММА(ХозрасчетныйОборотыДтКт.СуммаОборот) КАК СуммаОборот
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			СчетДт В (&СчетаДенежныхСредств),
	|			,
	|			СчетКт В (&РасчетыПоОблигациям),
	|			,
	|			) КАК ХозрасчетныйОборотыДтКт
	|ГДЕ
	|	(ХозрасчетныйОборотыДтКт.СубконтоКт3 В (&ЛатентныеКупоны)
	|			ИЛИ ХозрасчетныйОборотыДтКт.СубконтоКт2 В (&ЛатентныеКупоны))
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОборотыДтКт.Портфель.Клиент,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт2";

	УстановитьПараметрыЗапросаНКД(Запрос, Клиент, ДатаКонца, ПараметрыСчетов);
	Запрос.УстановитьПараметр("ЛатентныеКупоны", МассивЛатентныхКупонов);

	Таблица = Запрос.Выполнить().Выгрузить();
	Индекс = Таблица.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Таблица[Индекс].Клиент = Клиент Или Не ЗначениеЗаполнено(Таблица[Индекс].Клиент) Тогда
			Таблица.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Таблица;

