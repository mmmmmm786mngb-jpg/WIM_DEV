КонецФункции

Функция ПараметрыСчетовХозрасчетный()

	ПараметрыСчетов = Новый Структура;
	ПС = ПланыСчетов.Хозрасчетный;

	СчетаДенежныхСредств = Новый Массив;
	СчетаДенежныхСредств.Добавить(ПС.РасчетныеСчета);
	СчетаДенежныхСредств.Добавить(ПС.ТекущиеСчета);
	СчетаДенежныхСредств.Добавить(ПС.ТранзитныеСчета);
	СчетаДенежныхСредств.Добавить(ПС.РасчетыБрокераПоСделкам55);
	СчетаДенежныхСредств.Добавить(ПС.РасчетыБрокераПоСделкам);

	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЦенныеБумаги);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ВидыОбращаемостиЦБ);

	ПараметрыСчетов.Вставить("СчетаДенежныхСредств", СчетаДенежныхСредств);
	ПараметрыСчетов.Вставить("РасчетыПоОблигациям", ПС.РасчетыПоОблигациям);
	ПараметрыСчетов.Вставить("РасходыПоУплаченномуНКД", ПС.СчетаПоСтроке("91.02.02"));
	ПараметрыСчетов.Вставить("УплаченныйНКД", ПС.СчетаПоСтроке("76.05.1"));
	ПараметрыСчетов.Вставить("ВидыСубконто", ВидыСубконто);

	Возврат ПараметрыСчетов;

КонецФункции

Функция ЛатентныеКупоныКлиента(Клиент, ДатаКонца, ПараметрыСчетов)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3 КАК Купон
	|ПОМЕСТИТЬ КупоныКлиента
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			СчетДт В (&СчетаДенежныхСредств),
	|			,
	|			СчетКт В (&РасчетыПоОблигациям),
	|			,
	|			Портфель.Клиент = &Клиент) КАК ХозрасчетныйОборотыДтКт
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
	|	ХозрасчетныйОбороты.Субконто1 КАК Актив,
	|	ХозрасчетныйОбороты.КорСубконто3 КАК Партия,
	|	ХозрасчетныйОбороты.КорСубконто2 КАК Купон,
	|	""КорСубконто2"" КАК ВидСвязи,
	|	ХозрасчетныйОбороты.СуммаОборотДт КАК СуммаОборотДт
	|ПОМЕСТИТЬ ПереводыКлиента
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В (&РасходыПоУплаченномуНКД),
	|			&ВидыСубконто,
	|			Портфель.Клиент = &Клиент,
	|			КорСчет В (&УплаченныйНКД),
	|			) КАК ХозрасчетныйОбороты
	|ГДЕ
	|	ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Регистратор,
	|	ХозрасчетныйОбороты.Субконто1,
	|	ХозрасчетныйОбороты.КорСубконто3,
	|	ХозрасчетныйОбороты.КорСубконто3,
	|	""КорСубконто3"",
	|	ХозрасчетныйОбороты.СуммаОборотДт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В (&РасходыПоУплаченномуНКД),
	|			&ВидыСубконто,
	|			Портфель.Клиент = &Клиент,
	|			КорСчет В (&РасчетыПоОблигациям),
	|			) КАК ХозрасчетныйОбороты
	|ГДЕ
	|	ХозрасчетныйОбороты.Регистратор ССЫЛКА Документ.ПереводНКДВЗадолженностьЭмитента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПереводыКлиента.Купон КАК Купон,
	|	ПереводыКлиента.ВидСвязи КАК ВидСвязи,
	|	ПереводыКлиента.Регистратор КАК Регистратор,
	|	ПереводыКлиента.Актив КАК Актив,
	|	ПереводыКлиента.Партия КАК Партия,
	|	ПереводыКлиента.СуммаОборотДт КАК СуммаОборотДт
	|ИЗ
	|	ПереводыКлиента КАК ПереводыКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ КупоныКлиента КАК КупоныКлиента
	|		ПО ПереводыКлиента.Купон = КупоныКлиента.Купон
	|ГДЕ
	|	КупоныКлиента.Купон ЕСТЬ NULL";

	УстановитьПараметрыЗапросаНКД(Запрос, Клиент, ДатаКонца, ПараметрыСчетов);
	Таблица = Запрос.Выполнить().Выгрузить();

	Индекс = Таблица.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Не ЗначениеЗаполнено(Таблица[Индекс].Купон) Тогда
			Таблица.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ПартнерыПоКупонам(Клиент, ДатаКонца, ПараметрыСчетов, МассивЛатентныхКупонов)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОборотыДтКт.Портфель.Клиент КАК Клиент,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3 КАК Купон,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт2 КАК Облигация,
	|	СУММА(ХозрасчетныйОборотыДтКт.СуммаОборот) КАК СуммаОборот
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			СчетДт В (&СчетаДенежныхСредств),
	|			,
	|			СчетКт В (&РасчетыПоОблигациям),
	|			,
	|			Портфель.Клиент <> &Клиент) КАК ХозрасчетныйОборотыДтКт
	|ГДЕ
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3 В(&ЛатентныеКупоны)
	|	И ХозрасчетныйОборотыДтКт.Портфель.Клиент <> &Клиент
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОборотыДтКт.Портфель.Клиент,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт3,
	|	ХозрасчетныйОборотыДтКт.СубконтоКт2
	|
	|УПОРЯДОЧИТЬ ПО
	|	Клиент,
	|	Купон";

	УстановитьПараметрыЗапросаНКД(Запрос, Клиент, ДатаКонца, ПараметрыСчетов);
	Запрос.УстановитьПараметр("ЛатентныеКупоны", МассивЛатентныхКупонов);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура УстановитьПараметрыЗапросаНКД(Запрос, Клиент, ДатаКонца, ПараметрыСчетов)

	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ДатаКонца));
	Запрос.УстановитьПараметр("КонецПериода", ДатаКонца);
	Запрос.УстановитьПараметр("СчетаДенежныхСредств", ПараметрыСчетов.СчетаДенежныхСредств);
	Запрос.УстановитьПараметр("РасчетыПоОблигациям", ПараметрыСчетов.РасчетыПоОблигациям);
	Запрос.УстановитьПараметр("РасходыПоУплаченномуНКД", ПараметрыСчетов.РасходыПоУплаченномуНКД);
	Запрос.УстановитьПараметр("УплаченныйНКД", ПараметрыСчетов.УплаченныйНКД);
	Запрос.УстановитьПараметр("ВидыСубконто", ПараметрыСчетов.ВидыСубконто);

КонецПроцедуры

Процедура ЗаполнитьТаблицуЛатентных(Приемник, Источник)

	Для Каждого СтрокаИсточника Из Источник Цикл
		СтрокаПриемника = Приемник.Добавить();
		СтрокаПриемника.Купон = Строка(СтрокаИсточника.Купон);
		СтрокаПриемника.ВидСвязи = СтрокаИсточника.ВидСвязи;
		СтрокаПриемника.Регистратор = Строка(СтрокаИсточника.Регистратор);
		СтрокаПриемника.Актив = Строка(СтрокаИсточника.Актив);
		СтрокаПриемника.Партия = Строка(СтрокаИсточника.Партия);
		СтрокаПриемника.СуммаОборотДт = СтрокаИсточника.СуммаОборотДт;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьТаблицуПартнеров(Приемник, Источник)

	Для Каждого СтрокаИсточника Из Источник Цикл
		СтрокаПриемника = Приемник.Добавить();
		СтрокаПриемника.Клиент = СтрокаИсточника.Клиент;
		СтрокаПриемника.Купон = Строка(СтрокаИсточника.Купон);
		СтрокаПриемника.Облигация = Строка(СтрокаИсточника.Облигация);
		СтрокаПриемника.СуммаОплаты = СтрокаИсточника.СуммаОборот;
	КонецЦикла;

КонецПроцедуры

Процедура СравнитьКэшНКД(Результат, Клиент, ДатаКонца, МассивПартнеров)

	ТаблицаОдин = ТаблицаНКДПоКлиентам(Результат, Клиент, ДатаКонца, Новый Массив);
	ТаблицаМасс = ТаблицаНКДПоКлиентам(Результат, Клиент, ДатаКонца, МассивПартнеров);

	Результат.СтрокОдин = ТаблицаОдин.Количество();
	Результат.СтрокМассовый = ТаблицаМасс.Количество();
	Результат.СуммаМодулейОдин = СуммаМодулей(ТаблицаОдин);
	Результат.СуммаМодулейМассовый = СуммаМодулей(ТаблицаМасс);
	Результат.ДельтаМодулей = Результат.СуммаМодулейОдин - Результат.СуммаМодулейМассовый;

	СоответствиеОдин = СоответствиеПоКлючуНКД(ТаблицаОдин);
	СоответствиеМасс = СоответствиеПоКлючуНКД(ТаблицаМасс);

	ВсеКлючи = Новый Соответствие;
	Для Каждого КлючИЗначение Из СоответствиеОдин Цикл
		ВсеКлючи.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;
	Для Каждого КлючИЗначение Из СоответствиеМасс Цикл
		ВсеКлючи.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;

	Для Каждого КлючИЗначение Из ВсеКлючи Цикл
		СтрокаОдин = СоответствиеОдин.Получить(КлючИЗначение.Ключ);
		СтрокаМасс = СоответствиеМасс.Получить(КлючИЗначение.Ключ);
		СуммаОдин = 0;
		СуммаМасс = 0;
		Если СтрокаОдин <> Неопределено Тогда
			СуммаОдин = СтрокаОдин.Сумма;
		КонецЕсли;
		Если СтрокаМасс <> Неопределено Тогда
			СуммаМасс = СтрокаМасс.Сумма;
		КонецЕсли;
		Если СуммаОдин = СуммаМасс Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЛишняя = Результат.ЛишниеСтроки.Добавить();
		Если СтрокаОдин = Неопределено Тогда
			СтрокаЛишняя.ВидРасхождения = "Только в массовом";
			ЗаполнитьПредставлениеСтрокиНКД(СтрокаЛишняя, СтрокаМасс);
		ИначеЕсли СтрокаМасс = Неопределено Тогда
			СтрокаЛишняя.ВидРасхождения = "Только в одиночном";
			ЗаполнитьПредставлениеСтрокиНКД(СтрокаЛишняя, СтрокаОдин);
		Иначе
			СтрокаЛишняя.ВидРасхождения = "Сумма отличается";
			ЗаполнитьПредставлениеСтрокиНКД(СтрокаЛишняя, СтрокаОдин);
		КонецЕсли;
		СтрокаЛишняя.СуммаОдин = СуммаОдин;
		СтрокаЛишняя.СуммаМассовый = СуммаМасс;
	КонецЦикла;

КонецПроцедуры

Функция ТаблицаНКДПоКлиентам(Результат, Клиент, ДатаКонца, МассивПартнеров)

	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("Актив");
	ПустаяТаблица.Колонки.Добавить("Партия");
	ПустаяТаблица.Колонки.Добавить("Регистратор");
	ПустаяТаблица.Колонки.Добавить("Период");
	ПустаяТаблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	МассивПар = Новый Массив;
	ПараКлиента = Новый Структура("Клиент, Дата", Клиент, ДатаКонца);
	МассивПар.Добавить(ПараКлиента);
	Для Каждого Партнер Из МассивПартнеров Цикл
		МассивПар.Добавить(Новый Структура("Клиент, Дата", Партнер, ДатаКонца));
	КонецЦикла;

	Попытка
		Кэш = Документы.НачислениеНДФЛПоУправляющейКомпании.ПолучитьРасходыПоНКДПоКлиентам(МассивПар);
	Исключение
		Результат.ТекстОшибкиКэша = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Не ЗначениеЗаполнено(Результат.Вердикт) Тогда
			Результат.Вердикт = "Не удалось вызвать ПолучитьРасходыПоНКДПоКлиентам: " + Результат.ТекстОшибкиКэша;
		КонецЕсли;
		Возврат ПустаяТаблица;
	КонецПопытки;

	КлючКэша = Документы.НачислениеНДФЛПоУправляющейКомпании.КлючКэшаНКД(Клиент, ДатаКонца);
	ПоКлиенту = Кэш.Получить(КлючКэша);
	Если ПоКлиенту = Неопределено Или ПоКлиенту.ПоРегистраторам = Неопределено Тогда
		Возврат ПустаяТаблица;
	КонецЕсли;

	Возврат ПоКлиенту.ПоРегистраторам;

КонецФункции

Функция СуммаМодулей(Таблица)

	ИтогСуммы = 0;
	Если Таблица = Неопределено Тогда
		Возврат ИтогСуммы;
	КонецЕсли;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИтогСуммы = ИтогСуммы + Макс(-СтрокаТаблицы.Сумма, СтрокаТаблицы.Сумма);
	КонецЦикла;
	Возврат ИтогСуммы;

КонецФункции

Функция СоответствиеПоКлючуНКД(Таблица)

	РезультатСоответствие = Новый Соответствие;
	Если Таблица = Неопределено Тогда
		Возврат РезультатСоответствие;
	КонецЕсли;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		КлючСтроки = Строка(СтрокаТаблицы.Партия) + "|" + Строка(СтрокаТаблицы.Регистратор)
			+ "|" + Строка(СтрокаТаблицы.Актив) + "|" + Формат(СтрокаТаблицы.Период, "ДФ=yyyyMMddHHmmss");
		РезультатСоответствие.Вставить(КлючСтроки, СтрокаТаблицы);
	КонецЦикла;
	Возврат РезультатСоответствие;

КонецФункции

Процедура ЗаполнитьПредставлениеСтрокиНКД(СтрокаПриемника, СтрокаНКД)

	СтрокаПриемника.Актив = Строка(СтрокаНКД.Актив);
	СтрокаПриемника.Партия = Строка(СтрокаНКД.Партия);
	СтрокаПриемника.Регистратор = Строка(СтрокаНКД.Регистратор);
	СтрокаПриемника.Период = СтрокаНКД.Период;

КонецПроцедуры

#КонецОбласти
