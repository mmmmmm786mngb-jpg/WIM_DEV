		ПараметрыРегистрации.Вставить("ПереименоватьПриЗагрузке", Истина);
		ПараметрыРегистрации.Вставить("СтароеИмяФайла", "ASP-16677 Отчет о финансовом результате (ЕПС)");
		ПараметрыРегистрации.Вставить("НовоеИмяФайла", "внОтчетОФинансовомРезультате_ЕПС");
	КонецЕсли;
	//
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.Представление = ЭтотОбъект.Метаданные().Синоним;
	Команда.Идентификатор = ЭтотОбъект.Метаданные().Синоним;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

