// Возвращаемое значение:
//  Структура - содержит:
//    мРасшифровкаПоказателей - Массив - массив таблиц расшифровки показателей
//    мЗначенияПоказателей     - Массив - массив структур значений показателей
//    мРасшифровкаПоАктивам     - Массив - массив структур расшифровки по активам
//    ВсеОшибки                - Массив - массив структур с ошибками (НаменованиеПоказателя, ТекстОшибки)
//
Функция ОжидатьЗавершенияФоновыхЗаданий(АктивныеЗадания, РасшифровкаПоказателей, ЗначенияПоказателей, РасшифровкаПоАктивам)
	
	ВсеОшибки = Новый Массив;
	мРасшифровкаПоказателей = Новый Массив;
	мРасшифровкаПоказателей.Добавить(РасшифровкаПоказателей);
	мЗначенияПоказателей = Новый Массив;
	мЗначенияПоказателей.Добавить(ЗначенияПоказателей);
	мРасшифровкаПоАктивам = Новый Массив;
	мРасшифровкаПоАктивам.Добавить(РасшифровкаПоАктивам);
	
	// Список ключей для безопасного удаления во время итерации
	КлючиДляУдаления = Новый Массив;
	
	// Защита от бесконечного цикла: максимальное время ожидания 1 час
	ВремяНачалаОжидания = ТекущаяДатаСеанса();
	МаксимальноеВремяОжидания = 60 * 60; // 1 час в секундах
	
	// Временная коллекция для новых заданий, создаваемых во время обработки результатов от ОборотыСчета
	// (чтобы не нарушать итератор цикла Для Каждого)
	НовыеЗадания = Новый Соответствие;
	
	// Оптимизация: цикл только по активным заданиям, удаляем завершенные сразу
	Пока АктивныеЗадания.Количество() > 0 Цикл
		
		// Проверка таймаута: если прошло более 1 часа - принудительный выход
		ПрошедшееВремя = ТекущаяДатаСеанса() - ВремяНачалаОжидания;
		Если ПрошедшееВремя > МаксимальноеВремяОжидания Тогда
			СтруктураОшибки = Новый Структура;
			СтруктураОшибки.Вставить("НаменованиеПоказателя", "Таймаут ожидания");
			СтруктураОшибки.Вставить("ТекстОшибки", "Превышено максимальное время ожидания завершения фоновых заданий (1 час). Осталось активных заданий: " + АктивныеЗадания.Количество());
			ВсеОшибки.Добавить(СтруктураОшибки);
			Прервать;
		КонецЕсли;
		КлючиДляУдаления.Очистить();
		НовыеЗадания.Очистить();
		
		Для Каждого ЭлементЗадания Из АктивныеЗадания Цикл
			GUIDЗадания = ЭлементЗадания.Ключ;
			
			// Обрабатываем оба варианта: структура (для ОборотыСчета) или строка (для обычных заданий)
			ДанныеЗадания = ЭлементЗадания.Значение;
			Если ТипЗнч(ДанныеЗадания) = Тип("Структура") Тогда
				АдресХранилищаРезультата = ДанныеЗадания.АдресХранилищаРезультата;
			Иначе
				АдресХранилищаРезультата = ДанныеЗадания;
			КонецЕсли;
			
			// Проверяем статус операции через ДлительныеОперации
			// IMAPPS-34356: ТестовыйРежим {
			Если ТестовыйРежим Тогда
				РезультатОперации = Новый Структура("Статус", "Выполнено");
			Иначе
			// } IMAPPS-34356: ТестовыйРежим
				РезультатОперации = ДлительныеОперации.ОперацияВыполнена(GUIDЗадания);
			// IMAPPS-34356: ТестовыйРежим {
			КонецЕсли;
			// } IMAPPS-34356: ТестовыйРежим
			
			Если РезультатОперации.Статус = "Выполнено" Тогда
				РезультатЗаданияXML = ПолучитьИзВременногоХранилища(АдресХранилищаРезультата);
				РезультатЗадания = ДанныеИзXML(РезультатЗаданияXML);
				
				// Проверяем тип операции: если это результат от ОборотыСчета, обрабатываем специальным образом
				Если РезультатЗадания.Свойство("ТипОперации") И РезультатЗадания.ТипОперации = "ОборотыСчета" Тогда
					
					// Обрабатываем результат от ОборотыСчета
					ОбщиеОбороты = РезультатЗадания.ОбщиеОбороты;
					ТипОптимизацииРезультата = РезультатЗадания.ТипОптимизации;
					
					// Обрабатываем ошибки
					Если РезультатЗадания.Свойство("Ошибки") Тогда
						Для Каждого Ошибка Из РезультатЗадания.Ошибки Цикл
							ВсеОшибки.Добавить(Ошибка);
						КонецЦикла;
					КонецЕсли;
					
					// Если есть обороты, запускаем расчеты показателей в зависимости от типа оптимизации
					Если ЗначениеЗаполнено(ОбщиеОбороты) Тогда
						
						Если ТипОптимизацииРезультата = "1_4" Тогда
							
							ДанныеРаздела1_4 = ПодготовитьДанныеРаздела1_4(ОбщиеОбороты);
							
							ЗаполнитьПоказателиГруппа9ВФоне(НовыеЗадания,
								ДанныеРаздела1_4.ОборотыП141, "П1413",
								"СуммаОборот", "КорСубконто1", НаименованияСтрок().Акции, -1);
							
							ЗаполнитьПоказателиГруппа9ВФоне(НовыеЗадания,
								ДанныеРаздела1_4.ОборотыП142, "П1423",
								"СуммаОборот", "КорСубконто1", НаименованияСтрок().ОблигацииГос, -1);
							
							ЗаполнитьПоказателиГруппа9ВФоне(НовыеЗадания,
								ДанныеРаздела1_4.ОборотыП143, "П1433",
								"СуммаОборот", "КорСубконто1", НаименованияСтрок().ОблигацииКорп, -1);
							
							ЗаполнитьПоказателиГруппа9ВФоне(НовыеЗадания,
								ДанныеРаздела1_4.ОборотыП144, "П1443",
								"СуммаОборот", "КорСубконто1", НаименованияСтрок().Паи, -1);
							
						ИначеЕсли ТипОптимизацииРезультата = "3_2_6" Тогда
							
							ДанныеРаздела3_2_6 = ПодготовитьДанныеРаздела3_2_6(ОбщиеОбороты);
							
							ЗаполнитьПоказателиГруппа5ВФоне(НовыеЗадания,
								ДанныеРаздела3_2_6.ОборотыП3261, "П32613", "П32614",
								"СуммаОборотКт", "СуммаНУОборотКт", "КорСубконто1", НаименованияСтрок().НКД1);
							
							ЗаполнитьПоказателиГруппа5ВФоне(НовыеЗадания,
								ДанныеРаздела3_2_6.ОборотыП3262, "П32623", "П32624",
								"СуммаОборотКт", "СуммаНУОборотКт", "КорСубконто1", НаименованияСтрок().НКД2);
							
						ИначеЕсли ТипОптимизацииРезультата = "4_2_6" Тогда
							
							ДанныеРаздела4_2_6 = ПодготовитьДанныеРаздела4_2_6(ОбщиеОбороты);
							
							ЗаполнитьПоказателиГруппа5ВФоне(НовыеЗадания,
								ДанныеРаздела4_2_6.ОборотыП4261, "П42613", "П42614",
								"СуммаОборот", "СуммаНУОборот", "КорСубконто1", НаименованияСтрок().Амортизация);
							
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе
					// Обычная обработка результатов расчета показателей
				мРасшифровкаПоказателей.Добавить(РезультатЗадания.РасшифровкаПоказателей);
				мЗначенияПоказателей.Добавить(РезультатЗадания.ЗначенияПоказателей);
				мРасшифровкаПоАктивам.Добавить(РезультатЗадания.РасшифровкаПоАктивам);
				
				Для Каждого Ошибка Из РезультатЗадания.Ошибки Цикл
					ВсеОшибки.Добавить(Ошибка); // Массив структур с ключами: НаменованиеПоказателя, ТекстОшибки
				КонецЦикла;
				КонецЕсли;
				
				КлючиДляУдаления.Добавить(GUIDЗадания);
				
			ИначеЕсли РезультатОперации.Статус = "Ошибка" Тогда
				СтруктураОшибки = Новый Структура;
				СтруктураОшибки.Вставить("НаменованиеПоказателя", GUIDЗадания);
				Если ЗначениеЗаполнено(РезультатОперации.КраткоеПредставлениеОшибки) Тогда
					СтруктураОшибки.Вставить("ТекстОшибки", РезультатОперации.КраткоеПредставлениеОшибки);
				Иначе
					СтруктураОшибки.Вставить("ТекстОшибки", "Задание завершилось с ошибкой");
				КонецЕсли;
				ВсеОшибки.Добавить(СтруктураОшибки);
				КлючиДляУдаления.Добавить(GUIDЗадания);
				
			ИначеЕсли РезультатОперации.Статус = "Отменено" Тогда
				КлючиДляУдаления.Добавить(GUIDЗадания);
			КонецЕсли;
			
		КонецЦикла;
		
		// Добавляем новые задания, созданные во время обработки результатов от ОборотыСчета
		// (чтобы не нарушать итератор цикла Для Каждого)
		Для Каждого НовоеЗадание Из НовыеЗадания Цикл
			АктивныеЗадания.Вставить(НовоеЗадание.Ключ, НовоеЗадание.Значение);
		КонецЦикла;
		
		// Удаляем завершенные задания из АктивныеЗадания (нельзя удалять во время итерации)
		Для Каждого Ключ Из КлючиДляУдаления Цикл
			АктивныеЗадания.Удалить(Ключ);
		КонецЦикла;
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("мРасшифровкаПоказателей", мРасшифровкаПоказателей);
	Результат.Вставить("мЗначенияПоказателей", мЗначенияПоказателей);
	Результат.Вставить("мРасшифровкаПоАктивам", мРасшифровкаПоАктивам);
	Результат.Вставить("ВсеОшибки", ВсеОшибки);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

