Функция ОборотыСчета(Условия)
	
	МассивУсловий = Условия;
	Результат = Неопределено;
	
	Если ТипЗнч(Условия) = Тип("Структура") Тогда
		МассивУсловий = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Условия);
	КонецЕсли;
	
	Для Каждого Условие Из МассивУсловий Цикл
		
		Построитель = Новый ПостроительЗапроса;
		Построитель.Текст =
			"ВЫБРАТЬ
			|	ЕПСОбороты.Счет,
			|	ЕПСОбороты.КорСчет,
			|	ЕПСОбороты.Портфель,
			|	ЕПСОбороты.Валюта,
			|	ЕПСОбороты.ВалютаКор,
			|	ЕПСОбороты.ЛицевойСчет,
			|	ЕПСОбороты.ЛицевойСчетКор,
			|	ЕПСОбороты.СуммаОборот,
			|	ЕПСОбороты.СуммаОборотДт,
			|	ЕПСОбороты.СуммаОборотКт,
			|	ЕПСОбороты.ВалютнаяСуммаОборот,
			|	ЕПСОбороты.ВалютнаяСуммаОборотДт,
			|	ЕПСОбороты.ВалютнаяСуммаОборотКт,
			|	ЕПСОбороты.ВалютнаяСуммаКорОборот,
			|	ЕПСОбороты.ВалютнаяСуммаКорОборотДт,
			|	ЕПСОбороты.ВалютнаяСуммаКорОборотКт,
			|	ЕПСОбороты.КоличествоОборот,
			|	ЕПСОбороты.КоличествоОборотДт,
			|	ЕПСОбороты.КоличествоОборотКт,
			|	ЕПСОбороты.КоличествоКорОборот,
			|	ЕПСОбороты.КоличествоКорОборотДт,
			|	ЕПСОбороты.КоличествоКорОборотКт,
			|	ЕПСОбороты.СуммаНУОборот,
			|	ЕПСОбороты.СуммаНУОборотДт,
			|	ЕПСОбороты.СуммаНУОборотКт,
			|	ЕПСОбороты.СуммаНУКорОборот,
			|	ЕПСОбороты.СуммаНУКорОборотДт,
			|	ЕПСОбороты.СуммаНУКорОборотКт
			|{ВЫБРАТЬ
			|	ЕПСОбороты.Субконто1.*,
			|	ЕПСОбороты.Субконто2.*,
			|	ЕПСОбороты.Субконто3.*,
			|	ЕПСОбороты.КорСубконто1.*,
			|	ЕПСОбороты.КорСубконто2.*,
			|	ЕПСОбороты.КорСубконто3.*}
			|ИЗ
			|	РегистрБухгалтерии.ЕПС.Обороты КАК ЕПСОбороты";
		
		Построитель.ЗаполнитьНастройки();
		
		Для Каждого Элемент Из Условие.Отборы Цикл
			
			Если ЗначениеЗаполнено(Элемент.Значение) Тогда
				ИмяОтбора = Элемент.Ключ;
				ЭлементОтбора = Построитель.Отбор.Найти(ИмяОтбора);
				Если ЭлементОтбора = Неопределено Тогда
					ЭлементОтбора = Построитель.Отбор.Добавить(ИмяОтбора);
					ЭлементОтбора.Использование = Истина;
				КонецЕсли;
				Если ТипЗнч(Элемент.Значение) = Тип("Структура") Тогда
					ЗаполнитьЗначенияСвойств(ЭлементОтбора, Элемент.Значение);
				Иначе
					ЭлементОтбора.Значение = Элемент.Значение;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		ЭлементОтбора = Построитель.Отбор.Найти("Субконто");
		Если ЭлементОтбора <> Неопределено Тогда
			Если ТипЗнч(ЭлементОтбора.Значение) = Тип("СписокЗначений") Тогда
				НачальноеСубконто = ЭлементОтбора.Значение.Количество() + 1;
			Иначе
				НачальноеСубконто = 2;
			КонецЕсли;
			Для й = НачальноеСубконто + 1 По 3 Цикл
				Построитель.ВыбранныеПоля.Удалить(Построитель.ВыбранныеПоля.Найти("Субконто" + й));
			КонецЦикла;
		КонецЕсли;
		
		ЭлементОтбора = Построитель.Отбор.Найти("КорСубконто");
		Если ЭлементОтбора <> Неопределено Тогда
			Если ТипЗнч(ЭлементОтбора.Значение) = Тип("СписокЗначений") Тогда
				НачальноеСубконто = ЭлементОтбора.Значение.Количество() + 1;
			Иначе
				НачальноеСубконто = 2;
			КонецЕсли;
			Для й = НачальноеСубконто По 3 Цикл
				Построитель.ВыбранныеПоля.Удалить(Построитель.ВыбранныеПоля.Найти("КорСубконто" + й));
			КонецЦикла;
			
			// VTimofeev IMAPPS-13201
			тВалютаКор = Построитель.ВыбранныеПоля.Найти("ВалютаКор");
			Если Не тВалютаКор = Неопределено И ЭлементОтбора.Значение = Справочники.Валюты.ПустаяСсылка() Тогда
				Построитель.ВыбранныеПоля.Удалить(тВалютаКор);
				Построитель.Текст = Построитель.Текст + " ГДЕ ЕПСОбороты.ВалютаКор ЕСТЬ НЕ NULL";
			КонецЕсли;
			// VTimofeev IMAPPS-13201
		КонецЕсли;
		
		Построитель.Выполнить();
		
		ОбщегоНазначенияДУ.ДобавитьВЛогОтладки(Построитель.ПолучитьЗапрос(), Условие.Наименование);
		
		Если Результат = Неопределено Тогда
			Результат = Построитель.Результат.Выгрузить();
		Иначе
			РезультатЗапроса = Построитель.Результат.Выгрузить();
			ОбщегоНазначенияКлиентСервер.ЗаполнитьКоллекциюСвойств(РезультатЗапроса, Результат);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

