Функция ЗаполнитьДанныеПодписанта(Макет)
	
	ДолжностьСтр = Подписант.Должность;
	ДолжностьСтр = СтрЗаменить(ДолжностьСтр, "(", Символы.ПС);
	Должность = СтрПолучитьСтроку(ДолжностьСтр, 1);
	Попытка
		Макет.Области.Подписант.Значение = Подписант.ПолноеНаименование();
		Макет.Области.Должность.Значение = Должность;
	Исключение
		Попытка
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
				|	ЗначенияПараметровПортфеляСрезПоследних.Портфель КАК Портфель,
				|	ЗначенияПараметровПортфеляСрезПоследних.Период КАК Период,
				|	ЗначенияПараметровПортфеляСрезПоследних.Параметр.Код КАК ПараметрКод,
				|	ЗначенияПараметровПортфеляСрезПоследних.Регистратор.Номер КАК Номер
				|ИЗ
				|	РегистрСведений.ЗначенияПараметровПортфеля.СрезПоследних(&Период, Портфель = &Портфель) КАК ЗначенияПараметровПортфеляСрезПоследних
				|ГДЕ
				|	ЗначенияПараметровПортфеляСрезПоследних.Параметр.Код = ""ПодписантыРегламентированнойОтчетности""";
			Запрос.УстановитьПараметр("Портфель", Портфель);
			Запрос.УстановитьПараметр("Период", Период.ДатаОкончания);
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			Номер = 0;
			
			Пока Выборка.Следующий() Цикл
				Номер = Выборка.Номер;
			КонецЦикла;
			НастройкаОтчетности = Документы.НастройкиОтчетности.НайтиПоНомеру(Номер);
			об = НастройкаОтчетности.ПолучитьОбъект();
			Таблица = об.Подписанты.Выгрузить();
			Имя = Таблица[0][1];
			Дол = Справочники.КонтактныеЛица.НайтиПоНаименованию(Имя, Ложь, , );
			ДолжностьСтр = Дол.Должность;
			ДолжностьСтр = СтрЗаменить(ДолжностьСтр, "(", Символы.ПС);
			Должность = СтрПолучитьСтроку(ДолжностьСтр, 1);
			Макет.Области.Подписант.Значение = Имя;
			Макет.Области.Должность.Значение = Должность;
		Исключение
			Сообщить("Внимание! Подписант не задан на форме отчета в НастройкахОтчетности - поэтому подписант в отчете не заполнен");
		КонецПопытки;
	КонецПопытки;
	
КонецФункции


Процедура ЗаполнитьШапкуИПодвал(Макет)
	
	УправляющаяКомпания = РегламентированнаяОтчетность.ПолучитьСведенияОбОрганизации(Портфель);
	
	Макет.Области.ОргНаименование.Значение = СокрЛП(УправляющаяКомпания.НаимЮЛПол);
	Макет.Области.КлиентНаименование.Значение = СтрШаблон("ДУ ""%1""", СокрЛП(Портфель.ПолноеНаименование));
	Макет.Области.ПортфельРеквизиты.Значение = СтрШаблон("по договору доверительного управления №%1 от %2", Портфель.Код, Формат(Портфель.ДатаНачала, "ДЛФ=DD"));
	Макет.Области.ПериодОтчета.Значение = СтрШаблон("С %1 по %2", Формат(Период.ДатаНачала, "ДЛФ=DD"), Формат(Период.ДатаОкончания, "ДЛФ=DD"));
	ЗаполнитьДанныеПодписанта(Макет);
	//Макет.Области.Бухгалтер.Значение = УправляющаяКомпания.ФИОБух;
	
КонецПроцедуры

Процедура ЗаполнитьПоказателиМакета(Макет, Результат)
	
	Область = Макет.Области;
	Для Каждого Элемент Из Результат.ЗначенияПоказателей Цикл
		
		ИмяПоказателя = Элемент.Ключ;
		ЗначениеПоказателя = Элемент.Значение;
		
		Область[ИмяПоказателя].Значение = ЗначениеПоказателя;
		
	КонецЦикла;
	
	Если Расшифровка Тогда
		
		Для Каждого Элемент Из Результат.РасшифровкаПоАктивам Цикл
			
			ИмяПоказателя = Элемент.Ключ;
			ЗначениеПоказателя = Элемент.Значение;
			
			ВывестиРасшифровкуПоАктивам(Макет, ИмяПоказателя, ЗначениеПоказателя);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиРасшифровкуПоАктивам(Макет, ИмяПоказателя, РасшифровкаПоАктивам)
	
	ОбластьЯчейки = Макет.Области[ИмяПоказателя];
	НомерСледующейСтроки = ОбластьЯчейки.Низ + 1;
	Шрифт = Новый Шрифт("Times New Roman", 10, Ложь);
	Формат = "ЧДЦ=2; ЧРГ=' '; ЧН=0,00";
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число");
	
	Для Каждого ТекСтрока Из РасшифровкаПоАктивам Цикл
		
		НоваяОбласть = Макет.Область(НомерСледующейСтроки, , НомерСледующейСтроки, );
		Макет.ВставитьОбласть(НоваяОбласть, , ТипСмещенияТабличногоДокумента.ПоВертикали);
		НоваяОбласть.Очистить();
		
		ТекЯчейка = Макет.Область(НомерСледующейСтроки, 3);
		ТекЯчейка.СодержитЗначение = Ложь;
		ТекЯчейка.Шрифт = Шрифт;
		ТекЯчейка.Текст = ТекСтрока.Актив;
		ТекЯчейка.Расшифровка = ТекСтрока.Актив;
		ТекЯчейка.Отступ = 3;
		
		ТекЯчейка = Макет.Область(НомерСледующейСтроки, 5);
		ТекЯчейка.СодержитЗначение = Истина;
		ТекЯчейка.Шрифт = Шрифт;
		ТекЯчейка.Формат = Формат;
		ТекЯчейка.ТипЗначения = ОписаниеТиповЧисло;
		ТекЯчейка.Значение = ТекСтрока.Сумма;
		
		ТекЯчейка = Макет.Область(НомерСледующейСтроки, 6);
		ТекЯчейка.Шрифт = Шрифт;
		Если ТекСтрока.ВыводитьСуммуНУ Тогда
			ТекЯчейка.СодержитЗначение = Истина;
			ТекЯчейка.Формат = Формат;
			ТекЯчейка.ТипЗначения = ОписаниеТиповЧисло;
			ТекЯчейка.Значение = ТекСтрока.СуммаНУ;
		Иначе
			ТекЯчейка.СодержитЗначение = Ложь;
			ТекЯчейка.Текст = "X";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

