		Коэффициент = ?(ВходящиеПараметры.Свойство("Коэффициент"), ВходящиеПараметры.Коэффициент, 1);
		
		РасшифровкаПоказателей = ЗаполнениеРасшифровкаРегламентированнойОтчетности.ПустаяТаблицаРасшифровок();
		ЗначенияПоказателей = Новый Структура;
		РасшифровкаПоАктивам = Новый Структура;
		
		ЗаполнитьЗначенияПоказателей(ЗначенияПоказателей, ПоказательБУ, Обороты.Итог(СуммаБУ), Коэффициент);
		ЗаполнитьРасшифровкуПоказателей(РасшифровкаПоказателей, ПоказательБУ, Обороты, СуммаБУ, НаменованиеПоказателя, Коэффициент);
		Если Расшифровка Тогда
			ЗаполнитьРасшифровкуПоАктивам(РасшифровкаПоАктивам, ПоказательБУ, Обороты, Актив, СуммаБУ, , Коэффициент, Ложь);
		КонецЕсли;
		
	Исключение
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("НаменованиеПоказателя", НаменованиеПоказателя);
		СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка заполнения показателя: " + ОписаниеОшибки());
		Ошибки.Добавить(СтруктураОшибки);
	КонецПопытки;
	
	Результат = Новый Структура;
	Результат.Вставить("ЗначенияПоказателей", ЗначенияПоказателей);
	Результат.Вставить("РасшифровкаПоказателей", РасшифровкаПоказателей);
	Результат.Вставить("РасшифровкаПоАктивам", РасшифровкаПоАктивам);
	Результат.Вставить("Ошибки", Ошибки);
	
	ПоместитьВоВременноеХранилище(XML(Результат), АдресХранилищаРезультата);
	
КонецПроцедуры

// Процедура - Получить ОборотыСчета в фоне
//
// Описание: Выполняет ОборотыСчета в фоновом задании и сохраняет результат
//
// Параметры:
//  Параметры - Структура - содержит:
//   * ВходящиеПараметрыXML - Строка - XML-строка с входящими параметрами (Условия, ТипОптимизации)
//  АдресХранилищаРезультата - Строка - адрес временного хранилища для результата
//
Процедура ПолучитьОборотыСчетаВФоне(Параметры, АдресХранилищаРезультата) Экспорт
	
	ВходящиеПараметрыXML = Параметры.ВходящиеПараметрыXML;
	
	Ошибки = Новый Массив;
	Попытка
		ВходящиеПараметры = ДанныеИзXML(ВходящиеПараметрыXML);
		
		Условия = ВходящиеПараметры.Условия;
		ТипОптимизации = ВходящиеПараметры.ТипОптимизации;
		
		ОбщиеОбороты = ОборотыСчета(Условия);
		
		Результат = Новый Структура;
		Результат.Вставить("ОбщиеОбороты", ОбщиеОбороты);
		Результат.Вставить("ТипОперации", "ОборотыСчета");
		Результат.Вставить("ТипОптимизации", ТипОптимизации);
		Результат.Вставить("Ошибки", Ошибки);
		
	Исключение
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("НаменованиеПоказателя", "ОборотыСчета: " + ТипОптимизации);
		СтруктураОшибки.Вставить("ТекстОшибки", "Ошибка получения оборотов: " + ОписаниеОшибки());
		Ошибки.Добавить(СтруктураОшибки);
		
		Результат = Новый Структура;
		Результат.Вставить("ОбщиеОбороты", Неопределено);
		Результат.Вставить("ТипОперации", "ОборотыСчета");
		Результат.Вставить("ТипОптимизации", ТипОптимизации);
		Результат.Вставить("Ошибки", Ошибки);
		
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(XML(Результат), АдресХранилищаРезультата);
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияПоказателей(ЗначенияПоказателей, КодПоказателя, ЗначениеПоказателя, Коэффициент = 1)
	Перем ВремЗнч;
	
	Если ЗначенияПоказателей.Свойство(КодПоказателя, ВремЗнч) Тогда
		ЗначенияПоказателей.Вставить(КодПоказателя, ВремЗнч + ЗначениеПоказателя * Коэффициент);
	Иначе
		ЗначенияПоказателей.Вставить(КодПоказателя, ЗначениеПоказателя * Коэффициент);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРасшифровкуПоказателей(РасшифровкаПоказателей, КодПоказателя, Обороты, ИмяПоляСуммы, ИмяПоказателя, Коэффициент = 1)
	
	Для Каждого Оборот Из Обороты Цикл
		
		Сумма = Оборот[ИмяПоляСуммы] * Коэффициент;
		
		Если Не ЗначениеЗаполнено(Сумма) Тогда
			Продолжить;
		КонецЕсли;
		
		Структура = Новый Структура("Счет,Субконто1Представление,Субконто2Представление,Субконто3Представление,КорСчет,КорСубконто1Представление,КорСубконто2Представление,КорСубконто3Представление");
		ЗаполнитьЗначенияСвойств(Структура, Оборот);
		
		ЗаполнениеРасшифровкаРегламентированнойОтчетности.ДобавитьСтрокуРасшифровки(
			РасшифровкаПоказателей,
			КодПоказателя,
			СтрШаблон("%1 %2", ИмяПоказателя, ?(СтрЗаканчиваетсяНа(КодПоказателя, "3"), "БУ", "НУ")),
			"+",
			СтрШаблон("Оборот счета %1 
				|	Субконто1: %2
				|	Субконто2: %3
				|	Субконто3: %4
				|в корреспонденции со счетом %5 
				|	Субконто1: %6
				|	Субконто2: %7
				|	Субконто3: %8",
				Структура.Счет,
				Структура.Субконто1Представление, Структура.Субконто2Представление, Структура.Субконто3Представление,
				Структура.КорСчет,
				Структура.КорСубконто1Представление, Структура.КорСубконто2Представление, Структура.КорСубконто3Представление),
			Сумма,
		);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРасшифровкуПоАктивам(РасшифровкаПоАктивам, КодПоказателя, Обороты, ИмяПоляАктив, ИмяПоляСумма = Неопределено, ИмяПоляСуммаНУ = Неопределено, Коэффициент = 1, ВыводитьСуммуНУ = Истина)
	
	Если Не Расшифровка Тогда
		Возврат;
	КонецЕсли;
	
	Если РасшифровкаПоАктивам.Свойство(КодПоказателя) Тогда
		
		ТаблицаПоАктивам = РасшифровкаПоАктивам[КодПоказателя];
		
	Иначе
		
		ТаблицаПоАктивам = Новый ТаблицаЗначений;
		ТаблицаПоАктивам.Колонки.Добавить("Актив");
		ТаблицаПоАктивам.Колонки.Добавить("Сумма", ОбщегоНазначения.ОписаниеТипаЧисло(20, 2));
		ТаблицаПоАктивам.Колонки.Добавить("СуммаНУ", ОбщегоНазначения.ОписаниеТипаЧисло(20, 2));
		ТаблицаПоАктивам.Колонки.Добавить("ВыводитьСуммуНУ", Новый ОписаниеТипов("Булево"));
		// VTB-Borisov  - 10.07.2018 {
		ТаблицаПоАктивам.Колонки.Добавить("АктивИмя", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		// VTB-Borisov  - 10.07.2018 }
		
	КонецЕсли;
	
	НужноЗаполнятьСумму = ЗначениеЗаполнено(ИмяПоляСумма);
	НужноЗаполнятьСуммуНУ = ЗначениеЗаполнено(ИмяПоляСуммаНУ);
	
	
	Для Каждого СтрокаТаблицы Из Обороты Цикл
		
		НоваяСтрока = ТаблицаПоАктивам.Добавить();
		НоваяСтрока.Актив = СтрокаТаблицы[ИмяПоляАктив];
		НоваяСтрока.ВыводитьСуммуНУ = ВыводитьСуммуНУ;
		// VTB-Borisov  - 10.07.2018 {
		НоваяСтрока.АктивИмя = СокрЛП(НоваяСтрока.Актив.Наименование);
		// VTB-Borisov  - 10.07.2018 }
		
		Если НужноЗаполнятьСумму Тогда
			
			НоваяСтрока.Сумма = СтрокаТаблицы[ИмяПоляСумма] * Коэффициент;
			
		КонецЕсли;
		
		Если НужноЗаполнятьСуммуНУ Тогда
			
			НоваяСтрока.СуммаНУ = СтрокаТаблицы[ИмяПоляСуммаНУ] * Коэффициент;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаПоАктивам.Свернуть("Актив,АктивИмя,ВыводитьСуммуНУ", "Сумма, СуммаНУ");
	
	РасшифровкаПоАктивам.Вставить(КодПоказателя, ТаблицаПоАктивам);
	
	// VTB-Borisov  - 10.07.2018 {
	ТаблицаПоАктивам.Сортировать("АктивИмя Убыв");
	// VTB-Borisov  - 10.07.2018 }
	
КонецПроцедуры

