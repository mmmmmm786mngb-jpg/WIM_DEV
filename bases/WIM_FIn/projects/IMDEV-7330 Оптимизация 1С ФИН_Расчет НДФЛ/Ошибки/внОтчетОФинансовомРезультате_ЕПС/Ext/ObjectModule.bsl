&НаСервере
Функция СуммаОпределениеСделокНаХудшихУсловиях_22()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		
		"ВЫБРАТЬ
		|	ПродажиОбороты.Партия.Дата КАК Партия_Дата,
		|	ПродажиОбороты.Партия.Номер КАК Партия_Номер,
		|	СО.Сделка КАК Сделка,
		|	СО.ДатаСделки КАК СО_ДатаСделки,
		|	СО.Цена КАК Цена,
		|	СО.МинМаксЦена КАК МинМаксЦена,
		|	СО.Количество КАК Количество,
		|	СО.Валюта КАК Валюта
		|ПОМЕСТИТЬ ВТ_СО
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&ДатаНач, &ДатаКон, , Портфель = &Портфель) КАК ПродажиОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОпределениеСделокНаХудшихУсловиях.СделкиСОтклонением КАК СО
		|		ПО (СО.ДатаСделки = ПродажиОбороты.Партия.Дата)
		|			И (СО.НомерСделки = ПродажиОбороты.Партия.Номер)
		|			И (СО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление))
		|			И (СО.Ссылка.Проведен = ИСТИНА)
		|			И (СО.Ссылка.Портфель = &Портфель)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА((ВТ_СО.Цена - ВТ_СО.МинМаксЦена) * ВТ_СО.Количество), 0) КАК Сумма,
		|	НАЧАЛОПЕРИОДА(ВТ_СО.СО_ДатаСделки, ДЕНЬ) КАК ДатаСделки,
		|	ВТ_СО.Валюта КАК Валюта
		|ИЗ
		|	ВТ_СО КАК ВТ_СО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка_Перерег
		|		ПО (Сделка_Перерег.Номер = ВТ_СО.Партия_Номер)
		|			И (Сделка_Перерег.Дата = ВТ_СО.Партия_Дата)
		|			И (Сделка_Перерег.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Поступление))
		|			И (Сделка_Перерег.Портфель = &Портфель)
		|			И (Сделка_Перерег.Проведен = ИСТИНА)
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ВТ_СО.СО_ДатаСделки, ДЕНЬ),
		|	ВТ_СО.Валюта";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Портфель", Портфель);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ИтогоРуб = 0;
	Пока Выборка.Следующий() Цикл
		КурсКратность = МодульВалютногоУчета.ПолучитьКурсВалюты(Справочники.Валюты.RUB, Выборка.Валюта, Выборка.ДатаСделки);
		ИтогоРуб = ИтогоРуб + МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(Выборка.Сумма, Выборка.Валюта, Справочники.Валюты.RUB, КурсКратность.Курс, 1, КурсКратность.Кратность, 1);
	КонецЦикла;
	
	Возврат ИтогоРуб;
	
КонецФункции

