&НаСервере
Функция СуммаОпределениеСделокНаХудшихУсловиях_12()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СО.Сделка КАК Сделка,
		|	НАЧАЛОПЕРИОДА(СО.ДатаСделки, День) КАК ДатаСделки,
		|	СО.ВидОперации КАК ВидОперации,
		|	СО.Цена КАК Цена,
		|	СО.МинМаксЦена КАК МинМаксЦена,
		|	СО.Количество КАК Количество,
		|	СО.Валюта КАК Валюта
		|ПОМЕСТИТЬ ВТ_СО
		|ИЗ
		|	Документ.ОпределениеСделокНаХудшихУсловиях.СделкиСОтклонением КАК СО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка_Перерег
		|		ПО (СО.ДатаСделки = Сделка_Перерег.Дата)
		|			И (СО.НомерСделки = Сделка_Перерег.Номер)
		|			И (СО.Ссылка.Проведен = ИСТИНА)
		|			И (СО.Ссылка.Портфель = &Портфель)
		|			И (СО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСделка.Продажа))
		|	
		|ГДЕ
		|	СО.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНач, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаКон, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА((ВТ_СО.Цена - ВТ_СО.МинМаксЦена) * ВТ_СО.Количество), 0) КАК Сумма,
		|	ВТ_СО.ДатаСделки КАК ДатаСделки,
		|	ВТ_СО.ВидОперации КАК ВидОперации,
		|	ВТ_СО.Валюта КАК Валюта
		|	
		|ИЗ
		|	ВТ_СО КАК ВТ_СО
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СО.ДатаСделки,
		|	ВТ_СО.ВидОперации,
		|	ВТ_СО.Валюта
		|	";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Портфель", Портфель);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	ИтогоРуб = 0;
	Пока Выборка.Следующий() Цикл
		КурсКратность = МодульВалютногоУчета.ПолучитьКурсВалюты(Справочники.Валюты.RUB, Выборка.Валюта, Выборка.ДатаСделки);
		ИтогоРуб = ИтогоРуб + МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(Выборка.Сумма, Выборка.Валюта, Справочники.Валюты.RUB, КурсКратность.Курс, 1, КурсКратность.Кратность, 1);
	КонецЦикла;
	
	Возврат ИтогоРуб;
	
КонецФункции

