Функция СформироватьОтчет(УникальныйИдентификатор) Экспорт
	
	Результат = РассчитатьПоказатели();
	Макет = СоздатьМакет(Результат);
	РасшифровкаПоказателей = Результат.РасшифровкаПоказателей;
	
	Структура = Новый Структура;
	Структура.Вставить("АдресМакета", ПоместитьВоВременноеХранилище(Макет, УникальныйИдентификатор));
	Структура.Вставить("АдресРасшифровкиПоказателей", ПоместитьВоВременноеХранилище(РасшифровкаПоказателей, УникальныйИдентификатор));
	
	Возврат Структура;
	
КонецФункции


