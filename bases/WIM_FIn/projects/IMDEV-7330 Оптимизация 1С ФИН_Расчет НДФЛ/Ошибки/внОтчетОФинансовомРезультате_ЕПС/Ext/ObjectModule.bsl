// Описание: Объединяет массив структур в одну структуру с суммированием значений
//           ОПТИМИЗИРОВАНО на основе лучших практик олимпиадного программирования
//           Сложность: O(N × M), где N - количество структур, M - среднее количество ключей
//           Пространственная сложность: O(K), где K - количество уникальных ключей
//
// Параметры:
//   МассивСтруктур - Массив - массив структур, каждая структура содержит пары Ключ-Значение
//
// Возвращаемое значение:
//   Структура - результирующая структура со всеми ключами и суммированными значениями
//
Функция ОбъединитьМассивСтруктур(МассивСтруктур)
	
	Результат = Новый Структура;
	ВременноеЗначение = Неопределено;
	
	Для Каждого СтруктураИзМассива Из МассивСтруктур Цикл
		
		Для Каждого ЭлементСтруктуры Из СтруктураИзМассива Цикл
			
			Ключ = ЭлементСтруктуры.Ключ;
			Значение = ЭлементСтруктуры.Значение;
			
			Если Результат.Свойство(Ключ, ВременноеЗначение) Тогда
				Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
					СписокТаблиц = Новый Массив;
					СписокТаблиц.Добавить(ВременноеЗначение);
					СписокТаблиц.Добавить(Значение);
					ТаблицаПоАктивам = ОбъединитьМассивТаблицЗначений(СписокТаблиц);
					Попытка
						ТаблицаПоАктивам.Свернуть("Актив, АктивИмя, ВыводитьСуммуНУ", "Сумма, СуммаНУ");
						ТаблицаПоАктивам.Сортировать("АктивИмя Убыв");
						Результат.Вставить(Ключ, ТаблицаПоАктивам);
					Исключение
						Результат.Вставить(Ключ, ТаблицаПоАктивам);
					КонецПопытки;
				Иначе
					Результат.Вставить(Ключ, ВременноеЗначение + Значение);
				КонецЕсли;
			Иначе
				Результат.Вставить(Ключ, Значение);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Описание: Объединяет массив таблиц значений с одинаковой структурой в одну таблицу
//           ОПТИМИЗИРОВАНО с проверкой пустых таблиц
//           Сложность: O(N × M), где N - количество таблиц, M - среднее количество строк
//
// Параметры:
//   МассивТаблиц - Массив - массив таблиц значений с одинаковой структурой колонок
//
// Возвращаемое значение:
//   ТаблицаЗначений - объединенная таблица со всеми строками
//
Функция ОбъединитьМассивТаблицЗначений(МассивТаблиц)
	
	Если МассивТаблиц.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	// Находим первую непустую таблицу
	Результат = Неопределено;
	Для ИндексПервойТаблицы = 0 По МассивТаблиц.Количество() - 1 Цикл
		Если МассивТаблиц[ИндексПервойТаблицы].Количество() > 0 Тогда
			Результат = МассивТаблиц[ИндексПервойТаблицы].Скопировать();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат = Неопределено Тогда
		// Все таблицы пустые - возвращаем пустую с копией структуры
		Результат = МассивТаблиц[0].СкопироватьКолонки();
		Возврат Результат;
	КонецЕсли;
	
	// Добавляем строки из остальных таблиц
	Для Индекс = ИндексПервойТаблицы + 1 По МассивТаблиц.Количество() - 1 Цикл
		
		ТекущаяТаблица = МассивТаблиц[Индекс];
		Для Каждого Строка Из ТекущаяТаблица Цикл
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Функция - Получить ссылку на обработку из справочника ДополнительныеОтчетыИОбработки
//
// Возвращаемое значение:
//  СправочникСсылка.ДополнительныеОтчетыИОбработки - ссылка на элемент справочника
//
Функция ПолучитьСсылкуНаОбработкуИзСправочника()
	
	ИмяОбработки = ЭтотОбъект.Метаданные().Имя;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &ИмяОбъекта";
	
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбработки);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Процедура - Заполнить показатели группа1 в фоне
//
// Параметры:
//  АктивныеЗадания		 - Соответствие - коллекция активных фоновых заданий
//  Условия				 - Структура	 - условия для запроса оборотов
//  ПоказательБУ			 - Строка		 - код показателя БУ
//  ПоказательНУ			 - Строка		 - код показателя НУ
//  СуммаБУ				 - Строка		 - имя поля суммы БУ
//  СуммаНУ				 - Строка		 - имя поля суммы НУ
//  Актив					 - Строка		 - имя поля актива
//  НаменованиеПоказателя - Строка		 - наименование показателя
//  Коэффициент			 - Число		 - коэффициент для расчета (по умолчанию 1)
//
// Описание:
//  Базовая процедура для заполнения показателей БУ и НУ с расшифровкой по активам.
//  Выполняет запрос оборотов, заполняет показатели БУ и НУ, создает расшифровку.
//  Остальные группы (2-8) отличаются от этой процедуры различными особенностями расчета.
//
Процедура ЗаполнитьПоказателиГруппа1ВФоне(АктивныеЗадания, Условия, ПоказательБУ, ПоказательНУ, СуммаБУ, СуммаНУ, Актив, НаменованиеПоказателя, Коэффициент = 1)
	
	ВходящиеПараметры = Новый Структура;
	ВходящиеПараметры.Вставить("Условия", Условия);
	ВходящиеПараметры.Вставить("ПоказательБУ", ПоказательБУ);
	ВходящиеПараметры.Вставить("ПоказательНУ", ПоказательНУ);
	ВходящиеПараметры.Вставить("СуммаБУ", СуммаБУ);
	ВходящиеПараметры.Вставить("СуммаНУ", СуммаНУ);
	ВходящиеПараметры.Вставить("Актив", Актив);
	ВходящиеПараметры.Вставить("НаменованиеПоказателя", НаменованиеПоказателя);
	ВходящиеПараметры.Вставить("Коэффициент", Коэффициент);
	
	// IMAPPS-34356: ТестовыйРежим {
	Если ТестовыйРежим Тогда
		// Формируем адрес временного хранилища для результата
		АдресХранилищаРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
		
		// Готовим параметры для вызова процедуры
		ПараметрыДляВызова = Новый Структура;
		ПараметрыДляВызова.Вставить("Расшифровка", Расшифровка);
		ПараметрыДляВызова.Вставить("ВходящиеПараметрыXML", XML(ВходящиеПараметры));
		
		// Вызываем процедуру напрямую
		ЗаполнитьПоказателиГруппа1(ПараметрыДляВызова, АдресХранилищаРезультата);
		
		// Эмулируем регистрацию задания
		ИдентификаторЗадания = Строка(Новый УникальныйИдентификатор);
		АктивныеЗадания.Вставить(ИдентификаторЗадания, АдресХранилищаРезультата);
		
	Иначе
	// } IMAPPS-34356: ТестовыйРежим
	
		ИдентификаторФормы = Новый УникальныйИдентификатор;
		ПараметрыВыполненияВФоне = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
		ПараметрыВыполненияВФоне.КлючФоновогоЗадания = Строка(Новый УникальныйИдентификатор);
		ПараметрыВыполненияВФоне.НаименованиеФоновогоЗадания = "Заполнение показателей группа1";
		ПараметрыВыполненияВФоне.ЗапуститьВФоне = Истина;
		
		ДополнительнаяОбработкаСсылка = ПолучитьСсылкуНаОбработкуИзСправочника();
		
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("ИмяОбработки", ЭтотОбъект.Метаданные().Имя);
		ПараметрыЗадания.Вставить("ИмяМетода", "ЗаполнитьПоказателиГруппа1");
		ПараметрыЗадания.Вставить("ПараметрыВыполнения", Новый Структура);
		ПараметрыЗадания.ПараметрыВыполнения.Вставить("Расшифровка", Расшифровка);
		ПараметрыЗадания.ПараметрыВыполнения.Вставить("ВходящиеПараметрыXML", XML(ВходящиеПараметры));
		ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
		ПараметрыЗадания.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
		
		РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне(
			"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
			ПараметрыЗадания,
			ПараметрыВыполненияВФоне
		);
		
		Если РезультатВыполнения.Статус = "Ошибка" Тогда
			ВызватьИсключение РезультатВыполнения.КраткоеПредставлениеОшибки;
		КонецЕсли;
		
		ИдентификаторЗадания = РезультатВыполнения.ИдентификаторЗадания;
		АдресХранилищаРезультата = РезультатВыполнения.АдресРезультата;
		АктивныеЗадания.Вставить(ИдентификаторЗадания, АдресХранилищаРезультата);
	// IMAPPS-34356: ТестовыйРежим {
	КонецЕсли;
	// } IMAPPS-34356: ТестовыйРежим
	
КонецПроцедуры

