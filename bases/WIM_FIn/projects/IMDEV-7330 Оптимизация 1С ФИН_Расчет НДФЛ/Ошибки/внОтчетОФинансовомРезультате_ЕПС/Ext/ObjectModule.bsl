Функция ИзвлечьПараметрыИзФормулы(Знач Формула)
	
	Формула = ВРег(Формула);
	
	Параметры = Новый Массив;
	
	Для НомерВхождения = 1 По СтрЧислоВхождений(Формула, "П") Цикл
		
		ПервыйСимвол = СтрНайти(Формула, "П", , , НомерВхождения);
		
		Следующий = СтрНайти(Формула, "П", , , НомерВхождения + 1);
		Если Следующий = 0 Тогда
			Следующий = СтрДлина(Формула);
		КонецЕсли;
		
		
		Для й = ПервыйСимвол + 1 По Следующий Цикл
			
			Если СтрНайти(" +-*/().", Сред(Формула, й, 1)) > 0 Тогда
				Параметры.Добавить(Сред(Формула, ПервыйСимвол, й - ПервыйСимвол));
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если й = Следующий + 1 Тогда
			Параметры.Добавить(Сред(Формула, ПервыйСимвол, й - ПервыйСимвол));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Параметры;
	
КонецФункции

Процедура ВычислитьЗначениеПоказателя(ИмяПоказателя, Формула, ЗначенияПоказателей)
	
	Результат = 0;
	
	ПараметрыФормулы = ИзвлечьПараметрыИзФормулы(Формула);
	
	Для Каждого ИмяПараметра Из ПараметрыФормулы Цикл
		
		Значение = 0;
		
		ЗначенияПоказателей.Свойство(ИмяПараметра, Значение);
		
		Формула = СтрЗаменить(Формула, ИмяПараметра, Формат(?(Значение = Неопределено, 0, Значение), "ЧРД=.; ЧН=0; ЧГ="));
		
	КонецЦикла;
	
	Попытка
		Результат = Вычислить(Формула);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("При вычислении показателя %1 произошла ошибка: %2", ИмяПоказателя, ОписаниеОшибки()));
	КонецПопытки;
	
	ЗначенияПоказателей.Вставить(ИмяПоказателя, Результат);
	
КонецПроцедуры

