//П 4. Ст. 284
//
//облигациям российских организаций (за исключением облигаций иностранных организаций, признаваемых налоговыми резидентами Российской Федерации),
//которые на соответствующие даты признания процентного дохода по ним признаются обращающимися на организованном рынке ценных бумаг,
//номинированным в рублях и эмитированным в период с 1 января 2017 года по 31 декабря 2021 года включительно.

Функция ПолучитьСписокОблигаций_Ст284()
	
	СЗ = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		
		"ВЫБРАТЬ
		|	Активы.Ссылка КАК АктивСсылка
		|ИЗ
		|	Справочник.Активы КАК Активы
		|ГДЕ
		|	Активы.Объект.ДатаВыпуска >= ДАТАВРЕМЯ(2017, 1, 1)
		|	И Активы.Объект.ВидАктива В (ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыАктивов.ОблигацииРосХО), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыАктивов.ОблигацииКорп))
		|	И НЕ Активы.Объект.Эмитент.НеРезидент = ИСТИНА
		|	И Активы.Объект.ВалютаНоминальнойСтоимости = ЗНАЧЕНИЕ(Справочник.Валюты.RUB)
		|	И НЕ Активы.Объект.СИпотечнымПокрытием = ИСТИНА
		|	И НЕ Активы.Объект.Еврооблигация = ИСТИНА
		|	И Активы.Объект.ISIN ПОДОБНО ""%RU%""";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("АктивСсылка");
	СЗ.ЗагрузитьЗначения(РезультатЗапроса);
	
	Возврат СЗ;
	
КонецФункции

