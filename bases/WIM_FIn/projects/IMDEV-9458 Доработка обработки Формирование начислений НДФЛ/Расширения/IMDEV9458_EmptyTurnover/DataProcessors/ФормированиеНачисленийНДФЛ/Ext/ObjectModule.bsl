#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область IMDEV9458

&После("ЗаполнитьДатыДокументов")
Процедура IMDEV9458_ЗаполнитьДатыДокументов()

	// IMDEV-9458
	IMDEV9458_ОставитьТолькоПарыСПулом();
	IMDEV9458_ОставитьТолькоПарыСОборотами();

КонецПроцедуры

// IMDEV-9458. После штатного заполнения оставляет в ТЧ ДатыДокументов
// только пары клиент+УК, у которых есть хотя бы один портфель выбранного пула.
// Пустая ссылка пула - клиенты не-РДУ.
//
Процедура IMDEV9458_ОставитьТолькоПарыСПулом()

	Если Не СоздаватьНДФЛТолькоПоПулу Тогда
		Возврат;
	КонецЕсли;

	Если ДатыДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПулОтбора = ПулДляОтбораНДФЛ;
	Если Не ЗначениеЗаполнено(ПулОтбора) Тогда
		ПулОтбора = Справочники.Пул.ПустаяСсылка();
	КонецЕсли;

	Если ВариантЗаполнения = 2 Или ВариантЗаполнения = 4 Тогда
		НачалоПериодаОтбора = НачалоГода(Период.ДатаОкончания);
		КонецПериодаОтбора = Период.ДатаОкончания;
	Иначе
		НачалоПериодаОтбора = Период.ДатаНачала;
		КонецПериодаОтбора = Период.ДатаОкончания;
	КонецЕсли;

	ТаблицаПар = ДатыДокументов.Выгрузить(, "Клиент, УправляющаяКомпания");
	ПарыСПулом = Новый Соответствие;

	// IMDEV-9458. Пара остаётся, если у клиента в этой УК есть портфель
	// с тем же пулом, что в поле отбора, в том числе пустым.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЧ.Клиент КАК Клиент,
	|	ТЧ.УправляющаяКомпания КАК УправляющаяКомпания
	|ПОМЕСТИТЬ ВТ_Пары
	|ИЗ
	|	&ДатыДокументов КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Портфели.Клиент КАК Клиент,
	|	Портфели.УправляющаяКомпания КАК УправляющаяКомпания
	|ИЗ
	|	Справочник.Портфели КАК Портфели
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Пары КАК ВТ_Пары
	|		ПО Портфели.Клиент = ВТ_Пары.Клиент
	|			И Портфели.УправляющаяКомпания = ВТ_Пары.УправляющаяКомпания
	|ГДЕ
	|	Портфели.Пул = &Пул
	|	И Не Портфели.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА &ПоЗакрытымПортфелям
	|				ТОГДА Портфели.ДатаОкончания >= &НачалоПериода
	|						ИЛИ Портфели.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ИНАЧЕ Портфели.ДатаОкончания >= НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ)
	|					ИЛИ Портфели.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|		КОНЕЦ";

	Запрос.УстановитьПараметр("ДатыДокументов", ТаблицаПар);
	Запрос.УстановитьПараметр("Пул", ПулОтбора);
	Запрос.УстановитьПараметр("ПоЗакрытымПортфелям", ФормироватьНачисленияПоЗакрытымПортфелям);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаОтбора);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаОтбора);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючПары = Строка(Выборка.Клиент.УникальныйИдентификатор())
			+ "|"
			+ Строка(Выборка.УправляющаяКомпания.УникальныйИдентификатор());
		ПарыСПулом.Вставить(КлючПары, Истина);
	КонецЦикла;

	Индекс = ДатыДокументов.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаТЧ = ДатыДокументов[Индекс];
		КлючПары = Строка(СтрокаТЧ.Клиент.УникальныйИдентификатор())
			+ "|"
			+ Строка(СтрокаТЧ.УправляющаяКомпания.УникальныйИдентификатор());
		Если ПарыСПулом.Получить(КлючПары) = Неопределено Тогда
			ДатыДокументов.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// IMDEV-9458. После штатного заполнения оставляет в ТЧ ДатыДокументов
// только пары клиент+УК, у которых за период есть обороты по счетам доходов.
//
Процедура IMDEV9458_ОставитьТолькоПарыСОборотами()

	Если Не НеСоздаватьНДФЛПоКлиентамБезОборотов Тогда
		Возврат;
	КонецЕсли;

	Если ДатыДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаСчетов = СокрЛП(СчетаОборотовДляОтбораНДФЛ);
	Если Не ЗначениеЗаполнено(СтрокаСчетов) Тогда
		СтрокаСчетов = "90.01, 91.01, 91.03";
	КонецЕсли;

	СчетаОборотов = ПланыСчетов.Хозрасчетный.СчетаПоСтроке(СтрокаСчетов);

	ПарыСОборотами = Новый Соответствие;

	Если СчетаОборотов.Количество() = 0 Тогда
		Сообщить("IMDEV-9458. Не разобран список счетов отбора НДФЛ. Фильтр не применен.");
		Для Каждого СтрокаТЧ Из ДатыДокументов Цикл
			КлючПары = Строка(СтрокаТЧ.Клиент.УникальныйИдентификатор())
				+ "|"
				+ Строка(СтрокаТЧ.УправляющаяКомпания.УникальныйИдентификатор());
			ПарыСОборотами.Вставить(КлючПары, Истина);
		КонецЦикла;
	Иначе

		Если ВариантЗаполнения = 2 Или ВариантЗаполнения = 4 Тогда
			НачалоПериодаОтбора = НачалоГода(Период.ДатаОкончания);
			КонецПериодаОтбора = Новый Граница(КонецДня(Период.ДатаОкончания), ВидГраницы.Включая);
		ИначеЕсли ВариантЗаполнения = 0 Или ВариантЗаполнения = 1 Тогда
			НачалоПериодаОтбора = Период.ДатаНачала;
			КонецПериодаОтбора = Новый Граница(КонецДня(Период.ДатаОкончания), ВидГраницы.Включая);
		Иначе
			ЕстьДата = Ложь;
			ДатаМин = Дата(1, 1, 1);
			ДатаМакс = Дата(1, 1, 1);
			Для Каждого СтрокаТЧ Из ДатыДокументов Цикл
				Если Не ЕстьДата Тогда
					ДатаМин = СтрокаТЧ.Дата;
					ДатаМакс = СтрокаТЧ.Дата;
					ЕстьДата = Истина;
				Иначе
					Если СтрокаТЧ.Дата < ДатаМин Тогда
						ДатаМин = СтрокаТЧ.Дата;
					КонецЕсли;
					Если СтрокаТЧ.Дата > ДатаМакс Тогда
						ДатаМакс = СтрокаТЧ.Дата;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если Не ЕстьДата Тогда
				ДатаМин = ТекущаяДатаСеанса();
				ДатаМакс = ДатаМин;
			КонецЕсли;
			НачалоПериодаОтбора = ДатаМин;
			КонецПериодаОтбора = Новый Граница(КонецДня(ДатаМакс), ВидГраницы.Включая);
		КонецЕсли;

		ТаблицаПар = ДатыДокументов.Выгрузить(, "Клиент, УправляющаяКомпания");

		// IMDEV-9458. Один запрос на заполнение: пары из ТЧ соединяются с оборотами,
		// чтобы клиент одной УК не смешался с другой.
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЧ.Клиент КАК Клиент,
		|	ТЧ.УправляющаяКомпания КАК УправляющаяКомпания
		|ПОМЕСТИТЬ ВТ_Пары
		|ИЗ
		|	&ДатыДокументов КАК ТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ХозрасчетныйОбороты.Портфель.Клиент КАК Клиент,
		|	ХозрасчетныйОбороты.Портфель.УправляющаяКомпания КАК УправляющаяКомпания
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			Счет В (&СчетаОборотов),
		|			,
		|			Портфель.Клиент В (&Клиенты)
		|				И Портфель.УправляющаяКомпания В (&УправляющиеКомпании),
		|			,
		|			) КАК ХозрасчетныйОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Пары КАК ВТ_Пары
		|		ПО ХозрасчетныйОбороты.Портфель.Клиент = ВТ_Пары.Клиент
		|			И ХозрасчетныйОбороты.Портфель.УправляющаяКомпания = ВТ_Пары.УправляющаяКомпания
		|ГДЕ
		|	Не (ХозрасчетныйОбороты.СуммаОборотДт = 0
		|			И ХозрасчетныйОбороты.СуммаОборотКт = 0)";

		Запрос.УстановитьПараметр("ДатыДокументов", ТаблицаПар);
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаОтбора);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериодаОтбора);
		Запрос.УстановитьПараметр("СчетаОборотов", СчетаОборотов);
		Запрос.УстановитьПараметр("Клиенты", ТаблицаПар.ВыгрузитьКолонку("Клиент"));
		Запрос.УстановитьПараметр("УправляющиеКомпании", ТаблицаПар.ВыгрузитьКолонку("УправляющаяКомпания"));

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			КлючПары = Строка(Выборка.Клиент.УникальныйИдентификатор())
				+ "|"
				+ Строка(Выборка.УправляющаяКомпания.УникальныйИдентификатор());
			ПарыСОборотами.Вставить(КлючПары, Истина);
		КонецЦикла;

	КонецЕсли;

	Индекс = ДатыДокументов.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаТЧ = ДатыДокументов[Индекс];
		КлючПары = Строка(СтрокаТЧ.Клиент.УникальныйИдентификатор())
			+ "|"
			+ Строка(СтрокаТЧ.УправляющаяКомпания.УникальныйИдентификатор());
		Если ПарыСОборотами.Получить(КлючПары) = Неопределено Тогда
			ДатыДокументов.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Описание: Записывает документ с повторными попытками при коллизии автонумерации.
// Первая попытка идет с текущим номером. Если платформа сообщает, что номер не уникален,
// вызывается УстановитьНовыйНомер и запись повторяется. Не более 30 попыток.
// Используется при параллельной записи пачек: несколько фоновых заданий могут взять
// один и тот же следующий номер документа "Начисление НДФЛ по УК".
//
// Параметры:
// ДокументОбъект - ДокументОбъект.НачислениеНДФЛПоУправляющейКомпании - объект для записи
// РежимЗаписи - РежимЗаписиДокумента - проведение или запись без проведения
//
Процедура IMDEV9458_ЗаписатьСОбработкойКоллизииНомера(ДокументОбъект, РежимЗаписи)
	
	МаксПопытокЗаписи = 30;
	
	Для НомерПопытки = 1 По МаксПопытокЗаписи Цикл
		
		Попытка
			Если НомерПопытки > 1 Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			Возврат;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Если НомерПопытки < МаксПопытокЗаписи И IMDEV9458_ЭтоОшибкаНеуникальногоЗначения(ТекстОшибки) Тогда
				Продолжить;
			Иначе
				ВызватьИсключение СтрШаблон(
					"Ошибка записи документа %1 (режим %2, попытка %3 из %4): %5",
					ДокументОбъект,
					РежимЗаписи,
					НомерПопытки,
					МаксПопытокЗаписи,
					ТекстОшибки);
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Описание: Признак ошибки платформы о неуникальном номере/коде.
// Текст зависит от языка интерфейса сеанса: ru "не уникально", en "not unique".
//
// Параметры:
// ТекстОшибки - Строка - ОписаниеОшибки() или подробный текст исключения
//
// Возвращаемое значение:
// Булево - Истина, если это коллизия уникальности номера/кода
//
Функция IMDEV9458_ЭтоОшибкаНеуникальногоЗначения(ТекстОшибки)
	
	Текст = НРег(Строка(ТекстОшибки));
	
	// ru: Значение "000000000044095" поля "Номер" не уникально
	// en: Value "000000000044095" of the "Number" field is not unique
	// en (справка платформы): Number field value not unique!
	// en (changelog 1C): "Number" field value is not unique
	Возврат СтрНайти(Текст, "не уникально") > 0
		Или СтрНайти(Текст, "not unique") > 0;
	
КонецФункции

&ИзменениеИКонтроль("СоздатьНачислениеНДФЛПоУК")
Процедура IMDEV9458_СоздатьНачислениеНДФЛПоУК(СтрокаДокументов, СписокСообщений, СписокНачислений)
	
	НачислениеНДФЛПоУК = НайтиСоздатьДокументПоУК(СтрокаДокументов);
	НачислениеНДФЛПоУК.РассчитатьНДФЛ(СтруктураКэшНКД);
	
	Если НеСоздаватьДокументыБезУдержаний И НачислениеНДФЛПоУК.Удержания.Итог("СуммаКУдержанию") = 0 Тогда
		ТекстСообщения = СтрокаДокументов.СхемаРеинвестирования;
		ДобавитьСообщение(СписокСообщений, ТекстСообщения, СтрокаДокументов.Клиент, Ложь, Истина);
		Возврат;
	КонецЕсли;
	
	Если НачислениеНДФЛПоУК.Начисления.Количество() = 0
		И НачислениеНДФЛПоУК.Удержания.Количество() = 0
		И НачислениеНДФЛПоУК.ИнвестиционныйВычетПоПортфелям.Количество() = 0
		И НачислениеНДФЛПоУК.Выводы.Количество() = 0
		И НачислениеНДФЛПоУК.ОбщиеРасходы.Количество() = 0 Тогда
		ТекстСообщения = "Документ ""Начисление НДФЛ по УК"" не записан: отсутствуют данные для расчета";
		ДобавитьСообщение(СписокСообщений, ТекстСообщения, СтрокаДокументов.Клиент, Ложь, Истина);
		Возврат;
	КонецЕсли;
	
	РеквизитыКлиента = ОбщегоНазначенияДУПовтИсп.ЗначенияРеквизитовОбъекта(СтрокаДокументов.Клиент, "ДатаСмерти, Наименование");
	
	Если ЗначениеЗаполнено(РеквизитыКлиента.ДатаСмерти) Тогда
		Если РеквизитыКлиента.ДатаСмерти <> '0001.01.01' И НачислениеНДФЛПоУК.Дата >= РеквизитыКлиента.ДатаСмерти Тогда
			ТекстСообщения = СтрШаблон("Внимание, по клиенту %1 установлена дата смерти %2. Дата документа ""Начисление НДФЛ по УК"" должна быть меньше этой даты. Документ не создан",
				РеквизитыКлиента.Наименование,
				Формат(РеквизитыКлиента.ДатаСмерти, "ДЛФ=Д"));
			ДобавитьСообщение(СписокСообщений, ТекстСообщения, НачислениеНДФЛПоУК.Ссылка, Истина);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
#Удаление
		НачислениеНДФЛПоУК.Записать(РежимЗаписиДокумента.Проведение);
#КонецУдаления
#Вставка
		// IMDEV-9458. Параллельные пачки могут взять один номер; повтор при "не уникально".
		IMDEV9458_ЗаписатьСОбработкойКоллизииНомера(НачислениеНДФЛПоУК, РежимЗаписиДокумента.Проведение);
#КонецВставки
		ТекстСообщения = "Проведено начисление НДФЛ по клиенту " + СтрокаДокументов.Клиент;
		ДобавитьСообщение(СписокСообщений, ТекстСообщения, НачислениеНДФЛПоУК.Ссылка);
		Если СоздаватьОплатуНДФЛ Тогда
			СписокНачислений.Добавить(НачислениеНДФЛПоУК.Ссылка);
		КонецЕсли;
	Исключение
#Удаление
		НачислениеНДФЛПоУК.Записать();
#КонецУдаления
#Вставка
		// IMDEV-9458. Запасная запись без проведения тоже может столкнуться с тем же номером.
		IMDEV9458_ЗаписатьСОбработкойКоллизииНомера(НачислениеНДФЛПоУК, РежимЗаписиДокумента.Запись);
