	Если Метаданные.Документы.Найти("НачислениеНДФЛПоПортфелю") = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтрокиНачислений.КодДохода.Код КАК КодДохода,
	|	СтрокиНачислений.Ссылка.Портфель КАК Портфель,
	|	СУММА(СтрокиНачислений.СуммаДохода) КАК СуммаДохода,
	|	СУММА(СтрокиНачислений.СуммаВычета) КАК СуммаВычета,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Документ.НачислениеНДФЛПоПортфелю.Начисления КАК СтрокиНачислений
	|ГДЕ
	|	СтрокиНачислений.Ссылка.Портфель.Клиент = &Клиент
	|	И СтрокиНачислений.Ссылка.Портфель.УправляющаяКомпания = &УК
	|	И СтрокиНачислений.Ссылка.Дата = &Дата
	|	И Не СтрокиНачислений.Ссылка.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	СтрокиНачислений.КодДохода.Код,
	|	СтрокиНачислений.Ссылка.Портфель
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодДохода";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("УК", УК);
	Запрос.УстановитьПараметр("Дата", ДатаДокументов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Источник = "Документ.НачислениеНДФЛПоПортфелю";
		СтрокаТаблицы.КодДохода = СокрЛП(Строка(Выборка.КодДохода));
		СтрокаТаблицы.Портфель = СокрЛП(Строка(Выборка.Портфель));
		СтрокаТаблицы.СуммаДохода = Выборка.СуммаДохода;
		СтрокаТаблицы.СуммаВычета = Выборка.СуммаВычета;
		СтрокаТаблицы.Количество = Выборка.Количество;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ОборотыРегистраСведенийОДоходах(Клиент, УК, ДатаДокументов)

	Таблица = ПустаяТаблицаИсточника();
	Если Метаданные.РегистрыНакопления.Найти("НДФЛСведенияОДоходах") = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обороты.КодДохода.Код КАК КодДохода,
	|	Обороты.Портфель КАК Портфель,
	|	Обороты.Система КАК Система,
	|	СУММА(Обороты.СуммаДоходаОборот) КАК СуммаДохода,
	|	СУММА(Обороты.СуммаВычетаОборот) КАК СуммаВычета
	|ИЗ
	|	РегистрНакопления.НДФЛСведенияОДоходах.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			УправляющаяКомпания = &УК
	|				И Клиент = &Клиент) КАК Обороты
	|
	|СГРУППИРОВАТЬ ПО
	|	Обороты.КодДохода.Код,
	|	Обороты.Портфель,
	|	Обороты.Система
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодДохода";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ДатаДокументов));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(ДатаДокументов), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("УК", УК);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.СуммаДохода = 0 И Выборка.СуммаВычета = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Источник = "РегистрНакопления.НДФЛСведенияОДоходах";
		СтрокаТаблицы.КодДохода = СокрЛП(Строка(Выборка.КодДохода));
		СтрокаТаблицы.Портфель = СокрЛП(Строка(Выборка.Портфель));
		СтрокаТаблицы.Система = СокрЛП(Строка(Выборка.Система));
		СтрокаТаблицы.СуммаДохода = Выборка.СуммаДохода;
		СтрокаТаблицы.СуммаВычета = Выборка.СуммаВычета;
		СтрокаТаблицы.Количество = 1;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СведенияВнешнейСистемыПоУК(Клиент, УК, ДатаДокументов)

	Таблица = ПустаяТаблицаИсточника();
	Если Метаданные.РегистрыНакопления.Найти("НДФЛСведенияОДоходахПоУправляющейКомпании") = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоходыУК.КодДохода.Код КАК КодДохода,
	|	СУММА(ДоходыУК.СуммаДохода) КАК СуммаДохода,
	|	СУММА(ДоходыУК.СуммаВычета) КАК СуммаВычета
	|ИЗ
	|	РегистрНакопления.НДФЛСведенияОДоходахПоУправляющейКомпании КАК ДоходыУК
	|ГДЕ
	|	ДоходыУК.СведенияИзВнешнейСистемы = ИСТИНА
	|	И ДоходыУК.Период < &КонецПериода
	|	И ДоходыУК.УправляющаяКомпания = &УК
	|	И ДоходыУК.Клиент = &Клиент
	|	И ДоходыУК.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	ДоходыУК.КодДохода.Код
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодДохода";
	Запрос.УстановитьПараметр("КонецПериода", ДатаДокументов);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("УК", УК);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.СуммаДохода = 0 И Выборка.СуммаВычета = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Источник = "НДФЛСведенияОДоходахПоУправляющейКомпании (внешняя система)";
		СтрокаТаблицы.КодДохода = СокрЛП(Строка(Выборка.КодДохода));
		СтрокаТаблицы.СуммаДохода = Выборка.СуммаДохода;
		СтрокаТаблицы.СуммаВычета = Выборка.СуммаВычета;
		СтрокаТаблицы.Количество = 1;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Процедура ДобавитьСтрокиТаблицыИсточника(СтрокиОтчета, Таблица)

	Если Таблица.Количество() = 0 Тогда
		СтрокиОтчета.Добавить("  (пусто)");
		Возврат;
	КонецЕсли;

	ИтогоДоход = 0;
	ИтогоВычет = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокиОтчета.Добавить(
			"  код=" + СтрокаТаблицы.КодДохода
			+ ?(ЗначениеЗаполнено(СтрокаТаблицы.Портфель), " | " + СтрокаТаблицы.Портфель, "")
			+ ?(ЗначениеЗаполнено(СтрокаТаблицы.Система), " | система=" + СтрокаТаблицы.Система, "")
			+ " | доход=" + Формат(СтрокаТаблицы.СуммаДохода, "ЧДЦ=2; ЧН=0")
			+ " | вычет=" + Формат(СтрокаТаблицы.СуммаВычета, "ЧДЦ=2; ЧН=0"));
		ИтогоДоход = ИтогоДоход + СтрокаТаблицы.СуммаДохода;
		ИтогоВычет = ИтогоВычет + СтрокаТаблицы.СуммаВычета;
	КонецЦикла;
	СтрокиОтчета.Добавить(
		"  ИТОГО доход=" + Формат(ИтогоДоход, "ЧДЦ=2; ЧН=0")
		+ " вычет=" + Формат(ИтогоВычет, "ЧДЦ=2; ЧН=0"));

КонецПроцедуры

Процедура ДобавитьСопоставлениеДокументаУК(СтрокиОтчета, СсылкаДокумента, ТаблицаПортфельных,
	ТаблицаРегистраДоходов, ТаблицаВнешнейСистемы, НачислениеПоПортфелю, КупонВКодах1530)

	ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
	Если ОбъектДокумента = Неопределено Тогда
		СтрокиОтчета.Добавить("  не удалось прочитать " + Строка(СсылкаДокумента));
		Возврат;
	КонецЕсли;

	СтрокиОтчета.Добавить("  Документ: " + Строка(СсылкаДокумента));
	Если НачислениеПоПортфелю = Истина Тогда
		СтрокиОтчета.Добавить(
			"  Режим: НачислениеНДФЛПоПортфелю = Да -> УК собирает регистр НДФЛСведенияОДоходах / документы по портфелю.");
	ИначеЕсли НачислениеПоПортфелю = Ложь Тогда
		СтрокиОтчета.Добавить(
			"  Режим: НачислениеНДФЛПоПортфелю = Нет -> УК считает ветками A-J в РассчитатьНДФЛ.");
	КонецЕсли;

	Если ОбъектДокумента.Начисления.Количество() = 0 Тогда
		СтрокиОтчета.Добавить("  ТЧ Начисления пустая.");
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТЧ Из ОбъектДокумента.Начисления Цикл

		КодДохода = "";
		Если ЗначениеЗаполнено(СтрокаТЧ.КодДохода) Тогда
			КодДохода = СокрЛП(Строка(СтрокаТЧ.КодДохода.Код));
			Если Не ЗначениеЗаполнено(КодДохода) Тогда
				КодДохода = СокрЛП(Строка(СтрокаТЧ.КодДохода));
			КонецЕсли;
		КонецЕсли;

		ВеткаПоКоду = ОписаниеВеткиПоКодуДохода(КодДохода, КупонВКодах1530);
		Совпадение = ПодобратьСовпадениеИсточника(
			КодДохода,
			СтрокаТЧ.СуммаДохода,
			ТаблицаПортфельных,
			ТаблицаРегистраДоходов,
			ТаблицаВнешнейСистемы);

		СтрокиОтчета.Добавить(
			"    код=" + КодДохода
			+ " доход=" + Формат(СтрокаТЧ.СуммаДохода, "ЧДЦ=2; ЧН=0")
			+ " вычет=" + Формат(СтрокаТЧ.СуммаВычета, "ЧДЦ=2; ЧН=0")
			+ " НО=" + Формат(СтрокаТЧ.НалогооблагаемаяCумма, "ЧДЦ=2; ЧН=0"));
		СтрокиОтчета.Добавить("      ветка по коду: " + ВеткаПоКоду);
		СтрокиОтчета.Добавить("      совпадение данных: " + Совпадение);

	КонецЦикла;

КонецПроцедуры

Функция ОписаниеВеткиПоКодуДохода(КодДохода, КупонВКодах1530)

	Код = СокрЛП(КодДохода);
	Если Не ЗначениеЗаполнено(Код) Тогда
		Возврат "код дохода пустой";
	КонецЕсли;

	Если Код = "1530" Или Код = "1544" Тогда
		Если КупонВКодах1530 = Истина Тогда
			Возврат "B. Обращающиеся ЦБ и/или F. погашенные купоны (1530/1544)";
		КонецЕсли;
		Возврат "B. Обращающиеся ЦБ (1530/1544)";
	ИначеЕсли Код = "1531" Или Код = "1545" Тогда
		Если КупонВКодах1530 = Истина Тогда
			Возврат "C. Необращающиеся ЦБ и/или F. погашенные купоны (1531/1545)";
		КонецЕсли;
		Возврат "C. Необращающиеся ЦБ (1531/1545)";
	ИначеЕсли Код = "1533" Или Код = "1532" Или Код = "1546"
		Или Код = "1535" Или Код = "1548" Тогда
		Возврат "D. Срочные контракты";
	ИначеЕсли Код = "3020" Тогда
		Возврат "E. Депозиты";
	ИначеЕсли Код = "1011" Тогда
		Возврат "F. Погашенные купоны";
	ИначеЕсли Код = "1537" Или Код = "1551" Тогда
		Возврат "G. РЕПО";
	ИначеЕсли Код = "2900" Тогда
		Возврат "H. Операции с валютой";
	ИначеЕсли Код = "1010" Тогда
		Возврат "I. Дивиденды";
	ИначеЕсли Код = "4800" Тогда
		Возврат "J. Прочие доходы";
	ИначеЕсли Код = "2792" Или Код = "2793" Тогда
		Возврат "льгота высокотехнологичного сектора (из расчета ЦБ, не отдельный источник оборотов)";
	КонецЕсли;

	Возврат "код не из фиксированных веток A-J (возможны дивиденды по кодам дохода, внешняя/сторонняя система, ИИС-подмена)";

КонецФункции

Функция ПодобратьСовпадениеИсточника(КодДохода, СуммаДохода, ТаблицаПортфельных,
	ТаблицаРегистраДоходов, ТаблицаВнешнейСистемы)

	ТочноеПортфель = Ложь;
	КодПортфель = Ложь;
	ТочноеРегистр = Ложь;
	КодРегистр = Ложь;
	ТочноеВнешняя = Ложь;
	КодВнешняя = Ложь;

	Для Каждого СтрокаТаблицы Из ТаблицаПортфельных Цикл
		Если СтрокаТаблицы.КодДохода <> КодДохода Тогда
			Продолжить;
		КонецЕсли;
		КодПортфель = Истина;
		Если СтрокаТаблицы.СуммаДохода = СуммаДохода Тогда
			ТочноеПортфель = Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из ТаблицаРегистраДоходов Цикл
		Если СтрокаТаблицы.КодДохода <> КодДохода Тогда
			Продолжить;
		КонецЕсли;
		КодРегистр = Истина;
		Если СтрокаТаблицы.СуммаДохода = СуммаДохода Тогда
			ТочноеРегистр = Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из ТаблицаВнешнейСистемы Цикл
		Если СтрокаТаблицы.КодДохода <> КодДохода Тогда
			Продолжить;
		КонецЕсли;
		КодВнешняя = Истина;
		Если СтрокаТаблицы.СуммаДохода = СуммаДохода Тогда
			ТочноеВнешняя = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ТочноеПортфель Тогда
		Возврат "сумма и код совпали с документом по портфелю";
	ИначеЕсли ТочноеРегистр Тогда
		Возврат "сумма и код совпали с регистром НДФЛСведенияОДоходах";
	ИначеЕсли ТочноеВнешняя Тогда
		Возврат "сумма и код совпали со сведениями внешней системы по УК";
	ИначеЕсли КодПортфель Тогда
		Возврат "код есть в документе по портфелю, сумма не совпала (агрегация нескольких портфелей / сальдирование)";
	ИначеЕсли КодРегистр Тогда
		Возврат "код есть в регистре НДФЛСведенияОДоходах, сумма не совпала";
	ИначеЕсли КодВнешняя Тогда
		Возврат "код есть во внешней системе по УК, сумма не совпала";
	КонецЕсли;

	Возврат "в выгрузках источников на эту дату не найдено (считалось веткой РассчитатьНДФЛ по Хозрасчетному либо строка после распределения)";

КонецФункции

#КонецОбласти

