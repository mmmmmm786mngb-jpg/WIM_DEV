Функция ОборотыПоСчетам(Клиент, УК, НачалоПериода, КонецПериода, Счета)

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Портфель");
	Результат.Колонки.Добавить("СуммаОборотДт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2)));
	Результат.Колонки.Добавить("СуммаОборотКт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2)));

	Если Счета.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХозрасчетныйОбороты.Счет КАК Счет,
	|	ХозрасчетныйОбороты.Портфель КАК Портфель,
	|	СУММА(ХозрасчетныйОбороты.СуммаОборотДт) КАК СуммаОборотДт,
	|	СУММА(ХозрасчетныйОбороты.СуммаОборотКт) КАК СуммаОборотКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет В (&Счета),
	|			,
	|			Портфель.Клиент = &Клиент
	|				И Портфель.УправляющаяКомпания = &УК,
	|			,
	|			) КАК ХозрасчетныйОбороты
	|ГДЕ
	|	Не (ХозрасчетныйОбороты.СуммаОборотДт = 0
	|			И ХозрасчетныйОбороты.СуммаОборотКт = 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОбороты.Счет,
	|	ХозрасчетныйОбороты.Портфель
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счет,
	|	Портфель";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("УК", УК);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.КодСчета = Строка(Выборка.Счет.Код);
		Если Не ЗначениеЗаполнено(СтрокаРезультата.КодСчета) Тогда
			СтрокаРезультата.КодСчета = Строка(Выборка.Счет);
		КонецЕсли;
		СтрокаРезультата.Портфель = Выборка.Портфель;
		СтрокаРезультата.СуммаОборотДт = Выборка.СуммаОборотДт;
		СтрокаРезультата.СуммаОборотКт = Выборка.СуммаОборотКт;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьСтрокиОборотов(СтрокиОтчета, ТаблицаОборотов)

	Если ТаблицаОборотов.Количество() = 0 Тогда
		СтрокиОтчета.Добавить("  (пусто)");
		Возврат;
	КонецЕсли;

	ИтогоДт = 0;
	ИтогоКт = 0;
	Для Каждого СтрокаОборота Из ТаблицаОборотов Цикл
		СтрокиОтчета.Добавить(
			"  " + СтрокаОборота.КодСчета
			+ " | " + Строка(СтрокаОборота.Портфель)
			+ " | Дт=" + Формат(СтрокаОборота.СуммаОборотДт, "ЧДЦ=2; ЧН=0")
			+ " | Кт=" + Формат(СтрокаОборота.СуммаОборотКт, "ЧДЦ=2; ЧН=0"));
		ИтогоДт = ИтогоДт + СтрокаОборота.СуммаОборотДт;
		ИтогоКт = ИтогоКт + СтрокаОборота.СуммаОборотКт;
	КонецЦикла;
	СтрокиОтчета.Добавить(
		"  ИТОГО Дт=" + Формат(ИтогоДт, "ЧДЦ=2; ЧН=0")
		+ " Кт=" + Формат(ИтогоКт, "ЧДЦ=2; ЧН=0"));

КонецПроцедуры

