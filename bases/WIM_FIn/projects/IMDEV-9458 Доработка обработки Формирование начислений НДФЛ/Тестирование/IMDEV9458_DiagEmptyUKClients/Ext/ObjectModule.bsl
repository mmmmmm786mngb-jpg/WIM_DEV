Процедура ДобавитьРасшифровкуДокументаУК(СтрокиОтчета, СсылкаДокумента)

	ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
	Если ОбъектДокумента = Неопределено Тогда
		СтрокиОтчета.Добавить("    не удалось прочитать объект");
		Возврат;
	КонецЕсли;

	СуммаНачислений = 0;
	СуммаУдержаний = 0;
	СтрокиОтчета.Добавить("    ТЧ Начисления:");
	Если ОбъектДокумента.Начисления.Количество() = 0 Тогда
		СтрокиОтчета.Добавить("      (пусто)");
	Иначе
		Для Каждого СтрокаТЧ Из ОбъектДокумента.Начисления Цикл
			СуммаНачислений = СуммаНачислений + СтрокаТЧ.СуммаДохода;
			СтрокиОтчета.Добавить(
				"      код=" + Строка(СтрокаТЧ.КодДохода)
				+ " доход=" + Формат(СтрокаТЧ.СуммаДохода, "ЧДЦ=2; ЧН=0")
				+ " вычет=" + Формат(СтрокаТЧ.СуммаВычета, "ЧДЦ=2; ЧН=0")
				+ " НО=" + Формат(СтрокаТЧ.НалогооблагаемаяCумма, "ЧДЦ=2; ЧН=0"));
		КонецЦикла;
	КонецЕсли;

	СтрокиОтчета.Добавить("    ТЧ Удержания:");
	Если ОбъектДокумента.Удержания.Количество() = 0 Тогда
		СтрокиОтчета.Добавить("      (пусто)");
	Иначе
		Для Каждого СтрокаТЧ Из ОбъектДокумента.Удержания Цикл
			СуммаУдержаний = СуммаУдержаний + СтрокаТЧ.СуммаКУдержанию;
			СтрокиОтчета.Добавить(
				"      портфель/объект=" + Строка(СтрокаТЧ.Портфель)
				+ " доход=" + Формат(СтрокаТЧ.СуммаДохода, "ЧДЦ=2; ЧН=0")
				+ " к удержанию=" + Формат(СтрокаТЧ.СуммаКУдержанию, "ЧДЦ=2; ЧН=0"));
		КонецЦикла;
	КонецЕсли;

	СтрокиОтчета.Добавить(
		"    ИТОГО Начисления.СуммаДохода=" + Формат(СуммаНачислений, "ЧДЦ=2; ЧН=0")
		+ " | Удержания.СуммаКУдержанию=" + Формат(СуммаУдержаний, "ЧДЦ=2; ЧН=0"));

КонецПроцедуры

Процедура ДобавитьРасшифровкуДокументаПортфеля(СтрокиОтчета, СсылкаДокумента)

	ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
	Если ОбъектДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СуммаДохода = 0;
	СуммаКУдержанию = 0;
	СуммаИсчисленного = 0;

	МетаТЧ = ОбъектДокумента.Метаданные().ТабличныеЧасти.Найти("Начисления");
	Если МетаТЧ <> Неопределено Тогда
		ЕстьКУдержанию = МетаТЧ.Реквизиты.Найти("СуммаКУдержанию") <> Неопределено;
		ЕстьИсчисленный = МетаТЧ.Реквизиты.Найти("СуммаИсчисленногоНалога") <> Неопределено;
		Для Каждого СтрокаТЧ Из ОбъектДокумента.Начисления Цикл
			СуммаДохода = СуммаДохода + СтрокаТЧ.СуммаДохода;
			Если ЕстьКУдержанию Тогда
				СуммаКУдержанию = СуммаКУдержанию + СтрокаТЧ.СуммаКУдержанию;
			КонецЕсли;
			Если ЕстьИсчисленный Тогда
				СуммаИсчисленного = СуммаИсчисленного + СтрокаТЧ.СуммаИсчисленногоНалога;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	СтрокиОтчета.Добавить(
		"    PF Начисления: доход=" + Формат(СуммаДохода, "ЧДЦ=2; ЧН=0")
		+ " к удержанию=" + Формат(СуммаКУдержанию, "ЧДЦ=2; ЧН=0")
		+ " исчисленный=" + Формат(СуммаИсчисленного, "ЧДЦ=2; ЧН=0"));

КонецПроцедуры

#КонецОбласти

#КонецЕсли
