#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Описание: Сведения для подключения через БСП «Дополнительные отчеты и обработки».
//
// Возвращаемое значение:
// Структура - параметры регистрации дополнительной обработки
//
Функция СведенияОВнешнейОбработке() Экспорт

	МетаданныеОбработки = Метаданные();

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.1";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация =
		"IMDEV-9458. Диагностика двух клиентов УК: обороты по счетам отбора и разбор источников строк документа УК.";

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = МетаданныеОбработки.Представление();
	НоваяКоманда.Идентификатор = МетаданныеОбработки.Имя;
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Диагностирует обороты и документы УК/портфеля по списку ФИО клиентов.
// Сравнивает счета отбора расширения с широким списком счетов ОбщиеОбороты.
//
// Параметры:
// ПараметрыДиагностики - Структура - ДатаОкончания, СчетаОтбора, СчетаОбщиеОбороты, ИменаКлиентов (массив строк)
//
// Возвращаемое значение:
// Строка - текстовый отчет
//
Функция ВыполнитьДиагностику(ПараметрыДиагностики) Экспорт

	СтрокиОтчета = Новый Массив;
	СтрокиОтчета.Добавить("IMDEV-9458. Диагностика клиентов УК (Аванкор 9 vs 8)");
	СтрокиОтчета.Добавить("Дата окончания периода: " + Формат(ПараметрыДиагностики.ДатаОкончания, "ДЛФ=D"));
	СтрокиОтчета.Добавить("Начало периода (как вариант 2): " + Формат(НачалоГода(ПараметрыДиагностики.ДатаОкончания), "ДЛФ=D"));
	СтрокиОтчета.Добавить("");

	СтрокаОтбора = СокрЛП(ПараметрыДиагностики.СчетаОтбора);
	Если Не ЗначениеЗаполнено(СтрокаОтбора) Тогда
		СтрокаОтбора = "90.01, 91.01, 91.03";
	КонецЕсли;

	СтрокаШирокие = СокрЛП(ПараметрыДиагностики.СчетаОбщиеОбороты);
	Если Не ЗначениеЗаполнено(СтрокаШирокие) Тогда
		СтрокаШирокие = СтрокаСчетовОбщиеОборотыПоУмолчанию();
	КонецЕсли;

	СчетаОтбора = ПланыСчетов.Хозрасчетный.СчетаПоСтроке(СтрокаОтбора);
	СчетаШирокие = ПланыСчетов.Хозрасчетный.СчетаПоСтроке(СтрокаШирокие);

	СтрокиОтчета.Добавить("Счета отбора расширения: " + СтрокаОтбора
		+ " (разобрано: " + Формат(СчетаОтбора.Количество(), "ЧГ=") + ")");
	СтрокиОтчета.Добавить("Счета ОбщиеОбороты: " + СтрокаШирокие
		+ " (разобрано: " + Формат(СчетаШирокие.Количество(), "ЧГ=") + ")");
	СтрокиОтчета.Добавить("");

	Если СчетаОтбора.Количество() = 0 Тогда
		Возврат "Не разобран список счетов отбора.";
	КонецЕсли;

	НачалоПериода = НачалоГода(ПараметрыДиагностики.ДатаОкончания);
	КонецПериода = Новый Граница(КонецДня(ПараметрыДиагностики.ДатаОкончания), ВидГраницы.Включая);
	ДатаДокументов = КонецДня(ПараметрыДиагностики.ДатаОкончания);

	Для Каждого ИмяКлиента Из ПараметрыДиагностики.ИменаКлиентов Цикл

		ИмяКлиента = СокрЛП(ИмяКлиента);
		Если Не ЗначениеЗаполнено(ИмяКлиента) Тогда
			Продолжить;
		КонецЕсли;

		СтрокиОтчета.Добавить("============================================================");
		СтрокиОтчета.Добавить("Клиент: " + ИмяКлиента);
		СтрокиОтчета.Добавить("============================================================");

		Клиент = НайтиКлиентаПоНаименованию(ИмяКлиента);
		Если Не ЗначениеЗаполнено(Клиент) Тогда
			СтрокиОтчета.Добавить("НЕ НАЙДЕН в справочнике Контрагенты.");
			СтрокиОтчета.Добавить("");
			Продолжить;
		КонецЕсли;

		СтрокиОтчета.Добавить("Ссылка: " + Строка(Клиент));
		ПортфелиКлиента = ПортфелиКлиента(Клиент);
		СтрокиОтчета.Добавить("Портфелей (не помеченных на удаление): " + Формат(ПортфелиКлиента.Количество(), "ЧГ="));

		УКПоПортфелям = Новый Соответствие;
		Для Каждого СтрокаПортфеля Из ПортфелиКлиента Цикл
			СтрокиОтчета.Добавить(
				"  - " + Строка(СтрокаПортфеля.Портфель)
				+ " | УК=" + Строка(СтрокаПортфеля.УправляющаяКомпания)
				+ " | Пул=" + Строка(СтрокаПортфеля.Пул)
				+ " | Окончание=" + Формат(СтрокаПортфеля.ДатаОкончания, "ДЛФ=D; ДП=-"));
			Если ЗначениеЗаполнено(СтрокаПортфеля.УправляющаяКомпания) Тогда
				УКПоПортфелям.Вставить(СтрокаПортфеля.УправляющаяКомпания, Истина);
			КонецЕсли;
		КонецЦикла;

		Если УКПоПортфелям.Количество() = 0 Тогда
			СтрокиОтчета.Добавить("Нет УК по портфелям — дальше нечего анализировать.");
			СтрокиОтчета.Добавить("");
			Продолжить;
		КонецЕсли;

		Для Каждого КлючИЗначение Из УКПоПортфелям Цикл

			УК = КлючИЗначение.Ключ;
			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("--- Пара клиент + УК: " + Строка(УК) + " ---");

			ОборотыОтбора = ОборотыПоСчетам(Клиент, УК, НачалоПериода, КонецПериода, СчетаОтбора);
			ОборотыШирокие = ОборотыПоСчетам(Клиент, УК, НачалоПериода, КонецПериода, СчетаШирокие);

			СтрокиОтчета.Добавить("Обороты по счетам ОТБОРА расширения:");
			ДобавитьСтрокиОборотов(СтрокиОтчета, ОборотыОтбора);
			ЕстьОтбор = ОборотыОтбора.Количество() > 0;
			СтрокиОтчета.Добавить(
				"Вердикт отбора IMDEV-9458: "
				+ ?(ЕстьОтбор,
					"ЕСТЬ обороты — при включенном флаге пара ОСТАНЕТСЯ в заполнении",
					"НЕТ оборотов — при включенном флаге пара БУДЕТ ОТСЕЧЕНА из заполнения"));

			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("Обороты по счетам ОбщиеОбороты (шире, включая расходные и др.):");
			ДобавитьСтрокиОборотов(СтрокиОтчета, ОборотыШирокие);

			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("Документы УК на дату " + Формат(ДатаДокументов, "ДЛФ=DT") + ":");
			ДокументыУК = ДокументыУККлиента(Клиент, УК, ДатаДокументов);
			Если ДокументыУК.Количество() = 0 Тогда
				СтрокиОтчета.Добавить("  (не найдено)");
			Иначе
				Для Каждого ДокУК Из ДокументыУК Цикл
					СтрокиОтчета.Добавить(
						"  " + Строка(ДокУК.Ссылка)
						+ " | Проведен=" + ?(ДокУК.Проведен, "Да", "Нет")
						+ " | ПометкаУдаления=" + ?(ДокУК.ПометкаУдаления, "Да", "Нет"));
					ДобавитьРасшифровкуДокументаУК(СтрокиОтчета, ДокУК.Ссылка);
				КонецЦикла;
			КонецЕсли;

			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("Документы по портфелю клиента/УК на ту же дату:");
			ДокументыПФ = ДокументыПортфеляКлиента(Клиент, УК, ДатаДокументов);
			Если ДокументыПФ.Количество() = 0 Тогда
				СтрокиОтчета.Добавить("  (не найдено)");
			Иначе
				Для Каждого ДокПФ Из ДокументыПФ Цикл
					СтрокиОтчета.Добавить(
						"  " + Строка(ДокПФ.Ссылка)
						+ " | Портфель=" + Строка(ДокПФ.Портфель)
						+ " | Проведен=" + ?(ДокПФ.Проведен, "Да", "Нет"));
					ДобавитьРасшифровкуДокументаПортфеля(СтрокиОтчета, ДокПФ.Ссылка);
				КонецЦикла;
			КонецЕсли;

			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("Вывод по паре:");
			Если Не ЕстьОтбор И ДокументыУК.Количество() > 0 Тогда
				СтрокиОтчета.Добавить(
					"  Документ УК есть, но по счетам отбора расширения оборотов нет.");
				СтрокиОтчета.Добавить(
					"  Значит данные УК пришли НЕ из фильтра 90.01/91.01/91.03, а из расчета НачислениеНДФЛПоПортфелю/ОбщиеОбороты");
				СтрокиОтчета.Добавить(
					"  (более широкий набор счетов и/или регистры корректировок, оплат облигаций и т.п.).");
				Если ОборотыШирокие.Количество() > 0 Тогда
					СтрокиОтчета.Добавить(
						"  На широких счетах ОбщиеОбороты обороты ЕСТЬ — смотрите таблицу выше (какие именно счета).");
				Иначе
					СтрокиОтчета.Добавить(
						"  На широких счетах ОбщиеОбороты оборотов тоже НЕТ — источник, вероятно, вне Хозрасчетного");
					СтрокиОтчета.Добавить(
						"  (ТЧ портфельного документа, регистры НДФЛ/корректировок, ручные/прошлые данные).");
				КонецЕсли;
			ИначеЕсли ЕстьОтбор Тогда
				СтрокиОтчета.Добавить("  По счетам отбора обороты есть — отсев по доходам эту пару не убрал бы.");
			Иначе
				СтрокиОтчета.Добавить("  Документов УК на дату не найдено; по счетам отбора оборотов нет.");
			КонецЕсли;

		КонецЦикла;

		СтрокиОтчета.Добавить("");

	КонецЦикла;

	Возврат СтрСоединить(СтрокиОтчета, Символы.ПС);

КонецФункции

// Описание: Разбирает источники строк ТЧ Начисления документа УК по списку ФИО.
// Сопоставляет код дохода и суммы с ветками РассчитатьНДФЛ, регистрами НДФЛ и документами по портфелю.
//
// Параметры:
// ПараметрыДиагностики - Структура - ДатаОкончания, ИменаКлиентов (массив строк)
//
// Возвращаемое значение:
// Строка - текстовый отчет по источникам
//
Функция ВыполнитьДиагностикуИсточников(ПараметрыДиагностики) Экспорт

	СтрокиОтчета = Новый Массив;
	СтрокиОтчета.Добавить("IMDEV-9458. Источники начисления документа УК");
	СтрокиОтчета.Добавить("Дата документов: " + Формат(КонецДня(ПараметрыДиагностики.ДатаОкончания), "ДЛФ=DT"));
	СтрокиОтчета.Добавить("");

	ДобавитьЛегендуИсточников(СтрокиОтчета);
	ДобавитьКонстантыРасчета(СтрокиОтчета);

	ДатаДокументов = КонецДня(ПараметрыДиагностики.ДатаОкончания);
	КупонВКодах1530 = ЗначениеКонстантыЕслиЕсть("ПогашенныйКупонныйДоходУчитыватьВКодахДохода1530и1531");
	НачислениеПоПортфелю = ЗначениеКонстантыЕслиЕсть("НачислениеНДФЛПоПортфелю");

	Для Каждого ИмяКлиента Из ПараметрыДиагностики.ИменаКлиентов Цикл

		ИмяКлиента = СокрЛП(ИмяКлиента);
		Если Не ЗначениеЗаполнено(ИмяКлиента) Тогда
			Продолжить;
		КонецЕсли;

		СтрокиОтчета.Добавить("============================================================");
		СтрокиОтчета.Добавить("Клиент: " + ИмяКлиента);
		СтрокиОтчета.Добавить("============================================================");

		Клиент = НайтиКлиентаПоНаименованию(ИмяКлиента);
		Если Не ЗначениеЗаполнено(Клиент) Тогда
			СтрокиОтчета.Добавить("НЕ НАЙДЕН в справочнике Контрагенты.");
			СтрокиОтчета.Добавить("");
			Продолжить;
		КонецЕсли;

		СтрокиОтчета.Добавить("Ссылка: " + Строка(Клиент));
		ПортфелиКлиента = ПортфелиКлиента(Клиент);

		УКПоПортфелям = Новый Соответствие;
		Для Каждого СтрокаПортфеля Из ПортфелиКлиента Цикл
			Если ЗначениеЗаполнено(СтрокаПортфеля.УправляющаяКомпания) Тогда
				УКПоПортфелям.Вставить(СтрокаПортфеля.УправляющаяКомпания, Истина);
			КонецЕсли;
		КонецЦикла;

		Если УКПоПортфелям.Количество() = 0 Тогда
			СтрокиОтчета.Добавить("Нет УК по портфелям.");
			СтрокиОтчета.Добавить("");
			Продолжить;
		КонецЕсли;

		Для Каждого КлючИЗначение Из УКПоПортфелям Цикл

			УК = КлючИЗначение.Ключ;
			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("--- Пара клиент + УК: " + Строка(УК) + " ---");

			ТаблицаПортфельных = НачисленияИзДокументовПортфеля(Клиент, УК, ДатаДокументов);
			ТаблицаРегистраДоходов = ОборотыРегистраСведенийОДоходах(Клиент, УК, ДатаДокументов);
			ТаблицаВнешнейСистемы = СведенияВнешнейСистемыПоУК(Клиент, УК, ДатаДокументов);

			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("1) Документы НачислениеНДФЛПоПортфелю (ТЧ Начисления):");
			ДобавитьСтрокиТаблицыИсточника(СтрокиОтчета, ТаблицаПортфельных);

			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("2) Регистр НДФЛСведенияОДоходах (обороты с начала года):");
			ДобавитьСтрокиТаблицыИсточника(СтрокиОтчета, ТаблицаРегистраДоходов);

			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("3) Регистр НДФЛСведенияОДоходахПоУправляющейКомпании, флаг СведенияИзВнешнейСистемы:");
			ДобавитьСтрокиТаблицыИсточника(СтрокиОтчета, ТаблицаВнешнейСистемы);

			ДокументыУК = ДокументыУККлиента(Клиент, УК, ДатаДокументов);
			СтрокиОтчета.Добавить("");
			СтрокиОтчета.Добавить("4) Сопоставление строк документа УК:");
			Если ДокументыУК.Количество() = 0 Тогда
				СтрокиОтчета.Добавить("  Документов УК на дату нет — сопоставлять нечего.");
			Иначе
				Для Каждого ДокУК Из ДокументыУК Цикл
					ДобавитьСопоставлениеДокументаУК(
						СтрокиОтчета,
						ДокУК.Ссылка,
						ТаблицаПортфельных,
						ТаблицаРегистраДоходов,
						ТаблицаВнешнейСистемы,
						НачислениеПоПортфелю,
						КупонВКодах1530);
				КонецЦикла;
			КонецЕсли;

		КонецЦикла;

		СтрокиОтчета.Добавить("");

	КонецЦикла;

	Возврат СтрСоединить(СтрокиОтчета, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаСчетовОбщиеОборотыПоУмолчанию()

	// Как в НачислениеНДФЛПоПортфелю.ОбщиеОбороты (параметр СчетаУчета).
	Возврат "68.01, 90.01, 90.02, 91.01.02, 91.01.09, 91.02.02, 91.02.03, 91.02.04, 91.02.05, 91.02.06, 91.02.10, 91.02.11, 91.03, 91.04, 91.02.08";

КонецФункции

Функция НайтиКлиентаПоНаименованию(ИмяКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И Не Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование", ИмяКлиента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 5
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование ПОДОБНО &Маска
	|	И Не Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Маска", "%" + ИмяКлиента + "%");
	ТаблицаПодобных = Запрос.Выполнить().Выгрузить();
	Если ТаблицаПодобных.Количество() = 1 Тогда
		Возврат ТаблицаПодобных[0].Ссылка;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

