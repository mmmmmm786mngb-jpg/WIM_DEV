#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаОкончания = Дата(2026, 12, 31);
	СчетаОтбора = "90.01, 91.01, 91.03";
	СчетаОбщиеОбороты = "68.01, 90.01, 90.02, 91.01.02, 91.01.09, 91.02.02, 91.02.03, 91.02.04, 91.02.05, 91.02.06, 91.02.10, 91.02.11, 91.03, 91.04, 91.02.08";
	ИмяКлиента1 = "Львов Павел Глебович";
	ИмяКлиента2 = "Баландин Дмитрий Викторович";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьДиагностику(Команда)

	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату окончания периода'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИмяКлиента1) И Не ЗначениеЗаполнено(ИмяКлиента2) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите хотя бы одно ФИО клиента'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Диагностика оборотов и документов УК...'"));
	ВыполнитьДиагностикуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьДиагностикуНаСервере()

	ИменаКлиентов = Новый Массив;
	Если ЗначениеЗаполнено(ИмяКлиента1) Тогда
		ИменаКлиентов.Добавить(ИмяКлиента1);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяКлиента2) Тогда
		ИменаКлиентов.Добавить(ИмяКлиента2);
	КонецЕсли;

	ПараметрыДиагностики = Новый Структура;
	ПараметрыДиагностики.Вставить("ДатаОкончания", ДатаОкончания);
	ПараметрыДиагностики.Вставить("СчетаОтбора", СчетаОтбора);
	ПараметрыДиагностики.Вставить("СчетаОбщиеОбороты", СчетаОбщиеОбороты);
	ПараметрыДиагностики.Вставить("ИменаКлиентов", ИменаКлиентов);

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТекстОтчета = ОбработкаОбъект.ВыполнитьДиагностику(ПараметрыДиагностики);

КонецПроцедуры

#КонецОбласти
