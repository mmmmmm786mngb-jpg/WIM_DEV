#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаДокументов = Дата(2026, 12, 31);
	Пул = НайтиПулРДУ();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проверить(Команда)

	Если Не ЗначениеЗаполнено(ДатаДокументов) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату документов'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Пул) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите пул (для РДУ — Розничное ДУ)'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Проверка проведенных документов НДФЛ по пулу...'"));
	ПроверитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция НайтиПулРДУ()

	НайденныйПул = Справочники.Пул.НайтиПоНаименованию("Розничное ДУ", Истина);
	Если ЗначениеЗаполнено(НайденныйПул) Тогда
		Возврат НайденныйПул;
	КонецЕсли;

	НайденныйПул = Справочники.Пул.НайтиПоНаименованию("Розница ДУ", Истина);
	Если ЗначениеЗаполнено(НайденныйПул) Тогда
		Возврат НайденныйПул;
	КонецЕсли;

	Возврат Справочники.Пул.НайтиПоНаименованию("Розничное ДУ");

КонецФункции

&НаСервере
Процедура ПроверитьНаСервере()

	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ДатаДокументов", ДатаДокументов);
	ПараметрыПроверки.Вставить("Пул", Пул);
	ПараметрыПроверки.Вставить("УправляющаяКомпания", УправляющаяКомпания);
	ПараметрыПроверки.Вставить("ПоЗакрытымПортфелям", ПоЗакрытымПортфелям);

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Данные = ОбработкаОбъект.ВыполнитьПроверку(ПараметрыПроверки);

	Результат = Данные.Результат;

	Нарушения.Очистить();
	Для Каждого СтрокаТЗ Из Данные.Нарушения Цикл
		НоваяСтрока = Нарушения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
