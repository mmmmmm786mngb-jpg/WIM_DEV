#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Описание: Сведения для подключения через БСП «Дополнительные отчеты и обработки».
//
// Возвращаемое значение:
// Структура - параметры регистрации дополнительной обработки
//
Функция СведенияОВнешнейОбработке() Экспорт

	МетаданныеОбработки = Метаданные();

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация =
		"IMDEV-9458. Проверка: проведенные начисления НДФЛ за дату только по выбранному пулу (Розничное ДУ).";

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = МетаданныеОбработки.Представление();
	НоваяКоманда.Идентификатор = МетаданныеОбработки.Имя;
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Описание: Проверяет проведенные документы НДФЛ за дату: пары клиент+УК и портфели
// должны относиться к выбранному пулу. Пустой пул в поле формы не допускается.
//
// Параметры:
// ПараметрыПроверки - Структура - ДатаДокументов, Пул, УправляющаяКомпания, ПоЗакрытымПортфелям
//
// Возвращаемое значение:
// Структура - Результат (строка), Нарушения (таблица значений)
//
Функция ВыполнитьПроверку(ПараметрыПроверки) Экспорт

	Нарушения = НоваяТаблицаНарушений();
	СтрокиИтога = Новый Массив;

	ДатаДокументов = ПараметрыПроверки.ДатаДокументов;
	Пул = ПараметрыПроверки.Пул;
	УправляющаяКомпания = ПараметрыПроверки.УправляющаяКомпания;
	ПоЗакрытымПортфелям = ПараметрыПроверки.ПоЗакрытымПортфелям;

	Если Не ЗначениеЗаполнено(ДатаДокументов) Тогда
		Возврат РезультатПроверки("Укажите дату документов.", Нарушения);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Пул) Тогда
		Возврат РезультатПроверки("Укажите пул (для РДУ - «Розничное ДУ»).", Нарушения);
	КонецЕсли;

	НачалоДняДокументов = НачалоДня(ДатаДокументов);
	КонецДняДокументов = КонецДня(ДатаДокументов);
	НачалоПериодаПортфелей = НачалоГода(ДатаДокументов);

	СтрокиИтога.Добавить("IMDEV-9458. Проверка проведенных начислений НДФЛ по пулу");
	СтрокиИтога.Добавить("Дата документов: " + Формат(ДатаДокументов, "ДЛФ=DT"));
	СтрокиИтога.Добавить("Пул: " + Строка(Пул));
	Если ЗначениеЗаполнено(УправляющаяКомпания) Тогда
		СтрокиИтога.Добавить("УК: " + Строка(УправляющаяКомпания));
	Иначе
		СтрокиИтога.Добавить("УК: все");
	КонецЕсли;
	СтрокиИтога.Добавить("Закрытые портфели: "
		+ ?(ПоЗакрытымПортфелям, "учитывать (как в заполнении)", "только открытые на дату"));
	СтрокиИтога.Добавить("");

	СтатистикаУК = ПроверитьДокументыУК(
		Нарушения,
		НачалоДняДокументов,
		КонецДняДокументов,
		НачалоПериодаПортфелей,
		Пул,
		УправляющаяКомпания,
		ПоЗакрытымПортфелям);

	СтатистикаПортфеля = ПроверитьДокументыПоПортфелю(
		Нарушения,
		НачалоДняДокументов,
		КонецДняДокументов,
		Пул,
		УправляющаяКомпания);

	СтрокиЧужогоПулаВУК = ПроверитьСтрокиНачисленийУК(
		Нарушения,
		НачалоДняДокументов,
		КонецДняДокументов,
		Пул,
		УправляющаяКомпания);

	СтрокиИтога.Добавить("Документы «Начисление НДФЛ по УК»");
	СтрокиИтога.Добавить("  проведено: " + Формат(СтатистикаУК.Проведено, "ЧН=0; ЧГ="));
	СтрокиИтога.Добавить("  из них с портфелем выбранного пула: "
		+ Формат(СтатистикаУК.ПоПулу, "ЧН=0; ЧГ="));
	СтрокиИтога.Добавить("  проведено без портфеля пула (ошибка): "
		+ Формат(СтатистикаУК.БезПула, "ЧН=0; ЧГ="));
	СтрокиИтога.Добавить("  записано, не проведено, пара с пулом: "
		+ Формат(СтатистикаУК.НеПроведеноПоПулу, "ЧН=0; ЧГ="));
	СтрокиИтога.Добавить("  строк ТЧ «Начисления» с чужим пулом (ошибка): "
		+ Формат(СтрокиЧужогоПулаВУК, "ЧН=0; ЧГ="));
	СтрокиИтога.Добавить("");
	СтрокиИтога.Добавить("Документы «Начисление НДФЛ по портфелю»");
	СтрокиИтога.Добавить("  проведено: " + Формат(СтатистикаПортфеля.Проведено, "ЧН=0; ЧГ="));
	СтрокиИтога.Добавить("  из них портфель выбранного пула: "
		+ Формат(СтатистикаПортфеля.ПоПулу, "ЧН=0; ЧГ="));
	СтрокиИтога.Добавить("  проведено с другим / пустым пулом (ошибка): "
		+ Формат(СтатистикаПортфеля.ЧужойПул, "ЧН=0; ЧГ="));
	СтрокиИтога.Добавить("  записано, не проведено, портфель пула: "
		+ Формат(СтатистикаПортфеля.НеПроведеноПоПулу, "ЧН=0; ЧГ="));
	СтрокиИтога.Добавить("");

	ЕстьОшибка = СтатистикаУК.БезПула > 0
		Или СтатистикаПортфеля.ЧужойПул > 0
		Или СтрокиЧужогоПулаВУК > 0;
	ЕстьПредупреждение = СтатистикаУК.НеПроведеноПоПулу > 0
		Или СтатистикаПортфеля.НеПроведеноПоПулу > 0;

	Если Не ЕстьОшибка И Не ЕстьПредупреждение Тогда
		СтрокиИтога.Добавить("ИТОГ: ОК. Все проведенные документы за дату относятся к выбранному пулу.");
	ИначеЕсли Не ЕстьОшибка Тогда
		СтрокиИтога.Добавить(
			"ИТОГ: проведенные документы по пулу в порядке, но есть непроведенные по этому пулу (см. таблицу).");
	Иначе
		СтрокиИтога.Добавить(
			"ИТОГ: есть проведенные документы вне выбранного пула. См. таблицу нарушений.");
	КонецЕсли;

	Возврат РезультатПроверки(СтрСоединить(СтрокиИтога, Символы.ПС), Нарушения);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаНарушений()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	Таблица.Колонки.Добавить("Документ");
	Таблица.Колонки.Добавить("Клиент");
	Таблица.Колонки.Добавить("УправляющаяКомпания");
	Таблица.Колонки.Добавить("Портфель");
	Таблица.Колонки.Добавить("ПулПортфеля");
	Таблица.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(300)));

	Возврат Таблица;

КонецФункции

Функция РезультатПроверки(Текст, Нарушения)

	Результат = Новый Структура;
	Результат.Вставить("Результат", Текст);
	Результат.Вставить("Нарушения", Нарушения);

	Возврат Результат;

КонецФункции

Функция УсловиеЖизниПортфеля()

	Возврат
	"	И ВЫБОР
	|			КОГДА &ПоЗакрытымПортфелям
	|				ТОГДА Портфели.ДатаОкончания >= &НачалоПериодаПортфелей
	|						ИЛИ Портфели.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ИНАЧЕ Портфели.ДатаОкончания >= НАЧАЛОПЕРИОДА(&КонецДняДокументов, ДЕНЬ)
	|					ИЛИ Портфели.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|		КОНЕЦ";

КонецФункции

Процедура ДобавитьНарушение(Нарушения, Вид, Документ, Клиент, УК, Портфель, ПулПортфеля, Причина)

	СтрокаТЧ = Нарушения.Добавить();
	СтрокаТЧ.Вид = Вид;
	СтрокаТЧ.Документ = Документ;
	СтрокаТЧ.Клиент = Клиент;
	СтрокаТЧ.УправляющаяКомпания = УК;
	СтрокаТЧ.Портфель = Портфель;
	СтрокаТЧ.ПулПортфеля = ПулПортфеля;
	СтрокаТЧ.Причина = Причина;

КонецПроцедуры

Функция ПроверитьДокументыУК(Нарушения, НачалоДняДокументов, КонецДняДокументов,
	НачалоПериодаПортфелей, Пул, УправляющаяКомпания, ПоЗакрытымПортфелям)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Документ,
	|	Док.Проведен КАК Проведен,
	|	Док.Клиент КАК Клиент,
	|	Док.УправляющаяКомпания КАК УправляющаяКомпания
	|ПОМЕСТИТЬ ВТ_ДокументыУК
	|ИЗ
	|	Документ.НачислениеНДФЛПоУправляющейКомпании КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &НачалоДняДокументов И &КонецДняДокументов
	|	И Не Док.ПометкаУдаления
	|	И (&ВсеУК
	|			Или Док.УправляющаяКомпания = &УправляющаяКомпания)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Портфели.Клиент КАК Клиент,
	|	Портфели.УправляющаяКомпания КАК УправляющаяКомпания
	|ПОМЕСТИТЬ ВТ_ПарыПула
	|ИЗ
	|	Справочник.Портфели КАК Портфели
	|ГДЕ
	|	Портфели.Пул = &Пул
	|	И Не Портфели.ПометкаУдаления
	|" + УсловиеЖизниПортфеля() + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокументыУК.Документ КАК Документ,
	|	ВТ_ДокументыУК.Проведен КАК Проведен,
	|	ВТ_ДокументыУК.Клиент КАК Клиент,
	|	ВТ_ДокументыУК.УправляющаяКомпания КАК УправляющаяКомпания,
	|	ВЫБОР
	|		КОГДА ВТ_ПарыПула.Клиент ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьПортфельПула
	|ИЗ
	|	ВТ_ДокументыУК КАК ВТ_ДокументыУК
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПарыПула КАК ВТ_ПарыПула
	|		ПО ВТ_ДокументыУК.Клиент = ВТ_ПарыПула.Клиент
	|			И ВТ_ДокументыУК.УправляющаяКомпания = ВТ_ПарыПула.УправляющаяКомпания";

	Запрос.УстановитьПараметр("НачалоДняДокументов", НачалоДняДокументов);
	Запрос.УстановитьПараметр("КонецДняДокументов", КонецДняДокументов);
	Запрос.УстановитьПараметр("НачалоПериодаПортфелей", НачалоПериодаПортфелей);
	Запрос.УстановитьПараметр("Пул", Пул);
	Запрос.УстановитьПараметр("УправляющаяКомпания", УправляющаяКомпания);
	Запрос.УстановитьПараметр("ВсеУК", Не ЗначениеЗаполнено(УправляющаяКомпания));
	Запрос.УстановитьПараметр("ПоЗакрытымПортфелям", ПоЗакрытымПортфелям);

	Статистика = Новый Структура("Проведено, ПоПулу, БезПула, НеПроведеноПоПулу", 0, 0, 0, 0);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.Проведен Тогда
			Статистика.Проведено = Статистика.Проведено + 1;
			Если Выборка.ЕстьПортфельПула Тогда
				Статистика.ПоПулу = Статистика.ПоПулу + 1;
			Иначе
				Статистика.БезПула = Статистика.БезПула + 1;
				ДобавитьНарушение(
					Нарушения,
					"УК проведен вне пула",
					Выборка.Документ,
					Выборка.Клиент,
					Выборка.УправляющаяКомпания,
					Неопределено,
					Неопределено,
					"Проведен документ УК, у пары клиент+УК нет портфеля выбранного пула");
			КонецЕсли;
		ИначеЕсли Выборка.ЕстьПортфельПула Тогда
			Статистика.НеПроведеноПоПулу = Статистика.НеПроведеноПоПулу + 1;
			ДобавитьНарушение(
				Нарушения,
				"УК не проведен",
				Выборка.Документ,
				Выборка.Клиент,
				Выборка.УправляющаяКомпания,
				Неопределено,
				Пул,
				"Документ УК по паре выбранного пула записан, но не проведен");
		КонецЕсли;

	КонецЦикла;

	Возврат Статистика;

КонецФункции

Функция ПроверитьДокументыПоПортфелю(Нарушения, НачалоДняДокументов, КонецДняДокументов,
	Пул, УправляющаяКомпания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Документ,
	|	Док.Проведен КАК Проведен,
	|	Док.Портфель КАК Портфель,
	|	Док.Портфель.Клиент КАК Клиент,
	|	Док.Портфель.УправляющаяКомпания КАК УправляющаяКомпания,
	|	Док.Портфель.Пул КАК ПулПортфеля
	|ИЗ
	|	Документ.НачислениеНДФЛПоПортфелю КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &НачалоДняДокументов И &КонецДняДокументов
	|	И Не Док.ПометкаУдаления
	|	И (&ВсеУК
	|			Или Док.Портфель.УправляющаяКомпания = &УправляющаяКомпания)";

	Запрос.УстановитьПараметр("НачалоДняДокументов", НачалоДняДокументов);
	Запрос.УстановитьПараметр("КонецДняДокументов", КонецДняДокументов);
	Запрос.УстановитьПараметр("УправляющаяКомпания", УправляющаяКомпания);
	Запрос.УстановитьПараметр("ВсеУК", Не ЗначениеЗаполнено(УправляющаяКомпания));

	Статистика = Новый Структура("Проведено, ПоПулу, ЧужойПул, НеПроведеноПоПулу", 0, 0, 0, 0);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ЭтоПул = Выборка.ПулПортфеля = Пул;

		Если Выборка.Проведен Тогда
			Статистика.Проведено = Статистика.Проведено + 1;
			Если ЭтоПул Тогда
				Статистика.ПоПулу = Статистика.ПоПулу + 1;
			Иначе
				Статистика.ЧужойПул = Статистика.ЧужойПул + 1;
				ДобавитьНарушение(
					Нарушения,
					"Портфель проведен вне пула",
					Выборка.Документ,
					Выборка.Клиент,
					Выборка.УправляющаяКомпания,
					Выборка.Портфель,
					Выборка.ПулПортфеля,
					"Проведен документ по портфелю, пул которого не равен выбранному");
			КонецЕсли;
		ИначеЕсли ЭтоПул Тогда
			Статистика.НеПроведеноПоПулу = Статистика.НеПроведеноПоПулу + 1;
			ДобавитьНарушение(
				Нарушения,
				"Портфель не проведен",
				Выборка.Документ,
				Выборка.Клиент,
				Выборка.УправляющаяКомпания,
				Выборка.Портфель,
				Выборка.ПулПортфеля,
				"Документ по портфелю выбранного пула записан, но не проведен");
		КонецЕсли;

	КонецЦикла;

	Возврат Статистика;

КонецФункции

Функция ПроверитьСтрокиНачисленийУК(Нарушения, НачалоДняДокументов, КонецДняДокументов,
	Пул, УправляющаяКомпания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Док.Ссылка КАК Документ,
	|	Док.Клиент КАК Клиент,
	|	Док.УправляющаяКомпания КАК УправляющаяКомпания,
	|	ТЧ.Портфель КАК Портфель,
	|	ВЫБОР
	|		КОГДА ТЧ.Портфель ССЫЛКА Справочник.Портфели
	|			ТОГДА ВЫРАЗИТЬ(ТЧ.Портфель КАК Справочник.Портфели).Пул
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПулПортфеля
	|ИЗ
	|	Документ.НачислениеНДФЛПоУправляющейКомпании.Начисления КАК ТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеНДФЛПоУправляющейКомпании КАК Док
	|		ПО ТЧ.Ссылка = Док.Ссылка
	|ГДЕ
	|	Док.Дата МЕЖДУ &НачалоДняДокументов И &КонецДняДокументов
	|	И Док.Проведен
	|	И Не Док.ПометкаУдаления
	|	И (&ВсеУК
	|			ИЛИ Док.УправляющаяКомпания = &УправляющаяКомпания)
	|	И ТЧ.Портфель <> НЕОПРЕДЕЛЕНО
	|	И (Не (ТЧ.Портфель ССЫЛКА Справочник.Портфели)
	|			ИЛИ ВЫРАЗИТЬ(ТЧ.Портфель КАК Справочник.Портфели).Пул <> &Пул)";

	Запрос.УстановитьПараметр("НачалоДняДокументов", НачалоДняДокументов);
	Запрос.УстановитьПараметр("КонецДняДокументов", КонецДняДокументов);
	Запрос.УстановитьПараметр("Пул", Пул);
	Запрос.УстановитьПараметр("УправляющаяКомпания", УправляющаяКомпания);
	Запрос.УстановитьПараметр("ВсеУК", Не ЗначениеЗаполнено(УправляющаяКомпания));

	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Количество = Количество + 1;
		ДобавитьНарушение(
			Нарушения,
			"ТЧ Начисления вне пула",
			Выборка.Документ,
			Выборка.Клиент,
			Выборка.УправляющаяКомпания,
			Выборка.Портфель,
			Выборка.ПулПортфеля,
			"В проведенном документе УК в ТЧ Начисления есть портфель не выбранного пула");
	КонецЦикла;

	Возврат Количество;

КонецФункции

#КонецОбласти

#КонецЕсли
