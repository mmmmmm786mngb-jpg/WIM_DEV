#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(ПутьОтчета) Тогда
		ПутьОтчета = "C:\1c\Cursor_1c\WIM_DEV\bases\WIM_FIn\projects\IMDEV-9458 Доработка обработки Формирование начислений НДФЛ\Тестирование\reports\imdev9458_fin_test_result.json";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Автозапуск = СтрНайти(ВРег(Строка(ПараметрЗапуска)), "IMDEV9458_AUTO") > 0;
	ЗапуститьТестыНаСервере();
	ЗаписатьОтчетНаКлиенте();

	Если Автозапуск Тогда
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьТесты(Команда)

	ЗапуститьТестыНаСервере();
	ЗаписатьОтчетНаКлиенте();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗапуститьТестыНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат = ОбработкаОбъект.ВыполнитьАвтотест(ПутьОтчета);
	ТекстРезультата = Результат.Текст;
	JsonОтчета = Результат.Json;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтчетНаКлиенте()

	Если Не ЗначениеЗаполнено(JsonОтчета) Тогда
		Возврат;
	КонецЕсли;

	ТекстДокумента = Новый ТекстовыйДокумент;
	ТекстДокумента.УстановитьТекст(JsonОтчета);
	ТекстДокумента.Записать(ПутьОтчета, КодировкаТекста.UTF8);

КонецПроцедуры

#КонецОбласти
