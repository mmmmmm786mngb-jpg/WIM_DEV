#Область Служебные
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид","ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение",); // МассивСтрокИмен
	ПараметрыРегистрации.Вставить("Наименование", "Обработки объектов после загрузки из DU");
	ПараметрыРегистрации.Вставить("Версия", "3.00");
	ПараметрыРегистрации.Вставить("БезопасныйРежим",Ложь);
	ПараметрыРегистрации.Вставить("Информация","Обработки объектов после загрузки из DU");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.1.1.12");
	
	//Блок DevOps
	ВерсияПрименения = "1.00";
	Если ВерсияПрименения = ПараметрыРегистрации.Версия Тогда
		ПараметрыРегистрации.Вставить("ПереформатироватьСтруктуруНастроекФин", Истина);
	КонецЕсли;	
	//
	
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд,
	"Обработки объектов после загрузки из DU",
	"ОбработкиОбъектовПослеЗагрузкиИзDU",
	"ОткрытиеФормы");
	
	ДобавитьКоманду(ТаблицаКоманд,
	"Обработки объектов после загрузки из DU (в фоне)",
	"ФоновоеВыполнение",
	"ВызовСерверногоМетода");
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

#Область DevOps
Процедура ЗагрузитьНастройки(ПараметрыРегистрации) Экспорт
	ВерсияПрименения = "1.00";
	ТекущаяРегистрация = СведенияОВнешнейОбработке();
	Если ВерсияПрименения = ТекущаяРегистрация.Версия Тогда
		ПараметрыРегистрации.Вставить("ЗагружатьНастройки", Истина);
		НастройкиПоУмолчанию(ЭтотОбъект);
		ЗаголовокНастроек = "";
		ЗначенияПараметров = УстановитьПараметры(ЗаголовокНастроек);
		ПараметрыРегистрации.Вставить("Настройки", Новый Структура("Значения, ЗаголовокНастроек", ЗначенияПараметров, ЗаголовокНастроек));
	КонецЕсли;	
КонецПроцедуры

Процедура НастройкиПоУмолчанию(Объект) Экспорт
	
	Объект.КоличествоПотоков = 5;
	Объект.ОчищатьСпискиПослеОбработки = Истина;
	
КонецПроцедуры	

Функция УстановитьПараметры(ЗаголовокНастроек) Экспорт
	
	Значения = Новый Структура();      
	Значения.Вставить("ПочтовыйЛогин", ЭтотОбъект.ПочтовыйЛогин);
	Значения.Вставить("СписокРассылки", XMLСтрока(Новый ХранилищеЗначения(ЭтотОбъект.СписокРассылки.Выгрузить())));
	ПредставлениеПочты = ?(ЭтотОбъект.СписокРассылки.Количество()>0, "Установлен список рассылки","");
	ЗаголовокНастроек = СокрЛП(ПредставлениеПочты);
	Возврат Значения;
	
КонецФункции

#КонецОбласти

Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт
	// Реализация логики команды
	
	Если ИдентификаторКоманды <> "ФоновоеВыполнение" Тогда 
		Возврат; 
	КонецЕсли;
	
	ОбъектСсылка = ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка;
	
	ДатаНачала 		= НачалоДня(КалендарныеГрафики.ПолучитьСледующуюРабочуюДату(,ТекущаяДата(),-1));
	ДатаОкончания 	= КонецДня(ДатаНачала);
	
	//Демонстрация переделок логики работы с настройками. Добавляем параметр в вызов - ПараметрыВыполненияКоманды
	ПредставлениеНастроек = УстановитьНастройки(ПараметрыВыполненияКоманды);
	
	Задача = Задачи.ЗадачаИнтеграции.СоздатьЗадачу();
	Задача.Дата 			= ТекущаяДата();
	Задача.ВидОбмена 		= ОбъектСсылка;
	Задача.ВерсияОбработки 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектСсылка, "Версия");
	Задача.Наименование 	= "Обработки объектов после загрузки из DU (в фоне)";
	Задача.ПараметрыВыполнения = ПредставлениеНастроек;
	
	Отказ = Ложь;
	ТекстОшибки = "";
	
	Попытка 
		УстановкаИдентификатораДляОбработки();  
		
		Если ЗначениеЗаполнено(ИдентификаторОбмена) Тогда
			ВыполнитьОбработку();
		Иначе	
			Отказ = Истина;
			ТекстОшибки = "Нет доступных элементов для пост обработки";
		КонецЕсли;	
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Отказ = Истина;
	КонецПопытки;
	
	Задача.Описание = "";
	Задача.ХранилищеЛога = Новый ХранилищеЗначения(Лог, Новый СжатиеДанных(9));
	
	Если Отказ тогда
		Задача.Описание = "Ошибки выполнения:" + Символы.ПС + ТекстОшибки;
		Задача.ЗавершеноСОшибками = Истина;
	Иначе
		Задача.Описание = "Загрузка успешна";
	КонецЕсли;
	
	Задача.Описание = Задача.Описание;
	Задача.ДатаИсполнения = ТекущаяДата();
	Задача.ВыполнитьЗадачу();
	
КонецПроцедуры

Функция ПропискаРассылки(Знач НомерРассылки)
	Перем ПараметрыПодключения, ИмяИБ;
	
	Попытка
		ПараметрыПодключения = ОбщегоНазначенияКлиентСервер.ПолучитьПараметрыПодключенияИзСтрокиСоединенияИнформационнойБазы(СтрокаСоединенияИнформационнойБазы());
		ИмяИБ = ПараметрыПодключения.ИмяИнформационнойБазыНаСервере1СПредприятия;
	Исключение
	КонецПопытки;
	
	Прописка = " {" + НомерРассылки + ", ib: " + ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, "< .. >") + "}";
	
	Возврат Прописка;
КонецФункции // ПропискаРассылки()

//Демонстрация логики работы с настройками в контуре FIN
Функция УстановитьНастройки(ПараметрыВыполненияКоманды)
	НастройкиВыполнения = ПараметрыВыполненияКоманды.ПараметрыДополнительнойОбработки;
	Если ТипЗнч(НастройкиВыполнения) <> Тип("Структура") Тогда 
		Возврат "<Настройки не установлены>";
	КонецЕсли;
	
	ЗначенияНастроек = НастройкиВыполнения;
	ПредставлениеНастроек = "";
	УстановитьПользовательскиеНастройки(ЗначенияНастроек, ПредставлениеНастроек);
	
	Возврат ПредставлениеНастроек;
КонецФункции

Процедура УстановитьПользовательскиеНастройки(Настройки, ПредставлениеНастроек="") Экспорт
	Если Настройки.Свойство("Значения") Тогда
		Почта = Неопределено;
		Если Настройки.Значения.Свойство("ПочтовыйЛогин", Почта) тогда
			ПочтовыйЛогин = Почта;
			Ящики = XMLЗначение(Тип("ХранилищеЗначения"), Настройки.Значения.СписокРассылки);
			СписокРассылки.Загрузить(Ящики.Получить());
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры	

Функция РассылкаСообщения(ТемаСообщения, ТекстСообщения, Знач ЕстьОшибки)
	
	Если СписокРассылки.Количество()>0 и НЕ ПочтовыйЛогин.Пустая() тогда
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность");
		ПараметрыПисьма.Тема	 = ?(ЕстьОшибки, "{FAIL} ", "{OK} ") + ТемаСообщения + ПропискаРассылки("r82");
		ПараметрыПисьма.Тело	 = ТекстСообщения;
		ПараметрыПисьма.Важность = ?(ЕстьОшибки, ВажностьИнтернетПочтовогоСообщения.Высокая, ВажностьИнтернетПочтовогоСообщения.Обычная);
		
		Кому = Новый Массив;
		Для каждого ТекЯщик из СписокРассылки Цикл
			Кому.Добавить(Новый Структура("Адрес,Представление", ТекЯщик.ПочтовыйЯщик, ТекЯщик.Представление));
		КонецЦикла;
		
		ПараметрыПисьма.Кому = Кому;
		ПараметрыПисьма.ТипТекста = "HTML";
		ПараметрыПисьма.Тело = РассылкаСообщенияТаблица(ТекстСообщения);
		
		Попытка
			РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(ПочтовыйЛогин, ПараметрыПисьма);
			//	РаботаСПочтовымиСообщениямиСлужебный.ОтправитьСообщение(ПочтовыйЛогин, ПараметрыПисьма);
			текстРассылки = "Рассылка завершена";
		Исключение
			текстРассылки = "Рассылка не удалась: "; 
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Для Каждого Элемент из Сообщения Цикл
				текстРассылки = текстРассылки + Символы.ПС + Элемент.Текст;
			КонецЦикла;
		КонецПопытки;
		
		Возврат текстРассылки;
	КонецЕсли;
	
	Возврат "Не установлен список рассылки";
КонецФункции

