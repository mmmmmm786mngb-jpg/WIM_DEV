		|		ВТ_БПЗавершен.Портфель,
		|		ВТ_БПЗавершен.ИдентификаторПотока,
		|		""""
		|	ИЗ
		|		ВТ_БПЗавершен КАК ВТ_БПЗавершен
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВТ_БПНаУдаление.РегСвед,
		|		ВТ_БПНаУдаление.Измерение,
		|		ВТ_БПНаУдаление.ИмяОперации,
		|		ВТ_БПНаУдаление.ОбъектДляОперации,
		|		ВТ_БПНаУдаление.Портфель,
		|		ВТ_БПНаУдаление.ИдентификаторПотока,
		|		""""
		|	ИЗ
		|		ВТ_БПНаУдаление КАК ВТ_БПНаУдаление) КАК Таб_ПоПортфелю
		|
		|УПОРЯДОЧИТЬ ПО
		|	РегСвед,
		|	Измерение
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	
	РезультатПакет = Запрос.ВыполнитьПакет();
	
	ТабДокОперации = Новый ТабличныйДокумент;
	
	Спр_Результат = РезультатПакет[12];
	
	ТЗСправочники = Спр_Результат.Выгрузить();      
	
	ОбработатьСправочники(ТЗСправочники);
	
	ДокументыБП_Результат = РезультатПакет[13];
	ТЗДокументыБП = ДокументыБП_Результат.Выгрузить();	
	
	ОбработкаДокументовБПВФоне(ТЗДокументыБП);
	
	ДатаВремяОкончания = ТекущаяДата();
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Лог.Вывести(ОбластьЗаголовок);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ДатаНачала = ДатаВремяНачала;
	ОбластьШапка.Параметры.ДатаОкончания = ДатаВремяОкончания;
	Лог.Вывести(ОбластьШапка);
	
	Лог.Вывести(ТабДокОперации);
	
КонецПроцедуры

Функция ПроверятьВыполнение(МассивЗаданий)

	ТабДокЛог = Новый ТабличныйДокумент;  
	ОбластьСообщения = Макет.ПолучитьОбласть("СтрокаЛог");
	
	ВсеЗаданияВыполнены = Ложь;
		
	Пока ВсеЗаданияВыполнены = Ложь Цикл
		
		МассивУдалить = Новый Массив;
		Для Каждого Элемент из МассивЗаданий Цикл
			
			ТекущееЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Элемент);
		    Если ТекущееЗадание.Состояние=СостояниеФоновогоЗадания.Активно Тогда
		        Продолжить;
			Иначе
				МассивУдалить.Добавить(Элемент);
				
				МассивСообщений = ТекущееЗадание.ПолучитьСообщенияПользователю(Истина);
				Для каждого Сообщение Из МассивСообщений Цикл
					ОбластьСообщения.Параметры.СтрокаЛог = Сообщение.Текст;
					ТабДокЛог.Вывести(ОбластьСообщения);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;				
		
		Для Каждого Элемент из МассивУдалить Цикл
			Индекс = МассивЗаданий.Найти(Элемент);
			МассивЗаданий.Удалить(Индекс);	
		КонецЦикла;	
		
		ВсеЗаданияВыполнены = МассивЗаданий.Количество() = 0;
		
	КонецЦикла;

	Возврат ТабДокЛог;
	
КонецФункции //ПроверятьВыполнение

Процедура ОбработатьСправочники(ТЗСправочники)
	
	ExchDU_ОбработкаОбъектовПослеЗагрузки.ВыполнениеОперацийСоСправочниками(ТЗСправочники); 												
	
КонецПроцедуры 

Процедура УстановкаИдентификатораДляОбработки()
	
	ТаблицаДоступныхОбменов = ExchDU_ОбработкаОбъектовПослеЗагрузки.ДоступныеОбмены();   
	КоличествоДоступныхОбменов = ТаблицаДоступныхОбменов.Количество();
	Если КоличествоДоступныхОбменов > 0 Тогда
		СтрокаОбмен = ТаблицаДоступныхОбменов[КоличествоДоступныхОбменов-1];
		ИдентификаторОбмена = СтрокаОбмен.ИдентификаторОбмена;
	КонецЕсли;
		
КонецПроцедуры	


