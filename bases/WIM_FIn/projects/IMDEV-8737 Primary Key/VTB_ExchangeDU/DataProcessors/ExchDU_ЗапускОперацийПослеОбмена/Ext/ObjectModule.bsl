Процедура ВыполнитьОбработку() Экспорт 
	
	ExchDU_ОбработкаОбъектовПослеЗагрузки.УстановкаСостоянияОбмена(ИдентификаторОбмена, Перечисления.ExchDU_СостояниеОбработки.Обработка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ExchDU_ПотокиОбмена.ИдентификаторПотока КАК ИдентификаторПотока
		|ИЗ
		|	РегистрСведений.ExchDU_ПотокиОбмена КАК ExchDU_ПотокиОбмена
		|ГДЕ
		|	ExchDU_ПотокиОбмена.ИдентификаторОбмена = &ИдентификаторОбмена";
	
	Запрос.УстановитьПараметр("ИдентификаторОбмена", ИдентификаторОбмена);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	МассивИдентификаторов = РезультатЗапроса.ВыгрузитьКолонку("ИдентификаторПотока");
	
	ДатаВремяНачала = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	""ExchDU_СписокДокументовДляПроведения"" КАК РегСвед,
		|	""ДокументДляПроведения"" КАК Измерение,
		|	""ПроведениеДокументовПослеЗагрузки"" КАК ИмяОперации,
		|	СписокДокументовДляПроведения.ДокументДляПроведения КАК ОбъектДляОперации,
		|	ЕСТЬNULL(СписокДокументовДляПроведения.ДокументДляПроведения.Портфель, ""Без портфеля"") КАК Портфель,
		|	СписокДокументовДляПроведения.ИдентификаторПотока КАК ИдентификаторПотока
		|ПОМЕСТИТЬ ВТ_ДокДляПроведения
		|ИЗ
		|	РегистрСведений.ExchDU_СписокДокументовДляПроведения КАК СписокДокументовДляПроведения
		|ГДЕ
		|	СписокДокументовДляПроведения.ИдентификаторПотока В(&МассивИдентификаторов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""ExchDU_СписокДокументовДляОтменыПроведения"" КАК РегСвед,
		|	""ДокументДляОтменыПроведения"" КАК Измерение,
		|	""ДокументДляОтменыПроведения"" КАК ИмяОперации,
		|	ExchDU_СписокДокументовДляОтменыПроведения.ДокументДляОтменыПроведения КАК ОбъектДляОперации,
		|	ЕСТЬNULL(ExchDU_СписокДокументовДляОтменыПроведения.ДокументДляОтменыПроведения.Портфель, ""Без портфеля"") КАК Портфель,
		|	ExchDU_СписокДокументовДляОтменыПроведения.ИдентификаторПотока КАК ИдентификаторПотока
		|ПОМЕСТИТЬ ВТ_ДокОтменаПроведения
		|ИЗ
		|	РегистрСведений.ExchDU_СписокДокументовДляОтменыПроведения КАК ExchDU_СписокДокументовДляОтменыПроведения
		|ГДЕ
		|	ExchDU_СписокДокументовДляОтменыПроведения.ИдентификаторПотока В(&МассивИдентификаторов)
